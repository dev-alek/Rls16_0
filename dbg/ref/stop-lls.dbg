      371   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      372   FUNCTION mark-string RETURNS CHARACTER
      373     ( input p-recid as recid, input mark-list as character  ) :
      374     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      375   END FUNCTION.
      376   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      377     define variable v-cntxt-db-num        as integer   no-undo .
      378     define variable v-cntxt-userid        as character no-undo .
      379     define variable v-cntxt-level         as character no-undo .
      380     define variable v-cntxt-host-code-obj as integer   no-undo .
      381     define variable v-cntxt-obj-type      as character no-undo .
      382     define variable v-cntxt-obj-code      as integer   no-undo .
      383     define variable v-cntxt-db-num-obj    as integer   no-undo .
      384     define variable v-cntxt-is-admin      as logical   no-undo .
      385   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      386   define variable c-point  as character no-undo .
      387   define variable tbl      as character no-undo .
      388   define variable join-tbl as character no-undo .
      389   define variable fld      as character no-undo .
      390   define variable lab      as character no-undo .
      391   define variable spr      as character no-undo .
      392   define variable dim      as character no-undo .
      393   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      394   procedure fltfield-clear :
      395     define output parameter loc-fld as character no-undo.
      396     define output parameter loc-lab as character no-undo .
      397     define output parameter loc-spr as character no-undo .
      398     define output parameter loc-dim as character no-undo .
      399     assign
      400       loc-fld = ""
      401       loc-lab = ""
      402       loc-spr = ""
      403       loc-dim = "0"
      404     .
      405   end procedure .
      406   procedure fltfield-add :
      407     define input        parameter par-fld as character no-undo.
      408     define input        parameter par-lab as character no-undo .
      409     define input        parameter par-spr as character no-undo .
      410     define input-output parameter loc-fld as character no-undo.
      411     define input-output parameter loc-lab as character no-undo .
      412     define input-output parameter loc-spr as character no-undo .
      413     define input-output parameter loc-dim as character no-undo .
      414     do
      415     on error undo, return error
      416     :
      417       assign
      418       loc-fld = if loc-dim = '0'
      419                 then par-fld
      420                 else (loc-fld + chr(44) + par-fld)
      421       loc-lab = if loc-dim = '0'
      422                 then par-lab
      423                 else (loc-lab + chr(44) + par-lab)
      424       loc-spr = if loc-dim = '0'
      425                 then par-spr
      426                 else (loc-spr + chr(44) + par-spr)
      427       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      428                 string(integer(if num-entries(loc-dim) > 1
      429                               then entry(2, loc-dim)
      430                               else entry(1, loc-dim)
      431                               ) + 1)
      432       no-error
      433       .
      434     end.
      435   end procedure.
      436   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      437   procedure cur-time :
      438      define output parameter p-today as date      no-undo .
      439      define output parameter p-time  as integer   no-undo .
      440     do
      441     on error undo, return error
      442     :
      443       define variable v-date1 as date      no-undo .
      444       define variable v-date2 as date      no-undo .
      445       define variable v-time  as integer   no-undo .
      446       assign
      447         v-date1 = today
      448         v-time  = time
      449         v-date2 = today
      450       .
      451       if v-date1 <> v-date2
      452       then do:
      453         assign
      454           v-date1 = today
      455           v-time  = v-time
      456         .
      457       end.
      458       assign
      459         p-today = v-date1
      460         p-time  = v-time
      461       .
      462     end.
      463   end.
      464   function cur-time-date returns character
      465   :
      466     return string(today, '99/99/9999':U) .
      467   end.
      468   function cur-time-mjd returns decimal
      469   :
      470     define variable v-date as date      no-undo .
      471     define variable v-time as integer   no-undo .
      472     run cur-time in this-procedure
      473       (output v-date
      474       ,output v-time
      475       ) .
      476     return integer(v-date) - 2400002 + (v-time / 86400) .
      477   end.
      478   function cur-time-get-ending-index returns integer
      479   (input p-number as integer
      480   )
      481   :
      482     if p-number < 0
      483     or p-number = ?
      484     then do:
      485       return 1 .
      486     end.
      487     define variable v-rest as integer   no-undo .
      488     assign
      489       p-number = p-number modulo 100
      490     .
      491     if p-number < 20
      492     then do:
      493       assign
      494         v-rest = p-number
      495       .
      496     end.
      497     else do:
      498       assign
      499         v-rest = p-number modulo 10
      500       .
      501     end.
      502     case v-rest :
      503       when 1
      504       then do:
      505         return 2 .
      506       end.
      507       when 2 or
      508       when 3 or
      509       when 4
      510       then do:
      511         return 3 .
      512       end.
      513       otherwise do:
      514         return 1 .
      515       end.
      516     end case .
      517   end.
      518   procedure cur-time-mjd-to-date :
      519      define input  parameter i-mjd-diff as decimal no-undo.
      520      define output parameter o-Date     as date    no-undo.
      521      define output parameter o-Time     as integer no-undo.
      522      define variable v-day-number as integer   no-undo .
      523      if    i-mjd-diff < 0
      524         or i-mjd-diff = ?
      525      then do:
      526         return "?" .
      527      end.
      528      assign
      529         v-day-number = truncate(i-mjd-diff,0).
      530         o-Date = date(v-day-number + 2400002).
      531         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      532     .
      533   end.
      534   function cur-time-mjd-to-string returns character
      535   (input p-mjd-diff as decimal
      536   )
      537   :
      538     define variable v-day-number as integer   no-undo .
      539     define variable v-seconds    as integer   no-undo .
      540     define variable v-hour       as integer   no-undo .
      541     define variable v-min        as integer   no-undo .
      542     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      543     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      544     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      545     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      546     if p-mjd-diff < 0
      547     or p-mjd-diff = ?
      548     then do:
      549       return "?" .
      550     end.
      551     assign
      552       v-day-number = integer(truncate(p-mjd-diff,0))
      553       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      554     .
      555     if v-seconds > 86400
      556     then do:
      557       assign
      558         v-seconds = 86400 - 1
      559       .
      560     end.
      561     if v-seconds < 0
      562     then do:
      563       assign
      564         v-seconds = 0
      565       .
      566     end.
      567     assign
      568       v-hour = truncate(v-seconds / 3600, 0)
      569     .
      570     assign
      571       v-seconds = v-seconds modulo 3600
      572     .
      573     assign
      574       v-min = truncate(v-seconds / 60, 0)
      575     .
      576     assign
      577       v-seconds = v-seconds modulo 60
      578     .
      579     return
      580         (if v-day-number <> 0
      581           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      582           else ""
      583         )
      584       + (if v-day-number <> 0 or v-hour <> 0
      585           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      586           else ""
      587         )
      588       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      589           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      590           else ""
      591         )
      592       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      593       .
      594   end.
      595   function cur-time-string returns character
      596   :
      597     define variable v-date as date      no-undo .
      598     define variable v-time as integer   no-undo .
      599     run cur-time in this-procedure
      600       (output v-date
      601       ,output v-time
      602       ) .
      603     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      604   end.
      605   function cur-time-string-sec returns character
      606   :
      607     define variable v-date as date      no-undo .
      608     define variable v-time as integer   no-undo .
      609     run cur-time in this-procedure
      610       (output v-date
      611       ,output v-time
      612       ) .
      613     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      614   end.
      615   function cur-time-custom  returns character
      616   (input p-prefix as character
      617   ,input p-date-format as character
      618   ,input p-delimiter as character
      619   ,input p-time-format as character
      620   ,input p-suffix as character
      621   )
      622   :
      623     define variable v-date as date      no-undo .
      624     define variable v-time as integer   no-undo .
      625     run cur-time in this-procedure
      626       (output v-date
      627       ,output v-time
      628       ) .
      629     return
      630       p-prefix
      631       + string(v-date, p-date-format)
      632       + p-delimiter
      633       + string(v-time, p-time-format)
      634       + p-suffix
      635       .
      636   end.
      637   function cur-time-print  returns character
      638   :
      639     define variable v-date as date      no-undo .
      640     define variable v-time as integer   no-undo .
      641     run cur-time in this-procedure
      642       (output v-date
      643       ,output v-time
      644       ) .
      645     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      646   end.
      647   function cur-time-datetime returns datetime
      648   :
      649     define variable v-char as character no-undo .
      650     define variable v-datetime as datetime no-undo .
      651     v-char = cur-time-string().
      652     v-datetime = datetime(v-char).
      653     return  v-datetime.
      654   end.
      655   function cur-time-string-msec returns character
      656   :
      657     define variable v-date as datetime  no-undo .
      658     v-date = now.
      659     return string(v-date) .
      660   end.
      661   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      662   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      663   define new shared variable RepPathName        as character no-undo .
      664   define new shared variable PrintRubl          as logical   no-undo .
      665   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      666   define  stream PrnLibStream.
      667   procedure prn-lib-prn-file :
      668     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      669     define input parameter p-DIsabledoptions as integer no-undo .
      670     define variable v-report-name as character no-undo .
      671     define variable v-user-action as character no-undo .
      672     define variable v-printed     as logical   no-undo .
      673     define variable v-exist       as logical   no-undo .
      674     do
      675       on error undo, return error
      676       :
      677       run prn-lib-get-report-name  in this-procedure (
      678         input parParentProc
      679         ,output v-report-name
      680         ).
      681   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      682   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      683     (input  v-report-name
      684     ,input  2
      685     ,output v-exist
      686     )  .
      687       if NOT v-exist then
      688       DO:
      689         Message
      690           "Нет заданий на печать ! "
      691           view-as alert-box .
      692         Return  .
      693       End.
      694       run gbl/prnfilen.w
      695         (input  ""
      696         ,input  p-DisabledOptions
      697         ,input  string(v-report-name )
      698         ,input  7
      699         ,output v-user-action
      700         ,output v-printed
      701         ) .
      702       if v-printed then
      703       do:
      704         return "YES" .
      705       end.
      706       else
      707       do:
      708         return "NO" .
      709       end.
      710     end.
      711   end procedure.
      712   procedure prn-lib-open-stream :
      713     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      714     define input parameter p-page-size    as integer no-undo .
      715     define input parameter p-is-stream    as logical no-undo .
      716     define input parameter p-append       as logical no-undo .
      717     define variable v-report-name as character no-undo .
      718     do
      719       on error undo, return error
      720       :
      721       run prn-lib-get-report-name  in this-procedure (
      722         input parParentProc
      723         ,output v-report-name
      724         ).
      725       if p-is-stream then
      726       do:
      727         if p-append then
      728         do:
      729           output stream PrnLibStream to value( v-report-name )
      730             page-size value(p-page-size) append .
      731         end.
      732         if not p-append then
      733         do:
      734           output stream PrnLibStream to value( v-report-name )
      735             page-size value(p-page-size) .
      736         end.
      737       end.
      738       if not p-is-stream then
      739       do:
      740         if p-append then
      741         do:
      742           output to value( v-report-name )
      743             page-size value(p-page-size) append .
      744         end.
      745         if not p-append then
      746         do:
      747           output to value( v-report-name )
      748             page-size value(p-page-size) .
      749         end.
      750       end.
      751     end.
      752   end procedure.
      753   procedure prn-lib-open-exp :
      754     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      755     define input parameter p-is-stream    as logical no-undo .
      756     define input parameter p-is-append    as logical no-undo .
      757     define output parameter p-ReportFileName as char init "report" no-undo.
      758     define output parameter p-process as logical no-undo .
      759     define variable glog as logical no-undo .
      760     do
      761       on error undo, return error
      762       :
      763       SYSTEM-DIALOG GET-FILE p-ReportFileName
      764         TITLE      "Укажите путь"
      765         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      766         ASK-OVERWRITE
      767         CREATE-TEST-FILE
      768         SAVE-AS
      769         USE-FILENAME
      770         DEFAULT-EXTENSION "txt"
      771         UPDATE glog
      772         .
      773       if not glog then  return.
      774       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      775       if p-is-stream then
      776       do:
      777         if p-is-append then
      778         do:
      779           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      780         end.
      781         else
      782         do:
      783           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      784         end.
      785       end.
      786       else
      787       do:
      788         if p-is-append then
      789         do:
      790           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      791         end.
      792         else
      793         do:
      794           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      795         end.
      796       end.
      797       p-process = yes.
      798     end.
      799   end procedure.
      800   procedure prn-lib-get-report-name :
      801     define input parameter parParentProc  as widget-handle no-undo.
      802     define output parameter p-report-name as character no-undo .
      803     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      804   end procedure.
      805   procedure prn-lib-reportviewer-report-name :
      806     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      807     define input parameter p-report-name-html as character no-undo .
      808     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      809   end procedure.
      810   procedure prn-lib-reportviewer :
      811     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      812     define input parameter p-report-name-html as character no-undo .
      813     define input parameter p-param        as character no-undo .
      814     define variable v-excel           as character no-undo init 'TRUE' .
      815     define variable v-value-character as character no-undo .
      816     define variable v-value-integer   as character no-undo .
      817     define variable v-value-date      as date      no-undo .
      818     define variable v-value-decimal   as decimal   no-undo .
      819     define variable rep-excel         as logical   no-undo .
      820     define variable excel-string      as character no-undo .
      821     define variable v-param-type      as character no-undo .
      822     define variable v-tth             as handle    no-undo .
      823     run adm/shattri.p (
      824       input "get":U
      825       ,input  ""
      826       ,input  0
      827       ,input  'report-glob':U
      828       ,input  'rep-excel':U
      829       ,output v-value-character
      830       ,output v-value-date
      831       ,output v-value-decimal
      832       ,output v-value-integer
      833       ,output rep-excel
      834       ,output v-param-type
      835       ,INPUT-OUTPUT table-handle v-tth
      836       )  .
      837     if rep-excel then v-excel = "TRUE" .
      838     else v-excel = "FALSE" .
      839     if p-param eq ""
      840     then
      841        p-param = "EXCEL:" + v-excel.
      842     else
      843        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      844     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      845   end procedure.
      846   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      847   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      848   procedure gen-key-rec :
      849     define input  parameter p-tbl-name    as character no-undo.
      850     define input  parameter p-bh_tbl-name as handle    no-undo.
      851     define output parameter p-key-rec     as character no-undo.
      852     do
      853     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      854     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      855     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      856     :
      857       define variable fh               as handle    no-undo .
      858       define variable v-ok             as logical   no-undo .
      859       define variable v-inform         as character no-undo .
      860       define variable v-ind            as integer   no-undo .
      861       define variable v-idx-field-qnty as integer   no-undo .
      862       if p-tbl-name = ?
      863         or p-tbl-name = "":U
      864       then do:
      865         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info10 ).
      866       end.
      867       if not p-bh_tbl-name:available then do:
      868         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info10, p-tbl-name ).
      869       end.
      870       assign
      871         p-key-rec = p-tbl-name
      872         v-inform  = p-bh_tbl-name:index-information(1)
      873         v-ind     = 2
      874       .
      875       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      876       on error undo, return error
      877       :
      878         assign
      879           v-inform = p-bh_tbl-name:index-information( v-ind )
      880           v-ind    = v-ind + 1
      881         .
      882       end.
      883       if v-inform = ?
      884         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      885         or entry( 3, v-inform, ",":U ) <> "1":U
      886       then do:
      887         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info10, p-tbl-name ).
      888       end.
      889       else do:
      890         assign
      891           v-idx-field-qnty = num-entries( v-inform ) - 4
      892         .
      893         if v-idx-field-qnty < 2 then do:
      894           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info10, v-inform, p-tbl-name ).
      895         end.
      896         do v-ind = 1 to v-idx-field-qnty by 2
      897         on error undo, return error
      898         :
      899           assign
      900             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      901             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      902           .
      903         end.
      904       end.
      905       if p-key-rec = ? then do:
      906         assign
      907           p-key-rec = "":U
      908         .
      909         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info10, p-tbl-name ).
      910       end.
      911     end.
      912     return.
      913   end procedure.
      914   procedure gen-where-keyr-tab :
      915     define input  parameter i-tableSerach as character no-undo.
      916     define input  parameter i-tablekey   as character  no-undo.
      917     define input  parameter p-key-rec    as character  no-undo.
      918     define input  parameter p-key-handle as handle     no-undo .
      919     define input  parameter p-db-name    as character  no-undo .
      920     define input  parameter p-tt-handle  as handle     no-undo .
      921     define output parameter o-Where      as character  no-undo.
      922     do
      923     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      924     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      925     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      926     :
      927       define variable v-full-tbl-name  as character no-undo .
      928       define variable bh_tbl-name      as handle    no-undo .
      929       define variable fh_key           as handle    no-undo .
      930       define variable fh_search        as handle    no-undo .
      931       define variable v-field-num      as integer   no-undo .
      932       define variable v-count-fld      as integer   no-undo .
      933       define variable v-inform         as character no-undo .
      934       define variable v-ind            as integer   no-undo .
      935       define variable v-idx-field-qnty as integer   no-undo .
      936       define variable v-field-name     as character no-undo .
      937       define variable v-field-val      as character no-undo .
      938       define variable v-word-link      as character no-undo .
      939       define variable vTable           as character no-undo.
      940       define variable bh_tbl-key       as handle    no-undo .
      941       assign
      942         p-key-rec = trim( p-key-rec )
      943       .
      944       if p-key-handle <> ? then do:
      945         if not valid-handle(p-key-handle)
      946            or p-key-handle:type <> "buffer"
      947         then do:
      948           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info10 ).
      949         end.
      950         if num-entries( p-key-rec, chr(3) ) > 1
      951           or p-key-rec = ?
      952           or p-key-rec = "":U
      953         then do:
      954           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info10, p-key-rec ).
      955         end.
      956       end.
      957       else do:
      958         if p-key-rec = ?
      959           or p-key-rec = "":U
      960         then do:
      961           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info10 ).
      962         end.
      963       end.
      964       assign
      965         vTable = entry( 1 , p-key-rec, chr(3) )
      966       .
      967       if p-tt-handle <> ?
      968         and ( not valid-handle(p-tt-handle)
      969               or p-tt-handle:type <> "buffer"
      970             )
      971       then do:
      972         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info10, vTable, chr(10) ).
      973       end.
      974       if p-tt-handle = ? then do:
      975         assign
      976           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      977         .
      978         create buffer bh_tbl-name for table v-full-tbl-name .
      979       end.
      980       else do:
      981         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      982       end.
      983       assign
      984         v-inform = bh_tbl-name:index-information(1)
      985         v-ind    = 2
      986       .
      987       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      988       on error undo, return error
      989       :
      990         assign
      991           v-inform = bh_tbl-name:index-information( v-ind )
      992           v-ind    = v-ind + 1
      993         .
      994       end.
      995       if v-inform = ?
      996         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      997         or entry( 3, v-inform, ",":U ) <> "1":U
      998       then do:
      999         delete object bh_tbl-name no-error.
     1000         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info10, vTable ).
     1001       end.
     1002       assign
     1003         v-idx-field-qnty = num-entries( v-inform ) - 4
     1004       .
     1005       if v-idx-field-qnty < 2 then do:
     1006         delete object bh_tbl-name no-error.
     1007         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info10, v-inform, vTable ).
     1008       end.
     1009       assign
     1010         o-where     = "where":U
     1011         v-word-link = "":U
     1012         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1013         v-count-fld = 0
     1014       .
     1015       if i-tablekey ne "" and i-tablekey ne ?
     1016       then do:
     1017         assign
     1018           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1019         .
     1020         create buffer bh_tbl-key for table v-full-tbl-name .
     1021       end.
     1022       if i-tableSerach ne "" and i-tableSerach ne ?
     1023       then do:
     1024         delete object bh_tbl-name no-error.
     1025         assign
     1026           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1027         .
     1028         create buffer bh_tbl-name for table v-full-tbl-name .
     1029       end.
     1030       block_where:
     1031       do v-ind = 1 to v-idx-field-qnty by 2
     1032       on error undo, return error
     1033       :
     1034         assign
     1035           v-count-fld = v-count-fld + 1
     1036         .
     1037         if p-key-handle = ?
     1038           and v-count-fld > v-field-num
     1039         then do:
     1040           leave block_where.
     1041         end.
     1042         define variable VfieldKeyTable as handle no-undo.
     1043         assign
     1044           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1045           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1046         .
     1047         if     bh_tbl-key ne ?
     1048         then do:
     1049            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1050            if VfieldKeyTable eq ?
     1051            then next block_where.
     1052         end.
     1053         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1054         then
     1055            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1056         else
     1057            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1058         if p-key-handle = ? then do:
     1059           assign
     1060             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1061           .
     1062         end.
     1063         else do:
     1064           assign
     1065             fh_key = p-key-handle:buffer-field( v-field-name )
     1066           .
     1067           if fh_key = ?
     1068             or not valid-handle( fh_key )
     1069           then do:
     1070             delete object bh_tbl-name.
     1071             if     bh_tbl-key ne ?
     1072             then
     1073                delete object bh_tbl-key.
     1074             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info10, p-key-handle:name, v-field-name ).
     1075           end.
     1076           assign
     1077             v-field-val = fh_key:buffer-value
     1078           .
     1079         end.
     1080         if fh_search:data-type ="character":U then do:
     1081           assign
     1082             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1083             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1084             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1085             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1086             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1087             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1088             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1089             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1090             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1091             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1092             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1093             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1094             v-field-val = substitute( '"&1"', v-field-val )
     1095           .
     1096         end.
     1097         assign
     1098           o-where = substitute( "&1 &2", o-where, v-field-val )
     1099         .
     1100         if v-word-link = "":U then do:
     1101           assign
     1102             v-word-link = "and":U
     1103           .
     1104         end.
     1105       end.
     1106       delete object bh_tbl-name.
     1107       if     bh_tbl-key ne ?
     1108       then
     1109          delete object bh_tbl-key.
     1110       if p-key-handle = ?
     1111         and v-count-fld <> v-field-num
     1112       then do:
     1113         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info10, vTable ).
     1114       end.
     1115     end.
     1116   end procedure.
     1117   procedure gen-hn-keyr-tab :
     1118     define input  parameter i-tableSerach as character no-undo.
     1119     define input  parameter i-tablekey   as character no-undo.
     1120     define input  parameter p-key-rec    as character no-undo.
     1121     define input  parameter p-key-handle as handle    no-undo .
     1122     define input  parameter p-db-name    as character no-undo .
     1123     define input  parameter p-tt-handle  as handle    no-undo .
     1124     define input  parameter p-stts-lock  as integer   no-undo .
     1125     define output parameter o-hn         as handle    no-undo.
     1126     define variable v-full-tbl-name as character no-undo.
     1127     define variable v-where         as character no-undo.
     1128     define variable bh_tbl-name     as handle    no-undo.
     1129     define variable vTable          as character no-undo.
     1130     do
     1131     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1132     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1133     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1134         run gen-where-keyr-tab(i-tableSerach,
     1135                                i-tablekey,
     1136                                p-key-rec,
     1137                                p-key-handle,
     1138                                p-db-name,
     1139                                p-tt-handle,
     1140                                output v-where).
     1141         if i-tableSerach ne "" and i-tableSerach ne ?
     1142         then do:
     1143            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1144            create buffer bh_tbl-name for table v-full-tbl-name .
     1145         end.
     1146         else do:
     1147            if p-tt-handle = ? then do:
     1148               assign
     1149                  vTable = entry( 1 , p-key-rec, chr(3) )
     1150               .
     1151               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1152               create buffer bh_tbl-name for table v-full-tbl-name .
     1153            end.
     1154            else do:
     1155               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1156            end.
     1157         end.
     1158         if p-tt-handle = ? then do:
     1159            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1160         end.
     1161         else do:
     1162            bh_tbl-name:find-first( v-where ) no-error .
     1163         end.
     1164         o-hn = bh_tbl-name.
     1165      end.
     1166   end procedure.
     1167   procedure gen-hn-keyr :
     1168     define input  parameter p-key-rec    as character no-undo.
     1169     define input  parameter p-key-handle as handle    no-undo .
     1170     define input  parameter p-db-name    as character no-undo .
     1171     define input  parameter p-tt-handle  as handle    no-undo .
     1172     define input  parameter p-stts-lock  as integer   no-undo .
     1173     define output parameter o-hn         as handle    no-undo.
     1174     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1175   end.
     1176   procedure gen-row-keyr :
     1177     define input  parameter p-key-rec    as character no-undo.
     1178     define input  parameter p-key-handle as handle    no-undo .
     1179     define input  parameter p-db-name    as character no-undo .
     1180     define input  parameter p-tt-handle  as handle    no-undo .
     1181     define input  parameter p-stts-lock  as integer   no-undo .
     1182     define output parameter p-tbl-row    as rowid     no-undo.
     1183     define output parameter p-tbl-name   as character no-undo.
     1184     define variable vHn as handle no-undo.
     1185       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1186       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1187       p-tbl-name =  vHn:table.
     1188       delete object vHn no-error.
     1189     if p-tbl-row = ? then do:
     1190       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info10, p-tbl-name, p-key-rec ).
     1191     end.
     1192     else do:
     1193       return.
     1194     end.
     1195   end procedure.
     1196   procedure gen-key-fv :
     1197     define input  parameter p-key-rec    as character no-undo .
     1198     define output parameter p-field-list as character no-undo .
     1199     define output parameter p-value-list as character no-undo.
     1200     do
     1201     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1202     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1203     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1204     :
     1205       define variable v-full-tbl-name  as character no-undo .
     1206       define variable bh_tbl-name      as handle    no-undo .
     1207       define variable v-tbl-name       as character no-undo .
     1208       define variable v-field-num      as integer   no-undo .
     1209       define variable v-count-fld      as integer   no-undo .
     1210       define variable v-inform         as character no-undo .
     1211       define variable v-ind            as integer   no-undo .
     1212       define variable v-idx-field-qnty as integer   no-undo .
     1213       define variable v-delim-key      as character no-undo .
     1214       if p-key-rec = ?
     1215         or p-key-rec = "":U
     1216       then do:
     1217         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info10 ).
     1218       end.
     1219       assign
     1220         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1221         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1222       .
     1223       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1224       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info10 ).
     1225       assign
     1226         v-inform = bh_tbl-name:index-information(1)
     1227         v-ind    = 2
     1228       .
     1229       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1230       on error undo, return error
     1231       :
     1232         assign
     1233           v-inform = bh_tbl-name:index-information( v-ind )
     1234           v-ind    = v-ind + 1
     1235         .
     1236       end.
     1237       if v-inform = ?
     1238         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1239         or entry( 3, v-inform, ",":U ) <> "1":U
     1240       then do:
     1241         delete object bh_tbl-name no-error.
     1242         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info10, v-tbl-name ).
     1243       end.
     1244       assign
     1245         v-idx-field-qnty = num-entries( v-inform ) - 4
     1246       .
     1247       if v-idx-field-qnty < 2 then do:
     1248         delete object bh_tbl-name no-error.
     1249         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info10, v-inform, v-tbl-name ).
     1250       end.
     1251       assign
     1252         p-field-list = "":U
     1253         p-value-list = "":U
     1254         v-delim-key  = "":U
     1255         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1256         v-count-fld  = 0
     1257       .
     1258       block_where:
     1259       do v-ind = 1 to v-idx-field-qnty by 2
     1260       on error undo, return error
     1261       :
     1262         assign
     1263           v-count-fld = v-count-fld + 1
     1264         .
     1265         if v-count-fld > v-field-num then do:
     1266           leave block_where.
     1267         end.
     1268         assign
     1269           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1270           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1271         .
     1272         if v-ind = 1 then do:
     1273           assign
     1274             v-delim-key = chr(3)
     1275           .
     1276         end.
     1277       end.
     1278       delete object bh_tbl-name.
     1279       if v-count-fld <> v-field-num then do:
     1280         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info10, v-tbl-name ).
     1281       end.
     1282     end.
     1283   end procedure.
     1284   procedure gen-key-field :
     1285     define input  parameter p-table      as character no-undo .
     1286     define output parameter p-field-list as character no-undo .
     1287     do
     1288     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1289     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1290     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1291     :
     1292       define variable v-full-tbl-name  as character no-undo .
     1293       define variable bh_tbl-name      as handle    no-undo .
     1294       define variable v-tbl-name       as character no-undo .
     1295       define variable v-field-num      as integer   no-undo .
     1296       define variable v-count-fld      as integer   no-undo .
     1297       define variable v-inform         as character no-undo .
     1298       define variable v-ind            as integer   no-undo .
     1299       define variable v-idx-field-qnty as integer   no-undo .
     1300       define variable v-delim-key      as character no-undo .
     1301       if p-table = ?
     1302         or p-table = "":U
     1303       then do:
     1304         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info10 ).
     1305       end.
     1306       assign
     1307         v-tbl-name      = p-table
     1308         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1309       .
     1310       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1311       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info10 ).
     1312       assign
     1313         v-inform = bh_tbl-name:index-information(1)
     1314         v-ind    = 2
     1315       .
     1316       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1317       on error undo, return error
     1318       :
     1319         assign
     1320           v-inform = bh_tbl-name:index-information( v-ind )
     1321           v-ind    = v-ind + 1
     1322         .
     1323       end.
     1324       if v-inform = ?
     1325         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1326         or entry( 3, v-inform, ",":U ) <> "1":U
     1327       then do:
     1328         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info10, v-tbl-name ).
     1329       end.
     1330       assign
     1331         v-idx-field-qnty = num-entries( v-inform ) - 4
     1332       .
     1333       if v-idx-field-qnty < 2 then do:
     1334         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info10, v-inform, v-tbl-name ).
     1335       end.
     1336       assign
     1337         p-field-list = "":U
     1338         v-delim-key  = "":U
     1339         v-count-fld  = 0
     1340       .
     1341       block_where:
     1342       do v-ind = 1 to v-idx-field-qnty by 2
     1343       on error undo, return error
     1344       :
     1345         assign
     1346           v-count-fld = v-count-fld + 1
     1347         .
     1348         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1349         if v-ind = 1 then do:
     1350           assign
     1351             v-delim-key = chr(3)
     1352           .
     1353         end.
     1354       end.
     1355       delete object bh_tbl-name.
     1356     end.
     1357   end procedure.
     1358   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1359   FUNCTION get-region RETURNS CHARACTER
     1360     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1361     define variable par-region as character no-undo.
     1362     if parhost-code = 0 and
     1363          parobj-type = "":U and
     1364          parobj-code = 0 then do:
     1365          par-region = "Глобально".
     1366          return par-region.
     1367       end.
     1368       if parobj-type = 'орг':U then do:
     1369          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1370          return par-region.
     1371       end.
     1372       if parobj-type = 'регион':U
     1373       then do:
     1374          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1375          return par-region.
     1376       end.
     1377       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1378       return par-region.
     1379   END FUNCTION.
     1380   FUNCTION get-objregion RETURNS CHARACTER
     1381     (  input parobj-type as character, input parobj-code as integer ) :
     1382     define variable par-region as character no-undo.
     1383     if  parobj-type = "":U and
     1384         parobj-code = 0
     1385     then do:
     1386        par-region = "Глобально".
     1387     end.
     1388     else if parobj-type = 'орг':U
     1389     then do:
     1390        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1391     end.
     1392     else if parobj-type = 'регион':U
     1393     then do:
     1394        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1395     end.
     1396     else
     1397        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1398     return par-region.
     1399   END FUNCTION.
     1400   FUNCTION calldscr returns character ( input p-call-id as character):
     1401   define variable v-descr as character no-undo .
     1402   define variable v-field-list as character no-undo .
     1403   define variable v-value-list as character no-undo.
     1404   define variable v-prop-label as character no-undo .
     1405   define variable v-node-label as character no-undo .
     1406   define variable v-dt-code as integer no-undo .
     1407   define variable v-host-code as integer no-undo .
     1408   define variable v-obj-type as character no-undo .
     1409   define variable v-obj-code as integer no-undo .
     1410   define variable v-label as character no-undo .
     1411   define variable v-node-code as integer no-undo .
     1412   define buffer buf_prop-head for ub.prop-head.
     1413   define buffer buf_prop-ref for ub.prop-ref.
     1414   define buffer buf_prop-map for ub.prop-map.
     1415   run gen-key-fv in this-procedure ( input p-call-id
     1416                                     ,output v-field-list
     1417                                     ,output v-value-list) no-error .
     1418   if error-status:error then return p-call-id.
     1419   CASE entry(1, p-call-id, chr(3)):
     1420     when 'dis-card-type':U then do:
     1421       v-descr = substitute("Тип ДК: эмитент &1 тип: &2"
     1422                            ,integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1423                            ,entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
     1424                            ).
     1425     end.
     1426     when 'dis-card':U then do:
     1427       v-descr = substitute("ДК: № &1"
     1428                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1429                            ).
     1430     end.
     1431     when 'dis-card-property':U then do:
     1432       v-dt-code = integer(entry(lookup("dt-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1433       v-node-code = integer(entry(lookup("node-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1434       v-host-code = integer(entry(lookup("host-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1435       v-obj-type = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3)) .
     1436       v-obj-code = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1437       find first buf_prop-ref no-lock where
     1438                 buf_prop-ref.dt-code = v-dt-code no-error .
     1439       if available buf_prop-ref then do:
     1440         find first buf_prop-head no-lock where
     1441                   buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error .
     1442         v-prop-label = buf_prop-head.prop-label.
     1443         find first buf_prop-map no-lock where
     1444                   buf_prop-map.dtm-code = buf_prop-ref.dtm-code
     1445               and buf_prop-map.node-code = v-node-code no-error .
     1446         if available buf_prop-map then do:
     1447           v-label = buf_prop-map.node-label.
     1448         end.
     1449       end.
     1450       v-descr = substitute("ДК: № &1 &2:&3 &4"
     1451                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1452                            ,v-prop-label
     1453                            ,v-label
     1454                            ,get-region(v-host-code, v-obj-type, v-obj-code)
     1455                            ).
     1456     end.
     1457     when 'clients':U then do:
     1458       v-descr = substitute("&1&2"
     1459                            ,entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
     1460                            ,integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1461                            ).
     1462     end.
     1463     when 'ext-system':U then do:
     1464       v-descr = substitute("Внешняя система &1"
     1465                            ,integer(entry(lookup("esys-id", v-field-list, chr(3)), v-value-list, chr(3)))
     1466                            ).
     1467     end.
     1468     WHEN 'thbj-attr':U then do:
     1469       if entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum':U
     1470       or entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum_obj':U
     1471       then do:
     1472         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'goods':U then do:
     1473           v-descr = "Операции с товарами".
     1474         end.
     1475         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'clients':U then do:
     1476           v-descr = "Операции с клиентами".
     1477         end.
     1478         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'gds-grp':U then do:
     1479           v-descr = "Операции с группами товаров".
     1480         end.
     1481         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'cli-grp':U then do:
     1482           v-descr = "Операции с группами клиентов".
     1483         end.
     1484         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th':U then do:
     1485           v-descr = "Операции с чеками на POS IBS-TH".
     1486         end.
     1487         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th-mob':U then do:
     1488           v-descr = "Операции с чеками на POS IBS-TH-MOB".
     1489         end.
     1490         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'edoc':U then do:
     1491           v-descr = "Операции в системе электронного документооборота".
     1492         end.
     1493         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'thref':U then do:
     1494           v-descr = "Операции со справочниками".
     1495         end.
     1496         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'pdf':U then do:
     1497           v-descr = "Операции с ДНЦ и переоценками".
     1498         end.
     1499         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rep':U then do:
     1500           v-descr = "Отчеты".
     1501         end.
     1502         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'ord':U then do:
     1503           v-descr = "Операции с заказами".
     1504         end.
     1505       end.
     1506     end.
     1507     when 'cash-desk':U then do:
     1508       v-descr = substitute("БД &1 Маг &2 Касса № &4 &3"
     1509                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1510                            ,entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3))
     1511                            ,entry(lookup("cash-num", v-field-list, chr(3)), v-value-list, chr(3))
     1512                            ,entry(lookup("pos-type", v-field-list, chr(3)), v-value-list, chr(3))
     1513                            ).
     1514     end.
     1515     when 'ext-file':U then do:
     1516       v-descr = substitute("БД &1 Файл № &3 (из БД &2)"
     1517                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1518                            ,entry(lookup("from-db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1519                            ,entry(lookup("file-num", v-field-list, chr(3)), v-value-list, chr(3))
     1520                            ).
     1521     end.
     1522   end case.
     1523   return v-descr.
     1524   end function.
