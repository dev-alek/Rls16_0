     3081           define variable v-cntxt-db-num        as integer   no-undo .
     3082           define variable v-cntxt-userid        as character no-undo .
     3083           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3084                                             , OUTPUT v-cntxt-userid
     3085                                             ) .
