     3099   end procedure.
     3100   procedure diasize_set-width :
     3101     define input  parameter p-new-width  as decimal   no-undo .
     3102     define input  parameter p-move-resize as logical   no-undo .
     3103     do
     3104     on error undo, return error return-value
     3105     :
     3106       run diasize_change-width in this-procedure
     3107         (input  (p-new-width - frame Dialog-Frame :width)
     3108         ,input  p-move-resize
     3109         ) .
     3110     end.
     3111   end procedure.
     3112   procedure diasize_position-resize-button :
     3113     do with frame Dialog-Frame
     3114     :
     3115       hide v-diasize-resize-button .
     3116       assign
     3117         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3118                     - 1
     3119                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3120         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3121                     - 1
     3122                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3123       .
     3124       view v-diasize-resize-button .
     3125     end.
     3126   end procedure.
     3127   on alt-right anywhere
     3128   do:
     3129     run diasize_change-width in this-procedure
     3130       (input 1
     3131       ,input true
     3132       ) .
     3133     return no-apply .
     3134   end.
     3135   on alt-left anywhere
     3136   do:
     3137     run diasize_change-width in this-procedure
     3138       (input -1
     3139       ,input true
     3140       ) .
     3141     return no-apply .
     3142   end.
     3143   on alt-down anywhere
     3144   do:
     3145     run diasize_change-height in this-procedure
     3146       (input 1
     3147       ,input true
     3148       ) .
     3149     return no-apply .
     3150   end.
     3151   on alt-up anywhere
     3152   do:
     3153     run diasize_change-height in this-procedure
     3154       (input -1
     3155       ,input true
     3156       ) .
     3157     return no-apply .
     3158   end.
     3159   on alt-enter of frame Dialog-Frame
     3160   do:
     3161     run diasize_maximize in this-procedure
     3162       (input  ?
     3163       ).
     3164     return no-apply .
     3165   end.
     3166   procedure diasize_end-move :
     3167     do
     3168     on error undo, return error return-value
     3169     :
     3170       define variable v-row-delta as decimal   no-undo .
     3171       define variable v-col-delta as decimal   no-undo .
     3172       define variable v-new-row as decimal   no-undo .
     3173       define variable v-new-col as decimal   no-undo .
     3174       assign
     3175         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3176         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3177       .
     3178       assign
     3179         v-row-delta = v-new-row - frame Dialog-Frame :height
     3180         v-col-delta = v-new-col - frame Dialog-Frame :width
     3181       .
     3182       run diasize_change-height in this-procedure
     3183         (input v-row-delta
     3184         ,input true
     3185         ) .
     3186       run diasize_change-width in this-procedure
     3187         (input v-col-delta
     3188         ,input true
     3189         ) .
     3190     end.
     3191   end procedure.
     3192   procedure diasize_maximize :
     3193     define input  parameter p-action as logical   no-undo .
     3194     do
     3195     on error undo, return error return-value
     3196     :
     3197       if p-action = ?
     3198       then do:
     3199         if v-diasize-need-maximize = true
     3200         then do:
     3201           assign
     3202             p-action = true
     3203           .
     3204         end.
     3205         else do:
     3206           assign
     3207             p-action = false
     3208           .
     3209         end.
     3210       end.
     3211       if p-action = true
     3212       then do:
     3213         run diasize_change-height in this-procedure
     3214           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3215               - frame Dialog-Frame :height-chars
     3216           ,input true
     3217           ) .
     3218         run diasize_change-width in this-procedure
     3219           (input session :width-chars
     3220               - frame Dialog-Frame :width-chars
     3221           ,input true
     3222           ) .
     3223         assign
     3224           v-diasize-need-maximize = false
     3225         .
     3226       end.
     3227       else do:
     3228         run diasize_change-width in this-procedure
     3229           (input v-diasize-orig-frame-width
     3230               - frame Dialog-Frame :width-chars
     3231           ,input true
     3232           ) .
     3233         run diasize_change-height in this-procedure
     3234           (input v-diasize-orig-frame-height
     3235               - frame Dialog-Frame :height-chars
     3236           ,input true
     3237           ) .
     3238         assign
     3239           v-diasize-need-maximize = true
     3240         .
     3241       end.
     3242     end.
     3243   end procedure.
     3244   procedure diasize_restore-orig-size :
     3245     do
     3246     on error undo, return error return-value
     3247     :
     3248       assign
     3249         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3250         v-diasize-current-frame-height = frame Dialog-Frame :height
     3251       .
     3252       run diasize_set-height in this-procedure
     3253         (input  v-diasize-orig-frame-height
     3254         ,input  true
     3255         ) .
     3256       run diasize_set-width in this-procedure
     3257         (input  v-diasize-orig-frame-width
     3258         ,input  true
     3259         ) .
     3260     end.
     3261   end procedure.
     3262   procedure diasize_restore-current-size :
     3263     do
     3264     on error undo, return error return-value
     3265     :
     3266       run diasize_set-height in this-procedure
     3267         (input  v-diasize-current-frame-height
     3268         ,input  true
     3269         ) .
     3270       run diasize_set-width in this-procedure
     3271         (input  v-diasize-current-frame-width
     3272         ,input  true
     3273         ) .
     3274     end.
     3275   end procedure.
     3276   procedure diasize_set-browse-handle :
     3277     define input  parameter p-browse-handle as handle   no-undo .
     3278     define buffer buf_temp-browse-handle for temp-browse-handle .
     3279     do
     3280     on error undo, return error return-value
     3281     :
     3282       assign
     3283         v-diasize-browse-handle = p-browse-handle
     3284       .
     3285       for each buf_temp-browse-handle
     3286       on error undo, return error return-value
     3287       :
     3288         delete buf_temp-browse-handle .
     3289       end.
     3290     end.
     3291   end procedure.
     3292   procedure diasize_add_browse :
     3293     define input  parameter p-browse-type   as character no-undo .
     3294     define input  parameter p-browse-handle as handle    no-undo .
     3295     define buffer buf_temp-browse-handle for temp-browse-handle .
     3296     do
     3297     on error undo, return error return-value
     3298     :
     3299       assign
     3300         v-diasize-browse-number = v-diasize-browse-number + 1
     3301       .
     3302       create buf_temp-browse-handle .
     3303       assign
     3304         buf_temp-browse-handle.browse-type   = p-browse-type
     3305         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3306         buf_temp-browse-handle.browse-handle = p-browse-handle
     3307       .
     3308     end.
     3309   end procedure.
     3310   procedure diasize_init :
     3311     define variable v-default-value    as logical   no-undo .
     3312     define variable v-restore-saved    as logical   no-undo .
     3313     define variable v-resize-value-str as character no-undo .
     3314     do
     3315     on error undo, return error return-value
     3316     :
     3317       do with frame Dialog-Frame
     3318       :
     3319         assign
     3320           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3321           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3322           v-diasize-browse-handle     = browse br-stop-list-line :handle
     3323         .
     3324         create button v-diasize-resize-button
     3325         assign
     3326           parent        = frame Dialog-Frame :first-child
     3327           label         = "s"
     3328           height-pixels = 16
     3329           width-pixels  = 16
     3330           visible       = true
     3331           sensitive     = true
     3332           movable       = true
     3333           triggers:
     3334             on end-move persistent run diasize_end-move in this-procedure .
     3335           end triggers.
     3336         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3337         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3338         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3339         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3340         assign
     3341           v-diasize-wndmax = false
     3342         .
     3343         if connected("ub") = true
     3344         then do:
     3345           define variable v-cntxt-db-num        as integer   no-undo .
     3346           define variable v-cntxt-userid        as character no-undo .
     3347           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3348                                             , OUTPUT v-cntxt-userid
     3349                                             ) .
     3350           run gbl/wndpar_r.p
     3351             (input  v-cntxt-db-num
     3352             ,input  v-cntxt-userid
     3353             ,input  'wndmax':U
     3354             ,output v-diasize-wndmax
     3355             ,output v-default-value
     3356             ) .
     3357         end.
     3358         assign
     3359           v-diasize-wndstore = false
     3360         .
     3361         if connected("ub") = true
     3362         then do:
     3363           run gbl/wndpar_r.p
     3364             (input  v-cntxt-db-num
     3365             ,input  v-cntxt-userid
     3366             ,input  'wndstore':U
     3367             ,output v-diasize-wndstore
     3368             ,output v-default-value
     3369             ) .
     3370         end.
     3371         assign
     3372           v-diasize-proc-name = entry(1, program-name(2), '.')
     3373         .
     3374         if v-diasize-wndstore = true
     3375         then do:
     3376           assign
     3377             v-restore-saved = false
     3378           .
     3379           if connected("ub") = true
     3380           then do:
     3381             run gbl/wndsizer.p
     3382               (input  v-cntxt-db-num
     3383               ,input  v-cntxt-userid
     3384               ,input  v-diasize-proc-name
     3385               ,input  'height':u
     3386               ,output v-resize-value-str
     3387               ) .
     3388             if v-resize-value-str <> '':U
     3389             then do:
     3390               run diasize_change-height in this-procedure
     3391                 (input  integer(v-resize-value-str)
     3392                 ,input  true
     3393                 ) .
     3394               assign
     3395                 v-restore-saved = true
     3396               .
     3397             end.
     3398           end.
     3399           if connected("ub") = true
     3400           then do:
     3401             run gbl/wndsizer.p
     3402               (input  v-cntxt-db-num
     3403               ,input  v-cntxt-userid
     3404               ,input  v-diasize-proc-name
     3405               ,input  'width':u
     3406               ,output v-resize-value-str
     3407               ) .
     3408             if v-resize-value-str <> '':U
     3409             then do:
     3410               run diasize_change-width in this-procedure
     3411                 (input  integer(v-resize-value-str)
     3412                 ,input  true
     3413                 ) .
     3414               assign
     3415                 v-restore-saved = true
     3416               .
     3417             end.
     3418           end.
     3419           if v-restore-saved <> true
     3420           then do:
     3421             if v-diasize-wndmax = true
     3422             then do:
     3423               run diasize_maximize in this-procedure
     3424                 (input  true
     3425                 ) .
     3426             end.
     3427           end.
     3428         end.
     3429         else do:
     3430           if v-diasize-wndmax = true
     3431           then do:
     3432             run diasize_maximize in this-procedure
     3433               (input  true
     3434               ) .
     3435           end.
     3436         end.
     3437       end.
     3438     end.
     3439   end procedure.
     3440   procedure diasize_need-full-display :
     3441     define output parameter p-need-full-display as logical   no-undo .
     3442     do
     3443     on error undo, return error return-value
     3444     :
     3445       assign
     3446         p-need-full-display = v-diasize-need-full-display
     3447       .
     3448       assign
     3449         v-diasize-need-full-display = false
     3450       .
     3451     end.
     3452   end procedure.
     3453   procedure get-context :
     3454      define output parameter p-db-num as integer          no-undo.
     3455      define output parameter p-user-id as character        no-undo.
     3456      define variable v-login               as character    no-undo.
     3457      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3458      define buffer buf_user-login  for ub.user-login .
     3459      do
     3460      on error undo, return error
     3461      :
     3462            FIND FIRST buf_sys-ctrl no-lock.
     3463            ASSIGN
     3464               v-login = USERID("ub")
     3465               p-db-num = buf_sys-ctrl.db-num
     3466            .
     3467            FIND FIRST buf_user-login
     3468                 WHERE buf_user-login.db-num = p-db-num
     3469                   AND buf_user-login.user-login = v-login
     3470                 no-lock
     3471                 no-error
     3472                 .
     3473            IF AVAILABLE buf_user-login
     3474            THEN DO:
     3475               assign
     3476                  p-user-id = buf_user-login.user-id
     3477               .
     3478            END.
     3479      end.
     3480   end procedure.
     3481       run diasize_init in this-procedure .
     3482   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3483   do:
     3484     br-stop-list-line :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     3485   end.
     3486   define variable vss-include-info25 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3487   on INS of frame Dialog-Frame anywhere do:
     3488     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     3489     return no-apply.
     3490   end.
     3491   define variable vss-include-info26 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3492   on F3 of frame Dialog-Frame anywhere do:
     3493     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame Dialog-Frame. END.
     3494     return no-apply.
     3495   end.
     3496   define variable vss-include-info27 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3497   on F2 of frame Dialog-Frame anywhere do:
     3498     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     3499     return no-apply.
     3500   end.
     3501   define variable vss-include-info28 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3502   on F2 of frame Dialog-Frame anywhere do:
     3503     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     3504     return no-apply.
     3505   end.
     3506   define variable vss-include-info29 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3507   on CTRL-P, CTRL-З of frame Dialog-Frame anywhere do:
     3508     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame Dialog-Frame. END.
     3509     return no-apply.
     3510   end.
     3511   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3512   procedure set-filter-name :
     3513   define input parameter p-filter-name as character no-undo .
     3514     do with frame Dialog-Frame:
     3515       if p-filter-name > "" then do:
     3516         assign
     3517           frame Dialog-Frame:title
     3518             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     3519         .
     3520         assign
     3521           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     3522         .
     3523       end.
     3524       else do:
     3525         assign
     3526           b-sch :tooltip = ""
     3527         .
     3528       end.
     3529     end.
     3530   end procedure.
     3531   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3532   on f5 of frame Dialog-Frame anywhere
     3533   do:
     3534      if available X_stop-list-line then v-doc-rec = recid(X_stop-list-line).     RUn OpenBr in this-procedure ( input yes, input no, input '':U, input rs-cli-type, input frame Dialog-Frame sch-cli-code).     reposition br-stop-list-line to recid v-doc-rec no-error.
     3535       apply "VALUE-CHANGED" to br-stop-list-line.
     3536   end.
     3537   MAIN-BLOCK:
     3538   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3539      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3540      ON STOP UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3541   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3542     run mainmenu_getcntxt in parparentproc
     3543       (output v-cntxt-db-num
     3544       ,output v-cntxt-userid
     3545       ,output v-cntxt-level
     3546       ,output v-cntxt-host-code-obj
     3547       ,output v-cntxt-obj-type
     3548       ,output v-cntxt-obj-code
     3549       ,output v-cntxt-db-num-obj
     3550       ,output v-cntxt-is-admin
     3551       ) .
     3552    if not (p-mode = 'ИЗМЕНЕНИЕ':U
     3553          or p-mode = 'ПРОСМОТР':U) then do:
     3554       message
     3555       substitute("Неверное значение параметра p-mode=&1 ", p-mode)
     3556       view-as alert-box error.
     3557       undo main-block, return error .
     3558     end.
     3559     ASSIGN
     3560     v-rid-list = p-rid-list.
     3561    case p-mode:
     3562       when  'ПРОСМОТР':U then do:
     3563         if p-stop-list-code <> "":U
     3564         then do:
     3565           find first buf_stop-list no-lock where
     3566                     buf_stop-list.stop-list-code = p-stop-list-code
     3567               AND buf_stop-list.classif-type = 'dis-card':U  no-error.
     3568           if not available buf_stop-list then do:
     3569             message
     3570             substitute("Не найден стоплист ДК &1", p-stop-list-code)
     3571             view-as alert-box error .
     3572             undo, return error .
     3573           end.
     3574         end.
     3575         if p-d-card <> '':U then do:
     3576           find first buf_Dis-card no-lock where
     3577                     buf_Dis-card.d-card = p-d-card no-error.
     3578           if not available buf_Dis-card then do:
     3579             message
     3580             substitute("Не найдена ДК &1", p-d-card)
     3581             view-as alert-box error .
     3582             undo, return error .
     3583           end.
     3584           find first buf_clients no-lock where
     3585                     buf_clients.obj-type = buf_Dis-card.cli-type
     3586                 and buf_clients.obj-code = buf_Dis-card.cli-code no-error.
     3587           if not available buf_Dis-card then do:
     3588             message
     3589             substitute("Не найден держатель карты ДК &1 &2&3"
     3590                         , p-d-card
     3591                         , buf_Dis-card.cli-type
     3592                         , buf_Dis-card.cli-code
     3593                         )
     3594             view-as alert-box error .
     3595             undo, return error .
     3596           end.
     3597           RUN gen-key-rec IN THIS-PROCEDURE ( INPUT 'dis-card':U
     3598                                              ,INPUT BUFFER buf_dis-card:HANDLE
     3599                                              ,OUTPUT v-card-resource-id).
     3600           RUN gen-key-rec IN THIS-PROCEDURE ( INPUT 'clients':U
     3601                                              ,INPUT BUFFER buf_clients:HANDLE
     3602                                              ,OUTPUT v-client-resource-id).
     3603         end.
     3604       end.
     3605       when 'ИЗМЕНЕНИЕ':U then do:
     3606         if p-d-card <> '':U then do:
     3607           message
     3608           substitute("Неверное значение параметре p-d-card=&1&2Данный параметр при редактировании задан быть не может"
     3609                       , p-d-card
     3610                       , chr(10))
     3611           view-as alert-box error .
     3612           undo main-block, return error .
     3613         end.
     3614         do transaction:
     3615         find first buf_stop-list exclusive-lock where
     3616                   buf_stop-list.stop-list-code = p-stop-list-code
     3617             AND buf_stop-list.classif-type = 'dis-card':U  no-error.
     3618         end.
     3619         if not available buf_stop-list then do:
     3620           message
     3621           substitute("Не найден стоплист &1", p-stop-list-code)
     3622           view-as alert-box error .
     3623           undo main-block, return error .
     3624         end.
     3625         if buf_stop-list.status_ = 'факт':U then do:
     3626           message
     3627           substitute("Стоплист &1 находится в статусе &2&3Изменение невозможно"
     3628                       , p-stop-list-code
     3629                       , buf_stop-list.status_
     3630                       , chr(10)
     3631                       )
     3632           view-as alert-box error .
     3633           undo main-block, return error .
     3634         end.
     3635       end.
     3636     end case.
     3637     RUN Myenable IN THIS-PROCEDURE NO-ERROR.
     3638     IF v-rid-list <> '':U THEN DO:
     3639       REPOSITION br-stop-list-line to RECID INTEGER(entry(1, v-rid-list)) NO-ERROR.
     3640       APPLY "entry" to br-stop-list-line.
     3641       APPLY "value-changed" TO br-stop-list-line.
     3642     END.
     3643     WAIT-FOR GO OF FRAME Dialog-Frame.
     3644   END.
     3645   RUN disable_UI.
     3646   PROCEDURE disable_UI :
     3647     HIDE FRAME Dialog-Frame.
     3648   END PROCEDURE.
     3649   PROCEDURE enable_UI :
     3650     DISPLAY sch-d-card sch-cli-code RS-cli-type mark-num fi-search
     3651         WITH FRAME Dialog-Frame.
     3652     ENABLE b-quit B-mark B-sel b-add b-chg b-del b-lkp b-cli b-print b-sch B-Help
     3653            sch-d-card sch-cli-code RS-cli-type B-cli-2 br-stop-list-line mark-num
     3654            fi-search
     3655         WITH FRAME Dialog-Frame.
     3656     VIEW FRAME Dialog-Frame.
     3657     OPEN QUERY br-stop-list-line FOR EACH X_stop-list-line NO-LOCK WHERE         X_stop-list-line.classif-type = 'dis-card':U      AND X_stop-list-line.stop-list-code = p-stop-list-code ,            FIRST X_DIS-CARD NO-LOCK WHERE          X_dis-card.d-card = X_stop-list-line.charkey_one,            first  X_clients NO-LOCK WHERE          X_clients.obj-type  = X_dis-card.cli-type     AND  X_clients.obj-code  = X_dis-card.cli-code     INDEXED-REPOSITION.
     3658   END PROCEDURE.
     3659   PROCEDURE MyEnable :
     3660   DEFINE variable v-h AS HANDLE NO-UNDO.
     3661   ASSIGN
     3662   RS-cli-type:radio-buttons IN FRAME Dialog-Frame = 'орг':U + chr(44) + 'орг':U + chr(44) + 'чел':U + chr(44) + 'чел':U
     3663   X_clients.obj-name:RESIZABLE IN BROWSE br-stop-list-line = YES
     3664   RS-cli-type = 'орг':U
     3665   b-add:MENU-MOUSE in FRAME Dialog-Frame = 1
     3666   b-chg:MENU-MOUSE in FRAME Dialog-Frame = 1
     3667   b-del:MENU-MOUSE in FRAME Dialog-Frame = 1
     3668   v-h = br-stop-list-line:FIRST-COLUMN IN FRAME Dialog-Frame
     3669   .
     3670   DO while valid-handle(v-h) :
     3671     if (v-h:LABEL = "Клиент" and p-d-card <> '')
     3672     OR (v-h:LABEL = "Заблокированный!ресурс" and p-d-card <> '')
     3673     then do:
     3674       v-h:visible = no.
     3675       leave.
     3676     end.
     3677     ELSE DO:
     3678       v-h = v-h:NEXT-COLUMN.
     3679     END.
     3680   END.
     3681   ASSIGN
     3682   v-doc-date:VISIBLE IN BROWSE br-stop-list-line = (p-d-card <> '')
     3683   v-sl-status:VISIBLE IN BROWSE br-stop-list-line = (p-d-card <> '')
     3684   X_stop-list-line.charkey_one:VISIBLE IN BROWSE br-stop-list-line = (p-d-card = '')
     3685   X_clients.obj-name:VISIBLE IN BROWSE br-stop-list-line = (p-d-card = '')
     3686   .
     3687   display
     3688   rs-cli-type
     3689   with frame Dialog-Frame .
     3690   ENABLE
     3691   b-quit
     3692   B-mark  when lookup("b-mark", bttns) > 0 OR P-MODE <> 'ПРОСМОТР':U
     3693   B-sel when lookup("b-sel", bttns) > 0
     3694   b-add WHEN p-mode <> 'ПРОСМОТР':U and not transaction
     3695   b-CHG WHEN p-mode <> 'ПРОСМОТР':U and not transaction
     3696   b-DEL WHEN p-mode <> 'ПРОСМОТР':U and not transaction
     3697   b-sch  when p-d-card = '':U
     3698   b-cli
     3699   b-print
     3700   b-lkp
     3701   B-Help
     3702   RS-cli-type when p-d-card = '':U
     3703   sch-cli-code when p-d-card = '':U
     3704   sch-d-card when p-d-card = '':U
     3705   B-CLI-2 when p-d-card = '':U
     3706   BR-stop-list-line
     3707   WITH FRAME Dialog-Frame .
     3708   VIEW FRAME Dialog-Frame .
     3709   if p-d-card <> '':U then do:
     3710     hide
     3711     RS-cli-type
     3712     sch-cli-code
     3713     sch-d-card
     3714     B-CLI-2
     3715     rs-cli-type
     3716     fi-search
     3717     in frame Dialog-Frame .
     3718   end.
     3719   run openbr in this-procedure ( input yes, input no, input '':U, input rs-cli-type, input frame Dialog-Frame sch-cli-code).
     3720   END PROCEDURE.
