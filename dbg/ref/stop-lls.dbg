     4567   APPLY "ENTRY" TO br-stop-list-line.
     4568   END PROCEDURE.
     4569   PROCEDURE proc-b-add :
     4570   DEFINE INPUT PARAMETER p-add-option AS CHARACTER NO-UNDO.
     4571   define variable v-rid-list as character no-undo .
     4572   define variable v-ok as integer no-undo .
     4573   define variable v-ok-old as integer no-undo .
     4574   define variable v-ii as integer no-undo .
     4575   define variable v-jj as integer no-undo .
     4576   define variable v-num as integer no-undo .
     4577   define variable v-recid as recid no-undo .
     4578   define variable v-loc-rid-list as character no-undo .
     4579   define variable v-status-codes as character no-undo .
     4580   define variable v-sel-status-code as integer no-undo .
     4581   define variable v-status-codes-full as character no-undo .
     4582   define variable v-key-rec as character no-undo .
     4583   define variable choice as integer no-undo .
     4584   define buffer buf_Dis-card for ub.dis-card.
     4585   define buffer buf_clients for ub.clients.
     4586   define buffer exist_stop-list-line for Ub.stop-list-line.
     4587   case p-add-option:
     4588     when "list" then do:
     4589       v-sel-status-code = integer('1':U).
     4590       for each dc-list:
     4591         delete dc-list.
     4592       end.
     4593       run str/dc-list.w (
     4594                  input parparentproc
     4595                 ,input v-cntxt-host-code-obj
     4596                 ,input v-cntxt-obj-type
     4597                 ,input v-cntxt-obj-code) no-error.
     4598       v-num = 0.
     4599       for each dc-list no-lock:
     4600         if dc-list.mask-card then next.
     4601         v-num = v-num + 1.
     4602         run ref/stop-ll1.p (
     4603                           input 'ДОБАВЛЕНИЕ':U
     4604                         ,input no
     4605                         ,input-output v-recid
     4606                         ,input p-stop-list-code
     4607                         ,input dc-list.d-card
     4608                         ,input v-sel-status-code
     4609                         ) no-error.
     4610         if not error-status:error then do:
     4611           v-ok = v-ok + 1.
     4612         end.
     4613       end.
     4614     end.
     4615     when "list-client" then do:
     4616       v-sel-status-code = integer('2':U).
     4617       for each cli-list:
     4618         delete cli-list.
     4619       end.
     4620       run str/cli-list.w (
     4621                  input parparentproc
     4622                 ,input v-cntxt-host-code-obj
     4623                 ,input v-cntxt-obj-type
     4624                 ,input v-cntxt-obj-code) no-error.
     4625       v-num = 0.
     4626       for each cli-list no-lock,
     4627           each buf_dis-card no-lock where
     4628               buf_Dis-card.cli-type = cli-list.obj-type
     4629           and  buf_Dis-card.cli-code = cli-list.obj-code  :
     4630         if buf_Dis-card.mask-card then next.
     4631         v-num = v-num + 1.
     4632         RUN gen-key-rec IN THIS-PROCEDURE ( INPUT 'dis-card':U
     4633                                             ,INPUT BUFFER buf_Dis-card:HANDLE
     4634                                             ,OUTPUT v-key-rec).
     4635         find first exist_stop-list-line no-lock where
     4636                   exist_stop-list-line.stop-list-code = buf_stop-list.stop-list-code
     4637               AND exist_stop-list-line.classif-type = 'dis-card':U
     4638               and exist_stop-list-line.resource_id = v-key-rec no-error.
     4639         if available exist_stop-list-line
     4640         and exist_stop-list-line.key#_one = INTEGER('1':U) then do:
     4641           v-recid = recid(exist_stop-list-line).
     4642           run ref/stop-ll1.p (
     4643                             input 'ИЗМЕНЕНИЕ':U
     4644                           ,input no
     4645                           ,input-output v-recid
     4646                           ,input p-stop-list-code
     4647                           ,input buf_Dis-card.d-card
     4648                           ,input integer('3':U)
     4649                           ) no-error.
     4650           if not error-status:error then do:
     4651             v-ok-old = v-ok-old + 1.
     4652           end.
     4653         end.
     4654         else do:
     4655           run ref/stop-ll1.p (
     4656                             input 'ДОБАВЛЕНИЕ':U
     4657                           ,input no
     4658                           ,input-output v-recid
     4659                           ,input p-stop-list-code
     4660                           ,input buf_Dis-card.d-card
     4661                           ,input v-sel-status-code
     4662                           ) no-error.
     4663           if not error-status:error then do:
     4664             v-ok = v-ok + 1.
     4665           end.
     4666         end.
     4667       end.
     4668     end.
     4669     when "one" then do:
     4670       v-sel-status-code = integer('1':U).
     4671       run ref/discards.w ( INPUT parparentproc
     4672                       ,input "b-sel,b-mark":U
     4673                       ,input 'все':U
     4674                       ,INPUT v-cntxt-host-code-obj
     4675                       ,INPUT v-cntxt-obj-type
     4676                       ,INPUT v-cntxt-obj-code
     4677                       ,INPUT '':U
     4678                       ,input ?
     4679                       ,output v-loc-rid-list ) no-error .
     4680       if v-loc-rid-list <> '':U then do:
     4681         do v-ii =  1 to num-entries(v-loc-rid-list) :
     4682           v-num = v-num + 1.
     4683           find first buf_dis-card no-lock where
     4684                     recid(buf_dis-card) = integer(entry(v-ii, v-loc-rid-list)) no-error.
     4685           if available buf_dis-card
     4686           and buf_Dis-card.mask-card = no
     4687           then do:
     4688             run ref/stop-ll1.p (
     4689                             input 'ДОБАВЛЕНИЕ':U
     4690                             ,input no
     4691                             ,input-output v-recid
     4692                             ,input p-stop-list-code
     4693                             ,input buf_Dis-card.d-card
     4694                             ,input v-sel-status-code
     4695                             ) no-error.
     4696             if error-status:error then do:
     4697             end.
     4698             else do:
     4699               v-ok = v-ok + 1.
     4700             end.
     4701           end.
     4702         end.
     4703       end.
     4704       else do:
     4705         undo, return error .
     4706       end.
     4707     end.
     4708     when "one-client" then do:
     4709       v-sel-status-code = integer('2':U).
     4710       run ref/cli-all.w ( input parparentproc
     4711                     ,input "b-sel"
     4712                     ,input 'орг':U
     4713                     ,input 'все':U
     4714                     ,input 'текущие':U
     4715                     ,input ?
     4716                     ,input ",,,,,,NO,,"
     4717                     ,input ""
     4718                     ,output v-loc-rid-list ) NO-ERROR.
     4719       IF v-loc-rid-list = '':U THEN undo, return error .
     4720         do v-ii =  1 to num-entries(v-loc-rid-list) :
     4721           find first buf_clients no-lock where
     4722                     recid(buf_clients) = integer(entry(v-ii, v-loc-rid-list)) no-error.
     4723           if available buf_clients then do:
     4724             for each buf_dis-card no-lock where
     4725                     buf_Dis-card.cli-type = buf_clients.obj-type
     4726                 and buf_Dis-card.cli-code = buf_clients.obj-code:
     4727               if buf_Dis-card.mask-card then next.
     4728               v-num = v-num + 1.
     4729               RUN gen-key-rec IN THIS-PROCEDURE ( INPUT 'dis-card':U
     4730                                                   ,INPUT BUFFER buf_Dis-card:HANDLE
     4731                                                   ,OUTPUT v-key-rec).
     4732               find first exist_stop-list-line no-lock where
     4733                         exist_stop-list-line.stop-list-code = buf_stop-list.stop-list-code
     4734                     AND exist_stop-list-line.classif-type = 'dis-card':U
     4735                     and exist_stop-list-line.resource_id = v-key-rec no-error.
     4736               if available exist_stop-list-line
     4737               and exist_stop-list-line.key#_one = INTEGER('1':U) then do:
     4738             v-recid = recid(exist_stop-list-line).
     4739             run ref/stop-ll1.p (
     4740                               input 'ИЗМЕНЕНИЕ':U
     4741                             ,input no
     4742                             ,input-output v-recid
     4743                             ,input p-stop-list-code
     4744                             ,input buf_Dis-card.d-card
     4745                             ,input integer('3':U)
     4746                             ) no-error.
     4747             if not error-status:error then do:
     4748               v-ok-old = v-ok-old + 1.
     4749             end.
     4750           end.
     4751           else do:
     4752             run ref/stop-ll1.p (
     4753                               input 'ДОБАВЛЕНИЕ':U
     4754                               ,input no
     4755                               ,input-output v-recid
     4756                               ,input p-stop-list-code
     4757                               ,input buf_Dis-card.d-card
     4758                               ,input v-sel-status-code
     4759                               ) no-error.
     4760             if error-status:error then do:
     4761             end.
     4762             else do:
     4763               v-ok = v-ok + 1.
     4764             end.
     4765           end.
     4766           end.
     4767         end.
     4768       end.
     4769     end.
     4770   end case.
     4771   run openbr in this-procedure ( input yes, input no, input '':U, input rs-cli-type, input frame Dialog-Frame sch-cli-code).
     4772   if v-ii > 0 and v-ok <> v-num then do:
     4773     message
     4774     substitute("Из выбранных Вами &1 карт в стоп-лист удалось добавить &2", v-num, v-ok) skip(0)
     4775     string(if v-ok-old > 0
     4776      then substitute("&1 карт поменяли статус на &2"
     4777                      ,v-ok-old
     4778                     , 'стоп-карта;стоп-клиент':U)
     4779      else '')
     4780     view-as alert-box warning.
     4781   end.
     4782   END PROCEDURE.
     4783   PROCEDURE proc-b-chg :
     4784   DEFINE INPUT PARAMETER p-chg-option AS CHARACTER NO-UNDO.
     4785   define variable v-status-codes as character no-undo .
     4786   define variable v-sel-status-code as integer no-undo .
     4787   define variable v-status-codes-full as character no-undo .
     4788   define variable choice as integer no-undo .
     4789   define variable v-ii as integer no-undo .
     4790   define variable v-ok as integer no-undo .
     4791   define variable v-num as integer no-undo .
     4792   define variable v-recid as recid no-undo .
     4793   DEFINE BUFFER buf_stop-list-line FOR ub.stop-list-line.
     4794   if p-chg-option = "one" then do:
     4795     if X_stop-list-line.key#_one = INTEGER('2':U)
     4796     then do:
     4797       v-status-codes = '3':U .
     4798     end.
     4799     else do:
     4800       v-status-codes = '2':U  .
     4801     end.
     4802   end.
     4803   else do:
     4804     v-status-codes = '2':U + chr(44) + '3':U .
     4805   end.
     4806   do v-ii = 1 to num-entries(v-status-codes):
     4807       v-status-codes-full = v-status-codes-full  +
     4808                           (if v-ii = 1
     4809                           then '':U
     4810                           else '|') + entry (lookup (entry(v-ii, v-status-codes), '1,2,3,4':U) + 1, ',':U + 'стоп-карта,стоп-клиент,стоп-карта;стоп-клиент,удал-карта':U).
     4811   end.
     4812   run gbl/d-askw.w ( input "Статус строки стоп-листа"
     4813               ,input  "Подвердите НОВЫЙ статус"
     4814               ,input "|"
     4815               ,input v-status-codes-full + "|" + "Отмена"
     4816               ,input fill("|", num-entries(v-status-codes) )
     4817               ,input 1
     4818               ,input num-entries(v-status-codes) + 1
     4819               ,output choice).
     4820   if choice = num-entries(v-status-codes) + 1 then do:
     4821     undo, return error .
     4822   end.
     4823   v-sel-status-code = integer(entry(choice, v-status-codes)).
     4824   case p-chg-option:
     4825     when "one" then do:
     4826       if not (X_stop-list-line.key#_one = INTEGER('2':U)
     4827       or   X_stop-list-line.key#_one = INTEGER('3':U))
     4828       then do:
     4829         message
     4830         substitute("Изменить статус строки стоп-листа можно только&1для строк со статусом <&2> или <&3> и&1только на статус <&3> или <&2> соответственно"
     4831                    ,chr(10)
     4832                    ,'стоп-клиент':U
     4833                    ,'стоп-карта;стоп-клиент':U
     4834                    )
     4835         view-as alert-box error .
     4836         undo, return error .
     4837       end.
     4838       v-recid = recid(X_stop-list-line).
     4839       run ref/stop-ll1.p (
     4840                         input 'ИЗМЕНЕНИЕ':U
     4841                       ,input no
     4842                       ,input-output v-recid
     4843                       ,input p-stop-list-code
     4844                       ,input X_stop-list-line.charkey_one
     4845                       ,input v-sel-status-code
     4846                       ) no-error.
     4847       if error-status:error then do:
     4848       end.
     4849       else do:
     4850         v-ok = v-ok + 1.
     4851       end.
     4852     end.
     4853     when "selected" then do:
     4854       v-num = num-entries(v-rid-list).
     4855       _v-ii:
     4856       do v-ii = 1 to v-num:
     4857         v-recid = integer(entry(v-ii, v-rid-list)).
     4858         find first buf_stop-list-line no-lock where
     4859                   recid(buf_stop-list-line) = v-recid.
     4860         if not (buf_stop-list-line.key#_one = integer('2':U)
     4861                 or
     4862                 buf_stop-list-line.key#_one = integer('3':U)
     4863                 )
     4864         then do:
     4865           message
     4866           substitute("Изменить статус строки стоп-листа можно только&1для строк со статусом <&2> и только на статус <&3>"
     4867                     ,chr(10)
     4868                     ,(if v-sel-status-code = integer('2':U)
     4869                       then 'стоп-карта;стоп-клиент':U
     4870                       else 'стоп-клиент':U)
     4871                     ,entry (lookup (string(v-sel-status-code), '1,2,3,4':U) + 1, ',':U + 'стоп-карта,стоп-клиент,стоп-карта;стоп-клиент,удал-карта':U)
     4872                     )
     4873           view-as alert-box error .
     4874           next _v-ii.
     4875         end.
     4876         run ref/stop-ll1.p (
     4877                           input 'ИЗМЕНЕНИЕ':U
     4878                         ,input no
     4879                         ,input-output v-recid
     4880                         ,input p-stop-list-code
     4881                         ,input buf_stop-list-line.charkey_one
     4882                         ,input v-sel-status-code
     4883                         ) no-error.
     4884         if error-status:error then do:
     4885         end.
     4886         else do:
     4887           v-ok = v-ok + 1.
     4888         end.
     4889       end.
     4890     end.
     4891   end case.
     4892   run openbr in this-procedure ( input yes, input no, input '':U, input rs-cli-type, input frame Dialog-Frame sch-cli-code).
     4893   if p-chg-option <> "one" and v-ok <> v-num then do:
     4894     message
     4895     substitute("Из выбранных Вами &1 карт удалось изменить &2", v-num, v-ok)
     4896     view-as alert-box warning.
     4897   end.
     4898   END PROCEDURE.
     4899   PROCEDURE proc-b-del :
     4900   DEFINE INPUT PARAMETER p-del-option AS CHARACTER NO-UNDO.
     4901   define variable glog as logical no-undo .
     4902   define variable v-ii as integer no-undo .
     4903   define variable v-ok as integer no-undo .
     4904   define variable v-num as integer no-undo .
     4905   define variable v-num2 as integer no-undo .
     4906   define variable v-recid as recid no-undo .
     4907   define variable v-key-rec as character no-undo .
     4908   define variable v-stop-list-code as character no-undo .
     4909   define variable v-index as integer no-undo .
     4910   define buffer buf_stop-list-line for ub.stop-list-line.
     4911   define buffer buf_dis-card for ub.dis-card.
     4912   case p-del-option:
     4913     when "one" then do:
     4914       if X_stop-list-line.key#_one = INTEGER('2':U)
     4915       or X_stop-list-line.key#_one = INTEGER('3':U) then do:
     4916         message
     4917         substitute("Карты со статусом &2 и &3 не могут быть удалены из стоплиста по отдельности&1" +
     4918                   "для удаления таких карт из стоплиста выбирайте опцию ВСЕ ПО КЛИЕНТУ"
     4919                   ,chr(10)
     4920                   ,'стоп-клиент':U
     4921                   ,'стоп-карта;стоп-клиент':U
     4922                   )
     4923         view-as alert-box ERROR.
     4924         undo, return error .
     4925       end.
     4926       else do:
     4927         message
     4928         "Вы действительно хотите удалить из стоплиста эту карту?"
     4929         view-as alert-box question button yes-no update glog.
     4930         if not glog then undo, return error .
     4931                        v-recid = recid(X_stop-list-line).
     4932         run ref/stop-ll3.p (
     4933                         input no
     4934                         ,input v-recid
     4935                         ) no-error.
     4936         if error-status:error then do:
     4937         end.
     4938         else do:
     4939           assign
     4940           v-index = lookup(v-rid-list, string(v-recid)).
     4941           if v-index > 0 then do:
     4942             entry(v-index, v-rid-list) = ''.
     4943             v-rid-list = trim(replace(v-rid-list, chr(44) + chr(44), chr(44)), chr(44)).
     4944           end.
     4945         end.
     4946       end.
     4947     end.
     4948     when "client" then do:
     4949      v-stop-list-code = X_stop-list-line.stop-list-code.
     4950       message
     4951       "Вы действительно хотите удалить из стоплиста ВСЕ карты этого клиента?"
     4952       view-as alert-box question button yes-no update glog.
     4953       for each buf_Dis-card no-lock where
     4954               buf_Dis-card.cli-type = X_clients.obj-type
     4955           and buf_Dis-card.cli-code = X_clients.obj-code:
     4956         run gen-key-rec in this-procedure ( input 'clients':U
     4957                                            ,input buffer X_clients:handle
     4958                                            ,output v-key-rec).
     4959        run waitfram-show in this-procedure ( input "Ждите..." ).
     4960         for each buf_stop-list-line no-lock where
     4961                buf_stop-list-line.stop-list-code = v-stop-list-code
     4962            AND buf_stop-list-line.classif-type = 'dis-card':U
     4963            and buf_stop-list-line.resource_id = v-key-rec
     4964         on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     4965         on stop   undo , return error substitute( "&1. stop", vss-workfile )
     4966         on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     4967         :
     4968           v-recid = recid(buf_stop-list-line).
     4969           v-num = v-num + 1.
     4970           run ref/stop-ll3.p (
     4971                           input no
     4972                           ,input v-recid
     4973                           ) no-error.
     4974           if not error-status:error then do:
     4975             v-ok = v-ok + 1.
     4976             assign
     4977             v-index = lookup(v-rid-list, string(v-recid)).
     4978             if v-index > 0 then do:
     4979               entry(v-index, v-rid-list) = ''.
     4980               v-rid-list = trim(replace(v-rid-list, chr(44) + chr(44), chr(44)), chr(44)).
     4981             end.
     4982           end.
     4983         end.
     4984         run waitfram-hide in this-procedure .
     4985       end.
     4986     end.
     4987     when "selected" then do:
     4988       if v-rid-list = '':U then do:
     4989         message
     4990         "Ничего не отмечено"
     4991          view-as alert-box error.
     4992          undo, return error .
     4993       end.
     4994       message
     4995       substitute("Вы действительно хотите удалить из стоплиста отмеченные карты&1"  +
     4996                  "(карты в статусе &2 и &3 удалены не будут&1" +
     4997                  "для их удаления выбирайте опцию ВСЕ ПО КЛИЕНТУ)"
     4998                  ,chr(10)
     4999                  ,'стоп-клиент':U
     5000                  ,'стоп-карта;стоп-клиент':U
     5001                  )
     5002       view-as alert-box question button yes-no update glog.
     5003       if not glog then undo, return error .
     5004       v-num = num-entries(v-rid-list).
     5005       v-num2 = num-entries(v-rid-list).
     5006       do v-ii = 1 to v-num2:
     5007         v-recid = integer(entry(v-ii, v-rid-list)).
     5008         find first buf_stop-list-line no-lock where
     5009                   recid(buf_stop-list-line) = v-recid.
     5010         run ref/stop-ll3.p (
     5011                          input no
     5012                         ,input v-recid
     5013                         ) no-error.
     5014         if error-status:error then do:
     5015         end.
     5016         else do:
     5017           v-ok = v-ok + 1.
     5018           entry(v-ii, v-rid-list) = '':U.
     5019           v-rid-list = trim(replace(v-rid-list, chr(44) + chr(44), chr(44)), chr(44)).
     5020           v-num2 = v-num2 - 1.
     5021           v-ii = v-ii - 1.
     5022         end.
     5023       end.
     5024     end.
     5025   end case.
     5026   run openbr in this-procedure ( input yes, input no, input '':U, input rs-cli-type, input frame Dialog-Frame sch-cli-code).
     5027   if p-del-option <> "one" and v-ok <> v-num then do:
     5028     message
     5029     substitute("Из выбранных Вами &1 карт удалось удалить &2", v-num, v-ok)
     5030     view-as alert-box warning.
     5031   end.
     5032   END PROCEDURE.
     5033   PROCEDURE proc-b-print :
     5034   define variable v-cli-type-code as character no-undo .
     5035   define variable line as character no-undo .
     5036   define variable startrecid as recid no-undo .
     5037   define variable v-stat-flag as character no-undo .
     5038   DEFINE VARIABLE v-for-sl-doc-date AS date NO-UNDO.
     5039   DEFINE VARIABLE v-for-sl-status AS CHARACTER NO-UNDO.
     5040   DEFINE FRAME List
     5041   X_stop-list-line.stop-list-code COLUMN-LABEL "№ стоплиста" FORMAT "X(9)"
     5042   X_stop-list-line.charkey_one COLUMN-LABEL "№ ДК" FORMAT "X(19)"
     5043   v-cli-type-code COLUMN-LABEL "Держатель" FORMAT "X(12)"
     5044   X_clients.obj-name COLUMN-LABEL "Наимен.Держателя карты" FORMAT "X(105)"
     5045   v-stat-flag COLUMN-LABEL "Флаг" FORMAT "X(20)"
     5046   HEADER
     5047   cur-time-print() AT 5 format "X(35)"
     5048   string( "Страница " + string( PAGE-NUMBER( PrnLibStream ) , ">>>>9") ) AT 56 format "X(15)" SKIP
     5049   Line format "X(198)" AT 1
     5050   with width  232 down use-text stream-io no-box .
     5051   DEFINE FRAME List2
     5052   X_stop-list-line.stop-list-code COLUMN-LABEL "№ стоплиста" FORMAT "X(9)"
     5053   v-for-sl-doc-date COLUMN-LABEL "Дата" FORMAT "99/99/9999"
     5054   v-for-sl-status COLUMN-LABEL "Статус" FORMAT "X(8)"
     5055   v-stat-flag COLUMN-LABEL "Флаг" FORMAT "X(22)"
     5056   HEADER
     5057   cur-time-print() AT 5 format "X(35)"
     5058   string( "Страница " + string( PAGE-NUMBER( PrnLibStream ) , ">>>>9") ) AT 56 format "X(15)" SKIP
     5059   Line format "X(198)" AT 1
     5060   with width  232 down use-text stream-io no-box .
     5061   StartRecid = recid( X_stop-list-line ) .
     5062   DO WHILE available X_stop-list-line :
     5063     GET prev br-stop-list-line NO-LOCK .
     5064   END.
     5065   GET next br-stop-list-line NO-LOCK .
     5066   run prn-lib-open-stream  in this-procedure (
     5067                                                input parParentProc
     5068                                               ,input 43
     5069                                               ,input yes
     5070                                               ,input no
     5071                                               ).
     5072   FORM HEADER
     5073   Line format "X(225)" SKIP
     5074   "Продолжение - на следующей странице" AT 30 SKIP
     5075   with FRAME CliBottomFrame width 232 PAGE-BOTTOM NO-LABELS no-box.
     5076   VIEW stream PrnLibStream FRAME CliBottomFrame .
     5077   PUT stream PrnLibStream space(20)
     5078   frame Dialog-Frame:title format "X(100)" SKIP(2) .
     5079   IF p-d-card = '':U  THEN DO:
     5080     FORM with frame List .
     5081     DO WHILE available X_stop-list-line :
     5082       display stream PrnLibstream
     5083       X_stop-list-line.stop-list-code
     5084       X_stop-list-line.charkey_one
     5085       (X_dis-card.cli-type + string(X_dis-card.cli-code)) @ v-cli-type-code
     5086       X_clients.obj-name
     5087       entry (lookup (STRING( X_stop-list-line.key#_one), '1,2,3,4':U) + 1, ',':U + 'стоп-карта,стоп-клиент,стоп-карта;стоп-клиент,удал-карта':U) @ v-stat-flag
     5088       with frame List .
     5089       DOWN stream PrnLibStream
     5090       1 with frame List.
     5091         GET next br-stop-list-line.
     5092       END.
     5093     END.
     5094     ELSE DO:
     5095       FORM with frame List2 .
     5096       DO WHILE available X_stop-list-line :
     5097       display stream PrnLibstream
     5098       X_stop-list-line.stop-list-code
     5099       get-sl-doc-date(X_stop-list-line.stop-list-code) @ v-for-sl-doc-date
     5100       get-sl-status(X_stop-list-line.stop-list-code) @ v-for-sl-status
     5101       entry (lookup (STRING( X_stop-list-line.key#_one), '1,2,3,4':U) + 1, ',':U + 'стоп-карта,стоп-клиент,стоп-карта;стоп-клиент,удал-карта':U) @ v-stat-flag
     5102       with frame List2 .
     5103       DOWN stream PrnLibStream
     5104       1 with frame List2.
     5105         GET next br-stop-list-line.
     5106       END.
     5107     END.
     5108   PUT stream PrnLibStream Line format "X(136)" SKIP.
     5109   HIDE stream PrnLibStream FRAME CliBottomFrame .
     5110   output stream PrnLibStream close .
     5111   run prn-lib-prn-file in this-procedure (
     5112                                              input parparentproc
     5113                                             ,input 8
     5114                                             ).
     5115   reposition br-stop-list-line to recid StartRecid .
     5116   END PROCEDURE.
     5117   PROCEDURE proc-b-sch :
     5118   define variable v-ri as recid no-undo.
     5119   assign
     5120   v-ri = (if avail X_stop-list-line then recid(X_stop-list-line) else ?)
     5121   .
     5122   assign
     5123   tbl = 'stop-list-line'
     5124   join-tbl = 'X_stop-list-line'
     5125   fld = ""
     5126   lab = ""
     5127   spr = ""
     5128   dim = '0'
     5129   .
     5130   run fltfield-add in this-procedure('key#_one', 'Флаг стоплиста', '',
     5131   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5132   run fltfield-add in this-procedure('charkey_one', 'ДК', '',
     5133   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5134   DO on stop undo, leave:
     5135       run gbl/filter.w ( INPUT parparentproc
     5136                    ,INPUT (filter-point + chr(4) + filter-label)
     5137                    ,INPUT tbl
     5138                    ,INPUT join-tbl
     5139                    ,INPUT fld
     5140                    ,INput lab
     5141                    ,INPUT spr
     5142                    ,INPUT  dim).
     5143       RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U, input rs-cli-type, input frame Dialog-Frame sch-cli-code).
     5144       if v-ri <> ? then do:
     5145         reposition br-stop-list-line to recid v-ri no-error.
     5146       end.
     5147       APPLY "ENTRY" to br-stop-list-line in frame Dialog-Frame .
     5148   END .
     5149   END PROCEDURE.
     5150   PROCEDURE proc-find-d-card :
     5151   define input parameter p-next as logical no-undo.
     5152   define input parameter p-d-card as character no-undo.
     5153   display
     5154   0 @ sch-cli-code
     5155   with frame Dialog-Frame.
     5156   assign
     5157   p-d-card = replace(p-d-card, chr(39), chr(39) + chr(39))
     5158   p-d-card = chr(34) + p-d-card + chr(34).
     5159   run OpenBr in this-procedure
     5160       (input false
     5161       ,input p-next
     5162       ,input substitute("and X_stop-list-line.charkey_one begins &1 "
     5163         , p-d-card)
     5164       ,INPUT '':U
     5165       ,INPUT 0
     5166       ).
     5167   apply "entry":u to sch-d-card in frame Dialog-Frame .
     5168   END PROCEDURE.
     5169   FUNCTION get-sl-doc-date RETURNS DATE
     5170     ( INPUT p-stop-list-code AS CHARACTER ) :
     5171   DEFINE BUFFER buf_stop-list FOR ub.stop-list.
     5172   FIND FIRST buf_stop-list NO-LOCK WHERE
     5173               buf_stop-list.stop-list-code = p-stop-list-code
     5174          AND buf_stop-list.classif-type = 'dis-card':U
     5175           NO-ERROR.
     5176   IF AVAILABLE buf_stop-list THEN  RETURN buf_stop-list.doc-date.
     5177     RETURN ?.
     5178   END FUNCTION.
     5179   FUNCTION get-sl-status RETURNS CHARACTER
     5180     ( INPUT p-stop-list-code AS CHARACTER ) :
     5181   DEFINE BUFFER buf_stop-list FOR ub.stop-list.
     5182   FIND FIRST buf_stop-list NO-LOCK WHERE
     5183               buf_stop-list.stop-list-code = p-stop-list-code
     5184          AND buf_stop-list.classif-type = 'dis-card':U
     5185           NO-ERROR.
     5186   IF AVAILABLE buf_stop-list THEN  RETURN buf_stop-list.status_.
     5187     RETURN chr(63).
     5188   END FUNCTION.
