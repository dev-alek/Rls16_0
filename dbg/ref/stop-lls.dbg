     1592   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1593   procedure fltopend_fltopend :
     1594   define input parameter p-parent-handle as handle no-undo .
     1595   define input parameter p-qh as handle no-undo .
     1596   define input parameter p-flt-open-open-query  as character no-undo .
     1597   define input parameter p-where-cond as character no-undo .
     1598   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1599   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1600   define input parameter p-indexed-reposition as character no-undo .
     1601     do
     1602     on error undo, return error
     1603     :
     1604   define variable v-prepare-string as character no-undo .
     1605   define variable glog as logical no-undo .
     1606   assign
     1607   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1608                      p-where-cond + chr(32)  +
     1609                      p-use-indFIRST-query-tail + chr(32) +
     1610                      p-use-ind-sort-clmn-by + chr(32) +
     1611                      p-indexed-reposition
     1612   .
     1613   assign
     1614   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1615   if not glog
     1616   or error-status:error then do:
     1617     message error-status:get-message(1) view-as alert-box .
     1618     undo, return error .
     1619   end.
     1620   assign
     1621   glog = p-qh:query-open no-error .
     1622   if not glog
     1623   or error-status:error then do:
     1624     message error-status:get-message(1) view-as alert-box .
     1625     undo, return error .
     1626   end.
     1627     end.
     1628   end procedure.
     1629   procedure fltopend_fltfindd :
     1630   define input parameter p-parent-handle as handle no-undo .
     1631   define input parameter p-qh as handle no-undo .
     1632   define input parameter p-rowid as rowid no-undo .
     1633   define input parameter p-next as logical no-undo .
     1634   define input parameter p-lock as integer no-undo .
     1635   define input parameter p-bh as handle no-undo .
     1636   define input parameter p-where-cond as character no-undo .
     1637   define input parameter p-use-index-phrase as character no-undo .
     1638   define variable glog as logical no-undo .
     1639   define variable v-qh as handle no-undo .
     1640   define variable v-bh as handle no-undo .
     1641   define variable v-recid as recid no-undo .
     1642   define variable v-prepare-string as character no-undo .
     1643   do
     1644   on error undo, return error
     1645   on stop undo, return error
     1646   :
     1647     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1648     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1649     create query v-qh.
     1650     v-qh:set-buffers(v-bh).
     1651     v-prepare-string = substitute("for each &1 &2 &3"
     1652                                     ,v-bh:name
     1653                                     ,p-where-cond
     1654                                     ,p-use-index-phrase).
     1655     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1656     if not glog then do:
     1657       delete object v-qh.
     1658       delete object v-bh.
     1659       undo, return error .
     1660     end.
     1661     glog = v-qh:query-open no-error .
     1662     if not glog then do:
     1663       delete object v-qh.
     1664       delete object v-bh.
     1665       undo, return error .
     1666     end.
     1667     if p-next then do:
     1668       v-qh:reposition-to-rowid(p-rowid) no-error .
     1669       glog = v-qh:get-next( p-lock) no-error .
     1670       glog = v-qh:get-next( p-lock) no-error .
     1671       if not glog or v-qh:query-off-end = yes then do:
     1672         glog = v-qh:get-first( p-lock) no-error .
     1673       end.
     1674     end.
     1675     else do:
     1676       glog = v-qh:get-first( p-lock) no-error .
     1677     end.
     1678     v-recid = v-bh:recid no-error .
     1679     delete object v-qh.
     1680     delete object v-bh.
     1681     return string(v-recid) .
     1682   end.
     1683   end procedure.
     1684   procedure fltopend_fltfindq :
     1685   define input parameter p-parent-handle as handle no-undo .
     1686   define input parameter p-qh as handle no-undo .
     1687   define input parameter p-next as logical no-undo .
     1688   define input parameter p-lock as integer no-undo .
     1689   define input parameter p-flt-open-open-query  as character no-undo .
     1690   define input parameter p-where-cond as character no-undo .
     1691   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1692   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1693   define input parameter p-indexed-reposition as character no-undo .
     1694   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1695   define variable glog as logical no-undo .
     1696   define variable v-qh as handle no-undo .
     1697   define variable v-bh as handle no-undo extent 18.
     1698   define variable v-rowid as rowid no-undo extent 18.
     1699   define variable v-ii as integer no-undo .
     1700   define variable v-prepare-string as character no-undo .
     1701   do
     1702   on error undo, return error
     1703   on stop undo, return error
     1704   :
     1705     create query v-qh.
     1706     do v-ii = 1 to p-qh:num-buffers:
     1707       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1708       assign
     1709       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1710       no-error.
     1711       v-qh:add-buffer(v-bh[v-ii]).
     1712     end.
     1713     assign
     1714     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1715                       p-where-cond + chr(32)  +
     1716                       p-use-indFIRST-query-tail + chr(32) +
     1717                       p-use-ind-sort-clmn-by + chr(32) +
     1718                       p-indexed-reposition
     1719     .
     1720     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1721     if not glog then do:
     1722       delete object v-qh.
     1723       do v-ii = 1 to p-qh:num-buffers:
     1724         delete object v-bh[v-ii].
     1725       end.
     1726       undo, return error .
     1727     end.
     1728     glog = v-qh:query-open no-error .
     1729     if not glog then do:
     1730       delete object v-qh.
     1731       do v-ii = 1 to p-qh:num-buffers:
     1732         delete object v-bh[v-ii].
     1733       end.
     1734       undo, return error .
     1735     end.
     1736     if p-next then do:
     1737       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1738       glog = v-qh:get-next( p-lock) no-error .
     1739       glog = v-qh:get-next( p-lock) no-error .
     1740       if not glog or v-qh:query-off-end = yes then do:
     1741         glog = v-qh:get-first( p-lock) no-error .
     1742       end.
     1743     end.
     1744     else do:
     1745       glog = v-qh:get-first( p-lock) no-error .
     1746     end.
     1747     do v-ii = 1 to p-qh:num-buffers:
     1748       assign
     1749       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1750       no-error.
     1751     end.
     1752     delete object v-qh.
     1753     do v-ii = 1 to p-qh:num-buffers:
     1754       delete object v-bh[v-ii].
     1755     end.
     1756   end.
     1757   end procedure.
     1758   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1759   define variable filter-label as character no-undo .
     1760   define variable filter-label0 as character no-undo init "Стоплист" .
     1761   define variable filter-point as character no-undo .
     1762   define variable filter-point0 as character no-undo init "stop-lls" .
     1763   DEFINE VARIABLE sort-column-name as character no-undo .
     1764   define variable v-doc-rec as recid no-undo .
     1765   define buffer buf_stop-list for ub.stop-list.
     1766   DEFINE BUFFER buf_dis-card FOR ub.dis-card.
     1767   define buffer buf_clients for ub.clients.
     1768   DEFINE VARIABLE v-doc-date AS DATE NO-UNDO.
     1769   DEFINE VARIABLE v-sl-status AS CHARACTER NO-UNDO.
     1770   DEFINE VARIABLE v-card-resource-id AS CHARACTER NO-UNDO.
     1771   DEFINE VARIABLE v-client-resource-id AS CHARACTER NO-UNDO.
     1772   DEFINE variable add-option AS CHARACTER NO-UNDO.
     1773   DEFINE variable chg-option AS CHARACTER NO-UNDO.
     1774   DEFINE variable del-option AS CHARACTER NO-UNDO.
     1775   FUNCTION get-sl-doc-date RETURNS DATE
     1776     ( INPUT p-stop-list-code AS CHARACTER )  FORWARD.
     1777   FUNCTION get-sl-status RETURNS CHARACTER
     1778     ( INPUT p-stop-list-code AS CHARACTER )  FORWARD.
     1779   DEFINE MENU MENU-b-add
     1780          MENU-ITEM m_list-add     LABEL "Стоп-карта по списку"
     1781          MENU-ITEM m_one-add      LABEL "Стоп-карта по одной"
     1782          MENU-ITEM m_list-add-client LABEL "Стоп-клиент по списку"
     1783          MENU-ITEM m_one-add-client LABEL "Стоп-клиент по одному".
     1784   DEFINE MENU MENU-b-chg
     1785          MENU-ITEM m_selected-chg LABEL "Отмеченные"
     1786          MENU-ITEM m_one-chg      LABEL "Один"          .
     1787   DEFINE MENU MENU-b-del
     1788          MENU-ITEM m_selected-del LABEL "Отмеченные"
     1789          MENU-ITEM m_one-del      LABEL "Одна карта"
     1790          MENU-ITEM m_client-del   LABEL "ВСЕ карты клиента".
     1791   DEFINE BUTTON b-add
     1792        LABEL "&Добавить"
     1793        SIZE 10 BY 1.
     1794   DEFINE BUTTON b-chg
     1795        LABEL "&Изменить"
     1796        SIZE 10 BY 1.
     1797   DEFINE BUTTON b-cli
     1798        LABEL "Клиент"
     1799        SIZE 10 BY 1.
     1800   DEFINE BUTTON B-cli-2
     1801        IMAGE-UP FILE "btn-down-arrow":U
     1802        IMAGE-DOWN FILE "btn-down-arrow":U
     1803        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1804        LABEL "Btn 1"
     1805        SIZE 3 BY 1.
     1806   DEFINE BUTTON b-del
     1807        LABEL "&Удалить"
     1808        SIZE 10 BY 1.
     1809   DEFINE BUTTON B-Help
     1810        LABEL "Помо&щь"
     1811        SIZE 3 BY 1
     1812        BGCOLOR 8 .
     1813   DEFINE BUTTON b-lkp
     1814        LABEL "ДК"
     1815        SIZE 10 BY 1.
     1816   DEFINE BUTTON B-mark
     1817        LABEL "&*"
     1818        SIZE 3 BY 1.
     1819   DEFINE BUTTON b-print
     1820        LABEL "Пе&чать"
     1821        SIZE 3 BY 1.
     1822   DEFINE BUTTON b-quit AUTO-GO
     1823        LABEL "&Выход"
     1824        SIZE 10 BY 1
     1825        BGCOLOR 8 .
     1826   DEFINE BUTTON b-sch
     1827        LABEL "&Фильтр"
     1828        SIZE 3 BY 1.
     1829   DEFINE BUTTON B-sel AUTO-GO
     1830        LABEL "Вы&бор"
     1831        SIZE 10 BY 1.
     1832   DEFINE VARIABLE fi-search AS CHARACTER FORMAT "X(256)":U INITIAL "Поиск по"
     1833         VIEW-AS TEXT
     1834        SIZE 10 BY .67
     1835        FGCOLOR 4  NO-UNDO.
     1836   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1837         VIEW-AS TEXT
     1838        SIZE 6 BY 1
     1839        FGCOLOR 4  NO-UNDO.
     1840   DEFINE VARIABLE sch-cli-code AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
     1841        LABEL "Код клиента"
     1842        VIEW-AS FILL-IN
     1843        SIZE 10 BY 1 NO-UNDO.
     1844   DEFINE VARIABLE sch-d-card AS CHARACTER FORMAT "X(19)":U
     1845        LABEL "№ ДК"
     1846        VIEW-AS FILL-IN
     1847        SIZE 20 BY 1 NO-UNDO.
     1848   DEFINE VARIABLE RS-cli-type AS CHARACTER
     1849        VIEW-AS RADIO-SET HORIZONTAL
     1850        RADIO-BUTTONS
     1851             "Item 1", "1",
     1852   "Item 1", "2"
     1853        SIZE 14.13 BY 1 NO-UNDO.
     1854   DEFINE QUERY br-stop-list-line FOR
     1855                   X_stop-list-line,
     1856                   X_DIS-CARD,
     1857                   X_clients SCROLLING.
     1858   DEFINE BROWSE br-stop-list-line
     1859     QUERY br-stop-list-line NO-LOCK DISPLAY
     1860         mark-string(recid(X_stop-list-line), v-rid-list) COLUMN-LABEL "*" FORMAT "X(2)"
     1861   X_stop-list-line.line-num COLUMN-LABEL "№№" FORMAT ">>>>>>>>9"
     1862   X_stop-list-line.charkey_one COLUMN-LABEL "№ ДК" FORMAT "X(19)"
     1863   (X_clients.obj-type + string(X_clients.obj-code)) COLUMN-LABEL "Клиент" FORMAT "X(12)"
     1864   X_clients.obj-name COLUMN-LABEL "Наимен.Держателя карты" FORMAT "X(105)" WIDTH 40
     1865   entry (lookup (string(X_stop-list-line.key#_one), '1,2,3,4':U) + 1, ',':U + 'стоп-карта,стоп-клиент,стоп-карта;стоп-клиент,удал-карта':U) COLUMN-LABEL "Флаг" FORMAT "X(20)"
     1866   calldscr(X_stop-list-line.resource_id) COLUMN-LABEL "Заблокированный!ресурс" FORMAT "X(19)"
     1867   X_stop-list-line.stop-list-code COLUMN-LABEL "№ стоплиста" FORMAT "X(9)"
     1868   get-sl-doc-date(X_stop-list-line.stop-list-code) @ v-doc-date COLUMN-LABEL "Дата" FORMAT "99/99/9999"
     1869   get-sl-status(X_stop-list-line.stop-list-code) @ v-sl-status COLUMN-LABEL "Статус" FORMAT "X(8)"
     1870       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.88 BY 18 FIT-LAST-COLUMN.
     1871   DEFINE FRAME Dialog-Frame
     1872        b-quit AT ROW 1 COL 1
     1873        B-mark AT ROW 1 COL 11
     1874        B-sel AT ROW 1 COL 21
     1875        b-add AT ROW 1 COL 31 WIDGET-ID 2
     1876        b-chg AT ROW 1 COL 41 WIDGET-ID 4
     1877        b-del AT ROW 1 COL 51 WIDGET-ID 6
     1878        b-lkp AT ROW 1 COL 71
     1879        b-cli AT ROW 1 COL 81
     1880        b-print AT ROW 1 COL 89
     1881        b-sch AT ROW 1 COL 92
     1882        B-Help AT ROW 1 COL 95
     1883        sch-d-card AT ROW 2.08 COL 16 COLON-ALIGNED
     1884        sch-cli-code AT ROW 3 COL 48.5 COLON-ALIGNED
     1885        RS-cli-type AT ROW 3.08 COL 18 NO-LABEL
     1886        B-cli-2 AT ROW 3.08 COL 33
     1887        br-stop-list-line AT ROW 4 COL 1
     1888        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1889        fi-search AT ROW 2.33 COL 1.5 NO-LABEL WIDGET-ID 8
     1890        SPACE(88.40) SKIP(19.47)
     1891       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1892            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1893            TITLE "Стоплист"
     1894            CANCEL-BUTTON b-quit.
     1895   ASSIGN
     1896          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1897          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1898   ASSIGN
     1899          b-add:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-add:HANDLE.
     1900   ASSIGN
     1901          b-chg:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-chg:HANDLE.
     1902   ASSIGN
     1903          b-del:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-del:HANDLE.
     1904   ON GO OF FRAME Dialog-Frame
     1905   DO:
     1906     p-rid-list = v-rid-list.
     1907   END.
     1908   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1909   DO:
     1910     APPLY "END-ERROR":U TO SELF.
     1911   END.
     1912   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     1913   DO:
     1914        IF add-option = '':U THEN DO:
     1915        run gbl/pop-up.p ( input self:handle, input no) no-error.
     1916       if error-status:error or add-option = "":U then return no-apply.
     1917     END.
     1918     RUN proc-b-add IN THIS-PROCEDURE ( add-option) NO-ERROR.
     1919     IF ERROR-STATUS:ERROR THEN do:
     1920         add-option = "":U.
     1921         RETURN NO-APPLY.
     1922     END.
     1923     add-option = "":U.
     1924   END.
     1925   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     1926   DO:
     1927     IF chg-option = '':U THEN DO:
     1928        run gbl/pop-up.p ( input self:handle, input no) no-error.
     1929       if error-status:error or chg-option = "":U then return no-apply.
     1930     END.
     1931     RUN proc-b-chg IN THIS-PROCEDURE ( chg-option) NO-ERROR.
     1932     IF ERROR-STATUS:ERROR THEN do:
     1933         chg-option = "":U.
     1934         RETURN NO-APPLY.
     1935     END.
     1936     chg-option = "":U.
     1937   END.
     1938   ON CHOOSE OF b-cli IN FRAME Dialog-Frame
     1939   DO:
     1940     IF NOT AVAILABLE X_stop-list-line THEN RETURN NO-APPLY.
     1941     run ref/showcli.p ( INPUT parparentproc
     1942                    ,INPUT X_dis-card.cli-type
     1943                    ,INPUT X_dis-card.cli-code) NO-ERROR.
     1944   END.
     1945   ON CHOOSE OF B-cli-2 IN FRAME Dialog-Frame
     1946   DO:
     1947   define variable ref-list as character no-undo.
     1948   define variable ref-rec as recid no-undo.
     1949   define buffer buf_clients for ub.clients.
     1950     run ref/cli-all.w ( input parParentProc
     1951                     ,input "b-sel"
     1952                     ,input RS-cli-type
     1953                     ,input ?
     1954                     ,input ?
     1955                     ,input ?
     1956                     ,input ?
     1957                     ,input "":U
     1958                     ,output ref-list) .
     1959       if ref-list = "" then   do:
     1960         apply "entry" to b-cli in frame Dialog-Frame.
     1961         return no-apply.
     1962        end.
     1963       ref-rec = integer( ref-list ).
     1964       FIND FIRST buf_clients WHERE recid (buf_clients) = ref-rec NO-LOCK .
     1965       if NOT (buf_clients.obj-type = 'орг':U
     1966               or
     1967               buf_clients.obj-type = 'чел':U ) then do:
     1968         message
     1969         "Выберите контрагента типа" 'орг':U "или" 'чел':U
     1970         view-as alert-box error .
     1971         return no-apply.
     1972       end.
     1973       assign
     1974       RS-cli-type =  buf_clients.obj-type
     1975       sch-cli-code = buf_clients.obj-code
     1976       .
     1977       display
     1978       RS-cli-type
     1979       sch-cli-code
     1980       with frame Dialog-Frame.
     1981     apply "return" to sch-cli-code.
     1982   END.
     1983   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1984   DO:
     1985     IF del-option = '':U THEN DO:
     1986       run gbl/pop-up.p ( input self:handle, input no) no-error.
     1987       if error-status:error or del-option = "":U then return no-apply.
     1988     END.
     1989     RUN proc-b-del IN THIS-PROCEDURE ( del-option) NO-ERROR.
     1990     IF ERROR-STATUS:ERROR THEN do:
     1991         del-option = "":U.
     1992         RETURN NO-APPLY.
     1993     END.
     1994     del-option = "":U.
     1995   END.
     1996   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1997   DO:
     1998   DEFINE VARIABLE v-ri AS RECID NO-UNDO.
     1999   DEFINE BUFFER buf_dis-card FOR ub.dis-card.
     2000    IF NOT AVAILABLE X_stop-list-line THEN RETURN NO-APPLY.
     2001    FIND FIRST buf_dis-card NO-LOCK WHERE
     2002               buf_dis-card.d-card = X_stop-list-line.charkey_one NO-ERROR.
     2003   IF NOT AVAILABLE buf_dis-card THEN DO:
     2004      MESSAGE
     2005      substitute("Не найдена карта &1", X_stop-list-line.charkey_one)
     2006      VIEW-AS ALERT-BOX ERROR.
     2007      RETURN NO-APPLY.
     2008   END.
     2009   v-ri = recid( buf_dis-card ) .
     2010   run ref/dcardi.w (
     2011                         input parparentproc
     2012                       , input 'ПРОСМОТР':U
     2013                       , input buf_dis-card.emitent-host-code
     2014                       , input v-cntxt-host-code-obj
     2015                       , INPUT v-cntxt-obj-type
     2016                       , input v-cntxt-obj-code
     2017                       , input ?
     2018                       , input-output v-ri ) no-error.
     2019   apply "entry" to br-stop-list-line.
     2020   END.
     2021   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     2022   DO:
     2023     define variable loc#log as logical no-undo .
     2024     if available X_stop-list-line then do:
     2025   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2026   define variable v-str-recid20 as character no-undo .
     2027   define variable v-num-entry20 as integer   no-undo .
     2028   assign
     2029     v-str-recid20 = trim( string( recid( X_stop-list-line ) , "->>>>>>>>>>>9":U ) )
     2030     v-num-entry20 = lookup( v-str-recid20 , v-rid-list )
     2031   .
     2032   if v-num-entry20 > 0 then do:
     2033     assign
     2034       entry( v-num-entry20, v-rid-list ) = "":U
     2035       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     2036     .
     2037   end.
     2038   else do:
     2039     assign
     2040       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid20
     2041     .
     2042   end.
     2043       loc#log = br-stop-list-line:refresh() .
     2044       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     2045           loc#log = br-stop-list-line:select-next-row ().
     2046           apply "VALUE-CHANGED" to br-stop-list-line in frame Dialog-Frame.
     2047       end.
     2048       if num-entries( v-rid-list ) = 0
     2049       then
     2050           hide mark-num in frame Dialog-Frame.
     2051       else
     2052           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     2053     end.
     2054     apply "entry" to br-stop-list-line in frame Dialog-Frame.
     2055   END.
