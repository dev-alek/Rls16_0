     2202   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2203   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2204   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2205   on help of frame Dialog-Frame
     2206   do:
     2207     run gbl/app_help.p
     2208       (input this-procedure :file-name
     2209       ,input ''
     2210       ,input ?
     2211       ) no-error.
     2212     if error-status :error then do:
     2213       message
     2214         "Ошибка при вызове помощи"
     2215         error-status :get-message(1)
     2216         view-as alert-box .
     2217     end.
     2218   end.
     2219   run minbtn-set in this-procedure .
     2220   on choose of b-help in frame Dialog-Frame
     2221   do:
     2222     apply "help":u to frame Dialog-Frame .
     2223   end.
     2224   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2225   procedure minbtn-set :
     2226       do
     2227           on error undo, return error return-value
     2228           :
     2229           define variable ii              as integer       no-undo .
     2230           define variable fh              as widget-handle no-undo .
     2231           define variable hh              as widget-handle no-undo .
     2232           define variable v-h             as handle        extent 4 no-undo .
     2233           define variable v-name-button   as character     no-undo .
     2234           define variable v-help-old-x    as decimal       no-undo .
     2235           define variable v-help-old-y    as decimal       no-undo .
     2236           define variable v-help-old-size as decimal       no-undo .
     2237           define variable v-frame-width   as decimal       no-undo .
     2238           define variable jj              as integer       no-undo .
     2239           do
     2240               on error undo, return error
     2241               :
     2242               assign
     2243                   v-frame-width = frame Dialog-Frame:width - 0.3
     2244                   fh            = frame Dialog-Frame:first-child
     2245                   hh            = fh:first-child
     2246                   ii            = 1
     2247                   .
     2248               do while valid-handle(hh):
     2249                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2250                   do:
     2251                       case lc(hh:name) :
     2252                           when "b-help" then
     2253                               do:
     2254                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2255                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2256                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2257                                   hh:TOOLTIP = "Помощь" .
     2258                                   v-help-old-x = hh:column .
     2259                                   v-help-old-y = hh:row    .
     2260                                   v-help-old-size = hh:width .
     2261                                   hh:width-chars = 2.5 .
     2262                               end.
     2263                           when "b-print" then
     2264                               do:
     2265                                   hh:load-image("cmp/b-print.bmp":u) .
     2266                                   hh:TOOLTIP = "Печать" .
     2267                                   v-h[ii] = hh:handle .
     2268                                   ii = ii + 1 .
     2269                                   hh:width-chars = 3 .
     2270                               end.
     2271                           when "b-history" or
     2272                           when "b-hist" then
     2273                               do:
     2274                                   hh:load-image("cmp/b-hist.bmp":u) .
     2275                                   hh:TOOLTIP = "История" .
     2276                                   v-h[ii] = hh:handle .
     2277                                   ii = ii + 1 .
     2278                                   hh:width-chars = 3 .
     2279                               end.
     2280                           when "b-sch" then
     2281                               do:
     2282                                   hh:load-image("cmp/b-sch.bmp":u) .
     2283                                   hh:TOOLTIP = "Установка Фильтра" .
     2284                                   v-h[ii] = hh:handle .
     2285                                   ii = ii + 1 .
     2286                                   hh:width-chars = 3 .
     2287                               end.
     2288                           when "b-hist-user" then
     2289                               do:
     2290                                   hh:load-image("cmp/b-hist.bmp":u) .
     2291                                   hh:TOOLTIP = "История пользователя" .
     2292                                   ii = ii + 1 .
     2293                               end.
     2294                       end case.
     2295                   end.
     2296                   hh = hh:next-sibling.
     2297               end.
     2298               b-help:column = v-frame-width - b-help:width-chars.
     2299               jj = 0.
     2300               repeat ii = 4 to 1 by -1 :
     2301                   if valid-handle (v-h[ii] ) then
     2302                   do:
     2303                       jj  = jj + 1 .
     2304                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2305                       v-h[ii]:row    = v-help-old-y .
     2306                   end.
     2307               end.
     2308           end.
     2309       end.
     2310   end procedure.
     2311   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2312   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2313   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2314   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2315   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2316   define variable v-diasize-current-frame-height as decimal   no-undo .
     2317   define variable v-diasize-change-size          as logical   no-undo .
     2318   define variable v-diasize-resize-button        as handle    no-undo .
     2319   define variable v-diasize-wndmax               as logical   no-undo .
     2320   define variable v-diasize-wndstore             as logical   no-undo .
     2321   define variable v-diasize-proc-name            as character no-undo .
     2322   define variable v-diasize-browse-handle        as handle    no-undo .
     2323   define variable v-diasize-browse-number        as integer   no-undo .
     2324   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2325   define temp-table temp-diasize-handle no-undo
     2326     field handle-value  as handle
     2327     field save-position as decimal
     2328     index xpk is primary unique handle-value
     2329     .
     2330   define temp-table temp-browse-handle no-undo
     2331     field browse-type   as character
     2332     field browse-number as integer
     2333     field browse-handle as handle
     2334     field original-size as decimal
     2335     index xpk is primary unique browse-type browse-number
     2336     index xie browse-type browse-handle
     2337   .
     2338   procedure diasize_change-height :
     2339     define input  parameter p-change-value  as decimal   no-undo .
     2340     define input  parameter p-move-resize   as logical   no-undo .
     2341     define variable v-field-group-handle    as handle    no-undo .
     2342     define variable v-object-handle         as handle    no-undo .
     2343     define variable v-frame-height          as decimal   no-undo .
     2344     define variable v-frame-virtual-height  as decimal   no-undo .
     2345     define variable v-browse-height         as decimal   no-undo .
     2346     define variable v-window-height         as decimal   no-undo .
     2347     define variable v-window-virtual-height as decimal   no-undo .
     2348     define variable v-change-sign           as integer   no-undo .
     2349     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2350     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2351     if p-change-value > 0
     2352     then do:
     2353       if frame Dialog-Frame :height + p-change-value
     2354           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2355       then do:
     2356         assign
     2357           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2358                           - (frame Dialog-Frame :height-chars)
     2359         .
     2360         if p-change-value <= 0
     2361         then do:
     2362           run diasize_position-resize-button in this-procedure .
     2363           return .
     2364         end.
     2365       end.
     2366     end.
     2367     if p-change-value < 0
     2368     then do:
     2369       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2370       then do:
     2371         assign
     2372           p-change-value = v-diasize-orig-frame-height
     2373                          - (frame Dialog-Frame :height-chars)
     2374         .
     2375         if p-change-value >= 0
     2376         then do:
     2377           run diasize_position-resize-button in this-procedure .
     2378           return .
     2379         end.
     2380       end.
     2381     end.
     2382     if p-change-value >= 0
     2383     then do:
     2384       assign
     2385         v-change-sign = 1
     2386       .
     2387     end.
     2388     else do:
     2389       assign
     2390         v-change-sign = -1
     2391       .
     2392     end.
     2393     assign
     2394       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2395     .
     2396     if p-change-value = 0
     2397     then do:
     2398       run diasize_position-resize-button in this-procedure .
     2399       return .
     2400     end.
     2401     move_block:
     2402     do
     2403     on error undo move_block, retry move_block
     2404     :
     2405       if retry
     2406       then do:
     2407         do
     2408         on error undo move_block, leave move_block
     2409         :
     2410           if p-change-value > 0
     2411           then do:
     2412             for each buf_temp-diasize-handle
     2413             on error undo, next
     2414             :
     2415               assign
     2416                 v-object-handle = buf_temp-diasize-handle.handle-value
     2417               .
     2418               if v-object-handle <> v-diasize-resize-button
     2419               then do:
     2420                 assign
     2421                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2422                 .
     2423               end.
     2424             end.
     2425             assign
     2426               v-diasize-browse-handle :height = v-browse-height
     2427             .
     2428             for each buf_temp-browse-handle
     2429               where buf_temp-browse-handle.browse-type = 'height':u
     2430             on error undo, next
     2431             :
     2432               assign
     2433                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2434               .
     2435             end.
     2436             assign
     2437               frame Dialog-Frame :height = v-frame-height
     2438             .
     2439             if frame Dialog-Frame :scrollable = true
     2440             then do:
     2441               assign
     2442                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2443               .
     2444             end.
     2445             run diasize_position-resize-button in this-procedure .
     2446           end.
     2447           else do:
     2448             if frame Dialog-Frame :scrollable = true
     2449             then do:
     2450               assign
     2451                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2452               .
     2453             end.
     2454             assign
     2455               frame Dialog-Frame :height = v-frame-height
     2456             .
     2457             assign
     2458               v-diasize-browse-handle :height = v-browse-height
     2459             .
     2460             for each buf_temp-browse-handle
     2461               where buf_temp-browse-handle.browse-type = 'height':u
     2462             on error undo, next
     2463             :
     2464               assign
     2465                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2466               .
     2467             end.
     2468             for each buf_temp-diasize-handle
     2469             on error undo, next
     2470             :
     2471               assign
     2472                 v-object-handle = buf_temp-diasize-handle.handle-value
     2473               .
     2474               if v-object-handle <> v-diasize-resize-button
     2475               then do:
     2476                 assign
     2477                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2478                 .
     2479               end.
     2480             end.
     2481             run diasize_position-resize-button in this-procedure .
     2482           end.
     2483           assign
     2484             v-diasize-change-size = false
     2485           .
     2486           leave move_block .
     2487         end.
     2488       end.
     2489       assign
     2490         v-diasize-need-full-display = true
     2491       .
     2492       if v-diasize-change-size = false
     2493       then do:
     2494         assign
     2495           v-diasize-change-size = true
     2496         .
     2497       end.
     2498       else do:
     2499         return .
     2500       end.
     2501       assign
     2502         v-frame-height = frame Dialog-Frame :height
     2503         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2504         v-browse-height = v-diasize-browse-handle :height
     2505       .
     2506       for each buf_temp-browse-handle
     2507         where buf_temp-browse-handle.browse-type = 'height':u
     2508       :
     2509         assign
     2510           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2511         .
     2512       end.
     2513       for each buf_temp-diasize-handle
     2514       :
     2515         delete buf_temp-diasize-handle .
     2516       end.
     2517       assign
     2518         v-field-group-handle = frame Dialog-Frame :first-child
     2519       .
     2520       do while valid-handle(v-field-group-handle)
     2521       :
     2522         assign
     2523           v-object-handle = v-field-group-handle :first-child
     2524         .
     2525         do while valid-handle(v-object-handle)
     2526         :
     2527           if  v-object-handle <> v-diasize-browse-handle :handle
     2528           and can-query(v-object-handle, "row")
     2529           and can-query(v-object-handle, "height")
     2530           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2531           then do:
     2532             find first buf_temp-browse-handle
     2533               where buf_temp-browse-handle.browse-type   = 'height':u
     2534                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2535               no-error .
     2536             if available buf_temp-browse-handle
     2537             then do:
     2538             end.
     2539             else do:
     2540               create buf_temp-diasize-handle .
     2541               assign
     2542                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2543                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2544               .
     2545             end.
     2546           end.
     2547           assign
     2548             v-object-handle = v-object-handle :next-sibling
     2549           .
     2550         end.
     2551         assign
     2552           v-field-group-handle = v-field-group-handle :next-sibling
     2553         .
     2554       end.
     2555       do with frame Dialog-Frame
     2556       :
     2557         hide v-diasize-resize-button .
     2558         assign
     2559           v-diasize-resize-button :row    = 1
     2560           v-diasize-resize-button :column = 1
     2561         .
     2562       end.
     2563       if p-change-value > 0
     2564       then do:
     2565         if frame Dialog-Frame :scrollable = true
     2566         then do:
     2567           assign
     2568             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2569             no-error .
     2570           if error-status :error
     2571           or error-status :get-message(1) <> ""
     2572           then do:
     2573             undo move_block, retry move_block .
     2574           end.
     2575         end.
     2576         assign
     2577           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2578           no-error .
     2579         if error-status :error
     2580         or error-status :get-message(1) <> ""
     2581         then do:
     2582           undo move_block, retry move_block .
     2583         end.
     2584         assign
     2585           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2586           no-error .
     2587         if error-status :error
     2588         or error-status :get-message(1) <> ""
     2589         then do:
     2590           undo move_block, retry move_block .
     2591         end.
     2592         for each buf_temp-browse-handle
     2593           where buf_temp-browse-handle.browse-type = 'height':u
     2594         on error undo move_block, retry move_block
     2595         :
     2596           assign
     2597             buf_temp-browse-handle.browse-handle :height
     2598               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2599             no-error .
     2600           if error-status :error
     2601           or error-status :get-message(1) <> ""
     2602           then do:
     2603             undo move_block, retry move_block .
     2604           end.
     2605         end.
     2606         for each buf_temp-diasize-handle
     2607         on error undo move_block, retry move_block
     2608         :
     2609           assign
     2610             v-object-handle = buf_temp-diasize-handle.handle-value
     2611           .
     2612           if v-object-handle <> v-diasize-resize-button
     2613           then do:
     2614             assign
     2615               v-object-handle :row = v-object-handle :row + p-change-value
     2616               no-error .
     2617             if error-status :error
     2618             or error-status :get-message(1) <> ""
     2619             then do:
     2620               undo move_block, retry move_block .
     2621             end.
     2622           end.
     2623         end.
     2624       end.
     2625       else do:
     2626         for each buf_temp-diasize-handle
     2627         on error undo move_block, retry move_block
     2628         :
     2629           assign
     2630             v-object-handle = buf_temp-diasize-handle.handle-value
     2631           .
     2632           if v-object-handle <> v-diasize-resize-button
     2633           then do:
     2634             assign
     2635               v-object-handle :row = v-object-handle :row + p-change-value
     2636               no-error .
     2637             if error-status :error
     2638             or error-status :get-message(1) <> ""
     2639             then do:
     2640               undo move_block, retry move_block .
     2641             end.
     2642           end.
     2643         end.
     2644         assign
     2645           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2646           no-error .
     2647         if error-status :error
     2648         or error-status :get-message(1) <> ""
     2649         then do:
     2650           undo move_block, retry move_block .
     2651         end.
     2652         for each buf_temp-browse-handle
     2653           where buf_temp-browse-handle.browse-type = 'height':u
     2654         on error undo move_block, retry move_block
     2655         :
     2656           assign
     2657             buf_temp-browse-handle.browse-handle :height
     2658               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2659             no-error .
     2660           if error-status :error
     2661           or error-status :get-message(1) <> ""
     2662           then do:
     2663             undo move_block, retry move_block .
     2664           end.
     2665         end.
     2666         assign
     2667           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2668           no-error .
     2669         if error-status :error
     2670         or error-status :get-message(1) <> ""
     2671         then do:
     2672           undo move_block, retry move_block .
     2673         end.
     2674         if frame Dialog-Frame :scrollable = true
     2675         then do:
     2676           assign
     2677             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2678             no-error .
     2679           if error-status :error
     2680           or error-status :get-message(1) <> ""
     2681           then do:
     2682             undo move_block, retry move_block .
     2683           end.
     2684         end.
     2685       end.
     2686       if p-move-resize = true
     2687       then do:
     2688         run diasize_position-resize-button in this-procedure .
     2689       end.
     2690       if v-diasize-wndstore = true
     2691       then do:
     2692         if connected("ub") = true
     2693         then do:
     2694           define variable v-cntxt-db-num        as integer   no-undo .
     2695           define variable v-cntxt-userid        as character no-undo .
     2696           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2697                                             , OUTPUT v-cntxt-userid
     2698                                             ) .
     2699           run gbl/wndsizew.p
     2700             (input  v-cntxt-db-num
     2701             ,input  v-cntxt-userid
     2702             ,input  v-diasize-proc-name
     2703             ,input  'height':u
     2704             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2705             ) .
     2706         end.
     2707       end.
     2708     end.
     2709     assign
     2710       v-diasize-change-size = false
     2711     .
     2712   end procedure.
     2713   procedure diasize_set-height :
     2714     define input  parameter p-new-height  as decimal   no-undo .
     2715     define input  parameter p-move-resize as logical   no-undo .
     2716     do
     2717     on error undo, return error return-value
     2718     :
     2719       run diasize_change-height in this-procedure
     2720         (input  (p-new-height - frame Dialog-Frame :height)
     2721         ,input  p-move-resize
     2722         ) .
     2723     end.
     2724   end procedure.
     2725   procedure diasize_change-width :
     2726     define input  parameter p-change-value as decimal   no-undo .
     2727     define input  parameter p-move-resize  as logical   no-undo .
     2728     define variable v-field-group-handle   as handle    no-undo .
     2729     define variable v-object-handle        as handle    no-undo .
     2730     define variable v-frame-width          as decimal   no-undo .
     2731     define variable v-frame-virtual-width  as decimal   no-undo .
     2732     define variable v-browse-width         as decimal   no-undo .
     2733     define variable v-window-width         as decimal   no-undo .
     2734     define variable v-window-virtual-width as decimal   no-undo .
     2735     define variable v-change-sign          as integer   no-undo .
     2736     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2737     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2738     if p-change-value > 0
     2739     then do:
     2740       if frame Dialog-Frame :width + p-change-value >
     2741           session :width-chars
     2742       then do:
     2743         assign
     2744           p-change-value = session :width-chars - frame Dialog-Frame :width
     2745         .
     2746         if p-change-value <= 0
     2747         then do:
     2748           run diasize_position-resize-button in this-procedure .
     2749           return .
     2750         end.
     2751       end.
     2752     end.
     2753     if p-change-value < 0
     2754     then do:
     2755       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2756       then do:
     2757         assign
     2758           p-change-value = v-diasize-orig-frame-width
     2759                          - frame Dialog-Frame :width
     2760         .
     2761         if p-change-value >= 0
     2762         then do:
     2763           run diasize_position-resize-button in this-procedure .
     2764           return .
     2765         end.
     2766       end.
     2767     end.
     2768     if p-change-value >= 0
     2769     then do:
     2770       assign
     2771         v-change-sign = 1
     2772       .
     2773     end.
     2774     else do:
     2775       assign
     2776         v-change-sign = -1
     2777       .
     2778     end.
     2779     assign
     2780       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2781     .
     2782     if p-change-value = 0
     2783     then do:
     2784       run diasize_position-resize-button in this-procedure .
     2785       return .
     2786     end.
     2787     move_block:
     2788     do
     2789     on error undo move_block, leave move_block
     2790     :
     2791       if retry
     2792       then do:
     2793         do
     2794         on error undo move_block, leave move_block
     2795         :
     2796           if p-change-value > 0
     2797           then do:
     2798             for each buf_temp-diasize-handle
     2799             on error undo, next
     2800             :
     2801               assign
     2802                 v-object-handle = buf_temp-diasize-handle.handle-value
     2803               .
     2804               if v-object-handle <> v-diasize-resize-button
     2805               then do:
     2806                 assign
     2807                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2808                 .
     2809               end.
     2810             end.
     2811             assign
     2812               v-diasize-browse-handle :width = v-browse-width
     2813             .
     2814             for each buf_temp-browse-handle
     2815               where buf_temp-browse-handle.browse-type = 'width':u
     2816             on error undo, next
     2817             :
     2818               assign
     2819                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2820               .
     2821             end.
     2822             assign
     2823               frame Dialog-Frame :width = v-frame-width
     2824             .
     2825             if frame Dialog-Frame :scrollable = true
     2826             then do:
     2827               assign
     2828                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2829               .
     2830             end.
     2831             run diasize_position-resize-button in this-procedure .
     2832           end.
     2833           else do:
     2834             if frame Dialog-Frame :scrollable = true
     2835             then do:
     2836               assign
     2837                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2838               .
     2839             end.
     2840             assign
     2841               frame Dialog-Frame :width = v-frame-width
     2842             .
     2843             for each buf_temp-browse-handle
     2844               where buf_temp-browse-handle.browse-type = 'width':u
     2845             on error undo, next
     2846             :
     2847               assign
     2848                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2849               .
     2850             end.
     2851             assign
     2852               v-diasize-browse-handle :width = v-browse-width
     2853             .
     2854             for each buf_temp-diasize-handle
     2855             on error undo, next
     2856             :
     2857               assign
     2858                 v-object-handle = buf_temp-diasize-handle.handle-value
     2859               .
     2860               if v-object-handle <> v-diasize-resize-button
     2861               then do:
     2862                 assign
     2863                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2864                 .
     2865               end.
     2866             end.
     2867             run diasize_position-resize-button in this-procedure .
     2868           end.
     2869           assign
     2870             v-diasize-change-size = false
     2871           .
     2872           leave move_block .
     2873         end.
     2874       end.
     2875       assign
     2876         v-diasize-need-full-display = true
     2877       .
     2878       if v-diasize-change-size = false
     2879       then do:
     2880         assign
     2881           v-diasize-change-size = true
     2882         .
     2883       end.
     2884       else do:
     2885         return .
     2886       end.
     2887       assign
     2888         v-frame-width = frame Dialog-Frame :width
     2889         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2890         v-browse-width = v-diasize-browse-handle :width
     2891       .
     2892       for each buf_temp-browse-handle
     2893         where buf_temp-browse-handle.browse-type = 'width':u
     2894       :
     2895         assign
     2896           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2897         .
     2898       end.
     2899       for each buf_temp-diasize-handle
     2900       :
     2901         delete buf_temp-diasize-handle .
     2902       end.
     2903       assign
     2904         v-field-group-handle = frame Dialog-Frame :first-child
     2905       .
     2906       do while valid-handle(v-field-group-handle)
     2907       :
     2908         assign
     2909           v-object-handle = v-field-group-handle :first-child
     2910         .
     2911         do while valid-handle(v-object-handle)
     2912         :
     2913           if  v-object-handle <> v-diasize-browse-handle :handle
     2914           and v-object-handle <> v-diasize-resize-button
     2915           and can-query(v-object-handle, "row")
     2916           and can-query(v-object-handle, "height")
     2917           and ( v-object-handle :col + v-object-handle :width
     2918                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2919               )
     2920           then do:
     2921             find first buf_temp-browse-handle
     2922               where buf_temp-browse-handle.browse-type   = 'width':u
     2923                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2924               no-error .
     2925             if available buf_temp-browse-handle
     2926             then do:
     2927             end.
     2928             else do:
     2929               create buf_temp-diasize-handle .
     2930               assign
     2931                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2932                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2933               .
     2934             end.
     2935           end.
     2936           assign
     2937             v-object-handle = v-object-handle :next-sibling
     2938           .
     2939         end.
     2940         assign
     2941           v-field-group-handle = v-field-group-handle :next-sibling
     2942         .
     2943       end.
     2944       do with frame Dialog-Frame
     2945       :
     2946         hide v-diasize-resize-button .
     2947         v-diasize-resize-button :row = 1.
     2948         v-diasize-resize-button :column = 1.
     2949       end.
     2950       if p-change-value > 0
     2951       then do:
     2952         if frame Dialog-Frame :scrollable = true
     2953         then do:
     2954           assign
     2955             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2956             no-error .
     2957           if error-status :error
     2958           or error-status :get-message(1) <> ""
     2959           then do:
     2960             undo move_block, retry move_block.
     2961           end.
     2962         end.
     2963         assign
     2964           frame Dialog-Frame :width = v-frame-width + p-change-value
     2965           no-error .
     2966         if error-status :error
     2967         or error-status :get-message(1) <> ""
     2968         then do:
     2969           undo move_block, retry move_block.
     2970         end.
     2971         assign
     2972           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2973         no-error .
     2974         if error-status :error
     2975         or error-status :get-message(1) <> ""
     2976         then do:
     2977           undo move_block, retry move_block.
     2978         end.
     2979         for each buf_temp-browse-handle
     2980           where buf_temp-browse-handle.browse-type = 'width':u
     2981         on error undo move_block, retry move_block
     2982         :
     2983           assign
     2984             buf_temp-browse-handle.browse-handle :width
     2985               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2986             no-error .
     2987           if error-status :error
     2988           or error-status :get-message(1) <> ""
     2989           then do:
     2990             undo move_block, retry move_block .
     2991           end.
     2992         end.
     2993         for each buf_temp-diasize-handle
     2994         on error undo move_block, retry move_block
     2995         :
     2996           assign
     2997             v-object-handle = buf_temp-diasize-handle.handle-value
     2998           .
     2999           if v-object-handle <> v-diasize-resize-button
     3000           then do:
     3001             assign
     3002               v-object-handle :col = v-object-handle :col + p-change-value
     3003               no-error .
     3004             if error-status :error
     3005             or error-status :get-message(1) <> ""
     3006             then do:
     3007               undo move_block, retry move_block .
     3008             end.
     3009           end.
     3010         end.
     3011       end.
     3012       else do:
     3013         for each buf_temp-diasize-handle
     3014         on error undo move_block, retry move_block
     3015         :
     3016           assign
     3017             v-object-handle = buf_temp-diasize-handle.handle-value
     3018           .
     3019           if v-object-handle <> v-diasize-resize-button
     3020           then do:
     3021             assign
     3022               v-object-handle :col = v-object-handle :col + p-change-value
     3023               no-error .
     3024             if error-status :error
     3025             or error-status :get-message(1) <> ""
     3026             then do:
     3027               undo move_block, retry move_block .
     3028             end.
     3029           end.
     3030         end.
     3031         for each buf_temp-browse-handle
     3032           where buf_temp-browse-handle.browse-type = 'width':u
     3033         on error undo move_block, retry move_block
     3034         :
     3035           assign
     3036             buf_temp-browse-handle.browse-handle :width
     3037               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3038             no-error .
     3039           if error-status :error
     3040           or error-status :get-message(1) <> ""
     3041           then do:
     3042             undo move_block, retry move_block .
