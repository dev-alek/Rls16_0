     1058   FUNCTION get-all-fields returns character (p-file-name as character ):
     1059   define variable v-dop as character no-undo .
     1060     find first _file no-lock where _file._file-name = p-file-name no-error .
     1061     if not available _file then return "":U.
     1062     for each _field no-lock where
     1063              _field._file-recid = recid(_file) :
     1064       assign
     1065       v-dop = v-dop + _field._field-name + chr(44)
     1066       .
     1067     end.
     1068     return trim(v-dop).
     1069   END FUNCTION.
