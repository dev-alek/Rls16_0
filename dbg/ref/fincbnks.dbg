     2918           b-sch :tooltip = ""
     2919         .
     2920       end.
     2921     end.
     2922   end procedure.
     2923   def var sort-labelBR-bank   as character no-undo .
     2924   def var sort-clmnBR-bank    as handle    no-undo .
     2925   def var cur-clmnBR-bank     as handle    no-undo .
     2926   def var cur-clmn-locBR-bank as integer   no-undo .
     2927   def var re-queryBR-bank     as logical   initial no no-undo .
     2928   on start-search, ctrl-o of BR-bank in frame Dialog-Frame do:
     2929      run sort-brBR-bank
     2930        (input (if available X_c-fin-bank
     2931                then recid(X_c-fin-bank)
     2932                else ?
     2933               )
     2934        ).
     2935   end.
     2936   PROCEDURE sort-brBR-bank :
     2937     define input parameter p-recid as recid no-undo .
     2938     if re-queryBR-bank = no then do:
     2939       assign
     2940          cur-clmnBR-bank = BR-bank:current-column in frame Dialog-Frame
     2941       .
     2942       if sort-clmnBR-bank <> ? then sort-clmnBR-bank:column-fgcolor = 0.
     2943       if cur-clmnBR-bank = sort-clmnBR-bank then do:
     2944         assign
     2945            sort-labelBR-bank = ""
     2946            sort-clmnBR-bank = ?
     2947         .
     2948        end.
     2949        else do:
     2950          assign
     2951            sort-labelBR-bank = cur-clmnBR-bank:label
     2952            sort-clmnBR-bank  = cur-clmnBR-bank
     2953            sort-clmnBR-bank:column-fgcolor = 4
     2954          .
     2955        end.
     2956      end.
     2957     assign
     2958       cur-clmn-locBR-bank = 1
     2959     .
     2960     def var column-handle as handle no-undo .
     2961     column-handle = BR-bank:first-column.
     2962     do while valid-handle(column-handle) :
     2963       if column-handle = cur-clmnBR-bank then do:
     2964         leave .
     2965       end.
     2966       column-handle = column-handle:NEXT-COLUMN.
     2967       assign
     2968         cur-clmn-locBR-bank = cur-clmn-locBR-bank + 1
     2969       .
     2970     end.
     2971     case sort-labelBR-bank:
     2972           when X_c-fin-bank.bank-name:label in browse BR-bank then DO:    assign       sort-column-name = "X_c-fin-bank.bank-name"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     2973           when X_c-fin-bank.bik:label in browse BR-bank then DO:    assign       sort-column-name = "X_c-fin-bank.bik"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     2974           when X_c-fin-bank.corr-date:label in browse BR-bank then DO:    assign       sort-column-name = "X_c-fin-bank.corr-date"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     2975       otherwise do:
     2976         assign
     2977           sort-column-name = ""
     2978         .
     2979         run OpenBr in this-procedure ( input yes, input no, input '':U).
     2980           if can-do( this-procedure:internal-entries, 'mv-brw-defaultBR-bank') then do:
     2981             run mv-brw-defaultBR-bank.
     2982           end.
     2983         if sort-labelBR-bank <> "" then do:
     2984           assign
     2985             cur-clmnBR-bank:column-fgcolor = 0
     2986           .
     2987         end.
     2988         assign
     2989           cur-clmn-locBR-bank = ?
     2990         .
     2991       end.
     2992     end case.
     2993       if cur-clmn-locBR-bank <> ? then do:
     2994         if can-do( this-procedure:internal-entries, 'ch-clmnBR-bank') then do:
     2995           run ch-clmnBR-bank in this-procedure (cur-clmn-locBR-bank).
     2996         end.
     2997       end.
     2998     if p-recid <> ? then do:
     2999       reposition BR-bank to recid p-recid no-error.
     3000       apply "value-changed" to BR-bank in frame Dialog-Frame.
     3001     end.
     3002     apply "entry" to BR-bank in frame Dialog-Frame.
     3003   END PROCEDURE.
     3004   procedure re-open-query-srt-clmnBR-bank:
     3005   if cur-clmnBR-bank = ? then do:
     3006      run OpenBr in this-procedure ( input yes, input no, input '':U).
     3007   end.
     3008   else do:
     3009      assign re-queryBR-bank = yes.
     3010      run sort-brBR-bank
     3011        (input (if available X_c-fin-bank
     3012                then recid(X_c-fin-bank)
     3013                else ?
     3014               )
     3015        ).
     3016      assign re-queryBR-bank = no.
     3017   end.
     3018   end.
     3019   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3020   do:
     3021     BR-bank :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     3022   end.
     3023   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3024   on INS of frame Dialog-Frame anywhere do:
     3025     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     3026     return no-apply.
     3027   end.
     3028   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3029   on F3 of frame Dialog-Frame anywhere do:
     3030     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame Dialog-Frame. END.
     3031     return no-apply.
     3032   end.
     3033   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3034   on F2 of frame Dialog-Frame anywhere do:
     3035     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     3036     return no-apply.
