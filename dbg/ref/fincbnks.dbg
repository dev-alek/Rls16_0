     1096     define variable v-label           as character no-undo .
     1097     define variable v-old-value       as character no-undo case-sensitive.
     1098     define variable v-new-value       as character no-undo case-sensitive.
     1099     define variable v-chg-fields as character no-undo.
     1100     for each temp-changes:
     1101       delete temp-changes.
     1102     end.
     1103     if not p-hst-handle:available then do:
     1104       return .
     1105     end.
     1106     create buffer h-new-buf  for table p-hst-handle .
     1107     create buffer h-main-buf for table p-main-table .
     1108     assign
     1109       v-inform = h-main-buf:index-information(1)
     1110       v-ind    = 2
     1111     .
     1112     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1113     on error undo, return error
     1114     :
     1115       assign
     1116         v-inform = h-main-buf:index-information( v-ind )
     1117         v-ind    = v-ind + 1
     1118       .
     1119     end.
     1120     if v-inform = ?
     1121       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1122       or entry( 3, v-inform, ",":U ) <> "1":U
     1123     then do:
     1124       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1125     end.
     1126     assign
     1127       v-idx-field-qnty = num-entries( v-inform ) - 4
     1128     .
     1129     if v-idx-field-qnty < 2 then do:
     1130       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1131     end.
     1132     assign
     1133       v-srch-main   = "where":U
     1134       v-word-link   = "":U
     1135       v-av-chip-num = false
     1136       v-delim-list  = "":U
     1137     .
     1138     do v-ind = 1 to v-idx-field-qnty by 2
     1139     on error undo, return error
     1140     :
     1141       assign
     1142         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1143         fh                = p-hst-handle:buffer-field( v-field-name )
     1144         fh-main           = h-main-buf:buffer-field( v-field-name )
     1145         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1146         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1147       .
     1148       if fh:data-type ="character":U then do:
     1149         assign
     1150           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1151         .
     1152       end.
     1153       else do:
     1154         assign
     1155           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1156         .
     1157       end.
     1158       if v-delim-list = "":U then do:
     1159         assign
     1160           v-delim-list = ",":U
     1161         .
     1162       end.
     1163       if v-word-link = "":U then do:
     1164         assign
     1165           v-word-link = "and":U
     1166         .
     1167       end.
     1168     end.
     1169     assign
     1170       v-delim-list  = "":U
     1171     .
     1172     do v-ind = 1 to h-main-buf:num-fields
     1173     on error undo, return error
     1174     :
     1175       assign
     1176         fh-main      = h-main-buf:buffer-field( v-ind )
     1177         v-field-name = fh-main:name
     1178       .
     1179         assign
     1180           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1181         .
     1182         if v-delim-list = "":U then do:
     1183           assign
     1184             v-delim-list = ",":U
     1185           .
     1186         end.
     1187     end.
     1188     assign
     1189       v-inform = p-hst-handle:index-information(1)
     1190       v-ind    = 2
     1191     .
     1192     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1193     on error undo, return error
     1194     :
     1195       assign
     1196         v-inform = p-hst-handle:index-information( v-ind )
     1197         v-ind    = v-ind + 1
     1198       .
     1199     end.
     1200     if v-inform = ?
     1201       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1202       or entry( 3, v-inform, ",":U ) <> "1":U
     1203     then do:
     1204       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1205     end.
     1206     assign
     1207       v-idx-field-qnty = num-entries( v-inform ) - 4
     1208     .
     1209     if v-idx-field-qnty < 2 then do:
     1210       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1211     end.
     1212     assign
     1213       v-search-exp  = "where":U
     1214       v-word-link   = "":U
     1215       v-av-chip-num = false
     1216     .
     1217     do v-ind = 1 to v-idx-field-qnty by 2
     1218     on error undo, return error
     1219     :
     1220       assign
     1221         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1222         fh           = p-hst-handle:buffer-field( v-field-name )
     1223         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1224       .
     1225       if v-field-name = "chip-num":U then do:
     1226         assign
     1227           v-search-exp  = substitute( "&1 >", v-search-exp )
     1228           v-av-chip-num = true
     1229         .
     1230       end.
     1231       else do:
     1232         assign
     1233           v-search-exp = substitute( "&1 =", v-search-exp )
     1234         .
     1235       end.
     1236       if fh:data-type ="character":U then do:
     1237         assign
     1238           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1239         .
     1240       end.
     1241       else do:
     1242         assign
     1243           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1244         .
     1245       end.
     1246       if v-word-link = "":U then do:
     1247         assign
     1248           v-word-link = "and":U
     1249         .
     1250       end.
     1251     end.
     1252     if v-av-chip-num = false then do:
     1253       message
     1254         vss-workfile vss-revision vss-description skip
     1255         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1256         "Использование данной процедуры невозможно!" skip
     1257         view-as alert-box error .
     1258       return error .
     1259     end.
     1260     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1261     if not h-new-buf:available then do:
     1262       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1263       if not h-main-buf:available then do:
     1264         assign
     1265           h-for-comp = ?
     1266         .
     1267       end.
     1268       else do:
     1269         assign
     1270           h-for-comp = h-main-buf
     1271         .
     1272       end.
     1273     end.
     1274     else do:
     1275       assign
     1276         h-for-comp = h-new-buf
     1277       .
     1278     end.
     1279     assign
     1280       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1281     .
     1282     do v-ind = 1 to v-num-entries
     1283     on error undo, return error return-value
     1284     :
     1285       assign
     1286         v-field-name = entry( v-ind, v-main-fld-lst )
     1287         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1288         v-old-value  = fh-old:buffer-value()
     1289         v-label      = trim( fh-old:label )
     1290       .
     1291       if ( trim( p-field-list ) <> "":U
     1292            and lookup( v-field-name, p-field-list ) > 0
     1293          )
     1294          or trim( p-field-list ) = "":U
     1295       then do:
     1296         if h-for-comp <> ? then do:
     1297           assign
     1298             fh-new      = h-for-comp:buffer-field( v-field-name )
     1299             v-new-value = fh-new:buffer-value()
     1300           .
     1301         end.
     1302         else do:
     1303           assign
     1304             v-new-value = "":U
     1305           .
     1306         end.
     1307         if v-old-value <> v-new-value
     1308         then do:
     1309           create temp-changes.
     1310           assign
     1311             temp-changes.t_name = p-main-table
     1312             temp-changes.f_name = v-field-name
     1313             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1314             temp-changes.v_old  = trim( v-old-value )
     1315             temp-changes.v_new  = trim( v-new-value )
     1316             temp-changes.num_   = 0
     1317             temp-changes.fNotChange = v-old-value eq v-new-value
     1318           .
     1319         end.
     1320       end.
     1321     end.
     1322     assign
     1323       v-num-entries = num-entries( p-label-form, chr(8) )
     1324     .
     1325     do v-ind = 1 to v-num-entries
     1326     on error undo, return error return-value
     1327     :
     1328       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1329         assign
     1330           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1331           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1332           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1333         .
     1334         find first temp-changes
     1335           where temp-changes.f_name = v-field-name
     1336           no-error .
     1337         if available temp-changes then do:
     1338           if trim( v-field-lvl ) <> "":U then do:
     1339             assign
     1340               temp-changes.l_name = v-field-lvl
     1341             .
     1342           end.
     1343           if trim( v-field-form ) <> "":U then do:
     1344             assign
     1345               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1346             .
     1347             if h-for-comp <> ? then do:
     1348               assign
     1349                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1350               .
     1351             end.
     1352           end.
     1353         end.
     1354       end.
     1355       else do:
     1356         message
     1357           vss-workfile vss-revision vss-description skip
     1358           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1359           substitute( "список для поля '&1': '&2'"
     1360                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1361                       ,entry( v-ind, p-label-form, chr(8) )
     1362                     ) skip
     1363           substitute( "полный список: &2", p-label-form ) skip
     1364           view-as alert-box error .
     1365       end.
     1366     end.
     1367     delete object h-new-buf .
     1368     delete object h-main-buf .
     1369   END PROCEDURE.
     1370   DEFINE BUTTON B-Help
     1371        LABEL "Помо&щь"
     1372        SIZE 3 BY 1
     1373        BGCOLOR 8 .
     1374   DEFINE BUTTON b-lkp
     1375        LABEL "&Просмотр"
     1376        SIZE 10 BY 1.
     1377   DEFINE BUTTON B-mark
     1378        LABEL "&*"
     1379        SIZE 3 BY 1.
     1380   DEFINE BUTTON b-quit AUTO-END-KEY
     1381        LABEL "&Выход"
     1382        SIZE 10 BY 1
     1383        BGCOLOR 8 .
     1384   DEFINE BUTTON B-sch
     1385        LABEL "&Фильтр"
     1386        SIZE 3 BY 1.
     1387   DEFINE BUTTON b-sel AUTO-GO
     1388        LABEL "Вы&бор"
     1389        SIZE 10 BY 1
     1390        BGCOLOR 8 .
     1391   DEFINE VARIABLE ED-notes AS CHARACTER
     1392        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1393        SIZE 98 BY 2
     1394        BGCOLOR 8 FGCOLOR 4  NO-UNDO.
     1395   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1396         VIEW-AS TEXT
     1397        SIZE 6 BY 1
     1398        FGCOLOR 4  NO-UNDO.
     1399   DEFINE VARIABLE sch-BIK AS CHARACTER FORMAT "X(9)":U
     1400        LABEL "БИК"
     1401        VIEW-AS FILL-IN
     1402        SIZE 12 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1403   DEFINE VARIABLE sch-code AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1404        LABEL "коду"
     1405        VIEW-AS FILL-IN
     1406        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1407   DEFINE VARIABLE sch-name AS CHARACTER FORMAT "X(35)":U
     1408        LABEL "нач.назв."
     1409        VIEW-AS FILL-IN
     1410        SIZE 41.88 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1411   DEFINE QUERY BR-bank FOR
     1412         X_c-fin-bank SCROLLING.
     1413   DEFINE QUERY BR-changes FOR
     1414         temp-changes SCROLLING.
     1415   DEFINE BROWSE BR-bank
     1416     QUERY BR-bank DISPLAY
     1417         mark-string(recid(X_c-fin-bank), v-rid-list) FORMAT "X(1)":U
     1418         X_c-fin-bank.host-code COLUMN-LABEL "Фирма" FORMAT "999999999":U
     1419         X_c-fin-bank.code-bank COLUMN-LABEL "Код!банка" FORMAT "9999999":U
     1420         X_c-fin-bank.bank-name FORMAT "X(40)":U
     1421         X_c-fin-bank.bik FORMAT "X(9)":U
     1422         X_c-fin-bank.status_ FORMAT "X(8)":U
     1423         usrfulnf(X_c-fin-bank.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
     1424         X_c-fin-bank.corr-date COLUMN-LABEL "Дата!измен" FORMAT "99/99/9999":U
     1425         string(X_c-fin-bank.corr-time, "HH:MM") COLUMN-LABEL "Время!измен" FORMAT "X(5)":U
     1426     ENABLE
     1427         X_c-fin-bank.corr-date
     1428       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 10.04.
     1429   DEFINE BROWSE BR-changes
     1430     QUERY BR-changes DISPLAY
     1431         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1432   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1433   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1434       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 6.
     1435   DEFINE FRAME Dialog-Frame
     1436        b-quit AT ROW 1 COL 1
     1437        B-mark AT ROW 1 COL 11
     1438        b-sel AT ROW 1 COL 21
     1439        b-lkp AT ROW 1 COL 41
     1440        B-sch AT ROW 1 COL 92
     1441        B-Help AT ROW 1 COL 95
     1442        BR-bank AT ROW 2.21 COL 1
     1443        ED-notes AT ROW 12.42 COL 1.13 NO-LABEL
     1444        sch-code AT ROW 14.5 COL 33.63 COLON-ALIGNED
     1445        sch-BIK AT ROW 14.54 COL 14.5 COLON-ALIGNED
     1446        sch-name AT ROW 14.54 COL 53.5 COLON-ALIGNED
     1447        BR-changes AT ROW 16.04 COL 1
     1448        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1449        "ПОИСК ПО" VIEW-AS TEXT
     1450             SIZE 9.25 BY 1 AT ROW 14.58 COL 1.5
     1451             FGCOLOR 4
     1452        SPACE(88.49) SKIP(6.46)
     1453       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1454            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1455            TITLE "Список истории банков"
     1456            CANCEL-BUTTON b-quit.
     1457   ASSIGN
     1458          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1459          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1460   ASSIGN
     1461          BR-bank:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     1462   ASSIGN
     1463          ED-notes:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1464   ON GO OF FRAME Dialog-Frame
     1465   DO:
     1466     p-rid-list = v-rid-list.
     1467   END.
     1468   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1469   DO:
     1470   define variable loc-doc-rec as recid no-undo .
     1471   define buffer buf_c-fin-bank for ub.c-fin-bank.
     1472     if NOT available X_c-fin-bank then do:
     1473       message
     1474       "Неправильно выбран банк."
     1475       view-as alert-box ERROR.
     1476       return no-apply.
     1477     end.
     1478     find first buf_c-fin-bank no-lock where
     1479                buf_c-fin-bank.host-code = X_c-fin-bank.host-code
     1480            AND buf_c-fin-bank.code-bank = X_c-fin-bank.code-bank use-index pi no-error .
     1481     if available buf_c-fin-bank and
     1482       recid(buf_c-fin-bank) = recid(X_c-fin-bank) then do:
     1483       message
     1484       "Данная запись истории пуста - т.к. соответствует СОЗДАНИЮ записи БАНК" skip
     1485       "Просмотр невозможен"
     1486       view-as alert-box .
     1487       return no-apply.
     1488     end.
     1489     loc-doc-rec = recid (X_c-fin-bank).
     1490     .
     1491     run ref/fincbnki.w
     1492                   (
     1493                    input parParentProc
     1494                   ,input p-curr-host-code
     1495                   ,input 'ПРОСМОТР':U
     1496                   ,input X_c-fin-bank.host-code
     1497                   ,input X_c-fin-bank.code-bank
     1498                   ,input X_c-fin-bank.corr-user-db-num
     1499                   ,input X_c-fin-bank.chip-num
     1500                   ,input-output loc-doc-rec
     1501                                 )
     1502     .
     1503     reposition br-bank to recid loc-doc-rec no-error.
     1504     apply "entry" to br-bank in frame Dialog-Frame.
     1505     apply "value-changed" to br-bank in frame Dialog-Frame.
     1506   END.
     1507   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1508   DO:
     1509   define variable loc#log as logical no-undo .
     1510     if available X_c-fin-bank then do:
     1511   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1512   define variable v-str-recid14 as character no-undo .
     1513   define variable v-num-entry14 as integer   no-undo .
     1514   assign
     1515     v-str-recid14 = trim( string( recid( X_c-fin-bank ) , "->>>>>>>>>>>9":U ) )
     1516     v-num-entry14 = lookup( v-str-recid14 , v-rid-list )
     1517   .
     1518   if v-num-entry14 > 0 then do:
     1519     assign
     1520       entry( v-num-entry14, v-rid-list ) = "":U
     1521       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1522     .
     1523   end.
     1524   else do:
     1525     assign
     1526       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid14
     1527     .
     1528   end.
     1529       loc#log = br-bank:refresh() .
     1530       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1531           loc#log = br-bank:select-next-row ().
     1532           apply "VALUE-CHANGED" to br-bank in frame Dialog-Frame.
     1533       end.
     1534       if num-entries( v-rid-list ) = 0
     1535       then
     1536           hide mark-num in frame Dialog-Frame.
     1537       else
     1538           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1539     end.
     1540     apply "entry" to br-bank in frame Dialog-Frame.
     1541   END.
     1542   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     1543   DO:
     1544         run gbl/markqwa.p (
     1545                    input b-mark:sensitive
     1546                  , input v-rid-list) no-error.
     1547     if error-status:error then return no-apply.
     1548   END.
     1549   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1550   DO:
     1551     run proc-b-sch in this-procedure no-error.
     1552     if error-status:error then return no-apply.
     1553   END.
     1554   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1555   DO:
     1556     if ( available X_c-fin-bank ) then do:
     1557       if ( v-rid-list = "" ) or b-mark:sensitive = no
     1558       then
     1559       v-rid-list = string( recid( X_c-fin-bank ) ) .
     1560     end.
     1561   END.
     1562   ON RETURN OF BR-bank IN FRAME Dialog-Frame
     1563   or MOUSE-SELECT-DBLCLICK OF Br-bank IN FRAME Dialog-Frame
     1564   DO:
     1565     run proc-br-bank no-error.
     1566     if error-status:error then return no-apply.
     1567   END.
     1568   ON VALUE-CHANGED OF BR-bank IN FRAME Dialog-Frame
     1569   DO:
     1570      DEFINE VARIABLE dops as character no-undo .
     1571     dops = if available X_c-fin-bank then X_c-fin-bank.ps else '':U.
     1572     ED-notes:screen-value = dops.
     1573     run proc-view-changes in this-procedure no-error.
     1574   END.
     1575   ON LEAVE OF ED-notes IN FRAME Dialog-Frame
     1576   DO:
     1577     define buffer ps_fin-bank for ub.fin-bank.
     1578     if not available X_c-fin-bank then return no-apply.
     1579      DO on stop undo, return no-apply:
     1580         FIND PS_fin-bank where
     1581              recid (ps_fin-bank) = recid(X_c-fin-bank) exclusive.
     1582         if ps_fin-bank.PS <> input frame Dialog-Frame ed-notes then
     1583         assign
     1584         ps_fin-bank.PS = input frame Dialog-Frame ed-notes
     1585         .
     1586      END.
     1587   END.
     1588   ON CTRL-J OF sch-BIK IN FRAME Dialog-Frame
     1589   DO:
     1590     run proc-find-bik in this-procedure ( input yes, input frame Dialog-Frame sch-bik) no-error.
     1591     if error-status:error then return no-apply.
     1592   END.
     1593   ON RETURN OF sch-BIK IN FRAME Dialog-Frame
     1594   DO:
     1595     run proc-find-bik in this-procedure ( input no, input frame Dialog-Frame sch-bik) no-error.
     1596     if error-status:error then return no-apply.
     1597   END.
     1598   ON CTRL-J OF sch-code IN FRAME Dialog-Frame
     1599   DO:
     1600     run proc-find-code in this-procedure ( input yes, input frame Dialog-Frame sch-code) no-error.
     1601     if error-status:error then return no-apply.
     1602   END.
     1603   ON RETURN OF sch-code IN FRAME Dialog-Frame
     1604   DO:
     1605     run proc-find-code in this-procedure ( input no, input frame Dialog-Frame sch-code) no-error.
     1606     if error-status:error then return no-apply.
     1607   END.
     1608   ON CTRL-J OF sch-name IN FRAME Dialog-Frame
     1609   DO:
     1610     run proc-find-name in this-procedure ( input yes, input frame Dialog-Frame sch-name) no-error.
     1611     if error-status:error then return no-apply.
     1612   END.
     1613   ON RETURN OF sch-name IN FRAME Dialog-Frame
     1614   DO:
     1615     run proc-find-name in this-procedure ( input no, input frame Dialog-Frame sch-name) no-error.
     1616     if error-status:error then return no-apply.
     1617   END.
     1618   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1619   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1620   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1621   on help of frame Dialog-Frame
     1622   do:
     1623     run gbl/app_help.p
     1624       (input this-procedure :file-name
     1625       ,input ''
     1626       ,input ?
     1627       ) no-error.
     1628     if error-status :error then do:
     1629       message
     1630         "Ошибка при вызове помощи"
     1631         error-status :get-message(1)
     1632         view-as alert-box .
     1633     end.
     1634   end.
     1635   run minbtn-set in this-procedure .
     1636   on choose of b-help in frame Dialog-Frame
     1637   do:
     1638     apply "help":u to frame Dialog-Frame .
     1639   end.
     1640   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1641   procedure minbtn-set :
     1642       do
     1643           on error undo, return error return-value
     1644           :
     1645           define variable ii              as integer       no-undo .
     1646           define variable fh              as widget-handle no-undo .
     1647           define variable hh              as widget-handle no-undo .
     1648           define variable v-h             as handle        extent 4 no-undo .
     1649           define variable v-name-button   as character     no-undo .
     1650           define variable v-help-old-x    as decimal       no-undo .
     1651           define variable v-help-old-y    as decimal       no-undo .
     1652           define variable v-help-old-size as decimal       no-undo .
     1653           define variable v-frame-width   as decimal       no-undo .
     1654           define variable jj              as integer       no-undo .
     1655           do
     1656               on error undo, return error
     1657               :
     1658               assign
     1659                   v-frame-width = frame Dialog-Frame:width - 0.3
     1660                   fh            = frame Dialog-Frame:first-child
     1661                   hh            = fh:first-child
     1662                   ii            = 1
     1663                   .
     1664               do while valid-handle(hh):
     1665                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1666                   do:
     1667                       case lc(hh:name) :
     1668                           when "b-help" then
     1669                               do:
     1670                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1671                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1672                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1673                                   hh:TOOLTIP = "Помощь" .
     1674                                   v-help-old-x = hh:column .
     1675                                   v-help-old-y = hh:row    .
     1676                                   v-help-old-size = hh:width .
     1677                                   hh:width-chars = 2.5 .
     1678                               end.
     1679                           when "b-print" then
     1680                               do:
     1681                                   hh:load-image("cmp/b-print.bmp":u) .
     1682                                   hh:TOOLTIP = "Печать" .
     1683                                   v-h[ii] = hh:handle .
     1684                                   ii = ii + 1 .
     1685                                   hh:width-chars = 3 .
     1686                               end.
     1687                           when "b-history" or
     1688                           when "b-hist" then
     1689                               do:
     1690                                   hh:load-image("cmp/b-hist.bmp":u) .
     1691                                   hh:TOOLTIP = "История" .
     1692                                   v-h[ii] = hh:handle .
     1693                                   ii = ii + 1 .
     1694                                   hh:width-chars = 3 .
     1695                               end.
     1696                           when "b-sch" then
     1697                               do:
     1698                                   hh:load-image("cmp/b-sch.bmp":u) .
     1699                                   hh:TOOLTIP = "Установка Фильтра" .
     1700                                   v-h[ii] = hh:handle .
     1701                                   ii = ii + 1 .
     1702                                   hh:width-chars = 3 .
     1703                               end.
     1704                           when "b-hist-user" then
     1705                               do:
     1706                                   hh:load-image("cmp/b-hist.bmp":u) .
     1707                                   hh:TOOLTIP = "История пользователя" .
     1708                                   ii = ii + 1 .
     1709                               end.
     1710                       end case.
     1711                   end.
     1712                   hh = hh:next-sibling.
     1713               end.
     1714               b-help:column = v-frame-width - b-help:width-chars.
     1715               jj = 0.
     1716               repeat ii = 4 to 1 by -1 :
     1717                   if valid-handle (v-h[ii] ) then
     1718                   do:
     1719                       jj  = jj + 1 .
     1720                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1721                       v-h[ii]:row    = v-help-old-y .
     1722                   end.
     1723               end.
     1724           end.
     1725       end.
     1726   end procedure.
     1727   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1728   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1729   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1730   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1731   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1732   define variable v-diasize-current-frame-height as decimal   no-undo .
     1733   define variable v-diasize-change-size          as logical   no-undo .
     1734   define variable v-diasize-resize-button        as handle    no-undo .
     1735   define variable v-diasize-wndmax               as logical   no-undo .
     1736   define variable v-diasize-wndstore             as logical   no-undo .
     1737   define variable v-diasize-proc-name            as character no-undo .
     1738   define variable v-diasize-browse-handle        as handle    no-undo .
     1739   define variable v-diasize-browse-number        as integer   no-undo .
     1740   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1741   define temp-table temp-diasize-handle no-undo
     1742     field handle-value  as handle
     1743     field save-position as decimal
     1744     index xpk is primary unique handle-value
     1745     .
     1746   define temp-table temp-browse-handle no-undo
     1747     field browse-type   as character
     1748     field browse-number as integer
     1749     field browse-handle as handle
     1750     field original-size as decimal
     1751     index xpk is primary unique browse-type browse-number
     1752     index xie browse-type browse-handle
     1753   .
     1754   procedure diasize_change-height :
     1755     define input  parameter p-change-value  as decimal   no-undo .
     1756     define input  parameter p-move-resize   as logical   no-undo .
     1757     define variable v-field-group-handle    as handle    no-undo .
     1758     define variable v-object-handle         as handle    no-undo .
     1759     define variable v-frame-height          as decimal   no-undo .
     1760     define variable v-frame-virtual-height  as decimal   no-undo .
     1761     define variable v-browse-height         as decimal   no-undo .
     1762     define variable v-window-height         as decimal   no-undo .
     1763     define variable v-window-virtual-height as decimal   no-undo .
     1764     define variable v-change-sign           as integer   no-undo .
     1765     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1766     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1767     if p-change-value > 0
     1768     then do:
     1769       if frame Dialog-Frame :height + p-change-value
     1770           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1771       then do:
     1772         assign
     1773           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1774                           - (frame Dialog-Frame :height-chars)
     1775         .
     1776         if p-change-value <= 0
     1777         then do:
     1778           run diasize_position-resize-button in this-procedure .
     1779           return .
     1780         end.
     1781       end.
     1782     end.
     1783     if p-change-value < 0
     1784     then do:
     1785       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1786       then do:
     1787         assign
     1788           p-change-value = v-diasize-orig-frame-height
     1789                          - (frame Dialog-Frame :height-chars)
     1790         .
     1791         if p-change-value >= 0
     1792         then do:
     1793           run diasize_position-resize-button in this-procedure .
     1794           return .
     1795         end.
     1796       end.
     1797     end.
     1798     if p-change-value >= 0
     1799     then do:
     1800       assign
     1801         v-change-sign = 1
     1802       .
     1803     end.
     1804     else do:
     1805       assign
     1806         v-change-sign = -1
     1807       .
     1808     end.
     1809     assign
     1810       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1811     .
     1812     if p-change-value = 0
     1813     then do:
     1814       run diasize_position-resize-button in this-procedure .
     1815       return .
     1816     end.
     1817     move_block:
     1818     do
     1819     on error undo move_block, retry move_block
     1820     :
     1821       if retry
     1822       then do:
     1823         do
     1824         on error undo move_block, leave move_block
     1825         :
     1826           if p-change-value > 0
     1827           then do:
     1828             for each buf_temp-diasize-handle
     1829             on error undo, next
     1830             :
     1831               assign
     1832                 v-object-handle = buf_temp-diasize-handle.handle-value
     1833               .
     1834               if v-object-handle <> v-diasize-resize-button
     1835               then do:
     1836                 assign
     1837                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1838                 .
     1839               end.
     1840             end.
     1841             assign
     1842               v-diasize-browse-handle :height = v-browse-height
     1843             .
     1844             for each buf_temp-browse-handle
     1845               where buf_temp-browse-handle.browse-type = 'height':u
     1846             on error undo, next
     1847             :
     1848               assign
     1849                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1850               .
     1851             end.
     1852             assign
     1853               frame Dialog-Frame :height = v-frame-height
     1854             .
     1855             if frame Dialog-Frame :scrollable = true
     1856             then do:
     1857               assign
     1858                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1859               .
     1860             end.
     1861             run diasize_position-resize-button in this-procedure .
     1862           end.
     1863           else do:
     1864             if frame Dialog-Frame :scrollable = true
     1865             then do:
     1866               assign
     1867                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1868               .
     1869             end.
     1870             assign
     1871               frame Dialog-Frame :height = v-frame-height
     1872             .
     1873             assign
     1874               v-diasize-browse-handle :height = v-browse-height
     1875             .
     1876             for each buf_temp-browse-handle
     1877               where buf_temp-browse-handle.browse-type = 'height':u
     1878             on error undo, next
     1879             :
     1880               assign
     1881                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1882               .
     1883             end.
     1884             for each buf_temp-diasize-handle
     1885             on error undo, next
     1886             :
     1887               assign
     1888                 v-object-handle = buf_temp-diasize-handle.handle-value
     1889               .
     1890               if v-object-handle <> v-diasize-resize-button
     1891               then do:
     1892                 assign
     1893                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1894                 .
     1895               end.
     1896             end.
     1897             run diasize_position-resize-button in this-procedure .
     1898           end.
     1899           assign
     1900             v-diasize-change-size = false
     1901           .
     1902           leave move_block .
     1903         end.
     1904       end.
     1905       assign
     1906         v-diasize-need-full-display = true
     1907       .
     1908       if v-diasize-change-size = false
     1909       then do:
     1910         assign
     1911           v-diasize-change-size = true
     1912         .
     1913       end.
     1914       else do:
     1915         return .
     1916       end.
     1917       assign
     1918         v-frame-height = frame Dialog-Frame :height
     1919         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1920         v-browse-height = v-diasize-browse-handle :height
     1921       .
     1922       for each buf_temp-browse-handle
     1923         where buf_temp-browse-handle.browse-type = 'height':u
     1924       :
     1925         assign
     1926           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1927         .
     1928       end.
     1929       for each buf_temp-diasize-handle
     1930       :
     1931         delete buf_temp-diasize-handle .
     1932       end.
     1933       assign
     1934         v-field-group-handle = frame Dialog-Frame :first-child
     1935       .
     1936       do while valid-handle(v-field-group-handle)
     1937       :
     1938         assign
     1939           v-object-handle = v-field-group-handle :first-child
     1940         .
     1941         do while valid-handle(v-object-handle)
     1942         :
     1943           if  v-object-handle <> v-diasize-browse-handle :handle
     1944           and can-query(v-object-handle, "row")
     1945           and can-query(v-object-handle, "height")
     1946           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1947           then do:
     1948             find first buf_temp-browse-handle
     1949               where buf_temp-browse-handle.browse-type   = 'height':u
     1950                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1951               no-error .
     1952             if available buf_temp-browse-handle
     1953             then do:
     1954             end.
     1955             else do:
     1956               create buf_temp-diasize-handle .
     1957               assign
     1958                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1959                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1960               .
     1961             end.
     1962           end.
     1963           assign
     1964             v-object-handle = v-object-handle :next-sibling
     1965           .
     1966         end.
     1967         assign
     1968           v-field-group-handle = v-field-group-handle :next-sibling
     1969         .
     1970       end.
     1971       do with frame Dialog-Frame
     1972       :
     1973         hide v-diasize-resize-button .
     1974         assign
     1975           v-diasize-resize-button :row    = 1
     1976           v-diasize-resize-button :column = 1
     1977         .
     1978       end.
     1979       if p-change-value > 0
     1980       then do:
     1981         if frame Dialog-Frame :scrollable = true
     1982         then do:
     1983           assign
     1984             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1985             no-error .
     1986           if error-status :error
     1987           or error-status :get-message(1) <> ""
     1988           then do:
     1989             undo move_block, retry move_block .
     1990           end.
     1991         end.
     1992         assign
     1993           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1994           no-error .
     1995         if error-status :error
     1996         or error-status :get-message(1) <> ""
     1997         then do:
     1998           undo move_block, retry move_block .
     1999         end.
     2000         assign
     2001           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2002           no-error .
     2003         if error-status :error
     2004         or error-status :get-message(1) <> ""
     2005         then do:
     2006           undo move_block, retry move_block .
     2007         end.
     2008         for each buf_temp-browse-handle
     2009           where buf_temp-browse-handle.browse-type = 'height':u
     2010         on error undo move_block, retry move_block
     2011         :
     2012           assign
     2013             buf_temp-browse-handle.browse-handle :height
     2014               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2015             no-error .
     2016           if error-status :error
     2017           or error-status :get-message(1) <> ""
     2018           then do:
     2019             undo move_block, retry move_block .
     2020           end.
     2021         end.
     2022         for each buf_temp-diasize-handle
     2023         on error undo move_block, retry move_block
     2024         :
     2025           assign
     2026             v-object-handle = buf_temp-diasize-handle.handle-value
     2027           .
     2028           if v-object-handle <> v-diasize-resize-button
     2029           then do:
     2030             assign
     2031               v-object-handle :row = v-object-handle :row + p-change-value
     2032               no-error .
     2033             if error-status :error
     2034             or error-status :get-message(1) <> ""
     2035             then do:
     2036               undo move_block, retry move_block .
     2037             end.
     2038           end.
     2039         end.
     2040       end.
     2041       else do:
     2042         for each buf_temp-diasize-handle
     2043         on error undo move_block, retry move_block
     2044         :
     2045           assign
     2046             v-object-handle = buf_temp-diasize-handle.handle-value
     2047           .
     2048           if v-object-handle <> v-diasize-resize-button
     2049           then do:
     2050             assign
     2051               v-object-handle :row = v-object-handle :row + p-change-value
     2052               no-error .
     2053             if error-status :error
     2054             or error-status :get-message(1) <> ""
     2055             then do:
     2056               undo move_block, retry move_block .
     2057             end.
     2058           end.
     2059         end.
     2060         assign
     2061           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2062           no-error .
     2063         if error-status :error
     2064         or error-status :get-message(1) <> ""
     2065         then do:
     2066           undo move_block, retry move_block .
     2067         end.
     2068         for each buf_temp-browse-handle
     2069           where buf_temp-browse-handle.browse-type = 'height':u
     2070         on error undo move_block, retry move_block
     2071         :
     2072           assign
     2073             buf_temp-browse-handle.browse-handle :height
     2074               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2075             no-error .
     2076           if error-status :error
     2077           or error-status :get-message(1) <> ""
     2078           then do:
     2079             undo move_block, retry move_block .
     2080           end.
     2081         end.
     2082         assign
     2083           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2084           no-error .
     2085         if error-status :error
     2086         or error-status :get-message(1) <> ""
     2087         then do:
     2088           undo move_block, retry move_block .
     2089         end.
     2090         if frame Dialog-Frame :scrollable = true
     2091         then do:
     2092           assign
     2093             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2094             no-error .
     2095           if error-status :error
     2096           or error-status :get-message(1) <> ""
     2097           then do:
     2098             undo move_block, retry move_block .
     2099           end.
     2100         end.
     2101       end.
     2102       if p-move-resize = true
     2103       then do:
     2104         run diasize_position-resize-button in this-procedure .
     2105       end.
     2106       if v-diasize-wndstore = true
     2107       then do:
     2108         if connected("ub") = true
     2109         then do:
     2110           define variable v-cntxt-db-num        as integer   no-undo .
     2111           define variable v-cntxt-userid        as character no-undo .
     2112           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2113                                             , OUTPUT v-cntxt-userid
     2114                                             ) .
     2115           run gbl/wndsizew.p
     2116             (input  v-cntxt-db-num
     2117             ,input  v-cntxt-userid
     2118             ,input  v-diasize-proc-name
     2119             ,input  'height':u
     2120             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2121             ) .
     2122         end.
     2123       end.
     2124     end.
     2125     assign
     2126       v-diasize-change-size = false
     2127     .
     2128   end procedure.
     2129   procedure diasize_set-height :
     2130     define input  parameter p-new-height  as decimal   no-undo .
     2131     define input  parameter p-move-resize as logical   no-undo .
     2132     do
     2133     on error undo, return error return-value
     2134     :
     2135       run diasize_change-height in this-procedure
     2136         (input  (p-new-height - frame Dialog-Frame :height)
     2137         ,input  p-move-resize
     2138         ) .
     2139     end.
     2140   end procedure.
     2141   procedure diasize_change-width :
     2142     define input  parameter p-change-value as decimal   no-undo .
     2143     define input  parameter p-move-resize  as logical   no-undo .
     2144     define variable v-field-group-handle   as handle    no-undo .
     2145     define variable v-object-handle        as handle    no-undo .
     2146     define variable v-frame-width          as decimal   no-undo .
     2147     define variable v-frame-virtual-width  as decimal   no-undo .
     2148     define variable v-browse-width         as decimal   no-undo .
     2149     define variable v-window-width         as decimal   no-undo .
     2150     define variable v-window-virtual-width as decimal   no-undo .
     2151     define variable v-change-sign          as integer   no-undo .
     2152     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2153     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2154     if p-change-value > 0
     2155     then do:
     2156       if frame Dialog-Frame :width + p-change-value >
     2157           session :width-chars
     2158       then do:
     2159         assign
     2160           p-change-value = session :width-chars - frame Dialog-Frame :width
     2161         .
     2162         if p-change-value <= 0
     2163         then do:
     2164           run diasize_position-resize-button in this-procedure .
     2165           return .
     2166         end.
     2167       end.
     2168     end.
     2169     if p-change-value < 0
     2170     then do:
     2171       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2172       then do:
     2173         assign
     2174           p-change-value = v-diasize-orig-frame-width
     2175                          - frame Dialog-Frame :width
     2176         .
     2177         if p-change-value >= 0
     2178         then do:
     2179           run diasize_position-resize-button in this-procedure .
     2180           return .
     2181         end.
     2182       end.
     2183     end.
     2184     if p-change-value >= 0
     2185     then do:
     2186       assign
     2187         v-change-sign = 1
     2188       .
     2189     end.
     2190     else do:
     2191       assign
     2192         v-change-sign = -1
     2193       .
     2194     end.
     2195     assign
     2196       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2197     .
     2198     if p-change-value = 0
     2199     then do:
     2200       run diasize_position-resize-button in this-procedure .
     2201       return .
     2202     end.
     2203     move_block:
     2204     do
     2205     on error undo move_block, leave move_block
     2206     :
     2207       if retry
     2208       then do:
     2209         do
     2210         on error undo move_block, leave move_block
     2211         :
     2212           if p-change-value > 0
     2213           then do:
     2214             for each buf_temp-diasize-handle
     2215             on error undo, next
     2216             :
     2217               assign
     2218                 v-object-handle = buf_temp-diasize-handle.handle-value
     2219               .
     2220               if v-object-handle <> v-diasize-resize-button
     2221               then do:
     2222                 assign
     2223                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2224                 .
     2225               end.
     2226             end.
     2227             assign
     2228               v-diasize-browse-handle :width = v-browse-width
     2229             .
     2230             for each buf_temp-browse-handle
     2231               where buf_temp-browse-handle.browse-type = 'width':u
     2232             on error undo, next
     2233             :
     2234               assign
     2235                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2236               .
     2237             end.
     2238             assign
     2239               frame Dialog-Frame :width = v-frame-width
     2240             .
     2241             if frame Dialog-Frame :scrollable = true
     2242             then do:
     2243               assign
     2244                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2245               .
     2246             end.
     2247             run diasize_position-resize-button in this-procedure .
     2248           end.
     2249           else do:
     2250             if frame Dialog-Frame :scrollable = true
     2251             then do:
     2252               assign
     2253                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2254               .
     2255             end.
     2256             assign
     2257               frame Dialog-Frame :width = v-frame-width
     2258             .
     2259             for each buf_temp-browse-handle
     2260               where buf_temp-browse-handle.browse-type = 'width':u
     2261             on error undo, next
     2262             :
     2263               assign
     2264                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2265               .
     2266             end.
     2267             assign
     2268               v-diasize-browse-handle :width = v-browse-width
     2269             .
     2270             for each buf_temp-diasize-handle
     2271             on error undo, next
     2272             :
     2273               assign
     2274                 v-object-handle = buf_temp-diasize-handle.handle-value
     2275               .
     2276               if v-object-handle <> v-diasize-resize-button
     2277               then do:
     2278                 assign
     2279                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2280                 .
     2281               end.
     2282             end.
     2283             run diasize_position-resize-button in this-procedure .
     2284           end.
     2285           assign
     2286             v-diasize-change-size = false
     2287           .
     2288           leave move_block .
     2289         end.
     2290       end.
     2291       assign
     2292         v-diasize-need-full-display = true
     2293       .
     2294       if v-diasize-change-size = false
     2295       then do:
     2296         assign
     2297           v-diasize-change-size = true
     2298         .
     2299       end.
     2300       else do:
     2301         return .
     2302       end.
     2303       assign
     2304         v-frame-width = frame Dialog-Frame :width
     2305         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2306         v-browse-width = v-diasize-browse-handle :width
     2307       .
     2308       for each buf_temp-browse-handle
     2309         where buf_temp-browse-handle.browse-type = 'width':u
     2310       :
     2311         assign
     2312           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2313         .
     2314       end.
     2315       for each buf_temp-diasize-handle
     2316       :
     2317         delete buf_temp-diasize-handle .
     2318       end.
     2319       assign
     2320         v-field-group-handle = frame Dialog-Frame :first-child
     2321       .
     2322       do while valid-handle(v-field-group-handle)
     2323       :
     2324         assign
     2325           v-object-handle = v-field-group-handle :first-child
     2326         .
     2327         do while valid-handle(v-object-handle)
     2328         :
     2329           if  v-object-handle <> v-diasize-browse-handle :handle
     2330           and v-object-handle <> v-diasize-resize-button
     2331           and can-query(v-object-handle, "row")
     2332           and can-query(v-object-handle, "height")
     2333           and ( v-object-handle :col + v-object-handle :width
     2334                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2335               )
     2336           then do:
     2337             find first buf_temp-browse-handle
     2338               where buf_temp-browse-handle.browse-type   = 'width':u
     2339                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2340               no-error .
     2341             if available buf_temp-browse-handle
     2342             then do:
     2343             end.
     2344             else do:
     2345               create buf_temp-diasize-handle .
     2346               assign
     2347                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2348                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2349               .
     2350             end.
     2351           end.
     2352           assign
     2353             v-object-handle = v-object-handle :next-sibling
     2354           .
     2355         end.
     2356         assign
     2357           v-field-group-handle = v-field-group-handle :next-sibling
     2358         .
     2359       end.
     2360       do with frame Dialog-Frame
     2361       :
     2362         hide v-diasize-resize-button .
     2363         v-diasize-resize-button :row = 1.
     2364         v-diasize-resize-button :column = 1.
     2365       end.
     2366       if p-change-value > 0
     2367       then do:
     2368         if frame Dialog-Frame :scrollable = true
     2369         then do:
     2370           assign
     2371             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2372             no-error .
     2373           if error-status :error
     2374           or error-status :get-message(1) <> ""
     2375           then do:
     2376             undo move_block, retry move_block.
     2377           end.
     2378         end.
     2379         assign
     2380           frame Dialog-Frame :width = v-frame-width + p-change-value
     2381           no-error .
     2382         if error-status :error
     2383         or error-status :get-message(1) <> ""
     2384         then do:
     2385           undo move_block, retry move_block.
     2386         end.
     2387         assign
     2388           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2389         no-error .
     2390         if error-status :error
     2391         or error-status :get-message(1) <> ""
     2392         then do:
     2393           undo move_block, retry move_block.
     2394         end.
     2395         for each buf_temp-browse-handle
     2396           where buf_temp-browse-handle.browse-type = 'width':u
     2397         on error undo move_block, retry move_block
     2398         :
     2399           assign
     2400             buf_temp-browse-handle.browse-handle :width
     2401               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2402             no-error .
     2403           if error-status :error
     2404           or error-status :get-message(1) <> ""
     2405           then do:
     2406             undo move_block, retry move_block .
     2407           end.
     2408         end.
     2409         for each buf_temp-diasize-handle
     2410         on error undo move_block, retry move_block
     2411         :
     2412           assign
     2413             v-object-handle = buf_temp-diasize-handle.handle-value
     2414           .
     2415           if v-object-handle <> v-diasize-resize-button
     2416           then do:
     2417             assign
     2418               v-object-handle :col = v-object-handle :col + p-change-value
     2419               no-error .
     2420             if error-status :error
     2421             or error-status :get-message(1) <> ""
     2422             then do:
     2423               undo move_block, retry move_block .
     2424             end.
     2425           end.
     2426         end.
     2427       end.
     2428       else do:
     2429         for each buf_temp-diasize-handle
     2430         on error undo move_block, retry move_block
     2431         :
     2432           assign
     2433             v-object-handle = buf_temp-diasize-handle.handle-value
     2434           .
     2435           if v-object-handle <> v-diasize-resize-button
     2436           then do:
     2437             assign
     2438               v-object-handle :col = v-object-handle :col + p-change-value
     2439               no-error .
     2440             if error-status :error
     2441             or error-status :get-message(1) <> ""
     2442             then do:
     2443               undo move_block, retry move_block .
     2444             end.
     2445           end.
     2446         end.
     2447         for each buf_temp-browse-handle
     2448           where buf_temp-browse-handle.browse-type = 'width':u
     2449         on error undo move_block, retry move_block
     2450         :
     2451           assign
     2452             buf_temp-browse-handle.browse-handle :width
     2453               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2454             no-error .
     2455           if error-status :error
     2456           or error-status :get-message(1) <> ""
     2457           then do:
     2458             undo move_block, retry move_block .
     2459           end.
     2460         end.
     2461         assign
     2462           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2463           no-error .
     2464         if error-status :error
     2465         or error-status :get-message(1) <> ""
     2466         then do:
     2467           undo move_block, retry move_block.
     2468         end.
     2469         assign
     2470           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2471         no-error .
     2472         if error-status :error
     2473         or error-status :get-message(1) <> ""
     2474         then do:
     2475           undo move_block, retry move_block.
     2476         end.
     2477         if frame Dialog-Frame :scrollable = true
     2478         then do:
     2479           assign
     2480             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2481           no-error .
     2482           if error-status :error
     2483           or error-status :get-message(1) <> ""
     2484           then do:
     2485             undo move_block, retry move_block.
     2486           end.
     2487         end.
     2488       end.
     2489       if p-move-resize
     2490       then do:
     2491         run diasize_position-resize-button in this-procedure .
     2492       end.
     2493       if v-diasize-wndstore = true
     2494       then do:
     2495         if connected("ub") = true
     2496         then do:
     2497           define variable v-cntxt-db-num        as integer   no-undo .
     2498           define variable v-cntxt-userid        as character no-undo .
     2499           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2500                                             , OUTPUT v-cntxt-userid
     2501                                             ) .
     2502           run gbl/wndsizew.p
     2503             (input  v-cntxt-db-num
     2504             ,input  v-cntxt-userid
     2505             ,input  v-diasize-proc-name
     2506             ,input  'width':u
     2507             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2508             ) .
     2509         end.
     2510       end.
     2511     end.
     2512     assign
     2513       v-diasize-change-size = false
     2514     .
     2515   end procedure.
     2516   procedure diasize_set-width :
     2517     define input  parameter p-new-width  as decimal   no-undo .
     2518     define input  parameter p-move-resize as logical   no-undo .
     2519     do
     2520     on error undo, return error return-value
     2521     :
     2522       run diasize_change-width in this-procedure
     2523         (input  (p-new-width - frame Dialog-Frame :width)
     2524         ,input  p-move-resize
     2525         ) .
     2526     end.
     2527   end procedure.
     2528   procedure diasize_position-resize-button :
     2529     do with frame Dialog-Frame
     2530     :
     2531       hide v-diasize-resize-button .
     2532       assign
     2533         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2534                     - 1
     2535                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2536         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2537                     - 1
     2538                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2539       .
     2540       view v-diasize-resize-button .
     2541     end.
     2542   end procedure.
     2543   on alt-right anywhere
     2544   do:
     2545     run diasize_change-width in this-procedure
     2546       (input 1
     2547       ,input true
     2548       ) .
     2549     return no-apply .
     2550   end.
     2551   on alt-left anywhere
     2552   do:
     2553     run diasize_change-width in this-procedure
     2554       (input -1
     2555       ,input true
     2556       ) .
     2557     return no-apply .
     2558   end.
     2559   on alt-down anywhere
     2560   do:
     2561     run diasize_change-height in this-procedure
     2562       (input 1
     2563       ,input true
     2564       ) .
     2565     return no-apply .
     2566   end.
     2567   on alt-up anywhere
     2568   do:
     2569     run diasize_change-height in this-procedure
     2570       (input -1
     2571       ,input true
     2572       ) .
     2573     return no-apply .
     2574   end.
     2575   on alt-enter of frame Dialog-Frame
     2576   do:
     2577     run diasize_maximize in this-procedure
     2578       (input  ?
     2579       ).
     2580     return no-apply .
     2581   end.
     2582   procedure diasize_end-move :
     2583     do
     2584     on error undo, return error return-value
     2585     :
     2586       define variable v-row-delta as decimal   no-undo .
     2587       define variable v-col-delta as decimal   no-undo .
     2588       define variable v-new-row as decimal   no-undo .
     2589       define variable v-new-col as decimal   no-undo .
     2590       assign
     2591         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2592         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2593       .
     2594       assign
     2595         v-row-delta = v-new-row - frame Dialog-Frame :height
     2596         v-col-delta = v-new-col - frame Dialog-Frame :width
     2597       .
     2598       run diasize_change-height in this-procedure
     2599         (input v-row-delta
     2600         ,input true
     2601         ) .
     2602       run diasize_change-width in this-procedure
     2603         (input v-col-delta
     2604         ,input true
     2605         ) .
     2606     end.
     2607   end procedure.
     2608   procedure diasize_maximize :
     2609     define input  parameter p-action as logical   no-undo .
     2610     do
     2611     on error undo, return error return-value
     2612     :
     2613       if p-action = ?
     2614       then do:
     2615         if v-diasize-need-maximize = true
     2616         then do:
     2617           assign
     2618             p-action = true
     2619           .
     2620         end.
     2621         else do:
     2622           assign
     2623             p-action = false
     2624           .
     2625         end.
     2626       end.
     2627       if p-action = true
     2628       then do:
     2629         run diasize_change-height in this-procedure
     2630           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2631               - frame Dialog-Frame :height-chars
     2632           ,input true
     2633           ) .
     2634         run diasize_change-width in this-procedure
     2635           (input session :width-chars
     2636               - frame Dialog-Frame :width-chars
     2637           ,input true
     2638           ) .
     2639         assign
     2640           v-diasize-need-maximize = false
     2641         .
     2642       end.
     2643       else do:
     2644         run diasize_change-width in this-procedure
     2645           (input v-diasize-orig-frame-width
     2646               - frame Dialog-Frame :width-chars
     2647           ,input true
     2648           ) .
     2649         run diasize_change-height in this-procedure
     2650           (input v-diasize-orig-frame-height
     2651               - frame Dialog-Frame :height-chars
     2652           ,input true
     2653           ) .
     2654         assign
     2655           v-diasize-need-maximize = true
     2656         .
     2657       end.
     2658     end.
     2659   end procedure.
     2660   procedure diasize_restore-orig-size :
     2661     do
     2662     on error undo, return error return-value
     2663     :
     2664       assign
     2665         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2666         v-diasize-current-frame-height = frame Dialog-Frame :height
     2667       .
     2668       run diasize_set-height in this-procedure
     2669         (input  v-diasize-orig-frame-height
     2670         ,input  true
     2671         ) .
     2672       run diasize_set-width in this-procedure
     2673         (input  v-diasize-orig-frame-width
     2674         ,input  true
     2675         ) .
     2676     end.
     2677   end procedure.
     2678   procedure diasize_restore-current-size :
     2679     do
     2680     on error undo, return error return-value
     2681     :
     2682       run diasize_set-height in this-procedure
     2683         (input  v-diasize-current-frame-height
     2684         ,input  true
     2685         ) .
     2686       run diasize_set-width in this-procedure
     2687         (input  v-diasize-current-frame-width
     2688         ,input  true
     2689         ) .
     2690     end.
     2691   end procedure.
     2692   procedure diasize_set-browse-handle :
     2693     define input  parameter p-browse-handle as handle   no-undo .
     2694     define buffer buf_temp-browse-handle for temp-browse-handle .
     2695     do
     2696     on error undo, return error return-value
     2697     :
     2698       assign
     2699         v-diasize-browse-handle = p-browse-handle
     2700       .
     2701       for each buf_temp-browse-handle
     2702       on error undo, return error return-value
     2703       :
     2704         delete buf_temp-browse-handle .
     2705       end.
     2706     end.
     2707   end procedure.
     2708   procedure diasize_add_browse :
     2709     define input  parameter p-browse-type   as character no-undo .
     2710     define input  parameter p-browse-handle as handle    no-undo .
     2711     define buffer buf_temp-browse-handle for temp-browse-handle .
     2712     do
     2713     on error undo, return error return-value
     2714     :
     2715       assign
     2716         v-diasize-browse-number = v-diasize-browse-number + 1
     2717       .
     2718       create buf_temp-browse-handle .
     2719       assign
     2720         buf_temp-browse-handle.browse-type   = p-browse-type
     2721         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2722         buf_temp-browse-handle.browse-handle = p-browse-handle
     2723       .
     2724     end.
     2725   end procedure.
     2726   procedure diasize_init :
     2727     define variable v-default-value    as logical   no-undo .
     2728     define variable v-restore-saved    as logical   no-undo .
     2729     define variable v-resize-value-str as character no-undo .
     2730     do
     2731     on error undo, return error return-value
     2732     :
     2733       do with frame Dialog-Frame
     2734       :
     2735         assign
     2736           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2737           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2738           v-diasize-browse-handle     = browse BR-bank :handle
     2739         .
     2740         create button v-diasize-resize-button
     2741         assign
     2742           parent        = frame Dialog-Frame :first-child
     2743           label         = "s"
     2744           height-pixels = 16
     2745           width-pixels  = 16
     2746           visible       = true
     2747           sensitive     = true
     2748           movable       = true
     2749           triggers:
     2750             on end-move persistent run diasize_end-move in this-procedure .
     2751           end triggers.
     2752         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2753         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2754         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2755         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2756         assign
     2757           v-diasize-wndmax = false
     2758         .
     2759         if connected("ub") = true
     2760         then do:
     2761           define variable v-cntxt-db-num        as integer   no-undo .
     2762           define variable v-cntxt-userid        as character no-undo .
     2763           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2764                                             , OUTPUT v-cntxt-userid
     2765                                             ) .
     2766           run gbl/wndpar_r.p
     2767             (input  v-cntxt-db-num
     2768             ,input  v-cntxt-userid
     2769             ,input  'wndmax':U
     2770             ,output v-diasize-wndmax
     2771             ,output v-default-value
     2772             ) .
     2773         end.
     2774         assign
     2775           v-diasize-wndstore = false
     2776         .
     2777         if connected("ub") = true
     2778         then do:
     2779           run gbl/wndpar_r.p
     2780             (input  v-cntxt-db-num
     2781             ,input  v-cntxt-userid
     2782             ,input  'wndstore':U
     2783             ,output v-diasize-wndstore
     2784             ,output v-default-value
     2785             ) .
     2786         end.
     2787         assign
     2788           v-diasize-proc-name = entry(1, program-name(2), '.')
     2789         .
     2790         if v-diasize-wndstore = true
     2791         then do:
     2792           assign
     2793             v-restore-saved = false
     2794           .
     2795           if connected("ub") = true
     2796           then do:
     2797             run gbl/wndsizer.p
     2798               (input  v-cntxt-db-num
     2799               ,input  v-cntxt-userid
     2800               ,input  v-diasize-proc-name
     2801               ,input  'height':u
     2802               ,output v-resize-value-str
     2803               ) .
     2804             if v-resize-value-str <> '':U
     2805             then do:
     2806               run diasize_change-height in this-procedure
     2807                 (input  integer(v-resize-value-str)
     2808                 ,input  true
     2809                 ) .
     2810               assign
     2811                 v-restore-saved = true
     2812               .
     2813             end.
     2814           end.
     2815           if connected("ub") = true
     2816           then do:
     2817             run gbl/wndsizer.p
     2818               (input  v-cntxt-db-num
     2819               ,input  v-cntxt-userid
     2820               ,input  v-diasize-proc-name
     2821               ,input  'width':u
     2822               ,output v-resize-value-str
     2823               ) .
     2824             if v-resize-value-str <> '':U
     2825             then do:
     2826               run diasize_change-width in this-procedure
     2827                 (input  integer(v-resize-value-str)
     2828                 ,input  true
     2829                 ) .
     2830               assign
     2831                 v-restore-saved = true
     2832               .
     2833             end.
     2834           end.
     2835           if v-restore-saved <> true
     2836           then do:
     2837             if v-diasize-wndmax = true
     2838             then do:
     2839               run diasize_maximize in this-procedure
     2840                 (input  true
     2841                 ) .
     2842             end.
     2843           end.
     2844         end.
     2845         else do:
     2846           if v-diasize-wndmax = true
     2847           then do:
     2848             run diasize_maximize in this-procedure
     2849               (input  true
     2850               ) .
     2851           end.
     2852         end.
     2853       end.
     2854     end.
     2855   end procedure.
     2856   procedure diasize_need-full-display :
     2857     define output parameter p-need-full-display as logical   no-undo .
     2858     do
     2859     on error undo, return error return-value
     2860     :
     2861       assign
     2862         p-need-full-display = v-diasize-need-full-display
     2863       .
     2864       assign
     2865         v-diasize-need-full-display = false
     2866       .
     2867     end.
     2868   end procedure.
     2869   procedure get-context :
     2870      define output parameter p-db-num as integer          no-undo.
     2871      define output parameter p-user-id as character        no-undo.
     2872      define variable v-login               as character    no-undo.
     2873      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2874      define buffer buf_user-login  for ub.user-login .
     2875      do
     2876      on error undo, return error
     2877      :
     2878            FIND FIRST buf_sys-ctrl no-lock.
     2879            ASSIGN
     2880               v-login = USERID("ub")
     2881               p-db-num = buf_sys-ctrl.db-num
     2882            .
     2883            FIND FIRST buf_user-login
     2884                 WHERE buf_user-login.db-num = p-db-num
     2885                   AND buf_user-login.user-login = v-login
     2886                 no-lock
     2887                 no-error
     2888                 .
     2889            IF AVAILABLE buf_user-login
     2890            THEN DO:
     2891               assign
     2892                  p-user-id = buf_user-login.user-id
     2893               .
     2894            END.
     2895      end.
     2896   end procedure.
     2897   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2898   on f5 of frame Dialog-Frame anywhere
     2899   do:
     2900     v-doc-rec = recid(X_c-fin-bank). run OpenBr in this-procedure ( input yes, input no, input '':U). reposition br-bank to recid v-doc-rec no-error. v-doc-rec = ?.
     2901       apply "VALUE-CHANGED" to BR-bank.
