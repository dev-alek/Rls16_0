     3266   PROCEDURE OpenBr :
     3267   define input  parameter p-open-query     as logical   no-undo .
     3268   define input  parameter p-find-next      as logical   no-undo .
     3269   define input  parameter p-find-condition as character no-undo .
     3270   define variable l-query-was-opened as logical no-undo .
     3271   define variable title0 as character no-undo.
     3272   title0 = "Список истории изменения банков" + chr(32).
     3273   run waitfram-show in this-procedure ( input "Ждите...").
     3274   define variable sort-column-phrase as character no-undo .
     3275   case sort-column-name :
     3276     when "" then do:
     3277       assign
     3278         sort-column-phrase = ""
     3279       .
     3280     end.
     3281     otherwise do:
     3282       assign
     3283         sort-column-phrase = "by " + sort-column-name
     3284       .
     3285     end.
     3286   end case.
     3287   define variable l-open-query as logical   no-undo .
     3288     CASE p-mode :
     3289       WHEN 'все':U        THEN DO:
     3290        assign
     3291        filter-point = filter-point0 + p-mode
     3292        filter-label = substitute("&1", filter-label0)
     3293        .
     3294   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3295   define variable  l-disable-where-28  as logical   no-undo .
     3296   define variable  l-filter-open-28    as logical   .
     3297   define variable  flt-rec-28       as recid     no-undo .
     3298   define variable  filter-name-28      as character no-undo .
     3299   define variable  where-phrase-28     as character no-undo .
     3300   define variable  sort-phrase-28      as character no-undo .
     3301   define variable  where-phrase-rus-28 as character no-undo .
     3302   define variable  sort-phrase-rus-28  as character no-undo .
     3303     run waitfram-show in this-procedure
     3304       (input "ЖДИТЕ ..."
     3305       ).
     3306   run gbl/flt-get.p
     3307     (input filter-point
     3308     ,output flt-rec-28
     3309     ,output filter-name-28
     3310     ,output where-phrase-28
     3311     ,output sort-phrase-28
     3312     ,output where-phrase-rus-28
     3313     ,output sort-phrase-rus-28
     3314     ).
     3315   if p-open-query then do:
     3316       run set-filter-name in this-procedure
     3317         (INPUT filter-name-28
     3318         ) no-error .
     3319     assign
     3320       l-filter-open-28 = false
     3321     .
     3322     if flt-rec-28 <> ?
     3323       or sort-column-phrase > ""
     3324     then do:
     3325       define variable  parameter-2-28 as character no-undo .
     3326       define variable  parameter-3-28 as character no-undo .
     3327       define variable  parameter-4-28 as character no-undo .
     3328       define variable  parameter-5-28 as character no-undo .
     3329       define variable  parameter-6-28 as character no-undo .
     3330       define variable  parameter-7-28 as character no-undo .
     3331         assign
     3332         parameter-3-28 =
     3333                                 "FOR EACH X_c-fin-bank"
     3334         parameter-4-28 =
     3335           (
     3336             if (" TRUE " + " " + where-phrase-28) <> ""
     3337             then " TRUE " + " " + where-phrase-28
     3338             else "true"
     3339           )
     3340         parameter-5-28 = (" " + "" + " " + "")
     3341         parameter-6-28 = if sort-phrase-28 = ''
     3342                              then
     3343           (
     3344           " " + "  " +
     3345             " " + sort-column-phrase +
     3346           " " + "  "
     3347           )
     3348                              else
     3349           (
     3350           " " + "  " +
     3351             " " + sort-column-phrase +
     3352           " " + sort-phrase-28
     3353           )
     3354         parameter-7-28 =
     3355           " indexed-reposition  "
     3356       .
     3357       do
     3358       on stop undo, leave
     3359       on error undo, leave
     3360       :
     3361         assign
     3362           l-disable-where-28 =
     3363             (" TRUE " + " " + where-phrase-28 = "")
     3364         .
     3365         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3366                             ,input QUERY br-bank:handle
     3367                             ,input parameter-3-28
     3368                             ,input parameter-4-28
     3369                             ,input parameter-5-28
     3370                             ,input parameter-6-28
     3371                             ,input parameter-7-28
     3372                             )
     3373         .
     3374         assign
     3375           l-filter-open-28 = true
     3376         .
     3377       end.
     3378       if l-filter-open-28 = false then do:
     3379         message
     3380           "Ошибка при фильтрации / сортировке" skip
     3381           "Будут показаны записи без учета фильтра" skip
     3382           view-as alert-box .
     3383       end.
     3384       else do:
     3385           assign
     3386             l-query-was-opened = true
     3387           .
     3388       end.
     3389     end.
     3390     if l-filter-open-28 = false then do:
     3391       OPEN QUERY br-bank FOR EACH X_c-fin-bank
     3392         where  TRUE
     3393         indexed-reposition
     3394     .
     3395         assign
     3396           l-query-was-opened = true
     3397         .
     3398     end.
     3399   end.
     3400   else do:
     3401     assign
     3402       v-doc-rec = recid( X_c-fin-bank )
     3403     .
     3404     do
     3405     on stop undo, leave
     3406     on error undo, leave
     3407     :
     3408       if QUERY br-bank:handle:get-buffer-handle(1) = (buffer X_c-fin-bank:handle) then do:
     3409         assign
     3410         parameter-2-28 = (if p-find-next then "true":u else "false":u )
     3411         parameter-4-28 =
     3412           "where ":u + " TRUE " + " ":u + where-phrase-28 + " ":u + p-find-condition + " " + ""
     3413         parameter-5-28 = "  "
     3414       .
     3415         run fltopend_fltfindd in this-procedure  (
     3416                             input this-procedure:handle
     3417                             ,input QUERY br-bank:handle
     3418                             ,input rowid(X_c-fin-bank)
     3419                             ,input logical(parameter-2-28)
     3420                             ,input no-lock
     3421                             ,input (buffer X_c-fin-bank:handle)
     3422                             ,input parameter-4-28
     3423                             ,input parameter-5-28
     3424                             ) no-error.
     3425         .
     3426         assign
     3427           v-doc-rec = integer(return-value)
     3428           v-fltopend-rowid[1] = ?
     3429         .
     3430       end.
     3431       else do:
     3432         assign
     3433         parameter-2-28 = (if p-find-next then "true":u else "false":u )
     3434         parameter-3-28 =  "FOR EACH X_c-fin-bank"
     3435         parameter-4-28 =
     3436           (
     3437             if (" TRUE " + " " + where-phrase-28) <> ""
     3438             then " TRUE " + " " + where-phrase-28
     3439             else "true"
     3440           )
     3441         parameter-5-28 = (" " + "" + " " + "" + " " + p-find-condition)
     3442         parameter-6-28 = if sort-phrase-28 = ''
     3443                              then
     3444           (
     3445           " " + "  " +
     3446             " " + sort-column-phrase +
     3447           " " + "  "
     3448           )
     3449                              else
     3450           (
     3451           " " + "  " +
     3452             " " + sort-column-phrase +
     3453           " " + sort-phrase-28
     3454           )
     3455         parameter-7-28 =
     3456           " indexed-reposition  "
     3457       .
     3458         run fltopend_fltfindq in this-procedure  (
     3459                             input this-procedure:handle
     3460                             ,input QUERY br-bank:handle
     3461                             ,input logical(parameter-2-28)
     3462                             ,input no-lock
     3463                             ,input parameter-3-28
     3464                             ,input parameter-4-28
     3465                             ,input parameter-5-28
     3466                             ,input parameter-6-28
     3467                             ,input parameter-7-28
     3468                             ,output v-fltopend-rowid
     3469                             ) no-error.
     3470         .
     3471         v-doc-rec = ?.
     3472       end.
     3473       assign
     3474         l-query-was-opened = true
     3475       .
     3476     end.
     3477   end.
     3478     run waitfram-hide in this-procedure .
     3479       END.
     3480       WHEN 'фирма':U THEN DO:
     3481         assign
     3482         filter-point = filter-point0 + p-mode
     3483         filter-label = substitute("&1 Одна фирма", filter-label0)
     3484         .
