     3947                       , INPUT tbl
     3948                       , INPUT join-tbl
     3949                       , INPUT fld
     3950                       , INPUT lab
     3951                       , INPUT spr
     3952                       , INPUT dim ).
     3953     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     3954   END.
     3955   END PROCEDURE.
     3956   PROCEDURE proc-br-bank :
     3957   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3958   if b-sel:sensitive in frame Dialog-Frame then dO:
     3959       if b-mark:sensitive then do:
     3960           apply "choose" to b-mark in frame Dialog-Frame.
     3961       end.
     3962       else do:
     3963           apply "choose" to b-sel in frame Dialog-Frame.
     3964       end.
     3965   end.
     3966   else do:
     3967       if b-lkp:sensitive then
     3968       apply "choose" to b-lkp in frame Dialog-Frame.
     3969   end.
     3970   END PROCEDURE.
     3971   PROCEDURE proc-find-bik :
     3972   define input parameter p-next as logical no-undo.
     3973   define input parameter p-bik like ub.fin-bank.bik no-undo.
     3974   display
     3975   "0":U @ sch-code
     3976   with frame Dialog-Frame.
     3977   assign
     3978   p-bik = replace(p-bik, chr(34), "":U)
     3979   p-bik = replace(p-bik, chr(39), chr(39) + chr(39))
     3980   p-bik = chr(34) + p-bik + chr(34).
     3981   run OpenBr in this-procedure
     3982       (input false
     3983       ,input p-next
     3984       ,input substitute("and X_c-fin-bank.bik   begins &1 "
     3985         , p-bik)
     3986       ).
     3987   apply "entry":u to sch-bik in frame Dialog-Frame .
     3988   END PROCEDURE.
     3989   PROCEDURE proc-find-code :
     3990   define input parameter p-next as logical no-undo.
     3991   define input parameter p-code-bank like ub.fin-bank.code-bank no-undo.
     3992   define variable v-code-bank as character no-undo.
     3993   display
     3994   "":U @ sch-BIK
     3995   with frame Dialog-Frame.
     3996   assign
     3997   v-code-bank = string(p-code-bank).
     3998   run OpenBr in this-procedure
     3999       (input false
     4000       ,input p-next
     4001       ,input substitute("and X_c-fin-bank.code-bank = &1 "
     4002         , v-code-bank)
     4003       ).
     4004   apply "entry":u to sch-code in frame Dialog-Frame .
     4005   END PROCEDURE.
     4006   PROCEDURE proc-find-name :
     4007   define input parameter p-next as logical no-undo.
     4008   define input parameter p-name as character no-undo.
     4009   display
     4010   "0":U @ sch-code
     4011   "":U @ sch-bik
     4012   with frame Dialog-Frame.
     4013   assign
     4014   p-name = replace(p-name, chr(34), chr(34) + chr(34))
     4015   p-name = replace(p-name, chr(39), chr(39) + chr(39))
     4016   p-name = chr(34) + p-name + chr(34).
     4017   run OpenBr in this-procedure
     4018       (input false
     4019       ,input p-next
     4020       ,input substitute("and X_c-fin-bank.bank-name   begins &1 "
     4021         , p-name)
     4022       ).
     4023   apply "entry":u to sch-name in frame Dialog-Frame .
     4024   END PROCEDURE.
     4025   PROCEDURE proc-view-changes :
     4026   for each temp-changes:
     4027       delete temp-changes.
     4028   END.
     4029   if not available X_c-fin-bank then do:
     4030     Open QUery br-changes for each temp-changes.
     4031     return.
     4032   end.
     4033   define variable v-label-param as character no-undo .
     4034   v-label-param =
     4035     "addres" + chr(4) + "Адрес юридический" + chr(4) + "" + chr(8)
     4036    + "addres1" + chr(4) + "Адрес почтовый" + chr(4) + "" + chr(8)
     4037    + "bank-name" + chr(4) + "Название" + chr(4) + "" + chr(8)
     4038    + "bank-city" + chr(4) + "Город" + chr(4) + "" + chr(8)
     4039    + "cl-bank" + chr(4) + "Система Клиент-Банк" + chr(4) + "" + chr(8)
     4040    + "bik" + chr(4) + "БИК" + chr(4) + "" + chr(8)
     4041    + "code-bank" + chr(4) + "Код банка" + chr(4) + "" + chr(8)
     4042    + "cor-acc" + chr(4) + "№ Корр.счета" + chr(4) + "" + chr(8)
     4043    + "rkc" + chr(4) + "РКЦ" + chr(4) + "" + chr(8)
     4044    + "e-mail" + chr(4) + "E-mail" + chr(4) + "" + chr(8)
     4045    + "fax" + chr(4) + "Факс" + chr(4) + "" + chr(8)
     4046    + "host-code" + chr(4) + "Код фирмы" + chr(4) + "" + chr(8)
     4047    + "inn" + chr(4) + "ИНН" + chr(4) + "" + chr(8)
     4048    + "kpp" + chr(4) + "КПП" + chr(4) + "" + chr(8)
     4049    + "licenz" + chr(4) + "Лицензия" + chr(4) + "" + chr(8)
     4050    + "okato" + chr(4) + "ОКАТО" + chr(4) + "" + chr(8)
     4051    + "okonx" + chr(4) + "ОКОНХ" + chr(4) + "" + chr(8)
     4052    + "okpo" + chr(4) + "ОКПО" + chr(4) + "" + chr(8)
     4053    + "otdel" + chr(4) + "Отделение" + chr(4) + "" + chr(8)
     4054    + "phone" + chr(4) + "Телефон" + chr(4) + "" + chr(8)
     4055    + "PS" + chr(4) + "Примечания" + chr(4) + "" + chr(8)
     4056    + "short-name" + chr(4) + "Укороченное название" + chr(4) + "" + chr(8)
     4057    + "status_" + chr(4) + "Статус" + chr(4) + ""  .
     4058    run proc-full-temp-changes in this-procedure (
     4059                                                input  buffer X_c-fin-bank:handle
     4060                                               ,input  'fin-bank':U
     4061                                               ,input  "addres,addres1,bank-name,bank-city,cl-bank,bik,code-bank,cor-acc,rkc,e-mail,fax,host-code,inn,kpp,licenz,okato,okonx,okpo,otdel,phone,PS,short-name,status_"
     4062                                               ,input  v-label-param).
     4063   Open QUery br-changes for each temp-changes.
     4064   END PROCEDURE.
