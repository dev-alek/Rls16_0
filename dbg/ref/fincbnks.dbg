     2903   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2904   procedure set-filter-name :
     2905   define input parameter p-filter-name as character no-undo .
     2906     do with frame Dialog-Frame:
     2907       if p-filter-name > "" then do:
     2908         assign
     2909           frame Dialog-Frame:title
     2910             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2911         .
