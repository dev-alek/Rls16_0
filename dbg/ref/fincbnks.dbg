     3043   MAIN-BLOCK:
     3044   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3045      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3046    if p-mode <> 'все':U
     3047    and p-mode <> 'фирма':U
     3048    and p-mode <> "one":U
     3049    then dO:
     3050       message
     3051       vss-workfile vss-revision vss-description skip
     3052       "Неверное значение параметров вызова p-mode"
     3053       p-mode
     3054       view-as alert-box ERROR.
     3055       return.
     3056    end.
     3057   find first X_curr_sysconf no-lock where
     3058                   X_curr_sysconf.host-code = p-curr-host-code no-error.
     3059   if not available X_curr_sysconf then do:
     3060     message
     3061     vss-workfile vss-revision vss-description skip
     3062     "Неверное значение параметра вызова p-curr-host-code"
     3063     p-curr-host-code
     3064     view-as alert-box ERROR.
     3065     return.
     3066   end.
     3067    if p-mode = 'фирма':U then do:
     3068     find first X_clients no-lock where
     3069                   X_clients.obj-type = 'орг':U
     3070               and X_clients.obj-code = p-host-code no-error.
     3071       if not available X_clients then do:
     3072           message
     3073           vss-workfile vss-revision vss-description skip
     3074           "Неверное значение параметра вызова p-host-code"
     3075           p-curr-host-code
     3076           view-as alert-box ERROR.
     3077           return.
     3078       end.
     3079       find first X_sysconf no-lock where
     3080                       X_sysconf.host-code = p-host-code no-error.
     3081       if not available X_sysconf then do:
     3082         message
     3083         vss-workfile vss-revision vss-description skip
     3084         "Неверное значение параметра вызова p-host-code"
     3085         p-host-code
     3086         view-as alert-box ERROR.
     3087         return.
     3088       end.
     3089     end.
     3090    if p-mode = "one":U then do:
     3091     find first X_fin-bank no-lock where
     3092                   X_fin-bank.host-code = p-host-code
     3093               and X_fin-bank.code-bank = p-code-bank no-error.
     3094       if not available X_fin-bank then do:
     3095           message
     3096           vss-workfile vss-revision vss-description skip
     3097           "Неверное значение параметра вызова p-host-code и/или p-code-bank "
     3098           p-host-code p-code-bank
     3099           view-as alert-box ERROR.
     3100           return.
     3101       end.
     3102     end.
     3103     v-rid-list = p-rid-list.
     3104     if v-rid-list <> "" then do:
     3105         FIND FIRST find_c-fin-bank No-LOCK where
     3106                    recid(find_c-fin-bank) = integer(entry(1, v-rid-list)) No-ERROR.
     3107         if not avail find_c-fin-bank then do:
     3108           message
     3109           vss-workfile vss-revision vss-description skip
     3110           "Неверное значение параметра вызова v-rid-list" v-rid-list
     3111           view-as alert-box error .
     3112           return error.
     3113         end.
     3114         v-doc-rec = integer(entry(1, v-rid-list)).
     3115       end.
     3116   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3117   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     3118     (output v-db-num
     3119     )  .
     3120     RUN MyEnable in this-procedure .
     3121     RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     3122     HIDE mark-num in frame Dialog-Frame .
     3123     if v-rid-list <> "":U then
     3124     REPOSITION br-bank to recid integer(entry(1, v-rid-list)) No-ERROR.
     3125   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3126   DEF VAR cur-clmn-numbr-bank as INT EXTENT 9 no-undo.
     3127   DEF VAR varmvibr-bank       as INT no-undo.
     3128   DEF VAR varmvjbr-bank       as INT no-undo.
     3129   DEF VAR varmvkbr-bank       as INT no-undo.
     3130   DEF VAR varmvlbr-bank       as INT no-undo.
     3131   DEF VAR move-elementbr-bank as INT no-undo.
     3132   def var jjbr-bank           as int no-undo.
     3133   do varmvibr-bank = 1 to EXTENT(cur-clmn-numbr-bank):
     3134     ASSIGN cur-clmn-numbr-bank[varmvibr-bank] = varmvibr-bank.
     3135   END.
     3136   RUN start-mv-clmnbr-bank.
     3137   PROCEDURE start-mv-clmnbr-bank:
     3138   def var old-session as logical no-undo.
     3139      old-session = SESSION:IMMEDIATE-DISPLAY.
     3140      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3141          IF  p-mode = 'все':U  THEN DO:
     3142      DO jjbr-bank = NUM-ENTRIES('1,2,3,4,5,6,7,8,9') TO 1 BY -1:
     3143        RUN re-move-clmnbr-bank ( cur-clmn-numbr-bank[INTEGER(ENTRY (jjbr-bank, '1,2,3,4,5,6,7,8,9'))] , 1).
     3144      END.
     3145          END.
     3146          IF  p-mode = 'фирма':U  THEN DO:
     3147      DO jjbr-bank = NUM-ENTRIES('1,3,4,5,6,7,8,9,2') TO 1 BY -1:
     3148        RUN re-move-clmnbr-bank ( cur-clmn-numbr-bank[INTEGER(ENTRY (jjbr-bank, '1,3,4,5,6,7,8,9,2'))] , 1).
     3149      END.
     3150          END.
     3151          IF  p-mode = 'one':U  THEN DO:
     3152      DO jjbr-bank = NUM-ENTRIES('1,4,5,6,7,8,9,2,3') TO 1 BY -1:
     3153        RUN re-move-clmnbr-bank ( cur-clmn-numbr-bank[INTEGER(ENTRY (jjbr-bank, '1,4,5,6,7,8,9,2,3'))] , 1).
     3154      END.
     3155          END.
     3156      SESSION:IMMEDIATE-DISPLAY = old-session.
     3157   END.
     3158   ON ctrl-cursor-right OF BROWSE br-bank do:
     3159     RUN re-move-clmnbr-bank ( 1, 9).
     3160   END.
     3161   ON ctrl-cursor-left OF BROWSE br-bank do:
     3162     RUN re-move-clmnbr-bank (9, 1).
     3163   END.
     3164   PROCEDURE re-move-clmnbr-bank:
     3165     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3166     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3167     DO varmvibr-bank = 1 TO EXTENT(cur-clmn-numbr-bank):
     3168       if cur-clmn-numbr-bank[varmvibr-bank] = source-column THEN cur-clmn-numbr-bank[varmvibr-bank] = -1.
     3169     END.
     3170     if br-bank:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     3171     if source-column > target-column THEN
     3172     DO varmvjbr-bank = source-column - 1 to target-column BY -1:
     3173       DO varmvibr-bank = 1 TO EXTENT(cur-clmn-numbr-bank):
     3174           if cur-clmn-numbr-bank[varmvibr-bank] = varmvjbr-bank THEN DO:
     3175             cur-clmn-numbr-bank[varmvibr-bank] = cur-clmn-numbr-bank[varmvibr-bank] + 1.
     3176           END.
     3177       END.
     3178     END.
     3179     ELSE
     3180     DO varmvjbr-bank = source-column + 1 to target-column:
     3181       DO varmvibr-bank = 1 TO EXTENT(cur-clmn-numbr-bank):
     3182         if cur-clmn-numbr-bank[varmvibr-bank] = varmvjbr-bank THEN DO:
     3183           cur-clmn-numbr-bank[varmvibr-bank] = cur-clmn-numbr-bank[varmvibr-bank] - 1.
     3184         END.
     3185       END.
     3186     END.
     3187     DO varmvibr-bank = 1 TO EXTENT(cur-clmn-numbr-bank):
     3188       if cur-clmn-numbr-bank[varmvibr-bank] = -1 THEN cur-clmn-numbr-bank[varmvibr-bank] = target-column.
     3189     END.
     3190   END PROCEDURE.
     3191   PROCEDURE ch-clmnbr-bank:
     3192     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3193     if cur-clmn-loc <= 1 then do:
     3194       return .
     3195     end.
     3196     DO varmvibr-bank = 1 TO EXTENT(cur-clmn-numbr-bank):
     3197       if cur-clmn-numbr-bank[varmvibr-bank] = cur-clmn-loc THEN move-elementbr-bank = varmvibr-bank.
     3198     END.
     3199     RUN re-move-clmnbr-bank (cur-clmn-loc, 1).
     3200   END PROCEDURE.
     3201   PROCEDURE mv-brw-defaultbr-bank:
     3202   def var old-session as logical no-undo.
     3203     old-session = SESSION:IMMEDIATE-DISPLAY.
     3204     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3205     do varmvlbr-bank = 1 to EXTENT(cur-clmn-numbr-bank):
     3206       RUN re-move-clmnbr-bank (cur-clmn-numbr-bank[varmvlbr-bank], varmvlbr-bank).
     3207     END.
     3208     RUN start-mv-clmnbr-bank.
     3209     SESSION:IMMEDIATE-DISPLAY = old-session.
     3210   END PROCEDURE.
     3211   .
     3212     run diasize_add_browse in this-procedure
     3213       (input  'width':u
     3214       ,input  browse br-changes :handle
     3215       ) .
     3216     run diasize_init in this-procedure .
     3217     WAIT-FOR GO OF FRAME Dialog-Frame.
     3218   END.
     3219   RUN disable_UI.
     3220   PROCEDURE disable_UI :
     3221     HIDE FRAME Dialog-Frame.
     3222   END PROCEDURE.
     3223   PROCEDURE enable_UI :
     3224     DISPLAY ED-notes sch-code sch-BIK sch-name mark-num
     3225         WITH FRAME Dialog-Frame.
     3226     ENABLE b-quit B-mark b-sel b-lkp B-sch B-Help BR-bank ED-notes sch-code
     3227            sch-BIK sch-name BR-changes mark-num
     3228         WITH FRAME Dialog-Frame.
     3229     VIEW FRAME Dialog-Frame.
     3230   END PROCEDURE.
     3231   PROCEDURE MyEnable :
     3232   assign
     3233     br-bank:num-locked-columns in frame Dialog-Frame = 1
     3234     X_c-fin-bank.corr-date:read-only in browse br-bank = yes
     3235     temp-changes.l_name:resizable in browse br-changes = true
     3236     temp-changes.v_old:resizable in browse br-changes = true
     3237     temp-changes.v_new:resizable in browse br-changes = true
     3238     temp-changes.l_name:width in browse br-changes = 30
     3239     temp-changes.v_old:width in browse br-changes = 40
     3240     temp-changes.v_new:width in browse br-changes = 40
     3241     .
     3242     DISPLAY
     3243     ED-notes
     3244     sch-code
     3245     sch-BIK
     3246     sch-name
     3247     mark-num
     3248     br-changes
     3249     WITH FRAME Dialog-Frame.
     3250     ENABLE
     3251     b-quit
     3252     B-mark when lookup("b-mark":U, bttns) > 0
     3253     b-sel when lookup("b-sel":U, bttns) > 0
     3254     b-lkp
