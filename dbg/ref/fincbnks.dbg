      124   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125   define variable c-point  as character no-undo .
      126   define variable tbl      as character no-undo .
      127   define variable join-tbl as character no-undo .
      128   define variable fld      as character no-undo .
      129   define variable lab      as character no-undo .
      130   define variable spr      as character no-undo .
      131   define variable dim      as character no-undo .
      132   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133   procedure cur-time :
      134      define output parameter p-today as date      no-undo .
      135      define output parameter p-time  as integer   no-undo .
      136     do
      137     on error undo, return error
      138     :
      139       define variable v-date1 as date      no-undo .
      140       define variable v-date2 as date      no-undo .
      141       define variable v-time  as integer   no-undo .
      142       assign
      143         v-date1 = today
      144         v-time  = time
      145         v-date2 = today
      146       .
      147       if v-date1 <> v-date2
      148       then do:
      149         assign
      150           v-date1 = today
      151           v-time  = v-time
      152         .
      153       end.
      154       assign
      155         p-today = v-date1
      156         p-time  = v-time
      157       .
      158     end.
      159   end.
      160   function cur-time-date returns character
      161   :
      162     return string(today, '99/99/9999':U) .
      163   end.
      164   function cur-time-mjd returns decimal
      165   :
      166     define variable v-date as date      no-undo .
      167     define variable v-time as integer   no-undo .
      168     run cur-time in this-procedure
      169       (output v-date
      170       ,output v-time
      171       ) .
      172     return integer(v-date) - 2400002 + (v-time / 86400) .
      173   end.
      174   function cur-time-get-ending-index returns integer
      175   (input p-number as integer
      176   )
      177   :
      178     if p-number < 0
      179     or p-number = ?
      180     then do:
      181       return 1 .
      182     end.
      183     define variable v-rest as integer   no-undo .
      184     assign
      185       p-number = p-number modulo 100
      186     .
      187     if p-number < 20
      188     then do:
      189       assign
      190         v-rest = p-number
      191       .
      192     end.
      193     else do:
      194       assign
      195         v-rest = p-number modulo 10
      196       .
      197     end.
      198     case v-rest :
      199       when 1
      200       then do:
      201         return 2 .
      202       end.
      203       when 2 or
      204       when 3 or
      205       when 4
      206       then do:
      207         return 3 .
      208       end.
      209       otherwise do:
      210         return 1 .
      211       end.
      212     end case .
      213   end.
      214   procedure cur-time-mjd-to-date :
      215      define input  parameter i-mjd-diff as decimal no-undo.
      216      define output parameter o-Date     as date    no-undo.
      217      define output parameter o-Time     as integer no-undo.
      218      define variable v-day-number as integer   no-undo .
      219      if    i-mjd-diff < 0
      220         or i-mjd-diff = ?
      221      then do:
      222         return "?" .
      223      end.
      224      assign
      225         v-day-number = truncate(i-mjd-diff,0).
      226         o-Date = date(v-day-number + 2400002).
      227         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      228     .
      229   end.
      230   function cur-time-mjd-to-string returns character
      231   (input p-mjd-diff as decimal
      232   )
      233   :
      234     define variable v-day-number as integer   no-undo .
      235     define variable v-seconds    as integer   no-undo .
      236     define variable v-hour       as integer   no-undo .
      237     define variable v-min        as integer   no-undo .
      238     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      239     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      240     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      241     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      242     if p-mjd-diff < 0
      243     or p-mjd-diff = ?
      244     then do:
      245       return "?" .
      246     end.
      247     assign
      248       v-day-number = integer(truncate(p-mjd-diff,0))
      249       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      250     .
      251     if v-seconds > 86400
      252     then do:
      253       assign
      254         v-seconds = 86400 - 1
      255       .
      256     end.
      257     if v-seconds < 0
      258     then do:
      259       assign
      260         v-seconds = 0
      261       .
      262     end.
      263     assign
      264       v-hour = truncate(v-seconds / 3600, 0)
      265     .
      266     assign
      267       v-seconds = v-seconds modulo 3600
      268     .
      269     assign
      270       v-min = truncate(v-seconds / 60, 0)
      271     .
      272     assign
      273       v-seconds = v-seconds modulo 60
      274     .
      275     return
      276         (if v-day-number <> 0
      277           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      278           else ""
      279         )
      280       + (if v-day-number <> 0 or v-hour <> 0
      281           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      282           else ""
      283         )
      284       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      285           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      286           else ""
      287         )
      288       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      289       .
      290   end.
      291   function cur-time-string returns character
      292   :
      293     define variable v-date as date      no-undo .
      294     define variable v-time as integer   no-undo .
      295     run cur-time in this-procedure
      296       (output v-date
      297       ,output v-time
      298       ) .
      299     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      300   end.
      301   function cur-time-string-sec returns character
      302   :
      303     define variable v-date as date      no-undo .
      304     define variable v-time as integer   no-undo .
      305     run cur-time in this-procedure
      306       (output v-date
      307       ,output v-time
      308       ) .
      309     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      310   end.
      311   function cur-time-custom  returns character
      312   (input p-prefix as character
      313   ,input p-date-format as character
      314   ,input p-delimiter as character
      315   ,input p-time-format as character
      316   ,input p-suffix as character
      317   )
      318   :
      319     define variable v-date as date      no-undo .
      320     define variable v-time as integer   no-undo .
      321     run cur-time in this-procedure
      322       (output v-date
      323       ,output v-time
      324       ) .
      325     return
      326       p-prefix
      327       + string(v-date, p-date-format)
      328       + p-delimiter
      329       + string(v-time, p-time-format)
      330       + p-suffix
      331       .
      332   end.
      333   function cur-time-print  returns character
      334   :
      335     define variable v-date as date      no-undo .
      336     define variable v-time as integer   no-undo .
      337     run cur-time in this-procedure
      338       (output v-date
      339       ,output v-time
      340       ) .
      341     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      342   end.
      343   function cur-time-datetime returns datetime
      344   :
      345     define variable v-char as character no-undo .
      346     define variable v-datetime as datetime no-undo .
      347     v-char = cur-time-string().
      348     v-datetime = datetime(v-char).
      349     return  v-datetime.
      350   end.
      351   function cur-time-string-msec returns character
      352   :
      353     define variable v-date as datetime  no-undo .
      354     v-date = now.
      355     return string(v-date) .
      356   end.
      357   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      358   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      359   define new shared variable RepPathName        as character no-undo .
      360   define new shared variable PrintRubl          as logical   no-undo .
      361   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      362   define variable v-waitfram-action01         as character   no-undo .
      363   define variable v-waitfram-action02         as character   no-undo .
      364   define variable v-waitfram-action03         as character   no-undo .
      365   define variable mWaitFramTextBeg            as character   no-undo.
      366   define variable mWaitFramTextEnd            as character   no-undo.
      367   define variable mWaitFramView               as logical     no-undo.
      368   define variable mWaitProcEvent              as logical     no-undo init yes.
      369   define variable mWaitFramInterval           as integer     no-undo init 1 .
      370   define variable mWaitFramStop               as logical     no-undo.
      371   define variable mWaitFramStopUser           as logical     no-undo.
      372   define variable mWaitFramStopTimeOut        as logical     no-undo.
      373   define variable mWaitFramStartProc          as datetime-tz no-undo.
      374   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      375   define button B-WaitFramStop auto-end-key
      376        label "Стоп"
      377        size 10 by 1 tooltip "Остоновить процесс".
      378   define button B-viewProcInfo
      379        label "Информация"
      380        size 15 by 1 tooltip "Информация о процесс".
      381   define frame waitfram
      382     v-waitfram-action01 format "x(72)" no-label skip
      383     v-waitfram-action02 format "x(72)" no-label skip
      384     v-waitfram-action03 format "x(72)" no-label skip
      385     B-viewProcInfo
      386     B-WaitFramStop at row 4 col 30
      387     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      388     .
      389   define new global shared variable mBatchMode as logical no-undo init ?.
      390   define variable mFramBachModHandle as handle no-undo.
      391   mFramBachModHandle = frame waitfram:handle.
      392   define variable mFameOldVis as logical no-undo.
      393   define variable mVisCUrentVin as logical no-undo.
      394   if session:batch-mode
      395   then
      396      mBatchMode = yes.
      397   if mBatchMode = ? then do:
      398     mVisCUrentVin = current-window:visible.
      399     mFameOldVis = mFramBachModHandle:visible.
      400     mFramBachModHandle:visible  = yes.
      401     mBatchMode = mFramBachModHandle:visible ne yes.
      402     mFramBachModHandle:visible = mFameOldVis.
      403     current-window:visible = mVisCUrentVin.
      404   end.
      405    if  log-manager:logfile-name ne ?
      406     then DO:
      407         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      408         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      409         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      410     end.
      411   on choose of B-WaitFramStop in frame waitfram
      412   do:
      413     mWaitFramStop = yes.
      414     mWaitFramStopUser = yes.
      415   end.
      416   function waitfram-check-timeout returns logical():
      417      define variable vtime as int64 no-undo.
      418      if mWaitFramStopTimeOut
      419      then
      420         return yes.
      421      vtime = ( now - mWaitFramStartProc ) / 1000 .
      422      if     mWaitFramTimeOut ne ?
      423         and mWaitFramTimeOut ne 0
      424         and mWaitFramTimeOut lt vtime
      425      then do:
      426         mWaitFramStopTimeOut = yes.
      427      end.
      428      return mWaitFramStopTimeOut.
      429   end.
      430   procedure waitfram-hide :
      431     if not session:batch-mode
      432     then do
      433     on error undo, return error return-value
      434     :
      435       pause 0 before-hide .
      436       if not mBatchMode then
      437         hide frame waitfram .
      438     if     not mWaitFramView
      439        and mWaitProcEvent
      440     then
      441       process events .
      442     end.
      443   end procedure.
      444   procedure waitfram-show :
      445     define input  parameter p-message as character no-undo .
      446     define variable v-left-margin as integer   no-undo .
      447     if not session:batch-mode
      448     then do
      449     on error undo, return error return-value
      450     :
      451       if length(p-message) <= 70 then do:
      452         assign
      453           v-left-margin = integer((70 - length(p-message)) / 2)
      454         .
      455         assign
      456           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      457         .
      458         assign
      459           v-waitfram-action01 = " "
      460           v-waitfram-action02 = " "
      461                                    + fill(" ", v-left-margin)
      462                                    + p-message
      463           v-waitfram-action03 = " "
      464         .
      465       end.
      466       else do:
      467         define variable vRindex1 as integer no-undo.
      468         define variable vRindex2 as integer no-undo.
      469         vRindex1 = r-index(p-message," ",70).
      470         if vRindex1 = 0
      471         then
      472            vRindex1 = 70.
      473         if length(p-message)  <= vRindex1 + 70 then do:
      474           assign
      475             v-waitfram-action01 = " "
      476             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      477             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      478           .
      479         end.
      480         else do:
      481           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      482           if vRindex2 <= vRindex1
      483           then
      484              vRindex2 = vRindex1 + 70.
      485           assign
      486             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      487             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      488             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      489           .
      490         end.
      491       end.
      492       B-viewProcInfo:visible   in frame waitfram = no.
      493       B-viewProcInfo:sensitive in frame waitfram = no.
      494       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      495       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      496       if  (   mWaitFramView
      497          or  mWaitProcEvent)
      498          and not mBatchMode
      499       then
      500          display
      501             v-waitfram-action01 skip
      502             v-waitfram-action02 skip
      503             v-waitfram-action03 skip
      504          with frame waitfram .
      505       if     mWaitFramView
      506          then do:
      507             if     mWaitFramInterval ne ?
      508                and not mBatchMode
      509             then
      510                wait-for go of frame waitfram pause mWaitFramInterval.
      511          end.
      512          else
      513             if     mWaitProcEvent
      514                and not mBatchMode
      515             then
      516                process events .
      517     end.
      518   end procedure.
      519      procedure waitfram-show-this:
      520         define input  parameter iInterval as int64 no-undo.
      521         define variable vtime as int64 no-undo.
      522         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      523         mWaitFramInterval = iInterval.
      524         run waitfram-show (substitute("&1&2 &3&4" ,
      525                                       mWaitFramTextBeg ,
      526                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      527                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      528                                       mWaitFramTextEnd
      529                                      )
      530                           ).
      531      end.
      532      procedure WaitFramRunPause:
      533         define input  parameter iInterval as dec no-undo.
      534         define variable vStart  as datetime-tz no-undo.
      535         define variable vend    as datetime-tz no-undo.
      536         define variable vint as int64 no-undo.
      537         define variable vOk as logical no-undo.
      538         vStart = now.
      539         vend   = vStart.
      540         publish "WaitFramPause" (iInterval,output vOk).
      541         vend   =  now.
      542         vint = vend - vStart.
      543         vint = iInterval - vint / 1000.
      544         if     not mWaitFramStop
      545            and (   vint > 0
      546                 or (    not vOk
      547                     and iInterval eq ?
      548                     )
      549                 )
      550         then
      551            run waitfram-show-this (iInterval).
      552         vend   =  now.
      553         vint = vend - vStart.
      554         vint = iInterval - vint / 1000.
      555         if     not mWaitFramStop
      556            and vint > 0
      557         then do:
      558            run gbl/pause.p (vint * 1000).
      559         end.
      560         if iInterval ne ?
      561         then
      562            publish "WaitFramStop".
      563         waitfram-check-timeout().
      564      end.
      565      procedure WaitFramWaitFor:
      566         define input  parameter iInterval as dec no-undo.
      567         assign
      568            mWaitFramStartProc   = now
      569            mWaitFramStopUser    = no
      570            mWaitFramStopTimeOut = no
      571         .
      572         block-wait:
      573         do while not mWaitFramStop:
      574            run WaitFramRunPause (iInterval).
      575            if  waitfram-check-timeout()
      576            then do:
      577               leave block-wait.
      578            end.
      579         end.
      580         run waitfram-hide.
      581      end.
      582   procedure waitfram-join :
      583     define input  parameter p-line-1  as character no-undo .
      584     define input  parameter p-line-2  as character no-undo .
      585     define input  parameter p-line-3  as character no-undo .
      586     define output parameter p-message as character no-undo .
      587     do
      588     on error undo, return error return-value
      589     :
      590       assign
      591         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      592                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      593                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      594       .
      595     end.
      596   end procedure.
      597   function waitfram-join-function returns character
      598     (input p-line-1 as character
      599     ,input p-line-2 as character
      600     ,input p-line-3 as character
      601     ).
      602     define variable v-message as character no-undo .
      603     run waitfram-join in this-procedure
      604       (input  p-line-1
      605       ,input  p-line-2
      606       ,input  p-line-3
      607       ,output v-message
      608       ) .
      609     return v-message .
      610   end function .
      611   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      612   procedure fltfield-clear :
      613     define output parameter loc-fld as character no-undo.
      614     define output parameter loc-lab as character no-undo .
      615     define output parameter loc-spr as character no-undo .
      616     define output parameter loc-dim as character no-undo .
      617     assign
      618       loc-fld = ""
      619       loc-lab = ""
      620       loc-spr = ""
      621       loc-dim = "0"
      622     .
      623   end procedure .
      624   procedure fltfield-add :
      625     define input        parameter par-fld as character no-undo.
      626     define input        parameter par-lab as character no-undo .
      627     define input        parameter par-spr as character no-undo .
      628     define input-output parameter loc-fld as character no-undo.
      629     define input-output parameter loc-lab as character no-undo .
      630     define input-output parameter loc-spr as character no-undo .
      631     define input-output parameter loc-dim as character no-undo .
      632     do
      633     on error undo, return error
      634     :
      635       assign
      636       loc-fld = if loc-dim = '0'
      637                 then par-fld
      638                 else (loc-fld + chr(44) + par-fld)
      639       loc-lab = if loc-dim = '0'
      640                 then par-lab
      641                 else (loc-lab + chr(44) + par-lab)
      642       loc-spr = if loc-dim = '0'
      643                 then par-spr
      644                 else (loc-spr + chr(44) + par-spr)
      645       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      646                 string(integer(if num-entries(loc-dim) > 1
      647                               then entry(2, loc-dim)
      648                               else entry(1, loc-dim)
      649                               ) + 1)
      650       no-error
      651       .
      652     end.
      653   end procedure.
      654   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      655   define  stream PrnLibStream.
      656   procedure prn-lib-prn-file :
      657     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      658     define input parameter p-DIsabledoptions as integer no-undo .
      659     define variable v-report-name as character no-undo .
      660     define variable v-user-action as character no-undo .
