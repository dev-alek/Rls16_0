      701   procedure prn-lib-open-stream :
      702     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      703     define input parameter p-page-size    as integer no-undo .
      704     define input parameter p-is-stream    as logical no-undo .
      705     define input parameter p-append       as logical no-undo .
      706     define variable v-report-name as character no-undo .
      707     do
      708       on error undo, return error
      709       :
      710       run prn-lib-get-report-name  in this-procedure (
      711         input parParentProc
      712         ,output v-report-name
      713         ).
      714       if p-is-stream then
      715       do:
      716         if p-append then
      717         do:
      718           output stream PrnLibStream to value( v-report-name )
      719             page-size value(p-page-size) append .
      720         end.
      721         if not p-append then
      722         do:
      723           output stream PrnLibStream to value( v-report-name )
      724             page-size value(p-page-size) .
      725         end.
      726       end.
      727       if not p-is-stream then
      728       do:
      729         if p-append then
      730         do:
      731           output to value( v-report-name )
      732             page-size value(p-page-size) append .
      733         end.
      734         if not p-append then
      735         do:
      736           output to value( v-report-name )
      737             page-size value(p-page-size) .
      738         end.
      739       end.
      740     end.
      741   end procedure.
      742   procedure prn-lib-open-exp :
      743     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      744     define input parameter p-is-stream    as logical no-undo .
      745     define input parameter p-is-append    as logical no-undo .
      746     define output parameter p-ReportFileName as char init "report" no-undo.
      747     define output parameter p-process as logical no-undo .
      748     define variable glog as logical no-undo .
      749     do
      750       on error undo, return error
      751       :
      752       SYSTEM-DIALOG GET-FILE p-ReportFileName
      753         TITLE      "Укажите путь"
      754         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      755         ASK-OVERWRITE
      756         CREATE-TEST-FILE
      757         SAVE-AS
      758         USE-FILENAME
      759         DEFAULT-EXTENSION "txt"
      760         UPDATE glog
      761         .
      762       if not glog then  return.
      763       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      764       if p-is-stream then
      765       do:
      766         if p-is-append then
      767         do:
      768           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      769         end.
      770         else
      771         do:
      772           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      773         end.
      774       end.
      775       else
      776       do:
      777         if p-is-append then
      778         do:
      779           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      780         end.
      781         else
      782         do:
      783           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      784         end.
      785       end.
      786       p-process = yes.
      787     end.
      788   end procedure.
