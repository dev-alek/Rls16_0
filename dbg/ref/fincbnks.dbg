     3816         .
     3817         assign
     3818           v-doc-rec = integer(return-value)
     3819           v-fltopend-rowid[1] = ?
     3820         .
     3821       end.
     3822       else do:
     3823         assign
     3824         parameter-2-32 = (if p-find-next then "true":u else "false":u )
     3825         parameter-3-32 =  "FOR EACH X_c-fin-bank"
     3826         parameter-4-32 =
     3827           (
     3828             if ("           X_c-fin-bank.host-code  = p-host-code AND X_c-fin-bank.code-bank = p-code-bank                         " + " " + where-phrase-32) <> ""
     3829             then  substitute('X_c-fin-bank.host-code  = &1 AND X_c-fin-bank.code-bank = &2', p-host-code, p-code-bank)  + " " + where-phrase-32
     3830             else "true"
     3831           )
     3832         parameter-5-32 = (" " + "" + " " + "" + " " + p-find-condition)
     3833         parameter-6-32 = if sort-phrase-32 = ''
     3834                              then
     3835           (
     3836           " " + "  " +
     3837             " " + sort-column-phrase +
     3838           " " + "  "
     3839           )
     3840                              else
     3841           (
     3842           " " + "  " +
     3843             " " + sort-column-phrase +
     3844           " " + sort-phrase-32
     3845           )
     3846         parameter-7-32 =
     3847           " indexed-reposition  "
     3848       .
     3849         run fltopend_fltfindq in this-procedure  (
     3850                             input this-procedure:handle
     3851                             ,input QUERY br-bank:handle
     3852                             ,input logical(parameter-2-32)
     3853                             ,input no-lock
     3854                             ,input parameter-3-32
     3855                             ,input parameter-4-32
     3856                             ,input parameter-5-32
     3857                             ,input parameter-6-32
     3858                             ,input parameter-7-32
     3859                             ,output v-fltopend-rowid
     3860                             ) no-error.
     3861         .
     3862         v-doc-rec = ?.
     3863       end.
     3864       assign
     3865         l-query-was-opened = true
     3866       .
     3867     end.
     3868   end.
     3869     run waitfram-hide in this-procedure .
     3870       END.
     3871   END CASE.
     3872   if not p-open-query and v-doc-rec <> ? then
     3873   REPOSITION br-bank to recid v-doc-rec No-ERROR.
     3874   if not p-open-query and v-fltopend-rowid[1] <> ? then
     3875   query br-bank:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     3876   run waitfram-hide in this-procedure .
     3877   APPLY "VALUE-CHANGED" TO br-bank in frame Dialog-Frame.
     3878   APPLY "ENTRY" TO br-bank.
     3879   END PROCEDURE.
     3880   PROCEDURE proc-b-sch :
     3881   assign
     3882     tbl = 'c-fin-bank'
     3883     join-tbl = 'X_c-fin-bank'
     3884     fld = ""
     3885     lab = ""
     3886     spr = ""
     3887     dim = '0'
