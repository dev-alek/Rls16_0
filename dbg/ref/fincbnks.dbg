      799   procedure prn-lib-reportviewer :
      800     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      801     define input parameter p-report-name-html as character no-undo .
      802     define input parameter p-param        as character no-undo .
      803     define variable v-excel           as character no-undo init 'TRUE' .
      804     define variable v-value-character as character no-undo .
      805     define variable v-value-integer   as character no-undo .
      806     define variable v-value-date      as date      no-undo .
      807     define variable v-value-decimal   as decimal   no-undo .
      808     define variable rep-excel         as logical   no-undo .
      809     define variable excel-string      as character no-undo .
      810     define variable v-param-type      as character no-undo .
      811     define variable v-tth             as handle    no-undo .
      812     run adm/shattri.p (
      813       input "get":U
      814       ,input  ""
      815       ,input  0
      816       ,input  'report-glob':U
      817       ,input  'rep-excel':U
      818       ,output v-value-character
      819       ,output v-value-date
      820       ,output v-value-decimal
      821       ,output v-value-integer
      822       ,output rep-excel
