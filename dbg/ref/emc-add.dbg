        1   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        2   define input parameter p-mode as character no-undo.
        3   define input-output parameter p-rid as recid init ? no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision: $":U .
        5   define variable vss-author      as character no-undo init "$Author: $":U .
        6   define variable vss-date        as character no-undo init "$Date: $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: $":U .
        9   define variable vss-description as character no-undo init "Карточка Код ОКЕИ код ККТ".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   procedure proc-alt-shift-f2:
       71     if not ibs.th.gbl.gbl-var:rcode
       72   then
       73     run gbl\inidebug.p .
       74   end.
       75   procedure proc-alt-shift-f3:
       76     run gbl/prvssinf.p
       77       ( input this-procedure
       78       ) .
       79   end.
       80   define variable v-inform-launched as logical no-undo initial false .
       81   procedure proc-alt-shift-f4:
       82     define variable v-action as character no-undo .
       83     if v-inform-launched = false then do:
       84       assign
       85         v-inform-launched = true
       86       .
       87       run gbl/d-inform.w
       88         (  input self
       89         ,  input this-procedure
       90         , output v-action
       91         ) no-error .
       92       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       93       assign
       94         v-inform-launched = false
       95       .
       96     end.
       97   end.
       98   procedure proc-alt-f1:
       99     run gbl/corrhelp.p
      100       (input this-procedure
      101       ) .
      102   end .
      103   on alt-shift-f2 anywhere do:
      104     run proc-alt-shift-f2.
      105   end.
      106   on alt-shift-f3 anywhere do:
      107     run proc-alt-shift-f3 in this-procedure .
      108   end.
      109   on alt-shift-f4 anywhere do:
      110     run proc-alt-shift-f4 in this-procedure.
      111   end.
      112   on alt-f1 anywhere do:
      113     run proc-alt-f1 in this-procedure .
      114   end.
      115   define variable v-db-num like ub.db.db-num no-undo .
      116   DEFINE BUTTON B-Help
      117        LABEL "Помо&щь"
      118        SIZE 10 BY 1
      119        BGCOLOR 8 .
      120   DEFINE BUTTON b-quit AUTO-END-KEY
      121        LABEL "&Отмена"
      122        SIZE 10 BY 1
      123        BGCOLOR 8 .
      124   DEFINE BUTTON B-save AUTO-GO
      125        LABEL "&Ввод"
      126        SIZE 10 BY 1
      127        BGCOLOR 8 .
      128   DEFINE VARIABLE mNAIM AS CHARACTER FORMAT "X(256)":U
      129        LABEL "Наименование"
      130        VIEW-AS FILL-IN
      131        SIZE 14 BY 1 NO-UNDO.
      132   DEFINE VARIABLE mOKEI AS INTEGER FORMAT ">>>>>999":U INITIAL 0
      133        LABEL "Код"
      134        VIEW-AS FILL-IN
      135        SIZE 14 BY 1 NO-UNDO.
      136   DEFINE FRAME Dialog-Frame
      137        B-save AT ROW 1 COL 1
      138        b-quit AT ROW 1 COL 11
      139        B-Help AT ROW 1 COL 36
      140        mOKEI AT ROW 2.5 COL 18 COLON-ALIGNED WIDGET-ID 2
      141        mNAIM AT ROW 5 COL 18 COLON-ALIGNED WIDGET-ID 8
      142        SPACE(18.24) SKIP(0.62)
      143       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      144            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      145            TITLE "Редактирование ЕМЦ"
      146            DEFAULT-BUTTON B-save CANCEL-BUTTON b-quit.
      147   ASSIGN
      148          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      149          FRAME Dialog-Frame:HIDDEN           = TRUE.
      150   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      151   DO:
      152     APPLY "END-ERROR":U TO SELF.
      153   END.
      154   ON CHOOSE OF B-save IN FRAME Dialog-Frame
      155   DO:
      156     run proc-save in this-procedure no-error.
      157     if error-status:error then return no-apply.
      158   END.
      159   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      160   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      161   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      162   on help of frame Dialog-Frame
      163   do:
      164     run gbl/app_help.p
      165       (input this-procedure :file-name
      166       ,input ''
      167       ,input ?
      168       ) no-error.
      169     if error-status :error then do:
      170       message
      171         "Ошибка при вызове помощи"
      172         error-status :get-message(1)
      173         view-as alert-box .
      174     end.
      175   end.
      176   run minbtn-set in this-procedure .
      177   on choose of b-help in frame Dialog-Frame
      178   do:
      179     apply "help":u to frame Dialog-Frame .
      180   end.
      181   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      182   procedure minbtn-set :
      183       do
      184           on error undo, return error return-value
      185           :
      186           define variable ii              as integer       no-undo .
      187           define variable fh              as widget-handle no-undo .
      188           define variable hh              as widget-handle no-undo .
      189           define variable v-h             as handle        extent 4 no-undo .
      190           define variable v-name-button   as character     no-undo .
      191           define variable v-help-old-x    as decimal       no-undo .
      192           define variable v-help-old-y    as decimal       no-undo .
      193           define variable v-help-old-size as decimal       no-undo .
      194           define variable v-frame-width   as decimal       no-undo .
      195           define variable jj              as integer       no-undo .
      196           do
      197               on error undo, return error
      198               :
      199               assign
      200                   v-frame-width = frame Dialog-Frame:width - 0.3
      201                   fh            = frame Dialog-Frame:first-child
      202                   hh            = fh:first-child
      203                   ii            = 1
      204                   .
      205               do while valid-handle(hh):
      206                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      207                   do:
      208                       case lc(hh:name) :
      209                           when "b-help" then
      210                               do:
      211                                   hh:load-image-up("cmp/b-help.bmp":u) .
      212                                   hh:load-image-down("cmp/b-help.bmp":u) .
      213                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      214                                   hh:TOOLTIP = "Помощь" .
      215                                   v-help-old-x = hh:column .
      216                                   v-help-old-y = hh:row    .
      217                                   v-help-old-size = hh:width .
      218                                   hh:width-chars = 2.5 .
      219                               end.
      220                           when "b-print" then
      221                               do:
      222                                   hh:load-image("cmp/b-print.bmp":u) .
      223                                   hh:TOOLTIP = "Печать" .
      224                                   v-h[ii] = hh:handle .
      225                                   ii = ii + 1 .
      226                                   hh:width-chars = 3 .
      227                               end.
      228                           when "b-history" or
      229                           when "b-hist" then
      230                               do:
      231                                   hh:load-image("cmp/b-hist.bmp":u) .
      232                                   hh:TOOLTIP = "История" .
      233                                   v-h[ii] = hh:handle .
      234                                   ii = ii + 1 .
      235                                   hh:width-chars = 3 .
      236                               end.
      237                           when "b-sch" then
      238                               do:
      239                                   hh:load-image("cmp/b-sch.bmp":u) .
      240                                   hh:TOOLTIP = "Установка Фильтра" .
      241                                   v-h[ii] = hh:handle .
      242                                   ii = ii + 1 .
      243                                   hh:width-chars = 3 .
      244                               end.
      245                           when "b-hist-user" then
      246                               do:
      247                                   hh:load-image("cmp/b-hist.bmp":u) .
      248                                   hh:TOOLTIP = "История пользователя" .
      249                                   ii = ii + 1 .
      250                               end.
      251                       end case.
      252                   end.
      253                   hh = hh:next-sibling.
      254               end.
      255               b-help:column = v-frame-width - b-help:width-chars.
      256               jj = 0.
      257               repeat ii = 4 to 1 by -1 :
      258                   if valid-handle (v-h[ii] ) then
      259                   do:
      260                       jj  = jj + 1 .
      261                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      262                       v-h[ii]:row    = v-help-old-y .
      263                   end.
      264               end.
      265           end.
      266       end.
      267   end procedure.
      268   MAIN-BLOCK:
      269   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      270      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      271      if p-mode <> 'ДОБАВЛЕНИЕ':U and
      272         p-mode <> 'ИЗМЕНЕНИЕ':U
      273      then do:
      274         message
      275         vss-workfile vss-revision vss-description skip
      276         "Неверное значение параметров вызова p-mode"  p-mode
      277         view-as alert-box ERROR.
      278         undo, return error.
      279      end.
      280   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      281   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      282     (output v-db-num
      283     )  .
      284      if v-db-num <> 0 then do:
      285         message
      286         vss-workfile vss-revision vss-description skip
      287         "Неверное значение параметров вызова p-mode - нельзя изменять/добавлять записи <Тип ЕМЦ Код> в УБД"
      288         view-as alert-box ERROR.
      289         undo, return error.
      290      end.
      291      if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      292         find first code where
      293                    recid(code) = p-rid exclusive-lock no-wait no-error.
      294         if locked code then do:
      295            message
      296               vss-workfile vss-revision vss-description skip
      297               "Запись <Тип ЕМЦ - Код> занята"
      298            view-as alert-box error .
      299            undo, return error.
      300         end.
      301         if not available code then do:
      302            message
      303               vss-workfile vss-revision vss-description skip
      304               "Не найдена запись <Тип ЕМЦ - Код>"
      305            view-as alert-box error .
      306            undo, return error.
      307         end.
      308      end.
      309      assign
      310         mOKEI = integer(code.code)
      311         no-error.
      312      run enable_UI in this-procedure .
      313      if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      314         ENABLE mOKEI WITH FRAME Dialog-Frame.
      315         apply "entry" to mOKEI in FRAME Dialog-Frame.
      316      end.
      317      WAIT-FOR GO OF FRAME Dialog-Frame.
      318   END.
      319   session:data-entry-return = no .
      320   RUN disable_UI.
      321   PROCEDURE disable_UI :
      322     HIDE FRAME Dialog-Frame.
      323   END PROCEDURE.
      324   PROCEDURE enable_UI :
      325     DISPLAY mOKEI mNAIM
      326         WITH FRAME Dialog-Frame.
      327     ENABLE B-save b-quit B-Help mOKEI mNAIM
      328         WITH FRAME Dialog-Frame.
      329     VIEW FRAME Dialog-Frame.
      330   END PROCEDURE.
      331   PROCEDURE proc-save :
      332      define buffer units for units.
      333      assign frame Dialog-Frame
      334         mOKEI
      335         mNAIM
      336         .
      337      do on error undo, return error
      338      on stop undo, return error:
      339         if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      340            find first code where
      341                       code.parent = "EMC"
      342                   and code.code   = string(mOKEI)
      343                   and code.codename   = string(mNAIM)
      344            no-lock no-error.
      345            if avail code then do:
      346               message
      347                  "Уже есть такая запись Тип ЕМЦ Код :" mOKEI
      348               view-as alert-box error .
      349               return error.
      350            end.
      351            if avail code then do:
      352               message
      353                  "Уже есть такая запись Тип ЕМЦ Наименование :" mNAIM
      354               view-as alert-box error .
      355               return error.
      356            end.
      357            create code.
      358            assign
      359               code.parent = "EMC"
      360               code.code   = string(mOKEI, fill("9", max(length(string(mOKEI)), 3)))
      361               code.codename   = string(mNAIM, fill("9", max(length(string(mNAIM)), 3)))
      362               code.nwsgbd = yes
      363            .
      364         end.
      365      end.
      366      p-rid = recid(code).
      367   END PROCEDURE.
