      149   procedure cur-time :
      150      define output parameter p-today as date      no-undo .
      151      define output parameter p-time  as integer   no-undo .
      152     do
      153     on error undo, return error
      154     :
      155       define variable v-date1 as date      no-undo .
      156       define variable v-date2 as date      no-undo .
      157       define variable v-time  as integer   no-undo .
      158       assign
      159         v-date1 = today
      160         v-time  = time
      161         v-date2 = today
      162       .
      163       if v-date1 <> v-date2
      164       then do:
      165         assign
      166           v-date1 = today
      167           v-time  = v-time
      168         .
      169       end.
      170       assign
      171         p-today = v-date1
      172         p-time  = v-time
      173       .
      174     end.
      175   end.
      176   function cur-time-date returns character
      177   :
      178     return string(today, '99/99/9999':U) .
      179   end.
      180   function cur-time-mjd returns decimal
      181   :
      182     define variable v-date as date      no-undo .
      183     define variable v-time as integer   no-undo .
      184     run cur-time in this-procedure
      185       (output v-date
      186       ,output v-time
      187       ) .
      188     return integer(v-date) - 2400002 + (v-time / 86400) .
      189   end.
      190   function cur-time-get-ending-index returns integer
      191   (input p-number as integer
      192   )
      193   :
      194     if p-number < 0
      195     or p-number = ?
      196     then do:
      197       return 1 .
      198     end.
      199     define variable v-rest as integer   no-undo .
      200     assign
      201       p-number = p-number modulo 100
      202     .
      203     if p-number < 20
      204     then do:
      205       assign
      206         v-rest = p-number
      207       .
      208     end.
      209     else do:
      210       assign
      211         v-rest = p-number modulo 10
      212       .
      213     end.
      214     case v-rest :
      215       when 1
      216       then do:
      217         return 2 .
      218       end.
      219       when 2 or
      220       when 3 or
      221       when 4
      222       then do:
      223         return 3 .
      224       end.
      225       otherwise do:
      226         return 1 .
      227       end.
      228     end case .
      229   end.
      230   procedure cur-time-mjd-to-date :
      231      define input  parameter i-mjd-diff as decimal no-undo.
      232      define output parameter o-Date     as date    no-undo.
      233      define output parameter o-Time     as integer no-undo.
      234      define variable v-day-number as integer   no-undo .
      235      if    i-mjd-diff < 0
      236         or i-mjd-diff = ?
      237      then do:
      238         return "?" .
      239      end.
      240      assign
      241         v-day-number = truncate(i-mjd-diff,0).
      242         o-Date = date(v-day-number + 2400002).
      243         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      244     .
      245   end.
      246   function cur-time-mjd-to-string returns character
      247   (input p-mjd-diff as decimal
      248   )
      249   :
      250     define variable v-day-number as integer   no-undo .
      251     define variable v-seconds    as integer   no-undo .
      252     define variable v-hour       as integer   no-undo .
      253     define variable v-min        as integer   no-undo .
      254     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      255     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      256     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      257     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      258     if p-mjd-diff < 0
      259     or p-mjd-diff = ?
      260     then do:
      261       return "?" .
      262     end.
      263     assign
      264       v-day-number = integer(truncate(p-mjd-diff,0))
      265       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      266     .
      267     if v-seconds > 86400
      268     then do:
      269       assign
      270         v-seconds = 86400 - 1
      271       .
      272     end.
      273     if v-seconds < 0
      274     then do:
      275       assign
      276         v-seconds = 0
      277       .
      278     end.
      279     assign
      280       v-hour = truncate(v-seconds / 3600, 0)
      281     .
      282     assign
      283       v-seconds = v-seconds modulo 3600
      284     .
      285     assign
      286       v-min = truncate(v-seconds / 60, 0)
      287     .
      288     assign
      289       v-seconds = v-seconds modulo 60
      290     .
      291     return
      292         (if v-day-number <> 0
      293           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      294           else ""
      295         )
      296       + (if v-day-number <> 0 or v-hour <> 0
      297           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      298           else ""
      299         )
      300       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      301           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      302           else ""
      303         )
      304       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      305       .
      306   end.
      307   function cur-time-string returns character
      308   :
      309     define variable v-date as date      no-undo .
      310     define variable v-time as integer   no-undo .
      311     run cur-time in this-procedure
      312       (output v-date
      313       ,output v-time
      314       ) .
      315     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      316   end.
      317   function cur-time-string-sec returns character
      318   :
      319     define variable v-date as date      no-undo .
      320     define variable v-time as integer   no-undo .
      321     run cur-time in this-procedure
      322       (output v-date
      323       ,output v-time
      324       ) .
      325     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      326   end.
      327   function cur-time-custom  returns character
      328   (input p-prefix as character
      329   ,input p-date-format as character
      330   ,input p-delimiter as character
      331   ,input p-time-format as character
      332   ,input p-suffix as character
      333   )
      334   :
      335     define variable v-date as date      no-undo .
      336     define variable v-time as integer   no-undo .
      337     run cur-time in this-procedure
      338       (output v-date
      339       ,output v-time
      340       ) .
      341     return
      342       p-prefix
      343       + string(v-date, p-date-format)
      344       + p-delimiter
      345       + string(v-time, p-time-format)
      346       + p-suffix
      347       .
      348   end.
      349   function cur-time-print  returns character
      350   :
      351     define variable v-date as date      no-undo .
      352     define variable v-time as integer   no-undo .
      353     run cur-time in this-procedure
      354       (output v-date
      355       ,output v-time
      356       ) .
      357     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      358   end.
      359   function cur-time-datetime returns datetime
      360   :
      361     define variable v-char as character no-undo .
      362     define variable v-datetime as datetime no-undo .
      363     v-char = cur-time-string().
      364     v-datetime = datetime(v-char).
      365     return  v-datetime.
      366   end.
      367   function cur-time-string-msec returns character
      368   :
      369     define variable v-date as datetime  no-undo .
      370     v-date = now.
      371     return string(v-date) .
      372   end.
      373   procedure fbrlib_create-fbr-doc :
      374   define input parameter p-obj-type as character no-undo .
      375   define input parameter p-obj-code as integer no-undo .
      376   define input parameter p-userid as character no-undo .
      377   define output parameter p-fbr-doc-code as character no-undo .
      378   define output parameter p-recid as recid no-undo .
      379   define variable v-host-code as integer no-undo .
      380   define variable v-base-code as integer no-undo .
      381   define variable v-obj-db-num as integer no-undo .
      382   define variable v-db-num as integer no-undo .
      383   DEFINE VARIABLE v-today as date no-undo .
      384   DEFINE VARIABLE v-time as integer no-undo .
      385   define variable v-doc-code as character no-undo .
      386   define variable fi-pay-code as integer no-undo .
      387   define buffer buf_fbr-doc for ub.fbr-doc.
      388   define buffer buf_curr-accnt for ub.curr-accnt.
      389   do
      390   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      391   on stop   undo , return error substitute( "&1. stop", vss-workfile )
      392   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
      393   :
      394   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      395   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      396     (input  p-obj-type
      397     ,input  p-obj-code
      398     ,output v-host-code
      399     )  .
      400   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      401   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      402     (input  p-obj-type
      403     ,input  p-obj-code
      404     ,output v-obj-db-num
      405     )  .
      406   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      407   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      408     (output v-db-num
      409     )  .
      410   if v-obj-db-num <> v-db-num then do:
      411     return error substitute("Запрещено создание документа производства в чужой БД:&1БД &2&3 - &4&1текущая БД - &5"
      412                             , chr(10)
      413                             , p-obj-type
      414                             , p-obj-code
      415                             , v-obj-db-num
      416                             , v-db-num).
      417   end.
      418   run cur-time in this-procedure ( output v-today, output v-time).
      419   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      420   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
      421     (input  p-obj-type
      422     ,input  p-obj-code
      423     ,output v-today
      424     )  .
      425   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      426   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      427     (input  v-host-code
      428     ,output v-base-code
      429     )  .
      430   find last buf_curr-accnt no-lock
      431       where buf_curr-accnt.curr-code = v-base-code
      432         and buf_curr-accnt.exch-date <= v-today use-index pi
      433   no-error.
      434   if not available buf_curr-accnt
      435   then do:
      436     undo, return error substitute("На дату &1 неизвестен курс базовой валюты с кодом &2"
      437                                     , string(v-today, "99/99/9999")
      438                                     , v-base-code).
      439   end.
      440   run doc-code in this-procedure (
      441         input  "main"
      442       , input  p-obj-type
      443       , input  p-obj-code
      444       , input  ?
      445       , output v-doc-code
      446   ) no-error.
      447   if error-status:error
      448   then do:
      449     undo, return error substitute("Ошибка при генерации номера документа производства&1&2&1&3"
      450                                   , chr(10)
      451                                   , error-status:get-message(1)
      452                                   , return-value ).
      453   end.
      454   run trg/chkdocnm.p (
      455         input v-doc-code
      456       , input 'fbr-doc':U
      457       , input ?
      458   ) no-error.
      459   if error-status:error
      460   then do:
      461     undo, return error substitute("Ошибка при проверке номера для нового документа производства&1&2&1&3"
      462                                   , chr(10)
      463                                   , error-status:get-message(1)
      464                                   , return-value ).
      465   end.
      466   create buf_fbr-doc.
      467   assign
      468   buf_fbr-doc.doc-code  = v-doc-code
      469   buf_fbr-doc.creid     = p-userid
      470   buf_fbr-doc.doc-date  = v-today
      471   buf_fbr-doc.doc-type  = 'производство':U
      472   buf_fbr-doc.host-code = v-host-code
      473   buf_fbr-doc.obj-code  = p-obj-code
      474   buf_fbr-doc.obj-type  = p-obj-type
      475   buf_fbr-doc.PS        = "@"
      476   buf_fbr-doc.status_   = 'новый':U
      477   buf_fbr-doc.user-db-num = v-obj-db-num
      478   buf_fbr-doc.user-name   = p-userid
      479   .
      480   run fbrlib_get-default-pay-code in this-procedure (
      481         input buf_fbr-doc.obj-type
      482       , input buf_fbr-doc.obj-code
      483       , output fi-pay-code
      484   ).
      485   buf_fbr-doc.pay-code = fi-pay-code.
      486   p-recid = recid(buf_fbr-doc).
      487   p-fbr-doc-code = buf_fbr-doc.doc-code.
      488   end.
      489   end procedure.
      490   procedure fbrlib_get-default-pay-code :
      491   define input parameter p-obj-type   as character        no-undo.
      492   define input parameter p-obj-code   as integer          no-undo.
      493   define output parameter p-pay-code  as integer          no-undo.
      494   define variable v-host-code as integer no-undo .
      495   define buffer buf_shop          for ub.shop.
      496   define buffer buf_store         for ub.store.
      497   define buffer buf_sysconf       for ub.sysconf.
      498   do
      499   for buf_shop
      500     , buf_store
      501     , buf_sysconf
      502   on error undo, return error
      503   :
      504     case p-obj-type  :
      505       when 'маг':U then do:
      506           find first buf_shop no-lock
      507                 where buf_shop.obj-code = p-obj-code
      508           no-error.
      509           if available buf_shop
      510           then do:
      511               assign
      512                   p-pay-code = buf_shop.fbr-pay
      513               .
      514           end.
      515       end.
      516       when 'скл':U then do:
      517           find first buf_store no-lock
      518                 where buf_store.obj-code = p-obj-code
      519           no-error.
      520           if available buf_store
      521           then do:
      522               assign
      523                   p-pay-code = buf_store.fbr-pay
      524               .
      525           end.
      526       end.
      527     end case.
      528     if p-pay-code = ?
      529     or p-pay-code = 0
      530     then do:
      531   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      532   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      533     (input  p-obj-type
      534     ,input  p-obj-code
      535     ,output v-host-code
      536     )  .
      537         find first buf_sysconf no-lock
      538               where buf_sysconf.host-code = v-host-code
      539         no-error.
      540         if available buf_sysconf
      541         then do:
      542             assign
      543                 p-pay-code = buf_sysconf.fbr-pay
      544             .
      545         end.
      546     end.
      547     if p-pay-code = ?
      548     or p-pay-code = 0
      549     then do:
      550   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      551   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdnpay in g#library
      552     (input  p-obj-type
      553     ,input  p-obj-code
      554     ,output p-pay-code
      555     )  .
      556     end.
      557   end.
      558   end procedure.
      559   procedure fbrlib-fill-and-check-temp_fbrlib_recipe :
      560   do
      561   on error undo, return error
      562   :
      563   define input parameter p-fbr-doc-code as character    no-undo.
      564       define variable vss-description as character    no-undo init "fbrlib-fill-and-check-temp_fbrlib_recipe: ".
      565       define variable v-gds-name      as character    no-undo.
      566       define buffer buf_fbr-doc               for ub.fbr-doc.
      567       define buffer buf_fbr-line              for ub.fbr-line.
      568       define buffer buf_temp_fbrlib_recipe    for temp_fbrlib_recipe.
      569       define buffer buf_out_temp_fbrlib_recipe    for temp_fbrlib_recipe.
      570       find first buf_fbr-doc no-lock
      571            where buf_fbr-doc.doc-code = p-fbr-doc-code
      572       .
      573       for each buf_temp_fbrlib_recipe
      574       :
      575           delete buf_temp_fbrlib_recipe.
      576       end.
      577       for each buf_fbr-line no-lock
      578          where buf_fbr-line.doc-code = p-fbr-doc-code
      579       :
      580           find first buf_temp_fbrlib_recipe
      581                where buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
      582           no-error.
      583           if not available buf_temp_fbrlib_recipe
      584           then do:
      585               create buf_temp_fbrlib_recipe.
      586               assign
      587                   buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
      588                   buf_temp_fbrlib_recipe.fbr-doc-code = buf_fbr-line.doc-code
      589               .
      590           end.
      591       end.
      592       for each buf_temp_fbrlib_recipe
      593       :
      594           assign
      595               buf_temp_fbrlib_recipe.count-income                = 0
      596               buf_temp_fbrlib_recipe.qnty-income                 = 0
      597               buf_temp_fbrlib_recipe.sum-income-sale             = 0
      598               buf_temp_fbrlib_recipe.sum-income-cost-base        = 0
      599               buf_temp_fbrlib_recipe.sum-income-cost-rubl        = 0
      600               buf_temp_fbrlib_recipe.sum-income-vat-cost-base    = 0
      601               buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl    = 0
      602               buf_temp_fbrlib_recipe.count-write-off             = 0
      603               buf_temp_fbrlib_recipe.qnty-write-off              = 0
      604               buf_temp_fbrlib_recipe.sum-write-off-sale          = 0
      605               buf_temp_fbrlib_recipe.sum-write-off-cost-base     = 0
      606               buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = 0
      607               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = 0
      608               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = 0
      609           .
      610           for each buf_fbr-line no-lock
      611              where buf_fbr-line.doc-code     = p-fbr-doc-code
      612                and buf_fbr-line.trn-type     = 'при':U
      613                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
      614           :
      615               if ( buf_fbr-line.price-base   = ?
      616                   or buf_fbr-line.price-rubl = ?
      617                   or buf_fbr-line.price-base <= 0
      618                   or buf_fbr-line.price-rubl <= 0 )
      619               and buf_fbr-line.fact-qnty <> 0
      620               and buf_fbr-line.rsrv-qnty <> ?
      621               and buf_fbr-doc.is-free    = no
      622               then do:
      623   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      624   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
      625     (input  buf_fbr-line.artic
      626     ,input  buf_fbr-line.prod-type
      627     ,input  buf_fbr-line.prod-code
      628     ,output v-gds-name
      629     ) no-error .
      630                   if error-status :error
      631                   then do:
      632                       assign
      633                           v-gds-name = ""
      634                       .
      635                   end.
      636                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
      637                                                 ,vss-description
      638                                                 ,buf_fbr-doc.doc-code
      639                                                 ,chr(10)
      640                                                 ,buf_fbr-line.recipe-code
      641                                                 ,buf_fbr-line.artic
      642                                                 ,v-gds-name).
      643               end.
      644               assign
      645                   buf_temp_fbrlib_recipe.count-income             = buf_temp_fbrlib_recipe.count-income + 1
      646                   buf_temp_fbrlib_recipe.qnty-income              = buf_temp_fbrlib_recipe.qnty-income
      647                                                                   + buf_fbr-line.fact-qnty
      648                   buf_temp_fbrlib_recipe.sum-income-sale          = buf_temp_fbrlib_recipe.sum-income-sale
      649                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
      650               .
      651               if buf_fbr-line.is-waste = no
      652               then do:
      653                   assign
      654                       buf_temp_fbrlib_recipe.sum-income-cost-base     = buf_temp_fbrlib_recipe.sum-income-cost-base
      655                                                                       + buf_fbr-line.price-sum-base
      656                       buf_temp_fbrlib_recipe.sum-income-cost-rubl     = buf_temp_fbrlib_recipe.sum-income-cost-rubl
      657                                                                       + buf_fbr-line.price-sum-rubl
      658                       buf_temp_fbrlib_recipe.sum-income-vat-cost-base = buf_temp_fbrlib_recipe.sum-income-vat-cost-base
      659                                                                       + buf_fbr-line.price-sum-vat-base
      660                       buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
      661                                                                       + buf_fbr-line.price-sum-vat-rubl
      662                   .
      663               end.
      664           end.
      665           for each buf_fbr-line no-lock
      666              where buf_fbr-line.doc-code     = p-fbr-doc-code
      667                and buf_fbr-line.trn-type     = 'спи':U
      668                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
      669           :
      670               if ( buf_fbr-line.price-base   = ?
      671                   or buf_fbr-line.price-rubl = ?
      672                   or buf_fbr-line.price-base <= 0
      673                   or buf_fbr-line.price-rubl <= 0 )
      674               and buf_fbr-line.fact-qnty <> 0
      675               and buf_fbr-line.rsrv-qnty <> ?
      676               and buf_fbr-doc.is-free    = no
      677               and buf_fbr-doc.status_    = 'разрешен':U
      678               then do:
      679   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      680   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
      681     (input  buf_fbr-line.artic
      682     ,input  buf_fbr-line.prod-type
      683     ,input  buf_fbr-line.prod-code
      684     ,output v-gds-name
      685     ) no-error .
      686                   if error-status :error
      687                   then do:
      688                       assign
      689                           v-gds-name = ""
      690                       .
      691                   end.
      692                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
      693                                                 ,vss-description
      694                                                 ,buf_fbr-doc.doc-code
      695                                                 ,chr(10)
      696                                                 ,buf_fbr-line.recipe-code
      697                                                 ,buf_fbr-line.artic
      698                                                 ,v-gds-name).
      699               end.
      700               assign
      701                   buf_temp_fbrlib_recipe.count-write-off             = buf_temp_fbrlib_recipe.count-write-off + 1
      702                   buf_temp_fbrlib_recipe.qnty-write-off              = buf_temp_fbrlib_recipe.qnty-write-off
      703                                                                   + buf_fbr-line.fact-qnty
      704                   buf_temp_fbrlib_recipe.sum-write-off-sale          = buf_temp_fbrlib_recipe.sum-write-off-sale
      705                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
      706               .
      707               if buf_fbr-line.is-waste = no
      708               then do:
      709                   assign
      710                       buf_temp_fbrlib_recipe.sum-write-off-cost-base     = buf_temp_fbrlib_recipe.sum-write-off-cost-base
      711                                                                       + buf_fbr-line.price-sum-base
      712                       buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
      713                                                                       + buf_fbr-line.price-sum-rubl
      714                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
      715                                                                       + buf_fbr-line.price-sum-vat-base
      716                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
      717                                                                       + buf_fbr-line.price-sum-vat-rubl
      718                   .
      719               end.
      720           end.
      721           if buf_fbr-doc.status_    = 'разрешен':U
      722           and ( abs( buf_temp_fbrlib_recipe.sum-write-off-cost-base     - buf_temp_fbrlib_recipe.sum-income-cost-base     ) > 0.01
      723           or abs( buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     - buf_temp_fbrlib_recipe.sum-income-cost-rubl     ) > 0.01
      724           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base - buf_temp_fbrlib_recipe.sum-income-vat-cost-base ) > 0.01
      725           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl - buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl ) > 0.01
      726               )
      727           then do:
      728            undo, return error
      729               substitute("В документе пр-ва &1 Не совпадают суммы учетных цен для списанного и оприходованного по рецепту товара.&2" +
      730                           "Рецепт: &3&2&4&4по списанному товару&4по оприходованному товару&2"  +
      731                           "Сумма в баз.вал.&4&5&4&4&6&2" +
      732                           "Сумма в &9.&4&7&4&4&8&2"
      733                          , buf_fbr-doc.doc-code
      734                          , chr(10)
      735                          , buf_temp_fbrlib_recipe.recipe-code
      736                          , chr(9)
      737                          , buf_temp_fbrlib_recipe.sum-write-off-cost-base
      738                          , buf_temp_fbrlib_recipe.sum-income-cost-base
      739                          , buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
      740                          , buf_temp_fbrlib_recipe.sum-income-cost-rubl
      741                          , "руб"
      742                          )
      743              +
      744              substitute("НДС в баз.вал.&1&2&1&1&3&4" +
      745                         "НДС в &7.&1&5&1&1&6&4"
      746                        ,  chr(9)
      747                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
      748                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-base
      749                        ,chr(10)
      750                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
      751                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
      752                        ,"руб"
      753                        )       .
      754           end.
      755       end.
      756   end.
      757   end procedure.
      758   procedure fbrlib-fill-sum-fbr-doc :
      759   do
      760   on error undo, return error
      761   :
      762   define input parameter p-fbr-doc-recid  as recid        no-undo.
      763   define input parameter p-mode           as character    no-undo.
      764       define variable vss-description as character init "fbrlib-fill-sum-fbr-doc: "  no-undo.
      765       define buffer buf_fbr-doc           for ub.fbr-doc.
      766       define buffer buf_fbr-line          for ub.fbr-line.
      767       define buffer buf_temp_fbrlib_recipe   for temp_fbrlib_recipe.
      768       define variable v-in-count          as integer       no-undo.
      769       define variable v-out-count         as integer       no-undo.
      770       find first buf_fbr-doc exclusive-lock
      771            where recid ( buf_fbr-doc ) = p-fbr-doc-recid
      772       .
      773       find first buf_temp_fbrlib_recipe no-error.
      774       if not available buf_temp_fbrlib_recipe
      775       then do:
      776           run fbrlib-fill-and-check-temp_fbrlib_recipe in this-procedure (
      777               input buf_fbr-doc.doc-code
      778           ) no-error.
      779           if error-status :error
      780           then do:
      781               undo, return error substitute("&1 Ошибка расчета сумм при заполнении шапки документа производства.&2&3&2&4"
      782                                              , vss-description
      783                                              , chr(10)
      784                                              , error-status:get-message(1)
      785                                              , return-value ).
      786           end.
      787       end.
      788       assign
      789           v-in-count                  = 0
      790           buf_fbr-doc.in-qnty         = 0
      791           buf_fbr-doc.in-sale         = 0
      792           buf_fbr-doc.in-base         = 0
      793           buf_fbr-doc.in-rubl         = 0
      794           buf_fbr-doc.in-vat-base     = 0
      795           buf_fbr-doc.in-vat-rubl     = 0
      796           v-out-count                 = 0
      797           buf_fbr-doc.out-qnty        = 0
      798           buf_fbr-doc.out-sale        = 0
      799           buf_fbr-doc.out-base        = 0
      800           buf_fbr-doc.out-rubl        = 0
      801           buf_fbr-doc.out-vat-base    = 0
      802           buf_fbr-doc.out-vat-rubl    = 0
      803       .
      804       for each buf_temp_fbrlib_recipe
      805       :
      806           assign
      807               v-in-count                  = v-in-count                + buf_temp_fbrlib_recipe.count-income
      808               buf_fbr-doc.in-qnty         = buf_fbr-doc.in-qnty       + buf_temp_fbrlib_recipe.qnty-income
      809               buf_fbr-doc.in-sale         = buf_fbr-doc.in-sale       + buf_temp_fbrlib_recipe.sum-income-sale
      810               buf_fbr-doc.in-base         = buf_fbr-doc.in-base       + buf_temp_fbrlib_recipe.sum-income-cost-base
      811               buf_fbr-doc.in-rubl         = buf_fbr-doc.in-rubl       + buf_temp_fbrlib_recipe.sum-income-cost-rubl
      812               buf_fbr-doc.in-vat-base     = buf_fbr-doc.in-vat-base   + buf_temp_fbrlib_recipe.sum-income-vat-cost-base
      813               buf_fbr-doc.in-vat-rubl     = buf_fbr-doc.in-vat-rubl   + buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
      814               v-out-count                 = v-out-count               + buf_temp_fbrlib_recipe.count-write-off
      815               buf_fbr-doc.out-qnty        = buf_fbr-doc.out-qnty      + buf_temp_fbrlib_recipe.qnty-write-off
      816               buf_fbr-doc.out-sale        = buf_fbr-doc.out-sale      + buf_temp_fbrlib_recipe.sum-write-off-sale
      817               buf_fbr-doc.out-base        = buf_fbr-doc.out-base      + buf_temp_fbrlib_recipe.sum-write-off-cost-base
      818               buf_fbr-doc.out-rubl        = buf_fbr-doc.out-rubl      + buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
      819               buf_fbr-doc.out-vat-base    = buf_fbr-doc.out-vat-base  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
      820               buf_fbr-doc.out-vat-rubl    = buf_fbr-doc.out-vat-rubl  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
      821           .
      822       end.
      823       if ( abs (buf_fbr-doc.in-rubl - buf_fbr-doc.out-rubl) <= 0.01
      824       and   abs (buf_fbr-doc.in-base - buf_fbr-doc.out-base) <= 0.01 )
      825       or p-mode <> 'факт':U
      826       then do:
      827           if substring( buf_fbr-doc.PS, 1, 1 ) = "@"
      828           then do:
      829               assign
      830                   buf_fbr-doc.PS = "@ Строк полученных товаров : "
      831                                   + string( v-out-count, ">>>,>>9" )
      832                                   + chr(10) + "Строк исходных товаров : "
      833                                   + string( v-in-count, ">>>,>>9" )
      834               .
      835           end.
      836       end.
      837       else do:
      838         undo, return error substitute("В док-те пр-ва &1 не совпадают суммы списанных и оприходованных товаров.&2" +
      839                                       "Сумма списанных товаров в &3 - &4&2" +
      840                                       "Сумма оприходованных товаров в &3 - &5&2" +
      841                                       "Сумма оприходованных товаров в &3 - &6&2" +
      842                                       "Сумма списанных товаров в баз.вал. - &7&2" +
      843                                       "Сумма оприходованных товаров в баз.вал. - &8&2"
      844                                       , buf_fbr-doc.doc-code
      845                                       , chr(10)
      846                                       , "рублях"
      847                                       , round( buf_fbr-doc.out-rubl, 2 )
      848                                       , round( buf_fbr-doc.in-rubl,  2 )
      849                                       , round( buf_fbr-doc.in-rubl,  2 )
      850                                       , round( buf_fbr-doc.out-base, 2 )
      851                                       , round( buf_fbr-doc.in-base,  2 )).
      852       end.
      853   end.
      854   end procedure.
      855   procedure fbrlib-calc-prices :
      856   do
      857   on error undo, return error
      858   :
      859   define input parameter p-fbr-line-recid as recid        no-undo.
      860   define input parameter p-price-obj-type as character    no-undo.
      861   define input parameter p-price-obj-code as integer      no-undo.
      862   define output parameter p-current-price as decimal      no-undo.
      863       define variable v-void          as decimal       no-undo.
      864       define variable v-void-char     as character     no-undo.
      865       define variable v-gds-code      as integer       no-undo.
      866       define variable v-b-code        as integer       no-undo.
      867       define buffer buf_fbr-doc   for ub.fbr-doc.
      868       define buffer buf_fbr-line  for ub.fbr-line.
      869       define buffer buf_gds-prt   for ub.gds-prt.
      870       define buffer buf_bar-code  for ub.bar-code.
      871       find first buf_fbr-line no-lock
      872           where recid( buf_fbr-line ) = p-fbr-line-recid
      873       .
      874   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      875   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
      876     (input  buf_fbr-line.artic
      877     ,input  buf_fbr-line.prod-type
      878     ,input  buf_fbr-line.prod-code
      879     ,output v-gds-code
      880     ) no-error .
      881       if error-status :error
      882       then do:
      883         undo, return error substitute("&1 &2 &3&4Ошибка определения кода товара (артикул &7).&4&5&4&6"
      884                                         ,vss-workfile
      885                                         ,vss-revision
      886                                         ,vss-description
      887                                         ,chr(10)
      888                                         , error-status:get-message(1)
      889                                         , return-value
      890                                         , buf_fbr-line.artic
      891                                         ).
      892       end.
      893   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      894     (input  v-gds-code
      895     ,input  ?
      896     ,output v-b-code
      897     ) no-error .
      898       if error-status :error
      899       then do:
      900         undo, return error substitute("&1 &2 &3&4Ошибка определения основного бар-кода товара (код товара) &7.&4&5&4&6"
      901                                         ,vss-workfile
      902                                         ,vss-revision
      903                                         ,vss-description
      904                                         ,chr(10)
      905                                         , error-status:get-message(1)
      906                                         , return-value
      907                                         , v-gds-code
      908                                         ).
      909       end.
      910       if buf_fbr-line.is-calc = no
      911       then do:
      912   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      913   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
      914     (input  p-price-obj-type
      915     ,input  p-price-obj-code
      916     ,input  v-b-code
      917     ,input  0
      918     ,input  0
      919     ,output v-void-char
      920     ,output p-current-price
      921     ,output v-void
      922     ,output v-void
      923     ) no-error .
      924           if error-status :error
      925           then do:
      926             undo, return error substitute("&1 &2 &3&4Ошибка определения продажной цены основного бар-кода товара (код товара) &7.&4&5&4&6"
      927                                             ,vss-workfile
      928                                             ,vss-revision
      929                                             ,vss-description
      930                                             ,chr(10)
      931                                             , error-status:get-message(1)
      932                                             , return-value
      933                                             , v-gds-code
      934                                             ).
      935           end.
      936       end.
      937       else do:
      938           assign
      939               p-current-price = buf_fbr-line.price-sale
      940           .
      941       end.
      942   end.
      943   end procedure.
      944   procedure fbrlib-put-in-order-recipe :
      945   do
      946   on error undo, return error
      947   :
      948   define input parameter p-fbr-doc-doc-code   as character    no-undo.
      949       define variable v-recipe-counter    as integer          no-undo.
      950       define variable v-recipe-amount     as integer init 0   no-undo.
      951       define variable v-child-counter     as integer          no-undo.
      952       define variable v-is-call-cycle     as logical          no-undo.
      953       define variable v-str as character     no-undo.
      954       define buffer buf_in_fbr-line       for ub.fbr-line.
      955       define buffer buf_dress_fbr-line    for ub.fbr-line.
      956       define buffer buf_fbr-line          for ub.fbr-line.
      957       define buffer buf_recipe-gds        for ub.recipe-gds.
      958       define buffer buf_recipe            for ub.recipe.
      959       for each temp_recipe-childs-qnty
      960       :
      961           delete temp_recipe-childs-qnty.
      962       end.
      963       for each temp_recipe-childs
      964       :
      965           delete temp_recipe-childs.
      966       end.
      967       for each temp_recipe-order
      968       :
      969           delete temp_recipe-order.
      970       end.
      971       for each buf_fbr-line no-lock
      972          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
      973       on error undo, return error
      974       :
      975           find first temp_recipe-childs-qnty
      976                where temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
      977           no-error.
      978           if not available temp_recipe-childs-qnty
      979           then do:
      980               create temp_recipe-childs-qnty.
      981               assign
      982                   v-recipe-amount                     = v-recipe-amount + 1
      983                   temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
      984                   temp_recipe-childs-qnty.order       = v-recipe-amount
      985                   temp_recipe-childs-qnty.childs-qnty = 0
      986                   v-child-counter                     = 0
      987               .
      988           end.
      989       end.
      990       for each buf_in_fbr-line no-lock
      991          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
      992            and buf_in_fbr-line.trn-type = 'спи':U
      993       on error undo, return error
      994       :
      995           for each buf_dress_fbr-line no-lock
      996              where buf_dress_fbr-line.doc-code    = p-fbr-doc-doc-code
      997                and buf_dress_fbr-line.trn-type    = 'при':U
      998                and buf_dress_fbr-line.artic       = buf_in_fbr-line.artic
      999                and buf_dress_fbr-line.prod-type   = buf_in_fbr-line.prod-type
     1000                and buf_dress_fbr-line.prod-code   = buf_in_fbr-line.prod-code
     1001           on error undo, return error
     1002           :
     1003               find first buf_recipe no-lock
     1004                    where buf_recipe.recipe-code = buf_dress_fbr-line.recipe-code
     1005               .
     1006               if buf_in_fbr-line.is-comp = yes
     1007               then do:
     1008                   find last temp_recipe-childs-qnty
     1009                       where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     1010                   .
     1011                   assign
     1012                       temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     1013                   .
     1014                   create temp_recipe-childs.
     1015                   assign
     1016                       temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     1017                       temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     1018                       temp_recipe-childs.child-recipe-code    = buf_dress_fbr-line.recipe-code
     1019                   .
     1020               end.
     1021               else do:
     1022               end.
     1023           end.
     1024       end.
     1025       for each buf_in_fbr-line no-lock
     1026          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     1027            and buf_in_fbr-line.trn-type = 'при':U
     1028       on error undo, return error
     1029       :
     1030           find first buf_recipe no-lock
     1031                where buf_recipe.recipe-code = buf_in_fbr-line.recipe-code
     1032           no-error.
     1033           if buf_in_fbr-line.is-comp = no
     1034           then do:
     1035           end.
     1036           else do:
     1037               for each buf_recipe-gds no-lock
     1038               where buf_recipe-gds.recipe-code = buf_in_fbr-line.recipe-code
     1039               :
     1040                   for each buf_fbr-line no-lock
     1041                   where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     1042                       and buf_fbr-line.trn-type    = 'при':U
     1043                       and buf_fbr-line.artic       = buf_recipe-gds.artic
     1044                       and buf_fbr-line.prod-type   = buf_recipe-gds.prod-type
     1045                       and buf_fbr-line.prod-code   = buf_recipe-gds.prod-code
     1046                   on error undo, return error
     1047                   :
     1048                       find first buf_recipe no-lock
     1049                            where buf_recipe.recipe-code = buf_fbr-line.recipe-code
     1050                       .
     1051                       if buf_recipe.recipe-type = 'разделка':U
     1052                       then do:
     1053                       end.
     1054                       else do:
     1055                           find last temp_recipe-childs-qnty
     1056                               where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     1057                           .
     1058                           assign
     1059                               temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     1060                           .
     1061                           create temp_recipe-childs.
     1062                           assign
     1063                               temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     1064                               temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     1065                               temp_recipe-childs.child-recipe-code    = buf_fbr-line.recipe-code
     1066                           .
     1067                       end.
     1068                   end.
     1069               end.
     1070           end.
     1071       end.
     1072       for each temp_recipe-order
     1073       on error undo, return error
     1074       :
     1075           delete temp_recipe-order.
     1076       end.
     1077       assign
     1078           v-fbrlib-recipe-order = 0
     1079       .
     1080       do v-recipe-counter = 1 to v-recipe-amount
     1081       on error undo, return error
     1082       :
     1083           run fbrlib-add-recipe-in-tmp-order in this-procedure (
     1084                 input v-recipe-counter
     1085               , input 0
     1086               , output v-is-call-cycle
     1087           ).
     1088           if v-is-call-cycle = yes
     1089           then do:
     1090               message
     1091                       "Достигнут максимальный уровень вложенности рецептов."
     1092                   skip(1)
     1093                   skip "Невозможно упорядочить рецепты."
     1094                   skip(1)
     1095                   skip "Необходимо изменить структуру рецептов,"
     1096                   skip "используемых при формировании"
     1097                   skip "данного документа производства."
     1098               view-as alert-box error
     1099               title "Невозможно рассчитать документ производства".
     1100               for each temp_recipe-childs-qnty
     1101               :
     1102                   delete temp_recipe-childs-qnty.
     1103               end.
     1104               for each temp_recipe-childs
     1105               :
     1106                   delete temp_recipe-childs.
     1107               end.
     1108               for each temp_recipe-order
     1109               :
     1110                   delete temp_recipe-order.
     1111               end.
     1112               for each temp_recipe-order
     1113               on error undo, return error
     1114               :
     1115                   delete temp_recipe-order.
     1116               end.
     1117               for each temp_fbrlib_recipe
     1118               on error undo, return error
     1119               :
     1120                   delete temp_recipe-order.
     1121               end.
     1122               undo, return error.
     1123           end.
     1124       end.
     1125   end.
     1126   end procedure.
     1127   procedure fbrlib-add-recipe-in-tmp-order :
     1128   do
     1129   on error undo, return error
     1130   :
     1131   define input parameter p-order              as integer      no-undo.
     1132   define input parameter p-call-counter       as integer      no-undo.
     1133   define output parameter p-is-call-cycle     as logical      no-undo.
     1134       define variable v-nodes-counter     as integer       no-undo.
     1135       define buffer buf_c_temp_recipe-childs-qnty for temp_recipe-childs-qnty.
     1136       define buffer buf_temp_recipe-childs-qnty   for temp_recipe-childs-qnty.
     1137       define buffer buf_temp_recipe-childs        for temp_recipe-childs     .
     1138       define buffer buf_temp_recipe-order         for temp_recipe-order.
     1139       assign
     1140           p-call-counter = p-call-counter + 1
     1141       .
     1142       if p-call-counter > 50
     1143       then do:
     1144           assign
     1145               p-is-call-cycle = yes
     1146           .
     1147       end.
     1148       else do:
     1149           find first buf_temp_recipe-childs-qnty
     1150                where buf_temp_recipe-childs-qnty.order = p-order
     1151           .
     1152           find first buf_temp_recipe-order
     1153                where buf_temp_recipe-order.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     1154           no-error.
     1155           if not available buf_temp_recipe-order
     1156           then do:
     1157               do v-nodes-counter = 1 to buf_temp_recipe-childs-qnty.childs-qnty
     1158               :
     1159                   find first buf_temp_recipe-childs
     1160                        where buf_temp_recipe-childs.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     1161                          and buf_temp_recipe-childs.child-code  = v-nodes-counter
     1162                   .
     1163                   find first buf_c_temp_recipe-childs-qnty
     1164                        where buf_c_temp_recipe-childs-qnty.recipe-code = buf_temp_recipe-childs.child-recipe-code
     1165                   .
     1166                   run fbrlib-add-recipe-in-tmp-order in this-procedure (
     1167                         input buf_c_temp_recipe-childs-qnty.order
     1168                       , input p-call-counter
     1169                       , output p-is-call-cycle
     1170                   ).
     1171                   if p-is-call-cycle = yes
     1172                   then do:
     1173                       return.
     1174                   end.
     1175               end.
     1176               assign
     1177                   v-fbrlib-recipe-order = v-fbrlib-recipe-order + 1
     1178               .
     1179               create buf_temp_recipe-order.
     1180               assign
     1181                   buf_temp_recipe-order.recipe-code   = buf_temp_recipe-childs-qnty.recipe-code
     1182                   buf_temp_recipe-order.order         = v-fbrlib-recipe-order
     1183               .
     1184           end.
     1185       end.
     1186   end.
     1187   end procedure.
     1188   procedure fbrlib-get-trn-type :
     1189   define input parameter p-recipe-code    as character    no-undo.
     1190   define input parameter p-goods-recid    as recid        no-undo.
     1191   define input parameter p-is-integration as logical      no-undo.
     1192   define output parameter p-is-comp       as logical      no-undo.
     1193   define output parameter p-trn-type      as character    no-undo.
     1194   define buffer buf_recipe    for ub.recipe.
     1195   define buffer buf_goods     for ub.goods.
     1196   do
     1197   for buf_recipe
     1198     , buf_goods
     1199   on error undo, return error
     1200   :
     1201       find first buf_goods no-lock
     1202            where recid( buf_goods ) = p-goods-recid
     1203       .
     1204       find first buf_recipe no-lock
     1205            where buf_recipe.recipe-code = p-recipe-code
     1206       no-error.
     1207       if not available buf_recipe
     1208       then do:
     1209           assign
     1210               p-is-comp = no
     1211               p-trn-type = "":U
     1212           .
     1213           undo, return.
     1214       end.
     1215       if  buf_recipe.artic        = buf_goods.artic
     1216       and buf_recipe.prod-type    = buf_goods.prod-type
     1217       and buf_recipe.prod-code    = buf_goods.prod-code
     1218       then do:
     1219           assign
     1220               p-is-comp = yes
     1221           .
     1222       end.
     1223       else do:
     1224           assign
     1225               p-is-comp = no
     1226           .
     1227       end.
     1228       case buf_recipe.recipe-type
     1229       :
     1230           when 'производство':U
     1231           then do:
     1232               if p-is-comp = yes
     1233               then do:
     1234                   assign
     1235                       p-trn-type = 'при':U
     1236                   .
     1237               end.
     1238               else do:
     1239                   assign
     1240                       p-trn-type = 'спи':U
     1241                   .
     1242               end.
     1243           end.
     1244           when 'альтернатива':U
     1245           then do:
     1246               if p-is-comp = yes
     1247               then do:
     1248                   assign
     1249                       p-trn-type = 'при':U
     1250                   .
     1251               end.
     1252               else do:
     1253                   assign
     1254                       p-trn-type = 'спи':U
     1255                   .
     1256               end.
     1257           end.
     1258           when 'разделка':U
     1259           then do:
     1260               if p-is-comp = no
     1261               then do:
     1262                   assign
     1263                       p-trn-type = 'при':U
     1264                   .
     1265               end.
     1266               else do:
     1267                   assign
     1268                       p-trn-type = 'спи':U
     1269                   .
     1270               end.
     1271           end.
     1272           when 'комплектация':U
     1273           then do:
     1274               if p-is-integration = ?
     1275               then do:
     1276                   message
     1277                       "Выберите тип операции по рецепту комплектации:"
     1278                       skip (2) "YES - комплектация"
     1279                       skip     "NO - разукомплектация"
     1280                   view-as alert-box question
     1281                   buttons YES-NO
     1282                   update p-is-integration.
     1283               end.
     1284               if p-is-integration = yes
     1285               then do:
     1286                   if p-is-comp = yes
     1287                   then do:
     1288                       assign
     1289                           p-trn-type = 'при':U
     1290                       .
     1291                   end.
     1292                   else do:
     1293                       assign
     1294                           p-trn-type = 'спи':U
     1295                       .
     1296                   end.
     1297               end.
     1298               else do:
     1299                   if p-is-comp = yes
     1300                   then do:
     1301                       assign
     1302                           p-trn-type = 'спи':U
     1303                       .
     1304                   end.
     1305                   else do:
     1306                       assign
     1307                           p-trn-type = 'при':U
     1308                       .
     1309                   end.
     1310               end.
     1311           end.
     1312       end case.
     1313   end.
     1314   end procedure.
     1315   procedure fbrlib-get-mark :
     1316   define input parameter p-recipe-code    as character    no-undo.
     1317   define output parameter p-mark          as logical    no-undo.
     1318   define buffer buf_goods-attr     for ub.goods-attr.
     1319   define buffer buf_recipe-gds for ub.recipe-gds .
     1320       for each buf_recipe-gds no-lock where buf_recipe-gds.recipe-code = p-recipe-code,
     1321            first buf_goods-attr no-lock where buf_goods-attr.gds-code = buf_recipe-gds.gds-code and
     1322                                               buf_goods-attr.attr-code = 'mark-type':U:
     1323            if buf_goods-attr.attr-value <> "" and buf_goods-attr.attr-value <> "not-type" then do:
     1324               p-mark = true .
     1325               return .
     1326            end.
     1327       end.
     1328   end procedure.
     1329   procedure fbrlib-check-temp-tables :
     1330   do
     1331   on error undo, return error
     1332   :
     1333   define input parameter p-title  as character    no-undo.
     1334       define variable v-str               as character        no-undo.
     1335       assign
     1336           v-str = v-str + chr(10) + "temp_recipe-childs-qnty:" + chr(10)
     1337       .
     1338       for each temp_recipe-childs-qnty
     1339       on error undo, return error
     1340       :
     1341           assign
     1342               v-str   = v-str + string( temp_recipe-childs-qnty.recipe-code )
     1343                       + "   " + string( temp_recipe-childs-qnty.childs-qnty )
     1344                       + "   " + string( temp_recipe-childs-qnty.order )
     1345                       + chr(10)
     1346           .
     1347       end.
     1348       assign
     1349           v-str = v-str + "temp_recipe-childs:" + chr(10)
     1350       .
     1351       for each temp_recipe-childs
     1352       on error undo, return error
     1353       :
     1354           assign
     1355               v-str   = v-str + string( temp_recipe-childs.recipe-code )
     1356                       + "   " + string( temp_recipe-childs.child-code )
     1357                       + "   " + string( temp_recipe-childs.child-recipe-code )
     1358                       + chr(10)
     1359           .
     1360       end.
     1361       assign
     1362           v-str = v-str + chr(10) + "temp_recipe-order:" + chr(10)
     1363       .
     1364       for each temp_recipe-order
     1365       on error undo, return error
     1366       :
     1367           assign
     1368               v-str   = v-str + string( temp_recipe-order.recipe-code )
     1369                       + "   " + string( temp_recipe-order.order )
     1370                       + chr(10)
     1371           .
     1372       end.
     1373       assign
     1374           v-str = v-str + chr(10) + "temp_fbrlib_recipe:" + chr(10)
     1375       .
     1376       run writelog in this-procedure ( input "fbr.log", input 0, input p-title ).
     1377       run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     1378       for each temp_fbrlib_recipe
     1379       on error undo, return error
     1380       :
     1381           assign
     1382               v-str   = "recipe-code: "                   + string( temp_fbrlib_recipe.recipe-code                 )
     1383                       + "   " + "count-income: "                  + string( temp_fbrlib_recipe.count-income                )
     1384                       + "   " + "qnty-income: "                   + string( temp_fbrlib_recipe.qnty-income                 )
     1385                       + "   " + "sum-income-sale: "               + string( temp_fbrlib_recipe.sum-income-sale             )
     1386                       + "   " + "sum-income-cost-base: "          + string( temp_fbrlib_recipe.sum-income-cost-base        )
     1387                       + "   " + "sum-income-cost-rubl: "          + string( temp_fbrlib_recipe.sum-income-cost-rubl        )
     1388                       + "   " + "sum-income-vat-cost-base: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-base    )
     1389                       + "   " + "sum-income-vat-cost-rubl: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-rubl    )
     1390                       + "   " + "count-write-off: "               + string( temp_fbrlib_recipe.count-write-off             )
     1391                       + "   " + "qnty-write-off: "                + string( temp_fbrlib_recipe.qnty-write-off              )
     1392                       + "   " + "sum-write-off-sale: "            + string( temp_fbrlib_recipe.sum-write-off-sale          )
     1393                       + "   " + "sum-write-off-cost-base: "       + string( temp_fbrlib_recipe.sum-write-off-cost-base     )
     1394                       + "   " + "sum-write-off-cost-rubl: "       + string( temp_fbrlib_recipe.sum-write-off-cost-rubl     )
     1395                       + "   " + "sum-write-off-vat-cost-base: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-base )
     1396                       + "   " + "sum-write-off-vat-cost-rubl: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-rubl )
     1397                       + chr(10)
     1398           .
     1399           run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     1400       end.
     1401   end.
     1402   end procedure.
     1403   procedure fbrlib-s-coeff-value :
     1404   define input  parameter p-gds-code    as integer        no-undo.
     1405   define input  parameter p-date        as date           no-undo.
     1406   define input  parameter p-obj-type    as character      no-undo.
     1407   define input  parameter p-obj-code    as integer        no-undo.
     1408   define output parameter p-coeff-value as decimal        no-undo.
     1409   define variable vss-description as character init "fbrlib-s-coeff-value-01: определяет значение сезонного коэффициента" no-undo.
     1410       define variable v-date          as date         no-undo.
     1411       define variable v-host-code     as integer      no-undo.
     1412       define buffer buf_goods       for ub.goods.
     1413       define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     1414       define buffer buf_clients     for ub.clients.
     1415       define buffer buf_s-coeff     for ub.s-coeff.
     1416   do
     1417   for buf_goods
     1418     , buf_fbr-gds-obj
     1419     , buf_clients
     1420     , buf_s-coeff
     1421   on error undo, return error return-value
     1422   :
     1423       find first buf_goods no-lock
     1424            where buf_goods.gds-code = p-gds-code
     1425       no-error .
     1426       if not available buf_goods
     1427       then do:
     1428          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден товар с кодом &1", p-gds-code).
     1429       end.
     1430       find first buf_clients no-lock
     1431            where buf_clients.obj-type = p-obj-type
     1432              and buf_clients.obj-code = p-obj-code
     1433       no-error.
     1434       if not available buf_clients
     1435       then do:
     1436          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден объект &1&2", p-obj-type, p-obj-code).
     1437       end.
     1438       assign
     1439           v-date = date(month(p-date), day(p-date), Year(01/01/1996))
     1440       .
     1441       find first buf_fbr-gds-obj no-lock
     1442            where buf_fbr-gds-obj.gds-code = p-gds-code
     1443              and buf_fbr-gds-obj.obj-type = p-obj-type
     1444              and buf_fbr-gds-obj.obj-code = p-obj-code
     1445       no-error.
     1446       if not available buf_fbr-gds-obj
     1447       or buf_fbr-gds-obj.is-season = no
     1448       then do:
     1449           assign
     1450               p-coeff-value = 0
     1451           .
     1452           return.
     1453       end.
     1454   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1455   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1456     (input  p-obj-type
     1457     ,input  p-obj-code
     1458     ,output v-host-code
     1459     )  .
     1460       find last buf_s-coeff no-lock
     1461           where buf_s-coeff.gds-code = p-gds-code
     1462             and buf_s-coeff.host-code = v-host-code
     1463             and buf_s-coeff.obj-type = p-obj-type
     1464             and buf_s-coeff.obj-code = p-obj-code
     1465             and buf_s-coeff.s-date <= v-date
     1466       no-error.
     1467       if available buf_s-coeff
     1468       then do:
     1469           assign
     1470               p-coeff-value = buf_s-coeff.coeff-value
     1471           .
     1472           return.
     1473       end.
     1474       find last buf_s-coeff no-lock
     1475           where buf_s-coeff.gds-code = p-gds-code
     1476             and buf_s-coeff.host-code = v-host-code
     1477             and buf_s-coeff.obj-type = "":U
     1478             and buf_s-coeff.obj-code = 0
     1479             and buf_s-coeff.s-date <= v-date
     1480       no-error.
     1481       if available buf_s-coeff
     1482       then do:
     1483           assign
     1484               p-coeff-value = buf_s-coeff.coeff-value
     1485           .
     1486           return.
     1487       end.
     1488       find last buf_s-coeff no-lock
     1489           where buf_s-coeff.gds-code = p-gds-code
     1490             and buf_s-coeff.host-code = 0
     1491             and buf_s-coeff.obj-type = "":U
     1492             and buf_s-coeff.obj-code = 0
     1493             and buf_s-coeff.s-date <= v-date
     1494       no-error.
     1495       if available buf_s-coeff
     1496       then do:
     1497           assign
     1498               p-coeff-value = buf_s-coeff.coeff-value
     1499           .
     1500       end.
     1501       else do:
     1502           assign
     1503               p-coeff-value = 0
     1504           .
     1505       end.
     1506   end.
     1507   end procedure.
     1508   procedure fbrlib_create-fbr-recipe-gds :
     1509   define input parameter p-doc-code         as character      no-undo.
     1510   define input parameter p-recipe-code      as character      no-undo.
     1511   define input parameter p-prod-type        as character      no-undo.
     1512   define input parameter p-prod-code        as integer        no-undo.
     1513   define input parameter p-artic            as character      no-undo.
     1514   define input parameter p-gds-code         as integer        no-undo.
     1515   define input parameter p-is-waste         as logical        no-undo.
     1516   define input parameter p-proc-number      as integer        no-undo.
     1517   define input parameter p-obj-date         as date           no-undo.
     1518   define input parameter p-obj-type         as character      no-undo.
     1519   define input parameter p-obj-code         as integer        no-undo.
     1520   define input parameter p-calc-method      as decimal        no-undo.
     1521   define input parameter p-coeff-waste      as decimal        no-undo.
     1522   define input parameter p-orig-qnty        as decimal        no-undo.
     1523   define input parameter p-orig-brutto-qnty as decimal        no-undo.
     1524       define variable v-coeff-season  as decimal      no-undo.
     1525       define variable v-void-decimal  as decimal      no-undo.
     1526       define variable v-void-integer  as integer      no-undo.
     1527       define variable v-recipe-type   as character    no-undo.
     1528       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     1529       define buffer buf_goods             for ub.goods.
     1530       define buffer buf_recipe            for ub.recipe.
     1531   do
     1532   for buf_fbr-recipe-gds
     1533     , buf_recipe
     1534     , buf_goods
     1535   on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     1536   :
     1537       find first buf_fbr-recipe-gds exclusive-lock
     1538            where buf_fbr-recipe-gds.doc-code    = p-doc-code
     1539              and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     1540              and buf_fbr-recipe-gds.prod-type   = p-prod-type
     1541              and buf_fbr-recipe-gds.prod-code   = p-prod-code
     1542              and buf_fbr-recipe-gds.artic       = p-artic
     1543       no-error.
     1544       if not available buf_fbr-recipe-gds
     1545       then do:
     1546           create buf_fbr-recipe-gds.
     1547           assign
     1548               buf_fbr-recipe-gds.doc-code           = p-doc-code
     1549               buf_fbr-recipe-gds.recipe-code        = p-recipe-code
     1550               buf_fbr-recipe-gds.prod-type          = p-prod-type
     1551               buf_fbr-recipe-gds.prod-code          = p-prod-code
     1552               buf_fbr-recipe-gds.artic              = p-artic
     1553               buf_fbr-recipe-gds.gds-code           = p-gds-code
     1554               buf_fbr-recipe-gds.is-waste           = p-is-waste
     1555               buf_fbr-recipe-gds.proc-number        = p-proc-number
     1556               buf_fbr-recipe-gds.recipe-qnty        = p-orig-qnty
     1557               buf_fbr-recipe-gds.recipe-brutto-qnty = p-orig-brutto-qnty
     1558           .
     1559           find first buf_goods no-lock
     1560                where buf_goods.prod-type = buf_fbr-recipe-gds.prod-type
     1561                  and buf_goods.prod-code = buf_fbr-recipe-gds.prod-code
     1562                  and buf_goods.artic     = buf_fbr-recipe-gds.artic
     1563           .
     1564           run fbrlib-s-coeff-value in this-procedure (
     1565                 input buf_goods.gds-code
     1566               , input p-obj-date
     1567               , input p-obj-type
     1568               , input p-obj-code
     1569               , output v-coeff-season
     1570           ) no-error.
     1571           if error-status:error
     1572           then do:
     1573               return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
     1574           end.
     1575           assign
     1576               buf_fbr-recipe-gds.qnty         = p-orig-qnty
     1577               buf_fbr-recipe-gds.coeff-value  = v-coeff-season
     1578               buf_fbr-recipe-gds.coeff-waste  = p-coeff-waste
     1579           .
     1580           run fbrlib-get-recipe-type in this-procedure (
     1581                 input buf_fbr-recipe-gds.doc-code
     1582               , input buf_fbr-recipe-gds.recipe-code
     1583               , output v-recipe-type
     1584           ).
     1585           if v-recipe-type <> 'производство':U
     1586           then do:
     1587               assign
     1588                   buf_fbr-recipe-gds.coeff-value  = 0
     1589                   buf_fbr-recipe-gds.coeff-waste  = 0
     1590                   buf_fbr-recipe-gds.calc-method  = 1
     1591                   buf_fbr-recipe-gds.brutto-qnty  = buf_fbr-recipe-gds.qnty
     1592               .
     1593           end.
     1594           else do:
     1595               run fbrlib-calc-brutto in this-procedure (
     1596                     input v-recipe-type
     1597                   , input buf_fbr-recipe-gds.qnty
     1598                   , input buf_fbr-recipe-gds.coeff-value
     1599                   , input buf_fbr-recipe-gds.coeff-waste
     1600                   , input 0
     1601                   , input 3
     1602                   , output v-void-decimal
     1603                   , output v-void-decimal
     1604                   , output buf_fbr-recipe-gds.brutto-qnty
     1605                   , output v-void-integer
     1606               ).
     1607               assign
     1608                   buf_fbr-recipe-gds.calc-method  = p-calc-method
     1609               .
     1610               run fbrlib-calc-brutto in this-procedure (
     1611                     input v-recipe-type
     1612                   , input buf_fbr-recipe-gds.qnty
     1613                   , input buf_fbr-recipe-gds.coeff-value
     1614                   , input buf_fbr-recipe-gds.coeff-waste
     1615                   , input buf_fbr-recipe-gds.brutto-qnty
     1616                   , input buf_fbr-recipe-gds.calc-method
     1617                   , output buf_fbr-recipe-gds.qnty
     1618                   , output v-void-decimal
     1619                   , output v-void-decimal
     1620                   , output v-void-integer
     1621               ).
     1622           end.
     1623       end.
     1624   end.
     1625   end procedure.
     1626   procedure fbrlib-set-default-recipe :
     1627   define input parameter p-obj-type   as character    no-undo.
     1628   define input parameter p-obj-code   as integer      no-undo.
     1629   define input parameter p-gds-code   as integer      no-undo.
     1630       define variable v-artic             as character    no-undo.
     1631       define variable v-prod-type         as character    no-undo.
     1632       define variable v-prod-code         as character    no-undo.
     1633       define variable v-recipe-code       as character    no-undo.
     1634       define variable v-fbr-gds-obj-recid as recid        no-undo.
     1635       define variable v-recipe-found      as logical      no-undo.
     1636       define buffer buf_recipe        for ub.recipe.
     1637       define buffer buf_other_recipe  for ub.recipe.
     1638       define buffer buf_goods         for ub.goods.
     1639       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     1640   do
     1641   for buf_recipe
     1642     , buf_goods
     1643     , buf_fbr-gds-obj
     1644   on error undo, return error
     1645   :
     1646       find first buf_goods no-lock
     1647            where buf_goods.gds-code = p-gds-code
     1648       .
     1649       run fbrlib-get-obj-recipe in this-procedure (
     1650             input p-obj-type
     1651           , input p-obj-code
     1652           , input p-gds-code
     1653           , output v-recipe-code
     1654       ).
     1655       if v-recipe-code <> ""
     1656       then do:
     1657           find first buf_recipe no-lock
     1658               where buf_recipe.recipe-code = v-recipe-code
     1659           no-error.
     1660           if not available buf_recipe
     1661           then do:
     1662               assign
     1663                   v-recipe-code = ""
     1664               .
     1665           end.
     1666       end.
     1667       if v-recipe-code = ""
     1668       then do:
     1669           find first buf_fbr-gds-obj exclusive-lock
     1670                where buf_fbr-gds-obj.obj-type = p-obj-type
     1671                  and buf_fbr-gds-obj.obj-code = p-obj-code
     1672                  and buf_fbr-gds-obj.gds-code = p-gds-code
     1673           no-error.
     1674           if not available buf_fbr-gds-obj
     1675           then do:
     1676               run ref/fgdsobj1.p (
     1677                     input-output v-fbr-gds-obj-recid
     1678                   , input 'ДОБАВЛЕНИЕ':U
     1679                   , input no
     1680                   , input p-gds-code
     1681                   , input p-obj-type
     1682                   , input p-obj-code
     1683                   , input 0
     1684                   , input ""
     1685                   , input 0
     1686                   , input no
     1687                   , input no
     1688                   , input no
     1689                   , input no
     1690                   , input no
     1691                   , input no
     1692               ) no-error.
     1693               if error-status:error
     1694               then do:
     1695                   message
     1696                           vss-workfile vss-revision vss-description
     1697                       skip "Ошибка изменения атрибутов товара на объекте"
     1698                       skip return-value
     1699                       skip trim(error-status :get-message(1))
     1700                               trim(error-status :get-message(2))
     1701                               trim(error-status :get-message(3))
     1702                   view-as alert-box error.
     1703                   undo, return error .
     1704               end.
     1705               find first buf_fbr-gds-obj exclusive-lock
     1706                    where recid( buf_fbr-gds-obj ) = v-fbr-gds-obj-recid
     1707               .
     1708           end.
     1709           assign
     1710               v-recipe-found = no
     1711           .
     1712           for first buf_recipe no-lock
     1713               where buf_recipe.obj-type    = p-obj-type
     1714                 and buf_recipe.obj-code    = p-obj-code
     1715                 and buf_recipe.artic       = buf_goods.artic
     1716                 and buf_recipe.prod-type   = buf_goods.prod-type
     1717                 and buf_recipe.prod-code   = buf_goods.prod-code
     1718                 and buf_recipe.recipe-type = 'производство':U
     1719                 or (
     1720                     buf_recipe.obj-type    = ""
     1721                 and buf_recipe.obj-code    = 0
     1722                 and buf_recipe.artic       = buf_goods.artic
     1723                 and buf_recipe.prod-type   = buf_goods.prod-type
     1724                 and buf_recipe.prod-code   = buf_goods.prod-code
     1725                 and buf_recipe.recipe-type = 'производство':U
     1726                     )
     1727           :
     1728               assign
     1729                   v-recipe-found = yes
     1730                   buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     1731               .
     1732           end.
     1733           if v-recipe-found = no
     1734           then do:
     1735               for first buf_recipe no-lock
     1736                   where buf_recipe.obj-type    = p-obj-type
     1737                     and buf_recipe.obj-code    = p-obj-code
     1738                     and buf_recipe.artic       = buf_goods.artic
     1739                     and buf_recipe.prod-type   = buf_goods.prod-type
     1740                     and buf_recipe.prod-code   = buf_goods.prod-code
     1741                     and buf_recipe.recipe-type <> 'альтернатива':U
     1742                     or (
     1743                         buf_recipe.obj-type    = ""
     1744                     and buf_recipe.obj-code    = 0
     1745                     and buf_recipe.artic       = buf_goods.artic
     1746                     and buf_recipe.prod-type   = buf_goods.prod-type
     1747                     and buf_recipe.prod-code   = buf_goods.prod-code
     1748                     and buf_recipe.recipe-type <> 'альтернатива':U
     1749                         )
     1750               :
     1751                   assign
     1752                       v-recipe-found = yes
     1753                       buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     1754                   .
     1755               end.
     1756               if v-recipe-found = no
     1757               then do:
     1758                   for first buf_recipe no-lock
     1759                       where buf_recipe.obj-type    = p-obj-type
     1760                         and buf_recipe.obj-code    = p-obj-code
     1761                         and buf_recipe.artic       = buf_goods.artic
     1762                         and buf_recipe.prod-type   = buf_goods.prod-type
     1763                         and buf_recipe.prod-code   = buf_goods.prod-code
     1764                         or (
     1765                             buf_recipe.obj-type    = ""
     1766                         and buf_recipe.obj-code    = 0
     1767                         and buf_recipe.artic       = buf_goods.artic
     1768                         and buf_recipe.prod-type   = buf_goods.prod-type
     1769                         and buf_recipe.prod-code   = buf_goods.prod-code
     1770                             )
     1771                   :
     1772                       assign
     1773                           v-recipe-found = yes
     1774                           buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     1775                       .
     1776                   end.
     1777                   if v-recipe-found = no
     1778                   then do:
     1779                       assign
     1780                           buf_fbr-gds-obj.default-recipe-code = ""
     1781                       .
     1782                   end.
     1783               end.
     1784           end.
     1785       end.
     1786   end.
     1787   end procedure.
     1788   procedure fbrlib-get-obj-recipe :
     1789   define input parameter p-obj-type       as character    no-undo.
     1790   define input parameter p-obj-code       as integer      no-undo.
     1791   define input parameter p-gds-code       as integer      no-undo.
     1792   define output parameter p-recipe-code   as character    no-undo.
     1793       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     1794   do
     1795   for buf_fbr-gds-obj
     1796   on error undo, return error
     1797   :
     1798       find first buf_fbr-gds-obj no-lock
     1799            where buf_fbr-gds-obj.obj-type = p-obj-type
     1800              and buf_fbr-gds-obj.obj-code = p-obj-code
     1801              and buf_fbr-gds-obj.gds-code = p-gds-code
     1802       no-error.
     1803       if available buf_fbr-gds-obj
     1804       then do:
     1805           assign
     1806               p-recipe-code = buf_fbr-gds-obj.default-recipe-code
     1807           .
     1808       end.
     1809       else do:
     1810           assign
     1811               p-recipe-code = ""
     1812           .
     1813       end.
     1814   end.
     1815   end procedure.
     1816   procedure fbrlib-create-or-update-recipe-gds :
     1817   define input parameter p-recipe-code    as character        no-undo.
     1818   define input parameter p-gds-code       as integer          no-undo.
     1819   define input parameter p-is-waste       as logical          no-undo.
     1820   define input parameter p-qnty           as decimal          no-undo.
     1821   define input parameter p-proc-number    as integer          no-undo.
     1822   define input parameter p-nws-self       as logical          no-undo.
     1823       define variable v-max-proc-num  as integer      no-undo.
     1824       define variable v-recipe-type   as character    no-undo.
     1825       define buffer buf_goods             for ub.goods.
     1826       define buffer buf_recipe-gds        for ub.recipe-gds.
     1827       define buffer buf_recipe            for ub.recipe.
     1828       define buffer buf_proc_recipe-gds   for ub.recipe-gds.
     1829   do
     1830   for buf_goods
     1831     , buf_recipe-gds
     1832     , buf_recipe
     1833     , buf_proc_recipe-gds
     1834   on error undo, return error
     1835   :
     1836       find first buf_recipe no-lock
     1837            where buf_recipe.recipe-code = p-recipe-code
     1838       .
     1839       find first buf_goods no-lock
     1840            where buf_goods.gds-code = p-gds-code
     1841       .
     1842       find first buf_recipe-gds
     1843            where buf_recipe-gds.recipe-code = p-recipe-code
     1844              and buf_recipe-gds.prod-type   = buf_goods.prod-type
     1845              and buf_recipe-gds.prod-code   = buf_goods.prod-code
     1846              and buf_recipe-gds.artic       = buf_goods.artic
     1847       no-error.
     1848       if not available buf_recipe-gds
     1849       then do:
     1850           create buf_recipe-gds.
     1851           assign
     1852               buf_recipe-gds.recipe-code = p-recipe-code
     1853               buf_recipe-gds.gds-code    = p-gds-code
     1854               buf_recipe-gds.prod-type   = buf_goods.prod-type
     1855               buf_recipe-gds.prod-code   = buf_goods.prod-code
     1856               buf_recipe-gds.artic       = buf_goods.artic
     1857           .
     1858           assign
     1859               buf_recipe-gds.is-waste    = no
     1860               buf_recipe-gds.qnty        = 0
     1861               buf_recipe-gds.coeff-waste = 0
     1862               buf_recipe-gds.brutto-qnty = 0
     1863               buf_recipe-gds.proc-number = 0
     1864               buf_recipe-gds.nws-self    = no
     1865           .
     1866       end.
     1867       assign
     1868           buf_recipe-gds.is-waste    = p-is-waste
     1869       .
     1870       run fbrlib-get-recipe-type in this-procedure (
     1871             input "":U
     1872           , input buf_recipe-gds.recipe-code
     1873           , output v-recipe-type
     1874       ).
     1875       if v-recipe-type <> 'производство':U
     1876       then do:
     1877           assign
     1878               buf_recipe-gds.calc-method = 1
     1879               buf_recipe-gds.qnty        = p-qnty
     1880               buf_recipe-gds.brutto-qnty = p-qnty
     1881               buf_recipe-gds.coeff-waste = 0
     1882           .
     1883       end.
     1884       else do:
     1885           assign
     1886               buf_recipe-gds.calc-method = 1
     1887               buf_recipe-gds.brutto-qnty = p-qnty
     1888           .
     1889           run fbrlib-calc-brutto in this-procedure (
     1890                 input v-recipe-type
     1891               , input 0
     1892               , input 0
     1893               , input buf_recipe-gds.coeff-waste
     1894               , input buf_recipe-gds.brutto-qnty
     1895               , input 1
     1896               , output buf_recipe-gds.qnty
     1897               , output buf_recipe-gds.coeff-waste
     1898               , output buf_recipe-gds.brutto-qnty
     1899               , output buf_recipe-gds.calc-method
     1900           ).
     1901       end.
     1902       assign
     1903           buf_recipe-gds.nws-self    = p-nws-self
     1904       .
     1905       if buf_recipe.recipe-type = 'альтернатива':U
     1906       and buf_recipe-gds.proc-number <> 0
     1907       then do:
     1908       end.
     1909       else do:
     1910           if p-proc-number <> 0
     1911           then do:
     1912               assign
     1913                   buf_recipe-gds.proc-number = p-proc-number
     1914               .
     1915           end.
     1916           else do:
     1917               assign
     1918                   v-max-proc-num = 0
     1919               .
     1920               for each buf_proc_recipe-gds no-lock
     1921                  where buf_proc_recipe-gds.recipe-code = p-recipe-code
     1922               :
     1923                   if recid( buf_proc_recipe-gds ) <> recid( buf_recipe-gds )
     1924                   then do:
     1925                       assign
     1926                           v-max-proc-num = ( if v-max-proc-num < buf_proc_recipe-gds.proc-number then buf_proc_recipe-gds.proc-number else v-max-proc-num )
     1927                       .
     1928                   end.
     1929               end.
     1930               assign
     1931                   buf_recipe-gds.proc-number = v-max-proc-num + 1
     1932               .
     1933           end.
     1934       end.
     1935   end.
     1936   end procedure.
     1937   PROCEDURE fbrlib-create-or-update-recipe :
     1938   define input parameter p-mode               as character    no-undo.
     1939   define input parameter p-obj-type           as character    no-undo.
     1940   define input parameter p-obj-code           as integer      no-undo.
     1941   define input parameter p-recipe-code        as character    no-undo.
     1942   define input parameter p-recipe-type        as character    no-undo.
     1943   define input parameter p-gds-code           as integer      no-undo.
     1944   define input parameter p-name               as character    no-undo.
     1945   define input parameter p-design             as character    no-undo.
     1946   define input parameter p-order              as integer      no-undo.
     1947   define input parameter p-quality            as character    no-undo.
     1948   define input parameter p-ref-num            as character    no-undo.
     1949   define input parameter p-technique          as character    no-undo.
     1950   define input parameter p-template           as character    no-undo.
     1951   define input parameter p-qnty               as decimal      no-undo.
     1952   define input parameter p-portion-qnty       as integer      no-undo.
     1953   define input parameter p-portion-weight     as decimal      no-undo.
     1954   define output parameter p-new-recipe-code   as character    no-undo.
     1955       define variable v-host-code         as integer      no-undo.
     1956       define variable v-fbr-gds-obj-recid as recid        no-undo.
     1957       define buffer buf_recipe    for ub.recipe.
     1958       define buffer buf_goods     for ub.goods.
     1959   do
     1960   for buf_recipe
     1961     , buf_goods
     1962   on error undo, return error
     1963   :
     1964       if p-mode <> 'ДОБАВЛЕНИЕ':U
     1965       and p-mode <> 'ИЗМЕНЕНИЕ':U
     1966       then do:
     1967           message
     1968               skip "Ошибка задания типа операции для создания или измения рецепта."
     1969               skip (1)
     1970               skip "Задан тип операции:" p-mode
     1971           view-as alert-box error.
     1972           undo, return error .
     1973       end.
     1974       if p-recipe-code = ""
     1975       then do:
     1976   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1977   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1978     (input  p-obj-type
     1979     ,input  p-obj-code
     1980     ,output v-host-code
     1981     )  .
     1982           find first buf_goods no-lock
     1983                where buf_goods.gds-code = p-gds-code
     1984           .
     1985           create buf_recipe .
     1986           run fbrcode-gen-recipe-code in this-procedure (
     1987                 input p-obj-type
     1988               , input p-obj-code
     1989               , output buf_recipe.recipe-code
     1990           ).
     1991           assign
     1992               buf_recipe.artic               = buf_goods.artic
     1993               buf_recipe.prod-type           = buf_goods.prod-type
     1994               buf_recipe.prod-code           = buf_goods.prod-code
     1995               buf_recipe.recipe-type         = p-recipe-type
     1996               buf_recipe.recipe-name         = ( if p-name = "" then buf_goods.gds-name else p-name )
     1997               buf_recipe.gds-code            = p-gds-code
     1998               buf_recipe.host-code           = v-host-code
     1999               buf_recipe.obj-type            = p-obj-type
     2000               buf_recipe.obj-code            = p-obj-code
     2001               buf_recipe.recipe-design       = ""
     2002               buf_recipe.recipe-order        = 0
     2003               buf_recipe.recipe-quality      = ""
     2004               buf_recipe.recipe-ref-num      = ""
     2005               buf_recipe.recipe-technique    = ""
     2006               buf_recipe.recipe-template     = ""
     2007               buf_recipe.qnty                = 1.0
     2008               buf_recipe.portion-qnty        = 1
     2009               buf_recipe.portion-weight      = 0
     2010           .
     2011       end.
     2012       if p-name <> ""
     2013       then do:
     2014           assign
     2015               buf_recipe.recipe-name = p-name
     2016           .
     2017       end.
     2018       assign
     2019           buf_recipe.recipe-design       = p-design
     2020           buf_recipe.recipe-order        = p-order
     2021           buf_recipe.recipe-quality      = p-quality
     2022           buf_recipe.recipe-ref-num      = p-ref-num
     2023           buf_recipe.recipe-technique    = p-technique
     2024           buf_recipe.recipe-template     = p-template
     2025           buf_recipe.qnty                = p-qnty
     2026           buf_recipe.portion-qnty        = p-portion-qnty
     2027           buf_recipe.portion-weight      = p-portion-weight
     2028       .
     2029       assign
     2030           p-new-recipe-code = buf_recipe.recipe-code
     2031       .
     2032       run fbrlib-set-default-recipe in this-procedure (
     2033             input p-obj-type
     2034           , input p-obj-code
     2035           , input buf_goods.gds-code
     2036       ).
     2037   end.
     2038   END PROCEDURE.
     2039   PROCEDURE fbrlib-delete-fact-fbr-doc :
     2040   define input parameter parparentproc-handle as widget-handle no-undo .
     2041   define input parameter p-doc-code   as character no-undo.
     2042   define input parameter p-chip-num   like ub.c-trn-doc.chip-num no-undo .
     2043       define variable v-shift-on      as logical      no-undo.
     2044       define variable v-shift-date    as date         no-undo.
     2045       define variable v-shift-num     as integer      no-undo.
     2046       define variable v-shift-name    as character    no-undo.
     2047       define variable v-obj-date      as date         no-undo.
     2048       define variable v-chip-num      as integer      no-undo.
     2049       define buffer buf_fbr-doc       for ub.fbr-doc.
     2050       define buffer buf_fbr-line      for ub.fbr-line.
     2051       define buffer buf_c-fbr-doc     for ub.c-fbr-doc.
     2052       define buffer buf_fbr-recipe     for ub.fbr-recipe.
     2053       define buffer buf_fbr-recipe-gds for ub.fbr-recipe-gds.
     2054       define buffer buf_marking-lines for ub.marking-lines .
     2055       define buffer buf_marking       for ub.marking .
     2056       define buffer buf_goods         for ub.goods .
     2057   do
     2058   for buf_fbr-doc
     2059     , buf_fbr-line
     2060     , buf_c-fbr-doc
     2061     , buf_fbr-recipe
     2062     , buf_fbr-recipe-gds
     2063     , buf_goods
     2064     , buf_marking
     2065     , buf_marking-lines
     2066   on error undo, return error
     2067   :
     2068   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2069     define variable v-cntxt-db-num        as integer   no-undo .
     2070     define variable v-cntxt-userid        as character no-undo .
     2071     define variable v-cntxt-level         as character no-undo .
     2072     define variable v-cntxt-host-code-obj as integer   no-undo .
     2073     define variable v-cntxt-obj-type      as character no-undo .
     2074     define variable v-cntxt-obj-code      as integer   no-undo .
     2075     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2076     define variable v-cntxt-is-admin      as logical   no-undo .
     2077   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2078     run mainmenu_getcntxt in parparentproc-handle
     2079       (output v-cntxt-db-num
     2080       ,output v-cntxt-userid
     2081       ,output v-cntxt-level
     2082       ,output v-cntxt-host-code-obj
     2083       ,output v-cntxt-obj-type
     2084       ,output v-cntxt-obj-code
     2085       ,output v-cntxt-db-num-obj
     2086       ,output v-cntxt-is-admin
     2087       ) .
     2088       if search ("delfbr.err") <> ?
     2089       then do:
     2090           os-delete "delfbr.err".
     2091       end.
     2092     _del-block:
     2093       do transaction
     2094     on error undo _del-block, return error return-value
     2095     on endkey undo _del-block , return error return-value
     2096     on stop undo _del-block , return error return-value
     2097       :
     2098           find first buf_fbr-doc exclusive-lock
     2099                where buf_fbr-doc.doc-code = p-doc-code
     2100           no-error.
     2101           if not available buf_fbr-doc
     2102           then do:
     2103         undo _del-block, return error substitute("&1 &2 &3&4Не найден документ производства &5 для удаления."
     2104                                           ,vss-workfile
     2105                                           ,vss-revision
     2106                                           ,vss-description
     2107                                           ,chr(10)
     2108                                           , p-doc-code).
     2109           end.
     2110           run fbrlib-delete-fact-trn-doc in this-procedure (
     2111               input parparentproc-handle
     2112              ,input p-doc-code
     2113              ,input 'при':U
     2114              ,input p-chip-num
     2115              ,output v-chip-num
     2116           ) no-error.
     2117           if error-status :error
     2118           then do:
     2119               run fbrlib-print-del-error-message in this-procedure .
     2120         undo _del-block, return error.
     2121           end.
     2122           assign
     2123           p-chip-num = (if p-chip-num = ?
     2124                         then v-chip-num
     2125                         else p-chip-num).
     2126           run fbrlib-delete-fact-trn-doc in this-procedure (
     2127               input parparentproc-handle
     2128              ,input p-doc-code
     2129              ,input 'рас':U
     2130              ,input p-chip-num
     2131              ,output v-chip-num
     2132           ) no-error.
     2133           if error-status :error
     2134           then do:
     2135               run fbrlib-print-del-error-message in this-procedure .
     2136         undo _del-block, return error.
     2137           end.
     2138           run fbrlib-delete-fact-trn-doc in this-procedure (
     2139               input parparentproc-handle
     2140              ,input p-doc-code
     2141              ,input 'спи':U
     2142              ,input p-chip-num
     2143              ,output v-chip-num
     2144           ) no-error.
     2145           if error-status :error
     2146           then do:
     2147               run fbrlib-print-del-error-message in this-procedure .
     2148         undo _del-block, return error.
     2149           end.
     2150           create buf_c-fbr-doc.
     2151           buffer-copy buf_fbr-doc to buf_c-fbr-doc.
     2152   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2153   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     2154     (input  buf_fbr-doc.obj-type
     2155     ,input  buf_fbr-doc.obj-code
     2156     ,output v-obj-date
     2157     ) no-error .
     2158           if error-status :error
     2159           or v-obj-date = ?
     2160           then do:
     2161         undo _del-block, return error "Нет текущей даты на объекте документа.".
     2162           end.
     2163   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2164   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2165     (input  buf_fbr-doc.obj-type
     2166     ,input  buf_fbr-doc.obj-code
     2167     ,input  'shift-on=request'
     2168     ,output v-shift-on
     2169     )  .
     2170           if v-shift-on
     2171           then do:
     2172   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2173   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     2174     (input  buf_fbr-doc.obj-type
     2175     ,input  buf_fbr-doc.obj-code
     2176     ,output v-shift-date
     2177     ,output v-shift-num
     2178     ,output v-shift-name
     2179     ) no-error .
     2180               if error-status :error
     2181               then do:
     2182           undo _del-block, return error "Ошибка при поиске текущей смены на объекте".
     2183               end.
     2184           end.
     2185           else do:
     2186               assign
     2187                   v-shift-date = ?
     2188                   v-shift-num  = ?
     2189                   v-shift-name = ?
     2190               .
     2191           end.
     2192           define variable v-today       as date         no-undo.
     2193           define variable v-time        as integer      no-undo.
     2194           run cur-time in this-procedure (
     2195                 output v-today
     2196               , output v-time
     2197           ).
     2198           assign
     2199               buf_c-fbr-doc.chip-num         = (if p-chip-num <> ? then p-chip-num else next-value( s-corr-chip, ub  ))
     2200               buf_c-fbr-doc.corr-user-name   = v-cntxt-userid
     2201               buf_c-fbr-doc.corr-user-db-num = v-cntxt-db-num
     2202               buf_c-fbr-doc.corr-date        = v-today
     2203               buf_c-fbr-doc.corr-time        = v-time
     2204               buf_c-fbr-doc.corr-shift-date  = v-shift-date
     2205               buf_c-fbr-doc.corr-shift-num   = v-shift-num
     2206               buf_c-fbr-doc.corr-shift-name  = v-shift-name
     2207               buf_c-fbr-doc.is-del           = yes
     2208           .
     2209           assign
     2210               buf_fbr-doc.is-del = yes
     2211           .
     2212           for each buf_fbr-line exclusive-lock
     2213              where buf_fbr-line.doc-code = p-doc-code
     2214       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2215       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     2216       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     2217           :
     2218               for first buf_goods no-lock where buf_goods.artic      = buf_fbr-line.artic
     2219                                             and buf_goods.prod-type  = buf_fbr-line.prod-type
     2220                                             and buf_goods.prod-code  = buf_fbr-line.prod-code,
     2221               each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = buf_goods.gds-code
     2222                                                       and buf_marking-lines.obj-type = buf_fbr-doc.obj-type
     2223                                                       and buf_marking-lines.obj-code = buf_fbr-doc.obj-code
     2224                                                       and buf_marking-lines.in-code  = "manufacturing"
     2225                                                       and buf_marking-lines.out-code = buf_fbr-line.doc-code
     2226                                                       and buf_marking-lines.part-code = buf_fbr-line.recipe-code
     2227                                                       and buf_marking-lines.prt-code = 0
     2228               :
     2229                 for first buf_marking exclusive-lock where buf_marking.mark begins buf_marking-lines.mark :
     2230                   assign
     2231                     buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB when buf_fbr-line.is-comp
     2232                   .
     2233                 end .
     2234                 delete buf_marking-lines.
     2235               end .
     2236               delete buf_fbr-line.
     2237           end.
     2238           for each buf_fbr-recipe exclusive-lock
     2239              where buf_fbr-recipe.doc-code = p-doc-code
     2240       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2241       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     2242       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     2243           :
     2244               delete buf_fbr-recipe.
     2245           end.
     2246           for each buf_fbr-recipe-gds exclusive-lock
     2247              where buf_fbr-recipe-gds.doc-code = p-doc-code
     2248       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2249       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     2250       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     2251           :
     2252               delete buf_fbr-recipe-gds.
     2253           end.
     2254           delete buf_fbr-doc.
     2255       end.
     2256   end.
     2257   END PROCEDURE.
     2258   PROCEDURE fbrlib-del-trn-doc :
     2259   do
     2260   on error undo, return error
     2261   :
     2262   define input parameter parparentproc        as widget-handle no-undo .
     2263   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     2264   define input parameter p-trn-doc-type       as character    no-undo.
     2265   define input parameter p-phchip-num         like ub.c-trn-doc.chip-num no-undo .
     2266   define output parameter p-chip-num           like ub.c-trn-doc.chip-num no-undo .
     2267       define variable v-trn-doc-doc-code  as character     no-undo.
     2268       define buffer buf_trn-doc       for ub.trn-doc.
     2269   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2270     define variable v-cntxt-db-num        as integer   no-undo .
     2271     define variable v-cntxt-userid        as character no-undo .
     2272     define variable v-cntxt-level         as character no-undo .
     2273     define variable v-cntxt-host-code-obj as integer   no-undo .
     2274     define variable v-cntxt-obj-type      as character no-undo .
     2275     define variable v-cntxt-obj-code      as integer   no-undo .
     2276     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2277     define variable v-cntxt-is-admin      as logical   no-undo .
     2278   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2279     run mainmenu_getcntxt in parparentproc
     2280       (output v-cntxt-db-num
     2281       ,output v-cntxt-userid
     2282       ,output v-cntxt-level
     2283       ,output v-cntxt-host-code-obj
     2284       ,output v-cntxt-obj-type
     2285       ,output v-cntxt-obj-code
     2286       ,output v-cntxt-db-num-obj
     2287       ,output v-cntxt-is-admin
     2288       ) .
     2289       run fbrcode-trn-doc in this-procedure (
     2290             input 'производство':U
     2291           , input p-fbr-doc-doc-code
     2292           , input p-trn-doc-type
     2293           , output v-trn-doc-doc-code
     2294       ).
     2295       find first buf_trn-doc no-lock
     2296            where buf_trn-doc.doc-code = v-trn-doc-doc-code
     2297       no-error.
     2298       if available buf_trn-doc
     2299       then do:
     2300           run str/del-doc.p (
     2301                 input parparentproc
     2302               , input buf_trn-doc.doc-code
     2303               , input v-cntxt-db-num
     2304               , input "del-doc.err"
     2305               , input ?
     2306               , input p-fbr-doc-doc-code
     2307               , input v-cntxt-userid
     2308               , input 0
     2309               , input p-phchip-num
     2310               , output p-chip-num
     2311           ) no-error.
     2312           if error-status :error
     2313           then do:
     2314             undo, return error substitute("Не удалось удалить складской документ &1, созданный по документу производства &2.&3&4&3&5"
     2315                                           ,v-trn-doc-doc-code
     2316                                           ,p-fbr-doc-doc-code
     2317                                           , chr(10)
     2318                                           , error-status:get-message(1)
     2319                                           , return-value ).
     2320           end.
     2321       end.
     2322   end.
     2323   END PROCEDURE.
     2324   PROCEDURE fbrlib-delete-fact-trn-doc :
     2325   define input parameter parparentproc    as widget-handle    no-undo.
     2326   define input parameter p-fbr-doc-code   as character        no-undo.
     2327   define input parameter p-doc-type       as character    no-undo.
     2328   define input parameter p-ph-chip-num       like ub.c-trn-doc.chip-num no-undo .
     2329   define output parameter p-chip-num      like ub.c-trn-doc.chip-num no-undo .
     2330       define variable v-doc-code          as character        no-undo.
     2331       define variable v-ext-doc-type      as character        no-undo.
     2332       define variable v-trn-doc-recid     as recid            no-undo.
     2333       define variable varchip-code        as integer          no-undo.
     2334       define variable varchip-code2       as integer          no-undo.
     2335       define variable v-chip-counter      as integer          no-undo.
     2336       define buffer buf_trn-doc       for ub.trn-doc.
     2337       define buffer buf_pri_trn-doc   for ub.trn-doc.
     2338       define buffer buf_cons_trn-doc  for ub.trn-doc.
     2339   do
     2340   for buf_trn-doc
     2341     , buf_pri_trn-doc
     2342     , buf_cons_trn-doc
     2343   on error undo, return error
     2344   :
     2345   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2346     define variable v-cntxt-db-num        as integer   no-undo .
     2347     define variable v-cntxt-userid        as character no-undo .
     2348     define variable v-cntxt-level         as character no-undo .
     2349     define variable v-cntxt-host-code-obj as integer   no-undo .
     2350     define variable v-cntxt-obj-type      as character no-undo .
     2351     define variable v-cntxt-obj-code      as integer   no-undo .
     2352     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2353     define variable v-cntxt-is-admin      as logical   no-undo .
     2354   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2355     run mainmenu_getcntxt in parparentproc
     2356       (output v-cntxt-db-num
     2357       ,output v-cntxt-userid
     2358       ,output v-cntxt-level
     2359       ,output v-cntxt-host-code-obj
     2360       ,output v-cntxt-obj-type
     2361       ,output v-cntxt-obj-code
     2362       ,output v-cntxt-db-num-obj
     2363       ,output v-cntxt-is-admin
     2364       ) .
     2365       run fbrcode-trn-doc in this-procedure (
     2366             input 'производство':U
     2367           , input p-fbr-doc-code
     2368           , input p-doc-type
     2369           , output v-doc-code
     2370       ).
     2371       find first buf_trn-doc no-lock
     2372            where buf_trn-doc.doc-code = v-doc-code
     2373       no-error.
     2374       if not available buf_trn-doc
     2375       then do:
     2376           if p-doc-type <> 'спи':U
     2377           then do:
     2378               message
     2379                   "Не найден документ '" p-doc-type "'"
     2380                   "по документу производства " p-fbr-doc-code
     2381               view-as alert-box.
     2382               undo, return error.
     2383           end.
     2384           else do:
     2385           end.
     2386       end.
     2387       else do:
     2388           assign
     2389               v-trn-doc-recid = recid( buf_trn-doc )
     2390               v-ext-doc-type  = buf_trn-doc.ext-doc-type
     2391           .
     2392           if v-ext-doc-type = 'ev':U
     2393           then do:
     2394               find first buf_pri_trn-doc no-lock
     2395                    where buf_pri_trn-doc.out-code     = v-doc-code
     2396                      and buf_pri_trn-doc.ext-doc-type = 'iv':U
     2397               no-error.
     2398               if available buf_pri_trn-doc
     2399               then do:
     2400                   run str/del-doc.p (
     2401                         input parparentproc
     2402                       , input buf_pri_trn-doc.doc-code
     2403                       , input v-cntxt-db-num
     2404                       , input "delfbr.err"
     2405                       , input ?
     2406                       , input p-fbr-doc-code
     2407                       , input v-cntxt-userid
     2408                       , input 0
     2409                       , input (if p-ph-chip-num <> ?
     2410                               then p-ph-chip-num
     2411                               else (if varchip-code <> 0
     2412                                   then varchip-code
     2413                                   else ?)
     2414                               )
     2415                       , output varchip-code2
     2416                   ) no-error.
     2417                   if error-status :error
     2418                   then do:
     2419                     undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     2420                                                   ,buf_pri_trn-doc.doc-code
     2421                                                   ,p-fbr-doc-code
     2422                                                   , chr(10)
     2423                                                   , error-status:get-message(1)
     2424                                                   , return-value ).
     2425                   end.
     2426               end.
     2427           end.
     2428           define buffer buf_out_trn-doc       for ub.trn-doc.
     2429           if p-doc-type = 'при':U
     2430           then do:
     2431               assign
     2432                   v-chip-counter = 0
     2433               .
     2434               for each buf_out_trn-doc exclusive-lock
     2435                  where buf_out_trn-doc.out-code = buf_trn-doc.doc-code
     2436               on error undo, return error
     2437               :
     2438                   assign
     2439                       v-chip-counter = v-chip-counter + 1
     2440                   .
     2441                   if v-chip-counter > 1
     2442                   then do:
     2443                       assign
     2444                           varchip-code = varchip-code2
     2445                       .
     2446                   end.
     2447                   run str/del-doc.p (
     2448                         input parparentproc
     2449                       , input buf_out_trn-doc.doc-code
     2450                       , input v-cntxt-db-num
     2451                       , input "delfbr.err"
     2452                       , input ?
     2453                       , input p-fbr-doc-code
     2454                       , input v-cntxt-userid
     2455                       , input 0
     2456                       , input (if p-ph-chip-num <> ?
     2457                               then p-ph-chip-num
     2458                               else (if varchip-code <> 0
     2459                                   then varchip-code
     2460                                   else ?)
     2461                               )
     2462                       , output varchip-code2
     2463                   ) no-error.
     2464                   if error-status :error
     2465                   then do:
     2466                     undo, return error substitute("Ошибка при удалении складского документа &1, связанного со складским документов прихода &2, созданный по документу производства &3.&4&5&4&6"
     2467                                                   ,buf_out_trn-doc.doc-code
     2468                                                   ,buf_trn-doc.doc-code
     2469                                                   ,p-fbr-doc-code
     2470                                                   , chr(10)
     2471                                                   , error-status:get-message(1)
     2472                                                   , return-value ).
     2473                   end.
     2474               end.
     2475           end.
     2476           run str/del-doc.p (
     2477                 input parparentproc
     2478               , input buf_trn-doc.doc-code
     2479               , input v-cntxt-db-num
     2480               , input "delfbr.err"
     2481               , input ?
     2482               , input p-fbr-doc-code
     2483               , input v-cntxt-userid
     2484               , input 0
     2485               , input (if p-ph-chip-num <> ?
     2486                        then p-ph-chip-num
     2487                        else (if varchip-code <> 0
     2488                              then varchip-code
     2489                              else ?)
     2490                        )
     2491               , output varchip-code2
     2492           ) no-error.
     2493           if error-status :error
     2494           then do:
     2495               undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     2496                                             ,buf_trn-doc.doc-code
     2497                                             ,p-fbr-doc-code
     2498                                             , chr(10)
     2499                                             , error-status:get-message(1)
     2500                                             , return-value ).
     2501           end.
     2502           if p-doc-type = 'рас':U
     2503           or p-doc-type = 'спи':U
     2504           then do:
     2505               assign
     2506                   v-chip-counter = 0
     2507               .
     2508               for each buf_cons_trn-doc no-lock
     2509                  where buf_cons_trn-doc.out-code      = v-doc-code
     2510                    and buf_cons_trn-doc.ext-doc-type  = 'pc':U
     2511               :
     2512                   assign
     2513                       v-trn-doc-recid = recid( buf_cons_trn-doc )
     2514                       v-chip-counter = v-chip-counter + 1
     2515                   .
     2516                   assign
     2517                   varchip-code = if v-chip-counter = 2
     2518                                  then varchip-code2
     2519                                  else varchip-code.
     2520                   run str/del-doc.p (
     2521                         input parparentproc
     2522                       , input buf_cons_trn-doc.doc-code
     2523                       , input v-cntxt-db-num
     2524                       , input "delfbr.err"
     2525                       , input ?
     2526                       , input ?
     2527                       , input v-cntxt-userid
     2528                       , input 0
     2529                       , input (if p-ph-chip-num <> ?
     2530                                then p-ph-chip-num
     2531                                else ( if v-chip-counter = 1
     2532                                       then ?
     2533                                       else varchip-code )
     2534                                )
     2535                       , output varchip-code2
     2536                   ) no-error.
     2537                   if error-status :error
     2538                   then do:
     2539                       undo, return error substitute("Ошибка при удалении складского документа смены типа приобретения &1, созданный по документу производства &2.&3&4&3&5"
     2540                                                     ,buf_cons_trn-doc.doc-code
     2541                                                     ,p-fbr-doc-code
     2542                                                     , chr(10)
     2543                                                     , error-status:get-message(1)
     2544                                                     , return-value ).
     2545                   end.
     2546                   assign
     2547                       p-chip-num = varchip-code2
     2548                   .
     2549               end.
     2550           end.
     2551           assign
     2552               p-chip-num = varchip-code2
     2553           .
     2554       end.
     2555   end.
     2556   END PROCEDURE.
     2557   PROCEDURE fbrlib-print-del-error-message :
     2558   do
     2559   on error undo, return error
     2560   :
     2561       define variable v-user-action   as character    no-undo.
     2562       define variable v-printed       as logical      no-undo.
     2563       message
     2564           vss-workfile vss-revision vss-description
     2565           skip "Ошибка при удалении документа."
     2566           skip return-value
     2567           skip trim(error-status :get-message(1))
     2568           skip trim(error-status :get-message(2))
     2569           skip trim(error-status :get-message(3))
     2570       view-as alert-box error.
     2571       if search ("delfbr.err") <> ?
     2572       then do:
     2573         run gbl/prnfilen.w
     2574           (input  "Ошибки при удалении документа производства"
     2575           ,input  0
     2576           ,input  "delfbr.err"
     2577           ,input  7
     2578           ,output v-user-action
     2579           ,output v-printed
     2580           ).
     2581       end.
     2582   end.
     2583   END PROCEDURE.
     2584   procedure fbrlib-calc-brutto :
     2585   define input parameter p-recipe-type        as character        no-undo.
     2586   define input parameter p-netto              as decimal          no-undo.
     2587   define input parameter p-coeff-value        as decimal          no-undo.
     2588   define input parameter p-coeff-waste        as decimal          no-undo.
     2589   define input parameter p-brutto             as decimal          no-undo.
     2590   define input parameter p-calc-method        as integer          no-undo.
     2591   define output parameter p-new-netto         as decimal          no-undo.
     2592   define output parameter p-new-coeff-waste   as decimal          no-undo.
     2593   define output parameter p-new-brutto        as decimal          no-undo.
     2594   define output parameter p-new-calc-method   as integer          no-undo.
     2595   do
     2596   on error undo, return error
     2597   :
     2598       if p-recipe-type <> 'производство':U
     2599       then do:
     2600           assign
     2601               p-new-coeff-waste = 0
     2602               p-new-calc-method = 1
     2603               p-new-netto       = ( if p-calc-method = 1 then p-brutto else p-netto )
     2604               p-new-brutto      = ( if p-calc-method = 1 then p-brutto else p-netto )
     2605           .
     2606       end.
     2607       else do:
     2608           assign
     2609               p-new-calc-method = p-calc-method
     2610           .
     2611           if p-coeff-waste = 0
     2612           then do:
     2613               assign
     2614                   p-coeff-value = 0
     2615               .
     2616           end.
     2617           case p-calc-method
     2618           :
     2619               when 1
     2620               then do:
     2621                   assign
     2622                       p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     2623                       p-new-coeff-waste   = p-coeff-waste
     2624                       p-new-brutto        = p-brutto
     2625                   .
     2626               end.
     2627               when 2
     2628               then do:
     2629                   assign
     2630                       p-new-netto         = p-netto
     2631                       p-new-coeff-waste   = 100 - p-coeff-value - ( 100 * p-netto / p-brutto )
     2632                       p-new-brutto        = p-brutto
     2633                   .
     2634               end.
     2635               when 3
     2636               then do:
     2637                   assign
     2638                       p-new-netto         = p-netto
     2639                       p-new-coeff-waste   = p-coeff-waste
     2640                       p-new-brutto        = 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste )
     2641                   .
     2642               end.
     2643               otherwise do:
     2644                   define variable v-yesno    as logical      no-undo.
     2645                   assign
     2646                       v-yesno = yes
     2647                   .
     2648                   message
     2649                       "Неверный метод для расчета брутто, нетто и процента потерь."
     2650                       skip "Значение метода должно быть 1, 2 или 3."
     2651                       skip(1)
     2652                       skip "Заданное значение:" p-calc-method
     2653                       skip(1)
     2654                       skip "Установить значение метода расчета 1"
     2655                       skip "(расчет нетто по брутто и проценту потерь)?"
     2656                   view-as alert-box warning
     2657                   buttons yes-no
     2658                   title "Неверное значение метода пересчета в строках документа-производства"
     2659                   update v-yesno
     2660                   .
     2661                   if v-yesno = yes
     2662                   then do:
     2663                       assign
     2664                           p-new-calc-method   = 1
     2665                           p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     2666                           p-new-coeff-waste   = p-coeff-waste
     2667                           p-new-brutto        = p-brutto
     2668                       .
     2669                   end.
     2670                   else do:
     2671                       message
     2672                               vss-workfile vss-revision vss-description
     2673                           skip(1)
     2674                           skip "Ошибка расчета брутто, нетто и процента потерь."
     2675                           skip return-value
     2676                           skip trim(error-status :get-message(1))
     2677                               trim(error-status :get-message(2))
     2678                               trim(error-status :get-message(3))
     2679                       view-as alert-box error
     2680                       title "Неверное значение метода расчета"
     2681                       .
     2682                       undo, return error .
     2683                   end.
     2684               end.
     2685           end case.
     2686       end.
     2687   end.
     2688   end procedure.
     2689   procedure fbrlib-check-brutto :
     2690   define input parameter p-recipe-type        as character        no-undo.
     2691   define input parameter p-netto              as decimal          no-undo.
     2692   define input parameter p-coeff-value        as decimal          no-undo.
     2693   define input parameter p-coeff-waste        as decimal          no-undo.
     2694   define input parameter p-brutto             as decimal          no-undo.
     2695   define input parameter p-calc-method        as integer          no-undo.
     2696   define output parameter p-error-message     as character        no-undo.
     2697   define output parameter p-not-good          as logical          no-undo.
     2698   do
     2699   on error undo, return error
     2700   :
     2701       if p-recipe-type <> 'производство':U
     2702       then do:
     2703           if p-netto <> p-brutto
     2704           or p-coeff-waste <> 0
     2705           then do:
     2706               assign
     2707                   p-not-good      = yes
     2708                   p-error-message = substitute( "Во всех рецептах кроме рецепта производства должно выполняться:&1брутто = нетто и процент потерь = 0.&1&1Тип рецепта: &2&1Брутто: &3&1Нетто: &4&1Процент потерь: &5"
     2709                                           , chr(10), p-recipe-type, p-brutto, p-netto, p-coeff-waste )
     2710               .
     2711           end.
     2712       end.
     2713       else do:
     2714           if p-coeff-waste = 0
     2715           then do:
     2716               assign
     2717                   p-coeff-value = 0
     2718               .
     2719           end.
     2720           case p-calc-method
     2721           :
     2722               when 1
     2723               then do:
     2724                   if round( p-netto, 9 ) <> round( p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100, 9 )
     2725                   then do:
     2726                       assign
     2727                           p-not-good      = yes
     2728                           p-error-message = substitute( "Ошибка расчета нетто ( &2 ) &1 по брутто ( &3 ) &1 и процентам потерь ( &4, &5 )."
     2729                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     2730                       .
     2731                   end.
     2732               end.
     2733               when 2
     2734               then do:
     2735                   if round( p-coeff-waste, 9 ) <> round( 100 - p-coeff-value - ( 100 * p-netto / p-brutto ), 9 )
     2736                   then do:
     2737                       assign
     2738                           p-not-good      = yes
     2739                           p-error-message =  substitute( "Ошибка расчета процента потерь ( &2 ) &1 по нетто ( &3 ) &1 брутто ( &4 ) &1 и cезонному проценту ( &5 )."
     2740                                                   , chr(10), p-coeff-waste, p-netto, p-brutto, p-coeff-value )
     2741                       .
     2742                   end.
     2743               end.
     2744               when 3
     2745               then do:
     2746                   if round( p-brutto, 9 ) <> round( 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste ), 9 )
     2747                   then do:
     2748                       assign
     2749                           p-not-good      = yes
     2750                           p-error-message = substitute( "Ошибка расчета брутто ( &3 ) &1 по нетто ( &2 ) &1 и процентам потерь ( &4, &5 )."
     2751                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     2752                       .
     2753                   end.
     2754               end.
     2755               otherwise do:
     2756                   assign
     2757                       p-not-good      = yes
     2758                       p-error-message = substitute( "Ошибка ввода метода расчета ( &1 ).", p-calc-method )
     2759                   .
     2760               end.
     2761           end case.
     2762       end.
     2763   end.
     2764   end procedure.
     2765   procedure fbrlib-check-fbr-recipe :
     2766   define input parameter p-doc-code       as character        no-undo.
     2767   define input parameter p-recipe-code    as character        no-undo.
     2768   define output parameter p-is-correct    as logical          no-undo.
     2769       define variable v-comp-factor    as decimal      no-undo.
     2770       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     2771       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     2772       define buffer buf_fbr-line          for ub.fbr-line.
     2773   do
     2774   for buf_fbr-recipe
     2775     , buf_fbr-recipe-gds
     2776     , buf_fbr-line
     2777   on error undo, return error
     2778   :
     2779       assign
     2780           p-is-correct = yes
     2781       .
     2782       find first buf_fbr-recipe no-lock
     2783            where buf_fbr-recipe.doc-code    = p-doc-code
     2784              and buf_fbr-recipe.recipe-code = p-recipe-code no-error
     2785       .
     2786       if not available buf_fbr-recipe then do:
     2787         undo, return error substitute("Не найден рецепт (fbr-recipe) с кодом &1 для  документа пр-ва &2", p-recipe-code, p-doc-code).
     2788       end.
     2789       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     2790       then do:
     2791       end.
     2792       else do:
     2793           find first buf_fbr-line no-lock
     2794                where buf_fbr-line.doc-code    = buf_fbr-recipe.doc-code
     2795                  and buf_fbr-line.is-comp     = yes
     2796                  and buf_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     2797                  and buf_fbr-line.artic       = buf_fbr-recipe.artic
     2798                  and buf_fbr-line.prod-type   = buf_fbr-recipe.prod-type
     2799                  and buf_fbr-line.prod-code   = buf_fbr-recipe.prod-code
     2800           .
     2801           assign
     2802               v-comp-factor = buf_fbr-line.fact-qnty / buf_fbr-recipe.qnty
     2803           .
     2804           recipe-line-cycle:
     2805           for each buf_fbr-recipe-gds no-lock
     2806              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     2807                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     2808           on error undo, return error
     2809           :
     2810               find first buf_fbr-line no-lock
     2811                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     2812                      and buf_fbr-line.is-comp     = no
     2813                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     2814                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     2815                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     2816                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     2817               .
     2818               if absolute( buf_fbr-line.fact-qnty / buf_fbr-recipe-gds.brutto-qnty - v-comp-factor ) > 0.000000001
     2819               then do:
     2820                   assign
     2821                       p-is-correct = no
     2822                   .
     2823                   leave recipe-line-cycle.
     2824               end.
     2825           end.
     2826       end.
     2827   end.
     2828   end procedure.
     2829   procedure fbrlib-get-recipe-type :
     2830   define input parameter p-fbr-doc-code   as character        no-undo.
     2831   define input parameter p-recipe-code    as character        no-undo.
     2832   define output parameter p-recipe-type   as character        no-undo.
     2833       define buffer buf_recipe        for ub.recipe.
     2834       define buffer buf_fbr-recipe    for ub.fbr-recipe.
     2835   do
     2836   for buf_recipe
     2837     , buf_fbr-recipe
     2838   on error undo, return error
     2839   :
     2840       if p-fbr-doc-code = ""
     2841       then do:
     2842           find first buf_recipe no-lock
     2843                where buf_recipe.recipe-code = p-recipe-code
     2844           no-error.
     2845           if available buf_recipe
     2846           then do:
     2847               assign
     2848                   p-recipe-type = buf_recipe.recipe-type
     2849               .
     2850           end.
     2851           else do:
     2852               assign
     2853                   p-recipe-type = "":U
     2854               .
     2855           end.
     2856       end.
     2857       else do:
     2858           find first buf_fbr-recipe no-lock
     2859                where buf_fbr-recipe.doc-code      = p-fbr-doc-code
     2860                  and buf_fbr-recipe.recipe-code   = p-recipe-code
     2861           no-error.
     2862           if available buf_fbr-recipe
     2863           then do:
     2864               assign
     2865                   p-recipe-type = buf_fbr-recipe.recipe-type
     2866               .
     2867           end.
     2868           else do:
     2869               assign
     2870                   p-recipe-type = "":U
     2871               .
     2872           end.
     2873       end.
     2874   end.
     2875   end procedure.
     2876   PROCEDURE calc-comp-from-ingr :
     2877   define input parameter p-fbr-v-fbr-doc-line-recid           as recid        no-undo.
     2878   define input parameter p-fact-qnty                          as decimal      no-undo.
     2879   define output parameter p-comp-fbr-v-fbr-doc-line-recid     as recid        no-undo.
     2880   define output parameter p-comp-qnty                         as decimal      no-undo.
     2881       define variable v-ingr-qnty     as decimal       no-undo.
     2882       define buffer buf_i_fbr-line    for ub.fbr-line.
     2883       define buffer buf_fbr-line      for ub.fbr-line.
     2884       define buffer buf_recipe        for ub.fbr-recipe.
     2885       define buffer buf_recipe-gds    for ub.fbr-recipe-gds.
     2886   do
     2887   for buf_i_fbr-line
     2888     , buf_fbr-line
     2889     , buf_recipe
     2890     , buf_recipe-gds
     2891   on error undo, return error
     2892   :
     2893       find first buf_i_fbr-line no-lock
     2894            where recid( buf_i_fbr-line ) = p-fbr-v-fbr-doc-line-recid
     2895       .
     2896       find first buf_recipe no-lock
     2897            where buf_recipe.doc-code      = buf_i_fbr-line.doc-code
     2898              and buf_recipe.recipe-code   = buf_i_fbr-line.recipe-code
     2899       no-error.
     2900       if not available buf_recipe
     2901       then do:
     2902           message
     2903                   vss-workfile vss-revision vss-description
     2904               skip "В строке производства не указан рецепт."
     2905               skip "Невозможно рассчитать количество составного товара."
     2906               skip return-value
     2907               skip trim(error-status :get-message(1))
     2908                   trim(error-status :get-message(2))
     2909                   trim(error-status :get-message(3))
     2910           view-as alert-box error.
     2911           undo, return error .
     2912       end.
     2913       if buf_recipe.recipe-type = 'альтернатива':U
     2914       then do:
     2915           for each buf_fbr-line no-lock
     2916              where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     2917                and buf_fbr-line.trn-type    = buf_i_fbr-line.trn-type
     2918                and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     2919           on error undo, return error
     2920           :
     2921               find first buf_recipe-gds no-lock
     2922                    where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     2923                      and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     2924                      and buf_recipe-gds.artic       = buf_fbr-line.artic
     2925                      and buf_recipe-gds.prod-type   = buf_fbr-line.prod-type
     2926                      and buf_recipe-gds.prod-code   = buf_fbr-line.prod-code
     2927               .
     2928               assign
     2929                   p-comp-qnty         = p-comp-qnty       + ( buf_fbr-line.fact-qnty * buf_recipe-gds.brutto-qnty )
     2930               .
     2931           end.
     2932           assign
     2933               p-comp-qnty         = p-comp-qnty       / buf_recipe.qnty
     2934           .
     2935       end.
     2936       else do:
     2937           find first buf_recipe-gds no-lock
     2938                where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     2939                  and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     2940                  and buf_recipe-gds.artic       = buf_i_fbr-line.artic
     2941                  and buf_recipe-gds.prod-type   = buf_i_fbr-line.prod-type
     2942                  and buf_recipe-gds.prod-code   = buf_i_fbr-line.prod-code
     2943           .
     2944           assign
     2945               p-comp-qnty = p-fact-qnty / buf_recipe-gds.brutto-qnty * buf_recipe.qnty
     2946           .
     2947       end.
     2948       find first buf_fbr-line no-lock
     2949            where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     2950              and buf_fbr-line.is-comp     = yes
     2951              and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     2952       .
     2953       assign
     2954           p-comp-fbr-v-fbr-doc-line-recid = recid( buf_fbr-line )
     2955       .
     2956   end.
     2957   END PROCEDURE.
     2958   PROCEDURE get-temp_dressing-ingr-used-qnty :
     2959   define input parameter p-recipe-code    as character    no-undo.
     2960   define input parameter p-gds-code       as integer      no-undo.
     2961   define output parameter p-line-qnty     as decimal      no-undo.
     2962   define output parameter p-used-qnty     as decimal      no-undo.
     2963   define output parameter p-recipe-qnty   as decimal      no-undo.
     2964       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     2965   do
     2966   for buf_temp_dressing-ingr
     2967   on error undo, return error
     2968   :
     2969       find first buf_temp_dressing-ingr no-lock
     2970            where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     2971              and buf_temp_dressing-ingr.gds-code    = p-gds-code
     2972       no-error.
     2973       if available buf_temp_dressing-ingr
     2974       then do:
     2975           assign
     2976               p-line-qnty     = buf_temp_dressing-ingr.line-qnty
     2977               p-used-qnty     = buf_temp_dressing-ingr.used-qnty
     2978               p-recipe-qnty   = buf_temp_dressing-ingr.recipe-qnty
     2979           .
     2980       end.
     2981       else do:
     2982           assign
     2983               p-line-qnty     = 0
     2984               p-used-qnty     = 0
     2985               p-recipe-qnty   = 0
     2986           .
     2987       end.
     2988   end.
     2989   END PROCEDURE.
     2990   PROCEDURE fbrlib_adjust-recipe :
     2991   do
     2992   on error undo, return error
     2993   :
     2994   define input parameter parparentproc as widget-handle no-undo .
     2995   define input parameter p-fbrhist-handle as handle no-undo .
     2996   define input parameter p-doc-code       as character    no-undo.
     2997   define input parameter p-recipe-code    as character    no-undo.
     2998   define input parameter p-price-sale-obj-type as character no-undo .
     2999   define input parameter p-price-sale-obj-code as integer no-undo .
     3000       define variable v-recipe-qnty       as decimal      no-undo.
     3001       define variable v-comp-qnty         as decimal      no-undo.
     3002       define variable v-recipe-gds-qnty   as decimal      no-undo.
     3003       define variable v-ingr-qnty         as decimal      no-undo.
     3004       define variable v-qnty              as decimal      no-undo.
     3005       define variable v-coeff-waste       as decimal      no-undo.
     3006       define variable v-brutto-qnty       as decimal      no-undo.
     3007       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     3008       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     3009       define buffer buf_fbr-line          for ub.fbr-line.
     3010       define buffer buf_el_fbr-recipe-gds for ub.fbr-recipe-gds.
     3011       find first buf_fbr-recipe no-lock
     3012            where buf_fbr-recipe.doc-code      = p-doc-code
     3013              and buf_fbr-recipe.recipe-code   = p-recipe-code
     3014       .
     3015       assign
     3016           v-recipe-qnty = buf_fbr-recipe.qnty
     3017       .
     3018       find first buf_fbr-line no-lock
     3019            where buf_fbr-line.doc-code    = p-doc-code
     3020              and buf_fbr-line.is-comp     = yes
     3021              and buf_fbr-line.recipe-code = p-recipe-code
     3022       .
     3023       assign
     3024           v-comp-qnty = buf_fbr-line.fact-qnty
     3025       .
     3026       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     3027       then do:
     3028       end.
     3029       else do:
     3030           for each buf_fbr-recipe-gds no-lock
     3031              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     3032                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     3033           on error undo, return error
     3034           :
     3035               find first buf_fbr-line no-lock
     3036                    where buf_fbr-line.doc-code    = p-doc-code
     3037                      and buf_fbr-line.is-comp     = no
     3038                      and buf_fbr-line.recipe-code = p-recipe-code
     3039                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3040                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3041                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3042               .
     3043               if buf_fbr-line.fact-qnty / v-comp-qnty <> buf_fbr-recipe-gds.brutto-qnty / v-recipe-qnty
     3044               then do:
     3045                   do transaction
     3046                   on error undo, return error
     3047                   :
     3048                       find first buf_el_fbr-recipe-gds exclusive-lock
     3049                            where recid( buf_el_fbr-recipe-gds ) = recid( buf_fbr-recipe-gds )
     3050                       .
     3051                       assign
     3052                           buf_el_fbr-recipe-gds.calc-method   = 1
     3053                           buf_el_fbr-recipe-gds.brutto-qnty   = buf_fbr-line.fact-qnty * v-recipe-qnty / v-comp-qnty
     3054                       .
     3055                       run fbrlib-calc-brutto in this-procedure (
     3056                             input buf_fbr-recipe.recipe-type
     3057                           , input 0
     3058                           , input buf_el_fbr-recipe-gds.coeff-value
     3059                           , input buf_el_fbr-recipe-gds.coeff-waste
     3060                           , input buf_el_fbr-recipe-gds.brutto-qnty
     3061                           , input 1
     3062                           , output buf_el_fbr-recipe-gds.qnty
     3063                           , output buf_el_fbr-recipe-gds.coeff-waste
     3064                           , output buf_el_fbr-recipe-gds.brutto-qnty
     3065                           , output buf_el_fbr-recipe-gds.calc-method
     3066                       ).
     3067                   end.
     3068               end.
     3069           end.
     3070           run fbrlib_adjust-doc-lines in this-procedure (
     3071                 input parparentproc
     3072               , input p-fbrhist-handle
     3073               , input p-doc-code
     3074               , input p-recipe-code
     3075               , input p-price-sale-obj-type
     3076               , input p-price-sale-obj-code
     3077           ).
     3078       end.
     3079   end.
     3080   END PROCEDURE.
     3081   PROCEDURE fbrlib_adjust-doc-lines :
     3082   define input parameter parparentproc as widget-handle no-undo .
     3083   define input parameter p-fbrhist-handle as handle no-undo .
     3084   define input parameter p-doc-code       as character    no-undo.
     3085   define input parameter p-recipe-code    as character    no-undo.
     3086   define input parameter p-price-sale-obj-type as character no-undo .
     3087   define input parameter p-price-sale-obj-code as integer no-undo .
     3088   define variable v-comp-qnty         as decimal      no-undo.
     3089   define variable v-trn-type          as character    no-undo.
     3090   define variable v-ingr-qnty         as decimal      no-undo.
     3091   define variable v-recipe-qnty       as decimal      no-undo.
     3092   define variable v-fbr-v-fbr-doc-line-recid    as recid        no-undo.
     3093   define buffer buf_fbr-recipe        for ub.fbr-recipe.
     3094   define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     3095   define buffer buf_fbr-line          for ub.fbr-line.
     3096   define buffer buf_coeff_fbr-line    for ub.fbr-line.
     3097   define buffer buf_goods             for ub.goods.
     3098   define buffer buf_fbr-doc           for ub.fbr-doc.
     3099   do
     3100   for buf_fbr-recipe
     3101     , buf_fbr-recipe-gds
     3102     , buf_fbr-line
     3103     , buf_coeff_fbr-line
     3104     , buf_goods
     3105     , buf_fbr-doc
     3106   on error undo, return error
     3107   :
     3108       find first buf_fbr-line no-lock
     3109            where buf_fbr-line.doc-code      = p-doc-code
     3110              and buf_fbr-line.is-comp       = yes
     3111              and buf_fbr-line.recipe-code   = p-recipe-code
     3112       .
     3113       find first buf_fbr-doc no-lock
     3114            where buf_fbr-doc.doc-code      = p-doc-code
     3115       .
     3116       assign
     3117           v-comp-qnty = buf_fbr-line.fact-qnty
     3118           v-trn-type  = buf_fbr-line.trn-type
     3119       .
     3120       find first buf_fbr-recipe no-lock
     3121            where buf_fbr-recipe.doc-code    = p-doc-code
     3122              and buf_fbr-recipe.recipe-code = p-recipe-code
     3123       .
     3124       assign
     3125       v-recipe-qnty = buf_fbr-recipe.qnty
     3126       .
     3127       do transaction
     3128       on error undo, return error
     3129       :
     3130           for each buf_fbr-recipe-gds no-lock
     3131              where buf_fbr-recipe-gds.doc-code      = p-doc-code
     3132                and buf_fbr-recipe-gds.recipe-code   = p-recipe-code
     3133           on error undo, return error
     3134           :
     3135               find first buf_fbr-line no-lock
     3136                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     3137                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     3138                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3139                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3140                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3141               no-error.
     3142               if not available buf_fbr-line
     3143               then do:
     3144                   find first buf_goods no-lock
     3145                        where buf_goods.artic      = buf_fbr-recipe-gds.artic
     3146                          and buf_goods.prod-type  = buf_fbr-recipe-gds.prod-type
     3147                          and buf_goods.prod-code  = buf_fbr-recipe-gds.prod-code
     3148                   .
     3149                   run str/fbr-crln.p (
     3150                         input parparentproc
     3151                       , input recid( buf_fbr-doc )
     3152                       , input recid( buf_goods )
     3153                       , input buf_fbr-recipe-gds.recipe-code
     3154                       , input v-trn-type
     3155                       , input no
     3156                       , input no
     3157                       , input buf_fbr-doc.obj-type
     3158                       , input buf_fbr-doc.obj-code
     3159                       , output v-fbr-v-fbr-doc-line-recid
     3160                   ).
     3161                   find first buf_fbr-line no-lock
     3162                        where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     3163                          and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     3164                          and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3165                          and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3166                          and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3167                   no-error.
     3168                   if not available buf_fbr-line
     3169                   then do:
     3170                       undo, return error substitute("Не удалось создать строку документа производства &1 &2&3&4"
     3171                                                      , p-doc-code
     3172                                                      , buf_fbr-recipe-gds.artic
     3173                                                      , buf_fbr-recipe-gds.prod-type
     3174                                                      , buf_fbr-recipe-gds.prod-code).
     3175                   end.
     3176               end.
     3177               find first buf_coeff_fbr-line exclusive-lock
     3178                    where recid( buf_coeff_fbr-line ) = recid( buf_fbr-line )
     3179               .
     3180               if buf_coeff_fbr-line.calc-method <> buf_fbr-recipe-gds.calc-method
     3181               or buf_coeff_fbr-line.coeff-value <> buf_fbr-recipe-gds.coeff-value
     3182               or buf_coeff_fbr-line.coeff-waste <> buf_fbr-recipe-gds.coeff-waste
     3183               then do:
     3184                   assign
     3185                       buf_coeff_fbr-line.calc-method = buf_fbr-recipe-gds.calc-method
     3186                       buf_coeff_fbr-line.coeff-value = buf_fbr-recipe-gds.coeff-value
     3187                       buf_coeff_fbr-line.coeff-waste = buf_fbr-recipe-gds.coeff-waste
     3188                   .
     3189               end.
     3190           end.
     3191       end.
     3192       define variable v-need-goods    as logical       no-undo.
     3193       define variable v-need-goods-list       as character     no-undo.
     3194       define variable v-need-goods-qnty-list  as character     no-undo.
     3195       find first buf_fbr-line no-lock
     3196            where buf_fbr-line.doc-code    = buf_fbr-doc.doc-code
     3197              and buf_fbr-line.is-comp     = yes
     3198              and buf_fbr-line.recipe-code = p-recipe-code
     3199       .
     3200       run str/fbr-qnty.p (
     3201             input parparentproc
     3202           , input p-fbrhist-handle
     3203           , input recid( buf_fbr-doc )
     3204           , input recid( buf_fbr-line )
     3205           , input no
     3206           , input "ingr"
     3207           , input no
     3208           , input p-price-sale-obj-type
     3209           , input p-price-sale-obj-code
     3210           , input no
     3211           , input no
     3212           , input no
     3213           , output v-need-goods
     3214           , output v-need-goods-list
     3215           , output v-need-goods-qnty-list
     3216       ).
     3217   end.
     3218   END PROCEDURE.
     3219   procedure fbrlib_check-before-close :
     3220   define input parameter p-doc-code as character no-undo .
     3221   define variable same-sale as decimal no-undo .
     3222   define variable is-waste as logical no-undo .
     3223   define variable fix-price as logical no-undo .
     3224   define buffer buf_fbr-doc for ub.fbr-doc.
     3225   define buffer buf_fbr-line for ub.fbr-line.
     3226   define buffer buf_goods for ub.goods.
     3227   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     3228   do
     3229   on error undo, return error
     3230   :
     3231     for each buf_fbr-line no-lock
     3232         where buf_fbr-line.doc-code = p-doc-code
     3233       , each buf_goods no-lock
     3234         where buf_goods.artic     = buf_fbr-line.artic
     3235           and buf_goods.prod-type = buf_fbr-line.prod-type
     3236           and buf_goods.prod-code = buf_fbr-line.prod-code
     3237     break by buf_fbr-line.prod-type
     3238           by buf_fbr-line.prod-code
     3239           by buf_fbr-line.artic
     3240     :
     3241       if first-of (buf_fbr-line.artic)
     3242       then do:
     3243         assign
     3244         same-sale = buf_fbr-line.price-sale
     3245         is-waste = (buf_fbr-line.rsrv-qnty = ?)
     3246         fix-price = buf_fbr-line.is-calc
     3247         .
     3248       end.
     3249       if same-sale <> buf_fbr-line.price-sale
     3250       then do:
     3251           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром должна быть указана одна и та же цена продажи."
     3252                                         ,p-doc-code
     3253                                         ,buf_goods.artic
     3254                                         ,buf_goods.gds-name
     3255                                         ,chr(10)).
     3256       end.
     3257       if fix-price <> buf_fbr-line.is-calc then do:
     3258           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром цена должна быть фиксирована или нет."
     3259                                         ,p-doc-code
     3260                                         ,buf_goods.artic
     3261                                         ,buf_goods.gds-name
     3262                                         ,chr(10)).
     3263       end.
     3264       if is-waste <> (buf_fbr-line.rsrv-qnty = ?)
     3265       then do:
     3266         undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа этот товар должен быть отходом либо не отходом."
     3267                                         ,p-doc-code
     3268                                         ,buf_goods.artic
     3269                                         ,buf_goods.gds-name
     3270                                         ,chr(10)).
     3271       end.
     3272       if buf_fbr-line.rsrv-qnty <> ?
     3273       and buf_goods.gds-type <> 'у':U
     3274       and ( buf_fbr-line.price-sale <= 0 or buf_fbr-line.price-sale = ?  )
     3275       and buf_fbr-line.fact-qnty <> 0
     3276       then do:
     3277         if buf_fbr-line.trn-type     = 'при':U  then for first buf_fbr-doc where buf_fbr-doc.doc-code =  p-doc-code no-lock:
     3278           if  can-find(first buf_fbr-gds-obj no-lock where
     3279                   buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     3280               AND buf_fbr-gds-obj.obj-type = buf_fbr-doc.obj-type
     3281               AND buf_fbr-gds-obj.obj-code = buf_fbr-doc.obj-code
     3282               and buf_fbr-gds-obj.is-null-price  )  then .
     3283                     else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     3284                                         ,p-doc-code
     3285                                         ,buf_goods.artic
     3286                                         ,buf_goods.gds-name
     3287                                         ,chr(10)
     3288                                         ,buf_fbr-line.recipe-code
     3289                                         ).
     3290         end.
     3291         else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     3292                                         ,p-doc-code
     3293                                         ,buf_goods.artic
     3294                                         ,buf_goods.gds-name
     3295                                         ,chr(10)
     3296                                         ,buf_fbr-line.recipe-code
     3297                                         ).
     3298       end.
     3299     end.
     3300   end.
     3301   end procedure.
     3302   procedure proc-alt-shift-f2:
     3303     if not ibs.th.gbl.gbl-var:rcode
     3304   then
     3305     run gbl\inidebug.p .
     3306   end.
     3307   procedure proc-alt-shift-f3:
     3308     run gbl/prvssinf.p
     3309       ( input this-procedure
     3310       ) .
     3311   end.
     3312   define variable v-inform-launched as logical no-undo initial false .
     3313   procedure proc-alt-shift-f4:
     3314     define variable v-action as character no-undo .
     3315     if v-inform-launched = false then do:
     3316       assign
     3317         v-inform-launched = true
     3318       .
     3319       run gbl/d-inform.w
     3320         (  input self
     3321         ,  input this-procedure
     3322         , output v-action
     3323         ) no-error .
     3324       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     3325       assign
     3326         v-inform-launched = false
     3327       .
     3328     end.
     3329   end.
     3330   procedure proc-alt-f1:
     3331     run gbl/corrhelp.p
     3332       (input this-procedure
     3333       ) .
     3334   end .
     3335   on alt-shift-f2 anywhere do:
     3336     run proc-alt-shift-f2.
     3337   end.
     3338   on alt-shift-f3 anywhere do:
     3339     run proc-alt-shift-f3 in this-procedure .
     3340   end.
     3341   on alt-shift-f4 anywhere do:
     3342     run proc-alt-shift-f4 in this-procedure.
     3343   end.
     3344   on alt-f1 anywhere do:
     3345     run proc-alt-f1 in this-procedure .
     3346   end.
     3347   DEFINE BUTTON b-cancel
     3348        LABEL "&Отмена"
     3349        SIZE 10 BY 1.
     3350   DEFINE BUTTON b-exit
     3351        LABEL "&Ввод"
     3352        SIZE 10 BY 1
     3353        BGCOLOR 8 .
     3354   DEFINE BUTTON b-help
     3355        LABEL "Помощ&ь"
     3356        SIZE 10 BY 1
     3357        BGCOLOR 8 .
     3358   DEFINE VARIABLE fi-brutto AS DECIMAL FORMAT ">,>>>,>>9.999":U INITIAL 0
     3359        LABEL "Брутто"
     3360        VIEW-AS FILL-IN
     3361        SIZE 14 BY 1 NO-UNDO.
     3362   DEFINE VARIABLE fi-coeff-value AS DECIMAL FORMAT ">>9.999":U INITIAL 0
     3363        LABEL "ПроцСез"
     3364        VIEW-AS FILL-IN
     3365        SIZE 14 BY 1 NO-UNDO.
     3366   DEFINE VARIABLE fi-coeff-waste AS DECIMAL FORMAT ">>9.999":U INITIAL 0
     3367        LABEL "ПроцПот"
     3368        VIEW-AS FILL-IN
     3369        SIZE 14 BY 1 NO-UNDO.
     3370   DEFINE VARIABLE fi-goods AS CHARACTER FORMAT "X(256)":U
     3371        LABEL "Товар"
     3372        VIEW-AS FILL-IN
     3373        SIZE 53.25 BY 1
     3374        FGCOLOR 4  NO-UNDO.
     3375   DEFINE VARIABLE fi-netto AS DECIMAL FORMAT ">,>>>,>>9.999":U INITIAL 0
     3376        LABEL "Нетто"
     3377        VIEW-AS FILL-IN
     3378        SIZE 14 BY 1 NO-UNDO.
     3379   DEFINE VARIABLE fi-recipe-code AS CHARACTER FORMAT "X(256)":U
     3380        LABEL "Рецепт"
     3381        VIEW-AS FILL-IN
     3382        SIZE 53.25 BY 1
     3383        FGCOLOR 4  NO-UNDO.
     3384   DEFINE VARIABLE rs-calc-method AS INTEGER
     3385        VIEW-AS RADIO-SET VERTICAL
     3386        RADIO-BUTTONS
     3387   "Нетто   через Брутто и ПроцПот", 1,
     3388   "ПроцПот через Брутто и Нетто", 2,
     3389   "Брутто  через Нетто  и ПроцПот", 3
     3390        SIZE 36.5 BY 4.5 NO-UNDO.
     3391   DEFINE VARIABLE tb-is-waste AS LOGICAL INITIAL no
     3392        LABEL "Отходы"
     3393        VIEW-AS TOGGLE-BOX
     3394        SIZE 11.13 BY .83 NO-UNDO.
     3395   DEFINE FRAME Dialog-Frame
     3396        b-exit AT ROW 1.17 COL 2
     3397        b-cancel AT ROW 1.17 COL 12
     3398        b-help AT ROW 1.21 COL 56.88
     3399        fi-recipe-code AT ROW 2.5 COL 11.38 COLON-ALIGNED
     3400        fi-goods AT ROW 3.71 COL 11.38 COLON-ALIGNED
     3401        tb-is-waste AT ROW 5 COL 13.5
     3402        fi-coeff-value AT ROW 6.5 COL 11.5 COLON-ALIGNED
     3403        rs-calc-method AT ROW 7.75 COL 29 NO-LABEL
     3404        fi-netto AT ROW 8 COL 11.5 COLON-ALIGNED
     3405        fi-coeff-waste AT ROW 9.5 COL 11.5 COLON-ALIGNED
     3406        fi-brutto AT ROW 11 COL 11.5 COLON-ALIGNED
     3407        SPACE(40.87) SKIP(1.12)
     3408       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     3409            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     3410            TITLE "Товар рецепта".
     3411   ASSIGN
     3412          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     3413          FRAME Dialog-Frame:HIDDEN           = TRUE.
     3414   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     3415   DO:
     3416     APPLY "END-ERROR":U TO SELF.
     3417   END.
     3418   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
     3419   DO:
     3420       assign
     3421           p-success = no
     3422       .
     3423       apply "WINDOW-CLOSE" TO FRAME Dialog-Frame .
     3424   END.
     3425   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
     3426   DO:
     3427   define variable vss-include-info24 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3428   if lookup(self :type
     3429            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3430            ) = 0
     3431   then do:
     3432     message
     3433       "$Workfile$"
     3434       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3435       "Интерфейсный элемент" self :name  skip
     3436       "Тип" self :type  skip
     3437       "Процедура" this-procedure :file-name skip
     3438       view-as alert-box .
     3439   end.
     3440   else do:
     3441     apply "entry":u to self  .
     3442     if focus :handle <> self :handle  then do:
     3443       return no-apply .
     3444     end.
     3445   end.
     3446       define variable v-error-message     as character      no-undo.
     3447       define variable v-not-good          as logical        no-undo.
     3448       assign
     3449           tb-is-waste
     3450           rs-calc-method
     3451       .
     3452       if p-recipe-type <> 'производство':U
     3453       then do:
     3454           assign
     3455               fi-brutto
     3456           .
     3457           assign
     3458               p-out-netto         = fi-brutto
     3459               p-out-brutto        = fi-brutto
     3460               p-out-coeff-waste   = 0
     3461               p-out-calc-method   = 1
     3462           .
     3463       end.
     3464       else do:
     3465           case rs-calc-method
     3466           :
     3467               when 1
     3468               then do:
     3469                   assign
     3470                       fi-coeff-waste
     3471                       fi-brutto
     3472                   .
     3473               end.
     3474               when 2
     3475               then do:
     3476                   assign
     3477                       fi-netto
     3478                       fi-brutto
     3479                   .
     3480               end.
     3481               when 3
     3482               then do:
     3483                   assign
     3484                       fi-netto
     3485                       fi-coeff-waste
     3486                   .
     3487               end.
     3488           end case.
     3489           assign
     3490               p-out-netto         = fi-netto
     3491               p-out-coeff-waste   = fi-coeff-waste
     3492               p-out-brutto        = fi-brutto
     3493               p-out-calc-method   = rs-calc-method
     3494           .
     3495       end.
     3496       assign
     3497           p-out-is-waste      = ( if p-is-pieces = yes then no else tb-is-waste     )
     3498       .
     3499       run check-fields in this-procedure (
     3500             input p-out-is-waste
     3501           , input p-out-netto
     3502           , input p-out-coeff-waste
     3503           , input p-out-brutto
     3504           , input p-out-calc-method
     3505           , output v-error-message
     3506           , output v-not-good
     3507       ) no-error.
     3508       if error-status :error
     3509       then do:
     3510           message
     3511                    vss-workfile vss-revision vss-description
     3512               skip "Ошибка проверки введенных данных."
     3513               skip return-value
     3514               skip trim(error-status :get-message(1))
     3515                    trim(error-status :get-message(2))
     3516                    trim(error-status :get-message(3))
     3517           view-as alert-box error.
     3518           undo, return no-apply .
     3519       end.
     3520       if v-not-good = yes
     3521       then do:
     3522           message
     3523               v-error-message
     3524               skip (1)
     3525               skip "Исправьте данные или отмените изменение ингредиента."
     3526           view-as alert-box error
     3527           title "Проверка введенных данных".
     3528           undo, return no-apply .
     3529       end.
     3530       assign
     3531           p-success        = yes
     3532       .
     3533       apply "WINDOW-CLOSE" TO FRAME Dialog-Frame .
     3534   END.
     3535   ON LEAVE OF fi-netto IN FRAME Dialog-Frame
     3536   OR LEAVE OF fi-coeff-waste IN FRAME Dialog-Frame
     3537   OR LEAVE OF fi-brutto IN FRAME Dialog-Frame
     3538   DO:
     3539   define variable vss-include-info25 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3540   if lookup(self :type
     3541            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3542            ) = 0
     3543   then do:
     3544     message
     3545       "$Workfile$"
     3546       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3547       "Интерфейсный элемент" self :name  skip
     3548       "Тип" self :type  skip
     3549       "Процедура" this-procedure :file-name skip
     3550       view-as alert-box .
     3551   end.
     3552   else do:
     3553     apply "entry":u to self  .
     3554     if focus :handle <> self :handle  then do:
     3555       return no-apply .
     3556     end.
     3557   end.
     3558       if p-recipe-type <> 'производство':U
     3559       then do:
     3560       end.
     3561       else do:
     3562           if decimal( fi-coeff-waste :screen-value ) < 0
     3563           or decimal( fi-coeff-waste :screen-value ) >= 100
     3564           then do:
     3565               message
     3566                   "Значение процента потерь"
     3567                   skip "должно быть больше или равно 0"
     3568                   skip "и строго меньше 100."
     3569                   skip(1)
     3570                   skip "Исправьте значение процента"
     3571                   skip "или отмените операцию."
     3572               view-as alert-box error
     3573               title "Неверное значение процента потерь".
     3574               undo, return no-apply.
     3575           end.
     3576           run calc-qnty in this-procedure
     3577           no-error.
     3578           if error-status :error
     3579           then do:
     3580               message
     3581                       vss-workfile vss-revision vss-description
     3582                   skip "Ошибка расчета количеств"
     3583                   skip "в рецепте документа производства."
     3584                   skip return-value
     3585                   skip trim(error-status :get-message(1))
     3586                       trim(error-status :get-message(2))
     3587                       trim(error-status :get-message(3))
     3588               view-as alert-box error.
     3589               undo, return no-apply .
     3590           end.
     3591       end.
     3592   END.
     3593   ON RETURN OF fi-netto IN FRAME Dialog-Frame
     3594   DO:
     3595   define variable vss-include-info26 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3596   if lookup(self :type
     3597            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3598            ) = 0
     3599   then do:
     3600     message
     3601       "$Workfile$"
     3602       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3603       "Интерфейсный элемент" self :name  skip
     3604       "Тип" self :type  skip
     3605       "Процедура" this-procedure :file-name skip
     3606       view-as alert-box .
     3607   end.
     3608   else do:
     3609     apply "entry":u to self  .
     3610     if focus :handle <> self :handle  then do:
     3611       return no-apply .
     3612     end.
     3613   end.
     3614   END.
     3615   ON VALUE-CHANGED OF rs-calc-method IN FRAME Dialog-Frame
     3616   DO:
     3617   define variable vss-include-info27 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3618   if lookup(self :type
     3619            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3620            ) = 0
     3621   then do:
     3622     message
     3623       "$Workfile$"
     3624       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3625       "Интерфейсный элемент" self :name  skip
     3626       "Тип" self :type  skip
     3627       "Процедура" this-procedure :file-name skip
     3628       view-as alert-box .
     3629   end.
     3630   else do:
     3631     apply "entry":u to self  .
     3632     if focus :handle <> self :handle  then do:
     3633       return no-apply .
     3634     end.
     3635   end.
     3636       run manage-qnty-fields in this-procedure
     3637       no-error.
     3638       if error-status :error
     3639       then do:
     3640           message
     3641                    vss-workfile vss-revision vss-description
     3642               skip "Ошибка при выборе метода расчета"
     3643               skip "в рецепте документа производства."
     3644               skip return-value
     3645               skip trim(error-status :get-message(1))
     3646                    trim(error-status :get-message(2))
     3647                    trim(error-status :get-message(3))
     3648           view-as alert-box error.
     3649           undo, return no-apply .
     3650       end.
     3651       run calc-qnty in this-procedure
     3652       no-error.
     3653       if error-status :error
     3654       then do:
     3655           message
     3656                    vss-workfile vss-revision vss-description
     3657               skip "Ошибка расчета количеств"
     3658               skip "в рецепте документа производства."
     3659               skip return-value
     3660               skip trim(error-status :get-message(1))
     3661                    trim(error-status :get-message(2))
     3662                    trim(error-status :get-message(3))
     3663           view-as alert-box error.
     3664           undo, return no-apply .
     3665       end.
     3666   END.
     3667   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3668   on help of frame Dialog-Frame
     3669   do:
     3670     run gbl/app_help.p
     3671       (input this-procedure :file-name
     3672       ,input ''
     3673       ,input ?
     3674       ) no-error.
     3675     if error-status :error then do:
     3676       message
     3677         "Ошибка при вызове помощи"
     3678         error-status :get-message(1)
     3679         view-as alert-box .
     3680     end.
     3681   end.
     3682   run minbtn-set in this-procedure .
     3683   on choose of b-help in frame Dialog-Frame
     3684   do:
     3685     apply "help":u to frame Dialog-Frame .
     3686   end.
     3687   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3688   procedure minbtn-set :
     3689       do
     3690           on error undo, return error return-value
     3691           :
     3692           define variable ii              as integer       no-undo .
     3693           define variable fh              as widget-handle no-undo .
     3694           define variable hh              as widget-handle no-undo .
     3695           define variable v-h             as handle        extent 4 no-undo .
     3696           define variable v-name-button   as character     no-undo .
     3697           define variable v-help-old-x    as decimal       no-undo .
     3698           define variable v-help-old-y    as decimal       no-undo .
     3699           define variable v-help-old-size as decimal       no-undo .
     3700           define variable v-frame-width   as decimal       no-undo .
     3701           define variable jj              as integer       no-undo .
     3702           do
     3703               on error undo, return error
     3704               :
     3705               assign
     3706                   v-frame-width = frame Dialog-Frame:width - 0.3
     3707                   fh            = frame Dialog-Frame:first-child
     3708                   hh            = fh:first-child
     3709                   ii            = 1
     3710                   .
     3711               do while valid-handle(hh):
     3712                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     3713                   do:
     3714                       case lc(hh:name) :
     3715                           when "b-help" then
     3716                               do:
     3717                                   hh:load-image-up("cmp/b-help.bmp":u) .
     3718                                   hh:load-image-down("cmp/b-help.bmp":u) .
     3719                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     3720                                   hh:TOOLTIP = "Помощь" .
     3721                                   v-help-old-x = hh:column .
     3722                                   v-help-old-y = hh:row    .
     3723                                   v-help-old-size = hh:width .
     3724                                   hh:width-chars = 2.5 .
     3725                               end.
     3726                           when "b-print" then
     3727                               do:
     3728                                   hh:load-image("cmp/b-print.bmp":u) .
     3729                                   hh:TOOLTIP = "Печать" .
     3730                                   v-h[ii] = hh:handle .
     3731                                   ii = ii + 1 .
     3732                                   hh:width-chars = 3 .
     3733                               end.
     3734                           when "b-history" or
     3735                           when "b-hist" then
     3736                               do:
     3737                                   hh:load-image("cmp/b-hist.bmp":u) .
     3738                                   hh:TOOLTIP = "История" .
     3739                                   v-h[ii] = hh:handle .
     3740                                   ii = ii + 1 .
     3741                                   hh:width-chars = 3 .
     3742                               end.
     3743                           when "b-sch" then
     3744                               do:
     3745                                   hh:load-image("cmp/b-sch.bmp":u) .
     3746                                   hh:TOOLTIP = "Установка Фильтра" .
     3747                                   v-h[ii] = hh:handle .
     3748                                   ii = ii + 1 .
     3749                                   hh:width-chars = 3 .
     3750                               end.
     3751                           when "b-hist-user" then
     3752                               do:
     3753                                   hh:load-image("cmp/b-hist.bmp":u) .
     3754                                   hh:TOOLTIP = "История пользователя" .
     3755                                   ii = ii + 1 .
     3756                               end.
     3757                       end case.
     3758                   end.
     3759                   hh = hh:next-sibling.
     3760               end.
     3761               b-help:column = v-frame-width - b-help:width-chars.
     3762               jj = 0.
     3763               repeat ii = 4 to 1 by -1 :
     3764                   if valid-handle (v-h[ii] ) then
     3765                   do:
     3766                       jj  = jj + 1 .
     3767                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3768                       v-h[ii]:row    = v-help-old-y .
     3769                   end.
     3770               end.
     3771           end.
     3772       end.
     3773   end procedure.
     3774   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     3775   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     3776   MAIN-BLOCK:
     3777   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3778      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3779       run init-fields in this-procedure.
     3780       RUN enable_UI.
     3781       run hide-if-not-manufacturing in this-procedure .
     3782       run manage-qnty-fields in this-procedure.
     3783       if p-is-pieces
     3784       then do:
     3785           disable
     3786               tb-is-waste
     3787           with frame Dialog-Frame .
     3788       end.
     3789     WAIT-FOR GO OF FRAME Dialog-Frame.
     3790   END.
     3791   RUN disable_UI.
     3792   PROCEDURE calc-qnty :
     3793       define variable v-coeff-value    as decimal      no-undo.
     3794   do with frame Dialog-Frame
     3795   on error undo, return error
     3796   :
     3797       assign
     3798           fi-netto
     3799           fi-brutto
     3800           fi-coeff-waste
     3801           rs-calc-method
     3802       .
     3803       if p-mode = 'спр-к_рецептов':U
     3804       then do:
     3805           assign
     3806               v-coeff-value = 0
     3807           .
     3808       end.
     3809       else do:
     3810           assign
     3811               v-coeff-value = p-coeff-value
     3812           .
     3813       end.
     3814       assign
     3815           rs-calc-method
     3816       .
     3817       run fbrlib-calc-brutto in this-procedure (
     3818             input p-recipe-type
     3819           , input fi-netto
     3820           , input v-coeff-value
     3821           , input fi-coeff-waste
     3822           , input fi-brutto
     3823           , input rs-calc-method
     3824           , output fi-netto
     3825           , output fi-coeff-waste
     3826           , output fi-brutto
     3827           , output rs-calc-method
     3828       ).
     3829       display
     3830           fi-netto
     3831           fi-coeff-waste
     3832           fi-brutto
     3833           rs-calc-method
     3834       .
     3835   end.
     3836   END PROCEDURE.
     3837   PROCEDURE check-fields :
     3838   define input parameter p-is-waste           as logical      no-undo.
     3839   define input parameter p-netto              as decimal      no-undo.
     3840   define input parameter p-coeff-waste        as decimal      no-undo.
     3841   define input parameter p-brutto             as decimal      no-undo.
     3842   define input parameter p-calc-method        as integer      no-undo.
     3843   define output parameter p-error-message     as character    no-undo.
     3844   define output parameter p-not-good          as logical      no-undo.
     3845       define variable v-coeff-value    as decimal      no-undo.
     3846   do
     3847   on error undo, return error
     3848   :
     3849       if p-is-pieces = yes
     3850       and p-is-waste = yes
     3851       then do:
     3852           assign
     3853               p-not-good      = yes
     3854               p-error-message = ( if p-error-message = "" then "" else p-error-message + chr(10) )
     3855                                   + "Штучный товар не может быть отходом."
     3856           .
     3857       end.
     3858       if p-mode = 'спр-к_рецептов':U
     3859       then do:
     3860           assign
     3861               v-coeff-value = 0
     3862           .
     3863       end.
     3864       else do:
     3865           assign
     3866               v-coeff-value = p-coeff-value
     3867           .
     3868       end.
     3869       run fbrlib-check-brutto in this-procedure (
     3870             input p-recipe-type
     3871           , input p-netto
     3872           , input v-coeff-value
     3873           , input p-coeff-waste
     3874           , input p-brutto
     3875           , input p-calc-method
     3876           , output p-error-message
     3877           , output p-not-good
     3878       ).
     3879   end.
     3880   END PROCEDURE.
     3881   PROCEDURE disable_UI :
     3882     HIDE FRAME Dialog-Frame.
     3883   END PROCEDURE.
     3884   PROCEDURE enable_UI :
     3885     DISPLAY fi-recipe-code fi-goods tb-is-waste fi-coeff-value rs-calc-method
     3886             fi-netto fi-coeff-waste fi-brutto
     3887         WITH FRAME Dialog-Frame.
     3888     ENABLE b-exit b-cancel b-help tb-is-waste rs-calc-method
     3889         WITH FRAME Dialog-Frame.
     3890     VIEW FRAME Dialog-Frame.
     3891   END PROCEDURE.
     3892   PROCEDURE init-fields :
     3893   do
     3894   on error undo, return error
     3895   :
     3896       define variable v-coeff-value    as decimal      no-undo.
     3897       define variable v-coeff-waste    as decimal      no-undo.
     3898       define variable v-calc-method    as integer      no-undo.
     3899       assign
     3900           fi-recipe-code  = p-recipe-string
     3901           fi-goods        = p-goods-string
     3902           tb-is-waste     = p-is-waste
     3903       .
     3904       if p-recipe-type = 'производство':U
     3905       then do:
     3906           assign
     3907               fi-coeff-value  = p-coeff-value
     3908               rs-calc-method  = p-calc-method
     3909           .
     3910           if p-mode = 'спр-к_рецептов':U
     3911           then do:
     3912               assign
     3913                   v-coeff-value = 0
     3914               .
     3915           end.
     3916           else do:
     3917               assign
     3918                   v-coeff-value = p-coeff-value
     3919               .
     3920           end.
     3921           run fbrlib-calc-brutto in this-procedure (
     3922                 input p-recipe-type
     3923               , input p-netto
     3924               , input v-coeff-value
     3925               , input p-coeff-waste
     3926               , input p-brutto
     3927               , input rs-calc-method
     3928               , output fi-netto
     3929               , output fi-coeff-waste
     3930               , output fi-brutto
     3931               , output rs-calc-method
     3932           ).
     3933       end.
     3934       else do:
     3935           assign
     3936               fi-coeff-value  = 0
     3937               fi-coeff-waste  = 0
     3938               rs-calc-method  = 1
     3939               fi-netto        = p-brutto
     3940               fi-brutto       = p-brutto
     3941           .
     3942       end.
     3943   end.
     3944   END PROCEDURE.
     3945   PROCEDURE manage-qnty-fields :
     3946   do with frame Dialog-Frame
     3947   on error undo, return error
     3948   :
     3949       if p-recipe-type <> 'производство':U
     3950       then do:
     3951           enable
     3952               fi-brutto
     3953           .
     3954           apply "entry" to fi-brutto.
     3955           undo, return .
     3956       end.
     3957       assign
     3958           rs-calc-method
     3959       .
     3960       case rs-calc-method
     3961       :
     3962           when 1
     3963           then do:
     3964               disable
     3965                   fi-netto
     3966               .
     3967               enable
     3968                   fi-coeff-waste
     3969                   fi-brutto
     3970               .
     3971           end.
     3972           when 2
     3973           then do:
     3974               disable
     3975                   fi-coeff-waste
     3976               .
     3977               enable
     3978                   fi-netto
     3979                   fi-brutto
     3980               .
     3981           end.
     3982           when 3
     3983           then do:
     3984               disable
     3985                   fi-brutto
     3986               .
     3987               enable
     3988                   fi-netto
     3989                   fi-coeff-waste
     3990               .
     3991           end.
     3992       end case.
     3993   end.
     3994   END PROCEDURE.
     3995   PROCEDURE hide-if-not-manufacturing :
     3996   do with frame Dialog-Frame
     3997   on error undo, return error
     3998   :
     3999       if p-recipe-type <> 'производство':U
     4000       then do:
     4001           hide
     4002               fi-netto
     4003               fi-coeff-value
     4004               fi-coeff-waste
     4005               rs-calc-method
     4006           .
     4007       end.
     4008   end.
     4009   END PROCEDURE.
