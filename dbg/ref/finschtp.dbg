       79   define   shared variable g#passwd as character no-undo .
       80   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       82   define  shared variable RepPathName        as character no-undo .
       83   define  shared variable PrintRubl          as logical   no-undo .
       84   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       85   define  stream PrnLibStream.
       86   procedure prn-lib-prn-file :
       87     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
       88     define input parameter p-DIsabledoptions as integer no-undo .
       89     define variable v-report-name as character no-undo .
       90     define variable v-user-action as character no-undo .
       91     define variable v-printed     as logical   no-undo .
       92     define variable v-exist       as logical   no-undo .
       93     do
       94       on error undo, return error
       95       :
       96       run prn-lib-get-report-name  in this-procedure (
       97         input parParentProc
       98         ,output v-report-name
       99         ).
      100   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      101   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      102     (input  v-report-name
      103     ,input  2
      104     ,output v-exist
      105     )  .
      106       if NOT v-exist then
      107       DO:
      108         Message
      109           "Нет заданий на печать ! "
      110           view-as alert-box .
      111         Return  .
      112       End.
      113       run gbl/prnfilen.w
      114         (input  ""
      115         ,input  p-DisabledOptions
      116         ,input  string(v-report-name )
      117         ,input  7
      118         ,output v-user-action
      119         ,output v-printed
      120         ) .
      121       if v-printed then
      122       do:
      123         return "YES" .
      124       end.
      125       else
      126       do:
      127         return "NO" .
      128       end.
      129     end.
      130   end procedure.
      131   procedure prn-lib-open-stream :
      132     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      133     define input parameter p-page-size    as integer no-undo .
      134     define input parameter p-is-stream    as logical no-undo .
      135     define input parameter p-append       as logical no-undo .
      136     define variable v-report-name as character no-undo .
      137     do
      138       on error undo, return error
      139       :
      140       run prn-lib-get-report-name  in this-procedure (
      141         input parParentProc
      142         ,output v-report-name
      143         ).
      144       if p-is-stream then
      145       do:
      146         if p-append then
      147         do:
      148           output stream PrnLibStream to value( v-report-name )
      149             page-size value(p-page-size) append .
      150         end.
      151         if not p-append then
      152         do:
      153           output stream PrnLibStream to value( v-report-name )
      154             page-size value(p-page-size) .
      155         end.
      156       end.
      157       if not p-is-stream then
      158       do:
      159         if p-append then
      160         do:
      161           output to value( v-report-name )
      162             page-size value(p-page-size) append .
      163         end.
      164         if not p-append then
      165         do:
      166           output to value( v-report-name )
      167             page-size value(p-page-size) .
      168         end.
      169       end.
      170     end.
      171   end procedure.
      172   procedure prn-lib-open-exp :
      173     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      174     define input parameter p-is-stream    as logical no-undo .
      175     define input parameter p-is-append    as logical no-undo .
      176     define output parameter p-ReportFileName as char init "report" no-undo.
      177     define output parameter p-process as logical no-undo .
      178     define variable glog as logical no-undo .
      179     do
      180       on error undo, return error
      181       :
      182       SYSTEM-DIALOG GET-FILE p-ReportFileName
      183         TITLE      "Укажите путь"
      184         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      185         ASK-OVERWRITE
      186         CREATE-TEST-FILE
      187         SAVE-AS
      188         USE-FILENAME
      189         DEFAULT-EXTENSION "txt"
      190         UPDATE glog
      191         .
      192       if not glog then  return.
      193       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      194       if p-is-stream then
      195       do:
      196         if p-is-append then
      197         do:
      198           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      199         end.
      200         else
      201         do:
      202           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      203         end.
      204       end.
      205       else
      206       do:
      207         if p-is-append then
      208         do:
      209           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      210         end.
      211         else
      212         do:
      213           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      214         end.
      215       end.
      216       p-process = yes.
      217     end.
      218   end procedure.
      219   procedure prn-lib-get-report-name :
      220     define input parameter parParentProc  as widget-handle no-undo.
      221     define output parameter p-report-name as character no-undo .
      222     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      223   end procedure.
      224   procedure prn-lib-reportviewer-report-name :
      225     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      226     define input parameter p-report-name-html as character no-undo .
      227     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      228   end procedure.
      229   procedure prn-lib-reportviewer :
      230     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      231     define input parameter p-report-name-html as character no-undo .
      232     define input parameter p-param        as character no-undo .
      233     define variable v-excel           as character no-undo init 'TRUE' .
      234     define variable v-value-character as character no-undo .
      235     define variable v-value-integer   as character no-undo .
      236     define variable v-value-date      as date      no-undo .
      237     define variable v-value-decimal   as decimal   no-undo .
      238     define variable rep-excel         as logical   no-undo .
      239     define variable excel-string      as character no-undo .
      240     define variable v-param-type      as character no-undo .
      241     define variable v-tth             as handle    no-undo .
      242     run adm/shattri.p (
      243       input "get":U
      244       ,input  ""
      245       ,input  0
      246       ,input  'report-glob':U
      247       ,input  'rep-excel':U
      248       ,output v-value-character
      249       ,output v-value-date
      250       ,output v-value-decimal
      251       ,output v-value-integer
      252       ,output rep-excel
      253       ,output v-param-type
      254       ,INPUT-OUTPUT table-handle v-tth
      255       )  .
      256     if rep-excel then v-excel = "TRUE" .
      257     else v-excel = "FALSE" .
      258     if p-param eq ""
      259     then
      260        p-param = "EXCEL:" + v-excel.
      261     else
      262        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      263     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      264   end procedure.
      265   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      266   procedure cur-time :
      267      define output parameter p-today as date      no-undo .
      268      define output parameter p-time  as integer   no-undo .
      269     do
      270     on error undo, return error
      271     :
      272       define variable v-date1 as date      no-undo .
      273       define variable v-date2 as date      no-undo .
      274       define variable v-time  as integer   no-undo .
      275       assign
      276         v-date1 = today
      277         v-time  = time
      278         v-date2 = today
      279       .
      280       if v-date1 <> v-date2
      281       then do:
      282         assign
      283           v-date1 = today
      284           v-time  = v-time
      285         .
      286       end.
      287       assign
      288         p-today = v-date1
      289         p-time  = v-time
      290       .
      291     end.
      292   end.
      293   function cur-time-date returns character
      294   :
      295     return string(today, '99/99/9999':U) .
      296   end.
      297   function cur-time-mjd returns decimal
      298   :
      299     define variable v-date as date      no-undo .
      300     define variable v-time as integer   no-undo .
      301     run cur-time in this-procedure
      302       (output v-date
      303       ,output v-time
      304       ) .
      305     return integer(v-date) - 2400002 + (v-time / 86400) .
      306   end.
      307   function cur-time-get-ending-index returns integer
      308   (input p-number as integer
      309   )
      310   :
      311     if p-number < 0
      312     or p-number = ?
      313     then do:
      314       return 1 .
      315     end.
      316     define variable v-rest as integer   no-undo .
      317     assign
      318       p-number = p-number modulo 100
      319     .
      320     if p-number < 20
      321     then do:
      322       assign
      323         v-rest = p-number
      324       .
      325     end.
      326     else do:
      327       assign
      328         v-rest = p-number modulo 10
      329       .
      330     end.
      331     case v-rest :
      332       when 1
      333       then do:
      334         return 2 .
      335       end.
      336       when 2 or
      337       when 3 or
      338       when 4
      339       then do:
      340         return 3 .
      341       end.
      342       otherwise do:
      343         return 1 .
      344       end.
      345     end case .
      346   end.
      347   procedure cur-time-mjd-to-date :
      348      define input  parameter i-mjd-diff as decimal no-undo.
      349      define output parameter o-Date     as date    no-undo.
      350      define output parameter o-Time     as integer no-undo.
      351      define variable v-day-number as integer   no-undo .
      352      if    i-mjd-diff < 0
      353         or i-mjd-diff = ?
      354      then do:
      355         return "?" .
      356      end.
      357      assign
      358         v-day-number = truncate(i-mjd-diff,0).
      359         o-Date = date(v-day-number + 2400002).
      360         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      361     .
      362   end.
      363   function cur-time-mjd-to-string returns character
      364   (input p-mjd-diff as decimal
      365   )
      366   :
      367     define variable v-day-number as integer   no-undo .
      368     define variable v-seconds    as integer   no-undo .
      369     define variable v-hour       as integer   no-undo .
      370     define variable v-min        as integer   no-undo .
      371     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      372     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      373     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      374     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      375     if p-mjd-diff < 0
      376     or p-mjd-diff = ?
      377     then do:
      378       return "?" .
      379     end.
      380     assign
      381       v-day-number = integer(truncate(p-mjd-diff,0))
      382       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      383     .
      384     if v-seconds > 86400
      385     then do:
      386       assign
      387         v-seconds = 86400 - 1
      388       .
      389     end.
      390     if v-seconds < 0
      391     then do:
      392       assign
      393         v-seconds = 0
      394       .
      395     end.
      396     assign
      397       v-hour = truncate(v-seconds / 3600, 0)
      398     .
      399     assign
      400       v-seconds = v-seconds modulo 3600
      401     .
      402     assign
      403       v-min = truncate(v-seconds / 60, 0)
      404     .
      405     assign
      406       v-seconds = v-seconds modulo 60
      407     .
      408     return
      409         (if v-day-number <> 0
      410           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      411           else ""
      412         )
      413       + (if v-day-number <> 0 or v-hour <> 0
      414           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      415           else ""
      416         )
      417       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      418           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      419           else ""
      420         )
      421       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      422       .
      423   end.
      424   function cur-time-string returns character
      425   :
      426     define variable v-date as date      no-undo .
      427     define variable v-time as integer   no-undo .
      428     run cur-time in this-procedure
      429       (output v-date
      430       ,output v-time
      431       ) .
      432     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      433   end.
      434   function cur-time-string-sec returns character
      435   :
      436     define variable v-date as date      no-undo .
      437     define variable v-time as integer   no-undo .
      438     run cur-time in this-procedure
      439       (output v-date
      440       ,output v-time
      441       ) .
      442     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      443   end.
      444   function cur-time-custom  returns character
      445   (input p-prefix as character
      446   ,input p-date-format as character
      447   ,input p-delimiter as character
      448   ,input p-time-format as character
      449   ,input p-suffix as character
      450   )
      451   :
      452     define variable v-date as date      no-undo .
      453     define variable v-time as integer   no-undo .
      454     run cur-time in this-procedure
      455       (output v-date
      456       ,output v-time
      457       ) .
      458     return
      459       p-prefix
      460       + string(v-date, p-date-format)
      461       + p-delimiter
      462       + string(v-time, p-time-format)
      463       + p-suffix
      464       .
      465   end.
      466   function cur-time-print  returns character
      467   :
      468     define variable v-date as date      no-undo .
      469     define variable v-time as integer   no-undo .
      470     run cur-time in this-procedure
      471       (output v-date
      472       ,output v-time
      473       ) .
      474     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      475   end.
      476   function cur-time-datetime returns datetime
      477   :
      478     define variable v-char as character no-undo .
      479     define variable v-datetime as datetime no-undo .
      480     v-char = cur-time-string().
      481     v-datetime = datetime(v-char).
      482     return  v-datetime.
      483   end.
      484   function cur-time-string-msec returns character
      485   :
      486     define variable v-date as datetime  no-undo .
      487     v-date = now.
      488     return string(v-date) .
      489   end.
      490   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      491   define variable v-waitfram-action01         as character   no-undo .
      492   define variable v-waitfram-action02         as character   no-undo .
      493   define variable v-waitfram-action03         as character   no-undo .
      494   define variable mWaitFramTextBeg            as character   no-undo.
      495   define variable mWaitFramTextEnd            as character   no-undo.
      496   define variable mWaitFramView               as logical     no-undo.
      497   define variable mWaitProcEvent              as logical     no-undo init yes.
      498   define variable mWaitFramInterval           as integer     no-undo init 1 .
      499   define variable mWaitFramStop               as logical     no-undo.
      500   define variable mWaitFramStopUser           as logical     no-undo.
      501   define variable mWaitFramStopTimeOut        as logical     no-undo.
      502   define variable mWaitFramStartProc          as datetime-tz no-undo.
      503   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      504   define button B-WaitFramStop auto-end-key
      505        label "Стоп"
      506        size 10 by 1 tooltip "Остоновить процесс".
      507   define button B-viewProcInfo
      508        label "Информация"
      509        size 15 by 1 tooltip "Информация о процесс".
      510   define frame waitfram
      511     v-waitfram-action01 format "x(72)" no-label skip
      512     v-waitfram-action02 format "x(72)" no-label skip
      513     v-waitfram-action03 format "x(72)" no-label skip
      514     B-viewProcInfo
      515     B-WaitFramStop at row 4 col 30
      516     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      517     .
      518   define new global shared variable mBatchMode as logical no-undo init ?.
      519   define variable mFramBachModHandle as handle no-undo.
      520   mFramBachModHandle = frame waitfram:handle.
      521   define variable mFameOldVis as logical no-undo.
      522   define variable mVisCUrentVin as logical no-undo.
      523   if session:batch-mode
      524   then
      525      mBatchMode = yes.
      526   if mBatchMode = ? then do:
      527     mVisCUrentVin = current-window:visible.
      528     mFameOldVis = mFramBachModHandle:visible.
      529     mFramBachModHandle:visible  = yes.
      530     mBatchMode = mFramBachModHandle:visible ne yes.
      531     mFramBachModHandle:visible = mFameOldVis.
      532     current-window:visible = mVisCUrentVin.
      533   end.
      534    if  log-manager:logfile-name ne ?
      535     then DO:
      536         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      537         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      538         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      539     end.
      540   on choose of B-WaitFramStop in frame waitfram
      541   do:
      542     mWaitFramStop = yes.
      543     mWaitFramStopUser = yes.
      544   end.
      545   function waitfram-check-timeout returns logical():
      546      define variable vtime as int64 no-undo.
      547      if mWaitFramStopTimeOut
      548      then
      549         return yes.
      550      vtime = ( now - mWaitFramStartProc ) / 1000 .
      551      if     mWaitFramTimeOut ne ?
      552         and mWaitFramTimeOut ne 0
      553         and mWaitFramTimeOut lt vtime
      554      then do:
      555         mWaitFramStopTimeOut = yes.
      556      end.
      557      return mWaitFramStopTimeOut.
      558   end.
      559   procedure waitfram-hide :
      560     if not session:batch-mode
      561     then do
      562     on error undo, return error return-value
      563     :
      564       pause 0 before-hide .
      565       if not mBatchMode then
      566         hide frame waitfram .
      567     if     not mWaitFramView
      568        and mWaitProcEvent
      569     then
      570       process events .
      571     end.
      572   end procedure.
      573   procedure waitfram-show :
      574     define input  parameter p-message as character no-undo .
      575     define variable v-left-margin as integer   no-undo .
      576     if not session:batch-mode
      577     then do
      578     on error undo, return error return-value
      579     :
      580       if length(p-message) <= 70 then do:
      581         assign
      582           v-left-margin = integer((70 - length(p-message)) / 2)
      583         .
      584         assign
      585           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      586         .
      587         assign
      588           v-waitfram-action01 = " "
      589           v-waitfram-action02 = " "
      590                                    + fill(" ", v-left-margin)
      591                                    + p-message
      592           v-waitfram-action03 = " "
      593         .
      594       end.
      595       else do:
      596         define variable vRindex1 as integer no-undo.
      597         define variable vRindex2 as integer no-undo.
      598         vRindex1 = r-index(p-message," ",70).
      599         if vRindex1 = 0
      600         then
      601            vRindex1 = 70.
      602         if length(p-message)  <= vRindex1 + 70 then do:
      603           assign
      604             v-waitfram-action01 = " "
      605             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      606             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      607           .
      608         end.
      609         else do:
      610           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      611           if vRindex2 <= vRindex1
      612           then
      613              vRindex2 = vRindex1 + 70.
      614           assign
      615             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      616             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      617             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      618           .
      619         end.
      620       end.
      621       B-viewProcInfo:visible   in frame waitfram = no.
      622       B-viewProcInfo:sensitive in frame waitfram = no.
      623       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      624       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      625       if  (   mWaitFramView
      626          or  mWaitProcEvent)
      627          and not mBatchMode
      628       then
      629          display
      630             v-waitfram-action01 skip
      631             v-waitfram-action02 skip
      632             v-waitfram-action03 skip
      633          with frame waitfram .
      634       if     mWaitFramView
      635          then do:
      636             if     mWaitFramInterval ne ?
      637                and not mBatchMode
      638             then
      639                wait-for go of frame waitfram pause mWaitFramInterval.
      640          end.
      641          else
      642             if     mWaitProcEvent
      643                and not mBatchMode
      644             then
      645                process events .
      646     end.
      647   end procedure.
      648      procedure waitfram-show-this:
      649         define input  parameter iInterval as int64 no-undo.
      650         define variable vtime as int64 no-undo.
      651         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      652         mWaitFramInterval = iInterval.
      653         run waitfram-show (substitute("&1&2 &3&4" ,
      654                                       mWaitFramTextBeg ,
      655                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      656                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      657                                       mWaitFramTextEnd
      658                                      )
      659                           ).
      660      end.
      661      procedure WaitFramRunPause:
      662         define input  parameter iInterval as dec no-undo.
      663         define variable vStart  as datetime-tz no-undo.
      664         define variable vend    as datetime-tz no-undo.
      665         define variable vint as int64 no-undo.
      666         define variable vOk as logical no-undo.
      667         vStart = now.
      668         vend   = vStart.
      669         publish "WaitFramPause" (iInterval,output vOk).
      670         vend   =  now.
      671         vint = vend - vStart.
      672         vint = iInterval - vint / 1000.
      673         if     not mWaitFramStop
      674            and (   vint > 0
      675                 or (    not vOk
      676                     and iInterval eq ?
      677                     )
      678                 )
      679         then
      680            run waitfram-show-this (iInterval).
      681         vend   =  now.
      682         vint = vend - vStart.
      683         vint = iInterval - vint / 1000.
      684         if     not mWaitFramStop
      685            and vint > 0
      686         then do:
      687            run gbl/pause.p (vint * 1000).
      688         end.
      689         if iInterval ne ?
      690         then
      691            publish "WaitFramStop".
      692         waitfram-check-timeout().
      693      end.
      694      procedure WaitFramWaitFor:
      695         define input  parameter iInterval as dec no-undo.
      696         assign
      697            mWaitFramStartProc   = now
      698            mWaitFramStopUser    = no
      699            mWaitFramStopTimeOut = no
      700         .
      701         block-wait:
      702         do while not mWaitFramStop:
      703            run WaitFramRunPause (iInterval).
      704            if  waitfram-check-timeout()
      705            then do:
      706               leave block-wait.
      707            end.
      708         end.
      709         run waitfram-hide.
      710      end.
      711   procedure waitfram-join :
      712     define input  parameter p-line-1  as character no-undo .
      713     define input  parameter p-line-2  as character no-undo .
      714     define input  parameter p-line-3  as character no-undo .
      715     define output parameter p-message as character no-undo .
      716     do
      717     on error undo, return error return-value
      718     :
      719       assign
      720         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      721                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      722                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      723       .
      724     end.
      725   end procedure.
      726   function waitfram-join-function returns character
      727     (input p-line-1 as character
      728     ,input p-line-2 as character
      729     ,input p-line-3 as character
      730     ).
      731     define variable v-message as character no-undo .
      732     run waitfram-join in this-procedure
      733       (input  p-line-1
      734       ,input  p-line-2
      735       ,input  p-line-3
      736       ,output v-message
      737       ) .
      738     return v-message .
      739   end function .
      740   define variable date_string     as      char    no-undo.
      741   define variable Line            as      char    no-undo.
      742   define variable v-title         as character no-undo .
      743   define variable v-status        as character no-undo .
      744   define buffer buf_fin-schet for ub.fin-schet.
      745   define buffer buf_clients for ub.clients.
      746   define buffer buf_fin-bank for ub.fin-bank.
      747   define buffer buf_currency for ub.currency.
      748   define buffer buf_schet-clients for ub.clients.
      749   do
      750   on error undo, return error
      751   :
      752     find first buf_fin-schet no-lock where
      753               buf_fin-schet.host-code = p-host-code
      754           AND buf_fin-schet.code-schet = p-code-schet no-error.
      755     if not available buf_fin-schet then do:
      756       message
      757       vss-workfile vss-revision vss-description skip
      758       "Не найден банковский счет" skip
      759       "p-host-code"  p-host-code skip
      760       "p-code-schet" p-code-schet
      761       view-as alert-box error .
      762       undo, return error.
      763     end.
      764     find first buf_clients no-lock where
      765               buf_clients.obj-type = 'орг':U
      766           AND buf_clients.obj-code = buf_fin-schet.host-code .
      767     find first buf_schet-clients no-lock where
      768               buf_schet-clients.obj-type = buf_fin-schet.cli-type
      769           AND buf_schet-clients.obj-code = buf_fin-schet.cli-code .
      770     find first buf_currency no-lock where
      771               buf_currency.curr-code= buf_fin-schet.curr-code.
      772     find first buf_fin-bank no-lock where
      773               buf_fin-bank.host-code = buf_fin-schet.host-code
      774           AND buf_fin-bank.code-bank = buf_fin-schet.code-bank .
      775     DEFINE FRAME TopFrame
      776     buf_fin-schet.host-code column-label "Код фирмы"
      777     buf_clients.obj-name   column-label "Фирма"
      778     buf_fin-schet.code-schet column-label "Код счета"
      779     buf_fin-schet.status_   column-label "Статус"
      780     HEADER
      781     date_string AT 5 format "X(35)"
      782     string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
      783     Line format "X(195)" AT 1
      784     with FRAME TopFrame width 232 down stream-io use-text    .
      785     Line = fill("-", 195).
      786     date_string = cur-time-print() .
      787     run prn-lib-open-stream  in this-procedure (
      788                                                 input parParentProc
      789                                                 ,input 43
      790                                                 ,input yes
      791                                                 ,input no
      792                                                 ).
      793     PUT  STREAM PrnLibStream UNFORMATTED
      794     SPACE(25) "Информация о банковском счете"
      795     SKIP(1) .
      796     FORM HEADER
      797     Line format "X(195)" AT 1 SKIP
      798     "Продолжение - на следующей странице" AT 30 SKIP
      799     with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
      800     VIEW  STREAM PrnLibStream FRAME BottomFrame .
      801     run waitfram-show in this-procedure ("Ждите...").
      802     FORM with frame TopFrame.
      803     display stream PrnLibStream
      804     buf_fin-schet.host-code
      805     buf_clients.obj-name
      806     buf_fin-schet.code-schet
      807     buf_fin-schet.status_
      808     with frame TopFrame.
      809     DOWN stream PrnLibStream 3
      810     with frame TopFrame.
      811     Put Stream PrnLibStream unformatted
      812     "Держатель счета" chr(32) buf_fin-schet.cli-type buf_fin-schet.cli-code chr(32)
      813      buf_schet-clients.obj-name skip
      814     "Код банка" chr(32) buf_fin-schet.code-bank fill(chr(32), 5)
      815     buf_fin-bank.bank-name skip
      816     "БИК" chr(32) buf_fin-bank.bik  skip
      817     "Валюта счета" chr(32) buf_fin-schet.curr-code chr(32) buf_currency.curr-abbr skip
      818     "Расч. счет" chr(32) buf_fin-schet.r-schet fill(chr(32), 5)
      819     "Корр. счет" chr(32) buf_fin-schet.c-schet
      820     "Примечания" chr(32)   buf_fin-schet.PS
      821     skip.
      822     HIDE  STREAM PrnLibStream FRAME BottomFrame .
      823     output  STREAM PrnLibStream CLOSE.
      824     run waitfram-hide in this-procedure .
      825     run prn-lib-prn-file in this-procedure (
      826                                               input parParentProc
      827                                               ,input 8
      828                                               ).
      829   end.
