        1   DEFINE BUFFER X_c-point-io FOR ub.c-point-io .
        2   DEFINE BUFFER X_point-io FOR ub.point-io.
        3   DEFINE INPUT PARAMETER parParentProc   AS WIDGET-HANDLE NO-UNDO.
        4   define input parameter p-db-num        as integer   no-undo .
        5   define input parameter p-point-code    as integer   no-undo .
        6   define input parameter bttns           as char      no-undo .
        7   define input-output param p-rid-list   as char      no-undo .
        8   DEF VAR vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
        9   DEF VAR vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       10   DEF VAR vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       11   DEF VAR vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       12   DEF VAR vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
       13   DEF VAR vss-description AS CHAR NO-UNDO INIT "Список истории пунктов отгрузки/доставки":U.
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   procedure proc-alt-shift-f2:
       73     if not ibs.th.gbl.gbl-var:rcode
       74   then
       75     run gbl\inidebug.p .
       76   end.
       77   procedure proc-alt-shift-f3:
       78     run gbl/prvssinf.p
       79       ( input this-procedure
       80       ) .
       81   end.
       82   define variable v-inform-launched as logical no-undo initial false .
       83   procedure proc-alt-shift-f4:
       84     define variable v-action as character no-undo .
       85     if v-inform-launched = false then do:
       86       assign
       87         v-inform-launched = true
       88       .
       89       run gbl/d-inform.w
       90         (  input self
       91         ,  input this-procedure
       92         , output v-action
       93         ) no-error .
       94       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       95       assign
       96         v-inform-launched = false
       97       .
       98     end.
       99   end.
      100   procedure proc-alt-f1:
      101     run gbl/corrhelp.p
      102       (input this-procedure
      103       ) .
      104   end .
      105   on alt-shift-f2 anywhere do:
      106     run proc-alt-shift-f2.
      107   end.
      108   on alt-shift-f3 anywhere do:
      109     run proc-alt-shift-f3 in this-procedure .
      110   end.
      111   on alt-shift-f4 anywhere do:
      112     run proc-alt-shift-f4 in this-procedure.
      113   end.
      114   on alt-f1 anywhere do:
      115     run proc-alt-f1 in this-procedure .
      116   end.
      117   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      118   define variable c-point  as character no-undo .
      119   define variable tbl      as character no-undo .
      120   define variable join-tbl as character no-undo .
      121   define variable fld      as character no-undo .
      122   define variable lab      as character no-undo .
      123   define variable spr      as character no-undo .
      124   define variable dim      as character no-undo .
      125   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      126   define variable v-waitfram-action01         as character   no-undo .
      127   define variable v-waitfram-action02         as character   no-undo .
      128   define variable v-waitfram-action03         as character   no-undo .
      129   define variable mWaitFramTextBeg            as character   no-undo.
      130   define variable mWaitFramTextEnd            as character   no-undo.
      131   define variable mWaitFramView               as logical     no-undo.
      132   define variable mWaitProcEvent              as logical     no-undo init yes.
      133   define variable mWaitFramInterval           as integer     no-undo init 1 .
      134   define variable mWaitFramStop               as logical     no-undo.
      135   define variable mWaitFramStopUser           as logical     no-undo.
      136   define variable mWaitFramStopTimeOut        as logical     no-undo.
      137   define variable mWaitFramStartProc          as datetime-tz no-undo.
      138   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      139   define button B-WaitFramStop auto-end-key
      140        label "Стоп"
      141        size 10 by 1 tooltip "Остоновить процесс".
      142   define button B-viewProcInfo
      143        label "Информация"
      144        size 15 by 1 tooltip "Информация о процесс".
      145   define frame waitfram
      146     v-waitfram-action01 format "x(72)" no-label skip
      147     v-waitfram-action02 format "x(72)" no-label skip
      148     v-waitfram-action03 format "x(72)" no-label skip
      149     B-viewProcInfo
      150     B-WaitFramStop at row 4 col 30
      151     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      152     .
      153   define new global shared variable mBatchMode as logical no-undo init ?.
      154   define variable mFramBachModHandle as handle no-undo.
      155   mFramBachModHandle = frame waitfram:handle.
      156   define variable mFameOldVis as logical no-undo.
      157   define variable mVisCUrentVin as logical no-undo.
      158   if session:batch-mode
      159   then
      160      mBatchMode = yes.
      161   if mBatchMode = ? then do:
      162     mVisCUrentVin = current-window:visible.
      163     mFameOldVis = mFramBachModHandle:visible.
      164     mFramBachModHandle:visible  = yes.
      165     mBatchMode = mFramBachModHandle:visible ne yes.
      166     mFramBachModHandle:visible = mFameOldVis.
      167     current-window:visible = mVisCUrentVin.
      168   end.
      169    if  log-manager:logfile-name ne ?
      170     then DO:
      171         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      172         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      173         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      174     end.
      175   on choose of B-WaitFramStop in frame waitfram
      176   do:
      177     mWaitFramStop = yes.
      178     mWaitFramStopUser = yes.
      179   end.
      180   function waitfram-check-timeout returns logical():
      181      define variable vtime as int64 no-undo.
      182      if mWaitFramStopTimeOut
      183      then
      184         return yes.
      185      vtime = ( now - mWaitFramStartProc ) / 1000 .
      186      if     mWaitFramTimeOut ne ?
      187         and mWaitFramTimeOut ne 0
      188         and mWaitFramTimeOut lt vtime
      189      then do:
      190         mWaitFramStopTimeOut = yes.
      191      end.
      192      return mWaitFramStopTimeOut.
      193   end.
      194   procedure waitfram-hide :
      195     if not session:batch-mode
      196     then do
      197     on error undo, return error return-value
      198     :
      199       pause 0 before-hide .
      200       if not mBatchMode then
      201         hide frame waitfram .
      202     if     not mWaitFramView
      203        and mWaitProcEvent
      204     then
      205       process events .
      206     end.
      207   end procedure.
      208   procedure waitfram-show :
      209     define input  parameter p-message as character no-undo .
      210     define variable v-left-margin as integer   no-undo .
      211     if not session:batch-mode
      212     then do
      213     on error undo, return error return-value
      214     :
      215       if length(p-message) <= 70 then do:
      216         assign
      217           v-left-margin = integer((70 - length(p-message)) / 2)
      218         .
      219         assign
      220           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      221         .
      222         assign
      223           v-waitfram-action01 = " "
      224           v-waitfram-action02 = " "
      225                                    + fill(" ", v-left-margin)
      226                                    + p-message
      227           v-waitfram-action03 = " "
      228         .
      229       end.
      230       else do:
      231         define variable vRindex1 as integer no-undo.
      232         define variable vRindex2 as integer no-undo.
      233         vRindex1 = r-index(p-message," ",70).
      234         if vRindex1 = 0
      235         then
      236            vRindex1 = 70.
      237         if length(p-message)  <= vRindex1 + 70 then do:
      238           assign
      239             v-waitfram-action01 = " "
      240             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      241             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      242           .
      243         end.
      244         else do:
      245           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      246           if vRindex2 <= vRindex1
      247           then
      248              vRindex2 = vRindex1 + 70.
      249           assign
      250             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      251             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      252             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      253           .
      254         end.
      255       end.
      256       B-viewProcInfo:visible   in frame waitfram = no.
      257       B-viewProcInfo:sensitive in frame waitfram = no.
      258       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      259       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      260       if  (   mWaitFramView
      261          or  mWaitProcEvent)
      262          and not mBatchMode
      263       then
      264          display
      265             v-waitfram-action01 skip
      266             v-waitfram-action02 skip
      267             v-waitfram-action03 skip
      268          with frame waitfram .
      269       if     mWaitFramView
      270          then do:
      271             if     mWaitFramInterval ne ?
      272                and not mBatchMode
      273             then
      274                wait-for go of frame waitfram pause mWaitFramInterval.
      275          end.
      276          else
      277             if     mWaitProcEvent
      278                and not mBatchMode
      279             then
      280                process events .
      281     end.
      282   end procedure.
      283      procedure waitfram-show-this:
      284         define input  parameter iInterval as int64 no-undo.
      285         define variable vtime as int64 no-undo.
      286         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      287         mWaitFramInterval = iInterval.
      288         run waitfram-show (substitute("&1&2 &3&4" ,
      289                                       mWaitFramTextBeg ,
      290                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      291                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      292                                       mWaitFramTextEnd
      293                                      )
      294                           ).
      295      end.
      296      procedure WaitFramRunPause:
      297         define input  parameter iInterval as dec no-undo.
      298         define variable vStart  as datetime-tz no-undo.
      299         define variable vend    as datetime-tz no-undo.
      300         define variable vint as int64 no-undo.
      301         define variable vOk as logical no-undo.
      302         vStart = now.
      303         vend   = vStart.
      304         publish "WaitFramPause" (iInterval,output vOk).
      305         vend   =  now.
      306         vint = vend - vStart.
      307         vint = iInterval - vint / 1000.
      308         if     not mWaitFramStop
      309            and (   vint > 0
      310                 or (    not vOk
      311                     and iInterval eq ?
      312                     )
      313                 )
      314         then
      315            run waitfram-show-this (iInterval).
      316         vend   =  now.
      317         vint = vend - vStart.
      318         vint = iInterval - vint / 1000.
      319         if     not mWaitFramStop
      320            and vint > 0
      321         then do:
      322            run gbl/pause.p (vint * 1000).
      323         end.
      324         if iInterval ne ?
      325         then
      326            publish "WaitFramStop".
      327         waitfram-check-timeout().
      328      end.
      329      procedure WaitFramWaitFor:
      330         define input  parameter iInterval as dec no-undo.
      331         assign
      332            mWaitFramStartProc   = now
      333            mWaitFramStopUser    = no
      334            mWaitFramStopTimeOut = no
      335         .
      336         block-wait:
      337         do while not mWaitFramStop:
      338            run WaitFramRunPause (iInterval).
      339            if  waitfram-check-timeout()
      340            then do:
      341               leave block-wait.
      342            end.
      343         end.
      344         run waitfram-hide.
      345      end.
      346   procedure waitfram-join :
      347     define input  parameter p-line-1  as character no-undo .
      348     define input  parameter p-line-2  as character no-undo .
      349     define input  parameter p-line-3  as character no-undo .
      350     define output parameter p-message as character no-undo .
      351     do
      352     on error undo, return error return-value
      353     :
      354       assign
      355         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      356                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      357                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      358       .
      359     end.
      360   end procedure.
      361   function waitfram-join-function returns character
      362     (input p-line-1 as character
      363     ,input p-line-2 as character
      364     ,input p-line-3 as character
      365     ).
      366     define variable v-message as character no-undo .
      367     run waitfram-join in this-procedure
      368       (input  p-line-1
      369       ,input  p-line-2
      370       ,input  p-line-3
      371       ,output v-message
      372       ) .
      373     return v-message .
      374   end function .
      375   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      376   procedure fltfield-clear :
      377     define output parameter loc-fld as character no-undo.
      378     define output parameter loc-lab as character no-undo .
      379     define output parameter loc-spr as character no-undo .
      380     define output parameter loc-dim as character no-undo .
      381     assign
      382       loc-fld = ""
      383       loc-lab = ""
      384       loc-spr = ""
      385       loc-dim = "0"
      386     .
      387   end procedure .
      388   procedure fltfield-add :
      389     define input        parameter par-fld as character no-undo.
      390     define input        parameter par-lab as character no-undo .
      391     define input        parameter par-spr as character no-undo .
      392     define input-output parameter loc-fld as character no-undo.
      393     define input-output parameter loc-lab as character no-undo .
      394     define input-output parameter loc-spr as character no-undo .
      395     define input-output parameter loc-dim as character no-undo .
      396     do
      397     on error undo, return error
      398     :
      399       assign
      400       loc-fld = if loc-dim = '0'
      401                 then par-fld
      402                 else (loc-fld + chr(44) + par-fld)
      403       loc-lab = if loc-dim = '0'
      404                 then par-lab
      405                 else (loc-lab + chr(44) + par-lab)
      406       loc-spr = if loc-dim = '0'
      407                 then par-spr
      408                 else (loc-spr + chr(44) + par-spr)
      409       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      410                 string(integer(if num-entries(loc-dim) > 1
      411                               then entry(2, loc-dim)
      412                               else entry(1, loc-dim)
      413                               ) + 1)
      414       no-error
      415       .
      416     end.
      417   end procedure.
      418   define new global shared variable g#library  as handle no-undo .
      419   define new global shared variable g#library2 as handle no-undo .
      420   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      421   function usrfulnf returns character ( input p-user-id as character):
      422   define variable v-user-name as character no-undo .
      423   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      424   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      425     (input  p-user-id
      426     ,output v-user-name
      427     ) no-error .
      428   if error-status:error
      429   or v-user-name = ""
      430   then do:
      431     return p-user-id.
      432   end.
      433   else do:
      434     return v-user-name.
      435   end.
      436   end function.
      437   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      438   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      439   procedure fltopend_fltopend :
      440   define input parameter p-parent-handle as handle no-undo .
      441   define input parameter p-qh as handle no-undo .
      442   define input parameter p-flt-open-open-query  as character no-undo .
      443   define input parameter p-where-cond as character no-undo .
      444   define input parameter p-use-indFIRST-query-tail as character no-undo .
      445   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      446   define input parameter p-indexed-reposition as character no-undo .
      447     do
      448     on error undo, return error
      449     :
      450   define variable v-prepare-string as character no-undo .
      451   define variable glog as logical no-undo .
      452   assign
      453   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      454                      p-where-cond + chr(32)  +
      455                      p-use-indFIRST-query-tail + chr(32) +
      456                      p-use-ind-sort-clmn-by + chr(32) +
      457                      p-indexed-reposition
      458   .
      459   assign
      460   glog = p-qh:query-prepare(v-prepare-string) no-error .
      461   if not glog
      462   or error-status:error then do:
      463     message error-status:get-message(1) view-as alert-box .
      464     undo, return error .
      465   end.
      466   assign
      467   glog = p-qh:query-open no-error .
      468   if not glog
      469   or error-status:error then do:
      470     message error-status:get-message(1) view-as alert-box .
      471     undo, return error .
      472   end.
      473     end.
      474   end procedure.
      475   procedure fltopend_fltfindd :
      476   define input parameter p-parent-handle as handle no-undo .
      477   define input parameter p-qh as handle no-undo .
      478   define input parameter p-rowid as rowid no-undo .
      479   define input parameter p-next as logical no-undo .
      480   define input parameter p-lock as integer no-undo .
      481   define input parameter p-bh as handle no-undo .
      482   define input parameter p-where-cond as character no-undo .
      483   define input parameter p-use-index-phrase as character no-undo .
      484   define variable glog as logical no-undo .
      485   define variable v-qh as handle no-undo .
      486   define variable v-bh as handle no-undo .
      487   define variable v-recid as recid no-undo .
      488   define variable v-prepare-string as character no-undo .
      489   do
      490   on error undo, return error
      491   on stop undo, return error
      492   :
      493     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      494     create buffer v-bh for table p-bh buffer-name p-bh:name.
      495     create query v-qh.
      496     v-qh:set-buffers(v-bh).
      497     v-prepare-string = substitute("for each &1 &2 &3"
      498                                     ,v-bh:name
      499                                     ,p-where-cond
      500                                     ,p-use-index-phrase).
      501     glog = v-qh:query-prepare(v-prepare-string) no-error.
      502     if not glog then do:
      503       delete object v-qh.
      504       delete object v-bh.
      505       undo, return error .
      506     end.
      507     glog = v-qh:query-open no-error .
      508     if not glog then do:
      509       delete object v-qh.
      510       delete object v-bh.
      511       undo, return error .
      512     end.
      513     if p-next then do:
      514       v-qh:reposition-to-rowid(p-rowid) no-error .
      515       glog = v-qh:get-next( p-lock) no-error .
      516       glog = v-qh:get-next( p-lock) no-error .
      517       if not glog or v-qh:query-off-end = yes then do:
      518         glog = v-qh:get-first( p-lock) no-error .
      519       end.
      520     end.
      521     else do:
      522       glog = v-qh:get-first( p-lock) no-error .
      523     end.
      524     v-recid = v-bh:recid no-error .
      525     delete object v-qh.
      526     delete object v-bh.
      527     return string(v-recid) .
      528   end.
      529   end procedure.
      530   procedure fltopend_fltfindq :
      531   define input parameter p-parent-handle as handle no-undo .
      532   define input parameter p-qh as handle no-undo .
      533   define input parameter p-next as logical no-undo .
      534   define input parameter p-lock as integer no-undo .
      535   define input parameter p-flt-open-open-query  as character no-undo .
      536   define input parameter p-where-cond as character no-undo .
      537   define input parameter p-use-indFIRST-query-tail as character no-undo .
      538   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      539   define input parameter p-indexed-reposition as character no-undo .
      540   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      541   define variable glog as logical no-undo .
      542   define variable v-qh as handle no-undo .
      543   define variable v-bh as handle no-undo extent 18.
      544   define variable v-rowid as rowid no-undo extent 18.
      545   define variable v-ii as integer no-undo .
      546   define variable v-prepare-string as character no-undo .
      547   do
      548   on error undo, return error
      549   on stop undo, return error
      550   :
      551     create query v-qh.
      552     do v-ii = 1 to p-qh:num-buffers:
      553       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      554       assign
      555       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      556       no-error.
      557       v-qh:add-buffer(v-bh[v-ii]).
      558     end.
      559     assign
      560     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      561                       p-where-cond + chr(32)  +
      562                       p-use-indFIRST-query-tail + chr(32) +
      563                       p-use-ind-sort-clmn-by + chr(32) +
      564                       p-indexed-reposition
      565     .
      566     glog = v-qh:query-prepare( v-prepare-string) no-error .
      567     if not glog then do:
      568       delete object v-qh.
      569       do v-ii = 1 to p-qh:num-buffers:
      570         delete object v-bh[v-ii].
      571       end.
      572       undo, return error .
      573     end.
      574     glog = v-qh:query-open no-error .
      575     if not glog then do:
      576       delete object v-qh.
      577       do v-ii = 1 to p-qh:num-buffers:
      578         delete object v-bh[v-ii].
      579       end.
      580       undo, return error .
      581     end.
      582     if p-next then do:
      583       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      584       glog = v-qh:get-next( p-lock) no-error .
      585       glog = v-qh:get-next( p-lock) no-error .
      586       if not glog or v-qh:query-off-end = yes then do:
      587         glog = v-qh:get-first( p-lock) no-error .
      588       end.
      589     end.
      590     else do:
      591       glog = v-qh:get-first( p-lock) no-error .
      592     end.
      593     do v-ii = 1 to p-qh:num-buffers:
      594       assign
      595       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      596       no-error.
      597     end.
      598     delete object v-qh.
      599     do v-ii = 1 to p-qh:num-buffers:
      600       delete object v-bh[v-ii].
      601     end.
      602   end.
      603   end procedure.
      604   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      605   define  temp-table temp-changes no-undo
      606   field f_name as character
      607   field l_name as character
      608   field v_old as character
      609   field v_new as character
      610   field t_name as character
      611   field num_ as integer
      612   field uniq-key-rec as character
      613   field action as integer
      614   field fNotChange as logical
      615   index pi is unique primary
      616   num_
      617   t_name
      618   f_name
      619   index
      620   Chan
      621   fnotChange
      622   t_name
      623   f_name
      624   index imain uniq-key-rec
      625   .
      626   FUNCTION get-all-fields returns character (p-file-name as character ):
      627   define variable v-dop as character no-undo .
      628     find first _file no-lock where _file._file-name = p-file-name no-error .
      629     if not available _file then return "":U.
      630     for each _field no-lock where
      631              _field._file-recid = recid(_file) :
      632       assign
      633       v-dop = v-dop + _field._field-name + chr(44)
      634       .
      635     end.
      636     return trim(v-dop).
      637   END FUNCTION.
      638   PROCEDURE proc-full-temp-changes :
      639     define input  parameter p-hst-handle as handle    no-undo .
      640     define input  parameter p-main-table as character no-undo .
      641     define input  parameter p-field-list as character no-undo .
      642     define input  parameter p-label-form as character no-undo .
      643     define variable h-new-buf         as handle    no-undo .
      644     define variable h-main-buf        as handle    no-undo .
      645     define variable h-for-comp        as handle    no-undo .
      646     define variable v-inform          as character no-undo .
      647     define variable v-ind             as integer   no-undo .
      648     define variable v-idx-field-qnty  as integer   no-undo .
      649     define variable v-num-entries     as integer   no-undo .
      650     define variable fh                as handle    no-undo .
      651     define variable fh-main           as handle    no-undo .
      652     define variable fh-old            as handle    no-undo .
      653     define variable fh-new            as handle    no-undo .
      654     define variable v-field-name      as character no-undo .
      655     define variable v-field-lvl       as character no-undo .
      656     define variable v-field-form      as character no-undo .
      657     define variable v-search-exp      as character no-undo .
      658     define variable v-srch-main       as character no-undo .
      659     define variable v-word-link       as character no-undo .
      660     define variable v-av-chip-num     as logical   no-undo .
      661     define variable v-main-pi-fld-lst as character no-undo .
      662     define variable v-main-fld-lst    as character no-undo .
      663     define variable v-delim-list      as character no-undo .
      664     define variable v-label           as character no-undo .
      665     define variable v-old-value       as character no-undo case-sensitive.
      666     define variable v-new-value       as character no-undo case-sensitive.
      667     define variable v-chg-fields as character no-undo.
      668     for each temp-changes:
      669       delete temp-changes.
      670     end.
      671     if not p-hst-handle:available then do:
      672       return .
      673     end.
      674     create buffer h-new-buf  for table p-hst-handle .
      675     create buffer h-main-buf for table p-main-table .
      676     assign
      677       v-inform = h-main-buf:index-information(1)
      678       v-ind    = 2
      679     .
      680     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      681     on error undo, return error
      682     :
      683       assign
      684         v-inform = h-main-buf:index-information( v-ind )
      685         v-ind    = v-ind + 1
      686       .
      687     end.
      688     if v-inform = ?
      689       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      690       or entry( 3, v-inform, ",":U ) <> "1":U
      691     then do:
      692       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      693     end.
      694     assign
      695       v-idx-field-qnty = num-entries( v-inform ) - 4
      696     .
      697     if v-idx-field-qnty < 2 then do:
      698       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      699     end.
      700     assign
      701       v-srch-main   = "where":U
      702       v-word-link   = "":U
      703       v-av-chip-num = false
      704       v-delim-list  = "":U
      705     .
      706     do v-ind = 1 to v-idx-field-qnty by 2
      707     on error undo, return error
      708     :
      709       assign
      710         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      711         fh                = p-hst-handle:buffer-field( v-field-name )
      712         fh-main           = h-main-buf:buffer-field( v-field-name )
      713         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      714         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      715       .
      716       if fh:data-type ="character":U then do:
      717         assign
      718           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      719         .
      720       end.
      721       else do:
      722         assign
      723           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      724         .
      725       end.
      726       if v-delim-list = "":U then do:
      727         assign
      728           v-delim-list = ",":U
      729         .
      730       end.
      731       if v-word-link = "":U then do:
      732         assign
      733           v-word-link = "and":U
      734         .
      735       end.
      736     end.
      737     assign
      738       v-delim-list  = "":U
      739     .
      740     do v-ind = 1 to h-main-buf:num-fields
      741     on error undo, return error
      742     :
      743       assign
      744         fh-main      = h-main-buf:buffer-field( v-ind )
      745         v-field-name = fh-main:name
      746       .
      747         assign
      748           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      749         .
      750         if v-delim-list = "":U then do:
      751           assign
      752             v-delim-list = ",":U
      753           .
      754         end.
      755     end.
      756     assign
      757       v-inform = p-hst-handle:index-information(1)
      758       v-ind    = 2
      759     .
      760     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      761     on error undo, return error
      762     :
      763       assign
      764         v-inform = p-hst-handle:index-information( v-ind )
      765         v-ind    = v-ind + 1
      766       .
      767     end.
      768     if v-inform = ?
      769       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      770       or entry( 3, v-inform, ",":U ) <> "1":U
      771     then do:
      772       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      773     end.
      774     assign
      775       v-idx-field-qnty = num-entries( v-inform ) - 4
      776     .
      777     if v-idx-field-qnty < 2 then do:
      778       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      779     end.
      780     assign
      781       v-search-exp  = "where":U
      782       v-word-link   = "":U
      783       v-av-chip-num = false
      784     .
      785     do v-ind = 1 to v-idx-field-qnty by 2
      786     on error undo, return error
      787     :
      788       assign
      789         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      790         fh           = p-hst-handle:buffer-field( v-field-name )
      791         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      792       .
      793       if v-field-name = "chip-num":U then do:
      794         assign
      795           v-search-exp  = substitute( "&1 >", v-search-exp )
      796           v-av-chip-num = true
      797         .
      798       end.
      799       else do:
      800         assign
      801           v-search-exp = substitute( "&1 =", v-search-exp )
      802         .
      803       end.
      804       if fh:data-type ="character":U then do:
      805         assign
      806           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      807         .
      808       end.
      809       else do:
      810         assign
      811           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
      812         .
      813       end.
      814       if v-word-link = "":U then do:
      815         assign
      816           v-word-link = "and":U
      817         .
      818       end.
      819     end.
      820     if v-av-chip-num = false then do:
      821       message
      822         vss-workfile vss-revision vss-description skip
      823         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
      824         "Использование данной процедуры невозможно!" skip
      825         view-as alert-box error .
      826       return error .
      827     end.
      828     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
      829     if not h-new-buf:available then do:
      830       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
      831       if not h-main-buf:available then do:
      832         assign
      833           h-for-comp = ?
      834         .
      835       end.
      836       else do:
      837         assign
      838           h-for-comp = h-main-buf
      839         .
      840       end.
      841     end.
      842     else do:
      843       assign
      844         h-for-comp = h-new-buf
      845       .
      846     end.
      847     assign
      848       v-num-entries = num-entries( v-main-fld-lst, ",":U )
      849     .
      850     do v-ind = 1 to v-num-entries
      851     on error undo, return error return-value
      852     :
      853       assign
      854         v-field-name = entry( v-ind, v-main-fld-lst )
      855         fh-old       = p-hst-handle:buffer-field( v-field-name )
      856         v-old-value  = fh-old:buffer-value()
      857         v-label      = trim( fh-old:label )
      858       .
      859       if ( trim( p-field-list ) <> "":U
      860            and lookup( v-field-name, p-field-list ) > 0
      861          )
      862          or trim( p-field-list ) = "":U
      863       then do:
      864         if h-for-comp <> ? then do:
      865           assign
      866             fh-new      = h-for-comp:buffer-field( v-field-name )
      867             v-new-value = fh-new:buffer-value()
      868           .
      869         end.
      870         else do:
      871           assign
      872             v-new-value = "":U
      873           .
      874         end.
      875         if v-old-value <> v-new-value
      876         then do:
      877           create temp-changes.
      878           assign
      879             temp-changes.t_name = p-main-table
      880             temp-changes.f_name = v-field-name
      881             temp-changes.l_name = replace( v-label, "&":U, "":U )
      882             temp-changes.v_old  = trim( v-old-value )
      883             temp-changes.v_new  = trim( v-new-value )
      884             temp-changes.num_   = 0
      885             temp-changes.fNotChange = v-old-value eq v-new-value
      886           .
      887         end.
      888       end.
      889     end.
      890     assign
      891       v-num-entries = num-entries( p-label-form, chr(8) )
      892     .
      893     do v-ind = 1 to v-num-entries
      894     on error undo, return error return-value
      895     :
      896       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
      897         assign
      898           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      899           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      900           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      901         .
      902         find first temp-changes
      903           where temp-changes.f_name = v-field-name
      904           no-error .
      905         if available temp-changes then do:
      906           if trim( v-field-lvl ) <> "":U then do:
      907             assign
      908               temp-changes.l_name = v-field-lvl
      909             .
      910           end.
      911           if trim( v-field-form ) <> "":U then do:
      912             assign
      913               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
      914             .
      915             if h-for-comp <> ? then do:
      916               assign
      917                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
      918               .
      919             end.
      920           end.
      921         end.
      922       end.
      923       else do:
      924         message
      925           vss-workfile vss-revision vss-description skip
      926           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
      927           substitute( "список для поля '&1': '&2'"
      928                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      929                       ,entry( v-ind, p-label-form, chr(8) )
      930                     ) skip
      931           substitute( "полный список: &2", p-label-form ) skip
      932           view-as alert-box error .
      933       end.
      934     end.
      935     delete object h-new-buf .
      936     delete object h-main-buf .
      937   END PROCEDURE.
      938   define variable filter-label0 as character no-undo init "Список истории пунктов отгрузки/доставки" .
      939   define variable filter-point0 as character no-undo init "ptiohist" .
      940   define variable filter-label as character no-undo init "Список истории пунктов отгрузки/доставки" .
      941   define variable filter-point as character no-undo init "ptiohist" .
      942   define variable sort-column-name as character no-undo .
      943   define variable v-doc-rec as recid no-undo .
      944   define variable title0 as character no-undo.
      945   FUNCTION mark-string RETURNS CHARACTER
      946     ( input par-recid as recid, input mark-list as character)  FORWARD.
      947   DEFINE BUTTON B-Help
      948        LABEL "Помо&щь"
      949        SIZE 10 BY 1
      950        BGCOLOR 8 .
      951   DEFINE BUTTON B-mark
      952        LABEL "&*"
      953        SIZE 3 BY 1.
      954   DEFINE BUTTON b-quit AUTO-GO
      955        LABEL "&Выход"
      956        SIZE 10 BY 1
      957        BGCOLOR 8 .
      958   DEFINE BUTTON B-sch
      959        LABEL "&Фильтр"
      960        SIZE 10 BY 1.
      961   DEFINE BUTTON b-sel AUTO-GO
      962        LABEL "Вы&бор"
      963        SIZE 10 BY 1
      964        BGCOLOR 8 .
      965   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
      966         VIEW-AS TEXT
      967        SIZE 6 BY 1
      968        FGCOLOR 4  NO-UNDO.
      969   DEFINE QUERY br-c-point-io FOR
      970         X_c-point-io SCROLLING.
      971   DEFINE QUERY BR-changes FOR
      972         temp-changes SCROLLING.
      973   DEFINE BROWSE br-c-point-io
      974     QUERY br-c-point-io DISPLAY
      975         (mark-string(recid(X_c-point-io), p-rid-list)) COLUMN-LABEL "*" FORMAT "x(1)"
      976         X_c-point-io.corr-date                    COLUMN-LABEL "Дата!изменения"  FORMAT "99/99/99"
      977         string(X_c-point-io.corr-time,"HH:MM")    COLUMN-LABEL "Время!изменения" FORMAT "X(5)"
      978         usrfulnf(X_c-point-io.corr-user-name)               COLUMN-LABEL "Оператор"        FORMAT "X(18)"
      979         X_c-point-io.point-code FORMAT "9999999":U
      980         X_c-point-io.point-type COLUMN-LABEL "Пункт" FORMAT "X(8)":U
      981         X_c-point-io.point-name COLUMN-LABEL "Наименование" FORMAT "X(40)":U
      982         TRIM (X_c-point-io.cli-type + ' ' + STRING (X_c-point-io.cli-code) )  COLUMN-LABEL "Контрагент" FORMAT "X(13)":U
      983         X_c-point-io.is-default COLUMN-LABEL "У" FORMAT "+/ "
      984         X_c-point-io.address
      985         X_c-point-io.dist      COLUMN-LABEL "Километраж"
      986         X_c-point-io.status_ FORMAT "X(8)":U
      987         X_c-point-io.PS FORMAT "X(50)":U
      988       ENABLE
      989         X_c-point-io.point-code
      990       WITH NO-ROW-MARKERS SEPARATORS SIZE 96 BY 13.71.
      991   DEFINE BROWSE BR-changes
      992     QUERY BR-changes DISPLAY
      993         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(35)"
      994   temp-changes.v_old COLUMn-LABEL "Было" format "X(40)"
      995   temp-changes.v_new COLUMn-LABEL "Стало" format "X(40)"
      996       WITH NO-ROW-MARKERS SEPARATORS SIZE 95.88 BY 5.83.
      997   DEFINE FRAME Dialog-Frame
      998        b-quit AT ROW 1 COL 1
      999        B-mark AT ROW 1 COL 11
     1000        b-sel AT ROW 1 COL 21
     1001        B-sch AT ROW 1 COL 41
     1002        B-Help AT ROW 1 COL 86.25
     1003        br-c-point-io AT ROW 2 COL 1.38
     1004        BR-changes AT ROW 16.04 COL 1.38
     1005        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1006        SPACE(77.49) SKIP(20.03)
     1007       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1008            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1009            TITLE "Список договоров"
     1010            CANCEL-BUTTON b-quit.
     1011   ASSIGN
     1012          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1013          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1014   ASSIGN
     1015          br-c-point-io:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame = 1.
     1016   ON ENDKEY OF FRAME Dialog-Frame
     1017   DO:
     1018       run gbl/markqwa.p ( input b-mark:sensitive, input p-rid-list) no-error.
     1019       if error-status:error then return no-apply.
     1020   END.
     1021   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1022   DO:
     1023   define variable loc#log as logical no-undo .
     1024     if available X_c-point-io then do:
     1025         if can-do( p-rid-list, string( recid( X_c-point-io ) ) ) then do:
     1026             p-rid-list = replace( p-rid-list, chr(44) + string( recid( X_c-point-io ) ), "") .
     1027             p-rid-list = replace( p-rid-list, string( recid( X_c-point-io ) ) + chr(44), "") .
     1028             p-rid-list = replace( p-rid-list, string( recid( X_c-point-io ) ), "") .
     1029         end.
     1030         else
     1031         p-rid-list = p-rid-list + ( if p-rid-list = "" then "" else chr(44) ) + string( recid( X_c-point-io ) ) .
     1032         loc#log = br-c-point-io:refresh() .
     1033         if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1034             loc#log = br-c-point-io:select-next-row ().
     1035             apply "VALUE-CHANGED" to br-c-point-io in frame Dialog-Frame.
     1036         end.
     1037         if num-entries( p-rid-list ) = 0 then hide mark-num in frame Dialog-Frame.
     1038         else disp num-entries( p-rid-list ) @ mark-num with frame Dialog-Frame.
     1039     end.
     1040     apply "entry" to br-c-point-io in frame Dialog-Frame.
     1041   END.
     1042   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1043   DO:
     1044     assign
     1045       tbl = 'c-point-io'
     1046       join-tbl = 'X_c-point-io'
     1047       fld = ""
     1048       lab = ""
     1049       spr = ""
     1050       dim = '0'
     1051     .
     1052     run fltfield-add in this-procedure('db-num', 'БД', '',
     1053     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1054     run fltfield-add in this-procedure('cli-code', 'Код контрагента', '',
     1055     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1056     run fltfield-add in this-procedure('cli-type', 'Тип объекта', '',
     1057     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1058     run fltfield-add in this-procedure('point-type', 'Тип пункта', '',
     1059     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1060     run fltfield-add in this-procedure('point-code', 'Код пункта', '',
     1061     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1062     run fltfield-add in this-procedure('point-name', 'Название пункта', '',
     1063     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1064     run fltfield-add in this-procedure('status_', 'Статус', '',
     1065     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1066     run fltfield-add in this-procedure('PS', 'Примечание', '',
     1067     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1068     run fltfield-add in this-procedure('is-default', 'По молчанию', '',
     1069     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1070     run fltfield-add in this-procedure('address', 'Адрес', '',
     1071     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1072     run fltfield-add in this-procedure('dist', 'Километраж', '',
     1073     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1074   Filter-Block:
     1075     DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     1076        ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     1077        ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     1078       run gbl/filter.w ( INPUT parparentproc
     1079                       , INPUT (filter-point + chr(4) +
     1080                               filter-label)
     1081                        , INPUT tbl
     1082                        , INPUT join-tbl
     1083                        , INPUT fld
     1084                        , INPUT lab
     1085                        , INPUT spr
     1086                        , INPUT dim ).
     1087       RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     1088     end.
     1089   END.
     1090   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1091   DO:
     1092     if ( available X_c-point-io ) AND ( p-rid-list = "" ) then  p-rid-list = string( recid( X_c-point-io ) ) .
     1093   END.
     1094   ON RETURN OF br-c-point-io IN FRAME Dialog-Frame
     1095   or MOUSE-SELECT-DBLCLICK OF br-c-point-io IN FRAME Dialog-Frame
     1096   DO:
     1097     if b-sel:sensitive in frame Dialog-Frame then
     1098       if b-mark:sensitive then apply "choose" to b-mark in frame Dialog-Frame.
     1099       else                     apply "choose" to b-sel in frame Dialog-Frame.
     1100   END.
     1101   ON VALUE-CHANGED OF br-c-point-io IN FRAME Dialog-Frame
     1102   DO:
     1103     run proc-view-changes in this-procedure no-error.
     1104   END.
     1105   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1106   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1107   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1108   on help of frame Dialog-Frame
     1109   do:
     1110     run gbl/app_help.p
     1111       (input this-procedure :file-name
     1112       ,input ''
     1113       ,input ?
     1114       ) no-error.
     1115     if error-status :error then do:
     1116       message
     1117         "Ошибка при вызове помощи"
     1118         error-status :get-message(1)
     1119         view-as alert-box .
     1120     end.
     1121   end.
     1122   run minbtn-set in this-procedure .
     1123   on choose of b-help in frame Dialog-Frame
     1124   do:
     1125     apply "help":u to frame Dialog-Frame .
     1126   end.
     1127   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1128   procedure minbtn-set :
     1129       do
     1130           on error undo, return error return-value
     1131           :
     1132           define variable ii              as integer       no-undo .
     1133           define variable fh              as widget-handle no-undo .
     1134           define variable hh              as widget-handle no-undo .
     1135           define variable v-h             as handle        extent 4 no-undo .
     1136           define variable v-name-button   as character     no-undo .
     1137           define variable v-help-old-x    as decimal       no-undo .
     1138           define variable v-help-old-y    as decimal       no-undo .
     1139           define variable v-help-old-size as decimal       no-undo .
     1140           define variable v-frame-width   as decimal       no-undo .
     1141           define variable jj              as integer       no-undo .
     1142           do
     1143               on error undo, return error
     1144               :
     1145               assign
     1146                   v-frame-width = frame Dialog-Frame:width - 0.3
     1147                   fh            = frame Dialog-Frame:first-child
     1148                   hh            = fh:first-child
     1149                   ii            = 1
     1150                   .
     1151               do while valid-handle(hh):
     1152                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1153                   do:
     1154                       case lc(hh:name) :
     1155                           when "b-help" then
     1156                               do:
     1157                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1158                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1159                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1160                                   hh:TOOLTIP = "Помощь" .
     1161                                   v-help-old-x = hh:column .
     1162                                   v-help-old-y = hh:row    .
     1163                                   v-help-old-size = hh:width .
     1164                                   hh:width-chars = 2.5 .
     1165                               end.
     1166                           when "b-print" then
     1167                               do:
     1168                                   hh:load-image("cmp/b-print.bmp":u) .
     1169                                   hh:TOOLTIP = "Печать" .
     1170                                   v-h[ii] = hh:handle .
     1171                                   ii = ii + 1 .
     1172                                   hh:width-chars = 3 .
     1173                               end.
     1174                           when "b-history" or
     1175                           when "b-hist" then
     1176                               do:
     1177                                   hh:load-image("cmp/b-hist.bmp":u) .
     1178                                   hh:TOOLTIP = "История" .
     1179                                   v-h[ii] = hh:handle .
     1180                                   ii = ii + 1 .
     1181                                   hh:width-chars = 3 .
     1182                               end.
     1183                           when "b-sch" then
     1184                               do:
     1185                                   hh:load-image("cmp/b-sch.bmp":u) .
     1186                                   hh:TOOLTIP = "Установка Фильтра" .
     1187                                   v-h[ii] = hh:handle .
     1188                                   ii = ii + 1 .
     1189                                   hh:width-chars = 3 .
     1190                               end.
     1191                           when "b-hist-user" then
     1192                               do:
     1193                                   hh:load-image("cmp/b-hist.bmp":u) .
     1194                                   hh:TOOLTIP = "История пользователя" .
     1195                                   ii = ii + 1 .
     1196                               end.
     1197                       end case.
     1198                   end.
     1199                   hh = hh:next-sibling.
     1200               end.
     1201               b-help:column = v-frame-width - b-help:width-chars.
     1202               jj = 0.
     1203               repeat ii = 4 to 1 by -1 :
     1204                   if valid-handle (v-h[ii] ) then
     1205                   do:
     1206                       jj  = jj + 1 .
     1207                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1208                       v-h[ii]:row    = v-help-old-y .
     1209                   end.
     1210               end.
     1211           end.
     1212       end.
     1213   end procedure.
     1214   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1215   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1216   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1217   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1218   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1219   define variable v-diasize-current-frame-height as decimal   no-undo .
     1220   define variable v-diasize-change-size          as logical   no-undo .
     1221   define variable v-diasize-resize-button        as handle    no-undo .
     1222   define variable v-diasize-wndmax               as logical   no-undo .
     1223   define variable v-diasize-wndstore             as logical   no-undo .
     1224   define variable v-diasize-proc-name            as character no-undo .
     1225   define variable v-diasize-browse-handle        as handle    no-undo .
     1226   define variable v-diasize-browse-number        as integer   no-undo .
     1227   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1228   define temp-table temp-diasize-handle no-undo
     1229     field handle-value  as handle
     1230     field save-position as decimal
     1231     index xpk is primary unique handle-value
     1232     .
     1233   define temp-table temp-browse-handle no-undo
     1234     field browse-type   as character
     1235     field browse-number as integer
     1236     field browse-handle as handle
     1237     field original-size as decimal
     1238     index xpk is primary unique browse-type browse-number
     1239     index xie browse-type browse-handle
     1240   .
     1241   procedure diasize_change-height :
     1242     define input  parameter p-change-value  as decimal   no-undo .
     1243     define input  parameter p-move-resize   as logical   no-undo .
     1244     define variable v-field-group-handle    as handle    no-undo .
     1245     define variable v-object-handle         as handle    no-undo .
     1246     define variable v-frame-height          as decimal   no-undo .
     1247     define variable v-frame-virtual-height  as decimal   no-undo .
     1248     define variable v-browse-height         as decimal   no-undo .
     1249     define variable v-window-height         as decimal   no-undo .
     1250     define variable v-window-virtual-height as decimal   no-undo .
     1251     define variable v-change-sign           as integer   no-undo .
     1252     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1253     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1254     if p-change-value > 0
     1255     then do:
     1256       if frame Dialog-Frame :height + p-change-value
     1257           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1258       then do:
     1259         assign
     1260           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1261                           - (frame Dialog-Frame :height-chars)
     1262         .
     1263         if p-change-value <= 0
     1264         then do:
     1265           run diasize_position-resize-button in this-procedure .
     1266           return .
     1267         end.
     1268       end.
     1269     end.
     1270     if p-change-value < 0
     1271     then do:
     1272       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1273       then do:
     1274         assign
     1275           p-change-value = v-diasize-orig-frame-height
     1276                          - (frame Dialog-Frame :height-chars)
     1277         .
     1278         if p-change-value >= 0
     1279         then do:
     1280           run diasize_position-resize-button in this-procedure .
     1281           return .
     1282         end.
     1283       end.
     1284     end.
     1285     if p-change-value >= 0
     1286     then do:
     1287       assign
     1288         v-change-sign = 1
     1289       .
     1290     end.
     1291     else do:
     1292       assign
     1293         v-change-sign = -1
     1294       .
     1295     end.
     1296     assign
     1297       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1298     .
     1299     if p-change-value = 0
     1300     then do:
     1301       run diasize_position-resize-button in this-procedure .
     1302       return .
     1303     end.
     1304     move_block:
     1305     do
     1306     on error undo move_block, retry move_block
     1307     :
     1308       if retry
     1309       then do:
     1310         do
     1311         on error undo move_block, leave move_block
     1312         :
     1313           if p-change-value > 0
     1314           then do:
     1315             for each buf_temp-diasize-handle
     1316             on error undo, next
     1317             :
     1318               assign
     1319                 v-object-handle = buf_temp-diasize-handle.handle-value
     1320               .
     1321               if v-object-handle <> v-diasize-resize-button
     1322               then do:
     1323                 assign
     1324                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1325                 .
     1326               end.
     1327             end.
     1328             assign
     1329               v-diasize-browse-handle :height = v-browse-height
     1330             .
     1331             for each buf_temp-browse-handle
     1332               where buf_temp-browse-handle.browse-type = 'height':u
     1333             on error undo, next
     1334             :
     1335               assign
     1336                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1337               .
     1338             end.
     1339             assign
     1340               frame Dialog-Frame :height = v-frame-height
     1341             .
     1342             if frame Dialog-Frame :scrollable = true
     1343             then do:
     1344               assign
     1345                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1346               .
     1347             end.
     1348             run diasize_position-resize-button in this-procedure .
     1349           end.
     1350           else do:
     1351             if frame Dialog-Frame :scrollable = true
     1352             then do:
     1353               assign
     1354                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1355               .
     1356             end.
     1357             assign
     1358               frame Dialog-Frame :height = v-frame-height
     1359             .
     1360             assign
     1361               v-diasize-browse-handle :height = v-browse-height
     1362             .
     1363             for each buf_temp-browse-handle
     1364               where buf_temp-browse-handle.browse-type = 'height':u
     1365             on error undo, next
     1366             :
     1367               assign
     1368                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1369               .
     1370             end.
     1371             for each buf_temp-diasize-handle
     1372             on error undo, next
     1373             :
     1374               assign
     1375                 v-object-handle = buf_temp-diasize-handle.handle-value
     1376               .
     1377               if v-object-handle <> v-diasize-resize-button
     1378               then do:
     1379                 assign
     1380                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1381                 .
     1382               end.
     1383             end.
     1384             run diasize_position-resize-button in this-procedure .
     1385           end.
     1386           assign
     1387             v-diasize-change-size = false
     1388           .
     1389           leave move_block .
     1390         end.
     1391       end.
     1392       assign
     1393         v-diasize-need-full-display = true
     1394       .
     1395       if v-diasize-change-size = false
     1396       then do:
     1397         assign
     1398           v-diasize-change-size = true
     1399         .
     1400       end.
     1401       else do:
     1402         return .
     1403       end.
     1404       assign
     1405         v-frame-height = frame Dialog-Frame :height
     1406         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1407         v-browse-height = v-diasize-browse-handle :height
     1408       .
     1409       for each buf_temp-browse-handle
     1410         where buf_temp-browse-handle.browse-type = 'height':u
     1411       :
     1412         assign
     1413           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1414         .
     1415       end.
     1416       for each buf_temp-diasize-handle
     1417       :
     1418         delete buf_temp-diasize-handle .
     1419       end.
     1420       assign
     1421         v-field-group-handle = frame Dialog-Frame :first-child
     1422       .
     1423       do while valid-handle(v-field-group-handle)
     1424       :
     1425         assign
     1426           v-object-handle = v-field-group-handle :first-child
     1427         .
     1428         do while valid-handle(v-object-handle)
     1429         :
     1430           if  v-object-handle <> v-diasize-browse-handle :handle
     1431           and can-query(v-object-handle, "row")
     1432           and can-query(v-object-handle, "height")
     1433           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1434           then do:
     1435             find first buf_temp-browse-handle
     1436               where buf_temp-browse-handle.browse-type   = 'height':u
     1437                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1438               no-error .
     1439             if available buf_temp-browse-handle
     1440             then do:
     1441             end.
     1442             else do:
     1443               create buf_temp-diasize-handle .
     1444               assign
     1445                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1446                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1447               .
     1448             end.
     1449           end.
     1450           assign
     1451             v-object-handle = v-object-handle :next-sibling
     1452           .
     1453         end.
     1454         assign
     1455           v-field-group-handle = v-field-group-handle :next-sibling
     1456         .
     1457       end.
     1458       do with frame Dialog-Frame
     1459       :
     1460         hide v-diasize-resize-button .
     1461         assign
     1462           v-diasize-resize-button :row    = 1
     1463           v-diasize-resize-button :column = 1
     1464         .
     1465       end.
     1466       if p-change-value > 0
     1467       then do:
     1468         if frame Dialog-Frame :scrollable = true
     1469         then do:
     1470           assign
     1471             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1472             no-error .
     1473           if error-status :error
     1474           or error-status :get-message(1) <> ""
     1475           then do:
     1476             undo move_block, retry move_block .
     1477           end.
     1478         end.
     1479         assign
     1480           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1481           no-error .
     1482         if error-status :error
     1483         or error-status :get-message(1) <> ""
     1484         then do:
     1485           undo move_block, retry move_block .
     1486         end.
     1487         assign
     1488           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1489           no-error .
     1490         if error-status :error
     1491         or error-status :get-message(1) <> ""
     1492         then do:
     1493           undo move_block, retry move_block .
     1494         end.
     1495         for each buf_temp-browse-handle
     1496           where buf_temp-browse-handle.browse-type = 'height':u
     1497         on error undo move_block, retry move_block
     1498         :
     1499           assign
     1500             buf_temp-browse-handle.browse-handle :height
     1501               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1502             no-error .
     1503           if error-status :error
     1504           or error-status :get-message(1) <> ""
     1505           then do:
     1506             undo move_block, retry move_block .
     1507           end.
     1508         end.
     1509         for each buf_temp-diasize-handle
     1510         on error undo move_block, retry move_block
     1511         :
     1512           assign
     1513             v-object-handle = buf_temp-diasize-handle.handle-value
     1514           .
     1515           if v-object-handle <> v-diasize-resize-button
     1516           then do:
     1517             assign
     1518               v-object-handle :row = v-object-handle :row + p-change-value
     1519               no-error .
     1520             if error-status :error
     1521             or error-status :get-message(1) <> ""
     1522             then do:
     1523               undo move_block, retry move_block .
     1524             end.
     1525           end.
     1526         end.
     1527       end.
     1528       else do:
     1529         for each buf_temp-diasize-handle
     1530         on error undo move_block, retry move_block
     1531         :
     1532           assign
     1533             v-object-handle = buf_temp-diasize-handle.handle-value
     1534           .
     1535           if v-object-handle <> v-diasize-resize-button
     1536           then do:
     1537             assign
     1538               v-object-handle :row = v-object-handle :row + p-change-value
     1539               no-error .
     1540             if error-status :error
     1541             or error-status :get-message(1) <> ""
     1542             then do:
     1543               undo move_block, retry move_block .
     1544             end.
     1545           end.
     1546         end.
     1547         assign
     1548           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1549           no-error .
     1550         if error-status :error
     1551         or error-status :get-message(1) <> ""
     1552         then do:
     1553           undo move_block, retry move_block .
     1554         end.
     1555         for each buf_temp-browse-handle
     1556           where buf_temp-browse-handle.browse-type = 'height':u
     1557         on error undo move_block, retry move_block
     1558         :
     1559           assign
     1560             buf_temp-browse-handle.browse-handle :height
     1561               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1562             no-error .
     1563           if error-status :error
     1564           or error-status :get-message(1) <> ""
     1565           then do:
     1566             undo move_block, retry move_block .
     1567           end.
     1568         end.
     1569         assign
     1570           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1571           no-error .
     1572         if error-status :error
     1573         or error-status :get-message(1) <> ""
     1574         then do:
     1575           undo move_block, retry move_block .
     1576         end.
     1577         if frame Dialog-Frame :scrollable = true
     1578         then do:
     1579           assign
     1580             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1581             no-error .
     1582           if error-status :error
     1583           or error-status :get-message(1) <> ""
     1584           then do:
     1585             undo move_block, retry move_block .
     1586           end.
     1587         end.
     1588       end.
     1589       if p-move-resize = true
     1590       then do:
     1591         run diasize_position-resize-button in this-procedure .
     1592       end.
     1593       if v-diasize-wndstore = true
     1594       then do:
     1595         if connected("ub") = true
     1596         then do:
     1597           define variable v-cntxt-db-num        as integer   no-undo .
     1598           define variable v-cntxt-userid        as character no-undo .
     1599           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1600                                             , OUTPUT v-cntxt-userid
     1601                                             ) .
     1602           run gbl/wndsizew.p
     1603             (input  v-cntxt-db-num
     1604             ,input  v-cntxt-userid
     1605             ,input  v-diasize-proc-name
     1606             ,input  'height':u
     1607             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1608             ) .
     1609         end.
     1610       end.
     1611     end.
     1612     assign
     1613       v-diasize-change-size = false
     1614     .
     1615   end procedure.
     1616   procedure diasize_set-height :
     1617     define input  parameter p-new-height  as decimal   no-undo .
     1618     define input  parameter p-move-resize as logical   no-undo .
     1619     do
     1620     on error undo, return error return-value
     1621     :
     1622       run diasize_change-height in this-procedure
     1623         (input  (p-new-height - frame Dialog-Frame :height)
     1624         ,input  p-move-resize
     1625         ) .
     1626     end.
     1627   end procedure.
     1628   procedure diasize_change-width :
     1629     define input  parameter p-change-value as decimal   no-undo .
     1630     define input  parameter p-move-resize  as logical   no-undo .
     1631     define variable v-field-group-handle   as handle    no-undo .
     1632     define variable v-object-handle        as handle    no-undo .
     1633     define variable v-frame-width          as decimal   no-undo .
     1634     define variable v-frame-virtual-width  as decimal   no-undo .
     1635     define variable v-browse-width         as decimal   no-undo .
     1636     define variable v-window-width         as decimal   no-undo .
     1637     define variable v-window-virtual-width as decimal   no-undo .
     1638     define variable v-change-sign          as integer   no-undo .
     1639     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1640     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1641     if p-change-value > 0
     1642     then do:
     1643       if frame Dialog-Frame :width + p-change-value >
     1644           session :width-chars
     1645       then do:
     1646         assign
     1647           p-change-value = session :width-chars - frame Dialog-Frame :width
     1648         .
     1649         if p-change-value <= 0
     1650         then do:
     1651           run diasize_position-resize-button in this-procedure .
     1652           return .
     1653         end.
     1654       end.
     1655     end.
     1656     if p-change-value < 0
     1657     then do:
     1658       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1659       then do:
     1660         assign
     1661           p-change-value = v-diasize-orig-frame-width
     1662                          - frame Dialog-Frame :width
     1663         .
     1664         if p-change-value >= 0
     1665         then do:
     1666           run diasize_position-resize-button in this-procedure .
     1667           return .
     1668         end.
     1669       end.
     1670     end.
     1671     if p-change-value >= 0
     1672     then do:
     1673       assign
     1674         v-change-sign = 1
     1675       .
     1676     end.
     1677     else do:
     1678       assign
     1679         v-change-sign = -1
     1680       .
     1681     end.
     1682     assign
     1683       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1684     .
     1685     if p-change-value = 0
     1686     then do:
     1687       run diasize_position-resize-button in this-procedure .
     1688       return .
     1689     end.
     1690     move_block:
     1691     do
     1692     on error undo move_block, leave move_block
     1693     :
     1694       if retry
     1695       then do:
     1696         do
     1697         on error undo move_block, leave move_block
     1698         :
     1699           if p-change-value > 0
     1700           then do:
     1701             for each buf_temp-diasize-handle
     1702             on error undo, next
     1703             :
     1704               assign
     1705                 v-object-handle = buf_temp-diasize-handle.handle-value
     1706               .
     1707               if v-object-handle <> v-diasize-resize-button
     1708               then do:
     1709                 assign
     1710                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1711                 .
     1712               end.
     1713             end.
     1714             assign
     1715               v-diasize-browse-handle :width = v-browse-width
     1716             .
     1717             for each buf_temp-browse-handle
     1718               where buf_temp-browse-handle.browse-type = 'width':u
     1719             on error undo, next
     1720             :
     1721               assign
     1722                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1723               .
     1724             end.
     1725             assign
     1726               frame Dialog-Frame :width = v-frame-width
     1727             .
     1728             if frame Dialog-Frame :scrollable = true
     1729             then do:
     1730               assign
     1731                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1732               .
     1733             end.
     1734             run diasize_position-resize-button in this-procedure .
     1735           end.
     1736           else do:
     1737             if frame Dialog-Frame :scrollable = true
     1738             then do:
     1739               assign
     1740                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1741               .
     1742             end.
     1743             assign
     1744               frame Dialog-Frame :width = v-frame-width
     1745             .
     1746             for each buf_temp-browse-handle
     1747               where buf_temp-browse-handle.browse-type = 'width':u
     1748             on error undo, next
     1749             :
     1750               assign
     1751                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1752               .
     1753             end.
     1754             assign
     1755               v-diasize-browse-handle :width = v-browse-width
     1756             .
     1757             for each buf_temp-diasize-handle
     1758             on error undo, next
     1759             :
     1760               assign
     1761                 v-object-handle = buf_temp-diasize-handle.handle-value
     1762               .
     1763               if v-object-handle <> v-diasize-resize-button
     1764               then do:
     1765                 assign
     1766                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1767                 .
     1768               end.
     1769             end.
     1770             run diasize_position-resize-button in this-procedure .
     1771           end.
     1772           assign
     1773             v-diasize-change-size = false
     1774           .
     1775           leave move_block .
     1776         end.
     1777       end.
     1778       assign
     1779         v-diasize-need-full-display = true
     1780       .
     1781       if v-diasize-change-size = false
     1782       then do:
     1783         assign
     1784           v-diasize-change-size = true
     1785         .
     1786       end.
     1787       else do:
     1788         return .
     1789       end.
     1790       assign
     1791         v-frame-width = frame Dialog-Frame :width
     1792         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1793         v-browse-width = v-diasize-browse-handle :width
     1794       .
     1795       for each buf_temp-browse-handle
     1796         where buf_temp-browse-handle.browse-type = 'width':u
     1797       :
     1798         assign
     1799           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1800         .
     1801       end.
     1802       for each buf_temp-diasize-handle
     1803       :
     1804         delete buf_temp-diasize-handle .
     1805       end.
     1806       assign
     1807         v-field-group-handle = frame Dialog-Frame :first-child
     1808       .
     1809       do while valid-handle(v-field-group-handle)
     1810       :
     1811         assign
     1812           v-object-handle = v-field-group-handle :first-child
     1813         .
     1814         do while valid-handle(v-object-handle)
     1815         :
     1816           if  v-object-handle <> v-diasize-browse-handle :handle
     1817           and v-object-handle <> v-diasize-resize-button
     1818           and can-query(v-object-handle, "row")
     1819           and can-query(v-object-handle, "height")
     1820           and ( v-object-handle :col + v-object-handle :width
     1821                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1822               )
     1823           then do:
     1824             find first buf_temp-browse-handle
     1825               where buf_temp-browse-handle.browse-type   = 'width':u
     1826                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1827               no-error .
     1828             if available buf_temp-browse-handle
     1829             then do:
     1830             end.
     1831             else do:
     1832               create buf_temp-diasize-handle .
     1833               assign
     1834                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1835                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1836               .
     1837             end.
     1838           end.
     1839           assign
     1840             v-object-handle = v-object-handle :next-sibling
     1841           .
     1842         end.
     1843         assign
     1844           v-field-group-handle = v-field-group-handle :next-sibling
     1845         .
     1846       end.
     1847       do with frame Dialog-Frame
     1848       :
     1849         hide v-diasize-resize-button .
     1850         v-diasize-resize-button :row = 1.
     1851         v-diasize-resize-button :column = 1.
     1852       end.
     1853       if p-change-value > 0
     1854       then do:
     1855         if frame Dialog-Frame :scrollable = true
     1856         then do:
     1857           assign
     1858             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1859             no-error .
     1860           if error-status :error
     1861           or error-status :get-message(1) <> ""
     1862           then do:
     1863             undo move_block, retry move_block.
     1864           end.
     1865         end.
     1866         assign
     1867           frame Dialog-Frame :width = v-frame-width + p-change-value
     1868           no-error .
     1869         if error-status :error
     1870         or error-status :get-message(1) <> ""
     1871         then do:
     1872           undo move_block, retry move_block.
     1873         end.
     1874         assign
     1875           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1876         no-error .
     1877         if error-status :error
     1878         or error-status :get-message(1) <> ""
     1879         then do:
     1880           undo move_block, retry move_block.
     1881         end.
     1882         for each buf_temp-browse-handle
     1883           where buf_temp-browse-handle.browse-type = 'width':u
     1884         on error undo move_block, retry move_block
     1885         :
     1886           assign
     1887             buf_temp-browse-handle.browse-handle :width
     1888               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1889             no-error .
     1890           if error-status :error
     1891           or error-status :get-message(1) <> ""
     1892           then do:
     1893             undo move_block, retry move_block .
     1894           end.
     1895         end.
     1896         for each buf_temp-diasize-handle
     1897         on error undo move_block, retry move_block
     1898         :
     1899           assign
     1900             v-object-handle = buf_temp-diasize-handle.handle-value
     1901           .
     1902           if v-object-handle <> v-diasize-resize-button
     1903           then do:
     1904             assign
     1905               v-object-handle :col = v-object-handle :col + p-change-value
     1906               no-error .
     1907             if error-status :error
     1908             or error-status :get-message(1) <> ""
     1909             then do:
     1910               undo move_block, retry move_block .
     1911             end.
     1912           end.
     1913         end.
     1914       end.
     1915       else do:
     1916         for each buf_temp-diasize-handle
     1917         on error undo move_block, retry move_block
     1918         :
     1919           assign
     1920             v-object-handle = buf_temp-diasize-handle.handle-value
     1921           .
     1922           if v-object-handle <> v-diasize-resize-button
     1923           then do:
     1924             assign
     1925               v-object-handle :col = v-object-handle :col + p-change-value
     1926               no-error .
     1927             if error-status :error
     1928             or error-status :get-message(1) <> ""
     1929             then do:
     1930               undo move_block, retry move_block .
     1931             end.
     1932           end.
     1933         end.
     1934         for each buf_temp-browse-handle
     1935           where buf_temp-browse-handle.browse-type = 'width':u
     1936         on error undo move_block, retry move_block
     1937         :
     1938           assign
     1939             buf_temp-browse-handle.browse-handle :width
     1940               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1941             no-error .
     1942           if error-status :error
     1943           or error-status :get-message(1) <> ""
     1944           then do:
     1945             undo move_block, retry move_block .
     1946           end.
     1947         end.
     1948         assign
     1949           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1950           no-error .
     1951         if error-status :error
     1952         or error-status :get-message(1) <> ""
     1953         then do:
     1954           undo move_block, retry move_block.
     1955         end.
     1956         assign
     1957           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1958         no-error .
     1959         if error-status :error
     1960         or error-status :get-message(1) <> ""
     1961         then do:
     1962           undo move_block, retry move_block.
     1963         end.
     1964         if frame Dialog-Frame :scrollable = true
     1965         then do:
     1966           assign
     1967             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1968           no-error .
     1969           if error-status :error
     1970           or error-status :get-message(1) <> ""
     1971           then do:
     1972             undo move_block, retry move_block.
     1973           end.
     1974         end.
     1975       end.
     1976       if p-move-resize
     1977       then do:
     1978         run diasize_position-resize-button in this-procedure .
     1979       end.
     1980       if v-diasize-wndstore = true
     1981       then do:
     1982         if connected("ub") = true
     1983         then do:
     1984           define variable v-cntxt-db-num        as integer   no-undo .
     1985           define variable v-cntxt-userid        as character no-undo .
     1986           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1987                                             , OUTPUT v-cntxt-userid
     1988                                             ) .
     1989           run gbl/wndsizew.p
     1990             (input  v-cntxt-db-num
     1991             ,input  v-cntxt-userid
     1992             ,input  v-diasize-proc-name
     1993             ,input  'width':u
     1994             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1995             ) .
     1996         end.
     1997       end.
     1998     end.
     1999     assign
     2000       v-diasize-change-size = false
     2001     .
     2002   end procedure.
     2003   procedure diasize_set-width :
     2004     define input  parameter p-new-width  as decimal   no-undo .
     2005     define input  parameter p-move-resize as logical   no-undo .
     2006     do
     2007     on error undo, return error return-value
     2008     :
     2009       run diasize_change-width in this-procedure
     2010         (input  (p-new-width - frame Dialog-Frame :width)
     2011         ,input  p-move-resize
     2012         ) .
     2013     end.
     2014   end procedure.
     2015   procedure diasize_position-resize-button :
     2016     do with frame Dialog-Frame
     2017     :
     2018       hide v-diasize-resize-button .
     2019       assign
     2020         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2021                     - 1
     2022                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2023         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2024                     - 1
     2025                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2026       .
     2027       view v-diasize-resize-button .
     2028     end.
     2029   end procedure.
     2030   on alt-right anywhere
     2031   do:
     2032     run diasize_change-width in this-procedure
     2033       (input 1
     2034       ,input true
     2035       ) .
     2036     return no-apply .
     2037   end.
     2038   on alt-left anywhere
     2039   do:
     2040     run diasize_change-width in this-procedure
     2041       (input -1
     2042       ,input true
     2043       ) .
     2044     return no-apply .
     2045   end.
     2046   on alt-down anywhere
     2047   do:
     2048     run diasize_change-height in this-procedure
     2049       (input 1
     2050       ,input true
     2051       ) .
     2052     return no-apply .
     2053   end.
     2054   on alt-up anywhere
     2055   do:
     2056     run diasize_change-height in this-procedure
     2057       (input -1
     2058       ,input true
     2059       ) .
     2060     return no-apply .
     2061   end.
     2062   on alt-enter of frame Dialog-Frame
     2063   do:
     2064     run diasize_maximize in this-procedure
     2065       (input  ?
     2066       ).
     2067     return no-apply .
     2068   end.
     2069   procedure diasize_end-move :
     2070     do
     2071     on error undo, return error return-value
     2072     :
     2073       define variable v-row-delta as decimal   no-undo .
     2074       define variable v-col-delta as decimal   no-undo .
     2075       define variable v-new-row as decimal   no-undo .
     2076       define variable v-new-col as decimal   no-undo .
     2077       assign
     2078         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2079         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2080       .
     2081       assign
     2082         v-row-delta = v-new-row - frame Dialog-Frame :height
     2083         v-col-delta = v-new-col - frame Dialog-Frame :width
     2084       .
     2085       run diasize_change-height in this-procedure
     2086         (input v-row-delta
     2087         ,input true
     2088         ) .
     2089       run diasize_change-width in this-procedure
     2090         (input v-col-delta
     2091         ,input true
     2092         ) .
     2093     end.
     2094   end procedure.
     2095   procedure diasize_maximize :
     2096     define input  parameter p-action as logical   no-undo .
     2097     do
     2098     on error undo, return error return-value
     2099     :
     2100       if p-action = ?
     2101       then do:
     2102         if v-diasize-need-maximize = true
     2103         then do:
     2104           assign
     2105             p-action = true
     2106           .
     2107         end.
     2108         else do:
     2109           assign
     2110             p-action = false
     2111           .
     2112         end.
     2113       end.
     2114       if p-action = true
     2115       then do:
     2116         run diasize_change-height in this-procedure
     2117           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2118               - frame Dialog-Frame :height-chars
     2119           ,input true
     2120           ) .
     2121         run diasize_change-width in this-procedure
     2122           (input session :width-chars
     2123               - frame Dialog-Frame :width-chars
     2124           ,input true
     2125           ) .
     2126         assign
     2127           v-diasize-need-maximize = false
     2128         .
     2129       end.
     2130       else do:
     2131         run diasize_change-width in this-procedure
     2132           (input v-diasize-orig-frame-width
     2133               - frame Dialog-Frame :width-chars
     2134           ,input true
     2135           ) .
     2136         run diasize_change-height in this-procedure
     2137           (input v-diasize-orig-frame-height
     2138               - frame Dialog-Frame :height-chars
     2139           ,input true
     2140           ) .
     2141         assign
     2142           v-diasize-need-maximize = true
     2143         .
     2144       end.
     2145     end.
     2146   end procedure.
     2147   procedure diasize_restore-orig-size :
     2148     do
     2149     on error undo, return error return-value
     2150     :
     2151       assign
     2152         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2153         v-diasize-current-frame-height = frame Dialog-Frame :height
     2154       .
     2155       run diasize_set-height in this-procedure
     2156         (input  v-diasize-orig-frame-height
     2157         ,input  true
     2158         ) .
     2159       run diasize_set-width in this-procedure
     2160         (input  v-diasize-orig-frame-width
     2161         ,input  true
     2162         ) .
     2163     end.
     2164   end procedure.
     2165   procedure diasize_restore-current-size :
     2166     do
     2167     on error undo, return error return-value
     2168     :
     2169       run diasize_set-height in this-procedure
     2170         (input  v-diasize-current-frame-height
     2171         ,input  true
     2172         ) .
     2173       run diasize_set-width in this-procedure
     2174         (input  v-diasize-current-frame-width
     2175         ,input  true
     2176         ) .
     2177     end.
     2178   end procedure.
     2179   procedure diasize_set-browse-handle :
     2180     define input  parameter p-browse-handle as handle   no-undo .
     2181     define buffer buf_temp-browse-handle for temp-browse-handle .
     2182     do
     2183     on error undo, return error return-value
     2184     :
     2185       assign
     2186         v-diasize-browse-handle = p-browse-handle
     2187       .
     2188       for each buf_temp-browse-handle
     2189       on error undo, return error return-value
     2190       :
     2191         delete buf_temp-browse-handle .
     2192       end.
     2193     end.
     2194   end procedure.
     2195   procedure diasize_add_browse :
     2196     define input  parameter p-browse-type   as character no-undo .
     2197     define input  parameter p-browse-handle as handle    no-undo .
     2198     define buffer buf_temp-browse-handle for temp-browse-handle .
     2199     do
     2200     on error undo, return error return-value
     2201     :
     2202       assign
     2203         v-diasize-browse-number = v-diasize-browse-number + 1
     2204       .
     2205       create buf_temp-browse-handle .
     2206       assign
     2207         buf_temp-browse-handle.browse-type   = p-browse-type
     2208         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2209         buf_temp-browse-handle.browse-handle = p-browse-handle
     2210       .
     2211     end.
     2212   end procedure.
     2213   procedure diasize_init :
     2214     define variable v-default-value    as logical   no-undo .
     2215     define variable v-restore-saved    as logical   no-undo .
     2216     define variable v-resize-value-str as character no-undo .
     2217     do
     2218     on error undo, return error return-value
     2219     :
     2220       do with frame Dialog-Frame
     2221       :
     2222         assign
     2223           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2224           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2225           v-diasize-browse-handle     = browse br-c-point-io :handle
     2226         .
     2227         create button v-diasize-resize-button
     2228         assign
     2229           parent        = frame Dialog-Frame :first-child
     2230           label         = "s"
     2231           height-pixels = 16
     2232           width-pixels  = 16
     2233           visible       = true
     2234           sensitive     = true
     2235           movable       = true
     2236           triggers:
     2237             on end-move persistent run diasize_end-move in this-procedure .
     2238           end triggers.
     2239         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2240         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2241         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2242         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2243         assign
     2244           v-diasize-wndmax = false
     2245         .
     2246         if connected("ub") = true
     2247         then do:
     2248           define variable v-cntxt-db-num        as integer   no-undo .
     2249           define variable v-cntxt-userid        as character no-undo .
     2250           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2251                                             , OUTPUT v-cntxt-userid
     2252                                             ) .
     2253           run gbl/wndpar_r.p
     2254             (input  v-cntxt-db-num
     2255             ,input  v-cntxt-userid
     2256             ,input  'wndmax':U
     2257             ,output v-diasize-wndmax
     2258             ,output v-default-value
     2259             ) .
     2260         end.
     2261         assign
     2262           v-diasize-wndstore = false
     2263         .
     2264         if connected("ub") = true
     2265         then do:
     2266           run gbl/wndpar_r.p
     2267             (input  v-cntxt-db-num
     2268             ,input  v-cntxt-userid
     2269             ,input  'wndstore':U
     2270             ,output v-diasize-wndstore
     2271             ,output v-default-value
     2272             ) .
     2273         end.
     2274         assign
     2275           v-diasize-proc-name = entry(1, program-name(2), '.')
     2276         .
     2277         if v-diasize-wndstore = true
     2278         then do:
     2279           assign
     2280             v-restore-saved = false
     2281           .
     2282           if connected("ub") = true
     2283           then do:
     2284             run gbl/wndsizer.p
     2285               (input  v-cntxt-db-num
     2286               ,input  v-cntxt-userid
     2287               ,input  v-diasize-proc-name
     2288               ,input  'height':u
     2289               ,output v-resize-value-str
     2290               ) .
     2291             if v-resize-value-str <> '':U
     2292             then do:
     2293               run diasize_change-height in this-procedure
     2294                 (input  integer(v-resize-value-str)
     2295                 ,input  true
     2296                 ) .
     2297               assign
     2298                 v-restore-saved = true
     2299               .
     2300             end.
     2301           end.
     2302           if connected("ub") = true
     2303           then do:
     2304             run gbl/wndsizer.p
     2305               (input  v-cntxt-db-num
     2306               ,input  v-cntxt-userid
     2307               ,input  v-diasize-proc-name
     2308               ,input  'width':u
     2309               ,output v-resize-value-str
     2310               ) .
     2311             if v-resize-value-str <> '':U
     2312             then do:
     2313               run diasize_change-width in this-procedure
     2314                 (input  integer(v-resize-value-str)
     2315                 ,input  true
     2316                 ) .
     2317               assign
     2318                 v-restore-saved = true
     2319               .
     2320             end.
     2321           end.
     2322           if v-restore-saved <> true
     2323           then do:
     2324             if v-diasize-wndmax = true
     2325             then do:
     2326               run diasize_maximize in this-procedure
     2327                 (input  true
     2328                 ) .
     2329             end.
     2330           end.
     2331         end.
     2332         else do:
     2333           if v-diasize-wndmax = true
     2334           then do:
     2335             run diasize_maximize in this-procedure
     2336               (input  true
     2337               ) .
     2338           end.
     2339         end.
     2340       end.
     2341     end.
     2342   end procedure.
     2343   procedure diasize_need-full-display :
     2344     define output parameter p-need-full-display as logical   no-undo .
     2345     do
     2346     on error undo, return error return-value
     2347     :
     2348       assign
     2349         p-need-full-display = v-diasize-need-full-display
     2350       .
     2351       assign
     2352         v-diasize-need-full-display = false
     2353       .
     2354     end.
     2355   end procedure.
     2356   procedure get-context :
     2357      define output parameter p-db-num as integer          no-undo.
     2358      define output parameter p-user-id as character        no-undo.
     2359      define variable v-login               as character    no-undo.
     2360      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2361      define buffer buf_user-login  for ub.user-login .
     2362      do
     2363      on error undo, return error
     2364      :
     2365            FIND FIRST buf_sys-ctrl no-lock.
     2366            ASSIGN
     2367               v-login = USERID("ub")
     2368               p-db-num = buf_sys-ctrl.db-num
     2369            .
     2370            FIND FIRST buf_user-login
     2371                 WHERE buf_user-login.db-num = p-db-num
     2372                   AND buf_user-login.user-login = v-login
     2373                 no-lock
     2374                 no-error
     2375                 .
     2376            IF AVAILABLE buf_user-login
     2377            THEN DO:
     2378               assign
     2379                  p-user-id = buf_user-login.user-id
     2380               .
     2381            END.
     2382      end.
     2383   end procedure.
     2384       run diasize_init in this-procedure .
     2385   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2386   procedure set-filter-name :
     2387   define input parameter p-filter-name as character no-undo .
     2388     do with frame Dialog-Frame:
     2389       if p-filter-name > "" then do:
     2390         assign
     2391           frame Dialog-Frame:title
     2392             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2393         .
     2394         assign
     2395           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2396         .
     2397       end.
     2398       else do:
     2399         assign
     2400           b-sch :tooltip = ""
     2401         .
     2402       end.
     2403     end.
     2404   end procedure.
     2405   def var sort-labelbr-c-point-io   as character no-undo .
     2406   def var sort-clmnbr-c-point-io    as handle    no-undo .
     2407   def var cur-clmnbr-c-point-io     as handle    no-undo .
     2408   def var cur-clmn-locbr-c-point-io as integer   no-undo .
     2409   def var re-querybr-c-point-io     as logical   initial no no-undo .
     2410   on start-search, ctrl-o of br-c-point-io in frame Dialog-Frame do:
     2411      run sort-brbr-c-point-io
     2412        (input (if available X_c-point-io
     2413                then recid(X_c-point-io)
     2414                else ?
     2415               )
     2416        ).
     2417   end.
     2418   PROCEDURE sort-brbr-c-point-io :
     2419     define input parameter p-recid as recid no-undo .
     2420     if re-querybr-c-point-io = no then do:
     2421       assign
     2422          cur-clmnbr-c-point-io = br-c-point-io:current-column in frame Dialog-Frame
     2423       .
     2424       if sort-clmnbr-c-point-io <> ? then sort-clmnbr-c-point-io:column-fgcolor = 0.
     2425       if cur-clmnbr-c-point-io = sort-clmnbr-c-point-io then do:
     2426         assign
     2427            sort-labelbr-c-point-io = ""
     2428            sort-clmnbr-c-point-io = ?
     2429         .
     2430        end.
     2431        else do:
     2432          assign
     2433            sort-labelbr-c-point-io = cur-clmnbr-c-point-io:label
     2434            sort-clmnbr-c-point-io  = cur-clmnbr-c-point-io
     2435            sort-clmnbr-c-point-io:column-fgcolor = 4
     2436          .
     2437        end.
     2438      end.
     2439     assign
     2440       cur-clmn-locbr-c-point-io = 1
     2441     .
     2442     def var column-handle as handle no-undo .
     2443     column-handle = br-c-point-io:first-column.
     2444     do while valid-handle(column-handle) :
     2445       if column-handle = cur-clmnbr-c-point-io then do:
     2446         leave .
     2447       end.
     2448       column-handle = column-handle:NEXT-COLUMN.
     2449       assign
     2450         cur-clmn-locbr-c-point-io = cur-clmn-locbr-c-point-io + 1
     2451       .
     2452     end.
     2453     case sort-labelbr-c-point-io:
     2454           when X_c-point-io.point-code:label in browse br-c-point-io then DO:    assign       sort-column-name = "X_c-point-io.point-code"     .     run OpenBr in this-procedure (input yes, input no, input no).   . END.
     2455       otherwise do:
     2456         assign
     2457           sort-column-name = ""
     2458         .
     2459         run OpenBr in this-procedure (input yes, input no, input no).
     2460         if sort-labelbr-c-point-io <> "" then do:
     2461           assign
     2462             cur-clmnbr-c-point-io:column-fgcolor = 0
     2463           .
     2464         end.
     2465         assign
     2466           cur-clmn-locbr-c-point-io = ?
     2467         .
     2468       end.
     2469     end case.
     2470     if p-recid <> ? then do:
     2471       reposition br-c-point-io to recid p-recid no-error.
     2472       apply "value-changed" to br-c-point-io in frame Dialog-Frame.
     2473     end.
     2474     apply "entry" to br-c-point-io in frame Dialog-Frame.
     2475   END PROCEDURE.
     2476   procedure re-open-query-srt-clmnbr-c-point-io:
     2477   if cur-clmnbr-c-point-io = ? then do:
     2478      run OpenBr in this-procedure (input yes, input no, input no).
     2479   end.
     2480   else do:
     2481      assign re-querybr-c-point-io = yes.
     2482      run sort-brbr-c-point-io
     2483        (input (if available X_c-point-io
     2484                then recid(X_c-point-io)
     2485                else ?
     2486               )
     2487        ).
     2488      assign re-querybr-c-point-io = no.
     2489   end.
     2490   end.
     2491   MAIN-BLOCK:
     2492   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2493      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2494     find first X_point-io no-lock where
     2495               X_point-io.point-code = p-point-code
     2496           and X_point-io.db-num = p-db-num no-error .
     2497     if not available X_point-io then do:
     2498       message
     2499       vss-workfile vss-revision vss-description skip
     2500       "Неверное значение параметра вызова "
     2501       view-as alert-box ERROR.
     2502       return.
     2503     end.
     2504     assign
     2505     br-c-point-io:num-locked-columns = 1
     2506     X_c-point-io.point-code:read-only in browse br-c-point-io = yes
     2507     .
     2508     RUN MyEnable in this-procedure .
     2509     RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     2510     HIDE mark-num in frame Dialog-Frame .
     2511     if p-rid-list <> "":U then assign v-doc-rec = integer(entry(1, p-rid-list)) .
     2512     WAIT-FOR GO OF FRAME Dialog-Frame.
     2513   END.
     2514   RUN disable_UI.
     2515   PROCEDURE disable_UI :
     2516     HIDE FRAME Dialog-Frame.
     2517   END PROCEDURE.
     2518   PROCEDURE MyEnable :
     2519   DISPLAY
     2520   mark-num
     2521   WITH FRAME Dialog-Frame .
     2522   ENABLE
     2523   b-quit
     2524   b-sel  when  lookup( "b-sel", bttns ) > 0
     2525   B-mark when lookup( "b-mark", bttns) > 0
     2526   B-sch
     2527   B-Help
     2528   mark-num
     2529   br-c-point-io
     2530   BR-changes
     2531   WITH FRAME Dialog-Frame .
     2532   VIEW FRAME Dialog-Frame.
     2533   END PROCEDURE.
     2534   PROCEDURE OpenBr :
     2535   define input  parameter p-open-query     as logical   no-undo .
     2536   define input  parameter p-find-next      as logical   no-undo .
     2537   define input  parameter p-find-condition as character no-undo .
     2538   def var l-query-was-opened as logical no-undo .
     2539   def var sort-column-phrase as character no-undo .
     2540   case sort-column-name :
     2541     when "" then assign sort-column-phrase = ""  .
     2542     otherwise    assign sort-column-phrase = "by " + sort-column-name  .
     2543   end case.
     2544   define variable l-open-query as logical   no-undo .
     2545   filter-point = filter-point0 .
     2546   ASSIGN frame Dialog-Frame:TITLE = title0 .
     2547   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2548   define variable  l-disable-where-13  as logical   no-undo .
     2549   define variable  l-filter-open-13    as logical   .
     2550   define variable  flt-rec-13       as recid     no-undo .
     2551   define variable  filter-name-13      as character no-undo .
     2552   define variable  where-phrase-13     as character no-undo .
     2553   define variable  sort-phrase-13      as character no-undo .
     2554   define variable  where-phrase-rus-13 as character no-undo .
     2555   define variable  sort-phrase-rus-13  as character no-undo .
     2556     run waitfram-show in this-procedure
     2557       (input "ЖДИТЕ ..."
     2558       ).
     2559   run gbl/flt-get.p
     2560     (input filter-point
     2561     ,output flt-rec-13
     2562     ,output filter-name-13
     2563     ,output where-phrase-13
     2564     ,output sort-phrase-13
     2565     ,output where-phrase-rus-13
     2566     ,output sort-phrase-rus-13
     2567     ).
     2568   if p-open-query then do:
     2569       run set-filter-name in this-procedure
     2570         (INPUT filter-name-13
     2571         ) no-error .
     2572     assign
     2573       l-filter-open-13 = false
     2574     .
     2575     if flt-rec-13 <> ?
     2576       or sort-column-phrase > ""
     2577     then do:
     2578       define variable  parameter-2-13 as character no-undo .
     2579       define variable  parameter-3-13 as character no-undo .
     2580       define variable  parameter-4-13 as character no-undo .
     2581       define variable  parameter-5-13 as character no-undo .
     2582       define variable  parameter-6-13 as character no-undo .
     2583       define variable  parameter-7-13 as character no-undo .
     2584         assign
     2585         parameter-3-13 =
     2586                                 "FOR EACH X_c-point-io"
     2587         parameter-4-13 =
     2588           (
     2589             if (" X_c-point-io.db-num = p-db-num AND X_c-point-io.point-code  = p-point-code " + " " + where-phrase-13) <> ""
     2590             then  substitute(' X_c-point-io.db-num = &1 AND X_c-point-io.point-code  = &2 ', p-db-num, p-point-code)  + " " + where-phrase-13
     2591             else "true"
     2592           )
     2593         parameter-5-13 = (" " + "" + " " + "")
     2594         parameter-6-13 = if sort-phrase-13 = ''
     2595                              then
     2596           (
     2597           " " + "  " +
     2598             " " + sort-column-phrase +
     2599           " " + "  "
     2600           )
     2601                              else
     2602           (
     2603           " " + "  " +
     2604             " " + sort-column-phrase +
     2605           " " + sort-phrase-13
     2606           )
     2607         parameter-7-13 =
     2608           " indexed-reposition  "
     2609       .
     2610       do
     2611       on stop undo, leave
     2612       on error undo, leave
     2613       :
     2614         assign
     2615           l-disable-where-13 =
     2616             (" X_c-point-io.db-num = p-db-num AND X_c-point-io.point-code  = p-point-code " + " " + where-phrase-13 = "")
     2617         .
     2618         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2619                             ,input query br-c-point-io:handle
     2620                             ,input parameter-3-13
     2621                             ,input parameter-4-13
     2622                             ,input parameter-5-13
     2623                             ,input parameter-6-13
     2624                             ,input parameter-7-13
     2625                             )
     2626         .
     2627         assign
     2628           l-filter-open-13 = true
     2629         .
     2630       end.
     2631       if l-filter-open-13 = false then do:
     2632         message
     2633           "Ошибка при фильтрации / сортировке" skip
     2634           "Будут показаны записи без учета фильтра" skip
     2635           view-as alert-box .
     2636       end.
     2637       else do:
     2638           assign
     2639             l-query-was-opened = true
     2640           .
     2641       end.
     2642     end.
     2643     if l-filter-open-13 = false then do:
     2644       OPEN QUERY br-c-point-io FOR EACH X_c-point-io
     2645         where  X_c-point-io.db-num = p-db-num AND X_c-point-io.point-code  = p-point-code
     2646         indexed-reposition
     2647     .
     2648         assign
     2649           l-query-was-opened = true
     2650         .
     2651     end.
     2652   end.
     2653   else do:
     2654     assign
     2655       v-doc-rec = recid( X_c-point-io )
     2656     .
     2657     do
     2658     on stop undo, leave
     2659     on error undo, leave
     2660     :
     2661       if query br-c-point-io:handle:get-buffer-handle(1) = (buffer X_c-point-io:handle) then do:
     2662         assign
     2663         parameter-2-13 = (if p-find-next then "true":u else "false":u )
     2664         parameter-4-13 =
     2665           "where ":u +  substitute(' X_c-point-io.db-num = &1 AND X_c-point-io.point-code  = &2 ', p-db-num, p-point-code)  + " ":u + where-phrase-13 + " ":u + p-find-condition + " " + ""
     2666         parameter-5-13 = "  "
     2667       .
     2668         run fltopend_fltfindd in this-procedure  (
     2669                             input this-procedure:handle
     2670                             ,input query br-c-point-io:handle
     2671                             ,input rowid(X_c-point-io)
     2672                             ,input logical(parameter-2-13)
     2673                             ,input no-lock
     2674                             ,input (buffer X_c-point-io:handle)
     2675                             ,input parameter-4-13
     2676                             ,input parameter-5-13
     2677                             ) no-error.
     2678         .
     2679         assign
     2680           v-doc-rec = integer(return-value)
     2681           v-fltopend-rowid[1] = ?
     2682         .
     2683       end.
     2684       else do:
     2685         assign
     2686         parameter-2-13 = (if p-find-next then "true":u else "false":u )
     2687         parameter-3-13 =  "FOR EACH X_c-point-io"
     2688         parameter-4-13 =
     2689           (
     2690             if (" X_c-point-io.db-num = p-db-num AND X_c-point-io.point-code  = p-point-code " + " " + where-phrase-13) <> ""
     2691             then  substitute(' X_c-point-io.db-num = &1 AND X_c-point-io.point-code  = &2 ', p-db-num, p-point-code)  + " " + where-phrase-13
     2692             else "true"
     2693           )
     2694         parameter-5-13 = (" " + "" + " " + "" + " " + p-find-condition)
     2695         parameter-6-13 = if sort-phrase-13 = ''
     2696                              then
     2697           (
     2698           " " + "  " +
     2699             " " + sort-column-phrase +
     2700           " " + "  "
     2701           )
     2702                              else
     2703           (
     2704           " " + "  " +
     2705             " " + sort-column-phrase +
     2706           " " + sort-phrase-13
     2707           )
     2708         parameter-7-13 =
     2709           " indexed-reposition  "
     2710       .
     2711         run fltopend_fltfindq in this-procedure  (
     2712                             input this-procedure:handle
     2713                             ,input query br-c-point-io:handle
     2714                             ,input logical(parameter-2-13)
     2715                             ,input no-lock
     2716                             ,input parameter-3-13
     2717                             ,input parameter-4-13
     2718                             ,input parameter-5-13
     2719                             ,input parameter-6-13
     2720                             ,input parameter-7-13
     2721                             ,output v-fltopend-rowid
     2722                             ) no-error.
     2723         .
     2724         v-doc-rec = ?.
     2725       end.
     2726       assign
     2727         l-query-was-opened = true
     2728       .
     2729     end.
     2730   end.
     2731     run waitfram-hide in this-procedure .
     2732   REPOSITION br-c-point-io to recid v-doc-rec No-ERROR.
     2733   if error-status:error then REPOSITION br-c-point-io to row 1 No-ERROR.
     2734   else  REPOSITION br-c-point-io to row 7 No-ERROR.
     2735   run proc-view-changes in this-procedure no-error.
     2736   END PROCEDURE.
     2737   PROCEDURE proc-view-changes :
     2738   define buffer new_c-point-io for ub.c-point-io.
     2739   define buffer current_point-io for ub.point-io.
     2740   define variable v-chg-fields as character no-undo.
     2741   define variable v-old-fields as character no-undo.
     2742   define variable v-new-fields as character no-undo.
     2743   define variable ii as integer no-undo.
     2744   for each temp-changes:
     2745       delete temp-changes.
     2746   END.
     2747   if not available X_c-point-io then do:
     2748     Open QUery br-changes for each temp-changes.
     2749     return.
     2750   end.
     2751   define variable v-label-param as character no-undo .
     2752   v-label-param =
     2753     "db-num" + chr(4) + "БД" + chr(4) + "" + chr(8)
     2754    + "cli-type" + chr(4) + "Тип контрагента" + chr(4) + "" + chr(8)
     2755    + "cli-code" + chr(4) + "Код контрагента" + chr(4) + "" + chr(8)
     2756    + "point-code" + chr(4) + "Номер" + chr(4) + "" + chr(8)
     2757    + "point-name" + chr(4) + "Наименование" + chr(4) + "" + chr(8)
     2758    + "point-type" + chr(4) + "Тип" + chr(4) + "" + chr(8)
     2759    + "ps" + chr(4) + "Примечание" + chr(4) + "" + chr(8)
     2760    + "is-default" + chr(4) + "По умолчанию" + chr(4) + "" + chr(8)
     2761    + "address" + chr(4) + "Адрес" + chr(4) + "" + chr(8)
     2762    + "dist" + chr(4) + "Километраж" + chr(4) + "" + chr(8)
     2763    + "deliv-subj-code" + chr(4) + "Код субъекта доставки" + chr(4) + "" + chr(8)
     2764    + "status_" + chr(4) + "Статус" + chr(4) + ""  .
     2765    run proc-full-temp-changes in this-procedure (
     2766                                                input  buffer X_c-point-io:handle
     2767                                               ,input  'point-io':U
     2768                                               ,input  "db-num,cli-type,cli-code,point-code,point-name,point-type,ps,is-defailt,address,dist,deliv-subj-code,status_"
     2769                                               ,input  v-label-param).
     2770   Open QUery br-changes for each temp-changes.
     2771   END PROCEDURE.
     2772   FUNCTION mark-string RETURNS CHARACTER
     2773     ( input par-recid as recid, input mark-list as character) :
     2774   RETURN ( IF LOOKUP( STRING( par-recid ), mark-list ) > 0 THEN "*" ELSE "":U ).
     2775   END FUNCTION.
