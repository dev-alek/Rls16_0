        1   define input  parameter iMode as character  no-undo.
        2   define input  parameter inode-code as integer no-undo.
        3   define new global shared variable g#language as character no-undo .
        4   if g#language <> '' and g#language <> 'rus':U then do:
        5     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
        6   end.
        7   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
        8        LABEL "Выход"
        9        SIZE 15 BY 1.13.
       10   DEFINE BUTTON Btn_OK AUTO-GO
       11        LABEL "Ввод"
       12        SIZE 15 BY 1.13.
