      121             SIZE 17 BY .81
      122        sr-izmerenia.sr-type-id AT ROW 21.95 COL 40.6 COLON-ALIGNED WIDGET-ID 108
      123             VIEW-AS COMBO-BOX INNER-LINES 5
      124             LIST-ITEM-PAIRS "Ареометр, отградуирован при 15°С",1,
      125                        "Ареометр, отградуирован при 20°С",2,
      126                        "Поточный плотномер",3,
      127                        "Погружной плотномер",4,
      128                        "Канал измерения плотности (с поточным плотномером)",5,
      129                        "Канал измерения плотности (без поточного плотномера)",6
      130             DROP-DOWN-LIST
      131             SIZE 56 BY 1
      132        sr-izmerenia.sr-abs-err-dens AT ROW 23.43 COL 60.6 COLON-ALIGNED WIDGET-ID 76
      133             VIEW-AS FILL-IN
      134             SIZE 26 BY 1
      135        sr-izmerenia.sr-relative-err-dens AT ROW 24.62 COL 60.6 COLON-ALIGNED WIDGET-ID 98
      136             VIEW-AS FILL-IN
      137             SIZE 26 BY 1
      138       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      139            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE  WIDGET-ID 100.
      140   DEFINE FRAME Dialog-Frame
      141        sr-izmerenia.sr-abs-err-dens-lgas-liquid AT ROW 25.76 COL 60.6 COLON-ALIGNED WIDGET-ID 78
      142             VIEW-AS FILL-IN
      143             SIZE 26 BY 1
      144        sr-izmerenia.sr-abs-err-dens-lgas-vapor AT ROW 26.95 COL 60.6 COLON-ALIGNED WIDGET-ID 80
      145             VIEW-AS FILL-IN
      146             SIZE 26 BY 1
      147        sr-izmerenia.sr-relative-err-dens-lgas-liquid AT ROW 28.19 COL 60.6 COLON-ALIGNED WIDGET-ID 118
      148             VIEW-AS FILL-IN
      149             SIZE 26 BY 1
      150        sr-izmerenia.sr-Weight AT ROW 30.19 COL 4.6 WIDGET-ID 114
      151             VIEW-AS TOGGLE-BOX
      152             SIZE 13.4 BY .81
      153        sr-izmerenia.sr-otnos AT ROW 31.33 COL 61.6 COLON-ALIGNED WIDGET-ID 96
      154             VIEW-AS FILL-IN
      155             SIZE 25 BY 1
      156        temp-line-text AT ROW 9.29 COL 93 COLON-ALIGNED NO-LABEL
      157        abs-err-neft-water-text AT ROW 10.52 COL 93 COLON-ALIGNED NO-LABEL
      158        relative-err-neft-water-text AT ROW 11.62 COL 93 COLON-ALIGNED NO-LABEL
      159        abs-err-water-text AT ROW 12.86 COL 93 COLON-ALIGNED NO-LABEL
      160        relative-err-water-text AT ROW 14.05 COL 93 COLON-ALIGNED NO-LABEL
      161        abs-err-temp-vol-text AT ROW 17.33 COL 93 COLON-ALIGNED NO-LABEL
      162        abs-err-temp-dens-text AT ROW 18.57 COL 93 COLON-ALIGNED NO-LABEL
      163        abs-err-dens-text AT ROW 23.62 COL 93 COLON-ALIGNED NO-LABEL
      164        relative-err-dens-text AT ROW 24.81 COL 93 COLON-ALIGNED NO-LABEL
      165        abs-err-dens-lgas-liquid-text AT ROW 25.91 COL 93 COLON-ALIGNED NO-LABEL
      166        abs-err-dens-lgas-vapor-text AT ROW 27.1 COL 93 COLON-ALIGNED NO-LABEL
      167        relative-err-dens-lgas-liquid-t AT ROW 28.38 COL 93 COLON-ALIGNED NO-LABEL WIDGET-ID 120
      168        otnos-text AT ROW 31.48 COL 93 COLON-ALIGNED NO-LABEL
      169        RECT-1 AT ROW 6.24 COL 2.6 WIDGET-ID 68
      170        RECT-2 AT ROW 15.52 COL 2.6 WIDGET-ID 70
      171        RECT-3 AT ROW 20.76 COL 2.6 WIDGET-ID 72
      172        RECT-4 AT ROW 29.91 COL 2.6 WIDGET-ID 74
      173        SPACE(2.00) SKIP(0.36)
      174       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      175            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      176            TITLE "Средства измерения" WIDGET-ID 100.
      177   ASSIGN
      178          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      179          FRAME Dialog-Frame:HIDDEN           = TRUE.
      180   ASSIGN
      181          sr-izmerenia.node-code:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      182   ON window-close OF FRAME Dialog-Frame
      183   do:
      184     apply "END-ERROR":U to self.
      185   end.
      186   ON choose OF Btn_OK IN FRAME Dialog-Frame
      187   do:
      188     def var vMess as char no-undo.
      189     run check-sr-type-id no-error.
      190     if error-status:error
      191     then return no-apply .
      192     run check-neft-water no-error.
      193     if error-status:error
      194     then return no-apply .
      195     run check-err-water no-error.
      196     if error-status:error
      197     then return no-apply .
      198     run Check-err-dens no-error.
      199     if error-status:error
      200     then return no-apply .
      201     run check-sr-otnos no-error.
      202     if error-status:error
      203     then return no-apply .
      204     run Check-sr-abs-err-temp-vol no-error.
      205     if error-status:error then
      206        return no-apply.
      207     run Check-sr-abs-err-temp-dens no-error.
      208     if error-status:error then
      209        return no-apply.
      210     assign
      211        sr-izmerenia.sr-not-used
      212        sr-izmerenia.sr-model
      213        sr-izmerenia.sr-type-izm
      214        sr-izmerenia.sr-level
      215        sr-izmerenia.sr-type-level-measuring
      216        sr-izmerenia.sr-temp-line
      217        sr-izmerenia.sr-abs-err-neft-water
      218        sr-izmerenia.sr-relative-err-neft-water
      219        sr-izmerenia.sr-abs-err-water
      220        sr-izmerenia.sr-relative-err-water
      221        sr-izmerenia.sr-temperature
      222        sr-izmerenia.sr-abs-err-temp-vol
      223        sr-izmerenia.sr-abs-err-temp-dens
      224        sr-izmerenia.sr-density
      225        sr-izmerenia.sr-abs-err-dens
      226        sr-izmerenia.sr-relative-err-dens
      227        sr-izmerenia.sr-abs-err-dens-lgas-liquid
      228        sr-izmerenia.sr-abs-err-dens-lgas-vapor
      229        sr-izmerenia.sr-relative-err-dens-lgas-liquid
      230        sr-izmerenia.sr-Weight
      231        sr-izmerenia.sr-otnos
      232     .
      233     if not(    sr-izmerenia.sr-level
      234             or sr-izmerenia.sr-density
      235             or sr-izmerenia.sr-temperature
      236             or sr-izmerenia.sr-Weight)
      237     then do:
      238        message "Не выбран ни уровень, ни температура, ни плотность, ни масса"
      239           view-as alert-box.
      240        return no-apply.
      241     end.
      242     vMess = "".
      243     if       sr-izmerenia.sr-level
      244        and   sr-izmerenia.sr-temp-line               = ?
      245        and   sr-izmerenia.sr-relative-err-neft-water = ?
      246        and   sr-izmerenia.sr-relative-err-water      = ?
      247     then
      248        vMess = "Не указаны характеристики средства измерения уровня" .
      249     if     sr-izmerenia.sr-temperature
      250        and sr-izmerenia.sr-abs-err-temp-vol  = ?
      251        and sr-izmerenia.sr-abs-err-temp-dens = ?
      252     then
      253        vMess = vMess
      254              + (if vMess eq "" then "" else chr(10) )
      255              + "Не указаны характеристики средства измерения температуры.".
      256      if    sr-izmerenia.sr-density
      257        and sr-izmerenia.sr-abs-err-dens             = ?
      258        and sr-izmerenia.sr-relative-err-dens        = ?
      259        and sr-izmerenia.sr-abs-err-dens-lgas-liquid = ?
      260        and sr-izmerenia.sr-abs-err-dens-lgas-vapor  = ?
      261        and sr-izmerenia.sr-relative-err-dens-lgas-liquid = ?
      262      then
      263         vMess = vMess
      264               + (if vMess eq "" then "" else chr(10))
      265               + "Не указаны характеристики средства измерения плотности.".
      266     if vMess ne ""
      267     then do:
      268        define variable vOk as logical no-undo.
      269         message vMess skip
      270           "Вы уверены, что хотите закончить настройку средства измерения?"
      271         view-as alert-box question buttons OK-Cancel update vOk.
      272        if not vOk
      273        then
      274           return no-apply.
      275     end.
      276     define variable v-msg2  as character no-undo .
      277     define variable v-delta as decimal decimals 2 no-undo .
      278     define variable v-delta-min as decimal decimals 2 no-undo .
      279     if sr-izmerenia.sr-model > "" then .
      280     else do:
      281       message "Пожалуйста заполните наименование модели средства измерения"
      282       view-as alert-box.
      283       apply "entry" to sr-izmerenia.sr-model in frame Dialog-Frame .
      284       return no-apply .
      285     end .
      286     assign
      287       v-msg2 = "выходит за границы допустимого диапазона"
      288       v-delta-min = 0
      289     .
      290     if sr-izmerenia.sr-level then
      291     do:
      292         case sr-izmerenia.sr-type-izm:
      293            when 2 then assign v-delta-min = 0 v-delta = 3.
      294            when 0 then assign v-delta-min = 0 v-delta = 3.
      295            when 1 then assign v-delta-min = 0 v-delta = ?.
      296         end case.
      297         if abs(sr-izmerenia.sr-abs-err-neft-water) < v-delta-min or
      298            sr-izmerenia.sr-abs-err-neft-water > v-delta or sr-izmerenia.sr-abs-err-neft-water < (-1) * v-delta then do :
      299           message substitute("&1 &2&3(+/-)&4...&5 мм",
      300                        sr-izmerenia.sr-abs-err-neft-water:label in frame Dialog-Frame, v-msg2, chr(10),
      301                        if v-delta-min < 1 then right-trim(string(v-delta-min,"9.99"),"0") else string(v-delta-min),
      302                        string(v-delta, "9") )
      303           view-as alert-box.
      304           apply "entry" to sr-izmerenia.sr-abs-err-neft-water in frame Dialog-Frame .
      305           return no-apply .
      306         end.
      307         v-delta-min = 0.
      308         if sr-izmerenia.sr-abs-err-water > v-delta or sr-izmerenia.sr-abs-err-water < (-1) * v-delta then do :
      309           message substitute("&1 &2&3(+/-)&4 мм",
      310                        sr-izmerenia.sr-abs-err-water:label in frame Dialog-Frame, v-msg2, chr(10), string(v-delta, "9") )
      311           view-as alert-box.
      312           apply "entry" to sr-izmerenia.sr-abs-err-water in frame Dialog-Frame .
      313           return no-apply .
      314         end.
      315     end.
      316     if sr-izmerenia.sr-temperature then
      317     do:
      318         case sr-izmerenia.sr-type-izm:
      319            when 2 then v-delta = 0.5.
      320            when 0 then v-delta = 0.5.
      321            when 1 then v-delta = 0.2.
      322         end case.
      323         if sr-izmerenia.sr-abs-err-temp-vol > v-delta or sr-izmerenia.sr-abs-err-temp-vol < (-1) * v-delta then do :
      324           message substitute("&1 &2&3(+/-)&4 °С",
      325                        sr-izmerenia.sr-abs-err-temp-vol:label in frame Dialog-Frame, v-msg2, chr(10), string(v-delta, "9.9") )
      326           view-as alert-box.
      327           apply "entry" to sr-izmerenia.sr-abs-err-temp-vol in frame Dialog-Frame .
      328           return no-apply .
      329         end.
      330         if sr-izmerenia.sr-abs-err-temp-dens > v-delta or sr-izmerenia.sr-abs-err-temp-dens < (-1) * v-delta then do :
      331           message substitute("&1 &2&3(+/-)&4 °С",
      332                        sr-izmerenia.sr-abs-err-temp-dens:label in frame Dialog-Frame, v-msg2, chr(10), string(v-delta, "9.9") )
      333           view-as alert-box.
      334           apply "entry" to sr-izmerenia.sr-abs-err-temp-dens in frame Dialog-Frame .
      335           return no-apply .
      336         end.
      337     end.
      338     if sr-izmerenia.sr-density then
      339     do:
      340         case sr-izmerenia.sr-type-izm:
      341            when 2 then v-delta = 1.
      342            when 0 then v-delta = 0.5.
      343            when 1 then v-delta = 0.5.
      344         end case.
      345         if sr-izmerenia.sr-abs-err-dens > v-delta or sr-izmerenia.sr-abs-err-dens < (-1) * v-delta then do :
      346           message substitute("&1 &2&3(+/-)&4 кг/м3",
      347                        sr-izmerenia.sr-abs-err-dens:label in frame Dialog-Frame, v-msg2, chr(10), string(v-delta, "9.9") )
      348           view-as alert-box.
      349           apply "entry" to sr-izmerenia.sr-abs-err-dens in frame Dialog-Frame .
      350           return no-apply .
      351         end.
      352         v-delta = 1.5 .
      353         if sr-izmerenia.sr-abs-err-dens-lgas-liquid > v-delta or sr-izmerenia.sr-abs-err-dens-lgas-liquid < (-1) * v-delta then do :
      354           message substitute("&1 &2&3(+/-)&4 %",
      355                        sr-izmerenia.sr-abs-err-dens-lgas-liquid:label in frame Dialog-Frame, v-msg2, chr(10), string(v-delta, "9.99") )
      356           view-as alert-box.
      357           apply "entry" to sr-izmerenia.sr-abs-err-dens-lgas-liquid in frame Dialog-Frame .
      358           return no-apply .
      359         end.
      360         if sr-izmerenia.sr-abs-err-dens-lgas-vapor > v-delta or sr-izmerenia.sr-abs-err-dens-lgas-vapor < (-1) * v-delta then do :
      361           message substitute("&1 &2&3(+/-)&4 %",
      362                        sr-izmerenia.sr-abs-err-dens-lgas-vapor:label in frame Dialog-Frame, v-msg2, chr(10), string(v-delta, "9.99") )
      363           view-as alert-box.
      364           apply "entry" to sr-izmerenia.sr-abs-err-dens-lgas-vapor in frame Dialog-Frame .
      365           return no-apply .
      366         end.
      367         v-delta = 0.42 .
      368         if sr-izmerenia.sr-relative-err-dens-lgas-liquid > v-delta or sr-izmerenia.sr-relative-err-dens-lgas-liquid < (-1) * v-delta then do :
      369           message substitute("&1 &2&3(+/-)&4 %",
      370                        sr-izmerenia.sr-relative-err-dens-lgas-liquid:label in frame Dialog-Frame, v-msg2, chr(10), string(v-delta, "9.99") )
      371           view-as alert-box.
      372           apply "entry" to sr-izmerenia.sr-relative-err-dens-lgas-liquid in frame Dialog-Frame .
      373           return no-apply .
      374         end.
      375         case sr-izmerenia.sr-type-izm:
      376            when 2 then v-delta = 1.
      377            when 0 then v-delta = 0.5.
      378            when 1 then v-delta = 0.5.
      379         end case.
      380         if sr-izmerenia.sr-abs-err-dens > v-delta or sr-izmerenia.sr-abs-err-dens < (-1) * v-delta then do :
      381           message substitute("&1 &2&3(+/-)&4 кг/м3",
      382                        sr-izmerenia.sr-abs-err-dens:label in frame Dialog-Frame, v-msg2, chr(10), string(v-delta, "9.9") )
      383           view-as alert-box.
      384           apply "entry" to sr-izmerenia.sr-abs-err-dens in frame Dialog-Frame .
      385           return no-apply .
      386         end.
      387     end.
      388     if sr-izmerenia.sr-Weight then
      389     do:
      390         v-delta = 0.65 .
      391         if sr-izmerenia.sr-otnos > v-delta or sr-izmerenia.sr-otnos < (-1) * v-delta then do :
      392           message substitute("&1 &2&3(+/-)&4 %",
      393                        sr-izmerenia.sr-otnos:label in frame Dialog-Frame, v-msg2, chr(10), string(v-delta, "9.99") )
      394           view-as alert-box.
      395           apply "entry" to sr-izmerenia.sr-otnos in frame Dialog-Frame .
      396           return no-apply .
      397         end.
      398     end.
      399     if not sr-izmerenia.sr-density
      400     then
      401        assign
      402           sr-izmerenia.sr-type-id                  = ?
      403           sr-izmerenia.sr-abs-err-dens             = ?
      404           sr-izmerenia.sr-relative-err-dens        = ?
      405           sr-izmerenia.sr-abs-err-dens-lgas-liquid = ?
      406           sr-izmerenia.sr-abs-err-dens-lgas-vapor  = ?
      407           sr-izmerenia.sr-relative-err-water       = ?
      408           sr-izmerenia.sr-relative-err-dens-lgas-liquid = ?
      409        .
      410     if not sr-izmerenia.sr-level
      411     then
      412        assign
      413           sr-izmerenia.sr-type-level-measuring    = 0
      414           sr-izmerenia.sr-temp-line               = ?
      415           sr-izmerenia.sr-abs-err-neft-water      = ?
      416           sr-izmerenia.sr-relative-err-neft-water = ?
      417           sr-izmerenia.sr-abs-err-water           = ?
      418           sr-izmerenia.sr-relative-err-water      = ?
      419        .
      420     if not sr-izmerenia.sr-Weight
      421     then
      422        assign
      423           sr-izmerenia.sr-otnos                  = ?
      424                .
      425     if not sr-izmerenia.sr-temperature
      426     then
      427        assign
      428           sr-izmerenia.sr-abs-err-temp-vol  = ?
      429           sr-izmerenia.sr-abs-err-temp-dens = ?
      430        .
      431   end.
      432   ON value-changed OF sr-izmerenia.sr-density IN FRAME Dialog-Frame
      433   do:
      434     assign
      435        sr-izmerenia.sr-density
      436     .
      437     assign
      438           sr-izmerenia.sr-type-id                  :visible = sr-izmerenia.sr-density
      439           sr-izmerenia.sr-abs-err-dens             :visible = sr-izmerenia.sr-density
      440           sr-izmerenia.sr-relative-err-dens        :visible = sr-izmerenia.sr-density
      441           sr-izmerenia.sr-abs-err-dens-lgas-liquid :visible = sr-izmerenia.sr-density
      442           sr-izmerenia.sr-abs-err-dens-lgas-vapor  :visible = sr-izmerenia.sr-density
      443           sr-izmerenia.sr-relative-err-dens-lgas-liquid :visible = sr-izmerenia.sr-density
      444           abs-err-dens-text             :visible = sr-izmerenia.sr-density
      445           relative-err-dens-text        :visible = sr-izmerenia.sr-density
      446           abs-err-dens-lgas-liquid-text :visible = sr-izmerenia.sr-density
      447           abs-err-dens-lgas-vapor-text  :visible = sr-izmerenia.sr-density
      448           relative-err-dens-lgas-liquid-t :visible = sr-izmerenia.sr-density
      449        .
      450   end.
      451   ON value-changed OF sr-izmerenia.sr-level IN FRAME Dialog-Frame
      452   do:
      453     assign
      454        sr-izmerenia.sr-level
      455     .
      456     assign
      457           sr-izmerenia.sr-type-level-measuring   :visible = sr-izmerenia.sr-level
      458           sr-izmerenia.sr-temp-line              :visible = sr-izmerenia.sr-level
      459           sr-izmerenia.sr-abs-err-neft-water     :visible = sr-izmerenia.sr-level
      460           sr-izmerenia.sr-relative-err-neft-water:visible = sr-izmerenia.sr-level
      461           sr-izmerenia.sr-abs-err-water          :visible = sr-izmerenia.sr-level
      462           sr-izmerenia.sr-relative-err-water     :visible = sr-izmerenia.sr-level
      463           temp-line-text              :visible = sr-izmerenia.sr-level
      464           abs-err-neft-water-text     :visible = sr-izmerenia.sr-level
      465           relative-err-neft-water-text:visible = sr-izmerenia.sr-level
      466           abs-err-water-text          :visible = sr-izmerenia.sr-level
      467           relative-err-water-text     :visible = sr-izmerenia.sr-level
      468        .
      469   end.
      470   ON leave OF sr-izmerenia.sr-otnos IN FRAME Dialog-Frame
      471   do:
      472     run check-sr-otnos no-error.
      473     if error-status:error
      474     then return no-apply .
      475   end.
      476   ON value-changed OF sr-izmerenia.sr-temperature IN FRAME Dialog-Frame
      477   do:
      478     assign
      479        sr-izmerenia.sr-temperature
      480     .
      481     assign
      482           sr-izmerenia.sr-abs-err-temp-vol  :visible = sr-izmerenia.sr-temperature
      483           sr-izmerenia.sr-abs-err-temp-dens :visible = sr-izmerenia.sr-temperature
      484           abs-err-temp-vol-text  :visible = sr-izmerenia.sr-temperature
      485           abs-err-temp-dens-text :visible = sr-izmerenia.sr-temperature
      486        .
      487   end.
      488   ON value-changed OF sr-izmerenia.sr-type-id IN FRAME Dialog-Frame
      489   do:
      490      run check-sr-type-id no-error.
      491      if error-status:error
      492      then return no-apply .
      493   end.
      494   ON value-changed OF sr-izmerenia.sr-type-izm IN FRAME Dialog-Frame
      495   do:
      496      assign
      497          sr-izmerenia.sr-type-izm.
      498      if sr-izmerenia.sr-type-izm ne 2
      499      then do:
      500         sr-izmerenia.sr-Weight = no.
      501         sr-izmerenia.sr-Weight:checked = no.
      502         sr-izmerenia.sr-Weight:visible = no.
      503         RECT-4:visible = no.
      504      end.
      505      else do:
      506         sr-izmerenia.sr-Weight:visible = yes.
      507         RECT-4:visible = yes.
      508      end.
      509      apply "VALUE-CHANGED" to sr-izmerenia.sr-Weight.
      510   end.
      511   ON value-changed OF sr-izmerenia.sr-Weight IN FRAME Dialog-Frame
      512   do:
      513     assign
      514        sr-izmerenia.sr-Weight
      515     .
      516     assign
      517           sr-izmerenia.sr-otnos                  :visible = sr-izmerenia.sr-Weight
      518           otnos-text                  :visible = sr-izmerenia.sr-Weight
      519             .
      520   end.
      521   if valid-handle(active-window) and frame Dialog-Frame:PARENT eq ?
      522   then frame Dialog-Frame:PARENT = active-window.
      523   MAIN-BLOCK:
      524   do on error   undo MAIN-BLOCK, leave MAIN-BLOCK
      525      on end-key undo MAIN-BLOCK, leave MAIN-BLOCK:
      526      find first sr-izmerenia where sr-izmerenia.node-code eq inode-code no-error.
      527      if not avail sr-izmerenia
      528      then do:
      529         create sr-izmerenia.
      530         assign
      531            sr-izmerenia.sr-type-level-measuring = 0.
      532      end.
      533     display sr-izmerenia.sr-level with frame Dialog-Frame.
      534     run enable_UI.
      535     apply "VALUE-CHANGED" to sr-izmerenia.sr-type-izm .
      536     apply "VALUE-CHANGED" to sr-izmerenia.sr-level.
      537     apply "VALUE-CHANGED" to sr-izmerenia.sr-temperature.
      538     apply "VALUE-CHANGED" to sr-izmerenia.sr-density.
      539     apply "VALUE-CHANGED" to sr-izmerenia.sr-Weight.
      540     wait-for go of frame Dialog-Frame.
      541   end.
      542   run disable_UI.
      543   PROCEDURE Check-err-dens :
      544      do with frame Dialog-Frame:
      545         assign
      546            sr-izmerenia.sr-density
      547            sr-izmerenia.sr-abs-err-dens
      548            sr-izmerenia.sr-relative-err-dens
      549            sr-izmerenia.sr-abs-err-dens-lgas-liquid
      550            sr-izmerenia.sr-abs-err-dens-lgas-vapor
      551            sr-izmerenia.sr-relative-err-dens-lgas-liquid
      552            .
      553         if sr-izmerenia.sr-density then do:
      554               if sr-izmerenia.sr-abs-err-dens = ? and sr-izmerenia.sr-relative-err-dens = ? then do:
      555                  message
      556                     "Для сохранения должно быть заполнено хотя бы одно из полей:" skip
      557                      " " quoter("Абсолютная погрешность измерений плотности нефтепродукта") skip
      558                      " " quoter("Относительная погрешность измерений плотности нефтепродукта")
      559                  view-as alert-box.
      560                  return error.
      561               end.
      562               if (sr-izmerenia.sr-abs-err-dens      = 0.0 or sr-izmerenia.sr-abs-err-dens      = ?) and
      563                  (sr-izmerenia.sr-relative-err-dens = 0.0 or sr-izmerenia.sr-relative-err-dens = ?) then do:
      564                  message
      565                     "Для сохранения хотя бы одно из полей должно быть ненулевым:" skip
      566                      " " quoter("Абсолютная погрешность измерений плотности нефтепродукта") skip
      567                      " " quoter("Относительная погрешность измерений плотности нефтепродукта")
      568                  view-as alert-box.
      569                  return error.
      570               end.
      571               if sr-izmerenia.sr-abs-err-dens <> 0.0 and sr-izmerenia.sr-abs-err-dens <> ? and
      572                  sr-izmerenia.sr-relative-err-dens = 0.0 then do:
      573                  message
      574                      "Поле" skip
      575                      " " quoter("Относительная погрешность измерений плотности нефтепродукта")
      576                      "не должно быть нулевым"
      577                  view-as alert-box.
      578                  apply "entry" to sr-izmerenia.sr-relative-err-dens in frame Dialog-Frame .
      579                  return error.
      580               end.
      581               if sr-izmerenia.sr-relative-err-dens <> 0.0 and sr-izmerenia.sr-relative-err-dens <> ? and
      582                  sr-izmerenia.sr-abs-err-dens = 0.0 then do:
      583                  message
      584                      "Поле" skip
      585                      " " quoter("Абсолютная погрешность измерений плотности нефтепродукта")
      586                      "не должно быть нулевым"
      587                  view-as alert-box.
      588                  apply "entry" to sr-izmerenia.sr-abs-err-dens in frame Dialog-Frame .
      589                  return error.
      590               end.
      591               if (sr-izmerenia.sr-abs-err-dens-lgas-liquid = 0.0 or sr-izmerenia.sr-abs-err-dens-lgas-liquid = ?) and
      592                  (sr-izmerenia.sr-relative-err-dens-lgas-liquid = 0.0 or sr-izmerenia.sr-relative-err-dens-lgas-liquid = ?) then do:
      593                  message
      594                     "Для сохранения хотя бы одно из полей должно быть не нулевым:" skip
      595                      " " quoter("Абсолютная погрешность измерений плотности ЖФ") skip
      596                      " " quoter("Относительная погрешность измерений плотности ЖФ")
      597                  view-as alert-box.
      598                  apply "entry" to sr-izmerenia.sr-abs-err-dens-lgas-liquid in frame Dialog-Frame .
      599                  return error.
      600               end.
      601         end.
      602      end.
      603   end procedure.
      604   PROCEDURE Check-err-Water :
      605      do with frame Dialog-Frame:
      606         assign
      607            sr-izmerenia.sr-level
      608            sr-izmerenia.sr-abs-err-water
      609            sr-izmerenia.sr-relative-err-water
      610            .
      611         if sr-izmerenia.sr-level   then do:
      612            if sr-izmerenia.sr-abs-err-water = ? then do:
      613               message
      614                   "Поле" skip
      615                   " " quoter("Абсолютная погрешность измерений уровня подтоварной воды")
      616                   "должно быть заполнено"
      617               view-as alert-box.
      618               apply "entry" to sr-izmerenia.sr-abs-err-water in frame Dialog-Frame .
      619               return error.
      620            end.
      621         end.
      622      end.
      623   end procedure.
      624   PROCEDURE Check-neft-Water :
      625      do with frame Dialog-Frame:
      626         assign
      627            sr-izmerenia.sr-level
      628            sr-izmerenia.sr-type-id
      629            sr-izmerenia.sr-abs-err-neft-water
      630            sr-izmerenia.sr-relative-err-neft-water
      631            .
      632         if sr-izmerenia.sr-level then do:
      633            if sr-izmerenia.sr-abs-err-neft-water = ? and sr-izmerenia.sr-type-izm <> 3 then do:
      634               message
      635                  "Поле" quoter("Абсолютная погрешность измерений уровня нефтепродукта и подтоварной воды")
      636                  "должно быть заполнено"
      637               view-as alert-box.
      638               apply "entry" to sr-izmerenia.sr-abs-err-neft-water in frame Dialog-Frame .
      639               return error.
      640            end.
      641         end.
      642      end.
      643   end procedure.
      644   PROCEDURE Check-sr-abs-err-temp-dens :
      645      do with frame Dialog-Frame:
      646         assign
      647            sr-izmerenia.sr-abs-err-temp-dens
      648            sr-izmerenia.sr-temperature
      649            .
      650         if sr-izmerenia.sr-temperature and sr-izmerenia.sr-abs-err-temp-dens = 0.0
      651         then do:
      652            message
      653               "Поле"
      654               quoter(sr-izmerenia.sr-abs-err-temp-dens:label in frame Dialog-Frame)
      655               "должно быть заполнено ненулевым значением"
      656            view-as alert-box.
      657            apply "entry" to sr-izmerenia.sr-abs-err-temp-dens in frame Dialog-Frame .
      658            return error.
      659         end.
      660      end.
      661   end procedure.
      662   PROCEDURE Check-sr-abs-err-temp-vol :
      663      do with frame Dialog-Frame:
      664         assign
      665            sr-izmerenia.sr-abs-err-temp-vol
      666            sr-izmerenia.sr-temperature
      667            .
      668         if sr-izmerenia.sr-temperature and sr-izmerenia.sr-abs-err-temp-vol = 0.0
      669         then do:
      670            message
      671               "Поле"
      672               quoter(sr-izmerenia.sr-abs-err-temp-vol:label in frame Dialog-Frame)
      673               "должно быть заполнено ненулевым значением"
      674            view-as alert-box.
      675            apply "entry" to sr-izmerenia.sr-abs-err-temp-vol in frame Dialog-Frame .
      676            return error.
      677         end.
      678      end.
      679   end procedure.
      680   PROCEDURE Check-sr-otnos :
      681      do with frame Dialog-Frame:
      682         assign
      683             sr-izmerenia.sr-Weight
      684             sr-izmerenia.sr-otnos
      685          .
      686          if sr-izmerenia.sr-Weight then do:
      687             if sr-izmerenia.sr-otnos = ? then do:
      688                 message
      689                    "Поле"
      690                    quoter(sr-izmerenia.sr-otnos:label in frame Dialog-Frame)
      691                    "обязательно для заполнения"
      692                 view-as alert-box.
      693                 apply "entry" to sr-izmerenia.sr-otnos in frame Dialog-Frame .
      694                 return error.
      695             end.
      696             if sr-izmerenia.sr-otnos = 0.0 then do:
      697                 message
      698                    "Поле"
      699                    quoter(sr-izmerenia.sr-otnos:label in frame Dialog-Frame)
      700                    "должно быть заполнено ненулевым значением"
      701                 view-as alert-box.
      702                 apply "entry" to sr-izmerenia.sr-otnos in frame Dialog-Frame .
      703                 return error.
      704             end.
      705          end.
      706      end.
      707   end procedure.
      708   PROCEDURE Check-sr-temp-line :
      709      do with frame Dialog-Frame:
      710         assign
      711            sr-izmerenia.sr-temp-line
      712            sr-izmerenia.sr-level
      713            .
      714         if sr-izmerenia.sr-level then do:
      715            if sr-izmerenia.sr-temp-line = ? and sr-izmerenia.sr-type-izm <> 3 then do:
      716               message
      717                  "Поле"
      718                  quoter(sr-izmerenia.sr-temp-line:label in frame Dialog-Frame)
      719                  "обязательно для заполнения"
      720               view-as alert-box.
      721               apply "entry" to sr-izmerenia.sr-temp-line in frame Dialog-Frame .
      722               return error.
      723            end.
      724            if sr-izmerenia.sr-temp-line = 0.0 then do:
      725               message
      726                  "Поле"
      727                  quoter(sr-izmerenia.sr-temp-line:label in frame Dialog-Frame)
      728                  "не может быть нулевым"
      729               view-as alert-box.
      730               apply "entry" to sr-izmerenia.sr-temp-line in frame Dialog-Frame .
      731               return error.
      732            end.
      733         end.
      734      end.
      735   end procedure.
      736   PROCEDURE Check-sr-type-id :
      737    do with frame Dialog-Frame:
      738   assign
      739        sr-izmerenia.sr-density
      740        sr-izmerenia.sr-type-id
      741     .
      742     if     sr-izmerenia.sr-density
      743        and (   sr-izmerenia.sr-type-id eq ?
      744             or sr-izmerenia.sr-type-id eq 0)
      745     then do:
      746        message sr-izmerenia.sr-type-id:label in frame Dialog-Frame " обязателен для заполнения"
      747        view-as alert-box.
      748        apply "entry" to sr-izmerenia.sr-type-id in frame Dialog-Frame .
      749        return error.
      750     end.  end.
      751   end procedure.
      752   PROCEDURE disable_UI :
      753     HIDE FRAME Dialog-Frame.
      754   END PROCEDURE.
      755   PROCEDURE enable_UI :
      756     OPEN QUERY Dialog-Frame FOR EACH sr-izmerenia SHARE-LOCK.
      757     if available sr-izmerenia then
      758       display sr-izmerenia.node-code sr-izmerenia.sr-model sr-izmerenia.sr-type-izm
      759             sr-izmerenia.sr-level sr-izmerenia.sr-type-level-measuring
      760             sr-izmerenia.sr-temp-line sr-izmerenia.sr-abs-err-neft-water
      761             sr-izmerenia.sr-relative-err-neft-water sr-izmerenia.sr-abs-err-water
      762             sr-izmerenia.sr-relative-err-water sr-izmerenia.sr-temperature
      763             sr-izmerenia.sr-abs-err-temp-vol sr-izmerenia.sr-abs-err-temp-dens
      764             sr-izmerenia.sr-density sr-izmerenia.sr-type-id
      765             sr-izmerenia.sr-abs-err-dens sr-izmerenia.sr-relative-err-dens
      766             sr-izmerenia.sr-abs-err-dens-lgas-liquid
      767             sr-izmerenia.sr-abs-err-dens-lgas-vapor
      768             sr-izmerenia.sr-relative-err-dens-lgas-liquid sr-izmerenia.sr-Weight
      769             sr-izmerenia.sr-otnos sr-izmerenia.sr-not-used
      770             temp-line-text abs-err-neft-water-text relative-err-neft-water-text
      771             abs-err-water-text relative-err-water-text abs-err-temp-vol-text
      772             abs-err-temp-dens-text abs-err-dens-text relative-err-dens-text
      773             abs-err-dens-lgas-liquid-text abs-err-dens-lgas-vapor-text
      774             otnos-text relative-err-dens-lgas-liquid-t
      775         with frame Dialog-Frame.
      776     enable RECT-1 RECT-2 RECT-3 RECT-4  Btn_Cancel with frame Dialog-Frame.
      777     if iMode ne 'ПРОСМОТР':U
      778     then
      779     enable Btn_OK
      780            sr-izmerenia.sr-model
      781            sr-izmerenia.sr-type-izm sr-izmerenia.sr-level
      782            sr-izmerenia.sr-abs-err-neft-water
      783            sr-izmerenia.sr-relative-err-neft-water sr-izmerenia.sr-abs-err-water
      784            sr-izmerenia.sr-relative-err-water sr-izmerenia.sr-temperature
      785            sr-izmerenia.sr-abs-err-temp-vol sr-izmerenia.sr-abs-err-temp-dens
      786            sr-izmerenia.sr-density sr-izmerenia.sr-type-id
      787            sr-izmerenia.sr-abs-err-dens sr-izmerenia.sr-relative-err-dens
      788            sr-izmerenia.sr-abs-err-dens-lgas-liquid
      789            sr-izmerenia.sr-abs-err-dens-lgas-vapor
      790            sr-izmerenia.sr-relative-err-dens-lgas-liquid sr-izmerenia.sr-Weight
      791            sr-izmerenia.sr-otnos sr-izmerenia.sr-type-level-measuring
      792            sr-izmerenia.sr-temp-line sr-izmerenia.sr-not-used
      793            sr-izmerenia.sr-relative-err-dens-lgas-liquid
      794         with frame Dialog-Frame.
      795     view frame Dialog-Frame.
      796   END PROCEDURE.
