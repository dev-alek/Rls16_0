        1   block-level on error undo, throw.
        2   using Progress.Lang.*.
        3   using ibs.th.bge.1crn.subjects.*.
        4   define input parameter p-Cashiers as class cashiers no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision: 07968b41871b, 1804, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
        7   define variable vss-date        as character no-undo init "$Date: Tue Mar 05 16:32:36 2019 +0300 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: imp-cashiers-1c-RN.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: ref/imp-cashiers-1c-RN.p $":U .
       10   define variable vss-description as character no-undo init "Загрузка переоценки из ERP 1C RN".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
