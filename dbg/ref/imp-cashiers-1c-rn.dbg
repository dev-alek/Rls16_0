       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   procedure cur-time :
       82      define output parameter p-today as date      no-undo .
       83      define output parameter p-time  as integer   no-undo .
       84     do
       85     on error undo, return error
       86     :
       87       define variable v-date1 as date      no-undo .
       88       define variable v-date2 as date      no-undo .
       89       define variable v-time  as integer   no-undo .
       90       assign
       91         v-date1 = today
       92         v-time  = time
       93         v-date2 = today
       94       .
       95       if v-date1 <> v-date2
       96       then do:
       97         assign
       98           v-date1 = today
       99           v-time  = v-time
      100         .
      101       end.
      102       assign
      103         p-today = v-date1
      104         p-time  = v-time
      105       .
      106     end.
      107   end.
      108   function cur-time-date returns character
      109   :
      110     return string(today, '99/99/9999':U) .
      111   end.
      112   function cur-time-mjd returns decimal
      113   :
      114     define variable v-date as date      no-undo .
      115     define variable v-time as integer   no-undo .
      116     run cur-time in this-procedure
      117       (output v-date
      118       ,output v-time
      119       ) .
      120     return integer(v-date) - 2400002 + (v-time / 86400) .
      121   end.
      122   function cur-time-get-ending-index returns integer
      123   (input p-number as integer
      124   )
      125   :
      126     if p-number < 0
      127     or p-number = ?
      128     then do:
      129       return 1 .
      130     end.
      131     define variable v-rest as integer   no-undo .
      132     assign
      133       p-number = p-number modulo 100
      134     .
      135     if p-number < 20
      136     then do:
      137       assign
      138         v-rest = p-number
      139       .
      140     end.
      141     else do:
      142       assign
      143         v-rest = p-number modulo 10
      144       .
      145     end.
      146     case v-rest :
      147       when 1
      148       then do:
      149         return 2 .
      150       end.
      151       when 2 or
      152       when 3 or
      153       when 4
      154       then do:
      155         return 3 .
      156       end.
      157       otherwise do:
      158         return 1 .
      159       end.
      160     end case .
      161   end.
      162   procedure cur-time-mjd-to-date :
      163      define input  parameter i-mjd-diff as decimal no-undo.
      164      define output parameter o-Date     as date    no-undo.
      165      define output parameter o-Time     as integer no-undo.
      166      define variable v-day-number as integer   no-undo .
      167      if    i-mjd-diff < 0
      168         or i-mjd-diff = ?
      169      then do:
      170         return "?" .
      171      end.
      172      assign
      173         v-day-number = truncate(i-mjd-diff,0).
      174         o-Date = date(v-day-number + 2400002).
      175         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      176     .
      177   end.
      178   function cur-time-mjd-to-string returns character
      179   (input p-mjd-diff as decimal
      180   )
      181   :
      182     define variable v-day-number as integer   no-undo .
      183     define variable v-seconds    as integer   no-undo .
      184     define variable v-hour       as integer   no-undo .
      185     define variable v-min        as integer   no-undo .
      186     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      187     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      188     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      189     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      190     if p-mjd-diff < 0
      191     or p-mjd-diff = ?
      192     then do:
      193       return "?" .
      194     end.
      195     assign
      196       v-day-number = integer(truncate(p-mjd-diff,0))
      197       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      198     .
      199     if v-seconds > 86400
      200     then do:
      201       assign
      202         v-seconds = 86400 - 1
      203       .
      204     end.
      205     if v-seconds < 0
      206     then do:
      207       assign
      208         v-seconds = 0
      209       .
      210     end.
      211     assign
      212       v-hour = truncate(v-seconds / 3600, 0)
      213     .
      214     assign
      215       v-seconds = v-seconds modulo 3600
      216     .
      217     assign
      218       v-min = truncate(v-seconds / 60, 0)
      219     .
      220     assign
      221       v-seconds = v-seconds modulo 60
      222     .
      223     return
      224         (if v-day-number <> 0
      225           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      226           else ""
      227         )
      228       + (if v-day-number <> 0 or v-hour <> 0
      229           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      230           else ""
      231         )
      232       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      233           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      234           else ""
      235         )
      236       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      237       .
      238   end.
      239   function cur-time-string returns character
      240   :
      241     define variable v-date as date      no-undo .
      242     define variable v-time as integer   no-undo .
      243     run cur-time in this-procedure
      244       (output v-date
      245       ,output v-time
      246       ) .
      247     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      248   end.
      249   function cur-time-string-sec returns character
      250   :
      251     define variable v-date as date      no-undo .
      252     define variable v-time as integer   no-undo .
      253     run cur-time in this-procedure
      254       (output v-date
      255       ,output v-time
      256       ) .
      257     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      258   end.
      259   function cur-time-custom  returns character
      260   (input p-prefix as character
      261   ,input p-date-format as character
      262   ,input p-delimiter as character
      263   ,input p-time-format as character
      264   ,input p-suffix as character
      265   )
      266   :
      267     define variable v-date as date      no-undo .
      268     define variable v-time as integer   no-undo .
      269     run cur-time in this-procedure
      270       (output v-date
      271       ,output v-time
      272       ) .
      273     return
      274       p-prefix
      275       + string(v-date, p-date-format)
      276       + p-delimiter
      277       + string(v-time, p-time-format)
      278       + p-suffix
      279       .
      280   end.
      281   function cur-time-print  returns character
      282   :
      283     define variable v-date as date      no-undo .
      284     define variable v-time as integer   no-undo .
      285     run cur-time in this-procedure
      286       (output v-date
      287       ,output v-time
      288       ) .
      289     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      290   end.
      291   function cur-time-datetime returns datetime
      292   :
      293     define variable v-char as character no-undo .
      294     define variable v-datetime as datetime no-undo .
      295     v-char = cur-time-string().
      296     v-datetime = datetime(v-char).
      297     return  v-datetime.
      298   end.
      299   function cur-time-string-msec returns character
      300   :
      301     define variable v-date as datetime  no-undo .
      302     v-date = now.
      303     return string(v-date) .
      304   end.
      305   DEFINE TEMP-TABLE tt-clients NO-UNDO LIKE ub.clients.
      306   DEFINE TEMP-TABLE tt-person NO-UNDO LIKE ub.person.
      307   DEFINE TEMP-TABLE tt-staff NO-UNDO LIKE ub.staff.
      308   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      309   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      310   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
      311                                                       ,input p-range-type as character
      312                                                       ,input p-code as integer):
      313   define variable v-seq-val as integer no-undo .
      314   define buffer buf_code-range for ub.code-range.
      315   find first buf_code-range no-lock where
      316             buf_code-range.db-num = p-db-num
      317       and  buf_code-range.range-type = p-range-type
      318       and  buf_code-range.stts = 'u'
      319       and buf_code-range.first-code <= p-code
      320       and buf_code-range.last-code >= p-code no-error .
      321   if available buf_code-range then return yes.
      322   CASE p-range-type:
      323     when 'pngb':U then do:
      324       v-seq-val = current-value(s-pngb-code, ub).
      325     end.
      326     when 'fmgb':U then do:
      327       v-seq-val = current-value(s-fmgb-code, ub).
      328     end.
      329   END CASE.
      330   if p-code <= v-seq-val then do:
      331     find first buf_code-range no-lock where
      332               buf_code-range.db-num = p-db-num
      333         and  buf_code-range.range-type = p-range-type
      334         and  buf_code-range.stts = 'a'
      335         and buf_code-range.first-code <= p-code
      336         no-error .
      337    if available buf_code-range then return yes.
      338   end.
      339   find first buf_code-range no-lock where
      340             buf_code-range.db-num = p-db-num
      341       and  buf_code-range.range-type = p-range-type
      342       and  buf_code-range.stts = 'f'
      343       and buf_code-range.first-code <= p-code
      344       and buf_code-range.last-code >= p-code
      345       no-error .
      346   if available buf_code-range then return yes.
      347   return no.
      348   END FUNCTION.
      349   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
      350                                                       ,input p-range-type as character
      351                                                       ,input p-code as integer):
      352   define variable v-seq-val as integer no-undo .
      353   define buffer buf_code-range for ub.code-range.
      354   CASE p-range-type:
      355     when 'pngb':U then do:
      356       v-seq-val = current-value(s-pngb-code, ub).
      357     end.
      358     when 'fmgb':U then do:
      359       v-seq-val = current-value(s-fmgb-code, ub).
      360     end.
      361   END CASE.
      362   if p-code <= v-seq-val then do:
      363     find first buf_code-range no-lock where
      364               buf_code-range.db-num = p-db-num
      365         and  buf_code-range.range-type = p-range-type
      366         and buf_code-range.first-code <= p-code
      367         and buf_code-range.last-code >= p-code no-error .
      368     if available buf_code-range then return yes.
      369   end.
      370   return no.
      371   END FUNCTION.
      372   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
      373                                                       ,input p-db-num as integer
      374                                                       ,input p-staff-code as integer
      375                                                       ,input p-date as date
      376                                                        ):
      377   define buffer buf_staff for ub.staff.
      378   if p-date = ? then do:
      379     p-date = today .
      380   end.
      381   find first buf_staff no-lock where
      382             buf_staff.role = p-role
      383         and buf_staff.role-level = 'db':U
      384         and buf_staff.db-num = p-db-num
      385         and buf_staff.staff-code = p-staff-code
      386         and buf_staff.date-end >= p-date use-index pi  no-error .
      387   if available buf_staff then do:
      388     return buf_staff.psn-code.
      389   end.
      390   return 0.
      391   end FUNCTION.
      392   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
      393                                                             ,input p-db-num as integer
      394                                                             ,input p-date as date
      395                                                                 ):
      396   define buffer buf_staff for ub.staff.
      397   define buffer buf2_staff for ub.staff.
      398   if p-date = ? then do:
      399     p-date = today .
      400   end.
      401   for each  buf_staff no-lock where
      402             buf_staff.role = p-role
      403         and buf_staff.db-num = p-db-num,
      404   first buf2_staff no-lock where
      405         buf2_staff.role = p-role
      406     and buf2_staff.role-level = 'db':U
      407     and buf2_staff.staff-code = buf_staff.staff-code
      408     and buf2_staff.date-start <= p-date
      409     and buf2_staff.date-end >= p-date
      410   by buf_staff.staff-code
      411   by date-start descending:
      412     return buf_staff.staff-code.
      413   end.
      414   end FUNCTION.
      415   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
      416                                                  ,input p-db-num as integer
      417                                                  ,input p-psn-code as integer
      418                                                  ,input p-date as date
      419                                                  ,output p-c-password as character
      420                                                        ):
      421   define buffer buf_staff for ub.staff.
      422   if p-date = ? then do:
      423     p-date = today .
      424   end.
      425   find first buf_staff no-lock where
      426             buf_staff.role = p-role
      427         and buf_staff.role-level = 'db':U
      428         and buf_staff.db-num = p-db-num
      429        and buf_staff.date-end >= p-date
      430        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
      431   if available buf_staff
      432   then do:
      433     assign
      434     p-c-password = buf_staff.password.
      435     return buf_staff.staff-code.
      436   end.
      437   p-c-password = ''.
      438   return 0.
      439   end FUNCTION.
      440   FUNCTION gbclcode-is-psn-role returns integer (
      441                                                 input p-role as character
      442                                                 ,input p-psn-code as integer
      443                                                 ,input p-date as date
      444                                                     ):
      445   define buffer buf_staff for ub.staff.
      446   if p-date = ? then do:
      447     p-date = today .
      448   end.
      449   for each buf_staff no-lock where
      450             buf_staff.psn-code = p-psn-code
      451        and  buf_staff.role = p-role
      452   by buf_staff.role-level
      453   by buf_staff.date-start
      454        :
      455     if  buf_staff.date-start <= p-date and
      456     buf_staff.date-end >= p-date  then do:
      457       return buf_staff.staff-code.
      458     end.
      459   end.
      460   return 0.
      461   end FUNCTION.
      462   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
      463   define variable v-role-name as character no-undo .
      464   assign
      465   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      466   no-error .
      467   return v-role-name.
      468   END.
      469   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      470   FUNCTION gbclcode-get-position returns character ( input p-role as character
      471                                                     ,input p-role-level as character
      472                                                     ,input p-work-place as character
      473                                                     ,input p-staff-code as integer
      474                                                                ):
      475   define variable v-role-name as character no-undo .
      476   define variable v-role-level as character no-undo .
      477   define variable v-staff-code as integer no-undo .
      478   assign
      479   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      480   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
      481   v-staff-code = p-staff-code
      482   no-error .
      483   return substitute("&1, &2, Код &3"
      484                   ,v-role-name
      485                   ,v-role-level
      486                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
      487   END.
      488   FUNCTION gbclcode-get-work-place returns character (
      489                                                   input p-role as character
      490                                                  ,input p-role-level as character
      491                                                  ,input p-db-num as integer
      492                                                  ,input p-host-code as integer
      493                                                  ,input p-obj-type as character
      494                                                  ,input p-obj-code as integer
      495                                                  ) :
      496   define variable v-work-place as character no-undo .
      497   define variable v-obj-type as character no-undo .
      498     case p-role-level:
      499       when 'db':U then do:
      500         v-work-place = string(p-db-num, "99999").
      501       end.
      502       when 'firm':U then do:
      503         v-work-place = string(p-host-code, "99999").
      504       end.
      505       when 'object':U then do:
      506         assign
      507         v-work-place = p-obj-type + string(p-obj-code, "999999999")
      508         .
      509       end.
      510     END CASE.
      511     return v-work-place.
      512   END FUNCTION.
      513   FUNCTION gbclcode-get-level-last-code returns integer (
      514                                                           input p-role as character
      515                                                         , input p-role-level as character
      516                                                         , input p-work-place as character
      517                                                         , input p-date-start as date
      518                                                         ):
      519   DEFINE VARIABLE v-today as date no-undo .
      520   define buffer buf_staff for ub.staff.
      521   if p-work-place = chr(63) then return ?.
      522   if p-date-start = ? then do:
      523     v-today = today .
      524   end.
      525   else do:
      526     v-today = p-date-start.
      527   end.
      528   find last buf_staff no-lock where
      529             buf_staff.role = p-role
      530        and  buf_staff.role-level = p-role-level
      531        and  buf_staff.work-place = p-work-place
      532        and  buf_staff.date-start <= v-today + 1
      533        and  buf_staff.date-end >= v-today + 1
      534        use-index pi  no-error .
      535   if available buf_staff
      536   then return buf_staff.staff-code.
      537   return 0.
      538   end FUNCTION.
      539   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      540   PROCEDURE request-proc-save-staff :
      541   DEFINE INPUT PARAMETER p-child-handle AS HANDLE NO-UNDO.
      542   define input parameter p-mode as character no-undo .
      543   define input parameter p-callpoint as character no-undo .
      544   define buffer buf_tt-staff for tt-staff.
      545   IF p-mode <> 'ДОБАВЛЕНИЕ':U
      546   OR LOOKUP(p-callpoint , 'C,S':U) = 0 THEN RETURN.
      547   for each buf_tt-staff :
      548       RUN proc-save-staff IN p-child-handle (
      549                                              INPUT buf_tt-staff.role
      550                                             ,INPUT buf_tt-staff.staff-code
      551                                             ,INPUT buf_tt-staff.role-level
      552                                             ,INPUT buf_tt-staff.db-num
      553                                             ,INPUT buf_tt-staff.host-code
      554                                             ,INPUT buf_tt-staff.obj-type
      555                                             ,INPUT buf_tt-staff.obj-code
      556                                             ,INPUT buf_tt-staff.password
      557                                             ,input buf_tt-staff.date-start
      558                                             ,input buf_tt-staff.date-end
      559                                             ,input buf_tt-staff.work-place
      560                                               ) NO-ERROR.
      561       IF ERROR-STATUS:ERROR THEN DO:
      562         UNDO, RETURN ERROR RETURN-VALUE.
      563       END.
      564   END.
      565   END PROCEDURE.
      566   define variable v-rec       as recid   no-undo .
      567   define variable v-rid       as recid   no-undo .
      568   define variable v-curr-code as integer no-undo .
      569   define buffer buf_clients for ub.clients .
      570   define buffer bf_clients  for ub.clients .
      571   define buffer buf_staff   for ub.staff .
      572   define buffer buf_person  for ub.person .
      573   define buffer buf_cli-grp for ub.cli-grp .
      574   define variable v-mode       as character no-undo .
      575   define variable p-mode       as character no-undo .
      576   define variable v-clients-ok as logical   no-undo .
      577   define variable v-role       as character no-undo .
      578   define variable v-today      as date      no-undo.
      579   define variable v-time       as integer   no-undo.
      580   run cur-time in this-procedure (output v-today, output v-time) no-error.
      581   if ERROR-STATUS:error then
      582   do:
      583     undo, return error "Ошибка при определении текущей даты!" .
      584   end.
      585   if p-Cashiers:del-f = 1 then
      586   do:
      587     find first buf_clients EXCLUSIVE-LOCK where buf_clients.obj-code = integer(p-Cashiers:code_)
      588       and buf_clients.obj-type = 'чел':U and buf_clients.grp-code = 4 no-error .
      589     if AVAILABLE buf_clients then
      590     do:
      591       for first buf_person exclusive-lock where buf_person.psn-code = buf_clients.obj-code:
      592         for first buf_staff EXCLUSIVE-LOCK where buf_staff.psn-code = buf_person.psn-code and buf_staff.staff-code = integer(p-Cashiers:code_):
      593           assign
      594             buf_staff.date-end = v-today
      595             buf_clients.stts   = p-Cashiers:del-f
      596             .
      597         end.
      598       end.
      599     end.
      600     else
      601     do:
      602       undo, return error "Клиент не найден с кодом:" + p-Cashiers:code_ .
      603     end.
      604   end.
      605   else
      606   do:
      607     find first buf_cli-grp no-lock where buf_cli-grp.node-code = 4 no-error .
      608     if not AVAILABLE buf_cli-grp then
      609     do:
      610       undo, return error "Нет группы клиентов с кодом: 4".
      611     end.
      612     else
      613     do:
      614       find first buf_clients EXCLUSIVE-LOCK where buf_clients.obj-code = integer(p-Cashiers:code_)
      615         and buf_clients.obj-type = 'чел':U no-error .
      616       if not AVAILABLE buf_clients then
      617       do:
      618         create tt-clients.
      619         assign
      620           v-mode = 'ДОБАВЛЕНИЕ':U
      621           v-rec  = ?
      622           .
      623       end.
      624       else
      625       do:
      626         create tt-clients.
      627         buffer-copy buf_clients to tt-clients.
      628         assign
      629           v-mode = 'ИЗМЕНЕНИЕ':U
      630           v-rec  = recid(buf_clients)
      631           .
      632       end.
      633       assign
      634         tt-clients.obj-code = integer(p-Cashiers:code_)
      635         tt-clients.obj-type = 'чел':U
      636         tt-clients.db-num   = ?
      637         tt-clients.grp-code = buf_cli-grp.node-code
      638         tt-clients.grp-name = buf_cli-grp.node-name
      639         tt-clients.obj-name = p-Cashiers:name_
      640         tt-clients.stts     = p-Cashiers:del-f
      641         .
      642       find first buf_person EXCLUSIVE-LOCK where buf_person.psn-code = integer(p-Cashiers:code_) no-error .
      643       if not AVAILABLE buf_person then
      644       do:
      645         create tt-person .
      646         assign
      647           tt-person.psn-code = integer(p-Cashiers:code_)
      648           .
      649       end.
      650       else
      651       do:
      652         create tt-person .
      653         BUFFER-COPY buf_person to tt-person .
      654       end.
      655       if p-Cashiers:role-code = 2 then v-role = 'C':U .
      656       else v-role = "cli-all" .
      657       run ref/person1.p (
      658         input this-procedure
      659         ,input this-procedure:handle
      660         ,input-output v-rec
      661         ,input v-mode
      662         ,input v-role
      663         ,input yes
      664         ,input tt-person.psn-code
      665         ,input tt-clients.stts
      666         ,input tt-clients.obj-name
      667         ,input tt-clients.lim-kr
      668         ,input tt-clients.PS
      669         ,input tt-clients.grp-code
      670         ,input tt-person.address
      671         ,input tt-person.city
      672         ,input tt-person.date-birth
      673         ,input tt-person.e-mail
      674         ,input tt-person.fax
      675         ,input tt-person.firm-code
      676         ,input tt-person.firm-name
      677         ,input tt-person.gender
      678         ,input tt-person.given-by
      679         ,input tt-person.ind
      680         ,input tt-person.inn
      681         ,input yes
      682         ,input tt-person.is-pboul
      683         ,input tt-person.kpp
      684         ,input tt-person.name1
      685         ,input tt-person.name2
      686         ,input tt-person.okonh
      687         ,input tt-person.okpo
      688         ,input tt-person.passp-num
      689         ,input tt-person.passp-ser
      690         ,input tt-person.phone1
      691         ,input tt-person.phone1-note
      692         ,input tt-person.position
      693         ,input tt-person.post-box
      694         ,input tt-person.post-address
      695         ,input tt-person.post-city
      696         ,input tt-person.post-ind
      697         ,input tt-clients.reg-code
      698         ,input tt-clients.turnover-buyer
      699         ,input tt-clients.turnover-buyer-gds
      700         ) no-error .
      701       if error-status:error then
      702       do:
      703         return error RETURN-VALUE .
      704       end.
      705       if p-Cashiers:role-code = 2 then
      706       do:
      707         find first bf_clients EXCLUSIVE-LOCK where bf_clients.obj-code = integer(p-Cashiers:code_)
      708           and bf_clients.obj-type = 'чел':U no-error .
      709         find first buf_staff EXCLUSIVE-LOCK where buf_staff.psn-code = integer(p-Cashiers:code_)
      710           and buf_staff.role       = 'C':U
      711           no-error .
      712         if not AVAILABLE buf_staff then
      713         do:
      714           create buf_staff .
      715           assign
      716             buf_staff.psn-code   = integer(p-Cashiers:code_)
      717             buf_staff.password   = string(p-Cashiers:code_)
      718             buf_staff.date-start = v-today
      719             buf_staff.db-num     = g#db-num
      720             buf_staff.role       = 'C':U
      721             buf_staff.role-level = 'db':U
      722             buf_staff.staff-code = integer(p-Cashiers:code_)
      723             buf_staff.work-place = string(g#db-num, '99999')
      724             .
      725         end.
      726         if p-Cashiers:del-l = 1 then buf_staff.date-end = v-today.
      727         else buf_staff.date-end = date("31/12/9999")  .
      728         if p-Cashiers:del-f = 0 then bf_clients.stts = 0 .
      729       end.
      730     end.
      731   end.
