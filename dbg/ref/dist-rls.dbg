     5823     :
     5824       if QUERY br-dis-time-rule:handle:get-buffer-handle(1) = (buffer X_dis-time-rule:handle) then do:
     5825         assign
     5826         parameter-2-57 = (if p-find-next then "true":u else "false":u )
     5827         parameter-4-57 =
     5828           "where ":u + " TRUE " + " ":u + where-phrase-57 + " ":u + p-find-condition + " " + ""
     5829         parameter-5-57 = "  "
     5830       .
     5831         run fltopend_fltfindd in this-procedure  (
     5832                             input this-procedure:handle
     5833                             ,input QUERY br-dis-time-rule:handle
     5834                             ,input rowid(X_dis-time-rule)
     5835                             ,input logical(parameter-2-57)
     5836                             ,input no-lock
     5837                             ,input (buffer X_dis-time-rule:handle)
     5838                             ,input parameter-4-57
     5839                             ,input parameter-5-57
     5840                             ) no-error.
     5841         .
     5842         assign
