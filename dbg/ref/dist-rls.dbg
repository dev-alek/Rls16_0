     3766   define variable  sort-phrase-rus-37  as character no-undo .
     3767     run waitfram-show in this-procedure
     3768       (input "ЖДИТЕ ..."
     3769       ).
     3770   run gbl/flt-get.p
     3771     (input filter-point
     3772     ,output flt-rec-37
     3773     ,output filter-name-37
     3774     ,output where-phrase-37
     3775     ,output sort-phrase-37
     3776     ,output where-phrase-rus-37
     3777     ,output sort-phrase-rus-37
     3778     ).
     3779   if p-open-query then do:
     3780       run set-filter-name in this-procedure
     3781         (INPUT filter-name-37
     3782         ) no-error .
     3783     assign
     3784       l-filter-open-37 = false
     3785     .
     3786     if flt-rec-37 <> ?
     3787       or sort-column-phrase > ""
     3788     then do:
     3789       define variable  parameter-2-37 as character no-undo .
     3790       define variable  parameter-3-37 as character no-undo .
     3791       define variable  parameter-4-37 as character no-undo .
     3792       define variable  parameter-5-37 as character no-undo .
     3793       define variable  parameter-6-37 as character no-undo .
     3794       define variable  parameter-7-37 as character no-undo .
     3795         assign
     3796         parameter-3-37 =
     3797                                 "FOR EACH X_dis-time-rule no-lock"
     3798         parameter-4-37 =
     3799           (
     3800             if (" TRUE " + " " + where-phrase-37) <> ""
     3801             then " TRUE " + " " + where-phrase-37
     3802             else "true"
     3803           )
     3804         parameter-5-37 = (" " + "" + " " + ", first tt-template_dis-time-rule no-lock where tt-template_dis-time-rule.time-rule-num = X_dis-time-rule.templ-rl-root")
     3805         parameter-6-37 = if sort-phrase-37 = ''
     3806                              then
     3807           (
     3808           " " + "  " +
     3809             " " + sort-column-phrase +
     3810           " " + "  "
     3811           )
     3812                              else
     3813           (
     3814           " " + "  " +
     3815             " " + sort-column-phrase +
     3816           " " + sort-phrase-37
     3817           )
     3818         parameter-7-37 =
     3819           " indexed-reposition  "
     3820       .
     3821       do
     3822       on stop undo, leave
     3823       on error undo, leave
     3824       :
     3825         assign
     3826           l-disable-where-37 =
     3827             (" TRUE " + " " + where-phrase-37 = "")
     3828         .
     3829         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3830                             ,input QUERY br-dis-time-rule:handle
     3831                             ,input parameter-3-37
     3832                             ,input parameter-4-37
     3833                             ,input parameter-5-37
     3834                             ,input parameter-6-37
     3835                             ,input parameter-7-37
     3836                             )
     3837         .
     3838         assign
     3839           l-filter-open-37 = true
     3840         .
     3841       end.
     3842       if l-filter-open-37 = false then do:
     3843         message
     3844           "Ошибка при фильтрации / сортировке" skip
     3845           "Будут показаны записи без учета фильтра" skip
     3846           view-as alert-box .
     3847       end.
     3848       else do:
     3849           assign
     3850             l-query-was-opened = true
     3851           .
     3852       end.
     3853     end.
     3854     if l-filter-open-37 = false then do:
     3855       OPEN QUERY br-dis-time-rule FOR EACH X_dis-time-rule no-lock
     3856         where  TRUE
     3857       , first tt-template_dis-time-rule no-lock where tt-template_dis-time-rule.time-rule-num = X_dis-time-rule.templ-rl-root
     3858         indexed-reposition
     3859     .
     3860         assign
     3861           l-query-was-opened = true
     3862         .
     3863     end.
     3864   end.
     3865   else do:
     3866     assign
     3867       v-doc-rec = recid( X_dis-time-rule )
     3868     .
     3869     do
     3870     on stop undo, leave
     3871     on error undo, leave
     3872     :
     3873       if QUERY br-dis-time-rule:handle:get-buffer-handle(1) = (buffer X_dis-time-rule:handle) then do:
     3874         assign
     3875         parameter-2-37 = (if p-find-next then "true":u else "false":u )
     3876         parameter-4-37 =
     3877           "where ":u + " TRUE " + " ":u + where-phrase-37 + " ":u + p-find-condition + " " + ""
     3878         parameter-5-37 = "  "
     3879       .
     3880         run fltopend_fltfindd in this-procedure  (
     3881                             input this-procedure:handle
     3882                             ,input QUERY br-dis-time-rule:handle
     3883                             ,input rowid(X_dis-time-rule)
     3884                             ,input logical(parameter-2-37)
     3885                             ,input no-lock
     3886                             ,input (buffer X_dis-time-rule:handle)
     3887                             ,input parameter-4-37
     3888                             ,input parameter-5-37
     3889                             ) no-error.
     3890         .
     3891         assign
     3892           v-doc-rec = integer(return-value)
     3893           v-fltopend-rowid[1] = ?
     3894         .
     3895       end.
     3896       else do:
     3897         assign
     3898         parameter-2-37 = (if p-find-next then "true":u else "false":u )
     3899         parameter-3-37 =  "FOR EACH X_dis-time-rule no-lock"
     3900         parameter-4-37 =
     3901           (
     3902             if (" TRUE " + " " + where-phrase-37) <> ""
     3903             then " TRUE " + " " + where-phrase-37
     3904             else "true"
     3905           )
     3906         parameter-5-37 = (" " + "" + " " + ", first tt-template_dis-time-rule no-lock where tt-template_dis-time-rule.time-rule-num = X_dis-time-rule.templ-rl-root" + " " + p-find-condition)
     3907         parameter-6-37 = if sort-phrase-37 = ''
     3908                              then
     3909           (
     3910           " " + "  " +
     3911             " " + sort-column-phrase +
     3912           " " + "  "
     3913           )
     3914                              else
     3915           (
     3916           " " + "  " +
     3917             " " + sort-column-phrase +
     3918           " " + sort-phrase-37
     3919           )
     3920         parameter-7-37 =
     3921           " indexed-reposition  "
     3922       .
     3923         run fltopend_fltfindq in this-procedure  (
     3924                             input this-procedure:handle
     3925                             ,input QUERY br-dis-time-rule:handle
     3926                             ,input logical(parameter-2-37)
     3927                             ,input no-lock
     3928                             ,input parameter-3-37
     3929                             ,input parameter-4-37
     3930                             ,input parameter-5-37
     3931                             ,input parameter-6-37
     3932                             ,input parameter-7-37
     3933                             ,output v-fltopend-rowid
     3934                             ) no-error.
     3935         .
     3936         v-doc-rec = ?.
     3937       end.
     3938       assign
     3939         l-query-was-opened = true
     3940       .
     3941     end.
     3942   end.
     3943     run waitfram-hide in this-procedure .
     3944        END.
     3945        ELSE DO:
     3946             ASSIGN
     3947             frame Dialog-Frame:TITLE = title0 + chr(32) + entry (lookup (STRING(p-sts), '0,1,2,99,98':U), 'исп,не-исп,детализ,удаление,запр.удал':U)
     3948             filter-label = substitute("&1  с определенным статусом", filter-label0, entry (lookup (STRING(p-sts), '0,1,2,99,98':U), 'исп,не-исп,детализ,удаление,запр.удал':U))
     3949             .
     3950   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
