     2250     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2251     if p-change-value > 0
     2252     then do:
     2253       if frame Dialog-Frame :width + p-change-value >
     2254           session :width-chars
     2255       then do:
     2256         assign
     2257           p-change-value = session :width-chars - frame Dialog-Frame :width
     2258         .
     2259         if p-change-value <= 0
     2260         then do:
     2261           run diasize_position-resize-button in this-procedure .
     2262           return .
     2263         end.
     2264       end.
     2265     end.
     2266     if p-change-value < 0
     2267     then do:
     2268       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2269       then do:
     2270         assign
     2271           p-change-value = v-diasize-orig-frame-width
     2272                          - frame Dialog-Frame :width
     2273         .
     2274         if p-change-value >= 0
     2275         then do:
     2276           run diasize_position-resize-button in this-procedure .
     2277           return .
     2278         end.
     2279       end.
     2280     end.
     2281     if p-change-value >= 0
     2282     then do:
     2283       assign
     2284         v-change-sign = 1
     2285       .
     2286     end.
     2287     else do:
     2288       assign
     2289         v-change-sign = -1
     2290       .
     2291     end.
     2292     assign
     2293       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2294     .
     2295     if p-change-value = 0
     2296     then do:
     2297       run diasize_position-resize-button in this-procedure .
     2298       return .
     2299     end.
