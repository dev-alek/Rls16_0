      793   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      794   procedure fltfield-clear :
      795     define output parameter loc-fld as character no-undo.
      796     define output parameter loc-lab as character no-undo .
      797     define output parameter loc-spr as character no-undo .
      798     define output parameter loc-dim as character no-undo .
      799     assign
      800       loc-fld = ""
      801       loc-lab = ""
      802       loc-spr = ""
      803       loc-dim = "0"
      804     .
      805   end procedure .
      806   procedure fltfield-add :
      807     define input        parameter par-fld as character no-undo.
      808     define input        parameter par-lab as character no-undo .
      809     define input        parameter par-spr as character no-undo .
      810     define input-output parameter loc-fld as character no-undo.
      811     define input-output parameter loc-lab as character no-undo .
      812     define input-output parameter loc-spr as character no-undo .
      813     define input-output parameter loc-dim as character no-undo .
      814     do
      815     on error undo, return error
      816     :
      817       assign
      818       loc-fld = if loc-dim = '0'
      819                 then par-fld
      820                 else (loc-fld + chr(44) + par-fld)
      821       loc-lab = if loc-dim = '0'
      822                 then par-lab
      823                 else (loc-lab + chr(44) + par-lab)
      824       loc-spr = if loc-dim = '0'
      825                 then par-spr
      826                 else (loc-spr + chr(44) + par-spr)
      827       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      828                 string(integer(if num-entries(loc-dim) > 1
      829                               then entry(2, loc-dim)
      830                               else entry(1, loc-dim)
      831                               ) + 1)
      832       no-error
      833       .
      834     end.
      835   end procedure.
      836   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      837   procedure dr-code :
      838     do
      839     on error undo, return error
      840     :
      841       define input  parameter  p-templ-rl-root     like ub.dis-rule.templ-rl-root     no-undo .
      842       define output parameter  p-des               like ub.dis-rule.des               no-undo .
      843       define output parameter  p-discnt-type       like ub.dis-rule.discnt-type       no-undo .
      844       define output parameter  p-subject-type      like ub.dis-rule.subject-type      no-undo .
      845       define output parameter  p-value-type        like ub.dis-rule.value-type        no-undo .
      846       define output parameter  p-level-1           as character no-undo .
      847       define output parameter  p-level-2           as character no-undo .
      848       define output parameter  p-global             as integer no-undo .
      849       define output parameter  p-host               as integer no-undo .
      850       define output parameter  p-object             as integer no-undo .
      851       define output parameter  p-output-display as logical   no-undo .
      852       define output parameter  p-tree           as char  no-undo .
      853       define output parameter  p-other          as character no-undo .
      854       define variable v-other as character no-undo .
      855       define buffer buf_dis-rule for ub.dis-rule .
      856       define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      857       find first buf_dis-rule no-lock where
      858                 buf_dis-rule.rule-num = p-templ-rl-root no-error.
      859       find first buf_dis-cfg-rule no-lock where
      860               buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
      861           and buf_dis-cfg-rule.pos-type = '':U
      862           and buf_dis-cfg-rule.table-name = '':U
      863           and buf_dis-cfg-rule.discnt-role = '':U
      864           and buf_dis-cfg-rule.self-nonunique = '':U
      865               no-error.
      866       if not available buf_Dis-cfg-rule then do:
      867           undo, return error substitute("неизвестный шаблон скидки &1", p-templ-rl-root ).
      868       end.
      869       assign
      870       p-des = buf_dis-rule.des
      871       p-discnt-type = buf_dis-rule.discnt-type
      872       p-subject-type = buf_dis-rule.subject-type
      873       p-value-type = buf_dis-rule.value-type
      874       p-global = (if available buf_dis-cfg-rule
      875                   then buf_dis-cfg-rule.has-global
      876                   else 0)
      877       p-host = (if available buf_dis-cfg-rule
      878                 then buf_dis-cfg-rule.has-host
      879                 else 0)
      880       p-object = (if available buf_dis-cfg-rule
      881                 then buf_dis-cfg-rule.has-obj
      882                 else 0)
      883       p-output-display = (buf_dis-rule.sts = integer('0':U))
      884       p-tree = buf_Dis-rule.uniq-field
      885       p-other = buf_dis-rule.other-inf
      886       p-level-1 = entry(1, buf_dis-cfg-rule.other-inf, ";":U)
      887       p-level-2 = (if num-entries(buf_dis-cfg-rule.other-inf, ";":U) > 1
      888                    then entry(2, buf_dis-cfg-rule.other-inf, ";":U)
      889                    else '')
      890       .
      891     end.
      892   end procedure.
      893   define temp-table temp-drt-prop no-undo like ub.drt-prop.
      894   procedure disrules-fill-properties:
      895   define input  parameter p-templ-rl-root as integer   no-undo .
      896   define buffer buf_drt-prop for ub.drt-prop.
      897   define buffer buf_temp-drt-prop for temp-drt-prop.
      898   do
      899   on error undo, return error return-value
      900   :
      901     for each buf_temp-drt-prop:
      902       delete buf_temp-drt-prop.
      903     end.
      904     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
      905       create buf_temp-drt-prop.
      906       buffer-copy buf_drt-prop to buf_temp-drt-prop.
      907     end.
      908   end.
      909   end procedure.
      910   procedure disrules-get-interface-form :
      911   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
      912   define output parameter p-form-name as character no-undo .
      913   define buffer buf_temp-drt-prop for temp-drt-prop.
      914   define buffer buf_drt-prop for ub.drt-prop.
      915   find first buf_temp-drt-prop where
      916             buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
      917         and buf_temp-drt-prop.upper-prop-code = "InputForm"
      918         and buf_temp-drt-prop.prop-code = "FormName" no-error.
      919   if not available buf_temp-drt-prop then do:
      920     find first buf_drt-prop where
      921               buf_drt-prop.templ-rl-root = p-templ-rl-root
      922           and buf_drt-prop.upper-prop-code = "InputForm"
      923           and buf_drt-prop.prop-code = "FormName" no-error.
      924     if available buf_drt-prop then do:
      925       p-form-name = buf_drt-prop.property-value.
      926     end.
      927     else do:
      928       p-form-name = "ref/dis-ruli.w".
      929     end.
      930   end.
      931   else do:
      932     p-form-name = buf_temp-drt-prop.property-value.
      933   end.
      934   end procedure.
      935   ~
      936   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      937   procedure dtr-code :
      938     do
      939     on error undo, return error
      940     :
      941       define input  parameter  p-templ-rl-root     like ub.dis-time-rule.templ-rl-root     no-undo .
      942       define output parameter  p-des               like ub.dis-time-rule.des               no-undo .
      943       define output parameter  p-upper-time-rule-num    like ub.dis-time-rule.upper-time-rule-num    no-undo .
      944       define output parameter  p-value-type        like ub.dis-time-rule.value-type        no-undo .
      945       define output parameter  p-level-1 as character no-undo .
      946       define output parameter  p-level-2 as character no-undo .
      947       define output parameter  p-output-display as logical   no-undo .
      948       define output parameter  p-tree           as char  no-undo .
      949       define output parameter  p-other          as character no-undo .
      950       define variable v-templ-rl-root like ub.dis-time-rule.templ-rl-root no-undo .
      951       define buffer buf_dis-time-rule for ub.dis-time-rule .
      952       define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      953       if p-templ-rl-root < 50000 then
      954       v-templ-rl-root = (p-templ-rl-root + 50000).
      955       else v-templ-rl-root = p-templ-rl-root.
      956       find first buf_dis-time-rule no-lock where
      957                 buf_dis-time-rule.time-rule-num = v-templ-rl-root no-error .
      958       if not available buf_dis-time-rule then do:
      959         undo, return error substitute("неизвестный тип расписания &1", p-templ-rl-root) .
      960       end.
      961       find first buf_dis-cfg-rule no-lock where
      962               buf_dis-cfg-rule.templ-rl-root = 0
      963           and buf_dis-cfg-rule.time-templ-rl-root = p-templ-rl-root
      964           and buf_dis-cfg-rule.pos-type = '':U
      965           and buf_dis-cfg-rule.table-name = '':U
      966           and buf_dis-cfg-rule.discnt-role = '':U
      967           and buf_dis-cfg-rule.self-nonunique = '':U
      968               no-error.
      969       if not available buf_Dis-cfg-rule then do:
      970           undo, return error substitute("неизвестный тип расписания &1", p-templ-rl-root ).
      971       end.
      972       assign
      973       p-des = buf_dis-time-rule.des
      974       p-upper-time-rule-num = (buf_dis-time-rule.upper-time-rule-num - 50000)
      975       p-value-type = buf_dis-time-rule.value-type
      976       p-level-1 = entry(1, buf_dis-cfg-rule.other-inf, ";":U)
      977       p-level-2 = (if num-entries(buf_dis-cfg-rule.other-inf, ";":U) > 1
      978                    then entry(2, buf_dis-cfg-rule.other-inf, ";":U)
      979                    else '')
      980       p-output-display = (buf_dis-time-rule.sts = integer('0':U))
      981       p-tree = buf_dis-time-rule.uniq-field
      982       p-other = buf_dis-time-rule.other-inf
      983       .
      984     end.
      985   end procedure.
      986   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      987   FUNCTION gtregion RETURNS CHARACTER
      988     ( input parhost-code as integer
      989     , input parobj-type as character
      990     , input parobj-code as integer
      991     , input p-tab as logical
      992     ) :
      993     def var par-region as character no-undo.
      994     if parhost-code = 0 and
      995          parobj-type = "":U and
      996          parobj-code = 0 then do:
      997          par-region = "Глобально".
      998          return par-region.
      999       end.
     1000       if parobj-type = "" and
     1001          parobj-code = 0 then do:
     1002          par-region = if p-tab then fill(chr(32), 2) else "":U +
     1003                       "Фирма" + chr(32) + string(parhost-code).
     1004          return par-region.
     1005       end.
     1006       par-region = if p-tab then fill(chr(32), 4) else "":U +
     1007                    parobj-type + chr(32) + string(parobj-code).
     1008       return par-region.
     1009   END FUNCTION.
     1010   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
