     1259         VIEW-AS TEXT
     1260        SIZE 6 BY 1
     1261        FGCOLOR 4  NO-UNDO.
     1262   DEFINE VARIABLE v-des AS CHARACTER FORMAT "X(255)"
     1263         VIEW-AS TEXT
     1264        SIZE 98 BY .67
     1265        FGCOLOR 4  NO-UNDO.
