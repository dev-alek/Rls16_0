     5909   PROCEDURE proc-b-del :
     5910   define variable loc#log as logical no-undo.
     5911   define variable v-sts like ub.dis-time-rule.sts no-undo .
     5912   DEFINE VARIABLE loc-doc-rec AS RECID NO-UNDO.
     5913   define buffer loc_dis-time-rule for ub.dis-time-rule.
     5914   if not available X_dis-time-rule then return error.
     5915   do
     5916   on error undo, return error
     5917   on stop undo, return error
     5918   :
     5919   define variable vss-include-info58 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5920   do:
     5921     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     5922       (input  v-cntxt-db-num
     5923       ,input  v-cntxt-userid
     5924       ,input  0
     5925       ,input  'actn_discount_work':U
     5926       ,input  'global':U
     5927       ,input  0
     5928       ,input  '':U
     5929       ,input  0
     5930       ,input  0
     5931       ,input  0
     5932       ,input  0
     5933       ,input  true
     5934       ,output loc#log
     5935       )  .
     5936   end.
     5937   if not loc#log then return error.
     5938   loc#log = no.
     5939   message
     5940   "Вы действительно хотите удалить данное РАСПИСАНИЕ?"
     5941   view-as alert-box QUESTION buttons YEs-NO update loc#log.
     5942   if not loc#log then undo, return error .
     5943       find first loc_dis-time-rule exclusive-lock where
     5944                 recid(loc_dis-time-rule) = loc-doc-rec .
     5945       run ref/dis-tim3.p (
     5946                         buffer loc_dis-time-rule
     5947                       , input no
     5948                       , input no
     5949                       ) no-error.
     5950       if error-status:error then do:
     5951         message
     5952         "Ошибка при удалении РАСПИСАНИЯ" skip
     5953         error-status:get-message(1) skip
     5954         return-value
     5955         view-as alert-box error .
     5956         undo, return error .
     5957       end.
     5958     RUN OpenBr in this-procedure ( input YES, input NO, input NO).
     5959     REPOSITION br-dis-time-rule to recid loc-doc-rec No-error.
     5960     if error-status:error then do:                           find first pos_dis-time-rule no-lock where                                   recid(pos_dis-time-rule) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи РАСПИСАНИЕ" skip                            string(if avail pos_dis-time-rule                                     then  substitute("номер расписания: &1"                                                     , pos_dis-time-rule.time-rule-num)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     5961     if available X_dis-time-rule then do:
     5962       loc#log = br-dis-time-rule:select-focused-row( ) IN FRAME Dialog-Frame.
     5963     end.
     5964     apply "ENTRY" to br-dis-time-rule.
     5965   end.
     5966   END PROCEDURE.
     5967   PROCEDURE proc-b-print :
     5968   define variable v-doc-rec as recid no-undo .
     5969   define variable accum-count as integer.
     5970   define variable date_string     as      char    no-undo.
     5971   define variable Line            as      char    no-undo.
     5972   DEFINE VARIABLE v-sts-chr AS CHARACTER NO-UNDO.
     5973   define variable v-value-type as character no-undo .
     5974   define variable v-mark as character no-undo .
     5975   DEFINE FRAME dis-time-rule-list
     5976   X_dis-time-rule.des FORMAT "X(65)"
     5977   v-sts-chr FORMAT "X(8)" COLUMN-LABEL "Статус"
     5978   v-display-time-from COLUMN-LABEL "Время!нач." FORMAT "X(5)":U
     5979   v-display-time-to COLUMN-LABEL "Время!конца" FORMAT "X(5)":U
     5980   v-display-date-from COLUMN-LABEL "Дата нач." FORMAT "X(10)":U
     5981   v-display-date-to COLUMN-LABEL "Дата!конца" FORMAT "X(10)":U
     5982   v-display-week-day-0 COLUMN-LABEL "ДН" FORMAT "X(1)":U
     5983   v-display-week-day-1 COLUMN-LABEL "Пн" FORMAT "X(3)":U
     5984   v-display-week-day-2 COLUMN-LABEL "Вт" FORMAT "X(3)":U
     5985   v-display-week-day-3 COLUMN-LABEL "Ср" FORMAT "X(3)":U
     5986   v-display-week-day-4 COLUMN-LABEL "Чт" FORMAT "X(3)":U
     5987   v-display-week-day-5 COLUMN-LABEL "Птн" FORMAT "X(3)":U
     5988   v-display-week-day-6 COLUMN-LABEL "Сб" FORMAT "X(3)":U
     5989   v-display-week-day-7 COLUMN-LABEL "Вс" FORMAT "X(3)":U
     5990   v-display-month-day COLUMN-LABEL "ДМ" FORMAT "X(2)":U
     5991   v-value-type        COLUMN-LABEL "Тип расп-ния" FORMAT "X(20)":U
     5992   X_dis-time-rule.time-rule-num COLUMN-LABEL "Номер!расп-ния"
     5993   HEADER  date_string AT 5 format "X(35)"
     5994    string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     5995   Line format "X(195)" AT 1
     5996   with width 232 down stream-io use-text    .
     5997   Line = fill("-", 195).
     5998   date_string = cur-time-print() .
     5999   run prn-lib-open-stream  in this-procedure (
     6000                                                input parParentProc
     6001                                               ,input 43
     6002                                               ,input yes
     6003                                               ,input no
     6004                                               ).
     6005   PUT  STREAM PrnLibStream
     6006   SPACE(25) ( frame Dialog-Frame:title )
     6007   format "x(90)" SKIP(1) .
     6008   FORM HEADER
     6009   Line format "X(195)" AT 1 SKIP
     6010   "Продолжение - на следующей странице" AT 30 SKIP
     6011   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     6012   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     6013   FORM with FRAME dis-time-rule-list  .
     6014   run waitfram-show in this-procedure (  input "Ждите...").
     6015   v-doc-rec = recid(X_dis-time-rule).
     6016   DO WHILE available X_dis-time-rule :
     6017     GET prev br-dis-time-rule.
     6018   END.
     6019   GET next br-dis-time-rule.
     6020   DO WHILE available X_dis-time-rule :
     6021     assign
     6022     v-sts-chr = entry (lookup (string(X_dis-time-rule.sts), '0,1,2,99,98':U), 'исп,не-исп,детализ,удаление,запр.удал':U)
     6023     v-value-type = time-v-name(buffer X_dis-time-rule)
     6024     v-mark = mark-string(buffer X_dis-time-rule, v-rid-list)
     6025     .
     6026     Display STREAM PrnLibStream
     6027     X_dis-time-rule.des
     6028     entry (lookup (string(X_dis-time-rule.sts), '0,1,2,99,98':U), 'исп,не-исп,детализ,удаление,запр.удал':U) @ v-sts-chr
     6029     v-display-time-from
     6030     v-display-time-to
     6031     v-display-date-from
     6032     v-display-date-to
     6033     v-display-week-day-0
     6034     v-display-week-day-1
     6035     v-display-week-day-2
     6036     v-display-week-day-3
     6037     v-display-week-day-4
     6038     v-display-week-day-5
     6039     v-display-week-day-6
     6040     v-display-week-day-7
     6041     v-display-month-day
     6042     v-value-type
     6043     X_dis-time-rule.time-rule-num
     6044     with FRAME dis-time-rule-list .
     6045     DOWN STREAM PrnLibStream 1
     6046     with FRAME dis-time-rule-list  .
     6047     assign
     6048     accum-count = accum-count + 1
     6049     .
     6050     GET next br-dis-time-rule.
     6051   END.
     6052   UNDERLINE  STREAM PrnLibStream
     6053   X_dis-time-rule.des
     6054   v-sts-chr
     6055   v-display-time-from
     6056   v-display-time-to
     6057   v-display-date-from
     6058   v-display-date-to
     6059   v-display-week-day-0
     6060   v-display-week-day-1
     6061   v-display-week-day-2
     6062   v-display-week-day-3
     6063   v-display-week-day-4
     6064   v-display-week-day-5
     6065   v-display-week-day-6
     6066   v-display-week-day-7
     6067   v-display-month-day
     6068   v-value-type
     6069   X_dis-time-rule.time-rule-num
     6070   with FRAME dis-time-rule-list .
     6071   DISPLAY STREAM PrnLibStream
     6072   "ИТОГО" @ X_dis-time-rule.des
     6073   accum-count @ v-sts-chr
     6074   with frame dis-time-rule-list.
     6075   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     6076   HIDE  STREAM PrnLibStream FRAME dis-time-rule-List.
     6077   output  STREAM PrnLibStream CLOSE.
     6078   REPOSITION br-dis-time-rule to recid v-doc-rec no-error.
     6079   APPLY "entry" to br-dis-time-rule.
     6080   run waitfram-hide in this-procedure .
     6081   run prn-lib-prn-file in this-procedure (
     6082                                             input parParentProc
     6083                                             ,input 8
     6084                                             ).
     6085   END PROCEDURE.
     6086   PROCEDURE proc-b-sch :
     6087   assign
     6088     tbl = 'dis-time-rule'
     6089     join-tbl = 'X_dis-time-rule'
     6090     fld = ""
     6091     lab = ""
     6092     spr = ""
     6093     dim = '0'
     6094     .
     6095   run fltfield-add in this-procedure('des', 'Описание расписания', '',
     6096   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6097   if p-mode <> "template" and p-upper-time-rule-num <> 0 and p-mode <> "upper-time-rule-num" then do:
     6098     run fltfield-add in this-procedure('templ-rl-root', 'Номер типа(шаблона) расписания', '',
     6099     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     6100   end.
     6101   Filter-Block:
     6102   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     6103       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     6104       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     6105     run gbl/filter.w ( INPUT parparentproc
     6106                       ,INPUT (filter-point + chr(4) + filter-label)
     6107                       ,INPUT tbl
     6108                       ,INPUT join-tbl
     6109                       ,INPUT fld
     6110                       ,INPUT lab
     6111                       ,INPUT spr
     6112                       ,INPUT dim ).
     6113     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     6114   END.
     6115   END PROCEDURE.
     6116   PROCEDURE proc-b-stat :
     6117   define input parameter p-doc-rec as recid no-undo .
     6118   define variable v-sts like ub.dis-time-rule.sts no-undo .
     6119   define buffer loc_dis-time-rule for ub.dis-rule.
     6120   do
     6121   on error undo, return error
     6122   :
     6123     find first loc_dis-time-rule exclusive-lock where
     6124               recid(loc_Dis-time-rule) = p-doc-rec .
     6125     v-sts = ?.
     6126     run ref/dis-tim2.p (
     6127                       buffer loc_dis-time-rule
     6128                     , input no
     6129                     , input-output v-sts
     6130                     ) no-error.
     6131   end.
     6132   END PROCEDURE.
     6133   PROCEDURE proc-br-dis-time-rule :
     6134   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6135   if b-sel:sensitive in frame Dialog-Frame then dO:
     6136       if b-mark:sensitive then do:
     6137           apply "choose" to b-mark in frame Dialog-Frame.
     6138       end.
     6139       else do:
     6140           apply "choose" to b-sel in frame Dialog-Frame.
     6141       end.
     6142   end.
     6143   else do:
     6144       if b-lookup:sensitive then
     6145       apply "choose" to b-lookup in frame Dialog-Frame.
     6146   end.
     6147   END PROCEDURE.
     6148   FUNCTION mark-string RETURNS CHARACTER
     6149     ( BUFFER loc-dis-time-rule FOR ub.dis-time-rule, input mark-list as CHARACTER ) :
     6150     RUN get-tree IN THIS-PROCEDURE(
     6151            BUFFER loc-dis-time-rule
     6152           ,output v-display-time-from
     6153           ,OUTPUT v-display-time-to
     6154           ,output v-display-date-from
     6155           ,OUTPUT v-display-date-to
     6156           ,OUTPUT v-display-week-day-0
     6157           ,OUTPUT v-display-week-day-1
     6158           ,OUTPUT v-display-week-day-2
     6159           ,OUTPUT v-display-week-day-3
     6160           ,OUTPUT v-display-week-day-4
     6161           ,OUTPUT v-display-week-day-5
     6162           ,OUTPUT v-display-week-day-6
     6163           ,OUTPUT v-display-week-day-7
     6164           ,OUTPUT v-display-month-day
     6165           ,output v-using-fields
     6166       ).
     6167   RETURN ( IF LOOKUP( STRING( RECID( loc-dis-time-rule ) ), mark-list ) > 0 THEN "*" ELSE "":U ).
     6168   END FUNCTION.
     6169   FUNCTION time-v-name RETURNS CHARACTER
     6170     ( BUFFER loc_dis-time-rule FOR ub.dis-time-rule ) :
     6171   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     6172   DEFINE VARIABLE v-str AS CHARACTER NO-UNDO.
     6173   DO ii = 1 TO NUM-ENTRIES(loc_dis-time-rule.value-type):
     6174      ASSIGN
     6175      v-str = v-str + (IF v-str = "":U THEN "":U ELSE chr(44)) +
     6176                      entry (lookup (ENTRY(ii, loc_dis-time-rule.value-type), '0,1,2,4,8,16':U), '?,Период времени,Период дат,День недели,Дата,День месяца':U) NO-ERROR.
     6177   END.
     6178   RETURN v-str.
     6179   END FUNCTION.
