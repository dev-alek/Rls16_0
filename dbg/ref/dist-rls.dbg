     3154   define variable vss-include-info32 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3155   on ALT-F8 of frame Dialog-Frame anywhere do:
     3156     if b-history :sensitive then DO: apply "CHOOSE":U to b-history in frame Dialog-Frame. END.
     3157     return no-apply.
     3158   end.
     3159   on f6 anywhere do:
     3160   define buffer buf0_dis-time-rule for ub.dis-time-rule.
     3161   find first buf0_dis-time-rule no-lock where
     3162           buf0_dis-time-rule.time-rule-num = 0 + 50000 no-error .
     3163   if available buf0_dis-time-rule then do:
     3164     message
     3165     "Версия структуры расписаний" buf0_dis-time-rule.des
     3166     view-as alert-box .
     3167   end.
     3168   else do:
     3169     message
     3170     "Не найдена головная запись структуры расписаний!"
     3171     view-as alert-box error .
     3172   end.
     3173   end.
