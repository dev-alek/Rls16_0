     1192   define variable filter-label as character no-undo init "Список расписаний" .
     1193   define variable filter-label0 as character no-undo init "Список расписаний" .
     1194   DEFINE variable v-display-time-from AS CHARACTER NO-UNDO.
     1195   DEFINE variable v-display-time-to AS CHARACTER NO-UNDO.
     1196   DEFINE variable v-display-date-from AS CHARACTER NO-UNDO.
     1197   DEFINE variable v-display-date-to AS CHARACTER NO-UNDO.
     1198   DEFINE variable v-display-week-day-0 AS CHARACTER NO-UNDO.
     1199   DEFINE variable v-display-week-day-1 AS CHARACTER NO-UNDO.
     1200   DEFINE variable v-display-week-day-2 AS CHARACTER NO-UNDO.
