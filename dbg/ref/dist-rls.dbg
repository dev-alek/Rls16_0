     1228        SIZE 10 BY 1.
     1229   DEFINE BUTTON B-Help
     1230        LABEL "Помо&щь"
     1231        SIZE 3 BY 1
     1232        BGCOLOR 8 .
     1233   DEFINE BUTTON b-history
     1234        LABEL "Ис&тория"
     1235        SIZE 3 BY 1.
     1236   DEFINE BUTTON B-lookup
     1237        LABEL "&Просмотр"
     1238        SIZE 10 BY 1.
     1239   DEFINE BUTTON B-mark
     1240        LABEL "&*"
     1241        SIZE 3 BY 1.
     1242   DEFINE BUTTON B-print
     1243        LABEL "Пе&чать"
     1244        SIZE 3 BY 1.
