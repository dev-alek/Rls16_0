     5751             if (" TRUE " + " " + where-phrase-57) <> ""
     5752             then " TRUE " + " " + where-phrase-57
     5753             else "true"
     5754           )
     5755         parameter-5-57 = (" " + "" + " " + ", first tt-template_dis-time-rule no-lock where tt-template_dis-time-rule.templ-rl-root = X_dis-time-rule.templ-rl-root  AND X_dis-time-rule.time-rule-num = tt-template_dis-time-rule.time-rule-num")
     5756         parameter-6-57 = if sort-phrase-57 = ''
     5757                              then
     5758           (
     5759           " " + "  " +
     5760             " " + sort-column-phrase +
     5761           " " + "  "
     5762           )
     5763                              else
     5764           (
     5765           " " + "  " +
     5766             " " + sort-column-phrase +
     5767           " " + sort-phrase-57
     5768           )
     5769         parameter-7-57 =
     5770           " indexed-reposition  "
     5771       .
     5772       do
     5773       on stop undo, leave
     5774       on error undo, leave
     5775       :
     5776         assign
     5777           l-disable-where-57 =
     5778             (" TRUE " + " " + where-phrase-57 = "")
     5779         .
     5780         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     5781                             ,input QUERY br-dis-time-rule:handle
     5782                             ,input parameter-3-57
     5783                             ,input parameter-4-57
     5784                             ,input parameter-5-57
     5785                             ,input parameter-6-57
     5786                             ,input parameter-7-57
     5787                             )
     5788         .
     5789         assign
     5790           l-filter-open-57 = true
     5791         .
     5792       end.
     5793       if l-filter-open-57 = false then do:
     5794         message
     5795           "Ошибка при фильтрации / сортировке" skip
     5796           "Будут показаны записи без учета фильтра" skip
     5797           view-as alert-box .
     5798       end.
     5799       else do:
     5800           assign
     5801             l-query-was-opened = true
     5802           .
     5803       end.
     5804     end.
     5805     if l-filter-open-57 = false then do:
     5806       OPEN QUERY br-dis-time-rule FOR EACH X_dis-time-rule no-lock
     5807         where  TRUE
     5808       , first tt-template_dis-time-rule no-lock where tt-template_dis-time-rule.templ-rl-root = X_dis-time-rule.templ-rl-root  AND X_dis-time-rule.time-rule-num = tt-template_dis-time-rule.time-rule-num
     5809         indexed-reposition
     5810     .
     5811         assign
     5812           l-query-was-opened = true
     5813         .
     5814     end.
     5815   end.
     5816   else do:
     5817     assign
