     2238   procedure diasize_change-width :
     2239     define input  parameter p-change-value as decimal   no-undo .
     2240     define input  parameter p-move-resize  as logical   no-undo .
     2241     define variable v-field-group-handle   as handle    no-undo .
     2242     define variable v-object-handle        as handle    no-undo .
