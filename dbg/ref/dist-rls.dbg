     1535                  input parParentProc
     1536                 ,input "b-add":U
     1537                 ,input "upper-time-rule-num":U
     1538                 ,input 0
     1539                 ,input X_dis-time-rule.time-rule-num
     1540                 ,input p-pos-type
     1541                 ,input-output v-sts
