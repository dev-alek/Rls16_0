     1293         v-display-week-day-3 COLUMN-LABEL "Ср" FORMAT "X(3)":U
     1294         v-display-week-day-4 COLUMN-LABEL "Чт" FORMAT "X(3)":U
     1295         v-display-week-day-5 COLUMN-LABEL "Птн" FORMAT "X(3)":U
     1296         v-display-week-day-6 COLUMN-LABEL "Сб" FORMAT "X(3)":U
     1297         v-display-week-day-7 COLUMN-LABEL "Вс" FORMAT "X(3)":U
     1298         v-display-month-day COLUMN-LABEL "ДМ" FORMAT "X(2)":U
     1299         time-v-name(buffer X_dis-time-rule) COLUMN-LABEL "Тип расп-ния" FORMAT "X(16)":U
     1300         X_dis-time-rule.time-rule-num COLUMN-LABEL "№ расп-ния" FORMAT ">>>>>>>>9":U
     1301       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 16.
     1302   DEFINE FRAME Dialog-Frame
     1303        b-quit AT ROW 1 COL 1
     1304        B-mark AT ROW 1 COL 11
     1305        B-sel AT ROW 1 COL 21
     1306        B-add AT ROW 1 COL 31
     1307        B-lookup AT ROW 1 COL 41
     1308        B-chg AT ROW 1 COL 51
     1309        B-del AT ROW 1 COL 61
     1310        B-stat AT ROW 1 COL 71
     1311        B-print AT ROW 1 COL 86
     1312        b-history AT ROW 1 COL 89
     1313        B-sch AT ROW 1 COL 92
     1314        B-Help AT ROW 1 COL 95
     1315        B-dis-time-rules AT ROW 2 COL 51
     1316        B-dis-rule AT ROW 2 COL 61
     1317        RS-sts AT ROW 3.5 COL 3.5 NO-LABEL
     1318        br-dis-time-rule AT ROW 5 COL 1
     1319        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1320        v-des AT ROW 21.38 COL 1 NO-LABEL
     1321        SPACE(0.12) SKIP(0.00)
     1322       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1323            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1324            TITLE "Расписания скидок".
     1325   ASSIGN
     1326          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1327          FRAME Dialog-Frame:HIDDEN           = TRUE.
