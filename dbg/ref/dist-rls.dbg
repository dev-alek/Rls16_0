     5875                             input this-procedure:handle
     5876                             ,input QUERY br-dis-time-rule:handle
     5877                             ,input logical(parameter-2-57)
     5878                             ,input no-lock
     5879                             ,input parameter-3-57
     5880                             ,input parameter-4-57
     5881                             ,input parameter-5-57
     5882                             ,input parameter-6-57
     5883                             ,input parameter-7-57
     5884                             ,output v-fltopend-rowid
     5885                             ) no-error.
     5886         .
