     5651         parameter-2-55 = (if p-find-next then "true":u else "false":u )
     5652         parameter-3-55 =  "FOR EACH X_dis-time-rule no-lock"
     5653         parameter-4-55 =
     5654           (
     5655             if (" X_dis-time-rule.sts = p-sts " + " " + where-phrase-55) <> ""
     5656             then  substitute('X_dis-time-rule.sts = &1', p-sts)  + " " + where-phrase-55
     5657             else "true"
     5658           )
     5659         parameter-5-55 = (" " + "" + " " + ", first tt-template_dis-time-rule no-lock where tt-template_dis-time-rule.time-rule-num = X_dis-time-rule.templ-rl-root" + " " + p-find-condition)
     5660         parameter-6-55 = if sort-phrase-55 = ''
     5661                              then
     5662           (
     5663           " " + "  " +
     5664             " " + sort-column-phrase +
     5665           " " + "  "
     5666           )
     5667                              else
     5668           (
     5669           " " + "  " +
     5670             " " + sort-column-phrase +
     5671           " " + sort-phrase-55
     5672           )
     5673         parameter-7-55 =
     5674           " indexed-reposition  "
     5675       .
     5676         run fltopend_fltfindq in this-procedure  (
     5677                             input this-procedure:handle
     5678                             ,input QUERY br-dis-time-rule:handle
     5679                             ,input logical(parameter-2-55)
     5680                             ,input no-lock
     5681                             ,input parameter-3-55
     5682                             ,input parameter-4-55
     5683                             ,input parameter-5-55
     5684                             ,input parameter-6-55
     5685                             ,input parameter-7-55
     5686                             ,output v-fltopend-rowid
     5687                             ) no-error.
     5688         .
     5689         v-doc-rec = ?.
     5690       end.
     5691       assign
     5692         l-query-was-opened = true
     5693       .
     5694     end.
     5695   end.
     5696     run waitfram-hide in this-procedure .
     5697        END.
     5698      end.
     5699       when "rule-num":U then do:
     5700          filter-point = filter-point0 + p-mode.
     5701           ASSIGN
     5702           frame Dialog-Frame:TITLE =  substitute(" Расписания в детализации правил скидки №&1 &2"
     5703                                                   , X_dis-rule.rule-num
