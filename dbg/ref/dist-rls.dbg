     5888       end.
     5889       assign
     5890         l-query-was-opened = true
     5891       .
     5892     end.
     5893   end.
     5894     run waitfram-hide in this-procedure .
     5895          END.
     5896      end.
     5897   END CASE.
     5898   if not p-open-query then
     5899   REPOSITION br-dis-time-rule to recid v-doc-rec No-ERROR.
     5900   if not p-open-query and v-fltopend-rowid[1] <> ? then
     5901   query br-dis-time-rule:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     5902   if error-status:error then do:
     5903     REPOSITION br-dis-time-rule to row 1 No-ERROR.
     5904   end.
