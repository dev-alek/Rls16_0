     1020   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1021   procedure fltopend_fltopend :
     1022   define input parameter p-parent-handle as handle no-undo .
     1023   define input parameter p-qh as handle no-undo .
     1024   define input parameter p-flt-open-open-query  as character no-undo .
     1025   define input parameter p-where-cond as character no-undo .
     1026   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1027   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1028   define input parameter p-indexed-reposition as character no-undo .
     1029     do
     1030     on error undo, return error
     1031     :
     1032   define variable v-prepare-string as character no-undo .
     1033   define variable glog as logical no-undo .
     1034   assign
     1035   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1036                      p-where-cond + chr(32)  +
     1037                      p-use-indFIRST-query-tail + chr(32) +
     1038                      p-use-ind-sort-clmn-by + chr(32) +
     1039                      p-indexed-reposition
     1040   .
     1041   assign
     1042   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1043   if not glog
     1044   or error-status:error then do:
     1045     message error-status:get-message(1) view-as alert-box .
     1046     undo, return error .
     1047   end.
     1048   assign
     1049   glog = p-qh:query-open no-error .
     1050   if not glog
     1051   or error-status:error then do:
     1052     message error-status:get-message(1) view-as alert-box .
     1053     undo, return error .
     1054   end.
     1055     end.
     1056   end procedure.
     1057   procedure fltopend_fltfindd :
     1058   define input parameter p-parent-handle as handle no-undo .
     1059   define input parameter p-qh as handle no-undo .
     1060   define input parameter p-rowid as rowid no-undo .
     1061   define input parameter p-next as logical no-undo .
     1062   define input parameter p-lock as integer no-undo .
     1063   define input parameter p-bh as handle no-undo .
     1064   define input parameter p-where-cond as character no-undo .
     1065   define input parameter p-use-index-phrase as character no-undo .
     1066   define variable glog as logical no-undo .
     1067   define variable v-qh as handle no-undo .
     1068   define variable v-bh as handle no-undo .
     1069   define variable v-recid as recid no-undo .
     1070   define variable v-prepare-string as character no-undo .
     1071   do
     1072   on error undo, return error
     1073   on stop undo, return error
     1074   :
     1075     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1076     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1077     create query v-qh.
     1078     v-qh:set-buffers(v-bh).
     1079     v-prepare-string = substitute("for each &1 &2 &3"
     1080                                     ,v-bh:name
     1081                                     ,p-where-cond
     1082                                     ,p-use-index-phrase).
     1083     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1084     if not glog then do:
     1085       delete object v-qh.
     1086       delete object v-bh.
     1087       undo, return error .
     1088     end.
     1089     glog = v-qh:query-open no-error .
     1090     if not glog then do:
     1091       delete object v-qh.
     1092       delete object v-bh.
     1093       undo, return error .
     1094     end.
     1095     if p-next then do:
     1096       v-qh:reposition-to-rowid(p-rowid) no-error .
     1097       glog = v-qh:get-next( p-lock) no-error .
     1098       glog = v-qh:get-next( p-lock) no-error .
     1099       if not glog or v-qh:query-off-end = yes then do:
     1100         glog = v-qh:get-first( p-lock) no-error .
     1101       end.
     1102     end.
     1103     else do:
     1104       glog = v-qh:get-first( p-lock) no-error .
     1105     end.
     1106     v-recid = v-bh:recid no-error .
     1107     delete object v-qh.
     1108     delete object v-bh.
     1109     return string(v-recid) .
     1110   end.
     1111   end procedure.
     1112   procedure fltopend_fltfindq :
     1113   define input parameter p-parent-handle as handle no-undo .
     1114   define input parameter p-qh as handle no-undo .
     1115   define input parameter p-next as logical no-undo .
     1116   define input parameter p-lock as integer no-undo .
     1117   define input parameter p-flt-open-open-query  as character no-undo .
     1118   define input parameter p-where-cond as character no-undo .
     1119   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1120   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1121   define input parameter p-indexed-reposition as character no-undo .
     1122   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1123   define variable glog as logical no-undo .
     1124   define variable v-qh as handle no-undo .
     1125   define variable v-bh as handle no-undo extent 18.
     1126   define variable v-rowid as rowid no-undo extent 18.
     1127   define variable v-ii as integer no-undo .
     1128   define variable v-prepare-string as character no-undo .
     1129   do
     1130   on error undo, return error
     1131   on stop undo, return error
     1132   :
     1133     create query v-qh.
     1134     do v-ii = 1 to p-qh:num-buffers:
     1135       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1136       assign
     1137       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1138       no-error.
     1139       v-qh:add-buffer(v-bh[v-ii]).
     1140     end.
     1141     assign
     1142     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1143                       p-where-cond + chr(32)  +
     1144                       p-use-indFIRST-query-tail + chr(32) +
     1145                       p-use-ind-sort-clmn-by + chr(32) +
     1146                       p-indexed-reposition
     1147     .
     1148     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1149     if not glog then do:
     1150       delete object v-qh.
     1151       do v-ii = 1 to p-qh:num-buffers:
     1152         delete object v-bh[v-ii].
     1153       end.
     1154       undo, return error .
     1155     end.
     1156     glog = v-qh:query-open no-error .
     1157     if not glog then do:
     1158       delete object v-qh.
     1159       do v-ii = 1 to p-qh:num-buffers:
     1160         delete object v-bh[v-ii].
     1161       end.
     1162       undo, return error .
     1163     end.
     1164     if p-next then do:
     1165       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1166       glog = v-qh:get-next( p-lock) no-error .
     1167       glog = v-qh:get-next( p-lock) no-error .
     1168       if not glog or v-qh:query-off-end = yes then do:
     1169         glog = v-qh:get-first( p-lock) no-error .
     1170       end.
     1171     end.
     1172     else do:
     1173       glog = v-qh:get-first( p-lock) no-error .
     1174     end.
     1175     do v-ii = 1 to p-qh:num-buffers:
     1176       assign
     1177       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1178       no-error.
     1179     end.
     1180     delete object v-qh.
     1181     do v-ii = 1 to p-qh:num-buffers:
     1182       delete object v-bh[v-ii].
     1183     end.
     1184   end.
     1185   end procedure.
     1186   define variable v-rid-list as character no-undo .
     1187   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
     1188   define variable sort-column-name as character no-undo .
     1189   define variable v-db-num LIKE ub.db.db-num no-undo.
