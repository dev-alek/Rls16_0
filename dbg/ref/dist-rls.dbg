     5726     ,output sort-phrase-57
     5727     ,output where-phrase-rus-57
     5728     ,output sort-phrase-rus-57
     5729     ).
     5730   if p-open-query then do:
     5731       run set-filter-name in this-procedure
     5732         (INPUT filter-name-57
     5733         ) no-error .
     5734     assign
     5735       l-filter-open-57 = false
     5736     .
     5737     if flt-rec-57 <> ?
     5738       or sort-column-phrase > ""
     5739     then do:
     5740       define variable  parameter-2-57 as character no-undo .
     5741       define variable  parameter-3-57 as character no-undo .
     5742       define variable  parameter-4-57 as character no-undo .
     5743       define variable  parameter-5-57 as character no-undo .
     5744       define variable  parameter-6-57 as character no-undo .
     5745       define variable  parameter-7-57 as character no-undo .
