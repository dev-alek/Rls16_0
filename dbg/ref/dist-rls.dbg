     2055                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2056                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2057               .
     2058             end.
     2059           end.
     2060           assign
     2061             v-object-handle = v-object-handle :next-sibling
     2062           .
     2063         end.
     2064         assign
