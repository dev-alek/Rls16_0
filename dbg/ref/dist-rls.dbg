     2625   procedure diasize_position-resize-button :
     2626     do with frame Dialog-Frame
     2627     :
     2628       hide v-diasize-resize-button .
     2629       assign
     2630         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2631                     - 1
     2632                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2633         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2634                     - 1
     2635                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2636       .
     2637       view v-diasize-resize-button .
     2638     end.
     2639   end procedure.
     2640   on alt-right anywhere
     2641   do:
     2642     run diasize_change-width in this-procedure
     2643       (input 1
     2644       ,input true
     2645       ) .
     2646     return no-apply .
     2647   end.
     2648   on alt-left anywhere
     2649   do:
     2650     run diasize_change-width in this-procedure
     2651       (input -1
     2652       ,input true
     2653       ) .
     2654     return no-apply .
     2655   end.
     2656   on alt-down anywhere
     2657   do:
     2658     run diasize_change-height in this-procedure
     2659       (input 1
     2660       ,input true
     2661       ) .
     2662     return no-apply .
     2663   end.
     2664   on alt-up anywhere
     2665   do:
     2666     run diasize_change-height in this-procedure
     2667       (input -1
     2668       ,input true
     2669       ) .
     2670     return no-apply .
     2671   end.
     2672   on alt-enter of frame Dialog-Frame
     2673   do:
     2674     run diasize_maximize in this-procedure
     2675       (input  ?
     2676       ).
     2677     return no-apply .
     2678   end.
     2679   procedure diasize_end-move :
     2680     do
     2681     on error undo, return error return-value
     2682     :
     2683       define variable v-row-delta as decimal   no-undo .
     2684       define variable v-col-delta as decimal   no-undo .
     2685       define variable v-new-row as decimal   no-undo .
     2686       define variable v-new-col as decimal   no-undo .
     2687       assign
     2688         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2689         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2690       .
     2691       assign
     2692         v-row-delta = v-new-row - frame Dialog-Frame :height
     2693         v-col-delta = v-new-col - frame Dialog-Frame :width
     2694       .
     2695       run diasize_change-height in this-procedure
     2696         (input v-row-delta
     2697         ,input true
     2698         ) .
     2699       run diasize_change-width in this-procedure
     2700         (input v-col-delta
     2701         ,input true
     2702         ) .
     2703     end.
     2704   end procedure.
     2705   procedure diasize_maximize :
     2706     define input  parameter p-action as logical   no-undo .
     2707     do
     2708     on error undo, return error return-value
     2709     :
     2710       if p-action = ?
     2711       then do:
     2712         if v-diasize-need-maximize = true
     2713         then do:
     2714           assign
     2715             p-action = true
     2716           .
     2717         end.
     2718         else do:
     2719           assign
     2720             p-action = false
     2721           .
     2722         end.
     2723       end.
     2724       if p-action = true
     2725       then do:
     2726         run diasize_change-height in this-procedure
     2727           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2728               - frame Dialog-Frame :height-chars
     2729           ,input true
     2730           ) .
     2731         run diasize_change-width in this-procedure
     2732           (input session :width-chars
     2733               - frame Dialog-Frame :width-chars
     2734           ,input true
     2735           ) .
     2736         assign
     2737           v-diasize-need-maximize = false
     2738         .
     2739       end.
     2740       else do:
     2741         run diasize_change-width in this-procedure
     2742           (input v-diasize-orig-frame-width
     2743               - frame Dialog-Frame :width-chars
     2744           ,input true
     2745           ) .
     2746         run diasize_change-height in this-procedure
     2747           (input v-diasize-orig-frame-height
     2748               - frame Dialog-Frame :height-chars
     2749           ,input true
     2750           ) .
     2751         assign
     2752           v-diasize-need-maximize = true
     2753         .
     2754       end.
     2755     end.
     2756   end procedure.
     2757   procedure diasize_restore-orig-size :
     2758     do
     2759     on error undo, return error return-value
     2760     :
     2761       assign
     2762         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2763         v-diasize-current-frame-height = frame Dialog-Frame :height
     2764       .
     2765       run diasize_set-height in this-procedure
     2766         (input  v-diasize-orig-frame-height
     2767         ,input  true
     2768         ) .
     2769       run diasize_set-width in this-procedure
     2770         (input  v-diasize-orig-frame-width
     2771         ,input  true
     2772         ) .
     2773     end.
     2774   end procedure.
     2775   procedure diasize_restore-current-size :
     2776     do
     2777     on error undo, return error return-value
     2778     :
     2779       run diasize_set-height in this-procedure
     2780         (input  v-diasize-current-frame-height
     2781         ,input  true
     2782         ) .
     2783       run diasize_set-width in this-procedure
     2784         (input  v-diasize-current-frame-width
     2785         ,input  true
     2786         ) .
     2787     end.
     2788   end procedure.
     2789   procedure diasize_set-browse-handle :
     2790     define input  parameter p-browse-handle as handle   no-undo .
     2791     define buffer buf_temp-browse-handle for temp-browse-handle .
     2792     do
     2793     on error undo, return error return-value
     2794     :
     2795       assign
     2796         v-diasize-browse-handle = p-browse-handle
     2797       .
     2798       for each buf_temp-browse-handle
     2799       on error undo, return error return-value
     2800       :
     2801         delete buf_temp-browse-handle .
     2802       end.
     2803     end.
     2804   end procedure.
     2805   procedure diasize_add_browse :
     2806     define input  parameter p-browse-type   as character no-undo .
     2807     define input  parameter p-browse-handle as handle    no-undo .
     2808     define buffer buf_temp-browse-handle for temp-browse-handle .
     2809     do
     2810     on error undo, return error return-value
     2811     :
     2812       assign
     2813         v-diasize-browse-number = v-diasize-browse-number + 1
     2814       .
     2815       create buf_temp-browse-handle .
     2816       assign
     2817         buf_temp-browse-handle.browse-type   = p-browse-type
     2818         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2819         buf_temp-browse-handle.browse-handle = p-browse-handle
     2820       .
     2821     end.
     2822   end procedure.
     2823   procedure diasize_init :
     2824     define variable v-default-value    as logical   no-undo .
     2825     define variable v-restore-saved    as logical   no-undo .
     2826     define variable v-resize-value-str as character no-undo .
     2827     do
     2828     on error undo, return error return-value
     2829     :
     2830       do with frame Dialog-Frame
     2831       :
     2832         assign
     2833           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2834           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2835           v-diasize-browse-handle     = browse br-dis-time-rule :handle
     2836         .
     2837         create button v-diasize-resize-button
     2838         assign
     2839           parent        = frame Dialog-Frame :first-child
     2840           label         = "s"
     2841           height-pixels = 16
     2842           width-pixels  = 16
     2843           visible       = true
     2844           sensitive     = true
     2845           movable       = true
     2846           triggers:
     2847             on end-move persistent run diasize_end-move in this-procedure .
     2848           end triggers.
     2849         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2850         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2851         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2852         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2853         assign
     2854           v-diasize-wndmax = false
     2855         .
     2856         if connected("ub") = true
     2857         then do:
     2858           define variable v-cntxt-db-num        as integer   no-undo .
     2859           define variable v-cntxt-userid        as character no-undo .
     2860           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2861                                             , OUTPUT v-cntxt-userid
     2862                                             ) .
     2863           run gbl/wndpar_r.p
     2864             (input  v-cntxt-db-num
     2865             ,input  v-cntxt-userid
     2866             ,input  'wndmax':U
     2867             ,output v-diasize-wndmax
     2868             ,output v-default-value
     2869             ) .
     2870         end.
     2871         assign
     2872           v-diasize-wndstore = false
     2873         .
     2874         if connected("ub") = true
     2875         then do:
     2876           run gbl/wndpar_r.p
     2877             (input  v-cntxt-db-num
     2878             ,input  v-cntxt-userid
     2879             ,input  'wndstore':U
     2880             ,output v-diasize-wndstore
     2881             ,output v-default-value
     2882             ) .
     2883         end.
     2884         assign
     2885           v-diasize-proc-name = entry(1, program-name(2), '.')
     2886         .
     2887         if v-diasize-wndstore = true
     2888         then do:
     2889           assign
     2890             v-restore-saved = false
     2891           .
     2892           if connected("ub") = true
     2893           then do:
     2894             run gbl/wndsizer.p
     2895               (input  v-cntxt-db-num
     2896               ,input  v-cntxt-userid
     2897               ,input  v-diasize-proc-name
     2898               ,input  'height':u
     2899               ,output v-resize-value-str
     2900               ) .
     2901             if v-resize-value-str <> '':U
     2902             then do:
     2903               run diasize_change-height in this-procedure
     2904                 (input  integer(v-resize-value-str)
     2905                 ,input  true
     2906                 ) .
     2907               assign
     2908                 v-restore-saved = true
     2909               .
     2910             end.
     2911           end.
     2912           if connected("ub") = true
     2913           then do:
     2914             run gbl/wndsizer.p
     2915               (input  v-cntxt-db-num
     2916               ,input  v-cntxt-userid
     2917               ,input  v-diasize-proc-name
     2918               ,input  'width':u
     2919               ,output v-resize-value-str
     2920               ) .
     2921             if v-resize-value-str <> '':U
     2922             then do:
     2923               run diasize_change-width in this-procedure
     2924                 (input  integer(v-resize-value-str)
     2925                 ,input  true
     2926                 ) .
     2927               assign
     2928                 v-restore-saved = true
     2929               .
     2930             end.
     2931           end.
     2932           if v-restore-saved <> true
     2933           then do:
     2934             if v-diasize-wndmax = true
     2935             then do:
     2936               run diasize_maximize in this-procedure
     2937                 (input  true
     2938                 ) .
     2939             end.
     2940           end.
     2941         end.
     2942         else do:
     2943           if v-diasize-wndmax = true
     2944           then do:
     2945             run diasize_maximize in this-procedure
     2946               (input  true
     2947               ) .
     2948           end.
     2949         end.
     2950       end.
     2951     end.
     2952   end procedure.
     2953   procedure diasize_need-full-display :
     2954     define output parameter p-need-full-display as logical   no-undo .
     2955     do
     2956     on error undo, return error return-value
     2957     :
     2958       assign
     2959         p-need-full-display = v-diasize-need-full-display
     2960       .
     2961       assign
     2962         v-diasize-need-full-display = false
     2963       .
     2964     end.
     2965   end procedure.
     2966   procedure get-context :
     2967      define output parameter p-db-num as integer          no-undo.
     2968      define output parameter p-user-id as character        no-undo.
     2969      define variable v-login               as character    no-undo.
     2970      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2971      define buffer buf_user-login  for ub.user-login .
     2972      do
     2973      on error undo, return error
     2974      :
     2975            FIND FIRST buf_sys-ctrl no-lock.
     2976            ASSIGN
     2977               v-login = USERID("ub")
     2978               p-db-num = buf_sys-ctrl.db-num
     2979            .
     2980            FIND FIRST buf_user-login
     2981                 WHERE buf_user-login.db-num = p-db-num
     2982                   AND buf_user-login.user-login = v-login
     2983                 no-lock
     2984                 no-error
     2985                 .
     2986            IF AVAILABLE buf_user-login
     2987            THEN DO:
     2988               assign
     2989                  p-user-id = buf_user-login.user-id
     2990               .
     2991            END.
     2992      end.
     2993   end procedure.
     2994       run diasize_init in this-procedure .
     2995   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2996   procedure set-filter-name :
     2997   define input parameter p-filter-name as character no-undo .
     2998     do with frame Dialog-Frame:
     2999       if p-filter-name > "" then do:
     3000         assign
     3001           frame Dialog-Frame:title
     3002             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     3003         .
     3004         assign
     3005           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     3006         .
     3007       end.
     3008       else do:
     3009         assign
     3010           b-sch :tooltip = ""
     3011         .
     3012       end.
     3013     end.
     3014   end procedure.
     3015   def var sort-labelbr-dis-time-rule   as character no-undo .
     3016   def var sort-clmnbr-dis-time-rule    as handle    no-undo .
     3017   def var cur-clmnbr-dis-time-rule     as handle    no-undo .
     3018   def var cur-clmn-locbr-dis-time-rule as integer   no-undo .
     3019   def var re-querybr-dis-time-rule     as logical   initial no no-undo .
     3020   on start-search, ctrl-o of br-dis-time-rule in frame Dialog-Frame do:
     3021      run sort-brbr-dis-time-rule
     3022        (input (if available tt-template_dis-time-rule
     3023                then recid(tt-template_dis-time-rule)
     3024                else ?
     3025               )
     3026        ).
     3027   end.
     3028   PROCEDURE sort-brbr-dis-time-rule :
     3029     define input parameter p-recid as recid no-undo .
     3030     if re-querybr-dis-time-rule = no then do:
     3031       assign
     3032          cur-clmnbr-dis-time-rule = br-dis-time-rule:current-column in frame Dialog-Frame
     3033       .
     3034       if sort-clmnbr-dis-time-rule <> ? then sort-clmnbr-dis-time-rule:column-fgcolor = 0.
     3035       if cur-clmnbr-dis-time-rule = sort-clmnbr-dis-time-rule then do:
     3036         assign
     3037            sort-labelbr-dis-time-rule = ""
     3038            sort-clmnbr-dis-time-rule = ?
     3039         .
     3040        end.
     3041        else do:
     3042          assign
     3043            sort-labelbr-dis-time-rule = cur-clmnbr-dis-time-rule:label
     3044            sort-clmnbr-dis-time-rule  = cur-clmnbr-dis-time-rule
     3045            sort-clmnbr-dis-time-rule:column-fgcolor = 4
     3046          .
     3047        end.
     3048      end.
     3049     assign
     3050       cur-clmn-locbr-dis-time-rule = 1
     3051     .
     3052     def var column-handle as handle no-undo .
     3053     column-handle = br-dis-time-rule:first-column.
     3054     do while valid-handle(column-handle) :
     3055       if column-handle = cur-clmnbr-dis-time-rule then do:
     3056         leave .
     3057       end.
     3058       column-handle = column-handle:NEXT-COLUMN.
     3059       assign
     3060         cur-clmn-locbr-dis-time-rule = cur-clmn-locbr-dis-time-rule + 1
     3061       .
     3062     end.
     3063     case sort-labelbr-dis-time-rule:
     3064           when X_dis-time-rule.time-rule-num:label in browse br-dis-time-rule then DO:    assign       sort-column-name = "X_dis-time-rule.time-rule-num"     .     run OpenBr in this-procedure ( input YES, input NO, input '':U).   . END.
     3065       otherwise do:
     3066         assign
     3067           sort-column-name = ""
     3068         .
     3069         run OpenBr in this-procedure ( input YES, input NO, input '':U).
     3070           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-dis-time-rule') then do:
     3071             run mv-brw-defaultbr-dis-time-rule.
     3072           end.
     3073         if sort-labelbr-dis-time-rule <> "" then do:
     3074           assign
     3075             cur-clmnbr-dis-time-rule:column-fgcolor = 0
     3076           .
     3077         end.
     3078         assign
     3079           cur-clmn-locbr-dis-time-rule = ?
     3080         .
     3081       end.
     3082     end case.
     3083       if cur-clmn-locbr-dis-time-rule <> ? then do:
     3084         if can-do( this-procedure:internal-entries, 'ch-clmnbr-dis-time-rule') then do:
     3085           run ch-clmnbr-dis-time-rule in this-procedure (cur-clmn-locbr-dis-time-rule).
     3086         end.
     3087       end.
     3088     if p-recid <> ? then do:
     3089       reposition br-dis-time-rule to recid p-recid no-error.
     3090       apply "value-changed" to br-dis-time-rule in frame Dialog-Frame.
     3091     end.
     3092     apply "entry" to br-dis-time-rule in frame Dialog-Frame.
     3093   END PROCEDURE.
     3094   procedure re-open-query-srt-clmnbr-dis-time-rule:
     3095   if cur-clmnbr-dis-time-rule = ? then do:
     3096      run OpenBr in this-procedure ( input YES, input NO, input '':U).
     3097   end.
     3098   else do:
     3099      assign re-querybr-dis-time-rule = yes.
     3100      run sort-brbr-dis-time-rule
     3101        (input (if available tt-template_dis-time-rule
     3102                then recid(tt-template_dis-time-rule)
     3103                else ?
     3104               )
     3105        ).
     3106      assign re-querybr-dis-time-rule = no.
     3107   end.
     3108   end.
