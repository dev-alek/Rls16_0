     1600   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1601   DO:
     1602     define variable loc#log as logical no-undo .
     1603     if available X_dis-time-rule then do:
     1604   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1605   define variable v-str-recid17 as character no-undo .
     1606   define variable v-num-entry17 as integer   no-undo .
     1607   assign
     1608     v-str-recid17 = trim( string( recid( X_dis-time-rule ) , "->>>>>>>>>>>9":U ) )
     1609     v-num-entry17 = lookup( v-str-recid17 , v-rid-list )
     1610   .
     1611   if v-num-entry17 > 0 then do:
     1612     assign
     1613       entry( v-num-entry17, v-rid-list ) = "":U
     1614       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1615     .
     1616   end.
     1617   else do:
     1618     assign
     1619       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid17
     1620     .
     1621   end.
     1622       loc#log = br-dis-time-rule:refresh() .
     1623       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1624           loc#log = br-dis-time-rule:select-next-row ().
     1625           apply "VALUE-CHANGED" to br-dis-time-rule in frame Dialog-Frame.
     1626       end.
     1627       if num-entries( v-rid-list ) = 0
     1628       then
     1629           hide mark-num in frame Dialog-Frame.
     1630       else
     1631           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1632     end.
     1633     apply "entry" to br-dis-time-rule in frame Dialog-Frame.
     1634   END.
