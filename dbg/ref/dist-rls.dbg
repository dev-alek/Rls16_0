     5858         parameter-6-57 = if sort-phrase-57 = ''
     5859                              then
     5860           (
     5861           " " + "  " +
     5862             " " + sort-column-phrase +
     5863           " " + "  "
     5864           )
     5865                              else
     5866           (
     5867           " " + "  " +
     5868             " " + sort-column-phrase +
     5869           " " + sort-phrase-57
     5870           )
     5871         parameter-7-57 =
