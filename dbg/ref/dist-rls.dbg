     1507       IF X_dis-time-rule.sts = INTEGER('1':U) THEN RETURN NO-APPLY.
     1508       IF X_dis-time-rule.sts = INTEGER('2':U) THEN RETURN NO-APPLY.
     1509       run ref/dis-ruls.w (
     1510                    input parParentProc
     1511                   ,input 0
     1512                   ,input "":U
     1513                   ,input 0
     1514                   ,input "":U
     1515                   ,input "time-rule-num":U
     1516                   ,input 0
     1517                   ,input X_dis-time-rule.time-rule-num
     1518                   ,input 0
     1519                   ,input-output v-sts
     1520                   ,input-output v-rid-list ) no-error .
     1521       APPLY "ENTRY" TO br-dis-time-rule.
     1522   END.
     1523   ON CHOOSE OF B-dis-time-rules IN FRAME Dialog-Frame
     1524   DO:
