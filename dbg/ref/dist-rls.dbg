     5705                                                   )
     5706          filter-label = substitute("&1 в детализации правила скидки", filter-label0)
     5707                                                   .
     5708          IF p-sts = -1  THEN DO:
     5709   define variable vss-include-info56 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5710   define variable  l-disable-where-57  as logical   no-undo .
     5711   define variable  l-filter-open-57    as logical   .
