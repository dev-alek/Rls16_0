     5844           v-fltopend-rowid[1] = ?
     5845         .
     5846       end.
     5847       else do:
     5848         assign
     5849         parameter-2-57 = (if p-find-next then "true":u else "false":u )
     5850         parameter-3-57 =  "FOR EACH X_dis-time-rule no-lock"
     5851         parameter-4-57 =
     5852           (
     5853             if (" TRUE " + " " + where-phrase-57) <> ""
     5854             then " TRUE " + " " + where-phrase-57
     5855             else "true"
     5856           )
