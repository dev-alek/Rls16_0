     1357   define buffer root_dis-time-rule for ub.dis-time-rule.
     1358   define buffer buf_tt-template_dis-time-rule for tt0-template_dis-time-rule.
     1359   define buffer template_dis-time-rule for ub.dis-time-rule.
     1360   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1361   do:
     1362     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1363       (input  v-cntxt-db-num
     1364       ,input  v-cntxt-userid
     1365       ,input  0
     1366       ,input  'actn_discount_work':U
     1367       ,input  'global':U
     1368       ,input  0
     1369       ,input  '':U
     1370       ,input  0
     1371       ,input  0
     1372       ,input  0
     1373       ,input  0
     1374       ,input  true
     1375       ,output loc#log
     1376       )  .
     1377   end.
     1378   if not loc#log then return no-apply.
     1379   if p-mode <> "upper-time-rule-num":U
     1380   or not avail X_upper-dis-time-rule
     1381   or X_upper-dis-time-rule.upper-time-rule-num  = 0
     1382   or p-upper-time-rule-num <> 0 then do:
     1383     if p-mode = 'dis-rule':U
     1384     or p-mode = "rule-num":U
     1385     then do:
     1386       for each buf_tt-template_dis-time-rule no-lock where
     1387               buf_tt-template_dis-time-rule.sts = integer('0':U):
     1388          assign
     1389          v-attr-codes   =  v-attr-codes +  chr(4) + string(buf_tt-template_dis-time-rule.time-rule-num)
     1390          v-attr-labels  =  v-attr-labels +  chr(4) + substitute("&1 (тип &2)"
     1391                                                                       ,buf_tt-template_dis-time-rule.des
     1392                                                                       ,buf_tt-template_dis-time-rule.time-rule-num)
     1393          .
     1394       end.
     1395       assign
     1396       v-attr-codes = trim (v-attr-codes, chr(4))
     1397       v-attr-labels = trim (v-attr-labels, chr(4))
     1398       .
     1399     end.
     1400     else do:
     1401       for each template_dis-time-rule no-lock where
     1402               template_dis-time-rule.sts = integer('0':U):
     1403          assign
     1404          v-attr-codes   =  v-attr-codes +  chr(4) + string(template_dis-time-rule.time-rule-num)
     1405          v-attr-labels  =  v-attr-labels +  chr(4) + substitute("&1 (тип &2)"
     1406                                                                       ,template_dis-time-rule.des
     1407                                                                       ,template_dis-time-rule.time-rule-num)
     1408          .
     1409       end.
     1410       assign
     1411       v-attr-codes = trim (v-attr-codes, chr(4))
     1412       v-attr-labels = trim (v-attr-labels, chr(4))
     1413       .
     1414     end.
     1415     run gbl/d-list.w (
     1416                  input "b-sel":U
     1417                 ,input "Выберите тип расписания"
     1418                 ,input v-attr-codes
     1419                 ,input v-attr-labels
     1420                 ,input chr(4)
     1421                 ,input v-presel-codes
     1422                 ,output v-sel-codes).
     1423      if v-sel-codes = "":U then return no-apply.
     1424      assign
     1425      v-templ-rl-root = integer(v-sel-codes)
     1426      .
     1427   end.
     1428   else do:
     1429     assign
     1430     v-templ-rl-root = X_upper-dis-time-rule.templ-rl-root
     1431     .
     1432   end.
     1433   run ref/dis-timi.w
     1434                 (
     1435                    input parParentProc
     1436                   ,input 'ДОБАВЛЕНИЕ':U
     1437                   ,input v-templ-rl-root
     1438                   ,input 0
     1439                   ,input p-upper-time-rule-num
     1440                   ,input-output loc-doc-rec
     1441                               ) no-error
     1442   .
     1443   if loc-doc-rec <> ? then do:
     1444     RUn OpenBR in this-procedure ( input YES, input NO, input '':U).
     1445     reposition br-dis-time-rule to recid loc-doc-rec no-error.
     1446     if error-status:error then do:                           find first pos_dis-time-rule no-lock where                                   recid(pos_dis-time-rule) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи РАСПИСАНИЕ" skip                            string(if avail pos_dis-time-rule                                     then  substitute("номер расписания: &1"                                                     , pos_dis-time-rule.time-rule-num)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     1447   end.
     1448   apply "entry" to br-dis-time-rule in frame Dialog-Frame.
     1449   apply "value-changed" to br-dis-time-rule in frame Dialog-Frame.
     1450   END.
     1451   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1452   DO:
     1453   DEFINE variable loc#log as logical no-undo.
     1454   define variable loc-doc-rec as recid no-undo .
     1455   if not available X_dis-time-rule then return no-apply.
     1456   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1457   do:
     1458     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1459       (input  v-cntxt-db-num
     1460       ,input  v-cntxt-userid
     1461       ,input  0
     1462       ,input  'actn_discount_work':U
     1463       ,input  'global':U
     1464       ,input  0
     1465       ,input  '':U
     1466       ,input  0
     1467       ,input  0
     1468       ,input  0
     1469       ,input  0
     1470       ,input  true
     1471       ,output loc#log
     1472       )  .
     1473   end.
     1474   if not loc#log then return no-apply.
     1475   assign
     1476   loc-doc-rec = recid(X_dis-time-rule)
     1477   .
     1478   run ref/dis-timi.w
     1479                 (
     1480                    input parParentProc
     1481                   ,input 'ИЗМЕНЕНИЕ':U
     1482                   ,input X_dis-time-rule.templ-rl-root
     1483                   ,input X_dis-time-rule.time-rule-num
     1484                   ,input X_dis-time-rule.upper-time-rule-num
     1485                   ,input-output loc-doc-rec
     1486                               ) no-error
     1487   .
     1488   if loc-doc-rec <> ? then do:
     1489     RUn OpenBR in this-procedure ( input YES, input NO, input NO).
     1490     reposition br-dis-time-rule to recid loc-doc-rec no-error.
     1491     if error-status:error then do:                           find first pos_dis-time-rule no-lock where                                   recid(pos_dis-time-rule) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи РАСПИСАНИЕ" skip                            string(if avail pos_dis-time-rule                                     then  substitute("номер расписания: &1"                                                     , pos_dis-time-rule.time-rule-num)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     1492   end.
     1493   apply "entry" to br-dis-time-rule in frame Dialog-Frame.
     1494   apply "value-changed" to br-dis-time-rule in frame Dialog-Frame.
     1495   END.
     1496   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1497   DO:
     1498   if not available X_dis-time-rule then return no-apply.
     1499     run proc-b-del in this-procedure no-error.
     1500     if error-status:error then return no-apply.
     1501   END.
     1502   ON CHOOSE OF B-dis-rule IN FRAME Dialog-Frame
     1503   DO:
     1504      DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1505     define variable v-sts as integer no-undo init ?.
