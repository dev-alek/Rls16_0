     1656   ON CHOOSE OF B-stat IN FRAME Dialog-Frame
     1657   DO:
     1658   define variable loc#log as logical no-undo .
     1659     IF NOT AVAILABLE X_dis-time-rule THEN RETURN NO-APPLY.
     1660   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1661   do:
     1662     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1663       (input  v-cntxt-db-num
     1664       ,input  v-cntxt-userid
     1665       ,input  0
     1666       ,input  'actn_discount_work':U
     1667       ,input  'global':U
     1668       ,input  0
     1669       ,input  '':U
     1670       ,input  0
     1671       ,input  0
     1672       ,input  0
     1673       ,input  0
     1674       ,input  true
