     1689     if error-status:error then return no-apply.
     1690   END.
     1691   ON VALUE-CHANGED OF br-dis-time-rule IN FRAME Dialog-Frame
     1692   DO:
     1693     IF AVAILABLE X_dis-time-rule  THEN DO:
     1694       ASSIGN
     1695       v-des = X_dis-time-rule.des
     1696       .
     1697     END.
     1698     ELSE DO:
     1699       ASSIGN
     1700       v-des = "":U.
     1701     END.
     1702     DISPLAY
     1703     v-des
     1704     WITH FRAME Dialog-Frame.
     1705   END.
     1706   ON VALUE-CHANGED OF RS-sts IN FRAME Dialog-Frame
     1707   DO:
     1708     ASSIGN
     1709     rs-sts
     1710     p-sts = (IF rs-sts = 'все':U THEN ? ELSE INTEGER(rs-sts))
     1711     .
     1712     RUN openbr IN THIS-PROCEDURE ( input YES, input NO, input '':U) NO-ERROR.
     1713     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     1714   END.
     1715   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1716   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1717   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1718   on help of frame Dialog-Frame
     1719   do:
     1720     run gbl/app_help.p
     1721       (input this-procedure :file-name
     1722       ,input ''
     1723       ,input ?
     1724       ) no-error.
     1725     if error-status :error then do:
     1726       message
     1727         "Ошибка при вызове помощи"
     1728         error-status :get-message(1)
     1729         view-as alert-box .
     1730     end.
     1731   end.
     1732   run minbtn-set in this-procedure .
     1733   on choose of b-help in frame Dialog-Frame
     1734   do:
     1735     apply "help":u to frame Dialog-Frame .
     1736   end.
     1737   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1738   procedure minbtn-set :
     1739       do
     1740           on error undo, return error return-value
     1741           :
     1742           define variable ii              as integer       no-undo .
     1743           define variable fh              as widget-handle no-undo .
     1744           define variable hh              as widget-handle no-undo .
     1745           define variable v-h             as handle        extent 4 no-undo .
     1746           define variable v-name-button   as character     no-undo .
     1747           define variable v-help-old-x    as decimal       no-undo .
     1748           define variable v-help-old-y    as decimal       no-undo .
     1749           define variable v-help-old-size as decimal       no-undo .
     1750           define variable v-frame-width   as decimal       no-undo .
     1751           define variable jj              as integer       no-undo .
     1752           do
     1753               on error undo, return error
     1754               :
     1755               assign
     1756                   v-frame-width = frame Dialog-Frame:width - 0.3
     1757                   fh            = frame Dialog-Frame:first-child
     1758                   hh            = fh:first-child
     1759                   ii            = 1
     1760                   .
     1761               do while valid-handle(hh):
     1762                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1763                   do:
     1764                       case lc(hh:name) :
     1765                           when "b-help" then
     1766                               do:
     1767                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1768                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1769                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1770                                   hh:TOOLTIP = "Помощь" .
     1771                                   v-help-old-x = hh:column .
     1772                                   v-help-old-y = hh:row    .
     1773                                   v-help-old-size = hh:width .
     1774                                   hh:width-chars = 2.5 .
     1775                               end.
     1776                           when "b-print" then
     1777                               do:
     1778                                   hh:load-image("cmp/b-print.bmp":u) .
     1779                                   hh:TOOLTIP = "Печать" .
     1780                                   v-h[ii] = hh:handle .
     1781                                   ii = ii + 1 .
     1782                                   hh:width-chars = 3 .
     1783                               end.
     1784                           when "b-history" or
     1785                           when "b-hist" then
     1786                               do:
     1787                                   hh:load-image("cmp/b-hist.bmp":u) .
     1788                                   hh:TOOLTIP = "История" .
     1789                                   v-h[ii] = hh:handle .
     1790                                   ii = ii + 1 .
     1791                                   hh:width-chars = 3 .
     1792                               end.
     1793                           when "b-sch" then
     1794                               do:
     1795                                   hh:load-image("cmp/b-sch.bmp":u) .
     1796                                   hh:TOOLTIP = "Установка Фильтра" .
     1797                                   v-h[ii] = hh:handle .
     1798                                   ii = ii + 1 .
     1799                                   hh:width-chars = 3 .
     1800                               end.
     1801                           when "b-hist-user" then
     1802                               do:
     1803                                   hh:load-image("cmp/b-hist.bmp":u) .
     1804                                   hh:TOOLTIP = "История пользователя" .
     1805                                   ii = ii + 1 .
     1806                               end.
     1807                       end case.
     1808                   end.
     1809                   hh = hh:next-sibling.
     1810               end.
     1811               b-help:column = v-frame-width - b-help:width-chars.
     1812               jj = 0.
     1813               repeat ii = 4 to 1 by -1 :
     1814                   if valid-handle (v-h[ii] ) then
     1815                   do:
     1816                       jj  = jj + 1 .
     1817                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1818                       v-h[ii]:row    = v-help-old-y .
     1819                   end.
     1820               end.
     1821           end.
     1822       end.
     1823   end procedure.
     1824   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1825   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1826   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1827   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1828   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1829   define variable v-diasize-current-frame-height as decimal   no-undo .
     1830   define variable v-diasize-change-size          as logical   no-undo .
     1831   define variable v-diasize-resize-button        as handle    no-undo .
     1832   define variable v-diasize-wndmax               as logical   no-undo .
     1833   define variable v-diasize-wndstore             as logical   no-undo .
     1834   define variable v-diasize-proc-name            as character no-undo .
     1835   define variable v-diasize-browse-handle        as handle    no-undo .
     1836   define variable v-diasize-browse-number        as integer   no-undo .
     1837   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1838   define temp-table temp-diasize-handle no-undo
     1839     field handle-value  as handle
     1840     field save-position as decimal
     1841     index xpk is primary unique handle-value
     1842     .
     1843   define temp-table temp-browse-handle no-undo
     1844     field browse-type   as character
     1845     field browse-number as integer
     1846     field browse-handle as handle
     1847     field original-size as decimal
     1848     index xpk is primary unique browse-type browse-number
     1849     index xie browse-type browse-handle
     1850   .
     1851   procedure diasize_change-height :
     1852     define input  parameter p-change-value  as decimal   no-undo .
     1853     define input  parameter p-move-resize   as logical   no-undo .
     1854     define variable v-field-group-handle    as handle    no-undo .
     1855     define variable v-object-handle         as handle    no-undo .
     1856     define variable v-frame-height          as decimal   no-undo .
     1857     define variable v-frame-virtual-height  as decimal   no-undo .
     1858     define variable v-browse-height         as decimal   no-undo .
     1859     define variable v-window-height         as decimal   no-undo .
     1860     define variable v-window-virtual-height as decimal   no-undo .
     1861     define variable v-change-sign           as integer   no-undo .
     1862     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1863     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1864     if p-change-value > 0
     1865     then do:
     1866       if frame Dialog-Frame :height + p-change-value
     1867           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1868       then do:
     1869         assign
     1870           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1871                           - (frame Dialog-Frame :height-chars)
     1872         .
     1873         if p-change-value <= 0
     1874         then do:
     1875           run diasize_position-resize-button in this-procedure .
     1876           return .
     1877         end.
     1878       end.
     1879     end.
     1880     if p-change-value < 0
     1881     then do:
     1882       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1883       then do:
     1884         assign
     1885           p-change-value = v-diasize-orig-frame-height
     1886                          - (frame Dialog-Frame :height-chars)
     1887         .
     1888         if p-change-value >= 0
     1889         then do:
     1890           run diasize_position-resize-button in this-procedure .
     1891           return .
     1892         end.
     1893       end.
     1894     end.
     1895     if p-change-value >= 0
     1896     then do:
     1897       assign
     1898         v-change-sign = 1
     1899       .
     1900     end.
     1901     else do:
     1902       assign
     1903         v-change-sign = -1
     1904       .
     1905     end.
     1906     assign
     1907       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1908     .
     1909     if p-change-value = 0
     1910     then do:
     1911       run diasize_position-resize-button in this-procedure .
     1912       return .
     1913     end.
     1914     move_block:
     1915     do
     1916     on error undo move_block, retry move_block
     1917     :
     1918       if retry
     1919       then do:
     1920         do
     1921         on error undo move_block, leave move_block
     1922         :
     1923           if p-change-value > 0
     1924           then do:
     1925             for each buf_temp-diasize-handle
     1926             on error undo, next
     1927             :
     1928               assign
     1929                 v-object-handle = buf_temp-diasize-handle.handle-value
     1930               .
     1931               if v-object-handle <> v-diasize-resize-button
     1932               then do:
     1933                 assign
     1934                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1935                 .
     1936               end.
     1937             end.
     1938             assign
     1939               v-diasize-browse-handle :height = v-browse-height
     1940             .
     1941             for each buf_temp-browse-handle
     1942               where buf_temp-browse-handle.browse-type = 'height':u
     1943             on error undo, next
     1944             :
     1945               assign
     1946                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1947               .
     1948             end.
     1949             assign
     1950               frame Dialog-Frame :height = v-frame-height
     1951             .
     1952             if frame Dialog-Frame :scrollable = true
     1953             then do:
     1954               assign
     1955                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1956               .
     1957             end.
     1958             run diasize_position-resize-button in this-procedure .
     1959           end.
     1960           else do:
     1961             if frame Dialog-Frame :scrollable = true
     1962             then do:
     1963               assign
     1964                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1965               .
     1966             end.
     1967             assign
     1968               frame Dialog-Frame :height = v-frame-height
     1969             .
     1970             assign
     1971               v-diasize-browse-handle :height = v-browse-height
     1972             .
     1973             for each buf_temp-browse-handle
     1974               where buf_temp-browse-handle.browse-type = 'height':u
     1975             on error undo, next
     1976             :
     1977               assign
     1978                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1979               .
     1980             end.
     1981             for each buf_temp-diasize-handle
     1982             on error undo, next
     1983             :
     1984               assign
     1985                 v-object-handle = buf_temp-diasize-handle.handle-value
     1986               .
     1987               if v-object-handle <> v-diasize-resize-button
     1988               then do:
     1989                 assign
     1990                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1991                 .
     1992               end.
     1993             end.
     1994             run diasize_position-resize-button in this-procedure .
     1995           end.
     1996           assign
     1997             v-diasize-change-size = false
     1998           .
     1999           leave move_block .
     2000         end.
     2001       end.
     2002       assign
     2003         v-diasize-need-full-display = true
     2004       .
     2005       if v-diasize-change-size = false
     2006       then do:
     2007         assign
     2008           v-diasize-change-size = true
     2009         .
     2010       end.
     2011       else do:
     2012         return .
     2013       end.
     2014       assign
     2015         v-frame-height = frame Dialog-Frame :height
     2016         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2017         v-browse-height = v-diasize-browse-handle :height
     2018       .
     2019       for each buf_temp-browse-handle
     2020         where buf_temp-browse-handle.browse-type = 'height':u
     2021       :
     2022         assign
     2023           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2024         .
     2025       end.
     2026       for each buf_temp-diasize-handle
