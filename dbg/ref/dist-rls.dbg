     1214   DEFINE BUTTON B-add
     1215        LABEL "&Добавить"
     1216        SIZE 10 BY 1.
     1217   DEFINE BUTTON B-chg
     1218        LABEL "&Изменить"
     1219        SIZE 10 BY 1.
