      374   define variable v-db-num like ub.db.db-num no-undo .
      375   define variable v-correct-schet as logical no-undo .
      376   define variable v-err-mess as character no-undo .
      377   define variable v1-mainholder as character no-undo .
      378   define variable v2-mainholder as character no-undo .
      379   define variable v1type as character no-undo .
      380   define variable v2type as character no-undo .
      381   define variable v-dop1 as character no-undo .
      382   define variable v-value as character no-undo.
      383   define variable v-ttype as character no-undo.
      384   define buffer buf_sysconf  for ub.sysconf.
      385   define buffer buf_fin-bank for ub.fin-bank.
      386   define buffer buf_schet-clients for ub.clients.
      387   define buffer buf_currency for ub.currency.
      388   define buffer buf-db_fin-schet for ub.fin-schet.
      389   if p-mode <> 'ДОБАВЛЕНИЕ':U
      390   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
      391     message
      392     vss-workfile vss-revision vss-description skip
      393     "Неверный параметр p-mode" p-mode
      394     view-as alert-box error .
      395     return error '':u.
      396   end.
      397   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      398   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      399     (output v-db-num
      400     )  .
      401   if num-entries(p-dop1, chr(4) ) > 1 then do:
      402     v-dop1 = entry(2, p-dop1, chr(4) ).
      403     p-dop1 = entry(1, p-dop1, chr(4) ).
      404   end.
      405   find first buf_sysconf no-lock where
      406                   buf_sysconf.host-code = p-host-code.
      407   if not avail buf_sysconf then dO:
      408     v-err-mess = substitute("Не найдена фирма с кодом &1", p-host-code).
      409     run err-mess in this-procedure ( input-output v-err-mess ).
      410     undo, return error (if p-silent = yes then v-err-mess else 'host-code':U).
      411   end.
      412   run gbl/conf-rd.p ("is-erpRN", "", "", 0, "", "", "", no, output v-value, output v-ttype) no-error.
      413   if v-value = "no"  then
      414   do:
      415   if v-db-num <> buf_sysconf.firm-db-num
      416   then do:
      417     v-err-mess = substitute("Нельзя изменять запись БАНКОВСКОГО СЧЕТА в БД, отличной от главной БД фирмы:&1" +
      418                              "Номер текущей БД &2 Номер главной БД фирмы &3"
      419                              , chr(10)
      420                              , v-db-num
      421                              , buf_sysconf.firm-db-num) .
      422     run err-mess in this-procedure ( input-output v-err-mess ).
      423     undo, return error (if p-silent = yes then v-err-mess else 'host-code':U).
      424   end.
      425   end.
      426   find first buf_fin-bank no-lock where
      427                     buf_fin-bank.host-code = p-host-code
      428                 AND buf_fin-bank.code-bank = p-code-bank no-error .
      429   if not available buf_fin-bank then do:
      430     v-err-mess = substitute("Не найден банк вн№ &1 в фирме &2", p-code-bank, p-host-code) .
      431     run err-mess in this-procedure ( input-output v-err-mess ).
      432     undo, return error (if p-silent = yes then v-err-mess else 'code-bank':U).
      433   end.
      434   if lookup("r-schet", p-verify) > 0 then do:
      435   run gbl/keyschet.p (
      436                    input p-r-schet
      437                   ,input buf_fin-bank.bik
      438                   ,input p-curr-code
      439                   ,input (if substring(buf_fin-bank.bik, 7, 3) = '000'
      440                           or substring(buf_fin-bank.bik, 7, 3) = '001'
      441                           or substring(buf_fin-bank.bik, 7, 3) = '002'
      442                           then no
      443                           else yes)
      444                   ,output v-correct-schet
      445                 )  no-error.
      446   if error-status:error then do:
      447     v-err-mess = substitute("Ошибка при проверке валидности расчетного счета &1: &2", p-r-schet, ERROR-STATUS:GET-message(1)) .
      448     run err-mess in this-procedure ( input-output v-err-mess ).
      449     undo, return error "r-schet":U.
      450   end.
      451   if not v-correct-schet then do:
      452     v-err-mess = substitute("Неверный расчетный счет &1: &2", p-r-schet, return-value) .
      453     run err-mess in this-procedure ( input-output v-err-mess ).
      454     undo, return error (if p-silent = yes then v-err-mess else 'r-schet':U).
      455   end.
      456   end.
      457   if not can-find(first buf_currency no-lock where
      458                     buf_currency.curr-code = p-curr-code
      459                               ) then do:
      460     v-err-mess = substitute("Не найдена валюта с кодом &1", p-curr-code) .
      461     run err-mess in this-procedure ( input-output v-err-mess ).
      462     undo, return error (if p-silent = yes then v-err-mess else 'curr-code':U).
      463   end.
      464   if not can-find(first buf_schet-clients no-lock where
      465                     buf_schet-clients.obj-type = p-cli-type
      466                 AND buf_schet-clients.obj-code = p-cli-code
      467                 ) then do:
      468     v-err-mess = substitute("Не найден контрагент &1&2", p-cli-type, p-cli-code) .
      469     run err-mess in this-procedure ( input-output v-err-mess ).
      470     undo, return error (if p-silent = yes then v-err-mess else 'cli-code':U).
      471   end.
      472   if p-r-schet = "":U then do:
      473     v-err-mess = "Поле РАСЧЕТНЫЙ СЧЕТ не может быть пустым" .
      474     run err-mess in this-procedure ( input-output v-err-mess ).
      475     undo, return error (if p-silent = yes then v-err-mess else 'r-schet':U).
      476   end.
      477   _MAIN:
      478   DO ON ERROR UNDO, RETURN ERROR
      479   ON STOP UNDO, RETURN ERROR:
      480     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      481       create ub.fin-schet.
      482       assign
      483       ub.fin-schet.host-code = p-host-code
      484       ub.fin-schet.code-schet = next-value(s-fin-schet, ub)
      485       p-doc-rec = recid(ub.fin-schet)
      486       .
      487     end.
      488     else do:
      489       FIND FIRST ub.fin-schet where
      490                 recid(ub.fin-schet) = p-doc-rec No-ERROR.
      491       if not available ub.fin-schet then do:
      492         v-err-mess = substitute("&1 &2 &3&4Не найдена запись банковского счета - p-doc-rec=&5"
      493                                 ,vss-workfile
      494                                 ,vss-revision
      495                                 ,vss-description
      496                                 ,chr(10)
      497                                 ,p-doc-rec).
      498         run err-mess in this-procedure ( input-output v-err-mess ).
      499         undo _main, return error (if p-silent = yes then v-err-mess else '':U).
      500       end.
      501       if ub.fin-schet.host-code <> p-host-code
      502       OR ub.fin-schet.code-schet <> p-code-schet then do:
      503         v-err-mess = "Для уже имеющейся записи нельзя изменить код фирмы и код счета" .
      504         run err-mess in this-procedure ( input-output v-err-mess ).
      505         undo _main, return error (if p-silent = yes then v-err-mess else '':U).
      506       end.
      507       if ub.fin-schet.cli-type <> p-cli-type
      508       OR ub.fin-schet.cli-code <> p-cli-code then do:
      509         v-err-mess = "Для уже имеющейся записи нельзя изменить держателя счета" .
      510         run err-mess in this-procedure ( input-output v-err-mess ).
      511         undo _main, return error (if p-silent = yes then v-err-mess else '':U).
      512       end.
      513     end.
      514       run clntattr-value in this-procedure (
      515           input p-cli-type,
      516           input p-cli-code,
      517           input 'main-accholder':U,
      518           output v1-mainholder,
      519           output v1type)
      520       no-error.
      521       for each buf-db_fin-schet where buf-db_fin-schet.host-code = p-host-code and
      522                                         buf-db_fin-schet.r-schet = p-r-schet and
      523                                         buf-db_fin-schet.code-bank = p-code-bank and
      524                                         buf-db_fin-schet.status_ = 'тек':U
      525                                   and (p-mode = 'ДОБАВЛЕНИЕ':U or (p-mode = 'ИЗМЕНЕНИЕ':U and ub.fin-schet.status_ = 'тек':U)):
      526       if buf-db_fin-schet.code-schet = p-code-schet then next.
      527       run clntattr-value in this-procedure (
      528           input buf-db_fin-schet.cli-type,
      529           input buf-db_fin-schet.cli-code,
      530           input 'main-accholder':U,
      531           output v2-mainholder,
      532           output v2type)
      533       no-error.
      534       if buf-db_fin-schet.cli-type = p-cli-type
      535           and buf-db_fin-schet.cli-code = p-cli-code
      536       then
      537           do:
      538               v-err-mess = substitute("Для клиена &6,&7 уже заведен счёт &1 по фирме &2 в том же банке." +
      539                   "&3Вн.номер счета = &4" +
      540                   "&3Доп.назв.держ.счёта = &5",
      541                   p-r-schet,
      542                   p-host-code,
      543                   chr(10),
      544                   buf-db_fin-schet.code-schet,
      545                   buf-db_fin-schet.dop1,
      546                   buf-db_fin-schet.cli-type,
      547                   buf-db_fin-schet.cli-code
      548                   ).
      549               run err-mess in this-procedure (input-output v-err-mess).
      550               undo, return error (if p-silent = yes then v-err-mess else 'r-schet':U).
      551           end.
      552       if p-dop1 <> '':U
      553           and buf-db_Fin-schet.dop1 = '':U
      554           and  v1-mainholder <> '':U
      555           and v1-mainholder = buf-db_fin-schet.cli-type + "," + string(buf-db_fin-schet.cli-code)
      556           and v2-mainholder = '':U
      557       then
      558           do:
      559               next.
      560           end.
      561       if p-dop1 = ''
      562           and v1-mainholder = ''
      563           and v2-mainholder <> '':U and v2-mainholder = string(p-cli-type + "," + string(p-cli-code))
      564           and buf-db_Fin-schet.dop1 <> '':U
      565       then
      566           do:
      567               next.
      568           end.
      569       if p-dop1 <> ''
      570           and buf-db_Fin-schet.dop1 <> ''
      571           and p-dop1 <> buf-db_Fin-schet.dop1
      572           and v1-mainholder <> '':U
      573           and v1-mainholder = v2-mainholder
      574       then
      575           do:
      576               next.
      577           end.
      578       v-err-mess = substitute("Уже есть расчетный счет &1 по фирме &2 в том же банке." +
      579           "&3Вн.номер счета = &4" +
      580           (if v1-mainholder <> ''
      581               and v1-mainholder = v2-mainholder
      582               and buf-db_Fin-schet.dop1 <> ''
      583               and buf-db_Fin-schet.dop1 = p-dop1
      584               then
      585                   "&3Объект = &6,&7" +
      586                   "&3Доп.назв.держ.счёта = &5"
      587               else ""),
      588           p-r-schet,
      589           p-host-code,
      590           chr(10),
      591           buf-db_fin-schet.code-schet,
      592           buf-db_fin-schet.dop1,
      593           buf-db_fin-schet.cli-type,
      594           buf-db_fin-schet.cli-code
      595           ).
      596       run err-mess in this-procedure (input-output v-err-mess).
      597       undo, return error (if p-silent = yes then v-err-mess else 'r-schet':U).
      598   end.
      599     assign
      600     ub.fin-schet.c-schet   = p-c-schet
      601     ub.fin-schet.cli-type  = p-cli-type
      602     ub.fin-schet.cli-code  = p-cli-code
      603     ub.fin-schet.code-bank = p-code-bank
      604     ub.fin-schet.curr-code = p-curr-code
      605     ub.fin-schet.dop1      = p-dop1
      606     ub.fin-schet.dop2      = p-dop2
      607     ub.fin-schet.r-schet   = p-r-schet
      608     ub.fin-schet.PS        = p-PS
      609     ub.fin-schet.status_   = (if p-mode = 'ДОБАВЛЕНИЕ':U
      610                               then 'тек':U
      611                               else ub.fin-schet.status_)
      612     .
      613     release ub.fin-schet no-error.
      614     if error-status:error then do:
      615       v-err-mess = substitute("Ошибка при сохранении записи БАНКОВСКОГО СЧЕТА &1: &2", ERROR-STATUS:GET-NUMBER(1), return-value ) .
      616       run err-mess in this-procedure ( input-output v-err-mess ).
      617       undo _main, return error (if p-silent = yes then v-err-mess else '':U).
      618     end.
      619   end.
      620   PROCEDURE err-mess:
      621     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      622     CASE p-silent:
      623       when yes then do:
      624         p-mess = substitute("Счет вн.№ &1: фирма: &2:&3&4"
      625                            , p-code-schet
      626                            , p-host-code
      627                            , chr(10)
      628                            , p-mess
      629                            ).
      630       end.
      631       otherwise do:
      632         message
      633         p-mess
      634         view-as alert-box error .
      635       end.
      636     end.
      637   END PROCEDURE.
