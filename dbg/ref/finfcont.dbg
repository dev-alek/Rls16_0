      218               tt-fin-doc.payer-sign1      =  if p-fin-doc-type = 'апп':U
      219                                              or p-fin-doc-type = 'ппп':U
      220                                              then buf_contract.cli-sign
      221                                              else tt-fin-doc.payer-sign1
      222               .
      223           end.
      224           when 2 then do:
      225             assign
      226             error-status:error = no.
      227             if buf_contract.posr-code-schet > 0
      228             then do:
      229               assign
      230               v-code-schet = buf_contract.posr-code-schet
      231               .
      232               run get-bank-requisite in this-procedure (
      233                                                         input buf_contract.host-code
      234                                                         ,input v-code-schet
      235                                                         ,output v-bank-name
      236                                                         ,output v-bank-city
      237                                                         ,output v-dop1
      238                                                         ,output v-dop2
      239                                                         ,output v-bik
      240                                                         ,output v-c-schet
      241                                                         ,output v-r-schet
      242                                                         ,output v-payer-schet-curr-code
      243                                                         ,output v-payer-schet-curr-abbr
      244                                                           ) no-error .
      245             end.
      246             if buf_contract.posr-code-schet = 0
      247             or error-status:error then do:
      248               assign
      249               v-code-schet = buf_contract.posr-code-schet-start
      250               .
      251               run get-bank-requisite in this-procedure (
      252                                                         input buf_contract.host-code
      253                                                         ,input v-code-schet
      254                                                         ,output v-bank-name
      255                                                         ,output v-bank-city
      256                                                         ,output v-dop1
      257                                                         ,output v-dop2
      258                                                         ,output v-bik
      259                                                         ,output v-c-schet
      260                                                         ,output v-r-schet
      261                                                         ,output v-payer-schet-curr-code
      262                                                         ,output v-payer-schet-curr-abbr
      263                                                           ) no-error .
      264             end.
      265             assign
      266             tt-fin-doc.payer-code       =  buf_contract.posr-code
      267             tt-fin-doc.payer-type       =  buf_contract.posr-type
      268             tt-fin-doc.payer-name       =  buf_contract.posr-name
      269             tt-fin-doc.payer-inn        =  buf_contract.posr-inn
      270             tt-fin-doc.payer-kpp        =  buf_contract.posr-kpp
      271             tt-fin-doc.payer-sign1      =  if p-fin-doc-type = 'апп':U
      272                                            or p-fin-doc-type = 'ппп':U
      273                                            then buf_contract.posr-sign
      274                                            else tt-fin-doc.payer-sign1
      275             .
      276           end.
      277           when 3 then do:
      278             assign
      279             error-status:error = no.
      280             if buf_contract.agnt-code-schet > 0
      281             then do:
      282               assign
      283               v-code-schet = buf_contract.agnt-code-schet
      284               .
      285               run get-bank-requisite in this-procedure (
      286                                                         input buf_contract.host-code
      287                                                         ,input v-code-schet
      288                                                         ,output v-bank-name
      289                                                         ,output v-bank-city
      290                                                         ,output v-dop1
      291                                                         ,output v-dop2
      292                                                         ,output v-bik
      293                                                         ,output v-c-schet
      294                                                         ,output v-r-schet
      295                                                         ,output v-payer-schet-curr-code
      296                                                         ,output v-payer-schet-curr-abbr
      297                                                           ) no-error .
