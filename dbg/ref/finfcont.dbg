      303               .
      304               run get-bank-requisite in this-procedure (
      305                                                         input buf_contract.host-code
      306                                                         ,input v-code-schet
      307                                                         ,output v-bank-name
      308                                                         ,output v-bank-city
      309                                                         ,output v-dop1
      310                                                         ,output v-dop2
      311                                                         ,output v-bik
      312                                                         ,output v-c-schet
      313                                                         ,output v-r-schet
      314                                                         ,output v-payer-schet-curr-code
      315                                                         ,output v-payer-schet-curr-abbr
      316                                                           ) no-error .
      317             end.
      318             assign
