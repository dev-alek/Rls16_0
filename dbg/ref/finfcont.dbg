      339                                        then v-code-schet
      340                                        else 0)
      341         tt-fin-doc.payer-c-schet    =  v-c-schet
      342         tt-fin-doc.payer-r-schet    =  v-r-schet
      343         .
      344         assign
      345         error-status:error = no.
      346         if buf_contract.own-code-schet > 0
      347         then do:
      348           assign
      349           v-code-schet = buf_contract.own-code-schet
      350           .
      351           run get-bank-requisite in this-procedure (
      352                                                     input buf_contract.host-code
      353                                                     ,input v-code-schet
      354                                                     ,output v-bank-name
      355                                                     ,output v-bank-city
      356                                                     ,output v-dop1
      357                                                     ,output v-dop2
      358                                                     ,output v-bik
      359                                                     ,output v-c-schet
      360                                                     ,output v-r-schet
      361                                                     ,output v-receiver-schet-curr-code
      362                                                     ,output v-receiver-schet-curr-abbr
      363                                                       ) no-error .
      364         end.
      365         if buf_contract.own-code-schet = 0
      366         or error-status:error then do:
      367           assign
      368           v-code-schet = buf_contract.own-code-schet-start
      369           .
      370           run get-bank-requisite in this-procedure (
      371                                                     input buf_contract.host-code
      372                                                     ,input v-code-schet
      373                                                     ,output v-bank-name
      374                                                     ,output v-bank-city
      375                                                     ,output v-dop1
      376                                                     ,output v-dop2
      377                                                     ,output v-bik
      378                                                     ,output v-c-schet
      379                                                     ,output v-r-schet
      380                                                     ,output v-receiver-schet-curr-code
      381                                                     ,output v-receiver-schet-curr-abbr
      382                                                       ) no-error .
      383         end.
      384         assign
      385         tt-fin-doc.receiver-code       =  p-host-code
      386         tt-fin-doc.receiver-type       =  'орг':U
      387         tt-fin-doc.receiver-name       =  buf_contract.own-name
      388         tt-fin-doc.receiver-inn        =  buf_contract.own-inn
      389         tt-fin-doc.receiver-kpp        =  buf_contract.own-kpp
      390         tt-fin-doc.receiver-bank-name  =  v-bank-name
      391         tt-fin-doc.receiver-bank-city  =  v-bank-city
      392         tt-fin-doc.receiver-dop1       =  v-dop1
      393         tt-fin-doc.receiver-dop2       =  v-dop2
      394         tt-fin-doc.receiver-bik        =  v-bik
      395         tt-fin-doc.receiver-code-schet =  (if p-fin-doc-type = 'ппп':U
      396                                           or p-fin-doc-type = 'рпп':U
      397                                           then v-code-schet
      398                                           else 0)
      399         tt-fin-doc.receiver-c-schet    =  v-c-schet
      400         tt-fin-doc.receiver-r-schet    =  v-r-schet
      401         tt-fin-doc.receiver-sign1      =  if p-fin-doc-type = 'апп':U
      402                                           then  (buf_contract.own-sign-post + chr(4) + buf_contract.own-sign)
      403                                           else tt-fin-doc.receiver-sign1
      404         .
      405       end.
      406       when 'рко':U
      407       or
      408       when 'рпп':U
      409       or
      410       when 'апр':U
      411       then do:
