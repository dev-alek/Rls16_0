      333         tt-fin-doc.payer-bank-city  =  v-bank-city
      334         tt-fin-doc.payer-dop1       =  v-dop1
      335         tt-fin-doc.payer-dop2       =  v-dop2
      336         tt-fin-doc.payer-bik        =  v-bik
      337         tt-fin-doc.payer-code-schet =  (if p-fin-doc-type = 'ппп':U
