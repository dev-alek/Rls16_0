      454             assign
      455             tt-fin-doc.receiver-code       =  buf_contract.cli-code
      456             tt-fin-doc.receiver-type       =  buf_contract.cli-type
      457             tt-fin-doc.receiver-name       =  buf_contract.cli-name
      458             tt-fin-doc.receiver-inn        =  buf_contract.cli-inn
      459             tt-fin-doc.receiver-kpp        =  buf_contract.cli-kpp
      460             tt-fin-doc.receiver-sign1      =  if p-fin-doc-type = 'апр':U
