      506           assign
      507           tt-fin-doc.receiver-code       =  buf_contract.posr-code
      508           tt-fin-doc.receiver-type       =  buf_contract.posr-type
      509           tt-fin-doc.receiver-name       =  buf_contract.posr-name
      510           tt-fin-doc.receiver-inn        =  buf_contract.posr-inn
      511           tt-fin-doc.receiver-kpp        =  buf_contract.posr-kpp
      512           tt-fin-doc.receiver-sign1      =  if p-fin-doc-type = 'апр':U
      513                                             then buf_contract.posr-sign
      514                                             else tt-fin-doc.receiver-sign1
      515           .
      516        end.
      517        when 3 then do:
      518           assign
      519           error-status:error = no.
      520           if buf_contract.agnt-code-schet > 0
      521           then do:
      522             assign
      523             v-code-schet = buf_contract.agnt-code-schet
      524             .
      525             run get-bank-requisite in this-procedure (
      526                                                       input buf_contract.host-code
      527                                                       ,input v-code-schet
      528                                                       ,output v-bank-name
      529                                                       ,output v-bank-city
      530                                                       ,output v-dop1
      531                                                       ,output v-dop2
      532                                                       ,output v-bik
      533                                                       ,output v-c-schet
      534                                                       ,output v-r-schet
      535                                                       ,output v-receiver-schet-curr-code
      536                                                       ,output v-receiver-schet-curr-abbr
      537                                                         ) no-error .
      538           end.
      539           if buf_contract.agnt-code-schet = 0
      540           or error-status:error then do:
      541             assign
      542             v-code-schet = buf_contract.agnt-code-schet-start
      543             .
      544             run get-bank-requisite in this-procedure (
      545                                                       input buf_contract.host-code
      546                                                       ,input v-code-schet
      547                                                       ,output v-bank-name
      548                                                       ,output v-bank-city
      549                                                       ,output v-dop1
      550                                                       ,output v-dop2
      551                                                       ,output v-bik
      552                                                       ,output v-c-schet
      553                                                       ,output v-r-schet
      554                                                       ,output v-receiver-schet-curr-code
      555                                                       ,output v-receiver-schet-curr-abbr
      556                                                         ) no-error .
      557           end.
      558           assign
      559           tt-fin-doc.receiver-code       =  buf_contract.agnt-code
      560           tt-fin-doc.receiver-type       =  buf_contract.agnt-type
      561           tt-fin-doc.receiver-name       =  buf_contract.agnt-name
      562           tt-fin-doc.receiver-inn        =  buf_contract.agnt-inn
      563           tt-fin-doc.receiver-kpp        =  buf_contract.agnt-kpp
      564           tt-fin-doc.receiver-sign1      =  if p-fin-doc-type = 'апр':U
      565                                             then  buf_contract.agnt-sign
      566                                             else tt-fin-doc.receiver-sign1
      567           .
      568        end.
      569      end case.
      570      assign
      571       tt-fin-doc.receiver-bank-name  =  v-bank-name
      572       tt-fin-doc.receiver-bank-city  =  v-bank-city
      573       tt-fin-doc.receiver-dop1       =  v-dop1
      574       tt-fin-doc.receiver-dop2       =  v-dop2
      575       tt-fin-doc.receiver-bik        =  v-bik
      576       tt-fin-doc.receiver-code-schet =  (if p-fin-doc-type = 'ппп':U
      577                                          or p-fin-doc-type = 'рпп':U
      578                                         then v-code-schet
      579                                         else 0)
      580       tt-fin-doc.receiver-c-schet    =  v-c-schet
      581       tt-fin-doc.receiver-r-schet    =  v-r-schet
      582       .
      583       assign
      584       error-status:error = no
      585       .
      586       ASSIGN
      587       v-code-schet = 0
      588       v-bank-name  = '':U
      589       v-dop1 = '':U
      590       v-dop2 = '':u
      591       v-bik = '':U
      592       V-c-schet = '':U
      593       v-r-schet = '':U
      594       .
      595       if buf_contract.own-code-schet > 0
      596       then do:
      597         ASSIGN
      598         v-code-schet = buf_contract.own-code-schet.
      599         run get-bank-requisite in this-procedure (
      600                                                    input buf_contract.host-code
      601                                                   ,input v-code-schet
      602                                                   ,output v-bank-name
      603                                                   ,output v-bank-city
      604                                                   ,output v-dop1
      605                                                   ,output v-dop2
      606                                                   ,output v-bik
      607                                                   ,output v-c-schet
      608                                                   ,output v-r-schet
      609                                                   ,output v-payer-schet-curr-code
      610                                                   ,output v-payer-schet-curr-abbr
      611                                                     ) no-error .
      612       end.
      613       if buf_contract.own-code-schet = 0
      614       or error-status:error then do:
      615         ASSIGN
      616         v-code-schet = buf_contract.own-code-schet-start.
      617         run get-bank-requisite in this-procedure (
      618                                                    input buf_contract.host-code
      619                                                   ,input v-code-schet
      620                                                   ,output v-bank-name
      621                                                   ,output v-bank-city
      622                                                   ,output v-dop1
      623                                                   ,output v-dop2
      624                                                   ,output v-bik
      625                                                   ,output v-c-schet
      626                                                   ,output v-r-schet
      627                                                   ,output v-payer-schet-curr-code
      628                                                   ,output v-payer-schet-curr-abbr
      629                                                     ) no-error .
      630       end.
      631       assign
      632       tt-fin-doc.payer-code       =  p-host-code
      633       tt-fin-doc.payer-type       =  'орг':U
      634       tt-fin-doc.payer-name       =  buf_contract.own-name
      635       tt-fin-doc.payer-inn        =  buf_contract.own-inn
      636       tt-fin-doc.payer-kpp        =  buf_contract.own-kpp
      637       tt-fin-doc.payer-bank-name  =  v-bank-name
      638       tt-fin-doc.payer-bank-city  =  v-bank-city
      639       tt-fin-doc.payer-dop1       =  v-dop1
      640       tt-fin-doc.payer-dop2       =  v-dop2
      641       tt-fin-doc.payer-bik        =  v-bik
      642       tt-fin-doc.payer-code-schet =  (if p-fin-doc-type = 'ппп':U
      643                                      or p-fin-doc-type = 'рпп':U
      644                                      then v-code-schet
      645                                      else 0)
      646       tt-fin-doc.payer-c-schet    =  v-c-schet
      647       tt-fin-doc.payer-r-schet    =  v-r-schet
      648       tt-fin-doc.payer-sign1     =  if p-fin-doc-type = 'апр':U or p-fin-doc-type = 'рко':U
      649                                      then (buf_contract.own-sign-post + chr(4) + buf_contract.own-sign)
      650                                      else (if p-fin-doc-type = 'рпп':U
      651                                            then buf_contract.own-sign
      652                                            else tt-fin-doc.payer-sign1)
      653       .
      654     end.
      655     end case.
      656     assign
      657     tt-fin-doc.contract-curr      =  buf_contract.curr-code
      658     .
      659     if (p-fin-doc-type = 'ппп':U
      660     or p-fin-doc-type = 'рпп':U)
      661     AND
      662     (tt-fin-doc.curr-code <> v-payer-schet-curr-code
      663     or tt-fin-doc.curr-code <> v-receiver-schet-curr-code) then do:
      664       if v-payer-schet-curr-code = v-receiver-schet-curr-code then do:
      665         assign
      666         v-sel-curr = string(v-payer-schet-curr-code)
      667         .
      668       end.
      669       else do:
      670   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      671   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      672     (input  p-host-code
      673     ,output v-base-code
      674     )  .
      675         find first buf_currency no-lock where
      676                   buf_currency.curr-code = v-base-code.
      677         assign
      678         v-base-curr-abbr = buf_currency.curr-abbr.
      679         find first buf_currency no-lock where
      680                   buf_currency.curr-code = tt-fin-doc.contract-curr.
      681         assign
      682         v-curr-abbr-contr = buf_currency.curr-abbr.
      683         assign
      684         v-desc     = substitute(("Валюта контракта - &1|" +
      685                                 "Валюта текущего счета контракта для &2 - &3|" +
      686                                 "Валюта текущего счета контракта для &4 - &5|" +
      687                                 "Рубли|" +
      688                                 "Базовая валюта фирмы &6 - &7|" +
      689                                 "Отказ от создания платежа"),
      690                                   v-curr-abbr-contr,
      691                                   tt-fin-doc.receiver-name, v-receiver-schet-curr-abbr,
      692                                   tt-fin-doc.payer-name, v-payer-schet-curr-abbr,
      693                                   (if p-fin-doc-type = 'пко':U
      694                                   or p-fin-doc-type = 'ппп':U
      695                                   or p-fin-doc-type = 'апп':U
      696                                   then tt-fin-doc.receiver-name
      697                                   else tt-fin-doc.payer-name), v-base-curr-abbr)
      698         v-buttons  = substitute("&1|&2|&3|0|&4|?",
      699                                   buf_contract.curr-code,
      700                                   v-receiver-schet-curr-code,
      701                                   v-payer-schet-curr-code,
      702                                   v-base-code)
      703         .
      704         run gbl/d-list.w (
      705                       input "b-sel"
      706                     , input "Выберите валюту платежа"
      707                     , input v-buttons
      708                     , input v-desc
      709                     , input "|":U
      710                     , input "":U
      711                     , output v-sel-curr) no-error .
      712        if error-status:error then undo, return error "exit".
      713         if v-sel-curr = chr(63) or v-sel-curr = "":U then do:
      714           message
      715           "Не выбрана валюта платежа"
      716           view-as alert-box error .
      717           return error "exit":U.
      718         end.
      719       end.
      720     end.
      721     assign
      722     tt-fin-doc.curr-code = integer(v-sel-curr)
      723     .
      724     if v-payer-schet-curr-code <>  tt-fin-doc.curr-code then do:
      725       assign
      726       tt-fin-doc.payer-bank-name  =  "":U
      727       tt-fin-doc.payer-bank-city  =  "":U
      728       tt-fin-doc.payer-dop1       =  "":U
      729       tt-fin-doc.payer-dop2       =  "":U
      730       tt-fin-doc.payer-bik        =  "":U
      731       tt-fin-doc.payer-code-schet =  0
      732       tt-fin-doc.payer-c-schet    =  "":U
      733       tt-fin-doc.payer-r-schet    =  "":U
      734       .
      735     end.
      736     if v-receiver-schet-curr-code <>  tt-fin-doc.curr-code then do:
      737       assign
      738       tt-fin-doc.receiver-bank-name  =  "":U
      739       tt-fin-doc.receiver-bank-city  =  "":U
      740       tt-fin-doc.receiver-dop1       =  "":U
      741       tt-fin-doc.receiver-dop2       =  "":U
      742       tt-fin-doc.receiver-code-schet =  0
      743       tt-fin-doc.receiver-c-schet    =  "":U
      744       tt-fin-doc.receiver-r-schet    =  "":U
      745       .
      746     end.
      747     CASE p-fin-doc-type :
      748       when 'пко':U then do:
      749         assign
      750         tt-fin-doc.cel-nazn-code = buf_contract.cel-nazn-code-in-cash
      751         tt-fin-doc.an-uchet-code = buf_contract.an-uchet-code-in-cash
      752         tt-fin-doc.cor-acc       = buf_contract.cor-acc-in-cash
      753         tt-fin-doc.cor-acc1      = buf_contract.cor-acc1-in-cash
      754         .
      755       end.
      756       when 'рко':U then do:
      757         assign
      758         tt-fin-doc.cel-nazn-code = buf_contract.cel-nazn-code-out-cash
      759         tt-fin-doc.an-uchet-code = buf_contract.an-uchet-code-out-cash
      760         tt-fin-doc.cor-acc       = buf_contract.cor-acc-out-cash
      761         tt-fin-doc.cor-acc1      = buf_contract.cor-acc1-out-cash
      762         .
      763       end.
      764       when 'ппп':U then do:
      765         assign
      766         tt-fin-doc.cel-nazn-code = buf_contract.cel-nazn-code-in
      767         tt-fin-doc.an-uchet-code = buf_contract.an-uchet-code-in
      768         tt-fin-doc.cor-acc       = buf_contract.cor-acc-in
      769         tt-fin-doc.cor-acc1      = buf_contract.cor-acc1-in
      770         .
      771       end.
      772       when 'рпп':U then do:
      773         assign
      774         tt-fin-doc.cel-nazn-code = buf_contract.cel-nazn-code-out
      775         tt-fin-doc.an-uchet-code = buf_contract.an-uchet-code-out
      776         tt-fin-doc.cor-acc       = buf_contract.cor-acc-out
      777         tt-fin-doc.cor-acc1      = buf_contract.cor-acc1-out
      778         .
      779       end.
      780       when 'апп':U then do:
      781         assign
      782         tt-fin-doc.cel-nazn-code = buf_contract.cel-nazn-code-in-payoff
      783         tt-fin-doc.an-uchet-code = buf_contract.an-uchet-code-in-payoff
      784         tt-fin-doc.cor-acc       = buf_contract.cor-acc-in-payoff
      785         tt-fin-doc.cor-acc1      = buf_contract.cor-acc1-in-payoff
      786         .
      787       end.
      788       when 'апр':U then do:
      789         assign
      790         tt-fin-doc.cel-nazn-code = buf_contract.cel-nazn-code-out-payoff
      791         tt-fin-doc.an-uchet-code = buf_contract.an-uchet-code-out-payoff
      792         tt-fin-doc.cor-acc       = buf_contract.cor-acc-out-payoff
      793         tt-fin-doc.cor-acc1      = buf_contract.cor-acc1-out-payoff
      794         .
      795       end.
      796     END CASE.
      797     find first tt0-fin-doc.
      798     buffer-copy tt-fin-doc to tt0-fin-doc.
      799     return "":U.
      800   end.
      801   procedure get-bank-requisite :
      802   define input parameter p-host-code like ub.fin-schet.host-code no-undo .
      803   define input parameter p-code-schet like ub.fin-schet.code-schet no-undo .
      804   define output parameter p-bank-name like ub.fin-bank.bank-name no-undo .
      805   define output parameter p-bank-city like ub.fin-bank.bank-city no-undo .
      806   define output parameter p-dop1      like ub.fin-schet.dop1 no-undo .
      807   define output parameter p-dop2      like ub.fin-schet.dop2 no-undo .
      808   define output parameter p-bik like ub.fin-bank.bik no-undo .
      809   define output parameter p-c-schet like ub.fin-bank.cor-acc no-undo .
      810   define output parameter p-r-schet like ub.fin-schet.r-schet no-undo .
      811   define output parameter p-curr-code like ub.fin-schet.curr-code no-undo .
      812   define output parameter p-curr-abbr  like ub.currency.curr-abbr no-undo .
      813   define buffer buf_fin-schet for ub.fin-schet.
      814   define buffer buf_fin-bank for ub.fin-bank.
      815   define buffer buf_currency for ub.currency.
      816     do
      817     on error undo, return error
      818     :
      819         if p-fin-doc-type <> 'ппп':U
      820         AND p-fin-doc-type <> 'рпп':U then return.
      821         find first buf_fin-schet no-lock where
      822                   buf_fin-schet.code-schet = p-code-schet
      823               AND buf_fin-schet.host-code  = p-host-code no-error .
      824         if available buf_fin-schet then do:
      825           find first buf_fin-bank no-lock where
      826                     buf_fin-bank.host-code = p-host-code
      827                  AND buf_fin-bank.code-bank = buf_fin-schet.code-bank no-error .
      828           if available buf_fin-bank then do:
      829             assign
      830             p-bank-name = buf_fin-bank.bank-name
      831             p-bank-city = buf_fin-bank.bank-city
      832             p-dop1     = buf_fin-schet.dop1
      833             p-dop2     = buf_fin-schet.dop2
      834             p-bik = buf_fin-bank.bik
      835             p-c-schet = buf_fin-bank.cor-acc
      836             p-r-schet = buf_fin-schet.r-schet
      837             p-curr-code = buf_fin-schet.curr-code
      838             .
      839             find first buf_currency no-lock where
      840                       buf_currency.curr-code = p-curr-code.
      841             assign
      842             p-curr-abbr = buf_currency.curr-abbr
      843             .
      844           end.
      845           else return error.
      846         end.
      847         else return error.
      848     end.
      849   end procedure.
