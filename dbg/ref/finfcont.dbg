      320             tt-fin-doc.payer-type       =  buf_contract.agnt-type
      321             tt-fin-doc.payer-name       =  buf_contract.agnt-name
      322             tt-fin-doc.payer-inn        =  buf_contract.agnt-inn
      323             tt-fin-doc.payer-kpp        =  buf_contract.agnt-kpp
