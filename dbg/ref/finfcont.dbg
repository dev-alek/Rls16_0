        1   block-level on error undo, throw.
        2   DEFINE TEMP-TABLE tt0-fin-doc NO-UNDO LIKE ub.fin-doc.
        3   define temp-table tt-fin-doc no-undo like ub.fin-doc.
        4   define input parameter parparentproc      as widget-handle no-undo .
        5   define input parameter p-host-code        like ub.contract.host-code no-undo .
        6   define input parameter p-mode as character no-undo.
        7   define input parameter p-fin-doc-code     like ub.fin-doc.fin-doc-code no-undo .
        8   define input parameter p-fin-doc-type     like ub.fin-doc.fin-doc-type no-undo .
        9   define input parameter p-fin-ext-doc-type like ub.fin-doc.fin-ext-doc-type no-undo .
       10   define input parameter p-contract-code    like ub.fin-doc.contract-code no-undo .
       11   define INPUT-OUTPUT parameter table for tt0-fin-doc.
       12   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       13   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       14   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile: finfcont.p $":U .
       16   define variable vss-archive     as character no-undo init "$Archive: ref/finfcont.p $":U .
       17   define variable vss-description as character no-undo init "".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define variable v-buttons as character no-undo .
       79   define variable v-desc as character no-undo .
       80   define variable v-t as character no-undo .
       81   define variable v-num as integer no-undo .
       82   define variable v-bank-name like ub.fin-bank.bank-name no-undo .
       83   define variable v-bank-city like ub.fin-bank.bank-city no-undo .
       84   define variable v-dop1     like ub.fin-schet.dop1     no-undo .
       85   define variable v-dop2     like ub.fin-schet.dop2     no-undo .
       86   define variable v-bik like ub.fin-bank.bik no-undo .
       87   define variable v-c-schet like ub.fin-bank.cor-acc no-undo .
       88   define variable v-r-schet like ub.fin-schet.r-schet no-undo .
       89   define variable v-code-schet like ub.fin-schet.code-schet no-undo .
       90   define variable v-payer-schet-curr-code like ub.fin-schet.curr-code no-undo .
       91   define variable v-receiver-schet-curr-code like ub.fin-schet.curr-code no-undo .
       92   define variable v-payer-schet-curr-abbr like ub.currency.curr-abbr no-undo .
       93   define variable v-receiver-schet-curr-abbr like ub.currency.curr-abbr no-undo .
       94   define variable v-base-code like ub.sysconf.base-code no-undo .
       95   define variable v-base-curr-abbr like ub.currency.curr-abbr no-undo .
       96   define variable v-curr-abbr-contr like ub.currency.curr-abbr no-undo .
       97   define variable v-sel-curr as character no-undo .
       98   define buffer buf_contract for ub.contract.
       99   define buffer buf_tt-fin-doc for tt-fin-doc.
      100   define buffer buf_currency for ub.currency.
      101   find first buf_contract no-lock where
      102            buf_contract.contract-code = p-contract-code
      103        and buf_contract.host-code     = p-host-code   no-error .
      104   if error-status :error then do:
      105      return error substitute("Не найден контракт с кодом &1 по фирме &2", p-contract-code, p-host-code).
      106   end.
      107   if p-fin-doc-type = 'пко':U
      108   or  p-fin-doc-type = 'ппп':U
      109   or  p-fin-doc-type = 'апп':U
      110   then assign
      111     v-t = "Плательщика"
      112   .
      113   else assign
      114     v-t = "Получателя"
      115   .
      116   v-num = 1.
      117   if not( buf_contract.posr-name = ""
      118   and     buf_contract.agnt-name = "")
      119   and p-mode = 'ДОБАВЛЕНИЕ':U then do:
      120       assign
      121       v-buttons  = "Контрагент" + "|" +
      122                   (if buf_contract.posr-name <> "" then "Посредник" else "Посредник^disable") + "|" +
      123                   (if buf_contract.agnt-name <> "" then "Агент"     else "Агент^disable" )    + "|" +
      124                   "Отмена"
      125       v-desc     = buf_contract.cli-name + "|" +
      126                   buf_contract.posr-name + "|" +
      127                   buf_contract.agnt-name + "|" +
      128                   "Отказ от создания платежа"
      129       .
      130       run gbl/d-askw.w
      131         (input "Внимание!"
      132         ,input "Выберите " + v-t + " по платежу"
      133         ,input "|^"
      134         ,input v-buttons
      135         ,input v-desc
      136         ,input 1
      137         ,input 4
      138         ,output v-num
      139         ).
      140   end.
      141   else do:
      142     assign
      143     v-num = 1
      144     .
      145   end.
      146   if v-num = 4 then do:
      147      return error "exit":U.
      148   end.
      149   do
      150   on error undo, return error
      151   :
      152     for each tt0-fin-doc no-lock where
      153                 tt0-fin-doc.host-code = p-host-code
      154           AND tt0-fin-doc.fin-doc-code = p-fin-doc-code:
      155       create buf_tt-fin-doc.
      156       buffer-copy tt0-fin-doc to buf_tt-fin-doc.
      157     END.
      158     find first tt-fin-doc no-error .
      159     if not avail tt-fin-doc then do:
      160       return error "":U.
      161     end.
      162     case p-fin-doc-type :
      163         when 'пко':U
      164         or
      165         when 'ппп':U
      166         or
      167         when 'апп':U
      168         then do:
      169           case v-num :
      170             when 1 then do:
      171               assign
      172               error-status:error = no
      173               .
      174               if buf_contract.cli-code-schet > 0
      175               then do:
      176                 assign
      177                 v-code-schet = buf_contract.cli-code-schet
      178                 .
      179                 run get-bank-requisite in this-procedure (
      180                                                           input buf_contract.host-code
      181                                                           ,input v-code-schet
      182                                                           ,output v-bank-name
      183                                                           ,output v-bank-city
      184                                                           ,output v-dop1
      185                                                           ,output v-dop2
      186                                                           ,output v-bik
      187                                                           ,output v-c-schet
      188                                                           ,output v-r-schet
      189                                                           ,output v-payer-schet-curr-code
      190                                                           ,output v-payer-schet-curr-abbr
      191                                                             ) no-error .
      192               end.
      193               if buf_contract.cli-code-schet = 0
      194               or error-status:error then do:
      195                 assign
      196                 v-code-schet = buf_contract.cli-code-schet-start
      197                 .
      198                 run get-bank-requisite in this-procedure (
      199                                                           input buf_contract.host-code
      200                                                           ,input v-code-schet
      201                                                           ,output v-bank-name
      202                                                           ,output v-bank-city
      203                                                           ,output v-dop1
      204                                                           ,output v-dop2
      205                                                           ,output v-bik
      206                                                           ,output v-c-schet
      207                                                           ,output v-r-schet
      208                                                           ,output v-payer-schet-curr-code
      209                                                           ,output v-payer-schet-curr-abbr
      210                                                             ) no-error .
      211               end.
      212               assign
      213               tt-fin-doc.payer-code       =  buf_contract.cli-code
      214               tt-fin-doc.payer-type       =  buf_contract.cli-type
      215               tt-fin-doc.payer-name       =  buf_contract.cli-name
      216               tt-fin-doc.payer-inn        =  buf_contract.cli-inn
