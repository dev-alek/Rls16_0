        1   block-level on error undo, throw.
        2   define input  parameter p-open-query     as logical   no-undo .
        3   define input  parameter p-find-next      as logical   no-undo .
        4   define input  parameter p-find-condition as character no-undo .
        5   define input  parameter a-n-c       as character no-undo .
        6   define input  parameter NameContext as character no-undo .
        7   define input  parameter rs-sort     as character no-undo .
        8   define input  parameter g-cond      as character no-undo .
        9   define input  parameter g-list      as character no-undo .
       10   define input  parameter g-stat      as character no-undo .
       11   define input  parameter g-grp       like ub.goods.grp-name no-undo.
       12   define input  parameter pobj-type   like ub.clients.obj-type no-undo.
       13   define input  parameter pobj-code   like ub.clients.obj-code no-undo.
       14   define parameter buffer g-producer for ub.clients.
       15   define parameter buffer cur-obj for ub.clients.
       16   define output parameter for-title as character no-undo .
       17   define input  parameter filter-point as character no-undo .
       18   define input  parameter filter-point0 as character no-undo .
       19   define input  parameter sort-column-name as character no-undo .
       20   define output parameter p-filter-name   as character  no-undo .
       21   define input-output parameter v-doc-rec as recid no-undo .
       22   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       23   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       24   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       25   define variable vss-workfile    as character no-undo init "$Workfile: gds-refa.p $":U .
       26   define variable vss-archive     as character no-undo init "$Archive: ref/gds-refa.p $":U .
       27   define variable vss-description as character no-undo init "Открытие запроса в справочнике товаров".
       28   procedure vss-get-info :
       29     define output parameter p-vss-revision    like vss-revision    no-undo .
       30     define output parameter p-vss-author      like vss-author      no-undo .
       31     define output parameter p-vss-date        like vss-date        no-undo .
       32     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       33     define output parameter p-vss-archive     like vss-archive     no-undo .
       34     define output parameter p-vss-description like vss-description no-undo .
       35     assign
       36       p-vss-revision    = vss-revision
       37       p-vss-author      = vss-author
       38       p-vss-date        = vss-date
       39       p-vss-workfile    = vss-workfile
       40       p-vss-archive     = vss-archive
       41       p-vss-description = vss-description
       42     .
       43   end procedure.
       44   procedure vss-get-parameters :
       45     define output parameter p-vss-parameters as character no-undo .
       46       assign
       47         p-vss-parameters = substitute('&1|&2':u,substitute('&1|&2|&3|&4|&5':u,a-n-c,NameContext,rs-sort,g-cond,g-list),substitute('&1|&2|&3|&4':u,g-stat,g-grp,pobj-type,pobj-code))
       48       .
       49   end procedure.
       50   define new global shared variable g#vssrevis-logger as handle    no-undo .
       51   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       52   define variable v-vssrevis-logger                   as handle    no-undo .
       53   procedure vss-logevent :
       54     define input  parameter p-extra-paramters as character no-undo .
       55     define variable v-vssrevis-parameters as character no-undo .
       56     do
       57     on error undo, return error return-value
       58     :
       59       if  valid-handle(v-vssrevis-logger)
       60       and v-vssrevis-logger :get-signature("logevent") <> ""
       61       then do:
       62         run vss-get-parameters in this-procedure
       63           (output v-vssrevis-parameters
       64           ).
       65         run logevent in v-vssrevis-logger
       66           (input vss-workfile
       67           ,input vss-revision
       68           ,input v-vssrevis-parameters
       69           ,input p-extra-paramters
       70           ).
       71       end.
       72     end.
       73   end procedure.
       74   assign
       75     v-vssrevis-logger = g#vssrevis-logger
       76   .
       77   if  valid-handle(v-vssrevis-logger)
       78   and v-vssrevis-logger :get-signature("logevent") <> ""
       79   then do:
       80     assign
       81       v-vssrevis-logevent = true
       82     .
       83     run vss-logevent in this-procedure (input vss-description) .
       84   end.
       85   define new global shared variable g#language as character no-undo .
       86   if g#language <> '' and g#language <> 'rus':U then do:
       87     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       88   end.
       89   DEFINE SHARED buffer gob-doc FOR ub.gds-obj.
       90   DEFINE SHARED buffer goo-doc FOR ub.goods.
       91   DEFINE SHARED buffer gam-doc FOR ub.assortment-matrix-goods.
       92   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       93   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       94   define variable v-fltopend-rowid as rowid extent 18 no-undo .
       95   procedure fltopend_fltopend :
       96   define input parameter p-parent-handle as handle no-undo .
       97   define input parameter p-qh as handle no-undo .
       98   define input parameter p-flt-open-open-query  as character no-undo .
       99   define input parameter p-where-cond as character no-undo .
      100   define input parameter p-use-indFIRST-query-tail as character no-undo .
      101   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      102   define input parameter p-indexed-reposition as character no-undo .
      103     do
      104     on error undo, return error
      105     :
      106   define variable v-prepare-string as character no-undo .
      107   define variable glog as logical no-undo .
      108   assign
      109   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      110                      p-where-cond + chr(32)  +
      111                      p-use-indFIRST-query-tail + chr(32) +
      112                      p-use-ind-sort-clmn-by + chr(32) +
      113                      p-indexed-reposition
      114   .
      115   assign
      116   glog = p-qh:query-prepare(v-prepare-string) no-error .
      117   if not glog
      118   or error-status:error then do:
      119     message error-status:get-message(1) view-as alert-box .
      120     undo, return error .
      121   end.
      122   assign
      123   glog = p-qh:query-open no-error .
      124   if not glog
      125   or error-status:error then do:
      126     message error-status:get-message(1) view-as alert-box .
      127     undo, return error .
      128   end.
      129     end.
      130   end procedure.
      131   procedure fltopend_fltfindd :
      132   define input parameter p-parent-handle as handle no-undo .
      133   define input parameter p-qh as handle no-undo .
      134   define input parameter p-rowid as rowid no-undo .
      135   define input parameter p-next as logical no-undo .
      136   define input parameter p-lock as integer no-undo .
      137   define input parameter p-bh as handle no-undo .
      138   define input parameter p-where-cond as character no-undo .
      139   define input parameter p-use-index-phrase as character no-undo .
      140   define variable glog as logical no-undo .
      141   define variable v-qh as handle no-undo .
      142   define variable v-bh as handle no-undo .
      143   define variable v-recid as recid no-undo .
      144   define variable v-prepare-string as character no-undo .
      145   do
      146   on error undo, return error
      147   on stop undo, return error
      148   :
      149     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      150     create buffer v-bh for table p-bh buffer-name p-bh:name.
      151     create query v-qh.
      152     v-qh:set-buffers(v-bh).
      153     v-prepare-string = substitute("for each &1 &2 &3"
      154                                     ,v-bh:name
      155                                     ,p-where-cond
      156                                     ,p-use-index-phrase).
      157     glog = v-qh:query-prepare(v-prepare-string) no-error.
      158     if not glog then do:
      159       delete object v-qh.
      160       delete object v-bh.
      161       undo, return error .
      162     end.
      163     glog = v-qh:query-open no-error .
      164     if not glog then do:
      165       delete object v-qh.
      166       delete object v-bh.
      167       undo, return error .
      168     end.
      169     if p-next then do:
      170       v-qh:reposition-to-rowid(p-rowid) no-error .
      171       glog = v-qh:get-next( p-lock) no-error .
      172       glog = v-qh:get-next( p-lock) no-error .
      173       if not glog or v-qh:query-off-end = yes then do:
      174         glog = v-qh:get-first( p-lock) no-error .
      175       end.
      176     end.
      177     else do:
      178       glog = v-qh:get-first( p-lock) no-error .
      179     end.
      180     v-recid = v-bh:recid no-error .
      181     delete object v-qh.
      182     delete object v-bh.
      183     return string(v-recid) .
      184   end.
      185   end procedure.
      186   procedure fltopend_fltfindq :
      187   define input parameter p-parent-handle as handle no-undo .
      188   define input parameter p-qh as handle no-undo .
      189   define input parameter p-next as logical no-undo .
      190   define input parameter p-lock as integer no-undo .
      191   define input parameter p-flt-open-open-query  as character no-undo .
      192   define input parameter p-where-cond as character no-undo .
      193   define input parameter p-use-indFIRST-query-tail as character no-undo .
      194   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      195   define input parameter p-indexed-reposition as character no-undo .
      196   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      197   define variable glog as logical no-undo .
      198   define variable v-qh as handle no-undo .
      199   define variable v-bh as handle no-undo extent 18.
      200   define variable v-rowid as rowid no-undo extent 18.
      201   define variable v-ii as integer no-undo .
      202   define variable v-prepare-string as character no-undo .
      203   do
      204   on error undo, return error
      205   on stop undo, return error
      206   :
      207     create query v-qh.
      208     do v-ii = 1 to p-qh:num-buffers:
      209       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      210       assign
      211       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      212       no-error.
      213       v-qh:add-buffer(v-bh[v-ii]).
      214     end.
      215     assign
      216     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      217                       p-where-cond + chr(32)  +
      218                       p-use-indFIRST-query-tail + chr(32) +
      219                       p-use-ind-sort-clmn-by + chr(32) +
      220                       p-indexed-reposition
      221     .
      222     glog = v-qh:query-prepare( v-prepare-string) no-error .
      223     if not glog then do:
      224       delete object v-qh.
      225       do v-ii = 1 to p-qh:num-buffers:
      226         delete object v-bh[v-ii].
      227       end.
      228       undo, return error .
      229     end.
      230     glog = v-qh:query-open no-error .
      231     if not glog then do:
      232       delete object v-qh.
      233       do v-ii = 1 to p-qh:num-buffers:
      234         delete object v-bh[v-ii].
      235       end.
      236       undo, return error .
      237     end.
      238     if p-next then do:
      239       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      240       glog = v-qh:get-next( p-lock) no-error .
      241       glog = v-qh:get-next( p-lock) no-error .
      242       if not glog or v-qh:query-off-end = yes then do:
      243         glog = v-qh:get-first( p-lock) no-error .
      244       end.
      245     end.
      246     else do:
      247       glog = v-qh:get-first( p-lock) no-error .
      248     end.
      249     do v-ii = 1 to p-qh:num-buffers:
      250       assign
      251       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      252       no-error.
      253     end.
      254     delete object v-qh.
      255     do v-ii = 1 to p-qh:num-buffers:
      256       delete object v-bh[v-ii].
      257     end.
      258   end.
      259   end procedure.
      260   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      261   define variable v-waitfram-action01         as character   no-undo .
      262   define variable v-waitfram-action02         as character   no-undo .
      263   define variable v-waitfram-action03         as character   no-undo .
      264   define variable mWaitFramTextBeg            as character   no-undo.
      265   define variable mWaitFramTextEnd            as character   no-undo.
      266   define variable mWaitFramView               as logical     no-undo.
      267   define variable mWaitProcEvent              as logical     no-undo init yes.
      268   define variable mWaitFramInterval           as integer     no-undo init 1 .
      269   define variable mWaitFramStop               as logical     no-undo.
      270   define variable mWaitFramStopUser           as logical     no-undo.
      271   define variable mWaitFramStopTimeOut        as logical     no-undo.
      272   define variable mWaitFramStartProc          as datetime-tz no-undo.
      273   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      274   define button B-WaitFramStop auto-end-key
      275        label "Стоп"
      276        size 10 by 1 tooltip "Остоновить процесс".
      277   define button B-viewProcInfo
      278        label "Информация"
      279        size 15 by 1 tooltip "Информация о процесс".
      280   define frame waitfram
      281     v-waitfram-action01 format "x(72)" no-label skip
      282     v-waitfram-action02 format "x(72)" no-label skip
      283     v-waitfram-action03 format "x(72)" no-label skip
      284     B-viewProcInfo
      285     B-WaitFramStop at row 4 col 30
      286     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      287     .
      288   define new global shared variable mBatchMode as logical no-undo init ?.
      289   define variable mFramBachModHandle as handle no-undo.
      290   mFramBachModHandle = frame waitfram:handle.
      291   define variable mFameOldVis as logical no-undo.
      292   define variable mVisCUrentVin as logical no-undo.
      293   if session:batch-mode
      294   then
      295      mBatchMode = yes.
      296   if mBatchMode = ? then do:
      297     mVisCUrentVin = current-window:visible.
      298     mFameOldVis = mFramBachModHandle:visible.
      299     mFramBachModHandle:visible  = yes.
      300     mBatchMode = mFramBachModHandle:visible ne yes.
      301     mFramBachModHandle:visible = mFameOldVis.
      302     current-window:visible = mVisCUrentVin.
      303   end.
      304    if  log-manager:logfile-name ne ?
      305     then DO:
      306         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      307         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      308         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      309     end.
      310   on choose of B-WaitFramStop in frame waitfram
      311   do:
      312     mWaitFramStop = yes.
      313     mWaitFramStopUser = yes.
      314   end.
      315   function waitfram-check-timeout returns logical():
      316      define variable vtime as int64 no-undo.
      317      if mWaitFramStopTimeOut
      318      then
      319         return yes.
      320      vtime = ( now - mWaitFramStartProc ) / 1000 .
      321      if     mWaitFramTimeOut ne ?
      322         and mWaitFramTimeOut ne 0
      323         and mWaitFramTimeOut lt vtime
      324      then do:
      325         mWaitFramStopTimeOut = yes.
      326      end.
      327      return mWaitFramStopTimeOut.
      328   end.
      329   procedure waitfram-hide :
      330     if not session:batch-mode
      331     then do
      332     on error undo, return error return-value
      333     :
      334       pause 0 before-hide .
      335       if not mBatchMode then
      336         hide frame waitfram .
      337     end.
      338   end procedure.
      339   procedure waitfram-show :
      340     define input  parameter p-message as character no-undo .
      341     define variable v-left-margin as integer   no-undo .
      342     if not session:batch-mode
      343     then do
      344     on error undo, return error return-value
      345     :
      346       if length(p-message) <= 70 then do:
      347         assign
      348           v-left-margin = integer((70 - length(p-message)) / 2)
      349         .
      350         assign
      351           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      352         .
      353         assign
      354           v-waitfram-action01 = " "
      355           v-waitfram-action02 = " "
      356                                    + fill(" ", v-left-margin)
      357                                    + p-message
      358           v-waitfram-action03 = " "
      359         .
      360       end.
      361       else do:
      362         define variable vRindex1 as integer no-undo.
      363         define variable vRindex2 as integer no-undo.
      364         vRindex1 = r-index(p-message," ",70).
      365         if vRindex1 = 0
      366         then
      367            vRindex1 = 70.
      368         if length(p-message)  <= vRindex1 + 70 then do:
      369           assign
      370             v-waitfram-action01 = " "
      371             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      372             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      373           .
      374         end.
      375         else do:
      376           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      377           if vRindex2 <= vRindex1
      378           then
      379              vRindex2 = vRindex1 + 70.
      380           assign
      381             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      382             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      383             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      384           .
      385         end.
      386       end.
      387       B-viewProcInfo:visible   in frame waitfram = no.
      388       B-viewProcInfo:sensitive in frame waitfram = no.
      389       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      390       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      391       if  (   mWaitFramView
      392          or  mWaitProcEvent)
      393          and not mBatchMode
      394       then
      395          display
      396             v-waitfram-action01 skip
      397             v-waitfram-action02 skip
      398             v-waitfram-action03 skip
      399          with frame waitfram .
      400     end.
      401   end procedure.
      402      procedure waitfram-show-this:
      403         define input  parameter iInterval as int64 no-undo.
      404         define variable vtime as int64 no-undo.
      405         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      406         mWaitFramInterval = iInterval.
      407         run waitfram-show (substitute("&1&2 &3&4" ,
      408                                       mWaitFramTextBeg ,
      409                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      410                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      411                                       mWaitFramTextEnd
      412                                      )
      413                           ).
      414      end.
      415      procedure WaitFramRunPause:
      416         define input  parameter iInterval as dec no-undo.
      417         define variable vStart  as datetime-tz no-undo.
      418         define variable vend    as datetime-tz no-undo.
      419         define variable vint as int64 no-undo.
      420         define variable vOk as logical no-undo.
      421         vStart = now.
      422         vend   = vStart.
      423         publish "WaitFramPause" (iInterval,output vOk).
      424         vend   =  now.
      425         vint = vend - vStart.
      426         vint = iInterval - vint / 1000.
      427         if     not mWaitFramStop
      428            and (   vint > 0
      429                 or (    not vOk
      430                     and iInterval eq ?
      431                     )
      432                 )
      433         then
      434            run waitfram-show-this (iInterval).
      435         vend   =  now.
      436         vint = vend - vStart.
      437         vint = iInterval - vint / 1000.
      438         if     not mWaitFramStop
      439            and vint > 0
      440         then do:
      441            run gbl/pause.p (vint * 1000).
      442         end.
      443         if iInterval ne ?
      444         then
      445            publish "WaitFramStop".
      446         waitfram-check-timeout().
      447      end.
      448      procedure WaitFramWaitFor:
      449         define input  parameter iInterval as dec no-undo.
      450         assign
      451            mWaitFramStartProc   = now
      452            mWaitFramStopUser    = no
      453            mWaitFramStopTimeOut = no
      454         .
      455         block-wait:
      456         do while not mWaitFramStop:
      457            run WaitFramRunPause (iInterval).
      458            if  waitfram-check-timeout()
      459            then do:
      460               leave block-wait.
      461            end.
      462         end.
      463         run waitfram-hide.
      464      end.
      465   procedure waitfram-join :
      466     define input  parameter p-line-1  as character no-undo .
      467     define input  parameter p-line-2  as character no-undo .
      468     define input  parameter p-line-3  as character no-undo .
      469     define output parameter p-message as character no-undo .
      470     do
      471     on error undo, return error return-value
      472     :
      473       assign
      474         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      475                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      476                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      477       .
      478     end.
      479   end procedure.
      480   function waitfram-join-function returns character
      481     (input p-line-1 as character
      482     ,input p-line-2 as character
      483     ,input p-line-3 as character
      484     ).
      485     define variable v-message as character no-undo .
      486     run waitfram-join in this-procedure
      487       (input  p-line-1
      488       ,input  p-line-2
      489       ,input  p-line-3
      490       ,output v-message
      491       ) .
      492     return v-message .
      493   end function .
      494   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      495   define new global shared variable g#attr-lib  as handle no-undo .
      496   define variable v-attr-lib-variable as handle no-undo .
      497   procedure gds-attr-name :
      498     define input  parameter p-code           as character no-undo .
      499     define output parameter p-type           as character no-undo .
      500     define output parameter p-format         as character no-undo .
      501     define output parameter p-label          as character no-undo .
      502     define output parameter p-user-can-edit  as logical   no-undo .
      503     define output parameter p-output-display as logical   no-undo .
      504     define output parameter p-other          as character no-undo .
      505     do
