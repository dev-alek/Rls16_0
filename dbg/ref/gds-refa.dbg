     1255           v-doc-rec = integer(return-value)
     1256           v-fltopend-rowid[1] = ?
     1257         .
     1258       end.
     1259       else do:
     1260         assign
     1261         parameter-2-6 = (if p-find-next then "true":u else "false":u )
     1262         parameter-3-6 =  "FOR EACH gob-doc no-lock"
     1263         parameter-4-6 =
     1264           (
     1265             if (" goo-doc.stts = 0 and lookup (goo-doc.unit-base, v-list-unit-name, chr(4)) > 0 and not lookup (string(goo-doc.gds-code),v-list-gds-code-lgas, chr(4)) > 0" + " " + where-phrase-6) <> ""
     1266             then " goo-doc.stts = 0 and lookup (goo-doc.unit-base, v-list-unit-name, chr(4)) > 0 and not lookup (string(goo-doc.gds-code),v-list-gds-code-lgas, chr(4)) > 0" + " " + where-phrase-6
     1267             else "true"
     1268           )
     1269         parameter-5-6 = (" " + "" + " " + ", first gam-doc no-lock where   gam-doc.gds-code = gob-doc.gds-code and   gam-doc.asmg-status = 0 and   gam-doc.obj-type = gob-doc.obj-type and   gam-doc.obj-code = gob-doc.obj-code" + " " + p-find-condition)
     1270         parameter-6-6 = if sort-phrase-6 = ''
