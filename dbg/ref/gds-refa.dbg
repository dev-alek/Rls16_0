     1084   DEFINE SHARED QUERY br-gds FOR gob-doc , gam-doc SCROLLING.
     1085   define variable l-open-query as logical   no-undo .
     1086   case sort-column-name :
     1087     when "" then do:
     1088       assign
     1089         sort-column-phrase = ""
     1090       .
     1091     end.
     1092     otherwise do:
     1093       assign
     1094         sort-column-phrase = "by " + sort-column-name
     1095       .
     1096     end.
     1097   end case.
     1098   define variable v-list-unit-name as character no-undo.
     1099   define variable v-list-gds-code-lgas as character no-undo.
     1100   define variable v-attr-type as character no-undo.
     1101   define variable v-attr-value as character no-undo.
     1102   CASE g-list :
     1103     when "ptrl" then do:
     1104       if a-n-c <> "context" OR NameContext = "" then do:
     1105         for-title = "ВСЕ товары".
     1106       for each ub.units no-lock where lookup( 'топ':U, ub.units.type) > 0:
     1107         v-list-unit-name = v-list-unit-name + ub.units.unit-name + chr(4).
     1108       end.
     1109       for each ub.goods no-lock where lookup (ub.goods.unit-base, v-list-unit-name, chr(4)) > 0:
     1110         run gds-attr-value in this-procedure
     1111           (  input ub.goods.gds-code
     1112             ,input 'fuel-type':U
     1113             ,output v-attr-value
     1114             ,output v-attr-type
     1115            ) .
     1116         if v-attr-value = "lgas" then
     1117         do:
     1118           v-list-gds-code-lgas = v-list-gds-code-lgas + string (ub.goods.gds-code) + chr(4).
     1119         end.
     1120       end.
     1121       v-list-unit-name = right-trim(v-list-unit-name,chr(4)).
     1122       v-list-gds-code-lgas = right-trim(v-list-gds-code-lgas,chr(4)).
     1123   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1124   define variable  l-disable-where-6  as logical   no-undo .
