    15386   define variable  filter-name-156      as character no-undo .
    15387   define variable  where-phrase-156     as character no-undo .
    15388   define variable  sort-phrase-156      as character no-undo .
    15389   define variable  where-phrase-rus-156 as character no-undo .
    15390   define variable  sort-phrase-rus-156  as character no-undo .
    15391     run waitfram-show in this-procedure
    15392       (input "ЖДИТЕ ..."
    15393       ).
    15394   run gbl/flt-get.p
    15395     (input filter-point
    15396     ,output flt-rec-156
    15397     ,output filter-name-156
    15398     ,output where-phrase-156
    15399     ,output sort-phrase-156
    15400     ,output where-phrase-rus-156
    15401     ,output sort-phrase-rus-156
    15402     ).
    15403   if p-open-query then do:
    15404       run set-filter-name in this-procedure
    15405         (INPUT filter-name-156
    15406         ) no-error .
    15407     assign
    15408       l-filter-open-156 = false
    15409     .
    15410     if flt-rec-156 <> ?
    15411     then do:
    15412       define variable  parameter-2-156 as character no-undo .
    15413       define variable  parameter-3-156 as character no-undo .
    15414       define variable  parameter-4-156 as character no-undo .
    15415       define variable  parameter-5-156 as character no-undo .
    15416       define variable  parameter-6-156 as character no-undo .
    15417       define variable  parameter-7-156 as character no-undo .
    15418         assign
    15419         parameter-3-156 =
    15420                                 "FOR EACH gob-doc no-lock"
    15421         parameter-4-156 =
    15422           (
    15423             if (" gob-doc.grp-name begins g-grp and gob-doc.obj-type = pobj-type and gob-doc.obj-code = pobj-code                     and gob-doc.free-qnty <> 0 and gob-doc.stts <> 0 " + " " + where-phrase-156) <> ""
    15424             then  substitute('gob-doc.grp-name begins &1&2&1  and gob-doc.obj-type = &1&3&1 and gob-doc.obj-code = &4                     and gob-doc.free-qnty <> 0 and gob-doc.stts <> 0 '                       , chr(34),                   g-grp, pobj-type, pobj-code) + " " + where-phrase-156
    15425             else "true"
    15426           )
    15427         parameter-5-156 = (" " + "" + " " + ", first gam-doc no-lock where   gam-doc.gds-code = gob-doc.gds-code and   gam-doc.asmg-status = 0 and   gam-doc.obj-type = gob-doc.obj-type and   gam-doc.obj-code = gob-doc.obj-code")
    15428         parameter-6-156 = if sort-phrase-156 = ''
    15429                              then
    15430           (
    15431           " " + "  " +
    15432           " " + " by gob-doc.free-qnty                     by gob-doc.artic                     "
    15433           )
    15434                              else
    15435           (
    15436           " " + "  " +
    15437           " " + sort-phrase-156
    15438           )
    15439         parameter-7-156 =
    15440           " indexed-reposition  "
    15441       .
    15442       do
    15443       on stop undo, leave
    15444       on error undo, leave
    15445       :
    15446         assign
    15447           l-disable-where-156 =
    15448             (" gob-doc.grp-name begins g-grp and gob-doc.obj-type = pobj-type and gob-doc.obj-code = pobj-code                     and gob-doc.free-qnty <> 0 and gob-doc.stts <> 0 " + " " + where-phrase-156 = "")
    15449         .
    15450         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
    15451                             ,input query br-gds:handle
    15452                             ,input parameter-3-156
    15453                             ,input parameter-4-156
    15454                             ,input parameter-5-156
    15455                             ,input parameter-6-156
    15456                             ,input parameter-7-156
    15457                             )
    15458         .
    15459         assign
    15460           l-filter-open-156 = true
    15461         .
    15462       end.
    15463       if l-filter-open-156 = false then do:
    15464         message
    15465           "Ошибка при фильтрации / сортировке" skip
    15466           "Будут показаны записи без учета фильтра" skip
    15467           view-as alert-box .
    15468       end.
    15469       else do:
    15470           assign
    15471             l-query-was-opened = true
    15472           .
    15473       end.
    15474     end.
    15475     if l-filter-open-156 = false then do:
    15476       OPEN QUERY br-gds FOR EACH gob-doc no-lock
    15477         where  gob-doc.grp-name begins g-grp and gob-doc.obj-type = pobj-type and gob-doc.obj-code = pobj-code                     and gob-doc.free-qnty <> 0 and gob-doc.stts <> 0
    15478       , first gam-doc no-lock where   gam-doc.gds-code = gob-doc.gds-code and   gam-doc.asmg-status = 0 and   gam-doc.obj-type = gob-doc.obj-type and   gam-doc.obj-code = gob-doc.obj-code
    15479          by gob-doc.free-qnty                     by gob-doc.artic
    15480         indexed-reposition
    15481     .
    15482         assign
    15483           l-query-was-opened = true
    15484         .
    15485     end.
    15486   end.
    15487   else do:
    15488     assign
    15489       v-doc-rec = recid( gob-doc )
    15490     .
    15491     do
    15492     on stop undo, leave
    15493     on error undo, leave
    15494     :
    15495       if query br-gds:handle:get-buffer-handle(1) = (buffer gob-doc:handle) then do:
    15496         assign
    15497         parameter-2-156 = (if p-find-next then "true":u else "false":u )
    15498         parameter-4-156 =
    15499           "where ":u +  substitute('gob-doc.grp-name begins &1&2&1  and gob-doc.obj-type = &1&3&1 and gob-doc.obj-code = &4                     and gob-doc.free-qnty <> 0 and gob-doc.stts <> 0 '                       , chr(34),                   g-grp, pobj-type, pobj-code) + " ":u + where-phrase-156 + " ":u + p-find-condition + " " + ""
    15500         parameter-5-156 = "  "
    15501       .
    15502         run fltopend_fltfindd in this-procedure  (
    15503                             input this-procedure:handle
    15504                             ,input query br-gds:handle
    15505                             ,input rowid(gob-doc)
    15506                             ,input logical(parameter-2-156)
    15507                             ,input no-lock
    15508                             ,input (buffer gob-doc:handle)
    15509                             ,input parameter-4-156
    15510                             ,input parameter-5-156
    15511                             ) no-error.
    15512         .
    15513         assign
    15514           v-doc-rec = integer(return-value)
    15515           v-fltopend-rowid[1] = ?
    15516         .
    15517       end.
    15518       else do:
    15519         assign
    15520         parameter-2-156 = (if p-find-next then "true":u else "false":u )
    15521         parameter-3-156 =  "FOR EACH gob-doc no-lock"
    15522         parameter-4-156 =
    15523           (
    15524             if (" gob-doc.grp-name begins g-grp and gob-doc.obj-type = pobj-type and gob-doc.obj-code = pobj-code                     and gob-doc.free-qnty <> 0 and gob-doc.stts <> 0 " + " " + where-phrase-156) <> ""
    15525             then  substitute('gob-doc.grp-name begins &1&2&1  and gob-doc.obj-type = &1&3&1 and gob-doc.obj-code = &4                     and gob-doc.free-qnty <> 0 and gob-doc.stts <> 0 '                       , chr(34),                   g-grp, pobj-type, pobj-code) + " " + where-phrase-156
    15526             else "true"
    15527           )
    15528         parameter-5-156 = (" " + "" + " " + ", first gam-doc no-lock where   gam-doc.gds-code = gob-doc.gds-code and   gam-doc.asmg-status = 0 and   gam-doc.obj-type = gob-doc.obj-type and   gam-doc.obj-code = gob-doc.obj-code" + " " + p-find-condition)
    15529         parameter-6-156 = if sort-phrase-156 = ''
    15530                              then
    15531           (
    15532           " " + "  " +
    15533           " " + " by gob-doc.free-qnty                     by gob-doc.artic                     "
    15534           )
    15535                              else
    15536           (
    15537           " " + "  " +
    15538           " " + sort-phrase-156
    15539           )
    15540         parameter-7-156 =
    15541           " indexed-reposition  "
    15542       .
    15543         run fltopend_fltfindq in this-procedure  (
    15544                             input this-procedure:handle
    15545                             ,input query br-gds:handle
    15546                             ,input logical(parameter-2-156)
    15547                             ,input no-lock
    15548                             ,input parameter-3-156
    15549                             ,input parameter-4-156
    15550                             ,input parameter-5-156
    15551                             ,input parameter-6-156
    15552                             ,input parameter-7-156
    15553                             ,output v-fltopend-rowid
    15554                             ) no-error.
    15555         .
    15556         v-doc-rec = ?.
    15557       end.
    15558       assign
    15559         l-query-was-opened = true
    15560       .
    15561     end.
    15562   end.
    15563     run waitfram-hide in this-procedure .
    15564   END PROCEDURE.
