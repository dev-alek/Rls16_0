     1128   define variable  where-phrase-6     as character no-undo .
     1129   define variable  sort-phrase-6      as character no-undo .
     1130   define variable  where-phrase-rus-6 as character no-undo .
     1131   define variable  sort-phrase-rus-6  as character no-undo .
     1132     run waitfram-show in this-procedure
     1133       (input "ЖДИТЕ ..."
     1134       ).
     1135   run gbl/flt-get.p
     1136     (input filter-point
     1137     ,output flt-rec-6
     1138     ,output filter-name-6
     1139     ,output where-phrase-6
     1140     ,output sort-phrase-6
     1141     ,output where-phrase-rus-6
     1142     ,output sort-phrase-rus-6
     1143     ).
     1144   if p-open-query then do:
     1145       run set-filter-name in this-procedure
     1146         (INPUT filter-name-6
     1147         ) no-error .
     1148     assign
     1149       l-filter-open-6 = false
     1150     .
     1151     if flt-rec-6 <> ?
     1152     then do:
     1153       define variable  parameter-2-6 as character no-undo .
     1154       define variable  parameter-3-6 as character no-undo .
     1155       define variable  parameter-4-6 as character no-undo .
     1156       define variable  parameter-5-6 as character no-undo .
     1157       define variable  parameter-6-6 as character no-undo .
     1158       define variable  parameter-7-6 as character no-undo .
     1159         assign
     1160         parameter-3-6 =
     1161                                 "FOR EACH gob-doc no-lock"
     1162         parameter-4-6 =
     1163           (
     1164             if (" goo-doc.stts = 0 and lookup (goo-doc.unit-base, v-list-unit-name, chr(4)) > 0 and not lookup (string(goo-doc.gds-code),v-list-gds-code-lgas, chr(4)) > 0" + " " + where-phrase-6) <> ""
     1165             then " goo-doc.stts = 0 and lookup (goo-doc.unit-base, v-list-unit-name, chr(4)) > 0 and not lookup (string(goo-doc.gds-code),v-list-gds-code-lgas, chr(4)) > 0" + " " + where-phrase-6
     1166             else "true"
     1167           )
     1168         parameter-5-6 = (" " + "" + " " + ", first gam-doc no-lock where   gam-doc.gds-code = gob-doc.gds-code and   gam-doc.asmg-status = 0 and   gam-doc.obj-type = gob-doc.obj-type and   gam-doc.obj-code = gob-doc.obj-code")
     1169         parameter-6-6 = if sort-phrase-6 = ''
     1170                              then
     1171           (
     1172           " " + "  " +
     1173           " " + " by goo-doc.artic                       BY GOO-DOC.PROD-TYPE                       BY goo-doc.prod-code "
     1174           )
     1175                              else
     1176           (
     1177           " " + "  " +
     1178           " " + sort-phrase-6
     1179           )
     1180         parameter-7-6 =
     1181           " indexed-reposition  "
     1182       .
     1183       do
     1184       on stop undo, leave
     1185       on error undo, leave
     1186       :
     1187         assign
     1188           l-disable-where-6 =
     1189             (" goo-doc.stts = 0 and lookup (goo-doc.unit-base, v-list-unit-name, chr(4)) > 0 and not lookup (string(goo-doc.gds-code),v-list-gds-code-lgas, chr(4)) > 0" + " " + where-phrase-6 = "")
     1190         .
     1191         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     1192                             ,input query br-gds:handle
     1193                             ,input parameter-3-6
     1194                             ,input parameter-4-6
     1195                             ,input parameter-5-6
     1196                             ,input parameter-6-6
     1197                             ,input parameter-7-6
     1198                             )
     1199         .
     1200         assign
     1201           l-filter-open-6 = true
     1202         .
     1203       end.
     1204       if l-filter-open-6 = false then do:
     1205         message
     1206           "Ошибка при фильтрации / сортировке" skip
     1207           "Будут показаны записи без учета фильтра" skip
     1208           view-as alert-box .
     1209       end.
     1210       else do:
     1211           assign
     1212             l-query-was-opened = true
     1213           .
     1214       end.
     1215     end.
     1216     if l-filter-open-6 = false then do:
     1217       OPEN QUERY br-gds FOR EACH gob-doc no-lock
     1218         where  goo-doc.stts = 0 and lookup (goo-doc.unit-base, v-list-unit-name, chr(4)) > 0 and not lookup (string(goo-doc.gds-code),v-list-gds-code-lgas, chr(4)) > 0
     1219       , first gam-doc no-lock where   gam-doc.gds-code = gob-doc.gds-code and   gam-doc.asmg-status = 0 and   gam-doc.obj-type = gob-doc.obj-type and   gam-doc.obj-code = gob-doc.obj-code
     1220          by goo-doc.artic                       BY GOO-DOC.PROD-TYPE                       BY goo-doc.prod-code
     1221         indexed-reposition
     1222     .
     1223         assign
     1224           l-query-was-opened = true
     1225         .
     1226     end.
     1227   end.
     1228   else do:
     1229     assign
     1230       v-doc-rec = recid( gob-doc )
     1231     .
     1232     do
     1233     on stop undo, leave
     1234     on error undo, leave
     1235     :
     1236       if query br-gds:handle:get-buffer-handle(1) = (buffer gob-doc:handle) then do:
     1237         assign
     1238         parameter-2-6 = (if p-find-next then "true":u else "false":u )
     1239         parameter-4-6 =
     1240           "where ":u + " goo-doc.stts = 0 and lookup (goo-doc.unit-base, v-list-unit-name, chr(4)) > 0 and not lookup (string(goo-doc.gds-code),v-list-gds-code-lgas, chr(4)) > 0" + " ":u + where-phrase-6 + " ":u + p-find-condition + " " + ""
     1241         parameter-5-6 = "  "
     1242       .
     1243         run fltopend_fltfindd in this-procedure  (
     1244                             input this-procedure:handle
     1245                             ,input query br-gds:handle
     1246                             ,input rowid(gob-doc)
     1247                             ,input logical(parameter-2-6)
