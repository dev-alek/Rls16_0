     1623   ON VALUE-CHANGED OF br-obj-hist IN FRAME Dialog-Frame
     1624   DO:
     1625     run proc-view-changes in this-procedure no-error.
     1626   END.
     1627   ON ROW-DISPLAY OF BR-changes IN FRAME Dialog-Frame
     1628   DO:
     1629      if temp-changes.fNotChange
     1630      then do:
     1631         temp-changes.l_name:fGCOLOR in browse BR-changes = GRAY_COLOR.
     1632         temp-changes.v_old:fGCOLOR in browse BR-changes  = GRAY_COLOR.
     1633         temp-changes.v_new:fGCOLOR in browse BR-changes  = GRAY_COLOR.
     1634      end.
     1635      else do:
     1636         temp-changes.l_name:fGCOLOR in browse BR-changes = BLACK_COLOR.
     1637         temp-changes.v_old:fGCOLOR in browse BR-changes = BLACK_COLOR.
     1638         temp-changes.v_new:fGCOLOR in browse BR-changes = BLACK_COLOR.
     1639      end.
     1640   END.
     1641   ON CTRL-J OF sch-obj-code IN FRAME Dialog-Frame
     1642   DO:
     1643     run proc-find-obj-code in this-procedure(yes, input frame Dialog-Frame sch-obj-code) no-error.
     1644     if error-status:error then return no-apply.
     1645   END.
     1646   ON RETURN OF sch-obj-code IN FRAME Dialog-Frame
     1647   DO:
     1648     run proc-find-obj-code in this-procedure(no, input frame Dialog-Frame sch-obj-code) no-error.
     1649     if error-status:error then return no-apply.
     1650   END.
     1651   ON CTRL-J OF sch-corr-date IN FRAME Dialog-Frame
