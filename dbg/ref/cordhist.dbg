     3787           )
     3788                              else
     3789           (
     3790           " " + "" +
     3791             " " + sort-column-phrase +
     3792           " " + sort-phrase-29
     3793           )
     3794         parameter-7-29 =
     3795           " indexed-reposition  "
     3796       .
     3797       do
     3798       on stop undo, leave
     3799       on error undo, leave
     3800       :
     3801         assign
     3802           l-disable-where-29 =
     3803             (" TRUE " + " " + where-phrase-29 = "")
     3804         .
     3805         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3806                             ,input query br-obj-hist:handle
     3807                             ,input parameter-3-29
     3808                             ,input parameter-4-29
     3809                             ,input parameter-5-29
     3810                             ,input parameter-6-29
     3811                             ,input parameter-7-29
     3812                             )
     3813         .
     3814         assign
     3815           l-filter-open-29 = true
     3816         .
     3817       end.
     3818       if l-filter-open-29 = false then do:
     3819         message
     3820           "Ошибка при фильтрации / сортировке" skip
     3821           "Будут показаны записи без учета фильтра" skip
     3822           view-as alert-box .
     3823       end.
     3824       else do:
     3825           assign
     3826             l-query-was-opened = true
     3827           .
     3828       end.
     3829     end.
     3830     if l-filter-open-29 = false then do:
     3831       OPEN QUERY br-obj-hist FOR EACH X_c-obj-hist
     3832         where  TRUE
     3833         indexed-reposition
     3834     .
     3835         assign
     3836           l-query-was-opened = true
     3837         .
     3838     end.
     3839   end.
     3840   else do:
     3841     assign
     3842       v-doc-rec = recid( X_c-obj-hist )
     3843     .
     3844     do
     3845     on stop undo, leave
     3846     on error undo, leave
     3847     :
     3848       if query br-obj-hist:handle:get-buffer-handle(1) = (buffer X_c-obj-hist:handle) then do:
     3849         assign
     3850         parameter-2-29 = (if p-find-next then "true":u else "false":u )
     3851         parameter-4-29 =
     3852           "where ":u + " TRUE " + " ":u + where-phrase-29 + " ":u + p-find-condition + " " + ""
     3853         parameter-5-29 = ""
     3854       .
     3855         run fltopend_fltfindd in this-procedure  (
     3856                             input this-procedure:handle
     3857                             ,input query br-obj-hist:handle
     3858                             ,input rowid(X_c-obj-hist)
     3859                             ,input logical(parameter-2-29)
     3860                             ,input no-lock
     3861                             ,input (buffer X_c-obj-hist:handle)
     3862                             ,input parameter-4-29
     3863                             ,input parameter-5-29
     3864                             ) no-error.
     3865         .
     3866         assign
     3867           v-doc-rec = integer(return-value)
     3868           v-fltopend-rowid[1] = ?
     3869         .
     3870       end.
     3871       else do:
     3872         assign
     3873         parameter-2-29 = (if p-find-next then "true":u else "false":u )
     3874         parameter-3-29 =  "FOR EACH X_c-obj-hist"
     3875         parameter-4-29 =
     3876           (
     3877             if (" TRUE " + " " + where-phrase-29) <> ""
     3878             then " TRUE " + " " + where-phrase-29
     3879             else "true"
     3880           )
     3881         parameter-5-29 = (" " + "" + " " + "" + " " + p-find-condition)
     3882         parameter-6-29 = if sort-phrase-29 = ''
     3883                              then
     3884           (
     3885           " " + "" +
     3886             " " + sort-column-phrase +
     3887           " " + "  "
     3888           )
     3889                              else
     3890           (
     3891           " " + "" +
     3892             " " + sort-column-phrase +
     3893           " " + sort-phrase-29
     3894           )
     3895         parameter-7-29 =
     3896           " indexed-reposition  "
     3897       .
     3898         run fltopend_fltfindq in this-procedure  (
     3899                             input this-procedure:handle
     3900                             ,input query br-obj-hist:handle
     3901                             ,input logical(parameter-2-29)
     3902                             ,input no-lock
     3903                             ,input parameter-3-29
     3904                             ,input parameter-4-29
     3905                             ,input parameter-5-29
     3906                             ,input parameter-6-29
     3907                             ,input parameter-7-29
     3908                             ,output v-fltopend-rowid
     3909                             ) no-error.
     3910         .
     3911         v-doc-rec = ?.
     3912       end.
     3913       assign
     3914         l-query-was-opened = true
     3915       .
     3916     end.
     3917   end.
     3918     run waitfram-hide in this-procedure .
     3919     end.
     3920   end.
     3921   if not p-open-query and v-doc-rec <> ? then
     3922   REPOSITION br-obj-hist to recid v-doc-rec No-ERROR.
     3923   if not p-open-query and v-fltopend-rowid[1] <> ? then
     3924   query br-obj-hist:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     3925   run waitfram-hide in this-procedure .
     3926   APPLY "VALUE-CHANGED" TO br-obj-hist in frame Dialog-Frame.
     3927   APPLY "ENTRY" TO br-obj-hist.
     3928   END PROCEDURE.
     3929   PROCEDURE proc-b-print :
     3930   define variable date_string     as      char    no-undo.
     3931   define variable Line                as      char    no-undo.
     3932   define variable for-time as char.
     3933   define variable accum-count as integer.
     3934   define variable v-doc-rec as recid no-undo.
     3935   define variable v-subject-chr as character no-undo .
     3936   define variable v-upd-time as character no-undo .
     3937   define variable v-obj as character no-undo .
     3938   define variable v-action-chr as character no-undo .
     3939   define variable v-source-type as character no-undo .
     3940   DEFINE FRAME HistoryList
     3941   v-action-chr FORMAT "X(10)" COLUMN-LABEL "Действие"
     3942   v-subject-chr COLUMN-LABEL "Предмет изменений" FORMAT "X(20)"
     3943   X_c-obj-hist.is-news COLUMn-LABEL "СПН" FORMAT "+/ "
     3944   v-source-type COLUMn-LABEL "Источн.!измен"
     3945   X_c-obj-hist.source-ref COLUMn-LABEL "№"
     3946   X_c-obj-hist.corr-date
     3947   v-upd-time COLUMN-LABEL "Время изм." FORMAT "X(8)"
     3948   X_c-obj-hist.corr-user-name
     3949   X_c-obj-hist.corr-user-db-num
     3950   HEADER  date_string AT 5 format "X(35)"
     3951   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     3952   Line format "X(195)" AT 1
     3953   with width 232 down stream-io use-text    .
     3954   Line = fill("-", 195).
     3955   date_string = cur-time-print() .
     3956   assign
     3957   v-doc-rec = recid( X_c-obj-hist ).
     3958   DO WHILE available X_c-obj-hist :
     3959         GET prev br-obj-hist.
     3960   END.
     3961   run prn-lib-open-stream  in this-procedure (
     3962                                                input parparentProc
     3963                                               ,input 43
     3964                                               ,input yes
     3965                                               ,input no
     3966                                               ).
     3967   PUT  STREAM PrnLibStream
     3968   SPACE(25) ( frame Dialog-Frame:title )
     3969   format "x(90)" SKIP(1) .
     3970   FORM HEADER
     3971   Line format "X(180)" AT 1 SKIP
     3972   "Продолжение - на следующей странице" AT 30 SKIP
     3973   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3974   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     3975   FORM with FRAME HistoryList  .
     3976   run waitfram-show in this-procedure ("Ждите...").
     3977     GET next br-obj-hist.
     3978       DO WHILE available X_c-obj-hist :
     3979         Display STREAM PrnLibStream
     3980          get-action(X_c-obj-hist.action) @ v-action-chr
     3981          get-subject(X_c-obj-hist.subject) @ v-subject-chr
     3982         X_c-obj-hist.is-news
     3983         get-source-type(X_c-obj-hist.source-type) @ v-source-type
     3984         X_c-obj-hist.source-ref
     3985         X_c-obj-hist.corr-date
     3986         string(X_c-obj-hist.corr-time, "HH:MM:SS":U) @ v-upd-time
     3987         X_c-obj-hist.corr-user-name
     3988         X_c-obj-hist.corr-user-db-num
     3989         with FRAME HistoryList .
     3990     DOWN STREAM PrnLibStream 1 with FRAME HistoryList  .
     3991     assign
     3992     accum-count = accum-count + 1
     3993     .
     3994     GET next br-obj-hist.
     3995   END.
     3996   UNDERLINE  STREAM PrnLibStream
     3997   v-action-chr
     3998   v-subject-chr
     3999   X_c-obj-hist.is-news
     4000   v-source-type
     4001   X_c-obj-hist.source-ref
     4002   X_c-obj-hist.corr-date
     4003   v-upd-time
     4004   X_c-obj-hist.corr-user-name
     4005   X_c-obj-hist.corr-user-db-num
     4006   with FRAME HistoryList .
     4007   DISPLAY STREAM PrnLibStream
     4008   "ИТОГО"  @ v-obj
     4009   string(accum-count)  @ v-action-chr
     4010   with frame HistoryList.
     4011   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     4012   HIDE  STREAM PrnLibStream FRAME CheckList.
     4013   output  STREAM PrnLibStream CLOSE.
     4014   run waitfram-hide in this-procedure.
     4015   run prn-lib-prn-file in this-procedure (
     4016                                             input parparentproc
     4017                                             ,input 8
     4018                                             ).
     4019   reposition br-obj-hist to recid v-doc-rec no-error.
     4020   apply "entry" to br-obj-hist in frame Dialog-Frame.
     4021   END PROCEDURE.
     4022   PROCEDURE proc-b-sch :
     4023   assign
     4024     tbl = "c-order-head"
     4025     join-tbl = 'X_c-obj-hist'
     4026     fld = ""
     4027     lab = ""
     4028     spr = ""
     4029     dim = '0'
     4030     .
     4031   run fltfield-add in this-procedure('corr-date', 'Дата корр.', '',
     4032   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4033   run fltfield-add in this-procedure('corr-time', 'Время корр.', 'time',
     4034   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4035   run fltfield-add in this-procedure('corr-user-db-num', 'БД корр.', '',
     4036   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4037   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     4038   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4039   run fltfield-add in this-procedure('action', 'Действие', 'hist-action',
     4040   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4041   run fltfield-add in this-procedure('subject', 'Предмет изменения', 'obj-hist-subject',
     4042   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4043   run fltfield-add in this-procedure('source-type', 'Источник измен-я', 'hist-source-type',
     4044   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4045   run fltfield-add in this-procedure('source-ref', 'Код источника измен-я', '',
     4046   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4047   Filter-Block:
     4048   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4049       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4050       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4051     run gbl/filter.w ( INPUT parparentproc
     4052                      , INPUT filter-point + chr(4) + filter-label
     4053                      , INPUT tbl
     4054                      , INPUT join-tbl
     4055                      , INPUT fld
     4056                      , INPUT lab
     4057                      , INPUT spr
     4058                      , INPUT dim ).
     4059     RUN OpenBr in this-procedure ( input yes, input no, input '':U, input v-corr-user-db-num).
     4060   END.
     4061   END PROCEDURE.
     4062   PROCEDURE proc-find-corr-date :
     4063   define input parameter p-next as logical no-undo.
     4064   define input parameter p-date like ub.fin-doc.doc-date no-undo.
     4065   define variable v-date-chr as character no-undo.
     4066   if p-date = ? then return .
     4067   display
     4068   0 @ sch-obj-code
     4069   0 @ sch-db-num
     4070   "":U @ sch-corr-user-name
     4071   with frame Dialog-Frame.
     4072   assign
     4073   v-date-chr = string(day(p-date)) + chr(47) +
     4074                    string(month(p-date)) + chr(47) +
     4075                    string(year(p-date)).
     4076          run OpenBr in this-procedure
     4077           (input false
     4078           ,input true
     4079           ,input substitute("and X_c-obj-hist.corr-date = &1 "
     4080             , v-date-chr)
     4081           ,input v-corr-user-db-num
     4082           ).
     4083         apply "entry":u to sch-corr-date in frame Dialog-Frame.
     4084   END PROCEDURE.
     4085   PROCEDURE proc-find-db-num :
     4086   define input parameter p-next as logical no-undo.
     4087   define input parameter p-db-num like c-order-head.corr-user-db-num no-undo.
     4088   define variable v-db-num as character no-undo.
     4089   assign
     4090   sch-corr-date = ?
     4091   .
     4092   display
     4093   "":U @ sch-corr-user-name
     4094   0 @ sch-obj-code
     4095   sch-corr-date
     4096   with frame Dialog-Frame.
     4097   assign
     4098   v-db-num = string(p-db-num).
     4099   run OpenBr in this-procedure
     4100       (input false
     4101       ,input p-next
     4102       ,input substitute("and X_c-obj-hist.corr-user-db-num = &1 "
     4103         , v-db-num)
     4104       ,input v-corr-user-db-num
     4105       ).
     4106   apply "entry":u to sch-db-num in frame Dialog-Frame .
     4107   END PROCEDURE.
     4108   PROCEDURE proc-find-user :
     4109   define input parameter p-next as logical no-undo.
     4110   define input parameter p-user like c-order-head.corr-user-name no-undo.
     4111   assign
     4112   sch-corr-date = ?.
     4113   display
     4114   0 @ sch-db-num
     4115   sch-corr-date
     4116   0 @ sch-obj-code
     4117   with frame Dialog-Frame.
     4118   p-user = chr(34) + p-user + chr(34).
     4119   run OpenBr in this-procedure
     4120       (input false
     4121       ,input p-next
     4122       ,input substitute("and X_c-obj-hist.corr-user-name = &1 "
     4123         , p-user)
     4124       ,input v-corr-user-db-num
     4125       ).
     4126   apply "entry":u to sch-corr-user-name in frame Dialog-Frame .
     4127   END PROCEDURE.
     4128   PROCEDURE proc-view-changes :
     4129   define variable v-description as character no-undo .
     4130   for each temp-changes:
     4131       delete temp-changes.
     4132   END.
     4133   if not available X_c-obj-hist then do:
     4134     b-nextlevel:visible IN FRAME Dialog-Frame = no.
     4135     Open QUery br-changes for each temp-changes.
     4136     return.
     4137   end.
     4138   b-nextlevel:visible IN FRAME Dialog-Frame = X_c-obj-hist.subject eq "*" .
     4139   run local-view-cange in this-procedure (output v-description) .
     4140   Open QUery br-changes for each temp-changes by temp-changes.fNotChange.
     4141   assign
     4142   br-changes:title in frame Dialog-Frame = v-description
     4143   .
     4144   END PROCEDURE.
     4145   FUNCTION get-action RETURNS CHARACTER
     4146     ( p-action as integer ) :
     4147   define variable dops as character no-undo.
     4148   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     4149   RETURN dops.
     4150   END FUNCTION.
     4151   FUNCTION get-source-type RETURNS CHARACTER
     4152     ( p-source-type as character ) :
     4153   define variable v-dop as character no-undo .
     4154   assign
     4155   v-dop = entry (lookup (p-source-type, ',db,esys,trn-doc,payment,fin-doc,import,recalc,wth-doc,ren-gdsc,upgrade,grp-chg,stop-list,dis-card':U), ',БД,ВС,Документ,Платеж,Фин.док.,Импорт,Пересчет,Документ МЦ,Коллизия,Апгрейд,Изм.группы,Стоплист,ДК':U)
     4156   no-error
     4157   .
     4158   RETURN v-dop.
     4159   END FUNCTION.
     4160   end.
     4161   else do:
     4162     run ref/cordhistone.w(
     4163       p-db-num-order,
     4164       p-doc-code-order,
     4165       parParentProc,
     4166       p-curr-host-code,
     4167       p-curr-obj-type,
     4168       p-curr-obj-code,
     4169       bttns,
     4170       p-mode,
     4171       p-corr-user-db-num,
     4172       p-corr-user-name,
     4173       p-subject,
     4174       p-db-num,
     4175       p-chip-num,
     4176       input-output p-rid-list
     4177     ).
     4178   end.
     4179   function fLabel returns character :
     4180      return if p-mode eq "one"  then "История по Заказу " + string(p-doc-code-order) + " по ДБ " + string(p-db-num-order) else "История по Заказам".
     4181   end.
     4182   def var vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4183   define new global shared variable g#attr-lib  as handle no-undo .
     4184   define variable v-attr-lib-variable as handle no-undo .
     4185   def var vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4186   function getattrUtdex returns char
     4187   (idb-num   as integer,
     4188    idoc-id   as integer,
     4189    iattrcode as character,
     4190    iExValue  as character  ):
     4191      define buffer utd-attr for utd-attr.
     4192      find first utd-attr where utd-attr.db-num eq idb-num
     4193                            and utd-attr.doc-id eq idoc-id
     4194                            and utd-attr.attr-code eq iattrcode
     4195      no-lock no-error.
     4196      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
     4197   end.
     4198   function getattrUtd returns char
     4199   (idb-num   as integer,
     4200    idoc-id   as integer,
     4201    iattrcode as character ):
     4202     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
     4203   end.
     4204   function setattrUtd returns logical
     4205   (idb-num   as integer,
     4206    idoc-id   as integer,
     4207    iattrcode as character,
     4208    iattrval  as character ):
     4209      define buffer utd-attr for utd-attr.
     4210      find first utd-attr where utd-attr.db-num eq idb-num
     4211                            and utd-attr.doc-id eq idoc-id
     4212                            and utd-attr.attr-code eq iattrcode
     4213      no-lock no-error.
     4214      if not available utd-attr
     4215      then do:
     4216         create utd-attr.
     4217         assign
     4218            utd-attr.db-num    = idb-num
     4219            utd-attr.doc-id    = idoc-id
     4220            utd-attr.attr-code = iattrcode
     4221            utd-attr.attr-value = iattrval
     4222         .
     4223      end.
     4224      else do:
     4225         if utd-attr.attr-value ne iattrval
     4226         then do:
     4227            find current utd-attr exclusive-lock no-error.
     4228            if available utd-attr
     4229            then
     4230               utd-attr.attr-value = iattrval.
     4231         end.
     4232      end.
     4233      release utd-attr.
     4234   end.
     4235   function GetAttrUtdlinesEx returns char
     4236   (idb-num   as integer,
     4237    idoc-id   as integer,
     4238    ilinenum  as integer,
     4239    iattrcode as character,
     4240    iExValue  as character  ):
     4241      define buffer utd-lines-attr for utd-lines-attr.
     4242      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     4243                                  and utd-lines-attr.doc-id    eq idoc-id
     4244                                  and utd-lines-attr.lineNum   eq ilineNum
     4245                                  and utd-lines-attr.attr-code eq iattrcode
     4246      no-lock no-error.
     4247      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
     4248   end.
     4249   function GetAttrUtdlines returns char
     4250   (idb-num   as integer,
     4251    idoc-id   as integer,
     4252    ilinenum  as integer,
     4253    iattrcode as character ):
     4254      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
     4255   end.
     4256   function setattrUtdlines returns logical
     4257   (idb-num   as integer,
     4258    idoc-id   as integer,
     4259    ilinenum  as integer,
     4260    iattrcode as character,
     4261    iattrval  as character ):
     4262      define buffer utd-lines-attr for utd-lines-attr.
     4263      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     4264                                  and utd-lines-attr.doc-id    eq idoc-id
     4265                                  and utd-lines-attr.lineNum   eq ilineNum
     4266                                  and utd-lines-attr.attr-code eq iattrcode
     4267      no-lock no-error.
     4268      if not available utd-lines-attr
     4269      then do:
     4270         if iattrval ne ?
     4271            and iattrval ne ""
     4272         then do:
     4273            create utd-lines-attr.
     4274            assign
     4275               utd-lines-attr.db-num    = idb-num
     4276               utd-lines-attr.doc-id    = idoc-id
     4277               utd-lines-attr.lineNum   = ilineNum
     4278               utd-lines-attr.attr-code = iattrcode
     4279               utd-lines-attr.attr-value = iattrval
     4280            .
     4281         end.
     4282      end.
     4283      else do:
     4284         if utd-lines-attr.attr-value ne iattrval
     4285         then do:
     4286            find current utd-lines-attr exclusive-lock no-error.
     4287            if available utd-lines-attr
     4288            then do:
     4289               if    iattrval eq ?
     4290                  or iattrval eq ""
     4291               then do:
     4292                  delete utd-lines-attr.
     4293               end.
     4294               else do:
     4295                  utd-lines-attr.attr-value = iattrval.
     4296               end.
     4297            end.
     4298         end.
     4299      end.
     4300      release utd-lines-attr.
     4301   end.
     4302   function GetAttrUtdMarkingLinesEx returns char
     4303   (idb-num   as integer,
     4304    idoc-id   as integer,
     4305    ilinenum  as integer,
     4306    imark     as character,
     4307    iattrcode as character,
     4308    iExValue  as character  ):
     4309      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
     4310      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
     4311                                          and utd-marking-lines-attr.doc-id    eq idoc-id
     4312                                          and utd-marking-lines-attr.lineNum   eq ilineNum
     4313                                          and utd-marking-lines-attr.mark      eq imark
     4314                                          and utd-marking-lines-attr.attr-code eq iattrcode
     4315      no-lock no-error.
     4316      return if not available utd-marking-lines-attr  then iExValue    else  utd-marking-lines-attr.attr-value.
     4317   end.
     4318   function GetAttrUtdMarkingLines returns char
     4319   (idb-num   as integer,
     4320    idoc-id   as integer,
     4321    ilinenum  as integer,
     4322    imark     as character,
     4323    iattrcode as character ):
     4324      return GetAttrUtdMarkingLinesEx (idb-num,idoc-id,ilinenum,imark,iattrcode,?).
     4325   end.
     4326   function setattrUtdMarkingLines returns logical
     4327   (idb-num   as integer,
     4328    idoc-id   as integer,
     4329    ilinenum  as integer,
     4330    imark     as character,
     4331    iattrcode as character,
     4332    iattrval  as character ):
     4333      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
     4334      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
     4335                                          and utd-marking-lines-attr.doc-id    eq idoc-id
     4336                                          and utd-marking-lines-attr.lineNum   eq ilineNum
     4337                                          and utd-marking-lines-attr.mark      eq imark
     4338                                          and utd-marking-lines-attr.attr-code eq iattrcode
     4339      no-lock no-error.
     4340      if not available utd-marking-lines-attr
     4341      then do:
     4342         if iattrval ne ?
     4343            and iattrval ne ""
     4344         then do:
     4345            create utd-marking-lines-attr.
     4346            assign
     4347               utd-marking-lines-attr.db-num     = idb-num
     4348               utd-marking-lines-attr.doc-id     = idoc-id
     4349               utd-marking-lines-attr.lineNum    = ilineNum
     4350               utd-marking-lines-attr.mark       = imark
     4351               utd-marking-lines-attr.attr-code  = iattrcode
     4352               utd-marking-lines-attr.attr-value = iattrval
     4353            .
     4354         end.
     4355      end.
     4356      else do:
     4357         if utd-marking-lines-attr.attr-value ne iattrval
     4358         then do:
     4359            find current utd-marking-lines-attr exclusive-lock no-error.
     4360            if available utd-marking-lines-attr
     4361            then do:
     4362               if    iattrval eq ?
     4363                  or iattrval eq ""
     4364               then do:
     4365                  delete utd-marking-lines-attr.
     4366               end.
     4367               else do:
     4368                  utd-marking-lines-attr.attr-value = iattrval.
     4369               end.
     4370            end.
     4371         end.
     4372      end.
     4373      release utd-marking-lines-attr.
     4374   end.
     4375   def var vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4376   define variable vss-include-info33 as character format "X(65)" no-undo
     4377   initial "@(#)$Workfile$ $Revision$".
     4378   procedure xmlchar-test :
     4379   define input parameter p-in-string          as character        no-undo.
     4380   define output parameter p-out-string-enc    as character        no-undo.
     4381   define output parameter p-out-string-dec    as character        no-undo.
     4382   do
     4383   on error undo, return error
     4384   :
     4385          run xmlchar-encode in this-procedure
     4386       (
     4387             input p-in-string
     4388           , output p-out-string-enc
     4389       ).
     4390          run xmlchar-decode in this-procedure
     4391       (
     4392             input p-out-string-enc
     4393           , output p-out-string-dec
     4394       ).
     4395   end.
     4396   end .
     4397   procedure xmlchar-encode :
     4398   define input parameter p-in-string      as character        no-undo.
     4399   define output parameter p-out-string    as character        no-undo.
     4400       define variable v-position      as integer      no-undo.
     4401       define variable v-current-char  as character    no-undo.
     4402   do
     4403   on error undo, return error
     4404   :
     4405       assign
     4406           p-out-string = "":U
     4407       .
     4408       case p-in-string
     4409       :
     4410           when ?
     4411           then do:
     4412               assign
     4413                   p-out-string = "?":U
     4414               .
     4415           end.
     4416           when "?":U
     4417           then do:
     4418               assign
     4419                   p-out-string = "&#63;":U
     4420               .
     4421           end.
     4422           otherwise do:
     4423               do v-position = 1 to length( p-in-string )
     4424               :
     4425                   assign
     4426                       v-current-char = substring( p-in-string, v-position, 1 )
     4427                   .
     4428                   case v-current-char
     4429                   :
     4430                       when "&":U
     4431                       then do:
     4432                           assign
     4433                               p-out-string = p-out-string + "&amp;":U
     4434                           .
     4435                       end.
     4436                       when ">":U
     4437                       then do:
     4438                           assign
     4439                               p-out-string = p-out-string + "&gt;":U
     4440                           .
     4441                       end.
     4442                       when "<":U
     4443                       then do:
     4444                           assign
     4445                               p-out-string = p-out-string + "&lt;":U
     4446                           .
     4447                       end.
     4448                       when "'":U
     4449                       then do:
     4450                           assign
     4451                               p-out-string = p-out-string + "&apos;":U
     4452                           .
     4453                       end.
     4454                       when '"':U
     4455                       then do:
     4456                           assign
     4457                               p-out-string = p-out-string + "&quot;":U
     4458                           .
     4459                       end.
     4460                       when chr(1)
     4461                       then do:
     4462                           assign
     4463                               p-out-string = p-out-string + "":U
     4464                           .
     4465                       end.
     4466                       when chr(2)
     4467                       then do:
     4468                           assign
     4469                               p-out-string = p-out-string + "":U
     4470                           .
     4471                       end.
     4472                       when chr(3)
     4473                       then do:
     4474                           assign
     4475                               p-out-string = p-out-string + "":U
     4476                           .
     4477                       end.
     4478                       when chr(4)
     4479                       then do:
     4480                           assign
     4481                               p-out-string = p-out-string + "":U
     4482                           .
     4483                       end.
     4484                       when chr(5)
     4485                       then do:
     4486                           assign
     4487                               p-out-string = p-out-string + "":U
     4488                           .
     4489                       end.
     4490                       when chr(6)
     4491                       then do:
     4492                           assign
     4493                               p-out-string = p-out-string + "":U
     4494                           .
     4495                       end.
     4496                       when chr(7)
     4497                       then do:
     4498                           assign
     4499                               p-out-string = p-out-string + "":U
     4500                           .
     4501                       end.
     4502                       when chr(8)
     4503                       then do:
     4504                           assign
     4505                               p-out-string = p-out-string + "":U
     4506                           .
     4507                       end.
     4508                       when chr(9)
     4509                       then do:
     4510                           assign
     4511                               p-out-string = p-out-string + "":U
     4512                           .
     4513                       end.
     4514                       when chr(29)
     4515                       then do:
     4516                           assign
     4517                               p-out-string = p-out-string + "":U
     4518                           .
     4519                       end.
     4520                       when chr(10)
     4521                       then do:
     4522                           assign
     4523                               p-out-string = p-out-string + "&#10;":U
     4524                           .
     4525                       end.
     4526                       when chr(13)
     4527                       then do:
     4528                           assign
     4529                               p-out-string = p-out-string + "&#13;":U
     4530                           .
     4531                       end.
     4532                       otherwise do:
     4533                           assign
     4534                               p-out-string = p-out-string + v-current-char
     4535                           .
     4536                       end.
     4537                   end case.
     4538               end.
     4539           end.
     4540       end case.
     4541   end.
     4542   end .
     4543   procedure xmlchar-encode-1c :
     4544   define input parameter p-in-string      as character        no-undo.
     4545   define output parameter p-out-string    as character        no-undo.
     4546       define variable v-position      as integer      no-undo.
     4547       define variable v-current-char  as character    no-undo.
     4548   do
     4549   on error undo, return error
     4550   :
     4551       assign
     4552           p-out-string = "":U
     4553       .
     4554       case p-in-string
     4555       :
     4556           when ?
     4557           then do:
     4558               assign
     4559                   p-out-string = "?":U
     4560               .
     4561           end.
     4562           otherwise do:
     4563               do v-position = 1 to length( p-in-string )
     4564               :
     4565                   assign
     4566                       v-current-char = substring( p-in-string, v-position, 1 )
     4567                   .
     4568                   case v-current-char
     4569                   :
     4570                       when chr(1)
     4571                       then do:
     4572                           assign
     4573                               p-out-string = p-out-string + " ":U
     4574                           .
     4575                       end.
     4576                       when chr(2)
     4577                       then do:
     4578                           assign
     4579                               p-out-string = p-out-string + " ":U
     4580                           .
     4581                       end.
     4582                       when chr(3)
     4583                       then do:
     4584                           assign
     4585                               p-out-string = p-out-string + " ":U
     4586                           .
     4587                       end.
     4588                       when chr(4)
     4589                       then do:
     4590                           assign
     4591                               p-out-string = p-out-string + " ":U
     4592                           .
     4593                       end.
     4594                       when chr(5)
     4595                       then do:
     4596                           assign
     4597                               p-out-string = p-out-string + " ":U
     4598                           .
     4599                       end.
     4600                       when chr(6)
     4601                       then do:
     4602                           assign
     4603                               p-out-string = p-out-string + " ":U
     4604                           .
     4605                       end.
     4606                       when chr(7)
     4607                       then do:
     4608                           assign
     4609                               p-out-string = p-out-string + " ":U
     4610                           .
     4611                       end.
     4612                       when chr(8)
     4613                       then do:
     4614                           assign
     4615                               p-out-string = p-out-string + " ":U
     4616                           .
     4617                       end.
     4618                       when chr(9)
     4619                       then do:
     4620                           assign
     4621                               p-out-string = p-out-string + " ":U
     4622                           .
     4623                       end.
     4624                       when chr(29)
     4625                       then do:
     4626                           assign
     4627                               p-out-string = p-out-string + " ":U
     4628                           .
     4629                       end.
     4630                       when chr(10)
     4631                       then do:
     4632                           assign
     4633                               p-out-string = p-out-string + " ":U
     4634                           .
     4635                       end.
     4636                       when chr(13)
     4637                       then do:
     4638                           assign
     4639                               p-out-string = p-out-string + " ":U
     4640                           .
     4641                       end.
     4642                       otherwise do:
     4643                           assign
     4644                               p-out-string = p-out-string + v-current-char
     4645                           .
     4646                       end.
     4647                   end case.
     4648               end.
     4649           end.
     4650       end case.
     4651   end.
     4652   end .
     4653   procedure xmlchar-decode :
     4654   define input parameter p-in-string      as character        no-undo.
     4655   define output parameter p-out-string    as character        no-undo.
     4656       define variable v-position      as integer      no-undo.
     4657       define variable v-last-position as integer      no-undo.
     4658       define variable v-temp-integer  as integer      no-undo.
     4659       define variable v-current-char  as character    no-undo.
     4660       define variable v-next-char     as character    no-undo.
     4661       define variable v-success       as logical      no-undo.
     4662   do
     4663   on error undo, return error
     4664   :
     4665       assign
     4666           p-out-string = "":U
     4667           v-position   = 0
     4668       .
     4669       replace-cycle:
     4670       do while yes
     4671       on error undo, return error
     4672       :
     4673           assign
     4674               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     4675           .
     4676           if v-last-position <= v-position
     4677           then do:
     4678               if v-position = 0
     4679               then do:
     4680                   assign
     4681                       p-out-string = p-in-string
     4682                   .
     4683               end.
     4684               else do:
     4685                   assign
     4686                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     4687                   .
     4688               end.
     4689               leave replace-cycle.
     4690           end.
     4691           else do:
     4692               assign
     4693                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     4694                   v-position      = v-last-position
     4695                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     4696               .
     4697               if v-current-char = "#":U
     4698               then do:
     4699                   assign
     4700                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     4701                   .
     4702                   if v-last-position > 0
     4703                   then do:
     4704                       run xmlchar-read-integer in this-procedure
     4705                        (
     4706                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     4707                           , output v-temp-integer
     4708                           , output v-success
     4709                       ).
     4710                       if v-success = yes
     4711                       and v-temp-integer >= 1
     4712                       and v-temp-integer <= 255
     4713                       then do:
     4714                           assign
     4715                               p-out-string = p-out-string + chr( v-temp-integer )
     4716                               v-position   = v-last-position + 1
     4717                           .
     4718                       end.
     4719                       else do:
     4720                           assign
     4721                               p-out-string = p-out-string + "&":U
     4722                               v-position   = v-position   + 1
     4723                           .
     4724                       end.
     4725                   end.
     4726                   else do:
     4727                       assign
     4728                           p-out-string = p-out-string + "&":U
     4729                           v-position   = v-position   + 1
     4730                       .
     4731                   end.
     4732               end.
     4733               else do:
     4734                   case substring( p-in-string, v-position + 1, 3 )
     4735                   :
     4736                       when "lt;":U
     4737                       then do:
     4738                           assign
     4739                               p-out-string = p-out-string + "<":U
     4740                               v-position   = v-position   + 3
     4741                           .
     4742                       end.
     4743                       when "gt;":U
     4744                       then do:
     4745                           assign
     4746                               p-out-string = p-out-string + ">":U
     4747                               v-position   = v-position   + 3
     4748                           .
     4749                       end.
     4750                       otherwise do:
     4751                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     4752                           then do:
     4753                               assign
     4754                                   p-out-string = p-out-string + "&":U
     4755                                   v-position   = v-position   + 4
     4756                               .
     4757                           end.
     4758                           else do:
     4759                               case substring( p-in-string, v-position + 1, 5 )
     4760                               :
     4761                                   when "quot;":U
     4762                                   then do:
     4763                                       assign
     4764                                           p-out-string = p-out-string + '"':U
     4765                                           v-position   = v-position   + 5
     4766                                       .
     4767                                   end.
     4768                                   when "apos;":U
     4769                                   then do:
     4770                                       assign
     4771                                           p-out-string = p-out-string + "'":U
     4772                                           v-position   = v-position   + 5
     4773                                       .
     4774                                   end.
     4775                                   otherwise do:
     4776                                       assign
     4777                                           p-out-string = p-out-string + "&":U
     4778                                       .
     4779                                   end.
     4780                               end case.
     4781                           end.
     4782                       end.
     4783                   end case.
     4784               end.
     4785           end.
     4786       end.
     4787   end.
     4788   end .
     4789   procedure xmlchar-read-integer :
     4790   define input parameter p-input-string      as character        no-undo.
     4791   define output parameter p-output-integer   as integer          no-undo.
     4792   define output parameter p-success       as logical          no-undo.
     4793   do
     4794   on error undo, return error
     4795   :
     4796       assign
     4797           p-output-integer = integer( p-input-string )
     4798       no-error.
     4799       if error-status :error
     4800       then do:
     4801           assign
     4802               p-success           = no
     4803               p-output-integer    = 0
     4804           .
     4805       end.
     4806       else do:
     4807           assign
     4808               p-success           = yes
     4809           .
     4810       end.
     4811   end.
     4812   end.
     4813   define variable mMRCCode  as logical    no-undo.
     4814   define variable mTypeMark as character  no-undo.
     4815   function IS-NeedMark returns logical
     4816   ( input ib-code as integer  ,
     4817     input ib-str as character ):
     4818      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     4819      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     4820                                    and buf_prod-bc-attr.b-str  eq ib-str
     4821                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     4822        no-lock no-error.
     4823      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     4824   end.
     4825   function repTegforDm return char
     4826   (iDM as char ):
     4827       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     4828       define variable vteg as character no-undo.
     4829       define variable oDM as character no-undo.
     4830       define variable vi as integer no-undo.
     4831       oDM = iDm.
     4832       do vi = 1 to num-entries(vTeglist):
     4833          vTeg = entry(vi,vTeglist).
     4834          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     4835       end.
     4836       return oDM.
     4837   end.
     4838   function repSpecSimbforDm return char
     4839   (iDM as char ):
     4840       define variable oDM as character no-undo.
     4841     run
     4842       xmlchar-decode(iDM, output oDM).
     4843     return repTegforDm (oDM).
     4844   end.
     4845   function CheckGtin return logical
     4846   (iGtin as char):
     4847      define variable bar_code as character no-undo.
     4848      define variable vGtin as logical no-undo init "yes".
     4849      if length(iGtin) eq 14
     4850      then do:
     4851         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     4852         run str/chk-sum.p
     4853          (input-output bar_code ) no-error .
     4854         if iGtin ne  bar_code
     4855         then
     4856            vGtin = no.
     4857      end.
     4858      else
     4859         vGtin = no.
     4860      return vgtin.
     4861   end.
     4862   function repSpecSimbforXlm return char
     4863   (iDM as char ):
     4864       iDM = replace(iDM,chr(29),"").
     4865       return iDM.
     4866   end.
     4867   function getGtinByDM return char
     4868   (IDM as char):
     4869      define variable VTXT as char no-undo.
     4870      define variable vGtin as char no-undo.
     4871      vTXt = IdM.
     4872      vGtin = IDM.
     4873      if    length(vtxt) > 14
     4874      then do:
     4875         if   vtxt begins "(01)"
     4876                or vtxt begins "(02)"
     4877         then
     4878            vGtin = substring(vtxt,5,14).
     4879         else if   (vtxt begins "01"
     4880                or vtxt begins "02" )
     4881                and (   (    substring(iDm,17,2) eq "21"
     4882                         and length(vtxt) >= 21)
     4883                     or substring(iDm,17,2) eq "37"
     4884                     or substring(iDm,17,4) eq "(37)" )
     4885         then do:
     4886            vGtin = substring(vtxt,3,14).
     4887            if not checkGtin(vGtin)
     4888            then
     4889               vGtin = substring(vtxt,1,14).
     4890         end.
     4891         else if     length(vtxt) eq 14 + 7 + 4 + 4
     4892             or length(vtxt) eq 14 + 7 + 4
     4893             or length(vtxt) eq 14 + 7
     4894         then
     4895            vGtin = substring(vtxt,1,14).
     4896      end.
     4897      if not checkGtin(vGtin)
     4898      then
     4899         vGtin = "".
     4900      return vgtin.
     4901   end.
     4902   function getGdsCodeByGtin return int
     4903   (iGtin as char):
     4904      define buffer prod-bc  for ub.prod-bc.
     4905      define buffer bar-code for ub.bar-code.
     4906      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     4907      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     4908      return if avail bar-code then bar-code.gds-code else ?.
     4909   end.
     4910   function getQntyCodeByGtin return decimal
     4911   (iGtin as char):
     4912      define buffer prod-bc  for ub.prod-bc.
     4913      define buffer bar-code for ub.bar-code.
     4914      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     4915      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     4916      return if avail bar-code then bar-code.cli-base-rate else ?.
     4917   end.
     4918   function getGdsCodeByDM return int
     4919   (iDm as char):
     4920      define variable vGtin as char no-undo.
     4921      define buffer prod-bc for ub.prod-bc.
     4922      vGtin  = getGtinByDM (IDM ).
     4923      return getGdsCodeByGtin (vGtin).
     4924   end.
     4925   function ChekTypeMarkByGds return logical
     4926   (iGds-code as integer ):
     4927      define buffer goods-attr for ub.goods-attr.
     4928      find first goods-attr where goods-attr.gds-code   = iGds-code
     4929                              and goods-attr.attr-code  = 'mark-type':U
     4930      no-lock no-error.
     4931      if available goods-attr
     4932      then do:
     4933         mTypeMark = goods-attr.attr-value.
     4934         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     4935           .
     4936      end.
     4937      else
     4938         return no.
     4939   end.
     4940   function ChekTypeMarkByDm return logical
     4941   (iDM as char ):
     4942      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     4943   end.
     4944   function ChekTypeMarkByGtin return logical
     4945   (iGtin as char ):
     4946      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     4947   end.
     4948   function GetNextElement return character
     4949     (input iAllTeg        as logical
     4950     ,output oteg          as character
     4951     ,output otegval       as character
     4952     ,input-output pstr    as character
     4953      ):
     4954        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     4955        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     4956        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     4957        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     4958        define variable vTeg as character no-undo.
     4959        define variable vLength as integer no-undo.
     4960        define variable vi as integer no-undo.
     4961        define variable vj as integer no-undo.
     4962        define buffer code for ub.code.
     4963        find first code where Code.parent eq "MarkType"
     4964                          and Code.CodeValue   eq mTypeMark
     4965                          no-lock no-error.
     4966        if     available code
     4967           and Code.misc1 ne ""
     4968           and Code.misc1 ne ?
     4969        then do:
     4970           integer (Code.misc1) no-error.
     4971           if not error-status:error
     4972           then
     4973             entry (4,vlistleng) = Code.misc1.
     4974        end.
     4975        if iAllTeg
     4976        then
     4977           assign
     4978              vlistElem     = vlistElem    + vlistElemDop
     4979              vlistleng     = vlistleng    + vlistlengDop
     4980           .
     4981        else if mMRCCode
     4982        then
     4983           assign
     4984              vlistElem     = vlistElem    + ",(8005),8005"
     4985              vlistleng     = vlistleng    + ",000006,0006"
     4986           .
     4987       block-elem:
     4988       do vi = 1 to num-entries(vlistElem):
     4989          vTeg = entry(vi,vlistElem).
     4990          if pstr begins vTeg
     4991          then do:
     4992             if    vTeg eq "21"
     4993             then
     4994                vLength = index(pstr,chr(29)) - 2 no-error.
     4995             if vLength  <= 0
     4996             then
     4997                vLength = int(entry(vi,vlistleng)).
     4998             otegval = substring (pstr,length(vteg) + 1, vLength).
     4999             oteg = replace(replace(vteg,")",""),"(","").
     5000             vTeg = vteg + otegval.
     5001             otegval = replace(otegval,chr(29),"").
     5002             oteg = replace(replace(oteg,")",""),"(","").
     5003             pstr = substring (pstr,length(vTeg)+ 1).
     5004             vTeg = replace(vTeg,chr(29),"").
     5005             leave block-elem.
     5006          end.
     5007          else
     5008             vTeg = "".
     5009       end.
     5010       return vteg.
     5011   end.
     5012   function GetCodeIdent return character
     5013   (iDm as char):
     5014      define variable Velement   as character no-undo init "first".
     5015      define variable oCodeIdent as character no-undo.
     5016      define variable vteg as character no-undo.
     5017      define variable vtegval as character no-undo.
     5018      define variable vGtin as character no-undo.
     5019      define buffer marking for ub.marking.
     5020      for first marking no-lock where
     5021                marking.mark eq iDm
     5022            and marking.unit-ext = "LEVEL2"
     5023      :
     5024        return iDm.
     5025      end.
     5026      vGtin  = getGtinByDM (iDm ).
     5027      ChekTypeMarkByDm(idm).
     5028      if iDm begins 'tech_':U
     5029      then
     5030         oCodeIdent = iDm.
     5031      else if length(iDm) < 21
     5032      then do:
     5033         find first marking where marking.mark eq idm
     5034         no-lock no-error.
     5035         oCodeIdent = if available marking then marking.mark else  ?.
     5036      end.
     5037      else if     length(iDm) eq 29
     5038         and not iDm begins "01"
     5039         and not iDm begins "02"
     5040      then
     5041         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     5042      else  if     length(iDm) >= 24
     5043               and (  iDm begins "01"
     5044                   or iDm begins "02")
     5045               and  substring(iDm,17,2) ne "21"
     5046      then do:
     5047         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     5048                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     5049         then
     5050            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     5051         else
     5052            oCodeIdent = iDM.
     5053      end.
     5054      else  if     (   length(iDm) eq 25
     5055                    or length(iDm) eq 21)
     5056               and (not iDm begins "01"
     5057               and  not iDm begins "02")
     5058      then
     5059         oCodeIdent = substring(iDm,1,21).
     5060      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     5061      then
     5062         oCodeIdent = substring(iDm,1,21).
     5063      else do while Velement ne "" and idm ne "":
     5064         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     5065         oCodeIdent = oCodeIdent + Velement.
     5066      end.
     5067      return oCodeIdent.
     5068   end.
     5069   function GetTegCod return character
     5070   (icodeIdent as char, iTeg as char):
     5071      define variable Velement   as character no-undo init "first".
     5072      define variable oTeg as character no-undo init ?.
     5073      define variable vteg as character no-undo.
     5074      define variable vtegval as character no-undo.
     5075      if     ((length(icodeIdent) eq 21
     5076         and not icodeIdent begins "01"
     5077         and not icodeIdent begins "02")
     5078         or
     5079             ( length(icodeIdent) eq 25
     5080               and not icodeIdent begins "01"
     5081               and not icodeIdent begins "02"))
     5082      then do:
     5083         if iTeg eq "01" or iTeg eq "02"
     5084         then
     5085            oTeg = substring(icodeIdent,1,21).
     5086         else  if  iTeg eq "21"
     5087         then
     5088            oTeg = substring(icodeIdent,15,7).
     5089      end.
     5090      else do:
     5091         ChekTypeMarkByDm(icodeIdent).
     5092         block-teg:
     5093            do while Velement ne "" and icodeIdent ne "":
     5094            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     5095            if    Velement begins iTeg
     5096               or Velement begins "(" + iTeg + ")"
     5097            then do:
     5098               oTeg = vtegval.
     5099               leave block-teg.
     5100            end.
     5101         end.
     5102      end.
     5103      return oTeg.
     5104   end.
     5105   function isOAD return logical
     5106   (icodeIdent as character):
     5107      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     5108   end.
     5109   function isMark return logical
     5110   (icodeIdent as character):
     5111      define buffer buf_marking for ub.marking.
     5112      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     5113             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     5114   end.
     5115   function addBracketForCode return character
     5116   (icodeIdent as char):
     5117      define variable Velement   as character no-undo init "first".
     5118      define variable oTeg as character no-undo.
     5119      define variable vteg as character no-undo.
     5120      define variable vtegval as character no-undo.
     5121      define buffer marking for ub.marking.
     5122      find first marking no-lock where
     5123                 marking.mark begins icodeIdent no-error.
     5124      if    not ChekTypeMarkByDm(icodeIdent)
     5125         or length(icodeIdent) le 24
     5126         or (avail marking and marking.unit-ext = "LEVEL2")
     5127      then
     5128         oTeg = icodeIdent.
     5129      else do:
     5130         if (  icodeIdent begins "01"
     5131            or icodeIdent begins "02"
     5132            ) and CheckGtin(substring (icodeIdent,3,14))
     5133            and substring (icodeIdent,17,2) eq "21"
     5134         then do:
     5135            mMRCCode = yes.
     5136            ChekTypeMarkByDm(icodeIdent).
     5137            block-teg:
     5138            do while Velement ne "" and icodeIdent ne "":
     5139               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     5140               if vteg ne ""
     5141               then
     5142                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     5143            end.
     5144            mMRCCode = no.
     5145         end.
     5146         else do:
     5147            oTeg = icodeIdent.
     5148         end.
     5149      end.
     5150      return oTeg.
     5151   end.
     5152   function getlevelByCodId return int
     5153   (iCode as char):
     5154      define variable vLength as int no-undo.
     5155      define variable vLevel  as int no-undo.
     5156      if not ChekTypeMarkByDM (icode) then return ?.
     5157      vLength = length(iCode).
     5158      if    vLength eq 18
     5159         or vLength eq 20
     5160      then
     5161         Vlevel = 4.
     5162      else if vLength eq 21
     5163      then
     5164         Vlevel = 1.
     5165      else if vLength eq 25
     5166      then do:
     5167         if  iCode begins "01"
     5168         then
     5169            Vlevel = 3.
     5170         else
     5171            Vlevel = 1.
     5172      end.
     5173      else if     vLength >= 26
     5174              and vLength <= 46
     5175      then do:
     5176         if    substring(iCode,17,2) eq "11"
     5177            or substring(iCode,17,2) eq "13"
     5178            or (    substring(iCode,17,2) eq "21"
     5179                and vLength >= 33
     5180                and substring(iCode,26,4) ne "8005")
     5181         then
     5182            Vlevel = 4.
     5183         else if    vLength eq 31
     5184                 or vLength eq 38
     5185                 or vLength eq 39
     5186                 or vLength eq 45
     5187         then
     5188            Vlevel = 1.
     5189         else if    vLength eq 35
     5190                 or vLength eq 43
     5191         then
     5192            Vlevel = 3.
     5193         else
     5194            Vlevel = ?.
     5195      end.
     5196      else
     5197         Vlevel = ?.
     5198      return Vlevel.
     5199   end.
     5200   function getLevelMotpBycodid return character
     5201   (iDm as char):
     5202      define variable vLevel as integer no-undo.
     5203      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     5204      vLevel = getlevelByCodId(iDm).
     5205      if    vLevel eq ?
     5206         or vLevel < 1
     5207         or vLevel > 6
     5208      then
     5209         return ?.
     5210      else
     5211         return entry(vlevel,vList).
     5212   end.
     5213   function getLevelUTDByLevelMotp return character
     5214   (iUnit as char):
     5215      define variable vLevel as integer no-undo.
     5216      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     5217      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     5218      vLevel = lookup(iUnit,vListMOTP).
     5219      if    vLevel eq ?
     5220         or vLevel < 1
     5221         or vLevel > 4
     5222      then
     5223         return ?.
     5224      else
     5225         return entry(vlevel,vListutd).
     5226   end.
     5227   function getLevelMotpByDM return character
     5228   (iDm as char):
     5229      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     5230   end.
     5231   function getLevelUTDByCodId return character
     5232   (iDm as char):
     5233      define variable vLevel as integer no-undo.
     5234      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     5235      vLevel = getlevelByCodId(iDm).
     5236      if    vLevel eq ?
     5237         or vLevel < 1
     5238         or vLevel > 4
     5239      then
     5240         return ?.
     5241      else
     5242         return entry(vlevel,vList).
     5243   end.
     5244   function getLevelUTDByDM return character
     5245   (iDm as char):
     5246      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     5247   end.
     5248   define variable mNotMarkQnty as logical no-undo.
     5249   function getQntyUTDByCodId return decimal
     5250   (iDM as char):
     5251      define variable vLevel as integer no-undo.
     5252      define variable vList as character no-undo init "1,5,10,500".
     5253      define variable vGtin as character no-undo.
     5254      define variable vqnty as decimal no-undo init ?.
     5255      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     5256      if vqnty eq ?
     5257      then do:
     5258         if not mNotMarkQnty
     5259         then do:
     5260            define buffer marking for ub.marking.
     5261            define variable vCodident as character no-undo.
     5262            vCodident = GetCodeIdent(idm).
     5263            find first marking where marking.mark begins vCodident no-lock no-error.
     5264            if     available marking
     5265               and marking.box-qnty ne ?
     5266            then
     5267               return marking.box-qnty.
     5268         end.
     5269         vGtin = getGtinByDm(iDM).
     5270         if ChekTypeMarkByGtin (vGtin)
     5271         then do:
     5272            vLevel = getlevelByCodId(iDM).
     5273            if     vLevel >= 1
     5274               and vLevel <= 4
     5275            then
     5276               vqnty = int(entry(vlevel,vList)).
     5277         end.
     5278         else
     5279            vqnty = getQntyCodeByGtin(vgtin).
     5280      end.
     5281      return vqnty.
     5282   end.
     5283   function getQntyUTDByDM return decimal
     5284   (iDm as char):
     5285      define variable vDM as character no-undo.
     5286      if     length (iDm) ne 25
     5287         and length (iDm) ne 29
     5288         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     5289      then
     5290         vDM = substring (iDm,1,length (iDm) - 6 ).
     5291      else
     5292         vDM = substring (iDm,1,length (iDm) - 4 ).
     5293      return getQntyUTDByCodId(vDM).
     5294   end.
     5295   function getMRC4 return decimal
     5296   (iMRC as char):
     5297      define variable oMrc     as decimal no-undo init ?.
     5298      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     5299      define variable vi       as integer no-undo.
     5300      define variable vfound   as integer no-undo.
     5301      define variable vposStart   as integer no-undo.
     5302      do:
     5303      OMRc = 0.
     5304      do vi = 1 to 4:
     5305         define variable vsimb as character no-undo.
     5306         vsimb = substring(iMRC,vi,1).
     5307         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     5308         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     5309         if vfound > 0
     5310         then
     5311            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     5312         end.
     5313         OMRc = OMRc / 100.
     5314      end.
     5315      return OMRc.
     5316   end.
     5317   function getMRCByDM return decimal
     5318   (iDm as char):
     5319      define variable vMRC     as character no-undo.
     5320      define variable oMrc     as decimal no-undo init ?.
     5321      define variable Velement as character no-undo init "empty".
     5322      define variable vteg as character no-undo.
     5323      define variable vtegval as character no-undo.
     5324      if    length(idm) eq 14 + 7 + 4 + 4
     5325         or length(idm) eq 14 + 7 + 4
     5326      then do:
     5327         vMRC = substring(idm,22,4).
     5328         omrc = getMRC4(vMRC).
     5329      end.
     5330      else do:
     5331          ChekTypeMarkByDm(iDm).
     5332          block-mrc:
     5333          do while Velement ne "" and idm ne "":
     5334             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     5335             if Velement begins "8005"
     5336             then do:
     5337                vMRC = substring(Velement,5,6).
     5338                leave block-mrc.
     5339             end.
     5340             else if Velement begins "(8005)"
     5341             then do:
     5342                vMRC = substring(Velement,7,6).
     5343                leave block-mrc.
     5344             end.
     5345          end.
     5346          if vMRC ne ""
     5347          then
     5348             OMRc = dec(vmrc) / 100 no-error.
     5349      end.
     5350      return OMRc.
     5351   end.
     5352   function MoveDate return Date
     5353   (idate as date,
     5354    iMonth as int64):
     5355      define variable vMonth   as int64 no-undo.
     5356      define variable vYear    as int64 no-undo.
     5357      define variable vDateNew as date  no-undo.
     5358       define variable vDay     as int64 no-undo.
     5359       vMonth = month(iDate) + iMonth.
     5360       vYear =  year(iDate).
     5361       if vMonth <= 0
     5362       then assign
     5363          vMonth = vMonth + 12
     5364           vYear  = vYear - 1
     5365       .
     5366       else if vMonth > 12
     5367       then assign
     5368          vMonth = vMonth - 12
     5369           vYear  = vYear + 1
     5370       .
     5371       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     5372       do while error-status:error eq yes:
     5373          VDay = vDay + 1.
     5374          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     5375       end.
     5376       if VDay > 0
     5377       then
     5378          vDateNew + 1.
     5379       return vDateNew.
     5380   end.
     5381   procedure checkEMRC:
     5382   define input  parameter iDm as character no-undo.
     5383   define output parameter vok as logical   no-undo init yes.
     5384      define variable v-value-emrc as character no-undo.
     5385      define variable v-type-emrc  as character no-undo.
     5386      define variable vDateIso     as character no-undo.
     5387      define variable vMRC         as decimal no-undo.
     5388      define variable vqnty        as decimal no-undo.
     5389      define variable vPrice       as decimal no-undo.
     5390      define variable vparent      as character no-undo.
     5391      define variable vgds-code    as integer no-undo.
     5392      define buffer code for ub.code.
     5393      vMRC = getMRCByDM(iDm).
     5394      if vMRC > 0
     5395      then do:
     5396         vgds-code = getGdsCodeByDM(iDm).
     5397         vqnty     = getQntyUTDByDM(iDm).
     5398               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     5399            (
     5400             input   vgds-code
     5401            ,input   'emrc-type':U
     5402            ,output   v-value-emrc
     5403            ,output   v-type-emrc
     5404          ) no-error.
     5405          if     v-value-emrc ne ""
     5406             and v-value-emrc ne ?
     5407          then do:
     5408             vDateIso = iso-date(today).
     5409             vPrice = vMRC / vqnty.
     5410             vparent ="emc" + chr(4) + v-value-emrc.
     5411             find last code where Code.parent      eq vparent
     5412                              and Code.code        le vDateIso
     5413                              and code.status_  eq 0
     5414             no-lock no-error.
     5415             if not available code or ( vPrice  >= dec(Code.CodeValue))
     5416             then
     5417                vOk = true .
     5418             else do:
     5419                 define variable vText      as character no-undo.
     5420                 define variable vDate      as date no-undo.
     5421                 define variable vDateLast  as character no-undo.
     5422                 define variable vDateFirst as character no-undo.
     5423                 define variable vDate3     as date no-undo.
     5424                 vdate = date(code.misc1).
     5425                 vDateLast = code.misc1.
     5426                 vDate3 = MoveDate(today, - 3 ).
     5427                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     5428                                      string(vDate3  , "99/99/9999"),
     5429                                      string(vDate   , "99/99/9999")
     5430                                      ).
     5431                 vdateIso = iso-date(vdate3).
     5432                 find last code  where Code.parent      eq vparent
     5433                                   and Code.code        le vDateIso
     5434                                   and code.status_  eq 0 no-lock no-error.
     5435                 if available code
     5436                 then
     5437                    vDateIso = code.code.
     5438                 vDateFirst = vDateIso.
     5439                 vDateLast = iso-date(vdate).
     5440                 define variable vGood as logical no-undo.
     5441                 define variable vDateSale as date no-undo.
     5442                 define buffer bcode for code.
     5443                 for last code where Code.parent   eq vparent
     5444                                 and code.status_  eq 0
     5445                                 and code.code     < vDateLast
     5446                                 and code.code     >= vDateFirst
     5447                 no-lock:
     5448                    find first bcode where bCode.parent   eq vparent
     5449                                       and bcode.status_  eq 0
     5450                                       and bcode.code     > code.code no-lock no-error.
     5451                    if available bcode
     5452                    then do:
     5453                       if vPrice < dec(Code.CodeValue)
     5454                       then
     5455                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     5456                                                     chr(10),
     5457                                                     string(    date( code.misc1)       ,"99/99/9999"),
     5458                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     5459                                                     ).
     5460                       else do:
     5461                          vGood = yes.
     5462                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     5463                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     5464                                                     chr(10),
     5465                                                     string(    date( code.misc1)         ,"99/99/9999"),
     5466                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     5467                                                     string(         vDateSale            ,"99/99/9999"),
     5468                                                     string(vDateSale - today)
     5469                                                     ).
     5470                       end.
     5471                    end.
     5472                 end.
     5473                 if vgood
     5474                 then do:
     5475                    define variable choice as integer no-undo .
     5476                    run gbl/d-askw.w (input "Уточнение"
     5477                           ,input  vText
     5478                           ,input "|"
     5479                           ,input "Принять|Вернуть"
     5480                           ,input "Принять данный товар|Вернуть товар постащику"
     5481                           ,input 1
     5482                           ,input 2
     5483                           ,output choice) no-error.
     5484                    vok = choice eq 1.
     5485                 end.
     5486                 else
     5487                    vok =false.
     5488             end.
     5489          end.
     5490      end.
     5491   end.
     5492   function addGs2Mark return character
     5493   (iMark as char):
     5494      define variable vDM   as character no-undo.
     5495      define variable vIdx  as integer   no-undo.
     5496      if index(iMark,chr(29),1) > 0
     5497      then return iMark.
     5498      if substring(iMark,26,4) = "8005" then
     5499      do:
     5500        vIdx = index(iMark,"93",26 + 4 + 5).
     5501        if vIdx > 1 then do:
     5502          vDM = substitute("&1&4&2&4&3",
     5503                           substring(iMark,1,25),
     5504                           substring(iMark,26,vIdx - 25 - 1),
     5505                           substring(iMark,vIdx),
     5506                           chr(29)) no-error.
     5507          vIdx = index(vDm,"240",vIdx + 4).
     5508          if vIdx > 0 then
     5509          do:
     5510            vDM = substitute("&1&3&2",
     5511                             substring(vDm,1,vIdx - 1),
     5512                             substring(vDm,vIdx),
     5513                             chr(29)) no-error.
     5514          end.
     5515        end.
     5516        else
     5517          vDM = substitute("&1&3&2",
     5518                           substring(iMark,1,25),
     5519                           substring(iMark,26),
     5520                           chr(29)) no-error.
     5521      end.
     5522      else if substring(iMark,32,2) = "91" then
     5523      do:
     5524        vIdx = index(iMark,"92",32).
     5525        if vIdx > 1 then
     5526          vDM = substitute("&1&4&2&4&3",
     5527                           substring(iMark,1,31),
     5528                           substring(iMark,32,vIdx - 31 - 1),
     5529                           substring(iMark,vIdx),
     5530                           chr(29)) no-error.
     5531        else
     5532          vDM = substitute("&1&3&2",
     5533                           substring(iMark,1,31),
     5534                           substring(iMark,32),
     5535                           chr(29)) no-error.
     5536      end.
     5537      else if substring(iMark,39,2) = "91" then
     5538      do:
     5539        vIdx = index(iMark,"92",38).
     5540        if vIdx > 1 then
     5541          vDM = substitute("&1&4&2&4&3",
     5542                           substring(iMark,1,38),
     5543                           substring(iMark,39,vIdx - 38 - 1),
     5544                           substring(iMark,vIdx),
     5545                           chr(29)) no-error.
     5546        else
     5547          vDM = substitute("&1&3&2",
     5548                           substring(iMark,1,38),
     5549                           substring(iMark,39),
     5550                           chr(29)) no-error.
     5551      end.
     5552      else if substring(iMark,25,2) = "93" then
     5553      do:
     5554        vIdx = index(iMark,"92",25).
     5555        if vIdx > 1 then
     5556          vDM = substitute("&1&4&2&4&3",
     5557                           substring(iMark,1,24),
     5558                           substring(iMark,25,vIdx - 24 - 1),
     5559                           substring(iMark,vIdx),
     5560                           chr(29)) no-error.
     5561        else
     5562          vIdx = index(iMark,"3103",25).
     5563          if vIdx > 0 then
     5564          vDM = substitute("&1&4&2&4&3",
     5565                           substring(iMark,1,24),
     5566                           substring(iMark,25,vIdx - 24 - 1),
     5567                           substring(iMark,vIdx),
     5568                           chr(29)) no-error.
     5569          else
     5570            vDM = substitute("&1&3&2",
     5571                             substring(iMark,1,24),
     5572                             substring(iMark,25),
     5573                             chr(29)) no-error.
     5574      end.
     5575      else if substring(iMark,32,2) = "93" then
     5576      do:
     5577        vDM = substitute("&1&3&2",
     5578              substring(iMark,1,31),
     5579              substring(iMark,32),
     5580              chr(29)) no-error.
     5581      end.
     5582      return if vDM <> "" then vDm else iMark.
     5583   end.
     5584   def var vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5585   procedure gen-key-rec :
     5586     define input  parameter p-tbl-name    as character no-undo.
     5587     define input  parameter p-bh_tbl-name as handle    no-undo.
     5588     define output parameter p-key-rec     as character no-undo.
     5589     do
     5590     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5591     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     5592     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     5593     :
     5594       define variable fh               as handle    no-undo .
     5595       define variable v-ok             as logical   no-undo .
     5596       define variable v-inform         as character no-undo .
     5597       define variable v-ind            as integer   no-undo .
     5598       define variable v-idx-field-qnty as integer   no-undo .
     5599       if p-tbl-name = ?
     5600         or p-tbl-name = "":U
     5601       then do:
     5602         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info34 ).
     5603       end.
     5604       if not p-bh_tbl-name:available then do:
     5605         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info34, p-tbl-name ).
     5606       end.
     5607       assign
     5608         p-key-rec = p-tbl-name
     5609         v-inform  = p-bh_tbl-name:index-information(1)
     5610         v-ind     = 2
     5611       .
     5612       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     5613       on error undo, return error
     5614       :
     5615         assign
     5616           v-inform = p-bh_tbl-name:index-information( v-ind )
     5617           v-ind    = v-ind + 1
     5618         .
     5619       end.
     5620       if v-inform = ?
     5621         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     5622         or entry( 3, v-inform, ",":U ) <> "1":U
     5623       then do:
     5624         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info34, p-tbl-name ).
     5625       end.
     5626       else do:
     5627         assign
     5628           v-idx-field-qnty = num-entries( v-inform ) - 4
     5629         .
     5630         if v-idx-field-qnty < 2 then do:
     5631           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info34, v-inform, p-tbl-name ).
     5632         end.
     5633         do v-ind = 1 to v-idx-field-qnty by 2
     5634         on error undo, return error
     5635         :
     5636           assign
     5637             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     5638             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     5639           .
     5640         end.
     5641       end.
     5642       if p-key-rec = ? then do:
     5643         assign
     5644           p-key-rec = "":U
     5645         .
     5646         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info34, p-tbl-name ).
     5647       end.
     5648     end.
     5649     return.
     5650   end procedure.
     5651   procedure gen-where-keyr-tab :
     5652     define input  parameter i-tableSerach as character no-undo.
     5653     define input  parameter i-tablekey   as character  no-undo.
     5654     define input  parameter p-key-rec    as character  no-undo.
     5655     define input  parameter p-key-handle as handle     no-undo .
     5656     define input  parameter p-db-name    as character  no-undo .
     5657     define input  parameter p-tt-handle  as handle     no-undo .
     5658     define output parameter o-Where      as character  no-undo.
     5659     do
     5660     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5661     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     5662     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     5663     :
     5664       define variable v-full-tbl-name  as character no-undo .
     5665       define variable bh_tbl-name      as handle    no-undo .
     5666       define variable fh_key           as handle    no-undo .
     5667       define variable fh_search        as handle    no-undo .
     5668       define variable v-field-num      as integer   no-undo .
     5669       define variable v-count-fld      as integer   no-undo .
     5670       define variable v-inform         as character no-undo .
     5671       define variable v-ind            as integer   no-undo .
     5672       define variable v-idx-field-qnty as integer   no-undo .
     5673       define variable v-field-name     as character no-undo .
     5674       define variable v-field-val      as character no-undo .
     5675       define variable v-word-link      as character no-undo .
     5676       define variable vTable           as character no-undo.
     5677       define variable bh_tbl-key       as handle    no-undo .
     5678       assign
     5679         p-key-rec = trim( p-key-rec )
     5680       .
     5681       if p-key-handle <> ? then do:
     5682         if not valid-handle(p-key-handle)
     5683            or p-key-handle:type <> "buffer"
     5684         then do:
     5685           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info34 ).
     5686         end.
     5687         if num-entries( p-key-rec, chr(3) ) > 1
     5688           or p-key-rec = ?
     5689           or p-key-rec = "":U
     5690         then do:
     5691           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info34, p-key-rec ).
     5692         end.
     5693       end.
     5694       else do:
     5695         if p-key-rec = ?
     5696           or p-key-rec = "":U
     5697         then do:
     5698           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info34 ).
     5699         end.
     5700       end.
     5701       assign
     5702         vTable = entry( 1 , p-key-rec, chr(3) )
     5703       .
     5704       if p-tt-handle <> ?
     5705         and ( not valid-handle(p-tt-handle)
     5706               or p-tt-handle:type <> "buffer"
     5707             )
     5708       then do:
     5709         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info34, vTable, chr(10) ).
     5710       end.
     5711       if p-tt-handle = ? then do:
     5712         assign
     5713           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     5714         .
     5715         create buffer bh_tbl-name for table v-full-tbl-name .
     5716       end.
     5717       else do:
     5718         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     5719       end.
     5720       assign
     5721         v-inform = bh_tbl-name:index-information(1)
     5722         v-ind    = 2
     5723       .
     5724       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     5725       on error undo, return error
     5726       :
     5727         assign
     5728           v-inform = bh_tbl-name:index-information( v-ind )
     5729           v-ind    = v-ind + 1
     5730         .
     5731       end.
     5732       if v-inform = ?
     5733         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     5734         or entry( 3, v-inform, ",":U ) <> "1":U
     5735       then do:
     5736         delete object bh_tbl-name no-error.
     5737         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info34, vTable ).
     5738       end.
     5739       assign
     5740         v-idx-field-qnty = num-entries( v-inform ) - 4
     5741       .
     5742       if v-idx-field-qnty < 2 then do:
     5743         delete object bh_tbl-name no-error.
     5744         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info34, v-inform, vTable ).
     5745       end.
     5746       assign
     5747         o-where     = "where":U
     5748         v-word-link = "":U
     5749         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     5750         v-count-fld = 0
     5751       .
     5752       if i-tablekey ne "" and i-tablekey ne ?
     5753       then do:
     5754         assign
     5755           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     5756         .
     5757         create buffer bh_tbl-key for table v-full-tbl-name .
     5758       end.
     5759       if i-tableSerach ne "" and i-tableSerach ne ?
     5760       then do:
     5761         delete object bh_tbl-name no-error.
     5762         assign
     5763           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     5764         .
     5765         create buffer bh_tbl-name for table v-full-tbl-name .
     5766       end.
     5767       block_where:
     5768       do v-ind = 1 to v-idx-field-qnty by 2
     5769       on error undo, return error
     5770       :
     5771         assign
     5772           v-count-fld = v-count-fld + 1
     5773         .
     5774         if p-key-handle = ?
     5775           and v-count-fld > v-field-num
     5776         then do:
     5777           leave block_where.
     5778         end.
     5779         define variable VfieldKeyTable as handle no-undo.
     5780         assign
     5781           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     5782           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     5783         .
     5784         if     bh_tbl-key ne ?
     5785         then do:
     5786            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     5787            if VfieldKeyTable eq ?
     5788            then next block_where.
     5789         end.
     5790         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     5791         then
     5792            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     5793         else
     5794            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     5795         if p-key-handle = ? then do:
     5796           assign
     5797             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     5798           .
     5799         end.
     5800         else do:
     5801           assign
     5802             fh_key = p-key-handle:buffer-field( v-field-name )
     5803           .
     5804           if fh_key = ?
     5805             or not valid-handle( fh_key )
     5806           then do:
     5807             delete object bh_tbl-name.
     5808             if     bh_tbl-key ne ?
     5809             then
     5810                delete object bh_tbl-key.
     5811             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info34, p-key-handle:name, v-field-name ).
     5812           end.
     5813           assign
     5814             v-field-val = fh_key:buffer-value
     5815           .
     5816         end.
     5817         if fh_search:data-type ="character":U then do:
     5818           assign
     5819             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     5820             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     5821             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     5822             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     5823             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     5824             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     5825             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     5826             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     5827             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     5828             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     5829             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     5830             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     5831             v-field-val = substitute( '"&1"', v-field-val )
     5832           .
     5833         end.
     5834         assign
     5835           o-where = substitute( "&1 &2", o-where, v-field-val )
     5836         .
     5837         if v-word-link = "":U then do:
     5838           assign
     5839             v-word-link = "and":U
     5840           .
     5841         end.
     5842       end.
     5843       delete object bh_tbl-name.
     5844       if     bh_tbl-key ne ?
     5845       then
     5846          delete object bh_tbl-key.
     5847       if p-key-handle = ?
     5848         and v-count-fld <> v-field-num
     5849       then do:
     5850         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info34, vTable ).
     5851       end.
     5852     end.
     5853   end procedure.
     5854   procedure gen-hn-keyr-tab :
     5855     define input  parameter i-tableSerach as character no-undo.
     5856     define input  parameter i-tablekey   as character no-undo.
     5857     define input  parameter p-key-rec    as character no-undo.
     5858     define input  parameter p-key-handle as handle    no-undo .
     5859     define input  parameter p-db-name    as character no-undo .
     5860     define input  parameter p-tt-handle  as handle    no-undo .
     5861     define input  parameter p-stts-lock  as integer   no-undo .
     5862     define output parameter o-hn         as handle    no-undo.
     5863     define variable v-full-tbl-name as character no-undo.
     5864     define variable v-where         as character no-undo.
     5865     define variable bh_tbl-name     as handle    no-undo.
     5866     define variable vTable          as character no-undo.
     5867     do
     5868     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5869     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     5870     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     5871         run gen-where-keyr-tab(i-tableSerach,
     5872                                i-tablekey,
     5873                                p-key-rec,
     5874                                p-key-handle,
     5875                                p-db-name,
     5876                                p-tt-handle,
     5877                                output v-where).
     5878         if i-tableSerach ne "" and i-tableSerach ne ?
     5879         then do:
     5880            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     5881            create buffer bh_tbl-name for table v-full-tbl-name .
     5882         end.
     5883         else do:
     5884            if p-tt-handle = ? then do:
     5885               assign
     5886                  vTable = entry( 1 , p-key-rec, chr(3) )
     5887               .
     5888               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     5889               create buffer bh_tbl-name for table v-full-tbl-name .
     5890            end.
     5891            else do:
     5892               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     5893            end.
     5894         end.
     5895         if p-tt-handle = ? then do:
     5896            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     5897         end.
     5898         else do:
     5899            bh_tbl-name:find-first( v-where ) no-error .
     5900         end.
     5901         o-hn = bh_tbl-name.
     5902      end.
     5903   end procedure.
     5904   procedure gen-hn-keyr :
     5905     define input  parameter p-key-rec    as character no-undo.
     5906     define input  parameter p-key-handle as handle    no-undo .
     5907     define input  parameter p-db-name    as character no-undo .
     5908     define input  parameter p-tt-handle  as handle    no-undo .
     5909     define input  parameter p-stts-lock  as integer   no-undo .
     5910     define output parameter o-hn         as handle    no-undo.
     5911     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     5912   end.
     5913   procedure gen-row-keyr :
     5914     define input  parameter p-key-rec    as character no-undo.
     5915     define input  parameter p-key-handle as handle    no-undo .
     5916     define input  parameter p-db-name    as character no-undo .
     5917     define input  parameter p-tt-handle  as handle    no-undo .
     5918     define input  parameter p-stts-lock  as integer   no-undo .
     5919     define output parameter p-tbl-row    as rowid     no-undo.
     5920     define output parameter p-tbl-name   as character no-undo.
     5921     define variable vHn as handle no-undo.
     5922       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     5923       p-tbl-row = if vHn:available then vHn:rowid else ?.
     5924       p-tbl-name =  vHn:table.
     5925       delete object vHn no-error.
     5926     if p-tbl-row = ? then do:
     5927       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info34, p-tbl-name, p-key-rec ).
     5928     end.
     5929     else do:
     5930       return.
     5931     end.
     5932   end procedure.
     5933   procedure gen-key-fv :
     5934     define input  parameter p-key-rec    as character no-undo .
     5935     define output parameter p-field-list as character no-undo .
     5936     define output parameter p-value-list as character no-undo.
     5937     do
     5938     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5939     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     5940     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     5941     :
     5942       define variable v-full-tbl-name  as character no-undo .
     5943       define variable bh_tbl-name      as handle    no-undo .
     5944       define variable v-tbl-name       as character no-undo .
     5945       define variable v-field-num      as integer   no-undo .
     5946       define variable v-count-fld      as integer   no-undo .
     5947       define variable v-inform         as character no-undo .
     5948       define variable v-ind            as integer   no-undo .
     5949       define variable v-idx-field-qnty as integer   no-undo .
     5950       define variable v-delim-key      as character no-undo .
     5951       if p-key-rec = ?
     5952         or p-key-rec = "":U
     5953       then do:
     5954         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info34 ).
     5955       end.
     5956       assign
     5957         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     5958         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     5959       .
     5960       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     5961       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info34 ).
     5962       assign
     5963         v-inform = bh_tbl-name:index-information(1)
     5964         v-ind    = 2
     5965       .
     5966       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     5967       on error undo, return error
     5968       :
     5969         assign
     5970           v-inform = bh_tbl-name:index-information( v-ind )
     5971           v-ind    = v-ind + 1
     5972         .
     5973       end.
     5974       if v-inform = ?
     5975         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     5976         or entry( 3, v-inform, ",":U ) <> "1":U
     5977       then do:
     5978         delete object bh_tbl-name no-error.
     5979         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info34, v-tbl-name ).
     5980       end.
     5981       assign
     5982         v-idx-field-qnty = num-entries( v-inform ) - 4
     5983       .
     5984       if v-idx-field-qnty < 2 then do:
     5985         delete object bh_tbl-name no-error.
     5986         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info34, v-inform, v-tbl-name ).
     5987       end.
     5988       assign
     5989         p-field-list = "":U
     5990         p-value-list = "":U
     5991         v-delim-key  = "":U
     5992         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     5993         v-count-fld  = 0
     5994       .
     5995       block_where:
     5996       do v-ind = 1 to v-idx-field-qnty by 2
     5997       on error undo, return error
     5998       :
     5999         assign
     6000           v-count-fld = v-count-fld + 1
     6001         .
     6002         if v-count-fld > v-field-num then do:
     6003           leave block_where.
     6004         end.
     6005         assign
     6006           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     6007           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     6008         .
     6009         if v-ind = 1 then do:
     6010           assign
     6011             v-delim-key = chr(3)
     6012           .
     6013         end.
     6014       end.
     6015       delete object bh_tbl-name.
     6016       if v-count-fld <> v-field-num then do:
     6017         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info34, v-tbl-name ).
     6018       end.
     6019     end.
     6020   end procedure.
     6021   procedure gen-key-field :
     6022     define input  parameter p-table      as character no-undo .
     6023     define output parameter p-field-list as character no-undo .
     6024     do
     6025     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     6026     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     6027     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     6028     :
     6029       define variable v-full-tbl-name  as character no-undo .
     6030       define variable bh_tbl-name      as handle    no-undo .
     6031       define variable v-tbl-name       as character no-undo .
     6032       define variable v-field-num      as integer   no-undo .
     6033       define variable v-count-fld      as integer   no-undo .
     6034       define variable v-inform         as character no-undo .
     6035       define variable v-ind            as integer   no-undo .
     6036       define variable v-idx-field-qnty as integer   no-undo .
     6037       define variable v-delim-key      as character no-undo .
     6038       if p-table = ?
     6039         or p-table = "":U
     6040       then do:
     6041         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info34 ).
     6042       end.
     6043       assign
     6044         v-tbl-name      = p-table
     6045         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     6046       .
     6047       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     6048       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info34 ).
     6049       assign
     6050         v-inform = bh_tbl-name:index-information(1)
     6051         v-ind    = 2
     6052       .
     6053       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     6054       on error undo, return error
     6055       :
     6056         assign
     6057           v-inform = bh_tbl-name:index-information( v-ind )
     6058           v-ind    = v-ind + 1
     6059         .
     6060       end.
     6061       if v-inform = ?
     6062         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     6063         or entry( 3, v-inform, ",":U ) <> "1":U
     6064       then do:
     6065         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info34, v-tbl-name ).
     6066       end.
     6067       assign
     6068         v-idx-field-qnty = num-entries( v-inform ) - 4
     6069       .
     6070       if v-idx-field-qnty < 2 then do:
     6071         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info34, v-inform, v-tbl-name ).
     6072       end.
     6073       assign
     6074         p-field-list = "":U
     6075         v-delim-key  = "":U
     6076         v-count-fld  = 0
     6077       .
     6078       block_where:
     6079       do v-ind = 1 to v-idx-field-qnty by 2
     6080       on error undo, return error
     6081       :
     6082         assign
     6083           v-count-fld = v-count-fld + 1
     6084         .
     6085         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     6086         if v-ind = 1 then do:
     6087           assign
     6088             v-delim-key = chr(3)
     6089           .
     6090         end.
     6091       end.
     6092       delete object bh_tbl-name.
     6093     end.
     6094   end procedure.
     6095   function AddUtdErrForTab returns logical
     6096   (idb-num         as integer ,
     6097    idoc-id         as integer ,
     6098    iTab            as character,
     6099    iObj            as handle ,
     6100    iCheckType      as character,
     6101    iCodeErr        as character,
     6102    iCheckObj       as character ):
     6103      define buffer utd-err for utd-err.
     6104      define buffer utd for utd.
     6105      find first utd where utd.db-num     eq idb-num
     6106                       and utd.doc-id     eq idoc-id
     6107                       and utd.Direction  eq 'Outbound'
     6108      no-lock no-error.
     6109      if available utd
     6110      then
     6111         return no.
     6112      define variable vRecKey as character no-undo.
     6113            run gen-key-rec (input iTab,
     6114                             input  iObj,
     6115                             output vRecKey).
     6116      find first utd-err where utd-err.db-num     eq idb-num
     6117                           and utd-err.doc-id     eq idoc-id
     6118                           and utd-err.CheckType  eq iCheckType
     6119                           and utd-err.CodeErr    eq iCodeErr
     6120                           and utd-err.CheckObj   eq iCheckObj
     6121      exclusive-lock no-error.
     6122      if not available utd-err
     6123      then do:
     6124         create utd-err.
     6125         assign
     6126            utd-err.db-num         = idb-num
     6127            utd-err.doc-id         = idoc-id
     6128            utd-err.CheckType      = iCheckType
     6129            utd-err.CodeErr        = iCodeErr
     6130            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     6131            utd-err.reckey         = vRecKey
     6132            utd-err.qnty           = 1
     6133         .
     6134      end.
     6135      else
     6136         utd-err.qnty = utd-err.qnty + 1.
     6137      return utd-err.qnty eq 1.
     6138   end.
     6139   function AddUtdErr returns logical
     6140   (idb-num         as integer ,
     6141    idoc-id         as integer ,
     6142    iObj            as handle ,
     6143    iCheckType      as character,
     6144    iCodeErr        as character,
     6145    iCheckObj       as character ):
     6146      AddUtdErrForTab
     6147         (idb-num,
     6148          idoc-id,
     6149          iObj:table,
     6150          iObj,
     6151          iCheckType,
     6152          iCodeErr,
     6153          iCheckObj).
     6154   end.
     6155   function ClearUtdErrTypeCode returns logical
     6156   (idb-num         as integer,
     6157    idoc-id         as integer ,
     6158    iCheckType      as character,
     6159    iCodeErr        as character
     6160    ):
     6161      define buffer utd-err for utd-err.
     6162      if    iCheckType eq "*"
     6163         or iCheckType eq ?
     6164      then do:
     6165         if     iCodeErr ne ?
     6166            and iCodeErr ne "*"
     6167         then
     6168            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     6169            view-as alert-box.
     6170         else
     6171         for each utd-err where utd-err.db-num  eq idb-num
     6172                            and utd-err.doc-id  eq idoc-id
     6173         exclusive-lock:
     6174            delete utd-err.
     6175         end.
     6176      end.
     6177      else do:
     6178         if    iCodeErr eq ?
     6179            or iCodeErr eq "*"
     6180         then do:
     6181            for each utd-err where utd-err.db-num     eq idb-num
     6182                               and utd-err.doc-id     eq idoc-id
     6183                               and utd-err.CheckType  eq iCheckType
     6184            exclusive-lock:
     6185               delete utd-err.
     6186            end.
     6187         end.
     6188         else do:
     6189            for each utd-err where utd-err.db-num     eq idb-num
     6190                               and utd-err.doc-id     eq idoc-id
     6191                               and utd-err.CheckType  eq iCheckType
     6192                               and ub.utd-err.CodeErr eq iCodeErr
     6193            exclusive-lock:
     6194               delete utd-err.
     6195            end.
     6196         end.
     6197      end.
     6198   end.
     6199   function ClearUtdErr returns logical
     6200   (idb-num         as integer,
     6201    idoc-id         as integer ,
     6202    iCheckType      as character
     6203    ):
     6204      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     6205   end.
     6206   function GetMesError returns character
     6207   (itxt as character,
     6208    iobj as character ):
     6209    define variable vi as integer no-undo.
     6210    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     6211       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     6212    end.
     6213    return itxt.
     6214   end.
     6215   function GetTextErrorType returns character
     6216   (iCheckType as character,
     6217    iCodeErr   as character,
     6218    iChechObj  as character,
     6219    iType      as character  ):
     6220      define buffer code    for code.
     6221      define variable vError as character no-undo.
     6222      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     6223                        and code.code   eq iCodeErr
     6224      no-lock no-error.
     6225      if available code
     6226      then do:
     6227         define variable vType as integer no-undo.
     6228         if code.misc3 eq "error"
     6229         then
     6230            vType = 0.
     6231         else if code.misc3 eq "warning"
     6232         then
     6233            vType = 1.
     6234         else if code.misc3 eq "Hiden"
     6235         then
     6236            vType = 2.
     6237         else
     6238            vtype = int(code.misc3) no-error.
     6239         case itype:
     6240            when "error"
     6241            then do:
     6242               if vtype eq 0
     6243               then
     6244                  vError = GetMesError(Code.CodeValue,iChechObj).
     6245            end.
     6246            when "warning"
     6247            then do:
     6248               if vtype <= 1
     6249               then
     6250                  vError = GetMesError(Code.CodeValue,iChechObj).
     6251            end.
     6252            otherwise do:
     6253               vError = GetMesError(Code.CodeValue,iChechObj).
     6254            end.
     6255         end.
     6256      end.
     6257      else
     6258         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     6259      return vError.
     6260   end.
     6261   function GetTypeError returns integer
     6262   (iCheckType as character,
     6263    iCodeErr   as character):
     6264      define buffer code    for code.
     6265      define variable vType as integer no-undo.
     6266      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     6267                        and code.code   eq iCodeErr
     6268      no-lock no-error.
     6269      if     not available code
     6270         and code.misc3 eq "error"
     6271      then
     6272         vType = 0.
     6273      else if code.misc3 eq "warning"
     6274      then
     6275         vType = 1.
     6276      else if code.misc3 eq "Hiden"
     6277      then
     6278         vType = 2.
     6279      else
     6280         vtype = int(code.misc3) no-error.
     6281      return vtype.
     6282   end.
     6283   function GetTextError returns character
     6284   (iCheckType as character,
     6285    iCodeErr   as character,
     6286    iChechObj  as character ):
     6287      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     6288   end.
     6289   function GetErrForUtdStr returns character
     6290   (idb-num     as integer ,
     6291    idoc-id     as integer ,
     6292    iCheckType  as character
     6293    ):
     6294      define buffer utd-err for utd-err.
     6295      define buffer code    for code.
     6296      define variable vHQry as handle no-undo.
     6297      define variable vError as longchar no-undo.
     6298      define variable vErrorOne as longchar  no-undo.
     6299      define variable oError as character no-undo.
     6300      create query vHQry.
     6301      vHQry:set-buffers(buffer utd-err:handle).
     6302      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     6303                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     6304                               + if    iCheckType eq "*"
     6305                                    or iCheckType eq ?
     6306                                 then       ""
     6307                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     6308      vHQry:query-open().
     6309      vHQry:get-first().
     6310      QRY-BLOCK:
     6311      repeat while not vHQry:query-off-end:
     6312         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     6313         if     vErrorOne ne ""
     6314            and vErrorOne ne ?
     6315         then
     6316            vError = vError + ", " + vErrorOne.
     6317         vHQry:get-next().
     6318      end.
     6319      oError = substring(vError,3,4002).
     6320      return oError.
     6321   end.
     6322   function GetErrJsonForUtd returns character
     6323   (idb-num         as integer ,
     6324    idoc-id         as integer ,
     6325    iCheckType      as character
     6326    ):
     6327      define buffer utd-err for utd-err.
     6328      define variable vHQry as handle no-undo.
     6329      define variable vError as longchar no-undo.
     6330      define variable oError as character no-undo.
     6331      create query vHQry.
     6332      define variable vi as integer no-undo.
     6333      vHQry:set-buffers(buffer utd-err:handle).
     6334      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     6335                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     6336                               + if    iCheckType eq "*"
     6337                                    or iCheckType eq ?
     6338                                 then       ""
     6339                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     6340      vHQry:query-open().
     6341      vHQry:get-first().
     6342      QRY-BLOCK:
     6343      repeat while not vHQry:query-off-end:
     6344         define variable vErrorOne as character no-undo.
     6345         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     6346         if     vErrorOne ne ?
     6347            and vErrorOne ne ""
     6348         then do:
     6349            vi = vi + 1.
     6350            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     6351                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     6352                            + '","ТекстОш":"' + vErrorOne + '"}'.
     6353         end.
     6354         vHQry:get-next().
     6355      end.
     6356      for first utd where utd.db-num eq idb-num
     6357                      and utd.doc-id eq idoc-id
     6358                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     6359      no-lock,
     6360         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     6361                                  and utd-marking-lines.doc-id eq idoc-id
     6362                                  and utd-marking-lines.doc-level eq 1
     6363      no-lock,
     6364         first marking where marking.mark eq utd-marking-lines.mark
     6365                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     6366      no-lock:
     6367         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     6368         if     vErrorOne ne ?
     6369            and vErrorOne ne ""
     6370         then do:
     6371            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     6372                            + '","ОбъектОш":"' + marking.mark
     6373                            + '","ТекстОш":"' + vErrorOne + '"}'.
     6374         end.
     6375      end.
     6376      if vError ne ""
     6377      then
     6378         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     6379      return oError.
     6380   end.
     6381   function GetErrJsonForUtdReturn returns character
     6382   (idb-num         as integer ,
     6383    idoc-id         as integer ,
     6384    iCheckType      as character
     6385    ):
     6386      define buffer utd-err for utd-err.
     6387      define variable vHQry as handle no-undo.
     6388      define variable vError as longchar no-undo.
     6389      define variable oError as character no-undo.
     6390      define variable vi as integer no-undo.
     6391      create query vHQry.
     6392      vHQry:set-buffers(buffer utd-err:handle).
     6393      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     6394                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     6395                               + if    iCheckType eq "*"
     6396                                    or iCheckType eq ?
     6397                                 then       ""
     6398                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     6399      vHQry:query-open().
     6400      vHQry:get-first().
     6401      QRY-BLOCK:
     6402      repeat while not vHQry:query-off-end:
     6403         define variable vErrorOne as character no-undo.
     6404         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     6405         if     vErrorOne ne ?
     6406            and vErrorOne ne ""
     6407         then do:
     6408            vi = vi + 1.
     6409            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     6410                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     6411                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     6412         end.
     6413         vHQry:get-next().
     6414      end.
     6415      if vError ne ""
     6416      then
     6417         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     6418      return oError.
     6419   end.
     6420   function GetCodeTextError returns character
     6421   (iCheckType as character,
     6422    iCodeErr   as character,
     6423    iChechObj  as character,
     6424    output oCode as character,
     6425    output ovalue as character ):
     6426      define buffer code    for code.
     6427      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     6428                        and code.code   eq iCodeErr
     6429      no-lock no-error.
     6430      if     available code
     6431      then do:
     6432         define variable vi as integer no-undo init ?.
     6433         vi = int(Code.misc3) no-error.
     6434         if    code.misc3 ne "error"
     6435            and vi ne 0
     6436         then
     6437            oCode = ?.
     6438         else if     Code.misc1 ne ?
     6439                 and Code.misc1 ne ""
     6440         then
     6441            assign
     6442               oCode  = GetMesError(Code.misc1,iChechObj)
     6443               ovalue = GetMesError(Code.misc2,iChechObj)
     6444            .
     6445      end.
     6446      return if oCode eq ""
     6447             then ""
     6448             else (oCode + "_" + ovalue).
     6449   end.
     6450   define temp-table TT-err no-undo
     6451     field code_ as character
     6452     field text_ as character
     6453   index code_ code_.
     6454   function GetErrTxtForUtd returns character
     6455   (idb-num         as integer ,
     6456    idoc-id         as integer ,
     6457    iCheckType      as character
     6458    ):
     6459      define buffer utd-err for utd-err.
     6460      define variable vHQry as handle no-undo.
     6461      define variable oError as character no-undo.
     6462      create query vHQry.
     6463      define variable vi as integer no-undo.
     6464      for each tt-err :
     6465         delete tt-err.
     6466      end.
     6467      vHQry:set-buffers(buffer utd-err:handle).
     6468      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     6469                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     6470                               + if    iCheckType eq "*"
     6471                                    or iCheckType eq ?
     6472                                 then       ""
     6473                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     6474      vHQry:query-open().
     6475      vHQry:get-first().
     6476      define variable vcode as character no-undo.
     6477      define variable vvalue as character no-undo.
     6478      QRY-BLOCK:
     6479      repeat while not vHQry:query-off-end:
     6480         vi = vi + 1.
     6481         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     6482         if vcode ne ?
     6483         then do:
     6484            find first tt-err where tt-err.code eq vcode
     6485            no-error.
     6486            if not available tt-err
     6487            then do:
     6488               create tt-err.
     6489               assign
     6490                  tt-err.code_ = vcode
     6491                  tt-err.text_ = vvalue
     6492               .
     6493            end.
     6494            else
     6495               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     6496         end.
     6497         vHQry:get-next().
     6498      end.
     6499     find first utd where utd.db-num eq idb-num
     6500                         and utd.doc-id eq idoc-id
     6501         no-lock.
     6502      define buffer cancel_utd-lines for utd-lines.
     6503      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     6504                                  and cancel_utd-lines.doc-id eq idoc-id
     6505      no-lock:
     6506         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     6507         then do:
     6508            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     6509                                        and utd-marking-lines.doc-id eq idoc-id
     6510                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     6511            no-lock,
     6512               first marking where marking.mark eq utd-marking-lines.mark
     6513                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     6514            no-lock:
     6515               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     6516               find first tt-err where tt-err.code eq vcode
     6517               no-error.
     6518               if not available tt-err
     6519               then do:
     6520                  create tt-err.
     6521                  assign
     6522                     tt-err.code_ = vcode
     6523                     tt-err.text_ = vvalue
     6524                  .
     6525               end.
     6526               else
     6527                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     6528            end.
     6529         end.
     6530         else do:
     6531            define variable vqnty as decimal no-undo.
     6532            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     6533            if vqnty eq ? then vqnty = 0.
     6534            if vqnty ne cancel_utd-lines.Quantity
     6535            then do:
     6536               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     6537               find first tt-err where tt-err.code eq vcode
     6538               no-error.
     6539               if not available tt-err
     6540               then do:
     6541                  create tt-err.
     6542                  assign
     6543                     tt-err.code_ = vcode
     6544                     tt-err.text_ = vvalue
     6545                  .
     6546               end.
     6547               else
     6548                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     6549            end.
     6550         end.
     6551      end.
     6552      for each tt-err:
     6553         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     6554      end.
     6555      return oError.
     6556   end.
     6557   define variable mFormatErr as character no-undo init "text".
     6558   function GetErrForUtd returns character
     6559   (idb-num         as integer ,
     6560    idoc-id         as integer ,
     6561    iType           as character
     6562    ):
     6563      if mFormatErr eq "text"
     6564      then
     6565         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     6566      else do:
     6567         if itype eq "return"
     6568         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     6569         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     6570      end.
     6571   end.
     6572   function GetErrComText returns longchar
     6573   (icomment as character,
     6574    itext    as longchar ):
     6575       define variable vText as longchar no-undo.
     6576      if mFormatErr eq "text"
     6577      then do:
     6578         if icomment ne ""
     6579         then
     6580            icomment = substitute("comment:|&1|",icomment).
     6581         vText = icomment + itext.
     6582      end.
     6583      else do:
     6584         icomment = if icomment begins  '"'
     6585                    then icomment
     6586                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     6587         vText = icomment + "," + itext.
     6588         vText = "~{" + trim(vText,",") + "~}".
     6589      end.
     6590      return vText.
     6591   end.
     6592   function CheckTypeForMarkLineType returns logical
     6593   (iObj            as handle,
     6594    iCheckType      as character,
     6595    iCodeErr        as character ,
     6596    iTypeErr        as character ):
     6597      define variable vRecKey-markLine as character no-undo.
     6598      define variable vGoodMark        as logical no-undo.
     6599      define variable vdb-num          as integer no-undo.
     6600      define variable vdoc-id          as integer no-undo.
     6601      define variable vlinenum         as integer no-undo.
     6602      define variable vErrorOne as character no-undo.
     6603      define buffer buf_utd-err for utd-err.
     6604      run gen-key-rec (input "utd-marking-lines",
     6605                       input  iObj,
     6606                       output vRecKey-markLine).
     6607      vGoodMark = yes.
     6608      vdb-num = iObj::db-num.
     6609      vdoc-id = iObj::doc-id.
     6610      vlinenum = iObj::linenum.
     6611      block-mark-err:
     6612      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     6613                               and buf_utd-err.db-num = vdb-num
     6614                               and buf_utd-err.reckey = vRecKey-markLine
     6615                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     6616                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     6617      no-lock:
     6618         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     6619         if     vErrorOne ne ?
     6620            and vErrorOne ne ""
     6621         then do:
     6622            vGoodMark = no.
     6623            leave block-mark-err.
     6624         end.
     6625      end.
     6626      return not vGoodMark.
     6627   end.
     6628   function CheckErrForMarkLineType returns logical
     6629   (iObj            as handle,
     6630    iType           as character  ):
     6631      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     6632   end.
     6633   function CheckErrForMarkLine returns logical
     6634   (iObj            as handle):
     6635      return CheckErrForMarkLineType(iObj,"*").
     6636   end.
     6637   function CheckErrForLineTypeCode returns logical
     6638   (iObj                 as handle,
     6639    iCheckType           as character,
     6640    iCodeErr             as character,
     6641    iTypeErr             as character,
     6642    iOneErr              as logical):
     6643      define variable vRecKey-line     as character no-undo.
     6644      define buffer buf_utd-err for utd-err.
     6645      define variable vUtdlineError as logical no-undo.
     6646      define variable vErrorOne as character no-undo.
     6647            run gen-key-rec (input "utd-lines",
     6648                             input  iObj,
     6649                             output vRecKey-line).
     6650         define variable vdb-num as integer no-undo.
     6651         define variable vdoc-id as integer no-undo.
     6652         define variable vlinenum as integer no-undo.
     6653         vdb-num = iObj::db-num.
     6654         vdoc-id = iObj::doc-id.
     6655         vlinenum = iObj::linenum.
     6656         block-err:
     6657         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     6658                                  and buf_utd-err.db-num = vdb-num
     6659                                  and buf_utd-err.reckey = vRecKey-line
     6660                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     6661                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     6662         no-lock:
     6663            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     6664            if     vErrorOne ne ?
     6665               and vErrorOne ne ""
     6666            then do:
     6667               vUtdlineError = yes.
     6668               leave block-err.
     6669            end.
     6670         end.
     6671         if  not vUtdlineError
     6672         then do:
     6673            define variable vGoodMark as logical no-undo.
     6674            vGoodMark = yes.
     6675            block-line-err:
     6676            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     6677                                         and utd-marking-lines.doc-id  eq vdoc-id
     6678                                         and utd-marking-lines.LineNum eq vLineNum
     6679            no-lock:
     6680               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     6681               if     vGoodMark
     6682                  and iOneErr eq no
     6683               then
     6684                  leave block-line-err.
     6685               if     iOneErr = yes
     6686                  and not vGoodMark
     6687               then
     6688                  leave block-line-err.
     6689            end.
     6690            vUtdlineError = not vGoodMark.
     6691         end.
     6692      return vUtdlineError.
     6693   end.
     6694   function getErrForLineType returns character
     6695   (iObj            as handle,
     6696    iType           as character  ):
     6697      define variable vRecKey-line     as character no-undo.
     6698      define buffer buf_utd-err for utd-err.
     6699      define variable vUtdlineError as logical no-undo.
     6700      define variable vErrorOne as character no-undo.
     6701      define variable oError as character no-undo.
     6702            run gen-key-rec (input "utd-lines",
     6703                             input  iObj,
     6704                             output vRecKey-line).
     6705         define variable vdb-num as integer no-undo.
     6706         define variable vdoc-id as integer no-undo.
     6707         define variable vlinenum as integer no-undo.
     6708         vdb-num = iObj::db-num.
     6709         vdoc-id = iObj::doc-id.
     6710         vlinenum = iObj::linenum.
     6711         block-err:
     6712         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     6713                                  and buf_utd-err.db-num = vdb-num
     6714                                  and buf_utd-err.reckey = vRecKey-line
     6715                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     6716         no-lock:
     6717            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     6718            if     vErrorOne ne ?
     6719               and vErrorOne ne ""
     6720            then do:
     6721               oError = oError + vErrorOne + " ".
     6722            end.
     6723         end.
     6724      return oError.
     6725   end.
     6726   function CheckErrForLineType returns logical
     6727   (iObj            as handle,
     6728    iType           as character  ):
     6729       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     6730   end.
     6731   function CheckErrForLine returns logical
     6732   (iObj            as handle):
     6733      return CheckErrForLineType(iobj,"*").
     6734   end.
     6735   function CheckErrForUtd returns logical
     6736   (idb-num         as integer ,
     6737    idoc-id         as integer ):
     6738      for each utd-lines where utd-lines.db-num eq idb-num
     6739                           and utd-lines.doc-id eq idoc-id
     6740      no-lock :
     6741         if not CheckErrForLine (buffer ub.utd-lines:handle)
     6742         then
     6743            return no.
     6744      end.
     6745      return yes.
     6746   end.
     6747   function CheckMarkUtd-28rel return logical
     6748    (input idb-num as integer,
     6749    input idoc-id as integer):
     6750    define buffer utd                   for utd.
     6751    define buffer utd-lines             for utd-lines.
     6752    define buffer utd-marking-lines     for utd-marking-lines.
     6753    define variable v-par-type as character no-undo.
     6754    define variable vgdsNoMark as logical no-undo.
     6755    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     6756      define variable v-par-val  as character no-undo.
     6757      find first utd where utd.db-num eq idb-num
     6758                       and utd.doc-id eq idoc-id
     6759      no-lock no-error.
     6760      if available utd
     6761      then do:
     6762         if     utd.obj-code ne ?
     6763            and utd.obj-type ne ?
     6764         then do:
     6765            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     6766            Block-utd-lines:
     6767            for each utd-lines where utd-lines.db-num eq idb-num
     6768                                 and utd-lines.doc-id eq idoc-id
     6769            no-lock:
     6770               if     utd-lines.gds-code ne ?
     6771                  and utd-lines.gds-code ne 0
     6772               then do:
     6773                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     6774                       ( utd-lines.gds-code,
     6775                         'mark-type':U,
     6776                          output v-par-val,
     6777                          output v-par-type
     6778                       ).
     6779                  if     EDOParSec:IsEdo
     6780                     and EDOParSec:GetIsEDOForType(v-par-val)
     6781                  then do:
     6782                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     6783                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     6784                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     6785                                                    and length(utd-marking-lines.mark) > 13
     6786                     no-lock no-error.
     6787                     if     avail utd-marking-lines
     6788                        and not CheckErrForLine(buffer utd-lines:handle)
     6789                     then
     6790                        leave Block-utd-lines.
     6791                  end.
     6792                  else
     6793                     vgdsNoMark = yes.
     6794               end.
     6795            end.
     6796            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     6797            if vgdsNoMark then return available utd-lines . else return yes .
     6798         end.
     6799      end.
     6800      return yes.
     6801   end.
     6802   function get-subject returns character
     6803     ( p-subject as character ) :
     6804     return p-subject.
     6805   end function.
     6806   procedure local-view-cange:
     6807      define output parameter oDescription as character no-undo.
     6808      if X_c-obj-hist.subject eq "order-doc"
     6809      then
     6810         run order-doc-proc in this-procedure no-error.
     6811      else if X_c-obj-hist.subject eq "order-doc-attr"
     6812      then
     6813         run order-doc-attr-proc in this-procedure no-error.
     6814      else if X_c-obj-hist.subject eq "order-line"
     6815      then
     6816         run order-line-proc in this-procedure no-error.
     6817      else if X_c-obj-hist.subject eq "order-line-attr"
     6818      then
     6819         run order-line-attr-proc in this-procedure no-error.
     6820      if error-status:error then
     6821        message return-value view-as alert-box.
     6822   end procedure.
     6823   function local-open-br returns logical
     6824   (  p-open-query     as logical    ,
     6825     p-find-next       as logical    ,
     6826     p-find-condition as character ):
     6827        define variable sort-column-phrase as character no-undo .
     6828        define variable l-query-was-opened as logical no-undo .
     6829      for each X_c-obj-hist :
     6830         delete X_c-obj-hist.
     6831      end.
     6832      if p-mode eq "one"
     6833      then do:
     6834         if p-chip-num eq ?
     6835         then do:
     6836            for each c-order-head where c-order-head.db-num   = p-db-num-order
     6837                                       and c-order-head.doc-code = p-doc-code-order
     6838                                       and c-order-head.corr-user-db-num = v-corr-user-db-num
     6839            no-lock:
     6840               create X_c-obj-hist.
     6841               buffer-copy c-order-head to X_c-obj-hist.
     6842               if c-order-head.subject <> "order-doc" and
     6843                  c-order-head.subject <> "*" then
     6844               do:
     6845                 run getRecordsByChipNum in this-procedure ((buffer X_c-obj-hist:handle), c-order-head.subject).
     6846               end.
     6847            end.
     6848         end.
     6849         else do:
     6850            for each c-order-head where
     6851                     c-order-head.db-num           = p-db-num-order
     6852                 and c-order-head.doc-code         = p-doc-code-order
     6853                 and c-order-head.corr-user-db-num = v-corr-user-db-num
     6854                 and c-order-head.chip-num         = p-chip-num
     6855                no-lock:
     6856              run getRecordsByChipNum in this-procedure (?, "order-doc").
     6857              run getRecordsByChipNum in this-procedure (?, "order-doc-attr").
     6858              run getRecordsByChipNum in this-procedure (?, "order-line").
     6859              run getRecordsByChipNum in this-procedure (?, "order-line-attr").
     6860            end.
     6861         end.
     6862      end.
     6863   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6864   define variable  l-disable-where-36  as logical   no-undo .
     6865   define variable  l-filter-open-36    as logical   .
     6866   define variable  flt-rec-36       as recid     no-undo .
     6867   define variable  filter-name-36      as character no-undo .
     6868   define variable  where-phrase-36     as character no-undo .
     6869   define variable  sort-phrase-36      as character no-undo .
     6870   define variable  where-phrase-rus-36 as character no-undo .
     6871   define variable  sort-phrase-rus-36  as character no-undo .
     6872     run waitfram-show in this-procedure
     6873       (input "ЖДИТЕ ..."
     6874       ).
     6875   run gbl/flt-get.p
     6876     (input filter-point
     6877     ,output flt-rec-36
     6878     ,output filter-name-36
     6879     ,output where-phrase-36
     6880     ,output sort-phrase-36
     6881     ,output where-phrase-rus-36
     6882     ,output sort-phrase-rus-36
     6883     ).
     6884   if p-open-query then do:
     6885       run set-filter-name in this-procedure
     6886         (INPUT filter-name-36
     6887         ) no-error .
     6888     assign
     6889       l-filter-open-36 = false
     6890     .
     6891     if flt-rec-36 <> ?
     6892       or sort-column-phrase > ""
     6893     then do:
     6894       define variable  parameter-2-36 as character no-undo .
     6895       define variable  parameter-3-36 as character no-undo .
     6896       define variable  parameter-4-36 as character no-undo .
     6897       define variable  parameter-5-36 as character no-undo .
     6898       define variable  parameter-6-36 as character no-undo .
     6899       define variable  parameter-7-36 as character no-undo .
     6900         assign
     6901         parameter-3-36 =
     6902                                 "FOR EACH X_c-obj-hist"
     6903         parameter-4-36 =
     6904           (
     6905             if (" TRUE " + " " + where-phrase-36) <> ""
     6906             then " TRUE " + " " + where-phrase-36
     6907             else "true"
     6908           )
     6909         parameter-5-36 = (" " + "" + " " + "")
     6910         parameter-6-36 = if sort-phrase-36 = ''
     6911                              then
     6912           (
     6913           " " + "" +
     6914             " " + sort-column-phrase +
     6915           " " + " by X_c-obj-hist.chip-num  "
     6916           )
     6917                              else
     6918           (
     6919           " " + "" +
     6920             " " + sort-column-phrase +
     6921           " " + sort-phrase-36
     6922           )
     6923         parameter-7-36 =
     6924           " indexed-reposition  "
     6925       .
     6926       do
     6927       on stop undo, leave
     6928       on error undo, leave
     6929       :
     6930         assign
     6931           l-disable-where-36 =
     6932             (" TRUE " + " " + where-phrase-36 = "")
     6933         .
     6934         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     6935                             ,input query br-obj-hist:handle
     6936                             ,input parameter-3-36
     6937                             ,input parameter-4-36
     6938                             ,input parameter-5-36
     6939                             ,input parameter-6-36
     6940                             ,input parameter-7-36
     6941                             )
     6942         .
     6943         assign
     6944           l-filter-open-36 = true
     6945         .
     6946       end.
     6947       if l-filter-open-36 = false then do:
     6948         message
     6949           "Ошибка при фильтрации / сортировке" skip
     6950           "Будут показаны записи без учета фильтра" skip
     6951           view-as alert-box .
     6952       end.
     6953       else do:
     6954           assign
     6955             l-query-was-opened = true
     6956           .
     6957       end.
     6958     end.
     6959     if l-filter-open-36 = false then do:
     6960       OPEN QUERY br-obj-hist FOR EACH X_c-obj-hist
     6961         where  TRUE
     6962          by X_c-obj-hist.chip-num
     6963         indexed-reposition
     6964     .
     6965         assign
     6966           l-query-was-opened = true
     6967         .
     6968     end.
     6969   end.
     6970   else do:
     6971     assign
     6972       v-doc-rec = recid( X_c-obj-hist )
     6973     .
     6974     do
     6975     on stop undo, leave
     6976     on error undo, leave
     6977     :
     6978       if query br-obj-hist:handle:get-buffer-handle(1) = (buffer X_c-obj-hist:handle) then do:
     6979         assign
     6980         parameter-2-36 = (if p-find-next then "true":u else "false":u )
     6981         parameter-4-36 =
     6982           "where ":u + " TRUE " + " ":u + where-phrase-36 + " ":u + p-find-condition + " " + ""
     6983         parameter-5-36 = ""
     6984       .
     6985         run fltopend_fltfindd in this-procedure  (
     6986                             input this-procedure:handle
     6987                             ,input query br-obj-hist:handle
     6988                             ,input rowid(X_c-obj-hist)
     6989                             ,input logical(parameter-2-36)
     6990                             ,input no-lock
