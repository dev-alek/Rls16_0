     3759     assign
     3760       l-filter-open-29 = false
     3761     .
     3762     if flt-rec-29 <> ?
     3763       or sort-column-phrase > ""
     3764     then do:
     3765       define variable  parameter-2-29 as character no-undo .
     3766       define variable  parameter-3-29 as character no-undo .
     3767       define variable  parameter-4-29 as character no-undo .
     3768       define variable  parameter-5-29 as character no-undo .
     3769       define variable  parameter-6-29 as character no-undo .
     3770       define variable  parameter-7-29 as character no-undo .
     3771         assign
     3772         parameter-3-29 =
     3773                                 "FOR EACH X_c-obj-hist"
     3774         parameter-4-29 =
     3775           (
     3776             if (" TRUE " + " " + where-phrase-29) <> ""
