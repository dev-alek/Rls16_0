      139   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      140   define variable c-point  as character no-undo .
      141   define variable tbl      as character no-undo .
      142   define variable join-tbl as character no-undo .
      143   define variable fld      as character no-undo .
      144   define variable lab      as character no-undo .
      145   define variable spr      as character no-undo .
      146   define variable dim      as character no-undo .
      147   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      148   procedure cur-time :
      149      define output parameter p-today as date      no-undo .
      150      define output parameter p-time  as integer   no-undo .
      151     do
      152     on error undo, return error
      153     :
      154       define variable v-date1 as date      no-undo .
      155       define variable v-date2 as date      no-undo .
      156       define variable v-time  as integer   no-undo .
      157       assign
      158         v-date1 = today
      159         v-time  = time
      160         v-date2 = today
      161       .
      162       if v-date1 <> v-date2
      163       then do:
      164         assign
      165           v-date1 = today
      166           v-time  = v-time
      167         .
      168       end.
      169       assign
      170         p-today = v-date1
      171         p-time  = v-time
      172       .
      173     end.
      174   end.
      175   function cur-time-date returns character
      176   :
      177     return string(today, '99/99/9999':U) .
      178   end.
      179   function cur-time-mjd returns decimal
      180   :
      181     define variable v-date as date      no-undo .
      182     define variable v-time as integer   no-undo .
      183     run cur-time in this-procedure
      184       (output v-date
      185       ,output v-time
      186       ) .
      187     return integer(v-date) - 2400002 + (v-time / 86400) .
      188   end.
      189   function cur-time-get-ending-index returns integer
      190   (input p-number as integer
      191   )
      192   :
      193     if p-number < 0
      194     or p-number = ?
      195     then do:
      196       return 1 .
      197     end.
      198     define variable v-rest as integer   no-undo .
      199     assign
      200       p-number = p-number modulo 100
      201     .
      202     if p-number < 20
      203     then do:
      204       assign
      205         v-rest = p-number
      206       .
      207     end.
      208     else do:
      209       assign
      210         v-rest = p-number modulo 10
      211       .
      212     end.
      213     case v-rest :
      214       when 1
      215       then do:
      216         return 2 .
      217       end.
      218       when 2 or
      219       when 3 or
      220       when 4
      221       then do:
      222         return 3 .
      223       end.
      224       otherwise do:
      225         return 1 .
      226       end.
      227     end case .
      228   end.
      229   procedure cur-time-mjd-to-date :
      230      define input  parameter i-mjd-diff as decimal no-undo.
      231      define output parameter o-Date     as date    no-undo.
      232      define output parameter o-Time     as integer no-undo.
      233      define variable v-day-number as integer   no-undo .
      234      if    i-mjd-diff < 0
      235         or i-mjd-diff = ?
      236      then do:
      237         return "?" .
      238      end.
      239      assign
      240         v-day-number = truncate(i-mjd-diff,0).
      241         o-Date = date(v-day-number + 2400002).
      242         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      243     .
      244   end.
      245   function cur-time-mjd-to-string returns character
      246   (input p-mjd-diff as decimal
      247   )
      248   :
      249     define variable v-day-number as integer   no-undo .
      250     define variable v-seconds    as integer   no-undo .
      251     define variable v-hour       as integer   no-undo .
      252     define variable v-min        as integer   no-undo .
      253     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      254     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      255     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      256     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      257     if p-mjd-diff < 0
      258     or p-mjd-diff = ?
      259     then do:
      260       return "?" .
      261     end.
      262     assign
      263       v-day-number = integer(truncate(p-mjd-diff,0))
      264       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      265     .
      266     if v-seconds > 86400
      267     then do:
      268       assign
      269         v-seconds = 86400 - 1
      270       .
      271     end.
      272     if v-seconds < 0
      273     then do:
      274       assign
      275         v-seconds = 0
      276       .
      277     end.
      278     assign
      279       v-hour = truncate(v-seconds / 3600, 0)
      280     .
      281     assign
      282       v-seconds = v-seconds modulo 3600
      283     .
      284     assign
      285       v-min = truncate(v-seconds / 60, 0)
      286     .
      287     assign
      288       v-seconds = v-seconds modulo 60
      289     .
      290     return
      291         (if v-day-number <> 0
      292           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      293           else ""
      294         )
      295       + (if v-day-number <> 0 or v-hour <> 0
      296           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      297           else ""
      298         )
      299       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      300           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      301           else ""
      302         )
      303       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      304       .
      305   end.
      306   function cur-time-string returns character
      307   :
      308     define variable v-date as date      no-undo .
      309     define variable v-time as integer   no-undo .
      310     run cur-time in this-procedure
      311       (output v-date
      312       ,output v-time
      313       ) .
      314     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      315   end.
      316   function cur-time-string-sec returns character
      317   :
      318     define variable v-date as date      no-undo .
      319     define variable v-time as integer   no-undo .
      320     run cur-time in this-procedure
      321       (output v-date
      322       ,output v-time
      323       ) .
      324     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      325   end.
      326   function cur-time-custom  returns character
      327   (input p-prefix as character
      328   ,input p-date-format as character
      329   ,input p-delimiter as character
      330   ,input p-time-format as character
      331   ,input p-suffix as character
      332   )
      333   :
      334     define variable v-date as date      no-undo .
      335     define variable v-time as integer   no-undo .
      336     run cur-time in this-procedure
      337       (output v-date
      338       ,output v-time
      339       ) .
      340     return
      341       p-prefix
      342       + string(v-date, p-date-format)
      343       + p-delimiter
      344       + string(v-time, p-time-format)
      345       + p-suffix
      346       .
      347   end.
      348   function cur-time-print  returns character
      349   :
      350     define variable v-date as date      no-undo .
      351     define variable v-time as integer   no-undo .
      352     run cur-time in this-procedure
      353       (output v-date
      354       ,output v-time
      355       ) .
      356     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      357   end.
      358   function cur-time-datetime returns datetime
      359   :
      360     define variable v-char as character no-undo .
      361     define variable v-datetime as datetime no-undo .
      362     v-char = cur-time-string().
      363     v-datetime = datetime(v-char).
      364     return  v-datetime.
      365   end.
      366   function cur-time-string-msec returns character
      367   :
      368     define variable v-date as datetime  no-undo .
      369     v-date = now.
      370     return string(v-date) .
      371   end.
      372   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      373   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      374   define new shared variable RepPathName        as character no-undo .
      375   define new shared variable PrintRubl          as logical   no-undo .
      376   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      377   define variable v-waitfram-action01         as character   no-undo .
      378   define variable v-waitfram-action02         as character   no-undo .
      379   define variable v-waitfram-action03         as character   no-undo .
      380   define variable mWaitFramTextBeg            as character   no-undo.
      381   define variable mWaitFramTextEnd            as character   no-undo.
      382   define variable mWaitFramView               as logical     no-undo.
      383   define variable mWaitProcEvent              as logical     no-undo init yes.
      384   define variable mWaitFramInterval           as integer     no-undo init 1 .
      385   define variable mWaitFramStop               as logical     no-undo.
      386   define variable mWaitFramStopUser           as logical     no-undo.
      387   define variable mWaitFramStopTimeOut        as logical     no-undo.
      388   define variable mWaitFramStartProc          as datetime-tz no-undo.
      389   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      390   define button B-WaitFramStop auto-end-key
      391        label "Стоп"
      392        size 10 by 1 tooltip "Остоновить процесс".
      393   define button B-viewProcInfo
      394        label "Информация"
      395        size 15 by 1 tooltip "Информация о процесс".
      396   define frame waitfram
      397     v-waitfram-action01 format "x(72)" no-label skip
      398     v-waitfram-action02 format "x(72)" no-label skip
      399     v-waitfram-action03 format "x(72)" no-label skip
      400     B-viewProcInfo
      401     B-WaitFramStop at row 4 col 30
      402     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      403     .
      404   define new global shared variable mBatchMode as logical no-undo init ?.
      405   define variable mFramBachModHandle as handle no-undo.
      406   mFramBachModHandle = frame waitfram:handle.
      407   define variable mFameOldVis as logical no-undo.
      408   define variable mVisCUrentVin as logical no-undo.
      409   if session:batch-mode
      410   then
      411      mBatchMode = yes.
      412   if mBatchMode = ? then do:
      413     mVisCUrentVin = current-window:visible.
      414     mFameOldVis = mFramBachModHandle:visible.
      415     mFramBachModHandle:visible  = yes.
      416     mBatchMode = mFramBachModHandle:visible ne yes.
      417     mFramBachModHandle:visible = mFameOldVis.
      418     current-window:visible = mVisCUrentVin.
      419   end.
      420    if  log-manager:logfile-name ne ?
      421     then DO:
      422         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      423         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      424         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      425     end.
      426   on choose of B-WaitFramStop in frame waitfram
      427   do:
      428     mWaitFramStop = yes.
      429     mWaitFramStopUser = yes.
      430   end.
      431   function waitfram-check-timeout returns logical():
      432      define variable vtime as int64 no-undo.
      433      if mWaitFramStopTimeOut
      434      then
      435         return yes.
      436      vtime = ( now - mWaitFramStartProc ) / 1000 .
      437      if     mWaitFramTimeOut ne ?
      438         and mWaitFramTimeOut ne 0
      439         and mWaitFramTimeOut lt vtime
      440      then do:
      441         mWaitFramStopTimeOut = yes.
      442      end.
      443      return mWaitFramStopTimeOut.
      444   end.
      445   procedure waitfram-hide :
      446     if not session:batch-mode
      447     then do
      448     on error undo, return error return-value
      449     :
      450       pause 0 before-hide .
      451       if not mBatchMode then
      452         hide frame waitfram .
      453     end.
      454   end procedure.
      455   procedure waitfram-show :
      456     define input  parameter p-message as character no-undo .
      457     define variable v-left-margin as integer   no-undo .
      458     if not session:batch-mode
      459     then do
      460     on error undo, return error return-value
      461     :
      462       if length(p-message) <= 70 then do:
      463         assign
      464           v-left-margin = integer((70 - length(p-message)) / 2)
      465         .
      466         assign
      467           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      468         .
      469         assign
      470           v-waitfram-action01 = " "
      471           v-waitfram-action02 = " "
      472                                    + fill(" ", v-left-margin)
      473                                    + p-message
      474           v-waitfram-action03 = " "
      475         .
      476       end.
      477       else do:
      478         define variable vRindex1 as integer no-undo.
      479         define variable vRindex2 as integer no-undo.
      480         vRindex1 = r-index(p-message," ",70).
      481         if vRindex1 = 0
      482         then
      483            vRindex1 = 70.
      484         if length(p-message)  <= vRindex1 + 70 then do:
      485           assign
      486             v-waitfram-action01 = " "
      487             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      488             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      489           .
      490         end.
      491         else do:
      492           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      493           if vRindex2 <= vRindex1
      494           then
      495              vRindex2 = vRindex1 + 70.
      496           assign
      497             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      498             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      499             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      500           .
      501         end.
      502       end.
      503       B-viewProcInfo:visible   in frame waitfram = no.
      504       B-viewProcInfo:sensitive in frame waitfram = no.
      505       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      506       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      507       if  (   mWaitFramView
      508          or  mWaitProcEvent)
      509          and not mBatchMode
      510       then
      511          display
      512             v-waitfram-action01 skip
      513             v-waitfram-action02 skip
      514             v-waitfram-action03 skip
      515          with frame waitfram .
      516     end.
      517   end procedure.
      518      procedure waitfram-show-this:
      519         define input  parameter iInterval as int64 no-undo.
      520         define variable vtime as int64 no-undo.
      521         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      522         mWaitFramInterval = iInterval.
      523         run waitfram-show (substitute("&1&2 &3&4" ,
      524                                       mWaitFramTextBeg ,
      525                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      526                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      527                                       mWaitFramTextEnd
      528                                      )
      529                           ).
      530      end.
      531      procedure WaitFramRunPause:
      532         define input  parameter iInterval as dec no-undo.
      533         define variable vStart  as datetime-tz no-undo.
      534         define variable vend    as datetime-tz no-undo.
      535         define variable vint as int64 no-undo.
      536         define variable vOk as logical no-undo.
      537         vStart = now.
      538         vend   = vStart.
      539         publish "WaitFramPause" (iInterval,output vOk).
      540         vend   =  now.
      541         vint = vend - vStart.
      542         vint = iInterval - vint / 1000.
      543         if     not mWaitFramStop
      544            and (   vint > 0
      545                 or (    not vOk
      546                     and iInterval eq ?
      547                     )
      548                 )
      549         then
      550            run waitfram-show-this (iInterval).
      551         vend   =  now.
      552         vint = vend - vStart.
      553         vint = iInterval - vint / 1000.
      554         if     not mWaitFramStop
      555            and vint > 0
      556         then do:
      557            run gbl/pause.p (vint * 1000).
      558         end.
      559         if iInterval ne ?
      560         then
      561            publish "WaitFramStop".
      562         waitfram-check-timeout().
      563      end.
      564      procedure WaitFramWaitFor:
      565         define input  parameter iInterval as dec no-undo.
      566         assign
      567            mWaitFramStartProc   = now
      568            mWaitFramStopUser    = no
      569            mWaitFramStopTimeOut = no
      570         .
      571         block-wait:
      572         do while not mWaitFramStop:
      573            run WaitFramRunPause (iInterval).
      574            if  waitfram-check-timeout()
      575            then do:
      576               leave block-wait.
      577            end.
      578         end.
      579         run waitfram-hide.
      580      end.
      581   procedure waitfram-join :
      582     define input  parameter p-line-1  as character no-undo .
      583     define input  parameter p-line-2  as character no-undo .
      584     define input  parameter p-line-3  as character no-undo .
      585     define output parameter p-message as character no-undo .
      586     do
      587     on error undo, return error return-value
      588     :
      589       assign
      590         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      591                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      592                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      593       .
      594     end.
      595   end procedure.
      596   function waitfram-join-function returns character
      597     (input p-line-1 as character
      598     ,input p-line-2 as character
      599     ,input p-line-3 as character
      600     ).
      601     define variable v-message as character no-undo .
      602     run waitfram-join in this-procedure
      603       (input  p-line-1
      604       ,input  p-line-2
      605       ,input  p-line-3
      606       ,output v-message
      607       ) .
      608     return v-message .
      609   end function .
