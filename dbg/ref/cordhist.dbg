     2796   procedure diasize_init :
     2797     define variable v-default-value    as logical   no-undo .
     2798     define variable v-restore-saved    as logical   no-undo .
     2799     define variable v-resize-value-str as character no-undo .
     2800     do
     2801     on error undo, return error return-value
     2802     :
     2803       do with frame Dialog-Frame
     2804       :
     2805         assign
     2806           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2807           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2808           v-diasize-browse-handle     = browse br-obj-hist :handle
     2809         .
     2810         create button v-diasize-resize-button
     2811         assign
     2812           parent        = frame Dialog-Frame :first-child
     2813           label         = "s"
     2814           height-pixels = 16
     2815           width-pixels  = 16
     2816           visible       = true
     2817           sensitive     = true
     2818           movable       = true
     2819           triggers:
     2820             on end-move persistent run diasize_end-move in this-procedure .
     2821           end triggers.
     2822         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2823         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2824         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2825         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2826         assign
     2827           v-diasize-wndmax = false
     2828         .
     2829         if connected("ub") = true
     2830         then do:
     2831           define variable v-cntxt-db-num        as integer   no-undo .
     2832           define variable v-cntxt-userid        as character no-undo .
     2833           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2834                                             , OUTPUT v-cntxt-userid
     2835                                             ) .
     2836           run gbl/wndpar_r.p
     2837             (input  v-cntxt-db-num
     2838             ,input  v-cntxt-userid
     2839             ,input  'wndmax':U
     2840             ,output v-diasize-wndmax
     2841             ,output v-default-value
     2842             ) .
     2843         end.
     2844         assign
     2845           v-diasize-wndstore = false
     2846         .
     2847         if connected("ub") = true
     2848         then do:
     2849           run gbl/wndpar_r.p
     2850             (input  v-cntxt-db-num
     2851             ,input  v-cntxt-userid
     2852             ,input  'wndstore':U
     2853             ,output v-diasize-wndstore
     2854             ,output v-default-value
     2855             ) .
     2856         end.
     2857         assign
     2858           v-diasize-proc-name = entry(1, program-name(2), '.')
     2859         .
     2860         if v-diasize-wndstore = true
     2861         then do:
     2862           assign
     2863             v-restore-saved = false
     2864           .
     2865           if connected("ub") = true
     2866           then do:
     2867             run gbl/wndsizer.p
     2868               (input  v-cntxt-db-num
     2869               ,input  v-cntxt-userid
     2870               ,input  v-diasize-proc-name
     2871               ,input  'height':u
     2872               ,output v-resize-value-str
     2873               ) .
     2874             if v-resize-value-str <> '':U
     2875             then do:
     2876               run diasize_change-height in this-procedure
     2877                 (input  integer(v-resize-value-str)
     2878                 ,input  true
     2879                 ) .
     2880               assign
     2881                 v-restore-saved = true
     2882               .
     2883             end.
     2884           end.
     2885           if connected("ub") = true
     2886           then do:
     2887             run gbl/wndsizer.p
     2888               (input  v-cntxt-db-num
     2889               ,input  v-cntxt-userid
     2890               ,input  v-diasize-proc-name
     2891               ,input  'width':u
     2892               ,output v-resize-value-str
     2893               ) .
     2894             if v-resize-value-str <> '':U
     2895             then do:
     2896               run diasize_change-width in this-procedure
     2897                 (input  integer(v-resize-value-str)
     2898                 ,input  true
     2899                 ) .
     2900               assign
     2901                 v-restore-saved = true
     2902               .
     2903             end.
     2904           end.
     2905           if v-restore-saved <> true
     2906           then do:
     2907             if v-diasize-wndmax = true
     2908             then do:
     2909               run diasize_maximize in this-procedure
     2910                 (input  true
     2911                 ) .
     2912             end.
     2913           end.
     2914         end.
     2915         else do:
     2916           if v-diasize-wndmax = true
     2917           then do:
     2918             run diasize_maximize in this-procedure
     2919               (input  true
     2920               ) .
     2921           end.
     2922         end.
     2923       end.
     2924     end.
     2925   end procedure.
     2926   procedure diasize_need-full-display :
     2927     define output parameter p-need-full-display as logical   no-undo .
     2928     do
     2929     on error undo, return error return-value
     2930     :
     2931       assign
     2932         p-need-full-display = v-diasize-need-full-display
