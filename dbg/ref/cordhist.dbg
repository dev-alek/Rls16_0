     7050   end.
     7051   procedure getRecordsByChipNum:
     7052     define input parameter iXObjHist as handle no-undo.
     7053     define input parameter iTable as character no-undo.
     7054     define variable vXObjHist   as handle    no-undo.
     7055     define variable vHistTable  as character no-undo.
     7056     define variable vQuery      as handle    no-undo.
     7057     define variable vEachWhere  as character no-undo .
     7058     define variable vBufSubj    as handle    no-undo.
     7059     vHistTable = substitute("c-&1",iTable).
     7060     CREATE BUFFER vBufSubj FOR TABLE vHistTable.
     7061     vEachWhere  = substitute(
     7062       "for each &1 where &1.db-num = &2 and &1.doc-code = &3 and &1.corr-user-db-num = &4 and &1.chip-num = &5"
     7063       ,vHistTable
     7064       ,c-order-head.db-num
     7065       ,c-order-head.doc-code
     7066       ,c-order-head.corr-user-db-num
     7067       ,c-order-head.chip-num)
     7068     .
     7069     create query vQuery.
     7070     vQuery:set-buffers(vBufSubj).
     7071     vQuery:query-prepare(vEachWhere).
     7072     vQuery:query-open.
     7073     vQuery:get-first(no-lock).
     7074     do while not vQuery:query-off-end:
     7075       if iXObjHist = ? then do:
     7076         create buffer vXObjHist for table "X_c-obj-hist".
     7077         vXObjHist:buffer-copy(buffer c-order-head:handle).
     7078       end.
     7079       else vXObjHist = iXObjHist.
     7080       vXObjHist:buffer-copy(vQuery:get-buffer-handle()).
     7081       vXObjHist:buffer-field("subject"):buffer-value = iTable.
     7082       vQuery:get-next(no-lock).
     7083     end.
     7084     vQuery:QUERY-CLOSE().
     7085     DELETE OBJECT vQuery.
     7086   end procedure.
     7087   procedure order-doc-proc :
     7088     define variable vIndexLabel     as integer no-undo.
     7089     define variable vIndexMethod    as integer no-undo.
     7090     define variable vListNameFields as character no-undo.
     7091     define variable vListLabelParam as character no-undo.
     7092     define buffer buf_c-order-doc for ub.c-order-doc .
     7093     define buffer b_File         for ub._File.
     7094     define buffer b_Field        for ub._Field.
     7095     do
     7096     on error undo, return error return-value
     7097     :
     7098       find first buf_c-order-doc no-lock where
     7099                  buf_c-order-doc.corr-user-db-num = X_c-obj-hist.corr-user-db-num
     7100              and buf_c-order-doc.chip-num         = X_c-obj-hist.chip-num no-error.
     7101       if not avail buf_c-order-doc then
     7102       do:
     7103         return error  "Неверная ссылка на c-order-doc в таблице c-order-head" .
     7104       end.
     7105       for first b_File no-lock where
     7106                 b_File._File-name = 'order-doc',
     7107           each b_Field no-lock where
     7108                b_Field._File-recid = recid(b_file):
     7109         if can-do('"', b_Field._Field-name) then next.
     7110         vListNameFields = substitute("&1&2&3",vListNameFields, if vListNameFields = "" then "" else ",", b_Field._Field-name).
     7111         vIndexLabel = lookup(b_Field._Field-name, '"').
     7112         vIndexMethod = lookup(b_Field._Field-name, 'sts,getStsOrder').
     7113         vListLabelParam = substitute("&1&2&3&6&4&6&5",
     7114                           vListLabelParam,
     7115                           if vListLabelParam = "" then "" else chr(8),
     7116                           b_Field._Field-name,
     7117                           if vIndexLabel > 0 then entry(vIndexLabel + 1,'"') else b_Field._Label,
     7118                           if vIndexMethod > 0 then entry(vIndexMethod + 1,'sts,getStsOrder') else "",
     7119                           chr(4)).
     7120       end.
     7121       run proc-full-temp-changes in this-procedure
     7122         (input buf_c-order-doc.action = integer('1':U)
     7123         ,input buf_c-order-doc.action = integer('99':U)
     7124         ,input buffer buf_c-order-doc:handle
     7125         ,input "order-doc"
     7126         ,input vListNameFields
     7127         ,input vListLabelParam).
     7128     end.
     7129   end procedure.
