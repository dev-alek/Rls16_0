      875   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      876   procedure fltopend_fltopend :
      877   define input parameter p-parent-handle as handle no-undo .
      878   define input parameter p-qh as handle no-undo .
      879   define input parameter p-flt-open-open-query  as character no-undo .
      880   define input parameter p-where-cond as character no-undo .
      881   define input parameter p-use-indFIRST-query-tail as character no-undo .
      882   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      883   define input parameter p-indexed-reposition as character no-undo .
      884     do
      885     on error undo, return error
      886     :
      887   define variable v-prepare-string as character no-undo .
      888   define variable glog as logical no-undo .
      889   assign
      890   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      891                      p-where-cond + chr(32)  +
      892                      p-use-indFIRST-query-tail + chr(32) +
      893                      p-use-ind-sort-clmn-by + chr(32) +
      894                      p-indexed-reposition
      895   .
      896   assign
      897   glog = p-qh:query-prepare(v-prepare-string) no-error .
      898   if not glog
      899   or error-status:error then do:
      900     message error-status:get-message(1) view-as alert-box .
      901     undo, return error .
      902   end.
      903   assign
      904   glog = p-qh:query-open no-error .
      905   if not glog
      906   or error-status:error then do:
      907     message error-status:get-message(1) view-as alert-box .
      908     undo, return error .
      909   end.
      910     end.
      911   end procedure.
      912   procedure fltopend_fltfindd :
      913   define input parameter p-parent-handle as handle no-undo .
      914   define input parameter p-qh as handle no-undo .
      915   define input parameter p-rowid as rowid no-undo .
      916   define input parameter p-next as logical no-undo .
      917   define input parameter p-lock as integer no-undo .
      918   define input parameter p-bh as handle no-undo .
      919   define input parameter p-where-cond as character no-undo .
      920   define input parameter p-use-index-phrase as character no-undo .
      921   define variable glog as logical no-undo .
      922   define variable v-qh as handle no-undo .
      923   define variable v-bh as handle no-undo .
      924   define variable v-recid as recid no-undo .
      925   define variable v-prepare-string as character no-undo .
      926   do
      927   on error undo, return error
      928   on stop undo, return error
      929   :
      930     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      931     create buffer v-bh for table p-bh buffer-name p-bh:name.
      932     create query v-qh.
      933     v-qh:set-buffers(v-bh).
      934     v-prepare-string = substitute("for each &1 &2 &3"
      935                                     ,v-bh:name
      936                                     ,p-where-cond
      937                                     ,p-use-index-phrase).
      938     glog = v-qh:query-prepare(v-prepare-string) no-error.
      939     if not glog then do:
      940       delete object v-qh.
      941       delete object v-bh.
      942       undo, return error .
      943     end.
      944     glog = v-qh:query-open no-error .
      945     if not glog then do:
      946       delete object v-qh.
      947       delete object v-bh.
      948       undo, return error .
      949     end.
      950     if p-next then do:
      951       v-qh:reposition-to-rowid(p-rowid) no-error .
      952       glog = v-qh:get-next( p-lock) no-error .
      953       glog = v-qh:get-next( p-lock) no-error .
      954       if not glog or v-qh:query-off-end = yes then do:
      955         glog = v-qh:get-first( p-lock) no-error .
      956       end.
      957     end.
      958     else do:
      959       glog = v-qh:get-first( p-lock) no-error .
      960     end.
      961     v-recid = v-bh:recid no-error .
      962     delete object v-qh.
      963     delete object v-bh.
      964     return string(v-recid) .
      965   end.
      966   end procedure.
      967   procedure fltopend_fltfindq :
      968   define input parameter p-parent-handle as handle no-undo .
      969   define input parameter p-qh as handle no-undo .
      970   define input parameter p-next as logical no-undo .
      971   define input parameter p-lock as integer no-undo .
      972   define input parameter p-flt-open-open-query  as character no-undo .
      973   define input parameter p-where-cond as character no-undo .
      974   define input parameter p-use-indFIRST-query-tail as character no-undo .
      975   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      976   define input parameter p-indexed-reposition as character no-undo .
      977   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      978   define variable glog as logical no-undo .
      979   define variable v-qh as handle no-undo .
      980   define variable v-bh as handle no-undo extent 18.
      981   define variable v-rowid as rowid no-undo extent 18.
      982   define variable v-ii as integer no-undo .
      983   define variable v-prepare-string as character no-undo .
      984   do
      985   on error undo, return error
      986   on stop undo, return error
      987   :
      988     create query v-qh.
      989     do v-ii = 1 to p-qh:num-buffers:
      990       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      991       assign
      992       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      993       no-error.
      994       v-qh:add-buffer(v-bh[v-ii]).
      995     end.
      996     assign
      997     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      998                       p-where-cond + chr(32)  +
      999                       p-use-indFIRST-query-tail + chr(32) +
     1000                       p-use-ind-sort-clmn-by + chr(32) +
     1001                       p-indexed-reposition
     1002     .
     1003     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1004     if not glog then do:
     1005       delete object v-qh.
     1006       do v-ii = 1 to p-qh:num-buffers:
     1007         delete object v-bh[v-ii].
     1008       end.
     1009       undo, return error .
     1010     end.
     1011     glog = v-qh:query-open no-error .
     1012     if not glog then do:
     1013       delete object v-qh.
     1014       do v-ii = 1 to p-qh:num-buffers:
     1015         delete object v-bh[v-ii].
     1016       end.
     1017       undo, return error .
     1018     end.
     1019     if p-next then do:
     1020       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1021       glog = v-qh:get-next( p-lock) no-error .
     1022       glog = v-qh:get-next( p-lock) no-error .
     1023       if not glog or v-qh:query-off-end = yes then do:
     1024         glog = v-qh:get-first( p-lock) no-error .
     1025       end.
     1026     end.
     1027     else do:
     1028       glog = v-qh:get-first( p-lock) no-error .
     1029     end.
     1030     do v-ii = 1 to p-qh:num-buffers:
     1031       assign
     1032       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1033       no-error.
     1034     end.
     1035     delete object v-qh.
     1036     do v-ii = 1 to p-qh:num-buffers:
     1037       delete object v-bh[v-ii].
     1038     end.
     1039   end.
     1040   end procedure.
