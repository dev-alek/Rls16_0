     1681   ON RETURN OF v-corr-user-db-num IN FRAME Dialog-Frame
     1682   DO:
     1683     assign
     1684     v-corr-user-db-num
     1685     .
     1686     RUn OpenBR(yes, no, '':U, v-corr-user-db-num).
     1687   END.
     1688   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1689   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1690   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1691   on help of frame Dialog-Frame
     1692   do:
     1693     run gbl/app_help.p
     1694       (input this-procedure :file-name
     1695       ,input ''
     1696       ,input ?
     1697       ) no-error.
     1698     if error-status :error then do:
     1699       message
     1700         "Ошибка при вызове помощи"
     1701         error-status :get-message(1)
     1702         view-as alert-box .
     1703     end.
     1704   end.
     1705   run minbtn-set in this-procedure .
     1706   on choose of b-help in frame Dialog-Frame
     1707   do:
     1708     apply "help":u to frame Dialog-Frame .
     1709   end.
     1710   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1711   procedure minbtn-set :
     1712       do
     1713           on error undo, return error return-value
     1714           :
     1715           define variable ii              as integer       no-undo .
     1716           define variable fh              as widget-handle no-undo .
     1717           define variable hh              as widget-handle no-undo .
     1718           define variable v-h             as handle        extent 4 no-undo .
     1719           define variable v-name-button   as character     no-undo .
     1720           define variable v-help-old-x    as decimal       no-undo .
     1721           define variable v-help-old-y    as decimal       no-undo .
     1722           define variable v-help-old-size as decimal       no-undo .
     1723           define variable v-frame-width   as decimal       no-undo .
     1724           define variable jj              as integer       no-undo .
     1725           do
     1726               on error undo, return error
     1727               :
     1728               assign
     1729                   v-frame-width = frame Dialog-Frame:width - 0.3
     1730                   fh            = frame Dialog-Frame:first-child
     1731                   hh            = fh:first-child
     1732                   ii            = 1
     1733                   .
     1734               do while valid-handle(hh):
     1735                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1736                   do:
     1737                       case lc(hh:name) :
     1738                           when "b-help" then
     1739                               do:
     1740                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1741                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1742                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1743                                   hh:TOOLTIP = "Помощь" .
     1744                                   v-help-old-x = hh:column .
     1745                                   v-help-old-y = hh:row    .
     1746                                   v-help-old-size = hh:width .
     1747                                   hh:width-chars = 2.5 .
     1748                               end.
     1749                           when "b-print" then
     1750                               do:
     1751                                   hh:load-image("cmp/b-print.bmp":u) .
     1752                                   hh:TOOLTIP = "Печать" .
     1753                                   v-h[ii] = hh:handle .
     1754                                   ii = ii + 1 .
     1755                                   hh:width-chars = 3 .
     1756                               end.
     1757                           when "b-history" or
     1758                           when "b-hist" then
     1759                               do:
     1760                                   hh:load-image("cmp/b-hist.bmp":u) .
     1761                                   hh:TOOLTIP = "История" .
     1762                                   v-h[ii] = hh:handle .
     1763                                   ii = ii + 1 .
     1764                                   hh:width-chars = 3 .
     1765                               end.
     1766                           when "b-sch" then
     1767                               do:
     1768                                   hh:load-image("cmp/b-sch.bmp":u) .
     1769                                   hh:TOOLTIP = "Установка Фильтра" .
     1770                                   v-h[ii] = hh:handle .
     1771                                   ii = ii + 1 .
     1772                                   hh:width-chars = 3 .
     1773                               end.
     1774                           when "b-hist-user" then
     1775                               do:
     1776                                   hh:load-image("cmp/b-hist.bmp":u) .
     1777                                   hh:TOOLTIP = "История пользователя" .
     1778                                   ii = ii + 1 .
     1779                               end.
     1780                       end case.
     1781                   end.
     1782                   hh = hh:next-sibling.
     1783               end.
     1784               b-help:column = v-frame-width - b-help:width-chars.
     1785               jj = 0.
     1786               repeat ii = 4 to 1 by -1 :
     1787                   if valid-handle (v-h[ii] ) then
     1788                   do:
     1789                       jj  = jj + 1 .
     1790                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1791                       v-h[ii]:row    = v-help-old-y .
     1792                   end.
     1793               end.
     1794           end.
     1795       end.
     1796   end procedure.
     1797   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1798   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1799   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1800   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1801   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1802   define variable v-diasize-current-frame-height as decimal   no-undo .
     1803   define variable v-diasize-change-size          as logical   no-undo .
     1804   define variable v-diasize-resize-button        as handle    no-undo .
     1805   define variable v-diasize-wndmax               as logical   no-undo .
     1806   define variable v-diasize-wndstore             as logical   no-undo .
     1807   define variable v-diasize-proc-name            as character no-undo .
     1808   define variable v-diasize-browse-handle        as handle    no-undo .
     1809   define variable v-diasize-browse-number        as integer   no-undo .
     1810   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1811   define temp-table temp-diasize-handle no-undo
     1812     field handle-value  as handle
     1813     field save-position as decimal
     1814     index xpk is primary unique handle-value
     1815     .
     1816   define temp-table temp-browse-handle no-undo
     1817     field browse-type   as character
     1818     field browse-number as integer
     1819     field browse-handle as handle
     1820     field original-size as decimal
     1821     index xpk is primary unique browse-type browse-number
     1822     index xie browse-type browse-handle
     1823   .
     1824   procedure diasize_change-height :
     1825     define input  parameter p-change-value  as decimal   no-undo .
     1826     define input  parameter p-move-resize   as logical   no-undo .
     1827     define variable v-field-group-handle    as handle    no-undo .
     1828     define variable v-object-handle         as handle    no-undo .
     1829     define variable v-frame-height          as decimal   no-undo .
     1830     define variable v-frame-virtual-height  as decimal   no-undo .
     1831     define variable v-browse-height         as decimal   no-undo .
     1832     define variable v-window-height         as decimal   no-undo .
     1833     define variable v-window-virtual-height as decimal   no-undo .
     1834     define variable v-change-sign           as integer   no-undo .
     1835     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1836     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1837     if p-change-value > 0
     1838     then do:
     1839       if frame Dialog-Frame :height + p-change-value
     1840           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1841       then do:
     1842         assign
     1843           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1844                           - (frame Dialog-Frame :height-chars)
     1845         .
     1846         if p-change-value <= 0
     1847         then do:
     1848           run diasize_position-resize-button in this-procedure .
     1849           return .
     1850         end.
     1851       end.
     1852     end.
     1853     if p-change-value < 0
     1854     then do:
     1855       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1856       then do:
     1857         assign
     1858           p-change-value = v-diasize-orig-frame-height
     1859                          - (frame Dialog-Frame :height-chars)
     1860         .
     1861         if p-change-value >= 0
     1862         then do:
     1863           run diasize_position-resize-button in this-procedure .
     1864           return .
     1865         end.
     1866       end.
     1867     end.
     1868     if p-change-value >= 0
     1869     then do:
     1870       assign
     1871         v-change-sign = 1
     1872       .
     1873     end.
     1874     else do:
     1875       assign
     1876         v-change-sign = -1
     1877       .
     1878     end.
     1879     assign
     1880       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1881     .
     1882     if p-change-value = 0
     1883     then do:
     1884       run diasize_position-resize-button in this-procedure .
     1885       return .
     1886     end.
     1887     move_block:
     1888     do
     1889     on error undo move_block, retry move_block
     1890     :
     1891       if retry
     1892       then do:
     1893         do
     1894         on error undo move_block, leave move_block
     1895         :
     1896           if p-change-value > 0
     1897           then do:
     1898             for each buf_temp-diasize-handle
     1899             on error undo, next
     1900             :
     1901               assign
     1902                 v-object-handle = buf_temp-diasize-handle.handle-value
     1903               .
     1904               if v-object-handle <> v-diasize-resize-button
     1905               then do:
     1906                 assign
     1907                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1908                 .
     1909               end.
     1910             end.
     1911             assign
     1912               v-diasize-browse-handle :height = v-browse-height
     1913             .
     1914             for each buf_temp-browse-handle
     1915               where buf_temp-browse-handle.browse-type = 'height':u
     1916             on error undo, next
     1917             :
     1918               assign
     1919                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1920               .
     1921             end.
     1922             assign
     1923               frame Dialog-Frame :height = v-frame-height
     1924             .
     1925             if frame Dialog-Frame :scrollable = true
     1926             then do:
     1927               assign
     1928                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1929               .
     1930             end.
     1931             run diasize_position-resize-button in this-procedure .
     1932           end.
     1933           else do:
     1934             if frame Dialog-Frame :scrollable = true
     1935             then do:
     1936               assign
     1937                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1938               .
     1939             end.
     1940             assign
     1941               frame Dialog-Frame :height = v-frame-height
     1942             .
     1943             assign
     1944               v-diasize-browse-handle :height = v-browse-height
     1945             .
     1946             for each buf_temp-browse-handle
     1947               where buf_temp-browse-handle.browse-type = 'height':u
     1948             on error undo, next
     1949             :
     1950               assign
     1951                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1952               .
     1953             end.
     1954             for each buf_temp-diasize-handle
     1955             on error undo, next
     1956             :
     1957               assign
     1958                 v-object-handle = buf_temp-diasize-handle.handle-value
     1959               .
     1960               if v-object-handle <> v-diasize-resize-button
     1961               then do:
     1962                 assign
     1963                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1964                 .
     1965               end.
     1966             end.
     1967             run diasize_position-resize-button in this-procedure .
     1968           end.
     1969           assign
     1970             v-diasize-change-size = false
     1971           .
     1972           leave move_block .
     1973         end.
     1974       end.
     1975       assign
     1976         v-diasize-need-full-display = true
     1977       .
     1978       if v-diasize-change-size = false
     1979       then do:
     1980         assign
     1981           v-diasize-change-size = true
     1982         .
     1983       end.
     1984       else do:
     1985         return .
     1986       end.
     1987       assign
     1988         v-frame-height = frame Dialog-Frame :height
     1989         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1990         v-browse-height = v-diasize-browse-handle :height
     1991       .
     1992       for each buf_temp-browse-handle
     1993         where buf_temp-browse-handle.browse-type = 'height':u
     1994       :
     1995         assign
     1996           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1997         .
     1998       end.
     1999       for each buf_temp-diasize-handle
     2000       :
     2001         delete buf_temp-diasize-handle .
     2002       end.
     2003       assign
     2004         v-field-group-handle = frame Dialog-Frame :first-child
     2005       .
     2006       do while valid-handle(v-field-group-handle)
     2007       :
     2008         assign
     2009           v-object-handle = v-field-group-handle :first-child
     2010         .
     2011         do while valid-handle(v-object-handle)
     2012         :
     2013           if  v-object-handle <> v-diasize-browse-handle :handle
     2014           and can-query(v-object-handle, "row")
     2015           and can-query(v-object-handle, "height")
     2016           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2017           then do:
     2018             find first buf_temp-browse-handle
     2019               where buf_temp-browse-handle.browse-type   = 'height':u
     2020                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2021               no-error .
     2022             if available buf_temp-browse-handle
     2023             then do:
     2024             end.
     2025             else do:
     2026               create buf_temp-diasize-handle .
     2027               assign
     2028                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2029                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2030               .
     2031             end.
     2032           end.
     2033           assign
     2034             v-object-handle = v-object-handle :next-sibling
     2035           .
     2036         end.
     2037         assign
     2038           v-field-group-handle = v-field-group-handle :next-sibling
     2039         .
     2040       end.
     2041       do with frame Dialog-Frame
     2042       :
     2043         hide v-diasize-resize-button .
     2044         assign
     2045           v-diasize-resize-button :row    = 1
     2046           v-diasize-resize-button :column = 1
     2047         .
     2048       end.
     2049       if p-change-value > 0
     2050       then do:
     2051         if frame Dialog-Frame :scrollable = true
     2052         then do:
     2053           assign
     2054             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2055             no-error .
     2056           if error-status :error
     2057           or error-status :get-message(1) <> ""
     2058           then do:
     2059             undo move_block, retry move_block .
     2060           end.
     2061         end.
     2062         assign
     2063           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2064           no-error .
     2065         if error-status :error
     2066         or error-status :get-message(1) <> ""
     2067         then do:
     2068           undo move_block, retry move_block .
     2069         end.
     2070         assign
     2071           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2072           no-error .
     2073         if error-status :error
     2074         or error-status :get-message(1) <> ""
     2075         then do:
     2076           undo move_block, retry move_block .
     2077         end.
     2078         for each buf_temp-browse-handle
     2079           where buf_temp-browse-handle.browse-type = 'height':u
     2080         on error undo move_block, retry move_block
     2081         :
     2082           assign
     2083             buf_temp-browse-handle.browse-handle :height
     2084               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2085             no-error .
     2086           if error-status :error
     2087           or error-status :get-message(1) <> ""
     2088           then do:
     2089             undo move_block, retry move_block .
     2090           end.
     2091         end.
     2092         for each buf_temp-diasize-handle
     2093         on error undo move_block, retry move_block
     2094         :
     2095           assign
     2096             v-object-handle = buf_temp-diasize-handle.handle-value
     2097           .
     2098           if v-object-handle <> v-diasize-resize-button
     2099           then do:
     2100             assign
     2101               v-object-handle :row = v-object-handle :row + p-change-value
     2102               no-error .
     2103             if error-status :error
     2104             or error-status :get-message(1) <> ""
     2105             then do:
     2106               undo move_block, retry move_block .
     2107             end.
     2108           end.
     2109         end.
     2110       end.
     2111       else do:
     2112         for each buf_temp-diasize-handle
     2113         on error undo move_block, retry move_block
     2114         :
     2115           assign
     2116             v-object-handle = buf_temp-diasize-handle.handle-value
     2117           .
     2118           if v-object-handle <> v-diasize-resize-button
     2119           then do:
     2120             assign
     2121               v-object-handle :row = v-object-handle :row + p-change-value
     2122               no-error .
     2123             if error-status :error
     2124             or error-status :get-message(1) <> ""
     2125             then do:
     2126               undo move_block, retry move_block .
     2127             end.
     2128           end.
     2129         end.
     2130         assign
     2131           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2132           no-error .
     2133         if error-status :error
     2134         or error-status :get-message(1) <> ""
     2135         then do:
     2136           undo move_block, retry move_block .
     2137         end.
     2138         for each buf_temp-browse-handle
     2139           where buf_temp-browse-handle.browse-type = 'height':u
     2140         on error undo move_block, retry move_block
     2141         :
     2142           assign
     2143             buf_temp-browse-handle.browse-handle :height
     2144               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2145             no-error .
     2146           if error-status :error
     2147           or error-status :get-message(1) <> ""
     2148           then do:
     2149             undo move_block, retry move_block .
     2150           end.
     2151         end.
     2152         assign
     2153           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2154           no-error .
     2155         if error-status :error
     2156         or error-status :get-message(1) <> ""
     2157         then do:
     2158           undo move_block, retry move_block .
     2159         end.
     2160         if frame Dialog-Frame :scrollable = true
     2161         then do:
     2162           assign
     2163             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2164             no-error .
     2165           if error-status :error
     2166           or error-status :get-message(1) <> ""
     2167           then do:
     2168             undo move_block, retry move_block .
     2169           end.
     2170         end.
     2171       end.
     2172       if p-move-resize = true
     2173       then do:
     2174         run diasize_position-resize-button in this-procedure .
     2175       end.
     2176       if v-diasize-wndstore = true
     2177       then do:
     2178         if connected("ub") = true
     2179         then do:
     2180           define variable v-cntxt-db-num        as integer   no-undo .
     2181           define variable v-cntxt-userid        as character no-undo .
     2182           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2183                                             , OUTPUT v-cntxt-userid
     2184                                             ) .
     2185           run gbl/wndsizew.p
     2186             (input  v-cntxt-db-num
     2187             ,input  v-cntxt-userid
     2188             ,input  v-diasize-proc-name
     2189             ,input  'height':u
     2190             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2191             ) .
     2192         end.
     2193       end.
     2194     end.
     2195     assign
     2196       v-diasize-change-size = false
     2197     .
     2198   end procedure.
     2199   procedure diasize_set-height :
     2200     define input  parameter p-new-height  as decimal   no-undo .
     2201     define input  parameter p-move-resize as logical   no-undo .
     2202     do
     2203     on error undo, return error return-value
     2204     :
     2205       run diasize_change-height in this-procedure
     2206         (input  (p-new-height - frame Dialog-Frame :height)
     2207         ,input  p-move-resize
     2208         ) .
     2209     end.
     2210   end procedure.
     2211   procedure diasize_change-width :
     2212     define input  parameter p-change-value as decimal   no-undo .
     2213     define input  parameter p-move-resize  as logical   no-undo .
     2214     define variable v-field-group-handle   as handle    no-undo .
     2215     define variable v-object-handle        as handle    no-undo .
     2216     define variable v-frame-width          as decimal   no-undo .
     2217     define variable v-frame-virtual-width  as decimal   no-undo .
     2218     define variable v-browse-width         as decimal   no-undo .
     2219     define variable v-window-width         as decimal   no-undo .
     2220     define variable v-window-virtual-width as decimal   no-undo .
     2221     define variable v-change-sign          as integer   no-undo .
     2222     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2223     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2224     if p-change-value > 0
     2225     then do:
     2226       if frame Dialog-Frame :width + p-change-value >
     2227           session :width-chars
     2228       then do:
     2229         assign
     2230           p-change-value = session :width-chars - frame Dialog-Frame :width
     2231         .
     2232         if p-change-value <= 0
     2233         then do:
     2234           run diasize_position-resize-button in this-procedure .
     2235           return .
     2236         end.
     2237       end.
     2238     end.
     2239     if p-change-value < 0
     2240     then do:
     2241       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2242       then do:
     2243         assign
     2244           p-change-value = v-diasize-orig-frame-width
     2245                          - frame Dialog-Frame :width
     2246         .
     2247         if p-change-value >= 0
     2248         then do:
     2249           run diasize_position-resize-button in this-procedure .
     2250           return .
     2251         end.
     2252       end.
     2253     end.
     2254     if p-change-value >= 0
     2255     then do:
     2256       assign
     2257         v-change-sign = 1
     2258       .
     2259     end.
     2260     else do:
     2261       assign
     2262         v-change-sign = -1
     2263       .
     2264     end.
     2265     assign
     2266       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2267     .
     2268     if p-change-value = 0
     2269     then do:
     2270       run diasize_position-resize-button in this-procedure .
     2271       return .
     2272     end.
     2273     move_block:
     2274     do
     2275     on error undo move_block, leave move_block
     2276     :
     2277       if retry
     2278       then do:
     2279         do
     2280         on error undo move_block, leave move_block
     2281         :
     2282           if p-change-value > 0
     2283           then do:
     2284             for each buf_temp-diasize-handle
     2285             on error undo, next
     2286             :
     2287               assign
     2288                 v-object-handle = buf_temp-diasize-handle.handle-value
     2289               .
     2290               if v-object-handle <> v-diasize-resize-button
     2291               then do:
     2292                 assign
     2293                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2294                 .
     2295               end.
     2296             end.
     2297             assign
     2298               v-diasize-browse-handle :width = v-browse-width
     2299             .
     2300             for each buf_temp-browse-handle
     2301               where buf_temp-browse-handle.browse-type = 'width':u
     2302             on error undo, next
     2303             :
     2304               assign
     2305                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2306               .
     2307             end.
     2308             assign
     2309               frame Dialog-Frame :width = v-frame-width
     2310             .
     2311             if frame Dialog-Frame :scrollable = true
     2312             then do:
     2313               assign
     2314                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2315               .
     2316             end.
     2317             run diasize_position-resize-button in this-procedure .
     2318           end.
     2319           else do:
     2320             if frame Dialog-Frame :scrollable = true
     2321             then do:
     2322               assign
     2323                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2324               .
     2325             end.
     2326             assign
     2327               frame Dialog-Frame :width = v-frame-width
     2328             .
     2329             for each buf_temp-browse-handle
     2330               where buf_temp-browse-handle.browse-type = 'width':u
     2331             on error undo, next
     2332             :
     2333               assign
     2334                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2335               .
     2336             end.
     2337             assign
     2338               v-diasize-browse-handle :width = v-browse-width
     2339             .
     2340             for each buf_temp-diasize-handle
     2341             on error undo, next
     2342             :
     2343               assign
     2344                 v-object-handle = buf_temp-diasize-handle.handle-value
     2345               .
     2346               if v-object-handle <> v-diasize-resize-button
     2347               then do:
     2348                 assign
     2349                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2350                 .
     2351               end.
     2352             end.
     2353             run diasize_position-resize-button in this-procedure .
     2354           end.
     2355           assign
     2356             v-diasize-change-size = false
     2357           .
     2358           leave move_block .
     2359         end.
     2360       end.
     2361       assign
     2362         v-diasize-need-full-display = true
     2363       .
     2364       if v-diasize-change-size = false
     2365       then do:
     2366         assign
     2367           v-diasize-change-size = true
     2368         .
     2369       end.
     2370       else do:
     2371         return .
     2372       end.
     2373       assign
     2374         v-frame-width = frame Dialog-Frame :width
     2375         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2376         v-browse-width = v-diasize-browse-handle :width
     2377       .
     2378       for each buf_temp-browse-handle
     2379         where buf_temp-browse-handle.browse-type = 'width':u
     2380       :
     2381         assign
     2382           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2383         .
     2384       end.
     2385       for each buf_temp-diasize-handle
     2386       :
     2387         delete buf_temp-diasize-handle .
     2388       end.
     2389       assign
     2390         v-field-group-handle = frame Dialog-Frame :first-child
     2391       .
     2392       do while valid-handle(v-field-group-handle)
     2393       :
     2394         assign
     2395           v-object-handle = v-field-group-handle :first-child
     2396         .
     2397         do while valid-handle(v-object-handle)
     2398         :
     2399           if  v-object-handle <> v-diasize-browse-handle :handle
     2400           and v-object-handle <> v-diasize-resize-button
     2401           and can-query(v-object-handle, "row")
     2402           and can-query(v-object-handle, "height")
     2403           and ( v-object-handle :col + v-object-handle :width
     2404                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2405               )
     2406           then do:
     2407             find first buf_temp-browse-handle
     2408               where buf_temp-browse-handle.browse-type   = 'width':u
     2409                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2410               no-error .
     2411             if available buf_temp-browse-handle
     2412             then do:
     2413             end.
     2414             else do:
     2415               create buf_temp-diasize-handle .
     2416               assign
     2417                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2418                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2419               .
     2420             end.
     2421           end.
     2422           assign
     2423             v-object-handle = v-object-handle :next-sibling
     2424           .
     2425         end.
     2426         assign
     2427           v-field-group-handle = v-field-group-handle :next-sibling
     2428         .
     2429       end.
     2430       do with frame Dialog-Frame
     2431       :
     2432         hide v-diasize-resize-button .
     2433         v-diasize-resize-button :row = 1.
     2434         v-diasize-resize-button :column = 1.
     2435       end.
     2436       if p-change-value > 0
     2437       then do:
     2438         if frame Dialog-Frame :scrollable = true
     2439         then do:
     2440           assign
     2441             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2442             no-error .
     2443           if error-status :error
     2444           or error-status :get-message(1) <> ""
     2445           then do:
     2446             undo move_block, retry move_block.
     2447           end.
     2448         end.
     2449         assign
     2450           frame Dialog-Frame :width = v-frame-width + p-change-value
     2451           no-error .
     2452         if error-status :error
     2453         or error-status :get-message(1) <> ""
     2454         then do:
     2455           undo move_block, retry move_block.
     2456         end.
     2457         assign
     2458           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2459         no-error .
     2460         if error-status :error
     2461         or error-status :get-message(1) <> ""
     2462         then do:
     2463           undo move_block, retry move_block.
     2464         end.
     2465         for each buf_temp-browse-handle
     2466           where buf_temp-browse-handle.browse-type = 'width':u
     2467         on error undo move_block, retry move_block
     2468         :
     2469           assign
     2470             buf_temp-browse-handle.browse-handle :width
     2471               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2472             no-error .
     2473           if error-status :error
     2474           or error-status :get-message(1) <> ""
     2475           then do:
     2476             undo move_block, retry move_block .
     2477           end.
     2478         end.
     2479         for each buf_temp-diasize-handle
     2480         on error undo move_block, retry move_block
     2481         :
     2482           assign
     2483             v-object-handle = buf_temp-diasize-handle.handle-value
     2484           .
     2485           if v-object-handle <> v-diasize-resize-button
     2486           then do:
     2487             assign
     2488               v-object-handle :col = v-object-handle :col + p-change-value
     2489               no-error .
     2490             if error-status :error
     2491             or error-status :get-message(1) <> ""
     2492             then do:
     2493               undo move_block, retry move_block .
     2494             end.
     2495           end.
     2496         end.
     2497       end.
     2498       else do:
     2499         for each buf_temp-diasize-handle
     2500         on error undo move_block, retry move_block
     2501         :
     2502           assign
     2503             v-object-handle = buf_temp-diasize-handle.handle-value
     2504           .
     2505           if v-object-handle <> v-diasize-resize-button
     2506           then do:
     2507             assign
     2508               v-object-handle :col = v-object-handle :col + p-change-value
     2509               no-error .
     2510             if error-status :error
     2511             or error-status :get-message(1) <> ""
     2512             then do:
     2513               undo move_block, retry move_block .
     2514             end.
     2515           end.
     2516         end.
     2517         for each buf_temp-browse-handle
     2518           where buf_temp-browse-handle.browse-type = 'width':u
     2519         on error undo move_block, retry move_block
     2520         :
     2521           assign
     2522             buf_temp-browse-handle.browse-handle :width
     2523               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2524             no-error .
     2525           if error-status :error
     2526           or error-status :get-message(1) <> ""
     2527           then do:
     2528             undo move_block, retry move_block .
     2529           end.
     2530         end.
     2531         assign
     2532           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2533           no-error .
     2534         if error-status :error
     2535         or error-status :get-message(1) <> ""
     2536         then do:
     2537           undo move_block, retry move_block.
     2538         end.
     2539         assign
     2540           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2541         no-error .
     2542         if error-status :error
     2543         or error-status :get-message(1) <> ""
     2544         then do:
     2545           undo move_block, retry move_block.
     2546         end.
     2547         if frame Dialog-Frame :scrollable = true
     2548         then do:
     2549           assign
     2550             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2551           no-error .
     2552           if error-status :error
     2553           or error-status :get-message(1) <> ""
     2554           then do:
     2555             undo move_block, retry move_block.
     2556           end.
     2557         end.
     2558       end.
     2559       if p-move-resize
     2560       then do:
     2561         run diasize_position-resize-button in this-procedure .
     2562       end.
     2563       if v-diasize-wndstore = true
     2564       then do:
     2565         if connected("ub") = true
     2566         then do:
     2567           define variable v-cntxt-db-num        as integer   no-undo .
     2568           define variable v-cntxt-userid        as character no-undo .
     2569           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2570                                             , OUTPUT v-cntxt-userid
     2571                                             ) .
     2572           run gbl/wndsizew.p
     2573             (input  v-cntxt-db-num
     2574             ,input  v-cntxt-userid
     2575             ,input  v-diasize-proc-name
     2576             ,input  'width':u
     2577             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2578             ) .
     2579         end.
     2580       end.
     2581     end.
     2582     assign
     2583       v-diasize-change-size = false
     2584     .
     2585   end procedure.
     2586   procedure diasize_set-width :
     2587     define input  parameter p-new-width  as decimal   no-undo .
     2588     define input  parameter p-move-resize as logical   no-undo .
     2589     do
     2590     on error undo, return error return-value
     2591     :
     2592       run diasize_change-width in this-procedure
     2593         (input  (p-new-width - frame Dialog-Frame :width)
     2594         ,input  p-move-resize
     2595         ) .
     2596     end.
     2597   end procedure.
     2598   procedure diasize_position-resize-button :
     2599     do with frame Dialog-Frame
     2600     :
     2601       hide v-diasize-resize-button .
     2602       assign
     2603         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2604                     - 1
     2605                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2606         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2607                     - 1
     2608                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2609       .
     2610       view v-diasize-resize-button .
     2611     end.
     2612   end procedure.
     2613   on alt-right anywhere
     2614   do:
     2615     run diasize_change-width in this-procedure
     2616       (input 1
     2617       ,input true
     2618       ) .
     2619     return no-apply .
     2620   end.
     2621   on alt-left anywhere
     2622   do:
     2623     run diasize_change-width in this-procedure
     2624       (input -1
     2625       ,input true
     2626       ) .
     2627     return no-apply .
     2628   end.
     2629   on alt-down anywhere
     2630   do:
     2631     run diasize_change-height in this-procedure
     2632       (input 1
     2633       ,input true
     2634       ) .
     2635     return no-apply .
     2636   end.
     2637   on alt-up anywhere
     2638   do:
     2639     run diasize_change-height in this-procedure
     2640       (input -1
     2641       ,input true
     2642       ) .
     2643     return no-apply .
     2644   end.
     2645   on alt-enter of frame Dialog-Frame
     2646   do:
     2647     run diasize_maximize in this-procedure
     2648       (input  ?
     2649       ).
     2650     return no-apply .
     2651   end.
     2652   procedure diasize_end-move :
     2653     do
     2654     on error undo, return error return-value
     2655     :
     2656       define variable v-row-delta as decimal   no-undo .
     2657       define variable v-col-delta as decimal   no-undo .
     2658       define variable v-new-row as decimal   no-undo .
     2659       define variable v-new-col as decimal   no-undo .
     2660       assign
     2661         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2662         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2663       .
     2664       assign
     2665         v-row-delta = v-new-row - frame Dialog-Frame :height
     2666         v-col-delta = v-new-col - frame Dialog-Frame :width
     2667       .
     2668       run diasize_change-height in this-procedure
     2669         (input v-row-delta
     2670         ,input true
     2671         ) .
     2672       run diasize_change-width in this-procedure
     2673         (input v-col-delta
     2674         ,input true
     2675         ) .
     2676     end.
     2677   end procedure.
     2678   procedure diasize_maximize :
     2679     define input  parameter p-action as logical   no-undo .
     2680     do
     2681     on error undo, return error return-value
     2682     :
     2683       if p-action = ?
     2684       then do:
     2685         if v-diasize-need-maximize = true
     2686         then do:
     2687           assign
     2688             p-action = true
     2689           .
     2690         end.
     2691         else do:
     2692           assign
     2693             p-action = false
     2694           .
     2695         end.
     2696       end.
     2697       if p-action = true
     2698       then do:
     2699         run diasize_change-height in this-procedure
     2700           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2701               - frame Dialog-Frame :height-chars
     2702           ,input true
     2703           ) .
     2704         run diasize_change-width in this-procedure
     2705           (input session :width-chars
     2706               - frame Dialog-Frame :width-chars
     2707           ,input true
     2708           ) .
     2709         assign
     2710           v-diasize-need-maximize = false
     2711         .
     2712       end.
     2713       else do:
     2714         run diasize_change-width in this-procedure
     2715           (input v-diasize-orig-frame-width
     2716               - frame Dialog-Frame :width-chars
     2717           ,input true
     2718           ) .
     2719         run diasize_change-height in this-procedure
     2720           (input v-diasize-orig-frame-height
     2721               - frame Dialog-Frame :height-chars
     2722           ,input true
     2723           ) .
     2724         assign
     2725           v-diasize-need-maximize = true
     2726         .
     2727       end.
     2728     end.
     2729   end procedure.
     2730   procedure diasize_restore-orig-size :
     2731     do
     2732     on error undo, return error return-value
     2733     :
     2734       assign
     2735         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2736         v-diasize-current-frame-height = frame Dialog-Frame :height
     2737       .
     2738       run diasize_set-height in this-procedure
     2739         (input  v-diasize-orig-frame-height
     2740         ,input  true
     2741         ) .
     2742       run diasize_set-width in this-procedure
     2743         (input  v-diasize-orig-frame-width
     2744         ,input  true
     2745         ) .
     2746     end.
     2747   end procedure.
     2748   procedure diasize_restore-current-size :
