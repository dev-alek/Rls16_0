        1   define input  parameter p-db-num-order as int64 no-undo.
        2   define input  parameter p-doc-code-order as int64 no-undo.
        3   define variable orderStatus  as class ibs.th.str.order.sts.order no-undo .
        4   orderStatus =  new ibs.th.str.order.sts.order().
        5   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
        6   run gbl/getobjsrvhndl.p (input-output ObjSrv).
        7   define variable vLabel as character no-undo.
        8   DEFINE BUFFER X_c-obj-hist FOR c-order-head.
        9   DEFINE BUFFER find_c-obj-hist FOR c-order-head.
       10   DEFINE BUFFER X_curr-sysconf FOR sysconf.
       11   DEFINE BUFFER X_db FOR db.
       12   DEFINE BUFFER X_sysconf FOR sysconf.
       13   define input     parameter parParentProc  as widget-handle no-undo.
       14   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo.
       15   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo.
       16   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo.
       17   define input parameter bttns  as char   no-undo .
       18   define input parameter p-mode  as char   no-undo .
       19   define input parameter p-corr-user-db-num  like ub.c-cli-hist.corr-user-db-num no-undo .
       20   define input parameter p-corr-user-name  like ub.c-cli-hist.corr-user-name no-undo .
       21   define input parameter p-subject  like ub.c-cli-hist.subject no-undo .
       22   define input parameter p-db-num  like ub.c-cli-hist.corr-user-db-num no-undo .
       23   define input parameter p-chip-num  as int64 no-undo.
       24   define input-output param p-rid-list    as  char no-undo .
       25   if p-mode <> "one" then
       26   do:
       27     vLabel = "История по Заказам".
       28   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       29   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       30   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       31   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       32   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
       33   define variable vss-description AS CHAR NO-UNDO INIT "Список полной истории":U.
       34   procedure vss-get-info :
       35     define output parameter p-vss-revision    like vss-revision    no-undo .
       36     define output parameter p-vss-author      like vss-author      no-undo .
       37     define output parameter p-vss-date        like vss-date        no-undo .
       38     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       39     define output parameter p-vss-archive     like vss-archive     no-undo .
       40     define output parameter p-vss-description like vss-description no-undo .
       41     assign
       42       p-vss-revision    = vss-revision
       43       p-vss-author      = vss-author
       44       p-vss-date        = vss-date
       45       p-vss-workfile    = vss-workfile
       46       p-vss-archive     = vss-archive
       47       p-vss-description = vss-description
       48     .
       49   end procedure.
       50   procedure vss-get-parameters :
       51     define output parameter p-vss-parameters as character no-undo .
       52   end procedure.
       53   define new global shared variable g#vssrevis-logger as handle    no-undo .
       54   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       55   define variable v-vssrevis-logger                   as handle    no-undo .
       56   procedure vss-logevent :
       57     define input  parameter p-extra-paramters as character no-undo .
       58     define variable v-vssrevis-parameters as character no-undo .
       59     do
       60     on error undo, return error return-value
       61     :
       62       if  valid-handle(v-vssrevis-logger)
       63       and v-vssrevis-logger :get-signature("logevent") <> ""
       64       then do:
       65         run vss-get-parameters in this-procedure
       66           (output v-vssrevis-parameters
       67           ).
       68         run logevent in v-vssrevis-logger
       69           (input vss-workfile
       70           ,input vss-revision
       71           ,input v-vssrevis-parameters
       72           ,input p-extra-paramters
       73           ).
       74       end.
       75     end.
       76   end procedure.
       77   assign
       78     v-vssrevis-logger = g#vssrevis-logger
       79   .
       80   if  valid-handle(v-vssrevis-logger)
       81   and v-vssrevis-logger :get-signature("logevent") <> ""
       82   then do:
       83     assign
       84       v-vssrevis-logevent = true
       85     .
       86     run vss-logevent in this-procedure (input vss-description) .
       87   end.
       88   define new global shared variable g#language as character no-undo .
       89   if g#language <> '' and g#language <> 'rus':U then do:
       90     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       91   end.
       92   define new global shared variable g#library  as handle no-undo .
       93   define new global shared variable g#library2 as handle no-undo .
       94   procedure proc-alt-shift-f2:
       95     if not ibs.th.gbl.gbl-var:rcode
       96   then
       97     run gbl\inidebug.p .
       98   end.
       99   procedure proc-alt-shift-f3:
      100     run gbl/prvssinf.p
      101       ( input this-procedure
      102       ) .
      103   end.
      104   define variable v-inform-launched as logical no-undo initial false .
