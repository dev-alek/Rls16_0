     2999        )
     3000     or (can-query (self, "read-only")
     3001        and
     3002        self :read-only = false
     3003        )
     3004     then do:
     3005       assign
     3006         self :screen-value = ?
     3007       .
     3008     end.
     3009     return no-apply.
