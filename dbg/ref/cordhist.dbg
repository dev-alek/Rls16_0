     3461   END PROCEDURE.
     3462   PROCEDURE MyEnable :
     3463   DEFINE VARIABLE v-h AS handle NO-UNDO.
     3464   assign
     3465   br-obj-hist:num-locked-columns in frame Dialog-Frame = 1
     3466   X_c-obj-hist.corr-date:read-only in browse br-obj-hist = yes
     3467   br-changes:title = "":U
     3468   v-corr-user-db-num = v-db-num
     3469   temp-changes.l_name:resizable in browse br-changes = true
     3470   temp-changes.v_old:resizable in browse br-changes = true
     3471   temp-changes.v_new:resizable in browse br-changes = true
     3472   temp-changes.l_name:width in browse br-changes = 30
     3473   temp-changes.v_old:width in browse br-changes = 40
     3474   temp-changes.v_new:width in browse br-changes = 40
     3475   v-h = br-obj-hist:FIRST-COLUMN IN FRAME Dialog-Frame
     3476   .
     3477   DO while valid-handle(v-h) :
     3478     if v-h:LABEL = "Предмет изменения"
     3479     or v-h:LABEL = "Изменил"
     3480       then do:
     3481       v-h:RESIZABLE = YES.
     3482     end.
     3483       v-h = v-h:NEXT-COLUMN.
     3484     END.
     3485   DISPLAY
     3486   v-corr-user-db-num
     3487   sch-db-num
     3488   sch-corr-date
     3489   sch-obj-code
     3490   sch-corr-user-name
     3491   mark-num
     3492   WITH FRAME Dialog-Frame.
     3493   ENABLE
     3494   v-corr-user-db-num
     3495   b-quit
     3496   B-mark when lookup("b-mark":U, bttns) > 0
     3497   b-sel when lookup("b-sel":U, bttns) > 0
     3498   B-sch
     3499   B-Print
     3500   B-Help
     3501   br-obj-hist
     3502   sch-corr-date
     3503   sch-corr-user-name
     3504   sch-obj-code when p-mode = 'все':U
     3505   sch-db-num when p-mode = 'все':U
     3506   BR-changes mark-num
     3507   b-nextlevel
     3508   WITH FRAME Dialog-Frame.
     3509   VIEW FRAME Dialog-Frame.
     3510   HIDE sch-corr-user-name IN FRAME Dialog-Frame.
     3511   END PROCEDURE.
     3512   PROCEDURE OpenBr :
     3513   define input  parameter p-open-query     as logical   no-undo .
     3514   define input  parameter p-find-next      as logical   no-undo .
     3515   define input  parameter p-find-condition as character no-undo .
     3516   define input  parameter p-db-num like c-order-head.corr-user-db-num no-undo .
     3517   define variable l-query-was-opened as logical no-undo .
     3518   define variable title0 as character no-undo.
     3519   title0 = "Список полной истории контрагента" + chr(32).
     3520   run waitfram-show in this-procedure ("Ждите...").
     3521   define variable sort-column-phrase as character no-undo .
     3522   case sort-column-name :
     3523     when "" then do:
     3524       assign
     3525         sort-column-phrase = ""
     3526       .
     3527     end.
     3528     otherwise do:
     3529       assign
     3530         sort-column-phrase = "by " + sort-column-name
     3531       .
     3532     end.
     3533   end case.
     3534   define variable l-open-query as logical   no-undo .
     3535   if p-mode = 'все':U then
     3536   do:
     3537         assign
     3538         filter-point = filter-point0 + p-mode
     3539         filter-label = substitute("&1", filter-label0)
     3540         .
     3541   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3542   define variable  l-disable-where-27  as logical   no-undo .
     3543   define variable  l-filter-open-27    as logical   .
     3544   define variable  flt-rec-27       as recid     no-undo .
     3545   define variable  filter-name-27      as character no-undo .
     3546   define variable  where-phrase-27     as character no-undo .
     3547   define variable  sort-phrase-27      as character no-undo .
     3548   define variable  where-phrase-rus-27 as character no-undo .
     3549   define variable  sort-phrase-rus-27  as character no-undo .
     3550     run waitfram-show in this-procedure
     3551       (input "ЖДИТЕ ..."
     3552       ).
     3553   run gbl/flt-get.p
     3554     (input filter-point
     3555     ,output flt-rec-27
     3556     ,output filter-name-27
     3557     ,output where-phrase-27
     3558     ,output sort-phrase-27
     3559     ,output where-phrase-rus-27
     3560     ,output sort-phrase-rus-27
     3561     ).
     3562   if p-open-query then do:
     3563       run set-filter-name in this-procedure
     3564         (INPUT filter-name-27
     3565         ) no-error .
     3566     assign
     3567       l-filter-open-27 = false
     3568     .
     3569     if flt-rec-27 <> ?
     3570       or sort-column-phrase > ""
     3571     then do:
     3572       define variable  parameter-2-27 as character no-undo .
     3573       define variable  parameter-3-27 as character no-undo .
     3574       define variable  parameter-4-27 as character no-undo .
     3575       define variable  parameter-5-27 as character no-undo .
     3576       define variable  parameter-6-27 as character no-undo .
     3577       define variable  parameter-7-27 as character no-undo .
     3578         assign
     3579         parameter-3-27 =
     3580                                 "FOR EACH X_c-obj-hist"
     3581         parameter-4-27 =
     3582           (
     3583             if (" TRUE " + " " + where-phrase-27) <> ""
     3584             then " TRUE " + " " + where-phrase-27
     3585             else "true"
     3586           )
     3587         parameter-5-27 = (" " + "" + " " + "")
     3588         parameter-6-27 = if sort-phrase-27 = ''
     3589                              then
     3590           (
     3591           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC  " +
     3592             " " + sort-column-phrase +
     3593           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC  "
     3594           )
     3595                              else
     3596           (
     3597           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC  " +
     3598             " " + sort-column-phrase +
     3599           " " + sort-phrase-27
     3600           )
     3601         parameter-7-27 =
     3602           " indexed-reposition  "
     3603       .
     3604       do
     3605       on stop undo, leave
     3606       on error undo, leave
     3607       :
     3608         assign
     3609           l-disable-where-27 =
     3610             (" TRUE " + " " + where-phrase-27 = "")
     3611         .
     3612         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3613                             ,input query br-obj-hist:handle
     3614                             ,input parameter-3-27
     3615                             ,input parameter-4-27
     3616                             ,input parameter-5-27
     3617                             ,input parameter-6-27
     3618                             ,input parameter-7-27
     3619                             )
     3620         .
     3621         assign
     3622           l-filter-open-27 = true
     3623         .
     3624       end.
     3625       if l-filter-open-27 = false then do:
     3626         message
     3627           "Ошибка при фильтрации / сортировке" skip
     3628           "Будут показаны записи без учета фильтра" skip
     3629           view-as alert-box .
     3630       end.
     3631       else do:
     3632           assign
     3633             l-query-was-opened = true
     3634           .
     3635       end.
     3636     end.
     3637     if l-filter-open-27 = false then do:
     3638       OPEN QUERY br-obj-hist FOR EACH X_c-obj-hist
     3639         where  TRUE
     3640          BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC
     3641          BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC
     3642         indexed-reposition
     3643     .
     3644         assign
     3645           l-query-was-opened = true
     3646         .
     3647     end.
     3648   end.
     3649   else do:
     3650     assign
     3651       v-doc-rec = recid( X_c-obj-hist )
     3652     .
     3653     do
     3654     on stop undo, leave
     3655     on error undo, leave
     3656     :
     3657       if query br-obj-hist:handle:get-buffer-handle(1) = (buffer X_c-obj-hist:handle) then do:
     3658         assign
     3659         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     3660         parameter-4-27 =
     3661           "where ":u + " TRUE " + " ":u + where-phrase-27 + " ":u + p-find-condition + " " + ""
     3662         parameter-5-27 = " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC  "
     3663       .
     3664         run fltopend_fltfindd in this-procedure  (
     3665                             input this-procedure:handle
     3666                             ,input query br-obj-hist:handle
     3667                             ,input rowid(X_c-obj-hist)
     3668                             ,input logical(parameter-2-27)
     3669                             ,input no-lock
     3670                             ,input (buffer X_c-obj-hist:handle)
     3671                             ,input parameter-4-27
     3672                             ,input parameter-5-27
     3673                             ) no-error.
     3674         .
     3675         assign
     3676           v-doc-rec = integer(return-value)
     3677           v-fltopend-rowid[1] = ?
     3678         .
     3679       end.
     3680       else do:
     3681         assign
     3682         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     3683         parameter-3-27 =  "FOR EACH X_c-obj-hist"
     3684         parameter-4-27 =
     3685           (
     3686             if (" TRUE " + " " + where-phrase-27) <> ""
     3687             then " TRUE " + " " + where-phrase-27
     3688             else "true"
     3689           )
     3690         parameter-5-27 = (" " + "" + " " + "" + " " + p-find-condition)
     3691         parameter-6-27 = if sort-phrase-27 = ''
     3692                              then
     3693           (
     3694           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC  " +
     3695             " " + sort-column-phrase +
     3696           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC  "
     3697           )
     3698                              else
     3699           (
     3700           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC  " +
     3701             " " + sort-column-phrase +
     3702           " " + sort-phrase-27
     3703           )
     3704         parameter-7-27 =
     3705           " indexed-reposition  "
     3706       .
     3707         run fltopend_fltfindq in this-procedure  (
     3708                             input this-procedure:handle
     3709                             ,input query br-obj-hist:handle
     3710                             ,input logical(parameter-2-27)
     3711                             ,input no-lock
     3712                             ,input parameter-3-27
     3713                             ,input parameter-4-27
     3714                             ,input parameter-5-27
     3715                             ,input parameter-6-27
     3716                             ,input parameter-7-27
     3717                             ,output v-fltopend-rowid
     3718                             ) no-error.
     3719         .
     3720         v-doc-rec = ?.
     3721       end.
     3722       assign
     3723         l-query-was-opened = true
     3724       .
     3725     end.
     3726   end.
     3727     run waitfram-hide in this-procedure .
     3728   end.
     3729   else do:
     3730     if not local-open-br( p-open-query      ,
     3731                           p-find-next         ,
     3732                          p-find-condition )
     3733     then do:
     3734   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3735   define variable  l-disable-where-29  as logical   no-undo .
     3736   define variable  l-filter-open-29    as logical   .
