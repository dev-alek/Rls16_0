     1615        run proc-br-obj-hist in this-procedure no-error.
     1616     if error-status:error then return no-apply.
     1617   END.
     1618   ON RETURN OF br-obj-hist IN FRAME Dialog-Frame
     1619   DO:
     1620       run proc-br-obj-hist in this-procedure no-error.
     1621     if error-status:error then return no-apply.
