     1578         (
     1579          p-db-num-order,
     1580          p-doc-code-order,
     1581          parParentProc,
     1582          p-curr-host-code,
     1583          p-curr-obj-type,
     1584          p-curr-obj-code,
     1585          bttns,
     1586          "one",
     1587          p-corr-user-db-num,
     1588          p-corr-user-name,
     1589          p-subject,
     1590          p-db-num,
     1591          X_c-obj-hist.chip-num ,
     1592          input-output p-rid-list ).
     1593      apply "entry" to br-obj-hist in frame Dialog-Frame.
     1594   END.
     1595   ON CHOOSE OF B-print IN FRAME Dialog-Frame
