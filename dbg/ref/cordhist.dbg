     2939   procedure get-context :
     2940      define output parameter p-db-num as integer          no-undo.
     2941      define output parameter p-user-id as character        no-undo.
     2942      define variable v-login               as character    no-undo.
     2943      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2944      define buffer buf_user-login  for ub.user-login .
     2945      do
     2946      on error undo, return error
     2947      :
     2948            FIND FIRST buf_sys-ctrl no-lock.
     2949            ASSIGN
     2950               v-login = USERID("ub")
     2951               p-db-num = buf_sys-ctrl.db-num
     2952            .
     2953            FIND FIRST buf_user-login
     2954                 WHERE buf_user-login.db-num = p-db-num
     2955                   AND buf_user-login.user-login = v-login
     2956                 no-lock
     2957                 no-error
     2958                 .
     2959            IF AVAILABLE buf_user-login
     2960            THEN DO:
     2961               assign
     2962                  p-user-id = buf_user-login.user-id
     2963               .
     2964            END.
     2965      end.
     2966   end procedure.
