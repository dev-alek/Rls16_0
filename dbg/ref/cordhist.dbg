     1079   fnotChange
     1080   t_name
     1081   f_name
     1082   index imain uniq-key-rec
     1083   .
     1084   FUNCTION get-all-fields returns character (p-file-name as character ):
     1085   define variable v-dop as character no-undo .
     1086     find first _file no-lock where _file._file-name = p-file-name no-error .
     1087     if not available _file then return "":U.
     1088     for each _field no-lock where
     1089              _field._file-recid = recid(_file) :
     1090       assign
     1091       v-dop = v-dop + _field._field-name + chr(44)
     1092       .
     1093     end.
     1094     return trim(v-dop).
     1095   END FUNCTION.
     1096   PROCEDURE proc-full-temp-changes :
     1097     define input  parameter p-act-create as logical   no-undo .
     1098     define input  parameter p-act-delete as logical   no-undo .
     1099     define input  parameter p-hst-handle as handle    no-undo .
     1100     define input  parameter p-main-table as character no-undo .
     1101     define input  parameter p-field-list as character no-undo .
     1102     define input  parameter p-label-form as character no-undo .
     1103     define variable h-new-buf         as handle    no-undo .
     1104     define variable h-main-buf        as handle    no-undo .
     1105     define variable h-for-comp        as handle    no-undo .
     1106     define variable v-inform          as character no-undo .
     1107     define variable v-ind             as integer   no-undo .
     1108     define variable v-idx-field-qnty  as integer   no-undo .
     1109     define variable v-num-entries     as integer   no-undo .
     1110     define variable fh                as handle    no-undo .
     1111     define variable fh-main           as handle    no-undo .
     1112     define variable fh-old            as handle    no-undo .
     1113     define variable fh-new            as handle    no-undo .
     1114     define variable v-field-name      as character no-undo .
     1115     define variable v-field-lvl       as character no-undo .
     1116     define variable v-field-form      as character no-undo .
     1117     define variable v-search-exp      as character no-undo .
     1118     define variable v-srch-main       as character no-undo .
     1119     define variable v-word-link       as character no-undo .
     1120     define variable v-av-chip-num     as logical   no-undo .
     1121     define variable v-main-pi-fld-lst as character no-undo .
     1122     define variable v-main-fld-lst    as character no-undo .
     1123     define variable v-delim-list      as character no-undo .
     1124     define variable v-label           as character no-undo .
     1125     define variable v-old-value       as character no-undo case-sensitive.
     1126     define variable v-new-value       as character no-undo case-sensitive.
     1127     define variable v-chg-fields as character no-undo.
     1128     for each temp-changes:
     1129       delete temp-changes.
     1130     end.
     1131     if not p-hst-handle:available then do:
     1132       return .
     1133     end.
     1134     create buffer h-new-buf  for table p-hst-handle .
     1135     create buffer h-main-buf for table p-main-table .
     1136     assign
     1137       v-inform = h-main-buf:index-information(1)
     1138       v-ind    = 2
     1139     .
     1140     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1141     on error undo, return error
     1142     :
     1143       assign
     1144         v-inform = h-main-buf:index-information( v-ind )
     1145         v-ind    = v-ind + 1
     1146       .
     1147     end.
     1148     if v-inform = ?
     1149       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1150       or entry( 3, v-inform, ",":U ) <> "1":U
     1151     then do:
     1152       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1153     end.
     1154     assign
     1155       v-idx-field-qnty = num-entries( v-inform ) - 4
     1156     .
     1157     if v-idx-field-qnty < 2 then do:
     1158       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1159     end.
     1160     assign
     1161       v-srch-main   = "where":U
     1162       v-word-link   = "":U
     1163       v-av-chip-num = false
     1164       v-delim-list  = "":U
     1165     .
     1166     do v-ind = 1 to v-idx-field-qnty by 2
     1167     on error undo, return error
     1168     :
     1169       assign
     1170         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1171         fh                = p-hst-handle:buffer-field( v-field-name )
     1172         fh-main           = h-main-buf:buffer-field( v-field-name )
     1173         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1174         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1175       .
     1176       if fh:data-type ="character":U then do:
     1177         assign
     1178           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1179         .
     1180       end.
     1181       else do:
     1182         assign
     1183           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1184         .
     1185       end.
     1186       if v-delim-list = "":U then do:
     1187         assign
     1188           v-delim-list = ",":U
     1189         .
     1190       end.
     1191       if v-word-link = "":U then do:
     1192         assign
     1193           v-word-link = "and":U
     1194         .
     1195       end.
     1196     end.
     1197     assign
     1198       v-delim-list  = "":U
     1199     .
     1200     do v-ind = 1 to h-main-buf:num-fields
     1201     on error undo, return error
     1202     :
     1203       assign
     1204         fh-main      = h-main-buf:buffer-field( v-ind )
     1205         v-field-name = fh-main:name
     1206       .
     1207         assign
     1208           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1209         .
     1210         if v-delim-list = "":U then do:
     1211           assign
     1212             v-delim-list = ",":U
     1213           .
     1214         end.
     1215     end.
     1216     assign
     1217       v-inform = p-hst-handle:index-information(1)
     1218       v-ind    = 2
     1219     .
     1220     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1221     on error undo, return error
     1222     :
     1223       assign
     1224         v-inform = p-hst-handle:index-information( v-ind )
     1225         v-ind    = v-ind + 1
     1226       .
     1227     end.
     1228     if v-inform = ?
     1229       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1230       or entry( 3, v-inform, ",":U ) <> "1":U
     1231     then do:
     1232       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1233     end.
     1234     assign
     1235       v-idx-field-qnty = num-entries( v-inform ) - 4
     1236     .
     1237     if v-idx-field-qnty < 2 then do:
     1238       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1239     end.
     1240     assign
     1241       v-search-exp  = "where":U
     1242       v-word-link   = "":U
     1243       v-av-chip-num = false
     1244     .
     1245     do v-ind = 1 to v-idx-field-qnty by 2
     1246     on error undo, return error
     1247     :
     1248       assign
     1249         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1250         fh           = p-hst-handle:buffer-field( v-field-name )
     1251         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1252       .
     1253       if v-field-name = "chip-num":U then do:
     1254         assign
     1255           v-search-exp  = substitute( "&1 >", v-search-exp )
     1256           v-av-chip-num = true
     1257         .
     1258       end.
     1259       else do:
     1260         assign
     1261           v-search-exp = substitute( "&1 =", v-search-exp )
     1262         .
     1263       end.
     1264       if fh:data-type ="character":U then do:
     1265         assign
     1266           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1267         .
     1268       end.
     1269       else do:
     1270         assign
     1271           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1272         .
     1273       end.
     1274       if v-word-link = "":U then do:
     1275         assign
     1276           v-word-link = "and":U
     1277         .
     1278       end.
     1279     end.
     1280     if v-av-chip-num = false then do:
     1281       message
     1282         vss-workfile vss-revision vss-description skip
     1283         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1284         "Использование данной процедуры невозможно!" skip
     1285         view-as alert-box error .
     1286       return error .
     1287     end.
     1288     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1289     if not h-new-buf:available then do:
     1290       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1291       if not h-main-buf:available then do:
     1292         assign
     1293           h-for-comp = ?
     1294         .
     1295       end.
     1296       else do:
     1297         assign
     1298           h-for-comp = h-main-buf
     1299         .
     1300       end.
     1301     end.
     1302     else do:
     1303       assign
     1304         h-for-comp = h-new-buf
     1305       .
     1306     end.
     1307     assign
     1308       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1309     .
     1310     do v-ind = 1 to v-num-entries
     1311     on error undo, return error return-value
     1312     :
     1313       assign
     1314         v-field-name = entry( v-ind, v-main-fld-lst )
     1315         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1316         v-old-value  = fh-old:buffer-value()
     1317         v-label      = trim( fh-old:label )
     1318       .
     1319       if ( trim( p-field-list ) <> "":U
     1320            and lookup( v-field-name, p-field-list ) > 0
     1321          )
     1322          or trim( p-field-list ) = "":U
     1323       then do:
     1324         if h-for-comp <> ? then do:
     1325           assign
     1326             fh-new      = h-for-comp:buffer-field( v-field-name )
     1327             v-new-value = fh-new:buffer-value()
     1328           .
     1329         end.
     1330         else do:
     1331           assign
     1332             v-new-value = "":U
     1333           .
     1334         end.
     1335           if p-act-create = true then do:
     1336             assign
     1337               v-old-value = "":U
     1338             .
     1339           end.
     1340           if p-act-delete = true then do:
     1341             assign
     1342               v-new-value = "":U
     1343             .
     1344           end.
     1345         if v-old-value <> v-new-value
     1346           or lookup(v-field-name,v-main-pi-fld-lst) ne 0
     1347         then do:
     1348           create temp-changes.
     1349           assign
     1350             temp-changes.t_name = p-main-table
     1351             temp-changes.f_name = v-field-name
     1352             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1353             temp-changes.v_old  = trim( v-old-value )
     1354             temp-changes.v_new  = trim( v-new-value )
     1355             temp-changes.num_   = 0
     1356             temp-changes.fNotChange = v-old-value eq v-new-value
     1357           .
     1358         end.
     1359       end.
     1360     end.
     1361     assign
     1362       v-num-entries = num-entries( p-label-form, chr(8) )
     1363     .
     1364     do v-ind = 1 to v-num-entries
     1365     on error undo, return error return-value
     1366     :
     1367       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1368         assign
     1369           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1370           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1371           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1372         .
     1373         find first temp-changes
     1374           where temp-changes.f_name = v-field-name
     1375           no-error .
     1376         if available temp-changes then do:
     1377           if trim( v-field-lvl ) <> "":U then do:
     1378             assign
     1379               temp-changes.l_name = v-field-lvl
     1380             .
     1381           end.
     1382           if trim( v-field-form ) <> "":U then do:
     1383             assign
     1384               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1385             .
     1386             if h-for-comp <> ? then do:
     1387               assign
     1388                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1389               .
     1390             end.
     1391           end.
     1392         end.
     1393       end.
     1394       else do:
     1395         message
     1396           vss-workfile vss-revision vss-description skip
     1397           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1398           substitute( "список для поля '&1': '&2'"
     1399                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1400                       ,entry( v-ind, p-label-form, chr(8) )
     1401                     ) skip
     1402           substitute( "полный список: &2", p-label-form ) skip
     1403           view-as alert-box error .
     1404       end.
     1405     end.
     1406     delete object h-new-buf .
     1407     delete object h-main-buf .
     1408   END PROCEDURE.
     1409   FUNCTION get-action RETURNS CHARACTER
     1410     ( p-action as integer )  FORWARD.
     1411   FUNCTION get-source-type RETURNS CHARACTER
     1412     ( p-source-type as character )  FORWARD.
     1413   FUNCTION get-subject RETURNS CHARACTER
     1414     ( p-subject as character )  FORWARD.
     1415   FUNCTION local-open-br RETURNS logical
     1416     (  p-open-query     as logical    ,
     1417     p-find-next       as logical    ,
     1418     p-find-condition as character )  FORWARD.
     1419   DEFINE BUTTON B-Help
     1420        LABEL "Помо&щь"
     1421        SIZE 3 BY 1
     1422        BGCOLOR 8 .
     1423   DEFINE BUTTON B-mark
     1424        LABEL "&*"
     1425        SIZE 3 BY 1.
     1426   DEFINE BUTTON B-print
     1427        LABEL "Пе&чать"
     1428        SIZE 3 BY 1.
     1429   DEFINE BUTTON b-quit AUTO-END-KEY
     1430        LABEL "&Выход"
     1431        SIZE 10 BY 1
     1432        BGCOLOR 8 .
     1433   DEFINE BUTTON b-reason
     1434        LABEL "&Причина"
     1435        SIZE 10 BY 1.
     1436   DEFINE BUTTON B-sch
     1437        LABEL "&Фильтр"
     1438        SIZE 3 BY 1.
     1439   DEFINE BUTTON b-sel AUTO-GO
     1440        LABEL "Вы&бор"
     1441        SIZE 10 BY 1
     1442        BGCOLOR 8 .
     1443   DEFINE BUTTON b-nextlevel
     1444        LABEL "Детали"
     1445        SIZE 10 BY 1
     1446        BGCOLOR 8 .
     1447   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1448         VIEW-AS TEXT
     1449        SIZE 6 BY 1
     1450        FGCOLOR 4  NO-UNDO.
     1451   DEFINE VARIABLE sch-obj-code AS CHARACTER FORMAT "X(50)":U
     1452        LABEL "коду"
     1453        VIEW-AS FILL-IN
     1454        SIZE 10 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1455   DEFINE VARIABLE sch-corr-date AS DATE FORMAT "99/99/9999":U
     1456        LABEL "Дате изменения"
     1457        VIEW-AS FILL-IN
     1458        SIZE 11 BY 1 NO-UNDO.
     1459   DEFINE VARIABLE sch-corr-user-name AS CHARACTER FORMAT "X(9)":U
     1460        LABEL "пользователю"
     1461        VIEW-AS FILL-IN
     1462        SIZE 12 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1463   DEFINE VARIABLE sch-db-num AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1464        LABEL "БД"
     1465        VIEW-AS FILL-IN
     1466        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1467   DEFINE VARIABLE v-corr-user-db-num AS INTEGER FORMAT ">>>>9":U INITIAL 0
     1468        LABEL "по БД"
     1469        VIEW-AS FILL-IN
     1470        SIZE 6 BY 1 NO-UNDO.
     1471   DEFINE QUERY BR-changes FOR
     1472         temp-changes SCROLLING.
     1473   DEFINE QUERY br-obj-hist FOR
     1474         X_c-obj-hist SCROLLING.
     1475   DEFINE BROWSE BR-changes
     1476     QUERY BR-changes DISPLAY
     1477         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(200)" width 40
     1478   temp-changes.v_old COLUMn-LABEL "Было" format "X(255)"
     1479   temp-changes.v_new COLUMn-LABEL "Стало" format "X(255)"
     1480       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.25.
     1481   DEFINE BROWSE br-obj-hist
     1482     QUERY br-obj-hist NO-LOCK DISPLAY
     1483         mark-string(recid(X_c-obj-hist), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1484         X_c-obj-hist.db-num   COLUMN-LABEL 'БД' WIDTH 4
     1485                       X_c-obj-hist.doc-code COLUMN-LABEL 'Код заказа'
     1486         X_c-obj-hist.corr-date FORMAT "99/99/9999":U COLUMN-LABEL "Дата изм."
     1487         string(X_c-obj-hist.corr-time, "HH:MM:SS":U) COLUMN-LABEL "Время изм." FORMAT "X(8)":U
     1488         usrfulnf(X_c-obj-hist.corr-user-name) COLUMn-LABEL "Изменил" FORMAT "X(255)":U width 18
     1489         get-action(X_c-obj-hist.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1490         X_c-obj-hist.corr-user-db-num FORMAT ">>>>9":U COLUMN-LABEL "Дб!созд."
     1491         X_c-obj-hist.is-news FORMAT "+/":U COLUMN-LABEL "Прием.!нов."
     1492         get-source-type(X_c-obj-hist.source-type) COLUMN-LABEL "Источн.!измен." WIDTH 7
     1493         X_c-obj-hist.source-ref FORMAT "X(20)":U COLUMN-LABEL "Ссылка на!источник." WIDTH 9
     1494          get-subject(X_c-obj-hist.subject) COLUMN-LABEL "Предмет изменения" FORMAT "X(35)":U WIDTH 15
     1495     ENABLE
     1496         X_c-obj-hist.corr-date
     1497       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.46.
     1498   DEFINE FRAME Dialog-Frame
     1499        b-quit AT ROW 1 COL 1
     1500        B-mark AT ROW 1 COL 11
     1501        b-sel AT ROW 1 COL 21
     1502        v-corr-user-db-num AT ROW 1 COL 37 COLON-ALIGNED
     1503        b-nextlevel AT ROW 1 COL 70
     1504        b-reason AT ROW 1 COL 59
     1505        B-print AT ROW 1 COL 89
     1506        B-sch AT ROW 1 COL 92
     1507        B-Help AT ROW 1 COL 95
     1508        br-obj-hist AT ROW 2 COL 1
     1509        sch-db-num AT ROW 13.63 COL 60.13 COLON-ALIGNED
     1510        sch-corr-date AT ROW 13.63 COL 85.75 COLON-ALIGNED
     1511        sch-obj-code AT ROW 13.67 COL 45.13 COLON-ALIGNED
     1512        sch-corr-user-name AT ROW 13.71 COL 22.5 COLON-ALIGNED
     1513        BR-changes AT ROW 14.79 COL 1
     1514        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1515        "ПОИСК ПО" VIEW-AS TEXT
     1516             SIZE 8.38 BY 1 AT ROW 13.63 COL 1.38
     1517             FGCOLOR 4
     1518        SPACE(89.48) SKIP(7.44)
     1519       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1520            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1521            TITLE
     1522            vLabel
     1523            CANCEL-BUTTON b-quit.
     1524   ASSIGN
     1525          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1526          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1527   ASSIGN
     1528          br-obj-hist:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     1529   ON GO OF FRAME Dialog-Frame
     1530   DO:
     1531     p-rid-list = v-rid-list.
     1532   END.
     1533   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1534   DO:
     1535     APPLY "END-ERROR":U TO SELF.
     1536   END.
     1537   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1538   DO:
     1539   define variable loc#log as logical no-undo .
     1540     if available X_c-obj-hist then do:
     1541   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1542   define variable v-str-recid15 as character no-undo .
     1543   define variable v-num-entry15 as integer   no-undo .
     1544   assign
     1545     v-str-recid15 = trim( string( recid( X_c-obj-hist ) , "->>>>>>>>>>>9":U ) )
     1546     v-num-entry15 = lookup( v-str-recid15 , v-rid-list )
     1547   .
     1548   if v-num-entry15 > 0 then do:
     1549     assign
     1550       entry( v-num-entry15, v-rid-list ) = "":U
     1551       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1552     .
     1553   end.
     1554   else do:
     1555     assign
     1556       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid15
     1557     .
     1558   end.
     1559       loc#log = br-obj-hist:refresh() .
     1560       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1561           loc#log = br-obj-hist:select-next-row ().
     1562           apply "VALUE-CHANGED" to br-obj-hist in frame Dialog-Frame.
     1563       end.
     1564       if num-entries( v-rid-list ) = 0
     1565       then
     1566           hide mark-num in frame Dialog-Frame.
     1567       else
     1568           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1569     end.
     1570     apply "entry" to br-obj-hist in frame Dialog-Frame.
     1571   END.
     1572   ON CHOOSE OF b-nextlevel IN FRAME Dialog-Frame
     1573   DO:
     1574      define variable vRun as character no-undo.
     1575      vRun = this-procedure:file-name.
     1576      vRun = "ref/cordhistone.w".
