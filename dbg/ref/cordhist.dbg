      655   procedure prn-lib-prn-file :
      656     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      657     define input parameter p-DIsabledoptions as integer no-undo .
      658     define variable v-report-name as character no-undo .
      659     define variable v-user-action as character no-undo .
      660     define variable v-printed     as logical   no-undo .
      661     define variable v-exist       as logical   no-undo .
