        1   block-level on error undo, throw.
        2   define input-output parameter par-rid as recid no-undo .
        3   define input parameter par-mode as character no-undo .
        4   define input parameter p-silent as logical no-undo .
        5   define input parameter p-gds-code like ub.fbr-gds-obj.gds-code no-undo .
        6   define input parameter p-obj-type like ub.fbr-gds-obj.obj-type no-undo .
        7   define input parameter p-obj-code like ub.fbr-gds-obj.obj-code no-undo .
        8   define input parameter p-fbr-grp-code like ub.fbr-gds-obj.fbr-grp-code no-undo .
        9   define input parameter p-fbr-obj-type like ub.fbr-gds-obj.fbr-obj-type no-undo .
       10   define input parameter p-fbr-obj-code like ub.fbr-gds-obj.fbr-obj-code no-undo .
       11   define input parameter p-is-cd like ub.fbr-gds-obj.is-cd no-undo .
       12   define input parameter p-is-menu like ub.fbr-gds-obj.is-menu no-undo .
       13   define input parameter p-is-modificator like ub.fbr-gds-obj.is-modificator no-undo .
       14   define input parameter p-is-null-price like ub.fbr-gds-obj.is-null-price no-undo .
       15   define input parameter p-is-season like ub.fbr-gds-obj.is-season no-undo .
       16   define input parameter p-is-semi-finished like ub.fbr-gds-obj.is-semi-finished no-undo .
       17   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       18   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       19   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       20   define variable vss-workfile    as character no-undo init "$Workfile: fgdsobj1.p $":U .
       21   define variable vss-archive     as character no-undo init "$Archive: ref/fgdsobj1.p $":U .
       22   define variable vss-description as character no-undo init "Атрибуты товара на объекте-РЕСТОРАН".
       23   procedure vss-get-info :
       24     define output parameter p-vss-revision    like vss-revision    no-undo .
       25     define output parameter p-vss-author      like vss-author      no-undo .
       26     define output parameter p-vss-date        like vss-date        no-undo .
       27     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       28     define output parameter p-vss-archive     like vss-archive     no-undo .
       29     define output parameter p-vss-description like vss-description no-undo .
       30     assign
       31       p-vss-revision    = vss-revision
       32       p-vss-author      = vss-author
       33       p-vss-date        = vss-date
       34       p-vss-workfile    = vss-workfile
       35       p-vss-archive     = vss-archive
       36       p-vss-description = vss-description
       37     .
       38   end procedure.
       39   procedure vss-get-parameters :
       40     define output parameter p-vss-parameters as character no-undo .
       41   end procedure.
       42   define new global shared variable g#vssrevis-logger as handle    no-undo .
       43   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       44   define variable v-vssrevis-logger                   as handle    no-undo .
       45   procedure vss-logevent :
       46     define input  parameter p-extra-paramters as character no-undo .
       47     define variable v-vssrevis-parameters as character no-undo .
       48     do
       49     on error undo, return error return-value
       50     :
       51       if  valid-handle(v-vssrevis-logger)
       52       and v-vssrevis-logger :get-signature("logevent") <> ""
       53       then do:
       54         run vss-get-parameters in this-procedure
       55           (output v-vssrevis-parameters
       56           ).
       57         run logevent in v-vssrevis-logger
       58           (input vss-workfile
       59           ,input vss-revision
       60           ,input v-vssrevis-parameters
       61           ,input p-extra-paramters
       62           ).
       63       end.
       64     end.
       65   end procedure.
       66   assign
       67     v-vssrevis-logger = g#vssrevis-logger
       68   .
       69   if  valid-handle(v-vssrevis-logger)
       70   and v-vssrevis-logger :get-signature("logevent") <> ""
       71   then do:
       72     assign
       73       v-vssrevis-logevent = true
       74     .
       75     run vss-logevent in this-procedure (input vss-description) .
       76   end.
       77   define new global shared variable g#language as character no-undo .
       78   if g#language <> '' and g#language <> 'rus':U then do:
       79     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       80   end.
       81   define new global shared variable g#library  as handle no-undo .
       82   define new global shared variable g#library2 as handle no-undo .
       83   define variable var-entry as character no-undo .
       84   define variable v-db-num like ub.db.db-num no-undo .
       85   define variable v-rec as recid no-undo .
       86   define variable v-old-is-menu like ub.fbr-gds-obj.is-menu no-undo .
       87   define variable v-old-is-semi-finished like ub.fbr-gds-obj.is-semi-finished no-undo .
       88   define variable v-b-code like ub.bar-code.b-code no-undo .
       89   define variable v-price-sale like ub.price-list.price-sale no-undo .
       90   define variable v-excise like ub.price-list.excise no-undo .
       91   define variable v-road-tax like ub.price-list.road-tax no-undo .
       92   define variable v-doc-num like ub.price-list.doc-num no-undo .
       93   define variable v-chg-fbr as logical no-undo .
       94   define variable v-mes as character no-undo .
       95   define buffer buf_clients for ub.clients.
       96   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
       97   define buffer buf_fbr-gds-grp for ub.fbr-gds-grp.
       98   define buffer buf_goods for ub.goods.
       99   define buffer buf_shop for ub.shop.
      100   if par-mode <> 'ДОБАВЛЕНИЕ':U AND par-mode <> 'ИЗМЕНЕНИЕ':U then do:
      101     message vss-workfile vss-revision vss-description skip
      102             "Неверный параметр par-mode - " par-mode
      103     view-as alert-box error .
      104     return error '':u.
      105   end.
      106   find first buf_goods no-lock where
      107              buf_goods.gds-code = p-gds-code no-error .
      108   if p-gds-code = 0
      109   or not available buf_goods
      110   then do:
      111     assign
      112     var-entry = "gds-code":U
      113     v-mes = "Не указан товар"
      114     .
      115     run do-message in this-procedure (var-entry, input-output v-mes).
      116     undo, return error (if p-silent then var-entry else v-mes).
      117   end.
      118   find first buf_clients no-lock where
      119             buf_clients.obj-type = p-obj-type
      120        AND  buf_clients.obj-code = p-obj-code no-error .
      121   if p-obj-type = "":u
      122   or p-obj-code = 0
      123   or not available buf_clients
      124   then do:
      125     assign
      126     var-entry = "obj-code":U
      127     v-mes = substitute("Не найден объект &1&2", p-obj-type, p-obj-code)
      128     .
      129     run do-message in this-procedure (var-entry, input-output v-mes).
      130     undo, return error (if p-silent then var-entry else v-mes).
      131   end.
      132   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      134     (output v-db-num
      135     )  .
      136   if buf_clients.db-num <> v-db-num then do:
      137     assign
      138     var-entry = "obj-code":U
      139     v-mes = substitute("Изменения атрибута товара РЕСТОРАН возможны только на БД объекта: БД объекта &1&2 &3, текущая БД &4"
      140                        ,p-obj-type
      141                        ,p-obj-code
      142                        ,buf_Clients.db-num
      143                        ,v-db-num)
      144     .
      145     run do-message in this-procedure (var-entry, input-output v-mes).
      146      undo, return error (if p-silent then var-entry else v-mes).
      147   end.
      148   if LOOKUP(p-obj-type, ('маг':U + chr(44) + 'скл':U)) = 0 then do:
      149     assign
      150     var-entry = "obj-type":U
      151     v-mes = substitute("Атрибут товара РЕСТОРАН может быть определен только для объекта типа &1 или &2"
      152                        , 'маг':U
      153                        , 'скл':U)
      154     .
      155     run do-message in this-procedure (var-entry, input-output v-mes).
      156     undo, return error (if p-silent then var-entry else v-mes).
      157   end.
      158   find first buf_clients no-lock where
      159             buf_clients.obj-type = p-fbr-obj-type
      160        AND  buf_clients.obj-code = p-fbr-obj-code no-error .
      161   if (p-fbr-obj-type = "":u
      162   or p-fbr-obj-code = 0
      163   or not available buf_clients)
      164   and (p-is-menu = yes or
      165        p-is-semi-finished = yes)
      166   then do:
      167     assign
      168     var-entry = "fbr-obj-code":U
      169     v-mes = substitute("для блюда меню и для полуфабриката должен быть определен объект-КУХНЯ")
      170     .
      171     run do-message in this-procedure (var-entry, input-output v-mes).
      172     undo, return error (if p-silent then var-entry else v-mes).
      173   end.
      174   if p-fbr-obj-type <> "":U and
      175   p-fbr-obj-type <> 'маг':U then do:
      176     assign
      177     var-entry = "fbr-obj-type":U
      178     v-mes = substitute("Для атрибута товара РЕСТОРАН кухней может быть только объект типа &1", 'маг':U)
      179     .
      180     run do-message in this-procedure (var-entry, input-output v-mes).
      181     undo, return error (if p-silent then var-entry else v-mes).
      182   end.
      183   if p-fbr-grp-code <> 0 then do:
      184     find first buf_fbr-gds-grp  no-lock
      185          where buf_fbr-gds-grp.obj-type   = p-obj-type
      186            and buf_fbr-gds-grp.obj-code   = p-obj-code
      187            and buf_fbr-gds-grp.node-code  = p-fbr-grp-code
      188     no-error .
      189     if not available buf_fbr-gds-grp then do:
      190       assign
      191       var-entry = "fbr-grp-code":U
      192       v-mes  = substitute("Не найдена группа меню с кодом &1 для &2&3", p-fbr-grp-code, p-obj-type, p-obj-code)
      193       .
      194       run do-message in this-procedure (var-entry, input-output v-mes).
      195       undo, return error (if p-silent then var-entry else v-mes).
      196     end.
      197   end.
      198   if p-fbr-grp-code <> 0
      199   or p-is-cd
      200   then do:
      201     find first buf_shop no-lock where
      202               buf_shop.obj-code = p-obj-code .
      203     if (buf_shop.is-kitchen or
      204     buf_shop.is-kitchen-store)
      205     and not buf_shop.is-catering then do:
      206       assign
      207       var-entry =  (if p-fbr-grp-code <> 0
      208                     then "fbr-grp-code":U
      209                     else "fbr-obj-code":U)
      210       v-mes = substitute("Нельзя определять признаки ГРУППА МЕНЮ и/или ОТПРАВЛЯТЬ НА КАССУ для магазина,&1" +
      211                          "который имеет признаки КУХНЯ и/или СКЛАД КУХНИ" +
      212                          "и не является РЕСТОРАНОМ"
      213                          , chr(10))
      214       .
      215       run do-message in this-procedure (var-entry, input-output v-mes).
      216       undo, return error (if p-silent then var-entry else v-mes).
      217     end.
      218   end.
      219   if p-is-menu and p-is-semi-finished then do:
      220     assign
      221     var-entry = "is-semi-finished"
      222     v-mes = "Товар не может одновременно является блюдом меню и полуфабрикатом"
      223     .
      224     run do-message in this-procedure (var-entry, input-output v-mes).
      225     undo, return error (if p-silent then var-entry else v-mes).
      226   end.
      227   if p-is-semi-finished and p-is-modificator then do:
      228     assign
      229     var-entry = "is-menu"
      230     v-mes = "Товар не может одновременно является полуфабрикатом и модификатором"
      231     .
      232     run do-message in this-procedure (var-entry, input-output v-mes).
      233     undo, return error (if p-silent then var-entry else v-mes).
      234   end.
      235   if p-is-null-price = yes then do:
      236   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      237     (input  p-gds-code
      238     ,input  ?
      239     ,output v-b-code
      240     )  .
      241   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      242   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
      243     (input  p-obj-type
      244     ,input  p-obj-code
      245     ,input  v-b-code
      246     ,input  v-b-code
      247     ,input  0
      248     ,output v-doc-num
      249     ,output v-price-sale
      250     ,output v-road-tax
      251     ,output v-excise
      252     ) no-error .
      253    if v-price-sale <> 0 and v-price-sale <> ? then do:
      254       assign
      255       var-entry = "is-null-price":U.
      256       v-mes = "Товар имеет цену на объекте - нельзя установить для него свойство БЕЗ ЦЕНЫ"
      257       .
      258       run do-message in this-procedure (var-entry, input-output v-mes).
      259       undo, return error (if p-silent then var-entry else v-mes).
      260    end.
      261   end.
      262   _main:
      263   do
      264   on error undo _main, return error
      265   :
      266     CASE par-mode:
      267       when 'ДОБАВЛЕНИЕ':U then do:
      268         find first buf_fbr-gds-obj no-lock where
      269                    buf_fbr-gds-obj.gds-code = p-gds-code
      270                AND buf_fbr-gds-obj.obj-type = p-obj-type
      271                AND buf_fbr-gds-obj.obj-code = p-obj-code no-error .
      272         if available buf_fbr-gds-obj then do:
      273           assign
      274           var-entry = "gds-code"
      275           v-mes = "уже определены атрибуты товара на объекте-РЕСТОРАН"
      276           .
      277           run do-message in this-procedure (var-entry, input-output v-mes).
      278           undo, return error (if p-silent then var-entry else v-mes).
      279         end.
      280         create ub.fbr-gds-obj.
      281         assign
      282         v-chg-fbr = yes
      283         .
      284       end.
      285       when 'ИЗМЕНЕНИЕ':U then do:
      286         find first ub.fbr-gds-obj exclusive-lock where
      287                   recid(ub.fbr-gds-obj) = par-rid no-error .
      288         if not available ub.fbr-gds-obj
      289         then do:
      290           assign
      291           var-entry = "gds-code":U
      292           v-mes = "Нечего редактировать: не определены атрибуты товара на объекте-РЕСТОРАН"
      293           .
      294           run do-message in this-procedure (var-entry, input-output v-mes).
      295           undo, return error (if p-silent then var-entry else v-mes).
      296         end.
      297         IF ub.fbr-gds-obj.obj-type <> p-obj-type
      298         OR ub.fbr-gds-obj.obj-code <> p-obj-code
      299         then do:
      300           assign
      301           var-entry = "obj-code":U
      302           v-mes = "Нельзя изменить объект, на котором определены атрибуты товара-РЕСТОРАН"
      303           .
      304           run do-message in this-procedure (var-entry, input-output v-mes).
      305           undo, return error (if p-silent then var-entry else v-mes).
      306         end.
      307         IF ub.fbr-gds-obj.gds-code <> p-gds-code
      308         then do:
      309           assign
      310           var-entry = "gds-code":U
      311           v-mes = "Нельзя изменить товар, для которого определены атрибуты товара РЕСТОРАН"
      312           .
      313           run do-message in this-procedure (var-entry, input-output v-mes).
      314           undo, return error (if p-silent then var-entry else v-mes).
      315         end.
      316         if ub.fbr-gds-obj.fbr-obj-type <> p-fbr-obj-type
      317         OR ub.fbr-gds-obj.fbr-obj-code <> p-fbr-obj-code
      318         then do:
      319           assign
      320           v-chg-fbr = yes
      321           .
      322         end.
      323       end.
      324     END CASE.
      325     assign
      326     v-old-is-menu = ub.fbr-gds-obj.is-menu
      327     v-old-is-semi-finished = ub.fbr-gds-obj.is-semi-finished
      328     ub.fbr-gds-obj.gds-code = p-gds-code
      329     ub.fbr-gds-obj.obj-type = p-obj-type
      330     ub.fbr-gds-obj.obj-code = p-obj-code
      331     ub.fbr-gds-obj.fbr-grp-code = p-fbr-grp-code
      332     ub.fbr-gds-obj.fbr-obj-type = p-fbr-obj-type
      333     ub.fbr-gds-obj.fbr-obj-code = p-fbr-obj-code
      334     ub.fbr-gds-obj.is-cd = p-is-cd
      335     ub.fbr-gds-obj.is-menu = p-is-menu
      336     ub.fbr-gds-obj.is-modificator= p-is-modificator
      337     ub.fbr-gds-obj.is-null-price = p-is-null-price
      338       ub.fbr-gds-obj.is-season = p-is-season
      339     ub.fbr-gds-obj.is-semi-finished = p-is-semi-finished
      340     par-rid = recid(ub.fbr-gds-obj)
      341     .
      342     if v-chg-fbr then do:
      343       for each buf_fbr-gds-obj exclusive-lock where
      344               buf_fbr-gds-obj.gds-code = ub.fbr-gds-obj.gds-code,
      345           first buf_clients no-lock where
      346                buf_clients.obj-type = buf_fbr-gds-obj.obj-type
      347            AND buf_clients.obj-code = buf_fbr-gds-obj.obj-code
      348            AND buf_clients.db-num = v-db-num
      349       on error undo _main, return error "fbr-obj-code":U
      350       on stop undo _main, return error "fbr-obj-code":U
      351            :
      352         assign
      353         buf_fbr-gds-obj.fbr-obj-type = ub.fbr-gds-obj.fbr-obj-type
      354         buf_fbr-gds-obj.fbr-obj-code = ub.fbr-gds-obj.fbr-obj-code
      355         .
      356       end.
      357     end.
      358     release ub.fbr-gds-obj no-error .
      359     if error-status:error then do:
      360       assign
      361       var-entry = "":U
      362       v-mes = substitute("Ошибка при сохранении записи Атрибуты товара РЕСТОРАН:&1&2 &3"
      363                          , chr(10)
      364                          , error-status:get-message(1)
      365                          , return-value )
      366       .
      367       run do-message in this-procedure (var-entry, input-output v-mes).
      368       undo, return error (if p-silent then var-entry else v-mes).
      369     end.
      370   end.
      371   procedure do-message :
      372   define input parameter p-entry as character no-undo .
      373   define input-output parameter p-mes as character no-undo .
      374     do
      375     on error undo, return error
      376     :
      377      assign
      378      p-mes = substitute("Атрибут товара РЕСТОРАН: товар с кодом &1 &2&3: &4"
      379                         , p-gds-code
      380                         , p-obj-type
      381                         , p-obj-code
      382                         , p-mes).
      383      if p-silent = no then do:
      384        message
      385        p-mes view-as alert-box error.
      386      end.
      387     end.
      388   end procedure.
