        1   block-level on error undo, throw.
        2   define input parameter p-obj-type like ub.c-pmp-hist.obj-type no-undo .
        3   define input parameter p-obj-code like ub.c-pmp-hist.obj-code no-undo .
        4   define input parameter p-pump-code like ub.c-pmp-hist.pl-code no-undo .
        5   define input parameter p-chip-num like ub.c-pmp-hist.chip-num no-undo .
        6   define input parameter p-corr-user-db-num like ub.c-pmp-hist.corr-user-db-num no-undo .
        7   define input parameter p-subject like ub.c-pmp-hist.subject no-undo .
        8   define input parameter p-action   like ub.c-pmp-hist.action no-undo .
        9   define input parameter p-silent  as logical no-undo .
       10   define output parameter p-description as character no-undo .
       11   define variable  vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       12   define variable  vss-author      as character no-undo init "$Author: expertek $":U .
       13   define variable  vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       14   define variable  vss-workfile    as character no-undo init "$Workfile: cpmphisv.p $":U .
       15   define variable  vss-archive     as character no-undo init "$Archive: ref/cpmphisv.p $":U .
       16   define variable  vss-description as character no-undo init "Заполнение временной таблицы для показа изменений по таблицам истории ТРК".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   procedure pumpattr-name :
       77   do
       78     on error undo, return error
       79     :
       80     define input  parameter p-code           as character no-undo .
       81     define output parameter p-type           as character no-undo .
       82     define output parameter p-format         as character no-undo .
       83     define output parameter p-label          as character no-undo .
       84     define output parameter p-user-can-edit  as logical   no-undo .
       85     define output parameter p-output-display as logical   no-undo .
       86     define output parameter p-other          as character no-undo .
       87       case p-code :
       88               when 'net-address':U then do:     assign     p-label = "Сетевой адрес КТРК"     p-type = 'C':U      p-format = "X(15)"     p-label = "Сетевой адрес КТРК"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
       89               when 'protocol-id':U then do:     assign     p-label = "Идентификатор протокола КТРК"     p-type = 'I':U      p-format = "99999"     p-label = "Идентификатор протокола КТРК"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
       90               when 'UART-channel-no':U then do:     assign     p-label = "№ канала UART"     p-type = 'I':U      p-format = "9"     p-label = "№ канала UART"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
       91               when 'no-overr-cnt-use':U then do:     assign     p-label = "Признак исп-я необнуляемых счетчиков"     p-type = 'L':U      p-format = "yes/no"     p-label = "Признак исп-я необнуляемых счетчиков"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
       92               when 'tech-refuell-calc-use':U then do:     assign     p-label = "Признак расчета аварийного пролива"     p-type = 'L':U      p-format = "yes/no"     p-label = "Признак расчета аварийного пролива"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
       93               when 'velocity-id':U then do:     assign     p-label = "Идентификатор скорости"     p-type = 'I':U      p-format = "99999"     p-label = "Идентификатор скорости"     p-user-can-edit  = false     p-output-display = false     p-other = ""      .   end.
       94         otherwise do:
       95           undo, return error "неизвестный атрибут ТРК" + " " + p-code .
       96         end.
       97       end.
       98     end.
       99   end procedure.
      100   procedure pumpattr-tooltip :
      101   do
      102     on error undo, return error
      103     :
      104       define input  parameter p-code    as character no-undo .
      105       define output parameter p-tooltip as character no-undo .
      106       define output parameter p-label   as character no-undo .
      107       case p-code :
      108               when 'net-address':U then do:     assign     p-tooltip = "Сетевой адрес КТРК"     p-label = "Сетевой адрес КТРК" .   end.
      109               when 'protocol-id':U then do:     assign     p-tooltip = "Идентификатор протокола КТРК"     p-label = "Идентификатор протокола КТРК" .   end.
      110               when 'UART-channel-no':U then do:     assign     p-tooltip = "№ канала UART"     p-label = "№ канала UART" .   end.
      111               when 'no-overr-cnt-use':U then do:     assign     p-tooltip = "Признак исп-я необнуляемых счетчиков"     p-label = "Признак исп-я необнуляемых счетчиков" .   end.
      112               when 'tech-refuell-calc-use':U then do:     assign     p-tooltip = "Признак расчета аварийного пролива"     p-label = "Признак расчета аварийного пролива" .   end.
      113               when 'velocity-id':U then do:     assign     p-tooltip = "Идентификатор скорости"     p-label = "Идентификатор скорости" .   end.
      114         otherwise do:
      115           undo, return error "Неизвестный атрибут ТРК" + " " + p-code .
      116         end.
      117       end.
      118     end.
      119   end procedure.
      120   procedure pumpattr-value :
      121    do
      122     on error undo, return error
      123     :
      124       define input  parameter p-code     like ub.pump-attr.attr-code  no-undo .
      125       define input  parameter p-obj-type like ub.pump-attr.obj-type   no-undo .
      126       define input  parameter p-obj-code like ub.pump-attr.obj-code   no-undo .
      127       define input  parameter p-pump-code like ub.pump-attr.pump-code   no-undo .
      128       define output parameter p-value    like ub.pump-attr.attr-value no-undo .
      129       define output parameter p-type     as character no-undo .
      130       define buffer buf_pump-attr for ub.pump-attr .
      131       def var v-format         as character no-undo .
      132       def var v-label          as character no-undo .
      133       def var v-user-can-edit  as logical   no-undo .
      134       def var v-output-display as logical   no-undo .
      135       def var v-other          as character no-undo .
      136       run pumpattr-name in this-procedure
      137         (input  p-code
      138         ,output p-type
      139         ,output v-format
      140         ,output v-label
      141         ,output v-user-can-edit
      142         ,output v-output-display
      143         ,output v-other
      144         ) no-error .
      145       if error-status :error then do:
      146         undo, return error return-value .
      147       end.
      148       find first buf_pump-attr no-lock where
      149                  buf_pump-attr.obj-type  = p-obj-type
      150              AND buf_pump-attr.obj-code  = p-obj-code
      151              AND buf_pump-attr.pump-code  = p-pump-code
      152              AND buf_pump-attr.attr-code = p-code
      153         no-error .
      154       if avail buf_pump-attr then do:
      155         assign
      156           p-value =  buf_pump-attr.attr-value
      157         .
      158       end.
      159       else do:
      160         assign
      161           p-value = if p-type = 'L':U then "no":U else ""
      162         .
      163       end.
      164     end.
      165   end procedure.
      166   procedure pumpattr-write :
      167     do
      168     on error undo, return error
      169     :
      170       define input parameter p-obj-type like ub.pump-attr.obj-type   no-undo .
      171       define input parameter p-obj-code like ub.pump-attr.obj-code   no-undo .
      172       define input parameter p-pump-code like ub.pump-attr.pump-code   no-undo .
      173       define input parameter p-code     like ub.pump-attr.attr-code  no-undo .
      174       define input parameter p-value    like ub.pump-attr.attr-value no-undo .
      175       define buffer buf_pump-attr for ub.pump-attr .
      176       define buffer lock_pump-attr for ub.pump-attr .
      177       def var v-type           as character no-undo .
      178       def var v-format         as character no-undo .
      179       def var v-label          as character no-undo .
      180       def var v-user-can-edit  as logical   no-undo .
      181       def var v-output-display as logical   no-undo .
      182       def var v-other          as character no-undo .
      183       run pumpattr-name in this-procedure
      184         (input  p-code
      185         ,output v-type
      186         ,output v-format
      187         ,output v-label
      188         ,output v-user-can-edit
      189         ,output v-output-display
      190         ,output v-other
      191         ) no-error .
      192       if error-status :error then do:
      193         undo, return error return-value .
      194       end.
      195       find first buf_pump-attr exclusive-lock where
      196                  buf_pump-attr.obj-type  = p-obj-type
      197              AND buf_pump-attr.obj-code  = p-obj-code
      198              AND buf_pump-attr.pump-code  = p-pump-code
      199              AND buf_pump-attr.attr-code = p-code no-error .
      200       if not available buf_pump-attr then do:
      201         create buf_pump-attr .
      202         assign
      203           buf_pump-attr.pump-code  = p-pump-code
      204           buf_pump-attr.obj-type  = p-obj-type
      205           buf_pump-attr.obj-code  = p-obj-code
      206           buf_pump-attr.attr-code = p-code
      207           buf_pump-attr.attr-value = p-value no-error
      208         .
      209       end.
      210       ELSE
      211       ASSIGN
      212       buf_pump-attr.attr-value = p-value no-error.
      213     end.
      214   end procedure.
      215   procedure pumpattr-exist :
      216     do
      217     on error undo, return error
      218     :
      219       define input parameter p-obj-type like ub.pump-attr.obj-type   no-undo .
      220       define input parameter p-obj-code like ub.pump-attr.obj-code   no-undo .
      221       define input parameter p-pump-code like ub.pump-attr.pump-code   no-undo .
      222       define input parameter p-code     like ub.pump-attr.attr-code  no-undo .
      223       define output parameter p-exist    as logical no-undo .
      224       define buffer buf_pump-attr for ub.pump-attr .
      225       def var v-type           as character no-undo .
      226       def var v-format         as character no-undo .
      227       def var v-label          as character no-undo .
      228       def var v-user-can-edit  as logical   no-undo .
      229       def var v-output-display as logical   no-undo .
      230       def var v-other          as character no-undo .
      231       run pumpattr-name in this-procedure
      232         (input  p-code
      233         ,output v-type
      234         ,output v-format
      235         ,output v-label
      236         ,output v-user-can-edit
      237         ,output v-output-display
      238         ,output v-other
      239         ) no-error .
      240       if error-status :error then do:
      241         undo, return error return-value .
      242       end.
      243       find first buf_pump-attr no-lock where
      244                  buf_pump-attr.obj-type  = p-obj-type
      245              AND buf_pump-attr.obj-code  = p-obj-code
      246              AND buf_pump-attr.pump-code  = p-pump-code
      247              AND buf_pump-attr.attr-code = p-code no-error .
      248       if available buf_pump-attr then do:
      249         P-EXIST = YES.
      250       end.
      251     end.
      252   end procedure.
      253   procedure pumpattr-delete :
      254     do
      255     on error undo, return error
      256     :
      257       define input parameter p-obj-type like ub.pump-attr.obj-type   no-undo .
      258       define input parameter p-obj-code like ub.pump-attr.obj-code   no-undo .
      259       define input parameter p-pump-code like ub.pump-attr.pump-code   no-undo .
      260       define input parameter p-code     like ub.pump-attr.attr-code  no-undo .
      261       define output parameter p-deleted  as logical no-undo .
      262       define buffer buf_pump-attr for ub.pump-attr .
      263       def var v-type           as character no-undo .
      264       def var v-format         as character no-undo .
      265       def var v-label          as character no-undo .
      266       def var v-user-can-edit  as logical   no-undo .
      267       def var v-output-display as logical   no-undo .
      268       def var v-other          as character no-undo .
      269       run pumpattr-name in this-procedure
      270         (input  p-code
      271         ,output v-type
      272         ,output v-format
      273         ,output v-label
      274         ,output v-user-can-edit
      275         ,output v-output-display
      276         ,output v-other
      277         ) no-error .
      278       if error-status :error then do:
      279         undo, return error return-value .
      280       end.
      281       find first buf_pump-attr exclusive-lock where
      282                  buf_pump-attr.obj-type  = p-obj-type
      283              AND buf_pump-attr.obj-code  = p-obj-code
      284              AND buf_pump-attr.pump-code  = p-pump-code
      285              AND buf_pump-attr.attr-code = p-code no-error .
      286       if not available buf_pump-attr then do:
      287         P-DELETED = NO.
      288       end.
      289       ELSE DO:
      290          delete buf_pump-attr.
      291          P-DELETED = YES.
      292       END.
      293     end.
      294   end procedure.
      295   define variable v-chg-fields as character no-undo.
      296   define variable v-old-fields as character no-undo.
      297   define variable v-new-fields as character no-undo.
      298   define variable ii as integer no-undo.
      299   define variable v-mess as character no-undo .
      300   define buffer buf_c-pmp-hist for ub.c-pmp-hist.
      301   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      302   define SHARED temp-table temp-changes no-undo
      303   field f_name as character
      304   field l_name as character
      305   field v_old as character
      306   field v_new as character
      307   field t_name as character
      308   field num_ as integer
      309   field uniq-key-rec as character
      310   field action as integer
      311   field fNotChange as logical
      312   index pi is unique primary
      313   num_
      314   t_name
      315   f_name
      316   index
      317   Chan
      318   fnotChange
      319   t_name
      320   f_name
      321   index imain uniq-key-rec
      322   .
      323   FUNCTION get-all-fields returns character (p-file-name as character ):
      324   define variable v-dop as character no-undo .
      325     find first _file no-lock where _file._file-name = p-file-name no-error .
      326     if not available _file then return "":U.
      327     for each _field no-lock where
      328              _field._file-recid = recid(_file) :
      329       assign
      330       v-dop = v-dop + _field._field-name + chr(44)
      331       .
      332     end.
      333     return trim(v-dop).
      334   END FUNCTION.
      335   PROCEDURE proc-full-temp-changes :
      336     define input  parameter p-act-create as logical   no-undo .
      337     define input  parameter p-act-delete as logical   no-undo .
      338     define input  parameter p-hst-handle as handle    no-undo .
      339     define input  parameter p-main-table as character no-undo .
      340     define input  parameter p-field-list as character no-undo .
      341     define input  parameter p-label-form as character no-undo .
      342     define variable h-new-buf         as handle    no-undo .
      343     define variable h-main-buf        as handle    no-undo .
      344     define variable h-for-comp        as handle    no-undo .
      345     define variable v-inform          as character no-undo .
      346     define variable v-ind             as integer   no-undo .
      347     define variable v-idx-field-qnty  as integer   no-undo .
      348     define variable v-num-entries     as integer   no-undo .
      349     define variable fh                as handle    no-undo .
      350     define variable fh-main           as handle    no-undo .
      351     define variable fh-old            as handle    no-undo .
      352     define variable fh-new            as handle    no-undo .
      353     define variable v-field-name      as character no-undo .
      354     define variable v-field-lvl       as character no-undo .
      355     define variable v-field-form      as character no-undo .
      356     define variable v-search-exp      as character no-undo .
      357     define variable v-srch-main       as character no-undo .
      358     define variable v-word-link       as character no-undo .
      359     define variable v-av-chip-num     as logical   no-undo .
      360     define variable v-main-pi-fld-lst as character no-undo .
      361     define variable v-main-fld-lst    as character no-undo .
      362     define variable v-delim-list      as character no-undo .
      363     define variable v-label           as character no-undo .
      364     define variable v-old-value       as character no-undo case-sensitive.
      365     define variable v-new-value       as character no-undo case-sensitive.
      366     define variable v-chg-fields as character no-undo.
      367     for each temp-changes:
      368       delete temp-changes.
      369     end.
      370     if not p-hst-handle:available then do:
      371       return .
      372     end.
      373     create buffer h-new-buf  for table p-hst-handle .
      374     create buffer h-main-buf for table p-main-table .
      375     assign
      376       v-inform = h-main-buf:index-information(1)
      377       v-ind    = 2
      378     .
      379     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      380     on error undo, return error
      381     :
      382       assign
      383         v-inform = h-main-buf:index-information( v-ind )
      384         v-ind    = v-ind + 1
      385       .
      386     end.
      387     if v-inform = ?
      388       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      389       or entry( 3, v-inform, ",":U ) <> "1":U
      390     then do:
      391       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      392     end.
      393     assign
      394       v-idx-field-qnty = num-entries( v-inform ) - 4
      395     .
      396     if v-idx-field-qnty < 2 then do:
      397       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      398     end.
      399     assign
      400       v-srch-main   = "where":U
      401       v-word-link   = "":U
      402       v-av-chip-num = false
      403       v-delim-list  = "":U
      404     .
      405     do v-ind = 1 to v-idx-field-qnty by 2
      406     on error undo, return error
      407     :
      408       assign
      409         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      410         fh                = p-hst-handle:buffer-field( v-field-name )
      411         fh-main           = h-main-buf:buffer-field( v-field-name )
      412         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      413         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      414       .
      415       if fh:data-type ="character":U then do:
      416         assign
      417           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      418         .
      419       end.
      420       else do:
      421         assign
      422           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      423         .
      424       end.
      425       if v-delim-list = "":U then do:
      426         assign
      427           v-delim-list = ",":U
      428         .
      429       end.
      430       if v-word-link = "":U then do:
      431         assign
      432           v-word-link = "and":U
      433         .
      434       end.
      435     end.
      436     assign
      437       v-delim-list  = "":U
      438     .
      439     do v-ind = 1 to h-main-buf:num-fields
      440     on error undo, return error
      441     :
      442       assign
      443         fh-main      = h-main-buf:buffer-field( v-ind )
      444         v-field-name = fh-main:name
      445       .
      446         assign
      447           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      448         .
      449         if v-delim-list = "":U then do:
      450           assign
      451             v-delim-list = ",":U
      452           .
      453         end.
      454     end.
      455     assign
      456       v-inform = p-hst-handle:index-information(1)
      457       v-ind    = 2
      458     .
      459     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      460     on error undo, return error
      461     :
      462       assign
      463         v-inform = p-hst-handle:index-information( v-ind )
      464         v-ind    = v-ind + 1
      465       .
      466     end.
      467     if v-inform = ?
      468       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      469       or entry( 3, v-inform, ",":U ) <> "1":U
      470     then do:
      471       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      472     end.
      473     assign
      474       v-idx-field-qnty = num-entries( v-inform ) - 4
      475     .
      476     if v-idx-field-qnty < 2 then do:
      477       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      478     end.
      479     assign
      480       v-search-exp  = "where":U
      481       v-word-link   = "":U
      482       v-av-chip-num = false
      483     .
      484     do v-ind = 1 to v-idx-field-qnty by 2
      485     on error undo, return error
      486     :
      487       assign
      488         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      489         fh           = p-hst-handle:buffer-field( v-field-name )
      490         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      491       .
      492       if v-field-name = "chip-num":U then do:
      493         assign
      494           v-search-exp  = substitute( "&1 >", v-search-exp )
      495           v-av-chip-num = true
      496         .
      497       end.
      498       else do:
      499         assign
      500           v-search-exp = substitute( "&1 =", v-search-exp )
      501         .
      502       end.
      503       if fh:data-type ="character":U then do:
      504         assign
      505           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      506         .
      507       end.
      508       else do:
      509         assign
      510           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
      511         .
      512       end.
      513       if v-word-link = "":U then do:
      514         assign
      515           v-word-link = "and":U
      516         .
      517       end.
      518     end.
      519     if v-av-chip-num = false then do:
      520       message
      521         vss-workfile vss-revision vss-description skip
      522         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
      523         "Использование данной процедуры невозможно!" skip
      524         view-as alert-box error .
      525       return error .
      526     end.
      527     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
      528     if not h-new-buf:available then do:
      529       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
      530       if not h-main-buf:available then do:
      531         assign
      532           h-for-comp = ?
      533         .
      534       end.
      535       else do:
      536         assign
      537           h-for-comp = h-main-buf
      538         .
      539       end.
      540     end.
      541     else do:
      542       assign
      543         h-for-comp = h-new-buf
      544       .
      545     end.
      546     assign
      547       v-num-entries = num-entries( v-main-fld-lst, ",":U )
      548     .
      549     do v-ind = 1 to v-num-entries
      550     on error undo, return error return-value
      551     :
      552       assign
      553         v-field-name = entry( v-ind, v-main-fld-lst )
      554         fh-old       = p-hst-handle:buffer-field( v-field-name )
      555         v-old-value  = fh-old:buffer-value()
      556         v-label      = trim( fh-old:label )
      557       .
      558       if ( trim( p-field-list ) <> "":U
      559            and lookup( v-field-name, p-field-list ) > 0
      560          )
      561          or trim( p-field-list ) = "":U
      562       then do:
      563         if h-for-comp <> ? then do:
      564           assign
      565             fh-new      = h-for-comp:buffer-field( v-field-name )
      566             v-new-value = fh-new:buffer-value()
      567           .
      568         end.
      569         else do:
      570           assign
      571             v-new-value = "":U
      572           .
      573         end.
      574           if p-act-create = true then do:
      575             assign
      576               v-old-value = "":U
      577             .
      578           end.
      579           if p-act-delete = true then do:
      580             assign
      581               v-new-value = "":U
      582             .
      583           end.
      584         if v-old-value <> v-new-value
      585         then do:
      586           create temp-changes.
      587           assign
      588             temp-changes.t_name = p-main-table
      589             temp-changes.f_name = v-field-name
      590             temp-changes.l_name = replace( v-label, "&":U, "":U )
      591             temp-changes.v_old  = trim( v-old-value )
      592             temp-changes.v_new  = trim( v-new-value )
      593             temp-changes.num_   = 0
      594             temp-changes.fNotChange = v-old-value eq v-new-value
      595           .
      596         end.
      597       end.
      598     end.
      599     assign
      600       v-num-entries = num-entries( p-label-form, chr(8) )
      601     .
      602     do v-ind = 1 to v-num-entries
      603     on error undo, return error return-value
      604     :
      605       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
      606         assign
      607           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      608           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      609           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      610         .
      611         find first temp-changes
      612           where temp-changes.f_name = v-field-name
      613           no-error .
      614         if available temp-changes then do:
      615           if trim( v-field-lvl ) <> "":U then do:
      616             assign
      617               temp-changes.l_name = v-field-lvl
      618             .
      619           end.
      620           if trim( v-field-form ) <> "":U then do:
      621             assign
      622               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
      623             .
      624             if h-for-comp <> ? then do:
      625               assign
      626                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
      627               .
      628             end.
      629           end.
      630         end.
      631       end.
      632       else do:
      633         message
      634           vss-workfile vss-revision vss-description skip
      635           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
      636           substitute( "список для поля '&1': '&2'"
      637                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      638                       ,entry( v-ind, p-label-form, chr(8) )
      639                     ) skip
      640           substitute( "полный список: &2", p-label-form ) skip
      641           view-as alert-box error .
      642       end.
      643     end.
      644     delete object h-new-buf .
      645     delete object h-main-buf .
      646   END PROCEDURE.
      647   find first buf_c-pmp-hist no-lock where
      648             buf_c-pmp-hist.obj-type = p-obj-type
      649         AND buf_c-pmp-hist.obj-code = p-obj-code
      650         AND buf_c-pmp-hist.pump-code = p-pump-code
      651         AND buf_c-pmp-hist.chip-num = p-chip-num
      652         AND buf_c-pmp-hist.corr-user-db-num = p-corr-user-db-num
      653         AND buf_c-pmp-hist.subject  = p-subject no-error .
      654   if not available buf_c-pmp-hist then do:
      655     return error .
      656   end.
      657   CASE p-subject:
      658     when 'pump':U then do:
      659       run pump-proc in this-procedure(output p-description) no-error  .
      660     end.
      661     when 'pump-nozzle':U then do:
      662       run pump-nozzle-proc in this-procedure(output p-description) no-error  .
      663     end.
      664     when 'pl-gds-pump':U then do:
      665       run pl-gds-pump-proc in this-procedure(output p-description) no-error  .
      666     end.
      667     when 'pl-pump':U then do:
      668       run pl-pump-proc in this-procedure(output p-description) no-error  .
      669     end.
      670     when 'pl-pump-nozzle':U then do:
      671       run pl-pump-nozzle-proc in this-procedure(output p-description) no-error  .
      672     end.
      673     when 'pump-attr':U then do:
      674       run pump-attr-proc in this-procedure(output p-description) no-error  .
      675     end.
      676   END CASE.
      677   if error-status:error then do:
      678     return error .
      679   end.
      680   procedure pump-proc :
      681   define output parameter p-description as character no-undo .
      682   define buffer curr_c-pump for ub.c-pump  .
      683     do
      684     on error undo, return error
      685     :
      686       find first curr_c-pump no-lock where
      687                  curr_c-pump.obj-type = p-obj-type
      688              AND curr_c-pump.obj-code = p-obj-code
      689              AND curr_c-pump.pump-code = buf_c-pmp-hist.pump-code
      690              AND curr_c-pump.chip-num = p-chip-num
      691              AND curr_c-pump.corr-user-db-num = p-corr-user-db-num
      692              no-error .
      693       if not avail curr_c-pump then do:
      694         v-mess = "Неверная ссылка на c-pump в таблице c-pmp-hist".
      695         run err-mess in this-procedure ( input-output v-mess).
      696         return error v-mess.
      697       end.
      698   define variable v-label-param as character no-undo .
      699   v-label-param =
      700     "pump-code" + chr(4) + "№ ТРК" + chr(4) + "" + chr(8)
      701    + "obj-code" + chr(4) + "Код объекта" + chr(4) + "" + chr(8)
      702    + "obj-type" + chr(4) + "Тип объекта" + chr(4) + "" + chr(8)
      703    + "PS" + chr(4) + "Описание" + chr(4) + "" + chr(8)
      704    + "status_" + chr(4) + "Статус" + chr(4) + ""  .
      705    run proc-full-temp-changes in this-procedure (
      706                                                input  (buf_c-pmp-hist.action = integer('1':U))
      707                                               ,input  (buf_c-pmp-hist.action = integer('99':U))
      708                                               ,input  buffer curr_c-pump:handle
      709                                               ,input  'pump':U
      710                                               ,input  "pump-code,obj-code,obj-type,PS,status_"
      711                                               ,input  v-label-param).
      712   end.
      713   end procedure.
      714   procedure pump-nozzle-proc :
      715   define output parameter p-description as character no-undo .
      716   define buffer curr_c-pump-nozzle for ub.c-pump-nozzle  .
      717     do
      718     on error undo, return error
      719     :
      720       find first curr_c-pump-nozzle no-lock where
      721                  curr_c-pump-nozzle.pump-code = buf_c-pmp-hist.pump-code
      722              AND curr_c-pump-nozzle.obj-type = p-obj-type
      723              AND curr_c-pump-nozzle.obj-code = p-obj-code
      724              AND curr_c-pump-nozzle.nozzle-code = buf_c-pmp-hist.nozzle-code
      725              AND curr_c-pump-nozzle.chip-num = p-chip-num
      726              AND curr_c-pump-nozzle.corr-user-db-num = p-corr-user-db-num  no-error .
      727       if not avail curr_c-pump-nozzle then do:
      728         v-mess = "Неверная ссылка на c-pump-nozzle в таблице c-pmp-hist".
      729         run err-mess in this-procedure ( input-output v-mess).
      730         return error v-mess.
      731       end.
      732   define variable v-label-param as character no-undo .
      733   v-label-param =
      734     "nozzle-code" + chr(4) + "№ пистолета" + chr(4) + "" + chr(8)
      735    + "pump-code" + chr(4) + "№ ТРК" + chr(4) + "" + chr(8)
      736    + "is-meas" + chr(4) + "Измеряется приборами" + chr(4) + "" + chr(8)
      737    + "obj-code" + chr(4) + "Код объекта" + chr(4) + "" + chr(8)
      738    + "obj-type" + chr(4) + "Тип объекта" + chr(4) + "" + chr(8)
      739    + "PS" + chr(4) + "Примечание" + chr(4) + "" + chr(8)
      740    + "status_" + chr(4) + "Статус" + chr(4) + ""  + chr(8)
      741    + "ef-nid" + chr(4) + "Идентификатор EasyFuel" + chr(4) + ""
      742      .
      743    run proc-full-temp-changes in this-procedure (
      744                                                input  (buf_c-pmp-hist.action = integer('1':U))
      745                                               ,input  (buf_c-pmp-hist.action = integer('99':U))
      746                                               ,input  buffer curr_c-pump-nozzle:handle
      747                                               ,input  'pump-nozzle':U
      748                                               ,input  "nozzle-code,pump-code,is-meas,obj-code,obj-type,PS,status_"
      749                                               ,input  v-label-param).
      750   end.
      751   end procedure.
      752   procedure pl-gds-pump-proc :
      753   define output parameter p-description as character no-undo .
      754   define buffer buf_c-table-bind for ub.c-table-bind.
      755   define buffer curr_c-pl-gds-pump for ub.c-pl-gds-pump  .
      756     do
      757     on error undo, return error
      758     :
      759       find first buf_c-table-bind no-lock where
      760                 buf_c-table-bind.corr-user-db-num = buf_c-pmp-hist.corr-user-db-num
      761             AND buf_c-table-bind.tbl-name-rec     = 'c-pmp-hist':U
      762             AND buf_c-table-bind.chip-num-rec     = buf_c-pmp-hist.chip-num no-error .
      763       if not available buf_c-table-bind then do:
      764         v-mess = "Неверная ссылка на c-table-bind в таблице c-pmp-hist".
      765         run err-mess in this-procedure ( input-output v-mess ).
      766         return error v-mess .
      767       end.
      768       find first curr_c-pl-gds-pump no-lock where
      769                  curr_c-pl-gds-pump.obj-type = buf_c-pmp-hist.obj-type
      770              AND curr_c-pl-gds-pump.obj-code = buf_c-pmp-hist.obj-code
      771              AND curr_c-pl-gds-pump.pump-code = buf_c-pmp-hist.pump-code
      772              AND curr_c-pl-gds-pump.chip-num = buf_c-table-bind.chip-num-src
      773              AND curr_c-pl-gds-pump.corr-user-db-num = buf_c-table-bind.corr-user-db-num no-error .
      774       if not avail curr_c-pl-gds-pump then do:
      775         v-mess = "Неверная ссылка на c-pl-gds-pump в таблице c-table-bind".
      776         run err-mess in this-procedure ( input-output v-mess ).
      777         return error v-mess .
      778       end.
      779   define variable v-label-param as character no-undo .
      780   v-label-param =
      781     "gds-code" + chr(4) + "Код товара" + chr(4) + "" + chr(8)
      782    + "pl-code" + chr(4) + "Код складского места" + chr(4) + "" + chr(8)
      783    + "pump-code" + chr(4) + "№ ТРК" + chr(4) + "" + chr(8)
      784    + "obj-code" + chr(4) + "Код объекта" + chr(4) + "" + chr(8)
      785    + "obj-type" + chr(4) + "Тип объекта" + chr(4) + "" + chr(8)
      786    + "PS" + chr(4) + "Примечание" + chr(4) + "" + chr(8)
      787    + "status_" + chr(4) + "Статус" + chr(4) + ""  .
      788    run proc-full-temp-changes in this-procedure (
      789                                                input  (buf_c-pmp-hist.action = integer('1':U))
      790                                               ,input  (buf_c-pmp-hist.action = integer('99':U))
      791                                               ,input  buffer curr_c-pl-gds-pump:handle
      792                                               ,input  'pl-gds-pump':U
      793                                               ,input  "gds-code,pl-code,pump-code,obj-code,obj-type,PS,status_"
      794                                               ,input  v-label-param).
      795   end.
      796   end procedure.
      797   procedure pl-pump-nozzle-proc :
      798   define output parameter p-description as character no-undo .
      799   define buffer buf_c-table-bind for ub.c-table-bind.
      800   define buffer curr_c-pl-pump-nozzle for ub.c-pl-pump-nozzle  .
      801     do
      802     on error undo, return error
      803     :
      804       find first buf_c-table-bind no-lock where
      805                 buf_c-table-bind.corr-user-db-num = buf_c-pmp-hist.corr-user-db-num
      806             AND buf_c-table-bind.tbl-name-rec     = 'c-pmp-hist':U
      807             AND buf_c-table-bind.chip-num-rec     = buf_c-pmp-hist.chip-num no-error .
      808       if not available buf_c-table-bind then do:
      809         v-mess = "Неверная ссылка на c-table-bind в таблице c-pmp-hist".
      810         run err-mess in this-procedure ( input-output v-mess).
      811         return error v-mess.
      812       end.
      813       find first curr_c-pl-pump-nozzle no-lock where
      814                  curr_c-pl-pump-nozzle.obj-type = buf_c-pmp-hist.obj-type
      815              AND curr_c-pl-pump-nozzle.obj-code = buf_c-pmp-hist.obj-code
      816              AND curr_c-pl-pump-nozzle.pump-code = buf_c-pmp-hist.pump-code
      817              AND curr_c-pl-pump-nozzle.chip-num = buf_c-table-bind.chip-num-src
      818              AND curr_c-pl-pump-nozzle.corr-user-db-num = buf_c-table-bind.corr-user-db-num   no-error .
      819       if not avail curr_c-pl-pump-nozzle then do:
      820         v-mess = "Неверная ссылка на c-pl-pump-nozzle в таблице c-table-bind".
      821         run err-mess in this-procedure ( input-output v-mess).
      822         return error v-mess.
      823       end.
      824   define variable v-label-param as character no-undo .
      825   v-label-param =
      826     "nozzle-code" + chr(4) + "№ пистолета" + chr(4) + "" + chr(8)
      827    + "pl-code" + chr(4) + "Код складского места" + chr(4) + "" + chr(8)
      828    + "pump-code" + chr(4) + "№ ТРК" + chr(4) + "" + chr(8)
      829    + "obj-code" + chr(4) + "Код объекта" + chr(4) + "" + chr(8)
      830    + "obj-type" + chr(4) + "Тип объекта" + chr(4) + "" + chr(8)
      831    + "PS" + chr(4) + "Примечание" + chr(4) + "" + chr(8)
      832    + "status_" + chr(4) + "Статус" + chr(4) + ""  .
      833    run proc-full-temp-changes in this-procedure (
      834                                                input  (buf_c-pmp-hist.action = integer('1':U))
      835                                               ,input  (buf_c-pmp-hist.action = integer('99':U))
      836                                               ,input  buffer curr_c-pl-pump-nozzle:handle
      837                                               ,input  'pl-pump-nozzle':U
      838                                               ,input  "nozzle-code,pl-code,pump-code,obj-code,obj-type,PS,status_"
      839                                               ,input  v-label-param).
      840   end.
      841   end procedure.
      842   procedure pl-pump-proc :
      843   define output parameter p-description as character no-undo .
      844   define buffer buf_c-table-bind for ub.c-table-bind.
      845   define buffer curr_c-pl-pump for ub.c-pl-pump  .
      846     do
      847     on error undo, return error
      848     :
      849       find first buf_c-table-bind no-lock where
      850                 buf_c-table-bind.corr-user-db-num = buf_c-pmp-hist.corr-user-db-num
      851             AND buf_c-table-bind.tbl-name-rec     = 'c-pmp-hist':U
      852             AND buf_c-table-bind.chip-num-rec     = buf_c-pmp-hist.chip-num no-error .
      853       if not available buf_c-table-bind then do:
      854         v-mess = "Неверная ссылка на c-table-bind в таблице c-pmp-hist".
      855         run err-mess in this-procedure ( input-output v-mess).
      856         return error v-mess.
      857       end.
      858       find first curr_c-pl-pump no-lock where
      859                  curr_c-pl-pump.obj-type = buf_c-pmp-hist.obj-type
      860              AND curr_c-pl-pump.obj-code = buf_c-pmp-hist.obj-code
      861              AND curr_c-pl-pump.pump-code = buf_c-pmp-hist.pump-code
      862              AND curr_c-pl-pump.chip-num = buf_c-table-bind.chip-num-src
      863              AND curr_c-pl-pump.corr-user-db-num = buf_c-table-bind.corr-user-db-num   no-error .
      864       if not avail curr_c-pl-pump then do:
      865         v-mess = "Неверная ссылка на c-pl-pump в таблице c-table-bind".
      866         run err-mess in this-procedure ( input-output v-mess).
      867         return error v-mess.
      868       end.
      869   define variable v-label-param as character no-undo .
      870   v-label-param =
      871     "pl-code" + chr(4) + "Код складского места" + chr(4) + "" + chr(8)
      872    + "pump-code" + chr(4) + "№ ТРК" + chr(4) + "" + chr(8)
      873    + "obj-code" + chr(4) + "Код объекта" + chr(4) + "" + chr(8)
      874    + "obj-type" + chr(4) + "Тип объекта" + chr(4) + "" + chr(8)
      875    + "PS" + chr(4) + "Примечание" + chr(4) + "" + chr(8)
      876    + "status_" + chr(4) + "Статус" + chr(4) + ""  .
      877    run proc-full-temp-changes in this-procedure (
      878                                                input  (buf_c-pmp-hist.action = integer('1':U))
      879                                               ,input  (buf_c-pmp-hist.action = integer('99':U))
      880                                               ,input  buffer curr_c-pl-pump:handle
      881                                               ,input  'pl-pump':U
      882                                               ,input  "pl-code,pump-code,obj-code,obj-type,PS,status_"
      883                                               ,input  v-label-param).
      884   end.
      885   end procedure.
      886   procedure pump-attr-proc :
      887   define output parameter p-description as character no-undo .
      888   define variable v-tooltip as character no-undo .
      889   define variable v-label as character no-undo .
      890   define buffer current_c-pump-attr for ub.c-pump-attr  .
      891     do
      892     on error undo, return error
      893     :
      894       find first current_c-pump-attr no-lock where
      895                  current_c-pump-attr.chip-num = p-chip-num
      896              AND current_c-pump-attr.corr-user-db-num = p-corr-user-db-num
      897              AND current_c-pump-attr.obj-type = p-obj-type
      898              AND current_c-pump-attr.obj-code = p-obj-code
      899              AND current_c-pump-attr.pump-code = p-pump-code  no-error .
      900       if not avail current_c-pump-attr then do:
      901         v-mess = "Неверная ссылка на c-pump-attr в таблице c-pmp-hist".
      902         run err-mess in this-procedure ( input-output v-mess).
      903         return error v-mess.
      904       end.
      905       run pumpattr-tooltip in this-procedure (
      906                   input  current_c-pump-attr.attr-code
      907                   ,output v-tooltip
      908                   ,output v-label
      909                   ) no-error .
      910       assign
      911       p-description = "Атрибут" + chr(32) + v-label
      912       .
      913   define variable v-label-param as character no-undo .
      914   v-label-param =
      915     "attr-value" + chr(4) + "Значение атрибута" + chr(4) + "" + chr(8)
      916    + "pump-code" + chr(4) + "№ ТРК" + chr(4) + "" + chr(8)
      917    + "obj-code" + chr(4) + "Код объекта" + chr(4) + "" + chr(8)
      918    + "obj-type" + chr(4) + "Тип объекта" + chr(4) + "" + chr(8)
      919    + "PS" + chr(4) + "Примечание" + chr(4) + "" + chr(8)
      920    + "status_" + chr(4) + "Статус" + chr(4) + ""  .
      921    run proc-full-temp-changes in this-procedure (
      922                                                input  (buf_c-pmp-hist.action = integer('1':U))
      923                                               ,input  (buf_c-pmp-hist.action = integer('99':U))
      924                                               ,input  buffer current_c-pump-attr:handle
      925                                               ,input  'pump-attr':U
      926                                               ,input  "attr-value,pump-code,obj-code,obj-type,PS,status_"
      927                                               ,input  v-label-param).
      928   end.
      929   end procedure.
      930   PROCEDURE err-mess:
      931     DEFINE INPUT-output PARAMETER p-mess as character No-UNDO.
      932     CASE p-silent:
      933       when yes then do:
      934         p-mess =
      935         substitute("История ТРК &1 на &2&3: щепка &4 БД:&5  Предмет изменений &6&7&8"
      936                     ,p-pump-code
      937                     , p-obj-type
      938                     , p-obj-code
      939                     , p-chip-num
      940                     , p-corr-user-db-num
      941                     , p-subject
      942                     , chr(10)
      943                     , p-mess
      944                     ).
      945       end.
      946       otherwise do:
      947         message
      948         p-mess
      949         view-as alert-box error .
      950       end.
      951     end.
      952   END PROCEDURE.
