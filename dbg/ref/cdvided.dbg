      120   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      121     define variable v-cntxt-db-num        as integer   no-undo .
      122     define variable v-cntxt-userid        as character no-undo .
      123     define variable v-cntxt-level         as character no-undo .
      124     define variable v-cntxt-host-code-obj as integer   no-undo .
      125     define variable v-cntxt-obj-type      as character no-undo .
      126     define variable v-cntxt-obj-code      as integer   no-undo .
      127     define variable v-cntxt-db-num-obj    as integer   no-undo .
      128     define variable v-cntxt-is-admin      as logical   no-undo .
      129   DEFINE BUTTON b-add AUTO-GO
      130        LABEL "&Ввод"
      131        SIZE 10 BY 1
      132        BGCOLOR 8 .
      133   DEFINE BUTTON b-help
      134        LABEL "Помо&щь"
      135        SIZE 10 BY 1
      136        BGCOLOR 8 .
      137   DEFINE BUTTON b-quit AUTO-END-KEY
      138        LABEL "&Отмена"
      139        SIZE 10 BY 1
      140        BGCOLOR 8 .
      141   DEFINE BUTTON b-select-event
      142        LABEL "Button 1"
      143        SIZE 3 BY 1 TOOLTIP "Выбор события на кассе из справочника".
      144   DEFINE VARIABLE cb-system AS CHARACTER FORMAT "X(256)":U
      145        LABEL "Система"
      146        VIEW-AS COMBO-BOX INNER-LINES 2
      147        LIST-ITEMS "Призма","Интеллект"
      148        DROP-DOWN-LIST
      149        SIZE 14 BY 1 NO-UNDO.
      150   DEFINE VARIABLE v-event-id AS INTEGER FORMAT ">>>9":U INITIAL 0
      151        LABEL "Событие на кассе"
      152        VIEW-AS FILL-IN
      153        SIZE 6 BY 1 NO-UNDO.
      154   DEFINE VARIABLE v-video-id AS CHARACTER FORMAT "X(256)":U
      155        LABEL "Событие в СВ"
      156        VIEW-AS FILL-IN
      157        SIZE 46 BY 1 NO-UNDO.
      158   DEFINE FRAME Dialog-Frame
      159        b-add AT ROW 1 COL 1
      160        b-quit AT ROW 1 COL 11
      161        b-help AT ROW 1 COL 52.88
      162        cb-system AT ROW 2.75 COL 14.88 COLON-ALIGNED WIDGET-ID 4
      163        v-event-id AT ROW 2.75 COL 49.75 COLON-ALIGNED WIDGET-ID 6
      164        b-select-event AT ROW 2.75 COL 59.88 WIDGET-ID 8
      165        v-video-id AT ROW 4.08 COL 14.88 COLON-ALIGNED WIDGET-ID 2
      166        SPACE(2.24) SKIP(0.79)
      167       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      168            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      169            TITLE "Связь события на кассе с СВ"
      170            DEFAULT-BUTTON b-add CANCEL-BUTTON b-quit WIDGET-ID 100.
      171   ASSIGN
      172          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      173          FRAME Dialog-Frame:HIDDEN           = TRUE.
      174   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      175   DO:
      176     APPLY "END-ERROR":U TO SELF.
      177   END.
      178   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      179   DO:
      180      ASSIGN
      181       v-video-id
      182       v-event-id
      183       cb-system
      184       v-message = "":U
      185      .
      186      RUN chk-link IN THIS-PROCEDURE  (  INPUT  cb-system
      187                                       , INPUT  v-event-id
      188                                       , INPUT  v-video-id
      189                                       , OUTPUT v-message
      190                                       ) .
      191      IF v-message <> "":U
      192      THEN DO:
      193         message
      194            v-message
      195            skip
      196         view-as alert-box information.
      197         RETURN NO-APPLY .
      198      END.
      199      RUN save-link IN THIS-PROCEDURE (  INPUT  cb-system
      200                                       , INPUT  v-event-id
      201                                       , INPUT  v-video-id
      202                                       , OUTPUT p-ok
      203                                       ) NO-ERROR.
      204      IF NOT p-ok
      205      OR ERROR-STATUS:ERROR
      206      THEN DO:
      207         IF p-id = 0 AND p-video-id = "" AND p-system-id = ""
      208         THEN DO:
      209            message
      210               "Ошибка создания записи"
      211               skip RETURN-VALUE
      212               skip ERROR-STATUS:get-message(1)
      213            view-as alert-box information.
      214         END.
      215         ELSE DO:
      216            message
      217               "Ошибка изменения записи"
      218               skip RETURN-VALUE
      219               skip ERROR-STATUS:get-message(1)
      220            view-as alert-box information.
      221         END.
      222      END.
      223      ELSE DO:
      224         ASSIGN
      225            p-id = v-event-id
      226            p-video-id = v-video-id
      227            p-system-id = cb-system
      228             .
      229        END.
      230   END.
      231   ON CHOOSE OF b-help IN FRAME Dialog-Frame
      232   OR HELP OF FRAME Dialog-Frame
      233   DO:
      234     MESSAGE "Help for File: c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\ref\cdvided.w" VIEW-AS ALERT-BOX INFORMATION.
      235   END.
      236   ON CHOOSE OF b-select-event IN FRAME Dialog-Frame
      237   DO:
      238      define variable v-rid as CHARACTER no-undo .
      239      run ref/cd-event.w ( INPUT parparentproc
      240                         , INPUT "b-sel":U
      241                         , INPUT-OUTPUT v-rid
      242                         , OUTPUT p-ok
      243                         ) .
      244       IF p-ok THEN DO:
      245       FIND FIRST buf_cd-events WHERE RECID(buf_cd-events) = integer(v-rid)
      246           NO-ERROR
      247           .
      248       ASSIGN
      249       v-event-id = (buf_cd-events.event-id)
      250       .
      251       DISPLAY v-event-id WITH FRAME dialog-frame.
      252   END.
      253   END.
      254   ON VALUE-CHANGED OF cb-system IN FRAME Dialog-Frame
      255   DO:
      256   ASSIGN
      257       cb-system
      258   .
      259   END.
      260   ON LEAVE OF v-event-id IN FRAME Dialog-Frame
      261   DO:
      262      ASSIGN
      263       v-event-id
      264      .
      265   END.
      266   ON LEAVE OF v-video-id IN FRAME Dialog-Frame
      267   DO:
      268      ASSIGN
      269       v-video-id
      270      .
      271   END.
      272   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      273   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      274   MAIN-BLOCK:
      275   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      276      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      277   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      278     run mainmenu_getcntxt in parparentproc
      279       (output v-cntxt-db-num
      280       ,output v-cntxt-userid
      281       ,output v-cntxt-level
      282       ,output v-cntxt-host-code-obj
      283       ,output v-cntxt-obj-type
      284       ,output v-cntxt-obj-code
      285       ,output v-cntxt-db-num-obj
      286       ,output v-cntxt-is-admin
      287       ) .
      288   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      289   on help of frame Dialog-Frame
      290   do:
      291     run gbl/app_help.p
      292       (input this-procedure :file-name
      293       ,input ''
      294       ,input ?
      295       ) no-error.
      296     if error-status :error then do:
      297       message
      298         "Ошибка при вызове помощи"
      299         error-status :get-message(1)
      300         view-as alert-box .
      301     end.
      302   end.
      303   run minbtn-set in this-procedure .
      304   on choose of b-help in frame Dialog-Frame
      305   do:
      306     apply "help":u to frame Dialog-Frame .
      307   end.
      308   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      309   procedure minbtn-set :
      310       do
      311           on error undo, return error return-value
      312           :
      313           define variable ii              as integer       no-undo .
      314           define variable fh              as widget-handle no-undo .
      315           define variable hh              as widget-handle no-undo .
      316           define variable v-h             as handle        extent 4 no-undo .
      317           define variable v-name-button   as character     no-undo .
      318           define variable v-help-old-x    as decimal       no-undo .
      319           define variable v-help-old-y    as decimal       no-undo .
      320           define variable v-help-old-size as decimal       no-undo .
      321           define variable v-frame-width   as decimal       no-undo .
      322           define variable jj              as integer       no-undo .
      323           do
      324               on error undo, return error
      325               :
      326               assign
      327                   v-frame-width = frame Dialog-Frame:width - 0.3
      328                   fh            = frame Dialog-Frame:first-child
      329                   hh            = fh:first-child
      330                   ii            = 1
      331                   .
      332               do while valid-handle(hh):
      333                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      334                   do:
      335                       case lc(hh:name) :
      336                           when "b-help" then
      337                               do:
      338                                   hh:load-image-up("cmp/b-help.bmp":u) .
      339                                   hh:load-image-down("cmp/b-help.bmp":u) .
      340                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      341                                   hh:TOOLTIP = "Помощь" .
      342                                   v-help-old-x = hh:column .
      343                                   v-help-old-y = hh:row    .
      344                                   v-help-old-size = hh:width .
      345                                   hh:width-chars = 2.5 .
      346                               end.
      347                           when "b-print" then
      348                               do:
      349                                   hh:load-image("cmp/b-print.bmp":u) .
      350                                   hh:TOOLTIP = "Печать" .
      351                                   v-h[ii] = hh:handle .
      352                                   ii = ii + 1 .
      353                                   hh:width-chars = 3 .
      354                               end.
      355                           when "b-history" or
      356                           when "b-hist" then
      357                               do:
      358                                   hh:load-image("cmp/b-hist.bmp":u) .
      359                                   hh:TOOLTIP = "История" .
      360                                   v-h[ii] = hh:handle .
      361                                   ii = ii + 1 .
      362                                   hh:width-chars = 3 .
      363                               end.
      364                           when "b-sch" then
      365                               do:
      366                                   hh:load-image("cmp/b-sch.bmp":u) .
      367                                   hh:TOOLTIP = "Установка Фильтра" .
      368                                   v-h[ii] = hh:handle .
      369                                   ii = ii + 1 .
      370                                   hh:width-chars = 3 .
      371                               end.
      372                           when "b-hist-user" then
      373                               do:
      374                                   hh:load-image("cmp/b-hist.bmp":u) .
      375                                   hh:TOOLTIP = "История пользователя" .
      376                                   ii = ii + 1 .
      377                               end.
      378                       end case.
      379                   end.
      380                   hh = hh:next-sibling.
      381               end.
      382               b-help:column = v-frame-width - b-help:width-chars.
      383               jj = 0.
      384               repeat ii = 4 to 1 by -1 :
      385                   if valid-handle (v-h[ii] ) then
      386                   do:
      387                       jj  = jj + 1 .
      388                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      389                       v-h[ii]:row    = v-help-old-y .
      390                   end.
      391               end.
      392           end.
      393       end.
      394   end procedure.
      395      if p-id <> 0 AND  p-video-id NE "" AND  p-system-id NE ""
      396      THEN DO:
      397         assign
      398            v-message = "":U
      399         .
      400         RUN init-link  in THIS-PROCEDURE ( INPUT  p-system-id
      401                                          , INPUT p-id
      402                                          , INPUT p-video-id
      403                                          , OUTPUT v-message
      404                                          ) .
      405         IF v-message <> "":U
      406         THEN DO:
      407            message
      408               v-message
      409               skip
      410            view-as alert-box information.
      411            RETURN.
      412         END.
      413         ASSIGN
      414            v-event-id = p-id
      415            v-video-id = p-video-id
      416            p-system-id = p-system-id
      417         .
      418      END.
      419      ELSE DO:
      420       END.
      421      RUN enable_UI.
      422      WAIT-FOR GO OF FRAME Dialog-Frame focus cb-system.
      423   END.
      424   RUN disable_UI.
      425   PROCEDURE chk-link :
      426   define input parameter p-s-id      as CHARACTER           no-undo.
      427   define input parameter p-e-id      as integer        no-undo.
      428   define input parameter p-v-id      as CHARACTER       no-undo.
      429   define output parameter p-message  as character        no-undo.
      430   define buffer buf_cd-video-link for ub.cd-video-link .
      431      IF CAN-FIND (FIRST buf_cd-video-link
      432                   WHERE buf_cd-video-link.video-id = p-s-id
      433                   AND buf_cd-video-link.event-id = p-e-id
      434                   AND buf_cd-video-link.video-event-id = p-v-id
      435                   no-lock
      436                   )
      437      THEN DO:
      438         ASSIGN
      439            p-message = "Уже есть такая связка"
      440         .
      441      END.
      442   END PROCEDURE.
      443   PROCEDURE disable_UI :
      444     HIDE FRAME Dialog-Frame.
      445   END PROCEDURE.
      446   PROCEDURE enable_UI :
      447     DISPLAY cb-system v-event-id v-video-id
      448         WITH FRAME Dialog-Frame.
      449     ENABLE b-add b-quit b-help cb-system v-event-id b-select-event v-video-id
      450         WITH FRAME Dialog-Frame.
      451     VIEW FRAME Dialog-Frame.
      452   END PROCEDURE.
      453   PROCEDURE init-link :
      454   define input parameter p-s-id      as CHARACTER           no-undo.
      455   define input parameter p-e-id      as integer        no-undo.
      456   define input parameter p-v-id      as CHARACTER       no-undo.
      457   define output parameter p-message  as character        no-undo.
      458   do
      459   TRANSACTION
      460   on error undo, return error
      461   :
      462      FIND FIRST buf_cd-video-link
      463           WHERE buf_cd-video-link.event-id = p-e-id
      464           AND buf_cd-video-link.video-id = p-s-id
      465           AND buf_cd-video-link.video-event-id = p-v-id
      466           EXCLUSIVE-LOCK
      467           NO-ERROR
      468           .
      469      IF LOCKED buf_cd-video-link
      470      THEN DO:
      471         ASSIGN
      472            p-message = "Запись редактируется другим пользователем"
      473         .
      474         RETURN .
      475      END.
      476      ASSIGN
      477         cb-system  = buf_cd-video-link.video-id
      478         v-event-id = buf_cd-video-link.event-id
      479         v-video-id = buf_cd-video-link.video-event-id
      480      .
      481   end.
      482   END PROCEDURE.
      483   PROCEDURE save-link :
      484   define INPUT  parameter p-s-id  as CHARACTER      no-undo.
      485   define INPUT  parameter p-e-id  as integer        no-undo.
      486   define INPUT  parameter p-v-id  as CHARACTER      no-undo.
      487   define output parameter p-ok    as logical        no-undo.
      488      IF NOT AVAILABLE buf_cd-video-link
      489      THEN DO:
      490         CREATE buf_cd-video-link.
      491         ASSIGN
      492             buf_cd-video-link.video-id       = p-s-id
      493             buf_cd-video-link.event-id       = p-e-id
      494             buf_cd-video-link.video-event-id = p-v-id
      495             .
      496      END.
      497      ASSIGN
      498             buf_cd-video-link.video-id       = p-s-id
      499             buf_cd-video-link.event-id       = p-e-id
      500             buf_cd-video-link.video-event-id = p-v-id
      501             p-ok                             = TRUE
      502      .
      503      END PROCEDURE.
