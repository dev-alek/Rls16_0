        1   define input  parameter iParentProc as widget-handle no-undo.
        2   define input  parameter iCodeTrg    as class ibs.th.ref.code.code_trg no-undo.
        3   define input  parameter iMode       as character     no-undo.
        4   define input  parameter iCode       as handle        no-undo.
        5   define output parameter oIsOk       as logical       no-undo.
        6   define variable vss-revision    as character no-undo init "$Revision: $":U .
        7   define variable vss-author      as character no-undo init "$Author: $":U .
        8   define variable vss-date        as character no-undo init "$Date: $":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile: $":U .
       10   define variable vss-archive     as character no-undo init "$Archive: $":U .
       11   define variable vss-description as character no-undo init "Карточка сезонов ДТ".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   procedure proc-alt-shift-f2:
       73     if not ibs.th.gbl.gbl-var:rcode
       74   then
       75     run gbl\inidebug.p .
       76   end.
       77   procedure proc-alt-shift-f3:
       78     run gbl/prvssinf.p
       79       ( input this-procedure
       80       ) .
       81   end.
       82   define variable v-inform-launched as logical no-undo initial false .
       83   procedure proc-alt-shift-f4:
       84     define variable v-action as character no-undo .
       85     if v-inform-launched = false then do:
       86       assign
       87         v-inform-launched = true
       88       .
       89       run gbl/d-inform.w
       90         (  input self
       91         ,  input this-procedure
       92         , output v-action
       93         ) no-error .
       94       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       95       assign
       96         v-inform-launched = false
       97       .
       98     end.
       99   end.
      100   procedure proc-alt-f1:
      101     run gbl/corrhelp.p
      102       (input this-procedure
      103       ) .
      104   end .
      105   on alt-shift-f2 anywhere do:
      106     run proc-alt-shift-f2.
      107   end.
      108   on alt-shift-f3 anywhere do:
      109     run proc-alt-shift-f3 in this-procedure .
      110   end.
      111   on alt-shift-f4 anywhere do:
      112     run proc-alt-shift-f4 in this-procedure.
      113   end.
      114   on alt-f1 anywhere do:
      115     run proc-alt-f1 in this-procedure .
      116   end.
      117   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      118   procedure gen-b-code :
      119     define input  parameter type-code like ub.code-range.range-type no-undo .
      120     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
      121     do
      122     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      123     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
      124     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
      125     :
      126       define buffer buf_thbj-attr     for ub.thbj-attr .
      127       define buffer buf_sys-ctrl   for ub.sys-ctrl .
      128       define buffer buf_code-range for ub.code-range .
      129       define variable l-code         as   integer              no-undo .
      130       define variable v-db-num       like ub.db.db-num         no-undo .
      131       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      132       if type-code = 'sslc':U
      133       or type-code = 'ssgb':U
      134       then do:
      135         message
      136           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
      137           "Обратитесь к администратору системы."
      138           view-as alert-box error .
      139         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
      140       end.
      141       run trg/getpcode.p ( input  type-code
      142                      ,output cfg-param-code
      143                     ).
      144       run get-next-seq( input  type-code,
      145                         output l-code
      146                       ).
      147       find first buf_sys-ctrl no-lock.
      148       if type-code = 'sclc':U
      149       or type-code = 'pglc':U
      150       then do:
      151         assign
      152           v-db-num = 0
      153         .
      154       end.
      155       else do:
      156         assign
      157           v-db-num = buf_sys-ctrl.db-num
      158         .
      159       end.
      160       find first buf_code-range no-lock
      161         where buf_code-range.db-num     = v-db-num
      162           and buf_code-range.range-type = type-code
      163           and buf_code-range.stts       = "a"
      164         use-index stts
      165         no-error .
      166       if available buf_code-range
      167          and l-code <= buf_code-range.last-code
      168          and l-code >= buf_code-range.first-code then do:
      169         assign
      170           p-b-code = l-code
      171         .
      172       end.
      173       else do:
      174         if available buf_code-range
      175            and l-code < buf_code-range.last-code then do:
      176           message
      177             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      178             "Обратитесь к администратору системы."
      179             view-as alert-box error .
      180           undo, return error "sequence":U .
      181         end.
      182         do transaction
      183         on error undo, return error
      184         :
      185           find first buf_thbj-attr exclusive-lock
      186             where buf_thbj-attr.upper-prop-code = 'code-range':U
      187               and buf_thbj-attr.prop-code = cfg-param-code
      188               and buf_thbj-attr.obj-type   = 'БД':U
      189               and buf_thbj-attr.obj-code   = v-db-num
      190             no-error .
      191           if not available buf_thbj-attr then do:
      192             find first buf_thbj-attr exclusive-lock
      193               where buf_thbj-attr.upper-prop-code = 'code-range':U
      194                 and buf_thbj-attr.prop-code = cfg-param-code
      195                 and buf_thbj-attr.obj-type   = ''
      196                 and buf_thbj-attr.obj-code   = 0
      197               no-error .
      198             if not available buf_thbj-attr then do:
      199               if not locked buf_thbj-attr then do:
      200                 message
      201                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      202                   "Обратитесь к администратору системы."
      203                   view-as alert-box error .
      204               end.
      205               undo, return error "config":U .
      206             end.
      207           end.
      208           run get-next-seq( input type-code,
      209                             output l-code
      210                           ).
      211           find first buf_code-range
      212             where buf_code-range.db-num     = v-db-num
      213               and buf_code-range.range-type = type-code
      214               and buf_code-range.stts       = "a"
      215             use-index stts
      216             no-error .
      217           if available buf_code-range
      218           and l-code <= buf_code-range.last-code
      219           and l-code >= buf_code-range.first-code
      220           then do:
      221             assign
      222               p-b-code = l-code
      223             .
      224           end.
      225           else do:
      226             if available buf_code-range then do:
      227               assign
      228                 buf_code-range.stts = "u"
      229               .
      230             end.
      231             find first buf_code-range
      232               where buf_code-range.db-num     = v-db-num
      233                 and buf_code-range.range-type = type-code
      234                 and buf_code-range.stts       = "f"
      235               use-index stts
      236               no-error .
      237             if not available buf_code-range then do:
      238               message
      239                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      240                 "Обратитесь к администратору системы"
      241                 view-as alert-box error .
      242               undo, return error "code-range":U .
      243             end.
      244             assign
      245               buf_code-range.stts           = "a"
      246             .
      247             if buf_code-range.first-code = 1 then do:
      248               run set-seq-cr( input type-code,
      249                               input buf_code-range.first-code
      250                             ).
      251               assign
      252                 p-b-code = 1
      253               .
      254             end.
      255             else do:
      256               run set-seq-cr( input type-code,
      257                               input ( buf_code-range.first-code - 1 )
      258                             ).
      259               run get-next-seq( input type-code,
      260                                 output p-b-code
      261                               ).
      262             end.
      263           end.
      264         end.
      265       end.
      266     end.
      267   end procedure.
      268   procedure get-next-seq :
      269     define input  parameter type-code like ub.code-range.range-type no-undo .
      270     define output parameter next-seq  as   integer                  no-undo .
      271     do
      272     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      273     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      274     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      275     :
      276       case type-code:
      277         when 'bcgb':U then do:
      278           assign
      279             next-seq = next-value(s-bcgb-code, ub)
      280           .
      281         end.
      282         when 'scgb':U then do:
      283           assign
      284             next-seq = next-value(s-scgb-code, ub)
      285           .
      286         end.
      287         when 'sclc':U then do:
      288           assign
      289             next-seq = next-value(s-sclc-code, ub)
      290           .
      291         end.
      292         when 'pglc':U then do:
      293           assign
      294             next-seq = next-value(s-pglc-code, ub)
      295           .
      296         end.
      297         when 'dcgb':U then do:
      298           assign
      299             next-seq = next-value(s-dcgb-code, ub)
      300           .
      301         end.
      302         when 'ctgb':U then do:
      303           assign
      304             next-seq = next-value(s-ctgb-code, ub)
      305           .
      306         end.
      307         when 'drgb':U then do:
      308           assign
      309             next-seq = next-value(s-drgb-code, ub)
      310           .
      311         end.
      312         when 'fmgb':U then do:
      313           assign
      314             next-seq = next-value(s-fmgb-code, ub)
      315           .
      316         end.
      317         when 'pngb':U then do:
      318           assign
      319             next-seq = next-value(s-pngb-code, ub)
      320           .
      321         end.
      322         when 'cagb':U then do:
      323           assign
      324             next-seq = next-value(s-cagb-code, ub)
      325           .
      326         end.
      327         when 'fdgb':U then do:
      328           assign
      329             next-seq = next-value(s-fin-doc, ub)
      330           .
      331         end.
      332       end case.
      333     end.
      334   end procedure.
      335   procedure set-seq-cr :
      336     define input parameter type-code like ub.code-range.range-type no-undo .
      337     define input parameter set-val   like ub.code-range.first-code no-undo .
      338     do
      339     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      340     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
      341     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
      342     :
      343       case type-code:
      344         when 'bcgb':U then do:
      345           assign
      346             current-value(s-bcgb-code, ub) = set-val
      347           .
      348         end.
      349         when 'scgb':U then do:
      350           assign
      351             current-value(s-scgb-code, ub) = set-val
      352           .
      353         end.
      354         when 'sclc':U then do:
      355           assign
      356             current-value(s-sclc-code, ub) = set-val
      357           .
      358         end.
      359         when 'pglc':U then do:
      360           assign
      361             current-value(s-pglc-code, ub) = set-val
      362           .
      363         end.
      364         when 'dcgb':U then do:
      365           assign
      366             current-value(s-dcgb-code, ub) = set-val
      367           .
      368         end.
      369         when 'ctgb':U then do:
      370           assign
      371             current-value(s-ctgb-code, ub) = set-val
      372           .
      373         end.
      374         when 'drgb':U then do:
      375           assign
      376             current-value(s-drgb-code, ub) = set-val
      377           .
      378         end.
      379         when 'fmgb':U then do:
      380           assign
      381             current-value(s-fmgb-code, ub) = set-val
      382           .
      383         end.
      384         when 'pngb':U then do:
      385           assign
      386             current-value(s-pngb-code, ub) = set-val
      387           .
      388         end.
      389         when 'cagb':U then do:
      390           assign
      391             current-value(s-cagb-code, ub) = set-val
      392           .
      393         end.
      394         when 'fdgb':U then do:
      395           assign
      396             current-value(s-fin-doc, ub) = set-val
      397           .
      398         end.
      399       end case.
      400     end.
      401   end procedure.
      402   procedure new-bcod-gen-code-range :
      403     do
      404     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      405     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      406     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      407     :
      408       define input parameter p-db-num  like ub.db.db-num             no-undo .
      409       define input parameter type-code like ub.code-range.range-type no-undo .
      410       define buffer buf_code-range      for ub.code-range .
      411       define buffer last_code-range     for ub.code-range .
      412       define buffer last-1_code-range   for ub.code-range .
      413       define buffer last-2_code-range   for ub.code-range .
      414       define buffer last-3_code-range   for ub.code-range .
      415       define buffer buf_sys-ctrl        for ub.sys-ctrl .
      416       define variable conf-par       as character no-undo .
      417       define variable par-type       as character no-undo .
      418       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      419       define variable v-cre-cdrg as logical   no-undo .
      420       define variable v-cre-str  as character no-undo .
      421       define variable v-cr1      as integer no-undo .
      422       define variable v-cr2      as integer no-undo .
      423       define variable v-cr3      as integer no-undo .
      424       define variable v-cmax     as integer no-undo .
      425       find first buf_sys-ctrl no-lock .
      426       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
      427         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
      428                                       ,vss-workfile
      429                                       ,vss-revision
      430                                       ,vss-description
      431                                       ,chr(10)
      432                                       , p-db-num
      433                                      ).
      434       end.
      435       run trg/getpcode.p ( input  type-code
      436                      ,output cfg-param-code
      437                     ).
      438       for each buf_code-range
      439         where buf_code-range.db-num     = -1
      440           and buf_code-range.range-type = type-code
      441           and buf_code-range.stts       = "f"
      442       by buf_code-range.first-code
      443       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      444       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      445       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      446       :
      447         assign
      448           buf_code-range.db-num = p-db-num
      449         .
      450         return .
      451       end.
      452       assign
      453         v-cre-cdrg = TRUE
      454       .
      455       case type-code:
      456         when 'sclc':U
      457         or when 'scgb':U
      458         or when 'pglc':U
      459         then do:
      460           find last last-1_code-range no-lock
      461             where last-1_code-range.range-type = 'sclc':U
      462             no-error .
      463           if available last-1_code-range then do:
      464             v-cr1 = last-1_code-range.last-code.
      465           end.
      466           find last last-2_code-range no-lock
      467             where last-2_code-range.range-type = 'scgb':U
      468             no-error .
      469           if available last-2_code-range then do:
      470             v-cr2 = last-2_code-range.last-code.
      471             end.
      472           find last last-3_code-range no-lock
      473             where last-3_code-range.range-type = 'pglc':U
      474             no-error .
      475           if available last-3_code-range then do:
      476             v-cr3 = last-3_code-range.last-code.
      477           end.
      478           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      479           .
      480           if v-cmax = v-cr1  then do:
      481               find last last_code-range no-lock
      482                 where recid( last_code-range ) = recid( last-1_code-range )
      483                 .
      484             end.
      485           if v-cmax = v-cr2  then do:
      486               find last last_code-range no-lock
      487                 where recid( last_code-range ) = recid( last-2_code-range )
      488                 .
      489             end.
      490           if v-cmax = v-cr3  then do:
      491             find last last_code-range no-lock
      492               where recid( last_code-range ) = recid( last-3_code-range )
      493               .
      494           end.
      495           if last_code-range.last-code + 1 > 99999 then do:
      496             assign
      497               v-cre-cdrg = FALSE
      498             .
      499           end.
      500         end.
      501         when 'bcgb':U
      502         or when 'sslc':U
      503         or when 'ssgb':U
      504         then do:
      505           find last last-1_code-range no-lock
      506             where last-1_code-range.range-type = 'sslc':U
      507             no-error .
      508           if available last-1_code-range then do:
      509             v-cr1 = last-1_code-range.last-code.
      510           end.
      511           find last last-2_code-range no-lock
      512             where last-2_code-range.range-type = 'bcgb':U
      513             no-error .
      514           if available last-2_code-range then do:
      515             v-cr2 = last-2_code-range.last-code.
      516             end.
      517           find last last-3_code-range no-lock
      518             where last-3_code-range.range-type = 'ssgb':U
      519             no-error .
      520           if available last-3_code-range then do:
      521             v-cr3 = last-3_code-range.last-code.
      522           end.
      523           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      524           .
      525           if v-cmax = v-cr1  then do:
      526               find last last_code-range no-lock
      527                 where recid( last_code-range ) = recid( last-1_code-range )
      528                 .
      529             end.
      530           if v-cmax = v-cr2  then do:
      531               find last last_code-range no-lock
      532                 where recid( last_code-range ) = recid( last-2_code-range )
      533                 .
      534             end.
      535           if v-cmax = v-cr3  then do:
      536             find last last_code-range no-lock
      537               where recid( last_code-range ) = recid( last-3_code-range )
      538               .
      539           end.
      540         end.
      541         otherwise do:
      542           find last last_code-range no-lock
      543             where last_code-range.range-type = type-code
      544             no-error .
      545         end.
      546       end case.
      547       if not available last_code-range then do:
      548         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
      549                                       ,vss-workfile
      550                                       ,vss-revision
      551                                       ,vss-description
      552                                       , chr(10)
      553                                       , type-code
      554                                      ) .
      555       end.
      556       define variable v-mes0 as character no-undo .
      557       define variable v-param-type0 as character no-undo .
      558       define variable v-value-character0 as INTEGER no-undo .
      559       define variable v-value-date0 as date no-undo .
      560       define variable v-value-decimal0 as decimal no-undo .
      561       define variable v-value-integer0 AS integer no-undo .
      562       define variable v-value-logical0 AS LOGICAL no-undo .
      563       define variable v-tth0 as handle no-undo .
      564       run adm/shattri.p (
      565           input "get":U
      566           ,input  'БД':U
      567           ,input  p-db-num
      568           ,input  'code-range':U
      569           ,input  cfg-param-code
      570           ,output v-value-character0
      571           ,output v-value-date0
      572           ,output v-value-decimal0
      573           ,output v-value-integer0
      574           ,output v-value-logical0
      575           ,output v-param-type0
      576           ,INPUT-OUTPUT table-handle v-tth0
      577           ) no-error .
      578       if error-status :error then do:
      579         delete object v-tth0.
      580         v-mes0 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
      581                            , error-status:get-message(1)
      582                            , chr(10)
      583                            , return-value ).
      584         undo, return error v-mes0.
      585       end.
      586       delete object v-tth0.
      587       if v-cre-cdrg = TRUE then do:
      588         create buf_code-range .
      589         assign
      590           buf_code-range.db-num     = p-db-num
      591           buf_code-range.range-type = type-code
      592           buf_code-range.stts       = "f"
      593           buf_code-range.first-code = last_code-range.last-code + 1
      594           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer0)
      595           v-cre-str = "Свободный диапазон успешно создан"
      596         .
      597       end.
      598       else do:
      599         assign
      600           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
      601                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
      602         .
      603       end.
      604     end.
      605     return v-cre-str .
      606   end procedure.
      607   procedure gen-new-code-range-if-neces :
      608     define input parameter v-db-num           like ub.db.db-num             no-undo .
      609     define input parameter v-range-type       like ub.code-range.range-type no-undo .
      610     define input parameter v-cur-code         as   integer                  no-undo .
      611     define input parameter v-g#news           as   logical                  no-undo .
      612     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
      613     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
      614     do
      615     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      616     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
      617     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
      618     :
      619       define variable l-code-range-exist as logical   no-undo init false .
      620       define variable v-db-for-send      as character no-undo .
      621       define buffer buf_code-range  for ub.code-range .
      622       define buffer buf1_code-range for ub.code-range .
      623       define buffer buf_db          for ub.db .
      624       find first buf_code-range
      625         where buf_code-range.range-type = v-range-type
      626           and buf_code-range.last-code >= v-cur-code
      627         use-index last-codei
      628         no-error .
      629       if
      630       (
      631          available buf_code-range
      632          and
      633         (buf_code-range.db-num = v-db-num
      634           and
      635         buf_code-range.first-code <= v-cur-code
      636         )
      637       or
      638         (
      639           v-range-type = 'drgb':U
      640           AND
      641           v-cur-code = 0
      642         )
      643      )
      644      then do:
      645         assign
      646           l-code-range-exist = true
      647         .
      648         if v-g#news
      649         and buf_code-range.stts = "f" then do:
      650           assign
      651             buf_code-range.stts = "u"
      652           .
      653         end.
      654       end.
      655       if not l-code-range-exist
      656          and v-g#news-source-db <> 0
      657       then do:
      658         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
      659                                       ,vss-workfile
      660                                       ,vss-revision
      661                                       ,vss-description
      662                                       ,chr(10)
      663                                       ,v-db-num
      664                                       ,v-range-type
      665                                       ,v-cur-code
      666                                      ).
      667       end.
      668       if (not l-code-range-exist
      669           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
      670          )
      671       and ( not can-find (first buf1_code-range no-lock
      672                           where buf1_code-range.db-num = v-db-num
      673                             and buf1_code-range.range-type = v-range-type
      674                             and buf1_code-range.stts = "f"
      675                          )
      676           )
      677       then do:
      678         if v-g#db-num = 0 then do:
      679           run new-bcod-gen-code-range in this-procedure
      680             (input v-db-num,
      681              input v-range-type
      682             ) no-error .
      683           if error-status :error then do:
      684             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
      685                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
      686                                           ,v-db-num
      687                                           ,v-range-type
      688                                           ,v-cur-code
      689                                           ,chr(10)
      690                                           ,error-status:get-message(1)
      691                                           ,return-value
      692                                          ).
      693           end.
      694         end.
      695         else do:
      696           if v-range-type = 'sclc':U
      697           or v-range-type = 'pglc':U
      698           then do:
      699             assign
      700               v-db-for-send = "":U
      701             .
      702             if v-g#db-num = 0 then do:
      703               for each buf_db no-lock
      704                 where buf_db.db-num > 0
      705                   and buf_db.db-num <> v-g#news-source-db
      706               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      707               :
      708                 assign
      709                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
      710                 .
      711               end.
      712               assign
      713                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
      714               .
      715             end.
      716             else do:
      717               if not v-g#news then do:
      718                 assign
      719                   v-db-for-send = "0":U
      720                 .
      721               end.
      722             end.
      723             run nws/cr-route.p ( input 'send-cmd':U
      724                           ,input ("command":U + chr(1) + "create":U + chr(1) +
      725                                  "code-range":U + chr(1) +
      726                                  (if v-range-type = 'sclc':U
      727                                   then string( current-value(s-sclc-code, ub))
      728                                   else string( current-value(s-pglc-code, ub))
      729                                   ) + chr(1) +
      730                                   v-range-type)
      731                           ,input ?
      732                           ,input v-db-for-send
      733                           ) no-error .
      734             if error-status :error then do:
      735               undo, return error return-value.
      736             end.
      737           end.
      738         end.
      739       end.
      740     end.
      741   end procedure.
      742   procedure cre-loc-sc-code-range :
      743     define input parameter v-cur-code as integer no-undo .
      744   define input parameter p-cdrg-type as character no-undo .
      745     do
      746     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      747     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
      748     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
      749     :
      750       define buffer buf_code-range for ub.code-range .
      751       find first buf_code-range
      752            where buf_code-range.range-type = p-cdrg-type
      753              and buf_code-range.first-code >= v-cur-code
      754            no-error .
      755       if not available buf_code-range then do:
      756         run new-bcod-gen-code-range in this-procedure
      757           ( input 0,
      758             input p-cdrg-type
      759           ) no-error .
      760         if error-status :error then do:
      761           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
      762                                          + "Код &2&1&3 &4"
      763                                         , chr(10)
      764                                         , v-cur-code
      765                                         , error-status:get-message(1)
      766                                         , return-value
      767                                        ) .
      768         end.
      769       end.
      770     end.
      771   end procedure.
      772   procedure mark-used-if-need :
      773   define input parameter p-cur-code as integer no-undo .
      774   define input parameter p-range-type like ub.code-range.range-type no-undo .
      775   define input parameter p-db-num like ub.code-range.db-num no-undo .
      776     do
      777     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      778     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
      779     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
      780     :
      781       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
      782       define buffer buf_code-range for ub.code-range .
      783       assign
      784       v-db-num = if p-range-type = 'sclc':U
      785                  then 0
      786                  else p-db-num
      787       .
      788   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      789   define buffer locK-batchprocess1 for ub.batchprocess.
      790   run gbl/lock-prc.p
      791       (input 'lscc':U
      792       ,input 0
      793       ,input 0
      794       ,input 0
      795       ,input ""
      796       ,input ""
      797       ,input ""
      798       ,input (
      799               ",,,Вкл/выкл лок. вес. кодов"
      800              )
      801       ,input true
      802       ,buffer lock-batchprocess1
      803       ) no-error .
      804     if error-status :error then do:
      805       message
      806         vss-workfile vss-revision vss-description skip
      807         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
      808         view-as alert-box error .
      809       undo, return error .
      810     end.
      811       find first buf_code-range
      812            where buf_code-range.range-type = p-range-type
      813              and buf_code-range.first-code >= p-cur-code
      814              and buf_code-range.last-code <= p-cur-code
      815              and buf_code-range.db-num = v-db-num
      816            no-error .
      817       if not available buf_code-range then do:
      818         message
      819           vss-workfile vss-revision vss-description skip
      820           "Ошибка при создании поиске диапазона" skip
      821           "База данных" p-db-num skip
      822           "Код" p-cur-code skip
      823           "Тип" p-range-type
      824           error-status :get-message(1) skip
      825           return-value skip
      826           view-as alert-box error .
      827         undo, return error .
      828       end.
      829       if buf_code-range.stts = "f":U then do:
      830         assign
      831         buf_code-range.stts = "u":U
      832         .
      833       end.
      834     end.
      835   end procedure.
      836   define variable v-db-num like ub.db.db-num                no-undo .
      837   DEFINE BUTTON b-copy-codename
      838        LABEL "Копир."
      839        SIZE 10 BY 1.
      840   DEFINE BUTTON B-Help
      841        LABEL "Помо&щь"
      842        SIZE 10 BY 1
      843        BGCOLOR 8 .
      844   DEFINE BUTTON b-misc3
      845        IMAGE-UP FILE "btn-down-arrow":U
      846        IMAGE-DOWN FILE "btn-down-arrow":U
      847        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      848        LABEL "unit"
      849        SIZE 2.8 BY 1.
      850   DEFINE BUTTON b-quit AUTO-END-KEY
      851        LABEL "&Отмена"
      852        SIZE 10 BY 1
      853        BGCOLOR 8 .
      854   DEFINE BUTTON B-save AUTO-GO
      855        LABEL "&Ввод"
      856        SIZE 10 BY 1
      857        BGCOLOR 8 .
      858   DEFINE VARIABLE f-misc2 AS INTEGER FORMAT ">9":U INITIAL 0
      859        LABEL "НДС в ПЦ"
      860        VIEW-AS COMBO-BOX INNER-LINES 5
      861        LIST-ITEMS "0"
      862        DROP-DOWN-LIST
      863        SIZE 17 BY 1 NO-UNDO.
      864   DEFINE VARIABLE f-code AS CHARACTER FORMAT "X(30)":U INITIAL "генерируется автоматически"
      865        LABEL "Код"
      866        VIEW-AS FILL-IN
      867        SIZE 55 BY 1 NO-UNDO.
      868   DEFINE VARIABLE f-codename AS CHARACTER FORMAT "X(50)":U
      869        LABEL "Название в чеке"
      870        VIEW-AS FILL-IN
      871        SIZE 44 BY 1 NO-UNDO.
      872   DEFINE VARIABLE f-misc1 AS CHARACTER FORMAT "X(50)":U
      873        LABEL "Альт.название"
      874        VIEW-AS FILL-IN
      875        SIZE 44 BY 1 NO-UNDO.
      876   DEFINE VARIABLE f-misc3 AS CHARACTER FORMAT "X(10)":U
      877        LABEL "ЕИ в ПЦ"
      878        VIEW-AS FILL-IN
      879        SIZE 14 BY 1 TOOLTIP "Выберите из справочника, нажав кнопку справа" NO-UNDO.
      880   DEFINE FRAME Dialog-Frame
      881        B-save AT ROW 1 COL 1
      882        b-quit AT ROW 1 COL 11
      883        B-Help AT ROW 1 COL 36
      884        f-code AT ROW 2.52 COL 18 COLON-ALIGNED WIDGET-ID 2
      885        f-codename AT ROW 3.76 COL 18 COLON-ALIGNED WIDGET-ID 4
      886        b-copy-codename AT ROW 3.76 COL 64.8 WIDGET-ID 18
      887        f-misc1 AT ROW 5.05 COL 18 COLON-ALIGNED WIDGET-ID 10
      888        f-misc2 AT ROW 6.24 COL 18 COLON-ALIGNED WIDGET-ID 20
      889        f-misc3 AT ROW 7.43 COL 18 COLON-ALIGNED WIDGET-ID 14
      890        b-misc3 AT ROW 7.43 COL 34.6 WIDGET-ID 12
      891        SPACE(38.59) SKIP(0.94)
      892       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      893            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      894            TITLE "Сезон ДТ"
      895            DEFAULT-BUTTON B-save CANCEL-BUTTON b-quit.
      896   ASSIGN
      897          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      898          FRAME Dialog-Frame:HIDDEN           = TRUE.
      899   ASSIGN
      900          f-misc3:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      901   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      902   DO:
      903     APPLY "END-ERROR":U TO SELF.
      904   END.
      905   ON CHOOSE OF b-copy-codename IN FRAME Dialog-Frame
      906   DO:
      907     run setMisc1 in this-procedure (true).
      908   END.
      909   ON CHOOSE OF b-misc3 IN FRAME Dialog-Frame
      910   DO:
      911      define buffer units for units.
      912      define variable vRec as recid no-undo .
      913      do on error undo, return no-apply:
      914         run ref/units.w
      915               (input  iParentProc
      916               ,input  yes
      917               ,output vRec
      918               ).
      919         if vRec <> ? then do:
      920            find first units where recid(units) = vRec no-lock no-error.
      921            if avail units then do:
      922               display units.unit-name @ f-misc3 WITH FRAME Dialog-Frame.
      923            end.
      924         end.
      925      end.
      926   END.
      927   ON CHOOSE OF B-save IN FRAME Dialog-Frame
      928   DO:
      929     run proc-save in this-procedure no-error.
      930     if error-status:error then return no-apply.
      931   END.
      932   ON LEAVE OF f-codename IN FRAME Dialog-Frame
      933   DO:
      934     run setMisc1 in this-procedure (false).
      935   END.
      936   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      937   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      938   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      939   on help of frame Dialog-Frame
      940   do:
      941     run gbl/app_help.p
      942       (input this-procedure :file-name
      943       ,input ''
      944       ,input ?
      945       ) no-error.
      946     if error-status :error then do:
      947       message
      948         "Ошибка при вызове помощи"
      949         error-status :get-message(1)
      950         view-as alert-box .
      951     end.
      952   end.
      953   run minbtn-set in this-procedure .
      954   on choose of b-help in frame Dialog-Frame
      955   do:
      956     apply "help":u to frame Dialog-Frame .
      957   end.
      958   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      959   procedure minbtn-set :
      960       do
      961           on error undo, return error return-value
      962           :
      963           define variable ii              as integer       no-undo .
      964           define variable fh              as widget-handle no-undo .
      965           define variable hh              as widget-handle no-undo .
      966           define variable v-h             as handle        extent 4 no-undo .
      967           define variable v-name-button   as character     no-undo .
      968           define variable v-help-old-x    as decimal       no-undo .
      969           define variable v-help-old-y    as decimal       no-undo .
      970           define variable v-help-old-size as decimal       no-undo .
      971           define variable v-frame-width   as decimal       no-undo .
      972           define variable jj              as integer       no-undo .
      973           do
      974               on error undo, return error
      975               :
      976               assign
      977                   v-frame-width = frame Dialog-Frame:width - 0.3
      978                   fh            = frame Dialog-Frame:first-child
      979                   hh            = fh:first-child
      980                   ii            = 1
      981                   .
      982               do while valid-handle(hh):
      983                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      984                   do:
      985                       case lc(hh:name) :
      986                           when "b-help" then
      987                               do:
      988                                   hh:load-image-up("cmp/b-help.bmp":u) .
      989                                   hh:load-image-down("cmp/b-help.bmp":u) .
      990                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      991                                   hh:TOOLTIP = "Помощь" .
      992                                   v-help-old-x = hh:column .
      993                                   v-help-old-y = hh:row    .
      994                                   v-help-old-size = hh:width .
      995                                   hh:width-chars = 2.5 .
      996                               end.
      997                           when "b-print" then
      998                               do:
      999                                   hh:load-image("cmp/b-print.bmp":u) .
     1000                                   hh:TOOLTIP = "Печать" .
     1001                                   v-h[ii] = hh:handle .
     1002                                   ii = ii + 1 .
     1003                                   hh:width-chars = 3 .
     1004                               end.
     1005                           when "b-history" or
     1006                           when "b-hist" then
     1007                               do:
     1008                                   hh:load-image("cmp/b-hist.bmp":u) .
     1009                                   hh:TOOLTIP = "История" .
     1010                                   v-h[ii] = hh:handle .
     1011                                   ii = ii + 1 .
     1012                                   hh:width-chars = 3 .
     1013                               end.
     1014                           when "b-sch" then
     1015                               do:
     1016                                   hh:load-image("cmp/b-sch.bmp":u) .
     1017                                   hh:TOOLTIP = "Установка Фильтра" .
     1018                                   v-h[ii] = hh:handle .
     1019                                   ii = ii + 1 .
     1020                                   hh:width-chars = 3 .
     1021                               end.
     1022                           when "b-hist-user" then
     1023                               do:
     1024                                   hh:load-image("cmp/b-hist.bmp":u) .
     1025                                   hh:TOOLTIP = "История пользователя" .
     1026                                   ii = ii + 1 .
     1027                               end.
     1028                       end case.
     1029                   end.
     1030                   hh = hh:next-sibling.
     1031               end.
     1032               b-help:column = v-frame-width - b-help:width-chars.
     1033               jj = 0.
     1034               repeat ii = 4 to 1 by -1 :
     1035                   if valid-handle (v-h[ii] ) then
     1036                   do:
     1037                       jj  = jj + 1 .
     1038                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1039                       v-h[ii]:row    = v-help-old-y .
     1040                   end.
     1041               end.
     1042           end.
     1043       end.
     1044   end procedure.
     1045   MAIN-BLOCK:
     1046   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1047      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1048      if iMode <> 'ДОБАВЛЕНИЕ':U and
     1049         iMode <> 'ИЗМЕНЕНИЕ':U and
     1050         iMode <> 'КОПИРОВАНИЕ':U and
     1051         iMode <> 'ПРОСМОТР':U
     1052      then do:
     1053         message
     1054         vss-workfile vss-revision vss-description skip
     1055         "Неверное значение параметров вызова iMode"  iMode
     1056         view-as alert-box ERROR.
     1057         undo, return error.
     1058      end.
     1059   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1060   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1061     (output v-db-num
     1062     )  .
     1063      if v-db-num <> 0 and iMode <> 'ПРОСМОТР':U then do:
     1064         message
     1065         vss-workfile vss-revision vss-description skip
     1066         "Неверное значение параметров вызова iMode - нельзя изменять/добавлять записи <Сезоны ДТ> в УБД"
     1067         view-as alert-box ERROR.
     1068         undo, return error.
     1069      end.
     1070      run getMisc2 in this-procedure.
     1071      frame Dialog-Frame:title = frame Dialog-Frame:title + " - " + lc(iMode).
     1072      if iMode = 'ИЗМЕНЕНИЕ':U or iMode = 'КОПИРОВАНИЕ':U or iMode = 'ПРОСМОТР':U then do:
     1073         assign
     1074           f-code     = iCode:buffer-field('code'):buffer-value when iMode = 'ИЗМЕНЕНИЕ':U or iMode = 'ПРОСМОТР':U
     1075           f-codename = iCode:buffer-field('codename'):buffer-value
     1076           f-misc1    = iCode:buffer-field('misc1'):buffer-value
     1077           f-misc2    = iCode:buffer-field('misc2'):buffer-value
     1078           f-misc3    = iCode:buffer-field('misc3'):buffer-value
     1079         no-error.
     1080      end.
     1081      if iMode = 'ДОБАВЛЕНИЕ':U then do:
     1082         assign
     1083           f-misc2    = 20
     1084           f-misc3    = "лт"
     1085         no-error.
     1086      end.
     1087      run enable_UI in this-procedure.
     1088      if iMode = 'ПРОСМОТР':U then do:
     1089        disable
     1090          f-codename
     1091          f-misc1
     1092          f-misc2
     1093          f-misc3
     1094          b-save
     1095        with frame Dialog-Frame.
     1096        b-copy-codename:visible = false.
     1097        b-misc3:visible = false.
     1098      end.
     1099      else do:
     1100        apply "entry" to f-codename in FRAME Dialog-Frame.
     1101      end.
     1102      WAIT-FOR GO OF FRAME Dialog-Frame.
     1103   END.
     1104   session:data-entry-return = no .
     1105   RUN disable_UI.
     1106   PROCEDURE disable_UI :
     1107     HIDE FRAME Dialog-Frame.
     1108   END PROCEDURE.
     1109   PROCEDURE enable_UI :
     1110     DISPLAY f-code f-codename f-misc1 f-misc2 f-misc3
     1111         WITH FRAME Dialog-Frame.
     1112     ENABLE B-save b-quit B-Help f-codename b-copy-codename f-misc1 f-misc2
     1113            f-misc3 b-misc3
     1114         WITH FRAME Dialog-Frame.
     1115     VIEW FRAME Dialog-Frame.
     1116   END PROCEDURE.
     1117   PROCEDURE getMisc2 :
     1118   define buffer buf_tax            for ub.tax.
     1119   define buffer buf_tax-rate       for ub.tax-rate.
     1120   define buffer buf_tax-rate-value for ub.tax-rate-value.
     1121   define variable vListRates as character no-undo.
     1122   do with frame Dialog-Frame:
     1123       f-misc2:delete(1).
     1124       run getListTaxRateValue in g#library
     1125         ("НДС", ?, 0, "", 0, output vListRates).
     1126       f-misc2:list-items = vListRates.
     1127   end.
     1128   END PROCEDURE.
     1129   PROCEDURE proc-save :
     1130      define variable nextCode as integer no-undo.
     1131      define buffer units for units.
     1132      assign frame Dialog-Frame
     1133         f-codename
     1134         f-misc1
     1135         f-misc2
     1136         f-misc3
     1137      .
     1138      if f-codename = "" then do:
     1139        message "Ошибка при сохранении.~n"
     1140                "Необходимо заполнить поле <Название в чеке>." view-as alert-box.
     1141        apply "ENTRY" to f-codename in frame Dialog-Frame.
     1142        return error.
     1143      end.
     1144      do on error undo, return error
     1145      on stop undo, return error:
     1146         if iMode = 'ДОБАВЛЕНИЕ':U or iMode = 'КОПИРОВАНИЕ':U then do:
     1147            run gen-b-code IN THIS-PROCEDURE (
     1148              input 'bcgb':U
     1149              ,output nextCode
     1150            ) no-error.
     1151            if error-status:error then
     1152            do:
     1153              undo, return error return-value.
     1154            end.
     1155            assign
     1156               iCode:buffer-field("parent"):buffer-value = "DTSeasons"
     1157               iCode:buffer-field("code"):buffer-value   = string(nextCode)
     1158               iCode:buffer-field("status_"):buffer-value = 0
     1159            .
     1160         end.
     1161         assign
     1162           iCode:buffer-field("codename"):buffer-value = f-codename
     1163           iCode:buffer-field("misc1"):buffer-value    = f-misc1
     1164           iCode:buffer-field("misc2"):buffer-value    = f-misc2
     1165           iCode:buffer-field("misc3"):buffer-value    = f-misc3
     1166           iCode:buffer-field("export_"):buffer-value    = yes
     1167           iCode:buffer-field("nwsgbd"):buffer-value    = yes
     1168         .
     1169      end.
     1170      oIsOk = true.
     1171   END PROCEDURE.
     1172   PROCEDURE setMisc1 :
     1173   define input parameter setForcibly as logical no-undo.
     1174   do with frame Dialog-Frame:
     1175       if f-codename:screen-value <> "" and
     1176          (setForcibly or f-misc1:screen-value = "") then
     1177       do:
     1178         f-misc1:screen-value = substring(f-codename:screen-value,1,22).
     1179       end.
     1180   end.
     1181   END PROCEDURE.
