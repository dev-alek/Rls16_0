     2000    + "param-3-data-type" + chr(4) + "Тип данных3" + chr(4) + ""  + chr(8)
     2001    + "param-label" + chr(4) + "Лейбл параметра" + chr(4) + ""  + chr(8)
     2002    + "param-mode" + chr(4) + "Мода параметра" + chr(4) + ""  + chr(8)
     2003    + "param-name" + chr(4) + "Имя параметра" + chr(4) + ""  + chr(8)
     2004    + "p-index" + chr(4) + "Индекс" + chr(4) + ""  + chr(8)
     2005    + "param-num" + chr(4) + "№ параметра" + chr(4) + ""  + chr(8)
