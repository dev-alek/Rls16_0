     1623   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1624   define variable v-chg-fields as character no-undo.
     1625   define variable v-old-fields as character no-undo.
     1626   define variable v-new-fields as character no-undo.
     1627   define variable ii as integer no-undo.
     1628   define variable v-mess as character no-undo .
     1629   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1630   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1631   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1632   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1633   FUNCTION get-region RETURNS CHARACTER
     1634     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1635     define variable par-region as character no-undo.
     1636     if parhost-code = 0 and
     1637          parobj-type = "":U and
     1638          parobj-code = 0 then do:
     1639          par-region = "Глобально".
     1640          return par-region.
     1641       end.
     1642       if parobj-type = 'орг':U then do:
     1643          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1644          return par-region.
     1645       end.
     1646       if parobj-type = 'регион':U
     1647       then do:
     1648          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1649          return par-region.
     1650       end.
     1651       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1652       return par-region.
     1653   END FUNCTION.
     1654   FUNCTION get-objregion RETURNS CHARACTER
     1655     (  input parobj-type as character, input parobj-code as integer ) :
     1656     define variable par-region as character no-undo.
     1657     if  parobj-type = "":U and
     1658         parobj-code = 0
     1659     then do:
     1660        par-region = "Глобально".
     1661     end.
     1662     else if parobj-type = 'орг':U
     1663     then do:
     1664        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1665     end.
     1666     else if parobj-type = 'регион':U
     1667     then do:
     1668        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1669     end.
     1670     else
     1671        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1672     return par-region.
     1673   END FUNCTION.
     1674   FUNCTION calldscr returns character ( input p-call-id as character):
     1675   define variable v-descr as character no-undo .
     1676   define variable v-field-list as character no-undo .
     1677   define variable v-value-list as character no-undo.
     1678   define variable v-prop-label as character no-undo .
     1679   define variable v-node-label as character no-undo .
     1680   define variable v-dt-code as integer no-undo .
     1681   define variable v-host-code as integer no-undo .
     1682   define variable v-obj-type as character no-undo .
     1683   define variable v-obj-code as integer no-undo .
     1684   define variable v-label as character no-undo .
     1685   define variable v-node-code as integer no-undo .
     1686   define buffer buf_prop-head for ub.prop-head.
     1687   define buffer buf_prop-ref for ub.prop-ref.
     1688   define buffer buf_prop-map for ub.prop-map.
     1689   run gen-key-fv in this-procedure ( input p-call-id
     1690                                     ,output v-field-list
     1691                                     ,output v-value-list) no-error .
     1692   if error-status:error then return p-call-id.
     1693   CASE entry(1, p-call-id, chr(3)):
     1694     when 'dis-card-type':U then do:
     1695       v-descr = substitute("Тип ДК: эмитент &1 тип: &2"
     1696                            ,integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1697                            ,entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
     1698                            ).
     1699     end.
     1700     when 'dis-card':U then do:
     1701       v-descr = substitute("ДК: № &1"
     1702                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1703                            ).
     1704     end.
     1705     when 'dis-card-property':U then do:
     1706       v-dt-code = integer(entry(lookup("dt-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1707       v-node-code = integer(entry(lookup("node-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1708       v-host-code = integer(entry(lookup("host-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1709       v-obj-type = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3)) .
     1710       v-obj-code = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1711       find first buf_prop-ref no-lock where
     1712                 buf_prop-ref.dt-code = v-dt-code no-error .
     1713       if available buf_prop-ref then do:
     1714         find first buf_prop-head no-lock where
     1715                   buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error .
     1716         v-prop-label = buf_prop-head.prop-label.
     1717         find first buf_prop-map no-lock where
     1718                   buf_prop-map.dtm-code = buf_prop-ref.dtm-code
     1719               and buf_prop-map.node-code = v-node-code no-error .
     1720         if available buf_prop-map then do:
     1721           v-label = buf_prop-map.node-label.
     1722         end.
     1723       end.
     1724       v-descr = substitute("ДК: № &1 &2:&3 &4"
     1725                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1726                            ,v-prop-label
     1727                            ,v-label
     1728                            ,get-region(v-host-code, v-obj-type, v-obj-code)
     1729                            ).
     1730     end.
     1731     when 'clients':U then do:
     1732       v-descr = substitute("&1&2"
     1733                            ,entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
     1734                            ,integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1735                            ).
     1736     end.
     1737     when 'ext-system':U then do:
     1738       v-descr = substitute("Внешняя система &1"
     1739                            ,integer(entry(lookup("esys-id", v-field-list, chr(3)), v-value-list, chr(3)))
     1740                            ).
     1741     end.
     1742     WHEN 'thbj-attr':U then do:
     1743       if entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum':U
     1744       or entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum_obj':U
     1745       then do:
     1746         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'goods':U then do:
     1747           v-descr = "Операции с товарами".
     1748         end.
     1749         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'clients':U then do:
     1750           v-descr = "Операции с клиентами".
     1751         end.
     1752         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'gds-grp':U then do:
     1753           v-descr = "Операции с группами товаров".
     1754         end.
     1755         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'cli-grp':U then do:
     1756           v-descr = "Операции с группами клиентов".
     1757         end.
     1758         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th':U then do:
     1759           v-descr = "Операции с чеками на POS IBS-TH".
     1760         end.
     1761         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th-mob':U then do:
     1762           v-descr = "Операции с чеками на POS IBS-TH-MOB".
     1763         end.
     1764         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'edoc':U then do:
     1765           v-descr = "Операции в системе электронного документооборота".
     1766         end.
     1767         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'thref':U then do:
     1768           v-descr = "Операции со справочниками".
     1769         end.
     1770         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'pdf':U then do:
     1771           v-descr = "Операции с ДНЦ и переоценками".
     1772         end.
     1773         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rep':U then do:
     1774           v-descr = "Отчеты".
     1775         end.
     1776         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'ord':U then do:
     1777           v-descr = "Операции с заказами".
     1778         end.
     1779       end.
     1780     end.
     1781     when 'cash-desk':U then do:
     1782       v-descr = substitute("БД &1 Маг &2 Касса № &4 &3"
     1783                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1784                            ,entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3))
     1785                            ,entry(lookup("cash-num", v-field-list, chr(3)), v-value-list, chr(3))
     1786                            ,entry(lookup("pos-type", v-field-list, chr(3)), v-value-list, chr(3))
     1787                            ).
     1788     end.
     1789     when 'ext-file':U then do:
     1790       v-descr = substitute("БД &1 Файл № &3 (из БД &2)"
     1791                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1792                            ,entry(lookup("from-db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1793                            ,entry(lookup("file-num", v-field-list, chr(3)), v-value-list, chr(3))
     1794                            ).
     1795     end.
     1796   end case.
     1797   return v-descr.
     1798   end function.
     1799   define variable v-thbj-attr-uniq-key-rec as character no-undo .
     1800   define buffer current_c-thbj-attr for ub.c-thbj-attr.
     1801   function  getPSwd returns character (istr as char ):
     1802      return fill("*",length(istr)).
     1803   end.
     1804   procedure thbj-attr-self-proc :
     1805   define input parameter p-action as integer no-undo .
     1806   define output parameter p-description as character no-undo .
     1807   define variable v-tooltip as character no-undo .
     1808   define variable v-label as character no-undo .
     1809   define variable v-tooltip-code as character no-undo .
     1810   define variable v-global as logical no-undo .
     1811   define variable v-host as logical no-undo .
     1812   define variable v-shop as logical no-undo .
     1813   define variable v-store as logical no-undo .
     1814   define variable v-db as logical   no-undo .
     1815   define variable v-other as character no-undo .
     1816   define variable v-user-can-edit as logical no-undo .
     1817   define variable v-output-display as logical no-undo .
     1818   define variable v-prop-list as character no-undo .
     1819   define variable v-prop-type-list as character no-undo .
     1820   define variable v-prop-label-list as character no-undo .
     1821   define variable v-fields-name-list as character no-undo .
     1822   define variable v-label-param as character no-undo .
     1823   define variable v-prop-code-num as integer no-undo .
     1824   define variable v-type as character no-undo .
     1825   do
     1826   on error undo, return error
     1827   :
     1828     run thbjattr_tooltip in this-procedure (
     1829                   input  current_c-thbj-attr.upper-prop-code
     1830                 ,input  current_c-thbj-attr.prop-code
     1831                 ,output v-tooltip
     1832                 ,output v-label
     1833                 ,output v-tooltip-code
     1834                 ) no-error .
     1835     p-description = "Параметр" + chr(32) + v-label.
     1836     run thbjattr_code in this-procedure (
     1837         input  current_c-thbj-attr.upper-prop-code
     1838         ,input current_c-thbj-attr.prop-code
     1839         ,output v-label
     1840         ,output v-user-can-edit
     1841         ,output v-output-display
     1842         ,output v-other
     1843         ,output v-prop-list
     1844         ,output v-prop-type-list
     1845         ,output v-prop-label-list
     1846         ,output v-global
     1847         ,output v-host
     1848         ,output v-shop
     1849         ,output v-store
     1850         ,output v-db
     1851         ) no-error .
     1852     assign
     1853     v-prop-code-num = lookup(current_c-thbj-attr.prop-code, v-prop-list)
     1854     v-type = entry(v-prop-code-num, v-prop-type-list)
     1855     no-error
     1856     .
     1857     if current_c-thbj-attr.subject = 'thbj-attr':U
     1858     or current_c-thbj-attr.subject = ''
     1859     then do:
     1860           v-label-param =  "upper-prop-code" + chr(4) + "Группа параметра" + chr(4) + "" + chr(8)
     1861                       + " prop-code" + chr(4) + "Параметр" + chr(4) + "" + chr(8)
     1862                       + "prop-value-type" + chr(4) + "Тип Значения" + chr(4) + "" + chr(8)
     1863                       + "obj-type" + chr(4) + "Тип объекта" + chr(4) + "" + chr(8)
     1864                       + "obj-code" + chr(4) + "Код объекта" + chr(4) + ""  .
     1865       case v-type:
     1866         when 'character':U then do:
     1867            if     current_c-thbj-attr.upper-prop-code eq "gismt"
     1868               and (current_c-thbj-attr.prop-code eq "oflinepswd"
     1869                    or current_c-thbj-attr.prop-code eq "proxypswd"
     1870                    or current_c-thbj-attr.prop-code eq "MaxApiToken")
     1871            then v-label-param = "property-value-character" + chr(4) + "Значение(строк.)" + chr(4) + "getpswd" + chr(8) +
     1872                         v-label-param.
     1873            else assign
     1874                v-label-param = "property-value-character" + chr(4) + "Значение(строк.)" + chr(4) + "" + chr(8) +
     1875                         v-label-param.
     1876           v-fields-name-list = "property-value-character," + "upper-prop-code, prop-code,prop-value-type,obj-type,obj-code".
     1877         end.
     1878         when 'date':U then do:
     1879           v-label-param = "property-value-date" + chr(4) + "Значение(Дата)" + chr(4) + "" + chr(8)  +
     1880                         v-label-param.
     1881           v-fields-name-list = "property-value-date," + "upper-prop-code, prop-code,prop-value-type,obj-type,obj-code".
     1882         end.
     1883         when 'decimal':U then do:
     1884           v-label-param = "property-value-decimal" + chr(4) + "Значение" + chr(4) + "" + chr(8) +
     1885                           v-label-param.
     1886           v-fields-name-list = "property-value-decimal," + "upper-prop-code, prop-code,prop-value-type,obj-type,obj-code".
     1887         end.
     1888         when 'integer':U then do:
     1889           v-label-param = "property-value-integer" + chr(4) + "Значение" + chr(4) + "" + chr(8) +
     1890                           v-label-param.
     1891           v-fields-name-list = "property-value-integer," + "upper-prop-code, prop-code,prop-value-type,obj-type,obj-code".
     1892         end.
     1893         when 'logical':U then do:
     1894           v-label-param = "property-value-logical" + chr(4) + "Значение" + chr(4) + "" + chr(8) +
     1895           v-label-param.
     1896           v-fields-name-list = "property-value-logical," + "upper-prop-code, prop-code,prop-value-type,obj-type,obj-code".
     1897         end.
     1898       end case.
     1899       run proc-full-temp-changes in this-procedure (
     1900                                                   input p-action = integer('1':U)
     1901                                                   ,input p-action = integer('99':U)
     1902                                                   ,input  buffer current_c-thbj-attr:handle
     1903                                                   ,input  'thbj-attr':U
     1904                                                   ,input  v-fields-name-list
     1905                                                   ,input  v-label-param).
     1906     end.
     1907   end.
     1908   end procedure.
     1909   procedure rp-by-call-proc :
     1910   define output parameter p-description as character no-undo .
     1911   define buffer current_c-rp-by-call for ub.c-rp-by-call .
     1912     do
     1913     on error undo, return error
     1914     :
     1915       find first current_c-rp-by-call no-lock where
     1916                  current_c-rp-by-call.chip-num = current_c-thbj-attr.chip-num
     1917              AND current_c-rp-by-call.corr-user-db-num = current_c-thbj-attr.corr-user-db-num
     1918              AND current_c-rp-by-call.call_id = v-thbj-attr-uniq-key-rec no-error .
     1919       if not avail current_c-rp-by-call then do:
     1920          v-mess = "Неверная ссылка на c-rp-by-call в таблице c-thbj-attr".
     1921          run err-mess(input-output v-mess).
     1922       end.
     1923   define variable v-label-param as character no-undo .
     1924   v-label-param =
     1925     "call_id" + chr(4) + "Точка вызова" + chr(4) + "calldscr" + chr(8)
     1926    + "call#_id" + chr(4) + "Уник.идент.точки вызова" + chr(4) + "" + chr(8)
     1927    + "profile_id" + chr(4) + "Профайл" + chr(4) + "" .
     1928    run proc-full-temp-changes in this-procedure (
     1929                                                input  (current_c-thbj-attr.action = integer('1':U))
     1930                                               ,input  (current_c-thbj-attr.action = integer('99':U))
     1931                                               ,input  buffer current_c-rp-by-call:handle
     1932                                               ,input  'rp-by-call':U
     1933                                               ,input  "call_id,call#_id,profile_id"
     1934                                               ,input  v-label-param).
     1935   end.
     1936   end procedure.
