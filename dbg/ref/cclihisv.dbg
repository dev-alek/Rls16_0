     2553    + "cd-bc-alt" + chr(4) + "На кассу бар-код доп. ед. изм." + chr(4) + "" + chr(8)
     2554    + "cd-bc-base" + chr(4) + "На кассу бар-код осн. ед. изм." + chr(4) + "" + chr(8)
     2555    + "cd-loc-alt" + chr(4) + "На кассу лок. код доп. ед. изм." + chr(4) + "" + chr(8)
     2556    + "cd-loc-base" + chr(4) + "На кассу лок. код осн. ед. изм." + chr(4) + "" + chr(8)
     2557    + "cd-parts-all" + chr(4) + "На кассу код партии для всех товаров" + chr(4) + "" + chr(8)
     2558    + "cd-parts-not-blank" + chr(4) + "На кассу коды партий с непустыми номерами" + chr(4) + "" + chr(8)
     2559    + "cd-parts-ser" + chr(4) + "На кассу партии для сер.тов." + chr(4) + "" + chr(8)
     2560    + "cd-pb-alt" + chr(4) + "На кассу Доп. БК доп. ед. изм." + chr(4) + "" + chr(8)
     2561    + "cd-pb-base" + chr(4) + "На кассу доп. БК осн. ед. изм." + chr(4) + "" + chr(8)
     2562    + "cd-sc-base" + chr(4) + "На кассу вес. код" + chr(4) + "" + chr(8)
     2563    + "cel-nazn-code-in" + chr(4) + "Код целев. назн. по умолч" + chr(4) + "" + chr(8)
     2564    + "chk-pay" + chr(4) + "Код оплаты продажи" + chr(4) + "" + chr(8)
     2565    + "cons-vat-pc" + chr(4) + "Консигнационный НДС" + chr(4) + "" + chr(8)
     2566    + "contract-city" + chr(4) + "Город" + chr(4) + "" + chr(8)
     2567    + "contract-type" + chr(4) + "Тип контракта" + chr(4) + "" + chr(8)
     2568    + "cor-acc-in" + chr(4) + "Корр. счет по умолч" + chr(4) + "" + chr(8)
     2569    + "cor-acc1-in" + chr(4) + "Корр. счет1 по умолч" + chr(4) + "" + chr(8)
     2570    + "cost-calc" + chr(4) + "Расчет учетных цен" + chr(4) + "" + chr(8)
     2571    + "credit-pay" + chr(4) + "Платеж в кредит на кассе" + chr(4) + "" + chr(8)
     2572    + "down-pay" + chr(4) + "Оплата списания" + chr(4) + "" + chr(8)
     2573    + "fbr-pay" + chr(4) + "Код Оплаты пр-ва" + chr(4) + "" + chr(8)
     2574    + "fin-SLT-pc" + chr(4) + "Налог с продаж" + chr(4) + "" + chr(8)
     2575    + "fin-VAT-pc" + chr(4) + "НДС" + chr(4) + "" + chr(8)
     2576    + "firm-db-num" + chr(4) + "Номер БД фирмы" + chr(4) + "" + chr(8)
     2577    + "head-position" + chr(4) + "Должность рук-ля" + chr(4) + "" + chr(8)
     2578    + "holidays" + chr(4) + "Выходные" + chr(4) + "" + chr(8)
     2579    + "in-ov" + chr(4) + "Переоценка после ПН" + chr(4) + "" + chr(8)
     2580    + "in-pay" + chr(4) + "Оплата прихода" + chr(4) + "" + chr(8)
     2581    + "in-perm" + chr(4) + "Добавление ПН на пассивном складе" + chr(4) + "" + chr(8)
     2582    + "inout-price" + chr(4) + "Изменение налогов поставщика в ПН" + chr(4) + "" + chr(8)
