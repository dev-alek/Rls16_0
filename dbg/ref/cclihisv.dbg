     1968                                               ,input  buffer current_c-rule-by-call:handle
     1969                                               ,input  'rule-by-call':U
     1970                                               ,input  "call_id,call#_id,profile_id,can-calc,can-run,codex_id,ruleset_id,order_id,algo-des,rule_id,is_dynamic"
     1971                                               ,input  v-label-param).
     1972   end.
