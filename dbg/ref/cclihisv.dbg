     2892   procedure staff-proc :
     2893   define output parameter p-description as character no-undo .
     2894   define buffer current_c-staff for ub.c-staff  .
     2895   do
     2896   on error undo, return error return-value  :
     2897   find first current_c-staff no-lock where
     2898               current_c-staff.psn-code = p-obj-code
     2899           AND current_c-staff.chip-num = p-chip-num
     2900           AND current_c-staff.corr-user-db-num = p-corr-user-db-num
     2901           no-error .
     2902   if not avail current_c-staff then do:
     2903       v-mess = "Неверная ссылка на c-staff в таблице c-cli-hist".
     2904       run err-mess ( input-output v-mess).
     2905       return error  (if p-silent then v-mess else '':U).
     2906   end.
     2907   define variable v-label-param as character no-undo .
     2908   v-label-param =
     2909     "date-start" + chr(4) + "Начало работы" + chr(4) + "" + chr(8)
     2910    + "date-end" + chr(4) + "Окончание работы" + chr(4) + "" + chr(8)
     2911    + "db-num" + chr(4) + "БД" + chr(4) + "" + chr(8)
     2912    + "host-code" + chr(4) + "Фирма" + chr(4) + "" + chr(8)
     2913    + "obj-type" + chr(4) + "Тип объекта" + chr(4) + "" + chr(8)
     2914    + "obj-code" + chr(4) + "Код объекта" + chr(4) + ""  .
     2915    run proc-full-temp-changes in this-procedure (
     2916                                                input buf_c-cli-hist.action = integer('1':U)
     2917                                               ,input buf_c-cli-hist.action = integer('99':U)
     2918                                               ,input  buffer current_c-staff:handle
     2919                                               ,input  'staff':U
     2920                                               ,input  "date-start,date-end,db-num,host-code,obj-type,obj-code"
     2921                                               ,input  v-label-param).
     2922   end.
