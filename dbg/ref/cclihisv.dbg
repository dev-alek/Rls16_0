     2924   FUNCTION get-dis-thbj-rule-name returns character ( input p-dis-thbj-rule-code as character):
     2925   define variable v-name as character no-undo .
     2926   v-name =  entry (lookup (p-dis-thbj-rule-code, 'pcnt-tot-kateg,dflt-gds-temp-disc,abs-tot-kateg,pcnt-codes,kateg-codes,free-discnt-flag,pmnt-discnt-flag,kat-gds-grp,temp-disc-pdf,pcnt-kat-pdf,bonus-tot,bonus-all':u) + 1, ',' + '% Скидка на итог,Временная скидка на товар по умолчанию,Abs Скидка на итог,Коды % скидок,Коды категорий,Флаг своб.скидки,Флаг уст. скидки на платеж,Ск-ка на группу товаров для кат.клиентов,Временная через ТПЛ,Категорийная через ТПЛ,Начисление бонусов на сумму чека,Правило-итого бонусов по чеку':u).
     2927   return v-name.
     2928   end FUNCTION.
     2929   procedure dis-thbj-rule-proc :
     2930   define output parameter p-description as character no-undo .
     2931   define variable v-tooltip as character no-undo .
     2932   define variable v-label as character no-undo .
     2933   define variable v-old-position as character no-undo .
     2934   define variable v-new-position as character no-undo .
     2935   define variable v-last as logical no-undo .
     2936   define variable v-field-name as character no-undo .
     2937   define variable v-field-function as character no-undo .
     2938   define variable jj as integer no-undo .
     2939   define variable v-field-label  as character no-undo .
     2940   define variable v-field-list as character no-undo .
     2941   define buffer current_dis-thbj-rule for ub.dis-thbj-rule  .
     2942   define buffer current_c-dis-thbj-rule for ub.c-dis-thbj-rule  .
     2943   define buffer new_c-dis-thbj-rule for ub.c-dis-thbj-rule  .
     2944   define buffer new_c-cli-hist for ub.c-cli-hist  .
     2945     do
     2946     on error undo, return error return-value
     2947     :
     2948       if p-obj-type = 'орг':U then do:
     2949         find first current_c-dis-thbj-rule no-lock where
     2950                   current_c-dis-thbj-rule.obj-type = '':U
     2951               and current_c-dis-thbj-rule.obj-code = 0
     2952               AND current_c-dis-thbj-rule.chip-num = p-chip-num
     2953               AND current_c-dis-thbj-rule.corr-user-db-num = p-corr-user-db-num
     2954               no-error .
     2955       end.
     2956       else do:
     2957         find first current_c-dis-thbj-rule no-lock where
     2958                   current_c-dis-thbj-rule.obj-type = p-obj-type
     2959               AND current_c-dis-thbj-rule.obj-code = p-obj-code
     2960               AND current_c-dis-thbj-rule.chip-num = p-chip-num
     2961               AND current_c-dis-thbj-rule.corr-user-db-num = p-corr-user-db-num
     2962               no-error .
     2963       end.
     2964       if not avail current_c-dis-thbj-rule then do:
     2965          v-mess = "Неверная ссылка на c-dis-thbj-rule в таблице c-cli-hist".
     2966          run err-mess ( input-output v-mess).
     2967          return error  (if p-silent then v-mess else '':U).
     2968       end.
     2969       find first new_c-dis-thbj-rule no-lock where
     2970                 new_c-dis-thbj-rule.host-code = current_c-dis-thbj-rule.host-code
     2971             and new_c-dis-thbj-rule.obj-type = current_c-dis-thbj-rule.obj-type
     2972             and new_c-dis-thbj-rule.obj-code = current_c-dis-thbj-rule.obj-code
     2973             and new_c-dis-thbj-rule.pos-type = current_c-dis-thbj-rule.pos-type
     2974             and new_c-dis-thbj-rule.discnt-role = current_c-dis-thbj-rule.discnt-role
     2975             and new_c-dis-thbj-rule.nonunique = current_c-dis-thbj-rule.nonunique
     2976             AND new_c-dis-thbj-rule.chip-num > p-chip-num
     2977             AND new_c-dis-thbj-rule.corr-user-db-num = p-corr-user-db-num no-error.
     2978       if not available new_c-dis-thbj-rule then do:
     2979       find first current_dis-thbj-rule no-lock where
     2980                 current_dis-thbj-rule.host-code = current_c-dis-thbj-rule.host-code
     2981             and current_dis-thbj-rule.obj-type = current_c-dis-thbj-rule.obj-type
     2982             and current_dis-thbj-rule.obj-code = current_c-dis-thbj-rule.obj-code
     2983             and current_dis-thbj-rule.pos-type = current_c-dis-thbj-rule.pos-type
     2984             and current_dis-thbj-rule.discnt-role = current_c-dis-thbj-rule.discnt-role
     2985             and current_dis-thbj-rule.nonunique = current_c-dis-thbj-rule.nonunique no-error.
     2986         if not available current_dis-thbj-rule then do:
     2987           return error.
     2988         end.
     2989         buffer-compare current_dis-thbj-rule to current_c-dis-thbj-rule
     2990         case-sensitive
     2991         save result in v-chg-fields.
     2992       end.
     2993       else do:
     2994         buffer-compare new_c-dis-thbj-rule except chip-num corr-date corr-time corr-user-name corr-user-db-num
     2995         to current_c-dis-thbj-rule
     2996         case-sensitive
     2997         save result in v-chg-fields.
     2998       end.
     2999     _ii:
     3000     do ii = 1 to num-entries(v-chg-fields):
     3001       assign
     3002       v-field-name = entry(ii, v-chg-fields)
     3003       jj = lookup(v-field-name, "pos-type,disnct-role,templ-rl-root,rule-num,key#_one,Key#_two,key#_three,CHarkey_one,Charkey_two,Charkey_three").
     3004       if jj = 0 then next _ii.
     3005       assign
     3006       v-field-label = entry(jj, "Место использ.,Тип скидки,Тип шаблона,№ правила,Код 1,Код 2,Код 3,Скод 1,Скод 2,Скод 3")
     3007       v-field-function = entry(jj, ",get-dis-thbj-rule-name,,,,,")
     3008       .
     3009       create temp-changes.
     3010       assign
     3011       temp-changes.f_name = v-field-name
     3012       temp-changes.l_name = v-field-label
     3013       temp-changes.v_old = string(buffer current_c-dis-thbj-rule:buffer-field(v-field-name):buffer-value)
     3014       temp-changes.v_new =  (if available new_c-dis-thbj-rule
     3015                                   then string(buffer new_c-dis-thbj-rule:buffer-field(v-field-name):buffer-value)
     3016                                   else string(buffer current_dis-thbj-rule:buffer-field(v-field-name):buffer-value)
     3017                              )
     3018       .
     3019       if v-field-function <> '':U then do:
     3020         assign
     3021         temp-changes.v_old = DYNAMIC-function(v-field-function, temp-changes.v_old)
     3022         temp-changes.v_new = DYNAMIC-function(v-field-function, temp-changes.v_new)
     3023         .
     3024       end.
     3025      end.
     3026    end.
     3027   end procedure.
     3028   procedure thbj-attr-proc :
     3029   define output parameter p-description as character no-undo .
     3030   do
     3031   on error undo, return error return-value
     3032   :
     3033     find first current_c-thbj-attr no-lock where
     3034                 current_c-thbj-attr.obj-type = p-obj-type
     3035             AND current_c-thbj-attr.obj-code = p-obj-code
     3036             AND current_c-thbj-attr.chip-num = p-chip-num
     3037             AND current_c-thbj-attr.corr-user-db-num = p-corr-user-db-num
     3038             no-error .
     3039     if not avail current_c-thbj-attr then do:
     3040         v-mess = "Неверная ссылка на c-thbj-attr в таблице c-cli-hist".
     3041         run err-mess ( input-output v-mess).
     3042         return error (if p-silent then v-mess else '':U).
     3043     end.
     3044     create temp-thbj-attr.
     3045     assign
     3046     temp-thbj-attr.upper-prop-code       = current_c-thbj-attr.upper-prop-code
     3047     temp-thbj-attr.prop-code             = current_c-thbj-attr.prop-code
     3048     temp-thbj-attr.obj-type              = current_c-thbj-attr.obj-type
     3049     temp-thbj-attr.obj-code              = current_c-thbj-attr.obj-code
     3050     .
     3051     run gen-key-rec in this-procedure ( input 'thbj-attr':U
     3052                                       ,input (buffer temp-thbj-attr:handle)
     3053                                       ,output v-thbj-attr-uniq-key-rec) .
     3054     if current_c-thbj-attr.subject = ''
     3055     or current_c-thbj-attr.subject = 'thbj-attr':U then do:
     3056       run thbj-attr-self-proc in this-procedure (input buf_c-cli-hist.action, output p-description) no-error.
     3057     end.
     3058     else do:
     3059       case current_c-thbj-attr.subject:
     3060         when 'rp-by-call':U then do:
     3061           run rp-by-call-proc in this-procedure(output p-description) no-error .
     3062         end.
     3063         when 'rule-by-call':U then do:
     3064           run rule-by-call-proc in this-procedure(output p-description) no-error .
     3065         end.
     3066         when 'rule-call-param':U then do:
     3067           run rule-call-param-proc in this-procedure(output p-description) no-error .
     3068         end.
     3069       end case.
     3070     end.
     3071   end.
     3072   end procedure.
     3073   define temp-table temp-clients no-undo like ub.clients.
     3074   procedure ext-classif-proc :
     3075   define output parameter p-description as character no-undo .
     3076   define variable v-uniq-key-rec as character no-undo .
     3077   define variable v-field-list as character no-undo .
     3078   define variable v-value-list as character no-undo .
     3079   define variable v-label-param as character no-undo .
     3080   define buffer curr_c-ext-classif for ub.c-ext-classif  .
     3081   do
     3082   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3083   :
     3084       create temp-clients.
     3085       buffer-copy buf_c-cli-hist to temp-clients.
     3086       run gen-key-rec in this-procedure ( input 'clients':U
     3087                                          ,input (buffer temp-clients:handle)
     3088                                          ,output v-uniq-key-rec).
     3089       delete temp-clients.
     3090       find first curr_c-ext-classif no-lock where
     3091                  curr_c-ext-classif.classif-subject = 'clients':U
     3092              and curr_c-ext-classif.uniq-key-rec = v-uniq-key-rec
     3093              AND curr_c-ext-classif.chip-num = p-chip-num
     3094              AND curr_c-ext-classif.corr-user-db-num = p-corr-user-db-num
     3095              no-error .
     3096       if not avail curr_c-ext-classif then do:
     3097          v-mess = "Неверная ссылка на c-ext-classif в таблице c-cli-hist".
     3098          run err-mess in this-procedure ( input-output v-mess).
     3099          return error v-mess.
     3100       end.
     3101    run proc-full-temp-changes in this-procedure (
     3102                                                input  (buf_c-cli-hist.action = integer('1':U))
     3103                                               ,input  (buf_c-cli-hist.action = integer('99':U))
     3104                                               ,input  buffer curr_c-ext-classif:handle
     3105                                               ,input  'ext-classif':U
     3106                                               ,input  "pos-type,disnct-role,templ-rl-root,rule-num,key#_one,Key#_two,key#_three,CHarkey_one,Charkey_two,Charkey_three"
     3107                                               ,input  v-label-param).
     3108   end.
     3109   end procedure.
     3110   PROCEDURE err-mess:
     3111     DEFINE INPUT-output PARAMETER p-mess as character No-UNDO.
     3112     CASE p-silent:
     3113       when yes then do:
     3114         p-mess =
     3115         substitute("История контрагента  &1&2: щепка &3 БД:&4 фирма: &5  Предмет изменений &6&7&8"
     3116                    ,p-obj-type
     3117                    , p-obj-code
     3118                    , p-chip-num
     3119                    , p-corr-user-db-num
     3120                    , p-host-code
     3121                    , p-subject
     3122                    , chr(10)
     3123                    , p-mess
     3124                    ).
     3125       end.
     3126       otherwise do:
     3127         message
     3128         p-mess
     3129         view-as alert-box error .
     3130       end.
     3131     end.
     3132   END PROCEDURE.
