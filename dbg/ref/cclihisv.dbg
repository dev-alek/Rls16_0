      368   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      369   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
      370                                                       ,input p-range-type as character
      371                                                       ,input p-code as integer):
      372   define variable v-seq-val as integer no-undo .
      373   define buffer buf_code-range for ub.code-range.
      374   find first buf_code-range no-lock where
      375             buf_code-range.db-num = p-db-num
      376       and  buf_code-range.range-type = p-range-type
      377       and  buf_code-range.stts = 'u'
      378       and buf_code-range.first-code <= p-code
      379       and buf_code-range.last-code >= p-code no-error .
      380   if available buf_code-range then return yes.
      381   CASE p-range-type:
      382     when 'pngb':U then do:
      383       v-seq-val = current-value(s-pngb-code, ub).
      384     end.
      385     when 'fmgb':U then do:
      386       v-seq-val = current-value(s-fmgb-code, ub).
      387     end.
      388   END CASE.
      389   if p-code <= v-seq-val then do:
      390     find first buf_code-range no-lock where
      391               buf_code-range.db-num = p-db-num
      392         and  buf_code-range.range-type = p-range-type
      393         and  buf_code-range.stts = 'a'
      394         and buf_code-range.first-code <= p-code
      395         no-error .
      396    if available buf_code-range then return yes.
      397   end.
      398   find first buf_code-range no-lock where
      399             buf_code-range.db-num = p-db-num
      400       and  buf_code-range.range-type = p-range-type
      401       and  buf_code-range.stts = 'f'
      402       and buf_code-range.first-code <= p-code
      403       and buf_code-range.last-code >= p-code
      404       no-error .
      405   if available buf_code-range then return yes.
      406   return no.
      407   END FUNCTION.
      408   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
      409                                                       ,input p-range-type as character
      410                                                       ,input p-code as integer):
      411   define variable v-seq-val as integer no-undo .
      412   define buffer buf_code-range for ub.code-range.
      413   CASE p-range-type:
      414     when 'pngb':U then do:
      415       v-seq-val = current-value(s-pngb-code, ub).
      416     end.
      417     when 'fmgb':U then do:
      418       v-seq-val = current-value(s-fmgb-code, ub).
      419     end.
      420   END CASE.
      421   if p-code <= v-seq-val then do:
      422     find first buf_code-range no-lock where
      423               buf_code-range.db-num = p-db-num
      424         and  buf_code-range.range-type = p-range-type
      425         and buf_code-range.first-code <= p-code
      426         and buf_code-range.last-code >= p-code no-error .
      427     if available buf_code-range then return yes.
      428   end.
      429   return no.
      430   END FUNCTION.
      431   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
      432                                                       ,input p-db-num as integer
      433                                                       ,input p-staff-code as integer
      434                                                       ,input p-date as date
      435                                                        ):
      436   define buffer buf_staff for ub.staff.
      437   if p-date = ? then do:
      438     p-date = today .
      439   end.
      440   find first buf_staff no-lock where
      441             buf_staff.role = p-role
      442         and buf_staff.role-level = 'db':U
      443         and buf_staff.db-num = p-db-num
      444         and buf_staff.staff-code = p-staff-code
      445         and buf_staff.date-end >= p-date use-index pi  no-error .
      446   if available buf_staff then do:
      447     return buf_staff.psn-code.
      448   end.
      449   return 0.
      450   end FUNCTION.
      451   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
      452                                                             ,input p-db-num as integer
      453                                                             ,input p-date as date
      454                                                                 ):
      455   define buffer buf_staff for ub.staff.
      456   define buffer buf2_staff for ub.staff.
      457   if p-date = ? then do:
      458     p-date = today .
      459   end.
      460   for each  buf_staff no-lock where
      461             buf_staff.role = p-role
      462         and buf_staff.db-num = p-db-num,
      463   first buf2_staff no-lock where
      464         buf2_staff.role = p-role
      465     and buf2_staff.role-level = 'db':U
      466     and buf2_staff.staff-code = buf_staff.staff-code
      467     and buf2_staff.date-start <= p-date
      468     and buf2_staff.date-end >= p-date
      469   by buf_staff.staff-code
      470   by date-start descending:
      471     return buf_staff.staff-code.
      472   end.
      473   end FUNCTION.
      474   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
      475                                                  ,input p-db-num as integer
      476                                                  ,input p-psn-code as integer
      477                                                  ,input p-date as date
      478                                                  ,output p-c-password as character
      479                                                        ):
      480   define buffer buf_staff for ub.staff.
      481   if p-date = ? then do:
      482     p-date = today .
      483   end.
      484   find first buf_staff no-lock where
      485             buf_staff.role = p-role
      486         and buf_staff.role-level = 'db':U
      487         and buf_staff.db-num = p-db-num
      488        and buf_staff.date-end >= p-date
      489        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
      490   if available buf_staff
      491   then do:
      492     assign
      493     p-c-password = buf_staff.password.
      494     return buf_staff.staff-code.
      495   end.
      496   p-c-password = ''.
      497   return 0.
      498   end FUNCTION.
      499   FUNCTION gbclcode-is-psn-role returns integer (
      500                                                 input p-role as character
      501                                                 ,input p-psn-code as integer
      502                                                 ,input p-date as date
      503                                                     ):
      504   define buffer buf_staff for ub.staff.
      505   if p-date = ? then do:
      506     p-date = today .
      507   end.
      508   for each buf_staff no-lock where
      509             buf_staff.psn-code = p-psn-code
      510        and  buf_staff.role = p-role
      511   by buf_staff.role-level
      512   by buf_staff.date-start
      513        :
      514     if  buf_staff.date-start <= p-date and
      515     buf_staff.date-end >= p-date  then do:
      516       return buf_staff.staff-code.
      517     end.
      518   end.
      519   return 0.
      520   end FUNCTION.
      521   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
      522   define variable v-role-name as character no-undo .
      523   assign
      524   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      525   no-error .
      526   return v-role-name.
      527   END.
      528   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      529   FUNCTION gbclcode-get-position returns character ( input p-role as character
      530                                                     ,input p-role-level as character
      531                                                     ,input p-work-place as character
      532                                                     ,input p-staff-code as integer
      533                                                                ):
      534   define variable v-role-name as character no-undo .
      535   define variable v-role-level as character no-undo .
      536   define variable v-staff-code as integer no-undo .
      537   assign
      538   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      539   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
      540   v-staff-code = p-staff-code
      541   no-error .
      542   return substitute("&1, &2, Код &3"
      543                   ,v-role-name
      544                   ,v-role-level
      545                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
      546   END.
      547   FUNCTION gbclcode-get-work-place returns character (
      548                                                   input p-role as character
      549                                                  ,input p-role-level as character
      550                                                  ,input p-db-num as integer
      551                                                  ,input p-host-code as integer
      552                                                  ,input p-obj-type as character
      553                                                  ,input p-obj-code as integer
      554                                                  ) :
      555   define variable v-work-place as character no-undo .
      556   define variable v-obj-type as character no-undo .
      557     case p-role-level:
      558       when 'db':U then do:
      559         v-work-place = string(p-db-num, "99999").
      560       end.
      561       when 'firm':U then do:
      562         v-work-place = string(p-host-code, "99999").
      563       end.
      564       when 'object':U then do:
      565         assign
      566         v-work-place = p-obj-type + string(p-obj-code, "999999999")
      567         .
      568       end.
      569     END CASE.
      570     return v-work-place.
      571   END FUNCTION.
      572   FUNCTION gbclcode-get-level-last-code returns integer (
      573                                                           input p-role as character
      574                                                         , input p-role-level as character
      575                                                         , input p-work-place as character
      576                                                         , input p-date-start as date
      577                                                         ):
      578   DEFINE VARIABLE v-today as date no-undo .
      579   define buffer buf_staff for ub.staff.
      580   if p-work-place = chr(63) then return ?.
      581   if p-date-start = ? then do:
      582     v-today = today .
      583   end.
      584   else do:
      585     v-today = p-date-start.
      586   end.
      587   find last buf_staff no-lock where
      588             buf_staff.role = p-role
      589        and  buf_staff.role-level = p-role-level
      590        and  buf_staff.work-place = p-work-place
      591        and  buf_staff.date-start <= v-today + 1
      592        and  buf_staff.date-end >= v-today + 1
      593        use-index pi  no-error .
      594   if available buf_staff
      595   then return buf_staff.staff-code.
      596   return 0.
      597   end FUNCTION.
      598   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      599   procedure cur-time :
      600      define output parameter p-today as date      no-undo .
      601      define output parameter p-time  as integer   no-undo .
      602     do
      603     on error undo, return error
      604     :
      605       define variable v-date1 as date      no-undo .
      606       define variable v-date2 as date      no-undo .
      607       define variable v-time  as integer   no-undo .
      608       assign
      609         v-date1 = today
      610         v-time  = time
      611         v-date2 = today
      612       .
      613       if v-date1 <> v-date2
      614       then do:
      615         assign
      616           v-date1 = today
      617           v-time  = v-time
      618         .
      619       end.
      620       assign
      621         p-today = v-date1
      622         p-time  = v-time
      623       .
      624     end.
      625   end.
      626   function cur-time-date returns character
      627   :
      628     return string(today, '99/99/9999':U) .
      629   end.
      630   function cur-time-mjd returns decimal
      631   :
      632     define variable v-date as date      no-undo .
      633     define variable v-time as integer   no-undo .
      634     run cur-time in this-procedure
      635       (output v-date
      636       ,output v-time
      637       ) .
      638     return integer(v-date) - 2400002 + (v-time / 86400) .
      639   end.
      640   function cur-time-get-ending-index returns integer
      641   (input p-number as integer
      642   )
      643   :
      644     if p-number < 0
      645     or p-number = ?
      646     then do:
      647       return 1 .
      648     end.
      649     define variable v-rest as integer   no-undo .
      650     assign
      651       p-number = p-number modulo 100
      652     .
      653     if p-number < 20
      654     then do:
      655       assign
      656         v-rest = p-number
      657       .
      658     end.
      659     else do:
      660       assign
      661         v-rest = p-number modulo 10
      662       .
      663     end.
      664     case v-rest :
      665       when 1
      666       then do:
      667         return 2 .
      668       end.
      669       when 2 or
      670       when 3 or
      671       when 4
      672       then do:
      673         return 3 .
      674       end.
      675       otherwise do:
      676         return 1 .
      677       end.
      678     end case .
      679   end.
      680   procedure cur-time-mjd-to-date :
      681      define input  parameter i-mjd-diff as decimal no-undo.
      682      define output parameter o-Date     as date    no-undo.
      683      define output parameter o-Time     as integer no-undo.
      684      define variable v-day-number as integer   no-undo .
      685      if    i-mjd-diff < 0
      686         or i-mjd-diff = ?
      687      then do:
      688         return "?" .
      689      end.
      690      assign
      691         v-day-number = truncate(i-mjd-diff,0).
      692         o-Date = date(v-day-number + 2400002).
      693         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      694     .
      695   end.
      696   function cur-time-mjd-to-string returns character
      697   (input p-mjd-diff as decimal
      698   )
      699   :
      700     define variable v-day-number as integer   no-undo .
      701     define variable v-seconds    as integer   no-undo .
      702     define variable v-hour       as integer   no-undo .
      703     define variable v-min        as integer   no-undo .
      704     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      705     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      706     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      707     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      708     if p-mjd-diff < 0
      709     or p-mjd-diff = ?
      710     then do:
      711       return "?" .
      712     end.
      713     assign
      714       v-day-number = integer(truncate(p-mjd-diff,0))
      715       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      716     .
      717     if v-seconds > 86400
      718     then do:
      719       assign
      720         v-seconds = 86400 - 1
      721       .
      722     end.
      723     if v-seconds < 0
      724     then do:
      725       assign
      726         v-seconds = 0
      727       .
      728     end.
      729     assign
      730       v-hour = truncate(v-seconds / 3600, 0)
      731     .
      732     assign
      733       v-seconds = v-seconds modulo 3600
      734     .
      735     assign
      736       v-min = truncate(v-seconds / 60, 0)
      737     .
      738     assign
      739       v-seconds = v-seconds modulo 60
      740     .
      741     return
      742         (if v-day-number <> 0
      743           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      744           else ""
      745         )
      746       + (if v-day-number <> 0 or v-hour <> 0
      747           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      748           else ""
      749         )
      750       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      751           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      752           else ""
      753         )
      754       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      755       .
      756   end.
      757   function cur-time-string returns character
      758   :
      759     define variable v-date as date      no-undo .
      760     define variable v-time as integer   no-undo .
      761     run cur-time in this-procedure
      762       (output v-date
      763       ,output v-time
      764       ) .
      765     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      766   end.
      767   function cur-time-string-sec returns character
      768   :
      769     define variable v-date as date      no-undo .
      770     define variable v-time as integer   no-undo .
      771     run cur-time in this-procedure
      772       (output v-date
      773       ,output v-time
      774       ) .
      775     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      776   end.
      777   function cur-time-custom  returns character
      778   (input p-prefix as character
      779   ,input p-date-format as character
      780   ,input p-delimiter as character
      781   ,input p-time-format as character
      782   ,input p-suffix as character
      783   )
      784   :
      785     define variable v-date as date      no-undo .
      786     define variable v-time as integer   no-undo .
      787     run cur-time in this-procedure
      788       (output v-date
      789       ,output v-time
      790       ) .
      791     return
      792       p-prefix
      793       + string(v-date, p-date-format)
      794       + p-delimiter
      795       + string(v-time, p-time-format)
      796       + p-suffix
      797       .
      798   end.
      799   function cur-time-print  returns character
      800   :
      801     define variable v-date as date      no-undo .
      802     define variable v-time as integer   no-undo .
      803     run cur-time in this-procedure
      804       (output v-date
      805       ,output v-time
      806       ) .
      807     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      808   end.
      809   function cur-time-datetime returns datetime
      810   :
      811     define variable v-char as character no-undo .
      812     define variable v-datetime as datetime no-undo .
      813     v-char = cur-time-string().
      814     v-datetime = datetime(v-char).
      815     return  v-datetime.
      816   end.
      817   function cur-time-string-msec returns character
      818   :
      819     define variable v-date as datetime  no-undo .
      820     v-date = now.
      821     return string(v-date) .
      822   end.
      823   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      824   procedure gen-key-rec :
      825     define input  parameter p-tbl-name    as character no-undo.
      826     define input  parameter p-bh_tbl-name as handle    no-undo.
      827     define output parameter p-key-rec     as character no-undo.
      828     do
      829     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      830     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      831     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      832     :
      833       define variable fh               as handle    no-undo .
      834       define variable v-ok             as logical   no-undo .
      835       define variable v-inform         as character no-undo .
      836       define variable v-ind            as integer   no-undo .
      837       define variable v-idx-field-qnty as integer   no-undo .
      838       if p-tbl-name = ?
      839         or p-tbl-name = "":U
      840       then do:
      841         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info4 ).
      842       end.
      843       if not p-bh_tbl-name:available then do:
      844         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info4, p-tbl-name ).
      845       end.
      846       assign
      847         p-key-rec = p-tbl-name
      848         v-inform  = p-bh_tbl-name:index-information(1)
      849         v-ind     = 2
      850       .
      851       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      852       on error undo, return error
      853       :
      854         assign
      855           v-inform = p-bh_tbl-name:index-information( v-ind )
      856           v-ind    = v-ind + 1
      857         .
      858       end.
      859       if v-inform = ?
      860         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      861         or entry( 3, v-inform, ",":U ) <> "1":U
      862       then do:
      863         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, p-tbl-name ).
      864       end.
      865       else do:
      866         assign
      867           v-idx-field-qnty = num-entries( v-inform ) - 4
      868         .
      869         if v-idx-field-qnty < 2 then do:
      870           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, p-tbl-name ).
      871         end.
      872         do v-ind = 1 to v-idx-field-qnty by 2
      873         on error undo, return error
      874         :
      875           assign
      876             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      877             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      878           .
      879         end.
      880       end.
      881       if p-key-rec = ? then do:
      882         assign
      883           p-key-rec = "":U
      884         .
      885         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info4, p-tbl-name ).
      886       end.
      887     end.
      888     return.
      889   end procedure.
      890   procedure gen-where-keyr-tab :
      891     define input  parameter i-tableSerach as character no-undo.
      892     define input  parameter i-tablekey   as character  no-undo.
      893     define input  parameter p-key-rec    as character  no-undo.
      894     define input  parameter p-key-handle as handle     no-undo .
      895     define input  parameter p-db-name    as character  no-undo .
      896     define input  parameter p-tt-handle  as handle     no-undo .
      897     define output parameter o-Where      as character  no-undo.
      898     do
      899     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      900     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      901     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      902     :
      903       define variable v-full-tbl-name  as character no-undo .
      904       define variable bh_tbl-name      as handle    no-undo .
      905       define variable fh_key           as handle    no-undo .
      906       define variable fh_search        as handle    no-undo .
      907       define variable v-field-num      as integer   no-undo .
      908       define variable v-count-fld      as integer   no-undo .
      909       define variable v-inform         as character no-undo .
      910       define variable v-ind            as integer   no-undo .
      911       define variable v-idx-field-qnty as integer   no-undo .
      912       define variable v-field-name     as character no-undo .
      913       define variable v-field-val      as character no-undo .
      914       define variable v-word-link      as character no-undo .
      915       define variable vTable           as character no-undo.
      916       define variable bh_tbl-key       as handle    no-undo .
      917       assign
      918         p-key-rec = trim( p-key-rec )
      919       .
      920       if p-key-handle <> ? then do:
      921         if not valid-handle(p-key-handle)
      922            or p-key-handle:type <> "buffer"
      923         then do:
      924           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info4 ).
      925         end.
      926         if num-entries( p-key-rec, chr(3) ) > 1
      927           or p-key-rec = ?
      928           or p-key-rec = "":U
      929         then do:
      930           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info4, p-key-rec ).
      931         end.
      932       end.
      933       else do:
      934         if p-key-rec = ?
      935           or p-key-rec = "":U
      936         then do:
      937           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      938         end.
      939       end.
      940       assign
      941         vTable = entry( 1 , p-key-rec, chr(3) )
      942       .
      943       if p-tt-handle <> ?
      944         and ( not valid-handle(p-tt-handle)
      945               or p-tt-handle:type <> "buffer"
      946             )
      947       then do:
      948         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info4, vTable, chr(10) ).
      949       end.
      950       if p-tt-handle = ? then do:
      951         assign
      952           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      953         .
      954         create buffer bh_tbl-name for table v-full-tbl-name .
      955       end.
      956       else do:
      957         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      958       end.
      959       assign
      960         v-inform = bh_tbl-name:index-information(1)
      961         v-ind    = 2
      962       .
      963       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      964       on error undo, return error
      965       :
      966         assign
      967           v-inform = bh_tbl-name:index-information( v-ind )
      968           v-ind    = v-ind + 1
      969         .
      970       end.
      971       if v-inform = ?
      972         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      973         or entry( 3, v-inform, ",":U ) <> "1":U
      974       then do:
      975         delete object bh_tbl-name no-error.
      976         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info4, vTable ).
      977       end.
      978       assign
      979         v-idx-field-qnty = num-entries( v-inform ) - 4
      980       .
      981       if v-idx-field-qnty < 2 then do:
      982         delete object bh_tbl-name no-error.
      983         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, vTable ).
      984       end.
      985       assign
      986         o-where     = "where":U
      987         v-word-link = "":U
      988         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      989         v-count-fld = 0
      990       .
      991       if i-tablekey ne "" and i-tablekey ne ?
      992       then do:
      993         assign
      994           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      995         .
      996         create buffer bh_tbl-key for table v-full-tbl-name .
      997       end.
      998       if i-tableSerach ne "" and i-tableSerach ne ?
      999       then do:
     1000         delete object bh_tbl-name no-error.
     1001         assign
     1002           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1003         .
     1004         create buffer bh_tbl-name for table v-full-tbl-name .
     1005       end.
     1006       block_where:
     1007       do v-ind = 1 to v-idx-field-qnty by 2
     1008       on error undo, return error
     1009       :
     1010         assign
     1011           v-count-fld = v-count-fld + 1
     1012         .
     1013         if p-key-handle = ?
     1014           and v-count-fld > v-field-num
     1015         then do:
     1016           leave block_where.
     1017         end.
     1018         define variable VfieldKeyTable as handle no-undo.
     1019         assign
     1020           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1021           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1022         .
     1023         if     bh_tbl-key ne ?
     1024         then do:
     1025            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1026            if VfieldKeyTable eq ?
     1027            then next block_where.
     1028         end.
     1029         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1030         then
     1031            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1032         else
     1033            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1034         if p-key-handle = ? then do:
     1035           assign
     1036             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1037           .
     1038         end.
     1039         else do:
     1040           assign
     1041             fh_key = p-key-handle:buffer-field( v-field-name )
     1042           .
     1043           if fh_key = ?
     1044             or not valid-handle( fh_key )
     1045           then do:
     1046             delete object bh_tbl-name.
     1047             if     bh_tbl-key ne ?
     1048             then
     1049                delete object bh_tbl-key.
     1050             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info4, p-key-handle:name, v-field-name ).
     1051           end.
     1052           assign
     1053             v-field-val = fh_key:buffer-value
     1054           .
     1055         end.
     1056         if fh_search:data-type ="character":U then do:
     1057           assign
     1058             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1059             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1060             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1061             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1062             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1063             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1064             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1065             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1066             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1067             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1068             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1069             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1070             v-field-val = substitute( '"&1"', v-field-val )
     1071           .
     1072         end.
     1073         assign
     1074           o-where = substitute( "&1 &2", o-where, v-field-val )
     1075         .
     1076         if v-word-link = "":U then do:
     1077           assign
     1078             v-word-link = "and":U
     1079           .
     1080         end.
     1081       end.
     1082       delete object bh_tbl-name.
     1083       if     bh_tbl-key ne ?
     1084       then
     1085          delete object bh_tbl-key.
     1086       if p-key-handle = ?
     1087         and v-count-fld <> v-field-num
     1088       then do:
     1089         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info4, vTable ).
     1090       end.
     1091     end.
     1092   end procedure.
     1093   procedure gen-hn-keyr-tab :
     1094     define input  parameter i-tableSerach as character no-undo.
     1095     define input  parameter i-tablekey   as character no-undo.
     1096     define input  parameter p-key-rec    as character no-undo.
     1097     define input  parameter p-key-handle as handle    no-undo .
     1098     define input  parameter p-db-name    as character no-undo .
     1099     define input  parameter p-tt-handle  as handle    no-undo .
     1100     define input  parameter p-stts-lock  as integer   no-undo .
     1101     define output parameter o-hn         as handle    no-undo.
     1102     define variable v-full-tbl-name as character no-undo.
     1103     define variable v-where         as character no-undo.
     1104     define variable bh_tbl-name     as handle    no-undo.
     1105     define variable vTable          as character no-undo.
     1106     do
     1107     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1108     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1109     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1110         run gen-where-keyr-tab(i-tableSerach,
     1111                                i-tablekey,
     1112                                p-key-rec,
     1113                                p-key-handle,
     1114                                p-db-name,
     1115                                p-tt-handle,
     1116                                output v-where).
     1117         if i-tableSerach ne "" and i-tableSerach ne ?
     1118         then do:
     1119            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1120            create buffer bh_tbl-name for table v-full-tbl-name .
     1121         end.
     1122         else do:
     1123            if p-tt-handle = ? then do:
     1124               assign
     1125                  vTable = entry( 1 , p-key-rec, chr(3) )
     1126               .
     1127               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1128               create buffer bh_tbl-name for table v-full-tbl-name .
     1129            end.
     1130            else do:
     1131               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1132            end.
     1133         end.
     1134         if p-tt-handle = ? then do:
     1135            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1136         end.
     1137         else do:
     1138            bh_tbl-name:find-first( v-where ) no-error .
     1139         end.
     1140         o-hn = bh_tbl-name.
     1141      end.
     1142   end procedure.
     1143   procedure gen-hn-keyr :
     1144     define input  parameter p-key-rec    as character no-undo.
     1145     define input  parameter p-key-handle as handle    no-undo .
     1146     define input  parameter p-db-name    as character no-undo .
     1147     define input  parameter p-tt-handle  as handle    no-undo .
     1148     define input  parameter p-stts-lock  as integer   no-undo .
     1149     define output parameter o-hn         as handle    no-undo.
     1150     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1151   end.
     1152   procedure gen-row-keyr :
     1153     define input  parameter p-key-rec    as character no-undo.
     1154     define input  parameter p-key-handle as handle    no-undo .
     1155     define input  parameter p-db-name    as character no-undo .
     1156     define input  parameter p-tt-handle  as handle    no-undo .
     1157     define input  parameter p-stts-lock  as integer   no-undo .
     1158     define output parameter p-tbl-row    as rowid     no-undo.
     1159     define output parameter p-tbl-name   as character no-undo.
     1160     define variable vHn as handle no-undo.
     1161       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1162       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1163       p-tbl-name =  vHn:table.
     1164       delete object vHn no-error.
     1165     if p-tbl-row = ? then do:
     1166       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info4, p-tbl-name, p-key-rec ).
     1167     end.
     1168     else do:
     1169       return.
     1170     end.
     1171   end procedure.
     1172   procedure gen-key-fv :
     1173     define input  parameter p-key-rec    as character no-undo .
     1174     define output parameter p-field-list as character no-undo .
     1175     define output parameter p-value-list as character no-undo.
     1176     do
     1177     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1178     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1179     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1180     :
     1181       define variable v-full-tbl-name  as character no-undo .
     1182       define variable bh_tbl-name      as handle    no-undo .
     1183       define variable v-tbl-name       as character no-undo .
     1184       define variable v-field-num      as integer   no-undo .
     1185       define variable v-count-fld      as integer   no-undo .
     1186       define variable v-inform         as character no-undo .
     1187       define variable v-ind            as integer   no-undo .
     1188       define variable v-idx-field-qnty as integer   no-undo .
     1189       define variable v-delim-key      as character no-undo .
     1190       if p-key-rec = ?
     1191         or p-key-rec = "":U
     1192       then do:
     1193         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
     1194       end.
     1195       assign
     1196         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1197         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1198       .
     1199       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1200       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info4 ).
     1201       assign
     1202         v-inform = bh_tbl-name:index-information(1)
     1203         v-ind    = 2
     1204       .
     1205       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1206       on error undo, return error
     1207       :
     1208         assign
     1209           v-inform = bh_tbl-name:index-information( v-ind )
     1210           v-ind    = v-ind + 1
     1211         .
     1212       end.
     1213       if v-inform = ?
     1214         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1215         or entry( 3, v-inform, ",":U ) <> "1":U
     1216       then do:
     1217         delete object bh_tbl-name no-error.
     1218         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
     1219       end.
     1220       assign
     1221         v-idx-field-qnty = num-entries( v-inform ) - 4
     1222       .
     1223       if v-idx-field-qnty < 2 then do:
     1224         delete object bh_tbl-name no-error.
     1225         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
     1226       end.
     1227       assign
     1228         p-field-list = "":U
     1229         p-value-list = "":U
     1230         v-delim-key  = "":U
     1231         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1232         v-count-fld  = 0
     1233       .
     1234       block_where:
     1235       do v-ind = 1 to v-idx-field-qnty by 2
     1236       on error undo, return error
     1237       :
     1238         assign
     1239           v-count-fld = v-count-fld + 1
     1240         .
     1241         if v-count-fld > v-field-num then do:
     1242           leave block_where.
     1243         end.
     1244         assign
     1245           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1246           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1247         .
     1248         if v-ind = 1 then do:
     1249           assign
     1250             v-delim-key = chr(3)
     1251           .
     1252         end.
     1253       end.
     1254       delete object bh_tbl-name.
     1255       if v-count-fld <> v-field-num then do:
     1256         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info4, v-tbl-name ).
     1257       end.
     1258     end.
     1259   end procedure.
     1260   procedure gen-key-field :
     1261     define input  parameter p-table      as character no-undo .
     1262     define output parameter p-field-list as character no-undo .
     1263     do
     1264     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1265     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1266     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1267     :
     1268       define variable v-full-tbl-name  as character no-undo .
     1269       define variable bh_tbl-name      as handle    no-undo .
     1270       define variable v-tbl-name       as character no-undo .
     1271       define variable v-field-num      as integer   no-undo .
     1272       define variable v-count-fld      as integer   no-undo .
     1273       define variable v-inform         as character no-undo .
     1274       define variable v-ind            as integer   no-undo .
     1275       define variable v-idx-field-qnty as integer   no-undo .
     1276       define variable v-delim-key      as character no-undo .
     1277       if p-table = ?
     1278         or p-table = "":U
     1279       then do:
     1280         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info4 ).
     1281       end.
     1282       assign
     1283         v-tbl-name      = p-table
     1284         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1285       .
     1286       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1287       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info4 ).
     1288       assign
     1289         v-inform = bh_tbl-name:index-information(1)
     1290         v-ind    = 2
     1291       .
     1292       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1293       on error undo, return error
     1294       :
     1295         assign
     1296           v-inform = bh_tbl-name:index-information( v-ind )
     1297           v-ind    = v-ind + 1
     1298         .
     1299       end.
     1300       if v-inform = ?
     1301         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1302         or entry( 3, v-inform, ",":U ) <> "1":U
     1303       then do:
     1304         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
     1305       end.
     1306       assign
     1307         v-idx-field-qnty = num-entries( v-inform ) - 4
     1308       .
     1309       if v-idx-field-qnty < 2 then do:
     1310         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
     1311       end.
     1312       assign
     1313         p-field-list = "":U
     1314         v-delim-key  = "":U
     1315         v-count-fld  = 0
     1316       .
     1317       block_where:
     1318       do v-ind = 1 to v-idx-field-qnty by 2
     1319       on error undo, return error
     1320       :
     1321         assign
     1322           v-count-fld = v-count-fld + 1
     1323         .
     1324         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1325         if v-ind = 1 then do:
     1326           assign
     1327             v-delim-key = chr(3)
     1328           .
     1329         end.
     1330       end.
     1331       delete object bh_tbl-name.
     1332     end.
     1333   end procedure.
     1334   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1335   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1336   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1337   procedure thbjattr_code :
     1338      define input  parameter p-upper-code     as character no-undo .
     1339      define input  parameter p-code           as character no-undo .
     1340      define output parameter p-label          as character no-undo .
     1341      define output parameter p-user-can-edit  as logical   no-undo .
     1342      define output parameter p-output-display as logical   no-undo .
     1343      define output parameter p-other          as character no-undo .
     1344      define output parameter p-prop-list      as character no-undo .
     1345      define output parameter p-prop-type-list as character no-undo .
     1346      define output parameter p-prop-label-list as character no-undo .
     1347      define output parameter p-global          as logical no-undo .
     1348      define output parameter p-host           as logical no-undo .
     1349      define output parameter p-shop           as logical no-undo .
     1350      define output parameter p-store          as logical no-undo .
     1351      define output parameter p-db             as logical no-undo .
     1352      define variable p-region as logical no-undo.
     1353      run thbjattr_code_reg in this-procedure (
     1354                                               p-upper-code,
     1355                                               p-code,
     1356                                               output p-label,
     1357                                               output p-user-can-edit,
     1358                                               output p-output-display,
     1359                                               output p-other,
     1360                                               output p-prop-list,
     1361                                               output p-prop-type-list,
     1362                                               output p-prop-label-list,
     1363                                               output p-global,
     1364                                               output p-host,
     1365                                               output p-shop,
     1366                                               output p-store,
     1367                                               output p-db,
     1368                                               output p-region
     1369                                               ).
     1370   end procedure.
     1371   procedure thbjattr_code_reg :
     1372   define input  parameter p-upper-code     as character no-undo .
     1373   define input  parameter p-code           as character no-undo .
     1374   define output parameter p-label          as character no-undo .
     1375   define output parameter p-user-can-edit  as logical   no-undo .
     1376   define output parameter p-output-display as logical   no-undo .
     1377   define output parameter p-other          as character no-undo .
     1378   define output parameter p-prop-list      as character no-undo .
     1379   define output parameter p-prop-type-list as character no-undo .
     1380   define output parameter p-prop-label-list as character no-undo .
     1381   define output parameter p-global          as logical no-undo .
     1382   define output parameter p-host           as logical no-undo .
     1383   define output parameter p-shop           as logical no-undo .
     1384   define output parameter p-store          as logical no-undo .
     1385   define output parameter p-db             as logical no-undo .
     1386   define output parameter p-region         as logical no-undo .
     1387   do
     1388   on error undo, return error return-value
     1389   :
     1390       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
     1391       (input  p-upper-code
     1392       ,input  p-code
     1393       ,output p-label
     1394       ,output p-user-can-edit
     1395       ,output p-output-display
     1396       ,output p-other
     1397       ,output p-prop-list
     1398       ,output p-prop-type-list
     1399       ,output p-prop-label-list
     1400       ,output p-global
     1401       ,output p-host
     1402       ,output p-shop
     1403       ,output p-store
     1404       ,output p-db
     1405       ,output p-region
     1406       ) no-error .
     1407     if error-status :error
     1408     then do:
     1409       undo, return error substitute( "&1. &2&3&4", vss-include-info5, return-value, chr(10), error-status :get-message (1)).
     1410     end.
     1411   end.
     1412   end procedure.
