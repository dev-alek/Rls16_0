     2007    + "param-value-date" + chr(4) + "Значение параметра" + chr(4) + ""  + chr(8)
     2008    + "param-value-decimal" + chr(4) + "Значение параметра" + chr(4) + ""  + chr(8)
     2009    + "param-value-integer" + chr(4) + "Значение параметра" + chr(4) + ""  + chr(8)
     2010    + "param-value-logical" + chr(4) + "Значение параметра" + chr(4) + ""
     2011    .
     2012    run proc-full-temp-changes in this-procedure (
     2013                                                input  (current_c-thbj-attr.action = integer('1':U))
     2014                                               ,input  (current_c-thbj-attr.action = integer('99':U))
     2015                                               ,input  buffer current_c-rule-call-param:handle
     2016                                               ,input  'rule-call-param':U
     2017                                               ,input  "call_id,call#_id,profile_id,codex_id,ruleset_id,order_id,rule_id,param-des,param-data-type,param-label,param-mode,param-name,param-num,param-value-character,param-value-date,param-value-decimal,param-value-integer,param-value-logical"
     2018                                               ,input  v-label-param).
     2019   end.
     2020   end procedure.
     2021   define buffer buf_c-cli-hist for ub.c-cli-hist.
     2022   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2023   define SHARED temp-table temp-changes no-undo
     2024   field f_name as character
     2025   field l_name as character
     2026   field v_old as character
     2027   field v_new as character
     2028   field t_name as character
     2029   field num_ as integer
     2030   field uniq-key-rec as character
     2031   field action as integer
     2032   field fNotChange as logical
     2033   index pi is unique primary
     2034   num_
     2035   t_name
     2036   f_name
     2037   index
     2038   Chan
     2039   fnotChange
     2040   t_name
     2041   f_name
     2042   index imain uniq-key-rec
     2043   .
     2044   FUNCTION get-all-fields returns character (p-file-name as character ):
     2045   define variable v-dop as character no-undo .
     2046     find first _file no-lock where _file._file-name = p-file-name no-error .
     2047     if not available _file then return "":U.
     2048     for each _field no-lock where
     2049              _field._file-recid = recid(_file) :
     2050       assign
     2051       v-dop = v-dop + _field._field-name + chr(44)
     2052       .
     2053     end.
     2054     return trim(v-dop).
     2055   END FUNCTION.
     2056   PROCEDURE proc-full-temp-changes :
     2057     define input  parameter p-act-create as logical   no-undo .
     2058     define input  parameter p-act-delete as logical   no-undo .
     2059     define input  parameter p-hst-handle as handle    no-undo .
     2060     define input  parameter p-main-table as character no-undo .
     2061     define input  parameter p-field-list as character no-undo .
     2062     define input  parameter p-label-form as character no-undo .
     2063     define variable h-new-buf         as handle    no-undo .
     2064     define variable h-main-buf        as handle    no-undo .
     2065     define variable h-for-comp        as handle    no-undo .
     2066     define variable v-inform          as character no-undo .
     2067     define variable v-ind             as integer   no-undo .
     2068     define variable v-idx-field-qnty  as integer   no-undo .
     2069     define variable v-num-entries     as integer   no-undo .
     2070     define variable fh                as handle    no-undo .
     2071     define variable fh-main           as handle    no-undo .
     2072     define variable fh-old            as handle    no-undo .
     2073     define variable fh-new            as handle    no-undo .
     2074     define variable v-field-name      as character no-undo .
     2075     define variable v-field-lvl       as character no-undo .
     2076     define variable v-field-form      as character no-undo .
     2077     define variable v-search-exp      as character no-undo .
     2078     define variable v-srch-main       as character no-undo .
     2079     define variable v-word-link       as character no-undo .
     2080     define variable v-av-chip-num     as logical   no-undo .
     2081     define variable v-main-pi-fld-lst as character no-undo .
     2082     define variable v-main-fld-lst    as character no-undo .
     2083     define variable v-delim-list      as character no-undo .
     2084     define variable v-label           as character no-undo .
     2085     define variable v-old-value       as character no-undo case-sensitive.
     2086     define variable v-new-value       as character no-undo case-sensitive.
     2087     define variable v-chg-fields as character no-undo.
     2088     for each temp-changes:
     2089       delete temp-changes.
     2090     end.
     2091     if not p-hst-handle:available then do:
     2092       return .
     2093     end.
     2094     create buffer h-new-buf  for table p-hst-handle .
     2095     create buffer h-main-buf for table p-main-table .
     2096     assign
     2097       v-inform = h-main-buf:index-information(1)
     2098       v-ind    = 2
     2099     .
     2100     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2101     on error undo, return error
     2102     :
     2103       assign
     2104         v-inform = h-main-buf:index-information( v-ind )
     2105         v-ind    = v-ind + 1
     2106       .
     2107     end.
     2108     if v-inform = ?
     2109       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2110       or entry( 3, v-inform, ",":U ) <> "1":U
     2111     then do:
     2112       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     2113     end.
     2114     assign
     2115       v-idx-field-qnty = num-entries( v-inform ) - 4
     2116     .
     2117     if v-idx-field-qnty < 2 then do:
     2118       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     2119     end.
     2120     assign
     2121       v-srch-main   = "where":U
     2122       v-word-link   = "":U
     2123       v-av-chip-num = false
     2124       v-delim-list  = "":U
     2125     .
     2126     do v-ind = 1 to v-idx-field-qnty by 2
     2127     on error undo, return error
     2128     :
     2129       assign
     2130         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     2131         fh                = p-hst-handle:buffer-field( v-field-name )
     2132         fh-main           = h-main-buf:buffer-field( v-field-name )
     2133         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     2134         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     2135       .
     2136       if fh:data-type ="character":U then do:
     2137         assign
     2138           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     2139         .
     2140       end.
     2141       else do:
     2142         assign
     2143           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     2144         .
     2145       end.
     2146       if v-delim-list = "":U then do:
     2147         assign
     2148           v-delim-list = ",":U
     2149         .
     2150       end.
     2151       if v-word-link = "":U then do:
     2152         assign
     2153           v-word-link = "and":U
     2154         .
     2155       end.
     2156     end.
     2157     assign
     2158       v-delim-list  = "":U
     2159     .
     2160     do v-ind = 1 to h-main-buf:num-fields
     2161     on error undo, return error
     2162     :
     2163       assign
     2164         fh-main      = h-main-buf:buffer-field( v-ind )
     2165         v-field-name = fh-main:name
     2166       .
     2167         assign
     2168           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     2169         .
     2170         if v-delim-list = "":U then do:
     2171           assign
     2172             v-delim-list = ",":U
     2173           .
     2174         end.
     2175     end.
     2176     assign
     2177       v-inform = p-hst-handle:index-information(1)
     2178       v-ind    = 2
     2179     .
     2180     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2181     on error undo, return error
     2182     :
     2183       assign
     2184         v-inform = p-hst-handle:index-information( v-ind )
     2185         v-ind    = v-ind + 1
     2186       .
     2187     end.
     2188     if v-inform = ?
     2189       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2190       or entry( 3, v-inform, ",":U ) <> "1":U
     2191     then do:
     2192       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     2193     end.
     2194     assign
     2195       v-idx-field-qnty = num-entries( v-inform ) - 4
     2196     .
     2197     if v-idx-field-qnty < 2 then do:
     2198       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     2199     end.
     2200     assign
     2201       v-search-exp  = "where":U
     2202       v-word-link   = "":U
     2203       v-av-chip-num = false
     2204     .
     2205     do v-ind = 1 to v-idx-field-qnty by 2
     2206     on error undo, return error
     2207     :
     2208       assign
     2209         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     2210         fh           = p-hst-handle:buffer-field( v-field-name )
     2211         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     2212       .
     2213       if v-field-name = "chip-num":U then do:
     2214         assign
     2215           v-search-exp  = substitute( "&1 >", v-search-exp )
     2216           v-av-chip-num = true
     2217         .
     2218       end.
     2219       else do:
     2220         assign
     2221           v-search-exp = substitute( "&1 =", v-search-exp )
     2222         .
     2223       end.
     2224       if fh:data-type ="character":U then do:
     2225         assign
     2226           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     2227         .
     2228       end.
     2229       else do:
     2230         assign
     2231           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     2232         .
     2233       end.
     2234       if v-word-link = "":U then do:
     2235         assign
     2236           v-word-link = "and":U
     2237         .
     2238       end.
     2239     end.
     2240     if v-av-chip-num = false then do:
     2241       message
     2242         vss-workfile vss-revision vss-description skip
     2243         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     2244         "Использование данной процедуры невозможно!" skip
     2245         view-as alert-box error .
     2246       return error .
     2247     end.
     2248     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     2249     if not h-new-buf:available then do:
     2250       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     2251       if not h-main-buf:available then do:
     2252         assign
     2253           h-for-comp = ?
     2254         .
     2255       end.
     2256       else do:
     2257         assign
     2258           h-for-comp = h-main-buf
     2259         .
     2260       end.
     2261     end.
     2262     else do:
     2263       assign
     2264         h-for-comp = h-new-buf
     2265       .
     2266     end.
     2267     assign
     2268       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     2269     .
     2270     do v-ind = 1 to v-num-entries
     2271     on error undo, return error return-value
     2272     :
     2273       assign
     2274         v-field-name = entry( v-ind, v-main-fld-lst )
     2275         fh-old       = p-hst-handle:buffer-field( v-field-name )
     2276         v-old-value  = fh-old:buffer-value()
     2277         v-label      = trim( fh-old:label )
     2278       .
     2279       if ( trim( p-field-list ) <> "":U
     2280            and lookup( v-field-name, p-field-list ) > 0
     2281          )
     2282          or trim( p-field-list ) = "":U
     2283       then do:
     2284         if h-for-comp <> ? then do:
     2285           assign
     2286             fh-new      = h-for-comp:buffer-field( v-field-name )
     2287             v-new-value = fh-new:buffer-value()
     2288           .
     2289         end.
     2290         else do:
     2291           assign
     2292             v-new-value = "":U
     2293           .
     2294         end.
     2295           if p-act-create = true then do:
     2296             assign
     2297               v-old-value = "":U
     2298             .
     2299           end.
     2300           if p-act-delete = true then do:
     2301             assign
     2302               v-new-value = "":U
     2303             .
     2304           end.
     2305         if v-old-value <> v-new-value
     2306         then do:
     2307           create temp-changes.
     2308           assign
     2309             temp-changes.t_name = p-main-table
     2310             temp-changes.f_name = v-field-name
     2311             temp-changes.l_name = replace( v-label, "&":U, "":U )
     2312             temp-changes.v_old  = trim( v-old-value )
     2313             temp-changes.v_new  = trim( v-new-value )
     2314             temp-changes.num_   = 0
     2315             temp-changes.fNotChange = v-old-value eq v-new-value
     2316           .
     2317         end.
     2318       end.
     2319     end.
     2320     assign
     2321       v-num-entries = num-entries( p-label-form, chr(8) )
     2322     .
     2323     do v-ind = 1 to v-num-entries
     2324     on error undo, return error return-value
     2325     :
     2326       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     2327         assign
     2328           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     2329           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     2330           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     2331         .
     2332         find first temp-changes
     2333           where temp-changes.f_name = v-field-name
     2334           no-error .
     2335         if available temp-changes then do:
     2336           if trim( v-field-lvl ) <> "":U then do:
     2337             assign
     2338               temp-changes.l_name = v-field-lvl
     2339             .
     2340           end.
     2341           if trim( v-field-form ) <> "":U then do:
     2342             assign
     2343               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     2344             .
     2345             if h-for-comp <> ? then do:
     2346               assign
     2347                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     2348               .
     2349             end.
     2350           end.
     2351         end.
     2352       end.
     2353       else do:
     2354         message
     2355           vss-workfile vss-revision vss-description skip
     2356           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     2357           substitute( "список для поля '&1': '&2'"
     2358                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     2359                       ,entry( v-ind, p-label-form, chr(8) )
     2360                     ) skip
     2361           substitute( "полный список: &2", p-label-form ) skip
     2362           view-as alert-box error .
     2363       end.
     2364     end.
     2365     delete object h-new-buf .
     2366     delete object h-main-buf .
     2367   END PROCEDURE.
     2368   define temp-table temp-thbj-attr no-undo
     2369   like ub.thbj-attr.
     2370   function display-int-status returns character(input p-stts-char as character):
     2371   if p-stts-char = '0':U then return 'тек':U.
     2372   else return 'удал':U.
     2373   END FUNCTION.
     2374   function display-gender returns character(input p-gender as character):
     2375   case p-gender:
     2376     when "no"
     2377     or when "false"
     2378     then do:
     2379       return "м".
     2380     end.
     2381     when "yes"
     2382     or when "true"
     2383     then do:
     2384       return "ж".
     2385     end.
     2386     when ?
     2387     or when chr(63)
     2388     then do:
     2389       return chr(63).
     2390     end.
     2391   end case.
     2392   END FUNCTION.
     2393   find first buf_c-cli-hist no-lock where
     2394             buf_c-cli-hist.obj-type = p-obj-type
     2395         AND buf_c-cli-hist.obj-code = p-obj-code
     2396         AND buf_c-cli-hist.chip-num = p-chip-num
     2397         AND buf_c-cli-hist.corr-user-db-num = p-corr-user-db-num
     2398         AND buf_c-cli-hist.subject  = p-subject no-error .
     2399   if not available buf_c-cli-hist then do:
     2400     return error .
     2401   end.
     2402   CASE p-subject:
     2403     when 'clients':U then do:
     2404       run clients-proc in this-procedure(output p-description) no-error .
     2405     end.
     2406     when 'clients-attr':U then do:
     2407       run clients-attr-proc in this-procedure(output p-description) no-error .
     2408     end.
     2409     when 'sysconf':U then do:
     2410       run sysconf-proc in this-procedure(output p-description) no-error .
     2411     end.
     2412     when 'person':U then do:
     2413       run person-proc in this-procedure(output p-description) no-error  .
     2414     end.
     2415     when 'firm':U then do:
     2416       run firm-proc in this-procedure(output p-description) no-error  .
     2417     end.
     2418     when 'shop':U then do:
     2419       run shop-proc in this-procedure(output p-description) no-error  .
     2420     end.
     2421     when 'store':U then do:
     2422       run store-proc in this-procedure(output p-description) no-error  .
     2423     end.
     2424     when 'staff':U then do:
     2425       run staff-proc in this-procedure(output p-description) no-error  .
     2426     end.
     2427     when 'dis-thbj-rule':U then do:
     2428       run dis-thbj-rule-proc in this-procedure(output p-description) no-error  .
     2429     end.
     2430     when 'thbj-attr':U then do:
     2431       run thbj-attr-proc in this-procedure(output p-description) no-error  .
     2432     end.
     2433     when 'ext-classif':U then do:
     2434       run ext-classif-proc in this-procedure(output p-description) no-error  .
     2435     end.
     2436   END CASE.
     2437   if error-status:error then do:
     2438     return error .
     2439   end.
     2440   procedure clients-proc :
     2441   define output parameter p-description as character no-undo .
     2442   define buffer current_c-clients for ub.c-clients  .
     2443   do
     2444   on error undo, return error return-value
     2445   :
     2446     find first current_c-clients no-lock where
     2447                 current_c-clients.obj-type = p-obj-type
     2448             AND current_c-clients.obj-code = p-obj-code
     2449             AND current_c-clients.chip-num = p-chip-num
     2450             AND current_c-clients.corr-user-db-num = p-corr-user-db-num no-error .
     2451     if not avail current_c-clients then do:
     2452         v-mess = "Неверная ссылка на c-clients в таблице c-cli-hist".
     2453         run err-mess ( input-output v-mess).
     2454         return error (if p-silent then v-mess else '':U).
     2455     end.
     2456   define variable v-label-param as character no-undo .
     2457     v-label-param =
     2458       "PS" + chr(4) + "Примечания" + chr(4) + "" + chr(8)
     2459    + "buy-cons" + chr(4) + "Покупатель конс.товаров" + chr(4) + "" + chr(8)
     2460    + "buy-gds" + chr(4) + "Покупатель товаров" + chr(4) + "" + chr(8)
     2461    + "db-num" + chr(4) + "№ БД" + chr(4) + "" + chr(8)
     2462    + "host-code" + chr(4) + "Код своей фирмы" + chr(4) + "" + chr(8)
     2463    + "buy-serv" + chr(4) + "Покупатель услуг" + chr(4) + "" + chr(8)
     2464    + "grp-code" + chr(4) + "Вн.Код группы" + chr(4) + "" + chr(8)
     2465    + "grp-name" + chr(4) + "Название группы" + chr(4) + "" + chr(8)
     2466    + "is-prod" + chr(4) + "Производитель" + chr(4) + "" + chr(8)
     2467    + "lim-kr" + chr(4) + "Лимит кредита" + chr(4) + "" + chr(8)
     2468    + "num_podr" + chr(4) + "№ подразделения" + chr(4) + "" + chr(8)
     2469    + "obj-name" + chr(4) + "Название" + chr(4) + "" + chr(8)
     2470    + "sup-cons" + chr(4) + "Поставщик конс.товара" + chr(4) + "" + chr(8)
     2471    + "sup-gds" + chr(4) + "Поставщик товаров" + chr(4) + "" + chr(8)
     2472    + "sup-serv" + chr(4) + "Поставщик услуг" + chr(4) + "" + chr(8)
     2473    + "stts" + chr(4) + "Статус" + chr(4) + "display-int-status" + chr(8)
     2474    + "reg-code" + chr(4) + "Регион" + chr(4) + "" .
     2475     run proc-full-temp-changes in this-procedure (
     2476                                                  input buf_c-cli-hist.action = integer('1':U)
     2477                                                 ,input buf_c-cli-hist.action = integer('99':U)
     2478                                                 ,input  buffer current_c-clients:handle
     2479                                                 ,input  'clients':U
     2480                                                 ,input  "PS,buy-cons,buy-gds,buy-serv,Покупатель услуг,db-num,host-code,grp-code,grp-name,is-prod,lim-kr,num_podr,obj-name,sup-cons,sup-gds,sup-serv,stts,reg-code"
     2481                                                 ,input  v-label-param).
     2482   end.
     2483   end procedure.
     2484   procedure clients-attr-proc :
     2485   define output parameter p-description as character no-undo .
     2486   define variable v-tooltip as character no-undo .
     2487   define variable v-label as character no-undo .
     2488   define buffer current_c-clients-attr for ub.c-clients-attr  .
     2489   do
     2490   on error undo, return error return-value
     2491   :
     2492     find first current_c-clients-attr no-lock where
     2493                 current_c-clients-attr.obj-type = p-obj-type
     2494             AND current_c-clients-attr.obj-code = p-obj-code
     2495             AND current_c-clients-attr.chip-num = p-chip-num
     2496             AND current_c-clients-attr.corr-user-db-num = p-corr-user-db-num
     2497             AND current_c-clients-attr.attr-code = buf_c-cli-hist.attr-code
     2498             no-error .
     2499     if not avail current_c-clients-attr then do:
     2500         v-mess = "Неверная ссылка на c-clients-attr в таблице c-cli-hist".
     2501         run err-mess ( input-output v-mess).
     2502         return error (if p-silent then v-mess else '':U).
     2503     end.
     2504     run clntattr-tooltip in this-procedure (
     2505                   input current_c-clients-attr.attr-code
     2506                 ,output v-tooltip
     2507                 ,output v-label
     2508                 ) no-error .
     2509     assign
     2510     p-description = "Атрибут" + chr(32) + v-label
     2511     .
     2512     define variable v-label-param as character no-undo .
     2513   v-label-param =
     2514    "attr-value" + chr(4) + "Значение" + chr(4) + "" .
     2515    run proc-full-temp-changes in this-procedure (
     2516                                                  input buf_c-cli-hist.action = integer('1':U)
     2517                                                 ,input buf_c-cli-hist.action = integer('99':U)
     2518                                               ,input  buffer current_c-clients-attr:handle
     2519                                               ,input  'clients-attr':U
     2520                                               ,input  "attr-value"
     2521                                               ,input  v-label-param).
     2522   end.
     2523   end procedure.
     2524   procedure sysconf-proc :
     2525   define output parameter p-description as character no-undo .
     2526   define buffer current_c-sysconf for ub.c-sysconf  .
     2527     do
     2528     on error undo, return error return-value
     2529     :
