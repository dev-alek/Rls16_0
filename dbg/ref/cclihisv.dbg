     2531                  current_c-sysconf.host-code = p-obj-code
     2532              AND current_c-sysconf.chip-num = p-chip-num
     2533              AND current_c-sysconf.corr-user-db-num = p-corr-user-db-num
     2534              no-error .
     2535       if not avail current_c-sysconf then do:
     2536          v-mess = "Неверная ссылка на c-sysconf в таблице c-cli-hist".
     2537          run err-mess ( input-output v-mess).
     2538          return error (if p-silent then v-mess else '':U).
     2539       end.
     2540   define variable v-label-param as character no-undo .
     2541   v-label-param =
     2542     "accnt-type" + chr(4) + "Учетная политика" + chr(4) + "" + chr(8)
     2543    + "all-prt" + chr(4) + "Перес. на кассу все признаков товара" + chr(4) + "" + chr(8)
     2544    + "an-uchet-code-in" + chr(4) + "Код аналит. учет по умолч" + chr(4) + "" + chr(8)
     2545    + "artic-disable" + chr(4) + "Автомат. артикул" + chr(4) + "" + chr(8)
     2546    + "avrg-price" + chr(4) + "Средние учетные цены" + chr(4) + "" + chr(8)
