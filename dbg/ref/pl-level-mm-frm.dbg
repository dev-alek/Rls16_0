        1   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        2   define input parameter p-obj-type  like ub.pl-level-mm.obj-type no-undo.
        3   define input parameter p-obj-code  like ub.pl-level-mm.obj-code no-undo.
        4   define input parameter p-pl-code   like ub.pl-level-mm.pl-code  no-undo.
        5   define input parameter p-locl      like ub.place.loc1           no-undo.
        6   define input parameter p-mode as character no-undo.
        7   define input-output parameter p-rid as recid init ? no-undo.
        8   define variable vss-revision    as character no-undo init "$Revision: $":U .
        9   define variable vss-author      as character no-undo init "$Author: $":U .
       10   define variable vss-date        as character no-undo init "$Date: $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: $":U .
       13   define variable vss-description as character no-undo init "Карточка поясной вместимости".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   procedure proc-alt-shift-f2:
       75     if not ibs.th.gbl.gbl-var:rcode
       76   then
       77     run gbl\inidebug.p .
       78   end.
       79   procedure proc-alt-shift-f3:
       80     run gbl/prvssinf.p
       81       ( input this-procedure
       82       ) .
       83   end.
       84   define variable v-inform-launched as logical no-undo initial false .
       85   procedure proc-alt-shift-f4:
       86     define variable v-action as character no-undo .
       87     if v-inform-launched = false then do:
       88       assign
       89         v-inform-launched = true
       90       .
       91       run gbl/d-inform.w
       92         (  input self
       93         ,  input this-procedure
       94         , output v-action
       95         ) no-error .
       96       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       97       assign
       98         v-inform-launched = false
       99       .
      100     end.
      101   end.
      102   procedure proc-alt-f1:
      103     run gbl/corrhelp.p
      104       (input this-procedure
      105       ) .
      106   end .
      107   on alt-shift-f2 anywhere do:
      108     run proc-alt-shift-f2.
      109   end.
      110   on alt-shift-f3 anywhere do:
      111     run proc-alt-shift-f3 in this-procedure .
      112   end.
      113   on alt-shift-f4 anywhere do:
      114     run proc-alt-shift-f4 in this-procedure.
      115   end.
      116   on alt-f1 anywhere do:
      117     run proc-alt-f1 in this-procedure .
      118   end.
      119   define buffer buf_pl-level-mm for ub.pl-level-mm.
      120   DEFINE BUTTON B-Help
      121        LABEL "Помо&щь"
      122        SIZE 10 BY 1
      123        BGCOLOR 8 .
      124   DEFINE BUTTON b-quit AUTO-END-KEY
      125        LABEL "&Отмена"
      126        SIZE 10 BY 1
      127        BGCOLOR 8 .
      128   DEFINE BUTTON B-save AUTO-GO
      129        LABEL "&Ввод"
      130        SIZE 10 BY 1
      131        BGCOLOR 8 .
      132   DEFINE VARIABLE f-capacity AS DECIMAL FORMAT ">>>>>>>>9":U INITIAL 0
      133        LABEL "Поясная вместимость, л"
      134        VIEW-AS FILL-IN
      135        SIZE 53 BY 1 NO-UNDO.
      136   DEFINE VARIABLE f-level AS INTEGER FORMAT ">>>>>9":U INITIAL 0
      137        LABEL "Уровень, мм"
      138        VIEW-AS FILL-IN
      139        SIZE 53 BY 1 NO-UNDO.
      140   DEFINE VARIABLE f-max-level AS DECIMAL FORMAT ">>>>>9":U INITIAL 0
      141        LABEL "Верхний уровень пояса, см"
      142        VIEW-AS FILL-IN
      143        SIZE 53 BY 1 NO-UNDO.
      144   DEFINE VARIABLE f-min-level AS DECIMAL FORMAT ">>>>>9":U INITIAL 0
      145        LABEL "Нижний уровень пояса, см"
      146        VIEW-AS FILL-IN
      147        SIZE 53 BY 1 NO-UNDO.
      148   DEFINE VARIABLE f-zone AS INTEGER FORMAT ">>>>>9":U INITIAL 0
      149        LABEL "Номер пояса"
      150        VIEW-AS FILL-IN
      151        SIZE 53 BY 1 NO-UNDO.
      152   DEFINE FRAME Dialog-Frame
      153        B-save AT ROW 1.14 COL 1.4
      154        b-quit AT ROW 1.14 COL 11.4
      155        B-Help AT ROW 1.14 COL 36.4
      156        f-zone AT ROW 2.43 COL 27 COLON-ALIGNED WIDGET-ID 4
      157        f-min-level AT ROW 3.62 COL 27 COLON-ALIGNED WIDGET-ID 10
      158        f-max-level AT ROW 4.81 COL 27 COLON-ALIGNED WIDGET-ID 26
      159        f-level AT ROW 6 COL 27 COLON-ALIGNED WIDGET-ID 28
      160        f-capacity AT ROW 7.19 COL 27 COLON-ALIGNED WIDGET-ID 30
      161        SPACE(3.19) SKIP(0.56)
      162       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      163            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      164            TITLE ""
      165            DEFAULT-BUTTON B-save CANCEL-BUTTON b-quit.
      166   ASSIGN
      167          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      168          FRAME Dialog-Frame:HIDDEN           = TRUE.
      169   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      170   DO:
      171     APPLY "END-ERROR":U TO SELF.
      172   END.
      173   ON CHOOSE OF B-save IN FRAME Dialog-Frame
      174   DO:
      175     define buffer bf_pl-level-mm for ub.pl-level-mm.
      176     assign frame Dialog-Frame
      177       f-zone
      178       f-min-level
      179       f-max-level
      180       f-level
      181       f-capacity
      182     .
      183     find first bf_pl-level-mm where
      184                bf_pl-level-mm.obj-type  = p-obj-type
      185            and bf_pl-level-mm.obj-code  = p-obj-code
      186            and bf_pl-level-mm.pl-code   = p-pl-code
      187            and (if p-rid <> ? then recid(bf_pl-level-mm) <> p-rid else true)
      188            and ((bf_pl-level-mm.min-level = f-min-level and
      189                  bf_pl-level-mm.max-level = f-max-level and
      190                  bf_pl-level-mm.level     = f-level) or
      191                 (bf_pl-level-mm.min-level <= f-min-level and
      192                  bf_pl-level-mm.max-level >= f-min-level and
      193                  bf_pl-level-mm.zone <> f-zone) or
      194                 (bf_pl-level-mm.min-level <= f-max-level and
      195                  bf_pl-level-mm.max-level >= f-max-level and
      196                  bf_pl-level-mm.zone <> f-zone) or
      197                 (bf_pl-level-mm.zone = f-zone and
      198                  bf_pl-level-mm.level = f-level))
      199          no-lock no-error.
      200     if avail bf_pl-level-mm then
      201     do:
      202       message substitute("Найдено пересечение поясов № &1 и № &2 по уровню пояса &3.~nСохранение невозможно!",
      203                          bf_pl-level-mm.min-level, bf_pl-level-mm.max-level, bf_pl-level-mm.level)
      204               view-as alert-box message
      205               buttons ok
      206               title "Ошибка при сохранении".
      207       return no-apply.
      208     end.
      209     run proc-save in this-procedure no-error.
      210     if error-status:error then return no-apply.
      211   END.
      212   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      213   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      214   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      215   on help of frame Dialog-Frame
      216   do:
      217     run gbl/app_help.p
      218       (input this-procedure :file-name
      219       ,input ''
      220       ,input ?
      221       ) no-error.
      222     if error-status :error then do:
      223       message
      224         "Ошибка при вызове помощи"
      225         error-status :get-message(1)
      226         view-as alert-box .
      227     end.
      228   end.
      229   run minbtn-set in this-procedure .
      230   on choose of b-help in frame Dialog-Frame
      231   do:
      232     apply "help":u to frame Dialog-Frame .
      233   end.
      234   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      235   procedure minbtn-set :
      236       do
      237           on error undo, return error return-value
      238           :
      239           define variable ii              as integer       no-undo .
      240           define variable fh              as widget-handle no-undo .
      241           define variable hh              as widget-handle no-undo .
      242           define variable v-h             as handle        extent 4 no-undo .
      243           define variable v-name-button   as character     no-undo .
      244           define variable v-help-old-x    as decimal       no-undo .
      245           define variable v-help-old-y    as decimal       no-undo .
      246           define variable v-help-old-size as decimal       no-undo .
      247           define variable v-frame-width   as decimal       no-undo .
      248           define variable jj              as integer       no-undo .
      249           do
      250               on error undo, return error
      251               :
      252               assign
      253                   v-frame-width = frame Dialog-Frame:width - 0.3
      254                   fh            = frame Dialog-Frame:first-child
      255                   hh            = fh:first-child
      256                   ii            = 1
      257                   .
      258               do while valid-handle(hh):
      259                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      260                   do:
      261                       case lc(hh:name) :
      262                           when "b-help" then
      263                               do:
      264                                   hh:load-image-up("cmp/b-help.bmp":u) .
      265                                   hh:load-image-down("cmp/b-help.bmp":u) .
      266                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      267                                   hh:TOOLTIP = "Помощь" .
      268                                   v-help-old-x = hh:column .
      269                                   v-help-old-y = hh:row    .
      270                                   v-help-old-size = hh:width .
      271                                   hh:width-chars = 2.5 .
      272                               end.
      273                           when "b-print" then
      274                               do:
      275                                   hh:load-image("cmp/b-print.bmp":u) .
      276                                   hh:TOOLTIP = "Печать" .
      277                                   v-h[ii] = hh:handle .
      278                                   ii = ii + 1 .
      279                                   hh:width-chars = 3 .
      280                               end.
      281                           when "b-history" or
      282                           when "b-hist" then
      283                               do:
      284                                   hh:load-image("cmp/b-hist.bmp":u) .
      285                                   hh:TOOLTIP = "История" .
      286                                   v-h[ii] = hh:handle .
      287                                   ii = ii + 1 .
      288                                   hh:width-chars = 3 .
      289                               end.
      290                           when "b-sch" then
      291                               do:
      292                                   hh:load-image("cmp/b-sch.bmp":u) .
      293                                   hh:TOOLTIP = "Установка Фильтра" .
      294                                   v-h[ii] = hh:handle .
      295                                   ii = ii + 1 .
      296                                   hh:width-chars = 3 .
      297                               end.
      298                           when "b-hist-user" then
      299                               do:
      300                                   hh:load-image("cmp/b-hist.bmp":u) .
      301                                   hh:TOOLTIP = "История пользователя" .
      302                                   ii = ii + 1 .
      303                               end.
      304                       end case.
      305                   end.
      306                   hh = hh:next-sibling.
      307               end.
      308               b-help:column = v-frame-width - b-help:width-chars.
      309               jj = 0.
      310               repeat ii = 4 to 1 by -1 :
      311                   if valid-handle (v-h[ii] ) then
      312                   do:
      313                       jj  = jj + 1 .
      314                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      315                       v-h[ii]:row    = v-help-old-y .
      316                   end.
      317               end.
      318           end.
      319       end.
      320   end procedure.
      321   MAIN-BLOCK:
      322   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      323      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      324      if p-mode <> 'ДОБАВЛЕНИЕ':U and
      325         p-mode <> 'ИЗМЕНЕНИЕ':U and
      326         p-mode <> 'ПРОСМОТР':U
      327      then do:
      328         message
      329         vss-workfile vss-revision vss-description skip
      330         "Неверное значение параметров вызова p-mode"  p-mode
      331         view-as alert-box ERROR.
      332         undo, return error.
      333      end.
      334      frame Dialog-Frame:title = substitute(
      335        "&1 строки поясной вместимости для резервуара &2 (&3) &4 &5",
      336        p-mode, p-pl-code, p-locl, p-obj-type, p-obj-code
      337      ).
      338      if p-mode = 'ИЗМЕНЕНИЕ':U or p-mode = 'ПРОСМОТР':U then do:
      339         if p-mode = 'ПРОСМОТР':U then do:
      340           find first buf_pl-level-mm where
      341                      recid(buf_pl-level-mm) = p-rid no-lock no-error.
      342         end.
      343         else do:
      344           find first buf_pl-level-mm where
      345                      recid(buf_pl-level-mm) = p-rid exclusive-lock no-wait no-error.
      346           if locked buf_pl-level-mm then do:
      347              message
      348                 vss-workfile vss-revision vss-description skip
      349                 "Запись <Пояса> занята"
      350              view-as alert-box error .
      351              undo, return error.
      352           end.
      353         end.
      354         if not available buf_pl-level-mm then do:
      355            message
      356               vss-workfile vss-revision vss-description skip
      357               "Не найдена запись <Пояса>"
      358            view-as alert-box error .
      359            undo, return error.
      360         end.
      361         assign
      362           f-zone      = buf_pl-level-mm.zone
      363           f-min-level = buf_pl-level-mm.min-level
      364           f-max-level = buf_pl-level-mm.max-level
      365           f-level     = buf_pl-level-mm.level
      366           f-capacity  = buf_pl-level-mm.capacity
      367         no-error.
      368      end.
      369      run enable_UI in this-procedure.
      370      if p-mode = 'ПРОСМОТР':U then do:
      371        disable
      372          f-zone
      373          f-min-level
      374          f-max-level
      375          f-level
      376          f-capacity
      377          b-save
      378        with frame Dialog-Frame.
      379      end.
      380      else do:
      381        apply "entry" to f-zone in FRAME Dialog-Frame.
      382      end.
      383      WAIT-FOR GO OF FRAME Dialog-Frame.
      384   END.
      385   session:data-entry-return = no .
      386   RUN disable_UI.
      387   PROCEDURE disable_UI :
      388     HIDE FRAME Dialog-Frame.
      389   END PROCEDURE.
      390   PROCEDURE enable_UI :
      391     DISPLAY f-zone f-min-level f-max-level f-level f-capacity
      392         WITH FRAME Dialog-Frame.
      393     ENABLE B-save b-quit B-Help f-zone f-min-level f-max-level f-level f-capacity
      394         WITH FRAME Dialog-Frame.
      395     VIEW FRAME Dialog-Frame.
      396   END PROCEDURE.
      397   PROCEDURE proc-save :
      398      if f-zone = 0 or
      399         f-max-level = 0 or
      400         f-level     = 0 or
      401         f-capacity  = 0 then
      402      do:
      403        message "Ошибка при сохранении.~n"
      404                "Необходимо заполнить все поля формы." view-as alert-box.
      405        apply "ENTRY" to f-zone in frame Dialog-Frame.
      406        return error.
      407      end.
      408      do on error undo, return error
      409      on stop undo, return error:
      410         if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      411            create buf_pl-level-mm.
      412            assign
      413              buf_pl-level-mm.obj-type = p-obj-type
      414              buf_pl-level-mm.obj-code = p-obj-code
      415              buf_pl-level-mm.pl-code  = p-pl-code
      416              p-rid = recid(buf_pl-level-mm).
      417            .
      418         end.
      419         assign
      420           buf_pl-level-mm.zone      = f-zone
      421           buf_pl-level-mm.min-level = f-min-level
      422           buf_pl-level-mm.max-level = f-max-level
      423           buf_pl-level-mm.level     = f-level
      424           buf_pl-level-mm.capacity  = f-capacity
      425         .
      426      end.
      427   END PROCEDURE.
