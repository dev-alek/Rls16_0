      497     return error '':u.
      498   end.
      499   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      500   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      501     (output v-db-num
      502     )  .
      503   if p-asmt-name = "":U then do:
      504     run err-mess ("Название ассортиментной матрицы не может быть пустым").
      505     return error "asmt-name":U.
      506   end.
      507   _MAIN:
      508   DO ON ERROR UNDO, RETURN ERROR
      509   ON STOP UNDO, RETURN ERROR:
      510   define variable v-date as date no-undo .
      511   define variable v-time as integer no-undo .
      512   if p-type = 'Объект':U then do:
      513       if p-obj-type = "" and p-obj-code = 0 then do:
      514           message "Не заполнено значение Объекта !"
      515                    view-as alert-box error.
      516           undo, return error .
      517       end.
      518       define buffer x_curr_clients for ub.clients.
      519         find first  x_curr_clients no-lock where
      520                   x_curr_clients.obj-type = p-obj-type and
      521                   x_curr_clients.obj-code = p-obj-code no-error.
      522         if not available x_curr_clients then do:
      523         message
      524         "Неверное значение для поиска Объекта"
      525             p-obj-type
      526             p-obj-code
      527             view-as alert-box error.
      528         undo, return error .
      529         end.
      530          if v-db-num > 0 then do:
      531           if x_curr_clients.db-num <>  v-db-num then do:
      532               message
      533               "На УБД нельзя добавлять/корректировать Ассортиментные матрици по Объектам других БД" skip
      534                   p-obj-type p-obj-code skip
      535                   "БД : " x_curr_clients.db-num
      536                   view-as alert-box error.
      537               undo, return error .
      538           end.
      539          end.
      540   end.
      541   run cur-time in this-procedure(output v-date, output v-time).
      542     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      543       if p-type = 'Объект':U then do:
      544       define buffer obj_matrix for ub.assortment-matrix.
      545       find first obj_matrix no-lock where
      546                  obj_matrix.asmt-type = 'Объект':U and
      547                  obj_matrix.asmt-status  = 0 and
      548                  obj_matrix.obj-type  = p-obj-type and
      549                  obj_matrix.obj-code  = p-obj-code no-error .
      550        if available obj_matrix then do:
      551         message
      552            "Уже существует текущая Ассортиментная матрица для Объекта" skip
      553             p-obj-type  p-obj-code skip
      554             "Название: " obj_matrix.asmt-name skip
      555             view-as alert-box error.
      556         undo, return error .
      557        end.
      558       end.
      559       create ub.assortment-matrix.
      560       assign
      561       ub.assortment-matrix.asmt-id = next-value(s-asmt, ub)
      562       ub.assortment-matrix.asmt-date-create    = v-date
      563       ub.assortment-matrix.asmt-time-create    = v-time
      564       ub.assortment-matrix.asmt-db-num-create  = g#db-num
      565       ub.assortment-matrix.asmt-db-num-update  = g#db-num
      566       ub.assortment-matrix.asmt-who-create     = g#userid
      567       ub.assortment-matrix.db-num              = g#db-num
      568   .
      569       p-doc-rec = recid(ub.assortment-matrix)
      570       .
      571     end.
      572     else do:
      573       FIND FIRST ub.assortment-matrix where
      574                 recid(ub.assortment-matrix) = p-doc-rec No-ERROR.
      575       if not available ub.assortment-matrix then do:
      576         message
      577         vss-workfile vss-revision vss-description skip
      578         "Не найдена запись АМ - p-doc-rec" p-doc-rec
      579         view-as alert-box error .
      580         undo, return error '':u.
      581       end.
      582       if ub.assortment-matrix.asmt-id <> p-asmt-id
      583       then do:
      584         message
      585         vss-workfile vss-revision vss-description skip
      586         "Для уже имеющейся записи нельзя изменить"
      587         "внутренний код" skip
      588         view-as alert-box ERROR.
      589         undo, return error '':U.
      590       end.
      591     end.
      592     assign
      593       ub.assortment-matrix.asmt-name     = p-asmt-name
      594       ub.assortment-matrix.asmt-des      = p-des
      595       ub.assortment-matrix.asmt-type     = p-type
      596       ub.assortment-matrix.asmt-status   =  (if p-mode = 'ДОБАВЛЕНИЕ':U
      597           then 0
      598           else ub.assortment-matrix.asmt-status )
      599       ub.assortment-matrix.obj-type = if p-type = 'Шаблон':U then "" else p-obj-type
      600       ub.assortment-matrix.obj-code = if p-type = 'Шаблон':U then 0  else p-obj-code
      601     .
      602   define variable v-exist as logical   no-undo .
      603   define variable v-delete as logical   no-undo .
      604     if p-rel = false  then do:
      605         run assmatat-delete (
      606           input ub.assortment-matrix.asmt-id
      607          ,input ub.assortment-matrix.db-num
      608          ,input 'RootShablon':U
      609          ,output v-delete
      610          ) no-error .
      611          if error-status :error then message
      612            vss-workfile vss-revision vss-description skip
      613            error-status :get-message(1) skip
      614            return-value skip
      615            "55"
      616            view-as alert-box error
      617          .
      618     end.
      619     else do:
      620       run assmatat-write (
      621          input ub.assortment-matrix.asmt-id
      622         ,input ub.assortment-matrix.db-num
      623         ,input 'RootShablon':U
      624         ,input p-rootshablon
      625         ) no-error .
      626         if error-status :error then message
      627           vss-workfile vss-revision vss-description skip
      628           error-status :get-message(1) skip
      629           return-value skip
      630           "66"
      631           view-as alert-box error
      632         .
      633     end.
      634   end.
      635   PROCEDURE err-mess:
      636     DEFINE INPUT PARAMETER p-mess as character No-UNDO.
      637         message
      638         p-mess
      639         view-as alert-box error .
      640   END PROCEDURE.
