     1293   .
     1294   procedure diasize_change-height :
     1295     define input  parameter p-change-value  as decimal   no-undo .
     1296     define input  parameter p-move-resize   as logical   no-undo .
     1297     define variable v-field-group-handle    as handle    no-undo .
     1298     define variable v-object-handle         as handle    no-undo .
     1299     define variable v-frame-height          as decimal   no-undo .
     1300     define variable v-frame-virtual-height  as decimal   no-undo .
     1301     define variable v-browse-height         as decimal   no-undo .
     1302     define variable v-window-height         as decimal   no-undo .
     1303     define variable v-window-virtual-height as decimal   no-undo .
     1304     define variable v-change-sign           as integer   no-undo .
     1305     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1306     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1307     if p-change-value > 0
     1308     then do:
     1309       if frame Dialog-Frame :height + p-change-value
     1310           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1311       then do:
     1312         assign
     1313           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1314                           - (frame Dialog-Frame :height-chars)
     1315         .
     1316         if p-change-value <= 0
     1317         then do:
     1318           run diasize_position-resize-button in this-procedure .
     1319           return .
     1320         end.
     1321       end.
     1322     end.
     1323     if p-change-value < 0
     1324     then do:
     1325       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1326       then do:
     1327         assign
     1328           p-change-value = v-diasize-orig-frame-height
     1329                          - (frame Dialog-Frame :height-chars)
     1330         .
     1331         if p-change-value >= 0
     1332         then do:
     1333           run diasize_position-resize-button in this-procedure .
     1334           return .
     1335         end.
     1336       end.
     1337     end.
     1338     if p-change-value >= 0
     1339     then do:
     1340       assign
     1341         v-change-sign = 1
     1342       .
     1343     end.
     1344     else do:
     1345       assign
     1346         v-change-sign = -1
     1347       .
     1348     end.
     1349     assign
     1350       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1351     .
     1352     if p-change-value = 0
     1353     then do:
     1354       run diasize_position-resize-button in this-procedure .
     1355       return .
     1356     end.
     1357     move_block:
     1358     do
     1359     on error undo move_block, retry move_block
     1360     :
     1361       if retry
     1362       then do:
     1363         do
     1364         on error undo move_block, leave move_block
     1365         :
     1366           if p-change-value > 0
     1367           then do:
     1368             for each buf_temp-diasize-handle
     1369             on error undo, next
     1370             :
     1371               assign
     1372                 v-object-handle = buf_temp-diasize-handle.handle-value
     1373               .
     1374               if v-object-handle <> v-diasize-resize-button
     1375               then do:
     1376                 assign
     1377                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1378                 .
     1379               end.
     1380             end.
     1381             assign
     1382               v-diasize-browse-handle :height = v-browse-height
     1383             .
     1384             for each buf_temp-browse-handle
     1385               where buf_temp-browse-handle.browse-type = 'height':u
     1386             on error undo, next
     1387             :
     1388               assign
     1389                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1390               .
     1391             end.
     1392             assign
     1393               frame Dialog-Frame :height = v-frame-height
     1394             .
     1395             if frame Dialog-Frame :scrollable = true
     1396             then do:
     1397               assign
     1398                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1399               .
     1400             end.
     1401             run diasize_position-resize-button in this-procedure .
     1402           end.
     1403           else do:
     1404             if frame Dialog-Frame :scrollable = true
     1405             then do:
     1406               assign
     1407                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1408               .
     1409             end.
     1410             assign
     1411               frame Dialog-Frame :height = v-frame-height
     1412             .
     1413             assign
     1414               v-diasize-browse-handle :height = v-browse-height
     1415             .
     1416             for each buf_temp-browse-handle
     1417               where buf_temp-browse-handle.browse-type = 'height':u
     1418             on error undo, next
     1419             :
     1420               assign
     1421                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1422               .
     1423             end.
     1424             for each buf_temp-diasize-handle
     1425             on error undo, next
     1426             :
     1427               assign
     1428                 v-object-handle = buf_temp-diasize-handle.handle-value
     1429               .
     1430               if v-object-handle <> v-diasize-resize-button
     1431               then do:
     1432                 assign
     1433                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1434                 .
     1435               end.
     1436             end.
     1437             run diasize_position-resize-button in this-procedure .
     1438           end.
     1439           assign
     1440             v-diasize-change-size = false
     1441           .
     1442           leave move_block .
     1443         end.
     1444       end.
     1445       assign
     1446         v-diasize-need-full-display = true
     1447       .
     1448       if v-diasize-change-size = false
     1449       then do:
     1450         assign
     1451           v-diasize-change-size = true
     1452         .
     1453       end.
     1454       else do:
     1455         return .
     1456       end.
     1457       assign
     1458         v-frame-height = frame Dialog-Frame :height
     1459         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1460         v-browse-height = v-diasize-browse-handle :height
     1461       .
     1462       for each buf_temp-browse-handle
     1463         where buf_temp-browse-handle.browse-type = 'height':u
     1464       :
     1465         assign
     1466           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1467         .
     1468       end.
     1469       for each buf_temp-diasize-handle
     1470       :
     1471         delete buf_temp-diasize-handle .
     1472       end.
     1473       assign
     1474         v-field-group-handle = frame Dialog-Frame :first-child
     1475       .
     1476       do while valid-handle(v-field-group-handle)
     1477       :
     1478         assign
     1479           v-object-handle = v-field-group-handle :first-child
     1480         .
     1481         do while valid-handle(v-object-handle)
     1482         :
     1483           if  v-object-handle <> v-diasize-browse-handle :handle
     1484           and can-query(v-object-handle, "row")
     1485           and can-query(v-object-handle, "height")
     1486           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1487           then do:
     1488             find first buf_temp-browse-handle
     1489               where buf_temp-browse-handle.browse-type   = 'height':u
     1490                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1491               no-error .
     1492             if available buf_temp-browse-handle
     1493             then do:
     1494             end.
     1495             else do:
     1496               create buf_temp-diasize-handle .
     1497               assign
     1498                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1499                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1500               .
     1501             end.
     1502           end.
     1503           assign
     1504             v-object-handle = v-object-handle :next-sibling
     1505           .
     1506         end.
     1507         assign
     1508           v-field-group-handle = v-field-group-handle :next-sibling
     1509         .
     1510       end.
     1511       do with frame Dialog-Frame
     1512       :
     1513         hide v-diasize-resize-button .
     1514         assign
     1515           v-diasize-resize-button :row    = 1
     1516           v-diasize-resize-button :column = 1
     1517         .
     1518       end.
     1519       if p-change-value > 0
     1520       then do:
     1521         if frame Dialog-Frame :scrollable = true
     1522         then do:
     1523           assign
     1524             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1525             no-error .
     1526           if error-status :error
     1527           or error-status :get-message(1) <> ""
     1528           then do:
     1529             undo move_block, retry move_block .
     1530           end.
     1531         end.
     1532         assign
     1533           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1534           no-error .
     1535         if error-status :error
     1536         or error-status :get-message(1) <> ""
     1537         then do:
     1538           undo move_block, retry move_block .
     1539         end.
     1540         assign
     1541           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1542           no-error .
     1543         if error-status :error
     1544         or error-status :get-message(1) <> ""
     1545         then do:
     1546           undo move_block, retry move_block .
     1547         end.
     1548         for each buf_temp-browse-handle
     1549           where buf_temp-browse-handle.browse-type = 'height':u
     1550         on error undo move_block, retry move_block
     1551         :
     1552           assign
     1553             buf_temp-browse-handle.browse-handle :height
     1554               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1555             no-error .
     1556           if error-status :error
     1557           or error-status :get-message(1) <> ""
     1558           then do:
     1559             undo move_block, retry move_block .
     1560           end.
     1561         end.
     1562         for each buf_temp-diasize-handle
     1563         on error undo move_block, retry move_block
     1564         :
     1565           assign
     1566             v-object-handle = buf_temp-diasize-handle.handle-value
     1567           .
     1568           if v-object-handle <> v-diasize-resize-button
     1569           then do:
     1570             assign
     1571               v-object-handle :row = v-object-handle :row + p-change-value
     1572               no-error .
     1573             if error-status :error
     1574             or error-status :get-message(1) <> ""
     1575             then do:
     1576               undo move_block, retry move_block .
     1577             end.
     1578           end.
     1579         end.
     1580       end.
     1581       else do:
     1582         for each buf_temp-diasize-handle
     1583         on error undo move_block, retry move_block
     1584         :
     1585           assign
     1586             v-object-handle = buf_temp-diasize-handle.handle-value
     1587           .
     1588           if v-object-handle <> v-diasize-resize-button
     1589           then do:
     1590             assign
     1591               v-object-handle :row = v-object-handle :row + p-change-value
     1592               no-error .
     1593             if error-status :error
     1594             or error-status :get-message(1) <> ""
     1595             then do:
     1596               undo move_block, retry move_block .
     1597             end.
     1598           end.
     1599         end.
     1600         assign
     1601           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1602           no-error .
     1603         if error-status :error
     1604         or error-status :get-message(1) <> ""
     1605         then do:
     1606           undo move_block, retry move_block .
     1607         end.
     1608         for each buf_temp-browse-handle
     1609           where buf_temp-browse-handle.browse-type = 'height':u
     1610         on error undo move_block, retry move_block
     1611         :
     1612           assign
     1613             buf_temp-browse-handle.browse-handle :height
     1614               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1615             no-error .
     1616           if error-status :error
     1617           or error-status :get-message(1) <> ""
     1618           then do:
     1619             undo move_block, retry move_block .
     1620           end.
     1621         end.
     1622         assign
     1623           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1624           no-error .
     1625         if error-status :error
     1626         or error-status :get-message(1) <> ""
     1627         then do:
     1628           undo move_block, retry move_block .
     1629         end.
     1630         if frame Dialog-Frame :scrollable = true
     1631         then do:
     1632           assign
     1633             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1634             no-error .
     1635           if error-status :error
     1636           or error-status :get-message(1) <> ""
     1637           then do:
     1638             undo move_block, retry move_block .
     1639           end.
     1640         end.
     1641       end.
     1642       if p-move-resize = true
     1643       then do:
     1644         run diasize_position-resize-button in this-procedure .
     1645       end.
     1646       if v-diasize-wndstore = true
     1647       then do:
     1648         if connected("ub") = true
     1649         then do:
     1650           define variable v-cntxt-db-num        as integer   no-undo .
     1651           define variable v-cntxt-userid        as character no-undo .
     1652           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1653                                             , OUTPUT v-cntxt-userid
     1654                                             ) .
     1655           run gbl/wndsizew.p
     1656             (input  v-cntxt-db-num
     1657             ,input  v-cntxt-userid
     1658             ,input  v-diasize-proc-name
     1659             ,input  'height':u
     1660             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1661             ) .
     1662         end.
     1663       end.
     1664     end.
     1665     assign
     1666       v-diasize-change-size = false
     1667     .
     1668   end procedure.
     1669   procedure diasize_set-height :
     1670     define input  parameter p-new-height  as decimal   no-undo .
     1671     define input  parameter p-move-resize as logical   no-undo .
     1672     do
     1673     on error undo, return error return-value
     1674     :
     1675       run diasize_change-height in this-procedure
     1676         (input  (p-new-height - frame Dialog-Frame :height)
     1677         ,input  p-move-resize
     1678         ) .
     1679     end.
     1680   end procedure.
     1681   procedure diasize_change-width :
     1682     define input  parameter p-change-value as decimal   no-undo .
     1683     define input  parameter p-move-resize  as logical   no-undo .
     1684     define variable v-field-group-handle   as handle    no-undo .
     1685     define variable v-object-handle        as handle    no-undo .
     1686     define variable v-frame-width          as decimal   no-undo .
     1687     define variable v-frame-virtual-width  as decimal   no-undo .
     1688     define variable v-browse-width         as decimal   no-undo .
     1689     define variable v-window-width         as decimal   no-undo .
     1690     define variable v-window-virtual-width as decimal   no-undo .
     1691     define variable v-change-sign          as integer   no-undo .
     1692     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1693     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1694     if p-change-value > 0
     1695     then do:
     1696       if frame Dialog-Frame :width + p-change-value >
     1697           session :width-chars
     1698       then do:
     1699         assign
     1700           p-change-value = session :width-chars - frame Dialog-Frame :width
     1701         .
     1702         if p-change-value <= 0
     1703         then do:
     1704           run diasize_position-resize-button in this-procedure .
     1705           return .
     1706         end.
     1707       end.
     1708     end.
     1709     if p-change-value < 0
     1710     then do:
     1711       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1712       then do:
     1713         assign
     1714           p-change-value = v-diasize-orig-frame-width
     1715                          - frame Dialog-Frame :width
     1716         .
     1717         if p-change-value >= 0
     1718         then do:
     1719           run diasize_position-resize-button in this-procedure .
     1720           return .
     1721         end.
     1722       end.
     1723     end.
     1724     if p-change-value >= 0
     1725     then do:
     1726       assign
     1727         v-change-sign = 1
     1728       .
     1729     end.
     1730     else do:
     1731       assign
     1732         v-change-sign = -1
     1733       .
     1734     end.
     1735     assign
     1736       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1737     .
     1738     if p-change-value = 0
     1739     then do:
     1740       run diasize_position-resize-button in this-procedure .
     1741       return .
     1742     end.
     1743     move_block:
     1744     do
     1745     on error undo move_block, leave move_block
     1746     :
     1747       if retry
     1748       then do:
     1749         do
     1750         on error undo move_block, leave move_block
     1751         :
     1752           if p-change-value > 0
     1753           then do:
     1754             for each buf_temp-diasize-handle
     1755             on error undo, next
     1756             :
     1757               assign
     1758                 v-object-handle = buf_temp-diasize-handle.handle-value
     1759               .
     1760               if v-object-handle <> v-diasize-resize-button
     1761               then do:
     1762                 assign
     1763                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1764                 .
     1765               end.
     1766             end.
     1767             assign
     1768               v-diasize-browse-handle :width = v-browse-width
     1769             .
     1770             for each buf_temp-browse-handle
     1771               where buf_temp-browse-handle.browse-type = 'width':u
     1772             on error undo, next
     1773             :
     1774               assign
     1775                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1776               .
     1777             end.
     1778             assign
     1779               frame Dialog-Frame :width = v-frame-width
     1780             .
     1781             if frame Dialog-Frame :scrollable = true
     1782             then do:
     1783               assign
     1784                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1785               .
     1786             end.
     1787             run diasize_position-resize-button in this-procedure .
     1788           end.
     1789           else do:
     1790             if frame Dialog-Frame :scrollable = true
     1791             then do:
     1792               assign
     1793                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1794               .
     1795             end.
     1796             assign
     1797               frame Dialog-Frame :width = v-frame-width
     1798             .
     1799             for each buf_temp-browse-handle
     1800               where buf_temp-browse-handle.browse-type = 'width':u
     1801             on error undo, next
     1802             :
     1803               assign
     1804                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1805               .
     1806             end.
     1807             assign
     1808               v-diasize-browse-handle :width = v-browse-width
     1809             .
     1810             for each buf_temp-diasize-handle
     1811             on error undo, next
     1812             :
     1813               assign
     1814                 v-object-handle = buf_temp-diasize-handle.handle-value
     1815               .
     1816               if v-object-handle <> v-diasize-resize-button
     1817               then do:
     1818                 assign
     1819                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1820                 .
     1821               end.
     1822             end.
     1823             run diasize_position-resize-button in this-procedure .
     1824           end.
     1825           assign
     1826             v-diasize-change-size = false
     1827           .
     1828           leave move_block .
     1829         end.
     1830       end.
     1831       assign
     1832         v-diasize-need-full-display = true
     1833       .
     1834       if v-diasize-change-size = false
     1835       then do:
     1836         assign
     1837           v-diasize-change-size = true
     1838         .
     1839       end.
     1840       else do:
     1841         return .
     1842       end.
     1843       assign
     1844         v-frame-width = frame Dialog-Frame :width
     1845         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1846         v-browse-width = v-diasize-browse-handle :width
     1847       .
     1848       for each buf_temp-browse-handle
     1849         where buf_temp-browse-handle.browse-type = 'width':u
     1850       :
     1851         assign
     1852           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1853         .
     1854       end.
     1855       for each buf_temp-diasize-handle
     1856       :
     1857         delete buf_temp-diasize-handle .
     1858       end.
     1859       assign
     1860         v-field-group-handle = frame Dialog-Frame :first-child
     1861       .
     1862       do while valid-handle(v-field-group-handle)
     1863       :
     1864         assign
     1865           v-object-handle = v-field-group-handle :first-child
     1866         .
     1867         do while valid-handle(v-object-handle)
     1868         :
     1869           if  v-object-handle <> v-diasize-browse-handle :handle
     1870           and v-object-handle <> v-diasize-resize-button
     1871           and can-query(v-object-handle, "row")
     1872           and can-query(v-object-handle, "height")
     1873           and ( v-object-handle :col + v-object-handle :width
     1874                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1875               )
     1876           then do:
     1877             find first buf_temp-browse-handle
     1878               where buf_temp-browse-handle.browse-type   = 'width':u
     1879                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1880               no-error .
     1881             if available buf_temp-browse-handle
     1882             then do:
     1883             end.
     1884             else do:
     1885               create buf_temp-diasize-handle .
     1886               assign
     1887                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1888                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1889               .
     1890             end.
     1891           end.
     1892           assign
     1893             v-object-handle = v-object-handle :next-sibling
     1894           .
     1895         end.
     1896         assign
     1897           v-field-group-handle = v-field-group-handle :next-sibling
     1898         .
     1899       end.
     1900       do with frame Dialog-Frame
     1901       :
     1902         hide v-diasize-resize-button .
     1903         v-diasize-resize-button :row = 1.
     1904         v-diasize-resize-button :column = 1.
     1905       end.
     1906       if p-change-value > 0
     1907       then do:
     1908         if frame Dialog-Frame :scrollable = true
     1909         then do:
     1910           assign
     1911             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1912             no-error .
     1913           if error-status :error
     1914           or error-status :get-message(1) <> ""
     1915           then do:
     1916             undo move_block, retry move_block.
     1917           end.
     1918         end.
     1919         assign
     1920           frame Dialog-Frame :width = v-frame-width + p-change-value
     1921           no-error .
     1922         if error-status :error
     1923         or error-status :get-message(1) <> ""
     1924         then do:
     1925           undo move_block, retry move_block.
     1926         end.
     1927         assign
     1928           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1929         no-error .
     1930         if error-status :error
     1931         or error-status :get-message(1) <> ""
     1932         then do:
     1933           undo move_block, retry move_block.
     1934         end.
     1935         for each buf_temp-browse-handle
     1936           where buf_temp-browse-handle.browse-type = 'width':u
     1937         on error undo move_block, retry move_block
     1938         :
     1939           assign
     1940             buf_temp-browse-handle.browse-handle :width
     1941               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1942             no-error .
     1943           if error-status :error
     1944           or error-status :get-message(1) <> ""
     1945           then do:
     1946             undo move_block, retry move_block .
     1947           end.
     1948         end.
     1949         for each buf_temp-diasize-handle
     1950         on error undo move_block, retry move_block
     1951         :
     1952           assign
     1953             v-object-handle = buf_temp-diasize-handle.handle-value
     1954           .
     1955           if v-object-handle <> v-diasize-resize-button
     1956           then do:
     1957             assign
     1958               v-object-handle :col = v-object-handle :col + p-change-value
     1959               no-error .
     1960             if error-status :error
     1961             or error-status :get-message(1) <> ""
     1962             then do:
     1963               undo move_block, retry move_block .
     1964             end.
     1965           end.
     1966         end.
     1967       end.
     1968       else do:
     1969         for each buf_temp-diasize-handle
     1970         on error undo move_block, retry move_block
     1971         :
     1972           assign
     1973             v-object-handle = buf_temp-diasize-handle.handle-value
     1974           .
     1975           if v-object-handle <> v-diasize-resize-button
     1976           then do:
     1977             assign
     1978               v-object-handle :col = v-object-handle :col + p-change-value
     1979               no-error .
     1980             if error-status :error
     1981             or error-status :get-message(1) <> ""
     1982             then do:
     1983               undo move_block, retry move_block .
     1984             end.
     1985           end.
     1986         end.
     1987         for each buf_temp-browse-handle
     1988           where buf_temp-browse-handle.browse-type = 'width':u
     1989         on error undo move_block, retry move_block
     1990         :
     1991           assign
     1992             buf_temp-browse-handle.browse-handle :width
     1993               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1994             no-error .
     1995           if error-status :error
     1996           or error-status :get-message(1) <> ""
     1997           then do:
     1998             undo move_block, retry move_block .
     1999           end.
     2000         end.
     2001         assign
     2002           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2003           no-error .
     2004         if error-status :error
     2005         or error-status :get-message(1) <> ""
     2006         then do:
     2007           undo move_block, retry move_block.
     2008         end.
     2009         assign
     2010           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2011         no-error .
     2012         if error-status :error
     2013         or error-status :get-message(1) <> ""
     2014         then do:
     2015           undo move_block, retry move_block.
     2016         end.
     2017         if frame Dialog-Frame :scrollable = true
     2018         then do:
     2019           assign
     2020             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2021           no-error .
     2022           if error-status :error
     2023           or error-status :get-message(1) <> ""
     2024           then do:
     2025             undo move_block, retry move_block.
     2026           end.
     2027         end.
     2028       end.
     2029       if p-move-resize
     2030       then do:
     2031         run diasize_position-resize-button in this-procedure .
     2032       end.
     2033       if v-diasize-wndstore = true
     2034       then do:
     2035         if connected("ub") = true
     2036         then do:
     2037           define variable v-cntxt-db-num        as integer   no-undo .
     2038           define variable v-cntxt-userid        as character no-undo .
     2039           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2040                                             , OUTPUT v-cntxt-userid
     2041                                             ) .
     2042           run gbl/wndsizew.p
     2043             (input  v-cntxt-db-num
     2044             ,input  v-cntxt-userid
     2045             ,input  v-diasize-proc-name
     2046             ,input  'width':u
     2047             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2048             ) .
     2049         end.
     2050       end.
     2051     end.
     2052     assign
     2053       v-diasize-change-size = false
     2054     .
     2055   end procedure.
     2056   procedure diasize_set-width :
     2057     define input  parameter p-new-width  as decimal   no-undo .
     2058     define input  parameter p-move-resize as logical   no-undo .
     2059     do
     2060     on error undo, return error return-value
     2061     :
     2062       run diasize_change-width in this-procedure
     2063         (input  (p-new-width - frame Dialog-Frame :width)
     2064         ,input  p-move-resize
     2065         ) .
     2066     end.
     2067   end procedure.
     2068   procedure diasize_position-resize-button :
     2069     do with frame Dialog-Frame
     2070     :
     2071       hide v-diasize-resize-button .
     2072       assign
     2073         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2074                     - 1
     2075                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2076         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2077                     - 1
     2078                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2079       .
     2080       view v-diasize-resize-button .
     2081     end.
     2082   end procedure.
     2083   on alt-right anywhere
     2084   do:
     2085     run diasize_change-width in this-procedure
     2086       (input 1
     2087       ,input true
     2088       ) .
     2089     return no-apply .
     2090   end.
     2091   on alt-left anywhere
     2092   do:
     2093     run diasize_change-width in this-procedure
     2094       (input -1
     2095       ,input true
     2096       ) .
     2097     return no-apply .
     2098   end.
     2099   on alt-down anywhere
     2100   do:
     2101     run diasize_change-height in this-procedure
     2102       (input 1
     2103       ,input true
     2104       ) .
     2105     return no-apply .
     2106   end.
     2107   on alt-up anywhere
     2108   do:
     2109     run diasize_change-height in this-procedure
     2110       (input -1
     2111       ,input true
     2112       ) .
     2113     return no-apply .
     2114   end.
     2115   on alt-enter of frame Dialog-Frame
     2116   do:
     2117     run diasize_maximize in this-procedure
     2118       (input  ?
     2119       ).
     2120     return no-apply .
     2121   end.
     2122   procedure diasize_end-move :
     2123     do
     2124     on error undo, return error return-value
     2125     :
     2126       define variable v-row-delta as decimal   no-undo .
     2127       define variable v-col-delta as decimal   no-undo .
     2128       define variable v-new-row as decimal   no-undo .
     2129       define variable v-new-col as decimal   no-undo .
     2130       assign
     2131         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2132         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2133       .
     2134       assign
     2135         v-row-delta = v-new-row - frame Dialog-Frame :height
     2136         v-col-delta = v-new-col - frame Dialog-Frame :width
     2137       .
     2138       run diasize_change-height in this-procedure
     2139         (input v-row-delta
     2140         ,input true
     2141         ) .
     2142       run diasize_change-width in this-procedure
     2143         (input v-col-delta
     2144         ,input true
     2145         ) .
     2146     end.
     2147   end procedure.
     2148   procedure diasize_maximize :
     2149     define input  parameter p-action as logical   no-undo .
     2150     do
     2151     on error undo, return error return-value
     2152     :
     2153       if p-action = ?
     2154       then do:
     2155         if v-diasize-need-maximize = true
     2156         then do:
     2157           assign
     2158             p-action = true
     2159           .
     2160         end.
     2161         else do:
     2162           assign
     2163             p-action = false
     2164           .
     2165         end.
     2166       end.
     2167       if p-action = true
     2168       then do:
     2169         run diasize_change-height in this-procedure
     2170           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2171               - frame Dialog-Frame :height-chars
     2172           ,input true
     2173           ) .
     2174         run diasize_change-width in this-procedure
     2175           (input session :width-chars
     2176               - frame Dialog-Frame :width-chars
     2177           ,input true
     2178           ) .
     2179         assign
     2180           v-diasize-need-maximize = false
     2181         .
     2182       end.
     2183       else do:
     2184         run diasize_change-width in this-procedure
     2185           (input v-diasize-orig-frame-width
     2186               - frame Dialog-Frame :width-chars
     2187           ,input true
     2188           ) .
     2189         run diasize_change-height in this-procedure
     2190           (input v-diasize-orig-frame-height
     2191               - frame Dialog-Frame :height-chars
     2192           ,input true
     2193           ) .
     2194         assign
     2195           v-diasize-need-maximize = true
     2196         .
     2197       end.
     2198     end.
     2199   end procedure.
     2200   procedure diasize_restore-orig-size :
     2201     do
     2202     on error undo, return error return-value
     2203     :
     2204       assign
     2205         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2206         v-diasize-current-frame-height = frame Dialog-Frame :height
     2207       .
     2208       run diasize_set-height in this-procedure
     2209         (input  v-diasize-orig-frame-height
     2210         ,input  true
     2211         ) .
     2212       run diasize_set-width in this-procedure
     2213         (input  v-diasize-orig-frame-width
     2214         ,input  true
     2215         ) .
     2216     end.
     2217   end procedure.
     2218   procedure diasize_restore-current-size :
     2219     do
     2220     on error undo, return error return-value
     2221     :
     2222       run diasize_set-height in this-procedure
     2223         (input  v-diasize-current-frame-height
     2224         ,input  true
     2225         ) .
     2226       run diasize_set-width in this-procedure
     2227         (input  v-diasize-current-frame-width
     2228         ,input  true
     2229         ) .
     2230     end.
     2231   end procedure.
     2232   procedure diasize_set-browse-handle :
     2233     define input  parameter p-browse-handle as handle   no-undo .
     2234     define buffer buf_temp-browse-handle for temp-browse-handle .
     2235     do
     2236     on error undo, return error return-value
     2237     :
     2238       assign
     2239         v-diasize-browse-handle = p-browse-handle
     2240       .
     2241       for each buf_temp-browse-handle
     2242       on error undo, return error return-value
     2243       :
     2244         delete buf_temp-browse-handle .
     2245       end.
     2246     end.
     2247   end procedure.
     2248   procedure diasize_add_browse :
     2249     define input  parameter p-browse-type   as character no-undo .
     2250     define input  parameter p-browse-handle as handle    no-undo .
     2251     define buffer buf_temp-browse-handle for temp-browse-handle .
     2252     do
     2253     on error undo, return error return-value
     2254     :
     2255       assign
     2256         v-diasize-browse-number = v-diasize-browse-number + 1
     2257       .
     2258       create buf_temp-browse-handle .
     2259       assign
     2260         buf_temp-browse-handle.browse-type   = p-browse-type
     2261         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2262         buf_temp-browse-handle.browse-handle = p-browse-handle
     2263       .
     2264     end.
     2265   end procedure.
     2266   procedure diasize_init :
     2267     define variable v-default-value    as logical   no-undo .
     2268     define variable v-restore-saved    as logical   no-undo .
     2269     define variable v-resize-value-str as character no-undo .
     2270     do
     2271     on error undo, return error return-value
     2272     :
     2273       do with frame Dialog-Frame
     2274       :
     2275         assign
     2276           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2277           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2278           v-diasize-browse-handle     = browse BR-wthpobj :handle
     2279         .
     2280         create button v-diasize-resize-button
     2281         assign
     2282           parent        = frame Dialog-Frame :first-child
     2283           label         = "s"
     2284           height-pixels = 16
     2285           width-pixels  = 16
     2286           visible       = true
     2287           sensitive     = true
     2288           movable       = true
     2289           triggers:
     2290             on end-move persistent run diasize_end-move in this-procedure .
     2291           end triggers.
     2292         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2293         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2294         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2295         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2296         assign
     2297           v-diasize-wndmax = false
     2298         .
     2299         if connected("ub") = true
     2300         then do:
     2301           define variable v-cntxt-db-num        as integer   no-undo .
     2302           define variable v-cntxt-userid        as character no-undo .
     2303           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2304                                             , OUTPUT v-cntxt-userid
     2305                                             ) .
     2306           run gbl/wndpar_r.p
     2307             (input  v-cntxt-db-num
     2308             ,input  v-cntxt-userid
     2309             ,input  'wndmax':U
     2310             ,output v-diasize-wndmax
     2311             ,output v-default-value
     2312             ) .
     2313         end.
     2314         assign
     2315           v-diasize-wndstore = false
     2316         .
     2317         if connected("ub") = true
     2318         then do:
     2319           run gbl/wndpar_r.p
     2320             (input  v-cntxt-db-num
     2321             ,input  v-cntxt-userid
     2322             ,input  'wndstore':U
     2323             ,output v-diasize-wndstore
     2324             ,output v-default-value
     2325             ) .
     2326         end.
     2327         assign
     2328           v-diasize-proc-name = entry(1, program-name(2), '.')
     2329         .
     2330         if v-diasize-wndstore = true
     2331         then do:
     2332           assign
     2333             v-restore-saved = false
     2334           .
     2335           if connected("ub") = true
     2336           then do:
     2337             run gbl/wndsizer.p
     2338               (input  v-cntxt-db-num
     2339               ,input  v-cntxt-userid
     2340               ,input  v-diasize-proc-name
     2341               ,input  'height':u
     2342               ,output v-resize-value-str
     2343               ) .
     2344             if v-resize-value-str <> '':U
     2345             then do:
     2346               run diasize_change-height in this-procedure
     2347                 (input  integer(v-resize-value-str)
     2348                 ,input  true
     2349                 ) .
     2350               assign
     2351                 v-restore-saved = true
     2352               .
     2353             end.
     2354           end.
     2355           if connected("ub") = true
     2356           then do:
     2357             run gbl/wndsizer.p
     2358               (input  v-cntxt-db-num
     2359               ,input  v-cntxt-userid
     2360               ,input  v-diasize-proc-name
     2361               ,input  'width':u
     2362               ,output v-resize-value-str
     2363               ) .
     2364             if v-resize-value-str <> '':U
     2365             then do:
     2366               run diasize_change-width in this-procedure
     2367                 (input  integer(v-resize-value-str)
     2368                 ,input  true
     2369                 ) .
     2370               assign
     2371                 v-restore-saved = true
     2372               .
     2373             end.
     2374           end.
     2375           if v-restore-saved <> true
     2376           then do:
     2377             if v-diasize-wndmax = true
     2378             then do:
     2379               run diasize_maximize in this-procedure
     2380                 (input  true
     2381                 ) .
     2382             end.
     2383           end.
     2384         end.
     2385         else do:
     2386           if v-diasize-wndmax = true
     2387           then do:
     2388             run diasize_maximize in this-procedure
     2389               (input  true
     2390               ) .
     2391           end.
     2392         end.
     2393       end.
     2394     end.
     2395   end procedure.
     2396   procedure diasize_need-full-display :
     2397     define output parameter p-need-full-display as logical   no-undo .
     2398     do
     2399     on error undo, return error return-value
     2400     :
     2401       assign
     2402         p-need-full-display = v-diasize-need-full-display
     2403       .
     2404       assign
     2405         v-diasize-need-full-display = false
     2406       .
     2407     end.
     2408   end procedure.
     2409   procedure get-context :
     2410      define output parameter p-db-num as integer          no-undo.
     2411      define output parameter p-user-id as character        no-undo.
     2412      define variable v-login               as character    no-undo.
     2413      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2414      define buffer buf_user-login  for ub.user-login .
     2415      do
     2416      on error undo, return error
     2417      :
     2418            FIND FIRST buf_sys-ctrl no-lock.
     2419            ASSIGN
     2420               v-login = USERID("ub")
     2421               p-db-num = buf_sys-ctrl.db-num
     2422            .
     2423            FIND FIRST buf_user-login
     2424                 WHERE buf_user-login.db-num = p-db-num
     2425                   AND buf_user-login.user-login = v-login
     2426                 no-lock
     2427                 no-error
     2428                 .
     2429            IF AVAILABLE buf_user-login
     2430            THEN DO:
     2431               assign
     2432                  p-user-id = buf_user-login.user-id
     2433               .
     2434            END.
     2435      end.
     2436   end procedure.
     2437       run diasize_init in this-procedure .
     2438   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2439   procedure set-filter-name :
