     2932           .
     2933       end.
     2934     end.
     2935     if l-filter-open-24 = false then do:
     2936       OPEN QUERY br-wthpobj FOR EACH X_wth-pobj
     2937         where  X_wth-pobj.wth-code = pwth-code
     2938       , FIRST X_wealth No-LOCK WHERE X_wealth.wth-code = X_wth-pobj.wth-code ,first X_wth-place WHERE X_wth-place.w-p-code = X_wth-pobj.w-p-code and X_wth-place.obj-code = X_wth-pobj.obj-code and X_wth-place.obj-type = X_wth-pobj.obj-type
     2939     .
     2940         assign
     2941           l-query-was-opened = true
     2942         .
     2943     end.
     2944     run waitfram-hide in this-procedure .
     2945       end.
     2946   END CASE.
     2947   if v-doc-rec <> ? then reposition br-wthpobj to recid v-doc-rec no-error.
     2948   if not p-open-query and v-fltopend-rowid[1] <> ? then
     2949   query br-wthpobj:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     2950   apply "entry" to br-wthpobj in frame Dialog-Frame.
     2951   run waitfram-hide in this-procedure .
     2952   if avail X_wth-pobj then
     2953   apply "value-changed" to br-wthpobj in frame Dialog-Frame.
     2954   END PROCEDURE.
     2955   PROCEDURE PrintProc :
     2956   define variable date_string     as      char    no-undo.
     2957   define variable Line                as      char    no-undo.
     2958   define variable for-time as char.
     2959   define variable var-on-obj as decimal no-undo.
     2960   DEFINE FRAME Wth-List
     2961   X_wth-pobj.w-p-code     column-label "Код места!хранения"
     2962   X_wth-pobj.obj-type     column-label "Объект"
     2963   X_wth-pobj.obj-code     column-label "Код!объекта"
     2964   X_wth-pobj.wth-code     column-label "Код МЦ"
     2965   X_wealth.wth-name     column-label "Название"
     2966   X_wealth.is-money     column-label "Денежн.!эквив." format "+/"
     2967   X_wealth.curr-code    column-label "Код!валюты"
     2968   X_wealth.unit-base    column-label "Валюта/!Ед.изм."
     2969   var-on-obj          column-label "Остаток на!месте хранения" format "->>>,>>>,>>9.99"
     2970   HEADER  date_string AT 5 format "X(35)"
     2971   string( "Страница " ) format "X(9)" AT 100 PAGE-NUMBER(PrnLibStream) AT 110 FORMAT ">>9" SKIP
     2972   Line format "X(138)" AT 1
     2973   with width 160 down stream-io use-text    .
     2974   Line = fill("-", 116).
     2975   date_string = cur-time-print() .
     2976   run prn-lib-open-stream  in this-procedure (
     2977                                                input parParentProc
     2978                                               ,input 62
     2979                                               ,input yes
     2980                                               ,input no
     2981                                               ).
     2982       PUT  STREAM PrnLibStream
     2983       SPACE(25) ( frame Dialog-Frame:title )
     2984       format "x(90)" SKIP(1) .
     2985       FORM HEADER
     2986       Line AT 1 SKIP
     2987       "Продолжение - на следующей странице" AT 30 SKIP
     2988       with FRAME BottomFrame width 160 PAGE-BOTTOM NO-LABELS NO-BOX .
     2989       VIEW  STREAM PrnLibStream FRAME BottomFrame .
     2990       FORM with FRAME Wth-List  .
     2991       run waitfram-show in this-procedure ("Ждите...").
     2992       GET next br-wthpobj.
     2993        DO WHILE available X_wth-pobj :
     2994           var-on-obj = get-one-on-place(buffer X_wth-pobj).
     2995           Display STREAM PrnLibStream
     2996           X_wth-pobj.w-p-code
     2997           X_wth-pobj.obj-type
     2998           X_wth-pobj.obj-code
     2999           X_wth-pobj.wth-code
     3000           X_wealth.wth-name
     3001           X_wealth.is-money
     3002           X_wealth.curr-code
     3003           X_wealth.unit-base
     3004           var-on-obj
     3005           with FRAME Wth-List .
     3006           DOWN STREAM PrnLibStream 1 with FRAME Wth-List  .
     3007           GET next br-wthpobj.
     3008         END.
     3009         PUT STREAM PrnLibStream line format "X(138)" at 1.
     3010        HIDE  STREAM PrnLibStream FRAME BottomFrame .
     3011       HIDE  STREAM PrnLibStream FRAME CheckList.
     3012       output  STREAM PrnLibStream CLOSE.
     3013       run waitfram-hide in this-procedure .
     3014   run prn-lib-prn-file in this-procedure (
     3015                                             input parParentProc
     3016                                             ,input 0
     3017                                             ).
     3018   END PROCEDURE.
     3019   PROCEDURE proc-b-sch :
     3020   assign
     3021   tbl = 'wth-pobj'
     3022   join-tbl = 'X_wth-pobj'
     3023   fld = ""
     3024   lab = ""
     3025   spr = ""
     3026   dim = '0'
     3027   .
     3028   run fltfield-add in this-procedure('wth-code', 'Код МЦ', '',
     3029   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3030   run fltfield-add in this-procedure('w-p-code', 'Код места хранения', '',
     3031   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3032   run fltfield-add in this-procedure('obj-type', '', '',
     3033   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3034   run fltfield-add in this-procedure('obj-code', '', '',
     3035   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3036   run fltfield-add in this-procedure('income-pl', '', '',
     3037   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3038   run fltfield-add in this-procedure('income-cassa-pl', '', '',
     3039   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3040   run fltfield-add in this-procedure('income-other-pl', '', '',
     3041   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3042   run fltfield-add in this-procedure('incass-pl', '', '',
     3043   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3044   run fltfield-add in this-procedure('incass-bank-pl', '', '',
     3045   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3046   run fltfield-add in this-procedure('incass-cassa-pl', '', '',
     3047   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3048   run fltfield-add in this-procedure('incass-other-pl', '', '',
     3049   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3050   DO on stop undo, leave:
     3051       run gbl/filter.w ( input parparentproc
     3052                        , input (filter-point + chr(4) + filter-label)
     3053                        , input tbl
     3054                        , input join-tbl
     3055                        , input fld
     3056                        , input lab
     3057                        , input spr
     3058                        , input dim).
     3059       RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     3060   END .
     3061   END PROCEDURE.
     3062   FUNCTION get-cli-name RETURNS CHARACTER
     3063     ( f-cli-type AS CHAR, f-cli-code as int  ) :
     3064   For FIRST b-clients WHERE b-clients.obj-type = f-cli-type AND
     3065                          b-clients.obj-code = f-cli-code NO-LOCK:
     3066     return   b-clients.obj-name.
     3067   end.
     3068   RETURN "".
     3069   END FUNCTION.
     3070   FUNCTION get-one-on-place RETURNS DECIMAL
     3071     ( buffer loc-wth-pobj for Ub.wth-pobj) :
     3072   define variable parstock as decimal no-undo.
     3073   RUN wth-lib_cur-stock-place(
     3074                               input  loc-wth-pobj.obj-type,
     3075                               input loc-wth-pobj.obj-code,
     3076                               input loc-wth-pobj.w-p-code,
     3077                               input loc-wth-pobj.wth-code,
     3078                               output parstock) no-error.
     3079   if error-status:error then parstock = ?.
     3080   RETURN parstock.
     3081   END FUNCTION.
