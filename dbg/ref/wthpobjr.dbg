      611   FUNCTION get-curr RETURNS CHARACTER
      612     (buffer loc-wealth for ub.wealth ) :
      613   define buffer buf_currency for ub.currency.
      614   if loc-wealth.curr-code = ? or loc-wealth.is-money = no then
      615   return loc-wealth.unit-base.
      616   FIND FIRST buf_currency no-lock where
      617             buf_currency.curr-code = loc-wealth.curr-code No-ERROR.
      618   if avail buf_currency then
      619     RETURN buf_currency.curr-abbr.
      620   else return "".
      621   END FUNCTION.
      622   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      623   procedure fltfield-clear :
      624     define output parameter loc-fld as character no-undo.
      625     define output parameter loc-lab as character no-undo .
      626     define output parameter loc-spr as character no-undo .
      627     define output parameter loc-dim as character no-undo .
      628     assign
      629       loc-fld = ""
      630       loc-lab = ""
      631       loc-spr = ""
      632       loc-dim = "0"
      633     .
      634   end procedure .
      635   procedure fltfield-add :
      636     define input        parameter par-fld as character no-undo.
      637     define input        parameter par-lab as character no-undo .
      638     define input        parameter par-spr as character no-undo .
      639     define input-output parameter loc-fld as character no-undo.
      640     define input-output parameter loc-lab as character no-undo .
      641     define input-output parameter loc-spr as character no-undo .
      642     define input-output parameter loc-dim as character no-undo .
      643     do
      644     on error undo, return error
      645     :
      646       assign
      647       loc-fld = if loc-dim = '0'
      648                 then par-fld
      649                 else (loc-fld + chr(44) + par-fld)
      650       loc-lab = if loc-dim = '0'
      651                 then par-lab
      652                 else (loc-lab + chr(44) + par-lab)
      653       loc-spr = if loc-dim = '0'
      654                 then par-spr
      655                 else (loc-spr + chr(44) + par-spr)
      656       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      657                 string(integer(if num-entries(loc-dim) > 1
      658                               then entry(2, loc-dim)
      659                               else entry(1, loc-dim)
      660                               ) + 1)
      661       no-error
      662       .
      663     end.
      664   end procedure.
      665   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      666   define variable v-waitfram-action01         as character   no-undo .
      667   define variable v-waitfram-action02         as character   no-undo .
      668   define variable v-waitfram-action03         as character   no-undo .
      669   define variable mWaitFramTextBeg            as character   no-undo.
      670   define variable mWaitFramTextEnd            as character   no-undo.
      671   define variable mWaitFramView               as logical     no-undo.
      672   define variable mWaitProcEvent              as logical     no-undo init yes.
      673   define variable mWaitFramInterval           as integer     no-undo init 1 .
      674   define variable mWaitFramStop               as logical     no-undo.
      675   define variable mWaitFramStopUser           as logical     no-undo.
      676   define variable mWaitFramStopTimeOut        as logical     no-undo.
      677   define variable mWaitFramStartProc          as datetime-tz no-undo.
      678   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      679   define button B-WaitFramStop auto-end-key
      680        label "Стоп"
      681        size 10 by 1 tooltip "Остоновить процесс".
      682   define button B-viewProcInfo
      683        label "Информация"
      684        size 15 by 1 tooltip "Информация о процесс".
      685   define frame waitfram
      686     v-waitfram-action01 format "x(72)" no-label skip
      687     v-waitfram-action02 format "x(72)" no-label skip
      688     v-waitfram-action03 format "x(72)" no-label skip
      689     B-viewProcInfo
      690     B-WaitFramStop at row 4 col 30
      691     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      692     .
      693   define new global shared variable mBatchMode as logical no-undo init ?.
      694   define variable mFramBachModHandle as handle no-undo.
      695   mFramBachModHandle = frame waitfram:handle.
      696   define variable mFameOldVis as logical no-undo.
      697   define variable mVisCUrentVin as logical no-undo.
      698   if session:batch-mode
      699   then
      700      mBatchMode = yes.
      701   if mBatchMode = ? then do:
      702     mVisCUrentVin = current-window:visible.
      703     mFameOldVis = mFramBachModHandle:visible.
      704     mFramBachModHandle:visible  = yes.
      705     mBatchMode = mFramBachModHandle:visible ne yes.
      706     mFramBachModHandle:visible = mFameOldVis.
      707     current-window:visible = mVisCUrentVin.
      708   end.
      709    if  log-manager:logfile-name ne ?
      710     then DO:
      711         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      712         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      713         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      714     end.
      715   on choose of B-WaitFramStop in frame waitfram
      716   do:
      717     mWaitFramStop = yes.
      718     mWaitFramStopUser = yes.
      719   end.
      720   function waitfram-check-timeout returns logical():
      721      define variable vtime as int64 no-undo.
      722      if mWaitFramStopTimeOut
      723      then
      724         return yes.
      725      vtime = ( now - mWaitFramStartProc ) / 1000 .
      726      if     mWaitFramTimeOut ne ?
      727         and mWaitFramTimeOut ne 0
      728         and mWaitFramTimeOut lt vtime
      729      then do:
      730         mWaitFramStopTimeOut = yes.
      731      end.
      732      return mWaitFramStopTimeOut.
      733   end.
      734   procedure waitfram-hide :
      735     if not session:batch-mode
      736     then do
      737     on error undo, return error return-value
      738     :
      739       pause 0 before-hide .
      740       if not mBatchMode then
      741         hide frame waitfram .
      742     if     not mWaitFramView
      743        and mWaitProcEvent
      744     then
      745       process events .
      746     end.
      747   end procedure.
      748   procedure waitfram-show :
      749     define input  parameter p-message as character no-undo .
      750     define variable v-left-margin as integer   no-undo .
      751     if not session:batch-mode
      752     then do
      753     on error undo, return error return-value
      754     :
      755       if length(p-message) <= 70 then do:
      756         assign
      757           v-left-margin = integer((70 - length(p-message)) / 2)
      758         .
      759         assign
      760           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      761         .
      762         assign
      763           v-waitfram-action01 = " "
      764           v-waitfram-action02 = " "
      765                                    + fill(" ", v-left-margin)
      766                                    + p-message
      767           v-waitfram-action03 = " "
      768         .
      769       end.
      770       else do:
      771         define variable vRindex1 as integer no-undo.
      772         define variable vRindex2 as integer no-undo.
      773         vRindex1 = r-index(p-message," ",70).
      774         if vRindex1 = 0
      775         then
      776            vRindex1 = 70.
      777         if length(p-message)  <= vRindex1 + 70 then do:
      778           assign
      779             v-waitfram-action01 = " "
      780             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      781             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      782           .
      783         end.
      784         else do:
      785           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      786           if vRindex2 <= vRindex1
      787           then
      788              vRindex2 = vRindex1 + 70.
      789           assign
      790             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      791             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      792             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      793           .
      794         end.
      795       end.
      796       B-viewProcInfo:visible   in frame waitfram = no.
      797       B-viewProcInfo:sensitive in frame waitfram = no.
      798       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      799       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      800       if  (   mWaitFramView
      801          or  mWaitProcEvent)
      802          and not mBatchMode
      803       then
      804          display
      805             v-waitfram-action01 skip
      806             v-waitfram-action02 skip
      807             v-waitfram-action03 skip
      808          with frame waitfram .
      809       if     mWaitFramView
      810          then do:
      811             if     mWaitFramInterval ne ?
      812                and not mBatchMode
      813             then
      814                wait-for go of frame waitfram pause mWaitFramInterval.
      815          end.
      816          else
      817             if     mWaitProcEvent
      818                and not mBatchMode
      819             then
      820                process events .
      821     end.
      822   end procedure.
      823      procedure waitfram-show-this:
      824         define input  parameter iInterval as int64 no-undo.
      825         define variable vtime as int64 no-undo.
      826         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      827         mWaitFramInterval = iInterval.
      828         run waitfram-show (substitute("&1&2 &3&4" ,
      829                                       mWaitFramTextBeg ,
      830                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      831                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      832                                       mWaitFramTextEnd
      833                                      )
      834                           ).
      835      end.
      836      procedure WaitFramRunPause:
      837         define input  parameter iInterval as dec no-undo.
      838         define variable vStart  as datetime-tz no-undo.
      839         define variable vend    as datetime-tz no-undo.
      840         define variable vint as int64 no-undo.
      841         define variable vOk as logical no-undo.
      842         vStart = now.
      843         vend   = vStart.
      844         publish "WaitFramPause" (iInterval,output vOk).
      845         vend   =  now.
      846         vint = vend - vStart.
      847         vint = iInterval - vint / 1000.
      848         if     not mWaitFramStop
      849            and (   vint > 0
      850                 or (    not vOk
      851                     and iInterval eq ?
      852                     )
      853                 )
      854         then
      855            run waitfram-show-this (iInterval).
      856         vend   =  now.
      857         vint = vend - vStart.
      858         vint = iInterval - vint / 1000.
      859         if     not mWaitFramStop
      860            and vint > 0
      861         then do:
      862            run gbl/pause.p (vint * 1000).
      863         end.
      864         if iInterval ne ?
      865         then
      866            publish "WaitFramStop".
      867         waitfram-check-timeout().
      868      end.
      869      procedure WaitFramWaitFor:
      870         define input  parameter iInterval as dec no-undo.
      871         assign
      872            mWaitFramStartProc   = now
      873            mWaitFramStopUser    = no
      874            mWaitFramStopTimeOut = no
      875         .
      876         block-wait:
      877         do while not mWaitFramStop:
      878            run WaitFramRunPause (iInterval).
      879            if  waitfram-check-timeout()
      880            then do:
      881               leave block-wait.
      882            end.
      883         end.
      884         run waitfram-hide.
      885      end.
      886   procedure waitfram-join :
      887     define input  parameter p-line-1  as character no-undo .
      888     define input  parameter p-line-2  as character no-undo .
      889     define input  parameter p-line-3  as character no-undo .
      890     define output parameter p-message as character no-undo .
      891     do
      892     on error undo, return error return-value
      893     :
      894       assign
      895         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      896                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      897                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      898       .
      899     end.
      900   end procedure.
      901   function waitfram-join-function returns character
      902     (input p-line-1 as character
      903     ,input p-line-2 as character
      904     ,input p-line-3 as character
      905     ).
      906     define variable v-message as character no-undo .
      907     run waitfram-join in this-procedure
      908       (input  p-line-1
      909       ,input  p-line-2
      910       ,input  p-line-3
      911       ,output v-message
      912       ) .
      913     return v-message .
      914   end function .
      915   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      916   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      917   procedure fltopend_fltopend :
      918   define input parameter p-parent-handle as handle no-undo .
      919   define input parameter p-qh as handle no-undo .
      920   define input parameter p-flt-open-open-query  as character no-undo .
      921   define input parameter p-where-cond as character no-undo .
      922   define input parameter p-use-indFIRST-query-tail as character no-undo .
      923   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      924   define input parameter p-indexed-reposition as character no-undo .
      925     do
      926     on error undo, return error
      927     :
      928   define variable v-prepare-string as character no-undo .
      929   define variable glog as logical no-undo .
      930   assign
      931   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      932                      p-where-cond + chr(32)  +
      933                      p-use-indFIRST-query-tail + chr(32) +
      934                      p-use-ind-sort-clmn-by + chr(32) +
      935                      p-indexed-reposition
      936   .
      937   assign
      938   glog = p-qh:query-prepare(v-prepare-string) no-error .
      939   if not glog
      940   or error-status:error then do:
      941     message error-status:get-message(1) view-as alert-box .
      942     undo, return error .
      943   end.
      944   assign
      945   glog = p-qh:query-open no-error .
      946   if not glog
      947   or error-status:error then do:
      948     message error-status:get-message(1) view-as alert-box .
      949     undo, return error .
      950   end.
      951     end.
      952   end procedure.
      953   procedure fltopend_fltfindd :
      954   define input parameter p-parent-handle as handle no-undo .
      955   define input parameter p-qh as handle no-undo .
      956   define input parameter p-rowid as rowid no-undo .
      957   define input parameter p-next as logical no-undo .
      958   define input parameter p-lock as integer no-undo .
      959   define input parameter p-bh as handle no-undo .
      960   define input parameter p-where-cond as character no-undo .
      961   define input parameter p-use-index-phrase as character no-undo .
      962   define variable glog as logical no-undo .
      963   define variable v-qh as handle no-undo .
      964   define variable v-bh as handle no-undo .
      965   define variable v-recid as recid no-undo .
      966   define variable v-prepare-string as character no-undo .
      967   do
      968   on error undo, return error
      969   on stop undo, return error
      970   :
      971     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      972     create buffer v-bh for table p-bh buffer-name p-bh:name.
      973     create query v-qh.
      974     v-qh:set-buffers(v-bh).
      975     v-prepare-string = substitute("for each &1 &2 &3"
      976                                     ,v-bh:name
      977                                     ,p-where-cond
      978                                     ,p-use-index-phrase).
      979     glog = v-qh:query-prepare(v-prepare-string) no-error.
      980     if not glog then do:
      981       delete object v-qh.
      982       delete object v-bh.
      983       undo, return error .
      984     end.
      985     glog = v-qh:query-open no-error .
      986     if not glog then do:
      987       delete object v-qh.
      988       delete object v-bh.
      989       undo, return error .
      990     end.
      991     if p-next then do:
      992       v-qh:reposition-to-rowid(p-rowid) no-error .
      993       glog = v-qh:get-next( p-lock) no-error .
      994       glog = v-qh:get-next( p-lock) no-error .
      995       if not glog or v-qh:query-off-end = yes then do:
      996         glog = v-qh:get-first( p-lock) no-error .
      997       end.
      998     end.
      999     else do:
     1000       glog = v-qh:get-first( p-lock) no-error .
     1001     end.
     1002     v-recid = v-bh:recid no-error .
     1003     delete object v-qh.
     1004     delete object v-bh.
     1005     return string(v-recid) .
     1006   end.
     1007   end procedure.
     1008   procedure fltopend_fltfindq :
     1009   define input parameter p-parent-handle as handle no-undo .
     1010   define input parameter p-qh as handle no-undo .
     1011   define input parameter p-next as logical no-undo .
     1012   define input parameter p-lock as integer no-undo .
     1013   define input parameter p-flt-open-open-query  as character no-undo .
     1014   define input parameter p-where-cond as character no-undo .
     1015   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1016   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1017   define input parameter p-indexed-reposition as character no-undo .
     1018   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1019   define variable glog as logical no-undo .
     1020   define variable v-qh as handle no-undo .
     1021   define variable v-bh as handle no-undo extent 18.
     1022   define variable v-rowid as rowid no-undo extent 18.
     1023   define variable v-ii as integer no-undo .
     1024   define variable v-prepare-string as character no-undo .
     1025   do
     1026   on error undo, return error
     1027   on stop undo, return error
     1028   :
     1029     create query v-qh.
     1030     do v-ii = 1 to p-qh:num-buffers:
     1031       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1032       assign
     1033       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1034       no-error.
     1035       v-qh:add-buffer(v-bh[v-ii]).
     1036     end.
     1037     assign
     1038     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1039                       p-where-cond + chr(32)  +
     1040                       p-use-indFIRST-query-tail + chr(32) +
     1041                       p-use-ind-sort-clmn-by + chr(32) +
     1042                       p-indexed-reposition
     1043     .
     1044     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1045     if not glog then do:
     1046       delete object v-qh.
     1047       do v-ii = 1 to p-qh:num-buffers:
     1048         delete object v-bh[v-ii].
     1049       end.
     1050       undo, return error .
     1051     end.
     1052     glog = v-qh:query-open no-error .
     1053     if not glog then do:
     1054       delete object v-qh.
     1055       do v-ii = 1 to p-qh:num-buffers:
     1056         delete object v-bh[v-ii].
     1057       end.
     1058       undo, return error .
     1059     end.
     1060     if p-next then do:
     1061       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1062       glog = v-qh:get-next( p-lock) no-error .
     1063       glog = v-qh:get-next( p-lock) no-error .
     1064       if not glog or v-qh:query-off-end = yes then do:
     1065         glog = v-qh:get-first( p-lock) no-error .
     1066       end.
     1067     end.
     1068     else do:
     1069       glog = v-qh:get-first( p-lock) no-error .
     1070     end.
     1071     do v-ii = 1 to p-qh:num-buffers:
     1072       assign
     1073       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1074       no-error.
     1075     end.
     1076     delete object v-qh.
     1077     do v-ii = 1 to p-qh:num-buffers:
     1078       delete object v-bh[v-ii].
     1079     end.
     1080   end.
     1081   end procedure.
     1082   define variable filter-point as character no-undo init "wthpobjr" .
     1083   define variable filter-point0 as character no-undo init "wthpobjr" .
     1084   define variable filter-label as character no-undo init "МЦ_на_месте_хранения" .
     1085   define variable filter-label0 as character no-undo init "МЦ_на_месте_хранения" .
     1086   define variable sort-column-name as character no-undo .
     1087   define variable ri          as      recid   no-undo     init ? .
     1088   define variable v-doc-rec as recid no-undo .
     1089   DEFINE BUFFER b-clients   FOR ub.clients.
     1090   FUNCTION get-cli-name RETURNS CHARACTER
     1091     ( f-cli-type AS CHAR, f-cli-code as int  )  FORWARD.
     1092   FUNCTION get-one-on-place RETURNS DECIMAL
     1093     ( buffer loc-wth-pobj for Ub.wth-pobj)  FORWARD.
     1094   DEFINE BUTTON B-Help
     1095        LABEL "Помо&щь"
     1096        SIZE 3 BY 1
     1097        BGCOLOR 8 .
     1098   DEFINE BUTTON B-print
     1099        LABEL "Пе&чать"
     1100        SIZE 3 BY 1.
     1101   DEFINE BUTTON b-quit AUTO-END-KEY
     1102        LABEL "&Выход"
     1103        SIZE 10 BY 1
     1104        BGCOLOR 8 .
     1105   DEFINE BUTTON b-sch
     1106        LABEL "&Фильтр"
     1107        SIZE 3 BY 1.
     1108   DEFINE QUERY BR-wthpobj FOR
     1109         X_wth-pobj,
     1110         X_wealth,
     1111         X_wth-place SCROLLING.
     1112   DEFINE BROWSE BR-wthpobj
     1113     QUERY BR-wthpobj NO-LOCK DISPLAY
     1114         X_wth-pobj.w-p-code FORMAT ">>>>>>9":U
     1115   X_wth-place.w-p-name format "x(18)":U
     1116   X_wth-pobj.obj-type + ' ' + string(X_wth-pobj.obj-code)  COLUMN-LABEL "Код!объекта" FORMAT "X(8)":U
     1117   get-cli-name(X_wth-pobj.obj-type,X_wth-pobj.obj-code)  COLUMN-LABEL "Объект" FORMAT "X(12)":U
     1118   X_wth-pobj.wth-code COLUMN-LABEL "Код МЦ" FORMAT " >>>>>>9":U
     1119   X_wealth.wth-name FORMAT "X(30)":U
     1120   X_wealth.is-money COLUMN-LABEL "Ден.!экв." FORMAT "+/":U
     1121   get-curr(buffer X_wealth) COLUMN-LABEL "Валюта/!Ед.изм."
     1122   get-one-on-place(buffer X_wth-pobj) COLUMN-LABEL "Остаток!на месте хран" FORMAT "->>>,>>>,>>9.99":U
     1123       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 20.96.
     1124   DEFINE FRAME Dialog-Frame
     1125        b-quit AT ROW 1 COL 1
     1126        B-print AT ROW 1 COL 89
     1127        b-sch AT ROW 1 COL 92
     1128        B-Help AT ROW 1 COL 95
     1129        BR-wthpobj AT ROW 2.79 COL 1
     1130        SPACE(0.24) SKIP(0.03)
     1131       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1132            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1133            TITLE "Остатки МЦ на месте хранения"
     1134            CANCEL-BUTTON b-quit.
     1135   ASSIGN
     1136          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1137          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1138   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1139   DO:
     1140     APPLY "END-ERROR":U TO SELF.
     1141   END.
     1142   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1143   DO:
     1144     define variable doc-rec as recid no-undo .
     1145       doc-rec = recid( X_wth-pobj ).
     1146       DO WHILE available X_wth-pobj :
     1147             GET prev br-wthpobj.
     1148       END.
     1149       run PrintProc.
     1150        reposition br-wthpobj to recid doc-rec no-error.
     1151       apply "entry" to br-wthpobj in frame Dialog-Frame.
     1152   END.
     1153   ON CHOOSE OF b-sch IN FRAME Dialog-Frame
     1154   DO:
     1155     run proc-b-sch in this-procedure no-error.
     1156      if error-status:error then return no-apply.
     1157   END.
     1158   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1159   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1160   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1161   on help of frame Dialog-Frame
     1162   do:
     1163     run gbl/app_help.p
     1164       (input this-procedure :file-name
     1165       ,input ''
     1166       ,input ?
     1167       ) no-error.
     1168     if error-status :error then do:
     1169       message
     1170         "Ошибка при вызове помощи"
     1171         error-status :get-message(1)
     1172         view-as alert-box .
     1173     end.
     1174   end.
     1175   run minbtn-set in this-procedure .
     1176   on choose of b-help in frame Dialog-Frame
     1177   do:
     1178     apply "help":u to frame Dialog-Frame .
     1179   end.
     1180   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1181   procedure minbtn-set :
     1182       do
     1183           on error undo, return error return-value
     1184           :
     1185           define variable ii              as integer       no-undo .
     1186           define variable fh              as widget-handle no-undo .
     1187           define variable hh              as widget-handle no-undo .
     1188           define variable v-h             as handle        extent 4 no-undo .
     1189           define variable v-name-button   as character     no-undo .
     1190           define variable v-help-old-x    as decimal       no-undo .
     1191           define variable v-help-old-y    as decimal       no-undo .
     1192           define variable v-help-old-size as decimal       no-undo .
     1193           define variable v-frame-width   as decimal       no-undo .
     1194           define variable jj              as integer       no-undo .
     1195           do
     1196               on error undo, return error
     1197               :
     1198               assign
     1199                   v-frame-width = frame Dialog-Frame:width - 0.3
     1200                   fh            = frame Dialog-Frame:first-child
     1201                   hh            = fh:first-child
     1202                   ii            = 1
     1203                   .
     1204               do while valid-handle(hh):
     1205                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1206                   do:
     1207                       case lc(hh:name) :
     1208                           when "b-help" then
     1209                               do:
     1210                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1211                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1212                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1213                                   hh:TOOLTIP = "Помощь" .
     1214                                   v-help-old-x = hh:column .
     1215                                   v-help-old-y = hh:row    .
     1216                                   v-help-old-size = hh:width .
     1217                                   hh:width-chars = 2.5 .
     1218                               end.
     1219                           when "b-print" then
     1220                               do:
     1221                                   hh:load-image("cmp/b-print.bmp":u) .
     1222                                   hh:TOOLTIP = "Печать" .
     1223                                   v-h[ii] = hh:handle .
     1224                                   ii = ii + 1 .
     1225                                   hh:width-chars = 3 .
     1226                               end.
     1227                           when "b-history" or
     1228                           when "b-hist" then
     1229                               do:
     1230                                   hh:load-image("cmp/b-hist.bmp":u) .
     1231                                   hh:TOOLTIP = "История" .
     1232                                   v-h[ii] = hh:handle .
     1233                                   ii = ii + 1 .
     1234                                   hh:width-chars = 3 .
     1235                               end.
     1236                           when "b-sch" then
     1237                               do:
     1238                                   hh:load-image("cmp/b-sch.bmp":u) .
     1239                                   hh:TOOLTIP = "Установка Фильтра" .
     1240                                   v-h[ii] = hh:handle .
     1241                                   ii = ii + 1 .
     1242                                   hh:width-chars = 3 .
     1243                               end.
     1244                           when "b-hist-user" then
     1245                               do:
     1246                                   hh:load-image("cmp/b-hist.bmp":u) .
     1247                                   hh:TOOLTIP = "История пользователя" .
     1248                                   ii = ii + 1 .
     1249                               end.
     1250                       end case.
     1251                   end.
     1252                   hh = hh:next-sibling.
     1253               end.
     1254               b-help:column = v-frame-width - b-help:width-chars.
     1255               jj = 0.
     1256               repeat ii = 4 to 1 by -1 :
     1257                   if valid-handle (v-h[ii] ) then
     1258                   do:
     1259                       jj  = jj + 1 .
     1260                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1261                       v-h[ii]:row    = v-help-old-y .
     1262                   end.
     1263               end.
     1264           end.
     1265       end.
     1266   end procedure.
     1267   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1268   define variable v-diasize-need-maximize        as logical   no-undo init true  .
