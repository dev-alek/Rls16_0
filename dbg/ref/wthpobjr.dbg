        1   DEFINE BUFFER X_wealth FOR ub.wealth.
        2   DEFINE BUFFER X_wth-place FOR ub.wth-place.
        3   DEFINE BUFFER X_wth-pobj FOR ub.wth-pobj.
        4   define input parameter parparentproc as widget-handle no-undo .
        5   define input parameter p-list-mode as character no-undo .
        6   define input parameter pwth-code like ub.wth-pobj.wth-code no-undo.
        7   define input parameter pw-p-code like ub.wth-pobj.w-p-code no-undo.
        8   define input parameter p-obj-type like ub.wth-pobj.obj-type no-undo.
        9   define input parameter p-obj-code like ub.wth-pobj.obj-code no-undo.
       10   define input-output parameter p-rid-list as character no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision$":U .
       12   define variable vss-author      as character no-undo init "$Author$":U .
       13   define variable vss-date        as character no-undo init "$Date$":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       15   define variable vss-archive     as character no-undo init "$Archive$":U .
       16   define variable vss-description as character no-undo init "Остатки МЦ на месте хранения".
       17   procedure vss-get-info :
