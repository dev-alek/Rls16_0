     2484       no-error .
     2485     end.
     2486     RUN Myenable in this-procedure .
     2487     RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     2488   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2489   DEF VAR cur-clmn-numbr-wthpobj as INT EXTENT 9 no-undo.
     2490   DEF VAR varmvibr-wthpobj       as INT no-undo.
     2491   DEF VAR varmvjbr-wthpobj       as INT no-undo.
     2492   DEF VAR varmvkbr-wthpobj       as INT no-undo.
     2493   DEF VAR varmvlbr-wthpobj       as INT no-undo.
     2494   DEF VAR move-elementbr-wthpobj as INT no-undo.
     2495   def var jjbr-wthpobj           as int no-undo.
     2496   do varmvibr-wthpobj = 1 to EXTENT(cur-clmn-numbr-wthpobj):
     2497     ASSIGN cur-clmn-numbr-wthpobj[varmvibr-wthpobj] = varmvibr-wthpobj.
     2498   END.
     2499   RUN start-mv-clmnbr-wthpobj.
     2500   PROCEDURE start-mv-clmnbr-wthpobj:
     2501   def var old-session as logical no-undo.
     2502      old-session = SESSION:IMMEDIATE-DISPLAY.
     2503      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2504          IF  p-list-mode = 'Место хранения МЦ':U  THEN DO:
     2505      DO jjbr-wthpobj = NUM-ENTRIES('1,2,5,6,7,9,8,3,4') TO 1 BY -1:
     2506        RUN re-move-clmnbr-wthpobj ( cur-clmn-numbr-wthpobj[INTEGER(ENTRY (jjbr-wthpobj, '1,2,5,6,7,9,8,3,4'))] ,  + 1).
     2507      END.
     2508          END.
     2509          IF  p-list-mode = 'МЦ':U  THEN DO:
     2510      DO jjbr-wthpobj = NUM-ENTRIES('1,2,3,4,9,5,6,7,8') TO 1 BY -1:
     2511        RUN re-move-clmnbr-wthpobj ( cur-clmn-numbr-wthpobj[INTEGER(ENTRY (jjbr-wthpobj, '1,2,3,4,9,5,6,7,8'))] ,  + 1).
     2512      END.
     2513          END.
     2514          IF  p-list-mode = 'МЦ':U + chr(47) + 'объект':U  THEN DO:
     2515      DO jjbr-wthpobj = NUM-ENTRIES('1,2,5,6,7,9,8,3,4') TO 1 BY -1:
     2516        RUN re-move-clmnbr-wthpobj ( cur-clmn-numbr-wthpobj[INTEGER(ENTRY (jjbr-wthpobj, '1,2,5,6,7,9,8,3,4'))] ,  + 1).
     2517      END.
     2518          END.
     2519      SESSION:IMMEDIATE-DISPLAY = old-session.
     2520   END.
     2521   ON ctrl-cursor-right OF BROWSE br-wthpobj do:
     2522     RUN re-move-clmnbr-wthpobj (  + 1, 9).
     2523   END.
     2524   ON ctrl-cursor-left OF BROWSE br-wthpobj do:
     2525     RUN re-move-clmnbr-wthpobj (9,  + 1).
     2526   END.
     2527   PROCEDURE re-move-clmnbr-wthpobj:
     2528     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2529     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2530     DO varmvibr-wthpobj = 1 TO EXTENT(cur-clmn-numbr-wthpobj):
     2531       if cur-clmn-numbr-wthpobj[varmvibr-wthpobj] = source-column THEN cur-clmn-numbr-wthpobj[varmvibr-wthpobj] = -1.
     2532     END.
     2533     if br-wthpobj:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     2534     if source-column > target-column THEN
     2535     DO varmvjbr-wthpobj = source-column - 1 to target-column BY -1:
     2536       DO varmvibr-wthpobj = 1 TO EXTENT(cur-clmn-numbr-wthpobj):
     2537           if cur-clmn-numbr-wthpobj[varmvibr-wthpobj] = varmvjbr-wthpobj THEN DO:
     2538             cur-clmn-numbr-wthpobj[varmvibr-wthpobj] = cur-clmn-numbr-wthpobj[varmvibr-wthpobj] + 1.
     2539           END.
     2540       END.
     2541     END.
     2542     ELSE
     2543     DO varmvjbr-wthpobj = source-column + 1 to target-column:
     2544       DO varmvibr-wthpobj = 1 TO EXTENT(cur-clmn-numbr-wthpobj):
     2545         if cur-clmn-numbr-wthpobj[varmvibr-wthpobj] = varmvjbr-wthpobj THEN DO:
     2546           cur-clmn-numbr-wthpobj[varmvibr-wthpobj] = cur-clmn-numbr-wthpobj[varmvibr-wthpobj] - 1.
     2547         END.
     2548       END.
     2549     END.
     2550     DO varmvibr-wthpobj = 1 TO EXTENT(cur-clmn-numbr-wthpobj):
     2551       if cur-clmn-numbr-wthpobj[varmvibr-wthpobj] = -1 THEN cur-clmn-numbr-wthpobj[varmvibr-wthpobj] = target-column.
     2552     END.
     2553   END PROCEDURE.
     2554   PROCEDURE ch-clmnbr-wthpobj:
     2555     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2556     if cur-clmn-loc <=  + 1 then do:
     2557       return .
     2558     end.
     2559     DO varmvibr-wthpobj = 1 TO EXTENT(cur-clmn-numbr-wthpobj):
     2560       if cur-clmn-numbr-wthpobj[varmvibr-wthpobj] = cur-clmn-loc THEN move-elementbr-wthpobj = varmvibr-wthpobj.
     2561     END.
     2562     RUN re-move-clmnbr-wthpobj (cur-clmn-loc,  + 1).
     2563   END PROCEDURE.
     2564   PROCEDURE mv-brw-defaultbr-wthpobj:
     2565   def var old-session as logical no-undo.
     2566     old-session = SESSION:IMMEDIATE-DISPLAY.
     2567     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2568     do varmvlbr-wthpobj =  + 1 to EXTENT(cur-clmn-numbr-wthpobj):
     2569       RUN re-move-clmnbr-wthpobj (cur-clmn-numbr-wthpobj[varmvlbr-wthpobj], varmvlbr-wthpobj).
     2570     END.
     2571     RUN start-mv-clmnbr-wthpobj.
     2572     SESSION:IMMEDIATE-DISPLAY = old-session.
     2573   END PROCEDURE.
     2574   .
     2575     WAIT-FOR GO OF FRAME Dialog-Frame.
     2576   END.
