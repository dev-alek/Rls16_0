      360   define  stream PrnLibStream.
      361   procedure prn-lib-prn-file :
      362     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      363     define input parameter p-DIsabledoptions as integer no-undo .
      364     define variable v-report-name as character no-undo .
      365     define variable v-user-action as character no-undo .
      366     define variable v-printed     as logical   no-undo .
      367     define variable v-exist       as logical   no-undo .
      368     do
      369       on error undo, return error
      370       :
      371       run prn-lib-get-report-name  in this-procedure (
      372         input parParentProc
      373         ,output v-report-name
      374         ).
      375   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      376   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      377     (input  v-report-name
      378     ,input  2
      379     ,output v-exist
      380     )  .
      381       if NOT v-exist then
      382       DO:
      383         Message
      384           "Нет заданий на печать ! "
      385           view-as alert-box .
      386         Return  .
      387       End.
      388       run gbl/prnfilen.w
      389         (input  ""
      390         ,input  p-DisabledOptions
      391         ,input  string(v-report-name )
      392         ,input  7
      393         ,output v-user-action
      394         ,output v-printed
      395         ) .
      396       if v-printed then
      397       do:
      398         return "YES" .
      399       end.
      400       else
      401       do:
      402         return "NO" .
      403       end.
      404     end.
      405   end procedure.
      406   procedure prn-lib-open-stream :
      407     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      408     define input parameter p-page-size    as integer no-undo .
      409     define input parameter p-is-stream    as logical no-undo .
      410     define input parameter p-append       as logical no-undo .
      411     define variable v-report-name as character no-undo .
      412     do
      413       on error undo, return error
      414       :
      415       run prn-lib-get-report-name  in this-procedure (
      416         input parParentProc
      417         ,output v-report-name
      418         ).
      419       if p-is-stream then
      420       do:
      421         if p-append then
      422         do:
      423           output stream PrnLibStream to value( v-report-name )
      424             page-size value(p-page-size) append .
      425         end.
      426         if not p-append then
      427         do:
      428           output stream PrnLibStream to value( v-report-name )
      429             page-size value(p-page-size) .
      430         end.
      431       end.
      432       if not p-is-stream then
      433       do:
      434         if p-append then
      435         do:
      436           output to value( v-report-name )
      437             page-size value(p-page-size) append .
      438         end.
      439         if not p-append then
      440         do:
      441           output to value( v-report-name )
      442             page-size value(p-page-size) .
      443         end.
      444       end.
      445     end.
      446   end procedure.
      447   procedure prn-lib-open-exp :
      448     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      449     define input parameter p-is-stream    as logical no-undo .
      450     define input parameter p-is-append    as logical no-undo .
      451     define output parameter p-ReportFileName as char init "report" no-undo.
      452     define output parameter p-process as logical no-undo .
      453     define variable glog as logical no-undo .
      454     do
      455       on error undo, return error
      456       :
      457       SYSTEM-DIALOG GET-FILE p-ReportFileName
      458         TITLE      "Укажите путь"
      459         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      460         ASK-OVERWRITE
      461         CREATE-TEST-FILE
      462         SAVE-AS
      463         USE-FILENAME
      464         DEFAULT-EXTENSION "txt"
      465         UPDATE glog
      466         .
      467       if not glog then  return.
      468       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      469       if p-is-stream then
      470       do:
      471         if p-is-append then
      472         do:
      473           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      474         end.
      475         else
      476         do:
      477           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      478         end.
      479       end.
      480       else
      481       do:
      482         if p-is-append then
      483         do:
      484           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      485         end.
      486         else
      487         do:
      488           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      489         end.
      490       end.
      491       p-process = yes.
      492     end.
      493   end procedure.
      494   procedure prn-lib-get-report-name :
      495     define input parameter parParentProc  as widget-handle no-undo.
      496     define output parameter p-report-name as character no-undo .
      497     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      498   end procedure.
      499   procedure prn-lib-reportviewer-report-name :
      500     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      501     define input parameter p-report-name-html as character no-undo .
      502     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      503   end procedure.
      504   procedure prn-lib-reportviewer :
      505     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      506     define input parameter p-report-name-html as character no-undo .
      507     define input parameter p-param        as character no-undo .
      508     define variable v-excel           as character no-undo init 'TRUE' .
      509     define variable v-value-character as character no-undo .
      510     define variable v-value-integer   as character no-undo .
      511     define variable v-value-date      as date      no-undo .
      512     define variable v-value-decimal   as decimal   no-undo .
      513     define variable rep-excel         as logical   no-undo .
      514     define variable excel-string      as character no-undo .
      515     define variable v-param-type      as character no-undo .
      516     define variable v-tth             as handle    no-undo .
      517     run adm/shattri.p (
      518       input "get":U
      519       ,input  ""
      520       ,input  0
      521       ,input  'report-glob':U
      522       ,input  'rep-excel':U
      523       ,output v-value-character
      524       ,output v-value-date
      525       ,output v-value-decimal
      526       ,output v-value-integer
      527       ,output rep-excel
      528       ,output v-param-type
      529       ,INPUT-OUTPUT table-handle v-tth
      530       )  .
      531     if rep-excel then v-excel = "TRUE" .
      532     else v-excel = "FALSE" .
      533     if p-param eq ""
      534     then
      535        p-param = "EXCEL:" + v-excel.
      536     else
      537        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      538     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      539   end procedure.
      540   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      541   procedure wth-lib_cur-stock-place:
      542   define input  parameter parobj-type like ub.clients.obj-type   no-undo.
      543   define input  parameter parobj-code like ub.clients.obj-code   no-undo.
      544   define input  parameter parw-p-code like ub.wth-pobj.w-p-code  no-undo.
      545   define input  parameter parwth-code like ub.wth-pobj.wth-code  no-undo.
      546   define output parameter parstock    like ub.wth-pobj.income-pl no-undo.
      547   define buffer bf_wth-pobj for ub.wth-pobj.
      548   find first bf_wth-pobj where bf_wth-pobj.obj-type = parobj-type and
      549                                bf_wth-pobj.obj-code = parobj-code and
      550                                bf_wth-pobj.w-p-code = parw-p-code and
      551                                bf_wth-pobj.wth-code = parwth-code no-lock no-error.
      552   if available bf_wth-pobj then assign parstock = bf_wth-pobj.income-pl - bf_wth-pobj.incass-pl.
      553                            else assign parstock = 0.
      554   end procedure.
      555   procedure wth-lib_cur-stock-obj:
      556   define input  parameter parobj-type like ub.clients.obj-type   no-undo.
      557   define input  parameter parobj-code like ub.clients.obj-code   no-undo.
      558   define input  parameter parwth-code like ub.wth-obj.wth-code   no-undo.
      559   define output parameter parstock    like ub.wth-obj.income     no-undo.
      560   define buffer bf_wth-obj for ub.wth-obj.
      561   find first bf_wth-obj where bf_wth-obj.obj-type = parobj-type and
      562                               bf_wth-obj.obj-code = parobj-code and
      563                               bf_wth-obj.wth-code = parwth-code no-lock no-error.
      564   if available bf_wth-obj then assign parstock = bf_wth-obj.income - bf_wth-obj.incass.
      565                           else assign parstock = 0.
      566   end.
      567   FUNCTION wth-lib_cur-stock-obj-func RETURNS DECIMAL (INPUT parobj-type AS CHARACTER,
      568                                                        INPUT parobj-code AS INTEGER,
      569                                                        INPUT parwth-code AS INTEGER):
      570   define buffer bf_wth-obj for ub.wth-obj.
      571   find first bf_wth-obj where bf_wth-obj.obj-type = parobj-type and
      572                               bf_wth-obj.obj-code = parobj-code and
      573                               bf_wth-obj.wth-code = parwth-code no-lock no-error.
      574   if available bf_wth-obj then return (bf_wth-obj.income - bf_wth-obj.incass).
      575                           else return 0.00.
      576   end function.
      577   FUNCTION wth-lib_cur-stock-host-func RETURNS DECIMAL (INPUT parhost-code AS INTEGER,
      578                                                         INPUT parwth-code  AS INTEGER):
      579   define buffer bf_wth-obj for ub.wth-obj.
      580   define variable v-stock like ub.wth-obj.income no-undo.
      581   for each bf_wth-obj no-lock where bf_wth-obj.host-code = parhost-code and
      582                                     bf_wth-obj.wth-code = parwth-code :
      583     v-stock = v-stock +  bf_wth-obj.income - bf_wth-obj.incass.
      584   end.
      585   return v-stock.
      586   end function.
      587   procedure wth-lib_full-inf-shift:
      588   define input  parameter parobj-type     like ub.clients.obj-type      no-undo.        define input  parameter parobj-code     like ub.clients.obj-code      no-undo.        define input  parameter parwth-code     like ub.wth-line.wth-code     no-undo.        define input  parameter parshift-date   like ub.shift-obj.shift-date  no-undo.                        define input  parameter parshift-num    like ub.shift-obj.shift-num   no-undo.                                                              define output parameter parstock-start  like ub.wth-line.income       no-undo.        define output parameter parstock-end    like ub.wth-line.income       no-undo.        define output parameter parincome       like ub.wth-line.income       no-undo.        define output parameter parincome-cassa like ub.wth-line.income-cassa no-undo.        define output parameter parincome-other like ub.wth-line.income-other no-undo.        define output parameter parincass       like ub.wth-line.incass       no-undo.        define output parameter parincass-bank  like ub.wth-line.incass-bank  no-undo.        define output parameter parincass-other like ub.wth-line.incass-other no-undo.        define output parameter parincass-cassa like ub.wth-line.incass-cassa no-undo.        define buffer cur_wth-line   for ub.wth-line.                                         define buffer start_wth-line for ub.wth-line.                                         find last cur_wth-line where cur_wth-line.obj-type   = parobj-type   and                                        cur_wth-line.obj-code   = parobj-code   and                                                                                                       cur_wth-line.wth-code   = parwth-code   and                                        cur_wth-line.shift-date = parshift-date and                        cur_wth-line.shift-num  = parshift-num  and                                                                     cur_wth-line.status_    = 'факт':U       use-index                                  stat-sdn no-lock no-error.                     find last start_wth-line where start_wth-line.obj-type   = parobj-type         and                                start_wth-line.obj-code   = parobj-code         and                                                                                             start_wth-line.wth-code   = parwth-code         and                                (start_wth-line.shift-date = parshift-date and                           start_wth-line.shift-num  < parshift-num  or                            start_wth-line.shift-date < parshift-date ) and                                                                   start_wth-line.status_ = 'факт':U                                                   use-index stat-sdn no-lock no-error.         if not available start_wth-line then do:                                              if not available cur_wth-line then do:                                                 assign                                                                                parstock-start   = 0                                                                  parstock-end     = 0                                                                  parincome        = 0                                                                  parincome-cassa  = 0                                                                  parincome-other  = 0                                                                  parincass        = 0                                                                  parincass-bank   = 0                                                                  parincass-other  = 0.                                                                 parincass-cassa  = 0.                                                              end.                                                                               else do:                                                                              assign parstock-start   = 0               parstock-end     = cur_wth-line.income - cur_wth-line.incass              parincome        = cur_wth-line.income                     parincome-cassa  = cur_wth-line.income-cassa               parincome-other  = cur_wth-line.income-other               parincass        = cur_wth-line.incass                     parincass-bank   = cur_wth-line.incass-bank                parincass-other  = cur_wth-line.incass-other.              parincass-cassa  = cur_wth-line.incass-cassa.                                                                                       end.                                                                            end.                                                                               else do:                                                                              if available cur_wth-line then do:                                                    assign                                                                             parstock-start   = start_wth-line.income     - start_wth-line.incass               parstock-end     = cur_wth-line.income       - cur_wth-line.incass                 parincome        = cur_wth-line.income       - start_wth-line.income               parincome-cassa  = cur_wth-line.income-cassa - start_wth-line.income-cassa         parincome-other  = cur_wth-line.income-other - start_wth-line.income-other         parincass        = cur_wth-line.incass       - start_wth-line.incass               parincass-bank   = cur_wth-line.incass-bank  - start_wth-line.incass-bank          parincass-other  = cur_wth-line.incass-other - start_wth-line.incass-other.        parincass-cassa  = cur_wth-line.incass-cassa - start_wth-line.incass-cassa.     end.                                                                               else do:                                                                              assign                                                                             parstock-start   = start_wth-line.income - start_wth-line.incass                   parstock-end     = parstock-start                                                  parincome        = 0                                                               parincome-cassa  = 0                                                               parincome-other  = 0                                                               parincass        = 0                                                               parincass-bank   = 0                                                               parincass-other  = 0.                                                              parincass-cassa  = 0.                                                           end.                                                                            end.
      589   end procedure.
