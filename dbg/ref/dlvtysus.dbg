     1900     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1901     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1902     if p-change-value > 0
     1903     then do:
     1904       if frame Dialog-Frame :width + p-change-value >
     1905           session :width-chars
     1906       then do:
     1907         assign
     1908           p-change-value = session :width-chars - frame Dialog-Frame :width
     1909         .
     1910         if p-change-value <= 0
     1911         then do:
     1912           run diasize_position-resize-button in this-procedure .
     1913           return .
     1914         end.
     1915       end.
     1916     end.
     1917     if p-change-value < 0
     1918     then do:
     1919       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1920       then do:
     1921         assign
     1922           p-change-value = v-diasize-orig-frame-width
     1923                          - frame Dialog-Frame :width
     1924         .
     1925         if p-change-value >= 0
     1926         then do:
     1927           run diasize_position-resize-button in this-procedure .
     1928           return .
     1929         end.
     1930       end.
     1931     end.
