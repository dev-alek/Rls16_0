      435   procedure prn-lib-open-stream :
      436     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      437     define input parameter p-page-size    as integer no-undo .
      438     define input parameter p-is-stream    as logical no-undo .
      439     define input parameter p-append       as logical no-undo .
      440     define variable v-report-name as character no-undo .
      441     do
      442       on error undo, return error
      443       :
      444       run prn-lib-get-report-name  in this-procedure (
      445         input parParentProc
      446         ,output v-report-name
      447         ).
      448       if p-is-stream then
      449       do:
      450         if p-append then
      451         do:
      452           output stream PrnLibStream to value( v-report-name )
      453             page-size value(p-page-size) append .
      454         end.
      455         if not p-append then
      456         do:
      457           output stream PrnLibStream to value( v-report-name )
      458             page-size value(p-page-size) .
      459         end.
      460       end.
      461       if not p-is-stream then
      462       do:
      463         if p-append then
      464         do:
      465           output to value( v-report-name )
      466             page-size value(p-page-size) append .
      467         end.
      468         if not p-append then
      469         do:
      470           output to value( v-report-name )
      471             page-size value(p-page-size) .
      472         end.
      473       end.
      474     end.
      475   end procedure.
      476   procedure prn-lib-open-exp :
      477     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      478     define input parameter p-is-stream    as logical no-undo .
      479     define input parameter p-is-append    as logical no-undo .
      480     define output parameter p-ReportFileName as char init "report" no-undo.
      481     define output parameter p-process as logical no-undo .
      482     define variable glog as logical no-undo .
      483     do
      484       on error undo, return error
      485       :
      486       SYSTEM-DIALOG GET-FILE p-ReportFileName
      487         TITLE      "Укажите путь"
      488         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      489         ASK-OVERWRITE
      490         CREATE-TEST-FILE
      491         SAVE-AS
      492         USE-FILENAME
      493         DEFAULT-EXTENSION "txt"
      494         UPDATE glog
      495         .
      496       if not glog then  return.
      497       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      498       if p-is-stream then
      499       do:
      500         if p-is-append then
      501         do:
      502           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      503         end.
      504         else
      505         do:
      506           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      507         end.
      508       end.
      509       else
      510       do:
      511         if p-is-append then
      512         do:
      513           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      514         end.
      515         else
      516         do:
      517           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      518         end.
      519       end.
      520       p-process = yes.
      521     end.
      522   end procedure.
      523   procedure prn-lib-get-report-name :
      524     define input parameter parParentProc  as widget-handle no-undo.
      525     define output parameter p-report-name as character no-undo .
      526     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      527   end procedure.
      528   procedure prn-lib-reportviewer-report-name :
