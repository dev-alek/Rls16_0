     1727       if p-change-value > 0
     1728       then do:
     1729         if frame Dialog-Frame :scrollable = true
     1730         then do:
     1731           assign
     1732             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1733             no-error .
