     4241   define variable v-deliv-subj-name like ub.delivery-subject.deliv-subj-name no-undo .
     4242   DEFINE FRAME delivery-type-subject-list
     4243   v-sts-chr FORMAT "X(8)" COLUMN-LABEL "Статус"
     4244   X_delivery-type-subject.des FORMAT "X(100)"
     4245   X_delivery-type-subject.deliv-type-code COLUMN-LABEL "Вн.код!типа!доставки"
     4246   v-deliv-type-name COLUmn-LABEL "Тип доставки" format "X(25)"
     4247   X_delivery-type-subject.deliv-subj-code COLUMN-LABEL "Вн.код!субъекта!доставки"
     4248   v-deliv-subj-name COLUmn-LABEL "Субъект доставки" format "X(25)"
     4249   HEADER  date_string AT 5 format "X(35)"
     4250    string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     4251   Line format "X(195)" AT 1
     4252   with width 232 down stream-io use-text    .
     4253   Line = fill("-", 195).
     4254   date_string = cur-time-print() .
     4255   run prn-lib-open-stream  in this-procedure (
     4256                                                input parParentProc
     4257                                               ,input 43
     4258                                               ,input yes
     4259                                               ,input no
     4260                                               ).
     4261   PUT  STREAM PrnLibStream
     4262   SPACE(25) ( frame Dialog-Frame:title )
     4263   format "x(90)" SKIP(1) .
     4264   FORM HEADER
     4265   Line format "X(195)" AT 1 SKIP
     4266   "Продолжение - на следующей странице" AT 30 SKIP
     4267   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     4268   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     4269   FORM with FRAME delivery-type-subject-list  .
     4270   run waitfram-show in this-procedure ("Ждите...").
     4271   v-doc-rec = recid(X_delivery-type-subject).
     4272   DO WHILE available X_delivery-type-subject :
     4273     GET prev br-delivtypesubj.
     4274   END.
     4275   GET next br-delivtypesubj.
     4276   DO WHILE available X_delivery-type-subject :
     4277     Display STREAM PrnLibStream
     4278     entry (lookup (STRING(p-sts), '0,1,50,99':U), 'тек,удал,блок,удаление':U) @ v-sts-chr
     4279     X_delivery-type-subject.deliv-type-code
     4280     get-type(X_delivery-type-subject.deliv-type-code) @ v-deliv-type-name
     4281     X_delivery-type-subject.deliv-subj-code
     4282     get-subject(X_delivery-type-subject.deliv-subj-code) @ v-deliv-subj-name
     4283     X_delivery-type-subject.des
     4284   with FRAME delivery-type-subject-list .
     4285     DOWN STREAM PrnLibStream 1
     4286     with FRAME delivery-type-subject-list  .
     4287     assign
     4288     accum-count = accum-count + 1
     4289     .
     4290     GET next br-delivtypesubj.
     4291   END.
     4292   UNDERLINE  STREAM PrnLibStream
     4293   v-sts-chr
     4294   X_delivery-type-subject.deliv-type-code
     4295   v-deliv-type-name
     4296   X_delivery-type-subject.deliv-subj-code
     4297   v-deliv-subj-name
     4298   X_delivery-type-subject.des
     4299   with FRAME delivery-type-subject-list .
     4300   DISPLAY STREAM PrnLibStream
     4301   accum-count @ v-sts-chr
     4302   with frame delivery-type-subject-list.
     4303   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     4304   HIDE  STREAM PrnLibStream FRAME delivery-type-subject-List.
     4305   output  STREAM PrnLibStream CLOSE.
     4306   REPOSITION br-delivtypesubj to recid v-doc-rec no-error.
     4307   APPLY "entry" to br-delivtypesubj.
     4308   run waitfram-hide in this-procedure .
     4309   run prn-lib-prn-file in this-procedure (
     4310                                             input parParentProc
     4311                                             ,input 8
     4312                                             ).
     4313   END PROCEDURE.
     4314   PROCEDURE proc-b-sch :
     4315   assign
     4316     tbl = 'delivery-type-subject'
     4317     join-tbl = 'X_delivery-type-subject'
     4318     fld = ""
     4319     lab = ""
     4320     spr = ""
     4321     dim = '0'
     4322     .
     4323   run fltfield-add in this-procedure('deliv-type-code', 'Код типа доставки', '',
     4324   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4325   run fltfield-add in this-procedure('deliv-subj-code', 'Код субъекта доставки', '',
     4326   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4327   run fltfield-add in this-procedure('des', 'Описание', '',
     4328   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4329   run fltfield-add in this-procedure('sts', 'Статус', '',
     4330   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4331   Filter-Block:
     4332   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4333       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4334       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4335     run gbl/filter.w ( INPUT parparentproc
     4336                      , INPUT (filter-point + chr(4) + filter-label0)
     4337                      , INPUT tbl
     4338                      , INPUT join-tbl
     4339                      , INPUT fld
     4340                      , INPUT lab
     4341                      , INPUT spr
     4342                      , INPUT dim ).
     4343     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     4344   END.
     4345   END PROCEDURE.
     4346   PROCEDURE proc-br-delivtypesubj :
     4347   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4348   if b-sel:sensitive in frame Dialog-Frame then dO:
     4349       if b-mark:sensitive then do:
     4350           apply "choose" to b-mark in frame Dialog-Frame.
     4351       end.
     4352       else do:
     4353           apply "choose" to b-sel in frame Dialog-Frame.
     4354       end.
     4355   end.
     4356   else do:
     4357       if b-lkp:sensitive then
     4358       apply "choose" to b-lkp in frame Dialog-Frame.
     4359   end.
     4360   END PROCEDURE.
     4361   FUNCTION get-subject RETURNS CHARACTER
     4362     ( INPUT p-deliv-subj-code AS INTEGER) :
     4363   DEFINE BUFFER loc_delivery-subject FOR ub.delivery-subject.
     4364   FIND FIRST loc_delivery-subject NO-LOCK WHERE
     4365             loc_delivery-subject.deliv-subj-code = p-deliv-subj-code NO-ERROR.
     4366   IF AVAILABLE loc_delivery-subject THEN RETURN loc_delivery-subject.deliv-subj-name.
     4367     RETURN "Неизв.субъект доставки".
     4368   END FUNCTION.
     4369   FUNCTION get-type RETURNS CHARACTER
     4370   ( INPUT p-deliv-type-code AS INTEGER) :
     4371   DEFINE BUFFER loc_delivery-type FOR ub.delivery-type.
     4372   FIND FIRST loc_delivery-type NO-LOCK WHERE
     4373             loc_delivery-type.deliv-type-code = p-deliv-type-code NO-ERROR.
     4374   IF AVAILABLE loc_delivery-type THEN RETURN loc_delivery-type.deliv-type-name.
     4375     RETURN "Неизв.тип доставки".
     4376   END FUNCTION.
