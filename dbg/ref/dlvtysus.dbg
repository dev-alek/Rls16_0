     1094         get-type(X_delivery-type-subject.deliv-type-code) COLUMN-LABEL "Тип доставки" FORMAT "X(25)":U
     1095         X_delivery-type-subject.deliv-subj-code COLUMN-LABEL "Вн.код!субъекта!доставки" FORMAT ">>9":U
     1096         get-subject(X_delivery-type-subject.deliv-subj-code) COLUMN-LABEL "Субъект доставки" FORMAT "X(25)":U
     1097         entry (lookup (STRING(X_delivery-type-subject.sts), '0,1,50,99':U), 'тек,удал,блок,удаление':U) COLUMN-LABEL "Статус"
     1098         X_delivery-type-subject.des FORMAT "X(100)":U
     1099       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 16.25.
     1100   DEFINE FRAME Dialog-Frame
     1101        b-quit AT ROW 1 COL 1
     1102        B-mark AT ROW 1 COL 11
     1103        B-sel AT ROW 1 COL 21
     1104        B-add AT ROW 1 COL 31
     1105        b-lkp AT ROW 1 COL 41
     1106        B-chg AT ROW 1 COL 51
     1107        B-del AT ROW 1 COL 61
     1108        B-print AT ROW 1 COL 86
     1109        B-hist AT ROW 1 COL 89
     1110        B-sch AT ROW 1 COL 92
     1111        B-Help AT ROW 1 COL 95
     1112        B-obj AT ROW 2 COL 51
     1113        RS-sts AT ROW 3.5 COL 3.5 NO-LABEL
     1114        br-delivtypesubj AT ROW 5 COL 1
     1115        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1116        SPACE(78.62) SKIP(20.03)
     1117       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1118            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1119            TITLE "Типы доставки от субъекта"
     1120            CANCEL-BUTTON b-quit.
     1121   ASSIGN
     1122          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1123          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1124   ON GO OF FRAME Dialog-Frame
     1125   DO:
     1126     p-rid-list = v-rid-list.
     1127   END.
     1128   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1129   OR ENDKEY OF FRAME Dialog-Frame DO:
     1130     run gbl/markqwa.p (
     1131                              input b-mark:sensitive
     1132                             , input v-rid-list) no-error.
     1133     if error-status:error then return no-apply.
     1134     APPLY "END-ERROR":U TO SELF.
     1135   END.
     1136   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1137   DO:
     1138   define variable loc#log as logical no-undo.
     1139   define variable loc-doc-rec as recid no-undo .
     1140   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1141   do:
     1142     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1143       (input  v-cntxt-db-num
     1144       ,input  v-cntxt-userid
     1145       ,input  0
     1146       ,input  'actn_delivery-storage_work':U
     1147       ,input  'global':U
     1148       ,input  0
     1149       ,input  '':U
     1150       ,input  0
     1151       ,input  0
     1152       ,input  0
     1153       ,input  0
     1154       ,input  true
     1155       ,output loc#log
     1156       )  .
     1157   end.
     1158   if not loc#log then return no-apply.
     1159   run ref/dlvtysui.w
     1160                 (
     1161                    input parParentProc
     1162                   ,input p-curr-obj-type
     1163                   ,input p-curr-obj-code
     1164                   ,input 'ДОБАВЛЕНИЕ':U
     1165                   ,input (if p-mode = "delivery-type"
     1166                           then p-deliv-type-code
     1167                           else 0)
     1168                   ,input (if p-mode = "delivery-subject"
     1169                           then p-deliv-subj-code
     1170                           else 0)
     1171                   ,input-output loc-doc-rec
     1172                               ) no-error
     1173   .
     1174   if loc-doc-rec <> ? then do:
     1175     RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     1176     reposition br-delivtypesubj to recid loc-doc-rec no-error.
     1177     if error-status:error then do:                           find first pos_delivery-type-subject no-lock where                                   recid(pos_delivery-type-subject) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи ТИПА ДОСТАВКИ ОТ СУБЪЕКТОВ" skip                            string(if avail pos_delivery-type-subject                                     then  substitute("Вн код типа доставки: &1 вн код субъекта доставки: &2"                                                     , pos_delivery-type-subject.deliv-type-code                                                     , pos_delivery-type-subject.deliv-subj-code)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     1178   end.
     1179   apply "entry" to br-delivtypesubj in frame Dialog-Frame.
     1180   apply "value-changed" to br-delivtypesubj in frame Dialog-Frame.
     1181   END.
     1182   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1183   DO:
     1184     DEFINE variable loc#log as logical no-undo.
     1185   define variable loc-doc-rec as recid no-undo .
     1186   if not available X_delivery-type-subject then return no-apply.
     1187   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1188   do:
     1189     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1190       (input  v-cntxt-db-num
     1191       ,input  v-cntxt-userid
     1192       ,input  0
     1193       ,input  'actn_delivery-storage_work':U
     1194       ,input  'global':U
     1195       ,input  0
     1196       ,input  '':U
     1197       ,input  0
     1198       ,input  0
     1199       ,input  0
     1200       ,input  0
     1201       ,input  true
     1202       ,output loc#log
     1203       )  .
     1204   end.
     1205   if not loc#log then return no-apply.
     1206   assign
     1207   loc-doc-rec = recid(X_delivery-type-subject).
     1208   run ref/dlvtysui.w
     1209                 (
     1210                    input parParentProc
     1211                   ,input p-curr-obj-type
     1212                   ,input p-curr-obj-code
     1213                   ,input 'ИЗМЕНЕНИЕ':U
     1214                   ,input X_delivery-type-subject.deliv-type-code
     1215                   ,input X_delivery-type-subject.deliv-subj-code
     1216                   ,input-output loc-doc-rec
     1217                               ) no-error
     1218   .
     1219   if loc-doc-rec <> ? then do:
     1220     RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     1221     reposition br-delivtypesubj to recid loc-doc-rec no-error.
     1222     if error-status:error then do:                           find first pos_delivery-type-subject no-lock where                                   recid(pos_delivery-type-subject) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи ТИПА ДОСТАВКИ ОТ СУБЪЕКТОВ" skip                            string(if avail pos_delivery-type-subject                                     then  substitute("Вн код типа доставки: &1 вн код субъекта доставки: &2"                                                     , pos_delivery-type-subject.deliv-type-code                                                     , pos_delivery-type-subject.deliv-subj-code)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     1223   end.
     1224   apply "entry" to br-delivtypesubj in frame Dialog-Frame.
     1225   apply "value-changed" to br-delivtypesubj in frame Dialog-Frame.
     1226   END.
     1227   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1228   DO:
     1229       run proc-b-del in this-procedure no-error.
     1230     if error-status:error then return no-apply.
     1231   END.
     1232   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
     1233   DO:
     1234     define variable loc-doc-rec as recid no-undo .
     1235   define variable v-rid-list as character no-undo.
     1236     if NOT available X_delivery-type-subject then return no-apply.
     1237     loc-doc-rec = recid (X_delivery-type-subject).
     1238     .
     1239     run ref/dlvctyss.w
     1240                   (
     1241                    input parParentProc
     1242                   ,input p-curr-obj-type
     1243                   ,input p-curr-obj-code
     1244                   ,input "":U
     1245                   ,input "one":U
     1246                   ,input X_delivery-type-subject.deliv-type-code
     1247                   ,input X_delivery-type-subject.deliv-subj-code
     1248                   ,input-output v-rid-list
     1249                                 )
     1250   .
     1251     reposition br-delivtypesubj to recid loc-doc-rec no-error.
     1252     apply "entry" to br-delivtypesubj in frame Dialog-Frame.
     1253     apply "value-changed" to br-delivtypesubj in frame Dialog-Frame.
     1254   END.
     1255   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     1256   DO:
     1257     DEFINE variable loc#log as logical no-undo.
     1258   define variable loc-doc-rec as recid no-undo .
     1259   if not available X_delivery-type-subject then return no-apply.
     1260   assign
     1261   loc-doc-rec = recid(X_delivery-type-subject).
     1262   run ref/dlvtysui.w
     1263                 (
     1264                    input parParentProc
     1265                   ,input p-curr-obj-type
     1266                   ,input p-curr-obj-code
     1267                   ,input 'ПРОСМОТР':U
     1268                   ,input X_delivery-type-subject.deliv-type-code
     1269                   ,input X_delivery-type-subject.deliv-subj-code
     1270                   ,input-output loc-doc-rec
     1271                               )
     1272   .
     1273   apply "entry" to br-delivtypesubj in frame Dialog-Frame.
     1274   END.
     1275   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1276   DO:
     1277     define variable loc#log as logical no-undo .
     1278     if available X_delivery-type-subject then do:
     1279   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1280   define variable v-str-recid14 as character no-undo .
     1281   define variable v-num-entry14 as integer   no-undo .
     1282   assign
     1283     v-str-recid14 = trim( string( recid( X_delivery-type-subject ) , "->>>>>>>>>>>9":U ) )
     1284     v-num-entry14 = lookup( v-str-recid14 , v-rid-list )
     1285   .
     1286   if v-num-entry14 > 0 then do:
     1287     assign
     1288       entry( v-num-entry14, v-rid-list ) = "":U
     1289       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1290     .
     1291   end.
     1292   else do:
     1293     assign
     1294       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid14
     1295     .
     1296   end.
     1297       loc#log = br-delivtypesubj:refresh() .
     1298       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1299           loc#log = br-delivtypesubj:select-next-row ().
     1300           apply "VALUE-CHANGED" to br-delivtypesubj in frame Dialog-Frame.
     1301       end.
     1302       if num-entries( v-rid-list ) = 0
     1303       then
     1304           hide mark-num in frame Dialog-Frame.
     1305       else
     1306           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1307     end.
     1308     apply "entry" to br-delivtypesubj in frame Dialog-Frame.
     1309   END.
     1310   ON CHOOSE OF B-obj IN FRAME Dialog-Frame
     1311   DO:
     1312     DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1313     define variable v-sts as integer no-undo init ? .
     1314     IF NOT AVAILABLE X_delivery-type-subject  THEN DO:
     1315         RETURN NO-APPLY.
     1316     END.
     1317     run ref/vardelvs.w (
     1318                        INPUT parParentProc
     1319                     ,  input p-curr-obj-type
     1320                     ,  input p-curr-obj-code
     1321                     ,  input (if lookup("b-add":U, bttns) > 0 then "b-add":U else "":U)
     1322                     ,  INPUT "delivery-type-subject":U
     1323                     ,  input X_delivery-type-subject.deliv-type-code
     1324                     ,  input X_delivery-type-subject.deliv-subj-code
     1325                     ,  input "":U
     1326                     ,  input 0
     1327                     ,  input-output v-sts
     1328                     ,  input-output v-rid-list    ) NO-ERROR.
     1329   END.
     1330   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1331   DO:
     1332     run proc-b-print in this-procedure no-error.
     1333     if error-status:error then do:
     1334       return no-apply.
     1335     end.
     1336     APPLY "ENTRY" to br-delivtypesubj.
     1337   END.
     1338   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1339   DO:
     1340     RUN proc-b-sch IN THIS-PROCEDURE NO-ERROR.
     1341     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1342   END.
     1343   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1344   DO:
     1345       if ( available X_delivery-type-subject ) then do:
     1346       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1347       then
     1348       v-rid-list = string( recid( X_delivery-type-subject ) ) .
     1349     end.
     1350   END.
     1351   ON RETURN OF br-delivtypesubj IN FRAME Dialog-Frame
     1352   or MOUSE-SELECT-DBLCLICK OF br-delivtypesubj IN FRAME Dialog-Frame
     1353       DO:
     1354       run proc-br-delivtypesubj no-error.
     1355     if error-status:error then return no-apply.
     1356   END.
     1357   ON VALUE-CHANGED OF RS-sts IN FRAME Dialog-Frame
     1358   DO:
     1359     ASSIGN
     1360     rs-sts
     1361     p-sts = (IF rs-sts = 'все':U THEN ? ELSE INTEGER(rs-sts))
     1362     .
     1363     RUN openbr IN THIS-PROCEDURE ( input YES, input NO, input '':U) NO-ERROR.
     1364     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     1365   END.
     1366   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1367   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1368   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1369   on help of frame Dialog-Frame
     1370   do:
     1371     run gbl/app_help.p
     1372       (input this-procedure :file-name
     1373       ,input ''
     1374       ,input ?
     1375       ) no-error.
     1376     if error-status :error then do:
     1377       message
     1378         "Ошибка при вызове помощи"
     1379         error-status :get-message(1)
     1380         view-as alert-box .
     1381     end.
     1382   end.
     1383   run minbtn-set in this-procedure .
     1384   on choose of b-help in frame Dialog-Frame
     1385   do:
     1386     apply "help":u to frame Dialog-Frame .
     1387   end.
     1388   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1389   procedure minbtn-set :
     1390       do
     1391           on error undo, return error return-value
     1392           :
     1393           define variable ii              as integer       no-undo .
     1394           define variable fh              as widget-handle no-undo .
     1395           define variable hh              as widget-handle no-undo .
     1396           define variable v-h             as handle        extent 4 no-undo .
     1397           define variable v-name-button   as character     no-undo .
     1398           define variable v-help-old-x    as decimal       no-undo .
     1399           define variable v-help-old-y    as decimal       no-undo .
     1400           define variable v-help-old-size as decimal       no-undo .
     1401           define variable v-frame-width   as decimal       no-undo .
     1402           define variable jj              as integer       no-undo .
     1403           do
     1404               on error undo, return error
     1405               :
     1406               assign
     1407                   v-frame-width = frame Dialog-Frame:width - 0.3
     1408                   fh            = frame Dialog-Frame:first-child
     1409                   hh            = fh:first-child
     1410                   ii            = 1
     1411                   .
     1412               do while valid-handle(hh):
     1413                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1414                   do:
     1415                       case lc(hh:name) :
     1416                           when "b-help" then
     1417                               do:
     1418                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1419                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1420                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1421                                   hh:TOOLTIP = "Помощь" .
     1422                                   v-help-old-x = hh:column .
     1423                                   v-help-old-y = hh:row    .
     1424                                   v-help-old-size = hh:width .
     1425                                   hh:width-chars = 2.5 .
     1426                               end.
     1427                           when "b-print" then
     1428                               do:
     1429                                   hh:load-image("cmp/b-print.bmp":u) .
     1430                                   hh:TOOLTIP = "Печать" .
     1431                                   v-h[ii] = hh:handle .
     1432                                   ii = ii + 1 .
     1433                                   hh:width-chars = 3 .
     1434                               end.
     1435                           when "b-history" or
     1436                           when "b-hist" then
     1437                               do:
     1438                                   hh:load-image("cmp/b-hist.bmp":u) .
     1439                                   hh:TOOLTIP = "История" .
     1440                                   v-h[ii] = hh:handle .
     1441                                   ii = ii + 1 .
     1442                                   hh:width-chars = 3 .
     1443                               end.
     1444                           when "b-sch" then
     1445                               do:
     1446                                   hh:load-image("cmp/b-sch.bmp":u) .
     1447                                   hh:TOOLTIP = "Установка Фильтра" .
     1448                                   v-h[ii] = hh:handle .
     1449                                   ii = ii + 1 .
     1450                                   hh:width-chars = 3 .
     1451                               end.
     1452                           when "b-hist-user" then
     1453                               do:
     1454                                   hh:load-image("cmp/b-hist.bmp":u) .
     1455                                   hh:TOOLTIP = "История пользователя" .
     1456                                   ii = ii + 1 .
     1457                               end.
     1458                       end case.
     1459                   end.
     1460                   hh = hh:next-sibling.
     1461               end.
     1462               b-help:column = v-frame-width - b-help:width-chars.
     1463               jj = 0.
     1464               repeat ii = 4 to 1 by -1 :
     1465                   if valid-handle (v-h[ii] ) then
     1466                   do:
     1467                       jj  = jj + 1 .
     1468                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1469                       v-h[ii]:row    = v-help-old-y .
     1470                   end.
     1471               end.
     1472           end.
     1473       end.
     1474   end procedure.
     1475   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1476   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1477   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1478   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1479   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1480   define variable v-diasize-current-frame-height as decimal   no-undo .
     1481   define variable v-diasize-change-size          as logical   no-undo .
     1482   define variable v-diasize-resize-button        as handle    no-undo .
     1483   define variable v-diasize-wndmax               as logical   no-undo .
     1484   define variable v-diasize-wndstore             as logical   no-undo .
     1485   define variable v-diasize-proc-name            as character no-undo .
     1486   define variable v-diasize-browse-handle        as handle    no-undo .
     1487   define variable v-diasize-browse-number        as integer   no-undo .
     1488   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1489   define temp-table temp-diasize-handle no-undo
     1490     field handle-value  as handle
     1491     field save-position as decimal
     1492     index xpk is primary unique handle-value
     1493     .
     1494   define temp-table temp-browse-handle no-undo
     1495     field browse-type   as character
     1496     field browse-number as integer
     1497     field browse-handle as handle
     1498     field original-size as decimal
     1499     index xpk is primary unique browse-type browse-number
     1500     index xie browse-type browse-handle
     1501   .
     1502   procedure diasize_change-height :
     1503     define input  parameter p-change-value  as decimal   no-undo .
     1504     define input  parameter p-move-resize   as logical   no-undo .
     1505     define variable v-field-group-handle    as handle    no-undo .
     1506     define variable v-object-handle         as handle    no-undo .
     1507     define variable v-frame-height          as decimal   no-undo .
     1508     define variable v-frame-virtual-height  as decimal   no-undo .
     1509     define variable v-browse-height         as decimal   no-undo .
     1510     define variable v-window-height         as decimal   no-undo .
     1511     define variable v-window-virtual-height as decimal   no-undo .
     1512     define variable v-change-sign           as integer   no-undo .
     1513     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1514     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1515     if p-change-value > 0
     1516     then do:
     1517       if frame Dialog-Frame :height + p-change-value
     1518           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1519       then do:
     1520         assign
     1521           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1522                           - (frame Dialog-Frame :height-chars)
     1523         .
     1524         if p-change-value <= 0
     1525         then do:
     1526           run diasize_position-resize-button in this-procedure .
     1527           return .
     1528         end.
     1529       end.
     1530     end.
     1531     if p-change-value < 0
     1532     then do:
     1533       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1534       then do:
     1535         assign
     1536           p-change-value = v-diasize-orig-frame-height
     1537                          - (frame Dialog-Frame :height-chars)
     1538         .
     1539         if p-change-value >= 0
     1540         then do:
     1541           run diasize_position-resize-button in this-procedure .
     1542           return .
     1543         end.
     1544       end.
     1545     end.
     1546     if p-change-value >= 0
     1547     then do:
     1548       assign
     1549         v-change-sign = 1
     1550       .
     1551     end.
     1552     else do:
     1553       assign
     1554         v-change-sign = -1
     1555       .
     1556     end.
     1557     assign
     1558       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1559     .
     1560     if p-change-value = 0
     1561     then do:
     1562       run diasize_position-resize-button in this-procedure .
     1563       return .
     1564     end.
     1565     move_block:
     1566     do
     1567     on error undo move_block, retry move_block
     1568     :
     1569       if retry
     1570       then do:
     1571         do
     1572         on error undo move_block, leave move_block
     1573         :
     1574           if p-change-value > 0
     1575           then do:
     1576             for each buf_temp-diasize-handle
     1577             on error undo, next
     1578             :
     1579               assign
     1580                 v-object-handle = buf_temp-diasize-handle.handle-value
     1581               .
     1582               if v-object-handle <> v-diasize-resize-button
     1583               then do:
     1584                 assign
     1585                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1586                 .
     1587               end.
     1588             end.
