     2804   MAIN-BLOCK:
     2805   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2806      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2807   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2808     run mainmenu_getcntxt in parparentproc
     2809       (output v-cntxt-db-num
     2810       ,output v-cntxt-userid
     2811       ,output v-cntxt-level
     2812       ,output v-cntxt-host-code-obj
     2813       ,output v-cntxt-obj-type
     2814       ,output v-cntxt-obj-code
     2815       ,output v-cntxt-db-num-obj
     2816       ,output v-cntxt-is-admin
     2817       ) .
     2818     find first X_curr_clients no-lock where
     2819               X_curr_clients.obj-type = p-curr-obj-type
     2820          AND X_curr_clients.obj-code = p-curr-obj-code no-error.
     2821     if not available X_curr_clients then do:
     2822       message
     2823       vss-workfile vss-revision vss-description skip
     2824       "Неверное значение параметра вызова p-curr-obj-type p-curr-obj-code"
     2825       p-curr-obj-type p-curr-obj-code
     2826       view-as alert-box ERROR.
     2827       return error .
     2828     end.
     2829    if LOOKUP(p-mode, ('все':U + chr(4) + "delivery-type" + chr(4) + "delivery-subject") ,
     2830                   chr(4)) = 0
     2831        then dO:
     2832       message
     2833       vss-workfile vss-revision vss-description skip
     2834       "Неверное значение параметров вызова p-mode"
     2835       p-mode
     2836       view-as alert-box ERROR.
     2837       return error .
     2838    end.
     2839    IF p-mode = "delivery-type" THEN DO:
     2840        FIND FIRST X_delivery-type NO-LOCK WHERE
     2841                   X_delivery-type.deliv-type-code = p-deliv-type-code NO-ERROR.
     2842       IF NOT AVAILABLE X_delivery-type THEN DO:
     2843           MESSAGE
     2844           vss-workfile vss-revision vss-description skip
     2845           "Неверное значение параметров вызова p-deliv-type-code"
     2846           p-DELIV-TYPE-CODE
     2847           view-as alert-box ERROR.
     2848           return error .
     2849      END.
     2850    END.
     2851   IF p-mode = "delivery-subject" THEN DO:
     2852        FIND FIRST X_delivery-subject NO-LOCK WHERE
     2853                   X_delivery-subject.deliv-subj-code = p-deliv-subj-code NO-ERROR.
     2854       IF NOT AVAILABLE X_delivery-subject THEN DO:
     2855           MESSAGE
     2856           vss-workfile vss-revision vss-description skip
     2857           "Неверное значение параметров вызова p-deliv-subj-code"
     2858           p-DELIV-subj-CODE
     2859           view-as alert-box ERROR.
     2860           return error .
     2861      END.
     2862    END.
