      533   procedure prn-lib-reportviewer :
      534     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      535     define input parameter p-report-name-html as character no-undo .
      536     define input parameter p-param        as character no-undo .
      537     define variable v-excel           as character no-undo init 'TRUE' .
      538     define variable v-value-character as character no-undo .
      539     define variable v-value-integer   as character no-undo .
      540     define variable v-value-date      as date      no-undo .
      541     define variable v-value-decimal   as decimal   no-undo .
      542     define variable rep-excel         as logical   no-undo .
      543     define variable excel-string      as character no-undo .
      544     define variable v-param-type      as character no-undo .
      545     define variable v-tth             as handle    no-undo .
      546     run adm/shattri.p (
      547       input "get":U
      548       ,input  ""
      549       ,input  0
      550       ,input  'report-glob':U
      551       ,input  'rep-excel':U
      552       ,output v-value-character
      553       ,output v-value-date
      554       ,output v-value-decimal
      555       ,output v-value-integer
      556       ,output rep-excel
      557       ,output v-param-type
      558       ,INPUT-OUTPUT table-handle v-tth
      559       )  .
      560     if rep-excel then v-excel = "TRUE" .
      561     else v-excel = "FALSE" .
      562     if p-param eq ""
      563     then
      564        p-param = "EXCEL:" + v-excel.
      565     else
      566        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      567     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      568   end procedure.
      569   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      570   procedure cur-time :
      571      define output parameter p-today as date      no-undo .
      572      define output parameter p-time  as integer   no-undo .
      573     do
      574     on error undo, return error
      575     :
      576       define variable v-date1 as date      no-undo .
      577       define variable v-date2 as date      no-undo .
      578       define variable v-time  as integer   no-undo .
      579       assign
      580         v-date1 = today
      581         v-time  = time
      582         v-date2 = today
      583       .
      584       if v-date1 <> v-date2
      585       then do:
      586         assign
      587           v-date1 = today
      588           v-time  = v-time
      589         .
      590       end.
      591       assign
      592         p-today = v-date1
      593         p-time  = v-time
      594       .
      595     end.
      596   end.
      597   function cur-time-date returns character
      598   :
      599     return string(today, '99/99/9999':U) .
      600   end.
      601   function cur-time-mjd returns decimal
      602   :
      603     define variable v-date as date      no-undo .
      604     define variable v-time as integer   no-undo .
      605     run cur-time in this-procedure
      606       (output v-date
      607       ,output v-time
      608       ) .
      609     return integer(v-date) - 2400002 + (v-time / 86400) .
      610   end.
      611   function cur-time-get-ending-index returns integer
      612   (input p-number as integer
      613   )
      614   :
      615     if p-number < 0
      616     or p-number = ?
      617     then do:
      618       return 1 .
      619     end.
      620     define variable v-rest as integer   no-undo .
      621     assign
      622       p-number = p-number modulo 100
      623     .
      624     if p-number < 20
      625     then do:
      626       assign
      627         v-rest = p-number
      628       .
      629     end.
      630     else do:
      631       assign
      632         v-rest = p-number modulo 10
      633       .
      634     end.
      635     case v-rest :
      636       when 1
      637       then do:
      638         return 2 .
      639       end.
      640       when 2 or
      641       when 3 or
      642       when 4
      643       then do:
      644         return 3 .
      645       end.
      646       otherwise do:
      647         return 1 .
      648       end.
      649     end case .
      650   end.
      651   procedure cur-time-mjd-to-date :
      652      define input  parameter i-mjd-diff as decimal no-undo.
      653      define output parameter o-Date     as date    no-undo.
      654      define output parameter o-Time     as integer no-undo.
      655      define variable v-day-number as integer   no-undo .
      656      if    i-mjd-diff < 0
      657         or i-mjd-diff = ?
      658      then do:
      659         return "?" .
      660      end.
      661      assign
      662         v-day-number = truncate(i-mjd-diff,0).
      663         o-Date = date(v-day-number + 2400002).
      664         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      665     .
      666   end.
      667   function cur-time-mjd-to-string returns character
      668   (input p-mjd-diff as decimal
      669   )
      670   :
      671     define variable v-day-number as integer   no-undo .
      672     define variable v-seconds    as integer   no-undo .
      673     define variable v-hour       as integer   no-undo .
      674     define variable v-min        as integer   no-undo .
      675     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      676     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      677     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      678     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      679     if p-mjd-diff < 0
      680     or p-mjd-diff = ?
      681     then do:
      682       return "?" .
      683     end.
      684     assign
      685       v-day-number = integer(truncate(p-mjd-diff,0))
      686       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      687     .
      688     if v-seconds > 86400
      689     then do:
      690       assign
      691         v-seconds = 86400 - 1
      692       .
      693     end.
      694     if v-seconds < 0
      695     then do:
      696       assign
      697         v-seconds = 0
      698       .
      699     end.
      700     assign
      701       v-hour = truncate(v-seconds / 3600, 0)
      702     .
      703     assign
      704       v-seconds = v-seconds modulo 3600
      705     .
      706     assign
      707       v-min = truncate(v-seconds / 60, 0)
      708     .
      709     assign
      710       v-seconds = v-seconds modulo 60
      711     .
      712     return
      713         (if v-day-number <> 0
      714           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      715           else ""
      716         )
      717       + (if v-day-number <> 0 or v-hour <> 0
      718           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      719           else ""
      720         )
      721       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      722           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      723           else ""
      724         )
      725       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      726       .
      727   end.
      728   function cur-time-string returns character
      729   :
      730     define variable v-date as date      no-undo .
      731     define variable v-time as integer   no-undo .
      732     run cur-time in this-procedure
      733       (output v-date
      734       ,output v-time
      735       ) .
      736     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      737   end.
      738   function cur-time-string-sec returns character
      739   :
      740     define variable v-date as date      no-undo .
      741     define variable v-time as integer   no-undo .
      742     run cur-time in this-procedure
      743       (output v-date
      744       ,output v-time
      745       ) .
      746     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      747   end.
      748   function cur-time-custom  returns character
      749   (input p-prefix as character
      750   ,input p-date-format as character
      751   ,input p-delimiter as character
      752   ,input p-time-format as character
      753   ,input p-suffix as character
      754   )
      755   :
      756     define variable v-date as date      no-undo .
      757     define variable v-time as integer   no-undo .
      758     run cur-time in this-procedure
      759       (output v-date
      760       ,output v-time
      761       ) .
      762     return
      763       p-prefix
      764       + string(v-date, p-date-format)
      765       + p-delimiter
      766       + string(v-time, p-time-format)
      767       + p-suffix
      768       .
      769   end.
      770   function cur-time-print  returns character
      771   :
      772     define variable v-date as date      no-undo .
      773     define variable v-time as integer   no-undo .
      774     run cur-time in this-procedure
      775       (output v-date
      776       ,output v-time
      777       ) .
      778     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      779   end.
      780   function cur-time-datetime returns datetime
      781   :
      782     define variable v-char as character no-undo .
      783     define variable v-datetime as datetime no-undo .
      784     v-char = cur-time-string().
      785     v-datetime = datetime(v-char).
      786     return  v-datetime.
      787   end.
      788   function cur-time-string-msec returns character
      789   :
      790     define variable v-date as datetime  no-undo .
      791     v-date = now.
      792     return string(v-date) .
      793   end.
