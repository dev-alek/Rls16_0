     4188   PROCEDURE proc-b-del :
     4189   define variable loc#log as logical no-undo.
     4190   define variable v-sts like ub.delivery-type-subject.sts no-undo .
     4191   DEFINE VARIABLE loc-doc-rec AS RECID NO-UNDO.
     4192   if not available X_delivery-type-subject then return error.
     4193   do
     4194   on error undo, return error
     4195   on stop undo, return error
     4196   :
     4197   define variable vss-include-info43 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4198   do:
     4199     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4200       (input  v-cntxt-db-num
     4201       ,input  v-cntxt-userid
     4202       ,input  0
     4203       ,input  'actn_delivery-storage_work':U
     4204       ,input  'global':U
     4205       ,input  0
     4206       ,input  '':U
     4207       ,input  0
     4208       ,input  0
     4209       ,input  0
     4210       ,input  0
     4211       ,input  true
     4212       ,output loc#log
     4213       )  .
     4214   end.
     4215   if not loc#log then return error.
     4216     assign
     4217     v-sts = ?
     4218     loc-doc-rec = RECID(X_delivery-type-subject)
     4219     .
     4220     run ref/dlvtysu2.p (
     4221                     input recid(X_delivery-type-subject)
     4222                     ,input-output v-sts
     4223                    ) no-error .
     4224     if error-status:error then undo, return error.
     4225     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     4226     REPOSITION br-delivtypesubj to recid loc-doc-rec No-error.
     4227     if error-status:error then do:                           find first pos_delivery-type-subject no-lock where                                   recid(pos_delivery-type-subject) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи ТИПА ДОСТАВКИ ОТ СУБЪЕКТОВ" skip                            string(if avail pos_delivery-type-subject                                     then  substitute("Вн код типа доставки: &1 вн код субъекта доставки: &2"                                                     , pos_delivery-type-subject.deliv-type-code                                                     , pos_delivery-type-subject.deliv-subj-code)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     4228     if available X_delivery-type-subject then do:
     4229       loc#log = br-delivtypesubj:select-focused-row( ) IN FRAME Dialog-Frame.
     4230     end.
     4231     apply "ENTRY" to br-delivtypesubj.
     4232   end.
     4233   END PROCEDURE.
