     1876   end procedure.
     1877   procedure diasize_set-height :
     1878     define input  parameter p-new-height  as decimal   no-undo .
     1879     define input  parameter p-move-resize as logical   no-undo .
     1880     do
     1881     on error undo, return error return-value
     1882     :
     1883       run diasize_change-height in this-procedure
     1884         (input  (p-new-height - frame Dialog-Frame :height)
     1885         ,input  p-move-resize
     1886         ) .
     1887     end.
     1888   end procedure.
     1889   procedure diasize_change-width :
     1890     define input  parameter p-change-value as decimal   no-undo .
     1891     define input  parameter p-move-resize  as logical   no-undo .
