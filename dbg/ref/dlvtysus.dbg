      803   procedure fltfield-clear :
      804     define output parameter loc-fld as character no-undo.
      805     define output parameter loc-lab as character no-undo .
      806     define output parameter loc-spr as character no-undo .
      807     define output parameter loc-dim as character no-undo .
      808     assign
      809       loc-fld = ""
      810       loc-lab = ""
      811       loc-spr = ""
      812       loc-dim = "0"
      813     .
      814   end procedure .
      815   procedure fltfield-add :
      816     define input        parameter par-fld as character no-undo.
      817     define input        parameter par-lab as character no-undo .
      818     define input        parameter par-spr as character no-undo .
      819     define input-output parameter loc-fld as character no-undo.
      820     define input-output parameter loc-lab as character no-undo .
      821     define input-output parameter loc-spr as character no-undo .
      822     define input-output parameter loc-dim as character no-undo .
      823     do
      824     on error undo, return error
      825     :
      826       assign
      827       loc-fld = if loc-dim = '0'
      828                 then par-fld
      829                 else (loc-fld + chr(44) + par-fld)
      830       loc-lab = if loc-dim = '0'
      831                 then par-lab
      832                 else (loc-lab + chr(44) + par-lab)
      833       loc-spr = if loc-dim = '0'
      834                 then par-spr
      835                 else (loc-spr + chr(44) + par-spr)
      836       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      837                 string(integer(if num-entries(loc-dim) > 1
      838                               then entry(2, loc-dim)
      839                               else entry(1, loc-dim)
      840                               ) + 1)
      841       no-error
      842       .
      843     end.
      844   end procedure.
