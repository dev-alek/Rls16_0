     2156         end.
     2157         for each buf_temp-diasize-handle
     2158         on error undo move_block, retry move_block
     2159         :
     2160           assign
     2161             v-object-handle = buf_temp-diasize-handle.handle-value
     2162           .
     2163           if v-object-handle <> v-diasize-resize-button
     2164           then do:
     2165             assign
     2166               v-object-handle :col = v-object-handle :col + p-change-value
     2167               no-error .
     2168             if error-status :error
     2169             or error-status :get-message(1) <> ""
     2170             then do:
     2171               undo move_block, retry move_block .
     2172             end.
     2173           end.
     2174         end.
     2175       end.
     2176       else do:
     2177         for each buf_temp-diasize-handle
     2178         on error undo move_block, retry move_block
     2179         :
     2180           assign
     2181             v-object-handle = buf_temp-diasize-handle.handle-value
     2182           .
     2183           if v-object-handle <> v-diasize-resize-button
     2184           then do:
     2185             assign
     2186               v-object-handle :col = v-object-handle :col + p-change-value
     2187               no-error .
     2188             if error-status :error
     2189             or error-status :get-message(1) <> ""
     2190             then do:
     2191               undo move_block, retry move_block .
     2192             end.
     2193           end.
     2194         end.
     2195         for each buf_temp-browse-handle
     2196           where buf_temp-browse-handle.browse-type = 'width':u
     2197         on error undo move_block, retry move_block
     2198         :
     2199           assign
     2200             buf_temp-browse-handle.browse-handle :width
     2201               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2202             no-error .
     2203           if error-status :error
     2204           or error-status :get-message(1) <> ""
     2205           then do:
     2206             undo move_block, retry move_block .
     2207           end.
     2208         end.
     2209         assign
     2210           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2211           no-error .
     2212         if error-status :error
     2213         or error-status :get-message(1) <> ""
     2214         then do:
     2215           undo move_block, retry move_block.
     2216         end.
     2217         assign
     2218           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2219         no-error .
     2220         if error-status :error
     2221         or error-status :get-message(1) <> ""
     2222         then do:
     2223           undo move_block, retry move_block.
     2224         end.
     2225         if frame Dialog-Frame :scrollable = true
     2226         then do:
     2227           assign
     2228             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2229           no-error .
     2230           if error-status :error
     2231           or error-status :get-message(1) <> ""
     2232           then do:
     2233             undo move_block, retry move_block.
     2234           end.
     2235         end.
     2236       end.
     2237       if p-move-resize
     2238       then do:
     2239         run diasize_position-resize-button in this-procedure .
     2240       end.
     2241       if v-diasize-wndstore = true
     2242       then do:
     2243         if connected("ub") = true
     2244         then do:
     2245           define variable v-cntxt-db-num        as integer   no-undo .
     2246           define variable v-cntxt-userid        as character no-undo .
     2247           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2248                                             , OUTPUT v-cntxt-userid
     2249                                             ) .
     2250           run gbl/wndsizew.p
     2251             (input  v-cntxt-db-num
     2252             ,input  v-cntxt-userid
     2253             ,input  v-diasize-proc-name
     2254             ,input  'width':u
     2255             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2256             ) .
     2257         end.
     2258       end.
     2259     end.
     2260     assign
     2261       v-diasize-change-size = false
     2262     .
     2263   end procedure.
     2264   procedure diasize_set-width :
     2265     define input  parameter p-new-width  as decimal   no-undo .
     2266     define input  parameter p-move-resize as logical   no-undo .
     2267     do
     2268     on error undo, return error return-value
     2269     :
     2270       run diasize_change-width in this-procedure
     2271         (input  (p-new-width - frame Dialog-Frame :width)
     2272         ,input  p-move-resize
     2273         ) .
     2274     end.
     2275   end procedure.
     2276   procedure diasize_position-resize-button :
     2277     do with frame Dialog-Frame
     2278     :
     2279       hide v-diasize-resize-button .
     2280       assign
     2281         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2282                     - 1
     2283                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2284         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2285                     - 1
     2286                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2287       .
     2288       view v-diasize-resize-button .
     2289     end.
     2290   end procedure.
     2291   on alt-right anywhere
     2292   do:
     2293     run diasize_change-width in this-procedure
     2294       (input 1
     2295       ,input true
     2296       ) .
     2297     return no-apply .
     2298   end.
     2299   on alt-left anywhere
     2300   do:
     2301     run diasize_change-width in this-procedure
     2302       (input -1
     2303       ,input true
     2304       ) .
     2305     return no-apply .
     2306   end.
     2307   on alt-down anywhere
     2308   do:
     2309     run diasize_change-height in this-procedure
     2310       (input 1
     2311       ,input true
     2312       ) .
     2313     return no-apply .
     2314   end.
     2315   on alt-up anywhere
     2316   do:
     2317     run diasize_change-height in this-procedure
     2318       (input -1
     2319       ,input true
     2320       ) .
     2321     return no-apply .
     2322   end.
     2323   on alt-enter of frame Dialog-Frame
     2324   do:
     2325     run diasize_maximize in this-procedure
     2326       (input  ?
     2327       ).
     2328     return no-apply .
     2329   end.
     2330   procedure diasize_end-move :
     2331     do
     2332     on error undo, return error return-value
     2333     :
     2334       define variable v-row-delta as decimal   no-undo .
     2335       define variable v-col-delta as decimal   no-undo .
     2336       define variable v-new-row as decimal   no-undo .
     2337       define variable v-new-col as decimal   no-undo .
     2338       assign
     2339         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2340         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2341       .
     2342       assign
     2343         v-row-delta = v-new-row - frame Dialog-Frame :height
     2344         v-col-delta = v-new-col - frame Dialog-Frame :width
     2345       .
     2346       run diasize_change-height in this-procedure
     2347         (input v-row-delta
     2348         ,input true
     2349         ) .
     2350       run diasize_change-width in this-procedure
     2351         (input v-col-delta
     2352         ,input true
     2353         ) .
     2354     end.
     2355   end procedure.
     2356   procedure diasize_maximize :
     2357     define input  parameter p-action as logical   no-undo .
     2358     do
     2359     on error undo, return error return-value
     2360     :
     2361       if p-action = ?
     2362       then do:
     2363         if v-diasize-need-maximize = true
     2364         then do:
     2365           assign
     2366             p-action = true
     2367           .
     2368         end.
     2369         else do:
     2370           assign
     2371             p-action = false
     2372           .
     2373         end.
     2374       end.
     2375       if p-action = true
     2376       then do:
     2377         run diasize_change-height in this-procedure
     2378           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2379               - frame Dialog-Frame :height-chars
     2380           ,input true
     2381           ) .
     2382         run diasize_change-width in this-procedure
     2383           (input session :width-chars
     2384               - frame Dialog-Frame :width-chars
     2385           ,input true
     2386           ) .
     2387         assign
     2388           v-diasize-need-maximize = false
     2389         .
     2390       end.
     2391       else do:
     2392         run diasize_change-width in this-procedure
     2393           (input v-diasize-orig-frame-width
     2394               - frame Dialog-Frame :width-chars
     2395           ,input true
     2396           ) .
     2397         run diasize_change-height in this-procedure
     2398           (input v-diasize-orig-frame-height
     2399               - frame Dialog-Frame :height-chars
     2400           ,input true
     2401           ) .
     2402         assign
     2403           v-diasize-need-maximize = true
     2404         .
     2405       end.
     2406     end.
     2407   end procedure.
     2408   procedure diasize_restore-orig-size :
     2409     do
     2410     on error undo, return error return-value
     2411     :
     2412       assign
     2413         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2414         v-diasize-current-frame-height = frame Dialog-Frame :height
     2415       .
     2416       run diasize_set-height in this-procedure
     2417         (input  v-diasize-orig-frame-height
     2418         ,input  true
     2419         ) .
     2420       run diasize_set-width in this-procedure
     2421         (input  v-diasize-orig-frame-width
     2422         ,input  true
     2423         ) .
     2424     end.
     2425   end procedure.
     2426   procedure diasize_restore-current-size :
     2427     do
     2428     on error undo, return error return-value
     2429     :
     2430       run diasize_set-height in this-procedure
     2431         (input  v-diasize-current-frame-height
     2432         ,input  true
     2433         ) .
     2434       run diasize_set-width in this-procedure
     2435         (input  v-diasize-current-frame-width
     2436         ,input  true
     2437         ) .
     2438     end.
     2439   end procedure.
     2440   procedure diasize_set-browse-handle :
     2441     define input  parameter p-browse-handle as handle   no-undo .
     2442     define buffer buf_temp-browse-handle for temp-browse-handle .
     2443     do
     2444     on error undo, return error return-value
     2445     :
     2446       assign
     2447         v-diasize-browse-handle = p-browse-handle
     2448       .
     2449       for each buf_temp-browse-handle
     2450       on error undo, return error return-value
     2451       :
     2452         delete buf_temp-browse-handle .
     2453       end.
     2454     end.
     2455   end procedure.
     2456   procedure diasize_add_browse :
     2457     define input  parameter p-browse-type   as character no-undo .
     2458     define input  parameter p-browse-handle as handle    no-undo .
     2459     define buffer buf_temp-browse-handle for temp-browse-handle .
     2460     do
     2461     on error undo, return error return-value
     2462     :
     2463       assign
     2464         v-diasize-browse-number = v-diasize-browse-number + 1
     2465       .
     2466       create buf_temp-browse-handle .
     2467       assign
     2468         buf_temp-browse-handle.browse-type   = p-browse-type
     2469         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2470         buf_temp-browse-handle.browse-handle = p-browse-handle
     2471       .
     2472     end.
     2473   end procedure.
     2474   procedure diasize_init :
     2475     define variable v-default-value    as logical   no-undo .
     2476     define variable v-restore-saved    as logical   no-undo .
     2477     define variable v-resize-value-str as character no-undo .
     2478     do
     2479     on error undo, return error return-value
     2480     :
     2481       do with frame Dialog-Frame
     2482       :
     2483         assign
     2484           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2485           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2486           v-diasize-browse-handle     = browse br-delivtypesubj :handle
     2487         .
     2488         create button v-diasize-resize-button
     2489         assign
     2490           parent        = frame Dialog-Frame :first-child
     2491           label         = "s"
     2492           height-pixels = 16
     2493           width-pixels  = 16
     2494           visible       = true
     2495           sensitive     = true
     2496           movable       = true
     2497           triggers:
     2498             on end-move persistent run diasize_end-move in this-procedure .
     2499           end triggers.
     2500         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2501         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2502         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2503         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2504         assign
     2505           v-diasize-wndmax = false
     2506         .
     2507         if connected("ub") = true
     2508         then do:
     2509           define variable v-cntxt-db-num        as integer   no-undo .
     2510           define variable v-cntxt-userid        as character no-undo .
     2511           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2512                                             , OUTPUT v-cntxt-userid
     2513                                             ) .
     2514           run gbl/wndpar_r.p
     2515             (input  v-cntxt-db-num
     2516             ,input  v-cntxt-userid
     2517             ,input  'wndmax':U
     2518             ,output v-diasize-wndmax
     2519             ,output v-default-value
     2520             ) .
     2521         end.
     2522         assign
     2523           v-diasize-wndstore = false
     2524         .
     2525         if connected("ub") = true
     2526         then do:
     2527           run gbl/wndpar_r.p
     2528             (input  v-cntxt-db-num
     2529             ,input  v-cntxt-userid
     2530             ,input  'wndstore':U
     2531             ,output v-diasize-wndstore
     2532             ,output v-default-value
     2533             ) .
     2534         end.
     2535         assign
     2536           v-diasize-proc-name = entry(1, program-name(2), '.')
     2537         .
     2538         if v-diasize-wndstore = true
     2539         then do:
     2540           assign
     2541             v-restore-saved = false
     2542           .
     2543           if connected("ub") = true
     2544           then do:
     2545             run gbl/wndsizer.p
     2546               (input  v-cntxt-db-num
     2547               ,input  v-cntxt-userid
     2548               ,input  v-diasize-proc-name
     2549               ,input  'height':u
     2550               ,output v-resize-value-str
     2551               ) .
     2552             if v-resize-value-str <> '':U
     2553             then do:
     2554               run diasize_change-height in this-procedure
     2555                 (input  integer(v-resize-value-str)
     2556                 ,input  true
     2557                 ) .
     2558               assign
     2559                 v-restore-saved = true
     2560               .
     2561             end.
     2562           end.
     2563           if connected("ub") = true
     2564           then do:
     2565             run gbl/wndsizer.p
     2566               (input  v-cntxt-db-num
     2567               ,input  v-cntxt-userid
     2568               ,input  v-diasize-proc-name
     2569               ,input  'width':u
     2570               ,output v-resize-value-str
     2571               ) .
     2572             if v-resize-value-str <> '':U
     2573             then do:
     2574               run diasize_change-width in this-procedure
     2575                 (input  integer(v-resize-value-str)
     2576                 ,input  true
     2577                 ) .
     2578               assign
     2579                 v-restore-saved = true
     2580               .
     2581             end.
     2582           end.
     2583           if v-restore-saved <> true
     2584           then do:
     2585             if v-diasize-wndmax = true
     2586             then do:
     2587               run diasize_maximize in this-procedure
     2588                 (input  true
     2589                 ) .
     2590             end.
     2591           end.
     2592         end.
     2593         else do:
     2594           if v-diasize-wndmax = true
     2595           then do:
     2596             run diasize_maximize in this-procedure
     2597               (input  true
     2598               ) .
     2599           end.
     2600         end.
     2601       end.
     2602     end.
     2603   end procedure.
     2604   procedure diasize_need-full-display :
     2605     define output parameter p-need-full-display as logical   no-undo .
     2606     do
     2607     on error undo, return error return-value
     2608     :
     2609       assign
     2610         p-need-full-display = v-diasize-need-full-display
     2611       .
     2612       assign
     2613         v-diasize-need-full-display = false
     2614       .
     2615     end.
     2616   end procedure.
     2617   procedure get-context :
     2618      define output parameter p-db-num as integer          no-undo.
     2619      define output parameter p-user-id as character        no-undo.
     2620      define variable v-login               as character    no-undo.
     2621      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2622      define buffer buf_user-login  for ub.user-login .
     2623      do
     2624      on error undo, return error
     2625      :
     2626            FIND FIRST buf_sys-ctrl no-lock.
     2627            ASSIGN
     2628               v-login = USERID("ub")
     2629               p-db-num = buf_sys-ctrl.db-num
     2630            .
     2631            FIND FIRST buf_user-login
     2632                 WHERE buf_user-login.db-num = p-db-num
     2633                   AND buf_user-login.user-login = v-login
     2634                 no-lock
     2635                 no-error
     2636                 .
     2637            IF AVAILABLE buf_user-login
     2638            THEN DO:
     2639               assign
     2640                  p-user-id = buf_user-login.user-id
     2641               .
     2642            END.
     2643      end.
     2644   end procedure.
     2645       run diasize_init in this-procedure .
     2646   def var sort-labelbr-delivtypesubj   as character no-undo .
     2647   def var sort-clmnbr-delivtypesubj    as handle    no-undo .
     2648   def var cur-clmnbr-delivtypesubj     as handle    no-undo .
     2649   def var cur-clmn-locbr-delivtypesubj as integer   no-undo .
     2650   def var re-querybr-delivtypesubj     as logical   initial no no-undo .
     2651   on start-search, ctrl-o of br-delivtypesubj in frame Dialog-Frame do:
     2652      run sort-brbr-delivtypesubj
     2653        (input (if available X_delivery-type-subject
     2654                then recid(X_delivery-type-subject)
     2655                else ?
     2656               )
     2657        ).
     2658   end.
     2659   PROCEDURE sort-brbr-delivtypesubj :
     2660     define input parameter p-recid as recid no-undo .
     2661     if re-querybr-delivtypesubj = no then do:
     2662       assign
     2663          cur-clmnbr-delivtypesubj = br-delivtypesubj:current-column in frame Dialog-Frame
     2664       .
     2665       if sort-clmnbr-delivtypesubj <> ? then sort-clmnbr-delivtypesubj:column-fgcolor = 0.
     2666       if cur-clmnbr-delivtypesubj = sort-clmnbr-delivtypesubj then do:
     2667         assign
     2668            sort-labelbr-delivtypesubj = ""
     2669            sort-clmnbr-delivtypesubj = ?
     2670         .
     2671        end.
     2672        else do:
     2673          assign
     2674            sort-labelbr-delivtypesubj = cur-clmnbr-delivtypesubj:label
     2675            sort-clmnbr-delivtypesubj  = cur-clmnbr-delivtypesubj
     2676            sort-clmnbr-delivtypesubj:column-fgcolor = 4
     2677          .
     2678        end.
     2679      end.
     2680     assign
     2681       cur-clmn-locbr-delivtypesubj = 1
     2682     .
     2683     def var column-handle as handle no-undo .
     2684     column-handle = br-delivtypesubj:first-column.
     2685     do while valid-handle(column-handle) :
     2686       if column-handle = cur-clmnbr-delivtypesubj then do:
     2687         leave .
     2688       end.
     2689       column-handle = column-handle:NEXT-COLUMN.
     2690       assign
     2691         cur-clmn-locbr-delivtypesubj = cur-clmn-locbr-delivtypesubj + 1
     2692       .
     2693     end.
     2694     case sort-labelbr-delivtypesubj:
     2695           when X_delivery-type-subject.deliv-type-code:label in browse br-delivtypesubj then DO:    assign       sort-column-name = "X_delivery-type-subject.deliv-type-code"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     2696       otherwise do:
     2697         assign
     2698           sort-column-name = ""
     2699         .
     2700         run OpenBr in this-procedure ( input yes, input no, input '':U).
     2701           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-delivtypesubj') then do:
     2702             run mv-brw-defaultbr-delivtypesubj.
     2703           end.
     2704         if sort-labelbr-delivtypesubj <> "" then do:
     2705           assign
     2706             cur-clmnbr-delivtypesubj:column-fgcolor = 0
     2707           .
     2708         end.
     2709         assign
     2710           cur-clmn-locbr-delivtypesubj = ?
     2711         .
     2712       end.
     2713     end case.
     2714       if cur-clmn-locbr-delivtypesubj <> ? then do:
     2715         if can-do( this-procedure:internal-entries, 'ch-clmnbr-delivtypesubj') then do:
     2716           run ch-clmnbr-delivtypesubj in this-procedure (cur-clmn-locbr-delivtypesubj).
     2717         end.
     2718       end.
     2719     if p-recid <> ? then do:
     2720       reposition br-delivtypesubj to recid p-recid no-error.
     2721       apply "value-changed" to br-delivtypesubj in frame Dialog-Frame.
     2722     end.
     2723     apply "entry" to br-delivtypesubj in frame Dialog-Frame.
     2724   END PROCEDURE.
     2725   procedure re-open-query-srt-clmnbr-delivtypesubj:
     2726   if cur-clmnbr-delivtypesubj = ? then do:
     2727      run OpenBr in this-procedure ( input yes, input no, input '':U).
     2728   end.
     2729   else do:
     2730      assign re-querybr-delivtypesubj = yes.
     2731      run sort-brbr-delivtypesubj
     2732        (input (if available X_delivery-type-subject
     2733                then recid(X_delivery-type-subject)
     2734                else ?
     2735               )
     2736        ).
     2737      assign re-querybr-delivtypesubj = no.
     2738   end.
     2739   end.
     2740   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2741   do:
     2742     br-delivtypesubj :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2743   end.
