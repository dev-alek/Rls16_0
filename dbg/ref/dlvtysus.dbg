     2867    v-rid-list = p-rid-list.
     2868     RUN MyEnable.
     2869     RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     2870     HIDE mark-num in frame Dialog-Frame .
     2871     if v-doc-rec <> ? then
     2872     REPOSITION br-delivtypesubj to recid v-doc-rec No-ERROR.
     2873   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2874   DEF VAR cur-clmn-numbr-delivtypesubj as INT EXTENT 7 no-undo.
     2875   DEF VAR varmvibr-delivtypesubj       as INT no-undo.
     2876   DEF VAR varmvjbr-delivtypesubj       as INT no-undo.
     2877   DEF VAR varmvkbr-delivtypesubj       as INT no-undo.
     2878   DEF VAR varmvlbr-delivtypesubj       as INT no-undo.
     2879   DEF VAR move-elementbr-delivtypesubj as INT no-undo.
     2880   def var jjbr-delivtypesubj           as int no-undo.
     2881   do varmvibr-delivtypesubj = 1 to EXTENT(cur-clmn-numbr-delivtypesubj):
     2882     ASSIGN cur-clmn-numbr-delivtypesubj[varmvibr-delivtypesubj] = varmvibr-delivtypesubj.
     2883   END.
     2884   RUN start-mv-clmnbr-delivtypesubj.
     2885   PROCEDURE start-mv-clmnbr-delivtypesubj:
     2886   def var old-session as logical no-undo.
     2887      old-session = SESSION:IMMEDIATE-DISPLAY.
     2888      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2889          IF  p-mode = 'все':U  THEN DO:
     2890      DO jjbr-delivtypesubj = NUM-ENTRIES('1,2,3,4,5,6,7') TO 1 BY -1:
     2891        RUN re-move-clmnbr-delivtypesubj ( cur-clmn-numbr-delivtypesubj[INTEGER(ENTRY (jjbr-delivtypesubj, '1,2,3,4,5,6,7'))] , 1).
     2892      END.
     2893          END.
     2894          IF  p-mode = 'delivery-type'  THEN DO:
     2895      DO jjbr-delivtypesubj = NUM-ENTRIES('1,4,5,6,7,2,3') TO 1 BY -1:
     2896        RUN re-move-clmnbr-delivtypesubj ( cur-clmn-numbr-delivtypesubj[INTEGER(ENTRY (jjbr-delivtypesubj, '1,4,5,6,7,2,3'))] , 1).
     2897      END.
     2898          END.
     2899          IF  p-mode = 'delivery-subject'  THEN DO:
     2900      DO jjbr-delivtypesubj = NUM-ENTRIES('1,2,3,6,7,4,5') TO 1 BY -1:
     2901        RUN re-move-clmnbr-delivtypesubj ( cur-clmn-numbr-delivtypesubj[INTEGER(ENTRY (jjbr-delivtypesubj, '1,2,3,6,7,4,5'))] , 1).
     2902      END.
     2903          END.
     2904      SESSION:IMMEDIATE-DISPLAY = old-session.
     2905   END.
     2906   ON ctrl-cursor-right OF BROWSE br-delivtypesubj do:
     2907     RUN re-move-clmnbr-delivtypesubj ( 1, 7).
     2908   END.
     2909   ON ctrl-cursor-left OF BROWSE br-delivtypesubj do:
     2910     RUN re-move-clmnbr-delivtypesubj (7, 1).
     2911   END.
     2912   PROCEDURE re-move-clmnbr-delivtypesubj:
     2913     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2914     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2915     DO varmvibr-delivtypesubj = 1 TO EXTENT(cur-clmn-numbr-delivtypesubj):
     2916       if cur-clmn-numbr-delivtypesubj[varmvibr-delivtypesubj] = source-column THEN cur-clmn-numbr-delivtypesubj[varmvibr-delivtypesubj] = -1.
     2917     END.
     2918     if br-delivtypesubj:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     2919     if source-column > target-column THEN
     2920     DO varmvjbr-delivtypesubj = source-column - 1 to target-column BY -1:
     2921       DO varmvibr-delivtypesubj = 1 TO EXTENT(cur-clmn-numbr-delivtypesubj):
     2922           if cur-clmn-numbr-delivtypesubj[varmvibr-delivtypesubj] = varmvjbr-delivtypesubj THEN DO:
     2923             cur-clmn-numbr-delivtypesubj[varmvibr-delivtypesubj] = cur-clmn-numbr-delivtypesubj[varmvibr-delivtypesubj] + 1.
     2924           END.
     2925       END.
     2926     END.
     2927     ELSE
     2928     DO varmvjbr-delivtypesubj = source-column + 1 to target-column:
     2929       DO varmvibr-delivtypesubj = 1 TO EXTENT(cur-clmn-numbr-delivtypesubj):
     2930         if cur-clmn-numbr-delivtypesubj[varmvibr-delivtypesubj] = varmvjbr-delivtypesubj THEN DO:
     2931           cur-clmn-numbr-delivtypesubj[varmvibr-delivtypesubj] = cur-clmn-numbr-delivtypesubj[varmvibr-delivtypesubj] - 1.
     2932         END.
     2933       END.
     2934     END.
     2935     DO varmvibr-delivtypesubj = 1 TO EXTENT(cur-clmn-numbr-delivtypesubj):
     2936       if cur-clmn-numbr-delivtypesubj[varmvibr-delivtypesubj] = -1 THEN cur-clmn-numbr-delivtypesubj[varmvibr-delivtypesubj] = target-column.
     2937     END.
     2938   END PROCEDURE.
     2939   PROCEDURE ch-clmnbr-delivtypesubj:
     2940     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2941     if cur-clmn-loc <= 1 then do:
     2942       return .
     2943     end.
     2944     DO varmvibr-delivtypesubj = 1 TO EXTENT(cur-clmn-numbr-delivtypesubj):
     2945       if cur-clmn-numbr-delivtypesubj[varmvibr-delivtypesubj] = cur-clmn-loc THEN move-elementbr-delivtypesubj = varmvibr-delivtypesubj.
     2946     END.
     2947     RUN re-move-clmnbr-delivtypesubj (cur-clmn-loc, 1).
     2948   END PROCEDURE.
     2949   PROCEDURE mv-brw-defaultbr-delivtypesubj:
     2950   def var old-session as logical no-undo.
     2951     old-session = SESSION:IMMEDIATE-DISPLAY.
     2952     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2953     do varmvlbr-delivtypesubj = 1 to EXTENT(cur-clmn-numbr-delivtypesubj):
     2954       RUN re-move-clmnbr-delivtypesubj (cur-clmn-numbr-delivtypesubj[varmvlbr-delivtypesubj], varmvlbr-delivtypesubj).
     2955     END.
     2956     RUN start-mv-clmnbr-delivtypesubj.
     2957     SESSION:IMMEDIATE-DISPLAY = old-session.
     2958   END PROCEDURE.
     2959   .
     2960   WAIT-FOR GO OF FRAME Dialog-Frame.
     2961   END.
     2962   RUN disable_UI.
     2963   PROCEDURE disable_UI :
     2964     HIDE FRAME Dialog-Frame.
     2965   END PROCEDURE.
     2966   PROCEDURE enable_UI :
     2967     DISPLAY RS-sts mark-num
     2968         WITH FRAME Dialog-Frame.
     2969     ENABLE b-quit B-mark B-sel B-add b-lkp B-chg B-del B-print B-hist B-sch
     2970            B-Help B-obj RS-sts br-delivtypesubj mark-num
     2971         WITH FRAME Dialog-Frame.
     2972     VIEW FRAME Dialog-Frame.
     2973     OPEN QUERY br-delivtypesubj FOR EACH X_delivery-type-subject NO-LOCK INDEXED-REPOSITION.
     2974   END PROCEDURE.
     2975   PROCEDURE MyEnable :
     2976   ASSIGN
     2977   rs-sts:RADIO-BUTTONS IN FRAME Dialog-Frame
     2978                          = "Текущие&+" + chr(44) +  '0':U + chr(44) +
     2979                          "Все&!" + chr(44) + 'все':U + chr(44) +
     2980                           "Удаленные&-" + chr(44) + '1':U
     2981   rs-sts = (IF p-sts = ? THEN 'все':U ELSE string(p-sts))
     2982   .
     2983   DISPLAY mark-num
     2984   WITH FRAME Dialog-Frame.
     2985   ENABLE
     2986   b-quit
     2987   B-mark when LOOKUP("b-mark":U, bttns) > 0
     2988   B-sel when LOOKUP("b-sel":U, bttns) > 0
     2989   B-add when LOOKUP("b-add":U, bttns) > 0 and v-db-num = 0
     2990   b-lkp
     2991   B-chg when LOOKUP("b-add":U, bttns) > 0 and v-db-num = 0
     2992   B-del when LOOKUP("b-add":U, bttns) > 0 and v-db-num = 0
     2993   B-print
     2994   B-Help
     2995   B-hist
     2996   b-sch
     2997   b-obj
     2998   br-delivtypesubj
     2999   mark-num
     3000   RS-sts
     3001   with FRAME Dialog-Frame.
     3002   VIEW FRAME Dialog-Frame.
     3003   END PROCEDURE.
     3004   PROCEDURE OpenBr :
     3005   define input  parameter p-open-query     as logical   no-undo .
     3006   define input  parameter p-find-next      as logical   no-undo .
     3007   define input  parameter p-find-condition as character no-undo .
     3008   define variable l-query-was-opened as logical no-undo .
     3009   define variable title0 as character no-undo.
     3010   title0 = "Список типов доставки до субъектов" + chr(32).
     3011   run waitfram-show in this-procedure ("Ждите...").
     3012   define variable sort-column-phrase as character no-undo .
     3013   case sort-column-name :
     3014     when "" then do:
     3015       assign
     3016         sort-column-phrase = ""
     3017       .
     3018     end.
     3019     otherwise do:
     3020       assign
     3021         sort-column-phrase = "by " + sort-column-name
     3022       .
     3023     end.
     3024   end case.
     3025   define variable l-open-query as logical   no-undo .
     3026     CASE p-mode :
     3027       WHEN 'все':U        THEN DO:
     3028        assign
     3029        filter-point = filter-point0 + p-mode
     3030        filter-label = substitute("&1", filter-label0)
     3031        .
     3032        IF p-sts = ?  THEN DO:
     3033   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3034   define variable  l-disable-where-32  as logical   no-undo .
     3035   define variable  l-filter-open-32    as logical   .
     3036   define variable  flt-rec-32       as recid     no-undo .
     3037   define variable  filter-name-32      as character no-undo .
     3038   define variable  where-phrase-32     as character no-undo .
     3039   define variable  sort-phrase-32      as character no-undo .
     3040   define variable  where-phrase-rus-32 as character no-undo .
     3041   define variable  sort-phrase-rus-32  as character no-undo .
     3042     run waitfram-show in this-procedure
     3043       (input "ЖДИТЕ ..."
     3044       ).
     3045   run gbl/flt-get.p
     3046     (input filter-point
     3047     ,output flt-rec-32
     3048     ,output filter-name-32
     3049     ,output where-phrase-32
     3050     ,output sort-phrase-32
     3051     ,output where-phrase-rus-32
     3052     ,output sort-phrase-rus-32
     3053     ).
     3054   if p-open-query then do:
     3055       run set-filter-name in this-procedure
     3056         (INPUT filter-name-32
     3057         ) no-error .
     3058     assign
     3059       l-filter-open-32 = false
     3060     .
     3061     if flt-rec-32 <> ?
     3062       or sort-column-phrase > ""
     3063     then do:
     3064       define variable  parameter-2-32 as character no-undo .
     3065       define variable  parameter-3-32 as character no-undo .
     3066       define variable  parameter-4-32 as character no-undo .
     3067       define variable  parameter-5-32 as character no-undo .
     3068       define variable  parameter-6-32 as character no-undo .
     3069       define variable  parameter-7-32 as character no-undo .
     3070         assign
     3071         parameter-3-32 =
     3072                                 "FOR EACH X_delivery-type-subject"
     3073         parameter-4-32 =
     3074           (
     3075             if (" TRUE " + " " + where-phrase-32) <> ""
     3076             then " TRUE " + " " + where-phrase-32
     3077             else "true"
     3078           )
     3079         parameter-5-32 = (" " + "" + " " + "")
     3080         parameter-6-32 = if sort-phrase-32 = ''
     3081                              then
     3082           (
     3083           " " + "  " +
     3084             " " + sort-column-phrase +
     3085           " " + "  "
     3086           )
     3087                              else
     3088           (
     3089           " " + "  " +
     3090             " " + sort-column-phrase +
     3091           " " + sort-phrase-32
     3092           )
     3093         parameter-7-32 =
     3094           " indexed-reposition  "
     3095       .
     3096       do
     3097       on stop undo, leave
     3098       on error undo, leave
     3099       :
     3100         assign
     3101           l-disable-where-32 =
     3102             (" TRUE " + " " + where-phrase-32 = "")
     3103         .
     3104         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3105                             ,input QUERY br-delivtypesubj:handle
     3106                             ,input parameter-3-32
     3107                             ,input parameter-4-32
     3108                             ,input parameter-5-32
     3109                             ,input parameter-6-32
     3110                             ,input parameter-7-32
     3111                             )
     3112         .
     3113         assign
     3114           l-filter-open-32 = true
     3115         .
     3116       end.
     3117       if l-filter-open-32 = false then do:
     3118         message
     3119           "Ошибка при фильтрации / сортировке" skip
     3120           "Будут показаны записи без учета фильтра" skip
     3121           view-as alert-box .
     3122       end.
     3123       else do:
     3124           assign
     3125             l-query-was-opened = true
     3126           .
     3127       end.
     3128     end.
     3129     if l-filter-open-32 = false then do:
     3130       OPEN QUERY br-delivtypesubj FOR EACH X_delivery-type-subject
     3131         where  TRUE
     3132         indexed-reposition
     3133     .
     3134         assign
     3135           l-query-was-opened = true
     3136         .
     3137     end.
     3138   end.
     3139   else do:
     3140     assign
     3141       v-doc-rec = recid( X_delivery-type-subject )
     3142     .
     3143     do
     3144     on stop undo, leave
     3145     on error undo, leave
     3146     :
     3147       if QUERY br-delivtypesubj:handle:get-buffer-handle(1) = (buffer X_delivery-type-subject:handle) then do:
     3148         assign
     3149         parameter-2-32 = (if p-find-next then "true":u else "false":u )
     3150         parameter-4-32 =
     3151           "where ":u + " TRUE " + " ":u + where-phrase-32 + " ":u + p-find-condition + " " + ""
     3152         parameter-5-32 = "  "
     3153       .
     3154         run fltopend_fltfindd in this-procedure  (
     3155                             input this-procedure:handle
     3156                             ,input QUERY br-delivtypesubj:handle
     3157                             ,input rowid(X_delivery-type-subject)
     3158                             ,input logical(parameter-2-32)
     3159                             ,input no-lock
     3160                             ,input (buffer X_delivery-type-subject:handle)
     3161                             ,input parameter-4-32
     3162                             ,input parameter-5-32
     3163                             ) no-error.
     3164         .
     3165         assign
     3166           v-doc-rec = integer(return-value)
     3167           v-fltopend-rowid[1] = ?
     3168         .
     3169       end.
     3170       else do:
     3171         assign
     3172         parameter-2-32 = (if p-find-next then "true":u else "false":u )
     3173         parameter-3-32 =  "FOR EACH X_delivery-type-subject"
     3174         parameter-4-32 =
     3175           (
     3176             if (" TRUE " + " " + where-phrase-32) <> ""
     3177             then " TRUE " + " " + where-phrase-32
     3178             else "true"
     3179           )
     3180         parameter-5-32 = (" " + "" + " " + "" + " " + p-find-condition)
     3181         parameter-6-32 = if sort-phrase-32 = ''
     3182                              then
     3183           (
     3184           " " + "  " +
     3185             " " + sort-column-phrase +
     3186           " " + "  "
     3187           )
     3188                              else
     3189           (
     3190           " " + "  " +
     3191             " " + sort-column-phrase +
     3192           " " + sort-phrase-32
