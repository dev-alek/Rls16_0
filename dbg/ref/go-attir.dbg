      412     end.
      413   end.
      414   define variable v-update-attr as logical no-undo .
      415   define temp-table tt0-gds-obj-attr no-undo like ub.gds-obj-attr.
      416   define buffer buf_gds-obj-attr for ub.gds-obj-attr.
      417   define buffer locked_gds-obj-attr for ub.gds-obj-attr.
      418   do
      419   on stop undo, return error return-value
      420   :
      421     for each tt0-gds-obj-attr:
      422       delete tt0-gds-obj-attr.
      423     end.
      424     CASE p-mode:
      425       when 'ИЗМЕНЕНИЕ':U then do:
      426         do on error undo, return error :
      427           Find first locked_gds-obj-attr exclusive-lock  where
      428                   locked_gds-obj-attr.gds-code = p-gds-code
      429               AND locked_gds-obj-attr.obj-type = p-obj-type
      430               AND locked_gds-obj-attr.obj-code = p-obj-code
      431               and locked_gds-obj-attr.attr-code = 'lock':U
      432               no-error no-wait.
      433           if not available locked_gds-obj-attr
      434           and not locked locked_gds-obj-attr then do:
      435             create locked_gds-obj-attr.
      436             assign
      437             locked_gds-obj-attr.obj-type =  p-obj-type
      438             locked_gds-obj-attr.obj-code = p-obj-code
      439             locked_gds-obj-attr.gds-code = p-gds-code
      440             locked_gds-obj-attr.attr-code = 'lock':U
      441             .
      442           end.
      443           if locked locked_gds-obj-attr then do:
      444             Find first locked_gds-obj-attr exclusive-lock  where
      445                   locked_gds-obj-attr.gds-code = p-gds-code
      446               AND locked_gds-obj-attr.obj-type = p-obj-type
      447               AND locked_gds-obj-attr.obj-code = p-obj-code
      448               and locked_gds-obj-attr.attr-code = 'lock':U
      449               no-error .
      450           end.
      451         end.
      452         FOR EACH buf_gds-obj-attr no-lock  where
      453                 buf_gds-obj-attr.gds-code = p-gds-code
      454         :
      455           if buf_gds-obj-attr.attr-code = 'lock':U then next.
      456           CREATE tt0-gds-obj-attr.
      457           BUFFER-COPY buf_gds-obj-attr TO tt0-gds-obj-attr.
      458         END.
      459         run ref/gdsoatti.w (
      460                         input parparentproc
      461                       , input p-mode
      462                       , input p-mode-obj
      463                       , input p-gds-code
      464                       , input p-obj-type
      465                       , input p-obj-code
      466                       , input p-update-on-exit
      467                       , output p-modified
      468                       , input-output table tt0-gds-obj-attr
      469                             ) no-error.
      470         if error-status:error then do:
      471           assign
      472           p-is-error = yes
      473           .
      474         end.
      475         for each tt0-gds-obj-attr:
      476           delete tt0-gds-obj-attr.
      477         end.
      478         if p-is-error then do:
      479           return error substitute("&1 &2", error-status:get-message(1) , return-value ).
      480         end.
      481       end.
      482       when 'ПРОСМОТР':U then do:
      483         FOR EACH buf_gds-obj-attr no-lock where
      484                 buf_gds-obj-attr.gds-code = p-gds-code:
      485           if buf_gds-obj-attr.attr-code = 'lock':U then next.
      486           CREATE tt0-gds-obj-attr.
      487           BUFFER-COPY buf_gds-obj-attr TO tt0-gds-obj-attr.
      488         END.
      489         run ref/gdsoatti.w (
      490                         input parparentproc
      491                       , input p-mode
      492                       , input p-mode-obj
      493                       , input p-gds-code
      494                       , input p-obj-type
      495                       , input p-obj-code
      496                       , input p-update-on-exit
      497                       , output p-modified
      498                       , input-output table tt0-gds-obj-attr
      499                             ) no-error.
      500         if error-status:error then do:
      501           assign
      502           p-is-error = yes.
      503         end.
      504         for each tt0-gds-obj-attr:
      505           delete tt0-gds-obj-attr.
      506         end.
      507         if p-is-error then do:
      508           return error substitute("&1 &2", error-status:get-message(1) , return-value ).
      509         end.
      510       end.
      511     end CASE.
      512   end.
