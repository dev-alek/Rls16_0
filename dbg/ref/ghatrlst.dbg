      843   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      844   def
      845    shared
      846   temp-table  obj-list no-undo
      847     field obj-type like ub.clients.obj-type
      848     field obj-code like ub.clients.obj-code
      849     field obj-name like ub.clients.obj-name
      850     field obj-id   as integer
      851     field db-num   as integer
      852     index pi is primary unique obj-id
      853     index ie1 obj-type obj-code
      854     index ie2 obj-name
      855   .
      856   procedure create_obj-list :
      857      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      858      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      859      do
      860      on error undo, return error return-value
      861      :
      862         define buffer cli-obj for ub.clients .
      863         define variable p-var as integer no-undo .
      864         define buffer buf_obj-list for obj-list .
      865         find last buf_obj-list  use-index pi no-error .
      866         if available buf_obj-list
      867         then
      868            p-var = buf_obj-list.obj-id + 1.
      869         else
      870            p-var = 1.
      871         find first cli-obj where
      872                   cli-obj.obj-type = p-obj-type
      873               and cli-obj.obj-code = p-obj-code
      874         no-lock no-error.
      875         if available cli-obj
      876         then do:
      877            create buf_obj-list.
      878            assign
      879               buf_obj-list.obj-id   = p-var
      880               buf_obj-list.obj-code = cli-obj.obj-code
      881               buf_obj-list.obj-type = cli-obj.obj-type
      882               buf_obj-list.obj-name = cli-obj.obj-name
      883               buf_obj-list.db-num   = cli-obj.db-num
      884            .
      885         end.
      886      end.
      887   end.
      888   define variable v-no-ask as logical no-undo .
      889   define variable v-view-log as logical no-undo .
      890   define variable log-file-name                as character      no-undo init "ghatrlst.txt".
      891   define variable v-stop                       as logical        no-undo .
      892   define variable v-choice as integer no-undo .
      893   DEFINE VARIABLE num-rec as integer no-undo .
      894   DEFINE VARIABLE num-rec-ok as integer no-undo .
      895   DEFINE VARIABLE num-rec-all as integer no-undo .
      896   DEFINE VARIABLE num-rec-ok-all as integer no-undo .
      897   define variable v-ok as logical no-undo .
      898   define variable v-mes as character no-undo .
      899   assign
      900   parhost-code = integer(entry(1, p-parameter, chr(4)))
      901   parobj-type  = entry(2, p-parameter, chr(4))
      902   parobj-code = integer(entry(3, p-parameter, chr(4)))
      903   pardelete-ok = logical(entry(4, p-parameter, chr(4)))
      904   no-error
      905   .
      906   if error-status:error then do:
      907    run write-log-and-file in p-log-handle (
      908           input 1
      909         , input log-file-name
      910         , input 1
      911         , input substitute("ќшибка входных параметров &1:&2&3&4"
      912                            , p-parameter
      913                            , chr(10)
      914                            , error-status:get-message(1)
      915                            , return-value
      916                            )).
      917     assign
      918     v-view-log = yes.
      919   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      920   if v-view-log
      921   and not g#news
      922   and not g#auto
      923   then do:
      924     message
      925     '!!!ѕри изменении атрибутов товара на фирме по списку товаров произошли ошибки!!!'  skip
      926     "!!!¬нимательно прочитайте Log-file!!"
      927     view-as alert-box error .
      928        define variable v-user-action8   as character no-undo .
      929     define variable v-printed8       as logical   no-undo .
      930     run gbl/prnfilen.w
      931       (input  ('!!!ѕри изменении атрибутов товара на фирме по списку товаров произошли ошибки!!!')
      932       ,input  0
      933       ,input  (string("./":U) + 'ghatrlst.txt')
      934       ,input  7
      935       ,output v-user-action8
      936       ,output v-printed8
      937       ) .
      938   end.
      939   if v-view-log = true
      940   and (g#news
      941   or g#auto)
      942   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
      943   then do:
      944      run cb_set-view-log in p-parent-handle ( input yes).
      945   end.
      946   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
      947     OS-DELETE value(string("./":U) + 'ghatrlst.txt').
      948   end.
      949     return .
      950   end.
      951   for each obj-list
      952   break
      953   by obj-list.obj-type
      954   by obj-list.obj-code
      955   :
      956   assign
      957   parhost-code = obj-list.obj-code
      958     .
      959   run write-log  in p-log-handle(
      960                                    input 0
      961                                  , "&DLine").
      962   run write-log-and-file in p-log-handle (
      963         input 1
      964       , input log-file-name
      965       , input 1
      966       , input substitute("»зменение атрибутов товара на фирме &1 по списку товаров", parhost-code)).
      967   assign
      968   num-rec = 0
      969   num-rec-ok = 0
      970   .
      971   _gds-list:
      972   for each gds-list No-LOCK
      973     ON ERROR undo, NEXT:
      974       num-rec = num-rec + 1.
      975       num-rec-all = num-rec-all + 1.
      976       v-ok = false.
      977       run check-actg in this-procedure (
      978                                          input gds-list.grp-code
      979                                         ,input gds-list.gds-code
      980                                         ,input parobj-code
      981                                         ,input parobj-type
      982                                         ,output v-ok )  no-error .
      983       if v-ok = true then do :
      984       run do-changes in this-procedure (
      985                                          input gds-list.gds-code
      986                                         ,input parhost-code
      987                                         ,input parobj-type
      988                                         ,input parobj-code
      989                                         ) no-error .
      990       end.
      991       if error-status:error then do:
      992         assign
      993         v-view-log = yes.
      994         run write-log-and-file in p-log-handle (
      995                   input 1
      996                 , input log-file-name
      997                 , input 1
      998                 , input return-value
      999                                             ).
     1000          if v-no-ask  then do:
     1001           run gbl/d-askw.w (
     1002                         input "»зменение атрибутов товара на фирме по списку товаров"
     1003                         ,input substitute("“овар с кодом &1 фирма &2 - не удалось провести изменение атрибутов товара на фирме"
     1004                                         , gds-list.gds-code
     1005                                         , parhost-code
     1006                                         )
     1007                         ,input "|"
     1008                         ,input ("ѕродолжить|" +
     1009                               "ѕродолжить и больше не запрашивать подтверждени€ на продолжение|" +
     1010                               "ѕрекратить")
     1011                         ,input "||"
     1012                         ,input 1
     1013                         ,input 3
     1014                         ,output v-choice).
     1015           if v-choice = 3 then do:
     1016             leave.
     1017           end.
     1018           if v-choice = 2 then do:
     1019             assign
     1020             v-no-ask = yes.
     1021           end.
     1022          end.
     1023       end.
     1024       else do:
     1025         num-rec-ok = num-rec-ok + 1.
     1026         num-rec-ok-all = num-rec-ok-all + 1.
     1027         if pardelete-ok and last(obj-list.obj-type) and last(obj-list.obj-code) then do:
     1028           delete gds-list.
     1029         end.
     1030       end.
     1031       run show-counter in p-log-handle .
     1032       run write-counter in p-log-handle (substitute("ќбработано по фирме &3 &1 из них успешно &2"
     1033                                                   , num-rec
     1034                                                   , num-rec-ok
     1035                                                   , parhost-code
     1036                                                   )) no-error.
     1037       run get-stop-state in p-log-handle (
     1038           output v-stop
     1039       ).
     1040       if v-stop then do:
     1041         leave _gds-list.
     1042       end.
     1043   END.
     1044   run write-log-and-file in p-log-handle (
     1045         input 1
     1046       , input log-file-name
     1047       , input 1
     1048       , input substitute("ѕакетное изменение атрибутов по фирме &3: из &1 товаров успешно изменено &2"
     1049                         , num-rec
     1050                         , num-rec-ok
     1051                         , parhost-code
     1052                         )).
     1053   end.
     1054   run write-log  in p-log-handle(
     1055                                    input 0
     1056                                  , "&DLine").
     1057   run write-log-and-file in p-log-handle (
     1058         input 1
     1059       , input log-file-name
     1060       , input 1
     1061       , input substitute("ѕакетное изменение атрибутов по списку товаров завершено:&3 из &1 успешно изменено &2"
     1062                          , num-rec-all
     1063                          , num-rec-ok-all
     1064                          , chr(10))).
     1065   .
     1066   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1067   if v-view-log
     1068   and not g#news
     1069   and not g#auto
     1070   then do:
     1071     message
     1072     '!!!ѕри изменении атрибутов товара на фирме по списку товаров произошли ошибки!!!'  skip
     1073     "!!!¬нимательно прочитайте Log-file!!"
     1074     view-as alert-box error .
     1075        define variable v-user-action10   as character no-undo .
     1076     define variable v-printed10       as logical   no-undo .
     1077     run gbl/prnfilen.w
     1078       (input  ('!!!ѕри изменении атрибутов товара на фирме по списку товаров произошли ошибки!!!')
     1079       ,input  0
     1080       ,input  (string("./":U) + 'ghatrlst.txt')
     1081       ,input  7
     1082       ,output v-user-action10
     1083       ,output v-printed10
     1084       ) .
     1085   end.
     1086   if v-view-log = true
     1087   and (g#news
     1088   or g#auto)
     1089   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     1090   then do:
     1091      run cb_set-view-log in p-parent-handle ( input yes).
     1092   end.
     1093   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
     1094     OS-DELETE value(string("./":U) + 'ghatrlst.txt').
     1095   end.
     1096   procedure do-changes :
     1097   define input parameter pargds-code like ub.gds-obj.gds-code no-undo .
     1098   define input parameter parhost-code like ub.sysconf.host-code no-undo .
     1099   define input parameter parobj-type like ub.clients.obj-type no-undo .
     1100   define input parameter parobj-code like ub.clients.obj-code no-undo .
     1101   DEFINE VARIABLE loc#log as logical no-undo .
     1102   DEFINE VARIABLE var-deleted as logical no-undo .
     1103       _main:
     1104     do
     1105     on error undo, return error
     1106     :
     1107       for each temp-attr no-lock
     1108           on error undo _main, return error:
     1109         CASE temp-attr.action:
     1110           when yes then do:
     1111             run gdshattr-write in this-procedure(
     1112                                                   input pargds-code,
     1113                                                   input parobj-type,
     1114                                                   input parobj-code,
     1115                                                   input temp-attr.attr-code,
     1116                                                   input temp-attr.attr-value
     1117                                                       )  no-error.
     1118             IF ERROR-STATUS:ERROR THEN DO:
     1119                 assign v-mes = substitute("товар с кодом &1, фирма &2: ошибка при записи атрибута товара на фирме &3&4:&5 &6&4"  +                    "ќбратитесь к администратору системы"                     , gds-list.gds-code                    , parhost-code                            , temp-attr.attr-value                    , chr(10)                        , error-status:get-message(1)                    , return-value ).
     1120                 undo _main, return error v-mes.
     1121             END.
     1122           end.
     1123           when no then do:
     1124             var-deleted = no.
     1125             run gdshattr-delete in this-procedure(
     1126                                                   input pargds-code,
     1127                                                   input parobj-type,
     1128                                                   input parobj-code,
     1129                                                   input temp-attr.attr-code,
     1130                                                   output var-deleted
     1131                                                       )  no-error.
     1132             IF ERROR-STATUS:ERROR THEN DO:
     1133                 assign v-mes = substitute("товар с кодом &1, фирма &2: ошибка при удалении атрибута товара на фирме &3&4:&5 &6&4"  +                    "ќбратитесь к администратору системы"                     , gds-list.gds-code                    , parhost-code                            , temp-attr.attr-value                    , chr(10)                        , error-status:get-message(1)                    , return-value ).
     1134                 undo _main, return error v-mes.
     1135             END.
     1136           end.
     1137         END CASE.
     1138       end.
     1139     end.
     1140   end procedure.
     1141   procedure check-actg :
     1142   define input parameter p-grp-code as integer no-undo.
     1143   define input parameter p-gds-code as integer no-undo.
     1144   define input parameter p-obj-code as integer no-undo.
     1145   define input parameter p-obj-type as character no-undo.
     1146   define output parameter p-ok as logical no-undo.
     1147   define variable glog as logical no-undo.
     1148   do
     1149   on error undo, return error
     1150   :
     1151   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1152     run mainmenu_getcntxt in parparentproc
     1153       (output v-cntxt-db-num
     1154       ,output v-cntxt-userid
     1155       ,output v-cntxt-level
     1156       ,output v-cntxt-host-code-obj
     1157       ,output v-cntxt-obj-type
     1158       ,output v-cntxt-obj-code
     1159       ,output v-cntxt-db-num-obj
     1160       ,output v-cntxt-is-admin
     1161       ) .
     1162   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1163   do:
     1164     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1165       (input  v-cntxt-db-num
     1166       ,input  v-cntxt-userid
     1167       ,input  0
     1168       ,input  'actn_reference_update':U
     1169       ,input  'global':U
     1170       ,input  0
     1171       ,input  '':U
     1172       ,input  0
     1173       ,input  0
     1174       ,input  p-grp-code
     1175       ,input  0
     1176       ,input  false
     1177       ,output glog
     1178       )  .
     1179   end.
     1180       if glog then do:
     1181         assign
     1182           p-ok = true.
     1183       end.
     1184       else do :
     1185         find first gds-grp no-lock
     1186              where gds-grp.node-code = p-grp-code no-error.
     1187         v-mes = substitute("товар с кодом &1, &2&3: ” вас отсутствует глобальное право на изменение товара в прив€зке к группе товаров &4"
     1188                      , p-gds-code
     1189                      , p-obj-type
     1190                      , p-obj-code
     1191                      , (string(gds-grp.node-code) + " " + gds-grp.node-name)
     1192                       ).
     1193         undo,return error v-mes.
     1194       end.
     1195   end.
     1196   end procedure.
