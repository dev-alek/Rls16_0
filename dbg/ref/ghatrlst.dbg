      323   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      324   FUNCTION CIntBinS RETURNS CHARACTER(input vl_int as integer):
      325   def var vl_bin as char no-undo init "".
      326   if vl_int < 0 OR vl_int = ? then return ?.
      327   do while vl_int > 0:
      328     assign
      329     vl_bin = (if vl_int modulo 2 = 0
      330                 then "0":U
      331                 else "1":U) + vl_bin
      332     vl_int = truncate(vl_int / 2,0).
      333   end.
      334   return fill( "0":U, 32 - length(vl_bin)) + vl_bin .
      335   END FUNCTION.
      336   FUNCTION BinMask RETURNS LOGICAL(input vl_int as integer,
      337                                    input vl_binm as character):
      338   DEFINE VARIABLE vl_bin as character no-undo.
      339   DEFINE VARIABLE ii as integer no-undo.
      340   DEFINE VARIABLE ii-len as integer no-undo.
      341   DEFINE VARIABLE ii-lenm as integer no-undo.
      342   DEFINE VARIABLE mchar as character no-undo.
      343   DEFINE VARIABLE ichar as character no-undo.
      344   if vl_binm = ? then return ?.
      345   vl_bin = CIntBinS(vl_int).
      346   if vl_bin = ? then return ?.
      347   assign
      348   vl_binm = LEFT-TRIM(vl_binm, "X":U)
      349   ii-lenm = LENGTH(vl_binm)
      350   ii-len = LENGTH(vl_bin) - ii-lenm
      351   .
      352   if II-LENM > 32 THEN RETURN ?.
      353   DO II = 1 to II-LENm:
      354     assign
      355     mchar = SUBSTR(vl_binm, ii, 1)
      356     ichar = SUBSTR(vl_bin, ii + ii-len, 1)
      357     .
      358     IF not (MCHAR = "0":u or MCHAR = "1":u or MCHAR = "X":u) then return ?.
      359     IF ichar <> mchar AND mchar <> "X":U then return no.
      360   END.
      361   return yes.
      362   END FUNCTION.
      363   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      364   define SHARED temp-table temp-attr no-undo
      365   field attr-code like ub.gds-obj-attr.attr-code
      366   field attr-value like ub.gds-obj-attr.attr-value
      367   field host-code as integer
      368   field obj-type as character
      369   field obj-code as integer
      370   field user-can-edit as log
      371   field code as char
      372   field action as logical
      373   field other-inf as character
      374   index pi is  unique primary
      375   attr-code host-code obj-type obj-code ASCENDING
      376   index action
      377   action
      378   .
      379   procedure tempattr-value :
      380    do
      381     on error undo, return error
      382     :
      383       define input  parameter p-code     like ub.gds-obj-attr.attr-code  no-undo .
      384       define input  parameter p-host-code as integer no-undo .
      385       define input  parameter p-obj-type as character no-undo .
      386       define input  parameter p-obj-code as integer no-undo .
      387       define input  parameter p-mode      as character no-undo .
      388       define output parameter p-value    like ub.gds-obj-attr.attr-value no-undo .
      389       define output parameter p-type     as character no-undo .
      390       define buffer buf_temp-attr for temp-attr .
      391       define variable v-format         as character no-undo .
      392       define variable v-label          as character no-undo .
      393       define variable v-user-can-edit  as logical   no-undo .
      394       define variable v-output-display as logical   no-undo .
      395       define variable v-other          as character no-undo .
      396       define variable v-range          as integer   no-undo .
      397       define variable jj               as integer   no-undo .
      398       define variable v-spr            as logical   no-undo .
      399       define variable v-spr-name       as character no-undo .
      400       define variable v-spr-param      as character no-undo .
      401       define variable v-setted         as logical   no-undo .
      402       case var-object:
      403         when 'gds-obj-attr':U
      404         then do:
      405           run gdsoattr-name in this-procedure
      406             (input  p-code
      407             ,output p-type
      408             ,output v-format
      409             ,output v-label
      410             ,output v-user-can-edit
      411             ,output v-output-display
      412             ,output v-other
      413             ) no-error .
      414         end.
      415         when 'gds-host-attr':U
      416         then do:
      417           run gdshattr-name in this-procedure
      418             (input  p-code
      419             ,output p-type
      420             ,output v-format
      421             ,output v-label
      422             ,output v-user-can-edit
      423             ,output v-output-display
      424             ,output v-other
      425             ) no-error .
      426         end.
      427         when 'clients-attr':U
      428         then do:
      429           run clntattr-code in this-procedure
      430             (input  p-code
      431             ,output p-type
      432             ,output v-format
      433             ,output v-label
      434             ,output v-user-can-edit
      435             ,output v-output-display
      436             ,output v-other
      437             ) no-error .
      438         end.
      439         when 'goods-attr':U
      440         then do:
      441           run gds-attr-name in this-procedure
      442             (input  p-code
      443             ,output p-type
      444             ,output v-format
      445             ,output v-label
      446             ,output v-user-can-edit
      447             ,output v-output-display
      448             ,output v-other
      449             ) no-error .
      450         end.
      451         otherwise do:
      452           undo, return error .
      453         end.
      454       end case.
      455       if error-status :error
      456       then do:
      457         undo, return error return-value .
      458       end.
      459       if v-user-can-edit
      460       then do:
      461         do jj = 1 to num-entries(v-other, chr(47)):
      462           if entry(1, entry(jj, v-other, chr(47)), "=":U) = "spr":U then do:
      463             assign
      464             v-spr-name = entry(2, entry(jj, v-other, chr(47)), "=":U)
      465             .
      466           end.
      467           if entry(1, entry(jj, v-other, chr(47)), "=":U) = "spr-param":U then do:
      468             assign
      469             v-spr-param = entry(2, entry(jj, v-other, chr(47)), "=":U)
      470             .
      471           end.
      472        end.
      473         if v-spr-name <> "":U then do:
      474           if p-mode = "change":U
      475           then do:
      476             find first buf_temp-attr no-lock where
      477                       buf_temp-attr.attr-code = p-code
      478                   and buf_temp-attr.host-code = p-host-code
      479                   and buf_temp-attr.obj-type = p-obj-type
      480                   and buf_temp-attr.obj-code = p-obj-code
      481               no-error .
      482             if avail buf_temp-attr then do:
      483               assign
      484                 p-value =  buf_temp-attr.attr-value
      485               .
      486             end.
      487             else do:
      488               assign
      489                 p-value = if p-type = 'L':U then "no":U else ""
      490               .
      491             end.
      492           end.
      493           CASE var-object:
      494             when 'gds-obj-attr':U then do:
      495               if v-spr-param = "":U then do:
      496                 run value (
      497                             v-spr-name)
      498                             in this-procedure (
      499                                                   input 0
      500                                                 ,input parobj-type
      501                                                 ,input parobj-code
      502                                                 ,input-output p-value
      503                                                 ,output v-setted) no-error .
      504               end.
      505               else do:
      506                 run value (
      507                             v-spr-name)
      508                             in this-procedure (
      509                                                   input 0
      510                                                 ,input parobj-type
      511                                                 ,input parobj-code
      512                                                 ,input v-spr-param
      513                                                 ,input-output p-value
      514                                                 ,output v-setted) no-error .
      515               end.
      516               if error-status :error then do:
      517                 undo, return error "Ќеизвестный справочник дл€ получени€ значени€ атрибут товара на объекте" + " " + p-code .
      518               end.
      519             end.
      520             when 'clients-attr':U then do:
      521             if v-spr-param = "":U then do:
      522               run   value ( v-spr-name ) in this-procedure
      523                   (  input 0
      524                     ,input parobj-type
      525                     ,input parobj-code
      526                     ,input-output p-value
      527                     ,output v-setted )
      528                     no-error .
      529             end.
      530             end.
      531             END CASE.
      532           if v-setted = no then do:
      533             return "not-set":U.
      534           end.
      535           assign
      536           v-spr = yes
      537           .
      538         end.
      539       end.
      540       if not v-spr then do:
      541         find first buf_temp-attr no-lock where
      542                   buf_temp-attr.attr-code = p-code
      543               and buf_temp-attr.host-code = p-host-code
      544               and buf_temp-attr.obj-type = p-obj-type
      545               and buf_temp-attr.obj-code = p-obj-code
      546           no-error .
      547         if avail buf_temp-attr then do:
      548           assign
      549             p-value =  buf_temp-attr.attr-value
      550           .
      551         end.
      552         else do:
      553           assign
      554             p-value = if p-type = 'L':U then "no":U else ""
      555           .
      556         end.
      557       end.
      558     end.
      559   end procedure.
      560   procedure tempattr-write :
      561     do
      562     on error undo, return error
      563     :
      564       define input parameter p-add      as logical no-undo .
      565       define input parameter p-code     like ub.gds-obj-attr.attr-code  no-undo .
      566       define input parameter p-host-code as integer no-undo .
      567       define input parameter p-obj-type as character no-undo .
      568       define input parameter p-obj-code as integer no-undo .
      569       define input parameter p-value    like ub.gds-obj-attr.attr-value no-undo .
      570       define input parameter p-action   like temp-attr.action no-undo .
      571       define buffer buf_temp-attr for temp-attr .
      572       define variable v-type           as character no-undo .
      573       define variable v-format         as character no-undo .
      574       define variable v-label          as character no-undo .
      575       define variable v-user-can-edit  as logical   no-undo .
      576       define variable v-output-display as logical   no-undo .
      577       define variable v-other          as character no-undo .
      578       define variable v-range          as integer   no-undo .
      579       define variable var-region  as character no-undo.
      580       DEFINE VARIABLE v-sel-vals as character no-undo .
      581       DEFINE VARIABLE v-sel-labels as character no-undo .
      582       define variable varhost-code like ub.sysconf.host-code no-undo.
      583       define variable varobj-type like ub.clients.obj-type no-undo.
      584       define variable varobj-code like ub.clients.obj-code no-undo.
      585       define variable choice as integer no-undo .
      586       case var-object:
      587         when 'gds-obj-attr':U
      588         then do:
      589           run gdsoattr-name in this-procedure
      590             (input  p-code
      591             ,output v-type
      592             ,output v-format
      593             ,output v-label
      594             ,output v-user-can-edit
      595             ,output v-output-display
      596             ,output v-other
      597             ) no-error .
      598         end.
      599         when 'gds-host-attr':U
      600         then do:
      601           run gdshattr-name in this-procedure
      602             (input  p-code
      603             ,output v-type
      604             ,output v-format
      605             ,output v-label
      606             ,output v-user-can-edit
      607             ,output v-output-display
      608             ,output v-other
      609             ) no-error .
      610         end.
      611         when 'clients-attr':U
      612         then do:
      613           run clntattr-code in this-procedure
      614             (input  p-code
      615             ,output v-type
      616             ,output v-format
      617             ,output v-label
      618             ,output v-user-can-edit
      619             ,output v-output-display
      620             ,output v-other
      621             ) no-error .
      622         end.
      623         when 'goods-attr':U
      624         then do:
      625           run gds-attr-name in this-procedure
      626             (input  p-code
      627             ,output v-type
      628             ,output v-format
      629             ,output v-label
      630             ,output v-user-can-edit
      631             ,output v-output-display
      632             ,output v-other
      633             ) no-error .
      634         end.
      635         otherwise do:
      636           undo, return error .
      637         end.
      638       END CASE.
      639       if error-status :error then do:
      640         undo, return error return-value .
      641       end.
      642       if not v-user-can-edit then do:
      643         message
      644         "«апрещено редактировать атрибут" v-label
      645         view-as alert-box error .
      646         undo, return error.
      647       end.
      648       find first buf_temp-attr exclusive-lock where
      649                  buf_temp-attr.attr-code = p-code
      650               and buf_temp-attr.host-code = p-host-code
      651               and buf_temp-attr.obj-type = p-obj-type
      652               and buf_temp-attr.obj-code = p-obj-code no-error .
      653       if not available buf_temp-attr then do:
      654         create buf_temp-attr .
      655         assign
      656           buf_temp-attr.attr-code = p-code
      657           buf_temp-attr.host-code = p-host-code
      658           buf_temp-attr.obj-type = p-obj-type
      659           buf_temp-attr.obj-code = p-obj-code
      660           buf_temp-attr.attr-value = p-value
      661           buf_temp-attr.action = p-action
      662           buf_temp-attr.code = v-label
      663           buf_temp-attr.other-inf = v-other
      664           no-error
      665         .
      666       end.
      667       ELSE
      668       ASSIGN
      669       buf_temp-attr.attr-value = p-value no-error.
      670     end.
      671   end procedure.
