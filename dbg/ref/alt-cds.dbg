        1   DEFINE TEMP-TABLE alt-code NO-UNDO LIKE ub.bar-code
        2          field price-sale like ub.price-list.price-sale
        3          field d-pcnt like ub.price-list.d-pcnt
        4          field dtl-name as char
        5          field rid as recid
        6          field doc-num like ub.price-doc.doc-num
        7          .
        8   define input     parameter parparentproc  as widget-handle no-undo.
        9   define input parameter p-obj-type like ub.clients.obj-type no-undo .
       10   define input parameter p-obj-code like ub.clients.obj-code no-undo .
       11   define input parameter mode       as character             no-undo.
       12   define input parameter g-code     like ub.goods.gds-code  no-undo.
       13   define input parameter base-bc    like ub.bar-code.b-code no-undo.
       14   define output parameter rec-list  as character             no-undo.
       15   define variable vss-revision    as character no-undo init "$Revision$":U .
       16   define variable vss-author      as character no-undo init "$Author$":U .
       17   define variable vss-date        as character no-undo init "$Date$":U .
       18   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       19   define variable vss-archive     as character no-undo init "$Archive$":U .
       20   define variable vss-description as character no-undo init "Список неосновных кодов".
       21   procedure vss-get-info :
       22     define output parameter p-vss-revision    like vss-revision    no-undo .
       23     define output parameter p-vss-author      like vss-author      no-undo .
       24     define output parameter p-vss-date        like vss-date        no-undo .
       25     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       26     define output parameter p-vss-archive     like vss-archive     no-undo .
       27     define output parameter p-vss-description like vss-description no-undo .
       28     assign
       29       p-vss-revision    = vss-revision
       30       p-vss-author      = vss-author
       31       p-vss-date        = vss-date
       32       p-vss-workfile    = vss-workfile
       33       p-vss-archive     = vss-archive
       34       p-vss-description = vss-description
       35     .
       36   end procedure.
       37   procedure vss-get-parameters :
       38     define output parameter p-vss-parameters as character no-undo .
       39   end procedure.
       40   define new global shared variable g#vssrevis-logger as handle    no-undo .
       41   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       42   define variable v-vssrevis-logger                   as handle    no-undo .
       43   procedure vss-logevent :
       44     define input  parameter p-extra-paramters as character no-undo .
       45     define variable v-vssrevis-parameters as character no-undo .
       46     do
       47     on error undo, return error return-value
       48     :
       49       if  valid-handle(v-vssrevis-logger)
       50       and v-vssrevis-logger :get-signature("logevent") <> ""
       51       then do:
       52         run vss-get-parameters in this-procedure
       53           (output v-vssrevis-parameters
       54           ).
       55         run logevent in v-vssrevis-logger
       56           (input vss-workfile
       57           ,input vss-revision
       58           ,input v-vssrevis-parameters
       59           ,input p-extra-paramters
       60           ).
       61       end.
       62     end.
       63   end procedure.
       64   assign
       65     v-vssrevis-logger = g#vssrevis-logger
       66   .
       67   if  valid-handle(v-vssrevis-logger)
       68   and v-vssrevis-logger :get-signature("logevent") <> ""
       69   then do:
       70     assign
       71       v-vssrevis-logevent = true
       72     .
       73     run vss-logevent in this-procedure (input vss-description) .
       74   end.
       75   define new global shared variable g#language as character no-undo .
       76   if g#language <> '' and g#language <> 'rus':U then do:
       77     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       78   end.
       79   define new global shared variable g#library  as handle no-undo .
       80   define new global shared variable g#library2 as handle no-undo .
       81   define   shared variable g#auto as logical no-undo.
       82   define   shared variable g#news as logical no-undo.
       83   define   shared variable g#oxml as logical no-undo.
       84   define   shared variable g#esys as logical no-undo.
       85   define   shared variable g#news-source-db as integer no-undo.
       86   define   shared variable g#esys-source-esys as integer no-undo.
       87   define   shared variable g#db-num as integer   no-undo .
       88   define   shared variable g#userid as character no-undo .
       89   define   shared variable g#passwd as character no-undo .
       90   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91     define variable v-cntxt-db-num        as integer   no-undo .
       92     define variable v-cntxt-userid        as character no-undo .
       93     define variable v-cntxt-level         as character no-undo .
       94     define variable v-cntxt-host-code-obj as integer   no-undo .
       95     define variable v-cntxt-obj-type      as character no-undo .
       96     define variable v-cntxt-obj-code      as integer   no-undo .
       97     define variable v-cntxt-db-num-obj    as integer   no-undo .
       98     define variable v-cntxt-is-admin      as logical   no-undo .
       99   procedure proc-alt-shift-f2:
      100     if not ibs.th.gbl.gbl-var:rcode
      101   then
      102     run gbl\inidebug.p .
      103   end.
      104   procedure proc-alt-shift-f3:
      105     run gbl/prvssinf.p
      106       ( input this-procedure
      107       ) .
      108   end.
      109   define variable v-inform-launched as logical no-undo initial false .
      110   procedure proc-alt-shift-f4:
      111     define variable v-action as character no-undo .
      112     if v-inform-launched = false then do:
      113       assign
      114         v-inform-launched = true
      115       .
      116       run gbl/d-inform.w
      117         (  input self
      118         ,  input this-procedure
      119         , output v-action
      120         ) no-error .
      121       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      122       assign
      123         v-inform-launched = false
      124       .
      125     end.
      126   end.
      127   procedure proc-alt-f1:
      128     run gbl/corrhelp.p
      129       (input this-procedure
      130       ) .
      131   end .
      132   on alt-shift-f2 anywhere do:
      133     run proc-alt-shift-f2.
      134   end.
      135   on alt-shift-f3 anywhere do:
      136     run proc-alt-shift-f3 in this-procedure .
      137   end.
      138   on alt-shift-f4 anywhere do:
      139     run proc-alt-shift-f4 in this-procedure.
      140   end.
      141   on alt-f1 anywhere do:
      142     run proc-alt-f1 in this-procedure .
      143   end.
      144   define buffer base-bar-code for ub.bar-code.
      145   define variable mark as char  no-undo.
      146   define variable rid  as recid no-undo.
      147   define variable glog as logical no-undo .
      148   FUNCTION stts-string RETURNS CHARACTER ( p-stts_ as integer):
      149   define variable dops as character no-undo.
      150   assign dops = entry (lookup (string(p-stts_), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
      151   RETURN dops.
      152   END FUNCTION.
      153   FUNCTION get-cr-db-num RETURNS INTEGER
      154     ( input p-b-code AS INTEGER, INPUT p-cr-db-num AS INTEGER)  FORWARD.
      155   FUNCTION get-mark RETURNS CHARACTER
      156     (local-rid as recid)  FORWARD.
      157   DEFINE BUTTON b-add
      158        LABEL "&Добавить"
      159        SIZE 15 BY 1.
      160   DEFINE BUTTON b-help
      161        LABEL "Помо&щь"
      162        SIZE 3 BY 1
      163        BGCOLOR 8 .
      164   DEFINE BUTTON b-mark
      165        LABEL "&*"
      166        SIZE 7.5 BY 1.
      167   DEFINE BUTTON b-prod
      168        LABEL "Д&оп. коды"
      169        SIZE 15 BY 1.
      170   DEFINE BUTTON b-quit AUTO-GO
      171        LABEL "&Выход"
      172        SIZE 15 BY 1
      173        BGCOLOR 8 .
      174   DEFINE BUTTON b-sel AUTO-GO
      175        LABEL "Вы&бор"
      176        SIZE 15 BY 1
      177        BGCOLOR 8 .
      178   DEFINE QUERY br-cds FOR
      179         alt-code SCROLLING.
      180   DEFINE BROWSE br-cds
      181     QUERY br-cds DISPLAY
      182         get-mark (alt-code.rid) @ mark format "x(1)"  column-label "*"
      183         alt-code.b-code                               column-label "Код"
      184         alt-code.cli-base-rate                        column-label "Коэф"
      185         alt-code.d-pcnt                               column-label "Скидка"
      186         alt-code.price-sale                           column-label "Цена"
      187         alt-code.unit-cli                             column-label "Изм"
      188         alt-code.dtl-name              format "x(34)" column-label "Привязка"
      189         alt-code.doc-num                              column-label "Переоценка"
      190         stts-string(alt-code.stts_) COLUMN-LABEL "Статус" FORMAT "X(10)"
      191         get-cr-db-num(alt-code.b-code, alt-code.cr-db-num) FORMAT ">>>>9" column-label "Создан (БД)"
      192       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.88 BY 14.13.
      193   DEFINE FRAME d-alt-cds
      194        b-quit AT ROW 1 COL 1
      195        b-sel AT ROW 1 COL 16
      196        b-mark AT ROW 1 COL 31
      197        b-add AT ROW 1 COL 38.5
      198        b-prod AT ROW 1 COL 53.5
      199        b-help AT ROW 1 COL 95
      200        br-cds AT ROW 2.37 COL 1.1
      201        SPACE(0.50) SKIP(0.45)
      202       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      203            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      204            TITLE "Список неосновных кодов:    "
      205            DEFAULT-BUTTON b-quit CANCEL-BUTTON b-quit.
      206   ASSIGN
      207          FRAME d-alt-cds:SCROLLABLE       = FALSE.
      208   ON WINDOW-CLOSE OF FRAME d-alt-cds
      209   DO:
      210     APPLY "END-ERROR":U TO SELF.
      211   END.
      212   ON CHOOSE OF b-add IN FRAME d-alt-cds
      213   DO:
      214   define variable v-prt-rec as recid no-undo .
      215   case mode:
      216     when "code-all"
      217     then do:
      218       run ref/bc-form.w
      219         (input  parparentproc
      220         ,input  'ДОБАВЛЕНИЕ':U
      221         ,input  base-bc
      222         ,input-output rid
      223         ).
      224     end.
      225     when "scl-gds-all"
      226     then do:
      227       define variable v-sel-node-code as integer   no-undo .
      228       run str/prt-ref.w
      229         (input  parparentproc
      230         ,input  ub.goods.gds-code
      231         ,input  'ПРОСМОТР':U
      232         ,input  p-obj-type
      233         ,input  p-obj-code
      234         ,input  ""
      235         ,input  ""
      236         ,output v-sel-node-code
      237         ) .
      238     end.
      239     when "par-gds-all"
      240     then do:
      241       define variable v-chk-act-host-code as integer   no-undo .
      242   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      243   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      244     (input  p-obj-type
      245     ,input  p-obj-code
      246     ,output v-chk-act-host-code
      247     )  .
      248   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      249   do:
      250     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      251       (input  v-cntxt-db-num
      252       ,input  v-cntxt-userid
      253       ,input  0
      254       ,input  'actn_archive_cost':U
      255       ,input  'object':U
      256       ,input  v-chk-act-host-code
      257       ,input  p-obj-type
      258       ,input  p-obj-code
      259       ,input  0
      260       ,input  0
      261       ,input  0
      262       ,input  true
      263       ,output glog
      264       )  .
      265   end.
      266       if NOT glog then
      267         return no-apply .
      268       run str/parts-l.w
      269         (INPUT parparentproc
      270         ,input p-obj-type
      271         ,input p-obj-code
      272         ,input goods.gds-code
      273         ,input ""
      274         ,input 'ПРОСМОТР':U
      275         ,input 'остатки':U
      276         ,input 'текущий':U
      277         ,input 'справочник':U
      278         ,output v-prt-rec
      279         ) .
      280     end.
      281     otherwise do:
      282       message
      283         "Для данного режима добавление не работает."
      284         view-as alert-box.
      285       return no-apply.
      286     end.
      287   end case.
      288   run UI-on.
      289   END.
      290   ON CHOOSE OF b-mark IN FRAME d-alt-cds
      291   DO:
      292   if not available alt-code then  return no-apply.
      293   define variable v-num-entry3 as integer no-undo .
      294   assign
      295     v-num-entry3 = lookup(string( alt-code.rid ), rec-list ).
      296   if v-num-entry3 > 0 then do:
      297     assign
      298       entry(v-num-entry3, rec-list) = "":U
      299       rec-list = replace( rec-list, chr(44) + chr(44), chr(44)) .
      300     REC-LIST = TRIM(REC-LIST, chr(44)).
      301   end.
      302   else do:
      303     assign
      304     rec-list = rec-list + ( if rec-list = "":U then "":U else chr(44) ) + string( alt-code.rid) .
      305   end.
      306   br-cds :refresh ().
      307   if last-event :function <> "mouse-select-dblclick" then
      308     br-cds :select-next-row ().
      309   apply "entry" to br-cds in frame d-alt-cds.
      310   END.
      311   ON CHOOSE OF b-prod IN FRAME d-alt-cds
      312   DO:
      313   def var rid-list as char no-undo.
      314   def var drc-list as char no-undo init ''.
      315   def var rid-nums as int  no-undo.
      316   if not available alt-code then
      317     return no-apply.
      318   do rid-nums = 1 to num-entries(rec-list, chr(44) ) :
      319       if not entry( rid-nums, rec-list, chr(44) ) begins "dk" then
      320       drc-list = drc-list + ( if drc-list = "":U then "":U else chr(44) ) + entry( rid-nums, rec-list, chr(44) ) .
      321   end.
      322   rec-list = drc-list .
      323   run ref/prod-cds.w (parparentproc, p-obj-type, p-obj-code,
      324                   "code-all", goods.gds-code, alt-code.b-code, output rid-list).
      325   if mode = "all-no-part-dk" then do:
      326       do rid-nums = 1 to num-entries(rid-list, chr(44) ) :
      327           rec-list = rec-list + ( if rec-list = "":U then "":U else chr(44) ) + "dk" + entry( rid-nums, rid-list, chr(44) ) .
      328       end.
      329   end.
      330   apply "entry" to br-cds in frame d-alt-cds.
      331   END.
      332   ON CHOOSE OF b-quit IN FRAME d-alt-cds
      333   DO:
      334     rec-list = ''.
      335   END.
      336   ON CHOOSE OF b-sel IN FRAME d-alt-cds
      337   DO:
      338   if rec-list = "" and
      339      available alt-code then
      340     rec-list = string (alt-code.rid).
      341   END.
      342   ON MOUSE-SELECT-DBLCLICK OF br-cds IN FRAME d-alt-cds
      343   DO:
      344   apply "choose" to b-mark in frame d-alt-cds.
      345   END.
      346   ON RETURN OF br-cds IN FRAME d-alt-cds
      347   DO:
      348   apply "choose" to b-mark in frame d-alt-cds.
      349   END.
      350   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      351   on CTRL-N, CTRL-Т of frame d-alt-cds anywhere do:
      352     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame d-alt-cds. END.
      353     return no-apply.
      354   end.
      355   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      356   on F2 of frame d-alt-cds anywhere do:
      357     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame d-alt-cds. END.
      358     return no-apply.
      359   end.
      360   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      361   on INS of frame d-alt-cds anywhere do:
      362     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame d-alt-cds. END.
      363     return no-apply.
      364   end.
      365   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-alt-cds:PARENT eq ?
      366   THEN FRAME d-alt-cds:PARENT = ACTIVE-WINDOW.
      367   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      368   on help of frame d-alt-cds
      369   do:
      370     run gbl/app_help.p
      371       (input this-procedure :file-name
      372       ,input ''
      373       ,input ?
      374       ) no-error.
      375     if error-status :error then do:
      376       message
      377         "Ошибка при вызове помощи"
      378         error-status :get-message(1)
      379         view-as alert-box .
      380     end.
      381   end.
      382   run minbtn-set in this-procedure .
      383   on choose of b-help in frame d-alt-cds
      384   do:
      385     apply "help":u to frame d-alt-cds .
      386   end.
      387   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      388   procedure minbtn-set :
      389       do
      390           on error undo, return error return-value
      391           :
      392           define variable ii              as integer       no-undo .
      393           define variable fh              as widget-handle no-undo .
      394           define variable hh              as widget-handle no-undo .
      395           define variable v-h             as handle        extent 4 no-undo .
      396           define variable v-name-button   as character     no-undo .
      397           define variable v-help-old-x    as decimal       no-undo .
      398           define variable v-help-old-y    as decimal       no-undo .
      399           define variable v-help-old-size as decimal       no-undo .
      400           define variable v-frame-width   as decimal       no-undo .
      401           define variable jj              as integer       no-undo .
      402           do
      403               on error undo, return error
      404               :
      405               assign
      406                   v-frame-width = frame d-alt-cds:width - 0.3
      407                   fh            = frame d-alt-cds:first-child
      408                   hh            = fh:first-child
      409                   ii            = 1
      410                   .
      411               do while valid-handle(hh):
      412                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      413                   do:
      414                       case lc(hh:name) :
      415                           when "b-help" then
      416                               do:
      417                                   hh:load-image-up("cmp/b-help.bmp":u) .
      418                                   hh:load-image-down("cmp/b-help.bmp":u) .
      419                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      420                                   hh:TOOLTIP = "Помощь" .
      421                                   v-help-old-x = hh:column .
      422                                   v-help-old-y = hh:row    .
      423                                   v-help-old-size = hh:width .
      424                                   hh:width-chars = 2.5 .
      425                               end.
      426                           when "b-print" then
      427                               do:
      428                                   hh:load-image("cmp/b-print.bmp":u) .
      429                                   hh:TOOLTIP = "Печать" .
      430                                   v-h[ii] = hh:handle .
      431                                   ii = ii + 1 .
      432                                   hh:width-chars = 3 .
      433                               end.
      434                           when "b-history" or
      435                           when "b-hist" then
      436                               do:
      437                                   hh:load-image("cmp/b-hist.bmp":u) .
      438                                   hh:TOOLTIP = "История" .
      439                                   v-h[ii] = hh:handle .
      440                                   ii = ii + 1 .
      441                                   hh:width-chars = 3 .
      442                               end.
      443                           when "b-sch" then
      444                               do:
      445                                   hh:load-image("cmp/b-sch.bmp":u) .
      446                                   hh:TOOLTIP = "Установка Фильтра" .
      447                                   v-h[ii] = hh:handle .
      448                                   ii = ii + 1 .
      449                                   hh:width-chars = 3 .
      450                               end.
      451                           when "b-hist-user" then
      452                               do:
      453                                   hh:load-image("cmp/b-hist.bmp":u) .
      454                                   hh:TOOLTIP = "История пользователя" .
      455                                   ii = ii + 1 .
      456                               end.
      457                       end case.
      458                   end.
      459                   hh = hh:next-sibling.
      460               end.
      461               b-help:column = v-frame-width - b-help:width-chars.
      462               jj = 0.
      463               repeat ii = 4 to 1 by -1 :
      464                   if valid-handle (v-h[ii] ) then
      465                   do:
      466                       jj  = jj + 1 .
      467                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      468                       v-h[ii]:row    = v-help-old-y .
      469                   end.
      470               end.
      471           end.
      472       end.
      473   end procedure.
      474   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      475   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      476   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      477   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      478   define variable v-diasize-current-frame-width  as decimal   no-undo .
      479   define variable v-diasize-current-frame-height as decimal   no-undo .
      480   define variable v-diasize-change-size          as logical   no-undo .
      481   define variable v-diasize-resize-button        as handle    no-undo .
      482   define variable v-diasize-wndmax               as logical   no-undo .
      483   define variable v-diasize-wndstore             as logical   no-undo .
      484   define variable v-diasize-proc-name            as character no-undo .
      485   define variable v-diasize-browse-handle        as handle    no-undo .
      486   define variable v-diasize-browse-number        as integer   no-undo .
      487   define variable v-diasize-need-full-display    as logical   no-undo init false .
      488   define temp-table temp-diasize-handle no-undo
      489     field handle-value  as handle
      490     field save-position as decimal
      491     index xpk is primary unique handle-value
      492     .
      493   define temp-table temp-browse-handle no-undo
      494     field browse-type   as character
      495     field browse-number as integer
      496     field browse-handle as handle
      497     field original-size as decimal
      498     index xpk is primary unique browse-type browse-number
      499     index xie browse-type browse-handle
      500   .
      501   procedure diasize_change-height :
      502     define input  parameter p-change-value  as decimal   no-undo .
      503     define input  parameter p-move-resize   as logical   no-undo .
      504     define variable v-field-group-handle    as handle    no-undo .
      505     define variable v-object-handle         as handle    no-undo .
      506     define variable v-frame-height          as decimal   no-undo .
      507     define variable v-frame-virtual-height  as decimal   no-undo .
      508     define variable v-browse-height         as decimal   no-undo .
      509     define variable v-window-height         as decimal   no-undo .
      510     define variable v-window-virtual-height as decimal   no-undo .
      511     define variable v-change-sign           as integer   no-undo .
      512     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      513     define buffer buf_temp-browse-handle  for temp-browse-handle .
      514     if p-change-value > 0
      515     then do:
      516       if frame d-alt-cds :height + p-change-value
      517           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      518       then do:
      519         assign
      520           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      521                           - (frame d-alt-cds :height-chars)
      522         .
      523         if p-change-value <= 0
      524         then do:
      525           run diasize_position-resize-button in this-procedure .
      526           return .
      527         end.
      528       end.
      529     end.
      530     if p-change-value < 0
      531     then do:
      532       if frame d-alt-cds :height + p-change-value < v-diasize-orig-frame-height
      533       then do:
      534         assign
      535           p-change-value = v-diasize-orig-frame-height
      536                          - (frame d-alt-cds :height-chars)
      537         .
      538         if p-change-value >= 0
      539         then do:
      540           run diasize_position-resize-button in this-procedure .
      541           return .
      542         end.
      543       end.
      544     end.
      545     if p-change-value >= 0
      546     then do:
      547       assign
      548         v-change-sign = 1
      549       .
      550     end.
      551     else do:
      552       assign
      553         v-change-sign = -1
      554       .
      555     end.
      556     assign
      557       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      558     .
      559     if p-change-value = 0
      560     then do:
      561       run diasize_position-resize-button in this-procedure .
      562       return .
      563     end.
      564     move_block:
      565     do
      566     on error undo move_block, retry move_block
      567     :
      568       if retry
      569       then do:
      570         do
      571         on error undo move_block, leave move_block
      572         :
      573           if p-change-value > 0
      574           then do:
      575             for each buf_temp-diasize-handle
      576             on error undo, next
      577             :
      578               assign
      579                 v-object-handle = buf_temp-diasize-handle.handle-value
      580               .
      581               if v-object-handle <> v-diasize-resize-button
      582               then do:
      583                 assign
      584                   v-object-handle :row = buf_temp-diasize-handle.save-position
      585                 .
      586               end.
      587             end.
      588             assign
      589               v-diasize-browse-handle :height = v-browse-height
      590             .
      591             for each buf_temp-browse-handle
      592               where buf_temp-browse-handle.browse-type = 'height':u
      593             on error undo, next
      594             :
      595               assign
      596                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      597               .
      598             end.
      599             assign
      600               frame d-alt-cds :height = v-frame-height
      601             .
      602             if frame d-alt-cds :scrollable = true
      603             then do:
      604               assign
      605                 frame d-alt-cds :virtual-height = v-frame-virtual-height
      606               .
      607             end.
      608             run diasize_position-resize-button in this-procedure .
      609           end.
      610           else do:
      611             if frame d-alt-cds :scrollable = true
      612             then do:
      613               assign
      614                 frame d-alt-cds :virtual-height = v-frame-virtual-height
      615               .
      616             end.
      617             assign
      618               frame d-alt-cds :height = v-frame-height
      619             .
      620             assign
      621               v-diasize-browse-handle :height = v-browse-height
      622             .
      623             for each buf_temp-browse-handle
      624               where buf_temp-browse-handle.browse-type = 'height':u
      625             on error undo, next
      626             :
      627               assign
      628                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      629               .
      630             end.
      631             for each buf_temp-diasize-handle
      632             on error undo, next
      633             :
      634               assign
      635                 v-object-handle = buf_temp-diasize-handle.handle-value
      636               .
      637               if v-object-handle <> v-diasize-resize-button
      638               then do:
      639                 assign
      640                   v-object-handle :row = buf_temp-diasize-handle.save-position
      641                 .
      642               end.
      643             end.
      644             run diasize_position-resize-button in this-procedure .
      645           end.
      646           assign
      647             v-diasize-change-size = false
      648           .
      649           leave move_block .
      650         end.
      651       end.
      652       assign
      653         v-diasize-need-full-display = true
      654       .
      655       if v-diasize-change-size = false
      656       then do:
      657         assign
      658           v-diasize-change-size = true
      659         .
      660       end.
      661       else do:
      662         return .
      663       end.
      664       assign
      665         v-frame-height = frame d-alt-cds :height
      666         v-frame-virtual-height = frame d-alt-cds :virtual-height
      667         v-browse-height = v-diasize-browse-handle :height
      668       .
      669       for each buf_temp-browse-handle
      670         where buf_temp-browse-handle.browse-type = 'height':u
      671       :
      672         assign
      673           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      674         .
      675       end.
      676       for each buf_temp-diasize-handle
      677       :
      678         delete buf_temp-diasize-handle .
      679       end.
      680       assign
      681         v-field-group-handle = frame d-alt-cds :first-child
      682       .
      683       do while valid-handle(v-field-group-handle)
      684       :
      685         assign
      686           v-object-handle = v-field-group-handle :first-child
      687         .
      688         do while valid-handle(v-object-handle)
      689         :
      690           if  v-object-handle <> v-diasize-browse-handle :handle
      691           and can-query(v-object-handle, "row")
      692           and can-query(v-object-handle, "height")
      693           and ( v-object-handle :row > v-diasize-browse-handle :row )
      694           then do:
      695             find first buf_temp-browse-handle
      696               where buf_temp-browse-handle.browse-type   = 'height':u
      697                 and buf_temp-browse-handle.browse-handle = v-object-handle
      698               no-error .
      699             if available buf_temp-browse-handle
      700             then do:
      701             end.
      702             else do:
      703               create buf_temp-diasize-handle .
      704               assign
      705                 buf_temp-diasize-handle.handle-value  = v-object-handle
      706                 buf_temp-diasize-handle.save-position = v-object-handle :row
      707               .
      708             end.
      709           end.
      710           assign
      711             v-object-handle = v-object-handle :next-sibling
      712           .
      713         end.
      714         assign
      715           v-field-group-handle = v-field-group-handle :next-sibling
      716         .
      717       end.
      718       do with frame d-alt-cds
      719       :
      720         hide v-diasize-resize-button .
      721         assign
      722           v-diasize-resize-button :row    = 1
      723           v-diasize-resize-button :column = 1
      724         .
      725       end.
      726       if p-change-value > 0
      727       then do:
      728         if frame d-alt-cds :scrollable = true
      729         then do:
      730           assign
      731             frame d-alt-cds :virtual-height = frame d-alt-cds :virtual-height + p-change-value
      732             no-error .
      733           if error-status :error
      734           or error-status :get-message(1) <> ""
      735           then do:
      736             undo move_block, retry move_block .
      737           end.
      738         end.
      739         assign
      740           frame d-alt-cds :height = frame d-alt-cds :height + p-change-value
      741           no-error .
      742         if error-status :error
      743         or error-status :get-message(1) <> ""
      744         then do:
      745           undo move_block, retry move_block .
      746         end.
      747         assign
      748           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      749           no-error .
      750         if error-status :error
      751         or error-status :get-message(1) <> ""
      752         then do:
      753           undo move_block, retry move_block .
      754         end.
      755         for each buf_temp-browse-handle
      756           where buf_temp-browse-handle.browse-type = 'height':u
      757         on error undo move_block, retry move_block
      758         :
      759           assign
      760             buf_temp-browse-handle.browse-handle :height
      761               = buf_temp-browse-handle.browse-handle :height + p-change-value
      762             no-error .
      763           if error-status :error
      764           or error-status :get-message(1) <> ""
      765           then do:
      766             undo move_block, retry move_block .
      767           end.
      768         end.
      769         for each buf_temp-diasize-handle
      770         on error undo move_block, retry move_block
      771         :
      772           assign
      773             v-object-handle = buf_temp-diasize-handle.handle-value
      774           .
      775           if v-object-handle <> v-diasize-resize-button
      776           then do:
      777             assign
      778               v-object-handle :row = v-object-handle :row + p-change-value
      779               no-error .
      780             if error-status :error
      781             or error-status :get-message(1) <> ""
      782             then do:
      783               undo move_block, retry move_block .
      784             end.
      785           end.
      786         end.
      787       end.
      788       else do:
      789         for each buf_temp-diasize-handle
      790         on error undo move_block, retry move_block
      791         :
      792           assign
      793             v-object-handle = buf_temp-diasize-handle.handle-value
      794           .
      795           if v-object-handle <> v-diasize-resize-button
      796           then do:
      797             assign
      798               v-object-handle :row = v-object-handle :row + p-change-value
      799               no-error .
      800             if error-status :error
      801             or error-status :get-message(1) <> ""
      802             then do:
      803               undo move_block, retry move_block .
      804             end.
      805           end.
      806         end.
      807         assign
      808           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      809           no-error .
      810         if error-status :error
      811         or error-status :get-message(1) <> ""
      812         then do:
      813           undo move_block, retry move_block .
      814         end.
      815         for each buf_temp-browse-handle
      816           where buf_temp-browse-handle.browse-type = 'height':u
      817         on error undo move_block, retry move_block
      818         :
      819           assign
      820             buf_temp-browse-handle.browse-handle :height
      821               = buf_temp-browse-handle.browse-handle :height + p-change-value
      822             no-error .
      823           if error-status :error
      824           or error-status :get-message(1) <> ""
      825           then do:
      826             undo move_block, retry move_block .
      827           end.
      828         end.
      829         assign
      830           frame d-alt-cds :height = frame d-alt-cds :height + p-change-value
      831           no-error .
      832         if error-status :error
      833         or error-status :get-message(1) <> ""
      834         then do:
      835           undo move_block, retry move_block .
      836         end.
      837         if frame d-alt-cds :scrollable = true
      838         then do:
      839           assign
      840             frame d-alt-cds :virtual-height = frame d-alt-cds :virtual-height + p-change-value
      841             no-error .
      842           if error-status :error
      843           or error-status :get-message(1) <> ""
      844           then do:
      845             undo move_block, retry move_block .
      846           end.
      847         end.
      848       end.
      849       if p-move-resize = true
      850       then do:
      851         run diasize_position-resize-button in this-procedure .
      852       end.
      853       if v-diasize-wndstore = true
      854       then do:
      855         if connected("ub") = true
      856         then do:
      857           define variable v-cntxt-db-num        as integer   no-undo .
      858           define variable v-cntxt-userid        as character no-undo .
      859           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      860                                             , OUTPUT v-cntxt-userid
      861                                             ) .
      862           run gbl/wndsizew.p
      863             (input  v-cntxt-db-num
      864             ,input  v-cntxt-userid
      865             ,input  v-diasize-proc-name
      866             ,input  'height':u
      867             ,input  string(frame d-alt-cds :height - v-diasize-orig-frame-height)
      868             ) .
      869         end.
      870       end.
      871     end.
      872     assign
      873       v-diasize-change-size = false
      874     .
      875   end procedure.
      876   procedure diasize_set-height :
      877     define input  parameter p-new-height  as decimal   no-undo .
      878     define input  parameter p-move-resize as logical   no-undo .
      879     do
      880     on error undo, return error return-value
      881     :
      882       run diasize_change-height in this-procedure
      883         (input  (p-new-height - frame d-alt-cds :height)
      884         ,input  p-move-resize
      885         ) .
      886     end.
      887   end procedure.
      888   procedure diasize_change-width :
      889     define input  parameter p-change-value as decimal   no-undo .
      890     define input  parameter p-move-resize  as logical   no-undo .
      891     define variable v-field-group-handle   as handle    no-undo .
      892     define variable v-object-handle        as handle    no-undo .
      893     define variable v-frame-width          as decimal   no-undo .
      894     define variable v-frame-virtual-width  as decimal   no-undo .
      895     define variable v-browse-width         as decimal   no-undo .
      896     define variable v-window-width         as decimal   no-undo .
      897     define variable v-window-virtual-width as decimal   no-undo .
      898     define variable v-change-sign          as integer   no-undo .
      899     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      900     define buffer buf_temp-browse-handle  for temp-browse-handle .
      901     if p-change-value > 0
      902     then do:
      903       if frame d-alt-cds :width + p-change-value >
      904           session :width-chars
      905       then do:
      906         assign
      907           p-change-value = session :width-chars - frame d-alt-cds :width
      908         .
      909         if p-change-value <= 0
      910         then do:
      911           run diasize_position-resize-button in this-procedure .
      912           return .
      913         end.
      914       end.
      915     end.
      916     if p-change-value < 0
      917     then do:
      918       if frame d-alt-cds :width + p-change-value < v-diasize-orig-frame-width
      919       then do:
      920         assign
      921           p-change-value = v-diasize-orig-frame-width
      922                          - frame d-alt-cds :width
      923         .
      924         if p-change-value >= 0
      925         then do:
      926           run diasize_position-resize-button in this-procedure .
      927           return .
      928         end.
      929       end.
      930     end.
      931     if p-change-value >= 0
      932     then do:
      933       assign
      934         v-change-sign = 1
      935       .
      936     end.
      937     else do:
      938       assign
      939         v-change-sign = -1
      940       .
      941     end.
      942     assign
      943       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      944     .
      945     if p-change-value = 0
      946     then do:
      947       run diasize_position-resize-button in this-procedure .
      948       return .
      949     end.
      950     move_block:
      951     do
      952     on error undo move_block, leave move_block
      953     :
      954       if retry
      955       then do:
      956         do
      957         on error undo move_block, leave move_block
      958         :
      959           if p-change-value > 0
      960           then do:
      961             for each buf_temp-diasize-handle
      962             on error undo, next
      963             :
      964               assign
      965                 v-object-handle = buf_temp-diasize-handle.handle-value
      966               .
      967               if v-object-handle <> v-diasize-resize-button
      968               then do:
      969                 assign
      970                   v-object-handle :col = buf_temp-diasize-handle.save-position
      971                 .
      972               end.
      973             end.
      974             assign
      975               v-diasize-browse-handle :width = v-browse-width
      976             .
      977             for each buf_temp-browse-handle
      978               where buf_temp-browse-handle.browse-type = 'width':u
      979             on error undo, next
      980             :
      981               assign
      982                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      983               .
      984             end.
      985             assign
      986               frame d-alt-cds :width = v-frame-width
      987             .
      988             if frame d-alt-cds :scrollable = true
      989             then do:
      990               assign
      991                 frame d-alt-cds :virtual-width = v-frame-virtual-width
      992               .
      993             end.
      994             run diasize_position-resize-button in this-procedure .
      995           end.
      996           else do:
      997             if frame d-alt-cds :scrollable = true
      998             then do:
      999               assign
     1000                 frame d-alt-cds :virtual-width = v-frame-virtual-width
     1001               .
     1002             end.
     1003             assign
     1004               frame d-alt-cds :width = v-frame-width
     1005             .
     1006             for each buf_temp-browse-handle
     1007               where buf_temp-browse-handle.browse-type = 'width':u
     1008             on error undo, next
     1009             :
     1010               assign
     1011                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1012               .
     1013             end.
     1014             assign
     1015               v-diasize-browse-handle :width = v-browse-width
     1016             .
     1017             for each buf_temp-diasize-handle
     1018             on error undo, next
     1019             :
     1020               assign
     1021                 v-object-handle = buf_temp-diasize-handle.handle-value
     1022               .
     1023               if v-object-handle <> v-diasize-resize-button
     1024               then do:
     1025                 assign
     1026                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1027                 .
     1028               end.
     1029             end.
     1030             run diasize_position-resize-button in this-procedure .
     1031           end.
     1032           assign
     1033             v-diasize-change-size = false
     1034           .
     1035           leave move_block .
     1036         end.
     1037       end.
     1038       assign
     1039         v-diasize-need-full-display = true
     1040       .
     1041       if v-diasize-change-size = false
     1042       then do:
     1043         assign
     1044           v-diasize-change-size = true
     1045         .
     1046       end.
     1047       else do:
     1048         return .
     1049       end.
     1050       assign
     1051         v-frame-width = frame d-alt-cds :width
     1052         v-frame-virtual-width = frame d-alt-cds :virtual-width
     1053         v-browse-width = v-diasize-browse-handle :width
     1054       .
     1055       for each buf_temp-browse-handle
     1056         where buf_temp-browse-handle.browse-type = 'width':u
     1057       :
     1058         assign
     1059           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1060         .
     1061       end.
     1062       for each buf_temp-diasize-handle
     1063       :
     1064         delete buf_temp-diasize-handle .
     1065       end.
     1066       assign
     1067         v-field-group-handle = frame d-alt-cds :first-child
     1068       .
     1069       do while valid-handle(v-field-group-handle)
     1070       :
     1071         assign
     1072           v-object-handle = v-field-group-handle :first-child
     1073         .
     1074         do while valid-handle(v-object-handle)
     1075         :
     1076           if  v-object-handle <> v-diasize-browse-handle :handle
     1077           and v-object-handle <> v-diasize-resize-button
     1078           and can-query(v-object-handle, "row")
     1079           and can-query(v-object-handle, "height")
     1080           and ( v-object-handle :col + v-object-handle :width
     1081                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1082               )
     1083           then do:
     1084             find first buf_temp-browse-handle
     1085               where buf_temp-browse-handle.browse-type   = 'width':u
     1086                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1087               no-error .
     1088             if available buf_temp-browse-handle
     1089             then do:
     1090             end.
     1091             else do:
     1092               create buf_temp-diasize-handle .
     1093               assign
     1094                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1095                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1096               .
     1097             end.
     1098           end.
     1099           assign
     1100             v-object-handle = v-object-handle :next-sibling
     1101           .
     1102         end.
     1103         assign
     1104           v-field-group-handle = v-field-group-handle :next-sibling
     1105         .
     1106       end.
     1107       do with frame d-alt-cds
     1108       :
     1109         hide v-diasize-resize-button .
     1110         v-diasize-resize-button :row = 1.
     1111         v-diasize-resize-button :column = 1.
     1112       end.
     1113       if p-change-value > 0
     1114       then do:
     1115         if frame d-alt-cds :scrollable = true
     1116         then do:
     1117           assign
     1118             frame d-alt-cds :virtual-width = frame d-alt-cds :virtual-width + p-change-value
     1119             no-error .
     1120           if error-status :error
     1121           or error-status :get-message(1) <> ""
     1122           then do:
     1123             undo move_block, retry move_block.
     1124           end.
     1125         end.
     1126         assign
     1127           frame d-alt-cds :width = v-frame-width + p-change-value
     1128           no-error .
     1129         if error-status :error
     1130         or error-status :get-message(1) <> ""
     1131         then do:
     1132           undo move_block, retry move_block.
     1133         end.
     1134         assign
     1135           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1136         no-error .
     1137         if error-status :error
     1138         or error-status :get-message(1) <> ""
     1139         then do:
     1140           undo move_block, retry move_block.
     1141         end.
     1142         for each buf_temp-browse-handle
     1143           where buf_temp-browse-handle.browse-type = 'width':u
     1144         on error undo move_block, retry move_block
     1145         :
     1146           assign
     1147             buf_temp-browse-handle.browse-handle :width
     1148               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1149             no-error .
     1150           if error-status :error
     1151           or error-status :get-message(1) <> ""
     1152           then do:
     1153             undo move_block, retry move_block .
     1154           end.
     1155         end.
     1156         for each buf_temp-diasize-handle
     1157         on error undo move_block, retry move_block
     1158         :
     1159           assign
     1160             v-object-handle = buf_temp-diasize-handle.handle-value
     1161           .
     1162           if v-object-handle <> v-diasize-resize-button
     1163           then do:
     1164             assign
     1165               v-object-handle :col = v-object-handle :col + p-change-value
     1166               no-error .
     1167             if error-status :error
     1168             or error-status :get-message(1) <> ""
     1169             then do:
     1170               undo move_block, retry move_block .
     1171             end.
     1172           end.
     1173         end.
     1174       end.
     1175       else do:
     1176         for each buf_temp-diasize-handle
     1177         on error undo move_block, retry move_block
     1178         :
     1179           assign
     1180             v-object-handle = buf_temp-diasize-handle.handle-value
     1181           .
     1182           if v-object-handle <> v-diasize-resize-button
     1183           then do:
     1184             assign
     1185               v-object-handle :col = v-object-handle :col + p-change-value
     1186               no-error .
     1187             if error-status :error
     1188             or error-status :get-message(1) <> ""
     1189             then do:
     1190               undo move_block, retry move_block .
     1191             end.
     1192           end.
     1193         end.
     1194         for each buf_temp-browse-handle
     1195           where buf_temp-browse-handle.browse-type = 'width':u
     1196         on error undo move_block, retry move_block
     1197         :
     1198           assign
     1199             buf_temp-browse-handle.browse-handle :width
     1200               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1201             no-error .
     1202           if error-status :error
     1203           or error-status :get-message(1) <> ""
     1204           then do:
     1205             undo move_block, retry move_block .
     1206           end.
     1207         end.
     1208         assign
     1209           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1210           no-error .
     1211         if error-status :error
     1212         or error-status :get-message(1) <> ""
     1213         then do:
     1214           undo move_block, retry move_block.
     1215         end.
     1216         assign
     1217           frame d-alt-cds :width = frame d-alt-cds :width + p-change-value
     1218         no-error .
     1219         if error-status :error
     1220         or error-status :get-message(1) <> ""
     1221         then do:
     1222           undo move_block, retry move_block.
     1223         end.
     1224         if frame d-alt-cds :scrollable = true
     1225         then do:
     1226           assign
     1227             frame d-alt-cds :virtual-width = frame d-alt-cds :virtual-width + p-change-value
     1228           no-error .
     1229           if error-status :error
     1230           or error-status :get-message(1) <> ""
     1231           then do:
     1232             undo move_block, retry move_block.
     1233           end.
     1234         end.
     1235       end.
     1236       if p-move-resize
     1237       then do:
     1238         run diasize_position-resize-button in this-procedure .
     1239       end.
     1240       if v-diasize-wndstore = true
     1241       then do:
     1242         if connected("ub") = true
     1243         then do:
     1244           define variable v-cntxt-db-num        as integer   no-undo .
     1245           define variable v-cntxt-userid        as character no-undo .
     1246           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1247                                             , OUTPUT v-cntxt-userid
     1248                                             ) .
     1249           run gbl/wndsizew.p
     1250             (input  v-cntxt-db-num
     1251             ,input  v-cntxt-userid
     1252             ,input  v-diasize-proc-name
     1253             ,input  'width':u
     1254             ,input  string(frame d-alt-cds :width - v-diasize-orig-frame-width)
     1255             ) .
     1256         end.
     1257       end.
     1258     end.
     1259     assign
     1260       v-diasize-change-size = false
     1261     .
     1262   end procedure.
     1263   procedure diasize_set-width :
     1264     define input  parameter p-new-width  as decimal   no-undo .
     1265     define input  parameter p-move-resize as logical   no-undo .
     1266     do
     1267     on error undo, return error return-value
     1268     :
     1269       run diasize_change-width in this-procedure
     1270         (input  (p-new-width - frame d-alt-cds :width)
     1271         ,input  p-move-resize
     1272         ) .
     1273     end.
     1274   end procedure.
     1275   procedure diasize_position-resize-button :
     1276     do with frame d-alt-cds
     1277     :
     1278       hide v-diasize-resize-button .
     1279       assign
     1280         v-diasize-resize-button :row = frame d-alt-cds :height - v-diasize-resize-button :height
     1281                     - 1
     1282                     - (frame d-alt-cds :border-bottom-pixels / session :pixels-per-row)
     1283         v-diasize-resize-button :col = frame d-alt-cds :width - v-diasize-resize-button :width
     1284                     - 1
     1285                     - (frame d-alt-cds :border-right-pixels / session :pixels-per-column)
     1286       .
     1287       view v-diasize-resize-button .
     1288     end.
     1289   end procedure.
     1290   on alt-right anywhere
     1291   do:
     1292     run diasize_change-width in this-procedure
     1293       (input 1
     1294       ,input true
     1295       ) .
     1296     return no-apply .
     1297   end.
     1298   on alt-left anywhere
     1299   do:
     1300     run diasize_change-width in this-procedure
     1301       (input -1
     1302       ,input true
     1303       ) .
     1304     return no-apply .
     1305   end.
     1306   on alt-down anywhere
     1307   do:
     1308     run diasize_change-height in this-procedure
     1309       (input 1
     1310       ,input true
     1311       ) .
     1312     return no-apply .
     1313   end.
     1314   on alt-up anywhere
     1315   do:
     1316     run diasize_change-height in this-procedure
     1317       (input -1
     1318       ,input true
     1319       ) .
     1320     return no-apply .
     1321   end.
     1322   on alt-enter of frame d-alt-cds
     1323   do:
     1324     run diasize_maximize in this-procedure
     1325       (input  ?
     1326       ).
     1327     return no-apply .
     1328   end.
     1329   procedure diasize_end-move :
     1330     do
     1331     on error undo, return error return-value
     1332     :
     1333       define variable v-row-delta as decimal   no-undo .
     1334       define variable v-col-delta as decimal   no-undo .
     1335       define variable v-new-row as decimal   no-undo .
     1336       define variable v-new-col as decimal   no-undo .
     1337       assign
     1338         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1339         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1340       .
     1341       assign
     1342         v-row-delta = v-new-row - frame d-alt-cds :height
     1343         v-col-delta = v-new-col - frame d-alt-cds :width
     1344       .
     1345       run diasize_change-height in this-procedure
     1346         (input v-row-delta
     1347         ,input true
     1348         ) .
     1349       run diasize_change-width in this-procedure
     1350         (input v-col-delta
     1351         ,input true
     1352         ) .
     1353     end.
     1354   end procedure.
     1355   procedure diasize_maximize :
     1356     define input  parameter p-action as logical   no-undo .
     1357     do
     1358     on error undo, return error return-value
     1359     :
     1360       if p-action = ?
     1361       then do:
     1362         if v-diasize-need-maximize = true
     1363         then do:
     1364           assign
     1365             p-action = true
     1366           .
     1367         end.
     1368         else do:
     1369           assign
     1370             p-action = false
     1371           .
     1372         end.
     1373       end.
     1374       if p-action = true
     1375       then do:
     1376         run diasize_change-height in this-procedure
     1377           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1378               - frame d-alt-cds :height-chars
     1379           ,input true
     1380           ) .
     1381         run diasize_change-width in this-procedure
     1382           (input session :width-chars
     1383               - frame d-alt-cds :width-chars
     1384           ,input true
     1385           ) .
     1386         assign
     1387           v-diasize-need-maximize = false
     1388         .
     1389       end.
     1390       else do:
     1391         run diasize_change-width in this-procedure
     1392           (input v-diasize-orig-frame-width
     1393               - frame d-alt-cds :width-chars
     1394           ,input true
     1395           ) .
     1396         run diasize_change-height in this-procedure
     1397           (input v-diasize-orig-frame-height
     1398               - frame d-alt-cds :height-chars
     1399           ,input true
     1400           ) .
     1401         assign
     1402           v-diasize-need-maximize = true
     1403         .
     1404       end.
     1405     end.
     1406   end procedure.
     1407   procedure diasize_restore-orig-size :
     1408     do
     1409     on error undo, return error return-value
     1410     :
     1411       assign
     1412         v-diasize-current-frame-width  = frame d-alt-cds :width
     1413         v-diasize-current-frame-height = frame d-alt-cds :height
     1414       .
     1415       run diasize_set-height in this-procedure
     1416         (input  v-diasize-orig-frame-height
     1417         ,input  true
     1418         ) .
     1419       run diasize_set-width in this-procedure
     1420         (input  v-diasize-orig-frame-width
     1421         ,input  true
     1422         ) .
     1423     end.
     1424   end procedure.
     1425   procedure diasize_restore-current-size :
     1426     do
     1427     on error undo, return error return-value
     1428     :
     1429       run diasize_set-height in this-procedure
     1430         (input  v-diasize-current-frame-height
     1431         ,input  true
     1432         ) .
     1433       run diasize_set-width in this-procedure
     1434         (input  v-diasize-current-frame-width
     1435         ,input  true
     1436         ) .
     1437     end.
     1438   end procedure.
     1439   procedure diasize_set-browse-handle :
     1440     define input  parameter p-browse-handle as handle   no-undo .
     1441     define buffer buf_temp-browse-handle for temp-browse-handle .
     1442     do
     1443     on error undo, return error return-value
     1444     :
     1445       assign
     1446         v-diasize-browse-handle = p-browse-handle
     1447       .
     1448       for each buf_temp-browse-handle
     1449       on error undo, return error return-value
     1450       :
     1451         delete buf_temp-browse-handle .
     1452       end.
     1453     end.
     1454   end procedure.
     1455   procedure diasize_add_browse :
     1456     define input  parameter p-browse-type   as character no-undo .
     1457     define input  parameter p-browse-handle as handle    no-undo .
     1458     define buffer buf_temp-browse-handle for temp-browse-handle .
     1459     do
     1460     on error undo, return error return-value
     1461     :
     1462       assign
     1463         v-diasize-browse-number = v-diasize-browse-number + 1
     1464       .
     1465       create buf_temp-browse-handle .
     1466       assign
     1467         buf_temp-browse-handle.browse-type   = p-browse-type
     1468         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1469         buf_temp-browse-handle.browse-handle = p-browse-handle
     1470       .
     1471     end.
     1472   end procedure.
     1473   procedure diasize_init :
     1474     define variable v-default-value    as logical   no-undo .
     1475     define variable v-restore-saved    as logical   no-undo .
     1476     define variable v-resize-value-str as character no-undo .
     1477     do
     1478     on error undo, return error return-value
     1479     :
     1480       do with frame d-alt-cds
     1481       :
     1482         assign
     1483           v-diasize-orig-frame-height = frame d-alt-cds :height
     1484           v-diasize-orig-frame-width  = frame d-alt-cds :width
     1485           v-diasize-browse-handle     = browse br-cds :handle
     1486         .
     1487         create button v-diasize-resize-button
     1488         assign
     1489           parent        = frame d-alt-cds :first-child
     1490           label         = "s"
     1491           height-pixels = 16
     1492           width-pixels  = 16
     1493           visible       = true
     1494           sensitive     = true
     1495           movable       = true
     1496           triggers:
     1497             on end-move persistent run diasize_end-move in this-procedure .
     1498           end triggers.
     1499         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1500         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1501         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1502         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1503         assign
     1504           v-diasize-wndmax = false
     1505         .
     1506         if connected("ub") = true
     1507         then do:
     1508           define variable v-cntxt-db-num        as integer   no-undo .
     1509           define variable v-cntxt-userid        as character no-undo .
     1510           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1511                                             , OUTPUT v-cntxt-userid
     1512                                             ) .
     1513           run gbl/wndpar_r.p
     1514             (input  v-cntxt-db-num
     1515             ,input  v-cntxt-userid
     1516             ,input  'wndmax':U
     1517             ,output v-diasize-wndmax
     1518             ,output v-default-value
     1519             ) .
     1520         end.
     1521         assign
     1522           v-diasize-wndstore = false
     1523         .
     1524         if connected("ub") = true
     1525         then do:
     1526           run gbl/wndpar_r.p
     1527             (input  v-cntxt-db-num
     1528             ,input  v-cntxt-userid
     1529             ,input  'wndstore':U
     1530             ,output v-diasize-wndstore
     1531             ,output v-default-value
     1532             ) .
     1533         end.
     1534         assign
     1535           v-diasize-proc-name = entry(1, program-name(2), '.')
     1536         .
     1537         if v-diasize-wndstore = true
     1538         then do:
     1539           assign
     1540             v-restore-saved = false
     1541           .
     1542           if connected("ub") = true
     1543           then do:
     1544             run gbl/wndsizer.p
     1545               (input  v-cntxt-db-num
     1546               ,input  v-cntxt-userid
     1547               ,input  v-diasize-proc-name
     1548               ,input  'height':u
     1549               ,output v-resize-value-str
     1550               ) .
     1551             if v-resize-value-str <> '':U
     1552             then do:
     1553               run diasize_change-height in this-procedure
     1554                 (input  integer(v-resize-value-str)
     1555                 ,input  true
     1556                 ) .
     1557               assign
     1558                 v-restore-saved = true
     1559               .
     1560             end.
     1561           end.
     1562           if connected("ub") = true
     1563           then do:
     1564             run gbl/wndsizer.p
     1565               (input  v-cntxt-db-num
     1566               ,input  v-cntxt-userid
     1567               ,input  v-diasize-proc-name
     1568               ,input  'width':u
     1569               ,output v-resize-value-str
     1570               ) .
     1571             if v-resize-value-str <> '':U
     1572             then do:
     1573               run diasize_change-width in this-procedure
     1574                 (input  integer(v-resize-value-str)
     1575                 ,input  true
     1576                 ) .
     1577               assign
     1578                 v-restore-saved = true
     1579               .
     1580             end.
     1581           end.
     1582           if v-restore-saved <> true
     1583           then do:
     1584             if v-diasize-wndmax = true
     1585             then do:
     1586               run diasize_maximize in this-procedure
     1587                 (input  true
     1588                 ) .
     1589             end.
     1590           end.
     1591         end.
     1592         else do:
     1593           if v-diasize-wndmax = true
     1594           then do:
     1595             run diasize_maximize in this-procedure
     1596               (input  true
     1597               ) .
     1598           end.
     1599         end.
     1600       end.
     1601     end.
     1602   end procedure.
     1603   procedure diasize_need-full-display :
     1604     define output parameter p-need-full-display as logical   no-undo .
     1605     do
     1606     on error undo, return error return-value
     1607     :
     1608       assign
     1609         p-need-full-display = v-diasize-need-full-display
     1610       .
     1611       assign
     1612         v-diasize-need-full-display = false
     1613       .
     1614     end.
     1615   end procedure.
     1616   procedure get-context :
     1617      define output parameter p-db-num as integer          no-undo.
     1618      define output parameter p-user-id as character        no-undo.
     1619      define variable v-login               as character    no-undo.
     1620      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1621      define buffer buf_user-login  for ub.user-login .
     1622      do
     1623      on error undo, return error
     1624      :
     1625            FIND FIRST buf_sys-ctrl no-lock.
     1626            ASSIGN
     1627               v-login = USERID("ub")
     1628               p-db-num = buf_sys-ctrl.db-num
     1629            .
     1630            FIND FIRST buf_user-login
     1631                 WHERE buf_user-login.db-num = p-db-num
     1632                   AND buf_user-login.user-login = v-login
     1633                 no-lock
     1634                 no-error
     1635                 .
     1636            IF AVAILABLE buf_user-login
     1637            THEN DO:
     1638               assign
     1639                  p-user-id = buf_user-login.user-id
     1640               .
     1641            END.
     1642      end.
     1643   end procedure.
     1644       run diasize_init in this-procedure .
     1645   MAIN-BLOCK:
     1646   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1647      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1648   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1649     run mainmenu_getcntxt in parparentproc
     1650       (output v-cntxt-db-num
     1651       ,output v-cntxt-userid
     1652       ,output v-cntxt-level
     1653       ,output v-cntxt-host-code-obj
     1654       ,output v-cntxt-obj-type
     1655       ,output v-cntxt-obj-code
     1656       ,output v-cntxt-db-num-obj
     1657       ,output v-cntxt-is-admin
     1658       ) .
     1659     find base-bar-code no-lock where
     1660          base-bar-code.b-code = base-bc.
     1661     find goods no-lock where
     1662          goods.gds-code = g-code.
     1663     RUN UI-on.
     1664     WAIT-FOR GO OF FRAME d-alt-cds.
     1665   END.
     1666   RUN disable_UI.
     1667   PROCEDURE cre-alt :
     1668   def var pr-rec   as   recid                  no-undo.
     1669   def var pr-c-b-r like ub.bar-code.cli-base-rate no-undo.
     1670   find ub.gds-prt no-lock where
     1671        ub.gds-prt.node-code = ub.bar-code.node-code.
     1672   if not ub.gds-prt.root and
     1673      not ub.gds-prt.is-term then
     1674     return.
     1675   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1676   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     1677     (input  p-obj-type
     1678     ,input  p-obj-code
     1679     ,input  ub.bar-code.b-code
     1680     ,input  0
     1681     ,input  0
     1682     ,output pr-rec
     1683     ,output pr-c-b-r
     1684     )  .
     1685   create alt-code.
     1686   buffer-copy ub.bar-code to alt-code
     1687     assign
     1688       alt-code.rid  = recid (bar-code)
     1689       .
     1690   if ub.gds-prt.upper-code = ub.goods.prt-root then
     1691     if ub.bar-code.in-code = "" then
     1692       alt-code.dtl-name = "".
     1693     else
     1694       if ub.bar-code.part-code = "" then
     1695         alt-code.dtl-name = ub.bar-code.in-code.
     1696       else
     1697         alt-code.dtl-name = ub.bar-code.in-code + " (" + ub.bar-code.part-code + ")".
     1698   else
     1699     alt-code.dtl-name = ub.gds-prt.f-name.
     1700   find  ub.price-list no-lock where
     1701         recid (ub.price-list) = pr-rec no-error.
     1702   if available ub.price-list and
     1703      ub.price-list.b-code = ub.bar-code.b-code then
     1704     assign
     1705       alt-code.price-sale = ub.price-list.price-sale
     1706       alt-code.d-pcnt     = ub.price-list.d-pcnt
     1707       alt-code.doc-num    = ub.price-list.doc-num
     1708       .
     1709   else
     1710     if lookup (mode, "code-current,scl-gds-current,par-gds-current") > 0 then
     1711       delete alt-code.
     1712     else
     1713       if available ub.price-list then
     1714         assign
     1715           alt-code.price-sale = ub.price-list.price-sale * ub.bar-code.cli-base-rate
     1716           alt-code.d-pcnt     = 0
     1717           alt-code.doc-num    = "-"
     1718           .
     1719       else
     1720         assign
     1721           alt-code.price-sale = ?
     1722           alt-code.d-pcnt     = ?
     1723           alt-code.doc-num    = ?
     1724           .
     1725   END PROCEDURE.
     1726   PROCEDURE disable_UI :
     1727     HIDE FRAME d-alt-cds.
     1728   END PROCEDURE.
     1729   PROCEDURE UI-on :
     1730   ENABLE b-quit b-sel b-mark b-help b-prod br-cds WITH FRAME d-alt-cds.
     1731   for each alt-code:
     1732     delete alt-code.
     1733   end.
     1734   case mode:
     1735     when "all-no-part" or when "all-no-part-dk" then do:
     1736       frame d-alt-cds :title = "Все имеющиеся основные и неосновные бар-коды:   " +
     1737                                    "Основной код: " + string (base-bc, ">>>>>>>>9")
     1738                                    .
     1739       for each ub.bar-code no-lock where
     1740                ub.bar-code.gds-code  = base-bar-code.gds-code:
     1741         if ub.bar-code.in-code   = base-bar-code.in-code and
     1742         ub.bar-code.part-code = base-bar-code.part-code then do:
     1743           run cre-alt.
     1744         end.
     1745       end.
     1746     end.
     1747     when "code-current" then do:
     1748       frame d-alt-cds :title = "Имеющиеся неосновные цены:   " +
     1749                                    "Основной код: " + string (base-bc, ">>>>>>>>9")
     1750                                    .
     1751       for each ub.bar-code no-lock where
     1752                ub.bar-code.gds-code  = base-bar-code.gds-code and
     1753                ub.bar-code.node-code = base-bar-code.node-code and
     1754                ub.bar-code.in-code   = base-bar-code.in-code and
     1755                ub.bar-code.part-code = base-bar-code.part-code and
     1756                ub.bar-code.unit-cli <> ub.goods.unit-base:
     1757         run cre-alt.
     1758       end.
     1759     end.
     1760     when "scl-gds-current" then do:
     1761       frame d-alt-cds :title = "Имеющиеся неосновные цены по признакам:   " +
     1762                                    "Товар: " + ub.goods.artic + "  " + ub.goods.gds-name
     1763                                    .
     1764       for each ub.bar-code no-lock where
     1765                ub.bar-code.gds-code  = base-bar-code.gds-code and
     1766                ub.bar-code.in-code   = "" and
     1767                ub.bar-code.unit-cli <> ub.goods.unit-base:
     1768         run cre-alt.
     1769       end.
     1770     end.
     1771     when "par-gds-current" then do:
     1772       frame d-alt-cds :title = "Имеющиеся неосновные цены по партиям:   " +
     1773                                    "Товар: " + ub.goods.artic + "  " + ub.goods.gds-name
     1774                                    .
     1775       for each ub.bar-code no-lock where
     1776                ub.bar-code.gds-code  = base-bar-code.gds-code and
     1777                ub.bar-code.in-code  <> "" and
     1778                ub.bar-code.unit-cli <> ub.goods.unit-base:
     1779         run cre-alt.
     1780       end.
     1781     end.
     1782     when "code-all" then do:
     1783       frame d-alt-cds :title = "Все неосновные коды:   " +
     1784                                    "Основной код: " + string (base-bc, ">>>>>>>>9")
     1785                                    .
     1786       for each ub.bar-code no-lock where
     1787                ub.bar-code.gds-code  = base-bar-code.gds-code and
     1788                ub.bar-code.node-code = base-bar-code.node-code and
     1789                ub.bar-code.in-code   = base-bar-code.in-code and
     1790                ub.bar-code.part-code = base-bar-code.part-code and
     1791                ub.bar-code.unit-cli <> ub.goods.unit-base:
     1792         run cre-alt.
     1793       end.
     1794       ENABLE b-add WITH FRAME d-alt-cds.
     1795     end.
     1796     when "scl-gds-all" then do:
     1797       frame d-alt-cds :title = "Все неосновные коды по признакам:   " +
     1798                                    "Товар: " + ub.goods.artic + "  " + ub.goods.gds-name
     1799                                    .
     1800       for each ub.bar-code no-lock where
     1801                ub.bar-code.gds-code  = base-bar-code.gds-code and
     1802                ub.bar-code.in-code   = "" and
     1803                ub.bar-code.unit-cli <> ub.goods.unit-base:
     1804         run cre-alt.
     1805       end.
     1806       ENABLE b-add WITH FRAME d-alt-cds.
     1807     end.
     1808     when "par-gds-all" then do:
     1809       frame d-alt-cds :title = "Все неосновные коды по партиям:   " +
     1810                                    "Товар: " + ub.goods.artic + "  " + ub.goods.gds-name
     1811                                    .
     1812       for each ub.bar-code no-lock where
     1813                ub.bar-code.gds-code  = base-bar-code.gds-code and
     1814                ub.bar-code.in-code  <> "" and
     1815                ub.bar-code.unit-cli <> ub.goods.unit-base:
     1816         run cre-alt.
     1817       end.
     1818       ENABLE b-add WITH FRAME d-alt-cds.
     1819     end.
     1820   end case.
     1821   frame d-alt-cds :title = frame d-alt-cds :title +
     1822                                "      Текущий объект: " + string (p-obj-type, "x(3)") +
     1823                                " " + string (p-obj-code, ">>>>9").
     1824   open query br-cds
     1825     for each alt-code no-lock.
     1826   END PROCEDURE.
     1827   FUNCTION get-cr-db-num RETURNS INTEGER
     1828     ( input p-b-code AS INTEGER, INPUT p-cr-db-num AS INTEGER) :
     1829     DEFINE BUFFER buf_code-range FOR ub.code-range.
     1830     IF p-cr-db-num <> ? THEN
     1831     RETURN p-cr-db-num.
     1832     FIND FIRST buf_code-range NO-LOCK WHERE
     1833               buf_code-range.first-code <= p-b-code
     1834          AND  buf_code-range.last-code >= p-b-code NO-ERROR.
     1835     IF AVAILABLE buf_code-range THEN RETURN buf_code-range.db-num.
     1836     RETURN ?.
     1837   END FUNCTION.
     1838   FUNCTION get-mark RETURNS CHARACTER
     1839     (local-rid as recid) :
     1840   if lookup (string (local-rid), rec-list) > 0 then
     1841     return "*".
     1842   else
     1843     return "".
     1844   END FUNCTION.
