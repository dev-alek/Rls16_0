      621                       end.
      622                       when chr(8)
      623                       then do:
      624                           assign
      625                               p-out-string = p-out-string + " ":U
      626                           .
      627                       end.
      628                       when chr(9)
      629                       then do:
      630                           assign
      631                               p-out-string = p-out-string + " ":U
      632                           .
      633                       end.
      634                       when chr(29)
      635                       then do:
      636                           assign
      637                               p-out-string = p-out-string + " ":U
      638                           .
      639                       end.
      640                       when chr(10)
      641                       then do:
      642                           assign
      643                               p-out-string = p-out-string + " ":U
      644                           .
      645                       end.
      646                       when chr(13)
      647                       then do:
      648                           assign
      649                               p-out-string = p-out-string + " ":U
      650                           .
      651                       end.
      652                       otherwise do:
      653                           assign
      654                               p-out-string = p-out-string + v-current-char
      655                           .
      656                       end.
      657                   end case.
      658               end.
      659           end.
      660       end case.
      661   end.
      662   end .
      663   procedure xmlchar-decode :
      664   define input parameter p-in-string      as character        no-undo.
      665   define output parameter p-out-string    as character        no-undo.
      666       define variable v-position      as integer      no-undo.
      667       define variable v-last-position as integer      no-undo.
      668       define variable v-temp-integer  as integer      no-undo.
      669       define variable v-current-char  as character    no-undo.
      670       define variable v-next-char     as character    no-undo.
      671       define variable v-success       as logical      no-undo.
      672   do
      673   on error undo, return error
      674   :
      675       assign
      676           p-out-string = "":U
      677           v-position   = 0
      678       .
      679       replace-cycle:
      680       do while yes
      681       on error undo, return error
      682       :
      683           assign
      684               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      685           .
      686           if v-last-position <= v-position
      687           then do:
      688               if v-position = 0
      689               then do:
      690                   assign
      691                       p-out-string = p-in-string
      692                   .
      693               end.
      694               else do:
      695                   assign
      696                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      697                   .
      698               end.
      699               leave replace-cycle.
      700           end.
      701           else do:
      702               assign
      703                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      704                   v-position      = v-last-position
      705                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      706               .
      707               if v-current-char = "#":U
      708               then do:
      709                   assign
      710                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      711                   .
      712                   if v-last-position > 0
      713                   then do:
      714                       run xmlchar-read-integer in this-procedure
      715                        (
      716                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      717                           , output v-temp-integer
      718                           , output v-success
      719                       ).
      720                       if v-success = yes
      721                       and v-temp-integer >= 1
      722                       and v-temp-integer <= 255
      723                       then do:
      724                           assign
      725                               p-out-string = p-out-string + chr( v-temp-integer )
      726                               v-position   = v-last-position + 1
      727                           .
      728                       end.
      729                       else do:
      730                           assign
      731                               p-out-string = p-out-string + "&":U
      732                               v-position   = v-position   + 1
      733                           .
      734                       end.
      735                   end.
      736                   else do:
      737                       assign
      738                           p-out-string = p-out-string + "&":U
      739                           v-position   = v-position   + 1
      740                       .
      741                   end.
      742               end.
      743               else do:
      744                   case substring( p-in-string, v-position + 1, 3 )
      745                   :
      746                       when "lt;":U
      747                       then do:
      748                           assign
      749                               p-out-string = p-out-string + "<":U
      750                               v-position   = v-position   + 3
      751                           .
      752                       end.
      753                       when "gt;":U
      754                       then do:
      755                           assign
      756                               p-out-string = p-out-string + ">":U
      757                               v-position   = v-position   + 3
      758                           .
      759                       end.
      760                       otherwise do:
      761                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      762                           then do:
      763                               assign
      764                                   p-out-string = p-out-string + "&":U
      765                                   v-position   = v-position   + 4
      766                               .
      767                           end.
      768                           else do:
      769                               case substring( p-in-string, v-position + 1, 5 )
      770                               :
      771                                   when "quot;":U
      772                                   then do:
      773                                       assign
      774                                           p-out-string = p-out-string + '"':U
      775                                           v-position   = v-position   + 5
      776                                       .
      777                                   end.
      778                                   when "apos;":U
      779                                   then do:
      780                                       assign
      781                                           p-out-string = p-out-string + "'":U
      782                                           v-position   = v-position   + 5
      783                                       .
      784                                   end.
      785                                   otherwise do:
      786                                       assign
      787                                           p-out-string = p-out-string + "&":U
      788                                       .
      789                                   end.
      790                               end case.
      791                           end.
      792                       end.
      793                   end case.
      794               end.
      795           end.
      796       end.
      797   end.
      798   end .
      799   procedure xmlchar-read-integer :
      800   define input parameter p-input-string      as character        no-undo.
      801   define output parameter p-output-integer   as integer          no-undo.
      802   define output parameter p-success       as logical          no-undo.
      803   do
      804   on error undo, return error
      805   :
      806       assign
      807           p-output-integer = integer( p-input-string )
      808       no-error.
      809       if error-status :error
      810       then do:
      811           assign
      812               p-success           = no
      813               p-output-integer    = 0
      814           .
      815       end.
      816       else do:
      817           assign
      818               p-success           = yes
      819           .
      820       end.
      821   end.
      822   end.
      823   define variable mMRCCode  as logical    no-undo.
      824   define variable mTypeMark as character  no-undo.
      825   function IS-NeedMark returns logical
      826   ( input ib-code as integer  ,
      827     input ib-str as character ):
      828      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
      829      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
      830                                    and buf_prod-bc-attr.b-str  eq ib-str
      831                                    and buf_prod-bc-attr.attr-code eq 'mark':U
      832        no-lock no-error.
      833      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
      834   end.
      835   function repTegforDm return char
      836   (iDM as char ):
      837       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
      838       define variable vteg as character no-undo.
      839       define variable oDM as character no-undo.
      840       define variable vi as integer no-undo.
      841       oDM = iDm.
      842       do vi = 1 to num-entries(vTeglist):
      843          vTeg = entry(vi,vTeglist).
      844          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
      845       end.
      846       return oDM.
      847   end.
      848   function repSpecSimbforDm return char
      849   (iDM as char ):
      850       define variable oDM as character no-undo.
      851     run
      852       xmlchar-decode(iDM, output oDM).
      853     return repTegforDm (oDM).
      854   end.
      855   function CheckGtin return logical
      856   (iGtin as char):
      857      define variable bar_code as character no-undo.
      858      define variable vGtin as logical no-undo init "yes".
      859      if length(iGtin) eq 14
      860      then do:
      861         bar_code = substr (iGtin, 1, length (iGtin) - 1).
      862         run str/chk-sum.p
      863          (input-output bar_code ) no-error .
      864         if iGtin ne  bar_code
      865         then
      866            vGtin = no.
      867      end.
      868      else
      869         vGtin = no.
      870      return vgtin.
      871   end.
      872   function repSpecSimbforXlm return char
      873   (iDM as char ):
      874       iDM = replace(iDM,chr(29),"").
      875       return iDM.
      876   end.
      877   function getGtinByDM return char
      878   (IDM as char):
      879      define variable VTXT as char no-undo.
      880      define variable vGtin as char no-undo.
      881      vTXt = IdM.
      882      vGtin = IDM.
      883      if    length(vtxt) > 14
      884      then do:
      885         if   vtxt begins "(01)"
      886                or vtxt begins "(02)"
      887         then
      888            vGtin = substring(vtxt,5,14).
      889         else if   (vtxt begins "01"
      890                or vtxt begins "02" )
      891                and (   (    substring(iDm,17,2) eq "21"
      892                         and length(vtxt) >= 21)
      893                     or substring(iDm,17,2) eq "37"
      894                     or substring(iDm,17,4) eq "(37)" )
      895         then do:
      896            vGtin = substring(vtxt,3,14).
      897            if not checkGtin(vGtin)
      898            then
      899               vGtin = substring(vtxt,1,14).
      900         end.
      901         else if     length(vtxt) eq 14 + 7 + 4 + 4
      902             or length(vtxt) eq 14 + 7 + 4
      903             or length(vtxt) eq 14 + 7
      904         then
      905            vGtin = substring(vtxt,1,14).
      906      end.
      907      if not checkGtin(vGtin)
      908      then
      909         vGtin = "".
      910      return vgtin.
      911   end.
      912   function getGdsCodeByGtin return int
      913   (iGtin as char):
      914      define buffer prod-bc  for ub.prod-bc.
      915      define buffer bar-code for ub.bar-code.
      916      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
      917      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      918      return if avail bar-code then bar-code.gds-code else ?.
      919   end.
      920   function getQntyCodeByGtin return decimal
      921   (iGtin as char):
      922      define buffer prod-bc  for ub.prod-bc.
      923      define buffer bar-code for ub.bar-code.
      924      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
      925      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      926      return if avail bar-code then bar-code.cli-base-rate else ?.
      927   end.
      928   function getGdsCodeByDM return int
      929   (iDm as char):
      930      define variable vGtin as char no-undo.
      931      define buffer prod-bc for ub.prod-bc.
      932      vGtin  = getGtinByDM (IDM ).
      933      return getGdsCodeByGtin (vGtin).
      934   end.
      935   function ChekTypeMarkByGds return logical
      936   (iGds-code as integer ):
      937      define buffer goods-attr for ub.goods-attr.
      938      find first goods-attr where goods-attr.gds-code   = iGds-code
      939                              and goods-attr.attr-code  = 'mark-type':U
      940      no-lock no-error.
      941      if available goods-attr
      942      then do:
      943         mTypeMark = goods-attr.attr-value.
      944         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
      945           .
      946      end.
      947      else
      948         return no.
      949   end.
      950   function ChekTypeMarkByDm return logical
      951   (iDM as char ):
      952      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
      953   end.
      954   function ChekTypeMarkByGtin return logical
      955   (iGtin as char ):
      956      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
      957   end.
      958   function GetNextElement return character
      959     (input iAllTeg        as logical
      960     ,output oteg          as character
      961     ,output otegval       as character
      962     ,input-output pstr    as character
      963      ):
      964        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
      965        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
      966        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
      967        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
      968        define variable vTeg as character no-undo.
      969        define variable vLength as integer no-undo.
      970        define variable vi as integer no-undo.
      971        define variable vj as integer no-undo.
      972        define buffer code for ub.code.
      973        find first code where Code.parent eq "MarkType"
      974                          and Code.CodeValue   eq mTypeMark
      975                          no-lock no-error.
      976        if     available code
      977           and Code.misc1 ne ""
      978           and Code.misc1 ne ?
      979        then do:
      980           integer (Code.misc1) no-error.
      981           if not error-status:error
      982           then
      983             entry (4,vlistleng) = Code.misc1.
      984        end.
      985        if iAllTeg
      986        then
      987           assign
      988              vlistElem     = vlistElem    + vlistElemDop
      989              vlistleng     = vlistleng    + vlistlengDop
      990           .
      991        else if mMRCCode
      992        then
      993           assign
      994              vlistElem     = vlistElem    + ",(8005),8005"
      995              vlistleng     = vlistleng    + ",000006,0006"
      996           .
      997       block-elem:
      998       do vi = 1 to num-entries(vlistElem):
      999          vTeg = entry(vi,vlistElem).
     1000          if pstr begins vTeg
     1001          then do:
     1002             if    vTeg eq "21"
     1003             then
     1004                vLength = index(pstr,chr(29)) - 2 no-error.
     1005             if vLength  <= 0
     1006             then
     1007                vLength = int(entry(vi,vlistleng)).
     1008             otegval = substring (pstr,length(vteg) + 1, vLength).
     1009             oteg = replace(replace(vteg,")",""),"(","").
     1010             vTeg = vteg + otegval.
     1011             otegval = replace(otegval,chr(29),"").
     1012             oteg = replace(replace(oteg,")",""),"(","").
     1013             pstr = substring (pstr,length(vTeg)+ 1).
     1014             vTeg = replace(vTeg,chr(29),"").
     1015             leave block-elem.
     1016          end.
     1017          else
     1018             vTeg = "".
     1019       end.
     1020       return vteg.
     1021   end.
     1022   function GetCodeIdent return character
     1023   (iDm as char):
     1024      define variable Velement   as character no-undo init "first".
     1025      define variable oCodeIdent as character no-undo.
     1026      define variable vteg as character no-undo.
     1027      define variable vtegval as character no-undo.
     1028      define variable vGtin as character no-undo.
     1029      define buffer marking for ub.marking.
     1030      for first marking no-lock where
     1031                marking.mark eq iDm
     1032            and marking.unit-ext = "LEVEL2"
     1033      :
     1034        return iDm.
     1035      end.
     1036      vGtin  = getGtinByDM (iDm ).
     1037      ChekTypeMarkByDm(idm).
     1038      if iDm begins 'tech_':U
     1039      then
     1040         oCodeIdent = iDm.
     1041      else if length(iDm) < 21
     1042      then do:
     1043         find first marking where marking.mark eq idm
     1044         no-lock no-error.
     1045         oCodeIdent = if available marking then marking.mark else  ?.
     1046      end.
     1047      else if     length(iDm) eq 29
     1048         and not iDm begins "01"
     1049         and not iDm begins "02"
     1050      then
     1051         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     1052      else  if     length(iDm) >= 24
     1053               and (  iDm begins "01"
     1054                   or iDm begins "02")
     1055               and  substring(iDm,17,2) ne "21"
     1056      then do:
     1057         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     1058                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     1059         then
     1060            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     1061         else
     1062            oCodeIdent = iDM.
     1063      end.
     1064      else  if     (   length(iDm) eq 25
     1065                    or length(iDm) eq 21)
     1066               and (not iDm begins "01"
     1067               and  not iDm begins "02")
     1068      then
     1069         oCodeIdent = substring(iDm,1,21).
     1070      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     1071      then
     1072         oCodeIdent = substring(iDm,1,21).
     1073      else do while Velement ne "" and idm ne "":
     1074         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     1075         oCodeIdent = oCodeIdent + Velement.
     1076      end.
     1077      return oCodeIdent.
     1078   end.
     1079   function GetTegCod return character
     1080   (icodeIdent as char, iTeg as char):
     1081      define variable Velement   as character no-undo init "first".
     1082      define variable oTeg as character no-undo init ?.
     1083      define variable vteg as character no-undo.
     1084      define variable vtegval as character no-undo.
     1085      if     ((length(icodeIdent) eq 21
     1086         and not icodeIdent begins "01"
     1087         and not icodeIdent begins "02")
     1088         or
     1089             ( length(icodeIdent) eq 25
     1090               and not icodeIdent begins "01"
     1091               and not icodeIdent begins "02"))
     1092      then do:
     1093         if iTeg eq "01" or iTeg eq "02"
     1094         then
     1095            oTeg = substring(icodeIdent,1,21).
     1096         else  if  iTeg eq "21"
     1097         then
     1098            oTeg = substring(icodeIdent,15,7).
     1099      end.
     1100      else do:
     1101         ChekTypeMarkByDm(icodeIdent).
     1102         block-teg:
     1103            do while Velement ne "" and icodeIdent ne "":
     1104            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     1105            if    Velement begins iTeg
     1106               or Velement begins "(" + iTeg + ")"
     1107            then do:
     1108               oTeg = vtegval.
     1109               leave block-teg.
     1110            end.
     1111         end.
     1112      end.
     1113      return oTeg.
     1114   end.
     1115   function isOAD return logical
     1116   (icodeIdent as character):
     1117      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     1118   end.
     1119   function isMark return logical
     1120   (icodeIdent as character):
     1121      define buffer buf_marking for ub.marking.
     1122      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     1123             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     1124   end.
     1125   function addBracketForCode return character
     1126   (icodeIdent as char):
     1127      define variable Velement   as character no-undo init "first".
     1128      define variable oTeg as character no-undo.
     1129      define variable vteg as character no-undo.
     1130      define variable vtegval as character no-undo.
     1131      define buffer marking for ub.marking.
     1132      find first marking no-lock where
     1133                 marking.mark begins icodeIdent no-error.
     1134      if    not ChekTypeMarkByDm(icodeIdent)
     1135         or length(icodeIdent) le 24
     1136         or (avail marking and marking.unit-ext = "LEVEL2")
     1137      then
     1138         oTeg = icodeIdent.
     1139      else do:
     1140         if (  icodeIdent begins "01"
     1141            or icodeIdent begins "02"
     1142            ) and CheckGtin(substring (icodeIdent,3,14))
     1143            and substring (icodeIdent,17,2) eq "21"
     1144         then do:
     1145            mMRCCode = yes.
     1146            ChekTypeMarkByDm(icodeIdent).
     1147            block-teg:
     1148            do while Velement ne "" and icodeIdent ne "":
     1149               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     1150               if vteg ne ""
     1151               then
     1152                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     1153            end.
     1154            mMRCCode = no.
     1155         end.
     1156         else do:
     1157            oTeg = icodeIdent.
     1158         end.
     1159      end.
     1160      return oTeg.
     1161   end.
     1162   function getlevelByCodId return int
     1163   (iCode as char):
     1164      define variable vLength as int no-undo.
     1165      define variable vLevel  as int no-undo.
     1166      if not ChekTypeMarkByDM (icode) then return ?.
     1167      vLength = length(iCode).
     1168      if    vLength eq 18
     1169         or vLength eq 20
     1170      then
     1171         Vlevel = 4.
     1172      else if vLength eq 21
     1173      then
     1174         Vlevel = 1.
     1175      else if vLength eq 25
     1176      then do:
     1177         if  iCode begins "01"
     1178         then
     1179            Vlevel = 3.
     1180         else
     1181            Vlevel = 1.
     1182      end.
     1183      else if     vLength >= 26
     1184              and vLength <= 46
     1185      then do:
     1186         if    substring(iCode,17,2) eq "11"
     1187            or substring(iCode,17,2) eq "13"
     1188            or (    substring(iCode,17,2) eq "21"
     1189                and vLength >= 33
     1190                and substring(iCode,26,4) ne "8005")
     1191         then
     1192            Vlevel = 4.
     1193         else if    vLength eq 31
     1194                 or vLength eq 38
     1195                 or vLength eq 39
     1196                 or vLength eq 45
     1197         then
     1198            Vlevel = 1.
     1199         else if    vLength eq 35
     1200                 or vLength eq 43
     1201         then
     1202            Vlevel = 3.
     1203         else
     1204            Vlevel = ?.
     1205      end.
     1206      else
     1207         Vlevel = ?.
     1208      return Vlevel.
     1209   end.
     1210   function getLevelMotpBycodid return character
     1211   (iDm as char):
     1212      define variable vLevel as integer no-undo.
     1213      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1214      vLevel = getlevelByCodId(iDm).
     1215      if    vLevel eq ?
     1216         or vLevel < 1
     1217         or vLevel > 6
     1218      then
     1219         return ?.
     1220      else
     1221         return entry(vlevel,vList).
     1222   end.
     1223   function getLevelUTDByLevelMotp return character
     1224   (iUnit as char):
     1225      define variable vLevel as integer no-undo.
     1226      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1227      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1228      vLevel = lookup(iUnit,vListMOTP).
     1229      if    vLevel eq ?
     1230         or vLevel < 1
     1231         or vLevel > 4
     1232      then
     1233         return ?.
     1234      else
     1235         return entry(vlevel,vListutd).
     1236   end.
     1237   function getLevelMotpByDM return character
     1238   (iDm as char):
     1239      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     1240   end.
     1241   function getLevelUTDByCodId return character
     1242   (iDm as char):
     1243      define variable vLevel as integer no-undo.
     1244      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1245      vLevel = getlevelByCodId(iDm).
     1246      if    vLevel eq ?
     1247         or vLevel < 1
     1248         or vLevel > 4
     1249      then
     1250         return ?.
     1251      else
     1252         return entry(vlevel,vList).
     1253   end.
     1254   function getLevelUTDByDM return character
     1255   (iDm as char):
     1256      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     1257   end.
     1258   define variable mNotMarkQnty as logical no-undo.
     1259   function getQntyUTDByCodId return decimal
     1260   (iDM as char):
     1261      define variable vLevel as integer no-undo.
     1262      define variable vList as character no-undo init "1,5,10,500".
     1263      define variable vGtin as character no-undo.
     1264      define variable vqnty as decimal no-undo init ?.
     1265      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     1266      if vqnty eq ?
     1267      then do:
     1268         if not mNotMarkQnty
     1269         then do:
     1270            define buffer marking for ub.marking.
     1271            define variable vCodident as character no-undo.
     1272            vCodident = GetCodeIdent(idm).
     1273            find first marking where marking.mark begins vCodident no-lock no-error.
     1274            if     available marking
     1275               and marking.box-qnty ne ?
     1276            then
     1277               return marking.box-qnty.
     1278         end.
     1279         vGtin = getGtinByDm(iDM).
     1280         if ChekTypeMarkByGtin (vGtin)
     1281         then do:
     1282            vLevel = getlevelByCodId(iDM).
     1283            if     vLevel >= 1
     1284               and vLevel <= 4
     1285            then
     1286               vqnty = int(entry(vlevel,vList)).
     1287         end.
     1288         else
     1289            vqnty = getQntyCodeByGtin(vgtin).
     1290      end.
     1291      return vqnty.
     1292   end.
     1293   function getQntyUTDByDM return decimal
     1294   (iDm as char):
     1295      define variable vDM as character no-undo.
     1296      if     length (iDm) ne 25
     1297         and length (iDm) ne 29
     1298         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     1299      then
     1300         vDM = substring (iDm,1,length (iDm) - 6 ).
     1301      else
     1302         vDM = substring (iDm,1,length (iDm) - 4 ).
     1303      return getQntyUTDByCodId(vDM).
     1304   end.
     1305   function getMRC4 return decimal
     1306   (iMRC as char):
     1307      define variable oMrc     as decimal no-undo init ?.
     1308      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     1309      define variable vi       as integer no-undo.
     1310      define variable vfound   as integer no-undo.
     1311      define variable vposStart   as integer no-undo.
     1312      do:
     1313      OMRc = 0.
     1314      do vi = 1 to 4:
     1315         define variable vsimb as character no-undo.
     1316         vsimb = substring(iMRC,vi,1).
     1317         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     1318         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     1319         if vfound > 0
     1320         then
     1321            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     1322         end.
     1323         OMRc = OMRc / 100.
     1324      end.
     1325      return OMRc.
     1326   end.
     1327   function getMRCByDM return decimal
     1328   (iDm as char):
     1329      define variable vMRC     as character no-undo.
     1330      define variable oMrc     as decimal no-undo init ?.
     1331      define variable Velement as character no-undo init "empty".
     1332      define variable vteg as character no-undo.
     1333      define variable vtegval as character no-undo.
     1334      if    length(idm) eq 14 + 7 + 4 + 4
     1335         or length(idm) eq 14 + 7 + 4
     1336      then do:
     1337         vMRC = substring(idm,22,4).
     1338         omrc = getMRC4(vMRC).
     1339      end.
     1340      else do:
     1341          ChekTypeMarkByDm(iDm).
     1342          block-mrc:
     1343          do while Velement ne "" and idm ne "":
     1344             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     1345             if Velement begins "8005"
     1346             then do:
     1347                vMRC = substring(Velement,5,6).
     1348                leave block-mrc.
     1349             end.
     1350             else if Velement begins "(8005)"
     1351             then do:
     1352                vMRC = substring(Velement,7,6).
     1353                leave block-mrc.
     1354             end.
     1355          end.
     1356          if vMRC ne ""
     1357          then
     1358             OMRc = dec(vmrc) / 100 no-error.
     1359      end.
     1360      return OMRc.
     1361   end.
     1362   function MoveDate return Date
     1363   (idate as date,
     1364    iMonth as int64):
     1365      define variable vMonth   as int64 no-undo.
     1366      define variable vYear    as int64 no-undo.
     1367      define variable vDateNew as date  no-undo.
     1368       define variable vDay     as int64 no-undo.
     1369       vMonth = month(iDate) + iMonth.
     1370       vYear =  year(iDate).
     1371       if vMonth <= 0
     1372       then assign
     1373          vMonth = vMonth + 12
     1374           vYear  = vYear - 1
     1375       .
     1376       else if vMonth > 12
     1377       then assign
     1378          vMonth = vMonth - 12
     1379           vYear  = vYear + 1
     1380       .
     1381       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     1382       do while error-status:error eq yes:
     1383          VDay = vDay + 1.
     1384          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     1385       end.
     1386       if VDay > 0
     1387       then
     1388          vDateNew + 1.
     1389       return vDateNew.
     1390   end.
     1391   procedure checkEMRC:
     1392   define input  parameter iDm as character no-undo.
     1393   define output parameter vok as logical   no-undo init yes.
     1394      define variable v-value-emrc as character no-undo.
     1395      define variable v-type-emrc  as character no-undo.
     1396      define variable vDateIso     as character no-undo.
     1397      define variable vMRC         as decimal no-undo.
     1398      define variable vqnty        as decimal no-undo.
     1399      define variable vPrice       as decimal no-undo.
     1400      define variable vparent      as character no-undo.
     1401      define variable vgds-code    as integer no-undo.
     1402      define buffer code for ub.code.
     1403      vMRC = getMRCByDM(iDm).
     1404      if vMRC > 0
     1405      then do:
     1406         vgds-code = getGdsCodeByDM(iDm).
     1407         vqnty     = getQntyUTDByDM(iDm).
     1408               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     1409            (
     1410             input   vgds-code
     1411            ,input   'emrc-type':U
     1412            ,output   v-value-emrc
     1413            ,output   v-type-emrc
     1414          ) no-error.
     1415          if     v-value-emrc ne ""
     1416             and v-value-emrc ne ?
     1417          then do:
     1418             vDateIso = iso-date(today).
     1419             vPrice = vMRC / vqnty.
     1420             vparent ="emc" + chr(4) + v-value-emrc.
     1421             find last code where Code.parent      eq vparent
     1422                              and Code.code        le vDateIso
     1423                              and code.status_  eq 0
     1424             no-lock no-error.
     1425             if not available code or ( vPrice  >= dec(Code.CodeValue))
     1426             then
     1427                vOk = true .
     1428             else do:
     1429                 define variable vText      as character no-undo.
     1430                 define variable vDate      as date no-undo.
     1431                 define variable vDateLast  as character no-undo.
     1432                 define variable vDateFirst as character no-undo.
     1433                 define variable vDate3     as date no-undo.
     1434                 vdate = date(code.misc1).
     1435                 vDateLast = code.misc1.
     1436                 vDate3 = MoveDate(today, - 3 ).
     1437                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     1438                                      string(vDate3  , "99/99/9999"),
     1439                                      string(vDate   , "99/99/9999")
     1440                                      ).
     1441                 vdateIso = iso-date(vdate3).
     1442                 find last code  where Code.parent      eq vparent
     1443                                   and Code.code        le vDateIso
     1444                                   and code.status_  eq 0 no-lock no-error.
     1445                 if available code
     1446                 then
     1447                    vDateIso = code.code.
     1448                 vDateFirst = vDateIso.
     1449                 vDateLast = iso-date(vdate).
     1450                 define variable vGood as logical no-undo.
     1451                 define variable vDateSale as date no-undo.
     1452                 define buffer bcode for code.
     1453                 for last code where Code.parent   eq vparent
     1454                                 and code.status_  eq 0
     1455                                 and code.code     < vDateLast
     1456                                 and code.code     >= vDateFirst
     1457                 no-lock:
     1458                    find first bcode where bCode.parent   eq vparent
     1459                                       and bcode.status_  eq 0
     1460                                       and bcode.code     > code.code no-lock no-error.
     1461                    if available bcode
     1462                    then do:
     1463                       if vPrice < dec(Code.CodeValue)
     1464                       then
     1465                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     1466                                                     chr(10),
     1467                                                     string(    date( code.misc1)       ,"99/99/9999"),
     1468                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     1469                                                     ).
     1470                       else do:
     1471                          vGood = yes.
     1472                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     1473                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     1474                                                     chr(10),
     1475                                                     string(    date( code.misc1)         ,"99/99/9999"),
     1476                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     1477                                                     string(         vDateSale            ,"99/99/9999"),
     1478                                                     string(vDateSale - today)
     1479                                                     ).
     1480                       end.
     1481                    end.
     1482                 end.
     1483                 if vgood
     1484                 then do:
     1485                    define variable choice as integer no-undo .
     1486                    run gbl/d-askw.w (input "Уточнение"
     1487                           ,input  vText
     1488                           ,input "|"
     1489                           ,input "Принять|Вернуть"
     1490                           ,input "Принять данный товар|Вернуть товар постащику"
     1491                           ,input 1
     1492                           ,input 2
     1493                           ,output choice) no-error.
     1494                    vok = choice eq 1.
     1495                 end.
     1496                 else
     1497                    vok =false.
     1498             end.
     1499          end.
     1500      end.
     1501   end.
     1502   function addGs2Mark return character
     1503   (iMark as char):
     1504      define variable vDM   as character no-undo.
     1505      define variable vIdx  as integer   no-undo.
     1506      if index(iMark,chr(29),1) > 0
     1507      then return iMark.
     1508      if substring(iMark,26,4) = "8005" then
     1509      do:
     1510        vIdx = index(iMark,"93",26 + 4 + 5).
     1511        if vIdx > 1 then do:
     1512          vDM = substitute("&1&4&2&4&3",
     1513                           substring(iMark,1,25),
     1514                           substring(iMark,26,vIdx - 25 - 1),
     1515                           substring(iMark,vIdx),
     1516                           chr(29)) no-error.
     1517          vIdx = index(vDm,"240",vIdx + 4).
     1518          if vIdx > 0 then
     1519          do:
     1520            vDM = substitute("&1&3&2",
     1521                             substring(vDm,1,vIdx - 1),
     1522                             substring(vDm,vIdx),
     1523                             chr(29)) no-error.
     1524          end.
     1525        end.
     1526        else
     1527          vDM = substitute("&1&3&2",
     1528                           substring(iMark,1,25),
     1529                           substring(iMark,26),
     1530                           chr(29)) no-error.
     1531      end.
     1532      else if substring(iMark,32,2) = "91" then
     1533      do:
     1534        vIdx = index(iMark,"92",32).
     1535        if vIdx > 1 then
     1536          vDM = substitute("&1&4&2&4&3",
     1537                           substring(iMark,1,31),
     1538                           substring(iMark,32,vIdx - 31 - 1),
     1539                           substring(iMark,vIdx),
     1540                           chr(29)) no-error.
     1541        else
     1542          vDM = substitute("&1&3&2",
     1543                           substring(iMark,1,31),
     1544                           substring(iMark,32),
     1545                           chr(29)) no-error.
     1546      end.
     1547      else if substring(iMark,39,2) = "91" then
     1548      do:
     1549        vIdx = index(iMark,"92",38).
     1550        if vIdx > 1 then
     1551          vDM = substitute("&1&4&2&4&3",
     1552                           substring(iMark,1,38),
     1553                           substring(iMark,39,vIdx - 38 - 1),
     1554                           substring(iMark,vIdx),
     1555                           chr(29)) no-error.
     1556        else
     1557          vDM = substitute("&1&3&2",
     1558                           substring(iMark,1,38),
     1559                           substring(iMark,39),
     1560                           chr(29)) no-error.
     1561      end.
     1562      else if substring(iMark,25,2) = "93" then
     1563      do:
     1564        vIdx = index(iMark,"92",25).
     1565        if vIdx > 1 then
     1566          vDM = substitute("&1&4&2&4&3",
     1567                           substring(iMark,1,24),
     1568                           substring(iMark,25,vIdx - 24 - 1),
     1569                           substring(iMark,vIdx),
     1570                           chr(29)) no-error.
     1571        else
     1572          vIdx = index(iMark,"3103",25).
     1573          if vIdx > 0 then
     1574          vDM = substitute("&1&4&2&4&3",
     1575                           substring(iMark,1,24),
     1576                           substring(iMark,25,vIdx - 24 - 1),
     1577                           substring(iMark,vIdx),
     1578                           chr(29)) no-error.
     1579          else
     1580            vDM = substitute("&1&3&2",
     1581                             substring(iMark,1,24),
     1582                             substring(iMark,25),
     1583                             chr(29)) no-error.
     1584      end.
     1585      else if substring(iMark,32,2) = "93" then
     1586      do:
     1587        vDM = substitute("&1&3&2",
     1588              substring(iMark,1,31),
     1589              substring(iMark,32),
     1590              chr(29)) no-error.
     1591      end.
     1592      return if vDM <> "" then vDm else iMark.
     1593   end.
     1594   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1595   procedure gen-key-rec :
     1596     define input  parameter p-tbl-name    as character no-undo.
     1597     define input  parameter p-bh_tbl-name as handle    no-undo.
     1598     define output parameter p-key-rec     as character no-undo.
     1599     do
     1600     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1601     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1602     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1603     :
     1604       define variable fh               as handle    no-undo .
     1605       define variable v-ok             as logical   no-undo .
     1606       define variable v-inform         as character no-undo .
     1607       define variable v-ind            as integer   no-undo .
     1608       define variable v-idx-field-qnty as integer   no-undo .
     1609       if p-tbl-name = ?
     1610         or p-tbl-name = "":U
     1611       then do:
     1612         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info4 ).
     1613       end.
     1614       if not p-bh_tbl-name:available then do:
     1615         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info4, p-tbl-name ).
     1616       end.
     1617       assign
     1618         p-key-rec = p-tbl-name
     1619         v-inform  = p-bh_tbl-name:index-information(1)
     1620         v-ind     = 2
     1621       .
     1622       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1623       on error undo, return error
     1624       :
     1625         assign
     1626           v-inform = p-bh_tbl-name:index-information( v-ind )
     1627           v-ind    = v-ind + 1
     1628         .
     1629       end.
     1630       if v-inform = ?
     1631         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1632         or entry( 3, v-inform, ",":U ) <> "1":U
     1633       then do:
     1634         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, p-tbl-name ).
     1635       end.
     1636       else do:
     1637         assign
     1638           v-idx-field-qnty = num-entries( v-inform ) - 4
     1639         .
     1640         if v-idx-field-qnty < 2 then do:
     1641           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, p-tbl-name ).
     1642         end.
     1643         do v-ind = 1 to v-idx-field-qnty by 2
     1644         on error undo, return error
     1645         :
     1646           assign
     1647             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1648             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1649           .
     1650         end.
     1651       end.
     1652       if p-key-rec = ? then do:
     1653         assign
     1654           p-key-rec = "":U
     1655         .
     1656         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info4, p-tbl-name ).
     1657       end.
     1658     end.
     1659     return.
     1660   end procedure.
     1661   procedure gen-where-keyr-tab :
     1662     define input  parameter i-tableSerach as character no-undo.
     1663     define input  parameter i-tablekey   as character  no-undo.
     1664     define input  parameter p-key-rec    as character  no-undo.
     1665     define input  parameter p-key-handle as handle     no-undo .
     1666     define input  parameter p-db-name    as character  no-undo .
     1667     define input  parameter p-tt-handle  as handle     no-undo .
     1668     define output parameter o-Where      as character  no-undo.
     1669     do
     1670     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1671     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1672     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1673     :
     1674       define variable v-full-tbl-name  as character no-undo .
     1675       define variable bh_tbl-name      as handle    no-undo .
     1676       define variable fh_key           as handle    no-undo .
     1677       define variable fh_search        as handle    no-undo .
     1678       define variable v-field-num      as integer   no-undo .
     1679       define variable v-count-fld      as integer   no-undo .
     1680       define variable v-inform         as character no-undo .
     1681       define variable v-ind            as integer   no-undo .
     1682       define variable v-idx-field-qnty as integer   no-undo .
     1683       define variable v-field-name     as character no-undo .
     1684       define variable v-field-val      as character no-undo .
     1685       define variable v-word-link      as character no-undo .
     1686       define variable vTable           as character no-undo.
     1687       define variable bh_tbl-key       as handle    no-undo .
     1688       assign
     1689         p-key-rec = trim( p-key-rec )
     1690       .
     1691       if p-key-handle <> ? then do:
     1692         if not valid-handle(p-key-handle)
     1693            or p-key-handle:type <> "buffer"
     1694         then do:
     1695           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info4 ).
     1696         end.
     1697         if num-entries( p-key-rec, chr(3) ) > 1
     1698           or p-key-rec = ?
     1699           or p-key-rec = "":U
     1700         then do:
     1701           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info4, p-key-rec ).
     1702         end.
     1703       end.
     1704       else do:
     1705         if p-key-rec = ?
     1706           or p-key-rec = "":U
     1707         then do:
     1708           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
     1709         end.
     1710       end.
     1711       assign
     1712         vTable = entry( 1 , p-key-rec, chr(3) )
     1713       .
     1714       if p-tt-handle <> ?
     1715         and ( not valid-handle(p-tt-handle)
     1716               or p-tt-handle:type <> "buffer"
     1717             )
     1718       then do:
     1719         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info4, vTable, chr(10) ).
     1720       end.
     1721       if p-tt-handle = ? then do:
     1722         assign
     1723           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1724         .
     1725         create buffer bh_tbl-name for table v-full-tbl-name .
     1726       end.
     1727       else do:
     1728         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1729       end.
     1730       assign
     1731         v-inform = bh_tbl-name:index-information(1)
     1732         v-ind    = 2
     1733       .
     1734       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1735       on error undo, return error
     1736       :
     1737         assign
     1738           v-inform = bh_tbl-name:index-information( v-ind )
     1739           v-ind    = v-ind + 1
     1740         .
     1741       end.
     1742       if v-inform = ?
     1743         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1744         or entry( 3, v-inform, ",":U ) <> "1":U
     1745       then do:
     1746         delete object bh_tbl-name no-error.
     1747         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info4, vTable ).
     1748       end.
     1749       assign
     1750         v-idx-field-qnty = num-entries( v-inform ) - 4
     1751       .
     1752       if v-idx-field-qnty < 2 then do:
     1753         delete object bh_tbl-name no-error.
     1754         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, vTable ).
     1755       end.
     1756       assign
     1757         o-where     = "where":U
     1758         v-word-link = "":U
     1759         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1760         v-count-fld = 0
     1761       .
     1762       if i-tablekey ne "" and i-tablekey ne ?
     1763       then do:
     1764         assign
     1765           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1766         .
     1767         create buffer bh_tbl-key for table v-full-tbl-name .
     1768       end.
     1769       if i-tableSerach ne "" and i-tableSerach ne ?
     1770       then do:
     1771         delete object bh_tbl-name no-error.
     1772         assign
     1773           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1774         .
     1775         create buffer bh_tbl-name for table v-full-tbl-name .
     1776       end.
     1777       block_where:
     1778       do v-ind = 1 to v-idx-field-qnty by 2
     1779       on error undo, return error
     1780       :
     1781         assign
     1782           v-count-fld = v-count-fld + 1
     1783         .
     1784         if p-key-handle = ?
     1785           and v-count-fld > v-field-num
     1786         then do:
     1787           leave block_where.
     1788         end.
     1789         define variable VfieldKeyTable as handle no-undo.
     1790         assign
     1791           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1792           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1793         .
     1794         if     bh_tbl-key ne ?
     1795         then do:
     1796            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1797            if VfieldKeyTable eq ?
     1798            then next block_where.
     1799         end.
     1800         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1801         then
     1802            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1803         else
     1804            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1805         if p-key-handle = ? then do:
     1806           assign
     1807             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1808           .
     1809         end.
     1810         else do:
     1811           assign
     1812             fh_key = p-key-handle:buffer-field( v-field-name )
     1813           .
     1814           if fh_key = ?
     1815             or not valid-handle( fh_key )
     1816           then do:
     1817             delete object bh_tbl-name.
     1818             if     bh_tbl-key ne ?
     1819             then
     1820                delete object bh_tbl-key.
     1821             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info4, p-key-handle:name, v-field-name ).
     1822           end.
     1823           assign
     1824             v-field-val = fh_key:buffer-value
     1825           .
     1826         end.
     1827         if fh_search:data-type ="character":U then do:
     1828           assign
     1829             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1830             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1831             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1832             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1833             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1834             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1835             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1836             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1837             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1838             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1839             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1840             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1841             v-field-val = substitute( '"&1"', v-field-val )
     1842           .
     1843         end.
     1844         assign
     1845           o-where = substitute( "&1 &2", o-where, v-field-val )
     1846         .
     1847         if v-word-link = "":U then do:
     1848           assign
     1849             v-word-link = "and":U
     1850           .
     1851         end.
     1852       end.
     1853       delete object bh_tbl-name.
     1854       if     bh_tbl-key ne ?
     1855       then
     1856          delete object bh_tbl-key.
     1857       if p-key-handle = ?
     1858         and v-count-fld <> v-field-num
     1859       then do:
     1860         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info4, vTable ).
     1861       end.
     1862     end.
     1863   end procedure.
     1864   procedure gen-hn-keyr-tab :
     1865     define input  parameter i-tableSerach as character no-undo.
     1866     define input  parameter i-tablekey   as character no-undo.
     1867     define input  parameter p-key-rec    as character no-undo.
     1868     define input  parameter p-key-handle as handle    no-undo .
     1869     define input  parameter p-db-name    as character no-undo .
     1870     define input  parameter p-tt-handle  as handle    no-undo .
     1871     define input  parameter p-stts-lock  as integer   no-undo .
     1872     define output parameter o-hn         as handle    no-undo.
     1873     define variable v-full-tbl-name as character no-undo.
     1874     define variable v-where         as character no-undo.
     1875     define variable bh_tbl-name     as handle    no-undo.
     1876     define variable vTable          as character no-undo.
     1877     do
     1878     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1879     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1880     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1881         run gen-where-keyr-tab(i-tableSerach,
     1882                                i-tablekey,
     1883                                p-key-rec,
     1884                                p-key-handle,
     1885                                p-db-name,
     1886                                p-tt-handle,
     1887                                output v-where).
     1888         if i-tableSerach ne "" and i-tableSerach ne ?
     1889         then do:
     1890            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1891            create buffer bh_tbl-name for table v-full-tbl-name .
     1892         end.
     1893         else do:
     1894            if p-tt-handle = ? then do:
     1895               assign
     1896                  vTable = entry( 1 , p-key-rec, chr(3) )
     1897               .
     1898               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1899               create buffer bh_tbl-name for table v-full-tbl-name .
     1900            end.
     1901            else do:
     1902               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1903            end.
     1904         end.
     1905         if p-tt-handle = ? then do:
     1906            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1907         end.
     1908         else do:
     1909            bh_tbl-name:find-first( v-where ) no-error .
     1910         end.
     1911         o-hn = bh_tbl-name.
     1912      end.
     1913   end procedure.
     1914   procedure gen-hn-keyr :
     1915     define input  parameter p-key-rec    as character no-undo.
     1916     define input  parameter p-key-handle as handle    no-undo .
     1917     define input  parameter p-db-name    as character no-undo .
     1918     define input  parameter p-tt-handle  as handle    no-undo .
     1919     define input  parameter p-stts-lock  as integer   no-undo .
     1920     define output parameter o-hn         as handle    no-undo.
     1921     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1922   end.
     1923   procedure gen-row-keyr :
     1924     define input  parameter p-key-rec    as character no-undo.
     1925     define input  parameter p-key-handle as handle    no-undo .
     1926     define input  parameter p-db-name    as character no-undo .
     1927     define input  parameter p-tt-handle  as handle    no-undo .
     1928     define input  parameter p-stts-lock  as integer   no-undo .
     1929     define output parameter p-tbl-row    as rowid     no-undo.
     1930     define output parameter p-tbl-name   as character no-undo.
     1931     define variable vHn as handle no-undo.
     1932       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1933       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1934       p-tbl-name =  vHn:table.
     1935       delete object vHn no-error.
     1936     if p-tbl-row = ? then do:
     1937       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info4, p-tbl-name, p-key-rec ).
     1938     end.
     1939     else do:
     1940       return.
     1941     end.
     1942   end procedure.
     1943   procedure gen-key-fv :
     1944     define input  parameter p-key-rec    as character no-undo .
     1945     define output parameter p-field-list as character no-undo .
     1946     define output parameter p-value-list as character no-undo.
     1947     do
     1948     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1949     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1950     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1951     :
     1952       define variable v-full-tbl-name  as character no-undo .
     1953       define variable bh_tbl-name      as handle    no-undo .
     1954       define variable v-tbl-name       as character no-undo .
     1955       define variable v-field-num      as integer   no-undo .
     1956       define variable v-count-fld      as integer   no-undo .
     1957       define variable v-inform         as character no-undo .
     1958       define variable v-ind            as integer   no-undo .
     1959       define variable v-idx-field-qnty as integer   no-undo .
     1960       define variable v-delim-key      as character no-undo .
     1961       if p-key-rec = ?
     1962         or p-key-rec = "":U
     1963       then do:
     1964         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
     1965       end.
     1966       assign
     1967         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1968         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1969       .
     1970       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1971       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info4 ).
     1972       assign
     1973         v-inform = bh_tbl-name:index-information(1)
     1974         v-ind    = 2
     1975       .
     1976       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1977       on error undo, return error
     1978       :
     1979         assign
     1980           v-inform = bh_tbl-name:index-information( v-ind )
     1981           v-ind    = v-ind + 1
     1982         .
     1983       end.
     1984       if v-inform = ?
     1985         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1986         or entry( 3, v-inform, ",":U ) <> "1":U
     1987       then do:
     1988         delete object bh_tbl-name no-error.
     1989         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
     1990       end.
     1991       assign
     1992         v-idx-field-qnty = num-entries( v-inform ) - 4
     1993       .
     1994       if v-idx-field-qnty < 2 then do:
     1995         delete object bh_tbl-name no-error.
     1996         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
     1997       end.
     1998       assign
     1999         p-field-list = "":U
     2000         p-value-list = "":U
     2001         v-delim-key  = "":U
     2002         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     2003         v-count-fld  = 0
     2004       .
     2005       block_where:
     2006       do v-ind = 1 to v-idx-field-qnty by 2
     2007       on error undo, return error
     2008       :
     2009         assign
     2010           v-count-fld = v-count-fld + 1
     2011         .
     2012         if v-count-fld > v-field-num then do:
     2013           leave block_where.
     2014         end.
     2015         assign
     2016           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     2017           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     2018         .
     2019         if v-ind = 1 then do:
     2020           assign
     2021             v-delim-key = chr(3)
     2022           .
     2023         end.
     2024       end.
     2025       delete object bh_tbl-name.
     2026       if v-count-fld <> v-field-num then do:
     2027         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info4, v-tbl-name ).
     2028       end.
     2029     end.
     2030   end procedure.
     2031   procedure gen-key-field :
     2032     define input  parameter p-table      as character no-undo .
     2033     define output parameter p-field-list as character no-undo .
     2034     do
     2035     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2036     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2037     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2038     :
     2039       define variable v-full-tbl-name  as character no-undo .
     2040       define variable bh_tbl-name      as handle    no-undo .
     2041       define variable v-tbl-name       as character no-undo .
     2042       define variable v-field-num      as integer   no-undo .
     2043       define variable v-count-fld      as integer   no-undo .
     2044       define variable v-inform         as character no-undo .
     2045       define variable v-ind            as integer   no-undo .
     2046       define variable v-idx-field-qnty as integer   no-undo .
     2047       define variable v-delim-key      as character no-undo .
     2048       if p-table = ?
     2049         or p-table = "":U
     2050       then do:
     2051         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info4 ).
     2052       end.
     2053       assign
     2054         v-tbl-name      = p-table
     2055         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2056       .
     2057       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2058       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info4 ).
     2059       assign
     2060         v-inform = bh_tbl-name:index-information(1)
     2061         v-ind    = 2
     2062       .
     2063       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2064       on error undo, return error
     2065       :
     2066         assign
     2067           v-inform = bh_tbl-name:index-information( v-ind )
     2068           v-ind    = v-ind + 1
     2069         .
     2070       end.
     2071       if v-inform = ?
     2072         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2073         or entry( 3, v-inform, ",":U ) <> "1":U
     2074       then do:
     2075         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
     2076       end.
     2077       assign
     2078         v-idx-field-qnty = num-entries( v-inform ) - 4
     2079       .
     2080       if v-idx-field-qnty < 2 then do:
     2081         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
     2082       end.
     2083       assign
     2084         p-field-list = "":U
     2085         v-delim-key  = "":U
     2086         v-count-fld  = 0
     2087       .
     2088       block_where:
     2089       do v-ind = 1 to v-idx-field-qnty by 2
     2090       on error undo, return error
     2091       :
     2092         assign
     2093           v-count-fld = v-count-fld + 1
     2094         .
     2095         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     2096         if v-ind = 1 then do:
     2097           assign
     2098             v-delim-key = chr(3)
     2099           .
     2100         end.
     2101       end.
     2102       delete object bh_tbl-name.
     2103     end.
     2104   end procedure.
     2105   function AddUtdErrForTab returns logical
     2106   (idb-num         as integer ,
     2107    idoc-id         as integer ,
     2108    iTab            as character,
     2109    iObj            as handle ,
     2110    iCheckType      as character,
     2111    iCodeErr        as character,
     2112    iCheckObj       as character ):
     2113      define buffer utd-err for utd-err.
     2114      define buffer utd for utd.
     2115      find first utd where utd.db-num     eq idb-num
     2116                       and utd.doc-id     eq idoc-id
     2117                       and utd.Direction  eq 'Outbound'
     2118      no-lock no-error.
     2119      if available utd
     2120      then
     2121         return no.
     2122      define variable vRecKey as character no-undo.
     2123            run gen-key-rec (input iTab,
     2124                             input  iObj,
     2125                             output vRecKey).
     2126      find first utd-err where utd-err.db-num     eq idb-num
     2127                           and utd-err.doc-id     eq idoc-id
     2128                           and utd-err.CheckType  eq iCheckType
     2129                           and utd-err.CodeErr    eq iCodeErr
     2130                           and utd-err.CheckObj   eq iCheckObj
     2131      exclusive-lock no-error.
     2132      if not available utd-err
     2133      then do:
     2134         create utd-err.
     2135         assign
     2136            utd-err.db-num         = idb-num
     2137            utd-err.doc-id         = idoc-id
     2138            utd-err.CheckType      = iCheckType
     2139            utd-err.CodeErr        = iCodeErr
     2140            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     2141            utd-err.reckey         = vRecKey
     2142            utd-err.qnty           = 1
     2143         .
     2144      end.
     2145      else
     2146         utd-err.qnty = utd-err.qnty + 1.
     2147      return utd-err.qnty eq 1.
     2148   end.
     2149   function AddUtdErr returns logical
     2150   (idb-num         as integer ,
     2151    idoc-id         as integer ,
     2152    iObj            as handle ,
     2153    iCheckType      as character,
     2154    iCodeErr        as character,
     2155    iCheckObj       as character ):
     2156      AddUtdErrForTab
     2157         (idb-num,
     2158          idoc-id,
     2159          iObj:table,
     2160          iObj,
     2161          iCheckType,
     2162          iCodeErr,
     2163          iCheckObj).
     2164   end.
     2165   function ClearUtdErrTypeCode returns logical
     2166   (idb-num         as integer,
     2167    idoc-id         as integer ,
     2168    iCheckType      as character,
     2169    iCodeErr        as character
     2170    ):
     2171      define buffer utd-err for utd-err.
     2172      if    iCheckType eq "*"
     2173         or iCheckType eq ?
     2174      then do:
     2175         if     iCodeErr ne ?
     2176            and iCodeErr ne "*"
     2177         then
     2178            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     2179            view-as alert-box.
     2180         else
     2181         for each utd-err where utd-err.db-num  eq idb-num
     2182                            and utd-err.doc-id  eq idoc-id
     2183         exclusive-lock:
     2184            delete utd-err.
     2185         end.
     2186      end.
     2187      else do:
     2188         if    iCodeErr eq ?
     2189            or iCodeErr eq "*"
     2190         then do:
     2191            for each utd-err where utd-err.db-num     eq idb-num
     2192                               and utd-err.doc-id     eq idoc-id
     2193                               and utd-err.CheckType  eq iCheckType
     2194            exclusive-lock:
     2195               delete utd-err.
     2196            end.
     2197         end.
     2198         else do:
     2199            for each utd-err where utd-err.db-num     eq idb-num
     2200                               and utd-err.doc-id     eq idoc-id
     2201                               and utd-err.CheckType  eq iCheckType
     2202                               and ub.utd-err.CodeErr eq iCodeErr
     2203            exclusive-lock:
     2204               delete utd-err.
     2205            end.
     2206         end.
     2207      end.
     2208   end.
     2209   function ClearUtdErr returns logical
     2210   (idb-num         as integer,
     2211    idoc-id         as integer ,
     2212    iCheckType      as character
     2213    ):
     2214      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     2215   end.
     2216   function GetMesError returns character
     2217   (itxt as character,
     2218    iobj as character ):
     2219    define variable vi as integer no-undo.
     2220    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     2221       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     2222    end.
     2223    return itxt.
     2224   end.
     2225   function GetTextErrorType returns character
     2226   (iCheckType as character,
     2227    iCodeErr   as character,
     2228    iChechObj  as character,
     2229    iType      as character  ):
     2230      define buffer code    for code.
     2231      define variable vError as character no-undo.
     2232      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2233                        and code.code   eq iCodeErr
     2234      no-lock no-error.
     2235      if available code
     2236      then do:
     2237         define variable vType as integer no-undo.
     2238         if code.misc3 eq "error"
     2239         then
     2240            vType = 0.
     2241         else if code.misc3 eq "warning"
     2242         then
     2243            vType = 1.
     2244         else if code.misc3 eq "Hiden"
     2245         then
     2246            vType = 2.
     2247         else
     2248            vtype = int(code.misc3) no-error.
     2249         case itype:
     2250            when "error"
     2251            then do:
     2252               if vtype eq 0
     2253               then
     2254                  vError = GetMesError(Code.CodeValue,iChechObj).
     2255            end.
     2256            when "warning"
     2257            then do:
     2258               if vtype <= 1
     2259               then
     2260                  vError = GetMesError(Code.CodeValue,iChechObj).
     2261            end.
     2262            otherwise do:
     2263               vError = GetMesError(Code.CodeValue,iChechObj).
     2264            end.
     2265         end.
     2266      end.
     2267      else
     2268         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     2269      return vError.
     2270   end.
     2271   function GetTypeError returns integer
     2272   (iCheckType as character,
     2273    iCodeErr   as character):
     2274      define buffer code    for code.
     2275      define variable vType as integer no-undo.
     2276      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2277                        and code.code   eq iCodeErr
     2278      no-lock no-error.
     2279      if     not available code
     2280         and code.misc3 eq "error"
     2281      then
     2282         vType = 0.
     2283      else if code.misc3 eq "warning"
     2284      then
     2285         vType = 1.
     2286      else if code.misc3 eq "Hiden"
     2287      then
     2288         vType = 2.
     2289      else
     2290         vtype = int(code.misc3) no-error.
     2291      return vtype.
     2292   end.
     2293   function GetTextError returns character
     2294   (iCheckType as character,
     2295    iCodeErr   as character,
     2296    iChechObj  as character ):
     2297      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     2298   end.
     2299   function GetErrForUtdStr returns character
     2300   (idb-num     as integer ,
     2301    idoc-id     as integer ,
     2302    iCheckType  as character
     2303    ):
     2304      define buffer utd-err for utd-err.
     2305      define buffer code    for code.
     2306      define variable vHQry as handle no-undo.
     2307      define variable vError as longchar no-undo.
     2308      define variable vErrorOne as longchar  no-undo.
     2309      define variable oError as character no-undo.
     2310      create query vHQry.
     2311      vHQry:set-buffers(buffer utd-err:handle).
     2312      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2313                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2314                               + if    iCheckType eq "*"
     2315                                    or iCheckType eq ?
     2316                                 then       ""
     2317                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2318      vHQry:query-open().
     2319      vHQry:get-first().
     2320      QRY-BLOCK:
     2321      repeat while not vHQry:query-off-end:
     2322         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2323         if     vErrorOne ne ""
     2324            and vErrorOne ne ?
     2325         then
     2326            vError = vError + ", " + vErrorOne.
     2327         vHQry:get-next().
     2328      end.
     2329      oError = substring(vError,3,4002).
     2330      return oError.
     2331   end.
     2332   function GetErrJsonForUtd returns character
     2333   (idb-num         as integer ,
     2334    idoc-id         as integer ,
     2335    iCheckType      as character
     2336    ):
     2337      define buffer utd-err for utd-err.
     2338      define variable vHQry as handle no-undo.
     2339      define variable vError as longchar no-undo.
     2340      define variable oError as character no-undo.
     2341      create query vHQry.
     2342      define variable vi as integer no-undo.
     2343      vHQry:set-buffers(buffer utd-err:handle).
     2344      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2345                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2346                               + if    iCheckType eq "*"
     2347                                    or iCheckType eq ?
     2348                                 then       ""
     2349                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2350      vHQry:query-open().
     2351      vHQry:get-first().
     2352      QRY-BLOCK:
     2353      repeat while not vHQry:query-off-end:
     2354         define variable vErrorOne as character no-undo.
     2355         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2356         if     vErrorOne ne ?
     2357            and vErrorOne ne ""
     2358         then do:
     2359            vi = vi + 1.
     2360            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     2361                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     2362                            + '","ТекстОш":"' + vErrorOne + '"}'.
     2363         end.
     2364         vHQry:get-next().
     2365      end.
     2366      for first utd where utd.db-num eq idb-num
     2367                      and utd.doc-id eq idoc-id
     2368                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     2369      no-lock,
     2370         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     2371                                  and utd-marking-lines.doc-id eq idoc-id
     2372                                  and utd-marking-lines.doc-level eq 1
     2373      no-lock,
     2374         first marking where marking.mark eq utd-marking-lines.mark
     2375                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     2376      no-lock:
     2377         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     2378         if     vErrorOne ne ?
     2379            and vErrorOne ne ""
     2380         then do:
     2381            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     2382                            + '","ОбъектОш":"' + marking.mark
     2383                            + '","ТекстОш":"' + vErrorOne + '"}'.
     2384         end.
     2385      end.
     2386      if vError ne ""
     2387      then
     2388         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     2389      return oError.
     2390   end.
     2391   function GetErrJsonForUtdReturn returns character
     2392   (idb-num         as integer ,
     2393    idoc-id         as integer ,
     2394    iCheckType      as character
     2395    ):
     2396      define buffer utd-err for utd-err.
     2397      define variable vHQry as handle no-undo.
     2398      define variable vError as longchar no-undo.
     2399      define variable oError as character no-undo.
     2400      define variable vi as integer no-undo.
     2401      create query vHQry.
     2402      vHQry:set-buffers(buffer utd-err:handle).
     2403      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2404                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2405                               + if    iCheckType eq "*"
     2406                                    or iCheckType eq ?
     2407                                 then       ""
     2408                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2409      vHQry:query-open().
     2410      vHQry:get-first().
     2411      QRY-BLOCK:
     2412      repeat while not vHQry:query-off-end:
     2413         define variable vErrorOne as character no-undo.
     2414         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2415         if     vErrorOne ne ?
     2416            and vErrorOne ne ""
     2417         then do:
     2418            vi = vi + 1.
     2419            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     2420                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     2421                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     2422         end.
     2423         vHQry:get-next().
     2424      end.
     2425      if vError ne ""
     2426      then
     2427         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     2428      return oError.
     2429   end.
     2430   function GetCodeTextError returns character
     2431   (iCheckType as character,
     2432    iCodeErr   as character,
     2433    iChechObj  as character,
     2434    output oCode as character,
     2435    output ovalue as character ):
     2436      define buffer code    for code.
     2437      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2438                        and code.code   eq iCodeErr
     2439      no-lock no-error.
     2440      if     available code
     2441      then do:
     2442         define variable vi as integer no-undo init ?.
     2443         vi = int(Code.misc3) no-error.
     2444         if    code.misc3 ne "error"
     2445            and vi ne 0
     2446         then
     2447            oCode = ?.
     2448         else if     Code.misc1 ne ?
     2449                 and Code.misc1 ne ""
     2450         then
     2451            assign
     2452               oCode  = GetMesError(Code.misc1,iChechObj)
     2453               ovalue = GetMesError(Code.misc2,iChechObj)
     2454            .
     2455      end.
     2456      return if oCode eq ""
     2457             then ""
     2458             else (oCode + "_" + ovalue).
     2459   end.
     2460   define temp-table TT-err no-undo
     2461     field code_ as character
     2462     field text_ as character
     2463   index code_ code_.
     2464   function GetErrTxtForUtd returns character
     2465   (idb-num         as integer ,
     2466    idoc-id         as integer ,
     2467    iCheckType      as character
     2468    ):
     2469      define buffer utd-err for utd-err.
     2470      define variable vHQry as handle no-undo.
     2471      define variable oError as character no-undo.
     2472      create query vHQry.
     2473      define variable vi as integer no-undo.
     2474      for each tt-err :
     2475         delete tt-err.
     2476      end.
     2477      vHQry:set-buffers(buffer utd-err:handle).
     2478      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2479                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2480                               + if    iCheckType eq "*"
     2481                                    or iCheckType eq ?
     2482                                 then       ""
     2483                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2484      vHQry:query-open().
     2485      vHQry:get-first().
     2486      define variable vcode as character no-undo.
     2487      define variable vvalue as character no-undo.
     2488      QRY-BLOCK:
     2489      repeat while not vHQry:query-off-end:
     2490         vi = vi + 1.
     2491         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     2492         if vcode ne ?
     2493         then do:
     2494            find first tt-err where tt-err.code eq vcode
     2495            no-error.
     2496            if not available tt-err
     2497            then do:
     2498               create tt-err.
     2499               assign
     2500                  tt-err.code_ = vcode
     2501                  tt-err.text_ = vvalue
     2502               .
     2503            end.
     2504            else
     2505               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2506         end.
     2507         vHQry:get-next().
     2508      end.
     2509     find first utd where utd.db-num eq idb-num
     2510                         and utd.doc-id eq idoc-id
     2511         no-lock.
     2512      define buffer cancel_utd-lines for utd-lines.
     2513      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     2514                                  and cancel_utd-lines.doc-id eq idoc-id
     2515      no-lock:
     2516         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     2517         then do:
     2518            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     2519                                        and utd-marking-lines.doc-id eq idoc-id
     2520                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     2521            no-lock,
     2522               first marking where marking.mark eq utd-marking-lines.mark
     2523                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     2524            no-lock:
     2525               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     2526               find first tt-err where tt-err.code eq vcode
     2527               no-error.
     2528               if not available tt-err
     2529               then do:
     2530                  create tt-err.
     2531                  assign
     2532                     tt-err.code_ = vcode
     2533                     tt-err.text_ = vvalue
     2534                  .
     2535               end.
     2536               else
     2537                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2538            end.
     2539         end.
     2540         else do:
     2541            define variable vqnty as decimal no-undo.
     2542            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     2543            if vqnty eq ? then vqnty = 0.
     2544            if vqnty ne cancel_utd-lines.Quantity
     2545            then do:
     2546               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     2547               find first tt-err where tt-err.code eq vcode
     2548               no-error.
     2549               if not available tt-err
     2550               then do:
     2551                  create tt-err.
     2552                  assign
     2553                     tt-err.code_ = vcode
     2554                     tt-err.text_ = vvalue
     2555                  .
     2556               end.
     2557               else
     2558                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2559            end.
     2560         end.
     2561      end.
     2562      for each tt-err:
     2563         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     2564      end.
     2565      return oError.
     2566   end.
     2567   define variable mFormatErr as character no-undo init "text".
     2568   function GetErrForUtd returns character
     2569   (idb-num         as integer ,
     2570    idoc-id         as integer ,
     2571    iType           as character
     2572    ):
     2573      if mFormatErr eq "text"
     2574      then
     2575         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     2576      else do:
     2577         if itype eq "return"
     2578         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     2579         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     2580      end.
     2581   end.
     2582   function GetErrComText returns longchar
     2583   (icomment as character,
     2584    itext    as longchar ):
     2585       define variable vText as longchar no-undo.
     2586      if mFormatErr eq "text"
     2587      then do:
     2588         if icomment ne ""
     2589         then
     2590            icomment = substitute("comment:|&1|",icomment).
     2591         vText = icomment + itext.
     2592      end.
     2593      else do:
     2594         icomment = if icomment begins  '"'
     2595                    then icomment
     2596                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     2597         vText = icomment + "," + itext.
     2598         vText = "~{" + trim(vText,",") + "~}".
     2599      end.
     2600      return vText.
     2601   end.
     2602   function CheckTypeForMarkLineType returns logical
     2603   (iObj            as handle,
     2604    iCheckType      as character,
     2605    iCodeErr        as character ,
     2606    iTypeErr        as character ):
     2607      define variable vRecKey-markLine as character no-undo.
     2608      define variable vGoodMark        as logical no-undo.
     2609      define variable vdb-num          as integer no-undo.
     2610      define variable vdoc-id          as integer no-undo.
     2611      define variable vlinenum         as integer no-undo.
     2612      define variable vErrorOne as character no-undo.
     2613      define buffer buf_utd-err for utd-err.
     2614      run gen-key-rec (input "utd-marking-lines",
     2615                       input  iObj,
     2616                       output vRecKey-markLine).
     2617      vGoodMark = yes.
     2618      vdb-num = iObj::db-num.
     2619      vdoc-id = iObj::doc-id.
     2620      vlinenum = iObj::linenum.
     2621      block-mark-err:
     2622      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2623                               and buf_utd-err.db-num = vdb-num
     2624                               and buf_utd-err.reckey = vRecKey-markLine
     2625                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     2626                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     2627      no-lock:
     2628         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     2629         if     vErrorOne ne ?
     2630            and vErrorOne ne ""
     2631         then do:
     2632            vGoodMark = no.
     2633            leave block-mark-err.
     2634         end.
     2635      end.
     2636      return not vGoodMark.
     2637   end.
     2638   function CheckErrForMarkLineType returns logical
     2639   (iObj            as handle,
     2640    iType           as character  ):
     2641      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     2642   end.
     2643   function CheckErrForMarkLine returns logical
     2644   (iObj            as handle):
     2645      return CheckErrForMarkLineType(iObj,"*").
     2646   end.
     2647   function CheckErrForLineTypeCode returns logical
     2648   (iObj                 as handle,
     2649    iCheckType           as character,
     2650    iCodeErr             as character,
     2651    iTypeErr             as character,
     2652    iOneErr              as logical):
     2653      define variable vRecKey-line     as character no-undo.
     2654      define buffer buf_utd-err for utd-err.
     2655      define variable vUtdlineError as logical no-undo.
     2656      define variable vErrorOne as character no-undo.
     2657            run gen-key-rec (input "utd-lines",
     2658                             input  iObj,
     2659                             output vRecKey-line).
     2660         define variable vdb-num as integer no-undo.
     2661         define variable vdoc-id as integer no-undo.
     2662         define variable vlinenum as integer no-undo.
     2663         vdb-num = iObj::db-num.
     2664         vdoc-id = iObj::doc-id.
     2665         vlinenum = iObj::linenum.
     2666         block-err:
     2667         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2668                                  and buf_utd-err.db-num = vdb-num
     2669                                  and buf_utd-err.reckey = vRecKey-line
     2670                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     2671                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     2672         no-lock:
     2673            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     2674            if     vErrorOne ne ?
     2675               and vErrorOne ne ""
     2676            then do:
     2677               vUtdlineError = yes.
     2678               leave block-err.
     2679            end.
     2680         end.
     2681         if  not vUtdlineError
     2682         then do:
     2683            define variable vGoodMark as logical no-undo.
     2684            vGoodMark = yes.
     2685            block-line-err:
     2686            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     2687                                         and utd-marking-lines.doc-id  eq vdoc-id
     2688                                         and utd-marking-lines.LineNum eq vLineNum
     2689            no-lock:
     2690               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     2691               if     vGoodMark
     2692                  and iOneErr eq no
     2693               then
     2694                  leave block-line-err.
     2695               if     iOneErr = yes
     2696                  and not vGoodMark
     2697               then
     2698                  leave block-line-err.
     2699            end.
     2700            vUtdlineError = not vGoodMark.
     2701         end.
     2702      return vUtdlineError.
     2703   end.
     2704   function getErrForLineType returns character
     2705   (iObj            as handle,
     2706    iType           as character  ):
     2707      define variable vRecKey-line     as character no-undo.
     2708      define buffer buf_utd-err for utd-err.
     2709      define variable vUtdlineError as logical no-undo.
     2710      define variable vErrorOne as character no-undo.
     2711      define variable oError as character no-undo.
     2712            run gen-key-rec (input "utd-lines",
     2713                             input  iObj,
     2714                             output vRecKey-line).
     2715         define variable vdb-num as integer no-undo.
     2716         define variable vdoc-id as integer no-undo.
     2717         define variable vlinenum as integer no-undo.
     2718         vdb-num = iObj::db-num.
     2719         vdoc-id = iObj::doc-id.
     2720         vlinenum = iObj::linenum.
     2721         block-err:
     2722         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2723                                  and buf_utd-err.db-num = vdb-num
     2724                                  and buf_utd-err.reckey = vRecKey-line
     2725                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     2726         no-lock:
     2727            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     2728            if     vErrorOne ne ?
     2729               and vErrorOne ne ""
     2730            then do:
     2731               oError = oError + vErrorOne + " ".
     2732            end.
     2733         end.
     2734      return oError.
     2735   end.
     2736   function CheckErrForLineType returns logical
     2737   (iObj            as handle,
     2738    iType           as character  ):
     2739       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     2740   end.
     2741   function CheckErrForLine returns logical
     2742   (iObj            as handle):
     2743      return CheckErrForLineType(iobj,"*").
     2744   end.
     2745   function CheckErrForUtd returns logical
     2746   (idb-num         as integer ,
     2747    idoc-id         as integer ):
     2748      for each utd-lines where utd-lines.db-num eq idb-num
     2749                           and utd-lines.doc-id eq idoc-id
     2750      no-lock :
     2751         if not CheckErrForLine (buffer ub.utd-lines:handle)
     2752         then
     2753            return no.
     2754      end.
     2755      return yes.
     2756   end.
     2757   function CheckMarkUtd-28rel return logical
     2758    (input idb-num as integer,
     2759    input idoc-id as integer):
     2760    define buffer utd                   for utd.
     2761    define buffer utd-lines             for utd-lines.
     2762    define buffer utd-marking-lines     for utd-marking-lines.
     2763    define variable v-par-type as character no-undo.
     2764    define variable vgdsNoMark as logical no-undo.
     2765    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2766      define variable v-par-val  as character no-undo.
     2767      find first utd where utd.db-num eq idb-num
     2768                       and utd.doc-id eq idoc-id
     2769      no-lock no-error.
     2770      if available utd
     2771      then do:
     2772         if     utd.obj-code ne ?
     2773            and utd.obj-type ne ?
     2774         then do:
     2775            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     2776            Block-utd-lines:
     2777            for each utd-lines where utd-lines.db-num eq idb-num
     2778                                 and utd-lines.doc-id eq idoc-id
     2779            no-lock:
     2780               if     utd-lines.gds-code ne ?
     2781                  and utd-lines.gds-code ne 0
     2782               then do:
     2783                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2784                       ( utd-lines.gds-code,
     2785                         'mark-type':U,
     2786                          output v-par-val,
     2787                          output v-par-type
     2788                       ).
     2789                  if     EDOParSec:IsEdo
     2790                     and EDOParSec:GetIsEDOForType(v-par-val)
     2791                  then do:
     2792                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     2793                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     2794                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     2795                                                    and length(utd-marking-lines.mark) > 13
     2796                     no-lock no-error.
     2797                     if     avail utd-marking-lines
     2798                        and not CheckErrForLine(buffer utd-lines:handle)
     2799                     then
     2800                        leave Block-utd-lines.
     2801                  end.
     2802                  else
     2803                     vgdsNoMark = yes.
     2804               end.
     2805            end.
     2806            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     2807            if vgdsNoMark then return available utd-lines . else return yes .
     2808         end.
     2809      end.
     2810      return yes.
     2811   end.
     2812   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2813   def var Marking as class mark no-undo .
     2814   define buffer buf_utd-err for ub.utd-err .
     2815   FUNCTION StatusTHName RETURNS CHARACTER
     2816     (input p-stsTH as integer)  .
     2817     Return Marking:GetLabel(p-stsTH) .
     2818   END FUNCTION .
     2819   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
     2820        LABEL "Отмена"
     2821        SIZE 15 BY 1.13
     2822        BGCOLOR 8 .
     2823   DEFINE BUTTON Btn_OK AUTO-GO
     2824        LABEL "Ввод"
     2825        SIZE 15 BY 1.13
     2826        BGCOLOR 8 .
     2827   DEFINE VARIABLE EDITOR-2 AS CHARACTER
     2828        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     2829        SIZE 128 BY 4.5 NO-UNDO.
     2830   DEFINE VARIABLE f-error AS CHARACTER
     2831        VIEW-AS EDITOR NO-WORD-WRAP SCROLLBAR-HORIZONTAL SCROLLBAR-VERTICAL
     2832        SIZE 79 BY 8.25 NO-UNDO.
     2833   DEFINE QUERY BROWSE-2 FOR
     2834         tt-utd-err SCROLLING.
     2835   DEFINE BROWSE BROWSE-2
     2836     QUERY BROWSE-2 NO-LOCK DISPLAY
     2837         tt-utd-err.LineNum COLUMN-LABEL "№" FORMAT "999":U
     2838         tt-utd-err.gds-code COLUMN-LABEL "Код товара" FORMAT ">>>>>>>>>>>>9":U
     2839         tt-utd-err.CheckType FORMAT "x(15)":U
     2840         tt-utd-err.CodeErr FORMAT "x(15)":U
     2841         tt-utd-err.descr FORMAT "x(256)":U
     2842       WITH NO-ROW-MARKERS SEPARATORS SIZE 128 BY 8.25
     2843            FONT 2 .
     2844   DEFINE FRAME Dialog-Frame
     2845        Btn_OK AT ROW 1 COL 1
     2846        Btn_Cancel AT ROW 1 COL 16
     2847        f-error AT ROW 3.5 COL 2 NO-LABEL WIDGET-ID 14
     2848        BROWSE-2 AT ROW 3.5 COL 2 WIDGET-ID 200
     2849        EDITOR-2 AT ROW 12.83 COL 2 NO-LABEL WIDGET-ID 20
     2850        "Сформированные ошибки:" VIEW-AS TEXT
     2851             SIZE 27 BY .67 AT ROW 2.5 COL 2.5 WIDGET-ID 16
     2852        "Введите комментарий:" VIEW-AS TEXT
     2853             SIZE 20 BY .67 AT ROW 12 COL 2 WIDGET-ID 22
     2854        SPACE(108.00) SKIP(4.86)
     2855       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2856            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2857            TITLE "Ошибки документа"
     2858            DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel WIDGET-ID 100.
     2859   ASSIGN
     2860          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2861          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2862   ASSIGN
     2863          BROWSE-2:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     2864   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2865   DO:
     2866       APPLY "END-ERROR":U TO SELF.
     2867     END.
     2868   ON choose OF Btn_OK IN FRAME Dialog-Frame
     2869   DO:
     2870       p-ok = yes .
     2871     END.
     2872   ON LEAVE OF EDITOR-2 IN FRAME Dialog-Frame
     2873   DO:
     2874       assign
     2875       editor-2 .
     2876       p-comment = EDITOR-2 .
     2877     END.
     2878   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2879     THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2880   MAIN-BLOCK:
     2881   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2882     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2883     Marking = ObjSrv:Env:Marking:Sts:Mark.
     2884     if p-info <> "" then f-error = p-info .
     2885     run init-temp .
     2886   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2887   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2888   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2889   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2890   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2891   define variable v-diasize-current-frame-height as decimal   no-undo .
     2892   define variable v-diasize-change-size          as logical   no-undo .
     2893   define variable v-diasize-resize-button        as handle    no-undo .
     2894   define variable v-diasize-wndmax               as logical   no-undo .
     2895   define variable v-diasize-wndstore             as logical   no-undo .
     2896   define variable v-diasize-proc-name            as character no-undo .
     2897   define variable v-diasize-browse-handle        as handle    no-undo .
     2898   define variable v-diasize-browse-number        as integer   no-undo .
     2899   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2900   define temp-table temp-diasize-handle no-undo
     2901     field handle-value  as handle
     2902     field save-position as decimal
     2903     index xpk is primary unique handle-value
     2904     .
     2905   define temp-table temp-browse-handle no-undo
     2906     field browse-type   as character
     2907     field browse-number as integer
     2908     field browse-handle as handle
     2909     field original-size as decimal
     2910     index xpk is primary unique browse-type browse-number
     2911     index xie browse-type browse-handle
     2912   .
     2913   procedure diasize_change-height :
     2914     define input  parameter p-change-value  as decimal   no-undo .
     2915     define input  parameter p-move-resize   as logical   no-undo .
     2916     define variable v-field-group-handle    as handle    no-undo .
     2917     define variable v-object-handle         as handle    no-undo .
     2918     define variable v-frame-height          as decimal   no-undo .
     2919     define variable v-frame-virtual-height  as decimal   no-undo .
     2920     define variable v-browse-height         as decimal   no-undo .
     2921     define variable v-window-height         as decimal   no-undo .
     2922     define variable v-window-virtual-height as decimal   no-undo .
     2923     define variable v-change-sign           as integer   no-undo .
     2924     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2925     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2926     if p-change-value > 0
     2927     then do:
     2928       if frame Dialog-Frame :height + p-change-value
     2929           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2930       then do:
     2931         assign
     2932           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2933                           - (frame Dialog-Frame :height-chars)
     2934         .
     2935         if p-change-value <= 0
     2936         then do:
     2937           run diasize_position-resize-button in this-procedure .
     2938           return .
     2939         end.
     2940       end.
     2941     end.
     2942     if p-change-value < 0
     2943     then do:
     2944       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2945       then do:
     2946         assign
     2947           p-change-value = v-diasize-orig-frame-height
     2948                          - (frame Dialog-Frame :height-chars)
     2949         .
     2950         if p-change-value >= 0
     2951         then do:
     2952           run diasize_position-resize-button in this-procedure .
     2953           return .
     2954         end.
     2955       end.
     2956     end.
     2957     if p-change-value >= 0
     2958     then do:
     2959       assign
     2960         v-change-sign = 1
     2961       .
     2962     end.
     2963     else do:
     2964       assign
     2965         v-change-sign = -1
     2966       .
     2967     end.
     2968     assign
     2969       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2970     .
     2971     if p-change-value = 0
     2972     then do:
     2973       run diasize_position-resize-button in this-procedure .
     2974       return .
     2975     end.
     2976     move_block:
     2977     do
     2978     on error undo move_block, retry move_block
     2979     :
     2980       if retry
     2981       then do:
     2982         do
     2983         on error undo move_block, leave move_block
     2984         :
     2985           if p-change-value > 0
     2986           then do:
     2987             for each buf_temp-diasize-handle
     2988             on error undo, next
     2989             :
     2990               assign
     2991                 v-object-handle = buf_temp-diasize-handle.handle-value
     2992               .
     2993               if v-object-handle <> v-diasize-resize-button
     2994               then do:
     2995                 assign
     2996                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2997                 .
     2998               end.
     2999             end.
     3000             assign
     3001               v-diasize-browse-handle :height = v-browse-height
     3002             .
     3003             for each buf_temp-browse-handle
     3004               where buf_temp-browse-handle.browse-type = 'height':u
     3005             on error undo, next
     3006             :
     3007               assign
     3008                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3009               .
     3010             end.
     3011             assign
     3012               frame Dialog-Frame :height = v-frame-height
     3013             .
     3014             if frame Dialog-Frame :scrollable = true
     3015             then do:
     3016               assign
     3017                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3018               .
     3019             end.
     3020             run diasize_position-resize-button in this-procedure .
     3021           end.
     3022           else do:
     3023             if frame Dialog-Frame :scrollable = true
     3024             then do:
     3025               assign
     3026                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3027               .
     3028             end.
     3029             assign
     3030               frame Dialog-Frame :height = v-frame-height
     3031             .
     3032             assign
     3033               v-diasize-browse-handle :height = v-browse-height
     3034             .
     3035             for each buf_temp-browse-handle
     3036               where buf_temp-browse-handle.browse-type = 'height':u
     3037             on error undo, next
     3038             :
     3039               assign
     3040                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3041               .
     3042             end.
     3043             for each buf_temp-diasize-handle
     3044             on error undo, next
     3045             :
     3046               assign
     3047                 v-object-handle = buf_temp-diasize-handle.handle-value
     3048               .
     3049               if v-object-handle <> v-diasize-resize-button
     3050               then do:
     3051                 assign
     3052                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3053                 .
     3054               end.
     3055             end.
     3056             run diasize_position-resize-button in this-procedure .
     3057           end.
     3058           assign
     3059             v-diasize-change-size = false
     3060           .
     3061           leave move_block .
     3062         end.
     3063       end.
     3064       assign
     3065         v-diasize-need-full-display = true
     3066       .
     3067       if v-diasize-change-size = false
     3068       then do:
     3069         assign
     3070           v-diasize-change-size = true
     3071         .
     3072       end.
     3073       else do:
     3074         return .
     3075       end.
     3076       assign
     3077         v-frame-height = frame Dialog-Frame :height
     3078         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     3079         v-browse-height = v-diasize-browse-handle :height
     3080       .
     3081       for each buf_temp-browse-handle
     3082         where buf_temp-browse-handle.browse-type = 'height':u
     3083       :
     3084         assign
     3085           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     3086         .
     3087       end.
     3088       for each buf_temp-diasize-handle
     3089       :
     3090         delete buf_temp-diasize-handle .
     3091       end.
     3092       assign
     3093         v-field-group-handle = frame Dialog-Frame :first-child
     3094       .
     3095       do while valid-handle(v-field-group-handle)
     3096       :
     3097         assign
     3098           v-object-handle = v-field-group-handle :first-child
     3099         .
     3100         do while valid-handle(v-object-handle)
     3101         :
     3102           if  v-object-handle <> v-diasize-browse-handle :handle
     3103           and can-query(v-object-handle, "row")
     3104           and can-query(v-object-handle, "height")
     3105           and ( v-object-handle :row > v-diasize-browse-handle :row )
     3106           then do:
     3107             find first buf_temp-browse-handle
     3108               where buf_temp-browse-handle.browse-type   = 'height':u
     3109                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3110               no-error .
     3111             if available buf_temp-browse-handle
     3112             then do:
     3113             end.
     3114             else do:
     3115               create buf_temp-diasize-handle .
     3116               assign
     3117                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3118                 buf_temp-diasize-handle.save-position = v-object-handle :row
     3119               .
     3120             end.
     3121           end.
     3122           assign
     3123             v-object-handle = v-object-handle :next-sibling
     3124           .
     3125         end.
     3126         assign
     3127           v-field-group-handle = v-field-group-handle :next-sibling
     3128         .
     3129       end.
     3130       do with frame Dialog-Frame
     3131       :
     3132         hide v-diasize-resize-button .
     3133         assign
     3134           v-diasize-resize-button :row    = 1
     3135           v-diasize-resize-button :column = 1
     3136         .
     3137       end.
     3138       if p-change-value > 0
     3139       then do:
     3140         if frame Dialog-Frame :scrollable = true
     3141         then do:
     3142           assign
     3143             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3144             no-error .
     3145           if error-status :error
     3146           or error-status :get-message(1) <> ""
     3147           then do:
     3148             undo move_block, retry move_block .
     3149           end.
     3150         end.
     3151         assign
     3152           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3153           no-error .
     3154         if error-status :error
     3155         or error-status :get-message(1) <> ""
     3156         then do:
     3157           undo move_block, retry move_block .
     3158         end.
     3159         assign
     3160           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3161           no-error .
     3162         if error-status :error
     3163         or error-status :get-message(1) <> ""
     3164         then do:
     3165           undo move_block, retry move_block .
     3166         end.
     3167         for each buf_temp-browse-handle
     3168           where buf_temp-browse-handle.browse-type = 'height':u
     3169         on error undo move_block, retry move_block
     3170         :
     3171           assign
     3172             buf_temp-browse-handle.browse-handle :height
     3173               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3174             no-error .
     3175           if error-status :error
     3176           or error-status :get-message(1) <> ""
     3177           then do:
     3178             undo move_block, retry move_block .
     3179           end.
     3180         end.
     3181         for each buf_temp-diasize-handle
     3182         on error undo move_block, retry move_block
     3183         :
     3184           assign
     3185             v-object-handle = buf_temp-diasize-handle.handle-value
     3186           .
     3187           if v-object-handle <> v-diasize-resize-button
     3188           then do:
     3189             assign
     3190               v-object-handle :row = v-object-handle :row + p-change-value
     3191               no-error .
     3192             if error-status :error
     3193             or error-status :get-message(1) <> ""
     3194             then do:
     3195               undo move_block, retry move_block .
     3196             end.
     3197           end.
     3198         end.
     3199       end.
     3200       else do:
     3201         for each buf_temp-diasize-handle
     3202         on error undo move_block, retry move_block
     3203         :
     3204           assign
     3205             v-object-handle = buf_temp-diasize-handle.handle-value
     3206           .
     3207           if v-object-handle <> v-diasize-resize-button
     3208           then do:
     3209             assign
     3210               v-object-handle :row = v-object-handle :row + p-change-value
     3211               no-error .
     3212             if error-status :error
     3213             or error-status :get-message(1) <> ""
     3214             then do:
     3215               undo move_block, retry move_block .
     3216             end.
     3217           end.
     3218         end.
     3219         assign
     3220           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3221           no-error .
     3222         if error-status :error
     3223         or error-status :get-message(1) <> ""
     3224         then do:
     3225           undo move_block, retry move_block .
     3226         end.
     3227         for each buf_temp-browse-handle
     3228           where buf_temp-browse-handle.browse-type = 'height':u
     3229         on error undo move_block, retry move_block
     3230         :
     3231           assign
     3232             buf_temp-browse-handle.browse-handle :height
     3233               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3234             no-error .
     3235           if error-status :error
     3236           or error-status :get-message(1) <> ""
     3237           then do:
     3238             undo move_block, retry move_block .
     3239           end.
     3240         end.
     3241         assign
     3242           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3243           no-error .
     3244         if error-status :error
     3245         or error-status :get-message(1) <> ""
     3246         then do:
     3247           undo move_block, retry move_block .
     3248         end.
     3249         if frame Dialog-Frame :scrollable = true
     3250         then do:
     3251           assign
     3252             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3253             no-error .
     3254           if error-status :error
     3255           or error-status :get-message(1) <> ""
     3256           then do:
     3257             undo move_block, retry move_block .
     3258           end.
     3259         end.
     3260       end.
     3261       if p-move-resize = true
     3262       then do:
     3263         run diasize_position-resize-button in this-procedure .
     3264       end.
     3265       if v-diasize-wndstore = true
     3266       then do:
     3267         if connected("ub") = true
     3268         then do:
     3269           define variable v-cntxt-db-num        as integer   no-undo .
     3270           define variable v-cntxt-userid        as character no-undo .
     3271           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3272                                             , OUTPUT v-cntxt-userid
     3273                                             ) .
     3274           run gbl/wndsizew.p
     3275             (input  v-cntxt-db-num
     3276             ,input  v-cntxt-userid
     3277             ,input  v-diasize-proc-name
     3278             ,input  'height':u
     3279             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3280             ) .
     3281         end.
     3282       end.
     3283     end.
     3284     assign
     3285       v-diasize-change-size = false
     3286     .
     3287   end procedure.
     3288   procedure diasize_set-height :
     3289     define input  parameter p-new-height  as decimal   no-undo .
     3290     define input  parameter p-move-resize as logical   no-undo .
     3291     do
     3292     on error undo, return error return-value
     3293     :
     3294       run diasize_change-height in this-procedure
     3295         (input  (p-new-height - frame Dialog-Frame :height)
     3296         ,input  p-move-resize
     3297         ) .
     3298     end.
     3299   end procedure.
     3300   procedure diasize_change-width :
     3301     define input  parameter p-change-value as decimal   no-undo .
     3302     define input  parameter p-move-resize  as logical   no-undo .
     3303     define variable v-field-group-handle   as handle    no-undo .
     3304     define variable v-object-handle        as handle    no-undo .
     3305     define variable v-frame-width          as decimal   no-undo .
     3306     define variable v-frame-virtual-width  as decimal   no-undo .
     3307     define variable v-browse-width         as decimal   no-undo .
     3308     define variable v-window-width         as decimal   no-undo .
     3309     define variable v-window-virtual-width as decimal   no-undo .
     3310     define variable v-change-sign          as integer   no-undo .
     3311     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3312     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3313     if p-change-value > 0
     3314     then do:
     3315       if frame Dialog-Frame :width + p-change-value >
     3316           session :width-chars
     3317       then do:
     3318         assign
     3319           p-change-value = session :width-chars - frame Dialog-Frame :width
     3320         .
     3321         if p-change-value <= 0
     3322         then do:
     3323           run diasize_position-resize-button in this-procedure .
     3324           return .
     3325         end.
     3326       end.
     3327     end.
     3328     if p-change-value < 0
     3329     then do:
     3330       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3331       then do:
     3332         assign
     3333           p-change-value = v-diasize-orig-frame-width
     3334                          - frame Dialog-Frame :width
     3335         .
     3336         if p-change-value >= 0
     3337         then do:
     3338           run diasize_position-resize-button in this-procedure .
     3339           return .
     3340         end.
     3341       end.
     3342     end.
     3343     if p-change-value >= 0
     3344     then do:
     3345       assign
     3346         v-change-sign = 1
     3347       .
     3348     end.
     3349     else do:
     3350       assign
     3351         v-change-sign = -1
     3352       .
     3353     end.
     3354     assign
     3355       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3356     .
     3357     if p-change-value = 0
     3358     then do:
     3359       run diasize_position-resize-button in this-procedure .
     3360       return .
     3361     end.
     3362     move_block:
     3363     do
     3364     on error undo move_block, leave move_block
     3365     :
     3366       if retry
     3367       then do:
     3368         do
     3369         on error undo move_block, leave move_block
     3370         :
     3371           if p-change-value > 0
     3372           then do:
     3373             for each buf_temp-diasize-handle
     3374             on error undo, next
     3375             :
     3376               assign
     3377                 v-object-handle = buf_temp-diasize-handle.handle-value
     3378               .
     3379               if v-object-handle <> v-diasize-resize-button
     3380               then do:
     3381                 assign
     3382                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3383                 .
     3384               end.
     3385             end.
     3386             assign
     3387               v-diasize-browse-handle :width = v-browse-width
     3388             .
     3389             for each buf_temp-browse-handle
     3390               where buf_temp-browse-handle.browse-type = 'width':u
     3391             on error undo, next
     3392             :
     3393               assign
     3394                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3395               .
     3396             end.
     3397             assign
     3398               frame Dialog-Frame :width = v-frame-width
     3399             .
     3400             if frame Dialog-Frame :scrollable = true
     3401             then do:
     3402               assign
     3403                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3404               .
     3405             end.
     3406             run diasize_position-resize-button in this-procedure .
     3407           end.
     3408           else do:
     3409             if frame Dialog-Frame :scrollable = true
     3410             then do:
     3411               assign
     3412                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3413               .
     3414             end.
     3415             assign
     3416               frame Dialog-Frame :width = v-frame-width
     3417             .
     3418             for each buf_temp-browse-handle
     3419               where buf_temp-browse-handle.browse-type = 'width':u
     3420             on error undo, next
     3421             :
     3422               assign
     3423                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3424               .
     3425             end.
     3426             assign
     3427               v-diasize-browse-handle :width = v-browse-width
     3428             .
     3429             for each buf_temp-diasize-handle
     3430             on error undo, next
     3431             :
     3432               assign
     3433                 v-object-handle = buf_temp-diasize-handle.handle-value
     3434               .
     3435               if v-object-handle <> v-diasize-resize-button
     3436               then do:
     3437                 assign
     3438                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3439                 .
     3440               end.
     3441             end.
     3442             run diasize_position-resize-button in this-procedure .
     3443           end.
     3444           assign
     3445             v-diasize-change-size = false
     3446           .
     3447           leave move_block .
     3448         end.
     3449       end.
     3450       assign
     3451         v-diasize-need-full-display = true
     3452       .
     3453       if v-diasize-change-size = false
     3454       then do:
     3455         assign
     3456           v-diasize-change-size = true
     3457         .
     3458       end.
     3459       else do:
     3460         return .
     3461       end.
     3462       assign
     3463         v-frame-width = frame Dialog-Frame :width
     3464         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3465         v-browse-width = v-diasize-browse-handle :width
     3466       .
     3467       for each buf_temp-browse-handle
     3468         where buf_temp-browse-handle.browse-type = 'width':u
     3469       :
     3470         assign
     3471           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3472         .
     3473       end.
     3474       for each buf_temp-diasize-handle
     3475       :
     3476         delete buf_temp-diasize-handle .
     3477       end.
     3478       assign
     3479         v-field-group-handle = frame Dialog-Frame :first-child
     3480       .
     3481       do while valid-handle(v-field-group-handle)
     3482       :
     3483         assign
     3484           v-object-handle = v-field-group-handle :first-child
     3485         .
     3486         do while valid-handle(v-object-handle)
     3487         :
     3488           if  v-object-handle <> v-diasize-browse-handle :handle
     3489           and v-object-handle <> v-diasize-resize-button
     3490           and can-query(v-object-handle, "row")
     3491           and can-query(v-object-handle, "height")
     3492           and ( v-object-handle :col + v-object-handle :width
     3493                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3494               )
     3495           then do:
     3496             find first buf_temp-browse-handle
     3497               where buf_temp-browse-handle.browse-type   = 'width':u
     3498                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3499               no-error .
     3500             if available buf_temp-browse-handle
     3501             then do:
     3502             end.
     3503             else do:
     3504               create buf_temp-diasize-handle .
     3505               assign
     3506                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3507                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3508               .
     3509             end.
     3510           end.
     3511           assign
     3512             v-object-handle = v-object-handle :next-sibling
     3513           .
     3514         end.
     3515         assign
     3516           v-field-group-handle = v-field-group-handle :next-sibling
     3517         .
     3518       end.
     3519       do with frame Dialog-Frame
     3520       :
     3521         hide v-diasize-resize-button .
     3522         v-diasize-resize-button :row = 1.
     3523         v-diasize-resize-button :column = 1.
     3524       end.
     3525       if p-change-value > 0
     3526       then do:
     3527         if frame Dialog-Frame :scrollable = true
     3528         then do:
     3529           assign
     3530             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3531             no-error .
     3532           if error-status :error
     3533           or error-status :get-message(1) <> ""
     3534           then do:
     3535             undo move_block, retry move_block.
     3536           end.
     3537         end.
     3538         assign
     3539           frame Dialog-Frame :width = v-frame-width + p-change-value
     3540           no-error .
     3541         if error-status :error
     3542         or error-status :get-message(1) <> ""
     3543         then do:
     3544           undo move_block, retry move_block.
     3545         end.
     3546         assign
     3547           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3548         no-error .
     3549         if error-status :error
     3550         or error-status :get-message(1) <> ""
     3551         then do:
     3552           undo move_block, retry move_block.
     3553         end.
     3554         for each buf_temp-browse-handle
     3555           where buf_temp-browse-handle.browse-type = 'width':u
     3556         on error undo move_block, retry move_block
     3557         :
     3558           assign
     3559             buf_temp-browse-handle.browse-handle :width
     3560               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3561             no-error .
     3562           if error-status :error
     3563           or error-status :get-message(1) <> ""
     3564           then do:
     3565             undo move_block, retry move_block .
     3566           end.
     3567         end.
     3568         for each buf_temp-diasize-handle
     3569         on error undo move_block, retry move_block
     3570         :
     3571           assign
     3572             v-object-handle = buf_temp-diasize-handle.handle-value
     3573           .
     3574           if v-object-handle <> v-diasize-resize-button
     3575           then do:
     3576             assign
     3577               v-object-handle :col = v-object-handle :col + p-change-value
     3578               no-error .
     3579             if error-status :error
     3580             or error-status :get-message(1) <> ""
     3581             then do:
     3582               undo move_block, retry move_block .
     3583             end.
     3584           end.
     3585         end.
     3586       end.
     3587       else do:
     3588         for each buf_temp-diasize-handle
     3589         on error undo move_block, retry move_block
     3590         :
     3591           assign
     3592             v-object-handle = buf_temp-diasize-handle.handle-value
     3593           .
     3594           if v-object-handle <> v-diasize-resize-button
     3595           then do:
     3596             assign
     3597               v-object-handle :col = v-object-handle :col + p-change-value
     3598               no-error .
     3599             if error-status :error
     3600             or error-status :get-message(1) <> ""
     3601             then do:
     3602               undo move_block, retry move_block .
     3603             end.
     3604           end.
     3605         end.
     3606         for each buf_temp-browse-handle
     3607           where buf_temp-browse-handle.browse-type = 'width':u
     3608         on error undo move_block, retry move_block
     3609         :
     3610           assign
     3611             buf_temp-browse-handle.browse-handle :width
     3612               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3613             no-error .
     3614           if error-status :error
     3615           or error-status :get-message(1) <> ""
     3616           then do:
     3617             undo move_block, retry move_block .
     3618           end.
     3619         end.
     3620         assign
     3621           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3622           no-error .
     3623         if error-status :error
     3624         or error-status :get-message(1) <> ""
     3625         then do:
     3626           undo move_block, retry move_block.
     3627         end.
     3628         assign
     3629           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3630         no-error .
     3631         if error-status :error
     3632         or error-status :get-message(1) <> ""
     3633         then do:
     3634           undo move_block, retry move_block.
     3635         end.
     3636         if frame Dialog-Frame :scrollable = true
     3637         then do:
     3638           assign
     3639             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3640           no-error .
     3641           if error-status :error
     3642           or error-status :get-message(1) <> ""
     3643           then do:
     3644             undo move_block, retry move_block.
     3645           end.
     3646         end.
     3647       end.
     3648       if p-move-resize
     3649       then do:
     3650         run diasize_position-resize-button in this-procedure .
     3651       end.
     3652       if v-diasize-wndstore = true
     3653       then do:
     3654         if connected("ub") = true
     3655         then do:
     3656           define variable v-cntxt-db-num        as integer   no-undo .
     3657           define variable v-cntxt-userid        as character no-undo .
     3658           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3659                                             , OUTPUT v-cntxt-userid
     3660                                             ) .
     3661           run gbl/wndsizew.p
     3662             (input  v-cntxt-db-num
     3663             ,input  v-cntxt-userid
     3664             ,input  v-diasize-proc-name
     3665             ,input  'width':u
     3666             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3667             ) .
     3668         end.
     3669       end.
     3670     end.
     3671     assign
     3672       v-diasize-change-size = false
     3673     .
     3674   end procedure.
     3675   procedure diasize_set-width :
     3676     define input  parameter p-new-width  as decimal   no-undo .
     3677     define input  parameter p-move-resize as logical   no-undo .
     3678     do
     3679     on error undo, return error return-value
     3680     :
     3681       run diasize_change-width in this-procedure
     3682         (input  (p-new-width - frame Dialog-Frame :width)
     3683         ,input  p-move-resize
     3684         ) .
     3685     end.
     3686   end procedure.
     3687   procedure diasize_position-resize-button :
     3688     do with frame Dialog-Frame
     3689     :
     3690       hide v-diasize-resize-button .
     3691       assign
     3692         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3693                     - 1
     3694                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3695         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3696                     - 1
     3697                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3698       .
     3699       view v-diasize-resize-button .
     3700     end.
     3701   end procedure.
     3702   on alt-right anywhere
     3703   do:
     3704     run diasize_change-width in this-procedure
     3705       (input 1
     3706       ,input true
     3707       ) .
     3708     return no-apply .
     3709   end.
     3710   on alt-left anywhere
     3711   do:
     3712     run diasize_change-width in this-procedure
     3713       (input -1
     3714       ,input true
     3715       ) .
     3716     return no-apply .
     3717   end.
     3718   on alt-down anywhere
     3719   do:
     3720     run diasize_change-height in this-procedure
     3721       (input 1
     3722       ,input true
     3723       ) .
     3724     return no-apply .
     3725   end.
     3726   on alt-up anywhere
     3727   do:
     3728     run diasize_change-height in this-procedure
     3729       (input -1
     3730       ,input true
     3731       ) .
     3732     return no-apply .
     3733   end.
     3734   on alt-enter of frame Dialog-Frame
     3735   do:
     3736     run diasize_maximize in this-procedure
     3737       (input  ?
     3738       ).
     3739     return no-apply .
     3740   end.
     3741   procedure diasize_end-move :
     3742     do
     3743     on error undo, return error return-value
     3744     :
     3745       define variable v-row-delta as decimal   no-undo .
     3746       define variable v-col-delta as decimal   no-undo .
     3747       define variable v-new-row as decimal   no-undo .
     3748       define variable v-new-col as decimal   no-undo .
     3749       assign
     3750         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3751         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3752       .
     3753       assign
     3754         v-row-delta = v-new-row - frame Dialog-Frame :height
     3755         v-col-delta = v-new-col - frame Dialog-Frame :width
     3756       .
     3757       run diasize_change-height in this-procedure
     3758         (input v-row-delta
     3759         ,input true
     3760         ) .
     3761       run diasize_change-width in this-procedure
     3762         (input v-col-delta
     3763         ,input true
     3764         ) .
     3765     end.
     3766   end procedure.
     3767   procedure diasize_maximize :
     3768     define input  parameter p-action as logical   no-undo .
     3769     do
     3770     on error undo, return error return-value
     3771     :
     3772       if p-action = ?
     3773       then do:
     3774         if v-diasize-need-maximize = true
     3775         then do:
     3776           assign
     3777             p-action = true
     3778           .
     3779         end.
     3780         else do:
     3781           assign
     3782             p-action = false
     3783           .
     3784         end.
     3785       end.
     3786       if p-action = true
     3787       then do:
     3788         run diasize_change-height in this-procedure
     3789           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3790               - frame Dialog-Frame :height-chars
     3791           ,input true
     3792           ) .
     3793         run diasize_change-width in this-procedure
     3794           (input session :width-chars
     3795               - frame Dialog-Frame :width-chars
     3796           ,input true
     3797           ) .
     3798         assign
     3799           v-diasize-need-maximize = false
     3800         .
     3801       end.
     3802       else do:
     3803         run diasize_change-width in this-procedure
     3804           (input v-diasize-orig-frame-width
     3805               - frame Dialog-Frame :width-chars
     3806           ,input true
     3807           ) .
     3808         run diasize_change-height in this-procedure
     3809           (input v-diasize-orig-frame-height
     3810               - frame Dialog-Frame :height-chars
     3811           ,input true
     3812           ) .
     3813         assign
     3814           v-diasize-need-maximize = true
     3815         .
     3816       end.
     3817     end.
     3818   end procedure.
     3819   procedure diasize_restore-orig-size :
     3820     do
     3821     on error undo, return error return-value
     3822     :
     3823       assign
     3824         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3825         v-diasize-current-frame-height = frame Dialog-Frame :height
     3826       .
     3827       run diasize_set-height in this-procedure
     3828         (input  v-diasize-orig-frame-height
     3829         ,input  true
     3830         ) .
     3831       run diasize_set-width in this-procedure
     3832         (input  v-diasize-orig-frame-width
     3833         ,input  true
     3834         ) .
     3835     end.
     3836   end procedure.
     3837   procedure diasize_restore-current-size :
     3838     do
     3839     on error undo, return error return-value
     3840     :
     3841       run diasize_set-height in this-procedure
     3842         (input  v-diasize-current-frame-height
     3843         ,input  true
     3844         ) .
     3845       run diasize_set-width in this-procedure
     3846         (input  v-diasize-current-frame-width
     3847         ,input  true
     3848         ) .
     3849     end.
     3850   end procedure.
     3851   procedure diasize_set-browse-handle :
     3852     define input  parameter p-browse-handle as handle   no-undo .
     3853     define buffer buf_temp-browse-handle for temp-browse-handle .
     3854     do
     3855     on error undo, return error return-value
     3856     :
     3857       assign
     3858         v-diasize-browse-handle = p-browse-handle
     3859       .
     3860       for each buf_temp-browse-handle
     3861       on error undo, return error return-value
     3862       :
     3863         delete buf_temp-browse-handle .
     3864       end.
     3865     end.
     3866   end procedure.
     3867   procedure diasize_add_browse :
     3868     define input  parameter p-browse-type   as character no-undo .
     3869     define input  parameter p-browse-handle as handle    no-undo .
     3870     define buffer buf_temp-browse-handle for temp-browse-handle .
     3871     do
     3872     on error undo, return error return-value
     3873     :
     3874       assign
     3875         v-diasize-browse-number = v-diasize-browse-number + 1
     3876       .
     3877       create buf_temp-browse-handle .
     3878       assign
     3879         buf_temp-browse-handle.browse-type   = p-browse-type
     3880         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3881         buf_temp-browse-handle.browse-handle = p-browse-handle
     3882       .
     3883     end.
     3884   end procedure.
     3885   procedure diasize_init :
     3886     define variable v-default-value    as logical   no-undo .
     3887     define variable v-restore-saved    as logical   no-undo .
     3888     define variable v-resize-value-str as character no-undo .
     3889     do
     3890     on error undo, return error return-value
     3891     :
     3892       do with frame Dialog-Frame
     3893       :
     3894         assign
     3895           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3896           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3897           v-diasize-browse-handle     = browse BROWSE-2 :handle
     3898         .
     3899         create button v-diasize-resize-button
     3900         assign
     3901           parent        = frame Dialog-Frame :first-child
     3902           label         = "s"
     3903           height-pixels = 16
     3904           width-pixels  = 16
     3905           visible       = true
     3906           sensitive     = true
     3907           movable       = true
     3908           triggers:
     3909             on end-move persistent run diasize_end-move in this-procedure .
     3910           end triggers.
     3911         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3912         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3913         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3914         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3915         assign
     3916           v-diasize-wndmax = false
     3917         .
     3918         if connected("ub") = true
     3919         then do:
     3920           define variable v-cntxt-db-num        as integer   no-undo .
     3921           define variable v-cntxt-userid        as character no-undo .
     3922           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3923                                             , OUTPUT v-cntxt-userid
     3924                                             ) .
     3925           run gbl/wndpar_r.p
     3926             (input  v-cntxt-db-num
     3927             ,input  v-cntxt-userid
     3928             ,input  'wndmax':U
     3929             ,output v-diasize-wndmax
     3930             ,output v-default-value
     3931             ) .
     3932         end.
     3933         assign
     3934           v-diasize-wndstore = false
     3935         .
     3936         if connected("ub") = true
     3937         then do:
     3938           run gbl/wndpar_r.p
     3939             (input  v-cntxt-db-num
     3940             ,input  v-cntxt-userid
     3941             ,input  'wndstore':U
     3942             ,output v-diasize-wndstore
     3943             ,output v-default-value
     3944             ) .
     3945         end.
     3946         assign
     3947           v-diasize-proc-name = entry(1, program-name(2), '.')
     3948         .
     3949         if v-diasize-wndstore = true
     3950         then do:
     3951           assign
     3952             v-restore-saved = false
     3953           .
     3954           if connected("ub") = true
     3955           then do:
     3956             run gbl/wndsizer.p
     3957               (input  v-cntxt-db-num
     3958               ,input  v-cntxt-userid
     3959               ,input  v-diasize-proc-name
     3960               ,input  'height':u
     3961               ,output v-resize-value-str
     3962               ) .
     3963             if v-resize-value-str <> '':U
     3964             then do:
     3965               run diasize_change-height in this-procedure
     3966                 (input  integer(v-resize-value-str)
     3967                 ,input  true
     3968                 ) .
     3969               assign
     3970                 v-restore-saved = true
     3971               .
     3972             end.
     3973           end.
     3974           if connected("ub") = true
     3975           then do:
     3976             run gbl/wndsizer.p
     3977               (input  v-cntxt-db-num
     3978               ,input  v-cntxt-userid
     3979               ,input  v-diasize-proc-name
     3980               ,input  'width':u
     3981               ,output v-resize-value-str
     3982               ) .
     3983             if v-resize-value-str <> '':U
     3984             then do:
     3985               run diasize_change-width in this-procedure
     3986                 (input  integer(v-resize-value-str)
     3987                 ,input  true
     3988                 ) .
     3989               assign
     3990                 v-restore-saved = true
     3991               .
     3992             end.
     3993           end.
     3994           if v-restore-saved <> true
     3995           then do:
     3996             if v-diasize-wndmax = true
     3997             then do:
     3998               run diasize_maximize in this-procedure
     3999                 (input  true
     4000                 ) .
     4001             end.
     4002           end.
     4003         end.
     4004         else do:
     4005           if v-diasize-wndmax = true
     4006           then do:
     4007             run diasize_maximize in this-procedure
     4008               (input  true
     4009               ) .
     4010           end.
     4011         end.
     4012       end.
     4013     end.
     4014   end procedure.
     4015   procedure diasize_need-full-display :
     4016     define output parameter p-need-full-display as logical   no-undo .
     4017     do
     4018     on error undo, return error return-value
     4019     :
     4020       assign
     4021         p-need-full-display = v-diasize-need-full-display
     4022       .
     4023       assign
     4024         v-diasize-need-full-display = false
     4025       .
     4026     end.
     4027   end procedure.
     4028   procedure get-context :
     4029      define output parameter p-db-num as integer          no-undo.
     4030      define output parameter p-user-id as character        no-undo.
     4031      define variable v-login               as character    no-undo.
     4032      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4033      define buffer buf_user-login  for ub.user-login .
     4034      do
     4035      on error undo, return error
     4036      :
     4037            FIND FIRST buf_sys-ctrl no-lock.
     4038            ASSIGN
     4039               v-login = USERID("ub")
     4040               p-db-num = buf_sys-ctrl.db-num
     4041            .
     4042            FIND FIRST buf_user-login
     4043                 WHERE buf_user-login.db-num = p-db-num
     4044                   AND buf_user-login.user-login = v-login
     4045                 no-lock
     4046                 no-error
     4047                 .
     4048            IF AVAILABLE buf_user-login
     4049            THEN DO:
     4050               assign
     4051                  p-user-id = buf_user-login.user-id
     4052               .
     4053            END.
     4054      end.
     4055   end procedure.
     4056     run diasize_init in this-procedure .
     4057     RUN enable_UI.
     4058     WAIT-FOR GO OF FRAME Dialog-Frame.
     4059   END.
     4060   RUN disable_UI.
     4061   PROCEDURE disable_UI :
     4062     HIDE FRAME Dialog-Frame.
     4063   END PROCEDURE.
     4064   PROCEDURE enable_UI :
     4065     DISPLAY f-error EDITOR-2
     4066         WITH FRAME Dialog-Frame.
     4067     ENABLE Btn_OK Btn_Cancel BROWSE-2 EDITOR-2
     4068         WITH FRAME Dialog-Frame.
     4069     VIEW FRAME Dialog-Frame.
     4070     OPEN QUERY BROWSE-2 FOR EACH tt-utd-err NO-LOCK INDEXED-REPOSITION.
     4071   END PROCEDURE.
     4072   PROCEDURE init-temp :
     4073    define buffer  buf_utd-marking-lines for  ub.utd-marking-lines .
     4074    define buffer  buf_marking for  ub.marking .
     4075    define variable ii as integer no-undo .
     4076    define variable status_ as character no-undo .
     4077    define variable vline as integer no-undo.
     4078    define variable vHn as handle no-undo.
     4079     for each buf_utd-err no-lock where buf_utd-err.db-num = p-db-num and buf_utd-err.doc-id = p-doc-id:
     4080       define variable verror as character no-undo.
     4081       verror = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     4082       if     verror ne ""
     4083          and verror ne ?
     4084       then do:
     4085          create tt-utd-err .
     4086          buffer-copy buf_utd-err to tt-utd-err .
     4087          assign
     4088          tt-utd-err.descr = verror
     4089          .
     4090          if buf_utd-err.reckey begins "utd-lines" or buf_utd-err.reckey begins "utd-marking-lines"
     4091          or buf_utd-err.reckey begins "marking" then do:
     4092            run gen-hn-keyr(input buf_utd-err.reckey,input ?,input "ub" , input ? ,input no-lock , output vHn).
     4093            if vHn:available
     4094            then do:
     4095               if buf_utd-err.reckey begins "marking" then do:
     4096                   tt-utd-err.gds-code = vHn::gds-code .
     4097                   tt-utd-err.LineNum  = 0 .
     4098               end.
     4099               else do:
     4100                   tt-utd-err.LineNum = vHn::lineNum .
     4101                   tt-utd-err.gds-code = vHn::gds-code .
     4102               end.
     4103            end.
     4104          end.
     4105        end.
     4106     end.
     4107      define buffer cancel_utd-lines for utd-lines.
     4108      for each cancel_utd-lines where cancel_utd-lines.db-num eq p-db-num
     4109                                  and cancel_utd-lines.doc-id eq p-doc-id
     4110      no-lock:
     4111         if logical(getattrutdlinesex  (cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     4112         then do:
     4113            for each buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num = p-db-num and
     4114                                                         buf_utd-marking-lines.doc-id = p-doc-id and
     4115                                                         buf_utd-marking-lines.LineNum = cancel_utd-lines.LineNum,
     4116               first buf_marking no-lock where buf_marking.mark = buf_utd-marking-lines.mark and
     4117               buf_marking.sts =  Marking:NotAvailable:KeyIntDB :
     4118               create tt-utd-err .
     4119               ii = ii + 1 .
     4120               assign
     4121                 tt-utd-err.CheckType = "CheckShip"
     4122                 tt-utd-err.CheckObj  = "По товару " + string(buf_utd-marking-lines.gds-code) + " по линии " + string(buf_utd-marking-lines.LineNum)
     4123                 tt-utd-err.CodeErr   = "MARKDECLINED"
     4124                 tt-utd-err.db-num    = buf_utd-marking-lines.db-num
     4125                 tt-utd-err.doc-id    = buf_utd-marking-lines.doc-id
     4126                 tt-utd-err.reckey    = string(ii)
     4127                 tt-utd-err.LineNum   = buf_utd-marking-lines.LineNum
     4128                 tt-utd-err.gds-code  = buf_utd-marking-lines.gds-code
     4129                 .
     4130               status_ = StatusTHName(buf_marking.sts) .
     4131               tt-utd-err.descr = "Ошибка № 15. В результате проверки товаров на АЗК по строке " + string(buf_utd-marking-lines.LineNum) +  " марка " + buf_utd-marking-lines.mark + " не была принята."
     4132                 .
     4133            end.
     4134         end.
     4135         else do:
     4136            define variable vqnty as decimal no-undo.
     4137            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     4138            if vqnty eq ? then vqnty = 0.
     4139            if vqnty ne cancel_utd-lines.Quantity
     4140            then do:
     4141               create tt-utd-err .
     4142               ii = ii + 1 .
     4143               assign
     4144                  tt-utd-err.CheckType = "CheckShip"
     4145                  tt-utd-err.CheckObj  = "По товару " + string(cancel_utd-lines.gds-code) + " по линии " + string(cancel_utd-lines.LineNum)
     4146                  tt-utd-err.CodeErr   = "NotAcceptQuantity"
     4147                  tt-utd-err.db-num    = cancel_utd-lines.db-num
     4148                  tt-utd-err.doc-id    = cancel_utd-lines.doc-id
     4149                  tt-utd-err.reckey    = string(ii)
     4150                  tt-utd-err.LineNum   = cancel_utd-lines.LineNum
     4151                  tt-utd-err.gds-code  = cancel_utd-lines.gds-code
     4152               .
     4153               tt-utd-err.descr = "В результате проверки товаров на АЗК по строке " + string(cancel_utd-lines.LineNum) +  " не принято " +  string(cancel_utd-lines.Quantity - vqnty) + " единиц товара."
     4154           .
     4155            end.
     4156         end.
     4157      end.
     4158   END PROCEDURE.
