      388   procedure xmlchar-test :
      389   define input parameter p-in-string          as character        no-undo.
      390   define output parameter p-out-string-enc    as character        no-undo.
      391   define output parameter p-out-string-dec    as character        no-undo.
      392   do
      393   on error undo, return error
      394   :
      395          run xmlchar-encode in this-procedure
      396       (
      397             input p-in-string
      398           , output p-out-string-enc
      399       ).
      400          run xmlchar-decode in this-procedure
      401       (
      402             input p-out-string-enc
      403           , output p-out-string-dec
      404       ).
      405   end.
      406   end .
      407   procedure xmlchar-encode :
      408   define input parameter p-in-string      as character        no-undo.
      409   define output parameter p-out-string    as character        no-undo.
      410       define variable v-position      as integer      no-undo.
      411       define variable v-current-char  as character    no-undo.
      412   do
      413   on error undo, return error
      414   :
      415       assign
      416           p-out-string = "":U
      417       .
      418       case p-in-string
      419       :
      420           when ?
      421           then do:
      422               assign
      423                   p-out-string = "?":U
      424               .
      425           end.
      426           when "?":U
      427           then do:
      428               assign
      429                   p-out-string = "&#63;":U
      430               .
      431           end.
      432           otherwise do:
      433               do v-position = 1 to length( p-in-string )
      434               :
      435                   assign
      436                       v-current-char = substring( p-in-string, v-position, 1 )
      437                   .
      438                   case v-current-char
      439                   :
      440                       when "&":U
      441                       then do:
      442                           assign
      443                               p-out-string = p-out-string + "&amp;":U
      444                           .
      445                       end.
      446                       when ">":U
      447                       then do:
      448                           assign
      449                               p-out-string = p-out-string + "&gt;":U
      450                           .
      451                       end.
      452                       when "<":U
      453                       then do:
      454                           assign
      455                               p-out-string = p-out-string + "&lt;":U
      456                           .
      457                       end.
      458                       when "'":U
      459                       then do:
      460                           assign
      461                               p-out-string = p-out-string + "&apos;":U
      462                           .
      463                       end.
      464                       when '"':U
      465                       then do:
      466                           assign
      467                               p-out-string = p-out-string + "&quot;":U
      468                           .
      469                       end.
      470                       when chr(1)
      471                       then do:
      472                           assign
      473                               p-out-string = p-out-string + "":U
      474                           .
      475                       end.
      476                       when chr(2)
      477                       then do:
      478                           assign
      479                               p-out-string = p-out-string + "":U
      480                           .
      481                       end.
      482                       when chr(3)
      483                       then do:
      484                           assign
      485                               p-out-string = p-out-string + "":U
      486                           .
      487                       end.
      488                       when chr(4)
      489                       then do:
      490                           assign
      491                               p-out-string = p-out-string + "":U
      492                           .
      493                       end.
      494                       when chr(5)
      495                       then do:
      496                           assign
      497                               p-out-string = p-out-string + "":U
      498                           .
      499                       end.
      500                       when chr(6)
      501                       then do:
      502                           assign
      503                               p-out-string = p-out-string + "":U
      504                           .
      505                       end.
      506                       when chr(7)
      507                       then do:
      508                           assign
      509                               p-out-string = p-out-string + "":U
      510                           .
      511                       end.
      512                       when chr(8)
      513                       then do:
      514                           assign
      515                               p-out-string = p-out-string + "":U
      516                           .
      517                       end.
      518                       when chr(9)
      519                       then do:
      520                           assign
      521                               p-out-string = p-out-string + "":U
      522                           .
      523                       end.
      524                       when chr(29)
      525                       then do:
      526                           assign
      527                               p-out-string = p-out-string + "":U
      528                           .
      529                       end.
      530                       when chr(10)
      531                       then do:
      532                           assign
      533                               p-out-string = p-out-string + "&#10;":U
      534                           .
      535                       end.
      536                       when chr(13)
      537                       then do:
      538                           assign
      539                               p-out-string = p-out-string + "&#13;":U
      540                           .
      541                       end.
      542                       otherwise do:
      543                           assign
      544                               p-out-string = p-out-string + v-current-char
      545                           .
      546                       end.
      547                   end case.
      548               end.
      549           end.
      550       end case.
      551   end.
      552   end .
      553   procedure xmlchar-encode-1c :
      554   define input parameter p-in-string      as character        no-undo.
      555   define output parameter p-out-string    as character        no-undo.
      556       define variable v-position      as integer      no-undo.
      557       define variable v-current-char  as character    no-undo.
      558   do
      559   on error undo, return error
      560   :
      561       assign
      562           p-out-string = "":U
      563       .
      564       case p-in-string
      565       :
      566           when ?
      567           then do:
      568               assign
      569                   p-out-string = "?":U
      570               .
      571           end.
      572           otherwise do:
      573               do v-position = 1 to length( p-in-string )
      574               :
      575                   assign
      576                       v-current-char = substring( p-in-string, v-position, 1 )
      577                   .
      578                   case v-current-char
      579                   :
      580                       when chr(1)
      581                       then do:
      582                           assign
      583                               p-out-string = p-out-string + " ":U
