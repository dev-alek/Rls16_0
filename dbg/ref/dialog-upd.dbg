      193   define new global shared variable g#attr-lib  as handle no-undo .
      194   define variable v-attr-lib-variable as handle no-undo .
      195   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      196   function getattrUtdex returns char
      197   (idb-num   as integer,
      198    idoc-id   as integer,
      199    iattrcode as character,
      200    iExValue  as character  ):
      201      define buffer utd-attr for utd-attr.
      202      find first utd-attr where utd-attr.db-num eq idb-num
      203                            and utd-attr.doc-id eq idoc-id
      204                            and utd-attr.attr-code eq iattrcode
      205      no-lock no-error.
      206      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
      207   end.
      208   function getattrUtd returns char
      209   (idb-num   as integer,
      210    idoc-id   as integer,
      211    iattrcode as character ):
      212     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
      213   end.
      214   function setattrUtd returns logical
      215   (idb-num   as integer,
      216    idoc-id   as integer,
      217    iattrcode as character,
      218    iattrval  as character ):
      219      define buffer utd-attr for utd-attr.
      220      find first utd-attr where utd-attr.db-num eq idb-num
      221                            and utd-attr.doc-id eq idoc-id
      222                            and utd-attr.attr-code eq iattrcode
      223      no-lock no-error.
      224      if not available utd-attr
      225      then do:
      226         create utd-attr.
      227         assign
      228            utd-attr.db-num    = idb-num
      229            utd-attr.doc-id    = idoc-id
      230            utd-attr.attr-code = iattrcode
      231            utd-attr.attr-value = iattrval
      232         .
      233      end.
      234      else do:
      235         if utd-attr.attr-value ne iattrval
      236         then do:
      237            find current utd-attr exclusive-lock no-error.
      238            if available utd-attr
      239            then
      240               utd-attr.attr-value = iattrval.
      241         end.
      242      end.
      243      release utd-attr.
      244   end.
      245   function GetAttrUtdlinesEx returns char
      246   (idb-num   as integer,
      247    idoc-id   as integer,
      248    ilinenum  as integer,
      249    iattrcode as character,
      250    iExValue  as character  ):
      251      define buffer utd-lines-attr for utd-lines-attr.
      252      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
      253                                  and utd-lines-attr.doc-id    eq idoc-id
      254                                  and utd-lines-attr.lineNum   eq ilineNum
      255                                  and utd-lines-attr.attr-code eq iattrcode
      256      no-lock no-error.
      257      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
      258   end.
      259   function GetAttrUtdlines returns char
      260   (idb-num   as integer,
      261    idoc-id   as integer,
      262    ilinenum  as integer,
      263    iattrcode as character ):
      264      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
      265   end.
      266   function setattrUtdlines returns logical
      267   (idb-num   as integer,
      268    idoc-id   as integer,
      269    ilinenum  as integer,
      270    iattrcode as character,
      271    iattrval  as character ):
      272      define buffer utd-lines-attr for utd-lines-attr.
      273      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
      274                                  and utd-lines-attr.doc-id    eq idoc-id
      275                                  and utd-lines-attr.lineNum   eq ilineNum
      276                                  and utd-lines-attr.attr-code eq iattrcode
      277      no-lock no-error.
      278      if not available utd-lines-attr
      279      then do:
      280         if iattrval ne ?
      281            and iattrval ne ""
      282         then do:
      283            create utd-lines-attr.
      284            assign
      285               utd-lines-attr.db-num    = idb-num
      286               utd-lines-attr.doc-id    = idoc-id
      287               utd-lines-attr.lineNum   = ilineNum
      288               utd-lines-attr.attr-code = iattrcode
      289               utd-lines-attr.attr-value = iattrval
      290            .
      291         end.
      292      end.
      293      else do:
      294         if utd-lines-attr.attr-value ne iattrval
      295         then do:
      296            find current utd-lines-attr exclusive-lock no-error.
      297            if available utd-lines-attr
      298            then do:
      299               if    iattrval eq ?
      300                  or iattrval eq ""
      301               then do:
      302                  delete utd-lines-attr.
      303               end.
      304               else do:
      305                  utd-lines-attr.attr-value = iattrval.
      306               end.
      307            end.
      308         end.
      309      end.
      310      release utd-lines-attr.
      311   end.
      312   function GetAttrUtdMarkingLinesEx returns char
      313   (idb-num   as integer,
      314    idoc-id   as integer,
      315    ilinenum  as integer,
      316    imark     as character,
      317    iattrcode as character,
      318    iExValue  as character  ):
      319      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
      320      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
      321                                          and utd-marking-lines-attr.doc-id    eq idoc-id
      322                                          and utd-marking-lines-attr.lineNum   eq ilineNum
      323                                          and utd-marking-lines-attr.mark      eq imark
      324                                          and utd-marking-lines-attr.attr-code eq iattrcode
      325      no-lock no-error.
      326      return if not available utd-marking-lines-attr  then iExValue    else  utd-marking-lines-attr.attr-value.
      327   end.
      328   function GetAttrUtdMarkingLines returns char
      329   (idb-num   as integer,
      330    idoc-id   as integer,
      331    ilinenum  as integer,
      332    imark     as character,
      333    iattrcode as character ):
      334      return GetAttrUtdMarkingLinesEx (idb-num,idoc-id,ilinenum,imark,iattrcode,?).
      335   end.
      336   function setattrUtdMarkingLines returns logical
      337   (idb-num   as integer,
      338    idoc-id   as integer,
      339    ilinenum  as integer,
      340    imark     as character,
      341    iattrcode as character,
      342    iattrval  as character ):
      343      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
      344      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
      345                                          and utd-marking-lines-attr.doc-id    eq idoc-id
      346                                          and utd-marking-lines-attr.lineNum   eq ilineNum
      347                                          and utd-marking-lines-attr.mark      eq imark
      348                                          and utd-marking-lines-attr.attr-code eq iattrcode
      349      no-lock no-error.
      350      if not available utd-marking-lines-attr
      351      then do:
      352         if iattrval ne ?
      353            and iattrval ne ""
      354         then do:
      355            create utd-marking-lines-attr.
      356            assign
      357               utd-marking-lines-attr.db-num     = idb-num
      358               utd-marking-lines-attr.doc-id     = idoc-id
      359               utd-marking-lines-attr.lineNum    = ilineNum
      360               utd-marking-lines-attr.mark       = imark
      361               utd-marking-lines-attr.attr-code  = iattrcode
      362               utd-marking-lines-attr.attr-value = iattrval
      363            .
      364         end.
      365      end.
      366      else do:
      367         if utd-marking-lines-attr.attr-value ne iattrval
      368         then do:
      369            find current utd-marking-lines-attr exclusive-lock no-error.
      370            if available utd-marking-lines-attr
      371            then do:
      372               if    iattrval eq ?
      373                  or iattrval eq ""
      374               then do:
      375                  delete utd-marking-lines-attr.
      376               end.
      377               else do:
      378                  utd-marking-lines-attr.attr-value = iattrval.
      379               end.
      380            end.
      381         end.
      382      end.
      383      release utd-marking-lines-attr.
      384   end.
