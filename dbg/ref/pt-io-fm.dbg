        1   DEFINE BUFFER locked_point-io FOR ub.point-io.
        2   DEFINE TEMP-TABLE tt-point-io NO-UNDO LIKE ub.point-io.
        3   define input parameter parparentproc as widget-handle no-undo .
        4   define input parameter p-db-num      as integer   no-undo .
        5   define input parameter p-cli-type like ub.clients.obj-type no-undo .
        6   define input parameter p-cli-code like ub.clients.obj-code no-undo .
        7   define input parameter p-mode        as character no-undo.
        8   define input-output parameter p-rep-rec     as recid no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision$":U .
       10   define variable vss-author      as character no-undo init "$Author$":U .
       11   define variable vss-date        as character no-undo init "$Date$":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       13   define variable vss-archive     as character no-undo init "$Archive$":U .
       14   define variable vss-description as character no-undo init "создание и изменение пунктов отгрузки/доставки".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   procedure proc-alt-shift-f2:
       70     if not ibs.th.gbl.gbl-var:rcode
       71   then
       72     run gbl\inidebug.p .
       73   end.
       74   procedure proc-alt-shift-f3:
       75     run gbl/prvssinf.p
       76       ( input this-procedure
       77       ) .
       78   end.
       79   define variable v-inform-launched as logical no-undo initial false .
       80   procedure proc-alt-shift-f4:
       81     define variable v-action as character no-undo .
       82     if v-inform-launched = false then do:
       83       assign
       84         v-inform-launched = true
       85       .
       86       run gbl/d-inform.w
       87         (  input self
       88         ,  input this-procedure
       89         , output v-action
       90         ) no-error .
       91       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       92       assign
       93         v-inform-launched = false
       94       .
       95     end.
       96   end.
       97   procedure proc-alt-f1:
       98     run gbl/corrhelp.p
       99       (input this-procedure
      100       ) .
      101   end .
      102   on alt-shift-f2 anywhere do:
      103     run proc-alt-shift-f2.
      104   end.
      105   on alt-shift-f3 anywhere do:
      106     run proc-alt-shift-f3 in this-procedure .
      107   end.
      108   on alt-shift-f4 anywhere do:
      109     run proc-alt-shift-f4 in this-procedure.
      110   end.
      111   on alt-f1 anywhere do:
      112     run proc-alt-f1 in this-procedure .
      113   end.
      114   define new global shared variable g#language as character no-undo .
      115   if g#language <> '' and g#language <> 'rus':U then do:
      116     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      117   end.
      118   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      119     define variable v-cntxt-db-num        as integer   no-undo .
      120     define variable v-cntxt-userid        as character no-undo .
      121     define variable v-cntxt-level         as character no-undo .
      122     define variable v-cntxt-host-code-obj as integer   no-undo .
      123     define variable v-cntxt-obj-type      as character no-undo .
      124     define variable v-cntxt-obj-code      as integer   no-undo .
      125     define variable v-cntxt-db-num-obj    as integer   no-undo .
      126     define variable v-cntxt-is-admin      as logical   no-undo .
      127   define buffer buf_clients for ub.clients.
      128   define buffer buf_person for ub.person.
      129   define buffer buf_firm for ub.firm.
      130   define variable glog as logical no-undo .
      131   DEFINE BUTTON b-cli
      132        IMAGE-UP FILE "btn-down-arrow":U
      133        IMAGE-DOWN FILE "btn-down-arrow":U
      134        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      135        LABEL "2"
      136        SIZE 2.9 BY 1.
      137   DEFINE BUTTON b-deliv-subj
      138        IMAGE-UP FILE "btn-down-arrow":U
      139        IMAGE-DOWN FILE "btn-down-arrow":U
      140        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      141        LABEL "2"
      142        SIZE 2.9 BY 1.
      143   DEFINE BUTTON b-exit AUTO-GO
      144        LABEL "&Ввод"
      145        SIZE 10 BY 1.
      146   DEFINE BUTTON b-help
      147        LABEL "Помо&щь"
      148        SIZE 3 BY 1.
      149   DEFINE BUTTON B-hist
      150        LABEL "Ис&тория"
      151        SIZE 3 BY 1.
      152   DEFINE BUTTON B-object
      153        LABEL "О&бъект"
      154        SIZE 10 BY 1.
      155   DEFINE BUTTON b-quit AUTO-END-KEY
      156        LABEL "&Отмена"
      157        SIZE 10 BY 1.
      158   DEFINE VARIABLE cli-name AS CHARACTER FORMAT "X(40)"
      159         VIEW-AS TEXT
      160        SIZE 90.7 BY 1.
      161   DEFINE VARIABLE deliv-subj-name AS CHARACTER FORMAT "X(40)"
      162         VIEW-AS TEXT
      163        SIZE 58.7 BY 1.
      164   DEFINE RECTANGLE RECT-2
      165        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      166        SIZE 98 BY 2.5.
      167   DEFINE QUERY Dialog-Frame FOR
      168         tt-point-io SCROLLING.
      169   DEFINE FRAME Dialog-Frame
      170        b-exit AT ROW 1 COL 1
      171        b-quit AT ROW 1 COL 11
      172        B-hist AT ROW 1 COL 92
      173        b-help AT ROW 1 COL 95
      174        B-object AT ROW 2.43 COL 31 WIDGET-ID 4
      175        tt-point-io.cli-code AT ROW 2.47 COL 13.3 COLON-ALIGNED NO-LABEL
      176             VIEW-AS FILL-IN
      177             SIZE 6 BY 1
      178        tt-point-io.cli-type AT ROW 2.47 COL 19.6 COLON-ALIGNED NO-LABEL
      179             VIEW-AS FILL-IN
      180             SIZE 4.4 BY 1
      181        b-cli AT ROW 2.47 COL 26.8
      182        tt-point-io.point-type AT ROW 5 COL 3 NO-LABEL
      183             VIEW-AS RADIO-SET HORIZONTAL
      184             RADIO-BUTTONS
      185                       "доставки", "1":U,
      186   "отгрузки", "2":U
      187             SIZE 26.5 BY 1
      188        tt-point-io.point-code AT ROW 5 COL 42.5 COLON-ALIGNED
      189             LABEL "Номер"
      190             VIEW-AS FILL-IN
      191             SIZE 19.5 BY 1
      192        tt-point-io.point-name AT ROW 6.33 COL 10 COLON-ALIGNED
      193             LABEL "Название"
      194             VIEW-AS FILL-IN
      195             SIZE 52 BY 1
      196        tt-point-io.deliv-subj-code AT ROW 7.4 COL 4.5 WIDGET-ID 8
      197             LABEL "Код субъекта доставки" FORMAT "->,>>>,>>9"
      198             VIEW-AS FILL-IN
      199             SIZE 9 BY 1
      200        b-deliv-subj AT ROW 7.4 COL 37 WIDGET-ID 6
      201        tt-point-io.address AT ROW 9 COL 3 COLON-ALIGNED NO-LABEL WIDGET-ID 12
      202             VIEW-AS FILL-IN
      203             SIZE 87 BY 1
      204        tt-point-io.is-default AT ROW 11 COL 31.5
      205             LABEL "По умолчанию"
      206             VIEW-AS TOGGLE-BOX
      207             SIZE 32.5 BY .83
      208        tt-point-io.PS AT ROW 13 COL 1 NO-LABEL
      209             VIEW-AS FILL-IN
      210             SIZE 98 BY 3.67
      211        cli-name AT ROW 3.47 COL 2.8 NO-LABEL
      212        deliv-subj-name AT ROW 7.4 COL 41 NO-LABEL WIDGET-ID 10
      213        "Примечание:" VIEW-AS TEXT
      214             SIZE 15 BY .67 AT ROW 12.3 COL 3
      215        "Контрагент:" VIEW-AS TEXT
      216             SIZE 12.1 BY 1 AT ROW 2.47 COL 2.9
      217             FGCOLOR 4
      218        RECT-2 AT ROW 2.27 COL 1.5
      219        SPACE(0.39) SKIP(13.29)
      220       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      221            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      222            TITLE "Пункт отгрузки/доставки".
      223   ASSIGN
      224          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      225          FRAME Dialog-Frame:HIDDEN           = TRUE.
      226   ASSIGN
      227          tt-point-io.point-code:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      228   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      229   DO:
      230     APPLY "END-ERROR":U TO SELF.
      231   END.
      232   ON CHOOSE OF b-cli IN FRAME Dialog-Frame
      233   DO:
      234     define variable  v-rid-list as character no-undo .
      235     run ref/cli-all.w ( input parParentProc
      236                       ,input "b-sel"
      237                       ,input 'все':U
      238                       ,input 'все':U
      239                       ,input  'текущие':U
      240                       ,input ?
      241                       ,input "
      242                       ,,,,,,NO,,":u
      243                       , "without-obj":U
      244                       ,output v-rid-list ) .
      245     if v-rid-list <> "" then do:
      246       find first buf_clients no-lock where RECID(buf_clients) = int (v-rid-list) no-error.
      247       assign
      248       tt-point-io.cli-type = buf_clients.obj-type
      249       tt-point-io.cli-code = buf_clients.obj-code
      250       .
      251       assign
      252       tt-point-io.point-type .
      253       run find-cli in this-procedure ( input tt-point-io.cli-type
      254                                       , input tt-point-io.cli-code)  .
      255     end.
      256     else do:
      257       assign
      258       cli-name = ""
      259       tt-point-io.cli-code = ?
      260       tt-point-io.cli-type  = ? .
      261       display
      262       cli-name
      263       tt-point-io.cli-type
      264       tt-point-io.cli-code
      265       with frame Dialog-Frame.
      266     end.
      267   END.
      268   ON CHOOSE OF b-deliv-subj IN FRAME Dialog-Frame
      269   DO:
      270     define buffer buf_delivery-subject for ub.delivery-subject.
      271     define variable v-rid-list as character no-undo.
      272     define variable v-stts as integer no-undo .
      273     v-stts = integer('0':U).
      274     run ref/dlvsubjs.w (input parParentProc
      275                   , v-cntxt-obj-type
      276                   , v-cntxt-obj-code
      277                   , "b-sel":U
      278                   , 'все':U
      279                   , input-output v-stts
      280                   , input-output v-rid-list ) no-error .
      281     if v-rid-list <> ? then do :
      282       find first buf_delivery-subject no-lock
      283         where recid(buf_delivery-subject) = integer(v-rid-list)
      284       no-error .
      285       if not available buf_delivery-subject then do:
      286         message
      287         "Неверный код субъекта доставки " v-rid-list
      288         view-as alert-box error.
      289         return no-apply.
      290       end.
      291       else do:
      292         assign
      293         tt-point-io.deliv-subj-code = buf_delivery-subject.deliv-subj-code
      294         .
      295         display
      296         tt-point-io.deliv-subj-code
      297         buf_delivery-subject.deliv-subj-name @ deliv-subj-name
      298         with frame Dialog-Frame.
      299       end.
      300     end.
      301   END.
      302   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      303   DO:
      304     run proc-save in this-procedure no-error.
      305     if error-status:error then return no-apply.
      306   END.
      307   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
      308   DO:
      309     DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      310     if not available locked_point-io then return .
      311     run ref/ptiohist.w ( INPUT parParentProc
      312                        , input locked_point-io.db-num
      313                        , input locked_point-io.point-code
      314                        , input "":U
      315                        , input-output v-rid-list
      316                        ) no-error .
      317   END.
      318   ON CHOOSE OF B-object IN FRAME Dialog-Frame
      319   DO:
      320     define buffer b#clients for ub.clients.
      321     define variable v-type as char no-undo.
      322     define variable v-code as int no-undo.
      323     define buffer buf_person for ub.person.
      324     define buffer buf_firm for ub.firm.
      325     define buffer buf_shop for ub.shop.
      326     define buffer buf_store for ub.store.
      327     run str/chshobj.w ( tt-point-io.cli-code
      328                         , input ""
      329                         , input 0
      330                         , output v-type
      331                         , OUTPUT v-code).
      332     find first b#clients WHERE
      333            v-code = b#clients.obj-code
      334        AND v-type = b#clients.obj-type No-LOCK No-ERROR.
      335     if available b#clients then do:
      336       assign tt-point-io.point-name = b#clients.obj-name .
      337       Case b#clients.obj-type :
      338         when  'орг':U then do :
      339           FIND buf_firm  WHERE
      340                 buf_firm.firm-code = b#clients.obj-code NO-LOCK.
      341           Assign tt-point-io.address = buf_firm.addres1 .
      342         end.
      343         when  'чел':U then do :
      344           FIND buf_person  WHERE
      345              buf_person.psn-code = b#clients.obj-code NO-LOCK.
      346           Assign tt-point-io.address = buf_person.address .
      347         end.
      348         when  'маг':U then do :
      349           FIND buf_shop  WHERE buf_shop.obj-code = b#clients.obj-code NO-LOCK.
      350           Assign tt-point-io.address = buf_shop.addres1 .
      351         end.
      352         when  'скл':U then do :
      353           FIND buf_store  WHERE buf_store.obj-code = b#clients.obj-code NO-LOCK.
      354           Assign tt-point-io.address = buf_store.addres1 .
      355         end.
      356       End case.
      357       display
      358       tt-point-io.point-name
      359       tt-point-io.address with frame Dialog-Frame.
      360     end.
      361   END.
      362   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
      363   DO:
      364   p-rep-rec = ?.
      365   END.
      366   ON LEAVE OF tt-point-io.cli-code IN FRAME Dialog-Frame
      367   DO:
      368     if tt-point-io.cli-code = int ( tt-point-io.cli-code:screen-value ) then return.
      369     assign
      370     tt-point-io.cli-code
      371     tt-point-io.point-type .
      372     run find-cli in this-procedure ( input tt-point-io.cli-type
      373                                    , input tt-point-io.cli-code)  .
      374   END.
      375   ON RETURN OF tt-point-io.cli-code IN FRAME Dialog-Frame
      376   DO:
      377     if tt-point-io.cli-code = int ( tt-point-io.cli-code:screen-value ) then return.
      378     assign
      379     tt-point-io.cli-code
      380     tt-point-io.point-type .
      381     run find-cli in this-procedure ( input tt-point-io.cli-type
      382                                    , input tt-point-io.cli-code)  .
      383   END.
      384   ON LEAVE OF tt-point-io.cli-type IN FRAME Dialog-Frame
      385   DO:
      386     assign
      387     tt-point-io.cli-type
      388     tt-point-io.point-type .
      389     run find-cli in this-procedure ( input tt-point-io.cli-type
      390                                     , input tt-point-io.cli-code)  .
      391   END.
      392   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      393   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      394   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      395   on help of frame Dialog-Frame
      396   do:
      397     run gbl/app_help.p
      398       (input this-procedure :file-name
      399       ,input ''
      400       ,input ?
      401       ) no-error.
      402     if error-status :error then do:
      403       message
      404         "Ошибка при вызове помощи"
      405         error-status :get-message(1)
      406         view-as alert-box .
      407     end.
      408   end.
      409   run minbtn-set in this-procedure .
      410   on choose of b-help in frame Dialog-Frame
      411   do:
      412     apply "help":u to frame Dialog-Frame .
      413   end.
      414   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      415   procedure minbtn-set :
      416       do
      417           on error undo, return error return-value
      418           :
      419           define variable ii              as integer       no-undo .
      420           define variable fh              as widget-handle no-undo .
      421           define variable hh              as widget-handle no-undo .
      422           define variable v-h             as handle        extent 4 no-undo .
      423           define variable v-name-button   as character     no-undo .
      424           define variable v-help-old-x    as decimal       no-undo .
      425           define variable v-help-old-y    as decimal       no-undo .
      426           define variable v-help-old-size as decimal       no-undo .
      427           define variable v-frame-width   as decimal       no-undo .
      428           define variable jj              as integer       no-undo .
      429           do
      430               on error undo, return error
      431               :
      432               assign
      433                   v-frame-width = frame Dialog-Frame:width - 0.3
      434                   fh            = frame Dialog-Frame:first-child
      435                   hh            = fh:first-child
      436                   ii            = 1
      437                   .
      438               do while valid-handle(hh):
      439                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      440                   do:
      441                       case lc(hh:name) :
      442                           when "b-help" then
      443                               do:
      444                                   hh:load-image-up("cmp/b-help.bmp":u) .
      445                                   hh:load-image-down("cmp/b-help.bmp":u) .
      446                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      447                                   hh:TOOLTIP = "Помощь" .
      448                                   v-help-old-x = hh:column .
      449                                   v-help-old-y = hh:row    .
      450                                   v-help-old-size = hh:width .
      451                                   hh:width-chars = 2.5 .
      452                               end.
      453                           when "b-print" then
      454                               do:
      455                                   hh:load-image("cmp/b-print.bmp":u) .
      456                                   hh:TOOLTIP = "Печать" .
      457                                   v-h[ii] = hh:handle .
      458                                   ii = ii + 1 .
      459                                   hh:width-chars = 3 .
      460                               end.
      461                           when "b-history" or
      462                           when "b-hist" then
      463                               do:
      464                                   hh:load-image("cmp/b-hist.bmp":u) .
      465                                   hh:TOOLTIP = "История" .
      466                                   v-h[ii] = hh:handle .
      467                                   ii = ii + 1 .
      468                                   hh:width-chars = 3 .
      469                               end.
      470                           when "b-sch" then
      471                               do:
      472                                   hh:load-image("cmp/b-sch.bmp":u) .
      473                                   hh:TOOLTIP = "Установка Фильтра" .
      474                                   v-h[ii] = hh:handle .
      475                                   ii = ii + 1 .
      476                                   hh:width-chars = 3 .
      477                               end.
      478                           when "b-hist-user" then
      479                               do:
      480                                   hh:load-image("cmp/b-hist.bmp":u) .
      481                                   hh:TOOLTIP = "История пользователя" .
      482                                   ii = ii + 1 .
      483                               end.
      484                       end case.
      485                   end.
      486                   hh = hh:next-sibling.
      487               end.
      488               b-help:column = v-frame-width - b-help:width-chars.
      489               jj = 0.
      490               repeat ii = 4 to 1 by -1 :
      491                   if valid-handle (v-h[ii] ) then
      492                   do:
      493                       jj  = jj + 1 .
      494                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      495                       v-h[ii]:row    = v-help-old-y .
      496                   end.
      497               end.
      498           end.
      499       end.
      500   end procedure.
      501   MAIN-BLOCK:
      502   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      503      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      504      ON stop UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      505   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      506     run mainmenu_getcntxt in parparentproc
      507       (output v-cntxt-db-num
      508       ,output v-cntxt-userid
      509       ,output v-cntxt-level
      510       ,output v-cntxt-host-code-obj
      511       ,output v-cntxt-obj-type
      512       ,output v-cntxt-obj-code
      513       ,output v-cntxt-db-num-obj
      514       ,output v-cntxt-is-admin
      515       ) .
      516    if p-mode  <> 'ДОБАВЛЕНИЕ':U
      517    and p-mode <> 'ИЗМЕНЕНИЕ':U
      518    and p-mode <> 'ПРОСМОТР':U
      519    then do:
      520       message
      521       vss-workfile vss-revision vss-description skip
      522       "Неверное значение параметров вызова p-mode"  p-mode
      523       view-as alert-box ERROR.
      524       undo, return error.
      525    end.
      526    if p-cli-code > 0
      527    and p-mode = 'ДОБАВЛЕНИЕ':U
      528    then do:
      529      find first buf_clients no-lock where
      530               buf_clients.obj-type = p-cli-type
      531          AND buf_clients.obj-code = p-cli-code no-error.
      532     if not available buf_clients then do:
      533       message
      534       vss-workfile vss-revision vss-description skip
      535       "Неверное значение параметра вызова p-cli-type/p-cli-code"
      536       p-cli-type p-cli-code
      537       view-as alert-box ERROR.
      538       return error .
      539     end.
      540    end.
      541    for each tt-point-io:
      542       delete tt-point-io.
      543     end.
      544     if p-mode = 'ИЗМЕНЕНИЕ':U
      545     or p-mode = 'ПРОСМОТР':U then do:
      546       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      547         find first locked_point-io EXclusive-lock where
      548                      recid(locked_point-io) = p-rep-rec no-error.
      549       end.
      550       else do:
      551         find first locked_point-io no-lock where
      552                          recid(locked_point-io) = p-rep-rec no-error .
      553       end.
      554       if not available locked_point-io then do:
      555         message
      556         vss-workfile vss-revision vss-description skip
      557         "Не найдена запись ПУНКТ ДОСТАВКИ/ОТГРУЗКИ"
      558         view-as alert-box error .
      559         undo, return error.
      560       end.
      561       find first buf_clients no-lock where
      562               buf_clients.obj-type = locked_point-io.cli-type
      563          AND buf_clients.obj-code = locked_point-io.cli-code no-error.
      564       create tt-point-io.
      565       buffer-copy locked_point-io to tt-point-io.
      566       if available buf_clients then do:
      567         cli-name = buf_clients.obj-name.
      568       end.
      569     end.
      570     else do:
      571       create tt-point-io.
      572       assign
      573       tt-point-io.db-num = v-cntxt-db-num.
      574       tt-point-io.point-type = 'доставки':U.
      575       if available buf_clients then do:
      576         assign
      577         cli-name = buf_clients.obj-name
      578         tt-point-io.cli-type = p-cli-type
      579         tt-point-io.cli-code = p-cli-code
      580         .
      581       end.
      582     end.
      583     RUN Myenable in this-procedure .
      584     WAIT-FOR GO OF FRAME Dialog-Frame.
      585   END.
      586   RUN disable_UI.
      587   PROCEDURE disable_UI :
      588     HIDE FRAME Dialog-Frame.
      589   END PROCEDURE.
      590   PROCEDURE enable_UI :
      591     DISPLAY cli-name deliv-subj-name
      592         WITH FRAME Dialog-Frame.
      593     IF AVAILABLE tt-point-io THEN
      594       DISPLAY tt-point-io.cli-code tt-point-io.cli-type tt-point-io.point-type
      595             tt-point-io.point-code tt-point-io.point-name
      596             tt-point-io.deliv-subj-code tt-point-io.address tt-point-io.is-default
      597             tt-point-io.PS
      598         WITH FRAME Dialog-Frame.
      599     ENABLE b-exit RECT-2 b-quit B-hist b-help B-object tt-point-io.cli-code
      600            tt-point-io.cli-type b-cli tt-point-io.point-type
      601            tt-point-io.point-code tt-point-io.point-name
      602            tt-point-io.deliv-subj-code b-deliv-subj tt-point-io.address
      603            tt-point-io.is-default tt-point-io.PS
      604         WITH FRAME Dialog-Frame.
      605     VIEW FRAME Dialog-Frame.
      606   END PROCEDURE.
      607   PROCEDURE find-cli :
      608   define input  parameter p-obj-type as character no-undo .
      609   define input  parameter p-obj-code as integer   no-undo .
      610   define buffer buf_sysconf for ub.sysconf.
      611   define buffer buf_point-io for ub.point-io.
      612   if p-obj-type <> 'орг':U and p-obj-type <> 'чел':U then do:
      613     find first buf_clients no-lock where
      614              buf_clients.obj-type = 'орг':U
      615          and buf_clients.obj-code = p-obj-code no-error.
      616     if not available buf_clients then do:
      617       find first buf_clients no-lock where
      618              buf_clients.obj-type = 'чел':U
      619          and buf_clients.obj-code = p-obj-code no-error.
      620     end.
      621   end.
      622   else do:
      623     find first buf_clients no-lock where
      624              buf_clients.obj-type = p-obj-type
      625          and buf_clients.obj-code = p-obj-code no-error.
      626   end.
      627   if not available buf_clients then do:
      628     if p-obj-code = 0 then assign p-obj-code = ? .
      629     if p-obj-code = ? then do:
      630       assign
      631       cli-name = ""
      632       tt-point-io.cli-code = ?
      633       tt-point-io.cli-type  = ? .
      634       display
      635       cli-name
      636       tt-point-io.cli-code
      637       tt-point-io.cli-type
      638       with frame Dialog-Frame.
      639     end.
      640     else do:
      641       apply "CHOOSE" to b-cli IN FRAME Dialog-Frame  .
      642     end.
      643     return.
      644   end.
      645   if buf_clients.obj-type = 'орг':U then do:
      646     find first buf_firm no-lock where
      647               buf_firm.firm-code = buf_clients.obj-code no-error.
      648     if available buf_firm then
      649     assign tt-point-io.address = buf_firm.addres1 .
      650     find first buf_sysconf no-lock where
      651              buf_sysconf.host-code = buf_clients.obj-code no-error .
      652     if available buf_sysconf then do:
      653        assign
      654        B-object:visible = yes .
      655     end.
      656     else do:
      657       assign
      658       B-object:visible = no .
      659     end.
      660   end.
      661   else do:
      662     find first buf_person no-lock where
      663              buf_person.psn-code = buf_clients.obj-code no-error.
      664     if available buf_person then
      665     assign  tt-point-io.address = buf_person.address .
      666   end.
      667   find first buf_point-io no-lock
      668     where buf_point-io.cli-code   = buf_clients.obj-code
      669       and buf_point-io.cli-type   = buf_clients.obj-type
      670       and buf_point-io.point-type = tt-point-io.point-type
      671       and buf_point-io.is-default = yes
      672   no-error .
      673   if available buf_point-io then do:
      674     assign
      675     tt-point-io.is-default = no .
      676   end.
      677   else do:
      678     assign
      679     tt-point-io.is-default = yes .
      680   end.
      681   assign
      682   cli-name  = buf_clients.obj-name
      683   tt-point-io.cli-code  = p-obj-code
      684   tt-point-io.cli-type  = buf_clients.obj-type.
      685   display
      686   cli-name
      687   tt-point-io.cli-code
      688   tt-point-io.cli-type
      689   tt-point-io.address
      690   tt-point-io.is-default
      691   with frame Dialog-Frame.
      692   END PROCEDURE.
      693   PROCEDURE Myenable :
      694   define buffer buf_sysconf for ub.sysconf.
      695   define buffer buf_delivery-subject for ub.delivery-subject.
      696   IF tt-point-io.deliv-subj-code > 0  THEN DO:
      697     find first buf_delivery-subject no-lock
      698         where buf_delivery-subject.deliv-subj-code = tt-point-io.deliv-subj-code
      699       no-error .
      700     if not available buf_delivery-subject then do:
      701       message
      702       SUBSTITUTE("Неверный код субъекта доставки &1", tt-point-io.deliv-subj-code)
      703       view-as alert-box error.
      704      end.
      705      deliv-subj-name = buf_delivery-subject.deliv-subj-name.
      706   END.
      707   assign
      708   frame Dialog-Frame:title = substitute("Пункт отгрузки/доставки         &1", p-mode).
      709   assign
      710   tt-point-io.point-type:radio-buttons  in frame Dialog-Frame
      711    =  'доставки':U + chr(44) + 'доставки':U + chr(44) +
      712                             'отгрузки':U + chr(44) + 'отгрузки':U .
      713   DISPLAY
      714   cli-name
      715   deliv-subj-name
      716   WITH FRAME Dialog-Frame .
      717   IF AVAILABLE tt-point-io THEN do:
      718     DISPLAY
      719     tt-point-io.cli-code
      720     tt-point-io.cli-type
      721     tt-point-io.point-code
      722     tt-point-io.point-name
      723     tt-point-io.deliv-subj-code
      724     tt-point-io.address
      725     tt-point-io.is-default
      726     tt-point-io.PS
      727     tt-point-io.point-type
      728     WITH FRAME Dialog-Frame .
      729   end.
      730   if p-mode <> 'ПРОСМОТР':U then do:
      731     if tt-point-io.cli-type = 'орг':U then do:
      732       find first buf_sysconf no-lock where
      733               buf_sysconf.host-code = cli-code no-error .
      734       if available buf_sysconf then do:
      735         assign B-object:visible = yes .
      736       end.
      737       else do:
      738         assign B-object:visible = no .
      739       end.
      740     end.
      741     else do:
      742       assign B-object:visible = no .
      743     end.
      744   end.
      745   else
      746   assign
      747   B-object:visible = no .
      748   ENABLE
      749   b-exit when p-mode <> 'ПРОСМОТР':U
      750   b-quit
      751   B-hist  when p-mode <> 'ДОБАВЛЕНИЕ':U
      752   b-help
      753   B-object  when b-object:visible in frame Dialog-Frame
      754   tt-point-io.cli-code when p-mode = 'ДОБАВЛЕНИЕ':U
      755   tt-point-io.cli-type when p-mode = 'ДОБАВЛЕНИЕ':U
      756   b-cli when p-mode = 'ДОБАВЛЕНИЕ':U
      757   tt-point-io.point-type  when p-mode <> 'ПРОСМОТР':U
      758   tt-point-io.point-code
      759   tt-point-io.point-name  when p-mode <> 'ПРОСМОТР':U
      760   b-deliv-subj when p-mode <> 'ПРОСМОТР':U
      761   tt-point-io.address  when p-mode <> 'ПРОСМОТР':U
      762   tt-point-io.is-default  when p-mode <> 'ПРОСМОТР':U
      763   tt-point-io.ps
      764   RECT-2
      765   WITH FRAME Dialog-Frame .
      766   if p-mode = 'ПРОСМОТР':U then do:
      767     tt-point-io.PS:read-only = yes.
      768     b-quit:column = 1.
      769     b-exit:visible = no.
      770     b-quit:label = "&Выход".
      771   end.
      772   VIEW FRAME Dialog-Frame .
      773   END PROCEDURE.
      774   PROCEDURE proc-save :
      775   define variable v-rep-rec as recid no-undo .
      776   assign
      777   frame Dialog-Frame
      778   tt-point-io.ps
      779   tt-point-io.point-name
      780   tt-point-io.point-type
      781   tt-point-io.address
      782   tt-point-io.is-default
      783   tt-point-io.deliv-subj-code
      784   v-rep-rec = recid(locked_point-io)
      785   .
      786   run ref/pt-io-f1.p ( input-output v-rep-rec
      787                       ,input p-mode
      788                       ,input no
      789                       ,input tt-point-io.point-code
      790                       ,input tt-point-io.db-num
      791                       ,input tt-point-io.cli-type
      792                       ,input tt-point-io.cli-code
      793                       ,input tt-point-io.point-name
      794                       ,input tt-point-io.point-type
      795                       ,input tt-point-io.deliv-subj-code
      796                       ,input tt-point-io.is-default
      797                       ,input tt-point-io.address
      798                       ,input tt-point-io.ps ) no-error.
      799   if error-status:error then do:
      800   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      801   define variable fh as widget-handle no-undo .
      802   define variable hh as widget-handle no-undo .
      803   define variable rv as character no-undo .
      804   assign
      805   rv = entry(1, return-value , chr(4)).
      806   if rv <> "":U then do:
      807     assign
      808     fh = frame Dialog-Frame:first-child
      809     hh = fh:first-child
      810     .
      811     do while valid-handle(hh):
      812       if hh:name = rv then do:
      813         APPLY "ENTRY" to hh.
      814         undo ,
      815         return error.
      816       end.
      817       hh = hh:next-sibling.
      818     end.
      819   end.
      820     undo, return error.
      821   end.
      822   if return-value = "quit" then undo, return error .
      823   p-rep-rec = v-rep-rec.
      824   END PROCEDURE.
