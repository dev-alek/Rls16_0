        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input parameter p-obj-type like ub.clients.obj-type no-undo .
        3   define input parameter p-obj-code like ub.clients.obj-code no-undo .
        4   define input parameter p-mode        as character no-undo.
        5   define input-output parameter p-rep-rec     as recid no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "создание и изменение мест приемки/отгрузки".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   procedure proc-alt-shift-f2:
       67     if not ibs.th.gbl.gbl-var:rcode
       68   then
       69     run gbl\inidebug.p .
       70   end.
       71   procedure proc-alt-shift-f3:
       72     run gbl/prvssinf.p
       73       ( input this-procedure
       74       ) .
       75   end.
       76   define variable v-inform-launched as logical no-undo initial false .
       77   procedure proc-alt-shift-f4:
       78     define variable v-action as character no-undo .
       79     if v-inform-launched = false then do:
       80       assign
       81         v-inform-launched = true
       82       .
       83       run gbl/d-inform.w
       84         (  input self
       85         ,  input this-procedure
       86         , output v-action
       87         ) no-error .
       88       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       89       assign
       90         v-inform-launched = false
       91       .
       92     end.
       93   end.
       94   procedure proc-alt-f1:
       95     run gbl/corrhelp.p
       96       (input this-procedure
       97       ) .
       98   end .
       99   on alt-shift-f2 anywhere do:
      100     run proc-alt-shift-f2.
      101   end.
      102   on alt-shift-f3 anywhere do:
      103     run proc-alt-shift-f3 in this-procedure .
      104   end.
      105   on alt-shift-f4 anywhere do:
      106     run proc-alt-shift-f4 in this-procedure.
      107   end.
      108   on alt-f1 anywhere do:
      109     run proc-alt-f1 in this-procedure .
      110   end.
      111   define new global shared variable g#language as character no-undo .
      112   if g#language <> '' and g#language <> 'rus':U then do:
      113     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      114   end.
      115   define new global shared variable g#library  as handle no-undo .
      116   define new global shared variable g#library2 as handle no-undo .
      117   define buffer buf_place-io for ub.place-io .
      118   define variable p-sys-time as character no-undo .
      119   DEFINE BUTTON b-help
      120        LABEL "Помо&щь"
      121        SIZE 10 BY 1.
      122   DEFINE BUTTON B-hist
      123        LABEL "Ис&тория"
      124        SIZE 10 BY 1.
      125   DEFINE BUTTON b-quit AUTO-END-KEY
      126        LABEL "&Отмена"
      127        SIZE 10 BY 1.
      128   DEFINE BUTTON b-save AUTO-GO
      129        LABEL "&Ввод"
      130        SIZE 10 BY 1.
      131   DEFINE VARIABLE v-name AS CHARACTER FORMAT "X(40)"
      132        LABEL "Название"
      133        VIEW-AS FILL-IN
      134        SIZE 51 BY 1.
      135   DEFINE VARIABLE v-num AS INTEGER FORMAT ">>>>>>>>>9" INITIAL 0
      136        LABEL "Номер"
      137        VIEW-AS FILL-IN
      138        SIZE 19.5 BY 1.
      139   DEFINE VARIABLE v-PS AS CHARACTER FORMAT "X(256)":U
      140        VIEW-AS FILL-IN
      141        SIZE 62.5 BY 6.25 NO-UNDO.
      142   DEFINE VARIABLE RADIO-type AS INTEGER
      143        VIEW-AS RADIO-SET HORIZONTAL
      144        RADIO-BUTTONS
      145             "приемки", 1,
      146   "отгрузки", 2
      147        SIZE 26.5 BY 1 NO-UNDO.
      148   DEFINE FRAME Dialog-Frame
      149        b-save AT ROW 1 COL 1
      150        b-quit AT ROW 1 COL 11
      151        B-hist AT ROW 1 COL 41
      152        b-help AT ROW 1 COL 55.13
      153        RADIO-type AT ROW 2.5 COL 3 NO-LABEL
      154        v-num AT ROW 2.5 COL 42.5 COLON-ALIGNED
      155        v-name AT ROW 3.71 COL 11 COLON-ALIGNED
      156        v-PS AT ROW 5.92 COL 2 NO-LABEL
      157        "Примечание:" VIEW-AS TEXT
      158             SIZE 15 BY .67 AT ROW 5.08 COL 3
      159        SPACE(47.12) SKIP(6.70)
      160       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      161            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      162            TITLE "Место приемки/отгрузки".
      163   ASSIGN
      164          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      165          FRAME Dialog-Frame:HIDDEN           = TRUE.
      166   ASSIGN
      167          v-num:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      168   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      169   DO:
      170     APPLY "END-ERROR":U TO SELF.
      171   END.
      172   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
      173   DO:
      174     DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      175     if not available buf_place-io then return .
      176     run ref/pliohist.w ( INPUT parParentProc
      177                        , input buf_place-io.obj-type
      178                        , input buf_place-io.obj-code
      179                        , input buf_place-io.place-io-code
      180                        , input "":U
      181                        , input-output v-rid-list
      182                        ) no-error .
      183   END.
      184   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
      185   DO:
      186   p-rep-rec = ?.
      187   END.
      188   ON CHOOSE OF b-save IN FRAME Dialog-Frame
      189   DO:
      190     assign RADIO-type v-name v-PS .
      191     if v-name = "" or v-name = ? then do:
      192       message "Название места должно быть заполнено.".
      193       apply "entry" to v-name in frame Dialog-Frame.
      194       return no-apply.
      195     end.
      196     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      197       create buf_place-io .
      198       if can-find( ub.place-io no-lock where ub.place-io.place-io-code = v-num and ub.place-io.obj-type = p-obj-type and ub.place-io.obj-code = p-obj-code ) then do:
      199         run gen_code(input-output v-num ) no-error.
      200         if error-status:error then undo, return .
      201       end.
      202       assign
      203         buf_place-io.place-io-code = v-num
      204         buf_place-io.obj-type      = p-obj-type
      205         buf_place-io.obj-code      = p-obj-code
      206         buf_place-io.status_       = 'новый':U
      207       .
      208     end.
      209     assign
      210       buf_place-io.place-io-name = v-name
      211       buf_place-io.PS            = v-PS
      212     .
      213     if RADIO-type = 1 then assign buf_place-io.place-io-type = 'приемки':U .
      214     else                   assign buf_place-io.place-io-type = 'отгрузки':U .
      215     p-rep-rec = recid (buf_place-io).
      216   END.
      217   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      218   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      219   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      220   on help of frame Dialog-Frame
      221   do:
      222     run gbl/app_help.p
      223       (input this-procedure :file-name
      224       ,input ''
      225       ,input ?
      226       ) no-error.
      227     if error-status :error then do:
      228       message
      229         "Ошибка при вызове помощи"
      230         error-status :get-message(1)
      231         view-as alert-box .
      232     end.
      233   end.
      234   run minbtn-set in this-procedure .
      235   on choose of b-help in frame Dialog-Frame
      236   do:
      237     apply "help":u to frame Dialog-Frame .
      238   end.
      239   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      240   procedure minbtn-set :
      241       do
      242           on error undo, return error return-value
      243           :
      244           define variable ii              as integer       no-undo .
      245           define variable fh              as widget-handle no-undo .
      246           define variable hh              as widget-handle no-undo .
      247           define variable v-h             as handle        extent 4 no-undo .
      248           define variable v-name-button   as character     no-undo .
      249           define variable v-help-old-x    as decimal       no-undo .
      250           define variable v-help-old-y    as decimal       no-undo .
      251           define variable v-help-old-size as decimal       no-undo .
      252           define variable v-frame-width   as decimal       no-undo .
      253           define variable jj              as integer       no-undo .
      254           do
      255               on error undo, return error
      256               :
      257               assign
      258                   v-frame-width = frame Dialog-Frame:width - 0.3
      259                   fh            = frame Dialog-Frame:first-child
      260                   hh            = fh:first-child
      261                   ii            = 1
      262                   .
      263               do while valid-handle(hh):
      264                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      265                   do:
      266                       case lc(hh:name) :
      267                           when "b-help" then
      268                               do:
      269                                   hh:load-image-up("cmp/b-help.bmp":u) .
      270                                   hh:load-image-down("cmp/b-help.bmp":u) .
      271                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      272                                   hh:TOOLTIP = "Помощь" .
      273                                   v-help-old-x = hh:column .
      274                                   v-help-old-y = hh:row    .
      275                                   v-help-old-size = hh:width .
      276                                   hh:width-chars = 2.5 .
      277                               end.
      278                           when "b-print" then
      279                               do:
      280                                   hh:load-image("cmp/b-print.bmp":u) .
      281                                   hh:TOOLTIP = "Печать" .
      282                                   v-h[ii] = hh:handle .
      283                                   ii = ii + 1 .
      284                                   hh:width-chars = 3 .
      285                               end.
      286                           when "b-history" or
      287                           when "b-hist" then
      288                               do:
      289                                   hh:load-image("cmp/b-hist.bmp":u) .
      290                                   hh:TOOLTIP = "История" .
      291                                   v-h[ii] = hh:handle .
      292                                   ii = ii + 1 .
      293                                   hh:width-chars = 3 .
      294                               end.
      295                           when "b-sch" then
      296                               do:
      297                                   hh:load-image("cmp/b-sch.bmp":u) .
      298                                   hh:TOOLTIP = "Установка Фильтра" .
      299                                   v-h[ii] = hh:handle .
      300                                   ii = ii + 1 .
      301                                   hh:width-chars = 3 .
      302                               end.
      303                           when "b-hist-user" then
      304                               do:
      305                                   hh:load-image("cmp/b-hist.bmp":u) .
      306                                   hh:TOOLTIP = "История пользователя" .
      307                                   ii = ii + 1 .
      308                               end.
      309                       end case.
      310                   end.
      311                   hh = hh:next-sibling.
      312               end.
      313               b-help:column = v-frame-width - b-help:width-chars.
      314               jj = 0.
      315               repeat ii = 4 to 1 by -1 :
      316                   if valid-handle (v-h[ii] ) then
      317                   do:
      318                       jj  = jj + 1 .
      319                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      320                       v-h[ii]:row    = v-help-old-y .
      321                   end.
      322               end.
      323           end.
      324       end.
      325   end procedure.
      326   MAIN-BLOCK:
      327   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      328      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      329     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      330       find buf_place-io where recid (buf_place-io) = p-rep-rec.
      331       assign
      332         v-num  = buf_place-io.place-io-code
      333         v-name = buf_place-io.place-io-name
      334         v-PS   = buf_place-io.PS
      335       .
      336       if buf_place-io.place-io-type = 'приемки':U then assign RADIO-type = 1 .
      337       else                                             assign RADIO-type = 2 .
      338     end.
      339     else  run gen_code( input-output v-num ) no-error.
      340     frame Dialog-Frame:title = "Место приемки/отгрузки на объекте : " + p-obj-type + " " + string (p-obj-code) + "         " + p-mode.
      341     RUN enable_UI.
      342     WAIT-FOR GO OF FRAME Dialog-Frame.
      343   END.
      344   RUN disable_UI.
      345   PROCEDURE disable_UI :
      346     HIDE FRAME Dialog-Frame.
      347   END PROCEDURE.
      348   PROCEDURE enable_UI :
      349     DISPLAY RADIO-type v-num v-name v-PS WITH FRAME Dialog-Frame.
      350     ENABLE b-save b-quit B-hist b-help RADIO-type v-num v-name v-PS WITH FRAME Dialog-Frame.
      351     VIEW FRAME Dialog-Frame.
      352   END PROCEDURE.
      353   PROCEDURE gen_code :
      354     DEFINE INPUT-OUTPUT PARAMETER loc-f-code as integer no-undo.
      355     def var my-value as integer no-undo.
      356   gen-code:
      357     do while true:
      358       my-value = next-value( s-place-io, ub ).
      359       if my-value >= 99999999 or my-value = ? then do:
      360         current-value(s-place-io, ub) = 1.
      361         next.
      362       end.
      363       if not can-find( ub.place-io no-lock where ub.place-io.place-io-code = my-value and ub.place-io.obj-type = p-obj-type and ub.place-io.obj-code = p-obj-code ) then leave gen-code.
      364     end.
      365     assign loc-f-code = my-value .
      366   END PROCEDURE.
