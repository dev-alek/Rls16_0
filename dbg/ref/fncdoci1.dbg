     1192   do:
     1193     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1194       (input  v-cntxt-db-num
     1195       ,input  v-cntxt-userid
     1196       ,input  0
     1197       ,input  'actn_fin-contract_lookup':U
     1198       ,input  'firm':U
     1199       ,input  tt-c-fin-doc.host-code
     1200       ,input  '':U
     1201       ,input  0
     1202       ,input  0
     1203       ,input  0
     1204       ,input  0
     1205       ,input  true
     1206       ,output g-log
     1207       )  .
     1208   end.
     1209     if not g-log then  return .
     1210     ri = recid( X_contract ).
     1211     run str/sh-contr.p ( input parParentProc, input ri) no-error.
     1212     if error-status:error then return no-apply.
     1213   END.
