     1254   PROCEDURE fill-tables :
     1255   define buffer buf_c-fin-doc-tax for ub.c-fin-doc-tax.
     1256   define buffer buf_c-fin-doc-attr for ub.c-fin-doc-attr.
     1257   for each buf_c-fin-doc-tax no-lock where
     1258   buf_c-fin-doc-tax.host-code = tt-c-fin-doc.host-code
     1259   AND buf_c-fin-doc-tax.fin-doc-code = tt-c-fin-doc.fin-doc-code
     1260   AND buf_c-fin-doc-tax.chip-num = tt-c-fin-doc.chip-num
     1261    :
     1262       create tt0-fin-doc-tax.
     1263       buffer-copy buf_c-fin-doc-tax to tt0-fin-doc-tax.
     1264   end.
     1265   for each buf_c-fin-doc-attr no-lock where
     1266   buf_c-fin-doc-attr.host-code = tt-c-fin-doc.host-code
     1267   AND buf_c-fin-doc-attr.fin-doc-code = tt-c-fin-doc.fin-doc-code
     1268   AND buf_c-fin-doc-attr.chip-num = tt-c-fin-doc.chip-num
     1269   :
     1270       create tt0-fin-doc-attr.
     1271       buffer-copy buf_c-fin-doc-attr to tt0-fin-doc-attr.
     1272   end.
     1273   END PROCEDURE.
     1274   PROCEDURE hide-view-currency :
     1275   assign
     1276   v-rubf = no
     1277   v-exchf = no
     1278   v-basef = no
     1279   v-baseratef = no
     1280   v-contractf = no
     1281   v-contractratef = no
     1282   .
     1283   hide
     1284   tt-c-fin-doc.exch-rate in frame Dialog-Frame
     1285   tt-c-fin-doc.exch-scale
     1286   tt-c-fin-doc.sum-rubl
     1287   tt-c-fin-doc.sum-base
     1288   tt-c-fin-doc.base-rate
     1289   tt-c-fin-doc.base-scale
     1290   tt-c-fin-doc.sum-contr
     1291   tt-c-fin-doc.contract-rate
     1292   tt-c-fin-doc.contract-scale
     1293   in frame Dialog-Frame .
     1294   if tt-c-fin-doc.curr-code = 0
     1295   and v-base-code = 0
     1296   and
     1297   (tt-c-fin-doc.contract-code = 0
     1298   or tt-c-fin-doc.contract-curr = 0)
     1299   then do:
     1300       return.
     1301   end.
     1302   if tt-c-fin-doc.curr-code <> 0 then do:
     1303     if tt-c-fin-doc.curr-code:visible then
     1304     display
     1305     tt-c-fin-doc.exch-rate
     1306     tt-c-fin-doc.exch-scale
     1307     tt-c-fin-doc.sum-rubl
     1308     with frame Dialog-Frame.
     1309     assign
     1310     v-rubf = yes
     1311     v-exchf = yes
     1312     .
     1313   end.
     1314   if v-base-code <> 0 then do:
     1315     if tt-c-fin-doc.curr-code:visible then
     1316     display
     1317     tt-c-fin-doc.base-rate
     1318     tt-c-fin-doc.base-scale
     1319     tt-c-fin-doc.sum-base
     1320     with frame Dialog-Frame.
     1321     assign
     1322     v-basef = yes
     1323     v-baseratef = yes
     1324     .
     1325   end.
     1326   if tt-c-fin-doc.contract-code  <> 0 and
     1327     (tt-c-fin-doc.contract-curr <> 0  )
     1328     then do:
     1329       if tt-c-fin-doc.curr-code:visible then
     1330       display
     1331       tt-c-fin-doc.sum-contr
     1332       tt-c-fin-doc.contract-rate
     1333       tt-c-fin-doc.contract-scale
     1334       with frame Dialog-Frame.
     1335     assign
     1336     v-contractf = yes
     1337     v-contractratef = yes
     1338     .
     1339   end.
     1340   END PROCEDURE.
     1341   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1342   on help of frame Dialog-Frame
     1343   do:
     1344     run gbl/app_help.p
     1345       (input this-procedure :file-name
     1346       ,input ''
     1347       ,input ?
     1348       ) no-error.
     1349     if error-status :error then do:
     1350       message
     1351         "Ошибка при вызове помощи"
     1352         error-status :get-message(1)
     1353         view-as alert-box .
     1354     end.
     1355   end.
     1356   run minbtn-set in this-procedure .
     1357   on choose of b-help in frame Dialog-Frame
     1358   do:
     1359     apply "help":u to frame Dialog-Frame .
     1360   end.
     1361   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1362   procedure minbtn-set :
     1363       do
     1364           on error undo, return error return-value
     1365           :
     1366           define variable ii              as integer       no-undo .
     1367           define variable fh              as widget-handle no-undo .
     1368           define variable hh              as widget-handle no-undo .
     1369           define variable v-h             as handle        extent 4 no-undo .
     1370           define variable v-name-button   as character     no-undo .
     1371           define variable v-help-old-x    as decimal       no-undo .
     1372           define variable v-help-old-y    as decimal       no-undo .
     1373           define variable v-help-old-size as decimal       no-undo .
     1374           define variable v-frame-width   as decimal       no-undo .
     1375           define variable jj              as integer       no-undo .
     1376           do
     1377               on error undo, return error
     1378               :
     1379               assign
     1380                   v-frame-width = frame Dialog-Frame:width - 0.3
     1381                   fh            = frame Dialog-Frame:first-child
     1382                   hh            = fh:first-child
     1383                   ii            = 1
     1384                   .
     1385               do while valid-handle(hh):
     1386                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1387                   do:
     1388                       case lc(hh:name) :
     1389                           when "b-help" then
     1390                               do:
     1391                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1392                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1393                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1394                                   hh:TOOLTIP = "Помощь" .
     1395                                   v-help-old-x = hh:column .
     1396                                   v-help-old-y = hh:row    .
     1397                                   v-help-old-size = hh:width .
     1398                                   hh:width-chars = 2.5 .
     1399                               end.
     1400                           when "b-print" then
     1401                               do:
     1402                                   hh:load-image("cmp/b-print.bmp":u) .
     1403                                   hh:TOOLTIP = "Печать" .
     1404                                   v-h[ii] = hh:handle .
     1405                                   ii = ii + 1 .
     1406                                   hh:width-chars = 3 .
     1407                               end.
     1408                           when "b-history" or
     1409                           when "b-hist" then
     1410                               do:
     1411                                   hh:load-image("cmp/b-hist.bmp":u) .
     1412                                   hh:TOOLTIP = "История" .
     1413                                   v-h[ii] = hh:handle .
     1414                                   ii = ii + 1 .
     1415                                   hh:width-chars = 3 .
     1416                               end.
     1417                           when "b-sch" then
     1418                               do:
     1419                                   hh:load-image("cmp/b-sch.bmp":u) .
     1420                                   hh:TOOLTIP = "Установка Фильтра" .
     1421                                   v-h[ii] = hh:handle .
     1422                                   ii = ii + 1 .
     1423                                   hh:width-chars = 3 .
     1424                               end.
     1425                           when "b-hist-user" then
     1426                               do:
     1427                                   hh:load-image("cmp/b-hist.bmp":u) .
     1428                                   hh:TOOLTIP = "История пользователя" .
     1429                                   ii = ii + 1 .
     1430                               end.
     1431                       end case.
     1432                   end.
     1433                   hh = hh:next-sibling.
     1434               end.
     1435               b-help:column = v-frame-width - b-help:width-chars.
     1436               jj = 0.
     1437               repeat ii = 4 to 1 by -1 :
     1438                   if valid-handle (v-h[ii] ) then
     1439                   do:
     1440                       jj  = jj + 1 .
     1441                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1442                       v-h[ii]:row    = v-help-old-y .
     1443                   end.
     1444               end.
     1445           end.
     1446       end.
     1447   end procedure.
