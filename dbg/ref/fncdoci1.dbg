        1   DEFINE BUFFER locked_c-fin-doc FOR ub.c-fin-doc.
        2   DEFINE TEMP-TABLE tt-c-fin-doc NO-UNDO LIKE ub.c-fin-doc.
        3   DEFINE TEMP-TABLE tt0-fin-doc-attr NO-UNDO LIKE ub.fin-doc-attr.
        4   DEFINE TEMP-TABLE tt0-fin-doc-tax NO-UNDO LIKE ub.fin-doc-tax.
        5   DEFINE BUFFER X_clients-host FOR ub.clients.
        6   DEFINE BUFFER X_firm FOR ub.firm.
        7   DEFINE BUFFER X_sysconf FOR ub.sysconf.
        8   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        9   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo.
       10   define input parameter p-mode as character no-undo.
       11   define input parameter p-host-code like ub.fin-doc.host-code no-undo.
       12   define input parameter p-fin-doc-code like ub.fin-doc.fin-doc-code no-undo.
       13   define input parameter p-fin-ext-doc-type like ub.fin-doc.fin-ext-doc-type no-undo.
       14   define input-output parameter p-doc-rec as recid no-undo.
       15   define variable vss-revision    as character no-undo init "$Revision$":U .
       16   define variable vss-author      as character no-undo init "$Author$":U .
       17   define variable vss-date        as character no-undo init "$Date$":U .
       18   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       19   define variable vss-archive     as character no-undo init "$Archive$":U .
       20   define variable vss-description as character no-undo init "Карточка истории приходного ордера".
       21   procedure vss-get-info :
       22     define output parameter p-vss-revision    like vss-revision    no-undo .
       23     define output parameter p-vss-author      like vss-author      no-undo .
       24     define output parameter p-vss-date        like vss-date        no-undo .
       25     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       26     define output parameter p-vss-archive     like vss-archive     no-undo .
       27     define output parameter p-vss-description like vss-description no-undo .
       28     assign
       29       p-vss-revision    = vss-revision
       30       p-vss-author      = vss-author
       31       p-vss-date        = vss-date
       32       p-vss-workfile    = vss-workfile
       33       p-vss-archive     = vss-archive
       34       p-vss-description = vss-description
       35     .
       36   end procedure.
       37   procedure vss-get-parameters :
       38     define output parameter p-vss-parameters as character no-undo .
       39   end procedure.
       40   define new global shared variable g#vssrevis-logger as handle    no-undo .
       41   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       42   define variable v-vssrevis-logger                   as handle    no-undo .
       43   procedure vss-logevent :
       44     define input  parameter p-extra-paramters as character no-undo .
       45     define variable v-vssrevis-parameters as character no-undo .
       46     do
       47     on error undo, return error return-value
       48     :
       49       if  valid-handle(v-vssrevis-logger)
       50       and v-vssrevis-logger :get-signature("logevent") <> ""
       51       then do:
       52         run vss-get-parameters in this-procedure
       53           (output v-vssrevis-parameters
       54           ).
       55         run logevent in v-vssrevis-logger
       56           (input vss-workfile
       57           ,input vss-revision
       58           ,input v-vssrevis-parameters
       59           ,input p-extra-paramters
       60           ).
       61       end.
       62     end.
       63   end procedure.
       64   assign
       65     v-vssrevis-logger = g#vssrevis-logger
       66   .
       67   if  valid-handle(v-vssrevis-logger)
       68   and v-vssrevis-logger :get-signature("logevent") <> ""
       69   then do:
       70     assign
       71       v-vssrevis-logevent = true
       72     .
       73     run vss-logevent in this-procedure (input vss-description) .
       74   end.
       75   define variable v-db-num like ub.db.db-num no-undo.
       76   define variable v-view as character no-undo init "full":U.
       77   define variable v-not-uf-set as logical no-undo.
       78   define variable v-copy-mode as logical no-undo .
       79   define variable v-curr-code like ub.fin-doc.curr-code no-undo .
       80   define variable v-main-sum as character no-undo init "sum-doc":U.
       81   define variable v-main-curr as character no-undo init "exch-rate":U.
       82   define variable v-rubf          as logical no-undo .
       83   define variable v-exchf         as logical no-undo .
       84   define variable v-basef         as logical no-undo .
       85   define variable v-baseratef     as logical no-undo .
       86   define variable v-contractf     as logical no-undo .
       87   define variable v-contractratef as logical no-undo .
       88   define variable v-us            as logical no-undo .
       89   define buffer X_fin-code-cor-acc for ub.fin-code-cor-acc.
       90   define buffer X_fin-code-an-uchet for ub.fin-code-an-uchet.
       91   define buffer X_fin-code-cel-nazn for ub.fin-code-cel-nazn.
       92   define buffer X_fin-code-cor-acc1 for ub.fin-code-cor-acc.
       93   define buffer X_currency for ub.currency.
       94   define buffer X_receiver for ub.clients.
       95   DEFINE BUFFER X_payer FOR ub.clients.
       96   define buffer X_curr_sysconf for ub.sysconf.
       97   define buffer X_contract for ub.contract.
       98   define buffer X_fin-ob for ub.fin-ob.
       99   define variable v-base-code like ub.sysconf.host-code no-undo.
      100   define new global shared variable g#language as character no-undo .
      101   if g#language <> '' and g#language <> 'rus':U then do:
      102     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      103   end.
      104   define new global shared variable g#library  as handle no-undo .
      105   define new global shared variable g#library2 as handle no-undo .
      106   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      107   define variable v-waitfram-action01         as character   no-undo .
      108   define variable v-waitfram-action02         as character   no-undo .
      109   define variable v-waitfram-action03         as character   no-undo .
      110   define variable mWaitFramTextBeg            as character   no-undo.
      111   define variable mWaitFramTextEnd            as character   no-undo.
      112   define variable mWaitFramView               as logical     no-undo.
      113   define variable mWaitProcEvent              as logical     no-undo init yes.
      114   define variable mWaitFramInterval           as integer     no-undo init 1 .
      115   define variable mWaitFramStop               as logical     no-undo.
      116   define variable mWaitFramStopUser           as logical     no-undo.
      117   define variable mWaitFramStopTimeOut        as logical     no-undo.
      118   define variable mWaitFramStartProc          as datetime-tz no-undo.
      119   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      120   define button B-WaitFramStop auto-end-key
      121        label "Стоп"
      122        size 10 by 1 tooltip "Остоновить процесс".
      123   define button B-viewProcInfo
      124        label "Информация"
      125        size 15 by 1 tooltip "Информация о процесс".
      126   define frame waitfram
      127     v-waitfram-action01 format "x(72)" no-label skip
      128     v-waitfram-action02 format "x(72)" no-label skip
      129     v-waitfram-action03 format "x(72)" no-label skip
      130     B-viewProcInfo
      131     B-WaitFramStop at row 4 col 30
      132     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      133     .
      134   define new global shared variable mBatchMode as logical no-undo init ?.
      135   define variable mFramBachModHandle as handle no-undo.
      136   mFramBachModHandle = frame waitfram:handle.
      137   define variable mFameOldVis as logical no-undo.
      138   define variable mVisCUrentVin as logical no-undo.
      139   if session:batch-mode
      140   then
      141      mBatchMode = yes.
      142   if mBatchMode = ? then do:
      143     mVisCUrentVin = current-window:visible.
      144     mFameOldVis = mFramBachModHandle:visible.
      145     mFramBachModHandle:visible  = yes.
      146     mBatchMode = mFramBachModHandle:visible ne yes.
      147     mFramBachModHandle:visible = mFameOldVis.
      148     current-window:visible = mVisCUrentVin.
      149   end.
      150    if  log-manager:logfile-name ne ?
      151     then DO:
      152         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      153         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      154         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      155     end.
      156   on choose of B-WaitFramStop in frame waitfram
      157   do:
      158     mWaitFramStop = yes.
      159     mWaitFramStopUser = yes.
      160   end.
      161   function waitfram-check-timeout returns logical():
      162      define variable vtime as int64 no-undo.
      163      if mWaitFramStopTimeOut
      164      then
      165         return yes.
      166      vtime = ( now - mWaitFramStartProc ) / 1000 .
      167      if     mWaitFramTimeOut ne ?
      168         and mWaitFramTimeOut ne 0
      169         and mWaitFramTimeOut lt vtime
      170      then do:
      171         mWaitFramStopTimeOut = yes.
      172      end.
      173      return mWaitFramStopTimeOut.
      174   end.
      175   procedure waitfram-hide :
      176     if not session:batch-mode
      177     then do
      178     on error undo, return error return-value
      179     :
      180       pause 0 before-hide .
      181       if not mBatchMode then
      182         hide frame waitfram .
      183     if     not mWaitFramView
      184        and mWaitProcEvent
      185     then
      186       process events .
      187     end.
      188   end procedure.
      189   procedure waitfram-show :
      190     define input  parameter p-message as character no-undo .
      191     define variable v-left-margin as integer   no-undo .
      192     if not session:batch-mode
      193     then do
      194     on error undo, return error return-value
      195     :
      196       if length(p-message) <= 70 then do:
      197         assign
      198           v-left-margin = integer((70 - length(p-message)) / 2)
      199         .
      200         assign
      201           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      202         .
      203         assign
      204           v-waitfram-action01 = " "
      205           v-waitfram-action02 = " "
      206                                    + fill(" ", v-left-margin)
      207                                    + p-message
      208           v-waitfram-action03 = " "
      209         .
      210       end.
      211       else do:
      212         define variable vRindex1 as integer no-undo.
      213         define variable vRindex2 as integer no-undo.
      214         vRindex1 = r-index(p-message," ",70).
      215         if vRindex1 = 0
      216         then
      217            vRindex1 = 70.
      218         if length(p-message)  <= vRindex1 + 70 then do:
      219           assign
      220             v-waitfram-action01 = " "
      221             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      222             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      223           .
      224         end.
      225         else do:
      226           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      227           if vRindex2 <= vRindex1
      228           then
      229              vRindex2 = vRindex1 + 70.
      230           assign
      231             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      232             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      233             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      234           .
      235         end.
      236       end.
      237       B-viewProcInfo:visible   in frame waitfram = no.
      238       B-viewProcInfo:sensitive in frame waitfram = no.
      239       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      240       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      241       if  (   mWaitFramView
      242          or  mWaitProcEvent)
      243          and not mBatchMode
      244       then
      245          display
      246             v-waitfram-action01 skip
      247             v-waitfram-action02 skip
      248             v-waitfram-action03 skip
      249          with frame waitfram .
      250       if     mWaitFramView
      251          then do:
      252             if     mWaitFramInterval ne ?
      253                and not mBatchMode
      254             then
      255                wait-for go of frame waitfram pause mWaitFramInterval.
      256          end.
      257          else
      258             if     mWaitProcEvent
      259                and not mBatchMode
      260             then
      261                process events .
      262     end.
      263   end procedure.
      264      procedure waitfram-show-this:
      265         define input  parameter iInterval as int64 no-undo.
      266         define variable vtime as int64 no-undo.
      267         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      268         mWaitFramInterval = iInterval.
      269         run waitfram-show (substitute("&1&2 &3&4" ,
      270                                       mWaitFramTextBeg ,
      271                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      272                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      273                                       mWaitFramTextEnd
      274                                      )
      275                           ).
      276      end.
      277      procedure WaitFramRunPause:
      278         define input  parameter iInterval as dec no-undo.
      279         define variable vStart  as datetime-tz no-undo.
      280         define variable vend    as datetime-tz no-undo.
      281         define variable vint as int64 no-undo.
      282         define variable vOk as logical no-undo.
      283         vStart = now.
      284         vend   = vStart.
      285         publish "WaitFramPause" (iInterval,output vOk).
      286         vend   =  now.
      287         vint = vend - vStart.
      288         vint = iInterval - vint / 1000.
      289         if     not mWaitFramStop
      290            and (   vint > 0
      291                 or (    not vOk
      292                     and iInterval eq ?
      293                     )
      294                 )
      295         then
      296            run waitfram-show-this (iInterval).
      297         vend   =  now.
      298         vint = vend - vStart.
      299         vint = iInterval - vint / 1000.
      300         if     not mWaitFramStop
      301            and vint > 0
      302         then do:
      303            run gbl/pause.p (vint * 1000).
      304         end.
      305         if iInterval ne ?
      306         then
      307            publish "WaitFramStop".
      308         waitfram-check-timeout().
      309      end.
      310      procedure WaitFramWaitFor:
      311         define input  parameter iInterval as dec no-undo.
      312         assign
      313            mWaitFramStartProc   = now
      314            mWaitFramStopUser    = no
      315            mWaitFramStopTimeOut = no
      316         .
      317         block-wait:
      318         do while not mWaitFramStop:
      319            run WaitFramRunPause (iInterval).
      320            if  waitfram-check-timeout()
      321            then do:
      322               leave block-wait.
      323            end.
      324         end.
      325         run waitfram-hide.
      326      end.
      327   procedure waitfram-join :
      328     define input  parameter p-line-1  as character no-undo .
      329     define input  parameter p-line-2  as character no-undo .
      330     define input  parameter p-line-3  as character no-undo .
      331     define output parameter p-message as character no-undo .
      332     do
      333     on error undo, return error return-value
      334     :
      335       assign
      336         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      337                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      338                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      339       .
      340     end.
      341   end procedure.
      342   function waitfram-join-function returns character
      343     (input p-line-1 as character
      344     ,input p-line-2 as character
      345     ,input p-line-3 as character
      346     ).
      347     define variable v-message as character no-undo .
      348     run waitfram-join in this-procedure
      349       (input  p-line-1
      350       ,input  p-line-2
      351       ,input  p-line-3
      352       ,output v-message
      353       ) .
      354     return v-message .
      355   end function .
      356   procedure proc-alt-shift-f2:
      357     if not ibs.th.gbl.gbl-var:rcode
      358   then
      359     run gbl\inidebug.p .
      360   end.
      361   procedure proc-alt-shift-f3:
      362     run gbl/prvssinf.p
      363       ( input this-procedure
      364       ) .
      365   end.
      366   define variable v-inform-launched as logical no-undo initial false .
      367   procedure proc-alt-shift-f4:
      368     define variable v-action as character no-undo .
      369     if v-inform-launched = false then do:
      370       assign
      371         v-inform-launched = true
      372       .
      373       run gbl/d-inform.w
      374         (  input self
      375         ,  input this-procedure
      376         , output v-action
      377         ) no-error .
      378       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      379       assign
      380         v-inform-launched = false
      381       .
      382     end.
      383   end.
      384   procedure proc-alt-f1:
      385     run gbl/corrhelp.p
      386       (input this-procedure
      387       ) .
      388   end .
      389   on alt-shift-f2 anywhere do:
      390     run proc-alt-shift-f2.
      391   end.
      392   on alt-shift-f3 anywhere do:
      393     run proc-alt-shift-f3 in this-procedure .
      394   end.
      395   on alt-shift-f4 anywhere do:
      396     run proc-alt-shift-f4 in this-procedure.
      397   end.
      398   on alt-f1 anywhere do:
      399     run proc-alt-f1 in this-procedure .
      400   end.
      401   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      402   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      403   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
      404   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
      405   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      406   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      407   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
      408   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
      409   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
      410   procedure uf-name :
      411     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      412     define output parameter p-use-List_     as logical   no-undo .
      413     define output parameter p-type-List_     as character no-undo .
      414     define output parameter p-format-List_   as character no-undo .
      415     define output parameter p-use-Naim      as logical   no-undo .
      416     define output parameter p-type-Naim      as character no-undo .
      417     define output parameter p-format-Naim    as character no-undo .
      418     define output parameter p-use-print-graft as logical   no-undo .
      419     define output parameter p-use-sort-gr   as logical   no-undo .
      420     define output parameter p-use-type-price as logical   no-undo .
      421     define output parameter p-use-type-val  as logical   no-undo .
      422     define output parameter p-label          as character no-undo .
      423     define output parameter p-tooltip        as character no-undo .
      424     define output parameter p-user-can-edit  as logical   no-undo .
      425     define output parameter p-output-display as logical   no-undo .
      426     define output parameter p-other          as character no-undo .
      427     do
      428     on error undo, return error
      429     :
      430       case p-code :
      431               when 'cli-all-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника клиентов"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника клиентов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      432               when 'oldscode':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника неиспользуемых весовых кодов"     p-tooltip = "Настройки справочника неиспользуемых весовых кодов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      433               when 'gds-ref-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(8)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = yes      p-label = "Параметры вызова справочника товаров"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      434               when 'gds-grp-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(1)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника групп товаров"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника групп товаров"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
