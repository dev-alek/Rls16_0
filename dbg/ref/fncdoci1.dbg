     1158   procedure proc-color-widgets :
     1159   define input parameter p-list as character no-undo .
     1160   define input parameter p-fg as logical no-undo .
     1161   define input parameter p-bg as logical no-undo .
     1162   define input parameter p-fgc as integer no-undo .
     1163   define input parameter p-bgc as integer no-undo .
     1164   define variable ii as integer no-undo .
     1165   define variable fh as widget-handle no-undo .
     1166   define variable hh as widget-handle no-undo .
     1167     do
     1168     on error undo, return error
     1169     :
     1170       assign
     1171       fh = frame Dialog-Frame:first-child
     1172       hh = fh:first-child
     1173       .
     1174       do while valid-handle(hh):
     1175         if LOOKUP(hh:name, p-list) > 0  then do:
     1176           assign
     1177           hh:fgcolor = (if p-fg then p-fgc else hh:fgcolor)
     1178           hh:bgcolor = (if p-bg then p-bgc else hh:bgcolor)
     1179           .
     1180         end.
     1181         hh = hh:next-sibling.
     1182       end.
     1183     end.
     1184   end procedure.
     1185   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1186   ON CHOOSE OF B-contract-view IN FRAME Dialog-Frame
     1187   DO:
     1188   define variable g-log as logical no-undo.
     1189    define variable ri as recid no-undo .
     1190     if not avail X_contract then return no-apply.
