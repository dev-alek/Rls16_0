     1597       f-credit                         when (X_sysconf.is-corr-acc or  X_sysconf.is-an-uchet or X_sysconf.is-code-cel-nazn)
     1598       tt-c-fin-doc.cor-acc1-value      when X_sysconf.is-cassa-acc
     1599       f-cor-acc1-descr                 when X_sysconf.is-cassa-acc
     1600       tt-c-fin-doc.cor-acc-value       when X_sysconf.is-corr-acc
     1601       f-cor-acc-descr                  when X_sysconf.is-corr-acc
     1602       tt-c-fin-doc.an-uchet-value      when X_sysconf.is-an-uchet
     1603       f-an-uchet-descr                 when X_sysconf.is-an-uchet
     1604       tt-c-fin-doc.cel-nazn-value      when X_sysconf.is-code-cel-nazn
     1605       f-cel-nazn-descr                 when X_sysconf.is-code-cel-nazn
     1606       with frame Dialog-Frame
     1607       .
     1608     end.
     1609     when "brief":U then do:
     1610     end.
     1611     when "contract":U then do:
     1612       display
     1613       b-contract-view
     1614       f-contract-date when tt-c-fin-doc.contract-code <> 0
     1615       f-contract-prn-code when tt-c-fin-doc.contract-code <> 0
     1616       f-contract-type when tt-c-fin-doc.contract-code <> 0
     1617       f-contract-curr-abbr when tt-c-fin-doc.contract-code <> 0
     1618       tt-c-fin-doc.contract-curr when tt-c-fin-doc.contract-code <> 0
     1619       with frame Dialog-Frame
     1620       .
     1621       ENABLE
     1622       b-contract-view
     1623       with frame Dialog-Frame.
     1624     end.
     1625   END CASE.
     1626   END PROCEDURE.
     1627   PROCEDURE disable_UI :
     1628     HIDE FRAME Dialog-Frame.
     1629   END PROCEDURE.
     1630   PROCEDURE enable_UI :
     1631     OPEN QUERY Dialog-Frame FOR EACH locked_c-fin-doc SHARE-LOCK.
     1632     GET FIRST Dialog-Frame.
     1633     DISPLAY RS-view f-cor-acc1-descr f-cor-acc-descr f-contract-curr-abbr
     1634             f-contract-prn-code f-contract-date f-contract-type f-an-uchet-descr
     1635             f-cel-nazn-descr F-curr-abbr F-debet F-credit
     1636         WITH FRAME Dialog-Frame.
     1637     IF AVAILABLE tt-c-fin-doc THEN
     1638       DISPLAY tt-c-fin-doc.perm-date tt-c-fin-doc.prn-doc-code
     1639             tt-c-fin-doc.fin-doc-code tt-c-fin-doc.user-name-perm
     1640             tt-c-fin-doc.doc-date tt-c-fin-doc.user-name-doc tt-c-fin-doc.obj-type
     1641             tt-c-fin-doc.obj-code tt-c-fin-doc.fact-date
     1642             tt-c-fin-doc.user-name-fact tt-c-fin-doc.receiver-type
     1643             tt-c-fin-doc.receiver-okpo tt-c-fin-doc.receiver-name
     1644             tt-c-fin-doc.receiver-code tt-c-fin-doc.str-podr-type
     1645             tt-c-fin-doc.str-podr-code tt-c-fin-doc.str-podr-name
     1646             tt-c-fin-doc.cor-acc1-value tt-c-fin-doc.cor-acc-value
     1647             tt-c-fin-doc.contract-curr tt-c-fin-doc.an-uchet-value
     1648             tt-c-fin-doc.cel-nazn-value tt-c-fin-doc.sum-doc
     1649             tt-c-fin-doc.curr-code tt-c-fin-doc.exch-rate tt-c-fin-doc.exch-scale
     1650             tt-c-fin-doc.sum-rubl tt-c-fin-doc.base-rate tt-c-fin-doc.base-scale
     1651             tt-c-fin-doc.sum-base tt-c-fin-doc.contract-rate
     1652             tt-c-fin-doc.contract-scale tt-c-fin-doc.sum-contr
     1653             tt-c-fin-doc.payer-type tt-c-fin-doc.payer-code
     1654             tt-c-fin-doc.payer-name tt-c-fin-doc.naznach-plat
     1655             tt-c-fin-doc.including tt-c-fin-doc.enclosure tt-c-fin-doc.PS
     1656             tt-c-fin-doc.receiver-sign2 tt-c-fin-doc.receiver-sign3
     1657         WITH FRAME Dialog-Frame.
     1658     ENABLE B-exit b-quit B-tax B-Help RS-view tt-c-fin-doc.prn-doc-code
     1659            tt-c-fin-doc.doc-date tt-c-fin-doc.user-name-doc tt-c-fin-doc.obj-type
     1660            tt-c-fin-doc.obj-code B-receiver-view tt-c-fin-doc.str-podr-type
     1661            tt-c-fin-doc.str-podr-code tt-c-fin-doc.str-podr-name
     1662            tt-c-fin-doc.cor-acc1-value tt-c-fin-doc.cor-acc-value
     1663            f-contract-curr-abbr B-contract-view tt-c-fin-doc.contract-curr
     1664            tt-c-fin-doc.an-uchet-value tt-c-fin-doc.cel-nazn-value
     1665            tt-c-fin-doc.sum-doc tt-c-fin-doc.curr-code tt-c-fin-doc.exch-rate
     1666            tt-c-fin-doc.exch-scale tt-c-fin-doc.sum-rubl tt-c-fin-doc.sum-base
     1667            tt-c-fin-doc.contract-rate tt-c-fin-doc.contract-scale
     1668            tt-c-fin-doc.sum-contr tt-c-fin-doc.payer-type tt-c-fin-doc.payer-code
     1669            tt-c-fin-doc.payer-name B-payer-view tt-c-fin-doc.naznach-plat
     1670            tt-c-fin-doc.including tt-c-fin-doc.enclosure tt-c-fin-doc.PS
     1671            tt-c-fin-doc.receiver-sign2 tt-c-fin-doc.receiver-sign3
     1672         WITH FRAME Dialog-Frame.
     1673     VIEW FRAME Dialog-Frame.
     1674   END PROCEDURE.
     1675   PROCEDURE fill-main-table :
     1676   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1677   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1678     (output v-db-num
     1679     )  .
     1680   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1681   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1682     (input  p-host-code
     1683     ,output v-base-code
     1684     )  .
     1685     find first X_curr_sysconf no-lock where
     1686                     X_curr_sysconf.host-code = p-curr-host-code.
     1687     find first X_sysconf no-lock where
     1688                   X_sysconf.host-code = p-host-code.
     1689     if p-mode <> 'ПРОСМОТР':U then do:
     1690       if p-curr-host-code <> p-host-code
     1691       or (v-db-num <> X_sysconf.firm-db-num)
     1692       then do:
     1693         message
     1694         vss-workfile vss-revision vss-description skip
     1695         "Неверное значение параметров вызова p-mode и/или p-host-code и/или p-curr-host-code" p-mode p-host-code  p-curr-host-code
     1696         view-as alert-box ERROR.
     1697         undo, return error.
     1698       end.
     1699     end.
     1700     find first X_clients-host no-lock where
     1701                 X_clients-host.obj-type = 'орг':U
     1702             AND   X_clients-host.obj-code = p-host-code  no-error.
     1703     if not available X_clients-host then do:
     1704       message
     1705       vss-workfile vss-revision vss-description skip
     1706       "Неверное значение параметра вызова p-host-code"  p-host-code
     1707       view-as alert-box ERROR.
     1708       undo, return error.
     1709     end.
     1710     find first X_firm no-lock where
     1711                 X_firm.firm-code = p-host-code.
     1712     for each tt-c-fin-doc:
     1713       delete tt-c-fin-doc.
     1714     end.
     1715     for each tt0-fin-doc-attr:
     1716       delete tt0-fin-doc-attr.
     1717     end.
     1718     for each tt0-fin-doc-tax:
     1719       delete tt0-fin-doc-tax.
     1720     end.
     1721   find first locked_c-fin-doc no-lock where
     1722             recid(locked_c-fin-doc) = p-doc-rec no-error .
     1723   if not available locked_c-fin-doc then do:
     1724     find first locked_c-fin-doc no-lock where
     1725                 locked_c-fin-doc.host-code = p-host-code
     1726             AND locked_c-fin-doc.fin-doc-code = p-fin-doc-code no-error .
     1727   end.
     1728   if not available locked_c-fin-doc then do:
     1729     message
     1730     vss-workfile vss-revision vss-description skip
     1731     "Не найдена запись ИСТОРИИ ПРИХОДНОГО ОРДЕРА"
     1732     view-as alert-box error .
     1733     undo, return error.
     1734   end.
     1735   create tt-c-fin-doc.
     1736   buffer-copy locked_c-fin-doc to tt-c-fin-doc.
     1737   END PROCEDURE.
     1738   PROCEDURE Myenable :
     1739   define variable g-log as logical no-undo.
     1740   assign
     1741       tt-c-fin-doc.sum-rubl :label in frame Dialog-Frame = "Рубли"
     1742   .
     1743   run uf-get in this-procedure(
     1744       input  ('findoci-p':U + chr(4) + 'пко':U)
     1745       ,input  v-cntxt-userid
     1746       ,output v-uf-List_
     1747       ,output v-uf-Naim
     1748       ,output v-uf-print-graft
     1749       ,output v-uf-sort-gr
     1750       ,output v-uf-type-price
     1751       ,output v-uf-type-val
     1752   )  no-error.
     1753   if not error-status:error
     1754   and not v-uf-LIst_ = "":U
     1755   then do:
     1756       assign
     1757       v-view =  entry(1, v-uf-List_, chr(4))
     1758       .
     1759   end.
     1760   assign
     1761   frame Dialog-Frame:title = frame Dialog-Frame:title + chr(32) + x_clients-host.obj-name
     1762   tt-c-fin-doc.payer-type:radio-buttons = "Орг" + chr(44) + 'орг':U + chr(44) +
     1763                                         "Чел" + chr(44) + 'чел':U
     1764   rs-view:radio-buttons = "&Полностью" + chr(44) + "full":U +  chr(44) +
     1765                                       "&Сокращ." + chr(44) + "brief":U + chr(44) +
     1766                                       "&Договор" + chr(44) + "contract":U
     1767   rs-view = v-view
     1768   tt-c-fin-doc.obj-type:radio-buttons = "Маг" + chr(44) + 'маг':U + chr(44) +
     1769                                         "Скл" + chr(44) + 'скл':U
     1770   .
     1771   if tt-c-fin-doc.contract-code = 0 then do:
     1772       assign
     1773       g-log = rs-view:disable(radio-label("contract":U, RS-view:radio-buttons))
     1774       .
     1775       if rs-view = "contract":U then
     1776       assign
     1777       rs-view = "full":U
     1778       v-not-uf-set = yes.
     1779   end.
     1780   find first X_currency no-lock where
     1781                 X_currency.curr-code = tt-c-fin-doc.curr-code.
     1782   assign
     1783   f-curr-abbr = X_Currency.curr-abbr.
     1784   if tt-c-fin-doc.contract-code <> 0 then do:
     1785     find first X_currency no-lock where
     1786                   X_currency.curr-code = tt-c-fin-doc.contract-curr.
     1787     assign
     1788     f-contract-curr-abbr = X_Currency.curr-abbr.
     1789   end.
     1790   if tt-c-fin-doc.cor-acc1 <> 0 then do:
     1791       find first X_fin-code-cor-acc1 no-lock where
     1792                   X_fin-code-cor-acc1.fin-code  = tt-c-fin-doc.cor-acc1 no-error.
     1793       if available X_fin-code-cor-acc1 then do:
     1794         assign
     1795         f-cor-acc1-descr = X_fin-code-cor-acc1.descr.
     1796       end.
     1797       if not available X_fin-code-cor-acc1 then do:
     1798         assign
     1799         f-cor-acc1-descr = "!!!Код больше не существует".
     1800       end.
     1801   end.
     1802   if tt-c-fin-doc.cor-acc <> 0 then do:
     1803       find first X_fin-code-cor-acc no-lock where
     1804                   X_fin-code-cor-acc.fin-code  = tt-c-fin-doc.cor-acc no-error.
     1805       if available X_fin-code-cor-acc then do:
     1806         assign
     1807         f-cor-acc-descr = X_fin-code-cor-acc.descr.
     1808       end.
     1809       if not available X_fin-code-cor-acc then do:
     1810         assign
     1811         f-cor-acc-descr = "!!!Код больше не существует".
     1812       end.
     1813   end.
     1814   if tt-c-fin-doc.an-uchet-code <> 0 then do:
     1815     find first X_fin-code-an-uchet no-lock where
     1816                   X_fin-code-an-uchet.fin-code  = tt-c-fin-doc.an-uchet-code no-error.
     1817       if available X_fin-code-an-uchet then do:
     1818         assign
     1819         f-an-uchet-descr = X_fin-code-an-uchet.descr.
     1820       end.
     1821       if not available X_fin-code-an-uchet then do:
     1822         assign
     1823         f-an-uchet-descr = "!!!Код больше не существует".
     1824       end.
     1825   end.
     1826   if tt-c-fin-doc.cel-nazn-code <> 0 then do:
     1827     find first X_fin-code-cel-nazn no-lock where
     1828                   X_fin-code-cel-nazn.fin-code  = tt-c-fin-doc.cel-nazn-code no-error.
     1829       if available X_fin-code-cel-nazn then do:
     1830         assign
     1831         f-cel-nazn-descr = X_fin-code-cel-nazn.descr.
     1832       end.
     1833       if not available X_fin-code-cel-nazn then do:
     1834         assign
     1835         f-cel-nazn-descr = "!!!Код больше не существует".
     1836       end.
     1837   end.
     1838   run proc-color-widgets in this-procedure("f-an-uchet-descr,f-cel-nazn-descr,f-contract-curr-abbr,f-contract-date,f-contract-prn-code,f-contract-rate," +                         "f-contract-scale,f-contract-type,f-cor-acc1-descr,f-cor-acc-descr,base-rate,base-scale,curr-code,exch-rate,exch-scale," +                         "fact-date,fin-doc-code,payer-code,payer-type,perm-date,PS,receiver-code,receiver-type,sum-base,sum-rubl," +                         "user-name-doc,user-name-fact,user-name-perm", no, yes, ?, grey_color).
     1839   run proc-color-widgets in this-procedure("F-curr-abbr,an-uchet-value,cel-nazn-value,cor-acc1-value,cor-acc-value,doc-date,enclosure," +                       "including,naznach-plat,payer-name,prn-doc-code,receiver-name,receiver-okpo,receiver-sign2,receiver-sign3," +                       "str-podr-code,str-podr-name,str-podr-type,sum-doc", no, yes, ?, grey_color).
     1840   run change-view in this-procedure(rs-view).
     1841   VIEW FRAME Dialog-Frame.
     1842   END PROCEDURE.
