     1519   f-contract-date
     1520   f-contract-prn-code
     1521   f-contract-type
     1522   f-contract-curr-abbr
     1523   tt-c-fin-doc.contract-curr
     1524   b-receiver-view
     1525   tt-c-fin-doc.receiver-type
     1526   tt-c-fin-doc.receiver-code
     1527   tt-c-fin-doc.receiver-okpo
     1528   tt-c-fin-doc.receiver-name
     1529   tt-c-fin-doc.str-podr-type
     1530   tt-c-fin-doc.str-podr-code
     1531   tt-c-fin-doc.str-podr-name
     1532   IN FRAME Dialog-Frame.
     1533   display
     1534   F-curr-abbr
     1535   with frame Dialog-Frame
     1536   .
     1537   IF AVAILABLE tt-c-fin-doc THEN
     1538     display
     1539     tt-c-fin-doc.fin-doc-code
     1540     tt-c-fin-doc.prn-doc-code
     1541     tt-c-fin-doc.doc-date
     1542     tt-c-fin-doc.user-name-doc
     1543     tt-c-fin-doc.obj-type
     1544     tt-c-fin-doc.obj-code
     1545     tt-c-fin-doc.sum-rubl
     1546     tt-c-fin-doc.curr-code
     1547     tt-c-fin-doc.sum-doc
     1548     tt-c-fin-doc.payer-code
     1549     tt-c-fin-doc.payer-type
     1550     tt-c-fin-doc.payer-name
     1551     tt-c-fin-doc.including
     1552     tt-c-fin-doc.naznach-plat
     1553     tt-c-fin-doc.enclosure
     1554     tt-c-fin-doc.PS
     1555     tt-c-fin-doc.receiver-sign2
     1556     tt-c-fin-doc.receiver-sign3
     1557     with frame Dialog-Frame
     1558     .
     1559     if tt-c-fin-doc.perm-date <> ? then
     1560     display
     1561     tt-c-fin-doc.perm-date
     1562     tt-c-fin-doc.user-name-perm
     1563     with frame Dialog-Frame
