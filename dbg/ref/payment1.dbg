        1   block-level on error undo, throw.
        2   define input parameter        p-mode as character no-undo .
        3   define input parameter        p-silent as logical no-undo .
        4   define input-output parameter p-pmnt-code as character  no-undo .
        5   define input parameter        p-cli-type as character no-undo .
        6   define input parameter        p-cli-code as integer no-undo .
        7   define input parameter        p-payer-type as character no-undo .
        8   define input parameter        p-payer-code as integer no-undo .
        9   define input parameter        p-host-code as integer no-undo .
       10   define input parameter        p-tot-cli as decimal no-undo .
       11   define input parameter        p-tot-base as decimal no-undo .
       12   define input parameter        p-tot-rubl as decimal no-undo .
       13   define input parameter        p-exch-date as date no-undo .
       14   define input parameter        p-exch-code as integer no-undo .
       15   define input parameter        p-exch-rate as decimal no-undo .
       16   define input parameter        p-exch-scale as integer no-undo .
       17   define input parameter        p-base-rate as decimal no-undo .
       18   define input parameter        p-base-scale as integer no-undo .
       19   define input parameter        p-due-date as date no-undo .
       20   define input parameter        p-fact-date as date no-undo .
       21   define input parameter        p-source-type as character no-undo .
       22   define input parameter        p-source-ref as character no-undo .
       23   define input parameter        p-d-card as character no-undo .
       24   define input parameter        p-pay-code as integer no-undo .
       25   define input parameter        p-status_ as character no-undo .
       26   define input parameter        p-PS as character no-undo .
       27   define input parameter        p-creid as character no-undo .
       28   define input parameter        p-closid as character no-undo .
       29   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       30   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       31   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       32   define variable vss-workfile    as character no-undo init "$Workfile: payment1.p $":U .
       33   define variable vss-archive     as character no-undo init "$Archive: ref/payment1.p $":U .
       34   define variable vss-description as character no-undo init "Создание ручного платежа - payment".
       35   procedure vss-get-info :
       36     define output parameter p-vss-revision    like vss-revision    no-undo .
       37     define output parameter p-vss-author      like vss-author      no-undo .
       38     define output parameter p-vss-date        like vss-date        no-undo .
       39     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       40     define output parameter p-vss-archive     like vss-archive     no-undo .
       41     define output parameter p-vss-description like vss-description no-undo .
       42     assign
       43       p-vss-revision    = vss-revision
       44       p-vss-author      = vss-author
       45       p-vss-date        = vss-date
       46       p-vss-workfile    = vss-workfile
       47       p-vss-archive     = vss-archive
       48       p-vss-description = vss-description
       49     .
       50   end procedure.
       51   procedure vss-get-parameters :
       52     define output parameter p-vss-parameters as character no-undo .
       53   end procedure.
       54   define new global shared variable g#vssrevis-logger as handle    no-undo .
       55   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       56   define variable v-vssrevis-logger                   as handle    no-undo .
       57   procedure vss-logevent :
       58     define input  parameter p-extra-paramters as character no-undo .
       59     define variable v-vssrevis-parameters as character no-undo .
       60     do
       61     on error undo, return error return-value
       62     :
       63       if  valid-handle(v-vssrevis-logger)
       64       and v-vssrevis-logger :get-signature("logevent") <> ""
       65       then do:
       66         run vss-get-parameters in this-procedure
       67           (output v-vssrevis-parameters
       68           ).
       69         run logevent in v-vssrevis-logger
       70           (input vss-workfile
       71           ,input vss-revision
       72           ,input v-vssrevis-parameters
       73           ,input p-extra-paramters
       74           ).
       75       end.
       76     end.
       77   end procedure.
       78   assign
       79     v-vssrevis-logger = g#vssrevis-logger
       80   .
       81   if  valid-handle(v-vssrevis-logger)
       82   and v-vssrevis-logger :get-signature("logevent") <> ""
       83   then do:
       84     assign
       85       v-vssrevis-logevent = true
       86     .
       87     run vss-logevent in this-procedure (input vss-description) .
       88   end.
       89   define new global shared variable g#language as character no-undo .
       90   if g#language <> '' and g#language <> 'rus':U then do:
       91     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       92   end.
       93   define new global shared variable g#library  as handle no-undo .
       94   define new global shared variable g#library2 as handle no-undo .
       95   define   shared variable g#auto as logical no-undo.
       96   define   shared variable g#news as logical no-undo.
       97   define   shared variable g#oxml as logical no-undo.
       98   define   shared variable g#esys as logical no-undo.
       99   define   shared variable g#news-source-db as integer no-undo.
      100   define   shared variable g#esys-source-esys as integer no-undo.
      101   define   shared variable g#db-num as integer   no-undo .
      102   define   shared variable g#userid as character no-undo .
      103   define   shared variable g#passwd as character no-undo .
      104   define variable v-mess as character no-undo .
      105   define variable v-pmnt-code as character no-undo .
      106   define variable for-sign as integer no-undo .
      107   define variable icount as integer no-undo .
      108   define variable ctemp as character no-undo .
      109   define variable v-obj-type as character no-undo .
      110   define variable v-obj-code as integer no-undo .
      111   define buffer buf_obj-clients for ub.clients.
      112   define buffer buf_payment for ub.payment.
      113   define buffer buf_payment-attr for ub.payment-attr.
      114   define buffer payer for ub.clients.
      115   define buffer buf_clients for ub.clients.
      116   define buffer buf_pay-type for ub.pay-type.
      117   define buffer buf_cash-pay for ub.cash-pay.
      118   define buffer buf_currency for ub.currency.
      119   define buffer buf_ord-doc for ub.ord-doc.
      120   define buffer buf_dis-card for ub.dis-card.
      121   if p-mode <> 'ДОБАВЛЕНИЕ':U
      122   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
      123     message vss-workfile vss-revision vss-description skip
      124             "Неверный параметр p-mode - " p-mode
      125     view-as alert-box error .
      126     return error '':u.
      127   end.
      128   if lookup(p-source-type, ('заказ':U + chr(4) +
      129                             'платеж':U + chr(4) +
      130                             '':U + chr(4) +
      131                             'касс':U + chr(4) +
      132                             'накл':U + chr(4) +
      133                             'платеж':U + chr(4) +
      134                             'inkas':U + chr(4) +
      135                             'trn-doc':U + chr(4) +
      136                             ('trn-doc':U + chr(44) + 'import':U) + chr(4) +
      137                             ('inkas':U + chr(44) + 'import':U)
      138                             ), chr(4) ) = 0
      139   then do:
      140     message vss-workfile vss-revision vss-description skip
      141             "Неверный параметр p-source-type - " p-source-type
      142     view-as alert-box error .
      143     return error '':u.
      144   end.
      145   case p-source-type:
      146     when 'inkas':U
      147     then do:
      148       p-source-type = 'касс':U.
      149     end.
      150     when 'trn-doc':U then do:
      151       p-source-type = 'накл':U.
      152     end.
      153     when ('inkas':U + chr(44) + 'import':U) then do:
      154       p-source-type = 'касс':U + chr(44) + 'import':U.
      155     end.
      156     when ('trn-doc':U + chr(44) + 'import':U) then do:
      157       p-source-type = 'накл':U + chr(44) + 'import':U.
      158     end.
      159   end case.
      160   if g#db-num <> 0 then do:
      161     message vss-workfile vss-revision vss-description skip
      162             "Запрещено вызывать процедуру в УБД"
      163     view-as alert-box error .
      164     return error '':u.
      165   end.
      166   _main:
      167   do for buf_payment
      168   on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      169   on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
      170   on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )
      171   :
      172     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      173       if p-source-type = 'платеж':U then do:
      174         if entry(1, p-pmnt-code, "_") = '':U then do:
      175           v-pmnt-code = string(next-value(s-pmnt-code, ub)).
      176         end.
      177         else do:
      178           v-pmnt-code = entry(1, p-pmnt-code, "_").
      179         end.
      180       end.
      181       else do:
      182         v-pmnt-code = string(next-value(s-pmnt-code, ub)).
      183       end.
      184       if p-source-type = 'платеж':U then do:
      185         v-pmnt-code = substitute("&1_&2", v-pmnt-code, entry(2, p-pmnt-code, "_")).
      186       end.
      187       if can-find(first ub.payment where ub.payment.pmnt-code = v-pmnt-code) then do:
      188         assign
      189         v-mess = substitute("Не удается создать запись платежа с кодом &1&2"  +
      190                             "Платеж с таким кодом уже есть в БД"
      191                           , v-pmnt-code
      192                           , chr(10)
      193                           ).
      194         run err-mess in this-procedure ( input-output v-mess).
      195         return error (if p-silent = yes then v-mess else '':U).
      196       END.
      197     end.
      198     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      199       find first buf_payment exclusive-lock where
      200                buf_payment.pmnt-code = p-pmnt-code.
      201       v-pmnt-code = buf_payment.pmnt-code.
      202       if buf_payment.status_ = 'факт':U
      203       then do:
      204         assign
      205         v-mess = substitute("Платеж находится в статусе &1, изменение невозможно"
      206                            , buf_payment.status_
      207                            ).
      208         run err-mess in this-procedure ( input-output v-mess).
      209         return error (if p-silent = yes then v-mess else 'status_':U).
      210       end.
      211     end.
      212     find first buf_clients no-lock where
      213               buf_clients.obj-type = p-payer-type
      214            and buf_clients.obj-code = p-payer-code no-error.
      215     if not available buf_clients
      216     or (buf_clients.obj-type = 'скл':U
      217         OR
      218         buf_clients.obj-type = 'маг':U
      219         )
      220     or (buf_clients.obj-type = 'орг':U
      221         and
      222         buf_clients.obj-code = p-host-code)
      223     then do:
      224         assign
      225         v-mess = substitute("Неправильный код или тип клиента: &1&2"
      226                             , p-payer-type
      227                             , p-payer-code
      228                            ).
      229         run err-mess in this-procedure ( input-output v-mess).
      230         return error (if p-silent = yes then v-mess else 'cli-code':U).
      231     end.
      232     find first payer no-lock where
      233               payer.obj-type = p-payer-type
      234            and payer.obj-code = p-payer-code no-error.
      235     if not available payer then do:
      236         assign
      237         v-mess = substitute("Неправильный код или тип плательщика: &1&2"
      238                             , p-payer-type
      239                             , p-payer-code
      240                            ).
      241         run err-mess in this-procedure ( input-output v-mess).
      242         return error (if p-silent = yes then v-mess else 'payer-code':U).
      243     end.
      244     if lookup(p-source-type, ('касс':U + chr(4) +
      245                              'заказ':U + chr(4) +
      246                              'накл':U + chr(4) +
      247                              'касс':U + chr(4) +
      248                              'платеж':U + chr(4) +
      249                              'касс':U + chr(44) + 'import':U + chr(4) +
      250                              'накл':U + chr(44) + 'import':U + chr(4) +
      251                              '':U)
      252                            , chr(4)
      253               ) = 0 then do:
      254       assign
      255       v-mess = substitute("Неправильный тип первичного документа =&1"
      256                           , p-source-type
      257                           ).
      258       run err-mess in this-procedure ( input-output v-mess).
      259       return error (if p-silent = yes then v-mess else 'payer-code':U).
      260     end.
      261     find first buf_currency no-lock where
      262               buf_currency.curr-code = p-exch-code no-error.
      263     if not available buf_currency then do:
      264       assign
      265       v-mess = substitute("Неправильная валюта =&1"
      266                           , p-exch-code
      267                           ).
      268       run err-mess in this-procedure ( input-output v-mess).
      269       return error (if p-silent = yes then v-mess else 'exch-code':U).
      270     end.
      271     case p-source-type:
      272       when 'заказ':U then do:
      273         find first buf_pay-type no-lock where
      274                   buf_pay-type.obj-code = p-pay-code no-error.
      275         if not available buf_pay-type then do:
      276           assign
      277           v-mess = substitute("Неправильный код оплаты =&1"
      278                               , p-pay-code
      279                             ).
      280           run err-mess in this-procedure ( input-output v-mess).
      281           return error (if p-silent = yes then v-mess else 'pay-code':U).
      282         end.
      283         find first buf_ord-doc no-lock where
      284                   buf_ord-doc.doc-code = p-source-ref no-error.
      285         if not available buf_ord-doc then do:
      286           assign
      287           v-mess = substitute("Не найден заказ с N &1: первичный документ для платежа"
      288                               , p-source-ref ).
      289           run err-mess in this-procedure ( input-output v-mess).
      290           return error (if p-silent = yes then v-mess else 'source-ref':U).
      291         end.
      292         if buf_ord-doc.cli-type <> buf_clients.obj-type OR
      293         buf_ord-doc.cli-code <> buf_clients.obj-code then do:
      294           assign
      295           v-mess =  substitute("Неверно выбран документ для платежа:&1" +
      296                       "Плательщик платежа =&2&3, клиент для заказа = &4&5"
      297                       ,chr(10)
      298                       ,buf_clients.obj-type
      299                       ,buf_clients.obj-code
      300                       ,buf_ord-doc.cli-type
      301                       ,buf_ord-doc.cli-code
      302                       ).
      303           run err-mess in this-procedure ( input-output v-mess).
      304           return error (if p-silent = yes then v-mess else 'source-ref':U).
      305         END.
      306         if buf_ord-doc.host-code <> p-host-code then do:
      307           assign
      308           v-mess =  substitute("Неверно выбран документ для платежа:&1" +
      309                       "Платеж на фирму &2, а заказ на фирму &3"
      310                       ,chr(10)
      311                       ,p-host-code
      312                       ,buf_ord-doc.host-code
      313                       ).
      314           run err-mess in this-procedure ( input-output v-mess).
      315           return error (if p-silent = yes then v-mess else 'source-ref':U).
      316         end.
      317         if NOT (buf_ord-doc.status_ = 'факт':U
      318                 and buf_ord-doc.flag_ = yes) then do:
      319           assign
      320           v-mess =  substitute("Нельзя создать платеж&1" +
      321                         "для заказа в статусе &2"
      322                         , chr(10)
      323                         ,(buf_ord-doc.status_ + string(buf_ord-doc.flag_, "+/-"))
      324                         ).
      325           run err-mess in this-procedure ( input-output v-mess).
      326           return error (if p-silent = yes then v-mess else 'source-ref':U).
      327         end.
      328         assign
      329         for-sign = (if (buf_ord-doc.doc-type = 'при':U)
      330                     then 1
      331                     else -1).
      332       end.
      333       when 'касс':U
      334       or
      335       when ('касс':U + chr(44) + 'import':U)
      336       or
      337       when 'накл':U
      338       or
      339       when ('накл':U + chr(44) + 'import':U)
      340       or
      341       when '':U
      342       or
      343       when 'платеж':U
      344       then do:
      345         case p-source-type:
      346           when '':U
      347           or
      348           when 'платеж':U
      349           then do:
      350             if p-source-type = '':U then do:
      351               for-sign = 1.
      352             end.
      353             if p-source-type = 'платеж':U then do:
      354               if p-source-ref begins '-':U then do:
      355                 for-sign = -1.
      356               end.
      357               else do:
      358                 for-sign = 1.
      359               end.
      360             end.
      361             if p-source-type = '':U then do:
      362               find first buf_pay-type no-lock where
      363                         buf_pay-type.obj-code = p-pay-code no-error.
      364               if not available buf_pay-type then do:
      365                 assign
      366                 v-mess = substitute("Неправильный код оплаты =&1"
      367                                     , p-pay-code
      368                                   ).
      369                 run err-mess in this-procedure ( input-output v-mess).
      370                 return error (if p-silent = yes then v-mess else 'pay-code':U).
      371               end.
      372             end.
      373             if p-d-card <> '':U then do:
      374               FIND FIRST buf_dis-card No-LOCK WHERE
      375                           buf_dis-card.d-card = p-d-card NO-ERROR.
      376               if not avail buf_dis-card then do:
      377                 assign
      378                 v-mess =  substitute("Не найдена дисконтная карта с номером &1"
      379                               ,p-d-card).
      380                 run err-mess in this-procedure ( input-output v-mess).
      381                 return error (if p-silent = yes then v-mess else 'd-card':U).
      382               end.
      383               if buf_dis-card.cli-type <> buf_clients.obj-type
      384               OR buf_dis-card.cli-code <> buf_clients.obj-code then do:
      385                 assign
      386                 v-mess =  substitute("Неверно выбрана карта для платежа:&1" +
      387                             "Плательщик платежа =&2&3, держатель карты = &4&5"
      388                             ,chr(10)
      389                             ,buf_clients.obj-type
      390                             ,buf_clients.obj-code
      391                             ,buf_dis-card.cli-type
      392                             ,buf_dis-card.cli-code
      393                             ).
      394                 run err-mess in this-procedure ( input-output v-mess).
      395                 return error (if p-silent = yes then v-mess else 'd-card':U).
      396               END.
      397               if buf_dis-card.emitent-host-code <> p-host-code
      398               AND buf_dis-card.emitent-host-code <> 0 then do:
      399                 assign
      400                 v-mess =  substitute("Неверно выбрана карта для платежа:&1" +
      401                             "Платеж на фирму &2, а карта фирмы &3"
      402                             ,chr(10)
      403                             ,p-host-code
      404                             ,buf_dis-card.emitent-host-code
      405                             ).
      406                 run err-mess in this-procedure ( input-output v-mess).
      407                 return error (if p-silent = yes then v-mess else 'd-card':U).
      408               end.
      409               if buf_dis-card.status_ = 'блок':U
      410               OR buf_dis-card.status_ = 'удал':U then do:
      411                 assign
      412                 v-mess =  substitute("Нельзя создать платеж&1" +
      413                               "для карты в статусе &2"
      414                               ,chr(10)
      415                               ,buf_dis-card.status_).
      416                 run err-mess in this-procedure ( input-output v-mess).
      417                 return error (if p-silent = yes then v-mess else 'd-card':U).
      418               end.
      419             end.
      420           end.
      421           when 'касс':U
      422           or
      423           when ('касс':U  + chr(44) + 'import':U)
      424           then do:
      425             find first buf_cash-pay no-lock where
      426                       buf_cash-pay.cdpay-code = p-pay-code
      427                   and buf_cash-pay.curr-code = p-exch-code  no-error.
      428             if not available buf_cash-pay then do:
      429                 assign
      430                 v-mess = substitute("Неправильный код кассового платежа =&1 код валюты=&2"
      431                                     , p-pay-code
      432                                     , p-exch-code
      433                                   ).
      434                 run err-mess in this-procedure ( input-output v-mess).
      435                 return error (if p-silent = yes then v-mess else 'pay-code':U).
      436             end.
      437             for-sign = (if p-tot-cli >= 0 then 1 else -1).
      438           end.
      439           when 'накл':U
      440           or
      441           when ('накл':U  + chr(44) + 'import':U)
      442           then do:
      443             find first buf_pay-type no-lock where
      444                       buf_pay-type.obj-code = p-pay-code no-error.
      445             if not available buf_pay-type then do:
      446               assign
      447               v-mess = substitute("Неправильный код оплаты =&1"
      448                                   , p-pay-code
      449                                 ).
      450               run err-mess in this-procedure ( input-output v-mess).
      451               return error (if p-silent = yes then v-mess else 'pay-code':U).
      452             end.
      453             for-sign = (if p-tot-cli >= 0 then 1 else -1).
      454           end.
      455         end case.
      456       end.
      457     end case.
      458     IF p-tot-cli = ? then do:
      459       assign
      460       v-mess = substitute("Сумма платежа неопределена"
      461                         ).
      462       run err-mess in this-procedure ( input-output v-mess).
      463       return error (if p-silent = yes then v-mess else 'tot-cli':U).
      464     end.
      465     if (for-sign > 0) NE (p-tot-cli > 0)
      466     and not p-tot-cli = 0
      467     then do:
      468       assign
      469       v-mess = substitute("Неверная сумма"
      470                         ).
      471       run err-mess in this-procedure ( input-output v-mess).
      472       return error (if p-silent = yes then v-mess else 'tot-cli':U).
      473     end.
      474     if num-entries( p-PS, chr(10) ) > 1 then do:
      475       do icount = 1 to num-entries( p-PS, chr(10) ):
      476         ctemp = entry( icount, p-PS, chr(10) ).
      477         if index( ctemp, 'obj-type=' ) > 0 and num-entries( ctemp ) = 2 then do:
      478           assign
      479             v-obj-type = substring( entry( 1, ctemp ), index( entry( 1, ctemp ), '=' ) + 1 )
      480             v-obj-code = integer( substring( entry( 2, ctemp ), index( entry( 2, ctemp ), '=' ) + 1 ) )
      481             no-error .
      482           p-PS = replace( p-PS, chr(10) + ctemp, '' ).
      483           find first buf_obj-clients no-lock
      484             where buf_obj-clients.obj-type = v-obj-type
      485               and buf_obj-clients.obj-code = v-obj-code
      486             no-error .
      487           if not avail buf_obj-clients then do:
      488             assign
      489               v-obj-type = '':U
      490               v-obj-code = 0
      491             .
      492           end.
      493         end.
      494       end.
      495     end.
      496     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      497       create buf_payment.
      498       assign
      499       buf_payment.pmnt-code = v-pmnt-code
      500       buf_payment.cli-type  = p-cli-type
      501       buf_payment.cli-code  = p-cli-code
      502       buf_payment.creid = p-creid
      503       .
      504     end.
      505     assign
      506     buf_payment.payer-type   = p-payer-type
      507     buf_payment.payer-code   = p-payer-code
      508     buf_payment.host-code    = p-host-code
      509     buf_payment.due-date     = p-due-date
      510     buf_payment.tot-cli      = p-tot-cli
      511     buf_payment.status_      = p-status_
      512     buf_payment.PS           = p-PS
      513     buf_payment.exch-date    = p-exch-date
      514     buf_payment.exch-code    = p-exch-code
      515     buf_payment.exch-rate    = p-exch-rate
      516     buf_payment.exch-scale   = p-exch-scale
      517     buf_payment.base-rate    = p-base-rate
      518     buf_payment.base-scale   = p-base-scale
      519     buf_payment.tot-base     = p-tot-base
      520     buf_payment.tot-rubl     = p-tot-rubl
      521     buf_payment.source-type  = p-source-type
      522     buf_payment.source-ref   = p-source-ref
      523     buf_payment.d-card       = p-d-card
      524     buf_payment.fact-date    = p-fact-date
      525     buf_payment.pay-code     = p-pay-code
      526     buf_payment.closid = (if p-status_ = 'факт':U then p-closid else '':U)
      527     p-pmnt-code = buf_payment.pmnt-code
      528     .
      529     VALIDATE buf_payment.
      530     if v-obj-type <> '':U and v-obj-code <> 0 then do:
      531       find first buf_payment-attr no-lock
      532         where buf_payment-attr.pmnt-code = buf_payment.pmnt-code
      533           and buf_payment-attr.attr-code = "obj"
      534         no-error .
      535       if not avail buf_payment-attr then do:
      536         create buf_payment-attr.
      537         assign
      538           buf_payment-attr.pmnt-code = buf_payment.pmnt-code
      539           buf_payment-attr.attr-code = "obj"
      540           buf_payment-attr.attr-value = v-obj-type + ',' + string( v-obj-code )
      541         .
      542       end.
      543     end.
      544   end.
      545   PROCEDURE err-mess:
      546     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      547     CASE p-silent:
      548       when yes then do:
      549         assign
      550         p-mess = substitute("Платеж: &1 плательщик &2&3&4&5"
      551                            , v-pmnt-code
      552                            , p-payer-type
      553                            , p-payer-code
      554                            , chr(10)
      555                            , p-mess)
      556         .
      557       end.
      558       when no then do:
      559         message
      560         p-mess
      561         view-as alert-box error .
      562       end.
      563     end.
      564   END PROCEDURE.
