      571   FUNCTION getObjectType RETURNS CHARACTER IN SUPER.
      572     IF VALID-HANDLE(gshRepositoryManager) THEN
      573     DO:
      574       IF TRUE THEN
      575       DO:
      576         IF NOT
      577         DYNAMIC-FUNC('prepareInstance':U IN gshRepositoryManager,
      578                             STRING(THIS-PROCEDURE) + ',':U + STRING(FRAME gDialog:HANDLE),SOURCE-PROCEDURE)
      579         then
      580         DO:
      581           STOP.
      582         END.
      583         ASSIGN
      584           ghADMPropsBuf      = WIDGET-HANDLE(ENTRY(1, THIS-PROCEDURE:ADM-DATA, CHR(1))).
      585           glADMLoadFromRepos = VALID-HANDLE(ghADMPropsBUF).
      586       END.
      587     END.
      588    IF NOT VALID-HANDLE(WIDGET-HANDLE(ENTRY(1,THIS-PROCEDURE:ADM-DATA,CHR(1)))) THEN
      589    DO:
      590     CREATE TEMP-TABLE ghADMProps.
      591     ghADMProps:UNDO    = FALSE.
      592     ghADMProps:ADD-NEW-FIELD('ObjectName':U, 'CHAR':U, 0, ?, '':U).
