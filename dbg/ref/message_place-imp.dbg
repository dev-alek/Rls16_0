      734     ghADMProps:ADD-NEW-FIELD('InitialPageList':U, 'CHARACTER':U, 0, ?, '':U).
      735     ghADMProps:ADD-NEW-FIELD('WindowFrameHandle':U, 'HANDLE':U).
      736     ghADMProps:ADD-NEW-FIELD('Page0LayoutManager':U, 'CHARACTER':U).
