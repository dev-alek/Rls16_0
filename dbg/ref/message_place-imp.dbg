      629     ghADMProps:ADD-NEW-FIELD('PhysicalObjectName':U, 'CHARACTER':U, ?, ?, "":U).
      630     ghADMProps:ADD-NEW-FIELD('LogicalVersion':U, 'CHARACTER':U).
      631     ghADMProps:ADD-NEW-FIELD('PhysicalVersion':U, 'CHARACTER':U, ?, ?, "":U).
