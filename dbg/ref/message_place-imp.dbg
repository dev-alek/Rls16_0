      771   DEFINE VARIABLE ghContainer AS HANDLE NO-UNDO.
      772   ghContainer = FRAME gDialog:HANDLE.
      773       IF NOT glADMLoadFromRepos THEN
      774         RUN start-super-proc ("adm2/smart.p":U).
      775       DEFINE VARIABLE cObjectName AS CHARACTER  NO-UNDO.
      776       DEFINE VARIABLE iStart      AS INTEGER    NO-UNDO.
      777     IF NOT VALID-HANDLE(WIDGET-HANDLE(ENTRY(1,THIS-PROCEDURE:ADM-DATA,CHR(1)))) THEN
      778     DO:
      779       ghADMProps:TEMP-TABLE-PREPARE('ADMProps':U).
      780       ghADMPropsBuf = ghADMProps:DEFAULT-BUFFER-HANDLE.
      781       ghADMPropsBuf:BUFFER-CREATE().
      782       THIS-PROCEDURE:ADM-DATA = STRING(ghADMPropsBuf) + CHR(1) + CHR(1).
      783       cObjectName =  'LogicalObjectName,PhysicalObjectName,DynamicObject,RunAttribute,HideOnInit,DisableOnInit,ObjectLayout':U.
      784   ASSIGN
      785      ghProp = WIDGET-H(ENTRY(1,TARGET-PROCEDURE:ADM-DATA,CHR(1)))
      786      glADMOk = IF ghProp:NAME = 'ADMProps':U OR (ghProp:AVAIL AND ghProp:BUFFER-FIELD('Target':U):BUFFER-VALUE = TARGET-PROCEDURE) THEN TRUE
      787                ELSE ghProp:FIND-FIRST('WHERE Target = WIDGET-H("':U + STRING(TARGET-PROCEDURE) + '")':U)
      788     ghProp:BUFFER-FIELD('InstanceProperties':U):BUFFER-VALUE = cObjectName
      789    .
      790       ASSIGN cObjectName = REPLACE(THIS-PROCEDURE:FILE-NAME, "~\":U, "~/":U)
      791              iStart = R-INDEX(cObjectName, "~/":U) + 1
      792              cObjectName =
      793                   IF R-INDEX(THIS-PROCEDURE:FILE-NAME, ".":U) <= iStart THEN
      794                      SUBSTR(cObjectName, iStart)
      795                   ELSE
      796                      SUBSTR(cObjectName,
      797                             iStart,
      798                             R-INDEX(THIS-PROCEDURE:FILE-NAME, ".":U) - iStart).
      799   ASSIGN
      800      ghProp = WIDGET-H(ENTRY(1,TARGET-PROCEDURE:ADM-DATA,CHR(1)))
      801      glADMOk = IF ghProp:NAME = 'ADMProps':U OR (ghProp:AVAIL AND ghProp:BUFFER-FIELD('Target':U):BUFFER-VALUE = TARGET-PROCEDURE) THEN TRUE
      802                ELSE ghProp:FIND-FIRST('WHERE Target = WIDGET-H("':U + STRING(TARGET-PROCEDURE) + '")':U)
      803     ghProp:BUFFER-FIELD('ObjectName':U):BUFFER-VALUE = cObjectName
      804    .
      805   ASSIGN
      806      ghProp = WIDGET-H(ENTRY(1,TARGET-PROCEDURE:ADM-DATA,CHR(1)))
      807      glADMOk = IF ghProp:NAME = 'ADMProps':U OR (ghProp:AVAIL AND ghProp:BUFFER-FIELD('Target':U):BUFFER-VALUE = TARGET-PROCEDURE) THEN TRUE
      808                ELSE ghProp:FIND-FIRST('WHERE Target = WIDGET-H("':U + STRING(TARGET-PROCEDURE) + '")':U)
      809     ghProp:BUFFER-FIELD('ContainerHandle':U):BUFFER-VALUE = FRAME gDialog:HANDLE
      810    .
      811     END.
      812     ELSE DO:
      813   ASSIGN
      814      ghProp = WIDGET-H(ENTRY(1,TARGET-PROCEDURE:ADM-DATA,CHR(1)))
      815      glADMOk = IF ghProp:NAME = 'ADMProps':U OR (ghProp:AVAIL AND ghProp:BUFFER-FIELD('Target':U):BUFFER-VALUE = TARGET-PROCEDURE) THEN TRUE
      816                ELSE ghProp:FIND-FIRST('WHERE Target = WIDGET-H("':U + STRING(TARGET-PROCEDURE) + '")':U)
      817     ghProp:BUFFER-FIELD('ObjectType':U):BUFFER-VALUE = 'SmartDialog':U
      818     ghProp:BUFFER-FIELD('ContainerType':U):BUFFER-VALUE = 'DIALOG-BOX':U
      819     ghProp:BUFFER-FIELD('PhysicalVersion':U):BUFFER-VALUE = '':U
      820     ghProp:BUFFER-FIELD('PhysicalObjectName':U):BUFFER-VALUE = (IF '':U <> '':U THEN '':U ELSE THIS-PROCEDURE:FILE-NAME)
      821       .
      822     END.
      823   PROCEDURE adm-clone-props :
      824     DEFINE VARIABLE hReposBuffer AS HANDLE     NO-UNDO.
      825     DEFINE VARIABLE hPropTable   AS HANDLE     NO-UNDO.
      826     DEFINE VARIABLE hBuffer      AS HANDLE     NO-UNDO.
      827     DEFINE VARIABLE hTable       AS HANDLE     NO-UNDO.
      828     hReposBuffer = WIDGET-H(ENTRY(1,THIS-PROCEDURE:ADM-DATA,CHR(1))).
      829     IF VALID-HANDLE(hReposBuffer) AND hReposBuffer:NAME <> 'ADMProps':U THEN
      830     DO:
      831       hReposBuffer:FIND-FIRST('WHERE Target = WIDGET-H("':U + STRING(THIS-PROCEDURE) + '")':U)
      832       NO-ERROR.
      833       IF hReposBuffer:AVAIL THEN
      834       DO:
      835         CREATE TEMP-TABLE hPropTable.
      836         hPropTable:CREATE-LIKE(hReposBuffer).
      837         hPropTable:TEMP-TABLE-PREPARE('ADMProps':U).
      838         hBuffer = hPropTable:DEFAULT-BUFFER-HANDLE.
      839         hBuffer:BUFFER-CREATE().
      840         hBuffer:BUFFER-COPY(hReposBuffer).
      841         dynamic-function("deleteProperties":U IN TARGET-PROCEDURE)
      842    .
      843         THIS-PROCEDURE:ADM-DATA = STRING(hBuffer) + CHR(1) + CHR(1).
      844       END.
      845     END.
      846   END PROCEDURE.
      847   PROCEDURE start-super-proc :
      848     DEFINE INPUT PARAMETER pcProcName AS CHARACTER  NO-UNDO.
      849     DEFINE VARIABLE        hProc      AS HANDLE     NO-UNDO.
      850     hProc = SESSION:FIRST-PROCEDURE.
      851     DO WHILE VALID-HANDLE(hProc) AND hProc:FILE-NAME NE pcProcName:
      852       hProc = hProc:NEXT-SIBLING.
      853     END.
      854     IF NOT VALID-HANDLE(hProc) THEN
      855       RUN VALUE(pcProcName) PERSISTENT SET hProc.
      856     THIS-PROCEDURE:ADD-SUPER-PROCEDURE(hProc, SEARCH-TARGET).
      857     RETURN.
      858   END PROCEDURE.
      859     DEFINE VARIABLE cAppService          AS CHARACTER  NO-UNDO.
      860     DEFINE VARIABLE cASDivision          AS CHARACTER  NO-UNDO.
      861     DEFINE VARIABLE cServerOperatingMode AS CHARACTER  NO-UNDO.
      862     IF NOT glADMLoadFromRepos THEN
      863       RUN start-super-proc("adm2/appserver.p":U).
      864    cAppService = DYNAMIC-FUNC('getAppService':U IN TARGET-PROCEDURE)
      865    .
      866     IF SESSION:REMOTE THEN
      867     DO:
      868       ASSIGN cAppService          = '':U
      869              cASDivision          = 'Server':U
      870              cServerOperatingMode = CAPS(SESSION:SERVER-OPERATING-MODE).
      871     END.
      872     ELSE IF cAppService = '':U THEN
      873       ASSIGN cAppService  = '':U.
      874     IF cASDivision = '':U THEN
      875        cServerOperatingMode = 'NONE':U.
      876     ELSE
      877      DYNAMIC-FUNC('setASDivision':U IN TARGET-PROCEDURE,cASDivision)
      878    .
      879   ASSIGN
      880      ghProp = WIDGET-H(ENTRY(1,TARGET-PROCEDURE:ADM-DATA,CHR(1)))
      881      glADMOk = IF ghProp:NAME = 'ADMProps':U OR (ghProp:AVAIL AND ghProp:BUFFER-FIELD('Target':U):BUFFER-VALUE = TARGET-PROCEDURE) THEN TRUE
      882                ELSE ghProp:FIND-FIRST('WHERE Target = WIDGET-H("':U + STRING(TARGET-PROCEDURE) + '")':U)
      883     ghProp:BUFFER-FIELD('ServerOperatingMode':U):BUFFER-VALUE = cServerOperatingMode
      884    .
      885      DYNAMIC-FUNC('setAppService':U IN TARGET-PROCEDURE,cAppService)
      886    .
      887   DEFINE VARIABLE cFields AS CHARACTER NO-UNDO.
      888   IF NOT glADMLoadFromRepos THEN
      889     RUN start-super-proc ("adm2/visual.p":U).
      890     cFields =  REPLACE("Btn_OK":U, " ":U, ",":U).
      891   ASSIGN
      892      ghProp = WIDGET-H(ENTRY(1,TARGET-PROCEDURE:ADM-DATA,CHR(1)))
      893      glADMOk = IF ghProp:NAME = 'ADMProps':U OR (ghProp:AVAIL AND ghProp:BUFFER-FIELD('Target':U):BUFFER-VALUE = TARGET-PROCEDURE) THEN TRUE
      894                ELSE ghProp:FIND-FIRST('WHERE Target = WIDGET-H("':U + STRING(TARGET-PROCEDURE) + '")':U)
      895     ghProp:BUFFER-FIELD('EnabledObjFlds':U):BUFFER-VALUE = cFields
      896    .
      897     IF VALID-HANDLE(gshSessionManager) THEN
      898     DO:
      899       ON HELP OF FRAME gDialog ANYWHERE
      900         RUN contextHelp IN gshSessionManager (INPUT THIS-PROCEDURE, INPUT FOCUS).
      901     END.
      902     ON CTRL-PAGE-UP OF FRAME gDialog ANYWHERE DO:
      903       RUN processAction IN TARGET-PROCEDURE (INPUT "CTRL-PAGE-UP":U).
      904     END.
      905     ON CTRL-PAGE-DOWN OF FRAME gDialog ANYWHERE DO:
      906       RUN processAction IN TARGET-PROCEDURE (INPUT "CTRL-PAGE-DOWN":U).
      907     END.
      908   IF NOT glADMLoadFromRepos THEN
      909   DO:
      910     RUN start-super-proc("adm2/containr.p":U).
      911     RUN modifyListProperty IN TARGET-PROCEDURE
      912                            (TARGET-PROCEDURE,
      913                             'Add':U,
      914                             'ContainerSourceEvents':U,
      915                             'initializeDataObjects':U).
      916     IF  CAN-DO(dynamic-function("getSupportedLinks":U IN TARGET-PROCEDURE)
      917    ,'data-target':U)
      918     AND CAN-DO(dynamic-function("getSupportedLinks":U IN TARGET-PROCEDURE)
      919    ,'data-source':U) THEN
      920       RUN modifyListProperty IN TARGET-PROCEDURE
      921                              (TARGET-PROCEDURE,
      922                               'Add':U,
      923                               'ContainerSourceEvents':U,
      924                               'buildDataRequest':U).
      925     IF NOT CAN-DO(dynamic-function("getSupportedLinks":U IN TARGET-PROCEDURE)
      926    ,'containertoolbar-target':U) THEN
      927       RUN modifyListProperty IN TARGET-PROCEDURE
      928                             (TARGET-PROCEDURE,
      929                              'Add':U,
      930                              'SupportedLinks':U,
      931                              'ContainerToolbar-Target':U).
      932   END.
      933   PAUSE 0 BEFORE-HIDE.
      934   ASSIGN
      935      ghProp = WIDGET-H(ENTRY(1,TARGET-PROCEDURE:ADM-DATA,CHR(1)))
      936      glADMOk = IF ghProp:NAME = 'ADMProps':U OR (ghProp:AVAIL AND ghProp:BUFFER-FIELD('Target':U):BUFFER-VALUE = TARGET-PROCEDURE) THEN TRUE
      937                ELSE ghProp:FIND-FIRST('WHERE Target = WIDGET-H("':U + STRING(TARGET-PROCEDURE) + '")':U)
      938     ghProp:BUFFER-FIELD('WindowFrameHandle':U):BUFFER-VALUE = FRAME gDialog:handle
      939    .
      940   ASSIGN
      941      ghProp = WIDGET-H(ENTRY(1,TARGET-PROCEDURE:ADM-DATA,CHR(1)))
      942      glADMOk = IF ghProp:NAME = 'ADMProps':U OR (ghProp:AVAIL AND ghProp:BUFFER-FIELD('Target':U):BUFFER-VALUE = TARGET-PROCEDURE) THEN TRUE
      943                ELSE ghProp:FIND-FIRST('WHERE Target = WIDGET-H("':U + STRING(TARGET-PROCEDURE) + '")':U)
      944     ghProp:BUFFER-FIELD('DataContainer':U):BUFFER-VALUE = TRUE
      945    .
      946   ASSIGN
      947          FRAME gDialog:SCROLLABLE       = FALSE
      948          FRAME gDialog:HIDDEN           = TRUE.
      949   ASSIGN
      950          mes:AUTO-RESIZE IN FRAME gDialog      = TRUE.
      951   ON WINDOW-CLOSE OF FRAME gDialog
      952   DO:
      953       APPLY "END-ERROR":U TO SELF.
      954     END.
      955   DEFINE VARIABLE iStartPage AS INTEGER NO-UNDO.
      956   IF THIS-PROCEDURE:PERSISTENT THEN
      957   DO:
      958     MESSAGE "A SmartDialog is not intended to be run " + CHR(10) +
      959       "Persistent or to be placed in another ":U + CHR(10) +
      960       "SmartObject at AppBuilder design time."
      961       VIEW-AS ALERT-BOX ERROR.
      962     RUN disable_UI.
      963     DELETE PROCEDURE THIS-PROCEDURE.
      964     RETURN.
      965   END.
      966   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME gDialog:PARENT eq ?
      967     THEN FRAME gDialog:PARENT = ACTIVE-WINDOW.
      968   RUN createObjects.
      969   MAIN-BLOCK:
      970   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      971     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      972     RUN initializeObject.
      973     WAIT-FOR GO OF FRAME gDialog focus Btn_OK.
      974   END.
      975   RUN destroyObject.
      976   PROCEDURE adm-create-objects :
      977   END PROCEDURE.
      978   PROCEDURE disable_UI :
      979     HIDE FRAME gDialog.
      980   END PROCEDURE.
      981   PROCEDURE enable_UI :
      982           mes = p-mess .
      983     DISPLAY mes
      984       WITH FRAME gDialog.
      985     ENABLE Btn_OK
      986         WITH FRAME gDialog.
      987     VIEW FRAME gDialog.
      988   END PROCEDURE.
