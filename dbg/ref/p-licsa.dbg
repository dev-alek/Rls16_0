        1   block-level on error undo, throw.
        2   define input parameter parparentproc    as widget-handle no-undo.
        3   define input parameter p-cli-type       like ub.alc-supp-lic.cli-type no-undo.
        4   define input parameter p-cli-code       like ub.alc-supp-lic.cli-code no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision: a8e2cf75ddf6, 2506, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
        7   define variable vss-date        as character no-undo init "$Date: Ср июл 08 17:09:06 2020 +0300 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: p-licsa.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: ref/p-licsa.p $":U .
       10   define variable vss-description as character no-undo init "Печать Лицензии на продажу алкогольной продукции".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       66   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       67   define new shared variable RepPathName        as character no-undo .
       68   define new shared variable PrintRubl          as logical   no-undo .
       69   define variable v-full-path-RepView as character no-undo.
       70   define variable v-file-name-rep-htm as character no-undo.
       71   define variable g#report-num as integer no-undo.
       72   define buffer buf_alc-sale-lic for alc-sale-lic.
       73   define buffer host_clients for clients.
       74   define stream OutStr-html.
       75   function fnc-DD-MM-YYYY returns character
       76   (input p-dat-date as date) forward.
       77   function fnc-convert-dot-to-colon returns character
       78   (input p-data as decimal, p-accur as character) forward.
       79       run get-full-path-RepViewer(output v-full-path-RepView).
       80       run get-report-num in parParentProc(output g#report-num).
       81       run define-full-path-Report(input g#report-num, output v-file-name-rep-htm).
       82       run create-file(v-file-name-rep-htm).
       83       run proc-create-HTML(input v-file-name-rep-htm, input p-cli-type, input p-cli-code).
       84       run Report-Viewer(input v-full-path-RepView, input v-file-name-rep-htm).
       85   procedure get-full-path-RepViewer:
       86       define output parameter p-fill-path-RepView as character no-undo.
       87       if search("exe\ReportViewer\reportviewer.exe") <> ? then
       88       do:
       89           p-fill-path-RepView = search("exe\ReportViewer\reportviewer.exe").
       90       end.
       91       else
       92       do:
       93           message "Не найдена программа просмотра отчёта!" view-as alert-box error.
       94       end.
       95   end procedure.
       96   procedure define-full-path-Report:
       97       define input parameter p-rep-num as integer no-undo.
       98       define output parameter p-file-name-rep-htm as character no-undo.
       99       p-file-name-rep-htm = session:temp-directory + "rpt" + string(p-rep-num) + ".html".
      100   end procedure.
      101   procedure search-full-path-Report:
      102       define input parameter p-file-name as character no-undo.
      103       if search(p-file-name) = ? then
      104           do:
      105               message "Не найден файл отчёта: " p-file-name view-as alert-box error.
      106           end.
      107       else
      108           do:
      109               p-file-name = search(p-file-name).
      110           end.
      111   end procedure.
      112   procedure Report-Viewer:
      113       define input parameter p-full-path-RepView as character no-undo.
      114       define input parameter p-file-name-rep-htm as character no-undo.
      115   os-command no-wait value(p-full-path-RepView + " true " + search(p-file-name-rep-htm)).
      116   end procedure.
      117   procedure create-file:
      118       define input parameter p-file-name as character no-undo.
      119       output to value(string(p-file-name)).
      120       output close.
      121   end procedure.
      122   procedure proc-create-HTML:
      123       define input parameter p-file-name-rep-htm as character no-undo.
      124       define input parameter p-cli-type like ub.alc-supp-lic.cli-type no-undo.
      125       define input parameter p-cli-code like ub.alc-supp-lic.cli-code no-undo.
      126       define variable v-ii as integer no-undo.
      127       do:
      128           output stream OutStr-html to value(p-file-name-rep-htm) append convert target 'UTF-8'.
      129               put stream OutStr-html unformatted
      130                   "<!DOCTYPE HTML>" skip
      131                   ' <html>' skip
      132                   '  <head>' skip
      133                   '   <meta charset="utf-8">' skip
      134                   '    <style type="text/css">' skip
      135                   '      table ' + chr(123) + ' border-collapse: collapse; font-size: 9pt; table-layout: fixed; width: 1157px; padding: 14px; ' + chr(125) skip
      136                   '      td ' + chr(123) ' border: 1px black ridge; word-wrap:break-word; ' + chr(125) skip
      137                   '      htm' skip
      138                   '      .rotate ' + chr(123) skip
      139                   '        -webkit-transform: rotate(-90deg);' skip
      140                   '        -moz-transform: rotate(-90deg);' skip
      141                   '        -ms-transform: rotate(-90deg);' skip
      142                   '        -o-transform: rotate(-90deg);' skip
      143                   '        transform: rotate(-90deg);' skip
      144                   '        -webkit-transform-origin: 50% 50%;' skip
      145                   '        -moz-transform-origin: 50% 50%;' skip
      146                   '        -ms-transform-origin: 50% 50%;' skip
      147                   '        -o-transform-origin: 50% 50%;' skip
      148                   '        transform-origin: 50% 50%;' skip
      149                   '        filter: progid:DXImageTransform.Microsoft.BasicImage(rotation=3);' skip
      150                   '          ' + chr(125) skip
      151                   '            th' + ' ' + chr(123) skip
      152                   '            border: 1px black solid;' skip
      153                   '            word-wrap: break-word;' skip
      154                   '          ' + chr(125) skip
      155                   '   </style>' skip
      156                   '  </head>' skip
      157               .
      158       end.
      159       do:
      160               put stream OutStr-html unformatted
      161                   ' <body>' skip
      162                   '   <table name="Лист1" outline_below="false">' skip
      163                   '     <thead>' skip
      164                   '       <tr class="set_columns">' skip
      165                   '         <td style="width: 43px; border: none;"></td>' skip
      166                   '         <td style="width: 70px; border: none;"></td>' skip
      167                   '         <td style="width: 70px; border: none;"></td>' skip
      168                   '         <td style="width: 70px; border: none;"></td>' skip
      169                   '         <td style="width: 70px; border: none;"></td>' skip
      170                   '         <td style="width: 70px; border: none;"></td>' skip
      171                   '         <td style="width: 100px; border: none;"></td>' skip
      172                   '         <td style="width: 43px; border: none;"></td>' skip
      173                   '       </tr>' skip
      174               .
      175       end.
      176       do:
      177               put stream OutStr-html unformatted
      178                   '       <tr>' skip
      179                   '         <td style="border: none; height: 14px"></td>' skip
      180                   '         <td style="border: none"></td>' skip
      181                   '         <td style="border: none"></td>' skip
      182                   '         <td style="border: none"></td>' skip
      183                   '         <td style="border: none"></td>' skip
      184                   '         <td style="border: none"></td>' skip
      185                   '         <td style="border: none"></td>' skip
      186                   '         <td style="border: none"></td>' skip
      187                   '       </tr>' skip
      188                   '       <tr>' skip
      189                   '         <td colspan="8" style="border: none; height: 14px; font-weight: bold; text-align: center">' + "Справочник Лицензий на продажу алкогольной продукции" + '</td>' skip
      190                   '         <td style="border: none"></td>' skip
      191                   '         <td style="border: none"></td>' skip
      192                   '         <td style="border: none"></td>' skip
      193                   '         <td style="border: none"></td>' skip
      194                   '         <td style="border: none"></td>' skip
      195                   '         <td style="border: none"></td>' skip
      196                   '         <td style="border: none"></td>' skip
      197                   '       </tr>' skip
      198                   '       <tr>' skip
      199                   '         <td style="border: none; height: 14px; font-weight: bold"></td>' skip
      200                   '         <td style="border: none"></td>' skip
      201                   '         <td style="border: none"></td>' skip
      202                   '         <td style="border: none"></td>' skip
      203                   '         <td style="border: none"></td>' skip
      204                   '         <td style="border: none"></td>' skip
      205                   '         <td style="border: none"></td>' skip
      206                   '         <td style="border: none"></td>' skip
      207                   '       </tr>' skip
      208               .
      209       end.
      210       do:
      211           put stream OutStr-html unformatted
      212                   '     <tbody>' skip
      213                   '       <tr>' skip
      214                   '         <th style="text-align: center; height: 30px">№ п/п</th>' skip
      215                   '         <th style="text-align: center;">с</th>' skip
      216                   '         <th style="text-align: center;">по</th>' skip
      217                   '         <th style="text-align: center;">Номер</th>' skip
      218                   '         <th style="text-align: center;">Серия</th>' skip
      219                   '         <th style="text-align: center;">Дата выдачи</th>' skip
      220                   '         <th style="text-align: center;">Кем выдана</th>' skip
      221                   '         <th style="text-align: center;">На все типы</th>' skip
      222                   '       </tr>' skip
      223                   '       <tr>' skip
      224                   '         <th num="" style="text-align: center">1</th>' skip
      225                   '         <th num="" style="text-align: center">2</th>' skip
      226                   '         <th num="" style="text-align: center">3</th>' skip
      227                   '         <th num="" style="text-align: center">4</th>' skip
      228                   '         <th num="" style="text-align: center">5</th>' skip
      229                   '         <th num="" style="text-align: center">6</th>' skip
      230                   '         <th num="" style="text-align: center">7</th>' skip
      231                   '         <th num="" style="text-align: center">8</th>' skip
      232                   '       </tr>' skip
      233           .
      234           output stream OutStr-html close.
      235       end.
      236       do:
      237           output stream OutStr-html to value(p-file-name-rep-htm) append convert target 'UTF-8'.
      238           if p-cli-type = ? or p-cli-code = ? then
      239           do:
      240               for each buf_alc-sale-lic no-lock
      241               :
      242                   v-ii = v-ii + 1.
      243                   put stream OutStr-html unformatted
      244                       '       <tr>' skip
      245                       '         <td num="0" style="display: yes; text-align: center; height: 20px; font-weight: normal">' + (if v-ii = ? then "" else string(v-ii)) + '</td>' skip
      246                       '         <td style="display: yes; text-align: center; font-weight: normal">' + (if buf_alc-sale-lic.date-from <> ? then fnc-DD-MM-YYYY(buf_alc-sale-lic.date-from) else "?") + '</td>' skip
      247                       '         <td style="display: yes; text-align: center; font-weight: normal">' + (if buf_alc-sale-lic.date-to <> ? then fnc-DD-MM-YYYY(buf_alc-sale-lic.date-to) else "?") + '</td>' skip
      248                       '         <td style="display: yes; text-align: left; font-weight: normal">' + (if buf_alc-sale-lic.number <> ? then buf_alc-sale-lic.number else "?") + '</td>' skip
      249                       '         <td style="display: yes; text-align: left; font-weight: normal">' + (if buf_alc-sale-lic.seria <> ? then buf_alc-sale-lic.seria else "?") + '</td>' skip
      250                       '         <td style="display: yes; text-align: center; font-weight: normal">' + (if buf_alc-sale-lic.date-get <> ? then fnc-DD-MM-YYYY(buf_alc-sale-lic.date-get) else "?") + '</td>' skip
      251                       '         <td style="display: yes; text-align: left; font-weight: normal">' + (if buf_alc-sale-lic.who-are-got <> ? then buf_alc-sale-lic.who-are-got else "?") + '</td>' skip
      252                       '         <td style="display: yes; text-align: center; font-weight: normal">' +
      253                                   (if buf_alc-sale-lic.all-type <> ? then (if buf_alc-sale-lic.all-type > 0 then "+" else "-") else "?") + '</td>' skip
      254                       '       </tr>' skip
      255                   .
      256               end.
      257           end.
      258           else
      259           do:
      260               for each buf_alc-sale-lic where
      261                        buf_alc-sale-lic.cli-type = p-cli-type and
      262                        buf_alc-sale-lic.cli-code = p-cli-code no-lock
      263               :
      264                   v-ii = v-ii + 1.
      265                   put stream OutStr-html unformatted
      266                       '       <tr>' skip
      267                       '         <td num="0" style="display: yes; text-align: center; height: 20px; font-weight: normal">' + (if v-ii = ? then "" else string(v-ii)) + '</td>' skip
      268                       '         <td style="display: yes; text-align: center; font-weight: normal">' + (if buf_alc-sale-lic.date-from <> ? then fnc-DD-MM-YYYY(buf_alc-sale-lic.date-from) else "?") + '</td>' skip
      269                       '         <td style="display: yes; text-align: center; font-weight: normal">' + (if buf_alc-sale-lic.date-to <> ? then fnc-DD-MM-YYYY(buf_alc-sale-lic.date-to) else "?") + '</td>' skip
      270                       '         <td style="display: yes; text-align: left; font-weight: normal">' + (if buf_alc-sale-lic.number <> ? then buf_alc-sale-lic.number else "?") + '</td>' skip
      271                       '         <td style="display: yes; text-align: left; font-weight: normal">' + (if buf_alc-sale-lic.seria <> ? then buf_alc-sale-lic.seria else "?") + '</td>' skip
      272                       '         <td style="display: yes; text-align: center; font-weight: normal">' + (if buf_alc-sale-lic.date-get <> ? then fnc-DD-MM-YYYY(buf_alc-sale-lic.date-get) else "?") + '</td>' skip
      273                       '         <td style="display: yes; text-align: left; font-weight: normal">' + (if buf_alc-sale-lic.who-are-got <> ? then buf_alc-sale-lic.who-are-got else "?") + '</td>' skip
      274                       '         <td style="display: yes; text-align: center; font-weight: normal">' +
      275                                   (if buf_alc-sale-lic.all-type <> ? then (if buf_alc-sale-lic.all-type > 0 then "+" else "-") else "?") + '</td>' skip
      276                       '       </tr>' skip
      277                   .
      278               end.
      279           end.
      280       end.
      281       do:
      282                   put stream OutStr-html unformatted
      283                   '     </tbody>' skip
      284                   '   </table>' skip
      285                   '  </body>' skip
      286                   ' </html>' skip
      287                   .
      288           output stream OutStr-html close.
      289       end.
      290   end procedure.
      291   function fnc-convert-dot-to-colon returns character
      292   (input p-data as decimal, input p-accur as character):
      293       define variable result as character no-undo.
      294       define variable v-str-result as character no-undo.
      295       p-data = round(p-data, 2).
      296       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
      297       return v-str-result.
      298   end function.
      299   function fnc-DD-MM-YYYY returns character
      300   (input p-dat-date as date):
      301       define variable result as character no-undo.
      302       define variable p-str-date as character no-undo.
      303       p-str-date = replace(string(p-dat-date,'99.99.9999'), "/", ".").
      304           return p-str-date.
      305   end function.
