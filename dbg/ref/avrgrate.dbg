        1   define input        parameter ratetype as character no-undo .
        2   define input-output parameter io-rate  as decimal   no-undo .
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Курс пересчета средней учетной цены".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define new global shared variable g#language as character no-undo .
       64   if g#language <> '' and g#language <> 'rus':U then do:
       65     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       66   end.
       67   procedure proc-alt-shift-f2:
       68     if not ibs.th.gbl.gbl-var:rcode
       69   then
       70     run gbl\inidebug.p .
       71   end.
       72   procedure proc-alt-shift-f3:
       73     run gbl/prvssinf.p
       74       ( input this-procedure
       75       ) .
       76   end.
       77   define variable v-inform-launched as logical no-undo initial false .
       78   procedure proc-alt-shift-f4:
       79     define variable v-action as character no-undo .
       80     if v-inform-launched = false then do:
       81       assign
       82         v-inform-launched = true
       83       .
       84       run gbl/d-inform.w
       85         (  input self
       86         ,  input this-procedure
       87         , output v-action
       88         ) no-error .
       89       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       90       assign
       91         v-inform-launched = false
       92       .
       93     end.
       94   end.
       95   procedure proc-alt-f1:
       96     run gbl/corrhelp.p
       97       (input this-procedure
       98       ) .
       99   end .
      100   on alt-shift-f2 anywhere do:
      101     run proc-alt-shift-f2.
      102   end.
      103   on alt-shift-f3 anywhere do:
      104     run proc-alt-shift-f3 in this-procedure .
      105   end.
      106   on alt-shift-f4 anywhere do:
      107     run proc-alt-shift-f4 in this-procedure.
      108   end.
      109   on alt-f1 anywhere do:
      110     run proc-alt-f1 in this-procedure .
      111   end.
      112   DEFINE BUTTON b-help
      113        LABEL "Помо&щь"
      114        SIZE 10 BY 1.
      115   DEFINE BUTTON Btn_OK AUTO-GO DEFAULT
      116        LABEL "Ввод"
      117        SIZE 10 BY 1
      118        BGCOLOR 8 .
      119   DEFINE VARIABLE rate AS DECIMAL FORMAT ">>,>>9.99":U INITIAL ?
      120        LABEL "Курс"
      121        VIEW-AS FILL-IN
      122        SIZE 10 BY 1 NO-UNDO.
      123   DEFINE FRAME bc-rate
      124        Btn_OK AT ROW 1 COL 1
      125        b-help AT ROW 1 COL 11
      126        rate AT ROW 2.5 COL 13.5 COLON-ALIGNED
      127        SPACE(22.11) SKIP(0.56)
      128       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      129            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      130            TITLE "Курс пересчета средней учётной цены"
      131            DEFAULT-BUTTON Btn_OK.
      132   ASSIGN
      133          FRAME bc-rate:SCROLLABLE       = FALSE.
      134   ON CHOOSE OF Btn_OK IN FRAME bc-rate
      135   DO:
      136       assign
      137           rate .
      138       assign
      139           io-rate = rate .
      140   END.
      141   ON LEAVE OF rate IN FRAME bc-rate
      142   DO:
      143       APPLY "CHOOSE" TO Btn_OK IN FRAME bc-rate .
      144   END.
      145   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME bc-rate:PARENT eq ?
      146   THEN FRAME bc-rate:PARENT = ACTIVE-WINDOW.
      147   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      148   on help of frame bc-rate
      149   do:
      150     run gbl/app_help.p
      151       (input this-procedure :file-name
      152       ,input ''
      153       ,input ?
      154       ) no-error.
      155     if error-status :error then do:
      156       message
      157         "Ошибка при вызове помощи"
      158         error-status :get-message(1)
      159         view-as alert-box .
      160     end.
      161   end.
      162   run minbtn-set in this-procedure .
      163   on choose of b-help in frame bc-rate
      164   do:
      165     apply "help":u to frame bc-rate .
      166   end.
      167   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      168   procedure minbtn-set :
      169       do
      170           on error undo, return error return-value
      171           :
      172           define variable ii              as integer       no-undo .
      173           define variable fh              as widget-handle no-undo .
      174           define variable hh              as widget-handle no-undo .
      175           define variable v-h             as handle        extent 4 no-undo .
      176           define variable v-name-button   as character     no-undo .
      177           define variable v-help-old-x    as decimal       no-undo .
      178           define variable v-help-old-y    as decimal       no-undo .
      179           define variable v-help-old-size as decimal       no-undo .
      180           define variable v-frame-width   as decimal       no-undo .
      181           define variable jj              as integer       no-undo .
      182           do
      183               on error undo, return error
      184               :
      185               assign
      186                   v-frame-width = frame bc-rate:width - 0.3
      187                   fh            = frame bc-rate:first-child
      188                   hh            = fh:first-child
      189                   ii            = 1
      190                   .
      191               do while valid-handle(hh):
      192                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      193                   do:
      194                       case lc(hh:name) :
      195                           when "b-help" then
      196                               do:
      197                                   hh:load-image-up("cmp/b-help.bmp":u) .
      198                                   hh:load-image-down("cmp/b-help.bmp":u) .
      199                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      200                                   hh:TOOLTIP = "Помощь" .
      201                                   v-help-old-x = hh:column .
      202                                   v-help-old-y = hh:row    .
      203                                   v-help-old-size = hh:width .
      204                                   hh:width-chars = 2.5 .
      205                               end.
      206                           when "b-print" then
      207                               do:
      208                                   hh:load-image("cmp/b-print.bmp":u) .
      209                                   hh:TOOLTIP = "Печать" .
      210                                   v-h[ii] = hh:handle .
      211                                   ii = ii + 1 .
      212                                   hh:width-chars = 3 .
      213                               end.
      214                           when "b-history" or
      215                           when "b-hist" then
      216                               do:
      217                                   hh:load-image("cmp/b-hist.bmp":u) .
      218                                   hh:TOOLTIP = "История" .
      219                                   v-h[ii] = hh:handle .
      220                                   ii = ii + 1 .
      221                                   hh:width-chars = 3 .
      222                               end.
      223                           when "b-sch" then
      224                               do:
      225                                   hh:load-image("cmp/b-sch.bmp":u) .
      226                                   hh:TOOLTIP = "Установка Фильтра" .
      227                                   v-h[ii] = hh:handle .
      228                                   ii = ii + 1 .
      229                                   hh:width-chars = 3 .
      230                               end.
      231                           when "b-hist-user" then
      232                               do:
      233                                   hh:load-image("cmp/b-hist.bmp":u) .
      234                                   hh:TOOLTIP = "История пользователя" .
      235                                   ii = ii + 1 .
      236                               end.
      237                       end case.
      238                   end.
      239                   hh = hh:next-sibling.
      240               end.
      241               b-help:column = v-frame-width - b-help:width-chars.
      242               jj = 0.
      243               repeat ii = 4 to 1 by -1 :
      244                   if valid-handle (v-h[ii] ) then
      245                   do:
      246                       jj  = jj + 1 .
      247                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      248                       v-h[ii]:row    = v-help-old-y .
      249                   end.
      250               end.
      251           end.
      252       end.
      253   end procedure.
      254   ON WINDOW-CLOSE OF FRAME bc-rate APPLY "END-ERROR":U TO SELF.
      255   MAIN-BLOCK:
      256   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      257      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      258       assign
      259           FRAME bc-rate:title = FRAME bc-rate:title +
      260               ( if ratetype = "rubl" then " (в рублях)" else " (в Б.Вал.)" )
      261           rate = io-rate .
      262       RUN enable_UI.
      263       WAIT-FOR GO OF FRAME bc-rate.
      264   END.
      265   RUN disable_UI.
      266   PROCEDURE disable_UI :
      267     HIDE FRAME bc-rate.
      268   END PROCEDURE.
      269   PROCEDURE enable_UI :
      270     DISPLAY rate
      271         WITH FRAME bc-rate.
      272     ENABLE Btn_OK b-help rate
      273         WITH FRAME bc-rate.
      274   END PROCEDURE.
