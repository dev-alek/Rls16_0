        1   block-level on error undo, throw.
        2   define input-output parameter p-doc-rec as recid no-undo.
        3   define input parameter p-mode            as character no-undo .
        4   define input parameter p-silent as logical no-undo .
        5   define input parameter p-point-code as integer no-undo .
        6   define input parameter p-db-num as integer no-undo .
        7   define input parameter p-cli-type as character no-undo .
        8   define input parameter p-cli-code as integer no-undo .
        9   define input parameter p-point-name as character no-undo .
       10   define input parameter p-point-type as character no-undo .
       11   define input parameter p-deliv-subj-code as integer no-undo .
       12   define input parameter p-is-default as logical no-undo .
       13   define input parameter p-address as character no-undo .
       14   define input parameter p-ps as character no-undo .
       15   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       16   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       17   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       18   define variable vss-workfile    as character no-undo init "$Workfile: pt-io-f1.p $":U .
       19   define variable vss-archive     as character no-undo init "$Archive: ref/pt-io-f1.p $":U .
       20   define variable vss-description as character no-undo init "Сохранение Пункта доставки/отгрузки".
       21   procedure vss-get-info :
       22     define output parameter p-vss-revision    like vss-revision    no-undo .
       23     define output parameter p-vss-author      like vss-author      no-undo .
       24     define output parameter p-vss-date        like vss-date        no-undo .
       25     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       26     define output parameter p-vss-archive     like vss-archive     no-undo .
       27     define output parameter p-vss-description like vss-description no-undo .
       28     assign
       29       p-vss-revision    = vss-revision
       30       p-vss-author      = vss-author
       31       p-vss-date        = vss-date
       32       p-vss-workfile    = vss-workfile
       33       p-vss-archive     = vss-archive
       34       p-vss-description = vss-description
       35     .
       36   end procedure.
       37   procedure vss-get-parameters :
       38     define output parameter p-vss-parameters as character no-undo .
       39   end procedure.
       40   define new global shared variable g#vssrevis-logger as handle    no-undo .
       41   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       42   define variable v-vssrevis-logger                   as handle    no-undo .
       43   procedure vss-logevent :
       44     define input  parameter p-extra-paramters as character no-undo .
       45     define variable v-vssrevis-parameters as character no-undo .
       46     do
       47     on error undo, return error return-value
       48     :
       49       if  valid-handle(v-vssrevis-logger)
       50       and v-vssrevis-logger :get-signature("logevent") <> ""
       51       then do:
       52         run vss-get-parameters in this-procedure
       53           (output v-vssrevis-parameters
       54           ).
       55         run logevent in v-vssrevis-logger
       56           (input vss-workfile
       57           ,input vss-revision
       58           ,input v-vssrevis-parameters
       59           ,input p-extra-paramters
       60           ).
       61       end.
       62     end.
       63   end procedure.
       64   assign
       65     v-vssrevis-logger = g#vssrevis-logger
       66   .
       67   if  valid-handle(v-vssrevis-logger)
       68   and v-vssrevis-logger :get-signature("logevent") <> ""
       69   then do:
       70     assign
       71       v-vssrevis-logevent = true
       72     .
       73     run vss-logevent in this-procedure (input vss-description) .
       74   end.
       75   define new global shared variable g#language as character no-undo .
       76   if g#language <> '' and g#language <> 'rus':U then do:
       77     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       78   end.
       79   define variable v-err-mess as character no-undo .
       80   define variable glog as logical no-undo .
       81   define buffer buf_point-io for ub.point-io.
       82   define buffer b_point-io for ub.point-io.
       83   define buffer buf_clients for ub.clients.
       84   define buffer buf_delivery-subject for ub.delivery-subject.
       85   define buffer buf_db for ub.db.
       86   if p-mode <> 'ДОБАВЛЕНИЕ':U
       87   and p-mode <> 'ИЗМЕНЕНИЕ':U then do:
       88     message
       89     vss-workfile vss-revision vss-description skip
       90     "Неверный параметр p-mode" p-mode
       91     view-as alert-box error .
       92     undo, return error '':u.
       93   end.
       94   if p-point-name = "" or p-point-name = ? then do:
       95     v-err-mess = "Название пункта должно быть заполнено." .
       96     run err-mess in this-procedure ( input-output v-err-mess).
       97     undo, return error (if p-silent then v-err-mess else "point-name":U).
       98   end.
       99   if p-cli-type = ""
      100   or p-cli-type = ?
      101   then do:
      102     v-err-mess = "Нет контрагента!".
      103     run err-mess in this-procedure ( input-output v-err-mess).
      104     undo, return error (if p-silent then v-err-mess else "cli-type":U).
      105   end.
      106   if p-cli-code = 0
      107   or p-cli-code = ?
      108   then do:
      109     v-err-mess = "Нет контрагента!" .
      110     run err-mess in this-procedure ( input-output v-err-mess).
      111     undo, return error (if p-silent then v-err-mess else "cli-code":U).
      112   end.
      113   find first buf_clients no-lock where
      114             buf_clients.obj-type = p-cli-type
      115          and buf_clients.obj-code = p-cli-code no-error.
      116   if not available buf_clients then do:
      117     v-err-mess = substitute("Неверный контрагент &1&2", p-cli-type, p-cli-code).
      118     run err-mess in this-procedure ( input-output v-err-mess).
      119     undo, return error (if p-silent then v-err-mess else "cli-code":U).
      120   end.
      121   if p-point-type <> 'доставки':U
      122   and p-point-type <> 'отгрузки':U then do:
      123     v-err-mess = substitute("Неверный тип пункта: &1", p-point-type).
      124     run err-mess in this-procedure ( input-output v-err-mess).
      125     undo, return error (if p-silent then v-err-mess else "point-type":U).
      126   end.
      127   if p-deliv-subj-code <> 0 then do:
      128     find first buf_delivery-subject no-lock where
      129               buf_delivery-subject.deliv-subj-code = p-deliv-subj-code no-error.
      130     if not available buf_delivery-subject then do:
      131       v-err-mess = substitute("Неверный тип субъекта доставки: &1", p-deliv-subj-code).
      132       run err-mess in this-procedure ( input-output v-err-mess).
      133       undo, return error (if p-silent then v-err-mess else "deliv-subj-code":U).
      134     end.
      135   end.
      136   if p-is-default then do:
      137     find first b_point-io
      138       where b_point-io.cli-code   = p-cli-code
      139         and b_point-io.cli-type   = p-cli-type
      140         and b_point-io.point-type = p-point-type
      141         and b_point-io.is-default = yes
      142     no-error .
      143     if available b_point-io
      144     and (p-mode = 'ДОБАВЛЕНИЕ':U
      145     or recid(b_point-io) <> p-doc-rec)
      146     then do:
      147       if not p-silent then do:
      148         glog = no.
      149         message
      150         substitute("У контрагента &1&2 уже есть пункт по умолчанию для типа <&3>&4" +
      151                    "Продолжить? (При выборе ДА признак будет перенесен на изменяемый пункт)"
      152                     , p-cli-type
      153                     , p-cli-code
      154                     , p-point-type
      155                     , chr(10)
      156                     )
      157         view-as alert-box QUESTION BUTTONS YES-NO UPDATE glog .
      158         if glog <> yes then return "quit".
      159       end.
      160     end.
      161   end.
      162   main-block:
      163   do
      164   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      165   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      166   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      167   :
      168     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      169       create buf_point-io .
      170       assign
      171       buf_point-io.db-num     = p-db-num
      172       buf_point-io.cli-type   = p-cli-type
      173       buf_point-io.cli-code   = p-cli-code
      174       buf_point-io.point-code = next-value( s-point-io, ub )
      175       buf_point-io.status_    = 'тек':U
      176       .
      177     end.
      178     else do:
      179       FIND FIRST buf_point-io where
      180                 recid(buf_point-io) = p-doc-rec No-ERROR.
      181       if not available buf_point-io then do:
      182         v-err-mess = substitute("&1 &2 &3&4Не найдена запись СУБЪЕКТ ДОСТАВКИ - p-doc-rec=&5"
      183                                 ,vss-workfile
      184                                 ,vss-revision
      185                                 ,vss-description
      186                                 , chr(10)
      187                                 ,p-doc-rec).
      188         run err-mess in this-procedure ( input-output v-err-mess).
      189         undo main-block, return error (if p-silent then v-err-mess else "":U).
      190       end.
      191       if buf_point-io.cli-type <> p-cli-type
      192       or buf_point-io.cli-code <> p-cli-code
      193       then do:
      194         v-err-mess = substitute("&1 &2 &3&4Для уже имеющейся записи нельзя изменить контрагента&4ранее был &5&6 - попытка изменить на &7&8"
      195                                 ,vss-workfile
      196                                 ,vss-revision
      197                                 ,vss-description
      198                                 , chr(10)
      199                                 ,buf_point-io.cli-type
      200                                 ,buf_point-io.cli-code
      201                                 ,p-cli-type
      202                                 ,p-cli-code
      203                                  ).
      204         run err-mess in this-procedure ( input-output v-err-mess).
      205         undo main-block, return error (if p-silent then v-err-mess else "":U).
      206       end.
      207     end.
      208     assign
      209     buf_point-io.point-name = p-point-name
      210     buf_point-io.PS         = p-PS
      211     buf_point-io.cli-type   = p-cli-type
      212     buf_point-io.cli-code   = p-cli-code
      213     buf_point-io.address    = p-address
      214     buf_point-io.is-default = p-is-default
      215     buf_point-io.point-type = p-point-type
      216     buf_point-io.deliv-subj-code = p-deliv-subj-code
      217     p-doc-rec = recid (buf_point-io).
      218     .
      219     release buf_point-io no-error.
      220     if error-status:error then do:
      221       v-err-mess = substitute("Ошибка при попытке сохранения записи:&1&2&1&3"
      222                               , chr(10)
      223                               , error-status:get-message(1)
      224                               , return-value ).
      225       run err-mess in this-procedure ( input-output v-err-mess).
      226       undo main-block, return error (if p-silent then v-err-mess else "":U).
      227     end.
      228   end.
      229   PROCEDURE err-mess:
      230   DEFINE INPUT-output PARAMETER p-mess as character No-UNDO.
      231   if p-silent then do:
      232     assign
      233     p-mess = substitute("Пункт доставки/отгрузки: код &1 БД &2&3:&4"
      234                         , (if p-mode = 'ДОБАВЛЕНИЕ':U or not available buf_point-io then p-point-code else buf_point-io.point-code)
      235                         , (if p-mode = 'ДОБАВЛЕНИЕ':U or not available buf_point-io then p-db-num else buf_point-io.db-num)
      236                         , chr(10)
      237                         , p-mess)
      238     .
      239   end.
      240   else do:
      241     message
      242     p-mess
      243     view-as alert-box error .
      244   end.
      245   END PROCEDURE.
