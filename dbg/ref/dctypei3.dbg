        1   block-level on error undo, throw.
        2   define input parameter p-silent as logical no-undo .
        3   define input parameter p-rec as recid no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: dctypei3.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: ref/dctypei3.p $":U .
        9   define variable vss-description as character no-undo init "Удаление типа ДК".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   define variable v-mess as character no-undo .
       80   define variable v-cmd-code as integer no-undo .
       81   define variable v-cmd-proc-handle as handle no-undo .
       82   define variable v-command as character no-undo .
       83   define variable v-rec-ord as integer no-undo .
       84   define buffer buf_dis-card-type  for ub.dis-card-type.
       85   define buffer buf_hist-nws-option for ub.hist-nws-option.
       86   define buffer buf_rule-call-param for ub.rule-call-param.
       87   define buffer buf_rp-by-call for ub.rp-by-call.
       88   define buffer buf_rule-by-call for ub.rule-by-call.
       89   define buffer term_Dis-card-type for ub.dis-card-type.
       90   define buffer buf_dis-card-type-attr for ub.dis-card-type-attr.
       91   define buffer buf_dis-dct-rule for ub.dis-dct-rule.
       92   define buffer buf_prop-ref-call for ub.prop-ref-call.
       93   define buffer buf_dis-card for ub.dis-card.
       94   define temp-table tt0-rp-by-call no-undo like ub.rp-by-call.
       95   define temp-table tt0-rule-by-call no-undo like ub.rule-by-call.
       96   define temp-table tt0-rule-call-param no-undo like ub.rule-call-param.
       97   main-block:
       98   do
       99   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      100   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      101   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      102   :
      103     if g#db-num > 0  then do:
      104       message  vss-workfile vss-revision vss-description skip
      105               "Вызов процедуры в УБД запрещен"
      106       view-as alert-box ERROR.
      107       undo main-block, return error '':u.
      108     end.
      109     find first buf_dis-card-type exclusive-lock where recid(buf_Dis-card-type) = p-rec.
      110     find first buf_dis-card no-lock where
      111               buf_Dis-card.type = buf_dis-card-type.type
      112           and buf_Dis-card.emitent-host-code = buf_dis-card-type.emitent-host-code no-error.
      113      if available buf_dis-card then do:
      114       v-mess = substitute("Имеются ДК данного типа&1удаление невозможно"
      115                            , chr(10)
      116                            , return-value ).
      117       run err-mess in this-procedure ( input-output v-mess) .
      118       undo main-block, return error (if p-silent = yes then v-mess else '':U).
      119     end.
      120     if not valid-handle(v-cmd-proc-handle ) then dO:
      121       run nws/cmd-bush.p persistent set v-cmd-proc-handle no-error .
      122       if error-status :error
      123       then do:
      124         delete procedure v-cmd-proc-handle .
      125         undo main-block, return error substitute("&1 &2 &3&4Ошибка при запуске процедуры cmd-bush.p&4" +
      126                                             "&5&4&6"
      127                                             ,vss-workfile
      128                                             ,vss-revision
      129                                             ,vss-description
      130                                             ,chr(10)
      131                                             ,error-status:get-message(1)
      132                                             ,return-value ).
      133       end.
      134     end.
      135     assign
      136     v-command =  substitute("&2&1&3&1&4"
      137                            , chr(6)
      138                            , 'cmd-dct-send':U
      139                            , buf_dis-card-type.emitent-host-code
      140                            , buf_dis-card-type.type
      141                            ).
      142     run begin-create-command in v-cmd-proc-handle
      143       (input v-command
      144       ,input "":U
      145       ,output v-cmd-code
      146       ) no-error.
      147     if error-status :error
      148     then do:
      149       message
      150         vss-workfile vss-revision vss-description skip
      151         substitute( "Ошибка при создании команды &1", 'cmd-dct-send':U ) skip
      152         error-status :get-message(1) skip
      153         return-value skip
      154         view-as alert-box error .
      155       delete procedure v-cmd-proc-handle .
      156       undo main-block, return error return-value .
      157     end.
      158     run rul/ruprcall.p (
      159                          input 'dis-card-type':U
      160                         ,input buf_dis-card-type.uniq-key-rec
      161                         ,input ('rp-by-call':U + chr(44) + 'rule-by-call':U + chr(44) + 'rule-call-param':U)
      162                         ,input v-cmd-proc-handle
      163                         ,input v-cmd-code
      164                         ,INPUT TABLE tt0-rp-by-call
      165                         ,INPUT TABLE tt0-rule-by-call
      166                         ,INPUT TABLE tt0-rule-call-param) no-error .
      167     if error-status:error then do:
      168       delete procedure v-cmd-proc-handle .
      169       message
      170       "Ошибка при удалении привязок профайлов и/правил для записи ТИП ДИСКОНТНОЙ КАРТЫ" skip
      171       error-status:get-message(1) skip
      172       return-value
      173       view-as alert-box error .
      174       undo main-block, return error .
      175     end.
      176     for each buf_hist-nws-option share-lock where
      177                 buf_hist-nws-option.table-name = 'dis-card-type':U
      178           and buf_hist-nws-option.host-code = buf_dis-card-type.emitent-host-code
      179           AND buf_hist-nws-option.charkey_one = buf_dis-card-type.type
      180     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      181     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      182     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      183     :
      184       run add-dump in v-cmd-proc-handle                                                                              (input v-cmd-code                                                                                            ,input 'hist-nws-option':U                                                                                          ,input '+delete'                                                                                         ,input buffer buf_hist-nws-option:handle                                                                                    ,input '':U                                                                                                  ,output v-rec-ord                                                                                            ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure v-cmd-proc-handle .                                                                           undo main-block, return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'hist-nws-option':U                                                                                                ,v-cmd-code                                                                                                  ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
      185       delete buf_hist-nws-option.
      186     end.
      187     for each term_dis-card-type share-lock where
      188                 term_dis-card-type.emitent-host-code = buf_dis-card-type.emitent-host-code
      189              and term_dis-card-type.type = buf_dis-card-type.type
      190     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      191     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      192     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      193     :
      194       if recid(term_dis-card-type) = recid(buf_Dis-card-type) then next.
      195       run add-dump in v-cmd-proc-handle                                                                              (input v-cmd-code                                                                                            ,input 'dis-card-type':U                                                                                          ,input '+delete'                                                                                         ,input buffer term_dis-card-type:handle                                                                                    ,input '':U                                                                                                  ,output v-rec-ord                                                                                            ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure v-cmd-proc-handle .                                                                           undo main-block, return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'dis-card-type':U                                                                                                ,v-cmd-code                                                                                                  ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
      196       delete term_dis-card-type.
      197     end.
      198     for each buf_dis-card-type-attr share-lock where
      199                 buf_dis-card-type-attr.emitent-host-code = buf_dis-card-type.emitent-host-code
      200              and buf_dis-card-type-attr.type = buf_dis-card-type.type
      201     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      202     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      203     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      204     :
      205       run add-dump in v-cmd-proc-handle                                                                              (input v-cmd-code                                                                                            ,input 'dis-card-type-attr':U                                                                                          ,input '+delete'                                                                                         ,input buffer buf_dis-card-type-attr:handle                                                                                    ,input '':U                                                                                                  ,output v-rec-ord                                                                                            ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure v-cmd-proc-handle .                                                                           undo main-block, return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'dis-card-type-attr':U                                                                                                ,v-cmd-code                                                                                                  ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
      206       delete buf_dis-card-type.
      207     end.
      208     for each buf_Dis-dct-rule share-lock where
      209             buf_dis-dct-rule.type = buf_dis-card-type.type
      210         and buf_dis-dct-rule.emitent-host-code = buf_dis-card-type.emitent-host-code
      211         and buf_dis-dct-rule.host-code = buf_dis-card-type.host-code
      212         and buf_dis-dct-rule.obj-type  = buf_dis-card-type.obj-type
      213         and buf_dis-dct-rule.obj-code  = buf_dis-card-type.obj-code
      214     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      215     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      216     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      217     :
      218       if not (
      219               buf_dis-dct-rule.discnt-role = 'def-pcnt':U
      220               or
      221               buf_dis-dct-rule.discnt-role = 'def-cash-pcnt':U
      222               or
      223               buf_dis-dct-rule.discnt-role = 'def-categ':U
      224               ) then next.
      225       run add-dump in v-cmd-proc-handle                                                                              (input v-cmd-code                                                                                            ,input 'dis-dct-rule':U                                                                                          ,input '+delete'                                                                                         ,input buffer buf_dis-dct-rule:handle                                                                                    ,input '':U                                                                                                  ,output v-rec-ord                                                                                            ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure v-cmd-proc-handle .                                                                           undo main-block, return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'dis-dct-rule':U                                                                                                ,v-cmd-code                                                                                                  ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
      226       delete buf_Dis-dct-rule.
      227     end.
      228     run add-dump in v-cmd-proc-handle                                                                              (input v-cmd-code                                                                                            ,input 'dis-card-type':U                                                                                          ,input '+delete'                                                                                         ,input buffer buf_dis-card-type:handle                                                                                    ,input '':U                                                                                                  ,output v-rec-ord                                                                                            ) no-error .                                                                                               if error-status :error                                                                                       then do:                                                                                                     delete procedure v-cmd-proc-handle .                                                                           undo main-block, return error substitute("&1 &2 &3&4Ошибка при добавлении записи &5 в команду с кодом &6&4&8&4&9&4"                                       ,vss-workfile                                                                                                ,vss-revision                                                                                                ,vss-description                                                                                             ,chr(10)                                                                                               ,'dis-card-type':U                                                                                                ,v-cmd-code                                                                                                  ,error-status:get-message(1)                                                                                 ,return-value                                                                                                ) .                                                                    end.
      229     delete buf_dis-card-type no-error.
      230     if error-status:error then do:
      231       v-mess = substitute("Ошибка при удалении: &1&2&3"
      232                            , error-status:get-message(1)
      233                            , chr(10)
      234                            , return-value ).
      235      run err-mess in this-procedure ( input-output v-mess) .
      236      undo main-block, return error (if p-silent = yes then v-mess else '':U).
      237     end.
      238     define variable v-db-list as character no-undo .
      239     define buffer buf_db for ub.db.
      240     for each buf_db no-lock
      241     where buf_db.db-num > 0
      242     :
      243       assign
      244       v-db-list = v-db-list + chr(1) + string(buf_db.db-num).
      245     end.
      246     v-db-list = trim(v-db-list, chr(1)).
      247     run send-command in v-cmd-proc-handle
      248       ( input v-cmd-code
      249         ,input v-db-list
      250         ) no-error .
      251     if error-status:error then do:
      252       delete procedure v-cmd-proc-handle .
      253       message
      254       vss-workfile vss-revision vss-description skip
      255       substitute( "Ошибка при отсылке команды &1", 'cmd-dct-send':U ) skip
      256       error-status :get-message(1) skip
      257       return-value skip
      258       view-as alert-box error .
      259       undo main-block, return error .
      260     end.
      261     delete procedure v-cmd-proc-handle .
      262   end.
      263   PROCEDURE err-mess:
      264     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      265     CASE p-silent:
      266       when yes then do:
      267         assign
      268         p-mess = substitute("Тип ДК &1 эмитент &2&3&4"
      269                            , buf_dis-card-type.type
      270                            , buf_dis-card-type.emitent-host-code
      271                            , chr(10)
      272                            , p-mess)
      273         .
      274       end.
      275       when no then do:
      276         message
      277         p-mess
      278         view-as alert-box error .
      279       end.
      280     end.
      281   END PROCEDURE.
