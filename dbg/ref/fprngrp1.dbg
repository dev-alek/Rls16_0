        1   block-level on error undo, throw.
        2   define input-output parameter par-rid as recid no-undo .
        3   define input parameter par-mode as character no-undo .
        4   define input parameter p-db-num like ub.fbr-prn.db-num no-undo .
        5   define input parameter p-prn-num like ub.fbr-prn.prn-num no-undo .
        6   define input parameter p-obj-type like ub.fbr-prn-grp.obj-type no-undo .
        7   define input parameter p-obj-code like ub.fbr-prn-grp.obj-code no-undo .
        8   define input parameter p-node-code like ub.fbr-prn-grp.node-code no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       11   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: fprngrp1.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: ref/fprngrp1.p $":U .
       14   define variable vss-description as character no-undo init "Сохранение изменений связки принтер кухни-группа товаров".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define variable var-entry as character no-undo .
       76   define variable v-db-num like ub.db.db-num no-undo .
       77   define buffer buf_fbr-prn-grp for ub.fbr-prn-grp .
       78   define buffer buf_clients for ub.clients.
       79   if par-mode <> 'ДОБАВЛЕНИЕ':U AND par-mode <> 'ИЗМЕНЕНИЕ':U then do:
       80     message vss-workfile vss-revision vss-description skip
       81             "Неверный параметр par-mode - " par-mode
       82     view-as alert-box error .
       83     return error '':u.
       84   end.
       85   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
       87     (output v-db-num
       88     )  .
       89   if p-db-num <> v-db-num then do:
       90     assign
       91     var-entry = "db-num":U
       92     .
       93     message
       94     vss-workfile vss-revision vss-description skip
       95     "Нельзя вводить группы для принтера в чужой БД"
       96     view-as alert-box error .
       97     return error var-entry.
       98   end.
       99   if p-node-code = 0 then do:
      100     assign
      101     var-entry = "node-code":U
      102     .
      103     message
      104     "Укажите группу товара"
      105     view-as alert-box error .
      106     return error var-entry.
      107   end.
      108   if p-prn-num = 0 then do:
      109     assign
      110     var-entry = "prn-num":U
      111     .
      112     message
      113     "Укажите номер принтера"
      114     view-as alert-box error .
      115     return error var-entry.
      116   end.
      117   find first buf_clients no-lock where
      118             buf_clients.obj-type = p-obj-type
      119        AND  buf_clients.obj-code = p-obj-code no-error .
      120   if p-obj-type = "":u
      121   or p-obj-code = 0
      122   or not available buf_clients
      123   then do:
      124     assign
      125     var-entry = "obj-code":U
      126     .
      127     message
      128     "Укажите объект"
      129     view-as alert-box error .
      130     return error var-entry.
      131   end.
      132   if buf_clients.db-num <> v-db-num then do:
      133     assign
      134     var-entry = "obj-code":U
      135     .
      136     message
      137     "Укажите объект текущей БД"
      138     view-as alert-box error .
      139     return error var-entry.
      140   end.
      141   if LOOKUP(p-obj-type, ('маг':U + chr(44) + 'скл':U)) = 0 then do:
      142     assign
      143     var-entry = "obj-type":U
      144     .
      145     message
      146     "Объект может быть только " 'маг':U "или" 'скл':U
      147     view-as alert-box error .
      148     return error var-entry.
      149   end.
      150   _main:
      151   do
      152   on error undo _main, return error
      153   :
      154     CASE par-mode:
      155       when 'ДОБАВЛЕНИЕ':U then do:
      156         find first buf_fbr-prn-grp no-lock where
      157                    buf_fbr-prn-grp.node-code = p-node-code
      158                AND buf_fbr-prn-grp.obj-type = p-obj-type
      159                AND buf_fbr-prn-grp.obj-code = p-obj-code no-error .
      160         if available buf_fbr-prn-grp then do:
      161           assign
      162           var-entry = "p-node-code"
      163           .
      164           message
      165           "Для группы товаров" p-node-code skip
      166           "уже определен принтер на объекте" p-obj-type p-obj-code
      167           view-as alert-box error .
      168           return error var-entry.
      169         end.
      170         create ub.fbr-prn-grp.
      171       end.
      172       when 'ИЗМЕНЕНИЕ':U then do:
      173         find first ub.fbr-prn-grp exclusive-lock where
      174                   recid(ub.fbr-prn-grp) = par-rid no-error .
      175         if not available ub.fbr-prn-grp
      176         then do:
      177           assign
      178           var-entry = "node-code":U
      179           .
      180           message
      181           "Не определен кухни для группы" p-node-code skip
      182           "на объекте" p-obj-type p-obj-code
      183           view-as alert-box error .
      184           return error var-entry.
      185         end.
      186         IF ub.fbr-prn-grp.obj-type <> p-obj-type
      187         OR ub.fbr-prn-grp.obj-code <> p-obj-code
      188         OR ub.fbr-prn-grp.node-code <> p-node-code
      189         OR ub.fbr-prn-grp.db-num <> p-db-num
      190         OR ub.fbr-prn-grp.prn-num <> p-prn-num
      191         then do:
      192           assign
      193           var-entry = "":U
      194           .
      195           message
      196           "Для записи группы товара на принтере кухни нельзя изменять поля первичного ключа"  skip
      197           view-as alert-box error .
      198           return error var-entry.
      199         end.
      200       end.
      201     END CASE.
      202     assign
      203     ub.fbr-prn-grp.node-code = p-node-code
      204     ub.fbr-prn-grp.prn-num = p-prn-num
      205     ub.fbr-prn-grp.db-num = p-db-num
      206     ub.fbr-prn-grp.obj-type = p-obj-type
      207     ub.fbr-prn-grp.obj-code = p-obj-code
      208     par-rid = recid(ub.fbr-prn-grp)
      209     .
      210   end.
