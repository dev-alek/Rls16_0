        1   block-level on error undo, throw.
        2   define input parameter p-silent                       as logical no-undo .
        3   define input-output parameter p-rid   as recid no-undo .
        4   define input parameter p-mode         as character no-undo .
        5   define input parameter p-host-code    like ub.fin-statement-line.host-code no-undo .
        6   define input parameter p-sttm-code    like ub.fin-statement-line.sttm-code no-undo .
        7   define input parameter p-fin-doc-code like ub.fin-statement-line.fin-doc-code no-undo .
        8   define input parameter p-pay-date     like ub.fin-statement-line.pay-date no-undo .
        9   define input parameter p-prn-doc-code like ub.fin-statement-line.prn-doc-code no-undo .
       10   define input parameter p-fin-ext-doc-type like ub.fin-statement-line.fin-ext-doc-type no-undo .
       11   define input parameter p-bik          like ub.fin-statement-line.rp-bik no-undo .
       12   define input parameter p-bank-name    like ub.fin-statement-line.rp-bank-name no-undo .
       13   define input parameter p-bank-city    like ub.fin-statement-line.rp-bank-city no-undo .
       14   define input parameter p-c-schet      like ub.fin-statement-line.rp-c-schet no-undo .
       15   define input parameter p-r-schet      like ub.fin-statement-line.rp-r-schet no-undo .
       16   define input parameter p-cli-name     like ub.fin-statement-line.rp-name no-undo .
       17   define input parameter p-inn          like ub.fin-statement-line.rp-inn no-undo .
       18   define input parameter p-kpp          like ub.fin-statement-line.rp-kpp no-undo .
       19   define input parameter p-sum-doc  like ub.fin-statement-line.sum-doc no-undo .
       20   define input parameter p-author as character no-undo .
       21   define input parameter p-ps as character no-undo .
       22   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       23   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       24   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       25   define variable vss-workfile    as character no-undo init "$Workfile: finsttml.p $":U .
       26   define variable vss-archive     as character no-undo init "$Archive: ref/finsttml.p $":U .
       27   define variable vss-description as character no-undo init "Сохранение изменений в строке выписки".
       28   procedure vss-get-info :
       29     define output parameter p-vss-revision    like vss-revision    no-undo .
       30     define output parameter p-vss-author      like vss-author      no-undo .
       31     define output parameter p-vss-date        like vss-date        no-undo .
       32     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       33     define output parameter p-vss-archive     like vss-archive     no-undo .
       34     define output parameter p-vss-description like vss-description no-undo .
       35     assign
       36       p-vss-revision    = vss-revision
       37       p-vss-author      = vss-author
       38       p-vss-date        = vss-date
       39       p-vss-workfile    = vss-workfile
       40       p-vss-archive     = vss-archive
       41       p-vss-description = vss-description
       42     .
       43   end procedure.
       44   procedure vss-get-parameters :
       45     define output parameter p-vss-parameters as character no-undo .
       46   end procedure.
       47   define new global shared variable g#vssrevis-logger as handle    no-undo .
       48   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       49   define variable v-vssrevis-logger                   as handle    no-undo .
       50   procedure vss-logevent :
       51     define input  parameter p-extra-paramters as character no-undo .
       52     define variable v-vssrevis-parameters as character no-undo .
       53     do
       54     on error undo, return error return-value
       55     :
       56       if  valid-handle(v-vssrevis-logger)
       57       and v-vssrevis-logger :get-signature("logevent") <> ""
       58       then do:
       59         run vss-get-parameters in this-procedure
       60           (output v-vssrevis-parameters
       61           ).
       62         run logevent in v-vssrevis-logger
       63           (input vss-workfile
       64           ,input vss-revision
       65           ,input v-vssrevis-parameters
       66           ,input p-extra-paramters
       67           ).
       68       end.
       69     end.
       70   end procedure.
       71   assign
       72     v-vssrevis-logger = g#vssrevis-logger
       73   .
       74   if  valid-handle(v-vssrevis-logger)
       75   and v-vssrevis-logger :get-signature("logevent") <> ""
       76   then do:
       77     assign
       78       v-vssrevis-logevent = true
       79     .
       80     run vss-logevent in this-procedure (input vss-description) .
       81   end.
       82   define new global shared variable g#language as character no-undo .
       83   if g#language <> '' and g#language <> 'rus':U then do:
       84     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       85   end.
       86   define new global shared variable g#library  as handle no-undo .
       87   define new global shared variable g#library2 as handle no-undo .
       88   define   shared variable g#auto as logical no-undo.
       89   define   shared variable g#news as logical no-undo.
       90   define   shared variable g#oxml as logical no-undo.
       91   define   shared variable g#esys as logical no-undo.
       92   define   shared variable g#news-source-db as integer no-undo.
       93   define   shared variable g#esys-source-esys as integer no-undo.
       94   define   shared variable g#db-num as integer   no-undo .
       95   define   shared variable g#userid as character no-undo .
       96   define   shared variable g#passwd as character no-undo .
       97   define variable v-mes     as character no-undo .
       98   DEFINE VARIABLE loc#log as logical no-undo .
       99   define variable v-sum-doc like ub.fin-statement-line.sum-doc no-undo .
      100   define variable v-sum-base like ub.fin-statement-line.sum-base no-undo .
      101   define variable v-sum-rubl like ub.fin-statement-line.sum-rubl no-undo .
      102   define variable v-exch-rate like ub.curr-accnt.exch-rate no-undo .
      103   define variable v-exch-scale like ub.curr-accnt.exch-scale no-undo .
      104   define variable v-base-rate like ub.curr-accnt.exch-rate no-undo .
      105   define variable v-base-scale like ub.curr-accnt.exch-scale no-undo .
      106   define variable v-base-code like ub.sysconf.base-code  no-undo .
      107   define variable v-curr-abbr like ub.currency.curr-abbr no-undo .
      108   define variable v-num-doc as integer no-undo .
      109   define variable v-fin-ext-doc-type  like ub.fin-doc.fin-ext-doc-type no-undo .
      110   define variable v-pay-date like ub.fin-statement-line.pay-date no-undo .
      111   define variable v-rp-bik like ub.fin-statement-line.rp-bik no-undo .
      112   define variable v-rp-bank-name like ub.fin-statement-line.rp-bank-name no-undo .
      113   define variable v-rp-bank-city like ub.fin-statement-line.rp-bank-city no-undo .
      114   define variable v-rp-c-schet like ub.fin-statement-line.rp-c-schet no-undo .
      115   define variable v-rp-r-schet like ub.fin-statement-line.rp-r-schet no-undo .
      116   define variable v-rp-name like ub.fin-statement-line.rp-name no-undo .
      117   define variable v-rp-inn like ub.fin-statement-line.rp-inn no-undo .
      118   define variable v-rp-kpp like ub.fin-statement-line.rp-kpp no-undo .
      119   define buffer buf_fin-statement for ub.fin-statement .
      120   define buffer buf_fin-statement-line for ub.fin-statement-line .
      121   define buffer buf_fin-doc for ub.fin-doc.
      122   _main:
      123   do
      124   on error undo, return error return-value
      125   :
      126   if NOT (p-mode = 'ДОБАВЛЕНИЕ':U or p-mode = 'удаление':U) then do:
      127     message
      128     vss-workfile vss-revision vss-description skip
      129     "Неверный параметр вызова p-mode" p-mode
      130     view-as alert-box ERROR.
      131     return error '':U.
      132   end.
      133   FIND FIRST buf_fin-statement EXCLUSIVE-LOCK WHERE
      134              buf_fin-statement.host-code = p-host-code
      135          AND buf_fin-statement.sttm-code = p-sttm-code No-ERROR No-WAIT.
      136   IF LOCKED buf_fin-statement then do:
      137     assign
      138     v-mes = "Запись ВЫПИСКИ занята, добавление/изменение строки невозможно".
      139     run err-mess in this-procedure ( input-output v-mes).
      140     undo _main, return error v-mes.
      141   end.
      142   IF NOT available buf_fin-statement then do:
      143     assign
      144     v-mes = "Не найденa выписка".
      145     run err-mess in this-procedure ( input-output v-mes).
      146     undo _main, return error v-mes.
      147   end.
      148   if buf_fin-statement.status_ <> 'новый':U then do:
      149     assign
      150     v-mes = substitute("Выписка имеет статус &1, добавление/изменение строки невозможно", buf_fin-statement.status_).
      151     run err-mess in this-procedure ( input-output v-mes).
      152     undo _main, return error v-mes.
      153   end.
      154   if p-fin-doc-code > 0
      155   then do:
      156     find first buf_fin-doc exclusive-lock where
      157             buf_fin-doc.host-code = p-host-code
      158          AND buf_fin-doc.fin-doc-code = p-fin-doc-code no-wait no-error.
      159     IF LOCKED buf_fin-statement then do:
      160       assign
      161       v-mes = substitute("Запись ПЛАТЕЖА (внутр.№&1) занята, добавление/исключение его невозможно"
      162                         , p-fin-doc-code)
      163       .
      164       run err-mess in this-procedure ( input-output v-mes).
      165       undo _main, return error v-mes.
      166     end.
      167     if p-author = '':u
      168     and buf_fin-doc.status_ <> 'факт':U then do:
      169       assign
      170       v-mes = substitute("ПЛАТЕЖ (внутр.№&1) имеет статус &2,&3добавление/исключение в ВЫПИСКУ возможно только при ИМПОРТЕ из системы КЛИЕНТ-БАНК"
      171                         , p-fin-doc-code
      172                         , buf_fin-doc.status_
      173                         , chr(10)
      174                         )
      175       .
      176       run err-mess in this-procedure ( input-output v-mes).
      177       undo _main, return error v-mes.
      178     end.
      179     if p-author <> '':U
      180     and not (buf_fin-doc.status_ = 'банк':U
      181             or
      182             buf_fin-doc.status_ = 'факт':U) then do:
      183       assign
      184       v-mes = substitute("ПЛАТЕЖ (внутр.№&1) имеет статус &2,&3добавление/исключение в ВЫПИСКУ невозможно"
      185                         , p-fin-doc-code
      186                         , buf_fin-doc.status_
      187                         , chr(10)
      188                         )
      189       .
      190       run err-mess in this-procedure ( input-output v-mes).
      191       undo _main, return error v-mes.
      192     end.
      193     if buf_fin-doc.sttm-code > 0 then do:
      194       assign
      195       v-mes = substitute("Платеж &1 (внутр.№ &2) уже включен в банковскую выписку &3 по фирме &4&5добавление строки невозможно"
      196                         , buf_fin-doc.prn-doc-code
      197                         , buf_fin-doc.fin-doc-code
      198                         , buf_fin-doc.sttm-code
      199                         , p-host-code
      200                         , chr(10)
      201                         ).
      202       run err-mess in this-procedure ( input-output v-mes).
      203       undo _main, return error v-mes.
      204     END.
      205     if buf_fin-doc.fact-date < buf_fin-statement.start-date
      206     or buf_fin-doc.fact-date > buf_fin-statement.end-date then do:
      207       assign
      208       v-mes = substitute("Платеж &1 (внутр.№ &2) имеет дату факт &3&4и не может быть включен в банковскую выписку &5 по фирме &6 за &7-&8"
      209                         , buf_fin-doc.prn-doc-code
      210                         , buf_fin-doc.fin-doc-code
      211                         , buf_fin-doc.fact-date
      212                         , chr(10)
      213                         , buf_fin-doc.sttm-code
      214                         , p-host-code
      215                         , string(buf_fin-statement.start-date, "99/99/9999")
      216                         , string(buf_fin-statement.end-date, "99/99/9999")
      217                         ).
      218       run err-mess in this-procedure ( input-output v-mes).
      219       undo _main, return error v-mes.
      220     end.
      221   end.
      222   DO ON ERROR UNDO, return '':U
      223      On STOP UNDO, return '':U:
      224     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      225       find last buf_fin-statement-line no-lock where
      226               buf_fin-statement-line.host-code = p-host-code
      227           AND buf_fin-statement-line.sttm-code = p-sttm-code no-error.
      228       CREATE ub.fin-statement-line.
      229       ASSIGN
      230       ub.fin-statement-line.host-code     = p-host-code
      231       ub.fin-statement-line.sttm-code     = p-sttm-code
      232       ub.fin-statement-line.line-num      = (if available buf_fin-statement-line
      233                                              then buf_fin-statement-line.line-num else 0)  + 1
      234       ub.fin-statement-line.fin-doc-code  = (if available buf_fin-doc then buf_fin-doc.fin-doc-code else 0)
      235       ub.fin-statement-line.fin-ext-doc-type =  (if available buf_fin-doc
      236                                                  then  buf_fin-doc.fin-ext-doc-type
      237                                                  else  p-fin-ext-doc-type)
      238       ub.fin-statement-line.fin-doc-type = (if available buf_fin-doc
      239                                             then  buf_fin-doc.fin-doc-type
      240                                             else '':U)
      241       ub.fin-statement-line.fins-ext-doc-type = buf_fin-statement.fins-ext-doc-type
      242       ub.fin-statement-line.fins-doc-type = buf_fin-statement.fins-doc-type
      243       ub.fin-statement-line.prn-doc-code = (if available buf_fin-doc then buf_fin-doc.prn-doc-code else p-prn-doc-code)
      244       ub.fin-statement-line.ps = p-ps
      245       .
      246       if available buf_fin-doc then do:
      247         buf_fin-doc.sttm-code = p-sttm-code.
      248       end.
      249       assign p-rid = recid(ub.fin-statement-line).
      250     end.
      251     else do:
      252       FIND FIRST ub.fin-statement-line EXCLUSIVE-LOCK WHERE
      253                 recid(ub.fin-statement-line) = p-rid No-WAIT No-ERROR.
      254       if locked ub.fin-statement-line then do:
      255         assign
      256         v-mes = substitute("Строка выписки занята").
      257         run err-mess in this-procedure ( input-output v-mes).
      258         undo _main, return error v-mes.
      259       end.
      260       if not avail ub.fin-statement-line then do:
      261         assign
      262         v-mes = substitute("Не найдена строка выписки").
      263         run err-mess in this-procedure ( input-output v-mes).
      264         undo _main, return error v-mes.
      265       end.
      266       if available buf_fin-doc then do:
      267         buf_fin-doc.sttm-code = 0.
      268       end.
      269     end.
      270     if p-fin-doc-code > 0 then do:
      271       if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      272         assign
      273         v-num-doc = 1
      274         v-sum-doc = buf_fin-doc.sum-doc
      275         v-sum-rubl = buf_fin-doc.sum-rubl
      276         v-sum-base = buf_fin-doc.sum-base
      277         v-fin-ext-doc-type = buf_fin-doc.fin-ext-doc-type
      278         v-pay-date = buf_fin-doc.pay-date
      279         v-rp-c-schet = (if buf_fin-doc.fin-doc-type = 'ппп':U
      280                         then buf_fin-doc.payer-c-schet
      281                         else buf_fin-doc.receiver-c-schet)
      282         v-rp-bik  = (if buf_fin-doc.fin-doc-type = 'ппп':U
      283                      then buf_fin-doc.payer-bik
      284                      else buf_fin-doc.receiver-bik)
      285         v-rp-bank-name  = (if buf_fin-doc.fin-doc-type = 'ппп':U
      286                      then buf_fin-doc.payer-bank-name
      287                      else buf_fin-doc.receiver-bank-name)
      288         v-rp-bank-city  = (if buf_fin-doc.fin-doc-type = 'ппп':U
      289                      then buf_fin-doc.payer-bank-city
      290                      else buf_fin-doc.receiver-bank-city)
      291         v-rp-r-schet  = (if buf_fin-doc.fin-doc-type = 'ппп':U
      292                      then buf_fin-doc.payer-r-schet
      293                      else buf_fin-doc.receiver-r-schet)
      294         v-rp-name  = (if buf_fin-doc.fin-doc-type = 'ппп':U
      295                      then buf_fin-doc.payer-name
      296                      else buf_fin-doc.receiver-name)
      297         v-rp-inn  = (if buf_fin-doc.fin-doc-type = 'ппп':U
      298                      then buf_fin-doc.payer-inn
      299                      else buf_fin-doc.receiver-inn)
      300         v-rp-kpp  = (if buf_fin-doc.fin-doc-type = 'ппп':U
      301                      then buf_fin-doc.payer-kpp
      302                      else buf_fin-doc.receiver-kpp)
      303         .
      304       end.
      305       if p-mode = 'удаление':U then do:
      306         assign
      307         v-num-doc = -1
      308         v-sum-doc = - ub.fin-statement-line.sum-doc
      309         v-sum-rubl = - ub.fin-statement-line.sum-rubl
      310         v-sum-base = - ub.fin-statement-line.sum-base
      311         v-fin-ext-doc-type = ub.fin-statement-line.fin-ext-doc-type
      312         .
      313       end.
      314     end.
      315     else do:
      316       assign
      317       v-fin-ext-doc-type = p-fin-ext-doc-type
      318       v-pay-date = p-pay-date
      319       v-rp-bik = p-bik
      320       v-rp-bank-name = p-bank-name
      321       v-rp-bank-city = p-bank-city
      322       v-rp-c-schet = p-c-schet
      323       v-rp-r-schet = p-r-schet
      324       v-rp-name = p-cli-name
      325       v-rp-inn = p-inn
      326       v-rp-kpp = p-kpp
      327       .
      328   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      329   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      330     (input  buf_fin-statement.host-code
      331     ,output v-base-code
      332     )  .
      333       if v-base-code <> 0 then do:
      334   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      335   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
      336     (input  v-base-code
      337     ,input  p-pay-date
      338     ,output v-base-rate
      339     ,output v-base-scale
      340     ,output v-curr-abbr
      341     )  .
      342       end.
      343       if buf_fin-statement.curr-code <> 0 then do:
      344   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      345   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
      346     (input  buf_fin-statement.curr-code
      347     ,input  p-pay-date
      348     ,output v-exch-rate
      349     ,output v-exch-scale
      350     ,output v-curr-abbr
      351     )  .
      352       end.
      353       assign
      354       v-sum-doc = p-sum-doc
      355       v-sum-rubl = (if buf_fin-statement.curr-code = 0
      356                     then v-sum-doc
      357                     else (p-sum-doc * v-exch-rate / v-exch-scale))
      358       v-sum-base = if v-base-code = 0
      359                     then v-sum-rubl
      360                     else (v-sum-rubl / v-base-rate * v-base-scale)
      361       v-num-doc = 1
      362       .
      363       if p-mode = 'удаление':U then do:
      364         assign
      365         v-sum-doc = - v-sum-doc
      366         v-sum-rubl = - v-sum-rubl
      367         v-sum-base = - v-sum-base
      368         v-num-doc =  - v-num-doc
      369         .
      370       end.
      371     end.
      372     assign
      373     ub.fin-statement-line.rp-bik     = v-rp-bik
      374     ub.fin-statement-line.rp-bank-name = v-rp-bank-name
      375     ub.fin-statement-line.rp-bank-city = v-rp-bank-city
      376     ub.fin-statement-line.rp-c-schet = v-rp-c-schet
      377     ub.fin-statement-line.rp-r-schet = v-rp-r-schet
      378     ub.fin-statement-line.rp-name = v-rp-name
      379     ub.fin-statement-line.rp-inn = v-rp-inn
      380     ub.fin-statement-line.rp-kpp = v-rp-kpp
      381     .
      382     CASE v-fin-ext-doc-type:
      383       when 'ппп':U then do:
      384         assign
      385         ub.fin-statement-line.pay-date = v-pay-date
      386         buf_fin-statement.in-sum-doc-th = buf_fin-statement.in-sum-doc-th + v-sum-doc
      387         ub.fin-statement-line.sum-doc = v-sum-doc
      388         buf_fin-statement.in-sum-rubl-th = buf_fin-statement.in-sum-rubl-th + v-sum-rubl
      389         ub.fin-statement-line.sum-rubl = v-sum-rubl
      390         buf_fin-statement.in-sum-base-th = buf_fin-statement.in-sum-base-th + v-sum-base
      391         ub.fin-statement-line.sum-base = v-sum-base
      392         .
      393         if p-author = '':U
      394         then do:
      395           assign
      396           buf_fin-statement.in-sum-doc = buf_fin-statement.in-sum-doc  + v-sum-doc
      397           buf_fin-statement.in-sum-rubl = buf_fin-statement.in-sum-rubl + v-sum-rubl
      398           buf_fin-statement.in-sum-base = buf_fin-statement.in-sum-base + v-sum-base
      399           .
      400         end.
      401       end.
      402       when 'рпп':U then do:
      403         assign
      404         ub.fin-statement-line.pay-date = v-pay-date
      405         ub.fin-statement-line.rp-c-schet = v-rp-c-schet
      406         buf_fin-statement.out-sum-doc-th = buf_fin-statement.out-sum-doc-th + v-sum-doc
      407         ub.fin-statement-line.sum-doc = v-sum-doc
      408         buf_fin-statement.out-sum-rubl-th = buf_fin-statement.out-sum-rubl-th + v-sum-rubl
      409         ub.fin-statement-line.sum-rubl = v-sum-rubl
      410         buf_fin-statement.out-sum-base-th = buf_fin-statement.out-sum-base-th + v-sum-base
      411         ub.fin-statement-line.sum-base = v-sum-base
      412         .
      413         if p-author = '':U then do:
      414           assign
      415           buf_fin-statement.out-sum-doc = buf_fin-statement.out-sum-doc + v-sum-doc
      416           buf_fin-statement.out-sum-rubl = buf_fin-statement.out-sum-rubl + v-sum-rubl
      417           buf_fin-statement.out-sum-base = buf_fin-statement.out-sum-base + v-sum-base
      418           .
      419         end.
      420       end.
      421     END CASE.
      422     assign
      423     buf_fin-statement.sum-doc-th = buf_fin-statement.in-sum-doc-th  - buf_fin-statement.out-sum-doc-th
      424     buf_fin-statement.sum-rubl-th = buf_fin-statement.in-sum-rubl-th  - buf_fin-statement.out-sum-rubl-th
      425     buf_fin-statement.sum-base-th = buf_fin-statement.in-sum-base-th  - buf_fin-statement.out-sum-base-th
      426     buf_fin-statement.end-sum-doc-th = buf_fin-statement.start-sum-doc-th  + buf_fin-statement.sum-doc-th
      427     buf_fin-statement.end-sum-rubl-th = buf_fin-statement.start-sum-rubl-th  + buf_fin-statement.sum-rubl-th
      428     buf_fin-statement.end-sum-base-th = buf_fin-statement.start-sum-base-th  + buf_fin-statement.sum-base-th
      429     buf_fin-statement.num-docs-th = buf_fin-statement.num-docs-th + v-num-doc
      430     .
      431     if p-author = '':U then do:
      432       assign
      433       buf_fin-statement.sum-doc = buf_fin-statement.in-sum-doc  - buf_fin-statement.out-sum-doc
      434       buf_fin-statement.sum-rubl = buf_fin-statement.in-sum-rubl  - buf_fin-statement.out-sum-rubl
      435       buf_fin-statement.sum-base = buf_fin-statement.in-sum-base  - buf_fin-statement.out-sum-base
      436       buf_fin-statement.end-sum-doc = buf_fin-statement.start-sum-doc  + buf_fin-statement.sum-doc
      437       buf_fin-statement.end-sum-rubl = buf_fin-statement.start-sum-rubl  + buf_fin-statement.sum-rubl
      438       buf_fin-statement.end-sum-base = buf_fin-statement.start-sum-base  + buf_fin-statement.sum-base
      439       buf_fin-statement.num-docs = buf_fin-statement.num-docs + v-num-doc
      440       .
      441     end.
      442     if p-author = '1s':U then do:
      443       assign
      444       buf_fin-statement.sum-doc = buf_fin-statement.in-sum-doc  - buf_fin-statement.out-sum-doc
      445       buf_fin-statement.sum-rubl = buf_fin-statement.in-sum-rubl  - buf_fin-statement.out-sum-rubl
      446       buf_fin-statement.sum-base = buf_fin-statement.in-sum-base  - buf_fin-statement.out-sum-base
      447       .
      448     end.
      449     if p-mode = 'ДОБАВЛЕНИЕ':U then dO:
      450       release ub.fin-statement-line no-error.
      451       if error-status:error then do:
      452         assign
      453         v-mes = substitute("Ошибка при сохранении строки выписки:&1&2&1&3"
      454                            , chr(10)
      455                            , error-status:get-message(1)
      456                            , return-value
      457                            ).
      458         run err-mess in this-procedure ( input-output v-mes).
      459         undo _main, return error v-mes.
      460       end.
      461     end.
      462     if p-mode = 'удаление':U then do:
      463       assign
      464       .
      465       delete ub.fin-statement-line no-error.
      466       if error-status:error then do:
      467         assign
      468         v-mes = substitute("Ошибка при удалении строки выписки:&1&2&1&3"
      469                            , chr(10)
      470                            , error-status:get-message(1)
      471                            , return-value
      472                            ).
      473         run err-mess in this-procedure ( input-output v-mes).
      474         undo _main, return error v-mes.
      475       end.
      476       p-rid = ?.
      477     end.
      478   END.
      479   return '':U.
      480   end.
      481   PROCEDURE err-mess:
      482     DEFINE INPUT-output PARAMETER p-mes as character No-UNDO.
      483     p-mes = substitute("ВЫПИСКА фирма &1 №&2 строка по документу &3:&4&5"
      484                      , p-host-code
      485                      , p-sttm-code
      486                      , p-prn-doc-code
      487                      , chr(10)
      488                      , p-mes).
      489     if not p-silent then do:
      490       message
      491       p-mes view-as alert-box error .
      492     end.
      493   END PROCEDURE.
