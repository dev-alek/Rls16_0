     1922               where buf_temp-browse-handle.browse-type = 'width':u
     1923             on error undo, next
     1924             :
     1925               assign
     1926                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1927               .
     1928             end.
     1929             assign
     1930               v-diasize-browse-handle :width = v-browse-width
     1931             .
     1932             for each buf_temp-diasize-handle
     1933             on error undo, next
     1934             :
     1935               assign
     1936                 v-object-handle = buf_temp-diasize-handle.handle-value
     1937               .
