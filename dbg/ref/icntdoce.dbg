     1967         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1968         v-browse-width = v-diasize-browse-handle :width
     1969       .
     1970       for each buf_temp-browse-handle
     1971         where buf_temp-browse-handle.browse-type = 'width':u
     1972       :
     1973         assign
