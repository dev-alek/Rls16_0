     2020         .
     2021       end.
     2022       do with frame Dialog-Frame
     2023       :
     2024         hide v-diasize-resize-button .
     2025         v-diasize-resize-button :row = 1.
     2026         v-diasize-resize-button :column = 1.
     2027       end.
     2028       if p-change-value > 0
     2029       then do:
     2030         if frame Dialog-Frame :scrollable = true
     2031         then do:
     2032           assign
     2033             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2034             no-error .
     2035           if error-status :error
     2036           or error-status :get-message(1) <> ""
     2037           then do:
     2038             undo move_block, retry move_block.
     2039           end.
     2040         end.
     2041         assign
     2042           frame Dialog-Frame :width = v-frame-width + p-change-value
     2043           no-error .
     2044         if error-status :error
     2045         or error-status :get-message(1) <> ""
     2046         then do:
     2047           undo move_block, retry move_block.
     2048         end.
     2049         assign
     2050           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2051         no-error .
     2052         if error-status :error
     2053         or error-status :get-message(1) <> ""
     2054         then do:
     2055           undo move_block, retry move_block.
     2056         end.
     2057         for each buf_temp-browse-handle
     2058           where buf_temp-browse-handle.browse-type = 'width':u
     2059         on error undo move_block, retry move_block
     2060         :
     2061           assign
     2062             buf_temp-browse-handle.browse-handle :width
     2063               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2064             no-error .
     2065           if error-status :error
     2066           or error-status :get-message(1) <> ""
     2067           then do:
     2068             undo move_block, retry move_block .
     2069           end.
     2070         end.
     2071         for each buf_temp-diasize-handle
     2072         on error undo move_block, retry move_block
     2073         :
     2074           assign
     2075             v-object-handle = buf_temp-diasize-handle.handle-value
     2076           .
     2077           if v-object-handle <> v-diasize-resize-button
     2078           then do:
     2079             assign
     2080               v-object-handle :col = v-object-handle :col + p-change-value
     2081               no-error .
     2082             if error-status :error
     2083             or error-status :get-message(1) <> ""
     2084             then do:
     2085               undo move_block, retry move_block .
     2086             end.
     2087           end.
     2088         end.
     2089       end.
     2090       else do:
     2091         for each buf_temp-diasize-handle
     2092         on error undo move_block, retry move_block
     2093         :
     2094           assign
     2095             v-object-handle = buf_temp-diasize-handle.handle-value
     2096           .
     2097           if v-object-handle <> v-diasize-resize-button
     2098           then do:
     2099             assign
     2100               v-object-handle :col = v-object-handle :col + p-change-value
     2101               no-error .
     2102             if error-status :error
     2103             or error-status :get-message(1) <> ""
     2104             then do:
     2105               undo move_block, retry move_block .
     2106             end.
     2107           end.
     2108         end.
     2109         for each buf_temp-browse-handle
     2110           where buf_temp-browse-handle.browse-type = 'width':u
     2111         on error undo move_block, retry move_block
     2112         :
     2113           assign
     2114             buf_temp-browse-handle.browse-handle :width
     2115               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2116             no-error .
     2117           if error-status :error
     2118           or error-status :get-message(1) <> ""
     2119           then do:
     2120             undo move_block, retry move_block .
     2121           end.
     2122         end.
     2123         assign
     2124           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2125           no-error .
     2126         if error-status :error
     2127         or error-status :get-message(1) <> ""
     2128         then do:
     2129           undo move_block, retry move_block.
     2130         end.
     2131         assign
     2132           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2133         no-error .
     2134         if error-status :error
     2135         or error-status :get-message(1) <> ""
     2136         then do:
     2137           undo move_block, retry move_block.
     2138         end.
     2139         if frame Dialog-Frame :scrollable = true
     2140         then do:
     2141           assign
     2142             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2143           no-error .
     2144           if error-status :error
     2145           or error-status :get-message(1) <> ""
     2146           then do:
     2147             undo move_block, retry move_block.
     2148           end.
     2149         end.
     2150       end.
     2151       if p-move-resize
     2152       then do:
     2153         run diasize_position-resize-button in this-procedure .
     2154       end.
     2155       if v-diasize-wndstore = true
     2156       then do:
     2157         if connected("ub") = true
     2158         then do:
     2159           define variable v-cntxt-db-num        as integer   no-undo .
     2160           define variable v-cntxt-userid        as character no-undo .
     2161           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2162                                             , OUTPUT v-cntxt-userid
     2163                                             ) .
     2164           run gbl/wndsizew.p
     2165             (input  v-cntxt-db-num
     2166             ,input  v-cntxt-userid
     2167             ,input  v-diasize-proc-name
     2168             ,input  'width':u
     2169             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2170             ) .
     2171         end.
     2172       end.
     2173     end.
     2174     assign
     2175       v-diasize-change-size = false
     2176     .
     2177   end procedure.
     2178   procedure diasize_set-width :
     2179     define input  parameter p-new-width  as decimal   no-undo .
     2180     define input  parameter p-move-resize as logical   no-undo .
     2181     do
     2182     on error undo, return error return-value
     2183     :
     2184       run diasize_change-width in this-procedure
     2185         (input  (p-new-width - frame Dialog-Frame :width)
     2186         ,input  p-move-resize
     2187         ) .
     2188     end.
     2189   end procedure.
     2190   procedure diasize_position-resize-button :
     2191     do with frame Dialog-Frame
     2192     :
     2193       hide v-diasize-resize-button .
     2194       assign
     2195         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2196                     - 1
     2197                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2198         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2199                     - 1
     2200                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2201       .
     2202       view v-diasize-resize-button .
     2203     end.
     2204   end procedure.
     2205   on alt-right anywhere
     2206   do:
     2207     run diasize_change-width in this-procedure
     2208       (input 1
     2209       ,input true
     2210       ) .
     2211     return no-apply .
     2212   end.
     2213   on alt-left anywhere
     2214   do:
     2215     run diasize_change-width in this-procedure
     2216       (input -1
     2217       ,input true
     2218       ) .
     2219     return no-apply .
     2220   end.
     2221   on alt-down anywhere
     2222   do:
     2223     run diasize_change-height in this-procedure
     2224       (input 1
     2225       ,input true
     2226       ) .
     2227     return no-apply .
     2228   end.
     2229   on alt-up anywhere
     2230   do:
     2231     run diasize_change-height in this-procedure
     2232       (input -1
     2233       ,input true
     2234       ) .
     2235     return no-apply .
     2236   end.
     2237   on alt-enter of frame Dialog-Frame
     2238   do:
     2239     run diasize_maximize in this-procedure
     2240       (input  ?
     2241       ).
     2242     return no-apply .
     2243   end.
     2244   procedure diasize_end-move :
     2245     do
     2246     on error undo, return error return-value
     2247     :
     2248       define variable v-row-delta as decimal   no-undo .
     2249       define variable v-col-delta as decimal   no-undo .
     2250       define variable v-new-row as decimal   no-undo .
     2251       define variable v-new-col as decimal   no-undo .
     2252       assign
     2253         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2254         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2255       .
     2256       assign
     2257         v-row-delta = v-new-row - frame Dialog-Frame :height
     2258         v-col-delta = v-new-col - frame Dialog-Frame :width
     2259       .
     2260       run diasize_change-height in this-procedure
     2261         (input v-row-delta
     2262         ,input true
     2263         ) .
     2264       run diasize_change-width in this-procedure
     2265         (input v-col-delta
     2266         ,input true
     2267         ) .
     2268     end.
     2269   end procedure.
     2270   procedure diasize_maximize :
     2271     define input  parameter p-action as logical   no-undo .
     2272     do
     2273     on error undo, return error return-value
     2274     :
     2275       if p-action = ?
     2276       then do:
     2277         if v-diasize-need-maximize = true
     2278         then do:
     2279           assign
     2280             p-action = true
     2281           .
     2282         end.
     2283         else do:
     2284           assign
     2285             p-action = false
     2286           .
     2287         end.
     2288       end.
     2289       if p-action = true
     2290       then do:
     2291         run diasize_change-height in this-procedure
     2292           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2293               - frame Dialog-Frame :height-chars
     2294           ,input true
     2295           ) .
     2296         run diasize_change-width in this-procedure
     2297           (input session :width-chars
     2298               - frame Dialog-Frame :width-chars
     2299           ,input true
     2300           ) .
     2301         assign
     2302           v-diasize-need-maximize = false
     2303         .
     2304       end.
     2305       else do:
     2306         run diasize_change-width in this-procedure
     2307           (input v-diasize-orig-frame-width
     2308               - frame Dialog-Frame :width-chars
     2309           ,input true
     2310           ) .
     2311         run diasize_change-height in this-procedure
     2312           (input v-diasize-orig-frame-height
     2313               - frame Dialog-Frame :height-chars
     2314           ,input true
     2315           ) .
     2316         assign
     2317           v-diasize-need-maximize = true
     2318         .
     2319       end.
     2320     end.
     2321   end procedure.
     2322   procedure diasize_restore-orig-size :
     2323     do
     2324     on error undo, return error return-value
     2325     :
     2326       assign
     2327         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2328         v-diasize-current-frame-height = frame Dialog-Frame :height
     2329       .
     2330       run diasize_set-height in this-procedure
     2331         (input  v-diasize-orig-frame-height
     2332         ,input  true
     2333         ) .
     2334       run diasize_set-width in this-procedure
     2335         (input  v-diasize-orig-frame-width
     2336         ,input  true
     2337         ) .
     2338     end.
     2339   end procedure.
     2340   procedure diasize_restore-current-size :
     2341     do
     2342     on error undo, return error return-value
     2343     :
     2344       run diasize_set-height in this-procedure
     2345         (input  v-diasize-current-frame-height
     2346         ,input  true
     2347         ) .
     2348       run diasize_set-width in this-procedure
     2349         (input  v-diasize-current-frame-width
     2350         ,input  true
     2351         ) .
     2352     end.
     2353   end procedure.
     2354   procedure diasize_set-browse-handle :
     2355     define input  parameter p-browse-handle as handle   no-undo .
     2356     define buffer buf_temp-browse-handle for temp-browse-handle .
     2357     do
     2358     on error undo, return error return-value
     2359     :
     2360       assign
     2361         v-diasize-browse-handle = p-browse-handle
     2362       .
     2363       for each buf_temp-browse-handle
     2364       on error undo, return error return-value
     2365       :
     2366         delete buf_temp-browse-handle .
     2367       end.
     2368     end.
     2369   end procedure.
     2370   procedure diasize_add_browse :
     2371     define input  parameter p-browse-type   as character no-undo .
     2372     define input  parameter p-browse-handle as handle    no-undo .
     2373     define buffer buf_temp-browse-handle for temp-browse-handle .
     2374     do
     2375     on error undo, return error return-value
     2376     :
     2377       assign
     2378         v-diasize-browse-number = v-diasize-browse-number + 1
     2379       .
     2380       create buf_temp-browse-handle .
     2381       assign
     2382         buf_temp-browse-handle.browse-type   = p-browse-type
     2383         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2384         buf_temp-browse-handle.browse-handle = p-browse-handle
     2385       .
     2386     end.
     2387   end procedure.
     2388   procedure diasize_init :
     2389     define variable v-default-value    as logical   no-undo .
     2390     define variable v-restore-saved    as logical   no-undo .
     2391     define variable v-resize-value-str as character no-undo .
     2392     do
     2393     on error undo, return error return-value
     2394     :
     2395       do with frame Dialog-Frame
     2396       :
     2397         assign
     2398           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2399           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2400           v-diasize-browse-handle     = browse br-line :handle
     2401         .
     2402         create button v-diasize-resize-button
     2403         assign
     2404           parent        = frame Dialog-Frame :first-child
     2405           label         = "s"
     2406           height-pixels = 16
     2407           width-pixels  = 16
     2408           visible       = true
     2409           sensitive     = true
     2410           movable       = true
     2411           triggers:
     2412             on end-move persistent run diasize_end-move in this-procedure .
     2413           end triggers.
     2414         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2415         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2416         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2417         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2418         assign
     2419           v-diasize-wndmax = false
     2420         .
     2421         if connected("ub") = true
     2422         then do:
     2423           define variable v-cntxt-db-num        as integer   no-undo .
     2424           define variable v-cntxt-userid        as character no-undo .
     2425           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2426                                             , OUTPUT v-cntxt-userid
     2427                                             ) .
     2428           run gbl/wndpar_r.p
     2429             (input  v-cntxt-db-num
     2430             ,input  v-cntxt-userid
     2431             ,input  'wndmax':U
     2432             ,output v-diasize-wndmax
     2433             ,output v-default-value
     2434             ) .
     2435         end.
     2436         assign
     2437           v-diasize-wndstore = false
     2438         .
     2439         if connected("ub") = true
     2440         then do:
     2441           run gbl/wndpar_r.p
     2442             (input  v-cntxt-db-num
     2443             ,input  v-cntxt-userid
     2444             ,input  'wndstore':U
     2445             ,output v-diasize-wndstore
     2446             ,output v-default-value
     2447             ) .
     2448         end.
     2449         assign
     2450           v-diasize-proc-name = entry(1, program-name(2), '.')
     2451         .
     2452         if v-diasize-wndstore = true
     2453         then do:
     2454           assign
     2455             v-restore-saved = false
     2456           .
     2457           if connected("ub") = true
     2458           then do:
     2459             run gbl/wndsizer.p
     2460               (input  v-cntxt-db-num
     2461               ,input  v-cntxt-userid
     2462               ,input  v-diasize-proc-name
     2463               ,input  'height':u
     2464               ,output v-resize-value-str
     2465               ) .
     2466             if v-resize-value-str <> '':U
     2467             then do:
     2468               run diasize_change-height in this-procedure
     2469                 (input  integer(v-resize-value-str)
     2470                 ,input  true
     2471                 ) .
     2472               assign
     2473                 v-restore-saved = true
     2474               .
     2475             end.
     2476           end.
     2477           if connected("ub") = true
     2478           then do:
     2479             run gbl/wndsizer.p
     2480               (input  v-cntxt-db-num
     2481               ,input  v-cntxt-userid
     2482               ,input  v-diasize-proc-name
     2483               ,input  'width':u
     2484               ,output v-resize-value-str
     2485               ) .
     2486             if v-resize-value-str <> '':U
     2487             then do:
     2488               run diasize_change-width in this-procedure
     2489                 (input  integer(v-resize-value-str)
     2490                 ,input  true
     2491                 ) .
     2492               assign
     2493                 v-restore-saved = true
     2494               .
     2495             end.
     2496           end.
     2497           if v-restore-saved <> true
     2498           then do:
     2499             if v-diasize-wndmax = true
     2500             then do:
     2501               run diasize_maximize in this-procedure
     2502                 (input  true
     2503                 ) .
     2504             end.
     2505           end.
     2506         end.
     2507         else do:
     2508           if v-diasize-wndmax = true
     2509           then do:
     2510             run diasize_maximize in this-procedure
     2511               (input  true
     2512               ) .
     2513           end.
     2514         end.
     2515       end.
     2516     end.
     2517   end procedure.
     2518   procedure diasize_need-full-display :
     2519     define output parameter p-need-full-display as logical   no-undo .
     2520     do
     2521     on error undo, return error return-value
     2522     :
     2523       assign
     2524         p-need-full-display = v-diasize-need-full-display
     2525       .
     2526       assign
     2527         v-diasize-need-full-display = false
     2528       .
     2529     end.
     2530   end procedure.
     2531   procedure get-context :
     2532      define output parameter p-db-num as integer          no-undo.
     2533      define output parameter p-user-id as character        no-undo.
     2534      define variable v-login               as character    no-undo.
     2535      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2536      define buffer buf_user-login  for ub.user-login .
     2537      do
     2538      on error undo, return error
     2539      :
     2540            FIND FIRST buf_sys-ctrl no-lock.
     2541            ASSIGN
     2542               v-login = USERID("ub")
     2543               p-db-num = buf_sys-ctrl.db-num
     2544            .
     2545            FIND FIRST buf_user-login
     2546                 WHERE buf_user-login.db-num = p-db-num
     2547                   AND buf_user-login.user-login = v-login
     2548                 no-lock
     2549                 no-error
     2550                 .
     2551            IF AVAILABLE buf_user-login
     2552            THEN DO:
     2553               assign
     2554                  p-user-id = buf_user-login.user-id
     2555               .
     2556            END.
     2557      end.
     2558   end procedure.
     2559       run diasize_init in this-procedure .
     2560   def var sort-labelbr-line   as character no-undo .
     2561   def var sort-clmnbr-line    as handle    no-undo .
     2562   def var cur-clmnbr-line     as handle    no-undo .
     2563   def var cur-clmn-locbr-line as integer   no-undo .
     2564   def var re-querybr-line     as logical   initial no no-undo .
     2565   on start-search, ctrl-o of br-line in frame Dialog-Frame do:
     2566      run sort-brbr-line
     2567        (input (if available tt-icnt-line
     2568                then recid(tt-icnt-line)
     2569                else ?
     2570               )
     2571        ).
     2572   end.
     2573   PROCEDURE sort-brbr-line :
     2574     define input parameter p-recid as recid no-undo .
     2575     if re-querybr-line = no then do:
     2576       assign
     2577          cur-clmnbr-line = br-line:current-column in frame Dialog-Frame
     2578       .
     2579       if sort-clmnbr-line <> ? then sort-clmnbr-line:column-fgcolor = 0.
     2580       if cur-clmnbr-line = sort-clmnbr-line then do:
     2581         assign
     2582            sort-labelbr-line = ""
     2583            sort-clmnbr-line = ?
     2584         .
     2585        end.
     2586        else do:
     2587          assign
     2588            sort-labelbr-line = cur-clmnbr-line:label
     2589            sort-clmnbr-line  = cur-clmnbr-line
     2590            sort-clmnbr-line:column-fgcolor = 4
     2591          .
     2592        end.
     2593      end.
     2594     assign
     2595       cur-clmn-locbr-line = 1
     2596     .
     2597     def var column-handle as handle no-undo .
     2598     column-handle = br-line:first-column.
     2599     do while valid-handle(column-handle) :
     2600       if column-handle = cur-clmnbr-line then do:
     2601         leave .
     2602       end.
     2603       column-handle = column-handle:NEXT-COLUMN.
     2604       assign
     2605         cur-clmn-locbr-line = cur-clmn-locbr-line + 1
     2606       .
     2607     end.
     2608     case sort-labelbr-line:
     2609           when 'ТРК'  then DO:   OPEN QUERY br-line                                             FOR EACH tt-icnt-line WHERE tt-icnt-line.doc-code = tt-icnt-doc.doc-code NO-LOCK,              FIRST buf_goods OUTER-JOIN NO-LOCK WHERE buf_goods.gds-code  = tt-icnt-line.gds-code BY tt-icnt-line.pump-code .   . END.
     2610           when 'Пис!то!лет'  then DO:   OPEN QUERY br-line                                             FOR EACH tt-icnt-line WHERE tt-icnt-line.doc-code = tt-icnt-doc.doc-code NO-LOCK,              FIRST buf_goods OUTER-JOIN NO-LOCK WHERE buf_goods.gds-code  = tt-icnt-line.gds-code BY tt-icnt-line.nozzle-code .   . END.
     2611           when 'Артикул'  then DO:   OPEN QUERY br-line                                             FOR EACH tt-icnt-line WHERE tt-icnt-line.doc-code = tt-icnt-doc.doc-code NO-LOCK,              FIRST buf_goods OUTER-JOIN NO-LOCK WHERE buf_goods.gds-code  = tt-icnt-line.gds-code BY buf_goods.artic .   . END.
     2612           when 'Кол-во!по!счетчику'  then DO:   OPEN QUERY br-line                                             FOR EACH tt-icnt-line WHERE tt-icnt-line.doc-code = tt-icnt-doc.doc-code NO-LOCK,              FIRST buf_goods OUTER-JOIN NO-LOCK WHERE buf_goods.gds-code  = tt-icnt-line.gds-code BY tt-icnt-line.state-el-cnt .   . END.
     2613           when 'Кол-во!по!мернику'  then DO:   OPEN QUERY br-line                                             FOR EACH tt-icnt-line WHERE tt-icnt-line.doc-code = tt-icnt-doc.doc-code NO-LOCK,              FIRST buf_goods OUTER-JOIN NO-LOCK WHERE buf_goods.gds-code  = tt-icnt-line.gds-code BY tt-icnt-line.state-mh-cnt .   . END.
     2614           when 'Разница'  then DO:   OPEN QUERY br-line                                             FOR EACH tt-icnt-line WHERE tt-icnt-line.doc-code = tt-icnt-doc.doc-code NO-LOCK,              FIRST buf_goods OUTER-JOIN NO-LOCK WHERE buf_goods.gds-code  = tt-icnt-line.gds-code BY (tt-icnt-line.state-el-cnt - tt-icnt-line.state-mh-cnt) .   . END.
     2615           when 'Название товара'  then DO:   OPEN QUERY br-line                                             FOR EACH tt-icnt-line WHERE tt-icnt-line.doc-code = tt-icnt-doc.doc-code NO-LOCK,              FIRST buf_goods OUTER-JOIN NO-LOCK WHERE buf_goods.gds-code  = tt-icnt-line.gds-code BY buf_goods.gds-name .   . END.
     2616           when 'Резервуар'  then DO:   OPEN QUERY br-line                                             FOR EACH tt-icnt-line WHERE tt-icnt-line.doc-code = tt-icnt-doc.doc-code NO-LOCK,              FIRST buf_goods OUTER-JOIN NO-LOCK WHERE buf_goods.gds-code  = tt-icnt-line.gds-code BY tt-icnt-line.pl-code .   . END.
     2617       otherwise do:
     2618         run Openbr in this-procedure .
     2619           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-line') then do:
     2620             run mv-brw-defaultbr-line.
     2621           end.
     2622         if sort-labelbr-line <> "" then do:
     2623           assign
     2624             cur-clmnbr-line:column-fgcolor = 0
     2625           .
     2626         end.
     2627         assign
     2628           cur-clmn-locbr-line = ?
     2629         .
     2630       end.
     2631     end case.
     2632       if cur-clmn-locbr-line <> ? then do:
     2633         if can-do( this-procedure:internal-entries, 'ch-clmnbr-line') then do:
     2634           run ch-clmnbr-line in this-procedure (cur-clmn-locbr-line).
     2635         end.
     2636       end.
     2637     if p-recid <> ? then do:
     2638       reposition br-line to recid p-recid no-error.
     2639       apply "value-changed" to br-line in frame Dialog-Frame.
     2640     end.
     2641     apply "entry" to br-line in frame Dialog-Frame.
     2642   END PROCEDURE.
     2643   procedure re-open-query-srt-clmnbr-line:
     2644   if cur-clmnbr-line = ? then do:
     2645      run Openbr in this-procedure .
     2646   end.
     2647   else do:
     2648      assign re-querybr-line = yes.
     2649      run sort-brbr-line
     2650        (input (if available tt-icnt-line
     2651                then recid(tt-icnt-line)
     2652                else ?
     2653               )
     2654        ).
     2655      assign re-querybr-line = no.
     2656   end.
     2657   end.
     2658   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2659   on F9 of frame Dialog-Frame anywhere do:
     2660     run get-gds-rec.
     2661     if gds-rec = ? then
     2662       return no-apply.
     2663     run ref/gds-form.w ( input parparentproc
     2664                         ,input 'ПРОСМОТР':U
     2665                         ,input ?
     2666                         ,input ?
     2667                         ,input ?
     2668                         ,input-output gds-rec).
     2669     apply "entry" to br-line in frame Dialog-Frame.
     2670     return no-apply.
     2671   end.
     2672   p-next-prev = '':U.
     2673   v-mode = p-mode.
     2674   n-p:
     2675   do while p-next-prev = '':U :
     2676     MAIN-BLOCK:
     2677     DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2678        ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2679   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2680     run mainmenu_getcntxt in parparentproc
     2681       (output v-cntxt-db-num
     2682       ,output v-cntxt-userid
     2683       ,output v-cntxt-level
     2684       ,output v-cntxt-host-code-obj
     2685       ,output v-cntxt-obj-type
     2686       ,output v-cntxt-obj-code
     2687       ,output v-cntxt-db-num-obj
     2688       ,output v-cntxt-is-admin
     2689       ) .
     2690        if LOOKUP(p-mode, ('ИЗМЕНЕНИЕ':U  + chr(4) + 'ДОБАВЛЕНИЕ':U + chr(4) + 'ПРОСМОТР':U), chr(4) ) = 0 then do:
     2691             message
     2692             vss-workfile vss-revision vss-description skip
     2693             substitute("Неверный параметр вызова p-mode=&1", p-mode)
     2694             view-as alert-box ERROR.
     2695             undo, return error.
     2696         end.
     2697         if p-obj-type <> 'маг':U then DO:
     2698             message
     2699             vss-workfile vss-revision vss-description skip
     2700             substitute("Неверный параметр вызова p-obj-type=&1", p-obj-type)
     2701             view-as alert-box ERROR.
     2702             undo, return error.
     2703         end.
     2704         FIND FIRST buf_clients NO-LOCK WHERE
     2705                   buf_Clients.obj-type = p-obj-type
     2706              AND buf_clients.obj-code = p-obj-code NO-ERROR.
     2707         IF NOT AVAILABLE buf_clients THEN DO:
     2708           MESSAGE
     2709           substitute("Неверное значение параметров p-obj-type = &1 и/или p-obj-code=&2"
     2710                     , p-obj-type
     2711                     , p-obj-code)
     2712           VIEW-AS ALERT-BOX ERROR.
     2713           UNDO, RETURN ERROR.
     2714         END.
     2715   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2716   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2717     (input  p-obj-type
     2718     ,input  p-obj-code
     2719     ,output v-host-code
     2720     )  .
     2721         if not p-mode = 'ПРОСМОТР':U THEN DO:
     2722            p-next-prev = '':U.
     2723           IF buf_clients.db-num <> v-cntxt-db-num THEN DO:
     2724               MESSAGE
     2725               substitute("Неверное значение параметров p-obj-type = &1 и/или p-obj-code=&2&3" +
     2726                         "Добавление и изменение документа счетчиков ТРК возможно только в БД объекта&3" +
     2727                         "БД для &1&2 - &4, текущая БД - &5"
     2728                         , p-obj-type
     2729                         , p-obj-code
     2730                         , chr(10)
     2731                         , buf_clients.db-num
     2732                         , v-cntxt-db-num)
     2733               VIEW-AS ALERT-BOX ERROR.
     2734               UNDO, RETURN ERROR.
     2735           END.
     2736         END.
     2737         if p-mode <> 'ПРОСМОТР':U then do:
     2738           p-next-prev = "quit".
     2739         end.
     2740         run fill-tables in this-procedure no-error.
     2741         if error-status:error then return error.
     2742         RUN Myenable IN THIS-PROCEDURE.
     2743         IF new-opened THEN DO:
     2744   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2745   DEF VAR cur-clmn-numbr-line as INT EXTENT 9 no-undo.
     2746   DEF VAR varmvibr-line       as INT no-undo.
     2747   DEF VAR varmvjbr-line       as INT no-undo.
     2748   DEF VAR varmvkbr-line       as INT no-undo.
     2749   DEF VAR varmvlbr-line       as INT no-undo.
     2750   DEF VAR move-elementbr-line as INT no-undo.
     2751   def var jjbr-line           as int no-undo.
     2752   do varmvibr-line = 1 to EXTENT(cur-clmn-numbr-line):
     2753     ASSIGN cur-clmn-numbr-line[varmvibr-line] = varmvibr-line.
     2754   END.
     2755   RUN start-mv-clmnbr-line.
     2756   PROCEDURE start-mv-clmnbr-line:
     2757   def var old-session as logical no-undo.
     2758      old-session = SESSION:IMMEDIATE-DISPLAY.
     2759      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2760      SESSION:IMMEDIATE-DISPLAY = old-session.
     2761   END.
     2762   ON ctrl-cursor-right OF BROWSE br-line do:
     2763     RUN re-move-clmnbr-line ( 4, 9).
     2764   END.
     2765   ON ctrl-cursor-left OF BROWSE br-line do:
     2766     RUN re-move-clmnbr-line (9, 4).
     2767   END.
     2768   PROCEDURE re-move-clmnbr-line:
     2769     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2770     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2771     DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
     2772       if cur-clmn-numbr-line[varmvibr-line] = source-column THEN cur-clmn-numbr-line[varmvibr-line] = -1.
     2773     END.
     2774     if br-line:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     2775     if source-column > target-column THEN
     2776     DO varmvjbr-line = source-column - 1 to target-column BY -1:
     2777       DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
     2778           if cur-clmn-numbr-line[varmvibr-line] = varmvjbr-line THEN DO:
     2779             cur-clmn-numbr-line[varmvibr-line] = cur-clmn-numbr-line[varmvibr-line] + 1.
     2780           END.
     2781       END.
     2782     END.
     2783     ELSE
     2784     DO varmvjbr-line = source-column + 1 to target-column:
     2785       DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
     2786         if cur-clmn-numbr-line[varmvibr-line] = varmvjbr-line THEN DO:
     2787           cur-clmn-numbr-line[varmvibr-line] = cur-clmn-numbr-line[varmvibr-line] - 1.
     2788         END.
     2789       END.
     2790     END.
     2791     DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
     2792       if cur-clmn-numbr-line[varmvibr-line] = -1 THEN cur-clmn-numbr-line[varmvibr-line] = target-column.
     2793     END.
     2794   END PROCEDURE.
     2795   PROCEDURE ch-clmnbr-line:
     2796     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2797     if cur-clmn-loc <= 4 then do:
     2798       return .
     2799     end.
     2800     DO varmvibr-line = 1 TO EXTENT(cur-clmn-numbr-line):
     2801       if cur-clmn-numbr-line[varmvibr-line] = cur-clmn-loc THEN move-elementbr-line = varmvibr-line.
     2802     END.
     2803     RUN re-move-clmnbr-line (cur-clmn-loc, 4).
     2804   END PROCEDURE.
     2805   PROCEDURE mv-brw-defaultbr-line:
     2806   def var old-session as logical no-undo.
     2807     old-session = SESSION:IMMEDIATE-DISPLAY.
     2808     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2809     do varmvlbr-line = 4 to EXTENT(cur-clmn-numbr-line):
     2810       RUN re-move-clmnbr-line (cur-clmn-numbr-line[varmvlbr-line], varmvlbr-line).
     2811     END.
     2812     RUN start-mv-clmnbr-line.
     2813     SESSION:IMMEDIATE-DISPLAY = old-session.
     2814   END PROCEDURE.
     2815   .
     2816           new-opened = no.
     2817         END.
     2818         WAIT-FOR GO OF FRAME Dialog-Frame.
     2819       END.
     2820   END.
     2821   RUN disable_UI.
     2822   PROCEDURE disable_UI :
     2823     HIDE FRAME Dialog-Frame.
     2824   END PROCEDURE.
     2825   PROCEDURE display-value :
     2826   display
     2827   tt-icnt-doc.state-el-cnt
     2828   tt-icnt-doc.state-mh-cnt
     2829   (tt-icnt-doc.state-el-cnt - tt-icnt-doc.state-mh-cnt) @ v-delta
     2830   with frame Dialog-Frame.
     2831   END PROCEDURE.
     2832   PROCEDURE enable_UI :
     2833     DISPLAY wrkr-name agnt-name boss-name v-delta
     2834         WITH FRAME Dialog-Frame.
     2835     IF AVAILABLE buf_clients THEN
     2836       DISPLAY buf_clients.obj-name
     2837         WITH FRAME Dialog-Frame.
     2838     IF AVAILABLE tt-icnt-doc THEN
     2839       DISPLAY tt-icnt-doc.doc-date tt-icnt-doc.fact-date tt-icnt-doc.shift-date
     2840             tt-icnt-doc.shift-num tt-icnt-doc.shift-name tt-icnt-doc.wrkr
     2841             tt-icnt-doc.agnt tt-icnt-doc.boss tt-icnt-doc.obj-code
     2842             tt-icnt-doc.obj-type tt-icnt-doc.state-el-cnt tt-icnt-doc.state-mh-cnt
     2843         WITH FRAME Dialog-Frame.
     2844     ENABLE B-exit b-quit b-prev b-next b-chk B-notes B-hist B-Help
     2845            tt-icnt-doc.doc-date tt-icnt-doc.fact-date tt-icnt-doc.shift-date
     2846            tt-icnt-doc.shift-num tt-icnt-doc.shift-name tt-icnt-doc.wrkr r-wrkr
     2847            tt-icnt-doc.agnt r-agnt tt-icnt-doc.boss r-boss B-add b-del br-line
     2848            tt-icnt-doc.obj-code tt-icnt-doc.obj-type buf_clients.obj-name
     2849            wrkr-name tt-icnt-doc.state-el-cnt agnt-name tt-icnt-doc.state-mh-cnt
     2850            boss-name v-delta
     2851         WITH FRAME Dialog-Frame.
     2852     VIEW FRAME Dialog-Frame.
     2853     OPEN QUERY br-line FOR EACH tt-icnt-line NO-LOCK WHERE     tt-icnt-line.doc-code = tt-icnt-doc.doc-code ,                     FIRST buf_goods OUTER-JOIN WHERE             buf_goods.gds-code        = tt-icnt-line.gds-code NO-LOCK.
     2854   END PROCEDURE.
     2855   PROCEDURE fill-tables :
     2856   define variable v-today as date      no-undo.
     2857   FOR EACH tt-icnt-line:
     2858       DELETE tt-icnt-line.
     2859   END.
     2860   FOR EACH tt-icnt-doc:
     2861       DELETE tt-icnt-doc.
     2862   END.
     2863   IF p-mode = 'ДОБАВЛЕНИЕ':U then do:
     2864       tr:
     2865       do transaction on error undo tr, return error return-value
     2866                      on stop  undo tr, return error return-value
     2867                      on quit  undo tr, return error return-value :
     2868          run waitfram-show in this-procedure ( INPUT "Создаем документ." ).
     2869          create tt-icnt-doc.
     2870   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2871   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     2872     (input  p-obj-type
     2873     ,input  p-obj-code
     2874     ,output v-today
     2875     )  .
     2876          assign
     2877          tt-icnt-doc.ext-doc-type = 'em':U
     2878          tt-icnt-doc.doc-type  = 'сч-трк-погр':U
     2879          tt-icnt-doc.host-code = v-host-code
     2880          tt-icnt-doc.obj-type  = p-obj-type
     2881          tt-icnt-doc.obj-code  = p-obj-code
     2882          tt-icnt-doc.status_   = 'новый':U
     2883          tt-icnt-doc.flag_     = no
     2884          tt-icnt-doc.creid     = v-cntxt-userid
     2885          tt-icnt-doc.PS        = "@"
     2886          tt-icnt-doc.doc-date  = v-today
     2887          .
     2888          run waitfram-hide in this-procedure .
     2889      end.
     2890      run get-pump-from-chk-doc IN THIS-PROCEDURE NO-ERROR.
     2891      IF ERROR-STATUS:ERROR  THEN undo, RETURN ERROR.
     2892   END.
     2893   ELSE DO:
     2894     if p-mode = 'ПРОСМОТР':U then do:
     2895       FIND FIRST locked_icnt-doc NO-LOCK WHERE
     2896                   recid(locked_icnt-doc) = p-recid.
     2897     end.
     2898     ELSE do:
     2899       DO TRANSACTION
     2900         ON ERROR UNDO, RETURN ERROR:
     2901         FIND FIRST locked_icnt-doc EXCLUSIVE-LOCK WHERE
     2902                    recid(locked_icnt-doc) = p-recid.
     2903       END.
     2904     END.
     2905     IF NOT AVAIL locked_icnt-doc THEN return error.
     2906     if locked_icnt-doc.status_ = 'факт':U and p-mode <> 'ПРОСМОТР':U then do:
     2907        message
     2908        substitute("Документ счетчиков ТРК &1 закрыт до статуса &2&3Изменения не допускаются"
     2909                   ,locked_icnt-doc.doc-code
     2910                   ,LOCKED_icnt-doc.STATUS_
     2911                   , chr(10)
     2912                   )
     2913        view-as alert-box error.
     2914        return error.
     2915     end.
     2916     CREATE tt-icnt-doc.
     2917     BUFFER-COPY LOCKED_icnt-doc TO tt-icnt-doc.
     2918     FOR EACH LOCKED_icnt-line NO-LOCK WHERE
     2919             LOCKED_icnt-line.doc-code = LOCKED_icnt-doc.doc-code:
     2920        CREATE tt-icnt-line.
     2921        BUFFER-COPY LOCKED_icnt-line TO tt-icnt-line.
     2922     END.
     2923   END.
     2924   END PROCEDURE.
     2925   PROCEDURE get-gds-rec :
     2926   IF AVAILABLE buf_goods then
     2927   gds-rec = recid(buf_goods).
     2928   ELSE BELL.
     2929   END PROCEDURE.
     2930   PROCEDURE get-pump-from-chk-doc :
     2931   define buffer buf_tt-icnt-line for tt-icnt-line.
     2932   define variable varcur-pump as logical no-undo.
     2933   define variable varnum      as integer no-undo.
     2934   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     2935   DEFINE VARIABLE v-ii AS INTEGER NO-UNDO.
     2936   define variable v-loc-ptrlcheck as character no-undo .
     2937   define buffer buf_chk-doc for ub.chk-doc.
     2938   ASSIGN
     2939   v-rid-list = "":U.
     2940   run str/chk-docs.w (
     2941                    input parparentproc
     2942                   ,INPUT  'b-sel,b-mark':U
     2943                   ,INPUT "to-" + 'сч-трк-погр':U
     2944                   ,INPUT ?
     2945                   ,INPUT tt-icnt-doc.obj-type
     2946                   ,INPUT tt-icnt-doc.obj-code
     2947                   ,INPUT tt-icnt-doc.doc-code
     2948                   ,INPUT '':U
     2949                   ,input 0
     2950                   ,INPUT tt-icnt-doc.doc-date
     2951                   ,INPUT ?
     2952                   ,input 0
     2953                   ,output v-rid-list) no-error.
     2954    IF v-rid-list = "":U  THEN DO:
     2955      RETURN error.
     2956    END.
     2957   _ii:
     2958   DO v-ii = 1 TO NUM-ENTRIES(v-rid-list)
     2959   on error undo _ii, next _ii
     2960   :
     2961     FIND FIRST buf_chk-doc no-LOCK WHERE
     2962            RECID(buf_chk-doc) = INTEGER(ENTRY(v-ii, v-rid-list)) NO-ERROR.
     2963     IF ERROR-STATUS:ERROR THEN DO:
     2964     END.
     2965     v-loc-ptrlcheck = v-ptrlcheck.
     2966     run add-icnt-line-err IN THIS-PROCEDURE (
     2967                                                input p-mode
     2968                                               ,input buf_chk-doc.doc-code
     2969                                               ,input tt-icnt-doc.doc-code
     2970                                               ,INPuT tt-icnt-doc.doc-date
     2971                                               ,INPUT tt-icnt-doc.obj-type
     2972                                               ,INPUT tt-icnt-doc.obj-code
     2973                                               ,input-output v-loc-ptrlcheck
     2974                                               ,BUFFER buf_tt-icnt-line) NO-ERROR.
     2975     IF ERROR-STATUS:ERROR THEN DO:
     2976        MESSAGE
     2977        "Ошибка при добавлении строки в документ" SKIP
     2978        ERROR-STATUS:GET-MESSAGE(1) SKIP
     2979        RETURN-VALUE SKIP
     2980        VIEW-AS ALERT-BOX ERROR.
     2981        UNDO _ii, next _ii.
     2982     END.
     2983     v-ptrlcheck = v-loc-ptrlcheck.
     2984   END.
     2985   do transaction on error undo, return error :
     2986     RUN recalc-icnt IN THIS-PROCEDURE NO-ERROR.
     2987   end.
     2988   END PROCEDURE.
     2989   PROCEDURE local-psn-chk :
     2990   define input parameter p-man    as character no-undo.
     2991   define input parameter p-action as character no-undo.
     2992   DEFINE VARIABLE ref-list AS CHARACTER NO-UNDO.
     2993   if p-man = "wrkr" and p-action = "ret-mouse" then do:
     2994     define variable v-ref-rec18   as recid no-undo .
     2995     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-icnt-doc.wrkr
     2996                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     2997     if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then do:
     2998       if input frame Dialog-Frame tt-icnt-doc.wrkr <> ""
     2999          and input frame Dialog-Frame tt-icnt-doc.wrkr <> ? then
     3000         message "Из справочника клиентов Вы должны выбрать человека.".
     3001       run ref/cli-all.w (  input parparentproc
     3002                     ,  input "b-sel"
     3003                     ,  input 'чел':U
     3004                     ,  input ?
     3005                     ,  input ?
     3006                     ,  input v-ref-rec
     3007                     ,  input ",,,,,,NO"
     3008                     ,  input "lock-cli-type"
     3009                     , output ref-list ) .
     3010       assign v-ref-rec18 = integer( ref-list ).
     3011       v-ref-rec = integer( ref-list ) .
     3012       find cli-buf where recid (cli-buf) =
     3013          v-ref-rec
     3014          no-lock no-error.
     3015       if not available cli-buf or ( NOT can-do( 'чел':U, cli-buf.obj-type ) ) then
     3016         find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-icnt-doc.wrkr
