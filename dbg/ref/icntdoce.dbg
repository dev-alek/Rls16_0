     1017   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     1018   DO:
     1019   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     1020   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1021   if lookup(self :type
     1022            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1023            ) = 0
     1024   then do:
     1025     message
     1026       "$Workfile$"
     1027       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1028       "Интерфейсный элемент" self :name  skip
     1029       "Тип" self :type  skip
     1030       "Процедура" this-procedure :file-name skip
     1031       view-as alert-box .
     1032   end.
     1033   else do:
     1034     apply "entry":u to self  .
     1035     if focus :handle <> self :handle  then do:
     1036       return no-apply .
     1037     end.
     1038   end.
     1039     if p-mode = 'ПРОСМОТР':U then.
     1040     else do:
     1041       if p-mode = 'ИЗМЕНЕНИЕ':U  OR
     1042       p-mode = 'ДОБАВЛЕНИЕ':U then do:
     1043       if not can-find (first tt-icnt-line where tt-icnt-line.doc-code = tt-icnt-doc.doc-code no-lock) then do:
     1044         glog = yes.
     1045         message
     1046         "В документе нет строк, поэтому он удаляется."
     1047         view-as alert-box
     1048         question buttons OK-Cancel update glog.
     1049         if glog then do:
     1050           if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     1051             delete LOCKED_icnt-doc.
     1052             assign p-recid = ?.
     1053             return.
     1054           end.
     1055           else do:
     1056             assign p-recid = ?.
     1057             return.
     1058           end.
     1059         end.
     1060         else return no-apply.
     1061       end.
     1062       run proc-save IN THIS-PROCEDURE NO-ERROR.
     1063       IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1064     end.
     1065   end.
     1066   END.
