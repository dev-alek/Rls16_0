        1   DEFINE BUFFER buf_clients FOR ub.clients.
        2   DEFINE BUFFER buf_goods FOR ub.goods.
        3   DEFINE BUFFER locked_icnt-doc FOR ub.icnt-doc.
        4   DEFINE BUFFER locked_icnt-line FOR ub.icnt-line.
        5   DEFINE TEMP-TABLE tt-icnt-doc NO-UNDO LIKE ub.icnt-doc.
        6   DEFINE TEMP-TABLE tt-icnt-line NO-UNDO LIKE ub.icnt-line.
        7   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        8   DEFINE INPUT PARAMETER p-mode AS character NO-UNDO.
        9   DEFINE INPUT PARAMETER p-obj-type AS character NO-UNDO.
       10   DEFINE INPUT PARAMETER p-obj-code AS integer NO-UNDO.
       11   DEFINE INPUT-OUTPUT PARAMETER p-recid AS recid NO-UNDO.
       12   DEFINE INPUT-OUTPUT PARAMETER p-icnt-line-rec AS recid NO-UNDO.
       13   define input parameter p-call-prog as handle no-undo .
       14   define input-output parameter p-next-prev as CHARACTER no-undo .
       15   define variable vss-revision    as character no-undo init "$Revision$":U .
       16   define variable vss-author      as character no-undo init "$Author$":U .
       17   define variable vss-date        as character no-undo init "$Date$":U .
       18   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       19   define variable vss-archive     as character no-undo init "$Archive$":U .
       20   define variable vss-description as character no-undo init "Форма редактирования документа измерения погрешности счетчиков ТРК".
       21   procedure vss-get-info :
       22     define output parameter p-vss-revision    like vss-revision    no-undo .
       23     define output parameter p-vss-author      like vss-author      no-undo .
       24     define output parameter p-vss-date        like vss-date        no-undo .
       25     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       26     define output parameter p-vss-archive     like vss-archive     no-undo .
       27     define output parameter p-vss-description like vss-description no-undo .
       28     assign
       29       p-vss-revision    = vss-revision
       30       p-vss-author      = vss-author
       31       p-vss-date        = vss-date
       32       p-vss-workfile    = vss-workfile
       33       p-vss-archive     = vss-archive
       34       p-vss-description = vss-description
       35     .
       36   end procedure.
       37   procedure vss-get-parameters :
       38     define output parameter p-vss-parameters as character no-undo .
       39   end procedure.
       40   define new global shared variable g#vssrevis-logger as handle    no-undo .
       41   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       42   define variable v-vssrevis-logger                   as handle    no-undo .
       43   procedure vss-logevent :
       44     define input  parameter p-extra-paramters as character no-undo .
       45     define variable v-vssrevis-parameters as character no-undo .
       46     do
       47     on error undo, return error return-value
       48     :
       49       if  valid-handle(v-vssrevis-logger)
       50       and v-vssrevis-logger :get-signature("logevent") <> ""
       51       then do:
       52         run vss-get-parameters in this-procedure
       53           (output v-vssrevis-parameters
       54           ).
       55         run logevent in v-vssrevis-logger
       56           (input vss-workfile
       57           ,input vss-revision
       58           ,input v-vssrevis-parameters
       59           ,input p-extra-paramters
       60           ).
       61       end.
       62     end.
       63   end procedure.
       64   assign
       65     v-vssrevis-logger = g#vssrevis-logger
       66   .
       67   if  valid-handle(v-vssrevis-logger)
       68   and v-vssrevis-logger :get-signature("logevent") <> ""
       69   then do:
       70     assign
       71       v-vssrevis-logevent = true
       72     .
       73     run vss-logevent in this-procedure (input vss-description) .
       74   end.
       75   define new global shared variable g#language as character no-undo .
       76   if g#language <> '' and g#language <> 'rus':U then do:
       77     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       78   end.
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   define variable v-waitfram-action01         as character   no-undo .
       81   define variable v-waitfram-action02         as character   no-undo .
       82   define variable v-waitfram-action03         as character   no-undo .
       83   define variable mWaitFramTextBeg            as character   no-undo.
       84   define variable mWaitFramTextEnd            as character   no-undo.
       85   define variable mWaitFramView               as logical     no-undo.
       86   define variable mWaitProcEvent              as logical     no-undo init yes.
       87   define variable mWaitFramInterval           as integer     no-undo init 1 .
       88   define variable mWaitFramStop               as logical     no-undo.
       89   define variable mWaitFramStopUser           as logical     no-undo.
       90   define variable mWaitFramStopTimeOut        as logical     no-undo.
       91   define variable mWaitFramStartProc          as datetime-tz no-undo.
       92   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       93   define button B-WaitFramStop auto-end-key
       94        label "Стоп"
       95        size 10 by 1 tooltip "Остоновить процесс".
       96   define button B-viewProcInfo
       97        label "Информация"
       98        size 15 by 1 tooltip "Информация о процесс".
       99   define frame waitfram
      100     v-waitfram-action01 format "x(72)" no-label skip
      101     v-waitfram-action02 format "x(72)" no-label skip
      102     v-waitfram-action03 format "x(72)" no-label skip
      103     B-viewProcInfo
      104     B-WaitFramStop at row 4 col 30
      105     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      106     .
      107   define new global shared variable mBatchMode as logical no-undo init ?.
      108   define variable mFramBachModHandle as handle no-undo.
      109   mFramBachModHandle = frame waitfram:handle.
      110   define variable mFameOldVis as logical no-undo.
      111   define variable mVisCUrentVin as logical no-undo.
      112   if session:batch-mode
      113   then
      114      mBatchMode = yes.
      115   if mBatchMode = ? then do:
      116     mVisCUrentVin = current-window:visible.
      117     mFameOldVis = mFramBachModHandle:visible.
      118     mFramBachModHandle:visible  = yes.
      119     mBatchMode = mFramBachModHandle:visible ne yes.
      120     mFramBachModHandle:visible = mFameOldVis.
      121     current-window:visible = mVisCUrentVin.
      122   end.
      123    if  log-manager:logfile-name ne ?
      124     then DO:
      125         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      126         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      127         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      128     end.
      129   on choose of B-WaitFramStop in frame waitfram
      130   do:
      131     mWaitFramStop = yes.
      132     mWaitFramStopUser = yes.
      133   end.
      134   function waitfram-check-timeout returns logical():
      135      define variable vtime as int64 no-undo.
      136      if mWaitFramStopTimeOut
      137      then
      138         return yes.
      139      vtime = ( now - mWaitFramStartProc ) / 1000 .
      140      if     mWaitFramTimeOut ne ?
      141         and mWaitFramTimeOut ne 0
      142         and mWaitFramTimeOut lt vtime
      143      then do:
      144         mWaitFramStopTimeOut = yes.
      145      end.
      146      return mWaitFramStopTimeOut.
      147   end.
      148   procedure waitfram-hide :
      149     if not session:batch-mode
      150     then do
      151     on error undo, return error return-value
      152     :
      153       pause 0 before-hide .
      154       if not mBatchMode then
      155         hide frame waitfram .
      156     if     not mWaitFramView
      157        and mWaitProcEvent
      158     then
      159       process events .
      160     end.
      161   end procedure.
      162   procedure waitfram-show :
      163     define input  parameter p-message as character no-undo .
      164     define variable v-left-margin as integer   no-undo .
      165     if not session:batch-mode
      166     then do
      167     on error undo, return error return-value
      168     :
      169       if length(p-message) <= 70 then do:
      170         assign
      171           v-left-margin = integer((70 - length(p-message)) / 2)
      172         .
      173         assign
      174           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      175         .
      176         assign
      177           v-waitfram-action01 = " "
      178           v-waitfram-action02 = " "
      179                                    + fill(" ", v-left-margin)
      180                                    + p-message
      181           v-waitfram-action03 = " "
      182         .
      183       end.
      184       else do:
      185         define variable vRindex1 as integer no-undo.
      186         define variable vRindex2 as integer no-undo.
      187         vRindex1 = r-index(p-message," ",70).
      188         if vRindex1 = 0
      189         then
      190            vRindex1 = 70.
      191         if length(p-message)  <= vRindex1 + 70 then do:
      192           assign
      193             v-waitfram-action01 = " "
      194             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      195             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      196           .
      197         end.
      198         else do:
      199           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      200           if vRindex2 <= vRindex1
      201           then
      202              vRindex2 = vRindex1 + 70.
      203           assign
      204             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      205             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      206             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      207           .
      208         end.
      209       end.
      210       B-viewProcInfo:visible   in frame waitfram = no.
      211       B-viewProcInfo:sensitive in frame waitfram = no.
      212       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      213       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      214       if  (   mWaitFramView
      215          or  mWaitProcEvent)
      216          and not mBatchMode
      217       then
      218          display
      219             v-waitfram-action01 skip
      220             v-waitfram-action02 skip
      221             v-waitfram-action03 skip
      222          with frame waitfram .
      223       if     mWaitFramView
      224          then do:
      225             if     mWaitFramInterval ne ?
      226                and not mBatchMode
      227             then
      228                wait-for go of frame waitfram pause mWaitFramInterval.
      229          end.
      230          else
      231             if     mWaitProcEvent
      232                and not mBatchMode
      233             then
      234                process events .
      235     end.
      236   end procedure.
      237      procedure waitfram-show-this:
      238         define input  parameter iInterval as int64 no-undo.
      239         define variable vtime as int64 no-undo.
      240         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      241         mWaitFramInterval = iInterval.
      242         run waitfram-show (substitute("&1&2 &3&4" ,
      243                                       mWaitFramTextBeg ,
      244                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      245                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      246                                       mWaitFramTextEnd
      247                                      )
      248                           ).
      249      end.
      250      procedure WaitFramRunPause:
      251         define input  parameter iInterval as dec no-undo.
      252         define variable vStart  as datetime-tz no-undo.
      253         define variable vend    as datetime-tz no-undo.
      254         define variable vint as int64 no-undo.
      255         define variable vOk as logical no-undo.
      256         vStart = now.
      257         vend   = vStart.
      258         publish "WaitFramPause" (iInterval,output vOk).
      259         vend   =  now.
      260         vint = vend - vStart.
      261         vint = iInterval - vint / 1000.
      262         if     not mWaitFramStop
      263            and (   vint > 0
      264                 or (    not vOk
      265                     and iInterval eq ?
      266                     )
      267                 )
      268         then
      269            run waitfram-show-this (iInterval).
      270         vend   =  now.
      271         vint = vend - vStart.
      272         vint = iInterval - vint / 1000.
      273         if     not mWaitFramStop
      274            and vint > 0
      275         then do:
      276            run gbl/pause.p (vint * 1000).
      277         end.
      278         if iInterval ne ?
      279         then
      280            publish "WaitFramStop".
      281         waitfram-check-timeout().
      282      end.
      283      procedure WaitFramWaitFor:
      284         define input  parameter iInterval as dec no-undo.
      285         assign
      286            mWaitFramStartProc   = now
      287            mWaitFramStopUser    = no
      288            mWaitFramStopTimeOut = no
      289         .
      290         block-wait:
      291         do while not mWaitFramStop:
      292            run WaitFramRunPause (iInterval).
      293            if  waitfram-check-timeout()
      294            then do:
      295               leave block-wait.
      296            end.
      297         end.
      298         run waitfram-hide.
      299      end.
      300   procedure waitfram-join :
      301     define input  parameter p-line-1  as character no-undo .
      302     define input  parameter p-line-2  as character no-undo .
      303     define input  parameter p-line-3  as character no-undo .
      304     define output parameter p-message as character no-undo .
      305     do
      306     on error undo, return error return-value
      307     :
      308       assign
      309         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      310                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      311                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      312       .
      313     end.
      314   end procedure.
      315   function waitfram-join-function returns character
      316     (input p-line-1 as character
      317     ,input p-line-2 as character
      318     ,input p-line-3 as character
      319     ).
      320     define variable v-message as character no-undo .
      321     run waitfram-join in this-procedure
      322       (input  p-line-1
      323       ,input  p-line-2
      324       ,input  p-line-3
      325       ,output v-message
      326       ) .
      327     return v-message .
      328   end function .
      329   define new global shared variable g#library  as handle no-undo .
      330   define new global shared variable g#library2 as handle no-undo .
      331   procedure proc-alt-shift-f2:
      332     if not ibs.th.gbl.gbl-var:rcode
      333   then
      334     run gbl\inidebug.p .
      335   end.
      336   procedure proc-alt-shift-f3:
      337     run gbl/prvssinf.p
      338       ( input this-procedure
      339       ) .
      340   end.
      341   define variable v-inform-launched as logical no-undo initial false .
      342   procedure proc-alt-shift-f4:
      343     define variable v-action as character no-undo .
      344     if v-inform-launched = false then do:
      345       assign
      346         v-inform-launched = true
      347       .
      348       run gbl/d-inform.w
      349         (  input self
      350         ,  input this-procedure
      351         , output v-action
      352         ) no-error .
      353       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      354       assign
      355         v-inform-launched = false
      356       .
      357     end.
      358   end.
      359   procedure proc-alt-f1:
      360     run gbl/corrhelp.p
      361       (input this-procedure
      362       ) .
      363   end .
      364   on alt-shift-f2 anywhere do:
      365     run proc-alt-shift-f2.
      366   end.
      367   on alt-shift-f3 anywhere do:
      368     run proc-alt-shift-f3 in this-procedure .
      369   end.
      370   on alt-shift-f4 anywhere do:
      371     run proc-alt-shift-f4 in this-procedure.
      372   end.
      373   on alt-f1 anywhere do:
      374     run proc-alt-f1 in this-procedure .
      375   end.
      376   define new global shared variable g#lib-trn  as handle no-undo .
      377   define new global shared variable g#lib-trn2 as handle no-undo .
      378   define new global shared variable g#lib-trn3 as handle no-undo .
      379   define new global shared variable g#lib-trn4 as handle no-undo .
      380   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      381     define variable v-cntxt-db-num        as integer   no-undo .
      382     define variable v-cntxt-userid        as character no-undo .
      383     define variable v-cntxt-level         as character no-undo .
      384     define variable v-cntxt-host-code-obj as integer   no-undo .
      385     define variable v-cntxt-obj-type      as character no-undo .
      386     define variable v-cntxt-obj-code      as integer   no-undo .
      387     define variable v-cntxt-db-num-obj    as integer   no-undo .
      388     define variable v-cntxt-is-admin      as logical   no-undo .
      389   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      390   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      391   procedure findtank:
      392     define input  parameter p-obj-type     as character no-undo.
      393     define input  parameter p-obj-code     as integer   no-undo.
      394     define input  parameter p-pump-code    as integer   no-undo.
      395     define input  parameter p-nozzle-code  as integer   no-undo .
      396     define input  parameter p-from-pl-code as integer   no-undo .
      397     define input  parameter p-gds-code     as integer   no-undo.
      398     define output parameter p-pl-code      as integer   no-undo .
      399     define variable v-pl-code            like ub.place.pl-code no-undo .
      400     define variable v-dopstr             as character no-undo .
      401     define buffer buf_place for ub.place.
      402     define buffer buf_pl-gds-pump for ub.pl-gds-pump.
      403     define buffer buf_pl-pump-nozzle for ub.pl-pump-nozzle.
      404     define buffer buf_pl-gds for ub.pl-gds.
      405     do
      406     on error undo, return error return-value
      407     :
      408       assign
      409         v-pl-code = 0
      410         p-pl-code = ?
      411       .
      412       if p-from-pl-code <> ?
      413         and p-from-pl-code <> 0
      414       then do:
      415         find first buf_pl-gds no-lock
      416           where buf_pl-gds.obj-type  = p-obj-type
      417             and buf_pl-gds.obj-code  = p-obj-code
      418             and buf_pl-gds.pl-code   = p-from-pl-code
      419             and buf_pl-gds.gds-code  = p-gds-code
      420           no-error.
      421         if available buf_pl-gds then do:
      422           assign
      423             v-pl-code = buf_pl-gds.pl-code
      424           .
      425         end.
      426       end.
      427       if v-pl-code <> 0
      428         and p-nozzle-code <> ?
      429         and p-nozzle-code <> 0
      430       then do:
      431         find first buf_pl-pump-nozzle no-lock
      432           where buf_pl-pump-nozzle.obj-type    = p-obj-type
      433             and buf_pl-pump-nozzle.obj-code    = p-obj-code
      434             and buf_pl-pump-nozzle.pl-code     = v-pl-code
      435             and buf_pl-pump-nozzle.pump-code   = p-pump-code
      436             and buf_pl-pump-nozzle.nozzle-code = p-nozzle-code
      437           no-error .
      438         if not available buf_pl-pump-nozzle then do:
      439           return.
      440         end.
      441       end.
      442       if v-pl-code = 0 then do:
      443         if p-nozzle-code = 0 then do:
      444           find first buf_pl-gds-pump no-lock
      445             where buf_pl-gds-pump.obj-type  = p-obj-type
      446               and buf_pl-gds-pump.obj-code  = p-obj-code
      447               and buf_pl-gds-pump.pump-code = p-pump-code
      448               and buf_pl-gds-pump.gds-code  = p-gds-code
      449               and buf_pl-gds-pump.status_   = 'тек':U
      450             no-error.
      451           if available buf_pl-gds-pump then do:
      452             assign
      453               v-pl-code = buf_pl-gds-pump.pl-code
      454             .
      455           end.
      456         end.
      457         else do:
      458           _ppnz:
      459           for each buf_pl-pump-nozzle no-lock
      460             where buf_pl-pump-nozzle.obj-type = p-obj-type
      461               and buf_pl-pump-nozzle.obj-code = p-obj-code
      462               and buf_pl-pump-nozzle.pump-code = p-pump-code
      463               and buf_pl-pump-nozzle.nozzle-code = p-nozzle-code
      464             ,first buf_pl-gds-pump no-lock
      465             where buf_pl-gds-pump.obj-type  = p-obj-type
      466               and buf_pl-gds-pump.obj-code  = p-obj-code
      467               and buf_pl-gds-pump.pump-code = p-pump-code
      468               and buf_pl-gds-pump.gds-code  = p-gds-code
      469               and buf_pl-gds-pump.status_   = 'тек':U
      470               and buf_pl-gds-pump.pl-code   = buf_pl-pump-nozzle.pl-code
      471           on error undo, return error return-value
      472           :
      473             assign
      474               v-pl-code = buf_pl-pump-nozzle.pl-code
      475             .
      476             leave _ppnz.
      477           end.
      478         end.
      479       end.
      480       if v-pl-code <> 0 then do:
      481         assign
      482           p-pl-code = v-pl-code
      483         .
      484       end.
      485     end.
      486   end procedure.
      487   procedure find-nzl:
      488   define input  parameter p-obj-type   as character no-undo.
      489   define input  parameter p-obj-code   as integer   no-undo.
      490   define input  parameter p-pump-code  as integer   no-undo.
      491   define input  parameter p-gds-code   as integer   no-undo.
      492   define input  parameter p-pl-code    as integer no-undo .
      493   define output parameter p-nozzle-code    as integer   no-undo.
      494   define variable v-nozzle-code        like ub.nozzle.nozzle-code no-undo .
      495   define variable v-pl-code            like ub.place.pl-code no-undo .
      496   define variable v-pump-code          like ub.pump.pump-code no-undo .
      497   define variable v-loc1-code          like ub.place.loc1 no-undo .
      498   define variable v-dopstr             as character no-undo .
      499   define buffer buf_place for ub.place.
      500   define buffer buf_pl-gds-pump for ub.pl-gds-pump.
      501   define buffer buf_pl-pump-nozzle for ub.pl-pump-nozzle.
      502   define buffer buf_pl-gds for ub.pl-gds.
      503   do on error undo, return error return-value :
      504     v-pump-code = p-pump-code.
      505     find first buf_pl-pump-nozzle no-lock where
      506                   buf_pl-pump-nozzle.obj-type = p-obj-type
      507               and buf_pl-pump-nozzle.obj-code = p-obj-code
      508               and buf_pl-pump-nozzle.pump-code = p-pump-code
      509               and buf_pl-pump-nozzle.pl-code = p-pl-code no-error.
      510     if not available buf_pl-pump-nozzle then do:
      511       assign
      512       p-nozzle-code = ?.
      513       return .
      514     end.
      515     assign
      516     p-nozzle-code = buf_pl-pump-nozzle.nozzle-code.
      517     return.
      518     .
      519   end.
      520   end procedure.
      521   procedure find-nzl-without-pl:
      522   define input  parameter p-obj-type   as character no-undo.
      523   define input  parameter p-obj-code   as integer   no-undo.
      524   define input  parameter p-pump-code  as integer   no-undo.
      525   define input  parameter p-gds-code   as integer   no-undo.
      526   define output parameter p-nozzle-code    as integer   no-undo.
      527   define buffer buf_pl-gds-pump for ub.pl-gds-pump.
      528   define buffer buf_pl-gds for ub.pl-gds.
      529   define buffer buf_pl-pump-nozzle for ub.pl-pump-nozzle.
      530   do on error undo, return error return-value :
      531     for each buf_pl-gds-pump no-lock where
      532               buf_pl-gds-pump.obj-type  = p-obj-type
      533           and buf_pl-gds-pump.obj-code  = p-obj-code
      534           and buf_pl-gds-pump.pump-code = p-pump-code
      535           and buf_pl-gds-pump.gds-code  = p-gds-code
      536           and buf_pl-gds-pump.status_   = 'тек':U,
      537         first buf_pl-gds no-lock where
      538                   buf_pl-gds.obj-type = p-obj-type
      539               AND buf_pl-gds.obj-code = p-obj-code
      540               AND buf_pl-gds.pl-code = buf_pl-gds-pump.pl-code
      541               AND buf_pl-gds.gds-code = p-gds-code
      542               AND buf_pl-gds.status_ = 'тек':U,
      543        first buf_pl-pump-nozzle no-lock where
      544                 buf_pl-pump-nozzle.obj-type = p-obj-type
      545             and buf_pl-pump-nozzle.obj-code = p-obj-code
      546             and buf_pl-pump-nozzle.pl-code = buf_pl-gds.pl-code
      547             and buf_pl-pump-nozzle.pump-code = p-pump-code:
      548       assign
      549       p-nozzle-code = buf_pl-pump-nozzle.nozzle-code.
      550       return .
      551     end.
      552     assign
      553     p-nozzle-code = ?.
      554     return.
      555     .
      556   end.
      557   end procedure.
      558   procedure add-icnt-line-err :
      559   define input parameter p-mode as character no-undo .
      560   define input parameter p-chk-doc-code as character no-undo .
      561   define input parameter p-icnt-doc-code as character no-undo .
      562   define input parameter p-doc-date as date no-undo .
      563   define input parameter p-obj-type as character no-undo .
      564   define input parameter p-obj-code as integer no-undo .
      565   define input-output parameter p-ptrlcheck as character no-undo .
      566   define parameter buffer buf_tt-icnt-line for tt-icnt-line.
      567   define variable v-pump-code as integer no-undo .
      568   define variable v-nozzle-code as integer no-undo .
      569   define variable v-pl-code as integer no-undo .
      570   define variable v-loc1-code as character no-undo .
      571   define variable v-gds-code as integer no-undo .
      572   define variable v-recid-list as character no-undo .
      573   define variable v-ii as integer no-undo .
      574   define variable v-type as character no-undo .
      575   define variable v-value as character no-undo .
      576   define variable v-exist as logical no-undo .
      577   define buffer buf_chk-doc for ub.chk-doc.
      578   define buffer buf_chk-gds for ub.chk-gds.
      579   define buffer buf_icnt-doc for ub.icnt-doc.
      580   define buffer buf_bar-code for ub.bar-code.
      581   main-block:
      582   do
      583   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      584   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      585   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      586   :
      587     if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
      588       find first buf_icnt-doc exclusive-lock where
      589                 buf_icnt-doc.doc-code = p-icnt-doc-code no-error.
      590       if not available buf_icnt-doc then do:
      591         undo main-block, return error
      592         substitute( "Не найден документ измерения погрешности счетчиков ТРК с номером &1"
      593                       , p-icnt-doc-code
      594                       ).
      595       end.
      596       if buf_icnt-doc.doc-type <> 'сч-трк-погр':U then do:
      597         undo main-block, return error
      598         substitute( "Документ измерения погрешности счетчиков ТРК с номером &2 имеет неверный тип &3"
      599                       , p-icnt-doc-code
      600                       , buf_icnt-doc.doc-type
      601                       ).
      602       end.
      603       for each buf_chk-doc no-lock where
      604               buf_chk-doc.out-2-code = p-icnt-doc-code:
      605         p-ptrlcheck = p-ptrlcheck + (if p-ptrlcheck = '':U then '':U else chr(44)) + buf_chk-doc.doc-code.
      606       end.
      607     end.
      608     find first buf_chk-doc exclusive-lock where
      609               buf_chk-doc.doc-code = p-chk-doc-code no-error.
      610     if not available buf_chk-doc then do:
      611       undo main-block, return error
      612       substitute( "Не найден чек техпролива с номером &1"
      613                     , p-chk-doc-code
      614                     ).
      615     end.
      616     if buf_chk-doc.chk-type <> integer('17':U) then do:
      617       undo main-block, return error
      618       substitute( "Чек с номером &1 имеет тип отличный от типа ТЕХПРОЛИВ"
      619                     , p-chk-doc-code
      620                     ) .
      621     end.
      622     if buf_chk-doc.office <> 'т':U
      623     and buf_chk-doc.office <> 'у':U then do:
      624       undo main-block, return error
      625       substitute( "Чек с номером &1 - ошибочный - нельзя создать по нему строку док-та измерения погрешности ТРК"
      626                     , p-chk-doc-code
      627                     ).
      628     end.
      629     if (p-mode = 'ДОБАВЛЕНИЕ':U
      630         and not (buf_chk-doc.obj-type = p-obj-type
      631                 and
      632                 buf_chk-doc.obj-code = p-obj-code))
      633     or (p-mode = 'ИЗМЕНЕНИЕ':U
      634         and not (buf_chk-doc.obj-type = buf_icnt-doc.obj-type
      635                 and
      636                 buf_chk-doc.obj-code = buf_icnt-doc.obj-code)) then do:
      637       undo main-block, return error
      638       substitute( "Чек с номером &1 принадлежит &2&3, а док-нт измерения погрешности ТРК &4 - &5&6"
      639                     , p-chk-doc-code
      640                     , buf_chk-doc.obj-type
      641                     , buf_chk-doc.obj-code
      642                     , p-icnt-doc-code
      643                     , (if p-mode = 'ДОБАВЛЕНИЕ':U then p-obj-type else buf_icnt-doc.obj-type)
      644                     , (if p-mode = 'ДОБАВЛЕНИЕ':U then p-obj-code else buf_icnt-doc.obj-code)
      645                     ).
      646     end.
      647     if (p-mode = 'ДОБАВЛЕНИЕ':U
      648         and not buf_chk-doc.chk-date = p-doc-date)
      649     or (p-mode = 'ИЗМЕНЕНИЕ':U
      650         and not buf_chk-doc.chk-date = buf_icnt-doc.doc-date)
      651     then do:
      652       undo main-block, return error
      653       substitute( "Чек с номером &1 от &2, а док-нт измерения погрешности ТРК &3 - от &4"
      654                     , p-chk-doc-code
      655                     , buf_chk-doc.chk-date
      656                     , p-icnt-doc-code
      657                     , (if p-mode = 'ДОБАВЛЕНИЕ':U then p-doc-date else buf_icnt-doc.doc-date)
      658                     ).
      659     end.
      660     if p-mode = 'ИЗМЕНЕНИЕ':U
      661     and buf_chk-doc.doc-code = p-icnt-doc-code then do:
      662       undo main-block, return error
      663       substitute( "Чек с номером &1 уже используется данным док-нтом измерения погрешности ТРК &2"
      664                     , p-chk-doc-code
      665                     , p-icnt-doc-code
      666                     ).
      667     end.
      668     if buf_chk-doc.out-2-code <> ? then do:
      669       undo main-block, return error
      670       substitute( "Чек с номером &1 уже используется док-нтом измерения погрешности ТРК &2"
      671                     , buf_chk-doc.doc-code
      672                     , buf_chk-doc.out-2-code
      673                     ).
      674     end.
      675     for each buf_chk-gds no-lock where
      676           buf_chk-gds.doc-code = buf_chk-doc.doc-code
      677     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      678     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      679     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      680     :
      681       assign
      682       v-pump-code =  buf_chk-gds.pump
      683       v-nozzle-code = buf_chk-gds.nozzle-code
      684       v-loc1-code = buf_chk-gds.loc1
      685       .
      686       find first buf_bar-code no-lock where
      687                 buf_bar-code.b-code = buf_chk-gds.b-code no-error.
      688       if not available buf_bar-code then do:
      689         do v-ii = 1 to num-entries(v-recid-list):         find first buf_tt-icnt-line where                   recid(buf_tt-icnt-line) = integer(entry(v-ii, v-recid-list)) .         delete buf_tt-icnt-line.       end.
      690         undo main-block, return error
      691         substitute( "Чек с номером &1 - ошибочный - не удалось определить товар по бар-коду &2 в строке &3"
      692                       , p-chk-doc-code
      693                       , buf_chk-gds.b-code
      694                       , buf_chk-gds.line-num
      695                       ).
      696       end.
      697       v-gds-code = buf_bar-code.gds-code.
      698       if v-nozzle-code = 0 then do:
      699         run findtank in this-procedure ( input buf_chk-doc.obj-type
      700                                         ,input buf_chk-doc.obj-code
      701                                         ,input v-pump-code
      702                                         ,input v-nozzle-code
      703                                         ,input buf_chk-gds.pl-code
      704                                         ,input v-gds-code
      705                                         ,output v-pl-code ) no-error.
      706         if error-status:error
      707           or v-pl-code = ?
      708         then do:
      709           do v-ii = 1 to num-entries(v-recid-list):         find first buf_tt-icnt-line where                   recid(buf_tt-icnt-line) = integer(entry(v-ii, v-recid-list)) .         delete buf_tt-icnt-line.       end.
      710           undo main-block, return error
      711           substitute( "Чек с номером &1 - ошибочный - не удалось определить резервуар для ТРК &2 для товара по бар-коду &3 в строке &4"
      712                         , p-chk-doc-code
      713                         , v-pump-code
      714                         , buf_chk-gds.b-code
      715                         , buf_chk-gds.line-num
      716                         ).
      717         end.
      718         run find-nzl in this-procedure ( input buf_chk-doc.obj-type
      719                                         ,input buf_chk-doc.obj-code
      720                                         ,input v-pump-code
      721                                         ,input v-gds-code
      722                                         ,input v-pl-code
      723                                         ,output v-nozzle-code) no-error.
      724         if error-status:error then do:
      725           do v-ii = 1 to num-entries(v-recid-list):         find first buf_tt-icnt-line where                   recid(buf_tt-icnt-line) = integer(entry(v-ii, v-recid-list)) .         delete buf_tt-icnt-line.       end.
      726           undo main-block, return error
      727           substitute( "Чек с номером &1 - ошибочный - не удалось определить пистолет на ТРК &2 для товара по бар-коду &3 в строке &4"
      728                         , p-chk-doc-code
      729                         , v-pump-code
      730                         , buf_chk-gds.b-code
      731                         , buf_chk-gds.line-num
      732                         ).
      733         end.
      734       end.
      735       find first buf_tt-icnt-line where
      736                 buf_tt-icnt-line.doc-code = p-icnt-doc-code
      737             and buf_tt-icnt-line.obj-type = p-obj-type
      738             and buf_tt-icnt-line.obj-code = p-obj-code
      739             and buf_tt-icnt-line.pump-code = v-pump-code
      740             and buf_tt-icnt-line.nozzle-code = v-nozzle-code no-error.
      741       if available buf_tt-icnt-line then do:
      742         do v-ii = 1 to num-entries(v-recid-list):         find first buf_tt-icnt-line where                   recid(buf_tt-icnt-line) = integer(entry(v-ii, v-recid-list)) .         delete buf_tt-icnt-line.       end.
      743         undo main-block, return error
      744         substitute( "Уже есть строка док-та измерения погрешности для ТРК &1, пистолет &2 - нельзя добавить строки из чека &3"
      745                       , v-pump-code
      746                       , v-nozzle-code
      747                       , p-chk-doc-code
      748                       ).
      749       end.
      750       create buf_tt-icnt-line.
      751       assign
      752       buf_tt-icnt-line.doc-code = p-icnt-doc-code
      753       buf_tt-icnt-line.obj-type = p-obj-type
      754       buf_tt-icnt-line.obj-code = p-obj-code
      755       buf_tt-icnt-line.pump-code = v-pump-code
      756       buf_tt-icnt-line.nozzle-code = v-nozzle-code
      757       buf_tt-icnt-line.gds-code = v-gds-code
      758       buf_tt-icnt-line.state-el-cnt = buf_chk-gds.doc-qnty
      759       buf_tt-icnt-line.state-mh-cnt = buf_chk-gds.doc-qnty
      760       v-recid-list = v-recid-list + (if v-recid-list = '':U
      761                                      then '':u
      762                                      else chr(44)) +
      763                      string(recid(buf_tt-icnt-line))
      764       .
      765     end.
      766     p-ptrlcheck = p-ptrlcheck + (if p-ptrlcheck = '':U then '':U else chr(44)) + buf_chk-doc.doc-code.
      767     buf_chk-doc.out-2-code = '':U.
      768   end.
      769   end procedure.
      770   define variable v-delta-line like ub.icnt-line.state-el-cnt  no-undo.
      771   DEFINE VARIABLE new-opened AS LOGICAL NO-UNDO.
      772   DEFINE VARIABLE v-mode AS CHARACTER NO-UNDO.
      773   define variable v-host-code as integer no-undo .
      774   define variable v-ptrlcheck as character no-undo .
      775   define variable v-ref-rec  as recid no-undo .
      776   DEFINE VARIABLE wrkr AS INTEGER NO-UNDO.
      777   DEFINE VARIABLE agnt AS INTEGER NO-UNDO.
      778   DEFINE VARIABLE boss AS INTEGER NO-UNDO.
      779   define variable gds-rec as recid no-undo .
      780   DEFINE BUFFER cli-buf FOR ub.clients .
      781   DEFINE BUTTON B-add
      782        LABEL "&Добавить"
      783        SIZE 10 BY 1.
      784   DEFINE BUTTON b-chk
      785        LABEL "&Чеки"
      786        SIZE 10 BY 1.
      787   DEFINE BUTTON b-del
      788        LABEL "&Удалить"
      789        SIZE 10 BY 1.
      790   DEFINE BUTTON B-exit AUTO-GO
      791        LABEL "&Ввод"
      792        SIZE 10 BY 1
      793        BGCOLOR 8 .
      794   DEFINE BUTTON B-Help
      795        LABEL "Помо&щь"
      796        SIZE 10 BY 1
      797        BGCOLOR 8 .
      798   DEFINE BUTTON B-hist
      799        LABEL "Ис&тория"
      800        SIZE 10 BY 1.
      801   DEFINE BUTTON b-next AUTO-GO
      802        LABEL "&>>"
      803        SIZE 4 BY 1.
      804   DEFINE BUTTON B-notes
      805        LABEL "При&мечания"
      806        SIZE 10 BY 1.
      807   DEFINE BUTTON b-prev AUTO-GO
      808        LABEL "&<<"
      809        SIZE 4 BY 1.
      810   DEFINE BUTTON b-quit AUTO-END-KEY
      811        LABEL "&Отмена"
      812        SIZE 10 BY 1
      813        BGCOLOR 8 .
      814   DEFINE BUTTON r-agnt
      815        IMAGE-UP FILE "btn-down-arrow":U
      816        IMAGE-DOWN FILE "btn-down-arrow":U
      817        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      818        LABEL "r-acc"
      819        SIZE 3 BY .88.
      820   DEFINE BUTTON r-boss
      821        IMAGE-UP FILE "btn-down-arrow":U
      822        IMAGE-DOWN FILE "btn-down-arrow":U
      823        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      824        LABEL "r-acc"
      825        SIZE 3 BY .88.
      826   DEFINE BUTTON r-wrkr
      827        IMAGE-UP FILE "btn-down-arrow":U
      828        IMAGE-DOWN FILE "btn-down-arrow":U
      829        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      830        LABEL "r-acc"
      831        SIZE 3 BY .88.
      832   DEFINE VARIABLE agnt-name AS CHARACTER FORMAT "x(256)":U
      833         VIEW-AS TEXT
      834        SIZE 14 BY 1
      835        FGCOLOR 4  NO-UNDO.
      836   DEFINE VARIABLE boss-name AS CHARACTER FORMAT "x(256)":U
      837         VIEW-AS TEXT
      838        SIZE 14 BY 1
      839        FGCOLOR 4  NO-UNDO.
      840   DEFINE VARIABLE v-delta AS DECIMAL FORMAT "->>>,>>>,>>9.99":U INITIAL 0
      841        LABEL "Разница"
      842         VIEW-AS TEXT
      843        SIZE 19 BY .67 NO-UNDO.
      844   DEFINE VARIABLE wrkr-name AS CHARACTER FORMAT "x(256)":U
      845         VIEW-AS TEXT
      846        SIZE 14 BY 1
      847        FGCOLOR 4  NO-UNDO.
      848   DEFINE QUERY br-line FOR
      849         tt-icnt-line,
      850         buf_goods SCROLLING.
      851   DEFINE QUERY Dialog-Frame FOR
      852         tt-icnt-doc,
      853         buf_clients SCROLLING.
      854   DEFINE BROWSE br-line
      855     QUERY br-line NO-LOCK DISPLAY
      856         tt-icnt-line.pump-code                 COLUMN-LABEL 'ТРК'
      857   tt-icnt-line.nozzle-code                 COLUMN-LABEL 'Пис!то!лет'
      858   buf_goods.artic                 COLUMN-LABEL 'Артикул'
      859   tt-icnt-line.state-el-cnt                 COLUMN-LABEL 'Кол-во!по!счетчику'
      860   tt-icnt-line.state-mh-cnt                 COLUMN-LABEL 'Кол-во!по!мернику'
      861   (tt-icnt-line.state-el-cnt - tt-icnt-line.state-mh-cnt)  @ v-delta-line COLUMN-LABEL 'Разница' format "->>>,>>>,>>9.999"
      862   buf_goods.gds-name                 COLUMN-LABEL 'Название товара'
      863   tt-icnt-line.pl-code                 COLUMN-LABEL 'Резервуар'
      864   ENABLE
      865   tt-icnt-line.state-mh-cnt
      866       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 14 FIT-LAST-COLUMN.
      867   DEFINE FRAME Dialog-Frame
      868        B-exit AT ROW 1 COL 1
      869        b-quit AT ROW 1 COL 11
      870        b-prev AT ROW 1 COL 24
      871        b-next AT ROW 1 COL 28
      872        b-chk AT ROW 1 COL 58 WIDGET-ID 2
      873        B-notes AT ROW 1 COL 68
      874        B-hist AT ROW 1 COL 78
      875        B-Help AT ROW 1 COL 88
      876        tt-icnt-doc.doc-date AT ROW 3 COL 20 COLON-ALIGNED
      877             LABEL "Дата" FORMAT "99/99/9999"
      878             VIEW-AS FILL-IN
      879             SIZE 10 BY 1
      880        tt-icnt-doc.fact-date AT ROW 3 COL 39 COLON-ALIGNED
      881             LABEL "Факт" FORMAT "99/99/99"
      882             VIEW-AS FILL-IN
      883             SIZE 10 BY 1
      884        tt-icnt-doc.shift-date AT ROW 3 COL 58 COLON-ALIGNED
      885             LABEL "Смена" FORMAT "99/99/9999"
      886             VIEW-AS FILL-IN
      887             SIZE 10 BY 1
      888        tt-icnt-doc.shift-num AT ROW 3 COL 72 COLON-ALIGNED
      889             LABEL "П" FORMAT ">9"
      890             VIEW-AS FILL-IN
      891             SIZE 3 BY 1
      892        tt-icnt-doc.shift-name AT ROW 3 COL 82 COLON-ALIGNED
      893             LABEL "№"
      894             VIEW-AS FILL-IN
      895             SIZE 3 BY 1
      896        tt-icnt-doc.wrkr AT ROW 4 COL 5 COLON-ALIGNED
      897             LABEL "К&л-к" FORMAT "999999999"
      898             VIEW-AS FILL-IN
      899             SIZE 10 BY 1
      900        r-wrkr AT ROW 4 COL 33.13
      901        tt-icnt-doc.agnt AT ROW 5 COL 5 COLON-ALIGNED
      902             LABEL "И&сп" FORMAT "999999999"
      903             VIEW-AS FILL-IN
      904             SIZE 10 BY 1
      905        r-agnt AT ROW 5.33 COL 33
      906        tt-icnt-doc.boss AT ROW 6 COL 5 COLON-ALIGNED
      907             LABEL "&М-р" FORMAT "999999999"
      908             VIEW-AS FILL-IN
      909             SIZE 10 BY 1
      910        r-boss AT ROW 6.33 COL 33
      911        B-add AT ROW 7 COL 41
      912        b-del AT ROW 7 COL 51
      913        br-line AT ROW 8 COL 1
      914        tt-icnt-doc.obj-code AT ROW 2 COL 16 COLON-ALIGNED
      915             LABEL "Объект" FORMAT "99999"
      916              VIEW-AS TEXT
      917             SIZE 7 BY .67
      918        tt-icnt-doc.obj-type AT ROW 2 COL 23.5 COLON-ALIGNED NO-LABEL
      919              VIEW-AS TEXT
      920             SIZE 4 BY .67
      921        buf_clients.obj-name AT ROW 2 COL 33 COLON-ALIGNED NO-LABEL FORMAT "X(40)"
      922              VIEW-AS TEXT
      923             SIZE 40 BY .67
      924             FGCOLOR 4
      925        wrkr-name AT ROW 4 COL 16 COLON-ALIGNED NO-LABEL
      926        tt-icnt-doc.state-el-cnt AT ROW 4 COL 75 COLON-ALIGNED
      927             LABEL "Кол-во по счетчику"
      928              VIEW-AS TEXT
      929             SIZE 19 BY .67
      930        agnt-name AT ROW 5 COL 16 COLON-ALIGNED NO-LABEL
      931        tt-icnt-doc.state-mh-cnt AT ROW 5 COL 75 COLON-ALIGNED
      932             LABEL "Кол-во по мернику"
      933              VIEW-AS TEXT
      934             SIZE 19 BY .67
      935        boss-name AT ROW 6 COL 16 COLON-ALIGNED NO-LABEL
      936        v-delta AT ROW 6 COL 75 COLON-ALIGNED
      937        SPACE(3.89) SKIP(15.59)
      938       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      939            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      940            TITLE ""
      941            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      942   ASSIGN
      943          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      944          FRAME Dialog-Frame:HIDDEN           = TRUE.
      945   ON END-ERROR OF FRAME Dialog-Frame
      946   OR STOP OF FRAME Dialog-Frame DO:
      947     apply "choose" to b-quit in frame Dialog-Frame.
      948     return no-apply.
      949   END.
      950   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      951   DO:
