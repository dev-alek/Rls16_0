     3266   PROCEDURE MyEnable :
     3267   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     3268   ASSIGN
     3269   br-line:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame = 3
     3270   frame Dialog-Frame:title = substitute("(&1) :   ДОКУМЕНТ ИЗМЕРЕНИЯ ПОГРЕШНОСТИ СЧЕТЧИКОВ ТРК - &2 № &3 - &4"
     3271                                          , substring (buf_clients.obj-name, 1, 35)
     3272                                          , tt-icnt-doc.STATUS_
     3273                                          , tt-icnt-doc.doc-code
     3274                                          , p-mode).
     3275   disable
     3276   all with frame Dialog-Frame.
     3277   enable
     3278   b-exit WHEN p-mode <> 'ПРОСМОТР':U
     3279   b-quit
     3280   b-help
     3281   br-line
     3282   b-hist
     3283   b-notes
     3284   b-chk
     3285   b-next WHEN p-mode = 'ПРОСМОТР':U
     3286   b-prev WHEN p-mode = 'ПРОСМОТР':U
     3287   tt-icnt-doc.wrkr WHEN (p-mode <> 'ПРОСМОТР':U AND tt-icnt-doc.STATUS_ = 'новый':U)
     3288   tt-icnt-doc.agnt WHEN (p-mode <> 'ПРОСМОТР':U AND tt-icnt-doc.STATUS_ = 'новый':U)
     3289   tt-icnt-doc.boss WHEN (p-mode <> 'ПРОСМОТР':U AND tt-icnt-doc.STATUS_ = 'новый':U)
     3290   r-wrkr WHEN (p-mode <> 'ПРОСМОТР':U AND tt-icnt-doc.STATUS_ = 'новый':U)
     3291   r-agnt WHEN (p-mode <> 'ПРОСМОТР':U AND tt-icnt-doc.STATUS_ = 'новый':U)
     3292   r-boss WHEN (p-mode <> 'ПРОСМОТР':U AND tt-icnt-doc.STATUS_ = 'новый':U)
     3293   WITH frame Dialog-Frame.
     3294   define variable vss-include-info27 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3295   do:
     3296     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3297       (input  v-cntxt-db-num
     3298       ,input  v-cntxt-userid
     3299       ,input  0
     3300       ,input  'actn_icnt-doc_upd-el-cnt':U
     3301       ,input  'object':U
     3302       ,input  buf_clients.host-code
     3303       ,input  buf_clients.obj-type
     3304       ,input  buf_clients.obj-code
     3305       ,input  0
     3306       ,input  0
     3307       ,input  0
     3308       ,input  false
     3309       ,output glog
     3310       )  .
     3311   end.
     3312   if p-mode = 'ПРОСМОТР':U then do:
     3313      ASSIGN
     3314      tt-icnt-line.state-mh-cnt:READ-ONLY in browse br-line = YES
     3315      .
     3316     assign
     3317     b-quit:label = "&Выход"
     3318     b-quit:column = 1
     3319     .
     3320     hide b-exit in frame Dialog-Frame .
     3321   end.
     3322   DISPLAY
     3323   tt-icnt-doc.obj-code
     3324   tt-icnt-doc.obj-type
     3325   tt-icnt-doc.fact-date
     3326   tt-icnt-doc.doc-date
     3327   tt-icnt-doc.shift-date
     3328   tt-icnt-doc.shift-num
     3329   tt-icnt-doc.shift-name
     3330   with frame Dialog-Frame.
     3331   HIDE
     3332   b-add b-del IN FRAME Dialog-Frame.
     3333   run display-value in this-procedure .
     3334     define variable v-ref-rec28   as recid no-undo .
     3335     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-icnt-doc.wrkr
     3336                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     3337   if not available cli-buf then do:
     3338     display tt-icnt-doc.wrkr with frame Dialog-Frame.
     3339     find cli-buf no-lock where cli-buf.obj-code = input frame Dialog-Frame tt-icnt-doc.wrkr
     3340                            and cli-buf.obj-type = 'чел':U no-error.
     3341   end.
