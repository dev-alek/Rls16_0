     1126   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     1127   DO:
     1128   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1129   if lookup(self :type
     1130            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1131            ) = 0
     1132   then do:
     1133     message
     1134       "$Workfile$"
     1135       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1136       "Интерфейсный элемент" self :name  skip
     1137       "Тип" self :type  skip
     1138       "Процедура" this-procedure :file-name skip
     1139       view-as alert-box .
     1140   end.
     1141   else do:
     1142     apply "entry":u to self  .
     1143     if focus :handle <> self :handle  then do:
     1144       return no-apply .
     1145     end.
     1146   end.
     1147     DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     1148     define variable v-ii as integer no-undo .
     1149     define buffer buf_chk-doc for ub.chk-doc.
     1150     case p-mode:
     1151       when 'ДОБАВЛЕНИЕ':U then do:
     1152         MESSAGE
     1153         "Выйти не сохранив все сделанные изменения?"
     1154          VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     1155          IF NOT glog THEN RETURN NO-APPLY.
     1156         do v-ii = 1 to num-entries(v-ptrlcheck):
     1157           find first buf_chk-doc where
     1158                    buf_chk-doc.doc-code = entry(v-ii, v-ptrlcheck) exclusive-lock.
     1159           assign
     1160           buf_chk-doc.out-2-code = ?
     1161           .
     1162         end.
     1163         if available locked_icnt-doc then
     1164          delete locked_icnt-doc.
     1165          p-recid = ?.
     1166       end.
     1167       WHEN 'ИЗМЕНЕНИЕ':U THEN DO:
     1168         MESSAGE
     1169         "Выйти не сохранив все сделанные изменения?"
     1170         VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     1171         IF NOT glog THEN RETURN NO-APPLY.
     1172         do v-ii = 1 to num-entries(v-ptrlcheck):
     1173           find first buf_chk-doc where
     1174                    buf_chk-doc.doc-code = entry(v-ii, v-ptrlcheck) exclusive-lock.
     1175           if buf_chk-doc.out-2-code = '':U then do:
     1176             assign
     1177             buf_chk-doc.out-2-code = ?
     1178             .
     1179           end.
     1180         end.
     1181       END.
     1182     END CASE.
     1183     p-next-prev = "quit".
     1184   END.
