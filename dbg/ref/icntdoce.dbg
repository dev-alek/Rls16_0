     2010                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2011               .
     2012             end.
     2013           end.
     2014           assign
     2015             v-object-handle = v-object-handle :next-sibling
     2016           .
     2017         end.
     2018         assign
