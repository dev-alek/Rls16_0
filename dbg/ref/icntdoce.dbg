     3351     find cli-buf no-lock where cli-buf.obj-code = input frame Dialog-Frame tt-icnt-doc.agnt
     3352                            and cli-buf.obj-type = 'чел':U no-error.
     3353   end.
     3354   if available cli-buf then do:
     3355         display cli-buf.obj-code @ tt-icnt-doc.agnt cli-buf.obj-name @ agnt-name with frame Dialog-Frame.
     3356     end.
     3357     else display ? @ tt-icnt-doc.agnt ? @ agnt-name with frame Dialog-Frame.
     3358     define variable v-ref-rec30   as recid no-undo .
     3359     find cli-buf where cli-buf.obj-code = input frame Dialog-Frame tt-icnt-doc.boss
     3360                    and cli-buf.obj-type = 'чел':U no-lock no-error.
     3361   if not available cli-buf then do:
     3362     display tt-icnt-doc.boss with frame Dialog-Frame.
     3363     find cli-buf no-lock where cli-buf.obj-code = input frame Dialog-Frame tt-icnt-doc.boss
     3364                            and cli-buf.obj-type = 'чел':U no-error.
     3365   end.
     3366   if available cli-buf then do:
     3367         display cli-buf.obj-code @ tt-icnt-doc.boss cli-buf.obj-name @ boss-name with frame Dialog-Frame.
     3368     end.
     3369     else display ? @ tt-icnt-doc.boss ? @ boss-name with frame Dialog-Frame.
     3370   RUN Openbr IN THIS-PROCEDURE .
     3371   if p-mode = 'ПРОСМОТР':U then do:
     3372   if p-icnt-line-rec <> ? then reposition br-line to recid p-icnt-line-rec no-error.
     3373     apply "entry" to br-line in frame Dialog-Frame.
     3374   end.
     3375   if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     3376     apply "entry" to br-line in frame Dialog-Frame.
     3377   end.
     3378   if num-results("br-line") > 0 then do:
     3379      if br-line:refresh() then.
     3380   end.
     3381   hide
     3382   b-hist
     3383   in frame Dialog-Frame .
     3384   END PROCEDURE.
     3385   PROCEDURE OpenBr :
     3386   OPEN QUERY br-line                                             FOR EACH tt-icnt-line WHERE tt-icnt-line.doc-code = tt-icnt-doc.doc-code NO-LOCK,              FIRST buf_goods OUTER-JOIN NO-LOCK WHERE buf_goods.gds-code  = tt-icnt-line.gds-code.
     3387   END PROCEDURE.
     3388   PROCEDURE proc-save :
     3389   define variable v-recid as recid no-undo .
     3390   if p-mode = 'ПРОСМОТР':U then return .
     3391   assign
     3392   frame Dialog-Frame
     3393   tt-icnt-doc.wrkr
     3394   tt-icnt-doc.agnt
     3395   tt-icnt-doc.boss.
     3396   if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     3397     v-recid = recid(locked_icnt-doc).
     3398   end.
     3399   run str/icntdoc1.p (
     3400                    INPUT p-mode
     3401                   ,input no
     3402                   ,input-output v-recid
     3403                   ,INPUT tt-icnt-doc.doc-code
     3404                   ,input tt-icnt-doc.obj-type
     3405                   ,input tt-icnt-doc.obj-code
     3406                   ,input tt-icnt-doc.host-code
     3407                   ,input 'сч-трк-погр':U
     3408                   ,input 'em':U
     3409                   ,INPUT tt-icnt-doc.wrkr
     3410                   ,INPUT tt-icnt-doc.agnt
     3411                   ,INPUT tt-icnt-doc.boss
     3412                   ,INPUT tt-icnt-doc.doc-date
     3413                   ,input tt-icnt-doc.meas-el-cnt
     3414                   ,input tt-icnt-doc.state-el-cnt
     3415                   ,input tt-icnt-doc.state-mh-cnt
     3416                   ,input tt-icnt-doc.PS
     3417                   ,input tt-icnt-doc.creid
     3418                   ,input v-ptrlcheck
     3419                   ,input table tt-icnt-line
     3420                    ) NO-ERROR.
     3421   if error-status:error then do:
     3422   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3423   define variable fh as widget-handle no-undo .
     3424   define variable hh as widget-handle no-undo .
     3425   define variable rv as character no-undo .
     3426   assign
     3427   rv = entry(1, return-value , chr(4)).
     3428   if rv <> "":U then do:
     3429     assign
     3430     fh = frame Dialog-Frame:first-child
     3431     hh = fh:first-child
     3432     .
     3433     do while valid-handle(hh):
     3434       if hh:name = rv then do:
     3435         APPLY "ENTRY" to hh.
     3436         undo ,
     3437         return error.
     3438       end.
     3439       hh = hh:next-sibling.
     3440     end.
     3441   end.
     3442     undo, return error.
     3443   end.
     3444   p-recid = v-recid.
     3445   END PROCEDURE.
     3446   PROCEDURE recalc-icnt :
     3447   DEFINE VARIABLE v-meas-el-cnt AS DECIMAL NO-UNDO.
     3448   DEFINE VARIABLE v-state-el-cnt AS DECIMAL NO-UNDO.
     3449   DEFINE VARIABLE v-state-mh-cnt AS DECIMAL NO-UNDO.
     3450   define buffer buf_tt-icnt-line for tt-icnt-line.
     3451   for each buf_tt-icnt-line where buf_tt-icnt-line.doc-code = tt-icnt-doc.doc-code:
     3452     ASSIGN
     3453     v-meas-el-cnt = v-meas-el-cnt + buf_tt-icnt-line.meas-el-cnt
     3454     v-state-el-cnt = v-state-el-cnt + buf_tt-icnt-line.state-el-cnt
     3455     v-state-mh-cnt = v-state-mh-cnt + buf_tt-icnt-line.state-mh-cnt
     3456     .
     3457   end.
     3458   assign
     3459   tt-icnt-doc.meas-el-cnt  = v-meas-el-cnt
     3460   tt-icnt-doc.state-el-cnt = v-state-el-cnt
     3461   tt-icnt-doc.state-mh-cnt = v-state-mh-cnt
     3462   .
     3463   END PROCEDURE.
     3464   PROCEDURE reposition-icnt-doc :
     3465   define input parameter p-direction as character no-undo .
     3466   define variable v-new-icnt-doc-recid as recid no-undo .
     3467   do
     3468   on error undo, return error
     3469   :
     3470     if valid-handle(p-call-prog)
     3471     then do:
     3472       run reposition-icnt-doc in p-call-prog
     3473         (input  p-direction
     3474         ,output v-new-icnt-doc-recid
     3475         ).
     3476       if v-new-icnt-doc-recid <> ?
     3477       then do:
     3478         define buffer buf_icnt-doc for ub.icnt-doc .
     3479         find first buf_icnt-doc no-lock
     3480           where recid(buf_icnt-doc) = v-new-icnt-doc-recid
     3481           no-error .
     3482         assign
     3483         p-recid = v-new-icnt-doc-recid
     3484         p-next-prev = '':U
     3485         .
     3486       end.
     3487     end.
     3488     else do:
     3489       message "Список документов не определен." view-as alert-box INFORMATION .
     3490       return no-apply.
     3491     end.
     3492     END.
     3493   END PROCEDURE.
