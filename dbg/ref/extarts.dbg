        1   block-level on error undo, throw.
        2   define input  parameter p-mode               as character                         no-undo .
        3   define input  parameter p-cli-type           like ub.ext-artic.cli-type           no-undo .
        4   define input  parameter p-cli-code           like ub.ext-artic.cli-code           no-undo .
        5   define input  parameter p-gds-code           like ub.goods.gds-code               no-undo .
        6   define input  parameter p-ext-artic          like ub.ext-artic.ext-artic          no-undo .
        7   define input  parameter p-ps                 like ub.ext-artic.ps                 no-undo .
        8   define input  parameter p-unit-cli           like ub.ext-artic.unit-cli           no-undo .
        9   define input  parameter p-cli-base-rate      like ub.ext-artic.cli-base-rate      no-undo .
       10   define input  parameter p-unit-cli-ord       like ub.ext-artic.unit-cli-ord       no-undo .
       11   define input  parameter p-cli-base-rate-ord  like ub.ext-artic.cli-base-rate-ord  no-undo .
       12   define input  parameter p-unit-cli-rcv       like ub.ext-artic.unit-cli-rcv       no-undo .
       13   define input  parameter p-cli-base-rate-rcv  like ub.ext-artic.cli-base-rate-rcv  no-undo .
       14   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       15   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       16   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       17   define variable vss-workfile    as character no-undo init "$Workfile: extarts.p $":U .
       18   define variable vss-archive     as character no-undo init "$Archive: ref/extarts.p $":U .
       19   define variable vss-description as character no-undo init "Сохранение внешнего артикула".
       20   procedure vss-get-info :
       21     define output parameter p-vss-revision    like vss-revision    no-undo .
       22     define output parameter p-vss-author      like vss-author      no-undo .
       23     define output parameter p-vss-date        like vss-date        no-undo .
       24     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       25     define output parameter p-vss-archive     like vss-archive     no-undo .
       26     define output parameter p-vss-description like vss-description no-undo .
       27     assign
       28       p-vss-revision    = vss-revision
       29       p-vss-author      = vss-author
       30       p-vss-date        = vss-date
       31       p-vss-workfile    = vss-workfile
       32       p-vss-archive     = vss-archive
       33       p-vss-description = vss-description
       34     .
       35   end procedure.
       36   procedure vss-get-parameters :
       37     define output parameter p-vss-parameters as character no-undo .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   define buffer buf_ext-artic for ub.ext-artic.
       79   define buffer ex_ext-artic  for ub.ext-artic.
       80   define buffer buf_goods     for ub.goods.
       81   define buffer ex_goods      for ub.goods.
       82   define buffer buf_clients   for ub.clients.
       83   do on error undo, return error return-value :
       84     find first buf_clients no-lock
       85       where buf_clients.obj-type = p-cli-type
       86         and buf_clients.obj-code = p-cli-code
       87     no-error .
       88     if not available buf_clients then do :
       89       return error substitute( "Не найден контрагент&1cli-type=&2, cli-code=&3"
       90                              , chr(10)
       91                              , p-cli-type
       92                              , p-cli-code
       93                              ).
       94     end.
       95     find first buf_goods no-lock
       96       where buf_goods.gds-code = p-gds-code
       97     no-error .
       98     if not available buf_goods then do :
       99       return error substitute ( "Не найден товар с кодом &1 " , p-gds-code ).
      100     end.
      101     find first ex_ext-artic no-lock
      102       where ex_ext-artic.cli-type   = p-cli-type
      103         and ex_ext-artic.cli-code   = p-cli-code
      104         and ex_ext-artic.gds-code  <> p-gds-code
      105         and ex_ext-artic.ext-artic  = p-ext-artic
      106         and ex_ext-artic.status_    = 'тек':U
      107     no-error .
      108     if available ex_ext-artic then do :
      109       find first ex_goods no-lock
      110         where ex_goods.gds-code = ex_ext-artic.gds-code
      111       no-error .
      112       return error substitute( "У '&1 &2' уже есть товар &3 с внешним артикулом &4"
      113                              , p-cli-type
      114                              , p-cli-code
      115                              , if available ex_goods then substitute( "'&1 &2'" , ex_goods.artic , ex_goods.gds-name ) else ''
      116                              , p-ext-artic
      117                              ).
      118     end.
      119     case p-mode :
      120       when 'ДОБАВЛЕНИЕ':U then do:
      121         find first ex_ext-artic no-lock
      122           where ex_ext-artic.cli-type = p-cli-type
      123             and ex_ext-artic.cli-code = p-cli-code
      124             and ex_ext-artic.gds-code = p-gds-code
      125         no-error .
      126         if not available ex_ext-artic then do :
      127           create buf_ext-artic.
      128         end.
      129         else do :
      130           if ex_ext-artic.status_ = 'тек':U then do:
      131             return error substitute ( "Ошибка при добавлении внешнего артикула к товару '&1 &2'&3Для данного товара уже есть внешний артикул поставщика &4 &5."
      132                                     , buf_goods.artic
      133                                     , buf_goods.gds-name
      134                                     , chr(10)
      135                                     , ex_ext-artic.cli-type
      136                                     , ex_ext-artic.cli-code
      137                                     ).
      138           end.
      139           else do :
      140             find first buf_ext-artic exclusive-lock
      141               where recid(buf_ext-artic) = recid(ex_ext-artic)
      142             no-wait no-error .
      143             if locked buf_ext-artic then do:
      144               return error substitute("Запись заблокирована, редактирование невозможно.").
      145             end.
      146           end.
      147         end.
      148       end.
      149       when 'ИЗМЕНЕНИЕ':U then do:
      150         find first buf_ext-artic exclusive-lock
      151           where buf_ext-artic.cli-type = p-cli-type
      152             and buf_ext-artic.cli-code = p-cli-code
      153             and buf_ext-artic.gds-code = p-gds-code
      154         no-wait no-error .
      155         if not available buf_ext-artic then do:
      156           if locked buf_ext-artic then do:
      157             return error substitute("Запись заблокирована, редактирование невозможно.").
      158           end.
      159           else do:
      160             return error substitute( "Не найдена запись для редактирования с ключом '&1:&2:&3'"
      161                                    , p-cli-type
      162                                    , p-cli-code
      163                                    , p-gds-code
      164                                    ) .
      165           end.
      166         end.
      167       end.
      168     end case.
      169     assign
      170       buf_ext-artic.cli-type  = p-cli-type
      171       buf_ext-artic.cli-code  = p-cli-code
      172       buf_ext-artic.gds-code  = p-gds-code
      173       buf_ext-artic.ext-artic = p-ext-artic
      174       buf_ext-artic.ps        = p-ps
      175       buf_ext-artic.unit-cli           = p-unit-cli
      176       buf_ext-artic.cli-base-rate      = p-cli-base-rate
      177       buf_ext-artic.unit-cli-ord       = p-unit-cli-ord
      178       buf_ext-artic.cli-base-rate-ord  = p-cli-base-rate-ord
      179       buf_ext-artic.unit-cli-rcv       = p-unit-cli-rcv
      180       buf_ext-artic.cli-base-rate-rcv  = p-cli-base-rate-rcv
      181     .
      182     if p-mode = 'ДОБАВЛЕНИЕ':U then do :
      183       assign
      184         buf_ext-artic.status_ = 'тек':U
      185       .
      186     end.
      187   end.
