        1   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        2   DEFINE INPUT PARAMETER p-mode AS CHARACTER NO-UNDO.
        3   define input parameter p-emitent-host-code as integer no-undo .
        4   define input parameter p-type as character no-undo .
        5   DEFINE INPUT-OUTPUT PARAMETER p-cardname-sent AS CHARACTER NO-UNDO.
        6   DEFINE INPUT-OUTPUT PARAMETER p-custom-sent AS CHARACTER NO-UNDO.
        7   DEFINE OUTPUT PARAMETER p-ok AS LOGICAL NO-UNDO.
        8   define variable vss-revision    as character no-undo init "$Revision$":U .
        9   define variable vss-author      as character no-undo init "$Author$":U .
       10   define variable vss-date        as character no-undo init "$Date$":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       12   define variable vss-archive     as character no-undo init "$Archive$":U .
       13   define variable vss-description as character no-undo init "Информация, посылаемая на кассу для типа ДК".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   define variable v-waitfram-action01         as character   no-undo .
       70   define variable v-waitfram-action02         as character   no-undo .
       71   define variable v-waitfram-action03         as character   no-undo .
       72   define variable mWaitFramTextBeg            as character   no-undo.
       73   define variable mWaitFramTextEnd            as character   no-undo.
       74   define variable mWaitFramView               as logical     no-undo.
       75   define variable mWaitProcEvent              as logical     no-undo init yes.
       76   define variable mWaitFramInterval           as integer     no-undo init 1 .
       77   define variable mWaitFramStop               as logical     no-undo.
       78   define variable mWaitFramStopUser           as logical     no-undo.
       79   define variable mWaitFramStopTimeOut        as logical     no-undo.
       80   define variable mWaitFramStartProc          as datetime-tz no-undo.
       81   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       82   define button B-WaitFramStop auto-end-key
       83        label "Стоп"
       84        size 10 by 1 tooltip "Остоновить процесс".
       85   define button B-viewProcInfo
       86        label "Информация"
       87        size 15 by 1 tooltip "Информация о процесс".
       88   define frame waitfram
       89     v-waitfram-action01 format "x(72)" no-label skip
       90     v-waitfram-action02 format "x(72)" no-label skip
       91     v-waitfram-action03 format "x(72)" no-label skip
       92     B-viewProcInfo
       93     B-WaitFramStop at row 4 col 30
       94     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       95     .
       96   define new global shared variable mBatchMode as logical no-undo init ?.
       97   define variable mFramBachModHandle as handle no-undo.
       98   mFramBachModHandle = frame waitfram:handle.
       99   define variable mFameOldVis as logical no-undo.
      100   define variable mVisCUrentVin as logical no-undo.
      101   if session:batch-mode
      102   then
      103      mBatchMode = yes.
      104   if mBatchMode = ? then do:
      105     mVisCUrentVin = current-window:visible.
      106     mFameOldVis = mFramBachModHandle:visible.
      107     mFramBachModHandle:visible  = yes.
      108     mBatchMode = mFramBachModHandle:visible ne yes.
      109     mFramBachModHandle:visible = mFameOldVis.
      110     current-window:visible = mVisCUrentVin.
      111   end.
      112    if  log-manager:logfile-name ne ?
      113     then DO:
      114         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      115         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      116         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      117     end.
      118   on choose of B-WaitFramStop in frame waitfram
      119   do:
      120     mWaitFramStop = yes.
      121     mWaitFramStopUser = yes.
      122   end.
      123   function waitfram-check-timeout returns logical():
      124      define variable vtime as int64 no-undo.
      125      if mWaitFramStopTimeOut
      126      then
      127         return yes.
      128      vtime = ( now - mWaitFramStartProc ) / 1000 .
      129      if     mWaitFramTimeOut ne ?
      130         and mWaitFramTimeOut ne 0
      131         and mWaitFramTimeOut lt vtime
      132      then do:
      133         mWaitFramStopTimeOut = yes.
      134      end.
      135      return mWaitFramStopTimeOut.
      136   end.
      137   procedure waitfram-hide :
      138     if not session:batch-mode
      139     then do
      140     on error undo, return error return-value
      141     :
      142       pause 0 before-hide .
      143       if not mBatchMode then
      144         hide frame waitfram .
      145     if     not mWaitFramView
      146        and mWaitProcEvent
      147     then
      148       process events .
      149     end.
      150   end procedure.
      151   procedure waitfram-show :
      152     define input  parameter p-message as character no-undo .
      153     define variable v-left-margin as integer   no-undo .
      154     if not session:batch-mode
      155     then do
      156     on error undo, return error return-value
      157     :
      158       if length(p-message) <= 70 then do:
      159         assign
      160           v-left-margin = integer((70 - length(p-message)) / 2)
      161         .
      162         assign
      163           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      164         .
      165         assign
      166           v-waitfram-action01 = " "
      167           v-waitfram-action02 = " "
      168                                    + fill(" ", v-left-margin)
      169                                    + p-message
      170           v-waitfram-action03 = " "
      171         .
      172       end.
      173       else do:
      174         define variable vRindex1 as integer no-undo.
      175         define variable vRindex2 as integer no-undo.
      176         vRindex1 = r-index(p-message," ",70).
      177         if vRindex1 = 0
      178         then
      179            vRindex1 = 70.
      180         if length(p-message)  <= vRindex1 + 70 then do:
      181           assign
      182             v-waitfram-action01 = " "
      183             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      184             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      185           .
      186         end.
      187         else do:
      188           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      189           if vRindex2 <= vRindex1
      190           then
      191              vRindex2 = vRindex1 + 70.
      192           assign
      193             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      194             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      195             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      196           .
      197         end.
      198       end.
      199       B-viewProcInfo:visible   in frame waitfram = no.
      200       B-viewProcInfo:sensitive in frame waitfram = no.
      201       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      202       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      203       if  (   mWaitFramView
      204          or  mWaitProcEvent)
      205          and not mBatchMode
      206       then
      207          display
      208             v-waitfram-action01 skip
      209             v-waitfram-action02 skip
      210             v-waitfram-action03 skip
      211          with frame waitfram .
      212       if     mWaitFramView
      213          then do:
      214             if     mWaitFramInterval ne ?
      215                and not mBatchMode
      216             then
      217                wait-for go of frame waitfram pause mWaitFramInterval.
      218          end.
      219          else
      220             if     mWaitProcEvent
      221                and not mBatchMode
      222             then
      223                process events .
      224     end.
      225   end procedure.
      226      procedure waitfram-show-this:
      227         define input  parameter iInterval as int64 no-undo.
      228         define variable vtime as int64 no-undo.
      229         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      230         mWaitFramInterval = iInterval.
      231         run waitfram-show (substitute("&1&2 &3&4" ,
      232                                       mWaitFramTextBeg ,
      233                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      234                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      235                                       mWaitFramTextEnd
      236                                      )
      237                           ).
      238      end.
      239      procedure WaitFramRunPause:
      240         define input  parameter iInterval as dec no-undo.
      241         define variable vStart  as datetime-tz no-undo.
      242         define variable vend    as datetime-tz no-undo.
      243         define variable vint as int64 no-undo.
      244         define variable vOk as logical no-undo.
      245         vStart = now.
      246         vend   = vStart.
      247         publish "WaitFramPause" (iInterval,output vOk).
      248         vend   =  now.
      249         vint = vend - vStart.
      250         vint = iInterval - vint / 1000.
      251         if     not mWaitFramStop
      252            and (   vint > 0
      253                 or (    not vOk
      254                     and iInterval eq ?
      255                     )
      256                 )
      257         then
      258            run waitfram-show-this (iInterval).
      259         vend   =  now.
      260         vint = vend - vStart.
      261         vint = iInterval - vint / 1000.
      262         if     not mWaitFramStop
      263            and vint > 0
      264         then do:
      265            run gbl/pause.p (vint * 1000).
      266         end.
      267         if iInterval ne ?
      268         then
      269            publish "WaitFramStop".
      270         waitfram-check-timeout().
      271      end.
      272      procedure WaitFramWaitFor:
      273         define input  parameter iInterval as dec no-undo.
      274         assign
      275            mWaitFramStartProc   = now
      276            mWaitFramStopUser    = no
      277            mWaitFramStopTimeOut = no
      278         .
      279         block-wait:
      280         do while not mWaitFramStop:
      281            run WaitFramRunPause (iInterval).
      282            if  waitfram-check-timeout()
      283            then do:
      284               leave block-wait.
      285            end.
      286         end.
      287         run waitfram-hide.
      288      end.
      289   procedure waitfram-join :
      290     define input  parameter p-line-1  as character no-undo .
      291     define input  parameter p-line-2  as character no-undo .
      292     define input  parameter p-line-3  as character no-undo .
      293     define output parameter p-message as character no-undo .
      294     do
      295     on error undo, return error return-value
      296     :
      297       assign
      298         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      299                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      300                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      301       .
      302     end.
      303   end procedure.
      304   function waitfram-join-function returns character
      305     (input p-line-1 as character
      306     ,input p-line-2 as character
      307     ,input p-line-3 as character
      308     ).
      309     define variable v-message as character no-undo .
      310     run waitfram-join in this-procedure
      311       (input  p-line-1
      312       ,input  p-line-2
      313       ,input  p-line-3
      314       ,output v-message
      315       ) .
      316     return v-message .
      317   end function .
      318   define new global shared variable g#language as character no-undo .
      319   if g#language <> '' and g#language <> 'rus':U then do:
      320     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      321   end.
      322   procedure proc-alt-shift-f2:
      323     if not ibs.th.gbl.gbl-var:rcode
      324   then
      325     run gbl\inidebug.p .
      326   end.
      327   procedure proc-alt-shift-f3:
      328     run gbl/prvssinf.p
      329       ( input this-procedure
      330       ) .
      331   end.
      332   define variable v-inform-launched as logical no-undo initial false .
      333   procedure proc-alt-shift-f4:
      334     define variable v-action as character no-undo .
      335     if v-inform-launched = false then do:
      336       assign
      337         v-inform-launched = true
      338       .
      339       run gbl/d-inform.w
      340         (  input self
      341         ,  input this-procedure
      342         , output v-action
      343         ) no-error .
      344       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      345       assign
      346         v-inform-launched = false
      347       .
      348     end.
      349   end.
      350   procedure proc-alt-f1:
      351     run gbl/corrhelp.p
      352       (input this-procedure
      353       ) .
      354   end .
      355   on alt-shift-f2 anywhere do:
      356     run proc-alt-shift-f2.
      357   end.
      358   on alt-shift-f3 anywhere do:
      359     run proc-alt-shift-f3 in this-procedure .
      360   end.
      361   on alt-shift-f4 anywhere do:
      362     run proc-alt-shift-f4 in this-procedure.
      363   end.
      364   on alt-f1 anywhere do:
      365     run proc-alt-f1 in this-procedure .
      366   end.
      367   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      368   define variable dcard-algo-field-name as character no-undo extent 3 init [
      369    'd-pcnt':U
      370   ,'cash-d-pcnt':U
      371   ,'pcnt-kat':U].
      372   define variable algo-field-abbr as character no-undo extent 3 init [
      373    'ITEM%':U
      374   ,'TOTAL%':U
      375   ,'CATEG':U].
      376   FUNCTION dct-algo-Date-to-String returns character(input  p-date as date):
      377   define variable v-date-str as character no-undo .
      378   assign
      379   v-date-str = string(YEAR(p-date), "9999":U) + chr(47) +
      380                string(Month(p-date), "99":U) + chr(47) +
      381                string(DAY(p-date), "99":U).
      382   return v-date-str.
      383   END FUNCTION.
      384   function dct-algo-string-to-date returns date ( input p-string  as character):
      385     define variable v-date as date no-undo .
      386     assign
      387     v-date = date(integer(substring(p-string, 6, 2))
      388                   ,integer(substring(p-string, 9, 2))
      389                   ,integer(substring(p-string, 1, 4))
      390                  ) no-error .
      391     if error-status:error then return ?.
      392     return v-date.
      393   END FUNCTION.
      394   FUNCTION dct-algo-get-sum-id-from-DT-CODE returns character ( input p-DT-CODE as integer):
      395   define buffer buf_prop-ref for ub.prop-ref.
      396   find first buf_prop-ref no-lock where
      397             buf_prop-ref.DT-CODE = p-DT-CODE no-error.
      398   if not available buf_prop-ref then do:
      399     return chr(63).
      400   end.
      401   return buf_prop-ref.sum-id.
      402   END FUNCTION.
      403   FUNCTION dct-algo-get-description-sum-id returns character ( input p-dt-code as integer):
      404   define variable v-des as character no-undo .
      405   define buffer buf_prop-ref for ub.prop-ref.
      406   define buffer buf_prop-head for ub.prop-head.
      407   find first buf_prop-ref no-lock where
      408             buf_prop-ref.dt-code = p-dt-code no-error.
      409   if not available buf_prop-ref then do:
      410     return substitute("Срез/итог по ДК c кодом &1 - срез не найден", p-dt-code).
      411   end.
      412   find first buf_prop-head no-lock where
      413           buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error.
      414   if not available buf_prop-head then do:
      415     return substitute("Срез/итог по ДК &1 c кодом &2 - неизвестное", p-dt-code, buf_prop-ref.dtm-code).
      416   end.
      417   assign
      418   v-des = substitute("&1  &2 &3"
      419                     , buf_prop-head.prop-name
      420                     , buf_prop-ref.sum-id
      421                     , buf_prop-ref.caller_id).
      422   return v-des.
      423   end FUNCTION.
      424   FUNCTION dct-algo-get-description-node-code returns character ( input p-dtm-code as integer
      425                                                               ,input p-dt-code as integer
      426                                                               ,input p-node-code as integer
      427                                                               ):
      428   define variable v-des as character no-undo .
      429   define buffer buf_prop-ref for ub.prop-ref.
      430   define buffer buf_prop-head for ub.prop-head.
      431   define buffer buf_prop-map for ub.prop-map.
      432   find first buf_prop-ref no-lock where
      433             buf_prop-ref.dt-code = p-dt-code no-error.
      434   if not available buf_prop-ref then do:
      435     return substitute("Срез/итог по ДК c кодом &1 - срез не найден", p-dt-code).
      436   end.
      437   find first buf_prop-head no-lock where
      438           buf_prop-head.dtm-code = p-dtm-code no-error.
      439   if not available buf_prop-head then do:
      440     return substitute("Срез/итог по ДК &1 c кодом &2 - неизвестное", p-dt-code, p-dtm-code).
      441   end.
      442   find first buf_prop-map no-lock where
      443           buf_prop-map.dtm-code = p-dtm-code
      444       and buf_prop-map.node-code = p-node-code no-error .
      445   if not available buf_prop-map then do:
      446     return substitute("Срез/итог по ДК &1, &2.&3 - неизвестно"
      447                       , p-dt-code
      448                       , buf_prop-head.prop-label
      449                       , p-node-code).
      450   end.
      451   assign
      452   v-des = substitute("&1.&2 &3 &4"
      453                     , buf_prop-head.prop-label
      454                     , buf_prop-map.node-label
      455                     , buf_prop-ref.sum-id
      456                     , buf_prop-ref.caller_id).
      457   return v-des.
      458   end FUNCTION.
      459   function dct-algo-get-prev-sum-id RETURNS integer (
      460                                                       input p-dt-code as integer
      461                                                      ):
      462   define variable v-dtm-code as integer no-undo .
      463   define variable v-sum-id as character no-undo .
      464   define variable v-caller-id as character no-undo .
      465   define buffer buf_prop-ref for ub.prop-ref.
      466   find first buf_prop-ref no-lock where
      467           buf_prop-ref.dt-code = p-dt-code no-error.
      468   if not available buf_prop-ref then return ?.
      469   assign
      470   v-dtm-code = buf_prop-ref.dtm-code
      471   v-sum-id = buf_prop-ref.sum-id.
      472   v-caller-id = buf_prop-ref.caller_id.
      473   find last buf_prop-ref no-lock where
      474             buf_prop-ref.dtm-code = v-dtm-code
      475        and  buf_prop-ref.sum-id < v-sum-id
      476        and  buf_prop-ref.caller_id = v-caller-id
      477        no-error.
      478   if available buf_prop-ref then return buf_prop-ref.dt-code.
      479   return -1 .
      480   END FUNCTION.
      481   FUNCTION dct-algo-get_dcproperty-value returns logical (
      482                                                             input p-prop-name as character
      483                                                           , input p-d-card    as character
      484                                                           , input p-host-code as integer
      485                                                           , input p-obj-type  as character
      486                                                           , input p-obj-code  as integer
      487                                                           , output p-value-character as character
      488                                                           , output p-value-date   as date
      489                                                           , output p-value-integer as integer
      490                                                           , output p-value-decimal as decimal
      491                                                           , output p-value-logical as logical):
      492     return no.
      493   END FUNCTION.
      494   FUNCTION dct-algo-get_dcproperty-value-chr returns logical (
      495                                                             input p-d-card    as character
      496                                                           , input p-emitent-host-code as integer
      497                                                           , input p-type as character
      498                                                           , input p-host-code as integer
      499                                                           , input p-obj-type  as character
      500                                                           , input p-obj-code  as integer
      501                                                           , output p-value-chr as character):
      502   define variable v-dt-code as integer no-undo .
      503   define variable v-node-code as integer no-undo .
      504   define variable v-field-name as character no-undo .
      505   define variable v-storage-place as character no-undo .
      506   define variable v-sum-id-value as character no-undo .
      507   define variable v-sum-id-output as logical no-undo .
      508   define variable v-value-chr as character no-undo .
      509   define variable v-ii as integer no-undo .
      510   define buffer buf_dis-card-property for ub.dis-card-property.
      511   define buffer buf_dis-host for ub.dis-host.
      512   define buffer buf_dis-obj for ub.dis-obj.
      513   run get-cd-sumid in this-procedure (
      514                                         input p-emitent-host-code
      515                                        ,input p-type
      516                                        ,input p-host-code
      517                                        ,input p-obj-type
      518                                        ,input p-obj-code
      519                                        ,output v-sum-id-value
      520                                        ,output v-sum-id-output
      521                                       ) no-error.
      522   if not v-sum-id-output then do:
      523     return no.
      524   end.
      525   do v-ii = 1 to num-entries(v-sum-id-value):
      526     assign
      527     v-storage-place = entry(1, entry(v-ii, v-sum-id-value), chr(4))
      528     v-dt-code = integer(entry(2, entry(v-ii, v-sum-id-value), chr(4)))
      529     v-node-code = integer(entry(3, entry(v-ii, v-sum-id-value), chr(4)))
      530     v-field-name = entry(4, entry(v-ii, v-sum-id-value), chr(4))
      531     no-error .
      532     if not error-status:error then do:
      533       case v-storage-place:
      534         when 'dis-card-property':U then do:
      535           find first buf_dis-card-property no-lock where
      536                     buf_dis-card-property.d-card = p-d-card
      537               and  buf_dis-card-property.host-code = p-host-code
      538               and  buf_dis-card-property.obj-type = p-obj-type
      539               and  buf_dis-card-property.obj-code = p-obj-code
      540               and  buf_dis-card-property.dt-code = v-dt-code
      541               and  buf_dis-card-property.node-code = v-node-code no-error .
      542           if available buf_dis-card-property then do:
      543             v-value-chr = buffer buf_dis-card-property:handle:buffer-field(v-field-name):string-value.
      544           end.
      545           else do:
      546             v-value-chr = chr(63).
      547           end.
      548         end.
      549         when 'dis-obj':U then do:
      550           find first buf_dis-obj no-lock where
      551                     buf_dis-obj.d-card = p-d-card
      552               and  buf_dis-obj.obj-type = p-obj-type
      553               and  buf_dis-obj.obj-code = p-obj-code
      554               and  buf_dis-obj.dt-code = v-dt-code no-error .
      555           if available buf_dis-obj then do:
      556             v-value-chr = buffer buf_dis-obj:handle:buffer-field(v-field-name):string-value.
      557           end.
      558           else do:
      559             v-value-chr = chr(63).
      560           end.
      561         end.
      562         when 'dis-host':U then do:
      563           find first buf_dis-host no-lock where
      564                     buf_dis-host.d-card = p-d-card
      565               and  buf_dis-host.host-code = p-host-code
      566               and  buf_dis-host.dt-code = v-dt-code no-error .
      567           if available buf_dis-host then do:
      568             v-value-chr = buffer buf_dis-host:handle:buffer-field(v-field-name):string-value.
      569           end.
      570           else do:
      571             v-value-chr = chr(63).
      572           end.
      573         end.
      574       end.
      575     end.
      576     p-value-chr = p-value-chr + (if v-ii = 1 then '':U else chr(44)) + v-value-chr.
      577   end.
      578   END FUNCTION.
      579   FUNCTION dct-algo_custom-sent-description RETURNS CHARACTER
      580     ( INPUT p-custom-sent as character ) :
      581   DEFINE VARIABLE v-storage-place AS CHARACTER NO-UNDO.
      582   DEFINE VARIABLE v-dtm-code AS integer NO-UNDO.
      583   DEFINE VARIABLE v-sum-id AS character NO-UNDO.
      584   DEFINE VARIABLE v-caller-id AS character NO-UNDO.
      585   DEFINE VARIABLE v-node-code AS INTEGER NO-UNDO.
      586   DEFINE VARIABLE v-sum-id-description AS CHARACTER.
      587   DEFINE BUFFER buf_prop-ref FOR ub.prop-ref.
      588   IF p-custom-sent = chr(63) THEN RETURN "Не отсылать".
      589   assign
      590   v-storage-place = entry(1, p-custom-sent, chr(4))
      591   v-dtm-code = integer(entry(2, p-custom-sent, chr(4)))
      592   v-sum-id   = entry(3, p-custom-sent, chr(4))
      593   v-caller-id = entry(4, p-custom-sent, chr(4))
      594   v-node-code = integer(entry(5, p-custom-sent, chr(4)))
      595   no-error .
      596   IF ERROR-STATUS:ERROR THEN DO:
      597     MESSAGE
      598     "Не могу разобрать строку, описывающую итог"
      599      VIEW-AS ALERT-BOX WARNING.
      600     RETURN chr(63).
      601   END.
      602   FIND FIRST buf_prop-ref NO-LOCK WHERE
      603             buf_prop-ref.dtm-code = v-dtm-code
      604        AND  buf_prop-ref.sum-id = v-sum-id
      605        AND  buf_prop-ref.caller_id = v-caller-id NO-ERROR.
      606   IF NOT AVAILABLE buf_prop-ref THEN DO:
      607     FIND FIRST buf_prop-ref NO-LOCK WHERE
      608               buf_prop-ref.dtm-code = v-dtm-code
      609         AND  buf_prop-ref.caller_id = v-caller-id NO-ERROR.
      610     IF NOT AVAILABLE buf_prop-ref THEN DO:
      611         MESSAGE
      612         "Не могу разобрать строку, описывающую итог"
      613          VIEW-AS ALERT-BOX WARNING.
      614         RETURN chr(63).
      615      end.
      616   end.
      617   ASSIGN
      618   v-sum-id-description =  dct-algo-get-description-node-code ( v-dtm-code
      619                                                          ,buf_prop-ref.dt-code
      620                                                          ,v-node-code).
      621   RETURN v-sum-id-description.
      622   END FUNCTION.
      623   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      624   FUNCTION get-region RETURNS CHARACTER
      625     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      626     define variable par-region as character no-undo.
      627     if parhost-code = 0 and
      628          parobj-type = "":U and
      629          parobj-code = 0 then do:
      630          par-region = "Глобально".
      631          return par-region.
      632       end.
      633       if parobj-type = 'орг':U then do:
      634          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      635          return par-region.
      636       end.
      637       if parobj-type = 'регион':U
      638       then do:
      639          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      640          return par-region.
      641       end.
      642       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      643       return par-region.
      644   END FUNCTION.
      645   FUNCTION get-objregion RETURNS CHARACTER
      646     (  input parobj-type as character, input parobj-code as integer ) :
      647     define variable par-region as character no-undo.
      648     if  parobj-type = "":U and
      649         parobj-code = 0
      650     then do:
      651        par-region = "Глобально".
      652     end.
      653     else if parobj-type = 'орг':U
      654     then do:
      655        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      656     end.
      657     else if parobj-type = 'регион':U
      658     then do:
      659        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      660     end.
      661     else
      662        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      663     return par-region.
      664   END FUNCTION.
      665   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      666   procedure gen-key-rec :
      667     define input  parameter p-tbl-name    as character no-undo.
      668     define input  parameter p-bh_tbl-name as handle    no-undo.
      669     define output parameter p-key-rec     as character no-undo.
      670     do
      671     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      672     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      673     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      674     :
      675       define variable fh               as handle    no-undo .
      676       define variable v-ok             as logical   no-undo .
      677       define variable v-inform         as character no-undo .
      678       define variable v-ind            as integer   no-undo .
      679       define variable v-idx-field-qnty as integer   no-undo .
      680       if p-tbl-name = ?
      681         or p-tbl-name = "":U
      682       then do:
      683         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info3 ).
      684       end.
      685       if not p-bh_tbl-name:available then do:
      686         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info3, p-tbl-name ).
      687       end.
      688       assign
      689         p-key-rec = p-tbl-name
      690         v-inform  = p-bh_tbl-name:index-information(1)
      691         v-ind     = 2
      692       .
      693       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      694       on error undo, return error
      695       :
      696         assign
      697           v-inform = p-bh_tbl-name:index-information( v-ind )
      698           v-ind    = v-ind + 1
      699         .
      700       end.
      701       if v-inform = ?
      702         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      703         or entry( 3, v-inform, ",":U ) <> "1":U
      704       then do:
      705         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, p-tbl-name ).
      706       end.
      707       else do:
      708         assign
      709           v-idx-field-qnty = num-entries( v-inform ) - 4
      710         .
      711         if v-idx-field-qnty < 2 then do:
      712           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, p-tbl-name ).
      713         end.
      714         do v-ind = 1 to v-idx-field-qnty by 2
      715         on error undo, return error
      716         :
      717           assign
      718             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      719             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      720           .
      721         end.
      722       end.
      723       if p-key-rec = ? then do:
      724         assign
      725           p-key-rec = "":U
      726         .
      727         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info3, p-tbl-name ).
      728       end.
      729     end.
      730     return.
      731   end procedure.
      732   procedure gen-where-keyr-tab :
      733     define input  parameter i-tableSerach as character no-undo.
      734     define input  parameter i-tablekey   as character  no-undo.
      735     define input  parameter p-key-rec    as character  no-undo.
      736     define input  parameter p-key-handle as handle     no-undo .
      737     define input  parameter p-db-name    as character  no-undo .
      738     define input  parameter p-tt-handle  as handle     no-undo .
      739     define output parameter o-Where      as character  no-undo.
      740     do
      741     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      742     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      743     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      744     :
      745       define variable v-full-tbl-name  as character no-undo .
      746       define variable bh_tbl-name      as handle    no-undo .
      747       define variable fh_key           as handle    no-undo .
      748       define variable fh_search        as handle    no-undo .
      749       define variable v-field-num      as integer   no-undo .
      750       define variable v-count-fld      as integer   no-undo .
      751       define variable v-inform         as character no-undo .
      752       define variable v-ind            as integer   no-undo .
      753       define variable v-idx-field-qnty as integer   no-undo .
      754       define variable v-field-name     as character no-undo .
      755       define variable v-field-val      as character no-undo .
      756       define variable v-word-link      as character no-undo .
      757       define variable vTable           as character no-undo.
      758       define variable bh_tbl-key       as handle    no-undo .
      759       assign
      760         p-key-rec = trim( p-key-rec )
      761       .
      762       if p-key-handle <> ? then do:
      763         if not valid-handle(p-key-handle)
      764            or p-key-handle:type <> "buffer"
      765         then do:
      766           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info3 ).
      767         end.
      768         if num-entries( p-key-rec, chr(3) ) > 1
      769           or p-key-rec = ?
      770           or p-key-rec = "":U
      771         then do:
      772           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info3, p-key-rec ).
      773         end.
      774       end.
      775       else do:
      776         if p-key-rec = ?
      777           or p-key-rec = "":U
      778         then do:
      779           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
      780         end.
      781       end.
      782       assign
      783         vTable = entry( 1 , p-key-rec, chr(3) )
      784       .
      785       if p-tt-handle <> ?
      786         and ( not valid-handle(p-tt-handle)
      787               or p-tt-handle:type <> "buffer"
      788             )
      789       then do:
      790         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info3, vTable, chr(10) ).
      791       end.
      792       if p-tt-handle = ? then do:
      793         assign
      794           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      795         .
      796         create buffer bh_tbl-name for table v-full-tbl-name .
      797       end.
      798       else do:
      799         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      800       end.
      801       assign
      802         v-inform = bh_tbl-name:index-information(1)
      803         v-ind    = 2
      804       .
      805       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      806       on error undo, return error
      807       :
      808         assign
      809           v-inform = bh_tbl-name:index-information( v-ind )
      810           v-ind    = v-ind + 1
      811         .
      812       end.
      813       if v-inform = ?
      814         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      815         or entry( 3, v-inform, ",":U ) <> "1":U
      816       then do:
      817         delete object bh_tbl-name no-error.
      818         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info3, vTable ).
      819       end.
      820       assign
      821         v-idx-field-qnty = num-entries( v-inform ) - 4
      822       .
      823       if v-idx-field-qnty < 2 then do:
      824         delete object bh_tbl-name no-error.
      825         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, vTable ).
      826       end.
      827       assign
      828         o-where     = "where":U
      829         v-word-link = "":U
      830         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      831         v-count-fld = 0
      832       .
      833       if i-tablekey ne "" and i-tablekey ne ?
      834       then do:
      835         assign
      836           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      837         .
      838         create buffer bh_tbl-key for table v-full-tbl-name .
      839       end.
      840       if i-tableSerach ne "" and i-tableSerach ne ?
      841       then do:
      842         delete object bh_tbl-name no-error.
      843         assign
      844           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      845         .
      846         create buffer bh_tbl-name for table v-full-tbl-name .
      847       end.
      848       block_where:
      849       do v-ind = 1 to v-idx-field-qnty by 2
      850       on error undo, return error
      851       :
      852         assign
      853           v-count-fld = v-count-fld + 1
      854         .
      855         if p-key-handle = ?
      856           and v-count-fld > v-field-num
      857         then do:
      858           leave block_where.
      859         end.
      860         define variable VfieldKeyTable as handle no-undo.
      861         assign
      862           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      863           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      864         .
      865         if     bh_tbl-key ne ?
      866         then do:
      867            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      868            if VfieldKeyTable eq ?
      869            then next block_where.
      870         end.
      871         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      872         then
      873            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      874         else
      875            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      876         if p-key-handle = ? then do:
      877           assign
      878             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      879           .
      880         end.
      881         else do:
      882           assign
      883             fh_key = p-key-handle:buffer-field( v-field-name )
      884           .
      885           if fh_key = ?
      886             or not valid-handle( fh_key )
      887           then do:
      888             delete object bh_tbl-name.
      889             if     bh_tbl-key ne ?
      890             then
      891                delete object bh_tbl-key.
      892             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info3, p-key-handle:name, v-field-name ).
      893           end.
      894           assign
      895             v-field-val = fh_key:buffer-value
      896           .
      897         end.
      898         if fh_search:data-type ="character":U then do:
      899           assign
      900             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      901             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      902             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      903             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      904             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      905             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      906             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      907             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      908             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      909             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      910             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      911             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      912             v-field-val = substitute( '"&1"', v-field-val )
      913           .
      914         end.
      915         assign
      916           o-where = substitute( "&1 &2", o-where, v-field-val )
      917         .
      918         if v-word-link = "":U then do:
      919           assign
      920             v-word-link = "and":U
      921           .
      922         end.
      923       end.
      924       delete object bh_tbl-name.
      925       if     bh_tbl-key ne ?
      926       then
      927          delete object bh_tbl-key.
      928       if p-key-handle = ?
      929         and v-count-fld <> v-field-num
      930       then do:
      931         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info3, vTable ).
      932       end.
      933     end.
      934   end procedure.
      935   procedure gen-hn-keyr-tab :
      936     define input  parameter i-tableSerach as character no-undo.
      937     define input  parameter i-tablekey   as character no-undo.
      938     define input  parameter p-key-rec    as character no-undo.
      939     define input  parameter p-key-handle as handle    no-undo .
      940     define input  parameter p-db-name    as character no-undo .
      941     define input  parameter p-tt-handle  as handle    no-undo .
      942     define input  parameter p-stts-lock  as integer   no-undo .
      943     define output parameter o-hn         as handle    no-undo.
      944     define variable v-full-tbl-name as character no-undo.
      945     define variable v-where         as character no-undo.
      946     define variable bh_tbl-name     as handle    no-undo.
      947     define variable vTable          as character no-undo.
      948     do
      949     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      950     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      951     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      952         run gen-where-keyr-tab(i-tableSerach,
      953                                i-tablekey,
      954                                p-key-rec,
      955                                p-key-handle,
      956                                p-db-name,
      957                                p-tt-handle,
      958                                output v-where).
      959         if i-tableSerach ne "" and i-tableSerach ne ?
      960         then do:
      961            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      962            create buffer bh_tbl-name for table v-full-tbl-name .
      963         end.
      964         else do:
      965            if p-tt-handle = ? then do:
      966               assign
      967                  vTable = entry( 1 , p-key-rec, chr(3) )
      968               .
      969               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      970               create buffer bh_tbl-name for table v-full-tbl-name .
      971            end.
      972            else do:
      973               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      974            end.
      975         end.
      976         if p-tt-handle = ? then do:
      977            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      978         end.
      979         else do:
      980            bh_tbl-name:find-first( v-where ) no-error .
      981         end.
      982         o-hn = bh_tbl-name.
      983      end.
      984   end procedure.
      985   procedure gen-hn-keyr :
      986     define input  parameter p-key-rec    as character no-undo.
      987     define input  parameter p-key-handle as handle    no-undo .
      988     define input  parameter p-db-name    as character no-undo .
      989     define input  parameter p-tt-handle  as handle    no-undo .
      990     define input  parameter p-stts-lock  as integer   no-undo .
      991     define output parameter o-hn         as handle    no-undo.
      992     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      993   end.
      994   procedure gen-row-keyr :
      995     define input  parameter p-key-rec    as character no-undo.
      996     define input  parameter p-key-handle as handle    no-undo .
      997     define input  parameter p-db-name    as character no-undo .
      998     define input  parameter p-tt-handle  as handle    no-undo .
      999     define input  parameter p-stts-lock  as integer   no-undo .
     1000     define output parameter p-tbl-row    as rowid     no-undo.
     1001     define output parameter p-tbl-name   as character no-undo.
     1002     define variable vHn as handle no-undo.
     1003       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1004       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1005       p-tbl-name =  vHn:table.
     1006       delete object vHn no-error.
     1007     if p-tbl-row = ? then do:
     1008       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info3, p-tbl-name, p-key-rec ).
     1009     end.
     1010     else do:
     1011       return.
     1012     end.
     1013   end procedure.
     1014   procedure gen-key-fv :
     1015     define input  parameter p-key-rec    as character no-undo .
     1016     define output parameter p-field-list as character no-undo .
     1017     define output parameter p-value-list as character no-undo.
     1018     do
     1019     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1020     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1021     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1022     :
     1023       define variable v-full-tbl-name  as character no-undo .
     1024       define variable bh_tbl-name      as handle    no-undo .
     1025       define variable v-tbl-name       as character no-undo .
     1026       define variable v-field-num      as integer   no-undo .
     1027       define variable v-count-fld      as integer   no-undo .
     1028       define variable v-inform         as character no-undo .
     1029       define variable v-ind            as integer   no-undo .
     1030       define variable v-idx-field-qnty as integer   no-undo .
     1031       define variable v-delim-key      as character no-undo .
     1032       if p-key-rec = ?
     1033         or p-key-rec = "":U
     1034       then do:
     1035         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info3 ).
     1036       end.
     1037       assign
     1038         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1039         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1040       .
     1041       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1042       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info3 ).
     1043       assign
     1044         v-inform = bh_tbl-name:index-information(1)
     1045         v-ind    = 2
     1046       .
     1047       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1048       on error undo, return error
     1049       :
     1050         assign
     1051           v-inform = bh_tbl-name:index-information( v-ind )
     1052           v-ind    = v-ind + 1
     1053         .
     1054       end.
     1055       if v-inform = ?
     1056         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1057         or entry( 3, v-inform, ",":U ) <> "1":U
     1058       then do:
     1059         delete object bh_tbl-name no-error.
     1060         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
     1061       end.
     1062       assign
     1063         v-idx-field-qnty = num-entries( v-inform ) - 4
     1064       .
     1065       if v-idx-field-qnty < 2 then do:
     1066         delete object bh_tbl-name no-error.
     1067         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
     1068       end.
     1069       assign
     1070         p-field-list = "":U
     1071         p-value-list = "":U
     1072         v-delim-key  = "":U
     1073         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1074         v-count-fld  = 0
     1075       .
     1076       block_where:
     1077       do v-ind = 1 to v-idx-field-qnty by 2
     1078       on error undo, return error
     1079       :
     1080         assign
     1081           v-count-fld = v-count-fld + 1
     1082         .
     1083         if v-count-fld > v-field-num then do:
     1084           leave block_where.
     1085         end.
     1086         assign
     1087           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1088           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1089         .
     1090         if v-ind = 1 then do:
     1091           assign
     1092             v-delim-key = chr(3)
     1093           .
     1094         end.
     1095       end.
     1096       delete object bh_tbl-name.
     1097       if v-count-fld <> v-field-num then do:
     1098         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info3, v-tbl-name ).
     1099       end.
     1100     end.
     1101   end procedure.
     1102   procedure gen-key-field :
     1103     define input  parameter p-table      as character no-undo .
     1104     define output parameter p-field-list as character no-undo .
     1105     do
     1106     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1107     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1108     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1109     :
     1110       define variable v-full-tbl-name  as character no-undo .
     1111       define variable bh_tbl-name      as handle    no-undo .
     1112       define variable v-tbl-name       as character no-undo .
     1113       define variable v-field-num      as integer   no-undo .
     1114       define variable v-count-fld      as integer   no-undo .
     1115       define variable v-inform         as character no-undo .
     1116       define variable v-ind            as integer   no-undo .
     1117       define variable v-idx-field-qnty as integer   no-undo .
     1118       define variable v-delim-key      as character no-undo .
     1119       if p-table = ?
     1120         or p-table = "":U
     1121       then do:
     1122         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info3 ).
     1123       end.
     1124       assign
     1125         v-tbl-name      = p-table
     1126         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1127       .
     1128       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1129       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info3 ).
     1130       assign
     1131         v-inform = bh_tbl-name:index-information(1)
     1132         v-ind    = 2
     1133       .
     1134       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1135       on error undo, return error
     1136       :
     1137         assign
     1138           v-inform = bh_tbl-name:index-information( v-ind )
     1139           v-ind    = v-ind + 1
     1140         .
     1141       end.
     1142       if v-inform = ?
     1143         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1144         or entry( 3, v-inform, ",":U ) <> "1":U
     1145       then do:
     1146         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info3, v-tbl-name ).
     1147       end.
     1148       assign
     1149         v-idx-field-qnty = num-entries( v-inform ) - 4
     1150       .
     1151       if v-idx-field-qnty < 2 then do:
     1152         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info3, v-inform, v-tbl-name ).
     1153       end.
     1154       assign
     1155         p-field-list = "":U
     1156         v-delim-key  = "":U
     1157         v-count-fld  = 0
     1158       .
     1159       block_where:
     1160       do v-ind = 1 to v-idx-field-qnty by 2
     1161       on error undo, return error
     1162       :
     1163         assign
     1164           v-count-fld = v-count-fld + 1
     1165         .
     1166         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1167         if v-ind = 1 then do:
     1168           assign
     1169             v-delim-key = chr(3)
     1170           .
     1171         end.
     1172       end.
     1173       delete object bh_tbl-name.
     1174     end.
     1175   end procedure.
     1176   DEFINE VARIABLE v-sum-id-value1 AS CHARACTER NO-UNDO.
     1177   DEFINE VARIABLE v-sum-id-value2 AS CHARACTER NO-UNDO.
     1178   DEFINE BUTTON B-exit AUTO-GO
     1179        LABEL "&Ввод"
     1180        SIZE 10 BY 1
     1181        BGCOLOR 8 .
     1182   DEFINE BUTTON B-Help
     1183        LABEL "Помо&щь"
     1184        SIZE 3 BY 1
     1185        BGCOLOR 8 .
     1186   DEFINE BUTTON b-quit AUTO-END-KEY
     1187        LABEL "&Отмена"
     1188        SIZE 10 BY 1
     1189        BGCOLOR 8 .
     1190   DEFINE BUTTON b-sum-id
     1191        IMAGE-UP FILE "btn-down-arrow":U
     1192        IMAGE-DOWN FILE "btn-down-arrow":U
     1193        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1194        LABEL "Btn 1"
     1195        SIZE 3.5 BY 1.07.
     1196   DEFINE BUTTON b-sum-id-2
     1197        IMAGE-UP FILE "btn-down-arrow":U
     1198        IMAGE-DOWN FILE "btn-down-arrow":U
     1199        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1200        LABEL "Btn 1"
     1201        SIZE 3.5 BY 1.07.
     1202   DEFINE VARIABLE f-sum-id-output AS CHARACTER FORMAT "X(256)":U
     1203        VIEW-AS FILL-IN NATIVE
     1204        SIZE 64 BY 1 NO-UNDO.
     1205   DEFINE VARIABLE f-sum-id-output-2 AS CHARACTER FORMAT "X(256)":U
     1206        VIEW-AS FILL-IN NATIVE
     1207        SIZE 64 BY 1 NO-UNDO.
     1208   DEFINE VARIABLE cardname-sent AS CHARACTER
     1209        VIEW-AS RADIO-SET VERTICAL
     1210        RADIO-BUTTONS
     1211             "Item 1", "1":U,
     1212   "Item 2", "2":U
     1213        SIZE 25.5 BY 1.77 NO-UNDO.
     1214   DEFINE VARIABLE t-sum-id-output AS LOGICAL INITIAL no
     1215        LABEL "Настраивать поле 1"
     1216        VIEW-AS TOGGLE-BOX
     1217        SIZE 24.5 BY 1 NO-UNDO.
     1218   DEFINE VARIABLE t-sum-id-output-2 AS LOGICAL INITIAL no
     1219        LABEL "Настраивать поле 2"
     1220        VIEW-AS TOGGLE-BOX
     1221        SIZE 24.5 BY 1 NO-UNDO.
     1222   DEFINE FRAME Dialog-Frame
     1223        B-exit AT ROW 1 COL 1
     1224        b-quit AT ROW 1 COL 11
     1225        B-Help AT ROW 1 COL 95
     1226        cardname-sent AT ROW 3 COL 44.5 NO-LABEL
     1227        t-sum-id-output AT ROW 5.27 COL 2 WIDGET-ID 26
     1228        f-sum-id-output AT ROW 5.27 COL 26 COLON-ALIGNED NO-LABEL WIDGET-ID 8
     1229        b-sum-id AT ROW 5.27 COL 93 WIDGET-ID 6
     1230        t-sum-id-output-2 AT ROW 7.4 COL 1.5 WIDGET-ID 28
     1231        f-sum-id-output-2 AT ROW 7.4 COL 26 COLON-ALIGNED NO-LABEL WIDGET-ID 18
     1232        b-sum-id-2 AT ROW 7.4 COL 93 WIDGET-ID 20
     1233        "Поле ДЕРЖАТЕЛЬ карты" VIEW-AS TEXT
     1234             SIZE 23 BY 1 AT ROW 3 COL 3 WIDGET-ID 16
     1235             FGCOLOR 4
     1236        SPACE(73.79) SKIP(5.29)
     1237       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1238            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1239            FGCOLOR 4
     1240            TITLE FGCOLOR 4 ""
     1241            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     1242   ASSIGN
     1243          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1244          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1245   ASSIGN
     1246          f-sum-id-output:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1247   ASSIGN
     1248          f-sum-id-output-2:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1249   ON GO OF FRAME Dialog-Frame
     1250   DO:
     1251     ASSIGN
     1252     cardname-sent
     1253     p-cardname-sent = cardname-sent
     1254     p-custom-sent = substitute("&1,&2"
     1255                                ,v-sum-id-value1
     1256                                ,v-sum-id-value2)
     1257     p-ok = YES
     1258     .
     1259   END.
     1260   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1261   DO:
     1262     APPLY "END-ERROR":U TO SELF.
     1263   END.
     1264   ON CHOOSE OF b-sum-id IN FRAME Dialog-Frame
     1265   DO:
     1266     RUN proc-b-sum-id IN THIS-PROCEDURE (INPUT-OUTPUT v-sum-id-value1) NO-ERROR.
     1267     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1268     ASSIGN
     1269     f-sum-id-output =  dct-algo_custom-sent-description(v-sum-id-value1).
     1270     DISPLAY
     1271     f-sum-id-output
     1272     WITH FRAME Dialog-Frame.
     1273   END.
     1274   ON CHOOSE OF b-sum-id-2 IN FRAME Dialog-Frame
     1275   DO:
     1276     RUN proc-b-sum-id IN THIS-PROCEDURE (INPUT-OUTPUT v-sum-id-value2) NO-ERROR.
     1277     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1278     ASSIGN
     1279     f-sum-id-output-2 =  dct-algo_custom-sent-description(v-sum-id-value2).
     1280     DISPLAY
     1281     f-sum-id-output-2
     1282     WITH FRAME Dialog-Frame.
     1283   END.
     1284   ON VALUE-CHANGED OF t-sum-id-output IN FRAME Dialog-Frame
     1285   DO:
     1286     ASSIGN
     1287     t-sum-id-output.
     1288     CASE t-sum-id-output:
     1289       WHEN YES  THEN DO:
     1290         ENABLE b-sum-id
     1291         WITH FRAME Dialog-Frame.
     1292         APPLY "CHOOSE" TO b-sum-id.
     1293       END.
     1294       WHEN NO THEN DO:
     1295         ASSIGN
     1296         v-sum-id-VALUE1 = chr(63)
     1297         f-sum-id-output =  dct-algo_custom-sent-description(v-sum-id-value1).
     1298         DISPLAY
     1299         f-sum-id-output
     1300         WITH FRAME Dialog-Frame.
     1301         DISABLE b-sum-id
     1302         WITH FRAME Dialog-Frame.
     1303       END.
     1304     END CASE.
     1305   END.
     1306   ON VALUE-CHANGED OF t-sum-id-output-2 IN FRAME Dialog-Frame
     1307   DO:
     1308       ASSIGN
     1309     t-sum-id-output-2.
     1310     CASE t-sum-id-output-2:
     1311       WHEN YES  THEN DO:
     1312         ENABLE b-sum-id-2
     1313         WITH FRAME Dialog-Frame.
     1314         APPLY "CHOOSE" TO b-sum-id-2.
     1315       END.
     1316       WHEN NO THEN DO:
     1317         ASSIGN
     1318         v-sum-id-VALUE2 = chr(63)
     1319         f-sum-id-output-2 =  dct-algo_custom-sent-description(v-sum-id-value2).
     1320         DISPLAY
     1321         f-sum-id-output-2
     1322         WITH FRAME Dialog-Frame.
     1323         DISABLE b-sum-id-2
     1324         WITH FRAME Dialog-Frame.
     1325       END.
     1326     END CASE.
     1327   END.
     1328   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1329   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1330   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1331   on help of frame Dialog-Frame
     1332   do:
     1333     run gbl/app_help.p
     1334       (input this-procedure :file-name
     1335       ,input ''
     1336       ,input ?
     1337       ) no-error.
     1338     if error-status :error then do:
     1339       message
     1340         "Ошибка при вызове помощи"
     1341         error-status :get-message(1)
     1342         view-as alert-box .
     1343     end.
     1344   end.
     1345   run minbtn-set in this-procedure .
     1346   on choose of b-help in frame Dialog-Frame
     1347   do:
     1348     apply "help":u to frame Dialog-Frame .
     1349   end.
     1350   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1351   procedure minbtn-set :
     1352       do
     1353           on error undo, return error return-value
     1354           :
     1355           define variable ii              as integer       no-undo .
     1356           define variable fh              as widget-handle no-undo .
     1357           define variable hh              as widget-handle no-undo .
     1358           define variable v-h             as handle        extent 4 no-undo .
     1359           define variable v-name-button   as character     no-undo .
     1360           define variable v-help-old-x    as decimal       no-undo .
     1361           define variable v-help-old-y    as decimal       no-undo .
     1362           define variable v-help-old-size as decimal       no-undo .
     1363           define variable v-frame-width   as decimal       no-undo .
     1364           define variable jj              as integer       no-undo .
     1365           do
     1366               on error undo, return error
     1367               :
     1368               assign
     1369                   v-frame-width = frame Dialog-Frame:width - 0.3
     1370                   fh            = frame Dialog-Frame:first-child
     1371                   hh            = fh:first-child
     1372                   ii            = 1
     1373                   .
     1374               do while valid-handle(hh):
     1375                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1376                   do:
     1377                       case lc(hh:name) :
     1378                           when "b-help" then
     1379                               do:
     1380                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1381                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1382                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1383                                   hh:TOOLTIP = "Помощь" .
     1384                                   v-help-old-x = hh:column .
     1385                                   v-help-old-y = hh:row    .
     1386                                   v-help-old-size = hh:width .
     1387                                   hh:width-chars = 2.5 .
     1388                               end.
     1389                           when "b-print" then
     1390                               do:
     1391                                   hh:load-image("cmp/b-print.bmp":u) .
     1392                                   hh:TOOLTIP = "Печать" .
     1393                                   v-h[ii] = hh:handle .
     1394                                   ii = ii + 1 .
     1395                                   hh:width-chars = 3 .
     1396                               end.
     1397                           when "b-history" or
     1398                           when "b-hist" then
     1399                               do:
     1400                                   hh:load-image("cmp/b-hist.bmp":u) .
     1401                                   hh:TOOLTIP = "История" .
     1402                                   v-h[ii] = hh:handle .
     1403                                   ii = ii + 1 .
     1404                                   hh:width-chars = 3 .
     1405                               end.
     1406                           when "b-sch" then
     1407                               do:
     1408                                   hh:load-image("cmp/b-sch.bmp":u) .
     1409                                   hh:TOOLTIP = "Установка Фильтра" .
     1410                                   v-h[ii] = hh:handle .
     1411                                   ii = ii + 1 .
     1412                                   hh:width-chars = 3 .
     1413                               end.
     1414                           when "b-hist-user" then
     1415                               do:
     1416                                   hh:load-image("cmp/b-hist.bmp":u) .
     1417                                   hh:TOOLTIP = "История пользователя" .
     1418                                   ii = ii + 1 .
     1419                               end.
     1420                       end case.
     1421                   end.
     1422                   hh = hh:next-sibling.
     1423               end.
     1424               b-help:column = v-frame-width - b-help:width-chars.
     1425               jj = 0.
     1426               repeat ii = 4 to 1 by -1 :
     1427                   if valid-handle (v-h[ii] ) then
     1428                   do:
     1429                       jj  = jj + 1 .
     1430                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1431                       v-h[ii]:row    = v-help-old-y .
     1432                   end.
     1433               end.
     1434           end.
     1435       end.
     1436   end procedure.
     1437   MAIN-BLOCK:
     1438   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1439      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1440     RUN Myenable in this-procedure .
     1441     WAIT-FOR GO OF FRAME Dialog-Frame.
     1442   END.
     1443   RUN disable_UI.
     1444   PROCEDURE disable_UI :
     1445     HIDE FRAME Dialog-Frame.
     1446   END PROCEDURE.
     1447   PROCEDURE enable_UI :
     1448     DISPLAY cardname-sent t-sum-id-output f-sum-id-output t-sum-id-output-2
     1449             f-sum-id-output-2
     1450         WITH FRAME Dialog-Frame.
     1451     ENABLE B-exit b-quit B-Help cardname-sent t-sum-id-output f-sum-id-output
     1452            b-sum-id t-sum-id-output-2 f-sum-id-output-2 b-sum-id-2
     1453         WITH FRAME Dialog-Frame.
     1454     VIEW FRAME Dialog-Frame.
     1455   END PROCEDURE.
     1456   PROCEDURE MyEnable :
     1457   ASSIGN
     1458   cardname-sent:RADIO-BUTTONS in frame Dialog-Frame =  'ФИО' + chr(44) +
     1459                                     'name':U +  chr(44) +
     1460                                    'N карты' + chr(44) +
     1461                                    'card':U
     1462   v-sum-id-value1 = entry(1, p-custom-sent)
     1463   v-sum-id-value2 = (if num-entries(p-custom-sent) > 1
     1464                      then entry(2, p-custom-sent)
     1465                      else chr(63))
     1466   f-sum-id-output = dct-algo_custom-sent-description ( input v-sum-id-value1)
     1467   f-sum-id-output-2 = dct-algo_custom-sent-description ( input v-sum-id-value2)
     1468   t-sum-id-output = NOT (v-sum-id-value1 = chr(63))
     1469   t-sum-id-output-2 = NOT (v-sum-id-value2 = chr(63))
     1470   frame Dialog-Frame:title = "Настройка информации, передаваемой на кассу по картам данного типа"
     1471   .
     1472   DISPLAY
     1473   f-sum-id-output
     1474   f-sum-id-output-2
     1475   t-sum-id-output
     1476   t-sum-id-output-2
     1477   WITH FRAME Dialog-Frame.
     1478   cardname-sent = p-cardname-sent.
     1479   DISPLAY
     1480   cardname-sent
     1481   f-sum-id-output-2
     1482   f-sum-id-output
     1483   WITH FRAME Dialog-Frame.
     1484   ENABLE
     1485   B-exit when p-mode <> 'ПРОСМОТР':U
     1486   b-quit
     1487   B-Help
     1488   cardname-sent WHEN p-mode <> 'ПРОСМОТР':U
     1489   b-sum-id        WHEN (p-mode <> 'ПРОСМОТР':U AND v-sum-id-value1 <> chr(63))
     1490   b-sum-id-2    WHEN (p-mode <> 'ПРОСМОТР':U AND v-sum-id-value2 <> chr(63))
     1491   t-sum-id-output WHEN p-mode <> 'ПРОСМОТР':U
     1492   t-sum-id-output-2 WHEN p-mode <> 'ПРОСМОТР':U
     1493   WITH FRAME Dialog-Frame.
     1494   if p-mode = 'ПРОСМОТР':U then do:
     1495     assign
     1496     b-quit:label = "&Выход"
     1497     b-quit:column = 1
     1498     .
     1499     hide
     1500     b-exit
     1501     in frame Dialog-Frame .
     1502   end.
     1503   VIEW FRAME Dialog-Frame.
     1504   END PROCEDURE.
     1505   PROCEDURE proc-b-sum-id :
     1506   DEFINE INPUT-output PARAMETER p-sum-id-value AS CHARACTER.
     1507   define variable v-rid-list-0 as character no-undo .
     1508   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1509   DEFINE VARIABLE v-rid-list2 AS CHARACTER NO-UNDO.
     1510   DEFINE VARIABLE v-storage-place AS CHARACTER NO-UNDO.
     1511   DEFINE VARIABLE v-dtm-code AS integer NO-UNDO.
     1512   DEFINE VARIABLE v-sum-id AS character NO-UNDO.
     1513   DEFINE VARIABLE v-caller-id AS character NO-UNDO.
     1514   DEFINE VARIABLE v-node-code AS INTEGER NO-UNDO.
     1515   define variable v-uniq-key-rec as character no-undo .
     1516   DEFINE BUFFER buf_prop-ref FOR ub.prop-ref.
     1517   DEFINE BUFFER buf_prop-map FOR ub.prop-map.
     1518   DEFINE BUFFER buf_prop-head FOR ub.prop-head.
     1519   define buffer buf_dis-card-type for ub.dis-card-type.
     1520   if p-sum-id-value <> chr(63) then do:
     1521     assign
     1522     v-storage-place = entry(1, p-sum-id-value, chr(4))
     1523     v-dtm-code = integer(entry(2, p-sum-id-value, chr(4)))
     1524     v-sum-id   = entry(3, p-sum-id-value, chr(4))
     1525     v-caller-id = entry(4, p-sum-id-value, chr(4))
     1526     v-node-code = integer(entry(5, p-sum-id-value, chr(4)))
     1527     no-error .
     1528     IF ERROR-STATUS:ERROR THEN DO:
     1529       MESSAGE
     1530       "Не могу разобрать строку, описывающую итог"
     1531       VIEW-AS ALERT-BOX WARNING.
     1532     END.
     1533     FIND FIRST buf_prop-ref NO-LOCK WHERE
     1534               buf_prop-ref.dtm-code = v-dtm-code
     1535         AND  buf_prop-ref.sum-id = v-sum-id
     1536         AND  buf_prop-ref.caller_id = v-caller-id NO-ERROR.
     1537     IF AVAILABLE buf_prop-ref THEN DO:
     1538       ASSIGN
     1539       v-rid-list = STRING(RECID(buf_prop-ref)).
     1540     END.
     1541     else do:
     1542       FIND FIRST buf_prop-ref NO-LOCK WHERE
     1543                 buf_prop-ref.dtm-code = v-dtm-code
     1544           AND  buf_prop-ref.caller_id = v-caller-id NO-ERROR.
     1545       IF AVAILABLE buf_prop-ref THEN DO:
     1546         ASSIGN
     1547         v-rid-list = STRING(RECID(buf_prop-ref)).
     1548       end.
     1549     end.
     1550   end.
     1551   MESSAGE
     1552   substitute("Выберите срез/итог&1" +
     1553              "Если Вы выберете срез/итог для конкретного временного периода,&1" +
     1554              "то на кассу автоматически будут посылаться данные за ТЕКУЩИЙ временной период"
     1555              , chr(10))
     1556   VIEW-AS ALERT-BOX .
     1557   if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
     1558     find first buf_dis-card-type no-lock where
     1559             buf_dis-card-type.emitent-host-code = p-emitent-host-code
     1560         and buf_dis-card-type.type = p-type
     1561         and buf_dis-card-type.host-code = 0
     1562         and buf_dis-card-type.obj-type = '':U
     1563         and buf_dis-card-type.obj-code = 0 .
     1564       run gen-key-rec in this-procedure (
     1565                                           input  'dis-card-type':U
     1566                                           ,input  buffer buf_dis-card-type:handle
     1567                                           ,output v-uniq-key-rec
     1568                                           ) .
     1569   end.
     1570   v-rid-list-0 = v-rid-list.
     1571   run ref/proprefs.w (
     1572                         input parparentproc
     1573                       , input 'b-sel'
     1574                       , input "call_id"
     1575                       , input 0
     1576                       , input '':U
     1577                       , input v-uniq-key-rec
     1578                       , input-output v-rid-list ) NO-ERROR.
     1579   IF v-rid-list = '':U
     1580   or v-rid-list = v-rid-list-0
     1581   THEN DO:
     1582    RETURN ERROR.
     1583   END.
     1584   FIND FIRST buf_prop-ref NO-LOCK WHERE
     1585              RECID(buf_prop-ref) = INTEGER(STRING(v-rid-list)) NO-ERROR.
     1586   IF NOT AVAILABLE buf_prop-ref THEN do:
     1587     MESSAGE
     1588     substitute("Не найден срез/итога с recid &1", v-rid-list)
     1589     VIEW-AS ALERT-BOX.
     1590     undo, RETURN ERROR.
     1591   END.
     1592   MESSAGE
     1593   substitute("Выберите свойство, значение которого будет посылаться на кассу&1"
     1594              , chr(10))
     1595   VIEW-AS ALERT-BOX .
     1596   FIND FIRST buf_prop-map NO-LOCK WHERE
     1597             buf_prop-map.dtm-code = v-dtm-code
     1598        AND  buf_prop-map.node-code = v-node-code
     1599         NO-ERROR.
     1600   IF AVAILABLE buf_prop-map THEN DO:
     1601     ASSIGN
     1602     v-rid-list2 = STRING(RECID(buf_prop-map)).
     1603   END.
     1604   run rul/prop-map-s.w (
     1605                          input parparentproc
     1606                         ,INPUT "b-sel"
     1607                         ,INPUT "dtm-code"
     1608                         ,INPUT buf_prop-ref.dtm-code
     1609                         ,INPUT-OUTPUT v-rid-list2) NO-ERROR.
     1610   IF v-rid-list2 = '':U THEN DO:
     1611       RETURN ERROR.
     1612   END.
     1613   FIND FIRST buf_prop-map NO-LOCK WHERE
     1614              RECID(buf_prop-map) = INTEGER(STRING(v-rid-list2)) NO-ERROR.
     1615   IF NOT AVAILABLE buf_prop-map THEN do:
     1616     MESSAGE
     1617     substitute("Не найдено свойство recid &1", v-rid-list2)
     1618     VIEW-AS ALERT-BOX.
     1619     undo, RETURN ERROR.
     1620   END.
     1621   find FIRST buf_prop-head NO-LOCK WHERE
     1622           buf_prop-head.dtm-code = buf_prop-map.dtm-code NO-ERROR.
     1623   IF NOT AVAILABLE buf_prop-head THEN RETURN ERROR.
     1624   ASSIGN
     1625   p-sum-id-value = SUBSTITUTE("&2&1&3&1&4&1&5&1&6"
     1626                                ,chr(4)
     1627                                ,buf_prop-head.storage-place
     1628                                ,buf_prop-head.dtm-code
     1629                                ,buf_prop-ref.sum-id
     1630                                ,buf_prop-ref.caller_id
     1631                                ,buf_prop-map.node-code) .
     1632   END PROCEDURE.
