        1   block-level on error undo, throw.
        2   define input-output parameter p-doc-rec as recid no-undo.
        3   define input parameter p-mode            as character no-undo .
        4   define input parameter p-alpha1          like ub.country.alpha1 no-undo .
        5   define input parameter p-alpha2          like ub.country.alpha1 no-undo .
        6   define input parameter p-num-code        like ub.country.num-code no-undo .
        7   define input parameter p-short-name      like ub.country.short-name no-undo .
        8   define input parameter p-long-name       like ub.country.long-name no-undo .
        9   define variable vss-revision    as character no-undo init "$Revision: 1e1fd253f7ac, 1111, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: ASMorozov $":U .
       11   define variable vss-date        as character no-undo init "$Date: Thu Dec 14 02:13:53 2017 +0300 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: country1.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: ref/country1.p $":U .
       14   define variable vss-description as character no-undo init "Сохранение изменений в карточке страны".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define variable v-db-num like ub.db.db-num no-undo .
       76   define variable v-msg as character no-undo.
       77   define shared variable g#esys as logical no-undo.
       78   if p-mode <> 'ДОБАВЛЕНИЕ':U
       79   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
       80     run err-mess (string (vss-workfile + vss-revision + vss-description + chr(10) +
       81       "Неверный параметр p-mode" + p-mode) ).
       82     return error v-msg + '':u.
       83   end.
       84   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       85   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
       86     (output v-db-num
       87     )  .
       88   if v-db-num <> 0 then do:
       89     run err-mess (substitute("Нельзя изменять запись СТРАНЫ в УБД: Номер текущей БД &1"
       90                   , v-db-num) ).
       91     undo, return error v-msg + "":U.
       92   end.
       93   if p-short-name = "":U
       94   then do:
       95     run err-mess ("Короткое название СТРАНЫ не может быть пустым").
       96     undo, return error v-msg + "short-name":U.
       97   end.
       98   if p-long-name = "":U
       99   then do:
      100     run err-mess ("Длинное название СТРАНЫ не может быть пустым").
      101     undo, return error v-msg + "short-name":U.
      102   end.
      103   if p-num-code = 0
      104   or p-num-code = ?
      105   then do:
      106     run err-mess ("Цифровой код СТРАНЫ не может равняться 0").
      107     undo, return error v-msg + "num-code":U.
      108   end.
      109   if p-alpha1 = "":U
      110   then do:
      111     run err-mess ("Буквенный код СТРАНЫ не может быть пустым").
      112     undo, return error v-msg + "alpha1":U.
      113   end.
      114   if p-alpha2 = "":U
      115   then do:
      116     run err-mess ("Буквенный код СТРАНЫ не может быть пустым").
      117     undo, return error v-msg + "alpha2":U.
      118   end.
      119   if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      120     if can-find(first ub.country no-lock where ub.country.alpha1 = p-alpha1) then do:
      121       run err-mess (substitute("Уже есть страна с буквенным кодом -1, равным &1", p-alpha1)).
      122       undo, return error v-msg + "alpha2":U.
      123     end.
      124     if can-find(first ub.country no-lock where ub.country.alpha1 = p-alpha2) then do:
      125       run err-mess (substitute("Уже есть страна с буквенным кодом - 2, равным &1", p-alpha2)).
      126       undo, return error v-msg + "alpha2":U.
      127    end.
      128     if can-find(first ub.country no-lock where ub.country.num-code = p-num-code) then do:
      129       run err-mess (substitute("Уже есть страна с цифровым кодом, равным &1", p-num-code)).
      130       undo, return error v-msg + "num-code":U.
      131    end.
      132   end.
      133   _MAIN:
      134   DO ON ERROR UNDO, RETURN ERROR
      135   ON STOP UNDO, RETURN ERROR:
      136     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      137       create ub.country.
      138       assign
      139       ub.country.alpha1 = p-alpha1
      140       ub.country.num-code = p-num-code
      141       p-doc-rec = recid(ub.country)
      142       .
      143     end.
      144     else do:
      145       FIND FIRST ub.country where
      146                 recid(ub.country) = p-doc-rec No-ERROR.
      147       if not available ub.country then do:
      148         message
      149         vss-workfile vss-revision vss-description skip
      150         "Не найдена запись СТРАНЫ - p-doc-rec" p-doc-rec
      151         view-as alert-box error .
      152         undo, return error v-msg + '':u.
      153       end.
      154       if ub.country.alpha1 <> p-alpha1
      155       or ub.country.num-code <> p-num-code
      156       then do:
      157         message
      158         vss-workfile vss-revision vss-description skip
      159         "Для уже имеющейся записи нельзя изменить"
      160         "цифровой код и/или буквенный код - 1" skip
      161         view-as alert-box ERROR.
      162         undo, return error v-msg + '':U.
      163       end.
      164     end.
      165     assign
      166     ub.country.alpha2     = p-alpha2
      167     ub.country.short-name = p-short-name
      168     ub.country.long-name  = p-long-name
      169     .
      170     release ub.country no-error.
      171     if error-status:error then do:
      172        run err-mess(substitute("Ошибка при сохранении записи СТРАНЫ с буквенным кодом &1: &2: &3"
      173                                , p-alpha1
      174                                , ERROR-STATUS:GET-message(1)
      175                                , return-value
      176                                )).
      177       undo, return error v-msg + "":U.
      178    end.
      179   end.
      180   PROCEDURE err-mess:
      181     DEFINE INPUT PARAMETER p-mess as character No-UNDO.
      182     if not g#esys
      183       then
      184         message
      185         p-mess
      186         view-as alert-box error .
      187       else v-msg = p-mess.
      188   END PROCEDURE.
