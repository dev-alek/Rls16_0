     3509         filter-label = substitute("&1", filter-label0)
     3510         .
     3511   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3512   define variable  l-disable-where-27  as logical   no-undo .
