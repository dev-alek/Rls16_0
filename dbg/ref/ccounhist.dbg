     1078   FUNCTION get-all-fields returns character (p-file-name as character ):
     1079   define variable v-dop as character no-undo .
     1080     find first _file no-lock where _file._file-name = p-file-name no-error .
     1081     if not available _file then return "":U.
     1082     for each _field no-lock where
     1083              _field._file-recid = recid(_file) :
     1084       assign
     1085       v-dop = v-dop + _field._field-name + chr(44)
     1086       .
     1087     end.
     1088     return trim(v-dop).
     1089   END FUNCTION.
     1090   PROCEDURE proc-full-temp-changes :
     1091     define input  parameter p-act-create as logical   no-undo .
     1092     define input  parameter p-act-delete as logical   no-undo .
     1093     define input  parameter p-hst-handle as handle    no-undo .
     1094     define input  parameter p-main-table as character no-undo .
     1095     define input  parameter p-field-list as character no-undo .
     1096     define input  parameter p-label-form as character no-undo .
     1097     define variable h-new-buf         as handle    no-undo .
     1098     define variable h-main-buf        as handle    no-undo .
     1099     define variable h-for-comp        as handle    no-undo .
     1100     define variable v-inform          as character no-undo .
     1101     define variable v-ind             as integer   no-undo .
     1102     define variable v-idx-field-qnty  as integer   no-undo .
     1103     define variable v-num-entries     as integer   no-undo .
     1104     define variable fh                as handle    no-undo .
     1105     define variable fh-main           as handle    no-undo .
     1106     define variable fh-old            as handle    no-undo .
     1107     define variable fh-new            as handle    no-undo .
     1108     define variable v-field-name      as character no-undo .
     1109     define variable v-field-lvl       as character no-undo .
     1110     define variable v-field-form      as character no-undo .
     1111     define variable v-search-exp      as character no-undo .
     1112     define variable v-srch-main       as character no-undo .
     1113     define variable v-word-link       as character no-undo .
     1114     define variable v-av-chip-num     as logical   no-undo .
     1115     define variable v-main-pi-fld-lst as character no-undo .
     1116     define variable v-main-fld-lst    as character no-undo .
     1117     define variable v-delim-list      as character no-undo .
     1118     define variable v-label           as character no-undo .
     1119     define variable v-old-value       as character no-undo case-sensitive.
     1120     define variable v-new-value       as character no-undo case-sensitive.
     1121     define variable v-chg-fields as character no-undo.
     1122     for each temp-changes:
     1123       delete temp-changes.
     1124     end.
     1125     if not p-hst-handle:available then do:
     1126       return .
     1127     end.
     1128     create buffer h-new-buf  for table p-hst-handle .
     1129     create buffer h-main-buf for table p-main-table .
     1130     assign
     1131       v-inform = h-main-buf:index-information(1)
     1132       v-ind    = 2
     1133     .
     1134     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1135     on error undo, return error
     1136     :
     1137       assign
     1138         v-inform = h-main-buf:index-information( v-ind )
     1139         v-ind    = v-ind + 1
     1140       .
     1141     end.
     1142     if v-inform = ?
     1143       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1144       or entry( 3, v-inform, ",":U ) <> "1":U
     1145     then do:
     1146       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1147     end.
     1148     assign
     1149       v-idx-field-qnty = num-entries( v-inform ) - 4
     1150     .
     1151     if v-idx-field-qnty < 2 then do:
     1152       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1153     end.
     1154     assign
     1155       v-srch-main   = "where":U
     1156       v-word-link   = "":U
     1157       v-av-chip-num = false
     1158       v-delim-list  = "":U
     1159     .
     1160     do v-ind = 1 to v-idx-field-qnty by 2
     1161     on error undo, return error
     1162     :
     1163       assign
     1164         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1165         fh                = p-hst-handle:buffer-field( v-field-name )
     1166         fh-main           = h-main-buf:buffer-field( v-field-name )
     1167         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1168         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1169       .
     1170       if fh:data-type ="character":U then do:
     1171         assign
     1172           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1173         .
     1174       end.
     1175       else do:
     1176         assign
     1177           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1178         .
     1179       end.
     1180       if v-delim-list = "":U then do:
     1181         assign
     1182           v-delim-list = ",":U
     1183         .
     1184       end.
     1185       if v-word-link = "":U then do:
     1186         assign
     1187           v-word-link = "and":U
     1188         .
     1189       end.
     1190     end.
     1191     assign
     1192       v-delim-list  = "":U
     1193     .
     1194     do v-ind = 1 to h-main-buf:num-fields
     1195     on error undo, return error
     1196     :
     1197       assign
     1198         fh-main      = h-main-buf:buffer-field( v-ind )
     1199         v-field-name = fh-main:name
     1200       .
     1201         assign
     1202           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1203         .
     1204         if v-delim-list = "":U then do:
     1205           assign
     1206             v-delim-list = ",":U
     1207           .
     1208         end.
     1209     end.
     1210     assign
     1211       v-inform = p-hst-handle:index-information(1)
     1212       v-ind    = 2
     1213     .
     1214     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1215     on error undo, return error
     1216     :
     1217       assign
     1218         v-inform = p-hst-handle:index-information( v-ind )
     1219         v-ind    = v-ind + 1
     1220       .
     1221     end.
     1222     if v-inform = ?
     1223       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1224       or entry( 3, v-inform, ",":U ) <> "1":U
     1225     then do:
     1226       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1227     end.
     1228     assign
     1229       v-idx-field-qnty = num-entries( v-inform ) - 4
     1230     .
     1231     if v-idx-field-qnty < 2 then do:
     1232       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1233     end.
     1234     assign
     1235       v-search-exp  = "where":U
     1236       v-word-link   = "":U
     1237       v-av-chip-num = false
     1238     .
     1239     do v-ind = 1 to v-idx-field-qnty by 2
     1240     on error undo, return error
     1241     :
     1242       assign
     1243         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1244         fh           = p-hst-handle:buffer-field( v-field-name )
     1245         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1246       .
     1247       if v-field-name = "chip-num":U then do:
     1248         assign
     1249           v-search-exp  = substitute( "&1 >", v-search-exp )
     1250           v-av-chip-num = true
     1251         .
     1252       end.
     1253       else do:
     1254         assign
     1255           v-search-exp = substitute( "&1 =", v-search-exp )
     1256         .
     1257       end.
     1258       if fh:data-type ="character":U then do:
     1259         assign
     1260           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1261         .
     1262       end.
     1263       else do:
     1264         assign
     1265           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1266         .
     1267       end.
     1268       if v-word-link = "":U then do:
     1269         assign
     1270           v-word-link = "and":U
     1271         .
     1272       end.
     1273     end.
     1274     if v-av-chip-num = false then do:
     1275       message
     1276         vss-workfile vss-revision vss-description skip
     1277         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1278         "Использование данной процедуры невозможно!" skip
     1279         view-as alert-box error .
     1280       return error .
     1281     end.
     1282     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1283     if not h-new-buf:available then do:
     1284       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1285       if not h-main-buf:available then do:
     1286         assign
     1287           h-for-comp = ?
     1288         .
     1289       end.
     1290       else do:
     1291         assign
     1292           h-for-comp = h-main-buf
     1293         .
     1294       end.
     1295     end.
     1296     else do:
     1297       assign
     1298         h-for-comp = h-new-buf
     1299       .
     1300     end.
     1301     assign
     1302       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1303     .
     1304     do v-ind = 1 to v-num-entries
     1305     on error undo, return error return-value
     1306     :
     1307       assign
     1308         v-field-name = entry( v-ind, v-main-fld-lst )
     1309         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1310         v-old-value  = fh-old:buffer-value()
     1311         v-label      = trim( fh-old:label )
     1312       .
     1313       if ( trim( p-field-list ) <> "":U
     1314            and lookup( v-field-name, p-field-list ) > 0
     1315          )
     1316          or trim( p-field-list ) = "":U
     1317       then do:
     1318         if h-for-comp <> ? then do:
     1319           assign
     1320             fh-new      = h-for-comp:buffer-field( v-field-name )
     1321             v-new-value = fh-new:buffer-value()
     1322           .
     1323         end.
     1324         else do:
     1325           assign
     1326             v-new-value = "":U
     1327           .
     1328         end.
     1329           if p-act-create = true then do:
     1330             assign
     1331               v-old-value = "":U
     1332             .
     1333           end.
     1334           if p-act-delete = true then do:
     1335             assign
     1336               v-new-value = "":U
     1337             .
     1338           end.
     1339         if v-old-value <> v-new-value
     1340         then do:
     1341           create temp-changes.
     1342           assign
     1343             temp-changes.t_name = p-main-table
     1344             temp-changes.f_name = v-field-name
     1345             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1346             temp-changes.v_old  = trim( v-old-value )
     1347             temp-changes.v_new  = trim( v-new-value )
     1348             temp-changes.num_   = 0
     1349             temp-changes.fNotChange = v-old-value eq v-new-value
     1350           .
     1351         end.
     1352       end.
     1353     end.
     1354     assign
     1355       v-num-entries = num-entries( p-label-form, chr(8) )
     1356     .
     1357     do v-ind = 1 to v-num-entries
     1358     on error undo, return error return-value
     1359     :
     1360       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1361         assign
     1362           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1363           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1364           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1365         .
     1366         find first temp-changes
     1367           where temp-changes.f_name = v-field-name
     1368           no-error .
     1369         if available temp-changes then do:
     1370           if trim( v-field-lvl ) <> "":U then do:
     1371             assign
     1372               temp-changes.l_name = v-field-lvl
     1373             .
     1374           end.
     1375           if trim( v-field-form ) <> "":U then do:
     1376             assign
     1377               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1378             .
     1379             if h-for-comp <> ? then do:
     1380               assign
     1381                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1382               .
     1383             end.
     1384           end.
     1385         end.
     1386       end.
     1387       else do:
     1388         message
     1389           vss-workfile vss-revision vss-description skip
     1390           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1391           substitute( "список для поля '&1': '&2'"
     1392                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1393                       ,entry( v-ind, p-label-form, chr(8) )
     1394                     ) skip
     1395           substitute( "полный список: &2", p-label-form ) skip
     1396           view-as alert-box error .
     1397       end.
     1398     end.
     1399     delete object h-new-buf .
     1400     delete object h-main-buf .
     1401   END PROCEDURE.
     1402   FUNCTION get-action RETURNS CHARACTER
     1403     ( p-action as integer )  FORWARD.
     1404   FUNCTION get-source-type RETURNS CHARACTER
     1405     ( p-source-type as character )  FORWARD.
     1406   FUNCTION get-subject RETURNS CHARACTER
     1407     ( p-subject as character )  FORWARD.
     1408   FUNCTION local-open-br RETURNS logical
     1409     (  p-open-query     as logical    ,
     1410     p-find-next       as logical    ,
     1411     p-find-condition as character )  FORWARD.
     1412   DEFINE BUTTON B-Help
     1413        LABEL "Помо&щь"
     1414        SIZE 3 BY 1
     1415        BGCOLOR 8 .
     1416   DEFINE BUTTON B-mark
     1417        LABEL "&*"
     1418        SIZE 3 BY 1.
     1419   DEFINE BUTTON B-print
     1420        LABEL "Пе&чать"
     1421        SIZE 3 BY 1.
     1422   DEFINE BUTTON b-quit AUTO-END-KEY
     1423        LABEL "&Выход"
     1424        SIZE 10 BY 1
     1425        BGCOLOR 8 .
     1426   DEFINE BUTTON b-reason
     1427        LABEL "&Причина"
     1428        SIZE 10 BY 1.
     1429   DEFINE BUTTON B-sch
     1430        LABEL "&Фильтр"
     1431        SIZE 3 BY 1.
     1432   DEFINE BUTTON b-sel AUTO-GO
     1433        LABEL "Вы&бор"
     1434        SIZE 10 BY 1
     1435        BGCOLOR 8 .
     1436   DEFINE BUTTON b-nextlevel
     1437        LABEL "Детали"
     1438        SIZE 10 BY 1
     1439        BGCOLOR 8 .
     1440   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1441         VIEW-AS TEXT
     1442        SIZE 6 BY 1
     1443        FGCOLOR 4  NO-UNDO.
     1444   DEFINE VARIABLE sch-obj-code AS CHARACTER FORMAT "X(50)":U
     1445        LABEL "коду"
     1446        VIEW-AS FILL-IN
     1447        SIZE 10 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1448   DEFINE VARIABLE sch-corr-date AS DATE FORMAT "99/99/9999":U
     1449        LABEL "Дате изменения"
     1450        VIEW-AS FILL-IN
     1451        SIZE 11 BY 1 NO-UNDO.
     1452   DEFINE VARIABLE sch-corr-user-name AS CHARACTER FORMAT "X(9)":U
     1453        LABEL "пользователю"
     1454        VIEW-AS FILL-IN
     1455        SIZE 12 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1456   DEFINE VARIABLE sch-db-num AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1457        LABEL "БД"
     1458        VIEW-AS FILL-IN
     1459        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1460   DEFINE VARIABLE v-corr-user-db-num AS INTEGER FORMAT ">>>>9":U INITIAL 0
     1461        LABEL "по БД"
     1462        VIEW-AS FILL-IN
     1463        SIZE 6 BY 1 NO-UNDO.
     1464   DEFINE QUERY BR-changes FOR
     1465         temp-changes SCROLLING.
     1466   DEFINE QUERY br-obj-hist FOR
     1467         X_c-obj-hist SCROLLING.
     1468   DEFINE BROWSE BR-changes
     1469     QUERY BR-changes DISPLAY
     1470         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(200)" width 40
     1471   temp-changes.v_old COLUMn-LABEL "Было" format "X(255)"
     1472   temp-changes.v_new COLUMn-LABEL "Стало" format "X(255)"
     1473       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.25.
     1474   DEFINE BROWSE br-obj-hist
     1475     QUERY br-obj-hist NO-LOCK DISPLAY
     1476         mark-string(recid(X_c-obj-hist), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1477         X_c-obj-hist.corr-date FORMAT "99/99/9999":U COLUMN-LABEL "Дата изм."
     1478         string(X_c-obj-hist.corr-time, "HH:MM:SS":U) COLUMN-LABEL "Время изм." FORMAT "X(8)":U
     1479         usrfulnf(X_c-obj-hist.corr-user-name) COLUMn-LABEL "Изменил" FORMAT "X(255)":U width 18
     1480         get-action(X_c-obj-hist.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1481         X_c-obj-hist.corr-user-db-num FORMAT ">>>>9":U COLUMN-LABEL "Дб!созд."
     1482     ENABLE
     1483         X_c-obj-hist.corr-date
     1484       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.46.
     1485   DEFINE FRAME Dialog-Frame
     1486        b-quit AT ROW 1 COL 1
     1487        B-mark AT ROW 1 COL 11
     1488        b-sel AT ROW 1 COL 21
     1489        v-corr-user-db-num AT ROW 1 COL 37 COLON-ALIGNED
     1490        b-nextlevel AT ROW 1 COL 70
     1491        b-reason AT ROW 1 COL 59
     1492        B-print AT ROW 1 COL 89
     1493        B-sch AT ROW 1 COL 92
     1494        B-Help AT ROW 1 COL 95
     1495        br-obj-hist AT ROW 2 COL 1
     1496        sch-db-num AT ROW 13.63 COL 60.13 COLON-ALIGNED
     1497        sch-corr-date AT ROW 13.63 COL 85.75 COLON-ALIGNED
     1498        sch-obj-code AT ROW 13.67 COL 45.13 COLON-ALIGNED
     1499        sch-corr-user-name AT ROW 13.71 COL 22.5 COLON-ALIGNED
     1500        BR-changes AT ROW 14.79 COL 1
     1501        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1502        "ПОИСК ПО" VIEW-AS TEXT
     1503             SIZE 8.38 BY 1 AT ROW 13.63 COL 1.38
     1504             FGCOLOR 4
     1505        SPACE(89.48) SKIP(7.44)
     1506       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1507            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1508            TITLE
     1509            "Полная история"
     1510            CANCEL-BUTTON b-quit.
     1511   ASSIGN
     1512          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1513          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1514   ASSIGN
     1515          br-obj-hist:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     1516   ON GO OF FRAME Dialog-Frame
     1517   DO:
     1518     p-rid-list = v-rid-list.
     1519   END.
     1520   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1521   DO:
     1522     APPLY "END-ERROR":U TO SELF.
     1523   END.
     1524   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1525   DO:
     1526   define variable loc#log as logical no-undo .
     1527     if available X_c-obj-hist then do:
     1528   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1529   define variable v-str-recid15 as character no-undo .
     1530   define variable v-num-entry15 as integer   no-undo .
     1531   assign
     1532     v-str-recid15 = trim( string( recid( X_c-obj-hist ) , "->>>>>>>>>>>9":U ) )
     1533     v-num-entry15 = lookup( v-str-recid15 , v-rid-list )
     1534   .
     1535   if v-num-entry15 > 0 then do:
     1536     assign
     1537       entry( v-num-entry15, v-rid-list ) = "":U
     1538       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1539     .
     1540   end.
     1541   else do:
     1542     assign
     1543       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid15
     1544     .
     1545   end.
     1546       loc#log = br-obj-hist:refresh() .
     1547       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1548           loc#log = br-obj-hist:select-next-row ().
     1549           apply "VALUE-CHANGED" to br-obj-hist in frame Dialog-Frame.
     1550       end.
     1551       if num-entries( v-rid-list ) = 0
     1552       then
     1553           hide mark-num in frame Dialog-Frame.
     1554       else
     1555           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1556     end.
     1557     apply "entry" to br-obj-hist in frame Dialog-Frame.
     1558   END.
     1559   ON CHOOSE OF b-nextlevel IN FRAME Dialog-Frame
     1560   DO:
     1561      define variable vRun as character no-undo.
     1562      vRun = this-procedure:file-name.
     1563      run value(vRun)
     1564         (
     1565          parParentProc,
     1566          p-curr-host-code,
     1567          p-curr-obj-type,
     1568          p-curr-obj-code,
     1569          bttns,
     1570          "one",
     1571          p-corr-user-db-num,
     1572          p-corr-user-name,
     1573          p-subject,
     1574          p-db-num,
     1575          X_c-obj-hist.chip-num ,
     1576          input-output p-rid-list ).
     1577      apply "entry" to br-obj-hist in frame Dialog-Frame.
     1578   END.
     1579   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1580   DO:
     1581       run proc-b-print in this-procedure no-error.
     1582     if error-status:error then return no-apply.
     1583   END.
     1584   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1585   DO:
     1586       run proc-b-sch in this-procedure no-error.
     1587     if error-status:error then return no-apply.
