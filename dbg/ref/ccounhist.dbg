     1614     if error-status:error then return no-apply.
     1615   END.
     1616   ON RETURN OF sch-obj-code IN FRAME Dialog-Frame
     1617   DO:
     1618     run proc-find-obj-code in this-procedure(no, input frame Dialog-Frame sch-obj-code) no-error.
     1619     if error-status:error then return no-apply.
     1620   END.
     1621   ON CTRL-J OF sch-corr-date IN FRAME Dialog-Frame
     1622   DO:
     1623      run proc-find-corr-date in this-procedure(yes, input frame Dialog-Frame sch-corr-date) no-error.
     1624     if error-status:error then return no-apply.
     1625   END.
     1626   ON RETURN OF sch-corr-date IN FRAME Dialog-Frame
     1627   DO:
     1628     run proc-find-corr-date in this-procedure(no, input frame Dialog-Frame sch-corr-date) no-error.
     1629     if error-status:error then return no-apply.
     1630   END.
     1631   ON CTRL-J OF sch-corr-user-name IN FRAME Dialog-Frame
