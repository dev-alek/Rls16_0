     3432   PROCEDURE MyEnable :
     3433   DEFINE VARIABLE v-h AS handle NO-UNDO.
     3434   assign
     3435   br-obj-hist:num-locked-columns in frame Dialog-Frame = 1
     3436   X_c-obj-hist.corr-date:read-only in browse br-obj-hist = yes
     3437   br-changes:title = "":U
     3438   v-corr-user-db-num = v-db-num
     3439   temp-changes.l_name:resizable in browse br-changes = true
     3440   temp-changes.v_old:resizable in browse br-changes = true
     3441   temp-changes.v_new:resizable in browse br-changes = true
     3442   temp-changes.l_name:width in browse br-changes = 30
     3443   temp-changes.v_old:width in browse br-changes = 40
     3444   temp-changes.v_new:width in browse br-changes = 40
     3445   v-h = br-obj-hist:FIRST-COLUMN IN FRAME Dialog-Frame
     3446   .
     3447   DO while valid-handle(v-h) :
     3448     if v-h:LABEL = "Предмет изменения"
     3449     or v-h:LABEL = "Изменил"
     3450       then do:
     3451       v-h:RESIZABLE = YES.
     3452     end.
     3453       v-h = v-h:NEXT-COLUMN.
     3454     END.
     3455   DISPLAY
