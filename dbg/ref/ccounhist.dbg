     3536     assign
     3537       l-filter-open-27 = false
     3538     .
     3539     if flt-rec-27 <> ?
     3540       or sort-column-phrase > ""
     3541     then do:
     3542       define variable  parameter-2-27 as character no-undo .
     3543       define variable  parameter-3-27 as character no-undo .
     3544       define variable  parameter-4-27 as character no-undo .
     3545       define variable  parameter-5-27 as character no-undo .
     3546       define variable  parameter-6-27 as character no-undo .
     3547       define variable  parameter-7-27 as character no-undo .
     3548         assign
     3549         parameter-3-27 =
     3550                                 "FOR EACH X_c-obj-hist"
     3551         parameter-4-27 =
     3552           (
     3553             if (" TRUE " + " " + where-phrase-27) <> ""
     3554             then " TRUE " + " " + where-phrase-27
     3555             else "true"
     3556           )
     3557         parameter-5-27 = (" " + "" + " " + "")
     3558         parameter-6-27 = if sort-phrase-27 = ''
     3559                              then
     3560           (
     3561           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC  " +
     3562             " " + sort-column-phrase +
     3563           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC  "
     3564           )
     3565                              else
     3566           (
     3567           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC  " +
     3568             " " + sort-column-phrase +
     3569           " " + sort-phrase-27
     3570           )
     3571         parameter-7-27 =
     3572           " indexed-reposition  "
     3573       .
     3574       do
