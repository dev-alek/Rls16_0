      694   procedure prn-lib-open-stream :
      695     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      696     define input parameter p-page-size    as integer no-undo .
      697     define input parameter p-is-stream    as logical no-undo .
      698     define input parameter p-append       as logical no-undo .
      699     define variable v-report-name as character no-undo .
      700     do
      701       on error undo, return error
      702       :
      703       run prn-lib-get-report-name  in this-procedure (
      704         input parParentProc
      705         ,output v-report-name
      706         ).
      707       if p-is-stream then
      708       do:
      709         if p-append then
      710         do:
      711           output stream PrnLibStream to value( v-report-name )
      712             page-size value(p-page-size) append .
      713         end.
      714         if not p-append then
      715         do:
      716           output stream PrnLibStream to value( v-report-name )
      717             page-size value(p-page-size) .
      718         end.
      719       end.
      720       if not p-is-stream then
      721       do:
      722         if p-append then
      723         do:
      724           output to value( v-report-name )
      725             page-size value(p-page-size) append .
      726         end.
      727         if not p-append then
      728         do:
      729           output to value( v-report-name )
      730             page-size value(p-page-size) .
      731         end.
      732       end.
      733     end.
      734   end procedure.
      735   procedure prn-lib-open-exp :
      736     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      737     define input parameter p-is-stream    as logical no-undo .
      738     define input parameter p-is-append    as logical no-undo .
      739     define output parameter p-ReportFileName as char init "report" no-undo.
      740     define output parameter p-process as logical no-undo .
      741     define variable glog as logical no-undo .
      742     do
      743       on error undo, return error
      744       :
      745       SYSTEM-DIALOG GET-FILE p-ReportFileName
      746         TITLE      "Укажите путь"
      747         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      748         ASK-OVERWRITE
      749         CREATE-TEST-FILE
      750         SAVE-AS
      751         USE-FILENAME
      752         DEFAULT-EXTENSION "txt"
      753         UPDATE glog
      754         .
      755       if not glog then  return.
      756       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      757       if p-is-stream then
      758       do:
      759         if p-is-append then
      760         do:
      761           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      762         end.
      763         else
      764         do:
      765           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      766         end.
      767       end.
      768       else
      769       do:
      770         if p-is-append then
      771         do:
      772           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      773         end.
      774         else
      775         do:
      776           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      777         end.
      778       end.
      779       p-process = yes.
      780     end.
      781   end procedure.
