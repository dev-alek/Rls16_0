     3186   def var sort-labelbr-obj-hist   as character no-undo .
     3187   def var sort-clmnbr-obj-hist    as handle    no-undo .
     3188   def var cur-clmnbr-obj-hist     as handle    no-undo .
     3189   def var cur-clmn-locbr-obj-hist as integer   no-undo .
     3190   def var re-querybr-obj-hist     as logical   initial no no-undo .
     3191   on start-search, ctrl-o of br-obj-hist in frame Dialog-Frame do:
     3192      run sort-brbr-obj-hist
     3193        (input (if available X_c-obj-hist
     3194                then recid(X_c-obj-hist)
     3195                else ?
     3196               )
     3197        ).
     3198   end.
     3199   PROCEDURE sort-brbr-obj-hist :
     3200     define input parameter p-recid as recid no-undo .
     3201     if re-querybr-obj-hist = no then do:
     3202       assign
     3203          cur-clmnbr-obj-hist = br-obj-hist:current-column in frame Dialog-Frame
     3204       .
     3205       if sort-clmnbr-obj-hist <> ? then sort-clmnbr-obj-hist:column-fgcolor = 0.
     3206       if cur-clmnbr-obj-hist = sort-clmnbr-obj-hist then do:
     3207         assign
     3208            sort-labelbr-obj-hist = ""
     3209            sort-clmnbr-obj-hist = ?
     3210         .
     3211        end.
     3212        else do:
     3213          assign
     3214            sort-labelbr-obj-hist = cur-clmnbr-obj-hist:label
     3215            sort-clmnbr-obj-hist  = cur-clmnbr-obj-hist
     3216            sort-clmnbr-obj-hist:column-fgcolor = 4
     3217          .
     3218        end.
     3219      end.
     3220     assign
     3221       cur-clmn-locbr-obj-hist = 1
     3222     .
     3223     def var column-handle as handle no-undo .
     3224     column-handle = br-obj-hist:first-column.
     3225     do while valid-handle(column-handle) :
     3226       if column-handle = cur-clmnbr-obj-hist then do:
     3227         leave .
     3228       end.
     3229       column-handle = column-handle:NEXT-COLUMN.
     3230       assign
     3231         cur-clmn-locbr-obj-hist = cur-clmn-locbr-obj-hist + 1
     3232       .
     3233     end.
     3234     case sort-labelbr-obj-hist:
     3235           when X_c-obj-hist.corr-date:label in browse br-obj-hist then DO:    assign       sort-column-name = "X_c-obj-hist.corr-date"     .     run OpenBr(yes, no, no, v-corr-user-db-num).   . END.
     3236           when X_c-obj-hist.corr-user-db-num:label in browse br-obj-hist then DO:    assign       sort-column-name = "X_c-obj-hist.corr-user-db-num"     .     run OpenBr(yes, no, no, v-corr-user-db-num).   . END.
     3237       otherwise do:
     3238         assign
     3239           sort-column-name = ""
     3240         .
     3241         run OpenBr(yes, no, no, v-corr-user-db-num).
     3242           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-obj-hist') then do:
     3243             run mv-brw-defaultbr-obj-hist.
     3244           end.
     3245         if sort-labelbr-obj-hist <> "" then do:
     3246           assign
     3247             cur-clmnbr-obj-hist:column-fgcolor = 0
     3248           .
     3249         end.
     3250         assign
     3251           cur-clmn-locbr-obj-hist = ?
     3252         .
     3253       end.
     3254     end case.
     3255       if cur-clmn-locbr-obj-hist <> ? then do:
     3256         if can-do( this-procedure:internal-entries, 'ch-clmnbr-obj-hist') then do:
     3257           run ch-clmnbr-obj-hist in this-procedure (cur-clmn-locbr-obj-hist).
     3258         end.
     3259       end.
     3260     if p-recid <> ? then do:
     3261       reposition br-obj-hist to recid p-recid no-error.
     3262       apply "value-changed" to br-obj-hist in frame Dialog-Frame.
     3263     end.
     3264     apply "entry" to br-obj-hist in frame Dialog-Frame.
     3265   END PROCEDURE.
     3266   procedure re-open-query-srt-clmnbr-obj-hist:
     3267   if cur-clmnbr-obj-hist = ? then do:
     3268      run OpenBr(yes, no, no, v-corr-user-db-num).
     3269   end.
     3270   else do:
     3271      assign re-querybr-obj-hist = yes.
     3272      run sort-brbr-obj-hist
     3273        (input (if available X_c-obj-hist
     3274                then recid(X_c-obj-hist)
     3275                else ?
     3276               )
     3277        ).
     3278      assign re-querybr-obj-hist = no.
     3279   end.
     3280   end.
     3281   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3282   do:
     3283     BR-changes :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     3284   end.
     3285   MAIN-BLOCK:
     3286   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3287      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3288      if p-mode <> 'все':U
     3289    and p-mode <> 'фирма':U
     3290    and p-mode <> "one":U
     3291    and p-mode <> "subject":U
     3292    and p-mode <> "parentbeg":U
     3293    then dO:
     3294       message
     3295       vss-workfile vss-revision vss-description skip
     3296       "Неверное значение параметров вызова p-mode"
     3297       p-mode
     3298       view-as alert-box ERROR.
     3299       return.
     3300    end.
     3301    v-rid-list = p-rid-list.
     3302     if v-rid-list <> "" then do:
     3303         FIND FIRST find_c-obj-hist No-LOCK where
     3304                    recid(find_c-obj-hist) = integer(entry(1, v-rid-list)) No-ERROR.
     3305         if not avail find_c-obj-hist then do:
     3306           message
     3307           vss-workfile vss-revision vss-description skip
     3308           "Неверное значение параметра вызова v-rid-list" v-rid-list
     3309           view-as alert-box error .
     3310           return error.
     3311         end.
     3312         v-doc-rec = integer(entry(1, v-rid-list)).
     3313       end.
     3314   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3315   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     3316     (output v-db-num
     3317     )  .
     3318     if p-mode <> 'все':U then do:
