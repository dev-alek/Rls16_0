     3329   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3330   DEF VAR cur-clmn-numbr-obj-hist as INT EXTENT 6 no-undo.
     3331   DEF VAR varmvibr-obj-hist       as INT no-undo.
     3332   DEF VAR varmvjbr-obj-hist       as INT no-undo.
     3333   DEF VAR varmvkbr-obj-hist       as INT no-undo.
     3334   DEF VAR varmvlbr-obj-hist       as INT no-undo.
     3335   DEF VAR move-elementbr-obj-hist as INT no-undo.
     3336   def var jjbr-obj-hist           as int no-undo.
     3337   do varmvibr-obj-hist = 1 to EXTENT(cur-clmn-numbr-obj-hist):
     3338     ASSIGN cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = varmvibr-obj-hist.
     3339   END.
     3340   RUN start-mv-clmnbr-obj-hist.
     3341   PROCEDURE start-mv-clmnbr-obj-hist:
     3342   def var old-session as logical no-undo.
     3343      old-session = SESSION:IMMEDIATE-DISPLAY.
     3344      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3345          IF  p-mode = 'все':U  THEN DO:
     3346      DO jjbr-obj-hist = NUM-ENTRIES('1,2,3,4,5,6') TO 1 BY -1:
     3347        RUN re-move-clmnbr-obj-hist ( cur-clmn-numbr-obj-hist[INTEGER(ENTRY (jjbr-obj-hist, '1,2,3,4,5,6'))] , 1).
     3348      END.
     3349          END.
     3350          IF  p-mode <> 'все':U  THEN DO:
     3351      DO jjbr-obj-hist = NUM-ENTRIES('1,2,3,5,6') TO 1 BY -1:
     3352        RUN re-move-clmnbr-obj-hist ( cur-clmn-numbr-obj-hist[INTEGER(ENTRY (jjbr-obj-hist, '1,2,3,5,6'))] , 1).
     3353      END.
     3354          END.
     3355      SESSION:IMMEDIATE-DISPLAY = old-session.
     3356   END.
     3357   ON ctrl-cursor-right OF BROWSE br-obj-hist do:
     3358     RUN re-move-clmnbr-obj-hist ( 1, 6).
     3359   END.
     3360   ON ctrl-cursor-left OF BROWSE br-obj-hist do:
     3361     RUN re-move-clmnbr-obj-hist (6, 1).
     3362   END.
     3363   PROCEDURE re-move-clmnbr-obj-hist:
     3364     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3365     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3366     DO varmvibr-obj-hist = 1 TO EXTENT(cur-clmn-numbr-obj-hist):
     3367       if cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = source-column THEN cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = -1.
     3368     END.
     3369     if br-obj-hist:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     3370     if source-column > target-column THEN
     3371     DO varmvjbr-obj-hist = source-column - 1 to target-column BY -1:
     3372       DO varmvibr-obj-hist = 1 TO EXTENT(cur-clmn-numbr-obj-hist):
     3373           if cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = varmvjbr-obj-hist THEN DO:
     3374             cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = cur-clmn-numbr-obj-hist[varmvibr-obj-hist] + 1.
     3375           END.
     3376       END.
     3377     END.
     3378     ELSE
     3379     DO varmvjbr-obj-hist = source-column + 1 to target-column:
     3380       DO varmvibr-obj-hist = 1 TO EXTENT(cur-clmn-numbr-obj-hist):
     3381         if cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = varmvjbr-obj-hist THEN DO:
     3382           cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = cur-clmn-numbr-obj-hist[varmvibr-obj-hist] - 1.
     3383         END.
     3384       END.
     3385     END.
     3386     DO varmvibr-obj-hist = 1 TO EXTENT(cur-clmn-numbr-obj-hist):
     3387       if cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = -1 THEN cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = target-column.
     3388     END.
     3389   END PROCEDURE.
     3390   PROCEDURE ch-clmnbr-obj-hist:
     3391     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3392     if cur-clmn-loc <= 1 then do:
     3393       return .
     3394     end.
     3395     DO varmvibr-obj-hist = 1 TO EXTENT(cur-clmn-numbr-obj-hist):
     3396       if cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = cur-clmn-loc THEN move-elementbr-obj-hist = varmvibr-obj-hist.
     3397     END.
     3398     RUN re-move-clmnbr-obj-hist (cur-clmn-loc, 1).
     3399   END PROCEDURE.
     3400   PROCEDURE mv-brw-defaultbr-obj-hist:
     3401   def var old-session as logical no-undo.
     3402     old-session = SESSION:IMMEDIATE-DISPLAY.
     3403     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3404     do varmvlbr-obj-hist = 1 to EXTENT(cur-clmn-numbr-obj-hist):
     3405       RUN re-move-clmnbr-obj-hist (cur-clmn-numbr-obj-hist[varmvlbr-obj-hist], varmvlbr-obj-hist).
     3406     END.
     3407     RUN start-mv-clmnbr-obj-hist.
     3408     SESSION:IMMEDIATE-DISPLAY = old-session.
     3409   END PROCEDURE.
     3410   .
