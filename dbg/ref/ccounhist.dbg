     3517   define variable  sort-phrase-27      as character no-undo .
     3518   define variable  where-phrase-rus-27 as character no-undo .
     3519   define variable  sort-phrase-rus-27  as character no-undo .
     3520     run waitfram-show in this-procedure
     3521       (input "ЖДИТЕ ..."
     3522       ).
     3523   run gbl/flt-get.p
     3524     (input filter-point
     3525     ,output flt-rec-27
     3526     ,output filter-name-27
     3527     ,output where-phrase-27
     3528     ,output sort-phrase-27
     3529     ,output where-phrase-rus-27
     3530     ,output sort-phrase-rus-27
