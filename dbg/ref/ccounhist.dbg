     1641   ON CTRL-J OF sch-db-num IN FRAME Dialog-Frame
     1642   DO:
     1643     run proc-find-db-num in this-procedure(yes, input frame Dialog-Frame sch-db-num) no-error.
     1644     if error-status:error then return no-apply.
     1645   END.
     1646   ON RETURN OF sch-db-num IN FRAME Dialog-Frame
     1647   DO:
     1648     run proc-find-db-num in this-procedure(no, input frame Dialog-Frame sch-db-num) no-error.
     1649     if error-status:error then return no-apply.
     1650   END.
     1651   ON RETURN OF v-corr-user-db-num IN FRAME Dialog-Frame
     1652   DO:
     1653     assign
     1654     v-corr-user-db-num
     1655     .
     1656     RUn OpenBR(yes, no, '':U, v-corr-user-db-num).
     1657   END.
     1658   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1659   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1660   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1661   on help of frame Dialog-Frame
     1662   do:
     1663     run gbl/app_help.p
     1664       (input this-procedure :file-name
     1665       ,input ''
     1666       ,input ?
     1667       ) no-error.
     1668     if error-status :error then do:
     1669       message
     1670         "Ошибка при вызове помощи"
     1671         error-status :get-message(1)
     1672         view-as alert-box .
     1673     end.
     1674   end.
     1675   run minbtn-set in this-procedure .
     1676   on choose of b-help in frame Dialog-Frame
     1677   do:
     1678     apply "help":u to frame Dialog-Frame .
     1679   end.
     1680   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1681   procedure minbtn-set :
     1682       do
     1683           on error undo, return error return-value
     1684           :
     1685           define variable ii              as integer       no-undo .
     1686           define variable fh              as widget-handle no-undo .
     1687           define variable hh              as widget-handle no-undo .
     1688           define variable v-h             as handle        extent 4 no-undo .
     1689           define variable v-name-button   as character     no-undo .
     1690           define variable v-help-old-x    as decimal       no-undo .
     1691           define variable v-help-old-y    as decimal       no-undo .
     1692           define variable v-help-old-size as decimal       no-undo .
     1693           define variable v-frame-width   as decimal       no-undo .
     1694           define variable jj              as integer       no-undo .
     1695           do
     1696               on error undo, return error
     1697               :
     1698               assign
     1699                   v-frame-width = frame Dialog-Frame:width - 0.3
     1700                   fh            = frame Dialog-Frame:first-child
     1701                   hh            = fh:first-child
     1702                   ii            = 1
     1703                   .
     1704               do while valid-handle(hh):
     1705                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1706                   do:
     1707                       case lc(hh:name) :
     1708                           when "b-help" then
     1709                               do:
     1710                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1711                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1712                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1713                                   hh:TOOLTIP = "Помощь" .
     1714                                   v-help-old-x = hh:column .
     1715                                   v-help-old-y = hh:row    .
     1716                                   v-help-old-size = hh:width .
     1717                                   hh:width-chars = 2.5 .
     1718                               end.
     1719                           when "b-print" then
     1720                               do:
     1721                                   hh:load-image("cmp/b-print.bmp":u) .
     1722                                   hh:TOOLTIP = "Печать" .
     1723                                   v-h[ii] = hh:handle .
     1724                                   ii = ii + 1 .
     1725                                   hh:width-chars = 3 .
     1726                               end.
     1727                           when "b-history" or
     1728                           when "b-hist" then
     1729                               do:
     1730                                   hh:load-image("cmp/b-hist.bmp":u) .
     1731                                   hh:TOOLTIP = "История" .
     1732                                   v-h[ii] = hh:handle .
     1733                                   ii = ii + 1 .
     1734                                   hh:width-chars = 3 .
     1735                               end.
     1736                           when "b-sch" then
     1737                               do:
     1738                                   hh:load-image("cmp/b-sch.bmp":u) .
     1739                                   hh:TOOLTIP = "Установка Фильтра" .
     1740                                   v-h[ii] = hh:handle .
     1741                                   ii = ii + 1 .
     1742                                   hh:width-chars = 3 .
     1743                               end.
     1744                           when "b-hist-user" then
     1745                               do:
     1746                                   hh:load-image("cmp/b-hist.bmp":u) .
     1747                                   hh:TOOLTIP = "История пользователя" .
     1748                                   ii = ii + 1 .
     1749                               end.
     1750                       end case.
     1751                   end.
     1752                   hh = hh:next-sibling.
     1753               end.
     1754               b-help:column = v-frame-width - b-help:width-chars.
     1755               jj = 0.
     1756               repeat ii = 4 to 1 by -1 :
     1757                   if valid-handle (v-h[ii] ) then
     1758                   do:
     1759                       jj  = jj + 1 .
     1760                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1761                       v-h[ii]:row    = v-help-old-y .
     1762                   end.
     1763               end.
     1764           end.
     1765       end.
     1766   end procedure.
     1767   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1768   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1769   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1770   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1771   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1772   define variable v-diasize-current-frame-height as decimal   no-undo .
     1773   define variable v-diasize-change-size          as logical   no-undo .
     1774   define variable v-diasize-resize-button        as handle    no-undo .
     1775   define variable v-diasize-wndmax               as logical   no-undo .
     1776   define variable v-diasize-wndstore             as logical   no-undo .
     1777   define variable v-diasize-proc-name            as character no-undo .
     1778   define variable v-diasize-browse-handle        as handle    no-undo .
     1779   define variable v-diasize-browse-number        as integer   no-undo .
     1780   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1781   define temp-table temp-diasize-handle no-undo
     1782     field handle-value  as handle
     1783     field save-position as decimal
     1784     index xpk is primary unique handle-value
     1785     .
     1786   define temp-table temp-browse-handle no-undo
     1787     field browse-type   as character
     1788     field browse-number as integer
     1789     field browse-handle as handle
     1790     field original-size as decimal
     1791     index xpk is primary unique browse-type browse-number
     1792     index xie browse-type browse-handle
     1793   .
     1794   procedure diasize_change-height :
     1795     define input  parameter p-change-value  as decimal   no-undo .
     1796     define input  parameter p-move-resize   as logical   no-undo .
     1797     define variable v-field-group-handle    as handle    no-undo .
     1798     define variable v-object-handle         as handle    no-undo .
     1799     define variable v-frame-height          as decimal   no-undo .
     1800     define variable v-frame-virtual-height  as decimal   no-undo .
     1801     define variable v-browse-height         as decimal   no-undo .
     1802     define variable v-window-height         as decimal   no-undo .
     1803     define variable v-window-virtual-height as decimal   no-undo .
     1804     define variable v-change-sign           as integer   no-undo .
     1805     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1806     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1807     if p-change-value > 0
     1808     then do:
     1809       if frame Dialog-Frame :height + p-change-value
     1810           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1811       then do:
     1812         assign
     1813           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1814                           - (frame Dialog-Frame :height-chars)
     1815         .
     1816         if p-change-value <= 0
     1817         then do:
     1818           run diasize_position-resize-button in this-procedure .
     1819           return .
     1820         end.
     1821       end.
     1822     end.
     1823     if p-change-value < 0
     1824     then do:
     1825       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1826       then do:
     1827         assign
     1828           p-change-value = v-diasize-orig-frame-height
     1829                          - (frame Dialog-Frame :height-chars)
     1830         .
     1831         if p-change-value >= 0
     1832         then do:
     1833           run diasize_position-resize-button in this-procedure .
     1834           return .
     1835         end.
     1836       end.
     1837     end.
     1838     if p-change-value >= 0
     1839     then do:
     1840       assign
     1841         v-change-sign = 1
     1842       .
     1843     end.
     1844     else do:
     1845       assign
     1846         v-change-sign = -1
     1847       .
     1848     end.
     1849     assign
     1850       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1851     .
     1852     if p-change-value = 0
     1853     then do:
     1854       run diasize_position-resize-button in this-procedure .
     1855       return .
     1856     end.
     1857     move_block:
     1858     do
     1859     on error undo move_block, retry move_block
     1860     :
     1861       if retry
     1862       then do:
     1863         do
     1864         on error undo move_block, leave move_block
     1865         :
     1866           if p-change-value > 0
     1867           then do:
     1868             for each buf_temp-diasize-handle
     1869             on error undo, next
     1870             :
     1871               assign
     1872                 v-object-handle = buf_temp-diasize-handle.handle-value
     1873               .
     1874               if v-object-handle <> v-diasize-resize-button
     1875               then do:
     1876                 assign
     1877                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1878                 .
     1879               end.
     1880             end.
     1881             assign
     1882               v-diasize-browse-handle :height = v-browse-height
     1883             .
     1884             for each buf_temp-browse-handle
     1885               where buf_temp-browse-handle.browse-type = 'height':u
     1886             on error undo, next
     1887             :
     1888               assign
     1889                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1890               .
     1891             end.
     1892             assign
     1893               frame Dialog-Frame :height = v-frame-height
     1894             .
     1895             if frame Dialog-Frame :scrollable = true
     1896             then do:
     1897               assign
     1898                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1899               .
     1900             end.
     1901             run diasize_position-resize-button in this-procedure .
     1902           end.
     1903           else do:
     1904             if frame Dialog-Frame :scrollable = true
     1905             then do:
     1906               assign
     1907                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1908               .
     1909             end.
     1910             assign
     1911               frame Dialog-Frame :height = v-frame-height
     1912             .
     1913             assign
     1914               v-diasize-browse-handle :height = v-browse-height
     1915             .
     1916             for each buf_temp-browse-handle
     1917               where buf_temp-browse-handle.browse-type = 'height':u
     1918             on error undo, next
     1919             :
     1920               assign
     1921                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1922               .
     1923             end.
     1924             for each buf_temp-diasize-handle
     1925             on error undo, next
     1926             :
     1927               assign
     1928                 v-object-handle = buf_temp-diasize-handle.handle-value
     1929               .
     1930               if v-object-handle <> v-diasize-resize-button
     1931               then do:
     1932                 assign
     1933                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1934                 .
     1935               end.
     1936             end.
     1937             run diasize_position-resize-button in this-procedure .
     1938           end.
     1939           assign
     1940             v-diasize-change-size = false
     1941           .
     1942           leave move_block .
     1943         end.
     1944       end.
     1945       assign
     1946         v-diasize-need-full-display = true
     1947       .
     1948       if v-diasize-change-size = false
     1949       then do:
     1950         assign
     1951           v-diasize-change-size = true
     1952         .
     1953       end.
     1954       else do:
     1955         return .
     1956       end.
     1957       assign
     1958         v-frame-height = frame Dialog-Frame :height
     1959         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1960         v-browse-height = v-diasize-browse-handle :height
     1961       .
     1962       for each buf_temp-browse-handle
     1963         where buf_temp-browse-handle.browse-type = 'height':u
     1964       :
     1965         assign
     1966           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1967         .
     1968       end.
     1969       for each buf_temp-diasize-handle
     1970       :
     1971         delete buf_temp-diasize-handle .
     1972       end.
     1973       assign
     1974         v-field-group-handle = frame Dialog-Frame :first-child
     1975       .
     1976       do while valid-handle(v-field-group-handle)
     1977       :
     1978         assign
     1979           v-object-handle = v-field-group-handle :first-child
     1980         .
     1981         do while valid-handle(v-object-handle)
     1982         :
     1983           if  v-object-handle <> v-diasize-browse-handle :handle
     1984           and can-query(v-object-handle, "row")
     1985           and can-query(v-object-handle, "height")
     1986           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1987           then do:
     1988             find first buf_temp-browse-handle
     1989               where buf_temp-browse-handle.browse-type   = 'height':u
     1990                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1991               no-error .
     1992             if available buf_temp-browse-handle
     1993             then do:
     1994             end.
     1995             else do:
     1996               create buf_temp-diasize-handle .
     1997               assign
     1998                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1999                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2000               .
     2001             end.
     2002           end.
     2003           assign
     2004             v-object-handle = v-object-handle :next-sibling
     2005           .
     2006         end.
     2007         assign
     2008           v-field-group-handle = v-field-group-handle :next-sibling
     2009         .
     2010       end.
     2011       do with frame Dialog-Frame
     2012       :
     2013         hide v-diasize-resize-button .
     2014         assign
     2015           v-diasize-resize-button :row    = 1
     2016           v-diasize-resize-button :column = 1
     2017         .
     2018       end.
     2019       if p-change-value > 0
     2020       then do:
     2021         if frame Dialog-Frame :scrollable = true
     2022         then do:
     2023           assign
     2024             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2025             no-error .
     2026           if error-status :error
     2027           or error-status :get-message(1) <> ""
     2028           then do:
     2029             undo move_block, retry move_block .
     2030           end.
     2031         end.
     2032         assign
     2033           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2034           no-error .
     2035         if error-status :error
     2036         or error-status :get-message(1) <> ""
     2037         then do:
     2038           undo move_block, retry move_block .
     2039         end.
     2040         assign
     2041           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2042           no-error .
     2043         if error-status :error
     2044         or error-status :get-message(1) <> ""
     2045         then do:
     2046           undo move_block, retry move_block .
     2047         end.
     2048         for each buf_temp-browse-handle
     2049           where buf_temp-browse-handle.browse-type = 'height':u
     2050         on error undo move_block, retry move_block
     2051         :
     2052           assign
     2053             buf_temp-browse-handle.browse-handle :height
     2054               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2055             no-error .
     2056           if error-status :error
     2057           or error-status :get-message(1) <> ""
     2058           then do:
     2059             undo move_block, retry move_block .
     2060           end.
     2061         end.
     2062         for each buf_temp-diasize-handle
     2063         on error undo move_block, retry move_block
     2064         :
     2065           assign
     2066             v-object-handle = buf_temp-diasize-handle.handle-value
     2067           .
     2068           if v-object-handle <> v-diasize-resize-button
     2069           then do:
     2070             assign
     2071               v-object-handle :row = v-object-handle :row + p-change-value
     2072               no-error .
     2073             if error-status :error
     2074             or error-status :get-message(1) <> ""
     2075             then do:
     2076               undo move_block, retry move_block .
     2077             end.
     2078           end.
     2079         end.
     2080       end.
     2081       else do:
     2082         for each buf_temp-diasize-handle
     2083         on error undo move_block, retry move_block
     2084         :
     2085           assign
     2086             v-object-handle = buf_temp-diasize-handle.handle-value
     2087           .
     2088           if v-object-handle <> v-diasize-resize-button
     2089           then do:
     2090             assign
     2091               v-object-handle :row = v-object-handle :row + p-change-value
     2092               no-error .
     2093             if error-status :error
     2094             or error-status :get-message(1) <> ""
     2095             then do:
     2096               undo move_block, retry move_block .
     2097             end.
     2098           end.
     2099         end.
     2100         assign
     2101           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2102           no-error .
     2103         if error-status :error
     2104         or error-status :get-message(1) <> ""
     2105         then do:
     2106           undo move_block, retry move_block .
     2107         end.
     2108         for each buf_temp-browse-handle
     2109           where buf_temp-browse-handle.browse-type = 'height':u
     2110         on error undo move_block, retry move_block
     2111         :
     2112           assign
     2113             buf_temp-browse-handle.browse-handle :height
     2114               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2115             no-error .
     2116           if error-status :error
     2117           or error-status :get-message(1) <> ""
     2118           then do:
     2119             undo move_block, retry move_block .
     2120           end.
     2121         end.
     2122         assign
     2123           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2124           no-error .
     2125         if error-status :error
     2126         or error-status :get-message(1) <> ""
     2127         then do:
     2128           undo move_block, retry move_block .
     2129         end.
     2130         if frame Dialog-Frame :scrollable = true
     2131         then do:
     2132           assign
     2133             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2134             no-error .
     2135           if error-status :error
     2136           or error-status :get-message(1) <> ""
     2137           then do:
     2138             undo move_block, retry move_block .
     2139           end.
     2140         end.
     2141       end.
     2142       if p-move-resize = true
     2143       then do:
     2144         run diasize_position-resize-button in this-procedure .
     2145       end.
     2146       if v-diasize-wndstore = true
     2147       then do:
     2148         if connected("ub") = true
     2149         then do:
     2150           define variable v-cntxt-db-num        as integer   no-undo .
     2151           define variable v-cntxt-userid        as character no-undo .
     2152           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2153                                             , OUTPUT v-cntxt-userid
     2154                                             ) .
     2155           run gbl/wndsizew.p
     2156             (input  v-cntxt-db-num
     2157             ,input  v-cntxt-userid
     2158             ,input  v-diasize-proc-name
     2159             ,input  'height':u
     2160             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2161             ) .
     2162         end.
     2163       end.
     2164     end.
     2165     assign
     2166       v-diasize-change-size = false
     2167     .
     2168   end procedure.
     2169   procedure diasize_set-height :
     2170     define input  parameter p-new-height  as decimal   no-undo .
     2171     define input  parameter p-move-resize as logical   no-undo .
     2172     do
     2173     on error undo, return error return-value
     2174     :
     2175       run diasize_change-height in this-procedure
     2176         (input  (p-new-height - frame Dialog-Frame :height)
     2177         ,input  p-move-resize
     2178         ) .
     2179     end.
     2180   end procedure.
     2181   procedure diasize_change-width :
     2182     define input  parameter p-change-value as decimal   no-undo .
     2183     define input  parameter p-move-resize  as logical   no-undo .
     2184     define variable v-field-group-handle   as handle    no-undo .
     2185     define variable v-object-handle        as handle    no-undo .
     2186     define variable v-frame-width          as decimal   no-undo .
     2187     define variable v-frame-virtual-width  as decimal   no-undo .
     2188     define variable v-browse-width         as decimal   no-undo .
     2189     define variable v-window-width         as decimal   no-undo .
     2190     define variable v-window-virtual-width as decimal   no-undo .
     2191     define variable v-change-sign          as integer   no-undo .
     2192     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2193     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2194     if p-change-value > 0
     2195     then do:
     2196       if frame Dialog-Frame :width + p-change-value >
     2197           session :width-chars
     2198       then do:
     2199         assign
     2200           p-change-value = session :width-chars - frame Dialog-Frame :width
     2201         .
     2202         if p-change-value <= 0
     2203         then do:
     2204           run diasize_position-resize-button in this-procedure .
     2205           return .
     2206         end.
     2207       end.
     2208     end.
     2209     if p-change-value < 0
     2210     then do:
     2211       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2212       then do:
     2213         assign
     2214           p-change-value = v-diasize-orig-frame-width
     2215                          - frame Dialog-Frame :width
     2216         .
     2217         if p-change-value >= 0
     2218         then do:
     2219           run diasize_position-resize-button in this-procedure .
     2220           return .
     2221         end.
     2222       end.
     2223     end.
     2224     if p-change-value >= 0
     2225     then do:
     2226       assign
     2227         v-change-sign = 1
     2228       .
     2229     end.
     2230     else do:
     2231       assign
     2232         v-change-sign = -1
     2233       .
     2234     end.
     2235     assign
     2236       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2237     .
     2238     if p-change-value = 0
     2239     then do:
     2240       run diasize_position-resize-button in this-procedure .
     2241       return .
     2242     end.
     2243     move_block:
     2244     do
     2245     on error undo move_block, leave move_block
     2246     :
     2247       if retry
     2248       then do:
     2249         do
     2250         on error undo move_block, leave move_block
     2251         :
     2252           if p-change-value > 0
     2253           then do:
     2254             for each buf_temp-diasize-handle
     2255             on error undo, next
     2256             :
     2257               assign
     2258                 v-object-handle = buf_temp-diasize-handle.handle-value
     2259               .
     2260               if v-object-handle <> v-diasize-resize-button
     2261               then do:
     2262                 assign
     2263                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2264                 .
     2265               end.
     2266             end.
     2267             assign
     2268               v-diasize-browse-handle :width = v-browse-width
     2269             .
     2270             for each buf_temp-browse-handle
     2271               where buf_temp-browse-handle.browse-type = 'width':u
     2272             on error undo, next
     2273             :
     2274               assign
     2275                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2276               .
     2277             end.
     2278             assign
     2279               frame Dialog-Frame :width = v-frame-width
     2280             .
     2281             if frame Dialog-Frame :scrollable = true
     2282             then do:
     2283               assign
     2284                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2285               .
     2286             end.
     2287             run diasize_position-resize-button in this-procedure .
     2288           end.
     2289           else do:
     2290             if frame Dialog-Frame :scrollable = true
     2291             then do:
     2292               assign
     2293                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2294               .
     2295             end.
     2296             assign
     2297               frame Dialog-Frame :width = v-frame-width
     2298             .
     2299             for each buf_temp-browse-handle
     2300               where buf_temp-browse-handle.browse-type = 'width':u
     2301             on error undo, next
     2302             :
     2303               assign
     2304                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2305               .
     2306             end.
     2307             assign
     2308               v-diasize-browse-handle :width = v-browse-width
     2309             .
     2310             for each buf_temp-diasize-handle
     2311             on error undo, next
     2312             :
     2313               assign
     2314                 v-object-handle = buf_temp-diasize-handle.handle-value
     2315               .
     2316               if v-object-handle <> v-diasize-resize-button
     2317               then do:
     2318                 assign
     2319                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2320                 .
     2321               end.
     2322             end.
     2323             run diasize_position-resize-button in this-procedure .
     2324           end.
     2325           assign
     2326             v-diasize-change-size = false
     2327           .
     2328           leave move_block .
     2329         end.
     2330       end.
     2331       assign
     2332         v-diasize-need-full-display = true
     2333       .
     2334       if v-diasize-change-size = false
     2335       then do:
     2336         assign
     2337           v-diasize-change-size = true
     2338         .
     2339       end.
     2340       else do:
     2341         return .
     2342       end.
     2343       assign
     2344         v-frame-width = frame Dialog-Frame :width
     2345         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2346         v-browse-width = v-diasize-browse-handle :width
     2347       .
     2348       for each buf_temp-browse-handle
     2349         where buf_temp-browse-handle.browse-type = 'width':u
     2350       :
     2351         assign
     2352           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2353         .
     2354       end.
     2355       for each buf_temp-diasize-handle
     2356       :
     2357         delete buf_temp-diasize-handle .
     2358       end.
     2359       assign
     2360         v-field-group-handle = frame Dialog-Frame :first-child
     2361       .
     2362       do while valid-handle(v-field-group-handle)
     2363       :
     2364         assign
     2365           v-object-handle = v-field-group-handle :first-child
     2366         .
     2367         do while valid-handle(v-object-handle)
     2368         :
     2369           if  v-object-handle <> v-diasize-browse-handle :handle
     2370           and v-object-handle <> v-diasize-resize-button
     2371           and can-query(v-object-handle, "row")
     2372           and can-query(v-object-handle, "height")
     2373           and ( v-object-handle :col + v-object-handle :width
     2374                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2375               )
     2376           then do:
     2377             find first buf_temp-browse-handle
     2378               where buf_temp-browse-handle.browse-type   = 'width':u
     2379                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2380               no-error .
     2381             if available buf_temp-browse-handle
     2382             then do:
     2383             end.
     2384             else do:
     2385               create buf_temp-diasize-handle .
     2386               assign
     2387                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2388                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2389               .
     2390             end.
     2391           end.
     2392           assign
     2393             v-object-handle = v-object-handle :next-sibling
     2394           .
     2395         end.
     2396         assign
     2397           v-field-group-handle = v-field-group-handle :next-sibling
     2398         .
     2399       end.
     2400       do with frame Dialog-Frame
     2401       :
     2402         hide v-diasize-resize-button .
     2403         v-diasize-resize-button :row = 1.
     2404         v-diasize-resize-button :column = 1.
     2405       end.
     2406       if p-change-value > 0
     2407       then do:
     2408         if frame Dialog-Frame :scrollable = true
     2409         then do:
     2410           assign
     2411             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2412             no-error .
     2413           if error-status :error
     2414           or error-status :get-message(1) <> ""
     2415           then do:
     2416             undo move_block, retry move_block.
     2417           end.
     2418         end.
     2419         assign
     2420           frame Dialog-Frame :width = v-frame-width + p-change-value
     2421           no-error .
     2422         if error-status :error
     2423         or error-status :get-message(1) <> ""
     2424         then do:
     2425           undo move_block, retry move_block.
     2426         end.
     2427         assign
     2428           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2429         no-error .
     2430         if error-status :error
     2431         or error-status :get-message(1) <> ""
     2432         then do:
     2433           undo move_block, retry move_block.
     2434         end.
     2435         for each buf_temp-browse-handle
     2436           where buf_temp-browse-handle.browse-type = 'width':u
     2437         on error undo move_block, retry move_block
     2438         :
     2439           assign
     2440             buf_temp-browse-handle.browse-handle :width
     2441               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2442             no-error .
     2443           if error-status :error
     2444           or error-status :get-message(1) <> ""
     2445           then do:
     2446             undo move_block, retry move_block .
     2447           end.
     2448         end.
     2449         for each buf_temp-diasize-handle
     2450         on error undo move_block, retry move_block
     2451         :
     2452           assign
     2453             v-object-handle = buf_temp-diasize-handle.handle-value
     2454           .
     2455           if v-object-handle <> v-diasize-resize-button
     2456           then do:
     2457             assign
     2458               v-object-handle :col = v-object-handle :col + p-change-value
     2459               no-error .
     2460             if error-status :error
     2461             or error-status :get-message(1) <> ""
     2462             then do:
     2463               undo move_block, retry move_block .
     2464             end.
     2465           end.
     2466         end.
     2467       end.
     2468       else do:
     2469         for each buf_temp-diasize-handle
     2470         on error undo move_block, retry move_block
     2471         :
     2472           assign
     2473             v-object-handle = buf_temp-diasize-handle.handle-value
     2474           .
     2475           if v-object-handle <> v-diasize-resize-button
     2476           then do:
     2477             assign
     2478               v-object-handle :col = v-object-handle :col + p-change-value
     2479               no-error .
     2480             if error-status :error
     2481             or error-status :get-message(1) <> ""
     2482             then do:
     2483               undo move_block, retry move_block .
     2484             end.
     2485           end.
     2486         end.
     2487         for each buf_temp-browse-handle
     2488           where buf_temp-browse-handle.browse-type = 'width':u
     2489         on error undo move_block, retry move_block
     2490         :
     2491           assign
     2492             buf_temp-browse-handle.browse-handle :width
     2493               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2494             no-error .
     2495           if error-status :error
     2496           or error-status :get-message(1) <> ""
     2497           then do:
     2498             undo move_block, retry move_block .
     2499           end.
     2500         end.
     2501         assign
     2502           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2503           no-error .
     2504         if error-status :error
     2505         or error-status :get-message(1) <> ""
     2506         then do:
     2507           undo move_block, retry move_block.
     2508         end.
     2509         assign
     2510           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2511         no-error .
     2512         if error-status :error
     2513         or error-status :get-message(1) <> ""
     2514         then do:
     2515           undo move_block, retry move_block.
     2516         end.
     2517         if frame Dialog-Frame :scrollable = true
     2518         then do:
     2519           assign
     2520             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2521           no-error .
     2522           if error-status :error
     2523           or error-status :get-message(1) <> ""
     2524           then do:
     2525             undo move_block, retry move_block.
     2526           end.
     2527         end.
     2528       end.
     2529       if p-move-resize
     2530       then do:
     2531         run diasize_position-resize-button in this-procedure .
     2532       end.
     2533       if v-diasize-wndstore = true
     2534       then do:
     2535         if connected("ub") = true
     2536         then do:
     2537           define variable v-cntxt-db-num        as integer   no-undo .
     2538           define variable v-cntxt-userid        as character no-undo .
     2539           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2540                                             , OUTPUT v-cntxt-userid
     2541                                             ) .
     2542           run gbl/wndsizew.p
     2543             (input  v-cntxt-db-num
     2544             ,input  v-cntxt-userid
     2545             ,input  v-diasize-proc-name
     2546             ,input  'width':u
     2547             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2548             ) .
     2549         end.
     2550       end.
     2551     end.
     2552     assign
     2553       v-diasize-change-size = false
     2554     .
     2555   end procedure.
     2556   procedure diasize_set-width :
     2557     define input  parameter p-new-width  as decimal   no-undo .
     2558     define input  parameter p-move-resize as logical   no-undo .
     2559     do
     2560     on error undo, return error return-value
     2561     :
     2562       run diasize_change-width in this-procedure
     2563         (input  (p-new-width - frame Dialog-Frame :width)
     2564         ,input  p-move-resize
     2565         ) .
     2566     end.
     2567   end procedure.
     2568   procedure diasize_position-resize-button :
     2569     do with frame Dialog-Frame
     2570     :
     2571       hide v-diasize-resize-button .
     2572       assign
     2573         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2574                     - 1
     2575                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2576         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2577                     - 1
     2578                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2579       .
     2580       view v-diasize-resize-button .
     2581     end.
     2582   end procedure.
     2583   on alt-right anywhere
     2584   do:
     2585     run diasize_change-width in this-procedure
     2586       (input 1
     2587       ,input true
     2588       ) .
     2589     return no-apply .
     2590   end.
     2591   on alt-left anywhere
     2592   do:
     2593     run diasize_change-width in this-procedure
     2594       (input -1
     2595       ,input true
     2596       ) .
     2597     return no-apply .
     2598   end.
     2599   on alt-down anywhere
     2600   do:
     2601     run diasize_change-height in this-procedure
     2602       (input 1
     2603       ,input true
     2604       ) .
     2605     return no-apply .
     2606   end.
     2607   on alt-up anywhere
     2608   do:
     2609     run diasize_change-height in this-procedure
     2610       (input -1
     2611       ,input true
     2612       ) .
     2613     return no-apply .
     2614   end.
     2615   on alt-enter of frame Dialog-Frame
     2616   do:
     2617     run diasize_maximize in this-procedure
     2618       (input  ?
     2619       ).
     2620     return no-apply .
     2621   end.
     2622   procedure diasize_end-move :
     2623     do
     2624     on error undo, return error return-value
     2625     :
     2626       define variable v-row-delta as decimal   no-undo .
     2627       define variable v-col-delta as decimal   no-undo .
     2628       define variable v-new-row as decimal   no-undo .
     2629       define variable v-new-col as decimal   no-undo .
     2630       assign
     2631         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2632         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2633       .
     2634       assign
     2635         v-row-delta = v-new-row - frame Dialog-Frame :height
     2636         v-col-delta = v-new-col - frame Dialog-Frame :width
     2637       .
     2638       run diasize_change-height in this-procedure
     2639         (input v-row-delta
     2640         ,input true
     2641         ) .
     2642       run diasize_change-width in this-procedure
     2643         (input v-col-delta
     2644         ,input true
     2645         ) .
     2646     end.
     2647   end procedure.
     2648   procedure diasize_maximize :
     2649     define input  parameter p-action as logical   no-undo .
     2650     do
     2651     on error undo, return error return-value
     2652     :
     2653       if p-action = ?
     2654       then do:
     2655         if v-diasize-need-maximize = true
     2656         then do:
     2657           assign
     2658             p-action = true
     2659           .
     2660         end.
     2661         else do:
     2662           assign
     2663             p-action = false
     2664           .
     2665         end.
     2666       end.
     2667       if p-action = true
     2668       then do:
     2669         run diasize_change-height in this-procedure
     2670           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2671               - frame Dialog-Frame :height-chars
     2672           ,input true
     2673           ) .
     2674         run diasize_change-width in this-procedure
     2675           (input session :width-chars
     2676               - frame Dialog-Frame :width-chars
     2677           ,input true
     2678           ) .
     2679         assign
     2680           v-diasize-need-maximize = false
     2681         .
     2682       end.
     2683       else do:
     2684         run diasize_change-width in this-procedure
     2685           (input v-diasize-orig-frame-width
     2686               - frame Dialog-Frame :width-chars
     2687           ,input true
     2688           ) .
     2689         run diasize_change-height in this-procedure
     2690           (input v-diasize-orig-frame-height
     2691               - frame Dialog-Frame :height-chars
     2692           ,input true
     2693           ) .
     2694         assign
     2695           v-diasize-need-maximize = true
     2696         .
     2697       end.
     2698     end.
     2699   end procedure.
     2700   procedure diasize_restore-orig-size :
     2701     do
     2702     on error undo, return error return-value
     2703     :
     2704       assign
     2705         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2706         v-diasize-current-frame-height = frame Dialog-Frame :height
     2707       .
     2708       run diasize_set-height in this-procedure
     2709         (input  v-diasize-orig-frame-height
     2710         ,input  true
     2711         ) .
     2712       run diasize_set-width in this-procedure
     2713         (input  v-diasize-orig-frame-width
     2714         ,input  true
     2715         ) .
     2716     end.
     2717   end procedure.
     2718   procedure diasize_restore-current-size :
     2719     do
     2720     on error undo, return error return-value
     2721     :
     2722       run diasize_set-height in this-procedure
     2723         (input  v-diasize-current-frame-height
     2724         ,input  true
     2725         ) .
     2726       run diasize_set-width in this-procedure
     2727         (input  v-diasize-current-frame-width
     2728         ,input  true
     2729         ) .
     2730     end.
     2731   end procedure.
     2732   procedure diasize_set-browse-handle :
     2733     define input  parameter p-browse-handle as handle   no-undo .
     2734     define buffer buf_temp-browse-handle for temp-browse-handle .
     2735     do
     2736     on error undo, return error return-value
     2737     :
     2738       assign
     2739         v-diasize-browse-handle = p-browse-handle
     2740       .
     2741       for each buf_temp-browse-handle
     2742       on error undo, return error return-value
     2743       :
     2744         delete buf_temp-browse-handle .
     2745       end.
     2746     end.
     2747   end procedure.
     2748   procedure diasize_add_browse :
     2749     define input  parameter p-browse-type   as character no-undo .
     2750     define input  parameter p-browse-handle as handle    no-undo .
     2751     define buffer buf_temp-browse-handle for temp-browse-handle .
     2752     do
     2753     on error undo, return error return-value
     2754     :
     2755       assign
     2756         v-diasize-browse-number = v-diasize-browse-number + 1
     2757       .
     2758       create buf_temp-browse-handle .
     2759       assign
     2760         buf_temp-browse-handle.browse-type   = p-browse-type
     2761         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2762         buf_temp-browse-handle.browse-handle = p-browse-handle
     2763       .
     2764     end.
     2765   end procedure.
     2766   procedure diasize_init :
     2767     define variable v-default-value    as logical   no-undo .
     2768     define variable v-restore-saved    as logical   no-undo .
     2769     define variable v-resize-value-str as character no-undo .
     2770     do
     2771     on error undo, return error return-value
     2772     :
     2773       do with frame Dialog-Frame
     2774       :
     2775         assign
     2776           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2777           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2778           v-diasize-browse-handle     = browse br-obj-hist :handle
     2779         .
     2780         create button v-diasize-resize-button
     2781         assign
     2782           parent        = frame Dialog-Frame :first-child
     2783           label         = "s"
     2784           height-pixels = 16
     2785           width-pixels  = 16
     2786           visible       = true
     2787           sensitive     = true
     2788           movable       = true
     2789           triggers:
     2790             on end-move persistent run diasize_end-move in this-procedure .
     2791           end triggers.
     2792         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2793         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2794         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2795         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2796         assign
     2797           v-diasize-wndmax = false
     2798         .
     2799         if connected("ub") = true
     2800         then do:
     2801           define variable v-cntxt-db-num        as integer   no-undo .
     2802           define variable v-cntxt-userid        as character no-undo .
     2803           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2804                                             , OUTPUT v-cntxt-userid
     2805                                             ) .
     2806           run gbl/wndpar_r.p
     2807             (input  v-cntxt-db-num
     2808             ,input  v-cntxt-userid
     2809             ,input  'wndmax':U
     2810             ,output v-diasize-wndmax
     2811             ,output v-default-value
     2812             ) .
     2813         end.
     2814         assign
     2815           v-diasize-wndstore = false
     2816         .
     2817         if connected("ub") = true
     2818         then do:
     2819           run gbl/wndpar_r.p
     2820             (input  v-cntxt-db-num
     2821             ,input  v-cntxt-userid
     2822             ,input  'wndstore':U
     2823             ,output v-diasize-wndstore
     2824             ,output v-default-value
     2825             ) .
     2826         end.
     2827         assign
     2828           v-diasize-proc-name = entry(1, program-name(2), '.')
     2829         .
     2830         if v-diasize-wndstore = true
     2831         then do:
     2832           assign
     2833             v-restore-saved = false
     2834           .
     2835           if connected("ub") = true
     2836           then do:
     2837             run gbl/wndsizer.p
     2838               (input  v-cntxt-db-num
     2839               ,input  v-cntxt-userid
     2840               ,input  v-diasize-proc-name
     2841               ,input  'height':u
     2842               ,output v-resize-value-str
     2843               ) .
     2844             if v-resize-value-str <> '':U
     2845             then do:
     2846               run diasize_change-height in this-procedure
     2847                 (input  integer(v-resize-value-str)
     2848                 ,input  true
     2849                 ) .
     2850               assign
     2851                 v-restore-saved = true
     2852               .
     2853             end.
     2854           end.
     2855           if connected("ub") = true
     2856           then do:
     2857             run gbl/wndsizer.p
     2858               (input  v-cntxt-db-num
     2859               ,input  v-cntxt-userid
     2860               ,input  v-diasize-proc-name
     2861               ,input  'width':u
     2862               ,output v-resize-value-str
     2863               ) .
     2864             if v-resize-value-str <> '':U
     2865             then do:
     2866               run diasize_change-width in this-procedure
     2867                 (input  integer(v-resize-value-str)
     2868                 ,input  true
     2869                 ) .
     2870               assign
     2871                 v-restore-saved = true
     2872               .
     2873             end.
     2874           end.
     2875           if v-restore-saved <> true
     2876           then do:
     2877             if v-diasize-wndmax = true
     2878             then do:
     2879               run diasize_maximize in this-procedure
     2880                 (input  true
     2881                 ) .
     2882             end.
     2883           end.
     2884         end.
     2885         else do:
     2886           if v-diasize-wndmax = true
     2887           then do:
     2888             run diasize_maximize in this-procedure
     2889               (input  true
     2890               ) .
     2891           end.
     2892         end.
     2893       end.
     2894     end.
     2895   end procedure.
     2896   procedure diasize_need-full-display :
     2897     define output parameter p-need-full-display as logical   no-undo .
     2898     do
     2899     on error undo, return error return-value
     2900     :
     2901       assign
     2902         p-need-full-display = v-diasize-need-full-display
     2903       .
     2904       assign
     2905         v-diasize-need-full-display = false
     2906       .
     2907     end.
     2908   end procedure.
     2909   procedure get-context :
     2910      define output parameter p-db-num as integer          no-undo.
     2911      define output parameter p-user-id as character        no-undo.
     2912      define variable v-login               as character    no-undo.
     2913      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2914      define buffer buf_user-login  for ub.user-login .
     2915      do
     2916      on error undo, return error
     2917      :
     2918            FIND FIRST buf_sys-ctrl no-lock.
     2919            ASSIGN
     2920               v-login = USERID("ub")
     2921               p-db-num = buf_sys-ctrl.db-num
     2922            .
     2923            FIND FIRST buf_user-login
     2924                 WHERE buf_user-login.db-num = p-db-num
     2925                   AND buf_user-login.user-login = v-login
     2926                 no-lock
     2927                 no-error
     2928                 .
     2929            IF AVAILABLE buf_user-login
     2930            THEN DO:
     2931               assign
     2932                  p-user-id = buf_user-login.user-id
     2933               .
     2934            END.
     2935      end.
     2936   end procedure.
