     3810   else do:
     3811     assign
     3812       v-doc-rec = recid( X_c-obj-hist )
     3813     .
     3814     do
     3815     on stop undo, leave
     3816     on error undo, leave
     3817     :
     3818       if query br-obj-hist:handle:get-buffer-handle(1) = (buffer X_c-obj-hist:handle) then do:
     3819         assign
     3820         parameter-2-29 = (if p-find-next then "true":u else "false":u )
     3821         parameter-4-29 =
     3822           "where ":u + " TRUE " + " ":u + where-phrase-29 + " ":u + p-find-condition + " " + ""
     3823         parameter-5-29 = ""
     3824       .
     3825         run fltopend_fltfindd in this-procedure  (
     3826                             input this-procedure:handle
     3827                             ,input query br-obj-hist:handle
     3828                             ,input rowid(X_c-obj-hist)
     3829                             ,input logical(parameter-2-29)
     3830                             ,input no-lock
     3831                             ,input (buffer X_c-obj-hist:handle)
     3832                             ,input parameter-4-29
     3833                             ,input parameter-5-29
     3834                             ) no-error.
     3835         .
     3836         assign
     3837           v-doc-rec = integer(return-value)
     3838           v-fltopend-rowid[1] = ?
     3839         .
     3840       end.
     3841       else do:
     3842         assign
     3843         parameter-2-29 = (if p-find-next then "true":u else "false":u )
     3844         parameter-3-29 =  "FOR EACH X_c-obj-hist"
     3845         parameter-4-29 =
     3846           (
     3847             if (" TRUE " + " " + where-phrase-29) <> ""
     3848             then " TRUE " + " " + where-phrase-29
     3849             else "true"
     3850           )
     3851         parameter-5-29 = (" " + "" + " " + "" + " " + p-find-condition)
     3852         parameter-6-29 = if sort-phrase-29 = ''
     3853                              then
     3854           (
     3855           " " + "" +
     3856             " " + sort-column-phrase +
     3857           " " + "  "
     3858           )
     3859                              else
     3860           (
     3861           " " + "" +
     3862             " " + sort-column-phrase +
     3863           " " + sort-phrase-29
     3864           )
     3865         parameter-7-29 =
     3866           " indexed-reposition  "
     3867       .
     3868         run fltopend_fltfindq in this-procedure  (
     3869                             input this-procedure:handle
     3870                             ,input query br-obj-hist:handle
     3871                             ,input logical(parameter-2-29)
     3872                             ,input no-lock
     3873                             ,input parameter-3-29
     3874                             ,input parameter-4-29
     3875                             ,input parameter-5-29
     3876                             ,input parameter-6-29
     3877                             ,input parameter-7-29
     3878                             ,output v-fltopend-rowid
     3879                             ) no-error.
     3880         .
     3881         v-doc-rec = ?.
     3882       end.
     3883       assign
     3884         l-query-was-opened = true
     3885       .
     3886     end.
     3887   end.
     3888     run waitfram-hide in this-procedure .
     3889     end.
     3890   end.
     3891   if not p-open-query and v-doc-rec <> ? then
     3892   REPOSITION br-obj-hist to recid v-doc-rec No-ERROR.
     3893   if not p-open-query and v-fltopend-rowid[1] <> ? then
     3894   query br-obj-hist:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     3895   run waitfram-hide in this-procedure .
     3896   APPLY "VALUE-CHANGED" TO br-obj-hist in frame Dialog-Frame.
     3897   APPLY "ENTRY" TO br-obj-hist.
     3898   END PROCEDURE.
     3899   PROCEDURE proc-b-print :
     3900   define variable date_string     as      char    no-undo.
     3901   define variable Line                as      char    no-undo.
     3902   define variable for-time as char.
     3903   define variable accum-count as integer.
     3904   define variable v-doc-rec as recid no-undo.
     3905   define variable v-subject-chr as character no-undo .
     3906   define variable v-upd-time as character no-undo .
     3907   define variable v-obj as character no-undo .
     3908   define variable v-action-chr as character no-undo .
     3909   define variable v-source-type as character no-undo .
     3910   DEFINE FRAME HistoryList
     3911   v-action-chr FORMAT "X(10)" COLUMN-LABEL "Действие"
     3912   X_c-obj-hist.corr-date
     3913   v-upd-time COLUMN-LABEL "Время изм." FORMAT "X(8)"
     3914   X_c-obj-hist.corr-user-name
     3915   X_c-obj-hist.corr-user-db-num
     3916   HEADER  date_string AT 5 format "X(35)"
     3917   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     3918   Line format "X(195)" AT 1
     3919   with width 232 down stream-io use-text    .
     3920   Line = fill("-", 195).
     3921   date_string = cur-time-print() .
     3922   assign
     3923   v-doc-rec = recid( X_c-obj-hist ).
     3924   DO WHILE available X_c-obj-hist :
     3925         GET prev br-obj-hist.
     3926   END.
     3927   run prn-lib-open-stream  in this-procedure (
     3928                                                input parparentProc
     3929                                               ,input 43
     3930                                               ,input yes
     3931                                               ,input no
     3932                                               ).
     3933   PUT  STREAM PrnLibStream
     3934   SPACE(25) ( frame Dialog-Frame:title )
     3935   format "x(90)" SKIP(1) .
     3936   FORM HEADER
     3937   Line format "X(180)" AT 1 SKIP
     3938   "Продолжение - на следующей странице" AT 30 SKIP
     3939   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3940   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     3941   FORM with FRAME HistoryList  .
     3942   run waitfram-show in this-procedure ("Ждите...").
     3943     GET next br-obj-hist.
     3944       DO WHILE available X_c-obj-hist :
     3945         Display STREAM PrnLibStream
     3946          get-action(X_c-obj-hist.action) @ v-action-chr
     3947         X_c-obj-hist.corr-date
     3948         string(X_c-obj-hist.corr-time, "HH:MM:SS":U) @ v-upd-time
     3949         X_c-obj-hist.corr-user-name
     3950         X_c-obj-hist.corr-user-db-num
     3951         with FRAME HistoryList .
     3952     DOWN STREAM PrnLibStream 1 with FRAME HistoryList  .
     3953     assign
     3954     accum-count = accum-count + 1
     3955     .
     3956     GET next br-obj-hist.
     3957   END.
     3958   UNDERLINE  STREAM PrnLibStream
     3959   v-action-chr
     3960   v-subject-chr
     3961   X_c-obj-hist.corr-date
     3962   v-upd-time
     3963   X_c-obj-hist.corr-user-name
     3964   X_c-obj-hist.corr-user-db-num
     3965   with FRAME HistoryList .
     3966   DISPLAY STREAM PrnLibStream
     3967   "ИТОГО"  @ v-obj
     3968   string(accum-count)  @ v-action-chr
     3969   with frame HistoryList.
     3970   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     3971   HIDE  STREAM PrnLibStream FRAME CheckList.
     3972   output  STREAM PrnLibStream CLOSE.
     3973   run waitfram-hide in this-procedure.
     3974   run prn-lib-prn-file in this-procedure (
     3975                                             input parparentproc
     3976                                             ,input 8
     3977                                             ).
     3978   reposition br-obj-hist to recid v-doc-rec no-error.
     3979   apply "entry" to br-obj-hist in frame Dialog-Frame.
     3980   END PROCEDURE.
     3981   PROCEDURE proc-b-sch :
     3982   assign
     3983     tbl = "c-counter"
     3984     join-tbl = 'X_c-obj-hist'
     3985     fld = ""
     3986     lab = ""
     3987     spr = ""
     3988     dim = '0'
     3989     .
     3990   run fltfield-add in this-procedure('corr-date', 'Дата корр.', '',
     3991   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3992   run fltfield-add in this-procedure('corr-time', 'Время корр.', 'time',
     3993   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3994   run fltfield-add in this-procedure('corr-user-db-num', 'БД корр.', '',
     3995   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3996   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     3997   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3998   run fltfield-add in this-procedure('action', 'Действие', 'hist-action',
     3999   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4000   Filter-Block:
     4001   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4002       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4003       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4004     run gbl/filter.w ( INPUT parparentproc
     4005                      , INPUT filter-point + chr(4) + filter-label
     4006                      , INPUT tbl
     4007                      , INPUT join-tbl
     4008                      , INPUT fld
     4009                      , INPUT lab
     4010                      , INPUT spr
     4011                      , INPUT dim ).
     4012     RUN OpenBr in this-procedure ( input yes, input no, input '':U, input v-corr-user-db-num).
     4013   END.
     4014   END PROCEDURE.
     4015   PROCEDURE proc-find-corr-date :
     4016   define input parameter p-next as logical no-undo.
     4017   define input parameter p-date like ub.fin-doc.doc-date no-undo.
     4018   define variable v-date-chr as character no-undo.
     4019   if p-date = ? then return .
     4020   display
     4021   0 @ sch-obj-code
     4022   0 @ sch-db-num
     4023   "":U @ sch-corr-user-name
     4024   with frame Dialog-Frame.
     4025   assign
     4026   v-date-chr = string(day(p-date)) + chr(47) +
     4027                    string(month(p-date)) + chr(47) +
     4028                    string(year(p-date)).
     4029          run OpenBr in this-procedure
     4030           (input false
     4031           ,input true
     4032           ,input substitute("and X_c-obj-hist.corr-date = &1 "
     4033             , v-date-chr)
     4034           ,input v-corr-user-db-num
     4035           ).
     4036         apply "entry":u to sch-corr-date in frame Dialog-Frame.
     4037   END PROCEDURE.
     4038   PROCEDURE proc-find-db-num :
     4039   define input parameter p-next as logical no-undo.
     4040   define input parameter p-db-num like c-counter.corr-user-db-num no-undo.
     4041   define variable v-db-num as character no-undo.
     4042   assign
     4043   sch-corr-date = ?
     4044   .
     4045   display
     4046   "":U @ sch-corr-user-name
     4047   0 @ sch-obj-code
     4048   sch-corr-date
     4049   with frame Dialog-Frame.
     4050   assign
     4051   v-db-num = string(p-db-num).
     4052   run OpenBr in this-procedure
     4053       (input false
     4054       ,input p-next
     4055       ,input substitute("and X_c-obj-hist.corr-user-db-num = &1 "
     4056         , v-db-num)
     4057       ,input v-corr-user-db-num
     4058       ).
     4059   apply "entry":u to sch-db-num in frame Dialog-Frame .
     4060   END PROCEDURE.
     4061   PROCEDURE proc-find-user :
     4062   define input parameter p-next as logical no-undo.
     4063   define input parameter p-user like c-counter.corr-user-name no-undo.
     4064   assign
     4065   sch-corr-date = ?.
     4066   display
     4067   0 @ sch-db-num
     4068   sch-corr-date
     4069   0 @ sch-obj-code
     4070   with frame Dialog-Frame.
     4071   p-user = chr(34) + p-user + chr(34).
     4072   run OpenBr in this-procedure
     4073       (input false
     4074       ,input p-next
     4075       ,input substitute("and X_c-obj-hist.corr-user-name = &1 "
     4076         , p-user)
     4077       ,input v-corr-user-db-num
     4078       ).
     4079   apply "entry":u to sch-corr-user-name in frame Dialog-Frame .
     4080   END PROCEDURE.
     4081   PROCEDURE proc-view-changes :
     4082   define variable v-description as character no-undo .
     4083   for each temp-changes:
     4084       delete temp-changes.
     4085   END.
     4086   if not available X_c-obj-hist then do:
     4087     b-nextlevel:visible IN FRAME Dialog-Frame = no.
     4088     Open QUery br-changes for each temp-changes.
     4089     return.
     4090   end.
     4091   b-nextlevel:visible IN FRAME Dialog-Frame =  no .
     4092   run local-view-cange in this-procedure (output v-description) .
     4093   Open QUery br-changes for each temp-changes by temp-changes.fNotChange.
     4094   assign
     4095   br-changes:title in frame Dialog-Frame = v-description
     4096   .
     4097   END PROCEDURE.
     4098   FUNCTION get-action RETURNS CHARACTER
     4099     ( p-action as integer ) :
     4100   define variable dops as character no-undo.
     4101   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     4102   RETURN dops.
     4103   END FUNCTION.
     4104   FUNCTION get-source-type RETURNS CHARACTER
     4105     ( p-source-type as character ) :
     4106   define variable v-dop as character no-undo .
     4107   assign
     4108   v-dop = entry (lookup (p-source-type, ',db,esys,trn-doc,payment,fin-doc,import,recalc,wth-doc,ren-gdsc,upgrade,grp-chg,stop-list,dis-card':U), ',БД,ВС,Документ,Платеж,Фин.док.,Импорт,Пересчет,Документ МЦ,Коллизия,Апгрейд,Изм.группы,Стоплист,ДК':U)
     4109   no-error
     4110   .
     4111   RETURN v-dop.
     4112   END FUNCTION.
     4113   function get-subject returns character
     4114     ( p-subject as character ) :
     4115     return p-subject.
     4116   end function.
     4117   procedure local-view-cange:
     4118      define output parameter odescription as character no-undo.
     4119      run obj-proc (output odescription).
     4120   end procedure.
     4121   function local-open-br returns logical
     4122   (  p-open-query     as logical    ,
     4123     p-find-next       as logical    ,
     4124     p-find-condition as character ):
     4125        define variable sort-column-phrase as character no-undo .
     4126        define variable l-query-was-opened as logical no-undo .
     4127        if p-mode eq "one"
     4128        then do:
     4129   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4130   define variable  l-disable-where-31  as logical   no-undo .
     4131   define variable  l-filter-open-31    as logical   .
     4132   define variable  flt-rec-31       as recid     no-undo .
     4133   define variable  filter-name-31      as character no-undo .
     4134   define variable  where-phrase-31     as character no-undo .
     4135   define variable  sort-phrase-31      as character no-undo .
     4136   define variable  where-phrase-rus-31 as character no-undo .
     4137   define variable  sort-phrase-rus-31  as character no-undo .
     4138     run waitfram-show in this-procedure
     4139       (input "ЖДИТЕ ..."
     4140       ).
     4141   run gbl/flt-get.p
     4142     (input filter-point
     4143     ,output flt-rec-31
     4144     ,output filter-name-31
     4145     ,output where-phrase-31
     4146     ,output sort-phrase-31
     4147     ,output where-phrase-rus-31
     4148     ,output sort-phrase-rus-31
     4149     ).
     4150   if p-open-query then do:
     4151       run set-filter-name in this-procedure
     4152         (INPUT filter-name-31
     4153         ) no-error .
     4154     assign
     4155       l-filter-open-31 = false
     4156     .
     4157     if flt-rec-31 <> ?
     4158       or sort-column-phrase > ""
     4159     then do:
     4160       define variable  parameter-2-31 as character no-undo .
     4161       define variable  parameter-3-31 as character no-undo .
     4162       define variable  parameter-4-31 as character no-undo .
     4163       define variable  parameter-5-31 as character no-undo .
     4164       define variable  parameter-6-31 as character no-undo .
     4165       define variable  parameter-7-31 as character no-undo .
     4166         assign
     4167         parameter-3-31 =
     4168                                 "FOR EACH X_c-obj-hist"
     4169         parameter-4-31 =
     4170           (
     4171             if ("               X_c-obj-hist.db             = idb           and X_c-obj-hist.file-name      = ifile-name           and X_c-obj-hist.key            = ikey           and X_c-obj-hist.code           = icode  " + " " + where-phrase-31) <> ""
     4172             then  substitute('  X_c-obj-hist.db             = &1                                        and X_c-obj-hist.file-name      = &2                                        and X_c-obj-hist.key            = &3                                        and X_c-obj-hist.code           = &4  ', idb, ifile-name, ikey, icode)   + " " + where-phrase-31
     4173             else "true"
     4174           )
     4175         parameter-5-31 = (" " + "" + " " + "")
     4176         parameter-6-31 = if sort-phrase-31 = ''
     4177                              then
     4178           (
     4179           " " + " " +
     4180             " " + sort-column-phrase +
     4181           " " + "  "
     4182           )
     4183                              else
     4184           (
     4185           " " + " " +
     4186             " " + sort-column-phrase +
     4187           " " + sort-phrase-31
     4188           )
     4189         parameter-7-31 =
     4190           " indexed-reposition  "
     4191       .
     4192       do
     4193       on stop undo, leave
     4194       on error undo, leave
     4195       :
     4196         assign
     4197           l-disable-where-31 =
     4198             ("               X_c-obj-hist.db             = idb           and X_c-obj-hist.file-name      = ifile-name           and X_c-obj-hist.key            = ikey           and X_c-obj-hist.code           = icode  " + " " + where-phrase-31 = "")
     4199         .
     4200         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4201                             ,input query br-obj-hist:handle
     4202                             ,input parameter-3-31
     4203                             ,input parameter-4-31
     4204                             ,input parameter-5-31
     4205                             ,input parameter-6-31
     4206                             ,input parameter-7-31
     4207                             )
     4208         .
     4209         assign
     4210           l-filter-open-31 = true
     4211         .
     4212       end.
     4213       if l-filter-open-31 = false then do:
     4214         message
     4215           "Ошибка при фильтрации / сортировке" skip
     4216           "Будут показаны записи без учета фильтра" skip
     4217           view-as alert-box .
     4218       end.
     4219       else do:
     4220           assign
     4221             l-query-was-opened = true
     4222           .
     4223       end.
     4224     end.
     4225     if l-filter-open-31 = false then do:
     4226       OPEN QUERY br-obj-hist FOR EACH X_c-obj-hist
     4227         where                X_c-obj-hist.db             = idb           and X_c-obj-hist.file-name      = ifile-name           and X_c-obj-hist.key            = ikey           and X_c-obj-hist.code           = icode
     4228         indexed-reposition
     4229     .
     4230         assign
     4231           l-query-was-opened = true
     4232         .
     4233     end.
     4234   end.
     4235   else do:
     4236     assign
     4237       v-doc-rec = recid( X_c-obj-hist )
     4238     .
     4239     do
     4240     on stop undo, leave
     4241     on error undo, leave
     4242     :
     4243       if query br-obj-hist:handle:get-buffer-handle(1) = (buffer X_c-obj-hist:handle) then do:
     4244         assign
     4245         parameter-2-31 = (if p-find-next then "true":u else "false":u )
     4246         parameter-4-31 =
     4247           "where ":u +  substitute('  X_c-obj-hist.db             = &1                                        and X_c-obj-hist.file-name      = &2                                        and X_c-obj-hist.key            = &3                                        and X_c-obj-hist.code           = &4  ', idb, ifile-name, ikey, icode)   + " ":u + where-phrase-31 + " ":u + p-find-condition + " " + ""
     4248         parameter-5-31 = " "
     4249       .
     4250         run fltopend_fltfindd in this-procedure  (
     4251                             input this-procedure:handle
     4252                             ,input query br-obj-hist:handle
     4253                             ,input rowid(X_c-obj-hist)
     4254                             ,input logical(parameter-2-31)
     4255                             ,input no-lock
     4256                             ,input (buffer X_c-obj-hist:handle)
     4257                             ,input parameter-4-31
     4258                             ,input parameter-5-31
     4259                             ) no-error.
     4260         .
     4261         assign
     4262           v-doc-rec = integer(return-value)
     4263           v-fltopend-rowid[1] = ?
     4264         .
     4265       end.
     4266       else do:
     4267         assign
     4268         parameter-2-31 = (if p-find-next then "true":u else "false":u )
     4269         parameter-3-31 =  "FOR EACH X_c-obj-hist"
     4270         parameter-4-31 =
     4271           (
     4272             if ("               X_c-obj-hist.db             = idb           and X_c-obj-hist.file-name      = ifile-name           and X_c-obj-hist.key            = ikey           and X_c-obj-hist.code           = icode  " + " " + where-phrase-31) <> ""
     4273             then  substitute('  X_c-obj-hist.db             = &1                                        and X_c-obj-hist.file-name      = &2                                        and X_c-obj-hist.key            = &3                                        and X_c-obj-hist.code           = &4  ', idb, ifile-name, ikey, icode)   + " " + where-phrase-31
     4274             else "true"
     4275           )
     4276         parameter-5-31 = (" " + "" + " " + "" + " " + p-find-condition)
     4277         parameter-6-31 = if sort-phrase-31 = ''
     4278                              then
     4279           (
     4280           " " + " " +
     4281             " " + sort-column-phrase +
     4282           " " + "  "
     4283           )
     4284                              else
     4285           (
     4286           " " + " " +
     4287             " " + sort-column-phrase +
     4288           " " + sort-phrase-31
     4289           )
     4290         parameter-7-31 =
     4291           " indexed-reposition  "
     4292       .
     4293         run fltopend_fltfindq in this-procedure  (
     4294                             input this-procedure:handle
     4295                             ,input query br-obj-hist:handle
     4296                             ,input logical(parameter-2-31)
     4297                             ,input no-lock
     4298                             ,input parameter-3-31
     4299                             ,input parameter-4-31
     4300                             ,input parameter-5-31
     4301                             ,input parameter-6-31
     4302                             ,input parameter-7-31
     4303                             ,output v-fltopend-rowid
     4304                             ) no-error.
     4305         .
     4306         v-doc-rec = ?.
     4307       end.
     4308       assign
     4309         l-query-was-opened = true
     4310       .
     4311     end.
     4312   end.
     4313     run waitfram-hide in this-procedure .
     4314        end.
     4315        else do:
     4316   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4317   define variable  l-disable-where-33  as logical   no-undo .
     4318   define variable  l-filter-open-33    as logical   .
     4319   define variable  flt-rec-33       as recid     no-undo .
     4320   define variable  filter-name-33      as character no-undo .
     4321   define variable  where-phrase-33     as character no-undo .
     4322   define variable  sort-phrase-33      as character no-undo .
     4323   define variable  where-phrase-rus-33 as character no-undo .
     4324   define variable  sort-phrase-rus-33  as character no-undo .
     4325     run waitfram-show in this-procedure
     4326       (input "ЖДИТЕ ..."
     4327       ).
     4328   run gbl/flt-get.p
     4329     (input filter-point
     4330     ,output flt-rec-33
     4331     ,output filter-name-33
     4332     ,output where-phrase-33
     4333     ,output sort-phrase-33
     4334     ,output where-phrase-rus-33
     4335     ,output sort-phrase-rus-33
     4336     ).
     4337   if p-open-query then do:
     4338       run set-filter-name in this-procedure
     4339         (INPUT filter-name-33
     4340         ) no-error .
     4341     assign
     4342       l-filter-open-33 = false
     4343     .
     4344     if flt-rec-33 <> ?
     4345       or sort-column-phrase > ""
     4346     then do:
     4347       define variable  parameter-2-33 as character no-undo .
     4348       define variable  parameter-3-33 as character no-undo .
     4349       define variable  parameter-4-33 as character no-undo .
     4350       define variable  parameter-5-33 as character no-undo .
     4351       define variable  parameter-6-33 as character no-undo .
     4352       define variable  parameter-7-33 as character no-undo .
     4353         assign
     4354         parameter-3-33 =
     4355                                 "FOR EACH X_c-obj-hist"
     4356         parameter-4-33 =
     4357           (
     4358             if (" TRUE " + " " + where-phrase-33) <> ""
     4359             then " TRUE " + " " + where-phrase-33
     4360             else "true"
     4361           )
     4362         parameter-5-33 = (" " + "" + " " + "")
     4363         parameter-6-33 = if sort-phrase-33 = ''
     4364                              then
     4365           (
     4366           " " + "" +
     4367             " " + sort-column-phrase +
     4368           " " + "  "
     4369           )
     4370                              else
     4371           (
     4372           " " + "" +
     4373             " " + sort-column-phrase +
     4374           " " + sort-phrase-33
     4375           )
     4376         parameter-7-33 =
     4377           " indexed-reposition  "
     4378       .
     4379       do
     4380       on stop undo, leave
     4381       on error undo, leave
     4382       :
     4383         assign
     4384           l-disable-where-33 =
     4385             (" TRUE " + " " + where-phrase-33 = "")
     4386         .
     4387         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4388                             ,input query br-obj-hist:handle
     4389                             ,input parameter-3-33
     4390                             ,input parameter-4-33
     4391                             ,input parameter-5-33
     4392                             ,input parameter-6-33
     4393                             ,input parameter-7-33
     4394                             )
     4395         .
     4396         assign
     4397           l-filter-open-33 = true
     4398         .
     4399       end.
     4400       if l-filter-open-33 = false then do:
     4401         message
     4402           "Ошибка при фильтрации / сортировке" skip
     4403           "Будут показаны записи без учета фильтра" skip
     4404           view-as alert-box .
     4405       end.
     4406       else do:
     4407           assign
     4408             l-query-was-opened = true
     4409           .
     4410       end.
     4411     end.
     4412     if l-filter-open-33 = false then do:
     4413       OPEN QUERY br-obj-hist FOR EACH X_c-obj-hist
     4414         where  TRUE
     4415         indexed-reposition
     4416     .
     4417         assign
     4418           l-query-was-opened = true
     4419         .
     4420     end.
     4421   end.
     4422   else do:
     4423     assign
     4424       v-doc-rec = recid( X_c-obj-hist )
     4425     .
     4426     do
     4427     on stop undo, leave
     4428     on error undo, leave
     4429     :
     4430       if query br-obj-hist:handle:get-buffer-handle(1) = (buffer X_c-obj-hist:handle) then do:
     4431         assign
     4432         parameter-2-33 = (if p-find-next then "true":u else "false":u )
     4433         parameter-4-33 =
     4434           "where ":u + " TRUE " + " ":u + where-phrase-33 + " ":u + p-find-condition + " " + ""
     4435         parameter-5-33 = ""
     4436       .
     4437         run fltopend_fltfindd in this-procedure  (
     4438                             input this-procedure:handle
     4439                             ,input query br-obj-hist:handle
     4440                             ,input rowid(X_c-obj-hist)
     4441                             ,input logical(parameter-2-33)
     4442                             ,input no-lock
     4443                             ,input (buffer X_c-obj-hist:handle)
     4444                             ,input parameter-4-33
     4445                             ,input parameter-5-33
     4446                             ) no-error.
     4447         .
     4448         assign
     4449           v-doc-rec = integer(return-value)
     4450           v-fltopend-rowid[1] = ?
     4451         .
     4452       end.
     4453       else do:
     4454         assign
     4455         parameter-2-33 = (if p-find-next then "true":u else "false":u )
     4456         parameter-3-33 =  "FOR EACH X_c-obj-hist"
     4457         parameter-4-33 =
     4458           (
     4459             if (" TRUE " + " " + where-phrase-33) <> ""
     4460             then " TRUE " + " " + where-phrase-33
     4461             else "true"
     4462           )
     4463         parameter-5-33 = (" " + "" + " " + "" + " " + p-find-condition)
     4464         parameter-6-33 = if sort-phrase-33 = ''
     4465                              then
     4466           (
     4467           " " + "" +
     4468             " " + sort-column-phrase +
     4469           " " + "  "
     4470           )
     4471                              else
     4472           (
     4473           " " + "" +
     4474             " " + sort-column-phrase +
     4475           " " + sort-phrase-33
     4476           )
     4477         parameter-7-33 =
     4478           " indexed-reposition  "
     4479       .
     4480         run fltopend_fltfindq in this-procedure  (
     4481                             input this-procedure:handle
     4482                             ,input query br-obj-hist:handle
     4483                             ,input logical(parameter-2-33)
     4484                             ,input no-lock
     4485                             ,input parameter-3-33
     4486                             ,input parameter-4-33
     4487                             ,input parameter-5-33
     4488                             ,input parameter-6-33
     4489                             ,input parameter-7-33
     4490                             ,output v-fltopend-rowid
     4491                             ) no-error.
     4492         .
     4493         v-doc-rec = ?.
     4494       end.
     4495       assign
     4496         l-query-was-opened = true
     4497       .
     4498     end.
     4499   end.
     4500     run waitfram-hide in this-procedure .
     4501        end.
     4502     return true.
     4503   end.
     4504   procedure obj-proc :
     4505   define output parameter p-description as character no-undo .
     4506   define variable v-mess as character no-undo.
     4507   do
     4508   on error undo, return error return-value
     4509   :
     4510   define variable v-label-param as character no-undo .
     4511     v-label-param =
     4512      "name"         + chr(4) + "Наименование счетчика " + chr(4) + "" + chr(8)
     4513    + "CountValue"   + chr(4) + "Наименование"           + chr(4) + "" + chr(8)
     4514    + "Rule"         + chr(4) + "Правила"                + chr(4) + "" + chr(8)
     4515    + "sysInfo"      + chr(4) + "Системная информация"   + chr(4) + "" .
     4516     run proc-full-temp-changes in this-procedure (
     4517                                                  input X_c-obj-hist.action = integer('1':U)
     4518                                                 ,input X_c-obj-hist.action = integer('99':U)
     4519                                                 ,input  buffer X_c-obj-hist:handle
     4520                                                 ,input  'counter':U
     4521                                                 ,input  "name,CountValue,Rule,sysInfo"
     4522                                                 ,input  v-label-param).
     4523   end.
     4524   end procedure.
