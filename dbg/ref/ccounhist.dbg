      605   procedure fltfield-clear :
      606     define output parameter loc-fld as character no-undo.
      607     define output parameter loc-lab as character no-undo .
      608     define output parameter loc-spr as character no-undo .
      609     define output parameter loc-dim as character no-undo .
      610     assign
      611       loc-fld = ""
      612       loc-lab = ""
      613       loc-spr = ""
      614       loc-dim = "0"
      615     .
      616   end procedure .
      617   procedure fltfield-add :
      618     define input        parameter par-fld as character no-undo.
      619     define input        parameter par-lab as character no-undo .
      620     define input        parameter par-spr as character no-undo .
      621     define input-output parameter loc-fld as character no-undo.
      622     define input-output parameter loc-lab as character no-undo .
      623     define input-output parameter loc-spr as character no-undo .
      624     define input-output parameter loc-dim as character no-undo .
      625     do
      626     on error undo, return error
      627     :
      628       assign
      629       loc-fld = if loc-dim = '0'
      630                 then par-fld
      631                 else (loc-fld + chr(44) + par-fld)
      632       loc-lab = if loc-dim = '0'
      633                 then par-lab
      634                 else (loc-lab + chr(44) + par-lab)
      635       loc-spr = if loc-dim = '0'
      636                 then par-spr
      637                 else (loc-spr + chr(44) + par-spr)
      638       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      639                 string(integer(if num-entries(loc-dim) > 1
      640                               then entry(2, loc-dim)
      641                               else entry(1, loc-dim)
      642                               ) + 1)
      643       no-error
      644       .
      645     end.
      646   end procedure.
