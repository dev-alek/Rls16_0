     1633     run proc-find-user in this-procedure(yes, input frame Dialog-Frame sch-corr-user-name) no-error.
     1634     if error-status:error then return no-apply.
     1635   END.
     1636   ON RETURN OF sch-corr-user-name IN FRAME Dialog-Frame
     1637   DO:
     1638     run proc-find-user in this-procedure(no, input frame Dialog-Frame sch-corr-user-name) no-error.
     1639     if error-status:error then return no-apply.
