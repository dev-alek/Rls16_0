     3489   title0 = "Список полной истории контрагента" + chr(32).
     3490   run waitfram-show in this-procedure ("Ждите...").
     3491   define variable sort-column-phrase as character no-undo .
     3492   case sort-column-name :
     3493     when "" then do:
     3494       assign
     3495         sort-column-phrase = ""
     3496       .
     3497     end.
     3498     otherwise do:
     3499       assign
     3500         sort-column-phrase = "by " + sort-column-name
     3501       .
     3502     end.
     3503   end case.
     3504   define variable l-open-query as logical   no-undo .
     3505   if p-mode = 'все':U then
     3506   do:
     3507         assign
