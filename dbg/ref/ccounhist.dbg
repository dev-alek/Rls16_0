      133   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      134   define variable c-point  as character no-undo .
      135   define variable tbl      as character no-undo .
      136   define variable join-tbl as character no-undo .
      137   define variable fld      as character no-undo .
      138   define variable lab      as character no-undo .
      139   define variable spr      as character no-undo .
      140   define variable dim      as character no-undo .
      141   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      142   procedure cur-time :
      143      define output parameter p-today as date      no-undo .
      144      define output parameter p-time  as integer   no-undo .
      145     do
      146     on error undo, return error
      147     :
      148       define variable v-date1 as date      no-undo .
      149       define variable v-date2 as date      no-undo .
      150       define variable v-time  as integer   no-undo .
      151       assign
      152         v-date1 = today
      153         v-time  = time
      154         v-date2 = today
      155       .
      156       if v-date1 <> v-date2
      157       then do:
      158         assign
      159           v-date1 = today
      160           v-time  = v-time
      161         .
      162       end.
      163       assign
      164         p-today = v-date1
      165         p-time  = v-time
      166       .
      167     end.
      168   end.
      169   function cur-time-date returns character
      170   :
      171     return string(today, '99/99/9999':U) .
      172   end.
      173   function cur-time-mjd returns decimal
      174   :
      175     define variable v-date as date      no-undo .
      176     define variable v-time as integer   no-undo .
      177     run cur-time in this-procedure
      178       (output v-date
      179       ,output v-time
      180       ) .
      181     return integer(v-date) - 2400002 + (v-time / 86400) .
      182   end.
      183   function cur-time-get-ending-index returns integer
      184   (input p-number as integer
      185   )
      186   :
      187     if p-number < 0
      188     or p-number = ?
      189     then do:
      190       return 1 .
      191     end.
      192     define variable v-rest as integer   no-undo .
      193     assign
      194       p-number = p-number modulo 100
      195     .
      196     if p-number < 20
      197     then do:
      198       assign
      199         v-rest = p-number
      200       .
      201     end.
      202     else do:
      203       assign
      204         v-rest = p-number modulo 10
      205       .
      206     end.
      207     case v-rest :
      208       when 1
      209       then do:
      210         return 2 .
      211       end.
      212       when 2 or
      213       when 3 or
      214       when 4
      215       then do:
      216         return 3 .
      217       end.
      218       otherwise do:
      219         return 1 .
      220       end.
      221     end case .
      222   end.
      223   procedure cur-time-mjd-to-date :
      224      define input  parameter i-mjd-diff as decimal no-undo.
      225      define output parameter o-Date     as date    no-undo.
      226      define output parameter o-Time     as integer no-undo.
      227      define variable v-day-number as integer   no-undo .
      228      if    i-mjd-diff < 0
      229         or i-mjd-diff = ?
      230      then do:
      231         return "?" .
      232      end.
      233      assign
      234         v-day-number = truncate(i-mjd-diff,0).
      235         o-Date = date(v-day-number + 2400002).
      236         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      237     .
      238   end.
      239   function cur-time-mjd-to-string returns character
      240   (input p-mjd-diff as decimal
      241   )
      242   :
      243     define variable v-day-number as integer   no-undo .
      244     define variable v-seconds    as integer   no-undo .
      245     define variable v-hour       as integer   no-undo .
      246     define variable v-min        as integer   no-undo .
      247     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      248     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      249     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      250     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      251     if p-mjd-diff < 0
      252     or p-mjd-diff = ?
      253     then do:
      254       return "?" .
      255     end.
      256     assign
      257       v-day-number = integer(truncate(p-mjd-diff,0))
      258       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      259     .
      260     if v-seconds > 86400
      261     then do:
      262       assign
      263         v-seconds = 86400 - 1
      264       .
      265     end.
      266     if v-seconds < 0
      267     then do:
      268       assign
      269         v-seconds = 0
      270       .
      271     end.
      272     assign
      273       v-hour = truncate(v-seconds / 3600, 0)
      274     .
      275     assign
      276       v-seconds = v-seconds modulo 3600
      277     .
      278     assign
      279       v-min = truncate(v-seconds / 60, 0)
      280     .
      281     assign
      282       v-seconds = v-seconds modulo 60
      283     .
      284     return
      285         (if v-day-number <> 0
      286           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      287           else ""
      288         )
      289       + (if v-day-number <> 0 or v-hour <> 0
      290           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      291           else ""
      292         )
      293       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      294           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      295           else ""
      296         )
      297       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      298       .
      299   end.
      300   function cur-time-string returns character
      301   :
      302     define variable v-date as date      no-undo .
      303     define variable v-time as integer   no-undo .
      304     run cur-time in this-procedure
      305       (output v-date
      306       ,output v-time
      307       ) .
      308     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      309   end.
      310   function cur-time-string-sec returns character
      311   :
      312     define variable v-date as date      no-undo .
      313     define variable v-time as integer   no-undo .
      314     run cur-time in this-procedure
      315       (output v-date
      316       ,output v-time
      317       ) .
      318     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      319   end.
      320   function cur-time-custom  returns character
      321   (input p-prefix as character
      322   ,input p-date-format as character
      323   ,input p-delimiter as character
      324   ,input p-time-format as character
      325   ,input p-suffix as character
      326   )
      327   :
      328     define variable v-date as date      no-undo .
      329     define variable v-time as integer   no-undo .
      330     run cur-time in this-procedure
      331       (output v-date
      332       ,output v-time
      333       ) .
      334     return
      335       p-prefix
      336       + string(v-date, p-date-format)
      337       + p-delimiter
      338       + string(v-time, p-time-format)
      339       + p-suffix
      340       .
      341   end.
      342   function cur-time-print  returns character
      343   :
      344     define variable v-date as date      no-undo .
      345     define variable v-time as integer   no-undo .
      346     run cur-time in this-procedure
      347       (output v-date
      348       ,output v-time
      349       ) .
      350     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      351   end.
      352   function cur-time-datetime returns datetime
      353   :
      354     define variable v-char as character no-undo .
      355     define variable v-datetime as datetime no-undo .
      356     v-char = cur-time-string().
      357     v-datetime = datetime(v-char).
      358     return  v-datetime.
      359   end.
      360   function cur-time-string-msec returns character
      361   :
      362     define variable v-date as datetime  no-undo .
      363     v-date = now.
      364     return string(v-date) .
      365   end.
      366   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      367   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      368   define new shared variable RepPathName        as character no-undo .
      369   define new shared variable PrintRubl          as logical   no-undo .
      370   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      371   define variable v-waitfram-action01         as character   no-undo .
      372   define variable v-waitfram-action02         as character   no-undo .
      373   define variable v-waitfram-action03         as character   no-undo .
      374   define variable mWaitFramTextBeg            as character   no-undo.
      375   define variable mWaitFramTextEnd            as character   no-undo.
      376   define variable mWaitFramView               as logical     no-undo.
      377   define variable mWaitProcEvent              as logical     no-undo init yes.
      378   define variable mWaitFramInterval           as integer     no-undo init 1 .
      379   define variable mWaitFramStop               as logical     no-undo.
      380   define variable mWaitFramStopUser           as logical     no-undo.
      381   define variable mWaitFramStopTimeOut        as logical     no-undo.
      382   define variable mWaitFramStartProc          as datetime-tz no-undo.
      383   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      384   define button B-WaitFramStop auto-end-key
      385        label "Стоп"
      386        size 10 by 1 tooltip "Остоновить процесс".
      387   define button B-viewProcInfo
      388        label "Информация"
      389        size 15 by 1 tooltip "Информация о процесс".
      390   define frame waitfram
      391     v-waitfram-action01 format "x(72)" no-label skip
      392     v-waitfram-action02 format "x(72)" no-label skip
      393     v-waitfram-action03 format "x(72)" no-label skip
      394     B-viewProcInfo
      395     B-WaitFramStop at row 4 col 30
      396     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      397     .
      398   define new global shared variable mBatchMode as logical no-undo init ?.
      399   define variable mFramBachModHandle as handle no-undo.
      400   mFramBachModHandle = frame waitfram:handle.
      401   define variable mFameOldVis as logical no-undo.
      402   define variable mVisCUrentVin as logical no-undo.
      403   if session:batch-mode
      404   then
      405      mBatchMode = yes.
      406   if mBatchMode = ? then do:
      407     mVisCUrentVin = current-window:visible.
      408     mFameOldVis = mFramBachModHandle:visible.
      409     mFramBachModHandle:visible  = yes.
      410     mBatchMode = mFramBachModHandle:visible ne yes.
      411     mFramBachModHandle:visible = mFameOldVis.
      412     current-window:visible = mVisCUrentVin.
      413   end.
      414    if  log-manager:logfile-name ne ?
      415     then DO:
      416         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      417         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      418         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      419     end.
      420   on choose of B-WaitFramStop in frame waitfram
      421   do:
      422     mWaitFramStop = yes.
      423     mWaitFramStopUser = yes.
      424   end.
      425   function waitfram-check-timeout returns logical():
      426      define variable vtime as int64 no-undo.
      427      if mWaitFramStopTimeOut
      428      then
      429         return yes.
      430      vtime = ( now - mWaitFramStartProc ) / 1000 .
      431      if     mWaitFramTimeOut ne ?
      432         and mWaitFramTimeOut ne 0
      433         and mWaitFramTimeOut lt vtime
      434      then do:
      435         mWaitFramStopTimeOut = yes.
      436      end.
      437      return mWaitFramStopTimeOut.
      438   end.
      439   procedure waitfram-hide :
      440     if not session:batch-mode
      441     then do
      442     on error undo, return error return-value
      443     :
      444       pause 0 before-hide .
      445       if not mBatchMode then
      446         hide frame waitfram .
      447     end.
      448   end procedure.
      449   procedure waitfram-show :
      450     define input  parameter p-message as character no-undo .
      451     define variable v-left-margin as integer   no-undo .
      452     if not session:batch-mode
      453     then do
      454     on error undo, return error return-value
      455     :
      456       if length(p-message) <= 70 then do:
      457         assign
      458           v-left-margin = integer((70 - length(p-message)) / 2)
      459         .
      460         assign
      461           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      462         .
      463         assign
      464           v-waitfram-action01 = " "
      465           v-waitfram-action02 = " "
      466                                    + fill(" ", v-left-margin)
      467                                    + p-message
      468           v-waitfram-action03 = " "
      469         .
      470       end.
      471       else do:
      472         define variable vRindex1 as integer no-undo.
      473         define variable vRindex2 as integer no-undo.
      474         vRindex1 = r-index(p-message," ",70).
      475         if vRindex1 = 0
      476         then
      477            vRindex1 = 70.
      478         if length(p-message)  <= vRindex1 + 70 then do:
      479           assign
      480             v-waitfram-action01 = " "
      481             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      482             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      483           .
      484         end.
      485         else do:
      486           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      487           if vRindex2 <= vRindex1
      488           then
      489              vRindex2 = vRindex1 + 70.
      490           assign
      491             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      492             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      493             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      494           .
      495         end.
      496       end.
      497       B-viewProcInfo:visible   in frame waitfram = no.
      498       B-viewProcInfo:sensitive in frame waitfram = no.
      499       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      500       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      501       if  (   mWaitFramView
      502          or  mWaitProcEvent)
      503          and not mBatchMode
      504       then
      505          display
      506             v-waitfram-action01 skip
      507             v-waitfram-action02 skip
      508             v-waitfram-action03 skip
      509          with frame waitfram .
      510     end.
      511   end procedure.
      512      procedure waitfram-show-this:
      513         define input  parameter iInterval as int64 no-undo.
      514         define variable vtime as int64 no-undo.
      515         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      516         mWaitFramInterval = iInterval.
      517         run waitfram-show (substitute("&1&2 &3&4" ,
      518                                       mWaitFramTextBeg ,
      519                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      520                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      521                                       mWaitFramTextEnd
      522                                      )
      523                           ).
      524      end.
      525      procedure WaitFramRunPause:
      526         define input  parameter iInterval as dec no-undo.
      527         define variable vStart  as datetime-tz no-undo.
      528         define variable vend    as datetime-tz no-undo.
      529         define variable vint as int64 no-undo.
      530         define variable vOk as logical no-undo.
      531         vStart = now.
      532         vend   = vStart.
      533         publish "WaitFramPause" (iInterval,output vOk).
      534         vend   =  now.
      535         vint = vend - vStart.
      536         vint = iInterval - vint / 1000.
      537         if     not mWaitFramStop
      538            and (   vint > 0
      539                 or (    not vOk
      540                     and iInterval eq ?
      541                     )
      542                 )
      543         then
      544            run waitfram-show-this (iInterval).
      545         vend   =  now.
      546         vint = vend - vStart.
      547         vint = iInterval - vint / 1000.
      548         if     not mWaitFramStop
      549            and vint > 0
      550         then do:
      551            run gbl/pause.p (vint * 1000).
      552         end.
      553         if iInterval ne ?
      554         then
      555            publish "WaitFramStop".
      556         waitfram-check-timeout().
      557      end.
      558      procedure WaitFramWaitFor:
      559         define input  parameter iInterval as dec no-undo.
      560         assign
      561            mWaitFramStartProc   = now
      562            mWaitFramStopUser    = no
      563            mWaitFramStopTimeOut = no
      564         .
      565         block-wait:
      566         do while not mWaitFramStop:
      567            run WaitFramRunPause (iInterval).
      568            if  waitfram-check-timeout()
      569            then do:
      570               leave block-wait.
      571            end.
      572         end.
      573         run waitfram-hide.
      574      end.
      575   procedure waitfram-join :
      576     define input  parameter p-line-1  as character no-undo .
      577     define input  parameter p-line-2  as character no-undo .
      578     define input  parameter p-line-3  as character no-undo .
      579     define output parameter p-message as character no-undo .
      580     do
      581     on error undo, return error return-value
      582     :
      583       assign
      584         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      585                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      586                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      587       .
      588     end.
      589   end procedure.
      590   function waitfram-join-function returns character
      591     (input p-line-1 as character
      592     ,input p-line-2 as character
      593     ,input p-line-3 as character
      594     ).
      595     define variable v-message as character no-undo .
      596     run waitfram-join in this-procedure
      597       (input  p-line-1
      598       ,input  p-line-2
      599       ,input  p-line-3
      600       ,output v-message
      601       ) .
      602     return v-message .
      603   end function .
