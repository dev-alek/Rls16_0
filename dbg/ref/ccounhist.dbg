      870   procedure fltopend_fltopend :
      871   define input parameter p-parent-handle as handle no-undo .
      872   define input parameter p-qh as handle no-undo .
      873   define input parameter p-flt-open-open-query  as character no-undo .
      874   define input parameter p-where-cond as character no-undo .
      875   define input parameter p-use-indFIRST-query-tail as character no-undo .
      876   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      877   define input parameter p-indexed-reposition as character no-undo .
      878     do
      879     on error undo, return error
      880     :
      881   define variable v-prepare-string as character no-undo .
      882   define variable glog as logical no-undo .
      883   assign
      884   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      885                      p-where-cond + chr(32)  +
      886                      p-use-indFIRST-query-tail + chr(32) +
      887                      p-use-ind-sort-clmn-by + chr(32) +
      888                      p-indexed-reposition
      889   .
      890   assign
      891   glog = p-qh:query-prepare(v-prepare-string) no-error .
      892   if not glog
      893   or error-status:error then do:
      894     message error-status:get-message(1) view-as alert-box .
      895     undo, return error .
      896   end.
      897   assign
      898   glog = p-qh:query-open no-error .
      899   if not glog
      900   or error-status:error then do:
      901     message error-status:get-message(1) view-as alert-box .
      902     undo, return error .
      903   end.
      904     end.
      905   end procedure.
      906   procedure fltopend_fltfindd :
      907   define input parameter p-parent-handle as handle no-undo .
      908   define input parameter p-qh as handle no-undo .
      909   define input parameter p-rowid as rowid no-undo .
      910   define input parameter p-next as logical no-undo .
      911   define input parameter p-lock as integer no-undo .
      912   define input parameter p-bh as handle no-undo .
      913   define input parameter p-where-cond as character no-undo .
      914   define input parameter p-use-index-phrase as character no-undo .
      915   define variable glog as logical no-undo .
      916   define variable v-qh as handle no-undo .
      917   define variable v-bh as handle no-undo .
      918   define variable v-recid as recid no-undo .
      919   define variable v-prepare-string as character no-undo .
      920   do
      921   on error undo, return error
      922   on stop undo, return error
      923   :
      924     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      925     create buffer v-bh for table p-bh buffer-name p-bh:name.
      926     create query v-qh.
      927     v-qh:set-buffers(v-bh).
      928     v-prepare-string = substitute("for each &1 &2 &3"
      929                                     ,v-bh:name
      930                                     ,p-where-cond
      931                                     ,p-use-index-phrase).
      932     glog = v-qh:query-prepare(v-prepare-string) no-error.
      933     if not glog then do:
      934       delete object v-qh.
      935       delete object v-bh.
      936       undo, return error .
      937     end.
      938     glog = v-qh:query-open no-error .
      939     if not glog then do:
      940       delete object v-qh.
      941       delete object v-bh.
      942       undo, return error .
      943     end.
      944     if p-next then do:
      945       v-qh:reposition-to-rowid(p-rowid) no-error .
      946       glog = v-qh:get-next( p-lock) no-error .
      947       glog = v-qh:get-next( p-lock) no-error .
      948       if not glog or v-qh:query-off-end = yes then do:
      949         glog = v-qh:get-first( p-lock) no-error .
      950       end.
      951     end.
      952     else do:
      953       glog = v-qh:get-first( p-lock) no-error .
      954     end.
      955     v-recid = v-bh:recid no-error .
      956     delete object v-qh.
      957     delete object v-bh.
      958     return string(v-recid) .
      959   end.
      960   end procedure.
      961   procedure fltopend_fltfindq :
      962   define input parameter p-parent-handle as handle no-undo .
      963   define input parameter p-qh as handle no-undo .
      964   define input parameter p-next as logical no-undo .
      965   define input parameter p-lock as integer no-undo .
      966   define input parameter p-flt-open-open-query  as character no-undo .
      967   define input parameter p-where-cond as character no-undo .
      968   define input parameter p-use-indFIRST-query-tail as character no-undo .
      969   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      970   define input parameter p-indexed-reposition as character no-undo .
      971   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      972   define variable glog as logical no-undo .
      973   define variable v-qh as handle no-undo .
      974   define variable v-bh as handle no-undo extent 18.
      975   define variable v-rowid as rowid no-undo extent 18.
      976   define variable v-ii as integer no-undo .
      977   define variable v-prepare-string as character no-undo .
      978   do
      979   on error undo, return error
      980   on stop undo, return error
      981   :
      982     create query v-qh.
      983     do v-ii = 1 to p-qh:num-buffers:
      984       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      985       assign
      986       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      987       no-error.
      988       v-qh:add-buffer(v-bh[v-ii]).
      989     end.
      990     assign
      991     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      992                       p-where-cond + chr(32)  +
      993                       p-use-indFIRST-query-tail + chr(32) +
      994                       p-use-ind-sort-clmn-by + chr(32) +
      995                       p-indexed-reposition
      996     .
      997     glog = v-qh:query-prepare( v-prepare-string) no-error .
      998     if not glog then do:
      999       delete object v-qh.
     1000       do v-ii = 1 to p-qh:num-buffers:
     1001         delete object v-bh[v-ii].
     1002       end.
     1003       undo, return error .
     1004     end.
     1005     glog = v-qh:query-open no-error .
     1006     if not glog then do:
     1007       delete object v-qh.
     1008       do v-ii = 1 to p-qh:num-buffers:
     1009         delete object v-bh[v-ii].
     1010       end.
     1011       undo, return error .
     1012     end.
     1013     if p-next then do:
     1014       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1015       glog = v-qh:get-next( p-lock) no-error .
     1016       glog = v-qh:get-next( p-lock) no-error .
     1017       if not glog or v-qh:query-off-end = yes then do:
     1018         glog = v-qh:get-first( p-lock) no-error .
     1019       end.
     1020     end.
     1021     else do:
     1022       glog = v-qh:get-first( p-lock) no-error .
     1023     end.
     1024     do v-ii = 1 to p-qh:num-buffers:
     1025       assign
     1026       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1027       no-error.
     1028     end.
     1029     delete object v-qh.
     1030     do v-ii = 1 to p-qh:num-buffers:
     1031       delete object v-bh[v-ii].
     1032     end.
     1033   end.
     1034   end procedure.
