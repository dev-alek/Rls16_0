     1599        run proc-br-obj-hist in this-procedure no-error.
     1600     if error-status:error then return no-apply.
     1601   END.
     1602   ON RETURN OF br-obj-hist IN FRAME Dialog-Frame
     1603   DO:
     1604       run proc-br-obj-hist in this-procedure no-error.
     1605     if error-status:error then return no-apply.
     1606   END.
     1607   ON VALUE-CHANGED OF br-obj-hist IN FRAME Dialog-Frame
     1608   DO:
     1609     run proc-view-changes in this-procedure no-error.
     1610   END.
     1611   ON CTRL-J OF sch-obj-code IN FRAME Dialog-Frame
