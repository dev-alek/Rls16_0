     1548         .
     1549       end.
     1550       do with frame Dialog-Frame
     1551       :
     1552         hide v-diasize-resize-button .
     1553         v-diasize-resize-button :row = 1.
     1554         v-diasize-resize-button :column = 1.
     1555       end.
     1556       if p-change-value > 0
     1557       then do:
     1558         if frame Dialog-Frame :scrollable = true
     1559         then do:
     1560           assign
     1561             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1562             no-error .
     1563           if error-status :error
     1564           or error-status :get-message(1) <> ""
     1565           then do:
