     1521           and can-query(v-object-handle, "row")
     1522           and can-query(v-object-handle, "height")
     1523           and ( v-object-handle :col + v-object-handle :width
     1524                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1525               )
     1526           then do:
     1527             find first buf_temp-browse-handle
     1528               where buf_temp-browse-handle.browse-type   = 'width':u
     1529                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1530               no-error .
