      402   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      403   define variable v-waitfram-action01         as character   no-undo .
      404   define variable v-waitfram-action02         as character   no-undo .
      405   define variable v-waitfram-action03         as character   no-undo .
      406   define variable mWaitFramTextBeg            as character   no-undo.
      407   define variable mWaitFramTextEnd            as character   no-undo.
      408   define variable mWaitFramView               as logical     no-undo.
      409   define variable mWaitProcEvent              as logical     no-undo init yes.
      410   define variable mWaitFramInterval           as integer     no-undo init 1 .
      411   define variable mWaitFramStop               as logical     no-undo.
      412   define variable mWaitFramStopUser           as logical     no-undo.
      413   define variable mWaitFramStopTimeOut        as logical     no-undo.
      414   define variable mWaitFramStartProc          as datetime-tz no-undo.
      415   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      416   define button B-WaitFramStop auto-end-key
      417        label "Стоп"
      418        size 10 by 1 tooltip "Остоновить процесс".
      419   define button B-viewProcInfo
      420        label "Информация"
      421        size 15 by 1 tooltip "Информация о процесс".
      422   define frame waitfram
      423     v-waitfram-action01 format "x(72)" no-label skip
      424     v-waitfram-action02 format "x(72)" no-label skip
      425     v-waitfram-action03 format "x(72)" no-label skip
      426     B-viewProcInfo
      427     B-WaitFramStop at row 4 col 30
      428     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      429     .
      430   define new global shared variable mBatchMode as logical no-undo init ?.
      431   define variable mFramBachModHandle as handle no-undo.
      432   mFramBachModHandle = frame waitfram:handle.
      433   define variable mFameOldVis as logical no-undo.
      434   define variable mVisCUrentVin as logical no-undo.
      435   if session:batch-mode
      436   then
      437      mBatchMode = yes.
      438   if mBatchMode = ? then do:
      439     mVisCUrentVin = current-window:visible.
      440     mFameOldVis = mFramBachModHandle:visible.
      441     mFramBachModHandle:visible  = yes.
      442     mBatchMode = mFramBachModHandle:visible ne yes.
      443     mFramBachModHandle:visible = mFameOldVis.
      444     current-window:visible = mVisCUrentVin.
      445   end.
      446    if  log-manager:logfile-name ne ?
      447     then DO:
      448         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      449         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      450         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      451     end.
      452   on choose of B-WaitFramStop in frame waitfram
      453   do:
      454     mWaitFramStop = yes.
      455     mWaitFramStopUser = yes.
      456   end.
      457   function waitfram-check-timeout returns logical():
      458      define variable vtime as int64 no-undo.
      459      if mWaitFramStopTimeOut
      460      then
      461         return yes.
      462      vtime = ( now - mWaitFramStartProc ) / 1000 .
      463      if     mWaitFramTimeOut ne ?
      464         and mWaitFramTimeOut ne 0
      465         and mWaitFramTimeOut lt vtime
      466      then do:
      467         mWaitFramStopTimeOut = yes.
      468      end.
      469      return mWaitFramStopTimeOut.
      470   end.
      471   procedure waitfram-hide :
      472     if not session:batch-mode
      473     then do
      474     on error undo, return error return-value
      475     :
      476       pause 0 before-hide .
      477       if not mBatchMode then
      478         hide frame waitfram .
      479     if     not mWaitFramView
      480        and mWaitProcEvent
      481     then
      482       process events .
      483     end.
      484   end procedure.
      485   procedure waitfram-show :
      486     define input  parameter p-message as character no-undo .
      487     define variable v-left-margin as integer   no-undo .
      488     if not session:batch-mode
      489     then do
      490     on error undo, return error return-value
      491     :
      492       if length(p-message) <= 70 then do:
      493         assign
      494           v-left-margin = integer((70 - length(p-message)) / 2)
      495         .
      496         assign
      497           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      498         .
      499         assign
      500           v-waitfram-action01 = " "
      501           v-waitfram-action02 = " "
      502                                    + fill(" ", v-left-margin)
      503                                    + p-message
      504           v-waitfram-action03 = " "
      505         .
      506       end.
      507       else do:
      508         define variable vRindex1 as integer no-undo.
      509         define variable vRindex2 as integer no-undo.
      510         vRindex1 = r-index(p-message," ",70).
      511         if vRindex1 = 0
      512         then
      513            vRindex1 = 70.
      514         if length(p-message)  <= vRindex1 + 70 then do:
      515           assign
      516             v-waitfram-action01 = " "
      517             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      518             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      519           .
      520         end.
      521         else do:
      522           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      523           if vRindex2 <= vRindex1
      524           then
      525              vRindex2 = vRindex1 + 70.
      526           assign
      527             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      528             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      529             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      530           .
      531         end.
      532       end.
      533       B-viewProcInfo:visible   in frame waitfram = no.
      534       B-viewProcInfo:sensitive in frame waitfram = no.
      535       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      536       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      537       if  (   mWaitFramView
      538          or  mWaitProcEvent)
      539          and not mBatchMode
      540       then
      541          display
      542             v-waitfram-action01 skip
      543             v-waitfram-action02 skip
      544             v-waitfram-action03 skip
      545          with frame waitfram .
      546       if     mWaitFramView
      547          then do:
      548             if     mWaitFramInterval ne ?
      549                and not mBatchMode
      550             then
      551                wait-for go of frame waitfram pause mWaitFramInterval.
      552          end.
      553          else
      554             if     mWaitProcEvent
      555                and not mBatchMode
      556             then
      557                process events .
      558     end.
      559   end procedure.
      560      procedure waitfram-show-this:
      561         define input  parameter iInterval as int64 no-undo.
      562         define variable vtime as int64 no-undo.
      563         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      564         mWaitFramInterval = iInterval.
      565         run waitfram-show (substitute("&1&2 &3&4" ,
      566                                       mWaitFramTextBeg ,
      567                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      568                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      569                                       mWaitFramTextEnd
      570                                      )
      571                           ).
      572      end.
      573      procedure WaitFramRunPause:
      574         define input  parameter iInterval as dec no-undo.
      575         define variable vStart  as datetime-tz no-undo.
      576         define variable vend    as datetime-tz no-undo.
      577         define variable vint as int64 no-undo.
      578         define variable vOk as logical no-undo.
      579         vStart = now.
      580         vend   = vStart.
      581         publish "WaitFramPause" (iInterval,output vOk).
      582         vend   =  now.
      583         vint = vend - vStart.
      584         vint = iInterval - vint / 1000.
      585         if     not mWaitFramStop
      586            and (   vint > 0
      587                 or (    not vOk
      588                     and iInterval eq ?
      589                     )
      590                 )
      591         then
      592            run waitfram-show-this (iInterval).
      593         vend   =  now.
      594         vint = vend - vStart.
      595         vint = iInterval - vint / 1000.
      596         if     not mWaitFramStop
      597            and vint > 0
      598         then do:
      599            run gbl/pause.p (vint * 1000).
      600         end.
      601         if iInterval ne ?
      602         then
      603            publish "WaitFramStop".
      604         waitfram-check-timeout().
      605      end.
      606      procedure WaitFramWaitFor:
      607         define input  parameter iInterval as dec no-undo.
      608         assign
      609            mWaitFramStartProc   = now
      610            mWaitFramStopUser    = no
      611            mWaitFramStopTimeOut = no
      612         .
      613         block-wait:
      614         do while not mWaitFramStop:
      615            run WaitFramRunPause (iInterval).
      616            if  waitfram-check-timeout()
      617            then do:
      618               leave block-wait.
      619            end.
      620         end.
      621         run waitfram-hide.
      622      end.
      623   procedure waitfram-join :
      624     define input  parameter p-line-1  as character no-undo .
      625     define input  parameter p-line-2  as character no-undo .
      626     define input  parameter p-line-3  as character no-undo .
      627     define output parameter p-message as character no-undo .
      628     do
      629     on error undo, return error return-value
      630     :
      631       assign
      632         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      633                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      634                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      635       .
      636     end.
      637   end procedure.
      638   function waitfram-join-function returns character
      639     (input p-line-1 as character
      640     ,input p-line-2 as character
      641     ,input p-line-3 as character
      642     ).
      643     define variable v-message as character no-undo .
      644     run waitfram-join in this-procedure
      645       (input  p-line-1
      646       ,input  p-line-2
      647       ,input  p-line-3
      648       ,output v-message
      649       ) .
      650     return v-message .
      651   end function .
      652   define input parameter parParentProc AS WIDGET-HANDLE  no-undo .
      653   define input parameter  parhost-code like ub.clients.obj-code no-undo.
      654   define variable  pardefobj-type     like ub.clients.obj-type no-undo.
      655   define variable  pardefobj-code     like ub.clients.obj-code no-undo.
      656   define variable  parobj-type        like ub.clients.obj-type no-undo.
      657   define variable  parobj-code        like ub.clients.obj-code no-undo.
      658   define temp-table tt-shst no-undo
      659   field obj-type like ub.clients.obj-type
      660   field obj-code like ub.clients.obj-code
      661   field obj-name like ub.clients.obj-name
      662   FIELD Ostatok-start AS DECIMAL
      663   FIELD plan-pri      AS DECIMAL
      664   FIELD proch         AS DECIMAL
      665   FIELD proch-ras     AS DECIMAL
      666   field upd           as log
      667   field upd1          as log
      668   field upd2          as log
      669   field upd3          as log
      670   field upd4          as log
      671   index pi is unique primary obj-type obj-code.
      672   define buffer bf_tt-shst for tt-shst.
      673   define variable g-log as logical no-undo .
      674   define variable v-tth as handle no-undo .
      675   assign
      676   v-tth = buffer thbjattr_thbj-attr:table-handle .
      677   DEFINE BUTTON b-cancel AUTO-END-KEY
      678        LABEL "&Отмена"
      679        SIZE 10 BY 1
      680        BGCOLOR 8 .
      681   DEFINE BUTTON b-exit AUTO-GO
      682        LABEL "&Ввод"
      683        SIZE 10 BY 1
      684        BGCOLOR 8 .
      685   DEFINE BUTTON b-help
      686        LABEL "&Помощь"
      687        SIZE 10 BY 1
      688        BGCOLOR 8 .
      689   DEFINE QUERY b-shst FOR
      690         tt-shst SCROLLING.
      691   DEFINE BROWSE b-shst
      692     QUERY b-shst DISPLAY
      693         tt-shst.obj-code        format ">>>>9"
      694   tt-shst.obj-type
      695   tt-shst.obj-name        column-label "Наименование" format "x(30)"
      696   tt-shst.Ostatok-start   column-label "Остаток на !начало дня" format ">>>>>>>>9.99"
      697   tt-shst.plan-pri        column-label "План прихода" format ">>>>>>>>9.99"
      698   tt-shst.proch           column-label "Прочие доходы" format ">>>>>>>>9.99"
      699   tt-shst.proch-ras       column-label "Прочие расходы" format "->>>>>>>>9.99"
      700   enable
      701   tt-shst.Ostatok-start
      702   tt-shst.plan-pri
      703   tt-shst.proch
      704   tt-shst.proch-ras
      705       WITH NO-ROW-MARKERS SEPARATORS SIZE 96.6 BY 12.97.
      706   DEFINE FRAME Dialog-Frame
      707        b-exit AT ROW 1 COL 1.6
      708        b-cancel AT ROW 1 COL 12.1
      709        b-help AT ROW 1 COL 88
      710        b-shst AT ROW 2.3 COL 1.4
      711        SPACE(0.24) SKIP(0.18)
      712       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      713            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      714            TITLE "Плановые цифры по объектам"
      715            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-cancel.
      716   ASSIGN
      717          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      718          FRAME Dialog-Frame:HIDDEN           = TRUE.
      719   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      720   DO:
      721     APPLY "END-ERROR":U TO SELF.
      722   END.
      723   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
      724   DO:
      725   if can-find (first tt-shst  where tt-shst.upd      = true ) then do:
      726     MESSAGE "Данные были изменены!" "Выйти без сохранения ?"  view-as alert-box question
      727     buttons yes-no title "Вопрос"
      728      update v-ok as logical.
      729        if v-ok = false  then do:
      730           return no-apply.
      731        end.
      732   end.
      733   END.
      734   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      735   DO:
      736   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      737   if lookup(b-exit :type in frame Dialog-Frame
      738            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      739            ) = 0
      740   then do:
      741     message
      742       "$Workfile$"
      743       "Указанному интерфейсному элементу фокус не может быть передан" skip
      744       "Интерфейсный элемент" self :name in frame Dialog-Frame skip
      745       "Тип" self :type in frame Dialog-Frame skip
      746       "Процедура" this-procedure :file-name skip
      747       view-as alert-box .
      748   end.
      749   else do:
      750     apply "entry":u to b-exit in frame Dialog-Frame .
      751     if focus :handle <> b-exit :handle in frame Dialog-Frame then do:
      752       return no-apply .
      753     end.
      754   end.
      755     message "Сохраняем изменение и выходим ? " view-as alert-box question
      756      buttons yes-no title "Вопрос"
      757      update v-ok as logical.
      758        if v-ok = false  then do:
      759        return no-apply.
      760        end.
      761     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      762     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      763   END.
      764   ON CHOOSE OF b-help IN FRAME Dialog-Frame
      765   DO:
      766   END.
      767   ON ROW-LEAVE OF b-shst IN FRAME Dialog-Frame
      768   DO:
      769     IF dec( tt-shst.proch-ras:screen-value IN BROWSE b-shst) <> tt-shst.proch-ras
      770     or dec( tt-shst.proch:screen-value IN BROWSE b-shst) <> tt-shst.proch
      771     or dec( tt-shst.ostatok-start:screen-value IN BROWSE b-shst) <> tt-shst.Ostatok-start
      772     or dec( tt-shst.plan-pri:screen-value IN BROWSE b-shst) <> tt-shst.plan-pri
      773     THEN
      774       assign
      775         tt-shst.upd      = true
      776       .
      777     if dec( tt-shst.ostatok-start:screen-value IN BROWSE b-shst) <> tt-shst.Ostatok-start
      778     THEN
      779       assign
      780         tt-shst.upd1      = true
      781       .
      782     if dec( tt-shst.plan-pri:screen-value IN BROWSE b-shst) <> tt-shst.plan-pri
      783     THEN
      784       assign
      785         tt-shst.upd2      = true
      786       .
      787     if dec( tt-shst.proch:screen-value IN BROWSE b-shst) <> tt-shst.proch
      788     THEN
      789       assign
      790         tt-shst.upd3      = true
      791       .
      792     IF dec( tt-shst.proch-ras:screen-value IN BROWSE b-shst) <> tt-shst.proch-ras
      793     THEN
      794       assign
      795         tt-shst.upd4      = true
      796       .
      797   END.
      798   ON LEAVE OF tt-shst.proch-ras in browse b-shst
      799   DO:
      800   define variable sss  as character no-undo .
      801     IF dec(tt-shst.proch-ras:screen-value IN BROWSE b-shst) > 0  THEN do:
      802           MESSAGE "Расход дожен быть < 0 !!! "  .
      803           sss =  string(dec(tt-shst.proch-ras:screen-value IN BROWSE b-shst) * ( - 1 )) .
      804           tt-shst.proch-ras:screen-value IN BROWSE b-shst = sss.
      805           RETURN NO-APPLY.
      806     end.
      807   END.
      808   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      809   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      810   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      811   on help of frame Dialog-Frame
      812   do:
      813     run gbl/app_help.p
      814       (input this-procedure :file-name
      815       ,input ''
      816       ,input ?
      817       ) no-error.
      818     if error-status :error then do:
      819       message
      820         "Ошибка при вызове помощи"
      821         error-status :get-message(1)
      822         view-as alert-box .
      823     end.
      824   end.
      825   run minbtn-set in this-procedure .
      826   on choose of b-help in frame Dialog-Frame
      827   do:
      828     apply "help":u to frame Dialog-Frame .
      829   end.
      830   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      831   procedure minbtn-set :
      832       do
      833           on error undo, return error return-value
      834           :
      835           define variable ii              as integer       no-undo .
      836           define variable fh              as widget-handle no-undo .
      837           define variable hh              as widget-handle no-undo .
      838           define variable v-h             as handle        extent 4 no-undo .
      839           define variable v-name-button   as character     no-undo .
      840           define variable v-help-old-x    as decimal       no-undo .
      841           define variable v-help-old-y    as decimal       no-undo .
      842           define variable v-help-old-size as decimal       no-undo .
      843           define variable v-frame-width   as decimal       no-undo .
      844           define variable jj              as integer       no-undo .
      845           do
      846               on error undo, return error
      847               :
      848               assign
      849                   v-frame-width = frame Dialog-Frame:width - 0.3
      850                   fh            = frame Dialog-Frame:first-child
      851                   hh            = fh:first-child
      852                   ii            = 1
      853                   .
      854               do while valid-handle(hh):
      855                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      856                   do:
      857                       case lc(hh:name) :
      858                           when "b-help" then
      859                               do:
      860                                   hh:load-image-up("cmp/b-help.bmp":u) .
      861                                   hh:load-image-down("cmp/b-help.bmp":u) .
      862                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      863                                   hh:TOOLTIP = "Помощь" .
      864                                   v-help-old-x = hh:column .
      865                                   v-help-old-y = hh:row    .
      866                                   v-help-old-size = hh:width .
      867                                   hh:width-chars = 2.5 .
      868                               end.
      869                           when "b-print" then
      870                               do:
      871                                   hh:load-image("cmp/b-print.bmp":u) .
      872                                   hh:TOOLTIP = "Печать" .
      873                                   v-h[ii] = hh:handle .
      874                                   ii = ii + 1 .
      875                                   hh:width-chars = 3 .
      876                               end.
      877                           when "b-history" or
      878                           when "b-hist" then
      879                               do:
      880                                   hh:load-image("cmp/b-hist.bmp":u) .
      881                                   hh:TOOLTIP = "История" .
      882                                   v-h[ii] = hh:handle .
      883                                   ii = ii + 1 .
      884                                   hh:width-chars = 3 .
      885                               end.
      886                           when "b-sch" then
      887                               do:
      888                                   hh:load-image("cmp/b-sch.bmp":u) .
      889                                   hh:TOOLTIP = "Установка Фильтра" .
      890                                   v-h[ii] = hh:handle .
      891                                   ii = ii + 1 .
      892                                   hh:width-chars = 3 .
      893                               end.
      894                           when "b-hist-user" then
      895                               do:
      896                                   hh:load-image("cmp/b-hist.bmp":u) .
      897                                   hh:TOOLTIP = "История пользователя" .
      898                                   ii = ii + 1 .
      899                               end.
      900                       end case.
      901                   end.
      902                   hh = hh:next-sibling.
      903               end.
      904               b-help:column = v-frame-width - b-help:width-chars.
      905               jj = 0.
      906               repeat ii = 4 to 1 by -1 :
      907                   if valid-handle (v-h[ii] ) then
      908                   do:
      909                       jj  = jj + 1 .
      910                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      911                       v-h[ii]:row    = v-help-old-y .
      912                   end.
      913               end.
      914           end.
      915       end.
      916   end procedure.
      917   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      918   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      919   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      920   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      921   define variable v-diasize-current-frame-width  as decimal   no-undo .
      922   define variable v-diasize-current-frame-height as decimal   no-undo .
      923   define variable v-diasize-change-size          as logical   no-undo .
      924   define variable v-diasize-resize-button        as handle    no-undo .
      925   define variable v-diasize-wndmax               as logical   no-undo .
      926   define variable v-diasize-wndstore             as logical   no-undo .
      927   define variable v-diasize-proc-name            as character no-undo .
      928   define variable v-diasize-browse-handle        as handle    no-undo .
      929   define variable v-diasize-browse-number        as integer   no-undo .
      930   define variable v-diasize-need-full-display    as logical   no-undo init false .
      931   define temp-table temp-diasize-handle no-undo
      932     field handle-value  as handle
      933     field save-position as decimal
      934     index xpk is primary unique handle-value
      935     .
      936   define temp-table temp-browse-handle no-undo
      937     field browse-type   as character
      938     field browse-number as integer
      939     field browse-handle as handle
      940     field original-size as decimal
      941     index xpk is primary unique browse-type browse-number
      942     index xie browse-type browse-handle
      943   .
      944   procedure diasize_change-height :
      945     define input  parameter p-change-value  as decimal   no-undo .
      946     define input  parameter p-move-resize   as logical   no-undo .
      947     define variable v-field-group-handle    as handle    no-undo .
      948     define variable v-object-handle         as handle    no-undo .
      949     define variable v-frame-height          as decimal   no-undo .
      950     define variable v-frame-virtual-height  as decimal   no-undo .
      951     define variable v-browse-height         as decimal   no-undo .
      952     define variable v-window-height         as decimal   no-undo .
      953     define variable v-window-virtual-height as decimal   no-undo .
      954     define variable v-change-sign           as integer   no-undo .
      955     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      956     define buffer buf_temp-browse-handle  for temp-browse-handle .
      957     if p-change-value > 0
      958     then do:
      959       if frame Dialog-Frame :height + p-change-value
      960           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      961       then do:
      962         assign
      963           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      964                           - (frame Dialog-Frame :height-chars)
      965         .
      966         if p-change-value <= 0
      967         then do:
      968           run diasize_position-resize-button in this-procedure .
      969           return .
      970         end.
      971       end.
      972     end.
      973     if p-change-value < 0
      974     then do:
      975       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      976       then do:
      977         assign
      978           p-change-value = v-diasize-orig-frame-height
      979                          - (frame Dialog-Frame :height-chars)
      980         .
      981         if p-change-value >= 0
      982         then do:
      983           run diasize_position-resize-button in this-procedure .
      984           return .
      985         end.
      986       end.
      987     end.
      988     if p-change-value >= 0
      989     then do:
      990       assign
      991         v-change-sign = 1
      992       .
      993     end.
      994     else do:
      995       assign
      996         v-change-sign = -1
      997       .
      998     end.
      999     assign
     1000       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1001     .
     1002     if p-change-value = 0
     1003     then do:
     1004       run diasize_position-resize-button in this-procedure .
     1005       return .
     1006     end.
     1007     move_block:
     1008     do
     1009     on error undo move_block, retry move_block
     1010     :
     1011       if retry
     1012       then do:
     1013         do
     1014         on error undo move_block, leave move_block
     1015         :
     1016           if p-change-value > 0
     1017           then do:
     1018             for each buf_temp-diasize-handle
     1019             on error undo, next
     1020             :
     1021               assign
     1022                 v-object-handle = buf_temp-diasize-handle.handle-value
     1023               .
     1024               if v-object-handle <> v-diasize-resize-button
     1025               then do:
     1026                 assign
     1027                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1028                 .
     1029               end.
     1030             end.
     1031             assign
     1032               v-diasize-browse-handle :height = v-browse-height
     1033             .
