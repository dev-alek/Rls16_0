     1149                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1150               .
     1151             end.
     1152           end.
     1153           assign
     1154             v-object-handle = v-object-handle :next-sibling
     1155           .
     1156         end.
     1157         assign
     1158           v-field-group-handle = v-field-group-handle :next-sibling
     1159         .
