        1   DEFINE BUFFER locked_thbj-attr FOR ub.thbj-attr.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Плановые цифры по объектам для фин.блока ".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   procedure proc-alt-shift-f2:
       63     if not ibs.th.gbl.gbl-var:rcode
       64   then
       65     run gbl\inidebug.p .
       66   end.
       67   procedure proc-alt-shift-f3:
       68     run gbl/prvssinf.p
       69       ( input this-procedure
       70       ) .
       71   end.
       72   define variable v-inform-launched as logical no-undo initial false .
       73   procedure proc-alt-shift-f4:
       74     define variable v-action as character no-undo .
       75     if v-inform-launched = false then do:
       76       assign
       77         v-inform-launched = true
       78       .
       79       run gbl/d-inform.w
       80         (  input self
       81         ,  input this-procedure
       82         , output v-action
       83         ) no-error .
       84       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       85       assign
       86         v-inform-launched = false
       87       .
       88     end.
       89   end.
       90   procedure proc-alt-f1:
       91     run gbl/corrhelp.p
       92       (input this-procedure
       93       ) .
       94   end .
       95   on alt-shift-f2 anywhere do:
       96     run proc-alt-shift-f2.
       97   end.
       98   on alt-shift-f3 anywhere do:
       99     run proc-alt-shift-f3 in this-procedure .
      100   end.
      101   on alt-shift-f4 anywhere do:
      102     run proc-alt-shift-f4 in this-procedure.
      103   end.
      104   on alt-f1 anywhere do:
      105     run proc-alt-f1 in this-procedure .
      106   end.
      107   define new global shared variable g#language as character no-undo .
      108   if g#language <> '' and g#language <> 'rus':U then do:
      109     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      110   end.
      111   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      112   define new global shared variable g#attr-lib  as handle no-undo .
      113   define variable v-attr-lib-variable as handle no-undo .
      114   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      115   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      116   procedure thbjattr_code :
      117      define input  parameter p-upper-code     as character no-undo .
      118      define input  parameter p-code           as character no-undo .
      119      define output parameter p-label          as character no-undo .
      120      define output parameter p-user-can-edit  as logical   no-undo .
      121      define output parameter p-output-display as logical   no-undo .
      122      define output parameter p-other          as character no-undo .
      123      define output parameter p-prop-list      as character no-undo .
      124      define output parameter p-prop-type-list as character no-undo .
      125      define output parameter p-prop-label-list as character no-undo .
      126      define output parameter p-global          as logical no-undo .
      127      define output parameter p-host           as logical no-undo .
      128      define output parameter p-shop           as logical no-undo .
      129      define output parameter p-store          as logical no-undo .
      130      define output parameter p-db             as logical no-undo .
      131      define variable p-region as logical no-undo.
      132      run thbjattr_code_reg in this-procedure (
      133                                               p-upper-code,
      134                                               p-code,
      135                                               output p-label,
      136                                               output p-user-can-edit,
      137                                               output p-output-display,
      138                                               output p-other,
      139                                               output p-prop-list,
      140                                               output p-prop-type-list,
      141                                               output p-prop-label-list,
      142                                               output p-global,
      143                                               output p-host,
      144                                               output p-shop,
      145                                               output p-store,
      146                                               output p-db,
      147                                               output p-region
      148                                               ).
      149   end procedure.
      150   procedure thbjattr_code_reg :
      151   define input  parameter p-upper-code     as character no-undo .
      152   define input  parameter p-code           as character no-undo .
      153   define output parameter p-label          as character no-undo .
      154   define output parameter p-user-can-edit  as logical   no-undo .
      155   define output parameter p-output-display as logical   no-undo .
      156   define output parameter p-other          as character no-undo .
      157   define output parameter p-prop-list      as character no-undo .
      158   define output parameter p-prop-type-list as character no-undo .
      159   define output parameter p-prop-label-list as character no-undo .
      160   define output parameter p-global          as logical no-undo .
      161   define output parameter p-host           as logical no-undo .
      162   define output parameter p-shop           as logical no-undo .
      163   define output parameter p-store          as logical no-undo .
      164   define output parameter p-db             as logical no-undo .
      165   define output parameter p-region         as logical no-undo .
      166   do
      167   on error undo, return error return-value
      168   :
      169       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      170       (input  p-upper-code
      171       ,input  p-code
      172       ,output p-label
      173       ,output p-user-can-edit
      174       ,output p-output-display
      175       ,output p-other
      176       ,output p-prop-list
      177       ,output p-prop-type-list
      178       ,output p-prop-label-list
      179       ,output p-global
      180       ,output p-host
      181       ,output p-shop
      182       ,output p-store
      183       ,output p-db
      184       ,output p-region
      185       ) no-error .
      186     if error-status :error
      187     then do:
      188       undo, return error substitute( "&1. &2&3&4", vss-include-info0, return-value, chr(10), error-status :get-message (1)).
      189     end.
      190   end.
      191   end procedure.
