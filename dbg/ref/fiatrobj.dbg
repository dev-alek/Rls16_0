     1596             undo move_block, retry move_block .
     1597           end.
     1598         end.
     1599         for each buf_temp-diasize-handle
     1600         on error undo move_block, retry move_block
     1601         :
     1602           assign
     1603             v-object-handle = buf_temp-diasize-handle.handle-value
     1604           .
     1605           if v-object-handle <> v-diasize-resize-button
     1606           then do:
     1607             assign
     1608               v-object-handle :col = v-object-handle :col + p-change-value
     1609               no-error .
     1610             if error-status :error
     1611             or error-status :get-message(1) <> ""
     1612             then do:
     1613               undo move_block, retry move_block .
     1614             end.
     1615           end.
     1616         end.
     1617       end.
     1618       else do:
     1619         for each buf_temp-diasize-handle
     1620         on error undo move_block, retry move_block
     1621         :
     1622           assign
     1623             v-object-handle = buf_temp-diasize-handle.handle-value
     1624           .
     1625           if v-object-handle <> v-diasize-resize-button
     1626           then do:
     1627             assign
     1628               v-object-handle :col = v-object-handle :col + p-change-value
     1629               no-error .
     1630             if error-status :error
     1631             or error-status :get-message(1) <> ""
     1632             then do:
     1633               undo move_block, retry move_block .
     1634             end.
     1635           end.
     1636         end.
     1637         for each buf_temp-browse-handle
     1638           where buf_temp-browse-handle.browse-type = 'width':u
     1639         on error undo move_block, retry move_block
     1640         :
     1641           assign
     1642             buf_temp-browse-handle.browse-handle :width
     1643               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1644             no-error .
     1645           if error-status :error
     1646           or error-status :get-message(1) <> ""
     1647           then do:
     1648             undo move_block, retry move_block .
     1649           end.
     1650         end.
     1651         assign
     1652           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1653           no-error .
     1654         if error-status :error
     1655         or error-status :get-message(1) <> ""
     1656         then do:
     1657           undo move_block, retry move_block.
     1658         end.
     1659         assign
     1660           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1661         no-error .
     1662         if error-status :error
     1663         or error-status :get-message(1) <> ""
     1664         then do:
     1665           undo move_block, retry move_block.
     1666         end.
     1667         if frame Dialog-Frame :scrollable = true
     1668         then do:
     1669           assign
     1670             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1671           no-error .
     1672           if error-status :error
     1673           or error-status :get-message(1) <> ""
     1674           then do:
     1675             undo move_block, retry move_block.
     1676           end.
     1677         end.
     1678       end.
     1679       if p-move-resize
     1680       then do:
     1681         run diasize_position-resize-button in this-procedure .
     1682       end.
     1683       if v-diasize-wndstore = true
     1684       then do:
     1685         if connected("ub") = true
     1686         then do:
     1687           define variable v-cntxt-db-num        as integer   no-undo .
     1688           define variable v-cntxt-userid        as character no-undo .
     1689           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1690                                             , OUTPUT v-cntxt-userid
     1691                                             ) .
     1692           run gbl/wndsizew.p
     1693             (input  v-cntxt-db-num
     1694             ,input  v-cntxt-userid
     1695             ,input  v-diasize-proc-name
     1696             ,input  'width':u
     1697             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1698             ) .
     1699         end.
     1700       end.
     1701     end.
     1702     assign
     1703       v-diasize-change-size = false
     1704     .
     1705   end procedure.
     1706   procedure diasize_set-width :
     1707     define input  parameter p-new-width  as decimal   no-undo .
     1708     define input  parameter p-move-resize as logical   no-undo .
     1709     do
     1710     on error undo, return error return-value
     1711     :
     1712       run diasize_change-width in this-procedure
     1713         (input  (p-new-width - frame Dialog-Frame :width)
     1714         ,input  p-move-resize
     1715         ) .
     1716     end.
     1717   end procedure.
     1718   procedure diasize_position-resize-button :
     1719     do with frame Dialog-Frame
     1720     :
     1721       hide v-diasize-resize-button .
     1722       assign
     1723         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1724                     - 1
     1725                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1726         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1727                     - 1
     1728                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1729       .
     1730       view v-diasize-resize-button .
     1731     end.
     1732   end procedure.
     1733   on alt-right anywhere
     1734   do:
     1735     run diasize_change-width in this-procedure
     1736       (input 1
     1737       ,input true
     1738       ) .
     1739     return no-apply .
     1740   end.
     1741   on alt-left anywhere
     1742   do:
     1743     run diasize_change-width in this-procedure
     1744       (input -1
     1745       ,input true
     1746       ) .
     1747     return no-apply .
     1748   end.
     1749   on alt-down anywhere
     1750   do:
     1751     run diasize_change-height in this-procedure
     1752       (input 1
     1753       ,input true
     1754       ) .
     1755     return no-apply .
     1756   end.
     1757   on alt-up anywhere
     1758   do:
     1759     run diasize_change-height in this-procedure
     1760       (input -1
     1761       ,input true
     1762       ) .
     1763     return no-apply .
     1764   end.
     1765   on alt-enter of frame Dialog-Frame
     1766   do:
     1767     run diasize_maximize in this-procedure
     1768       (input  ?
     1769       ).
     1770     return no-apply .
     1771   end.
     1772   procedure diasize_end-move :
     1773     do
     1774     on error undo, return error return-value
     1775     :
     1776       define variable v-row-delta as decimal   no-undo .
     1777       define variable v-col-delta as decimal   no-undo .
     1778       define variable v-new-row as decimal   no-undo .
     1779       define variable v-new-col as decimal   no-undo .
     1780       assign
     1781         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1782         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1783       .
     1784       assign
     1785         v-row-delta = v-new-row - frame Dialog-Frame :height
     1786         v-col-delta = v-new-col - frame Dialog-Frame :width
     1787       .
     1788       run diasize_change-height in this-procedure
     1789         (input v-row-delta
     1790         ,input true
     1791         ) .
     1792       run diasize_change-width in this-procedure
     1793         (input v-col-delta
     1794         ,input true
     1795         ) .
     1796     end.
     1797   end procedure.
     1798   procedure diasize_maximize :
     1799     define input  parameter p-action as logical   no-undo .
     1800     do
     1801     on error undo, return error return-value
     1802     :
     1803       if p-action = ?
     1804       then do:
     1805         if v-diasize-need-maximize = true
     1806         then do:
     1807           assign
     1808             p-action = true
     1809           .
     1810         end.
     1811         else do:
     1812           assign
     1813             p-action = false
     1814           .
     1815         end.
     1816       end.
     1817       if p-action = true
     1818       then do:
     1819         run diasize_change-height in this-procedure
     1820           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1821               - frame Dialog-Frame :height-chars
     1822           ,input true
     1823           ) .
     1824         run diasize_change-width in this-procedure
     1825           (input session :width-chars
     1826               - frame Dialog-Frame :width-chars
     1827           ,input true
     1828           ) .
     1829         assign
     1830           v-diasize-need-maximize = false
     1831         .
     1832       end.
     1833       else do:
     1834         run diasize_change-width in this-procedure
     1835           (input v-diasize-orig-frame-width
     1836               - frame Dialog-Frame :width-chars
     1837           ,input true
     1838           ) .
     1839         run diasize_change-height in this-procedure
     1840           (input v-diasize-orig-frame-height
     1841               - frame Dialog-Frame :height-chars
     1842           ,input true
     1843           ) .
     1844         assign
     1845           v-diasize-need-maximize = true
     1846         .
     1847       end.
     1848     end.
     1849   end procedure.
     1850   procedure diasize_restore-orig-size :
     1851     do
     1852     on error undo, return error return-value
     1853     :
     1854       assign
     1855         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1856         v-diasize-current-frame-height = frame Dialog-Frame :height
     1857       .
     1858       run diasize_set-height in this-procedure
     1859         (input  v-diasize-orig-frame-height
     1860         ,input  true
     1861         ) .
     1862       run diasize_set-width in this-procedure
     1863         (input  v-diasize-orig-frame-width
     1864         ,input  true
     1865         ) .
     1866     end.
     1867   end procedure.
     1868   procedure diasize_restore-current-size :
     1869     do
     1870     on error undo, return error return-value
     1871     :
     1872       run diasize_set-height in this-procedure
     1873         (input  v-diasize-current-frame-height
     1874         ,input  true
     1875         ) .
     1876       run diasize_set-width in this-procedure
     1877         (input  v-diasize-current-frame-width
     1878         ,input  true
     1879         ) .
     1880     end.
     1881   end procedure.
     1882   procedure diasize_set-browse-handle :
     1883     define input  parameter p-browse-handle as handle   no-undo .
     1884     define buffer buf_temp-browse-handle for temp-browse-handle .
     1885     do
     1886     on error undo, return error return-value
     1887     :
     1888       assign
     1889         v-diasize-browse-handle = p-browse-handle
     1890       .
     1891       for each buf_temp-browse-handle
     1892       on error undo, return error return-value
     1893       :
     1894         delete buf_temp-browse-handle .
     1895       end.
     1896     end.
     1897   end procedure.
     1898   procedure diasize_add_browse :
     1899     define input  parameter p-browse-type   as character no-undo .
     1900     define input  parameter p-browse-handle as handle    no-undo .
     1901     define buffer buf_temp-browse-handle for temp-browse-handle .
     1902     do
     1903     on error undo, return error return-value
     1904     :
     1905       assign
     1906         v-diasize-browse-number = v-diasize-browse-number + 1
     1907       .
     1908       create buf_temp-browse-handle .
     1909       assign
     1910         buf_temp-browse-handle.browse-type   = p-browse-type
     1911         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1912         buf_temp-browse-handle.browse-handle = p-browse-handle
     1913       .
     1914     end.
     1915   end procedure.
     1916   procedure diasize_init :
     1917     define variable v-default-value    as logical   no-undo .
     1918     define variable v-restore-saved    as logical   no-undo .
     1919     define variable v-resize-value-str as character no-undo .
     1920     do
     1921     on error undo, return error return-value
     1922     :
     1923       do with frame Dialog-Frame
     1924       :
     1925         assign
     1926           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1927           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1928           v-diasize-browse-handle     = browse b-shst :handle
     1929         .
     1930         create button v-diasize-resize-button
     1931         assign
     1932           parent        = frame Dialog-Frame :first-child
     1933           label         = "s"
     1934           height-pixels = 16
     1935           width-pixels  = 16
     1936           visible       = true
     1937           sensitive     = true
     1938           movable       = true
     1939           triggers:
     1940             on end-move persistent run diasize_end-move in this-procedure .
     1941           end triggers.
     1942         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1943         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1944         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1945         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1946         assign
     1947           v-diasize-wndmax = false
     1948         .
     1949         if connected("ub") = true
     1950         then do:
     1951           define variable v-cntxt-db-num        as integer   no-undo .
     1952           define variable v-cntxt-userid        as character no-undo .
     1953           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1954                                             , OUTPUT v-cntxt-userid
     1955                                             ) .
     1956           run gbl/wndpar_r.p
     1957             (input  v-cntxt-db-num
     1958             ,input  v-cntxt-userid
     1959             ,input  'wndmax':U
     1960             ,output v-diasize-wndmax
     1961             ,output v-default-value
     1962             ) .
     1963         end.
     1964         assign
     1965           v-diasize-wndstore = false
     1966         .
     1967         if connected("ub") = true
     1968         then do:
     1969           run gbl/wndpar_r.p
     1970             (input  v-cntxt-db-num
     1971             ,input  v-cntxt-userid
     1972             ,input  'wndstore':U
     1973             ,output v-diasize-wndstore
     1974             ,output v-default-value
     1975             ) .
     1976         end.
     1977         assign
     1978           v-diasize-proc-name = entry(1, program-name(2), '.')
     1979         .
     1980         if v-diasize-wndstore = true
     1981         then do:
     1982           assign
     1983             v-restore-saved = false
     1984           .
     1985           if connected("ub") = true
     1986           then do:
     1987             run gbl/wndsizer.p
     1988               (input  v-cntxt-db-num
     1989               ,input  v-cntxt-userid
     1990               ,input  v-diasize-proc-name
     1991               ,input  'height':u
     1992               ,output v-resize-value-str
     1993               ) .
     1994             if v-resize-value-str <> '':U
     1995             then do:
     1996               run diasize_change-height in this-procedure
     1997                 (input  integer(v-resize-value-str)
     1998                 ,input  true
     1999                 ) .
     2000               assign
     2001                 v-restore-saved = true
     2002               .
     2003             end.
     2004           end.
     2005           if connected("ub") = true
     2006           then do:
     2007             run gbl/wndsizer.p
     2008               (input  v-cntxt-db-num
     2009               ,input  v-cntxt-userid
     2010               ,input  v-diasize-proc-name
     2011               ,input  'width':u
     2012               ,output v-resize-value-str
     2013               ) .
     2014             if v-resize-value-str <> '':U
     2015             then do:
     2016               run diasize_change-width in this-procedure
     2017                 (input  integer(v-resize-value-str)
     2018                 ,input  true
     2019                 ) .
     2020               assign
     2021                 v-restore-saved = true
     2022               .
     2023             end.
     2024           end.
     2025           if v-restore-saved <> true
     2026           then do:
     2027             if v-diasize-wndmax = true
     2028             then do:
     2029               run diasize_maximize in this-procedure
     2030                 (input  true
     2031                 ) .
     2032             end.
     2033           end.
     2034         end.
     2035         else do:
     2036           if v-diasize-wndmax = true
     2037           then do:
     2038             run diasize_maximize in this-procedure
     2039               (input  true
     2040               ) .
     2041           end.
     2042         end.
     2043       end.
     2044     end.
     2045   end procedure.
     2046   procedure diasize_need-full-display :
     2047     define output parameter p-need-full-display as logical   no-undo .
     2048     do
     2049     on error undo, return error return-value
     2050     :
     2051       assign
     2052         p-need-full-display = v-diasize-need-full-display
     2053       .
     2054       assign
     2055         v-diasize-need-full-display = false
     2056       .
     2057     end.
     2058   end procedure.
     2059   procedure get-context :
     2060      define output parameter p-db-num as integer          no-undo.
     2061      define output parameter p-user-id as character        no-undo.
     2062      define variable v-login               as character    no-undo.
     2063      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2064      define buffer buf_user-login  for ub.user-login .
     2065      do
     2066      on error undo, return error
     2067      :
     2068            FIND FIRST buf_sys-ctrl no-lock.
     2069            ASSIGN
     2070               v-login = USERID("ub")
     2071               p-db-num = buf_sys-ctrl.db-num
     2072            .
     2073            FIND FIRST buf_user-login
     2074                 WHERE buf_user-login.db-num = p-db-num
     2075                   AND buf_user-login.user-login = v-login
     2076                 no-lock
     2077                 no-error
     2078                 .
     2079            IF AVAILABLE buf_user-login
     2080            THEN DO:
     2081               assign
     2082                  p-user-id = buf_user-login.user-id
     2083               .
     2084            END.
     2085      end.
     2086   end procedure.
     2087       run diasize_init in this-procedure .
     2088   MAIN-BLOCK:
     2089   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2090      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2091     DO TRANSACTION:
     2092       RUN lock-fin-plan IN THIS-PROCEDURE.
     2093     END.
     2094     run load-tt in this-procedure.
     2095     run enable_UI in this-procedure.
     2096     find first bf_tt-shst where bf_tt-shst.obj-type = pardefobj-type and
     2097                                 bf_tt-shst.obj-code = pardefobj-code no-error.
     2098     if available bf_tt-shst then do:
     2099       reposition b-shst to recid recid(bf_tt-shst) no-error .
     2100     end.
     2101     WAIT-FOR GO OF FRAME Dialog-Frame.
     2102   END.
     2103   run disable_UI in this-procedure.
     2104   PROCEDURE disable_UI :
     2105     HIDE FRAME Dialog-Frame.
     2106   END PROCEDURE.
     2107   PROCEDURE enable_UI :
     2108     ENABLE b-exit b-cancel b-help b-shst
     2109         WITH FRAME Dialog-Frame.
     2110     VIEW FRAME Dialog-Frame.
     2111     OPEN QUERY b-shst FOR EACH tt-shst indexed-reposition.
     2112   END PROCEDURE.
     2113   PROCEDURE fin-plan-attr-proc :
     2114   do
     2115    on error undo, return error substitute("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2116    :
     2117   define input parameter p-obj-type as character no-undo .
     2118   define input parameter p-obj-code as integer no-undo .
     2119   define variable v-type as character no-undo .
     2120   define variable v-param-type as character no-undo .
     2121   define variable v-value-character as character no-undo .
     2122   define variable v-value-date as date no-undo .
     2123   define variable v-value-decimal as decimal no-undo .
     2124   define variable v-value-integer as INTEGER no-undo .
     2125   define variable v-value-logical AS LOGICAL no-undo .
     2126   run adm/shattri.p (
     2127                 input "init":U
     2128               , input tt-shst.obj-type
     2129               , input tt-shst.obj-code
     2130               , input 'fin-plan':U
     2131               , input "":U
     2132               , output v-value-character
     2133               , output v-value-date
     2134               , output v-value-decimal
     2135               , output v-value-integer
     2136               , output v-value-logical
     2137               , output v-param-type
     2138               , INPUT-OUTPUT table-handle v-tth
     2139               ) no-error .
     2140   if error-status:error
     2141   then do:
     2142     message
     2143     "Не удалось получить начальные значения настроек" skip
     2144     error-status:get-message(1) return-value
     2145     view-as alert-box error .
     2146     undo, return error .
     2147   end.
     2148   FOR EACH thbjattr_thbj-attr WHERE
     2149           thbjattr_thbj-ATTR.obj-type = tt-shst.obj-type
     2150       AND thbjattr_thbj-ATTR.obj-code = tt-shst.obj-code:
     2151     CASE thbjattr_thbj-attr.prop-code :
     2152       WHEN 'fin-ostatok-start':U THEN DO:
     2153         tt-shst.ostatok-start = thbjattr_thbj-attr.property-value-decimal.
     2154       END.
     2155       WHEN 'fin-plan-pri':U  THEN DO:
     2156         tt-shst.plan-pri = thbjattr_thbj-attr.property-value-decimal.
     2157       END.
     2158       WHEN 'fin-proch':U  THEN DO:
     2159         tt-shst.proch = thbjattr_thbj-attr.property-value-decimal.
     2160       END.
     2161       WHEN 'fin-proch-ras':U  THEN DO:
     2162         tt-shst.proch-ras = thbjattr_thbj-attr.property-value-decimal.
     2163       END.
     2164     END CASE.
     2165   END.
     2166   end.
     2167   END PROCEDURE.
     2168   PROCEDURE load-tt :
     2169   DEFINE BUFFER buf_clients FOR ub.clients.
     2170   DEFINE BUFFER buf_shop FOR ub.shop.
     2171   DEFINE BUFFER buf_store FOR ub.store.
     2172   run waitfram-show in this-procedure ( "Ждите..." ).
     2173   if parhost-code = ? then do:
     2174    for each buf_shop no-lock,
     2175      first buf_clients where buf_clients.obj-type = 'маг':U       and
     2176                          buf_clients.obj-code = buf_shop.obj-code and
     2177                          buf_clients.stts     = 0
     2178                          no-lock on error undo, return error return-value :
     2179      create tt-shst.
     2180      assign
     2181        tt-shst.upd      = false
     2182        tt-shst.obj-type = 'маг':U
     2183        tt-shst.obj-code =  buf_shop.obj-code
     2184        tt-shst.obj-name =  buf_clients.obj-name.
     2185        run fin-plan-attr-proc in this-procedure
     2186           ( tt-shst.obj-type ,
     2187             tt-shst.obj-code ).
     2188    end.
     2189    for each buf_store no-lock,
     2190      first buf_clients where buf_clients.obj-type = 'скл':U       and
     2191                          buf_clients.obj-code = buf_store.obj-code and
     2192                          buf_clients.stts     = 0              no-lock on error undo, return error return-value :
     2193      create tt-shst.
     2194      assign
     2195        tt-shst.upd      = false
     2196        tt-shst.obj-type = 'скл':U
     2197        tt-shst.obj-code =  buf_store.obj-code
     2198        tt-shst.obj-name = buf_clients.obj-name.
     2199        run fin-plan-attr-proc in this-procedure
     2200           ( tt-shst.obj-type ,
     2201             tt-shst.obj-code ).
     2202    end.
     2203   end.
     2204   else do:
     2205    for each buf_shop where buf_shop.host-code = parhost-code no-lock,
     2206      first buf_clients where buf_clients.obj-type = 'маг':U       and
     2207                          buf_clients.obj-code = buf_shop.obj-code and
     2208                          buf_clients.stts     = 0             no-lock on error undo, return error return-value :
     2209      create tt-shst.
     2210      assign
     2211        tt-shst.upd      = false
     2212        tt-shst.obj-type = 'маг':U
     2213        tt-shst.obj-code =  buf_shop.obj-code
     2214        tt-shst.obj-name = buf_clients.obj-name.
     2215        run fin-plan-attr-proc in this-procedure
     2216           ( tt-shst.obj-type ,
     2217             tt-shst.obj-code ).
     2218    end.
     2219    for each buf_store where buf_store.host-code = parhost-code no-lock,
     2220      first buf_clients where buf_clients.obj-type = 'скл':U       and
     2221                          buf_clients.obj-code = buf_store.obj-code and
     2222                          buf_clients.stts     = 0              no-lock on error undo, return error return-value :
     2223      create tt-shst.
     2224      assign
     2225        tt-shst.upd      = false
     2226        tt-shst.obj-type = 'скл':U
     2227        tt-shst.obj-code = buf_store.obj-code
     2228        tt-shst.obj-name = buf_clients.obj-name.
     2229        run fin-plan-attr-proc in this-procedure
     2230           ( tt-shst.obj-type ,
     2231             tt-shst.obj-code ).
     2232    end.
     2233   end.
     2234   run waitfram-hide in this-procedure .
     2235   END PROCEDURE.
     2236   PROCEDURE lock-fin-plan :
     2237   DEFINE BUFFER buf_CLIENTS FOR UB.CLIENTS.
     2238   define buffer buf_thbj-attr for ub.thbj-attr.
     2239   IF pARhost-code = ? THEN DO:
     2240     FOR EACH buf_thbj-attr EXCLUSIVE-LOCK WHERE
     2241             buf_thbj-attr.upper-prop-code = 'fin-plan':U
     2242     ON error undo, RETURN error:
     2243       find current locked_thbj-attr exclusive-lock .
     2244       release locked_thbj-attr .
     2245     END.
     2246   END.
     2247   ELSE DO:
     2248     FOR EACH buf_thbj-attr exclusive-lock WHERE
     2249               buf_thbj-attr.upper-prop-code = 'fin-plan':U,
     2250         FIRST buf_clients NO-LOCK WHERE
     2251               buf_clients.obj-type = locked_thbj-attr.obj-type
     2252           AND buf_clients.obj-code = locked_thbj-attr.obj-code
     2253           AND buf_clients.host-code = pARhost-code
     2254     ON error undo, RETURN error:
     2255       find current locked_thbj-attr exclusive-lock .
     2256       release locked_thbj-attr .
     2257     END.
     2258   END.
     2259   END PROCEDURE.
     2260   PROCEDURE proc-save :
     2261   run waitfram-show in this-procedure ( INPUT "Ждите. Идет сохранение данных ").
     2262     for each tt-shst  where tt-shst.upd      = true
     2263      :
     2264      if tt-shst.upd1      = true THEN DO:
     2265        find FIRST thbjattr_thbj-attr WHERE
     2266                   thbjattr_thbj-attr.obj-type = tt-shst.obj-type
     2267            AND    thbjattr_thbj-attr.obj-code = tt-shst.obj-code
     2268            AND    thbjattr_thbj-attr.upper-prop-code = 'fin-plan':U
     2269            AND    thbjattr_thbj-attr.prop-code = 'fin-ostatok-start':U.
     2270        ASSIGN
     2271        thbjattr_thbj-attr.property-value-decimal = tt-shst.ostatok-start.
     2272      END.
     2273      if tt-shst.upd2      = true THEN DO:
     2274          find FIRST thbjattr_thbj-attr WHERE
     2275                     thbjattr_thbj-attr.obj-type = tt-shst.obj-type
     2276              AND    thbjattr_thbj-attr.obj-code = tt-shst.obj-code
     2277              AND    thbjattr_thbj-attr.upper-prop-code = 'fin-plan':U
     2278              AND    thbjattr_thbj-attr.prop-code = 'fin-plan-pri':U.
     2279          ASSIGN
     2280          thbjattr_thbj-attr.property-value-decimal = tt-shst.plan-pri.
     2281      END.
     2282      if tt-shst.upd3      = true THEN DO:
     2283          find FIRST thbjattr_thbj-attr WHERE
     2284                     thbjattr_thbj-attr.obj-type = tt-shst.obj-type
     2285              AND    thbjattr_thbj-attr.obj-code = tt-shst.obj-code
     2286              AND    thbjattr_thbj-attr.upper-prop-code = 'fin-plan':U
     2287              AND    thbjattr_thbj-attr.prop-code = 'fin-proch':U.
     2288          ASSIGN
     2289          thbjattr_thbj-attr.property-value-decimal = tt-shst.proch.
     2290      END.
     2291      if tt-shst.upd4      = true THEN DO:
     2292          find FIRST thbjattr_thbj-attr WHERE
     2293                     thbjattr_thbj-attr.obj-type = tt-shst.obj-type
     2294              AND    thbjattr_thbj-attr.obj-code = tt-shst.obj-code
     2295              AND    thbjattr_thbj-attr.upper-prop-code = 'fin-plan':U
     2296              AND    thbjattr_thbj-attr.prop-code = 'fin-proch-ras':U.
     2297          ASSIGN
     2298          thbjattr_thbj-attr.property-value-decimal = tt-shst.proch-ras.
     2299      END.
     2300      RUN thbjattr_set-section IN this-procedure ( INPUT tt-shst.obj-type
     2301                                                  ,INPUT tt-shst.obj-code
     2302                                                  ,INPUT 'fin-plan':U
     2303                                                  ,INPUT TABLE-HANDLE v-tth ).
     2304   end.
     2305   run waitfram-hide in this-procedure.
     2306   END PROCEDURE.
