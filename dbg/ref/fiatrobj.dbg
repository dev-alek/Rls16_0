     1165           v-diasize-resize-button :row    = 1
     1166           v-diasize-resize-button :column = 1
     1167         .
     1168       end.
     1169       if p-change-value > 0
     1170       then do:
     1171         if frame Dialog-Frame :scrollable = true
     1172         then do:
     1173           assign
     1174             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1175             no-error .
     1176           if error-status :error
     1177           or error-status :get-message(1) <> ""
     1178           then do:
     1179             undo move_block, retry move_block .
     1180           end.
     1181         end.
     1182         assign
     1183           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1184           no-error .
     1185         if error-status :error
     1186         or error-status :get-message(1) <> ""
     1187         then do:
