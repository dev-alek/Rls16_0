     1317     .
     1318   end procedure.
     1319   procedure diasize_set-height :
     1320     define input  parameter p-new-height  as decimal   no-undo .
     1321     define input  parameter p-move-resize as logical   no-undo .
     1322     do
     1323     on error undo, return error return-value
     1324     :
     1325       run diasize_change-height in this-procedure
     1326         (input  (p-new-height - frame Dialog-Frame :height)
     1327         ,input  p-move-resize
     1328         ) .
     1329     end.
     1330   end procedure.
     1331   procedure diasize_change-width :
     1332     define input  parameter p-change-value as decimal   no-undo .
     1333     define input  parameter p-move-resize  as logical   no-undo .
     1334     define variable v-field-group-handle   as handle    no-undo .
     1335     define variable v-object-handle        as handle    no-undo .
     1336     define variable v-frame-width          as decimal   no-undo .
     1337     define variable v-frame-virtual-width  as decimal   no-undo .
     1338     define variable v-browse-width         as decimal   no-undo .
     1339     define variable v-window-width         as decimal   no-undo .
     1340     define variable v-window-virtual-width as decimal   no-undo .
     1341     define variable v-change-sign          as integer   no-undo .
     1342     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1343     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1344     if p-change-value > 0
     1345     then do:
     1346       if frame Dialog-Frame :width + p-change-value >
     1347           session :width-chars
     1348       then do:
     1349         assign
     1350           p-change-value = session :width-chars - frame Dialog-Frame :width
     1351         .
     1352         if p-change-value <= 0
     1353         then do:
     1354           run diasize_position-resize-button in this-procedure .
     1355           return .
     1356         end.
     1357       end.
     1358     end.
     1359     if p-change-value < 0
     1360     then do:
     1361       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1362       then do:
     1363         assign
     1364           p-change-value = v-diasize-orig-frame-width
     1365                          - frame Dialog-Frame :width
     1366         .
     1367         if p-change-value >= 0
     1368         then do:
     1369           run diasize_position-resize-button in this-procedure .
     1370           return .
     1371         end.
     1372       end.
     1373     end.
     1374     if p-change-value >= 0
     1375     then do:
     1376       assign
     1377         v-change-sign = 1
     1378       .
     1379     end.
     1380     else do:
     1381       assign
     1382         v-change-sign = -1
     1383       .
     1384     end.
     1385     assign
     1386       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1387     .
     1388     if p-change-value = 0
     1389     then do:
     1390       run diasize_position-resize-button in this-procedure .
     1391       return .
     1392     end.
     1393     move_block:
