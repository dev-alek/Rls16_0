     1567           end.
     1568         end.
     1569         assign
     1570           frame Dialog-Frame :width = v-frame-width + p-change-value
     1571           no-error .
     1572         if error-status :error
     1573         or error-status :get-message(1) <> ""
     1574         then do:
     1575           undo move_block, retry move_block.
     1576         end.
     1577         assign
     1578           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1579         no-error .
