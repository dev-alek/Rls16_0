     1532             then do:
     1533             end.
     1534             else do:
     1535               create buf_temp-diasize-handle .
     1536               assign
     1537                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1538                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1539               .
     1540             end.
     1541           end.
     1542           assign
     1543             v-object-handle = v-object-handle :next-sibling
     1544           .
     1545         end.
     1546         assign
