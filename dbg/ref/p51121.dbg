      891     on error undo, return error
      892     :
      893           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run isExemplarGoods in g#attr-lib
      894         (input  p-obj-type
      895         ,input  p-obj-code
      896         ,input p-gds-code
      897         ,output o-result
      898         ) no-error .
      899       if error-status :error
      900       then do:
      901         undo, return error return-value .
      902       end.
      903     end.
      904   end procedure.
      905   procedure isVolumArticGoods :
      906     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
      907     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
      908     define input  parameter p-gds-code as   integer                    no-undo .
      909     define output parameter o-result   as   logical                    no-undo.
      910     do
      911     on error undo, return error
      912     :
      913           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run isVolumArticGoods in g#attr-lib
      914         (input  p-obj-type
      915         ,input  p-obj-code
      916         ,input p-gds-code
      917         ,output o-result
      918         ) no-error .
      919       if error-status :error
      920       then do:
      921         undo, return error return-value .
      922       end.
      923     end.
      924   end procedure.
      925   define variable rid-tnved as recid no-undo.
      926   define variable custvalue      as char initial ? no-undo.
      927   define variable custtype       as char initial ? no-undo.
      928   define variable alcvalue      as char initial ? no-undo.
      929   define variable alctype       as char initial ? no-undo.
      930   DEFINE VARIABLE old-frame-height AS DECIMAL NO-UNDO.
      931   DEFINE VARIABLE old-rect-height AS DECIMAL NO-UNDO.
      932   DEFINE VARIABLE v-expand AS logical NO-UNDO.
      933   DEFINE VARIABLE v-downed AS character NO-UNDO.
      934   DEFINE VARIABLE sh AS WIDGET-HANDLE NO-UNDO EXTENT 15.
      935   DEFINE VARIABLE v-question-mode AS LOGICAL NO-UNDO.
      936   DEFINE VARIABLE v-start-scales-type AS CHARACTER NO-UNDO.
      937   define variable v-tab-order as character no-undo .
      938   DEFINE BUFFER buf_units FOR ub.units.
      939   DEFINE BUTTON b-exit AUTO-GO
      940        LABEL "Ввод":L
      941        SIZE 10 BY 1
      942        BGCOLOR 8 .
      943   DEFINE BUTTON b-help
      944        LABEL "&Помощь":L
      945        SIZE 3 BY 1
      946        BGCOLOR 8 .
      947   DEFINE BUTTON b-quit AUTO-END-KEY
      948        LABEL "&Отмена":L
      949        SIZE 10 BY 1
      950        BGCOLOR 8 .
      951   DEFINE BUTTON r-choose-alc-prod
      952        IMAGE-UP FILE "btn-down-arrow":U
      953        IMAGE-DOWN FILE "btn-down-arrow":U
      954        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      955        LABEL ""
      956        SIZE 3 BY .83.
      957   DEFINE BUTTON r-cnd-keep
      958        IMAGE-UP FILE "btn-down-arrow":U
      959        IMAGE-DOWN FILE "btn-down-arrow":U
      960        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      961        LABEL ""
      962        SIZE 3 BY .83.
      963   DEFINE BUTTON r-cst
      964        IMAGE-UP FILE "btn-down-arrow":U
      965        IMAGE-DOWN FILE "btn-down-arrow":U
      966        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      967        LABEL "r-cst"
      968        SIZE 3 BY .83.
      969   DEFINE BUTTON r-tnved
      970        IMAGE-UP FILE "btn-down-arrow":U
      971        IMAGE-DOWN FILE "btn-down-arrow":U
      972        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      973        LABEL "r-tnved"
      974        SIZE 3 BY .83.
      975   DEFINE VARIABLE NATIONALITY AS CHARACTER FORMAT "X(20)":U
      976        LABEL "Статус товара (национальность)"
      977        VIEW-AS COMBO-BOX INNER-LINES 2
      978        LIST-ITEMS "Российский","Иностранный"
      979        DROP-DOWN-LIST
      980        SIZE 37.25 BY 1
      981        BGCOLOR 15 FGCOLOR 0  NO-UNDO.
      982   DEFINE VARIABLE Struct AS CHARACTER
      983        VIEW-AS EDITOR MAX-CHARS 1000 SCROLLBAR-VERTICAL
      984        SIZE 85 BY 3.46 NO-UNDO.
      985   DEFINE VARIABLE Attrib AS CHARACTER FORMAT "X(100)":U
      986        LABEL "Характеристики"
      987        VIEW-AS FILL-IN
      988        SIZE 55 BY 1
      989        BGCOLOR 15 FGCOLOR 0  NO-UNDO.
      990   DEFINE VARIABLE choose-alc-prod AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      991        LABEL "Выбор вида алкогольной продукции"
      992        VIEW-AS FILL-IN
      993        SIZE 10 BY .79
      994        BGCOLOR 15 FGCOLOR 0  NO-UNDO.
      995   DEFINE VARIABLE choose-alc-prod-name AS CHARACTER FORMAT "X(256)":U
      996         VIEW-AS TEXT
      997        SIZE 44.5 BY .67 NO-UNDO.
      998   DEFINE VARIABLE cond-keep-code AS INTEGER FORMAT ">>9":U INITIAL 0
      999        LABEL "Код усл. хран."
     1000        VIEW-AS FILL-IN
     1001        SIZE 5 BY 1
     1002        BGCOLOR 15  NO-UNDO.
     1003   DEFINE VARIABLE cond-keep-name AS CHARACTER FORMAT "X(256)":U
     1004         VIEW-AS TEXT
     1005        SIZE 44.5 BY .67 NO-UNDO.
     1006   DEFINE VARIABLE CST-BASE-RATE AS DECIMAL FORMAT ">>,>>9.9999999999":U INITIAL 0
     1007        LABEL "Коэффициент"
     1008        VIEW-AS FILL-IN
     1009        SIZE 13.75 BY 1
     1010        BGCOLOR 15 FGCOLOR 0  NO-UNDO.
     1011   DEFINE VARIABLE DeadLine AS INTEGER FORMAT ">>>>>>>9":U INITIAL 0
     1012        LABEL "Срок хранения"
     1013        VIEW-AS FILL-IN
     1014        SIZE 9.75 BY .92
     1015        BGCOLOR 12 FGCOLOR 0  NO-UNDO.
     1016   DEFINE VARIABLE Destin AS CHARACTER FORMAT "X(100)":U
     1017        LABEL "Назначение"
     1018        VIEW-AS FILL-IN
     1019        SIZE 57.63 BY 1
     1020        BGCOLOR 15 FGCOLOR 0  NO-UNDO.
     1021   DEFINE VARIABLE G-Name AS CHARACTER FORMAT "X(100)":U
     1022        LABEL "Название товара"
     1023        VIEW-AS FILL-IN
     1024        SIZE 53 BY 1
     1025        BGCOLOR 8 FGCOLOR 4  NO-UNDO.
     1026   DEFINE VARIABLE g-unit-base AS CHARACTER FORMAT "X(3)":U
     1027        LABEL "Учет.ед.изм"
     1028        VIEW-AS FILL-IN
     1029        SIZE 4.75 BY 1
     1030        BGCOLOR 8 FGCOLOR 4  NO-UNDO.
     1031   DEFINE VARIABLE l-struct AS CHARACTER FORMAT "X(256)":U INITIAL "Состав"
     1032         VIEW-AS TEXT
     1033        SIZE 10 BY .67 NO-UNDO.
     1034   DEFINE VARIABLE normal-wastage AS DECIMAL FORMAT "->9.99%":U INITIAL 0
     1035        LABEL "Норма ест. убыли"
     1036        VIEW-AS FILL-IN
     1037        SIZE 7.88 BY 1 NO-UNDO.
     1038   DEFINE VARIABLE normal-waste AS DECIMAL FORMAT "->9.99%":U INITIAL 0
     1039        LABEL "Норма отходов"
     1040        VIEW-AS FILL-IN
     1041        SIZE 7.88 BY 1 NO-UNDO.
     1042   DEFINE VARIABLE P-Address AS CHARACTER FORMAT "X(100)":U
     1043        LABEL "Адрес произв-ля"
     1044        VIEW-AS FILL-IN
     1045        SIZE 53 BY 1
     1046        BGCOLOR 8 FGCOLOR 4  NO-UNDO.
     1047   DEFINE VARIABLE P-Name AS CHARACTER FORMAT "X(100)":U
     1048        LABEL "Прозводитель"
     1049        VIEW-AS FILL-IN
     1050        SIZE 53 BY 1
     1051        BGCOLOR 8 FGCOLOR 4  NO-UNDO.
     1052   DEFINE VARIABLE proof AS DECIMAL FORMAT ">9.99%":U INITIAL 0
     1053        LABEL "Алкоголь"
     1054        VIEW-AS FILL-IN
     1055        SIZE 7.5 BY 1
     1056        BGCOLOR 15 FGCOLOR 0  NO-UNDO.
     1057   DEFINE VARIABLE Sert AS CHARACTER FORMAT "X(100)":U
     1058        LABEL "Сертификат"
     1059        VIEW-AS FILL-IN
     1060        SIZE 56.5 BY 1
     1061        BGCOLOR 15 FGCOLOR 0  NO-UNDO.
     1062   DEFINE VARIABLE Sort AS CHARACTER FORMAT "X(30)":U
     1063        LABEL "Сорт/проба"
     1064        VIEW-AS FILL-IN
     1065        SIZE 10.25 BY 1
     1066        BGCOLOR 15 FGCOLOR 0  NO-UNDO.
     1067   DEFINE VARIABLE struct-length AS INTEGER FORMAT ">,>>9":U INITIAL 0
     1068        LABEL "Символов"
     1069         VIEW-AS TEXT
     1070        SIZE 6.5 BY .67
     1071        FGCOLOR 12  NO-UNDO.
     1072   DEFINE VARIABLE TNVED AS CHARACTER FORMAT "x(10)"
     1073        LABEL "Код ТНВЭД"
     1074        VIEW-AS FILL-IN
     1075        SIZE 11.88 BY 1
     1076        BGCOLOR 15 FGCOLOR 0  NO-UNDO.
     1077   DEFINE VARIABLE tnved-name AS CHARACTER FORMAT "X(256)":U
     1078        VIEW-AS FILL-IN
     1079        SIZE 42.63 BY 1 NO-UNDO.
     1080   DEFINE VARIABLE UNIT-CST AS CHARACTER FORMAT "X(3)":U
     1081        LABEL "Тамож.ед.изм"
     1082        VIEW-AS FILL-IN
     1083        SIZE 6.25 BY 1
     1084        BGCOLOR 15 FGCOLOR 0  NO-UNDO.
     1085   DEFINE VARIABLE UserRule AS CHARACTER FORMAT "X(100)":U
     1086        LABEL "Правила экпл-ции"
     1087        VIEW-AS FILL-IN
     1088        SIZE 53.25 BY 1
     1089        BGCOLOR 15 FGCOLOR 0  NO-UNDO.
     1090   DEFINE RECTANGLE RECT-10
     1091        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
     1092        SIZE 97.5 BY 3.5
     1093        BGCOLOR 8 FGCOLOR 0 .
     1094   DEFINE RECTANGLE RECT-11
     1095        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
     1096        SIZE 97.5 BY 4.83
     1097        BGCOLOR 0 FGCOLOR 0 .
     1098   DEFINE RECTANGLE RECT-12
     1099        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
     1100        SIZE 97.5 BY 4.17.
     1101   DEFINE RECTANGLE RECT-9
     1102        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
     1103        SIZE 97.5 BY 12.46
     1104        BGCOLOR 0 FGCOLOR 0 .
     1105   DEFINE VARIABLE is-alc AS LOGICAL INITIAL no
     1106        LABEL "Алкогольная продукция"
     1107        VIEW-AS TOGGLE-BOX
     1108        SIZE 36 BY .83 NO-UNDO.
     1109   DEFINE VARIABLE is-alc-mark AS LOGICAL INITIAL no
     1110        LABEL "требует маркировки"
     1111        VIEW-AS TOGGLE-BOX
     1112        SIZE 36 BY .83 NO-UNDO.
     1113   DEFINE FRAME DLGOKCAN
     1114        b-exit AT ROW 1 COL 1
     1115        b-quit AT ROW 1 COL 11
     1116        b-help AT ROW 1 COL 95
     1117        G-Name AT ROW 2.46 COL 20 COLON-ALIGNED
     1118        P-Name AT ROW 3.5 COL 20 COLON-ALIGNED
     1119        P-Address AT ROW 4.5 COL 20 COLON-ALIGNED
     1120        TNVED AT ROW 6.5 COL 14.5 COLON-ALIGNED
     1121        tnved-name AT ROW 6.54 COL 31.75 COLON-ALIGNED NO-LABEL
     1122        r-tnved AT ROW 6.63 COL 28.63
     1123        UNIT-CST AT ROW 7.92 COL 17.25 COLON-ALIGNED
     1124        CST-BASE-RATE AT ROW 7.96 COL 42.88 COLON-ALIGNED
     1125        g-unit-base AT ROW 7.96 COL 70.38 COLON-ALIGNED
     1126        r-cst AT ROW 8.04 COL 28.63
     1127        NATIONALITY AT ROW 9.5 COL 36.5 COLON-ALIGNED
     1128        Destin AT ROW 11.42 COL 15.38 COLON-ALIGNED
     1129        Attrib AT ROW 12.67 COL 18 COLON-ALIGNED
     1130        UserRule AT ROW 13.92 COL 19.75 COLON-ALIGNED
     1131        Sert AT ROW 15.17 COL 16.5 COLON-ALIGNED
     1132        Struct AT ROW 16.46 COL 13 NO-LABEL WIDGET-ID 2
     1133        DeadLine AT ROW 19.92 COL 39 COLON-ALIGNED
     1134        Sort AT ROW 19.92 COL 63.38 COLON-ALIGNED
     1135        normal-wastage AT ROW 21.13 COL 22.88 COLON-ALIGNED
     1136        normal-waste AT ROW 21.13 COL 50.13 COLON-ALIGNED
     1137        cond-keep-code AT ROW 22.25 COL 19 COLON-ALIGNED
     1138        r-cnd-keep AT ROW 22.25 COL 27
     1139        proof AT ROW 24.71 COL 87.5 COLON-ALIGNED WIDGET-ID 6
     1140        is-alc AT ROW 24.83 COL 6 WIDGET-ID 12
     1141        is-alc-mark AT ROW 24.83 COL 42.5 WIDGET-ID 16
     1142        r-choose-alc-prod AT ROW 26.08 COL 46.38
     1143        choose-alc-prod AT ROW 26.17 COL 34 COLON-ALIGNED
     1144        struct-length AT ROW 15.42 COL 90 COLON-ALIGNED WIDGET-ID 8
     1145        l-struct AT ROW 16.5 COL 2.5 NO-LABEL WIDGET-ID 4
     1146        cond-keep-name AT ROW 22.25 COL 30 COLON-ALIGNED NO-LABEL
     1147        choose-alc-prod-name AT ROW 26.25 COL 49 COLON-ALIGNED NO-LABEL WIDGET-ID 14
     1148        "(Комплектность)" VIEW-AS TEXT
     1149             SIZE 11 BY 1 AT ROW 17.5 COL 2
     1150             FONT 4
     1151        "Атрибуты алкогольной продукции" VIEW-AS TEXT
     1152             SIZE 30.75 BY .71 AT ROW 23.54 COL 27 WIDGET-ID 12
     1153        "Таможенные характеристики" VIEW-AS TEXT
     1154             SIZE 25.75 BY .71 AT ROW 5.79 COL 27
     1155             BGCOLOR 3 FGCOLOR 14
     1156        "Таможенные характеристики" VIEW-AS TEXT
     1157             SIZE 25.75 BY .71 AT ROW 5.79 COL 27 WIDGET-ID 12
     1158             BGCOLOR 3 FGCOLOR 14
     1159        RECT-10 AT ROW 2.21 COL 1.5
     1160        RECT-11 AT ROW 6 COL 1.5
     1161        RECT-9 AT ROW 11 COL 1.5
     1162        RECT-12 AT ROW 23.83 COL 1.5 WIDGET-ID 10
     1163        SPACE(0.12) SKIP(0.99)
     1164       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1165            SIDE-LABELS THREE-D  SCROLLABLE
     1166            BGCOLOR 8 FGCOLOR 0
     1167            TITLE BGCOLOR 8 FGCOLOR 1 "Доп.инфо по карточке товара":L
     1168            DEFAULT-BUTTON b-exit CANCEL-BUTTON b-quit.
     1169   ASSIGN
     1170          FRAME DLGOKCAN:SCROLLABLE       = FALSE.
     1171   ASSIGN
     1172          proof:HIDDEN IN FRAME DLGOKCAN           = TRUE.
     1173   ASSIGN
     1174          Struct:RETURN-INSERTED IN FRAME DLGOKCAN  = TRUE.
     1175   ON CHOOSE OF b-exit IN FRAME DLGOKCAN
     1176   DO:
     1177   define variable loc#log as log no-undo .
     1178       if mode <> 'ПРОСМОТР':U THEN do:
     1179     ASSIGN
     1180     Struct_ = Struct:screen-value
     1181     .
     1182     if is-alc = true and (choose-alc-prod-name = ? or choose-alc-prod-name = "") then do:
     1183        message
     1184        "Не выбран вид алкогольной продукции"
     1185        VIEW-AS ALERT-BOX .
     1186        RETURN NO-APPLY.
     1187     end.
     1188   assign
     1189   Destin    Attrib    UserRule    Sert           DeadLine    Sort    Proof
     1190   TNVED UNIT-CST CST-BASE-RATE NATIONALITY normal-wastage normal-waste cond-keep-code.
     1191     if is-alc = true and proof = 0 then do:
     1192        message
     1193        "Не указан % содержания алкоголя"
     1194        VIEW-AS ALERT-BOX .
     1195        RETURN NO-APPLY.
     1196     end.
     1197   assign
     1198     destin_ = Destin
     1199     attrib_ = Attrib
     1200     user-rule_ = UserRule
     1201     sert_ = Sert
     1202     deadline_ = DeadLine
     1203     sort_ = Sort
     1204     proof_ = Proof
     1205     tnved_ = TNVED
     1206     unit-cst_ = UNIT-CST
     1207     cst-base-rate_ = CST-BASE-RATE
     1208     nationality_ = NATIONALITY
     1209     normal-waste_ = normal-waste
     1210     cond-keep-code_ = cond-keep-code
     1211     is-alc_ = is-alc
     1212     is-alc-mark_ = is-alc-mark
     1213     .
     1214     if normal-wastage <> normal-wastage_ then do:
     1215       assign
     1216       normal-wastage_ = normal-wastage
     1217       .
     1218     end.
     1219   end.
     1220   else
     1221       return "отказ" .
     1222   END.
     1223   ON CHOOSE OF b-quit IN FRAME DLGOKCAN
     1224   DO:
     1225       return "отказ" .
     1226   END.
     1227   ON LEAVE OF choose-alc-prod IN FRAME DLGOKCAN
     1228   DO:
     1229     FIND FIRST ub.alc-type WHERE ub.alc-type.alc-type-code = choose-alc-prod:SCREEN-VALUE NO-LOCK NO-error.
     1230       if not available ub.alc-type then do:
     1231               ASSIGN
     1232                   choose-alc-prod = ?
     1233                   choose-alc-prod:SCREEN-VALUE = ?.
     1234       end.
     1235       else do:
     1236           DISPLAY ub.alc-type.alc-type-code @ choose-alc-prod with frame DLGOKCAN.
     1237           DISPLAY ub.alc-type.alc-type-name @ choose-alc-prod-name with frame DLGOKCAN.
     1238       end.
     1239            assign
     1240            choose-alc-prod
     1241            choose-alc-prod-name
     1242            alc-type-inner-code = ub.alc-type.alc-type-inner-code
     1243            .
     1244   end.
     1245   ON LEAVE OF cond-keep-code IN FRAME DLGOKCAN
     1246   DO:
     1247       RUN proc-leave-cond-keep-code IN THIS-PROCEDURE (INPUT LASTKEY) NO-ERROR.
     1248       IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1249   END.
     1250   ON RETURN OF CST-BASE-RATE IN FRAME DLGOKCAN
     1251   DO:
     1252       RETURN NO-APPLY.
     1253   END.
     1254   ON VALUE-CHANGED OF is-alc IN FRAME DLGOKCAN
     1255   DO:
     1256     IF is-alc:checked and alcvalue = "yes" then do:
     1257     if mode <> 'ПРОСМОТР':U and alcvalue = "yes" then
     1258     enable is-alc-mark
     1259            choose-alc-prod
     1260            r-choose-alc-prod
     1261            proof
     1262            choose-alc-prod-name
     1263            with frame DLGOKCAN
     1264     .
     1265     else
     1266     display choose-alc-prod
     1267             r-choose-alc-prod
     1268             is-alc-mark
     1269             proof
     1270             choose-alc-prod-name
     1271             with frame DLGOKCAN
     1272             .
     1273     end.
     1274     else hide
     1275            choose-alc-prod
     1276            r-choose-alc-prod
     1277            is-alc-mark
     1278            proof
     1279            choose-alc-prod-name
     1280            in frame DLGOKCAN
     1281     .
     1282     assign is-alc.
     1283   END.
     1284   ON VALUE-CHANGED OF is-alc-mark IN FRAME DLGOKCAN
     1285   DO:
     1286     assign is-alc-mark.
     1287   END.
     1288   ON ENTRY OF normal-wastage IN FRAME DLGOKCAN
     1289   DO:
     1290     assign
     1291     normal-wastage:private-data = normal-wastage:screen-value.
     1292   END.
     1293   ON CHOOSE OF r-choose-alc-prod IN FRAME DLGOKCAN
     1294   DO:
     1295     run ch-choose-alc-prod in this-procedure .
     1296   END.
     1297   ON CHOOSE OF r-cnd-keep IN FRAME DLGOKCAN
     1298   do:
     1299     RUN proc-b-cond-keep-code IN THIS-PROCEDURE NO-ERROR.
     1300     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1301   end.
     1302   ON CHOOSE OF r-cst IN FRAME DLGOKCAN
     1303   do:
     1304       run ch-units in this-procedure .
     1305       apply "entry" to UNIT-CST in frame DLGOKCAN.
     1306   end.
     1307   ON CHOOSE OF r-tnved IN FRAME DLGOKCAN
     1308   DO:
     1309     run ch-tnved in this-procedure .
     1310   END.
     1311   ON VALUE-CHANGED OF Struct IN FRAME DLGOKCAN
     1312   DO:
     1313      ASSIGN
     1314     STRUCT-LENGTH = STRUCT:LENGTH.
     1315     DISPLAY STRUCT-LENGTH
     1316     WITH FRAME DLGOKCAN.
     1317   END.
     1318   ON ANY-PRINTABLE OF struct-length IN FRAME DLGOKCAN
     1319   DO:
     1320     ASSIGN
     1321     struct-length = struct:LENGTH.
     1322     DISPLAY
     1323     struct-length
     1324     WITH FRAME DLGOKCAN.
     1325   END.
     1326   ON RETURN OF TNVED IN FRAME DLGOKCAN
     1327   DO:
     1328     FIND FIRST TT-tnved WHERE TT-tnved.tnved = input frame DLGOKCAN tnved no-error.
     1329     if not available TT-tnved then do:
     1330       message "Код ТНВЭД не найден в справочнике." view-as alert-box error.
     1331       display ? @ tnved with frame DLGOKCAN.
     1332       run ch-tnved in this-procedure .
     1333       return no-apply.
     1334     end.
     1335     else
     1336     if length(trim(input frame DLGOKCAN tnved)) <> 10 then do:
     1337        message "Код ТНВЭД привязки к товару должен быть 10-ти символьный." view-as alert-box error.
     1338        display ? @ tnved with frame DLGOKCAN.
     1339        run ch-tnved in this-procedure .
     1340        return no-apply.
     1341      end.
     1342     else
     1343     display TT-tnved.f-name @ tnved-name with frame DLGOKCAN.
     1344   END.
     1345   ON RETURN OF UNIT-CST IN FRAME DLGOKCAN
     1346   DO:
     1347       if not can-FIND( ub.units where ub.units.unit-name = input frame DLGOKCAN UNIT-CST )
     1348          then do:
     1349          UNIT-CST = "?".
     1350          DISPLAY UNIT-CST WITH FRAME DLGOKCAN.
     1351          run ch-units in this-procedure .
     1352       end.
     1353   END.
     1354   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME DLGOKCAN:PARENT eq ?
     1355   THEN FRAME DLGOKCAN:PARENT = ACTIVE-WINDOW.
     1356   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1357   on help of frame DLGOKCAN
     1358   do:
     1359     run gbl/app_help.p
     1360       (input this-procedure :file-name
     1361       ,input ''
     1362       ,input ?
     1363       ) no-error.
     1364     if error-status :error then do:
     1365       message
     1366         "Ошибка при вызове помощи"
     1367         error-status :get-message(1)
     1368         view-as alert-box .
     1369     end.
     1370   end.
     1371   run minbtn-set in this-procedure .
     1372   on choose of b-help in frame DLGOKCAN
     1373   do:
     1374     apply "help":u to frame DLGOKCAN .
     1375   end.
     1376   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1377   procedure minbtn-set :
     1378       do
     1379           on error undo, return error return-value
     1380           :
     1381           define variable ii              as integer       no-undo .
     1382           define variable fh              as widget-handle no-undo .
     1383           define variable hh              as widget-handle no-undo .
     1384           define variable v-h             as handle        extent 4 no-undo .
     1385           define variable v-name-button   as character     no-undo .
     1386           define variable v-help-old-x    as decimal       no-undo .
     1387           define variable v-help-old-y    as decimal       no-undo .
     1388           define variable v-help-old-size as decimal       no-undo .
     1389           define variable v-frame-width   as decimal       no-undo .
     1390           define variable jj              as integer       no-undo .
     1391           do
     1392               on error undo, return error
     1393               :
     1394               assign
     1395                   v-frame-width = frame DLGOKCAN:width - 0.3
     1396                   fh            = frame DLGOKCAN:first-child
     1397                   hh            = fh:first-child
     1398                   ii            = 1
     1399                   .
     1400               do while valid-handle(hh):
     1401                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1402                   do:
     1403                       case lc(hh:name) :
     1404                           when "b-help" then
     1405                               do:
     1406                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1407                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1408                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1409                                   hh:TOOLTIP = "Помощь" .
     1410                                   v-help-old-x = hh:column .
     1411                                   v-help-old-y = hh:row    .
     1412                                   v-help-old-size = hh:width .
     1413                                   hh:width-chars = 2.5 .
     1414                               end.
     1415                           when "b-print" then
     1416                               do:
     1417                                   hh:load-image("cmp/b-print.bmp":u) .
     1418                                   hh:TOOLTIP = "Печать" .
     1419                                   v-h[ii] = hh:handle .
     1420                                   ii = ii + 1 .
     1421                                   hh:width-chars = 3 .
     1422                               end.
     1423                           when "b-history" or
     1424                           when "b-hist" then
     1425                               do:
     1426                                   hh:load-image("cmp/b-hist.bmp":u) .
     1427                                   hh:TOOLTIP = "История" .
     1428                                   v-h[ii] = hh:handle .
     1429                                   ii = ii + 1 .
     1430                                   hh:width-chars = 3 .
     1431                               end.
     1432                           when "b-sch" then
     1433                               do:
     1434                                   hh:load-image("cmp/b-sch.bmp":u) .
     1435                                   hh:TOOLTIP = "Установка Фильтра" .
     1436                                   v-h[ii] = hh:handle .
     1437                                   ii = ii + 1 .
     1438                                   hh:width-chars = 3 .
     1439                               end.
     1440                           when "b-hist-user" then
     1441                               do:
     1442                                   hh:load-image("cmp/b-hist.bmp":u) .
     1443                                   hh:TOOLTIP = "История пользователя" .
     1444                                   ii = ii + 1 .
     1445                               end.
     1446                       end case.
     1447                   end.
     1448                   hh = hh:next-sibling.
     1449               end.
     1450               b-help:column = v-frame-width - b-help:width-chars.
     1451               jj = 0.
     1452               repeat ii = 4 to 1 by -1 :
     1453                   if valid-handle (v-h[ii] ) then
     1454                   do:
     1455                       jj  = jj + 1 .
     1456                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1457                       v-h[ii]:row    = v-help-old-y .
     1458                   end.
     1459               end.
     1460           end.
     1461       end.
     1462   end procedure.
     1463   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1464   ON TAB ANYWHERE
     1465   DO:
     1466   define variable ii as integer no-undo .
     1467   define variable fh as widget-handle no-undo .
     1468   define variable hh as widget-handle no-undo .
     1469   define variable v-next-widget-name as character no-undo .
     1470   if v-tab-order <> '' then do:
     1471     if self:type = "TOGGLE-BOX" then
     1472     self:BGCOLOR = ?.
     1473     assign
     1474     ii = lookup(self:name, v-tab-order).
     1475     assign
     1476     ii = ii + 1
     1477     v-next-widget-name = entry(ii, v-tab-order)
     1478     no-error .
     1479     if error-status:error then do:
     1480       assign
     1481       ii = 1
     1482       v-next-widget-name = entry( ii, v-tab-order)
     1483       .
     1484     end.
     1485     assign
     1486     fh = frame DLGOKCAN:first-child
     1487     hh = fh:first-child
     1488     .
     1489     do while valid-handle(hh):
     1490       if hh:name = v-next-widget-name then do:
     1491         if hh:sensitive  = yes
     1492         AND hh:visible = yes then do:
     1493           APPLY "ENTRY" to hh.
     1494           return no-apply.
     1495         end.
     1496         else do:
     1497           APPLY "TAB" to hh.
     1498           return no-apply.
     1499         end.
     1500       end.
     1501       hh = hh:next-sibling.
     1502     end.
     1503   end.
     1504   END.
     1505   ON BACK-TAB ANYWHERE
     1506   DO:
     1507   define variable ii as integer no-undo .
     1508   define variable fh as widget-handle no-undo .
     1509   define variable hh as widget-handle no-undo .
     1510   define variable v-next-widget-name as character no-undo .
     1511   if v-tab-order <> '' then do:
     1512     assign
     1513     ii = lookup(self:name, v-tab-order).
     1514     .
     1515     assign
     1516     ii = (if ii = 1
     1517           then  num-entries(v-tab-order)
     1518           else ii - 1
     1519           )
     1520     v-next-widget-name = entry(ii, v-tab-order)
     1521     .
     1522     assign
     1523     fh = frame DLGOKCAN:first-child
     1524     hh = fh:first-child
     1525     .
     1526     do while valid-handle(hh):
     1527       if hh:name = v-next-widget-name then do:
     1528         if hh:sensitive  = yes
     1529         AND hh:visible = yes then do:
     1530           APPLY "ENTRY" to hh.
     1531           return no-apply.
     1532         end.
     1533         else do:
     1534         APPLY "BACK-TAB" to hh.
     1535         return no-apply.
     1536         end.
     1537       end.
     1538       hh = hh:next-sibling.
     1539     end.
     1540     end.
     1541   END.
     1542   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1543   ON RETURN ANYWHERE
     1544   DO:
     1545   define variable ii as integer no-undo .
     1546   define variable fh as widget-handle no-undo .
     1547   define variable hh as widget-handle no-undo .
     1548   define variable v-next-widget-name as character no-undo .
     1549     if v-tab-order <> '' then do:
     1550       assign
     1551       ii = lookup(self:name, v-tab-order).
     1552       if ii = num-entries(v-tab-order) then do:
     1553           APPLY 'CHOOSE' TO b-exit in frame DLGOKCAN.
     1554           return no-apply.
     1555       end.
     1556       if self:type <> "BUTTON" and
     1557         self:type <> "EDITOR"  then do:
     1558         run proc-move-forward in this-procedure .
     1559         return no-apply.
     1560       end.
     1561       if self:type = "BUTTON" then do:
     1562         APPLY "CHOOSE" to self.
     1563       end.
     1564       if self:type = "TOGGLE-BOX" then
     1565       self:BGCOLOR = ?.
     1566       assign
     1567       ii = ii + 1
     1568       v-next-widget-name = entry(ii, v-tab-order)
     1569       no-error .
     1570       if error-status:error then do:
     1571         assign
     1572         ii = 1
     1573         v-next-widget-name = entry( ii, v-tab-order)
     1574         .
     1575       end.
     1576       assign
     1577       fh = frame DLGOKCAN:first-child
     1578       hh = fh:first-child
     1579       .
     1580       do while valid-handle(hh):
     1581         if hh:name = v-next-widget-name then do:
     1582           if hh:sensitive  = yes
     1583           AND hh:visible = yes then do:
     1584             if hh:type = "TOGGLE-BOX":U then do:
     1585               assign
     1586               hh:BGcolor = 1
     1587               .
     1588             end.
     1589             APPLY "ENTRY" to hh.
     1590             return no-apply.
     1591           end.
     1592           else do:
     1593             APPLY "TAB" to hh.
     1594             return no-apply.
     1595           end.
     1596         end.
     1597         hh = hh:next-sibling.
     1598       end.
     1599     end.
     1600   END.
     1601   procedure proc-move-forward :
     1602   define variable ii as integer no-undo .
     1603   define variable fh as widget-handle no-undo .
     1604   define variable hh as widget-handle no-undo .
     1605   define variable v-next-widget-name as character no-undo .
     1606   do
     1607   on error undo, return error
     1608   :
     1609     if v-tab-order <> '' then do:
     1610       if self:type = "TOGGLE-BOX" then
     1611       self:BGCOLOR = ?.
     1612       assign
     1613       ii = lookup(self:name, v-tab-order).
     1614       assign
     1615       ii = ii + 1
     1616       v-next-widget-name = entry(ii, v-tab-order)
     1617       no-error .
     1618       if error-status:error then do:
     1619         assign
     1620         ii = 1
     1621         v-next-widget-name = entry( ii, v-tab-order)
     1622         .
     1623       end.
     1624       assign
     1625       fh = frame DLGOKCAN:first-child
     1626       hh = fh:first-child
     1627       .
     1628       do while valid-handle(hh):
     1629         if hh:name = v-next-widget-name then do:
     1630           if hh:sensitive  = yes
     1631           AND hh:visible = yes then do:
     1632             if hh:type = "TOGGLE-BOX":U then do:
     1633               assign
     1634               hh:BGcolor = 1
     1635               .
     1636             end.
     1637             APPLY "ENTRY" to hh.
     1638             return.
     1639           end.
     1640           else do:
     1641             assign
     1642             ii = ii + 1
     1643             v-next-widget-name = entry(ii, v-tab-order)
     1644             no-error .
     1645             if error-status:error then do:
     1646               assign
     1647               ii = 1
     1648               v-next-widget-name = entry( ii, v-tab-order)
     1649               .
     1650             end.
     1651           end.
     1652         end.
     1653         hh = hh:next-sibling.
     1654       end.
     1655     end.
     1656   end.
     1657   end procedure.
     1658   ON WINDOW-CLOSE OF FRAME DLGOKCAN APPLY "END-ERROR":U TO SELF.
     1659   assign
     1660   G-Name = goodsname
     1661   P-Name = prodname
     1662   P-Address = prodaddress
     1663   g-unit-base = (IF goods-unit-base = "" THEN "?" ELSE goods-unit-base)
     1664   Destin = destin_
     1665   Attrib = attrib_
     1666   UserRule = user-rule_
     1667   Sert = sert_
     1668   Struct:SCREEN-VALUE = struct_
     1669   TNVED = tnved_
     1670   DeadLine = deadline_
     1671   Sort = sort_
     1672   Proof = Proof_
     1673   UNIT-CST = unit-cst_
     1674   CST-BASE-RATE = cst-base-rate_
     1675   NATIONALITY = nationality_
     1676   normal-wastage = normal-wastage_
     1677   normal-waste = normal-waste_
     1678   cond-keep-code = cond-keep-code_
     1679   is-alc = is-alc_
     1680   is-alc-mark = is-alc-mark_
     1681   .
     1682   MAIN-BLOCK:
     1683   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1684      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1685   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1686     run mainmenu_getcntxt in parparentproc
     1687       (output v-cntxt-db-num
     1688       ,output v-cntxt-userid
     1689       ,output v-cntxt-level
     1690       ,output v-cntxt-host-code-obj
     1691       ,output v-cntxt-obj-type
     1692       ,output v-cntxt-obj-code
     1693       ,output v-cntxt-db-num-obj
     1694       ,output v-cntxt-is-admin
     1695       ) .
     1696       RUN enable_UI in this-procedure .
     1697       if mode = 'ПРОСМОТР':U then do:
     1698         HIDE
     1699         b-quit in frame DLGOKCAN .
     1700         b-exit:label = "Выход " .
     1701       end.
     1702       WAIT-FOR GO OF FRAME DLGOKCAN.
     1703   END.
     1704   RUN disable_UI.
     1705   PROCEDURE ch-choose-alc-prod :
     1706   define variable v-rec as char no-undo .
     1707   define variable v-ok  as logical no-undo .
     1708   run ref/alc-type.w (
     1709             input parparentproc
     1710             , input 'b-sel':U
     1711             , input-output v-rec
     1712             , output v-ok ).
     1713   if v-rec = ? then  do:
     1714     apply "entry" to r-choose-alc-prod in frame DLGOKCAN.
     1715     return error.
     1716   end.
     1717   FIND ub.alc-type WHERE recid (alc-type) = int(v-rec) no-error.
     1718   if available ub.alc-type then do:
     1719       DISPLAY ub.alc-type.alc-type-code @ choose-alc-prod with frame DLGOKCAN.
     1720       DISPLAY ub.alc-type.alc-type-name @ choose-alc-prod-name with frame DLGOKCAN.
     1721       assign
     1722           choose-alc-prod
     1723           choose-alc-prod-name
     1724           alc-type-inner-code = ub.alc-type.alc-type-inner-code
     1725       .
     1726   end.
     1727   END PROCEDURE.
     1728   PROCEDURE ch-tnved :
     1729   run ref/t-tnved.w (yes, output rid-tnved).
     1730   find first tt-tnved where RECID(tt-tnved) = rid-tnved no-lock no-error.
     1731   if available tt-tnved then disp tt-tnved.tnved @ tnved
     1732                                   tt-tnved.f-name @ tnved-name with frame DLGOKCAN.
     1733   END PROCEDURE.
     1734   PROCEDURE ch-units :
     1735   define variable v-rec as recid no-undo .
     1736   run ref/units.w (
     1737               input parparentproc
     1738             , input yes
     1739             , output v-rec ).
     1740   if v-rec = ? then  do:
     1741     apply "entry" to r-cst in frame DLGOKCAN.
     1742     return error.
     1743   end.
     1744   FIND ub.units WHERE recid (ub.units) = v-rec NO-LOCK.
     1745   DISPLAY ub.units.unit-name @ UNIT-CST with frame DLGOKCAN.
     1746   if input frame DLGOKCAN UNIT-CST = g-unit-base then  do:
     1747     DISPLAY 1 @ CST-BASE-RATE with frame DLGOKCAN.
     1748     DISABLE CST-BASE-RATE with frame DLGOKCAN.
     1749   end.
     1750   else do:
     1751     ENABLE CST-BASE-RATE with frame DLGOKCAN.
     1752   end.
     1753   END PROCEDURE.
     1754   PROCEDURE disable_UI :
     1755     HIDE FRAME DLGOKCAN.
     1756   END PROCEDURE.
     1757   PROCEDURE enable_UI :
     1758   define variable v-scales-type as character no-undo .
     1759   define variable v-ii as integer no-undo .
     1760   v-tab-order = 'b-ezit,b-quit,b-help,g-name,p-name,p-address,tnved,r-tnved,tnved-name,unit-cst,' +
     1761                  'r-cst,cst-base-rate,nationality,destin,attrib,userrule,sert,struct,' +
     1762                  'deadline,sort,is-alc,proof,is-alc-mark,choose-alc-prod,normal-wastage,normal-waste,cond-keep-code,r-cnd-keep'.
     1763   IF goods-unit-base <> '':U THEN DO:
     1764     FIND FIRST buf_units NO-LOCK WHERE
     1765               buf_units.unit-name = goods-unit-base NO-ERROR.
     1766   END.
     1767   ASSIGN
     1768   struct = struct_
     1769   .
     1770   DISPLAY
     1771   TNVED UNIT-CST CST-BASE-RATE r-cst g-unit-base
     1772   Destin Attrib UserRule Sert l-struct Struct  DeadLine Sort Proof
     1773   UNIT-CST CST-BASE-RATE TNVED
     1774   G-Name P-Name P-Address NATIONALITY normal-wastage normal-waste cond-keep-code is-alc is-alc-mark choose-alc-prod
     1775   WITH FRAME DLGOKCAN .
     1776   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1777     (input  'is-custm'
     1778     ,input  0
     1779     ,input  ''
     1780     ,input  0
     1781     ,input  ''
     1782     ,input  ''
     1783     ,input  ''
     1784     ,input  no
     1785     ,output custvalue
     1786     ,output custtype
     1787     ) no-error .
     1788   if custvalue = "yes" and
     1789    can-find(first tt-tnved where tt-tnved.tnved = input frame dlgokcan tnved no-lock) then do:
     1790    find first tt-tnved where tt-tnved.tnved = input frame dlgokcan tnved no-lock.
     1791    display tt-tnved.f-name @ tnved-name with frame dlgokcan.
     1792   end.
     1793   IF cond-keep-code <> 0
     1794   AND cond-keep-code <> ?
     1795   THEN DO:
     1796     FIND FIRST X_condition-keeping NO-LOCK WHERE
     1797               X_condition-keeping.cond-keep-code = cond-keep-code NO-ERROR.
     1798     IF AVAILABLE X_condition-keeping THEN DO:
     1799         ASSIGN
     1800         cond-keep-name = X_condition-keeping.cond-keep-name
     1801         .
     1802         DISPLAY
     1803         cond-keep-name
     1804         WITH FRAME DLGOKCAN.
     1805     END.
     1806   END.
     1807   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1808     (input  'alcohol'
     1809     ,input  0
     1810     ,input  ''
     1811     ,input  0
     1812     ,input  ''
     1813     ,input  ''
     1814     ,input  ''
     1815     ,input  no
     1816     ,output alcvalue
     1817     ,output alctype
     1818     ) no-error .
     1819   if alcvalue = "yes" then do:
     1820     display is-alc with frame DLGOKCAN.
     1821   end.
     1822   if choose-alc-prod >= 0 and choose-alc-prod <> ? then do:
     1823     find first ub.alc-type no-lock where ub.alc-type.alc-type-inner-code = alc-type-inner-code no-error.
     1824     if available ub.alc-type then do:
     1825       assign
     1826           choose-alc-prod = integer(ub.alc-type.alc-type-code)
     1827           choose-alc-prod-name = ub.alc-type.alc-type-name
     1828           .
     1829       DISPLAY
     1830       choose-alc-prod
     1831       choose-alc-prod-name with frame DLGOKCAN.
     1832     end.
     1833   end.
     1834   ENABLE
     1835   TNVED when mode <> 'ПРОСМОТР':U and custvalue = "yes"
     1836   CST-BASE-RATE when mode <> 'ПРОСМОТР':U and custvalue = "yes"
     1837   UNIT-CST when mode <> 'ПРОСМОТР':U and custvalue = "yes"
     1838   r-cst when mode <> 'ПРОСМОТР':U and custvalue = "yes"
     1839   r-tnved when mode <> 'ПРОСМОТР':U and custvalue = "yes"
     1840   Destin when mode <> 'ПРОСМОТР':U
     1841   Attrib when mode <> 'ПРОСМОТР':U
     1842   UserRule when mode <> 'ПРОСМОТР':U
     1843   Sert when mode <> 'ПРОСМОТР':U
     1844   Struct
     1845   r-cnd-keep when mode <> 'ПРОСМОТР':U
     1846   cond-keep-code WHEN mode <> 'ПРОСМОТР':U
     1847   is-alc WHEN mode <> 'ПРОСМОТР':U and alcvalue = "yes"
     1848   is-alc-mark WHEN mode <> 'ПРОСМОТР':U and alcvalue = "yes"
     1849   choose-alc-prod when mode <> 'ПРОСМОТР':U and alcvalue = "yes"
     1850   DeadLine when mode <> 'ПРОСМОТР':U
     1851   Sort when mode <> 'ПРОСМОТР':U
     1852   Proof when mode <> 'ПРОСМОТР':U
     1853   Nationality when mode <> 'ПРОСМОТР':U  and custvalue = "yes"
     1854   normal-wastage when mode <> 'ПРОСМОТР':U
     1855   normal-waste when mode <> 'ПРОСМОТР':U
     1856   b-help b-exit b-quit
     1857   WITH FRAME DLGOKCAN .
     1858   apply "VALUE-CHANGED":U to is-alc.
     1859   IF mode = 'ПРОСМОТР':U THEN DO:
     1860     struct:READ-ONLY IN FRAME DLGOKCAN = YES.
     1861   END.
     1862   APPLY "VALUE-CHANGED" TO STRUCT.
     1863   END PROCEDURE.
     1864   PROCEDURE proc-b-cond-keep-code :
     1865   define variable v-rid-list as character no-undo.
     1866   define variable v-sts as integer no-undo.
     1867   define variable v-cond-keep-code like ub.condition-keeping.cond-keep-code no-undo.
     1868   DEFINE BUFFER buf_condition-keeping FOR ub.condition-keeping.
     1869   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1870   if lookup(self :type
     1871            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1872            ) = 0
     1873   then do:
     1874     message
     1875       "$Workfile$"
     1876       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1877       "Интерфейсный элемент" self :name  skip
     1878       "Тип" self :type  skip
     1879       "Процедура" this-procedure :file-name skip
     1880       view-as alert-box .
     1881   end.
     1882   else do:
     1883     apply "entry":u to self  .
     1884     if focus :handle <> self :handle  then do:
     1885       return no-apply .
     1886     end.
     1887   end.
     1888   assign
     1889   v-cond-keep-code = FRAME DLGOKCAN cond-keep-code
     1890   cond-keep-code
     1891   v-sts = INTEGER('0':U)
     1892       .
     1893   IF available X_condition-keeping THEN v-rid-list = string(RECID(X_condition-keeping)) .
     1894   run ref/cndkeeps.w (
     1895                   INPUT parParentProc
     1896                  ,input p-curr-obj-type
     1897                  ,input p-curr-obj-code
     1898                  ,input "b-sel":U
     1899                  ,input 'все':U
     1900                  ,input-output v-sts
     1901                  ,input-output v-rid-list).
     1902       if v-rid-list <> "":U then do:
     1903           FIND FIRST buf_condition-keeping WHERE
     1904                recid( buf_condition-keeping ) = integer(v-rid-list) NO-LOCK .
     1905           FIND FIRST X_condition-keeping WHERE
     1906           RECID(X_condition-keeping) = RECID(buf_condition-keeping).
     1907           assign
     1908           cond-keep-code = buf_condition-keeping.cond-keep-code
     1909           cond-keep-name = buf_condition-keeping.cond-keep-name
     1910                  .
     1911           DISPLAY
     1912           cond-keep-code
     1913           cond-keep-name
     1914           with frame DLGOKCAN .
     1915           RETURN.
     1916       end.
     1917       IF v-cond-keep-code = ? THEN DO:
     1918          ASSIGN
     1919          cond-keep-code = v-cond-keep-code
     1920          cond-keep-name = "":U
     1921          .
     1922          RELEASE X_condition-keeping.
     1923          DISPLAY
     1924          cond-keep-code
     1925          cond-keep-name
     1926          with frame DLGOKCAN .
     1927       END.
     1928   END PROCEDURE.
     1929   PROCEDURE proc-leave-cond-keep-code :
     1930   DEFINE INPUT PARAMETER p-lastkey AS integer NO-UNDO.
     1931   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1932   if lookup(self :type
     1933            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     1934            ) = 0
     1935   then do:
     1936     message
     1937       "$Workfile$"
     1938       "Указанному интерфейсному элементу фокус не может быть передан" skip
     1939       "Интерфейсный элемент" self :name  skip
     1940       "Тип" self :type  skip
     1941       "Процедура" this-procedure :file-name skip
     1942       view-as alert-box .
     1943   end.
     1944   else do:
     1945     apply "entry":u to self  .
     1946     if focus :handle <> self :handle  then do:
     1947       return no-apply .
     1948     end.
     1949   end.
     1950   define variable v-cond-keep-code like ub.condition-keeping.cond-keep-code no-undo.
     1951   DEFINE BUFFER buf_condition-keeping FOR ub.condition-keeping.
     1952   ASSIGN
     1953   v-cond-keep-code = FRAME DLGOKCAN cond-keep-code
     1954   cond-keep-code.
     1955   FIND FIRST buf_condition-keeping WHERE
     1956    buf_condition-keeping.cond-keep-code = cond-keep-code NO-LOCK NO-error.
     1957   if not available buf_condition-keeping then do:
     1958       IF v-cond-keep-code <> ? THEN DO:
     1959           MESSAGE
     1960           "Нет условий хранения с кодом" cond-keep-code
     1961           VIEW-AS ALERT-BOX ERROR.
     1962           IF LASTKEY = KEYCODE("return") THEN DO:
     1963               RUN proc-b-cond-keep-code IN THIS-PROCEDURE NO-error.
     1964               RETURN NO-APPLY.
     1965           END.
     1966           ELSE DO:
     1967               assign
     1968               cond-keep-code = v-cond-keep-code.
     1969           END.
     1970       END.
     1971       ELSE DO:
     1972         IF p-LASTKEY = KEYCODE("return") THEN DO:
     1973               MESSAGE
     1974            "Нет условий хранения с кодом" cond-keep-code
     1975            VIEW-AS ALERT-BOX ERROR.
     1976         END.
     1977       END.
     1978       ASSIGN
     1979       cond-keep-code = ?
     1980       cond-keep-name = "":U
     1981       .
     1982       display
     1983       cond-keep-code
     1984       cond-keep-name
     1985       with frame DLGOKCAN.
     1986       IF p-LASTKEY = KEYCODE("return") THEN DO:
     1987         RUN proc-b-cond-keep-code IN THIS-PROCEDURE NO-error.
     1988         IF ERROR-STATUS:ERROR THEN RETURN error.
     1989       END.
     1990   end.
     1991   else do:
     1992     FIND FIRST X_condition-keeping NO-LOCK WHERE
     1993               recid(X_condition-keeping) = RECID(buf_condition-keeping).
     1994     assign
     1995     cond-keep-name = buf_condition-keeping.cond-keep-name
     1996     .
     1997       display
     1998       cond-keep-name
     1999       cond-keep-code
     2000       with frame DLGOKCAN.
     2001       .
     2002   END.
     2003   END PROCEDURE.
