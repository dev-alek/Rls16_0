      108   procedure proc-alt-shift-f2:
      109     if not ibs.th.gbl.gbl-var:rcode
      110   then
      111     run gbl\inidebug.p .
      112   end.
      113   procedure proc-alt-shift-f3:
      114     run gbl/prvssinf.p
      115       ( input this-procedure
      116       ) .
      117   end.
      118   define variable v-inform-launched as logical no-undo initial false .
      119   procedure proc-alt-shift-f4:
      120     define variable v-action as character no-undo .
      121     if v-inform-launched = false then do:
      122       assign
      123         v-inform-launched = true
      124       .
      125       run gbl/d-inform.w
      126         (  input self
      127         ,  input this-procedure
      128         , output v-action
      129         ) no-error .
      130       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      131       assign
      132         v-inform-launched = false
      133       .
      134     end.
      135   end.
      136   procedure proc-alt-f1:
      137     run gbl/corrhelp.p
      138       (input this-procedure
      139       ) .
      140   end .
      141   on alt-shift-f2 anywhere do:
      142     run proc-alt-shift-f2.
      143   end.
      144   on alt-shift-f3 anywhere do:
      145     run proc-alt-shift-f3 in this-procedure .
      146   end.
      147   on alt-shift-f4 anywhere do:
      148     run proc-alt-shift-f4 in this-procedure.
      149   end.
      150   on alt-f1 anywhere do:
      151     run proc-alt-f1 in this-procedure .
      152   end.
      153   function diff-list returns character (
      154     input parfirst-list  as character,
      155     input parsecond-list as character,
      156     input pardelim       as character).
      157     if pardelim = ""
      158     or pardelim = ?
      159     then do:
      160       assign
      161         pardelim = ","
      162       .
      163     end.
      164     def var ind as integer no-undo .
      165     def var v-elem as character no-undo .
      166     def var v-result-list as character no-undo init "".
      167     def var v-num-parfirst-list as integer no-undo .
      168     assign
      169       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      170     .
      171     do ind = 1 to v-num-parfirst-list
      172     :
      173       assign
      174         v-elem = entry(ind, parfirst-list, pardelim)
      175       .
      176       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      177         assign
      178           v-result-list = v-result-list
      179                         + (if v-result-list > "" then pardelim else "")
      180                         + v-elem
      181         .
      182       end.
      183     end.
      184     return v-result-list .
      185   end function.
      186   function add-list returns character (
      187    input parfirst-list  as character,
      188    input parsecond-list as character,
      189    input pardelim       as character).
      190     if pardelim = ""
      191     or pardelim = ?
      192     then do:
      193       assign
      194         pardelim = ","
      195       .
      196     end.
      197     def var ind as integer no-undo .
      198     def var v-elem as character no-undo .
      199     def var v-result-list as character no-undo init "".
      200     def var v-num-parfirst-list as integer no-undo .
      201     assign
      202       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      203     .
      204     do ind = 1 to v-num-parfirst-list
      205     :
      206       assign
      207         v-elem = entry(ind, parfirst-list, pardelim)
      208       .
      209       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      210         assign
      211           v-result-list = v-result-list
      212                         + (if v-result-list > "" then pardelim else "")
      213                         + v-elem
      214         .
      215       end.
      216     end.
      217     def var v-num-parsecond-list as integer no-undo .
      218     assign
      219       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      220     .
      221     do ind = 1 to v-num-parsecond-list
      222     :
      223       assign
      224         v-elem = entry(ind, parsecond-list, pardelim)
      225       .
      226       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      227         assign
      228           v-result-list = v-result-list
      229                         + (if v-result-list > "" then pardelim else "")
      230                         + v-elem
      231         .
      232       end.
      233     end.
      234     return v-result-list .
      235   end function.
      236   function cross-list returns character (
      237    input parfirst-list  as character,
      238    input parsecond-list as character,
      239    input pardelim       as character).
      240     if pardelim = ""
      241     or pardelim = ?
      242     then do:
      243       assign
      244         pardelim = ","
      245       .
      246     end.
      247     def var ind as integer no-undo .
      248     def var v-elem as character no-undo .
      249     def var v-result-list as character no-undo init "".
      250     def var v-num-parfirst-list as integer no-undo .
      251     assign
      252       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      253     .
      254     do ind = 1 to v-num-parfirst-list
      255     :
      256       assign
      257         v-elem = entry(ind, parfirst-list, pardelim)
      258       .
      259       if lookup(v-elem, v-result-list, pardelim) = 0
      260       and lookup(v-elem, parsecond-list, pardelim) > 0
      261       then do:
      262         assign
      263           v-result-list = v-result-list
      264                         + (if v-result-list > "" then pardelim else "")
      265                         + v-elem
      266         .
      267       end.
      268     end.
      269     return v-result-list .
      270   end function.
      271   function radio-label returns character (
      272    input par-rs-value  as character,
      273    input par-rs-radio-buttons as character)
      274    .
      275    DEFINE variable v-result-label as character no-undo.
      276    assign
      277    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      278                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      279                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      280                             ), par-rs-radio-buttons
      281                           )
      282    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      283    .
      284   return v-result-label.
      285   end function.
      286   function m-radio-label returns character (
      287    input par-rs-value  as character,
      288    input par-rs-radio-buttons as character,
      289    input par-delim as character
      290    )
      291    .
      292    DEFINE variable v-result-label as character no-undo.
      293    assign
      294    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      295                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      296                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      297                             ), par-rs-radio-buttons, par-delim
      298                           )
      299    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      300    .
      301   return v-result-label.
      302   end function.
      303   FUNCTION mixlist returns character
      304   (
      305    input parfirst-list  as character
      306    ,input parsecond-list as character
      307    ,input pardelim       as character
      308    ,input pardelim-result as character ) :
      309     if pardelim = ""
      310     or pardelim = ?
      311     then do:
      312       assign
      313         pardelim = ","
      314       .
      315     end.
      316     def var ind as integer no-undo .
      317     def var v-elem1 as character no-undo .
      318     def var v-elem2 as character no-undo .
      319     def var v-result-list as character no-undo init "".
      320     do ind = 1 to num-entries(parfirst-list, pardelim)
      321     :
      322       assign
      323         v-elem1 = entry(ind, parfirst-list, pardelim)
      324         v-elem2 = entry(ind, parsecond-list, pardelim)
      325       .
      326         assign
      327           v-result-list = v-result-list
      328                         + (if v-result-list > "" then pardelim-result else "")
      329                         + v-elem1 + pardelim-result + v-elem2
      330         .
      331     end.
      332     return v-result-list .
      333   END FUNCTION.
