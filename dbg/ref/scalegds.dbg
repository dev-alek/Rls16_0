     3508   end.
     3509   define variable varpgscales-pref-type22 as character no-undo.
     3510   varpgscales-pref  = ?.
     3511   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3512     (input  'scpgpref':u
     3513     ,input  '':u
     3514     ,input  '':u
     3515     ,input  0
     3516     ,input  '':u
     3517     ,input  '':u
     3518     ,input  '':u
     3519     ,input  no
     3520     ,output varpgscales-pref
     3521     ,output varpgscales-pref-type22
     3522     ) no-error .
     3523   if varpgscales-pref = ? then do:
     3524     assign
     3525     varpgscales-pref = '24IIIIIQQ000C,28IIIIIQQQ00C':U.
     3526   end.
     3527       IF p-db-num = v-cntxt-db-num THEN DO:
     3528         db-mode = "self".
     3529       END.
     3530       ELSE DO:
     3531          db-mode = "0".
     3532       END.
     3533       RUN Myenable in this-procedure .
     3534       WAIT-FOR GO OF FRAME Dialog-Frame.
     3535   END.
     3536   RUN disable_UI in this-procedure .
     3537   PROCEDURE disable_UI :
     3538     HIDE FRAME Dialog-Frame.
     3539   END PROCEDURE.
     3540   PROCEDURE enable_UI :
     3541     DISPLAY a-n-c loc-art loc-name loc-code mark-num
     3542         WITH FRAME Dialog-Frame.
     3543     ENABLE Btn_OUT b-mark b-ticket b-hist b-help a-n-c loc-art loc-name loc-code
     3544            br-lst-db br-lst mark-num
     3545         WITH FRAME Dialog-Frame.
     3546     VIEW FRAME Dialog-Frame.
     3547     OPEN QUERY br-lst FOR EACH X_scales-gds NO-LOCK,              EACH X_bar-code OF X_scales-gds NO-LOCK,              EACH X_goods OF X_bar-code NO-LOCK,              EACH X_gds-obj-attr OF X_goods NO-LOCK,              EACH X_prod-bc OF X_bar-code NO-LOCK     BY X_scales-gds.b-code      BY X_scales-gds.scales-num.    OPEN QUERY br-lst-db FOR EACH X_scales-gds NO-LOCK,              EACH X_bar-code OF X_scales-gds NO-LOCK,              EACH X_goods OF X_bar-code NO-LOCK,              EACH X_gds-obj-attr OF X_goods NO-LOCK,              EACH X_prod-bc-db OF X_bar-code NO-LOCK OUTER-JOIN     BY X_scales-gds.b-code      BY X_scales-gds.scales-num.
     3548   END PROCEDURE.
     3549   PROCEDURE gds-recid :
     3550   DEFINE variable glog as logical no-undo .
     3551   if available X_goods then do:
     3552     gds-rec = recid(X_goods).
     3553   end.
     3554   else do:
     3555     gds-rec = ?.
     3556   end.
     3557   END PROCEDURE.
     3558   PROCEDURE MyEnable :
     3559   DISPLAY mark-num
     3560   WITH FRAME Dialog-Frame.
     3561   ENABLE
     3562   b-mark
     3563   b-ticket
     3564   b-help
     3565   b-hist
     3566   Btn_OUT
     3567   br-lst  when db-mode = "self"
     3568   br-lst-db  when db-mode = "0"
     3569   mark-num
     3570   a-n-c
     3571   WITH FRAME Dialog-Frame.
     3572   hide
     3573   loc-art in frame Dialog-Frame
     3574   loc-name loc-code in frame Dialog-Frame
     3575   mark-num in frame Dialog-Frame.
     3576   if db-mode = "self" then do:
     3577     hide
     3578     br-lst-db
     3579     in frame Dialog-Frame .
     3580   end.
     3581   else do:
     3582     hide
     3583     br-lst
     3584     in frame Dialog-Frame .
     3585   end.
     3586   VIEW FRAME Dialog-Frame.
     3587   run Openbr IN THIS-PROCEDURE.
     3588   Assign frame Dialog-Frame:title = substitute("&1 БД &2", frame Dialog-Frame:title, p-db-num).
     3589   if v-cntxt-db-num <> p-db-num then do:
     3590     disable
     3591     b-ticket
     3592     with frame Dialog-Frame .
     3593   end.
     3594   if db-mode = "self" then do:
     3595   apply "entry" to br-lst in frame Dialog-Frame .
     3596   assign
     3597   glog = br-lst:select-row( 1 )
     3598   glog = br-lst:scroll-to-selected-row( 1 ) .
     3599   end.
     3600   else do:
     3601     apply "entry" to br-lst-db in frame Dialog-Frame .
     3602     assign
     3603     glog = br-lst-db:select-row( 1 )
     3604     glog = br-lst-db:scroll-to-selected-row( 1 ) .
     3605   end.
     3606   END PROCEDURE.
     3607   PROCEDURE OpenBr :
     3608   define variable glog as logical no-undo .
     3609   run waitfram-show in this-procedure ( input "Ждите..." ).
     3610   if db-mode = "self" then do:
     3611     OPEN QUERY br-lst
     3612     FOR EACH X_scales-gds NO-LOCK where X_scales-gds.db-num = p-db-num,
     3613       FIRST X_bar-code WHERE
     3614             X_bar-code.b-code = X_scales-gds.b-code NO-LOCK,
     3615       FIRST X_goods WHERE
     3616             X_goods.gds-code = X_bar-code.gds-code NO-LOCK,
     3617       FIRST X_gds-obj-attr WHERE
     3618             X_gds-obj-attr.gds-code = X_bar-code.gds-code AND
     3619             X_gds-obj-attr.obj-type = X_scales-gds.obj-type AND
     3620             X_gds-obj-attr.obj-code = X_scales-gds.obj-code AND
     3621             X_gds-obj-attr.attr-code = 'scales-code':U NO-LOCK,
     3622       FIRST X_prod-bc WHERE
     3623             X_prod-bc.b-str = X_gds-obj-attr.attr-value NO-LOCK
     3624               BY X_scales-gds.b-code
     3625               BY X_scales-gds.scales-num.
     3626     if num-entries( rid-list ) = 0 then
     3627         HIDE mark-num in frame Dialog-Frame.
     3628     else
     3629         DISPLAY num-entries( rid-list ) @ mark-num with frame Dialog-Frame.
     3630     apply "entry" to br-lst in frame Dialog-Frame .
     3631     if num-results( "br-lst" ) > 0 then
     3632         assign
     3633             glog = br-lst:select-row( 1 )
     3634             glog = br-lst:scroll-to-selected-row( 1 ) .
     3635   end.
     3636   else do:
     3637     OPEN QUERY br-lst-db
     3638     FOR EACH X_scales-gds NO-LOCK where X_scales-gds.db-num = p-db-num,
     3639       FIRST X_bar-code WHERE
     3640             X_bar-code.b-code = X_scales-gds.b-code NO-LOCK,
     3641       FIRST X_goods WHERE
     3642             X_goods.gds-code = X_bar-code.gds-code NO-LOCK,
     3643       FIRST X_gds-obj-attr WHERE
     3644             X_gds-obj-attr.gds-code = X_bar-code.gds-code AND
     3645             X_gds-obj-attr.obj-type = X_scales-gds.obj-type AND
     3646             X_gds-obj-attr.obj-code = X_scales-gds.obj-code AND
     3647             X_gds-obj-attr.attr-code = 'scales-code':U NO-LOCK,
     3648       FIRST X_prod-bc-db no-lock WHERE
     3649             X_prod-bc-db.b-str = X_gds-obj-attr.attr-value
     3650        and  X_prod-bc-db.db-num = p-db-num OUTER-JOIN
     3651               BY X_scales-gds.b-code
     3652               BY X_scales-gds.scales-num.
     3653     if num-entries( rid-list ) = 0 then
     3654         HIDE mark-num in frame Dialog-Frame.
     3655     else
     3656         DISPLAY num-entries( rid-list ) @ mark-num with frame Dialog-Frame.
     3657     apply "entry" to br-lst-db in frame Dialog-Frame .
     3658     if num-results( "br-lst-db" ) > 0 then
     3659         assign
     3660             glog = br-lst-db:select-row( 1 )
     3661             glog = br-lst-db:scroll-to-selected-row( 1 ) .
     3662   end.
     3663   run waitfram-hide in this-procedure .
     3664   END PROCEDURE.
     3665   PROCEDURE reposition-goods :
     3666   define input  parameter p-direction   as character no-undo .
     3667   define output parameter p-recid as recid no-undo .
     3668   case db-mode:
     3669     when "self" then do:
     3670       case p-direction :
     3671         when "first":U
     3672         then do:
     3673           get first br-lst.
     3674         end.
     3675         when "last":U
     3676         then do:
     3677           get last br-lst.
     3678         end.
     3679         when "prev":U
     3680         then do:
     3681           get prev br-lst.
     3682           if not available X_scales-gds then do:
     3683             message
     3684             "Это первый товар списка"
     3685             view-as alert-box.
     3686           end.
     3687         end.
     3688         when "next":U
     3689         then do:
     3690           get next br-lst.
     3691           if not available X_scales-gds then do:
     3692             message
     3693             "Это последний товар списка"
     3694             view-as alert-box.
     3695           end.
     3696         end.
     3697       end case .
     3698     end.
     3699     otherwise  do:
     3700       case p-direction :
     3701         when "first":U
     3702         then do:
     3703           get first br-lst-db.
     3704         end.
     3705         when "last":U
     3706         then do:
     3707           get last br-lst-db.
     3708         end.
     3709         when "prev":U
     3710         then do:
     3711           get prev br-lst-db.
     3712           if not available X_scales-gds then do:
     3713             message
     3714             "Это первый товар списка"
     3715             view-as alert-box.
     3716           end.
     3717         end.
     3718         when "next":U
     3719         then do:
     3720           get next br-lst-db.
     3721           if not available X_scales-gds then do:
     3722             message
     3723             "Это последний товар списка"
     3724             view-as alert-box.
     3725           end.
     3726         end.
     3727       end case .
     3728     end.
     3729   end case.
     3730   assign
     3731   p-recid = recid(X_goods)
     3732   .
     3733   if db-mode = "self" then do:
     3734     run reposition-query in this-procedure
     3735       (input recid(X_scales-gds)
     3736       ).
     3737   end.
     3738   else do:
     3739     run reposition-query-db in this-procedure
     3740       (input recid(X_scales-gds)
     3741       ).
     3742   end.
     3743   END PROCEDURE.
     3744   PROCEDURE reposition-query :
     3745   define input parameter p-recid as recid no-undo .
     3746   if p-recid <> ?
     3747   then do:
     3748     reposition br-lst to recid p-recid no-error.
     3749   end.
     3750   do with frame Dialog-Frame:
     3751     apply "entry":u to browse br-lst .
     3752     apply "VALUE-CHANGED":u to browse br-lst .
     3753   end.
     3754   END PROCEDURE.
     3755   PROCEDURE reposition-query-db :
     3756   define input parameter p-recid as recid no-undo .
     3757   if p-recid <> ?
     3758   then do:
     3759     reposition br-lst-db to recid p-recid no-error.
     3760   end.
     3761   do with frame Dialog-Frame:
     3762     apply "entry":u to browse br-lst .
     3763     apply "VALUE-CHANGED":u to browse br-lst .
     3764   end.
     3765   END PROCEDURE.
     3766   FUNCTION get-scl-code RETURNS CHARACTER
     3767     (    INPUT p-b-code AS INTEGER
     3768        , INPUT p-b-str AS CHARACTER
     3769        , BUFFER buf_prod-bc-db FOR ub.prod-bc-db ) :
     3770   DEFINE BUFFER buf_prod-bc FOR ub.prod-bc.
     3771   IF AVAILABLE buf_prod-bc-db  THEN RETURN buf_prod-bc-db.b-str.
     3772   FIND FIRST buf_prod-bc NO-LOCK WHERE buf_prod-bc.b-code = p-b-code AND buf_prod-bc.b-str = p-b-str NO-ERROR.
     3773   IF AVAILABLE buf_prod-bc  THEN RETURN p-b-str.
     3774   RETURN chr(63).
     3775   END FUNCTION.
