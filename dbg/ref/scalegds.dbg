      577   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      578   procedure cur-time :
      579      define output parameter p-today as date      no-undo .
      580      define output parameter p-time  as integer   no-undo .
      581     do
      582     on error undo, return error
      583     :
      584       define variable v-date1 as date      no-undo .
      585       define variable v-date2 as date      no-undo .
      586       define variable v-time  as integer   no-undo .
      587       assign
      588         v-date1 = today
      589         v-time  = time
      590         v-date2 = today
      591       .
      592       if v-date1 <> v-date2
      593       then do:
      594         assign
      595           v-date1 = today
      596           v-time  = v-time
      597         .
      598       end.
      599       assign
      600         p-today = v-date1
      601         p-time  = v-time
      602       .
      603     end.
      604   end.
      605   function cur-time-date returns character
      606   :
      607     return string(today, '99/99/9999':U) .
      608   end.
      609   function cur-time-mjd returns decimal
      610   :
      611     define variable v-date as date      no-undo .
      612     define variable v-time as integer   no-undo .
      613     run cur-time in this-procedure
      614       (output v-date
      615       ,output v-time
      616       ) .
      617     return integer(v-date) - 2400002 + (v-time / 86400) .
      618   end.
      619   function cur-time-get-ending-index returns integer
      620   (input p-number as integer
      621   )
      622   :
      623     if p-number < 0
      624     or p-number = ?
      625     then do:
      626       return 1 .
      627     end.
      628     define variable v-rest as integer   no-undo .
      629     assign
      630       p-number = p-number modulo 100
      631     .
      632     if p-number < 20
      633     then do:
      634       assign
      635         v-rest = p-number
      636       .
      637     end.
      638     else do:
      639       assign
      640         v-rest = p-number modulo 10
      641       .
      642     end.
      643     case v-rest :
      644       when 1
      645       then do:
      646         return 2 .
      647       end.
      648       when 2 or
      649       when 3 or
      650       when 4
      651       then do:
      652         return 3 .
      653       end.
      654       otherwise do:
      655         return 1 .
      656       end.
      657     end case .
      658   end.
      659   procedure cur-time-mjd-to-date :
      660      define input  parameter i-mjd-diff as decimal no-undo.
      661      define output parameter o-Date     as date    no-undo.
      662      define output parameter o-Time     as integer no-undo.
      663      define variable v-day-number as integer   no-undo .
      664      if    i-mjd-diff < 0
      665         or i-mjd-diff = ?
      666      then do:
      667         return "?" .
      668      end.
      669      assign
      670         v-day-number = truncate(i-mjd-diff,0).
      671         o-Date = date(v-day-number + 2400002).
      672         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      673     .
      674   end.
      675   function cur-time-mjd-to-string returns character
      676   (input p-mjd-diff as decimal
      677   )
      678   :
      679     define variable v-day-number as integer   no-undo .
      680     define variable v-seconds    as integer   no-undo .
      681     define variable v-hour       as integer   no-undo .
      682     define variable v-min        as integer   no-undo .
      683     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      684     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      685     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      686     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      687     if p-mjd-diff < 0
      688     or p-mjd-diff = ?
      689     then do:
      690       return "?" .
      691     end.
      692     assign
      693       v-day-number = integer(truncate(p-mjd-diff,0))
      694       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      695     .
      696     if v-seconds > 86400
      697     then do:
      698       assign
      699         v-seconds = 86400 - 1
      700       .
      701     end.
      702     if v-seconds < 0
      703     then do:
      704       assign
      705         v-seconds = 0
      706       .
      707     end.
      708     assign
      709       v-hour = truncate(v-seconds / 3600, 0)
      710     .
      711     assign
      712       v-seconds = v-seconds modulo 3600
      713     .
      714     assign
      715       v-min = truncate(v-seconds / 60, 0)
      716     .
      717     assign
      718       v-seconds = v-seconds modulo 60
      719     .
      720     return
      721         (if v-day-number <> 0
      722           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      723           else ""
      724         )
      725       + (if v-day-number <> 0 or v-hour <> 0
      726           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      727           else ""
      728         )
      729       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      730           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      731           else ""
      732         )
      733       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      734       .
      735   end.
      736   function cur-time-string returns character
      737   :
      738     define variable v-date as date      no-undo .
      739     define variable v-time as integer   no-undo .
      740     run cur-time in this-procedure
      741       (output v-date
      742       ,output v-time
      743       ) .
      744     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      745   end.
      746   function cur-time-string-sec returns character
      747   :
      748     define variable v-date as date      no-undo .
      749     define variable v-time as integer   no-undo .
      750     run cur-time in this-procedure
      751       (output v-date
      752       ,output v-time
      753       ) .
      754     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      755   end.
      756   function cur-time-custom  returns character
      757   (input p-prefix as character
      758   ,input p-date-format as character
      759   ,input p-delimiter as character
      760   ,input p-time-format as character
      761   ,input p-suffix as character
      762   )
      763   :
      764     define variable v-date as date      no-undo .
      765     define variable v-time as integer   no-undo .
      766     run cur-time in this-procedure
      767       (output v-date
      768       ,output v-time
      769       ) .
      770     return
      771       p-prefix
      772       + string(v-date, p-date-format)
      773       + p-delimiter
      774       + string(v-time, p-time-format)
      775       + p-suffix
      776       .
      777   end.
      778   function cur-time-print  returns character
      779   :
      780     define variable v-date as date      no-undo .
      781     define variable v-time as integer   no-undo .
      782     run cur-time in this-procedure
      783       (output v-date
      784       ,output v-time
      785       ) .
      786     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      787   end.
      788   function cur-time-datetime returns datetime
      789   :
      790     define variable v-char as character no-undo .
      791     define variable v-datetime as datetime no-undo .
      792     v-char = cur-time-string().
      793     v-datetime = datetime(v-char).
      794     return  v-datetime.
      795   end.
      796   function cur-time-string-msec returns character
      797   :
      798     define variable v-date as datetime  no-undo .
      799     v-date = now.
      800     return string(v-date) .
      801   end.
      802   FUNCTION scl-gds-ld returns integer ( input p-raw-dead-line as integer, input p-sclin-ld as integer):
      803   define variable v-dead-line as integer no-undo .
      804   define variable v-dead-line-date as integer no-undo .
      805   DEFINE VARIABLE v-today as date no-undo .
      806   DEFINE VARIABLE v-time as integer no-undo .
      807   if p-sclin-ld > 0 then do:
      808     run cur-time in this-procedure ( output v-today, output v-time).
      809     assign
      810     v-dead-line = p-raw-dead-line / 24  + 01/01/2000 - v-today
      811     v-dead-line = if v-dead-line < 0 then 0 else v-dead-line
      812     .
      813   end.
      814   else v-dead-line = p-raw-dead-line.
      815   return v-dead-line .
      816   end.
      817   FUNCTION scl-gds-ld2 returns integer ( input p-deadline as integer
      818                                        , input p-deaddate as date
      819                                        , input p-deadflag as integer):
      820   define variable v-dead-line as integer no-undo .
      821   define variable v-dead-line-date as integer no-undo .
      822   DEFINE VARIABLE v-today as date no-undo .
      823   DEFINE VARIABLE v-time as integer no-undo .
      824   if p-deadflag > 0 then do:
      825     if p-deaddate = ? then return 0.
      826     run cur-time in this-procedure ( output v-today, output v-time).
      827     assign
      828     v-dead-line = p-deaddate - v-today + 1
      829     v-dead-line = if v-dead-line < 0 then 0 else v-dead-line
      830     .
      831   end.
      832   else v-dead-line = (if p-deadline = ? then 0 else p-deadline).
      833   return v-dead-line .
      834   end.
      835   FUNCTION scl-gds-ld-date returns date ( input p-raw-dead-line as integer, input p-sclin-ld as integer):
      836   define variable v-dead-line-date as date no-undo .
      837   DEFINE VARIABLE v-today as date no-undo .
      838   DEFINE VARIABLE v-time as integer no-undo .
      839   run cur-time in this-procedure ( output v-today, output v-time).
      840   if p-sclin-ld > 0 then do:
      841     if p-raw-dead-line > 0 then do:
      842       assign
      843       v-dead-line-date = p-raw-dead-line / 24  + 01/01/2000 - 1
      844       .
      845     end.
      846     else  do:
      847       assign
      848       v-dead-line-date = ?
      849       .
      850     end.
      851   end.
      852   else do:
      853     if p-raw-dead-line > 0 then do:
      854       assign
      855       v-dead-line-date = p-raw-dead-line  + v-today - 1
      856       .
      857     end.
      858     else do:
      859       assign
      860       v-dead-line-date = ?
      861       .
      862     end.
      863   end.
      864   return v-dead-line-date.
      865   end.
      866   FUNCTION scl-gds-ld-parts returns integer ( buffer buf_scales-gds for ub.scales-gds, input sclin-ld as integer):
      867   define buffer buf_gds-obj for ub.gds-obj.
      868   define buffer buf_bar-code for ub.bar-code.
      869   define buffer buf_parts for ub.parts .
      870   define buffer buf_goods for ub.goods.
      871   define variable v-last-date as date no-undo.
      872   find first buf_bar-code no-lock where
      873             buf_bar-code.b-code = buf_scales-gds.b-code no-error.
      874   if not available buf_bar-code then return ?.
      875   if sclin-ld > 0 then do:
      876     find first buf_gds-obj no-lock where
      877               buf_gds-obj.gds-code = buf_bar-code.gds-code
      878         and  buf_gds-obj.obj-type = buf_scales-gds.obj-type
      879         and  buf_gds-obj.obj-code = buf_scales-gds.obj-code no-error .
      880     if not available buf_gds-obj then return ?.
      881     _parts:
      882     for each buf_parts no-lock where
      883             buf_parts.obj-type  = buf_gds-obj.obj-type
      884         and buf_parts.obj-code  = buf_gds-obj.obj-code
      885         and buf_parts.artic     = buf_gds-obj.artic
      886         and buf_parts.prod-type = buf_gds-obj.prod-type
      887         and buf_parts.prod-code = buf_gds-obj.prod-code
      888         and buf_parts.out-code  = buf_gds-obj.in-code:
      889       if buf_parts.last-date = ? then next _parts.
      890       assign
      891       v-last-date = (if v-last-date = ?
      892                     or (v-last-date <> ?
      893                         and sclin-ld = 1
      894                         and v-last-date > buf_parts.last-date)
      895                     or (v-last-date <> ?
      896                         and sclin-ld = 2
      897                         and v-last-date < buf_parts.last-date)
      898                     then buf_parts.last-date
      899                     else v-last-date)
      900       .
      901     end.
      902     if v-last-date <> ? then do:
      903       return (v-last-date - 01/01/2000 + 1) * 24.
      904     end.
      905     else do:
      906       return 0.
      907     end.
      908   end.
      909   else do:
      910     find first buf_goods no-lock where
      911               buf_goods.gds-code = buf_bar-code.gds-code no-error.
      912     if available buf_goods then do:
      913       return buf_goods.deadline.
      914     end.
      915     else return 0.
      916   end.
      917   END FUNCTION.
      918   FUNCTION scl-gds-ld-parts-date returns date ( buffer buf_scales-gds for ub.scales-gds, input sclin-ld as integer):
      919   define buffer buf_gds-obj for ub.gds-obj.
      920   define buffer buf_bar-code for ub.bar-code.
      921   define buffer buf_parts for ub.parts .
      922   define buffer buf_goods for ub.goods.
      923   define variable v-last-date as date no-undo.
      924   DEFINE VARIABLE v-today as date no-undo .
      925   DEFINE VARIABLE v-time as integer no-undo .
      926   find first buf_bar-code no-lock where
      927             buf_bar-code.b-code = buf_scales-gds.b-code no-error.
      928   if not available buf_bar-code then return ?.
      929   if sclin-ld > 0 then do:
      930     find first buf_gds-obj no-lock where
      931               buf_gds-obj.gds-code = buf_bar-code.gds-code
      932         and  buf_gds-obj.obj-type = buf_scales-gds.obj-type
      933         and  buf_gds-obj.obj-code = buf_scales-gds.obj-code no-error .
      934     if not available buf_gds-obj then return ?.
      935     _parts:
      936     for each buf_parts no-lock where
      937             buf_parts.obj-type  = buf_gds-obj.obj-type
      938         and buf_parts.obj-code  = buf_gds-obj.obj-code
      939         and buf_parts.artic     = buf_gds-obj.artic
      940         and buf_parts.prod-type = buf_gds-obj.prod-type
      941         and buf_parts.prod-code = buf_gds-obj.prod-code
      942         and buf_parts.out-code  = buf_gds-obj.in-code:
      943       if buf_parts.last-date = ? then next _parts.
      944       assign
      945       v-last-date = (if v-last-date = ?
      946                     or (v-last-date <> ?
      947                         and sclin-ld = 1
      948                         and v-last-date > buf_parts.last-date)
      949                     or (v-last-date <> ?
      950                         and sclin-ld = 2
      951                         and v-last-date < buf_parts.last-date)
      952                     then buf_parts.last-date
      953                     else v-last-date)
      954       .
      955     end.
      956     if v-last-date <> ? then do:
      957       return v-last-date.
      958     end.
      959     else do:
      960       run cur-time in this-procedure ( output v-today, output v-time).
      961       return v-today.
      962     end.
      963   end.
      964   else do:
      965     run cur-time in this-procedure ( output v-today, output v-time).
      966     find first buf_goods no-lock where
      967               buf_goods.gds-code = buf_bar-code.gds-code no-error.
      968     if available buf_goods then do:
      969       return (v-today + buf_goods.deadline).
      970     end.
      971     else return v-today.
      972   end.
      973   END FUNCTION.
      974   FUNCTION scl-gds-ld-to-raw returns integer ( input p-dead-line as integer, input p-sclin-ld as integer):
      975   define variable v-dead-line as integer no-undo .
      976   define variable v-dead-line-date as integer no-undo .
      977   DEFINE VARIABLE v-today as date no-undo .
      978   DEFINE VARIABLE v-time as integer no-undo .
      979   run cur-time in this-procedure ( output v-today, output v-time).
      980   if p-sclin-ld > 0 then do:
      981     run cur-time in this-procedure ( output v-today, output v-time).
      982     if p-dead-line = 0 then do:
      983       assign
      984       v-dead-line = 0
      985       .
      986     end.
      987     else do:
      988       assign
      989       v-dead-line = (v-today + p-dead-line - 01/01/2000) * 24
      990       .
      991     end.
      992   end.
      993   else v-dead-line = p-dead-line.
      994   return v-dead-line.
      995   end.
      996   FUNCTION scl-gds-ld-to-date returns date ( input p-dead-line as integer):
      997   define variable v-dead-line as integer no-undo .
      998   define variable v-dead-line-date as integer no-undo .
      999   DEFINE VARIABLE v-today as date no-undo .
     1000   DEFINE VARIABLE v-time as integer no-undo .
     1001   run cur-time in this-procedure ( output v-today, output v-time).
     1002   return (v-today  + p-dead-line - 1).
     1003   end.
     1004   FUNCTION scl-gds-deadvalue returns character ( input p-deadline as integer
     1005                                                 ,input p-deaddate as date
     1006                                                 ,input p-deadflag as integer):
     1007   if p-deadflag = integer('0':U) then return string((if p-deadline = ? then 0 else p-deadline)).
     1008   else return string(p-deaddate, "99/99/9999").
     1009   end function.
     1010   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1011   define variable v-waitfram-action01         as character   no-undo .
     1012   define variable v-waitfram-action02         as character   no-undo .
     1013   define variable v-waitfram-action03         as character   no-undo .
     1014   define variable mWaitFramTextBeg            as character   no-undo.
     1015   define variable mWaitFramTextEnd            as character   no-undo.
     1016   define variable mWaitFramView               as logical     no-undo.
     1017   define variable mWaitProcEvent              as logical     no-undo init yes.
     1018   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1019   define variable mWaitFramStop               as logical     no-undo.
     1020   define variable mWaitFramStopUser           as logical     no-undo.
     1021   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1022   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1023   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1024   define button B-WaitFramStop auto-end-key
     1025        label "Стоп"
     1026        size 10 by 1 tooltip "Остоновить процесс".
     1027   define button B-viewProcInfo
     1028        label "Информация"
     1029        size 15 by 1 tooltip "Информация о процесс".
     1030   define frame waitfram
     1031     v-waitfram-action01 format "x(72)" no-label skip
     1032     v-waitfram-action02 format "x(72)" no-label skip
     1033     v-waitfram-action03 format "x(72)" no-label skip
     1034     B-viewProcInfo
     1035     B-WaitFramStop at row 4 col 30
     1036     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1037     .
     1038   define new global shared variable mBatchMode as logical no-undo init ?.
     1039   define variable mFramBachModHandle as handle no-undo.
     1040   mFramBachModHandle = frame waitfram:handle.
     1041   define variable mFameOldVis as logical no-undo.
     1042   define variable mVisCUrentVin as logical no-undo.
     1043   if session:batch-mode
     1044   then
     1045      mBatchMode = yes.
     1046   if mBatchMode = ? then do:
     1047     mVisCUrentVin = current-window:visible.
     1048     mFameOldVis = mFramBachModHandle:visible.
     1049     mFramBachModHandle:visible  = yes.
     1050     mBatchMode = mFramBachModHandle:visible ne yes.
     1051     mFramBachModHandle:visible = mFameOldVis.
     1052     current-window:visible = mVisCUrentVin.
     1053   end.
     1054    if  log-manager:logfile-name ne ?
     1055     then DO:
     1056         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1057         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1058         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1059     end.
     1060   on choose of B-WaitFramStop in frame waitfram
     1061   do:
     1062     mWaitFramStop = yes.
     1063     mWaitFramStopUser = yes.
     1064   end.
     1065   function waitfram-check-timeout returns logical():
     1066      define variable vtime as int64 no-undo.
     1067      if mWaitFramStopTimeOut
     1068      then
     1069         return yes.
     1070      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1071      if     mWaitFramTimeOut ne ?
     1072         and mWaitFramTimeOut ne 0
     1073         and mWaitFramTimeOut lt vtime
     1074      then do:
     1075         mWaitFramStopTimeOut = yes.
     1076      end.
     1077      return mWaitFramStopTimeOut.
     1078   end.
     1079   procedure waitfram-hide :
     1080     if not session:batch-mode
     1081     then do
     1082     on error undo, return error return-value
     1083     :
     1084       pause 0 before-hide .
     1085       if not mBatchMode then
     1086         hide frame waitfram .
     1087     if     not mWaitFramView
     1088        and mWaitProcEvent
     1089     then
     1090       process events .
     1091     end.
     1092   end procedure.
     1093   procedure waitfram-show :
     1094     define input  parameter p-message as character no-undo .
     1095     define variable v-left-margin as integer   no-undo .
     1096     if not session:batch-mode
     1097     then do
     1098     on error undo, return error return-value
     1099     :
     1100       if length(p-message) <= 70 then do:
     1101         assign
     1102           v-left-margin = integer((70 - length(p-message)) / 2)
     1103         .
     1104         assign
     1105           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1106         .
     1107         assign
     1108           v-waitfram-action01 = " "
     1109           v-waitfram-action02 = " "
     1110                                    + fill(" ", v-left-margin)
     1111                                    + p-message
     1112           v-waitfram-action03 = " "
     1113         .
     1114       end.
     1115       else do:
     1116         define variable vRindex1 as integer no-undo.
     1117         define variable vRindex2 as integer no-undo.
     1118         vRindex1 = r-index(p-message," ",70).
     1119         if vRindex1 = 0
     1120         then
     1121            vRindex1 = 70.
     1122         if length(p-message)  <= vRindex1 + 70 then do:
     1123           assign
     1124             v-waitfram-action01 = " "
     1125             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1126             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1127           .
     1128         end.
     1129         else do:
     1130           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1131           if vRindex2 <= vRindex1
     1132           then
     1133              vRindex2 = vRindex1 + 70.
     1134           assign
     1135             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1136             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1137             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1138           .
     1139         end.
     1140       end.
     1141       B-viewProcInfo:visible   in frame waitfram = no.
     1142       B-viewProcInfo:sensitive in frame waitfram = no.
     1143       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1144       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1145       if  (   mWaitFramView
     1146          or  mWaitProcEvent)
     1147          and not mBatchMode
     1148       then
     1149          display
     1150             v-waitfram-action01 skip
     1151             v-waitfram-action02 skip
     1152             v-waitfram-action03 skip
     1153          with frame waitfram .
     1154       if     mWaitFramView
     1155          then do:
     1156             if     mWaitFramInterval ne ?
     1157                and not mBatchMode
     1158             then
     1159                wait-for go of frame waitfram pause mWaitFramInterval.
     1160          end.
     1161          else
     1162             if     mWaitProcEvent
     1163                and not mBatchMode
     1164             then
     1165                process events .
     1166     end.
     1167   end procedure.
     1168      procedure waitfram-show-this:
     1169         define input  parameter iInterval as int64 no-undo.
     1170         define variable vtime as int64 no-undo.
     1171         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1172         mWaitFramInterval = iInterval.
     1173         run waitfram-show (substitute("&1&2 &3&4" ,
     1174                                       mWaitFramTextBeg ,
     1175                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1176                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1177                                       mWaitFramTextEnd
     1178                                      )
     1179                           ).
     1180      end.
     1181      procedure WaitFramRunPause:
     1182         define input  parameter iInterval as dec no-undo.
     1183         define variable vStart  as datetime-tz no-undo.
     1184         define variable vend    as datetime-tz no-undo.
     1185         define variable vint as int64 no-undo.
     1186         define variable vOk as logical no-undo.
     1187         vStart = now.
     1188         vend   = vStart.
     1189         publish "WaitFramPause" (iInterval,output vOk).
     1190         vend   =  now.
     1191         vint = vend - vStart.
     1192         vint = iInterval - vint / 1000.
     1193         if     not mWaitFramStop
     1194            and (   vint > 0
     1195                 or (    not vOk
     1196                     and iInterval eq ?
     1197                     )
     1198                 )
     1199         then
     1200            run waitfram-show-this (iInterval).
     1201         vend   =  now.
     1202         vint = vend - vStart.
     1203         vint = iInterval - vint / 1000.
     1204         if     not mWaitFramStop
     1205            and vint > 0
     1206         then do:
     1207            run gbl/pause.p (vint * 1000).
     1208         end.
     1209         if iInterval ne ?
     1210         then
     1211            publish "WaitFramStop".
     1212         waitfram-check-timeout().
     1213      end.
     1214      procedure WaitFramWaitFor:
     1215         define input  parameter iInterval as dec no-undo.
     1216         assign
     1217            mWaitFramStartProc   = now
     1218            mWaitFramStopUser    = no
     1219            mWaitFramStopTimeOut = no
     1220         .
     1221         block-wait:
     1222         do while not mWaitFramStop:
     1223            run WaitFramRunPause (iInterval).
     1224            if  waitfram-check-timeout()
     1225            then do:
     1226               leave block-wait.
     1227            end.
     1228         end.
     1229         run waitfram-hide.
     1230      end.
     1231   procedure waitfram-join :
     1232     define input  parameter p-line-1  as character no-undo .
     1233     define input  parameter p-line-2  as character no-undo .
     1234     define input  parameter p-line-3  as character no-undo .
     1235     define output parameter p-message as character no-undo .
     1236     do
     1237     on error undo, return error return-value
     1238     :
     1239       assign
     1240         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1241                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1242                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1243       .
     1244     end.
     1245   end procedure.
     1246   function waitfram-join-function returns character
     1247     (input p-line-1 as character
     1248     ,input p-line-2 as character
     1249     ,input p-line-3 as character
     1250     ).
     1251     define variable v-message as character no-undo .
     1252     run waitfram-join in this-procedure
     1253       (input  p-line-1
     1254       ,input  p-line-2
     1255       ,input  p-line-3
     1256       ,output v-message
     1257       ) .
     1258     return v-message .
     1259   end function .
