     2630     define variable v-window-width         as decimal   no-undo .
     2631     define variable v-window-virtual-width as decimal   no-undo .
     2632     define variable v-change-sign          as integer   no-undo .
     2633     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2634     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2635     if p-change-value > 0
     2636     then do:
     2637       if frame Dialog-Frame :width + p-change-value >
     2638           session :width-chars
     2639       then do:
     2640         assign
     2641           p-change-value = session :width-chars - frame Dialog-Frame :width
     2642         .
     2643         if p-change-value <= 0
     2644         then do:
     2645           run diasize_position-resize-button in this-procedure .
     2646           return .
     2647         end.
     2648       end.
     2649     end.
     2650     if p-change-value < 0
     2651     then do:
     2652       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2653       then do:
     2654         assign
     2655           p-change-value = v-diasize-orig-frame-width
     2656                          - frame Dialog-Frame :width
     2657         .
     2658         if p-change-value >= 0
     2659         then do:
     2660           run diasize_position-resize-button in this-procedure .
     2661           return .
     2662         end.
     2663       end.
     2664     end.
     2665     if p-change-value >= 0
     2666     then do:
     2667       assign
     2668         v-change-sign = 1
     2669       .
     2670     end.
     2671     else do:
     2672       assign
     2673         v-change-sign = -1
     2674       .
     2675     end.
     2676     assign
     2677       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2678     .
     2679     if p-change-value = 0
     2680     then do:
     2681       run diasize_position-resize-button in this-procedure .
     2682       return .
     2683     end.
