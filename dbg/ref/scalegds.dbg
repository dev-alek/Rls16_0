      566   define new global shared variable g#libbcrcn as handle no-undo .
      567   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      568     define variable v-cntxt-db-num        as integer   no-undo .
      569     define variable v-cntxt-userid        as character no-undo .
      570     define variable v-cntxt-level         as character no-undo .
      571     define variable v-cntxt-host-code-obj as integer   no-undo .
      572     define variable v-cntxt-obj-type      as character no-undo .
      573     define variable v-cntxt-obj-code      as integer   no-undo .
      574     define variable v-cntxt-db-num-obj    as integer   no-undo .
