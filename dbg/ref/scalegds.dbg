     2610   procedure diasize_set-height :
     2611     define input  parameter p-new-height  as decimal   no-undo .
     2612     define input  parameter p-move-resize as logical   no-undo .
     2613     do
     2614     on error undo, return error return-value
     2615     :
     2616       run diasize_change-height in this-procedure
     2617         (input  (p-new-height - frame Dialog-Frame :height)
     2618         ,input  p-move-resize
     2619         ) .
     2620     end.
     2621   end procedure.
     2622   procedure diasize_change-width :
     2623     define input  parameter p-change-value as decimal   no-undo .
     2624     define input  parameter p-move-resize  as logical   no-undo .
     2625     define variable v-field-group-handle   as handle    no-undo .
     2626     define variable v-object-handle        as handle    no-undo .
