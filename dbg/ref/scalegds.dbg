     1386   DEFINE FRAME Dialog-Frame
     1387        Btn_OUT AT ROW 1 COL 1
     1388        b-mark AT ROW 1 COL 11
     1389        b-ticket AT ROW 1 COL 24
     1390        b-hist AT ROW 1 COL 92
     1391        b-help AT ROW 1 COL 95
     1392        a-n-c AT ROW 3.17 COL 12.5 NO-LABEL
     1393        loc-art AT ROW 3.17 COL 69.8 COLON-ALIGNED
     1394        loc-name AT ROW 3.17 COL 69.8 COLON-ALIGNED
     1395        loc-code AT ROW 3.17 COL 69.8 COLON-ALIGNED
     1396        br-lst-db AT ROW 5 COL 1 WIDGET-ID 100
     1397        br-lst AT ROW 5 COL 1
     1398        mark-num AT ROW 1 COL 12 COLON-ALIGNED NO-LABEL
     1399        "Поиск :" VIEW-AS TEXT
     1400             SIZE 7.9 BY 1 AT ROW 3.17 COL 4
     1401             BGCOLOR 8 FGCOLOR 0
     1402        SPACE(87.29) SKIP(19.45)
     1403       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1404            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1405            BGCOLOR 8 FGCOLOR 0
     1406            TITLE "ВСЕ товары на ВСЕХ весах".
     1407   ASSIGN
     1408          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1409          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1410   ASSIGN
     1411          br-lst:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 1.
     1412   ASSIGN
     1413          br-lst-db:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 1.
     1414   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1415   DO:
     1416     APPLY "END-ERROR":U TO SELF.
     1417   END.
     1418   ON CHOOSE OF b-hist IN FRAME Dialog-Frame
     1419   DO:
     1420   define variable rid-list as character no-undo .
     1421   if available X_scales-gds THEN
     1422   run ref/cscalgds.w (
     1423                         input parparentproc
     1424                       , INPUT "":U
     1425                       , INPUT "one":U
     1426                       , OUTPUT  rid-list
     1427                       , INPUT X_scales-gds.db-num
     1428                       , input X_scales-gds.scales-num
     1429                       , input X_scales-gds.plu-code
     1430                       ).
     1431   if db-mode = "self" then do:
     1432     apply "entry" to br-lst.
     1433   end.
     1434   else do:
     1435     apply "entry" to br-lst-db.
     1436   end.
     1437   END.
     1438   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     1439   DO:
     1440   define variable glog as logical no-undo .
     1441     if available X_scales-gds then  do:
     1442   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1443   define variable v-str-recid12 as character no-undo .
     1444   define variable v-num-entry12 as integer   no-undo .
     1445   assign
     1446     v-str-recid12 = trim( string( recid( X_scales-gds ) , "->>>>>>>>>>>9":U ) )
     1447     v-num-entry12 = lookup( v-str-recid12 , rid-list )
     1448   .
     1449   if v-num-entry12 > 0 then do:
     1450     assign
     1451       entry( v-num-entry12, rid-list ) = "":U
     1452       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1453     .
     1454   end.
     1455   else do:
     1456     assign
     1457       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid12
     1458     .
     1459   end.
     1460       if db-mode = "self" then do:
     1461         glog = br-lst:refresh() .
     1462         if last-event:function <> "MOUSE-SELECT-DBLCLICK" then  do:
     1463           glog = br-lst:select-next-row ().
     1464           apply "iteration-changed" to br-lst in frame Dialog-Frame.
     1465         end.
     1466         if num-entries( rid-list ) = 0 then
     1467             hide mark-num in frame Dialog-Frame.
     1468         else
     1469             disp num-entries( rid-list ) @ mark-num with frame Dialog-Frame.
     1470         apply "entry" to br-lst in frame Dialog-Frame.
     1471       end.
     1472       else do:
     1473         glog = br-lst-db:refresh() .
     1474         if last-event:function <> "MOUSE-SELECT-DBLCLICK" then  do:
     1475           glog = br-lst-db:select-next-row ().
     1476           apply "iteration-changed" to br-lst-db in frame Dialog-Frame.
     1477         end.
     1478         if num-entries( rid-list ) = 0 then
     1479             hide mark-num in frame Dialog-Frame.
     1480         else
     1481             disp num-entries( rid-list ) @ mark-num with frame Dialog-Frame.
     1482         apply "entry" to br-lst-db in frame Dialog-Frame.
     1483       end.
     1484     end.
     1485   END.
     1486   ON CHOOSE OF b-ticket IN FRAME Dialog-Frame
     1487   DO:
     1488       if available X_scales-gds then  do:
     1489         if rid-list = "" then
     1490             run rep/tick-scl.p (
     1491                            input parparentproc
     1492                           ,input p-obj-type
     1493                           ,input p-obj-code
     1494                           ,input recid( X_bar-code )
     1495                           ,input X_scales-gds.db-num
     1496                           ,input X_scales-gds.scales-num
     1497                           ,input "" ) .
     1498         else
     1499             run rep/tick-scl.p (
     1500                              input parparentproc
     1501                             ,input p-obj-type
     1502                             ,input p-obj-code
     1503                             ,input ?
     1504                             ,input ?
     1505                             ,input ?
     1506                             ,input rid-list ) .
     1507         rid-list = "" .
     1508         RUN OpenBr  in this-procedure .
     1509       end.
     1510     if db-mode = "self" then do:
     1511       apply "entry" to br-lst in frame Dialog-Frame.
     1512     end.
     1513     else do:
     1514       apply "entry" to br-lst-db in frame Dialog-Frame.
     1515     end.
     1516   END.
     1517   ON INSERT OF br-lst IN FRAME Dialog-Frame
     1518   DO:
     1519       apply "CHOOSE" to b-mark in frame Dialog-Frame .
     1520   END.
     1521   ON MOUSE-SELECT-DBLCLICK OF br-lst IN FRAME Dialog-Frame
     1522   DO:
     1523    define variable v-gds-rec as recid no-undo .
     1524       if available X_scales-gds then do:
     1525         v-gds-rec = recid(X_goods).
     1526         run ref/gds-form.w ( input parparentproc
     1527                            , input 'ПРОСМОТР':U
     1528                            , input X_scales-gds.obj-type
     1529                            , input X_scales-gds.obj-code
     1530                            , input this-procedure:handle
     1531                            , input-output v-gds-rec).
     1532       end.
     1533       apply "entry" to br-lst in frame Dialog-Frame .
     1534   END.
     1535   ON RETURN OF br-lst IN FRAME Dialog-Frame
     1536   DO:
     1537   define variable v-gds-rec as recid no-undo .
     1538       if available X_scales-gds then do:
     1539         v-gds-rec = recid(X_goods).
     1540         run ref/gds-form.w (
     1541                              input parparentproc
     1542                            , input 'ПРОСМОТР':U
     1543                            , input X_scales-gds.obj-type
     1544                            , input X_scales-gds.obj-code
     1545                            , input this-procedure:handle
     1546                            , input-output gds-rec).
     1547       end.
     1548       apply "entry" to br-lst in frame Dialog-Frame .
     1549   END.
     1550   ON INSERT OF br-lst-db IN FRAME Dialog-Frame
     1551   DO:
     1552       apply "CHOOSE" to b-mark in frame Dialog-Frame .
     1553   END.
     1554   ON MOUSE-SELECT-DBLCLICK OF br-lst-db IN FRAME Dialog-Frame
     1555   DO:
     1556    define variable v-gds-rec as recid no-undo .
     1557       if available X_scales-gds then do:
     1558         v-gds-rec = recid(ub.goods).
     1559         run ref/gds-form.w ( input parparentproc
     1560                            , input 'ПРОСМОТР':U
     1561                            , input X_scales-gds.obj-type
     1562                            , input X_scales-gds.obj-code
     1563                            , input this-procedure:handle
     1564                            , input-output v-gds-rec).
     1565       end.
     1566       apply "entry" to br-lst-db in frame Dialog-Frame .
     1567   END.
     1568   ON RETURN OF br-lst-db IN FRAME Dialog-Frame
     1569   DO:
     1570   define variable v-gds-rec as recid no-undo .
     1571     if available X_scales-gds then do:
     1572       v-gds-rec = recid(X_goods).
     1573       run ref/gds-form.w (
     1574                             input parparentproc
     1575                           , input 'ПРОСМОТР':U
     1576                           , input X_scales-gds.obj-type
     1577                           , input X_scales-gds.obj-code
     1578                           , input this-procedure:handle
     1579                           , input-output gds-rec).
     1580     end.
     1581     apply "entry" to br-lst-db in frame Dialog-Frame .
     1582   END.
     1583   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1584   on value-changed of a-n-c in frame Dialog-Frame do:
     1585     case input frame Dialog-Frame a-n-c :
     1586       when "art" then do:
     1587        if db-mode = "self" then do:
     1588         apply "entry" to br-lst in frame Dialog-Frame.
     1589        end.
     1590        else do:
     1591          apply "entry" to br-lst-db in frame Dialog-Frame.
     1592        end.
     1593         hide loc-name loc-code in frame Dialog-Frame.
     1594         loc-art = "".
     1595       end.
     1596       when "name" then do:
     1597         enable loc-name with frame Dialog-Frame.
     1598         disp loc-name with frame Dialog-Frame.
     1599         hide loc-art loc-code in frame Dialog-Frame.
     1600         apply "entry" to loc-name in frame Dialog-Frame.
     1601       end.
     1602       when "code" then do:
     1603         enable loc-code with frame Dialog-Frame.
     1604         loc-code:label = "Бар-код (весь)".
     1605         disp loc-code with frame Dialog-Frame.
     1606         hide loc-art loc-name in frame Dialog-Frame.
     1607         apply "entry" to loc-code in frame Dialog-Frame.
     1608       end.
     1609       when "ves" then do:
     1610         enable loc-code with frame Dialog-Frame.
     1611         loc-code:label = "Вес. код".
     1612         disp loc-code with frame Dialog-Frame.
     1613         hide loc-art loc-name in frame Dialog-Frame.
     1614         apply "entry" to loc-code in frame Dialog-Frame.
     1615       end.
     1616       when "PLU" then do:
     1617         enable loc-code with frame Dialog-Frame.
     1618         loc-code:label = "PLU".
     1619         disp loc-code with frame Dialog-Frame.
     1620         hide loc-art loc-name in frame Dialog-Frame.
     1621         apply "entry" to loc-code in frame Dialog-Frame.
     1622       end.
     1623       when "shtrih" then do:
     1624         enable loc-code with frame Dialog-Frame.
     1625         loc-code:label = "Штрих.код".
     1626         disp loc-code with frame Dialog-Frame.
     1627         hide loc-art loc-name in frame Dialog-Frame.
     1628         apply "entry" to loc-code in frame Dialog-Frame.
     1629       end.
     1630     end.
     1631   end.
     1632   on any-printable of br-lst in frame Dialog-Frame,
     1633                       br-lst-db in frame Dialog-Frame
     1634     do:
     1635     if input frame Dialog-Frame a-n-c = "art" then do:
     1636       if last-event:label = " " and loc-art = "" then return no-apply.
     1637       if db-mode = "self" then do:
     1638         FOR EACH l-scales-gds WHERE l-scales-gds.db-num = p-db-num NO-LOCK ,
     1639                             FIRST l-bar-code WHERE
     1640                                   l-bar-code.b-code = l-scales-gds.b-code NO-LOCK,
     1641                             FIRST l-goods NO-LOCK WHERE
     1642                                   l-goods.gds-code = l-bar-code.gds-code AND
     1643                                   l-goods.artic begins (loc-art + last-event:label),
     1644                             FIRST l-gds-obj-attr WHERE
     1645                                   l-gds-obj-attr.gds-code = l-bar-code.gds-code AND
     1646                                   l-gds-obj-attr.attr-code = 'scales-code':U No-LOCK,
     1647                             FIRST l-prod-bc WHERE
     1648                                   l-prod-bc.b-str = l-gds-obj-attr.attr-value NO-LOCK
     1649                           BY l-scales-gds.db-num
     1650                           BY l-scales-gds.scales-num
     1651                           BY l-scales-gds.plu-code:
     1652                           LEAVE.
     1653         END.
     1654       end.
     1655       else do:
     1656         FOR EACH l-scales-gds WHERE l-scales-gds.db-num = p-db-num NO-LOCK ,
     1657                             FIRST l-bar-code WHERE
     1658                                   l-bar-code.b-code = l-scales-gds.b-code NO-LOCK,
     1659                             FIRST l-goods NO-LOCK WHERE
     1660                                   l-goods.gds-code = l-bar-code.gds-code AND
     1661                                   l-goods.artic begins (loc-art + last-event:label),
     1662                             FIRST l-gds-obj-attr WHERE
     1663                                   l-gds-obj-attr.gds-code = l-bar-code.gds-code AND
     1664               l-gds-obj-attr.attr-code = 'scales-code':U No-LOCK
     1665                           BY l-scales-gds.db-num
     1666                           BY l-scales-gds.scales-num
     1667                           BY l-scales-gds.plu-code:
     1668             find  FIRST l-prod-bc-db no-lock WHERE
     1669                   l-prod-bc-db.b-str = l-gds-obj-attr.attr-value
     1670               and l-prod-bc-db.db-num = l-scales-gds.db-num no-error.
     1671           if not available l-prod-bc-db then do:
     1672             find first l-prod-bc no-lock where
     1673                       l-prod-bc.b-code = l-bar-code.b-code
     1674                   and l-prod-bc.b-str = l-gds-obj-attr.attr-value no-error.
     1675             if not available l-prod-bc then next.
     1676           end.
     1677                           LEAVE.
     1678         END.
     1679       end.
     1680       if avail l-scales-gds then do:
     1681         loc-art = loc-art + last-event:label.
     1682         disp loc-art with frame Dialog-Frame.
     1683         line-rec = recid (l-scales-gds).
     1684         if db-mode = "self" then do:
     1685         reposition br-lst to recid line-rec no-error.
     1686         end.
     1687         else do:
     1688           reposition br-lst-db to recid line-rec no-error.
     1689         end.
     1690       end.
     1691       else do:
     1692         bell.
     1693       end.
     1694     end.
     1695   end.
     1696   on backspace of br-lst in frame Dialog-Frame,
     1697                   br-lst-db in frame Dialog-Frame
     1698   do:
     1699     if input frame Dialog-Frame a-n-c = "art" then do:
     1700       if loc-art = "" then return no-apply.
     1701       loc-art = substr (loc-art, 1, length (loc-art) - 1).
     1702       if db-mode = "self" then do:
     1703         FOR EACH l-scales-gds WHERE l-scales-gds.db-num = p-db-num NO-LOCK,
     1704                             FIRST l-bar-code WHERE
     1705                                   l-bar-code.b-code = l-scales-gds.b-code NO-LOCK,
     1706                             FIRST l-goods WHERE
     1707                                   l-goods.gds-code = l-bar-code.gds-code AND
     1708                                   l-goods.artic begins loc-art NO-LOCK,
     1709                             FIRST l-gds-obj-attr WHERE
     1710                                   l-gds-obj-attr.gds-code = l-bar-code.gds-code AND
     1711                                   l-gds-obj-attr.attr-code = 'scales-code':U No-LOCK,
     1712                             FIRST l-prod-bc WHERE
     1713                                   l-prod-bc.b-str = l-gds-obj-attr.attr-value NO-LOCK
     1714                           BY l-scales-gds.db-num
     1715                           BY l-scales-gds.scales-num
     1716                           BY l-scales-gds.plu-code:
     1717                           LEAVE.
     1718         END.
     1719       end.
     1720       else do:
     1721         FOR EACH l-scales-gds WHERE l-scales-gds.db-num = p-db-num NO-LOCK,
     1722                             FIRST l-bar-code WHERE
     1723                                   l-bar-code.b-code = l-scales-gds.b-code NO-LOCK,
     1724                             FIRST l-goods WHERE
     1725                                   l-goods.gds-code = l-bar-code.gds-code AND
     1726                                   l-goods.artic begins loc-art NO-LOCK,
     1727                             FIRST l-gds-obj-attr WHERE
     1728                                   l-gds-obj-attr.gds-code = l-bar-code.gds-code AND
     1729                                   l-gds-obj-attr.attr-code = 'scales-code':U No-LOCK
     1730                           BY l-scales-gds.db-num
     1731                           BY l-scales-gds.scales-num
     1732                           BY l-scales-gds.plu-code:
     1733           find  FIRST l-prod-bc-db no-lock WHERE
     1734                 l-prod-bc-db.b-str = l-gds-obj-attr.attr-value
     1735             and l-prod-bc-db.db-num = l-scales-gds.db-num no-error.
     1736           if not available l-prod-bc-db then do:
     1737             find first l-prod-bc no-lock where
     1738                       l-prod-bc.b-code = l-bar-code.b-code
     1739                   and l-prod-bc.b-str = l-gds-obj-attr.attr-value no-error.
     1740             if not available l-prod-bc then next.
     1741           end.
     1742                           LEAVE.
     1743         END.
     1744       end.
     1745       display
     1746       loc-art with frame Dialog-Frame.
     1747       line-rec = recid (l-scales-gds).
     1748       if db-mode = "self" then do:
     1749       reposition br-lst to recid line-rec no-error.
     1750       end.
     1751       else do:
     1752         reposition br-lst-db to recid line-rec no-error.
     1753       end.
     1754     end.
     1755   end.
     1756   ON MOUSE-SELECT-DBLCLICK, return OF loc-code IN FRAME Dialog-Frame do:
     1757   define variable str-code    as integer           no-undo.
     1758   define variable r-bar-code  like ub.bar-code.b-code no-undo.
     1759   define variable varresult   as character         no-undo.
     1760   define variable vartype-bc  as character         no-undo.
     1761   define variable varweight   as decimal           no-undo.
     1762     assign loc-code a-n-c.
     1763     case a-n-c:
     1764       when "code" or when "shtrih"  then do:
     1765   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     1766   (
     1767    input  parparentproc
     1768   ,input  loc-code
     1769   ,input  ?
     1770   ,input  p-obj-type
     1771   ,input  p-obj-code
     1772   ,input  yes
     1773   ,input  no
     1774   ,input  varscales-pref
     1775   ,input  varpgscales-pref
     1776   ,output varresult
     1777   ,output vartype-bc
     1778   ,output varweight
     1779   ,buffer l-bar-code
     1780   ,buffer ub.prod-bc
     1781   ,buffer ub.place
     1782   ) no-error.
     1783        if error-status:error then do:
     1784          message "Ошибка при разборе бар-кода".
     1785          return no-apply.
     1786        end.
     1787        IF AVAIl l-bar-code then do:
     1788   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1789     (input  l-bar-code.gds-code
     1790     ,input  ?
     1791     ,output r-bar-code
     1792     ) no-error .
     1793           if error-status:error then do:
     1794              message "Бар-код не найден.".
     1795             return no-apply.
     1796           end.
     1797           if db-mode = "self" then do:
     1798             FOR EACH l-scales-gds WHERE l-scales-gds.db-num = p-db-num NO-LOCK,
     1799                 FIRST l-bar-code WHERE
     1800                       l-bar-code.b-code = l-scales-gds.b-code AND
     1801                       l-bar-code.b-code = integer (r-bar-code) NO-LOCK,
     1802                 FIRST l-gds-obj-attr WHERE
     1803                       l-gds-obj-attr.gds-code = l-bar-code.gds-code AND
     1804                       l-gds-obj-attr.attr-code = 'scales-code':U No-LOCK,
     1805                 FIRST l-prod-bc WHERE
     1806                       l-prod-bc.b-str = l-gds-obj-attr.attr-value NO-LOCK
     1807                 BY l-scales-gds.db-num
     1808                 BY l-scales-gds.scales-num
     1809                 BY l-scales-gds.plu-code:
     1810                 LEAVE.
     1811            END.
     1812          end.
     1813          else do:
     1814             FOR EACH l-scales-gds WHERE l-scales-gds.db-num = p-db-num NO-LOCK,
     1815                 FIRST l-bar-code WHERE
     1816                       l-bar-code.b-code = l-scales-gds.b-code AND
     1817                       l-bar-code.b-code = integer (r-bar-code) NO-LOCK,
     1818                 FIRST l-gds-obj-attr WHERE
     1819                       l-gds-obj-attr.gds-code = l-bar-code.gds-code AND
     1820                       l-gds-obj-attr.attr-code = 'scales-code':U No-LOCK
     1821                 BY l-scales-gds.db-num
     1822                 BY l-scales-gds.scales-num
     1823                 BY l-scales-gds.plu-code:
     1824             find  FIRST l-prod-bc-db no-lock WHERE
     1825                   l-prod-bc-db.b-str = l-gds-obj-attr.attr-value
     1826               and l-prod-bc-db.db-num = l-scales-gds.db-num no-error.
     1827             if not available l-prod-bc-db then do:
     1828               find first l-prod-bc no-lock where
     1829                         l-prod-bc.b-code = l-bar-code.b-code
     1830                     and l-prod-bc.b-str = l-gds-obj-attr.attr-value no-error.
     1831               if not available l-prod-bc then next.
     1832             end.
     1833                 LEAVE.
     1834            END.
     1835          end.
     1836          if avail l-scales-gds then do:
     1837            line-rec = recid (l-scales-gds).
     1838            if db-mode = "self" then do:
     1839            reposition br-lst to recid line-rec no-error.
     1840            end.
     1841            else do:
     1842              reposition br-lst-db to recid line-rec no-error.
     1843            end.
     1844           end.
     1845           else do:
     1846             message "Строка не найдена.".
     1847           end.
     1848         end.
     1849         else DO:
     1850            message "Бар-код не найден.".
     1851         end.
     1852       end.
     1853       when "ves" then do:
     1854         if db-mode = "self" then do:
     1855           FIND FIRST l-prod-bc WHERE l-prod-bc.b-str = string(integer(loc-code), "99999") NO-LOCK No-ERROR.
     1856           IF AVAIl l-prod-bc then do:
     1857               FOR EACH l-scales-gds WHERE l-scales-gds.db-num = p-db-num NO-LOCK,
     1858                               FIRST l-prod-bc WHERE
     1859                                     l-prod-bc.b-code = l-scales-gds.b-code AND
     1860                                     l-prod-bc.bc-on = TRUE AND
     1861                                     l-prod-bc.b-str = string(integer(loc-code), "99999") NO-LOCK,
     1862                               FIRST l-bar-code WHERE
     1863                                     l-bar-code.b-code = l-scales-gds.b-code NO-LOCK,
     1864                               FIRST l-goods WHERE
     1865                                     l-goods.gds-code = l-bar-code.gds-code NO-LOCK
     1866                             BY l-scales-gds.db-num
     1867                             BY l-scales-gds.scales-num
     1868                             BY l-scales-gds.plu-code:
     1869                   LEAVE.
     1870           END.
     1871           if avail l-scales-gds then do:
     1872               line-rec = recid (l-scales-gds).
     1873               if db-mode = "self" then do:
     1874               reposition br-lst to recid line-rec no-error.
     1875               end.
     1876               else do:
     1877                 reposition br-lst-db to recid line-rec no-error.
     1878               end.
     1879             end.
     1880             else message "Строка не найдена.".
     1881           end.
     1882           else do:
     1883             message "Весовой код не найден.".
     1884           end.
     1885         end.
     1886         else do:
     1887           FIND FIRST l-prod-bc-db WHERE
     1888                  l-prod-bc-db.b-str = string(integer(loc-code), "99999")
     1889              and l-prod-bc-db.db-num = p-db-num  NO-LOCK No-ERROR.
     1890           IF AVAIl l-prod-bc-db then do:
     1891               FOR EACH l-scales-gds WHERE l-scales-gds.db-num = p-db-num NO-LOCK,
     1892                               FIRST l-prod-bc-db WHERE
     1893                                     l-prod-bc-db.b-code = l-scales-gds.b-code AND
     1894                                     l-prod-bc-db.bc-on = TRUE AND
     1895                                     l-prod-bc-db.b-str = string(integer(loc-code), "99999")
     1896                                     and l-prod-bc-db.db-num = l-scales-gds.db-num
     1897                                     NO-LOCK,
     1898                               FIRST l-bar-code WHERE
     1899                                     l-bar-code.b-code = l-scales-gds.b-code NO-LOCK,
     1900                               FIRST l-goods WHERE
     1901                                     l-goods.gds-code = l-bar-code.gds-code NO-LOCK
     1902                             BY l-scales-gds.db-num
     1903                             BY l-scales-gds.scales-num
     1904                             BY l-scales-gds.plu-code:
     1905                   LEAVE.
     1906             END.
     1907             if avail l-scales-gds then do:
     1908                 line-rec = recid (l-scales-gds).
     1909                 if db-mode = "self" then do:
     1910                 reposition br-lst to recid line-rec no-error.
     1911                 end.
     1912                 else do:
     1913                   reposition br-lst-db to recid line-rec no-error.
     1914                 end.
     1915             end.
     1916             else do:
     1917               message "Строка не найдена.".
     1918             end.
     1919           end.
     1920           else do:
     1921             find first l-prod-bc where
     1922                  l-prod-bc.b-str = string(integer(loc-code), "99999")  NO-LOCK No-ERROR.
     1923             if available l-prod-bc then do:
     1924               FOR EACH l-scales-gds WHERE l-scales-gds.db-num = p-db-num NO-LOCK,
     1925               FIRST l-prod-bc WHERE
     1926                     l-prod-bc.b-code = l-scales-gds.b-code AND
     1927                     l-prod-bc.bc-on = TRUE AND
     1928                     l-prod-bc.b-str = string(integer(loc-code), "99999")
     1929                     NO-LOCK,
     1930               FIRST l-bar-code WHERE
     1931                     l-bar-code.b-code = l-scales-gds.b-code NO-LOCK,
     1932               FIRST l-goods WHERE
     1933                     l-goods.gds-code = l-bar-code.gds-code NO-LOCK
     1934               BY l-scales-gds.db-num
     1935               BY l-scales-gds.scales-num
     1936               BY l-scales-gds.plu-code:
     1937                 LEAVE.
     1938               END.
     1939               if avail l-scales-gds then do:
     1940                   line-rec = recid (l-scales-gds).
     1941                   if db-mode = "self" then do:
     1942                   reposition br-lst to recid line-rec no-error.
     1943                   end.
     1944                   else do:
     1945                     reposition br-lst-db to recid line-rec no-error.
     1946                   end.
     1947               end.
     1948             end.
     1949             else do:
     1950               message "Весовой код не найден.".
     1951           end.
     1952           end.
     1953         end.
     1954       end.
     1955       when "PLU" then do:
     1956         FIND FIRST l-scales-gds WHERE
     1957                  l-scales-gds.db-num = p-db-num
     1958              AND l-scales-gds.plu-code = integer(loc-code) NO-LOCK No-ERROR.
     1959        IF AVAIl l-scales-gds then do:
     1960           line-rec = recid (l-scales-gds).
     1961           if db-mode = "self" then do:
     1962           reposition br-lst to recid line-rec no-error.
     1963           end.
     1964           else do:
     1965             reposition br-lst-db to recid line-rec no-error.
     1966           end.
     1967        end.
     1968        else message "PLU не найден.".
     1969       end.
     1970     end case.
     1971     apply "entry" to loc-code in frame Dialog-Frame.
     1972     return no-apply.
     1973   end.
     1974   ON MOUSE-SELECT-DBLCLICK, return, Ctrl-J OF loc-name IN FRAME Dialog-Frame do:
     1975     assign loc-name.
     1976     if last-event:label = "Ctrl-J" then do:
     1977      if db-mode = "self" then do:
     1978         FOR EACH l-scales-gds WHERE
     1979                 ((l-scales-gds.db-num = current-db-num AND  l-scales-gds.scales-num = current-scales AND l-scales-gds.b-code > current-b-code ) OR
     1980                   l-scales-gds.scales-num > current-scales)
     1981                                                         NO-LOCK,
     1982                             FIRST l-bar-code WHERE
     1983                                   l-bar-code.b-code = l-scales-gds.b-code NO-LOCK,
     1984                             FIRST l-goods WHERE
     1985                                   l-goods.gds-code = l-bar-code.gds-code AND
     1986                                   l-goods.gds-name begins loc-name NO-LOCK,
     1987                             FIRST l-gds-obj-attr WHERE
     1988                                   l-gds-obj-attr.gds-code = l-bar-code.gds-code AND
     1989                                   l-gds-obj-attr.attr-code = 'scales-code':U No-LOCK,
     1990                             FIRST l-prod-bc WHERE
     1991                                   l-prod-bc.b-str = l-gds-obj-attr.attr-value NO-LOCK
     1992                           BY l-scales-gds.db-num
     1993                           BY l-scales-gds.scales-num
     1994                           BY l-scales-gds.plu-code:
     1995                           LEAVE.
     1996         END.
     1997      end.
     1998      else do:
     1999         FOR EACH l-scales-gds WHERE
     2000                 ((l-scales-gds.db-num = current-db-num AND  l-scales-gds.scales-num = current-scales AND l-scales-gds.b-code > current-b-code ) OR
     2001                   l-scales-gds.scales-num > current-scales) NO-LOCK,
     2002                             FIRST l-bar-code WHERE
     2003                                   l-bar-code.b-code = l-scales-gds.b-code NO-LOCK,
     2004                             FIRST l-goods WHERE
     2005                                   l-goods.gds-code = l-bar-code.gds-code AND
     2006                                   l-goods.gds-name begins loc-name NO-LOCK,
     2007                             FIRST l-gds-obj-attr WHERE
     2008                                   l-gds-obj-attr.gds-code = l-bar-code.gds-code AND
     2009               l-gds-obj-attr.attr-code = 'scales-code':U No-LOCK
     2010         BY l-scales-gds.db-num
     2011         BY l-scales-gds.scales-num
     2012         BY l-scales-gds.plu-code:
     2013          find FIRST l-prod-bc-db no-lock WHERE
     2014               l-prod-bc-db.b-str = l-gds-obj-attr.attr-value
     2015           and l-prod-bc-db.db-num = l-scales-gds.db-num no-error.
     2016           if not available l-prod-bc-db then do:
     2017             find first l-prod-bc no-lock where
     2018                       l-prod-bc.b-code = l-bar-code.b-code
     2019                   and l-prod-bc.b-str = l-gds-obj-attr.attr-value no-error.
     2020             if not available l-prod-bc then next.
     2021           end.
     2022           LEAVE.
     2023         END.
     2024      end.
     2025     end.
     2026     else do:
     2027       if db-mode = "self" then do:
     2028         FOR EACH l-scales-gds WHERE l-scales-gds.db-num = p-db-num NO-LOCK,
     2029                             FIRST l-bar-code WHERE
     2030                                   l-bar-code.b-code = l-scales-gds.b-code NO-LOCK,
     2031                             FIRST l-goods WHERE
     2032                                   l-goods.gds-code = l-bar-code.gds-code AND
     2033                                   l-goods.gds-name begins loc-name NO-LOCK,
     2034                             FIRST l-gds-obj-attr WHERE
     2035                                   l-gds-obj-attr.gds-code = l-bar-code.gds-code AND
     2036                                   l-gds-obj-attr.attr-code = 'scales-code':U No-LOCK,
     2037                             FIRST l-prod-bc WHERE
     2038                                   l-prod-bc.b-str = l-gds-obj-attr.attr-value NO-LOCK
     2039                           BY l-scales-gds.db-num
     2040                           BY l-scales-gds.scales-num
     2041                           BY l-scales-gds.plu-code:
     2042                           LEAVE.
     2043         END.
     2044       end.
     2045       else do:
     2046         FOR EACH l-scales-gds WHERE l-scales-gds.db-num = p-db-num NO-LOCK,
     2047                             FIRST l-bar-code WHERE
     2048                                   l-bar-code.b-code = l-scales-gds.b-code NO-LOCK,
     2049                             FIRST l-goods WHERE
     2050                                   l-goods.gds-code = l-bar-code.gds-code AND
     2051                                   l-goods.gds-name begins loc-name NO-LOCK,
     2052                             FIRST l-gds-obj-attr WHERE
     2053                                   l-gds-obj-attr.gds-code = l-bar-code.gds-code AND
     2054               l-gds-obj-attr.attr-code = 'scales-code':U No-LOCK
     2055                           BY l-scales-gds.db-num
     2056                           BY l-scales-gds.scales-num
     2057                           BY l-scales-gds.plu-code:
     2058           find FIRST l-prod-bc-db no-lock WHERE
     2059               l-prod-bc-db.b-str = l-gds-obj-attr.attr-value
     2060           and l-prod-bc-db.db-num = l-scales-gds.db-num no-error.
     2061           if not available l-prod-bc-db then do:
     2062             find first l-prod-bc no-lock where
     2063                       l-prod-bc.b-code = l-bar-code.b-code
     2064                   and l-prod-bc.b-str = l-gds-obj-attr.attr-value no-error.
     2065             if not available l-prod-bc then next.
     2066           end.
     2067                           LEAVE.
     2068         END.
     2069       end.
     2070     end.
     2071     if avail l-scales-gds then do:
     2072       assign
     2073       current-db-num = l-scales-gds.db-num
     2074       current-plu = l-scales-gds.plu-code
     2075       current-scales = l-scales-gds.scales-num
     2076       current-b-code =l-scales-gds.b-code
     2077       line-rec = recid (l-scales-gds).
     2078       if db-mode = "self" then do:
     2079       reposition br-lst to recid line-rec no-error.
     2080       end.
     2081       else do:
     2082         reposition br-lst-db to recid line-rec no-error.
     2083       end.
     2084     end.
     2085     else do:
     2086          message "Строка не найдена.".
     2087      end.
     2088     apply "entry" to loc-name in frame Dialog-Frame.
     2089     return no-apply.
     2090   end.
     2091   on iteration-changed of br-lst in frame Dialog-Frame,
     2092                           br-lst-db in frame Dialog-Frame
     2093   do:
     2094     if not avail X_scales-gds or recid (X_scales-gds) <> line-rec then do:
     2095       hide loc-art in frame Dialog-Frame.
     2096       loc-art = "".
     2097     end.
     2098   end.
     2099   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2100   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2101   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2102   on help of frame Dialog-Frame
     2103   do:
     2104     run gbl/app_help.p
     2105       (input this-procedure :file-name
     2106       ,input ''
     2107       ,input ?
     2108       ) no-error.
     2109     if error-status :error then do:
     2110       message
     2111         "Ошибка при вызове помощи"
     2112         error-status :get-message(1)
     2113         view-as alert-box .
     2114     end.
     2115   end.
     2116   run minbtn-set in this-procedure .
     2117   on choose of b-help in frame Dialog-Frame
     2118   do:
     2119     apply "help":u to frame Dialog-Frame .
     2120   end.
     2121   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2122   procedure minbtn-set :
     2123       do
     2124           on error undo, return error return-value
     2125           :
     2126           define variable ii              as integer       no-undo .
     2127           define variable fh              as widget-handle no-undo .
     2128           define variable hh              as widget-handle no-undo .
     2129           define variable v-h             as handle        extent 4 no-undo .
     2130           define variable v-name-button   as character     no-undo .
     2131           define variable v-help-old-x    as decimal       no-undo .
     2132           define variable v-help-old-y    as decimal       no-undo .
     2133           define variable v-help-old-size as decimal       no-undo .
     2134           define variable v-frame-width   as decimal       no-undo .
     2135           define variable jj              as integer       no-undo .
     2136           do
     2137               on error undo, return error
     2138               :
     2139               assign
     2140                   v-frame-width = frame Dialog-Frame:width - 0.3
     2141                   fh            = frame Dialog-Frame:first-child
     2142                   hh            = fh:first-child
     2143                   ii            = 1
     2144                   .
     2145               do while valid-handle(hh):
     2146                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2147                   do:
     2148                       case lc(hh:name) :
     2149                           when "b-help" then
     2150                               do:
     2151                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2152                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2153                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2154                                   hh:TOOLTIP = "Помощь" .
     2155                                   v-help-old-x = hh:column .
     2156                                   v-help-old-y = hh:row    .
     2157                                   v-help-old-size = hh:width .
     2158                                   hh:width-chars = 2.5 .
     2159                               end.
     2160                           when "b-print" then
     2161                               do:
     2162                                   hh:load-image("cmp/b-print.bmp":u) .
     2163                                   hh:TOOLTIP = "Печать" .
     2164                                   v-h[ii] = hh:handle .
     2165                                   ii = ii + 1 .
     2166                                   hh:width-chars = 3 .
     2167                               end.
     2168                           when "b-history" or
     2169                           when "b-hist" then
     2170                               do:
     2171                                   hh:load-image("cmp/b-hist.bmp":u) .
     2172                                   hh:TOOLTIP = "История" .
     2173                                   v-h[ii] = hh:handle .
     2174                                   ii = ii + 1 .
     2175                                   hh:width-chars = 3 .
     2176                               end.
     2177                           when "b-sch" then
     2178                               do:
     2179                                   hh:load-image("cmp/b-sch.bmp":u) .
     2180                                   hh:TOOLTIP = "Установка Фильтра" .
     2181                                   v-h[ii] = hh:handle .
     2182                                   ii = ii + 1 .
     2183                                   hh:width-chars = 3 .
     2184                               end.
     2185                           when "b-hist-user" then
     2186                               do:
     2187                                   hh:load-image("cmp/b-hist.bmp":u) .
     2188                                   hh:TOOLTIP = "История пользователя" .
     2189                                   ii = ii + 1 .
     2190                               end.
     2191                       end case.
     2192                   end.
     2193                   hh = hh:next-sibling.
     2194               end.
     2195               b-help:column = v-frame-width - b-help:width-chars.
     2196               jj = 0.
     2197               repeat ii = 4 to 1 by -1 :
     2198                   if valid-handle (v-h[ii] ) then
     2199                   do:
     2200                       jj  = jj + 1 .
     2201                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2202                       v-h[ii]:row    = v-help-old-y .
     2203                   end.
     2204               end.
     2205           end.
     2206       end.
     2207   end procedure.
     2208   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2209   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2210   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2211   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2212   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2213   define variable v-diasize-current-frame-height as decimal   no-undo .
     2214   define variable v-diasize-change-size          as logical   no-undo .
     2215   define variable v-diasize-resize-button        as handle    no-undo .
     2216   define variable v-diasize-wndmax               as logical   no-undo .
     2217   define variable v-diasize-wndstore             as logical   no-undo .
     2218   define variable v-diasize-proc-name            as character no-undo .
     2219   define variable v-diasize-browse-handle        as handle    no-undo .
     2220   define variable v-diasize-browse-number        as integer   no-undo .
     2221   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2222   define temp-table temp-diasize-handle no-undo
     2223     field handle-value  as handle
     2224     field save-position as decimal
     2225     index xpk is primary unique handle-value
     2226     .
     2227   define temp-table temp-browse-handle no-undo
     2228     field browse-type   as character
     2229     field browse-number as integer
     2230     field browse-handle as handle
     2231     field original-size as decimal
     2232     index xpk is primary unique browse-type browse-number
     2233     index xie browse-type browse-handle
     2234   .
     2235   procedure diasize_change-height :
     2236     define input  parameter p-change-value  as decimal   no-undo .
     2237     define input  parameter p-move-resize   as logical   no-undo .
     2238     define variable v-field-group-handle    as handle    no-undo .
     2239     define variable v-object-handle         as handle    no-undo .
     2240     define variable v-frame-height          as decimal   no-undo .
     2241     define variable v-frame-virtual-height  as decimal   no-undo .
     2242     define variable v-browse-height         as decimal   no-undo .
     2243     define variable v-window-height         as decimal   no-undo .
     2244     define variable v-window-virtual-height as decimal   no-undo .
     2245     define variable v-change-sign           as integer   no-undo .
     2246     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2247     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2248     if p-change-value > 0
     2249     then do:
     2250       if frame Dialog-Frame :height + p-change-value
     2251           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2252       then do:
     2253         assign
     2254           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2255                           - (frame Dialog-Frame :height-chars)
     2256         .
     2257         if p-change-value <= 0
     2258         then do:
     2259           run diasize_position-resize-button in this-procedure .
     2260           return .
     2261         end.
     2262       end.
     2263     end.
     2264     if p-change-value < 0
     2265     then do:
     2266       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2267       then do:
     2268         assign
     2269           p-change-value = v-diasize-orig-frame-height
     2270                          - (frame Dialog-Frame :height-chars)
     2271         .
     2272         if p-change-value >= 0
     2273         then do:
     2274           run diasize_position-resize-button in this-procedure .
     2275           return .
     2276         end.
     2277       end.
     2278     end.
     2279     if p-change-value >= 0
     2280     then do:
     2281       assign
     2282         v-change-sign = 1
     2283       .
     2284     end.
     2285     else do:
     2286       assign
     2287         v-change-sign = -1
     2288       .
     2289     end.
     2290     assign
     2291       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2292     .
     2293     if p-change-value = 0
     2294     then do:
     2295       run diasize_position-resize-button in this-procedure .
     2296       return .
     2297     end.
     2298     move_block:
     2299     do
     2300     on error undo move_block, retry move_block
     2301     :
     2302       if retry
     2303       then do:
     2304         do
     2305         on error undo move_block, leave move_block
     2306         :
     2307           if p-change-value > 0
     2308           then do:
     2309             for each buf_temp-diasize-handle
     2310             on error undo, next
     2311             :
     2312               assign
     2313                 v-object-handle = buf_temp-diasize-handle.handle-value
     2314               .
     2315               if v-object-handle <> v-diasize-resize-button
     2316               then do:
     2317                 assign
     2318                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2319                 .
     2320               end.
     2321             end.
     2322             assign
     2323               v-diasize-browse-handle :height = v-browse-height
     2324             .
     2325             for each buf_temp-browse-handle
     2326               where buf_temp-browse-handle.browse-type = 'height':u
     2327             on error undo, next
     2328             :
     2329               assign
     2330                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2331               .
     2332             end.
     2333             assign
     2334               frame Dialog-Frame :height = v-frame-height
     2335             .
     2336             if frame Dialog-Frame :scrollable = true
     2337             then do:
     2338               assign
     2339                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2340               .
     2341             end.
     2342             run diasize_position-resize-button in this-procedure .
     2343           end.
     2344           else do:
     2345             if frame Dialog-Frame :scrollable = true
     2346             then do:
     2347               assign
