     2959         then do:
     2960           assign
     2961             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2962           no-error .
     2963           if error-status :error
     2964           or error-status :get-message(1) <> ""
     2965           then do:
     2966             undo move_block, retry move_block.
     2967           end.
     2968         end.
     2969       end.
     2970       if p-move-resize
     2971       then do:
     2972         run diasize_position-resize-button in this-procedure .
     2973       end.
     2974       if v-diasize-wndstore = true
     2975       then do:
     2976         if connected("ub") = true
     2977         then do:
     2978           define variable v-cntxt-db-num        as integer   no-undo .
     2979           define variable v-cntxt-userid        as character no-undo .
     2980           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2981                                             , OUTPUT v-cntxt-userid
     2982                                             ) .
     2983           run gbl/wndsizew.p
     2984             (input  v-cntxt-db-num
     2985             ,input  v-cntxt-userid
     2986             ,input  v-diasize-proc-name
     2987             ,input  'width':u
     2988             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2989             ) .
     2990         end.
     2991       end.
     2992     end.
     2993     assign
     2994       v-diasize-change-size = false
     2995     .
     2996   end procedure.
     2997   procedure diasize_set-width :
     2998     define input  parameter p-new-width  as decimal   no-undo .
     2999     define input  parameter p-move-resize as logical   no-undo .
     3000     do
     3001     on error undo, return error return-value
     3002     :
     3003       run diasize_change-width in this-procedure
     3004         (input  (p-new-width - frame Dialog-Frame :width)
     3005         ,input  p-move-resize
     3006         ) .
     3007     end.
     3008   end procedure.
     3009   procedure diasize_position-resize-button :
     3010     do with frame Dialog-Frame
     3011     :
     3012       hide v-diasize-resize-button .
     3013       assign
     3014         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3015                     - 1
     3016                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3017         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3018                     - 1
     3019                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3020       .
     3021       view v-diasize-resize-button .
     3022     end.
     3023   end procedure.
     3024   on alt-right anywhere
     3025   do:
     3026     run diasize_change-width in this-procedure
     3027       (input 1
     3028       ,input true
     3029       ) .
     3030     return no-apply .
     3031   end.
     3032   on alt-left anywhere
     3033   do:
     3034     run diasize_change-width in this-procedure
     3035       (input -1
     3036       ,input true
     3037       ) .
     3038     return no-apply .
     3039   end.
     3040   on alt-down anywhere
     3041   do:
     3042     run diasize_change-height in this-procedure
     3043       (input 1
     3044       ,input true
     3045       ) .
     3046     return no-apply .
     3047   end.
     3048   on alt-up anywhere
     3049   do:
     3050     run diasize_change-height in this-procedure
     3051       (input -1
     3052       ,input true
     3053       ) .
     3054     return no-apply .
     3055   end.
     3056   on alt-enter of frame Dialog-Frame
     3057   do:
     3058     run diasize_maximize in this-procedure
     3059       (input  ?
     3060       ).
     3061     return no-apply .
     3062   end.
     3063   procedure diasize_end-move :
     3064     do
     3065     on error undo, return error return-value
     3066     :
     3067       define variable v-row-delta as decimal   no-undo .
     3068       define variable v-col-delta as decimal   no-undo .
     3069       define variable v-new-row as decimal   no-undo .
     3070       define variable v-new-col as decimal   no-undo .
     3071       assign
     3072         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3073         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3074       .
     3075       assign
     3076         v-row-delta = v-new-row - frame Dialog-Frame :height
     3077         v-col-delta = v-new-col - frame Dialog-Frame :width
     3078       .
     3079       run diasize_change-height in this-procedure
     3080         (input v-row-delta
     3081         ,input true
     3082         ) .
     3083       run diasize_change-width in this-procedure
     3084         (input v-col-delta
     3085         ,input true
     3086         ) .
     3087     end.
     3088   end procedure.
     3089   procedure diasize_maximize :
     3090     define input  parameter p-action as logical   no-undo .
     3091     do
     3092     on error undo, return error return-value
     3093     :
     3094       if p-action = ?
     3095       then do:
     3096         if v-diasize-need-maximize = true
     3097         then do:
     3098           assign
     3099             p-action = true
     3100           .
     3101         end.
     3102         else do:
     3103           assign
     3104             p-action = false
     3105           .
     3106         end.
     3107       end.
     3108       if p-action = true
     3109       then do:
     3110         run diasize_change-height in this-procedure
     3111           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3112               - frame Dialog-Frame :height-chars
     3113           ,input true
     3114           ) .
     3115         run diasize_change-width in this-procedure
     3116           (input session :width-chars
     3117               - frame Dialog-Frame :width-chars
     3118           ,input true
     3119           ) .
     3120         assign
     3121           v-diasize-need-maximize = false
     3122         .
     3123       end.
     3124       else do:
     3125         run diasize_change-width in this-procedure
     3126           (input v-diasize-orig-frame-width
     3127               - frame Dialog-Frame :width-chars
     3128           ,input true
     3129           ) .
     3130         run diasize_change-height in this-procedure
     3131           (input v-diasize-orig-frame-height
     3132               - frame Dialog-Frame :height-chars
     3133           ,input true
     3134           ) .
     3135         assign
     3136           v-diasize-need-maximize = true
     3137         .
     3138       end.
     3139     end.
     3140   end procedure.
     3141   procedure diasize_restore-orig-size :
     3142     do
     3143     on error undo, return error return-value
     3144     :
     3145       assign
     3146         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3147         v-diasize-current-frame-height = frame Dialog-Frame :height
     3148       .
     3149       run diasize_set-height in this-procedure
     3150         (input  v-diasize-orig-frame-height
     3151         ,input  true
     3152         ) .
     3153       run diasize_set-width in this-procedure
     3154         (input  v-diasize-orig-frame-width
     3155         ,input  true
     3156         ) .
     3157     end.
     3158   end procedure.
     3159   procedure diasize_restore-current-size :
     3160     do
     3161     on error undo, return error return-value
     3162     :
     3163       run diasize_set-height in this-procedure
     3164         (input  v-diasize-current-frame-height
     3165         ,input  true
     3166         ) .
     3167       run diasize_set-width in this-procedure
     3168         (input  v-diasize-current-frame-width
     3169         ,input  true
     3170         ) .
     3171     end.
     3172   end procedure.
     3173   procedure diasize_set-browse-handle :
     3174     define input  parameter p-browse-handle as handle   no-undo .
     3175     define buffer buf_temp-browse-handle for temp-browse-handle .
     3176     do
     3177     on error undo, return error return-value
     3178     :
     3179       assign
     3180         v-diasize-browse-handle = p-browse-handle
     3181       .
     3182       for each buf_temp-browse-handle
     3183       on error undo, return error return-value
     3184       :
     3185         delete buf_temp-browse-handle .
     3186       end.
     3187     end.
     3188   end procedure.
     3189   procedure diasize_add_browse :
     3190     define input  parameter p-browse-type   as character no-undo .
     3191     define input  parameter p-browse-handle as handle    no-undo .
     3192     define buffer buf_temp-browse-handle for temp-browse-handle .
     3193     do
     3194     on error undo, return error return-value
     3195     :
     3196       assign
     3197         v-diasize-browse-number = v-diasize-browse-number + 1
     3198       .
     3199       create buf_temp-browse-handle .
     3200       assign
     3201         buf_temp-browse-handle.browse-type   = p-browse-type
     3202         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3203         buf_temp-browse-handle.browse-handle = p-browse-handle
     3204       .
     3205     end.
     3206   end procedure.
     3207   procedure diasize_init :
     3208     define variable v-default-value    as logical   no-undo .
     3209     define variable v-restore-saved    as logical   no-undo .
     3210     define variable v-resize-value-str as character no-undo .
     3211     do
     3212     on error undo, return error return-value
     3213     :
     3214       do with frame Dialog-Frame
     3215       :
     3216         assign
     3217           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3218           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3219           v-diasize-browse-handle     = browse br-lst :handle
     3220         .
     3221         create button v-diasize-resize-button
     3222         assign
     3223           parent        = frame Dialog-Frame :first-child
     3224           label         = "s"
     3225           height-pixels = 16
     3226           width-pixels  = 16
     3227           visible       = true
     3228           sensitive     = true
     3229           movable       = true
     3230           triggers:
     3231             on end-move persistent run diasize_end-move in this-procedure .
     3232           end triggers.
     3233         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3234         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3235         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3236         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3237         assign
     3238           v-diasize-wndmax = false
     3239         .
     3240         if connected("ub") = true
     3241         then do:
     3242           define variable v-cntxt-db-num        as integer   no-undo .
     3243           define variable v-cntxt-userid        as character no-undo .
     3244           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3245                                             , OUTPUT v-cntxt-userid
     3246                                             ) .
     3247           run gbl/wndpar_r.p
     3248             (input  v-cntxt-db-num
     3249             ,input  v-cntxt-userid
     3250             ,input  'wndmax':U
     3251             ,output v-diasize-wndmax
     3252             ,output v-default-value
     3253             ) .
     3254         end.
     3255         assign
     3256           v-diasize-wndstore = false
     3257         .
     3258         if connected("ub") = true
     3259         then do:
     3260           run gbl/wndpar_r.p
     3261             (input  v-cntxt-db-num
     3262             ,input  v-cntxt-userid
     3263             ,input  'wndstore':U
     3264             ,output v-diasize-wndstore
     3265             ,output v-default-value
     3266             ) .
     3267         end.
     3268         assign
     3269           v-diasize-proc-name = entry(1, program-name(2), '.')
     3270         .
     3271         if v-diasize-wndstore = true
     3272         then do:
     3273           assign
     3274             v-restore-saved = false
     3275           .
     3276           if connected("ub") = true
     3277           then do:
     3278             run gbl/wndsizer.p
     3279               (input  v-cntxt-db-num
     3280               ,input  v-cntxt-userid
     3281               ,input  v-diasize-proc-name
     3282               ,input  'height':u
     3283               ,output v-resize-value-str
     3284               ) .
     3285             if v-resize-value-str <> '':U
     3286             then do:
     3287               run diasize_change-height in this-procedure
     3288                 (input  integer(v-resize-value-str)
     3289                 ,input  true
     3290                 ) .
     3291               assign
     3292                 v-restore-saved = true
     3293               .
     3294             end.
     3295           end.
     3296           if connected("ub") = true
     3297           then do:
     3298             run gbl/wndsizer.p
     3299               (input  v-cntxt-db-num
     3300               ,input  v-cntxt-userid
     3301               ,input  v-diasize-proc-name
     3302               ,input  'width':u
     3303               ,output v-resize-value-str
     3304               ) .
     3305             if v-resize-value-str <> '':U
     3306             then do:
     3307               run diasize_change-width in this-procedure
     3308                 (input  integer(v-resize-value-str)
     3309                 ,input  true
     3310                 ) .
     3311               assign
     3312                 v-restore-saved = true
     3313               .
     3314             end.
     3315           end.
     3316           if v-restore-saved <> true
     3317           then do:
     3318             if v-diasize-wndmax = true
     3319             then do:
     3320               run diasize_maximize in this-procedure
     3321                 (input  true
     3322                 ) .
     3323             end.
     3324           end.
     3325         end.
     3326         else do:
     3327           if v-diasize-wndmax = true
     3328           then do:
     3329             run diasize_maximize in this-procedure
     3330               (input  true
     3331               ) .
     3332           end.
     3333         end.
     3334       end.
     3335     end.
     3336   end procedure.
     3337   procedure diasize_need-full-display :
     3338     define output parameter p-need-full-display as logical   no-undo .
     3339     do
     3340     on error undo, return error return-value
     3341     :
     3342       assign
     3343         p-need-full-display = v-diasize-need-full-display
     3344       .
     3345       assign
     3346         v-diasize-need-full-display = false
     3347       .
     3348     end.
     3349   end procedure.
     3350   procedure get-context :
     3351      define output parameter p-db-num as integer          no-undo.
     3352      define output parameter p-user-id as character        no-undo.
     3353      define variable v-login               as character    no-undo.
     3354      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3355      define buffer buf_user-login  for ub.user-login .
     3356      do
     3357      on error undo, return error
     3358      :
     3359            FIND FIRST buf_sys-ctrl no-lock.
     3360            ASSIGN
     3361               v-login = USERID("ub")
     3362               p-db-num = buf_sys-ctrl.db-num
     3363            .
     3364            FIND FIRST buf_user-login
     3365                 WHERE buf_user-login.db-num = p-db-num
     3366                   AND buf_user-login.user-login = v-login
     3367                 no-lock
     3368                 no-error
     3369                 .
     3370            IF AVAILABLE buf_user-login
     3371            THEN DO:
     3372               assign
     3373                  p-user-id = buf_user-login.user-id
     3374               .
     3375            END.
     3376      end.
     3377   end procedure.
     3378       run diasize_init in this-procedure .
     3379   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3380   on F9 of frame Dialog-Frame anywhere do:
     3381     run gds-recid.
     3382     if gds-rec = ? then
     3383       return no-apply.
     3384     run ref/gds-form.w ( input parparentproc
     3385                         ,input 'ПРОСМОТР':U
     3386                         ,input ?
     3387                         ,input ?
     3388                         ,input THIS-PROCEDURE:HANDLE
     3389                         ,input-output gds-rec).
     3390     apply "entry" to br-lst in frame Dialog-Frame.
     3391     return no-apply.
     3392   end.
     3393   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3394   do:
     3395     br-lst :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     3396   end.
     3397   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3398   on f5 of frame Dialog-Frame anywhere
     3399   do:
     3400      v-doc-rec = ?. if available X_scales-gds then v-doc-rec = recid(X_scales-gds). run openbr in this-procedure . if db-mode = 'self' then reposition br-lst to recid(v-doc-rec). else reposition br-lst-db to recid(v-doc-rec). v-doc-rec = ? .
     3401       apply "VALUE-CHANGED" to br-lst.
     3402   end.
     3403   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3404   DEF VAR cur-clmn-numbr-lst as INT EXTENT 17 no-undo.
     3405   DEF VAR varmvibr-lst       as INT no-undo.
     3406   DEF VAR varmvjbr-lst       as INT no-undo.
     3407   DEF VAR varmvkbr-lst       as INT no-undo.
     3408   DEF VAR varmvlbr-lst       as INT no-undo.
     3409   DEF VAR move-elementbr-lst as INT no-undo.
     3410   def var jjbr-lst           as int no-undo.
     3411   do varmvibr-lst = 1 to EXTENT(cur-clmn-numbr-lst):
     3412     ASSIGN cur-clmn-numbr-lst[varmvibr-lst] = varmvibr-lst.
     3413   END.
     3414   RUN start-mv-clmnbr-lst.
     3415   PROCEDURE start-mv-clmnbr-lst:
     3416   def var old-session as logical no-undo.
     3417      old-session = SESSION:IMMEDIATE-DISPLAY.
     3418      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3419      SESSION:IMMEDIATE-DISPLAY = old-session.
     3420   END.
     3421   ON ctrl-cursor-right OF BROWSE br-lst do:
     3422     RUN re-move-clmnbr-lst ( 6, 17).
     3423   END.
     3424   ON ctrl-cursor-left OF BROWSE br-lst do:
     3425     RUN re-move-clmnbr-lst (17, 6).
     3426   END.
     3427   PROCEDURE re-move-clmnbr-lst:
     3428     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3429     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3430     DO varmvibr-lst = 1 TO EXTENT(cur-clmn-numbr-lst):
     3431       if cur-clmn-numbr-lst[varmvibr-lst] = source-column THEN cur-clmn-numbr-lst[varmvibr-lst] = -1.
     3432     END.
     3433     if br-lst:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     3434     if source-column > target-column THEN
     3435     DO varmvjbr-lst = source-column - 1 to target-column BY -1:
     3436       DO varmvibr-lst = 1 TO EXTENT(cur-clmn-numbr-lst):
     3437           if cur-clmn-numbr-lst[varmvibr-lst] = varmvjbr-lst THEN DO:
     3438             cur-clmn-numbr-lst[varmvibr-lst] = cur-clmn-numbr-lst[varmvibr-lst] + 1.
     3439           END.
     3440       END.
     3441     END.
     3442     ELSE
     3443     DO varmvjbr-lst = source-column + 1 to target-column:
     3444       DO varmvibr-lst = 1 TO EXTENT(cur-clmn-numbr-lst):
     3445         if cur-clmn-numbr-lst[varmvibr-lst] = varmvjbr-lst THEN DO:
     3446           cur-clmn-numbr-lst[varmvibr-lst] = cur-clmn-numbr-lst[varmvibr-lst] - 1.
     3447         END.
     3448       END.
     3449     END.
     3450     DO varmvibr-lst = 1 TO EXTENT(cur-clmn-numbr-lst):
     3451       if cur-clmn-numbr-lst[varmvibr-lst] = -1 THEN cur-clmn-numbr-lst[varmvibr-lst] = target-column.
     3452     END.
     3453   END PROCEDURE.
     3454   PROCEDURE ch-clmnbr-lst:
     3455     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3456     if cur-clmn-loc <= 6 then do:
     3457       return .
     3458     end.
     3459     DO varmvibr-lst = 1 TO EXTENT(cur-clmn-numbr-lst):
     3460       if cur-clmn-numbr-lst[varmvibr-lst] = cur-clmn-loc THEN move-elementbr-lst = varmvibr-lst.
     3461     END.
     3462     RUN re-move-clmnbr-lst (cur-clmn-loc, 6).
     3463   END PROCEDURE.
     3464   PROCEDURE mv-brw-defaultbr-lst:
     3465   def var old-session as logical no-undo.
     3466     old-session = SESSION:IMMEDIATE-DISPLAY.
     3467     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3468     do varmvlbr-lst = 6 to EXTENT(cur-clmn-numbr-lst):
     3469       RUN re-move-clmnbr-lst (cur-clmn-numbr-lst[varmvlbr-lst], varmvlbr-lst).
     3470     END.
     3471     RUN start-mv-clmnbr-lst.
     3472     SESSION:IMMEDIATE-DISPLAY = old-session.
     3473   END PROCEDURE.
     3474   .
