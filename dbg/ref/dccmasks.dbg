      798   procedure fltfield-clear :
      799     define output parameter loc-fld as character no-undo.
      800     define output parameter loc-lab as character no-undo .
      801     define output parameter loc-spr as character no-undo .
      802     define output parameter loc-dim as character no-undo .
      803     assign
      804       loc-fld = ""
      805       loc-lab = ""
      806       loc-spr = ""
      807       loc-dim = "0"
      808     .
      809   end procedure .
      810   procedure fltfield-add :
      811     define input        parameter par-fld as character no-undo.
      812     define input        parameter par-lab as character no-undo .
      813     define input        parameter par-spr as character no-undo .
      814     define input-output parameter loc-fld as character no-undo.
      815     define input-output parameter loc-lab as character no-undo .
      816     define input-output parameter loc-spr as character no-undo .
      817     define input-output parameter loc-dim as character no-undo .
      818     do
      819     on error undo, return error
      820     :
      821       assign
      822       loc-fld = if loc-dim = '0'
      823                 then par-fld
      824                 else (loc-fld + chr(44) + par-fld)
      825       loc-lab = if loc-dim = '0'
      826                 then par-lab
      827                 else (loc-lab + chr(44) + par-lab)
      828       loc-spr = if loc-dim = '0'
      829                 then par-spr
      830                 else (loc-spr + chr(44) + par-spr)
      831       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      832                 string(integer(if num-entries(loc-dim) > 1
      833                               then entry(2, loc-dim)
      834                               else entry(1, loc-dim)
      835                               ) + 1)
      836       no-error
      837       .
      838     end.
      839   end procedure.
