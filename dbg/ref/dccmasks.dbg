     3160   PROCEDURE OpenBr :
     3161   define input  parameter p-open-query     as logical   no-undo .
     3162   define input  parameter p-find-next      as logical   no-undo .
     3163   define input  parameter p-find-condition as character no-undo .
     3164   define variable l-query-was-opened as logical no-undo .
     3165   define variable title0 as character no-undo.
     3166   title0 = "Маски дисконтных карт" + chr(32).
     3167   run waitfram-show in this-procedure ( input "Ждите...").
     3168   define variable sort-column-phrase as character no-undo .
     3169   case sort-column-name :
     3170     when "" then do:
     3171       assign
     3172         sort-column-phrase = ""
     3173       .
     3174     end.
     3175     otherwise do:
     3176       assign
     3177         sort-column-phrase = "by " + sort-column-name
     3178       .
     3179     end.
     3180   end case.
     3181   define variable l-open-query as logical   no-undo .
     3182     CASE p-ref-mode :
     3183       WHEN 'все':U        THEN DO:
     3184        assign
     3185        filter-point = filter-point0 + p-ref-mode
     3186        filter-label = substitute("&1", filter-label0)
     3187        .
     3188   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3189   define variable  l-disable-where-24  as logical   no-undo .
     3190   define variable  l-filter-open-24    as logical   .
     3191   define variable  flt-rec-24       as recid     no-undo .
     3192   define variable  filter-name-24      as character no-undo .
     3193   define variable  where-phrase-24     as character no-undo .
     3194   define variable  sort-phrase-24      as character no-undo .
     3195   define variable  where-phrase-rus-24 as character no-undo .
     3196   define variable  sort-phrase-rus-24  as character no-undo .
     3197     run waitfram-show in this-procedure
     3198       (input "ЖДИТЕ ..."
     3199       ).
     3200   run gbl/flt-get.p
     3201     (input filter-point
     3202     ,output flt-rec-24
     3203     ,output filter-name-24
     3204     ,output where-phrase-24
     3205     ,output sort-phrase-24
     3206     ,output where-phrase-rus-24
     3207     ,output sort-phrase-rus-24
     3208     ).
     3209   if p-open-query then do:
     3210     assign
     3211       l-filter-open-24 = false
     3212     .
     3213     if flt-rec-24 <> ?
     3214       or sort-column-phrase > ""
     3215     then do:
     3216       define variable  parameter-2-24 as character no-undo .
     3217       define variable  parameter-3-24 as character no-undo .
     3218       define variable  parameter-4-24 as character no-undo .
