      552       ,output v-param-type
      553       ,INPUT-OUTPUT table-handle v-tth
      554       )  .
      555     if rep-excel then v-excel = "TRUE" .
      556     else v-excel = "FALSE" .
      557     if p-param eq ""
      558     then
      559        p-param = "EXCEL:" + v-excel.
      560     else
      561        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      562     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      563   end procedure.
      564   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      565   procedure cur-time :
      566      define output parameter p-today as date      no-undo .
      567      define output parameter p-time  as integer   no-undo .
      568     do
      569     on error undo, return error
      570     :
      571       define variable v-date1 as date      no-undo .
      572       define variable v-date2 as date      no-undo .
      573       define variable v-time  as integer   no-undo .
      574       assign
      575         v-date1 = today
      576         v-time  = time
      577         v-date2 = today
      578       .
      579       if v-date1 <> v-date2
      580       then do:
      581         assign
      582           v-date1 = today
      583           v-time  = v-time
      584         .
      585       end.
      586       assign
      587         p-today = v-date1
      588         p-time  = v-time
      589       .
      590     end.
      591   end.
      592   function cur-time-date returns character
      593   :
      594     return string(today, '99/99/9999':U) .
      595   end.
      596   function cur-time-mjd returns decimal
      597   :
      598     define variable v-date as date      no-undo .
      599     define variable v-time as integer   no-undo .
      600     run cur-time in this-procedure
      601       (output v-date
      602       ,output v-time
      603       ) .
      604     return integer(v-date) - 2400002 + (v-time / 86400) .
      605   end.
      606   function cur-time-get-ending-index returns integer
      607   (input p-number as integer
      608   )
      609   :
      610     if p-number < 0
      611     or p-number = ?
      612     then do:
      613       return 1 .
      614     end.
      615     define variable v-rest as integer   no-undo .
      616     assign
      617       p-number = p-number modulo 100
      618     .
      619     if p-number < 20
      620     then do:
      621       assign
      622         v-rest = p-number
      623       .
      624     end.
      625     else do:
      626       assign
      627         v-rest = p-number modulo 10
      628       .
      629     end.
      630     case v-rest :
      631       when 1
      632       then do:
      633         return 2 .
      634       end.
      635       when 2 or
      636       when 3 or
      637       when 4
      638       then do:
      639         return 3 .
      640       end.
      641       otherwise do:
      642         return 1 .
      643       end.
      644     end case .
      645   end.
      646   procedure cur-time-mjd-to-date :
      647      define input  parameter i-mjd-diff as decimal no-undo.
      648      define output parameter o-Date     as date    no-undo.
      649      define output parameter o-Time     as integer no-undo.
      650      define variable v-day-number as integer   no-undo .
      651      if    i-mjd-diff < 0
      652         or i-mjd-diff = ?
      653      then do:
      654         return "?" .
      655      end.
      656      assign
      657         v-day-number = truncate(i-mjd-diff,0).
      658         o-Date = date(v-day-number + 2400002).
      659         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      660     .
      661   end.
      662   function cur-time-mjd-to-string returns character
      663   (input p-mjd-diff as decimal
      664   )
      665   :
      666     define variable v-day-number as integer   no-undo .
      667     define variable v-seconds    as integer   no-undo .
      668     define variable v-hour       as integer   no-undo .
      669     define variable v-min        as integer   no-undo .
      670     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      671     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      672     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      673     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      674     if p-mjd-diff < 0
      675     or p-mjd-diff = ?
      676     then do:
      677       return "?" .
      678     end.
      679     assign
      680       v-day-number = integer(truncate(p-mjd-diff,0))
      681       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      682     .
      683     if v-seconds > 86400
      684     then do:
      685       assign
      686         v-seconds = 86400 - 1
      687       .
      688     end.
      689     if v-seconds < 0
      690     then do:
      691       assign
      692         v-seconds = 0
      693       .
      694     end.
      695     assign
      696       v-hour = truncate(v-seconds / 3600, 0)
      697     .
      698     assign
      699       v-seconds = v-seconds modulo 3600
      700     .
      701     assign
      702       v-min = truncate(v-seconds / 60, 0)
      703     .
      704     assign
      705       v-seconds = v-seconds modulo 60
      706     .
      707     return
      708         (if v-day-number <> 0
      709           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      710           else ""
      711         )
      712       + (if v-day-number <> 0 or v-hour <> 0
      713           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      714           else ""
      715         )
      716       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      717           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      718           else ""
      719         )
      720       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      721       .
      722   end.
      723   function cur-time-string returns character
      724   :
      725     define variable v-date as date      no-undo .
      726     define variable v-time as integer   no-undo .
      727     run cur-time in this-procedure
      728       (output v-date
      729       ,output v-time
      730       ) .
      731     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      732   end.
      733   function cur-time-string-sec returns character
      734   :
      735     define variable v-date as date      no-undo .
      736     define variable v-time as integer   no-undo .
      737     run cur-time in this-procedure
      738       (output v-date
      739       ,output v-time
      740       ) .
      741     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      742   end.
      743   function cur-time-custom  returns character
      744   (input p-prefix as character
      745   ,input p-date-format as character
      746   ,input p-delimiter as character
      747   ,input p-time-format as character
      748   ,input p-suffix as character
      749   )
      750   :
      751     define variable v-date as date      no-undo .
      752     define variable v-time as integer   no-undo .
      753     run cur-time in this-procedure
      754       (output v-date
      755       ,output v-time
      756       ) .
      757     return
      758       p-prefix
      759       + string(v-date, p-date-format)
      760       + p-delimiter
      761       + string(v-time, p-time-format)
      762       + p-suffix
      763       .
      764   end.
      765   function cur-time-print  returns character
      766   :
      767     define variable v-date as date      no-undo .
      768     define variable v-time as integer   no-undo .
      769     run cur-time in this-procedure
      770       (output v-date
      771       ,output v-time
      772       ) .
      773     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      774   end.
      775   function cur-time-datetime returns datetime
      776   :
      777     define variable v-char as character no-undo .
      778     define variable v-datetime as datetime no-undo .
      779     v-char = cur-time-string().
      780     v-datetime = datetime(v-char).
      781     return  v-datetime.
      782   end.
      783   function cur-time-string-msec returns character
      784   :
      785     define variable v-date as datetime  no-undo .
      786     v-date = now.
      787     return string(v-date) .
      788   end.
