     1060   FUNCTION get-all-fields returns character (p-file-name as character ):
     1061   define variable v-dop as character no-undo .
     1062     find first _file no-lock where _file._file-name = p-file-name no-error .
     1063     if not available _file then return "":U.
     1064     for each _field no-lock where
     1065              _field._file-recid = recid(_file) :
     1066       assign
     1067       v-dop = v-dop + _field._field-name + chr(44)
     1068       .
     1069     end.
     1070     return trim(v-dop).
     1071   END FUNCTION.
