     3133     OPEN QUERY BR-masks FOR EACH X_c-dis-card-mask NO-LOCK INDEXED-REPOSITION.
     3134   END PROCEDURE.
     3135   PROCEDURE MyEnable :
     3136   assign
     3137   br-changes:title in frame Dialog-Frame = "":U
     3138   temp-changes.l_name:resizable in browse br-changes = true
     3139   temp-changes.v_old:resizable in browse br-changes = true
     3140   temp-changes.v_new:resizable in browse br-changes = true
     3141   temp-changes.l_name:width in browse br-changes = 30
     3142   temp-changes.v_old:width in browse br-changes = 40
     3143   temp-changes.v_new:width in browse br-changes = 40
     3144   .
     3145   DISPLAY mark-num
     3146   WITH FRAME Dialog-Frame .
     3147   ENABLE
     3148   b-quit
     3149   B-mark when LOOKUP("b-mark":U, bttns) > 0
     3150   B-sel when LOOKUP("b-mark":U, bttns) > 0
     3151   B-lookup
     3152   B-Help
     3153   b-sch
