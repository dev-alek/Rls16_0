     4236     Open QUery br-changes for each temp-changes.
     4237     return.
     4238   end.
     4239   run ref/cdcthisv.p (
     4240                      input X_c-dis-card-mask.emitent-host-code
     4241                     ,input X_c-dis-card-mask.type
     4242                     ,input X_c-dis-card-mask.chip-num
     4243                     ,input X_c-dis-card-mask.corr-user-db-num
     4244                     ,input X_c-dis-card-mask.obj-type
     4245                     ,input X_c-dis-card-mask.obj-code
     4246                     ,input X_c-dis-card-mask.host-code
     4247                     ,input 'dis-card-mask':U
     4248                     ,input X_c-dis-card-mask.action
     4249                     ,input no
     4250                     ,output v-description
     4251                  ) no-error .
     4252   Open QUery br-changes for each temp-changes.
     4253   assign
     4254   br-changes:title in frame Dialog-Frame = v-description
     4255   .
     4256   END PROCEDURE.
     4257   FUNCTION get-emitent RETURNS CHARACTER
     4258     ( input par-emitent-host-code  as integer ) :
     4259   if par-emitent-host-code = 0 then return "Глобальная".
     4260   find first ub.clients no-lock where
     4261               ub.clients.obj-type = 'орг':U and
     4262               ub.clients.obj-code = par-emitent-host-code no-error.
     4263   if not avail ub.clients then return "?".
     4264   else return ub.clients.obj-name.
     4265   END FUNCTION.
     4266   FUNCTION get-region RETURNS CHARACTER
     4267     ( input p-host-code as integer, input p-obj-type as character, input p-obj-code as integer ) :
     4268   define variable par-region as character no-undo.
     4269     if p-host-code = 0 and
     4270          p-obj-type = "":U and
     4271          p-obj-code = 0 then do:
     4272          par-region = "Глобально".
     4273          return par-region.
     4274       end.
     4275       if p-obj-type = "" and
     4276          p-obj-code = 0 then do:
     4277          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(p-host-code).
     4278          return par-region.
     4279       end.
     4280       par-region = fill(chr(32), 4) + p-obj-type + chr(32) + string(p-obj-code).
     4281       return par-region.
     4282   END FUNCTION.
