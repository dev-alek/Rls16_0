      841   FUNCTION mark-string RETURNS CHARACTER
      842     ( input p-recid as recid, input mark-list as character  ) :
      843     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      844   END FUNCTION.
