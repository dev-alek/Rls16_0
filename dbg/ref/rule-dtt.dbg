     1463                             ,input this-procedure:handle
     1464                             ,input 'b-sel'
     1465                             ,input "uniq-key-rec"
     1466                             ,input ""
     1467                             ,input v-res-type
     1468                             ,input v-uniq-key-rec
     1469                             ,input -1
     1470                             ,input-output v-rid-list) no-error.
     1471         if v-rid-list <> '':U then do:
     1472           FIND FIRST buf_clob-bind NO-LOCK WHERE
     1473                       recid(buf_clob-bind) = INTEGER(v-rid-list) NO-ERROR.
     1474           IF not AVAILABLE buf_clob-bind THEN DO:
     1475             if v-res-type = 'list':U
     1476             then
     1477             return error substitute("Не найден список c recid &1", v-rid-list).
     1478             else
     1479             return error substitute("Не найден макрос c recid &1", v-rid-list).
     1480           end.
     1481           assign
     1482           p-value-character =  SUBSTITUTE("&1_&2"
     1483                                         , buf_clob-bind.uniq-key-rec
     1484                                         , buf_clob-bind.field-name_)
     1485           p-ok = yes
     1486           .
     1487         end.
     1488       end.
     1489      if p-param-2-data-type begins "tpl_"
     1490       and p-param-data-type = 'character':U
     1491       then do:
     1492         define buffer buf_price-list-type for ub.price-list-type.
     1493         find first buf_price-list-type no-lock where
     1494                   buf_price-list-type.plt-id = integer(entry(1, p-value-character, "-"))
     1495               and buf_price-list-type.db-num = integer(entry(2, p-value-character, "-")) no-error.
     1496         if available buf_price-list-type then do:
     1497           if p-mode = 'ПРОВЕРКА':U then do:
     1498             assign
     1499             p-ok = yes
     1500             .
     1501             return ''.
     1502           end.
     1503           v-rid-list = string(recid(buf_price-list-type)).
     1504         end.
     1505         else do:
     1506           if p-mode = 'ПРОВЕРКА':U then do:
     1507             undo, return error substitute("Нет ТПЛ &1", p-value-character).
     1508           end.
     1509           v-rid-list = '':U.
     1510         end.
     1511         v-templ-rl-root = integer(entry(2, p-param-2-data-type, "_")).
     1512         v-rid-list = string(v-templ-rl-root).
     1513         run ref/typepric.w (
     1514                               input  parParentProc
     1515                             ,INPUT "b-sel,mode=ban-discnt"
     1516                             ,INPUT-OUTPUT v-rid-list ) NO-ERROR.
     1517         if v-rid-list <> '':U then do:
     1518           FIND FIRST buf_price-list-type NO-LOCK WHERE
     1519                       recid(buf_price-list-type) = INTEGER(v-rid-list) NO-ERROR.
     1520           IF not AVAILABLE buf_price-list-type THEN DO:
     1521             return error substitute("Не найден ТПЛ c recid &1", v-rid-list).
     1522           end.
     1523           assign
     1524           p-value-character =  SUBSTITUTE("&1-&2"
     1525                                         , buf_price-list-type.plt-id
     1526                                         , buf_price-list-type.plt-db-num)
     1527           p-ok = yes
     1528           .
     1529         end.
     1530       end.
     1531       if p-param-2-data-type = "sub-type" then do:
     1532         if p-mode = 'ПРОВЕРКА':U then do:
     1533           p-ok = yes.
     1534           return '':U.
     1535         end.
     1536         assign
     1537         p-value-character = p-value-character
     1538         p-ok = yes
     1539         .
     1540       end.
     1541       if p-param-2-data-type = "id" then do:
     1542         if p-mode = 'ПРОВЕРКА':U then do:
     1543           p-ok = yes.
     1544           return '':U.
     1545         end.
     1546         run gbl/d-prompt.w (
     1547             'title=':u + "ВВЕДИТЕ ЗНАЧЕНИЕ" + '\':u
     1548           + 'text1=' + substitute("ЗНАЧЕНИЕ") + '\':u
     1549           + 'format=' + "X(40)" + '\':u
     1550           + 'type=' + 'C':U + '\':u
     1551           + 'fillin_row=2\':u
     1552           + 'fillin_col=4\':u
     1553           + 'fillin_width=20\':u
     1554           + 'fillin_height=1\':u
     1555           + 'max-chars=70\':u
     1556           + 'readonly=no\':u
     1557           , input-output p-value-character
     1558           ).
     1559         assign
     1560         p-ok = yes
     1561         .
     1562       end.
     1563   end.
