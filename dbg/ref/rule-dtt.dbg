        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-mode as character no-undo .
        4   define input parameter p-call-id as character no-undo .
        5   define input parameter p-param-data-type as character no-undo .
        6   define input parameter p-param-2-data-type as character no-undo .
        7   define input parameter p-param-3-data-type as character no-undo .
        8   define input parameter p-p-index as integer no-undo .
        9   define input-output parameter p-value-character as character no-undo .
       10   define input-output parameter p-value-data as date no-undo .
       11   define input-output parameter p-value-decimal as decimal no-undo .
       12   define input-output parameter p-value-integer as integer no-undo .
       13   define input-output parameter p-value-logical as integer no-undo .
       14   define output parameter p-ok as logical no-undo .
       15   define variable vss-revision    as character no-undo init "$Revision: 993a05482fd8, 1104, rls $":U .
       16   define variable vss-author      as character no-undo init "$Author: ASMorozov $":U .
       17   define variable vss-date        as character no-undo init "$Date: Thu Dec 14 02:13:53 2017 +0300 $":U .
       18   define variable vss-workfile    as character no-undo init "$Workfile: rule-dtt.p $":U .
       19   define variable vss-archive     as character no-undo init "$Archive: ref/rule-dtt.p $":U .
       20   define variable vss-description as character no-undo init "Обработка сложных типов данных для параметров правил".
       21   procedure vss-get-info :
       22     define output parameter p-vss-revision    like vss-revision    no-undo .
       23     define output parameter p-vss-author      like vss-author      no-undo .
       24     define output parameter p-vss-date        like vss-date        no-undo .
       25     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       26     define output parameter p-vss-archive     like vss-archive     no-undo .
       27     define output parameter p-vss-description like vss-description no-undo .
       28     assign
       29       p-vss-revision    = vss-revision
       30       p-vss-author      = vss-author
       31       p-vss-date        = vss-date
       32       p-vss-workfile    = vss-workfile
       33       p-vss-archive     = vss-archive
       34       p-vss-description = vss-description
       35     .
       36   end procedure.
       37   procedure vss-get-parameters :
       38     define output parameter p-vss-parameters as character no-undo .
       39   end procedure.
       40   define new global shared variable g#vssrevis-logger as handle    no-undo .
       41   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       42   define variable v-vssrevis-logger                   as handle    no-undo .
       43   procedure vss-logevent :
       44     define input  parameter p-extra-paramters as character no-undo .
       45     define variable v-vssrevis-parameters as character no-undo .
       46     do
       47     on error undo, return error return-value
       48     :
       49       if  valid-handle(v-vssrevis-logger)
       50       and v-vssrevis-logger :get-signature("logevent") <> ""
       51       then do:
       52         run vss-get-parameters in this-procedure
       53           (output v-vssrevis-parameters
       54           ).
       55         run logevent in v-vssrevis-logger
       56           (input vss-workfile
       57           ,input vss-revision
       58           ,input v-vssrevis-parameters
       59           ,input p-extra-paramters
       60           ).
       61       end.
       62     end.
       63   end procedure.
       64   assign
       65     v-vssrevis-logger = g#vssrevis-logger
       66   .
       67   if  valid-handle(v-vssrevis-logger)
       68   and v-vssrevis-logger :get-signature("logevent") <> ""
       69   then do:
       70     assign
       71       v-vssrevis-logevent = true
       72     .
       73     run vss-logevent in this-procedure (input vss-description) .
       74   end.
       75   define new global shared variable g#language as character no-undo .
       76   if g#language <> '' and g#language <> 'rus':U then do:
       77     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       78   end.
       79   define new global shared variable g#library  as handle no-undo .
       80   define new global shared variable g#library2 as handle no-undo .
       81   define   shared variable g#auto as logical no-undo.
       82   define   shared variable g#news as logical no-undo.
       83   define   shared variable g#oxml as logical no-undo.
       84   define   shared variable g#esys as logical no-undo.
       85   define   shared variable g#news-source-db as integer no-undo.
       86   define   shared variable g#esys-source-esys as integer no-undo.
       87   define   shared variable g#db-num as integer   no-undo .
       88   define   shared variable g#userid as character no-undo .
       89   define   shared variable g#passwd as character no-undo .
       90   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91   procedure gen-key-rec :
       92     define input  parameter p-tbl-name    as character no-undo.
       93     define input  parameter p-bh_tbl-name as handle    no-undo.
       94     define output parameter p-key-rec     as character no-undo.
       95     do
       96     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       97     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
       98     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
       99     :
      100       define variable fh               as handle    no-undo .
      101       define variable v-ok             as logical   no-undo .
      102       define variable v-inform         as character no-undo .
      103       define variable v-ind            as integer   no-undo .
      104       define variable v-idx-field-qnty as integer   no-undo .
      105       if p-tbl-name = ?
      106         or p-tbl-name = "":U
      107       then do:
      108         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info0 ).
      109       end.
      110       if not p-bh_tbl-name:available then do:
      111         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info0, p-tbl-name ).
      112       end.
      113       assign
      114         p-key-rec = p-tbl-name
      115         v-inform  = p-bh_tbl-name:index-information(1)
      116         v-ind     = 2
      117       .
      118       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      119       on error undo, return error
      120       :
      121         assign
      122           v-inform = p-bh_tbl-name:index-information( v-ind )
      123           v-ind    = v-ind + 1
      124         .
      125       end.
      126       if v-inform = ?
      127         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      128         or entry( 3, v-inform, ",":U ) <> "1":U
      129       then do:
      130         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, p-tbl-name ).
      131       end.
      132       else do:
      133         assign
      134           v-idx-field-qnty = num-entries( v-inform ) - 4
      135         .
      136         if v-idx-field-qnty < 2 then do:
      137           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, p-tbl-name ).
      138         end.
      139         do v-ind = 1 to v-idx-field-qnty by 2
      140         on error undo, return error
      141         :
      142           assign
      143             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      144             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      145           .
      146         end.
      147       end.
      148       if p-key-rec = ? then do:
      149         assign
      150           p-key-rec = "":U
      151         .
      152         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info0, p-tbl-name ).
      153       end.
      154     end.
      155     return.
      156   end procedure.
      157   procedure gen-where-keyr-tab :
      158     define input  parameter i-tableSerach as character no-undo.
      159     define input  parameter i-tablekey   as character  no-undo.
      160     define input  parameter p-key-rec    as character  no-undo.
      161     define input  parameter p-key-handle as handle     no-undo .
      162     define input  parameter p-db-name    as character  no-undo .
      163     define input  parameter p-tt-handle  as handle     no-undo .
      164     define output parameter o-Where      as character  no-undo.
      165     do
      166     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      167     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      168     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      169     :
      170       define variable v-full-tbl-name  as character no-undo .
      171       define variable bh_tbl-name      as handle    no-undo .
      172       define variable fh_key           as handle    no-undo .
      173       define variable fh_search        as handle    no-undo .
      174       define variable v-field-num      as integer   no-undo .
      175       define variable v-count-fld      as integer   no-undo .
      176       define variable v-inform         as character no-undo .
      177       define variable v-ind            as integer   no-undo .
      178       define variable v-idx-field-qnty as integer   no-undo .
      179       define variable v-field-name     as character no-undo .
      180       define variable v-field-val      as character no-undo .
      181       define variable v-word-link      as character no-undo .
      182       define variable vTable           as character no-undo.
      183       define variable bh_tbl-key       as handle    no-undo .
      184       assign
      185         p-key-rec = trim( p-key-rec )
      186       .
      187       if p-key-handle <> ? then do:
      188         if not valid-handle(p-key-handle)
      189            or p-key-handle:type <> "buffer"
      190         then do:
      191           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info0 ).
      192         end.
      193         if num-entries( p-key-rec, chr(3) ) > 1
      194           or p-key-rec = ?
      195           or p-key-rec = "":U
      196         then do:
      197           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info0, p-key-rec ).
      198         end.
      199       end.
      200       else do:
      201         if p-key-rec = ?
      202           or p-key-rec = "":U
      203         then do:
      204           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      205         end.
      206       end.
      207       assign
      208         vTable = entry( 1 , p-key-rec, chr(3) )
      209       .
      210       if p-tt-handle <> ?
      211         and ( not valid-handle(p-tt-handle)
      212               or p-tt-handle:type <> "buffer"
      213             )
      214       then do:
      215         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info0, vTable, chr(10) ).
      216       end.
      217       if p-tt-handle = ? then do:
      218         assign
      219           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      220         .
      221         create buffer bh_tbl-name for table v-full-tbl-name .
      222       end.
      223       else do:
      224         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      225       end.
      226       assign
      227         v-inform = bh_tbl-name:index-information(1)
      228         v-ind    = 2
      229       .
      230       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      231       on error undo, return error
      232       :
      233         assign
      234           v-inform = bh_tbl-name:index-information( v-ind )
      235           v-ind    = v-ind + 1
      236         .
      237       end.
      238       if v-inform = ?
      239         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      240         or entry( 3, v-inform, ",":U ) <> "1":U
      241       then do:
      242         delete object bh_tbl-name no-error.
      243         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info0, vTable ).
      244       end.
      245       assign
      246         v-idx-field-qnty = num-entries( v-inform ) - 4
      247       .
      248       if v-idx-field-qnty < 2 then do:
      249         delete object bh_tbl-name no-error.
      250         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, vTable ).
      251       end.
      252       assign
      253         o-where     = "where":U
      254         v-word-link = "":U
      255         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      256         v-count-fld = 0
      257       .
      258       if i-tablekey ne "" and i-tablekey ne ?
      259       then do:
      260         assign
      261           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      262         .
      263         create buffer bh_tbl-key for table v-full-tbl-name .
      264       end.
      265       if i-tableSerach ne "" and i-tableSerach ne ?
      266       then do:
      267         delete object bh_tbl-name no-error.
      268         assign
      269           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      270         .
      271         create buffer bh_tbl-name for table v-full-tbl-name .
      272       end.
      273       block_where:
      274       do v-ind = 1 to v-idx-field-qnty by 2
      275       on error undo, return error
      276       :
      277         assign
      278           v-count-fld = v-count-fld + 1
      279         .
      280         if p-key-handle = ?
      281           and v-count-fld > v-field-num
      282         then do:
      283           leave block_where.
      284         end.
      285         define variable VfieldKeyTable as handle no-undo.
      286         assign
      287           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      288           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      289         .
      290         if     bh_tbl-key ne ?
      291         then do:
      292            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      293            if VfieldKeyTable eq ?
      294            then next block_where.
      295         end.
      296         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      297         then
      298            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      299         else
      300            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      301         if p-key-handle = ? then do:
      302           assign
      303             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      304           .
      305         end.
      306         else do:
      307           assign
      308             fh_key = p-key-handle:buffer-field( v-field-name )
      309           .
      310           if fh_key = ?
      311             or not valid-handle( fh_key )
      312           then do:
      313             delete object bh_tbl-name.
      314             if     bh_tbl-key ne ?
      315             then
      316                delete object bh_tbl-key.
      317             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info0, p-key-handle:name, v-field-name ).
      318           end.
      319           assign
      320             v-field-val = fh_key:buffer-value
      321           .
      322         end.
      323         if fh_search:data-type ="character":U then do:
      324           assign
      325             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      326             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      327             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      328             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      329             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      330             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      331             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      332             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      333             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      334             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      335             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      336             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      337             v-field-val = substitute( '"&1"', v-field-val )
      338           .
      339         end.
      340         assign
      341           o-where = substitute( "&1 &2", o-where, v-field-val )
      342         .
      343         if v-word-link = "":U then do:
      344           assign
      345             v-word-link = "and":U
      346           .
      347         end.
      348       end.
      349       delete object bh_tbl-name.
      350       if     bh_tbl-key ne ?
      351       then
      352          delete object bh_tbl-key.
      353       if p-key-handle = ?
      354         and v-count-fld <> v-field-num
      355       then do:
      356         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info0, vTable ).
      357       end.
      358     end.
      359   end procedure.
      360   procedure gen-hn-keyr-tab :
      361     define input  parameter i-tableSerach as character no-undo.
      362     define input  parameter i-tablekey   as character no-undo.
      363     define input  parameter p-key-rec    as character no-undo.
      364     define input  parameter p-key-handle as handle    no-undo .
      365     define input  parameter p-db-name    as character no-undo .
      366     define input  parameter p-tt-handle  as handle    no-undo .
      367     define input  parameter p-stts-lock  as integer   no-undo .
      368     define output parameter o-hn         as handle    no-undo.
      369     define variable v-full-tbl-name as character no-undo.
      370     define variable v-where         as character no-undo.
      371     define variable bh_tbl-name     as handle    no-undo.
      372     define variable vTable          as character no-undo.
      373     do
      374     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      375     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      376     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      377         run gen-where-keyr-tab(i-tableSerach,
      378                                i-tablekey,
      379                                p-key-rec,
      380                                p-key-handle,
      381                                p-db-name,
      382                                p-tt-handle,
      383                                output v-where).
      384         if i-tableSerach ne "" and i-tableSerach ne ?
      385         then do:
      386            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      387            create buffer bh_tbl-name for table v-full-tbl-name .
      388         end.
      389         else do:
      390            if p-tt-handle = ? then do:
      391               assign
      392                  vTable = entry( 1 , p-key-rec, chr(3) )
      393               .
      394               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      395               create buffer bh_tbl-name for table v-full-tbl-name .
      396            end.
      397            else do:
      398               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      399            end.
      400         end.
      401         if p-tt-handle = ? then do:
      402            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      403         end.
      404         else do:
      405            bh_tbl-name:find-first( v-where ) no-error .
      406         end.
      407         o-hn = bh_tbl-name.
      408      end.
      409   end procedure.
      410   procedure gen-hn-keyr :
      411     define input  parameter p-key-rec    as character no-undo.
      412     define input  parameter p-key-handle as handle    no-undo .
      413     define input  parameter p-db-name    as character no-undo .
      414     define input  parameter p-tt-handle  as handle    no-undo .
      415     define input  parameter p-stts-lock  as integer   no-undo .
      416     define output parameter o-hn         as handle    no-undo.
      417     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      418   end.
      419   procedure gen-row-keyr :
      420     define input  parameter p-key-rec    as character no-undo.
      421     define input  parameter p-key-handle as handle    no-undo .
      422     define input  parameter p-db-name    as character no-undo .
      423     define input  parameter p-tt-handle  as handle    no-undo .
      424     define input  parameter p-stts-lock  as integer   no-undo .
      425     define output parameter p-tbl-row    as rowid     no-undo.
      426     define output parameter p-tbl-name   as character no-undo.
      427     define variable vHn as handle no-undo.
      428       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      429       p-tbl-row = if vHn:available then vHn:rowid else ?.
      430       p-tbl-name =  vHn:table.
      431       delete object vHn no-error.
      432     if p-tbl-row = ? then do:
      433       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info0, p-tbl-name, p-key-rec ).
      434     end.
      435     else do:
      436       return.
      437     end.
      438   end procedure.
      439   procedure gen-key-fv :
      440     define input  parameter p-key-rec    as character no-undo .
      441     define output parameter p-field-list as character no-undo .
      442     define output parameter p-value-list as character no-undo.
      443     do
      444     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      445     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      446     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      447     :
      448       define variable v-full-tbl-name  as character no-undo .
      449       define variable bh_tbl-name      as handle    no-undo .
      450       define variable v-tbl-name       as character no-undo .
      451       define variable v-field-num      as integer   no-undo .
      452       define variable v-count-fld      as integer   no-undo .
      453       define variable v-inform         as character no-undo .
      454       define variable v-ind            as integer   no-undo .
      455       define variable v-idx-field-qnty as integer   no-undo .
      456       define variable v-delim-key      as character no-undo .
      457       if p-key-rec = ?
      458         or p-key-rec = "":U
      459       then do:
      460         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      461       end.
      462       assign
      463         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      464         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      465       .
      466       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      467       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info0 ).
      468       assign
      469         v-inform = bh_tbl-name:index-information(1)
      470         v-ind    = 2
      471       .
      472       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      473       on error undo, return error
      474       :
      475         assign
      476           v-inform = bh_tbl-name:index-information( v-ind )
      477           v-ind    = v-ind + 1
      478         .
      479       end.
      480       if v-inform = ?
      481         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      482         or entry( 3, v-inform, ",":U ) <> "1":U
      483       then do:
      484         delete object bh_tbl-name no-error.
      485         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      486       end.
      487       assign
      488         v-idx-field-qnty = num-entries( v-inform ) - 4
      489       .
      490       if v-idx-field-qnty < 2 then do:
      491         delete object bh_tbl-name no-error.
      492         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      493       end.
      494       assign
      495         p-field-list = "":U
      496         p-value-list = "":U
      497         v-delim-key  = "":U
      498         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      499         v-count-fld  = 0
      500       .
      501       block_where:
      502       do v-ind = 1 to v-idx-field-qnty by 2
      503       on error undo, return error
      504       :
      505         assign
      506           v-count-fld = v-count-fld + 1
      507         .
      508         if v-count-fld > v-field-num then do:
      509           leave block_where.
      510         end.
      511         assign
      512           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      513           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      514         .
      515         if v-ind = 1 then do:
      516           assign
      517             v-delim-key = chr(3)
      518           .
      519         end.
      520       end.
      521       delete object bh_tbl-name.
      522       if v-count-fld <> v-field-num then do:
      523         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      524       end.
      525     end.
      526   end procedure.
      527   procedure gen-key-field :
      528     define input  parameter p-table      as character no-undo .
      529     define output parameter p-field-list as character no-undo .
      530     do
      531     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      532     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      533     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      534     :
      535       define variable v-full-tbl-name  as character no-undo .
      536       define variable bh_tbl-name      as handle    no-undo .
      537       define variable v-tbl-name       as character no-undo .
      538       define variable v-field-num      as integer   no-undo .
      539       define variable v-count-fld      as integer   no-undo .
      540       define variable v-inform         as character no-undo .
      541       define variable v-ind            as integer   no-undo .
      542       define variable v-idx-field-qnty as integer   no-undo .
      543       define variable v-delim-key      as character no-undo .
      544       if p-table = ?
      545         or p-table = "":U
      546       then do:
      547         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info0 ).
      548       end.
      549       assign
      550         v-tbl-name      = p-table
      551         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      552       .
      553       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      554       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info0 ).
      555       assign
      556         v-inform = bh_tbl-name:index-information(1)
      557         v-ind    = 2
      558       .
      559       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      560       on error undo, return error
      561       :
      562         assign
      563           v-inform = bh_tbl-name:index-information( v-ind )
      564           v-ind    = v-ind + 1
      565         .
      566       end.
      567       if v-inform = ?
      568         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      569         or entry( 3, v-inform, ",":U ) <> "1":U
      570       then do:
      571         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      572       end.
      573       assign
      574         v-idx-field-qnty = num-entries( v-inform ) - 4
      575       .
      576       if v-idx-field-qnty < 2 then do:
      577         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      578       end.
      579       assign
      580         p-field-list = "":U
      581         v-delim-key  = "":U
      582         v-count-fld  = 0
      583       .
      584       block_where:
      585       do v-ind = 1 to v-idx-field-qnty by 2
      586       on error undo, return error
      587       :
      588         assign
      589           v-count-fld = v-count-fld + 1
      590         .
      591         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      592         if v-ind = 1 then do:
      593           assign
      594             v-delim-key = chr(3)
      595           .
      596         end.
      597       end.
      598       delete object bh_tbl-name.
      599     end.
      600   end procedure.
      601   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      602     define variable v-cntxt-db-num        as integer   no-undo .
      603     define variable v-cntxt-userid        as character no-undo .
      604     define variable v-cntxt-level         as character no-undo .
      605     define variable v-cntxt-host-code-obj as integer   no-undo .
      606     define variable v-cntxt-obj-type      as character no-undo .
      607     define variable v-cntxt-obj-code      as integer   no-undo .
      608     define variable v-cntxt-db-num-obj    as integer   no-undo .
      609     define variable v-cntxt-is-admin      as logical   no-undo .
      610   define variable v-rid-list as character no-undo .
      611   define variable v-ok as logical no-undo .
      612   define variable v-cli-type as character no-undo .
      613   define variable v-cli-code as integer no-undo .
      614   define variable v-mess as character no-undo .
      615   define variable v-field-list as character no-undo .
      616   define variable v-value-list as character no-undo .
      617   define variable glog as logical no-undo .
      618   define variable v-chk-type as character no-undo .
      619   define variable v-ii as integer no-undo .
      620   define variable v-jj as integer no-undo .
      621   define variable v-kk as integer no-undo .
      622   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      623   main-block:
      624   do
      625   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      626   :
      627       if lookup(p-mode, 'ПРОВЕРКА':U + chr(44) + 'ИЗМЕНЕНИЕ':U) = 0 then do:
      628         message
      629         "Неправильное значение параметра p-mode" p-mode
      630         view-as alert-box error .
      631         undo, return error .
      632       end.
      633       if p-p-index = 0
      634       and (lookup("LIST", p-param-3-data-type) > 0
      635            or
      636            lookup("SORTED-LIST", p-param-3-data-type) > 0
      637            )
      638       then do:
      639          assign
      640          p-ok = yes.
      641          return '':U.
      642       end.
      643       if p-mode <> 'ПРОВЕРКА':U then do:
      644   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      645     run mainmenu_getcntxt in parparentproc
      646       (output v-cntxt-db-num
      647       ,output v-cntxt-userid
      648       ,output v-cntxt-level
      649       ,output v-cntxt-host-code-obj
      650       ,output v-cntxt-obj-type
      651       ,output v-cntxt-obj-code
      652       ,output v-cntxt-db-num-obj
      653       ,output v-cntxt-is-admin
      654       ) .
      655       end.
      656       if p-param-2-data-type = 'shop':U  then do:
      657         define buffer buf_shop for ub.shop.
      658         find first buf_shop no-lock where
      659                   buf_shop.obj-code = p-value-integer no-error.
      660         if available buf_shop then do:
      661           if p-mode = 'ПРОВЕРКА':U then do:
      662             p-ok = yes.
      663             return '':U.
      664           end.
      665           v-rid-list = string(recid(buf_shop)).
      666         end.
      667         else do:
      668           if p-mode = 'ПРОВЕРКА':U then do:
      669             undo, return error substitute("Нет магазина с кодом &1", p-value-integer).
      670           end.
      671           v-rid-list = '':U.
      672         end.
      673         run adm/shops.w ( input parparentproc
      674                         , input "b-sel"
      675                         , input-output v-rid-list
      676                         , no).
      677         if v-rid-list = '':U
      678         or v-rid-list = string(recid(buf_shop)) then return error.
      679         find first buf_shop no-lock where
      680                   recid(buf_shop) = integer(v-rid-list) no-error.
      681         if not available buf_shop then return error.
      682         assign
      683         p-value-integer = buf_shop.obj-code
      684         p-ok = yes
      685         .
      686       end.
      687   if entry(1, p-param-2-data-type, "_") = 'sysconf':U then do:
      688         define buffer buf_sysconf for ub.sysconf.
      689         find first buf_sysconf no-lock
      690                           where buf_sysconf.host-code = p-value-integer no-error.
      691         if available buf_sysconf then do:
      692           if p-mode = 'ПРОВЕРКА':U then do:
      693             p-ok = yes.
      694             return '':U.
      695           end.
      696           v-rid-list = string(recid(buf_sysconf)).
      697         end.
      698         else do:
      699           if p-mode = 'ПРОВЕРКА':U then do:
      700             if num-entries(p-param-2-data-type, "_") > 1
      701             and entry(2, p-param-2-data-type, "_") = "0" then do:
      702               p-ok = yes.
      703               return '':U.
      704             end.
      705             undo, return error substitute("Нет фирмы с кодом &1", p-value-integer).
      706           end.
      707           v-rid-list = '':U.
      708         end.
      709         define variable v-firm-code as integer no-undo .
      710         run adm/sconfs.w (
      711               input parParentProc
      712             , input "b-sel":U
      713             , input no
      714             , input 0
      715             , output v-firm-code
      716             , input-output v-rid-list
      717         ) no-error.
      718         if v-rid-list = '':U
      719         or v-rid-list = string(recid(buf_sysconf)) then do:
      720           if num-entries(p-param-2-data-type, "_") > 1
      721           and entry(2, p-param-2-data-type, "_") = "0" then do:
      722             assign
      723             p-value-integer = 0
      724             p-ok = yes
      725             .
      726             return ''.
      727           end.
      728           return error.
      729         end.
      730         find first buf_sysconf no-lock where
      731                   recid(buf_sysconf) = integer(v-rid-list) no-error.
      732         if not available buf_sysconf then return error.
      733         assign
      734         p-value-integer = buf_sysconf.host-code
      735         p-ok = yes
      736         .
      737       end.
      738       if p-param-2-data-type = 'clients':U
      739       or p-param-2-data-type = 'clients':U  + "_null"
      740       or p-param-2-data-type = "objects"
      741       then do:
      742         define buffer buf_clients for ub.clients.
      743         find first buf_clients no-lock where
      744                   buf_clients.obj-type = substring(p-value-character, 1, 3)
      745               and buf_clients.obj-code = integer(substring(p-value-character, 4)) no-error.
      746         if available buf_clients then do:
      747           if p-mode = 'ПРОВЕРКА':U then do:
      748             p-ok = yes.
      749             return '':U.
      750           end.
      751           v-rid-list = string(recid(buf_clients)).
      752         end.
      753         else do:
      754           if p-mode = 'ПРОВЕРКА':U then do:
      755             if p-param-2-data-type = 'clients':U  + "_null"
      756             and p-value-character = "0" then do:
      757               p-ok = yes.
      758               return '':U.
      759             end.
      760             else do:
      761               undo, return error substitute("Нет клиента &1", p-value-character).
      762             end.
      763           end.
      764           v-rid-list = '':U.
      765         end.
      766         run ref/selcli.p (
      767                           input  parparentproc
      768                          ,input ?
      769                          ,input (if p-param-2-data-type = "objects"
      770                                  then 'объект':U
      771                                  else 'чел':U)
      772                          ,input (if p-param-2-data-type = "objects"
      773                                  then yes
      774                                  else no)
      775                          ,output v-ok
      776                          ,output v-cli-type
      777                          ,output v-cli-code ) no-error.
      778         if error-status:error then return error.
      779         if v-ok = no then do:
      780           if p-param-2-data-type = 'clients':U  + "_null"
      781           then do:
      782             message
      783             "Вы хотите оставить ПУСТОЕ значение параметра?"
      784             view-as alert-box question buttons yes-no update glog.
      785             if glog then do:
      786                 assign
      787                 p-value-character = "0"
      788                 p-ok = yes
      789                 .
      790                 return ''.
      791              end.
      792              else do:
      793                return error .
      794              end.
      795           end.
      796           else do:
      797             return error.
      798           end.
      799         end.
      800         assign
      801         p-value-character = v-cli-type + string(v-cli-code)
      802         p-ok = yes
      803         .
      804       end.
      805       if p-param-2-data-type = 'cli-grp':U  then do:
      806         define buffer buf_cli-grp for ub.cli-grp.
      807         find first buf_cli-grp no-lock where
      808                   buf_cli-grp.node-code = p-value-integer no-error.
      809         if available buf_cli-grp
      810         and not can-find(ub.cli-grp where ub.cli-grp.upper-code = buf_cli-grp.node-code) then do:
      811           if p-mode = 'ПРОВЕРКА':U then do:
      812             p-ok = yes.
      813             return '':U.
      814           end.
      815           v-rid-list = string(recid(buf_cli-grp)).
      816         end.
      817         else do:
      818           if p-mode = 'ПРОВЕРКА':U then do:
      819             undo, return error substitute("Нет группы клиентов с вн.кодом группы &1 или эта группа НЕтерминальная", p-value-integer).
      820           end.
      821           v-rid-list = '':U.
      822         end.
      823         run ref/cli-grps.w ( input parparentproc
      824                           ,input ('терм':U + ",b-sel")
      825                           ,input-output v-rid-list ).
      826         if v-rid-list = '':U then return error.
      827         find first buf_cli-grp no-lock where
      828                   recid(buf_cli-grp) = integer(v-rid-list) no-error.
      829         if not available buf_cli-grp then return error.
      830         assign
      831         p-value-integer = buf_cli-grp.node-code
      832         p-ok = yes
      833         .
      834       end.
      835       if p-param-2-data-type = 'r-b':U then do:
      836         if p-value-character = 'rubl':U
      837         or p-value-character = 'base':U then do:
      838           if p-mode = 'ПРОВЕРКА':U then do:
      839             p-ok = yes.
      840             return '':U.
      841           end.
      842         end.
      843         else do:
      844           if p-mode = 'ПРОВЕРКА':U then do:
      845             undo, return error substitute("Неверное значение типа валюты продаж  = &1", p-value-character).
      846           end.
      847         end.
      848         run gbl/s-r-b.w ( input "Выбор типа валюты накоплений"
      849                         ,input-output p-value-character
      850                         ,output v-ok ) no-error.
      851         if not v-ok then return error.
      852         assign
      853         p-value-character = p-value-character
      854         p-ok = yes
      855         .
      856       end.
      857       if entry(1, p-param-2-data-type, "_") = 'period-type':U then do:
      858         if lookup(p-value-character, 'day,week,month,year,hour,hour-last,shift,shift-last,yesterday,week-last,month-last,year-last,halfyear,halfyear-last,quarter,quarter-last':U) > 0 then do:
      859           if p-mode = 'ПРОВЕРКА':U then do:
      860             p-ok = yes.
      861             return '':U.
      862           end.
      863         end.
      864         else do:
      865           if p-mode = 'ПРОВЕРКА':U then do:
      866             undo, return error substitute("Неверное значение типа периода  = &1", p-value-character).
      867           end.
      868         end.
      869         run gbl/period-t.w ( input "Выбор типа периода"
      870                          ,input (if num-entries(p-param-2-data-type, "_") > 1
      871                            then entry(2, p-param-2-data-type, "_")
      872                            else '')
      873                         ,input-output p-value-character
      874                         ,output v-ok ) no-error.
      875         if not v-ok then return error.
      876         assign
      877         p-value-character = p-value-character
      878         p-ok = yes
      879         .
      880       end.
      881       if entry(1, p-param-2-data-type, "_") = 'output-type':U then do:
      882         v-kk = 0.
      883         _ii:
      884         do v-ii = 1 to num-entries(p-value-character):
      885           do v-jj = 1 to num-entries(entry(2, p-param-2-data-type, "_")):
      886              if lookup(entry(v-ii, p-value-character)
      887                      , entry(v-jj, entry(2, p-param-2-data-type, "_"))) > 0 then do:
      888                v-kk = v-kk + 1.
      889                next _ii.
      890              end.
      891           end.
      892         end.
      893         if v-kk >= num-entries(p-value-character) then do:
      894           if p-mode = 'ПРОВЕРКА':U then do:
      895             p-ok = yes.
      896             return '':U.
      897           end.
      898         end.
      899         else do:
      900           if p-mode = 'ПРОВЕРКА':U then do:
      901             undo, return error substitute("Неверное значение типа периода  = &1", p-value-character).
      902           end.
      903         end.
      904         run gbl/output-t.w ( input "Выбор типа периода"
      905                          ,input (if num-entries(p-param-2-data-type, "_") > 1
      906                            then entry(2, p-param-2-data-type, "_")
      907                            else '')
      908                         ,input-output p-value-character
      909                         ,output v-ok ) no-error.
      910         if not v-ok then return error.
      911         assign
      912         p-value-character = p-value-character
      913         p-ok = yes
      914         .
      915       end.
      916       if p-param-2-data-type begins ('dis-rule':U + "_") then do:
      917         define variable v-sts as integer no-undo .
      918         define variable v-templ-rl-root as integer no-undo .
      919         define buffer buf_dis-rule for ub.dis-rule.
      920         v-templ-rl-root = integer(entry(2, p-param-2-data-type, "_")).
      921         find first buf_dis-rule no-lock where
      922                   buf_dis-rule.rule-num = p-value-integer   no-error.
      923         if available buf_dis-rule then do:
      924           if p-mode = 'ПРОВЕРКА':U then do:
      925             p-ok = yes.
      926             return '':U.
      927           end.
      928           v-rid-list = string(recid(buf_dis-rule)).
      929         end.
      930         else do:
      931           if p-mode = 'ПРОВЕРКА':U then do:
      932             undo, return error substitute("Нет правила скидок с кодом &1", p-value-integer).
      933           end.
      934           v-rid-list = '':U.
      935         end.
      936         run ref/dis-ruls.w (   input  parparentproc
      937                               ,input 0
      938                               ,input '':U
      939                               ,input 0
      940                               ,input "b-sel,b-add"
      941                               ,input "upper-rule-num"
      942                               ,input v-templ-rl-root
      943                               ,input ?
      944                               ,input 0
      945                               ,input-output v-sts
      946                               ,input-OUTPUT v-rid-list) NO-ERROR.
      947         if v-rid-list <> '':U then do:
      948           find first buf_dis-rule no-lock where
      949                     recid(buf_dis-rule) = integer(v-rid-list) no-error.
      950           if not available buf_dis-rule then return error substitute("Не найдено правило скидки c recid &1", v-rid-list).
      951           assign
      952           p-value-integer = buf_dis-rule.rule-num
      953           p-ok = yes
      954           .
      955         end.
      956       end.
      957       if p-param-2-data-type begins ('prop-ref':U + "_") then do:
