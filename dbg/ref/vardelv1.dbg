        1   block-level on error undo, throw.
        2   define input-output parameter p-doc-rec as recid no-undo.
        3   define input parameter p-mode            as character no-undo .
        4   define input parameter p-deliv-type-code like ub.variant-delivery.deliv-type-code no-undo .
        5   define input parameter p-deliv-subj-code like ub.variant-delivery.deliv-subj-code no-undo .
        6   define input parameter p-deliv-obj-type  like ub.variant-delivery.obj-type no-undo .
        7   define input parameter p-deliv-obj-code  like ub.variant-delivery.obj-code no-undo .
        8   define input parameter p-term-delivery   like ub.variant-delivery.term-delivery no-undo .
        9   define input parameter p-des like ub.delivery-type-subject.des no-undo .
       10   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       11   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       12   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile: vardelv1.p $":U .
       14   define variable vss-archive     as character no-undo init "$Archive: ref/vardelv1.p $":U .
       15   define variable vss-description as character no-undo init "Сохранение изменений в карточке варианта доставки".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define variable v-db-num like ub.db.db-num no-undo .
       77   define buffer buf_delivery-type  for ub.delivery-type.
       78   define buffer buf_delivery-subject  for ub.delivery-subject.
       79   define buffer buf_delivery-type-subject  for ub.delivery-type-subject.
       80   define buffer buf_variant-delivery for ub.variant-delivery.
       81   define buffer buf_clients for ub.clients.
       82   if p-mode <> 'ДОБАВЛЕНИЕ':U
       83   AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
       84     message
       85     vss-workfile vss-revision vss-description skip
       86     "Неверный параметр p-mode" p-mode
       87     view-as alert-box error .
       88     return error '':u.
       89   end.
       90   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
       92     (output v-db-num
       93     )  .
       94   if v-db-num <> 0 then do:
       95     run err-mess (substitute("Нельзя изменять запись ВАРИАНТ ДОСТАВКИ в УБД: Номер текущей БД &1"
       96                   , v-db-num) ).
       97     undo, return error "":U.
       98   end.
       99   find first buf_delivery-type no-lock where
      100               buf_delivery-type.deliv-type-code = p-deliv-type-code  no-error .
      101   if not available buf_delivery-type then do:
      102     run err-mess (substitute("Неправильная ссылка на ТИП ДОСТАВКИ, код типа доставки: &1"
      103                   , p-deliv-type-code) ).
      104     undo, return error "deliv-type-code":U.
      105   end.
      106   find first buf_delivery-subject no-lock where
      107               buf_delivery-subject.deliv-subj-code = p-deliv-subj-code  no-error .
      108   if not available buf_delivery-subject then do:
      109     run err-mess (substitute("Неправильная ссылка на СУБЪЕКТ ДОСТАВКИ, код субъекта доставки: &1"
      110                   , p-deliv-subj-code) ).
      111     undo, return error "deliv-subj-code":U.
      112   end.
      113   find first buf_delivery-type-subject no-lock where
      114               buf_delivery-type-subject.deliv-type-code = p-deliv-type-code
      115           AND buf_delivery-type-subject.deliv-subj-code = p-deliv-subj-code
      116           no-error .
      117   if not available buf_delivery-type-subject then do:
      118     run err-mess (substitute("Неправильная ссылка на ТИП ДОСТАВКИ ОТ СУБЪЕКТА, код типа доставки: &1, код субъекта: &2"
      119                   , p-deliv-type-code
      120                   , p-deliv-subj-code
      121                   ) ).
      122     undo, return error "deliv-type-code":U.
      123   end.
      124   find first buf_clients no-lock where
      125             buf_clients.obj-type = p-deliv-obj-type
      126         AND buf_clients.obj-code = p-deliv-obj-code  no-error .
      127   if not available buf_clients then do:
      128     run err-mess (substitute("Неправильная ссылка на ОБЪЕКТ ДОСТАВКИ: &1&2"
      129                   , p-deliv-obj-type
      130                   , p-deliv-obj-code
      131                   ) ).
      132     undo, return error "obj-code":U.
      133   end.
      134   if buf_clients.obj-type <> 'маг':U
      135   and buf_clients.obj-type <> 'скл':U then do:
      136     run err-mess (substitute("Неверный тип ОБЪЕКТА ДОСТАВКИ: &1, может быть только &2 или &3"
      137                   , p-deliv-obj-type
      138                   , 'маг':U
      139                   , 'скл':U
      140                   ) ).
      141     undo, return error "obj-type":U.
      142   end.
      143   if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      144     find first buf_variant-delivery no-lock where
      145               buf_variant-delivery.deliv-type-code = p-deliv-type-code
      146           AND buf_variant-delivery.deliv-subj-code = p-deliv-subj-code
      147           AND buf_variant-delivery.obj-type = p-deliv-obj-type
      148           AND buf_variant-delivery.obj-code = p-deliv-obj-code  no-error .
      149     if available buf_variant-delivery then do:
      150       run err-mess (substitute("Уже есть запись ВАРИАНТА ДОСТАВКИ, у которой код типа доставки: &1 и код субъекта доставки: &2 и объект &3&4"
      151                     , p-deliv-type-code
      152                     , p-deliv-subj-code
      153                     , p-deliv-obj-type
      154                     , p-deliv-obj-code
      155                     ) ).
      156       undo, return error "deliv-type-code":U.
      157     end.
      158   end.
      159   _MAIN:
      160   DO ON ERROR UNDO, RETURN ERROR
      161   ON STOP UNDO, RETURN ERROR:
      162     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      163       create ub.variant-delivery.
      164       assign
      165       ub.variant-delivery.deliv-type-code = p-deliv-type-code
      166       ub.variant-delivery.deliv-subj-code = p-deliv-subj-code
      167       ub.variant-delivery.obj-type        = p-deliv-obj-type
      168       ub.variant-delivery.obj-code        = p-deliv-obj-code
      169       p-doc-rec = recid(ub.variant-delivery)
      170       .
      171     end.
      172     else do:
      173       FIND FIRST ub.variant-delivery where
      174                 recid(ub.variant-delivery) = p-doc-rec No-ERROR.
      175       if not available ub.variant-delivery then do:
      176         message
      177         vss-workfile vss-revision vss-description skip
      178         "Не найдена запись ВАРИАНТ ДОСТАВКИ - p-doc-rec" p-doc-rec
      179         view-as alert-box error .
      180         undo, return error '':u.
      181       end.
      182       if ub.variant-delivery.deliv-type-code <> p-deliv-type-code
      183       or ub.variant-delivery.deliv-subj-code <> p-deliv-subj-code
      184       or ub.variant-delivery.obj-type        <> p-deliv-obj-type
      185       or ub.variant-delivery.obj-code        <> p-deliv-obj-code
      186       then do:
      187         message
      188         vss-workfile vss-revision vss-description skip
      189         "Для уже имеющейся записи нельзя изменить"
      190         "внутренний код типа доставки и/или" skip
      191         "внутренний код субъекта доставки и/или" skip
      192         "объект доставки"
      193         view-as alert-box ERROR.
      194         undo, return error '':U.
      195       end.
      196     end.
      197     assign
      198     ub.variant-delivery.term-delivery       = p-term-delivery
      199     ub.variant-delivery.des                 = p-des
      200     ub.variant-delivery.sts                 =  (if p-mode = 'ДОБАВЛЕНИЕ':U
      201                                then 0
      202                                else ub.variant-delivery.sts)
      203     .
      204     release ub.variant-delivery no-error.
      205     if error-status:error then do:
      206        run err-mess(substitute("Ошибка при сохранении записи ВАРИАНТ ДОСТАВКИ: тип доставки &1, код субъекта доставки &2, объект доставки &3&4: &5: &6"
      207                                 , p-deliv-type-code
      208                                 , p-deliv-subj-code
      209                                 , p-deliv-obj-type
      210                                 , p-deliv-obj-code
      211                                 , ERROR-STATUS:GET-message(1)
      212                                 , return-value
      213                                 )).
      214       undo, return error "":U.
      215    end.
      216   end.
      217   PROCEDURE err-mess:
      218     DEFINE INPUT PARAMETER p-mess as character No-UNDO.
      219         message
      220         p-mess
      221         view-as alert-box error .
      222   END PROCEDURE.
