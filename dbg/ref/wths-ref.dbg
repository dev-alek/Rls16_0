     1497   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     1498   DO:
     1499   define variable del-rec as recid no-undo.
     1500   define variable glog as logical no-undo .
     1501   define variable rep-rec as recid no-undo .
     1502   if not available X_wth-ser then do:
     1503     message "Неправильно выбрана строка.".
     1504     return no-apply.
     1505   end.
     1506   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1507   do:
     1508     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1509       (input  v-cntxt-db-num
