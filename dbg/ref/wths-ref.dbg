     1596   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1597   DO:
     1598   define variable glog as logical no-undo .
     1599     if available X_wth-ser then do:
     1600   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1601   define variable v-str-recid16 as character no-undo .
     1602   define variable v-num-entry16 as integer   no-undo .
     1603   assign
     1604     v-str-recid16 = trim( string( recid( X_wth-ser ) , "->>>>>>>>>>>9":U ) )
     1605     v-num-entry16 = lookup( v-str-recid16 , rid-list )
     1606   .
     1607   if v-num-entry16 > 0 then do:
     1608     assign
     1609       entry( v-num-entry16, rid-list ) = "":U
     1610       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1611     .
     1612   end.
     1613   else do:
     1614     assign
     1615       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid16
     1616     .
     1617   end.
     1618       br-wths:refresh().
     1619       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1620               glog = br-wths:select-next-row ().
     1621               apply "iteration-changed" to br-wths in frame Dialog-Frame.
     1622           end.
     1623       if num-entries( rid-list ) = 0 then
     1624           hide mark-num in frame Dialog-Frame.
     1625       else
     1626           disp num-entries( rid-list ) @ mark-num with frame Dialog-Frame.
     1627     end.
     1628     apply "entry" to br-wths in frame Dialog-Frame.
     1629   END.
     1630   ON CHOOSE OF B-parts IN FRAME Dialog-Frame
     1631   DO:
     1632   define variable glog as logical no-undo .
     1633   define variable rep-rec as recid no-undo .
