     1652   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1653   DO:
     1654   define variable doc-rec as recid no-undo .
     1655       doc-rec = recid( X_wth-ser ).
     1656       DO WHILE available X_wth-ser :
     1657             GET prev br-wths.
     1658       END.
     1659     run PrintProc in this-procedure no-error.
     1660     reposition br-wths to recid doc-rec no-error.
     1661     apply "entry" to br-wths in frame Dialog-Frame.
     1662   END.
     1663   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     1664   DO:
     1665     assign rid-list = ''
     1666     .
     1667     RUN save-position IN THIS-PROCEDURE.
     1668   END.
     1669   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1670   DO:
     1671     assign
     1672     tbl = 'wth-ser'
     1673     join-tbl = 'X_wth-ser'
     1674     dim = '0':U
     1675     fld = '':U
     1676     lab = '':U
     1677     spr = '':U
     1678     .
     1679     run fltfield-add in this-procedure('wth-code', 'Код МЦ', '',
     1680     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1681     run fltfield-add in this-procedure('ser-code', '', '',
     1682     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1683     run fltfield-add in this-procedure('series', '', '',
     1684     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1685     run fltfield-add in this-procedure('maska', '', '',
     1686     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     1687       DO on stop undo, leave:
     1688           run gbl/filter.w ( input parparentproc
     1689                            , input filter-point
     1690                            , input tbl
     1691                            , input join-tbl
     1692                            , input  fld
     1693                            , input lab
     1694                            , input spr
     1695                            , input dim).
     1696           RUN OpenBr in this-procedure .
     1697       END .
     1698   END.
     1699   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1700   DO:
     1701       if ( available X_wth-ser AND rid-list = "" ) then
     1702           rid-list = string( recid( X_wth-ser ) ) .
     1703   END.
     1704   ON MOUSE-SELECT-DBLCLICK OF BR-wths IN FRAME Dialog-Frame
     1705   DO:
     1706       if lookup("b-sel", bttns) > 0 then APPLY "CHOOSE" to b-sel.
     1707   END.
     1708   ON RETURN OF BR-wths IN FRAME Dialog-Frame
     1709   DO:
     1710       if lookup("b-sel", bttns) > 0 then APPLY "CHOOSE" to b-sel.
     1711   END.
     1712   ON VALUE-CHANGED OF rsfl-par IN FRAME Dialog-Frame
     1713   DO:
     1714     RUN OpenBr.
     1715   END.
     1716   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1717   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1718   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1719   on help of frame Dialog-Frame
     1720   do:
     1721     run gbl/app_help.p
     1722       (input this-procedure :file-name
     1723       ,input ''
     1724       ,input ?
     1725       ) no-error.
     1726     if error-status :error then do:
     1727       message
     1728         "Ошибка при вызове помощи"
     1729         error-status :get-message(1)
     1730         view-as alert-box .
     1731     end.
     1732   end.
     1733   run minbtn-set in this-procedure .
     1734   on choose of b-help in frame Dialog-Frame
     1735   do:
     1736     apply "help":u to frame Dialog-Frame .
     1737   end.
     1738   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1739   procedure minbtn-set :
     1740       do
     1741           on error undo, return error return-value
     1742           :
     1743           define variable ii              as integer       no-undo .
     1744           define variable fh              as widget-handle no-undo .
     1745           define variable hh              as widget-handle no-undo .
     1746           define variable v-h             as handle        extent 4 no-undo .
     1747           define variable v-name-button   as character     no-undo .
     1748           define variable v-help-old-x    as decimal       no-undo .
     1749           define variable v-help-old-y    as decimal       no-undo .
     1750           define variable v-help-old-size as decimal       no-undo .
     1751           define variable v-frame-width   as decimal       no-undo .
     1752           define variable jj              as integer       no-undo .
     1753           do
     1754               on error undo, return error
     1755               :
     1756               assign
     1757                   v-frame-width = frame Dialog-Frame:width - 0.3
     1758                   fh            = frame Dialog-Frame:first-child
     1759                   hh            = fh:first-child
     1760                   ii            = 1
     1761                   .
     1762               do while valid-handle(hh):
     1763                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1764                   do:
     1765                       case lc(hh:name) :
     1766                           when "b-help" then
     1767                               do:
     1768                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1769                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1770                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1771                                   hh:TOOLTIP = "Помощь" .
     1772                                   v-help-old-x = hh:column .
     1773                                   v-help-old-y = hh:row    .
     1774                                   v-help-old-size = hh:width .
     1775                                   hh:width-chars = 2.5 .
     1776                               end.
     1777                           when "b-print" then
     1778                               do:
     1779                                   hh:load-image("cmp/b-print.bmp":u) .
     1780                                   hh:TOOLTIP = "Печать" .
     1781                                   v-h[ii] = hh:handle .
     1782                                   ii = ii + 1 .
     1783                                   hh:width-chars = 3 .
     1784                               end.
     1785                           when "b-history" or
     1786                           when "b-hist" then
     1787                               do:
     1788                                   hh:load-image("cmp/b-hist.bmp":u) .
     1789                                   hh:TOOLTIP = "История" .
     1790                                   v-h[ii] = hh:handle .
     1791                                   ii = ii + 1 .
     1792                                   hh:width-chars = 3 .
     1793                               end.
     1794                           when "b-sch" then
     1795                               do:
     1796                                   hh:load-image("cmp/b-sch.bmp":u) .
     1797                                   hh:TOOLTIP = "Установка Фильтра" .
     1798                                   v-h[ii] = hh:handle .
     1799                                   ii = ii + 1 .
     1800                                   hh:width-chars = 3 .
     1801                               end.
     1802                           when "b-hist-user" then
     1803                               do:
     1804                                   hh:load-image("cmp/b-hist.bmp":u) .
     1805                                   hh:TOOLTIP = "История пользователя" .
     1806                                   ii = ii + 1 .
     1807                               end.
     1808                       end case.
     1809                   end.
     1810                   hh = hh:next-sibling.
     1811               end.
     1812               b-help:column = v-frame-width - b-help:width-chars.
     1813               jj = 0.
     1814               repeat ii = 4 to 1 by -1 :
     1815                   if valid-handle (v-h[ii] ) then
     1816                   do:
     1817                       jj  = jj + 1 .
     1818                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1819                       v-h[ii]:row    = v-help-old-y .
     1820                   end.
     1821               end.
     1822           end.
     1823       end.
     1824   end procedure.
     1825   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1826   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1827   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1828   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1829   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1830   define variable v-diasize-current-frame-height as decimal   no-undo .
     1831   define variable v-diasize-change-size          as logical   no-undo .
     1832   define variable v-diasize-resize-button        as handle    no-undo .
     1833   define variable v-diasize-wndmax               as logical   no-undo .
     1834   define variable v-diasize-wndstore             as logical   no-undo .
     1835   define variable v-diasize-proc-name            as character no-undo .
     1836   define variable v-diasize-browse-handle        as handle    no-undo .
     1837   define variable v-diasize-browse-number        as integer   no-undo .
     1838   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1839   define temp-table temp-diasize-handle no-undo
     1840     field handle-value  as handle
     1841     field save-position as decimal
     1842     index xpk is primary unique handle-value
     1843     .
     1844   define temp-table temp-browse-handle no-undo
     1845     field browse-type   as character
     1846     field browse-number as integer
     1847     field browse-handle as handle
     1848     field original-size as decimal
     1849     index xpk is primary unique browse-type browse-number
     1850     index xie browse-type browse-handle
     1851   .
     1852   procedure diasize_change-height :
     1853     define input  parameter p-change-value  as decimal   no-undo .
     1854     define input  parameter p-move-resize   as logical   no-undo .
     1855     define variable v-field-group-handle    as handle    no-undo .
     1856     define variable v-object-handle         as handle    no-undo .
     1857     define variable v-frame-height          as decimal   no-undo .
     1858     define variable v-frame-virtual-height  as decimal   no-undo .
     1859     define variable v-browse-height         as decimal   no-undo .
     1860     define variable v-window-height         as decimal   no-undo .
     1861     define variable v-window-virtual-height as decimal   no-undo .
     1862     define variable v-change-sign           as integer   no-undo .
     1863     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1864     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1865     if p-change-value > 0
     1866     then do:
     1867       if frame Dialog-Frame :height + p-change-value
     1868           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1869       then do:
     1870         assign
     1871           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1872                           - (frame Dialog-Frame :height-chars)
     1873         .
     1874         if p-change-value <= 0
     1875         then do:
     1876           run diasize_position-resize-button in this-procedure .
     1877           return .
     1878         end.
     1879       end.
     1880     end.
     1881     if p-change-value < 0
     1882     then do:
     1883       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1884       then do:
     1885         assign
     1886           p-change-value = v-diasize-orig-frame-height
     1887                          - (frame Dialog-Frame :height-chars)
     1888         .
     1889         if p-change-value >= 0
     1890         then do:
     1891           run diasize_position-resize-button in this-procedure .
     1892           return .
     1893         end.
     1894       end.
     1895     end.
     1896     if p-change-value >= 0
     1897     then do:
     1898       assign
     1899         v-change-sign = 1
     1900       .
     1901     end.
     1902     else do:
     1903       assign
     1904         v-change-sign = -1
     1905       .
     1906     end.
     1907     assign
     1908       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1909     .
     1910     if p-change-value = 0
     1911     then do:
     1912       run diasize_position-resize-button in this-procedure .
     1913       return .
     1914     end.
     1915     move_block:
     1916     do
     1917     on error undo move_block, retry move_block
     1918     :
     1919       if retry
     1920       then do:
     1921         do
     1922         on error undo move_block, leave move_block
     1923         :
     1924           if p-change-value > 0
     1925           then do:
     1926             for each buf_temp-diasize-handle
     1927             on error undo, next
     1928             :
     1929               assign
     1930                 v-object-handle = buf_temp-diasize-handle.handle-value
     1931               .
     1932               if v-object-handle <> v-diasize-resize-button
     1933               then do:
     1934                 assign
     1935                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1936                 .
     1937               end.
     1938             end.
     1939             assign
     1940               v-diasize-browse-handle :height = v-browse-height
     1941             .
     1942             for each buf_temp-browse-handle
     1943               where buf_temp-browse-handle.browse-type = 'height':u
     1944             on error undo, next
     1945             :
     1946               assign
     1947                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1948               .
     1949             end.
     1950             assign
     1951               frame Dialog-Frame :height = v-frame-height
     1952             .
     1953             if frame Dialog-Frame :scrollable = true
     1954             then do:
     1955               assign
     1956                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1957               .
     1958             end.
     1959             run diasize_position-resize-button in this-procedure .
     1960           end.
     1961           else do:
     1962             if frame Dialog-Frame :scrollable = true
     1963             then do:
     1964               assign
     1965                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1966               .
     1967             end.
     1968             assign
     1969               frame Dialog-Frame :height = v-frame-height
     1970             .
     1971             assign
     1972               v-diasize-browse-handle :height = v-browse-height
     1973             .
     1974             for each buf_temp-browse-handle
     1975               where buf_temp-browse-handle.browse-type = 'height':u
     1976             on error undo, next
     1977             :
     1978               assign
     1979                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1980               .
     1981             end.
     1982             for each buf_temp-diasize-handle
     1983             on error undo, next
     1984             :
     1985               assign
     1986                 v-object-handle = buf_temp-diasize-handle.handle-value
     1987               .
     1988               if v-object-handle <> v-diasize-resize-button
     1989               then do:
     1990                 assign
     1991                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1992                 .
     1993               end.
     1994             end.
     1995             run diasize_position-resize-button in this-procedure .
     1996           end.
     1997           assign
     1998             v-diasize-change-size = false
     1999           .
     2000           leave move_block .
     2001         end.
     2002       end.
     2003       assign
     2004         v-diasize-need-full-display = true
     2005       .
     2006       if v-diasize-change-size = false
     2007       then do:
     2008         assign
     2009           v-diasize-change-size = true
     2010         .
     2011       end.
     2012       else do:
     2013         return .
     2014       end.
     2015       assign
     2016         v-frame-height = frame Dialog-Frame :height
     2017         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2018         v-browse-height = v-diasize-browse-handle :height
     2019       .
     2020       for each buf_temp-browse-handle
     2021         where buf_temp-browse-handle.browse-type = 'height':u
     2022       :
     2023         assign
     2024           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2025         .
     2026       end.
     2027       for each buf_temp-diasize-handle
     2028       :
     2029         delete buf_temp-diasize-handle .
     2030       end.
     2031       assign
     2032         v-field-group-handle = frame Dialog-Frame :first-child
     2033       .
     2034       do while valid-handle(v-field-group-handle)
     2035       :
     2036         assign
     2037           v-object-handle = v-field-group-handle :first-child
     2038         .
     2039         do while valid-handle(v-object-handle)
     2040         :
     2041           if  v-object-handle <> v-diasize-browse-handle :handle
     2042           and can-query(v-object-handle, "row")
     2043           and can-query(v-object-handle, "height")
     2044           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2045           then do:
     2046             find first buf_temp-browse-handle
     2047               where buf_temp-browse-handle.browse-type   = 'height':u
     2048                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2049               no-error .
     2050             if available buf_temp-browse-handle
     2051             then do:
     2052             end.
     2053             else do:
     2054               create buf_temp-diasize-handle .
     2055               assign
     2056                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2057                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2058               .
     2059             end.
     2060           end.
     2061           assign
     2062             v-object-handle = v-object-handle :next-sibling
     2063           .
     2064         end.
     2065         assign
     2066           v-field-group-handle = v-field-group-handle :next-sibling
     2067         .
     2068       end.
     2069       do with frame Dialog-Frame
     2070       :
     2071         hide v-diasize-resize-button .
     2072         assign
     2073           v-diasize-resize-button :row    = 1
     2074           v-diasize-resize-button :column = 1
     2075         .
     2076       end.
     2077       if p-change-value > 0
     2078       then do:
     2079         if frame Dialog-Frame :scrollable = true
     2080         then do:
     2081           assign
     2082             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2083             no-error .
     2084           if error-status :error
     2085           or error-status :get-message(1) <> ""
     2086           then do:
     2087             undo move_block, retry move_block .
     2088           end.
     2089         end.
     2090         assign
     2091           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2092           no-error .
     2093         if error-status :error
     2094         or error-status :get-message(1) <> ""
     2095         then do:
     2096           undo move_block, retry move_block .
     2097         end.
     2098         assign
     2099           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2100           no-error .
     2101         if error-status :error
     2102         or error-status :get-message(1) <> ""
     2103         then do:
     2104           undo move_block, retry move_block .
     2105         end.
     2106         for each buf_temp-browse-handle
     2107           where buf_temp-browse-handle.browse-type = 'height':u
     2108         on error undo move_block, retry move_block
     2109         :
     2110           assign
     2111             buf_temp-browse-handle.browse-handle :height
     2112               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2113             no-error .
     2114           if error-status :error
     2115           or error-status :get-message(1) <> ""
     2116           then do:
     2117             undo move_block, retry move_block .
     2118           end.
     2119         end.
     2120         for each buf_temp-diasize-handle
     2121         on error undo move_block, retry move_block
     2122         :
     2123           assign
     2124             v-object-handle = buf_temp-diasize-handle.handle-value
     2125           .
     2126           if v-object-handle <> v-diasize-resize-button
     2127           then do:
     2128             assign
     2129               v-object-handle :row = v-object-handle :row + p-change-value
     2130               no-error .
     2131             if error-status :error
     2132             or error-status :get-message(1) <> ""
     2133             then do:
     2134               undo move_block, retry move_block .
     2135             end.
     2136           end.
     2137         end.
     2138       end.
     2139       else do:
     2140         for each buf_temp-diasize-handle
     2141         on error undo move_block, retry move_block
     2142         :
     2143           assign
     2144             v-object-handle = buf_temp-diasize-handle.handle-value
     2145           .
     2146           if v-object-handle <> v-diasize-resize-button
     2147           then do:
     2148             assign
     2149               v-object-handle :row = v-object-handle :row + p-change-value
     2150               no-error .
     2151             if error-status :error
     2152             or error-status :get-message(1) <> ""
     2153             then do:
     2154               undo move_block, retry move_block .
     2155             end.
     2156           end.
     2157         end.
     2158         assign
     2159           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2160           no-error .
     2161         if error-status :error
     2162         or error-status :get-message(1) <> ""
     2163         then do:
     2164           undo move_block, retry move_block .
     2165         end.
     2166         for each buf_temp-browse-handle
     2167           where buf_temp-browse-handle.browse-type = 'height':u
     2168         on error undo move_block, retry move_block
     2169         :
     2170           assign
     2171             buf_temp-browse-handle.browse-handle :height
     2172               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2173             no-error .
     2174           if error-status :error
     2175           or error-status :get-message(1) <> ""
     2176           then do:
     2177             undo move_block, retry move_block .
     2178           end.
     2179         end.
     2180         assign
     2181           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2182           no-error .
     2183         if error-status :error
     2184         or error-status :get-message(1) <> ""
     2185         then do:
     2186           undo move_block, retry move_block .
     2187         end.
     2188         if frame Dialog-Frame :scrollable = true
     2189         then do:
     2190           assign
     2191             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2192             no-error .
     2193           if error-status :error
     2194           or error-status :get-message(1) <> ""
     2195           then do:
     2196             undo move_block, retry move_block .
     2197           end.
     2198         end.
     2199       end.
     2200       if p-move-resize = true
     2201       then do:
     2202         run diasize_position-resize-button in this-procedure .
     2203       end.
     2204       if v-diasize-wndstore = true
     2205       then do:
     2206         if connected("ub") = true
     2207         then do:
     2208           define variable v-cntxt-db-num        as integer   no-undo .
     2209           define variable v-cntxt-userid        as character no-undo .
     2210           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2211                                             , OUTPUT v-cntxt-userid
     2212                                             ) .
     2213           run gbl/wndsizew.p
     2214             (input  v-cntxt-db-num
     2215             ,input  v-cntxt-userid
     2216             ,input  v-diasize-proc-name
     2217             ,input  'height':u
     2218             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2219             ) .
     2220         end.
     2221       end.
     2222     end.
     2223     assign
     2224       v-diasize-change-size = false
     2225     .
     2226   end procedure.
     2227   procedure diasize_set-height :
     2228     define input  parameter p-new-height  as decimal   no-undo .
     2229     define input  parameter p-move-resize as logical   no-undo .
     2230     do
     2231     on error undo, return error return-value
     2232     :
     2233       run diasize_change-height in this-procedure
     2234         (input  (p-new-height - frame Dialog-Frame :height)
     2235         ,input  p-move-resize
     2236         ) .
     2237     end.
     2238   end procedure.
     2239   procedure diasize_change-width :
     2240     define input  parameter p-change-value as decimal   no-undo .
     2241     define input  parameter p-move-resize  as logical   no-undo .
     2242     define variable v-field-group-handle   as handle    no-undo .
     2243     define variable v-object-handle        as handle    no-undo .
     2244     define variable v-frame-width          as decimal   no-undo .
     2245     define variable v-frame-virtual-width  as decimal   no-undo .
     2246     define variable v-browse-width         as decimal   no-undo .
     2247     define variable v-window-width         as decimal   no-undo .
     2248     define variable v-window-virtual-width as decimal   no-undo .
     2249     define variable v-change-sign          as integer   no-undo .
     2250     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2251     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2252     if p-change-value > 0
     2253     then do:
     2254       if frame Dialog-Frame :width + p-change-value >
     2255           session :width-chars
     2256       then do:
     2257         assign
     2258           p-change-value = session :width-chars - frame Dialog-Frame :width
     2259         .
     2260         if p-change-value <= 0
     2261         then do:
     2262           run diasize_position-resize-button in this-procedure .
     2263           return .
     2264         end.
     2265       end.
     2266     end.
     2267     if p-change-value < 0
     2268     then do:
     2269       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2270       then do:
     2271         assign
     2272           p-change-value = v-diasize-orig-frame-width
     2273                          - frame Dialog-Frame :width
     2274         .
     2275         if p-change-value >= 0
     2276         then do:
     2277           run diasize_position-resize-button in this-procedure .
     2278           return .
     2279         end.
     2280       end.
     2281     end.
     2282     if p-change-value >= 0
     2283     then do:
     2284       assign
     2285         v-change-sign = 1
     2286       .
     2287     end.
     2288     else do:
     2289       assign
     2290         v-change-sign = -1
     2291       .
     2292     end.
     2293     assign
     2294       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2295     .
     2296     if p-change-value = 0
     2297     then do:
     2298       run diasize_position-resize-button in this-procedure .
     2299       return .
     2300     end.
     2301     move_block:
     2302     do
     2303     on error undo move_block, leave move_block
     2304     :
     2305       if retry
     2306       then do:
     2307         do
     2308         on error undo move_block, leave move_block
     2309         :
     2310           if p-change-value > 0
     2311           then do:
     2312             for each buf_temp-diasize-handle
     2313             on error undo, next
     2314             :
     2315               assign
     2316                 v-object-handle = buf_temp-diasize-handle.handle-value
     2317               .
     2318               if v-object-handle <> v-diasize-resize-button
     2319               then do:
     2320                 assign
     2321                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2322                 .
     2323               end.
     2324             end.
     2325             assign
     2326               v-diasize-browse-handle :width = v-browse-width
     2327             .
     2328             for each buf_temp-browse-handle
     2329               where buf_temp-browse-handle.browse-type = 'width':u
     2330             on error undo, next
     2331             :
     2332               assign
     2333                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2334               .
     2335             end.
     2336             assign
     2337               frame Dialog-Frame :width = v-frame-width
     2338             .
     2339             if frame Dialog-Frame :scrollable = true
     2340             then do:
     2341               assign
     2342                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2343               .
     2344             end.
     2345             run diasize_position-resize-button in this-procedure .
     2346           end.
     2347           else do:
     2348             if frame Dialog-Frame :scrollable = true
     2349             then do:
     2350               assign
     2351                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2352               .
     2353             end.
     2354             assign
     2355               frame Dialog-Frame :width = v-frame-width
     2356             .
     2357             for each buf_temp-browse-handle
     2358               where buf_temp-browse-handle.browse-type = 'width':u
     2359             on error undo, next
     2360             :
     2361               assign
     2362                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2363               .
     2364             end.
     2365             assign
     2366               v-diasize-browse-handle :width = v-browse-width
     2367             .
     2368             for each buf_temp-diasize-handle
     2369             on error undo, next
     2370             :
     2371               assign
     2372                 v-object-handle = buf_temp-diasize-handle.handle-value
     2373               .
     2374               if v-object-handle <> v-diasize-resize-button
     2375               then do:
     2376                 assign
     2377                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2378                 .
     2379               end.
     2380             end.
     2381             run diasize_position-resize-button in this-procedure .
     2382           end.
     2383           assign
     2384             v-diasize-change-size = false
     2385           .
     2386           leave move_block .
     2387         end.
     2388       end.
     2389       assign
     2390         v-diasize-need-full-display = true
     2391       .
     2392       if v-diasize-change-size = false
     2393       then do:
     2394         assign
     2395           v-diasize-change-size = true
     2396         .
     2397       end.
     2398       else do:
     2399         return .
     2400       end.
     2401       assign
     2402         v-frame-width = frame Dialog-Frame :width
     2403         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2404         v-browse-width = v-diasize-browse-handle :width
     2405       .
     2406       for each buf_temp-browse-handle
     2407         where buf_temp-browse-handle.browse-type = 'width':u
     2408       :
     2409         assign
     2410           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2411         .
     2412       end.
     2413       for each buf_temp-diasize-handle
     2414       :
     2415         delete buf_temp-diasize-handle .
     2416       end.
     2417       assign
     2418         v-field-group-handle = frame Dialog-Frame :first-child
     2419       .
     2420       do while valid-handle(v-field-group-handle)
     2421       :
     2422         assign
     2423           v-object-handle = v-field-group-handle :first-child
     2424         .
     2425         do while valid-handle(v-object-handle)
     2426         :
     2427           if  v-object-handle <> v-diasize-browse-handle :handle
     2428           and v-object-handle <> v-diasize-resize-button
     2429           and can-query(v-object-handle, "row")
     2430           and can-query(v-object-handle, "height")
     2431           and ( v-object-handle :col + v-object-handle :width
     2432                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2433               )
     2434           then do:
     2435             find first buf_temp-browse-handle
     2436               where buf_temp-browse-handle.browse-type   = 'width':u
     2437                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2438               no-error .
     2439             if available buf_temp-browse-handle
     2440             then do:
     2441             end.
     2442             else do:
     2443               create buf_temp-diasize-handle .
     2444               assign
     2445                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2446                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2447               .
     2448             end.
     2449           end.
     2450           assign
     2451             v-object-handle = v-object-handle :next-sibling
     2452           .
     2453         end.
     2454         assign
     2455           v-field-group-handle = v-field-group-handle :next-sibling
     2456         .
     2457       end.
     2458       do with frame Dialog-Frame
     2459       :
     2460         hide v-diasize-resize-button .
     2461         v-diasize-resize-button :row = 1.
     2462         v-diasize-resize-button :column = 1.
     2463       end.
     2464       if p-change-value > 0
     2465       then do:
     2466         if frame Dialog-Frame :scrollable = true
     2467         then do:
     2468           assign
     2469             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2470             no-error .
     2471           if error-status :error
     2472           or error-status :get-message(1) <> ""
     2473           then do:
     2474             undo move_block, retry move_block.
     2475           end.
     2476         end.
     2477         assign
     2478           frame Dialog-Frame :width = v-frame-width + p-change-value
     2479           no-error .
     2480         if error-status :error
     2481         or error-status :get-message(1) <> ""
     2482         then do:
     2483           undo move_block, retry move_block.
     2484         end.
     2485         assign
     2486           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2487         no-error .
     2488         if error-status :error
     2489         or error-status :get-message(1) <> ""
     2490         then do:
     2491           undo move_block, retry move_block.
     2492         end.
     2493         for each buf_temp-browse-handle
     2494           where buf_temp-browse-handle.browse-type = 'width':u
     2495         on error undo move_block, retry move_block
     2496         :
     2497           assign
     2498             buf_temp-browse-handle.browse-handle :width
     2499               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2500             no-error .
     2501           if error-status :error
     2502           or error-status :get-message(1) <> ""
     2503           then do:
     2504             undo move_block, retry move_block .
     2505           end.
     2506         end.
     2507         for each buf_temp-diasize-handle
     2508         on error undo move_block, retry move_block
     2509         :
     2510           assign
     2511             v-object-handle = buf_temp-diasize-handle.handle-value
     2512           .
     2513           if v-object-handle <> v-diasize-resize-button
     2514           then do:
     2515             assign
     2516               v-object-handle :col = v-object-handle :col + p-change-value
     2517               no-error .
     2518             if error-status :error
     2519             or error-status :get-message(1) <> ""
     2520             then do:
     2521               undo move_block, retry move_block .
     2522             end.
     2523           end.
     2524         end.
     2525       end.
     2526       else do:
     2527         for each buf_temp-diasize-handle
     2528         on error undo move_block, retry move_block
     2529         :
     2530           assign
     2531             v-object-handle = buf_temp-diasize-handle.handle-value
     2532           .
     2533           if v-object-handle <> v-diasize-resize-button
     2534           then do:
     2535             assign
     2536               v-object-handle :col = v-object-handle :col + p-change-value
     2537               no-error .
     2538             if error-status :error
     2539             or error-status :get-message(1) <> ""
     2540             then do:
     2541               undo move_block, retry move_block .
     2542             end.
     2543           end.
     2544         end.
     2545         for each buf_temp-browse-handle
     2546           where buf_temp-browse-handle.browse-type = 'width':u
     2547         on error undo move_block, retry move_block
     2548         :
     2549           assign
     2550             buf_temp-browse-handle.browse-handle :width
     2551               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2552             no-error .
     2553           if error-status :error
     2554           or error-status :get-message(1) <> ""
     2555           then do:
     2556             undo move_block, retry move_block .
     2557           end.
     2558         end.
     2559         assign
     2560           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2561           no-error .
     2562         if error-status :error
     2563         or error-status :get-message(1) <> ""
     2564         then do:
     2565           undo move_block, retry move_block.
     2566         end.
     2567         assign
     2568           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2569         no-error .
     2570         if error-status :error
     2571         or error-status :get-message(1) <> ""
     2572         then do:
     2573           undo move_block, retry move_block.
     2574         end.
     2575         if frame Dialog-Frame :scrollable = true
     2576         then do:
     2577           assign
     2578             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2579           no-error .
     2580           if error-status :error
     2581           or error-status :get-message(1) <> ""
     2582           then do:
     2583             undo move_block, retry move_block.
     2584           end.
     2585         end.
     2586       end.
     2587       if p-move-resize
     2588       then do:
     2589         run diasize_position-resize-button in this-procedure .
     2590       end.
     2591       if v-diasize-wndstore = true
     2592       then do:
     2593         if connected("ub") = true
     2594         then do:
     2595           define variable v-cntxt-db-num        as integer   no-undo .
     2596           define variable v-cntxt-userid        as character no-undo .
     2597           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2598                                             , OUTPUT v-cntxt-userid
     2599                                             ) .
     2600           run gbl/wndsizew.p
     2601             (input  v-cntxt-db-num
     2602             ,input  v-cntxt-userid
     2603             ,input  v-diasize-proc-name
     2604             ,input  'width':u
     2605             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2606             ) .
     2607         end.
     2608       end.
     2609     end.
     2610     assign
     2611       v-diasize-change-size = false
     2612     .
     2613   end procedure.
     2614   procedure diasize_set-width :
     2615     define input  parameter p-new-width  as decimal   no-undo .
     2616     define input  parameter p-move-resize as logical   no-undo .
     2617     do
     2618     on error undo, return error return-value
     2619     :
     2620       run diasize_change-width in this-procedure
     2621         (input  (p-new-width - frame Dialog-Frame :width)
     2622         ,input  p-move-resize
     2623         ) .
     2624     end.
     2625   end procedure.
     2626   procedure diasize_position-resize-button :
     2627     do with frame Dialog-Frame
     2628     :
     2629       hide v-diasize-resize-button .
     2630       assign
     2631         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2632                     - 1
     2633                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2634         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2635                     - 1
     2636                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2637       .
     2638       view v-diasize-resize-button .
     2639     end.
     2640   end procedure.
     2641   on alt-right anywhere
     2642   do:
     2643     run diasize_change-width in this-procedure
     2644       (input 1
     2645       ,input true
     2646       ) .
     2647     return no-apply .
     2648   end.
     2649   on alt-left anywhere
     2650   do:
     2651     run diasize_change-width in this-procedure
     2652       (input -1
     2653       ,input true
     2654       ) .
     2655     return no-apply .
     2656   end.
     2657   on alt-down anywhere
     2658   do:
     2659     run diasize_change-height in this-procedure
     2660       (input 1
     2661       ,input true
     2662       ) .
     2663     return no-apply .
     2664   end.
     2665   on alt-up anywhere
     2666   do:
     2667     run diasize_change-height in this-procedure
     2668       (input -1
     2669       ,input true
     2670       ) .
     2671     return no-apply .
     2672   end.
     2673   on alt-enter of frame Dialog-Frame
     2674   do:
     2675     run diasize_maximize in this-procedure
     2676       (input  ?
     2677       ).
     2678     return no-apply .
     2679   end.
     2680   procedure diasize_end-move :
     2681     do
     2682     on error undo, return error return-value
     2683     :
     2684       define variable v-row-delta as decimal   no-undo .
     2685       define variable v-col-delta as decimal   no-undo .
     2686       define variable v-new-row as decimal   no-undo .
     2687       define variable v-new-col as decimal   no-undo .
     2688       assign
     2689         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2690         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2691       .
     2692       assign
     2693         v-row-delta = v-new-row - frame Dialog-Frame :height
     2694         v-col-delta = v-new-col - frame Dialog-Frame :width
     2695       .
     2696       run diasize_change-height in this-procedure
     2697         (input v-row-delta
     2698         ,input true
     2699         ) .
     2700       run diasize_change-width in this-procedure
     2701         (input v-col-delta
     2702         ,input true
     2703         ) .
     2704     end.
     2705   end procedure.
     2706   procedure diasize_maximize :
     2707     define input  parameter p-action as logical   no-undo .
     2708     do
     2709     on error undo, return error return-value
     2710     :
     2711       if p-action = ?
     2712       then do:
     2713         if v-diasize-need-maximize = true
     2714         then do:
     2715           assign
     2716             p-action = true
     2717           .
     2718         end.
     2719         else do:
     2720           assign
     2721             p-action = false
     2722           .
     2723         end.
     2724       end.
     2725       if p-action = true
     2726       then do:
     2727         run diasize_change-height in this-procedure
     2728           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2729               - frame Dialog-Frame :height-chars
     2730           ,input true
     2731           ) .
     2732         run diasize_change-width in this-procedure
     2733           (input session :width-chars
     2734               - frame Dialog-Frame :width-chars
     2735           ,input true
     2736           ) .
     2737         assign
     2738           v-diasize-need-maximize = false
     2739         .
     2740       end.
     2741       else do:
     2742         run diasize_change-width in this-procedure
     2743           (input v-diasize-orig-frame-width
     2744               - frame Dialog-Frame :width-chars
     2745           ,input true
     2746           ) .
     2747         run diasize_change-height in this-procedure
     2748           (input v-diasize-orig-frame-height
     2749               - frame Dialog-Frame :height-chars
     2750           ,input true
     2751           ) .
     2752         assign
     2753           v-diasize-need-maximize = true
     2754         .
     2755       end.
     2756     end.
     2757   end procedure.
     2758   procedure diasize_restore-orig-size :
     2759     do
     2760     on error undo, return error return-value
     2761     :
     2762       assign
     2763         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2764         v-diasize-current-frame-height = frame Dialog-Frame :height
     2765       .
     2766       run diasize_set-height in this-procedure
     2767         (input  v-diasize-orig-frame-height
     2768         ,input  true
     2769         ) .
     2770       run diasize_set-width in this-procedure
     2771         (input  v-diasize-orig-frame-width
     2772         ,input  true
     2773         ) .
     2774     end.
     2775   end procedure.
     2776   procedure diasize_restore-current-size :
     2777     do
     2778     on error undo, return error return-value
     2779     :
     2780       run diasize_set-height in this-procedure
     2781         (input  v-diasize-current-frame-height
     2782         ,input  true
     2783         ) .
     2784       run diasize_set-width in this-procedure
     2785         (input  v-diasize-current-frame-width
     2786         ,input  true
     2787         ) .
     2788     end.
     2789   end procedure.
     2790   procedure diasize_set-browse-handle :
     2791     define input  parameter p-browse-handle as handle   no-undo .
     2792     define buffer buf_temp-browse-handle for temp-browse-handle .
     2793     do
     2794     on error undo, return error return-value
     2795     :
     2796       assign
     2797         v-diasize-browse-handle = p-browse-handle
     2798       .
     2799       for each buf_temp-browse-handle
     2800       on error undo, return error return-value
     2801       :
     2802         delete buf_temp-browse-handle .
     2803       end.
     2804     end.
     2805   end procedure.
     2806   procedure diasize_add_browse :
     2807     define input  parameter p-browse-type   as character no-undo .
     2808     define input  parameter p-browse-handle as handle    no-undo .
     2809     define buffer buf_temp-browse-handle for temp-browse-handle .
     2810     do
     2811     on error undo, return error return-value
     2812     :
     2813       assign
     2814         v-diasize-browse-number = v-diasize-browse-number + 1
     2815       .
     2816       create buf_temp-browse-handle .
     2817       assign
     2818         buf_temp-browse-handle.browse-type   = p-browse-type
     2819         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2820         buf_temp-browse-handle.browse-handle = p-browse-handle
     2821       .
     2822     end.
     2823   end procedure.
     2824   procedure diasize_init :
     2825     define variable v-default-value    as logical   no-undo .
     2826     define variable v-restore-saved    as logical   no-undo .
     2827     define variable v-resize-value-str as character no-undo .
     2828     do
     2829     on error undo, return error return-value
     2830     :
     2831       do with frame Dialog-Frame
     2832       :
     2833         assign
     2834           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2835           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2836           v-diasize-browse-handle     = browse BR-wths :handle
     2837         .
     2838         create button v-diasize-resize-button
     2839         assign
     2840           parent        = frame Dialog-Frame :first-child
     2841           label         = "s"
     2842           height-pixels = 16
     2843           width-pixels  = 16
     2844           visible       = true
     2845           sensitive     = true
     2846           movable       = true
     2847           triggers:
     2848             on end-move persistent run diasize_end-move in this-procedure .
     2849           end triggers.
     2850         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2851         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2852         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2853         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2854         assign
     2855           v-diasize-wndmax = false
     2856         .
     2857         if connected("ub") = true
     2858         then do:
     2859           define variable v-cntxt-db-num        as integer   no-undo .
     2860           define variable v-cntxt-userid        as character no-undo .
     2861           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2862                                             , OUTPUT v-cntxt-userid
     2863                                             ) .
     2864           run gbl/wndpar_r.p
     2865             (input  v-cntxt-db-num
     2866             ,input  v-cntxt-userid
     2867             ,input  'wndmax':U
     2868             ,output v-diasize-wndmax
     2869             ,output v-default-value
     2870             ) .
     2871         end.
     2872         assign
     2873           v-diasize-wndstore = false
     2874         .
     2875         if connected("ub") = true
     2876         then do:
     2877           run gbl/wndpar_r.p
     2878             (input  v-cntxt-db-num
     2879             ,input  v-cntxt-userid
     2880             ,input  'wndstore':U
     2881             ,output v-diasize-wndstore
     2882             ,output v-default-value
     2883             ) .
     2884         end.
     2885         assign
     2886           v-diasize-proc-name = entry(1, program-name(2), '.')
     2887         .
     2888         if v-diasize-wndstore = true
     2889         then do:
     2890           assign
     2891             v-restore-saved = false
     2892           .
     2893           if connected("ub") = true
     2894           then do:
     2895             run gbl/wndsizer.p
     2896               (input  v-cntxt-db-num
     2897               ,input  v-cntxt-userid
     2898               ,input  v-diasize-proc-name
     2899               ,input  'height':u
     2900               ,output v-resize-value-str
     2901               ) .
     2902             if v-resize-value-str <> '':U
     2903             then do:
     2904               run diasize_change-height in this-procedure
     2905                 (input  integer(v-resize-value-str)
     2906                 ,input  true
     2907                 ) .
     2908               assign
     2909                 v-restore-saved = true
     2910               .
     2911             end.
     2912           end.
     2913           if connected("ub") = true
     2914           then do:
     2915             run gbl/wndsizer.p
     2916               (input  v-cntxt-db-num
     2917               ,input  v-cntxt-userid
     2918               ,input  v-diasize-proc-name
     2919               ,input  'width':u
     2920               ,output v-resize-value-str
     2921               ) .
     2922             if v-resize-value-str <> '':U
     2923             then do:
     2924               run diasize_change-width in this-procedure
     2925                 (input  integer(v-resize-value-str)
     2926                 ,input  true
     2927                 ) .
     2928               assign
     2929                 v-restore-saved = true
     2930               .
     2931             end.
     2932           end.
     2933           if v-restore-saved <> true
     2934           then do:
     2935             if v-diasize-wndmax = true
     2936             then do:
     2937               run diasize_maximize in this-procedure
     2938                 (input  true
     2939                 ) .
     2940             end.
     2941           end.
     2942         end.
     2943         else do:
     2944           if v-diasize-wndmax = true
     2945           then do:
     2946             run diasize_maximize in this-procedure
     2947               (input  true
     2948               ) .
     2949           end.
     2950         end.
     2951       end.
     2952     end.
     2953   end procedure.
     2954   procedure diasize_need-full-display :
     2955     define output parameter p-need-full-display as logical   no-undo .
     2956     do
     2957     on error undo, return error return-value
     2958     :
     2959       assign
     2960         p-need-full-display = v-diasize-need-full-display
     2961       .
     2962       assign
     2963         v-diasize-need-full-display = false
     2964       .
     2965     end.
     2966   end procedure.
     2967   procedure get-context :
     2968      define output parameter p-db-num as integer          no-undo.
     2969      define output parameter p-user-id as character        no-undo.
     2970      define variable v-login               as character    no-undo.
     2971      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2972      define buffer buf_user-login  for ub.user-login .
     2973      do
     2974      on error undo, return error
     2975      :
     2976            FIND FIRST buf_sys-ctrl no-lock.
     2977            ASSIGN
     2978               v-login = USERID("ub")
     2979               p-db-num = buf_sys-ctrl.db-num
     2980            .
     2981            FIND FIRST buf_user-login
     2982                 WHERE buf_user-login.db-num = p-db-num
     2983                   AND buf_user-login.user-login = v-login
     2984                 no-lock
     2985                 no-error
     2986                 .
     2987            IF AVAILABLE buf_user-login
     2988            THEN DO:
     2989               assign
     2990                  p-user-id = buf_user-login.user-id
     2991               .
     2992            END.
     2993      end.
     2994   end procedure.
     2995       run diasize_init in this-procedure .
     2996   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2997   procedure set-filter-name :
     2998   define input parameter p-filter-name as character no-undo .
     2999     do with frame Dialog-Frame:
     3000       if p-filter-name > "" then do:
     3001         assign
     3002           frame Dialog-Frame:title
     3003             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     3004         .
     3005         assign
     3006           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     3007         .
     3008       end.
     3009       else do:
     3010         assign
     3011           b-sch :tooltip = ""
     3012         .
     3013       end.
     3014     end.
     3015   end procedure.
     3016   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3017   on INS of frame Dialog-Frame anywhere do:
     3018     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     3019     return no-apply.
     3020   end.
     3021   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3022   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     3023     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
     3024     return no-apply.
     3025   end.
     3026   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3027   on F4 of frame Dialog-Frame anywhere do:
     3028     if b-chg :sensitive then DO: apply "CHOOSE":U to b-chg in frame Dialog-Frame. END.
     3029     return no-apply.
     3030   end.
     3031   define variable vss-include-info24 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3032   on F8 of frame Dialog-Frame anywhere do:
     3033     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame Dialog-Frame. END.
     3034     return no-apply.
     3035   end.
     3036   define variable vss-include-info25 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3037   on F2 of frame Dialog-Frame anywhere do:
     3038     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     3039     return no-apply.
     3040   end.
     3041   define variable vss-include-info26 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3042   on F2 of frame Dialog-Frame anywhere do:
     3043     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     3044     return no-apply.
     3045   end.
     3046   define variable vss-include-info27 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3047   on CTRL-P, CTRL-З of frame Dialog-Frame anywhere do:
     3048     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame Dialog-Frame. END.
     3049     return no-apply.
     3050   end.
     3051   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3052   do:
     3053     BR-wths :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     3054   end.
     3055   MAIN-BLOCK:
     3056   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3057      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3058   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3059     run mainmenu_getcntxt in parparentproc
     3060       (output v-cntxt-db-num
     3061       ,output v-cntxt-userid
     3062       ,output v-cntxt-level
     3063       ,output v-cntxt-host-code-obj
     3064       ,output v-cntxt-obj-type
     3065       ,output v-cntxt-obj-code
     3066       ,output v-cntxt-db-num-obj
     3067       ,output v-cntxt-is-admin
     3068       ) .
     3069     if p-list-mode = 'МЦ':U OR p-list-mode = 'Номинал МЦ':U then do:
     3070       FIND FIRST b-wealth No-LOCK where
     3071                   b-wealth.wth-code = pwth-code No-ERROR.
     3072       IF NOT AVAIL b-wealth then do:
     3073         message vss-workfile vss-revision vss-description skip
     3074         "Не найдена материальная ценность с кодом " pwth-code
     3075         view-as alert-box.
     3076         return error.
     3077       end.
     3078     end.
     3079     if p-list-mode = 'Номинал МЦ':U then do:
     3080       FIND FIRST b-wth-par No-LOCK where
     3081                    b-wth-par.wth-code = pwth-code AND
     3082                    b-wth-par.par-code = ppar-code No-ERROR.
     3083       IF NOT AVAIL  b-wth-par then do:
     3084         message vss-workfile vss-revision vss-description skip
     3085         substitute("Не найдена номинал материальной ценности.~nКод МЦ &1~nКод номинала &2",pwth-code,ppar-code)
     3086         view-as alert-box.
     3087         return error.
     3088       end.
     3089     end.
     3090     if rid-list <> '':U then do:
     3091       assign
     3092       v-doc-rec = integer(rid-list)
     3093       no-error .
     3094     end.
     3095     RUN Myenable in this-procedure .
     3096     RUN OpenBR in this-procedure .
     3097     APPLY "ENTRY" to BR-wths.
     3098     WAIT-FOR GO OF FRAME Dialog-Frame.
     3099   END.
     3100   RUN disable_UI in this-procedure .
     3101   PROCEDURE disable_UI :
     3102     HIDE FRAME Dialog-Frame.
     3103   END PROCEDURE.
     3104   PROCEDURE enable_UI :
     3105     DISPLAY rsfl-par mark-num
     3106         WITH FRAME Dialog-Frame.
     3107     ENABLE b-quit B-mark B-sel B-add B-chg b-lkp B-del B-print B-hist B-sch
     3108            B-Help rsfl-par BR-wths mark-num
     3109         WITH FRAME Dialog-Frame.
     3110     VIEW FRAME Dialog-Frame.
     3111   END PROCEDURE.
     3112   PROCEDURE load-position :
     3113   define variable v-current-stts-string       as character    no-undo.
     3114   define variable v-void-logical              as logical      no-undo.
     3115   define variable v-void-character            as character    no-undo.
     3116   define variable v-found                     as logical      no-undo.
     3117   do   with frame Dialog-Frame
     3118   on error undo, return error
     3119   :
     3120       run uf-get (
     3121             input '&bef-wthsref-stts}':U
     3122           , input v-cntxt-userid
     3123           , output v-current-stts-string
     3124           , output v-void-character
     3125           , output v-void-logical
     3126           , output v-void-logical
     3127           , output v-void-logical
     3128           , output v-void-logical
     3129       ) no-error.
     3130       if not error-status :error then rsfl-par:screen-value =  v-current-stts-string.
     3131    end.
     3132   END PROCEDURE.
     3133   PROCEDURE MyEnable :
     3134   define variable glog as logical no-undo .
     3135       ENABLE
     3136         BR-wths
     3137         b-quit
     3138         b-parts
     3139         b-mark WHEN LOOKUP("b-mark":U, bttns) > 0
     3140         b-sel  WHEN LOOKUP("b-sel":U, bttns) > 0
     3141         b-print
     3142         b-sch
     3143         b-lkp
     3144         b-help
     3145         b-add WHEN (LOOKUP("b-add":U, bttns) > 0 )    AND g#db-num = 0
     3146         b-del WHEN (LOOKUP("b-del":U, bttns) > 0 )    AND g#db-num = 0
     3147         b-chg WHEN (LOOKUP("b-chg":U, bttns) > 0 )    AND g#db-num = 0
     3148         b-hist
     3149         rsfl-par
     3150         WITH FRAME Dialog-Frame.
     3151         run load-position in this-procedure.
     3152         VIEW FRAME Dialog-Frame.
     3153         if available X_wth-par then
     3154         glog = BR-wths:select-focused-row( ).
     3155   END PROCEDURE.
     3156   PROCEDURE OpenBr :
     3157   define variable l-query-was-opened as logical no-undo .
     3158   ASSIGN FRAME Dialog-Frame rsfl-par.
     3159   run waitfram-show in this-procedure (  input "Ждите...").
     3160   define variable sort-column-phrase as character no-undo .
     3161   case sort-column-name :
     3162     when "" then do:
     3163       assign
     3164         sort-column-phrase = ""
     3165       .
     3166     end.
     3167     otherwise do:
     3168       assign
     3169         sort-column-phrase = "by " + sort-column-name
     3170       .
     3171     end.
     3172   end case.
     3173   CASE p-list-mode:
     3174       when 'все':U then do:
     3175           ASSIGN frame Dialog-Frame:TITLE = "Серии материальных ценностей "
     3176           filter-point = "Серии материальных ценностей " + p-list-mode.
     3177   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3178   define variable  l-disable-where-31  as logical   no-undo .
     3179   define variable  l-filter-open-31    as logical   .
     3180   define variable  flt-rec-31       as recid     no-undo .
     3181   define variable  filter-name-31      as character no-undo .
     3182   define variable  where-phrase-31     as character no-undo .
     3183   define variable  sort-phrase-31      as character no-undo .
     3184   define variable  where-phrase-rus-31 as character no-undo .
     3185   define variable  sort-phrase-rus-31  as character no-undo .
     3186     run waitfram-show in this-procedure
     3187       (input "ЖДИТЕ ..."
     3188       ).
     3189   run gbl/flt-get.p
     3190     (input filter-point
     3191     ,output flt-rec-31
     3192     ,output filter-name-31
     3193     ,output where-phrase-31
     3194     ,output sort-phrase-31
     3195     ,output where-phrase-rus-31
     3196     ,output sort-phrase-rus-31
     3197     ).
     3198       run set-filter-name in this-procedure
     3199         (INPUT filter-name-31
     3200         ) no-error .
     3201     assign
     3202       l-filter-open-31 = false
     3203     .
     3204     if flt-rec-31 <> ?
     3205       or sort-column-phrase > ""
     3206     then do:
     3207       define variable  parameter-2-31 as character no-undo .
     3208       define variable  parameter-3-31 as character no-undo .
     3209       define variable  parameter-4-31 as character no-undo .
     3210       define variable  parameter-5-31 as character no-undo .
     3211       define variable  parameter-6-31 as character no-undo .
     3212       define variable  parameter-7-31 as character no-undo .
     3213         assign
     3214         parameter-3-31 =
     3215                                 "FOR EACH X_wth-ser"
     3216         parameter-4-31 =
     3217           (
     3218             if (" (IF rsfl-par = 0 THEN X_wth-ser.stts = 0                               ELSE (IF rsfl-par = 1 THEN (X_wth-ser.stts = 0 AND X_wth-ser.qnty > 0)                                  ELSE (IF rsfl-par = 2 THEN X_wth-ser.stts > 0 ELSE TRUE) )) " + " " + where-phrase-31) <> ""
     3219             then  substitute(' (IF &1 = 0 THEN X_wth-ser.stts = 0                            ELSE (IF &1 = 1 THEN (X_wth-ser.stts = 0 AND X_wth-ser.qnty > 0)                                  ELSE (IF &1 = 2 THEN X_wth-ser.stts > 0 ELSE TRUE) )) ',                                     rsfl-par)  + " " + where-phrase-31
     3220             else "true"
     3221           )
     3222         parameter-5-31 = (" " + "" + " " + ",       FIRST X_wealth WHERE X_wealth.wth-code = X_wth-ser.wth-code NO-LOCK,       FIRST X_wth-par WHERE X_wth-par.par-code = X_wth-ser.par-code NO-LOCK,       FIRST X_wth-gds WHERE X_wth-gds.wth-code = X_wealth.wth-code NO-LOCK,       FIRST X_goods WHERE X_goods.gds-code = X_wth-gds.gds-code NO-LOCK")
     3223         parameter-6-31 = if sort-phrase-31 = ''
     3224                              then
     3225           (
     3226           " " + "  " +
     3227             " " + sort-column-phrase +
     3228           " " + "   "
     3229           )
     3230                              else
     3231           (
     3232           " " + "  " +
     3233             " " + sort-column-phrase +
     3234           " " + sort-phrase-31
     3235           )
     3236         parameter-7-31 =
     3237           "   "
     3238       .
     3239       do
     3240       on stop undo, leave
     3241       on error undo, leave
     3242       :
     3243         assign
     3244           l-disable-where-31 =
     3245             (" (IF rsfl-par = 0 THEN X_wth-ser.stts = 0                               ELSE (IF rsfl-par = 1 THEN (X_wth-ser.stts = 0 AND X_wth-ser.qnty > 0)                                  ELSE (IF rsfl-par = 2 THEN X_wth-ser.stts > 0 ELSE TRUE) )) " + " " + where-phrase-31 = "")
     3246         .
     3247         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3248                             ,input query BR-wths:handle
     3249                             ,input parameter-3-31
     3250                             ,input parameter-4-31
     3251                             ,input parameter-5-31
     3252                             ,input parameter-6-31
     3253                             ,input parameter-7-31
     3254                             )
     3255         .
     3256         assign
     3257           l-filter-open-31 = true
     3258         .
     3259       end.
     3260       if l-filter-open-31 = false then do:
     3261         message
     3262           "Ошибка при фильтрации / сортировке" skip
     3263           "Будут показаны записи без учета фильтра" skip
     3264           view-as alert-box .
     3265       end.
     3266       else do:
     3267           assign
     3268             l-query-was-opened = true
     3269           .
     3270       end.
     3271     end.
     3272     if l-filter-open-31 = false then do:
     3273       OPEN QUERY BR-wths FOR EACH X_wth-ser
     3274         where  (IF rsfl-par = 0 THEN X_wth-ser.stts = 0                               ELSE (IF rsfl-par = 1 THEN (X_wth-ser.stts = 0 AND X_wth-ser.qnty > 0)                                  ELSE (IF rsfl-par = 2 THEN X_wth-ser.stts > 0 ELSE TRUE) ))
     3275       ,       FIRST X_wealth WHERE X_wealth.wth-code = X_wth-ser.wth-code NO-LOCK,       FIRST X_wth-par WHERE X_wth-par.par-code = X_wth-ser.par-code NO-LOCK,       FIRST X_wth-gds WHERE X_wth-gds.wth-code = X_wealth.wth-code NO-LOCK,       FIRST X_goods WHERE X_goods.gds-code = X_wth-gds.gds-code NO-LOCK
     3276     .
     3277         assign
     3278           l-query-was-opened = true
     3279         .
     3280     end.
     3281     run waitfram-hide in this-procedure .
     3282       end.
     3283       when 'МЦ':U then do:
     3284           ASSIGN frame Dialog-Frame:TITLE = "Серии материальной ценности " + b-wealth.wth-name
     3285           filter-point = "Серии материальных ценностей " + p-list-mode.
     3286   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3287   define variable  l-disable-where-33  as logical   no-undo .
     3288   define variable  l-filter-open-33    as logical   .
     3289   define variable  flt-rec-33       as recid     no-undo .
     3290   define variable  filter-name-33      as character no-undo .
     3291   define variable  where-phrase-33     as character no-undo .
     3292   define variable  sort-phrase-33      as character no-undo .
     3293   define variable  where-phrase-rus-33 as character no-undo .
     3294   define variable  sort-phrase-rus-33  as character no-undo .
     3295     run waitfram-show in this-procedure
     3296       (input "ЖДИТЕ ..."
     3297       ).
     3298   run gbl/flt-get.p
     3299     (input filter-point
     3300     ,output flt-rec-33
     3301     ,output filter-name-33
     3302     ,output where-phrase-33
     3303     ,output sort-phrase-33
     3304     ,output where-phrase-rus-33
     3305     ,output sort-phrase-rus-33
     3306     ).
     3307       run set-filter-name in this-procedure
     3308         (INPUT filter-name-33
     3309         ) no-error .
     3310     assign
     3311       l-filter-open-33 = false
     3312     .
     3313     if flt-rec-33 <> ?
     3314       or sort-column-phrase > ""
     3315     then do:
     3316       define variable  parameter-2-33 as character no-undo .
     3317       define variable  parameter-3-33 as character no-undo .
     3318       define variable  parameter-4-33 as character no-undo .
     3319       define variable  parameter-5-33 as character no-undo .
     3320       define variable  parameter-6-33 as character no-undo .
     3321       define variable  parameter-7-33 as character no-undo .
     3322         assign
     3323         parameter-3-33 =
     3324                                 "FOR EACH X_wth-ser"
     3325         parameter-4-33 =
     3326           (
     3327             if (" (IF rsfl-par = 0 THEN X_wth-ser.stts = 0 ELSE (IF rsfl-par = 1 THEN (X_wth-ser.stts = 0 AND X_wth-ser.qnty > 0) ELSE (IF rsfl-par = 2 THEN X_wth-ser.stts > 0 ELSE TRUE) )) and X_wth-ser.wth-code = pwth-code " + " " + where-phrase-33) <> ""
     3328             then  substitute(' (IF &1 = 0 THEN X_wth-ser.stts = 0 ELSE (IF &1 = 1 THEN (X_wth-ser.stts = 0 AND X_wth-ser.qnty > 0) ELSE (IF &1 = 2 THEN X_wth-ser.stts > 0 ELSE TRUE) )) and X_wth-ser.wth-code = pwth-code ', rsfl-par )  + " " + where-phrase-33
     3329             else "true"
     3330           )
     3331         parameter-5-33 = (" " + "" + " " + ",       FIRST X_wealth WHERE X_wealth.wth-code = X_wth-ser.wth-code NO-LOCK,       FIRST X_wth-par WHERE X_wth-par.par-code = X_wth-ser.par-code NO-LOCK,       FIRST X_wth-gds WHERE X_wth-gds.wth-code = X_wealth.wth-code NO-LOCK,       FIRST X_goods WHERE X_goods.gds-code = X_wth-gds.gds-code NO-LOCK")
     3332         parameter-6-33 = if sort-phrase-33 = ''
     3333                              then
     3334           (
     3335           " " + "  " +
     3336             " " + sort-column-phrase +
     3337           " " + "  "
     3338           )
     3339                              else
     3340           (
     3341           " " + "  " +
     3342             " " + sort-column-phrase +
     3343           " " + sort-phrase-33
     3344           )
     3345         parameter-7-33 =
     3346           "   "
     3347       .
     3348       do
     3349       on stop undo, leave
     3350       on error undo, leave
     3351       :
     3352         assign
     3353           l-disable-where-33 =
     3354             (" (IF rsfl-par = 0 THEN X_wth-ser.stts = 0 ELSE (IF rsfl-par = 1 THEN (X_wth-ser.stts = 0 AND X_wth-ser.qnty > 0) ELSE (IF rsfl-par = 2 THEN X_wth-ser.stts > 0 ELSE TRUE) )) and X_wth-ser.wth-code = pwth-code " + " " + where-phrase-33 = "")
     3355         .
     3356         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3357                             ,input query BR-wths:handle
     3358                             ,input parameter-3-33
     3359                             ,input parameter-4-33
     3360                             ,input parameter-5-33
     3361                             ,input parameter-6-33
     3362                             ,input parameter-7-33
     3363                             )
     3364         .
     3365         assign
     3366           l-filter-open-33 = true
     3367         .
     3368       end.
     3369       if l-filter-open-33 = false then do:
     3370         message
     3371           "Ошибка при фильтрации / сортировке" skip
     3372           "Будут показаны записи без учета фильтра" skip
     3373           view-as alert-box .
     3374       end.
     3375       else do:
     3376           assign
     3377             l-query-was-opened = true
     3378           .
     3379       end.
     3380     end.
     3381     if l-filter-open-33 = false then do:
     3382       OPEN QUERY BR-wths FOR EACH X_wth-ser
     3383         where  (IF rsfl-par = 0 THEN X_wth-ser.stts = 0 ELSE (IF rsfl-par = 1 THEN (X_wth-ser.stts = 0 AND X_wth-ser.qnty > 0) ELSE (IF rsfl-par = 2 THEN X_wth-ser.stts > 0 ELSE TRUE) )) and X_wth-ser.wth-code = pwth-code
     3384       ,       FIRST X_wealth WHERE X_wealth.wth-code = X_wth-ser.wth-code NO-LOCK,       FIRST X_wth-par WHERE X_wth-par.par-code = X_wth-ser.par-code NO-LOCK,       FIRST X_wth-gds WHERE X_wth-gds.wth-code = X_wealth.wth-code NO-LOCK,       FIRST X_goods WHERE X_goods.gds-code = X_wth-gds.gds-code NO-LOCK
     3385     .
     3386         assign
     3387           l-query-was-opened = true
     3388         .
     3389     end.
     3390     run waitfram-hide in this-procedure .
     3391       end.
     3392       when 'Номинал МЦ':U then do:
     3393           ASSIGN frame Dialog-Frame:TITLE = substitute("Серии номинала &2 &3 материальной ценности &1" ,b-wealth.wth-name,b-wth-par.par-val,b-wth-par.par-unit)
     3394           filter-point = "Серии материальных ценностей " + p-list-mode.
     3395   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3396   define variable  l-disable-where-35  as logical   no-undo .
     3397   define variable  l-filter-open-35    as logical   .
     3398   define variable  flt-rec-35       as recid     no-undo .
     3399   define variable  filter-name-35      as character no-undo .
     3400   define variable  where-phrase-35     as character no-undo .
     3401   define variable  sort-phrase-35      as character no-undo .
     3402   define variable  where-phrase-rus-35 as character no-undo .
     3403   define variable  sort-phrase-rus-35  as character no-undo .
     3404     run waitfram-show in this-procedure
     3405       (input "ЖДИТЕ ..."
     3406       ).
     3407   run gbl/flt-get.p
     3408     (input filter-point
     3409     ,output flt-rec-35
     3410     ,output filter-name-35
     3411     ,output where-phrase-35
     3412     ,output sort-phrase-35
     3413     ,output where-phrase-rus-35
     3414     ,output sort-phrase-rus-35
     3415     ).
     3416       run set-filter-name in this-procedure
     3417         (INPUT filter-name-35
     3418         ) no-error .
     3419     assign
     3420       l-filter-open-35 = false
     3421     .
     3422     if flt-rec-35 <> ?
     3423       or sort-column-phrase > ""
     3424     then do:
     3425       define variable  parameter-2-35 as character no-undo .
     3426       define variable  parameter-3-35 as character no-undo .
     3427       define variable  parameter-4-35 as character no-undo .
     3428       define variable  parameter-5-35 as character no-undo .
     3429       define variable  parameter-6-35 as character no-undo .
     3430       define variable  parameter-7-35 as character no-undo .
     3431         assign
     3432         parameter-3-35 =
     3433                                 "FOR EACH X_wth-ser"
     3434         parameter-4-35 =
     3435           (
     3436             if (" (IF rsfl-par = 0 THEN X_wth-ser.stts = 0 ELSE (IF rsfl-par = 1 THEN (X_wth-ser.stts = 0 AND X_wth-ser.qnty > 0) ELSE (IF rsfl-par = 2 THEN X_wth-ser.stts > 0 ELSE TRUE) )) and X_wth-ser.wth-code = pwth-code and X_wth-ser.par-code = ppar-code " + " " + where-phrase-35) <> ""
     3437             then  substitute(' (IF &1 = 0 THEN X_wth-ser.stts = 0 ELSE (IF &1 = 1 THEN (X_wth-ser.stts = 0 AND X_wth-ser.qnty > 0) ELSE (IF &1 = 2 THEN X_wth-ser.stts > 0 ELSE TRUE) )) and X_wth-ser.wth-code = pwth-code and X_wth-ser.par-code = ppar-code ',                                  rsfl-par  )  + " " + where-phrase-35
     3438             else "true"
     3439           )
     3440         parameter-5-35 = (" " + "" + " " + ",       FIRST X_wealth WHERE X_wealth.wth-code = X_wth-ser.wth-code NO-LOCK,       FIRST X_wth-par WHERE X_wth-par.par-code = X_wth-ser.par-code NO-LOCK,       FIRST X_wth-gds WHERE X_wth-gds.wth-code = X_wealth.wth-code NO-LOCK,       FIRST X_goods WHERE X_goods.gds-code = X_wth-gds.gds-code NO-LOCK")
     3441         parameter-6-35 = if sort-phrase-35 = ''
     3442                              then
     3443           (
     3444           " " + "  " +
     3445             " " + sort-column-phrase +
     3446           " " + "  "
     3447           )
     3448                              else
     3449           (
     3450           " " + "  " +
     3451             " " + sort-column-phrase +
     3452           " " + sort-phrase-35
     3453           )
     3454         parameter-7-35 =
     3455           "   "
     3456       .
     3457       do
     3458       on stop undo, leave
     3459       on error undo, leave
     3460       :
     3461         assign
     3462           l-disable-where-35 =
     3463             (" (IF rsfl-par = 0 THEN X_wth-ser.stts = 0 ELSE (IF rsfl-par = 1 THEN (X_wth-ser.stts = 0 AND X_wth-ser.qnty > 0) ELSE (IF rsfl-par = 2 THEN X_wth-ser.stts > 0 ELSE TRUE) )) and X_wth-ser.wth-code = pwth-code and X_wth-ser.par-code = ppar-code " + " " + where-phrase-35 = "")
     3464         .
     3465         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3466                             ,input query BR-wths:handle
     3467                             ,input parameter-3-35
     3468                             ,input parameter-4-35
     3469                             ,input parameter-5-35
     3470                             ,input parameter-6-35
     3471                             ,input parameter-7-35
     3472                             )
     3473         .
     3474         assign
     3475           l-filter-open-35 = true
     3476         .
     3477       end.
     3478       if l-filter-open-35 = false then do:
     3479         message
     3480           "Ошибка при фильтрации / сортировке" skip
     3481           "Будут показаны записи без учета фильтра" skip
     3482           view-as alert-box .
     3483       end.
     3484       else do:
     3485           assign
     3486             l-query-was-opened = true
     3487           .
     3488       end.
     3489     end.
     3490     if l-filter-open-35 = false then do:
     3491       OPEN QUERY BR-wths FOR EACH X_wth-ser
     3492         where  (IF rsfl-par = 0 THEN X_wth-ser.stts = 0 ELSE (IF rsfl-par = 1 THEN (X_wth-ser.stts = 0 AND X_wth-ser.qnty > 0) ELSE (IF rsfl-par = 2 THEN X_wth-ser.stts > 0 ELSE TRUE) )) and X_wth-ser.wth-code = pwth-code and X_wth-ser.par-code = ppar-code
     3493       ,       FIRST X_wealth WHERE X_wealth.wth-code = X_wth-ser.wth-code NO-LOCK,       FIRST X_wth-par WHERE X_wth-par.par-code = X_wth-ser.par-code NO-LOCK,       FIRST X_wth-gds WHERE X_wth-gds.wth-code = X_wealth.wth-code NO-LOCK,       FIRST X_goods WHERE X_goods.gds-code = X_wth-gds.gds-code NO-LOCK
     3494     .
     3495         assign
     3496           l-query-was-opened = true
     3497         .
     3498     end.
     3499     run waitfram-hide in this-procedure .
     3500       end.
     3501   END CASE.
     3502   if v-doc-rec <> ? then reposition BR-wths to recid v-doc-rec no-error.
     3503   apply "entry" to BR-wths in frame Dialog-Frame.
     3504   run waitfram-hide in this-procedure .
     3505   if avail X_wth-ser then
     3506   APPLY "VALUE-CHANGED":U to BR-wths.
     3507   END PROCEDURE.
     3508   PROCEDURE PrintProc :
     3509   define variable date_string     as      char    no-undo.
     3510   define variable Line                as      char    no-undo.
     3511   define variable for-time as char.
     3512   DEFINE FRAME Wth-List
     3513   X_wth-ser.ser-code    column-label "Код"
     3514   X_wth-ser.db-num      column-label "№ БД"
     3515   X_wth-ser.series      column-label "Серия"    format 'x(10)'
     3516   X_wth-ser.maska       column-label "Маска"
     3517   X_wealth.wth-code     column-label "Код МЦ"
     3518   X_wealth.wth-name     column-label "Название"  format 'x(15)'
     3519   X_wth-par.par-val     column-label "Номинал"
     3520   X_goods.artic         column-label "Артикул"
     3521   X_goods.gds-name      column-label "Товар"     format 'x(15)'
     3522   X_wth-ser.stts        column-label "Статус"
     3523   HEADER  date_string AT 5 format "X(35)"
     3524   string( "Страница " ) format "X(9)" AT 100 PAGE-NUMBER(PrnLibStream) AT 110 FORMAT ">>9" SKIP
     3525   Line format "X(138)" AT 1
     3526   with width 160 down stream-io use-text    .
     3527   Line = fill("-", 122).
     3528   date_string = cur-time-print() .
     3529   run prn-lib-open-stream  in this-procedure (
     3530                                                input parParentProc
     3531                                               ,input 62
     3532                                               ,input yes
     3533                                               ,input no
     3534                                               ).
     3535   PUT  STREAM PrnLibStream
     3536   SPACE(25) ( frame Dialog-Frame:title )
     3537   format "x(90)" SKIP(1) .
     3538   FORM HEADER
     3539   Line AT 1 SKIP
     3540   "Продолжение - на следующей странице" AT 30 SKIP
     3541   with FRAME BottomFrame width 160 PAGE-BOTTOM NO-LABELS NO-BOX .
     3542   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     3543   FORM with FRAME Wth-List  .
     3544   run waitfram-show in this-procedure ( input "Ждите...").
     3545   GET next BR-wths.
     3546   DO WHILE available X_wth-ser :
     3547     Display STREAM PrnLibStream
     3548     X_wth-ser.ser-code
     3549     X_wth-ser.db-num
     3550     X_wth-ser.series
     3551     X_wth-ser.maska
     3552     X_wealth.wth-code
     3553     X_wealth.wth-name
     3554     X_wth-par.par-val
     3555     X_goods.artic
     3556     X_goods.gds-name
     3557     X_wth-ser.stts
     3558     with FRAME Wth-List .
     3559     DOWN STREAM PrnLibStream 1 with FRAME Wth-List  .
     3560     GET next BR-wths.
     3561   END.
     3562   UNDERLINE  STREAM PrnLibStream
     3563     X_wth-ser.ser-code
     3564     X_wth-ser.db-num
     3565     X_wth-ser.series
     3566     X_wth-ser.maska
     3567     X_wealth.wth-code
     3568     X_wealth.wth-name
     3569     X_wth-par.par-val
     3570     X_goods.artic
     3571     X_goods.gds-name
     3572     X_wth-ser.stts
     3573   with FRAME Wth-List .
     3574   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     3575   HIDE  STREAM PrnLibStream FRAME CheckList.
     3576   output  STREAM PrnLibStream CLOSE.
     3577   run waitfram-hide in this-procedure .
     3578   run prn-lib-prn-file in this-procedure (
     3579                                             input parParentProc
     3580                                             ,input 0
     3581                                             ).
     3582   END PROCEDURE.
     3583   PROCEDURE save-position :
     3584    do
     3585   with frame Dialog-Frame
     3586   on error undo, return error
     3587   :
     3588   assign rsfl-par.
     3589           run uf-set (
     3590                 input '&bef-wthsref-stts}':U
     3591               , input v-cntxt-userid
     3592               , input string( rsfl-par )
     3593               , input '&bef-wthsref-stts}':U
     3594               , input no
     3595               , input no
     3596               , input no
     3597               , input no
     3598           ) no-error.
     3599   end.
     3600   END PROCEDURE.
     3601   FUNCTION get-curr RETURNS CHARACTER
     3602     ( buffer loc-X_wealth for X_wealth ) :
     3603   if loc-X_wealth.curr-code = ? then
     3604   return loc-X_wealth.unit-base.
     3605   FIND FIRST ub.currency no-lock where ub.currency.curr-code = loc-X_wealth.curr-code No-ERROR.
     3606   if avail ub.currency then
     3607     RETURN ub.currency.curr-abbr.
     3608   else return "".
     3609   END FUNCTION.
     3610   FUNCTION mark-string RETURNS CHARACTER
     3611     ( input par-recid as recid, input mark-list as character ) :
     3612       RETURN ( IF LOOKUP( STRING( par-recid ), mark-list ) > 0 THEN "*" ELSE "":U ).
     3613   END FUNCTION.
