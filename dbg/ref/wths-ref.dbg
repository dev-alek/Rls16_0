      431   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      432   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      433     (input  v-report-name
      434     ,input  2
      435     ,output v-exist
      436     )  .
      437       if NOT v-exist then
      438       DO:
      439         Message
      440           "Нет заданий на печать ! "
      441           view-as alert-box .
      442         Return  .
      443       End.
      444       run gbl/prnfilen.w
      445         (input  ""
      446         ,input  p-DisabledOptions
      447         ,input  string(v-report-name )
      448         ,input  7
      449         ,output v-user-action
      450         ,output v-printed
      451         ) .
      452       if v-printed then
      453       do:
      454         return "YES" .
      455       end.
      456       else
      457       do:
      458         return "NO" .
      459       end.
      460     end.
