      462   procedure prn-lib-open-stream :
      463     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      464     define input parameter p-page-size    as integer no-undo .
      465     define input parameter p-is-stream    as logical no-undo .
      466     define input parameter p-append       as logical no-undo .
      467     define variable v-report-name as character no-undo .
      468     do
      469       on error undo, return error
      470       :
      471       run prn-lib-get-report-name  in this-procedure (
      472         input parParentProc
      473         ,output v-report-name
      474         ).
      475       if p-is-stream then
      476       do:
      477         if p-append then
      478         do:
      479           output stream PrnLibStream to value( v-report-name )
      480             page-size value(p-page-size) append .
      481         end.
      482         if not p-append then
      483         do:
      484           output stream PrnLibStream to value( v-report-name )
      485             page-size value(p-page-size) .
      486         end.
      487       end.
      488       if not p-is-stream then
      489       do:
      490         if p-append then
      491         do:
      492           output to value( v-report-name )
      493             page-size value(p-page-size) append .
      494         end.
      495         if not p-append then
      496         do:
      497           output to value( v-report-name )
      498             page-size value(p-page-size) .
      499         end.
      500       end.
      501     end.
      502   end procedure.
      503   procedure prn-lib-open-exp :
      504     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      505     define input parameter p-is-stream    as logical no-undo .
      506     define input parameter p-is-append    as logical no-undo .
      507     define output parameter p-ReportFileName as char init "report" no-undo.
      508     define output parameter p-process as logical no-undo .
      509     define variable glog as logical no-undo .
      510     do
      511       on error undo, return error
      512       :
      513       SYSTEM-DIALOG GET-FILE p-ReportFileName
      514         TITLE      "Укажите путь"
      515         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      516         ASK-OVERWRITE
      517         CREATE-TEST-FILE
      518         SAVE-AS
      519         USE-FILENAME
      520         DEFAULT-EXTENSION "txt"
      521         UPDATE glog
      522         .
      523       if not glog then  return.
      524       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      525       if p-is-stream then
      526       do:
      527         if p-is-append then
      528         do:
      529           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      530         end.
      531         else
      532         do:
      533           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      534         end.
      535       end.
      536       else
      537       do:
      538         if p-is-append then
      539         do:
      540           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      541         end.
      542         else
      543         do:
      544           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      545         end.
      546       end.
      547       p-process = yes.
      548     end.
      549   end procedure.
      550   procedure prn-lib-get-report-name :
      551     define input parameter parParentProc  as widget-handle no-undo.
      552     define output parameter p-report-name as character no-undo .
      553     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      554   end procedure.
      555   procedure prn-lib-reportviewer-report-name :
