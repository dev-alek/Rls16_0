     1582   run ref/wthsform.w (
     1583                    input parparentproc
     1584                   ,input p-curr-host-code
     1585                   ,input p-curr-obj-type
     1586                   ,input p-curr-obj-code
     1587                   ,INPUT X_wth-ser.ser-code
     1588                   ,input X_wth-ser.db-num
     1589                   ,input X_wth-ser.wth-code
     1590                   ,INPUT X_wth-ser.par-code
     1591                   ,input  'ПРОСМОТР':U
