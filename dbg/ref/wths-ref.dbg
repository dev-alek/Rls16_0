      560   procedure prn-lib-reportviewer :
      561     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      562     define input parameter p-report-name-html as character no-undo .
      563     define input parameter p-param        as character no-undo .
      564     define variable v-excel           as character no-undo init 'TRUE' .
      565     define variable v-value-character as character no-undo .
      566     define variable v-value-integer   as character no-undo .
      567     define variable v-value-date      as date      no-undo .
      568     define variable v-value-decimal   as decimal   no-undo .
      569     define variable rep-excel         as logical   no-undo .
      570     define variable excel-string      as character no-undo .
      571     define variable v-param-type      as character no-undo .
      572     define variable v-tth             as handle    no-undo .
      573     run adm/shattri.p (
      574       input "get":U
      575       ,input  ""
      576       ,input  0
      577       ,input  'report-glob':U
      578       ,input  'rep-excel':U
      579       ,output v-value-character
      580       ,output v-value-date
      581       ,output v-value-decimal
      582       ,output v-value-integer
      583       ,output rep-excel
      584       ,output v-param-type
      585       ,INPUT-OUTPUT table-handle v-tth
      586       )  .
      587     if rep-excel then v-excel = "TRUE" .
      588     else v-excel = "FALSE" .
      589     if p-param eq ""
      590     then
      591        p-param = "EXCEL:" + v-excel.
      592     else
      593        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      594     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      595   end procedure.
      596   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      597   define variable v-waitfram-action01         as character   no-undo .
      598   define variable v-waitfram-action02         as character   no-undo .
      599   define variable v-waitfram-action03         as character   no-undo .
      600   define variable mWaitFramTextBeg            as character   no-undo.
      601   define variable mWaitFramTextEnd            as character   no-undo.
      602   define variable mWaitFramView               as logical     no-undo.
      603   define variable mWaitProcEvent              as logical     no-undo init yes.
      604   define variable mWaitFramInterval           as integer     no-undo init 1 .
      605   define variable mWaitFramStop               as logical     no-undo.
      606   define variable mWaitFramStopUser           as logical     no-undo.
      607   define variable mWaitFramStopTimeOut        as logical     no-undo.
      608   define variable mWaitFramStartProc          as datetime-tz no-undo.
      609   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      610   define button B-WaitFramStop auto-end-key
      611        label "Стоп"
      612        size 10 by 1 tooltip "Остоновить процесс".
      613   define button B-viewProcInfo
      614        label "Информация"
      615        size 15 by 1 tooltip "Информация о процесс".
      616   define frame waitfram
      617     v-waitfram-action01 format "x(72)" no-label skip
      618     v-waitfram-action02 format "x(72)" no-label skip
      619     v-waitfram-action03 format "x(72)" no-label skip
      620     B-viewProcInfo
      621     B-WaitFramStop at row 4 col 30
      622     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      623     .
      624   define new global shared variable mBatchMode as logical no-undo init ?.
      625   define variable mFramBachModHandle as handle no-undo.
      626   mFramBachModHandle = frame waitfram:handle.
      627   define variable mFameOldVis as logical no-undo.
      628   define variable mVisCUrentVin as logical no-undo.
      629   if session:batch-mode
      630   then
      631      mBatchMode = yes.
      632   if mBatchMode = ? then do:
      633     mVisCUrentVin = current-window:visible.
      634     mFameOldVis = mFramBachModHandle:visible.
      635     mFramBachModHandle:visible  = yes.
      636     mBatchMode = mFramBachModHandle:visible ne yes.
      637     mFramBachModHandle:visible = mFameOldVis.
      638     current-window:visible = mVisCUrentVin.
      639   end.
      640    if  log-manager:logfile-name ne ?
      641     then DO:
      642         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      643         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      644         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      645     end.
      646   on choose of B-WaitFramStop in frame waitfram
      647   do:
      648     mWaitFramStop = yes.
      649     mWaitFramStopUser = yes.
      650   end.
      651   function waitfram-check-timeout returns logical():
      652      define variable vtime as int64 no-undo.
      653      if mWaitFramStopTimeOut
      654      then
      655         return yes.
      656      vtime = ( now - mWaitFramStartProc ) / 1000 .
      657      if     mWaitFramTimeOut ne ?
      658         and mWaitFramTimeOut ne 0
      659         and mWaitFramTimeOut lt vtime
      660      then do:
      661         mWaitFramStopTimeOut = yes.
      662      end.
      663      return mWaitFramStopTimeOut.
      664   end.
      665   procedure waitfram-hide :
      666     if not session:batch-mode
      667     then do
      668     on error undo, return error return-value
      669     :
      670       pause 0 before-hide .
      671       if not mBatchMode then
      672         hide frame waitfram .
      673     if     not mWaitFramView
      674        and mWaitProcEvent
      675     then
      676       process events .
      677     end.
      678   end procedure.
      679   procedure waitfram-show :
      680     define input  parameter p-message as character no-undo .
      681     define variable v-left-margin as integer   no-undo .
      682     if not session:batch-mode
      683     then do
      684     on error undo, return error return-value
      685     :
      686       if length(p-message) <= 70 then do:
      687         assign
      688           v-left-margin = integer((70 - length(p-message)) / 2)
      689         .
      690         assign
      691           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      692         .
      693         assign
      694           v-waitfram-action01 = " "
      695           v-waitfram-action02 = " "
      696                                    + fill(" ", v-left-margin)
      697                                    + p-message
      698           v-waitfram-action03 = " "
      699         .
      700       end.
      701       else do:
      702         define variable vRindex1 as integer no-undo.
      703         define variable vRindex2 as integer no-undo.
      704         vRindex1 = r-index(p-message," ",70).
      705         if vRindex1 = 0
      706         then
      707            vRindex1 = 70.
      708         if length(p-message)  <= vRindex1 + 70 then do:
      709           assign
      710             v-waitfram-action01 = " "
      711             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      712             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      713           .
      714         end.
      715         else do:
      716           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      717           if vRindex2 <= vRindex1
      718           then
      719              vRindex2 = vRindex1 + 70.
      720           assign
      721             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      722             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      723             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      724           .
      725         end.
      726       end.
      727       B-viewProcInfo:visible   in frame waitfram = no.
      728       B-viewProcInfo:sensitive in frame waitfram = no.
      729       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      730       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      731       if  (   mWaitFramView
      732          or  mWaitProcEvent)
      733          and not mBatchMode
      734       then
      735          display
      736             v-waitfram-action01 skip
      737             v-waitfram-action02 skip
      738             v-waitfram-action03 skip
      739          with frame waitfram .
      740       if     mWaitFramView
      741          then do:
      742             if     mWaitFramInterval ne ?
      743                and not mBatchMode
      744             then
      745                wait-for go of frame waitfram pause mWaitFramInterval.
      746          end.
      747          else
      748             if     mWaitProcEvent
      749                and not mBatchMode
      750             then
      751                process events .
      752     end.
      753   end procedure.
      754      procedure waitfram-show-this:
      755         define input  parameter iInterval as int64 no-undo.
      756         define variable vtime as int64 no-undo.
      757         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      758         mWaitFramInterval = iInterval.
      759         run waitfram-show (substitute("&1&2 &3&4" ,
      760                                       mWaitFramTextBeg ,
      761                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      762                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      763                                       mWaitFramTextEnd
      764                                      )
      765                           ).
      766      end.
      767      procedure WaitFramRunPause:
      768         define input  parameter iInterval as dec no-undo.
      769         define variable vStart  as datetime-tz no-undo.
      770         define variable vend    as datetime-tz no-undo.
      771         define variable vint as int64 no-undo.
      772         define variable vOk as logical no-undo.
      773         vStart = now.
      774         vend   = vStart.
      775         publish "WaitFramPause" (iInterval,output vOk).
      776         vend   =  now.
      777         vint = vend - vStart.
      778         vint = iInterval - vint / 1000.
      779         if     not mWaitFramStop
      780            and (   vint > 0
      781                 or (    not vOk
      782                     and iInterval eq ?
      783                     )
      784                 )
      785         then
      786            run waitfram-show-this (iInterval).
      787         vend   =  now.
      788         vint = vend - vStart.
      789         vint = iInterval - vint / 1000.
      790         if     not mWaitFramStop
      791            and vint > 0
      792         then do:
      793            run gbl/pause.p (vint * 1000).
      794         end.
      795         if iInterval ne ?
      796         then
      797            publish "WaitFramStop".
      798         waitfram-check-timeout().
      799      end.
      800      procedure WaitFramWaitFor:
      801         define input  parameter iInterval as dec no-undo.
      802         assign
      803            mWaitFramStartProc   = now
      804            mWaitFramStopUser    = no
      805            mWaitFramStopTimeOut = no
      806         .
      807         block-wait:
      808         do while not mWaitFramStop:
      809            run WaitFramRunPause (iInterval).
      810            if  waitfram-check-timeout()
      811            then do:
      812               leave block-wait.
      813            end.
      814         end.
      815         run waitfram-hide.
      816      end.
      817   procedure waitfram-join :
      818     define input  parameter p-line-1  as character no-undo .
      819     define input  parameter p-line-2  as character no-undo .
      820     define input  parameter p-line-3  as character no-undo .
      821     define output parameter p-message as character no-undo .
      822     do
      823     on error undo, return error return-value
      824     :
      825       assign
      826         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      827                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      828                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      829       .
      830     end.
      831   end procedure.
      832   function waitfram-join-function returns character
      833     (input p-line-1 as character
      834     ,input p-line-2 as character
      835     ,input p-line-3 as character
      836     ).
      837     define variable v-message as character no-undo .
      838     run waitfram-join in this-procedure
      839       (input  p-line-1
      840       ,input  p-line-2
      841       ,input  p-line-3
      842       ,output v-message
      843       ) .
      844     return v-message .
      845   end function .
      846   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      847     define variable v-cntxt-db-num        as integer   no-undo .
      848     define variable v-cntxt-userid        as character no-undo .
      849     define variable v-cntxt-level         as character no-undo .
      850     define variable v-cntxt-host-code-obj as integer   no-undo .
      851     define variable v-cntxt-obj-type      as character no-undo .
      852     define variable v-cntxt-obj-code      as integer   no-undo .
      853     define variable v-cntxt-db-num-obj    as integer   no-undo .
      854     define variable v-cntxt-is-admin      as logical   no-undo .
      855   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      856   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      857   procedure fltopend_fltopend :
      858   define input parameter p-parent-handle as handle no-undo .
      859   define input parameter p-qh as handle no-undo .
      860   define input parameter p-flt-open-open-query  as character no-undo .
      861   define input parameter p-where-cond as character no-undo .
      862   define input parameter p-use-indFIRST-query-tail as character no-undo .
      863   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      864   define input parameter p-indexed-reposition as character no-undo .
      865     do
      866     on error undo, return error
      867     :
      868   define variable v-prepare-string as character no-undo .
      869   define variable glog as logical no-undo .
      870   assign
      871   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      872                      p-where-cond + chr(32)  +
      873                      p-use-indFIRST-query-tail + chr(32) +
      874                      p-use-ind-sort-clmn-by + chr(32) +
      875                      p-indexed-reposition
      876   .
      877   assign
      878   glog = p-qh:query-prepare(v-prepare-string) no-error .
      879   if not glog
      880   or error-status:error then do:
      881     message error-status:get-message(1) view-as alert-box .
      882     undo, return error .
      883   end.
      884   assign
      885   glog = p-qh:query-open no-error .
      886   if not glog
      887   or error-status:error then do:
      888     message error-status:get-message(1) view-as alert-box .
      889     undo, return error .
      890   end.
      891     end.
      892   end procedure.
      893   procedure fltopend_fltfindd :
      894   define input parameter p-parent-handle as handle no-undo .
      895   define input parameter p-qh as handle no-undo .
      896   define input parameter p-rowid as rowid no-undo .
      897   define input parameter p-next as logical no-undo .
      898   define input parameter p-lock as integer no-undo .
      899   define input parameter p-bh as handle no-undo .
      900   define input parameter p-where-cond as character no-undo .
      901   define input parameter p-use-index-phrase as character no-undo .
      902   define variable glog as logical no-undo .
      903   define variable v-qh as handle no-undo .
      904   define variable v-bh as handle no-undo .
      905   define variable v-recid as recid no-undo .
      906   define variable v-prepare-string as character no-undo .
      907   do
      908   on error undo, return error
      909   on stop undo, return error
      910   :
      911     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      912     create buffer v-bh for table p-bh buffer-name p-bh:name.
      913     create query v-qh.
      914     v-qh:set-buffers(v-bh).
      915     v-prepare-string = substitute("for each &1 &2 &3"
      916                                     ,v-bh:name
      917                                     ,p-where-cond
      918                                     ,p-use-index-phrase).
      919     glog = v-qh:query-prepare(v-prepare-string) no-error.
      920     if not glog then do:
      921       delete object v-qh.
      922       delete object v-bh.
      923       undo, return error .
      924     end.
      925     glog = v-qh:query-open no-error .
      926     if not glog then do:
      927       delete object v-qh.
      928       delete object v-bh.
      929       undo, return error .
      930     end.
      931     if p-next then do:
      932       v-qh:reposition-to-rowid(p-rowid) no-error .
      933       glog = v-qh:get-next( p-lock) no-error .
      934       glog = v-qh:get-next( p-lock) no-error .
      935       if not glog or v-qh:query-off-end = yes then do:
      936         glog = v-qh:get-first( p-lock) no-error .
      937       end.
      938     end.
      939     else do:
      940       glog = v-qh:get-first( p-lock) no-error .
      941     end.
      942     v-recid = v-bh:recid no-error .
      943     delete object v-qh.
      944     delete object v-bh.
      945     return string(v-recid) .
      946   end.
      947   end procedure.
      948   procedure fltopend_fltfindq :
      949   define input parameter p-parent-handle as handle no-undo .
      950   define input parameter p-qh as handle no-undo .
      951   define input parameter p-next as logical no-undo .
      952   define input parameter p-lock as integer no-undo .
      953   define input parameter p-flt-open-open-query  as character no-undo .
      954   define input parameter p-where-cond as character no-undo .
      955   define input parameter p-use-indFIRST-query-tail as character no-undo .
      956   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      957   define input parameter p-indexed-reposition as character no-undo .
      958   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      959   define variable glog as logical no-undo .
      960   define variable v-qh as handle no-undo .
      961   define variable v-bh as handle no-undo extent 18.
      962   define variable v-rowid as rowid no-undo extent 18.
      963   define variable v-ii as integer no-undo .
      964   define variable v-prepare-string as character no-undo .
      965   do
      966   on error undo, return error
      967   on stop undo, return error
      968   :
      969     create query v-qh.
      970     do v-ii = 1 to p-qh:num-buffers:
      971       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      972       assign
      973       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      974       no-error.
      975       v-qh:add-buffer(v-bh[v-ii]).
      976     end.
      977     assign
      978     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      979                       p-where-cond + chr(32)  +
      980                       p-use-indFIRST-query-tail + chr(32) +
      981                       p-use-ind-sort-clmn-by + chr(32) +
      982                       p-indexed-reposition
      983     .
      984     glog = v-qh:query-prepare( v-prepare-string) no-error .
      985     if not glog then do:
      986       delete object v-qh.
      987       do v-ii = 1 to p-qh:num-buffers:
      988         delete object v-bh[v-ii].
      989       end.
      990       undo, return error .
      991     end.
      992     glog = v-qh:query-open no-error .
      993     if not glog then do:
      994       delete object v-qh.
      995       do v-ii = 1 to p-qh:num-buffers:
      996         delete object v-bh[v-ii].
      997       end.
      998       undo, return error .
      999     end.
     1000     if p-next then do:
     1001       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1002       glog = v-qh:get-next( p-lock) no-error .
     1003       glog = v-qh:get-next( p-lock) no-error .
     1004       if not glog or v-qh:query-off-end = yes then do:
     1005         glog = v-qh:get-first( p-lock) no-error .
     1006       end.
     1007     end.
     1008     else do:
     1009       glog = v-qh:get-first( p-lock) no-error .
     1010     end.
     1011     do v-ii = 1 to p-qh:num-buffers:
     1012       assign
     1013       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1014       no-error.
     1015     end.
     1016     delete object v-qh.
     1017     do v-ii = 1 to p-qh:num-buffers:
     1018       delete object v-bh[v-ii].
     1019     end.
     1020   end.
     1021   end procedure.
     1022   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1023   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
     1024   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
     1025   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1026   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1027   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
     1028   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
     1029   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
     1030   procedure uf-name :
     1031     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1032     define output parameter p-use-List_     as logical   no-undo .
     1033     define output parameter p-type-List_     as character no-undo .
     1034     define output parameter p-format-List_   as character no-undo .
     1035     define output parameter p-use-Naim      as logical   no-undo .
     1036     define output parameter p-type-Naim      as character no-undo .
     1037     define output parameter p-format-Naim    as character no-undo .
     1038     define output parameter p-use-print-graft as logical   no-undo .
     1039     define output parameter p-use-sort-gr   as logical   no-undo .
     1040     define output parameter p-use-type-price as logical   no-undo .
     1041     define output parameter p-use-type-val  as logical   no-undo .
     1042     define output parameter p-label          as character no-undo .
     1043     define output parameter p-tooltip        as character no-undo .
     1044     define output parameter p-user-can-edit  as logical   no-undo .
     1045     define output parameter p-output-display as logical   no-undo .
     1046     define output parameter p-other          as character no-undo .
     1047     do
     1048     on error undo, return error
     1049     :
     1050       case p-code :
     1051               when 'cli-all-p':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = yes      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Параметры вызова справочника клиентов"     p-tooltip = "Параметры по умолчанию, используемые для вызова справочника клиентов"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
