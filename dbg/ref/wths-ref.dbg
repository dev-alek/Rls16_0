     1474   end.
     1475   if NOT glog then return no-apply.
     1476   run ref/wthsform.w (
     1477                    input parparentproc
     1478                   ,input p-curr-host-code
     1479                   ,input p-curr-obj-type
     1480                   ,input p-curr-obj-code
     1481                   ,INPUT X_wth-ser.ser-code
     1482                   ,input X_wth-ser.db-num
     1483                   ,input X_wth-ser.wth-code
     1484                   ,INPUT X_wth-ser.par-code
     1485                   ,input  'ИЗМЕНЕНИЕ':U
     1486                   ,output rep-rec).
     1487   if rep-rec <> ? then do:
