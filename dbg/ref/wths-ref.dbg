     1127   procedure uf-get :
     1128     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1129     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1130     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1131     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1132     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1133     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1134     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1135     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1136     do
     1137     on error undo, return error
     1138     :
     1139       define buffer buf_usr-flt for ubflt.usr-flt .
     1140       define variable v-use-List_     as logical   no-undo .
     1141       define variable v-type-List_     as character no-undo .
     1142       define variable v-format-List_   as character no-undo .
     1143       define variable v-use-Naim      as logical   no-undo .
     1144       define variable v-type-Naim      as character no-undo .
     1145       define variable v-format-Naim    as character no-undo .
     1146       define variable v-use-print-graft as logical   no-undo .
     1147       define variable v-use-sort-gr     as logical   no-undo .
     1148       define variable v-use-type-price  as logical   no-undo .
     1149       define variable v-use-type-val    as logical   no-undo .
     1150       define variable v-label          as character no-undo .
     1151       define variable v-tooltip        as character no-undo .
     1152       define variable v-user-can-edit  as logical   no-undo .
     1153       define variable v-output-display as logical   no-undo .
     1154       define variable v-other          as character no-undo .
     1155       run uf-name in this-procedure
     1156          (input  entry(1, p-code, chr(4))
     1157         ,output v-use-List_
     1158         ,output v-type-List_
     1159         ,output v-format-List_
     1160         ,output v-use-Naim
     1161         ,output v-type-Naim
     1162         ,output v-format-Naim
     1163         ,output v-use-print-graft
     1164         ,output v-use-sort-gr
     1165         ,output v-use-type-price
     1166         ,output v-use-type-val
     1167         ,output v-label
     1168         ,output v-tooltip
     1169         ,output v-user-can-edit
     1170         ,output v-output-display
     1171         ,output v-other
     1172         ) no-error .
     1173       if error-status :error then do:
     1174         undo, return error return-value .
     1175       end.
     1176       find first buf_usr-flt no-lock where
     1177                  buf_usr-flt.Call-point     = p-code AND
     1178                  buf_usr-flt.user-name       = p-user-name
     1179         no-error .
     1180       if avail buf_usr-flt then do:
     1181         assign
     1182         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1183         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1184         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1185         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1186         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1187         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1188         .
     1189       end.
     1190       else do:
     1191         assign
     1192         p-List_        = (if v-use-List_       then "":U                    else ?)
     1193         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1194         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1195         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1196         p-type-price   = (if v-use-type-price  then no                      else ?)
     1197         p-type-val     = (if v-use-List_       then no                      else ?)
     1198         .
     1199       end.
     1200     end.
     1201   end procedure.
     1202   procedure uf-set :
     1203     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1204     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1205     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1206     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1207     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1208     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1209     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1210     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1211     do
     1212     on error undo, return error
     1213     :
     1214       define buffer buf_usr-flt for ubflt.usr-flt .
     1215       define variable v-use-List_     as logical   no-undo .
     1216       define variable v-type-List_     as character no-undo .
     1217       define variable v-format-List_   as character no-undo .
     1218       define variable v-use-Naim      as logical   no-undo .
     1219       define variable v-type-Naim      as character no-undo .
     1220       define variable v-format-Naim    as character no-undo .
     1221       define variable v-use-print-graft as logical   no-undo .
     1222       define variable v-use-sort-gr   as logical   no-undo .
     1223       define variable v-use-type-price as logical   no-undo .
     1224       define variable v-use-type-val  as logical   no-undo .
     1225       define variable v-tooltip        as character no-undo .
     1226       define variable v-label          as character no-undo .
     1227       define variable v-user-can-edit  as logical   no-undo .
     1228       define variable v-output-display as logical   no-undo .
     1229       define variable v-other          as character no-undo .
     1230       run uf-name in this-procedure
     1231         (input  entry(1, p-code, chr(4))
     1232         ,output v-use-List_
     1233         ,output v-type-List_
     1234         ,output v-format-List_
     1235         ,output v-use-Naim
     1236         ,output v-type-Naim
     1237         ,output v-format-Naim
     1238         ,output v-use-print-graft
     1239         ,output v-use-sort-gr
     1240         ,output v-use-type-price
     1241         ,output v-use-type-val
     1242         ,output v-label
     1243         ,output v-tooltip
     1244         ,output v-user-can-edit
     1245         ,output v-output-display
     1246         ,output v-other
     1247         ) no-error .
     1248       if error-status :error then do:
     1249         undo, return error return-value .
     1250       end.
     1251       find first buf_usr-flt where
     1252                  buf_usr-flt.Call-point     = p-code AND
     1253                  buf_usr-flt.user-name       = p-user-name
     1254         no-error .
     1255       if not avail buf_usr-flt then do:
     1256           create buf_usr-flt .
     1257           assign
     1258           buf_usr-flt.call-point = p-code
     1259           buf_usr-flt.user-name  = p-user-name
     1260           .
     1261       end.
     1262       if avail buf_usr-flt then do:
     1263        assign
     1264        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1265        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1266        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1267        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1268        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1269        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1270       .
     1271       release buf_usr-flt.
     1272       end.
     1273       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1274     end.
     1275   end procedure.
     1276   define buffer b-wealth for ub.wealth.
     1277   define buffer b-wth-par for ub.wth-par.
     1278   define variable filter-point as character no-undo init "Серии_МЦ" .
     1279   define variable sort-column-name as character no-undo .
     1280   define variable ri          as      recid   no-undo     init ? .
     1281   define variable choice as log no-undo.
     1282   define variable mark as char no-undo.
     1283   define variable v-doc-rec as recid no-undo .
     1284   DEFINE VARIABLE v-serDb AS CHAR NO-UNDO.
     1285   define variable v-db-num as integer   no-undo .
     1286   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1287   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1288     (output v-db-num
     1289     )  .
     1290   FUNCTION get-curr RETURNS CHARACTER
     1291     ( buffer loc-X_wealth for X_wealth )  FORWARD.
     1292   FUNCTION mark-string RETURNS CHARACTER
     1293     ( input par-recid as recid, input mark-list as character )  FORWARD.
     1294   DEFINE BUTTON B-add
     1295        LABEL "&Добавить"
     1296        SIZE 10 BY 1.
     1297   DEFINE BUTTON B-chg
     1298        LABEL "&Изменить"
     1299        SIZE 10 BY 1.
     1300   DEFINE BUTTON B-del
     1301        LABEL "&Удалить"
     1302        SIZE 10 BY 1.
     1303   DEFINE BUTTON B-Help
     1304        LABEL "Помо&щь"
     1305        SIZE 5 BY 1
     1306        BGCOLOR 8 .
     1307   DEFINE BUTTON B-hist
     1308        LABEL "Ис&тория"
     1309        SIZE 5.5 BY 1.
     1310   DEFINE BUTTON b-lkp
     1311        LABEL "&Просмотр"
     1312        SIZE 10 BY 1.
     1313   DEFINE BUTTON B-mark
     1314        LABEL "&*"
     1315        SIZE 3 BY 1.
     1316   DEFINE BUTTON B-parts
     1317        LABEL "&Партии"
     1318        SIZE 10 BY 1.
     1319   DEFINE BUTTON B-print
     1320        LABEL "Пе&чать"
     1321        SIZE 5 BY 1.
     1322   DEFINE BUTTON b-quit AUTO-END-KEY
     1323        LABEL "&Выход"
     1324        SIZE 10 BY 1
     1325        BGCOLOR 8 .
     1326   DEFINE BUTTON B-sch
     1327        LABEL "&Фильтр"
     1328        SIZE 5 BY 1.
     1329   DEFINE BUTTON B-sel AUTO-GO
     1330        LABEL "Вы&бор"
     1331        SIZE 10 BY 1.
     1332   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1333         VIEW-AS TEXT
     1334        SIZE 4.63 BY 1
     1335        FGCOLOR 4  NO-UNDO.
     1336   DEFINE VARIABLE rsfl-par AS INTEGER INITIAL 1
     1337        VIEW-AS RADIO-SET HORIZONTAL
     1338        RADIO-BUTTONS
     1339             "Текущие", 0,
     1340   "Все", 3,
     1341   "Удаленные", 2
     1342        SIZE 29 BY 1 NO-UNDO.
     1343   DEFINE QUERY BR-wths FOR
     1344         X_wth-ser,
     1345         X_wealth,
     1346         X_wth-par,
     1347         X_wth-gds,
     1348         X_goods SCROLLING.
     1349   DEFINE BROWSE BR-wths
     1350     QUERY BR-wths NO-LOCK DISPLAY
     1351         mark-string(recid(X_wth-ser), rid-list) COLUMN-LABEL "*" FORMAT "x(1)":U
     1352         substitute('&1-&2',X_wth-ser.ser-code,X_wth-ser.db-num) @ v-SerDb COLUMN-LABEL "Код"
     1353               (if X_wth-ser.stts = 0
     1354    then X_wth-ser.series
     1355    else substring (X_wth-ser.series, 1, 15) + '---  УДАЛЕН  ---':U) COLUMN-LABEL "Серия" FORMAT "x(18)":U
     1356               WIDTH 15.5
     1357         X_wealth.wth-code COLUMN-LABEL "Код МЦ"
     1358         X_wth-par.par-val
     1359         (if X_wealth.stts = 0
     1360    then X_wealth.wth-name
     1361    else substring (X_wealth.wth-name, 1, 15) + '---  УДАЛЕН  ---':U) COLUMN-LABEL "Название" FORMAT "X(40)":U
     1362               WIDTH 25.5
     1363         X_goods.artic WIDTH 9.5
     1364         X_goods.gds-name COLUMN-LABEL "Название товара" WIDTH 33.5
     1365         X_wth-ser.stts
     1366       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 16 ROW-HEIGHT-CHARS .67.
     1367   DEFINE FRAME Dialog-Frame
     1368        b-quit AT ROW 1 COL 1
     1369        B-mark AT ROW 1 COL 16
     1370        B-sel AT ROW 1 COL 19
     1371        B-add AT ROW 1 COL 29
     1372        B-chg AT ROW 1 COL 39
     1373        b-lkp AT ROW 1 COL 49 WIDGET-ID 10
     1374        B-del AT ROW 1 COL 59
     1375        B-parts AT ROW 1 COL 69 WIDGET-ID 8
     1376        B-print AT ROW 1 COL 79
     1377        B-hist AT ROW 1 COL 84
     1378        B-sch AT ROW 1 COL 89.5
     1379        B-Help AT ROW 1 COL 94
     1380        rsfl-par AT ROW 2.25 COL 11 NO-LABEL WIDGET-ID 2
     1381        BR-wths AT ROW 3.5 COL 1
     1382        mark-num AT ROW 1 COL 11 NO-LABEL
     1383        "Статус" VIEW-AS TEXT
     1384             SIZE 7 BY .67 AT ROW 2.42 COL 3 WIDGET-ID 12
     1385             FGCOLOR 4
     1386        SPACE(89.37) SKIP(16.73)
     1387       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1388            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1389            TITLE "Справочник серий материальных ценностей"
     1390            CANCEL-BUTTON b-quit.
     1391   ASSIGN
     1392          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1393          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1394   ASSIGN
     1395          B-parts:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1396   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1397   DO:
     1398     APPLY "END-ERROR":U TO SELF.
     1399   END.
     1400   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     1401   DO:
     1402   define variable glog as logical no-undo .
     1403   define variable rep-rec as recid no-undo .
     1404   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1405   do:
     1406     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1407       (input  v-cntxt-db-num
     1408       ,input  v-cntxt-userid
     1409       ,input  0
     1410       ,input  'actn_wth-ser':U
     1411       ,input  'global':U
     1412       ,input  0
     1413       ,input  '':U
     1414       ,input  0
     1415       ,input  0
     1416       ,input  0
     1417       ,input  0
     1418       ,input  true
     1419       ,output glog
     1420       )  .
     1421   end.
     1422   if NOT glog then return no-apply.
     1423   run ref/wthsform.w (
     1424                    input parparentproc
     1425                   ,input p-curr-host-code
     1426                   ,input p-curr-obj-type
     1427                   ,input p-curr-obj-code
     1428                   , 0
     1429                   , 0
     1430                   ,input (if (p-list-mode = 'МЦ':U or p-list-mode = 'Номинал МЦ':U) and avail b-wealth then b-wealth.wth-code else 0)
     1431                   ,INPUT (if p-list-mode = 'Номинал МЦ':U and avail b-wth-par then b-wth-par.par-code else 0)
     1432                   ,input 'ДОБАВЛЕНИЕ':U
     1433                   ,output rep-rec).
     1434   if rep-rec <> ? then do:
     1435     v-doc-rec = rep-rec.
     1436     RUn OpenBr in this-procedure .
     1437     apply "entry" to BR-wths in frame Dialog-Frame.
     1438   end.
     1439   else do:
     1440     apply "entry" to BR-wths in frame Dialog-Frame.
     1441     return no-apply.
     1442   end.
     1443   END.
     1444   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1445   DO:
     1446   IF NOT AVAILABLE X_wth-ser THEN RETURN.
     1447   define variable glog as logical no-undo .
     1448   define variable rep-rec as recid no-undo .
