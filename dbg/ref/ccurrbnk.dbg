      430   procedure prn-lib-open-stream :
      431     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      432     define input parameter p-page-size    as integer no-undo .
      433     define input parameter p-is-stream    as logical no-undo .
      434     define input parameter p-append       as logical no-undo .
      435     define variable v-report-name as character no-undo .
      436     do
      437       on error undo, return error
      438       :
      439       run prn-lib-get-report-name  in this-procedure (
      440         input parParentProc
      441         ,output v-report-name
      442         ).
      443       if p-is-stream then
      444       do:
      445         if p-append then
      446         do:
      447           output stream PrnLibStream to value( v-report-name )
      448             page-size value(p-page-size) append .
      449         end.
      450         if not p-append then
      451         do:
      452           output stream PrnLibStream to value( v-report-name )
      453             page-size value(p-page-size) .
      454         end.
      455       end.
      456       if not p-is-stream then
      457       do:
      458         if p-append then
      459         do:
      460           output to value( v-report-name )
      461             page-size value(p-page-size) append .
      462         end.
      463         if not p-append then
      464         do:
      465           output to value( v-report-name )
      466             page-size value(p-page-size) .
      467         end.
      468       end.
      469     end.
      470   end procedure.
      471   procedure prn-lib-open-exp :
      472     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      473     define input parameter p-is-stream    as logical no-undo .
      474     define input parameter p-is-append    as logical no-undo .
      475     define output parameter p-ReportFileName as char init "report" no-undo.
      476     define output parameter p-process as logical no-undo .
      477     define variable glog as logical no-undo .
      478     do
      479       on error undo, return error
      480       :
      481       SYSTEM-DIALOG GET-FILE p-ReportFileName
      482         TITLE      "Укажите путь"
      483         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      484         ASK-OVERWRITE
      485         CREATE-TEST-FILE
      486         SAVE-AS
      487         USE-FILENAME
      488         DEFAULT-EXTENSION "txt"
      489         UPDATE glog
      490         .
      491       if not glog then  return.
      492       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      493       if p-is-stream then
      494       do:
      495         if p-is-append then
      496         do:
      497           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      498         end.
      499         else
      500         do:
      501           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      502         end.
      503       end.
      504       else
      505       do:
      506         if p-is-append then
      507         do:
      508           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      509         end.
      510         else
      511         do:
      512           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      513         end.
      514       end.
      515       p-process = yes.
      516     end.
      517   end procedure.
      518   procedure prn-lib-get-report-name :
      519     define input parameter parParentProc  as widget-handle no-undo.
      520     define output parameter p-report-name as character no-undo .
      521     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      522   end procedure.
      523   procedure prn-lib-reportviewer-report-name :
      524     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      525     define input parameter p-report-name-html as character no-undo .
      526     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      527   end procedure.
      528   procedure prn-lib-reportviewer :
      529     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      530     define input parameter p-report-name-html as character no-undo .
      531     define input parameter p-param        as character no-undo .
      532     define variable v-excel           as character no-undo init 'TRUE' .
      533     define variable v-value-character as character no-undo .
      534     define variable v-value-integer   as character no-undo .
      535     define variable v-value-date      as date      no-undo .
      536     define variable v-value-decimal   as decimal   no-undo .
      537     define variable rep-excel         as logical   no-undo .
      538     define variable excel-string      as character no-undo .
      539     define variable v-param-type      as character no-undo .
      540     define variable v-tth             as handle    no-undo .
      541     run adm/shattri.p (
      542       input "get":U
      543       ,input  ""
      544       ,input  0
      545       ,input  'report-glob':U
      546       ,input  'rep-excel':U
      547       ,output v-value-character
      548       ,output v-value-date
      549       ,output v-value-decimal
      550       ,output v-value-integer
      551       ,output rep-excel
      552       ,output v-param-type
      553       ,INPUT-OUTPUT table-handle v-tth
      554       )  .
      555     if rep-excel then v-excel = "TRUE" .
      556     else v-excel = "FALSE" .
      557     if p-param eq ""
      558     then
      559        p-param = "EXCEL:" + v-excel.
      560     else
      561        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      562     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      563   end procedure.
      564   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      565   procedure cur-time :
      566      define output parameter p-today as date      no-undo .
      567      define output parameter p-time  as integer   no-undo .
      568     do
      569     on error undo, return error
      570     :
      571       define variable v-date1 as date      no-undo .
      572       define variable v-date2 as date      no-undo .
      573       define variable v-time  as integer   no-undo .
      574       assign
      575         v-date1 = today
      576         v-time  = time
      577         v-date2 = today
      578       .
      579       if v-date1 <> v-date2
      580       then do:
      581         assign
      582           v-date1 = today
      583           v-time  = v-time
      584         .
      585       end.
      586       assign
      587         p-today = v-date1
      588         p-time  = v-time
      589       .
      590     end.
      591   end.
      592   function cur-time-date returns character
      593   :
      594     return string(today, '99/99/9999':U) .
      595   end.
      596   function cur-time-mjd returns decimal
      597   :
      598     define variable v-date as date      no-undo .
      599     define variable v-time as integer   no-undo .
      600     run cur-time in this-procedure
      601       (output v-date
      602       ,output v-time
      603       ) .
      604     return integer(v-date) - 2400002 + (v-time / 86400) .
      605   end.
      606   function cur-time-get-ending-index returns integer
      607   (input p-number as integer
      608   )
      609   :
      610     if p-number < 0
      611     or p-number = ?
      612     then do:
      613       return 1 .
      614     end.
      615     define variable v-rest as integer   no-undo .
      616     assign
      617       p-number = p-number modulo 100
      618     .
      619     if p-number < 20
      620     then do:
      621       assign
      622         v-rest = p-number
      623       .
      624     end.
      625     else do:
      626       assign
      627         v-rest = p-number modulo 10
      628       .
      629     end.
      630     case v-rest :
      631       when 1
      632       then do:
      633         return 2 .
      634       end.
      635       when 2 or
      636       when 3 or
      637       when 4
      638       then do:
      639         return 3 .
      640       end.
      641       otherwise do:
      642         return 1 .
      643       end.
      644     end case .
      645   end.
      646   procedure cur-time-mjd-to-date :
      647      define input  parameter i-mjd-diff as decimal no-undo.
      648      define output parameter o-Date     as date    no-undo.
      649      define output parameter o-Time     as integer no-undo.
      650      define variable v-day-number as integer   no-undo .
      651      if    i-mjd-diff < 0
      652         or i-mjd-diff = ?
      653      then do:
      654         return "?" .
      655      end.
      656      assign
      657         v-day-number = truncate(i-mjd-diff,0).
      658         o-Date = date(v-day-number + 2400002).
      659         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      660     .
      661   end.
      662   function cur-time-mjd-to-string returns character
      663   (input p-mjd-diff as decimal
      664   )
      665   :
      666     define variable v-day-number as integer   no-undo .
      667     define variable v-seconds    as integer   no-undo .
      668     define variable v-hour       as integer   no-undo .
      669     define variable v-min        as integer   no-undo .
      670     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      671     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      672     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      673     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      674     if p-mjd-diff < 0
      675     or p-mjd-diff = ?
      676     then do:
      677       return "?" .
      678     end.
      679     assign
      680       v-day-number = integer(truncate(p-mjd-diff,0))
      681       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      682     .
      683     if v-seconds > 86400
      684     then do:
      685       assign
      686         v-seconds = 86400 - 1
      687       .
      688     end.
      689     if v-seconds < 0
      690     then do:
      691       assign
      692         v-seconds = 0
      693       .
      694     end.
      695     assign
      696       v-hour = truncate(v-seconds / 3600, 0)
      697     .
      698     assign
      699       v-seconds = v-seconds modulo 3600
      700     .
      701     assign
      702       v-min = truncate(v-seconds / 60, 0)
      703     .
      704     assign
      705       v-seconds = v-seconds modulo 60
      706     .
      707     return
      708         (if v-day-number <> 0
      709           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      710           else ""
      711         )
      712       + (if v-day-number <> 0 or v-hour <> 0
      713           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      714           else ""
      715         )
      716       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      717           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      718           else ""
      719         )
      720       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      721       .
      722   end.
      723   function cur-time-string returns character
      724   :
      725     define variable v-date as date      no-undo .
      726     define variable v-time as integer   no-undo .
      727     run cur-time in this-procedure
      728       (output v-date
      729       ,output v-time
      730       ) .
      731     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      732   end.
      733   function cur-time-string-sec returns character
      734   :
      735     define variable v-date as date      no-undo .
      736     define variable v-time as integer   no-undo .
      737     run cur-time in this-procedure
      738       (output v-date
      739       ,output v-time
      740       ) .
      741     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      742   end.
      743   function cur-time-custom  returns character
      744   (input p-prefix as character
      745   ,input p-date-format as character
      746   ,input p-delimiter as character
      747   ,input p-time-format as character
      748   ,input p-suffix as character
      749   )
      750   :
      751     define variable v-date as date      no-undo .
      752     define variable v-time as integer   no-undo .
      753     run cur-time in this-procedure
      754       (output v-date
      755       ,output v-time
      756       ) .
      757     return
      758       p-prefix
      759       + string(v-date, p-date-format)
      760       + p-delimiter
      761       + string(v-time, p-time-format)
      762       + p-suffix
      763       .
      764   end.
      765   function cur-time-print  returns character
      766   :
      767     define variable v-date as date      no-undo .
      768     define variable v-time as integer   no-undo .
      769     run cur-time in this-procedure
      770       (output v-date
      771       ,output v-time
      772       ) .
      773     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      774   end.
      775   function cur-time-datetime returns datetime
      776   :
      777     define variable v-char as character no-undo .
      778     define variable v-datetime as datetime no-undo .
      779     v-char = cur-time-string().
      780     v-datetime = datetime(v-char).
      781     return  v-datetime.
      782   end.
      783   function cur-time-string-msec returns character
      784   :
      785     define variable v-date as datetime  no-undo .
      786     v-date = now.
      787     return string(v-date) .
      788   end.
      789   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      790   FUNCTION mark-string RETURNS CHARACTER
      791     ( input p-recid as recid, input mark-list as character  ) :
      792     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      793   END FUNCTION.
      794   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      795   function usrfulnf returns character ( input p-user-id as character):
      796   define variable v-user-name as character no-undo .
      797   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      798   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      799     (input  p-user-id
      800     ,output v-user-name
      801     ) no-error .
      802   if error-status:error
      803   or v-user-name = ""
      804   then do:
      805     return p-user-id.
      806   end.
      807   else do:
      808     return v-user-name.
      809   end.
      810   end function.
      811   define variable v-rid-list as character no-undo .
      812   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
      813   define variable sort-column-name as character no-undo .
      814   define variable v-db-num LIKE ub.db.db-num no-undo.
      815   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      816   define  temp-table temp-changes no-undo
      817   field f_name as character
      818   field l_name as character
      819   field v_old as character
      820   field v_new as character
      821   field t_name as character
      822   field num_ as integer
      823   field uniq-key-rec as character
      824   field action as integer
      825   field fNotChange as logical
      826   index pi is unique primary
      827   num_
      828   t_name
      829   f_name
      830   index
      831   Chan
      832   fnotChange
      833   t_name
      834   f_name
      835   index imain uniq-key-rec
      836   .
      837   FUNCTION get-all-fields returns character (p-file-name as character ):
      838   define variable v-dop as character no-undo .
      839     find first _file no-lock where _file._file-name = p-file-name no-error .
      840     if not available _file then return "":U.
      841     for each _field no-lock where
      842              _field._file-recid = recid(_file) :
      843       assign
      844       v-dop = v-dop + _field._field-name + chr(44)
      845       .
      846     end.
      847     return trim(v-dop).
      848   END FUNCTION.
      849   PROCEDURE proc-full-temp-changes :
      850     define input  parameter p-hst-handle as handle    no-undo .
      851     define input  parameter p-main-table as character no-undo .
      852     define input  parameter p-field-list as character no-undo .
      853     define input  parameter p-label-form as character no-undo .
      854     define variable h-new-buf         as handle    no-undo .
      855     define variable h-main-buf        as handle    no-undo .
      856     define variable h-for-comp        as handle    no-undo .
      857     define variable v-inform          as character no-undo .
      858     define variable v-ind             as integer   no-undo .
      859     define variable v-idx-field-qnty  as integer   no-undo .
      860     define variable v-num-entries     as integer   no-undo .
      861     define variable fh                as handle    no-undo .
      862     define variable fh-main           as handle    no-undo .
      863     define variable fh-old            as handle    no-undo .
      864     define variable fh-new            as handle    no-undo .
      865     define variable v-field-name      as character no-undo .
      866     define variable v-field-lvl       as character no-undo .
      867     define variable v-field-form      as character no-undo .
      868     define variable v-search-exp      as character no-undo .
      869     define variable v-srch-main       as character no-undo .
      870     define variable v-word-link       as character no-undo .
      871     define variable v-av-chip-num     as logical   no-undo .
      872     define variable v-main-pi-fld-lst as character no-undo .
      873     define variable v-main-fld-lst    as character no-undo .
      874     define variable v-delim-list      as character no-undo .
      875     define variable v-label           as character no-undo .
      876     define variable v-old-value       as character no-undo case-sensitive.
      877     define variable v-new-value       as character no-undo case-sensitive.
      878     define variable v-chg-fields as character no-undo.
      879     for each temp-changes:
      880       delete temp-changes.
      881     end.
      882     if not p-hst-handle:available then do:
      883       return .
      884     end.
      885     create buffer h-new-buf  for table p-hst-handle .
      886     create buffer h-main-buf for table p-main-table .
      887     assign
      888       v-inform = h-main-buf:index-information(1)
      889       v-ind    = 2
      890     .
      891     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      892     on error undo, return error
      893     :
      894       assign
      895         v-inform = h-main-buf:index-information( v-ind )
      896         v-ind    = v-ind + 1
      897       .
      898     end.
      899     if v-inform = ?
      900       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      901       or entry( 3, v-inform, ",":U ) <> "1":U
      902     then do:
      903       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      904     end.
      905     assign
      906       v-idx-field-qnty = num-entries( v-inform ) - 4
      907     .
      908     if v-idx-field-qnty < 2 then do:
      909       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      910     end.
      911     assign
      912       v-srch-main   = "where":U
      913       v-word-link   = "":U
      914       v-av-chip-num = false
      915       v-delim-list  = "":U
      916     .
      917     do v-ind = 1 to v-idx-field-qnty by 2
      918     on error undo, return error
      919     :
      920       assign
      921         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      922         fh                = p-hst-handle:buffer-field( v-field-name )
      923         fh-main           = h-main-buf:buffer-field( v-field-name )
      924         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      925         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      926       .
      927       if fh:data-type ="character":U then do:
      928         assign
      929           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      930         .
      931       end.
      932       else do:
      933         assign
      934           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      935         .
      936       end.
      937       if v-delim-list = "":U then do:
      938         assign
      939           v-delim-list = ",":U
      940         .
      941       end.
      942       if v-word-link = "":U then do:
      943         assign
      944           v-word-link = "and":U
      945         .
      946       end.
      947     end.
      948     assign
      949       v-delim-list  = "":U
      950     .
      951     do v-ind = 1 to h-main-buf:num-fields
      952     on error undo, return error
      953     :
      954       assign
      955         fh-main      = h-main-buf:buffer-field( v-ind )
      956         v-field-name = fh-main:name
      957       .
      958         assign
      959           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      960         .
      961         if v-delim-list = "":U then do:
      962           assign
      963             v-delim-list = ",":U
      964           .
      965         end.
      966     end.
      967     assign
      968       v-inform = p-hst-handle:index-information(1)
      969       v-ind    = 2
      970     .
      971     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      972     on error undo, return error
      973     :
      974       assign
      975         v-inform = p-hst-handle:index-information( v-ind )
      976         v-ind    = v-ind + 1
      977       .
      978     end.
      979     if v-inform = ?
      980       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      981       or entry( 3, v-inform, ",":U ) <> "1":U
      982     then do:
      983       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      984     end.
      985     assign
      986       v-idx-field-qnty = num-entries( v-inform ) - 4
      987     .
      988     if v-idx-field-qnty < 2 then do:
      989       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      990     end.
      991     assign
      992       v-search-exp  = "where":U
      993       v-word-link   = "":U
      994       v-av-chip-num = false
      995     .
      996     do v-ind = 1 to v-idx-field-qnty by 2
      997     on error undo, return error
      998     :
      999       assign
     1000         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1001         fh           = p-hst-handle:buffer-field( v-field-name )
     1002         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1003       .
     1004       if v-field-name = "chip-num":U then do:
     1005         assign
     1006           v-search-exp  = substitute( "&1 >", v-search-exp )
     1007           v-av-chip-num = true
     1008         .
     1009       end.
     1010       else do:
     1011         assign
     1012           v-search-exp = substitute( "&1 =", v-search-exp )
     1013         .
     1014       end.
     1015       if fh:data-type ="character":U then do:
     1016         assign
     1017           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1018         .
     1019       end.
     1020       else do:
     1021         assign
     1022           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1023         .
     1024       end.
     1025       if v-word-link = "":U then do:
     1026         assign
     1027           v-word-link = "and":U
     1028         .
     1029       end.
     1030     end.
     1031     if v-av-chip-num = false then do:
     1032       message
     1033         vss-workfile vss-revision vss-description skip
     1034         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1035         "Использование данной процедуры невозможно!" skip
     1036         view-as alert-box error .
     1037       return error .
     1038     end.
     1039     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1040     if not h-new-buf:available then do:
     1041       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1042       if not h-main-buf:available then do:
     1043         assign
     1044           h-for-comp = ?
     1045         .
     1046       end.
     1047       else do:
     1048         assign
     1049           h-for-comp = h-main-buf
     1050         .
     1051       end.
     1052     end.
     1053     else do:
     1054       assign
     1055         h-for-comp = h-new-buf
     1056       .
     1057     end.
     1058     assign
     1059       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1060     .
     1061     do v-ind = 1 to v-num-entries
     1062     on error undo, return error return-value
     1063     :
     1064       assign
     1065         v-field-name = entry( v-ind, v-main-fld-lst )
     1066         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1067         v-old-value  = fh-old:buffer-value()
     1068         v-label      = trim( fh-old:label )
     1069       .
     1070       if ( trim( p-field-list ) <> "":U
     1071            and lookup( v-field-name, p-field-list ) > 0
     1072          )
     1073          or trim( p-field-list ) = "":U
     1074       then do:
     1075         if h-for-comp <> ? then do:
     1076           assign
     1077             fh-new      = h-for-comp:buffer-field( v-field-name )
     1078             v-new-value = fh-new:buffer-value()
     1079           .
     1080         end.
     1081         else do:
     1082           assign
     1083             v-new-value = "":U
     1084           .
     1085         end.
     1086         if v-old-value <> v-new-value
     1087         then do:
     1088           create temp-changes.
     1089           assign
     1090             temp-changes.t_name = p-main-table
     1091             temp-changes.f_name = v-field-name
     1092             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1093             temp-changes.v_old  = trim( v-old-value )
     1094             temp-changes.v_new  = trim( v-new-value )
     1095             temp-changes.num_   = 0
     1096             temp-changes.fNotChange = v-old-value eq v-new-value
     1097           .
     1098         end.
     1099       end.
     1100     end.
     1101     assign
     1102       v-num-entries = num-entries( p-label-form, chr(8) )
     1103     .
     1104     do v-ind = 1 to v-num-entries
     1105     on error undo, return error return-value
     1106     :
     1107       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1108         assign
     1109           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1110           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1111           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1112         .
     1113         find first temp-changes
     1114           where temp-changes.f_name = v-field-name
     1115           no-error .
     1116         if available temp-changes then do:
     1117           if trim( v-field-lvl ) <> "":U then do:
     1118             assign
     1119               temp-changes.l_name = v-field-lvl
     1120             .
     1121           end.
     1122           if trim( v-field-form ) <> "":U then do:
     1123             assign
     1124               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1125             .
     1126             if h-for-comp <> ? then do:
     1127               assign
     1128                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1129               .
     1130             end.
     1131           end.
     1132         end.
     1133       end.
     1134       else do:
     1135         message
     1136           vss-workfile vss-revision vss-description skip
     1137           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1138           substitute( "список для поля '&1': '&2'"
     1139                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1140                       ,entry( v-ind, p-label-form, chr(8) )
     1141                     ) skip
     1142           substitute( "полный список: &2", p-label-form ) skip
     1143           view-as alert-box error .
     1144       end.
     1145     end.
     1146     delete object h-new-buf .
     1147     delete object h-main-buf .
     1148   END PROCEDURE.
     1149   DEFINE BUTTON B-Help
     1150        LABEL "Помо&щь"
     1151        SIZE 3 BY 1
     1152        BGCOLOR 8 .
     1153   DEFINE BUTTON B-lookup
     1154        LABEL "&Просмотр"
     1155        SIZE 10 BY 1.
     1156   DEFINE BUTTON B-mark
     1157        LABEL "&*"
     1158        SIZE 3 BY 1.
     1159   DEFINE BUTTON b-quit AUTO-END-KEY
     1160        LABEL "&Выход"
     1161        SIZE 10 BY 1
     1162        BGCOLOR 8 .
     1163   DEFINE BUTTON B-sel AUTO-GO
     1164        LABEL "Вы&бор"
     1165        SIZE 10 BY 1.
     1166   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1167         VIEW-AS TEXT
     1168        SIZE 6 BY 1
     1169        FGCOLOR 4  NO-UNDO.
     1170   DEFINE QUERY br-ccur FOR
     1171         X_c-curr-bank SCROLLING.
     1172   DEFINE QUERY BR-changes FOR
     1173         temp-changes SCROLLING.
     1174   DEFINE BROWSE br-ccur
     1175     QUERY br-ccur NO-LOCK DISPLAY
     1176         mark-string(RECID(X_c-curr-bank), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1177         usrfulnf(X_c-curr-bank.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
     1178         X_c-curr-bank.corr-date COLUMN-LABEL "Дата!измен" FORMAT "99/99/9999":U
     1179         string(X_c-curr-bank.corr-time, "HH:MM") COLUMN-LABEL "Время!измен" FORMAT "X(5)":U
     1180         X_c-curr-bank.curr-code COLUMN-LABEL "Код валюты" FORMAT ">>9":U
     1181         X_c-curr-bank.exch-date COLUMN-LABEL "Дата курса" FORMAT "99/99/99":U
     1182       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.25.
     1183   DEFINE BROWSE BR-changes
     1184     QUERY BR-changes DISPLAY
     1185         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1186   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1187   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1188       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.04.
     1189   DEFINE FRAME Dialog-Frame
     1190        b-quit AT ROW 1 COL 1
     1191        B-mark AT ROW 1 COL 11
     1192        B-sel AT ROW 1 COL 21
     1193        B-lookup AT ROW 1 COL 61
     1194        B-Help AT ROW 1 COL 95
     1195        br-ccur AT ROW 3 COL 1
     1196        BR-changes AT ROW 13 COL 1
     1197        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1198        SPACE(78.62) SKIP(20.04)
     1199       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1200            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1201            TITLE "История валюты"
     1202            CANCEL-BUTTON b-quit.
     1203   ASSIGN
     1204          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1205          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1206   ASSIGN
     1207          B-lookup:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1208   ON GO OF FRAME Dialog-Frame
     1209   DO:
     1210     P-RID-LIST = V-RID-LIST.
     1211   END.
     1212   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1213   DO:
     1214     APPLY "END-ERROR":U TO SELF.
     1215   END.
     1216   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1217   DO:
     1218     define variable loc#log as logical no-undo .
     1219     if available X_c-curr-bank then do:
     1220   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1221   define variable v-str-recid10 as character no-undo .
     1222   define variable v-num-entry10 as integer   no-undo .
     1223   assign
     1224     v-str-recid10 = trim( string( recid( X_c-curr-bank ) , "->>>>>>>>>>>9":U ) )
     1225     v-num-entry10 = lookup( v-str-recid10 , v-rid-list )
     1226   .
     1227   if v-num-entry10 > 0 then do:
     1228     assign
     1229       entry( v-num-entry10, v-rid-list ) = "":U
     1230       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1231     .
     1232   end.
     1233   else do:
     1234     assign
     1235       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid10
     1236     .
     1237   end.
     1238       loc#log = br-ccur:refresh() .
     1239       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1240           loc#log = br-ccur:select-next-row ().
     1241           apply "VALUE-CHANGED" to br-ccur in frame Dialog-Frame.
     1242       end.
     1243       if num-entries( v-rid-list ) = 0
     1244       then
     1245           hide mark-num in frame Dialog-Frame.
     1246       else
     1247           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1248     end.
     1249     apply "entry" to br-ccur in frame Dialog-Frame.
     1250   END.
     1251   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1252   DO:
     1253       if ( available X_c-curr-bank ) then do:
     1254       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1255       then
     1256       v-rid-list = string( recid( X_c-curr-bank ) ) .
     1257     end.
     1258   END.
     1259   ON RETURN OF br-ccur IN FRAME Dialog-Frame
     1260   or MOUSE-SELECT-DBLCLICK OF br-ccur IN FRAME Dialog-Frame
     1261       DO:
     1262       run proc-br-ccur no-error.
     1263     if error-status:error then return no-apply.
     1264   END.
     1265   ON VALUE-CHANGED OF br-ccur IN FRAME Dialog-Frame
     1266   DO:
     1267     run proc-view-changes in this-procedure no-error.
     1268   END.
     1269   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1270   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1271   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1272   on help of frame Dialog-Frame
     1273   do:
     1274     run gbl/app_help.p
     1275       (input this-procedure :file-name
     1276       ,input ''
     1277       ,input ?
     1278       ) no-error.
     1279     if error-status :error then do:
     1280       message
     1281         "Ошибка при вызове помощи"
     1282         error-status :get-message(1)
     1283         view-as alert-box .
     1284     end.
     1285   end.
     1286   run minbtn-set in this-procedure .
     1287   on choose of b-help in frame Dialog-Frame
     1288   do:
     1289     apply "help":u to frame Dialog-Frame .
     1290   end.
     1291   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1292   procedure minbtn-set :
     1293       do
     1294           on error undo, return error return-value
     1295           :
     1296           define variable ii              as integer       no-undo .
     1297           define variable fh              as widget-handle no-undo .
     1298           define variable hh              as widget-handle no-undo .
     1299           define variable v-h             as handle        extent 4 no-undo .
     1300           define variable v-name-button   as character     no-undo .
     1301           define variable v-help-old-x    as decimal       no-undo .
     1302           define variable v-help-old-y    as decimal       no-undo .
     1303           define variable v-help-old-size as decimal       no-undo .
     1304           define variable v-frame-width   as decimal       no-undo .
     1305           define variable jj              as integer       no-undo .
     1306           do
     1307               on error undo, return error
     1308               :
     1309               assign
     1310                   v-frame-width = frame Dialog-Frame:width - 0.3
     1311                   fh            = frame Dialog-Frame:first-child
     1312                   hh            = fh:first-child
     1313                   ii            = 1
     1314                   .
     1315               do while valid-handle(hh):
     1316                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1317                   do:
     1318                       case lc(hh:name) :
     1319                           when "b-help" then
     1320                               do:
     1321                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1322                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1323                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1324                                   hh:TOOLTIP = "Помощь" .
     1325                                   v-help-old-x = hh:column .
     1326                                   v-help-old-y = hh:row    .
     1327                                   v-help-old-size = hh:width .
     1328                                   hh:width-chars = 2.5 .
     1329                               end.
     1330                           when "b-print" then
     1331                               do:
     1332                                   hh:load-image("cmp/b-print.bmp":u) .
     1333                                   hh:TOOLTIP = "Печать" .
     1334                                   v-h[ii] = hh:handle .
     1335                                   ii = ii + 1 .
     1336                                   hh:width-chars = 3 .
     1337                               end.
     1338                           when "b-history" or
     1339                           when "b-hist" then
     1340                               do:
     1341                                   hh:load-image("cmp/b-hist.bmp":u) .
     1342                                   hh:TOOLTIP = "История" .
     1343                                   v-h[ii] = hh:handle .
     1344                                   ii = ii + 1 .
     1345                                   hh:width-chars = 3 .
     1346                               end.
     1347                           when "b-sch" then
     1348                               do:
     1349                                   hh:load-image("cmp/b-sch.bmp":u) .
     1350                                   hh:TOOLTIP = "Установка Фильтра" .
     1351                                   v-h[ii] = hh:handle .
     1352                                   ii = ii + 1 .
     1353                                   hh:width-chars = 3 .
     1354                               end.
     1355                           when "b-hist-user" then
     1356                               do:
     1357                                   hh:load-image("cmp/b-hist.bmp":u) .
     1358                                   hh:TOOLTIP = "История пользователя" .
     1359                                   ii = ii + 1 .
     1360                               end.
     1361                       end case.
     1362                   end.
     1363                   hh = hh:next-sibling.
     1364               end.
     1365               b-help:column = v-frame-width - b-help:width-chars.
     1366               jj = 0.
     1367               repeat ii = 4 to 1 by -1 :
     1368                   if valid-handle (v-h[ii] ) then
     1369                   do:
     1370                       jj  = jj + 1 .
     1371                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1372                       v-h[ii]:row    = v-help-old-y .
     1373                   end.
     1374               end.
     1375           end.
     1376       end.
     1377   end procedure.
     1378   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1379   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1380   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1381   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1382   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1383   define variable v-diasize-current-frame-height as decimal   no-undo .
     1384   define variable v-diasize-change-size          as logical   no-undo .
     1385   define variable v-diasize-resize-button        as handle    no-undo .
     1386   define variable v-diasize-wndmax               as logical   no-undo .
     1387   define variable v-diasize-wndstore             as logical   no-undo .
     1388   define variable v-diasize-proc-name            as character no-undo .
     1389   define variable v-diasize-browse-handle        as handle    no-undo .
     1390   define variable v-diasize-browse-number        as integer   no-undo .
     1391   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1392   define temp-table temp-diasize-handle no-undo
     1393     field handle-value  as handle
     1394     field save-position as decimal
     1395     index xpk is primary unique handle-value
     1396     .
     1397   define temp-table temp-browse-handle no-undo
     1398     field browse-type   as character
     1399     field browse-number as integer
     1400     field browse-handle as handle
     1401     field original-size as decimal
     1402     index xpk is primary unique browse-type browse-number
     1403     index xie browse-type browse-handle
     1404   .
     1405   procedure diasize_change-height :
     1406     define input  parameter p-change-value  as decimal   no-undo .
     1407     define input  parameter p-move-resize   as logical   no-undo .
     1408     define variable v-field-group-handle    as handle    no-undo .
     1409     define variable v-object-handle         as handle    no-undo .
     1410     define variable v-frame-height          as decimal   no-undo .
     1411     define variable v-frame-virtual-height  as decimal   no-undo .
     1412     define variable v-browse-height         as decimal   no-undo .
     1413     define variable v-window-height         as decimal   no-undo .
     1414     define variable v-window-virtual-height as decimal   no-undo .
     1415     define variable v-change-sign           as integer   no-undo .
     1416     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1417     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1418     if p-change-value > 0
     1419     then do:
     1420       if frame Dialog-Frame :height + p-change-value
     1421           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1422       then do:
     1423         assign
     1424           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1425                           - (frame Dialog-Frame :height-chars)
     1426         .
     1427         if p-change-value <= 0
     1428         then do:
     1429           run diasize_position-resize-button in this-procedure .
     1430           return .
     1431         end.
     1432       end.
     1433     end.
     1434     if p-change-value < 0
     1435     then do:
     1436       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1437       then do:
     1438         assign
     1439           p-change-value = v-diasize-orig-frame-height
     1440                          - (frame Dialog-Frame :height-chars)
     1441         .
     1442         if p-change-value >= 0
     1443         then do:
     1444           run diasize_position-resize-button in this-procedure .
     1445           return .
     1446         end.
     1447       end.
     1448     end.
     1449     if p-change-value >= 0
     1450     then do:
     1451       assign
     1452         v-change-sign = 1
     1453       .
     1454     end.
     1455     else do:
     1456       assign
     1457         v-change-sign = -1
     1458       .
     1459     end.
     1460     assign
     1461       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1462     .
     1463     if p-change-value = 0
     1464     then do:
     1465       run diasize_position-resize-button in this-procedure .
     1466       return .
     1467     end.
     1468     move_block:
     1469     do
     1470     on error undo move_block, retry move_block
     1471     :
     1472       if retry
     1473       then do:
     1474         do
     1475         on error undo move_block, leave move_block
     1476         :
     1477           if p-change-value > 0
     1478           then do:
     1479             for each buf_temp-diasize-handle
     1480             on error undo, next
     1481             :
     1482               assign
     1483                 v-object-handle = buf_temp-diasize-handle.handle-value
     1484               .
     1485               if v-object-handle <> v-diasize-resize-button
     1486               then do:
     1487                 assign
     1488                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1489                 .
     1490               end.
     1491             end.
     1492             assign
     1493               v-diasize-browse-handle :height = v-browse-height
     1494             .
     1495             for each buf_temp-browse-handle
     1496               where buf_temp-browse-handle.browse-type = 'height':u
     1497             on error undo, next
     1498             :
     1499               assign
     1500                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1501               .
     1502             end.
     1503             assign
     1504               frame Dialog-Frame :height = v-frame-height
     1505             .
     1506             if frame Dialog-Frame :scrollable = true
     1507             then do:
     1508               assign
     1509                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1510               .
     1511             end.
     1512             run diasize_position-resize-button in this-procedure .
     1513           end.
     1514           else do:
     1515             if frame Dialog-Frame :scrollable = true
     1516             then do:
     1517               assign
     1518                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1519               .
     1520             end.
     1521             assign
     1522               frame Dialog-Frame :height = v-frame-height
     1523             .
     1524             assign
     1525               v-diasize-browse-handle :height = v-browse-height
     1526             .
     1527             for each buf_temp-browse-handle
     1528               where buf_temp-browse-handle.browse-type = 'height':u
     1529             on error undo, next
     1530             :
     1531               assign
     1532                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1533               .
     1534             end.
     1535             for each buf_temp-diasize-handle
     1536             on error undo, next
     1537             :
     1538               assign
     1539                 v-object-handle = buf_temp-diasize-handle.handle-value
     1540               .
     1541               if v-object-handle <> v-diasize-resize-button
     1542               then do:
     1543                 assign
     1544                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1545                 .
     1546               end.
     1547             end.
     1548             run diasize_position-resize-button in this-procedure .
     1549           end.
     1550           assign
     1551             v-diasize-change-size = false
     1552           .
     1553           leave move_block .
     1554         end.
     1555       end.
     1556       assign
     1557         v-diasize-need-full-display = true
     1558       .
     1559       if v-diasize-change-size = false
     1560       then do:
     1561         assign
     1562           v-diasize-change-size = true
     1563         .
     1564       end.
     1565       else do:
     1566         return .
     1567       end.
     1568       assign
     1569         v-frame-height = frame Dialog-Frame :height
     1570         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1571         v-browse-height = v-diasize-browse-handle :height
     1572       .
     1573       for each buf_temp-browse-handle
     1574         where buf_temp-browse-handle.browse-type = 'height':u
     1575       :
     1576         assign
     1577           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1578         .
     1579       end.
     1580       for each buf_temp-diasize-handle
     1581       :
     1582         delete buf_temp-diasize-handle .
     1583       end.
     1584       assign
     1585         v-field-group-handle = frame Dialog-Frame :first-child
     1586       .
     1587       do while valid-handle(v-field-group-handle)
     1588       :
     1589         assign
     1590           v-object-handle = v-field-group-handle :first-child
     1591         .
     1592         do while valid-handle(v-object-handle)
     1593         :
     1594           if  v-object-handle <> v-diasize-browse-handle :handle
     1595           and can-query(v-object-handle, "row")
     1596           and can-query(v-object-handle, "height")
     1597           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1598           then do:
     1599             find first buf_temp-browse-handle
     1600               where buf_temp-browse-handle.browse-type   = 'height':u
     1601                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1602               no-error .
     1603             if available buf_temp-browse-handle
     1604             then do:
     1605             end.
     1606             else do:
     1607               create buf_temp-diasize-handle .
     1608               assign
     1609                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1610                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1611               .
     1612             end.
     1613           end.
     1614           assign
     1615             v-object-handle = v-object-handle :next-sibling
     1616           .
     1617         end.
     1618         assign
     1619           v-field-group-handle = v-field-group-handle :next-sibling
     1620         .
     1621       end.
     1622       do with frame Dialog-Frame
     1623       :
     1624         hide v-diasize-resize-button .
     1625         assign
     1626           v-diasize-resize-button :row    = 1
     1627           v-diasize-resize-button :column = 1
     1628         .
     1629       end.
     1630       if p-change-value > 0
     1631       then do:
     1632         if frame Dialog-Frame :scrollable = true
     1633         then do:
     1634           assign
     1635             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1636             no-error .
     1637           if error-status :error
     1638           or error-status :get-message(1) <> ""
     1639           then do:
     1640             undo move_block, retry move_block .
     1641           end.
     1642         end.
     1643         assign
     1644           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1645           no-error .
     1646         if error-status :error
     1647         or error-status :get-message(1) <> ""
     1648         then do:
     1649           undo move_block, retry move_block .
     1650         end.
     1651         assign
     1652           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1653           no-error .
     1654         if error-status :error
     1655         or error-status :get-message(1) <> ""
     1656         then do:
     1657           undo move_block, retry move_block .
     1658         end.
     1659         for each buf_temp-browse-handle
     1660           where buf_temp-browse-handle.browse-type = 'height':u
     1661         on error undo move_block, retry move_block
     1662         :
     1663           assign
     1664             buf_temp-browse-handle.browse-handle :height
     1665               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1666             no-error .
     1667           if error-status :error
     1668           or error-status :get-message(1) <> ""
     1669           then do:
     1670             undo move_block, retry move_block .
     1671           end.
     1672         end.
     1673         for each buf_temp-diasize-handle
     1674         on error undo move_block, retry move_block
     1675         :
     1676           assign
     1677             v-object-handle = buf_temp-diasize-handle.handle-value
     1678           .
     1679           if v-object-handle <> v-diasize-resize-button
     1680           then do:
     1681             assign
     1682               v-object-handle :row = v-object-handle :row + p-change-value
     1683               no-error .
     1684             if error-status :error
     1685             or error-status :get-message(1) <> ""
     1686             then do:
     1687               undo move_block, retry move_block .
     1688             end.
     1689           end.
     1690         end.
     1691       end.
     1692       else do:
     1693         for each buf_temp-diasize-handle
     1694         on error undo move_block, retry move_block
     1695         :
     1696           assign
     1697             v-object-handle = buf_temp-diasize-handle.handle-value
     1698           .
     1699           if v-object-handle <> v-diasize-resize-button
     1700           then do:
     1701             assign
     1702               v-object-handle :row = v-object-handle :row + p-change-value
     1703               no-error .
     1704             if error-status :error
     1705             or error-status :get-message(1) <> ""
     1706             then do:
     1707               undo move_block, retry move_block .
     1708             end.
     1709           end.
     1710         end.
     1711         assign
     1712           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1713           no-error .
     1714         if error-status :error
     1715         or error-status :get-message(1) <> ""
     1716         then do:
     1717           undo move_block, retry move_block .
     1718         end.
     1719         for each buf_temp-browse-handle
     1720           where buf_temp-browse-handle.browse-type = 'height':u
     1721         on error undo move_block, retry move_block
     1722         :
     1723           assign
     1724             buf_temp-browse-handle.browse-handle :height
     1725               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1726             no-error .
     1727           if error-status :error
     1728           or error-status :get-message(1) <> ""
     1729           then do:
     1730             undo move_block, retry move_block .
     1731           end.
     1732         end.
     1733         assign
     1734           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1735           no-error .
     1736         if error-status :error
     1737         or error-status :get-message(1) <> ""
     1738         then do:
     1739           undo move_block, retry move_block .
     1740         end.
     1741         if frame Dialog-Frame :scrollable = true
     1742         then do:
     1743           assign
     1744             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1745             no-error .
     1746           if error-status :error
     1747           or error-status :get-message(1) <> ""
     1748           then do:
     1749             undo move_block, retry move_block .
     1750           end.
     1751         end.
     1752       end.
     1753       if p-move-resize = true
     1754       then do:
     1755         run diasize_position-resize-button in this-procedure .
     1756       end.
     1757       if v-diasize-wndstore = true
     1758       then do:
     1759         if connected("ub") = true
     1760         then do:
     1761           define variable v-cntxt-db-num        as integer   no-undo .
     1762           define variable v-cntxt-userid        as character no-undo .
     1763           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1764                                             , OUTPUT v-cntxt-userid
     1765                                             ) .
     1766           run gbl/wndsizew.p
     1767             (input  v-cntxt-db-num
     1768             ,input  v-cntxt-userid
     1769             ,input  v-diasize-proc-name
     1770             ,input  'height':u
     1771             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1772             ) .
     1773         end.
     1774       end.
     1775     end.
     1776     assign
     1777       v-diasize-change-size = false
     1778     .
     1779   end procedure.
     1780   procedure diasize_set-height :
     1781     define input  parameter p-new-height  as decimal   no-undo .
     1782     define input  parameter p-move-resize as logical   no-undo .
     1783     do
     1784     on error undo, return error return-value
     1785     :
     1786       run diasize_change-height in this-procedure
     1787         (input  (p-new-height - frame Dialog-Frame :height)
     1788         ,input  p-move-resize
     1789         ) .
     1790     end.
     1791   end procedure.
     1792   procedure diasize_change-width :
     1793     define input  parameter p-change-value as decimal   no-undo .
     1794     define input  parameter p-move-resize  as logical   no-undo .
     1795     define variable v-field-group-handle   as handle    no-undo .
     1796     define variable v-object-handle        as handle    no-undo .
     1797     define variable v-frame-width          as decimal   no-undo .
     1798     define variable v-frame-virtual-width  as decimal   no-undo .
     1799     define variable v-browse-width         as decimal   no-undo .
     1800     define variable v-window-width         as decimal   no-undo .
     1801     define variable v-window-virtual-width as decimal   no-undo .
     1802     define variable v-change-sign          as integer   no-undo .
     1803     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1804     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1805     if p-change-value > 0
     1806     then do:
     1807       if frame Dialog-Frame :width + p-change-value >
     1808           session :width-chars
     1809       then do:
     1810         assign
     1811           p-change-value = session :width-chars - frame Dialog-Frame :width
     1812         .
     1813         if p-change-value <= 0
     1814         then do:
     1815           run diasize_position-resize-button in this-procedure .
     1816           return .
     1817         end.
     1818       end.
     1819     end.
     1820     if p-change-value < 0
     1821     then do:
     1822       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1823       then do:
     1824         assign
     1825           p-change-value = v-diasize-orig-frame-width
     1826                          - frame Dialog-Frame :width
     1827         .
     1828         if p-change-value >= 0
     1829         then do:
     1830           run diasize_position-resize-button in this-procedure .
     1831           return .
     1832         end.
     1833       end.
     1834     end.
     1835     if p-change-value >= 0
     1836     then do:
     1837       assign
     1838         v-change-sign = 1
     1839       .
     1840     end.
     1841     else do:
     1842       assign
     1843         v-change-sign = -1
     1844       .
     1845     end.
     1846     assign
     1847       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1848     .
     1849     if p-change-value = 0
     1850     then do:
     1851       run diasize_position-resize-button in this-procedure .
     1852       return .
     1853     end.
     1854     move_block:
     1855     do
     1856     on error undo move_block, leave move_block
     1857     :
     1858       if retry
     1859       then do:
     1860         do
     1861         on error undo move_block, leave move_block
     1862         :
     1863           if p-change-value > 0
     1864           then do:
     1865             for each buf_temp-diasize-handle
     1866             on error undo, next
     1867             :
     1868               assign
     1869                 v-object-handle = buf_temp-diasize-handle.handle-value
     1870               .
     1871               if v-object-handle <> v-diasize-resize-button
     1872               then do:
     1873                 assign
     1874                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1875                 .
     1876               end.
     1877             end.
     1878             assign
     1879               v-diasize-browse-handle :width = v-browse-width
     1880             .
     1881             for each buf_temp-browse-handle
     1882               where buf_temp-browse-handle.browse-type = 'width':u
     1883             on error undo, next
     1884             :
     1885               assign
     1886                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1887               .
     1888             end.
     1889             assign
     1890               frame Dialog-Frame :width = v-frame-width
     1891             .
     1892             if frame Dialog-Frame :scrollable = true
     1893             then do:
     1894               assign
     1895                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1896               .
     1897             end.
     1898             run diasize_position-resize-button in this-procedure .
     1899           end.
     1900           else do:
     1901             if frame Dialog-Frame :scrollable = true
     1902             then do:
     1903               assign
     1904                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1905               .
     1906             end.
     1907             assign
     1908               frame Dialog-Frame :width = v-frame-width
     1909             .
     1910             for each buf_temp-browse-handle
     1911               where buf_temp-browse-handle.browse-type = 'width':u
     1912             on error undo, next
     1913             :
     1914               assign
     1915                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1916               .
     1917             end.
     1918             assign
     1919               v-diasize-browse-handle :width = v-browse-width
     1920             .
     1921             for each buf_temp-diasize-handle
     1922             on error undo, next
     1923             :
     1924               assign
     1925                 v-object-handle = buf_temp-diasize-handle.handle-value
     1926               .
     1927               if v-object-handle <> v-diasize-resize-button
     1928               then do:
     1929                 assign
     1930                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1931                 .
     1932               end.
     1933             end.
     1934             run diasize_position-resize-button in this-procedure .
     1935           end.
     1936           assign
     1937             v-diasize-change-size = false
     1938           .
     1939           leave move_block .
     1940         end.
     1941       end.
     1942       assign
     1943         v-diasize-need-full-display = true
     1944       .
     1945       if v-diasize-change-size = false
     1946       then do:
     1947         assign
     1948           v-diasize-change-size = true
     1949         .
     1950       end.
     1951       else do:
     1952         return .
     1953       end.
     1954       assign
     1955         v-frame-width = frame Dialog-Frame :width
     1956         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1957         v-browse-width = v-diasize-browse-handle :width
     1958       .
     1959       for each buf_temp-browse-handle
     1960         where buf_temp-browse-handle.browse-type = 'width':u
     1961       :
     1962         assign
     1963           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1964         .
     1965       end.
     1966       for each buf_temp-diasize-handle
     1967       :
     1968         delete buf_temp-diasize-handle .
     1969       end.
     1970       assign
     1971         v-field-group-handle = frame Dialog-Frame :first-child
     1972       .
     1973       do while valid-handle(v-field-group-handle)
     1974       :
     1975         assign
     1976           v-object-handle = v-field-group-handle :first-child
     1977         .
     1978         do while valid-handle(v-object-handle)
     1979         :
     1980           if  v-object-handle <> v-diasize-browse-handle :handle
     1981           and v-object-handle <> v-diasize-resize-button
     1982           and can-query(v-object-handle, "row")
     1983           and can-query(v-object-handle, "height")
     1984           and ( v-object-handle :col + v-object-handle :width
     1985                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1986               )
     1987           then do:
     1988             find first buf_temp-browse-handle
     1989               where buf_temp-browse-handle.browse-type   = 'width':u
     1990                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1991               no-error .
     1992             if available buf_temp-browse-handle
     1993             then do:
     1994             end.
     1995             else do:
     1996               create buf_temp-diasize-handle .
     1997               assign
     1998                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1999                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2000               .
     2001             end.
     2002           end.
     2003           assign
     2004             v-object-handle = v-object-handle :next-sibling
     2005           .
     2006         end.
     2007         assign
     2008           v-field-group-handle = v-field-group-handle :next-sibling
     2009         .
     2010       end.
     2011       do with frame Dialog-Frame
     2012       :
     2013         hide v-diasize-resize-button .
     2014         v-diasize-resize-button :row = 1.
     2015         v-diasize-resize-button :column = 1.
     2016       end.
     2017       if p-change-value > 0
     2018       then do:
     2019         if frame Dialog-Frame :scrollable = true
     2020         then do:
     2021           assign
     2022             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2023             no-error .
     2024           if error-status :error
     2025           or error-status :get-message(1) <> ""
     2026           then do:
     2027             undo move_block, retry move_block.
     2028           end.
     2029         end.
     2030         assign
     2031           frame Dialog-Frame :width = v-frame-width + p-change-value
     2032           no-error .
     2033         if error-status :error
     2034         or error-status :get-message(1) <> ""
     2035         then do:
     2036           undo move_block, retry move_block.
     2037         end.
     2038         assign
     2039           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2040         no-error .
     2041         if error-status :error
     2042         or error-status :get-message(1) <> ""
     2043         then do:
     2044           undo move_block, retry move_block.
     2045         end.
     2046         for each buf_temp-browse-handle
     2047           where buf_temp-browse-handle.browse-type = 'width':u
     2048         on error undo move_block, retry move_block
     2049         :
     2050           assign
     2051             buf_temp-browse-handle.browse-handle :width
     2052               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2053             no-error .
     2054           if error-status :error
     2055           or error-status :get-message(1) <> ""
     2056           then do:
     2057             undo move_block, retry move_block .
     2058           end.
     2059         end.
     2060         for each buf_temp-diasize-handle
     2061         on error undo move_block, retry move_block
     2062         :
     2063           assign
     2064             v-object-handle = buf_temp-diasize-handle.handle-value
     2065           .
     2066           if v-object-handle <> v-diasize-resize-button
     2067           then do:
     2068             assign
     2069               v-object-handle :col = v-object-handle :col + p-change-value
     2070               no-error .
     2071             if error-status :error
     2072             or error-status :get-message(1) <> ""
     2073             then do:
     2074               undo move_block, retry move_block .
     2075             end.
     2076           end.
     2077         end.
     2078       end.
     2079       else do:
     2080         for each buf_temp-diasize-handle
     2081         on error undo move_block, retry move_block
     2082         :
     2083           assign
     2084             v-object-handle = buf_temp-diasize-handle.handle-value
     2085           .
     2086           if v-object-handle <> v-diasize-resize-button
     2087           then do:
     2088             assign
     2089               v-object-handle :col = v-object-handle :col + p-change-value
     2090               no-error .
     2091             if error-status :error
     2092             or error-status :get-message(1) <> ""
     2093             then do:
     2094               undo move_block, retry move_block .
     2095             end.
     2096           end.
     2097         end.
     2098         for each buf_temp-browse-handle
     2099           where buf_temp-browse-handle.browse-type = 'width':u
     2100         on error undo move_block, retry move_block
     2101         :
     2102           assign
     2103             buf_temp-browse-handle.browse-handle :width
     2104               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2105             no-error .
     2106           if error-status :error
     2107           or error-status :get-message(1) <> ""
     2108           then do:
     2109             undo move_block, retry move_block .
     2110           end.
     2111         end.
     2112         assign
     2113           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2114           no-error .
     2115         if error-status :error
     2116         or error-status :get-message(1) <> ""
     2117         then do:
     2118           undo move_block, retry move_block.
     2119         end.
     2120         assign
     2121           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2122         no-error .
     2123         if error-status :error
     2124         or error-status :get-message(1) <> ""
     2125         then do:
     2126           undo move_block, retry move_block.
     2127         end.
     2128         if frame Dialog-Frame :scrollable = true
     2129         then do:
     2130           assign
     2131             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2132           no-error .
     2133           if error-status :error
     2134           or error-status :get-message(1) <> ""
     2135           then do:
     2136             undo move_block, retry move_block.
     2137           end.
     2138         end.
     2139       end.
     2140       if p-move-resize
     2141       then do:
     2142         run diasize_position-resize-button in this-procedure .
     2143       end.
     2144       if v-diasize-wndstore = true
     2145       then do:
     2146         if connected("ub") = true
     2147         then do:
     2148           define variable v-cntxt-db-num        as integer   no-undo .
     2149           define variable v-cntxt-userid        as character no-undo .
     2150           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2151                                             , OUTPUT v-cntxt-userid
     2152                                             ) .
     2153           run gbl/wndsizew.p
     2154             (input  v-cntxt-db-num
     2155             ,input  v-cntxt-userid
     2156             ,input  v-diasize-proc-name
     2157             ,input  'width':u
     2158             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2159             ) .
     2160         end.
     2161       end.
     2162     end.
     2163     assign
     2164       v-diasize-change-size = false
     2165     .
     2166   end procedure.
     2167   procedure diasize_set-width :
     2168     define input  parameter p-new-width  as decimal   no-undo .
     2169     define input  parameter p-move-resize as logical   no-undo .
     2170     do
     2171     on error undo, return error return-value
     2172     :
     2173       run diasize_change-width in this-procedure
     2174         (input  (p-new-width - frame Dialog-Frame :width)
     2175         ,input  p-move-resize
     2176         ) .
     2177     end.
     2178   end procedure.
     2179   procedure diasize_position-resize-button :
     2180     do with frame Dialog-Frame
     2181     :
     2182       hide v-diasize-resize-button .
     2183       assign
     2184         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2185                     - 1
     2186                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2187         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2188                     - 1
     2189                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2190       .
     2191       view v-diasize-resize-button .
     2192     end.
     2193   end procedure.
     2194   on alt-right anywhere
     2195   do:
     2196     run diasize_change-width in this-procedure
     2197       (input 1
     2198       ,input true
     2199       ) .
     2200     return no-apply .
     2201   end.
     2202   on alt-left anywhere
     2203   do:
     2204     run diasize_change-width in this-procedure
     2205       (input -1
     2206       ,input true
     2207       ) .
     2208     return no-apply .
     2209   end.
     2210   on alt-down anywhere
     2211   do:
     2212     run diasize_change-height in this-procedure
     2213       (input 1
     2214       ,input true
     2215       ) .
     2216     return no-apply .
     2217   end.
     2218   on alt-up anywhere
     2219   do:
     2220     run diasize_change-height in this-procedure
     2221       (input -1
     2222       ,input true
     2223       ) .
     2224     return no-apply .
     2225   end.
     2226   on alt-enter of frame Dialog-Frame
     2227   do:
     2228     run diasize_maximize in this-procedure
     2229       (input  ?
     2230       ).
     2231     return no-apply .
     2232   end.
     2233   procedure diasize_end-move :
     2234     do
     2235     on error undo, return error return-value
     2236     :
     2237       define variable v-row-delta as decimal   no-undo .
     2238       define variable v-col-delta as decimal   no-undo .
     2239       define variable v-new-row as decimal   no-undo .
     2240       define variable v-new-col as decimal   no-undo .
     2241       assign
     2242         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2243         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2244       .
     2245       assign
     2246         v-row-delta = v-new-row - frame Dialog-Frame :height
     2247         v-col-delta = v-new-col - frame Dialog-Frame :width
     2248       .
     2249       run diasize_change-height in this-procedure
     2250         (input v-row-delta
     2251         ,input true
     2252         ) .
     2253       run diasize_change-width in this-procedure
     2254         (input v-col-delta
     2255         ,input true
     2256         ) .
     2257     end.
     2258   end procedure.
     2259   procedure diasize_maximize :
     2260     define input  parameter p-action as logical   no-undo .
     2261     do
     2262     on error undo, return error return-value
     2263     :
     2264       if p-action = ?
     2265       then do:
     2266         if v-diasize-need-maximize = true
     2267         then do:
     2268           assign
     2269             p-action = true
     2270           .
     2271         end.
     2272         else do:
     2273           assign
     2274             p-action = false
     2275           .
     2276         end.
     2277       end.
     2278       if p-action = true
     2279       then do:
     2280         run diasize_change-height in this-procedure
     2281           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2282               - frame Dialog-Frame :height-chars
     2283           ,input true
     2284           ) .
     2285         run diasize_change-width in this-procedure
     2286           (input session :width-chars
     2287               - frame Dialog-Frame :width-chars
     2288           ,input true
     2289           ) .
     2290         assign
     2291           v-diasize-need-maximize = false
     2292         .
     2293       end.
     2294       else do:
     2295         run diasize_change-width in this-procedure
     2296           (input v-diasize-orig-frame-width
     2297               - frame Dialog-Frame :width-chars
     2298           ,input true
     2299           ) .
     2300         run diasize_change-height in this-procedure
     2301           (input v-diasize-orig-frame-height
     2302               - frame Dialog-Frame :height-chars
     2303           ,input true
     2304           ) .
     2305         assign
     2306           v-diasize-need-maximize = true
     2307         .
     2308       end.
     2309     end.
     2310   end procedure.
     2311   procedure diasize_restore-orig-size :
     2312     do
     2313     on error undo, return error return-value
     2314     :
     2315       assign
     2316         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2317         v-diasize-current-frame-height = frame Dialog-Frame :height
     2318       .
     2319       run diasize_set-height in this-procedure
     2320         (input  v-diasize-orig-frame-height
     2321         ,input  true
     2322         ) .
     2323       run diasize_set-width in this-procedure
     2324         (input  v-diasize-orig-frame-width
     2325         ,input  true
     2326         ) .
     2327     end.
     2328   end procedure.
     2329   procedure diasize_restore-current-size :
     2330     do
     2331     on error undo, return error return-value
     2332     :
     2333       run diasize_set-height in this-procedure
     2334         (input  v-diasize-current-frame-height
     2335         ,input  true
     2336         ) .
     2337       run diasize_set-width in this-procedure
     2338         (input  v-diasize-current-frame-width
     2339         ,input  true
     2340         ) .
     2341     end.
     2342   end procedure.
     2343   procedure diasize_set-browse-handle :
     2344     define input  parameter p-browse-handle as handle   no-undo .
     2345     define buffer buf_temp-browse-handle for temp-browse-handle .
     2346     do
     2347     on error undo, return error return-value
     2348     :
     2349       assign
     2350         v-diasize-browse-handle = p-browse-handle
     2351       .
     2352       for each buf_temp-browse-handle
     2353       on error undo, return error return-value
     2354       :
     2355         delete buf_temp-browse-handle .
     2356       end.
     2357     end.
     2358   end procedure.
     2359   procedure diasize_add_browse :
     2360     define input  parameter p-browse-type   as character no-undo .
     2361     define input  parameter p-browse-handle as handle    no-undo .
     2362     define buffer buf_temp-browse-handle for temp-browse-handle .
     2363     do
     2364     on error undo, return error return-value
     2365     :
     2366       assign
     2367         v-diasize-browse-number = v-diasize-browse-number + 1
     2368       .
     2369       create buf_temp-browse-handle .
     2370       assign
     2371         buf_temp-browse-handle.browse-type   = p-browse-type
     2372         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2373         buf_temp-browse-handle.browse-handle = p-browse-handle
     2374       .
     2375     end.
     2376   end procedure.
     2377   procedure diasize_init :
     2378     define variable v-default-value    as logical   no-undo .
     2379     define variable v-restore-saved    as logical   no-undo .
     2380     define variable v-resize-value-str as character no-undo .
     2381     do
     2382     on error undo, return error return-value
     2383     :
     2384       do with frame Dialog-Frame
     2385       :
     2386         assign
     2387           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2388           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2389           v-diasize-browse-handle     = browse br-ccur :handle
     2390         .
     2391         create button v-diasize-resize-button
     2392         assign
     2393           parent        = frame Dialog-Frame :first-child
     2394           label         = "s"
     2395           height-pixels = 16
     2396           width-pixels  = 16
     2397           visible       = true
     2398           sensitive     = true
     2399           movable       = true
     2400           triggers:
     2401             on end-move persistent run diasize_end-move in this-procedure .
     2402           end triggers.
     2403         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2404         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2405         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2406         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2407         assign
     2408           v-diasize-wndmax = false
     2409         .
     2410         if connected("ub") = true
     2411         then do:
     2412           define variable v-cntxt-db-num        as integer   no-undo .
     2413           define variable v-cntxt-userid        as character no-undo .
     2414           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2415                                             , OUTPUT v-cntxt-userid
     2416                                             ) .
     2417           run gbl/wndpar_r.p
     2418             (input  v-cntxt-db-num
     2419             ,input  v-cntxt-userid
     2420             ,input  'wndmax':U
     2421             ,output v-diasize-wndmax
     2422             ,output v-default-value
     2423             ) .
     2424         end.
     2425         assign
     2426           v-diasize-wndstore = false
     2427         .
     2428         if connected("ub") = true
     2429         then do:
     2430           run gbl/wndpar_r.p
     2431             (input  v-cntxt-db-num
     2432             ,input  v-cntxt-userid
     2433             ,input  'wndstore':U
     2434             ,output v-diasize-wndstore
     2435             ,output v-default-value
     2436             ) .
     2437         end.
     2438         assign
     2439           v-diasize-proc-name = entry(1, program-name(2), '.')
     2440         .
     2441         if v-diasize-wndstore = true
     2442         then do:
     2443           assign
     2444             v-restore-saved = false
     2445           .
     2446           if connected("ub") = true
     2447           then do:
     2448             run gbl/wndsizer.p
     2449               (input  v-cntxt-db-num
     2450               ,input  v-cntxt-userid
     2451               ,input  v-diasize-proc-name
     2452               ,input  'height':u
     2453               ,output v-resize-value-str
     2454               ) .
     2455             if v-resize-value-str <> '':U
     2456             then do:
     2457               run diasize_change-height in this-procedure
     2458                 (input  integer(v-resize-value-str)
     2459                 ,input  true
     2460                 ) .
     2461               assign
     2462                 v-restore-saved = true
     2463               .
     2464             end.
     2465           end.
     2466           if connected("ub") = true
     2467           then do:
     2468             run gbl/wndsizer.p
     2469               (input  v-cntxt-db-num
     2470               ,input  v-cntxt-userid
     2471               ,input  v-diasize-proc-name
     2472               ,input  'width':u
     2473               ,output v-resize-value-str
     2474               ) .
     2475             if v-resize-value-str <> '':U
     2476             then do:
     2477               run diasize_change-width in this-procedure
     2478                 (input  integer(v-resize-value-str)
     2479                 ,input  true
     2480                 ) .
     2481               assign
     2482                 v-restore-saved = true
     2483               .
     2484             end.
     2485           end.
     2486           if v-restore-saved <> true
     2487           then do:
     2488             if v-diasize-wndmax = true
     2489             then do:
     2490               run diasize_maximize in this-procedure
     2491                 (input  true
     2492                 ) .
     2493             end.
     2494           end.
     2495         end.
     2496         else do:
     2497           if v-diasize-wndmax = true
     2498           then do:
     2499             run diasize_maximize in this-procedure
     2500               (input  true
     2501               ) .
     2502           end.
     2503         end.
     2504       end.
     2505     end.
     2506   end procedure.
     2507   procedure diasize_need-full-display :
     2508     define output parameter p-need-full-display as logical   no-undo .
     2509     do
     2510     on error undo, return error return-value
     2511     :
     2512       assign
     2513         p-need-full-display = v-diasize-need-full-display
     2514       .
     2515       assign
     2516         v-diasize-need-full-display = false
     2517       .
     2518     end.
     2519   end procedure.
     2520   procedure get-context :
     2521      define output parameter p-db-num as integer          no-undo.
     2522      define output parameter p-user-id as character        no-undo.
     2523      define variable v-login               as character    no-undo.
     2524      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2525      define buffer buf_user-login  for ub.user-login .
     2526      do
     2527      on error undo, return error
     2528      :
     2529            FIND FIRST buf_sys-ctrl no-lock.
     2530            ASSIGN
     2531               v-login = USERID("ub")
     2532               p-db-num = buf_sys-ctrl.db-num
     2533            .
     2534            FIND FIRST buf_user-login
     2535                 WHERE buf_user-login.db-num = p-db-num
     2536                   AND buf_user-login.user-login = v-login
     2537                 no-lock
     2538                 no-error
     2539                 .
     2540            IF AVAILABLE buf_user-login
     2541            THEN DO:
     2542               assign
     2543                  p-user-id = buf_user-login.user-id
     2544               .
     2545            END.
     2546      end.
     2547   end procedure.
     2548   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2549   on f5 of frame Dialog-Frame anywhere
     2550   do:
     2551     v-doc-rec = recid(X_c-curr-bank). run OpenBr in this-procedure. reposition br-ccur to recid v-doc-rec no-error. v-doc-rec = ?.               apply 'value-changed' to br-ccur.
     2552       apply "VALUE-CHANGED" to br-ccur.
     2553   end.
     2554   def var sort-labelbr-ccur   as character no-undo .
     2555   def var sort-clmnbr-ccur    as handle    no-undo .
     2556   def var cur-clmnbr-ccur     as handle    no-undo .
     2557   def var cur-clmn-locbr-ccur as integer   no-undo .
     2558   def var re-querybr-ccur     as logical   initial no no-undo .
     2559   on start-search, ctrl-o of br-ccur in frame Dialog-Frame do:
     2560      run sort-brbr-ccur
     2561        (input (if available X_c-curr-bank
     2562                then recid(X_c-curr-bank)
     2563                else ?
     2564               )
     2565        ).
     2566   end.
     2567   PROCEDURE sort-brbr-ccur :
     2568     define input parameter p-recid as recid no-undo .
     2569     if re-querybr-ccur = no then do:
     2570       assign
     2571          cur-clmnbr-ccur = br-ccur:current-column in frame Dialog-Frame
     2572       .
     2573       if sort-clmnbr-ccur <> ? then sort-clmnbr-ccur:column-fgcolor = 0.
     2574       if cur-clmnbr-ccur = sort-clmnbr-ccur then do:
     2575         assign
     2576            sort-labelbr-ccur = ""
     2577            sort-clmnbr-ccur = ?
     2578         .
     2579        end.
     2580        else do:
     2581          assign
     2582            sort-labelbr-ccur = cur-clmnbr-ccur:label
     2583            sort-clmnbr-ccur  = cur-clmnbr-ccur
     2584            sort-clmnbr-ccur:column-fgcolor = 4
     2585          .
     2586        end.
     2587      end.
     2588     assign
     2589       cur-clmn-locbr-ccur = 1
     2590     .
     2591     def var column-handle as handle no-undo .
     2592     column-handle = br-ccur:first-column.
     2593     do while valid-handle(column-handle) :
     2594       if column-handle = cur-clmnbr-ccur then do:
     2595         leave .
     2596       end.
     2597       column-handle = column-handle:NEXT-COLUMN.
     2598       assign
     2599         cur-clmn-locbr-ccur = cur-clmn-locbr-ccur + 1
     2600       .
     2601     end.
     2602     case sort-labelbr-ccur:
     2603           when X_c-curr-bank.exch-date:label in browse br-ccur then DO:   assign     sort-column-name = "X_c-curr-bank.exch-date"   .   run OpenBr.   . END.
     2604       otherwise do:
     2605         assign
     2606           sort-column-name = ""
     2607         .
     2608         run OpenBr.
     2609           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-ccur') then do:
     2610             run mv-brw-defaultbr-ccur.
     2611           end.
     2612         if sort-labelbr-ccur <> "" then do:
     2613           assign
     2614             cur-clmnbr-ccur:column-fgcolor = 0
     2615           .
     2616         end.
     2617         assign
     2618           cur-clmn-locbr-ccur = ?
     2619         .
     2620       end.
     2621     end case.
     2622       if cur-clmn-locbr-ccur <> ? then do:
     2623         if can-do( this-procedure:internal-entries, 'ch-clmnbr-ccur') then do:
     2624           run ch-clmnbr-ccur in this-procedure (cur-clmn-locbr-ccur).
     2625         end.
     2626       end.
     2627     if p-recid <> ? then do:
     2628       reposition br-ccur to recid p-recid no-error.
     2629       apply "value-changed" to br-ccur in frame Dialog-Frame.
     2630     end.
     2631     apply "entry" to br-ccur in frame Dialog-Frame.
     2632   END PROCEDURE.
     2633   procedure re-open-query-srt-clmnbr-ccur:
     2634   if cur-clmnbr-ccur = ? then do:
     2635      run OpenBr.
     2636   end.
     2637   else do:
     2638      assign re-querybr-ccur = yes.
     2639      run sort-brbr-ccur
     2640        (input (if available X_c-curr-bank
     2641                then recid(X_c-curr-bank)
     2642                else ?
     2643               )
     2644        ).
     2645      assign re-querybr-ccur = no.
     2646   end.
     2647   end.
     2648   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2649   do:
     2650     br-ccur :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2651   end.
     2652   MAIN-BLOCK:
     2653   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2654      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2655    if LOOKUP(p-mode, 'one':U + chr(4) + 'все':U,
     2656                   chr(4)) = 0
     2657        then dO:
     2658       message
     2659       vss-workfile vss-revision vss-description skip
     2660       "Неверное значение параметров вызова p-mode"
     2661       p-mode
     2662       view-as alert-box ERROR.
     2663       return error .
     2664    end.
     2665    if p-mode = "one":U then do:
     2666     find first X_curr-bank no-lock where
     2667                X_curr-bank.curr-code = p-curr-code
     2668          AND   X_curr-bank.exch-date = p-exch-date
     2669                   no-error.
     2670       if not available X_curr-bank then do:
     2671           message
     2672           vss-workfile vss-revision vss-description skip
     2673           "Неверное значение параметра вызова p-curr-code и/или p-exch-date"
     2674           p-curr-code p-exch-date
     2675           view-as alert-box ERROR.
     2676           return.
     2677       end.
     2678     end.
     2679    if p-mode = 'все':U then do:
     2680     find first X_curr-bank no-lock where
     2681                   X_curr-bank.curr-code = p-curr-code no-error.
     2682       if not available X_curr-bank then do:
     2683           message
     2684           vss-workfile vss-revision vss-description skip
     2685           "Неверное значение параметра вызова p-curr-code"
     2686           p-curr-code
     2687           view-as alert-box ERROR.
     2688           return.
     2689       end.
     2690     end.
     2691     v-rid-list = p-rid-list.
     2692   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2693   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2694     (output v-db-num
     2695     )  .
     2696     RUN MyEnable.
     2697     RUn OpenBR.
     2698     HIDE mark-num in frame Dialog-Frame .
     2699     if v-doc-rec <> ? then
     2700     REPOSITION br-ccur to recid v-doc-rec No-ERROR.
     2701   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2702   DEF VAR cur-clmn-numbr-ccur as INT EXTENT 6 no-undo.
     2703   DEF VAR varmvibr-ccur       as INT no-undo.
     2704   DEF VAR varmvjbr-ccur       as INT no-undo.
     2705   DEF VAR varmvkbr-ccur       as INT no-undo.
     2706   DEF VAR varmvlbr-ccur       as INT no-undo.
     2707   DEF VAR move-elementbr-ccur as INT no-undo.
     2708   def var jjbr-ccur           as int no-undo.
     2709   do varmvibr-ccur = 1 to EXTENT(cur-clmn-numbr-ccur):
     2710     ASSIGN cur-clmn-numbr-ccur[varmvibr-ccur] = varmvibr-ccur.
     2711   END.
     2712   RUN start-mv-clmnbr-ccur.
     2713   PROCEDURE start-mv-clmnbr-ccur:
     2714   def var old-session as logical no-undo.
     2715      old-session = SESSION:IMMEDIATE-DISPLAY.
     2716      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2717          IF  p-mode = 'one'  THEN DO:
     2718      DO jjbr-ccur = NUM-ENTRIES('1,2,3,4,5,6') TO 1 BY -1:
     2719        RUN re-move-clmnbr-ccur ( cur-clmn-numbr-ccur[INTEGER(ENTRY (jjbr-ccur, '1,2,3,4,5,6'))] , 1).
     2720      END.
     2721          END.
     2722      SESSION:IMMEDIATE-DISPLAY = old-session.
     2723   END.
     2724   ON ctrl-cursor-right OF BROWSE br-ccur do:
     2725     RUN re-move-clmnbr-ccur ( 1, 6).
     2726   END.
     2727   ON ctrl-cursor-left OF BROWSE br-ccur do:
     2728     RUN re-move-clmnbr-ccur (6, 1).
     2729   END.
     2730   PROCEDURE re-move-clmnbr-ccur:
     2731     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2732     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2733     DO varmvibr-ccur = 1 TO EXTENT(cur-clmn-numbr-ccur):
     2734       if cur-clmn-numbr-ccur[varmvibr-ccur] = source-column THEN cur-clmn-numbr-ccur[varmvibr-ccur] = -1.
     2735     END.
     2736     if br-ccur:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     2737     if source-column > target-column THEN
     2738     DO varmvjbr-ccur = source-column - 1 to target-column BY -1:
     2739       DO varmvibr-ccur = 1 TO EXTENT(cur-clmn-numbr-ccur):
     2740           if cur-clmn-numbr-ccur[varmvibr-ccur] = varmvjbr-ccur THEN DO:
     2741             cur-clmn-numbr-ccur[varmvibr-ccur] = cur-clmn-numbr-ccur[varmvibr-ccur] + 1.
     2742           END.
     2743       END.
     2744     END.
     2745     ELSE
     2746     DO varmvjbr-ccur = source-column + 1 to target-column:
     2747       DO varmvibr-ccur = 1 TO EXTENT(cur-clmn-numbr-ccur):
     2748         if cur-clmn-numbr-ccur[varmvibr-ccur] = varmvjbr-ccur THEN DO:
     2749           cur-clmn-numbr-ccur[varmvibr-ccur] = cur-clmn-numbr-ccur[varmvibr-ccur] - 1.
     2750         END.
     2751       END.
     2752     END.
     2753     DO varmvibr-ccur = 1 TO EXTENT(cur-clmn-numbr-ccur):
     2754       if cur-clmn-numbr-ccur[varmvibr-ccur] = -1 THEN cur-clmn-numbr-ccur[varmvibr-ccur] = target-column.
     2755     END.
     2756   END PROCEDURE.
     2757   PROCEDURE ch-clmnbr-ccur:
     2758     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2759     if cur-clmn-loc <= 1 then do:
     2760       return .
     2761     end.
     2762     DO varmvibr-ccur = 1 TO EXTENT(cur-clmn-numbr-ccur):
     2763       if cur-clmn-numbr-ccur[varmvibr-ccur] = cur-clmn-loc THEN move-elementbr-ccur = varmvibr-ccur.
     2764     END.
     2765     RUN re-move-clmnbr-ccur (cur-clmn-loc, 1).
     2766   END PROCEDURE.
     2767   PROCEDURE mv-brw-defaultbr-ccur:
     2768   def var old-session as logical no-undo.
     2769     old-session = SESSION:IMMEDIATE-DISPLAY.
     2770     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2771     do varmvlbr-ccur = 1 to EXTENT(cur-clmn-numbr-ccur):
     2772       RUN re-move-clmnbr-ccur (cur-clmn-numbr-ccur[varmvlbr-ccur], varmvlbr-ccur).
     2773     END.
     2774     RUN start-mv-clmnbr-ccur.
     2775     SESSION:IMMEDIATE-DISPLAY = old-session.
     2776   END PROCEDURE.
     2777   .
     2778     run diasize_add_browse in this-procedure
     2779       (input  'width':u
     2780       ,input  browse br-changes :handle
     2781       ) .
     2782     run diasize_init in this-procedure .
     2783   WAIT-FOR GO OF FRAME Dialog-Frame.
     2784   END.
     2785   RUN disable_UI.
     2786   PROCEDURE disable_UI :
     2787     HIDE FRAME Dialog-Frame.
     2788   END PROCEDURE.
     2789   PROCEDURE enable_UI :
     2790     DISPLAY mark-num
     2791         WITH FRAME Dialog-Frame.
     2792     ENABLE b-quit B-mark B-sel B-Help br-ccur BR-changes mark-num
     2793         WITH FRAME Dialog-Frame.
     2794     VIEW FRAME Dialog-Frame.
     2795     OPEN QUERY br-ccur FOR EACH X_c-curr-bank NO-LOCK INDEXED-REPOSITION.
     2796   END PROCEDURE.
     2797   PROCEDURE MyEnable :
     2798   assign
     2799   temp-changes.l_name:resizable in browse br-changes = true
     2800   temp-changes.v_old:resizable in browse br-changes = true
     2801   temp-changes.v_new:resizable in browse br-changes = true
     2802   temp-changes.l_name:width in browse br-changes = 30
     2803   temp-changes.v_old:width in browse br-changes = 40
     2804   temp-changes.v_new:width in browse br-changes = 40
     2805   .
     2806   DISPLAY mark-num
     2807   WITH FRAME Dialog-Frame.
     2808   ENABLE
     2809   b-quit
     2810   B-mark when LOOKUP("b-mark":U, bttns) > 0
     2811   B-sel when LOOKUP("b-sel":U, bttns) > 0
     2812   B-Help
     2813   br-ccur mark-num
     2814   br-changes
     2815   with FRAME Dialog-Frame.
     2816   VIEW FRAME Dialog-Frame.
     2817   END PROCEDURE.
     2818   PROCEDURE OpenBr :
     2819   CASE p-mode:
     2820     when 'все':U then do:
     2821       OPEN QUERY br-ccur FOR EACH X_c-curr-bank NO-LOCK where
     2822                                     X_c-curr-bank.curr-code = p-curr-code  INDEXED-REPOSITION.
     2823     end.
     2824     when 'one':U then do:
     2825       OPEN QUERY br-ccur FOR EACH X_c-curr-bank NO-LOCK where
     2826                                     X_c-curr-bank.curr-code = p-curr-code
     2827                                 AND X_c-curr-bank.exch-date = p-exch-date
     2828                                 AND X_c-curr-bank.corr-user-db-num = 0
     2829                                     INDEXED-REPOSITION.
     2830     end.
     2831   END CASE.
     2832   APPLY "VALUE-CHANGED" TO br-ccur in frame Dialog-Frame.
     2833   APPLY "ENTRY" TO br-ccur.
     2834   END PROCEDURE.
     2835   PROCEDURE proc-br-ccur :
     2836   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2837   if b-sel:sensitive in frame Dialog-Frame then dO:
     2838       if b-mark:sensitive then do:
     2839           apply "choose" to b-mark in frame Dialog-Frame.
     2840       end.
     2841       else do:
     2842           apply "choose" to b-sel in frame Dialog-Frame.
     2843       end.
     2844   end.
     2845   else do:
     2846       if b-lookup:sensitive then
     2847       apply "choose" to b-lookup in frame Dialog-Frame.
     2848   end.
     2849   END PROCEDURE.
     2850   PROCEDURE proc-view-changes :
     2851   define buffer new_c-curr-bank for ub.c-curr-bank.
     2852   define buffer current_curr-bank for ub.curr-bank.
     2853   define variable v-chg-fields as character no-undo.
     2854   define variable v-old-fields as character no-undo.
     2855   define variable v-new-fields as character no-undo.
     2856   define variable ii as integer no-undo.
     2857   define variable jj as integer no-undo .
     2858   define variable v-field-name as character no-undo .
     2859   define variable v-field-label as character no-undo .
     2860   for each temp-changes:
     2861       delete temp-changes.
     2862   END.
     2863   if not available X_c-curr-bank then do:
     2864     Open QUery br-changes for each temp-changes.
     2865     return.
     2866   end.
     2867   define variable v-label-param as character no-undo .
     2868   v-label-param =
     2869     "curr-code" + chr(4) + "Код валюты" + chr(4) + "" + chr(8)
     2870    + "exch-date" + chr(4) + "Дата курса" + chr(4) + "" + chr(8)
     2871    + "exch-rate" + chr(4) + "Курс валюты" + chr(4) + "" + chr(8)
     2872    + "exch-scale" + chr(4) + "Масштаб" + chr(4) + ""  .
     2873    run proc-full-temp-changes in this-procedure (
     2874                                                input  buffer X_c-curr-bank:handle
     2875                                               ,input  'curr-bank':U
     2876                                               ,input  "curr-code,exch-date,exch-rate,exch-scale"
     2877                                               ,input  v-label-param).
     2878   Open QUery br-changes for each temp-changes.
     2879   END PROCEDURE.
