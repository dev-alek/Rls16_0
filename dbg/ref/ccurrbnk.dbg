        1   DEFINE BUFFER X_c-curr-bank FOR ub.c-curr-bank.
        2   DEFINE BUFFER X_curr-bank FOR ub.curr-bank.
        3   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
