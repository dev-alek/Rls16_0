      129   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      131   define new shared variable RepPathName        as character no-undo .
      132   define new shared variable PrintRubl          as logical   no-undo .
      133   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      134   define variable v-waitfram-action01         as character   no-undo .
      135   define variable v-waitfram-action02         as character   no-undo .
      136   define variable v-waitfram-action03         as character   no-undo .
      137   define variable mWaitFramTextBeg            as character   no-undo.
      138   define variable mWaitFramTextEnd            as character   no-undo.
      139   define variable mWaitFramView               as logical     no-undo.
      140   define variable mWaitProcEvent              as logical     no-undo init yes.
      141   define variable mWaitFramInterval           as integer     no-undo init 1 .
      142   define variable mWaitFramStop               as logical     no-undo.
      143   define variable mWaitFramStopUser           as logical     no-undo.
      144   define variable mWaitFramStopTimeOut        as logical     no-undo.
      145   define variable mWaitFramStartProc          as datetime-tz no-undo.
      146   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      147   define button B-WaitFramStop auto-end-key
      148        label "Стоп"
      149        size 10 by 1 tooltip "Остоновить процесс".
      150   define button B-viewProcInfo
      151        label "Информация"
      152        size 15 by 1 tooltip "Информация о процесс".
      153   define frame waitfram
      154     v-waitfram-action01 format "x(72)" no-label skip
      155     v-waitfram-action02 format "x(72)" no-label skip
      156     v-waitfram-action03 format "x(72)" no-label skip
      157     B-viewProcInfo
      158     B-WaitFramStop at row 4 col 30
      159     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      160     .
      161   define new global shared variable mBatchMode as logical no-undo init ?.
      162   define variable mFramBachModHandle as handle no-undo.
      163   mFramBachModHandle = frame waitfram:handle.
      164   define variable mFameOldVis as logical no-undo.
      165   define variable mVisCUrentVin as logical no-undo.
      166   if session:batch-mode
      167   then
      168      mBatchMode = yes.
      169   if mBatchMode = ? then do:
      170     mVisCUrentVin = current-window:visible.
      171     mFameOldVis = mFramBachModHandle:visible.
      172     mFramBachModHandle:visible  = yes.
      173     mBatchMode = mFramBachModHandle:visible ne yes.
      174     mFramBachModHandle:visible = mFameOldVis.
      175     current-window:visible = mVisCUrentVin.
      176   end.
      177    if  log-manager:logfile-name ne ?
      178     then DO:
      179         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      180         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      181         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      182     end.
      183   on choose of B-WaitFramStop in frame waitfram
      184   do:
      185     mWaitFramStop = yes.
      186     mWaitFramStopUser = yes.
      187   end.
      188   function waitfram-check-timeout returns logical():
      189      define variable vtime as int64 no-undo.
      190      if mWaitFramStopTimeOut
      191      then
      192         return yes.
      193      vtime = ( now - mWaitFramStartProc ) / 1000 .
      194      if     mWaitFramTimeOut ne ?
      195         and mWaitFramTimeOut ne 0
      196         and mWaitFramTimeOut lt vtime
      197      then do:
      198         mWaitFramStopTimeOut = yes.
      199      end.
      200      return mWaitFramStopTimeOut.
      201   end.
      202   procedure waitfram-hide :
      203     if not session:batch-mode
      204     then do
      205     on error undo, return error return-value
      206     :
      207       pause 0 before-hide .
      208       if not mBatchMode then
      209         hide frame waitfram .
      210     if     not mWaitFramView
      211        and mWaitProcEvent
      212     then
      213       process events .
      214     end.
      215   end procedure.
      216   procedure waitfram-show :
      217     define input  parameter p-message as character no-undo .
      218     define variable v-left-margin as integer   no-undo .
      219     if not session:batch-mode
      220     then do
      221     on error undo, return error return-value
      222     :
      223       if length(p-message) <= 70 then do:
      224         assign
      225           v-left-margin = integer((70 - length(p-message)) / 2)
      226         .
      227         assign
      228           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      229         .
      230         assign
      231           v-waitfram-action01 = " "
      232           v-waitfram-action02 = " "
      233                                    + fill(" ", v-left-margin)
      234                                    + p-message
      235           v-waitfram-action03 = " "
      236         .
      237       end.
      238       else do:
      239         define variable vRindex1 as integer no-undo.
      240         define variable vRindex2 as integer no-undo.
      241         vRindex1 = r-index(p-message," ",70).
      242         if vRindex1 = 0
      243         then
      244            vRindex1 = 70.
      245         if length(p-message)  <= vRindex1 + 70 then do:
      246           assign
      247             v-waitfram-action01 = " "
      248             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      249             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      250           .
      251         end.
      252         else do:
      253           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      254           if vRindex2 <= vRindex1
      255           then
      256              vRindex2 = vRindex1 + 70.
      257           assign
      258             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      259             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      260             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      261           .
      262         end.
      263       end.
      264       B-viewProcInfo:visible   in frame waitfram = no.
      265       B-viewProcInfo:sensitive in frame waitfram = no.
      266       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      267       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      268       if  (   mWaitFramView
      269          or  mWaitProcEvent)
      270          and not mBatchMode
      271       then
      272          display
      273             v-waitfram-action01 skip
      274             v-waitfram-action02 skip
      275             v-waitfram-action03 skip
      276          with frame waitfram .
      277       if     mWaitFramView
      278          then do:
      279             if     mWaitFramInterval ne ?
      280                and not mBatchMode
      281             then
      282                wait-for go of frame waitfram pause mWaitFramInterval.
      283          end.
      284          else
      285             if     mWaitProcEvent
      286                and not mBatchMode
      287             then
      288                process events .
      289     end.
      290   end procedure.
      291      procedure waitfram-show-this:
      292         define input  parameter iInterval as int64 no-undo.
      293         define variable vtime as int64 no-undo.
      294         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      295         mWaitFramInterval = iInterval.
      296         run waitfram-show (substitute("&1&2 &3&4" ,
      297                                       mWaitFramTextBeg ,
      298                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      299                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      300                                       mWaitFramTextEnd
      301                                      )
      302                           ).
      303      end.
      304      procedure WaitFramRunPause:
      305         define input  parameter iInterval as dec no-undo.
      306         define variable vStart  as datetime-tz no-undo.
      307         define variable vend    as datetime-tz no-undo.
      308         define variable vint as int64 no-undo.
      309         define variable vOk as logical no-undo.
      310         vStart = now.
      311         vend   = vStart.
      312         publish "WaitFramPause" (iInterval,output vOk).
      313         vend   =  now.
      314         vint = vend - vStart.
      315         vint = iInterval - vint / 1000.
      316         if     not mWaitFramStop
      317            and (   vint > 0
      318                 or (    not vOk
      319                     and iInterval eq ?
      320                     )
      321                 )
      322         then
      323            run waitfram-show-this (iInterval).
      324         vend   =  now.
      325         vint = vend - vStart.
      326         vint = iInterval - vint / 1000.
      327         if     not mWaitFramStop
      328            and vint > 0
      329         then do:
      330            run gbl/pause.p (vint * 1000).
      331         end.
      332         if iInterval ne ?
      333         then
      334            publish "WaitFramStop".
      335         waitfram-check-timeout().
      336      end.
      337      procedure WaitFramWaitFor:
      338         define input  parameter iInterval as dec no-undo.
      339         assign
      340            mWaitFramStartProc   = now
      341            mWaitFramStopUser    = no
      342            mWaitFramStopTimeOut = no
      343         .
      344         block-wait:
      345         do while not mWaitFramStop:
      346            run WaitFramRunPause (iInterval).
      347            if  waitfram-check-timeout()
      348            then do:
      349               leave block-wait.
      350            end.
      351         end.
      352         run waitfram-hide.
      353      end.
      354   procedure waitfram-join :
      355     define input  parameter p-line-1  as character no-undo .
      356     define input  parameter p-line-2  as character no-undo .
      357     define input  parameter p-line-3  as character no-undo .
      358     define output parameter p-message as character no-undo .
      359     do
      360     on error undo, return error return-value
      361     :
      362       assign
      363         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      364                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      365                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      366       .
      367     end.
      368   end procedure.
      369   function waitfram-join-function returns character
      370     (input p-line-1 as character
      371     ,input p-line-2 as character
      372     ,input p-line-3 as character
      373     ).
      374     define variable v-message as character no-undo .
      375     run waitfram-join in this-procedure
      376       (input  p-line-1
      377       ,input  p-line-2
      378       ,input  p-line-3
      379       ,output v-message
      380       ) .
      381     return v-message .
      382   end function .
      383   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      384   define  stream PrnLibStream.
      385   procedure prn-lib-prn-file :
      386     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      387     define input parameter p-DIsabledoptions as integer no-undo .
      388     define variable v-report-name as character no-undo .
      389     define variable v-user-action as character no-undo .
      390     define variable v-printed     as logical   no-undo .
      391     define variable v-exist       as logical   no-undo .
      392     do
      393       on error undo, return error
      394       :
      395       run prn-lib-get-report-name  in this-procedure (
      396         input parParentProc
      397         ,output v-report-name
      398         ).
      399   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      400   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      401     (input  v-report-name
      402     ,input  2
      403     ,output v-exist
      404     )  .
      405       if NOT v-exist then
      406       DO:
      407         Message
      408           "Нет заданий на печать ! "
      409           view-as alert-box .
      410         Return  .
      411       End.
      412       run gbl/prnfilen.w
      413         (input  ""
      414         ,input  p-DisabledOptions
      415         ,input  string(v-report-name )
      416         ,input  7
      417         ,output v-user-action
      418         ,output v-printed
      419         ) .
      420       if v-printed then
      421       do:
      422         return "YES" .
      423       end.
      424       else
