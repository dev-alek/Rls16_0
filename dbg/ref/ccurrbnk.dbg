       84   procedure proc-alt-shift-f2:
       85     if not ibs.th.gbl.gbl-var:rcode
       86   then
       87     run gbl\inidebug.p .
       88   end.
       89   procedure proc-alt-shift-f3:
       90     run gbl/prvssinf.p
       91       ( input this-procedure
       92       ) .
       93   end.
       94   define variable v-inform-launched as logical no-undo initial false .
       95   procedure proc-alt-shift-f4:
       96     define variable v-action as character no-undo .
       97     if v-inform-launched = false then do:
       98       assign
       99         v-inform-launched = true
      100       .
