     3760                             ,input parameter-5-33
     3761                             ,input parameter-6-33
     3762                             ,input parameter-7-33
     3763                             )
     3764         .
     3765         assign
     3766           l-filter-open-33 = true
     3767         .
     3768       end.
     3769       if l-filter-open-33 = false then do:
     3770         message
     3771           "Ошибка при фильтрации / сортировке" skip
     3772           "Будут показаны записи без учета фильтра" skip
     3773           view-as alert-box .
     3774       end.
     3775       else do:
     3776           assign
     3777             l-query-was-opened = true
     3778           .
     3779       end.
     3780     end.
     3781     if l-filter-open-33 = false then do:
     3782       OPEN QUERY br-delivtypesubj FOR EACH X_c-delivery-type-subject
     3783         where          X_c-delivery-type-subject.deliv-subj-code  = p-deliv-subj-code            AND X_c-delivery-type-subject.deliv-type-code  = p-deliv-type-code
     3784         indexed-reposition
     3785     .
     3786         assign
     3787           l-query-was-opened = true
     3788         .
     3789     end.
     3790   end.
     3791   else do:
     3792     assign
     3793       v-doc-rec = recid( X_c-delivery-type-subject )
     3794     .
     3795     do
     3796     on stop undo, leave
     3797     on error undo, leave
     3798     :
     3799       if QUERY br-delivtypesubj:handle:get-buffer-handle(1) = (buffer X_c-delivery-type-subject:handle) then do:
     3800         assign
     3801         parameter-2-33 = (if p-find-next then "true":u else "false":u )
     3802         parameter-4-33 =
     3803           "where ":u +  substitute(' X_c-delivery-type-subject.deliv-subj-code  = &1            AND X_c-delivery-type-subject.deliv-type-code  = &2 ', p-deliv-subj-code, p-deliv-type-code )  + " ":u + where-phrase-33 + " ":u + p-find-condition + " " + ""
     3804         parameter-5-33 = "  "
     3805       .
     3806         run fltopend_fltfindd in this-procedure  (
     3807                             input this-procedure:handle
     3808                             ,input QUERY br-delivtypesubj:handle
     3809                             ,input rowid(X_c-delivery-type-subject)
     3810                             ,input logical(parameter-2-33)
     3811                             ,input no-lock
     3812                             ,input (buffer X_c-delivery-type-subject:handle)
     3813                             ,input parameter-4-33
     3814                             ,input parameter-5-33
     3815                             ) no-error.
     3816         .
     3817         assign
     3818           v-doc-rec = integer(return-value)
     3819           v-fltopend-rowid[1] = ?
     3820         .
     3821       end.
     3822       else do:
     3823         assign
     3824         parameter-2-33 = (if p-find-next then "true":u else "false":u )
     3825         parameter-3-33 =  "FOR EACH X_c-delivery-type-subject"
     3826         parameter-4-33 =
     3827           (
     3828             if ("         X_c-delivery-type-subject.deliv-subj-code  = p-deliv-subj-code            AND X_c-delivery-type-subject.deliv-type-code  = p-deliv-type-code                        " + " " + where-phrase-33) <> ""
     3829             then  substitute(' X_c-delivery-type-subject.deliv-subj-code  = &1            AND X_c-delivery-type-subject.deliv-type-code  = &2 ', p-deliv-subj-code, p-deliv-type-code )  + " " + where-phrase-33
     3830             else "true"
     3831           )
     3832         parameter-5-33 = (" " + "" + " " + "" + " " + p-find-condition)
     3833         parameter-6-33 = if sort-phrase-33 = ''
     3834                              then
     3835           (
     3836           " " + "  " +
     3837             " " + sort-column-phrase +
     3838           " " + "  "
     3839           )
     3840                              else
     3841           (
     3842           " " + "  " +
     3843             " " + sort-column-phrase +
     3844           " " + sort-phrase-33
     3845           )
     3846         parameter-7-33 =
     3847           " indexed-reposition  "
     3848       .
     3849         run fltopend_fltfindq in this-procedure  (
     3850                             input this-procedure:handle
     3851                             ,input QUERY br-delivtypesubj:handle
     3852                             ,input logical(parameter-2-33)
     3853                             ,input no-lock
     3854                             ,input parameter-3-33
     3855                             ,input parameter-4-33
     3856                             ,input parameter-5-33
     3857                             ,input parameter-6-33
     3858                             ,input parameter-7-33
     3859                             ,output v-fltopend-rowid
     3860                             ) no-error.
     3861         .
     3862         v-doc-rec = ?.
     3863       end.
     3864       assign
     3865         l-query-was-opened = true
     3866       .
     3867     end.
     3868   end.
     3869     run waitfram-hide in this-procedure .
     3870     END.
     3871   END CASE.
     3872   if not p-open-query then
     3873   REPOSITION br-delivtypesubj to recid v-doc-rec No-ERROR.
     3874   if not p-open-query and v-fltopend-rowid[1] <> ? then
     3875   query br-delivtypesubj:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     3876   run waitfram-hide in this-procedure.
     3877   APPLY "VALUE-CHANGED" TO br-delivtypesubj in frame Dialog-Frame.
     3878   APPLY "ENTRY" TO br-delivtypesubj.
     3879   END PROCEDURE.
     3880   PROCEDURE proc-br-delivtypesubj :
     3881   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3882   if b-sel:sensitive in frame Dialog-Frame then dO:
     3883       if b-mark:sensitive then do:
     3884           apply "choose" to b-mark in frame Dialog-Frame.
     3885       end.
     3886       else do:
     3887           apply "choose" to b-sel in frame Dialog-Frame.
     3888       end.
     3889   end.
     3890   else do:
     3891       if b-lkp:sensitive then
     3892       apply "choose" to b-lkp in frame Dialog-Frame.
     3893   end.
     3894   END PROCEDURE.
     3895   PROCEDURE proc-view-changes :
     3896   for each temp-changes:
     3897       delete temp-changes.
     3898   END.
     3899   if not available X_c-delivery-type-subject then do:
     3900     Open QUery br-changes for each temp-changes.
     3901     return.
     3902   end.
     3903   define variable v-label-param as character no-undo .
     3904   v-label-param =
     3905     "des" + chr(4) + "Описание" + chr(4) + "" + chr(8)
     3906    + "deliv-type-code" + chr(4) + "Внутр.код типа доставки" + chr(4) + "" + chr(8)
     3907    + "deliv-subj-code" + chr(4) + "Внутр.код субеъкта доставки" + chr(4) + "" + chr(8)
     3908    + "sts" + chr(4) + "Статус" + chr(4) + ""  .
     3909    run proc-full-temp-changes in this-procedure (
     3910                                                input  buffer X_c-delivery-type-subject:handle
     3911                                               ,input  'delivery-type-subject':U
     3912                                               ,input  "des,deliv-type-code,deliv-subj-code,sts"
     3913                                               ,input  v-label-param).
     3914   Open QUery br-changes for each temp-changes.
     3915   END PROCEDURE.
     3916   FUNCTION get-subject RETURNS CHARACTER
     3917     ( INPUT p-deliv-subj-code AS INTEGER) :
     3918   DEFINE BUFFER loc_delivery-subject FOR ub.delivery-subject.
     3919   FIND FIRST loc_delivery-subject NO-LOCK WHERE
     3920             loc_delivery-subject.deliv-subj-code = p-deliv-subj-code NO-ERROR.
     3921   IF AVAILABLE loc_delivery-subject THEN RETURN loc_delivery-subject.deliv-subj-name.
     3922     RETURN "Неизв.субъект доставки".
     3923   END FUNCTION.
     3924   FUNCTION get-type RETURNS CHARACTER
     3925   ( INPUT p-deliv-type-code AS INTEGER) :
     3926   DEFINE BUFFER loc_delivery-type FOR ub.delivery-type.
     3927   FIND FIRST loc_delivery-type NO-LOCK WHERE
     3928             loc_delivery-type.deliv-type-code = p-deliv-type-code NO-ERROR.
     3929   IF AVAILABLE loc_delivery-type THEN RETURN loc_delivery-type.deliv-type-name.
     3930     RETURN "Неизв.тип доставки".
     3931   END FUNCTION.
