     3095   PROCEDURE OpenBr :
     3096   define input  parameter p-open-query     as logical   no-undo .
     3097   define input  parameter p-find-next      as logical   no-undo .
     3098   define input  parameter p-find-condition as character no-undo .
     3099   define variable l-query-was-opened as logical no-undo .
     3100   define variable title0 as character no-undo.
     3101   title0 = "Список истории типов доставки от субъектов" + chr(32).
     3102   run waitfram-show in this-procedure ("Ждите...").
     3103   define variable sort-column-phrase as character no-undo .
     3104   case sort-column-name :
     3105     when "" then do:
     3106       assign
     3107         sort-column-phrase = ""
     3108       .
     3109     end.
     3110     otherwise do:
     3111       assign
     3112         sort-column-phrase = "by " + sort-column-name
     3113       .
     3114     end.
     3115   end case.
     3116   define variable l-open-query as logical   no-undo .
     3117     CASE p-mode :
     3118       WHEN 'все':U        THEN DO:
     3119        filter-point = filter-point0 + p-mode.
     3120   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3121   define variable  l-disable-where-27  as logical   no-undo .
     3122   define variable  l-filter-open-27    as logical   .
     3123   define variable  flt-rec-27       as recid     no-undo .
     3124   define variable  filter-name-27      as character no-undo .
     3125   define variable  where-phrase-27     as character no-undo .
     3126   define variable  sort-phrase-27      as character no-undo .
     3127   define variable  where-phrase-rus-27 as character no-undo .
     3128   define variable  sort-phrase-rus-27  as character no-undo .
     3129     run waitfram-show in this-procedure
     3130       (input "ЖДИТЕ ..."
     3131       ).
     3132   run gbl/flt-get.p
     3133     (input filter-point
     3134     ,output flt-rec-27
     3135     ,output filter-name-27
     3136     ,output where-phrase-27
     3137     ,output sort-phrase-27
     3138     ,output where-phrase-rus-27
     3139     ,output sort-phrase-rus-27
     3140     ).
     3141   if p-open-query then do:
     3142     assign
     3143       l-filter-open-27 = false
     3144     .
     3145     if flt-rec-27 <> ?
     3146       or sort-column-phrase > ""
     3147     then do:
     3148       define variable  parameter-2-27 as character no-undo .
     3149       define variable  parameter-3-27 as character no-undo .
     3150       define variable  parameter-4-27 as character no-undo .
     3151       define variable  parameter-5-27 as character no-undo .
     3152       define variable  parameter-6-27 as character no-undo .
     3153       define variable  parameter-7-27 as character no-undo .
     3154         assign
     3155         parameter-3-27 =
     3156                                 "FOR EACH X_c-delivery-type-subject"
     3157         parameter-4-27 =
     3158           (
     3159             if (" TRUE " + " " + where-phrase-27) <> ""
     3160             then " TRUE " + " " + where-phrase-27
     3161             else "true"
     3162           )
     3163         parameter-5-27 = (" " + "" + " " + "")
     3164         parameter-6-27 = if sort-phrase-27 = ''
     3165                              then
     3166           (
     3167           " " + "  " +
     3168             " " + sort-column-phrase +
     3169           " " + "  "
     3170           )
     3171                              else
     3172           (
     3173           " " + "  " +
     3174             " " + sort-column-phrase +
     3175           " " + sort-phrase-27
     3176           )
     3177         parameter-7-27 =
     3178           " indexed-reposition  "
     3179       .
     3180       do
     3181       on stop undo, leave
     3182       on error undo, leave
     3183       :
     3184         assign
     3185           l-disable-where-27 =
     3186             (" TRUE " + " " + where-phrase-27 = "")
     3187         .
     3188         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3189                             ,input QUERY br-delivtypesubj:handle
     3190                             ,input parameter-3-27
     3191                             ,input parameter-4-27
     3192                             ,input parameter-5-27
     3193                             ,input parameter-6-27
     3194                             ,input parameter-7-27
     3195                             )
     3196         .
     3197         assign
     3198           l-filter-open-27 = true
     3199         .
     3200       end.
     3201       if l-filter-open-27 = false then do:
     3202         message
     3203           "Ошибка при фильтрации / сортировке" skip
     3204           "Будут показаны записи без учета фильтра" skip
     3205           view-as alert-box .
     3206       end.
     3207       else do:
     3208           assign
     3209             l-query-was-opened = true
     3210           .
     3211       end.
     3212     end.
     3213     if l-filter-open-27 = false then do:
     3214       OPEN QUERY br-delivtypesubj FOR EACH X_c-delivery-type-subject
     3215         where  TRUE
     3216         indexed-reposition
     3217     .
     3218         assign
     3219           l-query-was-opened = true
     3220         .
     3221     end.
     3222   end.
     3223   else do:
     3224     assign
