     3075   temp-changes.l_name:resizable in browse br-changes = true
     3076   temp-changes.v_old:resizable in browse br-changes = true
     3077   temp-changes.v_new:resizable in browse br-changes = true
     3078   temp-changes.l_name:width in browse br-changes = 30
     3079   temp-changes.v_old:width in browse br-changes = 40
     3080   temp-changes.v_new:width in browse br-changes = 40
     3081   .
