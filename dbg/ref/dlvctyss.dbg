        1   DEFINE BUFFER X_c-delivery-type-subject FOR ub.c-delivery-type-subject.
        2   DEFINE BUFFER X_curr_clients FOR ub.clients.
        3   DEFINE BUFFER X_delivery-subject FOR ub.delivery-subject.
        4   DEFINE BUFFER X_delivery-type FOR ub.delivery-type.
        5   DEFINE BUFFER X_delivery-type-subject FOR ub.delivery-type-subject.
        6   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        7   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo.
        8   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo.
        9   define input parameter bttns  as char   no-undo .
       10   define input parameter p-mode  as char   no-undo .
       11   define input parameter p-deliv-type-code  LIKE ub.delivery-type.deliv-type-code   no-undo .
       12   define input parameter p-deliv-subj-code  LIKE ub.delivery-subject.deliv-subj-code   no-undo .
       13   define input-output param p-rid-list    as  char no-undo .
       14   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       15   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       16   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       17   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       18   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
       19   define variable vss-description AS CHAR NO-UNDO INIT "Список ИСТОРИИ ТИПОВ ДОСТАВКИ ОТ СУБЪЕКТОВ":U.
       20   procedure vss-get-info :
       21     define output parameter p-vss-revision    like vss-revision    no-undo .
       22     define output parameter p-vss-author      like vss-author      no-undo .
       23     define output parameter p-vss-date        like vss-date        no-undo .
       24     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       25     define output parameter p-vss-archive     like vss-archive     no-undo .
       26     define output parameter p-vss-description like vss-description no-undo .
       27     assign
       28       p-vss-revision    = vss-revision
       29       p-vss-author      = vss-author
       30       p-vss-date        = vss-date
       31       p-vss-workfile    = vss-workfile
       32       p-vss-archive     = vss-archive
       33       p-vss-description = vss-description
       34     .
       35   end procedure.
       36   procedure vss-get-parameters :
       37     define output parameter p-vss-parameters as character no-undo .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   define new global shared variable g#library  as handle no-undo .
       79   define new global shared variable g#library2 as handle no-undo .
       80   procedure proc-alt-shift-f2:
       81     if not ibs.th.gbl.gbl-var:rcode
       82   then
       83     run gbl\inidebug.p .
       84   end.
       85   procedure proc-alt-shift-f3:
       86     run gbl/prvssinf.p
       87       ( input this-procedure
       88       ) .
       89   end.
       90   define variable v-inform-launched as logical no-undo initial false .
       91   procedure proc-alt-shift-f4:
       92     define variable v-action as character no-undo .
       93     if v-inform-launched = false then do:
       94       assign
       95         v-inform-launched = true
       96       .
       97       run gbl/d-inform.w
       98         (  input self
       99         ,  input this-procedure
      100         , output v-action
      101         ) no-error .
      102       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      103       assign
      104         v-inform-launched = false
      105       .
      106     end.
      107   end.
      108   procedure proc-alt-f1:
      109     run gbl/corrhelp.p
      110       (input this-procedure
      111       ) .
      112   end .
      113   on alt-shift-f2 anywhere do:
      114     run proc-alt-shift-f2.
      115   end.
      116   on alt-shift-f3 anywhere do:
      117     run proc-alt-shift-f3 in this-procedure .
      118   end.
      119   on alt-shift-f4 anywhere do:
      120     run proc-alt-shift-f4 in this-procedure.
      121   end.
      122   on alt-f1 anywhere do:
      123     run proc-alt-f1 in this-procedure .
      124   end.
      125   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      126   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      127   define new shared variable RepPathName        as character no-undo .
      128   define new shared variable PrintRubl          as logical   no-undo .
      129   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      130   define variable v-waitfram-action01         as character   no-undo .
      131   define variable v-waitfram-action02         as character   no-undo .
      132   define variable v-waitfram-action03         as character   no-undo .
      133   define variable mWaitFramTextBeg            as character   no-undo.
      134   define variable mWaitFramTextEnd            as character   no-undo.
      135   define variable mWaitFramView               as logical     no-undo.
      136   define variable mWaitProcEvent              as logical     no-undo init yes.
      137   define variable mWaitFramInterval           as integer     no-undo init 1 .
      138   define variable mWaitFramStop               as logical     no-undo.
      139   define variable mWaitFramStopUser           as logical     no-undo.
      140   define variable mWaitFramStopTimeOut        as logical     no-undo.
      141   define variable mWaitFramStartProc          as datetime-tz no-undo.
      142   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      143   define button B-WaitFramStop auto-end-key
      144        label "Стоп"
      145        size 10 by 1 tooltip "Остоновить процесс".
      146   define button B-viewProcInfo
      147        label "Информация"
      148        size 15 by 1 tooltip "Информация о процесс".
      149   define frame waitfram
      150     v-waitfram-action01 format "x(72)" no-label skip
      151     v-waitfram-action02 format "x(72)" no-label skip
      152     v-waitfram-action03 format "x(72)" no-label skip
      153     B-viewProcInfo
      154     B-WaitFramStop at row 4 col 30
      155     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      156     .
      157   define new global shared variable mBatchMode as logical no-undo init ?.
      158   define variable mFramBachModHandle as handle no-undo.
      159   mFramBachModHandle = frame waitfram:handle.
      160   define variable mFameOldVis as logical no-undo.
      161   define variable mVisCUrentVin as logical no-undo.
      162   if session:batch-mode
      163   then
      164      mBatchMode = yes.
      165   if mBatchMode = ? then do:
      166     mVisCUrentVin = current-window:visible.
      167     mFameOldVis = mFramBachModHandle:visible.
      168     mFramBachModHandle:visible  = yes.
      169     mBatchMode = mFramBachModHandle:visible ne yes.
      170     mFramBachModHandle:visible = mFameOldVis.
      171     current-window:visible = mVisCUrentVin.
      172   end.
      173    if  log-manager:logfile-name ne ?
      174     then DO:
      175         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      176         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      177         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      178     end.
      179   on choose of B-WaitFramStop in frame waitfram
      180   do:
      181     mWaitFramStop = yes.
      182     mWaitFramStopUser = yes.
      183   end.
      184   function waitfram-check-timeout returns logical():
      185      define variable vtime as int64 no-undo.
      186      if mWaitFramStopTimeOut
      187      then
      188         return yes.
      189      vtime = ( now - mWaitFramStartProc ) / 1000 .
      190      if     mWaitFramTimeOut ne ?
      191         and mWaitFramTimeOut ne 0
      192         and mWaitFramTimeOut lt vtime
      193      then do:
      194         mWaitFramStopTimeOut = yes.
      195      end.
      196      return mWaitFramStopTimeOut.
      197   end.
      198   procedure waitfram-hide :
      199     if not session:batch-mode
      200     then do
      201     on error undo, return error return-value
      202     :
      203       pause 0 before-hide .
      204       if not mBatchMode then
      205         hide frame waitfram .
      206     if     not mWaitFramView
      207        and mWaitProcEvent
      208     then
      209       process events .
      210     end.
      211   end procedure.
      212   procedure waitfram-show :
      213     define input  parameter p-message as character no-undo .
      214     define variable v-left-margin as integer   no-undo .
      215     if not session:batch-mode
      216     then do
      217     on error undo, return error return-value
      218     :
      219       if length(p-message) <= 70 then do:
      220         assign
      221           v-left-margin = integer((70 - length(p-message)) / 2)
      222         .
      223         assign
      224           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      225         .
      226         assign
      227           v-waitfram-action01 = " "
      228           v-waitfram-action02 = " "
      229                                    + fill(" ", v-left-margin)
      230                                    + p-message
      231           v-waitfram-action03 = " "
      232         .
      233       end.
      234       else do:
      235         define variable vRindex1 as integer no-undo.
      236         define variable vRindex2 as integer no-undo.
      237         vRindex1 = r-index(p-message," ",70).
      238         if vRindex1 = 0
      239         then
      240            vRindex1 = 70.
      241         if length(p-message)  <= vRindex1 + 70 then do:
      242           assign
      243             v-waitfram-action01 = " "
      244             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      245             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      246           .
      247         end.
      248         else do:
      249           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      250           if vRindex2 <= vRindex1
      251           then
      252              vRindex2 = vRindex1 + 70.
      253           assign
      254             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      255             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      256             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      257           .
      258         end.
      259       end.
      260       B-viewProcInfo:visible   in frame waitfram = no.
      261       B-viewProcInfo:sensitive in frame waitfram = no.
      262       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      263       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      264       if  (   mWaitFramView
      265          or  mWaitProcEvent)
      266          and not mBatchMode
      267       then
      268          display
      269             v-waitfram-action01 skip
      270             v-waitfram-action02 skip
      271             v-waitfram-action03 skip
      272          with frame waitfram .
      273       if     mWaitFramView
      274          then do:
      275             if     mWaitFramInterval ne ?
      276                and not mBatchMode
      277             then
      278                wait-for go of frame waitfram pause mWaitFramInterval.
      279          end.
      280          else
      281             if     mWaitProcEvent
      282                and not mBatchMode
      283             then
      284                process events .
      285     end.
      286   end procedure.
      287      procedure waitfram-show-this:
      288         define input  parameter iInterval as int64 no-undo.
      289         define variable vtime as int64 no-undo.
      290         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      291         mWaitFramInterval = iInterval.
      292         run waitfram-show (substitute("&1&2 &3&4" ,
      293                                       mWaitFramTextBeg ,
      294                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      295                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      296                                       mWaitFramTextEnd
      297                                      )
      298                           ).
      299      end.
      300      procedure WaitFramRunPause:
      301         define input  parameter iInterval as dec no-undo.
      302         define variable vStart  as datetime-tz no-undo.
      303         define variable vend    as datetime-tz no-undo.
      304         define variable vint as int64 no-undo.
      305         define variable vOk as logical no-undo.
      306         vStart = now.
      307         vend   = vStart.
      308         publish "WaitFramPause" (iInterval,output vOk).
      309         vend   =  now.
      310         vint = vend - vStart.
      311         vint = iInterval - vint / 1000.
      312         if     not mWaitFramStop
      313            and (   vint > 0
      314                 or (    not vOk
      315                     and iInterval eq ?
      316                     )
      317                 )
      318         then
      319            run waitfram-show-this (iInterval).
      320         vend   =  now.
      321         vint = vend - vStart.
      322         vint = iInterval - vint / 1000.
      323         if     not mWaitFramStop
      324            and vint > 0
      325         then do:
      326            run gbl/pause.p (vint * 1000).
      327         end.
      328         if iInterval ne ?
      329         then
      330            publish "WaitFramStop".
      331         waitfram-check-timeout().
      332      end.
      333      procedure WaitFramWaitFor:
      334         define input  parameter iInterval as dec no-undo.
      335         assign
      336            mWaitFramStartProc   = now
      337            mWaitFramStopUser    = no
      338            mWaitFramStopTimeOut = no
      339         .
      340         block-wait:
      341         do while not mWaitFramStop:
      342            run WaitFramRunPause (iInterval).
      343            if  waitfram-check-timeout()
      344            then do:
      345               leave block-wait.
      346            end.
      347         end.
      348         run waitfram-hide.
      349      end.
      350   procedure waitfram-join :
      351     define input  parameter p-line-1  as character no-undo .
      352     define input  parameter p-line-2  as character no-undo .
      353     define input  parameter p-line-3  as character no-undo .
      354     define output parameter p-message as character no-undo .
      355     do
      356     on error undo, return error return-value
      357     :
      358       assign
      359         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      360                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      361                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      362       .
      363     end.
      364   end procedure.
      365   function waitfram-join-function returns character
      366     (input p-line-1 as character
      367     ,input p-line-2 as character
      368     ,input p-line-3 as character
      369     ).
      370     define variable v-message as character no-undo .
      371     run waitfram-join in this-procedure
      372       (input  p-line-1
      373       ,input  p-line-2
      374       ,input  p-line-3
      375       ,output v-message
      376       ) .
      377     return v-message .
      378   end function .
      379   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      380   define  stream PrnLibStream.
      381   procedure prn-lib-prn-file :
      382     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      383     define input parameter p-DIsabledoptions as integer no-undo .
      384     define variable v-report-name as character no-undo .
      385     define variable v-user-action as character no-undo .
      386     define variable v-printed     as logical   no-undo .
      387     define variable v-exist       as logical   no-undo .
      388     do
      389       on error undo, return error
      390       :
      391       run prn-lib-get-report-name  in this-procedure (
      392         input parParentProc
      393         ,output v-report-name
      394         ).
      395   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      396   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      397     (input  v-report-name
      398     ,input  2
      399     ,output v-exist
      400     )  .
      401       if NOT v-exist then
      402       DO:
      403         Message
      404           "Нет заданий на печать ! "
      405           view-as alert-box .
      406         Return  .
      407       End.
      408       run gbl/prnfilen.w
      409         (input  ""
      410         ,input  p-DisabledOptions
      411         ,input  string(v-report-name )
      412         ,input  7
      413         ,output v-user-action
      414         ,output v-printed
      415         ) .
      416       if v-printed then
      417       do:
      418         return "YES" .
      419       end.
      420       else
      421       do:
      422         return "NO" .
      423       end.
      424     end.
      425   end procedure.
      426   procedure prn-lib-open-stream :
      427     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      428     define input parameter p-page-size    as integer no-undo .
      429     define input parameter p-is-stream    as logical no-undo .
      430     define input parameter p-append       as logical no-undo .
      431     define variable v-report-name as character no-undo .
      432     do
      433       on error undo, return error
      434       :
      435       run prn-lib-get-report-name  in this-procedure (
      436         input parParentProc
      437         ,output v-report-name
      438         ).
      439       if p-is-stream then
      440       do:
      441         if p-append then
      442         do:
      443           output stream PrnLibStream to value( v-report-name )
      444             page-size value(p-page-size) append .
      445         end.
      446         if not p-append then
      447         do:
      448           output stream PrnLibStream to value( v-report-name )
      449             page-size value(p-page-size) .
      450         end.
      451       end.
      452       if not p-is-stream then
      453       do:
      454         if p-append then
      455         do:
      456           output to value( v-report-name )
      457             page-size value(p-page-size) append .
      458         end.
      459         if not p-append then
      460         do:
      461           output to value( v-report-name )
      462             page-size value(p-page-size) .
      463         end.
      464       end.
      465     end.
      466   end procedure.
      467   procedure prn-lib-open-exp :
      468     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      469     define input parameter p-is-stream    as logical no-undo .
      470     define input parameter p-is-append    as logical no-undo .
      471     define output parameter p-ReportFileName as char init "report" no-undo.
      472     define output parameter p-process as logical no-undo .
      473     define variable glog as logical no-undo .
      474     do
      475       on error undo, return error
      476       :
      477       SYSTEM-DIALOG GET-FILE p-ReportFileName
      478         TITLE      "Укажите путь"
      479         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      480         ASK-OVERWRITE
      481         CREATE-TEST-FILE
      482         SAVE-AS
      483         USE-FILENAME
      484         DEFAULT-EXTENSION "txt"
      485         UPDATE glog
      486         .
      487       if not glog then  return.
      488       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      489       if p-is-stream then
      490       do:
      491         if p-is-append then
      492         do:
      493           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      494         end.
      495         else
      496         do:
      497           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      498         end.
      499       end.
      500       else
      501       do:
      502         if p-is-append then
      503         do:
      504           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      505         end.
      506         else
      507         do:
      508           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      509         end.
      510       end.
      511       p-process = yes.
      512     end.
      513   end procedure.
      514   procedure prn-lib-get-report-name :
      515     define input parameter parParentProc  as widget-handle no-undo.
      516     define output parameter p-report-name as character no-undo .
      517     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      518   end procedure.
      519   procedure prn-lib-reportviewer-report-name :
      520     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      521     define input parameter p-report-name-html as character no-undo .
      522     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      523   end procedure.
      524   procedure prn-lib-reportviewer :
      525     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      526     define input parameter p-report-name-html as character no-undo .
      527     define input parameter p-param        as character no-undo .
      528     define variable v-excel           as character no-undo init 'TRUE' .
      529     define variable v-value-character as character no-undo .
      530     define variable v-value-integer   as character no-undo .
      531     define variable v-value-date      as date      no-undo .
      532     define variable v-value-decimal   as decimal   no-undo .
      533     define variable rep-excel         as logical   no-undo .
      534     define variable excel-string      as character no-undo .
      535     define variable v-param-type      as character no-undo .
      536     define variable v-tth             as handle    no-undo .
      537     run adm/shattri.p (
      538       input "get":U
      539       ,input  ""
      540       ,input  0
      541       ,input  'report-glob':U
      542       ,input  'rep-excel':U
      543       ,output v-value-character
      544       ,output v-value-date
      545       ,output v-value-decimal
      546       ,output v-value-integer
      547       ,output rep-excel
      548       ,output v-param-type
      549       ,INPUT-OUTPUT table-handle v-tth
      550       )  .
      551     if rep-excel then v-excel = "TRUE" .
      552     else v-excel = "FALSE" .
      553     if p-param eq ""
      554     then
      555        p-param = "EXCEL:" + v-excel.
      556     else
      557        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      558     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      559   end procedure.
      560   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      561   procedure cur-time :
      562      define output parameter p-today as date      no-undo .
      563      define output parameter p-time  as integer   no-undo .
      564     do
      565     on error undo, return error
      566     :
      567       define variable v-date1 as date      no-undo .
      568       define variable v-date2 as date      no-undo .
      569       define variable v-time  as integer   no-undo .
      570       assign
      571         v-date1 = today
      572         v-time  = time
      573         v-date2 = today
      574       .
      575       if v-date1 <> v-date2
      576       then do:
      577         assign
      578           v-date1 = today
      579           v-time  = v-time
      580         .
      581       end.
      582       assign
      583         p-today = v-date1
      584         p-time  = v-time
      585       .
      586     end.
      587   end.
      588   function cur-time-date returns character
      589   :
      590     return string(today, '99/99/9999':U) .
      591   end.
      592   function cur-time-mjd returns decimal
      593   :
      594     define variable v-date as date      no-undo .
      595     define variable v-time as integer   no-undo .
      596     run cur-time in this-procedure
      597       (output v-date
      598       ,output v-time
      599       ) .
      600     return integer(v-date) - 2400002 + (v-time / 86400) .
      601   end.
      602   function cur-time-get-ending-index returns integer
      603   (input p-number as integer
      604   )
      605   :
      606     if p-number < 0
      607     or p-number = ?
      608     then do:
      609       return 1 .
      610     end.
      611     define variable v-rest as integer   no-undo .
      612     assign
      613       p-number = p-number modulo 100
      614     .
      615     if p-number < 20
      616     then do:
      617       assign
      618         v-rest = p-number
      619       .
      620     end.
      621     else do:
      622       assign
      623         v-rest = p-number modulo 10
      624       .
      625     end.
      626     case v-rest :
      627       when 1
      628       then do:
      629         return 2 .
      630       end.
      631       when 2 or
      632       when 3 or
      633       when 4
      634       then do:
      635         return 3 .
      636       end.
      637       otherwise do:
      638         return 1 .
      639       end.
      640     end case .
      641   end.
      642   procedure cur-time-mjd-to-date :
      643      define input  parameter i-mjd-diff as decimal no-undo.
      644      define output parameter o-Date     as date    no-undo.
      645      define output parameter o-Time     as integer no-undo.
      646      define variable v-day-number as integer   no-undo .
      647      if    i-mjd-diff < 0
      648         or i-mjd-diff = ?
      649      then do:
      650         return "?" .
      651      end.
      652      assign
      653         v-day-number = truncate(i-mjd-diff,0).
      654         o-Date = date(v-day-number + 2400002).
      655         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      656     .
      657   end.
      658   function cur-time-mjd-to-string returns character
      659   (input p-mjd-diff as decimal
      660   )
      661   :
      662     define variable v-day-number as integer   no-undo .
      663     define variable v-seconds    as integer   no-undo .
      664     define variable v-hour       as integer   no-undo .
      665     define variable v-min        as integer   no-undo .
      666     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      667     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      668     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      669     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      670     if p-mjd-diff < 0
      671     or p-mjd-diff = ?
      672     then do:
      673       return "?" .
      674     end.
      675     assign
      676       v-day-number = integer(truncate(p-mjd-diff,0))
      677       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      678     .
      679     if v-seconds > 86400
      680     then do:
      681       assign
      682         v-seconds = 86400 - 1
      683       .
      684     end.
      685     if v-seconds < 0
      686     then do:
      687       assign
      688         v-seconds = 0
      689       .
      690     end.
      691     assign
      692       v-hour = truncate(v-seconds / 3600, 0)
      693     .
      694     assign
      695       v-seconds = v-seconds modulo 3600
      696     .
      697     assign
      698       v-min = truncate(v-seconds / 60, 0)
      699     .
      700     assign
      701       v-seconds = v-seconds modulo 60
      702     .
      703     return
      704         (if v-day-number <> 0
      705           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      706           else ""
      707         )
      708       + (if v-day-number <> 0 or v-hour <> 0
      709           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      710           else ""
      711         )
      712       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      713           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      714           else ""
      715         )
      716       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      717       .
      718   end.
      719   function cur-time-string returns character
      720   :
      721     define variable v-date as date      no-undo .
      722     define variable v-time as integer   no-undo .
      723     run cur-time in this-procedure
      724       (output v-date
      725       ,output v-time
      726       ) .
      727     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      728   end.
      729   function cur-time-string-sec returns character
      730   :
      731     define variable v-date as date      no-undo .
      732     define variable v-time as integer   no-undo .
      733     run cur-time in this-procedure
      734       (output v-date
      735       ,output v-time
      736       ) .
      737     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      738   end.
      739   function cur-time-custom  returns character
      740   (input p-prefix as character
      741   ,input p-date-format as character
      742   ,input p-delimiter as character
      743   ,input p-time-format as character
      744   ,input p-suffix as character
      745   )
      746   :
      747     define variable v-date as date      no-undo .
      748     define variable v-time as integer   no-undo .
      749     run cur-time in this-procedure
      750       (output v-date
      751       ,output v-time
      752       ) .
      753     return
      754       p-prefix
      755       + string(v-date, p-date-format)
      756       + p-delimiter
      757       + string(v-time, p-time-format)
      758       + p-suffix
      759       .
      760   end.
      761   function cur-time-print  returns character
      762   :
      763     define variable v-date as date      no-undo .
      764     define variable v-time as integer   no-undo .
      765     run cur-time in this-procedure
      766       (output v-date
      767       ,output v-time
      768       ) .
      769     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      770   end.
      771   function cur-time-datetime returns datetime
      772   :
      773     define variable v-char as character no-undo .
      774     define variable v-datetime as datetime no-undo .
      775     v-char = cur-time-string().
      776     v-datetime = datetime(v-char).
      777     return  v-datetime.
      778   end.
      779   function cur-time-string-msec returns character
      780   :
      781     define variable v-date as datetime  no-undo .
      782     v-date = now.
      783     return string(v-date) .
      784   end.
