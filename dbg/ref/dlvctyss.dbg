      837   FUNCTION mark-string RETURNS CHARACTER
      838     ( input p-recid as recid, input mark-list as character  ) :
      839     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      840   END FUNCTION.
