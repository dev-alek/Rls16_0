     2453     :
     2454       if query br-c-stop-list:handle:get-buffer-handle(1) = (buffer X_c-stop-list:handle) then do:
     2455         assign
     2456         parameter-2-25 = (if p-find-next then "true":u else "false":u )
     2457         parameter-4-25 =
     2458           "where ":u +  substitute('X_c-stop-list.classif-type = &1&2&1                          and X_c-stop-list.stop-list-code = &1&3&1 ', chr(34), 'dis-card':U, p-stop-list-code)  + " ":u + where-phrase-25 + " ":u + p-find-condition + " " + ""
     2459         parameter-5-25 = "  "
