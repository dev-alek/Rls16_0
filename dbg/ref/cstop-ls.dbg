      391   procedure fltfield-clear :
      392     define output parameter loc-fld as character no-undo.
      393     define output parameter loc-lab as character no-undo .
      394     define output parameter loc-spr as character no-undo .
      395     define output parameter loc-dim as character no-undo .
      396     assign
      397       loc-fld = ""
      398       loc-lab = ""
      399       loc-spr = ""
      400       loc-dim = "0"
      401     .
      402   end procedure .
      403   procedure fltfield-add :
      404     define input        parameter par-fld as character no-undo.
      405     define input        parameter par-lab as character no-undo .
      406     define input        parameter par-spr as character no-undo .
      407     define input-output parameter loc-fld as character no-undo.
      408     define input-output parameter loc-lab as character no-undo .
      409     define input-output parameter loc-spr as character no-undo .
      410     define input-output parameter loc-dim as character no-undo .
      411     do
      412     on error undo, return error
      413     :
      414       assign
      415       loc-fld = if loc-dim = '0'
      416                 then par-fld
      417                 else (loc-fld + chr(44) + par-fld)
      418       loc-lab = if loc-dim = '0'
      419                 then par-lab
      420                 else (loc-lab + chr(44) + par-lab)
      421       loc-spr = if loc-dim = '0'
      422                 then par-spr
      423                 else (loc-spr + chr(44) + par-spr)
      424       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      425                 string(integer(if num-entries(loc-dim) > 1
      426                               then entry(2, loc-dim)
      427                               else entry(1, loc-dim)
      428                               ) + 1)
      429       no-error
      430       .
      431     end.
      432   end procedure.
      433   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      434   function usrfulnf returns character ( input p-user-id as character):
      435   define variable v-user-name as character no-undo .
      436   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      437   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      438     (input  p-user-id
      439     ,output v-user-name
      440     ) no-error .
      441   if error-status:error
      442   or v-user-name = ""
      443   then do:
      444     return p-user-id.
      445   end.
      446   else do:
      447     return v-user-name.
      448   end.
      449   end function.
      450   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      451   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      452   procedure fltopend_fltopend :
      453   define input parameter p-parent-handle as handle no-undo .
      454   define input parameter p-qh as handle no-undo .
      455   define input parameter p-flt-open-open-query  as character no-undo .
      456   define input parameter p-where-cond as character no-undo .
      457   define input parameter p-use-indFIRST-query-tail as character no-undo .
      458   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      459   define input parameter p-indexed-reposition as character no-undo .
      460     do
      461     on error undo, return error
      462     :
      463   define variable v-prepare-string as character no-undo .
      464   define variable glog as logical no-undo .
      465   assign
      466   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      467                      p-where-cond + chr(32)  +
      468                      p-use-indFIRST-query-tail + chr(32) +
      469                      p-use-ind-sort-clmn-by + chr(32) +
      470                      p-indexed-reposition
      471   .
      472   assign
      473   glog = p-qh:query-prepare(v-prepare-string) no-error .
      474   if not glog
      475   or error-status:error then do:
      476     message error-status:get-message(1) view-as alert-box .
      477     undo, return error .
      478   end.
      479   assign
      480   glog = p-qh:query-open no-error .
      481   if not glog
      482   or error-status:error then do:
      483     message error-status:get-message(1) view-as alert-box .
      484     undo, return error .
      485   end.
      486     end.
      487   end procedure.
      488   procedure fltopend_fltfindd :
      489   define input parameter p-parent-handle as handle no-undo .
      490   define input parameter p-qh as handle no-undo .
      491   define input parameter p-rowid as rowid no-undo .
      492   define input parameter p-next as logical no-undo .
      493   define input parameter p-lock as integer no-undo .
      494   define input parameter p-bh as handle no-undo .
      495   define input parameter p-where-cond as character no-undo .
      496   define input parameter p-use-index-phrase as character no-undo .
      497   define variable glog as logical no-undo .
      498   define variable v-qh as handle no-undo .
      499   define variable v-bh as handle no-undo .
      500   define variable v-recid as recid no-undo .
      501   define variable v-prepare-string as character no-undo .
      502   do
      503   on error undo, return error
      504   on stop undo, return error
      505   :
      506     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      507     create buffer v-bh for table p-bh buffer-name p-bh:name.
      508     create query v-qh.
      509     v-qh:set-buffers(v-bh).
      510     v-prepare-string = substitute("for each &1 &2 &3"
      511                                     ,v-bh:name
      512                                     ,p-where-cond
      513                                     ,p-use-index-phrase).
      514     glog = v-qh:query-prepare(v-prepare-string) no-error.
      515     if not glog then do:
      516       delete object v-qh.
      517       delete object v-bh.
      518       undo, return error .
      519     end.
      520     glog = v-qh:query-open no-error .
      521     if not glog then do:
      522       delete object v-qh.
      523       delete object v-bh.
      524       undo, return error .
      525     end.
      526     if p-next then do:
      527       v-qh:reposition-to-rowid(p-rowid) no-error .
      528       glog = v-qh:get-next( p-lock) no-error .
      529       glog = v-qh:get-next( p-lock) no-error .
      530       if not glog or v-qh:query-off-end = yes then do:
      531         glog = v-qh:get-first( p-lock) no-error .
      532       end.
      533     end.
      534     else do:
      535       glog = v-qh:get-first( p-lock) no-error .
      536     end.
      537     v-recid = v-bh:recid no-error .
      538     delete object v-qh.
      539     delete object v-bh.
      540     return string(v-recid) .
      541   end.
      542   end procedure.
      543   procedure fltopend_fltfindq :
      544   define input parameter p-parent-handle as handle no-undo .
      545   define input parameter p-qh as handle no-undo .
      546   define input parameter p-next as logical no-undo .
      547   define input parameter p-lock as integer no-undo .
      548   define input parameter p-flt-open-open-query  as character no-undo .
      549   define input parameter p-where-cond as character no-undo .
      550   define input parameter p-use-indFIRST-query-tail as character no-undo .
      551   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      552   define input parameter p-indexed-reposition as character no-undo .
      553   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      554   define variable glog as logical no-undo .
      555   define variable v-qh as handle no-undo .
      556   define variable v-bh as handle no-undo extent 18.
      557   define variable v-rowid as rowid no-undo extent 18.
      558   define variable v-ii as integer no-undo .
      559   define variable v-prepare-string as character no-undo .
      560   do
      561   on error undo, return error
      562   on stop undo, return error
      563   :
      564     create query v-qh.
      565     do v-ii = 1 to p-qh:num-buffers:
      566       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      567       assign
      568       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      569       no-error.
      570       v-qh:add-buffer(v-bh[v-ii]).
      571     end.
      572     assign
      573     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      574                       p-where-cond + chr(32)  +
      575                       p-use-indFIRST-query-tail + chr(32) +
      576                       p-use-ind-sort-clmn-by + chr(32) +
      577                       p-indexed-reposition
      578     .
      579     glog = v-qh:query-prepare( v-prepare-string) no-error .
      580     if not glog then do:
      581       delete object v-qh.
      582       do v-ii = 1 to p-qh:num-buffers:
      583         delete object v-bh[v-ii].
      584       end.
      585       undo, return error .
      586     end.
      587     glog = v-qh:query-open no-error .
      588     if not glog then do:
      589       delete object v-qh.
      590       do v-ii = 1 to p-qh:num-buffers:
      591         delete object v-bh[v-ii].
      592       end.
      593       undo, return error .
      594     end.
      595     if p-next then do:
      596       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      597       glog = v-qh:get-next( p-lock) no-error .
      598       glog = v-qh:get-next( p-lock) no-error .
      599       if not glog or v-qh:query-off-end = yes then do:
      600         glog = v-qh:get-first( p-lock) no-error .
      601       end.
      602     end.
      603     else do:
      604       glog = v-qh:get-first( p-lock) no-error .
      605     end.
      606     do v-ii = 1 to p-qh:num-buffers:
      607       assign
      608       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      609       no-error.
      610     end.
      611     delete object v-qh.
      612     do v-ii = 1 to p-qh:num-buffers:
      613       delete object v-bh[v-ii].
      614     end.
      615   end.
      616   end procedure.
      617   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      618   define variable v-doc-rec as recid no-undo .
      619   define variable filter-label as character no-undo .
      620   define variable filter-label0 as character no-undo init "История Стоплистов" .
      621   define variable filter-point as character no-undo .
      622   define variable filter-point0 as character no-undo init "сstop-ls" .
      623   DEFINE VARIABLE sort-column-name as character no-undo .
      624   DEFINE BUTTON B-Help
      625        LABEL "Помо&щь"
      626        SIZE 3 BY 1
      627        BGCOLOR 8 .
      628   DEFINE BUTTON b-lkp
      629        LABEL "&Просмотр"
      630        SIZE 10 BY 1.
      631   DEFINE BUTTON B-mark
      632        LABEL "&*"
      633        SIZE 3 BY 1.
      634   DEFINE BUTTON b-quit AUTO-END-KEY
      635        LABEL "&Выход"
      636        SIZE 10 BY 1
      637        BGCOLOR 8 .
      638   DEFINE BUTTON b-sch
      639        LABEL "Фильтр"
      640        SIZE 3 BY 1.
      641   DEFINE BUTTON B-sel AUTO-GO
      642        LABEL "Вы&бор"
      643        SIZE 10 BY 1.
      644   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
      645         VIEW-AS TEXT
      646        SIZE 6 BY 1
      647        FGCOLOR 4  NO-UNDO.
      648   DEFINE QUERY BR-c-stop-list FOR
      649         X_c-stop-list SCROLLING.
      650   DEFINE BROWSE BR-c-stop-list
      651     QUERY BR-c-stop-list NO-LOCK DISPLAY
      652         mark-string(recid(X_c-stop-list), v-rid-list) COLUMN-LABEL "*" FORMAT "X(2)"
      653   X_c-stop-list.stop-list-code COLUMN-LABEL "№ стоплиста" FORMAT "X(9)"
      654   X_c-stop-list.doc-date  COLUMN-LABEL "Дата стоплиста" FORMAT "99/99/9999"
      655   usrfulnf(X_c-stop-list.corr-user-name)  COLUMN-LABEL "Изменил" FORMAT "X(20)"
      656   X_c-stop-list.corr-user-db-num  COLUMN-LABEL "БД изм." FORMAT ">>>>9"
      657   X_c-stop-list.corr-date  COLUMN-LABEL "Дата корр." FORMAT "99/99/9999"
      658   string(X_c-stop-list.corr-time)  COLUMN-LABEL "Время корр." FORMAT "HH:MM:SS"
      659       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.88 BY 19 FIT-LAST-COLUMN.
      660   DEFINE FRAME Dialog-Frame
      661        b-quit AT ROW 1 COL 1
      662        B-mark AT ROW 1 COL 11
      663        B-sel AT ROW 1 COL 21
      664        b-lkp AT ROW 1 COL 61
      665        b-sch AT ROW 1 COL 92
      666        B-Help AT ROW 1 COL 95
      667        BR-c-stop-list AT ROW 3 COL 1
      668        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
      669        SPACE(79.40) SKIP(20.47)
      670       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      671            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      672            TITLE "История стоплистов по ДК"
      673            CANCEL-BUTTON b-quit.
      674   ASSIGN
      675          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      676          FRAME Dialog-Frame:HIDDEN           = TRUE.
      677   ON GO OF FRAME Dialog-Frame
      678   DO:
      679     p-rid-list = v-rid-list.
      680   END.
      681   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      682   DO:
      683     APPLY "END-ERROR":U TO SELF.
      684   END.
      685   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
      686   DO:
      687     run proc-b-lkp IN THIS-PROCEDURE NO-ERROR.
      688     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      689   END.
      690   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
      691   DO:
      692     define variable loc#log as logical no-undo .
      693     if available X_c-stop-list then do:
      694   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      695   define variable v-str-recid10 as character no-undo .
      696   define variable v-num-entry10 as integer   no-undo .
      697   assign
      698     v-str-recid10 = trim( string( recid( X_c-stop-list ) , "->>>>>>>>>>>9":U ) )
      699     v-num-entry10 = lookup( v-str-recid10 , v-rid-list )
      700   .
      701   if v-num-entry10 > 0 then do:
      702     assign
      703       entry( v-num-entry10, v-rid-list ) = "":U
      704       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      705     .
      706   end.
      707   else do:
      708     assign
      709       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid10
      710     .
      711   end.
      712       loc#log = br-c-stop-list:refresh() .
      713       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      714           loc#log = br-c-stop-list:select-next-row ().
      715           apply "VALUE-CHANGED" to br-c-stop-list in frame Dialog-Frame.
      716       end.
      717       if num-entries( v-rid-list ) = 0
      718       then
      719           hide mark-num in frame Dialog-Frame.
      720       else
      721           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
      722     end.
      723     apply "entry" to br-c-stop-list in frame Dialog-Frame.
      724   END.
      725   ON CHOOSE OF b-sch IN FRAME Dialog-Frame
      726   DO:
      727     run proc-b-sch IN THIS-PROCEDURE NO-ERROR.
      728     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      729   END.
      730   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
      731   DO:
      732       if ( available X_c-stop-list ) then do:
      733       if  ( v-rid-list = "" ) or b-mark:sensitive = no
      734       then
      735       v-rid-list = string( recid( X_c-stop-list ) ) .
      736     end.
      737   END.
      738   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      739   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      740   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      741   on help of frame Dialog-Frame
      742   do:
      743     run gbl/app_help.p
      744       (input this-procedure :file-name
      745       ,input ''
      746       ,input ?
      747       ) no-error.
      748     if error-status :error then do:
      749       message
      750         "Ошибка при вызове помощи"
      751         error-status :get-message(1)
      752         view-as alert-box .
      753     end.
      754   end.
      755   run minbtn-set in this-procedure .
      756   on choose of b-help in frame Dialog-Frame
      757   do:
      758     apply "help":u to frame Dialog-Frame .
      759   end.
      760   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      761   procedure minbtn-set :
      762       do
      763           on error undo, return error return-value
      764           :
      765           define variable ii              as integer       no-undo .
      766           define variable fh              as widget-handle no-undo .
      767           define variable hh              as widget-handle no-undo .
      768           define variable v-h             as handle        extent 4 no-undo .
      769           define variable v-name-button   as character     no-undo .
      770           define variable v-help-old-x    as decimal       no-undo .
      771           define variable v-help-old-y    as decimal       no-undo .
      772           define variable v-help-old-size as decimal       no-undo .
      773           define variable v-frame-width   as decimal       no-undo .
      774           define variable jj              as integer       no-undo .
      775           do
      776               on error undo, return error
      777               :
      778               assign
      779                   v-frame-width = frame Dialog-Frame:width - 0.3
      780                   fh            = frame Dialog-Frame:first-child
      781                   hh            = fh:first-child
      782                   ii            = 1
      783                   .
      784               do while valid-handle(hh):
      785                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      786                   do:
      787                       case lc(hh:name) :
      788                           when "b-help" then
      789                               do:
      790                                   hh:load-image-up("cmp/b-help.bmp":u) .
      791                                   hh:load-image-down("cmp/b-help.bmp":u) .
      792                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      793                                   hh:TOOLTIP = "Помощь" .
      794                                   v-help-old-x = hh:column .
      795                                   v-help-old-y = hh:row    .
      796                                   v-help-old-size = hh:width .
      797                                   hh:width-chars = 2.5 .
      798                               end.
      799                           when "b-print" then
      800                               do:
      801                                   hh:load-image("cmp/b-print.bmp":u) .
      802                                   hh:TOOLTIP = "Печать" .
      803                                   v-h[ii] = hh:handle .
      804                                   ii = ii + 1 .
      805                                   hh:width-chars = 3 .
      806                               end.
      807                           when "b-history" or
      808                           when "b-hist" then
      809                               do:
      810                                   hh:load-image("cmp/b-hist.bmp":u) .
      811                                   hh:TOOLTIP = "История" .
      812                                   v-h[ii] = hh:handle .
      813                                   ii = ii + 1 .
      814                                   hh:width-chars = 3 .
      815                               end.
      816                           when "b-sch" then
      817                               do:
      818                                   hh:load-image("cmp/b-sch.bmp":u) .
      819                                   hh:TOOLTIP = "Установка Фильтра" .
      820                                   v-h[ii] = hh:handle .
      821                                   ii = ii + 1 .
      822                                   hh:width-chars = 3 .
      823                               end.
      824                           when "b-hist-user" then
      825                               do:
      826                                   hh:load-image("cmp/b-hist.bmp":u) .
      827                                   hh:TOOLTIP = "История пользователя" .
      828                                   ii = ii + 1 .
      829                               end.
      830                       end case.
      831                   end.
      832                   hh = hh:next-sibling.
      833               end.
      834               b-help:column = v-frame-width - b-help:width-chars.
      835               jj = 0.
      836               repeat ii = 4 to 1 by -1 :
      837                   if valid-handle (v-h[ii] ) then
      838                   do:
      839                       jj  = jj + 1 .
      840                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      841                       v-h[ii]:row    = v-help-old-y .
      842                   end.
      843               end.
      844           end.
      845       end.
      846   end procedure.
      847   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      848   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      849   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      850   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      851   define variable v-diasize-current-frame-width  as decimal   no-undo .
      852   define variable v-diasize-current-frame-height as decimal   no-undo .
      853   define variable v-diasize-change-size          as logical   no-undo .
      854   define variable v-diasize-resize-button        as handle    no-undo .
      855   define variable v-diasize-wndmax               as logical   no-undo .
      856   define variable v-diasize-wndstore             as logical   no-undo .
      857   define variable v-diasize-proc-name            as character no-undo .
      858   define variable v-diasize-browse-handle        as handle    no-undo .
      859   define variable v-diasize-browse-number        as integer   no-undo .
      860   define variable v-diasize-need-full-display    as logical   no-undo init false .
      861   define temp-table temp-diasize-handle no-undo
      862     field handle-value  as handle
      863     field save-position as decimal
      864     index xpk is primary unique handle-value
      865     .
      866   define temp-table temp-browse-handle no-undo
      867     field browse-type   as character
      868     field browse-number as integer
      869     field browse-handle as handle
      870     field original-size as decimal
      871     index xpk is primary unique browse-type browse-number
      872     index xie browse-type browse-handle
      873   .
      874   procedure diasize_change-height :
      875     define input  parameter p-change-value  as decimal   no-undo .
      876     define input  parameter p-move-resize   as logical   no-undo .
      877     define variable v-field-group-handle    as handle    no-undo .
      878     define variable v-object-handle         as handle    no-undo .
      879     define variable v-frame-height          as decimal   no-undo .
      880     define variable v-frame-virtual-height  as decimal   no-undo .
      881     define variable v-browse-height         as decimal   no-undo .
      882     define variable v-window-height         as decimal   no-undo .
      883     define variable v-window-virtual-height as decimal   no-undo .
      884     define variable v-change-sign           as integer   no-undo .
      885     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      886     define buffer buf_temp-browse-handle  for temp-browse-handle .
      887     if p-change-value > 0
      888     then do:
      889       if frame Dialog-Frame :height + p-change-value
      890           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      891       then do:
      892         assign
      893           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      894                           - (frame Dialog-Frame :height-chars)
      895         .
      896         if p-change-value <= 0
      897         then do:
      898           run diasize_position-resize-button in this-procedure .
      899           return .
      900         end.
      901       end.
      902     end.
      903     if p-change-value < 0
      904     then do:
      905       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      906       then do:
      907         assign
      908           p-change-value = v-diasize-orig-frame-height
      909                          - (frame Dialog-Frame :height-chars)
      910         .
      911         if p-change-value >= 0
      912         then do:
      913           run diasize_position-resize-button in this-procedure .
      914           return .
      915         end.
      916       end.
      917     end.
      918     if p-change-value >= 0
      919     then do:
      920       assign
      921         v-change-sign = 1
      922       .
      923     end.
      924     else do:
      925       assign
      926         v-change-sign = -1
      927       .
      928     end.
      929     assign
      930       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      931     .
      932     if p-change-value = 0
      933     then do:
      934       run diasize_position-resize-button in this-procedure .
      935       return .
      936     end.
      937     move_block:
      938     do
      939     on error undo move_block, retry move_block
      940     :
      941       if retry
      942       then do:
      943         do
      944         on error undo move_block, leave move_block
      945         :
      946           if p-change-value > 0
      947           then do:
      948             for each buf_temp-diasize-handle
      949             on error undo, next
      950             :
      951               assign
      952                 v-object-handle = buf_temp-diasize-handle.handle-value
      953               .
      954               if v-object-handle <> v-diasize-resize-button
      955               then do:
      956                 assign
      957                   v-object-handle :row = buf_temp-diasize-handle.save-position
      958                 .
      959               end.
      960             end.
      961             assign
      962               v-diasize-browse-handle :height = v-browse-height
      963             .
      964             for each buf_temp-browse-handle
      965               where buf_temp-browse-handle.browse-type = 'height':u
      966             on error undo, next
      967             :
      968               assign
      969                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      970               .
      971             end.
      972             assign
      973               frame Dialog-Frame :height = v-frame-height
      974             .
      975             if frame Dialog-Frame :scrollable = true
      976             then do:
      977               assign
      978                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      979               .
      980             end.
      981             run diasize_position-resize-button in this-procedure .
      982           end.
      983           else do:
      984             if frame Dialog-Frame :scrollable = true
      985             then do:
      986               assign
      987                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      988               .
      989             end.
      990             assign
      991               frame Dialog-Frame :height = v-frame-height
      992             .
      993             assign
      994               v-diasize-browse-handle :height = v-browse-height
      995             .
      996             for each buf_temp-browse-handle
      997               where buf_temp-browse-handle.browse-type = 'height':u
      998             on error undo, next
      999             :
     1000               assign
     1001                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1002               .
     1003             end.
     1004             for each buf_temp-diasize-handle
     1005             on error undo, next
     1006             :
     1007               assign
     1008                 v-object-handle = buf_temp-diasize-handle.handle-value
     1009               .
     1010               if v-object-handle <> v-diasize-resize-button
     1011               then do:
     1012                 assign
     1013                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1014                 .
     1015               end.
     1016             end.
     1017             run diasize_position-resize-button in this-procedure .
     1018           end.
     1019           assign
     1020             v-diasize-change-size = false
     1021           .
     1022           leave move_block .
     1023         end.
     1024       end.
     1025       assign
     1026         v-diasize-need-full-display = true
     1027       .
     1028       if v-diasize-change-size = false
     1029       then do:
     1030         assign
     1031           v-diasize-change-size = true
     1032         .
     1033       end.
     1034       else do:
     1035         return .
     1036       end.
     1037       assign
     1038         v-frame-height = frame Dialog-Frame :height
     1039         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1040         v-browse-height = v-diasize-browse-handle :height
     1041       .
     1042       for each buf_temp-browse-handle
     1043         where buf_temp-browse-handle.browse-type = 'height':u
     1044       :
     1045         assign
     1046           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1047         .
     1048       end.
     1049       for each buf_temp-diasize-handle
     1050       :
     1051         delete buf_temp-diasize-handle .
     1052       end.
     1053       assign
     1054         v-field-group-handle = frame Dialog-Frame :first-child
     1055       .
     1056       do while valid-handle(v-field-group-handle)
     1057       :
     1058         assign
     1059           v-object-handle = v-field-group-handle :first-child
     1060         .
     1061         do while valid-handle(v-object-handle)
     1062         :
     1063           if  v-object-handle <> v-diasize-browse-handle :handle
     1064           and can-query(v-object-handle, "row")
     1065           and can-query(v-object-handle, "height")
     1066           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1067           then do:
     1068             find first buf_temp-browse-handle
     1069               where buf_temp-browse-handle.browse-type   = 'height':u
     1070                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1071               no-error .
     1072             if available buf_temp-browse-handle
     1073             then do:
     1074             end.
     1075             else do:
     1076               create buf_temp-diasize-handle .
     1077               assign
     1078                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1079                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1080               .
     1081             end.
     1082           end.
     1083           assign
     1084             v-object-handle = v-object-handle :next-sibling
     1085           .
     1086         end.
     1087         assign
     1088           v-field-group-handle = v-field-group-handle :next-sibling
     1089         .
     1090       end.
     1091       do with frame Dialog-Frame
     1092       :
     1093         hide v-diasize-resize-button .
     1094         assign
     1095           v-diasize-resize-button :row    = 1
     1096           v-diasize-resize-button :column = 1
     1097         .
     1098       end.
     1099       if p-change-value > 0
     1100       then do:
     1101         if frame Dialog-Frame :scrollable = true
     1102         then do:
     1103           assign
     1104             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1105             no-error .
     1106           if error-status :error
     1107           or error-status :get-message(1) <> ""
     1108           then do:
     1109             undo move_block, retry move_block .
     1110           end.
     1111         end.
     1112         assign
     1113           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1114           no-error .
     1115         if error-status :error
     1116         or error-status :get-message(1) <> ""
     1117         then do:
     1118           undo move_block, retry move_block .
     1119         end.
     1120         assign
     1121           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1122           no-error .
     1123         if error-status :error
     1124         or error-status :get-message(1) <> ""
     1125         then do:
     1126           undo move_block, retry move_block .
     1127         end.
     1128         for each buf_temp-browse-handle
     1129           where buf_temp-browse-handle.browse-type = 'height':u
     1130         on error undo move_block, retry move_block
     1131         :
     1132           assign
     1133             buf_temp-browse-handle.browse-handle :height
     1134               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1135             no-error .
     1136           if error-status :error
     1137           or error-status :get-message(1) <> ""
     1138           then do:
     1139             undo move_block, retry move_block .
     1140           end.
     1141         end.
     1142         for each buf_temp-diasize-handle
     1143         on error undo move_block, retry move_block
     1144         :
     1145           assign
     1146             v-object-handle = buf_temp-diasize-handle.handle-value
     1147           .
     1148           if v-object-handle <> v-diasize-resize-button
     1149           then do:
     1150             assign
     1151               v-object-handle :row = v-object-handle :row + p-change-value
     1152               no-error .
     1153             if error-status :error
     1154             or error-status :get-message(1) <> ""
     1155             then do:
     1156               undo move_block, retry move_block .
     1157             end.
     1158           end.
     1159         end.
     1160       end.
     1161       else do:
     1162         for each buf_temp-diasize-handle
     1163         on error undo move_block, retry move_block
     1164         :
     1165           assign
     1166             v-object-handle = buf_temp-diasize-handle.handle-value
     1167           .
     1168           if v-object-handle <> v-diasize-resize-button
     1169           then do:
     1170             assign
     1171               v-object-handle :row = v-object-handle :row + p-change-value
     1172               no-error .
     1173             if error-status :error
     1174             or error-status :get-message(1) <> ""
     1175             then do:
     1176               undo move_block, retry move_block .
     1177             end.
     1178           end.
     1179         end.
     1180         assign
     1181           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1182           no-error .
     1183         if error-status :error
     1184         or error-status :get-message(1) <> ""
     1185         then do:
     1186           undo move_block, retry move_block .
     1187         end.
     1188         for each buf_temp-browse-handle
     1189           where buf_temp-browse-handle.browse-type = 'height':u
     1190         on error undo move_block, retry move_block
     1191         :
     1192           assign
     1193             buf_temp-browse-handle.browse-handle :height
     1194               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1195             no-error .
     1196           if error-status :error
     1197           or error-status :get-message(1) <> ""
     1198           then do:
     1199             undo move_block, retry move_block .
     1200           end.
     1201         end.
     1202         assign
     1203           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1204           no-error .
     1205         if error-status :error
     1206         or error-status :get-message(1) <> ""
     1207         then do:
     1208           undo move_block, retry move_block .
     1209         end.
     1210         if frame Dialog-Frame :scrollable = true
     1211         then do:
     1212           assign
     1213             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1214             no-error .
     1215           if error-status :error
     1216           or error-status :get-message(1) <> ""
     1217           then do:
     1218             undo move_block, retry move_block .
     1219           end.
     1220         end.
     1221       end.
     1222       if p-move-resize = true
     1223       then do:
     1224         run diasize_position-resize-button in this-procedure .
     1225       end.
     1226       if v-diasize-wndstore = true
     1227       then do:
     1228         if connected("ub") = true
     1229         then do:
     1230           define variable v-cntxt-db-num        as integer   no-undo .
     1231           define variable v-cntxt-userid        as character no-undo .
     1232           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1233                                             , OUTPUT v-cntxt-userid
     1234                                             ) .
     1235           run gbl/wndsizew.p
     1236             (input  v-cntxt-db-num
     1237             ,input  v-cntxt-userid
     1238             ,input  v-diasize-proc-name
     1239             ,input  'height':u
     1240             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1241             ) .
     1242         end.
     1243       end.
     1244     end.
     1245     assign
     1246       v-diasize-change-size = false
     1247     .
     1248   end procedure.
     1249   procedure diasize_set-height :
     1250     define input  parameter p-new-height  as decimal   no-undo .
     1251     define input  parameter p-move-resize as logical   no-undo .
     1252     do
     1253     on error undo, return error return-value
     1254     :
     1255       run diasize_change-height in this-procedure
     1256         (input  (p-new-height - frame Dialog-Frame :height)
     1257         ,input  p-move-resize
     1258         ) .
     1259     end.
     1260   end procedure.
     1261   procedure diasize_change-width :
     1262     define input  parameter p-change-value as decimal   no-undo .
     1263     define input  parameter p-move-resize  as logical   no-undo .
     1264     define variable v-field-group-handle   as handle    no-undo .
     1265     define variable v-object-handle        as handle    no-undo .
     1266     define variable v-frame-width          as decimal   no-undo .
     1267     define variable v-frame-virtual-width  as decimal   no-undo .
     1268     define variable v-browse-width         as decimal   no-undo .
     1269     define variable v-window-width         as decimal   no-undo .
     1270     define variable v-window-virtual-width as decimal   no-undo .
     1271     define variable v-change-sign          as integer   no-undo .
     1272     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1273     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1274     if p-change-value > 0
     1275     then do:
     1276       if frame Dialog-Frame :width + p-change-value >
     1277           session :width-chars
     1278       then do:
     1279         assign
     1280           p-change-value = session :width-chars - frame Dialog-Frame :width
     1281         .
     1282         if p-change-value <= 0
     1283         then do:
     1284           run diasize_position-resize-button in this-procedure .
     1285           return .
     1286         end.
     1287       end.
     1288     end.
     1289     if p-change-value < 0
     1290     then do:
     1291       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1292       then do:
     1293         assign
     1294           p-change-value = v-diasize-orig-frame-width
     1295                          - frame Dialog-Frame :width
     1296         .
     1297         if p-change-value >= 0
     1298         then do:
     1299           run diasize_position-resize-button in this-procedure .
     1300           return .
     1301         end.
     1302       end.
     1303     end.
     1304     if p-change-value >= 0
     1305     then do:
     1306       assign
     1307         v-change-sign = 1
     1308       .
     1309     end.
     1310     else do:
     1311       assign
     1312         v-change-sign = -1
     1313       .
     1314     end.
     1315     assign
     1316       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1317     .
     1318     if p-change-value = 0
     1319     then do:
     1320       run diasize_position-resize-button in this-procedure .
     1321       return .
     1322     end.
     1323     move_block:
     1324     do
     1325     on error undo move_block, leave move_block
     1326     :
     1327       if retry
     1328       then do:
     1329         do
     1330         on error undo move_block, leave move_block
     1331         :
     1332           if p-change-value > 0
     1333           then do:
     1334             for each buf_temp-diasize-handle
     1335             on error undo, next
     1336             :
     1337               assign
     1338                 v-object-handle = buf_temp-diasize-handle.handle-value
     1339               .
     1340               if v-object-handle <> v-diasize-resize-button
     1341               then do:
     1342                 assign
     1343                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1344                 .
     1345               end.
     1346             end.
     1347             assign
     1348               v-diasize-browse-handle :width = v-browse-width
     1349             .
     1350             for each buf_temp-browse-handle
     1351               where buf_temp-browse-handle.browse-type = 'width':u
     1352             on error undo, next
     1353             :
     1354               assign
     1355                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1356               .
     1357             end.
     1358             assign
     1359               frame Dialog-Frame :width = v-frame-width
     1360             .
     1361             if frame Dialog-Frame :scrollable = true
     1362             then do:
     1363               assign
     1364                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1365               .
     1366             end.
     1367             run diasize_position-resize-button in this-procedure .
     1368           end.
     1369           else do:
     1370             if frame Dialog-Frame :scrollable = true
     1371             then do:
     1372               assign
     1373                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1374               .
     1375             end.
     1376             assign
     1377               frame Dialog-Frame :width = v-frame-width
     1378             .
     1379             for each buf_temp-browse-handle
     1380               where buf_temp-browse-handle.browse-type = 'width':u
     1381             on error undo, next
     1382             :
     1383               assign
     1384                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1385               .
     1386             end.
     1387             assign
     1388               v-diasize-browse-handle :width = v-browse-width
     1389             .
     1390             for each buf_temp-diasize-handle
     1391             on error undo, next
     1392             :
     1393               assign
     1394                 v-object-handle = buf_temp-diasize-handle.handle-value
     1395               .
     1396               if v-object-handle <> v-diasize-resize-button
     1397               then do:
     1398                 assign
     1399                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1400                 .
     1401               end.
     1402             end.
     1403             run diasize_position-resize-button in this-procedure .
     1404           end.
     1405           assign
     1406             v-diasize-change-size = false
     1407           .
     1408           leave move_block .
     1409         end.
     1410       end.
     1411       assign
     1412         v-diasize-need-full-display = true
     1413       .
     1414       if v-diasize-change-size = false
     1415       then do:
     1416         assign
     1417           v-diasize-change-size = true
     1418         .
     1419       end.
     1420       else do:
     1421         return .
     1422       end.
     1423       assign
     1424         v-frame-width = frame Dialog-Frame :width
     1425         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1426         v-browse-width = v-diasize-browse-handle :width
     1427       .
     1428       for each buf_temp-browse-handle
     1429         where buf_temp-browse-handle.browse-type = 'width':u
     1430       :
     1431         assign
     1432           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1433         .
     1434       end.
     1435       for each buf_temp-diasize-handle
     1436       :
     1437         delete buf_temp-diasize-handle .
     1438       end.
     1439       assign
     1440         v-field-group-handle = frame Dialog-Frame :first-child
     1441       .
     1442       do while valid-handle(v-field-group-handle)
     1443       :
     1444         assign
     1445           v-object-handle = v-field-group-handle :first-child
     1446         .
     1447         do while valid-handle(v-object-handle)
     1448         :
     1449           if  v-object-handle <> v-diasize-browse-handle :handle
     1450           and v-object-handle <> v-diasize-resize-button
     1451           and can-query(v-object-handle, "row")
     1452           and can-query(v-object-handle, "height")
     1453           and ( v-object-handle :col + v-object-handle :width
     1454                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1455               )
     1456           then do:
     1457             find first buf_temp-browse-handle
     1458               where buf_temp-browse-handle.browse-type   = 'width':u
     1459                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1460               no-error .
     1461             if available buf_temp-browse-handle
     1462             then do:
     1463             end.
     1464             else do:
     1465               create buf_temp-diasize-handle .
     1466               assign
     1467                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1468                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1469               .
     1470             end.
     1471           end.
     1472           assign
     1473             v-object-handle = v-object-handle :next-sibling
     1474           .
     1475         end.
     1476         assign
     1477           v-field-group-handle = v-field-group-handle :next-sibling
     1478         .
     1479       end.
     1480       do with frame Dialog-Frame
     1481       :
     1482         hide v-diasize-resize-button .
     1483         v-diasize-resize-button :row = 1.
     1484         v-diasize-resize-button :column = 1.
     1485       end.
     1486       if p-change-value > 0
     1487       then do:
     1488         if frame Dialog-Frame :scrollable = true
     1489         then do:
     1490           assign
     1491             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1492             no-error .
     1493           if error-status :error
     1494           or error-status :get-message(1) <> ""
     1495           then do:
     1496             undo move_block, retry move_block.
     1497           end.
     1498         end.
     1499         assign
     1500           frame Dialog-Frame :width = v-frame-width + p-change-value
     1501           no-error .
     1502         if error-status :error
     1503         or error-status :get-message(1) <> ""
     1504         then do:
     1505           undo move_block, retry move_block.
     1506         end.
     1507         assign
     1508           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1509         no-error .
     1510         if error-status :error
     1511         or error-status :get-message(1) <> ""
     1512         then do:
     1513           undo move_block, retry move_block.
     1514         end.
     1515         for each buf_temp-browse-handle
     1516           where buf_temp-browse-handle.browse-type = 'width':u
     1517         on error undo move_block, retry move_block
     1518         :
     1519           assign
     1520             buf_temp-browse-handle.browse-handle :width
     1521               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1522             no-error .
     1523           if error-status :error
     1524           or error-status :get-message(1) <> ""
     1525           then do:
     1526             undo move_block, retry move_block .
     1527           end.
     1528         end.
     1529         for each buf_temp-diasize-handle
     1530         on error undo move_block, retry move_block
     1531         :
     1532           assign
     1533             v-object-handle = buf_temp-diasize-handle.handle-value
     1534           .
     1535           if v-object-handle <> v-diasize-resize-button
     1536           then do:
     1537             assign
     1538               v-object-handle :col = v-object-handle :col + p-change-value
     1539               no-error .
     1540             if error-status :error
     1541             or error-status :get-message(1) <> ""
     1542             then do:
     1543               undo move_block, retry move_block .
     1544             end.
     1545           end.
     1546         end.
     1547       end.
     1548       else do:
     1549         for each buf_temp-diasize-handle
     1550         on error undo move_block, retry move_block
     1551         :
     1552           assign
     1553             v-object-handle = buf_temp-diasize-handle.handle-value
     1554           .
     1555           if v-object-handle <> v-diasize-resize-button
     1556           then do:
     1557             assign
     1558               v-object-handle :col = v-object-handle :col + p-change-value
     1559               no-error .
     1560             if error-status :error
     1561             or error-status :get-message(1) <> ""
     1562             then do:
     1563               undo move_block, retry move_block .
     1564             end.
     1565           end.
     1566         end.
     1567         for each buf_temp-browse-handle
     1568           where buf_temp-browse-handle.browse-type = 'width':u
     1569         on error undo move_block, retry move_block
     1570         :
     1571           assign
     1572             buf_temp-browse-handle.browse-handle :width
     1573               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1574             no-error .
     1575           if error-status :error
     1576           or error-status :get-message(1) <> ""
     1577           then do:
     1578             undo move_block, retry move_block .
     1579           end.
     1580         end.
     1581         assign
     1582           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1583           no-error .
     1584         if error-status :error
     1585         or error-status :get-message(1) <> ""
     1586         then do:
     1587           undo move_block, retry move_block.
     1588         end.
     1589         assign
     1590           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1591         no-error .
     1592         if error-status :error
     1593         or error-status :get-message(1) <> ""
     1594         then do:
     1595           undo move_block, retry move_block.
     1596         end.
     1597         if frame Dialog-Frame :scrollable = true
     1598         then do:
     1599           assign
     1600             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1601           no-error .
     1602           if error-status :error
     1603           or error-status :get-message(1) <> ""
     1604           then do:
     1605             undo move_block, retry move_block.
     1606           end.
     1607         end.
     1608       end.
     1609       if p-move-resize
     1610       then do:
     1611         run diasize_position-resize-button in this-procedure .
     1612       end.
     1613       if v-diasize-wndstore = true
     1614       then do:
     1615         if connected("ub") = true
     1616         then do:
     1617           define variable v-cntxt-db-num        as integer   no-undo .
     1618           define variable v-cntxt-userid        as character no-undo .
     1619           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1620                                             , OUTPUT v-cntxt-userid
     1621                                             ) .
     1622           run gbl/wndsizew.p
     1623             (input  v-cntxt-db-num
     1624             ,input  v-cntxt-userid
     1625             ,input  v-diasize-proc-name
     1626             ,input  'width':u
     1627             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1628             ) .
     1629         end.
     1630       end.
     1631     end.
     1632     assign
     1633       v-diasize-change-size = false
     1634     .
     1635   end procedure.
     1636   procedure diasize_set-width :
     1637     define input  parameter p-new-width  as decimal   no-undo .
     1638     define input  parameter p-move-resize as logical   no-undo .
     1639     do
     1640     on error undo, return error return-value
     1641     :
     1642       run diasize_change-width in this-procedure
     1643         (input  (p-new-width - frame Dialog-Frame :width)
     1644         ,input  p-move-resize
     1645         ) .
     1646     end.
     1647   end procedure.
     1648   procedure diasize_position-resize-button :
     1649     do with frame Dialog-Frame
     1650     :
     1651       hide v-diasize-resize-button .
     1652       assign
     1653         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1654                     - 1
     1655                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1656         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1657                     - 1
     1658                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1659       .
     1660       view v-diasize-resize-button .
     1661     end.
     1662   end procedure.
     1663   on alt-right anywhere
     1664   do:
     1665     run diasize_change-width in this-procedure
     1666       (input 1
     1667       ,input true
     1668       ) .
     1669     return no-apply .
     1670   end.
     1671   on alt-left anywhere
     1672   do:
     1673     run diasize_change-width in this-procedure
     1674       (input -1
     1675       ,input true
     1676       ) .
     1677     return no-apply .
     1678   end.
     1679   on alt-down anywhere
     1680   do:
     1681     run diasize_change-height in this-procedure
     1682       (input 1
     1683       ,input true
     1684       ) .
     1685     return no-apply .
     1686   end.
     1687   on alt-up anywhere
     1688   do:
     1689     run diasize_change-height in this-procedure
     1690       (input -1
     1691       ,input true
     1692       ) .
     1693     return no-apply .
     1694   end.
     1695   on alt-enter of frame Dialog-Frame
     1696   do:
     1697     run diasize_maximize in this-procedure
     1698       (input  ?
     1699       ).
     1700     return no-apply .
     1701   end.
     1702   procedure diasize_end-move :
     1703     do
     1704     on error undo, return error return-value
     1705     :
     1706       define variable v-row-delta as decimal   no-undo .
     1707       define variable v-col-delta as decimal   no-undo .
     1708       define variable v-new-row as decimal   no-undo .
     1709       define variable v-new-col as decimal   no-undo .
     1710       assign
     1711         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1712         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1713       .
     1714       assign
     1715         v-row-delta = v-new-row - frame Dialog-Frame :height
     1716         v-col-delta = v-new-col - frame Dialog-Frame :width
     1717       .
     1718       run diasize_change-height in this-procedure
     1719         (input v-row-delta
     1720         ,input true
     1721         ) .
     1722       run diasize_change-width in this-procedure
     1723         (input v-col-delta
     1724         ,input true
     1725         ) .
     1726     end.
     1727   end procedure.
     1728   procedure diasize_maximize :
     1729     define input  parameter p-action as logical   no-undo .
     1730     do
     1731     on error undo, return error return-value
     1732     :
     1733       if p-action = ?
     1734       then do:
     1735         if v-diasize-need-maximize = true
     1736         then do:
     1737           assign
     1738             p-action = true
     1739           .
     1740         end.
     1741         else do:
     1742           assign
     1743             p-action = false
     1744           .
     1745         end.
     1746       end.
     1747       if p-action = true
     1748       then do:
     1749         run diasize_change-height in this-procedure
     1750           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1751               - frame Dialog-Frame :height-chars
     1752           ,input true
     1753           ) .
     1754         run diasize_change-width in this-procedure
     1755           (input session :width-chars
     1756               - frame Dialog-Frame :width-chars
     1757           ,input true
     1758           ) .
     1759         assign
     1760           v-diasize-need-maximize = false
     1761         .
     1762       end.
     1763       else do:
     1764         run diasize_change-width in this-procedure
     1765           (input v-diasize-orig-frame-width
     1766               - frame Dialog-Frame :width-chars
     1767           ,input true
     1768           ) .
     1769         run diasize_change-height in this-procedure
     1770           (input v-diasize-orig-frame-height
     1771               - frame Dialog-Frame :height-chars
     1772           ,input true
     1773           ) .
     1774         assign
     1775           v-diasize-need-maximize = true
     1776         .
     1777       end.
     1778     end.
     1779   end procedure.
     1780   procedure diasize_restore-orig-size :
     1781     do
     1782     on error undo, return error return-value
     1783     :
     1784       assign
     1785         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1786         v-diasize-current-frame-height = frame Dialog-Frame :height
     1787       .
     1788       run diasize_set-height in this-procedure
     1789         (input  v-diasize-orig-frame-height
     1790         ,input  true
     1791         ) .
     1792       run diasize_set-width in this-procedure
     1793         (input  v-diasize-orig-frame-width
     1794         ,input  true
     1795         ) .
     1796     end.
     1797   end procedure.
     1798   procedure diasize_restore-current-size :
     1799     do
     1800     on error undo, return error return-value
     1801     :
     1802       run diasize_set-height in this-procedure
     1803         (input  v-diasize-current-frame-height
     1804         ,input  true
     1805         ) .
     1806       run diasize_set-width in this-procedure
     1807         (input  v-diasize-current-frame-width
     1808         ,input  true
     1809         ) .
     1810     end.
     1811   end procedure.
     1812   procedure diasize_set-browse-handle :
     1813     define input  parameter p-browse-handle as handle   no-undo .
     1814     define buffer buf_temp-browse-handle for temp-browse-handle .
     1815     do
     1816     on error undo, return error return-value
     1817     :
     1818       assign
     1819         v-diasize-browse-handle = p-browse-handle
     1820       .
     1821       for each buf_temp-browse-handle
     1822       on error undo, return error return-value
     1823       :
     1824         delete buf_temp-browse-handle .
     1825       end.
     1826     end.
     1827   end procedure.
     1828   procedure diasize_add_browse :
     1829     define input  parameter p-browse-type   as character no-undo .
     1830     define input  parameter p-browse-handle as handle    no-undo .
     1831     define buffer buf_temp-browse-handle for temp-browse-handle .
     1832     do
     1833     on error undo, return error return-value
     1834     :
     1835       assign
     1836         v-diasize-browse-number = v-diasize-browse-number + 1
     1837       .
     1838       create buf_temp-browse-handle .
     1839       assign
     1840         buf_temp-browse-handle.browse-type   = p-browse-type
     1841         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1842         buf_temp-browse-handle.browse-handle = p-browse-handle
     1843       .
     1844     end.
     1845   end procedure.
     1846   procedure diasize_init :
     1847     define variable v-default-value    as logical   no-undo .
     1848     define variable v-restore-saved    as logical   no-undo .
     1849     define variable v-resize-value-str as character no-undo .
     1850     do
     1851     on error undo, return error return-value
     1852     :
     1853       do with frame Dialog-Frame
     1854       :
     1855         assign
     1856           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1857           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1858           v-diasize-browse-handle     = browse BR-c-stop-list :handle
     1859         .
     1860         create button v-diasize-resize-button
     1861         assign
     1862           parent        = frame Dialog-Frame :first-child
     1863           label         = "s"
     1864           height-pixels = 16
     1865           width-pixels  = 16
     1866           visible       = true
     1867           sensitive     = true
     1868           movable       = true
     1869           triggers:
     1870             on end-move persistent run diasize_end-move in this-procedure .
     1871           end triggers.
     1872         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1873         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1874         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1875         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1876         assign
     1877           v-diasize-wndmax = false
     1878         .
     1879         if connected("ub") = true
     1880         then do:
     1881           define variable v-cntxt-db-num        as integer   no-undo .
     1882           define variable v-cntxt-userid        as character no-undo .
     1883           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1884                                             , OUTPUT v-cntxt-userid
     1885                                             ) .
     1886           run gbl/wndpar_r.p
     1887             (input  v-cntxt-db-num
     1888             ,input  v-cntxt-userid
     1889             ,input  'wndmax':U
     1890             ,output v-diasize-wndmax
     1891             ,output v-default-value
     1892             ) .
     1893         end.
     1894         assign
     1895           v-diasize-wndstore = false
     1896         .
     1897         if connected("ub") = true
     1898         then do:
     1899           run gbl/wndpar_r.p
     1900             (input  v-cntxt-db-num
     1901             ,input  v-cntxt-userid
     1902             ,input  'wndstore':U
     1903             ,output v-diasize-wndstore
     1904             ,output v-default-value
     1905             ) .
     1906         end.
     1907         assign
     1908           v-diasize-proc-name = entry(1, program-name(2), '.')
     1909         .
     1910         if v-diasize-wndstore = true
     1911         then do:
     1912           assign
     1913             v-restore-saved = false
     1914           .
     1915           if connected("ub") = true
     1916           then do:
     1917             run gbl/wndsizer.p
     1918               (input  v-cntxt-db-num
     1919               ,input  v-cntxt-userid
     1920               ,input  v-diasize-proc-name
     1921               ,input  'height':u
     1922               ,output v-resize-value-str
     1923               ) .
     1924             if v-resize-value-str <> '':U
     1925             then do:
     1926               run diasize_change-height in this-procedure
     1927                 (input  integer(v-resize-value-str)
     1928                 ,input  true
     1929                 ) .
     1930               assign
     1931                 v-restore-saved = true
     1932               .
     1933             end.
     1934           end.
     1935           if connected("ub") = true
     1936           then do:
     1937             run gbl/wndsizer.p
     1938               (input  v-cntxt-db-num
     1939               ,input  v-cntxt-userid
     1940               ,input  v-diasize-proc-name
     1941               ,input  'width':u
     1942               ,output v-resize-value-str
     1943               ) .
     1944             if v-resize-value-str <> '':U
     1945             then do:
     1946               run diasize_change-width in this-procedure
     1947                 (input  integer(v-resize-value-str)
     1948                 ,input  true
     1949                 ) .
     1950               assign
     1951                 v-restore-saved = true
     1952               .
     1953             end.
     1954           end.
     1955           if v-restore-saved <> true
     1956           then do:
     1957             if v-diasize-wndmax = true
     1958             then do:
     1959               run diasize_maximize in this-procedure
     1960                 (input  true
     1961                 ) .
     1962             end.
     1963           end.
     1964         end.
     1965         else do:
     1966           if v-diasize-wndmax = true
     1967           then do:
     1968             run diasize_maximize in this-procedure
     1969               (input  true
     1970               ) .
     1971           end.
     1972         end.
     1973       end.
     1974     end.
     1975   end procedure.
     1976   procedure diasize_need-full-display :
     1977     define output parameter p-need-full-display as logical   no-undo .
     1978     do
     1979     on error undo, return error return-value
     1980     :
     1981       assign
     1982         p-need-full-display = v-diasize-need-full-display
     1983       .
     1984       assign
     1985         v-diasize-need-full-display = false
     1986       .
     1987     end.
     1988   end procedure.
     1989   procedure get-context :
     1990      define output parameter p-db-num as integer          no-undo.
     1991      define output parameter p-user-id as character        no-undo.
     1992      define variable v-login               as character    no-undo.
     1993      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1994      define buffer buf_user-login  for ub.user-login .
     1995      do
     1996      on error undo, return error
     1997      :
     1998            FIND FIRST buf_sys-ctrl no-lock.
     1999            ASSIGN
     2000               v-login = USERID("ub")
     2001               p-db-num = buf_sys-ctrl.db-num
     2002            .
     2003            FIND FIRST buf_user-login
     2004                 WHERE buf_user-login.db-num = p-db-num
     2005                   AND buf_user-login.user-login = v-login
     2006                 no-lock
     2007                 no-error
     2008                 .
     2009            IF AVAILABLE buf_user-login
     2010            THEN DO:
     2011               assign
     2012                  p-user-id = buf_user-login.user-id
     2013               .
     2014            END.
     2015      end.
     2016   end procedure.
     2017       run diasize_init in this-procedure .
     2018   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2019   do:
     2020     BR-c-stop-list :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2021   end.
     2022   define variable vss-include-info15 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2023   on INS of frame Dialog-Frame anywhere do:
     2024     if b-mark :sensitive then DO: apply "CHOOSE":U to b-mark in frame Dialog-Frame. END.
     2025     return no-apply.
     2026   end.
     2027   define variable vss-include-info16 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2028   on F3 of frame Dialog-Frame anywhere do:
     2029     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame Dialog-Frame. END.
     2030     return no-apply.
     2031   end.
     2032   define variable vss-include-info17 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2033   on F2 of frame Dialog-Frame anywhere do:
     2034     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame Dialog-Frame. END.
     2035     return no-apply.
     2036   end.
     2037   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2038   on F2 of frame Dialog-Frame anywhere do:
     2039     if b-quit :sensitive then DO: apply "CHOOSE":U to b-quit in frame Dialog-Frame. END.
     2040     return no-apply.
     2041   end.
     2042   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2043   procedure set-filter-name :
     2044   define input parameter p-filter-name as character no-undo .
     2045     do with frame Dialog-Frame:
     2046       if p-filter-name > "" then do:
     2047         assign
     2048           frame Dialog-Frame:title
     2049             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2050         .
     2051         assign
     2052           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2053         .
     2054       end.
     2055       else do:
     2056         assign
     2057           b-sch :tooltip = ""
     2058         .
     2059       end.
     2060     end.
     2061   end procedure.
     2062   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2063   on f5 of frame Dialog-Frame anywhere
     2064   do:
     2065      v-doc-rec = ?. if available X_c-stop-list then v-doc-rec = recid(X_c-stop-list).                run openbr in this-procedure ( input yes, input no, input '':U) no-error.                REPOSITION br-c-stop-list to recid v-doc-rec No-ERROR.
     2066       apply "VALUE-CHANGED" to BR-c-stop-list.
     2067   end.
     2068   MAIN-BLOCK:
     2069   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2070      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2071   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2072     run mainmenu_getcntxt in parparentproc
     2073       (output v-cntxt-db-num
     2074       ,output v-cntxt-userid
     2075       ,output v-cntxt-level
     2076       ,output v-cntxt-host-code-obj
     2077       ,output v-cntxt-obj-type
     2078       ,output v-cntxt-obj-code
     2079       ,output v-cntxt-db-num-obj
     2080       ,output v-cntxt-is-admin
     2081       ) .
     2082     ASSIGN
     2083     v-rid-list = p-rid-list.
     2084     RUN Myenable IN THIS-PROCEDURE NO-ERROR.
     2085     IF v-rid-list <> '':U THEN DO:
     2086       REPOSITION br-c-stop-list to RECID INTEGER(entry(1, v-rid-list)) NO-ERROR.
     2087       APPLY "entry" to br-c-stop-list.
     2088       APPLY "value-changed" TO br-c-stop-list.
     2089     END.
     2090     WAIT-FOR GO OF FRAME Dialog-Frame.
     2091   END.
     2092   RUN disable_UI.
     2093   PROCEDURE disable_UI :
     2094     HIDE FRAME Dialog-Frame.
     2095   END PROCEDURE.
     2096   PROCEDURE enable_UI :
     2097     DISPLAY mark-num
     2098         WITH FRAME Dialog-Frame.
     2099     ENABLE b-quit B-mark B-sel b-lkp b-sch B-Help BR-c-stop-list mark-num
     2100         WITH FRAME Dialog-Frame.
     2101     VIEW FRAME Dialog-Frame.
     2102     OPEN QUERY BR-c-stop-list FOR EACH X_c-stop-list NO-LOCK WHERE        X_c-stop-list.classif-type = 'dis-card':U      INDEXED-REPOSITION.
     2103   END PROCEDURE.
     2104   PROCEDURE MyEnable :
     2105   ENABLE
     2106   b-quit
     2107   B-mark  when lookup("b-mark", bttns) > 0
     2108   B-sel when lookup("b-sel", bttns) > 0
     2109   b-lkp
     2110   b-sch
     2111   B-Help
     2112   BR-c-stop-list
     2113   WITH FRAME Dialog-Frame .
     2114   VIEW FRAME Dialog-Frame .
     2115   run openbr in this-procedure ( input yes, input no, input '':U).
     2116   END PROCEDURE.
     2117   PROCEDURE OpenBr :
     2118   define input  parameter p-open-query     as logical   no-undo .
     2119   define input  parameter p-find-next      as logical   no-undo .
     2120   define input  parameter p-find-condition as character no-undo .
     2121   define variable l-query-was-opened as logical no-undo .
     2122   run waitfram-show in this-procedure ( input "Ждите...").
     2123   define variable sort-column-phrase as character no-undo .
     2124   case sort-column-name :
     2125     when "" then do:
     2126       assign
     2127         sort-column-phrase = ""
     2128       .
     2129     end.
     2130     otherwise do:
     2131       assign
     2132         sort-column-phrase = "by " + sort-column-name
     2133       .
     2134     end.
     2135   end case.
     2136    CASE p-list-mode:
     2137      WHEN 'все':U THEN DO:
     2138       ASSIGN
     2139       FRAME Dialog-Frame:TITLE = substitute("СТОПЛИСТЫ ПО ДК")
     2140         filter-label = filter-label0
     2141         filter-point = filter-point0
     2142         .
     2143         if sort-column-name = '':u then do:
     2144   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2145   define variable  l-disable-where-23  as logical   no-undo .
     2146   define variable  l-filter-open-23    as logical   .
     2147   define variable  flt-rec-23       as recid     no-undo .
     2148   define variable  filter-name-23      as character no-undo .
     2149   define variable  where-phrase-23     as character no-undo .
     2150   define variable  sort-phrase-23      as character no-undo .
     2151   define variable  where-phrase-rus-23 as character no-undo .
     2152   define variable  sort-phrase-rus-23  as character no-undo .
     2153     run waitfram-show in this-procedure
     2154       (input "ЖДИТЕ ..."
     2155       ).
     2156   run gbl/flt-get.p
     2157     (input filter-point
     2158     ,output flt-rec-23
     2159     ,output filter-name-23
     2160     ,output where-phrase-23
     2161     ,output sort-phrase-23
     2162     ,output where-phrase-rus-23
     2163     ,output sort-phrase-rus-23
     2164     ).
     2165   if p-open-query then do:
     2166       run set-filter-name in this-procedure
     2167         (INPUT filter-name-23
     2168         ) no-error .
     2169     assign
     2170       l-filter-open-23 = false
     2171     .
     2172     if flt-rec-23 <> ?
     2173       or sort-column-phrase > ""
     2174     then do:
     2175       define variable  parameter-2-23 as character no-undo .
     2176       define variable  parameter-3-23 as character no-undo .
     2177       define variable  parameter-4-23 as character no-undo .
     2178       define variable  parameter-5-23 as character no-undo .
     2179       define variable  parameter-6-23 as character no-undo .
     2180       define variable  parameter-7-23 as character no-undo .
     2181         assign
     2182         parameter-3-23 =
     2183                                 "FOR EACH X_c-stop-list"
     2184         parameter-4-23 =
     2185           (
     2186             if (" X_c-stop-list.classif-type = 'dis-card':U                           " + " " + where-phrase-23) <> ""
     2187             then  substitute('X_c-stop-list.classif-type = &1&2&1', chr(34), 'dis-card':U)  + " " + where-phrase-23
     2188             else "true"
     2189           )
     2190         parameter-5-23 = (" " + "" + " " + "")
     2191         parameter-6-23 = if sort-phrase-23 = ''
     2192                              then
     2193           (
     2194           " " + "  " +
     2195             " " + sort-column-phrase +
     2196           " " + " by X_c-stop-list.stop-list-code descending"
     2197           )
     2198                              else
     2199           (
     2200           " " + "  " +
     2201             " " + sort-column-phrase +
     2202           " " + sort-phrase-23
     2203           )
     2204         parameter-7-23 =
     2205           " indexed-reposition  "
     2206       .
     2207       do
     2208       on stop undo, leave
     2209       on error undo, leave
     2210       :
     2211         assign
     2212           l-disable-where-23 =
     2213             (" X_c-stop-list.classif-type = 'dis-card':U                           " + " " + where-phrase-23 = "")
     2214         .
     2215         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2216                             ,input query br-c-stop-list:handle
     2217                             ,input parameter-3-23
     2218                             ,input parameter-4-23
     2219                             ,input parameter-5-23
     2220                             ,input parameter-6-23
     2221                             ,input parameter-7-23
     2222                             )
     2223         .
     2224         assign
     2225           l-filter-open-23 = true
     2226         .
     2227       end.
     2228       if l-filter-open-23 = false then do:
     2229         message
     2230           "Ошибка при фильтрации / сортировке" skip
     2231           "Будут показаны записи без учета фильтра" skip
     2232           view-as alert-box .
     2233       end.
     2234       else do:
     2235           assign
     2236             l-query-was-opened = true
     2237           .
     2238       end.
     2239     end.
     2240     if l-filter-open-23 = false then do:
     2241       OPEN QUERY br-c-stop-list FOR EACH X_c-stop-list
     2242         where  X_c-stop-list.classif-type = 'dis-card':U
     2243          by X_c-stop-list.stop-list-code descending
     2244         indexed-reposition
     2245     .
     2246         assign
     2247           l-query-was-opened = true
     2248         .
     2249     end.
     2250   end.
     2251   else do:
     2252     assign
     2253       v-doc-rec = recid( X_c-stop-list )
     2254     .
     2255     do
     2256     on stop undo, leave
     2257     on error undo, leave
     2258     :
     2259       if query br-c-stop-list:handle:get-buffer-handle(1) = (buffer X_c-stop-list:handle) then do:
     2260         assign
