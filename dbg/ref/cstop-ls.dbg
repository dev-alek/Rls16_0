     2289             then  substitute('X_c-stop-list.classif-type = &1&2&1', chr(34), 'dis-card':U)  + " " + where-phrase-23
     2290             else "true"
     2291           )
     2292         parameter-5-23 = (" " + "" + " " + "" + " " + p-find-condition)
     2293         parameter-6-23 = if sort-phrase-23 = ''
     2294                              then
     2295           (
     2296           " " + "  " +
     2297             " " + sort-column-phrase +
     2298           " " + " by X_c-stop-list.stop-list-code descending"
     2299           )
     2300                              else
     2301           (
     2302           " " + "  " +
