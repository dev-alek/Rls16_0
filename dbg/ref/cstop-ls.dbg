     2382             then  substitute('X_c-stop-list.classif-type = &1&2&1                          and X_c-stop-list.stop-list-code = &1&3&1 ', chr(34), 'dis-card':U, p-stop-list-code)  + " " + where-phrase-25
     2383             else "true"
