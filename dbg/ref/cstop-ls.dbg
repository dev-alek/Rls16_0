     2386         parameter-6-25 = if sort-phrase-25 = ''
     2387                              then
     2388           (
     2389           " " + "  " +
     2390             " " + sort-column-phrase +
     2391           " " + " by X_c-stop-list.stop-list-code descending"
     2392           )
     2393                              else
     2394           (
     2395           " " + "  " +
     2396             " " + sort-column-phrase +
     2397           " " + sort-phrase-25
     2398           )
     2399         parameter-7-25 =
     2400           " indexed-reposition  "
     2401       .
     2402       do
     2403       on stop undo, leave
     2404       on error undo, leave
     2405       :
     2406         assign
     2407           l-disable-where-25 =
     2408             (" X_c-stop-list.classif-type = 'dis-card':U                          and X_c-stop-list.stop-list-code = p-stop-list-code                           " + " " + where-phrase-25 = "")
     2409         .
     2410         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2411                             ,input query br-c-stop-list:handle
     2412                             ,input parameter-3-25
     2413                             ,input parameter-4-25
     2414                             ,input parameter-5-25
     2415                             ,input parameter-6-25
     2416                             ,input parameter-7-25
     2417                             )
     2418         .
     2419         assign
     2420           l-filter-open-25 = true
     2421         .
     2422       end.
     2423       if l-filter-open-25 = false then do:
     2424         message
     2425           "Ошибка при фильтрации / сортировке" skip
     2426           "Будут показаны записи без учета фильтра" skip
     2427           view-as alert-box .
     2428       end.
     2429       else do:
     2430           assign
     2431             l-query-was-opened = true
     2432           .
     2433       end.
     2434     end.
     2435     if l-filter-open-25 = false then do:
