     2521       .
     2522     end.
     2523   end.
     2524     run waitfram-hide in this-procedure .
     2525         end.
     2526      END.
     2527    END CASE.
     2528   if not p-open-query and v-doc-rec <> ? then
     2529   REPOSITION br-c-stop-list to recid v-doc-rec No-ERROR.
     2530   if not p-open-query and v-fltopend-rowid[1] <> ? then
     2531   query br-c-stop-list:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     2532   run waitfram-hide in this-procedure .
     2533   APPLY "VALUE-CHANGED" TO br-c-stop-list in frame Dialog-Frame.
     2534   APPLY "ENTRY" TO br-c-stop-list.
     2535   END PROCEDURE.
     2536   PROCEDURE proc-b-lkp :
     2537   DEFINE VARIABLE v-loc-rid-list AS CHARACTER NO-UNDO.
     2538   IF NOT AVAILABLE X_c-stop-list THEN RETURN ERROR.
     2539   END PROCEDURE.
     2540   PROCEDURE proc-b-sch :
     2541   define variable v-ri as recid no-undo .
     2542   assign
     2543   v-ri = (if avail X_c-stop-list then recid(X_c-stop-list) else ?)
     2544   .
     2545   assign
     2546   tbl = 'c-stop-list'
     2547   join-tbl = 'X_c-stop-list'
     2548   fld = ""
     2549   lab = ""
     2550   spr = ""
     2551   dim = '0'
     2552   .
     2553   run fltfield-add in this-procedure('doc-date', 'Дата стоплиста', '',
     2554   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2555   run fltfield-add in this-procedure('fact-date', 'Факт.Дата стоплиста', '',
     2556   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2557   run fltfield-add in this-procedure('stop-list-code', 'N стоплиста', '',
     2558   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     2559   DO on stop undo, leave:
     2560       run gbl/filter.w ( INPUT parparentproc
     2561                    ,INPUT filter-point + chr(4) + filter-label
     2562                    ,INPUT tbl
     2563                    ,INPUT join-tbl
     2564                    ,INPUT fld
     2565                    ,INput lab
     2566                    ,INPUT spr
     2567                    ,INPUT  dim).
     2568       RUN OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U).
     2569       if v-ri <> ? then do:
     2570         reposition br-c-stop-list to recid v-ri no-error.
     2571       end.
     2572       APPLY "ENTRY" to br-c-stop-list in frame Dialog-Frame .
     2573   END .
     2574   END PROCEDURE.
