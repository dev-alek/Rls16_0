        1   block-level on error undo, throw.
        2   define input  parameter parparentproc  as widget-handle no-undo.
        3   define input  parameter p-mode as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: abccomp.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: ref/abccomp.p $":U .
        9   define variable vss-description as character no-undo init "Сравнение ABC (вызов разных режимов )".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80     define variable v-cntxt-db-num        as integer   no-undo .
       81     define variable v-cntxt-userid        as character no-undo .
       82     define variable v-cntxt-level         as character no-undo .
       83     define variable v-cntxt-host-code-obj as integer   no-undo .
       84     define variable v-cntxt-obj-type      as character no-undo .
       85     define variable v-cntxt-obj-code      as integer   no-undo .
       86     define variable v-cntxt-db-num-obj    as integer   no-undo .
       87     define variable v-cntxt-is-admin      as logical   no-undo .
       88   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       89     run mainmenu_getcntxt in parparentproc
       90       (output v-cntxt-db-num
       91       ,output v-cntxt-userid
       92       ,output v-cntxt-level
       93       ,output v-cntxt-host-code-obj
       94       ,output v-cntxt-obj-type
       95       ,output v-cntxt-obj-code
       96       ,output v-cntxt-db-num-obj
       97       ,output v-cntxt-is-admin
       98       ) .
       99     define variable p-rez as character no-undo .
      100       run ref/abcanal.w ( input parParentProc ,  "b-sel,b-mark" , output p-rez) .
      101    if num-entries(p-rez) < 1 then do:
      102       message
      103       "Должно быть отмечено не менее одного анализа !!!"
      104       view-as alert-box information .
      105       return.
      106    end.
      107    if p-mode = "lvl":U then do:
      108     define variable v-lvl as character no-undo .
      109     v-lvl   = '1'.
      110     run gbl/d-prompt.w
      111      (  'title=':u + "Задание параметров отчета" + '\':u
      112       + 'text1=':u + "введите уровень группы" + '\':u
      113       + 'text2=':u + "" + '\':u
      114       + 'format=>9\':u
      115       + 'type=int\':u
      116       ,input-output v-lvl
      117       ).
      118     if return-value = 'false':u
      119     then do:
      120       return .
      121     end.
      122      if v-lvl = '0' or v-lvl = ? or v-lvl = '' then do:
      123         message "Не верно указан № уровня !" view-as alert-box error .
      124         return .
      125      end.
      126    end.
      127   define variable var-i as integer   no-undo .
      128   define variable var-kol as integer   no-undo .
      129   var-kol = num-entries (p-rez).
      130   define buffer buf1_abc-analysis for ub.abc-analysis.
      131   define buffer buf_abc-analysis for ub.abc-analysis.
      132   define variable g-ok as logical   no-undo .
      133   define variable g1 as logical   no-undo init false  .
      134   define variable g2 as logical   no-undo init false .
      135   define variable g3 as logical   no-undo init false .
      136   define variable g4 as logical   no-undo init false .
      137   find first buf1_abc-analysis no-lock where recid(buf1_abc-analysis) = int(entry(1,p-rez )) no-error .
      138   repeat var-i = 1 to var-kol :
      139      find first buf_abc-analysis no-lock where recid(buf_abc-analysis) = int(entry(var-i,p-rez )) no-error .
      140       if buf_abc-analysis.cral-id <> buf1_abc-analysis.cral-id and g1 = false  then do:
      141           message
      142               "Есть несоответствия по критерию анализа. " skip
      143               "Продолжать сравнение ?"
      144               view-as alert-box question
      145               button yes-no
      146               update g-ok .
      147               if g-ok = false then return .
      148               else g1 = true .
      149       end.
      150       if buf_abc-analysis.abc-hash-string-obj <> buf1_abc-analysis.abc-hash-string-obj and g2 = false then do:
      151           message
      152               "Есть несоответствия по списку объектов. " skip
      153               "Продолжать сравнение ?"
      154               view-as alert-box question
      155               button yes-no
      156               update g-ok .
      157               if g-ok = false then return .
      158               else g2 = true .
      159       end.
      160       if buf_abc-analysis.abc-hash-string-doc <> buf1_abc-analysis.abc-hash-string-doc and g3 = false then do:
      161           message
      162               "Есть несоответствия по списку типов документов. " skip
      163               "Продолжать сравнение ?"
      164               view-as alert-box question
      165               button yes-no
      166               update g-ok .
      167               if g-ok = false then return .
      168               else g3 = true .
      169       end.
      170   end.
      171   define variable v-user-name as character no-undo .
      172   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      173   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      174     (input  v-cntxt-userid
      175     ,output v-user-name
      176     )  .
      177    case p-mode :
      178         when "goods" then
      179             run ref/prexabc.p  ( parParentProc , p-rez , v-user-name) no-error .
      180         when "gds" then
      181             run rep/r-abcgds.p ( parParentProc , p-rez , v-user-name) no-error .
      182         when "grp" then
      183             run rep/r-abcgrp.p ( parParentProc , p-rez , v-user-name) no-error .
      184         when "prod" then
      185             run rep/r-abcpro.p ( parParentProc , p-rez , v-user-name) no-error .
      186         when "lvl" then
      187             run rep/r-abcsec.p ( parParentProc , p-rez , int(v-lvl) , v-user-name) no-error .
      188    end case .
