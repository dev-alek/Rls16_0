     6723   PROCEDURE proc-save :
     6724   define input parameter p-save as logical no-undo .
     6725   if p-mode = 'ПРОСМОТР':U or not available tt-fin-doc then do:
     6726       return error.
     6727   end.
     6728   if ub.CashBook.CorrRko <> "" and (tt-fin-doc.cor-acc = 0 or tt-fin-doc.cor-acc = ?) then do:
     6729         for first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.code-value = ub.CashBook.CorrRko
     6730           and ub.fin-code-cor-acc.host-code = p-curr-host-code :
     6731           tt-fin-doc.cor-acc = ub.fin-code-cor-acc.fin-code .
     6732           tt-fin-doc.cor-acc-value = ub.fin-code-cor-acc.code-value .
     6733         end.
     6734   end.
     6735   else do:
     6736     if tt-fin-doc.cor-acc = ? or tt-fin-doc.cor-acc = 0 then do:
     6737     for first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.code-value = "57.01"
     6738           and ub.fin-code-cor-acc.host-code = p-curr-host-code :
     6739           tt-fin-doc.cor-acc = ub.fin-code-cor-acc.fin-code .
     6740           tt-fin-doc.cor-acc-value = ub.fin-code-cor-acc.code-value .
     6741     end.
     6742     end.
     6743   end.
     6744   if ub.CashBook.OsnAcct <> "" and (tt-fin-doc.cor-acc1 = ? or tt-fin-doc.cor-acc1 = 0) then do:
     6745         for first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.code-value = ub.CashBook.OsnAcct
     6746           and ub.fin-code-cor-acc.host-code = p-curr-host-code :
     6747           tt-fin-doc.cor-acc1 = ub.fin-code-cor-acc.fin-code .
     6748           tt-fin-doc.cor-acc1-value = ub.fin-code-cor-acc.code-value .
     6749         end.
     6750   end.
     6751   assign
     6752   tt-fin-doc.prn-doc-code frame Dialog-Frame
     6753   tt-fin-doc.doc-date
     6754   tt-fin-doc.obj-code
     6755   tt-fin-doc.obj-type
     6756   tt-fin-doc.obj-type  = (if tt-fin-doc.obj-code = 0 then "":U else tt-fin-doc.obj-type)
     6757   tt-fin-doc.payer-name
     6758   tt-fin-doc.str-podr-type
     6759   tt-fin-doc.str-podr-code
     6760   tt-fin-doc.str-podr-name
     6761   tt-fin-doc.an-uchet-code  = (if available X_fin-code-an-uchet
     6762                           then X_fin-code-an-uchet.fin-code
     6763                           else 0)
     6764   tt-fin-doc.an-uchet-value  = (if available X_fin-code-an-uchet
     6765                           then X_fin-code-an-uchet.code-value
     6766                           else "":U)
     6767   tt-fin-doc.cel-nazn-code  = (if available X_fin-code-cel-nazn
     6768                          then X_fin-code-cel-nazn.fin-code
     6769                          else 0)
     6770   tt-fin-doc.cel-nazn-value  = (if available X_fin-code-cel-nazn
     6771                          then X_fin-code-cel-nazn.code-value
     6772                          else "":U)
     6773   tt-fin-doc.curr-code
     6774   tt-fin-doc.contract-curr
     6775   tt-fin-doc.contract-rate
     6776   tt-fin-doc.contract-scale
     6777   tt-fin-doc.sum-doc
     6778   tt-fin-doc.receiver-code
     6779   tt-fin-doc.receiver-type
     6780   tt-fin-doc.receiver-name
     6781   tt-fin-doc.naznach-plat = clean_char(tt-fin-doc.naznach-plat:screen-value)
     6782   tt-fin-doc.receiver-passport = clean_char(tt-fin-doc.receiver-passport:screen-value)
     6783   tt-fin-doc.enclosure = clean_char(tt-fin-doc.enclosure:screen-value)
     6784   tt-fin-doc.PS = clean_char(tt-fin-doc.PS:screen-value)
     6785   tt-fin-doc.payer-sign1
     6786   tt-fin-doc.payer-sign1  =   v-head-position + chr(4) + tt-fin-doc.payer-sign1
     6787   tt-fin-doc.payer-sign2
     6788   tt-fin-doc.payer-sign3
     6789   tt-fin-doc.doc-author = (if p-mode = 'ДОБАВЛЕНИЕ':U then 'manual':U else tt-fin-doc.doc-author)
     6790   .
     6791   if not p-save then return.
     6792   run check-sums-rate in this-procedure no-error.
     6793   if error-status:error then return error.
     6794      find first buf_clients-attr no-lock where buf_clients-attr.attr-code = 'is-inkassator':U and
     6795         buf_clients-attr.obj-code = tt-fin-doc.receiver-code and
     6796         buf_clients-attr.obj-code = tt-fin-doc.receiver-code no-error .
     6797      if available (buf_clients-attr) then
     6798      do:
     6799         find first bf_fin-doc-attr exclusive-lock where bf_fin-doc-attr.attr-code = "pre-vedom" and bf_fin-doc-attr.host-code = p-host-code
     6800            and bf_fin-doc-attr.fin-doc-code = tt-fin-doc.fin-doc-code and bf_fin-doc-attr.attr-value <> "" no-error .
     6801         if not available (bf_fin-doc-attr) then
     6802         do:
     6803            message "Для данного получателя нет № Препроводительной ведомости, сохранение невозможно" view-as alert-box error .
     6804            undo, return error .
     6805     end.
     6806   end.
     6807   run ref/findoc0.p (
     6808   input-output p-doc-rec
     6809          ,input p-mode
     6810          ,input no
     6811          ,input tt-fin-doc.host-code            ,input tt-fin-doc.fin-doc-code         ,input tt-fin-doc.an-uchet-code        ,input tt-fin-doc.an-uchet-value       ,input tt-fin-doc.base-rate            ,input tt-fin-doc.base-scale           ,input tt-fin-doc.cel-nazn-code        ,input tt-fin-doc.cel-nazn-value       ,input tt-fin-doc.contract-code        ,input tt-fin-doc.contract-curr        ,input tt-fin-doc.contract-rate        ,input tt-fin-doc.contract-scale       ,input tt-fin-doc.cor-acc              ,input tt-fin-doc.cor-acc-value        ,input tt-fin-doc.cor-acc1             ,input tt-fin-doc.cor-acc1-value       ,input tt-fin-doc.curr-code            ,input tt-fin-doc.doc-date             ,input tt-fin-doc.shift-date           ,input tt-fin-doc.shift-num            ,input tt-fin-doc.shift-name           ,input tt-fin-doc.enclosure            ,input tt-fin-doc.exch-rate            ,input tt-fin-doc.exch-scale           ,input tt-fin-doc.f104                 ,input tt-fin-doc.f105                 ,input tt-fin-doc.f106                 ,input tt-fin-doc.f107                 ,input tt-fin-doc.f108                 ,input tt-fin-doc.f109                 ,input tt-fin-doc.f110                 ,input tt-fin-doc.f22                  ,input tt-fin-doc.f23                  ,input tt-fin-doc.fact-date            ,input tt-fin-doc.fin-doc-type         ,input tt-fin-doc.fin-ext-doc-type     ,input tt-fin-doc.in-doc-code          ,input tt-fin-doc.in-host-code         ,input tt-fin-doc.including            ,input tt-fin-doc.nazn-pl              ,input tt-fin-doc.naznach-plat         ,input tt-fin-doc.ocher-pl             ,input tt-fin-doc.out-doc-code         ,input tt-fin-doc.out-host-code        ,input tt-fin-doc.pay-date             ,input tt-fin-doc.payer-bank-name      ,input tt-fin-doc.payer-bank-city      ,input tt-fin-doc.payer-bik            ,input tt-fin-doc.payer-c-schet        ,input tt-fin-doc.payer-code           ,input tt-fin-doc.payer-code-schet     ,input tt-fin-doc.payer-dop1           ,input tt-fin-doc.payer-dop2           ,input tt-fin-doc.payer-inn            ,input tt-fin-doc.payer-kpp            ,input tt-fin-doc.payer-name           ,input tt-fin-doc.payer-okpo           ,input tt-fin-doc.payer-passport      ,input tt-fin-doc.payer-r-schet        ,input tt-fin-doc.payer-type           ,input tt-fin-doc.perm-date            ,input tt-fin-doc.prn-doc-code         ,input tt-fin-doc.PS                   ,input tt-fin-doc.receiver-bank-name   ,input tt-fin-doc.receiver-bank-city   ,input tt-fin-doc.receiver-bik         ,input tt-fin-doc.receiver-c-schet     ,input tt-fin-doc.receiver-code        ,input tt-fin-doc.receiver-code-schet  ,input tt-fin-doc.receiver-dop1        ,input tt-fin-doc.receiver-dop2        ,input tt-fin-doc.receiver-inn         ,input tt-fin-doc.receiver-kpp         ,input tt-fin-doc.receiver-name        ,input tt-fin-doc.receiver-okpo        ,input tt-fin-doc.receiver-passport    ,input tt-fin-doc.receiver-r-schet     ,input tt-fin-doc.receiver-type        ,input tt-fin-doc.srok-pl              ,input tt-fin-doc.stat-pl              ,input tt-fin-doc.str-podr-code        ,input tt-fin-doc.str-podr-type        ,input tt-fin-doc.str-podr-name        ,input tt-fin-doc.sum-base             ,input tt-fin-doc.sum-doc              ,input tt-fin-doc.sum-rubl             ,input tt-fin-doc.sum-contr            ,input tt-fin-doc.trn-doc-code         ,input tt-fin-doc.vid-opl              ,input tt-fin-doc.vid-plat
     6812          ,input tt-fin-doc.con-sum-rubl         ,input tt-fin-doc.con-sum-base         ,input tt-fin-doc.con-sum-doc          ,input tt-fin-doc.con-sum-contr        ,input tt-fin-doc.con-stat             ,input tt-fin-doc.payer-sign1                ,input tt-fin-doc.payer-sign2                ,input tt-fin-doc.payer-sign3                ,input tt-fin-doc.payer-sign4                ,input tt-fin-doc.receiver-sign1                ,input tt-fin-doc.receiver-sign2                ,input tt-fin-doc.receiver-sign3                ,input tt-fin-doc.receiver-sign4                ,input tt-fin-doc.obj-type                   ,input tt-fin-doc.obj-code                   ,input tt-fin-doc.doc-author                 ,input tt-fin-doc.fact-author                ,input tt-fin-doc.CashBookId
     6813          ,input table tt0-fin-doc-tax
     6814          ,input table tt0-fin-doc-attr
     6815          ,input no
     6816          ,input table tt0-payment
     6817   ) no-error.
     6818   if error-status:error then do:
     6819   define variable vss-include-info62 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6820   define variable fh as widget-handle no-undo .
     6821   define variable hh as widget-handle no-undo .
     6822   define variable rv as character no-undo .
     6823   assign
     6824   rv = entry(1, return-value , chr(4)).
     6825   if rv <> "":U then do:
     6826     assign
     6827     fh = frame Dialog-Frame:first-child
     6828     hh = fh:first-child
     6829     .
     6830     do while valid-handle(hh):
     6831       if hh:name = rv then do:
     6832         APPLY "ENTRY" to hh.
     6833         undo ,
     6834         return error.
     6835       end.
     6836       hh = hh:next-sibling.
     6837     end.
     6838   end.
     6839     undo, return error.
     6840   end.
     6841   if p-mode eq 'ДОБАВЛЕНИЕ':U
     6842   then
     6843      run update_prc-doc-code-mask(yes).
     6844   END PROCEDURE.
     6845   PROCEDURE update_prc-doc-code-mask :
     6846   define variable vCashBook as class ibs.th.ref.cashbookstorage no-undo.
     6847     define input  parameter IFlagSave as logical no-undo.
     6848     define variable vMask     as character no-undo.
     6849     define variable v-key     as character no-undo.
     6850     define variable vValue    as character no-undo.
     6851     if tt-fin-doc.prn-doc-code:screen-value in frame Dialog-Frame ne "" and IFlagSave
     6852     then
     6853        if tt-fin-doc.prn-doc-code:screen-value in frame Dialog-Frame ne mprn-doc-code-old
     6854        then do:
     6855           return.
     6856        end.
     6857     vCashBook = new ibs.th.ref.cashbookstorage () .
     6858     vmask = vCashBook:getSinglRule(tt-fin-doc.cashbookId, p-obj-type,p-obj-code, "RkoMask") .
     6859     MParam = if vCashBook:getSinglRule(tt-fin-doc.cashbookId, p-obj-type,p-obj-code, "uchet") eq "1"
     6860              then "year," + string(year(tt-fin-doc.shift-date))
     6861              else "".
     6862     delete object vCashBook no-error .
     6863     if vmask > ""
     6864     then.
     6865     else vmask = "[NNNN]/[obj-code]" .
     6866     find first ub.CashBookRule exclusive-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     6867                                                 and ub.CashBookRule.Obj-type = p-obj-type
     6868                                                 and ub.CashBookRule.Obj-code = p-obj-code
     6869                                              and ub.CashBookRule.Code = "currRko"
     6870                                              no-error .
     6871     if not available ub.CashBookRule
     6872     then do :
     6873        create ub.CashBookRule .
     6874        assign
     6875           ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     6876           ub.CashBookRule.Obj-type = p-obj-type
     6877           ub.CashBookRule.Obj-code = p-obj-code
     6878           ub.CashBookRule.Code = "currRko"
     6879           ub.CashBookRule.Status_ = 0
     6880           ub.CashBookRule.RuleValue = "1"
     6881        .
     6882         end.
     6883         run gen-key-rec in this-procedure ( input 'CashBookRule':U
     6884                                            ,input (buffer CashBookRule:handle)
     6885                                            ,output v-key).
     6886     subscribe   to "getCounter" anywhere run-procedure if IFlagSave then "Mycounternext" else "MycounterCurr".
     6887     assign
     6888           current-pko-rko = "currRKO"
     6889           current-ruleID = v-key
     6890         .
     6891         run utl/maskproc.p(parparentproc, vmask, "cashbook", tt-fin-doc.cashbookId,  output vValue).
     6892         mprn-doc-code-old =  vValue.
     6893         tt-fin-doc.prn-doc-code = vValue.
     6894         display  tt-fin-doc.prn-doc-code with frame Dialog-Frame.
     6895      unsubscribe to "getCounter".
     6896   end procedure.
     6897   PROCEDURE MycounterCurr :
     6898   define input  parameter iFileName as character no-undo.
     6899   define input  parameter ikey      as character no-undo.
     6900   define input  parameter icode     as character no-undo.
     6901   define output parameter oCount    as int64 no-undo.
     6902    define variable mCounterStor as class ibs.th.ref.counter.counterstorage.
     6903    mCounterStor = new ibs.th.ref.counter.counterstorage().
     6904    oCount = mCounterStor:GetCountValue(G#db-num,"cashbookrule", current-ruleID, current-pko-rko ) + 1.
     6905    delete object mCounterStor.
     6906   end procedure.
     6907   PROCEDURE MycounterNext :
     6908   define input  parameter iFileName as character no-undo.
     6909   define input  parameter ikey      as character no-undo.
     6910   define input  parameter icode     as character no-undo.
     6911   define output parameter oCount    as int64 no-undo.
     6912    run utl/getnextcount.p ("cashbookrule", current-ruleID, current-pko-rko, MParam ,output oCount    ).
     6913   end procedure.
