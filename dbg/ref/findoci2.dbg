      893   DEF VAR GREY_COLOR         AS INTEGER NO-UNDO INIT  8.
      894   DEF VAR BLUE_COLOR         AS INTEGER NO-UNDO INIT  9.
      895   DEF VAR GREEN_COLOR        AS INTEGER NO-UNDO INIT 10.
      896   DEF VAR RED_COLOR          AS INTEGER NO-UNDO INIT 12.
      897   DEF VAR LIGHT_RED_COLOR    AS INTEGER NO-UNDO INIT 13.
      898   DEF VAR YELLOW_COLOR       AS INTEGER NO-UNDO INIT 14.
      899   DEF VAR WHITE_COLOR        AS INTEGER NO-UNDO INIT 15.
      900   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      901     define variable v-cntxt-db-num        as integer   no-undo .
      902     define variable v-cntxt-userid        as character no-undo .
      903     define variable v-cntxt-level         as character no-undo .
      904     define variable v-cntxt-host-code-obj as integer   no-undo .
      905     define variable v-cntxt-obj-type      as character no-undo .
      906     define variable v-cntxt-obj-code      as integer   no-undo .
      907     define variable v-cntxt-db-num-obj    as integer   no-undo .
      908     define variable v-cntxt-is-admin      as logical   no-undo .
      909   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      910   function usrfulnf returns character ( input p-user-id as character):
      911   define variable v-user-name as character no-undo .
      912   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      913   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      914     (input  p-user-id
      915     ,output v-user-name
      916     ) no-error .
      917   if error-status:error
      918   or v-user-name = ""
      919   then do:
      920     return p-user-id.
      921   end.
      922   else do:
      923     return v-user-name.
      924   end.
      925   end function.
      926   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      927   procedure gen-key-rec :
      928     define input  parameter p-tbl-name    as character no-undo.
      929     define input  parameter p-bh_tbl-name as handle    no-undo.
      930     define output parameter p-key-rec     as character no-undo.
      931     do
      932     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      933     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      934     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      935     :
      936       define variable fh               as handle    no-undo .
      937       define variable v-ok             as logical   no-undo .
      938       define variable v-inform         as character no-undo .
      939       define variable v-ind            as integer   no-undo .
      940       define variable v-idx-field-qnty as integer   no-undo .
      941       if p-tbl-name = ?
      942         or p-tbl-name = "":U
      943       then do:
      944         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info7 ).
      945       end.
      946       if not p-bh_tbl-name:available then do:
      947         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info7, p-tbl-name ).
      948       end.
      949       assign
      950         p-key-rec = p-tbl-name
      951         v-inform  = p-bh_tbl-name:index-information(1)
      952         v-ind     = 2
      953       .
      954       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      955       on error undo, return error
      956       :
      957         assign
      958           v-inform = p-bh_tbl-name:index-information( v-ind )
      959           v-ind    = v-ind + 1
      960         .
      961       end.
      962       if v-inform = ?
      963         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      964         or entry( 3, v-inform, ",":U ) <> "1":U
      965       then do:
      966         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, p-tbl-name ).
      967       end.
      968       else do:
      969         assign
      970           v-idx-field-qnty = num-entries( v-inform ) - 4
      971         .
      972         if v-idx-field-qnty < 2 then do:
      973           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, p-tbl-name ).
      974         end.
      975         do v-ind = 1 to v-idx-field-qnty by 2
      976         on error undo, return error
      977         :
      978           assign
      979             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      980             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      981           .
      982         end.
      983       end.
      984       if p-key-rec = ? then do:
      985         assign
      986           p-key-rec = "":U
      987         .
      988         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info7, p-tbl-name ).
      989       end.
      990     end.
      991     return.
      992   end procedure.
      993   procedure gen-where-keyr-tab :
      994     define input  parameter i-tableSerach as character no-undo.
      995     define input  parameter i-tablekey   as character  no-undo.
      996     define input  parameter p-key-rec    as character  no-undo.
      997     define input  parameter p-key-handle as handle     no-undo .
      998     define input  parameter p-db-name    as character  no-undo .
      999     define input  parameter p-tt-handle  as handle     no-undo .
     1000     define output parameter o-Where      as character  no-undo.
     1001     do
     1002     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1003     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1004     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1005     :
     1006       define variable v-full-tbl-name  as character no-undo .
     1007       define variable bh_tbl-name      as handle    no-undo .
     1008       define variable fh_key           as handle    no-undo .
     1009       define variable fh_search        as handle    no-undo .
     1010       define variable v-field-num      as integer   no-undo .
     1011       define variable v-count-fld      as integer   no-undo .
     1012       define variable v-inform         as character no-undo .
     1013       define variable v-ind            as integer   no-undo .
     1014       define variable v-idx-field-qnty as integer   no-undo .
     1015       define variable v-field-name     as character no-undo .
     1016       define variable v-field-val      as character no-undo .
     1017       define variable v-word-link      as character no-undo .
     1018       define variable vTable           as character no-undo.
     1019       define variable bh_tbl-key       as handle    no-undo .
     1020       assign
     1021         p-key-rec = trim( p-key-rec )
     1022       .
     1023       if p-key-handle <> ? then do:
     1024         if not valid-handle(p-key-handle)
     1025            or p-key-handle:type <> "buffer"
     1026         then do:
     1027           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info7 ).
     1028         end.
     1029         if num-entries( p-key-rec, chr(3) ) > 1
     1030           or p-key-rec = ?
     1031           or p-key-rec = "":U
     1032         then do:
     1033           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info7, p-key-rec ).
     1034         end.
     1035       end.
     1036       else do:
     1037         if p-key-rec = ?
     1038           or p-key-rec = "":U
     1039         then do:
     1040           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info7 ).
     1041         end.
     1042       end.
     1043       assign
     1044         vTable = entry( 1 , p-key-rec, chr(3) )
     1045       .
     1046       if p-tt-handle <> ?
     1047         and ( not valid-handle(p-tt-handle)
     1048               or p-tt-handle:type <> "buffer"
     1049             )
     1050       then do:
     1051         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info7, vTable, chr(10) ).
     1052       end.
     1053       if p-tt-handle = ? then do:
     1054         assign
     1055           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1056         .
     1057         create buffer bh_tbl-name for table v-full-tbl-name .
     1058       end.
     1059       else do:
     1060         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1061       end.
     1062       assign
     1063         v-inform = bh_tbl-name:index-information(1)
     1064         v-ind    = 2
     1065       .
     1066       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1067       on error undo, return error
     1068       :
     1069         assign
     1070           v-inform = bh_tbl-name:index-information( v-ind )
     1071           v-ind    = v-ind + 1
     1072         .
     1073       end.
     1074       if v-inform = ?
     1075         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1076         or entry( 3, v-inform, ",":U ) <> "1":U
     1077       then do:
     1078         delete object bh_tbl-name no-error.
     1079         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info7, vTable ).
     1080       end.
     1081       assign
     1082         v-idx-field-qnty = num-entries( v-inform ) - 4
     1083       .
     1084       if v-idx-field-qnty < 2 then do:
     1085         delete object bh_tbl-name no-error.
     1086         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, vTable ).
     1087       end.
     1088       assign
     1089         o-where     = "where":U
     1090         v-word-link = "":U
     1091         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1092         v-count-fld = 0
     1093       .
     1094       if i-tablekey ne "" and i-tablekey ne ?
     1095       then do:
     1096         assign
     1097           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1098         .
     1099         create buffer bh_tbl-key for table v-full-tbl-name .
     1100       end.
     1101       if i-tableSerach ne "" and i-tableSerach ne ?
     1102       then do:
     1103         delete object bh_tbl-name no-error.
     1104         assign
     1105           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1106         .
     1107         create buffer bh_tbl-name for table v-full-tbl-name .
     1108       end.
     1109       block_where:
     1110       do v-ind = 1 to v-idx-field-qnty by 2
     1111       on error undo, return error
     1112       :
     1113         assign
     1114           v-count-fld = v-count-fld + 1
     1115         .
     1116         if p-key-handle = ?
     1117           and v-count-fld > v-field-num
     1118         then do:
     1119           leave block_where.
     1120         end.
     1121         define variable VfieldKeyTable as handle no-undo.
     1122         assign
     1123           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1124           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1125         .
     1126         if     bh_tbl-key ne ?
     1127         then do:
     1128            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1129            if VfieldKeyTable eq ?
     1130            then next block_where.
     1131         end.
     1132         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1133         then
     1134            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1135         else
     1136            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1137         if p-key-handle = ? then do:
     1138           assign
     1139             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1140           .
     1141         end.
     1142         else do:
     1143           assign
     1144             fh_key = p-key-handle:buffer-field( v-field-name )
     1145           .
     1146           if fh_key = ?
     1147             or not valid-handle( fh_key )
     1148           then do:
     1149             delete object bh_tbl-name.
     1150             if     bh_tbl-key ne ?
     1151             then
     1152                delete object bh_tbl-key.
     1153             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info7, p-key-handle:name, v-field-name ).
     1154           end.
     1155           assign
     1156             v-field-val = fh_key:buffer-value
     1157           .
     1158         end.
     1159         if fh_search:data-type ="character":U then do:
     1160           assign
     1161             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1162             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1163             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1164             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1165             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1166             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1167             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1168             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1169             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1170             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1171             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1172             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1173             v-field-val = substitute( '"&1"', v-field-val )
     1174           .
     1175         end.
     1176         assign
     1177           o-where = substitute( "&1 &2", o-where, v-field-val )
     1178         .
     1179         if v-word-link = "":U then do:
     1180           assign
     1181             v-word-link = "and":U
     1182           .
     1183         end.
     1184       end.
     1185       delete object bh_tbl-name.
     1186       if     bh_tbl-key ne ?
     1187       then
     1188          delete object bh_tbl-key.
     1189       if p-key-handle = ?
     1190         and v-count-fld <> v-field-num
     1191       then do:
     1192         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info7, vTable ).
     1193       end.
     1194     end.
     1195   end procedure.
     1196   procedure gen-hn-keyr-tab :
     1197     define input  parameter i-tableSerach as character no-undo.
     1198     define input  parameter i-tablekey   as character no-undo.
     1199     define input  parameter p-key-rec    as character no-undo.
     1200     define input  parameter p-key-handle as handle    no-undo .
     1201     define input  parameter p-db-name    as character no-undo .
     1202     define input  parameter p-tt-handle  as handle    no-undo .
     1203     define input  parameter p-stts-lock  as integer   no-undo .
     1204     define output parameter o-hn         as handle    no-undo.
     1205     define variable v-full-tbl-name as character no-undo.
     1206     define variable v-where         as character no-undo.
     1207     define variable bh_tbl-name     as handle    no-undo.
     1208     define variable vTable          as character no-undo.
     1209     do
     1210     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1211     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1212     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1213         run gen-where-keyr-tab(i-tableSerach,
     1214                                i-tablekey,
     1215                                p-key-rec,
     1216                                p-key-handle,
     1217                                p-db-name,
     1218                                p-tt-handle,
     1219                                output v-where).
     1220         if i-tableSerach ne "" and i-tableSerach ne ?
     1221         then do:
     1222            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1223            create buffer bh_tbl-name for table v-full-tbl-name .
     1224         end.
     1225         else do:
     1226            if p-tt-handle = ? then do:
     1227               assign
     1228                  vTable = entry( 1 , p-key-rec, chr(3) )
     1229               .
     1230               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1231               create buffer bh_tbl-name for table v-full-tbl-name .
     1232            end.
     1233            else do:
     1234               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1235            end.
     1236         end.
     1237         if p-tt-handle = ? then do:
     1238            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1239         end.
     1240         else do:
     1241            bh_tbl-name:find-first( v-where ) no-error .
     1242         end.
     1243         o-hn = bh_tbl-name.
     1244      end.
     1245   end procedure.
     1246   procedure gen-hn-keyr :
     1247     define input  parameter p-key-rec    as character no-undo.
     1248     define input  parameter p-key-handle as handle    no-undo .
     1249     define input  parameter p-db-name    as character no-undo .
     1250     define input  parameter p-tt-handle  as handle    no-undo .
     1251     define input  parameter p-stts-lock  as integer   no-undo .
     1252     define output parameter o-hn         as handle    no-undo.
     1253     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1254   end.
     1255   procedure gen-row-keyr :
     1256     define input  parameter p-key-rec    as character no-undo.
     1257     define input  parameter p-key-handle as handle    no-undo .
     1258     define input  parameter p-db-name    as character no-undo .
     1259     define input  parameter p-tt-handle  as handle    no-undo .
     1260     define input  parameter p-stts-lock  as integer   no-undo .
     1261     define output parameter p-tbl-row    as rowid     no-undo.
     1262     define output parameter p-tbl-name   as character no-undo.
     1263     define variable vHn as handle no-undo.
     1264       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1265       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1266       p-tbl-name =  vHn:table.
     1267       delete object vHn no-error.
     1268     if p-tbl-row = ? then do:
     1269       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info7, p-tbl-name, p-key-rec ).
     1270     end.
     1271     else do:
     1272       return.
     1273     end.
     1274   end procedure.
     1275   procedure gen-key-fv :
     1276     define input  parameter p-key-rec    as character no-undo .
     1277     define output parameter p-field-list as character no-undo .
     1278     define output parameter p-value-list as character no-undo.
     1279     do
     1280     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1281     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1282     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1283     :
     1284       define variable v-full-tbl-name  as character no-undo .
     1285       define variable bh_tbl-name      as handle    no-undo .
     1286       define variable v-tbl-name       as character no-undo .
     1287       define variable v-field-num      as integer   no-undo .
     1288       define variable v-count-fld      as integer   no-undo .
     1289       define variable v-inform         as character no-undo .
     1290       define variable v-ind            as integer   no-undo .
     1291       define variable v-idx-field-qnty as integer   no-undo .
     1292       define variable v-delim-key      as character no-undo .
     1293       if p-key-rec = ?
     1294         or p-key-rec = "":U
     1295       then do:
     1296         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info7 ).
     1297       end.
     1298       assign
     1299         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1300         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1301       .
     1302       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1303       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info7 ).
     1304       assign
     1305         v-inform = bh_tbl-name:index-information(1)
     1306         v-ind    = 2
     1307       .
     1308       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1309       on error undo, return error
     1310       :
     1311         assign
     1312           v-inform = bh_tbl-name:index-information( v-ind )
     1313           v-ind    = v-ind + 1
     1314         .
     1315       end.
     1316       if v-inform = ?
     1317         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1318         or entry( 3, v-inform, ",":U ) <> "1":U
     1319       then do:
     1320         delete object bh_tbl-name no-error.
     1321         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, v-tbl-name ).
     1322       end.
     1323       assign
     1324         v-idx-field-qnty = num-entries( v-inform ) - 4
     1325       .
     1326       if v-idx-field-qnty < 2 then do:
     1327         delete object bh_tbl-name no-error.
     1328         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, v-tbl-name ).
     1329       end.
     1330       assign
     1331         p-field-list = "":U
     1332         p-value-list = "":U
     1333         v-delim-key  = "":U
     1334         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1335         v-count-fld  = 0
     1336       .
     1337       block_where:
     1338       do v-ind = 1 to v-idx-field-qnty by 2
     1339       on error undo, return error
     1340       :
     1341         assign
     1342           v-count-fld = v-count-fld + 1
     1343         .
     1344         if v-count-fld > v-field-num then do:
     1345           leave block_where.
     1346         end.
     1347         assign
     1348           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1349           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1350         .
     1351         if v-ind = 1 then do:
     1352           assign
     1353             v-delim-key = chr(3)
     1354           .
     1355         end.
     1356       end.
     1357       delete object bh_tbl-name.
     1358       if v-count-fld <> v-field-num then do:
     1359         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info7, v-tbl-name ).
     1360       end.
     1361     end.
     1362   end procedure.
     1363   procedure gen-key-field :
     1364     define input  parameter p-table      as character no-undo .
     1365     define output parameter p-field-list as character no-undo .
     1366     do
     1367     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1368     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1369     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1370     :
     1371       define variable v-full-tbl-name  as character no-undo .
     1372       define variable bh_tbl-name      as handle    no-undo .
     1373       define variable v-tbl-name       as character no-undo .
     1374       define variable v-field-num      as integer   no-undo .
     1375       define variable v-count-fld      as integer   no-undo .
     1376       define variable v-inform         as character no-undo .
     1377       define variable v-ind            as integer   no-undo .
     1378       define variable v-idx-field-qnty as integer   no-undo .
     1379       define variable v-delim-key      as character no-undo .
     1380       if p-table = ?
     1381         or p-table = "":U
     1382       then do:
     1383         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info7 ).
     1384       end.
     1385       assign
     1386         v-tbl-name      = p-table
     1387         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1388       .
     1389       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1390       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info7 ).
     1391       assign
     1392         v-inform = bh_tbl-name:index-information(1)
     1393         v-ind    = 2
     1394       .
     1395       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1396       on error undo, return error
     1397       :
     1398         assign
     1399           v-inform = bh_tbl-name:index-information( v-ind )
     1400           v-ind    = v-ind + 1
     1401         .
     1402       end.
     1403       if v-inform = ?
     1404         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1405         or entry( 3, v-inform, ",":U ) <> "1":U
     1406       then do:
     1407         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, v-tbl-name ).
     1408       end.
     1409       assign
     1410         v-idx-field-qnty = num-entries( v-inform ) - 4
     1411       .
     1412       if v-idx-field-qnty < 2 then do:
     1413         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, v-tbl-name ).
     1414       end.
     1415       assign
     1416         p-field-list = "":U
     1417         v-delim-key  = "":U
     1418         v-count-fld  = 0
     1419       .
     1420       block_where:
     1421       do v-ind = 1 to v-idx-field-qnty by 2
     1422       on error undo, return error
     1423       :
     1424         assign
     1425           v-count-fld = v-count-fld + 1
     1426         .
     1427         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1428         if v-ind = 1 then do:
     1429           assign
     1430             v-delim-key = chr(3)
     1431           .
     1432         end.
     1433       end.
     1434       delete object bh_tbl-name.
     1435     end.
     1436   end procedure.
     1437   function getCliKassa returns logical (input p-type as character, input p-code as integer, input p-attr as character, cashbookId as integer) :
     1438   define buffer bf_CashBookRule  for ub.CashBookRule .
     1439   define buffer buf_CashBookRule for ub.CashBookRule .
     1440   find first bf_CashBookRule no-lock where bf_CashBookRule.CashBookID = cashbookId
     1441     and bf_CashBookRule.Obj-type   = 'всем':U
     1442     and bf_CashBookRule.Obj-code   = 0
     1443     and bf_CashBookRule.Code       = p-attr + "-type"
     1444     no-error.
     1445   if available (bf_CashBookRule) then
     1446   do:
     1447     if p-type = bf_CashBookRule.RuleValue then
     1448     do:
     1449       find first buf_CashBookRule no-lock where buf_CashBookRule.CashBookID = cashbookId
     1450         and buf_CashBookRule.Obj-type   = 'всем':U
     1451         and buf_CashBookRule.Obj-code   = 0
     1452         and buf_CashBookRule.Code       = p-attr + "-code"
     1453         no-error.
     1454       if available (buf_CashBookRule) then do:
     1455           if p-code = integer(buf_CashBookRule.RuleValue) then return true .
     1456       end.
     1457     end.
     1458   end.
     1459   return false .
     1460   end function .
     1461   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile: findocip.i $ $Revision: ff8019e24d02, 2996, rls $".
     1462   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1463   procedure cur-time :
     1464      define output parameter p-today as date      no-undo .
     1465      define output parameter p-time  as integer   no-undo .
     1466     do
     1467     on error undo, return error
     1468     :
     1469       define variable v-date1 as date      no-undo .
     1470       define variable v-date2 as date      no-undo .
     1471       define variable v-time  as integer   no-undo .
     1472       assign
     1473         v-date1 = today
     1474         v-time  = time
     1475         v-date2 = today
     1476       .
     1477       if v-date1 <> v-date2
     1478       then do:
     1479         assign
     1480           v-date1 = today
     1481           v-time  = v-time
     1482         .
     1483       end.
     1484       assign
     1485         p-today = v-date1
     1486         p-time  = v-time
     1487       .
     1488     end.
     1489   end.
     1490   function cur-time-date returns character
     1491   :
     1492     return string(today, '99/99/9999':U) .
     1493   end.
     1494   function cur-time-mjd returns decimal
     1495   :
     1496     define variable v-date as date      no-undo .
     1497     define variable v-time as integer   no-undo .
     1498     run cur-time in this-procedure
     1499       (output v-date
     1500       ,output v-time
     1501       ) .
     1502     return integer(v-date) - 2400002 + (v-time / 86400) .
     1503   end.
     1504   function cur-time-get-ending-index returns integer
     1505   (input p-number as integer
     1506   )
     1507   :
     1508     if p-number < 0
     1509     or p-number = ?
     1510     then do:
     1511       return 1 .
     1512     end.
     1513     define variable v-rest as integer   no-undo .
     1514     assign
     1515       p-number = p-number modulo 100
     1516     .
     1517     if p-number < 20
     1518     then do:
     1519       assign
     1520         v-rest = p-number
     1521       .
     1522     end.
     1523     else do:
     1524       assign
     1525         v-rest = p-number modulo 10
     1526       .
     1527     end.
     1528     case v-rest :
     1529       when 1
     1530       then do:
     1531         return 2 .
     1532       end.
     1533       when 2 or
     1534       when 3 or
     1535       when 4
     1536       then do:
     1537         return 3 .
     1538       end.
     1539       otherwise do:
     1540         return 1 .
     1541       end.
     1542     end case .
     1543   end.
     1544   procedure cur-time-mjd-to-date :
     1545      define input  parameter i-mjd-diff as decimal no-undo.
     1546      define output parameter o-Date     as date    no-undo.
     1547      define output parameter o-Time     as integer no-undo.
     1548      define variable v-day-number as integer   no-undo .
     1549      if    i-mjd-diff < 0
     1550         or i-mjd-diff = ?
     1551      then do:
     1552         return "?" .
     1553      end.
     1554      assign
     1555         v-day-number = truncate(i-mjd-diff,0).
     1556         o-Date = date(v-day-number + 2400002).
     1557         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1558     .
     1559   end.
     1560   function cur-time-mjd-to-string returns character
     1561   (input p-mjd-diff as decimal
     1562   )
     1563   :
     1564     define variable v-day-number as integer   no-undo .
     1565     define variable v-seconds    as integer   no-undo .
     1566     define variable v-hour       as integer   no-undo .
     1567     define variable v-min        as integer   no-undo .
     1568     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1569     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1570     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1571     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1572     if p-mjd-diff < 0
     1573     or p-mjd-diff = ?
     1574     then do:
     1575       return "?" .
     1576     end.
     1577     assign
     1578       v-day-number = integer(truncate(p-mjd-diff,0))
     1579       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1580     .
     1581     if v-seconds > 86400
     1582     then do:
     1583       assign
     1584         v-seconds = 86400 - 1
     1585       .
     1586     end.
     1587     if v-seconds < 0
     1588     then do:
     1589       assign
     1590         v-seconds = 0
     1591       .
     1592     end.
     1593     assign
     1594       v-hour = truncate(v-seconds / 3600, 0)
     1595     .
     1596     assign
     1597       v-seconds = v-seconds modulo 3600
     1598     .
     1599     assign
     1600       v-min = truncate(v-seconds / 60, 0)
     1601     .
     1602     assign
     1603       v-seconds = v-seconds modulo 60
     1604     .
     1605     return
     1606         (if v-day-number <> 0
     1607           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1608           else ""
     1609         )
     1610       + (if v-day-number <> 0 or v-hour <> 0
     1611           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1612           else ""
     1613         )
     1614       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1615           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1616           else ""
     1617         )
     1618       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1619       .
     1620   end.
     1621   function cur-time-string returns character
     1622   :
     1623     define variable v-date as date      no-undo .
     1624     define variable v-time as integer   no-undo .
     1625     run cur-time in this-procedure
     1626       (output v-date
     1627       ,output v-time
     1628       ) .
     1629     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1630   end.
     1631   function cur-time-string-sec returns character
     1632   :
     1633     define variable v-date as date      no-undo .
     1634     define variable v-time as integer   no-undo .
     1635     run cur-time in this-procedure
     1636       (output v-date
     1637       ,output v-time
     1638       ) .
     1639     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1640   end.
     1641   function cur-time-custom  returns character
     1642   (input p-prefix as character
     1643   ,input p-date-format as character
     1644   ,input p-delimiter as character
     1645   ,input p-time-format as character
     1646   ,input p-suffix as character
     1647   )
     1648   :
     1649     define variable v-date as date      no-undo .
     1650     define variable v-time as integer   no-undo .
     1651     run cur-time in this-procedure
     1652       (output v-date
     1653       ,output v-time
     1654       ) .
     1655     return
     1656       p-prefix
     1657       + string(v-date, p-date-format)
     1658       + p-delimiter
     1659       + string(v-time, p-time-format)
     1660       + p-suffix
     1661       .
     1662   end.
     1663   function cur-time-print  returns character
     1664   :
     1665     define variable v-date as date      no-undo .
     1666     define variable v-time as integer   no-undo .
     1667     run cur-time in this-procedure
     1668       (output v-date
     1669       ,output v-time
     1670       ) .
     1671     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1672   end.
     1673   function cur-time-datetime returns datetime
     1674   :
     1675     define variable v-char as character no-undo .
     1676     define variable v-datetime as datetime no-undo .
     1677     v-char = cur-time-string().
     1678     v-datetime = datetime(v-char).
     1679     return  v-datetime.
     1680   end.
     1681   function cur-time-string-msec returns character
     1682   :
     1683     define variable v-date as datetime  no-undo .
     1684     v-date = now.
     1685     return string(v-date) .
     1686   end.
     1687   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1688   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1689   define new global shared variable g#attr-lib  as handle no-undo .
     1690   define variable v-attr-lib-variable as handle no-undo .
     1691   define variable v-is-auto-obj as logical no-undo .
     1692   define variable v-start       as integer no-undo .
     1693   define variable v-first-start as logical no-undo init yes.
     1694   assign
     1695     v-start = (if p-mode = 'ДОБАВЛЕНИЕ':U then 2 else 1)
     1696     .
     1697   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1698   procedure fd-attr-code :
     1699     do
     1700     on error undo, return error
     1701     :
     1702       define input  parameter p-code           as character no-undo .
     1703       define output parameter p-type           as character no-undo .
     1704       define output parameter p-format         as character no-undo .
     1705       define output parameter p-label          as character no-undo .
     1706       define output parameter p-user-can-edit  as logical   no-undo .
     1707       define output parameter p-output-display as logical   no-undo .
     1708       define output parameter p-other          as character no-undo .
     1709       case p-code :
     1710               when 'shift-date':U then do:     assign     p-label = "Дата смены"     p-type = 'T':U      p-format = "99/99/9999"     p-label = "Дата смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1711               when 'shift-num':U then do:     assign     p-label = "П.смены"     p-type = 'I':U      p-format = "99"     p-label = "П.смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1712               when 'shift-name':U then do:     assign     p-label = "№ смены"     p-type = 'C':U      p-format = "X(2)"     p-label = "№ смены"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1713               when 'barcode':U then do:     assign     p-label = "Штрих-код"     p-type = 'C':U      p-format = "X(20)"     p-label = "Штрих-код"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1714               when 'lockid':U then do:     assign     p-label = "ID блокировки чека"     p-type = 'C':U      p-format = "X(2)"     p-label = "ID блокировки чека"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1715               when 'cover_sheet':U then do:     assign     p-label = "Разбиение по номиналам"     p-type = 'C':U      p-format = "X(4000)"     p-label = "Разбиение по номиналам"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1716               when 'pre-vedom':U then do:     assign     p-label = "Атрибут для препроводительной ведомости"     p-type = 'C':U      p-format = "X(256)"     p-label = "Атрибут для препроводительной ведомости"     p-user-can-edit  = false     p-output-display = false     p-other = '':u      .   end.
     1717               when 'contr-kb':U then do:     assign     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-type = 'I':U      p-format = ">>>9"     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
     1718         otherwise do:
     1719           undo, return error "неизвестный атрибут платежа" + " " + p-code .
     1720         end.
     1721       end.
     1722     end.
     1723   end procedure.
     1724   procedure fd-attr-tooltip :
     1725     do
     1726     on error undo, return error
     1727     :
     1728       define input  parameter p-code    as character no-undo .
     1729       define output parameter p-tooltip as character no-undo .
     1730       define output parameter p-label   as character no-undo .
     1731       case p-code :
     1732               when 'shift-date':U then do:     assign     p-tooltip = "Дата смены"     p-label = "Дата смены" .   end.
     1733               when 'shift-num':U then do:     assign     p-tooltip = "П.смены"     p-label = "П.смены" .   end.
     1734               when 'shift-name':U then do:     assign     p-tooltip = "№ смены"     p-label = "№ смены" .   end.
     1735               when 'barcode':U then do:     assign     p-tooltip = "Штрих-код"     p-label = "Штрих-код" .   end.
     1736               when 'lockid':U then do:     assign     p-tooltip = "ID блокировки чека"     p-label = "ID блокировки чека" .   end.
     1737               when 'cover_sheet':U then do:     assign     p-tooltip = "Разбиение по номиналам"     p-label = "Разбиение по номиналам" .   end.
     1738               when 'pre-vedom':U then do:     assign     p-tooltip = "Атрибут для препроводительной ведомости"     p-label = "Атрибут для препроводительной ведомости" .   end.
     1739               when 'contr-kb':U then do:     assign     p-tooltip = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами"     p-label = "Код кассовой книги получателя\отправителя при перемещении ДС между кассами" .   end.
     1740         otherwise do:
     1741           undo, return error "неизвестный атрибут платежа" + " " + p-code .
     1742         end.
     1743       end.
     1744     end.
     1745   end procedure.
     1746   procedure fin-doc-attr-write :
     1747    do
     1748    on error undo, return error return-value
     1749    :
     1750   define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
     1751   define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
     1752   define input parameter p-attr-code     like ub.fin-doc-attr.attr-code  no-undo .
     1753   define input parameter p-attr-value    like ub.fin-doc-attr.attr-value no-undo .
     1754   define variable  v-format         as character no-undo .
     1755   define variable  v-label          as character no-undo .
     1756   define variable  v-user-can-edit  as logical   no-undo .
     1757   define variable  v-output-display as logical   no-undo .
     1758   define variable  v-other          as character no-undo .
     1759   define variable  v-type           as character no-undo .
     1760   define buffer buf_fin-doc-attr for ub.fin-doc-attr.
     1761   run fd-attr-code in this-procedure
     1762                                     (input  p-attr-code
     1763                                     ,output v-type
     1764                                     ,output v-format
     1765                                     ,output v-label
     1766                                     ,output v-user-can-edit
     1767                                     ,output v-output-display
     1768                                     ,output v-other
     1769                                     ) no-error .
     1770   if error-status :error then do:
     1771     undo, return error return-value .
     1772   end.
     1773   find first buf_fin-doc-attr  exclusive-lock  where
     1774             buf_fin-doc-attr.attr-code    = p-attr-code
     1775         AND buf_fin-doc-attr.host-code    = p-host-code
     1776         AND buf_fin-doc-attr.fin-doc-code     = p-fin-doc-code  no-error .
     1777     if not available  buf_fin-doc-attr then do:
     1778         create buf_fin-doc-attr.
     1779         assign
     1780         buf_fin-doc-attr.attr-code    = p-attr-code
     1781         buf_fin-doc-attr.attr-value   = p-attr-value
     1782         buf_fin-doc-attr.host-code    = p-host-code
     1783         buf_fin-doc-attr.fin-doc-code     = p-fin-doc-code
     1784         .
     1785     end.
     1786     else do:
     1787          assign
     1788          buf_fin-doc-attr.attr-value = p-attr-value.
     1789     end.
     1790    end.
     1791   end procedure.
     1792   procedure fd-attr-exist :
     1793     do
     1794     on error undo, return error
     1795     :
     1796       define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
     1797       define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
     1798       define input parameter p-code          like ub.fin-doc-attr.attr-code  no-undo .
     1799       define output parameter p-exist   as logical  no-undo .
     1800       define buffer buf_fin-doc-attr for ub.fin-doc-attr .
     1801       define variable  v-type           as character no-undo .
     1802       define variable  v-format         as character no-undo .
     1803       define variable  v-label          as character no-undo .
     1804       define variable  v-user-can-edit  as logical   no-undo .
     1805       define variable  v-output-display as logical   no-undo .
     1806       define variable  v-other          as character no-undo .
     1807       run fd-attr-code in this-procedure
     1808         (input  p-code
     1809         ,output v-type
     1810         ,output v-format
     1811         ,output v-label
     1812         ,output v-user-can-edit
     1813         ,output v-output-display
     1814         ,output v-other
     1815         ) no-error .
     1816       if error-status :error then do:
     1817         undo, return error return-value .
     1818       end.
     1819       find first buf_fin-doc-attr exclusive-lock
     1820         where buf_fin-doc-attr.host-code  = p-host-code
     1821           and buf_fin-doc-attr.fin-doc-code  = p-fin-doc-code
     1822           and buf_fin-doc-attr.attr-code = p-code
     1823         no-error .
     1824       if  available buf_fin-doc-attr then do:
     1825         p-exist = yes.
     1826       end.
     1827     end.
     1828   end procedure.
     1829   procedure fd-attr-delete :
     1830     do
     1831     on error undo, return error
     1832     :
     1833     define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
     1834     define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
     1835     define input parameter p-code          like ub.fin-doc-attr.attr-code  no-undo .
     1836     define output parameter p-deleted  as logical no-undo.
     1837       define buffer buf_fin-doc-attr for ub.fin-doc-attr .
     1838       define variable  v-type           as character no-undo .
     1839       define variable  v-format         as character no-undo .
     1840       define variable  v-label          as character no-undo .
     1841       define variable  v-user-can-edit  as logical   no-undo .
     1842       define variable  v-output-display as logical   no-undo .
     1843       define variable  v-other          as character no-undo .
     1844       run fd-attr-code in this-procedure
     1845         (input  p-code
     1846         ,output v-type
     1847         ,output v-format
     1848         ,output v-label
     1849         ,output v-user-can-edit
     1850         ,output v-output-display
     1851         ,output v-other
     1852         ) no-error .
     1853       if error-status :error then do:
     1854         undo, return error return-value .
     1855       end.
     1856       find first buf_fin-doc-attr exclusive-lock
     1857         where buf_fin-doc-attr.host-code  = p-host-code
     1858           and buf_fin-doc-attr.fin-doc-code  = p-fin-doc-code
     1859           and buf_fin-doc-attr.attr-code = p-code
     1860         no-error NO-WAIT.
     1861       if not available buf_fin-doc-attr then do:
     1862         p-deleted = no.
     1863       end.
     1864       else do:
     1865         delete buf_fin-doc-attr no-error .
     1866         if error-status:error then do:
     1867           undo, return error return-value .
     1868         end.
     1869         p-deleted = yes.
     1870       end.
     1871     end.
     1872   end procedure.
