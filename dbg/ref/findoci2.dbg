     6376            tt-fin-doc.shift-num r-sht B-tax B-print B-hist B-Help RS-view
     6377            f-cashbook B-cashbook B-pre-vedom tt-fin-doc.prn-doc-code B-obj
     6378            tt-fin-doc.doc-date tt-fin-doc.user-name-doc tt-fin-doc.obj-type
     6379            tt-fin-doc.obj-code tt-fin-doc.payer-name B-payer-view
     6380            tt-fin-doc.str-podr-type tt-fin-doc.str-podr-code
     6381            tt-fin-doc.str-podr-name tt-fin-doc.cor-acc-value B-cor-acc
     6382            tt-fin-doc.an-uchet-value B-an-uchet f-contract-curr-abbr
     6383            B-contract-view tt-fin-doc.contract-curr tt-fin-doc.cel-nazn-value
     6384            B-cel-nazn tt-fin-doc.cor-acc1-value B-cor-acc1 tt-fin-doc.sum-doc
     6385            f-rest-con-sum tt-fin-doc.curr-code B-currency B-calc
     6386            tt-fin-doc.exch-rate tt-fin-doc.exch-scale tt-fin-doc.sum-rubl
