     6396   PROCEDURE fill-main-table :
     6397   define variable vss-include-info60 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6398   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     6399     (output v-db-num
     6400     )  .
     6401   define variable vss-include-info61 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6402   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     6403     (input  p-host-code
     6404     ,output v-base-code
     6405     )  .
     6406   for each tt-fin-doc:
     6407     delete tt-fin-doc.
     6408   end.
     6409   for each tt0-fin-doc-attr:
     6410     delete tt0-fin-doc-attr.
     6411   end.
     6412   for each tt0-fin-doc-tax:
     6413    delete tt0-fin-doc-tax.
     6414   end.
     6415   if p-mode = 'ИЗМЕНЕНИЕ':U
     6416   or p-mode = 'ПРОСМОТР':U
     6417   or p-mode = 'КОПИРОВАНИЕ':U
     6418   then do:
     6419     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     6420       find first locked_fin-doc EXclusive-lock where
     6421                     recid(locked_fin-doc) = p-doc-rec no-wait no-error.
     6422       if locked locked_fin-doc then do:
     6423         message
     6424         substitute("Запись &1 занята", p-fin-doc-code)
     6425         view-as alert-box error .
     6426         undo, return error.
     6427       end.
     6428     end.
     6429     else do:
     6430       find first locked_fin-doc no-lock where
     6431                   recid(locked_fin-doc) = p-doc-rec no-error .
     6432         if not available locked_fin-doc then do:
     6433           find first locked_fin-doc no-lock where
     6434                       locked_fin-doc.host-code = p-host-code
     6435                   AND locked_fin-doc.fin-doc-code = p-fin-doc-code no-error .
     6436         end.
     6437     end.
     6438     if not available locked_fin-doc then do:
     6439       message
     6440       substitute("&1 &2 &3&4 Не найдена запись &5"
     6441                   ,vss-workfile
     6442                   ,vss-revision
     6443                   ,vss-description
     6444                   ,chr(10)
     6445                   ,p-fin-doc-code)
     6446       view-as alert-box error .
     6447       undo, return error.
     6448     end.
     6449     create tt-fin-doc.
     6450     if p-mode = 'КОПИРОВАНИЕ':U then do:
     6451       buffer-copy locked_fin-doc
     6452       using
     6453       payer-type
     6454       payer-code
     6455       payer-name
     6456       payer-okpo
     6457       receiver-type
     6458       receiver-code
     6459       receiver-name
     6460       an-uchet-code
     6461       an-uchet-value
     6462       cel-nazn-code
     6463       cel-nazn-value
     6464       contract-code
     6465       contract-curr
     6466       cor-acc-value
     6467       cor-acc1-value
     6468       cor-acc1
     6469       cor-acc
     6470       curr-code
     6471       enclosure
     6472       obj-type
     6473       obj-code
     6474       receiver-passport
     6475       naznach-plat
     6476       str-podr-code
     6477       str-podr-name
     6478       str-podr-type
     6479       sum-doc
     6480       payer-sign1
     6481       payer-sign2
     6482       payer-sign3
     6483       CashBookId
     6484       to tt-fin-doc
     6485       assign
     6486       tt-fin-doc.host-code = p-host-code
     6487       .
     6488     end.
     6489     else do:
     6490       buffer-copy locked_fin-doc to tt-fin-doc.
     6491     end.
     6492   end.
     6493   if p-mode = 'ДОБАВЛЕНИЕ':U
     6494   or p-mode = 'КОПИРОВАНИЕ':U then do:
     6495     run ref/finfnoco.p (
     6496                     INPUT parParentProc
     6497                   ,INPUT this-procedure:handle
     6498                   ,input p-curr-host-code
     6499                   ,input (p-mode  + chr(4) + 'manual':U)
     6500                   ,input p-host-code
     6501                   ,input p-doc-rec
     6502                   ,input p-fin-doc-code
     6503                   ,input 'рко':U
     6504                   ,input 'рко':U
     6505                   ,input p-obj-type
     6506                   ,input p-obj-code
     6507                   ,input p-contract-code
     6508                   ,input p-ob-doc-code
     6509                   ,input 'орг':U
     6510                   ,input p-host-code
     6511                   ,input 0
     6512                   ,input p-receiver-type
     6513                   ,input p-receiver-code
     6514                   ,input 0
     6515                   ,input p-curr-code
     6516                   ,input p-cor-acc
     6517                   ,input p-cor-acc1
     6518                   ,input p-an-uchet-code
     6519                   ,input p-cel-nazn-code
     6520                   ,input (if available tt-fin-doc then tt-fin-doc.CashBookId else 0)
     6521                   ,input ""
     6522                   ,INPUT-OUTPUT table tt-fin-doc
     6523                   ,INPUT-OUTPUT table ttc-fin-doc
     6524                   ,output table tt0-fin-doc-attr
     6525                   ,output v-limit-access ) no-error .
     6526   end.
     6527   else do:
     6528     run ref/finfnoco.p (
     6529                     INPUT parParentProc
     6530                   ,INPUT this-procedure:handle
     6531                   ,input p-curr-host-code
     6532                   ,input p-mode
     6533                   ,input p-host-code
     6534                   ,input p-doc-rec
     6535                   ,input tt-fin-doc.fin-doc-code
     6536                   ,input 'рко':U
     6537                   ,input tt-fin-doc.fin-ext-doc-type
     6538                   ,input tt-fin-doc.obj-type
     6539                   ,input tt-fin-doc.obj-code
     6540                   ,input tt-fin-doc.contract-code
     6541                   ,input p-ob-doc-code
     6542                   ,input 'орг':U
     6543                   ,input p-host-code
     6544                   ,input 0
     6545                   ,input 'орг':U
     6546                   ,input tt-fin-doc.receiver-code
     6547                   ,input 0
     6548                   ,input tt-fin-doc.curr-code
     6549                   ,input tt-fin-doc.cor-acc
     6550                   ,input tt-fin-doc.cor-acc1
     6551                   ,input tt-fin-doc.an-uchet-code
     6552                   ,input tt-fin-doc.cel-nazn-code
     6553                   ,input tt-fin-doc.CashBookId
     6554                   ,input ""
     6555                   ,INPUT-OUTPUT table ttc-fin-doc
     6556                   ,INPUT-OUTPUT table tt-fin-doc
     6557                   ,output table tt0-fin-doc-attr
     6558                   ,output v-limit-access ) no-error .
     6559   end.
     6560   if error-status:error then do:
     6561     if not return-value = "exit" then do:
     6562       message
     6563       vss-workfile vss-revision vss-description skip
     6564       error-status:get-message(1) skip
     6565       return-value
     6566       view-as alert-box .
     6567     end.
     6568     undo, return error.
     6569   end.
     6570   find first tt-fin-doc.
     6571   run recalc in this-procedure ( input "curr-code":U).
     6572   if p-mode = 'КОПИРОВАНИЕ':U then do:
     6573     assign
     6574     v-copy-mode = yes
     6575     p-mode = 'ДОБАВЛЕНИЕ':U.
     6576     if tt-fin-doc.curr-code = 0  then
     6577     run recalc in this-procedure ( input "sum-doc").
     6578   end.
     6579   END PROCEDURE.
     6580   PROCEDURE Myenable :
     6581   define variable g-log as logical no-undo.
     6582   define variable v-inn like ub.firm.inn no-undo .
     6583   define variable v-kpp like ub.firm.kpp no-undo .
     6584   assign
     6585       tt-fin-doc.sum-rubl :label in frame Dialog-Frame = "Рубли"
     6586   .
     6587   run uf-get in this-procedure(
     6588       input  ('findoci-p':U + chr(4) + 'рко':U)
     6589       ,input  g#userid
     6590       ,output v-uf-List_
     6591       ,output v-uf-Naim
     6592       ,output v-uf-print-graft
     6593       ,output v-uf-sort-gr
     6594       ,output v-uf-type-price
     6595       ,output v-uf-type-val
     6596   )  no-error.
     6597   if not error-status:error
     6598   and not v-uf-LIst_ = "":U
     6599   then do:
     6600       assign
     6601       v-view =  entry(1, v-uf-List_, chr(4))
     6602       .
     6603   end.
     6604   assign
     6605   frame Dialog-Frame:title = frame Dialog-Frame:title + chr(32) + x_clients-host.obj-name
     6606   tt-fin-doc.receiver-type:radio-buttons = "Орг" + chr(44) + 'орг':U + chr(44) +
     6607                                            "Чел" + chr(44) + 'чел':U
     6608   rs-view:radio-buttons = "&Полн." + chr(44) + "full":U +  chr(44) +
     6609                                       "&Сокращ." + chr(44) + "brief":U + chr(44) +
     6610                                       "&Дог-р" + chr(44) + "contract":U
     6611   tt-fin-doc.obj-type:radio-buttons = "Маг" + chr(44) + 'маг':U + chr(44) +
     6612                                       "Скл" + chr(44) + 'скл':U
     6613   rs-view = v-view
     6614   v-an-uchet-tab-order = (if X_sysconf.is-corr-acc then "cor-acc-value,b-cor-acc," else "":U) +
     6615                          (if X_sysconf.is-an-uchet then "an-uchet-value,b-an-uchet," else "":U) +
     6616                          (if X_sysconf.is-code-cel-nazn then "cel-nazn-value,b-cel-nazn," else "":U) +
     6617                          (if X_sysconf.is-cassa-acc then "cor-acc1-value,b-cor-acc1," else "":U)
     6618   v-an-uchet-tab-order = "cor-acc-value,b-cor-acc,"  +
     6619                          "an-uchet-value,b-an-uchet," +
     6620                          "cel-nazn-value,b-cel-nazn," +
     6621                          "cor-acc1-value,b-cor-acc1,"
     6622   v-limit-access = (if p-mode = 'ПРОСМОТР':U then 10 else v-limit-access)
     6623   tt-fin-doc.obj-type:screen-value  = (if tt-fin-doc.obj-type = 'маг':U
     6624                                       or tt-fin-doc.obj-type = 'скл':U
     6625                                       then tt-fin-doc.obj-type
     6626                                       else tt-fin-doc.obj-type:screen-value)
     6627   .
     6628   if p-mode = 'ПРОСМОТР':U and
     6629   tt-fin-doc.contract-code = 0 then do:
     6630       assign
     6631       g-log = rs-view:disable(radio-label("contract":U, RS-view:radio-buttons))
     6632       .
     6633       if rs-view = "contract":U then
     6634       assign
     6635       rs-view = "full":U
     6636       v-not-uf-set = yes.
     6637   end.
     6638   find first X_currency no-lock where
     6639                 X_currency.curr-code = tt-fin-doc.curr-code.
     6640   assign
     6641   f-curr-abbr = X_Currency.curr-abbr.
     6642   assign
     6643   v-head-position = (if num-entries(tt-fin-doc.payer-sign1, chr(4)) > 1
     6644                       then entry(1, tt-fin-doc.payer-sign1, chr(4))
     6645                       else "":U)
     6646   .
     6647   if p-mode = 'ДОБАВЛЕНИЕ':U and tt-fin-doc.contract-code = 0 then do:
     6648     assign
     6649     tt-fin-doc.receiver-type = (if tt-fin-doc.receiver-type = "":U then 'орг':U else tt-fin-doc.receiver-type)
     6650     tt-fin-doc.payer-sign1:label  = tt-fin-doc.payer-sign1:label  +
     6651                                     (if v-head-position <> ''
