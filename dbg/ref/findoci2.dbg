     3126   run str/chshobj.w ( tt-fin-doc.host-code
     3127     , tt-fin-doc.obj-type
     3128     , tt-fin-doc.obj-code
     3129     , output v-obj-type
     3130     , output v-obj-code
     3131     ) no-error .
     3132   if error-status:error
     3133     or (
     3134     v-obj-type = tt-fin-doc.obj-type
     3135     AND v-obj-code = tt-fin-doc.obj-code)
     3136     or v-obj-code = 0
     3137     or v-obj-type = "":U
     3138     then
     3139   do:
     3140     return no-apply.
     3141   end.
     3142   find first X_clients-obj no-lock where
     3143     X_clients-obj.obj-type = v-obj-type
     3144     AND X_clients-obj.obj-code = v-obj-code .
     3145   assign
     3146     tt-fin-doc.obj-type = X_clients-obj.obj-type
     3147     tt-fin-doc.obj-code = X_clients-obj.obj-code
     3148     .
     3149   display
     3150     tt-fin-doc.obj-type
     3151     tt-fin-doc.obj-code
     3152     with frame Dialog-Frame.
     3153   run check-obj in this-procedure (  input tt-fin-doc.obj-type
     3154     ,input tt-fin-doc.obj-code
     3155     )
     3156     no-error.
     3157   END.
     3158   ON LEAVE OF tt-fin-doc.obj-code IN FRAME Dialog-Frame
     3159     DO:
     3160   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3161   if lookup(self :type
     3162            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3163            ) = 0
