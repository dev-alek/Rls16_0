     2073   procedure fin-doc-temp-attr-write :
     2074    do
     2075    on error undo, return error return-value
     2076    :
     2077   define input parameter p-host-code     like ub.fin-doc-attr.host-code  no-undo .
     2078   define input parameter p-fin-doc-code  like ub.fin-doc-attr.fin-doc-code   no-undo .
     2079   define input parameter p-attr-code     like ub.fin-doc-attr.attr-code  no-undo .
     2080   define input parameter p-attr-value    like ub.fin-doc-attr.attr-value no-undo .
     2081   define variable  v-format         as character no-undo .
     2082   define variable  v-label          as character no-undo .
     2083   define variable  v-user-can-edit  as logical   no-undo .
     2084   define variable  v-output-display as logical   no-undo .
     2085   define variable  v-other          as character no-undo .
     2086   define variable  v-type           as character no-undo .
     2087   define buffer buf_temp-fin-doc-attr for tt0-fin-doc-attr.
     2088   run fd-attr-code in this-procedure
     2089                                     (input  p-attr-code
     2090                                     ,output v-type
     2091                                     ,output v-format
     2092                                     ,output v-label
     2093                                     ,output v-user-can-edit
     2094                                     ,output v-output-display
     2095                                     ,output v-other
     2096                                     ) no-error .
     2097   if error-status :error then do:
     2098     undo, return error return-value .
     2099   end.
     2100   find first buf_temp-fin-doc-attr  exclusive-lock  where
     2101             buf_temp-fin-doc-attr.attr-code    = p-attr-code
     2102         AND buf_temp-fin-doc-attr.host-code    = p-host-code
     2103         AND buf_temp-fin-doc-attr.fin-doc-code     = p-fin-doc-code  no-error .
     2104     if not available  buf_temp-fin-doc-attr then do:
     2105         create buf_temp-fin-doc-attr.
     2106         assign
     2107         buf_temp-fin-doc-attr.attr-code    = p-attr-code
     2108         buf_temp-fin-doc-attr.attr-value   = p-attr-value
     2109         buf_temp-fin-doc-attr.host-code    = p-host-code
     2110         buf_temp-fin-doc-attr.fin-doc-code     = p-fin-doc-code
     2111         .
     2112     end.
     2113       assign
     2114       buf_temp-fin-doc-attr.attr-value = p-attr-value.
     2115    end.
     2116   end procedure.
