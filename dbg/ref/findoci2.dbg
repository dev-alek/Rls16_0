     4017       tt-fin-doc.cor-acc = X_fin-code-cor-acc1.fin-code
     4018       .
     4019   end.
     4020   end.
     4021   else do:
     4022   tt-fin-doc.naznach-plat = "".
     4023   end.
     4024   end.
     4025   end.
     4026     display
     4027       tt-fin-doc.receiver-type
     4028       tt-fin-doc.receiver-code
     4029       tt-fin-doc.receiver-name
     4030       with frame Dialog-Frame.
     4031   END PROCEDURE.
