     2158   function clean_char return char
     2159   (INPUT in_str AS CHARACTER):
     2160       DEFINE VARIABLE out_str  AS CHARACTER NO-UNDO.
     2161       DEFINE VARIABLE i        AS INTEGER   NO-UNDO.
     2162       DEFINE VARIABLE new_str  AS CHARACTER NO-UNDO.
     2163       DEFINE VARIABLE ch_code  AS INTEGER   NO-UNDO.
     2164       out_str = "".
     2165       DO i = 1 TO LENGTH (in_str):
     2166           new_str = SUBSTRING(in_str, i, 1).
     2167           ch_code = ASC(new_str).
     2168           IF  ch_code >= 32
     2169           and ch_code < 1104
     2170           and ch_code <> 166
     2171           and ch_code <> 127
     2172           and new_str <> "?"
     2173           THEN out_str = out_str + new_str.
     2174       END.
     2175       RETURN out_str.
     2176   END.
     2177   function is-fact-and-edit returns logical ():
     2178       return (p-mode = 'ИЗМЕНЕНИЕ':U and locked_fin-doc.status_ = 'факт':U).
     2179   end.
