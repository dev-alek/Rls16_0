     5116   else do:
     5117     apply "entry":u to self  .
     5118     if focus :handle <> self :handle  then do:
     5119       return no-apply .
     5120     end.
     5121   end.
     5122   define variable v-doc-date as date    no-undo.
     5123   define variable vlog       as logical no-undo .
     5124   if tt-fin-doc.shift-flag = integer('1':U) then
     5125   do:
     5126     if tt-fin-doc.shift-date >  input frame Dialog-Frame  tt-fin-doc.doc-date  then
     5127     do:
     5128       message
     5129         "Дата документа не может быть меньше даты смены!"
     5130         view-as alert-box error .
     5131       return no-apply.
     5132     end.
     5133   end.
     5134   assign
     5135     v-doc-date = tt-fin-doc.doc-date
     5136     tt-fin-doc.doc-date
     5137     .
     5138   if tt-fin-doc.doc-date <> v-doc-date
     5139     and (input frame Dialog-Frame   tt-fin-doc.sum-doc <> 0
     5140     or tt-fin-doc.sum-doc <> 0)
     5141     then
     5142   do:
     5143     message
     5144       "Пересчитать суммы документа в соответствии с курсами на новую дату?"
     5145       view-as alert-box QUESTION buttons YEs-NO update vlog.
     5146     if  vlog then
     5147     do:
     5148       run recalc in this-procedure ("doc-date":U) no-error.
     5149       if error-status:error then
     5150       do:
     5151         assign
     5152           tt-fin-doc.doc-date = v-doc-date
     5153           .
     5154         display tt-fin-doc.doc-date
     5155           with frame Dialog-Frame.
     5156       end.
     5157     end.
     5158   end.
     5159   END.
