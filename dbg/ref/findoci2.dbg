     5203   PROCEDURE disable-enable :
     5204     define input parameter p-main-widget as character no-undo.
     5205     define input parameter p-main-curr as character no-undo .
     5206     disable
     5207       tt-fin-doc.sum-doc
     5208       tt-fin-doc.sum-rubl
     5209       tt-fin-doc.sum-base
     5210       tt-fin-doc.base-rate
     5211       tt-fin-doc.base-scale
     5212       tt-fin-doc.exch-rate
     5213       tt-fin-doc.exch-scale
     5214       tt-fin-doc.sum-contr
     5215       tt-fin-doc.contract-rate
     5216       tt-fin-doc.contract-scale
     5217       with frame Dialog-Frame .
     5218     assign
     5219       v-main-sum  = if p-main-widget <> "":U then p-main-widget else v-main-sum
     5220       v-main-curr = if p-main-curr <> "":U then p-main-curr else v-main-curr
     5221       .
     5222     if v-limit-access > 0 then
     5223     do:
     5224       display
     5225         tt-fin-doc.sum-rubl
     5226         when v-rubf
     5227         tt-fin-doc.sum-base
     5228         when v-basef
     5229         tt-fin-doc.exch-rate
     5230         when v-exchf
     5231         tt-fin-doc.exch-scale
     5232         when v-exchf
     5233         tt-fin-doc.base-rate
     5234         when v-basef
     5235         tt-fin-doc.base-scale
     5236         when v-basef
     5237         tt-fin-doc.sum-contr
     5238         when v-contractf
     5239         tt-fin-doc.contract-rate
     5240         when v-contractratef
     5241         tt-fin-doc.contract-scale
     5242         when v-contractratef
     5243         with frame Dialog-Frame.
     5244       return.
     5245     end.
     5246     CASE p-main-widget:
     5247       when "sum-doc" then
     5248         do:
     5249           enable
     5250             tt-fin-doc.sum-doc
     5251             with frame Dialog-Frame.
     5252           APPLY "ENTRY" to tt-fin-doc.sum-doc.
     5253         end.
     5254     END CASE.
     5255     display
     5256       tt-fin-doc.sum-rubl
     5257       when v-rubf
     5258       tt-fin-doc.sum-base
     5259       when v-basef
     5260       tt-fin-doc.exch-rate
     5261       when v-exchf
     5262       tt-fin-doc.exch-scale
     5263       when v-exchf
     5264       tt-fin-doc.base-rate
     5265       when v-basef
     5266       tt-fin-doc.base-scale
     5267       when v-basef
     5268       tt-fin-doc.sum-contr
     5269       when v-contractf
     5270       tt-fin-doc.contract-rate
     5271       when v-contractratef
     5272       tt-fin-doc.contract-scale
     5273       when v-contractratef
     5274       with frame Dialog-Frame.
     5275     CASE rs-view:
     5276       when "full":u then
     5277         do:
     5278           assign
     5279             v-tab-order = "b-exit,b-quit,b-tax,b-print,b-hist,b-help," +  "prn-doc-code,doc-date,obj-type,obj-code,b-obj,b-payer-view,str-podr-type,str-podr-code,str-podr-name," +                             v-an-uchet-tab-order +  v-sum-curr-tab-order +                             "receiver-type,receiver-code,b-receiver,receiver-name,naznach-plat,receiver-passport,enclosure," +                              "PS,payer-sign1,payer-sign2"
     5280             .
     5281         end.
     5282       when "brief":u then
     5283         do:
     5284           assign
     5285             v-tab-order = "b-exit,b-quit,b-tax,b-print,b-hist,b-help," +                            "prn-doc-code,doc-date,obj-type,obj-code,b-obj,b-payer-view," +                            v-sum-curr-tab-order +                            "receiver-type,receiver-code,b-receiver,receiver-name,naznach-plat,receiver-passport,enclosure," +                            "PS,payer-sign1,payer-sign2,payer-sign3"
     5286             .
     5287         end.
     5288       when "contract":u then
     5289         do:
     5290           assign
     5291             v-tab-order = "b-exit,b-quit,b-tax,b-print,b-hist,b-help," +                               "prn-doc-code,doc-date,obj-type,obj-code,b-obj,b-payer-view," +                                v-contract-tab-order + v-sum-curr-tab-order +                                 "receiver-type,receiver-code,b-receiver,receiver-name,naznach-plat,receiver-passport,enclosure," +                                 "PS,payer-sign1,payer-sign2"
     5292             .
     5293         end.
     5294     END CASE.
     5295   END PROCEDURE.
     5296   define new global shared variable g#lib-farh as handle no-undo .
     5297   PROCEDURE fill-tables :
     5298     define buffer buf_fin-doc-tax  for ub.fin-doc-tax.
     5299     define buffer buf_fin-doc-attr for ub.fin-doc-attr.
     5300     define buffer buf_fin-ob-tax   for ub.fin-ob-tax.
     5301     define buffer buf_fin-connect  for ub.fin-connect.
     5302     define buffer buf_fin-ob       for ub.fin-ob.
     5303     define buffer buf_payment      for ub.payment.
     5304     if p-mode = 'ДОБАВЛЕНИЕ':U
     5305       AND p-ob-doc-code <> "" then
     5306     do:
     5307       for each buf_fin-ob-tax no-lock where
     5308         buf_fin-ob-tax.host-code = tt-fin-doc.fin-doc-code
     5309         AND buf_fin-ob-tax.doc-code = p-ob-doc-code:
     5310         create tt0-fin-doc-tax.
     5311         buffer-copy buf_fin-ob-tax to tt0-fin-doc-tax.
     5312       end.
     5313       return.
     5314     end.
     5315     if p-mode = 'ДОБАВЛЕНИЕ':U
     5316       and v-copy-mode = yes then
     5317     do:
     5318       for each buf_fin-doc-tax no-lock where
     5319         buf_fin-doc-tax.host-code = locked_fin-doc.host-code
     5320         AND buf_fin-doc-tax.fin-doc-code = locked_fin-doc.fin-doc-code
     5321         :
     5322         create tt0-fin-doc-tax.
     5323         buffer-copy buf_fin-doc-tax except fin-doc-code to tt0-fin-doc-tax
     5324           assign
     5325           tt0-fin-doc-tax.fin-doc-code = tt-fin-doc.fin-doc-code
     5326           .
     5327       end.
     5328       for each buf_payment no-lock where
     5329         buf_payment.source-type = 'платеж':U
     5330         AND buf_payment.source-ref = string(locked_fin-doc.fin-doc-code)
     5331         :
     5332         create tt0-payment.
     5333         buffer-copy buf_payment except source-ref to tt0-payment
     5334           assign
     5335           tt0-payment.source-ref = string(tt-fin-doc.fin-doc-code)
     5336           .
     5337       end.
     5338       for each buf_fin-doc-attr no-lock where
     5339         buf_fin-doc-attr.host-code = locked_fin-doc.host-code
     5340         AND buf_fin-doc-attr.fin-doc-code = locked_fin-doc.fin-doc-code
     5341         :
     5342         create tt0-fin-doc-attr.
     5343         buffer-copy buf_fin-doc-attr to tt0-fin-doc-attr
     5344           assign
     5345           tt0-fin-doc-attr.fin-doc-code = tt-fin-doc.fin-doc-code
     5346           .
     5347       end.
     5348     end.
     5349     else
     5350     do:
     5351       for each buf_fin-doc-tax no-lock where
     5352         buf_fin-doc-tax.host-code = tt-fin-doc.host-code
     5353         AND buf_fin-doc-tax.fin-doc-code = tt-fin-doc.fin-doc-code
     5354         :
     5355         create tt0-fin-doc-tax.
     5356         buffer-copy buf_fin-doc-tax to tt0-fin-doc-tax.
     5357       end.
     5358       for each buf_payment no-lock where
     5359         buf_payment.source-type = 'платеж':U
     5360         AND buf_payment.source-ref = string(tt-fin-doc.fin-doc-code)
     5361         :
     5362         create tt0-payment.
     5363         buffer-copy buf_payment to tt0-payment.
     5364       end.
     5365       for each buf_fin-doc-attr no-lock where
     5366         buf_fin-doc-attr.host-code = tt-fin-doc.host-code
     5367         AND buf_fin-doc-attr.fin-doc-code = tt-fin-doc.fin-doc-code
     5368         :
     5369         create tt0-fin-doc-attr.
     5370         buffer-copy buf_fin-doc-attr to tt0-fin-doc-attr.
     5371       end.
     5372       for each tt0-fin-doc-attr no-lock where
     5373         tt0-fin-doc-attr.host-code = tt-fin-doc.host-code
     5374         AND tt0-fin-doc-attr.fin-doc-code = tt-fin-doc.fin-doc-code
     5375         :
     5376       end.
     5377     end.
     5378   if (valid-handle(g#lib-farh) <> true) then do:   run str/lib-farh.p persistent no-error .   if error-status :error or (valid-handle(g#lib-farh) <> true) then do:     message       "Error starting lib-farh.p" skip       g#lib-farh skip       g#lib-farh :type skip       g#lib-farh :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-farh_fautoobj in g#lib-farh
     5379   (input tt-fin-doc.host-code
     5380   ,input tt-fin-doc.fin-doc-code
     5381   ,output v-is-auto-obj
     5382   )
     5383   .
     5384     if getCliKassa(tt-fin-doc.receiver-type, tt-fin-doc.receiver-code, "Vnecli", tt-fin-doc.cashbookId) then paramVne = "vne" .
     5385     else if getCliKassa(tt-fin-doc.receiver-type, tt-fin-doc.receiver-code, "Avanscli", tt-fin-doc.cashbookId) then paramVne = "avans" .
     5386     else paramVne = "" .
     5387     run proc-update-sum-vat-chr in this-procedure (input-output v-start).
     5388   END PROCEDURE.
     5389   PROCEDURE hide-view-currency :
     5390     define buffer buf_currency for ub.currency.
     5391     assign
     5392       v-rubf          = no
     5393       v-exchf         = no
     5394       v-basef         = no
     5395       v-baseratef     = no
     5396       v-contractf     = no
     5397       v-contractratef = no
     5398       .
     5399     hide
     5400       tt-fin-doc.sum-rubl in frame Dialog-Frame
     5401       tt-fin-doc.exch-rate
     5402       tt-fin-doc.exch-scale
     5403       tt-fin-doc.sum-base
     5404       tt-fin-doc.base-rate
     5405       tt-fin-doc.base-scale
     5406       tt-fin-doc.sum-contr
     5407       tt-fin-doc.contract-rate
     5408       tt-fin-doc.contract-scale
     5409       in frame Dialog-Frame .
     5410     if tt-fin-doc.curr-code <> 0 then
     5411     do:
     5412       if tt-fin-doc.curr-code:visible then
     5413         display
     5414           tt-fin-doc.exch-rate
     5415           tt-fin-doc.exch-scale
     5416           tt-fin-doc.sum-rubl
     5417           with frame Dialog-Frame.
     5418       assign
     5419         v-rubf  = yes
     5420         v-exchf = yes
     5421         .
     5422     end.
     5423     if v-base-code <> tt-fin-doc.curr-code
     5424       and v-base-code <> 0
     5425       then
     5426     do:
     5427       find first buf_currency no-lock where
     5428         buf_currency.curr-code = v-base-code .
     5429       assign
     5430         tt-fin-doc.sum-base:label = "Б.в.("  + buf_currency.curr-abbr + ")":U
     5431         .
     5432       if tt-fin-doc.curr-code:visible then
     5433         display
     5434           tt-fin-doc.base-rate
     5435           tt-fin-doc.base-scale
     5436           tt-fin-doc.sum-base
     5437           with frame Dialog-Frame.
     5438       assign
     5439         v-basef     = yes
     5440         v-baseratef = yes
     5441         .
     5442     end.
     5443     if tt-fin-doc.contract-code  <> 0 and
     5444       (tt-fin-doc.contract-curr <> 0
     5445       and tt-fin-doc.contract-curr <> tt-fin-doc.curr-code
     5446       and tt-fin-doc.contract-curr <> v-base-code
     5447       )
     5448       then
     5449     do:
     5450       find first buf_currency no-lock where
     5451         buf_currency.curr-code = tt-fin-doc.contract-curr .
     5452       assign
     5453         tt-fin-doc.sum-contr:label = "Вал.дог.("  + buf_currency.curr-abbr + ")":U
     5454         .
     5455       if tt-fin-doc.curr-code:visible then
     5456         display
     5457           tt-fin-doc.sum-contr
     5458           tt-fin-doc.contract-rate
     5459           tt-fin-doc.contract-scale
     5460           with frame Dialog-Frame.
     5461       assign
     5462         v-contractf     = yes
     5463         v-contractratef = yes
     5464         .
     5465     end.
     5466     assign
     5467       v-sum-curr-tab-order = v-sum-doc-tab-order
     5468       .
     5469     run disable-enable in this-procedure (v-main-sum, v-main-curr).
     5470   END PROCEDURE.
