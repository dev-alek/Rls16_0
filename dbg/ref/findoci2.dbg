     2595   ON CHOOSE OF B-pre-vedom IN FRAME Dialog-Frame
     2596   DO:
     2597     define buffer bf_fin-doc-attr for ub.fin-doc-attr .
     2598     find first tt-fin-doc no-error .
     2599     if available (tt-fin-doc) then do:
     2600     run ref/cover_sheet.p (input parParentProc, input p-host-code, input tt-fin-doc.fin-doc-code, input tt-fin-doc.CashBookId, input tt-fin-doc.sum-doc, input p-mode) no-error .
     2601       display tt-fin-doc.enclosure with frame Dialog-Frame .
     2602     end.
     2603   END.
     2604   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     2605   DO:
     2606   define variable v-format as integer no-undo .
     2607   define variable v-cmp as character no-undo .
     2608   define variable v-log as logical no-undo .
     2609   buffer-compare tt-fin-doc except payer-sign1
     2610   to locked_fin-doc
     2611   case-sensitive
     2612   save result in v-cmp .
     2613   if v-cmp <> "":U
     2614   or  entry((if num-entries(locked_fin-doc.payer-sign1, chr(4)) > 1
     2615              then 2
     2616              else 1)
     2617              , locked_fin-doc.payer-sign1, chr(4)
     2618            ) <> tt-fin-doc.payer-sign1
     2619   then do:
     2620     message
     2621     "Вы изменили ПЛАТЕЖ, но не сохранили его" skip
     2622     "сохранить перед печатью?"
     2623     view-as alert-box QUESTION buttons YES-NO update v-log.
     2624   end.
     2625   run proc-save in this-procedure (v-log ) no-error.
     2626   run ref/fdoc-prn.p (
     2627           input parparentproc
     2628         , input this-procedure
     2629         , input string(recid(locked_fin-doc))
     2630                         ) no-error.
     2631   if error-status:error then return no-apply.
     2632   END.
     2633   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2634   procedure proc-color-widgets :
     2635   define input parameter p-list as character no-undo .
     2636   define input parameter p-fg as logical no-undo .
     2637   define input parameter p-bg as logical no-undo .
     2638   define input parameter p-fgc as integer no-undo .
     2639   define input parameter p-bgc as integer no-undo .
     2640   define variable ii as integer no-undo .
     2641   define variable fh as widget-handle no-undo .
     2642   define variable hh as widget-handle no-undo .
     2643     do
     2644     on error undo, return error
     2645     :
     2646       assign
     2647       fh = frame Dialog-Frame:first-child
     2648       hh = fh:first-child
     2649       .
     2650       do while valid-handle(hh):
     2651         if LOOKUP(hh:name, p-list) > 0  then do:
     2652           assign
     2653           hh:fgcolor = (if p-fg then p-fgc else hh:fgcolor)
     2654           hh:bgcolor = (if p-bg then p-bgc else hh:bgcolor)
     2655           .
     2656         end.
     2657         hh = hh:next-sibling.
     2658       end.
     2659     end.
     2660   end procedure.
     2661   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile: findocip.i $ $Revision: ff8019e24d02, 2996, rls $".
     2662   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2663   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2664   procedure set-buffers :
     2665     DEFINE input parameter X_clients-host-recid as recid no-undo .
     2666     DEFINE input parameter X_firm-recid as recid no-undo .
     2667     DEFINE input parameter X_sysconf-recid as recid no-undo .
     2668     define input parameter X_fin-code-cor-acc-recid as recid no-undo .
     2669     define input parameter X_fin-code-cor-acc1-recid as recid no-undo .
     2670     define input parameter X_fin-code-an-uchet-recid as recid no-undo .
     2671     define input parameter X_fin-code-cel-nazn-recid as recid no-undo .
     2672     define input parameter X_currency-recid as recid no-undo .
     2673     define input parameter X_contract-currency-recid as recid no-undo .
     2674     DEFINE input parameter X_receiver-recid as recid no-undo .
     2675     DEFINE input parameter X_payer-recid as recid no-undo .
     2676     define input parameter X_curr_sysconf-recid as recid no-undo .
     2677     define input parameter X_payer-fin-schet-recid as recid no-undo .
     2678     define input parameter X_payer-fin-bank-recid as recid no-undo .
     2679     define input parameter X_payer-firm-recid as recid no-undo .
     2680     define input parameter X_payer-person-recid as recid no-undo .
     2681     define input parameter X_receiver-fin-schet-recid as recid no-undo .
     2682     define input parameter X_receiver-fin-bank-recid as recid no-undo .
     2683     define input parameter X_receiver-firm-recid as recid no-undo .
     2684     define input parameter X_receiver-person-recid as recid no-undo .
     2685     define input parameter X_contract-recid as recid no-undo .
     2686     define input parameter X_fin-ob-recid as recid no-undo .
     2687     define input parameter X_clients-obj-recid as recid no-undo .
     2688     define input parameter p-f-cor-acc1-descr as character no-undo .
     2689     define input parameter p-f-cor-acc-descr as character no-undo .
     2690     define input parameter p-f-an-uchet-descr as character no-undo .
     2691     define input parameter p-f-cel-nazn-descr as character no-undo .
     2692     do
     2693       on error undo, return error
     2694       :
     2695       find first X_clients-host no-lock where                   recid(X_clients-host)          = X_clients-host-recid no-error  .
     2696       find first X_firm no-lock where                           recid(X_firm)                  = X_firm-recid no-error .
     2697       find first X_sysconf no-lock where                        recid(X_sysconf)               = X_sysconf-recid no-error .
     2698       find first X_fin-code-cor-acc no-lock where               recid(X_fin-code-cor-acc)      = X_fin-code-cor-acc-recid no-error .
     2699       find first X_fin-code-cor-acc1 no-lock where              recid(X_fin-code-cor-acc1)     = X_fin-code-cor-acc1-recid no-error .
     2700       find first X_fin-code-an-uchet no-lock where              recid(X_fin-code-an-uchet)     = X_fin-code-an-uchet-recid no-error .
     2701       find first X_fin-code-cel-nazn no-lock where              recid(X_fin-code-cel-nazn)     = X_fin-code-cel-nazn-recid no-error .
     2702       find first X_currency no-lock where                       recid(X_currency)              = X_currency-recid no-error .
     2703       find first X_contract-currency no-lock where              recid(X_contract-currency)     = X_contract-currency-recid no-error .
     2704       find first X_receiver no-lock where                       recid(X_receiver)              = X_receiver-recid no-error .
     2705       find first X_payer no-lock where                          recid(X_payer)                 = X_payer-recid no-error .
     2706       find first X_curr_sysconf no-lock where                   recid(X_curr_sysconf)          = X_curr_sysconf-recid no-error .
     2707       find first X_payer-fin-schet no-lock where                recid(X_payer-fin-schet)       = X_payer-fin-schet-recid no-error .
     2708       find first X_payer-fin-bank no-lock where                 recid(X_payer-fin-bank)        = X_payer-fin-bank-recid no-error .
     2709       find first X_payer-firm no-lock where                     recid(X_payer-firm)            = X_payer-firm-recid no-error .
     2710       find first X_payer-person no-lock where                   recid(X_payer-person)          = X_payer-person-recid no-error .
     2711       find first X_receiver-fin-schet no-lock where             recid(X_receiver-fin-schet)    = X_receiver-fin-schet-recid no-error .
     2712       find first X_receiver-fin-bank no-lock where              recid(X_receiver-fin-bank)     = X_receiver-fin-bank-recid no-error .
     2713       find first X_receiver-firm no-lock where                  recid(X_receiver-firm)         = X_receiver-firm-recid no-error .
     2714       find first X_receiver-person no-lock where                recid(X_receiver-person)       = X_receiver-person-recid no-error .
     2715       find first X_contract no-lock where                       recid(X_contract)              = X_contract-recid no-error .
     2716       find first X_fin-ob no-lock where                         recid(X_fin-ob)                = X_fin-ob-recid no-error .
     2717       find first X_clients-obj no-lock where                    recid(X_clients-obj)           = X_clients-obj-recid no-error .
     2718       assign
     2719         f-cor-acc1-descr = p-f-cor-acc1-descr
     2720         f-cor-acc-descr  = p-f-cor-acc-descr
     2721         f-an-uchet-descr = p-f-an-uchet-descr
     2722         f-cel-nazn-descr = p-f-cel-nazn-descr
     2723         .
     2724     end.
     2725   end procedure.
     2726   PROCEDURE proc-shift-name :
     2727     define buffer bf_shift-obj for ub.shift-obj.
     2728     define variable varfind-shift as integer initial 0.
     2729     define variable varshift-date like ub.shift-obj.shift-date no-undo.
     2730     define variable varshift-num  like ub.shift-obj.shift-num no-undo.
     2731     define variable varshift-name like ub.shift-obj.shift-name no-undo.
     2732     if input frame Dialog-Frame tt-fin-doc.shift-name <> tt-fin-doc.shift-name then
     2733     do:
     2734       if input frame Dialog-Frame tt-fin-doc.shift-date <> ? then
     2735       do:
     2736         for each  bf_shift-obj where
     2737           bf_shift-obj.obj-type   = tt-fin-doc.obj-type
     2738           and  bf_shift-obj.obj-code   = tt-fin-doc.obj-code
     2739           and  bf_shift-obj.shift-date = input frame Dialog-Frame tt-fin-doc.shift-date
     2740           and  bf_shift-obj.shift-name = input frame Dialog-Frame tt-fin-doc.shift-name
     2741           no-lock on error undo, return error return-value :
     2742           assign
     2743             varfind-shift = varfind-shift + 1
     2744             varshift-date = bf_shift-obj.shift-date
     2745             varshift-num  = bf_shift-obj.shift-num.
     2746           varshift-name = bf_shift-obj.shift-name.
     2747         end.
     2748         if varfind-shift = 0 or varfind-shift > 1 then
     2749         do:
     2750           if varfind-shift = 0 then
     2751           do:
     2752             message
     2753               substitute("Не найдена смена: &1&2 Дата &3 Номер смены "
     2754               ,tt-fin-doc.obj-type
     2755               ,tt-fin-doc.obj-code
     2756               ,input frame Dialog-Frame tt-fin-doc.shift-date
     2757               ,input frame Dialog-Frame tt-fin-doc.shift-name )
     2758               view-as alert-box error.
     2759           end.
     2760           else
     2761           do:
     2762             message
     2763               substitute("Найдено более одной смены с одним номером в сменном дне. Объект: &1&2 Дата &3 Номер смены &4 "
     2764               ,tt-fin-doc.obj-type
     2765               ,tt-fin-doc.obj-code
     2766               ,input frame Dialog-Frame tt-fin-doc.shift-date
     2767               ,input frame Dialog-Frame tt-fin-doc.shift-name )
     2768               view-as alert-box error.
     2769           end.
     2770           display
     2771             tt-fin-doc.shift-name with frame Dialog-Frame.
     2772           run proc-sht no-error.
     2773           if error-status:error then
     2774           do:
     2775             return error.
     2776           end.
     2777         end.
     2778         else
     2779         do:
     2780           assign frame Dialog-Frame
     2781             tt-fin-doc.shift-name.
     2782           assign
     2783             tt-fin-doc.shift-date = varshift-date
     2784             tt-fin-doc.shift-num  = varshift-num.
     2785           display
     2786             tt-fin-doc.shift-date
     2787             tt-fin-doc.shift-num
     2788             tt-fin-doc.shift-name with frame Dialog-Frame.
     2789         end.
     2790       end.
     2791     end.
     2792   END PROCEDURE.
     2793   PROCEDURE proc-shift-num :
     2794     define buffer bf_shift-obj for ub.shift-obj.
     2795     if input frame Dialog-Frame tt-fin-doc.shift-num <> tt-fin-doc.shift-num then
     2796     do:
     2797       if input frame Dialog-Frame tt-fin-doc.shift-date <> ? then
     2798       do:
     2799         find first bf_shift-obj where
     2800           bf_shift-obj.obj-type   = tt-fin-doc.obj-type
     2801           and  bf_shift-obj.obj-code   = tt-fin-doc.obj-code
     2802           and  bf_shift-obj.shift-date = input frame Dialog-Frame tt-fin-doc.shift-date
     2803           and  bf_shift-obj.shift-num  = input frame Dialog-Frame tt-fin-doc.shift-num  no-lock no-error.
     2804         if not available bf_shift-obj then
     2805         do:
     2806           message
     2807             substitute("Не найдена смена: &1&2 Дата &3 Порядок смены &4"
     2808             ,tt-fin-doc.obj-type
     2809             ,tt-fin-doc.obj-code
     2810             ,input frame Dialog-Frame tt-fin-doc.shift-date
     2811             ,input frame Dialog-Frame tt-fin-doc.shift-num)
     2812             view-as alert-box error.
     2813           display
     2814             tt-fin-doc.shift-num with frame Dialog-Frame.
     2815           run proc-sht no-error.
     2816           if error-status:error then
     2817           do:
     2818             return error.
     2819           end.
     2820         end.
     2821         else
     2822         do:
     2823           assign
     2824             tt-fin-doc.shift-date = bf_shift-obj.shift-date
     2825             tt-fin-doc.shift-num  = bf_shift-obj.shift-num
     2826             tt-fin-doc.shift-name = bf_shift-obj.shift-name.
     2827           display
     2828             tt-fin-doc.shift-date
     2829             tt-fin-doc.shift-num
     2830             tt-fin-doc.shift-name
     2831             with frame Dialog-Frame.
     2832         end.
     2833       end.
     2834     end.
     2835   END PROCEDURE.
     2836   PROCEDURE proc-sht :
     2837     define buffer bf_shift-obj for ub.shift-obj.
     2838     define variable varrid-list as character no-undo.
     2839     define variable varrecid    as recid     no-undo.
     2840     assign
     2841       varrid-list = "".
     2842     run str/sht-all.w ( input parparentproc
     2843       , input tt-fin-doc.obj-type
     2844       , input tt-fin-doc.obj-code
     2845       , input 'b-sel'
     2846       , input 'obj'
     2847       , input tt-fin-doc.obj-type
     2848       , input tt-fin-doc.obj-code
     2849       , input '':u
     2850       , input-output varrid-list) no-error .
     2851     if error-status:error or varrid-list = "":u then
     2852     do:
     2853       return error.
     2854     end.
     2855     else
     2856     do:
     2857       assign
     2858         varrecid = integer (entry(1, varrid-list)).
     2859       find first bf_shift-obj where recid(bf_shift-obj) = varrecid no-lock no-error.
     2860       if available bf_shift-obj then
     2861       do:
     2862         assign
     2863           tt-fin-doc.shift-date = bf_shift-obj.shift-date
     2864           tt-fin-doc.shift-num  = bf_shift-obj.shift-num
     2865           tt-fin-doc.shift-name = bf_shift-obj.shift-name.
     2866         display
     2867           tt-fin-doc.shift-date
     2868           tt-fin-doc.shift-num
     2869           tt-fin-doc.shift-name with frame Dialog-Frame.
     2870         assign
     2871           tt-fin-doc.doc-date = tt-fin-doc.shift-date
     2872           .
     2873         display tt-fin-doc.doc-date with frame Dialog-Frame.
     2874       end.
     2875     end.
     2876   END PROCEDURE.
     2877   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile: findocip.i $ $Revision: ff8019e24d02, 2996, rls $".
     2878   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2879   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2880   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2881   on ' ' of tt-fin-doc.doc-date in frame Dialog-Frame
     2882   do:
     2883     if (can-query (self, "sensitive")
     2884        and
     2885        self :sensitive = true
     2886        )
     2887     or (can-query (self, "read-only")
     2888        and
     2889        self :read-only = false
     2890        )
     2891     then do:
     2892       assign
     2893         self :screen-value = ?
     2894       .
     2895     end.
     2896     return no-apply.
     2897   end.
     2898   on delete-character of tt-fin-doc.doc-date in frame Dialog-Frame
     2899   do:
     2900     if (can-query (self, "sensitive")
     2901        and
     2902        self :sensitive = true
     2903        )
     2904     or (can-query (self, "read-only")
     2905        and
     2906        self :read-only = false
     2907        )
     2908     then do:
     2909       assign
     2910         self :screen-value = ?
     2911       .
