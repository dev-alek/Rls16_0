     3209   PROCEDURE check-obj :
     3210     define input parameter p-check-obj-type as character no-undo .
     3211     define input parameter p-check-obj-code as integer no-undo .
     3212     define variable v-obj-db-num as integer no-undo init -1.
     3213     define variable v-cash-book  as integer no-undo .
     3214     define buffer buf_clients for ub.clients.
     3215     find first buf_clients no-lock where
     3216       buf_clients.obj-code = p-check-obj-code
     3217       and buf_clients.obj-type = p-check-obj-type no-error.
     3218     if not available buf_clients then
     3219     do:
     3220       if p-check-obj-code <> ?  then
     3221         message "Неправильный код или тип объекта" .
     3222       apply "entry" to tt-fin-doc.obj-code in frame Dialog-Frame.
     3223       return error.
     3224     end.
     3225     find first X_clients-obj no-lock where recid(X_clients-obj) = recid(buf_clients).
     3226     assign
     3227       tt-fin-doc.obj-type = buf_clients.obj-type
     3228       tt-fin-doc.obj-code = buf_clients.obj-code
     3229       .
     3230     display
     3231       tt-fin-doc.obj-type
     3232       tt-fin-doc.obj-code
     3233       with frame Dialog-Frame.
     3234     if not (tt-fin-doc.obj-type = '' and tt-fin-doc.obj-code = 0) then
     3235     do:
     3236   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3237   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     3238     (input  tt-fin-doc.obj-type
     3239     ,input  tt-fin-doc.obj-code
     3240     ,output v-obj-db-num
     3241     )  .
     3242       define variable l-shift-on as logical no-undo .
     3243   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3244   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3245     (input  tt-fin-doc.obj-type
     3246     ,input  tt-fin-doc.obj-code
     3247     ,input  'shift-on=request'
     3248     ,output l-shift-on
     3249     )  .
     3250       assign
     3251         tt-fin-doc.shift-flag = (if l-shift-on
     3252                                     and lookup(tt-fin-doc.fin-ext-doc-type, 'пко,рко':U) > 0
     3253                                     and (tt-fin-doc.doc-author = 'manual':U or tt-fin-doc.doc-author = 'auto':U)
     3254                                     and v-obj-db-num = v-cntxt-db-num
     3255                                     then integer('1':U)
     3256                                     else 0)
     3257         .
     3258       for each thbjattr_thbj-attr:
     3259         delete thbjattr_thbj-attr.
     3260       end.
     3261       define variable mCashBook         as class     ibs.th.ref.cashbookstorage no-undo .
     3262       define variable par-type          as character no-undo .
     3263       define variable v-dpt-option      as character no-undo .
     3264       define variable v-dpt-dflt-name   as character no-undo .
     3265       define variable v-dpt-dflt-type   as character no-undo .
     3266       define variable v-dpt-dflt-code   as integer   no-undo .
     3267       define variable v-value-character as character no-undo .
     3268       define variable v-value-date      as date      no-undo .
     3269       define variable v-value-decimal   as decimal   no-undo .
     3270       define variable v-value-integer   as INTEGER   no-undo .
     3271       define variable v-value-logical   AS LOGICAL   no-undo .
     3272       define variable v-tth             as handle    no-undo .
     3273       define variable v-naznach-plat    as character no-undo .
     3274       define variable v-enclosure       as character no-undo .
     3275       define variable o-head-position   as character no-undo .
     3276       define variable o-director        as character no-undo .
     3277       define variable o-snr-accnt       as character no-undo .
     3278       define variable o-cashier         as character no-undo .
     3279       define variable v-head-position   as character no-undo .
     3280       define variable v-director        as character no-undo .
     3281       define variable v-snr-accnt       as character no-undo .
     3282       define variable v-cashier         as character no-undo .
     3283       define variable v-hist-code       as character no-undo .
     3284       define variable v-hist-name       as character no-undo .
     3285       define buffer buf_sysconf for ub.sysconf.
     3286       define buffer buf_shop    for ub.shop .
     3287       define buffer buf_store   for ub.store .
     3288       define buffer buf_firm    for ub.firm .
     3289       assign
     3290         v-tth = buffer thbjattr_thbj-attr:table-handle .
     3291       mCashBook = new ibs.th.ref.cashbookstorage () .
     3292       v-dpt-option    = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "Struct") .
     3293       v-dpt-dflt-name = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "DptName") .
     3294       v-dpt-dflt-type = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "DptType") .
     3295       v-dpt-dflt-code = integer(mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "DptCode")) .
     3296       o-head-position = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "ManagerPosition") .
     3297       o-director      = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "ManagerFIO") .
     3298       o-snr-accnt     = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "BuhFIO") .
     3299       delete object mCashBook no-error .
     3300       case v-dpt-option:
     3301         when "1" then
     3302           do:
     3303             for first ub.db-attr no-lock where ub.db-attr.db-num = v-cntxt-db-num
     3304             and ub.db-attr.attr-code = 'hist-code':U:
     3305               v-hist-code = ub.db-attr.attr-value .
     3306             end.
     3307             for first ub.db-attr no-lock where ub.db-attr.db-num = v-cntxt-db-num
     3308             and ub.db-attr.attr-code = 'hist-name':U:
     3309               v-hist-name = ub.db-attr.attr-value .
     3310             end.
     3311             if v-hist-code = "" then v-dpt-dflt-code = X_clients-obj.obj-code .
     3312             if v-hist-name = "" then v-dpt-dflt-name = X_clients-obj.obj-name .
     3313             v-dpt-dflt-type = X_clients-obj.obj-type  .
     3314           end.
     3315         when "0" then
     3316           do:
     3317             assign
     3318               v-dpt-dflt-name = ''
     3319               v-dpt-dflt-type = ''
     3320               v-dpt-dflt-code = 0
     3321               .
     3322           end.
     3323         otherwise
     3324         do:
     3325           assign
     3326             v-dpt-dflt-name = v-dpt-dflt-name
     3327             v-dpt-dflt-type = v-dpt-dflt-type
     3328             v-dpt-dflt-code = v-dpt-dflt-code
     3329             .
     3330         end.
     3331       end case.
     3332       find first buf_sysconf no-error .
     3333       case o-head-position:
     3334         when '0':U then
     3335           do:
     3336             v-head-position = buf_sysconf.head-position.
     3337           end.
     3338         when '1':U then
     3339           do:
     3340             v-head-position = "Директор".
     3341           end.
     3342         when '2':U then
     3343           do:
     3344             v-head-position = "Управляющий".
     3345           end.
     3346         otherwise
     3347         do :
     3348           v-head-position = o-head-position.
     3349         end.
     3350       end case.
     3351       find first buf_firm no-lock where
     3352         buf_firm.firm-code = buf_sysconf.host-code.
     3353       case o-director:
     3354         when '1':U then
     3355           do:
     3356             if p-obj-type = 'маг':U then
     3357             do:
     3358               find first buf_shop no-lock where
     3359                 buf_shop.obj-code = p-obj-code no-error .
     3360               if available buf_shop then
     3361               do:
     3362                 v-director = buf_shop.director.
     3363               end.
     3364             end.
     3365             if p-obj-type = 'скл':U then
     3366             do:
     3367               find first buf_store no-lock where
     3368                 buf_store.obj-code = p-obj-code no-error .
     3369               if available buf_store then
     3370               do:
     3371                 v-director = buf_store.store-boss.
     3372               end.
     3373             end.
     3374           end.
     3375         when '0':U then
     3376           do:
     3377             v-director = buf_firm.director.
     3378           end.
     3379         otherwise
     3380         do:
     3381           v-director = o-director .
     3382         end.
     3383       end case.
     3384       case o-snr-accnt:
     3385         when '1':U then
     3386           do:
     3387             if p-obj-type = 'маг':U then
     3388             do:
     3389               find first buf_shop no-lock where
     3390                 buf_shop.obj-code = p-obj-code no-error .
     3391               if available buf_shop then
     3392               do:
     3393                 v-snr-accnt = entry(1,buf_shop.acct,"|").
     3394               end.
     3395             end.
     3396             if p-obj-type = 'скл':U then
     3397             do:
     3398               v-snr-accnt = ''.
     3399             end.
     3400           end.
     3401         when '2':U then
     3402           do:
     3403             v-snr-accnt = buf_sysconf.snr-accnt.
     3404           end.
     3405         otherwise
     3406         do:
     3407           v-snr-accnt = o-snr-accnt .
     3408         end.
     3409       end case.
     3410     if tt-fin-doc.shift-flag = integer('1':U) then
     3411     do:
     3412       define variable v-fin-doc-shift-date      as date      no-undo .
     3413       define variable v-fin-doc-shift-num       as integer   no-undo .
     3414       define variable v-fin-doc-shift-name      as character no-undo .
     3415       define variable v-fin-doc-shift-date-char as character no-undo .
     3416       define variable v-fin-doc-shift-num-char  as character no-undo .
     3417       define variable varobj-shift-date         as date      no-undo .
     3418       define variable varobj-shift-num          as integer   no-undo .
     3419       define variable varobj-shift-name         as character no-undo .
     3420       define variable v-can-back-shift          as logical   no-undo .
     3421   define variable vss-include-info25 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3422   do:
     3423     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3424       (input  v-cntxt-db-num
     3425       ,input  v-cntxt-userid
     3426       ,input  0
     3427       ,input  'actn_fin-doc_create-back-shift':U
     3428       ,input  'object':U
     3429       ,input  tt-fin-doc.host-code
     3430       ,input  tt-fin-doc.obj-type
     3431       ,input  tt-fin-doc.obj-code
     3432       ,input  0
     3433       ,input  0
     3434       ,input  0
     3435       ,input  false
     3436       ,output v-can-back-shift
     3437       )  .
     3438   end.
     3439   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3440   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     3441     (input  tt-fin-doc.obj-type
     3442     ,input  tt-fin-doc.obj-code
     3443     ,output varobj-shift-date
     3444     ,output varobj-shift-num
     3445     ,output varobj-shift-name
     3446     ) no-error .
     3447       if error-status :error then
     3448       do:
     3449         if not v-can-back-shift then
     3450         do:
     3451           return error substitute("Не найдена текущая смена на &1&2", tt-fin-doc.obj-type, tt-fin-doc.obj-code).
     3452         end.
     3453         else
     3454         do:
     3455           run proc-sht in this-procedure .
     3456         end.
     3457       end.
     3458       else
     3459       do:
     3460         assign
     3461           tt-fin-doc.shift-date = varobj-shift-date
     3462           tt-fin-doc.shift-num  = varobj-shift-num
     3463           tt-fin-doc.shift-name = varobj-shift-name
     3464           .
     3465       end.
     3466       define variable v-date as date    no-undo  .
     3467       define variable v-time as integer no-undo .
     3468       run cur-time in this-procedure(output v-date, output v-time).
     3469       display
     3470         tt-fin-doc.shift-date
     3471         tt-fin-doc.shift-num
     3472         tt-fin-doc.shift-name
     3473         with frame Dialog-Frame .
     3474       enable
     3475         r-sht
     3476         when (tt-fin-doc.shift-flag = integer('1':U) and v-limit-access = 0 and v-can-back-shift)
     3477         with frame Dialog-Frame.
     3478     end.
     3479     else
     3480     do:
     3481       hide
     3482         tt-fin-doc.shift-date
     3483         tt-fin-doc.shift-num
     3484         tt-fin-doc.shift-name
     3485         in frame Dialog-Frame .
     3486       disable
     3487         r-sht
     3488         with frame Dialog-Frame .
     3489     end.
     3490     FIND FIRST ub.shift-staff No-LOCK WHERE
     3491       ub.shift-staff.obj-type   = p-obj-type AND
     3492       ub.shift-staff.obj-code   = p-obj-code AND
     3493       ub.shift-staff.shift-date = tt-fin-doc.shift-date AND
     3494       ub.shift-staff.shift-num  = tt-fin-doc.shift-num AND
     3495       ub.shift-staff.staff-role = no and
     3496       ub.shift-staff.psn-num    >= 0 No-ERROR.
     3497     assign
     3498       v-cashier = if available ub.shift-staff then string(ub.shift-staff.name, "X(30)") else "".
     3499     .
     3500     if tt-fin-doc.fin-ext-doc-type = 'рко':U then
     3501     do:
     3502       assign
     3503         tt-fin-doc.payer-sign1 = v-director
     3504         tt-fin-doc.payer-sign2 = v-snr-accnt
     3505         tt-fin-doc.payer-sign3 = v-cashier
     3506         .
     3507     end.
     3508     if tt-fin-doc.fin-ext-doc-type = 'пко':U then
     3509     do:
     3510       assign
     3511         tt-fin-doc.receiver-sign2 = v-snr-accnt
     3512         tt-fin-doc.receiver-sign3 = v-cashier
     3513         .
     3514     end.
     3515     find first ub.CashBook no-lock where ub.CashBook.id = tt-fin-doc.CashBookId no-error .
     3516     if available (ub.CashBook) then
     3517     do:
     3518       case ub.CashBook.RuleOsnRko:
     3519         when "0" then
     3520           tt-fin-doc.naznach-plat = "Выручка от реализации" .
     3521         when "1" or
     3522         when "2" then
     3523           tt-fin-doc.naznach-plat = "" .
     3524         otherwise
     3525         tt-fin-doc.naznach-plat = ub.CashBook.RuleOsnRko .
     3526       end case .
     3527       case ub.CashBook.RulePril:
     3528         when '0' then
     3529           do:
     3530             tt-fin-doc.enclosure = v-naznach-plat .
     3531           end.
     3532         when '1' then
     3533           do:
     3534             tt-fin-doc.enclosure = "" .
     3535           end.
     3536         otherwise
     3537         tt-fin-doc.enclosure = ub.CashBook.RulePril .
     3538       end case.
     3539       if ub.CashBook.CorrRko <> "" then
     3540       do:
     3541         for first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.code-value = ub.CashBook.CorrRko
     3542           and ub.fin-code-cor-acc.host-code = p-curr-host-code :
     3543           tt-fin-doc.cor-acc = ub.fin-code-cor-acc.fin-code .
     3544           tt-fin-doc.cor-acc-value = ub.fin-code-cor-acc.code-value .
     3545         end.
     3546       end.
     3547       if tt-fin-doc.cor-acc = ? or tt-fin-doc.cor-acc = 0 then
     3548       do:
     3549         for first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.code-value = "57.01"
     3550           and ub.fin-code-cor-acc.host-code = p-curr-host-code :
     3551           tt-fin-doc.cor-acc = ub.fin-code-cor-acc.fin-code .
     3552           tt-fin-doc.cor-acc-value = ub.fin-code-cor-acc.code-value .
     3553         end.
     3554       end.
     3555       if ub.CashBook.OsnAcct <> "" then
     3556       do:
     3557         for first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.code-value = ub.CashBook.OsnAcct
     3558           and ub.fin-code-cor-acc.host-code = p-curr-host-code :
     3559           tt-fin-doc.cor-acc1 = ub.fin-code-cor-acc.fin-code .
     3560           tt-fin-doc.cor-acc1-value = ub.fin-code-cor-acc.code-value .
     3561         end.
     3562       end.
     3563     end.
     3564     assign
     3565       tt-fin-doc.str-podr-name = if v-hist-name = "" then v-dpt-dflt-name else v-hist-name
     3566       tt-fin-doc.str-podr-type = v-dpt-dflt-type
     3567       tt-fin-doc.str-podr-code = v-dpt-dflt-code
     3568       .
     3569     display
     3570       tt-fin-doc.str-podr-name
     3571       tt-fin-doc.str-podr-type
     3572       tt-fin-doc.str-podr-code
     3573       tt-fin-doc.enclosure
     3574       tt-fin-doc.naznach-plat
     3575       tt-fin-doc.cor-acc
     3576       tt-fin-doc.cor-acc1
     3577       tt-fin-doc.cor-acc1-value
     3578       tt-fin-doc.cor-acc-value
     3579       tt-fin-doc.payer-sign1
     3580       tt-fin-doc.payer-sign1:label = "Рук. орг-ции"  +
     3581          (if v-head-position <> ''
     3582          then " - ":U + v-head-position
     3583          else '')
     3584       tt-fin-doc.payer-sign2
     3585       tt-fin-doc.payer-sign3
     3586       with frame Dialog-Frame .
     3587     end.
     3588     else
     3589     do:
     3590       assign
     3591         tt-fin-doc.shift-flag = 0
     3592         .
     3593     end.
     3594   END PROCEDURE.
     3595   ON CHOOSE OF B-calc IN FRAME Dialog-Frame
     3596     DO:
     3597       run ref/findclci.w (
     3598         INPUT          parParentProc
     3599         ,input          "":U
     3600         ,INPUT          tt-fin-doc.doc-date
     3601         ,INPUT          tt-fin-doc.curr-code
     3602         ,INPUT          v-base-code
     3603         ,INPUT          tt-fin-doc.contract-curr
     3604         ,INPUT-OUTPUT   tt-fin-doc.sum-doc
     3605         ,INPUT-OUTPUT   tt-fin-doc.exch-rate
     3606         ,INPUT-OUTPUT   tt-fin-doc.exch-scale
     3607         ,INPUT-OUTPUT   tt-fin-doc.sum-rubl
     3608         ,INPUT-OUTPUT   tt-fin-doc.sum-base
     3609         ,INPUT-OUTPUT   tt-fin-doc.base-rate
     3610         ,INPUT-OUTPUT   tt-fin-doc.base-scale
     3611         ,INPUT-OUTPUT   tt-fin-doc.sum-contr
     3612         ,INPUT-OUTPUT   tt-fin-doc.contract-rate
     3613         ,INPUT-OUTPUT   tt-fin-doc.contract-scale ) no-error.
     3614       if error-status:error then return no-apply.
     3615       assign
     3616         f-rest-con-sum = tt-fin-doc.sum-contr - tt-fin-doc.con-sum-contr
     3617         .
     3618       display
     3619         tt-fin-doc.sum-rubl
     3620         when v-rubf
     3621         tt-fin-doc.sum-doc
     3622         tt-fin-doc.exch-rate
     3623         when v-exchf
     3624         tt-fin-doc.exch-scale
     3625         when v-exchf
     3626         tt-fin-doc.sum-base
     3627         when v-basef
     3628         tt-fin-doc.base-rate
     3629         when v-baseratef
     3630         tt-fin-doc.base-scale
     3631         when v-baseratef
     3632         tt-fin-doc.sum-contr
     3633         when v-contractf
     3634         tt-fin-doc.contract-rate
     3635         when v-contractratef
     3636         tt-fin-doc.contract-scale
     3637         when v-contractratef
     3638         f-rest-con-sum
     3639         with frame Dialog-Frame .
     3640     END.
     3641   ON CHOOSE OF B-receiver IN FRAME Dialog-Frame
     3642     DO:
     3643       define variable ref-list as character no-undo.
     3644       define variable ref-rec  as recid     no-undo.
     3645       define variable v-sum-vat-chr  as character no-undo .
     3646       define variable v-each-vat-chr as character no-undo.
     3647       define variable v-sum-vat      like ub.fin-doc-tax.sum-vat-line-doc no-undo .
     3648       define buffer buf_clients for ub.clients.
     3649   define variable vss-include-info27 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3650   if lookup(self :type
     3651            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3652            ) = 0
     3653   then do:
     3654     message
     3655       "$Workfile$"
     3656       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3657       "Интерфейсный элемент" self :name  skip
     3658       "Тип" self :type  skip
     3659       "Процедура" this-procedure :file-name skip
     3660       view-as alert-box .
     3661   end.
     3662   else do:
     3663     apply "entry":u to self  .
     3664     if focus :handle <> self :handle  then do:
     3665       return no-apply .
     3666     end.
     3667   end.
     3668   run ref/cli-all.w ( parParentProc
     3669     ,"b-sel"
     3670     , tt-fin-doc.receiver-type
     3671     , ?
     3672     , ?
     3673     , (if available X_receiver then recid(X_receiver) else ?)
     3674     , ?
     3675     , "without-obj":U
     3676     , output ref-list) .
     3677   if ref-list = "" then
     3678   do:
     3679     return no-apply.
     3680   end.
     3681   ref-rec = integer( ref-list ).
     3682   FIND FIRST buf_clients WHERE recid (buf_clients) = ref-rec NO-LOCK .
     3683   if NOT (buf_clients.obj-type = 'орг':U
     3684     or
     3685     buf_clients.obj-type = 'чел':U ) then
     3686   do:
     3687     message
     3688       "Выберите контрагента типа" 'орг':U "или" 'чел':U
     3689       view-as alert-box error .
     3690     return no-apply.
     3691   end.
     3692   find first X_receiver no-lock where
     3693     recid(X_receiver) = recid(buf_clients).
     3694   assign
     3695     tt-fin-doc.receiver-type = buf_clients.obj-type
     3696     tt-fin-doc.receiver-code = buf_clients.obj-code
     3697     tt-fin-doc.receiver-name = buf_clients.obj-name
     3698     .
     3699   display
     3700     tt-fin-doc.receiver-type
     3701     tt-fin-doc.receiver-code
     3702     tt-fin-doc.receiver-name
     3703     with frame Dialog-Frame.
     3704   CASE X_receiver.obj-type:   when 'чел':U then do:              find first X_receiver-person no-lock where               X_receiver-person.psn-code = X_receiver.obj-code .   end.   when 'орг':U then do:     find first X_receiver-firm no-lock where               X_receiver-firm.firm-code = X_receiver.obj-code .   end. END CASE.   assign   tt-fin-doc.receiver-type =  X_receiver.obj-type   tt-fin-doc.receiver-code = X_receiver.obj-code   tt-fin-doc.receiver-name = X_receiver.obj-name   tt-fin-doc.receiver-passport = (if X_receiver.obj-type = 'чел':U                             then  (X_receiver-person.passp-ser  + chr(32)  +                                    X_receiver-person.passp-num  + chr(32)  +                                    X_receiver-person.given-by)                             else  (X_receiver-firm.passp-ser  + chr(32)  +                                    X_receiver-firm.passp-num  + chr(32)  +                                    X_receiver-firm.given-by)                             )   . display tt-fin-doc.receiver-type tt-fin-doc.receiver-code tt-fin-doc.receiver-name tt-fin-doc.receiver-passport with frame Dialog-Frame.
     3705   find first ub.CashBook no-lock where ub.CashBook.id = tt-fin-doc.cashbookId no-error .
     3706   if ub.CashBook.cli-code = tt-fin-doc.receiver-code and ub.CashBook.cli-type = tt-fin-doc.receiver-type then do:
     3707   assign
     3708     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     3709     tt-fin-doc.cor-acc-value  = ub.CashBook.corrPko
     3710     tt-fin-doc.naznach-plat   = ub.CashBook.RuleOsnPko
     3711     .
     3712   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     3713     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     3714     and X_fin-code-cor-acc.status_ = integer('0':U)
     3715     no-error .
     3716   if available X_fin-code-cor-acc
     3717     then
     3718   do :
     3719     assign
     3720       f-cor-acc-descr    = X_fin-code-cor-acc.descr
     3721       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     3722       .
     3723   end.
     3724   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     3725     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     3726     and X_fin-code-cor-acc1.status_ = integer('0':U)
     3727     no-error .
     3728   if available X_fin-code-cor-acc1
     3729     then
     3730   do :
     3731     assign
     3732       f-cor-acc1-descr   = X_fin-code-cor-acc1.descr
     3733       tt-fin-doc.cor-acc = X_fin-code-cor-acc1.fin-code
     3734       .
     3735   end.
     3736   assign
     3737     tt-fin-doc.including = "@, в том числе НДС" .
     3738     paramVne = "" .
     3739   end.
     3740   else
     3741   do:
     3742     if getCliKassa(tt-fin-doc.receiver-type, tt-fin-doc.receiver-code, "Vnecli", tt-fin-doc.cashbookId) then do:
     3743   assign
     3744     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     3745     .
     3746   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     3747     and ub.CashBookRule.Obj-type   = 'всем':U
     3748     and ub.CashBookRule.Obj-code   = 0
     3749     and ub.CashBookRule.Code       = "corrPkoVne"
     3750     no-error.
     3751   if available (ub.CashBookRule) then tt-fin-doc.cor-acc-value = ub.CashBookRule.RuleValue .
     3752   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     3753     and ub.CashBookRule.Obj-type   = 'всем':U
     3754     and ub.CashBookRule.Obj-code   = 0
     3755     and ub.CashBookRule.Code       = "RuleOsnPkoVne"
     3756     no-error.
     3757   if available (ub.CashBookRule) then tt-fin-doc.naznach-plat = ub.CashBookRule.RuleValue .
     3758   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     3759     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     3760     and X_fin-code-cor-acc.status_ = integer('0':U)
     3761     no-error .
     3762   if available X_fin-code-cor-acc
     3763     then
     3764   do :
     3765     assign
     3766       f-cor-acc-descr    = X_fin-code-cor-acc.descr
     3767       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     3768       .
     3769   end.
     3770   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     3771     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     3772     and X_fin-code-cor-acc1.status_ = integer('0':U)
     3773     no-error .
     3774   if available X_fin-code-cor-acc1
     3775     then
     3776   do :
     3777     assign
     3778       f-cor-acc1-descr   = X_fin-code-cor-acc1.descr
     3779       tt-fin-doc.cor-acc = X_fin-code-cor-acc1.fin-code
     3780       .
     3781   end.
     3782   assign
     3783     tt-fin-doc.including = "@, в т.ч.: без налога (НДС)" .
     3784     paramVne = "vne" .
     3785   end.
     3786   else do:
     3787     if getCliKassa(tt-fin-doc.receiver-type, tt-fin-doc.receiver-code, "Avanscli", tt-fin-doc.cashbookId) then do:
     3788   assign
     3789     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     3790     .
     3791   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     3792     and ub.CashBookRule.Obj-type   = 'всем':U
     3793     and ub.CashBookRule.Obj-code   = 0
     3794     and ub.CashBookRule.Code       = "corrPkoAvans"
     3795     no-error.
     3796   if available (ub.CashBookRule) then tt-fin-doc.cor-acc-value = ub.CashBookRule.RuleValue .
     3797   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     3798     and ub.CashBookRule.Obj-type   = 'всем':U
     3799     and ub.CashBookRule.Obj-code   = 0
     3800     and ub.CashBookRule.Code       = "RuleOsnPkoAvans"
     3801     no-error.
     3802   if available (ub.CashBookRule) then tt-fin-doc.naznach-plat = ub.CashBookRule.RuleValue .
     3803   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     3804     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     3805     and X_fin-code-cor-acc.status_ = integer('0':U)
     3806     no-error .
     3807   if available X_fin-code-cor-acc
     3808     then
     3809   do :
     3810     assign
     3811       f-cor-acc-descr    = X_fin-code-cor-acc.descr
     3812       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     3813       .
     3814   end.
     3815   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     3816     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     3817     and X_fin-code-cor-acc1.status_ = integer('0':U)
     3818     no-error .
     3819   if available X_fin-code-cor-acc1
     3820     then
     3821   do :
     3822     assign
     3823       f-cor-acc1-descr   = X_fin-code-cor-acc1.descr
     3824       tt-fin-doc.cor-acc = X_fin-code-cor-acc1.fin-code
     3825       .
     3826   end.
     3827   assign
     3828     tt-fin-doc.including = "@, в т.ч. 22/122 (НДС)" .
     3829     paramVne = "avans" .
     3830   end.
     3831   else do:
     3832   tt-fin-doc.naznach-plat = "".
     3833   tt-fin-doc.including = "@, в том числе НДС" .
     3834   paramVne = "" .
     3835   end.
     3836   end.
     3837   end.
     3838   run proc-create-default-tax in this-procedure .
     3839   run change-view in this-procedure(rs-view).
     3840   END.
     3841   ON LEAVE OF tt-fin-doc.receiver-code IN FRAME Dialog-Frame
     3842     DO:
     3843   define variable vss-include-info28 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3844   if lookup(self :type
     3845            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3846            ) = 0
     3847   then do:
     3848     message
     3849       "$Workfile$"
     3850       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3851       "Интерфейсный элемент" self :name  skip
     3852       "Тип" self :type  skip
     3853       "Процедура" this-procedure :file-name skip
     3854       view-as alert-box .
     3855   end.
     3856   else do:
     3857     apply "entry":u to self  .
     3858     if focus :handle <> self :handle  then do:
     3859       return no-apply .
     3860     end.
     3861   end.
     3862   if   input frame Dialog-Frame tt-fin-doc.receiver-code <> 0 then
     3863   do:
     3864     run check-receiver in this-procedure no-error.
     3865     if error-status:error then
     3866     do:
     3867       return no-apply.
     3868     end.
     3869     CASE X_receiver.obj-type:   when 'чел':U then do:              find first X_receiver-person no-lock where               X_receiver-person.psn-code = X_receiver.obj-code .   end.   when 'орг':U then do:     find first X_receiver-firm no-lock where               X_receiver-firm.firm-code = X_receiver.obj-code .   end. END CASE.   assign   tt-fin-doc.receiver-type =  X_receiver.obj-type   tt-fin-doc.receiver-code = X_receiver.obj-code   tt-fin-doc.receiver-name = X_receiver.obj-name   tt-fin-doc.receiver-passport = (if X_receiver.obj-type = 'чел':U                             then  (X_receiver-person.passp-ser  + chr(32)  +                                    X_receiver-person.passp-num  + chr(32)  +                                    X_receiver-person.given-by)                             else  (X_receiver-firm.passp-ser  + chr(32)  +                                    X_receiver-firm.passp-num  + chr(32)  +                                    X_receiver-firm.given-by)                             )   . display tt-fin-doc.receiver-type tt-fin-doc.receiver-code tt-fin-doc.receiver-name tt-fin-doc.receiver-passport with frame Dialog-Frame.
     3870   end.
     3871   END.
     3872   ON VALUE-CHANGED OF tt-fin-doc.receiver-type IN FRAME Dialog-Frame
     3873     DO:
     3874       assign
     3875         tt-fin-doc.receiver-type.
     3876       if   input frame Dialog-Frame tt-fin-doc.receiver-code <> 0 then
     3877       do:
     3878         run check-receiver in this-procedure no-error.
     3879         if error-status:error then
     3880         do:
     3881           return no-apply.
     3882         end.
     3883         CASE X_receiver.obj-type:   when 'чел':U then do:              find first X_receiver-person no-lock where               X_receiver-person.psn-code = X_receiver.obj-code .   end.   when 'орг':U then do:     find first X_receiver-firm no-lock where               X_receiver-firm.firm-code = X_receiver.obj-code .   end. END CASE.   assign   tt-fin-doc.receiver-type =  X_receiver.obj-type   tt-fin-doc.receiver-code = X_receiver.obj-code   tt-fin-doc.receiver-name = X_receiver.obj-name   tt-fin-doc.receiver-passport = (if X_receiver.obj-type = 'чел':U                             then  (X_receiver-person.passp-ser  + chr(32)  +                                    X_receiver-person.passp-num  + chr(32)  +                                    X_receiver-person.given-by)                             else  (X_receiver-firm.passp-ser  + chr(32)  +                                    X_receiver-firm.passp-num  + chr(32)  +                                    X_receiver-firm.given-by)                             )   . display tt-fin-doc.receiver-type tt-fin-doc.receiver-code tt-fin-doc.receiver-name tt-fin-doc.receiver-passport with frame Dialog-Frame.
     3884       end.
     3885     END.
     3886   PROCEDURE check-receiver :
     3887     define buffer buf_clients for ub.clients.
     3888     find first buf_clients no-lock where
     3889       buf_clients.obj-code = input frame Dialog-Frame tt-fin-doc.receiver-code
     3890       and buf_clients.obj-type = input frame Dialog-Frame tt-fin-doc.receiver-type no-error.
     3891     if not available buf_clients then
     3892     do:
     3893       if input frame Dialog-Frame tt-fin-doc.receiver-code <> ?  then
     3894         message "Неправильный код или тип " 'ПОЛУЧАТЕЛЯ'.
     3895       apply "entry" to tt-fin-doc.receiver-code in frame Dialog-Frame.
     3896       return error.
     3897     end.
     3898     find first X_receiver no-lock where recid(X_receiver) = recid(buf_clients).
     3899     assign
     3900       tt-fin-doc.receiver-type = buf_clients.obj-type
     3901       tt-fin-doc.receiver-code = buf_clients.obj-code
     3902       tt-fin-doc.receiver-name = buf_clients.obj-name
     3903       .
     3904   find first ub.CashBook no-lock where ub.CashBook.id = tt-fin-doc.cashbookId no-error .
     3905   if ub.CashBook.cli-code = tt-fin-doc.receiver-code and ub.CashBook.cli-type = tt-fin-doc.receiver-type then do:
     3906   assign
     3907     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     3908     tt-fin-doc.cor-acc-value  = ub.CashBook.corrPko
     3909     tt-fin-doc.naznach-plat   = ub.CashBook.RuleOsnPko
     3910     .
     3911   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     3912     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     3913     and X_fin-code-cor-acc.status_ = integer('0':U)
     3914     no-error .
     3915   if available X_fin-code-cor-acc
     3916     then
     3917   do :
     3918     assign
     3919       f-cor-acc-descr    = X_fin-code-cor-acc.descr
     3920       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     3921       .
     3922   end.
     3923   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     3924     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     3925     and X_fin-code-cor-acc1.status_ = integer('0':U)
     3926     no-error .
     3927   if available X_fin-code-cor-acc1
     3928     then
     3929   do :
     3930     assign
     3931       f-cor-acc1-descr   = X_fin-code-cor-acc1.descr
     3932       tt-fin-doc.cor-acc = X_fin-code-cor-acc1.fin-code
     3933       .
     3934   end.
     3935   end.
     3936   else
     3937   do:
     3938   if getCliKassa(tt-fin-doc.receiver-type, tt-fin-doc.receiver-code, "Vnecli", tt-fin-doc.cashbookId) then do:
     3939   assign
     3940     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     3941     .
     3942   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     3943     and ub.CashBookRule.Obj-type   = 'всем':U
     3944     and ub.CashBookRule.Obj-code   = 0
     3945     and ub.CashBookRule.Code       = "corrPkoVne"
     3946     no-error.
     3947   if available (ub.CashBookRule) then tt-fin-doc.cor-acc-value = ub.CashBookRule.RuleValue .
     3948   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     3949     and ub.CashBookRule.Obj-type   = 'всем':U
     3950     and ub.CashBookRule.Obj-code   = 0
     3951     and ub.CashBookRule.Code       = "RuleOsnPkoVne"
     3952     no-error.
     3953   if available (ub.CashBookRule) then tt-fin-doc.naznach-plat = ub.CashBookRule.RuleValue .
     3954   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     3955     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     3956     and X_fin-code-cor-acc.status_ = integer('0':U)
     3957     no-error .
     3958   if available X_fin-code-cor-acc
     3959     then
     3960   do :
     3961     assign
     3962       f-cor-acc-descr    = X_fin-code-cor-acc.descr
     3963       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     3964       .
     3965   end.
     3966   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     3967     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     3968     and X_fin-code-cor-acc1.status_ = integer('0':U)
     3969     no-error .
     3970   if available X_fin-code-cor-acc1
     3971     then
     3972   do :
     3973     assign
     3974       f-cor-acc1-descr   = X_fin-code-cor-acc1.descr
     3975       tt-fin-doc.cor-acc = X_fin-code-cor-acc1.fin-code
     3976       .
     3977   end.
     3978   end.
     3979   else do:
     3980   if getCliKassa(tt-fin-doc.receiver-type, tt-fin-doc.receiver-code, "Avanscli", tt-fin-doc.cashbookId) then do:
     3981   assign
     3982     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     3983     .
     3984   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     3985     and ub.CashBookRule.Obj-type   = 'всем':U
     3986     and ub.CashBookRule.Obj-code   = 0
     3987     and ub.CashBookRule.Code       = "corrPkoAvans"
     3988     no-error.
     3989   if available (ub.CashBookRule) then tt-fin-doc.cor-acc-value = ub.CashBookRule.RuleValue .
     3990   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     3991     and ub.CashBookRule.Obj-type   = 'всем':U
     3992     and ub.CashBookRule.Obj-code   = 0
     3993     and ub.CashBookRule.Code       = "RuleOsnPkoAvans"
     3994     no-error.
     3995   if available (ub.CashBookRule) then tt-fin-doc.naznach-plat = ub.CashBookRule.RuleValue .
     3996   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     3997     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     3998     and X_fin-code-cor-acc.status_ = integer('0':U)
     3999     no-error .
     4000   if available X_fin-code-cor-acc
     4001     then
     4002   do :
     4003     assign
     4004       f-cor-acc-descr    = X_fin-code-cor-acc.descr
     4005       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     4006       .
     4007   end.
     4008   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     4009     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     4010     and X_fin-code-cor-acc1.status_ = integer('0':U)
     4011     no-error .
