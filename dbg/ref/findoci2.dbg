     4703     v-curr-code = tt-fin-doc.curr-code
     4704     tt-fin-doc.curr-code.
     4705   if available X_currency then rr = recid(X_currency).
     4706   else rr = ?.
     4707   run ref/currency.w (parparentproc, "b-sel", input-output rr ).
     4708   if rr <> ? then
     4709   do:
     4710     FIND FIRST X_currency WHERE
     4711       recid( X_currency ) = rr NO-LOCK .
     4712     assign
     4713       tt-fin-doc.curr-code = X_currency.curr-code
     4714       f-curr-abbr          = X_currency.curr-abbr
     4715       .
     4716     DISPLAY
     4717       tt-fin-doc.curr-code
     4718       f-curr-abbr
     4719       with frame Dialog-Frame .
     4720   end.
     4721   if tt-fin-doc.curr-code <> v-curr-code then
     4722   do:
     4723     run recalc in this-procedure("curr-code":U) no-error.
     4724     if error-status:error then
     4725     do:
     4726       assign
     4727         tt-fin-doc.curr-code = v-curr-code
     4728         .
     4729       display tt-fin-doc.curr-code
     4730         with frame Dialog-Frame.
     4731     end.
     4732     run hide-view-currency in this-procedure .
     4733   end.
     4734   END.
