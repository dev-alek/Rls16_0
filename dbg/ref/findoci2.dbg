      128   DEFINE TEMP-TABLE ttc-fin-doc NO-UNDO LIKE ub.fin-doc.
      129   define variable v-base-code like ub.sysconf.host-code no-undo.
      130   define variable v-tab-order as character no-undo.
      131   define variable v-head-position as character no-undo .
      132   define variable v-an-uchet-tab-order as character no-undo.
      133   define variable v-sum-curr-tab-order as character no-undo.
