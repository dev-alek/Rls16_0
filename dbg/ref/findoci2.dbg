     5727   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5728   procedure minbtn-set :
     5729       do
     5730           on error undo, return error return-value
     5731           :
     5732           define variable ii              as integer       no-undo .
     5733           define variable fh              as widget-handle no-undo .
     5734           define variable hh              as widget-handle no-undo .
     5735           define variable v-h             as handle        extent 4 no-undo .
     5736           define variable v-name-button   as character     no-undo .
     5737           define variable v-help-old-x    as decimal       no-undo .
     5738           define variable v-help-old-y    as decimal       no-undo .
     5739           define variable v-help-old-size as decimal       no-undo .
     5740           define variable v-frame-width   as decimal       no-undo .
     5741           define variable jj              as integer       no-undo .
     5742           do
     5743               on error undo, return error
     5744               :
     5745               assign
     5746                   v-frame-width = frame Dialog-Frame:width - 0.3
     5747                   fh            = frame Dialog-Frame:first-child
     5748                   hh            = fh:first-child
     5749                   ii            = 1
     5750                   .
     5751               do while valid-handle(hh):
     5752                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     5753                   do:
     5754                       case lc(hh:name) :
     5755                           when "b-help" then
     5756                               do:
     5757                                   hh:load-image-up("cmp/b-help.bmp":u) .
     5758                                   hh:load-image-down("cmp/b-help.bmp":u) .
     5759                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     5760                                   hh:TOOLTIP = "Помощь" .
     5761                                   v-help-old-x = hh:column .
     5762                                   v-help-old-y = hh:row    .
     5763                                   v-help-old-size = hh:width .
     5764                                   hh:width-chars = 2.5 .
     5765                               end.
     5766                           when "b-print" then
     5767                               do:
     5768                                   hh:load-image("cmp/b-print.bmp":u) .
     5769                                   hh:TOOLTIP = "Печать" .
     5770                                   v-h[ii] = hh:handle .
     5771                                   ii = ii + 1 .
     5772                                   hh:width-chars = 3 .
     5773                               end.
     5774                           when "b-history" or
     5775                           when "b-hist" then
     5776                               do:
     5777                                   hh:load-image("cmp/b-hist.bmp":u) .
     5778                                   hh:TOOLTIP = "История" .
     5779                                   v-h[ii] = hh:handle .
     5780                                   ii = ii + 1 .
     5781                                   hh:width-chars = 3 .
     5782                               end.
     5783                           when "b-sch" then
     5784                               do:
     5785                                   hh:load-image("cmp/b-sch.bmp":u) .
     5786                                   hh:TOOLTIP = "Установка Фильтра" .
     5787                                   v-h[ii] = hh:handle .
     5788                                   ii = ii + 1 .
     5789                                   hh:width-chars = 3 .
     5790                               end.
     5791                           when "b-hist-user" then
     5792                               do:
     5793                                   hh:load-image("cmp/b-hist.bmp":u) .
     5794                                   hh:TOOLTIP = "История пользователя" .
     5795                                   ii = ii + 1 .
     5796                               end.
     5797                       end case.
     5798                   end.
     5799                   hh = hh:next-sibling.
     5800               end.
     5801               b-help:column = v-frame-width - b-help:width-chars.
     5802               jj = 0.
     5803               repeat ii = 4 to 1 by -1 :
     5804                   if valid-handle (v-h[ii] ) then
     5805                   do:
     5806                       jj  = jj + 1 .
     5807                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     5808                       v-h[ii]:row    = v-help-old-y .
     5809                   end.
     5810               end.
     5811           end.
     5812       end.
     5813   end procedure.
     5814   define variable vss-include-info56 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5815   ON TAB ANYWHERE
     5816   DO:
     5817   define variable ii as integer no-undo .
     5818   define variable fh as widget-handle no-undo .
     5819   define variable hh as widget-handle no-undo .
     5820   define variable v-next-widget-name as character no-undo .
     5821   if v-tab-order <> '' then do:
     5822     if self:type = "TOGGLE-BOX" then
     5823     self:BGCOLOR = ?.
     5824     assign
     5825     ii = lookup(self:name, v-tab-order).
     5826     assign
     5827     ii = ii + 1
     5828     v-next-widget-name = entry(ii, v-tab-order)
     5829     no-error .
     5830     if error-status:error then do:
     5831       assign
     5832       ii = 1
     5833       v-next-widget-name = entry( ii, v-tab-order)
     5834       .
     5835     end.
     5836     assign
     5837     fh = frame Dialog-Frame:first-child
     5838     hh = fh:first-child
     5839     .
     5840     do while valid-handle(hh):
     5841       if hh:name = v-next-widget-name then do:
     5842         if hh:sensitive  = yes
     5843         AND hh:visible = yes then do:
     5844           if hh:type = "TOGGLE-BOX":U then do:
     5845             assign
     5846             hh:BGcolor = 1
     5847             .
     5848           end.
     5849           APPLY "ENTRY" to hh.
     5850           return no-apply.
     5851         end.
     5852         else do:
     5853           APPLY "TAB" to hh.
     5854           return no-apply.
     5855         end.
     5856       end.
     5857       hh = hh:next-sibling.
     5858     end.
     5859   end.
     5860   END.
     5861   ON BACK-TAB ANYWHERE
     5862   DO:
     5863   define variable ii as integer no-undo .
     5864   define variable fh as widget-handle no-undo .
     5865   define variable hh as widget-handle no-undo .
     5866   define variable v-next-widget-name as character no-undo .
     5867   if v-tab-order <> '' then do:
     5868     assign
     5869     ii = lookup(self:name, v-tab-order).
     5870     .
     5871     assign
     5872     ii = (if ii = 1
     5873           then  num-entries(v-tab-order)
     5874           else ii - 1
     5875           )
     5876     v-next-widget-name = entry(ii, v-tab-order)
     5877     .
     5878     assign
     5879     fh = frame Dialog-Frame:first-child
     5880     hh = fh:first-child
     5881     .
     5882     do while valid-handle(hh):
     5883       if hh:name = v-next-widget-name then do:
     5884         if hh:sensitive  = yes
     5885         AND hh:visible = yes then do:
     5886           if hh:type = "TOGGLE-BOX":U then do:
     5887             assign
     5888             hh:BGcolor = 1
     5889             .
     5890           end.
     5891           APPLY "ENTRY" to hh.
     5892           return no-apply.
     5893         end.
     5894         else do:
     5895         APPLY "BACK-TAB" to hh.
     5896         return no-apply.
     5897         end.
     5898       end.
     5899       hh = hh:next-sibling.
     5900     end.
     5901     end.
     5902   END.
     5903   define variable vss-include-info57 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5904   ON RETURN ANYWHERE
     5905   DO:
     5906   define variable ii as integer no-undo .
     5907   define variable fh as widget-handle no-undo .
     5908   define variable hh as widget-handle no-undo .
     5909   define variable v-next-widget-name as character no-undo .
     5910     if v-tab-order <> '' then do:
     5911       assign
     5912       ii = lookup(self:name, v-tab-order).
     5913       if ii = num-entries(v-tab-order) then do:
     5914           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     5915           return no-apply.
     5916       end.
     5917       if self:type <> "BUTTON" and
     5918         self:type <> "EDITOR"  then do:
     5919         run proc-move-forward in this-procedure .
     5920         return no-apply.
     5921       end.
     5922       if self:type = "BUTTON" then do:
     5923         APPLY "CHOOSE" to self.
     5924       end.
     5925       if self:type = "TOGGLE-BOX" then
     5926       self:BGCOLOR = ?.
     5927       assign
     5928       ii = ii + 1
     5929       v-next-widget-name = entry(ii, v-tab-order)
     5930       no-error .
     5931       if error-status:error then do:
     5932         assign
     5933         ii = 1
     5934         v-next-widget-name = entry( ii, v-tab-order)
     5935         .
     5936       end.
     5937       assign
     5938       fh = frame Dialog-Frame:first-child
     5939       hh = fh:first-child
     5940       .
     5941       do while valid-handle(hh):
     5942         if hh:name = v-next-widget-name then do:
     5943           if hh:sensitive  = yes
     5944           AND hh:visible = yes then do:
     5945             if hh:type = "TOGGLE-BOX":U then do:
     5946               assign
     5947               hh:BGcolor = 1
     5948               .
     5949             end.
     5950             APPLY "ENTRY" to hh.
     5951             return no-apply.
     5952           end.
     5953           else do:
     5954             APPLY "TAB" to hh.
     5955             return no-apply.
     5956           end.
     5957         end.
     5958         hh = hh:next-sibling.
     5959       end.
     5960     end.
     5961   END.
     5962   procedure proc-move-forward :
     5963   define variable ii as integer no-undo .
     5964   define variable fh as widget-handle no-undo .
     5965   define variable hh as widget-handle no-undo .
     5966   define variable v-next-widget-name as character no-undo .
     5967   do
     5968   on error undo, return error
     5969   :
     5970     if v-tab-order <> '' then do:
     5971       if self:type = "TOGGLE-BOX" then
     5972       self:BGCOLOR = ?.
     5973       assign
     5974       ii = lookup(self:name, v-tab-order).
     5975       assign
     5976       ii = ii + 1
     5977       v-next-widget-name = entry(ii, v-tab-order)
     5978       no-error .
     5979       if error-status:error then do:
     5980         assign
     5981         ii = 1
     5982         v-next-widget-name = entry( ii, v-tab-order)
     5983         .
     5984       end.
     5985       assign
     5986       fh = frame Dialog-Frame:first-child
     5987       hh = fh:first-child
     5988       .
     5989       do while valid-handle(hh):
     5990         if hh:name = v-next-widget-name then do:
     5991           if hh:sensitive  = yes
     5992           AND hh:visible = yes then do:
     5993             if hh:type = "TOGGLE-BOX":U then do:
     5994               assign
     5995               hh:BGcolor = 1
     5996               .
     5997             end.
     5998             APPLY "ENTRY" to hh.
     5999             return.
     6000           end.
     6001           else do:
     6002             assign
     6003             ii = ii + 1
     6004             v-next-widget-name = entry(ii, v-tab-order)
     6005             no-error .
     6006             if error-status:error then do:
     6007               assign
     6008               ii = 1
     6009               v-next-widget-name = entry( ii, v-tab-order)
     6010               .
     6011             end.
     6012           end.
     6013         end.
     6014         hh = hh:next-sibling.
     6015       end.
     6016     end.
     6017   end.
     6018   end procedure.
