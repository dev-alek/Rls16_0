     5507         or tt-fin-doc.curr-code <> tt-fin-doc.contract-curr
     5508         then
     5509       do:
     5510         if tt-fin-doc.curr-code <> 0 then
     5511           display
     5512             tt-fin-doc.exch-rate
     5513             tt-fin-doc.exch-scale
     5514             with frame Dialog-Frame.
     5515         assign
     5516           p-main-widget = "sum-doc":U.
     5517       end.
     5518     end.
     5519     if p-main-widget  = "doc-date":U then
     5520     do:
     5521       assign
     5522         frame Dialog-Frame
     5523         tt-fin-doc.sum-doc
     5524         .
     5525   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5526   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     5527     (input  tt-fin-doc.host-code
     5528     ,input  tt-fin-doc.doc-date
     5529     ,output tt-fin-doc.base-rate
     5530     ,output tt-fin-doc.base-scale
     5531     )  .
