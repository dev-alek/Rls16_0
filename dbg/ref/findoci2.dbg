     5574       end.
     5575     end.
     5576     CASE p-main-widget:
     5577       when "sum-doc" then
     5578         do:
     5579           assign
     5580             frame Dialog-Frame
     5581             tt-fin-doc.exch-rate
     5582             tt-fin-doc.exch-scale
     5583             tt-fin-doc.sum-doc
     5584             .
     5585           CASE tt-fin-doc.curr-code:
     5586             when 0 then
     5587               do:
     5588                 assign
     5589                   tt-fin-doc.sum-rubl = tt-fin-doc.sum-doc
     5590                   tt-fin-doc.sum-base = tt-fin-doc.sum-doc / tt-fin-doc.base-rate * tt-fin-doc.base-scale
     5591                   tt-fin-doc.sum-contr = (if tt-fin-doc.contract-curr = 0                                                       then tt-fin-doc.sum-rubl                                                       else tt-fin-doc.sum-rubl / (tt-fin-doc.contract-rate / tt-fin-doc.contract-scale)                                                     )
     5592                   .
     5593               end.
     5594             when v-base-code then
     5595               do:
     5596                 assign
     5597                   tt-fin-doc.sum-rubl = tt-fin-doc.sum-doc * tt-fin-doc.exch-rate / tt-fin-doc.exch-scale
     5598                   tt-fin-doc.sum-base = tt-fin-doc.sum-rubl / tt-fin-doc.base-rate * tt-fin-doc.base-scale
     5599                   tt-fin-doc.sum-contr = (if tt-fin-doc.contract-curr = 0                                                       then tt-fin-doc.sum-rubl                                                       else tt-fin-doc.sum-rubl / (tt-fin-doc.contract-rate / tt-fin-doc.contract-scale)                                                     )
     5600                   .
     5601               end.
     5602             otherwise
     5603             do:
     5604               assign
     5605                 tt-fin-doc.sum-rubl = tt-fin-doc.sum-doc * tt-fin-doc.exch-rate / tt-fin-doc.exch-scale
     5606                 tt-fin-doc.sum-base = tt-fin-doc.sum-rubl / tt-fin-doc.base-rate * tt-fin-doc.base-scale
     5607                 tt-fin-doc.sum-contr = (if tt-fin-doc.contract-curr = 0                                                       then tt-fin-doc.sum-rubl                                                       else tt-fin-doc.sum-rubl / (tt-fin-doc.contract-rate / tt-fin-doc.contract-scale)                                                     )
     5608                 .
     5609             end.
     5610           END CASE.
     5611         end.
     5612     END CASE.
     5613     assign
     5614       f-rest-con-sum = tt-fin-doc.sum-contr - tt-fin-doc.con-sum-contr
     5615       .
     5616     display
     5617       f-rest-con-sum
     5618       with frame Dialog-Frame.
     5619     if tt-fin-doc.sum-doc:visible in frame Dialog-Frame then
     5620       display
     5621         tt-fin-doc.sum-doc
     5622         tt-fin-doc.curr-code
     5623         with frame Dialog-Frame.
     5624     if tt-fin-doc.sum-rubl:visible in frame Dialog-Frame then
     5625       display
     5626         tt-fin-doc.sum-rubl
     5627         tt-fin-doc.exch-rate
     5628         tt-fin-doc.exch-scale
     5629         with frame Dialog-Frame.
     5630     if tt-fin-doc.sum-base:visible in frame Dialog-Frame then
     5631       display
     5632         tt-fin-doc.sum-base
     5633         tt-fin-doc.base-rate
     5634         tt-fin-doc.base-scale
     5635         with frame Dialog-Frame.
     5636     if tt-fin-doc.sum-contr:visible in frame Dialog-Frame then
     5637       display
     5638         tt-fin-doc.sum-contr
     5639         tt-fin-doc.contract-rate
     5640         tt-fin-doc.contract-scale
     5641         with frame Dialog-Frame.
     5642     if not v-first-start then
     5643       run proc-update-sum-vat-chr in this-procedure (input-output v-start).
     5644   END PROCEDURE.
     5645   procedure proc-create-default-tax :
     5646     do
     5647       on error undo, return error
     5648       :
     5649       If p-mode = 'ДОБАВЛЕНИЕ':U then
     5650       do:
     5651         if p-ob-doc-code = "" then
     5652         do:
     5653           find tt0-fin-doc-tax where
     5654             tt0-fin-doc-tax.fin-doc-code = tt-fin-doc.fin-doc-code
     5655             AND tt0-fin-doc-tax.host-code = tt-fin-doc.host-code no-error .
     5656           if not avail tt0-fin-doc-tax
     5657             and not AMBIGUOUS tt0-fin-doc-tax
     5658             then
     5659           do:
     5660             create tt0-fin-doc-tax.
     5661           end.
     5662           if AMBIGUOUS tt0-fin-doc-tax then return.
     5663           assign
     5664             tt0-fin-doc-tax.fin-doc-code     = tt-fin-doc.fin-doc-code
     5665             tt0-fin-doc-tax.host-code        = tt-fin-doc.host-code
     5666             tt0-fin-doc-tax.line-num         = 1
     5667             tt0-fin-doc-tax.slt-pc           = 0
     5668             tt0-fin-doc-tax.sum-line-doc     = tt-fin-doc.sum-doc
     5669             tt0-fin-doc-tax.sum-slt-line-doc = 0
     5670             tt0-fin-doc-tax.with-slt         = no
     5671             .
     5672           case paramVne:
     5673             when "vne" then do:
     5674             assign
     5675               tt0-fin-doc-tax.sum-vat-line-doc = 0
     5676               tt0-fin-doc-tax.vat-pc           = -1
     5677               tt0-fin-doc-tax.with-vat         = no
     5678               .
     5679             end.
     5680             when "avans" then do:
     5681             assign
     5682               tt0-fin-doc-tax.vat-pc           = 22
     5683               tt0-fin-doc-tax.sum-vat-line-doc = (tt-fin-doc.sum-doc * tt0-fin-doc-tax.vat-pc)/(100 + tt0-fin-doc-tax.vat-pc)
     5684               tt0-fin-doc-tax.with-vat         = yes
     5685               .
     5686             end.
     5687             otherwise do:
     5688             assign
     5689               tt0-fin-doc-tax.sum-vat-line-doc = 0
     5690               tt0-fin-doc-tax.vat-pc           = 0
     5691               tt0-fin-doc-tax.with-vat         = no
     5692               .
     5693             end.
     5694           end case .
     5695           release tt0-fin-doc-tax.
     5696         end.
     5697       end.
     5698     end.
     5699   end procedure.
