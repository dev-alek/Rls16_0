      552   procedure uf-get :
      553     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      554     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      555     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      556     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      557     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      558     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      559     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      560     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      561     do
      562     on error undo, return error
      563     :
      564       define buffer buf_usr-flt for ubflt.usr-flt .
      565       define variable v-use-List_     as logical   no-undo .
      566       define variable v-type-List_     as character no-undo .
      567       define variable v-format-List_   as character no-undo .
      568       define variable v-use-Naim      as logical   no-undo .
      569       define variable v-type-Naim      as character no-undo .
      570       define variable v-format-Naim    as character no-undo .
      571       define variable v-use-print-graft as logical   no-undo .
      572       define variable v-use-sort-gr     as logical   no-undo .
      573       define variable v-use-type-price  as logical   no-undo .
      574       define variable v-use-type-val    as logical   no-undo .
      575       define variable v-label          as character no-undo .
      576       define variable v-tooltip        as character no-undo .
      577       define variable v-user-can-edit  as logical   no-undo .
      578       define variable v-output-display as logical   no-undo .
      579       define variable v-other          as character no-undo .
      580       run uf-name in this-procedure
      581          (input  entry(1, p-code, chr(4))
      582         ,output v-use-List_
      583         ,output v-type-List_
      584         ,output v-format-List_
      585         ,output v-use-Naim
      586         ,output v-type-Naim
      587         ,output v-format-Naim
      588         ,output v-use-print-graft
      589         ,output v-use-sort-gr
      590         ,output v-use-type-price
      591         ,output v-use-type-val
      592         ,output v-label
      593         ,output v-tooltip
      594         ,output v-user-can-edit
      595         ,output v-output-display
      596         ,output v-other
      597         ) no-error .
      598       if error-status :error then do:
      599         undo, return error return-value .
      600       end.
      601       find first buf_usr-flt no-lock where
      602                  buf_usr-flt.Call-point     = p-code AND
      603                  buf_usr-flt.user-name       = p-user-name
      604         no-error .
      605       if avail buf_usr-flt then do:
      606         assign
      607         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      608         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      609         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      610         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      611         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      612         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      613         .
      614       end.
      615       else do:
      616         assign
      617         p-List_        = (if v-use-List_       then "":U                    else ?)
      618         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      619         p-print-graft  = (if v-use-print-graft then no                      else ?)
      620         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      621         p-type-price   = (if v-use-type-price  then no                      else ?)
      622         p-type-val     = (if v-use-List_       then no                      else ?)
      623         .
      624       end.
      625     end.
      626   end procedure.
      627   procedure uf-set :
      628     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      629     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      630     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      631     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      632     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      633     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      634     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      635     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      636     do
      637     on error undo, return error
      638     :
      639       define buffer buf_usr-flt for ubflt.usr-flt .
      640       define variable v-use-List_     as logical   no-undo .
      641       define variable v-type-List_     as character no-undo .
      642       define variable v-format-List_   as character no-undo .
      643       define variable v-use-Naim      as logical   no-undo .
      644       define variable v-type-Naim      as character no-undo .
      645       define variable v-format-Naim    as character no-undo .
      646       define variable v-use-print-graft as logical   no-undo .
      647       define variable v-use-sort-gr   as logical   no-undo .
      648       define variable v-use-type-price as logical   no-undo .
      649       define variable v-use-type-val  as logical   no-undo .
      650       define variable v-tooltip        as character no-undo .
      651       define variable v-label          as character no-undo .
      652       define variable v-user-can-edit  as logical   no-undo .
      653       define variable v-output-display as logical   no-undo .
      654       define variable v-other          as character no-undo .
      655       run uf-name in this-procedure
      656         (input  entry(1, p-code, chr(4))
      657         ,output v-use-List_
      658         ,output v-type-List_
      659         ,output v-format-List_
      660         ,output v-use-Naim
      661         ,output v-type-Naim
      662         ,output v-format-Naim
      663         ,output v-use-print-graft
      664         ,output v-use-sort-gr
      665         ,output v-use-type-price
      666         ,output v-use-type-val
      667         ,output v-label
      668         ,output v-tooltip
      669         ,output v-user-can-edit
      670         ,output v-output-display
      671         ,output v-other
      672         ) no-error .
      673       if error-status :error then do:
      674         undo, return error return-value .
      675       end.
      676       find first buf_usr-flt where
      677                  buf_usr-flt.Call-point     = p-code AND
      678                  buf_usr-flt.user-name       = p-user-name
      679         no-error .
      680       if not avail buf_usr-flt then do:
      681           create buf_usr-flt .
      682           assign
      683           buf_usr-flt.call-point = p-code
      684           buf_usr-flt.user-name  = p-user-name
      685           .
      686       end.
      687       if avail buf_usr-flt then do:
      688        assign
      689        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      690        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      691        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      692        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      693        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      694        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      695       .
      696       release buf_usr-flt.
      697       end.
      698       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      699     end.
      700   end procedure.
      701   function diff-list returns character (
      702     input parfirst-list  as character,
      703     input parsecond-list as character,
      704     input pardelim       as character).
      705     if pardelim = ""
      706     or pardelim = ?
      707     then do:
      708       assign
      709         pardelim = ","
      710       .
      711     end.
      712     def var ind as integer no-undo .
      713     def var v-elem as character no-undo .
      714     def var v-result-list as character no-undo init "".
      715     def var v-num-parfirst-list as integer no-undo .
      716     assign
      717       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      718     .
      719     do ind = 1 to v-num-parfirst-list
      720     :
      721       assign
      722         v-elem = entry(ind, parfirst-list, pardelim)
      723       .
      724       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      725         assign
      726           v-result-list = v-result-list
      727                         + (if v-result-list > "" then pardelim else "")
      728                         + v-elem
      729         .
      730       end.
      731     end.
      732     return v-result-list .
      733   end function.
      734   function add-list returns character (
      735    input parfirst-list  as character,
      736    input parsecond-list as character,
      737    input pardelim       as character).
      738     if pardelim = ""
      739     or pardelim = ?
      740     then do:
      741       assign
      742         pardelim = ","
      743       .
      744     end.
      745     def var ind as integer no-undo .
      746     def var v-elem as character no-undo .
      747     def var v-result-list as character no-undo init "".
      748     def var v-num-parfirst-list as integer no-undo .
      749     assign
      750       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      751     .
      752     do ind = 1 to v-num-parfirst-list
      753     :
      754       assign
      755         v-elem = entry(ind, parfirst-list, pardelim)
      756       .
      757       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      758         assign
      759           v-result-list = v-result-list
      760                         + (if v-result-list > "" then pardelim else "")
      761                         + v-elem
      762         .
      763       end.
      764     end.
      765     def var v-num-parsecond-list as integer no-undo .
      766     assign
      767       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      768     .
      769     do ind = 1 to v-num-parsecond-list
      770     :
      771       assign
      772         v-elem = entry(ind, parsecond-list, pardelim)
      773       .
      774       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      775         assign
      776           v-result-list = v-result-list
      777                         + (if v-result-list > "" then pardelim else "")
      778                         + v-elem
      779         .
      780       end.
      781     end.
      782     return v-result-list .
      783   end function.
      784   function cross-list returns character (
      785    input parfirst-list  as character,
      786    input parsecond-list as character,
      787    input pardelim       as character).
      788     if pardelim = ""
      789     or pardelim = ?
      790     then do:
      791       assign
      792         pardelim = ","
      793       .
      794     end.
      795     def var ind as integer no-undo .
      796     def var v-elem as character no-undo .
      797     def var v-result-list as character no-undo init "".
      798     def var v-num-parfirst-list as integer no-undo .
      799     assign
      800       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      801     .
      802     do ind = 1 to v-num-parfirst-list
      803     :
      804       assign
      805         v-elem = entry(ind, parfirst-list, pardelim)
      806       .
      807       if lookup(v-elem, v-result-list, pardelim) = 0
      808       and lookup(v-elem, parsecond-list, pardelim) > 0
      809       then do:
      810         assign
      811           v-result-list = v-result-list
      812                         + (if v-result-list > "" then pardelim else "")
      813                         + v-elem
      814         .
      815       end.
      816     end.
      817     return v-result-list .
      818   end function.
      819   function radio-label returns character (
      820    input par-rs-value  as character,
      821    input par-rs-radio-buttons as character)
      822    .
      823    DEFINE variable v-result-label as character no-undo.
      824    assign
      825    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      826                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      827                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      828                             ), par-rs-radio-buttons
      829                           )
      830    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      831    .
      832   return v-result-label.
      833   end function.
      834   function m-radio-label returns character (
      835    input par-rs-value  as character,
      836    input par-rs-radio-buttons as character,
      837    input par-delim as character
      838    )
      839    .
      840    DEFINE variable v-result-label as character no-undo.
      841    assign
      842    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      843                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      844                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      845                             ), par-rs-radio-buttons, par-delim
      846                           )
      847    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      848    .
      849   return v-result-label.
      850   end function.
      851   FUNCTION mixlist returns character
      852   (
      853    input parfirst-list  as character
      854    ,input parsecond-list as character
      855    ,input pardelim       as character
      856    ,input pardelim-result as character ) :
      857     if pardelim = ""
      858     or pardelim = ?
      859     then do:
      860       assign
      861         pardelim = ","
      862       .
      863     end.
      864     def var ind as integer no-undo .
      865     def var v-elem1 as character no-undo .
      866     def var v-elem2 as character no-undo .
      867     def var v-result-list as character no-undo init "".
      868     do ind = 1 to num-entries(parfirst-list, pardelim)
      869     :
      870       assign
      871         v-elem1 = entry(ind, parfirst-list, pardelim)
      872         v-elem2 = entry(ind, parsecond-list, pardelim)
      873       .
      874         assign
      875           v-result-list = v-result-list
      876                         + (if v-result-list > "" then pardelim-result else "")
      877                         + v-elem1 + pardelim-result + v-elem2
      878         .
      879     end.
      880     return v-result-list .
      881   END FUNCTION.
      882   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
