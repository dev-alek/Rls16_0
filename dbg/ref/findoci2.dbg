     2009   if error-status :error then do:
     2010     undo, return error return-value .
     2011   end.
     2012   find first buf_c-fin-doc-attr no-lock where
     2013             buf_c-fin-doc-attr.attr-code    = p-attr-code
     2014         AND buf_c-fin-doc-attr.fin-doc-code      = p-fin-doc-code
     2015         AND buf_c-fin-doc-attr.host-code      = p-host-code
     2016         AND buf_c-fin-doc-attr.corr-user-db-num = p-corr-user-db-num
     2017         AND buf_c-fin-doc-attr.chip-num         = p-chip-num      no-error .
     2018     if available  buf_c-fin-doc-attr then do:
     2019       assign
     2020       p-attr-value = buf_c-fin-doc-attr.attr-value
     2021       .
     2022     end.
     2023     else do:
     2024       p-attr-value = ? .
     2025     end.
     2026    end.
     2027   end procedure.
