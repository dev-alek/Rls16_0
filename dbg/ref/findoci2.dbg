     2124   define output parameter p-attr-value   like ub.fin-doc-attr.attr-value   no-undo .
     2125   define variable  v-format         as character no-undo .
     2126   define variable  v-label          as character no-undo .
     2127   define variable  v-user-can-edit  as logical   no-undo .
     2128   define variable  v-output-display as logical   no-undo .
     2129   define variable  v-other          as character no-undo .
     2130   define variable  v-type           as character no-undo .
     2131   define buffer buf_fin-doc-attr for tt0-fin-doc-attr.
     2132   run fd-attr-code in this-procedure
     2133     (input  p-attr-code
     2134     ,output v-type
     2135     ,output v-format
     2136     ,output v-label
     2137     ,output v-user-can-edit
     2138     ,output v-output-display
