     6212     b-obj   when not v-is-auto-obj
     6213                  and lookup("lock-obj", p-other) = 0
     6214                  and (tt-fin-doc.shift-flag <> integer('1':U)
     6215                     or
     6216                     tt-fin-doc.status_ = 'новый':U)
     6217     tt-fin-doc.obj-type   when not v-is-auto-obj
     6218                                and lookup("lock-obj", p-other) = 0
     6219                                and (tt-fin-doc.shift-flag <> integer('1':U)
     6220                                     or
     6221                                     tt-fin-doc.status_ = 'новый':U)
     6222     tt-fin-doc.obj-code   when not v-is-auto-obj
     6223                                and lookup("lock-obj", p-other) = 0
     6224                                and (tt-fin-doc.shift-flag <> integer('1':U)
     6225                                     or
     6226                                     tt-fin-doc.status_ = 'новый':U)
     6227     r-sht when (tt-fin-doc.shift-flag = integer('1':U) and v-limit-access = 0  and v-can-back-shift)
     6228     b-calc  when v-limit-access = 0
     6229     tt-fin-doc.PS
     6230     WITH FRAME Dialog-Frame.
     6231     if v-limit-access = 0  then do:
     6232       ENABLE
     6233       tt-fin-doc.curr-code
     6234       B-currency
     6235       tt-fin-doc.sum-doc
     6236       tt-fin-doc.receiver-code when tt-fin-doc.contract-code = 0
     6237       B-receiver               when tt-fin-doc.contract-code = 0
     6238       tt-fin-doc.receiver-type when tt-fin-doc.contract-code = 0
     6239       tt-fin-doc.receiver-name when tt-fin-doc.contract-code = 0
     6240       tt-fin-doc.naznach-plat
     6241       tt-fin-doc.enclosure
     6242       tt-fin-doc.payer-sign1
     6243       tt-fin-doc.payer-sign2
     6244       tt-fin-doc.payer-sign3
     6245       tt-fin-doc.receiver-passport
     6246       WITH FRAME Dialog-Frame.
     6247       end.
     6248   end.
     6249   else if is-fact-and-edit() then
     6250       do:
     6251           enable
     6252               b-exit
     6253               tt-fin-doc.prn-doc-code
     6254           with frame Dialog-Frame.
     6255       end.
     6256   else do:
     6257     assign
     6258     b-quit:label = "&Выход"
     6259     b-quit:column = 1
     6260     .
     6261   end.
     6262   run hide-view-currency in this-procedure.
     6263   if is-fact-and-edit() then
     6264       disable
     6265           tt-fin-doc.sum-doc
     6266           with frame Dialog-Frame.
     6267   CASE p-view:
     6268     when "full":U then do:
     6269       assign
     6270       v-tab-order = "b-exit,b-quit,b-tax,b-print,b-hist,b-help," +  "prn-doc-code,doc-date,obj-type,obj-code,b-obj,b-payer-view,str-podr-type,str-podr-code,str-podr-name," +                             v-an-uchet-tab-order +  v-sum-curr-tab-order +                             "receiver-type,receiver-code,b-receiver,receiver-name,naznach-plat,receiver-passport,enclosure," +                              "PS,payer-sign1,payer-sign2"
     6271       .
     6272       IF AVAILABLE tt-fin-doc THEN
     6273       display
     6274       tt-fin-doc.payer-type
     6275       tt-fin-doc.payer-code
     6276       tt-fin-doc.payer-okpo
     6277       tt-fin-doc.payer-name
     6278       tt-fin-doc.str-podr-type
     6279       tt-fin-doc.str-podr-code
     6280       tt-fin-doc.str-podr-name
     6281       with frame Dialog-Frame
     6282       .
     6283       display
     6284       f-debet
     6285       f-credit
     6286       tt-fin-doc.cor-acc1-value
     6287       f-cor-acc1-descr
     6288       tt-fin-doc.cor-acc-value
     6289       f-cor-acc-descr
     6290       tt-fin-doc.an-uchet-value
     6291       f-an-uchet-descr
     6292       tt-fin-doc.cel-nazn-value
     6293       f-cel-nazn-descr
     6294       l-cashbook
     6295       f-cashbook
     6296       with frame Dialog-Frame
     6297       .
     6298       if not is-fact-and-edit() then
     6299           do:
     6300               if v-limit-access = 0 then do:
     6301                 ENABLE
     6302                 tt-fin-doc.str-podr-type
     6303                 tt-fin-doc.str-podr-code
     6304                 tt-fin-doc.str-podr-name
     6305                 WITH FRAME Dialog-Frame.
     6306               end.
     6307               if v-limit-access < 2  then do:
     6308                 ENABLE
     6309                 B-cor-acc1
     6310                 tt-fin-doc.cor-acc1-value
     6311                 tt-fin-doc.cor-acc-value
     6312                 B-cor-acc
     6313                 tt-fin-doc.an-uchet-value
     6314                 B-an-uchet
     6315                 tt-fin-doc.cel-nazn-value
     6316                 B-cel-nazn
     6317                 WITH FRAME Dialog-Frame.
     6318               end.
     6319       end.
     6320     end.
     6321     when "brief":U then do:
     6322        assign
     6323        v-tab-order = "b-exit,b-quit,b-tax,b-print,b-hist,b-help," +                            "prn-doc-code,doc-date,obj-type,obj-code,b-obj,b-payer-view," +                            v-sum-curr-tab-order +                            "receiver-type,receiver-code,b-receiver,receiver-name,naznach-plat,receiver-passport,enclosure," +                            "PS,payer-sign1,payer-sign2,payer-sign3"
     6324        .
     6325     end.
     6326     when "contract":U then do:
     6327       assign
     6328       v-tab-order = "b-exit,b-quit,b-tax,b-print,b-hist,b-help," +                               "prn-doc-code,doc-date,obj-type,obj-code,b-obj,b-payer-view," +                                v-contract-tab-order + v-sum-curr-tab-order +                                 "receiver-type,receiver-code,b-receiver,receiver-name,naznach-plat,receiver-passport,enclosure," +                                 "PS,payer-sign1,payer-sign2"
     6329       .
     6330       display
     6331       b-contract-view
     6332       f-contract-date when tt-fin-doc.contract-code <> 0
     6333       f-contract-prn-code when tt-fin-doc.contract-code <> 0
     6334       f-contract-type when tt-fin-doc.contract-code <> 0
     6335       f-contract-curr-abbr when tt-fin-doc.contract-code <> 0
     6336       tt-fin-doc.contract-curr when tt-fin-doc.contract-code <> 0
     6337       with frame Dialog-Frame
     6338       .
     6339       ENABLE
     6340       b-contract-view
     6341       with frame Dialog-Frame.
     6342     end.
     6343   END CASE.
     6344   END PROCEDURE.
     6345   PROCEDURE disable_UI :
     6346     HIDE FRAME Dialog-Frame.
     6347   END PROCEDURE.
     6348   PROCEDURE enable_UI :
     6349     OPEN QUERY Dialog-Frame FOR EACH locked_fin-doc SHARE-LOCK.
     6350     GET FIRST Dialog-Frame.
     6351     DISPLAY RS-view f-cashbook f-cor-acc-descr f-an-uchet-descr
     6352             f-contract-curr-abbr f-contract-prn-code f-contract-date
     6353             f-contract-type f-cel-nazn-descr f-cor-acc1-descr f-rest-con-sum
     6354             F-curr-abbr l-cashbook F-debet F-credit
     6355         WITH FRAME Dialog-Frame.
