     6358             tt-fin-doc.prn-doc-code tt-fin-doc.fin-doc-code tt-fin-doc.perm-date
     6359             tt-fin-doc.user-name-perm tt-fin-doc.doc-date tt-fin-doc.user-name-doc
     6360             tt-fin-doc.obj-type tt-fin-doc.obj-code tt-fin-doc.fact-date
     6361             tt-fin-doc.user-name-fact tt-fin-doc.payer-type tt-fin-doc.payer-code
     6362             tt-fin-doc.payer-okpo tt-fin-doc.payer-name tt-fin-doc.str-podr-type
     6363             tt-fin-doc.str-podr-code tt-fin-doc.str-podr-name
     6364             tt-fin-doc.cor-acc-value tt-fin-doc.an-uchet-value
     6365             tt-fin-doc.contract-curr tt-fin-doc.cel-nazn-value
     6366             tt-fin-doc.cor-acc1-value tt-fin-doc.sum-doc tt-fin-doc.curr-code
     6367             tt-fin-doc.exch-rate tt-fin-doc.exch-scale tt-fin-doc.sum-rubl
     6368             tt-fin-doc.base-rate tt-fin-doc.base-scale tt-fin-doc.sum-base
