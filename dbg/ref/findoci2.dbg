      151   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      152   define variable v-waitfram-action01         as character   no-undo .
      153   define variable v-waitfram-action02         as character   no-undo .
      154   define variable v-waitfram-action03         as character   no-undo .
      155   define variable mWaitFramTextBeg            as character   no-undo.
      156   define variable mWaitFramTextEnd            as character   no-undo.
      157   define variable mWaitFramView               as logical     no-undo.
      158   define variable mWaitProcEvent              as logical     no-undo init yes.
      159   define variable mWaitFramInterval           as integer     no-undo init 1 .
      160   define variable mWaitFramStop               as logical     no-undo.
      161   define variable mWaitFramStopUser           as logical     no-undo.
      162   define variable mWaitFramStopTimeOut        as logical     no-undo.
      163   define variable mWaitFramStartProc          as datetime-tz no-undo.
      164   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      165   define button B-WaitFramStop auto-end-key
      166        label "Стоп"
      167        size 10 by 1 tooltip "Остоновить процесс".
      168   define button B-viewProcInfo
      169        label "Информация"
      170        size 15 by 1 tooltip "Информация о процесс".
      171   define frame waitfram
      172     v-waitfram-action01 format "x(72)" no-label skip
      173     v-waitfram-action02 format "x(72)" no-label skip
      174     v-waitfram-action03 format "x(72)" no-label skip
      175     B-viewProcInfo
      176     B-WaitFramStop at row 4 col 30
      177     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      178     .
      179   define new global shared variable mBatchMode as logical no-undo init ?.
      180   define variable mFramBachModHandle as handle no-undo.
      181   mFramBachModHandle = frame waitfram:handle.
      182   define variable mFameOldVis as logical no-undo.
      183   define variable mVisCUrentVin as logical no-undo.
      184   if session:batch-mode
      185   then
      186      mBatchMode = yes.
      187   if mBatchMode = ? then do:
      188     mVisCUrentVin = current-window:visible.
      189     mFameOldVis = mFramBachModHandle:visible.
      190     mFramBachModHandle:visible  = yes.
      191     mBatchMode = mFramBachModHandle:visible ne yes.
      192     mFramBachModHandle:visible = mFameOldVis.
      193     current-window:visible = mVisCUrentVin.
      194   end.
      195    if  log-manager:logfile-name ne ?
      196     then DO:
      197         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      198         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      199         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      200     end.
      201   on choose of B-WaitFramStop in frame waitfram
      202   do:
      203     mWaitFramStop = yes.
      204     mWaitFramStopUser = yes.
      205   end.
      206   function waitfram-check-timeout returns logical():
      207      define variable vtime as int64 no-undo.
      208      if mWaitFramStopTimeOut
      209      then
      210         return yes.
      211      vtime = ( now - mWaitFramStartProc ) / 1000 .
      212      if     mWaitFramTimeOut ne ?
      213         and mWaitFramTimeOut ne 0
      214         and mWaitFramTimeOut lt vtime
      215      then do:
      216         mWaitFramStopTimeOut = yes.
      217      end.
      218      return mWaitFramStopTimeOut.
      219   end.
      220   procedure waitfram-hide :
      221     if not session:batch-mode
      222     then do
      223     on error undo, return error return-value
      224     :
      225       pause 0 before-hide .
      226       if not mBatchMode then
      227         hide frame waitfram .
      228     if     not mWaitFramView
      229        and mWaitProcEvent
      230     then
      231       process events .
      232     end.
      233   end procedure.
      234   procedure waitfram-show :
      235     define input  parameter p-message as character no-undo .
      236     define variable v-left-margin as integer   no-undo .
      237     if not session:batch-mode
      238     then do
      239     on error undo, return error return-value
      240     :
      241       if length(p-message) <= 70 then do:
      242         assign
      243           v-left-margin = integer((70 - length(p-message)) / 2)
      244         .
      245         assign
      246           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      247         .
      248         assign
      249           v-waitfram-action01 = " "
      250           v-waitfram-action02 = " "
      251                                    + fill(" ", v-left-margin)
      252                                    + p-message
      253           v-waitfram-action03 = " "
      254         .
      255       end.
      256       else do:
      257         define variable vRindex1 as integer no-undo.
      258         define variable vRindex2 as integer no-undo.
      259         vRindex1 = r-index(p-message," ",70).
      260         if vRindex1 = 0
      261         then
      262            vRindex1 = 70.
      263         if length(p-message)  <= vRindex1 + 70 then do:
      264           assign
      265             v-waitfram-action01 = " "
      266             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      267             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      268           .
      269         end.
      270         else do:
      271           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      272           if vRindex2 <= vRindex1
      273           then
      274              vRindex2 = vRindex1 + 70.
      275           assign
      276             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      277             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      278             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      279           .
      280         end.
      281       end.
      282       B-viewProcInfo:visible   in frame waitfram = no.
      283       B-viewProcInfo:sensitive in frame waitfram = no.
      284       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      285       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      286       if  (   mWaitFramView
      287          or  mWaitProcEvent)
      288          and not mBatchMode
      289       then
      290          display
      291             v-waitfram-action01 skip
      292             v-waitfram-action02 skip
      293             v-waitfram-action03 skip
      294          with frame waitfram .
      295       if     mWaitFramView
      296          then do:
      297             if     mWaitFramInterval ne ?
      298                and not mBatchMode
      299             then
      300                wait-for go of frame waitfram pause mWaitFramInterval.
      301          end.
      302          else
      303             if     mWaitProcEvent
      304                and not mBatchMode
      305             then
      306                process events .
      307     end.
      308   end procedure.
      309      procedure waitfram-show-this:
      310         define input  parameter iInterval as int64 no-undo.
      311         define variable vtime as int64 no-undo.
      312         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      313         mWaitFramInterval = iInterval.
      314         run waitfram-show (substitute("&1&2 &3&4" ,
      315                                       mWaitFramTextBeg ,
      316                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      317                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      318                                       mWaitFramTextEnd
      319                                      )
      320                           ).
      321      end.
      322      procedure WaitFramRunPause:
      323         define input  parameter iInterval as dec no-undo.
      324         define variable vStart  as datetime-tz no-undo.
      325         define variable vend    as datetime-tz no-undo.
      326         define variable vint as int64 no-undo.
      327         define variable vOk as logical no-undo.
      328         vStart = now.
      329         vend   = vStart.
      330         publish "WaitFramPause" (iInterval,output vOk).
      331         vend   =  now.
      332         vint = vend - vStart.
      333         vint = iInterval - vint / 1000.
      334         if     not mWaitFramStop
      335            and (   vint > 0
      336                 or (    not vOk
      337                     and iInterval eq ?
      338                     )
      339                 )
      340         then
      341            run waitfram-show-this (iInterval).
      342         vend   =  now.
      343         vint = vend - vStart.
      344         vint = iInterval - vint / 1000.
      345         if     not mWaitFramStop
      346            and vint > 0
      347         then do:
      348            run gbl/pause.p (vint * 1000).
      349         end.
      350         if iInterval ne ?
      351         then
      352            publish "WaitFramStop".
      353         waitfram-check-timeout().
      354      end.
      355      procedure WaitFramWaitFor:
      356         define input  parameter iInterval as dec no-undo.
      357         assign
      358            mWaitFramStartProc   = now
      359            mWaitFramStopUser    = no
      360            mWaitFramStopTimeOut = no
      361         .
      362         block-wait:
      363         do while not mWaitFramStop:
      364            run WaitFramRunPause (iInterval).
      365            if  waitfram-check-timeout()
      366            then do:
      367               leave block-wait.
      368            end.
      369         end.
      370         run waitfram-hide.
      371      end.
      372   procedure waitfram-join :
      373     define input  parameter p-line-1  as character no-undo .
      374     define input  parameter p-line-2  as character no-undo .
      375     define input  parameter p-line-3  as character no-undo .
      376     define output parameter p-message as character no-undo .
      377     do
      378     on error undo, return error return-value
      379     :
      380       assign
      381         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      382                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      383                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      384       .
      385     end.
      386   end procedure.
      387   function waitfram-join-function returns character
      388     (input p-line-1 as character
      389     ,input p-line-2 as character
      390     ,input p-line-3 as character
      391     ).
      392     define variable v-message as character no-undo .
      393     run waitfram-join in this-procedure
      394       (input  p-line-1
      395       ,input  p-line-2
      396       ,input  p-line-3
      397       ,output v-message
      398       ) .
      399     return v-message .
      400   end function .
      401   procedure proc-alt-shift-f2:
      402     if not ibs.th.gbl.gbl-var:rcode
      403   then
      404     run gbl\inidebug.p .
      405   end.
      406   procedure proc-alt-shift-f3:
      407     run gbl/prvssinf.p
      408       ( input this-procedure
      409       ) .
      410   end.
      411   define variable v-inform-launched as logical no-undo initial false .
      412   procedure proc-alt-shift-f4:
      413     define variable v-action as character no-undo .
      414     if v-inform-launched = false then do:
      415       assign
      416         v-inform-launched = true
      417       .
      418       run gbl/d-inform.w
      419         (  input self
      420         ,  input this-procedure
      421         , output v-action
      422         ) no-error .
      423       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      424       assign
      425         v-inform-launched = false
      426       .
      427     end.
      428   end.
      429   procedure proc-alt-f1:
      430     run gbl/corrhelp.p
      431       (input this-procedure
      432       ) .
      433   end .
      434   on alt-shift-f2 anywhere do:
      435     run proc-alt-shift-f2.
      436   end.
      437   on alt-shift-f3 anywhere do:
      438     run proc-alt-shift-f3 in this-procedure .
      439   end.
      440   on alt-shift-f4 anywhere do:
      441     run proc-alt-shift-f4 in this-procedure.
      442   end.
      443   on alt-f1 anywhere do:
      444     run proc-alt-f1 in this-procedure .
      445   end.
      446   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      447   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      448   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
      449   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
      450   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      451   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      452   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
      453   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
      454   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
      455   procedure uf-name :
      456     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      457     define output parameter p-use-List_     as logical   no-undo .
      458     define output parameter p-type-List_     as character no-undo .
      459     define output parameter p-format-List_   as character no-undo .
      460     define output parameter p-use-Naim      as logical   no-undo .
      461     define output parameter p-type-Naim      as character no-undo .
      462     define output parameter p-format-Naim    as character no-undo .
      463     define output parameter p-use-print-graft as logical   no-undo .
      464     define output parameter p-use-sort-gr   as logical   no-undo .
      465     define output parameter p-use-type-price as logical   no-undo .
      466     define output parameter p-use-type-val  as logical   no-undo .
      467     define output parameter p-label          as character no-undo .
      468     define output parameter p-tooltip        as character no-undo .
      469     define output parameter p-user-can-edit  as logical   no-undo .
      470     define output parameter p-output-display as logical   no-undo .
      471     define output parameter p-other          as character no-undo .
      472     do
      473     on error undo, return error
      474     :
