     4300   ON CHOOSE OF B-cashbook IN FRAME Dialog-Frame
     4301     DO:
     4302       define variable v-cb-brw as class ibs.th.ref.cashbookbrw no-undo .
     4303       v-cb-brw = new ibs.th.ref.cashbookbrw ( 'ВЫБОР':U, parparentproc ).
     4304       wait-for  v-cb-brw:ShowDialog() .
     4305       if v-cb-brw:out-list-id > ""
     4306         then
     4307       do :
     4308         find first ub.cashbook no-lock where ub.cashbook.id = int64(v-cb-brw:out-list-id) .
     4309         tt-fin-doc.cashbookId = ub.cashbook.id .
     4310         f-cashbook = ub.CashBook.CashBookName .
     4311         display
     4312           f-cashbook
     4313           with frame Dialog-Frame .
     4314         IF LOOKUP("update_prc-doc-code-mask", THIS-PROCEDURE:INTERNAL-ENTRIES) >  0
     4315           THEN
     4316           run update_prc-doc-code-mask (no).
     4317         run check-obj in this-procedure (   input tt-fin-doc.obj-type
     4318           ,input tt-fin-doc.obj-code
     4319           )
     4320           no-error.
     4321         find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = (if tt-fin-doc.fin-doc-type eq 'рко':U then ub.cashbook.corrRko else ub.cashbook.corrPko)
     4322           and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     4323           and X_fin-code-cor-acc.status_ = integer('0':U)
     4324           no-error .
     4325         if available X_fin-code-cor-acc
     4326           then
     4327         do :
     4328           assign
     4329             tt-fin-doc.cor-acc-value = X_fin-code-cor-acc.code-value
     4330             f-cor-acc-descr          = X_fin-code-cor-acc.descr
     4331             tt-fin-doc.cor-acc       = X_fin-code-cor-acc.fin-code
     4332             .
     4333         end.
     4334         else
     4335         do:
     4336           if ub.cashbook.corrRko = "" then
     4337           do:
     4338             for first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.code-value = "57.01"
     4339               and ub.fin-code-cor-acc.host-code = p-curr-host-code :
     4340               tt-fin-doc.cor-acc = ub.fin-code-cor-acc.fin-code .
     4341               tt-fin-doc.cor-acc-value = ub.fin-code-cor-acc.code-value .
     4342             end.
     4343           end.
     4344         end.
     4345         if ub.CashBook.OsnAcct <> "" then
     4346         do:
     4347           find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = ub.CashBook.OsnAcct
     4348             and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     4349             and X_fin-code-cor-acc.status_ = integer('0':U)
     4350             no-error .
     4351           if available X_fin-code-cor-acc
     4352             then
     4353           do :
     4354             assign
     4355               tt-fin-doc.cor-acc1-value = X_fin-code-cor-acc.code-value
     4356               f-cor-acc1-descr          = X_fin-code-cor-acc.descr
     4357               tt-fin-doc.cor-acc1       = X_fin-code-cor-acc.fin-code
     4358               .
     4359           end.
     4360           else
     4361           do:
     4362             assign
     4363               tt-fin-doc.cor-acc1-value = ""
     4364               f-cor-acc1-descr          = ""
     4365               tt-fin-doc.cor-acc1       = ?
     4366               .
     4367           end.
     4368         end.
     4369       end.
     4370       display
     4371         tt-fin-doc.cor-acc-value
     4372         f-cor-acc-descr
     4373         tt-fin-doc.cor-acc
     4374         tt-fin-doc.cor-acc1-value
     4375         f-cor-acc1-descr
     4376         tt-fin-doc.cor-acc1
     4377         with frame Dialog-Frame .
     4378     END.
