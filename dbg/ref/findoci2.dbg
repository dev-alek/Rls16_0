     3107   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3108   if lookup(self :type
     3109            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3110            ) = 0
     3111   then do:
     3112     message
     3113       "$Workfile$"
     3114       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3115       "Интерфейсный элемент" self :name  skip
     3116       "Тип" self :type  skip
     3117       "Процедура" this-procedure :file-name skip
     3118       view-as alert-box .
