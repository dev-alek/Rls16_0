     5101   ON LEAVE OF tt-fin-doc.doc-date IN FRAME Dialog-Frame
     5102     DO:
     5103   define variable vss-include-info46 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5104   if lookup(self :type
     5105            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     5106            ) = 0
     5107   then do:
     5108     message
     5109       "$Workfile$"
     5110       "Указанному интерфейсному элементу фокус не может быть передан" skip
     5111       "Интерфейсный элемент" self :name  skip
     5112       "Тип" self :type  skip
