     6654     tt-fin-doc.payer-sign1 =   (if num-entries(tt-fin-doc.payer-sign1, chr(4)) > 1
     6655                                       then entry(2, tt-fin-doc.payer-sign1, chr(4))
     6656                                       else entry(1, tt-fin-doc.payer-sign1, chr(4)))
     6657     .
     6658   end.
     6659   else do:
     6660     assign
     6661     tt-fin-doc.payer-sign1:label  = tt-fin-doc.payer-sign1:label  + " - ":U +
     6662                               v-head-position
     6663     tt-fin-doc.payer-sign1 =   (if num-entries(tt-fin-doc.payer-sign1, chr(4)) > 1
     6664                                       then entry(2, tt-fin-doc.payer-sign1, chr(4))
     6665                                       else entry(1, tt-fin-doc.payer-sign1, chr(4)))
     6666     .
     6667   end.
