        1   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        2   DEFine INPUT PARAMeter as-ref AS LOG   NO-UNDO.
        3   DEFine OUTPUT PARAMeter rid    AS RECID NO-UNDO INIT ?.
        4   define variable vss-revision    as character no-undo initial "$Revision$":U .
        5   define variable vss-author      as character no-undo initial "$Author$":U .
        6   define variable vss-date        as character no-undo initial "$Date$":U .
        7   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
        8   define variable vss-archive     as character no-undo initial "$Archive$":U .
        9   define variable vss-description as character no-undo initial "Справочник шкал".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   procedure proc-alt-shift-f2:
       80     if not ibs.th.gbl.gbl-var:rcode
       81   then
       82     run gbl\inidebug.p .
       83   end.
       84   procedure proc-alt-shift-f3:
       85     run gbl/prvssinf.p
       86       ( input this-procedure
       87       ) .
       88   end.
       89   define variable v-inform-launched as logical no-undo initial false .
       90   procedure proc-alt-shift-f4:
       91     define variable v-action as character no-undo .
       92     if v-inform-launched = false then do:
       93       assign
       94         v-inform-launched = true
       95       .
       96       run gbl/d-inform.w
       97         (  input self
       98         ,  input this-procedure
       99         , output v-action
      100         ) no-error .
      101       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      102       assign
      103         v-inform-launched = false
      104       .
      105     end.
      106   end.
      107   procedure proc-alt-f1:
      108     run gbl/corrhelp.p
      109       (input this-procedure
      110       ) .
      111   end .
      112   on alt-shift-f2 anywhere do:
      113     run proc-alt-shift-f2.
      114   end.
      115   on alt-shift-f3 anywhere do:
      116     run proc-alt-shift-f3 in this-procedure .
      117   end.
      118   on alt-shift-f4 anywhere do:
      119     run proc-alt-shift-f4 in this-procedure.
      120   end.
      121   on alt-f1 anywhere do:
      122     run proc-alt-f1 in this-procedure .
      123   end.
      124   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125     define variable v-cntxt-db-num        as integer   no-undo .
      126     define variable v-cntxt-userid        as character no-undo .
      127     define variable v-cntxt-level         as character no-undo .
      128     define variable v-cntxt-host-code-obj as integer   no-undo .
      129     define variable v-cntxt-obj-type      as character no-undo .
      130     define variable v-cntxt-obj-code      as integer   no-undo .
      131     define variable v-cntxt-db-num-obj    as integer   no-undo .
      132     define variable v-cntxt-is-admin      as logical   no-undo .
      133   define variable rr as recid no-undo.
      134   define variable conf-par as char no-undo.
      135   define variable par-type as char no-undo.
      136   define variable print-option as character no-undo.
      137   DEFINE MENU MENU-b-print
      138          MENU-ITEM m_hor          LABEL "Уровни по горизонтали"
      139          MENU-ITEM m_vert         LABEL "Уровни по вертикали".
      140   DEFINE BUTTON b-add
      141        LABEL "&Добавить":L
      142        SIZE 10 BY 1.
      143   DEFINE BUTTON b-chg
      144        LABEL "&Изменить":L
      145        SIZE 10 BY 1.
      146   DEFINE BUTTON b-copy
      147        LABEL "&Копия":L
      148        SIZE 10 BY 1.
      149   DEFINE BUTTON b-del
      150        LABEL "&Удалить":L
      151        SIZE 10 BY 1.
      152   DEFINE BUTTON b-exit AUTO-END-KEY DEFAULT
      153        LABEL "&Выход ":L
      154        SIZE 10 BY 1
      155        BGCOLOR 8 .
      156   DEFINE BUTTON b-help
      157        LABEL "Помо&щь":L
      158        SIZE 10 BY 1.
      159   DEFINE BUTTON b-hist
      160        LABEL "Ис&тория":L
      161        SIZE 10 BY 1.
      162   DEFINE BUTTON b-lkp
      163        LABEL "&Просмотр":L
      164        SIZE 10 BY 1.
      165   DEFINE BUTTON b-print
      166        LABEL "Пе&чать":L
      167        SIZE 10 BY 1.
      168   DEFINE BUTTON b-sel AUTO-GO
      169        LABEL "Вы&бор ":L
      170        SIZE 10 BY 1.
      171   DEFINE QUERY br-scales FOR
      172         ub.gds-prt SCROLLING.
      173   DEFINE BROWSE br-scales
      174     QUERY br-scales NO-LOCK DISPLAY
      175         ub.gds-prt.node-name COLUMN-LABEL "Шкала" FORMAT "X(40)":U
      176       WITH SEPARATORS SIZE 43 BY 18.5 ROW-HEIGHT-CHARS .67.
      177   DEFINE FRAME d-gds-prt
      178        b-exit AT ROW 1 COL 1
      179        b-sel AT ROW 1 COL 11
      180        b-lkp AT ROW 1 COL 21
      181        b-add AT ROW 1 COL 31
      182        b-copy AT ROW 1 COL 41
      183        b-chg AT ROW 1 COL 51
      184        b-del AT ROW 1 COL 61
      185        b-print AT ROW 1 COL 71
      186        b-help AT ROW 1 COL 81
      187        b-hist AT ROW 2 COL 71
      188        br-scales AT ROW 2.5 COL 22
      189        SPACE(30.12) SKIP(0.62)
      190       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      191            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      192            TITLE "ШКАЛЫ  ТОВАРОВ":L
      193            DEFAULT-BUTTON b-exit.
      194   ASSIGN
      195          FRAME d-gds-prt:SCROLLABLE       = FALSE.
      196   ASSIGN
      197          b-print:POPUP-MENU IN FRAME d-gds-prt       = MENU MENU-b-print:HANDLE.
      198   ON CHOOSE OF b-add IN FRAME d-gds-prt
      199   DO:
      200   run gbl/conf-rd.p ("is-prt", "", "", 0, "", "", "", yes, output conf-par, output par-type) no-error.
      201   if error-status:error then return.
      202   if par-type <> "L" then do:
      203     message "Неправильный тип параметра is-prt (должно быть logical)." view-as alert-box error.
      204     return.
      205   end.
      206   if conf-par <> "yes" then do:
      207     message  "Работа со шкалами в текущей конфигурации системы запрещена." conf-par view-as alert-box error.
      208     return no-apply.
      209   end.
      210   define variable v-ok as logical   no-undo .
      211   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      212   do:
      213     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      214       (input  v-cntxt-db-num
      215       ,input  v-cntxt-userid
      216       ,input  0
      217       ,input  'actn_scale_update':U
      218       ,input  'global':U
      219       ,input  0
      220       ,input  '':U
      221       ,input  0
      222       ,input  0
      223       ,input  0
      224       ,input  0
      225       ,input  true
      226       ,output v-ok
      227       )  .
      228   end.
      229   if v-ok <> true
      230   then do:
      231     return no-apply .
      232   end.
      233   run ref/prop.w
      234     (input  'ДОБАВЛЕНИЕ':U
      235     ,input  ?
      236     ,output rr
      237     ).
      238   if rr = ? then return no-apply.
      239   OPEN QUERY br-scales FOR EACH ub.gds-prt       WHERE gds-prt.root = TRUE NO-LOCK.
      240   reposition br-scales to recid rr.
      241   apply "ENTRY":U to br-scales .
      242   END.
      243   ON CHOOSE OF b-chg IN FRAME d-gds-prt
      244   DO:
      245   define variable v-ok as logical   no-undo .
      246   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      247   do:
      248     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      249       (input  v-cntxt-db-num
      250       ,input  v-cntxt-userid
      251       ,input  0
      252       ,input  'actn_scale_update':U
      253       ,input  'global':U
      254       ,input  0
      255       ,input  '':U
      256       ,input  0
      257       ,input  0
      258       ,input  0
      259       ,input  0
      260       ,input  true
      261       ,output v-ok
      262       )  .
      263   end.
      264   if v-ok <> true then do:
      265     return no-apply .
      266   end.
      267   if not available ub.gds-prt then do:
      268     message "Неправильный выбор шкалы.".
      269     return no-apply.
      270   end.
      271   if ub.gds-prt.node-name = '_Пустая шкала':U  then do:
      272     message "Шкала пустая. Изменение невозможно.".
      273     return no-apply.
      274   end.
      275   run ref/prop.w
      276     (input  'ИЗМЕНЕНИЕ':U
      277     ,input  gds-prt.node-code
      278     ,output rr
      279     ).
      280   if rr <> ? then do:
      281     OPEN QUERY br-scales FOR EACH ub.gds-prt       WHERE gds-prt.root = TRUE NO-LOCK.
      282     reposition br-scales to recid rr.
      283     apply "ENTRY":U to br-scales .
      284   end.
      285   END.
      286   ON CHOOSE OF b-copy IN FRAME d-gds-prt
      287   DO:
      288   run gbl/conf-rd.p ("is-prt", "", "", 0, "", "", "", yes, output conf-par, output par-type) no-error.
      289   if error-status :error then do:
      290     message "Ошибка при чтении параметра is-prt"
      291             view-as alert-box error.
      292     return.
      293   end.
      294   if par-type <> "L" then do:
      295     message "Неправильный тип параметра is-prt (должно быть logical)."
      296             view-as alert-box error.
      297     return.
      298   end.
      299   if lookup(conf-par, "true,yes") = 0
      300   then do:
      301     message  "Работа со шкалами в текущей конфигурации системы запрещена."
      302              view-as alert-box error.
      303     return no-apply.
      304   end.
      305   define variable v-ok as logical   no-undo .
      306   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      307   do:
      308     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      309       (input  v-cntxt-db-num
      310       ,input  v-cntxt-userid
      311       ,input  0
      312       ,input  'actn_scale_update':U
      313       ,input  'global':U
      314       ,input  0
      315       ,input  '':U
      316       ,input  0
      317       ,input  0
      318       ,input  0
      319       ,input  0
      320       ,input  true
      321       ,output v-ok
      322       )  .
      323   end.
      324   if v-ok <> true then do:
      325     return no-apply .
      326   end.
      327   if not available ub.gds-prt then do:
      328     message "Неправильный выбор шкалы."
      329             view-as alert-box error.
      330     return no-apply.
      331   end.
      332   if ub.gds-prt.node-name = '_Пустая шкала':U  then do:
      333     message "Шкала пустая. Копирование невозможно."
      334             view-as alert-box error.
      335     return no-apply.
      336   end.
      337   run ref/prop.w
      338     (input  'КОПИРОВАНИЕ':U
      339     ,input  gds-prt.node-code
      340     ,output rr
      341     ).
      342   if rr <> ? then do:
      343     OPEN QUERY br-scales FOR EACH ub.gds-prt       WHERE gds-prt.root = TRUE NO-LOCK.
      344     reposition br-scales to recid rr no-error.
      345     apply "ENTRY":U to br-scales .
      346   end.
      347   END.
      348   ON CHOOSE OF b-del IN FRAME d-gds-prt
      349   DO:
      350   find first ub.db no-lock
      351     where ub.db.db-num <> 0
      352     no-error.
      353   if available db then do:
      354     message
      355       "Нельзя удалять шкалу если есть УБД "
      356       view-as alert-box error.
      357     return no-apply.
      358   end.
      359   define variable v-ok as logical   no-undo .
      360   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      361   do:
      362     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      363       (input  v-cntxt-db-num
      364       ,input  v-cntxt-userid
      365       ,input  0
      366       ,input  'actn_scale_update':U
      367       ,input  'global':U
      368       ,input  0
      369       ,input  '':U
      370       ,input  0
      371       ,input  0
      372       ,input  0
      373       ,input  0
      374       ,input  true
      375       ,output v-ok
      376       )  .
      377   end.
      378   if v-ok <> true then do:
      379       return no-apply .
      380   end.
      381   if not available ub.gds-prt then do:
      382       message "Неправильный выбор шкалы.".
      383       return no-apply.
      384   end.
      385   if ub.gds-prt.node-name = '_Пустая шкала':U then do:
      386       message "Шкала пустая. Удаление невозможно.".
      387       return no-apply.
      388   end.
      389   assign
      390     rr = recid (ub.gds-prt)
      391   .
      392   assign
      393     v-ok = false
      394   .
      395   message
      396     "Удалить шкалу ?   Вы уверены ?"
      397     view-as alert-box question buttons OK-Cancel update v-ok .
      398   if v-ok <> true then do:
      399     return no-apply.
      400   end.
      401   find first ub.goods
      402     where ub.goods.prt-root = ub.gds-prt.upper-code
      403     no-error .
      404   if available goods then do:
      405     message
      406       "Шкала уже использована в товаре :" ub.goods.artic ub.goods.gds-name skip
      407       "Удаление невозможно." skip
      408       view-as alert-box error .
      409     return no-apply.
      410   end.
      411   run del-scale (ub.gds-prt.upper-code).
      412   OPEN QUERY br-scales FOR EACH ub.gds-prt       WHERE gds-prt.root = TRUE NO-LOCK.
      413   apply "ENTRY":U to br-scales .
      414   END.
      415   ON CHOOSE OF b-hist IN FRAME d-gds-prt
      416   DO:
      417    DEFINE VARIABLE rid-list AS character NO-UNDO.
      418    IF NOT AVAILABLE ub.gds-prt THEN RETURN NO-APPLY.
      419      run ref/cgdsprts.w (
      420                        input parparentproc
      421                       ,INPUT "":U
      422                       ,INPUT "prt-root":U
      423                       ,INPUT ub.gds-prt.prt-root
      424                       ,INPUT NO
      425                       ,OUTPUT rid-list
      426          ) .
      427    apply "ENTRY":U to br-scales .
      428   END.
      429   ON CHOOSE OF b-lkp IN FRAME d-gds-prt
      430   DO:
      431     if not available ub.gds-prt then do:
      432       message
      433         "Неправильный выбор шкалы."
      434         view-as alert-box information .
      435       return no-apply.
      436     end.
      437     if ub.gds-prt.node-name = '_Пустая шкала':U  then do:
      438       message
      439         "Шкала пустая. Просмотр не имеет смысла." skip
      440         view-as alert-box information .
      441       return no-apply.
      442     end.
      443     run str/scl-p.w
      444       (
      445        input parparentproc
      446       ,input v-cntxt-obj-type
      447       ,input v-cntxt-obj-code
      448       ,input 'ПРОСМОТР':U
      449       ,input recid (gds-prt)
      450       ) .
      451     apply "entry" to br-scales in frame d-gds-prt.
      452   END.
      453   ON CHOOSE OF b-print IN FRAME d-gds-prt
      454   DO:
      455    if print-option = "" then do:
      456       run gbl/pop-up.p (b-print:handle, no) no-error.
      457    end.
      458    if print-option = "" then return no-apply.
      459   CASE print-option:
      460       when "hor":U then do:
      461           run ref/gdsprtpr.p (parparentproc, ub.gds-prt.node-code) no-error.
      462       end.
      463       when "vert":U then do:
      464           run ref/gdsprtpv.p (parparentproc, ub.gds-prt.node-code) no-error.
      465       end.
      466   END CASE.
      467   print-option = "":U.
      468   if error-status:error then do:
      469       return no-apply.
      470   end.
      471   apply "ENTRY":U to br-scales .
      472   END.
      473   ON CHOOSE OF b-sel IN FRAME d-gds-prt
      474   DO:
      475     define variable r as recid no-undo.
      476     if available ub.gds-prt  then do ON STOP UNDO, RETURN NO-APPLY :
      477         r = recid( ub.gds-prt ).
      478         find ub.gds-prt where recid( ub.gds-prt ) = r share-lock.
      479         rid = r.
      480     end.
      481   END.
      482   ON MOUSE-SELECT-DBLCLICK OF br-scales IN FRAME d-gds-prt
      483   DO:
      484     if as-ref
      485         then apply "CHOOSE":U to b-sel.
      486         else apply "CHOOSE":U to b-lkp.
      487   END.
      488   ON RETURN OF br-scales IN FRAME d-gds-prt
      489   DO:
      490     if as-ref
      491         then apply "CHOOSE":U to b-sel.
      492         else apply "CHOOSE":U to b-lkp.
      493   END.
      494   ON CHOOSE OF MENU-ITEM m_hor
      495   DO:
      496     assign
      497     print-option = "hor":U.
      498     apply "CHOOSE" to b-print in frame d-gds-prt.
      499   END.
      500   ON CHOOSE OF MENU-ITEM m_vert
      501   DO:
      502       assign
      503     print-option = "vert":U.
      504     apply "CHOOSE" to b-print in frame d-gds-prt.
      505   END.
      506   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-gds-prt:PARENT eq ?
      507   THEN FRAME d-gds-prt:PARENT = ACTIVE-WINDOW.
      508   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      509   on help of frame d-gds-prt
      510   do:
      511     run gbl/app_help.p
      512       (input this-procedure :file-name
      513       ,input ''
      514       ,input ?
      515       ) no-error.
      516     if error-status :error then do:
      517       message
      518         "Ошибка при вызове помощи"
      519         error-status :get-message(1)
      520         view-as alert-box .
      521     end.
      522   end.
      523   run minbtn-set in this-procedure .
      524   on choose of b-help in frame d-gds-prt
      525   do:
      526     apply "help":u to frame d-gds-prt .
      527   end.
      528   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      529   procedure minbtn-set :
      530       do
      531           on error undo, return error return-value
      532           :
      533           define variable ii              as integer       no-undo .
      534           define variable fh              as widget-handle no-undo .
      535           define variable hh              as widget-handle no-undo .
      536           define variable v-h             as handle        extent 4 no-undo .
      537           define variable v-name-button   as character     no-undo .
      538           define variable v-help-old-x    as decimal       no-undo .
      539           define variable v-help-old-y    as decimal       no-undo .
      540           define variable v-help-old-size as decimal       no-undo .
      541           define variable v-frame-width   as decimal       no-undo .
      542           define variable jj              as integer       no-undo .
      543           do
      544               on error undo, return error
      545               :
      546               assign
      547                   v-frame-width = frame d-gds-prt:width - 0.3
      548                   fh            = frame d-gds-prt:first-child
      549                   hh            = fh:first-child
      550                   ii            = 1
      551                   .
      552               do while valid-handle(hh):
      553                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      554                   do:
      555                       case lc(hh:name) :
      556                           when "b-help" then
      557                               do:
      558                                   hh:load-image-up("cmp/b-help.bmp":u) .
      559                                   hh:load-image-down("cmp/b-help.bmp":u) .
      560                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      561                                   hh:TOOLTIP = "Помощь" .
      562                                   v-help-old-x = hh:column .
      563                                   v-help-old-y = hh:row    .
      564                                   v-help-old-size = hh:width .
      565                                   hh:width-chars = 2.5 .
      566                               end.
      567                           when "b-print" then
      568                               do:
      569                                   hh:load-image("cmp/b-print.bmp":u) .
      570                                   hh:TOOLTIP = "Печать" .
      571                                   v-h[ii] = hh:handle .
      572                                   ii = ii + 1 .
      573                                   hh:width-chars = 3 .
      574                               end.
      575                           when "b-history" or
      576                           when "b-hist" then
      577                               do:
      578                                   hh:load-image("cmp/b-hist.bmp":u) .
      579                                   hh:TOOLTIP = "История" .
      580                                   v-h[ii] = hh:handle .
      581                                   ii = ii + 1 .
      582                                   hh:width-chars = 3 .
      583                               end.
      584                           when "b-sch" then
      585                               do:
      586                                   hh:load-image("cmp/b-sch.bmp":u) .
      587                                   hh:TOOLTIP = "Установка Фильтра" .
      588                                   v-h[ii] = hh:handle .
      589                                   ii = ii + 1 .
      590                                   hh:width-chars = 3 .
      591                               end.
      592                           when "b-hist-user" then
      593                               do:
      594                                   hh:load-image("cmp/b-hist.bmp":u) .
      595                                   hh:TOOLTIP = "История пользователя" .
      596                                   ii = ii + 1 .
      597                               end.
      598                       end case.
      599                   end.
      600                   hh = hh:next-sibling.
      601               end.
      602               b-help:column = v-frame-width - b-help:width-chars.
      603               jj = 0.
      604               repeat ii = 4 to 1 by -1 :
      605                   if valid-handle (v-h[ii] ) then
      606                   do:
      607                       jj  = jj + 1 .
      608                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      609                       v-h[ii]:row    = v-help-old-y .
      610                   end.
      611               end.
      612           end.
      613       end.
      614   end procedure.
      615   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      616   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      617   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      618   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      619   define variable v-diasize-current-frame-width  as decimal   no-undo .
      620   define variable v-diasize-current-frame-height as decimal   no-undo .
      621   define variable v-diasize-change-size          as logical   no-undo .
      622   define variable v-diasize-resize-button        as handle    no-undo .
      623   define variable v-diasize-wndmax               as logical   no-undo .
      624   define variable v-diasize-wndstore             as logical   no-undo .
      625   define variable v-diasize-proc-name            as character no-undo .
      626   define variable v-diasize-browse-handle        as handle    no-undo .
      627   define variable v-diasize-browse-number        as integer   no-undo .
      628   define variable v-diasize-need-full-display    as logical   no-undo init false .
      629   define temp-table temp-diasize-handle no-undo
      630     field handle-value  as handle
      631     field save-position as decimal
      632     index xpk is primary unique handle-value
      633     .
      634   define temp-table temp-browse-handle no-undo
      635     field browse-type   as character
      636     field browse-number as integer
      637     field browse-handle as handle
      638     field original-size as decimal
      639     index xpk is primary unique browse-type browse-number
      640     index xie browse-type browse-handle
      641   .
      642   procedure diasize_change-height :
      643     define input  parameter p-change-value  as decimal   no-undo .
      644     define input  parameter p-move-resize   as logical   no-undo .
      645     define variable v-field-group-handle    as handle    no-undo .
      646     define variable v-object-handle         as handle    no-undo .
      647     define variable v-frame-height          as decimal   no-undo .
      648     define variable v-frame-virtual-height  as decimal   no-undo .
      649     define variable v-browse-height         as decimal   no-undo .
      650     define variable v-window-height         as decimal   no-undo .
      651     define variable v-window-virtual-height as decimal   no-undo .
      652     define variable v-change-sign           as integer   no-undo .
      653     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      654     define buffer buf_temp-browse-handle  for temp-browse-handle .
      655     if p-change-value > 0
      656     then do:
      657       if frame d-gds-prt :height + p-change-value
      658           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      659       then do:
      660         assign
      661           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      662                           - (frame d-gds-prt :height-chars)
      663         .
      664         if p-change-value <= 0
      665         then do:
      666           run diasize_position-resize-button in this-procedure .
      667           return .
      668         end.
      669       end.
      670     end.
      671     if p-change-value < 0
      672     then do:
      673       if frame d-gds-prt :height + p-change-value < v-diasize-orig-frame-height
      674       then do:
      675         assign
      676           p-change-value = v-diasize-orig-frame-height
      677                          - (frame d-gds-prt :height-chars)
      678         .
      679         if p-change-value >= 0
      680         then do:
      681           run diasize_position-resize-button in this-procedure .
      682           return .
      683         end.
      684       end.
      685     end.
      686     if p-change-value >= 0
      687     then do:
      688       assign
      689         v-change-sign = 1
      690       .
      691     end.
      692     else do:
      693       assign
      694         v-change-sign = -1
      695       .
      696     end.
      697     assign
      698       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      699     .
      700     if p-change-value = 0
      701     then do:
      702       run diasize_position-resize-button in this-procedure .
      703       return .
      704     end.
      705     move_block:
      706     do
      707     on error undo move_block, retry move_block
      708     :
      709       if retry
      710       then do:
      711         do
      712         on error undo move_block, leave move_block
      713         :
      714           if p-change-value > 0
      715           then do:
      716             for each buf_temp-diasize-handle
      717             on error undo, next
      718             :
      719               assign
      720                 v-object-handle = buf_temp-diasize-handle.handle-value
      721               .
      722               if v-object-handle <> v-diasize-resize-button
      723               then do:
      724                 assign
      725                   v-object-handle :row = buf_temp-diasize-handle.save-position
      726                 .
      727               end.
      728             end.
      729             assign
      730               v-diasize-browse-handle :height = v-browse-height
      731             .
      732             for each buf_temp-browse-handle
      733               where buf_temp-browse-handle.browse-type = 'height':u
      734             on error undo, next
      735             :
      736               assign
      737                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      738               .
      739             end.
      740             assign
      741               frame d-gds-prt :height = v-frame-height
      742             .
      743             if frame d-gds-prt :scrollable = true
      744             then do:
      745               assign
      746                 frame d-gds-prt :virtual-height = v-frame-virtual-height
      747               .
      748             end.
      749             run diasize_position-resize-button in this-procedure .
      750           end.
      751           else do:
      752             if frame d-gds-prt :scrollable = true
      753             then do:
      754               assign
      755                 frame d-gds-prt :virtual-height = v-frame-virtual-height
      756               .
      757             end.
      758             assign
      759               frame d-gds-prt :height = v-frame-height
      760             .
      761             assign
      762               v-diasize-browse-handle :height = v-browse-height
      763             .
      764             for each buf_temp-browse-handle
      765               where buf_temp-browse-handle.browse-type = 'height':u
      766             on error undo, next
      767             :
      768               assign
      769                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      770               .
      771             end.
      772             for each buf_temp-diasize-handle
      773             on error undo, next
      774             :
      775               assign
      776                 v-object-handle = buf_temp-diasize-handle.handle-value
      777               .
      778               if v-object-handle <> v-diasize-resize-button
      779               then do:
      780                 assign
      781                   v-object-handle :row = buf_temp-diasize-handle.save-position
      782                 .
      783               end.
      784             end.
      785             run diasize_position-resize-button in this-procedure .
      786           end.
      787           assign
      788             v-diasize-change-size = false
      789           .
      790           leave move_block .
      791         end.
      792       end.
      793       assign
      794         v-diasize-need-full-display = true
      795       .
      796       if v-diasize-change-size = false
      797       then do:
      798         assign
      799           v-diasize-change-size = true
      800         .
      801       end.
      802       else do:
      803         return .
      804       end.
      805       assign
      806         v-frame-height = frame d-gds-prt :height
      807         v-frame-virtual-height = frame d-gds-prt :virtual-height
      808         v-browse-height = v-diasize-browse-handle :height
      809       .
      810       for each buf_temp-browse-handle
      811         where buf_temp-browse-handle.browse-type = 'height':u
      812       :
      813         assign
      814           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      815         .
      816       end.
      817       for each buf_temp-diasize-handle
      818       :
      819         delete buf_temp-diasize-handle .
      820       end.
      821       assign
      822         v-field-group-handle = frame d-gds-prt :first-child
      823       .
      824       do while valid-handle(v-field-group-handle)
      825       :
      826         assign
      827           v-object-handle = v-field-group-handle :first-child
      828         .
      829         do while valid-handle(v-object-handle)
      830         :
      831           if  v-object-handle <> v-diasize-browse-handle :handle
      832           and can-query(v-object-handle, "row")
      833           and can-query(v-object-handle, "height")
      834           and ( v-object-handle :row > v-diasize-browse-handle :row )
      835           then do:
      836             find first buf_temp-browse-handle
      837               where buf_temp-browse-handle.browse-type   = 'height':u
      838                 and buf_temp-browse-handle.browse-handle = v-object-handle
      839               no-error .
      840             if available buf_temp-browse-handle
      841             then do:
      842             end.
      843             else do:
      844               create buf_temp-diasize-handle .
      845               assign
      846                 buf_temp-diasize-handle.handle-value  = v-object-handle
      847                 buf_temp-diasize-handle.save-position = v-object-handle :row
      848               .
      849             end.
      850           end.
      851           assign
      852             v-object-handle = v-object-handle :next-sibling
      853           .
      854         end.
      855         assign
      856           v-field-group-handle = v-field-group-handle :next-sibling
      857         .
      858       end.
      859       do with frame d-gds-prt
      860       :
      861         hide v-diasize-resize-button .
      862         assign
      863           v-diasize-resize-button :row    = 1
      864           v-diasize-resize-button :column = 1
      865         .
      866       end.
      867       if p-change-value > 0
      868       then do:
      869         if frame d-gds-prt :scrollable = true
      870         then do:
      871           assign
      872             frame d-gds-prt :virtual-height = frame d-gds-prt :virtual-height + p-change-value
      873             no-error .
      874           if error-status :error
      875           or error-status :get-message(1) <> ""
      876           then do:
      877             undo move_block, retry move_block .
      878           end.
      879         end.
      880         assign
      881           frame d-gds-prt :height = frame d-gds-prt :height + p-change-value
      882           no-error .
      883         if error-status :error
      884         or error-status :get-message(1) <> ""
      885         then do:
      886           undo move_block, retry move_block .
      887         end.
      888         assign
      889           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      890           no-error .
      891         if error-status :error
      892         or error-status :get-message(1) <> ""
      893         then do:
      894           undo move_block, retry move_block .
      895         end.
      896         for each buf_temp-browse-handle
      897           where buf_temp-browse-handle.browse-type = 'height':u
      898         on error undo move_block, retry move_block
      899         :
      900           assign
      901             buf_temp-browse-handle.browse-handle :height
      902               = buf_temp-browse-handle.browse-handle :height + p-change-value
      903             no-error .
      904           if error-status :error
      905           or error-status :get-message(1) <> ""
      906           then do:
      907             undo move_block, retry move_block .
      908           end.
      909         end.
      910         for each buf_temp-diasize-handle
      911         on error undo move_block, retry move_block
      912         :
      913           assign
      914             v-object-handle = buf_temp-diasize-handle.handle-value
      915           .
      916           if v-object-handle <> v-diasize-resize-button
      917           then do:
      918             assign
      919               v-object-handle :row = v-object-handle :row + p-change-value
      920               no-error .
      921             if error-status :error
      922             or error-status :get-message(1) <> ""
      923             then do:
      924               undo move_block, retry move_block .
      925             end.
      926           end.
      927         end.
      928       end.
      929       else do:
      930         for each buf_temp-diasize-handle
      931         on error undo move_block, retry move_block
      932         :
      933           assign
      934             v-object-handle = buf_temp-diasize-handle.handle-value
      935           .
      936           if v-object-handle <> v-diasize-resize-button
      937           then do:
      938             assign
      939               v-object-handle :row = v-object-handle :row + p-change-value
      940               no-error .
      941             if error-status :error
      942             or error-status :get-message(1) <> ""
      943             then do:
      944               undo move_block, retry move_block .
      945             end.
      946           end.
      947         end.
      948         assign
      949           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      950           no-error .
      951         if error-status :error
      952         or error-status :get-message(1) <> ""
      953         then do:
      954           undo move_block, retry move_block .
      955         end.
      956         for each buf_temp-browse-handle
      957           where buf_temp-browse-handle.browse-type = 'height':u
      958         on error undo move_block, retry move_block
      959         :
      960           assign
      961             buf_temp-browse-handle.browse-handle :height
      962               = buf_temp-browse-handle.browse-handle :height + p-change-value
      963             no-error .
      964           if error-status :error
      965           or error-status :get-message(1) <> ""
      966           then do:
      967             undo move_block, retry move_block .
      968           end.
      969         end.
      970         assign
      971           frame d-gds-prt :height = frame d-gds-prt :height + p-change-value
      972           no-error .
      973         if error-status :error
      974         or error-status :get-message(1) <> ""
      975         then do:
      976           undo move_block, retry move_block .
      977         end.
      978         if frame d-gds-prt :scrollable = true
      979         then do:
      980           assign
      981             frame d-gds-prt :virtual-height = frame d-gds-prt :virtual-height + p-change-value
      982             no-error .
      983           if error-status :error
      984           or error-status :get-message(1) <> ""
      985           then do:
      986             undo move_block, retry move_block .
      987           end.
      988         end.
      989       end.
      990       if p-move-resize = true
      991       then do:
      992         run diasize_position-resize-button in this-procedure .
      993       end.
      994       if v-diasize-wndstore = true
      995       then do:
      996         if connected("ub") = true
      997         then do:
      998           define variable v-cntxt-db-num        as integer   no-undo .
      999           define variable v-cntxt-userid        as character no-undo .
     1000           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1001                                             , OUTPUT v-cntxt-userid
     1002                                             ) .
     1003           run gbl/wndsizew.p
     1004             (input  v-cntxt-db-num
     1005             ,input  v-cntxt-userid
     1006             ,input  v-diasize-proc-name
     1007             ,input  'height':u
     1008             ,input  string(frame d-gds-prt :height - v-diasize-orig-frame-height)
     1009             ) .
     1010         end.
     1011       end.
     1012     end.
     1013     assign
     1014       v-diasize-change-size = false
     1015     .
     1016   end procedure.
     1017   procedure diasize_set-height :
     1018     define input  parameter p-new-height  as decimal   no-undo .
     1019     define input  parameter p-move-resize as logical   no-undo .
     1020     do
     1021     on error undo, return error return-value
     1022     :
     1023       run diasize_change-height in this-procedure
     1024         (input  (p-new-height - frame d-gds-prt :height)
     1025         ,input  p-move-resize
     1026         ) .
     1027     end.
     1028   end procedure.
     1029   procedure diasize_change-width :
     1030     define input  parameter p-change-value as decimal   no-undo .
     1031     define input  parameter p-move-resize  as logical   no-undo .
     1032     define variable v-field-group-handle   as handle    no-undo .
     1033     define variable v-object-handle        as handle    no-undo .
     1034     define variable v-frame-width          as decimal   no-undo .
     1035     define variable v-frame-virtual-width  as decimal   no-undo .
     1036     define variable v-browse-width         as decimal   no-undo .
     1037     define variable v-window-width         as decimal   no-undo .
     1038     define variable v-window-virtual-width as decimal   no-undo .
     1039     define variable v-change-sign          as integer   no-undo .
     1040     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1041     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1042     if p-change-value > 0
     1043     then do:
     1044       if frame d-gds-prt :width + p-change-value >
     1045           session :width-chars
     1046       then do:
     1047         assign
     1048           p-change-value = session :width-chars - frame d-gds-prt :width
     1049         .
     1050         if p-change-value <= 0
     1051         then do:
     1052           run diasize_position-resize-button in this-procedure .
     1053           return .
     1054         end.
     1055       end.
     1056     end.
     1057     if p-change-value < 0
     1058     then do:
     1059       if frame d-gds-prt :width + p-change-value < v-diasize-orig-frame-width
     1060       then do:
     1061         assign
     1062           p-change-value = v-diasize-orig-frame-width
     1063                          - frame d-gds-prt :width
     1064         .
     1065         if p-change-value >= 0
     1066         then do:
     1067           run diasize_position-resize-button in this-procedure .
     1068           return .
     1069         end.
     1070       end.
     1071     end.
     1072     if p-change-value >= 0
     1073     then do:
     1074       assign
     1075         v-change-sign = 1
     1076       .
     1077     end.
     1078     else do:
     1079       assign
     1080         v-change-sign = -1
     1081       .
     1082     end.
     1083     assign
     1084       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1085     .
     1086     if p-change-value = 0
     1087     then do:
     1088       run diasize_position-resize-button in this-procedure .
     1089       return .
     1090     end.
     1091     move_block:
     1092     do
     1093     on error undo move_block, leave move_block
     1094     :
     1095       if retry
     1096       then do:
     1097         do
     1098         on error undo move_block, leave move_block
     1099         :
     1100           if p-change-value > 0
     1101           then do:
     1102             for each buf_temp-diasize-handle
     1103             on error undo, next
     1104             :
     1105               assign
     1106                 v-object-handle = buf_temp-diasize-handle.handle-value
     1107               .
     1108               if v-object-handle <> v-diasize-resize-button
     1109               then do:
     1110                 assign
     1111                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1112                 .
     1113               end.
     1114             end.
     1115             assign
     1116               v-diasize-browse-handle :width = v-browse-width
     1117             .
     1118             for each buf_temp-browse-handle
     1119               where buf_temp-browse-handle.browse-type = 'width':u
     1120             on error undo, next
     1121             :
     1122               assign
     1123                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1124               .
     1125             end.
     1126             assign
     1127               frame d-gds-prt :width = v-frame-width
     1128             .
     1129             if frame d-gds-prt :scrollable = true
     1130             then do:
     1131               assign
     1132                 frame d-gds-prt :virtual-width = v-frame-virtual-width
     1133               .
     1134             end.
     1135             run diasize_position-resize-button in this-procedure .
     1136           end.
     1137           else do:
     1138             if frame d-gds-prt :scrollable = true
     1139             then do:
     1140               assign
     1141                 frame d-gds-prt :virtual-width = v-frame-virtual-width
     1142               .
     1143             end.
     1144             assign
     1145               frame d-gds-prt :width = v-frame-width
     1146             .
     1147             for each buf_temp-browse-handle
     1148               where buf_temp-browse-handle.browse-type = 'width':u
     1149             on error undo, next
     1150             :
     1151               assign
     1152                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1153               .
     1154             end.
     1155             assign
     1156               v-diasize-browse-handle :width = v-browse-width
     1157             .
     1158             for each buf_temp-diasize-handle
     1159             on error undo, next
     1160             :
     1161               assign
     1162                 v-object-handle = buf_temp-diasize-handle.handle-value
     1163               .
     1164               if v-object-handle <> v-diasize-resize-button
     1165               then do:
     1166                 assign
     1167                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1168                 .
     1169               end.
     1170             end.
     1171             run diasize_position-resize-button in this-procedure .
     1172           end.
     1173           assign
     1174             v-diasize-change-size = false
     1175           .
     1176           leave move_block .
     1177         end.
     1178       end.
     1179       assign
     1180         v-diasize-need-full-display = true
     1181       .
     1182       if v-diasize-change-size = false
     1183       then do:
     1184         assign
     1185           v-diasize-change-size = true
     1186         .
     1187       end.
     1188       else do:
     1189         return .
     1190       end.
     1191       assign
     1192         v-frame-width = frame d-gds-prt :width
     1193         v-frame-virtual-width = frame d-gds-prt :virtual-width
     1194         v-browse-width = v-diasize-browse-handle :width
     1195       .
     1196       for each buf_temp-browse-handle
     1197         where buf_temp-browse-handle.browse-type = 'width':u
     1198       :
     1199         assign
     1200           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1201         .
     1202       end.
     1203       for each buf_temp-diasize-handle
     1204       :
     1205         delete buf_temp-diasize-handle .
     1206       end.
     1207       assign
     1208         v-field-group-handle = frame d-gds-prt :first-child
     1209       .
     1210       do while valid-handle(v-field-group-handle)
     1211       :
     1212         assign
     1213           v-object-handle = v-field-group-handle :first-child
     1214         .
     1215         do while valid-handle(v-object-handle)
     1216         :
     1217           if  v-object-handle <> v-diasize-browse-handle :handle
     1218           and v-object-handle <> v-diasize-resize-button
     1219           and can-query(v-object-handle, "row")
     1220           and can-query(v-object-handle, "height")
     1221           and ( v-object-handle :col + v-object-handle :width
     1222                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1223               )
     1224           then do:
     1225             find first buf_temp-browse-handle
     1226               where buf_temp-browse-handle.browse-type   = 'width':u
     1227                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1228               no-error .
     1229             if available buf_temp-browse-handle
     1230             then do:
     1231             end.
     1232             else do:
     1233               create buf_temp-diasize-handle .
     1234               assign
     1235                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1236                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1237               .
     1238             end.
     1239           end.
     1240           assign
     1241             v-object-handle = v-object-handle :next-sibling
     1242           .
     1243         end.
     1244         assign
     1245           v-field-group-handle = v-field-group-handle :next-sibling
     1246         .
     1247       end.
     1248       do with frame d-gds-prt
     1249       :
     1250         hide v-diasize-resize-button .
     1251         v-diasize-resize-button :row = 1.
     1252         v-diasize-resize-button :column = 1.
     1253       end.
     1254       if p-change-value > 0
     1255       then do:
     1256         if frame d-gds-prt :scrollable = true
     1257         then do:
     1258           assign
     1259             frame d-gds-prt :virtual-width = frame d-gds-prt :virtual-width + p-change-value
     1260             no-error .
     1261           if error-status :error
     1262           or error-status :get-message(1) <> ""
     1263           then do:
     1264             undo move_block, retry move_block.
     1265           end.
     1266         end.
     1267         assign
     1268           frame d-gds-prt :width = v-frame-width + p-change-value
     1269           no-error .
     1270         if error-status :error
     1271         or error-status :get-message(1) <> ""
     1272         then do:
     1273           undo move_block, retry move_block.
     1274         end.
     1275         assign
     1276           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1277         no-error .
     1278         if error-status :error
     1279         or error-status :get-message(1) <> ""
     1280         then do:
     1281           undo move_block, retry move_block.
     1282         end.
     1283         for each buf_temp-browse-handle
     1284           where buf_temp-browse-handle.browse-type = 'width':u
     1285         on error undo move_block, retry move_block
     1286         :
     1287           assign
     1288             buf_temp-browse-handle.browse-handle :width
     1289               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1290             no-error .
     1291           if error-status :error
     1292           or error-status :get-message(1) <> ""
     1293           then do:
     1294             undo move_block, retry move_block .
     1295           end.
     1296         end.
     1297         for each buf_temp-diasize-handle
     1298         on error undo move_block, retry move_block
     1299         :
     1300           assign
     1301             v-object-handle = buf_temp-diasize-handle.handle-value
     1302           .
     1303           if v-object-handle <> v-diasize-resize-button
     1304           then do:
     1305             assign
     1306               v-object-handle :col = v-object-handle :col + p-change-value
     1307               no-error .
     1308             if error-status :error
     1309             or error-status :get-message(1) <> ""
     1310             then do:
     1311               undo move_block, retry move_block .
     1312             end.
     1313           end.
     1314         end.
     1315       end.
     1316       else do:
     1317         for each buf_temp-diasize-handle
     1318         on error undo move_block, retry move_block
     1319         :
     1320           assign
     1321             v-object-handle = buf_temp-diasize-handle.handle-value
     1322           .
     1323           if v-object-handle <> v-diasize-resize-button
     1324           then do:
     1325             assign
     1326               v-object-handle :col = v-object-handle :col + p-change-value
     1327               no-error .
     1328             if error-status :error
     1329             or error-status :get-message(1) <> ""
     1330             then do:
     1331               undo move_block, retry move_block .
     1332             end.
     1333           end.
     1334         end.
     1335         for each buf_temp-browse-handle
     1336           where buf_temp-browse-handle.browse-type = 'width':u
     1337         on error undo move_block, retry move_block
     1338         :
     1339           assign
     1340             buf_temp-browse-handle.browse-handle :width
     1341               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1342             no-error .
     1343           if error-status :error
     1344           or error-status :get-message(1) <> ""
     1345           then do:
     1346             undo move_block, retry move_block .
     1347           end.
     1348         end.
     1349         assign
     1350           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1351           no-error .
     1352         if error-status :error
     1353         or error-status :get-message(1) <> ""
     1354         then do:
     1355           undo move_block, retry move_block.
     1356         end.
     1357         assign
     1358           frame d-gds-prt :width = frame d-gds-prt :width + p-change-value
     1359         no-error .
     1360         if error-status :error
     1361         or error-status :get-message(1) <> ""
     1362         then do:
     1363           undo move_block, retry move_block.
     1364         end.
     1365         if frame d-gds-prt :scrollable = true
     1366         then do:
     1367           assign
     1368             frame d-gds-prt :virtual-width = frame d-gds-prt :virtual-width + p-change-value
     1369           no-error .
     1370           if error-status :error
     1371           or error-status :get-message(1) <> ""
     1372           then do:
     1373             undo move_block, retry move_block.
     1374           end.
     1375         end.
     1376       end.
     1377       if p-move-resize
     1378       then do:
     1379         run diasize_position-resize-button in this-procedure .
     1380       end.
     1381       if v-diasize-wndstore = true
     1382       then do:
     1383         if connected("ub") = true
     1384         then do:
     1385           define variable v-cntxt-db-num        as integer   no-undo .
     1386           define variable v-cntxt-userid        as character no-undo .
     1387           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1388                                             , OUTPUT v-cntxt-userid
     1389                                             ) .
     1390           run gbl/wndsizew.p
     1391             (input  v-cntxt-db-num
     1392             ,input  v-cntxt-userid
     1393             ,input  v-diasize-proc-name
     1394             ,input  'width':u
     1395             ,input  string(frame d-gds-prt :width - v-diasize-orig-frame-width)
     1396             ) .
     1397         end.
     1398       end.
     1399     end.
     1400     assign
     1401       v-diasize-change-size = false
     1402     .
     1403   end procedure.
     1404   procedure diasize_set-width :
     1405     define input  parameter p-new-width  as decimal   no-undo .
     1406     define input  parameter p-move-resize as logical   no-undo .
     1407     do
     1408     on error undo, return error return-value
     1409     :
     1410       run diasize_change-width in this-procedure
     1411         (input  (p-new-width - frame d-gds-prt :width)
     1412         ,input  p-move-resize
     1413         ) .
     1414     end.
     1415   end procedure.
     1416   procedure diasize_position-resize-button :
     1417     do with frame d-gds-prt
     1418     :
     1419       hide v-diasize-resize-button .
     1420       assign
     1421         v-diasize-resize-button :row = frame d-gds-prt :height - v-diasize-resize-button :height
     1422                     - 1
     1423                     - (frame d-gds-prt :border-bottom-pixels / session :pixels-per-row)
     1424         v-diasize-resize-button :col = frame d-gds-prt :width - v-diasize-resize-button :width
     1425                     - 1
     1426                     - (frame d-gds-prt :border-right-pixels / session :pixels-per-column)
     1427       .
     1428       view v-diasize-resize-button .
     1429     end.
     1430   end procedure.
     1431   on alt-right anywhere
     1432   do:
     1433     run diasize_change-width in this-procedure
     1434       (input 1
     1435       ,input true
     1436       ) .
     1437     return no-apply .
     1438   end.
     1439   on alt-left anywhere
     1440   do:
     1441     run diasize_change-width in this-procedure
     1442       (input -1
     1443       ,input true
     1444       ) .
     1445     return no-apply .
     1446   end.
     1447   on alt-down anywhere
     1448   do:
     1449     run diasize_change-height in this-procedure
     1450       (input 1
     1451       ,input true
     1452       ) .
     1453     return no-apply .
     1454   end.
     1455   on alt-up anywhere
     1456   do:
     1457     run diasize_change-height in this-procedure
     1458       (input -1
     1459       ,input true
     1460       ) .
     1461     return no-apply .
     1462   end.
     1463   on alt-enter of frame d-gds-prt
     1464   do:
     1465     run diasize_maximize in this-procedure
     1466       (input  ?
     1467       ).
     1468     return no-apply .
     1469   end.
     1470   procedure diasize_end-move :
     1471     do
     1472     on error undo, return error return-value
     1473     :
     1474       define variable v-row-delta as decimal   no-undo .
     1475       define variable v-col-delta as decimal   no-undo .
     1476       define variable v-new-row as decimal   no-undo .
     1477       define variable v-new-col as decimal   no-undo .
     1478       assign
     1479         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1480         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1481       .
     1482       assign
     1483         v-row-delta = v-new-row - frame d-gds-prt :height
     1484         v-col-delta = v-new-col - frame d-gds-prt :width
     1485       .
     1486       run diasize_change-height in this-procedure
     1487         (input v-row-delta
     1488         ,input true
     1489         ) .
     1490       run diasize_change-width in this-procedure
     1491         (input v-col-delta
     1492         ,input true
     1493         ) .
     1494     end.
     1495   end procedure.
     1496   procedure diasize_maximize :
     1497     define input  parameter p-action as logical   no-undo .
     1498     do
     1499     on error undo, return error return-value
     1500     :
     1501       if p-action = ?
     1502       then do:
     1503         if v-diasize-need-maximize = true
     1504         then do:
     1505           assign
     1506             p-action = true
     1507           .
     1508         end.
     1509         else do:
     1510           assign
     1511             p-action = false
     1512           .
     1513         end.
     1514       end.
     1515       if p-action = true
     1516       then do:
     1517         run diasize_change-height in this-procedure
     1518           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1519               - frame d-gds-prt :height-chars
     1520           ,input true
     1521           ) .
     1522         run diasize_change-width in this-procedure
     1523           (input session :width-chars
     1524               - frame d-gds-prt :width-chars
     1525           ,input true
     1526           ) .
     1527         assign
     1528           v-diasize-need-maximize = false
     1529         .
     1530       end.
     1531       else do:
     1532         run diasize_change-width in this-procedure
     1533           (input v-diasize-orig-frame-width
     1534               - frame d-gds-prt :width-chars
     1535           ,input true
     1536           ) .
     1537         run diasize_change-height in this-procedure
     1538           (input v-diasize-orig-frame-height
     1539               - frame d-gds-prt :height-chars
     1540           ,input true
     1541           ) .
     1542         assign
     1543           v-diasize-need-maximize = true
     1544         .
     1545       end.
     1546     end.
     1547   end procedure.
     1548   procedure diasize_restore-orig-size :
     1549     do
     1550     on error undo, return error return-value
     1551     :
     1552       assign
     1553         v-diasize-current-frame-width  = frame d-gds-prt :width
     1554         v-diasize-current-frame-height = frame d-gds-prt :height
     1555       .
     1556       run diasize_set-height in this-procedure
     1557         (input  v-diasize-orig-frame-height
     1558         ,input  true
     1559         ) .
     1560       run diasize_set-width in this-procedure
     1561         (input  v-diasize-orig-frame-width
     1562         ,input  true
     1563         ) .
     1564     end.
     1565   end procedure.
     1566   procedure diasize_restore-current-size :
     1567     do
     1568     on error undo, return error return-value
     1569     :
     1570       run diasize_set-height in this-procedure
     1571         (input  v-diasize-current-frame-height
     1572         ,input  true
     1573         ) .
     1574       run diasize_set-width in this-procedure
     1575         (input  v-diasize-current-frame-width
     1576         ,input  true
     1577         ) .
     1578     end.
     1579   end procedure.
     1580   procedure diasize_set-browse-handle :
     1581     define input  parameter p-browse-handle as handle   no-undo .
     1582     define buffer buf_temp-browse-handle for temp-browse-handle .
     1583     do
     1584     on error undo, return error return-value
     1585     :
     1586       assign
     1587         v-diasize-browse-handle = p-browse-handle
     1588       .
     1589       for each buf_temp-browse-handle
     1590       on error undo, return error return-value
     1591       :
     1592         delete buf_temp-browse-handle .
     1593       end.
     1594     end.
     1595   end procedure.
     1596   procedure diasize_add_browse :
     1597     define input  parameter p-browse-type   as character no-undo .
     1598     define input  parameter p-browse-handle as handle    no-undo .
     1599     define buffer buf_temp-browse-handle for temp-browse-handle .
     1600     do
     1601     on error undo, return error return-value
     1602     :
     1603       assign
     1604         v-diasize-browse-number = v-diasize-browse-number + 1
     1605       .
     1606       create buf_temp-browse-handle .
     1607       assign
     1608         buf_temp-browse-handle.browse-type   = p-browse-type
     1609         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1610         buf_temp-browse-handle.browse-handle = p-browse-handle
     1611       .
     1612     end.
     1613   end procedure.
     1614   procedure diasize_init :
     1615     define variable v-default-value    as logical   no-undo .
     1616     define variable v-restore-saved    as logical   no-undo .
     1617     define variable v-resize-value-str as character no-undo .
     1618     do
     1619     on error undo, return error return-value
     1620     :
     1621       do with frame d-gds-prt
     1622       :
     1623         assign
     1624           v-diasize-orig-frame-height = frame d-gds-prt :height
     1625           v-diasize-orig-frame-width  = frame d-gds-prt :width
     1626           v-diasize-browse-handle     = browse br-scales :handle
     1627         .
     1628         create button v-diasize-resize-button
     1629         assign
     1630           parent        = frame d-gds-prt :first-child
     1631           label         = "s"
     1632           height-pixels = 16
     1633           width-pixels  = 16
     1634           visible       = true
     1635           sensitive     = true
     1636           movable       = true
     1637           triggers:
     1638             on end-move persistent run diasize_end-move in this-procedure .
     1639           end triggers.
     1640         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1641         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1642         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1643         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1644         assign
     1645           v-diasize-wndmax = false
     1646         .
     1647         if connected("ub") = true
     1648         then do:
     1649           define variable v-cntxt-db-num        as integer   no-undo .
     1650           define variable v-cntxt-userid        as character no-undo .
     1651           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1652                                             , OUTPUT v-cntxt-userid
     1653                                             ) .
     1654           run gbl/wndpar_r.p
     1655             (input  v-cntxt-db-num
     1656             ,input  v-cntxt-userid
     1657             ,input  'wndmax':U
     1658             ,output v-diasize-wndmax
     1659             ,output v-default-value
     1660             ) .
     1661         end.
     1662         assign
     1663           v-diasize-wndstore = false
     1664         .
     1665         if connected("ub") = true
     1666         then do:
     1667           run gbl/wndpar_r.p
     1668             (input  v-cntxt-db-num
     1669             ,input  v-cntxt-userid
     1670             ,input  'wndstore':U
     1671             ,output v-diasize-wndstore
     1672             ,output v-default-value
     1673             ) .
     1674         end.
     1675         assign
     1676           v-diasize-proc-name = entry(1, program-name(2), '.')
     1677         .
     1678         if v-diasize-wndstore = true
     1679         then do:
     1680           assign
     1681             v-restore-saved = false
     1682           .
     1683           if connected("ub") = true
     1684           then do:
     1685             run gbl/wndsizer.p
     1686               (input  v-cntxt-db-num
     1687               ,input  v-cntxt-userid
     1688               ,input  v-diasize-proc-name
     1689               ,input  'height':u
     1690               ,output v-resize-value-str
     1691               ) .
     1692             if v-resize-value-str <> '':U
     1693             then do:
     1694               run diasize_change-height in this-procedure
     1695                 (input  integer(v-resize-value-str)
     1696                 ,input  true
     1697                 ) .
     1698               assign
     1699                 v-restore-saved = true
     1700               .
     1701             end.
     1702           end.
     1703           if connected("ub") = true
     1704           then do:
     1705             run gbl/wndsizer.p
     1706               (input  v-cntxt-db-num
     1707               ,input  v-cntxt-userid
     1708               ,input  v-diasize-proc-name
     1709               ,input  'width':u
     1710               ,output v-resize-value-str
     1711               ) .
     1712             if v-resize-value-str <> '':U
     1713             then do:
     1714               run diasize_change-width in this-procedure
     1715                 (input  integer(v-resize-value-str)
     1716                 ,input  true
     1717                 ) .
     1718               assign
     1719                 v-restore-saved = true
     1720               .
     1721             end.
     1722           end.
     1723           if v-restore-saved <> true
     1724           then do:
     1725             if v-diasize-wndmax = true
     1726             then do:
     1727               run diasize_maximize in this-procedure
     1728                 (input  true
     1729                 ) .
     1730             end.
     1731           end.
     1732         end.
     1733         else do:
     1734           if v-diasize-wndmax = true
     1735           then do:
     1736             run diasize_maximize in this-procedure
     1737               (input  true
     1738               ) .
     1739           end.
     1740         end.
     1741       end.
     1742     end.
     1743   end procedure.
     1744   procedure diasize_need-full-display :
     1745     define output parameter p-need-full-display as logical   no-undo .
     1746     do
     1747     on error undo, return error return-value
     1748     :
     1749       assign
     1750         p-need-full-display = v-diasize-need-full-display
     1751       .
     1752       assign
     1753         v-diasize-need-full-display = false
     1754       .
     1755     end.
     1756   end procedure.
     1757   procedure get-context :
     1758      define output parameter p-db-num as integer          no-undo.
     1759      define output parameter p-user-id as character        no-undo.
     1760      define variable v-login               as character    no-undo.
     1761      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1762      define buffer buf_user-login  for ub.user-login .
     1763      do
     1764      on error undo, return error
     1765      :
     1766            FIND FIRST buf_sys-ctrl no-lock.
     1767            ASSIGN
     1768               v-login = USERID("ub")
     1769               p-db-num = buf_sys-ctrl.db-num
     1770            .
     1771            FIND FIRST buf_user-login
     1772                 WHERE buf_user-login.db-num = p-db-num
     1773                   AND buf_user-login.user-login = v-login
     1774                 no-lock
     1775                 no-error
     1776                 .
     1777            IF AVAILABLE buf_user-login
     1778            THEN DO:
     1779               assign
     1780                  p-user-id = buf_user-login.user-id
     1781               .
     1782            END.
     1783      end.
     1784   end procedure.
     1785       run diasize_init in this-procedure .
     1786   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1787   on F3 of frame d-gds-prt anywhere do:
     1788     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame d-gds-prt. END.
     1789     return no-apply.
     1790   end.
     1791   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1792   on CTRL-N, CTRL-Т of frame d-gds-prt anywhere do:
     1793     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame d-gds-prt. END.
     1794     return no-apply.
     1795   end.
     1796   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1797   on F4 of frame d-gds-prt anywhere do:
     1798     if b-chg :sensitive then DO: apply "CHOOSE":U to b-chg in frame d-gds-prt. END.
     1799     return no-apply.
     1800   end.
     1801   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1802   on F8 of frame d-gds-prt anywhere do:
     1803     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame d-gds-prt. END.
     1804     return no-apply.
     1805   end.
     1806   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1807   on F2 of frame d-gds-prt anywhere do:
     1808     if b-sel :sensitive then DO: apply "CHOOSE":U to b-sel in frame d-gds-prt. END.
     1809     return no-apply.
     1810   end.
     1811   ON WINDOW-CLOSE OF FRAME d-gds-prt APPLY "END-ERROR":U TO SELF.
     1812   MAIN-BLOCK:
     1813   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1814      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1815   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1816     run mainmenu_getcntxt in parparentproc
     1817       (output v-cntxt-db-num
     1818       ,output v-cntxt-userid
     1819       ,output v-cntxt-level
     1820       ,output v-cntxt-host-code-obj
     1821       ,output v-cntxt-obj-type
     1822       ,output v-cntxt-obj-code
     1823       ,output v-cntxt-db-num-obj
     1824       ,output v-cntxt-is-admin
     1825       ) .
     1826     if v-cntxt-db-num <> 0
     1827     and not as-ref then do:
     1828       message
     1829       "Нельзя вызывать справочник шкал в режиме изменения в УБД"
     1830       view-as alert-box error .
     1831       return.
     1832     end.
     1833     RUN enable_UI.
     1834     WAIT-FOR GO OF FRAME d-gds-prt.
     1835   END.
     1836   RUN disable_UI.
     1837   PROCEDURE del-scale :
     1838   def input param u-c like ub.gds-prt.upper-code no-undo.
     1839   def buffer d-prt for ub.gds-prt.
     1840   for each d-prt where d-prt.upper-code = u-c:
     1841     run del-scale (d-prt.node-code).
     1842     delete d-prt.
     1843   end.
     1844   END PROCEDURE.
     1845   PROCEDURE disable_UI :
     1846     HIDE FRAME d-gds-prt.
     1847   END PROCEDURE.
     1848   PROCEDURE enable_UI :
     1849   b-print:MENU-MOUSE in frame d-gds-prt  = 1.
     1850     ENABLE br-scales b-lkp b-exit b-help b-hist
     1851         b-sel WHEN as-ref
     1852         b-del  WHEN not as-ref
     1853         b-chg  WHEN not as-ref
     1854         b-add WHEN not as-ref
     1855         b-copy WHEN not as-ref
     1856         b-print
     1857         WITH FRAME d-gds-prt.
     1858     OPEN QUERY br-scales FOR EACH ub.gds-prt       WHERE gds-prt.root = TRUE NO-LOCK.
     1859   END PROCEDURE.
