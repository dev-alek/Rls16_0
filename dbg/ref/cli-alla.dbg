     2619         parameter-5-25 = (" " + "" + " " + substitute(', first x_temp-list-buyer NO-LOCK WHERE (&1 = NO OR (x_temp-list-buyer.obj-type =   X_clients.obj-type AND              x_temp-list-buyer.obj-code =   X_clients.obj-code))'                                              ,v-list-b) + " " + p-find-condition)
     2620         parameter-6-25 = if sort-phrase-25 = ''
     2621                              then
     2622           (
     2623           " " + "  " +
     2624             " " + sort-column-phrase +
     2625           " " + " BY X_clients.obj-name  "
     2626           )
     2627                              else
     2628           (
     2629           " " + "  " +
     2630             " " + sort-column-phrase +
     2631           " " + sort-phrase-25
     2632           )
     2633         parameter-7-25 =
     2634           " indexed-reposition  "
     2635       .
     2636         run fltopend_fltfindq in this-procedure  (
     2637                             input this-procedure:handle
     2638                             ,input query cli-listB:handle
     2639                             ,input logical(parameter-2-25)
     2640                             ,input no-lock
     2641                             ,input parameter-3-25
     2642                             ,input parameter-4-25
     2643                             ,input parameter-5-25
     2644                             ,input parameter-6-25
     2645                             ,input parameter-7-25
     2646                             ,output v-fltopend-rowid
     2647                             ) no-error.
     2648         .
     2649         v-doc-rec = ?.
     2650       end.
     2651       assign
     2652         l-query-was-opened = true
     2653       .
     2654     end.
     2655   end.
     2656     run waitfram-hide in this-procedure .
     2657         end.
     2658         when "NO" then do:
     2659   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2660   define variable  l-disable-where-27  as logical   no-undo .
     2661   define variable  l-filter-open-27    as logical   .
     2662   define variable  flt-rec-27       as recid     no-undo .
     2663   define variable  filter-name-27      as character no-undo .
     2664   define variable  where-phrase-27     as character no-undo .
     2665   define variable  sort-phrase-27      as character no-undo .
     2666   define variable  where-phrase-rus-27 as character no-undo .
     2667   define variable  sort-phrase-rus-27  as character no-undo .
     2668     run waitfram-show in this-procedure
     2669       (input "ЖДИТЕ ..."
     2670       ).
     2671   run gbl/flt-get.p
     2672     (input filter-point
     2673     ,output flt-rec-27
     2674     ,output filter-name-27
     2675     ,output where-phrase-27
     2676     ,output sort-phrase-27
     2677     ,output where-phrase-rus-27
     2678     ,output sort-phrase-rus-27
     2679     ).
     2680   if p-open-query then do:
     2681       run set-filter-name in this-procedure
     2682         (INPUT filter-name-27
     2683         ) no-error .
     2684     assign
     2685       l-filter-open-27 = false
     2686     .
     2687     if flt-rec-27 <> ?
     2688       or sort-column-phrase > ""
     2689     then do:
     2690       define variable  parameter-2-27 as character no-undo .
     2691       define variable  parameter-3-27 as character no-undo .
     2692       define variable  parameter-4-27 as character no-undo .
     2693       define variable  parameter-5-27 as character no-undo .
     2694       define variable  parameter-6-27 as character no-undo .
     2695       define variable  parameter-7-27 as character no-undo .
     2696         assign
     2697         parameter-3-27 =
     2698                                 "FOR EACH X_clients"
     2699         parameter-4-27 =
     2700           (
     2701             if (" X_clients.grp-name begins Curr-Grp-Name                             AND X_clients.stts = 0 " + " " + where-phrase-27) <> ""
     2702             then  substitute('X_clients.grp-name begins &1&2&1                             AND X_clients.stts = 0 ', chr(34), Curr-Grp-Name) + " " + where-phrase-27
     2703             else "true"
     2704           )
     2705         parameter-5-27 = (" " + "" + " " + substitute(', first x_temp-list-buyer NO-LOCK WHERE (&1 = NO OR (x_temp-list-buyer.obj-type =   X_clients.obj-type AND              x_temp-list-buyer.obj-code =   X_clients.obj-code))'                                              ,v-list-b))
     2706         parameter-6-27 = if sort-phrase-27 = ''
     2707                              then
     2708           (
     2709           " " + "  " +
     2710             " " + sort-column-phrase +
     2711           " " + " BY X_clients.obj-name  "
     2712           )
     2713                              else
     2714           (
     2715           " " + "  " +
     2716             " " + sort-column-phrase +
     2717           " " + sort-phrase-27
     2718           )
     2719         parameter-7-27 =
     2720           " indexed-reposition  "
     2721       .
     2722       do
     2723       on stop undo, leave
     2724       on error undo, leave
     2725       :
     2726         assign
     2727           l-disable-where-27 =
     2728             (" X_clients.grp-name begins Curr-Grp-Name                             AND X_clients.stts = 0 " + " " + where-phrase-27 = "")
     2729         .
     2730         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2731                             ,input query cli-listB:handle
     2732                             ,input parameter-3-27
     2733                             ,input parameter-4-27
     2734                             ,input parameter-5-27
     2735                             ,input parameter-6-27
     2736                             ,input parameter-7-27
     2737                             )
     2738         .
     2739         assign
     2740           l-filter-open-27 = true
     2741         .
     2742       end.
     2743       if l-filter-open-27 = false then do:
     2744         message
     2745           "Ошибка при фильтрации / сортировке" skip
     2746           "Будут показаны записи без учета фильтра" skip
     2747           view-as alert-box .
     2748       end.
     2749       else do:
     2750           assign
     2751             l-query-was-opened = true
     2752           .
     2753       end.
     2754     end.
     2755     if l-filter-open-27 = false then do:
     2756       OPEN QUERY CLi-ListB FOR EACH X_clients no-lock
     2757         where  X_clients.grp-name begins Curr-Grp-Name                             AND X_clients.stts = 0
     2758       , first x_temp-list-buyer NO-LOCK WHERE (v-list-b = NO OR (x_temp-list-buyer.obj-type =   X_clients.obj-type AND              x_temp-list-buyer.obj-code =   X_clients.obj-code))
     2759          BY X_clients.obj-name
     2760         indexed-reposition
     2761     .
     2762         assign
     2763           l-query-was-opened = true
     2764         .
     2765     end.
     2766   end.
     2767   else do:
     2768     assign
     2769       v-doc-rec = recid( ub.clients )
     2770     .
     2771     do
     2772     on stop undo, leave
     2773     on error undo, leave
     2774     :
     2775       if query cli-listB:handle:get-buffer-handle(1) = (buffer X_clients:handle) then do:
     2776         assign
     2777         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     2778         parameter-4-27 =
     2779           "where ":u +  substitute('X_clients.grp-name begins &1&2&1                             AND X_clients.stts = 0 ', chr(34), Curr-Grp-Name) + " ":u + where-phrase-27 + " ":u + p-find-condition + " " + ""
     2780         parameter-5-27 = "  "
     2781       .
     2782         run fltopend_fltfindd in this-procedure  (
     2783                             input this-procedure:handle
     2784                             ,input query cli-listB:handle
     2785                             ,input rowid(ub.clients)
     2786                             ,input logical(parameter-2-27)
     2787                             ,input no-lock
     2788                             ,input (buffer ub.clients:handle)
     2789                             ,input parameter-4-27
     2790                             ,input parameter-5-27
     2791                             ) no-error.
     2792         .
     2793         assign
     2794           v-doc-rec = integer(return-value)
     2795           v-fltopend-rowid[1] = ?
     2796         .
     2797       end.
     2798       else do:
     2799         assign
     2800         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     2801         parameter-3-27 =  "FOR EACH X_clients"
     2802         parameter-4-27 =
     2803           (
     2804             if (" X_clients.grp-name begins Curr-Grp-Name                             AND X_clients.stts = 0 " + " " + where-phrase-27) <> ""
     2805             then  substitute('X_clients.grp-name begins &1&2&1                             AND X_clients.stts = 0 ', chr(34), Curr-Grp-Name) + " " + where-phrase-27
     2806             else "true"
     2807           )
     2808         parameter-5-27 = (" " + "" + " " + substitute(', first x_temp-list-buyer NO-LOCK WHERE (&1 = NO OR (x_temp-list-buyer.obj-type =   X_clients.obj-type AND              x_temp-list-buyer.obj-code =   X_clients.obj-code))'                                              ,v-list-b) + " " + p-find-condition)
     2809         parameter-6-27 = if sort-phrase-27 = ''
     2810                              then
     2811           (
     2812           " " + "  " +
     2813             " " + sort-column-phrase +
     2814           " " + " BY X_clients.obj-name  "
     2815           )
     2816                              else
     2817           (
     2818           " " + "  " +
     2819             " " + sort-column-phrase +
     2820           " " + sort-phrase-27
     2821           )
     2822         parameter-7-27 =
     2823           " indexed-reposition  "
     2824       .
     2825         run fltopend_fltfindq in this-procedure  (
     2826                             input this-procedure:handle
     2827                             ,input query cli-listB:handle
     2828                             ,input logical(parameter-2-27)
     2829                             ,input no-lock
     2830                             ,input parameter-3-27
     2831                             ,input parameter-4-27
     2832                             ,input parameter-5-27
     2833                             ,input parameter-6-27
     2834                             ,input parameter-7-27
     2835                             ,output v-fltopend-rowid
     2836                             ) no-error.
     2837         .
     2838         v-doc-rec = ?.
     2839       end.
     2840       assign
     2841         l-query-was-opened = true
     2842       .
     2843     end.
     2844   end.
     2845     run waitfram-hide in this-procedure .
     2846         end.
     2847       END CASE .
     2848     end.
     2849   END CASE.
     2850     end.
     2851   end procedure.
