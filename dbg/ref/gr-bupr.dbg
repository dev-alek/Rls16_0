      116   define new global shared variable g#library  as handle no-undo .
      117   define new global shared variable g#library2 as handle no-undo .
      118   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      119     define variable v-cntxt-db-num        as integer   no-undo .
      120     define variable v-cntxt-userid        as character no-undo .
      121     define variable v-cntxt-level         as character no-undo .
      122     define variable v-cntxt-host-code-obj as integer   no-undo .
      123     define variable v-cntxt-obj-type      as character no-undo .
      124     define variable v-cntxt-obj-code      as integer   no-undo .
      125     define variable v-cntxt-db-num-obj    as integer   no-undo .
      126     define variable v-cntxt-is-admin      as logical   no-undo .
      127   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      128     run mainmenu_getcntxt in parparentproc
      129       (output v-cntxt-db-num
      130       ,output v-cntxt-userid
      131       ,output v-cntxt-level
      132       ,output v-cntxt-host-code-obj
      133       ,output v-cntxt-obj-type
      134       ,output v-cntxt-obj-code
      135       ,output v-cntxt-db-num-obj
      136       ,output v-cntxt-is-admin
      137       ) .
      138   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      139   define variable v-waitfram-action01         as character   no-undo .
      140   define variable v-waitfram-action02         as character   no-undo .
      141   define variable v-waitfram-action03         as character   no-undo .
      142   define variable mWaitFramTextBeg            as character   no-undo.
      143   define variable mWaitFramTextEnd            as character   no-undo.
      144   define variable mWaitFramView               as logical     no-undo.
      145   define variable mWaitProcEvent              as logical     no-undo init yes.
      146   define variable mWaitFramInterval           as integer     no-undo init 1 .
      147   define variable mWaitFramStop               as logical     no-undo.
      148   define variable mWaitFramStopUser           as logical     no-undo.
      149   define variable mWaitFramStopTimeOut        as logical     no-undo.
      150   define variable mWaitFramStartProc          as datetime-tz no-undo.
      151   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      152   define button B-WaitFramStop auto-end-key
      153        label "Стоп"
      154        size 10 by 1 tooltip "Остоновить процесс".
      155   define button B-viewProcInfo
      156        label "Информация"
      157        size 15 by 1 tooltip "Информация о процесс".
      158   define frame waitfram
      159     v-waitfram-action01 format "x(72)" no-label skip
      160     v-waitfram-action02 format "x(72)" no-label skip
      161     v-waitfram-action03 format "x(72)" no-label skip
      162     B-viewProcInfo
      163     B-WaitFramStop at row 4 col 30
      164     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      165     .
      166   define new global shared variable mBatchMode as logical no-undo init ?.
      167   define variable mFramBachModHandle as handle no-undo.
      168   mFramBachModHandle = frame waitfram:handle.
      169   define variable mFameOldVis as logical no-undo.
      170   define variable mVisCUrentVin as logical no-undo.
      171   if session:batch-mode
      172   then
      173      mBatchMode = yes.
      174   if mBatchMode = ? then do:
      175     mVisCUrentVin = current-window:visible.
      176     mFameOldVis = mFramBachModHandle:visible.
      177     mFramBachModHandle:visible  = yes.
      178     mBatchMode = mFramBachModHandle:visible ne yes.
      179     mFramBachModHandle:visible = mFameOldVis.
      180     current-window:visible = mVisCUrentVin.
      181   end.
      182    if  log-manager:logfile-name ne ?
      183     then DO:
      184         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      185         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      186         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      187     end.
      188   on choose of B-WaitFramStop in frame waitfram
      189   do:
      190     mWaitFramStop = yes.
      191     mWaitFramStopUser = yes.
      192   end.
      193   function waitfram-check-timeout returns logical():
      194      define variable vtime as int64 no-undo.
      195      if mWaitFramStopTimeOut
      196      then
      197         return yes.
      198      vtime = ( now - mWaitFramStartProc ) / 1000 .
      199      if     mWaitFramTimeOut ne ?
      200         and mWaitFramTimeOut ne 0
      201         and mWaitFramTimeOut lt vtime
      202      then do:
      203         mWaitFramStopTimeOut = yes.
      204      end.
      205      return mWaitFramStopTimeOut.
      206   end.
      207   procedure waitfram-hide :
      208     if not session:batch-mode
      209     then do
      210     on error undo, return error return-value
      211     :
      212       pause 0 before-hide .
      213       if not mBatchMode then
      214         hide frame waitfram .
      215     if     not mWaitFramView
      216        and mWaitProcEvent
      217     then
      218       process events .
      219     end.
      220   end procedure.
      221   procedure waitfram-show :
      222     define input  parameter p-message as character no-undo .
      223     define variable v-left-margin as integer   no-undo .
      224     if not session:batch-mode
      225     then do
      226     on error undo, return error return-value
      227     :
      228       if length(p-message) <= 70 then do:
      229         assign
      230           v-left-margin = integer((70 - length(p-message)) / 2)
      231         .
      232         assign
      233           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      234         .
      235         assign
      236           v-waitfram-action01 = " "
      237           v-waitfram-action02 = " "
      238                                    + fill(" ", v-left-margin)
      239                                    + p-message
      240           v-waitfram-action03 = " "
      241         .
      242       end.
      243       else do:
      244         define variable vRindex1 as integer no-undo.
      245         define variable vRindex2 as integer no-undo.
      246         vRindex1 = r-index(p-message," ",70).
      247         if vRindex1 = 0
      248         then
      249            vRindex1 = 70.
      250         if length(p-message)  <= vRindex1 + 70 then do:
      251           assign
      252             v-waitfram-action01 = " "
      253             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      254             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      255           .
      256         end.
      257         else do:
      258           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      259           if vRindex2 <= vRindex1
      260           then
      261              vRindex2 = vRindex1 + 70.
      262           assign
      263             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      264             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      265             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      266           .
      267         end.
      268       end.
      269       B-viewProcInfo:visible   in frame waitfram = no.
      270       B-viewProcInfo:sensitive in frame waitfram = no.
      271       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      272       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      273       if  (   mWaitFramView
      274          or  mWaitProcEvent)
      275          and not mBatchMode
      276       then
      277          display
      278             v-waitfram-action01 skip
      279             v-waitfram-action02 skip
      280             v-waitfram-action03 skip
      281          with frame waitfram .
      282       if     mWaitFramView
      283          then do:
      284             if     mWaitFramInterval ne ?
      285                and not mBatchMode
      286             then
      287                wait-for go of frame waitfram pause mWaitFramInterval.
      288          end.
      289          else
      290             if     mWaitProcEvent
      291                and not mBatchMode
      292             then
      293                process events .
      294     end.
      295   end procedure.
      296      procedure waitfram-show-this:
      297         define input  parameter iInterval as int64 no-undo.
      298         define variable vtime as int64 no-undo.
      299         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      300         mWaitFramInterval = iInterval.
      301         run waitfram-show (substitute("&1&2 &3&4" ,
      302                                       mWaitFramTextBeg ,
      303                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      304                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      305                                       mWaitFramTextEnd
      306                                      )
      307                           ).
      308      end.
      309      procedure WaitFramRunPause:
      310         define input  parameter iInterval as dec no-undo.
      311         define variable vStart  as datetime-tz no-undo.
      312         define variable vend    as datetime-tz no-undo.
      313         define variable vint as int64 no-undo.
      314         define variable vOk as logical no-undo.
      315         vStart = now.
      316         vend   = vStart.
      317         publish "WaitFramPause" (iInterval,output vOk).
      318         vend   =  now.
      319         vint = vend - vStart.
      320         vint = iInterval - vint / 1000.
      321         if     not mWaitFramStop
      322            and (   vint > 0
      323                 or (    not vOk
      324                     and iInterval eq ?
      325                     )
      326                 )
      327         then
      328            run waitfram-show-this (iInterval).
      329         vend   =  now.
      330         vint = vend - vStart.
      331         vint = iInterval - vint / 1000.
      332         if     not mWaitFramStop
      333            and vint > 0
      334         then do:
      335            run gbl/pause.p (vint * 1000).
      336         end.
      337         if iInterval ne ?
      338         then
      339            publish "WaitFramStop".
      340         waitfram-check-timeout().
      341      end.
      342      procedure WaitFramWaitFor:
      343         define input  parameter iInterval as dec no-undo.
      344         assign
      345            mWaitFramStartProc   = now
      346            mWaitFramStopUser    = no
      347            mWaitFramStopTimeOut = no
      348         .
      349         block-wait:
      350         do while not mWaitFramStop:
      351            run WaitFramRunPause (iInterval).
      352            if  waitfram-check-timeout()
      353            then do:
      354               leave block-wait.
      355            end.
      356         end.
      357         run waitfram-hide.
      358      end.
      359   procedure waitfram-join :
      360     define input  parameter p-line-1  as character no-undo .
      361     define input  parameter p-line-2  as character no-undo .
      362     define input  parameter p-line-3  as character no-undo .
      363     define output parameter p-message as character no-undo .
      364     do
      365     on error undo, return error return-value
      366     :
      367       assign
      368         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      369                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      370                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      371       .
      372     end.
      373   end procedure.
      374   function waitfram-join-function returns character
      375     (input p-line-1 as character
      376     ,input p-line-2 as character
      377     ,input p-line-3 as character
      378     ).
      379     define variable v-message as character no-undo .
      380     run waitfram-join in this-procedure
      381       (input  p-line-1
      382       ,input  p-line-2
      383       ,input  p-line-3
      384       ,output v-message
      385       ) .
      386     return v-message .
      387   end function .
      388   PROCEDURE BIB-ADD :
      389   define input  parameter p-db-num       as integer   no-undo .
      390   define input  parameter p-id           as integer   no-undo .
      391   define input  parameter p-obj-code     as integer   no-undo .
      392   define input  parameter p-obj-type     as character no-undo .
      393   define input  parameter p-stts         as integer   no-undo .
      394   define input  parameter p-db-num-usr   as integer   no-undo .
      395   define input  parameter p-userid       as character no-undo .
      396   define input-output parameter v-sec as integer   no-undo .
      397     do
      398     on error undo, return error return-value
      399     :
      400   if v-cntxt-db-num <> 0 then do :
      401      if p-db-num <> v-cntxt-db-num then do:
      402         message substitute(" Группа создана в другой БД (&1) , корректировать ее в текущей БД нельзя !" , p-db-num ) .
      403         return error substitute(" Группа создана в другой БД (&1) , корректировать ее нельзя !" , p-db-num).
      404      end.
      405   end.
      406   find first ub.buyer-in-buyer-group exclusive-lock where
      407           ub.buyer-in-buyer-group.bgr-db-num   = p-db-num  and
      408           ub.buyer-in-buyer-group.bgr-id       = p-id      and
      409           ub.buyer-in-buyer-group.bbg-obj-code = p-obj-code and
      410           ub.buyer-in-buyer-group.bbg-obj-type = p-obj-type no-error .
      411         if not available ub.buyer-in-buyer-group then do:
      412             create ub.buyer-in-buyer-group.
      413               assign
      414                   ub.buyer-in-buyer-group.bgr-db-num  = p-db-num
      415                   ub.buyer-in-buyer-group.bgr-id      = p-id
      416                   ub.buyer-in-buyer-group.bbg-obj-code = p-obj-code
      417                   ub.buyer-in-buyer-group.bbg-obj-type = p-obj-type
      418               .
      419         end.
      420         assign
      421           ub.buyer-in-buyer-group.db-num-chg    = p-db-num-usr
      422           ub.buyer-in-buyer-group.stts          = p-stts
      423           ub.buyer-in-buyer-group.sys-date      = today
      424           ub.buyer-in-buyer-group.sys-time      = time
      425           ub.buyer-in-buyer-group.sys-time-chr  = string(ub.buyer-in-buyer-group.sys-time,"hh:mm")
      426           ub.buyer-in-buyer-group.who           = p-userid
      427         .
      428         run ref/h-grbuy.p (buffer ub.buyer-in-buyer-group , input-output v-sec )  .
      429     end.
      430   end procedure.
      431   PROCEDURE BIB-DEL :
      432   define input  parameter p-db-num       as integer   no-undo .
      433   define input  parameter p-id           as integer   no-undo .
      434   define input  parameter p-obj-code     as integer   no-undo .
      435   define input  parameter p-obj-type     as character no-undo .
      436   define input  parameter p-db-num-usr   as integer   no-undo .
      437   define input  parameter p-userid       as character no-undo .
      438   define input-output parameter v-sec as integer   no-undo .
      439     do
      440     on error undo, return error return-value
      441     :
      442   if v-cntxt-db-num <> 0 then do :
      443      if p-db-num <> v-cntxt-db-num then do:
      444         message substitute(" Группа создана в другой БД (&1) , удалять покупателей в текущей БД нельзя !" , p-db-num ) .
      445         return error substitute(" Группа создана в другой БД (&1) , удалять покупателей нельзя !" , p-db-num).
      446      end.
      447   end.
      448   find first ub.buyer-in-buyer-group exclusive-lock where
      449           ub.buyer-in-buyer-group.bgr-db-num   = p-db-num  and
      450           ub.buyer-in-buyer-group.bgr-id       = p-id      and
      451           ub.buyer-in-buyer-group.bbg-obj-code = p-obj-code and
      452           ub.buyer-in-buyer-group.bbg-obj-type = p-obj-type no-error .
      453    if not available ub.buyer-in-buyer-group then  return error .
      454         assign
      455           ub.buyer-in-buyer-group.db-num-chg    = p-db-num-usr
      456           ub.buyer-in-buyer-group.stts          = 1
      457           ub.buyer-in-buyer-group.sys-date      = today
      458           ub.buyer-in-buyer-group.sys-time      = time
      459           ub.buyer-in-buyer-group.sys-time-chr  = string(ub.buyer-in-buyer-group.sys-time,"hh:mm")
      460           ub.buyer-in-buyer-group.who           = p-userid
      461         .
      462     run ref/h-grbuy.p (buffer ub.buyer-in-buyer-group , input-output v-sec )  .
      463     end.
      464   end procedure.
      465   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      466   function usrfulnf returns character ( input p-user-id as character):
      467   define variable v-user-name as character no-undo .
      468   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      469   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      470     (input  p-user-id
      471     ,output v-user-name
      472     ) no-error .
      473   if error-status:error
      474   or v-user-name = ""
      475   then do:
      476     return p-user-id.
      477   end.
      478   else do:
      479     return v-user-name.
      480   end.
      481   end function.
