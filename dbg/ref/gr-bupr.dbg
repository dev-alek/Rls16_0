      491   define variable find-db as integer   no-undo .
      492   function mark-string returns character
      493     ( buffer loc-table for ub.buyer-group, input mark-list as character  ) :
      494     return ( if lookup( string( recid( loc-table ) ), mark-list ) > 0 then "*" else "":U ).
      495   end function.
      496   function mark-string-2 returns character
      497     ( buffer loc-table for ub.buyer-in-buyer-group , input mark-list as character  ) :
      498     return ( if lookup( string( recid( loc-table ) ), mark-list ) > 0 then "*" else "":U ).
      499   end function.
      500   function stts-string-2 returns character
      501     ( buffer loc-table for ub.buyer-in-buyer-group   ) :
      502   return entry (lookup (string(loc-table.stts), '0,1,50,99':U), 'тек,удал,блок,удаление':U) .
      503   end function.
      504   function stts-string returns character
      505     ( buffer loc-table for ub.buyer-group   ) :
      506   return entry (lookup (string(loc-table.stts), '0,1,50,99':U), 'тек,удал,блок,удаление':U) .
      507   end function.
      508   DEFINE QUERY external_tables FOR buf_buyer-group.
      509   DEFINE BUTTON B-add
      510        LABEL "Добавить"
      511        SIZE 10 BY 1 TOOLTIP "Добавить группу"
      512        BGCOLOR 8 .
      513   DEFINE BUTTON B-add-2
      514        LABEL "Добавить"
      515        SIZE 10 BY 1 TOOLTIP "Добавить покупателя"
      516        BGCOLOR 8 .
      517   DEFINE BUTTON B-all
      518        IMAGE-UP FILE "cmp/cancel.bmp":U
      519        LABEL "все"
      520        SIZE 3 BY 1 TOOLTIP "Показать все"
      521        FONT 4.
      522   DEFINE BUTTON B-Cancel AUTO-END-KEY
      523        LABEL "Выход"
      524        SIZE 10 BY 1
      525        BGCOLOR 8 .
      526   DEFINE BUTTON B-chg
      527        LABEL "Изменить"
      528        SIZE 10 BY 1 TOOLTIP "Изменить группу"
      529        BGCOLOR 8 .
      530   DEFINE BUTTON B-del
      531        LABEL "Удалить"
      532        SIZE 10 BY 1 TOOLTIP "Удалить группу"
      533        BGCOLOR 8 .
      534   DEFINE BUTTON B-del-2
      535        LABEL "Удалить"
      536        SIZE 10 BY 1 TOOLTIP "Удалить покупателя"
      537        BGCOLOR 8 .
      538   DEFINE BUTTON B-find-obj
      539        IMAGE-UP FILE "cmp/select.bmp":U
      540        LABEL ""
      541        SIZE 3 BY 1 TOOLTIP "Поиск по Покупателю".
      542   DEFINE BUTTON B-Help
      543        LABEL "Помо&щь"
      544        SIZE 10 BY 1
      545        BGCOLOR 8 .
      546   DEFINE BUTTON B-history
      547        LABEL "История"
      548        SIZE 10 BY 1 TOOLTIP "История изменения справочника"
      549        BGCOLOR 8 .
      550   DEFINE BUTTON B-mark
      551        LABEL "*"
      552        SIZE 3.25 BY 1 TOOLTIP "Отметить группу"
      553        BGCOLOR 8 .
      554   DEFINE BUTTON B-mark-2
      555        LABEL "*"
      556        SIZE 3.25 BY 1 TOOLTIP "Отметить покупателя"
      557        BGCOLOR 8 .
      558   DEFINE BUTTON B-price-type
      559        LABEL "&ТПЛ"
      560        SIZE 6 BY 1 TOOLTIP "Список типов ПЛ по группе покупателей".
      561   DEFINE BUTTON B-print
      562        LABEL "Печать"
      563        SIZE 10 BY 1 TOOLTIP "Печать справочника"
      564        BGCOLOR 8 .
      565   DEFINE BUTTON B-sel AUTO-GO
      566        LABEL "Выбор"
      567        SIZE 10 BY 1
      568        BGCOLOR 8 .
      569   DEFINE VARIABLE F-obj AS CHARACTER FORMAT "X(256)":U
      570         VIEW-AS TEXT
      571        SIZE 14 BY .54
      572        FGCOLOR 1 FONT 4 NO-UNDO.
      573   DEFINE VARIABLE FILL-IN-1 AS CHARACTER FORMAT "X(256)":U INITIAL "Статус:"
      574         VIEW-AS TEXT
      575        SIZE 7.5 BY .67
      576        FGCOLOR 4  NO-UNDO.
      577   DEFINE VARIABLE R-status AS INTEGER
      578        VIEW-AS RADIO-SET HORIZONTAL
      579        RADIO-BUTTONS
      580             "Текущие", 0,
      581   "Все", 2,
      582   "Удаленные", 1
      583        SIZE 30.5 BY .67 TOOLTIP "Условие отбора записей" NO-UNDO.
      584   DEFINE QUERY BROWSE-1grp FOR
      585         buf_buyer-group SCROLLING.
      586   DEFINE QUERY BROWSE-2cli FOR
      587         buf_buyer-in-buyer-group,
      588         buf_clients SCROLLING.
      589   DEFINE BROWSE BROWSE-1grp
      590     QUERY BROWSE-1grp NO-LOCK DISPLAY
      591         mark-string(buffer buf_buyer-group, p-rec-list) COLUMN-LABEL "*! " FORMAT "x(1)":U
      592         stts-string(buffer buf_buyer-group) COLUMN-LABEL "Ста!тус" FORMAT "x(3)":U
      593         buf_buyer-group.name COLUMN-LABEL "Название группы!покупателей" FORMAT "X(80)":U
      594         buf_buyer-group.oborot   COLUMN-LABEL   "Оборот перехода!в другую группу" FORMAT "->>>,>>>,>>>,>>9.99":U
      595         IF buf_buyer-group.gop-id > 0 THEN String(buf_buyer-group.gop-id) + "(" + string(buf_buyer-group.gop-db-num) + ")" ELSE "" COLUMN-LABEL "Переходит!в группу" FORMAT "x(13)":U
      596         String(buf_buyer-group.bgr-id) + "(" + string(buf_buyer-group.bgr-db-num) + ")" COLUMN-LABEL "Код группы" FORMAT "x(10)":U
      597         buf_buyer-group.sys-date COLUMN-LABEL "Дата!изменения" FORMAT "99/99/99":U
      598         buf_buyer-group.sys-time-chr COLUMN-LABEL "Время!изменения" FORMAT "X(5)":U
      599         usrfulnf(buf_buyer-group.who) COLUMN-LABEL "Кто!изменял" FORMAT "X(15)":U
      600         buf_buyer-group.db-num-chg COLUMN-LABEL "БД!изм" FORMAT ">>>>9":U
      601       WITH NO-ROW-MARKERS SEPARATORS SIZE 48.13 BY 19
      602            TITLE "Группы покупателей" FIT-LAST-COLUMN.
      603   DEFINE BROWSE BROWSE-2cli
      604     QUERY BROWSE-2cli NO-LOCK DISPLAY
      605         mark-string-2(buffer buf_buyer-in-buyer-group, v-rec-list-cli) COLUMN-LABEL "*! " FORMAT "x(1)":U
      606         stts-string-2(buffer buf_buyer-in-buyer-group) COLUMN-LABEL "Ста!тус" FORMAT "x(3)":U
      607         buf_buyer-in-buyer-group.bbg-obj-code COLUMN-LABEL "Код" FORMAT ">>>>>>>>9":U
      608         buf_buyer-in-buyer-group.bbg-obj-type COLUMN-LABEL "Тип" FORMAT "X(3)":U
      609         buf_clients.obj-name COLUMN-LABEL "Наименование " FORMAT "X(40)":U  WIDTH 20
      610         buf_buyer-in-buyer-group.sys-date COLUMN-LABEL "Дата!изменения" FORMAT "99/99/99":U
      611         buf_buyer-in-buyer-group.sys-time-chr COLUMN-LABEL "Время!изм" FORMAT "X(5)":U
      612         usrfulnf(buf_buyer-in-buyer-group.who) COLUMN-LABEL "Кто!изменял" FORMAT "X(15)":U
      613         buf_buyer-in-buyer-group.db-num-chg COLUMN-LABEL "БД!изм" FORMAT ">>>>9":U
      614         buf_clients.grp-name COLUMN-LABEL "Название группы клиентов" FORMAT "X(40)":U
      615       WITH NO-ROW-MARKERS SEPARATORS SIZE 50.5 BY 19
      616            TITLE "Покупатели в группе" FIT-LAST-COLUMN.
      617   DEFINE FRAME Dialog-Frame
      618        B-Cancel AT ROW 1 COL 1
      619        B-sel AT ROW 1 COL 11
      620        B-add AT ROW 1 COL 21
      621        B-chg AT ROW 1 COL 31 WIDGET-ID 2
      622        B-del AT ROW 1 COL 41
      623        B-price-type AT ROW 1 COL 51
      624        B-history AT ROW 1 COL 69.75
      625        B-print AT ROW 1 COL 79.75
      626        B-Help AT ROW 1 COL 90
      627        R-status AT ROW 2.29 COL 9.63 NO-LABEL
      628        B-mark-2 AT ROW 2.92 COL 49.75
      629        B-add-2 AT ROW 2.92 COL 53
      630        B-del-2 AT ROW 2.92 COL 63
      631        B-mark AT ROW 3 COL 1.75
      632        B-find-obj AT ROW 3.04 COL 5.13
      633        B-all AT ROW 3.04 COL 8.25
      634        BROWSE-1grp AT ROW 4 COL 1.38
      635        BROWSE-2cli AT ROW 4 COL 49.5
      636        FILL-IN-1 AT ROW 2.25 COL 2 NO-LABEL
      637        F-obj AT ROW 3.29 COL 9.5 COLON-ALIGNED NO-LABEL
      638        SPACE(74.88) SKIP(19.30)
      639       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      640            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      641            TITLE "Группы покупателей для ценообразования"
      642            DEFAULT-BUTTON B-sel CANCEL-BUTTON B-Cancel.
      643   ASSIGN
      644          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      645          FRAME Dialog-Frame:HIDDEN           = TRUE.
      646   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      647   DO:
      648     APPLY "END-ERROR":U TO SELF.
      649   END.
      650   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      651   DO:
      652      define variable g#log as logical   no-undo .
      653   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      654   do:
      655     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      656       (input  v-cntxt-db-num
      657       ,input  v-cntxt-userid
      658       ,input  0
      659       ,input  'actn_ref-mpl_update':U
      660       ,input  'global':U
      661       ,input  v-cntxt-host-code-obj
      662       ,input  v-cntxt-obj-type
      663       ,input  v-cntxt-obj-code
      664       ,input  0
      665       ,input  0
      666       ,input  0
      667       ,input  true
      668       ,output g#log
      669       )  .
      670   end.
      671     if not g#log then return .
      672   define variable v-rec-id as recid no-undo .
      673     run ref/gr-bupra.w (input parparentproc,input 'ДОБАВЛЕНИЕ':U , input-output v-rec-id) .
      674     OPEN QUERY BROWSE-1grp FOR EACH buf_buyer-group WHERE     ( r-status = 2 OR buf_buyer-group.stts =  r-status )      AND    ( g-find = NO OR      LOOKUP (STRING (buf_buyer-group.bgr-id) + ";"  + string(buf_buyer-group.bgr-db-num)  ,        tt-buyer-group ) > 0 )      and      ( r-find = no or (buf_buyer-group.bgr-db-num = find-db and      buf_buyer-group.bgr-id = find-id ))       BY buf_buyer-group.oborot BY buf_buyer-group.NAME .
      675     reposition BROWSE-1grp to recid v-rec-id no-error .
      676     apply "VALUE-CHANGED" to browse-1grp in frame Dialog-Frame.
      677   END.
      678   ON CHOOSE OF B-add-2 IN FRAME Dialog-Frame
      679   DO:
      680      define variable g#log as logical   no-undo .
      681   define variable vss-include-info6 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      682   do:
      683     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      684       (input  v-cntxt-db-num
      685       ,input  v-cntxt-userid
      686       ,input  0
      687       ,input  'actn_ref-mpl_update':U
      688       ,input  'global':U
      689       ,input  v-cntxt-host-code-obj
      690       ,input  v-cntxt-obj-type
      691       ,input  v-cntxt-obj-code
      692       ,input  0
      693       ,input  0
      694       ,input  0
      695       ,input  true
      696       ,output g#log
      697       )  .
      698   end.
      699     if not g#log then return .
      700   define variable v-rec-id as recid no-undo .
      701   if not available buf_buyer-group then return .
      702   if buf_buyer-group.stts <> 0 then do:
      703      message "В эту группу добавлять покупателей нельзя!" view-as alert-box error .
      704      return .
      705   end.
      706   if v-cntxt-db-num <> 0 then do :
      707      if buf_buyer-group.bgr-db-num <> v-cntxt-db-num then do:
      708         message substitute(" Группа создана в другой БД (&1) , корректировать ее в текущей БД нельзя !" , buf_buyer-group.bgr-db-num ) .
      709         return .
      710      end.
      711   end.
      712     run ref/gr-buprb.p (
      713         input parparentproc ,
      714         input buf_buyer-group.bgr-db-num ,
      715         input buf_buyer-group.bgr-id      ,
      716         output v-rec-id) .
      717     OPEN QUERY BROWSE-2cli FOR EACH buf_buyer-in-buyer-group OF buf_buyer-group      WHERE ( r-status = 2 OR buf_buyer-in-buyer-group.stts =  r-status )       NO-LOCK ,              EACH buf_clients WHERE buf_clients.obj-code = buf_buyer-in-buyer-group.bbg-obj-code                          AND buf_clients.obj-type = buf_buyer-in-buyer-group.bbg-obj-type                              NO-LOCK INDEXED-REPOSITION.
      718     reposition BROWSE-2cli to recid v-rec-id no-error .
      719     END.
      720   ON CHOOSE OF B-all IN FRAME Dialog-Frame
      721   DO:
      722     g-find = false .
      723     F-obj = " "  .
      724     display F-obj  with frame Dialog-Frame .
      725     OPEN QUERY BROWSE-1grp FOR EACH buf_buyer-group WHERE     ( r-status = 2 OR buf_buyer-group.stts =  r-status )      AND    ( g-find = NO OR      LOOKUP (STRING (buf_buyer-group.bgr-id) + ";"  + string(buf_buyer-group.bgr-db-num)  ,        tt-buyer-group ) > 0 )      and      ( r-find = no or (buf_buyer-group.bgr-db-num = find-db and      buf_buyer-group.bgr-id = find-id ))       BY buf_buyer-group.oborot BY buf_buyer-group.NAME .
      726     OPEN QUERY BROWSE-2cli FOR EACH buf_buyer-in-buyer-group OF buf_buyer-group      WHERE ( r-status = 2 OR buf_buyer-in-buyer-group.stts =  r-status )       NO-LOCK ,              EACH buf_clients WHERE buf_clients.obj-code = buf_buyer-in-buyer-group.bbg-obj-code                          AND buf_clients.obj-type = buf_buyer-in-buyer-group.bbg-obj-type                              NO-LOCK INDEXED-REPOSITION.
      727   END.
      728   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
      729   DO:
      730      define variable g#log as logical   no-undo .
      731   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      732   do:
      733     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      734       (input  v-cntxt-db-num
      735       ,input  v-cntxt-userid
      736       ,input  0
      737       ,input  'actn_ref-mpl_update':U
      738       ,input  'global':U
      739       ,input  v-cntxt-host-code-obj
      740       ,input  v-cntxt-obj-type
      741       ,input  v-cntxt-obj-code
      742       ,input  0
      743       ,input  0
      744       ,input  0
      745       ,input  true
      746       ,output g#log
      747       )  .
      748   end.
      749     if not g#log then return .
      750   IF NOT AVAILABLE buf_buyer-group THEN RETURN.
      751     if buf_buyer-group.stts <> 0 then do:
      752        message "Группа удалена!" view-as alert-box information .
      753        return.
      754     end.
      755   if v-cntxt-db-num <> 0 then do :
      756      if buf_buyer-group.bgr-db-num <> v-cntxt-db-num then do:
      757         message substitute(" Группа создана в другой БД (&1) , корректировать ее в текущей БД нельзя !" , buf_buyer-group.bgr-db-num ) .
      758         return .
      759      end.
      760   end.
      761   define variable v-rec-id as recid no-undo .
      762   v-rec-id = RECID( buf_buyer-group ).
      763     run ref/gr-bupra.w (input parparentproc,input 'ИЗМЕНЕНИЕ':U , input-output v-rec-id) .
      764     OPEN QUERY BROWSE-1grp FOR EACH buf_buyer-group WHERE     ( r-status = 2 OR buf_buyer-group.stts =  r-status )      AND    ( g-find = NO OR      LOOKUP (STRING (buf_buyer-group.bgr-id) + ";"  + string(buf_buyer-group.bgr-db-num)  ,        tt-buyer-group ) > 0 )      and      ( r-find = no or (buf_buyer-group.bgr-db-num = find-db and      buf_buyer-group.bgr-id = find-id ))       BY buf_buyer-group.oborot BY buf_buyer-group.NAME .
      765     reposition BROWSE-1grp to recid v-rec-id no-error .
      766     apply "VALUE-CHANGED" to browse-1grp in frame Dialog-Frame.
      767   END.
      768   ON CHOOSE OF B-del IN FRAME Dialog-Frame
      769   DO:
      770      define variable g#log as logical   no-undo .
      771   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      772   do:
      773     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      774       (input  v-cntxt-db-num
      775       ,input  v-cntxt-userid
      776       ,input  0
      777       ,input  'actn_ref-mpl_update':U
      778       ,input  'global':U
      779       ,input  v-cntxt-host-code-obj
      780       ,input  v-cntxt-obj-type
      781       ,input  v-cntxt-obj-code
      782       ,input  0
      783       ,input  0
      784       ,input  0
      785       ,input  true
      786       ,output g#log
      787       )  .
      788   end.
      789     if not g#log then return .
      790     if not available buf_buyer-group then return .
      791     if buf_buyer-group.stts <> 0 then do:
      792        message "Группа уже удалена" view-as alert-box information .
      793        return.
      794     end.
      795     message "Удалять группу " buf_buyer-group.name "?"
      796             view-as alert-box question
      797             buttons yes-no update g-ok as log.
      798     if not g-ok then return .
      799     run ref/gr-budel.p (
      800         input parparentproc ,
      801         input buf_buyer-group.bgr-db-num ,
      802         input buf_buyer-group.bgr-id      )
      803         no-error .
      804    if error-status :error then return no-apply .
      805    OPEN QUERY BROWSE-1grp FOR EACH buf_buyer-group WHERE     ( r-status = 2 OR buf_buyer-group.stts =  r-status )      AND    ( g-find = NO OR      LOOKUP (STRING (buf_buyer-group.bgr-id) + ";"  + string(buf_buyer-group.bgr-db-num)  ,        tt-buyer-group ) > 0 )      and      ( r-find = no or (buf_buyer-group.bgr-db-num = find-db and      buf_buyer-group.bgr-id = find-id ))       BY buf_buyer-group.oborot BY buf_buyer-group.NAME .
      806    OPEN QUERY BROWSE-2cli FOR EACH buf_buyer-in-buyer-group OF buf_buyer-group      WHERE ( r-status = 2 OR buf_buyer-in-buyer-group.stts =  r-status )       NO-LOCK ,              EACH buf_clients WHERE buf_clients.obj-code = buf_buyer-in-buyer-group.bbg-obj-code                          AND buf_clients.obj-type = buf_buyer-in-buyer-group.bbg-obj-type                              NO-LOCK INDEXED-REPOSITION.
      807   END.
      808   ON CHOOSE OF B-del-2 IN FRAME Dialog-Frame
      809   DO:
      810      define variable g#log as logical   no-undo .
      811   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      812   do:
      813     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      814       (input  v-cntxt-db-num
      815       ,input  v-cntxt-userid
      816       ,input  0
      817       ,input  'actn_ref-mpl_update':U
      818       ,input  'global':U
      819       ,input  v-cntxt-host-code-obj
      820       ,input  v-cntxt-obj-type
      821       ,input  v-cntxt-obj-code
      822       ,input  0
      823       ,input  0
      824       ,input  0
      825       ,input  true
      826       ,output g#log
      827       )  .
      828   end.
      829     if not g#log then return .
      830     if not available buf_buyer-in-buyer-group then return .
      831     if buf_buyer-in-buyer-group.stts <> 0 then do:
      832        message "Покупатель уже исключен из Группы" view-as alert-box information .
      833        return.
      834     end.
      835     run bib-del (
      836        input   buf_buyer-in-buyer-group.bgr-db-num
      837       ,input   buf_buyer-in-buyer-group.bgr-id
      838       ,input   buf_buyer-in-buyer-group.bbg-obj-code
      839       ,input   buf_buyer-in-buyer-group.bbg-obj-type
      840       ,input   v-cntxt-db-num
      841       ,input   v-cntxt-userid
      842       ,input-output   v-sec
      843       ) .
      844     OPEN QUERY BROWSE-2cli FOR EACH buf_buyer-in-buyer-group OF buf_buyer-group      WHERE ( r-status = 2 OR buf_buyer-in-buyer-group.stts =  r-status )       NO-LOCK ,              EACH buf_clients WHERE buf_clients.obj-code = buf_buyer-in-buyer-group.bbg-obj-code                          AND buf_clients.obj-type = buf_buyer-in-buyer-group.bbg-obj-type                              NO-LOCK INDEXED-REPOSITION.
      845   END.
      846   ON CHOOSE OF B-find-obj IN FRAME Dialog-Frame
      847   DO:
      848     g-find = true  .
      849     run m-tt in this-procedure .
      850     F-obj = v-obj-type + " " +  string(v-obj-code) .
      851     display F-obj  with frame Dialog-Frame .
      852     OPEN QUERY BROWSE-1grp FOR EACH buf_buyer-group WHERE     ( r-status = 2 OR buf_buyer-group.stts =  r-status )      AND    ( g-find = NO OR      LOOKUP (STRING (buf_buyer-group.bgr-id) + ";"  + string(buf_buyer-group.bgr-db-num)  ,        tt-buyer-group ) > 0 )      and      ( r-find = no or (buf_buyer-group.bgr-db-num = find-db and      buf_buyer-group.bgr-id = find-id ))       BY buf_buyer-group.oborot BY buf_buyer-group.NAME .
      853     OPEN QUERY BROWSE-2cli FOR EACH buf_buyer-in-buyer-group OF buf_buyer-group      WHERE ( r-status = 2 OR buf_buyer-in-buyer-group.stts =  r-status )       NO-LOCK ,              EACH buf_clients WHERE buf_clients.obj-code = buf_buyer-in-buyer-group.bbg-obj-code                          AND buf_clients.obj-type = buf_buyer-in-buyer-group.bbg-obj-type                              NO-LOCK INDEXED-REPOSITION.
      854   END.
      855   ON CHOOSE OF B-history IN FRAME Dialog-Frame
      856   DO:
      857     if not available buf_buyer-group then return .
      858     run ref/cgr-buy.w (
      859         parParentProc ,
      860         buf_buyer-group.bgr-id ,
      861         buf_buyer-group.bgr-db-num ) .
      862   END.
      863   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
      864   DO:
      865       if available buf_buyer-group then do:
      866   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      867   define variable v-str-recid11 as character no-undo .
      868   define variable v-num-entry11 as integer   no-undo .
      869   assign
      870     v-str-recid11 = trim( string( recid( buf_buyer-group ) , "->>>>>>>>>>>9":U ) )
      871     v-num-entry11 = lookup( v-str-recid11 , p-rec-list )
      872   .
      873   if v-num-entry11 > 0 then do:
      874     assign
      875       entry( v-num-entry11, p-rec-list ) = "":U
      876       p-rec-list = trim( replace( p-rec-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      877     .
      878   end.
      879   else do:
      880     assign
      881       p-rec-list = p-rec-list + ( if p-rec-list = "":U then "":U else chr(44) ) + v-str-recid11
      882     .
      883   end.
      884           g-log = browse-1grp:refresh() .
      885         if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      886             g-log = browse-1grp:select-next-row ().
      887             apply "VALUE-CHANGED" to browse-1grp in frame Dialog-Frame.
      888         end.
      889       end.
      890       apply "display" to browse-1grp in frame Dialog-Frame.
      891   END.
      892   ON CHOOSE OF B-mark-2 IN FRAME Dialog-Frame
      893   DO:
      894       if available buf_buyer-in-buyer-group then do:
      895   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      896   define variable v-str-recid13 as character no-undo .
      897   define variable v-num-entry13 as integer   no-undo .
      898   assign
      899     v-str-recid13 = trim( string( recid( buf_buyer-in-buyer-group ) , "->>>>>>>>>>>9":U ) )
      900     v-num-entry13 = lookup( v-str-recid13 , v-rec-list-cli )
      901   .
      902   if v-num-entry13 > 0 then do:
      903     assign
      904       entry( v-num-entry13, v-rec-list-cli ) = "":U
      905       v-rec-list-cli = trim( replace( v-rec-list-cli , chr(44) + chr(44) , chr(44) ) , chr(44) )
      906     .
      907   end.
      908   else do:
      909     assign
      910       v-rec-list-cli = v-rec-list-cli + ( if v-rec-list-cli = "":U then "":U else chr(44) ) + v-str-recid13
      911     .
      912   end.
      913           g-log = browse-2cli:refresh() .
      914         if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      915             g-log = browse-2cli:select-next-row ().
      916             apply "VALUE-CHANGED" to browse-2cli in frame Dialog-Frame.
      917         end.
      918       end.
      919       apply "entry" to browse-2cli in frame Dialog-Frame.
      920   END.
      921   ON CHOOSE OF B-price-type IN FRAME Dialog-Frame
      922   DO:
      923     define variable v-recid as character no-undo .
      924     v-recid = string(RECID (buf_buyer-group)) .
      925     run ref/typepric.w (
      926             input parParentProc     ,
      927             input "mode=bgr-id,b-del,b-chg" ,
      928             input-output v-recid
      929             ) no-error .
      930   END.
      931   ON CHOOSE OF B-print IN FRAME Dialog-Frame
      932   DO:
      933   if not available buf_buyer-group then return .
      934     run rep/g-prcus.p
      935     ( parParentProc ,
      936       recid( buf_buyer-group )
      937     ).
      938   END.
      939   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
      940   DO:
      941       if ( available buf_buyer-group ) AND ( p-rec-list = "" ) then
      942       p-rec-list = string( recid( buf_buyer-group ) ) .
      943   END.
      944   ON VALUE-CHANGED OF BROWSE-1grp IN FRAME Dialog-Frame
      945   DO:
      946     OPEN QUERY BROWSE-2cli FOR EACH buf_buyer-in-buyer-group OF buf_buyer-group      WHERE ( r-status = 2 OR buf_buyer-in-buyer-group.stts =  r-status )       NO-LOCK ,              EACH buf_clients WHERE buf_clients.obj-code = buf_buyer-in-buyer-group.bbg-obj-code                          AND buf_clients.obj-type = buf_buyer-in-buyer-group.bbg-obj-type                              NO-LOCK INDEXED-REPOSITION.
      947   END.
      948   ON VALUE-CHANGED OF R-status IN FRAME Dialog-Frame
      949   DO:
      950       ASSIGN R-status .
      951     OPEN QUERY BROWSE-1grp FOR EACH buf_buyer-group WHERE     ( r-status = 2 OR buf_buyer-group.stts =  r-status )      AND    ( g-find = NO OR      LOOKUP (STRING (buf_buyer-group.bgr-id) + ";"  + string(buf_buyer-group.bgr-db-num)  ,        tt-buyer-group ) > 0 )      and      ( r-find = no or (buf_buyer-group.bgr-db-num = find-db and      buf_buyer-group.bgr-id = find-id ))       BY buf_buyer-group.oborot BY buf_buyer-group.NAME .
      952     OPEN QUERY BROWSE-2cli FOR EACH buf_buyer-in-buyer-group OF buf_buyer-group      WHERE ( r-status = 2 OR buf_buyer-in-buyer-group.stts =  r-status )       NO-LOCK ,              EACH buf_clients WHERE buf_clients.obj-code = buf_buyer-in-buyer-group.bbg-obj-code                          AND buf_clients.obj-type = buf_buyer-in-buyer-group.bbg-obj-type                              NO-LOCK INDEXED-REPOSITION.
      953   END.
      954   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      955   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      956   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      957   on help of frame Dialog-Frame
      958   do:
      959     run gbl/app_help.p
      960       (input this-procedure :file-name
      961       ,input ''
      962       ,input ?
      963       ) no-error.
      964     if error-status :error then do:
      965       message
      966         "Ошибка при вызове помощи"
      967         error-status :get-message(1)
      968         view-as alert-box .
      969     end.
      970   end.
      971   run minbtn-set in this-procedure .
      972   on choose of b-help in frame Dialog-Frame
      973   do:
      974     apply "help":u to frame Dialog-Frame .
      975   end.
      976   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      977   procedure minbtn-set :
      978       do
      979           on error undo, return error return-value
      980           :
      981           define variable ii              as integer       no-undo .
      982           define variable fh              as widget-handle no-undo .
      983           define variable hh              as widget-handle no-undo .
      984           define variable v-h             as handle        extent 4 no-undo .
      985           define variable v-name-button   as character     no-undo .
      986           define variable v-help-old-x    as decimal       no-undo .
      987           define variable v-help-old-y    as decimal       no-undo .
      988           define variable v-help-old-size as decimal       no-undo .
      989           define variable v-frame-width   as decimal       no-undo .
      990           define variable jj              as integer       no-undo .
      991           do
      992               on error undo, return error
      993               :
      994               assign
      995                   v-frame-width = frame Dialog-Frame:width - 0.3
      996                   fh            = frame Dialog-Frame:first-child
      997                   hh            = fh:first-child
      998                   ii            = 1
      999                   .
     1000               do while valid-handle(hh):
     1001                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1002                   do:
     1003                       case lc(hh:name) :
     1004                           when "b-help" then
     1005                               do:
     1006                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1007                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1008                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1009                                   hh:TOOLTIP = "Помощь" .
     1010                                   v-help-old-x = hh:column .
     1011                                   v-help-old-y = hh:row    .
     1012                                   v-help-old-size = hh:width .
     1013                                   hh:width-chars = 2.5 .
     1014                               end.
     1015                           when "b-print" then
     1016                               do:
     1017                                   hh:load-image("cmp/b-print.bmp":u) .
     1018                                   hh:TOOLTIP = "Печать" .
     1019                                   v-h[ii] = hh:handle .
     1020                                   ii = ii + 1 .
     1021                                   hh:width-chars = 3 .
     1022                               end.
     1023                           when "b-history" or
     1024                           when "b-hist" then
     1025                               do:
     1026                                   hh:load-image("cmp/b-hist.bmp":u) .
     1027                                   hh:TOOLTIP = "История" .
     1028                                   v-h[ii] = hh:handle .
     1029                                   ii = ii + 1 .
     1030                                   hh:width-chars = 3 .
     1031                               end.
     1032                           when "b-sch" then
     1033                               do:
     1034                                   hh:load-image("cmp/b-sch.bmp":u) .
     1035                                   hh:TOOLTIP = "Установка Фильтра" .
     1036                                   v-h[ii] = hh:handle .
     1037                                   ii = ii + 1 .
     1038                                   hh:width-chars = 3 .
     1039                               end.
     1040                           when "b-hist-user" then
     1041                               do:
     1042                                   hh:load-image("cmp/b-hist.bmp":u) .
     1043                                   hh:TOOLTIP = "История пользователя" .
     1044                                   ii = ii + 1 .
     1045                               end.
     1046                       end case.
     1047                   end.
     1048                   hh = hh:next-sibling.
     1049               end.
     1050               b-help:column = v-frame-width - b-help:width-chars.
     1051               jj = 0.
     1052               repeat ii = 4 to 1 by -1 :
     1053                   if valid-handle (v-h[ii] ) then
     1054                   do:
     1055                       jj  = jj + 1 .
     1056                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1057                       v-h[ii]:row    = v-help-old-y .
     1058                   end.
     1059               end.
     1060           end.
     1061       end.
     1062   end procedure.
     1063   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1064   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1065   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1066   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1067   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1068   define variable v-diasize-current-frame-height as decimal   no-undo .
     1069   define variable v-diasize-change-size          as logical   no-undo .
     1070   define variable v-diasize-resize-button        as handle    no-undo .
     1071   define variable v-diasize-wndmax               as logical   no-undo .
     1072   define variable v-diasize-wndstore             as logical   no-undo .
     1073   define variable v-diasize-proc-name            as character no-undo .
     1074   define variable v-diasize-browse-handle        as handle    no-undo .
     1075   define variable v-diasize-browse-number        as integer   no-undo .
     1076   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1077   define temp-table temp-diasize-handle no-undo
     1078     field handle-value  as handle
     1079     field save-position as decimal
     1080     index xpk is primary unique handle-value
     1081     .
     1082   define temp-table temp-browse-handle no-undo
     1083     field browse-type   as character
     1084     field browse-number as integer
     1085     field browse-handle as handle
     1086     field original-size as decimal
     1087     index xpk is primary unique browse-type browse-number
     1088     index xie browse-type browse-handle
     1089   .
     1090   procedure diasize_change-height :
     1091     define input  parameter p-change-value  as decimal   no-undo .
     1092     define input  parameter p-move-resize   as logical   no-undo .
     1093     define variable v-field-group-handle    as handle    no-undo .
     1094     define variable v-object-handle         as handle    no-undo .
     1095     define variable v-frame-height          as decimal   no-undo .
     1096     define variable v-frame-virtual-height  as decimal   no-undo .
     1097     define variable v-browse-height         as decimal   no-undo .
     1098     define variable v-window-height         as decimal   no-undo .
     1099     define variable v-window-virtual-height as decimal   no-undo .
     1100     define variable v-change-sign           as integer   no-undo .
     1101     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1102     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1103     if p-change-value > 0
     1104     then do:
     1105       if frame Dialog-Frame :height + p-change-value
     1106           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1107       then do:
     1108         assign
     1109           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1110                           - (frame Dialog-Frame :height-chars)
     1111         .
     1112         if p-change-value <= 0
     1113         then do:
     1114           run diasize_position-resize-button in this-procedure .
     1115           return .
     1116         end.
     1117       end.
     1118     end.
     1119     if p-change-value < 0
     1120     then do:
     1121       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1122       then do:
     1123         assign
     1124           p-change-value = v-diasize-orig-frame-height
     1125                          - (frame Dialog-Frame :height-chars)
     1126         .
     1127         if p-change-value >= 0
     1128         then do:
     1129           run diasize_position-resize-button in this-procedure .
     1130           return .
     1131         end.
     1132       end.
     1133     end.
     1134     if p-change-value >= 0
     1135     then do:
     1136       assign
     1137         v-change-sign = 1
     1138       .
     1139     end.
     1140     else do:
     1141       assign
     1142         v-change-sign = -1
     1143       .
     1144     end.
     1145     assign
     1146       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1147     .
     1148     if p-change-value = 0
     1149     then do:
     1150       run diasize_position-resize-button in this-procedure .
     1151       return .
     1152     end.
     1153     move_block:
     1154     do
     1155     on error undo move_block, retry move_block
     1156     :
     1157       if retry
     1158       then do:
     1159         do
     1160         on error undo move_block, leave move_block
     1161         :
     1162           if p-change-value > 0
     1163           then do:
     1164             for each buf_temp-diasize-handle
     1165             on error undo, next
     1166             :
     1167               assign
     1168                 v-object-handle = buf_temp-diasize-handle.handle-value
     1169               .
     1170               if v-object-handle <> v-diasize-resize-button
     1171               then do:
     1172                 assign
     1173                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1174                 .
     1175               end.
     1176             end.
     1177             assign
     1178               v-diasize-browse-handle :height = v-browse-height
     1179             .
     1180             for each buf_temp-browse-handle
     1181               where buf_temp-browse-handle.browse-type = 'height':u
     1182             on error undo, next
     1183             :
     1184               assign
     1185                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1186               .
     1187             end.
     1188             assign
     1189               frame Dialog-Frame :height = v-frame-height
     1190             .
     1191             if frame Dialog-Frame :scrollable = true
     1192             then do:
     1193               assign
     1194                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1195               .
     1196             end.
     1197             run diasize_position-resize-button in this-procedure .
     1198           end.
     1199           else do:
     1200             if frame Dialog-Frame :scrollable = true
     1201             then do:
     1202               assign
     1203                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1204               .
     1205             end.
     1206             assign
     1207               frame Dialog-Frame :height = v-frame-height
     1208             .
     1209             assign
     1210               v-diasize-browse-handle :height = v-browse-height
     1211             .
     1212             for each buf_temp-browse-handle
     1213               where buf_temp-browse-handle.browse-type = 'height':u
     1214             on error undo, next
     1215             :
     1216               assign
     1217                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1218               .
     1219             end.
     1220             for each buf_temp-diasize-handle
     1221             on error undo, next
     1222             :
     1223               assign
     1224                 v-object-handle = buf_temp-diasize-handle.handle-value
     1225               .
     1226               if v-object-handle <> v-diasize-resize-button
     1227               then do:
     1228                 assign
     1229                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1230                 .
     1231               end.
     1232             end.
     1233             run diasize_position-resize-button in this-procedure .
     1234           end.
     1235           assign
     1236             v-diasize-change-size = false
     1237           .
     1238           leave move_block .
     1239         end.
     1240       end.
     1241       assign
     1242         v-diasize-need-full-display = true
     1243       .
     1244       if v-diasize-change-size = false
     1245       then do:
     1246         assign
     1247           v-diasize-change-size = true
     1248         .
     1249       end.
     1250       else do:
     1251         return .
     1252       end.
     1253       assign
     1254         v-frame-height = frame Dialog-Frame :height
     1255         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1256         v-browse-height = v-diasize-browse-handle :height
     1257       .
     1258       for each buf_temp-browse-handle
     1259         where buf_temp-browse-handle.browse-type = 'height':u
     1260       :
     1261         assign
     1262           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1263         .
     1264       end.
     1265       for each buf_temp-diasize-handle
     1266       :
     1267         delete buf_temp-diasize-handle .
     1268       end.
     1269       assign
     1270         v-field-group-handle = frame Dialog-Frame :first-child
     1271       .
     1272       do while valid-handle(v-field-group-handle)
     1273       :
     1274         assign
     1275           v-object-handle = v-field-group-handle :first-child
     1276         .
     1277         do while valid-handle(v-object-handle)
     1278         :
     1279           if  v-object-handle <> v-diasize-browse-handle :handle
     1280           and can-query(v-object-handle, "row")
     1281           and can-query(v-object-handle, "height")
     1282           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1283           then do:
     1284             find first buf_temp-browse-handle
     1285               where buf_temp-browse-handle.browse-type   = 'height':u
     1286                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1287               no-error .
     1288             if available buf_temp-browse-handle
     1289             then do:
     1290             end.
     1291             else do:
     1292               create buf_temp-diasize-handle .
     1293               assign
     1294                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1295                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1296               .
     1297             end.
     1298           end.
     1299           assign
     1300             v-object-handle = v-object-handle :next-sibling
     1301           .
     1302         end.
     1303         assign
     1304           v-field-group-handle = v-field-group-handle :next-sibling
     1305         .
     1306       end.
     1307       do with frame Dialog-Frame
     1308       :
     1309         hide v-diasize-resize-button .
     1310         assign
     1311           v-diasize-resize-button :row    = 1
     1312           v-diasize-resize-button :column = 1
     1313         .
     1314       end.
     1315       if p-change-value > 0
     1316       then do:
     1317         if frame Dialog-Frame :scrollable = true
     1318         then do:
     1319           assign
     1320             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1321             no-error .
     1322           if error-status :error
     1323           or error-status :get-message(1) <> ""
     1324           then do:
     1325             undo move_block, retry move_block .
     1326           end.
     1327         end.
     1328         assign
     1329           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1330           no-error .
     1331         if error-status :error
     1332         or error-status :get-message(1) <> ""
     1333         then do:
     1334           undo move_block, retry move_block .
     1335         end.
     1336         assign
     1337           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1338           no-error .
     1339         if error-status :error
     1340         or error-status :get-message(1) <> ""
     1341         then do:
     1342           undo move_block, retry move_block .
     1343         end.
     1344         for each buf_temp-browse-handle
     1345           where buf_temp-browse-handle.browse-type = 'height':u
     1346         on error undo move_block, retry move_block
     1347         :
     1348           assign
     1349             buf_temp-browse-handle.browse-handle :height
     1350               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1351             no-error .
     1352           if error-status :error
     1353           or error-status :get-message(1) <> ""
     1354           then do:
     1355             undo move_block, retry move_block .
     1356           end.
     1357         end.
     1358         for each buf_temp-diasize-handle
     1359         on error undo move_block, retry move_block
     1360         :
     1361           assign
     1362             v-object-handle = buf_temp-diasize-handle.handle-value
     1363           .
     1364           if v-object-handle <> v-diasize-resize-button
     1365           then do:
     1366             assign
     1367               v-object-handle :row = v-object-handle :row + p-change-value
     1368               no-error .
     1369             if error-status :error
     1370             or error-status :get-message(1) <> ""
     1371             then do:
     1372               undo move_block, retry move_block .
     1373             end.
     1374           end.
     1375         end.
     1376       end.
     1377       else do:
     1378         for each buf_temp-diasize-handle
     1379         on error undo move_block, retry move_block
     1380         :
     1381           assign
     1382             v-object-handle = buf_temp-diasize-handle.handle-value
     1383           .
     1384           if v-object-handle <> v-diasize-resize-button
     1385           then do:
     1386             assign
     1387               v-object-handle :row = v-object-handle :row + p-change-value
     1388               no-error .
     1389             if error-status :error
     1390             or error-status :get-message(1) <> ""
     1391             then do:
     1392               undo move_block, retry move_block .
     1393             end.
     1394           end.
     1395         end.
     1396         assign
     1397           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1398           no-error .
     1399         if error-status :error
     1400         or error-status :get-message(1) <> ""
     1401         then do:
     1402           undo move_block, retry move_block .
     1403         end.
     1404         for each buf_temp-browse-handle
     1405           where buf_temp-browse-handle.browse-type = 'height':u
     1406         on error undo move_block, retry move_block
     1407         :
     1408           assign
     1409             buf_temp-browse-handle.browse-handle :height
     1410               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1411             no-error .
     1412           if error-status :error
     1413           or error-status :get-message(1) <> ""
     1414           then do:
     1415             undo move_block, retry move_block .
     1416           end.
     1417         end.
     1418         assign
     1419           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1420           no-error .
     1421         if error-status :error
     1422         or error-status :get-message(1) <> ""
     1423         then do:
     1424           undo move_block, retry move_block .
     1425         end.
     1426         if frame Dialog-Frame :scrollable = true
     1427         then do:
     1428           assign
     1429             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1430             no-error .
     1431           if error-status :error
     1432           or error-status :get-message(1) <> ""
     1433           then do:
     1434             undo move_block, retry move_block .
     1435           end.
     1436         end.
     1437       end.
     1438       if p-move-resize = true
     1439       then do:
     1440         run diasize_position-resize-button in this-procedure .
     1441       end.
     1442       if v-diasize-wndstore = true
     1443       then do:
     1444         if connected("ub") = true
     1445         then do:
     1446           define variable v-cntxt-db-num        as integer   no-undo .
     1447           define variable v-cntxt-userid        as character no-undo .
     1448           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1449                                             , OUTPUT v-cntxt-userid
     1450                                             ) .
     1451           run gbl/wndsizew.p
     1452             (input  v-cntxt-db-num
     1453             ,input  v-cntxt-userid
     1454             ,input  v-diasize-proc-name
     1455             ,input  'height':u
     1456             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1457             ) .
     1458         end.
     1459       end.
     1460     end.
     1461     assign
     1462       v-diasize-change-size = false
     1463     .
     1464   end procedure.
     1465   procedure diasize_set-height :
     1466     define input  parameter p-new-height  as decimal   no-undo .
     1467     define input  parameter p-move-resize as logical   no-undo .
     1468     do
     1469     on error undo, return error return-value
     1470     :
     1471       run diasize_change-height in this-procedure
     1472         (input  (p-new-height - frame Dialog-Frame :height)
     1473         ,input  p-move-resize
     1474         ) .
     1475     end.
     1476   end procedure.
     1477   procedure diasize_change-width :
     1478     define input  parameter p-change-value as decimal   no-undo .
     1479     define input  parameter p-move-resize  as logical   no-undo .
     1480     define variable v-field-group-handle   as handle    no-undo .
     1481     define variable v-object-handle        as handle    no-undo .
     1482     define variable v-frame-width          as decimal   no-undo .
     1483     define variable v-frame-virtual-width  as decimal   no-undo .
     1484     define variable v-browse-width         as decimal   no-undo .
     1485     define variable v-window-width         as decimal   no-undo .
     1486     define variable v-window-virtual-width as decimal   no-undo .
     1487     define variable v-change-sign          as integer   no-undo .
     1488     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1489     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1490     if p-change-value > 0
     1491     then do:
     1492       if frame Dialog-Frame :width + p-change-value >
     1493           session :width-chars
     1494       then do:
     1495         assign
     1496           p-change-value = session :width-chars - frame Dialog-Frame :width
     1497         .
     1498         if p-change-value <= 0
     1499         then do:
     1500           run diasize_position-resize-button in this-procedure .
     1501           return .
     1502         end.
     1503       end.
     1504     end.
     1505     if p-change-value < 0
     1506     then do:
     1507       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1508       then do:
     1509         assign
     1510           p-change-value = v-diasize-orig-frame-width
     1511                          - frame Dialog-Frame :width
     1512         .
     1513         if p-change-value >= 0
     1514         then do:
     1515           run diasize_position-resize-button in this-procedure .
     1516           return .
     1517         end.
     1518       end.
     1519     end.
     1520     if p-change-value >= 0
     1521     then do:
     1522       assign
     1523         v-change-sign = 1
     1524       .
     1525     end.
     1526     else do:
     1527       assign
     1528         v-change-sign = -1
     1529       .
     1530     end.
     1531     assign
     1532       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1533     .
     1534     if p-change-value = 0
     1535     then do:
     1536       run diasize_position-resize-button in this-procedure .
     1537       return .
     1538     end.
     1539     move_block:
     1540     do
     1541     on error undo move_block, leave move_block
     1542     :
     1543       if retry
     1544       then do:
     1545         do
     1546         on error undo move_block, leave move_block
     1547         :
     1548           if p-change-value > 0
     1549           then do:
     1550             for each buf_temp-diasize-handle
     1551             on error undo, next
     1552             :
     1553               assign
     1554                 v-object-handle = buf_temp-diasize-handle.handle-value
     1555               .
     1556               if v-object-handle <> v-diasize-resize-button
     1557               then do:
     1558                 assign
     1559                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1560                 .
     1561               end.
     1562             end.
     1563             assign
     1564               v-diasize-browse-handle :width = v-browse-width
     1565             .
     1566             for each buf_temp-browse-handle
     1567               where buf_temp-browse-handle.browse-type = 'width':u
     1568             on error undo, next
     1569             :
     1570               assign
     1571                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1572               .
     1573             end.
     1574             assign
     1575               frame Dialog-Frame :width = v-frame-width
     1576             .
     1577             if frame Dialog-Frame :scrollable = true
     1578             then do:
     1579               assign
     1580                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1581               .
     1582             end.
     1583             run diasize_position-resize-button in this-procedure .
     1584           end.
     1585           else do:
     1586             if frame Dialog-Frame :scrollable = true
     1587             then do:
     1588               assign
     1589                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1590               .
     1591             end.
     1592             assign
     1593               frame Dialog-Frame :width = v-frame-width
     1594             .
     1595             for each buf_temp-browse-handle
     1596               where buf_temp-browse-handle.browse-type = 'width':u
     1597             on error undo, next
     1598             :
     1599               assign
     1600                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1601               .
     1602             end.
     1603             assign
     1604               v-diasize-browse-handle :width = v-browse-width
     1605             .
     1606             for each buf_temp-diasize-handle
     1607             on error undo, next
     1608             :
     1609               assign
     1610                 v-object-handle = buf_temp-diasize-handle.handle-value
     1611               .
     1612               if v-object-handle <> v-diasize-resize-button
     1613               then do:
     1614                 assign
     1615                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1616                 .
     1617               end.
     1618             end.
     1619             run diasize_position-resize-button in this-procedure .
     1620           end.
     1621           assign
     1622             v-diasize-change-size = false
     1623           .
     1624           leave move_block .
     1625         end.
     1626       end.
     1627       assign
     1628         v-diasize-need-full-display = true
     1629       .
     1630       if v-diasize-change-size = false
     1631       then do:
     1632         assign
     1633           v-diasize-change-size = true
     1634         .
     1635       end.
     1636       else do:
     1637         return .
     1638       end.
     1639       assign
     1640         v-frame-width = frame Dialog-Frame :width
     1641         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1642         v-browse-width = v-diasize-browse-handle :width
     1643       .
     1644       for each buf_temp-browse-handle
     1645         where buf_temp-browse-handle.browse-type = 'width':u
     1646       :
     1647         assign
     1648           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1649         .
     1650       end.
     1651       for each buf_temp-diasize-handle
     1652       :
     1653         delete buf_temp-diasize-handle .
     1654       end.
     1655       assign
     1656         v-field-group-handle = frame Dialog-Frame :first-child
     1657       .
     1658       do while valid-handle(v-field-group-handle)
     1659       :
     1660         assign
     1661           v-object-handle = v-field-group-handle :first-child
     1662         .
     1663         do while valid-handle(v-object-handle)
     1664         :
     1665           if  v-object-handle <> v-diasize-browse-handle :handle
     1666           and v-object-handle <> v-diasize-resize-button
     1667           and can-query(v-object-handle, "row")
     1668           and can-query(v-object-handle, "height")
     1669           and ( v-object-handle :col + v-object-handle :width
     1670                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1671               )
     1672           then do:
     1673             find first buf_temp-browse-handle
     1674               where buf_temp-browse-handle.browse-type   = 'width':u
     1675                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1676               no-error .
     1677             if available buf_temp-browse-handle
     1678             then do:
     1679             end.
     1680             else do:
     1681               create buf_temp-diasize-handle .
     1682               assign
     1683                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1684                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1685               .
     1686             end.
     1687           end.
     1688           assign
     1689             v-object-handle = v-object-handle :next-sibling
     1690           .
     1691         end.
     1692         assign
     1693           v-field-group-handle = v-field-group-handle :next-sibling
     1694         .
     1695       end.
     1696       do with frame Dialog-Frame
     1697       :
     1698         hide v-diasize-resize-button .
     1699         v-diasize-resize-button :row = 1.
     1700         v-diasize-resize-button :column = 1.
     1701       end.
     1702       if p-change-value > 0
     1703       then do:
     1704         if frame Dialog-Frame :scrollable = true
     1705         then do:
     1706           assign
     1707             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1708             no-error .
     1709           if error-status :error
     1710           or error-status :get-message(1) <> ""
     1711           then do:
     1712             undo move_block, retry move_block.
     1713           end.
     1714         end.
     1715         assign
     1716           frame Dialog-Frame :width = v-frame-width + p-change-value
     1717           no-error .
     1718         if error-status :error
     1719         or error-status :get-message(1) <> ""
     1720         then do:
     1721           undo move_block, retry move_block.
     1722         end.
     1723         assign
     1724           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1725         no-error .
     1726         if error-status :error
     1727         or error-status :get-message(1) <> ""
     1728         then do:
     1729           undo move_block, retry move_block.
     1730         end.
     1731         for each buf_temp-browse-handle
     1732           where buf_temp-browse-handle.browse-type = 'width':u
     1733         on error undo move_block, retry move_block
     1734         :
     1735           assign
     1736             buf_temp-browse-handle.browse-handle :width
     1737               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1738             no-error .
     1739           if error-status :error
     1740           or error-status :get-message(1) <> ""
     1741           then do:
     1742             undo move_block, retry move_block .
     1743           end.
     1744         end.
     1745         for each buf_temp-diasize-handle
     1746         on error undo move_block, retry move_block
     1747         :
     1748           assign
     1749             v-object-handle = buf_temp-diasize-handle.handle-value
     1750           .
     1751           if v-object-handle <> v-diasize-resize-button
     1752           then do:
     1753             assign
     1754               v-object-handle :col = v-object-handle :col + p-change-value
     1755               no-error .
     1756             if error-status :error
     1757             or error-status :get-message(1) <> ""
     1758             then do:
     1759               undo move_block, retry move_block .
     1760             end.
     1761           end.
     1762         end.
     1763       end.
     1764       else do:
     1765         for each buf_temp-diasize-handle
     1766         on error undo move_block, retry move_block
     1767         :
     1768           assign
     1769             v-object-handle = buf_temp-diasize-handle.handle-value
     1770           .
     1771           if v-object-handle <> v-diasize-resize-button
     1772           then do:
     1773             assign
     1774               v-object-handle :col = v-object-handle :col + p-change-value
     1775               no-error .
     1776             if error-status :error
     1777             or error-status :get-message(1) <> ""
     1778             then do:
     1779               undo move_block, retry move_block .
     1780             end.
     1781           end.
     1782         end.
     1783         for each buf_temp-browse-handle
     1784           where buf_temp-browse-handle.browse-type = 'width':u
     1785         on error undo move_block, retry move_block
     1786         :
     1787           assign
     1788             buf_temp-browse-handle.browse-handle :width
     1789               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1790             no-error .
     1791           if error-status :error
     1792           or error-status :get-message(1) <> ""
     1793           then do:
     1794             undo move_block, retry move_block .
     1795           end.
     1796         end.
     1797         assign
     1798           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1799           no-error .
     1800         if error-status :error
     1801         or error-status :get-message(1) <> ""
     1802         then do:
     1803           undo move_block, retry move_block.
     1804         end.
     1805         assign
     1806           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1807         no-error .
     1808         if error-status :error
     1809         or error-status :get-message(1) <> ""
     1810         then do:
     1811           undo move_block, retry move_block.
     1812         end.
     1813         if frame Dialog-Frame :scrollable = true
     1814         then do:
     1815           assign
     1816             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1817           no-error .
     1818           if error-status :error
     1819           or error-status :get-message(1) <> ""
     1820           then do:
     1821             undo move_block, retry move_block.
     1822           end.
     1823         end.
     1824       end.
     1825       if p-move-resize
     1826       then do:
     1827         run diasize_position-resize-button in this-procedure .
     1828       end.
     1829       if v-diasize-wndstore = true
     1830       then do:
     1831         if connected("ub") = true
     1832         then do:
     1833           define variable v-cntxt-db-num        as integer   no-undo .
     1834           define variable v-cntxt-userid        as character no-undo .
     1835           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1836                                             , OUTPUT v-cntxt-userid
     1837                                             ) .
     1838           run gbl/wndsizew.p
     1839             (input  v-cntxt-db-num
     1840             ,input  v-cntxt-userid
     1841             ,input  v-diasize-proc-name
     1842             ,input  'width':u
     1843             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1844             ) .
     1845         end.
     1846       end.
     1847     end.
     1848     assign
     1849       v-diasize-change-size = false
     1850     .
     1851   end procedure.
     1852   procedure diasize_set-width :
     1853     define input  parameter p-new-width  as decimal   no-undo .
     1854     define input  parameter p-move-resize as logical   no-undo .
     1855     do
     1856     on error undo, return error return-value
     1857     :
     1858       run diasize_change-width in this-procedure
     1859         (input  (p-new-width - frame Dialog-Frame :width)
     1860         ,input  p-move-resize
     1861         ) .
     1862     end.
     1863   end procedure.
     1864   procedure diasize_position-resize-button :
     1865     do with frame Dialog-Frame
     1866     :
     1867       hide v-diasize-resize-button .
     1868       assign
     1869         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1870                     - 1
     1871                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1872         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1873                     - 1
     1874                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1875       .
     1876       view v-diasize-resize-button .
     1877     end.
     1878   end procedure.
     1879   on alt-right anywhere
     1880   do:
     1881     run diasize_change-width in this-procedure
     1882       (input 1
     1883       ,input true
     1884       ) .
     1885     return no-apply .
     1886   end.
     1887   on alt-left anywhere
     1888   do:
     1889     run diasize_change-width in this-procedure
     1890       (input -1
     1891       ,input true
     1892       ) .
     1893     return no-apply .
     1894   end.
     1895   on alt-down anywhere
     1896   do:
     1897     run diasize_change-height in this-procedure
     1898       (input 1
     1899       ,input true
     1900       ) .
     1901     return no-apply .
     1902   end.
     1903   on alt-up anywhere
     1904   do:
     1905     run diasize_change-height in this-procedure
     1906       (input -1
     1907       ,input true
     1908       ) .
     1909     return no-apply .
     1910   end.
     1911   on alt-enter of frame Dialog-Frame
     1912   do:
     1913     run diasize_maximize in this-procedure
     1914       (input  ?
     1915       ).
     1916     return no-apply .
     1917   end.
     1918   procedure diasize_end-move :
     1919     do
     1920     on error undo, return error return-value
     1921     :
     1922       define variable v-row-delta as decimal   no-undo .
     1923       define variable v-col-delta as decimal   no-undo .
     1924       define variable v-new-row as decimal   no-undo .
     1925       define variable v-new-col as decimal   no-undo .
     1926       assign
     1927         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1928         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1929       .
     1930       assign
     1931         v-row-delta = v-new-row - frame Dialog-Frame :height
     1932         v-col-delta = v-new-col - frame Dialog-Frame :width
     1933       .
     1934       run diasize_change-height in this-procedure
     1935         (input v-row-delta
     1936         ,input true
     1937         ) .
     1938       run diasize_change-width in this-procedure
     1939         (input v-col-delta
     1940         ,input true
     1941         ) .
     1942     end.
     1943   end procedure.
     1944   procedure diasize_maximize :
     1945     define input  parameter p-action as logical   no-undo .
     1946     do
     1947     on error undo, return error return-value
     1948     :
     1949       if p-action = ?
     1950       then do:
     1951         if v-diasize-need-maximize = true
     1952         then do:
     1953           assign
     1954             p-action = true
     1955           .
     1956         end.
     1957         else do:
     1958           assign
     1959             p-action = false
     1960           .
     1961         end.
     1962       end.
     1963       if p-action = true
     1964       then do:
     1965         run diasize_change-height in this-procedure
     1966           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1967               - frame Dialog-Frame :height-chars
     1968           ,input true
     1969           ) .
     1970         run diasize_change-width in this-procedure
     1971           (input session :width-chars
     1972               - frame Dialog-Frame :width-chars
     1973           ,input true
     1974           ) .
     1975         assign
     1976           v-diasize-need-maximize = false
     1977         .
     1978       end.
     1979       else do:
     1980         run diasize_change-width in this-procedure
     1981           (input v-diasize-orig-frame-width
     1982               - frame Dialog-Frame :width-chars
     1983           ,input true
     1984           ) .
     1985         run diasize_change-height in this-procedure
     1986           (input v-diasize-orig-frame-height
     1987               - frame Dialog-Frame :height-chars
     1988           ,input true
     1989           ) .
     1990         assign
     1991           v-diasize-need-maximize = true
     1992         .
     1993       end.
     1994     end.
     1995   end procedure.
     1996   procedure diasize_restore-orig-size :
     1997     do
     1998     on error undo, return error return-value
     1999     :
     2000       assign
     2001         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2002         v-diasize-current-frame-height = frame Dialog-Frame :height
     2003       .
     2004       run diasize_set-height in this-procedure
     2005         (input  v-diasize-orig-frame-height
     2006         ,input  true
     2007         ) .
     2008       run diasize_set-width in this-procedure
     2009         (input  v-diasize-orig-frame-width
     2010         ,input  true
     2011         ) .
     2012     end.
     2013   end procedure.
     2014   procedure diasize_restore-current-size :
     2015     do
     2016     on error undo, return error return-value
     2017     :
     2018       run diasize_set-height in this-procedure
     2019         (input  v-diasize-current-frame-height
     2020         ,input  true
     2021         ) .
     2022       run diasize_set-width in this-procedure
     2023         (input  v-diasize-current-frame-width
     2024         ,input  true
     2025         ) .
     2026     end.
     2027   end procedure.
     2028   procedure diasize_set-browse-handle :
     2029     define input  parameter p-browse-handle as handle   no-undo .
     2030     define buffer buf_temp-browse-handle for temp-browse-handle .
     2031     do
     2032     on error undo, return error return-value
     2033     :
     2034       assign
     2035         v-diasize-browse-handle = p-browse-handle
     2036       .
     2037       for each buf_temp-browse-handle
     2038       on error undo, return error return-value
     2039       :
     2040         delete buf_temp-browse-handle .
     2041       end.
     2042     end.
     2043   end procedure.
     2044   procedure diasize_add_browse :
     2045     define input  parameter p-browse-type   as character no-undo .
     2046     define input  parameter p-browse-handle as handle    no-undo .
     2047     define buffer buf_temp-browse-handle for temp-browse-handle .
     2048     do
     2049     on error undo, return error return-value
     2050     :
     2051       assign
     2052         v-diasize-browse-number = v-diasize-browse-number + 1
     2053       .
     2054       create buf_temp-browse-handle .
     2055       assign
     2056         buf_temp-browse-handle.browse-type   = p-browse-type
     2057         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2058         buf_temp-browse-handle.browse-handle = p-browse-handle
     2059       .
     2060     end.
     2061   end procedure.
     2062   procedure diasize_init :
     2063     define variable v-default-value    as logical   no-undo .
     2064     define variable v-restore-saved    as logical   no-undo .
     2065     define variable v-resize-value-str as character no-undo .
     2066     do
     2067     on error undo, return error return-value
     2068     :
     2069       do with frame Dialog-Frame
     2070       :
     2071         assign
     2072           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2073           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2074           v-diasize-browse-handle     = browse browse-1grp :handle
     2075         .
     2076         create button v-diasize-resize-button
     2077         assign
     2078           parent        = frame Dialog-Frame :first-child
     2079           label         = "s"
     2080           height-pixels = 16
     2081           width-pixels  = 16
     2082           visible       = true
     2083           sensitive     = true
     2084           movable       = true
     2085           triggers:
     2086             on end-move persistent run diasize_end-move in this-procedure .
     2087           end triggers.
     2088         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2089         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2090         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2091         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2092         assign
     2093           v-diasize-wndmax = false
     2094         .
     2095         if connected("ub") = true
     2096         then do:
     2097           define variable v-cntxt-db-num        as integer   no-undo .
     2098           define variable v-cntxt-userid        as character no-undo .
     2099           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2100                                             , OUTPUT v-cntxt-userid
     2101                                             ) .
     2102           run gbl/wndpar_r.p
     2103             (input  v-cntxt-db-num
     2104             ,input  v-cntxt-userid
     2105             ,input  'wndmax':U
     2106             ,output v-diasize-wndmax
     2107             ,output v-default-value
     2108             ) .
     2109         end.
     2110         assign
     2111           v-diasize-wndstore = false
     2112         .
     2113         if connected("ub") = true
     2114         then do:
     2115           run gbl/wndpar_r.p
     2116             (input  v-cntxt-db-num
     2117             ,input  v-cntxt-userid
     2118             ,input  'wndstore':U
     2119             ,output v-diasize-wndstore
     2120             ,output v-default-value
     2121             ) .
     2122         end.
     2123         assign
     2124           v-diasize-proc-name = entry(1, program-name(2), '.')
     2125         .
     2126         if v-diasize-wndstore = true
     2127         then do:
     2128           assign
     2129             v-restore-saved = false
     2130           .
     2131           if connected("ub") = true
     2132           then do:
     2133             run gbl/wndsizer.p
     2134               (input  v-cntxt-db-num
     2135               ,input  v-cntxt-userid
     2136               ,input  v-diasize-proc-name
     2137               ,input  'height':u
     2138               ,output v-resize-value-str
     2139               ) .
     2140             if v-resize-value-str <> '':U
     2141             then do:
     2142               run diasize_change-height in this-procedure
     2143                 (input  integer(v-resize-value-str)
     2144                 ,input  true
     2145                 ) .
     2146               assign
     2147                 v-restore-saved = true
     2148               .
     2149             end.
     2150           end.
     2151           if connected("ub") = true
     2152           then do:
     2153             run gbl/wndsizer.p
     2154               (input  v-cntxt-db-num
     2155               ,input  v-cntxt-userid
     2156               ,input  v-diasize-proc-name
     2157               ,input  'width':u
     2158               ,output v-resize-value-str
     2159               ) .
     2160             if v-resize-value-str <> '':U
     2161             then do:
     2162               run diasize_change-width in this-procedure
     2163                 (input  integer(v-resize-value-str)
     2164                 ,input  true
     2165                 ) .
     2166               assign
     2167                 v-restore-saved = true
     2168               .
     2169             end.
     2170           end.
     2171           if v-restore-saved <> true
     2172           then do:
     2173             if v-diasize-wndmax = true
     2174             then do:
     2175               run diasize_maximize in this-procedure
     2176                 (input  true
     2177                 ) .
     2178             end.
     2179           end.
     2180         end.
     2181         else do:
     2182           if v-diasize-wndmax = true
     2183           then do:
     2184             run diasize_maximize in this-procedure
     2185               (input  true
     2186               ) .
     2187           end.
     2188         end.
     2189       end.
     2190     end.
     2191   end procedure.
     2192   procedure diasize_need-full-display :
     2193     define output parameter p-need-full-display as logical   no-undo .
     2194     do
     2195     on error undo, return error return-value
     2196     :
     2197       assign
     2198         p-need-full-display = v-diasize-need-full-display
     2199       .
     2200       assign
     2201         v-diasize-need-full-display = false
     2202       .
     2203     end.
     2204   end procedure.
     2205   procedure get-context :
     2206      define output parameter p-db-num as integer          no-undo.
     2207      define output parameter p-user-id as character        no-undo.
     2208      define variable v-login               as character    no-undo.
     2209      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2210      define buffer buf_user-login  for ub.user-login .
     2211      do
     2212      on error undo, return error
     2213      :
     2214            FIND FIRST buf_sys-ctrl no-lock.
     2215            ASSIGN
     2216               v-login = USERID("ub")
     2217               p-db-num = buf_sys-ctrl.db-num
     2218            .
     2219            FIND FIRST buf_user-login
     2220                 WHERE buf_user-login.db-num = p-db-num
     2221                   AND buf_user-login.user-login = v-login
     2222                 no-lock
     2223                 no-error
     2224                 .
     2225            IF AVAILABLE buf_user-login
     2226            THEN DO:
     2227               assign
     2228                  p-user-id = buf_user-login.user-id
     2229               .
     2230            END.
     2231      end.
     2232   end procedure.
     2233   run diasize_add_browse in this-procedure
     2234     (input  'HEIGHT':U
     2235     ,input  browse browse-2cli :handle
     2236     ) .
     2237   run diasize_init in this-procedure .
     2238   MAIN-BLOCK:
     2239   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2240      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2241      define variable g#log as logical   no-undo .
     2242   define variable vss-include-info17 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2243   do:
     2244     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2245       (input  v-cntxt-db-num
     2246       ,input  v-cntxt-userid
     2247       ,input  0
     2248       ,input  'actn_ref-mpl_lookup':U
     2249       ,input  'global':U
     2250       ,input  v-cntxt-host-code-obj
     2251       ,input  v-cntxt-obj-type
     2252       ,input  v-cntxt-obj-code
     2253       ,input  0
     2254       ,input  0
     2255       ,input  0
     2256       ,input  true
     2257       ,output g#log
     2258       )  .
     2259   end.
     2260     if not g#log then return .
     2261      buf_buyer-group.name:resizable in browse browse-1grp = true .
     2262      buf_buyer-group.oborot:resizable in browse browse-1grp = true .
     2263      buf_clients.obj-name:resizable in browse browse-2cli = true .
     2264      buf_buyer-group.name:width  in browse browse-1grp = 20 .
     2265      buf_buyer-group.oborot:width  in browse browse-1grp = 15 .
     2266      buf_clients.obj-name:width in browse browse-2cli = 20 .
     2267     if p-rec-list <> "" and p-rec-list <> ? then run select_one .
     2268     RUN enable_UI.
     2269     disable
     2270        B-sel    when LOOKUP ("b-sel":U,      p-bttns) = 0
     2271        B-add    when LOOKUP ("b-add":U,      p-bttns) = 0
     2272        B-chg    when LOOKUP ("b-chg":U,      p-bttns) = 0
     2273        B-del    when LOOKUP ("b-del":U,      p-bttns) = 0
     2274        B-add-2  when LOOKUP ("b-add":U,      p-bttns) = 0
     2275        B-del-2  when LOOKUP ("b-del":U,      p-bttns) = 0
     2276        B-mark-2 when LOOKUP ("b-mark-2":U,   p-bttns) = 0
     2277        B-mark   when LOOKUP ("b-mark":U,     p-bttns) = 0
     2278     with frame Dialog-Frame .
     2279     WAIT-FOR GO OF FRAME Dialog-Frame.
     2280   END.
     2281   RUN disable_UI.
     2282   PROCEDURE disable_UI :
     2283     HIDE FRAME Dialog-Frame.
     2284   END PROCEDURE.
     2285   PROCEDURE enable_UI :
     2286     DISPLAY R-status FILL-IN-1 F-obj
     2287         WITH FRAME Dialog-Frame.
     2288     ENABLE B-Cancel B-sel B-add B-chg B-del B-price-type B-history B-print B-Help
     2289            R-status B-mark-2 B-add-2 B-del-2 B-mark B-find-obj B-all BROWSE-1grp
     2290            BROWSE-2cli FILL-IN-1 F-obj
     2291         WITH FRAME Dialog-Frame.
     2292     VIEW FRAME Dialog-Frame.
     2293     OPEN QUERY BROWSE-1grp FOR EACH buf_buyer-group WHERE     ( r-status = 2 OR buf_buyer-group.stts =  r-status )      AND    ( g-find = NO OR      LOOKUP (STRING (buf_buyer-group.bgr-id) + ";"  + string(buf_buyer-group.bgr-db-num)  ,        tt-buyer-group ) > 0 )      and      ( r-find = no or (buf_buyer-group.bgr-db-num = find-db and      buf_buyer-group.bgr-id = find-id ))       BY buf_buyer-group.oborot BY buf_buyer-group.NAME .    OPEN QUERY BROWSE-2cli FOR EACH buf_buyer-in-buyer-group OF buf_buyer-group      WHERE ( r-status = 2 OR buf_buyer-in-buyer-group.stts =  r-status )       NO-LOCK ,              EACH buf_clients WHERE buf_clients.obj-code = buf_buyer-in-buyer-group.bbg-obj-code                          AND buf_clients.obj-type = buf_buyer-in-buyer-group.bbg-obj-type                              NO-LOCK INDEXED-REPOSITION.
     2294   END PROCEDURE.
     2295   PROCEDURE m-tt :
     2296   define variable v-rid-list as character no-undo .
     2297        run ref/cli-all.w
     2298      ( input parparentproc,
     2299        input "b-sel",
     2300        input 'орг':U ,
     2301        input ?      ,
     2302        input ?      ,
     2303        input ?      ,
     2304        input ?      ,
     2305        input ?      ,
     2306        output v-rid-list ).
     2307   define buffer buf_clients for ub.clients  .
     2308   find first buf_clients no-lock where recid (buf_clients) = integer( v-rid-list) no-error .
     2309   if error-status :error then
     2310   assign
     2311         v-obj-type = ""
     2312         v-obj-code = ?
     2313   .
     2314   else
     2315   assign
     2316         v-obj-type = buf_clients.obj-type
     2317         v-obj-code = buf_clients.obj-code
     2318   .
     2319   define buffer b_buyer-in-buyer-group for ub.buyer-in-buyer-group  .
     2320   define buffer b_buyer-group          for ub.buyer-group  .
     2321     tt-buyer-group = "".
     2322     for each b_buyer-in-buyer-group  where
     2323              b_buyer-in-buyer-group.bbg-obj-type = v-obj-type and
     2324              b_buyer-in-buyer-group.bbg-obj-code = v-obj-code ,
     2325              first b_buyer-group  no-lock where
     2326                    b_buyer-group.bgr-id     = b_buyer-in-buyer-group.bgr-id and
     2327                    b_buyer-group.bgr-db-num = b_buyer-in-buyer-group.bgr-db-num
     2328              :
     2329              tt-buyer-group = tt-buyer-group + string ( b_buyer-in-buyer-group.bgr-id ) + ";"  + string ( b_buyer-in-buyer-group.bgr-db-num ) + "," .
     2330     end.
     2331   END PROCEDURE.
     2332   PROCEDURE select_one :
     2333   define buffer bufl_buyer-group for ub.buyer-group  .
     2334   find first bufl_buyer-group no-lock where recid(bufl_buyer-group) = int(p-rec-list) no-error .
     2335   if error-status :error then return .
     2336   r-find = true .
     2337   find-db = bufl_buyer-group.bgr-db-num  .
     2338   find-id = bufl_buyer-group.bgr-id      .
     2339   END PROCEDURE.
