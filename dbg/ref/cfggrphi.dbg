     1077   .
     1078   FUNCTION get-all-fields returns character (p-file-name as character ):
     1079   define variable v-dop as character no-undo .
     1080     find first _file no-lock where _file._file-name = p-file-name no-error .
     1081     if not available _file then return "":U.
     1082     for each _field no-lock where
     1083              _field._file-recid = recid(_file) :
     1084       assign
     1085       v-dop = v-dop + _field._field-name + chr(44)
     1086       .
     1087     end.
     1088     return trim(v-dop).
     1089   END FUNCTION.
     1090   PROCEDURE proc-full-temp-changes :
     1091     define input  parameter p-hst-handle as handle    no-undo .
     1092     define input  parameter p-main-table as character no-undo .
     1093     define input  parameter p-field-list as character no-undo .
     1094     define input  parameter p-label-form as character no-undo .
     1095     define variable h-new-buf         as handle    no-undo .
     1096     define variable h-main-buf        as handle    no-undo .
     1097     define variable h-for-comp        as handle    no-undo .
     1098     define variable v-inform          as character no-undo .
     1099     define variable v-ind             as integer   no-undo .
     1100     define variable v-idx-field-qnty  as integer   no-undo .
     1101     define variable v-num-entries     as integer   no-undo .
     1102     define variable fh                as handle    no-undo .
     1103     define variable fh-main           as handle    no-undo .
     1104     define variable fh-old            as handle    no-undo .
     1105     define variable fh-new            as handle    no-undo .
     1106     define variable v-field-name      as character no-undo .
     1107     define variable v-field-lvl       as character no-undo .
     1108     define variable v-field-form      as character no-undo .
     1109     define variable v-search-exp      as character no-undo .
     1110     define variable v-srch-main       as character no-undo .
     1111     define variable v-word-link       as character no-undo .
     1112     define variable v-av-chip-num     as logical   no-undo .
     1113     define variable v-main-pi-fld-lst as character no-undo .
     1114     define variable v-main-fld-lst    as character no-undo .
     1115     define variable v-delim-list      as character no-undo .
     1116     define variable v-label           as character no-undo .
     1117     define variable v-old-value       as character no-undo case-sensitive.
     1118     define variable v-new-value       as character no-undo case-sensitive.
     1119     define variable v-chg-fields as character no-undo.
     1120     for each temp-changes:
     1121       delete temp-changes.
     1122     end.
     1123     if not p-hst-handle:available then do:
     1124       return .
     1125     end.
     1126     create buffer h-new-buf  for table p-hst-handle .
     1127     create buffer h-main-buf for table p-main-table .
     1128     assign
     1129       v-inform = h-main-buf:index-information(1)
     1130       v-ind    = 2
     1131     .
     1132     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1133     on error undo, return error
     1134     :
     1135       assign
     1136         v-inform = h-main-buf:index-information( v-ind )
     1137         v-ind    = v-ind + 1
     1138       .
     1139     end.
     1140     if v-inform = ?
     1141       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1142       or entry( 3, v-inform, ",":U ) <> "1":U
     1143     then do:
     1144       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1145     end.
     1146     assign
     1147       v-idx-field-qnty = num-entries( v-inform ) - 4
     1148     .
     1149     if v-idx-field-qnty < 2 then do:
     1150       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1151     end.
     1152     assign
     1153       v-srch-main   = "where":U
     1154       v-word-link   = "":U
     1155       v-av-chip-num = false
     1156       v-delim-list  = "":U
     1157     .
     1158     do v-ind = 1 to v-idx-field-qnty by 2
     1159     on error undo, return error
     1160     :
     1161       assign
     1162         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1163         fh                = p-hst-handle:buffer-field( v-field-name )
     1164         fh-main           = h-main-buf:buffer-field( v-field-name )
     1165         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1166         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1167       .
     1168       if fh:data-type ="character":U then do:
     1169         assign
     1170           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1171         .
     1172       end.
     1173       else do:
     1174         assign
     1175           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1176         .
     1177       end.
     1178       if v-delim-list = "":U then do:
     1179         assign
     1180           v-delim-list = ",":U
     1181         .
     1182       end.
     1183       if v-word-link = "":U then do:
     1184         assign
     1185           v-word-link = "and":U
     1186         .
     1187       end.
     1188     end.
     1189     assign
     1190       v-delim-list  = "":U
     1191     .
     1192     do v-ind = 1 to h-main-buf:num-fields
     1193     on error undo, return error
     1194     :
     1195       assign
     1196         fh-main      = h-main-buf:buffer-field( v-ind )
     1197         v-field-name = fh-main:name
     1198       .
     1199         assign
     1200           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1201         .
     1202         if v-delim-list = "":U then do:
     1203           assign
     1204             v-delim-list = ",":U
     1205           .
     1206         end.
     1207     end.
     1208     assign
     1209       v-inform = p-hst-handle:index-information(1)
     1210       v-ind    = 2
     1211     .
     1212     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1213     on error undo, return error
     1214     :
     1215       assign
     1216         v-inform = p-hst-handle:index-information( v-ind )
     1217         v-ind    = v-ind + 1
     1218       .
     1219     end.
     1220     if v-inform = ?
     1221       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1222       or entry( 3, v-inform, ",":U ) <> "1":U
     1223     then do:
     1224       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1225     end.
     1226     assign
     1227       v-idx-field-qnty = num-entries( v-inform ) - 4
     1228     .
     1229     if v-idx-field-qnty < 2 then do:
     1230       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1231     end.
     1232     assign
     1233       v-search-exp  = "where":U
     1234       v-word-link   = "":U
     1235       v-av-chip-num = false
     1236     .
     1237     do v-ind = 1 to v-idx-field-qnty by 2
     1238     on error undo, return error
     1239     :
     1240       assign
     1241         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1242         fh           = p-hst-handle:buffer-field( v-field-name )
     1243         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1244       .
     1245       if v-field-name = "chip-num":U then do:
     1246         assign
     1247           v-search-exp  = substitute( "&1 >", v-search-exp )
     1248           v-av-chip-num = true
     1249         .
     1250       end.
     1251       else do:
     1252         assign
     1253           v-search-exp = substitute( "&1 =", v-search-exp )
     1254         .
     1255       end.
     1256       if fh:data-type ="character":U then do:
     1257         assign
     1258           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1259         .
     1260       end.
     1261       else do:
     1262         assign
     1263           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1264         .
     1265       end.
     1266       if v-word-link = "":U then do:
     1267         assign
     1268           v-word-link = "and":U
     1269         .
     1270       end.
     1271     end.
     1272     if v-av-chip-num = false then do:
     1273       message
     1274         vss-workfile vss-revision vss-description skip
     1275         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1276         "Использование данной процедуры невозможно!" skip
     1277         view-as alert-box error .
     1278       return error .
     1279     end.
     1280     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1281     if not h-new-buf:available then do:
     1282       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1283       if not h-main-buf:available then do:
     1284         assign
     1285           h-for-comp = ?
     1286         .
     1287       end.
     1288       else do:
     1289         assign
     1290           h-for-comp = h-main-buf
     1291         .
     1292       end.
     1293     end.
     1294     else do:
     1295       assign
     1296         h-for-comp = h-new-buf
     1297       .
     1298     end.
     1299     assign
     1300       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1301     .
     1302     do v-ind = 1 to v-num-entries
     1303     on error undo, return error return-value
     1304     :
     1305       assign
     1306         v-field-name = entry( v-ind, v-main-fld-lst )
     1307         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1308         v-old-value  = fh-old:buffer-value()
     1309         v-label      = trim( fh-old:label )
     1310       .
     1311       if ( trim( p-field-list ) <> "":U
     1312            and lookup( v-field-name, p-field-list ) > 0
     1313          )
     1314          or trim( p-field-list ) = "":U
     1315       then do:
     1316         if h-for-comp <> ? then do:
     1317           assign
     1318             fh-new      = h-for-comp:buffer-field( v-field-name )
     1319             v-new-value = fh-new:buffer-value()
     1320           .
     1321         end.
     1322         else do:
     1323           assign
     1324             v-new-value = "":U
     1325           .
     1326         end.
     1327         if v-old-value <> v-new-value
     1328         then do:
     1329           create temp-changes.
     1330           assign
     1331             temp-changes.t_name = p-main-table
     1332             temp-changes.f_name = v-field-name
     1333             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1334             temp-changes.v_old  = trim( v-old-value )
     1335             temp-changes.v_new  = trim( v-new-value )
     1336             temp-changes.num_   = 0
     1337             temp-changes.fNotChange = v-old-value eq v-new-value
     1338           .
     1339         end.
     1340       end.
     1341     end.
     1342     assign
     1343       v-num-entries = num-entries( p-label-form, chr(8) )
     1344     .
     1345     do v-ind = 1 to v-num-entries
     1346     on error undo, return error return-value
     1347     :
     1348       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1349         assign
     1350           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1351           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1352           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1353         .
     1354         find first temp-changes
     1355           where temp-changes.f_name = v-field-name
     1356           no-error .
     1357         if available temp-changes then do:
     1358           if trim( v-field-lvl ) <> "":U then do:
     1359             assign
     1360               temp-changes.l_name = v-field-lvl
     1361             .
     1362           end.
     1363           if trim( v-field-form ) <> "":U then do:
     1364             assign
     1365               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1366             .
     1367             if h-for-comp <> ? then do:
     1368               assign
     1369                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1370               .
     1371             end.
     1372           end.
     1373         end.
     1374       end.
     1375       else do:
     1376         message
     1377           vss-workfile vss-revision vss-description skip
     1378           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1379           substitute( "список для поля '&1': '&2'"
     1380                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1381                       ,entry( v-ind, p-label-form, chr(8) )
     1382                     ) skip
     1383           substitute( "полный список: &2", p-label-form ) skip
     1384           view-as alert-box error .
     1385       end.
     1386     end.
     1387     delete object h-new-buf .
     1388     delete object h-main-buf .
     1389   END PROCEDURE.
     1390   FUNCTION get-action RETURNS CHARACTER
     1391     (  p-action as integer )  FORWARD.
     1392   DEFINE BUTTON B-Help
     1393        LABEL "Помо&щь"
     1394        SIZE 3 BY 1
     1395        BGCOLOR 8 .
     1396   DEFINE BUTTON B-mark
     1397        LABEL "&*"
     1398        SIZE 3 BY 1.
     1399   DEFINE BUTTON b-quit AUTO-END-KEY
     1400        LABEL "&Выход"
     1401        SIZE 10 BY 1
     1402        BGCOLOR 8 .
     1403   DEFINE BUTTON B-sch
     1404        LABEL "&Фильтр"
     1405        SIZE 3 BY 1.
     1406   DEFINE BUTTON b-sel AUTO-GO
     1407        LABEL "Вы&бор"
     1408        SIZE 10 BY 1.
     1409   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1410        VIEW-AS FILL-IN
     1411        SIZE 9 BY 1
     1412        FGCOLOR 4  NO-UNDO.
     1413   DEFINE VARIABLE v-full-name-new AS CHARACTER FORMAT "X(256)":U
     1414        LABEL "Стало"
     1415        VIEW-AS FILL-IN
     1416        SIZE 91 BY 1 NO-UNDO.
     1417   DEFINE VARIABLE v-full-name-old AS CHARACTER FORMAT "X(256)":U
     1418        LABEL "Было"
     1419        VIEW-AS FILL-IN
     1420        SIZE 91 BY 1 NO-UNDO.
     1421   DEFINE QUERY br-c-fgg-hist FOR
     1422         X_cfgg-hist SCROLLING.
     1423   DEFINE QUERY BR-changes FOR
     1424         temp-changes SCROLLING.
     1425   DEFINE BROWSE br-c-fgg-hist
     1426     QUERY br-c-fgg-hist DISPLAY
     1427         mark-string( recid(X_cfgg-hist), v-rid-list ) COLUMN-LABEL "*" FORMAT "X(1)":U
     1428         usrfulnf(X_cfgg-hist.corr-user-name) FORMAT "X(18)":U
     1429         X_cfgg-hist.corr-date COLUMN-LABEL "Дата корр." FORMAT "99/99/9999":U
     1430         X_cfgg-hist.corr-user-db-num FORMAT ">>>>9":U
     1431         X_cfgg-hist.node-code FORMAT "->,>>>,>>9":U
     1432         entry (lookup (X_cfgg-hist.subject, 'fbr-gds-grp,fbr-gds-grp-attr':U), 'Группа блюд,Атр-т группы блюд':U) COLUMN-LABEL "Предмет изменений" FORMAT "X(32)":U
     1433         get-action(X_cfgg-hist.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1434         string(X_cfgg-hist.corr-time, "HH:MM") COLUMN-LABEL "Время!корр" FORMAT "X(5)":U
     1435               WIDTH 6
     1436         if X_cfgg-hist.subject <> 'fbr-gds-grp':U and X_cfgg-hist.obj-code > 0 then
     1437   (X_cfgg-hist.obj-type + string(X_cfgg-hist.obj-code)) else '':U COLUMN-LABEL "Объект" FORMAT "X(9)":U
     1438               WIDTH 10
     1439       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.25.
     1440   DEFINE BROWSE BR-changes
     1441     QUERY BR-changes DISPLAY
     1442         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1443   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1444   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1445       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 5.25.
     1446   DEFINE FRAME Dialog-Frame
     1447        b-quit AT ROW 1 COL 1
     1448        B-mark AT ROW 1 COL 11
     1449        b-sel AT ROW 1 COL 14
     1450        B-sch AT ROW 1 COL 92
     1451        B-Help AT ROW 1 COL 95
     1452        mark-num AT ROW 1.92 COL 9 COLON-ALIGNED NO-LABEL
     1453        br-c-fgg-hist AT ROW 3 COL 1
     1454        BR-changes AT ROW 14.5 COL 1
     1455        v-full-name-old AT ROW 20 COL 2
     1456        v-full-name-new AT ROW 21 COL 1
     1457        SPACE(0.24) SKIP(0.04)
     1458       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1459            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1460            TITLE "Справочник истории групп блюд"
     1461            CANCEL-BUTTON b-quit.
     1462   ASSIGN
     1463          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1464          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1465   ON GO OF FRAME Dialog-Frame
     1466   DO:
     1467     p-rid-list = v-rid-list.
     1468   END.
     1469   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1470   DO:
     1471     APPLY "END-ERROR":U TO SELF.
     1472   END.
     1473   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1474   DO:
     1475   define variable g#log as logical no-undo .
     1476   if not available X_cfgg-hist then return no-apply.
     1477   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1478   define variable v-str-recid13 as character no-undo .
     1479   define variable v-num-entry13 as integer   no-undo .
     1480   assign
     1481     v-str-recid13 = trim( string( recid( X_cfgg-hist ) , "->>>>>>>>>>>9":U ) )
     1482     v-num-entry13 = lookup( v-str-recid13 , v-rid-list )
     1483   .
     1484   if v-num-entry13 > 0 then do:
     1485     assign
     1486       entry( v-num-entry13, v-rid-list ) = "":U
     1487       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1488     .
     1489   end.
     1490   else do:
     1491     assign
     1492       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid13
     1493     .
     1494   end.
     1495     g#log = br-c-fgg-hist :refresh( )  in frame Dialog-Frame.
     1496     if not can-do ("MOUSE-SELECT-DBLCLICK,Return", last-event:function) then do:
     1497             g#log = br-c-fgg-hist:select-next-row () in frame Dialog-Frame.
     1498             apply "value-changed" to br-c-fgg-hist in frame Dialog-Frame.
     1499     end.
     1500     if num-entries (v-rid-list) = 0 then
     1501         hide mark-num in frame Dialog-Frame.
     1502     else
     1503     disp num-entries (v-rid-list) @ mark-num
     1504     with frame Dialog-Frame.
     1505     apply "entry" to br-c-fgg-hist in frame Dialog-Frame.
     1506   END.
     1507   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1508   DO:
     1509     run proc-b-sch in this-procedure no-error.
     1510     if error-status:error then return no-apply.
     1511   END.
     1512   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1513   DO:
     1514       if ( available X_cfgg-hist ) AND ( v-rid-list = "" ) then
     1515           v-rid-list = string( recid( X_cfgg-hist ) ) .
     1516   END.
     1517   ON RETURN OF br-c-fgg-hist IN FRAME Dialog-Frame
     1518   DO:
     1519         apply "DEFAULT-ACTION":U to self.
     1520   END.
     1521   ON VALUE-CHANGED OF br-c-fgg-hist IN FRAME Dialog-Frame
     1522   DO:
     1523     run proc-view-changes in this-procedure no-error.
     1524   END.
     1525   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1526   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1527   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1528   on help of frame Dialog-Frame
     1529   do:
     1530     run gbl/app_help.p
     1531       (input this-procedure :file-name
     1532       ,input ''
     1533       ,input ?
     1534       ) no-error.
     1535     if error-status :error then do:
     1536       message
     1537         "Ошибка при вызове помощи"
     1538         error-status :get-message(1)
     1539         view-as alert-box .
     1540     end.
     1541   end.
     1542   run minbtn-set in this-procedure .
     1543   on choose of b-help in frame Dialog-Frame
     1544   do:
     1545     apply "help":u to frame Dialog-Frame .
     1546   end.
     1547   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1548   procedure minbtn-set :
     1549       do
     1550           on error undo, return error return-value
     1551           :
     1552           define variable ii              as integer       no-undo .
     1553           define variable fh              as widget-handle no-undo .
     1554           define variable hh              as widget-handle no-undo .
     1555           define variable v-h             as handle        extent 4 no-undo .
     1556           define variable v-name-button   as character     no-undo .
     1557           define variable v-help-old-x    as decimal       no-undo .
     1558           define variable v-help-old-y    as decimal       no-undo .
     1559           define variable v-help-old-size as decimal       no-undo .
     1560           define variable v-frame-width   as decimal       no-undo .
     1561           define variable jj              as integer       no-undo .
     1562           do
     1563               on error undo, return error
     1564               :
     1565               assign
     1566                   v-frame-width = frame Dialog-Frame:width - 0.3
     1567                   fh            = frame Dialog-Frame:first-child
     1568                   hh            = fh:first-child
     1569                   ii            = 1
     1570                   .
     1571               do while valid-handle(hh):
     1572                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1573                   do:
     1574                       case lc(hh:name) :
     1575                           when "b-help" then
     1576                               do:
     1577                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1578                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1579                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1580                                   hh:TOOLTIP = "Помощь" .
     1581                                   v-help-old-x = hh:column .
     1582                                   v-help-old-y = hh:row    .
     1583                                   v-help-old-size = hh:width .
     1584                                   hh:width-chars = 2.5 .
     1585                               end.
     1586                           when "b-print" then
     1587                               do:
     1588                                   hh:load-image("cmp/b-print.bmp":u) .
     1589                                   hh:TOOLTIP = "Печать" .
     1590                                   v-h[ii] = hh:handle .
     1591                                   ii = ii + 1 .
     1592                                   hh:width-chars = 3 .
     1593                               end.
     1594                           when "b-history" or
     1595                           when "b-hist" then
     1596                               do:
     1597                                   hh:load-image("cmp/b-hist.bmp":u) .
     1598                                   hh:TOOLTIP = "История" .
     1599                                   v-h[ii] = hh:handle .
     1600                                   ii = ii + 1 .
     1601                                   hh:width-chars = 3 .
     1602                               end.
     1603                           when "b-sch" then
     1604                               do:
     1605                                   hh:load-image("cmp/b-sch.bmp":u) .
     1606                                   hh:TOOLTIP = "Установка Фильтра" .
     1607                                   v-h[ii] = hh:handle .
     1608                                   ii = ii + 1 .
     1609                                   hh:width-chars = 3 .
     1610                               end.
     1611                           when "b-hist-user" then
     1612                               do:
     1613                                   hh:load-image("cmp/b-hist.bmp":u) .
     1614                                   hh:TOOLTIP = "История пользователя" .
     1615                                   ii = ii + 1 .
     1616                               end.
     1617                       end case.
     1618                   end.
     1619                   hh = hh:next-sibling.
     1620               end.
     1621               b-help:column = v-frame-width - b-help:width-chars.
     1622               jj = 0.
     1623               repeat ii = 4 to 1 by -1 :
     1624                   if valid-handle (v-h[ii] ) then
     1625                   do:
     1626                       jj  = jj + 1 .
     1627                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1628                       v-h[ii]:row    = v-help-old-y .
     1629                   end.
     1630               end.
     1631           end.
     1632       end.
     1633   end procedure.
     1634   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1635   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1636   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1637   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1638   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1639   define variable v-diasize-current-frame-height as decimal   no-undo .
     1640   define variable v-diasize-change-size          as logical   no-undo .
     1641   define variable v-diasize-resize-button        as handle    no-undo .
     1642   define variable v-diasize-wndmax               as logical   no-undo .
     1643   define variable v-diasize-wndstore             as logical   no-undo .
     1644   define variable v-diasize-proc-name            as character no-undo .
     1645   define variable v-diasize-browse-handle        as handle    no-undo .
     1646   define variable v-diasize-browse-number        as integer   no-undo .
     1647   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1648   define temp-table temp-diasize-handle no-undo
     1649     field handle-value  as handle
     1650     field save-position as decimal
     1651     index xpk is primary unique handle-value
     1652     .
     1653   define temp-table temp-browse-handle no-undo
     1654     field browse-type   as character
     1655     field browse-number as integer
     1656     field browse-handle as handle
     1657     field original-size as decimal
     1658     index xpk is primary unique browse-type browse-number
     1659     index xie browse-type browse-handle
     1660   .
     1661   procedure diasize_change-height :
     1662     define input  parameter p-change-value  as decimal   no-undo .
     1663     define input  parameter p-move-resize   as logical   no-undo .
     1664     define variable v-field-group-handle    as handle    no-undo .
     1665     define variable v-object-handle         as handle    no-undo .
     1666     define variable v-frame-height          as decimal   no-undo .
     1667     define variable v-frame-virtual-height  as decimal   no-undo .
     1668     define variable v-browse-height         as decimal   no-undo .
     1669     define variable v-window-height         as decimal   no-undo .
     1670     define variable v-window-virtual-height as decimal   no-undo .
     1671     define variable v-change-sign           as integer   no-undo .
     1672     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1673     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1674     if p-change-value > 0
     1675     then do:
     1676       if frame Dialog-Frame :height + p-change-value
     1677           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1678       then do:
     1679         assign
     1680           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1681                           - (frame Dialog-Frame :height-chars)
     1682         .
     1683         if p-change-value <= 0
     1684         then do:
     1685           run diasize_position-resize-button in this-procedure .
     1686           return .
     1687         end.
     1688       end.
     1689     end.
     1690     if p-change-value < 0
     1691     then do:
     1692       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1693       then do:
     1694         assign
     1695           p-change-value = v-diasize-orig-frame-height
     1696                          - (frame Dialog-Frame :height-chars)
     1697         .
     1698         if p-change-value >= 0
     1699         then do:
     1700           run diasize_position-resize-button in this-procedure .
     1701           return .
     1702         end.
     1703       end.
     1704     end.
     1705     if p-change-value >= 0
     1706     then do:
     1707       assign
     1708         v-change-sign = 1
     1709       .
     1710     end.
     1711     else do:
     1712       assign
     1713         v-change-sign = -1
     1714       .
     1715     end.
     1716     assign
     1717       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1718     .
     1719     if p-change-value = 0
     1720     then do:
     1721       run diasize_position-resize-button in this-procedure .
     1722       return .
     1723     end.
     1724     move_block:
     1725     do
     1726     on error undo move_block, retry move_block
     1727     :
     1728       if retry
     1729       then do:
     1730         do
     1731         on error undo move_block, leave move_block
     1732         :
     1733           if p-change-value > 0
     1734           then do:
     1735             for each buf_temp-diasize-handle
     1736             on error undo, next
     1737             :
     1738               assign
     1739                 v-object-handle = buf_temp-diasize-handle.handle-value
     1740               .
     1741               if v-object-handle <> v-diasize-resize-button
     1742               then do:
     1743                 assign
     1744                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1745                 .
     1746               end.
     1747             end.
     1748             assign
     1749               v-diasize-browse-handle :height = v-browse-height
     1750             .
     1751             for each buf_temp-browse-handle
     1752               where buf_temp-browse-handle.browse-type = 'height':u
     1753             on error undo, next
     1754             :
     1755               assign
     1756                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1757               .
     1758             end.
     1759             assign
     1760               frame Dialog-Frame :height = v-frame-height
     1761             .
     1762             if frame Dialog-Frame :scrollable = true
     1763             then do:
     1764               assign
     1765                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1766               .
     1767             end.
     1768             run diasize_position-resize-button in this-procedure .
     1769           end.
     1770           else do:
     1771             if frame Dialog-Frame :scrollable = true
     1772             then do:
     1773               assign
     1774                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1775               .
     1776             end.
     1777             assign
     1778               frame Dialog-Frame :height = v-frame-height
     1779             .
     1780             assign
     1781               v-diasize-browse-handle :height = v-browse-height
     1782             .
     1783             for each buf_temp-browse-handle
     1784               where buf_temp-browse-handle.browse-type = 'height':u
     1785             on error undo, next
     1786             :
     1787               assign
     1788                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1789               .
     1790             end.
     1791             for each buf_temp-diasize-handle
     1792             on error undo, next
     1793             :
     1794               assign
     1795                 v-object-handle = buf_temp-diasize-handle.handle-value
     1796               .
     1797               if v-object-handle <> v-diasize-resize-button
     1798               then do:
     1799                 assign
     1800                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1801                 .
     1802               end.
     1803             end.
     1804             run diasize_position-resize-button in this-procedure .
     1805           end.
     1806           assign
     1807             v-diasize-change-size = false
     1808           .
     1809           leave move_block .
     1810         end.
     1811       end.
     1812       assign
     1813         v-diasize-need-full-display = true
     1814       .
     1815       if v-diasize-change-size = false
     1816       then do:
     1817         assign
     1818           v-diasize-change-size = true
     1819         .
     1820       end.
     1821       else do:
     1822         return .
     1823       end.
     1824       assign
     1825         v-frame-height = frame Dialog-Frame :height
     1826         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1827         v-browse-height = v-diasize-browse-handle :height
     1828       .
     1829       for each buf_temp-browse-handle
     1830         where buf_temp-browse-handle.browse-type = 'height':u
     1831       :
     1832         assign
     1833           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1834         .
     1835       end.
     1836       for each buf_temp-diasize-handle
     1837       :
     1838         delete buf_temp-diasize-handle .
     1839       end.
     1840       assign
     1841         v-field-group-handle = frame Dialog-Frame :first-child
     1842       .
     1843       do while valid-handle(v-field-group-handle)
     1844       :
     1845         assign
     1846           v-object-handle = v-field-group-handle :first-child
     1847         .
     1848         do while valid-handle(v-object-handle)
     1849         :
     1850           if  v-object-handle <> v-diasize-browse-handle :handle
     1851           and can-query(v-object-handle, "row")
     1852           and can-query(v-object-handle, "height")
     1853           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1854           then do:
     1855             find first buf_temp-browse-handle
     1856               where buf_temp-browse-handle.browse-type   = 'height':u
     1857                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1858               no-error .
     1859             if available buf_temp-browse-handle
     1860             then do:
     1861             end.
     1862             else do:
     1863               create buf_temp-diasize-handle .
     1864               assign
     1865                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1866                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1867               .
     1868             end.
     1869           end.
     1870           assign
     1871             v-object-handle = v-object-handle :next-sibling
     1872           .
     1873         end.
     1874         assign
     1875           v-field-group-handle = v-field-group-handle :next-sibling
     1876         .
     1877       end.
     1878       do with frame Dialog-Frame
     1879       :
     1880         hide v-diasize-resize-button .
     1881         assign
     1882           v-diasize-resize-button :row    = 1
     1883           v-diasize-resize-button :column = 1
     1884         .
     1885       end.
     1886       if p-change-value > 0
     1887       then do:
     1888         if frame Dialog-Frame :scrollable = true
     1889         then do:
     1890           assign
     1891             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1892             no-error .
     1893           if error-status :error
     1894           or error-status :get-message(1) <> ""
     1895           then do:
     1896             undo move_block, retry move_block .
     1897           end.
     1898         end.
     1899         assign
     1900           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1901           no-error .
     1902         if error-status :error
     1903         or error-status :get-message(1) <> ""
     1904         then do:
     1905           undo move_block, retry move_block .
     1906         end.
     1907         assign
     1908           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1909           no-error .
     1910         if error-status :error
     1911         or error-status :get-message(1) <> ""
     1912         then do:
     1913           undo move_block, retry move_block .
     1914         end.
     1915         for each buf_temp-browse-handle
     1916           where buf_temp-browse-handle.browse-type = 'height':u
     1917         on error undo move_block, retry move_block
     1918         :
     1919           assign
     1920             buf_temp-browse-handle.browse-handle :height
     1921               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1922             no-error .
     1923           if error-status :error
     1924           or error-status :get-message(1) <> ""
     1925           then do:
     1926             undo move_block, retry move_block .
     1927           end.
     1928         end.
     1929         for each buf_temp-diasize-handle
     1930         on error undo move_block, retry move_block
     1931         :
     1932           assign
     1933             v-object-handle = buf_temp-diasize-handle.handle-value
     1934           .
     1935           if v-object-handle <> v-diasize-resize-button
     1936           then do:
     1937             assign
     1938               v-object-handle :row = v-object-handle :row + p-change-value
     1939               no-error .
     1940             if error-status :error
     1941             or error-status :get-message(1) <> ""
     1942             then do:
     1943               undo move_block, retry move_block .
     1944             end.
     1945           end.
     1946         end.
     1947       end.
     1948       else do:
     1949         for each buf_temp-diasize-handle
     1950         on error undo move_block, retry move_block
     1951         :
     1952           assign
     1953             v-object-handle = buf_temp-diasize-handle.handle-value
     1954           .
     1955           if v-object-handle <> v-diasize-resize-button
     1956           then do:
     1957             assign
     1958               v-object-handle :row = v-object-handle :row + p-change-value
     1959               no-error .
     1960             if error-status :error
     1961             or error-status :get-message(1) <> ""
     1962             then do:
     1963               undo move_block, retry move_block .
     1964             end.
     1965           end.
     1966         end.
     1967         assign
     1968           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1969           no-error .
     1970         if error-status :error
     1971         or error-status :get-message(1) <> ""
     1972         then do:
     1973           undo move_block, retry move_block .
     1974         end.
     1975         for each buf_temp-browse-handle
     1976           where buf_temp-browse-handle.browse-type = 'height':u
     1977         on error undo move_block, retry move_block
     1978         :
     1979           assign
     1980             buf_temp-browse-handle.browse-handle :height
     1981               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1982             no-error .
     1983           if error-status :error
     1984           or error-status :get-message(1) <> ""
     1985           then do:
     1986             undo move_block, retry move_block .
     1987           end.
     1988         end.
     1989         assign
     1990           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1991           no-error .
     1992         if error-status :error
     1993         or error-status :get-message(1) <> ""
     1994         then do:
     1995           undo move_block, retry move_block .
     1996         end.
     1997         if frame Dialog-Frame :scrollable = true
     1998         then do:
     1999           assign
     2000             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2001             no-error .
     2002           if error-status :error
     2003           or error-status :get-message(1) <> ""
     2004           then do:
     2005             undo move_block, retry move_block .
     2006           end.
     2007         end.
     2008       end.
     2009       if p-move-resize = true
     2010       then do:
     2011         run diasize_position-resize-button in this-procedure .
     2012       end.
     2013       if v-diasize-wndstore = true
     2014       then do:
     2015         if connected("ub") = true
     2016         then do:
     2017           define variable v-cntxt-db-num        as integer   no-undo .
     2018           define variable v-cntxt-userid        as character no-undo .
     2019           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2020                                             , OUTPUT v-cntxt-userid
     2021                                             ) .
     2022           run gbl/wndsizew.p
     2023             (input  v-cntxt-db-num
     2024             ,input  v-cntxt-userid
     2025             ,input  v-diasize-proc-name
     2026             ,input  'height':u
     2027             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2028             ) .
     2029         end.
     2030       end.
     2031     end.
     2032     assign
     2033       v-diasize-change-size = false
     2034     .
     2035   end procedure.
     2036   procedure diasize_set-height :
     2037     define input  parameter p-new-height  as decimal   no-undo .
     2038     define input  parameter p-move-resize as logical   no-undo .
     2039     do
     2040     on error undo, return error return-value
     2041     :
     2042       run diasize_change-height in this-procedure
     2043         (input  (p-new-height - frame Dialog-Frame :height)
     2044         ,input  p-move-resize
     2045         ) .
     2046     end.
     2047   end procedure.
     2048   procedure diasize_change-width :
     2049     define input  parameter p-change-value as decimal   no-undo .
     2050     define input  parameter p-move-resize  as logical   no-undo .
     2051     define variable v-field-group-handle   as handle    no-undo .
     2052     define variable v-object-handle        as handle    no-undo .
     2053     define variable v-frame-width          as decimal   no-undo .
     2054     define variable v-frame-virtual-width  as decimal   no-undo .
     2055     define variable v-browse-width         as decimal   no-undo .
     2056     define variable v-window-width         as decimal   no-undo .
     2057     define variable v-window-virtual-width as decimal   no-undo .
     2058     define variable v-change-sign          as integer   no-undo .
     2059     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2060     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2061     if p-change-value > 0
     2062     then do:
     2063       if frame Dialog-Frame :width + p-change-value >
     2064           session :width-chars
     2065       then do:
     2066         assign
     2067           p-change-value = session :width-chars - frame Dialog-Frame :width
     2068         .
     2069         if p-change-value <= 0
     2070         then do:
     2071           run diasize_position-resize-button in this-procedure .
     2072           return .
     2073         end.
     2074       end.
     2075     end.
     2076     if p-change-value < 0
     2077     then do:
     2078       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2079       then do:
     2080         assign
     2081           p-change-value = v-diasize-orig-frame-width
     2082                          - frame Dialog-Frame :width
     2083         .
     2084         if p-change-value >= 0
     2085         then do:
     2086           run diasize_position-resize-button in this-procedure .
     2087           return .
     2088         end.
     2089       end.
     2090     end.
     2091     if p-change-value >= 0
     2092     then do:
     2093       assign
     2094         v-change-sign = 1
     2095       .
     2096     end.
     2097     else do:
     2098       assign
     2099         v-change-sign = -1
     2100       .
     2101     end.
     2102     assign
     2103       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2104     .
     2105     if p-change-value = 0
     2106     then do:
     2107       run diasize_position-resize-button in this-procedure .
     2108       return .
     2109     end.
     2110     move_block:
     2111     do
     2112     on error undo move_block, leave move_block
     2113     :
     2114       if retry
     2115       then do:
     2116         do
     2117         on error undo move_block, leave move_block
     2118         :
     2119           if p-change-value > 0
     2120           then do:
     2121             for each buf_temp-diasize-handle
     2122             on error undo, next
     2123             :
     2124               assign
     2125                 v-object-handle = buf_temp-diasize-handle.handle-value
     2126               .
     2127               if v-object-handle <> v-diasize-resize-button
     2128               then do:
     2129                 assign
     2130                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2131                 .
     2132               end.
     2133             end.
     2134             assign
     2135               v-diasize-browse-handle :width = v-browse-width
     2136             .
     2137             for each buf_temp-browse-handle
     2138               where buf_temp-browse-handle.browse-type = 'width':u
     2139             on error undo, next
     2140             :
     2141               assign
     2142                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2143               .
     2144             end.
     2145             assign
     2146               frame Dialog-Frame :width = v-frame-width
     2147             .
     2148             if frame Dialog-Frame :scrollable = true
     2149             then do:
     2150               assign
     2151                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2152               .
     2153             end.
     2154             run diasize_position-resize-button in this-procedure .
     2155           end.
     2156           else do:
     2157             if frame Dialog-Frame :scrollable = true
     2158             then do:
     2159               assign
     2160                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2161               .
     2162             end.
     2163             assign
     2164               frame Dialog-Frame :width = v-frame-width
     2165             .
     2166             for each buf_temp-browse-handle
     2167               where buf_temp-browse-handle.browse-type = 'width':u
     2168             on error undo, next
     2169             :
     2170               assign
     2171                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2172               .
     2173             end.
     2174             assign
     2175               v-diasize-browse-handle :width = v-browse-width
     2176             .
     2177             for each buf_temp-diasize-handle
     2178             on error undo, next
     2179             :
     2180               assign
     2181                 v-object-handle = buf_temp-diasize-handle.handle-value
     2182               .
     2183               if v-object-handle <> v-diasize-resize-button
     2184               then do:
     2185                 assign
     2186                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2187                 .
     2188               end.
     2189             end.
     2190             run diasize_position-resize-button in this-procedure .
     2191           end.
     2192           assign
     2193             v-diasize-change-size = false
     2194           .
     2195           leave move_block .
     2196         end.
     2197       end.
     2198       assign
     2199         v-diasize-need-full-display = true
     2200       .
     2201       if v-diasize-change-size = false
     2202       then do:
     2203         assign
     2204           v-diasize-change-size = true
     2205         .
     2206       end.
     2207       else do:
     2208         return .
     2209       end.
     2210       assign
     2211         v-frame-width = frame Dialog-Frame :width
     2212         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2213         v-browse-width = v-diasize-browse-handle :width
     2214       .
     2215       for each buf_temp-browse-handle
     2216         where buf_temp-browse-handle.browse-type = 'width':u
     2217       :
     2218         assign
     2219           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2220         .
     2221       end.
     2222       for each buf_temp-diasize-handle
     2223       :
     2224         delete buf_temp-diasize-handle .
     2225       end.
     2226       assign
     2227         v-field-group-handle = frame Dialog-Frame :first-child
     2228       .
     2229       do while valid-handle(v-field-group-handle)
     2230       :
     2231         assign
     2232           v-object-handle = v-field-group-handle :first-child
     2233         .
     2234         do while valid-handle(v-object-handle)
     2235         :
     2236           if  v-object-handle <> v-diasize-browse-handle :handle
     2237           and v-object-handle <> v-diasize-resize-button
     2238           and can-query(v-object-handle, "row")
     2239           and can-query(v-object-handle, "height")
     2240           and ( v-object-handle :col + v-object-handle :width
     2241                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2242               )
     2243           then do:
     2244             find first buf_temp-browse-handle
     2245               where buf_temp-browse-handle.browse-type   = 'width':u
     2246                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2247               no-error .
     2248             if available buf_temp-browse-handle
     2249             then do:
     2250             end.
     2251             else do:
     2252               create buf_temp-diasize-handle .
     2253               assign
     2254                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2255                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2256               .
     2257             end.
     2258           end.
     2259           assign
     2260             v-object-handle = v-object-handle :next-sibling
     2261           .
     2262         end.
     2263         assign
     2264           v-field-group-handle = v-field-group-handle :next-sibling
     2265         .
     2266       end.
     2267       do with frame Dialog-Frame
     2268       :
     2269         hide v-diasize-resize-button .
     2270         v-diasize-resize-button :row = 1.
     2271         v-diasize-resize-button :column = 1.
     2272       end.
     2273       if p-change-value > 0
     2274       then do:
     2275         if frame Dialog-Frame :scrollable = true
     2276         then do:
     2277           assign
     2278             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2279             no-error .
     2280           if error-status :error
     2281           or error-status :get-message(1) <> ""
     2282           then do:
     2283             undo move_block, retry move_block.
     2284           end.
     2285         end.
     2286         assign
     2287           frame Dialog-Frame :width = v-frame-width + p-change-value
     2288           no-error .
     2289         if error-status :error
     2290         or error-status :get-message(1) <> ""
     2291         then do:
     2292           undo move_block, retry move_block.
     2293         end.
     2294         assign
     2295           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2296         no-error .
     2297         if error-status :error
     2298         or error-status :get-message(1) <> ""
     2299         then do:
     2300           undo move_block, retry move_block.
     2301         end.
     2302         for each buf_temp-browse-handle
     2303           where buf_temp-browse-handle.browse-type = 'width':u
     2304         on error undo move_block, retry move_block
     2305         :
     2306           assign
     2307             buf_temp-browse-handle.browse-handle :width
     2308               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2309             no-error .
     2310           if error-status :error
     2311           or error-status :get-message(1) <> ""
     2312           then do:
     2313             undo move_block, retry move_block .
     2314           end.
     2315         end.
     2316         for each buf_temp-diasize-handle
     2317         on error undo move_block, retry move_block
     2318         :
     2319           assign
     2320             v-object-handle = buf_temp-diasize-handle.handle-value
     2321           .
     2322           if v-object-handle <> v-diasize-resize-button
     2323           then do:
     2324             assign
     2325               v-object-handle :col = v-object-handle :col + p-change-value
     2326               no-error .
     2327             if error-status :error
     2328             or error-status :get-message(1) <> ""
     2329             then do:
     2330               undo move_block, retry move_block .
     2331             end.
     2332           end.
     2333         end.
     2334       end.
     2335       else do:
     2336         for each buf_temp-diasize-handle
     2337         on error undo move_block, retry move_block
     2338         :
     2339           assign
     2340             v-object-handle = buf_temp-diasize-handle.handle-value
     2341           .
     2342           if v-object-handle <> v-diasize-resize-button
     2343           then do:
     2344             assign
     2345               v-object-handle :col = v-object-handle :col + p-change-value
     2346               no-error .
     2347             if error-status :error
     2348             or error-status :get-message(1) <> ""
     2349             then do:
     2350               undo move_block, retry move_block .
     2351             end.
     2352           end.
     2353         end.
     2354         for each buf_temp-browse-handle
     2355           where buf_temp-browse-handle.browse-type = 'width':u
     2356         on error undo move_block, retry move_block
     2357         :
     2358           assign
     2359             buf_temp-browse-handle.browse-handle :width
     2360               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2361             no-error .
     2362           if error-status :error
     2363           or error-status :get-message(1) <> ""
     2364           then do:
     2365             undo move_block, retry move_block .
     2366           end.
     2367         end.
     2368         assign
     2369           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2370           no-error .
     2371         if error-status :error
     2372         or error-status :get-message(1) <> ""
     2373         then do:
     2374           undo move_block, retry move_block.
     2375         end.
     2376         assign
     2377           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2378         no-error .
     2379         if error-status :error
     2380         or error-status :get-message(1) <> ""
     2381         then do:
     2382           undo move_block, retry move_block.
     2383         end.
     2384         if frame Dialog-Frame :scrollable = true
     2385         then do:
     2386           assign
     2387             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2388           no-error .
     2389           if error-status :error
     2390           or error-status :get-message(1) <> ""
     2391           then do:
     2392             undo move_block, retry move_block.
     2393           end.
     2394         end.
     2395       end.
     2396       if p-move-resize
     2397       then do:
     2398         run diasize_position-resize-button in this-procedure .
     2399       end.
     2400       if v-diasize-wndstore = true
     2401       then do:
     2402         if connected("ub") = true
     2403         then do:
     2404           define variable v-cntxt-db-num        as integer   no-undo .
     2405           define variable v-cntxt-userid        as character no-undo .
     2406           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2407                                             , OUTPUT v-cntxt-userid
     2408                                             ) .
     2409           run gbl/wndsizew.p
     2410             (input  v-cntxt-db-num
     2411             ,input  v-cntxt-userid
     2412             ,input  v-diasize-proc-name
     2413             ,input  'width':u
     2414             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2415             ) .
     2416         end.
     2417       end.
     2418     end.
     2419     assign
     2420       v-diasize-change-size = false
     2421     .
     2422   end procedure.
     2423   procedure diasize_set-width :
     2424     define input  parameter p-new-width  as decimal   no-undo .
     2425     define input  parameter p-move-resize as logical   no-undo .
     2426     do
     2427     on error undo, return error return-value
     2428     :
     2429       run diasize_change-width in this-procedure
     2430         (input  (p-new-width - frame Dialog-Frame :width)
     2431         ,input  p-move-resize
     2432         ) .
     2433     end.
     2434   end procedure.
     2435   procedure diasize_position-resize-button :
     2436     do with frame Dialog-Frame
     2437     :
     2438       hide v-diasize-resize-button .
     2439       assign
     2440         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2441                     - 1
     2442                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2443         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2444                     - 1
     2445                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2446       .
     2447       view v-diasize-resize-button .
     2448     end.
     2449   end procedure.
     2450   on alt-right anywhere
     2451   do:
     2452     run diasize_change-width in this-procedure
     2453       (input 1
     2454       ,input true
     2455       ) .
     2456     return no-apply .
     2457   end.
     2458   on alt-left anywhere
     2459   do:
     2460     run diasize_change-width in this-procedure
     2461       (input -1
     2462       ,input true
     2463       ) .
     2464     return no-apply .
     2465   end.
     2466   on alt-down anywhere
     2467   do:
     2468     run diasize_change-height in this-procedure
     2469       (input 1
     2470       ,input true
     2471       ) .
     2472     return no-apply .
     2473   end.
     2474   on alt-up anywhere
     2475   do:
     2476     run diasize_change-height in this-procedure
     2477       (input -1
     2478       ,input true
     2479       ) .
     2480     return no-apply .
     2481   end.
     2482   on alt-enter of frame Dialog-Frame
     2483   do:
     2484     run diasize_maximize in this-procedure
     2485       (input  ?
     2486       ).
     2487     return no-apply .
     2488   end.
     2489   procedure diasize_end-move :
     2490     do
     2491     on error undo, return error return-value
     2492     :
     2493       define variable v-row-delta as decimal   no-undo .
     2494       define variable v-col-delta as decimal   no-undo .
     2495       define variable v-new-row as decimal   no-undo .
     2496       define variable v-new-col as decimal   no-undo .
     2497       assign
     2498         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2499         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2500       .
     2501       assign
     2502         v-row-delta = v-new-row - frame Dialog-Frame :height
     2503         v-col-delta = v-new-col - frame Dialog-Frame :width
     2504       .
     2505       run diasize_change-height in this-procedure
     2506         (input v-row-delta
     2507         ,input true
     2508         ) .
     2509       run diasize_change-width in this-procedure
     2510         (input v-col-delta
     2511         ,input true
     2512         ) .
     2513     end.
     2514   end procedure.
     2515   procedure diasize_maximize :
     2516     define input  parameter p-action as logical   no-undo .
     2517     do
     2518     on error undo, return error return-value
     2519     :
     2520       if p-action = ?
     2521       then do:
     2522         if v-diasize-need-maximize = true
     2523         then do:
     2524           assign
     2525             p-action = true
     2526           .
     2527         end.
     2528         else do:
     2529           assign
     2530             p-action = false
     2531           .
     2532         end.
     2533       end.
     2534       if p-action = true
     2535       then do:
     2536         run diasize_change-height in this-procedure
     2537           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2538               - frame Dialog-Frame :height-chars
     2539           ,input true
     2540           ) .
     2541         run diasize_change-width in this-procedure
     2542           (input session :width-chars
     2543               - frame Dialog-Frame :width-chars
     2544           ,input true
     2545           ) .
     2546         assign
     2547           v-diasize-need-maximize = false
     2548         .
     2549       end.
     2550       else do:
     2551         run diasize_change-width in this-procedure
     2552           (input v-diasize-orig-frame-width
     2553               - frame Dialog-Frame :width-chars
     2554           ,input true
     2555           ) .
     2556         run diasize_change-height in this-procedure
     2557           (input v-diasize-orig-frame-height
     2558               - frame Dialog-Frame :height-chars
     2559           ,input true
     2560           ) .
     2561         assign
     2562           v-diasize-need-maximize = true
     2563         .
     2564       end.
     2565     end.
     2566   end procedure.
     2567   procedure diasize_restore-orig-size :
     2568     do
     2569     on error undo, return error return-value
     2570     :
     2571       assign
     2572         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2573         v-diasize-current-frame-height = frame Dialog-Frame :height
     2574       .
     2575       run diasize_set-height in this-procedure
     2576         (input  v-diasize-orig-frame-height
     2577         ,input  true
     2578         ) .
     2579       run diasize_set-width in this-procedure
     2580         (input  v-diasize-orig-frame-width
     2581         ,input  true
     2582         ) .
     2583     end.
     2584   end procedure.
     2585   procedure diasize_restore-current-size :
     2586     do
     2587     on error undo, return error return-value
     2588     :
     2589       run diasize_set-height in this-procedure
     2590         (input  v-diasize-current-frame-height
     2591         ,input  true
     2592         ) .
     2593       run diasize_set-width in this-procedure
     2594         (input  v-diasize-current-frame-width
     2595         ,input  true
     2596         ) .
     2597     end.
     2598   end procedure.
     2599   procedure diasize_set-browse-handle :
     2600     define input  parameter p-browse-handle as handle   no-undo .
     2601     define buffer buf_temp-browse-handle for temp-browse-handle .
     2602     do
     2603     on error undo, return error return-value
     2604     :
     2605       assign
     2606         v-diasize-browse-handle = p-browse-handle
     2607       .
     2608       for each buf_temp-browse-handle
     2609       on error undo, return error return-value
     2610       :
     2611         delete buf_temp-browse-handle .
     2612       end.
     2613     end.
     2614   end procedure.
     2615   procedure diasize_add_browse :
     2616     define input  parameter p-browse-type   as character no-undo .
     2617     define input  parameter p-browse-handle as handle    no-undo .
     2618     define buffer buf_temp-browse-handle for temp-browse-handle .
     2619     do
     2620     on error undo, return error return-value
     2621     :
     2622       assign
     2623         v-diasize-browse-number = v-diasize-browse-number + 1
     2624       .
     2625       create buf_temp-browse-handle .
     2626       assign
     2627         buf_temp-browse-handle.browse-type   = p-browse-type
     2628         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2629         buf_temp-browse-handle.browse-handle = p-browse-handle
     2630       .
     2631     end.
     2632   end procedure.
     2633   procedure diasize_init :
     2634     define variable v-default-value    as logical   no-undo .
     2635     define variable v-restore-saved    as logical   no-undo .
     2636     define variable v-resize-value-str as character no-undo .
     2637     do
     2638     on error undo, return error return-value
     2639     :
     2640       do with frame Dialog-Frame
     2641       :
     2642         assign
     2643           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2644           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2645           v-diasize-browse-handle     = browse br-c-fgg-hist :handle
     2646         .
     2647         create button v-diasize-resize-button
     2648         assign
     2649           parent        = frame Dialog-Frame :first-child
     2650           label         = "s"
     2651           height-pixels = 16
     2652           width-pixels  = 16
     2653           visible       = true
     2654           sensitive     = true
     2655           movable       = true
     2656           triggers:
     2657             on end-move persistent run diasize_end-move in this-procedure .
     2658           end triggers.
     2659         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2660         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2661         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2662         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2663         assign
     2664           v-diasize-wndmax = false
     2665         .
     2666         if connected("ub") = true
     2667         then do:
     2668           define variable v-cntxt-db-num        as integer   no-undo .
     2669           define variable v-cntxt-userid        as character no-undo .
     2670           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2671                                             , OUTPUT v-cntxt-userid
     2672                                             ) .
     2673           run gbl/wndpar_r.p
     2674             (input  v-cntxt-db-num
     2675             ,input  v-cntxt-userid
     2676             ,input  'wndmax':U
     2677             ,output v-diasize-wndmax
     2678             ,output v-default-value
     2679             ) .
     2680         end.
     2681         assign
     2682           v-diasize-wndstore = false
     2683         .
     2684         if connected("ub") = true
     2685         then do:
     2686           run gbl/wndpar_r.p
     2687             (input  v-cntxt-db-num
     2688             ,input  v-cntxt-userid
     2689             ,input  'wndstore':U
     2690             ,output v-diasize-wndstore
     2691             ,output v-default-value
     2692             ) .
     2693         end.
     2694         assign
     2695           v-diasize-proc-name = entry(1, program-name(2), '.')
     2696         .
     2697         if v-diasize-wndstore = true
     2698         then do:
     2699           assign
     2700             v-restore-saved = false
     2701           .
     2702           if connected("ub") = true
     2703           then do:
     2704             run gbl/wndsizer.p
     2705               (input  v-cntxt-db-num
     2706               ,input  v-cntxt-userid
     2707               ,input  v-diasize-proc-name
     2708               ,input  'height':u
     2709               ,output v-resize-value-str
     2710               ) .
     2711             if v-resize-value-str <> '':U
     2712             then do:
     2713               run diasize_change-height in this-procedure
     2714                 (input  integer(v-resize-value-str)
     2715                 ,input  true
     2716                 ) .
     2717               assign
     2718                 v-restore-saved = true
     2719               .
     2720             end.
     2721           end.
     2722           if connected("ub") = true
     2723           then do:
     2724             run gbl/wndsizer.p
     2725               (input  v-cntxt-db-num
     2726               ,input  v-cntxt-userid
     2727               ,input  v-diasize-proc-name
     2728               ,input  'width':u
     2729               ,output v-resize-value-str
     2730               ) .
     2731             if v-resize-value-str <> '':U
     2732             then do:
     2733               run diasize_change-width in this-procedure
     2734                 (input  integer(v-resize-value-str)
     2735                 ,input  true
     2736                 ) .
     2737               assign
     2738                 v-restore-saved = true
     2739               .
     2740             end.
     2741           end.
     2742           if v-restore-saved <> true
     2743           then do:
     2744             if v-diasize-wndmax = true
     2745             then do:
     2746               run diasize_maximize in this-procedure
     2747                 (input  true
     2748                 ) .
     2749             end.
     2750           end.
     2751         end.
     2752         else do:
     2753           if v-diasize-wndmax = true
     2754           then do:
     2755             run diasize_maximize in this-procedure
     2756               (input  true
     2757               ) .
     2758           end.
     2759         end.
     2760       end.
     2761     end.
     2762   end procedure.
     2763   procedure diasize_need-full-display :
     2764     define output parameter p-need-full-display as logical   no-undo .
     2765     do
     2766     on error undo, return error return-value
     2767     :
     2768       assign
     2769         p-need-full-display = v-diasize-need-full-display
     2770       .
     2771       assign
     2772         v-diasize-need-full-display = false
     2773       .
     2774     end.
     2775   end procedure.
     2776   procedure get-context :
     2777      define output parameter p-db-num as integer          no-undo.
     2778      define output parameter p-user-id as character        no-undo.
     2779      define variable v-login               as character    no-undo.
     2780      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2781      define buffer buf_user-login  for ub.user-login .
     2782      do
     2783      on error undo, return error
     2784      :
     2785            FIND FIRST buf_sys-ctrl no-lock.
     2786            ASSIGN
     2787               v-login = USERID("ub")
     2788               p-db-num = buf_sys-ctrl.db-num
     2789            .
     2790            FIND FIRST buf_user-login
     2791                 WHERE buf_user-login.db-num = p-db-num
     2792                   AND buf_user-login.user-login = v-login
     2793                 no-lock
     2794                 no-error
     2795                 .
     2796            IF AVAILABLE buf_user-login
     2797            THEN DO:
     2798               assign
     2799                  p-user-id = buf_user-login.user-id
     2800               .
     2801            END.
     2802      end.
     2803   end procedure.
     2804   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2805   on f5 of frame Dialog-Frame anywhere
     2806   do:
     2807     v-doc-rec = recid(X_cfgg-hist). run openbr in this-procedure. reposition br-c-fgg-hist to recid v-doc-rec no-error.
     2808       apply "VALUE-CHANGED" to br-c-fgg-hist.
     2809   end.
     2810   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2811   do:
     2812     br-c-fgg-hist :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2813   end.
     2814   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2815   procedure set-filter-name :
     2816   define input parameter p-filter-name as character no-undo .
     2817     do with frame Dialog-Frame:
     2818       if p-filter-name > "" then do:
     2819         assign
     2820           frame Dialog-Frame:title
     2821             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2822         .
     2823         assign
     2824           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2825         .
     2826       end.
     2827       else do:
     2828         assign
     2829           b-sch :tooltip = ""
     2830         .
     2831       end.
     2832     end.
     2833   end procedure.
     2834   def var sort-labelbr-c-fgg-hist   as character no-undo .
     2835   def var sort-clmnbr-c-fgg-hist    as handle    no-undo .
     2836   def var cur-clmnbr-c-fgg-hist     as handle    no-undo .
     2837   def var cur-clmn-locbr-c-fgg-hist as integer   no-undo .
     2838   def var re-querybr-c-fgg-hist     as logical   initial no no-undo .
     2839   on start-search, ctrl-o of br-c-fgg-hist in frame Dialog-Frame do:
     2840      run sort-brbr-c-fgg-hist
     2841        (input (if available X_cfgg-hist
     2842                then recid(X_cfgg-hist)
     2843                else ?
     2844               )
     2845        ).
     2846   end.
     2847   PROCEDURE sort-brbr-c-fgg-hist :
     2848     define input parameter p-recid as recid no-undo .
     2849     if re-querybr-c-fgg-hist = no then do:
     2850       assign
     2851          cur-clmnbr-c-fgg-hist = br-c-fgg-hist:current-column in frame Dialog-Frame
     2852       .
     2853       if sort-clmnbr-c-fgg-hist <> ? then sort-clmnbr-c-fgg-hist:column-fgcolor = 0.
     2854       if cur-clmnbr-c-fgg-hist = sort-clmnbr-c-fgg-hist then do:
     2855         assign
     2856            sort-labelbr-c-fgg-hist = ""
     2857            sort-clmnbr-c-fgg-hist = ?
     2858         .
     2859        end.
     2860        else do:
     2861          assign
     2862            sort-labelbr-c-fgg-hist = cur-clmnbr-c-fgg-hist:label
     2863            sort-clmnbr-c-fgg-hist  = cur-clmnbr-c-fgg-hist
     2864            sort-clmnbr-c-fgg-hist:column-fgcolor = 4
     2865          .
     2866        end.
     2867      end.
     2868     assign
     2869       cur-clmn-locbr-c-fgg-hist = 1
     2870     .
     2871     def var column-handle as handle no-undo .
     2872     column-handle = br-c-fgg-hist:first-column.
     2873     do while valid-handle(column-handle) :
     2874       if column-handle = cur-clmnbr-c-fgg-hist then do:
     2875         leave .
     2876       end.
     2877       column-handle = column-handle:NEXT-COLUMN.
     2878       assign
     2879         cur-clmn-locbr-c-fgg-hist = cur-clmn-locbr-c-fgg-hist + 1
     2880       .
     2881     end.
     2882     case sort-labelbr-c-fgg-hist:
     2883           when X_cfgg-hist.corr-date:label in browse br-c-fgg-hist then DO:    assign       sort-column-name = "X_cfgg-hist.corr-date"     .     run OpenBr in this-procedure .   . END.
     2884           when X_cfgg-hist.corr-user-db-num:label in browse br-c-fgg-hist then DO:    assign       sort-column-name = "X_cfgg-hist.corr-user-db-num"     .     run OpenBr in this-procedure .   . END.
     2885       otherwise do:
     2886         assign
     2887           sort-column-name = ""
     2888         .
     2889         run OpenBr in this-procedure .
     2890         if sort-labelbr-c-fgg-hist <> "" then do:
     2891           assign
     2892             cur-clmnbr-c-fgg-hist:column-fgcolor = 0
     2893           .
     2894         end.
     2895         assign
     2896           cur-clmn-locbr-c-fgg-hist = ?
     2897         .
     2898       end.
     2899     end case.
     2900     if p-recid <> ? then do:
     2901       reposition br-c-fgg-hist to recid p-recid no-error.
     2902       apply "value-changed" to br-c-fgg-hist in frame Dialog-Frame.
     2903     end.
     2904     apply "entry" to br-c-fgg-hist in frame Dialog-Frame.
     2905   END PROCEDURE.
     2906   procedure re-open-query-srt-clmnbr-c-fgg-hist:
     2907   if cur-clmnbr-c-fgg-hist = ? then do:
     2908      run OpenBr in this-procedure .
     2909   end.
     2910   else do:
     2911      assign re-querybr-c-fgg-hist = yes.
     2912      run sort-brbr-c-fgg-hist
     2913        (input (if available X_cfgg-hist
     2914                then recid(X_cfgg-hist)
     2915                else ?
     2916               )
     2917        ).
     2918      assign re-querybr-c-fgg-hist = no.
     2919   end.
     2920   end.
     2921   MAIN-BLOCK:
     2922   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2923      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2924      if LOOKUP(p-mode, (
     2925                         'все':U  + chr(4) +
     2926                         'объект':U  + chr(4) +
     2927                         "one":U  + chr(4) +
     2928                        "fbr-gds-grp-attr":U),
     2929                        chr(4)
     2930                        ) > 0
     2931      THEN DO:
     2932        find first X_fbr-gds-grp no-lock where
     2933                   X_fbr-gds-grp.obj-type  = p-obj-type
     2934               AND X_fbr-gds-grp.obj-code = p-obj-code
     2935               AND X_fbr-gds-grp.node-code = p-node-code
     2936               no-error .
     2937        if not available X_fbr-gds-grp
     2938        and not p-is-del
     2939        then do:
     2940           message
     2941           vss-workfile vss-revision vss-description skip
     2942           "Неверное значение параметра p-node-code и/или p-is-del" p-node-code p-is-del
     2943           view-as alert-box ERROR.
     2944           return.
     2945        end.
     2946      if LOOKUP(p-mode,
     2947                        'объект':U ) > 0
     2948      THEN DO:
     2949       find first X_clients-obj no-lock where
     2950                 X_clients-obj.obj-type = p-obj-type
     2951             AND X_clients-obj.obj-code = p-obj-code no-error .
     2952       if not available X_clients-obj then do:
     2953           message
     2954           vss-workfile vss-revision vss-description skip
     2955           "Неверное значение параметров p-obj-type и/или p-obj-code" p-obj-type p-obj-code
     2956           view-as alert-box ERROR.
     2957           return.
     2958       end.
     2959      end.
     2960      if lookup(p-mode, "fbr-gds-grp-attr") > 0 then do:
     2961         if lookup(p-attr-code, '':u) = 0 then do:
     2962             message
     2963             vss-workfile vss-revision vss-description skip
     2964             "Неверное значение параметра p-attr-code" p-attr-code
     2965             view-as alert-box ERROR.
     2966             return.
     2967         end.
     2968      end.
     2969     END.
     2970     else do:
     2971         message vss-workfile vss-revision vss-description skip
     2972         "Неверный вызов - p-mode=" p-mode
     2973         view-as alert-box ERROR.
     2974         return.
     2975     end.
     2976     v-rid-list = p-rid-list.
     2977     RUN MyEnable.
     2978     HIDE mark-num in frame Dialog-Frame .
     2979     run OpenBR in this-procedure.
     2980     run diasize_add_browse in this-procedure
     2981       (input  'width':u
     2982       ,input  browse br-changes :handle
     2983       ) .
     2984     run diasize_add_browse in this-procedure
     2985       (input  'width':u
     2986       ,input  v-full-name-old:handle
     2987       ) .
     2988     run diasize_add_browse in this-procedure
     2989       (input  'width':u
     2990       ,input  v-full-name-new:handle
     2991       ) .
     2992       run diasize_init in this-procedure .
     2993     WAIT-FOR GO OF FRAME Dialog-Frame.
     2994   END.
     2995   RUN disable_UI.
     2996   PROCEDURE disable_UI :
     2997     HIDE FRAME Dialog-Frame.
     2998   END PROCEDURE.
     2999   PROCEDURE enable_UI :
     3000     DISPLAY mark-num v-full-name-old v-full-name-new
     3001         WITH FRAME Dialog-Frame.
     3002     ENABLE b-quit B-mark b-sel B-sch B-Help mark-num br-c-fgg-hist BR-changes
     3003            v-full-name-old v-full-name-new
     3004         WITH FRAME Dialog-Frame.
     3005     VIEW FRAME Dialog-Frame.
     3006     OPEN QUERY br-c-fgg-hist FOR EACH X_cfgg-hist NO-LOCK.
     3007   END PROCEDURE.
     3008   PROCEDURE MyEnable :
     3009   br-changes:title in frame Dialog-Frame  = "":U.
     3010   assign
     3011   temp-changes.l_name:resizable in browse br-changes = true
     3012   temp-changes.v_old:resizable in browse br-changes = true
     3013   temp-changes.v_new:resizable in browse br-changes = true
     3014   temp-changes.l_name:width in browse br-changes = 30
     3015   temp-changes.v_old:width in browse br-changes = 40
     3016   temp-changes.v_new:width in browse br-changes = 40
     3017   .
     3018   DISPLAY
     3019   mark-num
     3020   br-changes
     3021   WITH FRAME Dialog-Frame.
     3022   ENABLE
     3023   B-quit
     3024   B-mark when lookup('b-mark':U, bttns) >0
     3025   B-sel when lookup('b-sel':U, bttns) >0
     3026   B-sch
     3027   B-Help
     3028   br-c-fgg-hist
     3029   br-changes
     3030   mark-num
     3031   WITH FRAME Dialog-Frame.
     3032   VIEW FRAME Dialog-Frame.
     3033   END PROCEDURE.
     3034   PROCEDURE OpenBr :
     3035   define variable l-query-was-opened as logical no-undo .
     3036   run waitfram-show in this-procedure ("Ждите...").
     3037   define variable sort-column-phrase as character no-undo .
     3038   case sort-column-name :
     3039     when "" then do:
     3040       assign
     3041         sort-column-phrase = ""
     3042       .
     3043     end.
     3044     otherwise do:
     3045       assign
     3046         sort-column-phrase = "by " + sort-column-name
     3047       .
     3048     end.
     3049   end case.
     3050   CASE p-mode:
     3051       when 'все':U then do:
     3052           ASSIGN frame Dialog-Frame:TITLE = "Справочник истории групп блюд"
     3053           filter-point = filter-point0 + p-mode
     3054           filter-label = substitute("&1", filter-label0)
     3055           .
     3056   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3057   define variable  l-disable-where-21  as logical   no-undo .
     3058   define variable  l-filter-open-21    as logical   .
     3059   define variable  flt-rec-21       as recid     no-undo .
     3060   define variable  filter-name-21      as character no-undo .
     3061   define variable  where-phrase-21     as character no-undo .
     3062   define variable  sort-phrase-21      as character no-undo .
     3063   define variable  where-phrase-rus-21 as character no-undo .
     3064   define variable  sort-phrase-rus-21  as character no-undo .
     3065     run waitfram-show in this-procedure
     3066       (input "ЖДИТЕ ..."
     3067       ).
     3068   run gbl/flt-get.p
     3069     (input filter-point
     3070     ,output flt-rec-21
     3071     ,output filter-name-21
     3072     ,output where-phrase-21
     3073     ,output sort-phrase-21
     3074     ,output where-phrase-rus-21
     3075     ,output sort-phrase-rus-21
     3076     ).
     3077       run set-filter-name in this-procedure
     3078         (INPUT filter-name-21
     3079         ) no-error .
     3080     assign
     3081       l-filter-open-21 = false
     3082     .
     3083     if flt-rec-21 <> ?
     3084       or sort-column-phrase > ""
     3085     then do:
     3086       define variable  parameter-2-21 as character no-undo .
     3087       define variable  parameter-3-21 as character no-undo .
     3088       define variable  parameter-4-21 as character no-undo .
     3089       define variable  parameter-5-21 as character no-undo .
     3090       define variable  parameter-6-21 as character no-undo .
     3091       define variable  parameter-7-21 as character no-undo .
     3092         assign
     3093         parameter-3-21 =
     3094                                 "FOR EACH X_cfgg-hist"
     3095         parameter-4-21 =
     3096           (
     3097             if (" TRUE " + " " + where-phrase-21) <> ""
     3098             then " TRUE " + " " + where-phrase-21
     3099             else "true"
     3100           )
     3101         parameter-5-21 = (" " + "" + " " + "")
     3102         parameter-6-21 = if sort-phrase-21 = ''
     3103                              then
     3104           (
     3105           " " + "  " +
     3106             " " + sort-column-phrase +
     3107           " " + "  "
     3108           )
     3109                              else
     3110           (
     3111           " " + "  " +
     3112             " " + sort-column-phrase +
     3113           " " + sort-phrase-21
     3114           )
     3115         parameter-7-21 =
     3116           "   "
     3117       .
     3118       do
     3119       on stop undo, leave
     3120       on error undo, leave
     3121       :
     3122         assign
     3123           l-disable-where-21 =
     3124             (" TRUE " + " " + where-phrase-21 = "")
     3125         .
     3126         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3127                             ,input query br-c-fgg-hist:handle
     3128                             ,input parameter-3-21
     3129                             ,input parameter-4-21
     3130                             ,input parameter-5-21
     3131                             ,input parameter-6-21
     3132                             ,input parameter-7-21
     3133                             )
     3134         .
     3135         assign
     3136           l-filter-open-21 = true
     3137         .
     3138       end.
     3139       if l-filter-open-21 = false then do:
     3140         message
     3141           "Ошибка при фильтрации / сортировке" skip
     3142           "Будут показаны записи без учета фильтра" skip
     3143           view-as alert-box .
     3144       end.
     3145       else do:
     3146           assign
     3147             l-query-was-opened = true
     3148           .
     3149       end.
     3150     end.
     3151     if l-filter-open-21 = false then do:
     3152       OPEN QUERY br-c-fgg-hist FOR EACH X_cfgg-hist
     3153         where  TRUE
     3154     .
     3155         assign
     3156           l-query-was-opened = true
     3157         .
     3158     end.
     3159     run waitfram-hide in this-procedure .
     3160       end.
     3161       when 'объект':U then do:
     3162           ASSIGN frame Dialog-Frame:TITLE = substitute("Справочник истории групп блюд: Объект &1&2",
     3163                                                          p-obj-type, p-obj-code)
     3164           filter-point = filter-point0 + p-mode
     3165           filter-label = substitute("&1: Объект", filter-label0)
     3166           .
     3167   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
