        1   DEFINE BUFFER buf_cli FOR ub.clients.
        2   DEFINE BUFFER for-c-fbr-gds-grp-hist FOR ub.c-fbr-gds-grp-hist.
        3   DEFINE BUFFER X_cfgg-hist FOR ub.c-fbr-gds-grp-hist.
        4   define input parameter parparentproc as widget-handle no-undo .
        5   DEFINE INPUT PARAMETER bttns  as character  no-undo .
        6   DEFINE INPUT PARAMETER p-mode as character no-undo.
        7   DEFINE INPUT PARAMETER p-obj-type  like ub.c-fbr-gds-grp-hist.obj-type  no-undo.
        8   DEFINE INPUT PARAMETER p-obj-code  like ub.c-fbr-gds-grp-hist.obj-code  no-undo.
        9   DEFINE INPUT PARAMETER p-node-code like ub.c-fbr-gds-grp-hist.node-code no-undo.
       10   DEFINE INPUT PARAMETER p-attr-code like ub.c-fbr-gds-grp-hist.attr-code no-undo.
       11   define input parameter p-is-del    as logical no-undo .
       12   define input parameter p-subject   like ub.c-fbr-gds-grp-hist.subject no-undo .
       13   DEFINE OUTPUT PARAMETER  p-rid-list    as  char no-undo .
       14   define variable vss-revision    as character no-undo init "$Revision$":u .
       15   define variable vss-author      as character no-undo init "$Author$":u .
       16   define variable vss-date        as character no-undo init "$Date$":u .
       17   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       18   define variable vss-archive     as character no-undo init "$Archive$":u .
       19   define variable vss-description as character no-undo init "Справочник истории групп блюд" .
       20   procedure vss-get-info :
       21     define output parameter p-vss-revision    like vss-revision    no-undo .
       22     define output parameter p-vss-author      like vss-author      no-undo .
       23     define output parameter p-vss-date        like vss-date        no-undo .
       24     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       25     define output parameter p-vss-archive     like vss-archive     no-undo .
       26     define output parameter p-vss-description like vss-description no-undo .
       27     assign
       28       p-vss-revision    = vss-revision
       29       p-vss-author      = vss-author
       30       p-vss-date        = vss-date
       31       p-vss-workfile    = vss-workfile
       32       p-vss-archive     = vss-archive
       33       p-vss-description = vss-description
       34     .
       35   end procedure.
       36   procedure vss-get-parameters :
       37     define output parameter p-vss-parameters as character no-undo .
       38   end procedure.
       39   define new global shared variable g#vssrevis-logger as handle    no-undo .
       40   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       41   define variable v-vssrevis-logger                   as handle    no-undo .
       42   procedure vss-logevent :
       43     define input  parameter p-extra-paramters as character no-undo .
       44     define variable v-vssrevis-parameters as character no-undo .
       45     do
       46     on error undo, return error return-value
       47     :
       48       if  valid-handle(v-vssrevis-logger)
       49       and v-vssrevis-logger :get-signature("logevent") <> ""
       50       then do:
       51         run vss-get-parameters in this-procedure
       52           (output v-vssrevis-parameters
       53           ).
       54         run logevent in v-vssrevis-logger
       55           (input vss-workfile
       56           ,input vss-revision
       57           ,input v-vssrevis-parameters
       58           ,input p-extra-paramters
       59           ).
       60       end.
       61     end.
       62   end procedure.
       63   assign
       64     v-vssrevis-logger = g#vssrevis-logger
       65   .
       66   if  valid-handle(v-vssrevis-logger)
       67   and v-vssrevis-logger :get-signature("logevent") <> ""
       68   then do:
       69     assign
       70       v-vssrevis-logevent = true
       71     .
       72     run vss-logevent in this-procedure (input vss-description) .
       73   end.
       74   define new global shared variable g#language as character no-undo .
       75   if g#language <> '' and g#language <> 'rus':U then do:
       76     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       77   end.
       78   define new global shared variable g#library  as handle no-undo .
       79   define new global shared variable g#library2 as handle no-undo .
       80   procedure proc-alt-shift-f2:
       81     if not ibs.th.gbl.gbl-var:rcode
       82   then
       83     run gbl\inidebug.p .
       84   end.
       85   procedure proc-alt-shift-f3:
       86     run gbl/prvssinf.p
       87       ( input this-procedure
       88       ) .
       89   end.
       90   define variable v-inform-launched as logical no-undo initial false .
       91   procedure proc-alt-shift-f4:
       92     define variable v-action as character no-undo .
       93     if v-inform-launched = false then do:
       94       assign
       95         v-inform-launched = true
       96       .
       97       run gbl/d-inform.w
       98         (  input self
       99         ,  input this-procedure
      100         , output v-action
      101         ) no-error .
      102       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      103       assign
      104         v-inform-launched = false
      105       .
      106     end.
      107   end.
      108   procedure proc-alt-f1:
      109     run gbl/corrhelp.p
      110       (input this-procedure
      111       ) .
      112   end .
      113   on alt-shift-f2 anywhere do:
      114     run proc-alt-shift-f2.
      115   end.
      116   on alt-shift-f3 anywhere do:
      117     run proc-alt-shift-f3 in this-procedure .
      118   end.
      119   on alt-shift-f4 anywhere do:
      120     run proc-alt-shift-f4 in this-procedure.
      121   end.
      122   on alt-f1 anywhere do:
      123     run proc-alt-f1 in this-procedure .
      124   end.
      125   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      126   procedure cur-time :
      127      define output parameter p-today as date      no-undo .
      128      define output parameter p-time  as integer   no-undo .
      129     do
      130     on error undo, return error
      131     :
      132       define variable v-date1 as date      no-undo .
      133       define variable v-date2 as date      no-undo .
      134       define variable v-time  as integer   no-undo .
      135       assign
      136         v-date1 = today
      137         v-time  = time
      138         v-date2 = today
      139       .
      140       if v-date1 <> v-date2
      141       then do:
      142         assign
      143           v-date1 = today
      144           v-time  = v-time
      145         .
      146       end.
      147       assign
      148         p-today = v-date1
      149         p-time  = v-time
      150       .
      151     end.
      152   end.
      153   function cur-time-date returns character
      154   :
      155     return string(today, '99/99/9999':U) .
      156   end.
      157   function cur-time-mjd returns decimal
      158   :
      159     define variable v-date as date      no-undo .
      160     define variable v-time as integer   no-undo .
      161     run cur-time in this-procedure
      162       (output v-date
      163       ,output v-time
      164       ) .
      165     return integer(v-date) - 2400002 + (v-time / 86400) .
      166   end.
      167   function cur-time-get-ending-index returns integer
      168   (input p-number as integer
      169   )
      170   :
      171     if p-number < 0
      172     or p-number = ?
      173     then do:
      174       return 1 .
      175     end.
      176     define variable v-rest as integer   no-undo .
      177     assign
      178       p-number = p-number modulo 100
      179     .
      180     if p-number < 20
      181     then do:
      182       assign
      183         v-rest = p-number
      184       .
      185     end.
      186     else do:
      187       assign
      188         v-rest = p-number modulo 10
      189       .
      190     end.
      191     case v-rest :
      192       when 1
      193       then do:
      194         return 2 .
      195       end.
      196       when 2 or
      197       when 3 or
      198       when 4
      199       then do:
      200         return 3 .
      201       end.
      202       otherwise do:
      203         return 1 .
      204       end.
      205     end case .
      206   end.
      207   procedure cur-time-mjd-to-date :
      208      define input  parameter i-mjd-diff as decimal no-undo.
      209      define output parameter o-Date     as date    no-undo.
      210      define output parameter o-Time     as integer no-undo.
      211      define variable v-day-number as integer   no-undo .
      212      if    i-mjd-diff < 0
      213         or i-mjd-diff = ?
      214      then do:
      215         return "?" .
      216      end.
      217      assign
      218         v-day-number = truncate(i-mjd-diff,0).
      219         o-Date = date(v-day-number + 2400002).
      220         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      221     .
      222   end.
      223   function cur-time-mjd-to-string returns character
      224   (input p-mjd-diff as decimal
      225   )
      226   :
      227     define variable v-day-number as integer   no-undo .
      228     define variable v-seconds    as integer   no-undo .
      229     define variable v-hour       as integer   no-undo .
      230     define variable v-min        as integer   no-undo .
      231     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      232     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      233     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      234     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      235     if p-mjd-diff < 0
      236     or p-mjd-diff = ?
      237     then do:
      238       return "?" .
      239     end.
      240     assign
      241       v-day-number = integer(truncate(p-mjd-diff,0))
      242       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      243     .
      244     if v-seconds > 86400
      245     then do:
      246       assign
      247         v-seconds = 86400 - 1
      248       .
      249     end.
      250     if v-seconds < 0
      251     then do:
      252       assign
      253         v-seconds = 0
      254       .
      255     end.
      256     assign
      257       v-hour = truncate(v-seconds / 3600, 0)
      258     .
      259     assign
      260       v-seconds = v-seconds modulo 3600
      261     .
      262     assign
      263       v-min = truncate(v-seconds / 60, 0)
      264     .
      265     assign
      266       v-seconds = v-seconds modulo 60
      267     .
      268     return
      269         (if v-day-number <> 0
      270           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      271           else ""
      272         )
      273       + (if v-day-number <> 0 or v-hour <> 0
      274           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      275           else ""
      276         )
      277       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      278           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      279           else ""
      280         )
      281       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      282       .
      283   end.
      284   function cur-time-string returns character
      285   :
      286     define variable v-date as date      no-undo .
      287     define variable v-time as integer   no-undo .
      288     run cur-time in this-procedure
      289       (output v-date
      290       ,output v-time
      291       ) .
      292     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      293   end.
      294   function cur-time-string-sec returns character
      295   :
      296     define variable v-date as date      no-undo .
      297     define variable v-time as integer   no-undo .
      298     run cur-time in this-procedure
      299       (output v-date
      300       ,output v-time
      301       ) .
      302     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      303   end.
      304   function cur-time-custom  returns character
      305   (input p-prefix as character
      306   ,input p-date-format as character
      307   ,input p-delimiter as character
      308   ,input p-time-format as character
      309   ,input p-suffix as character
      310   )
      311   :
      312     define variable v-date as date      no-undo .
      313     define variable v-time as integer   no-undo .
      314     run cur-time in this-procedure
      315       (output v-date
      316       ,output v-time
      317       ) .
      318     return
      319       p-prefix
      320       + string(v-date, p-date-format)
      321       + p-delimiter
      322       + string(v-time, p-time-format)
      323       + p-suffix
      324       .
      325   end.
      326   function cur-time-print  returns character
      327   :
      328     define variable v-date as date      no-undo .
      329     define variable v-time as integer   no-undo .
      330     run cur-time in this-procedure
      331       (output v-date
      332       ,output v-time
      333       ) .
      334     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      335   end.
      336   function cur-time-datetime returns datetime
      337   :
      338     define variable v-char as character no-undo .
      339     define variable v-datetime as datetime no-undo .
      340     v-char = cur-time-string().
      341     v-datetime = datetime(v-char).
      342     return  v-datetime.
      343   end.
      344   function cur-time-string-msec returns character
      345   :
      346     define variable v-date as datetime  no-undo .
      347     v-date = now.
      348     return string(v-date) .
      349   end.
      350   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      351   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      352   define new shared variable RepPathName        as character no-undo .
      353   define new shared variable PrintRubl          as logical   no-undo .
      354   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      355   define variable c-point  as character no-undo .
      356   define variable tbl      as character no-undo .
      357   define variable join-tbl as character no-undo .
      358   define variable fld      as character no-undo .
      359   define variable lab      as character no-undo .
      360   define variable spr      as character no-undo .
      361   define variable dim      as character no-undo .
      362   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      363   procedure fltfield-clear :
      364     define output parameter loc-fld as character no-undo.
      365     define output parameter loc-lab as character no-undo .
      366     define output parameter loc-spr as character no-undo .
      367     define output parameter loc-dim as character no-undo .
      368     assign
      369       loc-fld = ""
      370       loc-lab = ""
      371       loc-spr = ""
      372       loc-dim = "0"
      373     .
      374   end procedure .
      375   procedure fltfield-add :
      376     define input        parameter par-fld as character no-undo.
      377     define input        parameter par-lab as character no-undo .
      378     define input        parameter par-spr as character no-undo .
      379     define input-output parameter loc-fld as character no-undo.
      380     define input-output parameter loc-lab as character no-undo .
      381     define input-output parameter loc-spr as character no-undo .
      382     define input-output parameter loc-dim as character no-undo .
      383     do
      384     on error undo, return error
      385     :
      386       assign
      387       loc-fld = if loc-dim = '0'
      388                 then par-fld
      389                 else (loc-fld + chr(44) + par-fld)
      390       loc-lab = if loc-dim = '0'
      391                 then par-lab
      392                 else (loc-lab + chr(44) + par-lab)
      393       loc-spr = if loc-dim = '0'
      394                 then par-spr
      395                 else (loc-spr + chr(44) + par-spr)
      396       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      397                 string(integer(if num-entries(loc-dim) > 1
      398                               then entry(2, loc-dim)
      399                               else entry(1, loc-dim)
      400                               ) + 1)
      401       no-error
      402       .
      403     end.
      404   end procedure.
      405   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      406   define variable v-waitfram-action01         as character   no-undo .
      407   define variable v-waitfram-action02         as character   no-undo .
      408   define variable v-waitfram-action03         as character   no-undo .
      409   define variable mWaitFramTextBeg            as character   no-undo.
      410   define variable mWaitFramTextEnd            as character   no-undo.
      411   define variable mWaitFramView               as logical     no-undo.
      412   define variable mWaitProcEvent              as logical     no-undo init yes.
      413   define variable mWaitFramInterval           as integer     no-undo init 1 .
      414   define variable mWaitFramStop               as logical     no-undo.
      415   define variable mWaitFramStopUser           as logical     no-undo.
      416   define variable mWaitFramStopTimeOut        as logical     no-undo.
      417   define variable mWaitFramStartProc          as datetime-tz no-undo.
      418   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      419   define button B-WaitFramStop auto-end-key
      420        label "Стоп"
      421        size 10 by 1 tooltip "Остоновить процесс".
      422   define button B-viewProcInfo
      423        label "Информация"
      424        size 15 by 1 tooltip "Информация о процесс".
      425   define frame waitfram
      426     v-waitfram-action01 format "x(72)" no-label skip
      427     v-waitfram-action02 format "x(72)" no-label skip
      428     v-waitfram-action03 format "x(72)" no-label skip
      429     B-viewProcInfo
      430     B-WaitFramStop at row 4 col 30
      431     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      432     .
      433   define new global shared variable mBatchMode as logical no-undo init ?.
      434   define variable mFramBachModHandle as handle no-undo.
      435   mFramBachModHandle = frame waitfram:handle.
      436   define variable mFameOldVis as logical no-undo.
      437   define variable mVisCUrentVin as logical no-undo.
      438   if session:batch-mode
      439   then
      440      mBatchMode = yes.
      441   if mBatchMode = ? then do:
      442     mVisCUrentVin = current-window:visible.
      443     mFameOldVis = mFramBachModHandle:visible.
      444     mFramBachModHandle:visible  = yes.
      445     mBatchMode = mFramBachModHandle:visible ne yes.
      446     mFramBachModHandle:visible = mFameOldVis.
      447     current-window:visible = mVisCUrentVin.
      448   end.
      449    if  log-manager:logfile-name ne ?
      450     then DO:
      451         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      452         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      453         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      454     end.
      455   on choose of B-WaitFramStop in frame waitfram
      456   do:
      457     mWaitFramStop = yes.
      458     mWaitFramStopUser = yes.
      459   end.
      460   function waitfram-check-timeout returns logical():
      461      define variable vtime as int64 no-undo.
      462      if mWaitFramStopTimeOut
      463      then
      464         return yes.
      465      vtime = ( now - mWaitFramStartProc ) / 1000 .
      466      if     mWaitFramTimeOut ne ?
      467         and mWaitFramTimeOut ne 0
      468         and mWaitFramTimeOut lt vtime
      469      then do:
      470         mWaitFramStopTimeOut = yes.
      471      end.
      472      return mWaitFramStopTimeOut.
      473   end.
      474   procedure waitfram-hide :
      475     if not session:batch-mode
      476     then do
      477     on error undo, return error return-value
      478     :
      479       pause 0 before-hide .
      480       if not mBatchMode then
      481         hide frame waitfram .
      482     if     not mWaitFramView
      483        and mWaitProcEvent
      484     then
      485       process events .
      486     end.
      487   end procedure.
      488   procedure waitfram-show :
      489     define input  parameter p-message as character no-undo .
      490     define variable v-left-margin as integer   no-undo .
      491     if not session:batch-mode
      492     then do
      493     on error undo, return error return-value
      494     :
      495       if length(p-message) <= 70 then do:
      496         assign
      497           v-left-margin = integer((70 - length(p-message)) / 2)
      498         .
      499         assign
      500           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      501         .
      502         assign
      503           v-waitfram-action01 = " "
      504           v-waitfram-action02 = " "
      505                                    + fill(" ", v-left-margin)
      506                                    + p-message
      507           v-waitfram-action03 = " "
      508         .
      509       end.
      510       else do:
      511         define variable vRindex1 as integer no-undo.
      512         define variable vRindex2 as integer no-undo.
      513         vRindex1 = r-index(p-message," ",70).
      514         if vRindex1 = 0
      515         then
      516            vRindex1 = 70.
      517         if length(p-message)  <= vRindex1 + 70 then do:
      518           assign
      519             v-waitfram-action01 = " "
      520             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      521             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      522           .
      523         end.
      524         else do:
      525           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      526           if vRindex2 <= vRindex1
      527           then
      528              vRindex2 = vRindex1 + 70.
      529           assign
      530             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      531             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      532             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      533           .
      534         end.
      535       end.
      536       B-viewProcInfo:visible   in frame waitfram = no.
      537       B-viewProcInfo:sensitive in frame waitfram = no.
      538       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      539       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      540       if  (   mWaitFramView
      541          or  mWaitProcEvent)
      542          and not mBatchMode
      543       then
      544          display
      545             v-waitfram-action01 skip
      546             v-waitfram-action02 skip
      547             v-waitfram-action03 skip
      548          with frame waitfram .
      549       if     mWaitFramView
      550          then do:
      551             if     mWaitFramInterval ne ?
      552                and not mBatchMode
      553             then
      554                wait-for go of frame waitfram pause mWaitFramInterval.
      555          end.
      556          else
      557             if     mWaitProcEvent
      558                and not mBatchMode
      559             then
      560                process events .
      561     end.
      562   end procedure.
      563      procedure waitfram-show-this:
      564         define input  parameter iInterval as int64 no-undo.
      565         define variable vtime as int64 no-undo.
      566         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      567         mWaitFramInterval = iInterval.
      568         run waitfram-show (substitute("&1&2 &3&4" ,
      569                                       mWaitFramTextBeg ,
      570                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      571                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      572                                       mWaitFramTextEnd
      573                                      )
      574                           ).
      575      end.
      576      procedure WaitFramRunPause:
      577         define input  parameter iInterval as dec no-undo.
      578         define variable vStart  as datetime-tz no-undo.
      579         define variable vend    as datetime-tz no-undo.
      580         define variable vint as int64 no-undo.
      581         define variable vOk as logical no-undo.
      582         vStart = now.
      583         vend   = vStart.
      584         publish "WaitFramPause" (iInterval,output vOk).
      585         vend   =  now.
      586         vint = vend - vStart.
      587         vint = iInterval - vint / 1000.
      588         if     not mWaitFramStop
      589            and (   vint > 0
      590                 or (    not vOk
      591                     and iInterval eq ?
      592                     )
      593                 )
      594         then
      595            run waitfram-show-this (iInterval).
      596         vend   =  now.
      597         vint = vend - vStart.
      598         vint = iInterval - vint / 1000.
      599         if     not mWaitFramStop
      600            and vint > 0
      601         then do:
      602            run gbl/pause.p (vint * 1000).
      603         end.
      604         if iInterval ne ?
      605         then
      606            publish "WaitFramStop".
      607         waitfram-check-timeout().
      608      end.
      609      procedure WaitFramWaitFor:
      610         define input  parameter iInterval as dec no-undo.
      611         assign
      612            mWaitFramStartProc   = now
      613            mWaitFramStopUser    = no
      614            mWaitFramStopTimeOut = no
      615         .
      616         block-wait:
      617         do while not mWaitFramStop:
      618            run WaitFramRunPause (iInterval).
      619            if  waitfram-check-timeout()
      620            then do:
      621               leave block-wait.
      622            end.
      623         end.
      624         run waitfram-hide.
      625      end.
      626   procedure waitfram-join :
      627     define input  parameter p-line-1  as character no-undo .
      628     define input  parameter p-line-2  as character no-undo .
      629     define input  parameter p-line-3  as character no-undo .
      630     define output parameter p-message as character no-undo .
      631     do
      632     on error undo, return error return-value
      633     :
      634       assign
      635         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      636                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      637                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      638       .
      639     end.
      640   end procedure.
      641   function waitfram-join-function returns character
      642     (input p-line-1 as character
      643     ,input p-line-2 as character
      644     ,input p-line-3 as character
      645     ).
      646     define variable v-message as character no-undo .
      647     run waitfram-join in this-procedure
      648       (input  p-line-1
      649       ,input  p-line-2
      650       ,input  p-line-3
      651       ,output v-message
      652       ) .
      653     return v-message .
      654   end function .
