     3209             then  substitute('X_cfgg-hist.obj-type = &1&2&1 and X_cfgg-hist.obj-code  = &3', chr(34), p-obj-type, p-obj-code)   + " " + where-phrase-23
     3210             else "true"
     3211           )
     3212         parameter-5-23 = (" " + "" + " " + "")
     3213         parameter-6-23 = if sort-phrase-23 = ''
     3214                              then
     3215           (
     3216           " " + "  " +
     3217             " " + sort-column-phrase +
     3218           " " + "  "
     3219           )
     3220                              else
     3221           (
     3222           " " + "  " +
     3223             " " + sort-column-phrase +
     3224           " " + sort-phrase-23
     3225           )
     3226         parameter-7-23 =
     3227           "   "
     3228       .
     3229       do
     3230       on stop undo, leave
     3231       on error undo, leave
     3232       :
     3233         assign
     3234           l-disable-where-23 =
     3235             (" X_cfgg-hist.obj-type = p-obj-type and X_cfgg-hist.obj-code  = p-obj-code " + " " + where-phrase-23 = "")
     3236         .
     3237         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3238                             ,input query br-c-fgg-hist:handle
     3239                             ,input parameter-3-23
     3240                             ,input parameter-4-23
     3241                             ,input parameter-5-23
     3242                             ,input parameter-6-23
     3243                             ,input parameter-7-23
     3244                             )
     3245         .
     3246         assign
     3247           l-filter-open-23 = true
     3248         .
     3249       end.
     3250       if l-filter-open-23 = false then do:
     3251         message
     3252           "Ошибка при фильтрации / сортировке" skip
