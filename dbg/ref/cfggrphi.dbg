     3277           .
     3278   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3279   define variable  l-disable-where-25  as logical   no-undo .
     3280   define variable  l-filter-open-25    as logical   .
     3281   define variable  flt-rec-25       as recid     no-undo .
