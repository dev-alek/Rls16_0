      688   procedure fbr-grp-attr-value :
      689   do
      690   on error undo, return error
      691   :
      692   define input  parameter p-obj-type    as character  no-undo.
      693   define input  parameter p-obj-code    as integer    no-undo.
      694   define input  parameter p-node-code   as integer    no-undo.
      695   define input  parameter p-code        as character  no-undo.
      696   define output parameter p-value       as character  no-undo.
      697   define output parameter p-type        as character  no-undo.
      698       define variable v-format         as character no-undo .
      699       define variable v-label          as character no-undo .
      700       define variable v-user-can-edit  as logical   no-undo .
      701       define variable v-output-display as logical   no-undo .
      702       define variable v-other          as character no-undo .
      703       define buffer buf_fbr-gds-grp-attr for ub.fbr-gds-grp-attr.
      704       run fbr-grp-attr-name in this-procedure (
      705             input  p-code
      706           , output p-type
      707           , output v-format
      708           , output v-label
      709           , output v-user-can-edit
      710           , output v-output-display
      711           , output v-other
      712       ) no-error .
      713       if error-status :error
      714       then do:
      715           undo, return error return-value .
      716       end.
      717       find first buf_fbr-gds-grp-attr no-lock
      718            where buf_fbr-gds-grp-attr.obj-type  = p-obj-type
      719              and buf_fbr-gds-grp-attr.obj-code  = p-obj-code
      720              and buf_fbr-gds-grp-attr.node-code = p-node-code
      721              and buf_fbr-gds-grp-attr.attr-code = p-code
      722       no-error .
      723       if available buf_fbr-gds-grp-attr
      724       then do:
      725           assign
      726               p-value = buf_fbr-gds-grp-attr.attr-value
      727           .
      728       end.
      729       else do:
      730           assign
      731           p-value = (if p-type = 'L':U then "no":U else "")
      732           .
      733       end.
      734   end.
      735   end procedure.
      736   procedure fbr-grp-attr-write :
      737   do
      738   on error undo, return error
      739   :
      740   define input parameter p-obj-type   like ub.fbr-gds-grp-attr.obj-type            no-undo.
      741   define input parameter p-obj-code   like ub.fbr-gds-grp-attr.obj-code            no-undo.
      742   define input parameter p-node-code  like ub.fbr-gds-grp-attr.node-code      no-undo.
      743   define input parameter p-code       like ub.fbr-gds-grp-attr.attr-code      no-undo.
      744   define input parameter p-value      like ub.fbr-gds-grp-attr.attr-value     no-undo.
      745       define variable v-type              as character                no-undo.
      746       define variable v-format            as character                no-undo.
      747       define variable v-label             as character                no-undo.
      748       define variable v-user-can-edit     as logical                  no-undo.
      749       define variable v-output-display    as logical                  no-undo.
      750       define variable v-other             as character                no-undo.
      751       define buffer buf_fbr-gds-grp-attr for ub.fbr-gds-grp-attr .
      752       run fbr-grp-attr-name in this-procedure (
      753                         input  p-code
      754                       , output v-type
      755                       , output v-format
      756                       , output v-label
      757                       , output v-user-can-edit
      758                       , output v-output-display
      759                       , output v-other
      760       ) no-error.
      761       if error-status :error
      762       then do:
      763           undo, return error return-value.
      764       end.
      765       find first buf_fbr-gds-grp-attr exclusive-lock
      766            where buf_fbr-gds-grp-attr.obj-type   = p-obj-type
      767              and buf_fbr-gds-grp-attr.obj-code   = p-obj-code
      768              and buf_fbr-gds-grp-attr.node-code  = p-node-code
      769              and buf_fbr-gds-grp-attr.attr-code  = p-code
      770       no-error.
      771       if not available buf_fbr-gds-grp-attr
      772       then do:
      773           create buf_fbr-gds-grp-attr.
      774           assign
      775           buf_fbr-gds-grp-attr.node-code  = p-node-code
      776           buf_fbr-gds-grp-attr.attr-code  = p-code
      777           buf_fbr-gds-grp-attr.obj-type   = p-obj-type
      778           buf_fbr-gds-grp-attr.obj-code   = p-obj-code
      779           buf_fbr-gds-grp-attr.attr-value = p-value
      780           .
      781       end.
      782       else do:
      783           assign
      784               buf_fbr-gds-grp-attr.attr-value = p-value
      785           .
      786       end.
      787   end.
      788   end procedure.
      789   procedure fbr-grp-attr-delete :
      790   do
      791   on error undo, return error
      792   :
      793   define input parameter p-obj-type   like ub.fbr-gds-grp-attr.obj-type        no-undo.
      794   define input parameter p-obj-code   like ub.fbr-gds-grp-attr.obj-code        no-undo.
      795   define input parameter p-node-code  like ub.fbr-gds-grp-attr.node-code  no-undo.
      796   define input parameter p-code       like ub.fbr-gds-grp-attr.attr-code  no-undo.
      797   define output parameter p-deleted   as logical                      no-undo.
      798       define buffer buf_fbr-gds-grp-attr for ub.fbr-gds-grp-attr .
      799       define variable v-type              as character                no-undo.
      800       define variable v-format            as character                no-undo.
      801       define variable v-label             as character                no-undo.
      802       define variable v-user-can-edit     as logical                  no-undo.
      803       define variable v-output-display    as logical                  no-undo.
      804       define variable v-other             as character                no-undo.
      805       run fbr-grp-attr-name in this-procedure
      806       ( input  p-code
      807       , output v-type
      808       , output v-format
      809       , output v-label
      810       , output v-user-can-edit
      811       , output v-output-display
      812       , output v-other
      813       ) no-error .
      814       if error-status :error then do:
      815           undo, return error return-value .
      816       end.
      817       find first buf_fbr-gds-grp-attr exclusive-lock
      818            where buf_fbr-gds-grp-attr.obj-type   = p-obj-type
      819              and buf_fbr-gds-grp-attr.obj-code   = p-obj-code
      820              and buf_fbr-gds-grp-attr.node-code  = p-node-code
      821              and buf_fbr-gds-grp-attr.attr-code  = p-code
      822       no-error.
      823       if not available buf_fbr-gds-grp-attr
      824       then do:
