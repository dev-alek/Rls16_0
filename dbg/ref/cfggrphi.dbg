     3501   PROCEDURE proc-b-sch :
     3502   assign
     3503   tbl = 'c-fbr-gds-grp-hist'
     3504   join-tbl = 'X_cfgg-hist'
     3505   fld = ""
     3506   lab = ""
     3507   spr = ""
     3508   dim = '0'
     3509   .
     3510   run fltfield-add in this-procedure('subject', 'Предмет изменений', 'fbr-gds-grp-hist-subject',
     3511   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3512   run fltfield-add in this-procedure('action', 'Действие', 'hist-action',
     3513   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3514   run fltfield-add in this-procedure('attr-code', 'Код атрибута', '',
     3515   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3516   run fltfield-add in this-procedure('obj-type*obj-code', 'Объект', 'cli',
     3517   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3518   run fltfield-add in this-procedure('corr-date', 'Дата изменений', '',
     3519   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3520   run fltfield-add in this-procedure('corr-time', 'Время изменений', 'time',
     3521   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3522   run fltfield-add in this-procedure('corr-user-db-num', 'БД изменений', '',
     3523   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3524   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     3525   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3526   DO on stop undo, leave:
     3527       run gbl/filter.w ( input parparentproc
     3528                         ,input (filter-point + chr(4) + filter-label + chr(4) + 'yes')
     3529                         ,input tbl
     3530                         ,input join-tbl
     3531                         ,input fld
     3532                         ,input lab
     3533                         ,input spr
     3534                         ,input dim).
     3535       RUN OpenBr in this-procedure.
     3536   END .
     3537   END PROCEDURE.
     3538   PROCEDURE proc-view-changes :
     3539   define variable v-description as character no-undo .
     3540   for each temp-changes:
     3541       delete temp-changes.
     3542   END.
     3543   if not available X_cfgg-hist then do:
     3544     Open QUery br-changes for each temp-changes.
     3545     return.
     3546   end.
     3547   assign
     3548   v-full-name-old = "":U
     3549   v-full-name-new = "":U
     3550   .
     3551   run ref/cfggrhiv.p (
     3552                      input X_cfgg-hist.obj-type
     3553                     ,input X_cfgg-hist.obj-code
     3554                     ,input X_cfgg-hist.node-code
     3555                     ,input X_cfgg-hist.corr-user-db-num
     3556                     ,input X_cfgg-hist.chip-num
     3557                     ,input X_cfgg-hist.subject
     3558                     ,input X_cfgg-hist.action
     3559                     ,input no
     3560                     ,output v-description
     3561                     ,OUTPUT v-full-name-old
     3562                     ,OUTPUT v-full-name-new
     3563                  ) no-error .
     3564   Open QUery br-changes for each temp-changes.
     3565   assign
     3566   br-changes:title in frame Dialog-Frame = v-description
     3567   .
     3568   if v-full-name-old <> "":U
     3569   or v-full-name-new <> "":U  then do:
     3570     DISPLAY
     3571     v-full-name-old
     3572     v-full-name-new
     3573     WITH FRAME Dialog-Frame.
     3574   end.
     3575   else do:
     3576     hide
     3577     v-full-name-old
     3578     v-full-name-new
     3579     IN FRAME Dialog-Frame.
     3580   end.
     3581   END PROCEDURE.
     3582   FUNCTION get-action RETURNS CHARACTER
     3583     (  p-action as integer ) :
     3584     define variable dops as character no-undo.
     3585   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     3586   RETURN dops.
     3587   END FUNCTION.
