     3270     run waitfram-hide in this-procedure .
     3271       end.
     3272       when "one":U then do:
     3273           ASSIGN frame Dialog-Frame:TITLE = substitute("Справочник истории групп блюд: Объект &1&2 Вн. № группы &3",
     3274                                                          p-obj-type, p-obj-code, p-node-code)
     3275           filter-point = filter-point0 + p-mode
