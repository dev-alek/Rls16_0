        1   DEFINE BUFFER locked_clients-attr FOR ub.clients-attr.
        2   DEFINE INPUT-OUTPUT PARAMETER p-value AS CHARACTER NO-UNDO.
        3   define variable vss-revision    as character no-undo init "$Revision$":U .
        4   define variable vss-author      as character no-undo init "$Author$":U .
        5   define variable vss-date        as character no-undo init "$Date$":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        7   define variable vss-archive     as character no-undo init "$Archive$":U .
        8   define variable vss-description as character no-undo init "Редактирование свидетельства о постановке на УЧЕТ по НДС".
        9   procedure vss-get-info :
       10     define output parameter p-vss-revision    like vss-revision    no-undo .
       11     define output parameter p-vss-author      like vss-author      no-undo .
       12     define output parameter p-vss-date        like vss-date        no-undo .
       13     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       14     define output parameter p-vss-archive     like vss-archive     no-undo .
       15     define output parameter p-vss-description like vss-description no-undo .
       16     assign
       17       p-vss-revision    = vss-revision
       18       p-vss-author      = vss-author
       19       p-vss-date        = vss-date
       20       p-vss-workfile    = vss-workfile
       21       p-vss-archive     = vss-archive
       22       p-vss-description = vss-description
       23     .
       24   end procedure.
       25   procedure vss-get-parameters :
       26     define output parameter p-vss-parameters as character no-undo .
       27   end procedure.
       28   define new global shared variable g#vssrevis-logger as handle    no-undo .
       29   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       30   define variable v-vssrevis-logger                   as handle    no-undo .
       31   procedure vss-logevent :
       32     define input  parameter p-extra-paramters as character no-undo .
       33     define variable v-vssrevis-parameters as character no-undo .
       34     do
       35     on error undo, return error return-value
       36     :
       37       if  valid-handle(v-vssrevis-logger)
       38       and v-vssrevis-logger :get-signature("logevent") <> ""
       39       then do:
       40         run vss-get-parameters in this-procedure
       41           (output v-vssrevis-parameters
       42           ).
       43         run logevent in v-vssrevis-logger
       44           (input vss-workfile
       45           ,input vss-revision
       46           ,input v-vssrevis-parameters
       47           ,input p-extra-paramters
       48           ).
       49       end.
       50     end.
       51   end procedure.
       52   assign
       53     v-vssrevis-logger = g#vssrevis-logger
       54   .
       55   if  valid-handle(v-vssrevis-logger)
       56   and v-vssrevis-logger :get-signature("logevent") <> ""
       57   then do:
       58     assign
       59       v-vssrevis-logevent = true
       60     .
       61     run vss-logevent in this-procedure (input vss-description) .
       62   end.
       63   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       64   define variable v-waitfram-action01         as character   no-undo .
       65   define variable v-waitfram-action02         as character   no-undo .
       66   define variable v-waitfram-action03         as character   no-undo .
       67   define variable mWaitFramTextBeg            as character   no-undo.
       68   define variable mWaitFramTextEnd            as character   no-undo.
       69   define variable mWaitFramView               as logical     no-undo.
       70   define variable mWaitProcEvent              as logical     no-undo init yes.
       71   define variable mWaitFramInterval           as integer     no-undo init 1 .
       72   define variable mWaitFramStop               as logical     no-undo.
       73   define variable mWaitFramStopUser           as logical     no-undo.
       74   define variable mWaitFramStopTimeOut        as logical     no-undo.
       75   define variable mWaitFramStartProc          as datetime-tz no-undo.
       76   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       77   define button B-WaitFramStop auto-end-key
       78        label "Стоп"
       79        size 10 by 1 tooltip "Остоновить процесс".
       80   define button B-viewProcInfo
       81        label "Информация"
       82        size 15 by 1 tooltip "Информация о процесс".
       83   define frame waitfram
       84     v-waitfram-action01 format "x(72)" no-label skip
       85     v-waitfram-action02 format "x(72)" no-label skip
       86     v-waitfram-action03 format "x(72)" no-label skip
       87     B-viewProcInfo
       88     B-WaitFramStop at row 4 col 30
       89     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       90     .
       91   define new global shared variable mBatchMode as logical no-undo init ?.
       92   define variable mFramBachModHandle as handle no-undo.
       93   mFramBachModHandle = frame waitfram:handle.
       94   define variable mFameOldVis as logical no-undo.
       95   define variable mVisCUrentVin as logical no-undo.
       96   if session:batch-mode
       97   then
       98      mBatchMode = yes.
       99   if mBatchMode = ? then do:
      100     mVisCUrentVin = current-window:visible.
      101     mFameOldVis = mFramBachModHandle:visible.
      102     mFramBachModHandle:visible  = yes.
      103     mBatchMode = mFramBachModHandle:visible ne yes.
      104     mFramBachModHandle:visible = mFameOldVis.
      105     current-window:visible = mVisCUrentVin.
      106   end.
      107    if  log-manager:logfile-name ne ?
      108     then DO:
      109         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      110         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      111         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      112     end.
      113   on choose of B-WaitFramStop in frame waitfram
      114   do:
      115     mWaitFramStop = yes.
      116     mWaitFramStopUser = yes.
      117   end.
      118   function waitfram-check-timeout returns logical():
      119      define variable vtime as int64 no-undo.
      120      if mWaitFramStopTimeOut
      121      then
      122         return yes.
      123      vtime = ( now - mWaitFramStartProc ) / 1000 .
      124      if     mWaitFramTimeOut ne ?
      125         and mWaitFramTimeOut ne 0
      126         and mWaitFramTimeOut lt vtime
      127      then do:
      128         mWaitFramStopTimeOut = yes.
      129      end.
      130      return mWaitFramStopTimeOut.
      131   end.
      132   procedure waitfram-hide :
      133     if not session:batch-mode
      134     then do
      135     on error undo, return error return-value
      136     :
      137       pause 0 before-hide .
      138       if not mBatchMode then
      139         hide frame waitfram .
      140     if     not mWaitFramView
      141        and mWaitProcEvent
      142     then
      143       process events .
      144     end.
      145   end procedure.
      146   procedure waitfram-show :
      147     define input  parameter p-message as character no-undo .
      148     define variable v-left-margin as integer   no-undo .
      149     if not session:batch-mode
      150     then do
      151     on error undo, return error return-value
      152     :
      153       if length(p-message) <= 70 then do:
      154         assign
      155           v-left-margin = integer((70 - length(p-message)) / 2)
      156         .
      157         assign
      158           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      159         .
      160         assign
      161           v-waitfram-action01 = " "
      162           v-waitfram-action02 = " "
      163                                    + fill(" ", v-left-margin)
      164                                    + p-message
      165           v-waitfram-action03 = " "
      166         .
      167       end.
      168       else do:
      169         define variable vRindex1 as integer no-undo.
      170         define variable vRindex2 as integer no-undo.
      171         vRindex1 = r-index(p-message," ",70).
      172         if vRindex1 = 0
      173         then
      174            vRindex1 = 70.
      175         if length(p-message)  <= vRindex1 + 70 then do:
      176           assign
      177             v-waitfram-action01 = " "
      178             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      179             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      180           .
      181         end.
      182         else do:
      183           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      184           if vRindex2 <= vRindex1
      185           then
      186              vRindex2 = vRindex1 + 70.
      187           assign
      188             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      189             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      190             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      191           .
      192         end.
      193       end.
      194       B-viewProcInfo:visible   in frame waitfram = no.
      195       B-viewProcInfo:sensitive in frame waitfram = no.
      196       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      197       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      198       if  (   mWaitFramView
      199          or  mWaitProcEvent)
      200          and not mBatchMode
      201       then
      202          display
      203             v-waitfram-action01 skip
      204             v-waitfram-action02 skip
      205             v-waitfram-action03 skip
      206          with frame waitfram .
      207       if     mWaitFramView
      208          then do:
      209             if     mWaitFramInterval ne ?
      210                and not mBatchMode
      211             then
      212                wait-for go of frame waitfram pause mWaitFramInterval.
      213          end.
      214          else
      215             if     mWaitProcEvent
      216                and not mBatchMode
      217             then
      218                process events .
      219     end.
      220   end procedure.
      221      procedure waitfram-show-this:
      222         define input  parameter iInterval as int64 no-undo.
      223         define variable vtime as int64 no-undo.
      224         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      225         mWaitFramInterval = iInterval.
      226         run waitfram-show (substitute("&1&2 &3&4" ,
      227                                       mWaitFramTextBeg ,
      228                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      229                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      230                                       mWaitFramTextEnd
      231                                      )
      232                           ).
      233      end.
      234      procedure WaitFramRunPause:
      235         define input  parameter iInterval as dec no-undo.
      236         define variable vStart  as datetime-tz no-undo.
      237         define variable vend    as datetime-tz no-undo.
      238         define variable vint as int64 no-undo.
      239         define variable vOk as logical no-undo.
      240         vStart = now.
      241         vend   = vStart.
      242         publish "WaitFramPause" (iInterval,output vOk).
      243         vend   =  now.
      244         vint = vend - vStart.
      245         vint = iInterval - vint / 1000.
      246         if     not mWaitFramStop
      247            and (   vint > 0
      248                 or (    not vOk
      249                     and iInterval eq ?
      250                     )
      251                 )
      252         then
      253            run waitfram-show-this (iInterval).
      254         vend   =  now.
      255         vint = vend - vStart.
      256         vint = iInterval - vint / 1000.
      257         if     not mWaitFramStop
      258            and vint > 0
      259         then do:
      260            run gbl/pause.p (vint * 1000).
      261         end.
      262         if iInterval ne ?
      263         then
      264            publish "WaitFramStop".
      265         waitfram-check-timeout().
      266      end.
      267      procedure WaitFramWaitFor:
      268         define input  parameter iInterval as dec no-undo.
      269         assign
      270            mWaitFramStartProc   = now
      271            mWaitFramStopUser    = no
      272            mWaitFramStopTimeOut = no
      273         .
      274         block-wait:
      275         do while not mWaitFramStop:
      276            run WaitFramRunPause (iInterval).
      277            if  waitfram-check-timeout()
      278            then do:
      279               leave block-wait.
      280            end.
      281         end.
      282         run waitfram-hide.
      283      end.
      284   procedure waitfram-join :
      285     define input  parameter p-line-1  as character no-undo .
      286     define input  parameter p-line-2  as character no-undo .
      287     define input  parameter p-line-3  as character no-undo .
      288     define output parameter p-message as character no-undo .
      289     do
      290     on error undo, return error return-value
      291     :
      292       assign
      293         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      294                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      295                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      296       .
      297     end.
      298   end procedure.
      299   function waitfram-join-function returns character
      300     (input p-line-1 as character
      301     ,input p-line-2 as character
      302     ,input p-line-3 as character
      303     ).
      304     define variable v-message as character no-undo .
      305     run waitfram-join in this-procedure
      306       (input  p-line-1
      307       ,input  p-line-2
      308       ,input  p-line-3
      309       ,output v-message
      310       ) .
      311     return v-message .
      312   end function .
      313   define new global shared variable g#language as character no-undo .
      314   if g#language <> '' and g#language <> 'rus':U then do:
      315     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      316   end.
      317   define new global shared variable g#library  as handle no-undo .
      318   define new global shared variable g#library2 as handle no-undo .
      319   procedure proc-alt-shift-f2:
      320     if not ibs.th.gbl.gbl-var:rcode
      321   then
      322     run gbl\inidebug.p .
      323   end.
      324   procedure proc-alt-shift-f3:
      325     run gbl/prvssinf.p
      326       ( input this-procedure
      327       ) .
      328   end.
      329   define variable v-inform-launched as logical no-undo initial false .
      330   procedure proc-alt-shift-f4:
      331     define variable v-action as character no-undo .
      332     if v-inform-launched = false then do:
      333       assign
      334         v-inform-launched = true
      335       .
      336       run gbl/d-inform.w
      337         (  input self
      338         ,  input this-procedure
      339         , output v-action
      340         ) no-error .
      341       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      342       assign
      343         v-inform-launched = false
      344       .
      345     end.
      346   end.
      347   procedure proc-alt-f1:
      348     run gbl/corrhelp.p
      349       (input this-procedure
      350       ) .
      351   end .
      352   on alt-shift-f2 anywhere do:
      353     run proc-alt-shift-f2.
      354   end.
      355   on alt-shift-f3 anywhere do:
      356     run proc-alt-shift-f3 in this-procedure .
      357   end.
      358   on alt-shift-f4 anywhere do:
      359     run proc-alt-shift-f4 in this-procedure.
      360   end.
      361   on alt-f1 anywhere do:
      362     run proc-alt-f1 in this-procedure .
      363   end.
      364   DEFINE VARIABLE v-tab-order AS CHARACTER NO-UNDO.
      365   DEFINE VARIABLE v-dop AS CHARACTER NO-UNDO.
      366   DEFINE BUTTON B-exit AUTO-GO
      367        LABEL "&Ввод"
      368        SIZE 10 BY 1
      369        BGCOLOR 8 .
      370   DEFINE BUTTON B-Help
      371        LABEL "Помо&щь"
      372        SIZE 10 BY 1
      373        BGCOLOR 8 .
      374   DEFINE BUTTON b-quit AUTO-END-KEY
      375        LABEL "&Отмена"
      376        SIZE 10 BY 1
      377        BGCOLOR 8 .
      378   DEFINE VARIABLE f-date AS DATE FORMAT "99/99/9999":U INITIAL ?
      379        LABEL "Дата"
      380        VIEW-AS FILL-IN
      381        SIZE 12 BY 1 NO-UNDO.
      382   DEFINE VARIABLE f-number AS CHARACTER FORMAT "X(12)":U
      383        LABEL "№"
      384        VIEW-AS FILL-IN
      385        SIZE 14 BY 1 NO-UNDO.
      386   DEFINE VARIABLE f-series AS CHARACTER FORMAT "X(5)":U
      387        LABEL "Серия"
      388        VIEW-AS FILL-IN
      389        SIZE 7 BY 1 NO-UNDO.
      390   DEFINE FRAME Dialog-Frame
      391        B-exit AT ROW 1 COL 1
      392        b-quit AT ROW 1 COL 11
      393        B-Help AT ROW 1 COL 41
      394        f-series AT ROW 3 COL 6 COLON-ALIGNED
      395        f-number AT ROW 5 COL 6 COLON-ALIGNED
      396        f-date AT ROW 7 COL 6 COLON-ALIGNED
      397        SPACE(31.99) SKIP(0.53)
      398       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      399            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      400            TITLE "Свидетельство о постановке на учет по НДС"
      401            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      402   ASSIGN
      403          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      404          FRAME Dialog-Frame:HIDDEN           = TRUE.
      405   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      406   DO:
      407     APPLY "END-ERROR":U TO SELF.
      408   END.
      409   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      410   DO:
      411     ASSIGN
      412     f-series
      413     f-number
      414     f-date
      415     .
      416     IF f-date = ? THEN DO:
      417         MESSAGE
      418         "Неверная дата"
      419         VIEW-AS ALERT-BOX.
      420         RETURN NO-APPLY.
      421     END.
      422     ASSIGN
      423     p-value = f-series + chr(4) + f-number + chr(4) + STRING(f-date, "99/99/9999")
      424     .
      425   END.
      426   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      427   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      428   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      429   on help of frame Dialog-Frame
      430   do:
      431     run gbl/app_help.p
      432       (input this-procedure :file-name
      433       ,input ''
      434       ,input ?
      435       ) no-error.
      436     if error-status :error then do:
      437       message
      438         "Ошибка при вызове помощи"
      439         error-status :get-message(1)
      440         view-as alert-box .
      441     end.
      442   end.
      443   run minbtn-set in this-procedure .
      444   on choose of b-help in frame Dialog-Frame
      445   do:
      446     apply "help":u to frame Dialog-Frame .
      447   end.
      448   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      449   procedure minbtn-set :
      450       do
      451           on error undo, return error return-value
      452           :
      453           define variable ii              as integer       no-undo .
      454           define variable fh              as widget-handle no-undo .
      455           define variable hh              as widget-handle no-undo .
      456           define variable v-h             as handle        extent 4 no-undo .
      457           define variable v-name-button   as character     no-undo .
      458           define variable v-help-old-x    as decimal       no-undo .
      459           define variable v-help-old-y    as decimal       no-undo .
      460           define variable v-help-old-size as decimal       no-undo .
      461           define variable v-frame-width   as decimal       no-undo .
      462           define variable jj              as integer       no-undo .
      463           do
      464               on error undo, return error
      465               :
      466               assign
      467                   v-frame-width = frame Dialog-Frame:width - 0.3
      468                   fh            = frame Dialog-Frame:first-child
      469                   hh            = fh:first-child
      470                   ii            = 1
      471                   .
      472               do while valid-handle(hh):
      473                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      474                   do:
      475                       case lc(hh:name) :
      476                           when "b-help" then
      477                               do:
      478                                   hh:load-image-up("cmp/b-help.bmp":u) .
      479                                   hh:load-image-down("cmp/b-help.bmp":u) .
      480                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      481                                   hh:TOOLTIP = "Помощь" .
      482                                   v-help-old-x = hh:column .
      483                                   v-help-old-y = hh:row    .
      484                                   v-help-old-size = hh:width .
      485                                   hh:width-chars = 2.5 .
      486                               end.
      487                           when "b-print" then
      488                               do:
      489                                   hh:load-image("cmp/b-print.bmp":u) .
      490                                   hh:TOOLTIP = "Печать" .
      491                                   v-h[ii] = hh:handle .
      492                                   ii = ii + 1 .
      493                                   hh:width-chars = 3 .
      494                               end.
      495                           when "b-history" or
      496                           when "b-hist" then
      497                               do:
      498                                   hh:load-image("cmp/b-hist.bmp":u) .
      499                                   hh:TOOLTIP = "История" .
      500                                   v-h[ii] = hh:handle .
      501                                   ii = ii + 1 .
      502                                   hh:width-chars = 3 .
      503                               end.
      504                           when "b-sch" then
      505                               do:
      506                                   hh:load-image("cmp/b-sch.bmp":u) .
      507                                   hh:TOOLTIP = "Установка Фильтра" .
      508                                   v-h[ii] = hh:handle .
      509                                   ii = ii + 1 .
      510                                   hh:width-chars = 3 .
      511                               end.
      512                           when "b-hist-user" then
      513                               do:
      514                                   hh:load-image("cmp/b-hist.bmp":u) .
      515                                   hh:TOOLTIP = "История пользователя" .
      516                                   ii = ii + 1 .
      517                               end.
      518                       end case.
      519                   end.
      520                   hh = hh:next-sibling.
      521               end.
      522               b-help:column = v-frame-width - b-help:width-chars.
      523               jj = 0.
      524               repeat ii = 4 to 1 by -1 :
      525                   if valid-handle (v-h[ii] ) then
      526                   do:
      527                       jj  = jj + 1 .
      528                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      529                       v-h[ii]:row    = v-help-old-y .
      530                   end.
      531               end.
      532           end.
      533       end.
      534   end procedure.
      535   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      536   ON TAB ANYWHERE
      537   DO:
      538   define variable ii as integer no-undo .
      539   define variable fh as widget-handle no-undo .
      540   define variable hh as widget-handle no-undo .
      541   define variable v-next-widget-name as character no-undo .
      542   if v-tab-order <> '' then do:
      543     if self:type = "TOGGLE-BOX" then
      544     self:BGCOLOR = ?.
      545     assign
      546     ii = lookup(self:name, v-tab-order).
      547     assign
      548     ii = ii + 1
      549     v-next-widget-name = entry(ii, v-tab-order)
      550     no-error .
      551     if error-status:error then do:
      552       assign
      553       ii = 1
      554       v-next-widget-name = entry( ii, v-tab-order)
      555       .
      556     end.
      557     assign
      558     fh = frame Dialog-Frame:first-child
      559     hh = fh:first-child
      560     .
      561     do while valid-handle(hh):
      562       if hh:name = v-next-widget-name then do:
      563         if hh:sensitive  = yes
      564         AND hh:visible = yes then do:
      565           if hh:type = "TOGGLE-BOX":U then do:
      566             assign
      567             hh:BGcolor = 1
      568             .
      569           end.
      570           APPLY "ENTRY" to hh.
      571           return no-apply.
      572         end.
      573         else do:
      574           APPLY "TAB" to hh.
      575           return no-apply.
      576         end.
      577       end.
      578       hh = hh:next-sibling.
      579     end.
      580   end.
      581   END.
      582   ON BACK-TAB ANYWHERE
      583   DO:
      584   define variable ii as integer no-undo .
      585   define variable fh as widget-handle no-undo .
      586   define variable hh as widget-handle no-undo .
      587   define variable v-next-widget-name as character no-undo .
      588   if v-tab-order <> '' then do:
      589     assign
      590     ii = lookup(self:name, v-tab-order).
      591     .
      592     assign
      593     ii = (if ii = 1
      594           then  num-entries(v-tab-order)
      595           else ii - 1
      596           )
      597     v-next-widget-name = entry(ii, v-tab-order)
      598     .
      599     assign
      600     fh = frame Dialog-Frame:first-child
      601     hh = fh:first-child
      602     .
      603     do while valid-handle(hh):
      604       if hh:name = v-next-widget-name then do:
      605         if hh:sensitive  = yes
      606         AND hh:visible = yes then do:
      607           if hh:type = "TOGGLE-BOX":U then do:
      608             assign
      609             hh:BGcolor = 1
      610             .
      611           end.
      612           APPLY "ENTRY" to hh.
      613           return no-apply.
      614         end.
      615         else do:
      616         APPLY "BACK-TAB" to hh.
      617         return no-apply.
      618         end.
      619       end.
      620       hh = hh:next-sibling.
      621     end.
      622     end.
      623   END.
      624   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      625   ON RETURN ANYWHERE
      626   DO:
      627   define variable ii as integer no-undo .
      628   define variable fh as widget-handle no-undo .
      629   define variable hh as widget-handle no-undo .
      630   define variable v-next-widget-name as character no-undo .
      631     if v-tab-order <> '' then do:
      632       assign
      633       ii = lookup(self:name, v-tab-order).
      634       if ii = num-entries(v-tab-order) then do:
      635           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
      636           return no-apply.
      637       end.
      638       if self:type <> "BUTTON" and
      639         self:type <> "EDITOR"  then do:
      640         run proc-move-forward in this-procedure .
      641         return no-apply.
      642       end.
      643       if self:type = "BUTTON" then do:
      644         APPLY "CHOOSE" to self.
      645       end.
      646       if self:type = "TOGGLE-BOX" then
      647       self:BGCOLOR = ?.
      648       assign
      649       ii = ii + 1
      650       v-next-widget-name = entry(ii, v-tab-order)
      651       no-error .
      652       if error-status:error then do:
      653         assign
      654         ii = 1
      655         v-next-widget-name = entry( ii, v-tab-order)
      656         .
      657       end.
      658       assign
      659       fh = frame Dialog-Frame:first-child
      660       hh = fh:first-child
      661       .
      662       do while valid-handle(hh):
      663         if hh:name = v-next-widget-name then do:
      664           if hh:sensitive  = yes
      665           AND hh:visible = yes then do:
      666             if hh:type = "TOGGLE-BOX":U then do:
      667               assign
      668               hh:BGcolor = 1
      669               .
      670             end.
      671             APPLY "ENTRY" to hh.
      672             return no-apply.
      673           end.
      674           else do:
      675             APPLY "TAB" to hh.
      676             return no-apply.
      677           end.
      678         end.
      679         hh = hh:next-sibling.
      680       end.
      681     end.
      682   END.
      683   procedure proc-move-forward :
      684   define variable ii as integer no-undo .
      685   define variable fh as widget-handle no-undo .
      686   define variable hh as widget-handle no-undo .
      687   define variable v-next-widget-name as character no-undo .
      688   do
      689   on error undo, return error
      690   :
      691     if v-tab-order <> '' then do:
      692       if self:type = "TOGGLE-BOX" then
      693       self:BGCOLOR = ?.
      694       assign
      695       ii = lookup(self:name, v-tab-order).
      696       assign
      697       ii = ii + 1
      698       v-next-widget-name = entry(ii, v-tab-order)
      699       no-error .
      700       if error-status:error then do:
      701         assign
      702         ii = 1
      703         v-next-widget-name = entry( ii, v-tab-order)
      704         .
      705       end.
      706       assign
      707       fh = frame Dialog-Frame:first-child
      708       hh = fh:first-child
      709       .
      710       do while valid-handle(hh):
      711         if hh:name = v-next-widget-name then do:
      712           if hh:sensitive  = yes
      713           AND hh:visible = yes then do:
      714             if hh:type = "TOGGLE-BOX":U then do:
      715               assign
      716               hh:BGcolor = 1
      717               .
      718             end.
      719             APPLY "ENTRY" to hh.
      720             return.
      721           end.
      722           else do:
      723             assign
      724             ii = ii + 1
      725             v-next-widget-name = entry(ii, v-tab-order)
      726             no-error .
      727             if error-status:error then do:
      728               assign
      729               ii = 1
      730               v-next-widget-name = entry( ii, v-tab-order)
      731               .
      732             end.
      733           end.
      734         end.
      735         hh = hh:next-sibling.
      736       end.
      737     end.
      738   end.
      739   end procedure.
      740   MAIN-BLOCK:
      741   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      742      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      743     IF NUM-ENTRIES(p-value, chr(4))  = 3 THEN DO:
      744         ASSIGN
      745         f-series = ENTRY(1, p-value, chr(4) )
      746         f-number = ENTRY(2, p-value, chr(4) )
      747         v-dop   = ENTRY(3, p-value, chr(4) )
      748         f-date = DATE(
      749                       INTEGER(SUBSTRING(v-dop, 4, 2))
      750                      ,INTEGER(SUBSTRING(v-dop, 1, 2))
      751                      ,INTEGER(SUBSTRING(v-dop, 7, 4))
      752                      )
      753        .
      754    END.
      755     RUN enable_ui.
      756     WAIT-FOR GO OF FRAME Dialog-Frame.
      757   END.
      758   RUN disable_UI.
      759   PROCEDURE disable_UI :
      760     HIDE FRAME Dialog-Frame.
      761   END PROCEDURE.
      762   PROCEDURE enable_UI :
      763     DISPLAY f-series f-number f-date
      764         WITH FRAME Dialog-Frame.
      765     ENABLE B-exit b-quit B-Help f-series f-number f-date
      766         WITH FRAME Dialog-Frame.
      767     VIEW FRAME Dialog-Frame.
      768   END PROCEDURE.
