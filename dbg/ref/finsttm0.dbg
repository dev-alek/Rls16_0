rt-sum-doc       like ub.fin-statement.start-sum-doc        no-undo . define input parameter p-in-sum-doc          like ub.fin-statement.in-sum-doc           no-undo . define input parameter p-out-sum-doc         like ub.fin-statement.out-sum-doc          no-undo . define input parameter p-end-sum-doc         like ub.fin-statement.end-sum-doc          no-undo . define input parameter p-num-docs            like ub.fin-statement.num-docs             no-undo . define input parameter p-start-date          like ub.fin-statement.start-date           no-undo . define input parameter p-end-date            like ub.fin-statement.end-date             no-undo .
        8   define input parameter p-status_ as character no-undo .
