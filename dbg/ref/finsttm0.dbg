      123   procedure cur-time :
      124      define output parameter p-today as date      no-undo .
      125      define output parameter p-time  as integer   no-undo .
      126     do
      127     on error undo, return error
      128     :
      129       define variable v-date1 as date      no-undo .
      130       define variable v-date2 as date      no-undo .
      131       define variable v-time  as integer   no-undo .
      132       assign
      133         v-date1 = today
      134         v-time  = time
      135         v-date2 = today
      136       .
      137       if v-date1 <> v-date2
      138       then do:
      139         assign
      140           v-date1 = today
      141           v-time  = v-time
      142         .
      143       end.
      144       assign
      145         p-today = v-date1
      146         p-time  = v-time
      147       .
      148     end.
      149   end.
      150   function cur-time-date returns character
      151   :
      152     return string(today, '99/99/9999':U) .
      153   end.
      154   function cur-time-mjd returns decimal
      155   :
      156     define variable v-date as date      no-undo .
      157     define variable v-time as integer   no-undo .
      158     run cur-time in this-procedure
      159       (output v-date
      160       ,output v-time
      161       ) .
      162     return integer(v-date) - 2400002 + (v-time / 86400) .
      163   end.
      164   function cur-time-get-ending-index returns integer
      165   (input p-number as integer
      166   )
      167   :
      168     if p-number < 0
      169     or p-number = ?
      170     then do:
      171       return 1 .
      172     end.
      173     define variable v-rest as integer   no-undo .
      174     assign
      175       p-number = p-number modulo 100
      176     .
      177     if p-number < 20
      178     then do:
      179       assign
      180         v-rest = p-number
      181       .
      182     end.
      183     else do:
      184       assign
      185         v-rest = p-number modulo 10
      186       .
      187     end.
      188     case v-rest :
      189       when 1
      190       then do:
      191         return 2 .
      192       end.
      193       when 2 or
      194       when 3 or
      195       when 4
      196       then do:
      197         return 3 .
      198       end.
      199       otherwise do:
      200         return 1 .
      201       end.
      202     end case .
      203   end.
      204   procedure cur-time-mjd-to-date :
      205      define input  parameter i-mjd-diff as decimal no-undo.
      206      define output parameter o-Date     as date    no-undo.
      207      define output parameter o-Time     as integer no-undo.
      208      define variable v-day-number as integer   no-undo .
      209      if    i-mjd-diff < 0
      210         or i-mjd-diff = ?
      211      then do:
      212         return "?" .
      213      end.
      214      assign
      215         v-day-number = truncate(i-mjd-diff,0).
      216         o-Date = date(v-day-number + 2400002).
      217         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      218     .
      219   end.
      220   function cur-time-mjd-to-string returns character
      221   (input p-mjd-diff as decimal
      222   )
      223   :
      224     define variable v-day-number as integer   no-undo .
      225     define variable v-seconds    as integer   no-undo .
      226     define variable v-hour       as integer   no-undo .
      227     define variable v-min        as integer   no-undo .
      228     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      229     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      230     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      231     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      232     if p-mjd-diff < 0
      233     or p-mjd-diff = ?
      234     then do:
      235       return "?" .
      236     end.
      237     assign
      238       v-day-number = integer(truncate(p-mjd-diff,0))
      239       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      240     .
      241     if v-seconds > 86400
      242     then do:
      243       assign
      244         v-seconds = 86400 - 1
      245       .
      246     end.
      247     if v-seconds < 0
      248     then do:
      249       assign
      250         v-seconds = 0
      251       .
      252     end.
      253     assign
      254       v-hour = truncate(v-seconds / 3600, 0)
      255     .
      256     assign
      257       v-seconds = v-seconds modulo 3600
      258     .
      259     assign
      260       v-min = truncate(v-seconds / 60, 0)
      261     .
      262     assign
      263       v-seconds = v-seconds modulo 60
      264     .
      265     return
      266         (if v-day-number <> 0
      267           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      268           else ""
      269         )
      270       + (if v-day-number <> 0 or v-hour <> 0
      271           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      272           else ""
      273         )
      274       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      275           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      276           else ""
      277         )
      278       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      279       .
      280   end.
      281   function cur-time-string returns character
      282   :
      283     define variable v-date as date      no-undo .
      284     define variable v-time as integer   no-undo .
      285     run cur-time in this-procedure
      286       (output v-date
      287       ,output v-time
      288       ) .
      289     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      290   end.
      291   function cur-time-string-sec returns character
      292   :
      293     define variable v-date as date      no-undo .
      294     define variable v-time as integer   no-undo .
      295     run cur-time in this-procedure
      296       (output v-date
      297       ,output v-time
      298       ) .
      299     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      300   end.
      301   function cur-time-custom  returns character
      302   (input p-prefix as character
      303   ,input p-date-format as character
      304   ,input p-delimiter as character
      305   ,input p-time-format as character
      306   ,input p-suffix as character
      307   )
      308   :
      309     define variable v-date as date      no-undo .
      310     define variable v-time as integer   no-undo .
      311     run cur-time in this-procedure
      312       (output v-date
      313       ,output v-time
      314       ) .
      315     return
      316       p-prefix
      317       + string(v-date, p-date-format)
      318       + p-delimiter
      319       + string(v-time, p-time-format)
      320       + p-suffix
      321       .
      322   end.
      323   function cur-time-print  returns character
      324   :
      325     define variable v-date as date      no-undo .
      326     define variable v-time as integer   no-undo .
      327     run cur-time in this-procedure
      328       (output v-date
      329       ,output v-time
      330       ) .
      331     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      332   end.
      333   function cur-time-datetime returns datetime
      334   :
      335     define variable v-char as character no-undo .
      336     define variable v-datetime as datetime no-undo .
      337     v-char = cur-time-string().
      338     v-datetime = datetime(v-char).
      339     return  v-datetime.
      340   end.
      341   function cur-time-string-msec returns character
      342   :
      343     define variable v-date as datetime  no-undo .
      344     v-date = now.
      345     return string(v-date) .
      346   end.
      347   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      348   define temp-table tt-fin-statement no-undo like ub.fin-statement.
      349   procedure fin-statementh_write-fin-statement-history :
      350   define parameter buffer buf_fin-statement for tt-fin-statement.
      351   define input parameter p-host-code like ub.fin-statement.host-code no-undo .
      352   define input parameter p-sttm-code  like ub.fin-statement.sttm-code no-undo .
      353   define variable v-date as date no-undo .
      354   define variable v-time as integer no-undo .
      355   define variable v-message as character no-undo .
      356   define variable v-create-hist as logical no-undo .
      357   define variable v-result as character no-undo .
      358   define buffer buf_c-fin-statement for ub.c-fin-statement.
      359   define buffer buf_c-fin-statement-line for ub.c-fin-statement-line.
      360   define buffer buf_c-fin-statement-attr for ub.c-fin-statement-attr.
      361   define buffer prev_c-fin-statement-line for ub.c-fin-statement-line.
      362   define buffer prev_c-fin-statement-attr for ub.c-fin-statement-attr.
      363   do
      364   on error undo, return error return-value
      365   :
      366     run cur-time in this-procedure ( output v-date, output v-time).
      367     create buf_c-fin-statement.
      368     buffer-copy buf_fin-statement to buf_c-fin-statement
      369     assign
      370     buf_c-fin-statement.sttm-code          = p-sttm-code
      371     buf_c-fin-statement.host-code          = p-host-code
      372     buf_c-fin-statement.chip-num           = next-value (s-fin-corr-chip, ub)
      373     buf_c-fin-statement.corr-time          = v-time
      374     buf_c-fin-statement.corr-user-db-num   = g#db-num
      375     buf_c-fin-statement.corr-user-name     = g#userid
      376     buf_c-fin-statement.corr-date          = v-date
      377     .
      378     for each ub.fin-statement-line where
      379             ub.fin-statement-line.sttm-code = buf_fin-statement.sttm-code:
      380       create buf_c-fin-statement-line.
      381       buffer-copy ub.fin-statement-line to buf_c-fin-statement-line
      382       assign
      383       buf_c-fin-statement-line.chip-num           = buf_c-fin-statement.chip-num
      384       buf_c-fin-statement-line.corr-user-db-num   = buf_c-fin-statement.corr-user-db-num
      385       .
      386     end.
      387     for each ub.fin-statement-attr where
      388             ub.fin-statement-attr.sttm-code = buf_fin-statement.sttm-code:
      389       create buf_c-fin-statement-attr.
      390       buffer-copy ub.fin-statement-attr to buf_c-fin-statement-attr
      391       assign
      392       buf_c-fin-statement-attr.chip-num           = buf_c-fin-statement.chip-num
      393       buf_c-fin-statement-attr.corr-user-db-num   = buf_c-fin-statement.corr-user-db-num
      394       .
      395     end.
      396       release buf_c-fin-statement.
      397   end.
      398   end procedure.
      399   if p-mode <> 'ДОБАВЛЕНИЕ':U
      400   AND p-mode <> 'ИЗМЕНЕНИЕ':U
      401   then do:
      402     message
      403     vss-workfile vss-revision vss-description skip
      404     "Неверный параметр p-mode" p-mode
      405     view-as alert-box error .
      406     undo, return error '':u.
      407   end.
      408   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      409   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      410     (output v-db-num
      411     )  .
      412   find first buf_sysconf no-lock where
      413                   buf_sysconf.host-code = p-host-code.
      414   if not avail buf_sysconf then dO:
      415     run err-mess in this-procedure ( input substitute("Не найдена фирма с кодом &1", string(p-host-code)), output v-ret-mess).
      416     undo, return error (if p-silent = no then "host-code":U else v-ret-mess).
      417   end.
      418   if v-db-num <> buf_sysconf.firm-db-num
      419   then do:
      420     run err-mess in this-procedure ( input substitute("Нельзя изменять запись ВЫПИСКИ в БД, отличной от главной БД фирмы&3:" +
      421                              "номер текущей БД &1, номер главной БД фирмы &2", v-db-num, buf_sysconf.firm-db-num, chr(10)), output v-err-mess).
      422     undo, return error (if p-silent = no then "host-code":U else v-ret-mess).
      423   end.
      424   assign
      425   v-base-code = buf_sysconf.base-code
      426   .
      427   if p-prn-doc-code <> "":U
      428   then do:
      429     assign
      430     v-year-start-date = date(1, 1, year(p-doc-date))
      431     v-year-end-date = date(12, 31, year(p-doc-date))
      432     .
      433     IF can-find(first buf_fin-statement no-lock where
      434                       buf_fin-statement.host-code = p-host-code
      435                   AND buf_fin-statement.prn-doc-code = p-prn-doc-code
      436                   AND buf_fin-statement.fins-doc-type = p-fins-doc-type
      437                   AND (buf_fin-statement.doc-date >= v-year-start-date
      438                        and
      439                        buf_fin-statement.doc-date <= v-year-end-date)
      440                   AND (p-mode = 'ДОБАВЛЕНИЕ':U OR p-doc-rec <> recid(buf_fin-statement))
      441                   ) then do:
      442       run err-mess in this-procedure ( input substitute("Уже есть ВЫПИСКА с номером &1 для фирмы &2 за &3 год"
      443                                 , p-prn-doc-code
      444                                 , p-host-code
      445                                 , year(p-doc-date)), output v-ret-mess).
      446       undo, return error (if p-silent = no then "prn-doc-code":U else v-ret-mess).
      447     end.
      448   end.
      449   if p-doc-date = ? then do:
      450     run err-mess in this-procedure ( input "Неверная дата составления ВЫПИСКИ", output v-ret-mess).
      451     undo, return error (if p-silent = no then "doc-date":U else v-ret-mess).
      452   end.
      453   if p-curr-code <> 0 then do:
      454     find first buf_currency no-lock where
      455               buf_currency.curr-code = p-curr-code no-error.
      456     if not available buf_currency then do:
      457       run err-mess in this-procedure ( input substitute("Не найдена валюта с кодом &1", p-curr-code), output v-ret-mess).
      458       undo, return error (if p-silent = no then "curr-code":U else v-ret-mess) .
      459     end.
      460   end.
      461   if p-cli-name = '':U then do:
      462     run err-mess in this-procedure ( input substitute("Не задано имя держателя счета для выписки"), output v-ret-mess).
      463     undo, return error (if p-silent = no then "cli-name":U else v-ret-mess) .
      464   end.
      465   if p-bank-name = '':U then do:
      466     run err-mess in this-procedure ( input substitute("Не задано название банка для выписки"), output v-ret-mess).
      467     undo, return error (if p-silent = no then "cli-name":U else v-ret-mess) .
      468   end.
      469   if p-bank-city = '':U then do:
      470     run err-mess in this-procedure ( input substitute("Не задан город банка для выписки"), output v-ret-mess).
      471     undo, return error (if p-silent = no then "cli-name":U else v-ret-mess) .
      472   end.
      473   if p-lines-exist then do:
      474     find first buf_fin-schet no-lock where
      475               buf_fin-schet.host-code = p-host-code
      476           AND buf_fin-schet.code-schet = p-code-schet no-error.
      477     if not available buf_fin-schet then do:
      478       run err-mess in this-procedure ( input substitute("Не найден РАСЧЕТНЫЙ СЧЕТ: фирма &1 код счета &2"
      479                                                       , p-host-code
      480                                                       , p-code-schet)
      481                                     , output v-ret-mess).
      482       undo, return error (if p-silent = no then "code-schet":U else v-ret-mess).
      483     end.
      484     if buf_fin-schet.curr-code <> p-curr-code then do:
      485       run err-mess in this-procedure ( input substitute("Валюта РАСЧЕТНОГО СЧЕТА: фирма &1 код счета &2 валюта &3 - не совпадает с валютой ВЫПИСКИ &4",
      486       p-host-code, p-code-schet, buf_fin-schet.curr-code, p-curr-code) , output v-ret-mess).
      487       undo, return error (if p-silent = no then "code-schet":U else v-ret-mess).
      488     end.
      489     if buf_fin-schet.code-bank <> p-code-bank then do:
      490       run err-mess in this-procedure ( input substitute("Банк РАСЧЕТНОГО СЧЕТА: фирма &1 код счета &2 код банка &3 - не совпадает с кодом банка ВЫПИСКИ &4",
      491       p-host-code, p-code-schet, buf_fin-schet.code-bank, p-code-bank) , output v-ret-mess).
      492       undo, return error (if p-silent = no then "code-schet":U else v-ret-mess).
      493     end.
      494     if not (buf_fin-schet.cli-type = 'орг':U
      495     and buf_fin-schet.cli-code = p-host-code ) then do:
      496       run err-mess in this-procedure ( input substitute("Держатель РАСЧЕТНОГО СЧЕТА (фирма &1 р/счет &2 код счета &3)&6&4&5 - не является СВОЕЙ ФИРМОЙ&6" +
      497                                                          "выписку можно создавать только для счетов СВОЕЙ ФИРМЫ"
      498                                                          ,p-host-code
      499                                                          ,buf_fin-schet.r-schet
      500                                                          ,buf_fin-schet.code-schet
      501                                                          ,buf_fin-schet.cli-type
      502                                                          ,buf_fin-schet.cli-code
      503                                                          ,chr(10)
      504                                                          )
      505                                                 , output v-ret-mess).
      506       undo, return error (if p-silent = no then "code-schet":U else v-ret-mess).
      507     end.
      508   end.
      509   if p-status_ <> 'новый':U
      510   and p-author <> '':U
      511   then do:
      512     if v-base-code <> 0 then do:
      513   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      514   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
      515     (input  v-base-code
      516     ,input  p-fact-date
      517     ,output v-base-rate
      518     ,output v-base-scale
      519     ,output v-curr-abbr
      520     )  .
      521     end.
      522     if p-curr-code <> 0 then do:
      523   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      524   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
      525     (input  p-curr-code
      526     ,input  p-fact-date
      527     ,output v-exch-rate
      528     ,output v-exch-scale
      529     ,output v-curr-abbr
      530     )  .
      531     end.
      532     assign
      533     v-sum-doc = p-sum-doc
      534     v-sum-rubl = (if p-curr-code = 0
      535                   then p-sum-doc
      536                   else (p-sum-doc * v-exch-rate / v-exch-scale))
      537     v-sum-base = if v-base-code = 0
      538                   then v-sum-rubl
      539                   else (v-sum-rubl / v-base-rate * v-base-scale)
      540     v-in-sum-doc = p-in-sum-doc
      541     v-in-sum-rubl = (if p-curr-code = 0
      542                   then p-in-sum-doc
      543                   else (p-in-sum-doc * v-exch-rate / v-exch-scale))
      544     v-in-sum-base = if v-base-code = 0
      545                   then v-in-sum-rubl
      546                   else (v-in-sum-rubl / v-base-rate * v-base-scale)
      547     v-out-sum-doc = p-out-sum-doc
      548     v-out-sum-rubl = (if p-curr-code = 0
      549                   then p-out-sum-doc
      550                   else (p-out-sum-doc * v-exch-rate / v-exch-scale))
      551     v-out-sum-base = if v-base-code = 0
      552                   then v-out-sum-rubl
      553                   else (v-out-sum-rubl / v-base-rate * v-base-scale)
      554     v-start-sum-doc = p-start-sum-doc
      555     v-start-sum-rubl = (if p-curr-code = 0
      556                   then p-start-sum-doc
      557                   else (p-start-sum-doc * v-exch-rate / v-exch-scale))
      558     v-start-sum-base = if v-base-code = 0
      559                   then v-start-sum-rubl
      560                   else (v-start-sum-rubl / v-base-rate * v-base-scale)
      561     v-end-sum-doc = p-end-sum-doc
      562     v-end-sum-rubl = (if p-curr-code = 0
      563                   then p-end-sum-doc
      564                   else (p-end-sum-doc * v-exch-rate / v-exch-scale))
      565     v-end-sum-base = if v-base-code = 0
      566                   then v-end-sum-rubl
      567                   else (v-end-sum-rubl / v-base-rate * v-base-scale)
      568     .
      569   end.
      570   if lookup(p-fins-ext-doc-type, 'стд':U) = 0 then do:
      571     run err-mess in this-procedure ( input substitute("Неверный расширенный тип выписки &1", p-fins-ext-doc-type), output v-ret-mess ).
      572     undo, return error (if p-silent = no then  "fins-ext-doc-type":U  else v-ret-mess).
      573   end.
      574   CASE p-fins-doc-type:
      575     when 'стд':U then do:
      576       run ref/finstm01.p (
      577                       input p-mode
      578                       ,input "":U
      579                       ,input p-host-code            ,input p-sttm-code            ,input p-curr-code            ,input p-doc-date             ,input p-bank-date            ,input p-fact-date            ,input p-fins-doc-type        ,input p-fins-ext-doc-type    ,input p-code-bank            ,input p-bank-name            ,input p-bank-city            ,input p-bik                  ,input p-code-schet           ,input p-r-schet              ,input p-c-schet              ,input p-cli-name             ,input p-prn-doc-code         ,input p-PS                   ,input p-sum-doc              ,input p-start-sum-doc-th     ,input p-start-sum-doc        ,input p-in-sum-doc           ,input p-out-sum-doc          ,input p-end-sum-doc          ,input p-num-docs             ,input p-start-date           ,input p-end-date
      580                       ,input "":U
      581                       ,input ?
      582                       ,output v-correct
      583                       ,output v-err-mess
      584                       ) no-error.
      585     end.
      586   END CASE.
      587   _MAIN:
      588   DO ON ERROR UNDO, RETURN ERROR
      589   ON STOP UNDO, RETURN ERROR:
      590     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      591       if p-sttm-code = 0 then do:
      592         assign
      593         p-sttm-code = next-value(s-fin-sttm, ub)
      594         .
      595       end.
      596       create ub.fin-statement.
      597       assign
      598       ub.fin-statement.host-code = p-host-code
      599       ub.fin-statement.sttm-code = p-sttm-code
      600       ub.fin-statement.status_ = 'новый':U
      601       p-doc-rec = recid(ub.fin-statement)
      602       .
      603     end.
      604     else do:
      605       FIND FIRST ub.fin-statement where
      606                 recid(ub.fin-statement) = p-doc-rec No-ERROR.
      607       if not available ub.fin-statement then do:
      608         run err-mess in this-procedure ( input substitute("Не найдена запись ВЫПИСКИ - p-doc-rec &1", p-doc-rec), output v-ret-mess).
      609         undo, return error (if p-silent = no then  '':u  else v-ret-mess).
      610       end.
      611       if ub.fin-statement.host-code <> p-host-code
      612       OR ub.fin-statement.sttm-code <> p-sttm-code
      613       OR ub.fin-statement.fins-doc-type <> p-fins-doc-type
      614       OR ub.fin-statement.fins-doc-type <> p-fins-doc-type
      615       OR (p-lines-exist
      616           AND (
      617           ub.fin-statement.bank-name           <> p-bank-name
      618           or
      619           ub.fin-statement.bik                 <> p-bik
      620           or
      621           ub.fin-statement.c-schet             <> p-c-schet
      622           or
      623           ub.fin-statement.code-schet          <> p-code-schet
      624           or
      625           ub.fin-statement.r-schet             <> p-r-schet
      626               )
      627       )
      628       then do:
      629         run err-mess in this-procedure ( input substitute("Для уже имеющейся записи нельзя изменить&1" +
      630                                  "код фирмы, внутренний № выписки, тип выписки, счет&1"
      631                                  , chr(10)), output v-ret-mess).
      632         undo, return error (if p-silent = no then  '':U  else v-ret-mess).
      633       end.
      634       if ub.fin-statement.status_ <> 'новый':U
      635       then do:
      636         if
      637         ub.fin-statement.start-sum-doc       <> p-start-sum-doc
      638         or
      639         ub.fin-statement.end-sum-doc         <> p-end-sum-doc
      640         or
      641         ub.fin-statement.in-sum-doc          <> p-in-sum-doc
      642         or
      643         ub.fin-statement.out-sum-doc         <> p-out-sum-doc
      644         or
      645         ub.fin-statement.sum-doc             <> p-sum-doc
      646         then do:
      647           run err-mess in this-procedure ( input substitute("Для ВЫПИСКИ в статусе не &1&2" +
      648                                   "НЕЛЬЗЯ менять суммы остатков, оборотов, счет, валюту платежа&2"
      649                                   ,'новый':U
      650                                   , chr(10))
      651                         , output v-ret-mess).
      652           undo, return error (if p-silent = no then  '':U  else v-ret-mess).
      653         end.
      654       end.
      655     end.
      656     create tt-fin-statement.
      657     buffer-copy ub.fin-statement to tt-fin-statement.
      658     assign
      659     ub.fin-statement.curr-code           = p-curr-code
      660     ub.fin-statement.doc-date            = p-doc-date
      661     ub.fin-statement.fins-doc-type       = p-fins-doc-type
      662     ub.fin-statement.fins-ext-doc-type   = p-fins-ext-doc-type
      663     ub.fin-statement.bank-name           = p-bank-name
      664     ub.fin-statement.bank-city           = p-bank-city
      665     ub.fin-statement.bik                 = p-bik
      666     ub.fin-statement.c-schet             = p-c-schet
      667     ub.fin-statement.code-schet          = p-code-schet
      668     ub.fin-statement.code-bank           = p-code-bank
      669     ub.fin-statement.r-schet             = p-r-schet
      670     ub.fin-statement.prn-doc-code        = p-prn-doc-code
      671     ub.fin-statement.PS                  = p-PS
      672     ub.fin-statement.cli-name            = p-cli-name
      673     ub.fin-statement.start-date          = p-start-date
      674     ub.fin-statement.end-date            = p-end-date
      675     .
      676     if p-author <> '':U
      677     or p-status_ = 'новый':U
      678     then do:
      679       assign
      680       ub.fin-statement.sum-base            = v-sum-base
      681       ub.fin-statement.sum-doc             = p-sum-doc
      682       ub.fin-statement.sum-rubl            = v-sum-rubl
      683       ub.fin-statement.in-sum-base         = v-in-sum-base
      684       ub.fin-statement.in-sum-doc          = p-in-sum-doc
      685       ub.fin-statement.in-sum-rubl         = v-in-sum-rubl
      686       ub.fin-statement.out-sum-base        = v-out-sum-base
      687       ub.fin-statement.out-sum-doc         = p-out-sum-doc
      688       ub.fin-statement.out-sum-rubl        = v-out-sum-rubl
      689       ub.fin-statement.start-sum-base      = v-start-sum-base
      690       ub.fin-statement.start-sum-doc       = p-start-sum-doc
      691       ub.fin-statement.start-sum-doc-th    = p-start-sum-doc-th
      692       ub.fin-statement.start-sum-rubl      = v-start-sum-rubl
      693       ub.fin-statement.end-sum-base        = v-end-sum-base
      694       ub.fin-statement.end-sum-doc         = p-end-sum-doc
      695       ub.fin-statement.end-sum-rubl        = v-end-sum-rubl
      696       ub.fin-statement.num-docs            = p-num-docs
      697       .
      698     end.
      699     release ub.fin-statement no-error.
      700     if error-status:error then do:
      701      run err-mess in this-procedure ( input substitute("Ошибка при сохранении записи ПЛАТЕЖА &1: &2", ERROR-STATUS:GET-message(1), return-value ), output v-ret-mess).
      702       undo, return error (if p-silent = no then  "":U  else v-ret-mess).
      703     end.
      704     find last buf_c-fin-statement no-lock where
      705               buf_c-fin-statement.host-code = p-host-code
      706           AND  buf_c-fin-statement.sttm-code = p-sttm-code
      707           AND  buf_c-fin-statement.corr-user-db-num = g#db-num no-error.
      708     if not available buf_c-fin-statement
      709     or (available buf_c-fin-statement
      710     and buf_c-fin-statement.corr-user-name <> g#userid)
      711     then do:
      712       run fin-statementh_write-fin-statement-history in this-procedure (
      713                                                               buffer tt-fin-statement
      714                                                               ,input p-host-code
      715                                                               ,input p-sttm-code
      716                                                               ) no-error .
      717       if error-status:error then do:
      718           v-mes = error-status:get-message(1) .
      719           run err-mess in this-procedure ( input v-mes, output v-ret-mess).
      720           undo _main, return error (if p-silent  = no then '':U else v-ret-mess).
      721       end.
      722     end.
      723   end.
      724   PROCEDURE err-mess:
      725     DEFINE INPUT PARAMETER p-mess as character No-UNDO.
      726     define output parameter p-ret-mess as character no-undo .
      727     assign
      728     p-ret-mess =  substitute("ВЫПИСКА &1: фирма: &2 N: &3,&4 вн. № &5&4&6"
      729                               , p-fins-doc-type
      730                               , p-host-code
      731                               , p-prn-doc-code
      732                               , chr(10)
      733                               , p-sttm-code
      734                               , p-mess
      735                               ).
      736     CASE p-silent:
      737       when no then do:
      738         message
      739         p-mess
      740         view-as alert-box error .
      741       end.
      742     end.
      743   END PROCEDURE.
