      297   DEFINE BUFFER buf_price-list-type FOR ub.price-list-type.
      298   DEFINE BUTTON B-dis-time-rule
      299        IMAGE-UP FILE "btn-down-arrow":U
      300        IMAGE-DOWN FILE "btn-down-arrow":U
      301        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      302        LABEL ""
      303        SIZE 3 BY 1.
      304   DEFINE BUTTON B-exit AUTO-GO
      305        LABEL "&Ввод"
      306        SIZE 10 BY 1
      307        BGCOLOR 8 .
      308   DEFINE BUTTON B-Help
      309        LABEL "Помо&щь"
      310        SIZE 3 BY 1
      311        BGCOLOR 8 .
      312   DEFINE BUTTON B-hist
      313        LABEL "Ис&тория"
      314        SIZE 3 BY 1.
      315   DEFINE BUTTON B-plt
      316        IMAGE-UP FILE "btn-down-arrow":U
      317        IMAGE-DOWN FILE "btn-down-arrow":U
      318        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      319        LABEL ""
      320        SIZE 3 BY 1.
      321   DEFINE BUTTON b-plt-lookup
      322        LABEL "&Просмотр"
      323        SIZE 10 BY 1.
      324   DEFINE BUTTON b-quit AUTO-END-KEY
      325        LABEL "&Отмена"
      326        SIZE 10 BY 1
      327        BGCOLOR 8 .
      328   DEFINE BUTTON B-time-rule-lookup
      329        LABEL "&Распис."
      330        SIZE 10 BY 1.
      331   DEFINE VARIABLE f-pos-type AS CHARACTER FORMAT "X(256)":U
      332        LABEL "Место исп."
      333        VIEW-AS COMBO-BOX INNER-LINES 5
      334        LIST-ITEM-PAIRS "Item 1","Item 1"
      335        DROP-DOWN-LIST
      336        SIZE 21 BY 1 NO-UNDO.
