       20   define variable vss-revision    as character no-undo init "$Revision$":U .
       21   define variable vss-author      as character no-undo init "$Author$":U .
       22   define variable vss-date        as character no-undo init "$Date$":U .
       23   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       24   define variable vss-archive     as character no-undo init "$Archive$":U .
       25   define variable vss-description as character no-undo init "Редактирование правил скидок по шаблону 75".
       26   procedure vss-get-info :
       27     define output parameter p-vss-revision    like vss-revision    no-undo .
       28     define output parameter p-vss-author      like vss-author      no-undo .
       29     define output parameter p-vss-date        like vss-date        no-undo .
       30     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       31     define output parameter p-vss-archive     like vss-archive     no-undo .
       32     define output parameter p-vss-description like vss-description no-undo .
       33     assign
       34       p-vss-revision    = vss-revision
       35       p-vss-author      = vss-author
       36       p-vss-date        = vss-date
       37       p-vss-workfile    = vss-workfile
       38       p-vss-archive     = vss-archive
       39       p-vss-description = vss-description
       40     .
       41   end procedure.
       42   procedure vss-get-parameters :
       43     define output parameter p-vss-parameters as character no-undo .
       44   end procedure.
       45   define new global shared variable g#vssrevis-logger as handle    no-undo .
       46   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       47   define variable v-vssrevis-logger                   as handle    no-undo .
       48   procedure vss-logevent :
       49     define input  parameter p-extra-paramters as character no-undo .
       50     define variable v-vssrevis-parameters as character no-undo .
       51     do
       52     on error undo, return error return-value
       53     :
       54       if  valid-handle(v-vssrevis-logger)
       55       and v-vssrevis-logger :get-signature("logevent") <> ""
       56       then do:
       57         run vss-get-parameters in this-procedure
       58           (output v-vssrevis-parameters
       59           ).
       60         run logevent in v-vssrevis-logger
       61           (input vss-workfile
       62           ,input vss-revision
       63           ,input v-vssrevis-parameters
       64           ,input p-extra-paramters
       65           ).
       66       end.
       67     end.
       68   end procedure.
       69   assign
       70     v-vssrevis-logger = g#vssrevis-logger
       71   .
       72   if  valid-handle(v-vssrevis-logger)
       73   and v-vssrevis-logger :get-signature("logevent") <> ""
       74   then do:
       75     assign
       76       v-vssrevis-logevent = true
       77     .
       78     run vss-logevent in this-procedure (input vss-description) .
       79   end.
       80   define new global shared variable g#language as character no-undo .
       81   if g#language <> '' and g#language <> 'rus':U then do:
       82     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       83   end.
       84   define new global shared variable g#library  as handle no-undo .
       85   define new global shared variable g#library2 as handle no-undo .
       86   procedure proc-alt-shift-f2:
       87     if not ibs.th.gbl.gbl-var:rcode
       88   then
       89     run gbl\inidebug.p .
       90   end.
       91   procedure proc-alt-shift-f3:
       92     run gbl/prvssinf.p
       93       ( input this-procedure
       94       ) .
       95   end.
       96   define variable v-inform-launched as logical no-undo initial false .
       97   procedure proc-alt-shift-f4:
       98     define variable v-action as character no-undo .
       99     if v-inform-launched = false then do:
      100       assign
      101         v-inform-launched = true
      102       .
      103       run gbl/d-inform.w
      104         (  input self
      105         ,  input this-procedure
      106         , output v-action
      107         ) no-error .
      108       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      109       assign
      110         v-inform-launched = false
      111       .
      112     end.
      113   end.
      114   procedure proc-alt-f1:
      115     run gbl/corrhelp.p
      116       (input this-procedure
      117       ) .
      118   end .
      119   on alt-shift-f2 anywhere do:
      120     run proc-alt-shift-f2.
      121   end.
      122   on alt-shift-f3 anywhere do:
      123     run proc-alt-shift-f3 in this-procedure .
      124   end.
      125   on alt-shift-f4 anywhere do:
      126     run proc-alt-shift-f4 in this-procedure.
      127   end.
      128   on alt-f1 anywhere do:
      129     run proc-alt-f1 in this-procedure .
      130   end.
      131   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      132   procedure dr-code :
      133     do
      134     on error undo, return error
      135     :
      136       define input  parameter  p-templ-rl-root     like ub.dis-rule.templ-rl-root     no-undo .
      137       define output parameter  p-des               like ub.dis-rule.des               no-undo .
      138       define output parameter  p-discnt-type       like ub.dis-rule.discnt-type       no-undo .
      139       define output parameter  p-subject-type      like ub.dis-rule.subject-type      no-undo .
      140       define output parameter  p-value-type        like ub.dis-rule.value-type        no-undo .
      141       define output parameter  p-level-1           as character no-undo .
      142       define output parameter  p-level-2           as character no-undo .
      143       define output parameter  p-global             as integer no-undo .
      144       define output parameter  p-host               as integer no-undo .
      145       define output parameter  p-object             as integer no-undo .
      146       define output parameter  p-output-display as logical   no-undo .
      147       define output parameter  p-tree           as char  no-undo .
      148       define output parameter  p-other          as character no-undo .
      149       define variable v-other as character no-undo .
      150       define buffer buf_dis-rule for ub.dis-rule .
      151       define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      152       find first buf_dis-rule no-lock where
      153                 buf_dis-rule.rule-num = p-templ-rl-root no-error.
      154       find first buf_dis-cfg-rule no-lock where
      155               buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
      156           and buf_dis-cfg-rule.pos-type = '':U
      157           and buf_dis-cfg-rule.table-name = '':U
      158           and buf_dis-cfg-rule.discnt-role = '':U
      159           and buf_dis-cfg-rule.self-nonunique = '':U
      160               no-error.
      161       if not available buf_Dis-cfg-rule then do:
      162           undo, return error substitute("неизвестный шаблон скидки &1", p-templ-rl-root ).
      163       end.
      164       assign
      165       p-des = buf_dis-rule.des
      166       p-discnt-type = buf_dis-rule.discnt-type
      167       p-subject-type = buf_dis-rule.subject-type
      168       p-value-type = buf_dis-rule.value-type
      169       p-global = (if available buf_dis-cfg-rule
      170                   then buf_dis-cfg-rule.has-global
      171                   else 0)
      172       p-host = (if available buf_dis-cfg-rule
      173                 then buf_dis-cfg-rule.has-host
      174                 else 0)
      175       p-object = (if available buf_dis-cfg-rule
      176                 then buf_dis-cfg-rule.has-obj
      177                 else 0)
      178       p-output-display = (buf_dis-rule.sts = integer('0':U))
      179       p-tree = buf_Dis-rule.uniq-field
      180       p-other = buf_dis-rule.other-inf
      181       p-level-1 = entry(1, buf_dis-cfg-rule.other-inf, ";":U)
      182       p-level-2 = (if num-entries(buf_dis-cfg-rule.other-inf, ";":U) > 1
      183                    then entry(2, buf_dis-cfg-rule.other-inf, ";":U)
      184                    else '')
      185       .
      186     end.
      187   end procedure.
      188   define temp-table temp-drt-prop no-undo like ub.drt-prop.
      189   procedure disrules-fill-properties:
      190   define input  parameter p-templ-rl-root as integer   no-undo .
      191   define buffer buf_drt-prop for ub.drt-prop.
      192   define buffer buf_temp-drt-prop for temp-drt-prop.
      193   do
      194   on error undo, return error return-value
      195   :
      196     for each buf_temp-drt-prop:
      197       delete buf_temp-drt-prop.
      198     end.
      199     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
      200       create buf_temp-drt-prop.
      201       buffer-copy buf_drt-prop to buf_temp-drt-prop.
      202     end.
      203   end.
      204   end procedure.
      205   procedure disrules-get-interface-form :
      206   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
      207   define output parameter p-form-name as character no-undo .
      208   define buffer buf_temp-drt-prop for temp-drt-prop.
      209   define buffer buf_drt-prop for ub.drt-prop.
      210   find first buf_temp-drt-prop where
      211             buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
      212         and buf_temp-drt-prop.upper-prop-code = "InputForm"
      213         and buf_temp-drt-prop.prop-code = "FormName" no-error.
      214   if not available buf_temp-drt-prop then do:
      215     find first buf_drt-prop where
      216               buf_drt-prop.templ-rl-root = p-templ-rl-root
      217           and buf_drt-prop.upper-prop-code = "InputForm"
      218           and buf_drt-prop.prop-code = "FormName" no-error.
      219     if available buf_drt-prop then do:
      220       p-form-name = buf_drt-prop.property-value.
      221     end.
      222     else do:
      223       p-form-name = "ref/dis-ruli.w".
      224     end.
      225   end.
      226   else do:
      227     p-form-name = buf_temp-drt-prop.property-value.
      228   end.
      229   end procedure.
      230   ~
      231   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      232   FUNCTION gtregion RETURNS CHARACTER
      233     ( input parhost-code as integer
      234     , input parobj-type as character
      235     , input parobj-code as integer
      236     , input p-tab as logical
      237     ) :
      238     def var par-region as character no-undo.
      239     if parhost-code = 0 and
      240          parobj-type = "":U and
      241          parobj-code = 0 then do:
      242          par-region = "Глобально".
      243          return par-region.
      244       end.
      245       if parobj-type = "" and
      246          parobj-code = 0 then do:
      247          par-region = if p-tab then fill(chr(32), 2) else "":U +
      248                       "Фирма" + chr(32) + string(parhost-code).
      249          return par-region.
      250       end.
      251       par-region = if p-tab then fill(chr(32), 4) else "":U +
      252                    parobj-type + chr(32) + string(parobj-code).
      253       return par-region.
      254   END FUNCTION.
