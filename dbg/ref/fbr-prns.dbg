      853     define variable v-window-width         as decimal   no-undo .
      854     define variable v-window-virtual-width as decimal   no-undo .
      855     define variable v-change-sign          as integer   no-undo .
      856     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      857     define buffer buf_temp-browse-handle  for temp-browse-handle .
      858     if p-change-value > 0
      859     then do:
      860       if frame Dialog-Frame :width + p-change-value >
      861           session :width-chars
      862       then do:
      863         assign
      864           p-change-value = session :width-chars - frame Dialog-Frame :width
      865         .
      866         if p-change-value <= 0
      867         then do:
      868           run diasize_position-resize-button in this-procedure .
      869           return .
      870         end.
      871       end.
      872     end.
      873     if p-change-value < 0
      874     then do:
      875       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
      876       then do:
      877         assign
      878           p-change-value = v-diasize-orig-frame-width
      879                          - frame Dialog-Frame :width
      880         .
      881         if p-change-value >= 0
      882         then do:
      883           run diasize_position-resize-button in this-procedure .
      884           return .
      885         end.
      886       end.
      887     end.
      888     if p-change-value >= 0
      889     then do:
      890       assign
      891         v-change-sign = 1
      892       .
      893     end.
      894     else do:
      895       assign
      896         v-change-sign = -1
      897       .
      898     end.
      899     assign
      900       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      901     .
      902     if p-change-value = 0
      903     then do:
      904       run diasize_position-resize-button in this-procedure .
      905       return .
      906     end.
