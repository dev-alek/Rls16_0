        1   DEFINE BUFFER buf_fbr-prn FOR ub.fbr-prn.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter par-mode as character no-undo.
        4   define input parameter p-db-num like ub.fbr-prn.db-num no-undo.
        5   define input parameter bttns as character no-undo.
        6   define input-output parameter par-recid       as recid no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision$":U .
        8   define variable vss-author      as character no-undo init "$Author$":U .
        9   define variable vss-date        as character no-undo init "$Date$":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       11   define variable vss-archive     as character no-undo init "$Archive$":U .
       12   define variable vss-description as character no-undo init "Список принтеров кухни".
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define new global shared variable g#library  as handle no-undo .
       72   define new global shared variable g#library2 as handle no-undo .
       73   procedure proc-alt-shift-f2:
       74     if not ibs.th.gbl.gbl-var:rcode
       75   then
       76     run gbl\inidebug.p .
       77   end.
       78   procedure proc-alt-shift-f3:
       79     run gbl/prvssinf.p
       80       ( input this-procedure
       81       ) .
       82   end.
       83   define variable v-inform-launched as logical no-undo initial false .
       84   procedure proc-alt-shift-f4:
       85     define variable v-action as character no-undo .
       86     if v-inform-launched = false then do:
       87       assign
       88         v-inform-launched = true
       89       .
       90       run gbl/d-inform.w
       91         (  input self
       92         ,  input this-procedure
       93         , output v-action
       94         ) no-error .
       95       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       96       assign
       97         v-inform-launched = false
       98       .
       99     end.
      100   end.
      101   procedure proc-alt-f1:
      102     run gbl/corrhelp.p
      103       (input this-procedure
      104       ) .
      105   end .
      106   on alt-shift-f2 anywhere do:
      107     run proc-alt-shift-f2.
      108   end.
      109   on alt-shift-f3 anywhere do:
      110     run proc-alt-shift-f3 in this-procedure .
      111   end.
      112   on alt-shift-f4 anywhere do:
      113     run proc-alt-shift-f4 in this-procedure.
      114   end.
      115   on alt-f1 anywhere do:
      116     run proc-alt-f1 in this-procedure .
      117   end.
      118   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      119     define variable v-cntxt-db-num        as integer   no-undo .
      120     define variable v-cntxt-userid        as character no-undo .
      121     define variable v-cntxt-level         as character no-undo .
      122     define variable v-cntxt-host-code-obj as integer   no-undo .
      123     define variable v-cntxt-obj-type      as character no-undo .
      124     define variable v-cntxt-obj-code      as integer   no-undo .
      125     define variable v-cntxt-db-num-obj    as integer   no-undo .
      126     define variable v-cntxt-is-admin      as logical   no-undo .
      127   define variable v-db-num like ub.db.db-num no-undo.
      128   define variable v-doc-rec as recid no-undo .
      129   FUNCTION get-object-name RETURNS CHARACTER
      130     ( input p-obj-type as character, input p-obj-code as integer )  FORWARD.
      131   DEFINE BUTTON B-add
      132        LABEL "&Добавить"
      133        SIZE 10 BY 1.
      134   DEFINE BUTTON B-chg
      135        LABEL "&Изменить"
      136        SIZE 10 BY 1.
      137   DEFINE BUTTON B-del
      138        LABEL "&Удалить"
      139        SIZE 10 BY 1.
      140   DEFINE BUTTON B-exit AUTO-GO
      141        LABEL "&Выход"
      142        SIZE 10 BY 1
      143        BGCOLOR 8 .
      144   DEFINE BUTTON B-gds
      145        LABEL "&Товары"
      146        SIZE 10 BY 1.
      147   DEFINE BUTTON B-grp
      148        LABEL "&Группы"
      149        SIZE 10 BY 1.
      150   DEFINE BUTTON B-Help
      151        LABEL "Помо&щь"
      152        SIZE 10 BY 1
      153        BGCOLOR 8 .
      154   DEFINE BUTTON B-sel AUTO-GO
      155        LABEL "Вы&бор"
      156        SIZE 10 BY 1.
      157   DEFINE QUERY BR-prn FOR
      158         buf_fbr-prn SCROLLING.
      159   DEFINE BROWSE BR-prn
      160     QUERY BR-prn DISPLAY
      161         buf_fbr-prn.prn-num FORMAT ">>9":U
      162         buf_fbr-prn.db-num FORMAT ">>>>9":U
      163         buf_fbr-prn.prn-name FORMAT "X(40)":U
      164         buf_fbr-prn.prn-type FORMAT "X(8)":U
      165         buf_fbr-prn.fbr-obj-type + string(buf_fbr-prn.fbr-obj-code) COLUMN-LABEL "Объект" FORMAT "X(8)":U
      166         get-object-name(buf_fbr-prn.fbr-obj-type, buf_fbr-prn.fbr-obj-code) COLUMN-LABEL "производства" FORMAT "X(20)":U
      167       WITH NO-ROW-MARKERS SEPARATORS SIZE 98.13 BY 18.42.
      168   DEFINE FRAME Dialog-Frame
      169        B-exit AT ROW 1 COL 1
      170        B-sel AT ROW 1 COL 21
      171        B-add AT ROW 1 COL 31
      172        B-del AT ROW 1 COL 41
      173        B-chg AT ROW 1 COL 51
      174        B-grp AT ROW 1 COL 61
      175        B-gds AT ROW 1 COL 71
      176        B-Help AT ROW 1 COL 81
      177        BR-prn AT ROW 2.88 COL 1
      178        SPACE(0.11) SKIP(0.73)
      179       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      180            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      181            TITLE "Принтера кухни"
      182            DEFAULT-BUTTON B-exit.
      183   ASSIGN
      184          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      185          FRAME Dialog-Frame:HIDDEN           = TRUE.
      186   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      187   DO:
      188     APPLY "END-ERROR":U TO SELF.
      189   END.
      190   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      191   DO:
      192     define variable v-recid as recid no-undo.
      193     define variable loc#log as logical no-undo .
      194   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      195   do:
      196     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      197       (input  v-cntxt-db-num
      198       ,input  v-cntxt-userid
      199       ,input  0
      200       ,input  'actn_fbr-prn_work':U
      201       ,input  'global':U
      202       ,input  0
      203       ,input  '':U
      204       ,input  0
      205       ,input  0
      206       ,input  0
      207       ,input  0
      208       ,input  true
      209       ,output loc#log
      210       )  .
      211   end.
      212     if not loc#log then return no-apply.
      213     run ref/fbr-prni.w ( input parparentproc
      214                         ,input 'ДОБАВЛЕНИЕ':U
      215                         ,input v-db-num
      216                         ,input 0
      217                         ,output v-recid).
      218     if v-recid <> ? then do:
      219         assign
      220         par-recid = v-recid.
      221         run openBr in this-procedure.
      222     end.
      223   END.
      224   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
      225   DO:
      226   define variable v-recid as recid no-undo.
      227   define variable loc#log as logical no-undo .
      228   if not available buf_fbr-prn then return no-apply.
      229   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      230   do:
      231     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      232       (input  v-cntxt-db-num
      233       ,input  v-cntxt-userid
      234       ,input  0
      235       ,input  'actn_fbr-prn_work':U
      236       ,input  'global':U
      237       ,input  0
      238       ,input  '':U
      239       ,input  0
      240       ,input  0
      241       ,input  0
      242       ,input  0
      243       ,input  true
      244       ,output loc#log
      245       )  .
      246   end.
      247   if not loc#log then return no-apply.
      248   run ref/fbr-prni.w ( input parparentproc
      249                       ,input 'ИЗМЕНЕНИЕ':U
      250                       ,input buf_fbr-prn.db-num
      251                       ,input buf_fbr-prn.prn-num
      252                       ,output v-recid).
      253   run openBr in this-procedure.
      254   END.
      255   ON CHOOSE OF B-del IN FRAME Dialog-Frame
      256   DO:
      257   define buffer del_fbr-prn for ub.fbr-prn.
      258   define variable loc#log as logical no-undo .
      259   if not available buf_fbr-prn then return no-apply.
      260   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      261   do:
      262     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      263       (input  v-cntxt-db-num
      264       ,input  v-cntxt-userid
      265       ,input  0
      266       ,input  'actn_fbr-prn_work':U
      267       ,input  'global':U
      268       ,input  0
      269       ,input  '':U
      270       ,input  0
      271       ,input  0
      272       ,input  0
      273       ,input  0
      274       ,input  true
      275       ,output loc#log
      276       )  .
      277   end.
      278   if not loc#log then return no-apply.
      279   find first del_fbr-prn exclusive-lock where
      280               recid(del_fbr-prn) = recid(buf_fbr-prn) no-error.
      281   if not available del_fbr-prn then return no-apply.
      282   delete del_fbr-prn.
      283   run openbr in this-procedure.
      284   END.
      285   ON CHOOSE OF B-gds IN FRAME Dialog-Frame
      286   DO:
      287     define variable v-recid as recid no-undo.
      288     if not available buf_fbr-prn then return no-apply.
      289     run ref/fprngdss.w (
      290                     input parparentproc
      291                    ,input "printer":U
      292                    ,input bttns
      293                    ,input buf_fbr-prn.db-num
      294                    ,input buf_fbr-prn.prn-num
      295                    ,input "":U
      296                    ,input 0
      297                    ,input 0
      298                    ,input-output v-recid
      299                    ).
      300   END.
      301   ON CHOOSE OF B-grp IN FRAME Dialog-Frame
      302   DO:
      303   define variable v-recid as recid no-undo.
      304     if not available buf_fbr-prn then return no-apply.
      305     run ref/fprngrps.w (
      306                     input parparentproc
      307                    ,input "printer":U
      308                    ,input bttns
      309                    ,input buf_fbr-prn.db-num
      310                    ,input buf_fbr-prn.prn-num
      311                    ,input "":U
      312                    ,input 0
      313                    ,input 0
      314                    ,input-output v-recid
      315                    ).
      316   END.
      317   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
      318   DO:
      319         if ( available buf_fbr-prn ) then
      320           par-recid =  recid( buf_fbr-prn )  .
      321   END.
      322   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      323   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      324   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      325   on help of frame Dialog-Frame
      326   do:
      327     run gbl/app_help.p
      328       (input this-procedure :file-name
      329       ,input ''
      330       ,input ?
      331       ) no-error.
      332     if error-status :error then do:
      333       message
      334         "Ошибка при вызове помощи"
      335         error-status :get-message(1)
      336         view-as alert-box .
      337     end.
      338   end.
      339   run minbtn-set in this-procedure .
      340   on choose of b-help in frame Dialog-Frame
      341   do:
      342     apply "help":u to frame Dialog-Frame .
      343   end.
      344   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      345   procedure minbtn-set :
      346       do
      347           on error undo, return error return-value
      348           :
      349           define variable ii              as integer       no-undo .
      350           define variable fh              as widget-handle no-undo .
      351           define variable hh              as widget-handle no-undo .
      352           define variable v-h             as handle        extent 4 no-undo .
      353           define variable v-name-button   as character     no-undo .
      354           define variable v-help-old-x    as decimal       no-undo .
      355           define variable v-help-old-y    as decimal       no-undo .
      356           define variable v-help-old-size as decimal       no-undo .
      357           define variable v-frame-width   as decimal       no-undo .
      358           define variable jj              as integer       no-undo .
      359           do
      360               on error undo, return error
      361               :
      362               assign
      363                   v-frame-width = frame Dialog-Frame:width - 0.3
      364                   fh            = frame Dialog-Frame:first-child
      365                   hh            = fh:first-child
      366                   ii            = 1
      367                   .
      368               do while valid-handle(hh):
      369                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      370                   do:
      371                       case lc(hh:name) :
      372                           when "b-help" then
      373                               do:
      374                                   hh:load-image-up("cmp/b-help.bmp":u) .
      375                                   hh:load-image-down("cmp/b-help.bmp":u) .
      376                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      377                                   hh:TOOLTIP = "Помощь" .
      378                                   v-help-old-x = hh:column .
      379                                   v-help-old-y = hh:row    .
      380                                   v-help-old-size = hh:width .
      381                                   hh:width-chars = 2.5 .
      382                               end.
      383                           when "b-print" then
      384                               do:
      385                                   hh:load-image("cmp/b-print.bmp":u) .
      386                                   hh:TOOLTIP = "Печать" .
      387                                   v-h[ii] = hh:handle .
      388                                   ii = ii + 1 .
      389                                   hh:width-chars = 3 .
      390                               end.
      391                           when "b-history" or
      392                           when "b-hist" then
      393                               do:
      394                                   hh:load-image("cmp/b-hist.bmp":u) .
      395                                   hh:TOOLTIP = "История" .
      396                                   v-h[ii] = hh:handle .
      397                                   ii = ii + 1 .
      398                                   hh:width-chars = 3 .
      399                               end.
      400                           when "b-sch" then
      401                               do:
      402                                   hh:load-image("cmp/b-sch.bmp":u) .
      403                                   hh:TOOLTIP = "Установка Фильтра" .
      404                                   v-h[ii] = hh:handle .
      405                                   ii = ii + 1 .
      406                                   hh:width-chars = 3 .
      407                               end.
      408                           when "b-hist-user" then
      409                               do:
      410                                   hh:load-image("cmp/b-hist.bmp":u) .
      411                                   hh:TOOLTIP = "История пользователя" .
      412                                   ii = ii + 1 .
      413                               end.
      414                       end case.
      415                   end.
      416                   hh = hh:next-sibling.
      417               end.
      418               b-help:column = v-frame-width - b-help:width-chars.
      419               jj = 0.
      420               repeat ii = 4 to 1 by -1 :
      421                   if valid-handle (v-h[ii] ) then
      422                   do:
      423                       jj  = jj + 1 .
      424                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      425                       v-h[ii]:row    = v-help-old-y .
      426                   end.
      427               end.
      428           end.
      429       end.
      430   end procedure.
      431   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      432   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      433   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      434   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      435   define variable v-diasize-current-frame-width  as decimal   no-undo .
      436   define variable v-diasize-current-frame-height as decimal   no-undo .
      437   define variable v-diasize-change-size          as logical   no-undo .
      438   define variable v-diasize-resize-button        as handle    no-undo .
      439   define variable v-diasize-wndmax               as logical   no-undo .
      440   define variable v-diasize-wndstore             as logical   no-undo .
      441   define variable v-diasize-proc-name            as character no-undo .
      442   define variable v-diasize-browse-handle        as handle    no-undo .
      443   define variable v-diasize-browse-number        as integer   no-undo .
      444   define variable v-diasize-need-full-display    as logical   no-undo init false .
      445   define temp-table temp-diasize-handle no-undo
      446     field handle-value  as handle
      447     field save-position as decimal
      448     index xpk is primary unique handle-value
      449     .
      450   define temp-table temp-browse-handle no-undo
      451     field browse-type   as character
      452     field browse-number as integer
      453     field browse-handle as handle
      454     field original-size as decimal
      455     index xpk is primary unique browse-type browse-number
      456     index xie browse-type browse-handle
      457   .
      458   procedure diasize_change-height :
      459     define input  parameter p-change-value  as decimal   no-undo .
      460     define input  parameter p-move-resize   as logical   no-undo .
      461     define variable v-field-group-handle    as handle    no-undo .
      462     define variable v-object-handle         as handle    no-undo .
      463     define variable v-frame-height          as decimal   no-undo .
      464     define variable v-frame-virtual-height  as decimal   no-undo .
      465     define variable v-browse-height         as decimal   no-undo .
      466     define variable v-window-height         as decimal   no-undo .
      467     define variable v-window-virtual-height as decimal   no-undo .
      468     define variable v-change-sign           as integer   no-undo .
      469     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      470     define buffer buf_temp-browse-handle  for temp-browse-handle .
      471     if p-change-value > 0
      472     then do:
      473       if frame Dialog-Frame :height + p-change-value
      474           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      475       then do:
      476         assign
      477           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      478                           - (frame Dialog-Frame :height-chars)
      479         .
      480         if p-change-value <= 0
      481         then do:
      482           run diasize_position-resize-button in this-procedure .
      483           return .
      484         end.
      485       end.
      486     end.
      487     if p-change-value < 0
      488     then do:
      489       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      490       then do:
      491         assign
      492           p-change-value = v-diasize-orig-frame-height
      493                          - (frame Dialog-Frame :height-chars)
      494         .
      495         if p-change-value >= 0
      496         then do:
      497           run diasize_position-resize-button in this-procedure .
      498           return .
      499         end.
      500       end.
      501     end.
      502     if p-change-value >= 0
      503     then do:
      504       assign
      505         v-change-sign = 1
      506       .
      507     end.
      508     else do:
      509       assign
      510         v-change-sign = -1
      511       .
      512     end.
      513     assign
      514       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      515     .
      516     if p-change-value = 0
      517     then do:
      518       run diasize_position-resize-button in this-procedure .
      519       return .
      520     end.
      521     move_block:
      522     do
      523     on error undo move_block, retry move_block
      524     :
