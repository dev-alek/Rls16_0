     1164         end.
     1165         assign
     1166           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1167           no-error .
     1168         if error-status :error
     1169         or error-status :get-message(1) <> ""
     1170         then do:
     1171           undo move_block, retry move_block.
     1172         end.
     1173         assign
     1174           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1175         no-error .
     1176         if error-status :error
     1177         or error-status :get-message(1) <> ""
     1178         then do:
     1179           undo move_block, retry move_block.
     1180         end.
     1181         if frame Dialog-Frame :scrollable = true
     1182         then do:
     1183           assign
     1184             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1185           no-error .
     1186           if error-status :error
     1187           or error-status :get-message(1) <> ""
     1188           then do:
     1189             undo move_block, retry move_block.
     1190           end.
     1191         end.
     1192       end.
     1193       if p-move-resize
     1194       then do:
     1195         run diasize_position-resize-button in this-procedure .
     1196       end.
     1197       if v-diasize-wndstore = true
     1198       then do:
     1199         if connected("ub") = true
     1200         then do:
     1201           define variable v-cntxt-db-num        as integer   no-undo .
     1202           define variable v-cntxt-userid        as character no-undo .
     1203           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1204                                             , OUTPUT v-cntxt-userid
     1205                                             ) .
     1206           run gbl/wndsizew.p
     1207             (input  v-cntxt-db-num
     1208             ,input  v-cntxt-userid
     1209             ,input  v-diasize-proc-name
     1210             ,input  'width':u
     1211             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1212             ) .
     1213         end.
     1214       end.
     1215     end.
     1216     assign
     1217       v-diasize-change-size = false
     1218     .
     1219   end procedure.
     1220   procedure diasize_set-width :
     1221     define input  parameter p-new-width  as decimal   no-undo .
     1222     define input  parameter p-move-resize as logical   no-undo .
     1223     do
     1224     on error undo, return error return-value
     1225     :
     1226       run diasize_change-width in this-procedure
     1227         (input  (p-new-width - frame Dialog-Frame :width)
     1228         ,input  p-move-resize
     1229         ) .
     1230     end.
     1231   end procedure.
     1232   procedure diasize_position-resize-button :
     1233     do with frame Dialog-Frame
     1234     :
     1235       hide v-diasize-resize-button .
     1236       assign
     1237         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1238                     - 1
     1239                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1240         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1241                     - 1
     1242                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1243       .
     1244       view v-diasize-resize-button .
     1245     end.
     1246   end procedure.
     1247   on alt-right anywhere
     1248   do:
     1249     run diasize_change-width in this-procedure
     1250       (input 1
     1251       ,input true
     1252       ) .
     1253     return no-apply .
     1254   end.
     1255   on alt-left anywhere
     1256   do:
     1257     run diasize_change-width in this-procedure
     1258       (input -1
     1259       ,input true
     1260       ) .
     1261     return no-apply .
     1262   end.
     1263   on alt-down anywhere
     1264   do:
     1265     run diasize_change-height in this-procedure
     1266       (input 1
     1267       ,input true
     1268       ) .
     1269     return no-apply .
     1270   end.
     1271   on alt-up anywhere
     1272   do:
     1273     run diasize_change-height in this-procedure
     1274       (input -1
     1275       ,input true
     1276       ) .
     1277     return no-apply .
     1278   end.
     1279   on alt-enter of frame Dialog-Frame
     1280   do:
     1281     run diasize_maximize in this-procedure
     1282       (input  ?
     1283       ).
     1284     return no-apply .
     1285   end.
     1286   procedure diasize_end-move :
     1287     do
     1288     on error undo, return error return-value
     1289     :
     1290       define variable v-row-delta as decimal   no-undo .
     1291       define variable v-col-delta as decimal   no-undo .
     1292       define variable v-new-row as decimal   no-undo .
     1293       define variable v-new-col as decimal   no-undo .
     1294       assign
     1295         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1296         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1297       .
     1298       assign
     1299         v-row-delta = v-new-row - frame Dialog-Frame :height
     1300         v-col-delta = v-new-col - frame Dialog-Frame :width
     1301       .
     1302       run diasize_change-height in this-procedure
     1303         (input v-row-delta
     1304         ,input true
     1305         ) .
     1306       run diasize_change-width in this-procedure
     1307         (input v-col-delta
     1308         ,input true
     1309         ) .
     1310     end.
     1311   end procedure.
     1312   procedure diasize_maximize :
     1313     define input  parameter p-action as logical   no-undo .
     1314     do
     1315     on error undo, return error return-value
     1316     :
     1317       if p-action = ?
     1318       then do:
     1319         if v-diasize-need-maximize = true
     1320         then do:
     1321           assign
     1322             p-action = true
     1323           .
     1324         end.
     1325         else do:
     1326           assign
     1327             p-action = false
     1328           .
     1329         end.
     1330       end.
     1331       if p-action = true
     1332       then do:
     1333         run diasize_change-height in this-procedure
     1334           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1335               - frame Dialog-Frame :height-chars
     1336           ,input true
     1337           ) .
     1338         run diasize_change-width in this-procedure
     1339           (input session :width-chars
     1340               - frame Dialog-Frame :width-chars
     1341           ,input true
     1342           ) .
     1343         assign
     1344           v-diasize-need-maximize = false
     1345         .
     1346       end.
     1347       else do:
     1348         run diasize_change-width in this-procedure
     1349           (input v-diasize-orig-frame-width
     1350               - frame Dialog-Frame :width-chars
     1351           ,input true
     1352           ) .
     1353         run diasize_change-height in this-procedure
     1354           (input v-diasize-orig-frame-height
     1355               - frame Dialog-Frame :height-chars
     1356           ,input true
     1357           ) .
     1358         assign
     1359           v-diasize-need-maximize = true
     1360         .
     1361       end.
     1362     end.
     1363   end procedure.
     1364   procedure diasize_restore-orig-size :
     1365     do
     1366     on error undo, return error return-value
     1367     :
     1368       assign
     1369         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1370         v-diasize-current-frame-height = frame Dialog-Frame :height
     1371       .
     1372       run diasize_set-height in this-procedure
     1373         (input  v-diasize-orig-frame-height
     1374         ,input  true
     1375         ) .
     1376       run diasize_set-width in this-procedure
     1377         (input  v-diasize-orig-frame-width
     1378         ,input  true
     1379         ) .
     1380     end.
     1381   end procedure.
     1382   procedure diasize_restore-current-size :
     1383     do
     1384     on error undo, return error return-value
     1385     :
     1386       run diasize_set-height in this-procedure
     1387         (input  v-diasize-current-frame-height
     1388         ,input  true
     1389         ) .
     1390       run diasize_set-width in this-procedure
     1391         (input  v-diasize-current-frame-width
     1392         ,input  true
     1393         ) .
     1394     end.
     1395   end procedure.
     1396   procedure diasize_set-browse-handle :
     1397     define input  parameter p-browse-handle as handle   no-undo .
     1398     define buffer buf_temp-browse-handle for temp-browse-handle .
     1399     do
     1400     on error undo, return error return-value
     1401     :
     1402       assign
     1403         v-diasize-browse-handle = p-browse-handle
     1404       .
     1405       for each buf_temp-browse-handle
     1406       on error undo, return error return-value
     1407       :
     1408         delete buf_temp-browse-handle .
     1409       end.
     1410     end.
     1411   end procedure.
     1412   procedure diasize_add_browse :
     1413     define input  parameter p-browse-type   as character no-undo .
     1414     define input  parameter p-browse-handle as handle    no-undo .
     1415     define buffer buf_temp-browse-handle for temp-browse-handle .
     1416     do
     1417     on error undo, return error return-value
     1418     :
     1419       assign
     1420         v-diasize-browse-number = v-diasize-browse-number + 1
     1421       .
     1422       create buf_temp-browse-handle .
     1423       assign
     1424         buf_temp-browse-handle.browse-type   = p-browse-type
     1425         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1426         buf_temp-browse-handle.browse-handle = p-browse-handle
     1427       .
     1428     end.
     1429   end procedure.
     1430   procedure diasize_init :
     1431     define variable v-default-value    as logical   no-undo .
     1432     define variable v-restore-saved    as logical   no-undo .
     1433     define variable v-resize-value-str as character no-undo .
     1434     do
     1435     on error undo, return error return-value
     1436     :
     1437       do with frame Dialog-Frame
     1438       :
     1439         assign
     1440           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1441           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1442           v-diasize-browse-handle     = browse BR-prn :handle
     1443         .
     1444         create button v-diasize-resize-button
     1445         assign
     1446           parent        = frame Dialog-Frame :first-child
     1447           label         = "s"
     1448           height-pixels = 16
     1449           width-pixels  = 16
     1450           visible       = true
     1451           sensitive     = true
     1452           movable       = true
     1453           triggers:
     1454             on end-move persistent run diasize_end-move in this-procedure .
     1455           end triggers.
     1456         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1457         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1458         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1459         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1460         assign
     1461           v-diasize-wndmax = false
     1462         .
     1463         if connected("ub") = true
     1464         then do:
     1465           define variable v-cntxt-db-num        as integer   no-undo .
     1466           define variable v-cntxt-userid        as character no-undo .
     1467           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1468                                             , OUTPUT v-cntxt-userid
     1469                                             ) .
     1470           run gbl/wndpar_r.p
     1471             (input  v-cntxt-db-num
     1472             ,input  v-cntxt-userid
     1473             ,input  'wndmax':U
     1474             ,output v-diasize-wndmax
     1475             ,output v-default-value
     1476             ) .
     1477         end.
     1478         assign
     1479           v-diasize-wndstore = false
     1480         .
     1481         if connected("ub") = true
     1482         then do:
     1483           run gbl/wndpar_r.p
     1484             (input  v-cntxt-db-num
     1485             ,input  v-cntxt-userid
     1486             ,input  'wndstore':U
     1487             ,output v-diasize-wndstore
     1488             ,output v-default-value
     1489             ) .
     1490         end.
     1491         assign
     1492           v-diasize-proc-name = entry(1, program-name(2), '.')
     1493         .
     1494         if v-diasize-wndstore = true
     1495         then do:
     1496           assign
     1497             v-restore-saved = false
     1498           .
     1499           if connected("ub") = true
     1500           then do:
     1501             run gbl/wndsizer.p
     1502               (input  v-cntxt-db-num
     1503               ,input  v-cntxt-userid
     1504               ,input  v-diasize-proc-name
     1505               ,input  'height':u
     1506               ,output v-resize-value-str
     1507               ) .
     1508             if v-resize-value-str <> '':U
     1509             then do:
     1510               run diasize_change-height in this-procedure
     1511                 (input  integer(v-resize-value-str)
     1512                 ,input  true
     1513                 ) .
     1514               assign
     1515                 v-restore-saved = true
     1516               .
     1517             end.
     1518           end.
     1519           if connected("ub") = true
     1520           then do:
     1521             run gbl/wndsizer.p
     1522               (input  v-cntxt-db-num
     1523               ,input  v-cntxt-userid
     1524               ,input  v-diasize-proc-name
     1525               ,input  'width':u
     1526               ,output v-resize-value-str
     1527               ) .
     1528             if v-resize-value-str <> '':U
     1529             then do:
     1530               run diasize_change-width in this-procedure
     1531                 (input  integer(v-resize-value-str)
     1532                 ,input  true
     1533                 ) .
     1534               assign
     1535                 v-restore-saved = true
     1536               .
     1537             end.
     1538           end.
     1539           if v-restore-saved <> true
     1540           then do:
     1541             if v-diasize-wndmax = true
     1542             then do:
     1543               run diasize_maximize in this-procedure
     1544                 (input  true
     1545                 ) .
     1546             end.
     1547           end.
     1548         end.
     1549         else do:
     1550           if v-diasize-wndmax = true
     1551           then do:
     1552             run diasize_maximize in this-procedure
     1553               (input  true
     1554               ) .
     1555           end.
     1556         end.
     1557       end.
     1558     end.
     1559   end procedure.
     1560   procedure diasize_need-full-display :
     1561     define output parameter p-need-full-display as logical   no-undo .
     1562     do
     1563     on error undo, return error return-value
     1564     :
     1565       assign
     1566         p-need-full-display = v-diasize-need-full-display
     1567       .
     1568       assign
     1569         v-diasize-need-full-display = false
     1570       .
     1571     end.
     1572   end procedure.
     1573   procedure get-context :
     1574      define output parameter p-db-num as integer          no-undo.
     1575      define output parameter p-user-id as character        no-undo.
     1576      define variable v-login               as character    no-undo.
     1577      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1578      define buffer buf_user-login  for ub.user-login .
     1579      do
     1580      on error undo, return error
     1581      :
     1582            FIND FIRST buf_sys-ctrl no-lock.
     1583            ASSIGN
     1584               v-login = USERID("ub")
     1585               p-db-num = buf_sys-ctrl.db-num
     1586            .
     1587            FIND FIRST buf_user-login
     1588                 WHERE buf_user-login.db-num = p-db-num
     1589                   AND buf_user-login.user-login = v-login
     1590                 no-lock
     1591                 no-error
     1592                 .
     1593            IF AVAILABLE buf_user-login
     1594            THEN DO:
     1595               assign
     1596                  p-user-id = buf_user-login.user-id
     1597               .
     1598            END.
     1599      end.
     1600   end procedure.
     1601       run diasize_init in this-procedure .
     1602   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1603   do:
     1604     BR-prn :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     1605   end.
     1606   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1607   on f5 of frame Dialog-Frame anywhere
     1608   do:
     1609     v-doc-rec = recid(buf_fbr-prn). run openbr in this-procedure. reposition br-prn to recid(v-doc-rec). v-doc-rec = ? .
     1610       apply "VALUE-CHANGED" to BR-prn.
     1611   end.
     1612   MAIN-BLOCK:
     1613   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1614      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1615   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1616     run mainmenu_getcntxt in parparentproc
     1617       (output v-cntxt-db-num
     1618       ,output v-cntxt-userid
     1619       ,output v-cntxt-level
     1620       ,output v-cntxt-host-code-obj
     1621       ,output v-cntxt-obj-type
     1622       ,output v-cntxt-obj-code
     1623       ,output v-cntxt-db-num-obj
     1624       ,output v-cntxt-is-admin
     1625       ) .
     1626     RUN MyEnable.
     1627     WAIT-FOR GO OF FRAME Dialog-Frame.
     1628   END.
     1629   RUN disable_UI.
     1630   PROCEDURE disable_UI :
     1631     HIDE FRAME Dialog-Frame.
     1632   END PROCEDURE.
     1633   PROCEDURE enable_UI :
     1634     ENABLE B-exit B-sel B-add B-del B-chg B-grp B-gds B-Help BR-prn
     1635         WITH FRAME Dialog-Frame.
     1636     VIEW FRAME Dialog-Frame.
     1637   END PROCEDURE.
     1638   PROCEDURE MyEnable :
     1639   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1640   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1641     (output v-db-num
     1642     ) no-error .
     1643   ENABLE
     1644   B-exit
     1645   B-sel when LOOKUP("b-sel":U, bttns) > 0
     1646   B-add when v-db-num = p-db-num
     1647   B-del when v-db-num = p-db-num
     1648   B-chg when v-db-num = p-db-num
     1649   B-Help
     1650   b-grp
     1651   b-gds
     1652   BR-prn
     1653   WITH FRAME Dialog-Frame.
     1654   VIEW FRAME Dialog-Frame.
     1655   run Openbr in this-procedure .
     1656   END PROCEDURE.
     1657   PROCEDURE OpenBr :
     1658   CASE par-mode:
     1659       when 'все':U then do:
     1660       Open query br-prn for each buf_fbr-prn no-lock.
     1661       end.
     1662       when "db":U then do:
     1663           Open query br-prn for each buf_fbr-prn no-lock where buf_fbr-prn.db-num = p-db-num.
     1664       end.
     1665   END CASE.
     1666   if par-recid <> ? then do:
     1667       reposition br-prn to recid par-recid no-error.
     1668   end.
     1669   APPLY "ENTRY" to br-prn in frame Dialog-Frame.
     1670   END PROCEDURE.
     1671   FUNCTION get-object-name RETURNS CHARACTER
     1672     ( input p-obj-type as character, input p-obj-code as integer ) :
     1673   define buffer buf_clients for ub.clients.
     1674   find first buf_clients no-lock where
     1675               buf_clients.obj-type = p-obj-type
     1676            AND buf_clients.obj-code = p-obj-code no-error.
     1677   if available buf_clients then do:
     1678       return buf_clients.obj-name.
     1679   end.
     1680     RETURN (p-obj-type + string(p-obj-code)).
     1681   END FUNCTION.
