      840         (input  (p-new-height - frame Dialog-Frame :height)
      841         ,input  p-move-resize
      842         ) .
      843     end.
      844   end procedure.
      845   procedure diasize_change-width :
      846     define input  parameter p-change-value as decimal   no-undo .
      847     define input  parameter p-move-resize  as logical   no-undo .
      848     define variable v-field-group-handle   as handle    no-undo .
