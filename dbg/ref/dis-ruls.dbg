     4471       not ((p-mode = "upper-rule-num"
     4472            or
     4473            p-mode = "upper-rule-num-object"
     4474            or
     4475            p-mode = "upper-rule-num-all-obj"
     4476            or
     4477            p-mode = "upper-rule-num-gds-obj"
     4478            or
     4479            p-mode = "upper-rule-num-global"
     4480            or
     4481            p-mode = "upper-rule-num-host")
     4482            and X_upper-dis-rule.time-rule-num = 0
     4483           )
     4484   b-sch
     4485   mark-num
     4486   rs-sts when not (p-mode = "template":U
     4487                    or p-mode = "template-value-type"
     4488                    or (p-upper-rule-num = 0 and p-mode = "upper-rule-num":U)
     4489                    or
     4490                     (p-mode =  "upper-rule-num":U
     4491                     and X_upper-dis-rule.rule-num > 99999)
     4492                     )
     4493   with FRAME Dialog-Frame.
     4494   VIEW FRAME Dialog-Frame.
     4495   IF not (p-mode = "template":U
     4496           or
     4497           p-mode = "template-value-type")
     4498   or p-upper-rule-num <> 0 THEN DO:
     4499     assign
     4500     b-dis-rules:label in frame Dialog-Frame = "Детально"
     4501     .
     4502   END.
     4503   if p-mode = "template"
     4504   or p-mode = "template-value-type"
     4505   or (p-upper-rule-num = 0  and p-mode = "upper-rule-num":U)
     4506   then do:
     4507     DISABLE
     4508     rs-sts
     4509     with FRAME Dialog-Frame.
     4510   end.
     4511   assign
     4512   v-display-discnt-value:visible in browse br-dis-rule = no
     4513   v-display-dis-kat:visible in browse br-dis-rule = no
     4514   v-display-doc-qnty:visible in browse br-dis-rule = no
     4515   v-display-tot-sum:visible in browse br-dis-rule = no
     4516   v-display-time-rule-num:visible in browse br-dis-rule = no
     4517   v-display-charkey_one:visible in browse br-dis-rule = no
     4518   v-display-charkey_two:visible in browse br-dis-rule = no
     4519   v-display-charkey_three:visible in browse br-dis-rule = no
     4520   v-display-deckey_one:visible in browse br-dis-rule = no
     4521   v-display-deckey_two:visible in browse br-dis-rule = no
     4522   v-display-deckey_three:visible in browse br-dis-rule = no
     4523   v-display-key#_one:visible in browse br-dis-rule = no
     4524   v-display-key#_two:visible in browse br-dis-rule = no
     4525   v-display-key#_three:visible in browse br-dis-rule = no
     4526   .
     4527   case p-mode:
     4528     when "template"
     4529     or
     4530     when 'все':U
     4531     or
     4532     when "template-value-type"
     4533     then do:
     4534     end.
     4535     otherwise do:
     4536       if p-upper-rule-num = 0
     4537       or p-upper-rule-num = ?
     4538       then do:
     4539       end.
     4540       else do:
     4541         if p-upper-rule-num <= 99999 then do:
     4542           v-curr-level = v-level-1.
     4543         end.
     4544         else do:
     4545           v-curr-level = v-level-2.
     4546         end.
     4547         v-h = br-dis-rule:FIRST-COLUMN IN FRAME Dialog-Frame.
     4548         DO while valid-handle(v-h) :
     4549           v-real-name = replace(v-h:name, "v-display-", "").
     4550           if lookup(v-real-name, v-curr-level) > 0
     4551           then do:
     4552             ASSIGN
     4553             v-h:visible = yes
     4554             .
     4555             find first buf_temp-drt-prop no-lock where
     4556                       buf_temp-drt-prop.templ-rl-root = v-templ-rl-root
     4557                   and buf_temp-drt-prop.upper-prop-code = v-real-name
     4558                   and buf_temp-drt-prop.prop-code = "column-label" no-error.
     4559             if available buf_temp-drt-prop then do:
     4560               assign
     4561               v-h:label = buf_temp-drt-prop.property-value.
     4562             end.
     4563             find first buf_temp-drt-prop no-lock where
     4564                       buf_temp-drt-prop.templ-rl-root = v-templ-rl-root
     4565                   and buf_temp-drt-prop.upper-prop-code = v-real-name
     4566                   and buf_temp-drt-prop.prop-code = "format":U no-error.
     4567             if available buf_temp-drt-prop then do:
     4568               assign
     4569               v-h:format = buf_temp-drt-prop.property-value.
     4570             end.
     4571           end.
     4572           v-h = v-h:NEXT-COLUMN.
     4573         end.
     4574       end.
     4575     end.
     4576   end case.
     4577   IF p-mode <> "upper-rule-num-gds-obj"
     4578   and p-mode <> "dis-gds-rule-gds-obj"
     4579   THEN DO:
     4580      HIDE br-gds-obj
     4581      IN FRAME Dialog-Frame.
     4582   END.
     4583   else do:
     4584     enable
     4585     BR-gds-obj
     4586     with frame Dialog-Frame .
     4587   end.
     4588   if p-mode = "upper-rule-num" and X_upper-dis-rule.rule-num > 99999 then do:
     4589     HIDE
     4590     b-add
     4591     b-copy
     4592     b-chg
     4593     b-del
     4594     b-stat
     4595     IN FRAME Dialog-Frame.
     4596   end.
     4597   IF v-cd = '':U THEN DO:
     4598      enable
     4599      cb-pos-type
     4600      WITH FRAME Dialog-Frame.
     4601   END.
     4602   END PROCEDURE.
     4603   PROCEDURE OpenBr :
