    11478   "ИТОГО" @ X_dis-rule.des
    11479   accum-count @ v-sts-chr
    11480   with frame dis-rule-list.
    11481   HIDE  STREAM PrnLibStream FRAME BottomFrame .
    11482   HIDE  STREAM PrnLibStream FRAME dis-rule-List.
    11483   output  STREAM PrnLibStream CLOSE.
    11484   REPOSITION br-dis-rule to recid v-doc-rec no-error.
    11485   APPLY "entry" to br-dis-rule.
    11486   run waitfram-hide in this-procedure .
    11487   if true   then do:
    11488     run prn-lib-prn-file in this-procedure (
    11489                                               input parParentProc
    11490                                               ,input 8
    11491                                               ).
    11492   end.
    11493   else do:
    11494     run prn-lib-prn-file in this-procedure (
    11495                                               input parParentProc
    11496                                               ,input (if frame dis-rule-list:width <= 255 then 1 else 20)
    11497                                               ).
    11498   end.
    11499   END PROCEDURE.
    11500   PROCEDURE proc-b-sch :
    11501   assign
    11502     tbl = 'dis-rule'
    11503     join-tbl = 'X_dis-rule'
    11504     fld = ""
    11505     lab = ""
    11506     spr = ""
    11507     dim = '0'
    11508     .
    11509   run fltfield-add in this-procedure('des', 'Описание правила скидок', '',
    11510   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
    11511   if not (p-mode = "template" or p-mode = "template-value-type") and not (p-upper-rule-num = 0 and p-mode = "upper-rule-num") then do:
    11512     run fltfield-add in this-procedure('templ-rl-root', 'Номер типа(шаблона) правила', '',
    11513     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
    11514     run fltfield-add in this-procedure('host-code', 'Фирма', 'cli',
    11515     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
    11516     run fltfield-add in this-procedure('obj-type*obj-code', 'Объект', 'cli',
    11517     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
    11518     run fltfield-add in this-procedure('discnt-value', 'Значение скидки', '',
    11519     input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
    11520   end.
    11521   Filter-Block:
    11522   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
    11523       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
    11524       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
    11525     run gbl/filter.w ( INPUT parparentproc
    11526                      , INPUT filter-point + chr(4) + filter-label
    11527                      , INPUT tbl
    11528                      , INPUT join-tbl
    11529                      , INPUT fld
    11530                      , INPUT lab
    11531                      , INPUT spr
    11532                      , INPUT dim ).
    11533     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
    11534   END.
    11535   END PROCEDURE.
    11536   PROCEDURE proc-b-stat :
    11537   define input parameter p-doc-rec as recid no-undo .
    11538   define variable v-sts like ub.dis-rule.sts no-undo .
    11539   define buffer loc_dis-rule for ub.dis-rule.
    11540   do
    11541   on error undo, return error
    11542   :
    11543     find first loc_dis-rule exclusive-lock where
    11544               recid(loc_Dis-rule) = p-doc-rec no-error .
    11545     v-sts =?.
    11546    if not available loc_dis-rule then do:
    11547       message
    11548       "Запись уже отсутствует или недоступна"
    11549       view-as alert-box warning.
    11550       return.
    11551     end.
    11552     run ref/dis-rul2.p (
    11553                       buffer loc_dis-rule
    11554                     , input no
    11555                     , input ?
    11556                     , input-output v-sts
    11557                     ) no-error.
    11558     if error-status:error then do:
    11559       if error-status:get-message(1) <> '':U
    11560       or return-value <> '':U then
    11561       message
    11562       error-status:get-message(1) skip
    11563       return-value
    11564       view-as alert-box .
    11565     end.
    11566   end.
    11567   END PROCEDURE.
    11568   PROCEDURE proc-b-time-rule :
    11569   define variable loc-doc-rec as recid no-undo .
    11570   define variable v-sts as integer no-undo init -1.
    11571   define variable v-rid-list as character no-undo .
    11572   IF NOT AVAILABLE X_dis-rule THEN RETURN no-apply.
    11573   if not can-find(first ub.dis-cfg-rule where
    11574                       ub.dis-cfg-rule.templ-rl-root = X_dis-rule.templ-rl-root
    11575                   and  ub.dis-cfg-rule.time-templ-rl-root > 0)
    11576   then do:
    11577     message
    11578     "С правилами скидок данных типов не может быть связано расписание"
    11579     view-as alert-box error .
    11580     return no-apply.
    11581   end.
    11582   if X_dis-rule.lvl-num = 0 then do:
    11583     run ref/dist-rls.w (
    11584                     input parparentproc
    11585                   ,input "b-add"
    11586                   ,input "dis-rule"
    11587                   ,input X_dis-rule.templ-rl-root
    11588                   ,input 0
    11589                   ,input ''
    11590                   ,input-output v-sts
    11591                   ,input-output v-rid-list) no-error .
    11592   end.
    11593   else do:
    11594     if lookup("time-rule-num", X_dis-rule.uniq-field) > 0 then do:
    11595         run ref/dist-rls.w (
    11596                       input parparentproc
    11597                       ,input ""
    11598                       ,input "rule-num"
    11599                       ,input (if X_dis-rule.lvl-num = 1
    11600                           then X_dis-rule.rule-num
    11601                           else X_dis-rule.upper-rule-num)
    11602                       ,input 0
    11603                       ,input ''
    11604                       ,input-output v-sts
    11605                       ,input-output v-rid-list) no-error .
    11606     end.
    11607     else do:
    11608       if X_dis-rule.time-rule-num <> 0 then
    11609       run ref/dis-timi.w (
    11610                     input parParentProc
    11611                   , input 'ПРОСМОТР':U
    11612                   , input 0
    11613                   , input  X_dis-rule.time-rule-num
    11614                   , input 0
    11615                   , input-output loc-doc-rec
    11616                   ) no-error .
    11617     end.
    11618   end.
    11619   APPLY "ENTRY" TO br-dis-rule in frame Dialog-Frame .
    11620   END PROCEDURE.
    11621   PROCEDURE proc-br-dis-rule :
    11622   define variable vss-include-info104 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11623   if b-sel:sensitive in frame Dialog-Frame then dO:
    11624       if b-mark:sensitive then do:
    11625           apply "choose" to b-mark in frame Dialog-Frame.
    11626       end.
    11627       else do:
    11628           apply "choose" to b-sel in frame Dialog-Frame.
    11629       end.
    11630   end.
    11631   else do:
    11632       if b-lookup:sensitive then
    11633       apply "choose" to b-lookup in frame Dialog-Frame.
    11634   end.
    11635   END PROCEDURE.
    11636   FUNCTION mark-string RETURNS CHARACTER
    11637     ( BUFFER loc-dis-rule FOR ub.dis-rule, input mark-list as CHARACTER ) :
    11638     RUN get-tree IN THIS-PROCEDURE(
    11639                                     BUFFER loc-dis-rule
    11640                                     ,output v-display-time-rule-num
    11641                                     ,OUTPUT v-display-dis-kat
    11642                                     ,OUTPUT v-display-doc-qnty
    11643                                     ,OUTPUT v-display-tot-sum
    11644                                     ,output v-display-charkey_one
    11645                                     ,output v-display-charkey_two
    11646                                     ,output v-display-charkey_three
    11647                                     ,output v-display-deckey_one
    11648                                     ,output v-display-deckey_two
    11649                                     ,output v-display-deckey_three
    11650                                     ,output v-display-key#_one
    11651                                     ,output v-display-key#_two
    11652                                     ,output v-display-key#_three
    11653                                     ,OUTPUT v-display-discnt-value
    11654                                     ,output v-using-fields
    11655                                 ).
    11656   RETURN ( IF LOOKUP( STRING( RECID( loc-dis-rule ) ), mark-list ) > 0 THEN "*" ELSE "":U ).
    11657   END FUNCTION.
