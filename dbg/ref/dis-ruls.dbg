     2057   END.
     2058   ON CHOOSE OF MENU-ITEM M_rule
     2059   DO:
     2060      ASSIGN
     2061     lookup-option = "rule".
     2062     RUN proc-b-lookup IN THIS-PROCEDURE ( INPUT lookup-option) NO-ERROR.
     2063     IF ERROR-STATUS:ERROR THEN DO:
     2064         ASSIGN
     2065         lookup-option = '':U.
     2066         RETURN NO-APPLY.
     2067     END.
     2068     ASSIGN
     2069     lookup-option = '':U.
     2070   END.
     2071   ON CHOOSE OF MENU-ITEM m_subject
     2072   DO:
     2073     ASSIGN
     2074     lookup-option = "subject".
     2075     RUN proc-b-lookup IN THIS-PROCEDURE ( INPUT lookup-option) NO-ERROR.
     2076     IF ERROR-STATUS:ERROR THEN DO:
     2077         ASSIGN
     2078         lookup-option = '':U.
     2079         RETURN NO-APPLY.
     2080     END.
     2081     ASSIGN
     2082     lookup-option = '':U.
     2083   END.
     2084   ON VALUE-CHANGED OF RS-sts IN FRAME Dialog-Frame
     2085   DO:
     2086     ASSIGN
     2087     rs-sts
     2088     p-sts = (IF rs-sts = 'все':U THEN -1 ELSE INTEGER(rs-sts))
     2089     .
     2090     RUN openbr IN THIS-PROCEDURE ( input YES, input NO, input '':U) NO-ERROR.
     2091     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
