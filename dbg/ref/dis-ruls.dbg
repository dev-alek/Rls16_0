     2093   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2094   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2095   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2096   on help of frame Dialog-Frame
     2097   do:
     2098     run gbl/app_help.p
     2099       (input this-procedure :file-name
     2100       ,input ''
     2101       ,input ?
     2102       ) no-error.
     2103     if error-status :error then do:
     2104       message
     2105         "Ошибка при вызове помощи"
     2106         error-status :get-message(1)
     2107         view-as alert-box .
     2108     end.
     2109   end.
     2110   run minbtn-set in this-procedure .
     2111   on choose of b-help in frame Dialog-Frame
     2112   do:
     2113     apply "help":u to frame Dialog-Frame .
     2114   end.
     2115   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2116   procedure minbtn-set :
     2117       do
     2118           on error undo, return error return-value
     2119           :
     2120           define variable ii              as integer       no-undo .
     2121           define variable fh              as widget-handle no-undo .
     2122           define variable hh              as widget-handle no-undo .
     2123           define variable v-h             as handle        extent 4 no-undo .
     2124           define variable v-name-button   as character     no-undo .
     2125           define variable v-help-old-x    as decimal       no-undo .
     2126           define variable v-help-old-y    as decimal       no-undo .
     2127           define variable v-help-old-size as decimal       no-undo .
     2128           define variable v-frame-width   as decimal       no-undo .
     2129           define variable jj              as integer       no-undo .
     2130           do
     2131               on error undo, return error
     2132               :
     2133               assign
     2134                   v-frame-width = frame Dialog-Frame:width - 0.3
     2135                   fh            = frame Dialog-Frame:first-child
     2136                   hh            = fh:first-child
     2137                   ii            = 1
     2138                   .
     2139               do while valid-handle(hh):
     2140                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2141                   do:
     2142                       case lc(hh:name) :
     2143                           when "b-help" then
     2144                               do:
     2145                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2146                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2147                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2148                                   hh:TOOLTIP = "Помощь" .
     2149                                   v-help-old-x = hh:column .
     2150                                   v-help-old-y = hh:row    .
     2151                                   v-help-old-size = hh:width .
     2152                                   hh:width-chars = 2.5 .
     2153                               end.
     2154                           when "b-print" then
     2155                               do:
     2156                                   hh:load-image("cmp/b-print.bmp":u) .
     2157                                   hh:TOOLTIP = "Печать" .
     2158                                   v-h[ii] = hh:handle .
     2159                                   ii = ii + 1 .
     2160                                   hh:width-chars = 3 .
     2161                               end.
     2162                           when "b-history" or
     2163                           when "b-hist" then
     2164                               do:
     2165                                   hh:load-image("cmp/b-hist.bmp":u) .
     2166                                   hh:TOOLTIP = "История" .
     2167                                   v-h[ii] = hh:handle .
     2168                                   ii = ii + 1 .
     2169                                   hh:width-chars = 3 .
     2170                               end.
     2171                           when "b-sch" then
     2172                               do:
     2173                                   hh:load-image("cmp/b-sch.bmp":u) .
     2174                                   hh:TOOLTIP = "Установка Фильтра" .
     2175                                   v-h[ii] = hh:handle .
     2176                                   ii = ii + 1 .
     2177                                   hh:width-chars = 3 .
     2178                               end.
     2179                           when "b-hist-user" then
     2180                               do:
     2181                                   hh:load-image("cmp/b-hist.bmp":u) .
     2182                                   hh:TOOLTIP = "История пользователя" .
     2183                                   ii = ii + 1 .
     2184                               end.
     2185                       end case.
     2186                   end.
     2187                   hh = hh:next-sibling.
     2188               end.
     2189               b-help:column = v-frame-width - b-help:width-chars.
     2190               jj = 0.
     2191               repeat ii = 4 to 1 by -1 :
     2192                   if valid-handle (v-h[ii] ) then
     2193                   do:
     2194                       jj  = jj + 1 .
     2195                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2196                       v-h[ii]:row    = v-help-old-y .
     2197                   end.
     2198               end.
     2199           end.
     2200       end.
     2201   end procedure.
     2202   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2203   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2204   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2205   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2206   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2207   define variable v-diasize-current-frame-height as decimal   no-undo .
     2208   define variable v-diasize-change-size          as logical   no-undo .
     2209   define variable v-diasize-resize-button        as handle    no-undo .
     2210   define variable v-diasize-wndmax               as logical   no-undo .
     2211   define variable v-diasize-wndstore             as logical   no-undo .
     2212   define variable v-diasize-proc-name            as character no-undo .
     2213   define variable v-diasize-browse-handle        as handle    no-undo .
     2214   define variable v-diasize-browse-number        as integer   no-undo .
     2215   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2216   define temp-table temp-diasize-handle no-undo
     2217     field handle-value  as handle
     2218     field save-position as decimal
     2219     index xpk is primary unique handle-value
     2220     .
     2221   define temp-table temp-browse-handle no-undo
     2222     field browse-type   as character
     2223     field browse-number as integer
     2224     field browse-handle as handle
     2225     field original-size as decimal
     2226     index xpk is primary unique browse-type browse-number
     2227     index xie browse-type browse-handle
     2228   .
     2229   procedure diasize_change-height :
     2230     define input  parameter p-change-value  as decimal   no-undo .
     2231     define input  parameter p-move-resize   as logical   no-undo .
     2232     define variable v-field-group-handle    as handle    no-undo .
     2233     define variable v-object-handle         as handle    no-undo .
     2234     define variable v-frame-height          as decimal   no-undo .
     2235     define variable v-frame-virtual-height  as decimal   no-undo .
     2236     define variable v-browse-height         as decimal   no-undo .
     2237     define variable v-window-height         as decimal   no-undo .
     2238     define variable v-window-virtual-height as decimal   no-undo .
     2239     define variable v-change-sign           as integer   no-undo .
     2240     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2241     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2242     if p-change-value > 0
     2243     then do:
     2244       if frame Dialog-Frame :height + p-change-value
     2245           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2246       then do:
     2247         assign
     2248           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2249                           - (frame Dialog-Frame :height-chars)
     2250         .
     2251         if p-change-value <= 0
     2252         then do:
     2253           run diasize_position-resize-button in this-procedure .
     2254           return .
     2255         end.
     2256       end.
     2257     end.
     2258     if p-change-value < 0
     2259     then do:
     2260       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2261       then do:
     2262         assign
     2263           p-change-value = v-diasize-orig-frame-height
     2264                          - (frame Dialog-Frame :height-chars)
     2265         .
