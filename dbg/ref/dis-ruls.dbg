     2886         :
     2887           assign
     2888             v-object-handle = buf_temp-diasize-handle.handle-value
     2889           .
     2890           if v-object-handle <> v-diasize-resize-button
     2891           then do:
     2892             assign
     2893               v-object-handle :col = v-object-handle :col + p-change-value
     2894               no-error .
     2895             if error-status :error
     2896             or error-status :get-message(1) <> ""
     2897             then do:
     2898               undo move_block, retry move_block .
     2899             end.
     2900           end.
     2901         end.
     2902       end.
     2903       else do:
     2904         for each buf_temp-diasize-handle
     2905         on error undo move_block, retry move_block
     2906         :
     2907           assign
     2908             v-object-handle = buf_temp-diasize-handle.handle-value
     2909           .
     2910           if v-object-handle <> v-diasize-resize-button
     2911           then do:
     2912             assign
     2913               v-object-handle :col = v-object-handle :col + p-change-value
     2914               no-error .
     2915             if error-status :error
     2916             or error-status :get-message(1) <> ""
     2917             then do:
     2918               undo move_block, retry move_block .
     2919             end.
     2920           end.
     2921         end.
     2922         for each buf_temp-browse-handle
     2923           where buf_temp-browse-handle.browse-type = 'width':u
     2924         on error undo move_block, retry move_block
     2925         :
     2926           assign
     2927             buf_temp-browse-handle.browse-handle :width
     2928               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2929             no-error .
     2930           if error-status :error
     2931           or error-status :get-message(1) <> ""
     2932           then do:
     2933             undo move_block, retry move_block .
     2934           end.
     2935         end.
     2936         assign
     2937           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2938           no-error .
     2939         if error-status :error
     2940         or error-status :get-message(1) <> ""
     2941         then do:
     2942           undo move_block, retry move_block.
     2943         end.
     2944         assign
     2945           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2946         no-error .
     2947         if error-status :error
     2948         or error-status :get-message(1) <> ""
     2949         then do:
     2950           undo move_block, retry move_block.
     2951         end.
     2952         if frame Dialog-Frame :scrollable = true
     2953         then do:
     2954           assign
     2955             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2956           no-error .
     2957           if error-status :error
     2958           or error-status :get-message(1) <> ""
     2959           then do:
     2960             undo move_block, retry move_block.
     2961           end.
     2962         end.
     2963       end.
     2964       if p-move-resize
     2965       then do:
     2966         run diasize_position-resize-button in this-procedure .
     2967       end.
     2968       if v-diasize-wndstore = true
     2969       then do:
     2970         if connected("ub") = true
     2971         then do:
     2972           define variable v-cntxt-db-num        as integer   no-undo .
     2973           define variable v-cntxt-userid        as character no-undo .
     2974           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2975                                             , OUTPUT v-cntxt-userid
     2976                                             ) .
     2977           run gbl/wndsizew.p
     2978             (input  v-cntxt-db-num
     2979             ,input  v-cntxt-userid
     2980             ,input  v-diasize-proc-name
     2981             ,input  'width':u
     2982             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2983             ) .
     2984         end.
     2985       end.
     2986     end.
     2987     assign
     2988       v-diasize-change-size = false
     2989     .
     2990   end procedure.
     2991   procedure diasize_set-width :
     2992     define input  parameter p-new-width  as decimal   no-undo .
     2993     define input  parameter p-move-resize as logical   no-undo .
     2994     do
     2995     on error undo, return error return-value
     2996     :
     2997       run diasize_change-width in this-procedure
     2998         (input  (p-new-width - frame Dialog-Frame :width)
     2999         ,input  p-move-resize
     3000         ) .
     3001     end.
     3002   end procedure.
     3003   procedure diasize_position-resize-button :
     3004     do with frame Dialog-Frame
     3005     :
     3006       hide v-diasize-resize-button .
     3007       assign
     3008         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3009                     - 1
     3010                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3011         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3012                     - 1
     3013                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3014       .
     3015       view v-diasize-resize-button .
     3016     end.
     3017   end procedure.
     3018   on alt-right anywhere
     3019   do:
     3020     run diasize_change-width in this-procedure
     3021       (input 1
     3022       ,input true
     3023       ) .
     3024     return no-apply .
     3025   end.
     3026   on alt-left anywhere
     3027   do:
     3028     run diasize_change-width in this-procedure
     3029       (input -1
     3030       ,input true
     3031       ) .
     3032     return no-apply .
     3033   end.
     3034   on alt-down anywhere
     3035   do:
     3036     run diasize_change-height in this-procedure
     3037       (input 1
     3038       ,input true
     3039       ) .
     3040     return no-apply .
     3041   end.
     3042   on alt-up anywhere
     3043   do:
     3044     run diasize_change-height in this-procedure
     3045       (input -1
     3046       ,input true
     3047       ) .
     3048     return no-apply .
     3049   end.
     3050   on alt-enter of frame Dialog-Frame
     3051   do:
     3052     run diasize_maximize in this-procedure
     3053       (input  ?
     3054       ).
     3055     return no-apply .
     3056   end.
     3057   procedure diasize_end-move :
     3058     do
     3059     on error undo, return error return-value
     3060     :
     3061       define variable v-row-delta as decimal   no-undo .
     3062       define variable v-col-delta as decimal   no-undo .
     3063       define variable v-new-row as decimal   no-undo .
     3064       define variable v-new-col as decimal   no-undo .
     3065       assign
     3066         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3067         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3068       .
     3069       assign
     3070         v-row-delta = v-new-row - frame Dialog-Frame :height
     3071         v-col-delta = v-new-col - frame Dialog-Frame :width
     3072       .
     3073       run diasize_change-height in this-procedure
     3074         (input v-row-delta
     3075         ,input true
     3076         ) .
     3077       run diasize_change-width in this-procedure
     3078         (input v-col-delta
     3079         ,input true
     3080         ) .
     3081     end.
     3082   end procedure.
     3083   procedure diasize_maximize :
     3084     define input  parameter p-action as logical   no-undo .
     3085     do
     3086     on error undo, return error return-value
     3087     :
     3088       if p-action = ?
     3089       then do:
     3090         if v-diasize-need-maximize = true
     3091         then do:
     3092           assign
     3093             p-action = true
     3094           .
     3095         end.
     3096         else do:
     3097           assign
     3098             p-action = false
     3099           .
     3100         end.
     3101       end.
     3102       if p-action = true
     3103       then do:
     3104         run diasize_change-height in this-procedure
     3105           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3106               - frame Dialog-Frame :height-chars
     3107           ,input true
     3108           ) .
     3109         run diasize_change-width in this-procedure
     3110           (input session :width-chars
     3111               - frame Dialog-Frame :width-chars
     3112           ,input true
     3113           ) .
     3114         assign
     3115           v-diasize-need-maximize = false
     3116         .
     3117       end.
     3118       else do:
     3119         run diasize_change-width in this-procedure
     3120           (input v-diasize-orig-frame-width
     3121               - frame Dialog-Frame :width-chars
     3122           ,input true
     3123           ) .
     3124         run diasize_change-height in this-procedure
     3125           (input v-diasize-orig-frame-height
     3126               - frame Dialog-Frame :height-chars
     3127           ,input true
     3128           ) .
     3129         assign
     3130           v-diasize-need-maximize = true
     3131         .
     3132       end.
     3133     end.
     3134   end procedure.
     3135   procedure diasize_restore-orig-size :
     3136     do
     3137     on error undo, return error return-value
     3138     :
     3139       assign
     3140         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3141         v-diasize-current-frame-height = frame Dialog-Frame :height
     3142       .
     3143       run diasize_set-height in this-procedure
     3144         (input  v-diasize-orig-frame-height
     3145         ,input  true
     3146         ) .
     3147       run diasize_set-width in this-procedure
     3148         (input  v-diasize-orig-frame-width
     3149         ,input  true
     3150         ) .
     3151     end.
     3152   end procedure.
     3153   procedure diasize_restore-current-size :
     3154     do
     3155     on error undo, return error return-value
     3156     :
     3157       run diasize_set-height in this-procedure
     3158         (input  v-diasize-current-frame-height
     3159         ,input  true
     3160         ) .
     3161       run diasize_set-width in this-procedure
     3162         (input  v-diasize-current-frame-width
     3163         ,input  true
     3164         ) .
     3165     end.
     3166   end procedure.
     3167   procedure diasize_set-browse-handle :
     3168     define input  parameter p-browse-handle as handle   no-undo .
     3169     define buffer buf_temp-browse-handle for temp-browse-handle .
     3170     do
