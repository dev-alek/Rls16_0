    10326           "where ":u +  substitute(' X_dis-rule.host-code  = &1            AND X_dis-rule.obj-type = &2&3&2             AND X_dis-rule.obj-code = &4             AND X_dis-rule.upper-rule-num < &6           and ((&5 = -1) or (X_dis-rule.time-templ-rl-root = &5)) '           , p-host-code, chr(34), p-curr-obj-type, p-curr-obj-code, p-time-templ-rl-root, 99999 )  + " ":u + where-phrase-96 + " ":u + p-find-condition + " " + ""
    10327         parameter-5-96 = "  "
    10328       .
    10329         run fltopend_fltfindd in this-procedure  (
    10330                             input this-procedure:handle
    10331                             ,input query br-dis-rule:handle
    10332                             ,input rowid(X_dis-rule)
    10333                             ,input logical(parameter-2-96)
    10334                             ,input no-lock
    10335                             ,input (buffer X_dis-rule:handle)
    10336                             ,input parameter-4-96
    10337                             ,input parameter-5-96
    10338                             ) no-error.
    10339         .
    10340         assign
    10341           v-doc-rec = integer(return-value)
    10342           v-fltopend-rowid[1] = ?
    10343         .
    10344       end.
    10345       else do:
    10346         assign
    10347         parameter-2-96 = (if p-find-next then "true":u else "false":u )
    10348         parameter-3-96 =  "FOR EACH X_dis-rule"
    10349         parameter-4-96 =
    10350           (
    10351             if ("               X_dis-rule.host-code  = p-host-code             AND X_dis-rule.obj-type = p-curr-obj-type             AND X_dis-rule.obj-code = p-curr-obj-code             AND X_dis-rule.upper-rule-num < 99999           and (p-time-templ-rl-root = -1 or X_dis-rule.time-templ-rl-root = p-time-templ-rl-root)                       " + " " + where-phrase-96) <> ""
    10352             then  substitute(' X_dis-rule.host-code  = &1            AND X_dis-rule.obj-type = &2&3&2             AND X_dis-rule.obj-code = &4             AND X_dis-rule.upper-rule-num < &6           and ((&5 = -1) or (X_dis-rule.time-templ-rl-root = &5)) '           , p-host-code, chr(34), p-curr-obj-type, p-curr-obj-code, p-time-templ-rl-root, 99999 )  + " " + where-phrase-96
    10353             else "true"
    10354           )
    10355         parameter-5-96 = (" " + "" + " " + substitute(', FIRST tt-template_dis-rule     NO-LOCK WHERE (&1&2&1 = &1&1) or (tt-template_dis-rule.pos-type = &1&2&1 and tt-template_dis-rule.templ-rl-root = X_dis-rule.templ-rl-root)'                                        , chr(34), v-cd) + " " + p-find-condition)
    10356         parameter-6-96 = if sort-phrase-96 = ''
    10357                              then
    10358           (
    10359           " " + "  " +
    10360             " " + sort-column-phrase +
    10361           " " + "  "
    10362           )
    10363                              else
    10364           (
    10365           " " + "  " +
    10366             " " + sort-column-phrase +
    10367           " " + sort-phrase-96
    10368           )
    10369         parameter-7-96 =
    10370           " indexed-reposition  "
    10371       .
    10372         run fltopend_fltfindq in this-procedure  (
    10373                             input this-procedure:handle
    10374                             ,input query br-dis-rule:handle
    10375                             ,input logical(parameter-2-96)
    10376                             ,input no-lock
    10377                             ,input parameter-3-96
    10378                             ,input parameter-4-96
    10379                             ,input parameter-5-96
    10380                             ,input parameter-6-96
    10381                             ,input parameter-7-96
    10382                             ,output v-fltopend-rowid
    10383                             ) no-error.
    10384         .
    10385         v-doc-rec = ?.
    10386       end.
    10387       assign
    10388         l-query-was-opened = true
    10389       .
    10390     end.
    10391   end.
    10392     run waitfram-hide in this-procedure .
    10393     END.
    10394   END CASE.
    10395   if not p-open-query then
    10396   REPOSITION br-dis-rule to recid v-doc-rec No-ERROR.
    10397   if not p-open-query and v-fltopend-rowid[1] <> ? then
    10398   query br-dis-rule:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
    10399   if error-status:error then do:
    10400     REPOSITION br-dis-rule to row 1 No-ERROR.
    10401   end.
    10402   run waitfram-hide in this-procedure.
    10403   APPLY "VALUE-CHANGED" TO br-dis-rule in frame Dialog-Frame.
    10404   APPLY "ENTRY" TO br-dis-rule.
    10405   END PROCEDURE.
    10406   PROCEDURE OpenBrgds-obj :
    10407   if available X_dis-rule and X_dis-rule.templ-rl-root = 34 then do:
    10408     hide
    10409     br-gds-obj
    10410     in frame Dialog-Frame .
    10411   end.
    10412   else do:
    10413     display
    10414     br-gds-obj WHEN (p-mode = "upper-rule-num-gds-obj" or p-mode = "dis-gds-rule-gds-obj")
    10415     with frame Dialog-Frame .
    10416     RUN fill-tables-gds-obj IN THIS-PROCEDURE NO-ERROR.
    10417     OPEN QUERY br-gds-obj FOR EACH tt-dis-rule-bc NO-LOCK.
    10418   end.
    10419   END PROCEDURE.
    10420   PROCEDURE proc-b-add :
    10421   DEFINE INPUT parameter p-add-mode AS CHARACTER NO-UNDO.
    10422   define variable loc#log as logical no-undo.
    10423   define variable loc-doc-rec as recid no-undo .
    10424   define variable v-host-code like ub.sysconf.host-code no-undo .
    10425   define variable v-rule-num like ub.dis-rule.rule-num no-undo .
    10426   define variable  v-templ-rl-root     like ub.dis-rule.templ-rl-root     no-undo .
    10427   define variable  v-des               like ub.dis-rule.des               no-undo .
    10428   define variable  v-discnt-type       like ub.dis-rule.discnt-type       no-undo .
    10429   define variable  v-subject-type      like ub.dis-rule.subject-type      no-undo .
    10430   define variable  v-value-type        like ub.dis-rule.value-type        no-undo .
    10431   define variable  v-level-1           as character no-undo .
    10432   define variable  v-level-2           as character no-undo .
    10433   define variable  v-global            as integer no-undo .
    10434   define variable  v-host              as integer no-undo .
    10435   define variable  v-object            as integer no-undo .
    10436   define variable  v-output-display as logical   no-undo .
    10437   define variable v-tree            as character no-undo .
    10438   define variable  v-other          as character no-undo .
    10439   define variable v-obj-type like ub.dis-rule.obj-type no-undo .
    10440   define variable v-obj-code like ub.dis-rule.obj-code no-undo .
    10441   define variable v-attr-codes as character no-undo .
    10442   define variable v-attr-labels as character no-undo .
    10443   define variable v-presel-codes as character no-undo .
    10444   define variable v-sel-codes as character no-undo .
    10445   define variable v-upper-rule-num as integer   no-undo .
    10446   define buffer buf_tt-template_dis-rule for tt0-template_dis-rule .
    10447   define buffer buf_dis-rule for ub.dis-rule.
    10448   define buffer root_dis-rule for ub.dis-rule.
    10449   IF p-add-mode = 'КОПИРОВАНИЕ':U
    10450   AND NOT AVAILABLE X_dis-rule THEN RETURN ERROR.
    10451   define variable vss-include-info97 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10452   do:
    10453     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    10454       (input  v-cntxt-db-num
    10455       ,input  v-cntxt-userid
    10456       ,input  0
    10457       ,input  'actn_discount_work':U
    10458       ,input  'global':U
    10459       ,input  0
    10460       ,input  '':U
    10461       ,input  0
    10462       ,input  0
    10463       ,input  0
    10464       ,input  0
    10465       ,input  true
    10466       ,output loc#log
    10467       )  .
    10468   end.
    10469   if not loc#log then return no-apply.
    10470   if not ( p-curr-obj-type = '':U
    10471           and
    10472           p-curr-obj-code = 0) then do:
    10473     if p-curr-obj-type = 'орг':U then do:
    10474       assign
    10475       v-host-code = p-curr-obj-code
    10476       v-obj-type = v-cntxt-obj-type
    10477       v-obj-code = v-cntxt-obj-code
    10478       .
    10479     end.
    10480     else do:
    10481   define variable vss-include-info98 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10482   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
    10483     (input  p-curr-obj-type
    10484     ,input  p-curr-obj-code
    10485     ,output v-host-code
    10486     )  .
    10487   end.
    10488   end.
    10489   else do:
    10490     if p-host-code > 0 then v-host-code = p-host-code.
    10491   end.
    10492   IF p-add-mode = 'ДОБАВЛЕНИЕ':U THEN DO:
    10493     if p-upper-rule-num = 0 then do:
    10494       for each buf_tt-template_dis-rule no-lock,
    10495             first buf_dis-rule no-lock where
    10496                   buf_dis-rule.rule-num = buf_tt-template_dis-rule.templ-rl-root
    10497               and buf_dis-rule.sts = integer('0':U):
    10498         assign
    10499         v-attr-codes   =  v-attr-codes +  chr(4) + string(buf_tt-template_dis-rule.templ-rl-root)
    10500         v-attr-labels  =  v-attr-labels +  chr(4) + buf_dis-rule.des
    10501         .
    10502       end.
    10503       assign
    10504       v-attr-codes = trim (v-attr-codes, chr(4))
    10505       v-attr-labels = trim (v-attr-labels, chr(4))
    10506       .
    10507       run gbl/d-list.w (
    10508                         input "b-sel":U
    10509                         ,input "Выберите тип правила"
    10510                         ,input v-attr-codes
    10511                         ,input v-attr-labels
    10512                         ,input chr(4)
    10513                         ,input v-presel-codes
    10514                         ,output v-sel-codes).
    10515       if v-sel-codes = "":U then return no-apply.
    10516       assign
    10517       v-upper-rule-num = integer(v-sel-codes)
    10518       .
    10519     end.
    10520     else do:
    10521       ASSIGN
    10522       v-upper-rule-num = p-upper-rule-num
    10523       .
    10524     end.
    10525     find first root_dis-rule where
    10526             root_dis-rule.rule-num = v-upper-rule-num.
    10527     do while root_dis-rule.upper-rule-num <> 0:
    10528       assign
    10529       v-upper-rule-num = root_dis-rule.upper-rule-num
    10530       .
    10531       find first root_dis-rule where
    10532             root_dis-rule.rule-num = v-upper-rule-num .
    10533     end.
    10534     assign
    10535     v-templ-rl-root = v-upper-rule-num
    10536     .
    10537   end.
    10538   IF p-add-mode = 'КОПИРОВАНИЕ':U THEN DO:
    10539     ASSIGN
    10540     v-templ-rl-root = X_dis-rule.templ-rl-root
    10541     loc-doc-rec = RECID(X_dis-rule)
    10542     .
    10543   END.
    10544   run dr-code  in this-procedure (
    10545                                   input  v-templ-rl-root
    10546                                   ,output v-des
    10547                                   ,output v-discnt-type
    10548                                   ,output v-subject-type
    10549                                   ,output v-value-type
    10550                                   ,output v-level-1
    10551                                   ,output v-level-2
    10552                                   ,OUTPUT v-global
    10553                                   ,OUTPUT v-host
    10554                                   ,OUTPUT v-object
    10555                                   ,output v-output-display
    10556                                   ,output v-tree
    10557                                   ,output v-other
    10558                                                             )  .
    10559   IF add-option = "":U  THEN DO:
    10560     run gbl/pop-up.p ( input self:handle, input no) no-error.
    10561     if error-status:error or add-option = "":U then return no-apply.
    10562   END.
    10563   CASE add-option:
    10564     when "global":U then do:
    10565       if v-global > 0 then do:
    10566         if v-cntxt-db-num = 0  THEN DO:
    10567          assign
    10568         v-host-code = 0
    10569         v-obj-type = "":U
    10570         v-obj-code = 0
    10571         .
    10572         END.
    10573         else do:
    10574           assign
    10575           add-option = "":U.
    10576           message
    10577           "Невозможно добавить правило скидки такого типа в УБД"
    10578           view-as alert-box error .
    10579           return no-apply.
    10580         end.
    10581       end.
    10582     end.
    10583     when "host":U then do:
    10584       if v-host > 0 then do:
    10585         if v-cntxt-db-num = 0  then
    10586         assign
    10587         v-obj-type = "":U
    10588         v-obj-code = 0
    10589         .
    10590         else do:
    10591           assign
    10592           add-option = "":U.
    10593           message
    10594           "Невозможно добавить правило скидки такого типа в УБД"
    10595           view-as alert-box error .
    10596           return no-apply.
    10597         end.
    10598       end.
    10599     end.
    10600     when "object":U then do:
    10601       if v-object > 0 then do:
    10602         assign
    10603         v-obj-type = p-curr-obj-type
    10604         v-obj-code = p-curr-obj-code
    10605         .
    10606       end.
    10607     end.
    10608   END CASE.
    10609   assign
    10610   add-option = "":U.
    10611   define variable v-form-name as character no-undo init "ref/dis-ruli.w".
    10612   run disrules-get-interface-form in this-procedure ( input v-templ-rl-root
    10613                                                      ,output v-form-name) .
    10614   run value(v-form-name) (
    10615                       input parParentProc
    10616                       ,input p-add-mode
    10617                       ,input v-templ-rl-root
    10618                       ,input v-host-code
    10619                       ,input v-obj-type
    10620                       ,input v-obj-code
    10621                       ,input (IF p-add-mode = 'ДОБАВЛЕНИЕ':U THEN 0 ELSE X_dis-rule.rule-num)
    10622                       ,input p-upper-rule-num
    10623                       ,input (if p-mode = "upper-rule-num-gds-obj":U
    10624                             or p-mode ="dis-gds-rule-gds-obj"
    10625                             then p-b-code else 0)
    10626                       ,input 0
    10627                       ,input v-cd
    10628                       ,input-output loc-doc-rec
    10629                                   ) no-error.
    10630   if loc-doc-rec <> ? then do:
    10631     RUn OpenBR in this-procedure ( input YES, input NO, input '':U).
    10632     reposition br-dis-rule to recid loc-doc-rec no-error.
    10633     if error-status:error then do:                           find first pos_dis-rule no-lock where                                   recid(pos_dis-rule) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи ПРАВИЛО СКИДКИ" skip                            string(if avail pos_dis-rule                                     then  substitute("номер правила скидки: &1"                                                     , pos_dis-rule.rule-num)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
    10634   end.
    10635   apply "entry" to br-dis-rule in frame Dialog-Frame.
    10636   apply "value-changed" to br-dis-rule in frame Dialog-Frame.
    10637   END PROCEDURE.
    10638   PROCEDURE proc-b-chg :
    10639   DEFINE variable loc#log as logical no-undo.
    10640   define variable loc-doc-rec as recid no-undo .
    10641   if not available X_dis-rule then return no-apply.
    10642   define variable vss-include-info99 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10643   do:
    10644     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    10645       (input  v-cntxt-db-num
    10646       ,input  v-cntxt-userid
    10647       ,input  0
    10648       ,input  'actn_discount_work':U
    10649       ,input  'global':U
    10650       ,input  0
    10651       ,input  '':U
    10652       ,input  0
    10653       ,input  0
    10654       ,input  0
    10655       ,input  0
    10656       ,input  true
    10657       ,output loc#log
    10658       )  .
    10659   end.
    10660   if not loc#log then return no-apply.
    10661   if (X_dis-rule.host-code = 0
    10662       or X_dis-rule.obj-code = 0)
    10663   and v-cntxt-db-num <> 0 then do:
    10664     message
    10665     "Невозможно редактировать данное правило скидки в УБД"
    10666     view-as alert-box error .
    10667     return no-apply.
    10668   end.
    10669   assign
    10670   loc-doc-rec = recid(X_dis-rule)
    10671   .
    10672   define variable v-form-name as character no-undo init "ref/dis-ruli.w".
    10673   run disrules-get-interface-form in this-procedure ( input X_dis-rule.templ-rl-root
    10674                                                      ,output v-form-name) .
    10675   run value(v-form-name) (
    10676                         input parParentProc
    10677                         ,input 'ИЗМЕНЕНИЕ':U
    10678                         ,input X_dis-rule.templ-rl-root
    10679                         ,input X_dis-rule.host-code
    10680                         ,input X_dis-rule.obj-type
    10681                         ,input X_dis-rule.obj-code
    10682                         ,input X_dis-rule.rule-num
    10683                         ,input X_dis-rule.upper-rule-num
    10684                         ,input (if p-mode = "upper-rule-num-gds-obj":U
    10685                                 or p-mode = "dis-gds-rule-gds-obj"
    10686                                 then p-b-code else 0)
    10687                         ,input X_dis-rule.time-templ-rl-root
    10688                         ,input '':U
    10689                         ,input-output loc-doc-rec
    10690                                     ) no-error.
    10691   if loc-doc-rec <> ? then do:
    10692     RUn OpenBR in this-procedure ( input YES, input NO, input '':U).
    10693     reposition br-dis-rule to recid loc-doc-rec no-error.
    10694     if error-status:error then do:                           find first pos_dis-rule no-lock where                                   recid(pos_dis-rule) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи ПРАВИЛО СКИДКИ" skip                            string(if avail pos_dis-rule                                     then  substitute("номер правила скидки: &1"                                                     , pos_dis-rule.rule-num)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
    10695   end.
    10696   apply "entry" to br-dis-rule in frame Dialog-Frame.
    10697   apply "value-changed" to br-dis-rule in frame Dialog-Frame.
    10698   END PROCEDURE.
    10699   PROCEDURE proc-b-del :
    10700   define variable loc#log as logical no-undo.
    10701   define variable v-sts like ub.dis-rule.sts no-undo .
    10702   DEFINE VARIABLE loc-doc-rec AS RECID NO-UNDO.
    10703   define buffer loc_dis-rule for ub.dis-rule.
    10704   if not available X_dis-rule then return error.
    10705   do
    10706   on error undo, return error
    10707   on stop undo, return error
    10708   :
    10709   define variable vss-include-info100 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10710   do:
    10711     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    10712       (input  v-cntxt-db-num
    10713       ,input  v-cntxt-userid
    10714       ,input  0
    10715       ,input  'actn_discount_work':U
    10716       ,input  'global':U
    10717       ,input  0
    10718       ,input  '':U
    10719       ,input  0
    10720       ,input  0
    10721       ,input  0
    10722       ,input  0
    10723       ,input  true
    10724       ,output loc#log
    10725       )  .
    10726   end.
    10727   if not loc#log then return error.
    10728     if (X_dis-rule.host-code = 0
    10729         or X_dis-rule.obj-code = 0)
    10730     and v-cntxt-db-num <> 0 then do:
    10731       message
    10732       "Невозможно удалять данное правило скидки в УБД"
    10733       view-as alert-box error .
    10734       return no-apply.
    10735     end.
    10736     loc#log = no.
    10737     message
    10738     "Вы действительно хотите удалить это правило скидки?"
    10739     view-as alert-box question buttons YES-NO update loc#log.
    10740     if not loc#log then undo, return error .
    10741     assign
    10742     loc-doc-rec = RECID(X_dis-rule)
    10743     .
    10744     find first loc_dis-rule exclusive-lock where
    10745               recid(loc_Dis-rule) = loc-doc-rec no-error .
    10746     if not available loc_dis-rule then do:
    10747       message
    10748       "Запись уже отсутствует или недоступна"
    10749       view-as alert-box warning.
    10750       return.
    10751     end.
    10752     run ref/disrul30.p (
    10753                       buffer loc_dis-rule
    10754                     ) no-error.
    10755     if error-status:error then do:
    10756       message
    10757       "Ошибка при удалении ПРАВИЛА СКИДКИ" skip
    10758       error-status:get-message(1) skip
    10759       return-value
    10760       view-as alert-box error .
    10761       undo, return error .
    10762     end.
    10763     RUN OpenBr in this-procedure ( input YES, input NO, input '':U).
    10764     REPOSITION br-dis-rule to row 1 No-error.
    10765     if error-status:error then do:                           find first pos_dis-rule no-lock where                                   recid(pos_dis-rule) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи ПРАВИЛО СКИДКИ" skip                            string(if avail pos_dis-rule                                     then  substitute("номер правила скидки: &1"                                                     , pos_dis-rule.rule-num)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
    10766     if available X_dis-rule then do:
    10767       loc#log = br-dis-rule:select-focused-row( ) IN FRAME Dialog-Frame.
    10768     end.
    10769     apply "ENTRY" to br-dis-rule.
    10770   end.
    10771   END PROCEDURE.
    10772   PROCEDURE proc-b-dis-rules :
    10773   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
    10774   define variable v-sts as integer no-undo init -1.
    10775     IF NOT AVAILABLE X_dis-rule THEN RETURN no-apply.
    10776     IF X_dis-rule.sts = INTEGER('1':U) THEN RETURN NO-APPLY.
    10777     if X_dis-rule.uniq-field <> "":U
    10778     and X_dis-rule.rule-num > 99999
    10779     then do:
    10780       v-sts = -1.
    10781     end.
    10782     else do:
    10783       v-sts = integer('0':U).
    10784     end.
    10785     run ref/dis-ruls.w (
    10786                          input parParentProc
    10787                         ,input  p-host-code
    10788                         ,input  p-curr-obj-type
    10789                         ,input  p-curr-obj-code
    10790                         ,input  "b-add":U
    10791                         ,input  "upper-rule-num":U
    10792                         ,input   X_dis-rule.rule-num
    10793                         ,input p-time-templ-rl-root
    10794                         ,input 0
    10795                         ,input-output v-sts
    10796                         ,input-output v-rid-list ) no-error .
    10797     APPLY "ENTRY" TO br-dis-rule IN FRAME Dialog-Frame.
    10798   END PROCEDURE.
    10799   PROCEDURE proc-b-history :
    10800   define variable loc-doc-rec as recid no-undo .
    10801   define variable v-rid-list as character no-undo.
    10802     if NOT available X_dis-rule then return no-apply.
    10803     loc-doc-rec = recid (X_dis-rule).
    10804     run ref/discruls.w (
    10805                         INPUT parParentProc
    10806                         ,input "":U
    10807                         ,input (if X_dis-rule.uniq-field = "":U then "one":U else "rl-root":U)
    10808                         ,input X_dis-rule.rule-num
    10809                         ,input X_dis-rule.upper-rule-num
    10810                         ,input "":U
    10811                         ,input 0
    10812                         ,input-output v-rid-list ).
    10813     reposition br-dis-rule to recid loc-doc-rec no-error.
    10814     apply "entry" to br-dis-rule in frame Dialog-Frame.
    10815     apply "value-changed" to br-dis-rule in frame Dialog-Frame.
    10816   END PROCEDURE.
    10817   PROCEDURE proc-b-lookup :
    10818   DEFINE INPUT PARAMETER p-option AS CHARACTER NO-UNDO.
    10819   DEFINE variable loc#log as logical no-undo.
    10820   define variable loc-doc-rec as recid no-undo .
    10821   define variable v-mode as character no-undo .
    10822   define variable v-rid-list as character no-undo .
    10823   define variable v-table-name as character no-undo .
    10824   define variable v-table-name-list as character no-undo .
    10825   define variable v-table-labels as character no-undo .
    10826   define variable v-classif-type as character no-undo .
    10827   define variable v-link-prop as character no-undo .
    10828   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
    10829   if not available X_dis-rule then return error.
    10830   CASE p-option:
    10831     WHEN "rule" THEN DO:
    10832   define variable vss-include-info101 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10833   do:
    10834     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
    10835       (input  v-cntxt-db-num
    10836       ,input  v-cntxt-userid
    10837       ,input  0
    10838       ,input  'actn_discount_work':U
    10839       ,input  'global':U
    10840       ,input  0
    10841       ,input  '':U
    10842       ,input  0
    10843       ,input  0
    10844       ,input  0
    10845       ,input  0
    10846       ,input  true
    10847       ,output loc#log
    10848       )  .
    10849   end.
    10850       if not loc#log then return no-apply.
    10851       ASSIGN
    10852       loc-doc-rec = recid(X_dis-rule)
    10853       .
    10854       define variable v-form-name as character no-undo init "ref/dis-ruli.w".
    10855       run disrules-get-interface-form in this-procedure ( input X_dis-rule.templ-rl-root
    10856                                                         ,output v-form-name) .
    10857       run value(v-form-name) (
    10858                                input parParentProc
    10859                               ,input 'ПРОСМОТР':U
    10860                               ,input X_dis-rule.templ-rl-root
    10861                               ,input X_dis-rule.host-code
    10862                               ,input X_dis-rule.obj-type
    10863                               ,input X_dis-rule.obj-code
    10864                               ,input X_dis-rule.rule-num
    10865                               ,input X_dis-rule.upper-rule-num
    10866                               ,input (if p-mode = "upper-rule-num-gds-obj":U
    10867                                       or p-mode = "dis-gds-rule-gds-obj"
    10868                                       then p-b-code
    10869                                       else 0)
    10870                               ,input X_dis-rule.time-templ-rl-root
    10871                               ,input '':U
    10872                               ,input-output loc-doc-rec
    10873                                           ) no-error .
    10874     END.
    10875     WHEN "subject" THEN DO:
    10876      for each buf_dis-cfg-rule no-lock where
    10877                buf_Dis-cfg-rule.templ-rl-root = X_dis-rule.templ-rl-root
    10878            and buf_Dis-cfg-rule.table-name > '':U
    10879       break
    10880       by buf_dis-cfg-rule.table-name
    10881       by buf_dis-cfg-rule.self-nonunique
    10882       :
    10883         if first-of(buf_dis-cfg-rule.self-nonunique)
    10884         then do:
    10885           assign
    10886           v-table-name-list = v-table-name-list + chr(4) +
    10887                              buf_Dis-cfg-rule.table-name  + ":" +
    10888                              buf_dis-cfg-rule.self-nonunique + ":" +
    10889                              string(buf_dis-cfg-rule.link-prop)
    10890           v-table-labels = v-table-labels + chr(4) + entry (lookup (buf_Dis-cfg-rule.table-name, 'dis-gds-rule,dis-cp-rule,dis-dc-rule,dis-dct-rule,dis-thbj-rule,dis-grp-rule,dis-some-rule':u) + 1, ',' + 'Скидка Товара на объ.,Скидки на платеж,Скидки для ДК,Скидки на типы ДК,Общие скидки,Скидки по группе,Привязка прв скид':u) +  ":" +
    10891                            entry (lookup (buf_dis-cfg-rule.self-nonunique, 'sum-grp,cli-grp':u) + 1, ',' + 'Группы товаров (на кассе),Группа клиентов':u) + chr(32) +
    10892                            entry (lookup (string(buf_dis-cfg-rule.link-prop), '0,1,2,3,-2,-1':U) + 1, ',':U + 'Объект<=>правило,->Условие правила,Объект<=>Ветка правила,Объект<=>Ссылка на правило,Объект<=>Свойство<=>правило,Объект<=>Нет правила':U)
    10893           .
    10894         end.
    10895       end.
    10896       assign
    10897       v-table-name-list = trim(v-table-name-list, chr(4) )
    10898       v-table-labels = trim(v-table-labels, chr(4) )
    10899       .
    10900       if num-entries(v-table-name-list, chr(4)) > 1 then  do:
    10901         run gbl/d-list.w (
    10902                       INPUT "b-sel":U
    10903                       ,INPUT "Выберите тип объекта приложения/условия правила"
    10904                       ,INPUT v-table-name-list
    10905                       ,INPUT v-table-labels
    10906                       ,INPUT chr(4)
    10907                       ,INPUT "":U
    10908                       ,output v-table-name) no-error .
    10909         if v-table-name = '':U then do:
    10910           undo, return error .
    10911         end.
    10912         assign
    10913         v-classif-type = entry(2, v-table-name, ":")
    10914         v-link-prop = entry(3, v-table-name, ":")
    10915         v-table-name = entry(1, v-table-name, ":")
    10916         .
    10917       end.
    10918       else do:
    10919         assign
    10920         v-table-name = entry(1, v-table-name-list, ":")
    10921         v-classif-type = entry(2, v-table-name-list, ":")
    10922         v-link-prop = entry(3, v-table-name-list, ":")
    10923         .
    10924       end.
    10925       case v-table-name:
    10926         when 'dis-gds-rule':U then do:
    10927           if p-mode = "upper-rule-num-gds-obj"
    10928           or p-mode = 'dis-gds-rule':U
    10929           or p-mode = "dis-gds-rule-gds-obj" then do:
    10930              message
    10931              "Просмотр объектов приложения скидок в данном режиме недоступен"
    10932              view-as alert-box error .
    10933              return error.
    10934           end.
    10935           if X_dis-rule.rule-num <  99999  then do:
    10936              if p-mode = "upper-rule-num"
    10937              or p-mode = "template"
    10938              or p-mode = "template"
    10939              then do:
    10940                v-mode = "templ-rl-root".
    10941              end.
    10942              if p-mode = 'объект':U then do:
    10943                v-mode = ('объект':U + chr(44) + "templ-rl-root":U).
    10944              end.
    10945              if p-mode = "cd-obj" then do:
    10946                 v-mode = ('объект':U + chr(44) + "pos-type":U).
    10947              end.
    10948           end.
    10949           else do:
    10950             if v-link-prop = '0':U then do:
    10951                v-mode = "rule-num".
    10952             end.
    10953             else do:
    10954                v-mode = "rl-root".
    10955             end.
    10956           end.
    10957           run ref/dis-gdss.w (
    10958                                INPUT parparentproc
    10959                               ,INPUT '':U
    10960                               ,INPUT v-mode
    10961                               ,input X_dis-rule.obj-type
    10962                               ,input X_dis-rule.obj-code
    10963                               ,input (if tt-template_dis-rule.templ-rl-root = 0
    10964                                       then X_dis-rule.templ-rl-root
    10965                                       else tt-template_dis-rule.templ-rl-root)
    10966                               ,input '':U
    10967                               ,input '':U
    10968                               ,input X_dis-rule.rule-num
    10969                               ,input-output v-rid-list ) no-error.
    10970         end.
    10971         when 'dis-dc-rule':U then do:
    10972           if X_dis-rule.rule-num <  99999  then do:
    10973              if p-mode = "upper-rule-num"
    10974              or p-mode = "template"
    10975              or p-mode = "template"
    10976              then do:
    10977                v-mode = "templ-rl-root".
    10978              end.
    10979              if p-mode = 'объект':U then do:
    10980                v-mode = ('объект':U + chr(44) + "templ-rl-root":U).
    10981              end.
    10982              if p-mode = "cd-obj" then do:
    10983                 v-mode = ('объект':U + chr(44) + "pos-type":U).
    10984              end.
    10985           end.
    10986           else do:
    10987             if v-link-prop = '0':U then do:
    10988                v-mode = "rule-num".
    10989             end.
    10990             else do:
    10991                v-mode = "rl-root".
    10992             end.
    10993           end.
    10994           run ref/dis-dcs.w (
    10995                                INPUT parparentproc
    10996                               ,INPUT '':U
    10997                               ,INPUT v-mode
    10998                               ,input X_dis-rule.host-code
    10999                               ,input X_dis-rule.obj-type
    11000                               ,input X_dis-rule.obj-code
    11001                               ,input (if tt-template_dis-rule.templ-rl-root = 0
    11002                                       then X_dis-rule.templ-rl-root
    11003                                       else tt-template_dis-rule.templ-rl-root)
    11004                               ,input '':U
    11005                               ,input '':U
    11006                               ,input X_dis-rule.rule-num
    11007                               ,input-output v-rid-list ) no-error.
    11008         end.
    11009         when 'dis-dct-rule':U then do:
    11010           if X_dis-rule.rule-num <  99999  then do:
    11011              if p-mode = "upper-rule-num"
    11012              or p-mode = "template"
    11013              or p-mode = "template"
    11014              then do:
    11015                v-mode = "templ-rl-root".
