     3551   MAIN-BLOCK:
     3552   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3553      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3554   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3555     run mainmenu_getcntxt in parparentproc
