    11302         if valid-handle(v-fh) then do:
    11303           assign
    11304           v-char = v-char + (if ii = 0 then '':U else chr(32) ) +
    11305           (if num-entries(v-h:label, "!") >= jj then
    11306           string(entry(jj, v-h:label, "!"), substitute("X(&1)", round(v-h:width, 0)))
    11307           else fill( chr(32), integer(round(v-h:width, 0)))
    11308           )
    11309           ii = ii + 1
    11310           .
