    11171   PROCEDURE proc-b-mark :
    11172   define variable loc#log as logical no-undo .
    11173     if available X_dis-rule then do:
    11174   define variable vss-include-info102 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11175   define variable v-str-recid103 as character no-undo .
    11176   define variable v-num-entry103 as integer   no-undo .
    11177   assign
    11178     v-str-recid103 = trim( string( recid( X_dis-rule ) , "->>>>>>>>>>>9":U ) )
    11179     v-num-entry103 = lookup( v-str-recid103 , v-rid-list )
    11180   .
    11181   if v-num-entry103 > 0 then do:
    11182     assign
    11183       entry( v-num-entry103, v-rid-list ) = "":U
    11184       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
    11185     .
    11186   end.
    11187   else do:
    11188     assign
    11189       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid103
    11190     .
    11191   end.
    11192       loc#log = br-dis-rule:refresh() IN FRAME Dialog-Frame .
    11193       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
    11194           loc#log = br-dis-rule:select-next-row ().
    11195           apply "VALUE-CHANGED" to br-dis-rule in frame Dialog-Frame.
    11196       end.
    11197       if num-entries( v-rid-list ) = 0
    11198       then
    11199           hide mark-num in frame Dialog-Frame.
    11200       else
    11201           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
    11202     end.
    11203     apply "entry" to br-dis-rule in frame Dialog-Frame.
    11204   END PROCEDURE.
    11205   PROCEDURE proc-b-print :
    11206   define variable v-doc-rec as recid no-undo .
    11207   define variable accum-count as integer.
    11208   define variable date_string     as      char    no-undo.
    11209   define variable Line            as      char    no-undo.
    11210   DEFINE VARIABLE v-sts-chr AS CHARACTER NO-UNDO.
    11211   define variable v-region as character no-undo .
    11212   define variable v-discnt-type as character no-undo .
    11213   define variable v-subject-type as character no-undo .
    11214   define variable v-value-type as character no-undo .
    11215   define variable v-discnt-value as character no-undo .
    11216   DEFINE VARIABLE v1-sts-chr AS CHARACTER NO-UNDO.
    11217   define variable v1-region as character no-undo .
    11218   define variable v1-discnt-type as character no-undo .
    11219   define variable v1-subject-type as character no-undo .
    11220   define variable v1-value-type as character no-undo .
    11221   define variable v1-discnt-value as character no-undo .
    11222   define variable v-mark as character no-undo .
    11223   DEFINE variable v1-display-time-rule-num AS CHARACTER NO-UNDO.
    11224   DEFINE variable v1-display-dis-kat AS CHARACTER  NO-UNDO.
    11225   DEFINE variable v1-display-doc-qnty AS CHARACTER  NO-UNDO.
