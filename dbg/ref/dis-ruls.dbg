     1400   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1401   procedure fltopend_fltopend :
     1402   define input parameter p-parent-handle as handle no-undo .
     1403   define input parameter p-qh as handle no-undo .
     1404   define input parameter p-flt-open-open-query  as character no-undo .
     1405   define input parameter p-where-cond as character no-undo .
     1406   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1407   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1408   define input parameter p-indexed-reposition as character no-undo .
     1409     do
     1410     on error undo, return error
     1411     :
     1412   define variable v-prepare-string as character no-undo .
     1413   define variable glog as logical no-undo .
     1414   assign
     1415   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1416                      p-where-cond + chr(32)  +
     1417                      p-use-indFIRST-query-tail + chr(32) +
     1418                      p-use-ind-sort-clmn-by + chr(32) +
     1419                      p-indexed-reposition
     1420   .
     1421   assign
     1422   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1423   if not glog
     1424   or error-status:error then do:
     1425     message error-status:get-message(1) view-as alert-box .
     1426     undo, return error .
     1427   end.
     1428   assign
     1429   glog = p-qh:query-open no-error .
     1430   if not glog
     1431   or error-status:error then do:
     1432     message error-status:get-message(1) view-as alert-box .
     1433     undo, return error .
     1434   end.
     1435     end.
     1436   end procedure.
     1437   procedure fltopend_fltfindd :
     1438   define input parameter p-parent-handle as handle no-undo .
     1439   define input parameter p-qh as handle no-undo .
     1440   define input parameter p-rowid as rowid no-undo .
     1441   define input parameter p-next as logical no-undo .
     1442   define input parameter p-lock as integer no-undo .
     1443   define input parameter p-bh as handle no-undo .
     1444   define input parameter p-where-cond as character no-undo .
     1445   define input parameter p-use-index-phrase as character no-undo .
     1446   define variable glog as logical no-undo .
     1447   define variable v-qh as handle no-undo .
     1448   define variable v-bh as handle no-undo .
     1449   define variable v-recid as recid no-undo .
     1450   define variable v-prepare-string as character no-undo .
     1451   do
     1452   on error undo, return error
     1453   on stop undo, return error
     1454   :
     1455     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1456     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1457     create query v-qh.
     1458     v-qh:set-buffers(v-bh).
     1459     v-prepare-string = substitute("for each &1 &2 &3"
     1460                                     ,v-bh:name
     1461                                     ,p-where-cond
     1462                                     ,p-use-index-phrase).
     1463     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1464     if not glog then do:
     1465       delete object v-qh.
     1466       delete object v-bh.
     1467       undo, return error .
     1468     end.
     1469     glog = v-qh:query-open no-error .
     1470     if not glog then do:
     1471       delete object v-qh.
     1472       delete object v-bh.
     1473       undo, return error .
     1474     end.
     1475     if p-next then do:
     1476       v-qh:reposition-to-rowid(p-rowid) no-error .
     1477       glog = v-qh:get-next( p-lock) no-error .
     1478       glog = v-qh:get-next( p-lock) no-error .
     1479       if not glog or v-qh:query-off-end = yes then do:
     1480         glog = v-qh:get-first( p-lock) no-error .
     1481       end.
     1482     end.
     1483     else do:
     1484       glog = v-qh:get-first( p-lock) no-error .
     1485     end.
     1486     v-recid = v-bh:recid no-error .
     1487     delete object v-qh.
     1488     delete object v-bh.
     1489     return string(v-recid) .
     1490   end.
     1491   end procedure.
     1492   procedure fltopend_fltfindq :
     1493   define input parameter p-parent-handle as handle no-undo .
     1494   define input parameter p-qh as handle no-undo .
     1495   define input parameter p-next as logical no-undo .
     1496   define input parameter p-lock as integer no-undo .
     1497   define input parameter p-flt-open-open-query  as character no-undo .
     1498   define input parameter p-where-cond as character no-undo .
     1499   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1500   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1501   define input parameter p-indexed-reposition as character no-undo .
     1502   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1503   define variable glog as logical no-undo .
     1504   define variable v-qh as handle no-undo .
     1505   define variable v-bh as handle no-undo extent 18.
     1506   define variable v-rowid as rowid no-undo extent 18.
     1507   define variable v-ii as integer no-undo .
     1508   define variable v-prepare-string as character no-undo .
     1509   do
     1510   on error undo, return error
     1511   on stop undo, return error
     1512   :
     1513     create query v-qh.
     1514     do v-ii = 1 to p-qh:num-buffers:
     1515       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1516       assign
     1517       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1518       no-error.
     1519       v-qh:add-buffer(v-bh[v-ii]).
     1520     end.
     1521     assign
     1522     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1523                       p-where-cond + chr(32)  +
     1524                       p-use-indFIRST-query-tail + chr(32) +
     1525                       p-use-ind-sort-clmn-by + chr(32) +
     1526                       p-indexed-reposition
     1527     .
     1528     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1529     if not glog then do:
     1530       delete object v-qh.
     1531       do v-ii = 1 to p-qh:num-buffers:
     1532         delete object v-bh[v-ii].
     1533       end.
     1534       undo, return error .
     1535     end.
     1536     glog = v-qh:query-open no-error .
     1537     if not glog then do:
     1538       delete object v-qh.
     1539       do v-ii = 1 to p-qh:num-buffers:
     1540         delete object v-bh[v-ii].
     1541       end.
     1542       undo, return error .
     1543     end.
     1544     if p-next then do:
     1545       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1546       glog = v-qh:get-next( p-lock) no-error .
     1547       glog = v-qh:get-next( p-lock) no-error .
     1548       if not glog or v-qh:query-off-end = yes then do:
     1549         glog = v-qh:get-first( p-lock) no-error .
     1550       end.
     1551     end.
     1552     else do:
     1553       glog = v-qh:get-first( p-lock) no-error .
     1554     end.
     1555     do v-ii = 1 to p-qh:num-buffers:
     1556       assign
     1557       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1558       no-error.
     1559     end.
     1560     delete object v-qh.
     1561     do v-ii = 1 to p-qh:num-buffers:
     1562       delete object v-bh[v-ii].
     1563     end.
     1564   end.
     1565   end procedure.
