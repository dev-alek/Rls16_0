    11337                                     ,OUTPUT buf_print-dis-rule.display-dis-kat
    11338                                     ,OUTPUT buf_print-dis-rule.display-doc-qnty
    11339                                     ,OUTPUT buf_print-dis-rule.display-tot-sum
    11340                                     ,OUTPUT buf_print-dis-rule.display-charkey_one
    11341                                     ,OUTPUT buf_print-dis-rule.display-charkey_two
    11342                                     ,OUTPUT buf_print-dis-rule.display-charkey_three
    11343                                     ,OUTPUT buf_print-dis-rule.display-deckey_one
    11344                                     ,OUTPUT buf_print-dis-rule.display-deckey_two
    11345                                     ,OUTPUT buf_print-dis-rule.display-deckey_three
    11346                                     ,OUTPUT buf_print-dis-rule.display-key#_one
    11347                                     ,OUTPUT buf_print-dis-rule.display-key#_two
    11348                                     ,OUTPUT buf_print-dis-rule.display-key#_three
    11349                                     ,OUTPUT buf_print-dis-rule.display-discnt-value
    11350                                     ,output v-using-fields
    11351                                     ) .
    11352     assign
    11353     v-h = br-dis-rule:FIRST-COLUMN IN FRAME Dialog-Frame
    11354     v-char = '':U
    11355     ii = 0
    11356     .
    11357     DO while valid-handle(v-h) :
    11358       if v-h:visible
    11359       and v-h:name <> ?
    11360       then do:
    11361         v-realname = replace(v-h:name, "v-", "").
    11362         assign
    11363         v-fh = buffer buf_print-dis-rule:buffer-field(v-realname) no-error .
    11364         if valid-handle(v-fh) then do:
    11365           assign
    11366           v-char = v-char + (if ii = 0 then '':U else chr(32) ) +
    11367           string(v-fh:buffer-value, substitute("X(&1)", round(v-h:width, 0)))
