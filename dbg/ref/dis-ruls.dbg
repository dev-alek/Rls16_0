      809   procedure fltfield-clear :
      810     define output parameter loc-fld as character no-undo.
      811     define output parameter loc-lab as character no-undo .
      812     define output parameter loc-spr as character no-undo .
      813     define output parameter loc-dim as character no-undo .
      814     assign
      815       loc-fld = ""
      816       loc-lab = ""
      817       loc-spr = ""
      818       loc-dim = "0"
      819     .
      820   end procedure .
      821   procedure fltfield-add :
      822     define input        parameter par-fld as character no-undo.
      823     define input        parameter par-lab as character no-undo .
      824     define input        parameter par-spr as character no-undo .
      825     define input-output parameter loc-fld as character no-undo.
      826     define input-output parameter loc-lab as character no-undo .
      827     define input-output parameter loc-spr as character no-undo .
      828     define input-output parameter loc-dim as character no-undo .
      829     do
      830     on error undo, return error
      831     :
      832       assign
      833       loc-fld = if loc-dim = '0'
      834                 then par-fld
      835                 else (loc-fld + chr(44) + par-fld)
      836       loc-lab = if loc-dim = '0'
      837                 then par-lab
      838                 else (loc-lab + chr(44) + par-lab)
      839       loc-spr = if loc-dim = '0'
      840                 then par-spr
      841                 else (loc-spr + chr(44) + par-spr)
      842       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      843                 string(integer(if num-entries(loc-dim) > 1
      844                               then entry(2, loc-dim)
      845                               else entry(1, loc-dim)
      846                               ) + 1)
      847       no-error
      848       .
      849     end.
      850   end procedure.
      851   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      852   procedure dr-code :
      853     do
      854     on error undo, return error
      855     :
      856       define input  parameter  p-templ-rl-root     like ub.dis-rule.templ-rl-root     no-undo .
      857       define output parameter  p-des               like ub.dis-rule.des               no-undo .
      858       define output parameter  p-discnt-type       like ub.dis-rule.discnt-type       no-undo .
      859       define output parameter  p-subject-type      like ub.dis-rule.subject-type      no-undo .
      860       define output parameter  p-value-type        like ub.dis-rule.value-type        no-undo .
      861       define output parameter  p-level-1           as character no-undo .
      862       define output parameter  p-level-2           as character no-undo .
      863       define output parameter  p-global             as integer no-undo .
      864       define output parameter  p-host               as integer no-undo .
      865       define output parameter  p-object             as integer no-undo .
      866       define output parameter  p-output-display as logical   no-undo .
      867       define output parameter  p-tree           as char  no-undo .
      868       define output parameter  p-other          as character no-undo .
      869       define variable v-other as character no-undo .
      870       define buffer buf_dis-rule for ub.dis-rule .
      871       define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      872       find first buf_dis-rule no-lock where
      873                 buf_dis-rule.rule-num = p-templ-rl-root no-error.
      874       find first buf_dis-cfg-rule no-lock where
      875               buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
      876           and buf_dis-cfg-rule.pos-type = '':U
      877           and buf_dis-cfg-rule.table-name = '':U
      878           and buf_dis-cfg-rule.discnt-role = '':U
      879           and buf_dis-cfg-rule.self-nonunique = '':U
      880               no-error.
      881       if not available buf_Dis-cfg-rule then do:
      882           undo, return error substitute("неизвестный шаблон скидки &1", p-templ-rl-root ).
      883       end.
      884       assign
      885       p-des = buf_dis-rule.des
      886       p-discnt-type = buf_dis-rule.discnt-type
      887       p-subject-type = buf_dis-rule.subject-type
      888       p-value-type = buf_dis-rule.value-type
      889       p-global = (if available buf_dis-cfg-rule
      890                   then buf_dis-cfg-rule.has-global
      891                   else 0)
      892       p-host = (if available buf_dis-cfg-rule
      893                 then buf_dis-cfg-rule.has-host
      894                 else 0)
      895       p-object = (if available buf_dis-cfg-rule
      896                 then buf_dis-cfg-rule.has-obj
      897                 else 0)
      898       p-output-display = (buf_dis-rule.sts = integer('0':U))
      899       p-tree = buf_Dis-rule.uniq-field
      900       p-other = buf_dis-rule.other-inf
      901       p-level-1 = entry(1, buf_dis-cfg-rule.other-inf, ";":U)
      902       p-level-2 = (if num-entries(buf_dis-cfg-rule.other-inf, ";":U) > 1
      903                    then entry(2, buf_dis-cfg-rule.other-inf, ";":U)
      904                    else '')
      905       .
      906     end.
      907   end procedure.
      908   define temp-table temp-drt-prop no-undo like ub.drt-prop.
      909   procedure disrules-fill-properties:
      910   define input  parameter p-templ-rl-root as integer   no-undo .
      911   define buffer buf_drt-prop for ub.drt-prop.
      912   define buffer buf_temp-drt-prop for temp-drt-prop.
      913   do
      914   on error undo, return error return-value
      915   :
      916     for each buf_temp-drt-prop:
      917       delete buf_temp-drt-prop.
      918     end.
      919     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
      920       create buf_temp-drt-prop.
      921       buffer-copy buf_drt-prop to buf_temp-drt-prop.
      922     end.
      923   end.
      924   end procedure.
      925   procedure disrules-get-interface-form :
      926   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
      927   define output parameter p-form-name as character no-undo .
      928   define buffer buf_temp-drt-prop for temp-drt-prop.
      929   define buffer buf_drt-prop for ub.drt-prop.
      930   find first buf_temp-drt-prop where
      931             buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
      932         and buf_temp-drt-prop.upper-prop-code = "InputForm"
      933         and buf_temp-drt-prop.prop-code = "FormName" no-error.
      934   if not available buf_temp-drt-prop then do:
      935     find first buf_drt-prop where
      936               buf_drt-prop.templ-rl-root = p-templ-rl-root
      937           and buf_drt-prop.upper-prop-code = "InputForm"
      938           and buf_drt-prop.prop-code = "FormName" no-error.
      939     if available buf_drt-prop then do:
      940       p-form-name = buf_drt-prop.property-value.
      941     end.
      942     else do:
      943       p-form-name = "ref/dis-ruli.w".
      944     end.
      945   end.
      946   else do:
      947     p-form-name = buf_temp-drt-prop.property-value.
      948   end.
      949   end procedure.
      950   ~
      951   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      952   procedure dtr-code :
      953     do
      954     on error undo, return error
      955     :
      956       define input  parameter  p-templ-rl-root     like ub.dis-time-rule.templ-rl-root     no-undo .
      957       define output parameter  p-des               like ub.dis-time-rule.des               no-undo .
      958       define output parameter  p-upper-time-rule-num    like ub.dis-time-rule.upper-time-rule-num    no-undo .
      959       define output parameter  p-value-type        like ub.dis-time-rule.value-type        no-undo .
      960       define output parameter  p-level-1 as character no-undo .
      961       define output parameter  p-level-2 as character no-undo .
      962       define output parameter  p-output-display as logical   no-undo .
      963       define output parameter  p-tree           as char  no-undo .
      964       define output parameter  p-other          as character no-undo .
      965       define variable v-templ-rl-root like ub.dis-time-rule.templ-rl-root no-undo .
      966       define buffer buf_dis-time-rule for ub.dis-time-rule .
      967       define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      968       if p-templ-rl-root < 50000 then
      969       v-templ-rl-root = (p-templ-rl-root + 50000).
      970       else v-templ-rl-root = p-templ-rl-root.
      971       find first buf_dis-time-rule no-lock where
      972                 buf_dis-time-rule.time-rule-num = v-templ-rl-root no-error .
      973       if not available buf_dis-time-rule then do:
      974         undo, return error substitute("неизвестный тип расписания &1", p-templ-rl-root) .
      975       end.
      976       find first buf_dis-cfg-rule no-lock where
      977               buf_dis-cfg-rule.templ-rl-root = 0
      978           and buf_dis-cfg-rule.time-templ-rl-root = p-templ-rl-root
      979           and buf_dis-cfg-rule.pos-type = '':U
      980           and buf_dis-cfg-rule.table-name = '':U
      981           and buf_dis-cfg-rule.discnt-role = '':U
      982           and buf_dis-cfg-rule.self-nonunique = '':U
      983               no-error.
      984       if not available buf_Dis-cfg-rule then do:
      985           undo, return error substitute("неизвестный тип расписания &1", p-templ-rl-root ).
      986       end.
      987       assign
      988       p-des = buf_dis-time-rule.des
      989       p-upper-time-rule-num = (buf_dis-time-rule.upper-time-rule-num - 50000)
      990       p-value-type = buf_dis-time-rule.value-type
      991       p-level-1 = entry(1, buf_dis-cfg-rule.other-inf, ";":U)
      992       p-level-2 = (if num-entries(buf_dis-cfg-rule.other-inf, ";":U) > 1
      993                    then entry(2, buf_dis-cfg-rule.other-inf, ";":U)
      994                    else '')
      995       p-output-display = (buf_dis-time-rule.sts = integer('0':U))
      996       p-tree = buf_dis-time-rule.uniq-field
      997       p-other = buf_dis-time-rule.other-inf
      998       .
      999     end.
     1000   end procedure.
     1001   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1002   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1003   ~
