    11108             end.
    11109           end.
    11110           run ref/dis-grps.w (
    11111                                INPUT parparentproc
    11112                               ,INPUT '':U
    11113                               ,INPUT v-mode
    11114                               ,input v-classif-type
    11115                               ,input X_dis-rule.host-code
    11116                               ,input X_dis-rule.obj-type
    11117                               ,input X_dis-rule.obj-code
    11118                               ,input (if tt-template_dis-rule.templ-rl-root = 0
    11119                                       then X_dis-rule.templ-rl-root
    11120                                       else tt-template_dis-rule.templ-rl-root)
    11121                               ,input '':U
