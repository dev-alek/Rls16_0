     2611         (input  (p-new-height - frame Dialog-Frame :height)
     2612         ,input  p-move-resize
     2613         ) .
     2614     end.
     2615   end procedure.
     2616   procedure diasize_change-width :
     2617     define input  parameter p-change-value as decimal   no-undo .
     2618     define input  parameter p-move-resize  as logical   no-undo .
