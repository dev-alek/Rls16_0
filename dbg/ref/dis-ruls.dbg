    11023           end.
    11024           else do:
    11025             if v-link-prop = '0':U then do:
    11026                v-mode = "rule-num".
    11027             end.
    11028             else do:
    11029                v-mode = "rl-root".
    11030             end.
    11031           end.
    11032           run ref/dis-dcts.w (
    11033                                INPUT parparentproc
    11034                               ,INPUT '':U
    11035                               ,INPUT v-mode
    11036                               ,input 0
    11037                               ,input '':U
    11038                               ,input X_dis-rule.host-code
    11039                               ,input X_dis-rule.obj-type
    11040                               ,input X_dis-rule.obj-code
    11041                               ,input (if tt-template_dis-rule.templ-rl-root = 0
    11042                                       then X_dis-rule.templ-rl-root
    11043                                       else tt-template_dis-rule.templ-rl-root)
    11044                               ,input '':U
    11045                               ,input '':U
    11046                               ,input X_dis-rule.rule-num
    11047                               ,input-output v-rid-list ) no-error.
    11048         end.
    11049         when 'dis-cp-rule':U then do:
    11050           if X_dis-rule.rule-num <  99999  then do:
    11051              if p-mode = "upper-rule-num"
    11052              or p-mode = "template"
    11053              or p-mode = "template"
    11054              then do:
    11055                v-mode = "templ-rl-root".
    11056              end.
    11057              if p-mode = 'объект':U then do:
    11058                v-mode = ('объект':U + chr(44) + "templ-rl-root":U).
    11059              end.
    11060              if p-mode = "cd-obj" then do:
    11061                 v-mode = ('объект':U + chr(44) + "pos-type":U).
    11062              end.
    11063           end.
    11064           else do:
    11065             if v-link-prop = '0':U then do:
    11066                v-mode = "rule-num".
    11067             end.
    11068             else do:
    11069                v-mode = "rl-root".
    11070             end.
    11071           end.
    11072           run ref/dis-cps.w (
    11073                                INPUT parparentproc
    11074                               ,INPUT '':U
    11075                               ,INPUT v-mode
    11076                               ,input X_dis-rule.host-code
    11077                               ,input X_dis-rule.obj-type
    11078                               ,input X_dis-rule.obj-code
    11079                               ,input (if tt-template_dis-rule.templ-rl-root = 0
    11080                                       then X_dis-rule.templ-rl-root
    11081                                       else tt-template_dis-rule.templ-rl-root)
    11082                               ,input '':U
    11083                               ,input '':U
    11084                               ,input X_dis-rule.rule-num
    11085                               ,input-output v-rid-list ) no-error.
    11086         end.
    11087         when 'dis-grp-rule':U then do:
    11088           if X_dis-rule.rule-num <  99999  then do:
    11089              if p-mode = "upper-rule-num"
    11090              or p-mode = "template"
    11091              or p-mode = "template"
    11092              then do:
    11093                v-mode = "templ-rl-root".
    11094              end.
    11095              if p-mode = 'объект':U then do:
