       28   define input-output param p-rid-list    as  char no-undo .
       29   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       30   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       31   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       32   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
