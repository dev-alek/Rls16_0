     4417    p-mode = "upper-rule-num-gds-obj":U or
     4418    p-mode = "upper-rule-num-host":U or
     4419    p-mode = "upper-rule-num-global":U
     4420    )
     4421       AND X_upper-dis-rule.upper-rule-num  = 0 AND p-upper-rule-num <> 0
     4422   and not TRANSACTION
     4423   B-copy when ((LOOKUP("b-add":U, bttns) > 0 and
     4424   (p-mode = "upper-rule-num":U OR
     4425    p-mode = "upper-rule-num-object":U OR
     4426    p-mode = "upper-rule-num-all-obj":U OR
     4427    p-mode = "upper-rule-num-gds-obj":U or
     4428    p-mode = "upper-rule-num-host":U or
     4429    p-mode = "upper-rule-num-global":U
     4430    )
     4431       AND X_upper-dis-rule.upper-rule-num  = 0 AND p-upper-rule-num <> 0)
     4432       or p-mode = 'объект':U or p-mode = "template")
     4433   and not TRANSACTION
     4434   B-lookup
     4435   B-chg when LOOKUP("b-add":U, bttns) > 0 and
     4436        (p-mode = "upper-rule-num":U OR
     4437    p-mode = "upper-rule-num-object":U OR
     4438    p-mode = "upper-rule-num-all-obj":U OR
     4439    p-mode = "upper-rule-num-gds-obj":U OR
     4440    p-mode = "upper-rule-num-global":U OR
     4441    p-mode = "upper-rule-num-host":U
     4442    )
     4443      AND X_upper-dis-rule.upper-rule-num  = 0 AND p-upper-rule-num <> 0
     4444   and not TRANSACTION
     4445   B-del when LOOKUP("b-add":U, bttns) > 0 and
     4446       (p-mode = "upper-rule-num":U OR
     4447   p-mode = "upper-rule-num-object":U OR
     4448   p-mode = "upper-rule-num-all-obj":U OR
     4449   p-mode = "upper-rule-num-gds-obj":U OR
     4450   p-mode = "upper-rule-num-global":U OR
     4451   p-mode = "upper-rule-num-host":U
     4452   )
     4453   AND X_upper-dis-rule.upper-rule-num  = 0 AND p-upper-rule-num <> 0
     4454   and not TRANSACTION
     4455   B-print
     4456   B-Help
     4457   b-history
     4458   b-stat when LOOKUP("b-add", bttns) > 0
     4459   and
     4460    (p-mode = "upper-rule-num":U OR
     4461     p-mode = "upper-rule-num-object":U OR
     4462     p-mode = "upper-rule-num-all-obj":U OR
     4463     p-mode = "upper-rule-num-gds-obj":U OR
     4464   p-mode = "upper-rule-num-global":U OR
     4465   p-mode = "upper-rule-num-host":U
     4466     )
     4467     and not TRANSACTION
     4468   B-dis-rules WHEN p-mode = "template":U or p-mode = "template-value-type" OR p-upper-rule-num = 0 or v-tree <> "":U
     4469   br-dis-rule
