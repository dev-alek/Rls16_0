     2631       if frame Dialog-Frame :width + p-change-value >
     2632           session :width-chars
     2633       then do:
     2634         assign
     2635           p-change-value = session :width-chars - frame Dialog-Frame :width
     2636         .
     2637         if p-change-value <= 0
     2638         then do:
     2639           run diasize_position-resize-button in this-procedure .
     2640           return .
     2641         end.
     2642       end.
     2643     end.
     2644     if p-change-value < 0
     2645     then do:
     2646       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2647       then do:
     2648         assign
     2649           p-change-value = v-diasize-orig-frame-width
     2650                          - frame Dialog-Frame :width
     2651         .
     2652         if p-change-value >= 0
     2653         then do:
     2654           run diasize_position-resize-button in this-procedure .
     2655           return .
     2656         end.
     2657       end.
     2658     end.
