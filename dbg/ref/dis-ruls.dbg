    11288   do jj = 1 to 4 :
    11289     assign
    11290     v-h = br-dis-rule:FIRST-COLUMN IN FRAME Dialog-Frame
    11291     v-char = '':U
    11292     ii = 0
    11293     v-found = no
    11294     .
    11295     DO while valid-handle(v-h) :
    11296       if v-h:visible
    11297       and v-h:name <> ?
