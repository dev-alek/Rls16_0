     3752               if X_dis-rule.tot-sum = - 1 then do:                                                                                                                                                                       assign  tt-dis-rule-bc.d-pcnt      = tt-dis-rule-bc.discnt-value .                                                 CASE tt-dis-rule-bc.value-type:                                                                                            WHEN INTEGER('1':U) THEN DO:                                                                             ASSIGN                                                                                                             tt-dis-rule-bc.price-discnt = tt-dis-rule-bc.price-brutto * tt-dis-rule-bc.discnt-value / 100                          tt-dis-rule-bc.price-netto = tt-dis-rule-bc.price-brutto - tt-dis-rule-bc.price-discnt                             tt-dis-rule-bc.sum-brutto = ABS(tt-dis-rule-bc.price-brutto * tt-dis-rule-bc.doc-qnty)                             tt-dis-rule-bc.sum-netto = ABS(tt-dis-rule-bc.price-netto * tt-dis-rule-bc.doc-qnty)                               tt-dis-rule-bc.sum-discnt = ABS(tt-dis-rule-bc.price-discnt * tt-dis-rule-bc.doc-qnty).                         END.                                                                                                               WHEN INTEGER('2':U) THEN DO:                                                                               ASSIGN                                                                                                             tt-dis-rule-bc.price-discnt = tt-dis-rule-bc.discnt-value                                                          tt-dis-rule-bc.d-pcnt       = 100 * (1 - tt-dis-rule-bc.price-netto / tt-dis-rule-bc.price-brutto)                 tt-dis-rule-bc.price-netto = tt-dis-rule-bc.price-brutto - tt-dis-rule-bc.price-discnt                             tt-dis-rule-bc.sum-brutto = ABS(tt-dis-rule-bc.price-brutto * tt-dis-rule-bc.doc-qnty)                             tt-dis-rule-bc.sum-netto = ABS(tt-dis-rule-bc.price-netto * tt-dis-rule-bc.doc-qnty)                               tt-dis-rule-bc.sum-discnt = ABS(tt-dis-rule-bc.price-discnt * tt-dis-rule-bc.doc-qnty).                        END.                                                                                                               WHEN INTEGER('3':U) THEN DO:                                                                                ASSIGN                                                                                                             tt-dis-rule-bc.price-netto = tt-dis-rule-bc.discnt-value                                                           tt-dis-rule-bc.price-discnt = tt-dis-rule-bc.price-brutto - tt-dis-rule-bc.price-netto                             tt-dis-rule-bc.sum-brutto = ABS(tt-dis-rule-bc.price-brutto * tt-dis-rule-bc.doc-qnty)                             tt-dis-rule-bc.sum-netto = ABS(tt-dis-rule-bc.price-netto * tt-dis-rule-bc.doc-qnty)                               tt-dis-rule-bc.sum-discnt = ABS(tt-dis-rule-bc.price-discnt * tt-dis-rule-bc.doc-qnty).                         END.                                                                                                          END CASE.                                                                                                       end.                                                                                                               else do:                                                                                                                                                                                         assign  tt-dis-rule-bc.sale-qnty = truncate(tt-dis-rule-bc.tot-sum / tt-dis-rule-bc.price-brutto, v-meas).         CASE tt-dis-rule-bc.value-type:                                                                                            WHEN INTEGER('1':U) THEN DO:                                                                             ASSIGN                                                                                                             tt-dis-rule-bc.price-discnt = tt-dis-rule-bc.price-brutto * tt-dis-rule-bc.discnt-value / 100                          tt-dis-rule-bc.d-pcnt      = tt-dis-rule-bc.discnt-value                                                           tt-dis-rule-bc.price-netto = tt-dis-rule-bc.price-brutto - tt-dis-rule-bc.price-discnt                             tt-dis-rule-bc.sum-brutto = tt-dis-rule-bc.price-brutto * tt-dis-rule-bc.sale-qnty                                 tt-dis-rule-bc.sum-netto = tt-dis-rule-bc.price-netto * tt-dis-rule-bc.sale-qnty                                   tt-dis-rule-bc.sum-discnt = tt-dis-rule-bc.price-discnt * tt-dis-rule-bc.sale-qnty .                             END.                                                                                                               WHEN INTEGER('2':U) THEN DO:                                                                               ASSIGN                                                                                                             tt-dis-rule-bc.price-discnt = tt-dis-rule-bc.discnt-value                                                          tt-dis-rule-bc.d-pcnt       = 100 * (1 - tt-dis-rule-bc.price-netto / tt-dis-rule-bc.price-brutto)                 tt-dis-rule-bc.price-netto = tt-dis-rule-bc.price-brutto - tt-dis-rule-bc.price-discnt                             tt-dis-rule-bc.sum-brutto = tt-dis-rule-bc.price-brutto * tt-dis-rule-bc.sale-qnty                                 tt-dis-rule-bc.sum-netto = tt-dis-rule-bc.price-netto * tt-dis-rule-bc.sale-qnty                                   tt-dis-rule-bc.sum-discnt = tt-dis-rule-bc.price-discnt * tt-dis-rule-bc.sale-qnty .                           END.                                                                                                               WHEN INTEGER('3':U) THEN DO:                                                                                ASSIGN                                                                                                             tt-dis-rule-bc.price-netto = tt-dis-rule-bc.discnt-value                                                           tt-dis-rule-bc.price-discnt = tt-dis-rule-bc.price-brutto - tt-dis-rule-bc.price-netto                             tt-dis-rule-bc.sum-brutto = tt-dis-rule-bc.price-brutto * tt-dis-rule-bc.sale-qnty                                 tt-dis-rule-bc.sum-netto = tt-dis-rule-bc.price-netto * tt-dis-rule-bc.sale-qnty                                   tt-dis-rule-bc.sum-discnt = tt-dis-rule-bc.price-discnt * tt-dis-rule-bc.sale-qnty .                            END.                                                                                                          END CASE.                                                                                                       end.
     3753           END.
     3754       END.
     3755   END CASE.
     3756   END PROCEDURE.
     3757   PROCEDURE get-tree :
     3758   DEFINE PARAMETER BUFFER loc_dis-rule for ub.dis-rule.
     3759   DEFINE OUTPUT PARAMETER p-display-time-rule-num AS CHARACTER NO-UNDO.
     3760   DEFINE OUTPUT PARAMETER p-display-dis-kat AS CHARACTER  NO-UNDO.
     3761   DEFINE OUTPUT PARAMETER p-display-doc-qnty AS CHARACTER  NO-UNDO.
     3762   DEFINE OUTPUT PARAMETER p-display-tot-sum AS CHARACTER  NO-UNDO.
     3763   define output parameter p-display-charkey_one as character no-undo .
     3764   define output parameter p-display-charkey_two as character no-undo .
     3765   define output parameter p-display-charkey_three as character no-undo .
     3766   define output parameter p-display-deckey_one as character no-undo .
     3767   define output parameter p-display-deckey_two as character no-undo .
     3768   define output parameter p-display-deckey_three as character no-undo .
     3769   define output parameter p-display-key#_one as character no-undo .
     3770   define output parameter p-display-key#_two as character no-undo .
     3771   define output parameter p-display-key#_three as character no-undo .
     3772   DEFINE OUTPUT PARAMETER p-display-discnt-value AS CHARACTER  NO-UNDO.
     3773   define output parameter p-using-fields as character no-undo .
     3774   DEFINE VARIABLE v-entry AS CHARACTER NO-UNDO INIT ?.
     3775   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     3776   define variable v-level-1 as character no-undo .
     3777   define variable v-level-2 as character no-undo .
     3778   define variable v-curr-level as character no-undo .
     3779   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     3780   IF loc_dis-rule.uniq-field <> "":U
     3781   AND loc_dis-rule.upper-rule-num <= 99999 THEN DO:
     3782     DO ii = 1 TO NUM-ENTRIES(loc_dis-rule.uniq-field):
     3783       v-entry = ENTRY(ii, loc_dis-rule.uniq-field).
     3784       CASE v-entry:
     3785         WHEN "time-rule-num" THEN DO:
     3786           ASSIGN
     3787           p-display-time-rule-num = "...    ".
     3788         END.
     3789         WHEN "doc-qnty" THEN DO:
     3790           ASSIGN
     3791           p-display-doc-qnty = "...    ".
     3792         END.
     3793         WHEN "tot-sum" THEN DO:
     3794           ASSIGN
     3795           p-display-tot-sum = "...    ".
     3796         END.
     3797         WHEN "dis-kat" THEN DO:
     3798           ASSIGN
     3799           p-display-dis-kat = "...    ".
     3800         END.
     3801         WHEN "charkey_one" THEN DO:
     3802           ASSIGN
     3803           p-display-charkey_one = "...    ".
     3804         END.
     3805         WHEN "charkey_two" THEN DO:
     3806           ASSIGN
     3807           p-display-charkey_two = "...    ".
     3808         END.
     3809         WHEN "charkey_three" THEN DO:
     3810           ASSIGN
     3811           p-display-charkey_three = "...    ".
     3812         END.
     3813         WHEN "deckey_one" THEN DO:
     3814           ASSIGN
     3815           p-display-deckey_one = "...    ".
     3816         END.
     3817         WHEN "deckey_two" THEN DO:
     3818           ASSIGN
     3819           p-display-deckey_two = "...    ".
     3820         END.
     3821         WHEN "deckey_three" THEN DO:
     3822           ASSIGN
     3823           p-display-deckey_three = "...    ".
     3824         END.
     3825         WHEN "key#_one" THEN DO:
     3826           ASSIGN
     3827           p-display-key#_one = "...    ".
     3828         END.
     3829         WHEN "key#_two" THEN DO:
     3830           ASSIGN
     3831           p-display-key#_two = "...    ".
     3832         END.
     3833         WHEN "key#_three" THEN DO:
     3834           ASSIGN
     3835           p-display-key#_three = "...    ".
     3836         END.
     3837       END CASE.
     3838     END.
     3839     ASSIGN
     3840     p-using-fields = ?
     3841     .
     3842   END.
     3843   find first buf_Dis-cfg-rule no-lock where
     3844             buf_Dis-cfg-rule.templ-rl-root = loc_dis-rule.templ-rl-root
     3845        and  buf_Dis-cfg-rule.table-name = '':U
     3846        and  buf_Dis-cfg-rule.pos-type = '':U
     3847        and  buf_Dis-cfg-rule.discnt-role = '':U
     3848        and  buf_Dis-cfg-rule.self-nonunique = '':U
     3849        and buf_Dis-cfg-rule.time-templ-rl-root = 0 no-error .
     3850   if error-status:error then do:
     3851   end.
     3852   if loc_dis-rule.rule-num > 99999 then do:
     3853     assign
     3854     v-level-1 = entry(1, buf_dis-cfg-rule.other-inf, ";":U)
     3855     v-level-2 = (if num-entries(buf_dis-cfg-rule.other-inf, ";":U) > 1
     3856                   then entry(2, buf_dis-cfg-rule.other-inf, ";":U)
     3857                   else '')
     3858     p-using-fields = (if loc_dis-rule.upper-rule-num <= 99999
     3859                     then v-level-1
     3860                     else v-level-2).
     3861     ASSIGN
     3862     p-display-time-rule-num = (if p-display-time-rule-num = "...    "
     3863                                then p-display-time-rule-num
     3864                                else (if lookup("time-rule-num", p-using-fields) = 0
     3865                                     then "":U
     3866                                     else string(loc_dis-rule.time-rule-num))
     3867                               )
     3868     p-display-dis-kat =  (if p-display-dis-kat = "...    "
     3869                           then p-display-dis-kat
     3870                           else  (if lookup("dis-kat", p-using-fields) = 0
     3871                                   then "":U else string(loc_dis-rule.dis-kat))
     3872                                   )
     3873     p-display-doc-qnty = (if p-display-doc-qnty = "...    "
     3874                           then p-display-doc-qnty
     3875                           else (if lookup("doc-qnty", p-using-fields) = 0
     3876                                 then "":U else string(loc_dis-rule.doc-qnty))
     3877                           )
     3878     p-display-tot-sum  = (if p-display-tot-sum = "...    "
     3879                           then p-display-tot-sum
     3880                           else (if lookup("tot-sum", p-using-fields) = 0
     3881                                then "":U else string(loc_dis-rule.tot-sum))
     3882                           )
     3883     p-display-discnt-value = (if p-display-discnt-value = "...    "
     3884                               then p-display-discnt-value
     3885                               else (if loc_dis-rule.value-type = integer('1':U)
     3886                                     then STRING(loc_dis-rule.discnt-value, "->9.99%")
     3887                                     else STRING(loc_dis-rule.discnt-value))
     3888                               )
     3889     p-display-charkey_one = (if p-display-charkey_one = "...    "
     3890                              then p-display-charkey_one
     3891                              else (if lookup("charkey_one", p-using-fields) = 0
     3892                                   then "":U else string(loc_dis-rule.charkey_one))
     3893                              )
     3894     p-display-charkey_two = (if p-display-charkey_two = "...    "
     3895                              then p-display-charkey_two
     3896                              else (if lookup("charkey_two", p-using-fields) = 0
     3897                                   then "":U else string(loc_dis-rule.charkey_two))
     3898                              )
     3899     p-display-charkey_three = (if p-display-charkey_three = "...    "
     3900                                then p-display-charkey_three
     3901                                else (if lookup("charkey_three", p-using-fields) = 0
     3902                                     then "":U else string(loc_dis-rule.charkey_three))
     3903                                )
     3904     p-display-deckey_one = (if p-display-deckey_one = "...    "
     3905                             then p-display-deckey_one
     3906                             else (if lookup("deckey_one", p-using-fields) = 0
     3907                                   then "":U else string(loc_dis-rule.deckey_one))
     3908                             )
     3909     p-display-deckey_two = (if p-display-deckey_two = "...    "
     3910                             then p-display-deckey_two
     3911                             else (if lookup("deckey_two", p-using-fields) = 0
     3912                                  then "":U else string(loc_dis-rule.deckey_two))
     3913                             )
     3914     p-display-deckey_three = (if p-display-deckey_three = "...    "
     3915                               then p-display-deckey_three
     3916                               else (if lookup("deckey_three", p-using-fields) = 0
     3917                                  then "":U else string(loc_dis-rule.deckey_three))
     3918                              )
     3919     p-display-key#_one = (if p-display-key#_one = "...    "
     3920                           then p-display-key#_one
     3921                           else (if lookup("key#_one", p-using-fields) = 0
     3922                                 then "":U else string(loc_dis-rule.key#_one))
     3923                           )
     3924     p-display-key#_two = (if p-display-key#_two = "...    "
     3925                           then p-display-key#_two
     3926                           else (if lookup("key#_two", p-using-fields) = 0
     3927                                then "":U else string(loc_dis-rule.key#_two))
     3928                           )
     3929     p-display-key#_three = (if p-display-key#_three = "...    "
     3930                             then  p-display-key#_three
     3931                             else (if lookup("key#_three", p-using-fields) = 0
     3932                                  then "":U else string(loc_dis-rule.key#_three))
     3933                             )
     3934     .
     3935   end.
     3936   END PROCEDURE.
     3937   PROCEDURE main-proc :
     3938   define variable  vget-des     as character no-undo .
     3939   define variable  vget-dis-kat           like ub.dis-rule.dis-kat           no-undo .
     3940   define variable  vget-discnt-type       like ub.dis-rule.discnt-type       no-undo .
     3941   define variable  vget-doc-qnty          like ub.dis-rule.doc-qnty          no-undo .
     3942   define variable  vget-tot-sum           like ub.dis-rule.tot-sum           no-undo .
     3943   define variable  vget-charkey_one       like ub.dis-rule.charkey_one       no-undo .
     3944   define variable  vget-charkey_two       like ub.dis-rule.charkey_two       no-undo .
     3945   define variable  vget-charkey_theree    like ub.dis-rule.charkey_three     no-undo .
     3946   define variable  vget-key#_one          like ub.dis-rule.key#_one          no-undo .
     3947   define variable  vget-key#_two          like ub.dis-rule.key#_two          no-undo .
     3948   define variable  vget-key#_theree       like ub.dis-rule.key#_three        no-undo .
     3949   define variable  vget-subject-type      like ub.dis-rule.subject-type      no-undo .
     3950   define variable  vget-time-rule-num     like ub.dis-rule.time-rule-num     no-undo .
     3951   define variable  vget-upper-rule-num    like ub.dis-rule.upper-rule-num    no-undo .
     3952   define variable  vget-value-type        like ub.dis-rule.value-type        no-undo .
     3953   define variable  vget-global            as integer no-undo .
     3954   define variable  vget-host              as integer no-undo .
     3955   define variable  vget-object            as integer no-undo .
     3956   define variable  vget-output-display as logical   no-undo .
     3957   define variable  vget-tree            as character no-undo .
     3958   define variable  vget-other          as character no-undo .
     3959   define buffer get_dis-rule for ub.dis-rule.
     3960   define buffer buf_dis-gds-rule for ub.dis-gds-rule.
     3961   define buffer buf_dis-cp-rule for ub.dis-cp-rule.
     3962   define buffer buf_dis-dc-rule for ub.dis-dc-rule.
     3963   define buffer buf_dis-dct-rule for ub.dis-dct-rule.
     3964   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     3965   define buffer buf_tt0-template_dis-rule for tt0-template_dis-rule.
     3966   if not (p-curr-obj-type = "":U and p-curr-obj-code = 0)
     3967    OR p-mode = "upper-rule-num-gds-obj"
     3968    or p-mode  = "dis-gds-rule-gds-obj"
     3969    or p-mode = "cd-obj"
     3970    then do:
     3971     find first X_curr_clients no-lock where
     3972               X_curr_clients.obj-type = p-curr-obj-type
     3973          AND X_curr_clients.obj-code = p-curr-obj-code no-error.
     3974     if not available X_curr_clients then do:
     3975       message
     3976       vss-workfile vss-revision vss-description skip
     3977       "Неверное значение параметра вызова p-curr-obj-type p-curr-obj-code"
     3978       p-curr-obj-type p-curr-obj-code
     3979       view-as alert-box ERROR.
     3980       return error .
     3981     end.
     3982    end.
     3983    if LOOKUP(p-mode,  ('все':U + chr(4) +
     3984                       "upper-rule-num":U + chr(4) +
     3985                       "upper-rule-num-object":U + chr(4) +
     3986                       "upper-rule-num-all-obj":U + chr(4) +
     3987                       "upper-rule-num-host":U + chr(4) +
     3988                       "upper-rule-num-global":U + chr(4) +
     3989                       "upper-rule-num-gds-obj":U + chr(4) +
     3990                       "template":U + chr(4) +
     3991                       "time-rule-num" + chr(4) +
     3992                       'объект':U),
     3993                   chr(4)) = 0
     3994       and entry(1, p-mode, "=") <> 'dis-gds-rule':U
     3995       and entry(1, p-mode, "=") <> "dis-gds-rule-gds-obj":U
     3996       and entry(1, p-mode, "=") <> "cd-obj":U
     3997       and entry(1, p-mode, "=") <> 'dis-dc-rule':U
     3998       and entry(1, p-mode, "=") <> 'dis-dct-rule':U
     3999       and entry(1, p-mode, "=") <> 'dis-cp-rule':U
     4000       and entry(1, p-mode, "=") <> 'dis-grp-rule':U
     4001       and entry(1, p-mode, "=") <> 'dis-some-rule':U
     4002       and entry(1, p-mode, "=") <> "template-value-type"
     4003        then dO:
     4004       message
     4005       vss-workfile vss-revision vss-description skip
     4006       "Неверное значение параметров вызова p-mode"
     4007       p-mode
     4008       view-as alert-box ERROR.
     4009       return error .
     4010    end.
     4011    if entry(1, p-mode, "=":U) = "template-value-type" then do:
     4012      assign
     4013      p-value-type = entry(2, p-mode, "=":U)
     4014      no-error .
     4015      p-mode = entry(1, p-mode, "=":U).
     4016    end.
     4017    IF entry(1, p-mode, "=":U) = 'dis-gds-rule':U
     4018    or entry(1, p-mode, "=":U) = "dis-gds-rule-gds-obj" then do:
     4019      assign
     4020      v-discnt-role = entry(2, p-mode, "=":U)
     4021      no-error .
     4022      for each buf_dis-cfg-rule no-lock where
     4023             buf_dis-cfg-rule.table-name = 'dis-gds-rule':U
     4024         and buf_dis-cfg-rule.discnt-role = v-discnt-role  :
     4025        if p-time-templ-rl-root <> -1
     4026        and buf_dis-cfg-rule.time-templ-rl-root <> p-time-templ-rl-root then do:
     4027          next.
     4028        end.
     4029        create buf_tt0-template_dis-rule.
     4030        buffer-copy buf_dis-cfg-rule to
     4031        buf_tt0-template_dis-rule.
     4032      end.
     4033      if entry(1, p-mode, "=":U) = 'dis-gds-rule':U then do:
     4034        assign
     4035        p-mode = 'dis-gds-rule':U.
     4036      end.
     4037    end.
     4038    IF entry(1, p-mode, "=":U) = 'dis-cp-rule':U
     4039    or entry(1, p-mode, "=":U) = 'dis-dc-rule':U
     4040    or entry(1, p-mode, "=":U) = 'dis-dct-rule':U
     4041    or entry(1, p-mode, "=":U) = 'dis-grp-rule':U
     4042    or entry(1, p-mode, "=":U) = 'dis-some-rule':U
     4043    then do:
     4044      if num-entries(p-mode, "=") > 2 then do:
     4045        v-region = entry(3, p-mode, "=").
     4046      end.
     4047      assign
     4048      v-discnt-role = entry(2, p-mode, "=":U)
     4049      p-mode = entry(1, p-mode, "=":U)
     4050      no-error .
     4051      for each buf_dis-cfg-rule no-lock where
     4052             buf_dis-cfg-rule.table-name = p-mode
     4053         and buf_dis-cfg-rule.discnt-role = v-discnt-role :
     4054        if p-time-templ-rl-root <> -1
     4055        and buf_dis-cfg-rule.time-templ-rl-root <> p-time-templ-rl-root then do:
     4056          next.
     4057        end.
     4058        create buf_tt0-template_dis-rule.
     4059        buffer-copy buf_dis-cfg-rule to
     4060        buf_tt0-template_dis-rule.
     4061      end.
     4062    end.
     4063    IF entry(1, p-mode, "=":U) = "cd-obj"
     4064    THEN DO:
     4065      assign
     4066      v-cd = entry(2, p-mode, "=":U)
     4067      p-mode = entry(1, p-mode, "=":U)
     4068      .
     4069       for each buf_dis-cfg-rule no-lock where
     4070             buf_dis-cfg-rule.pos-type = v-cd :
     4071        if p-time-templ-rl-root <> -1
     4072        and buf_dis-cfg-rule.time-templ-rl-root <> p-time-templ-rl-root then do:
     4073          next.
     4074        end.
     4075        create buf_tt0-template_dis-rule.
     4076        buffer-copy buf_dis-cfg-rule to
     4077        buf_tt0-template_dis-rule.
     4078      end.
     4079    END.
     4080     if p-mode = "upper-rule-num"
     4081     or p-mode = "upper-rule-num-object"
     4082     or p-mode = "upper-rule-num-all-obj"
     4083     or p-mode = "upper-rule-num-gds-obj"
     4084     or p-mode = "upper-rule-num-host"
     4085     or p-mode = "upper-rule-num-global"
     4086     then do:
     4087      find first X_upper-dis-rule no-lock where
     4088             X_upper-dis-rule.rule-num = p-upper-rule-num no-error.
     4089      if not available X_upper-dis-rule then do:
     4090       message
     4091       vss-workfile vss-revision vss-description skip
     4092       "Неверное значение параметров вызова p-upper-rule-num"
     4093       p-upper-rule-num
     4094       view-as alert-box ERROR.
     4095       return error .
     4096      end.
     4097      if X_upper-dis-rule.rule-num > 99999
     4098      and (lookup(bttns, "b-sel") > 0 or lookup(bttns, "b-mark") > 0) then do:
     4099       message
     4100       vss-workfile vss-revision vss-description skip
     4101       "Неверное значение параметров вызова bttn или p-upper-rule-num"
     4102       bttns p-upper-rule-num
     4103       view-as alert-box ERROR.
     4104       return error .
     4105      end.
     4106     end.
     4107     if p-mode = "time-rule-num" then do:
     4108      find first X_dis-time-rule no-lock where
     4109             X_dis-time-rule.time-rule-num = p-time-templ-rl-root no-error.
     4110      if not available X_dis-time-rule then do:
     4111       message
     4112       vss-workfile vss-revision vss-description skip
     4113       "Неверное значение параметров вызова p-upper-rule-num"
     4114       p-upper-rule-num
     4115       view-as alert-box ERROR.
     4116       return error .
     4117      end.
     4118     end.
     4119     if p-mode = "upper-rule-num-gds-obj"
     4120     or p-mode = "dis-gds-rule-gds-obj"
     4121     then do:
     4122       find first X_bar-code no-lock where
     4123                 X_bar-code.b-code = p-b-code no-error.
     4124       if not available X_bar-code then do:
     4125         message
     4126         vss-workfile vss-revision vss-description skip
     4127         "Неверное значение параметров вызова p-b-code" p-b-code
     4128         view-as alert-box ERROR.
     4129         return error .
     4130       end.
     4131       find first X_goods no-lock where
     4132                X_goods.gds-code = x_bar-code.gds-code no-error .
     4133       if not available X_goods then do:
     4134         message
     4135         vss-workfile vss-revision vss-description skip
     4136         "Неверное значение параметров вызова p-b-code" p-b-code skip
     4137         "Не найден товар для бар-кода" p-b-code
     4138         view-as alert-box ERROR.
     4139         return error .
     4140       end.
     4141     end.
     4142   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4143   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     4144     (output v-db-num
     4145     )  .
     4146    run fill-tables in this-procedure no-error.
     4147    if error-status:error then  undo, return error .
     4148    RUN MyEnable in this-procedure .
     4149    assign
     4150    v-doc-rec = integer(entry(1, v-rid-list))
     4151    .
     4152    RUn OpenBR IN THIS-PROCEDURE ( input YES, input NO, input '':U).
     4153    if v-doc-rec <> ?
     4154    and v-doc-rec <> 0
     4155    then do:
     4156      reposition br-dis-rule to recid v-doc-rec no-error.
     4157      apply "ENTRY" to br-dis-rule in frame Dialog-Frame .
     4158      APPLY "VALUE-CHANGED" to br-dis-rule.
     4159    end.
     4160    HIDE mark-num in frame Dialog-Frame .
     4161   END PROCEDURE.
     4162   PROCEDURE MyEnable :
     4163   define variable v-host-code like ub.sysconf.host-code no-undo .
     4164   DEFINE VARIABLE v-rule-num LIKE ub.dis-rule.rule-num NO-UNDO.
     4165   define variable  v-des               like ub.dis-rule.des               no-undo .
     4166   define variable  v-discnt-type       like ub.dis-rule.discnt-type       no-undo .
     4167   define variable  v-subject-type      like ub.dis-rule.subject-type      no-undo .
     4168   define variable  v-value-type        like ub.dis-rule.value-type        no-undo .
     4169   define variable  v-level-1           as character no-undo .
     4170   define variable  v-level-2           as character no-undo .
     4171   define variable  v-global            as integer no-undo .
     4172   define variable  v-host              as integer no-undo .
     4173   define variable  v-object            as integer no-undo .
     4174   define variable  v-output-display as logical   no-undo .
     4175   define variable  v-tree              as character no-undo .
     4176   define variable  v-other          as character no-undo .
     4177   DEFINE VARIABLE v-doc-num LIKE ub.price-list.doc-num NO-UNDO.
     4178   DEFINE VARIABLE v-road-tax LIKE ub.price-list.road-tax NO-UNDO.
     4179   DEFINE VARIABLE v-excise LIKE ub.price-list.excise NO-UNDO.
     4180   DEFINE VARIABLE ii AS INTEGer NO-UNDO.
     4181   DEFINE VARIABLE v-list-items AS CHARACTER NO-UNDO.
     4182   DEFINE VARIABLE v-ii         AS INTEGER   NO-UNDO.
     4183   define variable v-obj-type as character no-undo .
     4184   define variable v-obj-code as integer no-undo .
     4185   define variable v-curr-level as character no-undo .
     4186   define variable v-templ-rl-root as integer no-undo .
     4187   define variable v-h as handle no-undo .
     4188   define variable v-real-name as character no-undo .
     4189   define buffer buf_temp-drt-prop for temp-drt-prop.
     4190   if p-upper-rule-num <> ?
     4191   and  p-upper-rule-num <> 0 then do:
     4192     v-templ-rl-root = (if p-upper-rule-num <= 99999
     4193                        then p-upper-rule-num
     4194                        else X_upper-dis-rule.templ-rl-root).
     4195     run dr-code  in this-procedure (
     4196                                      input  v-templ-rl-root
     4197                                     ,output v-des
     4198                                     ,output v-discnt-type
     4199                                     ,output v-subject-type
     4200                                     ,output v-value-type
     4201                                     ,output v-level-1
     4202                                     ,output v-level-2
     4203                                     ,OUTPUT v-global
     4204                                     ,OUTPUT v-host
     4205                                     ,OUTPUT v-object
     4206                                     ,output v-output-display
     4207                                     ,output v-tree
     4208                                     ,output v-other
     4209                                                               )  NO-ERROR.
     4210     run disrules-fill-properties in this-procedure ( input v-templ-rl-root).
     4211   end.
     4212   ASSIGN
     4213   b-lookup:MENU-MOUSE IN FRAME Dialog-Frame = 1
     4214   X_dis-rule.des:resizable in browse br-dis-rule = yes
     4215   .
     4216   assign
     4217   v-list-items = "":U + chr(44) + "":U.
     4218   DO v-ii = 1 TO NUM-ENTRIES('IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,MARIA,-,bo':U):
     4219       ASSIGN
     4220       v-list-items = v-list-items +  chr(44) +
     4221                      ENTRY(v-ii, 'IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,MARIA,Накладная,Бэкофис':U) + chr(44) +
     4222                      ENTRY(v-ii, 'IBM-XML,Autotank,IBM,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,MARIA,-,bo':U).
     4223   END.
     4224   assign
     4225   cb-pos-type:list-item-pairs in frame Dialog-Frame = v-list-items.
     4226   IF v-cd > '':U THEN DO:
     4227      ASSIGN
     4228      cb-pos-type = v-cd.
     4229   END.
     4230   IF p-mode = "upper-rule-num-gds-obj"
     4231   or p-mode = "dis-gds-rule-gds-obj"
     4232   THEN DO:
     4233     if X_upper-dis-rule.value-type = integer('1':U) then do:
     4234       tt-dis-rule-bc.discnt-value:LABEL in browse br-gds-obj =
     4235       tt-dis-rule-bc.discnt-value:LABEL in browse br-gds-obj + "%".
     4236     end.
     4237   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4238   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     4239     (input  p-curr-obj-type
     4240     ,input  p-curr-obj-code
     4241     ,input  p-b-code
     4242     ,input  0
     4243     ,input  0
     4244     ,output v-doc-num
     4245     ,output v-price-sale
     4246     ,output v-road-tax
     4247     ,output v-excise
     4248     ) no-error .
     4249     ASSIGN
     4250     tt-dis-rule-bc.doc-qnty:VISIBLE IN BROWSE br-gds-obj = NO
     4251     tt-dis-rule-bc.sum-brutto:VISIBLE IN BROWSE br-gds-obj = no
     4252     tt-dis-rule-bc.sum-discnt:VISIBLE IN BROWSE br-gds-obj = no
     4253     tt-dis-rule-bc.sum-netto:VISIBLE IN BROWSE br-gds-obj = no
     4254     tt-dis-rule-bc.tot-sum:VISIBLE IN BROWSE br-gds-obj = NO
     4255     tt-dis-rule-bc.dis-kat:VISIBLE IN BROWSE br-gds-obj = no
     4256     tt-dis-rule-bc.charkey_one:VISIBLE IN BROWSE br-gds-obj = no
     4257     tt-dis-rule-bc.charkey_two:VISIBLE IN BROWSE br-gds-obj = no
     4258     tt-dis-rule-bc.charkey_three:VISIBLE IN BROWSE br-gds-obj = no
     4259     tt-dis-rule-bc.key#_one:VISIBLE IN BROWSE br-gds-obj = no
     4260     tt-dis-rule-bc.key#_two:VISIBLE IN BROWSE br-gds-obj = no
     4261     tt-dis-rule-bc.key#_three:VISIBLE IN BROWSE br-gds-obj = no
     4262     tt-dis-rule-bc.d-pcnt:VISIBLE IN BROWSE br-gds-obj = no
     4263     tt-dis-rule-bc.sale-qnty:VISIBLE IN BROWSE br-gds-obj = no
     4264     tt-dis-rule-bc.time-rule-num:VISIBLE IN BROWSE br-gds-obj = no
     4265     .
     4266     v-h = br-gds-obj:FIRST-COLUMN IN FRAME Dialog-Frame.
     4267     DO while valid-handle(v-h) :
     4268       if lookup(v-h:name, v-level-1) > 0
     4269       or lookup(v-h:name, v-level-2) > 0
     4270       then do:
     4271         ASSIGN
     4272         v-h:visible = yes
     4273         .
     4274         find first buf_temp-drt-prop no-lock where
     4275                   buf_temp-drt-prop.templ-rl-root = v-templ-rl-root
     4276               and buf_temp-drt-prop.upper-prop-code = v-h:name
     4277               and buf_temp-drt-prop.prop-code = "column-label" no-error.
     4278         if available buf_temp-drt-prop then do:
     4279           assign
     4280           v-h:label = buf_temp-drt-prop.property-value.
     4281         end.
     4282         find first buf_temp-drt-prop no-lock where
     4283                   buf_temp-drt-prop.templ-rl-root = v-templ-rl-root
     4284               and buf_temp-drt-prop.upper-prop-code = v-h:name
     4285               and buf_temp-drt-prop.prop-code = "format":U no-error.
     4286         if available buf_temp-drt-prop then do:
     4287           assign
     4288           v-h:format = buf_temp-drt-prop.property-value.
     4289         end.
     4290         case v-h:name:
     4291           when "doc-qnty" then do:
     4292             assign
     4293             tt-dis-rule-bc.sum-brutto:VISIBLE IN BROWSE br-gds-obj = YES
     4294             tt-dis-rule-bc.sum-discnt:VISIBLE IN BROWSE br-gds-obj = YES
     4295             tt-dis-rule-bc.sum-netto:VISIBLE IN BROWSE br-gds-obj = YES
     4296              .
     4297            end.
     4298            when "tot-sum" then do:
     4299              assign
     4300             tt-dis-rule-bc.sale-qnty:VISIBLE IN BROWSE br-gds-obj = YES
     4301             tt-dis-rule-bc.doc-qnty:VISIBLE IN BROWSE br-gds-obj = YES
     4302             tt-dis-rule-bc.sum-brutto:VISIBLE IN BROWSE br-gds-obj = YES
     4303             tt-dis-rule-bc.sum-discnt:VISIBLE IN BROWSE br-gds-obj = YES
     4304             tt-dis-rule-bc.sum-netto:VISIBLE IN BROWSE br-gds-obj = YES
     4305             .
     4306            end.
     4307          end case.
     4308       end.
     4309       v-h = v-h:NEXT-COLUMN.
     4310     END.
     4311     if X_upper-dis-rule.value-type <> integer('1':U) then
     4312     tt-dis-rule-bc.d-pcnt:VISIBLE IN BROWSE br-gds-obj = YES.
     4313   END.
     4314   ASSIGN
     4315   rs-sts:RADIO-BUTTONS IN FRAME Dialog-Frame
     4316                          = "Использ&+" + chr(44) +  '0':U + chr(44) +
     4317                          "Все&!" + chr(44) + 'все':U + chr(44) +
     4318                           "Неиспольз&-" + chr(44) + '1':U
     4319   rs-sts = (IF p-sts = -1 THEN 'все':U ELSE string(p-sts))
     4320   .
     4321   if not (p-curr-obj-type = "":U and p-curr-obj-code = 0) then do:
     4322     if p-curr-obj-type = 'орг':U then do:
     4323       assign
     4324       v-host-code = p-curr-obj-code
     4325       v-obj-type = v-cntxt-obj-type
     4326       v-obj-code = v-cntxt-obj-code
     4327       .
     4328     end.
     4329     else do:
     4330   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4331   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4332     (input  p-curr-obj-type
     4333     ,input  p-curr-obj-code
     4334     ,output v-host-code
     4335     )  .
     4336     assign
     4337     v-obj-type = p-curr-obj-type
     4338     v-obj-code = p-curr-obj-code
     4339     .
     4340   end.
     4341   end.
     4342   else do:
     4343     assign
     4344     v-host-code = v-cntxt-host-code-obj
     4345     v-obj-type = v-cntxt-obj-type
     4346     v-obj-code = v-cntxt-obj-code
     4347     .
     4348   end.
     4349   assign
     4350   b-add:MENU-MOUSE in frame Dialog-Frame = 1
     4351   b-copy:MENU-MOUSE in frame Dialog-Frame = 1
     4352   menu-item m_global:sensitive in menu menu-b-add = (if  v-cntxt-db-num = 0 then yes else no)
     4353   menu-item m_host:sensitive in menu menu-b-add = (if v-cntxt-db-num = 0 then yes else no)
     4354   menu-item m_object:sensitive in menu menu-b-add = yes
     4355   menu-item m_host:label in menu menu-b-add = "Фирма" + chr(32) + string(v-host-code)
     4356   menu-item m_object:label in menu menu-b-add = v-obj-type + string(v-obj-code)
     4357   menu-item m_global-copy:sensitive in menu menu-b-copy = (if  v-cntxt-db-num = 0 then yes else no)
     4358   menu-item m_host-copy:sensitive in menu menu-b-copy = (if v-cntxt-db-num = 0 then yes else no)
     4359   menu-item m_object-copy:sensitive in menu menu-b-copy = yes
     4360   menu-item m_host-copy:label in menu menu-b-copy = "Фирма" + chr(32) + string(v-host-code)
     4361   menu-item m_object-copy:label in menu menu-b-copy = v-obj-type + string(v-obj-code)
     4362   .
     4363   IF p-upper-rule-num = ?
     4364   or p-upper-rule-num = 0
     4365   or p-upper-rule-num > 99999 then do:
     4366     ASSIGN
     4367     MENU-ITEM m_global :SENSITIVE IN MENU menu-b-add = NO
     4368     MENU-ITEM m_host :SENSITIVE IN MENU menu-b-add = NO
     4369     MENU-ITEM m_object :SENSITIVE IN MENU menu-b-add = NO
     4370     MENU-ITEM m_global-copy :SENSITIVE IN MENU menu-b-copy = NO
     4371     MENU-ITEM m_host-copy :SENSITIVE IN MENU menu-b-copy = NO
     4372     MENU-ITEM m_object-copy :SENSITIVE IN MENU menu-b-copy = NO
     4373     .
     4374   END.
     4375   ELSE DO:
     4376     ASSIGN
     4377     MENU-ITEM m_global :SENSITIVE IN MENU menu-b-add = (v-global > 0 AND v-cntxt-db-num = 0)
     4378     MENU-ITEM m_host :SENSITIVE IN MENU menu-b-add = (v-host > 0 AND v-cntxt-db-num = 0)
     4379     MENU-ITEM m_object :SENSITIVE IN MENU menu-b-add = (v-object > 0)
     4380     MENU-ITEM m_global-copy :SENSITIVE IN MENU menu-b-copy = (v-global > 0 AND v-cntxt-db-num = 0)
     4381     MENU-ITEM m_host-copy :SENSITIVE IN MENU menu-b-copy = (v-host > 0 AND v-cntxt-db-num = 0)
     4382     MENU-ITEM m_object-copy:SENSITIVE IN MENU menu-b-copy = (v-object > 0)
     4383     .
     4384   END.
     4385   if p-mode = 'объект':U
     4386   or p-mode = "template" then do:
     4387      assign
     4388      MENU-ITEM m_global-copy :SENSITIVE IN MENU menu-b-copy =  no
     4389      MENU-ITEM m_host-copy :SENSITIVE IN MENU menu-b-copy = no
     4390      MENU-ITEM m_object-copy:SENSITIVE IN MENU menu-b-copy = no
     4391      .
     4392   end.
     4393   if p-mode = "template" then do:
     4394     MENU-ITEM m_list-copy:label IN MENU menu-b-copy =  "Правила скидок этого типа на другие объекты по списку".
     4395   end.
     4396   if p-mode = 'объект':U then do:
     4397     MENU-ITEM m_list-copy:label IN MENU menu-b-copy =  "Скидки, действующие на этом объекте на другие объекты по списку".
     4398   end.
     4399   IF p-mode <> "upper-rule-num-gds-obj"
     4400   and p-mode <> "dis-gds-rule-gds-obj"
     4401   THEN DO:
     4402     ASSIGN
     4403      br-dis-rule:HEIGHT = br-dis-rule:height * 2.
     4404   END.
     4405   DISPLAY mark-num
     4406   rs-sts
     4407   br-gds-obj WHEN (p-mode = "upper-rule-num-gds-obj" or p-mode = "dis-gds-rule-gds-obj")
     4408   WITH FRAME Dialog-Frame.
     4409   ENABLE
     4410   b-quit
     4411   B-mark when LOOKUP("b-mark":U, bttns) > 0
     4412   B-sel when LOOKUP("b-sel":U, bttns) > 0
     4413   B-add when LOOKUP("b-add":U, bttns) > 0 and
     4414   (p-mode = "upper-rule-num":U OR
     4415    p-mode = "upper-rule-num-object":U OR
