     3189     :
     3190       assign
     3191         v-diasize-browse-number = v-diasize-browse-number + 1
     3192       .
     3193       create buf_temp-browse-handle .
     3194       assign
     3195         buf_temp-browse-handle.browse-type   = p-browse-type
     3196         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3197         buf_temp-browse-handle.browse-handle = p-browse-handle
     3198       .
     3199     end.
     3200   end procedure.
     3201   procedure diasize_init :
     3202     define variable v-default-value    as logical   no-undo .
     3203     define variable v-restore-saved    as logical   no-undo .
     3204     define variable v-resize-value-str as character no-undo .
     3205     do
     3206     on error undo, return error return-value
     3207     :
     3208       do with frame Dialog-Frame
     3209       :
     3210         assign
     3211           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3212           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3213           v-diasize-browse-handle     = browse br-dis-rule :handle
     3214         .
     3215         create button v-diasize-resize-button
     3216         assign
     3217           parent        = frame Dialog-Frame :first-child
     3218           label         = "s"
     3219           height-pixels = 16
     3220           width-pixels  = 16
     3221           visible       = true
     3222           sensitive     = true
     3223           movable       = true
     3224           triggers:
     3225             on end-move persistent run diasize_end-move in this-procedure .
     3226           end triggers.
     3227         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3228         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3229         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3230         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3231         assign
     3232           v-diasize-wndmax = false
     3233         .
     3234         if connected("ub") = true
     3235         then do:
     3236           define variable v-cntxt-db-num        as integer   no-undo .
     3237           define variable v-cntxt-userid        as character no-undo .
     3238           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3239                                             , OUTPUT v-cntxt-userid
     3240                                             ) .
     3241           run gbl/wndpar_r.p
     3242             (input  v-cntxt-db-num
     3243             ,input  v-cntxt-userid
     3244             ,input  'wndmax':U
     3245             ,output v-diasize-wndmax
     3246             ,output v-default-value
     3247             ) .
     3248         end.
     3249         assign
     3250           v-diasize-wndstore = false
     3251         .
     3252         if connected("ub") = true
     3253         then do:
     3254           run gbl/wndpar_r.p
     3255             (input  v-cntxt-db-num
     3256             ,input  v-cntxt-userid
     3257             ,input  'wndstore':U
     3258             ,output v-diasize-wndstore
     3259             ,output v-default-value
     3260             ) .
     3261         end.
     3262         assign
     3263           v-diasize-proc-name = entry(1, program-name(2), '.')
     3264         .
     3265         if v-diasize-wndstore = true
     3266         then do:
     3267           assign
     3268             v-restore-saved = false
     3269           .
     3270           if connected("ub") = true
     3271           then do:
     3272             run gbl/wndsizer.p
     3273               (input  v-cntxt-db-num
     3274               ,input  v-cntxt-userid
     3275               ,input  v-diasize-proc-name
     3276               ,input  'height':u
     3277               ,output v-resize-value-str
     3278               ) .
     3279             if v-resize-value-str <> '':U
     3280             then do:
     3281               run diasize_change-height in this-procedure
     3282                 (input  integer(v-resize-value-str)
     3283                 ,input  true
     3284                 ) .
     3285               assign
     3286                 v-restore-saved = true
     3287               .
     3288             end.
     3289           end.
     3290           if connected("ub") = true
     3291           then do:
     3292             run gbl/wndsizer.p
     3293               (input  v-cntxt-db-num
     3294               ,input  v-cntxt-userid
     3295               ,input  v-diasize-proc-name
     3296               ,input  'width':u
     3297               ,output v-resize-value-str
     3298               ) .
     3299             if v-resize-value-str <> '':U
     3300             then do:
     3301               run diasize_change-width in this-procedure
     3302                 (input  integer(v-resize-value-str)
     3303                 ,input  true
     3304                 ) .
     3305               assign
     3306                 v-restore-saved = true
     3307               .
     3308             end.
     3309           end.
     3310           if v-restore-saved <> true
     3311           then do:
     3312             if v-diasize-wndmax = true
     3313             then do:
     3314               run diasize_maximize in this-procedure
     3315                 (input  true
     3316                 ) .
     3317             end.
     3318           end.
     3319         end.
     3320         else do:
     3321           if v-diasize-wndmax = true
     3322           then do:
     3323             run diasize_maximize in this-procedure
     3324               (input  true
     3325               ) .
     3326           end.
     3327         end.
     3328       end.
     3329     end.
     3330   end procedure.
     3331   procedure diasize_need-full-display :
     3332     define output parameter p-need-full-display as logical   no-undo .
     3333     do
     3334     on error undo, return error return-value
     3335     :
     3336       assign
     3337         p-need-full-display = v-diasize-need-full-display
     3338       .
     3339       assign
     3340         v-diasize-need-full-display = false
     3341       .
     3342     end.
     3343   end procedure.
     3344   procedure get-context :
     3345      define output parameter p-db-num as integer          no-undo.
     3346      define output parameter p-user-id as character        no-undo.
     3347      define variable v-login               as character    no-undo.
     3348      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3349      define buffer buf_user-login  for ub.user-login .
     3350      do
     3351      on error undo, return error
     3352      :
     3353            FIND FIRST buf_sys-ctrl no-lock.
     3354            ASSIGN
     3355               v-login = USERID("ub")
     3356               p-db-num = buf_sys-ctrl.db-num
     3357            .
     3358            FIND FIRST buf_user-login
     3359                 WHERE buf_user-login.db-num = p-db-num
     3360                   AND buf_user-login.user-login = v-login
     3361                 no-lock
     3362                 no-error
     3363                 .
     3364            IF AVAILABLE buf_user-login
     3365            THEN DO:
     3366               assign
     3367                  p-user-id = buf_user-login.user-id
     3368               .
     3369            END.
     3370      end.
     3371   end procedure.
     3372   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3373   on f5 of frame Dialog-Frame anywhere
     3374   do:
     3375      v-doc-rec = ?. if available X_dis-rule then v-doc-rec = recid(X_dis-rule). run openbr in this-procedure ( input yes, input no, input '':U).  reposition br-dis-rule to recid v-doc-rec no-error.                apply 'entry' to br-dis-rule in frame Dialog-Frame.                 APPLY 'value-changed' to br-dis-rule.
     3376       apply "VALUE-CHANGED" to br-dis-rule.
     3377   end.
     3378   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3379   procedure set-filter-name :
     3380   define input parameter p-filter-name as character no-undo .
     3381     do with frame Dialog-Frame:
     3382       if p-filter-name > "" then do:
     3383         assign
     3384           frame Dialog-Frame:title
     3385             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     3386         .
     3387         assign
     3388           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     3389         .
     3390       end.
     3391       else do:
     3392         assign
     3393           b-sch :tooltip = ""
     3394         .
     3395       end.
     3396     end.
     3397   end procedure.
     3398   def var sort-labelbr-dis-rule   as character no-undo .
     3399   def var sort-clmnbr-dis-rule    as handle    no-undo .
     3400   def var cur-clmnbr-dis-rule     as handle    no-undo .
     3401   def var cur-clmn-locbr-dis-rule as integer   no-undo .
     3402   def var re-querybr-dis-rule     as logical   initial no no-undo .
     3403   on start-search, ctrl-o of br-dis-rule in frame Dialog-Frame do:
     3404      run sort-brbr-dis-rule
     3405        (input (if available X_dis-rule
     3406                then recid(X_dis-rule)
     3407                else ?
     3408               )
     3409        ).
     3410   end.
     3411   PROCEDURE sort-brbr-dis-rule :
     3412     define input parameter p-recid as recid no-undo .
     3413     if re-querybr-dis-rule = no then do:
     3414       assign
     3415          cur-clmnbr-dis-rule = br-dis-rule:current-column in frame Dialog-Frame
     3416       .
     3417       if sort-clmnbr-dis-rule <> ? then sort-clmnbr-dis-rule:column-fgcolor = 0.
     3418       if cur-clmnbr-dis-rule = sort-clmnbr-dis-rule then do:
     3419         assign
     3420            sort-labelbr-dis-rule = ""
     3421            sort-clmnbr-dis-rule = ?
     3422         .
     3423        end.
     3424        else do:
     3425          assign
     3426            sort-labelbr-dis-rule = cur-clmnbr-dis-rule:label
     3427            sort-clmnbr-dis-rule  = cur-clmnbr-dis-rule
     3428            sort-clmnbr-dis-rule:column-fgcolor = 4
     3429          .
     3430        end.
     3431      end.
     3432     assign
     3433       cur-clmn-locbr-dis-rule = 1
     3434     .
     3435     def var column-handle as handle no-undo .
     3436     column-handle = br-dis-rule:first-column.
     3437     do while valid-handle(column-handle) :
     3438       if column-handle = cur-clmnbr-dis-rule then do:
     3439         leave .
     3440       end.
     3441       column-handle = column-handle:NEXT-COLUMN.
     3442       assign
     3443         cur-clmn-locbr-dis-rule = cur-clmn-locbr-dis-rule + 1
     3444       .
     3445     end.
     3446     case sort-labelbr-dis-rule:
     3447           when X_dis-rule.rule-num:label in browse br-dis-rule then DO:    assign       sort-column-name = "X_dis-rule.rule-num"     .     run OpenBr in this-procedure ( input YES, input NO, input '':U).   . END.
     3448       otherwise do:
     3449         assign
     3450           sort-column-name = ""
     3451         .
     3452         run OpenBr in this-procedure ( input YES, input NO, input '':U).
     3453           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-dis-rule') then do:
     3454             run mv-brw-defaultbr-dis-rule.
     3455           end.
     3456         if sort-labelbr-dis-rule <> "" then do:
     3457           assign
     3458             cur-clmnbr-dis-rule:column-fgcolor = 0
     3459           .
     3460         end.
     3461         assign
     3462           cur-clmn-locbr-dis-rule = ?
     3463         .
     3464       end.
     3465     end case.
     3466       if cur-clmn-locbr-dis-rule <> ? then do:
     3467         if can-do( this-procedure:internal-entries, 'ch-clmnbr-dis-rule') then do:
     3468           run ch-clmnbr-dis-rule in this-procedure (cur-clmn-locbr-dis-rule).
     3469         end.
     3470       end.
     3471     if p-recid <> ? then do:
     3472       reposition br-dis-rule to recid p-recid no-error.
     3473       apply "value-changed" to br-dis-rule in frame Dialog-Frame.
     3474     end.
     3475     apply "entry" to br-dis-rule in frame Dialog-Frame.
     3476   END PROCEDURE.
     3477   procedure re-open-query-srt-clmnbr-dis-rule:
