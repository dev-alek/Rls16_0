     1999   ON CHOOSE OF MENU-ITEM m_list-copy
     2000   DO:
     2001   define variable loc-doc-rec as recid no-undo .
     2002     case p-mode:
     2003       when 'объект':U then do:
     2004         if available X_dis-rule then do:
     2005           loc-doc-rec = recid(X_dis-rule).
     2006         end.
     2007         run utl/drc_obj.w ( input parparentproc
     2008                        ,input 'объект':U
     2009                        ,input 0
     2010                        ,input p-curr-obj-type
     2011                        ,input p-curr-obj-code
     2012                        ) no-error.
     2013       end.
     2014       when "template" then do:
     2015         if not available X_dis-rule then do:
     2016           undo, return no-apply.
     2017         end.
     2018         run utl/drc_obj.w ( input parparentproc
     2019                        ,input "template"
     2020                        ,input X_dis-rule.templ-rl-root
     2021                        ,input ''
     2022                        ,input 0
     2023                        ) no-error.
     2024       end.
     2025       otherwise do:
     2026         if not available X_dis-rule then do:
     2027           undo, return no-apply.
     2028         end.
     2029         if not (X_dis-rule.obj-type = 'маг':U
     2030                 or
     2031                 X_dis-rule.obj-type = 'скл':U) then do:
     2032           message
     2033           "Нельзя скопировать с правила скидки, которое действует НЕ ПО ОБЪЕКТУ"
     2034           view-as alert-box error .
     2035           undo, return no-apply.
     2036         end.
     2037         loc-doc-rec = recid(X_dis-rule).
     2038         run utl/drc_obj.w ( input parparentproc
     2039                        ,input "rule-num"
     2040                        ,input X_dis-rule.rule-num
     2041                        ,input ''
     2042                        ,input 0
     2043                        ) no-error.
     2044       end.
     2045     end case.
     2046   RUn OpenBR in this-procedure ( input YES, input NO, input '':U).
     2047   reposition br-dis-rule to recid loc-doc-rec no-error.
     2048   if error-status:error then do:                           find first pos_dis-rule no-lock where                                   recid(pos_dis-rule) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи ПРАВИЛО СКИДКИ" skip                            string(if avail pos_dis-rule                                     then  substitute("номер правила скидки: &1"                                                     , pos_dis-rule.rule-num)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     2049   apply "entry" to br-dis-rule in frame Dialog-Frame.
     2050   apply "value-changed" to br-dis-rule in frame Dialog-Frame.
     2051   END.
     2052   ON CHOOSE OF MENU-ITEM m_object-copy
