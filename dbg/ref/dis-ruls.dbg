     1005   procedure discfgru-check :
     1006   define input parameter p-table-name as character no-undo .
     1007   define input parameter p-templ-rl-root as integer no-undo .
     1008   define input parameter p-time-templ-rl-root as integer no-undo .
     1009   define input parameter p-pos-type as character no-undo .
     1010   define output parameter p-disnct-role as character no-undo .
     1011   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     1012     do
     1013     on error undo, return error return-value
     1014     :
     1015       find first buf_dis-cfg-rule no-lock where
     1016               buf_dis-cfg-rule.table-name = p-table-name
     1017           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
     1018           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
     1019           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
     1020       if not available buf_dis-cfg-rule
     1021       or p-pos-type = "":U
     1022       then do:
     1023          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
     1024                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
     1025                                  , p-templ-rl-root
     1026                                  , (if p-time-templ-rl-root = ?
     1027                                     then '':U
     1028                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
     1029                                     )
     1030                                  ).
     1031       end.
     1032       assign
     1033       p-disnct-role = buf_dis-cfg-rule.discnt-role
     1034       .
     1035     end.
     1036   end procedure.
     1037   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1038   FUNCTION get-region RETURNS CHARACTER
     1039     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1040     define variable par-region as character no-undo.
     1041     if parhost-code = 0 and
     1042          parobj-type = "":U and
     1043          parobj-code = 0 then do:
     1044          par-region = "Глобально".
     1045          return par-region.
     1046       end.
     1047       if parobj-type = 'орг':U then do:
     1048          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1049          return par-region.
     1050       end.
     1051       if parobj-type = 'регион':U
     1052       then do:
     1053          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1054          return par-region.
     1055       end.
     1056       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1057       return par-region.
     1058   END FUNCTION.
     1059   FUNCTION get-objregion RETURNS CHARACTER
     1060     (  input parobj-type as character, input parobj-code as integer ) :
     1061     define variable par-region as character no-undo.
     1062     if  parobj-type = "":U and
     1063         parobj-code = 0
     1064     then do:
     1065        par-region = "Глобально".
     1066     end.
     1067     else if parobj-type = 'орг':U
     1068     then do:
     1069        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1070     end.
     1071     else if parobj-type = 'регион':U
     1072     then do:
     1073        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1074     end.
     1075     else
     1076        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1077     return par-region.
     1078   END FUNCTION.
     1079   procedure disgdsru-name :
     1080   define buffer buf_dis-rule for ub.dis-rule.
     1081   do
     1082     on error undo, return error
     1083     :
     1084     define input  parameter p-templ-rl-root  as integer no-undo .
     1085     define output parameter p-label          as character no-undo .
     1086     find first buf_dis-rule no-lock where
     1087               buf_dis-rule.rule-num = p-templ-rl-root no-error.
     1088     if available buf_dis-rule
     1089     then do:
     1090       if buf_dis-rule.rule-num > 0 then
     1091       p-label = buf_dis-rule.des.
     1092     end.
     1093     else do:
     1094       p-label = substitute("Неизвестный тип правила скидки &1", p-templ-rl-root).
     1095     end.
     1096   end.
     1097   end procedure.
     1098   function disgdsru-get-disc-label returns character ( input p-templ-rl-root as integer):
     1099   define variable v-rule-label as character no-undo .
     1100   run disgdsru-name in this-procedure ( input p-templ-rl-root
     1101                                        ,output v-rule-label) no-error.
     1102   return v-rule-label.
     1103   end function.
     1104   function disgdsru-get-disc-role-label returns character ( input p-discnt-role as character):
     1105   define variable v-rule-label as character no-undo .
     1106   return entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u).
     1107   end function.
     1108   procedure disgdsru-write :
     1109     do
     1110     on error undo, return error
     1111     :
     1112       define input parameter p-obj-type       like ub.dis-gds-rule.obj-type   no-undo .
     1113       define input parameter p-obj-code       like ub.dis-gds-rule.obj-code   no-undo .
     1114       define input parameter p-gds-code       like ub.dis-gds-rule.gds-code   no-undo .
     1115       define input parameter p-pos-type       like ub.dis-gds-rule.pos-type   no-undo .
     1116       define input parameter p-discnt-role    like ub.dis-gds-rule.discnt-role no-undo .
     1117       define input parameter p-templ-rl-root  like ub.dis-gds-rule.templ-rl-root  no-undo .
     1118       define input parameter p-time-templ-rl-root  like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     1119       define input parameter p-rule-num       like ub.dis-gds-rule.rule-num    no-undo .
     1120       define input parameter p-nonunique      like ub.dis-gds-rule.nonunique   no-undo .
     1121       define buffer buf_dis-gds-rule for ub.dis-gds-rule .
     1122       define buffer buf_dis-rule for ub.dis-rule.
     1123       define buffer lock_dis-gds-rule for ub.dis-gds-rule .
     1124       define variable v-label          as character no-undo .
     1125       define variable v-discnt-role as character no-undo .
     1126       run discfgru-check in this-procedure (
     1127                                             input 'dis-gds-rule':U
     1128                                            ,input p-templ-rl-root
     1129                                            ,input p-time-templ-rl-root
     1130                                            ,input p-pos-type
     1131                                            ,output v-discnt-role
     1132                                             ) no-error .
     1133       if error-status :error then do:
     1134         undo, return error return-value .
     1135       end.
     1136       if p-discnt-role = ? then do:
     1137         p-discnt-role = v-discnt-role.
     1138       end.
     1139       if p-discnt-role <> v-discnt-role then do:
     1140         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не может быть по шаблону &7 и расписанию &8"
     1141                                 ,p-gds-code
     1142                                 ,p-obj-type
     1143                                 ,p-obj-code
     1144                                 ,p-pos-type
     1145                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1146                                 ,chr(10)
     1147                                 ,p-templ-rl-root
     1148                                 ,p-rule-num).
     1149       end.
     1150       if p-pos-type = ? then do:
     1151   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1152   define variable v-param-type13 as character no-undo .
     1153   define variable v-value-date13 as date no-undo .
     1154   define variable v-value-decimal13 as decimal no-undo .
     1155   define variable v-value-integer13 as INTEGER no-undo .
     1156   define variable v-value-logical13 AS LOGICAL no-undo .
     1157   define variable v-tth13 as handle no-undo .
     1158   run adm/shattri.p (
     1159       input "get":U
     1160       ,input  p-obj-type
     1161       ,input  p-obj-code
     1162       ,input  'cd-sending':U
     1163       ,input  'dflt-cd':U
     1164       ,output p-pos-type
     1165       ,output v-value-date13
     1166       ,output v-value-decimal13
     1167       ,output v-value-integer13
     1168       ,output v-value-logical13
     1169       ,output v-param-type13
     1170       ,INPUT-OUTPUT table-handle v-tth13
     1171       )  .
     1172   delete object v-tth13 no-error.
     1173       end.
     1174       find first buf_dis-rule no-lock where
     1175                 buf_dis-rule.rule-num = p-rule-num no-error.
     1176       if not available buf_Dis-rule then do:
     1177         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не найдено правило скидки &7"
     1178                                 ,p-gds-code
     1179                                 ,p-obj-type
     1180                                 ,p-obj-code
     1181                                 ,p-pos-type
     1182                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1183                                 ,chr(10)
     1184                                 ,p-rule-num).
     1185       end.
     1186       if buf_dis-rule.root <> yes then do:
     1187         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6правило скидки &7 - некорневое"
     1188                                 ,p-gds-code
     1189                                 ,p-obj-type
     1190                                 ,p-obj-code
     1191                                 ,p-pos-type
     1192                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1193                                 ,chr(10)
     1194                                 ,p-rule-num).
     1195       end.
     1196       if not (p-obj-type = buf_dis-rule.obj-type
     1197           and p-obj-code = buf_dis-rule.obj-code)
     1198       and not ( (p-obj-type = 'маг':U or p-obj-type = 'скл':U )
     1199                and
     1200                (buf_dis-rule.obj-type = 'орг':U or buf_dis-rule.obj-type = ""))
     1201        then do:
     1202         undo, return error (substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6"
     1203                                 ,p-gds-code
     1204                                 ,p-obj-type
     1205                                 ,p-obj-code
     1206                                 ,p-pos-type
     1207                                 ,entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1208                                 ,chr(10)
     1209                                 ) +
     1210                             substitute("Правило скидки &1 определено для &2&3" +
     1211                                        "а привязка к товару для &4"
     1212                                        ,buf_dis-rule.rule-num
     1213                                        ,get-objregion( buf_dis-rule.obj-type, buf_Dis-rule.obj-code)
     1214                                        ,chr(10)
     1215                                        ,get-objregion( p-obj-type, p-obj-code)
     1216                                        ))
     1217                                 .
     1218       end.
     1219       find first buf_dis-gds-rule exclusive-lock where
     1220                  buf_dis-gds-rule.gds-code  = p-gds-code
     1221              AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1222              AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1223              AND buf_dis-gds-rule.pos-type  = p-pos-type
     1224              AND buf_dis-gds-rule.discnt-role = p-discnt-role
     1225              and buf_dis-gds-rule.nonunique = p-nonunique
     1226              no-error .
     1227       if not available buf_dis-gds-rule then do:
     1228         find first buf_dis-gds-rule exclusive-lock where
     1229                   buf_dis-gds-rule.gds-code  = p-gds-code
     1230               AND buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1231               AND buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1232               AND buf_dis-gds-rule.pos-type  = p-pos-type
     1233               AND buf_dis-gds-rule.discnt-role = p-discnt-role
     1234               no-error .
     1235         if available buf_Dis-gds-rule then do:
     1236           if p-nonunique = ''
     1237           and available buf_dis-gds-rule
     1238           then do:
     1239             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует (детализ. &3)"
     1240                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1241                                      , p-gds-code
     1242                                      , buf_Dis-rule.obj-type
     1243                                      , buf_Dis-rule.obj-code
     1244                                      , p-nonunique
     1245                                     ).
     1246           end.
     1247           if available buf_dis-gds-rule
     1248           and buf_dis-gds-rule.nonunique = ''
     1249           and p-nonunique <> ''then do:
     1250             return error substitute("Скидка типа &1 на товар с кодом &2 &3&4 уже существует"
     1251                                      , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)
     1252                                      , p-gds-code
     1253                                      , buf_Dis-rule.obj-type
     1254                                      , buf_Dis-rule.obj-code
     1255                                     ).
     1256           end.
     1257         end.
     1258         create buf_dis-gds-rule .
     1259         assign
     1260         buf_dis-gds-rule.gds-code  = p-gds-code
     1261         buf_dis-gds-rule.obj-type  = buf_dis-rule.obj-type
     1262         buf_dis-gds-rule.obj-code  = buf_dis-rule.obj-code
     1263         buf_dis-gds-rule.pos-type = p-pos-type
     1264         buf_dis-gds-rule.discnt-role = v-discnt-role
     1265         buf_dis-gds-rule.rule-num = p-rule-num
     1266         buf_dis-gds-rule.nonunique = p-nonunique
     1267         no-error
     1268         .
     1269       end.
     1270       ASSIGN
     1271       buf_dis-gds-rule.rule-num = p-rule-num
     1272       buf_dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     1273       buf_dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     1274       buf_dis-gds-rule.templ-rl-root = p-templ-rl-root
     1275       buf_dis-gds-rule.nonunique = p-nonunique
     1276       no-error.
     1277     end.
     1278   end procedure.
     1279   PROCEDURE cmp-disgdsru-write :
     1280   do
     1281   on error undo, return error
     1282   :
     1283     define input parameter p-gds-code like ub.dis-gds-rule.gds-code   no-undo .
     1284     define input parameter p-obj-type like ub.dis-gds-rule.obj-type   no-undo .
     1285     define input parameter p-obj-code like ub.dis-gds-rule.obj-code   no-undo .
     1286     define input parameter p-pos-type like ub.dis-gds-rule.pos-type   no-undo .
     1287     define input parameter p-templ-rl-root     like ub.dis-gds-rule.templ-rl-root  no-undo .
     1288     define input parameter p-time-templ-rl-root     like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     1289     define input parameter p-discnt-role like ub.dis-gds-rule.discnt-role no-undo .
     1290     define input parameter p-rule-num    like ub.dis-gds-rule.rule-num no-undo .
     1291     define input parameter p-nonunique like ub.dis-gds-rule.nonunique no-undo .
     1292     define variable v-rule-label          as character no-undo .
     1293     define buffer buf_tt0-dis-gds-rule for ub.dis-gds-rule .
     1294     define buffer buf_dis-rule     for ub.dis-rule.
     1295     run disgdsru-name in this-procedure (
     1296                                         input  p-templ-rl-root
     1297                                         ,output v-rule-label
     1298                                         ) no-error .
     1299     if error-status :error then do:
     1300       undo, return error return-value .
     1301     end.
     1302     find first buf_tt0-dis-gds-rule exclusive-lock where
     1303                 buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     1304             AND buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     1305             AND buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     1306             AND buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     1307             AND buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     1308             AND buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1309             no-error .
     1310     if not available buf_tt0-dis-gds-rule then do:
     1311       create buf_tt0-dis-gds-rule .
     1312       assign
     1313       buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     1314       buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     1315       buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     1316       buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     1317       buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1318       buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     1319       no-error
     1320       .
     1321     end.
     1322     find first buf_dis-rule no-lock where
     1323               buf_dis-rule.rule-num = p-rule-num.
     1324     ASSIGN
     1325     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     1326     buf_tt0-dis-gds-rule.rule-num = p-rule-num
     1327     buf_tt0-dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     1328     buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1329     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     1330     buf_tt0-dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     1331     no-error.
     1332     release buf_tt0-dis-gds-rule no-error .
     1333     if error-status:error then do:
     1334       undo, return error return-value .
     1335     end.
     1336   end.
     1337   END PROCEDURE.
     1338   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1339   FUNCTION gtregion RETURNS CHARACTER
     1340     ( input parhost-code as integer
     1341     , input parobj-type as character
     1342     , input parobj-code as integer
     1343     , input p-templ-rl-root as integer
     1344     , input p-template as logical
     1345     , input p-tab as logical
     1346     ) :
     1347     def var par-region as character no-undo.
     1348     define variable v-g as character no-undo .
     1349     define variable v-h as character no-undo .
     1350     define variable v-o as character no-undo .
     1351     define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     1352       if p-template then do:
     1353         find first buf_dis-cfg-rule no-lock where
     1354                   buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root no-error.
     1355         assign
     1356         v-g = (if available buf_dis-cfg-rule
     1357               and buf_dis-cfg-rule.has-global = 1
     1358               then "Глоб"
     1359               else '')
     1360         par-region = v-g + chr(44)
     1361         v-h =  (if available buf_dis-cfg-rule
     1362                 and buf_dis-cfg-rule.has-host = 1
     1363                 then "Фирма"
     1364                 else '')
     1365         par-region = trim(par-region + v-h, chr(44)) + chr(44)
     1366         v-o = (if available buf_dis-cfg-rule
     1367                and buf_dis-cfg-rule.has-obj = 1
     1368                then "Объ."
     1369                else '')
     1370         par-region = trim(par-region + v-o, chr(44))
     1371         .
     1372         return par-region.
     1373       end.
     1374     if parhost-code = 0 and
     1375          parobj-type = "":U and
     1376          parobj-code = 0 then do:
     1377          par-region = "Глобально".
     1378          return par-region.
     1379       end.
     1380       if parobj-type = "" and
     1381          parobj-code = 0 then do:
     1382          par-region = if p-tab then fill(chr(32), 2) else "":U +
     1383                       "Фирма" + chr(32) + string(parhost-code).
     1384          return par-region.
     1385       end.
     1386       par-region = if p-tab then fill(chr(32), 4) else "":U +
     1387                    parobj-type + chr(32) + string(parobj-code).
     1388       return par-region.
     1389   END FUNCTION.
     1390   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1391     define variable v-cntxt-db-num        as integer   no-undo .
