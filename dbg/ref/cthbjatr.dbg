     5543                      , INPUT filter-point + chr(4) + filter-label
     5544                      , INPUT tbl
     5545                      , INPUT join-tbl
     5546                      , INPUT fld
     5547                      , INPUT lab
     5548                      , INPUT spr
     5549                      , INPUT dim ).
     5550     RUN OpenBr in this-procedure ( input yes, input no, input '':U, input v-corr-user-db-num).
     5551   END.
     5552   END PROCEDURE.
     5553   PROCEDURE proc-br-thbj-attr :
     5554   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5555   if b-sel:sensitive in frame Dialog-Frame then dO:
     5556       if b-mark:sensitive then do:
     5557           apply "choose" to b-mark in frame Dialog-Frame.
     5558       end.
     5559       else do:
     5560           apply "choose" to b-sel in frame Dialog-Frame.
     5561       end.
     5562   end.
     5563   else do:
     5564       if b-lookup:sensitive then
     5565       apply "choose" to b-lookup in frame Dialog-Frame.
     5566   end.
     5567   END PROCEDURE.
     5568   PROCEDURE proc-find-corr-date :
     5569   define input parameter p-next as logical no-undo.
     5570   define input parameter p-date like ub.fin-doc.doc-date no-undo.
     5571   define variable v-date-chr as character no-undo.
     5572   if p-date = ? then return .
     5573   display
     5574   0 @ sch-cli-code
     5575   0 @ sch-db-num
     5576   "":U @ sch-corr-user-name
     5577   with frame Dialog-Frame.
     5578   assign
     5579   v-date-chr = string(day(p-date)) + chr(47) +
     5580                    string(month(p-date)) + chr(47) +
     5581                    string(year(p-date)).
     5582          run OpenBr in this-procedure
     5583           (input false
     5584           ,input true
     5585           ,input substitute("and X_c-thbj-attr.corr-date = &1 "
     5586             , v-date-chr)
     5587           ,input v-corr-user-db-num
     5588           ).
     5589         apply "entry":u to sch-corr-date in frame Dialog-Frame.
     5590   END PROCEDURE.
     5591   PROCEDURE proc-find-db-num :
     5592   define input parameter p-next as logical no-undo.
     5593   define input parameter p-db-num like ub.c-thbj-attr.corr-user-db-num no-undo.
     5594   define variable v-db-num as character no-undo.
     5595   assign
     5596   sch-corr-date = ?
     5597   .
     5598   display
     5599   "":U @ sch-corr-user-name
     5600   0 @ sch-cli-code
     5601   sch-corr-date
     5602   with frame Dialog-Frame.
     5603   assign
     5604   v-db-num = string(p-db-num).
     5605   run OpenBr in this-procedure
     5606       (input false
     5607       ,input p-next
     5608       ,input substitute("and X_c-thbj-attr.corr-user-db-num = &1 "
     5609         , v-db-num)
     5610       ,input v-corr-user-db-num
     5611       ).
     5612   apply "entry":u to sch-db-num in frame Dialog-Frame .
     5613   END PROCEDURE.
     5614   PROCEDURE proc-find-obj-code :
     5615   define input parameter p-next as logical no-undo.
     5616   define input parameter p-obj-code like ub.c-thbj-attr.obj-code no-undo.
     5617   define variable v-obj-code as character no-undo.
     5618   display
     5619   "":U @ sch-corr-user-name
     5620   with frame Dialog-Frame.
     5621   display
     5622   "":U @ sch-corr-user-name
     5623   0 @ sch-db-num
     5624   sch-corr-date
     5625   with frame Dialog-Frame.
     5626   assign
     5627   v-obj-code = string(p-obj-code).
     5628   run OpenBr in this-procedure
     5629       (input false
     5630       ,input p-next
     5631       ,input substitute("and X_c-thbj-attr.obj-code = &1 "
     5632         , v-obj-code)
     5633       ,input v-corr-user-db-num
     5634       ).
     5635   apply "entry":u to sch-cli-code in frame Dialog-Frame .
     5636   END PROCEDURE.
     5637   PROCEDURE proc-find-user :
     5638   define input parameter p-next as logical no-undo.
     5639   define input parameter p-user like ub.c-thbj-attr.corr-user-name no-undo.
     5640   assign
     5641   sch-corr-date = ?.
     5642   display
     5643   0 @ sch-db-num
     5644   sch-corr-date
     5645   0 @ sch-cli-code
     5646   with frame Dialog-Frame.
     5647   p-user = chr(34) + p-user + chr(34).
     5648   run OpenBr in this-procedure
     5649       (input false
     5650       ,input p-next
     5651       ,input substitute("and X_c-thbj-attr.corr-user-name = &1 "
     5652         , p-user)
     5653       ,input v-corr-user-db-num
     5654       ).
     5655   apply "entry":u to sch-corr-user-name in frame Dialog-Frame .
     5656   END PROCEDURE.
     5657   PROCEDURE proc-view-changes :
     5658   define variable v-description as character no-undo .
     5659   for each temp-changes:
     5660       delete temp-changes.
     5661   END.
     5662   if not available X_c-thbj-attr then do:
     5663     Open QUery br-changes for each temp-changes.
     5664     return.
     5665   end.
     5666   run ref/cthbjatv.p (
     5667                      input X_c-thbj-attr.obj-type
     5668                     ,input X_c-thbj-attr.obj-code
     5669                     ,input X_c-thbj-attr.upper-prop-code
     5670                     ,input X_c-thbj-attr.prop-code
     5671                     ,input X_c-thbj-attr.corr-user-db-num
     5672                     ,input X_c-thbj-attr.chip-num
     5673                     ,input X_c-thbj-attr.subject
     5674                     ,input X_c-thbj-attr.action
     5675                     ,input no
     5676                     ,output v-description
     5677                  ) no-error .
     5678   Open QUery br-changes for each temp-changes.
     5679   assign
     5680   br-changes:title in frame Dialog-Frame = v-description
     5681   .
     5682   END PROCEDURE.
     5683   FUNCTION get-action RETURNS CHARACTER
     5684     ( p-action as integer ) :
     5685   define variable dops as character no-undo.
     5686   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     5687   RETURN dops.
     5688   END FUNCTION.
     5689   FUNCTION get-param-name RETURNS CHARACTER
     5690     (p-upper-prop-code as character, p-prop-code as character, output p-section-name as character ) :
     5691   define variable v-tooltip as character no-undo .
     5692   define variable v-label as character no-undo .
     5693   define variable v-tooltip-code as character no-undo .
     5694   run thbjattr_tooltip in this-procedure (
     5695                 input  p-upper-prop-code
     5696               ,input  p-prop-code
     5697               ,output v-tooltip
     5698               ,output v-label
     5699               ,output v-tooltip-code
     5700               ) no-error .
     5701   p-section-name = v-tooltip.
     5702   if not error-status:error then return v-tooltip-code.
     5703   return substitute("&1:&2", p-upper-prop-code, p-prop-code).
     5704   END FUNCTION.
     5705   FUNCTION get-subject RETURNS CHARACTER
     5706     ( p-subject as character ) :
     5707   define variable v-subject as character no-undo .
     5708   v-subject = entry (lookup (p-subject, 'thbj-attr,rp-by-call,rule-by-call,rule-call-param':U), 'Параметры объекта TH,Привязка профайла к месту,Вызов правила,Параметры вызова правил':U) no-error .
     5709   return v-subject.
     5710   END FUNCTION.
