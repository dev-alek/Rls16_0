      710   procedure prn-lib-open-stream :
      711     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      712     define input parameter p-page-size    as integer no-undo .
      713     define input parameter p-is-stream    as logical no-undo .
      714     define input parameter p-append       as logical no-undo .
      715     define variable v-report-name as character no-undo .
      716     do
      717       on error undo, return error
      718       :
      719       run prn-lib-get-report-name  in this-procedure (
      720         input parParentProc
      721         ,output v-report-name
      722         ).
      723       if p-is-stream then
      724       do:
      725         if p-append then
      726         do:
      727           output stream PrnLibStream to value( v-report-name )
      728             page-size value(p-page-size) append .
      729         end.
      730         if not p-append then
      731         do:
      732           output stream PrnLibStream to value( v-report-name )
      733             page-size value(p-page-size) .
      734         end.
      735       end.
      736       if not p-is-stream then
      737       do:
      738         if p-append then
      739         do:
      740           output to value( v-report-name )
      741             page-size value(p-page-size) append .
      742         end.
      743         if not p-append then
      744         do:
      745           output to value( v-report-name )
      746             page-size value(p-page-size) .
      747         end.
      748       end.
      749     end.
      750   end procedure.
      751   procedure prn-lib-open-exp :
      752     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      753     define input parameter p-is-stream    as logical no-undo .
      754     define input parameter p-is-append    as logical no-undo .
      755     define output parameter p-ReportFileName as char init "report" no-undo.
      756     define output parameter p-process as logical no-undo .
      757     define variable glog as logical no-undo .
      758     do
      759       on error undo, return error
      760       :
      761       SYSTEM-DIALOG GET-FILE p-ReportFileName
      762         TITLE      "Укажите путь"
      763         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      764         ASK-OVERWRITE
      765         CREATE-TEST-FILE
      766         SAVE-AS
      767         USE-FILENAME
      768         DEFAULT-EXTENSION "txt"
      769         UPDATE glog
      770         .
      771       if not glog then  return.
      772       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      773       if p-is-stream then
      774       do:
      775         if p-is-append then
      776         do:
      777           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      778         end.
      779         else
      780         do:
      781           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      782         end.
      783       end.
      784       else
      785       do:
      786         if p-is-append then
      787         do:
      788           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      789         end.
      790         else
      791         do:
      792           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      793         end.
      794       end.
      795       p-process = yes.
      796     end.
      797   end procedure.
