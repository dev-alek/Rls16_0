     5419   PROCEDURE proc-b-print :
     5420   define variable date_string     as      char    no-undo.
     5421   define variable Line                as      char    no-undo.
     5422   define variable for-time as char.
     5423   define variable accum-count as integer.
     5424   define variable v-doc-rec as recid no-undo.
     5425   define variable v-subject-chr as character no-undo .
     5426   define variable v-upd-time as character no-undo .
     5427   define variable v-obj as character no-undo .
     5428   define variable v-action-chr as character no-undo .
     5429   define variable v-dop as character no-undo .
     5430   DEFINE FRAME HistoryList
     5431   v-obj COLUMN-LABEL "Объект TH" FORMAT "X(12)"
     5432   v-action-chr FORMAT "X(10)" COLUMN-LABEL "Действие"
     5433   v-param-name COLUMN-LABEL "Назв. параметра" FORMAT "X(20)"
     5434   v-subject-chr COLUMN-LABEL "Предмет изменений" FORMAT "X(20)"
     5435   X_c-thbj-attr.is-news COLUMn-LABEL "СПН" FORMAT "+/ "
     5436   X_c-thbj-attr.corr-date
     5437   v-upd-time COLUMN-LABEL "Время изм." FORMAT "X(8)"
     5438   X_c-thbj-attr.corr-user-name
     5439   X_c-thbj-attr.corr-user-db-num
     5440   HEADER  date_string AT 5 format "X(35)"
     5441   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     5442   Line format "X(195)" AT 1
     5443   with width 232 down stream-io use-text    .
     5444   Line = fill("-", 195).
     5445   date_string = cur-time-print() .
     5446   assign
     5447   v-doc-rec = recid( X_c-thbj-attr ).
     5448   DO WHILE available X_c-thbj-attr :
     5449         GET prev br-thbj-attr.
     5450   END.
     5451   run prn-lib-open-stream  in this-procedure (
     5452                                                input parparentProc
     5453                                               ,input 43
     5454                                               ,input yes
     5455                                               ,input no
     5456                                               ).
     5457   PUT  STREAM PrnLibStream
     5458   SPACE(25) ( frame Dialog-Frame:title )
     5459   format "x(90)" SKIP(1) .
     5460   FORM HEADER
     5461   Line format "X(180)" AT 1 SKIP
     5462   "Продолжение - на следующей странице" AT 30 SKIP
     5463   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     5464   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     5465   FORM with FRAME HistoryList  .
     5466   run waitfram-show in this-procedure ("Ждите...").
     5467     GET next br-thbj-attr.
     5468       DO WHILE available X_c-thbj-attr :
     5469         Display STREAM PrnLibStream
     5470          X_c-thbj-attr.obj-type + string(X_c-thbj-attr.obj-code) @ v-obj
     5471         get-action(X_c-thbj-attr.action) @ v-action-chr
     5472         (if v-find then get-param-name(X_c-thbj-attr.upper-prop-code, X_c-thbj-attr.prop-code, output v-dop) else "":U )
     5473         @ v-param-name
     5474         get-subject(X_c-thbj-attr.subject) @ v-subject-chr
     5475         X_c-thbj-attr.is-news
     5476         X_c-thbj-attr.corr-date
     5477         string(X_c-thbj-attr.corr-time, "HH:MM:SS":U) @ v-upd-time
     5478         X_c-thbj-attr.corr-user-name
     5479         X_c-thbj-attr.corr-user-db-num
     5480         with FRAME HistoryList .
     5481     DOWN STREAM PrnLibStream 1 with FRAME HistoryList  .
     5482     assign
     5483     accum-count = accum-count + 1
     5484     .
     5485     GET next br-thbj-attr.
     5486   END.
     5487   UNDERLINE  STREAM PrnLibStream
     5488   v-obj
     5489   v-action-chr
     5490   v-param-name
     5491   v-subject-chr
     5492   X_c-thbj-attr.is-news
     5493   X_c-thbj-attr.corr-date
     5494   v-upd-time
     5495   X_c-thbj-attr.corr-user-name
     5496   X_c-thbj-attr.corr-user-db-num
     5497   with FRAME HistoryList .
     5498   DISPLAY STREAM PrnLibStream
     5499   "ИТОГО"  @ v-obj
     5500   string(accum-count)  @ v-action-chr
     5501   with frame HistoryList.
     5502   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     5503   HIDE  STREAM PrnLibStream FRAME CheckList.
     5504   output  STREAM PrnLibStream CLOSE.
     5505   run waitfram-hide in this-procedure.
     5506   run prn-lib-prn-file in this-procedure (
     5507                                             input parparentproc
     5508                                             ,input 8
     5509                                             ).
     5510   reposition br-thbj-attr to recid v-doc-rec no-error.
     5511   apply "entry" to br-thbj-attr in frame Dialog-Frame.
     5512   END PROCEDURE.
     5513   PROCEDURE proc-b-sch :
     5514   assign
     5515     tbl = 'c-thbj-attr'
     5516     join-tbl = 'X_c-thbj-attr'
     5517     fld = ""
