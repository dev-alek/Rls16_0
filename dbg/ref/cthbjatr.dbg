     3485   def var sort-labelbr-thbj-attr   as character no-undo .
     3486   def var sort-clmnbr-thbj-attr    as handle    no-undo .
     3487   def var cur-clmnbr-thbj-attr     as handle    no-undo .
     3488   def var cur-clmn-locbr-thbj-attr as integer   no-undo .
     3489   def var re-querybr-thbj-attr     as logical   initial no no-undo .
     3490   on start-search, ctrl-o of br-thbj-attr in frame Dialog-Frame do:
     3491      run sort-brbr-thbj-attr
     3492        (input (if available X_c-thbj-attr
     3493                then recid(X_c-thbj-attr)
     3494                else ?
     3495               )
     3496        ).
     3497   end.
     3498   PROCEDURE sort-brbr-thbj-attr :
     3499     define input parameter p-recid as recid no-undo .
     3500     if re-querybr-thbj-attr = no then do:
     3501       assign
     3502          cur-clmnbr-thbj-attr = br-thbj-attr:current-column in frame Dialog-Frame
     3503       .
     3504       if sort-clmnbr-thbj-attr <> ? then sort-clmnbr-thbj-attr:column-fgcolor = 0.
     3505       if cur-clmnbr-thbj-attr = sort-clmnbr-thbj-attr then do:
     3506         assign
     3507            sort-labelbr-thbj-attr = ""
     3508            sort-clmnbr-thbj-attr = ?
     3509         .
     3510        end.
     3511        else do:
     3512          assign
     3513            sort-labelbr-thbj-attr = cur-clmnbr-thbj-attr:label
     3514            sort-clmnbr-thbj-attr  = cur-clmnbr-thbj-attr
     3515            sort-clmnbr-thbj-attr:column-fgcolor = 4
     3516          .
     3517        end.
     3518      end.
     3519     assign
     3520       cur-clmn-locbr-thbj-attr = 1
     3521     .
     3522     def var column-handle as handle no-undo .
     3523     column-handle = br-thbj-attr:first-column.
     3524     do while valid-handle(column-handle) :
     3525       if column-handle = cur-clmnbr-thbj-attr then do:
     3526         leave .
     3527       end.
     3528       column-handle = column-handle:NEXT-COLUMN.
     3529       assign
     3530         cur-clmn-locbr-thbj-attr = cur-clmn-locbr-thbj-attr + 1
     3531       .
     3532     end.
     3533     case sort-labelbr-thbj-attr:
     3534           when X_c-thbj-attr.corr-date:label in browse br-thbj-attr then DO:    assign       sort-column-name = "X_c-thbj-attr.corr-date"     .     run OpenBr in this-procedure ( input yes, input no, input no, input v-corr-user-db-num).   . END.
     3535           when X_c-thbj-attr.corr-user-db-num:label in browse br-thbj-attr then DO:    assign       sort-column-name = "X_c-thbj-attr.corr-user-db-num"     .     run OpenBr in this-procedure ( input yes, input no, input no, input v-corr-user-db-num).   . END.
     3536       otherwise do:
     3537         assign
     3538           sort-column-name = ""
     3539         .
     3540         run OpenBr in this-procedure ( input yes, input no, input no, input v-corr-user-db-num).
     3541           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-thbj-attr') then do:
     3542             run mv-brw-defaultbr-thbj-attr.
     3543           end.
     3544         if sort-labelbr-thbj-attr <> "" then do:
     3545           assign
     3546             cur-clmnbr-thbj-attr:column-fgcolor = 0
     3547           .
     3548         end.
     3549         assign
     3550           cur-clmn-locbr-thbj-attr = ?
     3551         .
     3552       end.
     3553     end case.
     3554       if cur-clmn-locbr-thbj-attr <> ? then do:
     3555         if can-do( this-procedure:internal-entries, 'ch-clmnbr-thbj-attr') then do:
     3556           run ch-clmnbr-thbj-attr in this-procedure (cur-clmn-locbr-thbj-attr).
     3557         end.
     3558       end.
     3559     if p-recid <> ? then do:
     3560       reposition br-thbj-attr to recid p-recid no-error.
     3561       apply "value-changed" to br-thbj-attr in frame Dialog-Frame.
     3562     end.
     3563     apply "entry" to br-thbj-attr in frame Dialog-Frame.
     3564   END PROCEDURE.
     3565   procedure re-open-query-srt-clmnbr-thbj-attr:
     3566   if cur-clmnbr-thbj-attr = ? then do:
     3567      run OpenBr in this-procedure ( input yes, input no, input no, input v-corr-user-db-num).
     3568   end.
     3569   else do:
     3570      assign re-querybr-thbj-attr = yes.
     3571      run sort-brbr-thbj-attr
     3572        (input (if available X_c-thbj-attr
     3573                then recid(X_c-thbj-attr)
     3574                else ?
     3575               )
     3576        ).
     3577      assign re-querybr-thbj-attr = no.
     3578   end.
     3579   end.
     3580   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3581   do:
     3582     BR-changes :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     3583   end.
     3584   MAIN-BLOCK:
     3585   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3586      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3587      if p-mode <> 'все':U
     3588     and p-mode <> "one":U
     3589    and p-mode <> "subject":U
     3590    and p-mode <> "section":U
     3591    then dO:
     3592       message
     3593       vss-workfile vss-revision vss-description skip
     3594       "Неверное значение параметров вызова p-mode"
     3595       p-mode
     3596       view-as alert-box ERROR.
     3597       return.
     3598    end.
     3599    v-rid-list = p-rid-list.
     3600    if p-mode = "one":U then do:
     3601     find first X_thbj-attr no-lock where
     3602                   X_thbj-attr.obj-type = p-obj-type
     3603               AND X_thbj-attr.obj-code = p-obj-code
     3604               and X_thbj-attr.upper-prop-code = p-upper-prop-code
     3605               and X_thbj-attr.prop-code = p-prop-code
     3606               no-error.
     3607       if not available X_thbj-attr then do:
     3608           message
     3609           vss-workfile vss-revision vss-description skip
     3610           "Неверное значение параметра вызова p-cli-type/p-cli-code/p-upper-prop-code/p-prop-code"
     3611           p-obj-type p-obj-code p-upper-prop-code p-prop-code
     3612           view-as alert-box ERROR.
     3613           return.
     3614       end.
     3615     end.
     3616    if p-mode = "section":U then do:
     3617     find first X_thbj-attr no-lock where
     3618                   X_thbj-attr.obj-type = p-obj-type
     3619               AND X_thbj-attr.obj-code = p-obj-code
     3620               and X_thbj-attr.upper-prop-code = p-upper-prop-code
     3621               no-error.
     3622       if not available X_thbj-attr then do:
     3623           message
     3624           vss-workfile vss-revision vss-description skip
     3625           "Неверное значение параметра вызова p-cli-type/p-cli-code/p-upper-prop-code"
     3626           p-obj-type p-obj-code p-upper-prop-code
     3627           view-as alert-box ERROR.
     3628           return.
     3629       end.
     3630     end.
     3631    if p-mode = "db-num":U then do:
     3632     find first X_db no-lock where
     3633                   X_db.db-num = p-corr-user-db-num no-error.
     3634       if not available X_db then do:
     3635           message
     3636           vss-workfile vss-revision vss-description skip
     3637           "Неверное значение параметра вызова p-corr-user-db-num" p-corr-user-db-num
     3638           view-as alert-box ERROR.
     3639           return.
     3640       end.
     3641     end.
     3642     if v-rid-list <> "" then do:
     3643         FIND FIRST find_c-thbj-attr No-LOCK where
     3644                    recid(find_c-thbj-attr) = integer(entry(1, v-rid-list)) No-ERROR.
     3645         if not avail find_c-thbj-attr then do:
     3646           message
     3647           vss-workfile vss-revision vss-description skip
     3648           "Неверное значение параметра вызова v-rid-list" v-rid-list
     3649           view-as alert-box error .
     3650           return error.
     3651         end.
     3652         v-doc-rec = integer(entry(1, v-rid-list)).
     3653       end.
     3654   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3655   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     3656     (output v-db-num
     3657     )  .
     3658       assign
     3659       v-find = yes.
     3660     if p-mode <> 'все':U then do:
     3661       assign
     3662       v-param-name = get-param-name(p-upper-prop-code, p-prop-code, output v-section-name)
     3663       .
