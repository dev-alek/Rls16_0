     1366   define buffer X_cli-grp for ub.cli-grp.
     1367   define variable filter-point as character no-undo init "cthbjatr" .
     1368   define variable filter-point0 as character no-undo init "cthbjatr" .
     1369   define variable filter-label as character no-undo init "Список полной истории настроек объектов IBS TH" .
     1370   define variable filter-label0 as character no-undo init "Список полной истории настроек объектов IBS TH" .
     1371   define variable sort-column-name as character no-undo .
     1372   define variable print-option as character no-undo.
     1373   DEFINE VARIABLE v-db-num like ub.db.db-num no-undo .
     1374   define variable v-doc-rec as recid no-undo .
     1375   define variable v-find as logical no-undo.
     1376   define variable v-param-name as character no-undo .
     1377   define variable v-start-date-chr as character no-undo .
     1378   define variable v-end-date-chr as character no-undo .
     1379   define variable v-subject-chr as character no-undo .
     1380   define variable v-rid-list as character no-undo .
     1381   define variable v-dop as character no-undo .
     1382   define variable v-section-name as character no-undo .
     1383   define variable dops as character no-undo format "X(250)".
     1384   define variable dopst as character no-undo format "X(1)".
     1385   define buffer X_curr_sysconf for ub.sysconf.
     1386   define buffer X_clients-sysconf for ub.clients.
     1387   define buffer X_clients-obj for ub.clients.
     1388   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1389   define NEW SHARED temp-table temp-changes no-undo
     1390   field f_name as character
     1391   field l_name as character
     1392   field v_old as character
     1393   field v_new as character
     1394   field t_name as character
     1395   field num_ as integer
     1396   field uniq-key-rec as character
     1397   field action as integer
     1398   field fNotChange as logical
     1399   index pi is unique primary
     1400   num_
     1401   t_name
     1402   f_name
     1403   index
     1404   Chan
     1405   fnotChange
     1406   t_name
     1407   f_name
     1408   index imain uniq-key-rec
     1409   .
     1410   FUNCTION get-all-fields returns character (p-file-name as character ):
     1411   define variable v-dop as character no-undo .
     1412     find first _file no-lock where _file._file-name = p-file-name no-error .
     1413     if not available _file then return "":U.
     1414     for each _field no-lock where
     1415              _field._file-recid = recid(_file) :
     1416       assign
     1417       v-dop = v-dop + _field._field-name + chr(44)
     1418       .
     1419     end.
     1420     return trim(v-dop).
     1421   END FUNCTION.
     1422   PROCEDURE proc-full-temp-changes :
     1423     define input  parameter p-hst-handle as handle    no-undo .
     1424     define input  parameter p-main-table as character no-undo .
     1425     define input  parameter p-field-list as character no-undo .
     1426     define input  parameter p-label-form as character no-undo .
     1427     define variable h-new-buf         as handle    no-undo .
     1428     define variable h-main-buf        as handle    no-undo .
     1429     define variable h-for-comp        as handle    no-undo .
     1430     define variable v-inform          as character no-undo .
     1431     define variable v-ind             as integer   no-undo .
     1432     define variable v-idx-field-qnty  as integer   no-undo .
     1433     define variable v-num-entries     as integer   no-undo .
     1434     define variable fh                as handle    no-undo .
     1435     define variable fh-main           as handle    no-undo .
     1436     define variable fh-old            as handle    no-undo .
     1437     define variable fh-new            as handle    no-undo .
     1438     define variable v-field-name      as character no-undo .
     1439     define variable v-field-lvl       as character no-undo .
     1440     define variable v-field-form      as character no-undo .
     1441     define variable v-search-exp      as character no-undo .
     1442     define variable v-srch-main       as character no-undo .
     1443     define variable v-word-link       as character no-undo .
     1444     define variable v-av-chip-num     as logical   no-undo .
     1445     define variable v-main-pi-fld-lst as character no-undo .
     1446     define variable v-main-fld-lst    as character no-undo .
     1447     define variable v-delim-list      as character no-undo .
     1448     define variable v-label           as character no-undo .
     1449     define variable v-old-value       as character no-undo case-sensitive.
     1450     define variable v-new-value       as character no-undo case-sensitive.
     1451     define variable v-chg-fields as character no-undo.
     1452     for each temp-changes:
     1453       delete temp-changes.
     1454     end.
     1455     if not p-hst-handle:available then do:
     1456       return .
     1457     end.
     1458     create buffer h-new-buf  for table p-hst-handle .
     1459     create buffer h-main-buf for table p-main-table .
     1460     assign
     1461       v-inform = h-main-buf:index-information(1)
     1462       v-ind    = 2
     1463     .
     1464     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1465     on error undo, return error
     1466     :
     1467       assign
     1468         v-inform = h-main-buf:index-information( v-ind )
     1469         v-ind    = v-ind + 1
     1470       .
     1471     end.
     1472     if v-inform = ?
     1473       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1474       or entry( 3, v-inform, ",":U ) <> "1":U
     1475     then do:
     1476       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1477     end.
     1478     assign
     1479       v-idx-field-qnty = num-entries( v-inform ) - 4
     1480     .
     1481     if v-idx-field-qnty < 2 then do:
     1482       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1483     end.
     1484     assign
     1485       v-srch-main   = "where":U
     1486       v-word-link   = "":U
     1487       v-av-chip-num = false
     1488       v-delim-list  = "":U
     1489     .
     1490     do v-ind = 1 to v-idx-field-qnty by 2
     1491     on error undo, return error
     1492     :
     1493       assign
     1494         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1495         fh                = p-hst-handle:buffer-field( v-field-name )
     1496         fh-main           = h-main-buf:buffer-field( v-field-name )
     1497         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1498         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1499       .
     1500       if fh:data-type ="character":U then do:
     1501         assign
     1502           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1503         .
     1504       end.
     1505       else do:
     1506         assign
     1507           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1508         .
     1509       end.
     1510       if v-delim-list = "":U then do:
     1511         assign
     1512           v-delim-list = ",":U
     1513         .
     1514       end.
     1515       if v-word-link = "":U then do:
     1516         assign
     1517           v-word-link = "and":U
     1518         .
     1519       end.
     1520     end.
     1521     assign
     1522       v-delim-list  = "":U
     1523     .
     1524     do v-ind = 1 to h-main-buf:num-fields
     1525     on error undo, return error
     1526     :
     1527       assign
     1528         fh-main      = h-main-buf:buffer-field( v-ind )
     1529         v-field-name = fh-main:name
     1530       .
     1531         assign
     1532           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1533         .
     1534         if v-delim-list = "":U then do:
     1535           assign
     1536             v-delim-list = ",":U
     1537           .
     1538         end.
     1539     end.
     1540     assign
     1541       v-inform = p-hst-handle:index-information(1)
     1542       v-ind    = 2
     1543     .
     1544     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1545     on error undo, return error
     1546     :
     1547       assign
     1548         v-inform = p-hst-handle:index-information( v-ind )
     1549         v-ind    = v-ind + 1
     1550       .
     1551     end.
     1552     if v-inform = ?
     1553       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1554       or entry( 3, v-inform, ",":U ) <> "1":U
     1555     then do:
     1556       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1557     end.
     1558     assign
     1559       v-idx-field-qnty = num-entries( v-inform ) - 4
     1560     .
     1561     if v-idx-field-qnty < 2 then do:
     1562       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1563     end.
     1564     assign
     1565       v-search-exp  = "where":U
     1566       v-word-link   = "":U
     1567       v-av-chip-num = false
     1568     .
     1569     do v-ind = 1 to v-idx-field-qnty by 2
     1570     on error undo, return error
     1571     :
     1572       assign
     1573         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1574         fh           = p-hst-handle:buffer-field( v-field-name )
     1575         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1576       .
     1577       if v-field-name = "chip-num":U then do:
     1578         assign
     1579           v-search-exp  = substitute( "&1 >", v-search-exp )
     1580           v-av-chip-num = true
     1581         .
     1582       end.
     1583       else do:
     1584         assign
     1585           v-search-exp = substitute( "&1 =", v-search-exp )
     1586         .
     1587       end.
     1588       if fh:data-type ="character":U then do:
     1589         assign
     1590           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1591         .
     1592       end.
     1593       else do:
     1594         assign
     1595           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1596         .
     1597       end.
     1598       if v-word-link = "":U then do:
     1599         assign
     1600           v-word-link = "and":U
     1601         .
     1602       end.
     1603     end.
     1604     if v-av-chip-num = false then do:
     1605       message
     1606         vss-workfile vss-revision vss-description skip
     1607         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1608         "Использование данной процедуры невозможно!" skip
     1609         view-as alert-box error .
     1610       return error .
     1611     end.
     1612     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1613     if not h-new-buf:available then do:
     1614       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1615       if not h-main-buf:available then do:
     1616         assign
     1617           h-for-comp = ?
     1618         .
     1619       end.
     1620       else do:
     1621         assign
     1622           h-for-comp = h-main-buf
     1623         .
     1624       end.
     1625     end.
     1626     else do:
     1627       assign
     1628         h-for-comp = h-new-buf
     1629       .
     1630     end.
     1631     assign
     1632       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1633     .
     1634     do v-ind = 1 to v-num-entries
     1635     on error undo, return error return-value
     1636     :
     1637       assign
     1638         v-field-name = entry( v-ind, v-main-fld-lst )
     1639         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1640         v-old-value  = fh-old:buffer-value()
     1641         v-label      = trim( fh-old:label )
     1642       .
     1643       if ( trim( p-field-list ) <> "":U
     1644            and lookup( v-field-name, p-field-list ) > 0
     1645          )
     1646          or trim( p-field-list ) = "":U
     1647       then do:
     1648         if h-for-comp <> ? then do:
     1649           assign
     1650             fh-new      = h-for-comp:buffer-field( v-field-name )
     1651             v-new-value = fh-new:buffer-value()
     1652           .
     1653         end.
     1654         else do:
     1655           assign
     1656             v-new-value = "":U
     1657           .
     1658         end.
     1659         if v-old-value <> v-new-value
     1660         then do:
     1661           create temp-changes.
     1662           assign
     1663             temp-changes.t_name = p-main-table
     1664             temp-changes.f_name = v-field-name
     1665             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1666             temp-changes.v_old  = trim( v-old-value )
     1667             temp-changes.v_new  = trim( v-new-value )
     1668             temp-changes.num_   = 0
     1669             temp-changes.fNotChange = v-old-value eq v-new-value
     1670           .
     1671         end.
     1672       end.
     1673     end.
     1674     assign
     1675       v-num-entries = num-entries( p-label-form, chr(8) )
     1676     .
     1677     do v-ind = 1 to v-num-entries
     1678     on error undo, return error return-value
     1679     :
     1680       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1681         assign
     1682           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1683           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1684           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1685         .
     1686         find first temp-changes
     1687           where temp-changes.f_name = v-field-name
     1688           no-error .
     1689         if available temp-changes then do:
     1690           if trim( v-field-lvl ) <> "":U then do:
     1691             assign
     1692               temp-changes.l_name = v-field-lvl
     1693             .
     1694           end.
     1695           if trim( v-field-form ) <> "":U then do:
     1696             assign
     1697               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1698             .
     1699             if h-for-comp <> ? then do:
     1700               assign
     1701                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1702               .
     1703             end.
     1704           end.
     1705         end.
     1706       end.
     1707       else do:
     1708         message
     1709           vss-workfile vss-revision vss-description skip
     1710           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1711           substitute( "список для поля '&1': '&2'"
     1712                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1713                       ,entry( v-ind, p-label-form, chr(8) )
     1714                     ) skip
     1715           substitute( "полный список: &2", p-label-form ) skip
     1716           view-as alert-box error .
     1717       end.
     1718     end.
     1719     delete object h-new-buf .
     1720     delete object h-main-buf .
     1721   END PROCEDURE.
     1722   FUNCTION get-action RETURNS CHARACTER
     1723     ( p-action as integer )  FORWARD.
     1724   FUNCTION get-param-name RETURNS CHARACTER
     1725     (p-upper-prop-code as character, p-prop-code as character, output p-section-name as character )  FORWARD.
     1726   FUNCTION get-subject RETURNS CHARACTER
     1727     ( p-subject as character )  FORWARD.
     1728   DEFINE BUTTON B-Help
     1729        LABEL "Помо&щь"
     1730        SIZE 3 BY 1
     1731        BGCOLOR 8 .
     1732   DEFINE BUTTON b-lookup
     1733        LABEL "Button 1"
     1734        SIZE 10 BY 1.
     1735   DEFINE BUTTON B-mark
     1736        LABEL "&*"
     1737        SIZE 3 BY 1.
     1738   DEFINE BUTTON B-print
     1739        LABEL "Пе&чать"
     1740        SIZE 3 BY 1.
     1741   DEFINE BUTTON b-quit AUTO-END-KEY
     1742        LABEL "&Выход"
     1743        SIZE 10 BY 1
     1744        BGCOLOR 8 .
     1745   DEFINE BUTTON B-sch
     1746        LABEL "&Фильтр"
     1747        SIZE 3 BY 1.
     1748   DEFINE BUTTON b-sel AUTO-GO
     1749        LABEL "Вы&бор"
     1750        SIZE 10 BY 1
     1751        BGCOLOR 8 .
     1752   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1753         VIEW-AS TEXT
     1754        SIZE 6 BY 1
     1755        FGCOLOR 4  NO-UNDO.
     1756   DEFINE VARIABLE sch-cli-code AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1757        LABEL "коду"
     1758        VIEW-AS FILL-IN
     1759        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1760   DEFINE VARIABLE sch-corr-date AS DATE FORMAT "99/99/9999":U
     1761        LABEL "Дате изменения"
     1762        VIEW-AS FILL-IN
     1763        SIZE 11 BY 1 NO-UNDO.
     1764   DEFINE VARIABLE sch-corr-user-name AS CHARACTER FORMAT "X(9)":U
     1765        LABEL "пользователю"
     1766        VIEW-AS FILL-IN
     1767        SIZE 12 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1768   DEFINE VARIABLE sch-db-num AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1769        LABEL "БД"
     1770        VIEW-AS FILL-IN
     1771        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1772   DEFINE VARIABLE v-corr-user-db-num AS INTEGER FORMAT ">>>>9":U INITIAL 0
     1773        LABEL "по БД"
     1774        VIEW-AS FILL-IN
     1775        SIZE 6 BY 1 NO-UNDO.
     1776   DEFINE QUERY BR-changes FOR
     1777         temp-changes SCROLLING.
     1778   DEFINE QUERY br-thbj-attr FOR
     1779         X_c-thbj-attr SCROLLING.
     1780   DEFINE BROWSE BR-changes
     1781     QUERY BR-changes DISPLAY
     1782         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1783   temp-changes.v_old COLUMn-LABEL "Было" format "X(255)"
     1784   temp-changes.v_new COLUMn-LABEL "Стало" format "X(255)"
     1785       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.25.
     1786   DEFINE BROWSE br-thbj-attr
     1787     QUERY br-thbj-attr NO-LOCK DISPLAY
     1788         mark-string(recid(X_c-thbj-attr), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1789         X_c-thbj-attr.corr-date FORMAT "99/99/9999":U
     1790         string(X_c-thbj-attr.corr-time, "HH:MM:SS":U) COLUMN-LABEL "Время изм." FORMAT "X(8)":U
     1791         usrfulnf(X_c-thbj-attr.corr-user-name) FORMAT "X(18)":U
     1792         get-action(X_c-thbj-attr.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1793         X_c-thbj-attr.corr-user-db-num FORMAT ">>>>9":U
     1794         X_c-thbj-attr.is-news FORMAT "+/":U
     1795         X_c-thbj-attr.obj-type + string(X_c-thbj-attr.obj-code) COLUMN-LABEL "Объект" FORMAT "X(12)":U
     1796         if v-find then get-param-name(X_c-thbj-attr.upper-prop-code, X_c-thbj-attr.prop-code, output v-dop) else "":U COLUMN-LABEL "Назв. пар-ра" FORMAT "X(25)":U
     1797         get-subject(X_c-thbj-attr.subject) COLUMN-LABEL "Предмет изменений" FORMAT "X(35)":U WIDTH 15
     1798     ENABLE
     1799         X_c-thbj-attr.corr-date
     1800       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.46.
     1801   DEFINE FRAME Dialog-Frame
     1802        b-quit AT ROW 1 COL 1
     1803        B-mark AT ROW 1 COL 11
     1804        b-sel AT ROW 1 COL 21
     1805        v-corr-user-db-num AT ROW 1 COL 37 COLON-ALIGNED
     1806        b-lookup AT ROW 1 COL 60 WIDGET-ID 2
     1807        B-print AT ROW 1 COL 89
     1808        B-sch AT ROW 1 COL 92
     1809        B-Help AT ROW 1 COL 95
     1810        br-thbj-attr AT ROW 2 COL 1
     1811        sch-db-num AT ROW 13.63 COL 60.13 COLON-ALIGNED
     1812        sch-corr-date AT ROW 13.63 COL 85.75 COLON-ALIGNED
     1813        sch-cli-code AT ROW 13.67 COL 48.13 COLON-ALIGNED
     1814        sch-corr-user-name AT ROW 13.71 COL 22.5 COLON-ALIGNED
     1815        BR-changes AT ROW 14.79 COL 1
     1816        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1817        "ПОИСК ПО" VIEW-AS TEXT
     1818             SIZE 8.38 BY 1 AT ROW 13.63 COL 1.38
     1819             FGCOLOR 4
     1820        SPACE(89.48) SKIP(7.44)
     1821       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1822            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1823            TITLE "История по параметрам"
     1824            CANCEL-BUTTON b-quit.
     1825   ASSIGN
     1826          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1827          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1828   ASSIGN
     1829          b-lookup:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1830   ASSIGN
     1831          br-thbj-attr:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     1832   ON GO OF FRAME Dialog-Frame
     1833   DO:
     1834     p-rid-list = v-rid-list.
     1835   END.
     1836   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1837   DO:
     1838     APPLY "END-ERROR":U TO SELF.
     1839   END.
     1840   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1841   DO:
     1842   define variable loc#log as logical no-undo .
     1843     if available X_c-thbj-attr then do:
     1844   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1845   define variable v-str-recid17 as character no-undo .
     1846   define variable v-num-entry17 as integer   no-undo .
     1847   assign
     1848     v-str-recid17 = trim( string( recid( X_c-thbj-attr ) , "->>>>>>>>>>>9":U ) )
     1849     v-num-entry17 = lookup( v-str-recid17 , v-rid-list )
     1850   .
     1851   if v-num-entry17 > 0 then do:
     1852     assign
     1853       entry( v-num-entry17, v-rid-list ) = "":U
     1854       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1855     .
     1856   end.
     1857   else do:
     1858     assign
     1859       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid17
     1860     .
     1861   end.
     1862       loc#log = br-thbj-attr:refresh() .
     1863       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1864           loc#log = br-thbj-attr:select-next-row ().
     1865           apply "VALUE-CHANGED" to br-thbj-attr in frame Dialog-Frame.
     1866       end.
     1867       if num-entries( v-rid-list ) = 0
     1868       then
     1869           hide mark-num in frame Dialog-Frame.
     1870       else
     1871           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1872     end.
     1873     apply "entry" to br-thbj-attr in frame Dialog-Frame.
     1874   END.
     1875   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1876   DO:
     1877       run proc-b-print in this-procedure no-error.
     1878     if error-status:error then return no-apply.
     1879   END.
     1880   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1881   DO:
     1882       run proc-b-sch in this-procedure no-error.
     1883     if error-status:error then return no-apply.
     1884   END.
     1885   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1886   DO:
     1887     if ( available X_c-thbj-attr ) then do:
     1888       if ( v-rid-list = "" ) or b-mark:sensitive = no
     1889       then
     1890       v-rid-list = string( recid( X_c-thbj-attr ) ) .
     1891     end.
     1892   END.
     1893   ON MOUSE-SELECT-DBLCLICK OF br-thbj-attr IN FRAME Dialog-Frame
     1894   DO:
     1895        run proc-br-thbj-attr in this-procedure no-error.
     1896     if error-status:error then return no-apply.
     1897   END.
     1898   ON RETURN OF br-thbj-attr IN FRAME Dialog-Frame
     1899   DO:
     1900       run proc-br-thbj-attr in this-procedure no-error.
     1901     if error-status:error then return no-apply.
     1902   END.
     1903   ON VALUE-CHANGED OF br-thbj-attr IN FRAME Dialog-Frame
     1904   DO:
     1905     run proc-view-changes in this-procedure no-error.
     1906   END.
     1907   ON CTRL-J OF sch-cli-code IN FRAME Dialog-Frame
     1908   DO:
     1909     run proc-find-obj-code in this-procedure(yes, input frame Dialog-Frame sch-cli-code) no-error.
     1910     if error-status:error then return no-apply.
     1911   END.
     1912   ON RETURN OF sch-cli-code IN FRAME Dialog-Frame
     1913   DO:
     1914     run proc-find-obj-code in this-procedure(no, input frame Dialog-Frame sch-cli-code) no-error.
     1915     if error-status:error then return no-apply.
     1916   END.
     1917   ON CTRL-J OF sch-corr-date IN FRAME Dialog-Frame
     1918   DO:
     1919      run proc-find-corr-date in this-procedure(yes, input frame Dialog-Frame sch-corr-date) no-error.
     1920     if error-status:error then return no-apply.
     1921   END.
     1922   ON RETURN OF sch-corr-date IN FRAME Dialog-Frame
     1923   DO:
     1924     run proc-find-corr-date in this-procedure(no, input frame Dialog-Frame sch-corr-date) no-error.
     1925     if error-status:error then return no-apply.
     1926   END.
     1927   ON CTRL-J OF sch-corr-user-name IN FRAME Dialog-Frame
     1928   DO:
     1929     run proc-find-user in this-procedure(yes, input frame Dialog-Frame sch-corr-user-name) no-error.
     1930     if error-status:error then return no-apply.
     1931   END.
     1932   ON RETURN OF sch-corr-user-name IN FRAME Dialog-Frame
     1933   DO:
     1934     run proc-find-user in this-procedure(no, input frame Dialog-Frame sch-corr-user-name) no-error.
     1935     if error-status:error then return no-apply.
     1936   END.
     1937   ON CTRL-J OF sch-db-num IN FRAME Dialog-Frame
     1938   DO:
     1939     run proc-find-db-num in this-procedure(yes, input frame Dialog-Frame sch-db-num) no-error.
     1940     if error-status:error then return no-apply.
     1941   END.
     1942   ON RETURN OF sch-db-num IN FRAME Dialog-Frame
     1943   DO:
     1944     run proc-find-db-num in this-procedure(no, input frame Dialog-Frame sch-db-num) no-error.
     1945     if error-status:error then return no-apply.
     1946   END.
     1947   ON RETURN OF v-corr-user-db-num IN FRAME Dialog-Frame
     1948   DO:
     1949     assign
     1950     v-corr-user-db-num
     1951     .
     1952     RUn OpenBR in this-procedure ( input yes
     1953                                   ,input no
     1954                                   ,input '':U
     1955                                   ,input  v-corr-user-db-num).
     1956   END.
     1957   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1958   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1959   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1960   on help of frame Dialog-Frame
     1961   do:
     1962     run gbl/app_help.p
     1963       (input this-procedure :file-name
     1964       ,input ''
     1965       ,input ?
     1966       ) no-error.
     1967     if error-status :error then do:
     1968       message
     1969         "Ошибка при вызове помощи"
     1970         error-status :get-message(1)
     1971         view-as alert-box .
     1972     end.
     1973   end.
     1974   run minbtn-set in this-procedure .
     1975   on choose of b-help in frame Dialog-Frame
     1976   do:
     1977     apply "help":u to frame Dialog-Frame .
     1978   end.
     1979   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1980   procedure minbtn-set :
     1981       do
     1982           on error undo, return error return-value
     1983           :
     1984           define variable ii              as integer       no-undo .
     1985           define variable fh              as widget-handle no-undo .
     1986           define variable hh              as widget-handle no-undo .
     1987           define variable v-h             as handle        extent 4 no-undo .
     1988           define variable v-name-button   as character     no-undo .
     1989           define variable v-help-old-x    as decimal       no-undo .
     1990           define variable v-help-old-y    as decimal       no-undo .
     1991           define variable v-help-old-size as decimal       no-undo .
     1992           define variable v-frame-width   as decimal       no-undo .
     1993           define variable jj              as integer       no-undo .
     1994           do
     1995               on error undo, return error
     1996               :
     1997               assign
     1998                   v-frame-width = frame Dialog-Frame:width - 0.3
     1999                   fh            = frame Dialog-Frame:first-child
     2000                   hh            = fh:first-child
     2001                   ii            = 1
     2002                   .
     2003               do while valid-handle(hh):
     2004                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2005                   do:
     2006                       case lc(hh:name) :
     2007                           when "b-help" then
     2008                               do:
     2009                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2010                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2011                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2012                                   hh:TOOLTIP = "Помощь" .
     2013                                   v-help-old-x = hh:column .
     2014                                   v-help-old-y = hh:row    .
     2015                                   v-help-old-size = hh:width .
     2016                                   hh:width-chars = 2.5 .
     2017                               end.
     2018                           when "b-print" then
     2019                               do:
     2020                                   hh:load-image("cmp/b-print.bmp":u) .
     2021                                   hh:TOOLTIP = "Печать" .
     2022                                   v-h[ii] = hh:handle .
     2023                                   ii = ii + 1 .
     2024                                   hh:width-chars = 3 .
     2025                               end.
     2026                           when "b-history" or
     2027                           when "b-hist" then
     2028                               do:
     2029                                   hh:load-image("cmp/b-hist.bmp":u) .
     2030                                   hh:TOOLTIP = "История" .
     2031                                   v-h[ii] = hh:handle .
     2032                                   ii = ii + 1 .
     2033                                   hh:width-chars = 3 .
     2034                               end.
     2035                           when "b-sch" then
     2036                               do:
     2037                                   hh:load-image("cmp/b-sch.bmp":u) .
     2038                                   hh:TOOLTIP = "Установка Фильтра" .
     2039                                   v-h[ii] = hh:handle .
     2040                                   ii = ii + 1 .
     2041                                   hh:width-chars = 3 .
     2042                               end.
     2043                           when "b-hist-user" then
     2044                               do:
     2045                                   hh:load-image("cmp/b-hist.bmp":u) .
     2046                                   hh:TOOLTIP = "История пользователя" .
     2047                                   ii = ii + 1 .
     2048                               end.
     2049                       end case.
     2050                   end.
     2051                   hh = hh:next-sibling.
     2052               end.
     2053               b-help:column = v-frame-width - b-help:width-chars.
     2054               jj = 0.
     2055               repeat ii = 4 to 1 by -1 :
     2056                   if valid-handle (v-h[ii] ) then
     2057                   do:
     2058                       jj  = jj + 1 .
     2059                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2060                       v-h[ii]:row    = v-help-old-y .
     2061                   end.
     2062               end.
     2063           end.
     2064       end.
     2065   end procedure.
     2066   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2067   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2068   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2069   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2070   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2071   define variable v-diasize-current-frame-height as decimal   no-undo .
     2072   define variable v-diasize-change-size          as logical   no-undo .
     2073   define variable v-diasize-resize-button        as handle    no-undo .
     2074   define variable v-diasize-wndmax               as logical   no-undo .
     2075   define variable v-diasize-wndstore             as logical   no-undo .
     2076   define variable v-diasize-proc-name            as character no-undo .
     2077   define variable v-diasize-browse-handle        as handle    no-undo .
     2078   define variable v-diasize-browse-number        as integer   no-undo .
     2079   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2080   define temp-table temp-diasize-handle no-undo
     2081     field handle-value  as handle
     2082     field save-position as decimal
     2083     index xpk is primary unique handle-value
     2084     .
     2085   define temp-table temp-browse-handle no-undo
     2086     field browse-type   as character
     2087     field browse-number as integer
     2088     field browse-handle as handle
     2089     field original-size as decimal
     2090     index xpk is primary unique browse-type browse-number
     2091     index xie browse-type browse-handle
     2092   .
     2093   procedure diasize_change-height :
     2094     define input  parameter p-change-value  as decimal   no-undo .
     2095     define input  parameter p-move-resize   as logical   no-undo .
     2096     define variable v-field-group-handle    as handle    no-undo .
     2097     define variable v-object-handle         as handle    no-undo .
     2098     define variable v-frame-height          as decimal   no-undo .
     2099     define variable v-frame-virtual-height  as decimal   no-undo .
     2100     define variable v-browse-height         as decimal   no-undo .
     2101     define variable v-window-height         as decimal   no-undo .
     2102     define variable v-window-virtual-height as decimal   no-undo .
     2103     define variable v-change-sign           as integer   no-undo .
     2104     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2105     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2106     if p-change-value > 0
     2107     then do:
     2108       if frame Dialog-Frame :height + p-change-value
     2109           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2110       then do:
     2111         assign
     2112           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2113                           - (frame Dialog-Frame :height-chars)
     2114         .
     2115         if p-change-value <= 0
     2116         then do:
     2117           run diasize_position-resize-button in this-procedure .
     2118           return .
     2119         end.
     2120       end.
     2121     end.
     2122     if p-change-value < 0
     2123     then do:
     2124       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2125       then do:
     2126         assign
     2127           p-change-value = v-diasize-orig-frame-height
     2128                          - (frame Dialog-Frame :height-chars)
     2129         .
     2130         if p-change-value >= 0
     2131         then do:
     2132           run diasize_position-resize-button in this-procedure .
     2133           return .
     2134         end.
     2135       end.
     2136     end.
     2137     if p-change-value >= 0
     2138     then do:
     2139       assign
     2140         v-change-sign = 1
     2141       .
     2142     end.
     2143     else do:
     2144       assign
     2145         v-change-sign = -1
     2146       .
     2147     end.
     2148     assign
     2149       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2150     .
     2151     if p-change-value = 0
     2152     then do:
     2153       run diasize_position-resize-button in this-procedure .
     2154       return .
     2155     end.
     2156     move_block:
     2157     do
     2158     on error undo move_block, retry move_block
     2159     :
     2160       if retry
     2161       then do:
     2162         do
     2163         on error undo move_block, leave move_block
     2164         :
     2165           if p-change-value > 0
     2166           then do:
     2167             for each buf_temp-diasize-handle
     2168             on error undo, next
     2169             :
     2170               assign
     2171                 v-object-handle = buf_temp-diasize-handle.handle-value
     2172               .
     2173               if v-object-handle <> v-diasize-resize-button
     2174               then do:
     2175                 assign
     2176                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2177                 .
     2178               end.
     2179             end.
     2180             assign
     2181               v-diasize-browse-handle :height = v-browse-height
     2182             .
     2183             for each buf_temp-browse-handle
     2184               where buf_temp-browse-handle.browse-type = 'height':u
     2185             on error undo, next
     2186             :
     2187               assign
     2188                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2189               .
     2190             end.
     2191             assign
     2192               frame Dialog-Frame :height = v-frame-height
     2193             .
     2194             if frame Dialog-Frame :scrollable = true
     2195             then do:
     2196               assign
     2197                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2198               .
     2199             end.
     2200             run diasize_position-resize-button in this-procedure .
     2201           end.
     2202           else do:
     2203             if frame Dialog-Frame :scrollable = true
     2204             then do:
     2205               assign
     2206                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2207               .
     2208             end.
     2209             assign
     2210               frame Dialog-Frame :height = v-frame-height
     2211             .
     2212             assign
     2213               v-diasize-browse-handle :height = v-browse-height
     2214             .
     2215             for each buf_temp-browse-handle
     2216               where buf_temp-browse-handle.browse-type = 'height':u
     2217             on error undo, next
     2218             :
     2219               assign
     2220                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2221               .
     2222             end.
     2223             for each buf_temp-diasize-handle
     2224             on error undo, next
     2225             :
     2226               assign
     2227                 v-object-handle = buf_temp-diasize-handle.handle-value
     2228               .
     2229               if v-object-handle <> v-diasize-resize-button
     2230               then do:
     2231                 assign
     2232                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2233                 .
     2234               end.
     2235             end.
     2236             run diasize_position-resize-button in this-procedure .
     2237           end.
     2238           assign
     2239             v-diasize-change-size = false
     2240           .
     2241           leave move_block .
     2242         end.
     2243       end.
     2244       assign
     2245         v-diasize-need-full-display = true
     2246       .
     2247       if v-diasize-change-size = false
     2248       then do:
     2249         assign
     2250           v-diasize-change-size = true
     2251         .
     2252       end.
     2253       else do:
     2254         return .
     2255       end.
     2256       assign
     2257         v-frame-height = frame Dialog-Frame :height
     2258         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2259         v-browse-height = v-diasize-browse-handle :height
     2260       .
     2261       for each buf_temp-browse-handle
     2262         where buf_temp-browse-handle.browse-type = 'height':u
     2263       :
     2264         assign
     2265           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2266         .
     2267       end.
     2268       for each buf_temp-diasize-handle
     2269       :
     2270         delete buf_temp-diasize-handle .
     2271       end.
     2272       assign
     2273         v-field-group-handle = frame Dialog-Frame :first-child
     2274       .
     2275       do while valid-handle(v-field-group-handle)
     2276       :
     2277         assign
     2278           v-object-handle = v-field-group-handle :first-child
     2279         .
     2280         do while valid-handle(v-object-handle)
     2281         :
     2282           if  v-object-handle <> v-diasize-browse-handle :handle
     2283           and can-query(v-object-handle, "row")
     2284           and can-query(v-object-handle, "height")
     2285           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2286           then do:
     2287             find first buf_temp-browse-handle
     2288               where buf_temp-browse-handle.browse-type   = 'height':u
     2289                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2290               no-error .
     2291             if available buf_temp-browse-handle
     2292             then do:
     2293             end.
     2294             else do:
     2295               create buf_temp-diasize-handle .
     2296               assign
     2297                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2298                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2299               .
     2300             end.
     2301           end.
     2302           assign
     2303             v-object-handle = v-object-handle :next-sibling
     2304           .
     2305         end.
     2306         assign
     2307           v-field-group-handle = v-field-group-handle :next-sibling
     2308         .
     2309       end.
     2310       do with frame Dialog-Frame
     2311       :
     2312         hide v-diasize-resize-button .
     2313         assign
     2314           v-diasize-resize-button :row    = 1
     2315           v-diasize-resize-button :column = 1
     2316         .
     2317       end.
     2318       if p-change-value > 0
     2319       then do:
     2320         if frame Dialog-Frame :scrollable = true
     2321         then do:
     2322           assign
     2323             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2324             no-error .
     2325           if error-status :error
     2326           or error-status :get-message(1) <> ""
     2327           then do:
     2328             undo move_block, retry move_block .
     2329           end.
     2330         end.
     2331         assign
     2332           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2333           no-error .
     2334         if error-status :error
     2335         or error-status :get-message(1) <> ""
     2336         then do:
     2337           undo move_block, retry move_block .
     2338         end.
     2339         assign
     2340           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2341           no-error .
     2342         if error-status :error
     2343         or error-status :get-message(1) <> ""
     2344         then do:
     2345           undo move_block, retry move_block .
     2346         end.
     2347         for each buf_temp-browse-handle
     2348           where buf_temp-browse-handle.browse-type = 'height':u
     2349         on error undo move_block, retry move_block
     2350         :
     2351           assign
     2352             buf_temp-browse-handle.browse-handle :height
     2353               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2354             no-error .
     2355           if error-status :error
     2356           or error-status :get-message(1) <> ""
     2357           then do:
     2358             undo move_block, retry move_block .
     2359           end.
     2360         end.
     2361         for each buf_temp-diasize-handle
     2362         on error undo move_block, retry move_block
     2363         :
     2364           assign
     2365             v-object-handle = buf_temp-diasize-handle.handle-value
     2366           .
     2367           if v-object-handle <> v-diasize-resize-button
     2368           then do:
     2369             assign
     2370               v-object-handle :row = v-object-handle :row + p-change-value
     2371               no-error .
     2372             if error-status :error
     2373             or error-status :get-message(1) <> ""
     2374             then do:
     2375               undo move_block, retry move_block .
     2376             end.
     2377           end.
     2378         end.
     2379       end.
     2380       else do:
     2381         for each buf_temp-diasize-handle
     2382         on error undo move_block, retry move_block
     2383         :
     2384           assign
     2385             v-object-handle = buf_temp-diasize-handle.handle-value
     2386           .
     2387           if v-object-handle <> v-diasize-resize-button
     2388           then do:
     2389             assign
     2390               v-object-handle :row = v-object-handle :row + p-change-value
     2391               no-error .
     2392             if error-status :error
     2393             or error-status :get-message(1) <> ""
     2394             then do:
     2395               undo move_block, retry move_block .
     2396             end.
     2397           end.
     2398         end.
     2399         assign
     2400           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2401           no-error .
     2402         if error-status :error
     2403         or error-status :get-message(1) <> ""
     2404         then do:
     2405           undo move_block, retry move_block .
     2406         end.
     2407         for each buf_temp-browse-handle
     2408           where buf_temp-browse-handle.browse-type = 'height':u
     2409         on error undo move_block, retry move_block
     2410         :
     2411           assign
     2412             buf_temp-browse-handle.browse-handle :height
     2413               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2414             no-error .
     2415           if error-status :error
     2416           or error-status :get-message(1) <> ""
     2417           then do:
     2418             undo move_block, retry move_block .
     2419           end.
     2420         end.
     2421         assign
     2422           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2423           no-error .
     2424         if error-status :error
     2425         or error-status :get-message(1) <> ""
     2426         then do:
     2427           undo move_block, retry move_block .
     2428         end.
     2429         if frame Dialog-Frame :scrollable = true
     2430         then do:
     2431           assign
     2432             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2433             no-error .
     2434           if error-status :error
     2435           or error-status :get-message(1) <> ""
     2436           then do:
     2437             undo move_block, retry move_block .
     2438           end.
     2439         end.
     2440       end.
     2441       if p-move-resize = true
     2442       then do:
     2443         run diasize_position-resize-button in this-procedure .
     2444       end.
     2445       if v-diasize-wndstore = true
     2446       then do:
     2447         if connected("ub") = true
     2448         then do:
     2449           define variable v-cntxt-db-num        as integer   no-undo .
     2450           define variable v-cntxt-userid        as character no-undo .
     2451           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2452                                             , OUTPUT v-cntxt-userid
     2453                                             ) .
     2454           run gbl/wndsizew.p
     2455             (input  v-cntxt-db-num
     2456             ,input  v-cntxt-userid
     2457             ,input  v-diasize-proc-name
     2458             ,input  'height':u
     2459             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2460             ) .
     2461         end.
     2462       end.
     2463     end.
     2464     assign
     2465       v-diasize-change-size = false
     2466     .
     2467   end procedure.
     2468   procedure diasize_set-height :
     2469     define input  parameter p-new-height  as decimal   no-undo .
     2470     define input  parameter p-move-resize as logical   no-undo .
     2471     do
     2472     on error undo, return error return-value
     2473     :
     2474       run diasize_change-height in this-procedure
     2475         (input  (p-new-height - frame Dialog-Frame :height)
     2476         ,input  p-move-resize
     2477         ) .
     2478     end.
     2479   end procedure.
     2480   procedure diasize_change-width :
     2481     define input  parameter p-change-value as decimal   no-undo .
     2482     define input  parameter p-move-resize  as logical   no-undo .
     2483     define variable v-field-group-handle   as handle    no-undo .
     2484     define variable v-object-handle        as handle    no-undo .
     2485     define variable v-frame-width          as decimal   no-undo .
     2486     define variable v-frame-virtual-width  as decimal   no-undo .
     2487     define variable v-browse-width         as decimal   no-undo .
     2488     define variable v-window-width         as decimal   no-undo .
     2489     define variable v-window-virtual-width as decimal   no-undo .
     2490     define variable v-change-sign          as integer   no-undo .
     2491     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2492     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2493     if p-change-value > 0
     2494     then do:
     2495       if frame Dialog-Frame :width + p-change-value >
     2496           session :width-chars
     2497       then do:
     2498         assign
     2499           p-change-value = session :width-chars - frame Dialog-Frame :width
     2500         .
     2501         if p-change-value <= 0
     2502         then do:
     2503           run diasize_position-resize-button in this-procedure .
     2504           return .
     2505         end.
     2506       end.
     2507     end.
     2508     if p-change-value < 0
     2509     then do:
     2510       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2511       then do:
     2512         assign
     2513           p-change-value = v-diasize-orig-frame-width
     2514                          - frame Dialog-Frame :width
     2515         .
     2516         if p-change-value >= 0
     2517         then do:
     2518           run diasize_position-resize-button in this-procedure .
     2519           return .
     2520         end.
     2521       end.
     2522     end.
     2523     if p-change-value >= 0
     2524     then do:
     2525       assign
     2526         v-change-sign = 1
     2527       .
     2528     end.
     2529     else do:
     2530       assign
     2531         v-change-sign = -1
     2532       .
     2533     end.
     2534     assign
     2535       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2536     .
     2537     if p-change-value = 0
     2538     then do:
     2539       run diasize_position-resize-button in this-procedure .
     2540       return .
     2541     end.
     2542     move_block:
     2543     do
     2544     on error undo move_block, leave move_block
     2545     :
     2546       if retry
     2547       then do:
     2548         do
     2549         on error undo move_block, leave move_block
     2550         :
     2551           if p-change-value > 0
     2552           then do:
     2553             for each buf_temp-diasize-handle
     2554             on error undo, next
     2555             :
     2556               assign
     2557                 v-object-handle = buf_temp-diasize-handle.handle-value
     2558               .
     2559               if v-object-handle <> v-diasize-resize-button
     2560               then do:
     2561                 assign
     2562                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2563                 .
     2564               end.
     2565             end.
     2566             assign
     2567               v-diasize-browse-handle :width = v-browse-width
     2568             .
     2569             for each buf_temp-browse-handle
     2570               where buf_temp-browse-handle.browse-type = 'width':u
     2571             on error undo, next
     2572             :
     2573               assign
     2574                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2575               .
     2576             end.
     2577             assign
     2578               frame Dialog-Frame :width = v-frame-width
     2579             .
     2580             if frame Dialog-Frame :scrollable = true
     2581             then do:
     2582               assign
     2583                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2584               .
     2585             end.
     2586             run diasize_position-resize-button in this-procedure .
     2587           end.
     2588           else do:
     2589             if frame Dialog-Frame :scrollable = true
     2590             then do:
     2591               assign
     2592                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2593               .
     2594             end.
     2595             assign
     2596               frame Dialog-Frame :width = v-frame-width
     2597             .
     2598             for each buf_temp-browse-handle
     2599               where buf_temp-browse-handle.browse-type = 'width':u
     2600             on error undo, next
     2601             :
     2602               assign
     2603                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2604               .
     2605             end.
     2606             assign
     2607               v-diasize-browse-handle :width = v-browse-width
     2608             .
     2609             for each buf_temp-diasize-handle
     2610             on error undo, next
     2611             :
     2612               assign
     2613                 v-object-handle = buf_temp-diasize-handle.handle-value
     2614               .
     2615               if v-object-handle <> v-diasize-resize-button
     2616               then do:
     2617                 assign
     2618                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2619                 .
     2620               end.
     2621             end.
     2622             run diasize_position-resize-button in this-procedure .
     2623           end.
     2624           assign
     2625             v-diasize-change-size = false
     2626           .
     2627           leave move_block .
     2628         end.
     2629       end.
     2630       assign
     2631         v-diasize-need-full-display = true
     2632       .
     2633       if v-diasize-change-size = false
     2634       then do:
     2635         assign
     2636           v-diasize-change-size = true
     2637         .
     2638       end.
     2639       else do:
     2640         return .
     2641       end.
     2642       assign
     2643         v-frame-width = frame Dialog-Frame :width
     2644         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2645         v-browse-width = v-diasize-browse-handle :width
     2646       .
     2647       for each buf_temp-browse-handle
     2648         where buf_temp-browse-handle.browse-type = 'width':u
     2649       :
     2650         assign
     2651           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2652         .
     2653       end.
     2654       for each buf_temp-diasize-handle
     2655       :
     2656         delete buf_temp-diasize-handle .
     2657       end.
     2658       assign
     2659         v-field-group-handle = frame Dialog-Frame :first-child
     2660       .
     2661       do while valid-handle(v-field-group-handle)
     2662       :
     2663         assign
     2664           v-object-handle = v-field-group-handle :first-child
     2665         .
     2666         do while valid-handle(v-object-handle)
     2667         :
     2668           if  v-object-handle <> v-diasize-browse-handle :handle
     2669           and v-object-handle <> v-diasize-resize-button
     2670           and can-query(v-object-handle, "row")
     2671           and can-query(v-object-handle, "height")
     2672           and ( v-object-handle :col + v-object-handle :width
     2673                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2674               )
     2675           then do:
     2676             find first buf_temp-browse-handle
     2677               where buf_temp-browse-handle.browse-type   = 'width':u
     2678                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2679               no-error .
     2680             if available buf_temp-browse-handle
     2681             then do:
     2682             end.
     2683             else do:
     2684               create buf_temp-diasize-handle .
     2685               assign
     2686                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2687                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2688               .
     2689             end.
     2690           end.
     2691           assign
     2692             v-object-handle = v-object-handle :next-sibling
     2693           .
     2694         end.
     2695         assign
     2696           v-field-group-handle = v-field-group-handle :next-sibling
     2697         .
     2698       end.
     2699       do with frame Dialog-Frame
     2700       :
     2701         hide v-diasize-resize-button .
     2702         v-diasize-resize-button :row = 1.
     2703         v-diasize-resize-button :column = 1.
     2704       end.
     2705       if p-change-value > 0
     2706       then do:
     2707         if frame Dialog-Frame :scrollable = true
     2708         then do:
     2709           assign
     2710             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2711             no-error .
     2712           if error-status :error
     2713           or error-status :get-message(1) <> ""
     2714           then do:
     2715             undo move_block, retry move_block.
     2716           end.
     2717         end.
     2718         assign
     2719           frame Dialog-Frame :width = v-frame-width + p-change-value
     2720           no-error .
     2721         if error-status :error
     2722         or error-status :get-message(1) <> ""
     2723         then do:
     2724           undo move_block, retry move_block.
     2725         end.
     2726         assign
     2727           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2728         no-error .
     2729         if error-status :error
     2730         or error-status :get-message(1) <> ""
     2731         then do:
     2732           undo move_block, retry move_block.
     2733         end.
     2734         for each buf_temp-browse-handle
     2735           where buf_temp-browse-handle.browse-type = 'width':u
     2736         on error undo move_block, retry move_block
     2737         :
     2738           assign
     2739             buf_temp-browse-handle.browse-handle :width
     2740               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2741             no-error .
     2742           if error-status :error
     2743           or error-status :get-message(1) <> ""
     2744           then do:
     2745             undo move_block, retry move_block .
     2746           end.
     2747         end.
     2748         for each buf_temp-diasize-handle
     2749         on error undo move_block, retry move_block
     2750         :
     2751           assign
     2752             v-object-handle = buf_temp-diasize-handle.handle-value
     2753           .
     2754           if v-object-handle <> v-diasize-resize-button
     2755           then do:
     2756             assign
     2757               v-object-handle :col = v-object-handle :col + p-change-value
     2758               no-error .
     2759             if error-status :error
     2760             or error-status :get-message(1) <> ""
     2761             then do:
     2762               undo move_block, retry move_block .
     2763             end.
     2764           end.
     2765         end.
     2766       end.
     2767       else do:
     2768         for each buf_temp-diasize-handle
     2769         on error undo move_block, retry move_block
     2770         :
     2771           assign
     2772             v-object-handle = buf_temp-diasize-handle.handle-value
     2773           .
     2774           if v-object-handle <> v-diasize-resize-button
     2775           then do:
     2776             assign
     2777               v-object-handle :col = v-object-handle :col + p-change-value
     2778               no-error .
     2779             if error-status :error
     2780             or error-status :get-message(1) <> ""
     2781             then do:
     2782               undo move_block, retry move_block .
     2783             end.
     2784           end.
     2785         end.
     2786         for each buf_temp-browse-handle
     2787           where buf_temp-browse-handle.browse-type = 'width':u
     2788         on error undo move_block, retry move_block
     2789         :
     2790           assign
     2791             buf_temp-browse-handle.browse-handle :width
     2792               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2793             no-error .
     2794           if error-status :error
     2795           or error-status :get-message(1) <> ""
     2796           then do:
     2797             undo move_block, retry move_block .
     2798           end.
     2799         end.
     2800         assign
     2801           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2802           no-error .
     2803         if error-status :error
     2804         or error-status :get-message(1) <> ""
     2805         then do:
     2806           undo move_block, retry move_block.
     2807         end.
     2808         assign
     2809           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2810         no-error .
     2811         if error-status :error
     2812         or error-status :get-message(1) <> ""
     2813         then do:
     2814           undo move_block, retry move_block.
     2815         end.
     2816         if frame Dialog-Frame :scrollable = true
     2817         then do:
     2818           assign
     2819             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2820           no-error .
     2821           if error-status :error
     2822           or error-status :get-message(1) <> ""
     2823           then do:
     2824             undo move_block, retry move_block.
     2825           end.
     2826         end.
     2827       end.
     2828       if p-move-resize
     2829       then do:
     2830         run diasize_position-resize-button in this-procedure .
     2831       end.
     2832       if v-diasize-wndstore = true
     2833       then do:
     2834         if connected("ub") = true
     2835         then do:
     2836           define variable v-cntxt-db-num        as integer   no-undo .
     2837           define variable v-cntxt-userid        as character no-undo .
     2838           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2839                                             , OUTPUT v-cntxt-userid
     2840                                             ) .
     2841           run gbl/wndsizew.p
     2842             (input  v-cntxt-db-num
     2843             ,input  v-cntxt-userid
     2844             ,input  v-diasize-proc-name
     2845             ,input  'width':u
     2846             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2847             ) .
     2848         end.
     2849       end.
     2850     end.
     2851     assign
     2852       v-diasize-change-size = false
     2853     .
     2854   end procedure.
     2855   procedure diasize_set-width :
     2856     define input  parameter p-new-width  as decimal   no-undo .
     2857     define input  parameter p-move-resize as logical   no-undo .
     2858     do
     2859     on error undo, return error return-value
     2860     :
     2861       run diasize_change-width in this-procedure
     2862         (input  (p-new-width - frame Dialog-Frame :width)
     2863         ,input  p-move-resize
     2864         ) .
     2865     end.
     2866   end procedure.
     2867   procedure diasize_position-resize-button :
     2868     do with frame Dialog-Frame
     2869     :
     2870       hide v-diasize-resize-button .
     2871       assign
     2872         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2873                     - 1
     2874                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2875         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2876                     - 1
     2877                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2878       .
     2879       view v-diasize-resize-button .
     2880     end.
     2881   end procedure.
     2882   on alt-right anywhere
     2883   do:
     2884     run diasize_change-width in this-procedure
     2885       (input 1
     2886       ,input true
     2887       ) .
     2888     return no-apply .
     2889   end.
     2890   on alt-left anywhere
     2891   do:
     2892     run diasize_change-width in this-procedure
     2893       (input -1
     2894       ,input true
     2895       ) .
     2896     return no-apply .
     2897   end.
     2898   on alt-down anywhere
     2899   do:
     2900     run diasize_change-height in this-procedure
     2901       (input 1
     2902       ,input true
     2903       ) .
     2904     return no-apply .
     2905   end.
     2906   on alt-up anywhere
     2907   do:
     2908     run diasize_change-height in this-procedure
     2909       (input -1
     2910       ,input true
     2911       ) .
     2912     return no-apply .
     2913   end.
     2914   on alt-enter of frame Dialog-Frame
     2915   do:
     2916     run diasize_maximize in this-procedure
     2917       (input  ?
     2918       ).
     2919     return no-apply .
     2920   end.
     2921   procedure diasize_end-move :
     2922     do
     2923     on error undo, return error return-value
     2924     :
     2925       define variable v-row-delta as decimal   no-undo .
     2926       define variable v-col-delta as decimal   no-undo .
     2927       define variable v-new-row as decimal   no-undo .
     2928       define variable v-new-col as decimal   no-undo .
     2929       assign
     2930         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2931         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2932       .
     2933       assign
     2934         v-row-delta = v-new-row - frame Dialog-Frame :height
     2935         v-col-delta = v-new-col - frame Dialog-Frame :width
     2936       .
     2937       run diasize_change-height in this-procedure
     2938         (input v-row-delta
     2939         ,input true
     2940         ) .
     2941       run diasize_change-width in this-procedure
     2942         (input v-col-delta
     2943         ,input true
     2944         ) .
     2945     end.
     2946   end procedure.
     2947   procedure diasize_maximize :
     2948     define input  parameter p-action as logical   no-undo .
     2949     do
     2950     on error undo, return error return-value
     2951     :
     2952       if p-action = ?
     2953       then do:
     2954         if v-diasize-need-maximize = true
     2955         then do:
     2956           assign
     2957             p-action = true
     2958           .
     2959         end.
     2960         else do:
     2961           assign
     2962             p-action = false
     2963           .
     2964         end.
     2965       end.
     2966       if p-action = true
     2967       then do:
     2968         run diasize_change-height in this-procedure
     2969           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2970               - frame Dialog-Frame :height-chars
     2971           ,input true
     2972           ) .
     2973         run diasize_change-width in this-procedure
     2974           (input session :width-chars
     2975               - frame Dialog-Frame :width-chars
     2976           ,input true
     2977           ) .
     2978         assign
     2979           v-diasize-need-maximize = false
     2980         .
     2981       end.
     2982       else do:
     2983         run diasize_change-width in this-procedure
     2984           (input v-diasize-orig-frame-width
     2985               - frame Dialog-Frame :width-chars
     2986           ,input true
     2987           ) .
     2988         run diasize_change-height in this-procedure
     2989           (input v-diasize-orig-frame-height
     2990               - frame Dialog-Frame :height-chars
     2991           ,input true
     2992           ) .
     2993         assign
     2994           v-diasize-need-maximize = true
     2995         .
     2996       end.
     2997     end.
     2998   end procedure.
     2999   procedure diasize_restore-orig-size :
     3000     do
     3001     on error undo, return error return-value
     3002     :
     3003       assign
     3004         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3005         v-diasize-current-frame-height = frame Dialog-Frame :height
     3006       .
     3007       run diasize_set-height in this-procedure
     3008         (input  v-diasize-orig-frame-height
     3009         ,input  true
     3010         ) .
     3011       run diasize_set-width in this-procedure
     3012         (input  v-diasize-orig-frame-width
     3013         ,input  true
     3014         ) .
     3015     end.
     3016   end procedure.
     3017   procedure diasize_restore-current-size :
     3018     do
     3019     on error undo, return error return-value
     3020     :
     3021       run diasize_set-height in this-procedure
     3022         (input  v-diasize-current-frame-height
     3023         ,input  true
     3024         ) .
     3025       run diasize_set-width in this-procedure
     3026         (input  v-diasize-current-frame-width
     3027         ,input  true
     3028         ) .
     3029     end.
     3030   end procedure.
     3031   procedure diasize_set-browse-handle :
     3032     define input  parameter p-browse-handle as handle   no-undo .
     3033     define buffer buf_temp-browse-handle for temp-browse-handle .
     3034     do
     3035     on error undo, return error return-value
     3036     :
     3037       assign
     3038         v-diasize-browse-handle = p-browse-handle
     3039       .
     3040       for each buf_temp-browse-handle
     3041       on error undo, return error return-value
     3042       :
     3043         delete buf_temp-browse-handle .
     3044       end.
     3045     end.
     3046   end procedure.
     3047   procedure diasize_add_browse :
     3048     define input  parameter p-browse-type   as character no-undo .
     3049     define input  parameter p-browse-handle as handle    no-undo .
     3050     define buffer buf_temp-browse-handle for temp-browse-handle .
     3051     do
     3052     on error undo, return error return-value
     3053     :
     3054       assign
     3055         v-diasize-browse-number = v-diasize-browse-number + 1
     3056       .
     3057       create buf_temp-browse-handle .
     3058       assign
     3059         buf_temp-browse-handle.browse-type   = p-browse-type
     3060         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3061         buf_temp-browse-handle.browse-handle = p-browse-handle
     3062       .
     3063     end.
     3064   end procedure.
     3065   procedure diasize_init :
     3066     define variable v-default-value    as logical   no-undo .
     3067     define variable v-restore-saved    as logical   no-undo .
     3068     define variable v-resize-value-str as character no-undo .
     3069     do
     3070     on error undo, return error return-value
     3071     :
     3072       do with frame Dialog-Frame
     3073       :
     3074         assign
     3075           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3076           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3077           v-diasize-browse-handle     = browse br-thbj-attr :handle
     3078         .
     3079         create button v-diasize-resize-button
     3080         assign
     3081           parent        = frame Dialog-Frame :first-child
     3082           label         = "s"
     3083           height-pixels = 16
     3084           width-pixels  = 16
     3085           visible       = true
     3086           sensitive     = true
     3087           movable       = true
     3088           triggers:
     3089             on end-move persistent run diasize_end-move in this-procedure .
     3090           end triggers.
     3091         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3092         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3093         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3094         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3095         assign
     3096           v-diasize-wndmax = false
     3097         .
     3098         if connected("ub") = true
     3099         then do:
     3100           define variable v-cntxt-db-num        as integer   no-undo .
     3101           define variable v-cntxt-userid        as character no-undo .
     3102           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3103                                             , OUTPUT v-cntxt-userid
     3104                                             ) .
     3105           run gbl/wndpar_r.p
     3106             (input  v-cntxt-db-num
     3107             ,input  v-cntxt-userid
     3108             ,input  'wndmax':U
     3109             ,output v-diasize-wndmax
     3110             ,output v-default-value
     3111             ) .
     3112         end.
     3113         assign
     3114           v-diasize-wndstore = false
     3115         .
     3116         if connected("ub") = true
     3117         then do:
     3118           run gbl/wndpar_r.p
     3119             (input  v-cntxt-db-num
     3120             ,input  v-cntxt-userid
     3121             ,input  'wndstore':U
     3122             ,output v-diasize-wndstore
     3123             ,output v-default-value
     3124             ) .
     3125         end.
     3126         assign
     3127           v-diasize-proc-name = entry(1, program-name(2), '.')
     3128         .
     3129         if v-diasize-wndstore = true
     3130         then do:
     3131           assign
     3132             v-restore-saved = false
     3133           .
     3134           if connected("ub") = true
     3135           then do:
     3136             run gbl/wndsizer.p
     3137               (input  v-cntxt-db-num
     3138               ,input  v-cntxt-userid
     3139               ,input  v-diasize-proc-name
     3140               ,input  'height':u
     3141               ,output v-resize-value-str
     3142               ) .
     3143             if v-resize-value-str <> '':U
     3144             then do:
     3145               run diasize_change-height in this-procedure
     3146                 (input  integer(v-resize-value-str)
     3147                 ,input  true
     3148                 ) .
     3149               assign
     3150                 v-restore-saved = true
     3151               .
     3152             end.
     3153           end.
     3154           if connected("ub") = true
     3155           then do:
     3156             run gbl/wndsizer.p
     3157               (input  v-cntxt-db-num
     3158               ,input  v-cntxt-userid
     3159               ,input  v-diasize-proc-name
     3160               ,input  'width':u
     3161               ,output v-resize-value-str
     3162               ) .
     3163             if v-resize-value-str <> '':U
     3164             then do:
     3165               run diasize_change-width in this-procedure
     3166                 (input  integer(v-resize-value-str)
     3167                 ,input  true
     3168                 ) .
     3169               assign
     3170                 v-restore-saved = true
     3171               .
     3172             end.
     3173           end.
     3174           if v-restore-saved <> true
     3175           then do:
     3176             if v-diasize-wndmax = true
     3177             then do:
     3178               run diasize_maximize in this-procedure
     3179                 (input  true
     3180                 ) .
     3181             end.
     3182           end.
     3183         end.
     3184         else do:
     3185           if v-diasize-wndmax = true
     3186           then do:
     3187             run diasize_maximize in this-procedure
     3188               (input  true
     3189               ) .
     3190           end.
     3191         end.
     3192       end.
     3193     end.
     3194   end procedure.
     3195   procedure diasize_need-full-display :
     3196     define output parameter p-need-full-display as logical   no-undo .
     3197     do
     3198     on error undo, return error return-value
     3199     :
     3200       assign
     3201         p-need-full-display = v-diasize-need-full-display
     3202       .
     3203       assign
