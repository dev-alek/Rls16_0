     3208   procedure get-context :
     3209      define output parameter p-db-num as integer          no-undo.
     3210      define output parameter p-user-id as character        no-undo.
     3211      define variable v-login               as character    no-undo.
     3212      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3213      define buffer buf_user-login  for ub.user-login .
     3214      do
     3215      on error undo, return error
     3216      :
     3217            FIND FIRST buf_sys-ctrl no-lock.
     3218            ASSIGN
     3219               v-login = USERID("ub")
     3220               p-db-num = buf_sys-ctrl.db-num
     3221            .
     3222            FIND FIRST buf_user-login
     3223                 WHERE buf_user-login.db-num = p-db-num
     3224                   AND buf_user-login.user-login = v-login
     3225                 no-lock
     3226                 no-error
     3227                 .
     3228            IF AVAILABLE buf_user-login
     3229            THEN DO:
     3230               assign
     3231                  p-user-id = buf_user-login.user-id
     3232               .
     3233            END.
     3234      end.
     3235   end procedure.
