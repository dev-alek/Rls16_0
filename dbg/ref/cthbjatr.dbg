     4074     assign
     4075       l-filter-open-31 = false
     4076     .
     4077     if flt-rec-31 <> ?
     4078       or sort-column-phrase > ""
     4079     then do:
     4080       define variable  parameter-2-31 as character no-undo .
     4081       define variable  parameter-3-31 as character no-undo .
     4082       define variable  parameter-4-31 as character no-undo .
     4083       define variable  parameter-5-31 as character no-undo .
     4084       define variable  parameter-6-31 as character no-undo .
     4085       define variable  parameter-7-31 as character no-undo .
     4086         assign
     4087         parameter-3-31 =
     4088                                 "FOR EACH X_c-thbj-attr"
     4089         parameter-4-31 =
     4090           (
     4091             if ("           X_c-thbj-attr.obj-type  = p-obj-type AND            X_c-thbj-attr.obj-code  = p-obj-code AND            X_c-thbj-attr.upper-prop-code  = p-upper-prop-code AND            X_c-thbj-attr.prop-code  = p-prop-code  " + " " + where-phrase-31) <> ""
     4092             then  substitute(' X_c-thbj-attr.obj-type  = &1&2&1 AND            X_c-thbj-attr.obj-code  = &3 AND X_c-thbj-attr.upper-prop-code  = &1&4&1 AND           X_c-thbj-attr.prop-code  = &1&5&1 ', chr(34), p-obj-type, p-obj-code, p-upper-prop-code, p-prop-code)   + " " + where-phrase-31
     4093             else "true"
     4094           )
     4095         parameter-5-31 = (" " + "" + " " + "")
     4096         parameter-6-31 = if sort-phrase-31 = ''
     4097                              then
     4098           (
     4099           " " + "  " +
     4100             " " + sort-column-phrase +
     4101           " " + "  "
     4102           )
     4103                              else
     4104           (
     4105           " " + "  " +
     4106             " " + sort-column-phrase +
     4107           " " + sort-phrase-31
     4108           )
     4109         parameter-7-31 =
     4110           " indexed-reposition  "
     4111       .
     4112       do
     4113       on stop undo, leave
     4114       on error undo, leave
     4115       :
     4116         assign
     4117           l-disable-where-31 =
     4118             ("           X_c-thbj-attr.obj-type  = p-obj-type AND            X_c-thbj-attr.obj-code  = p-obj-code AND            X_c-thbj-attr.upper-prop-code  = p-upper-prop-code AND            X_c-thbj-attr.prop-code  = p-prop-code  " + " " + where-phrase-31 = "")
     4119         .
     4120         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4121                             ,input query br-thbj-attr:handle
     4122                             ,input parameter-3-31
     4123                             ,input parameter-4-31
     4124                             ,input parameter-5-31
     4125                             ,input parameter-6-31
     4126                             ,input parameter-7-31
     4127                             )
