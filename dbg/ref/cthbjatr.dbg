     1091      define output parameter p-host           as logical no-undo .
     1092      define output parameter p-shop           as logical no-undo .
     1093      define output parameter p-store          as logical no-undo .
     1094      define output parameter p-db             as logical no-undo .
     1095      define variable p-region as logical no-undo.
     1096      run thbjattr_code_reg in this-procedure (
     1097                                               p-upper-code,
     1098                                               p-code,
     1099                                               output p-label,
     1100                                               output p-user-can-edit,
     1101                                               output p-output-display,
     1102                                               output p-other,
     1103                                               output p-prop-list,
     1104                                               output p-prop-type-list,
     1105                                               output p-prop-label-list,
     1106                                               output p-global,
     1107                                               output p-host,
     1108                                               output p-shop,
     1109                                               output p-store,
     1110                                               output p-db,
     1111                                               output p-region
     1112                                               ).
     1113   end procedure.
