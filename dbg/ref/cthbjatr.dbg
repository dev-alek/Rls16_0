     4132       end.
     4133       if l-filter-open-31 = false then do:
     4134         message
     4135           "Ошибка при фильтрации / сортировке" skip
     4136           "Будут показаны записи без учета фильтра" skip
     4137           view-as alert-box .
     4138       end.
     4139       else do:
     4140           assign
     4141             l-query-was-opened = true
     4142           .
     4143       end.
     4144     end.
     4145     if l-filter-open-31 = false then do:
     4146       OPEN QUERY br-thbj-attr FOR EACH X_c-thbj-attr
     4147         where            X_c-thbj-attr.obj-type  = p-obj-type AND            X_c-thbj-attr.obj-code  = p-obj-code AND            X_c-thbj-attr.upper-prop-code  = p-upper-prop-code AND            X_c-thbj-attr.prop-code  = p-prop-code
     4148         indexed-reposition
     4149     .
     4150         assign
