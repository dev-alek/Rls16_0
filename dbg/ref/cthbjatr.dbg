     4168         parameter-5-31 = "  "
     4169       .
     4170         run fltopend_fltfindd in this-procedure  (
     4171                             input this-procedure:handle
     4172                             ,input query br-thbj-attr:handle
     4173                             ,input rowid(X_c-thbj-attr)
     4174                             ,input logical(parameter-2-31)
     4175                             ,input no-lock
