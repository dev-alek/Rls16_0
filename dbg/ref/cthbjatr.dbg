     1080   procedure thbjattr_code :
     1081      define input  parameter p-upper-code     as character no-undo .
     1082      define input  parameter p-code           as character no-undo .
     1083      define output parameter p-label          as character no-undo .
     1084      define output parameter p-user-can-edit  as logical   no-undo .
     1085      define output parameter p-output-display as logical   no-undo .
