        1   define temp-table procAsunc no-undo
        2       field procid            as character
        3       field procval           as character
        4       field procname          as character
        5       field proctyperun       as character
        6       index pi is primary unique
        7           procid
        8   .
        9   define temp-table procParam no-undo
       10       field procid                as character
       11       field paramName             as character
       12       field numparam              as integer
       13       field ParamValue            as character
       14       field ParamType             as character
       15       field ParamHiden            as logical
       16       index pi is primary unique
       17           procid numparam
       18   .
       19   define temp-table SesParam no-undo
       20       field parCheck          as logical
       21       field parCode           as character
       22       field parname           as character
       23       field parvalue          as character
       24       field parWaitFile       as character
       25       index pi is primary unique
       26           parCode
