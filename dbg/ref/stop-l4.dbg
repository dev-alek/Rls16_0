        1   block-level on error undo, throw.
        2   define input parameter p-silent as logical no-undo .
        3   define input parameter p-src-stop-list-code as character no-undo .
        4   define output parameter p-trg-stop-list-code as character no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: stop-l4.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: ref/stop-l4.p $":U .
       10   define variable vss-description as character no-undo init "Копирование стоплиста ДК".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   procedure gen-key-rec :
       82     define input  parameter p-tbl-name    as character no-undo.
       83     define input  parameter p-bh_tbl-name as handle    no-undo.
       84     define output parameter p-key-rec     as character no-undo.
       85     do
       86     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
       87     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
       88     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
       89     :
       90       define variable fh               as handle    no-undo .
       91       define variable v-ok             as logical   no-undo .
       92       define variable v-inform         as character no-undo .
       93       define variable v-ind            as integer   no-undo .
       94       define variable v-idx-field-qnty as integer   no-undo .
       95       if p-tbl-name = ?
       96         or p-tbl-name = "":U
       97       then do:
       98         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info0 ).
       99       end.
      100       if not p-bh_tbl-name:available then do:
      101         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info0, p-tbl-name ).
      102       end.
      103       assign
      104         p-key-rec = p-tbl-name
      105         v-inform  = p-bh_tbl-name:index-information(1)
      106         v-ind     = 2
      107       .
      108       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      109       on error undo, return error
      110       :
      111         assign
      112           v-inform = p-bh_tbl-name:index-information( v-ind )
      113           v-ind    = v-ind + 1
      114         .
      115       end.
      116       if v-inform = ?
      117         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      118         or entry( 3, v-inform, ",":U ) <> "1":U
      119       then do:
      120         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, p-tbl-name ).
      121       end.
      122       else do:
      123         assign
      124           v-idx-field-qnty = num-entries( v-inform ) - 4
      125         .
      126         if v-idx-field-qnty < 2 then do:
      127           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, p-tbl-name ).
      128         end.
      129         do v-ind = 1 to v-idx-field-qnty by 2
      130         on error undo, return error
      131         :
      132           assign
      133             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      134             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      135           .
      136         end.
      137       end.
      138       if p-key-rec = ? then do:
      139         assign
      140           p-key-rec = "":U
      141         .
      142         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info0, p-tbl-name ).
      143       end.
      144     end.
      145     return.
      146   end procedure.
      147   procedure gen-where-keyr-tab :
      148     define input  parameter i-tableSerach as character no-undo.
      149     define input  parameter i-tablekey   as character  no-undo.
      150     define input  parameter p-key-rec    as character  no-undo.
      151     define input  parameter p-key-handle as handle     no-undo .
      152     define input  parameter p-db-name    as character  no-undo .
      153     define input  parameter p-tt-handle  as handle     no-undo .
      154     define output parameter o-Where      as character  no-undo.
      155     do
      156     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      157     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      158     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      159     :
      160       define variable v-full-tbl-name  as character no-undo .
      161       define variable bh_tbl-name      as handle    no-undo .
      162       define variable fh_key           as handle    no-undo .
      163       define variable fh_search        as handle    no-undo .
      164       define variable v-field-num      as integer   no-undo .
      165       define variable v-count-fld      as integer   no-undo .
      166       define variable v-inform         as character no-undo .
      167       define variable v-ind            as integer   no-undo .
      168       define variable v-idx-field-qnty as integer   no-undo .
      169       define variable v-field-name     as character no-undo .
      170       define variable v-field-val      as character no-undo .
      171       define variable v-word-link      as character no-undo .
      172       define variable vTable           as character no-undo.
      173       define variable bh_tbl-key       as handle    no-undo .
      174       assign
      175         p-key-rec = trim( p-key-rec )
      176       .
      177       if p-key-handle <> ? then do:
      178         if not valid-handle(p-key-handle)
      179            or p-key-handle:type <> "buffer"
      180         then do:
      181           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info0 ).
      182         end.
      183         if num-entries( p-key-rec, chr(3) ) > 1
      184           or p-key-rec = ?
      185           or p-key-rec = "":U
      186         then do:
      187           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info0, p-key-rec ).
      188         end.
      189       end.
      190       else do:
      191         if p-key-rec = ?
      192           or p-key-rec = "":U
      193         then do:
      194           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      195         end.
      196       end.
      197       assign
      198         vTable = entry( 1 , p-key-rec, chr(3) )
      199       .
      200       if p-tt-handle <> ?
      201         and ( not valid-handle(p-tt-handle)
      202               or p-tt-handle:type <> "buffer"
      203             )
      204       then do:
      205         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info0, vTable, chr(10) ).
      206       end.
      207       if p-tt-handle = ? then do:
      208         assign
      209           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      210         .
      211         create buffer bh_tbl-name for table v-full-tbl-name .
      212       end.
      213       else do:
      214         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      215       end.
      216       assign
      217         v-inform = bh_tbl-name:index-information(1)
      218         v-ind    = 2
      219       .
      220       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      221       on error undo, return error
      222       :
      223         assign
      224           v-inform = bh_tbl-name:index-information( v-ind )
      225           v-ind    = v-ind + 1
      226         .
      227       end.
      228       if v-inform = ?
      229         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      230         or entry( 3, v-inform, ",":U ) <> "1":U
      231       then do:
      232         delete object bh_tbl-name no-error.
      233         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info0, vTable ).
      234       end.
      235       assign
      236         v-idx-field-qnty = num-entries( v-inform ) - 4
      237       .
      238       if v-idx-field-qnty < 2 then do:
      239         delete object bh_tbl-name no-error.
      240         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, vTable ).
      241       end.
      242       assign
      243         o-where     = "where":U
      244         v-word-link = "":U
      245         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      246         v-count-fld = 0
      247       .
      248       if i-tablekey ne "" and i-tablekey ne ?
      249       then do:
      250         assign
      251           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      252         .
      253         create buffer bh_tbl-key for table v-full-tbl-name .
      254       end.
      255       if i-tableSerach ne "" and i-tableSerach ne ?
      256       then do:
      257         delete object bh_tbl-name no-error.
      258         assign
      259           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      260         .
      261         create buffer bh_tbl-name for table v-full-tbl-name .
      262       end.
      263       block_where:
      264       do v-ind = 1 to v-idx-field-qnty by 2
      265       on error undo, return error
      266       :
      267         assign
      268           v-count-fld = v-count-fld + 1
      269         .
      270         if p-key-handle = ?
      271           and v-count-fld > v-field-num
      272         then do:
      273           leave block_where.
      274         end.
      275         define variable VfieldKeyTable as handle no-undo.
      276         assign
      277           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      278           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      279         .
      280         if     bh_tbl-key ne ?
      281         then do:
      282            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      283            if VfieldKeyTable eq ?
      284            then next block_where.
      285         end.
      286         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      287         then
      288            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      289         else
      290            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      291         if p-key-handle = ? then do:
      292           assign
      293             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      294           .
      295         end.
      296         else do:
      297           assign
      298             fh_key = p-key-handle:buffer-field( v-field-name )
      299           .
      300           if fh_key = ?
      301             or not valid-handle( fh_key )
      302           then do:
      303             delete object bh_tbl-name.
      304             if     bh_tbl-key ne ?
      305             then
      306                delete object bh_tbl-key.
      307             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info0, p-key-handle:name, v-field-name ).
      308           end.
      309           assign
      310             v-field-val = fh_key:buffer-value
      311           .
      312         end.
      313         if fh_search:data-type ="character":U then do:
      314           assign
      315             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      316             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      317             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      318             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      319             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      320             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      321             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      322             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      323             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      324             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      325             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      326             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      327             v-field-val = substitute( '"&1"', v-field-val )
      328           .
      329         end.
      330         assign
      331           o-where = substitute( "&1 &2", o-where, v-field-val )
      332         .
      333         if v-word-link = "":U then do:
      334           assign
      335             v-word-link = "and":U
      336           .
      337         end.
      338       end.
      339       delete object bh_tbl-name.
      340       if     bh_tbl-key ne ?
      341       then
      342          delete object bh_tbl-key.
      343       if p-key-handle = ?
      344         and v-count-fld <> v-field-num
      345       then do:
      346         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info0, vTable ).
      347       end.
      348     end.
      349   end procedure.
      350   procedure gen-hn-keyr-tab :
      351     define input  parameter i-tableSerach as character no-undo.
      352     define input  parameter i-tablekey   as character no-undo.
      353     define input  parameter p-key-rec    as character no-undo.
      354     define input  parameter p-key-handle as handle    no-undo .
      355     define input  parameter p-db-name    as character no-undo .
      356     define input  parameter p-tt-handle  as handle    no-undo .
      357     define input  parameter p-stts-lock  as integer   no-undo .
      358     define output parameter o-hn         as handle    no-undo.
      359     define variable v-full-tbl-name as character no-undo.
      360     define variable v-where         as character no-undo.
      361     define variable bh_tbl-name     as handle    no-undo.
      362     define variable vTable          as character no-undo.
      363     do
      364     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      365     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      366     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      367         run gen-where-keyr-tab(i-tableSerach,
      368                                i-tablekey,
      369                                p-key-rec,
      370                                p-key-handle,
      371                                p-db-name,
      372                                p-tt-handle,
      373                                output v-where).
      374         if i-tableSerach ne "" and i-tableSerach ne ?
      375         then do:
      376            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      377            create buffer bh_tbl-name for table v-full-tbl-name .
      378         end.
      379         else do:
      380            if p-tt-handle = ? then do:
      381               assign
      382                  vTable = entry( 1 , p-key-rec, chr(3) )
      383               .
      384               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      385               create buffer bh_tbl-name for table v-full-tbl-name .
      386            end.
      387            else do:
      388               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      389            end.
      390         end.
      391         if p-tt-handle = ? then do:
      392            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      393         end.
      394         else do:
      395            bh_tbl-name:find-first( v-where ) no-error .
      396         end.
      397         o-hn = bh_tbl-name.
      398      end.
      399   end procedure.
      400   procedure gen-hn-keyr :
      401     define input  parameter p-key-rec    as character no-undo.
      402     define input  parameter p-key-handle as handle    no-undo .
      403     define input  parameter p-db-name    as character no-undo .
      404     define input  parameter p-tt-handle  as handle    no-undo .
      405     define input  parameter p-stts-lock  as integer   no-undo .
      406     define output parameter o-hn         as handle    no-undo.
      407     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      408   end.
      409   procedure gen-row-keyr :
      410     define input  parameter p-key-rec    as character no-undo.
      411     define input  parameter p-key-handle as handle    no-undo .
      412     define input  parameter p-db-name    as character no-undo .
      413     define input  parameter p-tt-handle  as handle    no-undo .
      414     define input  parameter p-stts-lock  as integer   no-undo .
      415     define output parameter p-tbl-row    as rowid     no-undo.
      416     define output parameter p-tbl-name   as character no-undo.
      417     define variable vHn as handle no-undo.
      418       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      419       p-tbl-row = if vHn:available then vHn:rowid else ?.
      420       p-tbl-name =  vHn:table.
      421       delete object vHn no-error.
      422     if p-tbl-row = ? then do:
      423       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info0, p-tbl-name, p-key-rec ).
      424     end.
      425     else do:
      426       return.
      427     end.
      428   end procedure.
      429   procedure gen-key-fv :
      430     define input  parameter p-key-rec    as character no-undo .
      431     define output parameter p-field-list as character no-undo .
      432     define output parameter p-value-list as character no-undo.
      433     do
      434     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      435     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      436     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      437     :
      438       define variable v-full-tbl-name  as character no-undo .
      439       define variable bh_tbl-name      as handle    no-undo .
      440       define variable v-tbl-name       as character no-undo .
      441       define variable v-field-num      as integer   no-undo .
      442       define variable v-count-fld      as integer   no-undo .
      443       define variable v-inform         as character no-undo .
      444       define variable v-ind            as integer   no-undo .
      445       define variable v-idx-field-qnty as integer   no-undo .
      446       define variable v-delim-key      as character no-undo .
      447       if p-key-rec = ?
      448         or p-key-rec = "":U
      449       then do:
      450         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info0 ).
      451       end.
      452       assign
      453         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      454         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      455       .
      456       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      457       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info0 ).
      458       assign
      459         v-inform = bh_tbl-name:index-information(1)
      460         v-ind    = 2
      461       .
      462       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      463       on error undo, return error
      464       :
      465         assign
      466           v-inform = bh_tbl-name:index-information( v-ind )
      467           v-ind    = v-ind + 1
      468         .
      469       end.
      470       if v-inform = ?
      471         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      472         or entry( 3, v-inform, ",":U ) <> "1":U
      473       then do:
      474         delete object bh_tbl-name no-error.
      475         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      476       end.
      477       assign
      478         v-idx-field-qnty = num-entries( v-inform ) - 4
      479       .
      480       if v-idx-field-qnty < 2 then do:
      481         delete object bh_tbl-name no-error.
      482         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      483       end.
      484       assign
      485         p-field-list = "":U
      486         p-value-list = "":U
      487         v-delim-key  = "":U
      488         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      489         v-count-fld  = 0
      490       .
      491       block_where:
      492       do v-ind = 1 to v-idx-field-qnty by 2
      493       on error undo, return error
      494       :
      495         assign
      496           v-count-fld = v-count-fld + 1
      497         .
      498         if v-count-fld > v-field-num then do:
      499           leave block_where.
      500         end.
      501         assign
      502           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      503           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      504         .
      505         if v-ind = 1 then do:
      506           assign
      507             v-delim-key = chr(3)
      508           .
      509         end.
      510       end.
      511       delete object bh_tbl-name.
      512       if v-count-fld <> v-field-num then do:
      513         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info0, v-tbl-name ).
      514       end.
      515     end.
      516   end procedure.
      517   procedure gen-key-field :
      518     define input  parameter p-table      as character no-undo .
      519     define output parameter p-field-list as character no-undo .
      520     do
      521     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      522     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      523     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      524     :
      525       define variable v-full-tbl-name  as character no-undo .
      526       define variable bh_tbl-name      as handle    no-undo .
      527       define variable v-tbl-name       as character no-undo .
      528       define variable v-field-num      as integer   no-undo .
      529       define variable v-count-fld      as integer   no-undo .
      530       define variable v-inform         as character no-undo .
      531       define variable v-ind            as integer   no-undo .
      532       define variable v-idx-field-qnty as integer   no-undo .
      533       define variable v-delim-key      as character no-undo .
      534       if p-table = ?
      535         or p-table = "":U
      536       then do:
      537         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info0 ).
      538       end.
      539       assign
      540         v-tbl-name      = p-table
      541         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      542       .
      543       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      544       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info0 ).
      545       assign
      546         v-inform = bh_tbl-name:index-information(1)
      547         v-ind    = 2
      548       .
      549       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      550       on error undo, return error
      551       :
      552         assign
      553           v-inform = bh_tbl-name:index-information( v-ind )
      554           v-ind    = v-ind + 1
      555         .
      556       end.
      557       if v-inform = ?
      558         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      559         or entry( 3, v-inform, ",":U ) <> "1":U
      560       then do:
      561         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info0, v-tbl-name ).
      562       end.
      563       assign
      564         v-idx-field-qnty = num-entries( v-inform ) - 4
      565       .
      566       if v-idx-field-qnty < 2 then do:
      567         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info0, v-inform, v-tbl-name ).
      568       end.
      569       assign
      570         p-field-list = "":U
      571         v-delim-key  = "":U
      572         v-count-fld  = 0
      573       .
      574       block_where:
      575       do v-ind = 1 to v-idx-field-qnty by 2
      576       on error undo, return error
      577       :
      578         assign
      579           v-count-fld = v-count-fld + 1
      580         .
      581         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
      582         if v-ind = 1 then do:
      583           assign
      584             v-delim-key = chr(3)
      585           .
      586         end.
      587       end.
      588       delete object bh_tbl-name.
      589     end.
      590   end procedure.
      591   define variable v-mess as character no-undo .
      592   define variable v-recid as recid no-undo .
      593   define variable v-card-key-rec as character no-undo .
      594   define variable v-client-key-rec as character no-undo .
      595   define buffer src_stop-list for ub.stop-list.
      596   define buffer trg_stop-list for ub.stop-list.
      597   define buffer buf2_stop-list-line for ub.stop-list-line.
      598   define buffer buf3_stop-list-line for ub.stop-list-line.
      599   define buffer buf_dis-card for ub.dis-card.
      600   define buffer buf2_dis-card for ub.dis-card.
      601   define buffer buf_clients for ub.clients.
      602   main-block:
      603   do
      604   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      605   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      606   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      607   :
      608     find first src_stop-list share-lock where
      609               src_stop-list.stop-list-code = p-src-stop-list-code
      610           and src_stop-list.classif-type = 'dis-card':U no-error.
      611     if not available src_stop-list then do:
      612       assign
      613       v-mess = substitute("Не найден столист-источник").
      614       run err-mess in this-procedure ( input-output v-mess).
      615       undo main-block, return error (if p-silent = yes then v-mess else '':U).
      616     end.
      617     run ref/stop-l1.p ( input p-silent
      618                    ,output p-trg-stop-list-code) no-error.
      619     if error-status:error then do:
      620       assign
      621       v-mess = substitute("Ошибка при создании стоплиста-копии&1&2&1&3"
      622                           , chr(10)
      623                           , error-status:get-message(1)
      624                           , return-value ).
      625       run err-mess in this-procedure ( input-output v-mess).
      626       undo main-block, return error (if p-silent = yes then v-mess else '':U).
      627     end.
      628     find first trg_stop-list exclusive-lock where
      629                 trg_stop-list.classif-type = 'dis-card':U
      630             and trg_stop-list.stop-list-code = p-trg-stop-list-code no-error.
      631     if not available trg_stop-list then do:
      632       assign
      633       v-mess = substitute("Не найден созданный стоплист-копия&1&2&1&3"
      634                           , chr(10)
      635                           , error-status:get-message(1)
      636                           , return-value ).
      637       run err-mess in this-procedure ( input-output v-mess).
      638       undo main-block, return error (if p-silent = yes then v-mess else '':U).
      639     end.
      640     for each buf2_stop-list-line no-lock where
      641             buf2_stop-list-line.stop-list-code = src_stop-list.stop-list-code
      642         and buf2_stop-list-line.classif-type = 'dis-card':U
      643     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      644     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      645     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      646     :
      647       v-recid = ?.
      648       run ref/stop-ll1.p (
      649                         input 'ДОБАВЛЕНИЕ':U
      650                       ,input no
      651                       ,input-output v-recid
      652                       ,input p-trg-stop-list-code
      653                       ,input buf2_stop-list-line.charkey_one
      654                       ,input buf2_stop-list-line.key#_one
      655                       ) no-error.
      656       if error-status:error then do:
      657         assign
      658         v-mess = substitute("Ошибка при создании строки в стоплисте-копии&1&2&1&3"
      659                             , chr(10)
      660                             , error-status:get-message(1)
      661                             , return-value ).
      662         run err-mess in this-procedure ( input-output v-mess).
      663         undo main-block, return error (if p-silent = yes then v-mess else '':U).
      664       end.
      665     end.
      666     for each buf2_stop-list-line no-lock where
      667             buf2_stop-list-line.stop-list-code = trg_stop-list.stop-list-code
      668         and buf2_stop-list-line.classif-type = 'dis-card':U
      669     on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      670     on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      671     on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      672     :
      673       if buf2_stop-list-line.key#_one = integer('2':U)
      674       or buf2_stop-list-line.key#_one = integer('3':U) then do:
      675          find first buf_dis-card no-lock where
      676                   buf_dis-card.d-card = buf2_stop-list-line.charkey_one.
      677          for each buf2_dis-card no-lock where
      678                   buf2_dis-card.cli-type = buf_dis-card.cli-type
      679               and buf2_dis-card.cli-code = buf_dis-card.cli-code,
      680              first buf_clients no-lock where
      681                   buf_Clients.obj-type = buf_Dis-card.cli-type
      682               and buf_Clients.obj-code = buf_Dis-card.cli-code
      683           on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      684           on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      685           on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      686           :
      687            run gen-key-rec in this-procedure ( input 'dis-card':U
      688                                               ,input buffer buf2_dis-card:handle
      689                                               ,output v-card-key-rec).
      690            run gen-key-rec in this-procedure ( input 'clients':U
      691                                               ,input buffer buf_clients:handle
      692                                               ,output v-client-key-rec).
      693            find first buf3_stop-list-line no-lock where
      694                      buf3_stop-list-line.stop-list-code = buf2_stop-list-line.stop-list-code
      695                   and buf3_stop-list-line.classif-type = 'dis-card':U
      696                   and (buf3_stop-list-line.resource_id = v-card-key-rec
      697                        or
      698                        buf3_stop-list-line.resource_id = v-client-key-rec)
      699                   and buf3_stop-list-line.charkey_one = buf2_Dis-card.d-card
      700                   no-error.
      701            if not available buf3_stop-list-line then do:
      702               v-recid = ?.
      703               run ref/stop-ll1.p (
      704                                 input 'ДОБАВЛЕНИЕ':U
      705                               ,input no
      706                               ,input-output v-recid
      707                               ,input p-trg-stop-list-code
      708                               ,input buf2_dis-card.d-card
      709                               ,input integer('2':U))
      710                               ) no-error.
      711               if error-status:error then do:
      712                 assign
      713                 v-mess = substitute("Ошибка при дополнении стоплиста-копии новыми картами со статусом &4&1&2&1&3"
      714                                     , chr(10)
      715                                     , error-status:get-message(1)
      716                                     , return-value
      717                                     , 'стоп-клиент':U
      718                                     ).
      719                 run err-mess in this-procedure ( input-output v-mess).
      720                 undo main-block, return error (if p-silent = yes then v-mess else '':U).
      721               end.
      722           end.
      723         end.
      724       end.
      725     end.
      726   end.
      727   PROCEDURE err-mess:
      728     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      729     CASE p-silent:
      730       when yes then do:
      731         assign
      732         p-mess = substitute("Копирование стоплиста: оригинал - стоплист &1, копия - стоплист &2"
      733                            , p-src-stop-list-code
      734                            , p-trg-stop-list-code
      735                            , chr(10)
      736                            , p-mess)
      737         .
      738       end.
      739       when no then do:
      740         message
      741         p-mess
      742         view-as alert-box error .
      743       end.
      744     end.
      745   END PROCEDURE.
