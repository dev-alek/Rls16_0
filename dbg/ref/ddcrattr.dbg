        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-mode   as character no-undo .
        4   define input parameter p-d-card like ub.dis-card.d-card no-undo .
        5   define input parameter p-host-code like ub.sysconf.host-code no-undo .
        6   define input parameter p-obj-type  like ub.clients.obj-type  no-undo .
        7   define input parameter p-obj-code  like ub.clients.obj-code  no-undo .
        8   define input parameter p-update-on-exit as logical no-undo .
        9   define output parameter p-modified as logical no-undo .
       10   define output parameter p-is-error as logical no-undo .
       11   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       12   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       13   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile: ddcrattr.p $":U .
       15   define variable vss-archive     as character no-undo init "$Archive: ref/ddcrattr.p $":U .
       16   define variable vss-description as character no-undo init "Запуск интерфейса редактирования скидок ДК".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define   shared variable g#auto as logical no-undo.
       78   define   shared variable g#news as logical no-undo.
       79   define   shared variable g#oxml as logical no-undo.
       80   define   shared variable g#esys as logical no-undo.
       81   define   shared variable g#news-source-db as integer no-undo.
       82   define   shared variable g#esys-source-esys as integer no-undo.
       83   define   shared variable g#db-num as integer   no-undo .
       84   define   shared variable g#userid as character no-undo .
       85   define   shared variable g#passwd as character no-undo .
       86   define variable v-update-attr as logical no-undo .
       87   define variable dflt-cd as character no-undo .
       88   define temp-table tt0-dis-dc-rule no-undo like ub.dis-dc-rule.
       89   define buffer buf_dis-dc-rule for ub.dis-dc-rule.
       90   define buffer locked_dis-dc-rule for ub.dis-dc-rule.
       91   do
       92   on stop undo, return error
       93   :
       94     for each tt0-dis-dc-rule:
       95       delete tt0-dis-dc-rule.
       96     end.
       97     if g#db-num > 0 then do:
       98       if p-obj-type = 'маг':U then do:
       99   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      100   define variable v-param-type0 as character no-undo .
      101   define variable v-value-date0 as date no-undo .
      102   define variable v-value-decimal0 as decimal no-undo .
      103   define variable v-value-integer0 as INTEGER no-undo .
      104   define variable v-value-logical0 AS LOGICAL no-undo .
      105   define variable v-tth0 as handle no-undo .
      106   run adm/shattri.p (
      107       input "get":U
      108       ,input  p-obj-type
      109       ,input  p-obj-code
      110       ,input  'cd-sending':U
      111       ,input  'dflt-cd':U
      112       ,output dflt-cd
      113       ,output v-value-date0
      114       ,output v-value-decimal0
      115       ,output v-value-integer0
      116       ,output v-value-logical0
      117       ,output v-param-type0
      118       ,INPUT-OUTPUT table-handle v-tth0
      119       )  .
      120   delete object v-tth0 no-error.
      121       end.
      122       else do:
      123          dflt-cd = '-':U.
      124       end.
      125     end.
      126     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      127       do on error undo, return error return-value :
      128         Find first locked_dis-dc-rule exclusive-lock  where
      129                 locked_dis-dc-rule.d-card = p-d-card
      130             AND locked_dis-dc-rule.host-code = (if g#db-num = 0 then 0 else p-host-code)
      131             AND locked_dis-dc-rule.obj-type = (if g#db-num = 0 then '':U else p-obj-type)
      132             AND locked_dis-dc-rule.obj-code = (if g#db-num = 0 then 0 else p-obj-code)
      133             and locked_dis-dc-rule.discnt-role = '':U
      134             and locked_dis-dc-rule.pos-type = '':U
      135             and locked_dis-dc-rule.nonunique = '':U
      136             no-error no-wait.
      137         if not available locked_dis-dc-rule
      138         and not locked locked_dis-dc-rule then do:
      139           create locked_dis-dc-rule.
      140           assign
      141           locked_dis-dc-rule.host-code = (if g#db-num = 0 then 0 else p-host-code)
      142           locked_dis-dc-rule.obj-type =  (if g#db-num = 0 then '':U else p-obj-type)
      143           locked_dis-dc-rule.obj-code = (if g#db-num = 0 then 0 else p-obj-code)
      144           locked_dis-dc-rule.d-card = p-d-card
      145           locked_dis-dc-rule.discnt-role = '':U
      146           locked_dis-dc-rule.nonunique = '':U
      147           locked_dis-dc-rule.pos-type = '':U
      148           .
      149         end.
      150         if locked locked_dis-dc-rule then do:
      151         Find first locked_dis-dc-rule exclusive-lock  where
      152                 locked_dis-dc-rule.d-card = p-d-card
      153             AND locked_dis-dc-rule.host-code = (if g#db-num = 0 then 0 else p-host-code)
      154             AND locked_dis-dc-rule.obj-type =  (if g#db-num = 0 then '':U else p-obj-type)
      155             AND locked_dis-dc-rule.obj-code = (if g#db-num = 0 then 0 else p-obj-code)
      156             and locked_dis-dc-rule.discnt-role = '':U
      157             and locked_dis-dc-rule.nonunique = '':U
      158             and locked_dis-dc-rule.pos-type = '':U
      159             no-error .
      160         end.
      161       end.
      162       FOR EACH buf_dis-dc-rule no-lock  where
      163       buf_dis-dc-rule.d-card = p-d-card
      164       on error undo, return error :
      165         if buf_dis-dc-rule.nonunique = '':U
      166         and buf_dis-dc-rule.pos-type = '':U
      167         and buf_dis-dc-rule.discnt-role = '':U
      168         then next.
      169         CREATE tt0-dis-dc-rule.
      170         BUFFER-COPY buf_dis-dc-rule TO tt0-dis-dc-rule.
      171       END.
      172       run ref/dis-dcri.w (
      173                       input parparentproc
      174                     , input p-mode
      175                     , input p-d-card
      176                     , input p-host-code
      177                     , input p-obj-type
      178                     , input p-obj-code
      179                     , input dflt-cd
      180                     , input p-update-on-exit
      181                     , output p-modified
      182                     , input-output table tt0-dis-dc-rule
      183                           ) no-error.
      184       if error-status:error then do:
      185         assign
      186         p-is-error = yes.
      187       end.
      188       for each tt0-dis-dc-rule:
      189         delete tt0-dis-dc-rule.
      190       end.
      191     end.
      192     else do:
      193       FOR EACH buf_dis-dc-rule no-lock where
      194            buf_dis-dc-rule.d-card = p-d-card
      195       on error undo, return error :
      196         if buf_dis-dc-rule.pos-type = '':U
      197         and buf_dis-dc-rule.discnt-role = '':U
      198         and buf_dis-dc-rule.nonunique = '':U
      199         then next.
      200         CREATE tt0-dis-dc-rule.
      201         BUFFER-COPY buf_dis-dc-rule TO tt0-dis-dc-rule.
      202       END.
      203       run ref/dis-dcri.w (
      204                       input parparentproc
      205                     , input p-mode
      206                     , input p-d-card
      207                     , input p-host-code
      208                     , input p-obj-type
      209                     , input p-obj-code
      210                     , input dflt-cd
      211                     , input p-update-on-exit
      212                     , output p-modified
      213                     , input-output table tt0-dis-dc-rule
      214                           ) no-error.
      215       if error-status:error then do:
      216         assign
      217         p-is-error = yes.
      218       end.
      219       for each tt0-dis-dc-rule:
      220         delete tt0-dis-dc-rule.
      221       end.
      222     end.
      223   end.
