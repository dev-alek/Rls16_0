      124     field db-num as integer
      125     index art  is primary unique artic prod-type prod-code
      126     index code is         unique gds-code
      127     index oi order-num
      128     index isel to-sel
      129     .
      130   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      131   define  new shared  temp-table gds-list-hist no-undo
      132   field list-table as character
      133   field id as integer
      134   field line as integer
      135   field hist-mode as character
      136   field des as character
      137   field num-recs as integer
      138   field option_ as character
      139   field item_ as character
      140   field status_ as character
      141   field num-add as integer
      142   field num-ignored as integer
      143   field done as logical
      144   field err_ as logical
      145   field err-mes as character
      146   index pi is primary
      147   id
      148   line
      149   index isdone
      150   done
      151   .
      152   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      153     define variable v-cntxt-db-num        as integer   no-undo .
      154     define variable v-cntxt-userid        as character no-undo .
      155     define variable v-cntxt-level         as character no-undo .
      156     define variable v-cntxt-host-code-obj as integer   no-undo .
      157     define variable v-cntxt-obj-type      as character no-undo .
      158     define variable v-cntxt-obj-code      as integer   no-undo .
      159     define variable v-cntxt-db-num-obj    as integer   no-undo .
      160     define variable v-cntxt-is-admin      as logical   no-undo .
      161   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      162     run mainmenu_getcntxt in parparentproc
      163       (output v-cntxt-db-num
      164       ,output v-cntxt-userid
      165       ,output v-cntxt-level
      166       ,output v-cntxt-host-code-obj
      167       ,output v-cntxt-obj-type
      168       ,output v-cntxt-obj-code
      169       ,output v-cntxt-db-num-obj
      170       ,output v-cntxt-is-admin
      171       ) .
      172   define variable rid-list    as  character no-undo .
      173   define variable log-res     as log no-undo.
      174   define variable rr          as recid no-undo.
      175   define variable v-log       as logical   no-undo .
      176   define variable line-mode   as character no-undo .
      177   define variable doc-rec     as recid no-undo .
      178   define variable gds-rec     as recid no-undo .
      179   define variable lns-cnt     as integer   no-undo .
      180   define variable g#log       as logical   no-undo .
      181   define variable varschartic like ub.price-list.artic initial " " no-undo.
      182   define variable ref-list    as character                     no-undo.
      183   define variable sch-field   as character no-undo.
      184   define variable sort-column-name as character no-undo .
      185   define variable list-option as character no-undo.
      186   define variable v-brws-mark as character no-undo COLUMN-LABEL "*"        FORMAT "X(1)":U  .
      187   define stream sout.
      188   define temp-table tt-gds-list no-undo like ub.goods
      189   field nn as integer
      190   index by-nn nn
      191   index by_gds-code gds-code
      192   .
      193   define buffer buf_alc-type-gds for ub.alc-type-gds.
      194   define buffer buf_goods        for ub.goods.
      195   define buffer buf_alc-type     for ub.alc-type.
      196   DEFINE MENU POPUP-MENU-b-mark
      197          MENU-ITEM m_mark_all     LABEL "Выбрать все"
      198          MENU-ITEM m_mark_no_one  LABEL "Снять выбор у всех"
      199          MENU-ITEM m_mark_invert  LABEL "Инвертировать выбор".
      200   DEFINE BUTTON b-mark
      201        LABEL "&*"
      202        SIZE 3 BY 1.
      203   DEFINE BUTTON b-add
      204        LABEL "&Добавить":L
      205        SIZE 10 BY 1.
      206   DEFINE BUTTON b-del
      207        LABEL "&Удалить":L
      208        SIZE 10 BY 1.
      209   DEFINE BUTTON b-exit AUTO-GO
      210        LABEL "&Выход ":L
      211        SIZE 10 BY 1.
      212   DEFINE BUTTON b-help
      213        LABEL "Помо&щь":L
      214        SIZE 10 BY 1.
      215   DEFINE BUTTON b-print
      216        LABEL "Пе&чать":L
      217        SIZE 10 BY 1.
      218   DEFINE VARIABLE FILL-IN-2 AS CHARACTER FORMAT "X(256)":U INITIAL "Поиск по"
      219         VIEW-AS TEXT
      220        SIZE 8.88 BY .67 NO-UNDO.
      221   DEFINE VARIABLE s-artic AS CHARACTER FORMAT "X(256)":U
      222        VIEW-AS FILL-IN
      223        SIZE 25 BY 1 NO-UNDO.
      224   DEFINE VARIABLE s-code AS CHARACTER FORMAT "X(256)":U
      225        VIEW-AS FILL-IN
      226        SIZE 25 BY 1 NO-UNDO.
      227   DEFINE VARIABLE s-name AS CHARACTER FORMAT "X(256)":U
      228        VIEW-AS FILL-IN
      229        SIZE 25 BY 1 NO-UNDO.
      230   DEFINE VARIABLE s-name-cnt AS CHARACTER FORMAT "X(256)":U
      231        LABEL ""
      232        VIEW-AS FILL-IN
      233        SIZE 25 BY 1 NO-UNDO.
      234   DEFINE VARIABLE r-sort AS INTEGER
      235        VIEW-AS RADIO-SET HORIZONTAL
      236        RADIO-BUTTONS
      237             "Код", 1,
      238   "Артикул", 2,
      239   "Нач.назв", 3
      240        SIZE 38.75 BY .96 TOOLTIP "Поиск по" NO-UNDO.
      241   DEFINE QUERY BROWSE-2 FOR
      242         alc-type-gds,
      243         goods
      244         SCROLLING.
      245   DEFINE BROWSE BROWSE-2
      246     QUERY BROWSE-2 NO-LOCK DISPLAY
      247         (IF ( INDEX (rid-list, string( recid(alc-type-gds)) ) > 0 ) THEN ("*") ELSE (" ")) @ v-brws-mark
      248         goods.artic FORMAT "X(16)":U
      249         goods.gds-name FORMAT "X(48)":U
      250         goods.gds-code FORMAT "999999999":U
      251       WITH NO-ROW-MARKERS SEPARATORS SIZE 87 BY 18.92
      252            BGCOLOR 15 .
      253   DEFINE FRAME Dialog-Frame
      254        b-mark AT ROW 1.0 COL 33
      255        b-exit AT ROW 1 COL 1
      256        b-add AT ROW 1 COL 12
      257        b-del AT ROW 1 COL 22
      258        b-print AT ROW 1 COL 68
      259        b-help AT ROW 1 COL 78
      260        r-sort AT ROW 2.04 COL 10.75 NO-LABEL WIDGET-ID 4
      261        s-artic AT ROW 2.04 COL 49 COLON-ALIGNED NO-LABEL WIDGET-ID 10
      262        s-name AT ROW 2.04 COL 49 COLON-ALIGNED NO-LABEL WIDGET-ID 8
      263        s-name-cnt AT ROW 2.04 COL 49 COLON-ALIGNED WIDGET-ID 12
      264        s-code AT ROW 2.04 COL 49 COLON-ALIGNED NO-LABEL WIDGET-ID 14
      265        BROWSE-2 AT ROW 3.13 COL 1
      266        FILL-IN-2 AT ROW 2.21 COL 1 NO-LABEL WIDGET-ID 2
      267        SPACE(78.12) SKIP(19.17)
      268       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      269            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      270            TITLE "Товары ".
      271   ASSIGN
      272          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      273          FRAME Dialog-Frame:HIDDEN           = TRUE.
      274          ASSIGN
      275          b-mark:POPUP-MENU IN FRAME Dialog-Frame       = MENU POPUP-MENU-b-mark:HANDLE.
      276   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      277   or insert-mode of browse-2 IN FRAME Dialog-Frame
      278   or MOUSE-SELECT-DBLCLICK OF BROWSE-2 IN FRAME Dialog-Frame
      279   DO:
      280      define variable v-ok as logical no-undo .
      281   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      282   define variable v-str-recid5 as character no-undo .
      283   define variable v-num-entry5 as integer   no-undo .
      284   assign
      285     v-str-recid5 = trim( string( recid( alc-type-gds ) , "->>>>>>>>>>>9":U ) )
      286     v-num-entry5 = lookup( v-str-recid5 , rid-list )
      287   .
      288   if v-num-entry5 > 0 then do:
      289     assign
      290       entry( v-num-entry5, rid-list ) = "":U
      291       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      292     .
      293   end.
      294   else do:
      295     assign
      296       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid5
      297     .
      298   end.
      299      v-ok = BROWSE-2:select-next-row () no-error .
      300      v-ok = BROWSE-2:refresh( )  in frame Dialog-Frame no-error .
      301   END.
      302   ON CHOOSE OF MENU-ITEM m_mark_all
      303   or + of browse-2 IN FRAME Dialog-Frame
      304   DO:
      305      define variable v-ok as logical no-undo .
      306      assign rid-list = "" .
      307        for each alc-type-gds
      308         WHERE alc-type-gds.alc-type-inner-code = p-alc-type-inner-code  NO-LOCK,
      309         EACH goods WHERE goods.gds-code = alc-type-gds.gds-code NO-LOCK
      310         :
      311         rid-list = rid-list + string( recid(alc-type-gds) ) .
      312      end .
      313      v-ok = BROWSE-2:refresh( )  in frame Dialog-Frame no-error.
      314   END.
      315   ON CHOOSE OF MENU-ITEM m_mark_no_one
      316   or - of browse-2 IN FRAME Dialog-Frame
      317   DO:
      318      define variable v-ok as logical no-undo .
      319      rid-list =  " " .
      320      v-ok = BROWSE-2:refresh( )  in frame Dialog-Frame no-error.
      321   END.
      322   ON CHOOSE OF MENU-ITEM m_mark_invert
      323   or * of browse-2 IN FRAME Dialog-Frame
      324   DO:
      325      define variable v-ok as logical no-undo .
      326        for each alc-type-gds
      327         WHERE alc-type-gds.alc-type-inner-code = p-alc-type-inner-code  NO-LOCK,
      328         EACH goods WHERE goods.gds-code = alc-type-gds.gds-code NO-LOCK
      329         :
      330   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      331   define variable v-str-recid7 as character no-undo .
      332   define variable v-num-entry7 as integer   no-undo .
      333   assign
      334     v-str-recid7 = trim( string( recid( alc-type-gds ) , "->>>>>>>>>>>9":U ) )
      335     v-num-entry7 = lookup( v-str-recid7 , rid-list )
      336   .
      337   if v-num-entry7 > 0 then do:
      338     assign
      339       entry( v-num-entry7, rid-list ) = "":U
      340       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      341     .
      342   end.
      343   else do:
      344     assign
      345       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid7
      346     .
      347   end.
      348      end .
      349      v-ok = BROWSE-2:refresh( )  in frame Dialog-Frame no-error.
      350   END.
      351   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      352   DO:
      353     APPLY "END-ERROR":U TO SELF.
      354   END.
      355   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      356   DO:
      357   assign
      358     line-mode = 'ДОБАВЛЕНИЕ':U
      359   .
      360   run str/chsgdsls.w
      361   (   input parParentProc ,
      362       input "alc-type" ,
      363       input "Вид акоголя: " + p-name  ,
      364       input ? ,
      365       input ? ,
      366       input v-cntxt-host-code-obj,
      367       input-output varschartic,
      368       output ref-list,
      369       output table tt-gds-list,
      370       false )
      371       .
      372       if ref-list <> "" then do:
      373          run cycle-add in this-procedure no-error.
      374         if error-status:error then do:
      375            message
      376               vss-workfile vss-revision vss-description skip
      377               "Ошибка при вызове процедуры создания товара" skip
      378               error-status :get-message(1) skip
      379               return-value skip
      380               view-as alert-box error .
      381            return no-apply.
      382         end.
      383       end.
      384       OPEN QUERY BROWSE-2 FOR EACH alc-type-gds       WHERE alc-type-gds.alc-type-inner-code = p-alc-type-inner-code  NO-LOCK,       EACH goods WHERE goods.gds-code = alc-type-gds.gds-code NO-LOCK     .
      385       for first goods WHERE recid (goods) = integer (entry (1, ref-list)),
      386        first alc-type-gds where goods.gds-code = alc-type-gds.gds-code NO-LOCK
      387        :
      388          def var p-rec as recid no-undo .
      389          p-rec = recid(alc-type-gds) .
      390          REPOSITION BROWSE-2 TO RECID p-rec  NO-ERROR.
      391       end .
      392   END.
      393   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      394   DO:
      395         define buffer del_alc-type-gds for ub.alc-type-gds.
      396         message "Удалить выбранные записи ?"
      397         view-as alert-box question
      398         buttons ok-cancel
      399         update v-ok as logical
      400         .
      401         if v-ok then do:
      402           if string(rid-list) eq "" then do:
      403   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      404   define variable v-str-recid9 as character no-undo .
      405   define variable v-num-entry9 as integer   no-undo .
      406   assign
      407     v-str-recid9 = trim( string( recid( alc-type-gds ) , "->>>>>>>>>>>9":U ) )
      408     v-num-entry9 = lookup( v-str-recid9 , rid-list )
      409   .
      410   if v-num-entry9 > 0 then do:
      411     assign
      412       entry( v-num-entry9, rid-list ) = "":U
      413       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      414     .
      415   end.
      416   else do:
      417     assign
      418       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid9
      419     .
      420   end.
      421              v-ok = BROWSE-2:select-next-row () no-error .
      422              if v-ok eq no then v-ok = BROWSE-2:select-prev-row () no-error .
      423           end .
      424          def var p-int as int no-undo .
      425          do  p-int = 1 to NUM-ENTRIES(rid-list) :
      426              find first del_alc-type-gds
      427               WHERE   ENTRY( p-int , rid-list )  eq string( recid(del_alc-type-gds)) no-error.
      428              delete del_alc-type-gds.
      429          end .
      430           assign rid-list = "" .
      431         end .
      432         v-ok = BROWSE-2:select-prev-row () no-error .
      433         if v-ok eq YES then
      434          v-ok = BROWSE-2:select-next-row () no-error .
      435         v-ok = BROWSE-2:refresh( )  in frame Dialog-Frame no-error.
      436   END.
      437   ON VALUE-CHANGED OF r-sort IN FRAME Dialog-Frame
      438   DO:
      439     Assign frame Dialog-Frame r-sort.
      440     case r-sort :
      441     when 1 then do:
      442           if sch-field = "s-name-cnt" then do:
      443                          assign frame Dialog-Frame:title = "Товары >> Вид алкогольной продукции - " + p-name.
      444                         OPEN QUERY BROWSE-2 FOR EACH alc-type-gds       WHERE alc-type-gds.alc-type-inner-code = p-alc-type-inner-code  NO-LOCK,       EACH goods WHERE goods.gds-code = alc-type-gds.gds-code NO-LOCK     .
      445                         end.
      446           enable s-code with frame Dialog-Frame.
      447               Hide s-name  s-name-cnt s-artic in frame Dialog-Frame.
      448           display s-code with frame Dialog-Frame.
      449           apply "entry" to s-code in frame Dialog-Frame.
      450      end.
      451     when 2 then do:
      452           if sch-field = "s-name-cnt" then do:
      453                          assign frame Dialog-Frame:title = "Товары >> Вид алкогольной продукции - " + p-name.
      454                         OPEN QUERY BROWSE-2 FOR EACH alc-type-gds       WHERE alc-type-gds.alc-type-inner-code = p-alc-type-inner-code  NO-LOCK,       EACH goods WHERE goods.gds-code = alc-type-gds.gds-code NO-LOCK     .
      455                         end.
      456           enable s-artic with frame Dialog-Frame.
      457               Hide s-name  s-name-cnt s-code in frame Dialog-Frame.
      458           display s-artic with frame Dialog-Frame.
      459           apply "entry" to s-artic in frame Dialog-Frame.
      460      end.
      461     when 3 then do:
      462       if sch-field = "s-name-cnt" then do:
      463                    assign frame Dialog-Frame:title = "Товары >> Вид алкогольной продукции - " + p-name.
      464                   OPEN QUERY BROWSE-2 FOR EACH alc-type-gds       WHERE alc-type-gds.alc-type-inner-code = p-alc-type-inner-code  NO-LOCK,       EACH goods WHERE goods.gds-code = alc-type-gds.gds-code NO-LOCK     .
      465                   end.
      466           enable s-name with frame Dialog-Frame.
      467           hide s-artic  s-name-cnt s-code in frame Dialog-Frame.
      468           display s-name with frame Dialog-Frame.
      469           apply "entry" to s-name in frame Dialog-Frame.
      470      end.
      471     when 4 then do:
      472           enable s-name-cnt with frame Dialog-Frame.
      473           hide s-artic  s-name s-code in frame Dialog-Frame.
      474           display s-name-cnt with frame Dialog-Frame.
      475           apply "entry" to s-name-cnt in frame Dialog-Frame.
      476      end.
      477     end case.
      478   END.
      479   ON MOUSE-SELECT-DBLCLICK OF s-artic IN FRAME Dialog-Frame
      480   OR  RETURN OF s-artic IN FRAME Dialog-Frame
      481   DO:
      482     if s-artic <> input frame Dialog-Frame s-artic or sch-field <> "s-artic" then do:
      483    sch-field = "s-artic".
      484    assign s-artic = input frame Dialog-Frame s-artic.
      485    doc-rec = ?.
      486    for each buf_alc-type-gds where buf_alc-type-gds.alc-type-inner-code = p-alc-type-inner-code,
      487               first buf_goods where buf_alc-type-gds.gds-code = buf_goods.gds-code and
      488                                     buf_goods.artic begins s-artic :
      489            doc-rec = recid(buf_alc-type-gds) .
      490            leave.
      491    end.
      492     if doc-rec = ? then message "Товар не найден !"  .
      493     else
      494         reposition BROWSE-2 to recid doc-rec no-error.
      495   return no-apply.
      496   end.
      497   END.
      498   ON MOUSE-SELECT-DBLCLICK OF s-code IN FRAME Dialog-Frame
      499   OR  RETURN OF s-code IN FRAME Dialog-Frame
      500   DO:
      501     if s-code <> input frame Dialog-Frame s-code or sch-field <> "s-code" then do:
      502    sch-field = "s-code".
      503    assign s-code = input frame Dialog-Frame s-code.
      504    doc-rec = ?.
      505    for each buf_alc-type-gds where buf_alc-type-gds.alc-type-inner-code = p-alc-type-inner-code,
      506               first buf_goods where buf_alc-type-gds.gds-code = buf_goods.gds-code and
      507                                     buf_goods.gds-code = integer(s-code) :
      508            doc-rec = recid(buf_alc-type-gds) .
      509            leave.
      510    end.
      511     if doc-rec = ? then message "Товар не найден !"  .
      512     else
      513         reposition BROWSE-2 to recid doc-rec no-error.
      514   return no-apply.
      515   end.
      516   END.
      517   ON MOUSE-SELECT-DBLCLICK OF s-name IN FRAME Dialog-Frame
      518   OR  RETURN OF s-name IN FRAME Dialog-Frame
      519   DO:
      520     if s-name <> input frame Dialog-Frame s-name or sch-field <> "s-name" then do:
      521    sch-field = "s-name".
      522    assign s-name = input frame Dialog-Frame s-name.
      523    doc-rec = ?.
      524    for each buf_alc-type-gds where buf_alc-type-gds.alc-type-inner-code = p-alc-type-inner-code,
      525               first buf_goods where buf_alc-type-gds.gds-code = buf_goods.gds-code and
      526                                     buf_goods.gds-name begins s-name :
      527            doc-rec = recid(buf_alc-type-gds) .
      528            leave.
      529    end.
      530     if doc-rec = ? then message "Товар не найден !"  .
      531     else
      532         reposition BROWSE-2 to recid doc-rec no-error.
      533   return no-apply.
      534   end.
      535   END.
      536   ON MOUSE-SELECT-DBLCLICK OF s-name-cnt IN FRAME Dialog-Frame
      537   OR  RETURN OF s-name-cnt IN FRAME Dialog-Frame
      538   DO:
      539     if s-name-cnt <> input frame Dialog-Frame s-name-cnt or sch-field <> "s-name-cnt" then do:
      540    sch-field = "s-name-cnt".
      541    assign s-name-cnt = input frame Dialog-Frame s-name-cnt.
      542    doc-rec = ?.
      543    for each buf_alc-type-gds where buf_alc-type-gds.alc-type-inner-code = p-alc-type-inner-code,
      544               first buf_goods where
      545                  buf_alc-type-gds.gds-code = buf_goods.gds-code and
      546                INDEX(buf_goods.gds-name,s-name-cnt) > 0 :
      547            doc-rec = recid(buf_alc-type-gds) .
      548            leave.
      549    end.
      550     if doc-rec = ? then message "Товар не найден !"  .
      551     else do:
      552        assign frame Dialog-Frame:title = "Товары >> виды алкогольной продукции - " + p-name + " , содержащие в названии " + s-name-cnt .
      553         OPEN QUERY BROWSE-2 FOR EACH ub.alc-type-gds       WHERE ub.alc-type-gds.alc-type-inner-code = p-alc-type-inner-code and             ub.alc-type-gds.create-user-db-num   = p-db-num NO-LOCK,       first ub.goods where       ub.goods.gds-code = ub.alc-type-gds.gds-code       NO-LOCK .
      554        end.
      555   return no-apply.
      556   end.
      557   END.
      558   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      559   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      560   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      561   on help of frame Dialog-Frame
      562   do:
      563     run gbl/app_help.p
      564       (input this-procedure :file-name
      565       ,input ''
      566       ,input ?
      567       ) no-error.
      568     if error-status :error then do:
      569       message
      570         "Ошибка при вызове помощи"
      571         error-status :get-message(1)
      572         view-as alert-box .
      573     end.
      574   end.
      575   run minbtn-set in this-procedure .
      576   on choose of b-help in frame Dialog-Frame
      577   do:
      578     apply "help":u to frame Dialog-Frame .
      579   end.
      580   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      581   procedure minbtn-set :
      582       do
      583           on error undo, return error return-value
      584           :
      585           define variable ii              as integer       no-undo .
      586           define variable fh              as widget-handle no-undo .
      587           define variable hh              as widget-handle no-undo .
      588           define variable v-h             as handle        extent 4 no-undo .
      589           define variable v-name-button   as character     no-undo .
      590           define variable v-help-old-x    as decimal       no-undo .
      591           define variable v-help-old-y    as decimal       no-undo .
      592           define variable v-help-old-size as decimal       no-undo .
      593           define variable v-frame-width   as decimal       no-undo .
      594           define variable jj              as integer       no-undo .
      595           do
      596               on error undo, return error
      597               :
      598               assign
      599                   v-frame-width = frame Dialog-Frame:width - 0.3
      600                   fh            = frame Dialog-Frame:first-child
      601                   hh            = fh:first-child
      602                   ii            = 1
      603                   .
      604               do while valid-handle(hh):
      605                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      606                   do:
      607                       case lc(hh:name) :
      608                           when "b-help" then
      609                               do:
      610                                   hh:load-image-up("cmp/b-help.bmp":u) .
      611                                   hh:load-image-down("cmp/b-help.bmp":u) .
      612                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      613                                   hh:TOOLTIP = "Помощь" .
      614                                   v-help-old-x = hh:column .
      615                                   v-help-old-y = hh:row    .
      616                                   v-help-old-size = hh:width .
      617                                   hh:width-chars = 2.5 .
      618                               end.
      619                           when "b-print" then
      620                               do:
      621                                   hh:load-image("cmp/b-print.bmp":u) .
      622                                   hh:TOOLTIP = "Печать" .
      623                                   v-h[ii] = hh:handle .
      624                                   ii = ii + 1 .
      625                                   hh:width-chars = 3 .
      626                               end.
      627                           when "b-history" or
      628                           when "b-hist" then
      629                               do:
      630                                   hh:load-image("cmp/b-hist.bmp":u) .
      631                                   hh:TOOLTIP = "История" .
      632                                   v-h[ii] = hh:handle .
      633                                   ii = ii + 1 .
      634                                   hh:width-chars = 3 .
      635                               end.
      636                           when "b-sch" then
      637                               do:
      638                                   hh:load-image("cmp/b-sch.bmp":u) .
      639                                   hh:TOOLTIP = "Установка Фильтра" .
      640                                   v-h[ii] = hh:handle .
      641                                   ii = ii + 1 .
      642                                   hh:width-chars = 3 .
      643                               end.
      644                           when "b-hist-user" then
      645                               do:
      646                                   hh:load-image("cmp/b-hist.bmp":u) .
      647                                   hh:TOOLTIP = "История пользователя" .
      648                                   ii = ii + 1 .
      649                               end.
      650                       end case.
      651                   end.
      652                   hh = hh:next-sibling.
      653               end.
      654               b-help:column = v-frame-width - b-help:width-chars.
      655               jj = 0.
      656               repeat ii = 4 to 1 by -1 :
      657                   if valid-handle (v-h[ii] ) then
      658                   do:
      659                       jj  = jj + 1 .
      660                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      661                       v-h[ii]:row    = v-help-old-y .
      662                   end.
      663               end.
      664           end.
      665       end.
      666   end procedure.
      667   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      668   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      669   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      670   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      671   define variable v-diasize-current-frame-width  as decimal   no-undo .
      672   define variable v-diasize-current-frame-height as decimal   no-undo .
      673   define variable v-diasize-change-size          as logical   no-undo .
      674   define variable v-diasize-resize-button        as handle    no-undo .
      675   define variable v-diasize-wndmax               as logical   no-undo .
      676   define variable v-diasize-wndstore             as logical   no-undo .
      677   define variable v-diasize-proc-name            as character no-undo .
      678   define variable v-diasize-browse-handle        as handle    no-undo .
      679   define variable v-diasize-browse-number        as integer   no-undo .
      680   define variable v-diasize-need-full-display    as logical   no-undo init false .
      681   define temp-table temp-diasize-handle no-undo
      682     field handle-value  as handle
      683     field save-position as decimal
      684     index xpk is primary unique handle-value
      685     .
      686   define temp-table temp-browse-handle no-undo
      687     field browse-type   as character
      688     field browse-number as integer
      689     field browse-handle as handle
      690     field original-size as decimal
      691     index xpk is primary unique browse-type browse-number
      692     index xie browse-type browse-handle
      693   .
      694   procedure diasize_change-height :
      695     define input  parameter p-change-value  as decimal   no-undo .
      696     define input  parameter p-move-resize   as logical   no-undo .
      697     define variable v-field-group-handle    as handle    no-undo .
      698     define variable v-object-handle         as handle    no-undo .
      699     define variable v-frame-height          as decimal   no-undo .
      700     define variable v-frame-virtual-height  as decimal   no-undo .
      701     define variable v-browse-height         as decimal   no-undo .
      702     define variable v-window-height         as decimal   no-undo .
      703     define variable v-window-virtual-height as decimal   no-undo .
      704     define variable v-change-sign           as integer   no-undo .
      705     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      706     define buffer buf_temp-browse-handle  for temp-browse-handle .
      707     if p-change-value > 0
      708     then do:
      709       if frame Dialog-Frame :height + p-change-value
      710           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      711       then do:
      712         assign
      713           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      714                           - (frame Dialog-Frame :height-chars)
      715         .
      716         if p-change-value <= 0
      717         then do:
      718           run diasize_position-resize-button in this-procedure .
      719           return .
      720         end.
      721       end.
      722     end.
      723     if p-change-value < 0
      724     then do:
      725       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      726       then do:
      727         assign
      728           p-change-value = v-diasize-orig-frame-height
      729                          - (frame Dialog-Frame :height-chars)
      730         .
      731         if p-change-value >= 0
      732         then do:
      733           run diasize_position-resize-button in this-procedure .
      734           return .
      735         end.
      736       end.
      737     end.
      738     if p-change-value >= 0
      739     then do:
      740       assign
      741         v-change-sign = 1
      742       .
      743     end.
      744     else do:
      745       assign
      746         v-change-sign = -1
      747       .
      748     end.
      749     assign
      750       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      751     .
      752     if p-change-value = 0
      753     then do:
      754       run diasize_position-resize-button in this-procedure .
      755       return .
      756     end.
      757     move_block:
      758     do
      759     on error undo move_block, retry move_block
      760     :
      761       if retry
      762       then do:
      763         do
      764         on error undo move_block, leave move_block
      765         :
      766           if p-change-value > 0
      767           then do:
      768             for each buf_temp-diasize-handle
      769             on error undo, next
      770             :
      771               assign
      772                 v-object-handle = buf_temp-diasize-handle.handle-value
      773               .
      774               if v-object-handle <> v-diasize-resize-button
      775               then do:
      776                 assign
      777                   v-object-handle :row = buf_temp-diasize-handle.save-position
      778                 .
      779               end.
      780             end.
      781             assign
      782               v-diasize-browse-handle :height = v-browse-height
      783             .
      784             for each buf_temp-browse-handle
      785               where buf_temp-browse-handle.browse-type = 'height':u
      786             on error undo, next
      787             :
      788               assign
      789                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      790               .
      791             end.
      792             assign
      793               frame Dialog-Frame :height = v-frame-height
      794             .
      795             if frame Dialog-Frame :scrollable = true
      796             then do:
      797               assign
      798                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      799               .
      800             end.
      801             run diasize_position-resize-button in this-procedure .
      802           end.
      803           else do:
      804             if frame Dialog-Frame :scrollable = true
      805             then do:
      806               assign
      807                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      808               .
      809             end.
      810             assign
      811               frame Dialog-Frame :height = v-frame-height
      812             .
      813             assign
      814               v-diasize-browse-handle :height = v-browse-height
      815             .
      816             for each buf_temp-browse-handle
      817               where buf_temp-browse-handle.browse-type = 'height':u
      818             on error undo, next
      819             :
      820               assign
      821                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      822               .
      823             end.
      824             for each buf_temp-diasize-handle
      825             on error undo, next
      826             :
      827               assign
      828                 v-object-handle = buf_temp-diasize-handle.handle-value
      829               .
      830               if v-object-handle <> v-diasize-resize-button
      831               then do:
      832                 assign
      833                   v-object-handle :row = buf_temp-diasize-handle.save-position
      834                 .
      835               end.
      836             end.
      837             run diasize_position-resize-button in this-procedure .
      838           end.
      839           assign
      840             v-diasize-change-size = false
      841           .
      842           leave move_block .
      843         end.
      844       end.
      845       assign
      846         v-diasize-need-full-display = true
      847       .
      848       if v-diasize-change-size = false
      849       then do:
      850         assign
      851           v-diasize-change-size = true
      852         .
      853       end.
      854       else do:
      855         return .
      856       end.
      857       assign
      858         v-frame-height = frame Dialog-Frame :height
      859         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      860         v-browse-height = v-diasize-browse-handle :height
      861       .
      862       for each buf_temp-browse-handle
      863         where buf_temp-browse-handle.browse-type = 'height':u
      864       :
      865         assign
      866           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      867         .
      868       end.
      869       for each buf_temp-diasize-handle
      870       :
      871         delete buf_temp-diasize-handle .
      872       end.
      873       assign
      874         v-field-group-handle = frame Dialog-Frame :first-child
      875       .
      876       do while valid-handle(v-field-group-handle)
      877       :
      878         assign
      879           v-object-handle = v-field-group-handle :first-child
      880         .
      881         do while valid-handle(v-object-handle)
      882         :
      883           if  v-object-handle <> v-diasize-browse-handle :handle
      884           and can-query(v-object-handle, "row")
      885           and can-query(v-object-handle, "height")
      886           and ( v-object-handle :row > v-diasize-browse-handle :row )
      887           then do:
      888             find first buf_temp-browse-handle
      889               where buf_temp-browse-handle.browse-type   = 'height':u
      890                 and buf_temp-browse-handle.browse-handle = v-object-handle
      891               no-error .
      892             if available buf_temp-browse-handle
      893             then do:
      894             end.
      895             else do:
      896               create buf_temp-diasize-handle .
      897               assign
      898                 buf_temp-diasize-handle.handle-value  = v-object-handle
      899                 buf_temp-diasize-handle.save-position = v-object-handle :row
      900               .
      901             end.
      902           end.
      903           assign
      904             v-object-handle = v-object-handle :next-sibling
      905           .
      906         end.
      907         assign
      908           v-field-group-handle = v-field-group-handle :next-sibling
      909         .
      910       end.
      911       do with frame Dialog-Frame
      912       :
      913         hide v-diasize-resize-button .
      914         assign
      915           v-diasize-resize-button :row    = 1
      916           v-diasize-resize-button :column = 1
      917         .
      918       end.
      919       if p-change-value > 0
      920       then do:
      921         if frame Dialog-Frame :scrollable = true
      922         then do:
      923           assign
      924             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      925             no-error .
      926           if error-status :error
      927           or error-status :get-message(1) <> ""
      928           then do:
      929             undo move_block, retry move_block .
      930           end.
      931         end.
      932         assign
      933           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      934           no-error .
      935         if error-status :error
      936         or error-status :get-message(1) <> ""
      937         then do:
      938           undo move_block, retry move_block .
      939         end.
      940         assign
      941           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      942           no-error .
      943         if error-status :error
      944         or error-status :get-message(1) <> ""
      945         then do:
      946           undo move_block, retry move_block .
      947         end.
      948         for each buf_temp-browse-handle
      949           where buf_temp-browse-handle.browse-type = 'height':u
      950         on error undo move_block, retry move_block
      951         :
      952           assign
      953             buf_temp-browse-handle.browse-handle :height
      954               = buf_temp-browse-handle.browse-handle :height + p-change-value
      955             no-error .
      956           if error-status :error
      957           or error-status :get-message(1) <> ""
      958           then do:
      959             undo move_block, retry move_block .
      960           end.
      961         end.
      962         for each buf_temp-diasize-handle
      963         on error undo move_block, retry move_block
      964         :
      965           assign
      966             v-object-handle = buf_temp-diasize-handle.handle-value
      967           .
      968           if v-object-handle <> v-diasize-resize-button
      969           then do:
      970             assign
      971               v-object-handle :row = v-object-handle :row + p-change-value
      972               no-error .
      973             if error-status :error
      974             or error-status :get-message(1) <> ""
      975             then do:
      976               undo move_block, retry move_block .
      977             end.
      978           end.
      979         end.
      980       end.
      981       else do:
      982         for each buf_temp-diasize-handle
      983         on error undo move_block, retry move_block
      984         :
      985           assign
      986             v-object-handle = buf_temp-diasize-handle.handle-value
      987           .
      988           if v-object-handle <> v-diasize-resize-button
      989           then do:
      990             assign
      991               v-object-handle :row = v-object-handle :row + p-change-value
      992               no-error .
      993             if error-status :error
      994             or error-status :get-message(1) <> ""
      995             then do:
      996               undo move_block, retry move_block .
      997             end.
      998           end.
      999         end.
     1000         assign
     1001           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1002           no-error .
     1003         if error-status :error
     1004         or error-status :get-message(1) <> ""
     1005         then do:
     1006           undo move_block, retry move_block .
     1007         end.
     1008         for each buf_temp-browse-handle
     1009           where buf_temp-browse-handle.browse-type = 'height':u
     1010         on error undo move_block, retry move_block
     1011         :
     1012           assign
     1013             buf_temp-browse-handle.browse-handle :height
     1014               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1015             no-error .
     1016           if error-status :error
     1017           or error-status :get-message(1) <> ""
     1018           then do:
     1019             undo move_block, retry move_block .
     1020           end.
     1021         end.
     1022         assign
     1023           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1024           no-error .
     1025         if error-status :error
     1026         or error-status :get-message(1) <> ""
     1027         then do:
     1028           undo move_block, retry move_block .
     1029         end.
     1030         if frame Dialog-Frame :scrollable = true
     1031         then do:
     1032           assign
     1033             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1034             no-error .
     1035           if error-status :error
     1036           or error-status :get-message(1) <> ""
     1037           then do:
     1038             undo move_block, retry move_block .
     1039           end.
     1040         end.
     1041       end.
     1042       if p-move-resize = true
     1043       then do:
     1044         run diasize_position-resize-button in this-procedure .
     1045       end.
     1046       if v-diasize-wndstore = true
     1047       then do:
     1048         if connected("ub") = true
     1049         then do:
     1050           define variable v-cntxt-db-num        as integer   no-undo .
     1051           define variable v-cntxt-userid        as character no-undo .
     1052           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1053                                             , OUTPUT v-cntxt-userid
     1054                                             ) .
     1055           run gbl/wndsizew.p
     1056             (input  v-cntxt-db-num
     1057             ,input  v-cntxt-userid
     1058             ,input  v-diasize-proc-name
     1059             ,input  'height':u
     1060             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1061             ) .
     1062         end.
     1063       end.
     1064     end.
     1065     assign
     1066       v-diasize-change-size = false
     1067     .
     1068   end procedure.
     1069   procedure diasize_set-height :
     1070     define input  parameter p-new-height  as decimal   no-undo .
     1071     define input  parameter p-move-resize as logical   no-undo .
     1072     do
     1073     on error undo, return error return-value
     1074     :
     1075       run diasize_change-height in this-procedure
     1076         (input  (p-new-height - frame Dialog-Frame :height)
     1077         ,input  p-move-resize
     1078         ) .
     1079     end.
     1080   end procedure.
     1081   procedure diasize_change-width :
     1082     define input  parameter p-change-value as decimal   no-undo .
     1083     define input  parameter p-move-resize  as logical   no-undo .
     1084     define variable v-field-group-handle   as handle    no-undo .
     1085     define variable v-object-handle        as handle    no-undo .
     1086     define variable v-frame-width          as decimal   no-undo .
     1087     define variable v-frame-virtual-width  as decimal   no-undo .
     1088     define variable v-browse-width         as decimal   no-undo .
     1089     define variable v-window-width         as decimal   no-undo .
     1090     define variable v-window-virtual-width as decimal   no-undo .
     1091     define variable v-change-sign          as integer   no-undo .
     1092     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1093     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1094     if p-change-value > 0
     1095     then do:
     1096       if frame Dialog-Frame :width + p-change-value >
     1097           session :width-chars
     1098       then do:
     1099         assign
     1100           p-change-value = session :width-chars - frame Dialog-Frame :width
     1101         .
     1102         if p-change-value <= 0
     1103         then do:
     1104           run diasize_position-resize-button in this-procedure .
     1105           return .
     1106         end.
     1107       end.
     1108     end.
     1109     if p-change-value < 0
     1110     then do:
     1111       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1112       then do:
     1113         assign
     1114           p-change-value = v-diasize-orig-frame-width
     1115                          - frame Dialog-Frame :width
     1116         .
     1117         if p-change-value >= 0
     1118         then do:
     1119           run diasize_position-resize-button in this-procedure .
     1120           return .
     1121         end.
     1122       end.
     1123     end.
     1124     if p-change-value >= 0
     1125     then do:
     1126       assign
     1127         v-change-sign = 1
     1128       .
     1129     end.
     1130     else do:
     1131       assign
     1132         v-change-sign = -1
     1133       .
     1134     end.
     1135     assign
     1136       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1137     .
     1138     if p-change-value = 0
     1139     then do:
     1140       run diasize_position-resize-button in this-procedure .
     1141       return .
     1142     end.
     1143     move_block:
     1144     do
     1145     on error undo move_block, leave move_block
     1146     :
     1147       if retry
     1148       then do:
     1149         do
     1150         on error undo move_block, leave move_block
     1151         :
     1152           if p-change-value > 0
     1153           then do:
     1154             for each buf_temp-diasize-handle
     1155             on error undo, next
     1156             :
     1157               assign
     1158                 v-object-handle = buf_temp-diasize-handle.handle-value
     1159               .
     1160               if v-object-handle <> v-diasize-resize-button
     1161               then do:
     1162                 assign
     1163                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1164                 .
     1165               end.
     1166             end.
     1167             assign
     1168               v-diasize-browse-handle :width = v-browse-width
     1169             .
     1170             for each buf_temp-browse-handle
     1171               where buf_temp-browse-handle.browse-type = 'width':u
     1172             on error undo, next
     1173             :
     1174               assign
     1175                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1176               .
     1177             end.
     1178             assign
     1179               frame Dialog-Frame :width = v-frame-width
     1180             .
     1181             if frame Dialog-Frame :scrollable = true
     1182             then do:
     1183               assign
     1184                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1185               .
     1186             end.
     1187             run diasize_position-resize-button in this-procedure .
     1188           end.
     1189           else do:
     1190             if frame Dialog-Frame :scrollable = true
     1191             then do:
     1192               assign
     1193                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1194               .
     1195             end.
     1196             assign
     1197               frame Dialog-Frame :width = v-frame-width
     1198             .
     1199             for each buf_temp-browse-handle
     1200               where buf_temp-browse-handle.browse-type = 'width':u
     1201             on error undo, next
     1202             :
     1203               assign
     1204                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1205               .
     1206             end.
     1207             assign
     1208               v-diasize-browse-handle :width = v-browse-width
     1209             .
     1210             for each buf_temp-diasize-handle
     1211             on error undo, next
     1212             :
     1213               assign
     1214                 v-object-handle = buf_temp-diasize-handle.handle-value
     1215               .
     1216               if v-object-handle <> v-diasize-resize-button
     1217               then do:
     1218                 assign
     1219                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1220                 .
     1221               end.
     1222             end.
     1223             run diasize_position-resize-button in this-procedure .
     1224           end.
     1225           assign
     1226             v-diasize-change-size = false
     1227           .
     1228           leave move_block .
     1229         end.
     1230       end.
     1231       assign
     1232         v-diasize-need-full-display = true
     1233       .
     1234       if v-diasize-change-size = false
     1235       then do:
     1236         assign
     1237           v-diasize-change-size = true
     1238         .
     1239       end.
     1240       else do:
     1241         return .
     1242       end.
     1243       assign
     1244         v-frame-width = frame Dialog-Frame :width
     1245         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1246         v-browse-width = v-diasize-browse-handle :width
     1247       .
     1248       for each buf_temp-browse-handle
     1249         where buf_temp-browse-handle.browse-type = 'width':u
     1250       :
     1251         assign
     1252           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1253         .
     1254       end.
     1255       for each buf_temp-diasize-handle
     1256       :
     1257         delete buf_temp-diasize-handle .
     1258       end.
     1259       assign
     1260         v-field-group-handle = frame Dialog-Frame :first-child
     1261       .
     1262       do while valid-handle(v-field-group-handle)
     1263       :
     1264         assign
     1265           v-object-handle = v-field-group-handle :first-child
     1266         .
     1267         do while valid-handle(v-object-handle)
     1268         :
     1269           if  v-object-handle <> v-diasize-browse-handle :handle
     1270           and v-object-handle <> v-diasize-resize-button
     1271           and can-query(v-object-handle, "row")
     1272           and can-query(v-object-handle, "height")
     1273           and ( v-object-handle :col + v-object-handle :width
     1274                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1275               )
     1276           then do:
     1277             find first buf_temp-browse-handle
     1278               where buf_temp-browse-handle.browse-type   = 'width':u
     1279                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1280               no-error .
     1281             if available buf_temp-browse-handle
     1282             then do:
     1283             end.
     1284             else do:
     1285               create buf_temp-diasize-handle .
     1286               assign
     1287                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1288                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1289               .
     1290             end.
     1291           end.
     1292           assign
     1293             v-object-handle = v-object-handle :next-sibling
     1294           .
     1295         end.
     1296         assign
     1297           v-field-group-handle = v-field-group-handle :next-sibling
     1298         .
     1299       end.
     1300       do with frame Dialog-Frame
     1301       :
     1302         hide v-diasize-resize-button .
     1303         v-diasize-resize-button :row = 1.
     1304         v-diasize-resize-button :column = 1.
     1305       end.
     1306       if p-change-value > 0
     1307       then do:
     1308         if frame Dialog-Frame :scrollable = true
     1309         then do:
     1310           assign
     1311             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1312             no-error .
     1313           if error-status :error
     1314           or error-status :get-message(1) <> ""
     1315           then do:
     1316             undo move_block, retry move_block.
     1317           end.
     1318         end.
     1319         assign
     1320           frame Dialog-Frame :width = v-frame-width + p-change-value
     1321           no-error .
     1322         if error-status :error
     1323         or error-status :get-message(1) <> ""
     1324         then do:
     1325           undo move_block, retry move_block.
     1326         end.
     1327         assign
     1328           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1329         no-error .
     1330         if error-status :error
     1331         or error-status :get-message(1) <> ""
     1332         then do:
     1333           undo move_block, retry move_block.
     1334         end.
     1335         for each buf_temp-browse-handle
     1336           where buf_temp-browse-handle.browse-type = 'width':u
     1337         on error undo move_block, retry move_block
     1338         :
     1339           assign
     1340             buf_temp-browse-handle.browse-handle :width
     1341               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1342             no-error .
     1343           if error-status :error
     1344           or error-status :get-message(1) <> ""
     1345           then do:
     1346             undo move_block, retry move_block .
     1347           end.
     1348         end.
     1349         for each buf_temp-diasize-handle
     1350         on error undo move_block, retry move_block
     1351         :
     1352           assign
     1353             v-object-handle = buf_temp-diasize-handle.handle-value
     1354           .
     1355           if v-object-handle <> v-diasize-resize-button
     1356           then do:
     1357             assign
     1358               v-object-handle :col = v-object-handle :col + p-change-value
     1359               no-error .
     1360             if error-status :error
     1361             or error-status :get-message(1) <> ""
     1362             then do:
     1363               undo move_block, retry move_block .
     1364             end.
     1365           end.
     1366         end.
     1367       end.
     1368       else do:
     1369         for each buf_temp-diasize-handle
     1370         on error undo move_block, retry move_block
     1371         :
     1372           assign
     1373             v-object-handle = buf_temp-diasize-handle.handle-value
     1374           .
     1375           if v-object-handle <> v-diasize-resize-button
     1376           then do:
     1377             assign
     1378               v-object-handle :col = v-object-handle :col + p-change-value
     1379               no-error .
     1380             if error-status :error
     1381             or error-status :get-message(1) <> ""
     1382             then do:
     1383               undo move_block, retry move_block .
     1384             end.
     1385           end.
     1386         end.
     1387         for each buf_temp-browse-handle
     1388           where buf_temp-browse-handle.browse-type = 'width':u
     1389         on error undo move_block, retry move_block
     1390         :
     1391           assign
     1392             buf_temp-browse-handle.browse-handle :width
     1393               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1394             no-error .
     1395           if error-status :error
     1396           or error-status :get-message(1) <> ""
     1397           then do:
     1398             undo move_block, retry move_block .
     1399           end.
     1400         end.
     1401         assign
     1402           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1403           no-error .
     1404         if error-status :error
     1405         or error-status :get-message(1) <> ""
     1406         then do:
     1407           undo move_block, retry move_block.
     1408         end.
     1409         assign
     1410           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1411         no-error .
     1412         if error-status :error
     1413         or error-status :get-message(1) <> ""
     1414         then do:
     1415           undo move_block, retry move_block.
     1416         end.
     1417         if frame Dialog-Frame :scrollable = true
     1418         then do:
     1419           assign
     1420             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1421           no-error .
     1422           if error-status :error
     1423           or error-status :get-message(1) <> ""
     1424           then do:
     1425             undo move_block, retry move_block.
     1426           end.
     1427         end.
     1428       end.
     1429       if p-move-resize
     1430       then do:
     1431         run diasize_position-resize-button in this-procedure .
     1432       end.
     1433       if v-diasize-wndstore = true
     1434       then do:
     1435         if connected("ub") = true
     1436         then do:
     1437           define variable v-cntxt-db-num        as integer   no-undo .
     1438           define variable v-cntxt-userid        as character no-undo .
     1439           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1440                                             , OUTPUT v-cntxt-userid
     1441                                             ) .
     1442           run gbl/wndsizew.p
     1443             (input  v-cntxt-db-num
     1444             ,input  v-cntxt-userid
     1445             ,input  v-diasize-proc-name
     1446             ,input  'width':u
     1447             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1448             ) .
     1449         end.
     1450       end.
     1451     end.
     1452     assign
     1453       v-diasize-change-size = false
     1454     .
     1455   end procedure.
     1456   procedure diasize_set-width :
     1457     define input  parameter p-new-width  as decimal   no-undo .
     1458     define input  parameter p-move-resize as logical   no-undo .
     1459     do
     1460     on error undo, return error return-value
     1461     :
     1462       run diasize_change-width in this-procedure
     1463         (input  (p-new-width - frame Dialog-Frame :width)
     1464         ,input  p-move-resize
     1465         ) .
     1466     end.
     1467   end procedure.
     1468   procedure diasize_position-resize-button :
     1469     do with frame Dialog-Frame
     1470     :
     1471       hide v-diasize-resize-button .
     1472       assign
     1473         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1474                     - 1
     1475                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1476         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1477                     - 1
     1478                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1479       .
     1480       view v-diasize-resize-button .
     1481     end.
     1482   end procedure.
     1483   on alt-right anywhere
     1484   do:
     1485     run diasize_change-width in this-procedure
     1486       (input 1
     1487       ,input true
     1488       ) .
     1489     return no-apply .
     1490   end.
     1491   on alt-left anywhere
     1492   do:
     1493     run diasize_change-width in this-procedure
     1494       (input -1
     1495       ,input true
     1496       ) .
     1497     return no-apply .
     1498   end.
     1499   on alt-down anywhere
     1500   do:
     1501     run diasize_change-height in this-procedure
     1502       (input 1
     1503       ,input true
     1504       ) .
     1505     return no-apply .
     1506   end.
     1507   on alt-up anywhere
     1508   do:
     1509     run diasize_change-height in this-procedure
     1510       (input -1
     1511       ,input true
     1512       ) .
     1513     return no-apply .
     1514   end.
     1515   on alt-enter of frame Dialog-Frame
     1516   do:
     1517     run diasize_maximize in this-procedure
     1518       (input  ?
     1519       ).
     1520     return no-apply .
     1521   end.
     1522   procedure diasize_end-move :
     1523     do
     1524     on error undo, return error return-value
     1525     :
     1526       define variable v-row-delta as decimal   no-undo .
     1527       define variable v-col-delta as decimal   no-undo .
     1528       define variable v-new-row as decimal   no-undo .
     1529       define variable v-new-col as decimal   no-undo .
     1530       assign
     1531         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1532         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1533       .
     1534       assign
     1535         v-row-delta = v-new-row - frame Dialog-Frame :height
     1536         v-col-delta = v-new-col - frame Dialog-Frame :width
     1537       .
     1538       run diasize_change-height in this-procedure
     1539         (input v-row-delta
     1540         ,input true
     1541         ) .
     1542       run diasize_change-width in this-procedure
     1543         (input v-col-delta
     1544         ,input true
     1545         ) .
     1546     end.
     1547   end procedure.
     1548   procedure diasize_maximize :
     1549     define input  parameter p-action as logical   no-undo .
     1550     do
     1551     on error undo, return error return-value
     1552     :
     1553       if p-action = ?
     1554       then do:
     1555         if v-diasize-need-maximize = true
     1556         then do:
     1557           assign
     1558             p-action = true
     1559           .
     1560         end.
     1561         else do:
     1562           assign
     1563             p-action = false
     1564           .
     1565         end.
     1566       end.
     1567       if p-action = true
     1568       then do:
     1569         run diasize_change-height in this-procedure
     1570           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1571               - frame Dialog-Frame :height-chars
     1572           ,input true
     1573           ) .
     1574         run diasize_change-width in this-procedure
     1575           (input session :width-chars
     1576               - frame Dialog-Frame :width-chars
     1577           ,input true
     1578           ) .
     1579         assign
     1580           v-diasize-need-maximize = false
     1581         .
     1582       end.
     1583       else do:
     1584         run diasize_change-width in this-procedure
     1585           (input v-diasize-orig-frame-width
     1586               - frame Dialog-Frame :width-chars
     1587           ,input true
     1588           ) .
     1589         run diasize_change-height in this-procedure
     1590           (input v-diasize-orig-frame-height
     1591               - frame Dialog-Frame :height-chars
     1592           ,input true
     1593           ) .
     1594         assign
     1595           v-diasize-need-maximize = true
     1596         .
     1597       end.
     1598     end.
     1599   end procedure.
     1600   procedure diasize_restore-orig-size :
     1601     do
     1602     on error undo, return error return-value
     1603     :
     1604       assign
     1605         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1606         v-diasize-current-frame-height = frame Dialog-Frame :height
     1607       .
     1608       run diasize_set-height in this-procedure
     1609         (input  v-diasize-orig-frame-height
     1610         ,input  true
     1611         ) .
     1612       run diasize_set-width in this-procedure
     1613         (input  v-diasize-orig-frame-width
     1614         ,input  true
     1615         ) .
     1616     end.
     1617   end procedure.
     1618   procedure diasize_restore-current-size :
     1619     do
     1620     on error undo, return error return-value
     1621     :
     1622       run diasize_set-height in this-procedure
     1623         (input  v-diasize-current-frame-height
     1624         ,input  true
     1625         ) .
     1626       run diasize_set-width in this-procedure
     1627         (input  v-diasize-current-frame-width
     1628         ,input  true
     1629         ) .
     1630     end.
     1631   end procedure.
     1632   procedure diasize_set-browse-handle :
     1633     define input  parameter p-browse-handle as handle   no-undo .
     1634     define buffer buf_temp-browse-handle for temp-browse-handle .
     1635     do
     1636     on error undo, return error return-value
     1637     :
     1638       assign
     1639         v-diasize-browse-handle = p-browse-handle
     1640       .
     1641       for each buf_temp-browse-handle
     1642       on error undo, return error return-value
     1643       :
     1644         delete buf_temp-browse-handle .
     1645       end.
     1646     end.
     1647   end procedure.
     1648   procedure diasize_add_browse :
     1649     define input  parameter p-browse-type   as character no-undo .
     1650     define input  parameter p-browse-handle as handle    no-undo .
     1651     define buffer buf_temp-browse-handle for temp-browse-handle .
     1652     do
     1653     on error undo, return error return-value
     1654     :
     1655       assign
     1656         v-diasize-browse-number = v-diasize-browse-number + 1
     1657       .
     1658       create buf_temp-browse-handle .
     1659       assign
     1660         buf_temp-browse-handle.browse-type   = p-browse-type
     1661         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1662         buf_temp-browse-handle.browse-handle = p-browse-handle
     1663       .
     1664     end.
     1665   end procedure.
     1666   procedure diasize_init :
     1667     define variable v-default-value    as logical   no-undo .
     1668     define variable v-restore-saved    as logical   no-undo .
     1669     define variable v-resize-value-str as character no-undo .
     1670     do
     1671     on error undo, return error return-value
     1672     :
     1673       do with frame Dialog-Frame
     1674       :
     1675         assign
     1676           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1677           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1678           v-diasize-browse-handle     = browse BROWSE-2 :handle
     1679         .
     1680         create button v-diasize-resize-button
     1681         assign
     1682           parent        = frame Dialog-Frame :first-child
     1683           label         = "s"
     1684           height-pixels = 16
     1685           width-pixels  = 16
     1686           visible       = true
     1687           sensitive     = true
     1688           movable       = true
     1689           triggers:
     1690             on end-move persistent run diasize_end-move in this-procedure .
     1691           end triggers.
     1692         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1693         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1694         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1695         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1696         assign
     1697           v-diasize-wndmax = false
     1698         .
     1699         if connected("ub") = true
     1700         then do:
     1701           define variable v-cntxt-db-num        as integer   no-undo .
     1702           define variable v-cntxt-userid        as character no-undo .
     1703           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1704                                             , OUTPUT v-cntxt-userid
     1705                                             ) .
     1706           run gbl/wndpar_r.p
     1707             (input  v-cntxt-db-num
     1708             ,input  v-cntxt-userid
     1709             ,input  'wndmax':U
     1710             ,output v-diasize-wndmax
     1711             ,output v-default-value
     1712             ) .
     1713         end.
     1714         assign
     1715           v-diasize-wndstore = false
     1716         .
     1717         if connected("ub") = true
     1718         then do:
     1719           run gbl/wndpar_r.p
     1720             (input  v-cntxt-db-num
     1721             ,input  v-cntxt-userid
     1722             ,input  'wndstore':U
     1723             ,output v-diasize-wndstore
     1724             ,output v-default-value
     1725             ) .
     1726         end.
     1727         assign
     1728           v-diasize-proc-name = entry(1, program-name(2), '.')
     1729         .
     1730         if v-diasize-wndstore = true
     1731         then do:
     1732           assign
     1733             v-restore-saved = false
     1734           .
     1735           if connected("ub") = true
     1736           then do:
     1737             run gbl/wndsizer.p
     1738               (input  v-cntxt-db-num
     1739               ,input  v-cntxt-userid
     1740               ,input  v-diasize-proc-name
     1741               ,input  'height':u
     1742               ,output v-resize-value-str
     1743               ) .
     1744             if v-resize-value-str <> '':U
     1745             then do:
     1746               run diasize_change-height in this-procedure
     1747                 (input  integer(v-resize-value-str)
     1748                 ,input  true
     1749                 ) .
     1750               assign
     1751                 v-restore-saved = true
     1752               .
     1753             end.
     1754           end.
     1755           if connected("ub") = true
     1756           then do:
     1757             run gbl/wndsizer.p
     1758               (input  v-cntxt-db-num
     1759               ,input  v-cntxt-userid
     1760               ,input  v-diasize-proc-name
     1761               ,input  'width':u
     1762               ,output v-resize-value-str
     1763               ) .
     1764             if v-resize-value-str <> '':U
     1765             then do:
     1766               run diasize_change-width in this-procedure
     1767                 (input  integer(v-resize-value-str)
     1768                 ,input  true
     1769                 ) .
     1770               assign
     1771                 v-restore-saved = true
     1772               .
     1773             end.
     1774           end.
     1775           if v-restore-saved <> true
     1776           then do:
     1777             if v-diasize-wndmax = true
     1778             then do:
     1779               run diasize_maximize in this-procedure
     1780                 (input  true
     1781                 ) .
     1782             end.
     1783           end.
     1784         end.
     1785         else do:
     1786           if v-diasize-wndmax = true
     1787           then do:
     1788             run diasize_maximize in this-procedure
     1789               (input  true
     1790               ) .
     1791           end.
     1792         end.
     1793       end.
     1794     end.
     1795   end procedure.
     1796   procedure diasize_need-full-display :
     1797     define output parameter p-need-full-display as logical   no-undo .
     1798     do
     1799     on error undo, return error return-value
     1800     :
     1801       assign
     1802         p-need-full-display = v-diasize-need-full-display
     1803       .
     1804       assign
     1805         v-diasize-need-full-display = false
     1806       .
     1807     end.
     1808   end procedure.
     1809   procedure get-context :
     1810      define output parameter p-db-num as integer          no-undo.
     1811      define output parameter p-user-id as character        no-undo.
     1812      define variable v-login               as character    no-undo.
     1813      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1814      define buffer buf_user-login  for ub.user-login .
     1815      do
     1816      on error undo, return error
     1817      :
     1818            FIND FIRST buf_sys-ctrl no-lock.
     1819            ASSIGN
     1820               v-login = USERID("ub")
     1821               p-db-num = buf_sys-ctrl.db-num
     1822            .
     1823            FIND FIRST buf_user-login
     1824                 WHERE buf_user-login.db-num = p-db-num
     1825                   AND buf_user-login.user-login = v-login
     1826                 no-lock
     1827                 no-error
     1828                 .
     1829            IF AVAILABLE buf_user-login
     1830            THEN DO:
     1831               assign
     1832                  p-user-id = buf_user-login.user-id
     1833               .
     1834            END.
     1835      end.
     1836   end procedure.
     1837       run diasize_init in this-procedure .
     1838   assign
     1839      frame Dialog-Frame:title = "Товары >> " + p-name
     1840   .
     1841   def var sort-labelBROWSE-2   as character no-undo .
     1842   def var sort-clmnBROWSE-2    as handle    no-undo .
     1843   def var cur-clmnBROWSE-2     as handle    no-undo .
     1844   def var cur-clmn-locBROWSE-2 as integer   no-undo .
     1845   def var re-queryBROWSE-2     as logical   initial no no-undo .
     1846   on start-search, ctrl-o of BROWSE-2 in frame Dialog-Frame do:
     1847      run sort-brBROWSE-2
     1848        (input (if available alc-type-gds
     1849                then recid(alc-type-gds)
     1850                else ?
     1851               )
     1852        ).
     1853   end.
     1854   PROCEDURE sort-brBROWSE-2 :
     1855     define input parameter p-recid as recid no-undo .
     1856     if re-queryBROWSE-2 = no then do:
     1857       assign
     1858          cur-clmnBROWSE-2 = BROWSE-2:current-column in frame Dialog-Frame
     1859       .
     1860       if sort-clmnBROWSE-2 <> ? then sort-clmnBROWSE-2:column-fgcolor = 0.
     1861       if cur-clmnBROWSE-2 = sort-clmnBROWSE-2 then do:
     1862         assign
     1863            sort-labelBROWSE-2 = ""
     1864            sort-clmnBROWSE-2 = ?
     1865         .
     1866        end.
     1867        else do:
     1868          assign
     1869            sort-labelBROWSE-2 = cur-clmnBROWSE-2:label
     1870            sort-clmnBROWSE-2  = cur-clmnBROWSE-2
     1871            sort-clmnBROWSE-2:column-fgcolor = 4
     1872          .
     1873        end.
     1874      end.
     1875     assign
     1876       cur-clmn-locBROWSE-2 = 1
     1877     .
     1878     def var column-handle as handle no-undo .
     1879     column-handle = BROWSE-2:first-column.
     1880     do while valid-handle(column-handle) :
     1881       if column-handle = cur-clmnBROWSE-2 then do:
     1882         leave .
     1883       end.
     1884       column-handle = column-handle:NEXT-COLUMN.
     1885       assign
     1886         cur-clmn-locBROWSE-2 = cur-clmn-locBROWSE-2 + 1
     1887       .
     1888     end.
     1889     case sort-labelBROWSE-2:
     1890           when ub.goods.artic:label in browse BROWSE-2 then DO:   assign     sort-column-name = "ub.goods.artic"   .   run OpenBr.   . END.
     1891           when ub.goods.gds-name:label in browse BROWSE-2 then DO:   assign     sort-column-name = "ub.goods.gds-name"   .   run OpenBr.   . END.
     1892       otherwise do:
     1893         assign
     1894           sort-column-name = ""
     1895         .
     1896         run OpenBr.
     1897         if sort-labelBROWSE-2 <> "" then do:
     1898           assign
     1899             cur-clmnBROWSE-2:column-fgcolor = 0
     1900           .
     1901         end.
     1902         assign
     1903           cur-clmn-locBROWSE-2 = ?
     1904         .
     1905       end.
     1906     end case.
     1907     if p-recid <> ? then do:
     1908       reposition BROWSE-2 to recid p-recid no-error.
     1909       apply "value-changed" to BROWSE-2 in frame Dialog-Frame.
     1910     end.
     1911     apply "entry" to BROWSE-2 in frame Dialog-Frame.
     1912   END PROCEDURE.
     1913   procedure re-open-query-srt-clmnBROWSE-2:
     1914   if cur-clmnBROWSE-2 = ? then do:
     1915      run OpenBr.
     1916   end.
     1917   else do:
     1918      assign re-queryBROWSE-2 = yes.
     1919      run sort-brBROWSE-2
     1920        (input (if available alc-type-gds
     1921                then recid(alc-type-gds)
     1922                else ?
     1923               )
     1924        ).
     1925      assign re-queryBROWSE-2 = no.
     1926   end.
     1927   end.
     1928   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1929   on F9 of frame Dialog-Frame anywhere do:
     1930     if not available ub.goods then
     1931       return no-apply.
     1932     gds-rec = recid (ub.goods).
     1933     run ref/gds-form.w ( input parParentProc
     1934                         ,input 'ПРОСМОТР':U
     1935                         ,input ?
     1936                         ,input ?
     1937                         ,input ?
     1938                         ,input-output gds-rec).
     1939     apply "entry" to BROWSE-2 in frame Dialog-Frame.
     1940     return no-apply.
     1941   end.
     1942   MAIN-BLOCK:
     1943   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1944      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1945      run enable_UI in this-procedure .
     1946      run post_enable_UI in this-procedure .
     1947      find first  buf_alc-type no-lock
     1948           where  buf_alc-type.alc-type-inner-code = p-alc-type-inner-code
     1949             and  buf_alc-type.create-user-db-num   = p-db-num
     1950           no-error
     1951           .
     1952      if not available buf_alc-type  then return error .
     1953      enable  s-code with frame Dialog-Frame.
     1954      Hide      s-name  s-name-cnt s-artic in frame Dialog-Frame.
     1955      display s-code with frame Dialog-Frame.
     1956      WAIT-FOR GO OF FRAME Dialog-Frame.
     1957   END.
     1958   run disable_UI in this-procedure .
     1959   PROCEDURE cycle-add :
     1960   define variable v-num   as integer no-undo .
     1961      define variable v-count as integer no-undo .
     1962      define variable v-ok    as logical      no-undo.
     1963      define variable v-first as logical      no-undo.
     1964      define variable v-not-list    as character    no-undo.
     1965      define variable v-flag as logical   no-undo init false .
     1966      define buffer bb_alc-type-gds for ub.alc-type-gds .
     1967      define buffer buf_goods       for ub.goods .
     1968      run gbl/d-askw.w
     1969         (input "Вопрос"
     1970         ,input "Если товар уже прикреплен к виду алкоголя, пропускаем его?"
     1971         ,input "|^"
     1972         ,input "Не добавлять|Добавлять|Остановка"
     1973         ,input "Не добавляем товар к новому виду алкоголя, товар остается со старым видом|"
     1974            + "Добавляем товар к новому виду и открепляем от старого|"
     1975            + "Остановить добавление товаров, если встречаются товары прикрепленные к другим видам алкоголя."
     1976         ,input 1
     1977         ,input 2
     1978         ,output v-num
     1979         ).
     1980      assign
     1981         v-first = TRUE
     1982      .
     1983       case v-num :
     1984         when 1 then do :
     1985             for each tt-gds-list no-lock  by tt-gds-list.nn :
     1986               lns-cnt  =  lns-cnt + 1 .
     1987               if lns-cnt > 1 then assign line-mode = "ЦИКЛ":U.
     1988                 v-flag = false .
     1989                 for each bb_alc-type-gds no-lock where
     1990                          bb_alc-type-gds.gds-code = tt-gds-list.gds-code
     1991                 :
     1992                   v-flag = true.
     1993                   leave.
     1994                 end.
     1995                 if v-flag = false then do :
     1996                   find first bb_alc-type-gds no-lock
     1997                        where bb_alc-type-gds.gds-code            = tt-gds-list.gds-code
     1998                          and bb_alc-type-gds.alc-type-inner-code = p-alc-type-inner-code
     1999                          and bb_alc-type-gds.create-user-db-num  = p-db-num no-error.
     2000                   if not available bb_alc-type-gds then do :
     2001                     create bb_alc-type-gds.
     2002                     assign
     2003                         bb_alc-type-gds.gds-code            = tt-gds-list.gds-code
     2004                         bb_alc-type-gds.alc-type-inner-code = p-alc-type-inner-code
     2005                         bb_alc-type-gds.create-user-db-num  = p-db-num
     2006                     .
     2007                   end.
     2008                 end.
     2009             end.
     2010         end.
     2011         when 2 then do :
     2012             for each tt-gds-list no-lock  by tt-gds-list.nn :
     2013               lns-cnt  =  lns-cnt + 1 .
     2014               if lns-cnt > 1 then assign line-mode = "ЦИКЛ":U.
     2015                 v-flag = false .
     2016                 for each bb_alc-type-gds exclusive-lock where
     2017                          bb_alc-type-gds.gds-code = tt-gds-list.gds-code and
     2018                          bb_alc-type-gds.alc-type-inner-code <> p-alc-type-inner-code
     2019                 :
     2020                   delete bb_alc-type-gds.
     2021                 end.
     2022                 find first bb_alc-type-gds no-lock
     2023                       where bb_alc-type-gds.gds-code            = tt-gds-list.gds-code
     2024                         and bb_alc-type-gds.alc-type-inner-code = p-alc-type-inner-code
     2025                         and bb_alc-type-gds.create-user-db-num  = p-db-num no-error.
     2026                 if not available bb_alc-type-gds then do :
     2027                   create bb_alc-type-gds.
     2028                   assign
     2029                       bb_alc-type-gds.gds-code            = tt-gds-list.gds-code
     2030                       bb_alc-type-gds.alc-type-inner-code = p-alc-type-inner-code
     2031                       bb_alc-type-gds.create-user-db-num  = p-db-num
     2032                   .
     2033                 end.
     2034             end.
     2035         end.
     2036         when 3 then do :
     2037             for each tt-gds-list no-lock  by tt-gds-list.nn :
     2038               lns-cnt  =  lns-cnt + 1 .
     2039               if lns-cnt > 1 then assign line-mode = "ЦИКЛ":U.
     2040                 v-flag = false .
     2041                 for each bb_alc-type-gds no-lock where
     2042                           bb_alc-type-gds.gds-code = tt-gds-list.gds-code and
     2043                           bb_alc-type-gds.alc-type-inner-code <> p-alc-type-inner-code
     2044                 :
     2045                   v-flag = true .
     2046                   leave.
     2047                 end.
     2048               if v-flag = true then do :
     2049                 leave.
     2050               end.
     2051             end.
     2052             if v-flag <> true then do :
     2053               for each tt-gds-list no-lock  by tt-gds-list.nn :
     2054                 find first bb_alc-type-gds no-lock
     2055                       where bb_alc-type-gds.gds-code            = tt-gds-list.gds-code
     2056                         and bb_alc-type-gds.alc-type-inner-code = p-alc-type-inner-code
     2057                         and bb_alc-type-gds.create-user-db-num  = p-db-num no-error.
     2058                 if not available bb_alc-type-gds then do :
     2059                   create bb_alc-type-gds.
     2060                   assign
     2061                       bb_alc-type-gds.gds-code            = tt-gds-list.gds-code
     2062                       bb_alc-type-gds.alc-type-inner-code = p-alc-type-inner-code
     2063                       bb_alc-type-gds.create-user-db-num  = p-db-num
     2064                   .
     2065                 end.
     2066               end.
     2067             end.
     2068         end.
     2069       end case.
     2070   end procedure.
     2071   PROCEDURE disable_UI :
     2072     HIDE FRAME Dialog-Frame.
     2073   END PROCEDURE.
     2074   PROCEDURE enable_UI :
     2075     DISPLAY r-sort s-artic s-name s-name-cnt s-code FILL-IN-2
     2076         WITH FRAME Dialog-Frame.
     2077     ENABLE b-exit b-add b-del b-help r-sort s-artic s-code BROWSE-2 FILL-IN-2 b-mark
     2078         WITH FRAME Dialog-Frame.
     2079     VIEW FRAME Dialog-Frame.
     2080     OPEN QUERY BROWSE-2 FOR EACH alc-type-gds       WHERE alc-type-gds.alc-type-inner-code = p-alc-type-inner-code  NO-LOCK,       EACH goods WHERE goods.gds-code = alc-type-gds.gds-code NO-LOCK     .
     2081   END PROCEDURE.
     2082   PROCEDURE OpenBr :
     2083   define variable t-ret as logical no-undo .
     2084   t-ret =  session:SET-WAIT-STATE("GENERAL") .
     2085   message
     2086      "X"
     2087      skip sort-column-name
     2088   view-as alert-box information.
     2089   case sort-column-name :
     2090     when "ub.goods.artic" then do:
     2091           assign frame Dialog-Frame:title = "Товары >> " + p-name.    OPEN QUERY BROWSE-2 FOR EACH alc-type-gds       WHERE alc-type-gds.alc-type-inner-code = p-alc-type-inner-code  NO-LOCK,       EACH goods WHERE goods.gds-code = alc-type-gds.gds-code NO-LOCK     by goods.artic.    .
     2092     end.
     2093     when "ub.goods.gds-name" then do:
     2094           assign frame Dialog-Frame:title = "Товары >> " + p-name.    OPEN QUERY BROWSE-2 FOR EACH alc-type-gds       WHERE alc-type-gds.alc-type-inner-code = p-alc-type-inner-code  NO-LOCK,       EACH goods WHERE goods.gds-code = alc-type-gds.gds-code NO-LOCK     by goods.gds-name.    .
     2095     end.
     2096     otherwise do:
     2097           assign frame Dialog-Frame:title = "Товары >> " + p-name.    OPEN QUERY BROWSE-2 FOR EACH alc-type-gds       WHERE alc-type-gds.alc-type-inner-code = p-alc-type-inner-code  NO-LOCK,       EACH goods WHERE goods.gds-code = alc-type-gds.gds-code NO-LOCK     .    .
     2098     end.
     2099   end case.
     2100   t-ret =  session:SET-WAIT-STATE("") .
     2101   apply "HOME" to BROWSE-2 in frame Dialog-Frame.
     2102   END PROCEDURE.
     2103   PROCEDURE post_enable_UI :
     2104      if v-cntxt-db-num <> 0 then do:
     2105         disable
     2106               b-add b-del
     2107         WITH FRAME Dialog-Frame.
     2108      end.
     2109   END PROCEDURE.
     2110   PROCEDURE proc-b-list :
     2111   END PROCEDURE.
