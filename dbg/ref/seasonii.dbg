        1   def var vss-revision    as character no-undo init "$Revision$":U .
        2   def var vss-author      as character no-undo init "$Author$":U .
        3   def var vss-date        as character no-undo init "$Date$":U .
        4   def var vss-workfile    as character no-undo init "$Workfile$":U .
        5   def var vss-archive     as character no-undo init "$Archive$":U .
        6   def var vss-description as character no-undo init "Корректировка коллекции ".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   procedure proc-alt-shift-f2:
       62     if not ibs.th.gbl.gbl-var:rcode
       63   then
       64     run gbl\inidebug.p .
       65   end.
       66   procedure proc-alt-shift-f3:
       67     run gbl/prvssinf.p
       68       ( input this-procedure
       69       ) .
       70   end.
       71   define variable v-inform-launched as logical no-undo initial false .
       72   procedure proc-alt-shift-f4:
       73     define variable v-action as character no-undo .
       74     if v-inform-launched = false then do:
       75       assign
       76         v-inform-launched = true
       77       .
       78       run gbl/d-inform.w
       79         (  input self
       80         ,  input this-procedure
       81         , output v-action
       82         ) no-error .
       83       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       84       assign
       85         v-inform-launched = false
       86       .
       87     end.
       88   end.
       89   procedure proc-alt-f1:
       90     run gbl/corrhelp.p
       91       (input this-procedure
       92       ) .
       93   end .
       94   on alt-shift-f2 anywhere do:
       95     run proc-alt-shift-f2.
       96   end.
       97   on alt-shift-f3 anywhere do:
       98     run proc-alt-shift-f3 in this-procedure .
       99   end.
      100   on alt-shift-f4 anywhere do:
      101     run proc-alt-shift-f4 in this-procedure.
      102   end.
      103   on alt-f1 anywhere do:
      104     run proc-alt-f1 in this-procedure .
      105   end.
      106   define new global shared variable g#language as character no-undo .
      107   if g#language <> '' and g#language <> 'rus':U then do:
      108     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      109   end.
      110   define new global shared variable g#library  as handle no-undo .
      111   define new global shared variable g#library2 as handle no-undo .
      112   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      113     define variable v-cntxt-db-num        as integer   no-undo .
      114     define variable v-cntxt-userid        as character no-undo .
      115     define variable v-cntxt-level         as character no-undo .
      116     define variable v-cntxt-host-code-obj as integer   no-undo .
      117     define variable v-cntxt-obj-type      as character no-undo .
      118     define variable v-cntxt-obj-code      as integer   no-undo .
      119     define variable v-cntxt-db-num-obj    as integer   no-undo .
      120     define variable v-cntxt-is-admin      as logical   no-undo .
      121   define input  parameter parParentProc  as widget-handle no-undo.
      122   def input param p-def as char no-undo.
      123   def input-output param  rr as recid no-undo.
      124   define buffer buf1_season for ub.season .
      125   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      126     run mainmenu_getcntxt in parparentproc
      127       (output v-cntxt-db-num
      128       ,output v-cntxt-userid
      129       ,output v-cntxt-level
      130       ,output v-cntxt-host-code-obj
      131       ,output v-cntxt-obj-type
      132       ,output v-cntxt-obj-code
      133       ,output v-cntxt-db-num-obj
      134       ,output v-cntxt-is-admin
      135       ) .
      136   DEFINE BUTTON B-Cancel AUTO-END-KEY
      137        LABEL "&Отмена"
      138        SIZE 10 BY 1
      139        BGCOLOR 8 .
      140   DEFINE BUTTON B-Help
      141        LABEL "&Помощь"
      142        SIZE 10 BY 1
      143        BGCOLOR 8 .
      144   DEFINE BUTTON B-OK AUTO-GO
      145        LABEL "&Ввод"
      146        SIZE 10 BY 1
      147        BGCOLOR 8 .
      148   DEFINE VARIABLE loc-code AS INTEGER FORMAT ">>>>>>>>>9":U INITIAL 0
      149        LABEL "Код"
      150         VIEW-AS TEXT
      151        SIZE 14 BY .67
      152        FGCOLOR 1  NO-UNDO.
      153   DEFINE VARIABLE loc-name AS CHARACTER FORMAT "X(256)":U
      154        LABEL "Название"
      155        VIEW-AS FILL-IN
      156        SIZE 47.13 BY 1 NO-UNDO.
      157   DEFINE FRAME Dialog-Frame
      158        B-OK AT ROW 1 COL 1
      159        B-Cancel AT ROW 1 COL 11
      160        B-Help AT ROW 1 COL 21
      161        loc-name AT ROW 4.75 COL 12 COLON-ALIGNED
      162        loc-code AT ROW 3.75 COL 12 COLON-ALIGNED
      163        SPACE(37.99) SKIP(4.61)
      164       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      165            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      166            TITLE "Коллекция"
      167            DEFAULT-BUTTON B-OK CANCEL-BUTTON B-Cancel.
      168   ASSIGN
      169          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      170          FRAME Dialog-Frame:HIDDEN           = TRUE.
      171   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      172   DO:
      173     APPLY "END-ERROR":U TO SELF.
      174   END.
      175   ON CHOOSE OF B-OK IN FRAME Dialog-Frame
      176   DO:
      177     Assign
      178     loc-code
      179     loc-name
      180         .
      181       if loc-name = "" then do:
      182         message "Введите название коллекции ! " view-as  alert-box  error.
      183         apply "entry"  to loc-name .
      184         return no-apply.
      185       end.
      186       if p-def = 'ДОБАВЛЕНИЕ':U then do:
      187         create ub.season.
      188          Assign
      189            ub.season.sea-code = loc-code
      190            ub.season.db-num   = v-cntxt-db-num
      191            .
      192       end.
      193       if p-def = 'ДОБАВЛЕНИЕ':U OR p-def = 'ИЗМЕНЕНИЕ':U  then
      194          Assign
      195             ub.season.sea-name = loc-name
      196             ub.season.sea-month-1 = 0
      197             ub.season.sea-month-2 = 0
      198             rr = recid(ub.season)
      199             .
      200        else rr = ? .
      201   END.
      202   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      203   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      204   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      205   on help of frame Dialog-Frame
      206   do:
      207     run gbl/app_help.p
      208       (input this-procedure :file-name
      209       ,input ''
      210       ,input ?
      211       ) no-error.
      212     if error-status :error then do:
      213       message
      214         "Ошибка при вызове помощи"
      215         error-status :get-message(1)
      216         view-as alert-box .
      217     end.
      218   end.
      219   run minbtn-set in this-procedure .
      220   on choose of b-help in frame Dialog-Frame
      221   do:
      222     apply "help":u to frame Dialog-Frame .
      223   end.
      224   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      225   procedure minbtn-set :
      226       do
      227           on error undo, return error return-value
      228           :
      229           define variable ii              as integer       no-undo .
      230           define variable fh              as widget-handle no-undo .
      231           define variable hh              as widget-handle no-undo .
      232           define variable v-h             as handle        extent 4 no-undo .
      233           define variable v-name-button   as character     no-undo .
      234           define variable v-help-old-x    as decimal       no-undo .
      235           define variable v-help-old-y    as decimal       no-undo .
      236           define variable v-help-old-size as decimal       no-undo .
      237           define variable v-frame-width   as decimal       no-undo .
      238           define variable jj              as integer       no-undo .
      239           do
      240               on error undo, return error
      241               :
      242               assign
      243                   v-frame-width = frame Dialog-Frame:width - 0.3
      244                   fh            = frame Dialog-Frame:first-child
      245                   hh            = fh:first-child
      246                   ii            = 1
      247                   .
      248               do while valid-handle(hh):
      249                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      250                   do:
      251                       case lc(hh:name) :
      252                           when "b-help" then
      253                               do:
      254                                   hh:load-image-up("cmp/b-help.bmp":u) .
      255                                   hh:load-image-down("cmp/b-help.bmp":u) .
      256                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      257                                   hh:TOOLTIP = "Помощь" .
      258                                   v-help-old-x = hh:column .
      259                                   v-help-old-y = hh:row    .
      260                                   v-help-old-size = hh:width .
      261                                   hh:width-chars = 2.5 .
      262                               end.
      263                           when "b-print" then
      264                               do:
      265                                   hh:load-image("cmp/b-print.bmp":u) .
      266                                   hh:TOOLTIP = "Печать" .
      267                                   v-h[ii] = hh:handle .
      268                                   ii = ii + 1 .
      269                                   hh:width-chars = 3 .
      270                               end.
      271                           when "b-history" or
      272                           when "b-hist" then
      273                               do:
      274                                   hh:load-image("cmp/b-hist.bmp":u) .
      275                                   hh:TOOLTIP = "История" .
      276                                   v-h[ii] = hh:handle .
      277                                   ii = ii + 1 .
      278                                   hh:width-chars = 3 .
      279                               end.
      280                           when "b-sch" then
      281                               do:
      282                                   hh:load-image("cmp/b-sch.bmp":u) .
      283                                   hh:TOOLTIP = "Установка Фильтра" .
      284                                   v-h[ii] = hh:handle .
      285                                   ii = ii + 1 .
      286                                   hh:width-chars = 3 .
      287                               end.
      288                           when "b-hist-user" then
      289                               do:
      290                                   hh:load-image("cmp/b-hist.bmp":u) .
      291                                   hh:TOOLTIP = "История пользователя" .
      292                                   ii = ii + 1 .
      293                               end.
      294                       end case.
      295                   end.
      296                   hh = hh:next-sibling.
      297               end.
      298               b-help:column = v-frame-width - b-help:width-chars.
      299               jj = 0.
      300               repeat ii = 4 to 1 by -1 :
      301                   if valid-handle (v-h[ii] ) then
      302                   do:
      303                       jj  = jj + 1 .
      304                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      305                       v-h[ii]:row    = v-help-old-y .
      306                   end.
      307               end.
      308           end.
      309       end.
      310   end procedure.
      311   assign frame Dialog-Frame:title = "Коллекция - " + p-def.
      312   MAIN-BLOCK:
      313   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      314      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      315     run local-init in this-procedure no-error .
      316     run enable_UI in this-procedure .
      317     WAIT-FOR GO OF FRAME Dialog-Frame.
      318   END.
      319   run disable_UI in this-procedure .
      320   PROCEDURE disable_UI :
      321     HIDE FRAME Dialog-Frame.
      322   END PROCEDURE.
      323   PROCEDURE enable_UI :
      324     DISPLAY loc-name loc-code
      325         WITH FRAME Dialog-Frame.
      326     ENABLE B-OK B-Cancel B-Help loc-name loc-code
      327         WITH FRAME Dialog-Frame.
      328     VIEW FRAME Dialog-Frame.
      329   END PROCEDURE.
      330   PROCEDURE local-init :
      331   if Lookup(p-def, 'ДОБАВЛЕНИЕ':U + "," + 'ПРОСМОТР':U + "," +  'ИЗМЕНЕНИЕ':U)  = 0 then return error.
      332     if p-def = 'ИЗМЕНЕНИЕ':U then do:
      333        find first ub.season where recid(ub.season) = rr  exclusive-lock  no-error .
      334     end.
      335     if p-def = 'ПРОСМОТР':U then do:
      336        find first ub.season where recid(ub.season) = rr  no-lock  no-error .
      337     end.
      338    if error-status :error then return error.
      339       if available ub.season then do:
      340       assign
      341         loc-code    = ub.season.sea-code
      342         loc-name    = ub.season.sea-name
      343         .
      344       end.
      345       else do:
      346           if p-def = 'ДОБАВЛЕНИЕ':U then do:
      347           loc-code = next-value ( s-casm , ub ) .
      348           end.
      349       end.
      350   END PROCEDURE.
