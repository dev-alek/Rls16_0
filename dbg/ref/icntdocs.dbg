      671        SIZE 10 BY 1.
      672   DEFINE BUTTON B-Help
      673        LABEL "Помо&щь"
      674        SIZE 3 BY 1
      675        BGCOLOR 8 .
      676   DEFINE BUTTON b-lkp
      677        LABEL "&Просмотр"
      678        SIZE 10 BY 1.
      679   DEFINE BUTTON B-mark
      680        LABEL "&*"
      681        SIZE 3 BY 1.
      682   DEFINE BUTTON b-print
      683        LABEL "&Печать"
      684        SIZE 3 BY 1.
      685   DEFINE BUTTON b-quit AUTO-END-KEY
      686        LABEL "&Выход"
      687        SIZE 10 BY 1
      688        BGCOLOR 8 .
      689   DEFINE BUTTON b-sch
      690        LABEL "Фильтр"
      691        SIZE 3 BY 1.
      692   DEFINE BUTTON B-sel AUTO-GO
      693        LABEL "Вы&бор"
      694        SIZE 10 BY 1.
      695   DEFINE VARIABLE ED-notes AS CHARACTER
      696        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      697        SIZE 98 BY 2.33 NO-UNDO.
      698   DEFINE VARIABLE agnt-name AS CHARACTER FORMAT "X(256)":U
      699        LABEL "Исп"
      700         VIEW-AS TEXT
      701        SIZE 14.5 BY .67
      702        FGCOLOR 4  NO-UNDO.
      703   DEFINE VARIABLE boss-name AS CHARACTER FORMAT "X(256)":U
      704        LABEL "М-р"
      705         VIEW-AS TEXT
      706        SIZE 14.5 BY .67
      707        FGCOLOR 4  NO-UNDO.
      708   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
      709         VIEW-AS TEXT
      710        SIZE 6 BY 1
      711        FGCOLOR 4  NO-UNDO.
      712   DEFINE VARIABLE obj-name AS CHARACTER FORMAT "X(256)":U
      713        LABEL "Объект"
      714         VIEW-AS TEXT
      715        SIZE 34 BY .67
      716        FGCOLOR 4  NO-UNDO.
      717   DEFINE VARIABLE wrkr-name AS CHARACTER FORMAT "X(256)":U
      718        LABEL "Кл-к"
      719         VIEW-AS TEXT
      720        SIZE 14.5 BY .67
      721        FGCOLOR 4  NO-UNDO.
      722   DEFINE QUERY BR-i-docs FOR
      723         X_icnt-doc SCROLLING.
      724   DEFINE QUERY Dialog-Frame FOR
      725         X_icnt-doc SCROLLING.
      726   DEFINE BROWSE BR-i-docs
      727     QUERY BR-i-docs NO-LOCK DISPLAY
      728         mark-string(recid(X_icnt-doc), v-rid-list)                     COLUMN-LABEL '*' format "x(2)"
      729   X_icnt-doc.status_                           COLUMN-LABEL 'Статус' format "x(6)"
      730   X_icnt-doc.doc-code                           COLUMN-LABEL 'Документ'
      731   X_icnt-doc.doc-date                           COLUMN-LABEL 'Дата'
      732   X_icnt-doc.fact-date                           column-label 'Факт'
      733   string(X_icnt-doc.fact-time, 'HH:MM:SS')                           column-label 'Время'
      734   X_icnt-doc.shift-date                           COLUMN-LABEL 'Смена'
      735   shift-name (buffer X_icnt-doc)                           COLUMN-LABEL '№' format "x(6)"
      736   (X_icnt-doc.obj-type + STRING(X_icnt-doc.obj-code))                           COLUMN-LABEL 'Объект'
      737   X_icnt-doc.state-el-cnt                           column-label 'Количество!по счетчику' FORMAT "->>>,>>>,>>>,>>>,>>9.999"
      738   X_icnt-doc.state-mh-cnt                          column-label 'Количество!по мернику' FORMAT "->>>,>>>,>>>,>>>,>>9.999"
      739   (X_icnt-doc.state-el-cnt - X_icnt-doc.state-mh-cnt)                          column-label 'Разница' FORMAT "->>>,>>>,>>>,>>>,>>9.999"
      740   X_icnt-doc.meas-el-cnt                          column-label 'Измерения!электронных!счетчиков' FORMAT "->>>,>>>,>>>,>>>,>>9.999"
      741   ENABLE
      742   X_icnt-doc.meas-el-cnt
      743       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 15.5 FIT-LAST-COLUMN.
      744   DEFINE FRAME Dialog-Frame
      745        b-quit AT ROW 1 COL 1
      746        B-mark AT ROW 1 COL 11
      747        B-sel AT ROW 1 COL 21
      748        b-add AT ROW 1 COL 31
      749        b-chg AT ROW 1 COL 41
      750        b-del AT ROW 1 COL 51
      751        b-lkp AT ROW 1 COL 61
      752        b-print AT ROW 1 COL 89
      753        b-sch AT ROW 1 COL 92
      754        B-Help AT ROW 1 COL 95
      755        b-close AT ROW 2 COL 31
      756        BR-i-docs AT ROW 3 COL 1
      757        ED-notes AT ROW 21 COL 1 NO-LABEL
      758        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
      759        obj-name AT ROW 19 COL 52
      760        boss-name AT ROW 20 COL 1
      761        agnt-name AT ROW 20 COL 25
      762        wrkr-name AT ROW 20 COL 49
      763        X_icnt-doc.creid AT ROW 20 COL 71.75
      764             LABEL "Опер"
      765              VIEW-AS TEXT
      766             SIZE 21.5 BY .67
      767             FGCOLOR 4
      768        SPACE(0.00) SKIP(2.79)
      769       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      770            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      771            TITLE ""
      772            CANCEL-BUTTON b-quit.
      773   ASSIGN
      774          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      775          FRAME Dialog-Frame:HIDDEN           = TRUE.
      776   ON GO OF FRAME Dialog-Frame
      777   DO:
      778     p-rid-list = v-rid-list.
      779   END.
      780   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      781   DO:
      782     APPLY "END-ERROR":U TO SELF.
      783   END.
      784   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      785   DO:
      786     run proc-b-add IN THIS-PROCEDURE NO-ERROR.
      787     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      788   END.
      789   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
      790   DO:
      791     run proc-b-chg IN THIS-PROCEDURE NO-ERROR.
      792     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      793   END.
      794   ON CHOOSE OF b-close IN FRAME Dialog-Frame
      795   DO:
      796     DEFINE VARIABLE v-icnt-rec AS RECID NO-UNDO.
      797     DEFINE VARIABLE glog AS LOGICAL no-undo.
      798     IF X_icnt-doc.status_ = 'факт':U THEN DO:
      799         message
      800         "Данный документ закрыт на факт."
      801         VIEW-AS ALERT-BOX .
      802       RETURN NO-APPLY.
      803     END.
      804     IF NOT AVAILABLE X_icnt-doc THEN RETURN NO-APPLY.
      805   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      806   do:
      807     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      808       (input  v-cntxt-db-num
      809       ,input  v-cntxt-userid
      810       ,input  0
      811       ,input  'actn_icnt-doc_fact':U
      812       ,input  'object':U
      813       ,input  X_icnt-doc.host-code
      814       ,input  X_icnt-doc.obj-type
      815       ,input  X_icnt-doc.obj-code
      816       ,input  0
      817       ,input  0
      818       ,input  0
      819       ,input  true
      820       ,output glog
      821       )  .
      822   end.
      823     IF NOT glog THEN RETURN NO-APPLY.
      824     MESSAGE
      825     SUBSTITUTE("Вы действительно хотите закрыть документ счетчиков ТРК &1?", X_icnt-doc.doc-code)
      826     VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
      827     IF NOT glog THEN RETURN NO-APPLY.
      828     v-icnt-rec = RECID(X_icnt-doc).
      829     run str/icntdoc2.p ( INPUT RECID(X_icnt-doc)
      830                    ,INPUT NO
      831                    ) NO-ERROR.
      832     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      833     run Openbr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U).
      834     REPOSITION br-i-docs TO RECID v-icnt-rec NO-ERROR.
      835     APPLY "ENtRY" TO br-i-docs.
      836     APPLY "value-changed" TO br-i-docs.
      837   END.
      838   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      839   DO:
      840     DEFINE VARIABLE glog AS LOGICAL NO-UNDO INIT YES.
      841     IF NOT AVAILABLE X_icnt-doc THEN RETURN NO-APPLY.
      842     message
      843     substitute("Удалить документ  счетчиков ТРК № &1?   Вы уверены ?"
      844                , X_icnt-doc.doc-code)
      845     view-as alert-box question buttons OK-Cancel update glog.
      846     IF NOT glog THEN RETURN NO-APPLY.
      847   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      848   do:
      849     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      850       (input  v-cntxt-db-num
      851       ,input  v-cntxt-userid
      852       ,input  0
      853       ,input  'actn_icnt-doc_preparation':U
      854       ,input  'object':U
      855       ,input  X_icnt-doc.host-code
      856       ,input  X_icnt-doc.obj-type
      857       ,input  X_icnt-doc.obj-code
      858       ,input  0
      859       ,input  0
      860       ,input  0
      861       ,input  true
      862       ,output glog
      863       )  .
      864   end.
      865     v-icnt-rec = RECID(X_icnt-doc).
      866     glog = br-i-docs:select-next-row().
      867     if not glog then glog = br-i-docs:select-prev-row().
      868     run str/icntdoc3.p ( INPUT v-icnt-rec
      869                    ,INPUT NO
      870                    ) NO-ERROR.
      871     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      872     run Openbr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U).
      873     REPOSITION br-i-docs TO RECID v-icnt-rec NO-ERROR.
      874     APPLY "ENtRY" TO br-i-docs.
      875     APPLY "value-changed" TO br-i-docs.
      876   END.
      877   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
      878   DO:
      879     run proc-b-lkp IN THIS-PROCEDURE NO-ERROR.
      880     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      881   END.
      882   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
      883   DO:
      884     define variable loc#log as logical no-undo .
      885     if available X_icnt-doc then do:
      886   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      887   define variable v-str-recid12 as character no-undo .
      888   define variable v-num-entry12 as integer   no-undo .
      889   assign
      890     v-str-recid12 = trim( string( recid( X_icnt-doc ) , "->>>>>>>>>>>9":U ) )
      891     v-num-entry12 = lookup( v-str-recid12 , v-rid-list )
      892   .
      893   if v-num-entry12 > 0 then do:
      894     assign
      895       entry( v-num-entry12, v-rid-list ) = "":U
      896       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      897     .
      898   end.
      899   else do:
      900     assign
      901       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid12
      902     .
      903   end.
      904       loc#log = br-i-docs:refresh() .
      905       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      906           loc#log = br-i-docs:select-next-row ().
      907           apply "VALUE-CHANGED" to br-i-docs in frame Dialog-Frame.
      908       end.
      909       if num-entries( v-rid-list ) = 0
      910       then
      911           hide mark-num in frame Dialog-Frame.
      912       else
      913           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
      914     end.
      915     apply "entry" to br-i-docs in frame Dialog-Frame.
      916   END.
      917   ON CHOOSE OF b-print IN FRAME Dialog-Frame
      918   DO:
      919     run proc-b-print IN THIS-PROCEDURE NO-ERROR.
      920     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      921   END.
      922   ON CHOOSE OF b-sch IN FRAME Dialog-Frame
      923   DO:
      924     run proc-b-sch IN THIS-PROCEDURE NO-ERROR.
      925     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      926   END.
      927   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
      928   DO:
      929       if ( available X_icnt-doc ) then do:
      930       if  ( v-rid-list = "" ) or b-mark:sensitive = no
      931       then
      932       v-rid-list = string( recid( X_icnt-doc ) ) .
      933     end.
      934   END.
      935   ON RETURN OF BR-i-docs IN FRAME Dialog-Frame
      936   OR MOUSE-SELECT-DBLCLICK OF BR-i-docs IN FRAME Dialog-Frame DO:
      937     apply "choose" to b-lkp in frame Dialog-Frame.
      938   END.
      939   ON VALUE-CHANGED OF BR-i-docs IN FRAME Dialog-Frame
      940   DO:
      941   DEFINE BUFFER buf_clients FOR ub.clients.
      942       if available X_icnt-doc then do:
      943       find FIRST buf_clients NO-LOCK where
      944           buf_clients.obj-type = 'чел':U
      945       and buf_clients.obj-code = X_icnt-doc.boss no-error.
      946       if available buf_clients  then  DO:
      947         boss-name = buf_clients.obj-name.
      948       END.
      949       else do:
      950         boss-name = ?.
      951       END.
      952       find FIRST buf_clients NO-LOCK where
      953                buf_clients.obj-type = 'чел':U
      954             and buf_clients.obj-code = X_icnt-doc.agnt no-error.
      955       if available buf_clients then do:
      956           agnt-name = buf_clients.obj-name.
      957        end.
      958       else do:
      959           agnt-name = ?.
      960       END.
      961       find FIRST buf_clients NO-LOCK where
      962                 buf_clients.obj-type = 'чел':U
      963              and buf_clients.obj-code = X_icnt-doc.wrkr no-error.
      964       if available buf_clients then do:
      965           wrkr-name = buf_clients.obj-name.
      966       end.
      967       else do:
      968           wrkr-name = ?.
      969       END.
      970       find FIRST buf_clients NO-LOCK where
      971                 buf_clients.obj-type = X_icnt-doc.obj-type
      972             and buf_clients.obj-code = X_icnt-doc.obj-code no-error.
      973       if available buf_clients then do:
      974          obj-name  = buf_clients.obj-name.
      975       end.
      976       else do:
      977           obj-name = ?.
      978       END.
      979       ASSIGN ed-notes = X_icnt-doc.PS.
      980       DISPLAY
      981       ed-notes
      982       obj-name
      983       boss-name
      984       agnt-name
      985       wrkr-name
      986       X_icnt-doc.creid
      987       with frame Dialog-Frame.
      988     end.
      989   END.
      990   ON ENTRY OF ED-notes IN FRAME Dialog-Frame
      991   DO:
      992   if not available X_icnt-doc then RETURN NO-APPLY.
      993   assign
      994   v-icnt-rec = recid (X_icnt-doc).
      995   if X_icnt-doc.status_ <> 'факт':U
      996   and substring (X_icnt-doc.PS, 1, 1) = "@" THEN DO:
      997     message
      998     "Чтобы программа не могла заново переписать Ваше примечание, удалите знак @."
      999     VIEW-AS ALERT-BOX .
     1000   END.
     1001   END.
     1002   ON LEAVE OF ED-notes IN FRAME Dialog-Frame
     1003   DO:
     1004   define buffer buf_icnt-doc for ub.icnt-doc.
     1005   do on stop  undo, return no-apply
     1006      on error undo, return no-apply :
     1007     find first buf_icnt-doc where
     1008          recid (buf_icnt-doc) = v-icnt-rec exclusive .
     1009     buf_icnt-doc.PS = input frame Dialog-Frame ed-notes.
     1010   end.
     1011   END.
     1012   ON RETURN OF ED-notes IN FRAME Dialog-Frame
     1013   or MOUSE-SELECT-DBLCLICK OF ed-notes IN FRAME Dialog-Frame DO:
     1014     apply "entry" to BR-i-docs in frame Dialog-Frame.
     1015   return no-apply.
     1016   END.
     1017   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1018   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1019   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1020   on help of frame Dialog-Frame
     1021   do:
     1022     run gbl/app_help.p
     1023       (input this-procedure :file-name
     1024       ,input ''
     1025       ,input ?
     1026       ) no-error.
     1027     if error-status :error then do:
     1028       message
     1029         "Ошибка при вызове помощи"
     1030         error-status :get-message(1)
     1031         view-as alert-box .
     1032     end.
     1033   end.
     1034   run minbtn-set in this-procedure .
     1035   on choose of b-help in frame Dialog-Frame
     1036   do:
     1037     apply "help":u to frame Dialog-Frame .
     1038   end.
     1039   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1040   procedure minbtn-set :
     1041       do
     1042           on error undo, return error return-value
     1043           :
     1044           define variable ii              as integer       no-undo .
     1045           define variable fh              as widget-handle no-undo .
     1046           define variable hh              as widget-handle no-undo .
     1047           define variable v-h             as handle        extent 4 no-undo .
     1048           define variable v-name-button   as character     no-undo .
     1049           define variable v-help-old-x    as decimal       no-undo .
     1050           define variable v-help-old-y    as decimal       no-undo .
     1051           define variable v-help-old-size as decimal       no-undo .
     1052           define variable v-frame-width   as decimal       no-undo .
     1053           define variable jj              as integer       no-undo .
     1054           do
     1055               on error undo, return error
     1056               :
     1057               assign
     1058                   v-frame-width = frame Dialog-Frame:width - 0.3
     1059                   fh            = frame Dialog-Frame:first-child
     1060                   hh            = fh:first-child
     1061                   ii            = 1
     1062                   .
     1063               do while valid-handle(hh):
     1064                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1065                   do:
     1066                       case lc(hh:name) :
     1067                           when "b-help" then
     1068                               do:
     1069                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1070                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1071                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1072                                   hh:TOOLTIP = "Помощь" .
     1073                                   v-help-old-x = hh:column .
     1074                                   v-help-old-y = hh:row    .
     1075                                   v-help-old-size = hh:width .
     1076                                   hh:width-chars = 2.5 .
     1077                               end.
     1078                           when "b-print" then
     1079                               do:
     1080                                   hh:load-image("cmp/b-print.bmp":u) .
     1081                                   hh:TOOLTIP = "Печать" .
     1082                                   v-h[ii] = hh:handle .
     1083                                   ii = ii + 1 .
     1084                                   hh:width-chars = 3 .
     1085                               end.
     1086                           when "b-history" or
     1087                           when "b-hist" then
     1088                               do:
     1089                                   hh:load-image("cmp/b-hist.bmp":u) .
     1090                                   hh:TOOLTIP = "История" .
     1091                                   v-h[ii] = hh:handle .
     1092                                   ii = ii + 1 .
     1093                                   hh:width-chars = 3 .
     1094                               end.
     1095                           when "b-sch" then
     1096                               do:
     1097                                   hh:load-image("cmp/b-sch.bmp":u) .
     1098                                   hh:TOOLTIP = "Установка Фильтра" .
     1099                                   v-h[ii] = hh:handle .
     1100                                   ii = ii + 1 .
     1101                                   hh:width-chars = 3 .
     1102                               end.
     1103                           when "b-hist-user" then
     1104                               do:
     1105                                   hh:load-image("cmp/b-hist.bmp":u) .
     1106                                   hh:TOOLTIP = "История пользователя" .
     1107                                   ii = ii + 1 .
     1108                               end.
     1109                       end case.
     1110                   end.
     1111                   hh = hh:next-sibling.
     1112               end.
     1113               b-help:column = v-frame-width - b-help:width-chars.
     1114               jj = 0.
     1115               repeat ii = 4 to 1 by -1 :
     1116                   if valid-handle (v-h[ii] ) then
     1117                   do:
     1118                       jj  = jj + 1 .
     1119                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1120                       v-h[ii]:row    = v-help-old-y .
     1121                   end.
     1122               end.
     1123           end.
     1124       end.
     1125   end procedure.
     1126   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1127   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1128   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1129   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1130   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1131   define variable v-diasize-current-frame-height as decimal   no-undo .
     1132   define variable v-diasize-change-size          as logical   no-undo .
     1133   define variable v-diasize-resize-button        as handle    no-undo .
     1134   define variable v-diasize-wndmax               as logical   no-undo .
     1135   define variable v-diasize-wndstore             as logical   no-undo .
     1136   define variable v-diasize-proc-name            as character no-undo .
     1137   define variable v-diasize-browse-handle        as handle    no-undo .
     1138   define variable v-diasize-browse-number        as integer   no-undo .
     1139   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1140   define temp-table temp-diasize-handle no-undo
     1141     field handle-value  as handle
     1142     field save-position as decimal
     1143     index xpk is primary unique handle-value
     1144     .
     1145   define temp-table temp-browse-handle no-undo
     1146     field browse-type   as character
     1147     field browse-number as integer
     1148     field browse-handle as handle
     1149     field original-size as decimal
     1150     index xpk is primary unique browse-type browse-number
     1151     index xie browse-type browse-handle
     1152   .
     1153   procedure diasize_change-height :
     1154     define input  parameter p-change-value  as decimal   no-undo .
     1155     define input  parameter p-move-resize   as logical   no-undo .
     1156     define variable v-field-group-handle    as handle    no-undo .
     1157     define variable v-object-handle         as handle    no-undo .
     1158     define variable v-frame-height          as decimal   no-undo .
     1159     define variable v-frame-virtual-height  as decimal   no-undo .
     1160     define variable v-browse-height         as decimal   no-undo .
     1161     define variable v-window-height         as decimal   no-undo .
     1162     define variable v-window-virtual-height as decimal   no-undo .
     1163     define variable v-change-sign           as integer   no-undo .
     1164     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1165     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1166     if p-change-value > 0
     1167     then do:
     1168       if frame Dialog-Frame :height + p-change-value
     1169           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1170       then do:
     1171         assign
     1172           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1173                           - (frame Dialog-Frame :height-chars)
     1174         .
     1175         if p-change-value <= 0
     1176         then do:
     1177           run diasize_position-resize-button in this-procedure .
     1178           return .
     1179         end.
     1180       end.
     1181     end.
     1182     if p-change-value < 0
     1183     then do:
     1184       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1185       then do:
     1186         assign
     1187           p-change-value = v-diasize-orig-frame-height
     1188                          - (frame Dialog-Frame :height-chars)
     1189         .
     1190         if p-change-value >= 0
     1191         then do:
     1192           run diasize_position-resize-button in this-procedure .
     1193           return .
     1194         end.
     1195       end.
     1196     end.
     1197     if p-change-value >= 0
     1198     then do:
     1199       assign
     1200         v-change-sign = 1
     1201       .
     1202     end.
     1203     else do:
     1204       assign
     1205         v-change-sign = -1
     1206       .
     1207     end.
     1208     assign
     1209       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1210     .
     1211     if p-change-value = 0
     1212     then do:
     1213       run diasize_position-resize-button in this-procedure .
     1214       return .
     1215     end.
     1216     move_block:
     1217     do
     1218     on error undo move_block, retry move_block
     1219     :
     1220       if retry
     1221       then do:
     1222         do
     1223         on error undo move_block, leave move_block
     1224         :
     1225           if p-change-value > 0
     1226           then do:
     1227             for each buf_temp-diasize-handle
     1228             on error undo, next
     1229             :
     1230               assign
     1231                 v-object-handle = buf_temp-diasize-handle.handle-value
     1232               .
     1233               if v-object-handle <> v-diasize-resize-button
     1234               then do:
     1235                 assign
     1236                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1237                 .
     1238               end.
     1239             end.
     1240             assign
     1241               v-diasize-browse-handle :height = v-browse-height
     1242             .
     1243             for each buf_temp-browse-handle
     1244               where buf_temp-browse-handle.browse-type = 'height':u
     1245             on error undo, next
     1246             :
     1247               assign
     1248                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1249               .
     1250             end.
     1251             assign
     1252               frame Dialog-Frame :height = v-frame-height
     1253             .
     1254             if frame Dialog-Frame :scrollable = true
     1255             then do:
     1256               assign
     1257                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1258               .
     1259             end.
     1260             run diasize_position-resize-button in this-procedure .
     1261           end.
     1262           else do:
     1263             if frame Dialog-Frame :scrollable = true
     1264             then do:
     1265               assign
     1266                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1267               .
     1268             end.
     1269             assign
     1270               frame Dialog-Frame :height = v-frame-height
     1271             .
     1272             assign
     1273               v-diasize-browse-handle :height = v-browse-height
     1274             .
     1275             for each buf_temp-browse-handle
     1276               where buf_temp-browse-handle.browse-type = 'height':u
     1277             on error undo, next
     1278             :
     1279               assign
     1280                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1281               .
     1282             end.
     1283             for each buf_temp-diasize-handle
     1284             on error undo, next
     1285             :
     1286               assign
     1287                 v-object-handle = buf_temp-diasize-handle.handle-value
     1288               .
     1289               if v-object-handle <> v-diasize-resize-button
     1290               then do:
     1291                 assign
     1292                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1293                 .
     1294               end.
     1295             end.
     1296             run diasize_position-resize-button in this-procedure .
     1297           end.
     1298           assign
     1299             v-diasize-change-size = false
     1300           .
     1301           leave move_block .
     1302         end.
     1303       end.
     1304       assign
     1305         v-diasize-need-full-display = true
     1306       .
     1307       if v-diasize-change-size = false
     1308       then do:
     1309         assign
     1310           v-diasize-change-size = true
     1311         .
     1312       end.
     1313       else do:
     1314         return .
     1315       end.
     1316       assign
     1317         v-frame-height = frame Dialog-Frame :height
     1318         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1319         v-browse-height = v-diasize-browse-handle :height
     1320       .
     1321       for each buf_temp-browse-handle
     1322         where buf_temp-browse-handle.browse-type = 'height':u
     1323       :
     1324         assign
     1325           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1326         .
     1327       end.
     1328       for each buf_temp-diasize-handle
     1329       :
     1330         delete buf_temp-diasize-handle .
     1331       end.
     1332       assign
     1333         v-field-group-handle = frame Dialog-Frame :first-child
     1334       .
     1335       do while valid-handle(v-field-group-handle)
     1336       :
     1337         assign
     1338           v-object-handle = v-field-group-handle :first-child
     1339         .
     1340         do while valid-handle(v-object-handle)
     1341         :
     1342           if  v-object-handle <> v-diasize-browse-handle :handle
     1343           and can-query(v-object-handle, "row")
     1344           and can-query(v-object-handle, "height")
     1345           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1346           then do:
     1347             find first buf_temp-browse-handle
     1348               where buf_temp-browse-handle.browse-type   = 'height':u
     1349                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1350               no-error .
     1351             if available buf_temp-browse-handle
     1352             then do:
     1353             end.
     1354             else do:
     1355               create buf_temp-diasize-handle .
     1356               assign
     1357                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1358                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1359               .
     1360             end.
     1361           end.
     1362           assign
     1363             v-object-handle = v-object-handle :next-sibling
     1364           .
     1365         end.
     1366         assign
     1367           v-field-group-handle = v-field-group-handle :next-sibling
     1368         .
     1369       end.
     1370       do with frame Dialog-Frame
     1371       :
     1372         hide v-diasize-resize-button .
     1373         assign
     1374           v-diasize-resize-button :row    = 1
     1375           v-diasize-resize-button :column = 1
     1376         .
     1377       end.
     1378       if p-change-value > 0
     1379       then do:
     1380         if frame Dialog-Frame :scrollable = true
     1381         then do:
     1382           assign
     1383             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1384             no-error .
     1385           if error-status :error
     1386           or error-status :get-message(1) <> ""
     1387           then do:
     1388             undo move_block, retry move_block .
     1389           end.
     1390         end.
     1391         assign
     1392           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1393           no-error .
     1394         if error-status :error
     1395         or error-status :get-message(1) <> ""
     1396         then do:
     1397           undo move_block, retry move_block .
     1398         end.
     1399         assign
     1400           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1401           no-error .
     1402         if error-status :error
     1403         or error-status :get-message(1) <> ""
     1404         then do:
     1405           undo move_block, retry move_block .
     1406         end.
     1407         for each buf_temp-browse-handle
     1408           where buf_temp-browse-handle.browse-type = 'height':u
     1409         on error undo move_block, retry move_block
     1410         :
     1411           assign
     1412             buf_temp-browse-handle.browse-handle :height
     1413               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1414             no-error .
     1415           if error-status :error
     1416           or error-status :get-message(1) <> ""
     1417           then do:
     1418             undo move_block, retry move_block .
     1419           end.
     1420         end.
     1421         for each buf_temp-diasize-handle
     1422         on error undo move_block, retry move_block
     1423         :
     1424           assign
     1425             v-object-handle = buf_temp-diasize-handle.handle-value
     1426           .
     1427           if v-object-handle <> v-diasize-resize-button
     1428           then do:
     1429             assign
     1430               v-object-handle :row = v-object-handle :row + p-change-value
     1431               no-error .
     1432             if error-status :error
     1433             or error-status :get-message(1) <> ""
     1434             then do:
     1435               undo move_block, retry move_block .
     1436             end.
     1437           end.
     1438         end.
     1439       end.
     1440       else do:
     1441         for each buf_temp-diasize-handle
     1442         on error undo move_block, retry move_block
     1443         :
     1444           assign
     1445             v-object-handle = buf_temp-diasize-handle.handle-value
     1446           .
     1447           if v-object-handle <> v-diasize-resize-button
     1448           then do:
     1449             assign
     1450               v-object-handle :row = v-object-handle :row + p-change-value
     1451               no-error .
     1452             if error-status :error
     1453             or error-status :get-message(1) <> ""
     1454             then do:
     1455               undo move_block, retry move_block .
     1456             end.
     1457           end.
     1458         end.
     1459         assign
     1460           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1461           no-error .
     1462         if error-status :error
     1463         or error-status :get-message(1) <> ""
     1464         then do:
     1465           undo move_block, retry move_block .
     1466         end.
     1467         for each buf_temp-browse-handle
     1468           where buf_temp-browse-handle.browse-type = 'height':u
     1469         on error undo move_block, retry move_block
     1470         :
     1471           assign
     1472             buf_temp-browse-handle.browse-handle :height
     1473               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1474             no-error .
     1475           if error-status :error
     1476           or error-status :get-message(1) <> ""
     1477           then do:
     1478             undo move_block, retry move_block .
     1479           end.
     1480         end.
     1481         assign
     1482           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1483           no-error .
     1484         if error-status :error
     1485         or error-status :get-message(1) <> ""
     1486         then do:
     1487           undo move_block, retry move_block .
     1488         end.
     1489         if frame Dialog-Frame :scrollable = true
     1490         then do:
     1491           assign
     1492             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1493             no-error .
     1494           if error-status :error
     1495           or error-status :get-message(1) <> ""
     1496           then do:
     1497             undo move_block, retry move_block .
     1498           end.
     1499         end.
     1500       end.
     1501       if p-move-resize = true
     1502       then do:
     1503         run diasize_position-resize-button in this-procedure .
     1504       end.
     1505       if v-diasize-wndstore = true
     1506       then do:
     1507         if connected("ub") = true
     1508         then do:
     1509           define variable v-cntxt-db-num        as integer   no-undo .
     1510           define variable v-cntxt-userid        as character no-undo .
     1511           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1512                                             , OUTPUT v-cntxt-userid
     1513                                             ) .
     1514           run gbl/wndsizew.p
     1515             (input  v-cntxt-db-num
     1516             ,input  v-cntxt-userid
     1517             ,input  v-diasize-proc-name
     1518             ,input  'height':u
     1519             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1520             ) .
     1521         end.
     1522       end.
     1523     end.
     1524     assign
     1525       v-diasize-change-size = false
     1526     .
     1527   end procedure.
     1528   procedure diasize_set-height :
     1529     define input  parameter p-new-height  as decimal   no-undo .
     1530     define input  parameter p-move-resize as logical   no-undo .
     1531     do
     1532     on error undo, return error return-value
     1533     :
     1534       run diasize_change-height in this-procedure
     1535         (input  (p-new-height - frame Dialog-Frame :height)
     1536         ,input  p-move-resize
     1537         ) .
     1538     end.
     1539   end procedure.
     1540   procedure diasize_change-width :
     1541     define input  parameter p-change-value as decimal   no-undo .
     1542     define input  parameter p-move-resize  as logical   no-undo .
     1543     define variable v-field-group-handle   as handle    no-undo .
     1544     define variable v-object-handle        as handle    no-undo .
     1545     define variable v-frame-width          as decimal   no-undo .
     1546     define variable v-frame-virtual-width  as decimal   no-undo .
     1547     define variable v-browse-width         as decimal   no-undo .
     1548     define variable v-window-width         as decimal   no-undo .
     1549     define variable v-window-virtual-width as decimal   no-undo .
     1550     define variable v-change-sign          as integer   no-undo .
     1551     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1552     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1553     if p-change-value > 0
     1554     then do:
     1555       if frame Dialog-Frame :width + p-change-value >
     1556           session :width-chars
     1557       then do:
     1558         assign
     1559           p-change-value = session :width-chars - frame Dialog-Frame :width
     1560         .
     1561         if p-change-value <= 0
     1562         then do:
     1563           run diasize_position-resize-button in this-procedure .
     1564           return .
     1565         end.
     1566       end.
     1567     end.
     1568     if p-change-value < 0
     1569     then do:
     1570       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1571       then do:
     1572         assign
     1573           p-change-value = v-diasize-orig-frame-width
     1574                          - frame Dialog-Frame :width
     1575         .
     1576         if p-change-value >= 0
     1577         then do:
     1578           run diasize_position-resize-button in this-procedure .
     1579           return .
     1580         end.
     1581       end.
     1582     end.
     1583     if p-change-value >= 0
     1584     then do:
     1585       assign
     1586         v-change-sign = 1
     1587       .
     1588     end.
     1589     else do:
     1590       assign
     1591         v-change-sign = -1
     1592       .
     1593     end.
     1594     assign
     1595       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1596     .
     1597     if p-change-value = 0
     1598     then do:
     1599       run diasize_position-resize-button in this-procedure .
     1600       return .
     1601     end.
     1602     move_block:
     1603     do
     1604     on error undo move_block, leave move_block
     1605     :
     1606       if retry
     1607       then do:
     1608         do
     1609         on error undo move_block, leave move_block
     1610         :
     1611           if p-change-value > 0
     1612           then do:
     1613             for each buf_temp-diasize-handle
     1614             on error undo, next
     1615             :
     1616               assign
     1617                 v-object-handle = buf_temp-diasize-handle.handle-value
     1618               .
     1619               if v-object-handle <> v-diasize-resize-button
     1620               then do:
     1621                 assign
     1622                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1623                 .
     1624               end.
     1625             end.
     1626             assign
     1627               v-diasize-browse-handle :width = v-browse-width
     1628             .
     1629             for each buf_temp-browse-handle
     1630               where buf_temp-browse-handle.browse-type = 'width':u
     1631             on error undo, next
     1632             :
     1633               assign
     1634                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1635               .
     1636             end.
     1637             assign
     1638               frame Dialog-Frame :width = v-frame-width
     1639             .
     1640             if frame Dialog-Frame :scrollable = true
     1641             then do:
     1642               assign
     1643                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1644               .
     1645             end.
     1646             run diasize_position-resize-button in this-procedure .
     1647           end.
     1648           else do:
     1649             if frame Dialog-Frame :scrollable = true
     1650             then do:
     1651               assign
     1652                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1653               .
     1654             end.
     1655             assign
     1656               frame Dialog-Frame :width = v-frame-width
     1657             .
     1658             for each buf_temp-browse-handle
     1659               where buf_temp-browse-handle.browse-type = 'width':u
     1660             on error undo, next
     1661             :
     1662               assign
     1663                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1664               .
     1665             end.
     1666             assign
     1667               v-diasize-browse-handle :width = v-browse-width
     1668             .
     1669             for each buf_temp-diasize-handle
     1670             on error undo, next
     1671             :
     1672               assign
     1673                 v-object-handle = buf_temp-diasize-handle.handle-value
     1674               .
     1675               if v-object-handle <> v-diasize-resize-button
     1676               then do:
     1677                 assign
     1678                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1679                 .
     1680               end.
     1681             end.
     1682             run diasize_position-resize-button in this-procedure .
     1683           end.
     1684           assign
     1685             v-diasize-change-size = false
     1686           .
     1687           leave move_block .
     1688         end.
     1689       end.
     1690       assign
     1691         v-diasize-need-full-display = true
     1692       .
     1693       if v-diasize-change-size = false
     1694       then do:
     1695         assign
     1696           v-diasize-change-size = true
     1697         .
     1698       end.
     1699       else do:
     1700         return .
     1701       end.
     1702       assign
     1703         v-frame-width = frame Dialog-Frame :width
     1704         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1705         v-browse-width = v-diasize-browse-handle :width
     1706       .
     1707       for each buf_temp-browse-handle
     1708         where buf_temp-browse-handle.browse-type = 'width':u
     1709       :
     1710         assign
     1711           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1712         .
     1713       end.
     1714       for each buf_temp-diasize-handle
     1715       :
     1716         delete buf_temp-diasize-handle .
     1717       end.
     1718       assign
     1719         v-field-group-handle = frame Dialog-Frame :first-child
     1720       .
     1721       do while valid-handle(v-field-group-handle)
     1722       :
     1723         assign
     1724           v-object-handle = v-field-group-handle :first-child
     1725         .
     1726         do while valid-handle(v-object-handle)
     1727         :
     1728           if  v-object-handle <> v-diasize-browse-handle :handle
     1729           and v-object-handle <> v-diasize-resize-button
     1730           and can-query(v-object-handle, "row")
     1731           and can-query(v-object-handle, "height")
     1732           and ( v-object-handle :col + v-object-handle :width
     1733                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1734               )
     1735           then do:
     1736             find first buf_temp-browse-handle
     1737               where buf_temp-browse-handle.browse-type   = 'width':u
     1738                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1739               no-error .
     1740             if available buf_temp-browse-handle
     1741             then do:
     1742             end.
     1743             else do:
     1744               create buf_temp-diasize-handle .
     1745               assign
     1746                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1747                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1748               .
     1749             end.
     1750           end.
     1751           assign
     1752             v-object-handle = v-object-handle :next-sibling
     1753           .
     1754         end.
     1755         assign
     1756           v-field-group-handle = v-field-group-handle :next-sibling
     1757         .
     1758       end.
     1759       do with frame Dialog-Frame
     1760       :
     1761         hide v-diasize-resize-button .
     1762         v-diasize-resize-button :row = 1.
     1763         v-diasize-resize-button :column = 1.
     1764       end.
     1765       if p-change-value > 0
     1766       then do:
     1767         if frame Dialog-Frame :scrollable = true
     1768         then do:
     1769           assign
     1770             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1771             no-error .
     1772           if error-status :error
     1773           or error-status :get-message(1) <> ""
     1774           then do:
     1775             undo move_block, retry move_block.
     1776           end.
     1777         end.
     1778         assign
     1779           frame Dialog-Frame :width = v-frame-width + p-change-value
     1780           no-error .
     1781         if error-status :error
     1782         or error-status :get-message(1) <> ""
     1783         then do:
     1784           undo move_block, retry move_block.
     1785         end.
     1786         assign
     1787           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1788         no-error .
     1789         if error-status :error
     1790         or error-status :get-message(1) <> ""
     1791         then do:
     1792           undo move_block, retry move_block.
     1793         end.
     1794         for each buf_temp-browse-handle
     1795           where buf_temp-browse-handle.browse-type = 'width':u
     1796         on error undo move_block, retry move_block
     1797         :
     1798           assign
     1799             buf_temp-browse-handle.browse-handle :width
     1800               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1801             no-error .
     1802           if error-status :error
     1803           or error-status :get-message(1) <> ""
     1804           then do:
     1805             undo move_block, retry move_block .
     1806           end.
     1807         end.
     1808         for each buf_temp-diasize-handle
     1809         on error undo move_block, retry move_block
     1810         :
     1811           assign
     1812             v-object-handle = buf_temp-diasize-handle.handle-value
     1813           .
     1814           if v-object-handle <> v-diasize-resize-button
     1815           then do:
     1816             assign
     1817               v-object-handle :col = v-object-handle :col + p-change-value
     1818               no-error .
     1819             if error-status :error
     1820             or error-status :get-message(1) <> ""
     1821             then do:
     1822               undo move_block, retry move_block .
     1823             end.
     1824           end.
     1825         end.
     1826       end.
     1827       else do:
     1828         for each buf_temp-diasize-handle
     1829         on error undo move_block, retry move_block
     1830         :
     1831           assign
     1832             v-object-handle = buf_temp-diasize-handle.handle-value
     1833           .
     1834           if v-object-handle <> v-diasize-resize-button
     1835           then do:
     1836             assign
     1837               v-object-handle :col = v-object-handle :col + p-change-value
     1838               no-error .
     1839             if error-status :error
     1840             or error-status :get-message(1) <> ""
     1841             then do:
     1842               undo move_block, retry move_block .
     1843             end.
     1844           end.
     1845         end.
     1846         for each buf_temp-browse-handle
     1847           where buf_temp-browse-handle.browse-type = 'width':u
     1848         on error undo move_block, retry move_block
     1849         :
     1850           assign
     1851             buf_temp-browse-handle.browse-handle :width
     1852               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1853             no-error .
     1854           if error-status :error
     1855           or error-status :get-message(1) <> ""
     1856           then do:
     1857             undo move_block, retry move_block .
     1858           end.
     1859         end.
     1860         assign
     1861           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1862           no-error .
     1863         if error-status :error
     1864         or error-status :get-message(1) <> ""
     1865         then do:
     1866           undo move_block, retry move_block.
     1867         end.
     1868         assign
     1869           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1870         no-error .
     1871         if error-status :error
     1872         or error-status :get-message(1) <> ""
     1873         then do:
     1874           undo move_block, retry move_block.
     1875         end.
     1876         if frame Dialog-Frame :scrollable = true
     1877         then do:
     1878           assign
     1879             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1880           no-error .
     1881           if error-status :error
     1882           or error-status :get-message(1) <> ""
     1883           then do:
     1884             undo move_block, retry move_block.
     1885           end.
     1886         end.
     1887       end.
     1888       if p-move-resize
     1889       then do:
     1890         run diasize_position-resize-button in this-procedure .
     1891       end.
     1892       if v-diasize-wndstore = true
     1893       then do:
     1894         if connected("ub") = true
     1895         then do:
     1896           define variable v-cntxt-db-num        as integer   no-undo .
     1897           define variable v-cntxt-userid        as character no-undo .
     1898           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1899                                             , OUTPUT v-cntxt-userid
     1900                                             ) .
     1901           run gbl/wndsizew.p
     1902             (input  v-cntxt-db-num
     1903             ,input  v-cntxt-userid
     1904             ,input  v-diasize-proc-name
     1905             ,input  'width':u
     1906             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1907             ) .
     1908         end.
     1909       end.
     1910     end.
     1911     assign
     1912       v-diasize-change-size = false
     1913     .
     1914   end procedure.
     1915   procedure diasize_set-width :
     1916     define input  parameter p-new-width  as decimal   no-undo .
     1917     define input  parameter p-move-resize as logical   no-undo .
     1918     do
     1919     on error undo, return error return-value
     1920     :
     1921       run diasize_change-width in this-procedure
     1922         (input  (p-new-width - frame Dialog-Frame :width)
     1923         ,input  p-move-resize
     1924         ) .
     1925     end.
     1926   end procedure.
     1927   procedure diasize_position-resize-button :
     1928     do with frame Dialog-Frame
     1929     :
     1930       hide v-diasize-resize-button .
     1931       assign
     1932         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1933                     - 1
     1934                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1935         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1936                     - 1
     1937                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1938       .
     1939       view v-diasize-resize-button .
     1940     end.
     1941   end procedure.
     1942   on alt-right anywhere
     1943   do:
     1944     run diasize_change-width in this-procedure
     1945       (input 1
     1946       ,input true
     1947       ) .
     1948     return no-apply .
     1949   end.
     1950   on alt-left anywhere
     1951   do:
     1952     run diasize_change-width in this-procedure
     1953       (input -1
     1954       ,input true
     1955       ) .
     1956     return no-apply .
     1957   end.
     1958   on alt-down anywhere
     1959   do:
     1960     run diasize_change-height in this-procedure
     1961       (input 1
     1962       ,input true
     1963       ) .
     1964     return no-apply .
     1965   end.
     1966   on alt-up anywhere
     1967   do:
     1968     run diasize_change-height in this-procedure
     1969       (input -1
     1970       ,input true
     1971       ) .
     1972     return no-apply .
     1973   end.
     1974   on alt-enter of frame Dialog-Frame
     1975   do:
     1976     run diasize_maximize in this-procedure
     1977       (input  ?
     1978       ).
     1979     return no-apply .
     1980   end.
     1981   procedure diasize_end-move :
     1982     do
     1983     on error undo, return error return-value
     1984     :
     1985       define variable v-row-delta as decimal   no-undo .
     1986       define variable v-col-delta as decimal   no-undo .
     1987       define variable v-new-row as decimal   no-undo .
     1988       define variable v-new-col as decimal   no-undo .
     1989       assign
     1990         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1991         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1992       .
     1993       assign
     1994         v-row-delta = v-new-row - frame Dialog-Frame :height
     1995         v-col-delta = v-new-col - frame Dialog-Frame :width
     1996       .
     1997       run diasize_change-height in this-procedure
     1998         (input v-row-delta
     1999         ,input true
     2000         ) .
     2001       run diasize_change-width in this-procedure
     2002         (input v-col-delta
     2003         ,input true
     2004         ) .
     2005     end.
     2006   end procedure.
     2007   procedure diasize_maximize :
     2008     define input  parameter p-action as logical   no-undo .
     2009     do
     2010     on error undo, return error return-value
     2011     :
     2012       if p-action = ?
     2013       then do:
     2014         if v-diasize-need-maximize = true
     2015         then do:
     2016           assign
     2017             p-action = true
     2018           .
     2019         end.
     2020         else do:
     2021           assign
     2022             p-action = false
     2023           .
     2024         end.
     2025       end.
     2026       if p-action = true
     2027       then do:
     2028         run diasize_change-height in this-procedure
     2029           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2030               - frame Dialog-Frame :height-chars
     2031           ,input true
     2032           ) .
     2033         run diasize_change-width in this-procedure
     2034           (input session :width-chars
     2035               - frame Dialog-Frame :width-chars
     2036           ,input true
     2037           ) .
     2038         assign
     2039           v-diasize-need-maximize = false
     2040         .
     2041       end.
     2042       else do:
     2043         run diasize_change-width in this-procedure
     2044           (input v-diasize-orig-frame-width
     2045               - frame Dialog-Frame :width-chars
     2046           ,input true
     2047           ) .
     2048         run diasize_change-height in this-procedure
     2049           (input v-diasize-orig-frame-height
     2050               - frame Dialog-Frame :height-chars
     2051           ,input true
     2052           ) .
     2053         assign
     2054           v-diasize-need-maximize = true
     2055         .
     2056       end.
     2057     end.
     2058   end procedure.
     2059   procedure diasize_restore-orig-size :
     2060     do
     2061     on error undo, return error return-value
     2062     :
     2063       assign
     2064         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2065         v-diasize-current-frame-height = frame Dialog-Frame :height
     2066       .
     2067       run diasize_set-height in this-procedure
     2068         (input  v-diasize-orig-frame-height
     2069         ,input  true
     2070         ) .
     2071       run diasize_set-width in this-procedure
     2072         (input  v-diasize-orig-frame-width
     2073         ,input  true
     2074         ) .
     2075     end.
     2076   end procedure.
     2077   procedure diasize_restore-current-size :
     2078     do
     2079     on error undo, return error return-value
     2080     :
     2081       run diasize_set-height in this-procedure
     2082         (input  v-diasize-current-frame-height
     2083         ,input  true
     2084         ) .
     2085       run diasize_set-width in this-procedure
     2086         (input  v-diasize-current-frame-width
     2087         ,input  true
     2088         ) .
     2089     end.
     2090   end procedure.
     2091   procedure diasize_set-browse-handle :
     2092     define input  parameter p-browse-handle as handle   no-undo .
     2093     define buffer buf_temp-browse-handle for temp-browse-handle .
     2094     do
     2095     on error undo, return error return-value
     2096     :
     2097       assign
     2098         v-diasize-browse-handle = p-browse-handle
     2099       .
     2100       for each buf_temp-browse-handle
     2101       on error undo, return error return-value
     2102       :
     2103         delete buf_temp-browse-handle .
     2104       end.
     2105     end.
     2106   end procedure.
     2107   procedure diasize_add_browse :
     2108     define input  parameter p-browse-type   as character no-undo .
     2109     define input  parameter p-browse-handle as handle    no-undo .
     2110     define buffer buf_temp-browse-handle for temp-browse-handle .
     2111     do
     2112     on error undo, return error return-value
     2113     :
     2114       assign
     2115         v-diasize-browse-number = v-diasize-browse-number + 1
     2116       .
     2117       create buf_temp-browse-handle .
     2118       assign
     2119         buf_temp-browse-handle.browse-type   = p-browse-type
     2120         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2121         buf_temp-browse-handle.browse-handle = p-browse-handle
     2122       .
     2123     end.
     2124   end procedure.
     2125   procedure diasize_init :
     2126     define variable v-default-value    as logical   no-undo .
     2127     define variable v-restore-saved    as logical   no-undo .
     2128     define variable v-resize-value-str as character no-undo .
     2129     do
     2130     on error undo, return error return-value
     2131     :
     2132       do with frame Dialog-Frame
     2133       :
     2134         assign
     2135           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2136           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2137           v-diasize-browse-handle     = browse BR-i-docs :handle
     2138         .
     2139         create button v-diasize-resize-button
     2140         assign
     2141           parent        = frame Dialog-Frame :first-child
     2142           label         = "s"
     2143           height-pixels = 16
     2144           width-pixels  = 16
     2145           visible       = true
     2146           sensitive     = true
     2147           movable       = true
     2148           triggers:
     2149             on end-move persistent run diasize_end-move in this-procedure .
     2150           end triggers.
     2151         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2152         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2153         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2154         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2155         assign
     2156           v-diasize-wndmax = false
     2157         .
     2158         if connected("ub") = true
     2159         then do:
     2160           define variable v-cntxt-db-num        as integer   no-undo .
     2161           define variable v-cntxt-userid        as character no-undo .
     2162           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2163                                             , OUTPUT v-cntxt-userid
     2164                                             ) .
     2165           run gbl/wndpar_r.p
     2166             (input  v-cntxt-db-num
     2167             ,input  v-cntxt-userid
     2168             ,input  'wndmax':U
     2169             ,output v-diasize-wndmax
     2170             ,output v-default-value
     2171             ) .
     2172         end.
     2173         assign
     2174           v-diasize-wndstore = false
     2175         .
     2176         if connected("ub") = true
     2177         then do:
     2178           run gbl/wndpar_r.p
     2179             (input  v-cntxt-db-num
     2180             ,input  v-cntxt-userid
     2181             ,input  'wndstore':U
     2182             ,output v-diasize-wndstore
     2183             ,output v-default-value
     2184             ) .
     2185         end.
     2186         assign
     2187           v-diasize-proc-name = entry(1, program-name(2), '.')
     2188         .
     2189         if v-diasize-wndstore = true
     2190         then do:
     2191           assign
     2192             v-restore-saved = false
     2193           .
     2194           if connected("ub") = true
     2195           then do:
     2196             run gbl/wndsizer.p
     2197               (input  v-cntxt-db-num
     2198               ,input  v-cntxt-userid
     2199               ,input  v-diasize-proc-name
     2200               ,input  'height':u
     2201               ,output v-resize-value-str
     2202               ) .
     2203             if v-resize-value-str <> '':U
     2204             then do:
     2205               run diasize_change-height in this-procedure
     2206                 (input  integer(v-resize-value-str)
     2207                 ,input  true
     2208                 ) .
     2209               assign
     2210                 v-restore-saved = true
     2211               .
     2212             end.
     2213           end.
     2214           if connected("ub") = true
     2215           then do:
     2216             run gbl/wndsizer.p
     2217               (input  v-cntxt-db-num
     2218               ,input  v-cntxt-userid
     2219               ,input  v-diasize-proc-name
     2220               ,input  'width':u
     2221               ,output v-resize-value-str
     2222               ) .
     2223             if v-resize-value-str <> '':U
     2224             then do:
     2225               run diasize_change-width in this-procedure
     2226                 (input  integer(v-resize-value-str)
     2227                 ,input  true
     2228                 ) .
     2229               assign
     2230                 v-restore-saved = true
     2231               .
     2232             end.
     2233           end.
     2234           if v-restore-saved <> true
     2235           then do:
     2236             if v-diasize-wndmax = true
     2237             then do:
     2238               run diasize_maximize in this-procedure
     2239                 (input  true
     2240                 ) .
     2241             end.
     2242           end.
     2243         end.
     2244         else do:
     2245           if v-diasize-wndmax = true
     2246           then do:
     2247             run diasize_maximize in this-procedure
     2248               (input  true
     2249               ) .
     2250           end.
     2251         end.
     2252       end.
     2253     end.
     2254   end procedure.
     2255   procedure diasize_need-full-display :
     2256     define output parameter p-need-full-display as logical   no-undo .
     2257     do
     2258     on error undo, return error return-value
     2259     :
     2260       assign
     2261         p-need-full-display = v-diasize-need-full-display
     2262       .
     2263       assign
     2264         v-diasize-need-full-display = false
     2265       .
     2266     end.
     2267   end procedure.
     2268   procedure get-context :
     2269      define output parameter p-db-num as integer          no-undo.
     2270      define output parameter p-user-id as character        no-undo.
     2271      define variable v-login               as character    no-undo.
     2272      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2273      define buffer buf_user-login  for ub.user-login .
     2274      do
     2275      on error undo, return error
     2276      :
     2277            FIND FIRST buf_sys-ctrl no-lock.
     2278            ASSIGN
     2279               v-login = USERID("ub")
     2280               p-db-num = buf_sys-ctrl.db-num
     2281            .
     2282            FIND FIRST buf_user-login
     2283                 WHERE buf_user-login.db-num = p-db-num
     2284                   AND buf_user-login.user-login = v-login
     2285                 no-lock
     2286                 no-error
     2287                 .
     2288            IF AVAILABLE buf_user-login
     2289            THEN DO:
     2290               assign
     2291                  p-user-id = buf_user-login.user-id
     2292               .
     2293            END.
     2294      end.
     2295   end procedure.
     2296       run diasize_init in this-procedure .
     2297   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2298   procedure set-filter-name :
     2299   define input parameter p-filter-name as character no-undo .
     2300     do with frame Dialog-Frame:
     2301       if p-filter-name > "" then do:
     2302         assign
     2303           frame Dialog-Frame:title
     2304             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2305         .
     2306         assign
     2307           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2308         .
     2309       end.
     2310       else do:
     2311         assign
     2312           b-sch :tooltip = ""
     2313         .
     2314       end.
     2315     end.
     2316   end procedure.
     2317   define variable vss-include-info17 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2318   on CTRL-P, CTRL-З of frame Dialog-Frame anywhere do:
     2319     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame Dialog-Frame. END.
     2320     return no-apply.
     2321   end.
     2322   define variable vss-include-info18 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2323   on F3 of frame Dialog-Frame anywhere do:
     2324     if b-lkp :sensitive then DO: apply "CHOOSE":U to b-lkp in frame Dialog-Frame. END.
     2325     return no-apply.
     2326   end.
     2327   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2328   on CTRL-N, CTRL-Т of frame Dialog-Frame anywhere do:
     2329     if b-add :sensitive then DO: apply "CHOOSE":U to b-add in frame Dialog-Frame. END.
     2330     return no-apply.
     2331   end.
     2332   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2333   on F4 of frame Dialog-Frame anywhere do:
     2334     if b-chg :sensitive then DO: apply "CHOOSE":U to b-chg in frame Dialog-Frame. END.
     2335     return no-apply.
     2336   end.
     2337   define variable vss-include-info21 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2338   on CTRL-F7 of frame Dialog-Frame anywhere do:
     2339     if b-close :sensitive then DO: apply "CHOOSE":U to b-close in frame Dialog-Frame. END.
     2340     return no-apply.
     2341   end.
     2342   define variable vss-include-info22 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2343   on F8 of frame Dialog-Frame anywhere do:
     2344     if b-del :sensitive then DO: apply "CHOOSE":U to b-del in frame Dialog-Frame. END.
     2345     return no-apply.
     2346   end.
     2347   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2348   on f5 of frame Dialog-Frame anywhere
     2349   do:
     2350      v-icnt-rec = ?. if available X_icnt-doc then v-icnt-rec = recid(X_icnt-doc).                run openbr in this-procedure ( input yes, input no, input '':U) no-error.                REPOSITION br-i-docs to recid v-icnt-rec No-ERROR.
     2351       apply "VALUE-CHANGED" to BR-i-docs.
     2352   end.
     2353   def var sort-labelBR-i-docs   as character no-undo .
     2354   def var sort-clmnBR-i-docs    as handle    no-undo .
     2355   def var cur-clmnBR-i-docs     as handle    no-undo .
     2356   def var cur-clmn-locBR-i-docs as integer   no-undo .
     2357   def var re-queryBR-i-docs     as logical   initial no no-undo .
     2358   on start-search, ctrl-o of BR-i-docs in frame Dialog-Frame do:
     2359      run sort-brBR-i-docs
     2360        (input (if available X_icnt-doc
     2361                then recid(X_icnt-doc)
     2362                else ?
     2363               )
     2364        ).
     2365   end.
     2366   PROCEDURE sort-brBR-i-docs :
     2367     define input parameter p-recid as recid no-undo .
     2368     if re-queryBR-i-docs = no then do:
     2369       assign
     2370          cur-clmnBR-i-docs = BR-i-docs:current-column in frame Dialog-Frame
     2371       .
     2372       if sort-clmnBR-i-docs <> ? then sort-clmnBR-i-docs:column-fgcolor = 0.
     2373       if cur-clmnBR-i-docs = sort-clmnBR-i-docs then do:
     2374         assign
     2375            sort-labelBR-i-docs = ""
     2376            sort-clmnBR-i-docs = ?
     2377         .
     2378        end.
     2379        else do:
     2380          assign
     2381            sort-labelBR-i-docs = cur-clmnBR-i-docs:label
     2382            sort-clmnBR-i-docs  = cur-clmnBR-i-docs
     2383            sort-clmnBR-i-docs:column-fgcolor = 4
     2384          .
     2385        end.
     2386      end.
     2387     assign
     2388       cur-clmn-locBR-i-docs = 1
     2389     .
     2390     def var column-handle as handle no-undo .
     2391     column-handle = BR-i-docs:first-column.
     2392     do while valid-handle(column-handle) :
     2393       if column-handle = cur-clmnBR-i-docs then do:
     2394         leave .
     2395       end.
     2396       column-handle = column-handle:NEXT-COLUMN.
     2397       assign
     2398         cur-clmn-locBR-i-docs = cur-clmn-locBR-i-docs + 1
     2399       .
     2400     end.
     2401     case sort-labelBR-i-docs:
     2402           when 'Статус'  then DO:    assign       sort-column-name = "X_icnt-doc.status_"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     2403           when 'Документ'  then DO:    assign       sort-column-name = "X_icnt-doc.doc-code"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     2404           when 'Дата'  then DO:    assign       sort-column-name = "X_icnt-doc.doc-date"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     2405           when 'Факт'  then DO:    assign       sort-column-name = "X_icnt-doc.fact-date"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     2406           when 'Время'  then DO:    assign       sort-column-name = "string(X_icnt-doc.fact-time, 'HH:MM:SS')"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     2407           when 'Смена'  then DO:    assign       sort-column-name = "X_icnt-doc.shift-date"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     2408           when '№'  then DO:    assign       sort-column-name = "shift-name (buffer X_icnt-doc)"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     2409           when 'Объект'  then DO:    assign       sort-column-name = "(X_icnt-doc.obj-type + STRING(X_icnt-doc.obj-code))"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     2410           when 'Количество!по счетчику'  then DO:    assign       sort-column-name = "X_icnt-doc.state-el-cnt"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     2411           when 'Количество!по мернику'  then DO:    assign       sort-column-name = "X_icnt-doc.state-mh-cnt"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     2412           when 'Разница'  then DO:    assign       sort-column-name = "(X_icnt-doc.state-el-cnt - X_icnt-doc.state-mh-cnt)"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     2413           when 'Измерения!электронных!счетчиков'  then DO:    assign       sort-column-name = "X_icnt-doc.meas-el-cnt"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     2414       otherwise do:
     2415         assign
     2416           sort-column-name = ""
     2417         .
     2418         run OpenBr in this-procedure ( input yes, input no, input '':U).
     2419           if can-do( this-procedure:internal-entries, 'mv-brw-defaultBR-i-docs') then do:
     2420             run mv-brw-defaultBR-i-docs.
     2421           end.
     2422         if sort-labelBR-i-docs <> "" then do:
     2423           assign
     2424             cur-clmnBR-i-docs:column-fgcolor = 0
     2425           .
     2426         end.
     2427         assign
     2428           cur-clmn-locBR-i-docs = ?
     2429         .
     2430       end.
     2431     end case.
     2432       if cur-clmn-locBR-i-docs <> ? then do:
     2433         if can-do( this-procedure:internal-entries, 'ch-clmnBR-i-docs') then do:
     2434           run ch-clmnBR-i-docs in this-procedure (cur-clmn-locBR-i-docs).
     2435         end.
     2436       end.
     2437     if p-recid <> ? then do:
     2438       reposition BR-i-docs to recid p-recid no-error.
     2439       apply "value-changed" to BR-i-docs in frame Dialog-Frame.
     2440     end.
     2441     apply "entry" to BR-i-docs in frame Dialog-Frame.
     2442   END PROCEDURE.
     2443   procedure re-open-query-srt-clmnBR-i-docs:
     2444   if cur-clmnBR-i-docs = ? then do:
     2445      run OpenBr in this-procedure ( input yes, input no, input '':U).
     2446   end.
     2447   else do:
     2448      assign re-queryBR-i-docs = yes.
     2449      run sort-brBR-i-docs
     2450        (input (if available X_icnt-doc
     2451                then recid(X_icnt-doc)
     2452                else ?
     2453               )
     2454        ).
     2455      assign re-queryBR-i-docs = no.
     2456   end.
     2457   end.
     2458   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2459   DEF VAR cur-clmn-numBR-i-docs as INT EXTENT 13 no-undo.
     2460   DEF VAR varmviBR-i-docs       as INT no-undo.
     2461   DEF VAR varmvjBR-i-docs       as INT no-undo.
     2462   DEF VAR varmvkBR-i-docs       as INT no-undo.
     2463   DEF VAR varmvlBR-i-docs       as INT no-undo.
     2464   DEF VAR move-elementBR-i-docs as INT no-undo.
     2465   def var jjBR-i-docs           as int no-undo.
     2466   do varmviBR-i-docs = 1 to EXTENT(cur-clmn-numBR-i-docs):
     2467     ASSIGN cur-clmn-numBR-i-docs[varmviBR-i-docs] = varmviBR-i-docs.
     2468   END.
     2469   RUN start-mv-clmnBR-i-docs.
     2470   PROCEDURE start-mv-clmnBR-i-docs:
     2471   def var old-session as logical no-undo.
     2472      old-session = SESSION:IMMEDIATE-DISPLAY.
     2473      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2474      SESSION:IMMEDIATE-DISPLAY = old-session.
     2475   END.
     2476   ON ctrl-cursor-right OF BROWSE BR-i-docs do:
     2477     RUN re-move-clmnBR-i-docs ( 4, 13).
     2478   END.
     2479   ON ctrl-cursor-left OF BROWSE BR-i-docs do:
     2480     RUN re-move-clmnBR-i-docs (13, 4).
     2481   END.
     2482   PROCEDURE re-move-clmnBR-i-docs:
     2483     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2484     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2485     DO varmviBR-i-docs = 1 TO EXTENT(cur-clmn-numBR-i-docs):
     2486       if cur-clmn-numBR-i-docs[varmviBR-i-docs] = source-column THEN cur-clmn-numBR-i-docs[varmviBR-i-docs] = -1.
     2487     END.
     2488     if BR-i-docs:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     2489     if source-column > target-column THEN
     2490     DO varmvjBR-i-docs = source-column - 1 to target-column BY -1:
     2491       DO varmviBR-i-docs = 1 TO EXTENT(cur-clmn-numBR-i-docs):
     2492           if cur-clmn-numBR-i-docs[varmviBR-i-docs] = varmvjBR-i-docs THEN DO:
     2493             cur-clmn-numBR-i-docs[varmviBR-i-docs] = cur-clmn-numBR-i-docs[varmviBR-i-docs] + 1.
     2494           END.
     2495       END.
     2496     END.
     2497     ELSE
     2498     DO varmvjBR-i-docs = source-column + 1 to target-column:
     2499       DO varmviBR-i-docs = 1 TO EXTENT(cur-clmn-numBR-i-docs):
     2500         if cur-clmn-numBR-i-docs[varmviBR-i-docs] = varmvjBR-i-docs THEN DO:
     2501           cur-clmn-numBR-i-docs[varmviBR-i-docs] = cur-clmn-numBR-i-docs[varmviBR-i-docs] - 1.
     2502         END.
     2503       END.
     2504     END.
     2505     DO varmviBR-i-docs = 1 TO EXTENT(cur-clmn-numBR-i-docs):
     2506       if cur-clmn-numBR-i-docs[varmviBR-i-docs] = -1 THEN cur-clmn-numBR-i-docs[varmviBR-i-docs] = target-column.
     2507     END.
     2508   END PROCEDURE.
     2509   PROCEDURE ch-clmnBR-i-docs:
     2510     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2511     if cur-clmn-loc <= 4 then do:
     2512       return .
     2513     end.
     2514     DO varmviBR-i-docs = 1 TO EXTENT(cur-clmn-numBR-i-docs):
     2515       if cur-clmn-numBR-i-docs[varmviBR-i-docs] = cur-clmn-loc THEN move-elementBR-i-docs = varmviBR-i-docs.
     2516     END.
     2517     RUN re-move-clmnBR-i-docs (cur-clmn-loc, 4).
     2518   END PROCEDURE.
     2519   PROCEDURE mv-brw-defaultBR-i-docs:
     2520   def var old-session as logical no-undo.
     2521     old-session = SESSION:IMMEDIATE-DISPLAY.
     2522     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2523     do varmvlBR-i-docs = 4 to EXTENT(cur-clmn-numBR-i-docs):
     2524       RUN re-move-clmnBR-i-docs (cur-clmn-numBR-i-docs[varmvlBR-i-docs], varmvlBR-i-docs).
     2525     END.
     2526     RUN start-mv-clmnBR-i-docs.
     2527     SESSION:IMMEDIATE-DISPLAY = old-session.
     2528   END PROCEDURE.
     2529   .
     2530   MAIN-BLOCK:
     2531   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2532      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2533   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2534     run mainmenu_getcntxt in parparentproc
     2535       (output v-cntxt-db-num
     2536       ,output v-cntxt-userid
     2537       ,output v-cntxt-level
     2538       ,output v-cntxt-host-code-obj
     2539       ,output v-cntxt-obj-type
     2540       ,output v-cntxt-obj-code
     2541       ,output v-cntxt-db-num-obj
     2542       ,output v-cntxt-is-admin
     2543       ) .
     2544     IF lookup(p-list-mode, 'все':U + chr(4) +
     2545                            'объект':U + chr(4) +
     2546                            'статус':U + chr(4) +
     2547                            'фирма':U, chr(4) ) = 0 THEN DO:
     2548       MESSAGE
     2549       substitute("Неверное значение параметра p-list-mode=&1", p-list-mode)
     2550       VIEW-AS ALERT-BOX error.
     2551       undo, RETURN ERROR.
     2552     END.
     2553     if p-list-mode = 'объект':U
     2554     or p-list-mode = 'статус':U then do:
     2555       find first buf_clients no-lock where
     2556                 buf_clients.obj-type = p-obj-type
     2557             and buf_clients.obj-code = p-obj-code no-error.
     2558       if not available buf_clients
     2559       or not (buf_clients.obj-type = 'маг':U)
     2560       then do:
     2561         MESSAGE
     2562         substitute("Неверное значение параметров p-obj-type=&1 и/или p-obj-code= &2"
     2563                  , p-obj-type
     2564                  , p-obj-code)
     2565         VIEW-AS ALERT-BOX error.
     2566         undo, RETURN ERROR.
     2567       end.
     2568     end.
     2569     if p-list-mode = 'фирма':U then do:
     2570       find first buf_sysconf no-lock where
     2571                 buf_sysconf.host-code = p-host-code no-error.
     2572      if not available buf_sysconf then do:
     2573         MESSAGE
     2574         substitute("Неверное значение параметра p-host-codee=&1"
     2575                  , p-host-code)
     2576         VIEW-AS ALERT-BOX error.
     2577         undo, RETURN ERROR.
     2578      end.
     2579     end.
     2580     IF LOOKUP(p-doc-type, 'инв-сч-трк,сч-трк-погр':U ) = 0 THEN DO:
     2581       MESSAGE
     2582       substitute("Неверное значение параметра p-doc-type=&1", p-doc-type)
     2583       VIEW-AS ALERT-BOX error.
     2584       undo, RETURN ERROR.
     2585     END.
     2586     v-rid-list = p-rid-list.
     2587     run Myenable IN THIS-PROCEDURE.
     2588     WAIT-FOR GO OF FRAME Dialog-Frame.
     2589   END.
     2590   RUN disable_UI.
     2591   PROCEDURE disable_UI :
     2592     HIDE FRAME Dialog-Frame.
     2593   END PROCEDURE.
     2594   PROCEDURE enable_UI :
     2595     OPEN QUERY Dialog-Frame FOR EACH X_icnt-doc SHARE-LOCK.
     2596     GET FIRST Dialog-Frame.
     2597     DISPLAY ED-notes mark-num obj-name boss-name agnt-name wrkr-name
     2598         WITH FRAME Dialog-Frame.
     2599     IF AVAILABLE X_icnt-doc THEN
     2600       DISPLAY X_icnt-doc.creid
     2601         WITH FRAME Dialog-Frame.
     2602     ENABLE b-quit B-mark B-sel b-add b-chg b-del b-lkp b-print b-sch B-Help
     2603            b-close BR-i-docs ED-notes mark-num obj-name boss-name agnt-name
     2604            wrkr-name X_icnt-doc.creid
     2605         WITH FRAME Dialog-Frame.
     2606     VIEW FRAME Dialog-Frame.
     2607   END PROCEDURE.
     2608   PROCEDURE MyEnable :
     2609   ASSIGN
     2610   br-i-docs:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame = 4
     2611   X_icnt-doc.meas-el-cnt:READ-ONLY in browse br-i-docs = YES
     2612   .
     2613   enable
     2614   b-quit
     2615   b-help
     2616   b-print
     2617   b-lkp
     2618   b-sch
     2619   b-sel WHEN lookup("b-sel", bttns) > 0
     2620   b-mark WHEN lookup("b-mark", bttns) > 0
     2621   b-add WHEN ((p-list-mode = 'объект':U
     2622               OR p-list-mode = 'статус':U)
     2623               AND v-cntxt-db-num = buf_clients.db-num
     2624               AND lookup("b-add", bttns) > 0 AND NOT TRANSACTION)
     2625   b-chg WHEN ((p-list-mode = 'объект':U
     2626               OR p-list-mode = 'статус':U)
     2627               AND v-cntxt-db-num = buf_clients.db-num
     2628               AND lookup("b-add", bttns) > 0 AND NOT TRANSACTION)
     2629   b-del WHEN ((p-list-mode = 'объект':U
     2630               OR p-list-mode = 'статус':U)
     2631               AND v-cntxt-db-num = buf_clients.db-num
     2632               AND lookup("b-add", bttns) > 0 AND NOT TRANSACTION)
     2633   b-close WHEN ((p-list-mode = 'объект':U
     2634               OR (p-list-mode = 'статус':U AND p-status_ <> 'факт':U)
     2635                 )
     2636               AND v-cntxt-db-num = buf_clients.db-num
     2637               AND lookup("b-add", bttns) > 0 AND NOT TRANSACTION)
     2638   br-i-docs
     2639   with frame Dialog-Frame.
     2640   run OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U).
     2641   apply "entry" to br-i-docs in frame Dialog-Frame.
     2642   apply "value-changed" to br-i-docs in frame Dialog-Frame.
     2643   END PROCEDURE.
     2644   PROCEDURE Openbr :
     2645   define input  parameter p-open-query     as logical   no-undo .
     2646   define input  parameter p-find-next      as logical   no-undo .
     2647   define input  parameter p-find-condition as character no-undo .
