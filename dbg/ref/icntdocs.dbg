     3557   PROCEDURE proc-b-add :
     3558   define variable v-icnt-line-rec as recid no-undo .
     3559   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     3560   define variable next-prev as character no-undo .
     3561   define variable v-host-code as integer no-undo .
     3562   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3563   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3564     (input  p-obj-type
     3565     ,input  p-obj-code
     3566     ,output v-host-code
     3567     )  .
     3568   define variable vss-include-info43 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3569   do:
     3570     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3571       (input  v-cntxt-db-num
     3572       ,input  v-cntxt-userid
     3573       ,input  0
     3574       ,input  'actn_icnt-doc_preparation':U
     3575       ,input  'object':U
     3576       ,input  v-host-code
     3577       ,input  p-obj-type
     3578       ,input  p-obj-code
     3579       ,input  0
     3580       ,input  0
     3581       ,input  0
     3582       ,input  true
     3583       ,output glog
     3584       )  .
     3585   end.
     3586   if not glog then return no-apply.
     3587   do on stop undo, return no-apply:
     3588     case p-doc-type:
     3589       when 'инв-сч-трк':U then do:
     3590         run ref/icntdoci.w ( INPUT parparentproc
     3591                         ,INPUT 'ДОБАВЛЕНИЕ':U
     3592                         ,INPUT v-cntxt-obj-type
     3593                         ,INPUT v-cntxt-obj-code
     3594                         ,INPUT-output v-icnt-rec
     3595                         ,input-output v-icnt-line-rec
     3596                         ,input this-procedure:handle
     3597                         ,input-output next-prev
     3598                         ) no-error.
     3599       end.
     3600       when 'сч-трк-погр':U then do:
     3601         run ref/icntdoce.w ( INPUT parparentproc
     3602                         ,INPUT 'ДОБАВЛЕНИЕ':U
     3603                         ,INPUT v-cntxt-obj-type
     3604                         ,INPUT v-cntxt-obj-code
     3605                         ,INPUT-output v-icnt-rec
     3606                         ,input-output v-icnt-line-rec
     3607                         ,input this-procedure:handle
     3608                         ,input-output next-prev
     3609                         ) no-error.
     3610       end.
     3611     end case.
     3612     if error-status:error then undo, return no-apply.
     3613   end.
     3614   if v-icnt-rec = ? then undo, return error.
     3615   run Openbr IN THIS-PROCEDURE ( INPUT yes, INPUT no, INPUT '':U).
     3616   REPOSITION br-i-docs TO RECID v-icnt-rec NO-ERROR.
     3617   APPLY "ENTRY" to br-i-docs in frame Dialog-Frame .
     3618   APPLY "value-changed" TO br-i-docs.
     3619   message
     3620   "Новый документ счетчиков ТРК добавлен в Базу Данных."
     3621   VIEW-AS ALERT-BOX.
     3622   END PROCEDURE.
