     2649   define variable l-query-was-opened as logical no-undo .
     2650   define variable title0 as character no-undo .
     2651   define buffer buf_clients for ub.clients.
     2652   case sort-column-name :
     2653     when "" then do:
     2654       assign
     2655         sort-column-phrase = ""
     2656       .
     2657     end.
     2658     otherwise do:
     2659       assign
     2660         sort-column-phrase = "by " + sort-column-name
     2661       .
     2662     end.
     2663   end case.
     2664   filter-point = filter-point0 + p-list-mode .
     2665   if p-doc-type = 'инв-сч-трк':U then do:
     2666     title0 = "ДОКУМЕНТЫ ИНВЕНТАРИЗАЦИИ СЧЕТЧИКОВ ТРК".
     2667   end.
