      652   FUNCTION func-delta RETURN DECIMAL (buffer bf_i-doc for ub.icnt-doc).
      653      return (bf_i-doc.state-el-cnt - bf_i-doc.state-mh-cnt).
      654   END FUNCTION.
      655   define variable varfunc-obj         as character format "x(9)" no-undo.
      656   define variable varshort-doc-date   as character format "x(5)" no-undo.
      657   define variable varshort-shift-date as character format "x(5)" no-undo.
      658   define variable varfine-time        as character format "x(8)" no-undo.
      659   define variable varfunc-delta       like ub.icnt-doc.state-el-cnt no-undo.
      660   DEFINE BUTTON b-add
      661        LABEL "&Добавить"
      662        SIZE 10 BY 1.
      663   DEFINE BUTTON b-chg
