     3647   do on stop undo, return no-apply:
     3648     case p-doc-type:
     3649       when 'инв-сч-трк':U then do:
     3650         run ref/icntdoci.w ( INPUT parparentproc
     3651                         ,INPUT 'ИЗМЕНЕНИЕ':U
     3652                         ,INPUT X_icnt-doc.obj-type
     3653                         ,INPUT X_icnt-doc.obj-code
     3654                         ,input-output v-icnt-rec
     3655                         ,input-output v-icnt-line-rec
     3656                         ,input this-procedure:handle
     3657                         ,input-output next-prev
     3658                         ) no-error.
     3659       end.
     3660       when 'сч-трк-погр':U then do:
     3661         run ref/icntdoce.w ( INPUT parparentproc
     3662                         ,INPUT 'ИЗМЕНЕНИЕ':U
     3663                         ,INPUT X_icnt-doc.obj-type
     3664                         ,INPUT X_icnt-doc.obj-code
     3665                         ,input-output v-icnt-rec
     3666                         ,input-output v-icnt-line-rec
     3667                         ,input this-procedure:handle
     3668                         ,input-output next-prev
     3669                         ) no-error.
     3670       end.
     3671     end case.
     3672     if error-status:error then undo, return no-apply.
     3673   end.
     3674   if error-status:error then do:
     3675     UNDO, RETURN ERROR.
     3676   end.
     3677   apply "entry" to BR-i-docs in frame Dialog-Frame.
     3678   run Openbr IN THIS-PROCEDURE ( INPUT yes, INPUT no, INPUT '':U).
     3679   REPOSITION br-i-docs TO RECID v-icnt-rec NO-ERROR.
     3680   APPLY "ENTRY" to br-i-docs.
     3681   APPLY "value-changed" TO br-i-docs.
     3682   END PROCEDURE.
     3683   PROCEDURE proc-b-lkp :
     3684   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     3685   define variable next-prev as character no-undo .
     3686   define variable v-icnt-line-rec as recid no-undo .
     3687   IF NOT AVAILABLE X_icnt-doc THEN UNDO, RETURN ERROR.
     3688   define variable vss-include-info45 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3689   do:
     3690     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3691       (input  v-cntxt-db-num
     3692       ,input  v-cntxt-userid
     3693       ,input  0
     3694       ,input  'actn_icnt-doc_lookup':U
     3695       ,input  'object':U
     3696       ,input  X_icnt-doc.host-code
     3697       ,input  X_icnt-doc.obj-type
     3698       ,input  X_icnt-doc.obj-code
     3699       ,input  0
     3700       ,input  0
     3701       ,input  0
     3702       ,input  true
     3703       ,output glog
     3704       )  .
     3705   end.
     3706   if not glog then
     3707     return no-apply.
     3708   if not glog then  undo, RETURN no-apply.
     3709   assign
     3710     v-icnt-rec = recid (X_icnt-doc)
     3711     .
     3712   do on stop undo, return no-apply:
     3713     case p-doc-type:
     3714       when 'инв-сч-трк':U then do:
     3715         run ref/icntdoci.w ( INPUT parparentproc
     3716                         ,INPUT 'ПРОСМОТР':U
     3717                         ,INPUT X_icnt-doc.obj-type
     3718                         ,INPUT X_icnt-doc.obj-code
     3719                         ,input-output v-icnt-rec
     3720                         ,input-output v-icnt-line-rec
     3721                         ,input this-procedure:handle
     3722                         ,input-output next-prev
     3723                         ) no-error .
     3724      end.
     3725      when 'сч-трк-погр':U then do:
     3726         run ref/icntdoce.w ( INPUT parparentproc
     3727                         ,INPUT 'ПРОСМОТР':U
     3728                         ,INPUT X_icnt-doc.obj-type
     3729                         ,INPUT X_icnt-doc.obj-code
     3730                         ,input-output v-icnt-rec
     3731                         ,input-output v-icnt-line-rec
     3732                         ,input this-procedure:handle
     3733                         ,input-output next-prev
     3734                         ) no-error .
     3735       end.
     3736     end case.
     3737     if error-status:error then return no-apply.
     3738   end.
     3739   if v-icnt-rec <> ? then reposition br-i-docs to recid v-icnt-rec no-error.
     3740   apply "entry" to br-i-docs in frame Dialog-Frame.
     3741   apply "value-changed" to br-i-docs in frame Dialog-Frame.
     3742   END PROCEDURE.
     3743   PROCEDURE proc-b-print :
     3744   DEFINE VARIABLE v-icnt-rec AS RECID no-undo.
     3745   DEFINE VARIABLE glog AS logical no-undo.
     3746   IF NOT AVAILABLE X_icnt-doc THEN RETURN ERROR.
     3747   ASSIGN
     3748   v-icnt-rec = recid (X_icnt-doc).
     3749   define variable vss-include-info46 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3750   do:
     3751     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     3752       (input  v-cntxt-db-num
     3753       ,input  v-cntxt-userid
     3754       ,input  0
     3755       ,input  'actn_icnt-doc_print':U
     3756       ,input  'object':U
     3757       ,input  X_icnt-doc.host-code
     3758       ,input  X_icnt-doc.obj-type
     3759       ,input  X_icnt-doc.obj-code
     3760       ,input  0
     3761       ,input  0
     3762       ,input  0
     3763       ,input  true
     3764       ,output glog
     3765       )  .
     3766   end.
     3767   if not glog then return no-apply.
     3768   case  X_icnt-doc.doc-type:
     3769     when 'инв-сч-трк':U then do:
     3770       run rep/r-apump.p ( input parparentproc
     3771                     ,input v-icnt-rec) no-error .
     3772     end.
     3773     when 'сч-трк-погр':U then do:
     3774       run rep/r-epump.p ( input parparentproc
     3775                     ,input v-icnt-rec) no-error .
     3776     end.
     3777   end case.
     3778   apply "entry" to br-i-docs in frame Dialog-Frame.
     3779   END PROCEDURE.
     3780   PROCEDURE proc-b-sch :
     3781   define variable v-ri as recid no-undo .
     3782   assign
     3783   v-ri = (if avail X_icnt-doc then recid(X_icnt-doc) else ?)
     3784   .
     3785   assign
     3786   tbl = 'icnt-doc'
     3787   join-tbl = 'X_icnt-doc'
     3788   fld = ""
     3789   lab = ""
     3790   spr = ""
     3791   dim = '0'
     3792   .
     3793   run fltfield-add in this-procedure('host-code', 'Фирма', '',
     3794   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3795   run fltfield-add in this-procedure('obj-type*obj-code', 'Объект', 'cli',
     3796   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3797   run fltfield-add in this-procedure('doc-code', 'Номер документа', '',
     3798   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3799   run fltfield-add in this-procedure('status_', 'Статус', '',
     3800   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3801   run fltfield-add in this-procedure('fact-date', 'Дата_факт', '',
     3802   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3803   run fltfield-add in this-procedure('shift-date', 'Дата_смены', '',
     3804   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3805   run fltfield-add in this-procedure('shift-num', 'Порядок_смены', '',
     3806   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3807   DO on stop undo, leave:
     3808       run gbl/filter.w ( INPUT parparentproc
     3809                    ,INPUT filter-point + chr(4) + filter-label
     3810                    ,INPUT tbl
     3811                    ,INPUT join-tbl
     3812                    ,INPUT fld
     3813                    ,INput lab
     3814                    ,INPUT spr
     3815                    ,INPUT  dim).
     3816       run OpenBr IN THIS-PROCEDURE ( INPUT YES, INPUT NO, INPUT '':U).
     3817       if v-ri <> ? then do:
     3818         reposition br-i-docs to recid v-ri no-error.
     3819       end.
     3820       APPLY "ENTRY" to br-i-docs in frame Dialog-Frame .
     3821       APPLY "VALUE-CHANGED" to br-i-docs.
     3822   END .
     3823   END PROCEDURE.
     3824   PROCEDURE reopen-query :
     3825   if available X_icnt-doc then v-icnt-rec = recid(X_icnt-doc).
     3826   run OpenBr in THIS-PROCEDURE ( INPUT yes, INPUT no, INPUT '':U).
     3827   reposition br-i-docs to recid v-icnt-rec no-error.
     3828   apply "entry" to br-i-docs in frame Dialog-Frame .
     3829   apply "value-changed" to br-i-docs in frame Dialog-Frame .
     3830   END PROCEDUR.
     3831   PROCEDURE reposition-icnt-doc :
     3832   define input  parameter p-direction   as character no-undo .
     3833   define output parameter p-icnt-doc-recid as recid no-undo .
     3834     case p-direction :
     3835       when "first":U
     3836       then do:
     3837         get first br-i-docs.
     3838       end.
     3839       when "last":U
     3840       then do:
     3841         get last br-i-docs.
     3842       end.
     3843       when "prev":U
     3844       then do:
     3845         get prev br-i-docs.
     3846         if not available X_icnt-doc then do:
     3847           message
     3848           "Это первый документ списка"
     3849           view-as alert-box.
     3850         end.
     3851       end.
     3852       when "next":U
     3853       then do:
     3854         get next br-i-docs.
     3855         if not available X_icnt-doc then do:
     3856           message
     3857           "Это последний документ списка"
     3858           view-as alert-box.
     3859         end.
     3860       end.
     3861     end case .
     3862     assign
     3863     p-icnt-doc-recid = recid(X_icnt-doc)
     3864     .
     3865     run reposition-query in this-procedure
     3866       (input p-icnt-doc-recid
     3867       ).
     3868   END PROCEDURE.
     3869   PROCEDURE reposition-query :
     3870   define input parameter p-recid as recid no-undo .
     3871     if p-recid <> ?
     3872     then do:
     3873       reposition br-i-docs to recid p-recid no-error.
     3874     end.
     3875     do with frame Dialog-Frame:
     3876       apply "entry":u to browse br-i-docs .
     3877       apply "VALUE-CHANGED":u to browse br-i-docs .
     3878     end.
     3879   END PROCEDURE.
