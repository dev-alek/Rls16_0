      379   procedure fltfield-clear :
      380     define output parameter loc-fld as character no-undo.
      381     define output parameter loc-lab as character no-undo .
      382     define output parameter loc-spr as character no-undo .
      383     define output parameter loc-dim as character no-undo .
      384     assign
      385       loc-fld = ""
      386       loc-lab = ""
      387       loc-spr = ""
      388       loc-dim = "0"
      389     .
      390   end procedure .
      391   procedure fltfield-add :
      392     define input        parameter par-fld as character no-undo.
      393     define input        parameter par-lab as character no-undo .
      394     define input        parameter par-spr as character no-undo .
      395     define input-output parameter loc-fld as character no-undo.
      396     define input-output parameter loc-lab as character no-undo .
      397     define input-output parameter loc-spr as character no-undo .
      398     define input-output parameter loc-dim as character no-undo .
      399     do
      400     on error undo, return error
      401     :
      402       assign
      403       loc-fld = if loc-dim = '0'
      404                 then par-fld
      405                 else (loc-fld + chr(44) + par-fld)
      406       loc-lab = if loc-dim = '0'
      407                 then par-lab
      408                 else (loc-lab + chr(44) + par-lab)
      409       loc-spr = if loc-dim = '0'
      410                 then par-spr
      411                 else (loc-spr + chr(44) + par-spr)
      412       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      413                 string(integer(if num-entries(loc-dim) > 1
      414                               then entry(2, loc-dim)
      415                               else entry(1, loc-dim)
      416                               ) + 1)
      417       no-error
      418       .
      419     end.
      420   end procedure.
