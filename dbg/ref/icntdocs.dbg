      460   function shift-name return character ( buffer loc-icnt-doc for ub.icnt-doc ) :
      461     if loc-icnt-doc.shift-date = ? then do:
      462       return "":u.
      463     end.
      464     else do:
      465       if loc-icnt-doc.shift-num = integer(loc-icnt-doc.shift-name) then do:
      466         return loc-icnt-doc.shift-name.
      467       end.
      468       else do:
      469         return loc-icnt-doc.shift-name + "(" + string(loc-icnt-doc.shift-num) + ")".
      470       end.
      471     end.
      472   end function.
      473   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      474   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      475   procedure fltopend_fltopend :
      476   define input parameter p-parent-handle as handle no-undo .
      477   define input parameter p-qh as handle no-undo .
      478   define input parameter p-flt-open-open-query  as character no-undo .
      479   define input parameter p-where-cond as character no-undo .
      480   define input parameter p-use-indFIRST-query-tail as character no-undo .
      481   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      482   define input parameter p-indexed-reposition as character no-undo .
      483     do
      484     on error undo, return error
      485     :
      486   define variable v-prepare-string as character no-undo .
      487   define variable glog as logical no-undo .
      488   assign
      489   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      490                      p-where-cond + chr(32)  +
      491                      p-use-indFIRST-query-tail + chr(32) +
      492                      p-use-ind-sort-clmn-by + chr(32) +
      493                      p-indexed-reposition
      494   .
      495   assign
      496   glog = p-qh:query-prepare(v-prepare-string) no-error .
      497   if not glog
      498   or error-status:error then do:
      499     message error-status:get-message(1) view-as alert-box .
      500     undo, return error .
      501   end.
      502   assign
      503   glog = p-qh:query-open no-error .
      504   if not glog
      505   or error-status:error then do:
      506     message error-status:get-message(1) view-as alert-box .
      507     undo, return error .
      508   end.
      509     end.
      510   end procedure.
      511   procedure fltopend_fltfindd :
      512   define input parameter p-parent-handle as handle no-undo .
      513   define input parameter p-qh as handle no-undo .
      514   define input parameter p-rowid as rowid no-undo .
      515   define input parameter p-next as logical no-undo .
      516   define input parameter p-lock as integer no-undo .
      517   define input parameter p-bh as handle no-undo .
      518   define input parameter p-where-cond as character no-undo .
      519   define input parameter p-use-index-phrase as character no-undo .
      520   define variable glog as logical no-undo .
      521   define variable v-qh as handle no-undo .
      522   define variable v-bh as handle no-undo .
      523   define variable v-recid as recid no-undo .
      524   define variable v-prepare-string as character no-undo .
      525   do
      526   on error undo, return error
      527   on stop undo, return error
      528   :
      529     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      530     create buffer v-bh for table p-bh buffer-name p-bh:name.
      531     create query v-qh.
      532     v-qh:set-buffers(v-bh).
      533     v-prepare-string = substitute("for each &1 &2 &3"
      534                                     ,v-bh:name
      535                                     ,p-where-cond
      536                                     ,p-use-index-phrase).
      537     glog = v-qh:query-prepare(v-prepare-string) no-error.
      538     if not glog then do:
      539       delete object v-qh.
      540       delete object v-bh.
      541       undo, return error .
      542     end.
      543     glog = v-qh:query-open no-error .
      544     if not glog then do:
      545       delete object v-qh.
      546       delete object v-bh.
      547       undo, return error .
      548     end.
      549     if p-next then do:
      550       v-qh:reposition-to-rowid(p-rowid) no-error .
      551       glog = v-qh:get-next( p-lock) no-error .
      552       glog = v-qh:get-next( p-lock) no-error .
      553       if not glog or v-qh:query-off-end = yes then do:
      554         glog = v-qh:get-first( p-lock) no-error .
      555       end.
      556     end.
      557     else do:
      558       glog = v-qh:get-first( p-lock) no-error .
      559     end.
      560     v-recid = v-bh:recid no-error .
      561     delete object v-qh.
      562     delete object v-bh.
      563     return string(v-recid) .
      564   end.
      565   end procedure.
      566   procedure fltopend_fltfindq :
      567   define input parameter p-parent-handle as handle no-undo .
      568   define input parameter p-qh as handle no-undo .
      569   define input parameter p-next as logical no-undo .
      570   define input parameter p-lock as integer no-undo .
      571   define input parameter p-flt-open-open-query  as character no-undo .
      572   define input parameter p-where-cond as character no-undo .
      573   define input parameter p-use-indFIRST-query-tail as character no-undo .
      574   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      575   define input parameter p-indexed-reposition as character no-undo .
      576   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      577   define variable glog as logical no-undo .
      578   define variable v-qh as handle no-undo .
      579   define variable v-bh as handle no-undo extent 18.
      580   define variable v-rowid as rowid no-undo extent 18.
      581   define variable v-ii as integer no-undo .
      582   define variable v-prepare-string as character no-undo .
      583   do
      584   on error undo, return error
      585   on stop undo, return error
      586   :
      587     create query v-qh.
      588     do v-ii = 1 to p-qh:num-buffers:
      589       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      590       assign
      591       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      592       no-error.
      593       v-qh:add-buffer(v-bh[v-ii]).
      594     end.
      595     assign
      596     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      597                       p-where-cond + chr(32)  +
      598                       p-use-indFIRST-query-tail + chr(32) +
      599                       p-use-ind-sort-clmn-by + chr(32) +
      600                       p-indexed-reposition
      601     .
      602     glog = v-qh:query-prepare( v-prepare-string) no-error .
      603     if not glog then do:
      604       delete object v-qh.
      605       do v-ii = 1 to p-qh:num-buffers:
      606         delete object v-bh[v-ii].
      607       end.
      608       undo, return error .
      609     end.
      610     glog = v-qh:query-open no-error .
      611     if not glog then do:
      612       delete object v-qh.
      613       do v-ii = 1 to p-qh:num-buffers:
      614         delete object v-bh[v-ii].
      615       end.
      616       undo, return error .
      617     end.
      618     if p-next then do:
      619       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      620       glog = v-qh:get-next( p-lock) no-error .
      621       glog = v-qh:get-next( p-lock) no-error .
      622       if not glog or v-qh:query-off-end = yes then do:
      623         glog = v-qh:get-first( p-lock) no-error .
      624       end.
      625     end.
      626     else do:
      627       glog = v-qh:get-first( p-lock) no-error .
      628     end.
      629     do v-ii = 1 to p-qh:num-buffers:
      630       assign
      631       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      632       no-error.
      633     end.
      634     delete object v-qh.
      635     do v-ii = 1 to p-qh:num-buffers:
      636       delete object v-bh[v-ii].
      637     end.
      638   end.
      639   end procedure.
      640   define variable sort-column-name as character no-undo.
      641   define variable filter-point     as character NO-UNDO INIT "inctdocs".
      642   define variable filter-label     as character NO-UNDO INIT "Список документов по счетчикам ТРК".
      643   define variable filter-point0     as character NO-UNDO INIT "inctdocs".
      644   define variable filter-label0     as character NO-UNDO INIT "Список документов по счетчикам ТРК".
      645   DEFINE VARIABLE v-icnt-rec AS RECID NO-UNDO.
      646   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
