      362     run proc-alt-f1 in this-procedure .
      363   end.
      364   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      365   FUNCTION calc-range RETURNS LOGICAL(
      366                                        input  my-db-num as integer
      367                                       ,input  my-code-src as integer
      368                                       ,input p-range-type as character
      369                                       ):
      370   define variable mycode as integer no-undo .
      371   mycode = abs(my-code-src).
      372   if mycode = 0 then return no.
      373   define buffer buf_code-range for ub.code-range.
      374   find first  buf_code-range no-lock where
      375           buf_code-range.db-num = my-db-num
      376       and buf_code-range.range-type = p-range-type
      377       and buf_code-range.stts = 'u'
      378       and buf_code-range.first-code <= mycode
      379       and buf_code-range.last-code >= mycode no-error .
      380   if available buf_code-range then return yes.
      381   find first buf_code-range no-lock where
      382           buf_code-range.db-num = my-db-num
      383       and buf_code-range.range-type = p-range-type
      384       and buf_code-range.stts = 'a':U
      385       and buf_code-range.first-code <= mycode no-error .
      386   if p-range-type = 'fmgb':U
      387   and available buf_code-range
      388   and (buf_code-range.stts = 'u'
      389       or
      390       mycode <  current-value(s-fmgb-code, ub)) then return yes.
      391   if p-range-type = 'pngb':U
      392   and available buf_code-range
      393   and (buf_code-range.stts = 'u'
      394       or
      395       mycode <  current-value(s-pngb-code, ub)) then return yes.
      396   if my-code-src < 0 then do:
      397     find first buf_code-range no-lock where
      398             buf_code-range.db-num = my-db-num
      399         and buf_code-range.range-type = p-range-type
      400         and buf_code-range.stts = 'f':U
      401         and buf_code-range.first-code <= mycode
      402         and buf_code-range.last-code >= mycode  no-error .
      403     if available buf_code-range then return yes.
      404   end.
      405     find first buf_code-range no-lock where
      406             buf_code-range.db-num = my-db-num
      407         and buf_code-range.range-type = p-range-type
      408         and buf_code-range.first-code <= mycode
      409         and buf_code-range.last-code >= mycode  no-error .
      410   if available buf_code-range then return no.
      411   return ?.
      412   END FUNCTION.
      413   DEFINE BUTTON B-exit AUTO-GO
      414        LABEL "&Ввод"
      415        SIZE 10 BY 1
      416        BGCOLOR 8 .
      417   DEFINE BUTTON B-find
      418        LABEL "&Найти"
      419        SIZE 10 BY 1.
      420   DEFINE BUTTON B-Help
      421        LABEL "Помо&щь"
      422        SIZE 10 BY 1
      423        BGCOLOR 8 .
      424   DEFINE BUTTON b-quit AUTO-END-KEY
      425        LABEL "&Отмена"
      426        SIZE 10 BY 1
      427        BGCOLOR 8 .
      428   DEFINE VARIABLE F-cv AS INTEGER FORMAT ">>>,>>>,>>9":U INITIAL 0
      429        VIEW-AS FILL-IN
      430        SIZE 12 BY 1
      431        FGCOLOR 4  NO-UNDO.
      432   DEFINE VARIABLE F-end AS INTEGER FORMAT ">>>,>>>,>>9":U INITIAL 0
      433         VIEW-AS TEXT
      434        SIZE 12 BY .67
      435        FGCOLOR 1  NO-UNDO.
      436   DEFINE VARIABLE F-free-code AS INTEGER FORMAT ">>>,>>>,>>9":U INITIAL 0
      437        LABEL "Свободный код"
      438         VIEW-AS TEXT
      439        SIZE 14 BY .67
      440        FGCOLOR 4  NO-UNDO.
      441   DEFINE VARIABLE F-start AS INTEGER FORMAT ">>>,>>>,>>9":U INITIAL 0
      442         VIEW-AS TEXT
      443        SIZE 12 BY .67
      444        FGCOLOR 1  NO-UNDO.
      445   DEFINE VARIABLE FILL-IN-4 AS CHARACTER FORMAT "X(256)":U INITIAL "<"
      446         VIEW-AS TEXT
      447        SIZE 2.5 BY .67 NO-UNDO.
      448   DEFINE VARIABLE FILL-IN-5 AS CHARACTER FORMAT "X(256)":U INITIAL ">"
      449         VIEW-AS TEXT
      450        SIZE 2.5 BY .67 NO-UNDO.
      451   DEFINE VARIABLE RS-up-down AS INTEGER INITIAL -1
      452        VIEW-AS RADIO-SET HORIZONTAL
      453        RADIO-BUTTONS
      454             "Меньше", -1,
      455   "Больше", 1
      456        SIZE 29 BY 1 NO-UNDO.
      457   DEFINE QUERY BR-code-range FOR
      458         tt-code-range SCROLLING.
      459   DEFINE BROWSE BR-code-range
      460     QUERY BR-code-range DISPLAY
      461         tt-code-range.first-code COLUMN-LABEL "Нижняя граница"
      462   tt-code-range.last-code  COLUMN-LABEL "Верхняя граница"
      463       WITH NO-ROW-MARKERS SEPARATORS SIZE 57.3 BY 14.77
      464            TITLE "Диапазоны использованных кодов по БД" ROW-HEIGHT-CHARS .67.
      465   DEFINE FRAME Dialog-Frame
      466        B-exit AT ROW 1 COL 1
      467        b-quit AT ROW 1 COL 11
      468        B-Help AT ROW 1 COL 54.9
      469        RS-up-down AT ROW 2.5 COL 2.5 NO-LABEL
      470        F-cv AT ROW 4 COL 18 NO-LABEL
      471        B-find AT ROW 6 COL 11
      472        BR-code-range AT ROW 8.77 COL 17
      473        F-start AT ROW 4 COL 2.5 NO-LABEL
      474        FILL-IN-4 AT ROW 4 COL 13 COLON-ALIGNED NO-LABEL
      475        FILL-IN-5 AT ROW 4 COL 29 COLON-ALIGNED NO-LABEL
      476        F-end AT ROW 4 COL 36.5 NO-LABEL
      477        F-free-code AT ROW 7 COL 35 COLON-ALIGNED
      478        SPACE(23.49) SKIP(16.82)
      479       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      480            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      481            TITLE "Подобрать свободный код"
      482            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      483   ASSIGN
      484          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      485          FRAME Dialog-Frame:HIDDEN           = TRUE.
      486   ASSIGN
      487          F-free-code:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      488   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      489   DO:
      490     APPLY "END-ERROR":U TO SELF.
      491   END.
      492   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      493   DO:
      494     IF f-free-code <> 0 THEN
      495     p-code = f-free-code.
      496   END.
      497   ON CHOOSE OF B-find IN FRAME Dialog-Frame
      498   DO:
      499       RUN proc-b-find IN THIS-PROCEDURE NO-ERROR.
      500       IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      501   END.
      502   ON MOUSE-SELECT-DBLCLICK OF BR-code-range IN FRAME Dialog-Frame
      503   DO:
      504      IF NOT AVAILABLE tt-code-range THEN RETURN no-apply.
      505       RUN assign-and-find IN THIS-PROCEDURE NO-ERROR.
      506   END.
      507   ON RETURN OF BR-code-range IN FRAME Dialog-Frame
      508   DO:
      509      IF NOT AVAILABLE tt-code-range THEN RETURN no-apply.
      510       RUN assign-and-find IN THIS-PROCEDURE NO-ERROR.
      511   END.
      512   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      513   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      514   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      515   on help of frame Dialog-Frame
      516   do:
      517     run gbl/app_help.p
      518       (input this-procedure :file-name
      519       ,input ''
      520       ,input ?
      521       ) no-error.
      522     if error-status :error then do:
      523       message
      524         "Ошибка при вызове помощи"
      525         error-status :get-message(1)
      526         view-as alert-box .
      527     end.
      528   end.
      529   run minbtn-set in this-procedure .
      530   on choose of b-help in frame Dialog-Frame
      531   do:
      532     apply "help":u to frame Dialog-Frame .
      533   end.
      534   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      535   procedure minbtn-set :
      536       do
      537           on error undo, return error return-value
      538           :
      539           define variable ii              as integer       no-undo .
      540           define variable fh              as widget-handle no-undo .
      541           define variable hh              as widget-handle no-undo .
      542           define variable v-h             as handle        extent 4 no-undo .
      543           define variable v-name-button   as character     no-undo .
      544           define variable v-help-old-x    as decimal       no-undo .
      545           define variable v-help-old-y    as decimal       no-undo .
      546           define variable v-help-old-size as decimal       no-undo .
      547           define variable v-frame-width   as decimal       no-undo .
      548           define variable jj              as integer       no-undo .
      549           do
      550               on error undo, return error
      551               :
      552               assign
      553                   v-frame-width = frame Dialog-Frame:width - 0.3
      554                   fh            = frame Dialog-Frame:first-child
      555                   hh            = fh:first-child
      556                   ii            = 1
      557                   .
      558               do while valid-handle(hh):
      559                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      560                   do:
      561                       case lc(hh:name) :
      562                           when "b-help" then
      563                               do:
      564                                   hh:load-image-up("cmp/b-help.bmp":u) .
      565                                   hh:load-image-down("cmp/b-help.bmp":u) .
      566                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      567                                   hh:TOOLTIP = "Помощь" .
      568                                   v-help-old-x = hh:column .
      569                                   v-help-old-y = hh:row    .
      570                                   v-help-old-size = hh:width .
      571                                   hh:width-chars = 2.5 .
      572                               end.
      573                           when "b-print" then
      574                               do:
      575                                   hh:load-image("cmp/b-print.bmp":u) .
      576                                   hh:TOOLTIP = "Печать" .
      577                                   v-h[ii] = hh:handle .
      578                                   ii = ii + 1 .
      579                                   hh:width-chars = 3 .
      580                               end.
      581                           when "b-history" or
      582                           when "b-hist" then
      583                               do:
      584                                   hh:load-image("cmp/b-hist.bmp":u) .
      585                                   hh:TOOLTIP = "История" .
      586                                   v-h[ii] = hh:handle .
      587                                   ii = ii + 1 .
      588                                   hh:width-chars = 3 .
      589                               end.
      590                           when "b-sch" then
      591                               do:
      592                                   hh:load-image("cmp/b-sch.bmp":u) .
      593                                   hh:TOOLTIP = "Установка Фильтра" .
      594                                   v-h[ii] = hh:handle .
      595                                   ii = ii + 1 .
      596                                   hh:width-chars = 3 .
      597                               end.
      598                           when "b-hist-user" then
      599                               do:
      600                                   hh:load-image("cmp/b-hist.bmp":u) .
      601                                   hh:TOOLTIP = "История пользователя" .
      602                                   ii = ii + 1 .
      603                               end.
      604                       end case.
      605                   end.
      606                   hh = hh:next-sibling.
      607               end.
      608               b-help:column = v-frame-width - b-help:width-chars.
      609               jj = 0.
      610               repeat ii = 4 to 1 by -1 :
      611                   if valid-handle (v-h[ii] ) then
      612                   do:
      613                       jj  = jj + 1 .
      614                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      615                       v-h[ii]:row    = v-help-old-y .
      616                   end.
      617               end.
      618           end.
      619       end.
      620   end procedure.
      621   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      622   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      623   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      624   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      625   define variable v-diasize-current-frame-width  as decimal   no-undo .
      626   define variable v-diasize-current-frame-height as decimal   no-undo .
      627   define variable v-diasize-change-size          as logical   no-undo .
      628   define variable v-diasize-resize-button        as handle    no-undo .
      629   define variable v-diasize-wndmax               as logical   no-undo .
      630   define variable v-diasize-wndstore             as logical   no-undo .
      631   define variable v-diasize-proc-name            as character no-undo .
      632   define variable v-diasize-browse-handle        as handle    no-undo .
      633   define variable v-diasize-browse-number        as integer   no-undo .
      634   define variable v-diasize-need-full-display    as logical   no-undo init false .
      635   define temp-table temp-diasize-handle no-undo
      636     field handle-value  as handle
      637     field save-position as decimal
      638     index xpk is primary unique handle-value
      639     .
      640   define temp-table temp-browse-handle no-undo
      641     field browse-type   as character
      642     field browse-number as integer
      643     field browse-handle as handle
      644     field original-size as decimal
      645     index xpk is primary unique browse-type browse-number
      646     index xie browse-type browse-handle
      647   .
      648   procedure diasize_change-height :
      649     define input  parameter p-change-value  as decimal   no-undo .
      650     define input  parameter p-move-resize   as logical   no-undo .
      651     define variable v-field-group-handle    as handle    no-undo .
      652     define variable v-object-handle         as handle    no-undo .
      653     define variable v-frame-height          as decimal   no-undo .
      654     define variable v-frame-virtual-height  as decimal   no-undo .
      655     define variable v-browse-height         as decimal   no-undo .
      656     define variable v-window-height         as decimal   no-undo .
      657     define variable v-window-virtual-height as decimal   no-undo .
      658     define variable v-change-sign           as integer   no-undo .
      659     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      660     define buffer buf_temp-browse-handle  for temp-browse-handle .
      661     if p-change-value > 0
      662     then do:
      663       if frame Dialog-Frame :height + p-change-value
      664           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      665       then do:
      666         assign
      667           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      668                           - (frame Dialog-Frame :height-chars)
      669         .
      670         if p-change-value <= 0
      671         then do:
      672           run diasize_position-resize-button in this-procedure .
      673           return .
      674         end.
      675       end.
      676     end.
      677     if p-change-value < 0
      678     then do:
      679       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      680       then do:
      681         assign
      682           p-change-value = v-diasize-orig-frame-height
      683                          - (frame Dialog-Frame :height-chars)
      684         .
      685         if p-change-value >= 0
      686         then do:
      687           run diasize_position-resize-button in this-procedure .
      688           return .
      689         end.
      690       end.
      691     end.
      692     if p-change-value >= 0
      693     then do:
      694       assign
      695         v-change-sign = 1
      696       .
      697     end.
      698     else do:
      699       assign
      700         v-change-sign = -1
      701       .
      702     end.
      703     assign
      704       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      705     .
      706     if p-change-value = 0
      707     then do:
      708       run diasize_position-resize-button in this-procedure .
      709       return .
      710     end.
      711     move_block:
      712     do
      713     on error undo move_block, retry move_block
      714     :
      715       if retry
      716       then do:
      717         do
      718         on error undo move_block, leave move_block
      719         :
      720           if p-change-value > 0
      721           then do:
      722             for each buf_temp-diasize-handle
      723             on error undo, next
      724             :
      725               assign
      726                 v-object-handle = buf_temp-diasize-handle.handle-value
      727               .
      728               if v-object-handle <> v-diasize-resize-button
      729               then do:
      730                 assign
      731                   v-object-handle :row = buf_temp-diasize-handle.save-position
      732                 .
      733               end.
      734             end.
      735             assign
      736               v-diasize-browse-handle :height = v-browse-height
      737             .
      738             for each buf_temp-browse-handle
      739               where buf_temp-browse-handle.browse-type = 'height':u
      740             on error undo, next
      741             :
      742               assign
      743                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      744               .
      745             end.
      746             assign
      747               frame Dialog-Frame :height = v-frame-height
      748             .
      749             if frame Dialog-Frame :scrollable = true
      750             then do:
      751               assign
      752                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      753               .
      754             end.
      755             run diasize_position-resize-button in this-procedure .
      756           end.
      757           else do:
      758             if frame Dialog-Frame :scrollable = true
      759             then do:
      760               assign
      761                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      762               .
      763             end.
      764             assign
      765               frame Dialog-Frame :height = v-frame-height
      766             .
      767             assign
      768               v-diasize-browse-handle :height = v-browse-height
      769             .
      770             for each buf_temp-browse-handle
      771               where buf_temp-browse-handle.browse-type = 'height':u
      772             on error undo, next
      773             :
      774               assign
      775                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      776               .
      777             end.
      778             for each buf_temp-diasize-handle
      779             on error undo, next
      780             :
      781               assign
      782                 v-object-handle = buf_temp-diasize-handle.handle-value
      783               .
      784               if v-object-handle <> v-diasize-resize-button
      785               then do:
      786                 assign
      787                   v-object-handle :row = buf_temp-diasize-handle.save-position
      788                 .
      789               end.
      790             end.
      791             run diasize_position-resize-button in this-procedure .
      792           end.
      793           assign
      794             v-diasize-change-size = false
      795           .
      796           leave move_block .
      797         end.
      798       end.
      799       assign
      800         v-diasize-need-full-display = true
      801       .
      802       if v-diasize-change-size = false
      803       then do:
      804         assign
      805           v-diasize-change-size = true
      806         .
      807       end.
      808       else do:
      809         return .
      810       end.
      811       assign
      812         v-frame-height = frame Dialog-Frame :height
      813         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      814         v-browse-height = v-diasize-browse-handle :height
      815       .
      816       for each buf_temp-browse-handle
      817         where buf_temp-browse-handle.browse-type = 'height':u
      818       :
      819         assign
      820           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      821         .
      822       end.
      823       for each buf_temp-diasize-handle
      824       :
      825         delete buf_temp-diasize-handle .
      826       end.
      827       assign
      828         v-field-group-handle = frame Dialog-Frame :first-child
      829       .
      830       do while valid-handle(v-field-group-handle)
      831       :
      832         assign
      833           v-object-handle = v-field-group-handle :first-child
      834         .
      835         do while valid-handle(v-object-handle)
      836         :
      837           if  v-object-handle <> v-diasize-browse-handle :handle
      838           and can-query(v-object-handle, "row")
      839           and can-query(v-object-handle, "height")
      840           and ( v-object-handle :row > v-diasize-browse-handle :row )
      841           then do:
      842             find first buf_temp-browse-handle
      843               where buf_temp-browse-handle.browse-type   = 'height':u
      844                 and buf_temp-browse-handle.browse-handle = v-object-handle
      845               no-error .
      846             if available buf_temp-browse-handle
      847             then do:
      848             end.
      849             else do:
      850               create buf_temp-diasize-handle .
      851               assign
      852                 buf_temp-diasize-handle.handle-value  = v-object-handle
      853                 buf_temp-diasize-handle.save-position = v-object-handle :row
      854               .
      855             end.
      856           end.
      857           assign
      858             v-object-handle = v-object-handle :next-sibling
      859           .
      860         end.
      861         assign
      862           v-field-group-handle = v-field-group-handle :next-sibling
      863         .
      864       end.
      865       do with frame Dialog-Frame
      866       :
      867         hide v-diasize-resize-button .
      868         assign
      869           v-diasize-resize-button :row    = 1
      870           v-diasize-resize-button :column = 1
      871         .
      872       end.
      873       if p-change-value > 0
      874       then do:
      875         if frame Dialog-Frame :scrollable = true
      876         then do:
      877           assign
      878             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      879             no-error .
      880           if error-status :error
      881           or error-status :get-message(1) <> ""
      882           then do:
      883             undo move_block, retry move_block .
      884           end.
      885         end.
      886         assign
      887           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      888           no-error .
      889         if error-status :error
      890         or error-status :get-message(1) <> ""
      891         then do:
      892           undo move_block, retry move_block .
      893         end.
      894         assign
      895           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      896           no-error .
      897         if error-status :error
      898         or error-status :get-message(1) <> ""
      899         then do:
      900           undo move_block, retry move_block .
      901         end.
      902         for each buf_temp-browse-handle
      903           where buf_temp-browse-handle.browse-type = 'height':u
      904         on error undo move_block, retry move_block
      905         :
      906           assign
      907             buf_temp-browse-handle.browse-handle :height
      908               = buf_temp-browse-handle.browse-handle :height + p-change-value
      909             no-error .
      910           if error-status :error
      911           or error-status :get-message(1) <> ""
      912           then do:
      913             undo move_block, retry move_block .
      914           end.
      915         end.
      916         for each buf_temp-diasize-handle
      917         on error undo move_block, retry move_block
      918         :
      919           assign
      920             v-object-handle = buf_temp-diasize-handle.handle-value
      921           .
      922           if v-object-handle <> v-diasize-resize-button
      923           then do:
      924             assign
      925               v-object-handle :row = v-object-handle :row + p-change-value
      926               no-error .
      927             if error-status :error
      928             or error-status :get-message(1) <> ""
      929             then do:
      930               undo move_block, retry move_block .
      931             end.
      932           end.
      933         end.
      934       end.
      935       else do:
      936         for each buf_temp-diasize-handle
      937         on error undo move_block, retry move_block
      938         :
      939           assign
      940             v-object-handle = buf_temp-diasize-handle.handle-value
      941           .
      942           if v-object-handle <> v-diasize-resize-button
      943           then do:
      944             assign
      945               v-object-handle :row = v-object-handle :row + p-change-value
      946               no-error .
      947             if error-status :error
      948             or error-status :get-message(1) <> ""
      949             then do:
      950               undo move_block, retry move_block .
      951             end.
      952           end.
      953         end.
      954         assign
      955           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      956           no-error .
      957         if error-status :error
      958         or error-status :get-message(1) <> ""
      959         then do:
      960           undo move_block, retry move_block .
      961         end.
      962         for each buf_temp-browse-handle
      963           where buf_temp-browse-handle.browse-type = 'height':u
      964         on error undo move_block, retry move_block
      965         :
      966           assign
      967             buf_temp-browse-handle.browse-handle :height
      968               = buf_temp-browse-handle.browse-handle :height + p-change-value
      969             no-error .
      970           if error-status :error
      971           or error-status :get-message(1) <> ""
      972           then do:
      973             undo move_block, retry move_block .
      974           end.
      975         end.
      976         assign
      977           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      978           no-error .
      979         if error-status :error
      980         or error-status :get-message(1) <> ""
      981         then do:
      982           undo move_block, retry move_block .
      983         end.
      984         if frame Dialog-Frame :scrollable = true
      985         then do:
      986           assign
      987             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      988             no-error .
      989           if error-status :error
      990           or error-status :get-message(1) <> ""
      991           then do:
      992             undo move_block, retry move_block .
      993           end.
      994         end.
      995       end.
      996       if p-move-resize = true
      997       then do:
      998         run diasize_position-resize-button in this-procedure .
      999       end.
     1000       if v-diasize-wndstore = true
     1001       then do:
     1002         if connected("ub") = true
     1003         then do:
     1004           define variable v-cntxt-db-num        as integer   no-undo .
     1005           define variable v-cntxt-userid        as character no-undo .
     1006           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1007                                             , OUTPUT v-cntxt-userid
     1008                                             ) .
     1009           run gbl/wndsizew.p
     1010             (input  v-cntxt-db-num
     1011             ,input  v-cntxt-userid
     1012             ,input  v-diasize-proc-name
     1013             ,input  'height':u
     1014             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1015             ) .
     1016         end.
     1017       end.
     1018     end.
     1019     assign
     1020       v-diasize-change-size = false
     1021     .
     1022   end procedure.
     1023   procedure diasize_set-height :
     1024     define input  parameter p-new-height  as decimal   no-undo .
     1025     define input  parameter p-move-resize as logical   no-undo .
     1026     do
     1027     on error undo, return error return-value
     1028     :
     1029       run diasize_change-height in this-procedure
     1030         (input  (p-new-height - frame Dialog-Frame :height)
     1031         ,input  p-move-resize
     1032         ) .
     1033     end.
     1034   end procedure.
     1035   procedure diasize_change-width :
     1036     define input  parameter p-change-value as decimal   no-undo .
     1037     define input  parameter p-move-resize  as logical   no-undo .
     1038     define variable v-field-group-handle   as handle    no-undo .
     1039     define variable v-object-handle        as handle    no-undo .
     1040     define variable v-frame-width          as decimal   no-undo .
     1041     define variable v-frame-virtual-width  as decimal   no-undo .
     1042     define variable v-browse-width         as decimal   no-undo .
     1043     define variable v-window-width         as decimal   no-undo .
     1044     define variable v-window-virtual-width as decimal   no-undo .
     1045     define variable v-change-sign          as integer   no-undo .
     1046     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1047     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1048     if p-change-value > 0
     1049     then do:
     1050       if frame Dialog-Frame :width + p-change-value >
     1051           session :width-chars
     1052       then do:
     1053         assign
     1054           p-change-value = session :width-chars - frame Dialog-Frame :width
     1055         .
     1056         if p-change-value <= 0
     1057         then do:
     1058           run diasize_position-resize-button in this-procedure .
     1059           return .
     1060         end.
     1061       end.
     1062     end.
     1063     if p-change-value < 0
     1064     then do:
     1065       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1066       then do:
     1067         assign
     1068           p-change-value = v-diasize-orig-frame-width
     1069                          - frame Dialog-Frame :width
     1070         .
     1071         if p-change-value >= 0
     1072         then do:
     1073           run diasize_position-resize-button in this-procedure .
     1074           return .
     1075         end.
     1076       end.
     1077     end.
     1078     if p-change-value >= 0
     1079     then do:
     1080       assign
     1081         v-change-sign = 1
     1082       .
     1083     end.
     1084     else do:
     1085       assign
     1086         v-change-sign = -1
     1087       .
     1088     end.
     1089     assign
     1090       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1091     .
     1092     if p-change-value = 0
     1093     then do:
     1094       run diasize_position-resize-button in this-procedure .
     1095       return .
     1096     end.
     1097     move_block:
     1098     do
     1099     on error undo move_block, leave move_block
     1100     :
     1101       if retry
     1102       then do:
     1103         do
     1104         on error undo move_block, leave move_block
     1105         :
     1106           if p-change-value > 0
     1107           then do:
     1108             for each buf_temp-diasize-handle
     1109             on error undo, next
     1110             :
     1111               assign
     1112                 v-object-handle = buf_temp-diasize-handle.handle-value
     1113               .
     1114               if v-object-handle <> v-diasize-resize-button
     1115               then do:
     1116                 assign
     1117                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1118                 .
     1119               end.
     1120             end.
     1121             assign
     1122               v-diasize-browse-handle :width = v-browse-width
     1123             .
     1124             for each buf_temp-browse-handle
     1125               where buf_temp-browse-handle.browse-type = 'width':u
     1126             on error undo, next
     1127             :
     1128               assign
     1129                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1130               .
     1131             end.
     1132             assign
     1133               frame Dialog-Frame :width = v-frame-width
     1134             .
     1135             if frame Dialog-Frame :scrollable = true
     1136             then do:
     1137               assign
     1138                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1139               .
     1140             end.
     1141             run diasize_position-resize-button in this-procedure .
     1142           end.
     1143           else do:
     1144             if frame Dialog-Frame :scrollable = true
     1145             then do:
     1146               assign
     1147                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1148               .
     1149             end.
     1150             assign
     1151               frame Dialog-Frame :width = v-frame-width
     1152             .
     1153             for each buf_temp-browse-handle
     1154               where buf_temp-browse-handle.browse-type = 'width':u
     1155             on error undo, next
     1156             :
     1157               assign
     1158                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1159               .
     1160             end.
     1161             assign
     1162               v-diasize-browse-handle :width = v-browse-width
     1163             .
     1164             for each buf_temp-diasize-handle
     1165             on error undo, next
     1166             :
     1167               assign
     1168                 v-object-handle = buf_temp-diasize-handle.handle-value
     1169               .
     1170               if v-object-handle <> v-diasize-resize-button
     1171               then do:
     1172                 assign
     1173                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1174                 .
     1175               end.
     1176             end.
     1177             run diasize_position-resize-button in this-procedure .
     1178           end.
     1179           assign
     1180             v-diasize-change-size = false
     1181           .
     1182           leave move_block .
     1183         end.
     1184       end.
     1185       assign
     1186         v-diasize-need-full-display = true
     1187       .
     1188       if v-diasize-change-size = false
     1189       then do:
     1190         assign
     1191           v-diasize-change-size = true
     1192         .
     1193       end.
     1194       else do:
     1195         return .
     1196       end.
     1197       assign
     1198         v-frame-width = frame Dialog-Frame :width
     1199         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1200         v-browse-width = v-diasize-browse-handle :width
     1201       .
     1202       for each buf_temp-browse-handle
     1203         where buf_temp-browse-handle.browse-type = 'width':u
     1204       :
     1205         assign
     1206           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1207         .
     1208       end.
     1209       for each buf_temp-diasize-handle
     1210       :
     1211         delete buf_temp-diasize-handle .
     1212       end.
     1213       assign
     1214         v-field-group-handle = frame Dialog-Frame :first-child
     1215       .
     1216       do while valid-handle(v-field-group-handle)
     1217       :
     1218         assign
     1219           v-object-handle = v-field-group-handle :first-child
     1220         .
     1221         do while valid-handle(v-object-handle)
     1222         :
     1223           if  v-object-handle <> v-diasize-browse-handle :handle
     1224           and v-object-handle <> v-diasize-resize-button
     1225           and can-query(v-object-handle, "row")
     1226           and can-query(v-object-handle, "height")
     1227           and ( v-object-handle :col + v-object-handle :width
     1228                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1229               )
     1230           then do:
     1231             find first buf_temp-browse-handle
     1232               where buf_temp-browse-handle.browse-type   = 'width':u
     1233                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1234               no-error .
     1235             if available buf_temp-browse-handle
     1236             then do:
     1237             end.
     1238             else do:
     1239               create buf_temp-diasize-handle .
     1240               assign
     1241                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1242                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1243               .
     1244             end.
     1245           end.
     1246           assign
     1247             v-object-handle = v-object-handle :next-sibling
     1248           .
     1249         end.
     1250         assign
     1251           v-field-group-handle = v-field-group-handle :next-sibling
     1252         .
     1253       end.
     1254       do with frame Dialog-Frame
     1255       :
     1256         hide v-diasize-resize-button .
     1257         v-diasize-resize-button :row = 1.
     1258         v-diasize-resize-button :column = 1.
     1259       end.
     1260       if p-change-value > 0
     1261       then do:
     1262         if frame Dialog-Frame :scrollable = true
     1263         then do:
     1264           assign
     1265             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1266             no-error .
     1267           if error-status :error
     1268           or error-status :get-message(1) <> ""
     1269           then do:
     1270             undo move_block, retry move_block.
     1271           end.
     1272         end.
     1273         assign
     1274           frame Dialog-Frame :width = v-frame-width + p-change-value
     1275           no-error .
     1276         if error-status :error
     1277         or error-status :get-message(1) <> ""
     1278         then do:
     1279           undo move_block, retry move_block.
     1280         end.
     1281         assign
     1282           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1283         no-error .
     1284         if error-status :error
     1285         or error-status :get-message(1) <> ""
     1286         then do:
     1287           undo move_block, retry move_block.
     1288         end.
     1289         for each buf_temp-browse-handle
     1290           where buf_temp-browse-handle.browse-type = 'width':u
     1291         on error undo move_block, retry move_block
     1292         :
     1293           assign
     1294             buf_temp-browse-handle.browse-handle :width
     1295               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1296             no-error .
     1297           if error-status :error
     1298           or error-status :get-message(1) <> ""
     1299           then do:
     1300             undo move_block, retry move_block .
     1301           end.
     1302         end.
     1303         for each buf_temp-diasize-handle
     1304         on error undo move_block, retry move_block
     1305         :
     1306           assign
     1307             v-object-handle = buf_temp-diasize-handle.handle-value
     1308           .
     1309           if v-object-handle <> v-diasize-resize-button
     1310           then do:
     1311             assign
     1312               v-object-handle :col = v-object-handle :col + p-change-value
     1313               no-error .
     1314             if error-status :error
     1315             or error-status :get-message(1) <> ""
     1316             then do:
     1317               undo move_block, retry move_block .
     1318             end.
     1319           end.
     1320         end.
     1321       end.
     1322       else do:
     1323         for each buf_temp-diasize-handle
     1324         on error undo move_block, retry move_block
     1325         :
     1326           assign
     1327             v-object-handle = buf_temp-diasize-handle.handle-value
     1328           .
     1329           if v-object-handle <> v-diasize-resize-button
     1330           then do:
     1331             assign
     1332               v-object-handle :col = v-object-handle :col + p-change-value
     1333               no-error .
     1334             if error-status :error
     1335             or error-status :get-message(1) <> ""
     1336             then do:
     1337               undo move_block, retry move_block .
     1338             end.
     1339           end.
     1340         end.
     1341         for each buf_temp-browse-handle
     1342           where buf_temp-browse-handle.browse-type = 'width':u
     1343         on error undo move_block, retry move_block
     1344         :
     1345           assign
     1346             buf_temp-browse-handle.browse-handle :width
     1347               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1348             no-error .
     1349           if error-status :error
     1350           or error-status :get-message(1) <> ""
     1351           then do:
     1352             undo move_block, retry move_block .
     1353           end.
     1354         end.
     1355         assign
     1356           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1357           no-error .
     1358         if error-status :error
     1359         or error-status :get-message(1) <> ""
     1360         then do:
     1361           undo move_block, retry move_block.
     1362         end.
     1363         assign
     1364           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1365         no-error .
     1366         if error-status :error
     1367         or error-status :get-message(1) <> ""
     1368         then do:
     1369           undo move_block, retry move_block.
     1370         end.
     1371         if frame Dialog-Frame :scrollable = true
     1372         then do:
     1373           assign
     1374             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1375           no-error .
     1376           if error-status :error
     1377           or error-status :get-message(1) <> ""
     1378           then do:
     1379             undo move_block, retry move_block.
     1380           end.
     1381         end.
     1382       end.
     1383       if p-move-resize
     1384       then do:
     1385         run diasize_position-resize-button in this-procedure .
     1386       end.
     1387       if v-diasize-wndstore = true
     1388       then do:
     1389         if connected("ub") = true
     1390         then do:
     1391           define variable v-cntxt-db-num        as integer   no-undo .
     1392           define variable v-cntxt-userid        as character no-undo .
     1393           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1394                                             , OUTPUT v-cntxt-userid
     1395                                             ) .
     1396           run gbl/wndsizew.p
     1397             (input  v-cntxt-db-num
     1398             ,input  v-cntxt-userid
     1399             ,input  v-diasize-proc-name
     1400             ,input  'width':u
     1401             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1402             ) .
     1403         end.
     1404       end.
     1405     end.
     1406     assign
     1407       v-diasize-change-size = false
     1408     .
     1409   end procedure.
     1410   procedure diasize_set-width :
     1411     define input  parameter p-new-width  as decimal   no-undo .
     1412     define input  parameter p-move-resize as logical   no-undo .
     1413     do
     1414     on error undo, return error return-value
     1415     :
     1416       run diasize_change-width in this-procedure
     1417         (input  (p-new-width - frame Dialog-Frame :width)
     1418         ,input  p-move-resize
     1419         ) .
     1420     end.
     1421   end procedure.
     1422   procedure diasize_position-resize-button :
     1423     do with frame Dialog-Frame
     1424     :
     1425       hide v-diasize-resize-button .
     1426       assign
     1427         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1428                     - 1
     1429                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1430         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1431                     - 1
     1432                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1433       .
     1434       view v-diasize-resize-button .
     1435     end.
     1436   end procedure.
     1437   on alt-right anywhere
     1438   do:
     1439     run diasize_change-width in this-procedure
     1440       (input 1
     1441       ,input true
     1442       ) .
     1443     return no-apply .
     1444   end.
     1445   on alt-left anywhere
     1446   do:
     1447     run diasize_change-width in this-procedure
     1448       (input -1
     1449       ,input true
     1450       ) .
     1451     return no-apply .
     1452   end.
     1453   on alt-down anywhere
     1454   do:
     1455     run diasize_change-height in this-procedure
     1456       (input 1
     1457       ,input true
     1458       ) .
     1459     return no-apply .
     1460   end.
     1461   on alt-up anywhere
     1462   do:
     1463     run diasize_change-height in this-procedure
     1464       (input -1
     1465       ,input true
     1466       ) .
     1467     return no-apply .
     1468   end.
     1469   on alt-enter of frame Dialog-Frame
     1470   do:
     1471     run diasize_maximize in this-procedure
     1472       (input  ?
     1473       ).
     1474     return no-apply .
     1475   end.
     1476   procedure diasize_end-move :
     1477     do
     1478     on error undo, return error return-value
     1479     :
     1480       define variable v-row-delta as decimal   no-undo .
     1481       define variable v-col-delta as decimal   no-undo .
     1482       define variable v-new-row as decimal   no-undo .
     1483       define variable v-new-col as decimal   no-undo .
     1484       assign
     1485         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1486         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1487       .
     1488       assign
     1489         v-row-delta = v-new-row - frame Dialog-Frame :height
     1490         v-col-delta = v-new-col - frame Dialog-Frame :width
     1491       .
     1492       run diasize_change-height in this-procedure
     1493         (input v-row-delta
     1494         ,input true
     1495         ) .
     1496       run diasize_change-width in this-procedure
     1497         (input v-col-delta
     1498         ,input true
     1499         ) .
     1500     end.
     1501   end procedure.
     1502   procedure diasize_maximize :
     1503     define input  parameter p-action as logical   no-undo .
     1504     do
     1505     on error undo, return error return-value
     1506     :
     1507       if p-action = ?
     1508       then do:
     1509         if v-diasize-need-maximize = true
     1510         then do:
     1511           assign
     1512             p-action = true
     1513           .
     1514         end.
     1515         else do:
     1516           assign
     1517             p-action = false
     1518           .
     1519         end.
     1520       end.
     1521       if p-action = true
     1522       then do:
     1523         run diasize_change-height in this-procedure
     1524           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1525               - frame Dialog-Frame :height-chars
     1526           ,input true
     1527           ) .
     1528         run diasize_change-width in this-procedure
     1529           (input session :width-chars
     1530               - frame Dialog-Frame :width-chars
     1531           ,input true
     1532           ) .
     1533         assign
     1534           v-diasize-need-maximize = false
     1535         .
     1536       end.
     1537       else do:
     1538         run diasize_change-width in this-procedure
     1539           (input v-diasize-orig-frame-width
     1540               - frame Dialog-Frame :width-chars
     1541           ,input true
     1542           ) .
     1543         run diasize_change-height in this-procedure
     1544           (input v-diasize-orig-frame-height
     1545               - frame Dialog-Frame :height-chars
     1546           ,input true
     1547           ) .
     1548         assign
     1549           v-diasize-need-maximize = true
     1550         .
     1551       end.
     1552     end.
     1553   end procedure.
     1554   procedure diasize_restore-orig-size :
     1555     do
     1556     on error undo, return error return-value
     1557     :
     1558       assign
     1559         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1560         v-diasize-current-frame-height = frame Dialog-Frame :height
     1561       .
     1562       run diasize_set-height in this-procedure
     1563         (input  v-diasize-orig-frame-height
     1564         ,input  true
     1565         ) .
     1566       run diasize_set-width in this-procedure
     1567         (input  v-diasize-orig-frame-width
     1568         ,input  true
     1569         ) .
     1570     end.
     1571   end procedure.
     1572   procedure diasize_restore-current-size :
     1573     do
     1574     on error undo, return error return-value
     1575     :
     1576       run diasize_set-height in this-procedure
     1577         (input  v-diasize-current-frame-height
     1578         ,input  true
     1579         ) .
     1580       run diasize_set-width in this-procedure
     1581         (input  v-diasize-current-frame-width
     1582         ,input  true
     1583         ) .
     1584     end.
     1585   end procedure.
     1586   procedure diasize_set-browse-handle :
     1587     define input  parameter p-browse-handle as handle   no-undo .
     1588     define buffer buf_temp-browse-handle for temp-browse-handle .
     1589     do
     1590     on error undo, return error return-value
     1591     :
     1592       assign
     1593         v-diasize-browse-handle = p-browse-handle
     1594       .
     1595       for each buf_temp-browse-handle
     1596       on error undo, return error return-value
     1597       :
     1598         delete buf_temp-browse-handle .
     1599       end.
     1600     end.
     1601   end procedure.
     1602   procedure diasize_add_browse :
     1603     define input  parameter p-browse-type   as character no-undo .
     1604     define input  parameter p-browse-handle as handle    no-undo .
     1605     define buffer buf_temp-browse-handle for temp-browse-handle .
     1606     do
     1607     on error undo, return error return-value
     1608     :
     1609       assign
     1610         v-diasize-browse-number = v-diasize-browse-number + 1
     1611       .
     1612       create buf_temp-browse-handle .
     1613       assign
     1614         buf_temp-browse-handle.browse-type   = p-browse-type
     1615         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1616         buf_temp-browse-handle.browse-handle = p-browse-handle
     1617       .
     1618     end.
     1619   end procedure.
     1620   procedure diasize_init :
     1621     define variable v-default-value    as logical   no-undo .
     1622     define variable v-restore-saved    as logical   no-undo .
     1623     define variable v-resize-value-str as character no-undo .
     1624     do
     1625     on error undo, return error return-value
     1626     :
     1627       do with frame Dialog-Frame
     1628       :
     1629         assign
     1630           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1631           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1632           v-diasize-browse-handle     = browse BR-code-range :handle
     1633         .
     1634         create button v-diasize-resize-button
     1635         assign
     1636           parent        = frame Dialog-Frame :first-child
     1637           label         = "s"
     1638           height-pixels = 16
     1639           width-pixels  = 16
     1640           visible       = true
     1641           sensitive     = true
     1642           movable       = true
     1643           triggers:
     1644             on end-move persistent run diasize_end-move in this-procedure .
     1645           end triggers.
     1646         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1647         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1648         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1649         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1650         assign
     1651           v-diasize-wndmax = false
     1652         .
     1653         if connected("ub") = true
     1654         then do:
     1655           define variable v-cntxt-db-num        as integer   no-undo .
     1656           define variable v-cntxt-userid        as character no-undo .
     1657           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1658                                             , OUTPUT v-cntxt-userid
     1659                                             ) .
     1660           run gbl/wndpar_r.p
     1661             (input  v-cntxt-db-num
     1662             ,input  v-cntxt-userid
     1663             ,input  'wndmax':U
     1664             ,output v-diasize-wndmax
     1665             ,output v-default-value
     1666             ) .
     1667         end.
     1668         assign
     1669           v-diasize-wndstore = false
     1670         .
     1671         if connected("ub") = true
     1672         then do:
     1673           run gbl/wndpar_r.p
     1674             (input  v-cntxt-db-num
     1675             ,input  v-cntxt-userid
     1676             ,input  'wndstore':U
     1677             ,output v-diasize-wndstore
     1678             ,output v-default-value
     1679             ) .
     1680         end.
     1681         assign
     1682           v-diasize-proc-name = entry(1, program-name(2), '.')
     1683         .
     1684         if v-diasize-wndstore = true
     1685         then do:
     1686           assign
     1687             v-restore-saved = false
     1688           .
     1689           if connected("ub") = true
     1690           then do:
     1691             run gbl/wndsizer.p
     1692               (input  v-cntxt-db-num
     1693               ,input  v-cntxt-userid
     1694               ,input  v-diasize-proc-name
     1695               ,input  'height':u
     1696               ,output v-resize-value-str
     1697               ) .
     1698             if v-resize-value-str <> '':U
     1699             then do:
     1700               run diasize_change-height in this-procedure
     1701                 (input  integer(v-resize-value-str)
     1702                 ,input  true
     1703                 ) .
     1704               assign
     1705                 v-restore-saved = true
     1706               .
     1707             end.
     1708           end.
     1709           if connected("ub") = true
     1710           then do:
     1711             run gbl/wndsizer.p
     1712               (input  v-cntxt-db-num
     1713               ,input  v-cntxt-userid
     1714               ,input  v-diasize-proc-name
     1715               ,input  'width':u
     1716               ,output v-resize-value-str
     1717               ) .
     1718             if v-resize-value-str <> '':U
     1719             then do:
     1720               run diasize_change-width in this-procedure
     1721                 (input  integer(v-resize-value-str)
     1722                 ,input  true
     1723                 ) .
     1724               assign
     1725                 v-restore-saved = true
     1726               .
     1727             end.
     1728           end.
     1729           if v-restore-saved <> true
     1730           then do:
     1731             if v-diasize-wndmax = true
     1732             then do:
     1733               run diasize_maximize in this-procedure
     1734                 (input  true
     1735                 ) .
     1736             end.
     1737           end.
     1738         end.
     1739         else do:
     1740           if v-diasize-wndmax = true
     1741           then do:
     1742             run diasize_maximize in this-procedure
     1743               (input  true
     1744               ) .
     1745           end.
     1746         end.
     1747       end.
     1748     end.
     1749   end procedure.
     1750   procedure diasize_need-full-display :
     1751     define output parameter p-need-full-display as logical   no-undo .
     1752     do
     1753     on error undo, return error return-value
     1754     :
     1755       assign
     1756         p-need-full-display = v-diasize-need-full-display
     1757       .
     1758       assign
     1759         v-diasize-need-full-display = false
     1760       .
     1761     end.
     1762   end procedure.
     1763   procedure get-context :
     1764      define output parameter p-db-num as integer          no-undo.
     1765      define output parameter p-user-id as character        no-undo.
     1766      define variable v-login               as character    no-undo.
     1767      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1768      define buffer buf_user-login  for ub.user-login .
     1769      do
     1770      on error undo, return error
     1771      :
     1772            FIND FIRST buf_sys-ctrl no-lock.
     1773            ASSIGN
     1774               v-login = USERID("ub")
     1775               p-db-num = buf_sys-ctrl.db-num
     1776            .
     1777            FIND FIRST buf_user-login
     1778                 WHERE buf_user-login.db-num = p-db-num
     1779                   AND buf_user-login.user-login = v-login
     1780                 no-lock
     1781                 no-error
     1782                 .
     1783            IF AVAILABLE buf_user-login
     1784            THEN DO:
     1785               assign
     1786                  p-user-id = buf_user-login.user-id
     1787               .
     1788            END.
     1789      end.
     1790   end procedure.
     1791       run diasize_init in this-procedure .
     1792   MAIN-BLOCK:
     1793   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1794      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1795     IF p-obj-type <> 'орг':U
     1796     AND p-obj-type <> 'чел':U
     1797     AND p-obj-type <> 'маг':U
     1798     AND p-obj-type <> 'скл':U THEN DO:
     1799       message
     1800       vss-workfile vss-revision vss-description skip
     1801       "Неверное значение параметров вызова p-obj-type"
     1802       p-obj-type
     1803       view-as alert-box ERROR.
     1804       return.
     1805     END.
     1806     IF (p-obj-type = 'маг':U
     1807     or p-obj-type = 'скл':U) AND p-db-num <> 0 THEN DO:
     1808         message
     1809         vss-workfile vss-revision vss-description skip
     1810         substitute("Неверное значение параметров вызова p-db-num=&1 для p-obj-type=&2"
     1811                   , p-db-num
     1812                   , p-obj-type)
     1813         view-as alert-box ERROR.
     1814         return.
     1815     END.
     1816     if p-obj-type = 'орг':U
     1817     or p-obj-type = 'чел':U then
     1818     run fill-tt in this-procedure ( input (if p-obj-type = 'орг':U then 'fmgb':U else 'pngb':U)) .
     1819     run Myenable in this-procedure .
     1820     WAIT-FOR GO OF FRAME Dialog-Frame.
     1821   END.
     1822   RUN disable_UI in this-procedure .
     1823   PROCEDURE assign-and-find :
     1824   ASSIGN
     1825   f-cv = tt-code-range.first-code.
     1826   DISPLAY
     1827   f-cv
     1828   WITH FRAME Dialog-Frame.
     1829   RUN proc-b-find IN THIS-PROCEDURE NO-ERROR.
     1830   END PROCEDURE.
     1831   PROCEDURE check-code :
     1832   DEFINE INPUT PARAMETER p-obj-type AS CHARACTER NO-UNDO.
     1833   DEFINE INPUT PARAMETER p-ii AS integer NO-UNDO.
     1834   DEFINE output PARAMETER p-free AS logical NO-UNDO.
     1835   define variable v-result as logical no-undo .
     1836   DEFINE BUFFER buf_Clients FOR ub.clients.
     1837   CASE p-obj-type:
     1838     WHEN 'орг':U OR WHEN 'чел':U THEN do:
     1839       assign
     1840       v-result = calc-range(
     1841                       input p-db-num
     1842                       ,input p-ii
     1843                       ,input (IF p-obj-type = 'орг':U THEN 'fmgb':U ELSE 'pngb':U)
     1844                       ) no-error .
     1845       if v-result = ? then do:
     1846         MESSAGE
     1847         SUBSTITUTE("Код нового контрагента типа &1 может принимать значения&2" +
     1848                     "ТОЛЬКО ВНУТРИ УКАЗАННЫХ ДИАПАЗОНОВ"
     1849                   , p-obj-type
     1850                   , chr(10)
     1851                   )
     1852         VIEW-AS ALERT-BOX ERROR.
     1853         RETURN error.
     1854       END.
     1855       if v-result = no then return "next":U.
     1856     END.
     1857   END CASE.
     1858   FIND FIRST buf_Clients NO-LOCK WHERE
     1859             buf_clients.obj-type = p-obj-type
     1860         AND buf_clients.obj-code = p-ii NO-ERROR.
     1861   IF NOT AVAILABLE buf_clients THEN DO:
     1862     ASSIGN
     1863     p-free = YES.
     1864     RETURN.
     1865   END.
     1866   END PROCEDURE.
     1867   PROCEDURE disable_UI :
     1868     HIDE FRAME Dialog-Frame.
     1869   END PROCEDURE.
     1870   PROCEDURE enable_UI :
     1871     DISPLAY RS-up-down F-cv F-start FILL-IN-4 FILL-IN-5 F-end F-free-code
     1872         WITH FRAME Dialog-Frame.
     1873     ENABLE B-exit b-quit B-Help RS-up-down F-cv B-find BR-code-range
     1874         WITH FRAME Dialog-Frame.
     1875     VIEW FRAME Dialog-Frame.
     1876     OPEN QUERY BR-code-range FOR EACH tt-code-range BY first-code.
     1877   END PROCEDURE.
     1878   PROCEDURE fill-tt :
     1879   define input  parameter p-range-type like ub.code-range.range-type no-undo .
     1880   define variable v-stts       as character no-undo .
     1881   define VARIABLE ii AS integer no-undo .
     1882   define VARIABLE v-seq-val AS integer no-undo .
     1883   define buffer buf_code-range for ub.code-range .
     1884   IF p-range-type = 'fmgb':U THEN
     1885   ASSIGN
     1886   v-seq-val = current-value(s-fmgb-code, ub).
     1887   IF p-range-type = 'pngb':U THEN
     1888   ASSIGN
     1889   v-seq-val = current-value(s-pngb-code, ub).
     1890   DO ii = 1 TO 2 :
     1891       IF ii = 1 THEN v-stts = 'u':U.
     1892       IF ii = 2 THEN v-stts = 'a':U.
     1893       FOR EACH buf_code-range no-lock
     1894             where buf_code-range.range-type = p-range-type
     1895               and buf_code-range.db-num = p-db-num
     1896               and buf_code-range.stts = v-stts:
     1897           create tt-code-range .
     1898           BUFFER-COPY buf_code-range TO tt-code-range.
     1899           IF v-stts = 'a'
     1900           and tt-code-range.last-code >= v-seq-val
     1901           and tt-code-range.last-code <= v-seq-val
     1902           THEN DO:
     1903               ASSIGN
     1904               tt-code-range.last-code = v-seq-val.
     1905           END.
     1906           release tt-code-range.
     1907       END.
     1908   END.
     1909   output close.
     1910   END PROCEDURE.
     1911   PROCEDURE MyEnable :
     1912   DEFINE VARIABLE v-log AS LOGICAL NO-UNDO.
     1913   CASE p-obj-type:
     1914       WHEN 'орг':U
     1915       OR
     1916       WHEN 'чел':U THEN DO:
     1917          FRAME Dialog-Frame:TITLE = substitute("&1 для контрагента типа &2"
     1918                                                 , FRAME Dialog-Frame:TITLE
     1919                                                 , p-obj-type).
     1920       END.
     1921       WHEN 'маг':U
     1922       OR
     1923       WHEN 'скл':U THEN DO:
     1924         ASSIGN
     1925         f-start = 1
     1926         f-end = 99999
     1927         .
     1928         FRAME Dialog-Frame:TITLE = substitute("&1 для &2"
     1929                                                , FRAME Dialog-Frame:TITLE
     1930                                                , p-obj-type).
     1931       END.
     1932   END CASE.
     1933   DISPLAY
     1934   RS-up-down
     1935   f-cv
     1936   f-start  WHEN (p-obj-type = 'маг':U OR p-obj-type = 'скл':U)
     1937   f-end    WHEN (p-obj-type = 'маг':U OR p-obj-type = 'скл':U)
     1938   WITH FRAME Dialog-Frame.
     1939   ENABLE
     1940   f-cv
     1941   B-exit
     1942   b-quit
     1943   B-Help
     1944   RS-up-down
     1945   B-find
     1946   br-code-range WHEN (p-obj-TYPE = 'орг':U OR p-obj-type = 'чел':U)
     1947   WITH FRAME Dialog-Frame.
     1948   VIEW FRAME Dialog-Frame.
     1949   IF (p-obj-type = 'маг':U
     1950       or p-obj-type = 'скл':U) THEN DO:
     1951       HIDE
     1952       br-code-range.
     1953   END.
     1954   else do:
     1955     OPEN QUERY br-code-range FOR EACH tt-code-range BY first-code.
     1956   end.
     1957   END PROCEDURE.
     1958   PROCEDURE proc-b-find :
     1959   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     1960   DEFINE VARIABLE v-border AS INTEGER NO-UNDO.
     1961   DEFINE VARIABLE v-free AS LOGICAL NO-UNDO.
     1962   define variable v-0 as integer no-undo .
     1963   DEFINE BUFFER buf_tt-code-range FOR tt-code-range.
     1964   ASSIGN
     1965   FRAME Dialog-Frame
     1966   f-cv
     1967   RS-up-down.
     1968   CASE p-obj-type:
     1969     WHEN  'маг':U
     1970     OR
     1971     WHEN 'скл':U THEN DO:
     1972       IF f-cv < F-start
     1973       OR f-cv > F-end THEN DO:
     1974         MESSAGE
     1975         "Выберите число, которое попадает в указанные диапазоны"
     1976         VIEW-AS ALERT-BOX.
     1977         return error.
     1978       END.
     1979       CASE rs-up-down:
     1980         WHEN -1  THEN DO:
     1981           v-border = f-start.
     1982          _ii:
     1983           DO ii = f-cv TO v-border BY -1:
     1984             run waitfram-show in this-procedure ( input substitute("Проверка: код &1", ii )) no-error .
     1985             RUN check-code IN THIS-PROCEDURE (
     1986                                               input p-obj-type
     1987                                              ,input ii
     1988                                              ,OUTPUT v-free) no-error.
     1989             if error-status:error then do:
     1990               run waitfram-hide in this-procedure .
     1991               return error.
     1992             end.
     1993             if return-value = "next" then next _ii.
     1994             IF v-free THEN DO:
     1995               run waitfram-hide in this-procedure .
     1996               ASSIGN
     1997               f-free-code = ii
     1998               f-free-code:LABEL = substitute("Первый свободный код &1 &2"
     1999                                             ,(IF rs-up-down = -1 THEN "<" ELSE ">")
     2000                                             , f-cv).
     2001               DISPLAY
     2002               f-free-code WITH FRAME Dialog-Frame.
     2003               return.
     2004             END.
     2005           END.
     2006         END.
     2007         WHEN 1  THEN DO:
     2008           v-border = f-end.
     2009             _ii:
     2010             DO ii = f-cv TO v-border:
     2011               run waitfram-show in this-procedure ( input substitute("Проверка: код &1", ii )).
     2012               RUN check-code IN THIS-PROCEDURE ( input p-obj-type
     2013                                                , input ii
     2014                                                , OUTPUT v-free) no-error .
     2015               if error-status:error then do:
     2016                   run waitfram-hide in this-procedure .
     2017                   return error.
     2018               end.
     2019               if return-value = "next" then next _ii.
     2020               IF v-free THEN DO:
     2021                 run waitfram-hide in this-procedure .
     2022                 ASSIGN
     2023                 f-free-code = ii
     2024                 f-free-code:LABEL = substitute("Первый свободный код &1 &2"
     2025                                                 ,(IF rs-up-down = -1 THEN "<=" ELSE ">=")
     2026                                                 , f-cv).
     2027                 DISPLAY
     2028                 f-free-code WITH FRAME Dialog-Frame.
     2029                 return.
     2030               END.
     2031           END.
     2032         END.
     2033       END CASE.
     2034     END.
     2035     WHEN 'орг':U
     2036     OR
     2037     WHEN 'чел':U THEN DO:
     2038       CASE rs-up-down:
     2039         WHEN -1  THEN DO:
     2040           find FIRST buf_tt-code-range WHERE
     2041                    buf_tt-code-range.last-code >= f-cv NO-ERROR.
     2042           IF AVAILABLE buf_tt-code-range THEN DO:
     2043             ASSIGN
     2044             v-border = buf_tt-code-range.last-code.
     2045             _tt:
     2046             FOR EACH buf_tt-code-range WHERE buf_tt-code-range.last-code <= v-border
     2047             BY buf_tt-code-range.last-code
     2048             DESCENDING:
     2049               assign
     2050               v-0 = buf_tt-code-range.last-code
     2051               .
     2052               if v-0 = v-border then do:
     2053                   assign
     2054                   v-0 = f-cv - 1.
     2055                   if v-0 < buf_tt-code-range.first-code then next _tt.
     2056               end.
     2057             _ii:
     2058               DO ii = v-0 TO buf_tt-code-range.first-code BY -1:
     2059                 run waitfram-show in this-procedure ( input substitute("Проверка: код &1", ii )).
     2060                 RUN check-code IN THIS-PROCEDURE (
     2061                                                   input p-obj-type
     2062                                                 , input ii
     2063                                                 , OUTPUT v-free) no-error .
     2064                 if error-status:error then do:
     2065                    run waitfram-hide in this-procedure .
     2066                    return error.
     2067                 end.
     2068                 if return-value = "next" then next _ii.
     2069                 IF v-free THEN DO:
     2070                   run waitfram-hide in this-procedure .
     2071                   ASSIGN
     2072                   f-free-code = ii
     2073                   f-free-code:LABEL = substitute("Первый свободный код &1 &2"
     2074                                                 ,(IF rs-up-down = -1 THEN "<" ELSE ">")
     2075                                                 , f-cv).
     2076                   DISPLAY
     2077                   f-free-code WITH FRAME Dialog-Frame.
     2078                   return.
     2079                 END.
     2080               END.
     2081             END.
     2082           END.
     2083         END.
     2084         WHEN  1 THEN DO:
     2085           find last buf_tt-code-range WHERE
     2086                    buf_tt-code-range.first-code <= f-cv NO-ERROR.
     2087           IF AVAILABLE buf_tt-code-range THEN DO:
     2088             ASSIGN
     2089             v-border = buf_tt-code-range.first-code.
     2090             _tt:
     2091             FOR EACH buf_tt-code-range WHERE buf_tt-code-range.first-code >= v-border
     2092             BY buf_tt-code-range.first-code:
     2093               assign
     2094               v-0 = buf_tt-code-range.first-code
     2095               .
     2096               if v-0 = v-border then do:
     2097                   assign
     2098                   v-0 = f-cv + 1.
     2099                   if v-0 > buf_tt-code-range.last-code then next _tt.
     2100               end.
     2101               _ii:
     2102               DO ii = v-0 TO buf_tt-code-range.last-code BY 1:
     2103                 run waitfram-show in this-procedure ( input substitute("Проверка: код &1", ii )).
     2104                 RUN check-code IN THIS-PROCEDURE (
     2105                                                    input p-obj-type
     2106                                                  , input ii
     2107                                                  , OUTPUT v-free) no-error .
     2108                 if error-status:error then do:
     2109                    run waitfram-hide in this-procedure .
     2110                    return error.
     2111                 end.
     2112                 if return-value = "next" then next _ii.
     2113                 IF v-free THEN DO:
     2114                   run waitfram-hide in this-procedure .
     2115                   ASSIGN
     2116                   f-free-code = ii
     2117                   f-free-code:LABEL = substitute("Первый свободный код &1 &2"
     2118                                                 ,(IF rs-up-down = -1 THEN "<" ELSE ">")
     2119                                                 , f-cv).
     2120                   DISPLAY
     2121                   f-free-code WITH FRAME Dialog-Frame.
     2122                   return.
     2123                 END.
     2124               END.
     2125             END.
     2126           END.
     2127         END.
     2128       END CASE.
     2129     END.
     2130   END CASE.
     2131   IF NOT v-free THEN DO:
     2132     run waitfram-hide in this-procedure .
     2133     ASSIGN
     2134     f-free-code = ?.
     2135     DISPLAY
     2136     f-free-code WITH FRAME Dialog-Frame.
     2137   END.
     2138   END PROCEDURE.
