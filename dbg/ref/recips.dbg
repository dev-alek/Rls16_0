     5296   initial "@(#)$Workfile$ $Revision$".
     5297   function fbrnutro_is-global-recipe RETURNS logical
     5298     ( input p-recipe-code as character
     5299     )
     5300   :
     5301     define variable v-is-global-recipe as logical   no-undo .
     5302     run fbrnutro_proc-is-global-recipe in this-procedure ( input p-recipe-code
     5303                                                          , output v-is-global-recipe
     5304                                                          ) no-error .
     5305     if error-status :error = yes
     5306     then do:
     5307       assign
     5308         v-is-global-recipe = no
     5309       .
     5310     end.
     5311     return v-is-global-recipe .
     5312   end function.
     5313   function fbrnutro_get-gds-recipe-nutrition-by-code returns decimal
     5314     ( input p-recipe-code as character
     5315     , input p-artic       as character
     5316     , input p-prod-type   as character
     5317     , input p-prod-code   as integer
     5318     , input p-attr-code   as character
     5319     )
     5320   :
     5321     define variable v-nutro as decimal   no-undo .
     5322     run fbrnutro_proc-get-gds-recipe-nutrition-by-code in this-procedure ( input  p-recipe-code
     5323                                                                          , input  p-artic
     5324                                                                          , input  p-prod-type
     5325                                                                          , input  p-prod-code
     5326                                                                          , input  p-attr-code
     5327                                                                          , output v-nutro
     5328                                                                          ) no-error .
     5329     if error-status :error = yes
     5330     then do:
     5331       assign
     5332         v-nutro = ?
     5333       .
     5334     end.
     5335     return v-nutro.
     5336   end function.
     5337   function fbrnutro_get-recipe-nutrition-by-code returns decimal
     5338     ( input p-recipe-code as character
     5339     , input p-artic       as character
     5340     , input p-prod-type   as character
     5341     , input p-prod-code   as integer
     5342     , input p-attr-code   as character
     5343     , input p-recipe-qnty as decimal
     5344     )
     5345   :
     5346     define variable v-nutro-value as decimal   no-undo .
     5347     run fbrnutro_proc-get-recipe-nutrition-by-code in this-procedure ( input p-recipe-code
     5348                                                                      , input p-artic
     5349                                                                      , input p-prod-type
     5350                                                                      , input p-prod-code
     5351                                                                      , input p-attr-code
     5352                                                                      , input p-recipe-qnty
     5353                                                                      , output v-nutro-value
     5354                                                                      ) no-error .
     5355     if error-status :error = yes
     5356     then do:
     5357       assign
     5358         v-nutro-value = ?
     5359       .
     5360     end.
     5361     return v-nutro-value.
     5362   END FUNCTION.
     5363   procedure fbrnutro_proc-is-global-recipe :
     5364     define input  parameter p-recipe-code       as character no-undo .
     5365     define output parameter p-is-global-recipe  as logical   no-undo .
     5366     define buffer buf_recipe    for ub.recipe .
     5367   do
     5368   on error undo, return error return-value
     5369   :
     5370     find first buf_recipe no-lock
     5371       where buf_recipe.recipe-code = p-recipe-code
     5372     no-error .
     5373     if not available buf_recipe
     5374     then do:
     5375       return .
     5376     end.
     5377     assign
     5378       p-is-global-recipe =  ( buf_recipe.host-code = 0    ) and
     5379                             ( buf_recipe.obj-type  = "":U ) and
     5380                             ( buf_recipe.obj-code  = 0    )
     5381     .
     5382   end.
     5383   end procedure.
     5384   procedure fbrnutro_proc-get-gds-recipe-nutrition-by-code :
     5385     define input  parameter p-recipe-code as character no-undo .
     5386     define input  parameter p-artic       as character no-undo .
     5387     define input  parameter p-prod-type   as character no-undo .
     5388     define input  parameter p-prod-code   as integer   no-undo .
     5389     define input  parameter p-attr-code   as character no-undo .
     5390     define output parameter p-nutro-value as decimal   no-undo .
     5391     define buffer buf_goods       for ub.goods .
     5392     define buffer buf_fbr-gds-obj for ub.fbr-gds-obj .
     5393     define variable v-attr-value    as character no-undo .
     5394     define variable v-attr-type     as character no-undo .
     5395     define variable v-attr-code     as character no-undo .
     5396     define variable v-nutro-value   as decimal   no-undo .
     5397     define variable v-is-global     as logical   no-undo .
     5398     define variable v-exist         as logical   no-undo .
     5399     define variable v-is-fbr-gds    as logical   no-undo .
     5400   do
     5401   on error undo, return error return-value
     5402   :
     5403     assign
     5404       p-nutro-value = ?
     5405     .
     5406     find first buf_goods no-lock
     5407         where buf_goods.artic     = p-artic
     5408           and buf_goods.prod-type = p-prod-type
     5409           and buf_goods.prod-code = p-prod-code
     5410     no-error .
     5411     if not available buf_goods
     5412     then do:
     5413       return .
     5414     end.
     5415     assign
     5416       v-is-fbr-gds = no
     5417     .
     5418     find first buf_fbr-gds-obj no-lock
     5419       where buf_fbr-gds-obj.obj-type = v-cntxt-obj-type
     5420         and buf_fbr-gds-obj.obj-code = v-cntxt-obj-code
     5421         and buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     5422     no-error .
     5423     if available buf_fbr-gds-obj
     5424     then do:
     5425       if  buf_fbr-gds-obj.is-semi-finished or
     5426           buf_fbr-gds-obj.is-menu
     5427       then do:
     5428         assign
     5429           v-is-fbr-gds = yes
     5430           v-is-global  = fbrnutro_is-global-recipe(buf_fbr-gds-obj.default-recipe-code)
     5431         .
     5432       end.
     5433     end.
     5434     if v-is-fbr-gds = no
     5435     then do:
     5436       assign
     5437         v-is-global = yes
     5438       .
     5439     end.
     5440     case p-attr-code
     5441     :
     5442       when 'calories':U
     5443       then do:
     5444         if v-is-global = yes
     5445         then do:
     5446           assign
     5447             v-attr-code = 'calories':U
     5448           .
     5449           run gds-attr-exist in this-procedure ( input  buf_goods.gds-code                                                          , input  v-attr-code                                                          , output v-exist                                                          ) no-error .                     if error-status :error = yes or                         v-exist = no                     then do:                       return .                      end.                     run gds-attr-value in this-procedure ( input  buf_goods.gds-code                                                          , input  v-attr-code                                                          , output v-attr-value                                                          , output v-attr-type                                                          ) no-error .                     if error-status :error                     then do:                       return .                      end.                     assign                       v-nutro-value = decimal( v-attr-value )                     no-error .                     if error-status :error = yes                     then do:                       return .                      end.
     5450         end.
     5451         else do:
     5452           assign
     5453             v-attr-code = 'calories-o':U
     5454           .
     5455           run gdsoattr-exist in this-procedure ( input buf_goods.gds-code                                                         , input v-cntxt-obj-type                                                         , input v-cntxt-obj-code                                                         , input v-attr-code                                                         , output v-exist                                                         ) no-error .                    if error-status :error = yes or                       v-exist = no                    then do:                      return .                     end.                    run gdsoattr-value in this-procedure ( input  v-attr-code                                                         , input  buf_goods.gds-code                                                         , input v-cntxt-obj-type                                                         , input v-cntxt-obj-code                                                         , output v-attr-value                                                         , output v-attr-type                                                         ) no-error .                    if error-status :error = yes                    then do:                      return .                     end.                    assign                      v-nutro-value = decimal(v-attr-value)                    no-error .                    if error-status :error = yes                    then do:                      return .                     end.
     5456         end.
     5457       end.
     5458       when 'carbohydrate':U
     5459       then do:
     5460         if v-is-global = yes
     5461         then do:
     5462           assign
     5463             v-attr-code = 'carbohydrate':U
     5464           .
     5465           run gds-attr-exist in this-procedure ( input  buf_goods.gds-code                                                          , input  v-attr-code                                                          , output v-exist                                                          ) no-error .                     if error-status :error = yes or                         v-exist = no                     then do:                       return .                      end.                     run gds-attr-value in this-procedure ( input  buf_goods.gds-code                                                          , input  v-attr-code                                                          , output v-attr-value                                                          , output v-attr-type                                                          ) no-error .                     if error-status :error                     then do:                       return .                      end.                     assign                       v-nutro-value = decimal( v-attr-value )                     no-error .                     if error-status :error = yes                     then do:                       return .                      end.
     5466         end.
     5467         else do:
     5468           assign
     5469             v-attr-code = 'carbohydrate-o':U
     5470           .
     5471           run gdsoattr-exist in this-procedure ( input buf_goods.gds-code                                                         , input v-cntxt-obj-type                                                         , input v-cntxt-obj-code                                                         , input v-attr-code                                                         , output v-exist                                                         ) no-error .                    if error-status :error = yes or                       v-exist = no                    then do:                      return .                     end.                    run gdsoattr-value in this-procedure ( input  v-attr-code                                                         , input  buf_goods.gds-code                                                         , input v-cntxt-obj-type                                                         , input v-cntxt-obj-code                                                         , output v-attr-value                                                         , output v-attr-type                                                         ) no-error .                    if error-status :error = yes                    then do:                      return .                     end.                    assign                      v-nutro-value = decimal(v-attr-value)                    no-error .                    if error-status :error = yes                    then do:                      return .                     end.
     5472         end.
     5473       end.
     5474       when 'fat':U
     5475       then do:
     5476         if v-is-global = yes
     5477         then do:
     5478           assign
     5479             v-attr-code = 'fat':U
     5480           .
     5481           run gds-attr-exist in this-procedure ( input  buf_goods.gds-code                                                          , input  v-attr-code                                                          , output v-exist                                                          ) no-error .                     if error-status :error = yes or                         v-exist = no                     then do:                       return .                      end.                     run gds-attr-value in this-procedure ( input  buf_goods.gds-code                                                          , input  v-attr-code                                                          , output v-attr-value                                                          , output v-attr-type                                                          ) no-error .                     if error-status :error                     then do:                       return .                      end.                     assign                       v-nutro-value = decimal( v-attr-value )                     no-error .                     if error-status :error = yes                     then do:                       return .                      end.
     5482         end.
     5483         else do:
     5484           assign
     5485             v-attr-code = 'fat-o':U
     5486           .
     5487           run gdsoattr-exist in this-procedure ( input buf_goods.gds-code                                                         , input v-cntxt-obj-type                                                         , input v-cntxt-obj-code                                                         , input v-attr-code                                                         , output v-exist                                                         ) no-error .                    if error-status :error = yes or                       v-exist = no                    then do:                      return .                     end.                    run gdsoattr-value in this-procedure ( input  v-attr-code                                                         , input  buf_goods.gds-code                                                         , input v-cntxt-obj-type                                                         , input v-cntxt-obj-code                                                         , output v-attr-value                                                         , output v-attr-type                                                         ) no-error .                    if error-status :error = yes                    then do:                      return .                     end.                    assign                      v-nutro-value = decimal(v-attr-value)                    no-error .                    if error-status :error = yes                    then do:                      return .                     end.
     5488         end.
     5489       end.
     5490       when 'protein':U
     5491       then do:
     5492         if v-is-global = yes
     5493         then do:
     5494           assign
     5495             v-attr-code = 'protein':U
     5496           .
     5497           run gds-attr-exist in this-procedure ( input  buf_goods.gds-code                                                          , input  v-attr-code                                                          , output v-exist                                                          ) no-error .                     if error-status :error = yes or                         v-exist = no                     then do:                       return .                      end.                     run gds-attr-value in this-procedure ( input  buf_goods.gds-code                                                          , input  v-attr-code                                                          , output v-attr-value                                                          , output v-attr-type                                                          ) no-error .                     if error-status :error                     then do:                       return .                      end.                     assign                       v-nutro-value = decimal( v-attr-value )                     no-error .                     if error-status :error = yes                     then do:                       return .                      end.
     5498         end.
     5499         else do:
     5500           assign
     5501             v-attr-code = 'protein-o':U
     5502           .
     5503           run gdsoattr-exist in this-procedure ( input buf_goods.gds-code                                                         , input v-cntxt-obj-type                                                         , input v-cntxt-obj-code                                                         , input v-attr-code                                                         , output v-exist                                                         ) no-error .                    if error-status :error = yes or                       v-exist = no                    then do:                      return .                     end.                    run gdsoattr-value in this-procedure ( input  v-attr-code                                                         , input  buf_goods.gds-code                                                         , input v-cntxt-obj-type                                                         , input v-cntxt-obj-code                                                         , output v-attr-value                                                         , output v-attr-type                                                         ) no-error .                    if error-status :error = yes                    then do:                      return .                     end.                    assign                      v-nutro-value = decimal(v-attr-value)                    no-error .                    if error-status :error = yes                    then do:                      return .                     end.
     5504         end.
     5505       end.
     5506       otherwise do:
     5507         return .
     5508       end.
     5509     end case.
     5510     assign
     5511       p-nutro-value = v-nutro-value
     5512     .
     5513   end.
     5514   end procedure.
     5515   procedure fbrnutro_proc-get-recipe-nutrition-by-code :
     5516     define input  parameter p-recipe-code as character no-undo .
     5517     define input  parameter p-artic       as character no-undo .
     5518     define input  parameter p-prod-type   as character no-undo .
     5519     define input  parameter p-prod-code   as integer   no-undo .
     5520     define input  parameter p-attr-code   as character no-undo .
     5521     define input  parameter p-recipe-qnty as decimal   no-undo .
     5522     define output parameter p-nutro-value as decimal   no-undo .
     5523     define buffer buf_goods          for ub.goods      .
     5524     define buffer buf_units          for ub.units.
     5525     define buffer buf_recipe-gds     for ub.recipe-gds .
     5526     define buffer buf_recipe         for ub.recipe     .
     5527     define variable v-attr-value        as character no-undo .
     5528     define variable v-attr-type         as character no-undo .
     5529     define variable v-nutro-ingr        as decimal   no-undo .
     5530     define variable v-nutro             as decimal   no-undo .
     5531     define variable v-is-global         as logical   no-undo .
     5532     define variable v-line-weight       as decimal   no-undo .
     5533     define variable v-tot-weight        as decimal   no-undo .
     5534     define variable v-recipe-have-lines as logical   no-undo .
     5535   do
     5536   on error undo, return error return-value
     5537   :
     5538     assign
     5539       p-nutro-value = ?
     5540     .
     5541     if p-recipe-qnty = ? or
     5542        p-recipe-qnty = 0
     5543     then do:
     5544       return .
     5545     end.
     5546     if  p-recipe-code <> "":u
     5547     and p-recipe-code <> ?
     5548     then do:
     5549       find first buf_recipe no-lock
     5550           where buf_recipe.recipe-code = p-recipe-code
     5551             and buf_recipe.artic      = p-artic
     5552             and buf_recipe.prod-type  = p-prod-type
     5553             and buf_recipe.prod-code  = p-prod-code
     5554       no-error .
     5555       if available buf_recipe
     5556       then do:
     5557         _recipe-gds-cycle:
     5558         for each buf_recipe-gds no-lock
     5559           where buf_recipe-gds.recipe-code = p-recipe-code
     5560         , first buf_goods no-lock
     5561             where buf_goods.gds-code = buf_recipe-gds.gds-code
     5562         , first buf_units no-lock
     5563             where buf_units.unit-name = buf_goods.unit-base
     5564         :
     5565             assign
     5566               v-recipe-have-lines = yes
     5567               v-nutro-ingr = fbrnutro_get-gds-recipe-nutrition-by-code ( input p-recipe-code
     5568                                                                        , input buf_recipe-gds.artic
     5569                                                                        , input buf_recipe-gds.prod-type
     5570                                                                        , input buf_recipe-gds.prod-code
     5571                                                                        , input p-attr-code
     5572                                                                        )
     5573             .
     5574             if v-nutro-ingr = ?
     5575             then do:
     5576               return .
     5577             end.
     5578             if lookup('вес':U, buf_units.type) > 0
     5579             then do:
     5580               assign
     5581                 v-line-weight = buf_recipe-gds.qnty
     5582               .
     5583             end.
     5584             else do:
     5585               assign
     5586                 v-line-weight = buf_recipe-gds.qnty * buf_goods.wt-base
     5587               .
     5588             end.
     5589             assign
     5590               v-nutro       = v-nutro + ( v-nutro-ingr * v-line-weight )
     5591               v-tot-weight  = v-tot-weight + v-line-weight
     5592             .
     5593         end.
     5594         assign
     5595           v-nutro = v-nutro / ( p-recipe-qnty )
     5596         .
     5597       end.
     5598       else do:
     5599         return .
     5600       end.
     5601     end.
     5602     else do:
     5603       return .
     5604     end.
     5605     if v-recipe-have-lines = yes and
     5606        v-tot-weight <> 0
     5607     then do:
     5608       assign
     5609         p-nutro-value = v-nutro
     5610       .
     5611     end.
     5612   end.
     5613   end procedure.
     5614   procedure fbrnutro_proc-save-nutrition :
     5615     define input  parameter p-recipe-code   as character no-undo .
     5616     define input  parameter p-artic         as character no-undo .
     5617     define input  parameter p-prod-type     as character no-undo .
     5618     define input  parameter p-prod-code     as integer   no-undo .
     5619     define input  parameter p-calories      as decimal   no-undo .
     5620     define input  parameter p-protein       as decimal   no-undo .
     5621     define input  parameter p-carbohydrate  as decimal   no-undo .
     5622     define input  parameter p-fat           as decimal   no-undo .
     5623     define buffer buf_recipe    for ub.recipe.
     5624     define buffer buf_goods     for ub.goods.
     5625     define variable v-is-global as logical   no-undo .
     5626     define variable v-attr-code as character no-undo .
     5627   do
     5628   on error undo, return error return-value
     5629   :
     5630     find first buf_recipe no-lock
     5631       where buf_recipe.recipe-code = p-recipe-code
     5632     no-error .
     5633     if not available buf_recipe
     5634     then do:
     5635       return error substitute( "Не найден рецепт с кодом &1" , p-recipe-code ).
     5636     end.
     5637     find first buf_goods no-lock
     5638       where buf_goods.artic     = p-artic
     5639         and buf_goods.prod-type = p-prod-type
     5640         and buf_goods.prod-code = p-prod-code
     5641     no-error .
     5642     if not available buf_goods
     5643     then do:
     5644       return error substitute( "Не найден товар &1 &2 &3"
     5645                              , p-artic
     5646                              , p-prod-type
     5647                              , p-prod-code
     5648                              ).
     5649     end.
     5650     assign
     5651       v-is-global = fbrnutro_is-global-recipe(p-recipe-code)
     5652     .
     5653     if v-is-global
     5654     then do:
     5655       assign
     5656         v-attr-code = 'carbohydrate':U
     5657       .
     5658       run gds-attr-write in this-procedure ( input buf_goods.gds-code
     5659                                            , input v-attr-code
     5660                                            , input p-carbohydrate
     5661                                            ) no-error .
     5662       if error-status :error = yes                 then do:                   return error substitute( "Ошибка при сохранении атрибута &1&2&3&2&4&2&5"                                          , v-attr-code                                          , chr(10)                                          , return-value                                          , error-status :get-message(1)                                          , error-status :get-message(2)                                          ) .                 end.
     5663       assign
     5664         v-attr-code = 'fat':U
     5665       .
     5666       run gds-attr-write in this-procedure ( input buf_goods.gds-code
     5667                                            , input v-attr-code
     5668                                            , input p-fat
     5669                                            ) no-error .
     5670       if error-status :error = yes                 then do:                   return error substitute( "Ошибка при сохранении атрибута &1&2&3&2&4&2&5"                                          , v-attr-code                                          , chr(10)                                          , return-value                                          , error-status :get-message(1)                                          , error-status :get-message(2)                                          ) .                 end.
     5671       assign
     5672         v-attr-code = 'protein':U
     5673       .
     5674       run gds-attr-write in this-procedure ( input buf_goods.gds-code
     5675                                            , input v-attr-code
     5676                                            , input p-protein
     5677                                            ) no-error .
     5678       if error-status :error = yes                 then do:                   return error substitute( "Ошибка при сохранении атрибута &1&2&3&2&4&2&5"                                          , v-attr-code                                          , chr(10)                                          , return-value                                          , error-status :get-message(1)                                          , error-status :get-message(2)                                          ) .                 end.
     5679       assign
     5680         v-attr-code = 'calories':U
     5681       .
     5682       run gds-attr-write in this-procedure ( input buf_goods.gds-code
     5683                                            , input v-attr-code
     5684                                            , input p-calories
     5685                                            ) no-error .
     5686       if error-status :error = yes                 then do:                   return error substitute( "Ошибка при сохранении атрибута &1&2&3&2&4&2&5"                                          , v-attr-code                                          , chr(10)                                          , return-value                                          , error-status :get-message(1)                                          , error-status :get-message(2)                                          ) .                 end.
     5687     end.
     5688     else do:
     5689       assign
     5690         v-attr-code = 'carbohydrate-o':U
     5691       .
     5692       run gdsoattr-write in this-procedure ( input buf_goods.gds-code
     5693                                            , input v-cntxt-obj-type
     5694                                            , input v-cntxt-obj-code
     5695                                            , input v-attr-code
     5696                                            , input p-carbohydrate
     5697                                            ) no-error .
     5698       if error-status :error = yes                 then do:                   return error substitute( "Ошибка при сохранении атрибута &1&2&3&2&4&2&5"                                          , v-attr-code                                          , chr(10)                                          , return-value                                          , error-status :get-message(1)                                          , error-status :get-message(2)                                          ) .                 end.
     5699       assign
     5700         v-attr-code = 'fat-o':U
     5701       .
     5702       run gdsoattr-write in this-procedure ( input buf_goods.gds-code
     5703                                            , input v-cntxt-obj-type
     5704                                            , input v-cntxt-obj-code
     5705                                            , input v-attr-code
     5706                                            , input p-fat
     5707                                            ) no-error .
     5708       if error-status :error = yes                 then do:                   return error substitute( "Ошибка при сохранении атрибута &1&2&3&2&4&2&5"                                          , v-attr-code                                          , chr(10)                                          , return-value                                          , error-status :get-message(1)                                          , error-status :get-message(2)                                          ) .                 end.
     5709       assign
     5710         v-attr-code = 'protein-o':U
     5711       .
     5712       run gdsoattr-write in this-procedure ( input buf_goods.gds-code
     5713                                            , input v-cntxt-obj-type
     5714                                            , input v-cntxt-obj-code
     5715                                            , input v-attr-code
     5716                                            , input p-protein
     5717                                            ) no-error .
     5718       if error-status :error = yes                 then do:                   return error substitute( "Ошибка при сохранении атрибута &1&2&3&2&4&2&5"                                          , v-attr-code                                          , chr(10)                                          , return-value                                          , error-status :get-message(1)                                          , error-status :get-message(2)                                          ) .                 end.
     5719       assign
     5720         v-attr-code = 'calories-o':U
     5721       .
     5722       run gdsoattr-write in this-procedure ( input buf_goods.gds-code
     5723                                            , input v-cntxt-obj-type
     5724                                            , input v-cntxt-obj-code
     5725                                            , input v-attr-code
     5726                                            , input p-calories
     5727                                            ) no-error .
     5728       if error-status :error = yes                 then do:                   return error substitute( "Ошибка при сохранении атрибута &1&2&3&2&4&2&5"                                          , v-attr-code                                          , chr(10)                                          , return-value                                          , error-status :get-message(1)                                          , error-status :get-message(2)                                          ) .                 end.
     5729     end.
     5730   end.
     5731   end procedure.
     5732   define stream ListStream.
     5733   define variable v-init-gds-unit-is-pieces   as logical        no-undo.
     5734   define variable v-init-gds-code             as integer        no-undo.
     5735   define variable g#report-num    as integer      no-undo.
     5736   define variable g#quest-print   as logical      no-undo.
     5737   define variable g#log           as logical      no-undo.
     5738   define buffer buf_init_recipe   for fbr-recipe.
     5739   define buffer buf_init_goods    for goods.
     5740   define buffer buf_init_units    for units.
     5741   FUNCTION get-browse-field RETURNS CHARACTER
     5742     ( input p-parameter-number as integer, input p-artic as character, input p-prod-type as character, input p-prod-code as integer )  FORWARD.
     5743   DEFINE BUTTON b-additional
     5744        LABEL "&Доп.инфо"
     5745        SIZE 10 BY 1.
     5746   DEFINE BUTTON b-cancel
     5747        LABEL "&Отмена"
     5748        SIZE 10 BY 1.
     5749   DEFINE BUTTON b-change
     5750        LABEL "&Изменить"
     5751        SIZE 10 BY 1.
     5752   DEFINE BUTTON b-close
     5753        LABEL "&Выход"
     5754        SIZE 10 BY 1
     5755        BGCOLOR 8 .
     5756   DEFINE BUTTON b-down
     5757        LABEL "Вни&з"
     5758        SIZE 10 BY 1.
     5759   DEFINE BUTTON b-gds
     5760        LABEL "&Товары"
     5761        SIZE 10 BY 1.
     5762   DEFINE BUTTON b-help
     5763        LABEL "Помощ&ь"
     5764        SIZE 10 BY 1
     5765        BGCOLOR 8 .
     5766   DEFINE BUTTON b-hst
     5767        LABEL "&История"
     5768        SIZE 10 BY 1.
     5769   DEFINE BUTTON b-print
     5770        LABEL "Пе&чать"
     5771        SIZE 10 BY 1.
     5772   DEFINE BUTTON b-rcp
     5773        LABEL "&Рецепт"
     5774        SIZE 10 BY 1.
     5775   DEFINE BUTTON b-up
     5776        LABEL "Ввер&х"
     5777        SIZE 10 BY 1.
     5778   DEFINE VARIABLE ed-recipe-technique AS CHARACTER
     5779        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     5780        SIZE 96.63 BY 2.29 NO-UNDO.
     5781   DEFINE VARIABLE br-table-label AS CHARACTER FORMAT "X(256)":U INITIAL "Ингредиенты рецепта"
     5782        VIEW-AS FILL-IN
     5783        SIZE 43 BY 1 NO-UNDO.
     5784   DEFINE VARIABLE fi-brutto-qnty AS DECIMAL FORMAT ">>>>9.<<<":U INITIAL 0
     5785        VIEW-AS FILL-IN
     5786        SIZE 14 BY 1 NO-UNDO.
     5787   DEFINE VARIABLE fi-init-units AS CHARACTER FORMAT "X(3)":U
     5788        LABEL "Ед.изм"
     5789        VIEW-AS FILL-IN
     5790        SIZE 4.13 BY 1
     5791        FGCOLOR 4  NO-UNDO.
     5792   DEFINE VARIABLE fi-portion-qnty AS INTEGER FORMAT ">,>>>,>>9":U INITIAL 0
     5793        LABEL "Порций"
     5794        VIEW-AS FILL-IN
     5795        SIZE 14 BY 1 NO-UNDO.
     5796   DEFINE VARIABLE fi-recipe-name AS CHARACTER FORMAT "X(256)":U
     5797        LABEL "Наименование"
     5798        VIEW-AS FILL-IN
     5799        SIZE 82 BY 1 NO-UNDO.
     5800   DEFINE VARIABLE fi-recipe-qnty AS DECIMAL FORMAT ">>>>9.<<<":U INITIAL 0
     5801        LABEL "Количество"
     5802        VIEW-AS FILL-IN
     5803        SIZE 14 BY 1 NO-UNDO.
     5804   DEFINE VARIABLE fi-recipe-ref-num AS CHARACTER FORMAT "X(14)":U
     5805        LABEL "Номер по справ. рецептур"
     5806        VIEW-AS FILL-IN
     5807        SIZE 14.13 BY 1 NO-UNDO.
     5808   DEFINE VARIABLE fi-recipe-portion-weight AS decimal FORMAT ">>>9.999":U
     5809        LABEL "Вес порции (кг)"
     5810        VIEW-AS FILL-IN
     5811        SIZE 14.13 BY 1 NO-UNDO.
     5812   DEFINE VARIABLE fi-recipe-technique-label AS CHARACTER FORMAT "X(256)":U INITIAL "Описание технологии приготовления"
     5813        VIEW-AS FILL-IN
     5814        SIZE 35 BY 1 NO-UNDO.
     5815   DEFINE VARIABLE v-calories AS DECIMAL FORMAT ">>>>9.9":U INITIAL 0
     5816        LABEL "Калории"
     5817         VIEW-AS TEXT
     5818        SIZE 9.25 BY .67
     5819        FGCOLOR 4  NO-UNDO.
     5820   DEFINE VARIABLE v-carbohydrate AS DECIMAL FORMAT ">9.9":U INITIAL 0
     5821        LABEL "Углеводы"
     5822         VIEW-AS TEXT
     5823        SIZE 6.13 BY .67
     5824        FGCOLOR 4  NO-UNDO.
     5825   DEFINE VARIABLE v-fat AS DECIMAL FORMAT ">>9.9":U INITIAL 0
     5826        LABEL "Жиры"
     5827         VIEW-AS TEXT
     5828        SIZE 6.13 BY .67
     5829        FGCOLOR 4  NO-UNDO.
     5830   DEFINE VARIABLE v-protein AS DECIMAL FORMAT ">>9.9":U INITIAL 0
     5831        LABEL "Белки"
     5832         VIEW-AS TEXT
     5833        SIZE 6.13 BY .67
     5834        FGCOLOR 4  NO-UNDO.
     5835   DEFINE QUERY br-table FOR
     5836         ub.fbr-recipe-gds SCROLLING.
     5837   DEFINE BROWSE br-table
     5838     QUERY br-table NO-LOCK DISPLAY
     5839         get-browse-field( input 1, input fbr-recipe-gds.artic, input fbr-recipe-gds.prod-type, input fbr-recipe-gds.prod-code ) COLUMN-LABEL "У" FORMAT "X(1)":U
     5840         ub.fbr-recipe-gds.is-waste COLUMN-LABEL "Отх" FORMAT "+/-":U
     5841         ub.fbr-recipe-gds.artic FORMAT "X(16)":U
     5842         ub.fbr-recipe-gds.qnty COLUMN-LABEL "Нетто" FORMAT "->>,>>>,>>9.<<<":U
     5843         ub.fbr-recipe-gds.brutto-qnty FORMAT "->>,>>>,>>9.<<<":U
     5844         ub.fbr-recipe-gds.coeff-waste COLUMN-LABEL "%потерь" FORMAT "->,>>9.<<<":U
     5845               WIDTH 10
     5846         ub.fbr-recipe-gds.coeff-value COLUMN-LABEL "%сезонн" FORMAT "->,>>9.<<<":U
     5847         get-browse-field( input 2, input fbr-recipe-gds.artic, input fbr-recipe-gds.prod-type, input fbr-recipe-gds.prod-code ) COLUMN-LABEL "Название товара" FORMAT "X(40)":U
     5848         get-browse-field( input 3, input fbr-recipe-gds.artic, input fbr-recipe-gds.prod-type, input fbr-recipe-gds.prod-code ) COLUMN-LABEL "ЕИ" FORMAT "X(3)":U
     5849         fbr-recipe-gds.prod-type + " ":U + string(fbr-recipe-gds.prod-code) COLUMN-LABEL "Произв-ль" FORMAT "X(10)":U
     5850         get-browse-field( input 4, input fbr-recipe-gds.artic, input fbr-recipe-gds.prod-type, input fbr-recipe-gds.prod-code ) COLUMN-LABEL "Наименование производителя" FORMAT "X(40)":U
     5851         fbrnutro_get-gds-recipe-nutrition-by-code (fbr-recipe-gds.recipe-code,fbr-recipe-gds.artic, fbr-recipe-gds.prod-type, fbr-recipe-gds.prod-code, 'calories':U ) COLUMN-LABEL "Калории" FORMAT ">>>,>>9.<":U
     5852         fbrnutro_get-gds-recipe-nutrition-by-code (fbr-recipe-gds.recipe-code, fbr-recipe-gds.artic, fbr-recipe-gds.prod-type, fbr-recipe-gds.prod-code, 'protein':U ) COLUMN-LABEL "Белки" FORMAT ">>>,>>9.<":U
     5853         fbrnutro_get-gds-recipe-nutrition-by-code (fbr-recipe-gds.recipe-code, fbr-recipe-gds.artic, fbr-recipe-gds.prod-type, fbr-recipe-gds.prod-code, 'fat':U) COLUMN-LABEL "Жиры" FORMAT ">>>,>>9.<":U
     5854         fbrnutro_get-gds-recipe-nutrition-by-code (fbr-recipe-gds.recipe-code, fbr-recipe-gds.artic, fbr-recipe-gds.prod-type, fbr-recipe-gds.prod-code, 'carbohydrate':U) COLUMN-LABEL "Углеводы" FORMAT ">>>,>>9.<":U
     5855       WITH NO-ROW-MARKERS SEPARATORS SIZE 96.88 BY 12.5.
     5856   DEFINE FRAME Dialog-Frame
     5857        b-close AT ROW 1.21 COL 1.63
     5858        b-cancel AT ROW 1.21 COL 11.63
     5859        b-gds AT ROW 1.21 COL 21.63
     5860        b-hst AT ROW 1.21 COL 31.63
     5861        b-rcp AT ROW 1.21 COL 41.63
     5862        b-additional AT ROW 1.21 COL 51.63
     5863        b-print AT ROW 1.21 COL 78.63
     5864        b-help AT ROW 1.21 COL 88.63
     5865        fi-recipe-name AT ROW 2.58 COL 14.63 COLON-ALIGNED
     5866        fi-recipe-qnty AT ROW 3.67 COL 14.63 COLON-ALIGNED
     5867        fi-brutto-qnty AT ROW 3.67 COL 38 COLON-ALIGNED NO-LABEL
     5868        fi-recipe-ref-num AT ROW 3.67 COL 82.5 COLON-ALIGNED
     5869        fi-recipe-portion-weight AT ROW 4.79 COL 82.5 COLON-ALIGNED
     5870        fi-portion-qnty AT ROW 4.79 COL 14.63 COLON-ALIGNED
     5871        fi-init-units AT ROW 4.79 COL 38 COLON-ALIGNED
     5872        fi-recipe-technique-label AT ROW 6.04 COL 2 NO-LABEL
     5873        ed-recipe-technique AT ROW 7.21 COL 2 NO-LABEL
     5874        br-table-label AT ROW 9.67 COL 2 NO-LABEL
     5875        b-change AT ROW 9.71 COL 46.63
     5876        b-up AT ROW 9.71 COL 77.88
     5877        b-down AT ROW 9.71 COL 88.63
     5878        br-table AT ROW 10.88 COL 1.75
     5879        v-fat AT ROW 6.21 COL 41.38 COLON-ALIGNED WIDGET-ID 4
     5880        v-protein AT ROW 6.21 COL 54.5 COLON-ALIGNED WIDGET-ID 6
     5881        v-carbohydrate AT ROW 6.21 COL 70.88 COLON-ALIGNED WIDGET-ID 8
     5882        v-calories AT ROW 6.21 COL 87.25 COLON-ALIGNED WIDGET-ID 2
     5883        SPACE(0.47) SKIP(16.65)
     5884       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     5885            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     5886            TITLE "Рецепт документа производства".
     5887   ASSIGN
     5888          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     5889          FRAME Dialog-Frame:HIDDEN           = TRUE.
     5890   ASSIGN
     5891          v-calories:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     5892   ASSIGN
     5893          v-carbohydrate:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     5894   ASSIGN
     5895          v-fat:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     5896   ASSIGN
     5897          v-protein:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     5898   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     5899   DO:
     5900       APPLY "END-ERROR":U TO SELF.
     5901   END.
     5902   ON CHOOSE OF b-additional IN FRAME Dialog-Frame
     5903   DO:
     5904   define variable vss-include-info40 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5905   if lookup(self :type
     5906            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     5907            ) = 0
     5908   then do:
     5909     message
     5910       "$Workfile$"
     5911       "Указанному интерфейсному элементу фокус не может быть передан" skip
     5912       "Интерфейсный элемент" self :name  skip
     5913       "Тип" self :type  skip
     5914       "Процедура" this-procedure :file-name skip
     5915       view-as alert-box .
     5916   end.
     5917   else do:
     5918     apply "entry":u to self  .
     5919     if focus :handle <> self :handle  then do:
     5920       return no-apply .
     5921     end.
     5922   end.
     5923       define variable v-cancel    as logical        no-undo.
     5924       define variable v-quality   as character      no-undo.
     5925       define variable v-design    as character      no-undo.
     5926       define buffer buf_fbr-doc for fbr-doc.
     5927       find first buf_fbr-doc no-lock
     5928            where buf_fbr-doc.doc-code = p-doc-code
     5929       .
     5930       run ref/recipd.w (
     5931             input p-mode
     5932           , input buf_init_recipe.recipe-code
     5933           , input buf_fbr-doc.obj-type
     5934           , input buf_fbr-doc.obj-code
     5935           , input buf_init_recipe.recipe-quality
     5936           , input buf_init_recipe.recipe-design
     5937           , output v-quality
     5938           , output v-design
     5939       ) no-error.
     5940       if error-status :error
     5941       then do:
     5942           message
     5943               "Не удалось присвоить значения дополнительным параметрам рецепта."
     5944               skip return-value
     5945               skip trim(error-status :get-message(1))
     5946                    trim(error-status :get-message(2))
     5947                    trim(error-status :get-message(3))
     5948           view-as alert-box error.
     5949           undo, return no-apply.
     5950       end.
     5951       if buf_init_recipe.recipe-quality <> v-quality
     5952       then do:
     5953           assign
     5954               buf_init_recipe.recipe-quality = v-quality
     5955           .
     5956       end.
     5957       if buf_init_recipe.recipe-design  <> v-design
     5958       then do:
     5959           assign
     5960               buf_init_recipe.recipe-design  = v-design
     5961           .
     5962       end.
     5963   END.
     5964   ON CHOOSE OF b-cancel IN FRAME Dialog-Frame
     5965   DO:
     5966   define variable vss-include-info41 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5967   if lookup(self :type
     5968            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     5969            ) = 0
     5970   then do:
     5971     message
     5972       "$Workfile$"
     5973       "Указанному интерфейсному элементу фокус не может быть передан" skip
     5974       "Интерфейсный элемент" self :name  skip
     5975       "Тип" self :type  skip
     5976       "Процедура" this-procedure :file-name skip
     5977       view-as alert-box .
     5978   end.
     5979   else do:
     5980     apply "entry":u to self  .
     5981     if focus :handle <> self :handle  then do:
     5982       return no-apply .
     5983     end.
     5984   end.
     5985       assign
     5986           p-cancel = yes
     5987       .
     5988       apply "WINDOW-CLOSE" TO FRAME Dialog-Frame .
     5989   END.
     5990   ON CHOOSE OF b-change IN FRAME Dialog-Frame
     5991   DO:
     5992       define variable v-new-qnty          as decimal        no-undo.
     5993       define variable v-new-coeff-waste   as decimal        no-undo.
     5994       define variable v-new-brutto-qnty   as decimal        no-undo.
     5995       define variable v-new-calc-method   as integer      no-undo.
     5996       define variable v-is-waste          as logical        no-undo.
     5997       define variable v-success           as logical        no-undo.
     5998       define variable v-goods-name        as character      no-undo.
     5999       define variable v-units             as character      no-undo.
     6000       define variable v-gds-code          as integer        no-undo.
     6001       define buffer buf_units     for units.
     6002       define buffer buf_goods     for goods.
     6003       if available fbr-recipe-gds
     6004       then do:
     6005   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6006   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     6007     (input  fbr-recipe-gds.artic
     6008     ,input  fbr-recipe-gds.prod-type
     6009     ,input  fbr-recipe-gds.prod-code
     6010     ,output v-goods-name
     6011     )  .
     6012   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6013   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     6014     (input  fbr-recipe-gds.artic
     6015     ,input  fbr-recipe-gds.prod-type
     6016     ,input  fbr-recipe-gds.prod-code
     6017     ,output v-gds-code
     6018     )  .
     6019   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6020   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     6021     (input  v-gds-code
     6022     ,output v-units
     6023     )  .
     6024           find first buf_units no-lock
     6025                where buf_units.unit-name = v-units
     6026           .
     6027           run ref/recipln.w (
     6028                 input 'рецепт':U
     6029               , input p-recipe-type
     6030               , input fbr-recipe-gds.recipe-code + " " + fi-recipe-name
     6031               , input fbr-recipe-gds.artic + " " + v-goods-name
     6032               , input lookup( 'шту':U, buf_units.type ) > 0
     6033               , input fbr-recipe-gds.is-waste
     6034               , input fbr-recipe-gds.qnty
     6035               , input fbr-recipe-gds.coeff-value
     6036               , input fbr-recipe-gds.coeff-waste
     6037               , input fbr-recipe-gds.brutto-qnty
     6038               , input fbr-recipe-gds.calc-method
     6039               , output v-is-waste
     6040               , output v-new-qnty
     6041               , output v-new-coeff-waste
     6042               , output v-new-brutto-qnty
     6043               , output v-new-calc-method
     6044               , output v-success
     6045           ).
     6046           if v-success = yes
     6047           then do:
     6048               do transaction
     6049               :
     6050                   find current fbr-recipe-gds exclusive-lock .
     6051                   assign
     6052                       fbr-recipe-gds.is-waste    = v-is-waste
     6053                       fbr-recipe-gds.qnty        = v-new-qnty
     6054                       fbr-recipe-gds.coeff-waste = v-new-coeff-waste
     6055                       fbr-recipe-gds.brutto-qnty = v-new-brutto-qnty
     6056                       fbr-recipe-gds.calc-method = v-new-calc-method
     6057                   .
     6058               end.
     6059               br-table :refresh().
     6060               run calc-and-display-nutrition-info in this-procedure .
     6061           end.
     6062       end.
     6063   END.
     6064   ON CHOOSE OF b-close IN FRAME Dialog-Frame
     6065   DO:
     6066   define variable vss-include-info45 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6067   if lookup(self :type
     6068            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     6069            ) = 0
     6070   then do:
     6071     message
     6072       "$Workfile$"
     6073       "Указанному интерфейсному элементу фокус не может быть передан" skip
     6074       "Интерфейсный элемент" self :name  skip
     6075       "Тип" self :type  skip
     6076       "Процедура" this-procedure :file-name skip
     6077       view-as alert-box .
     6078   end.
     6079   else do:
     6080     apply "entry":u to self  .
     6081     if focus :handle <> self :handle  then do:
     6082       return no-apply .
     6083     end.
     6084   end.
     6085   define variable v-bad-data      as logical        no-undo.
     6086   define variable v-error-text    as character      no-undo.
     6087   define variable v-allow-global  as logical        no-undo.
     6088       if p-mode <> 'ИЗМЕНЕНИЕ':U
     6089       and p-mode <> 'ДОБАВЛЕНИЕ':U
     6090       then do:
     6091           apply "window-close" to frame Dialog-Frame .
     6092       end.
     6093       assign
     6094           fi-recipe-name
     6095           fi-recipe-qnty
     6096           fi-brutto-qnty
     6097           fi-portion-qnty
     6098           fi-recipe-ref-num
     6099           fi-recipe-portion-weight
     6100           ed-recipe-technique
     6101       .
     6102       run check-recipe in this-procedure (
     6103               input buf_init_recipe.recipe-code
     6104             , input fi-recipe-name
     6105             , input fi-recipe-qnty
     6106             , input fi-brutto-qnty
     6107             , input fi-portion-qnty
     6108             , input fi-recipe-ref-num
     6109             , input fi-recipe-portion-weight
     6110             , input ed-recipe-technique
     6111             , output v-bad-data
     6112             , output v-error-text
     6113       ) no-error.
     6114       if error-status :error
     6115       then do:
     6116           message
     6117                    vss-workfile vss-revision vss-description
     6118               skip "Ошибка при проверке рецепта."
     6119               skip return-value
     6120               skip trim(error-status :get-message(1))
     6121                    trim(error-status :get-message(2))
     6122                    trim(error-status :get-message(3))
     6123           view-as alert-box error.
     6124           undo, return no-apply .
     6125       end.
     6126       if v-bad-data = yes
     6127       then do:
     6128           message
     6129               "Ошибка введенных данных рецепта."
     6130               skip v-error-text
     6131               skip(1)
     6132               "Исправьте данные или отмените ввод рецепта."
     6133           view-as alert-box error.
     6134           undo, return no-apply .
     6135       end.
     6136       assign
     6137           buf_init_recipe.recipe-name         = fi-recipe-name
     6138           buf_init_recipe.qnty                = fi-recipe-qnty
     6139           buf_init_recipe.brutto-qnty         = fi-brutto-qnty
     6140           buf_init_recipe.portion-qnty        = fi-portion-qnty
     6141           buf_init_recipe.recipe-ref-num      = fi-recipe-ref-num
     6142           buf_init_recipe.portion-weight      = fi-recipe-portion-weight
     6143           buf_init_recipe.recipe-technique    = ed-recipe-technique
     6144       .
     6145       assign
     6146           p-cancel = no
     6147       .
     6148       apply "GO" TO FRAME Dialog-Frame .
     6149   END.
     6150   ON CHOOSE OF b-down IN FRAME Dialog-Frame
     6151   DO:
     6152   define variable vss-include-info46 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6153   if lookup(self :type
     6154            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     6155            ) = 0
     6156   then do:
     6157     message
     6158       "$Workfile$"
     6159       "Указанному интерфейсному элементу фокус не может быть передан" skip
     6160       "Интерфейсный элемент" self :name  skip
     6161       "Тип" self :type  skip
     6162       "Процедура" this-procedure :file-name skip
     6163       view-as alert-box .
     6164   end.
     6165   else do:
     6166     apply "entry":u to self  .
     6167     if focus :handle <> self :handle  then do:
     6168       return no-apply .
     6169     end.
     6170   end.
     6171       define variable v-cur-line          as recid          no-undo.
     6172       define variable v-proc-number       as integer        no-undo.
     6173       define variable v-old-proc-number   as integer        no-undo.
     6174       define variable v-focused-row       as integer        no-undo.
     6175       if not available fbr-recipe-gds
     6176       then do:
     6177           return no-apply.
     6178       end.
     6179       apply "entry" to br-table .
     6180       assign
     6181           v-focused-row   = br-table :focused-row in frame Dialog-Frame
     6182           v-cur-line      = recid( fbr-recipe-gds )
     6183           v-proc-number   = fbr-recipe-gds.proc-number
     6184       .
     6185       get next br-table.
     6186       if not available fbr-recipe-gds
     6187       then do:
     6188           apply "entry" to br-table.
     6189           return no-apply.
     6190       end.
     6191   if session :set-wait-state( "compiler" ) then.
     6192       swap-down:
     6193       do
     6194       on error undo swap-down, return no-apply
     6195       :
     6196           find current fbr-recipe-gds exclusive-lock .
     6197           assign
     6198               v-old-proc-number       = fbr-recipe-gds.proc-number
     6199               fbr-recipe-gds.proc-number  = v-proc-number
     6200           .
     6201           find first fbr-recipe-gds
     6202                where recid( fbr-recipe-gds ) = v-cur-line
     6203           .
     6204           assign
     6205               v-focused-row          = v-focused-row + 1
     6206               fbr-recipe-gds.proc-number = v-old-proc-number
     6207           .
     6208       end.
     6209       OPEN QUERY br-table FOR EACH ub.fbr-recipe-gds       WHERE fbr-recipe-gds.recipe-code = buf_init_recipe.recipe-code  AND fbr-recipe-gds.doc-code = p-doc-code NO-LOCK     BY ub.fbr-recipe-gds.proc-number.
     6210       br-table :set-repositioned-row( v-focused-row, "ALWAYS") in frame Dialog-Frame.
     6211       reposition br-table to recid v-cur-line .
     6212       apply "entry" to browse br-table.
     6213   if session :set-wait-state( "" ) then.
     6214   END.
     6215   ON CHOOSE OF b-gds IN FRAME Dialog-Frame
     6216   DO:
     6217   define variable vss-include-info47 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6218   if lookup(self :type
     6219            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     6220            ) = 0
     6221   then do:
     6222     message
     6223       "$Workfile$"
     6224       "Указанному интерфейсному элементу фокус не может быть передан" skip
     6225       "Интерфейсный элемент" self :name  skip
     6226       "Тип" self :type  skip
     6227       "Процедура" this-procedure :file-name skip
     6228       view-as alert-box .
