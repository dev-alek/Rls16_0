      125   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      126   procedure cur-time :
      127      define output parameter p-today as date      no-undo .
      128      define output parameter p-time  as integer   no-undo .
      129     do
      130     on error undo, return error
      131     :
      132       define variable v-date1 as date      no-undo .
      133       define variable v-date2 as date      no-undo .
      134       define variable v-time  as integer   no-undo .
      135       assign
      136         v-date1 = today
      137         v-time  = time
      138         v-date2 = today
      139       .
      140       if v-date1 <> v-date2
      141       then do:
      142         assign
      143           v-date1 = today
      144           v-time  = v-time
      145         .
      146       end.
      147       assign
      148         p-today = v-date1
      149         p-time  = v-time
      150       .
      151     end.
      152   end.
      153   function cur-time-date returns character
      154   :
      155     return string(today, '99/99/9999':U) .
      156   end.
      157   function cur-time-mjd returns decimal
      158   :
      159     define variable v-date as date      no-undo .
      160     define variable v-time as integer   no-undo .
      161     run cur-time in this-procedure
      162       (output v-date
      163       ,output v-time
      164       ) .
      165     return integer(v-date) - 2400002 + (v-time / 86400) .
      166   end.
      167   function cur-time-get-ending-index returns integer
      168   (input p-number as integer
      169   )
      170   :
      171     if p-number < 0
      172     or p-number = ?
      173     then do:
      174       return 1 .
      175     end.
      176     define variable v-rest as integer   no-undo .
      177     assign
      178       p-number = p-number modulo 100
      179     .
      180     if p-number < 20
      181     then do:
      182       assign
      183         v-rest = p-number
      184       .
      185     end.
      186     else do:
      187       assign
      188         v-rest = p-number modulo 10
      189       .
      190     end.
      191     case v-rest :
      192       when 1
      193       then do:
      194         return 2 .
      195       end.
      196       when 2 or
      197       when 3 or
      198       when 4
      199       then do:
      200         return 3 .
      201       end.
      202       otherwise do:
      203         return 1 .
      204       end.
      205     end case .
      206   end.
      207   procedure cur-time-mjd-to-date :
      208      define input  parameter i-mjd-diff as decimal no-undo.
      209      define output parameter o-Date     as date    no-undo.
      210      define output parameter o-Time     as integer no-undo.
      211      define variable v-day-number as integer   no-undo .
      212      if    i-mjd-diff < 0
      213         or i-mjd-diff = ?
      214      then do:
      215         return "?" .
      216      end.
      217      assign
      218         v-day-number = truncate(i-mjd-diff,0).
      219         o-Date = date(v-day-number + 2400002).
      220         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      221     .
      222   end.
      223   function cur-time-mjd-to-string returns character
      224   (input p-mjd-diff as decimal
      225   )
      226   :
      227     define variable v-day-number as integer   no-undo .
      228     define variable v-seconds    as integer   no-undo .
      229     define variable v-hour       as integer   no-undo .
      230     define variable v-min        as integer   no-undo .
      231     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      232     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      233     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      234     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      235     if p-mjd-diff < 0
      236     or p-mjd-diff = ?
      237     then do:
      238       return "?" .
      239     end.
      240     assign
      241       v-day-number = integer(truncate(p-mjd-diff,0))
      242       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      243     .
      244     if v-seconds > 86400
      245     then do:
      246       assign
      247         v-seconds = 86400 - 1
      248       .
      249     end.
      250     if v-seconds < 0
      251     then do:
      252       assign
      253         v-seconds = 0
      254       .
      255     end.
      256     assign
      257       v-hour = truncate(v-seconds / 3600, 0)
      258     .
      259     assign
      260       v-seconds = v-seconds modulo 3600
      261     .
      262     assign
      263       v-min = truncate(v-seconds / 60, 0)
      264     .
      265     assign
      266       v-seconds = v-seconds modulo 60
      267     .
      268     return
      269         (if v-day-number <> 0
      270           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      271           else ""
      272         )
      273       + (if v-day-number <> 0 or v-hour <> 0
      274           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      275           else ""
      276         )
      277       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      278           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      279           else ""
      280         )
      281       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      282       .
      283   end.
      284   function cur-time-string returns character
      285   :
      286     define variable v-date as date      no-undo .
      287     define variable v-time as integer   no-undo .
      288     run cur-time in this-procedure
      289       (output v-date
      290       ,output v-time
      291       ) .
      292     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      293   end.
      294   function cur-time-string-sec returns character
      295   :
      296     define variable v-date as date      no-undo .
      297     define variable v-time as integer   no-undo .
      298     run cur-time in this-procedure
      299       (output v-date
      300       ,output v-time
      301       ) .
      302     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      303   end.
      304   function cur-time-custom  returns character
      305   (input p-prefix as character
      306   ,input p-date-format as character
      307   ,input p-delimiter as character
      308   ,input p-time-format as character
      309   ,input p-suffix as character
      310   )
      311   :
      312     define variable v-date as date      no-undo .
      313     define variable v-time as integer   no-undo .
      314     run cur-time in this-procedure
      315       (output v-date
      316       ,output v-time
      317       ) .
      318     return
      319       p-prefix
      320       + string(v-date, p-date-format)
      321       + p-delimiter
      322       + string(v-time, p-time-format)
      323       + p-suffix
      324       .
      325   end.
      326   function cur-time-print  returns character
      327   :
      328     define variable v-date as date      no-undo .
      329     define variable v-time as integer   no-undo .
      330     run cur-time in this-procedure
      331       (output v-date
      332       ,output v-time
      333       ) .
      334     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      335   end.
      336   function cur-time-datetime returns datetime
      337   :
      338     define variable v-char as character no-undo .
      339     define variable v-datetime as datetime no-undo .
      340     v-char = cur-time-string().
      341     v-datetime = datetime(v-char).
      342     return  v-datetime.
      343   end.
      344   function cur-time-string-msec returns character
      345   :
      346     define variable v-date as datetime  no-undo .
      347     v-date = now.
      348     return string(v-date) .
      349   end.
      350   define variable vss-include-info4 as character format "X(65)" no-undo
      351   initial "@(#)$Workfile$ $Revision$".
      352   define temp-table temp_fbrcode-doc-code no-undo
      353       field rec-type      as character
      354       field doc-code      as character
      355       field obj-type      as character
      356       field obj-code      as integer
      357       field cli-type      as character
      358       field cli-code      as integer
      359       field ext-doc-type  as character
      360       field doc-type      as character
      361       field order         as integer
      362       index pi is primary unique rec-type doc-code
      363       index od order
      364   .
      365   procedure fbrcode-gen-recipe-code :
      366   do
      367   on error undo, return error
      368   :
      369   define input parameter p-obj-type           as character    no-undo.
      370   define input parameter p-obj-code           as integer      no-undo.
      371   define output parameter p-recipe-code       as character    no-undo.
      372       assign
      373           p-recipe-code   = string( next-value( s-recipe, ub ) )
      374                               + "-"
      375                               + trim( string( p-obj-code, ">>>>9" ) )
      376                               + substring( p-obj-type, ( if g#language = "RUS" then 1 else 2 ), 1 )
      377       .
      378   end.
      379   end procedure.
      380   procedure fbrcode-is-from-object :
      381   do
      382   on error undo, return error
      383   :
      384   define input parameter p-doc-code           as character    no-undo.
      385   define input parameter p-obj-type           as character    no-undo.
      386   define input parameter p-obj-code           as integer      no-undo.
      387   define output parameter p-is-from-object    as logical      no-undo.
      388       if num-entries( p-doc-code, "-" ) < 2
      389       or entry( 2, p-doc-code, "-" ) <> trim (string (p-obj-code, ">>>>9"))
      390                                       + substring( p-obj-type, ( if g#language = "RUS" then 1 else 2 ), 1 )
      391       then do:
      392           assign
      393               p-is-from-object = no
      394           .
      395       end.
      396       else do:
      397           assign
      398               p-is-from-object = yes
      399           .
      400       end.
      401   end.
      402   end procedure.
      403   procedure fbrcode-trn-doc :
      404   do
      405   on error undo, return error
      406   :
      407       define input parameter p-out-doc-type       as character    no-undo.
      408       define input parameter p-out-code           as character    no-undo.
      409       define input parameter p-trn-doc-out-type   as character    no-undo.
      410       define output parameter p-trn-doc-doc-code  as character   no-undo.
      411       case p-out-doc-type:
      412           when 'производство':U
      413           then do:
      414               case p-trn-doc-out-type :
      415                   when 'рас':U
      416                   then do:
      417                       assign
      418                           p-trn-doc-doc-code = p-out-code
      419                       .
      420                   end.
      421                   when 'при':U
      422                   then do:
      423                       assign
      424                           p-trn-doc-doc-code = replace ( p-out-code, "-", "=" )
      425                       .
      426                   end.
      427                   when 'спи':U
      428                   then do:
      429                       assign
      430                           p-trn-doc-doc-code = replace ( p-out-code, "-", "*" )
      431                       .
      432                   end.
      433                   otherwise do:
      434                       assign
      435                           p-trn-doc-doc-code = ""
      436                       .
      437                       undo, return error "Не может быть обработан тип складского документа '"
      438                                           + p-trn-doc-out-type + "' во входных параметрах".
      439                   end.
      440               end case.
      441           end.
      442           otherwise do:
      443               assign
      444                   p-trn-doc-doc-code = ""
      445               .
      446               undo, return error "Не может быть обработан тип внешнего документа '"
      447                                   + p-out-doc-type + "' во входных параметрах".
      448           end.
      449       end case.
      450   end.
      451   end procedure.
      452   procedure fbrcode-fill-fbr-by-sale-or-pln :
      453   define input parameter p-main-doc-code      as character        no-undo.
      454       define variable v-order    as integer      no-undo.
      455       define buffer buf_fbr-doc               for ub.fbr-doc.
      456       define buffer buf_trn-doc               for ub.trn-doc.
      457       define buffer buf_temp_fbrcode-doc-code for temp_fbrcode-doc-code.
      458   do
      459   for buf_fbr-doc
      460     , buf_trn-doc
      461     , buf_temp_fbrcode-doc-code
      462   on error undo, return error
      463   :
      464       for each buf_temp_fbrcode-doc-code
      465       on error undo, return error
      466       :
      467           delete buf_temp_fbrcode-doc-code.
      468       end.
      469       assign
      470           v-order = 0
      471       .
      472       for each buf_fbr-doc no-lock
      473          where buf_fbr-doc.out-code = p-main-doc-code
      474       on error undo, return error
      475       :
      476           create buf_temp_fbrcode-doc-code.
      477           assign
      478               buf_temp_fbrcode-doc-code.rec-type      = 'производство':U
      479               buf_temp_fbrcode-doc-code.doc-code      = buf_fbr-doc.doc-code
      480               buf_temp_fbrcode-doc-code.ext-doc-type  = "":U
      481               buf_temp_fbrcode-doc-code.obj-type      = buf_fbr-doc.obj-type
      482               buf_temp_fbrcode-doc-code.obj-code      = buf_fbr-doc.obj-code
      483               buf_temp_fbrcode-doc-code.cli-type      = buf_fbr-doc.obj-type
      484               buf_temp_fbrcode-doc-code.cli-code      = buf_fbr-doc.obj-code
      485               buf_temp_fbrcode-doc-code.doc-type      = buf_fbr-doc.doc-type
      486           .
      487           for each buf_trn-doc no-lock
      488              where buf_trn-doc.out-code = buf_fbr-doc.doc-code
      489           by buf_trn-doc.fact-order
      490           on error undo, return error
      491           :
      492               if buf_trn-doc.ext-doc-type = 'em':U
      493               or buf_trn-doc.ext-doc-type = 'im':U
      494               or buf_trn-doc.ext-doc-type = 'wm':U
      495               or buf_trn-doc.ext-doc-type = 'ev':U
      496               then do:
      497                   assign
      498                       v-order = v-order + 1
      499                   .
      500                   create buf_temp_fbrcode-doc-code.
      501                   assign
      502                       buf_temp_fbrcode-doc-code.doc-code      = buf_trn-doc.doc-code
      503                       buf_temp_fbrcode-doc-code.rec-type      = 'скл':U
      504                       buf_temp_fbrcode-doc-code.ext-doc-type  = buf_trn-doc.ext-doc-type
      505                       buf_temp_fbrcode-doc-code.obj-type      = buf_trn-doc.obj-type
      506                       buf_temp_fbrcode-doc-code.obj-code      = buf_trn-doc.obj-code
      507                       buf_temp_fbrcode-doc-code.cli-type      = buf_trn-doc.cli-type
      508                       buf_temp_fbrcode-doc-code.cli-code      = buf_trn-doc.cli-code
      509                       buf_temp_fbrcode-doc-code.doc-type      = buf_trn-doc.doc-type
      510                       buf_temp_fbrcode-doc-code.order         = v-order
      511                   .
      512               end.
      513           end.
      514           assign
      515               v-order  = v-order + 1
      516           .
      517           find first buf_temp_fbrcode-doc-code
      518                where buf_temp_fbrcode-doc-code.rec-type = 'производство':U
      519                  and buf_temp_fbrcode-doc-code.doc-code = buf_fbr-doc.doc-code
      520           .
      521           assign
      522               buf_temp_fbrcode-doc-code.order = v-order
      523           .
      524       end.
      525       for each buf_trn-doc no-lock
      526          where buf_trn-doc.out-code = p-main-doc-code
      527       by buf_trn-doc.fact-order
      528       on error undo, return error
      529       :
      530           assign
      531               v-order = v-order + 1
      532           .
      533           create buf_temp_fbrcode-doc-code.
      534           assign
      535               buf_temp_fbrcode-doc-code.doc-code      = buf_trn-doc.doc-code
      536               buf_temp_fbrcode-doc-code.rec-type      = 'маг':U
      537               buf_temp_fbrcode-doc-code.ext-doc-type  = buf_trn-doc.ext-doc-type
      538               buf_temp_fbrcode-doc-code.obj-type      = buf_trn-doc.obj-type
      539               buf_temp_fbrcode-doc-code.obj-code      = buf_trn-doc.obj-code
      540               buf_temp_fbrcode-doc-code.cli-type      = buf_trn-doc.cli-type
      541               buf_temp_fbrcode-doc-code.cli-code      = buf_trn-doc.cli-code
      542               buf_temp_fbrcode-doc-code.doc-type      = buf_trn-doc.doc-type
      543               buf_temp_fbrcode-doc-code.order         = v-order
      544           .
      545       end.
      546   end.
      547   end procedure.
      548   procedure fbrcode-get-final-doc :
      549   define input parameter p-main-doc-code      as character        no-undo.
      550   define output parameter p-income-doc-code   as character        no-undo.
      551       define variable v-main-obj-type    as character    no-undo.
      552       define variable v-main-obj-code    as integer      no-undo.
      553       define buffer buf_trn-doc               for ub.trn-doc.
      554       define buffer buf_temp_fbrcode-doc-code for temp_fbrcode-doc-code.
      555   do
      556   for buf_trn-doc
      557   on error undo, return error
      558   :
      559       run fbrcode-fill-fbr-by-sale-or-pln in this-procedure (
      560           input p-main-doc-code
      561       ).
      562       find first buf_trn-doc no-lock
      563            where buf_trn-doc.doc-code = p-main-doc-code
      564       .
      565       assign
      566           v-main-obj-type = buf_trn-doc.obj-type
      567           v-main-obj-code = buf_trn-doc.obj-code
      568       .
      569       find first buf_temp_fbrcode-doc-code
      570            where buf_temp_fbrcode-doc-code.ext-doc-type = 'ev':U
      571              and buf_temp_fbrcode-doc-code.cli-type     = v-main-obj-type
      572              and buf_temp_fbrcode-doc-code.cli-code     = v-main-obj-code
      573       no-error.
      574       if available buf_temp_fbrcode-doc-code
      575       then do:
      576           find first buf_trn-doc no-lock
      577                where buf_trn-doc.out-code     = buf_temp_fbrcode-doc-code.doc-code
      578                  and buf_trn-doc.ext-doc-type = 'iv':U
      579           .
      580           assign
      581               p-income-doc-code = buf_trn-doc.doc-code
      582           .
      583       end.
      584       else do:
      585           find first buf_temp_fbrcode-doc-code
      586                where buf_temp_fbrcode-doc-code.ext-doc-type = 'im':U
      587                  and buf_temp_fbrcode-doc-code.obj-type     = v-main-obj-type
      588                  and buf_temp_fbrcode-doc-code.obj-code     = v-main-obj-code
      589           no-error.
      590           if available buf_temp_fbrcode-doc-code
      591           then do:
      592               assign
      593                   p-income-doc-code = buf_temp_fbrcode-doc-code.doc-code
      594               .
      595           end.
      596           else do:
      597               assign
      598                   p-income-doc-code = "":U
      599               .
      600           end.
      601       end.
      602   end.
      603   end procedure.
      604   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      605   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
      606   procedure partslib-clear-temp-parts :
      607     define buffer buf_temp-parts for temp-parts .
      608     do
      609     on error undo, return error
      610     :
      611       for each buf_temp-parts
      612       on error undo, return error
      613       :
      614         delete buf_temp-parts .
      615       end.
      616     end.
      617   end procedure.
      618   procedure partslib-create-temp-parts :
      619     define parameter buffer buf_parts       for ub.parts .
      620     define parameter buffer buf_temp-parts  for temp-parts .
      621     define input  parameter p-goods-twounit as logical   no-undo .
      622     define variable v-base-part-code as character no-undo .
      623     do
      624     on error undo, return error
      625     :
      626       if p-goods-twounit = true
      627       then do:
      628         assign
      629           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      630         .
      631       end.
      632       else do:
      633         assign
      634           v-base-part-code = buf_parts.part-code
      635         .
      636       end.
      637       find first buf_temp-parts exclusive-lock
      638         where buf_temp-parts.obj-type  = buf_parts.obj-type
      639           and buf_temp-parts.obj-code  = buf_parts.obj-code
      640           and buf_temp-parts.artic     = buf_parts.artic
      641           and buf_temp-parts.prod-type = buf_parts.prod-type
      642           and buf_temp-parts.prod-code = buf_parts.prod-code
      643           and buf_temp-parts.in-code   = buf_parts.in-code
      644           and buf_temp-parts.out-code  = 'free-zone':U
      645           and buf_temp-parts.part-code = v-base-part-code
      646         no-error.
      647       if not available buf_temp-parts
      648       then do:
      649         create buf_temp-parts .
      650         buffer-copy buf_parts to buf_temp-parts
      651         assign
      652           buf_temp-parts.out-code  = 'free-zone':U
      653           buf_temp-parts.part-code = v-base-part-code
      654           buf_temp-parts.rsrv-free = yes
      655           buf_temp-parts.status_   = no
      656           buf_temp-parts.qnty      = 0
      657           buf_temp-parts.fact-qnty = 0
      658           buf_temp-parts.real-qnty = 0
      659           buf_temp-parts.cli-qnty  = 0
      660         .
      661       end.
      662     end.
      663   end procedure.
      664   procedure partslib-init-temp-parts :
      665     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
      666     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
      667     define input parameter p-artic           like ub.parts.artic     no-undo .
      668     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
      669     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
      670     define buffer buf_parts      for ub.parts .
      671     define buffer buf_temp-parts for temp-parts .
      672     define variable v-goods-twounit    as logical   no-undo .
      673     do
      674     on error undo, return error
      675     :
      676   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      677   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      678     (input  p-artic
      679     ,input  p-prod-type
      680     ,input  p-prod-code
      681     ,input  'twounit=request':u
      682     ,output v-goods-twounit
      683     ) no-error .
      684       if error-status :error
      685       then do:
      686         message
      687           vss-workfile vss-revision vss-description skip
      688           vss-include-info5 skip
      689           "Ошибка при определении атрибута товара" skip
      690           "Артикул" p-artic p-prod-type p-prod-code skip
      691           "twounit=request" skip
      692           error-status :get-message(1) skip
      693           return-value skip
      694           view-as alert-box error .
      695         undo, return error return-value .
      696       end.
      697       run partslib-clear-temp-parts in this-procedure .
      698       for each buf_parts
      699         where buf_parts.obj-type  = p-obj-type
      700           and buf_parts.obj-code  = p-obj-code
      701           and buf_parts.artic     = p-artic
      702           and buf_parts.prod-type = p-prod-type
      703           and buf_parts.prod-code = p-prod-code
      704           and buf_parts.rsrv-free = yes
      705           and buf_parts.status_   = no
      706           and buf_parts.in-code   <> buf_parts.out-code
      707       on error undo, return error
      708       :
      709         run partslib-create-temp-parts in this-procedure
      710           (buffer buf_parts
      711           ,buffer buf_temp-parts
      712           ,input  v-goods-twounit
      713           ) .
      714         define variable v-parts-qnty          as decimal   no-undo .
      715         define variable v-parts-cli-qnty      as decimal   no-undo .
      716         define variable v-parts-free-qnty     as decimal   no-undo .
      717         define variable v-parts-free-cli-qnty as decimal   no-undo .
      718         if buf_parts.out-code = 'free-zone':U
      719         then do:
      720           assign
      721             v-parts-qnty          = buf_parts.qnty
      722             v-parts-cli-qnty      = buf_parts.cli-qnty
      723             v-parts-free-qnty     = buf_parts.qnty
      724             v-parts-free-cli-qnty = buf_parts.cli-qnty
      725           .
      726         end.
      727         else do:
      728           assign
      729             v-parts-qnty          = abs(buf_parts.qnty)
      730             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
      731             v-parts-free-qnty     = 0
      732             v-parts-free-cli-qnty = 0
      733           .
      734         end.
      735         assign
      736           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
      737           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
      738           buf_temp-parts.real-qnty     = 0
      739           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
      740           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
      741           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
      742         .
      743       end.
      744     end.
      745   end procedure.
      746   procedure partslib-init-temp-parts-by-factord :
      747     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      748     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      749     define input parameter p-artic              like ub.parts.artic     no-undo .
      750     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      751     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      752     define input parameter p-fact-order         as decimal   no-undo .
      753     define input parameter p-include-fact-order as logical   no-undo .
      754     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      755     define buffer buf_gds-obj  for ub.gds-obj .
      756     do
      757     on error undo, return error
      758     :
      759       do transaction
      760       on error undo, return error
      761       :
      762   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      763   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      764     (input  p-obj-type
      765     ,input  p-obj-code
      766     ,input  p-artic
      767     ,input  p-prod-type
      768     ,input  p-prod-code
      769     ,buffer buf_gds-obj
      770     ) no-error .
      771         if error-status :error
      772         then do:
      773           message
      774             vss-workfile vss-revision vss-description skip
      775             vss-include-info5 skip
      776             "Невозможно найти товар на объекте" skip
      777             "Объект" p-obj-type p-obj-code skip
      778             "Артикул" p-artic p-prod-type p-prod-code skip
      779             error-status :get-message(1) skip
      780             return-value skip
      781             view-as alert-box error .
      782           undo, return error .
      783         end.
      784         find current buf_gds-obj exclusive-lock .
      785       end.
      786       run partslib-init-temp-parts in this-procedure
      787         (input p-obj-type
      788         ,input p-obj-code
      789         ,input p-artic
      790         ,input p-prod-type
      791         ,input p-prod-code
      792         ) no-error .
      793       if error-status :error
      794       then do:
      795         message
      796           vss-workfile vss-revision vss-description skip
      797           vss-include-info5 skip
      798           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
      799           "Объект" p-obj-type p-obj-code skip
      800           "Артикул" p-artic p-prod-type p-prod-code skip
      801           "p-fact-order" p-fact-order skip
      802           view-as alert-box error .
      803         undo, return error .
      804       end.
      805       if p-include-fact-order = true
      806       then do:
      807         assign
      808           p-fact-order = p-fact-order - 0.0000000001
      809         .
      810       end.
      811       define variable v-max-fact-order as character no-undo .
      812       run factord-max-fact-order in this-procedure
      813         (output v-max-fact-order
      814         ) no-error .
      815       if error-status :error
      816       then do:
      817         message
      818           vss-workfile vss-revision vss-description skip
      819           vss-include-info5 skip
      820           "Ошибка при вызове процедуры factord-max-fact-order" skip
      821           "Объект" p-obj-type p-obj-code skip
      822           "Артикул" p-artic p-prod-type p-prod-code skip
      823           "p-fact-order" p-fact-order skip
      824           view-as alert-box error .
      825         undo, return error .
      826       end.
      827       run partslib-update-by-factord in this-procedure
      828         (input p-obj-type
      829         ,input p-obj-code
      830         ,input p-artic
      831         ,input p-prod-type
      832         ,input p-prod-code
      833         ,input p-fact-order
      834         ,input v-max-fact-order
      835         ,input false
      836         ) no-error .
      837       if error-status :error
      838       then do:
      839         message
      840           vss-workfile vss-revision vss-description skip
      841           vss-include-info5 skip
      842           "Ошибка при вызове процедуры partslib-update-by-factord" skip
      843           "Объект" p-obj-type p-obj-code skip
      844           "Артикул" p-artic p-prod-type p-prod-code skip
      845           "p-fact-order" p-fact-order skip
      846           "v-max-fact-order" v-max-fact-order skip
      847           view-as alert-box error .
      848         undo, return error .
      849       end.
      850     end.
      851   end procedure.
      852   procedure partslib-update-by-factord :
      853     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
      854     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
      855     define input parameter p-artic              like ub.parts.artic     no-undo .
      856     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
      857     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
      858     define input parameter p-start-fact-order   as decimal   no-undo .
      859     define input parameter p-end-fact-order     as decimal   no-undo .
      860     define input parameter p-lock-gds-obj       as logical   no-undo .
      861     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
      862     define buffer buf_gds-obj  for ub.gds-obj .
      863     define buffer buf_doc-line for ub.doc-line .
      864     define variable v-total-parts-qnty as decimal   no-undo .
      865     define variable v-goods-gds-goods  as logical   no-undo .
      866     define variable v-goods-twounit    as logical   no-undo .
      867     do
      868     on error undo, return error
      869     :
      870       if p-start-fact-order > p-end-fact-order
      871       then do:
      872         message
      873           vss-workfile vss-revision vss-description skip
      874           vss-include-info5 skip
      875           "Ошибка задания входных параметров" skip
      876           "Начало интервала превышает конец интервала" skip
      877           "Объект" p-obj-type p-obj-code skip
      878           "Артикул" p-artic p-prod-type p-prod-code skip
      879           "p-start-fact-order" p-start-fact-order skip
      880           "p-end-fact-order"   p-end-fact-order skip
      881           view-as alert-box error .
      882         undo, return error .
      883       end.
      884       if p-lock-gds-obj = true
      885       then do:
      886         do transaction
      887         on error undo, return error
      888         :
      889   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      890   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
      891     (input  p-obj-type
      892     ,input  p-obj-code
      893     ,input  p-artic
      894     ,input  p-prod-type
      895     ,input  p-prod-code
      896     ,buffer buf_gds-obj
      897     ) no-error .
      898           if error-status :error
      899           then do:
      900             message
      901               vss-workfile vss-revision vss-description skip
      902               vss-include-info5 skip
      903               "Невозможно найти gds-obj" skip
      904               error-status :get-message(1) skip
      905               return-value skip
      906               view-as alert-box error .
      907             undo, return error .
      908           end.
      909           find current buf_gds-obj exclusive-lock .
      910         end.
      911       end.
      912   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      913   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      914     (input  p-artic
      915     ,input  p-prod-type
      916     ,input  p-prod-code
      917     ,input  'gds-goods=request':u
      918     ,output v-goods-gds-goods
      919     ) no-error .
      920       if error-status :error
      921       then do:
      922         message
      923           vss-workfile vss-revision vss-description skip
      924           vss-include-info5 skip
      925           "Ошибка при определении атрибута товара" skip
      926           "Артикул" p-artic p-prod-type p-prod-code skip
      927           "gds-goods=request" skip
      928           error-status :get-message(1) skip
      929           return-value skip
      930           view-as alert-box error .
      931         undo, return error return-value .
      932       end.
      933   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      934   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
      935     (input  p-artic
      936     ,input  p-prod-type
      937     ,input  p-prod-code
      938     ,input  'twounit=request':u
      939     ,output v-goods-twounit
      940     ) no-error .
      941       if error-status :error
      942       then do:
      943         message
      944           vss-workfile vss-revision vss-description skip
      945           vss-include-info5 skip
      946           "Ошибка при определении атрибута товара" skip
      947           "Артикул" p-artic p-prod-type p-prod-code skip
      948           "twounit=request" skip
      949           error-status :get-message(1) skip
      950           return-value skip
      951           view-as alert-box error .
      952         undo, return error return-value .
      953       end.
      954       for each buf_doc-line no-lock
      955         where buf_doc-line.obj-type   = p-obj-type
      956           and buf_doc-line.obj-code   = p-obj-code
      957           and buf_doc-line.artic      = p-artic
      958           and buf_doc-line.prod-type  = p-prod-type
      959           and buf_doc-line.prod-code  = p-prod-code
      960           and buf_doc-line.status_    = 'факт':U
      961           and buf_doc-line.fact-order > p-start-fact-order
      962           and buf_doc-line.fact-order <= p-end-fact-order
      963       on error undo, return error
      964       :
      965         run partslib-process-document in this-procedure
      966           (input  buf_doc-line.doc-code
      967           ,input  p-obj-type
      968           ,input  p-obj-code
      969           ,input  p-artic
      970           ,input  p-prod-type
      971           ,input  p-prod-code
      972           ,input  v-goods-gds-goods
      973           ,input  v-goods-twounit
      974           ,output v-total-parts-qnty
      975           ) no-error .
      976         if error-status :error
      977         then do:
      978           message
      979             vss-workfile vss-revision vss-description skip
      980             vss-include-info5 skip
      981             "Ошибка при вызове процедуры partslib-process-document" skip
      982             "Документ" buf_doc-line.doc-code skip
      983             "Объект" p-obj-type p-obj-code skip
      984             "Артикул" p-artic p-prod-type p-prod-code skip
      985             "p-start-fact-order" p-start-fact-order skip
      986             "p-end-fact-order" p-end-fact-order skip
      987             error-status :get-message(1) skip
      988             return-value skip
      989             view-as alert-box error .
      990           undo, return error return-value .
      991         end.
      992       end.
      993     end.
      994   end procedure.
      995   procedure partslib-process-document :
      996     define input  parameter p-doc-code         as character no-undo .
      997     define input  parameter p-obj-type         as character no-undo .
      998     define input  parameter p-obj-code         as integer   no-undo .
      999     define input  parameter p-artic            as character no-undo .
     1000     define input  parameter p-prod-type        as character no-undo .
     1001     define input  parameter p-prod-code        as integer   no-undo .
     1002     define input  parameter p-goods-gds-goods  as logical   no-undo .
     1003     define input  parameter p-goods-twounit    as logical   no-undo .
     1004     define output parameter p-total-parts-qnty as decimal   no-undo .
     1005     define variable v-parts-sign as integer   no-undo .
     1006     define buffer buf_trn-doc    for ub.trn-doc .
     1007     define buffer buf_doc-line   for ub.doc-line .
     1008     define buffer buf_parts      for ub.parts .
     1009     define buffer buf_temp-parts for temp-parts .
     1010     do
     1011     on error undo, return error return-value
     1012     :
     1013       find first buf_trn-doc no-lock
     1014         where buf_trn-doc.doc-code = p-doc-code
     1015         no-error .
     1016       if not available buf_trn-doc
     1017       then do:
     1018         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     1019                                      ,p-doc-code
     1020                                      ) .
     1021       end.
     1022       case buf_trn-doc.doc-type
     1023       :
     1024         when 'при':U or
     1025         when 'возврат':U or
     1026         when 'инв':U
     1027         then do:
     1028           assign
     1029             v-parts-sign = -1
     1030           .
     1031         end.
     1032         when 'рас':U or
     1033         when 'спи':U
     1034         then do:
     1035           assign
     1036             v-parts-sign = 1
     1037           .
     1038         end.
     1039         otherwise do:
     1040           undo, return error substitute("Неизвестный тип документа &1"
     1041                                       ,buf_trn-doc.doc-type
     1042                                       ) .
     1043         end.
     1044       end.
     1045       find first buf_doc-line no-lock
     1046         where buf_doc-line.doc-code  = p-doc-code
     1047           and buf_doc-line.artic     = p-artic
     1048           and buf_doc-line.prod-type = p-prod-type
     1049           and buf_doc-line.prod-code = p-prod-code
     1050         no-error .
     1051       if not available buf_doc-line
     1052       then do:
     1053         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     1054                                      ,p-doc-code
     1055                                      ,artic
     1056                                      ,prod-type
     1057                                      ,prod-code
     1058                                      ) .
     1059       end.
     1060       assign
     1061         p-total-parts-qnty = 0
     1062       .
     1063       if p-goods-gds-goods = true
     1064       then do:
     1065         for each buf_parts no-lock
     1066           where buf_parts.out-code  = p-doc-code
     1067             and buf_parts.obj-type  = p-obj-type
     1068             and buf_parts.obj-code  = p-obj-code
     1069             and buf_parts.artic     = p-artic
     1070             and buf_parts.prod-type = p-prod-type
     1071             and buf_parts.prod-code = p-prod-code
     1072         on error undo, return error
     1073         :
     1074           run partslib-create-temp-parts in this-procedure
     1075             (buffer buf_parts
     1076             ,buffer buf_temp-parts
     1077             ,input  p-goods-twounit
     1078             ) .
     1079           assign
     1080             p-total-parts-qnty        = p-total-parts-qnty
     1081                                       + v-parts-sign * buf_parts.fact-qnty
     1082             buf_temp-parts.qnty       = buf_temp-parts.qnty
     1083                                       + v-parts-sign * buf_parts.fact-qnty
     1084             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     1085                                       + v-parts-sign * buf_parts.fact-qnty
     1086             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     1087                                       + v-parts-sign * buf_parts.cli-qnty
     1088           .
     1089           if buf_temp-parts.qnty = 0
     1090           then do:
     1091             delete buf_temp-parts .
     1092           end.
     1093         end.
     1094       end.
     1095       else do:
     1096         assign
     1097           p-total-parts-qnty = p-total-parts-qnty
     1098                              + v-parts-sign * buf_doc-line.fact-qnty
     1099         .
     1100       end.
     1101     end.
     1102   end procedure.
     1103   procedure partslib-init-temp-parts-by-date :
     1104     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1105     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1106     define input parameter p-artic           like ub.parts.artic     no-undo .
     1107     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1108     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1109     define input parameter p-fact-date       as date      no-undo .
     1110     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     1111     do
     1112     on error undo, return error
     1113     :
     1114       define variable v-fact-order                as decimal   no-undo .
     1115       define variable v-shift-end-fact-order      as decimal   no-undo .
     1116       define variable v-day-end-fact-order        as decimal   no-undo .
     1117       run factord in this-procedure
     1118         (input  p-fact-date
     1119         ,input  1
     1120         ,input  1
     1121         ,input  ?
     1122         ,input  0
     1123         ,input  false
     1124         ,output v-fact-order
     1125         ,output v-shift-end-fact-order
     1126         ,output v-day-end-fact-order
     1127         ) no-error .
     1128       if error-status :error
     1129       then do:
     1130         message
     1131           vss-workfile vss-revision vss-description skip
     1132           vss-include-info5 skip
     1133           "Ошибка при определении момента времени, на который требуется остаток" skip
     1134           "Объект" p-obj-type p-obj-code skip
     1135           "Артикул" p-artic p-prod-type p-prod-code skip
     1136           "Дата" p-fact-date skip
     1137           view-as alert-box error .
     1138         undo, return error .
     1139       end.
     1140       run partslib-init-temp-parts-by-factord in this-procedure
     1141         (input p-obj-type
     1142         ,input p-obj-code
     1143         ,input p-artic
     1144         ,input p-prod-type
     1145         ,input p-prod-code
     1146         ,input v-day-end-fact-order
     1147         ,input false
     1148         ) no-error .
     1149       if error-status :error
     1150       then do:
     1151         message
     1152           vss-workfile vss-revision vss-description skip
     1153           vss-include-info5 skip
     1154           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     1155           "Объект" p-obj-type p-obj-code skip
     1156           "Артикул" p-artic p-prod-type p-prod-code skip
     1157           "Дата" p-fact-date skip
     1158           view-as alert-box error .
     1159         undo, return error .
     1160       end.
     1161     end.
     1162   end procedure.
     1163   procedure partslib-calc-cost :
     1164     define output parameter p-fact-qnty      as decimal   no-undo .
     1165     define output parameter p-vat-pc         as decimal   no-undo .
     1166     define output parameter p-slt-pc         as decimal   no-undo .
     1167     define output parameter p-sum-base       as decimal   no-undo .
     1168     define output parameter p-sum-rubl       as decimal   no-undo .
     1169     define output parameter p-vat-base       as decimal   no-undo .
     1170     define output parameter p-vat-rubl       as decimal   no-undo .
     1171     define output parameter p-slt-base       as decimal   no-undo .
     1172     define output parameter p-slt-rubl       as decimal   no-undo .
     1173     define output parameter p-road-tax-base  as decimal   no-undo .
     1174     define output parameter p-road-tax-rubl  as decimal   no-undo .
     1175     define output parameter p-transport-base as decimal   no-undo .
     1176     define output parameter p-transport-rubl as decimal   no-undo .
     1177     define output parameter p-other-base     as decimal   no-undo .
     1178     define output parameter p-other-rubl     as decimal   no-undo .
     1179     define output parameter p-excise-base    as decimal   no-undo .
     1180     define output parameter p-excise-rubl    as decimal   no-undo .
     1181     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     1182     do
     1183     on error undo, return error return-value
     1184     :
     1185       define buffer buf_temp-parts for temp-parts .
     1186       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1187       define buffer   in-vatp-parts    for ub.parts   .
     1188       define buffer   in-vatp-doc      for ub.trn-doc .
     1189       define buffer   in-vatp-goods    for ub.goods   .
     1190       define buffer   in-vatp-sysconf  for ub.sysconf .
     1191       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1192       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1193       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1194       define variable varinvprb                  as   character              no-undo.
     1195       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1196       define variable cli-base-rate              as   decimal                no-undo.
     1197       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1198       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1199       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1200       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1201       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1202       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1203       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1204       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1205       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1206       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1207       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1208       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1209       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1210       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1211       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1212       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1213       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1214       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1215       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1216       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1217       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1218       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1219       define variable varinvatp-envd             as   character              no-undo.
     1220       define variable varinvatp-type             as   character              no-undo.
     1221       for each buf_temp-parts
     1222       on error undo, return error
     1223       :
     1224   assign
     1225     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     1226     price-base-with-tax-loc = buf_temp-parts.price-base
     1227   .
     1228   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1229   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1230     (output varinvprb
     1231     )  .
     1232     if buf_temp-parts.out-code = 'free-zone':U     or
     1233        buf_temp-parts.out-code = 'out-zone':U   or
     1234        buf_temp-parts.doc-type = 'акт':U then do:
     1235       assign
     1236         in-vatp-have-vat-slt = yes.
     1237     end.
     1238     else do:
     1239       find first in-vatp_doc-attr no-lock
     1240         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     1241           and in-vatp_doc-attr.attr-code = 'envd':U
     1242         no-error .
     1243       if not available in-vatp_doc-attr then do:
     1244         assign
     1245           in-vatp-have-vat-slt = yes.
     1246       end.
     1247       else do:
     1248            in-vatp-have-vat-slt = no.
     1249       end.
     1250     end.
     1251     assign
     1252      price-cli-with-tax-loc = buf_temp-parts.price-cli
     1253      cli-base-rate          = buf_temp-parts.cli-base-rate.
     1254     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     1255              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     1256     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     1257             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     1258             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     1259             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     1260             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     1261             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     1262             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1263       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1264     assign
     1265       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     1266     assign
     1267       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1268       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1269       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1270       transport-cli-loc  = 0
     1271       other-cli-loc      = 0
     1272     .
     1273   ASSIGN
     1274             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1275       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1276   .
     1277         assign
     1278           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     1279           p-vat-pc         = p-vat-pc         + vat-pc-loc
     1280           p-slt-pc         = p-slt-pc         + slt-pc-loc
     1281           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     1282           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     1283           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     1284           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     1285           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     1286           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     1287           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     1288           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     1289           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     1290           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     1291           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     1292           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     1293           p-excise-base    = p-excise-base    + 0
     1294           p-excise-rubl    = p-excise-rubl    + 0
     1295         .
     1296       end.
     1297       if p-fact-qnty      = ?
     1298       or p-sum-base       = ?
     1299       or p-sum-rubl       = ?
     1300       or p-vat-base       = ?
     1301       or p-vat-rubl       = ?
     1302       or p-slt-base       = ?
     1303       or p-slt-rubl       = ?
     1304       or p-road-tax-base  = ?
     1305       or p-road-tax-rubl  = ?
     1306       or p-transport-base = ?
     1307       or p-transport-rubl = ?
     1308       or p-other-base     = ?
     1309       or p-other-rubl     = ?
     1310       or p-excise-base    = ?
     1311       or p-excise-rubl    = ?
     1312       then do:
     1313         message
     1314           vss-workfile vss-revision vss-description skip
     1315           vss-include-info5 skip
     1316           "Программа in-vatp.i вернула неопределенные значения" skip
     1317           "p-fact-qnty"      p-fact-qnty      skip
     1318           "p-sum-base"       p-sum-base       skip
     1319           "p-sum-rubl"       p-sum-rubl       skip
     1320           "p-vat-base"       p-vat-base       skip
     1321           "p-vat-rubl"       p-vat-rubl       skip
     1322           "p-slt-base"       p-slt-base       skip
     1323           "p-slt-rubl"       p-slt-rubl       skip
     1324           "p-road-tax-base"  p-road-tax-base  skip
     1325           "p-road-tax-rubl"  p-road-tax-rubl  skip
     1326           "p-transport-base" p-transport-base skip
     1327           "p-transport-rubl" p-transport-rubl skip
     1328           "p-other-base"     p-other-base     skip
     1329           "p-other-rubl"     p-other-rubl     skip
     1330           "p-excise-base"    p-excise-base    skip
     1331           "p-excise-rubl"    p-excise-rubl    skip
     1332           view-as alert-box error .
     1333         undo, return error .
     1334       end.
     1335     end.
     1336   end procedure.
     1337   define variable vss-include-info12 as character format "X(65)" no-undo
     1338   initial "@(#)$Workfile$ $Revision$".
     1339   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
     1340   run gbl/getobjsrvhndl.p (input-output ObjSrv).
     1341   define temp-table temp_fbrlib_recipe no-undo
     1342       field recipe-code                   as character
     1343       field fbr-doc-code                  as character
     1344       field income-goods-doc-code         as character
     1345       field count-income                  as integer
     1346       field qnty-income                   as decimal
     1347       field sum-income-sale               as decimal
     1348       field sum-income-cost-base          as decimal
     1349       field sum-income-cost-rubl          as decimal
     1350       field sum-income-vat-cost-base      as decimal
     1351       field sum-income-vat-cost-rubl      as decimal
     1352       field write-off-goods-doc-code      as character
     1353       field write-off-office-doc-code     as character
     1354       field count-write-off               as integer
     1355       field qnty-write-off                as decimal
     1356       field sum-write-off-sale            as decimal
     1357       field sum-write-off-cost-base       as decimal
     1358       field sum-write-off-cost-rubl       as decimal
     1359       field sum-write-off-vat-cost-base   as decimal
     1360       field sum-write-off-vat-cost-rubl   as decimal
     1361   index pi is primary unique recipe-code
