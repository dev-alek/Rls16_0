     8041   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     8042     (input  buf_init_goods.artic
     8043     ,input  buf_init_goods.prod-type
     8044     ,input  buf_init_goods.prod-code
     8045     ,output v-init-gds-code
     8046     )  .
