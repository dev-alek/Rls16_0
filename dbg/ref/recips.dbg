     8290     ,input  buf_recipe.prod-type
     8291     ,input  buf_recipe.prod-code
     8292     ,output v-gds-code
     8293     )  .
     8294   define variable vss-include-info63 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8295   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     8296     (input  v-gds-code
     8297     ,output v-unit-base
     8298     )  .
     8299       find first buf_units no-lock
     8300            where buf_units.unit-name = v-unit-base
     8301       .
     8302       if lookup( 'шту':U, buf_units.type ) > 0
     8303       and ( truncate( p-recipe-qnty, 0 ) - p-recipe-qnty ) <> 0
     8304       and buf_recipe.recipe-type <> 'альтернатива':U
     8305       then do:
     8306           assign
     8307               p-bad-data   = yes
     8308               p-error-text = "Товар рецепта штучный, его количество не может быть дробным."
     8309           .
     8310           undo, return.
     8311       end.
     8312   define variable vss-include-info64 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8313   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     8314     (input  buf_recipe.artic
     8315     ,input  buf_recipe.prod-type
     8316     ,input  buf_recipe.prod-code
     8317     ,input  'gds-goods=request':u
     8318     ,output v-is-goods
     8319     )  .
     8320       if buf_recipe.recipe-type = 'комплектация':U
     8321       and lookup( 'шту':U, buf_units.type ) = 0
     8322       and v-is-goods = yes
     8323       then do:
     8324           assign
     8325               p-bad-data   = yes
     8326               p-error-text = "Рецепт на комплектацию может быть составлен только для штучного товара."
     8327           .
     8328           undo, return.
     8329       end.
     8330       if buf_recipe.recipe-type = 'разделка':U
     8331       and lookup( 'вес':U, buf_units.type ) = 0
     8332       and v-is-goods = yes
     8333       then do:
     8334           assign
     8335               p-bad-data   = yes
     8336               p-error-text = "Рецепт на разделку может быть составлен только для весового товара."
     8337           .
     8338           undo, return.
     8339       end.
     8340       if lookup( 'сер':U, buf_units.type ) > 0
     8341       then do:
     8342           assign
     8343               p-bad-data   = yes
     8344               p-error-text = "Для серийного товара не может быть составлен рецепт."
     8345           .
     8346           undo, return.
     8347       end.
     8348       assign
     8349           v-ingr-count = 0
     8350       .
     8351       for each buf_recipe-gds
     8352          where buf_recipe-gds.doc-code    = p-doc-code
     8353            and buf_recipe-gds.recipe-code = buf_recipe.recipe-code
     8354       :
     8355           if  buf_recipe-gds.artic     = buf_recipe.artic
     8356           and buf_recipe-gds.prod-type = buf_recipe.prod-type
     8357           and buf_recipe-gds.prod-code = buf_recipe.prod-code
     8358           then do:
     8359               assign
     8360                   p-bad-data   = yes
     8361                   p-error-text = "Строка рецепта не может содержать тот же товар, что и сам рецепт."
     8362               .
     8363               undo, return.
     8364           end.
     8365   define variable vss-include-info65 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8366   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     8367     (input  buf_recipe-gds.artic
     8368     ,input  buf_recipe-gds.prod-type
     8369     ,input  buf_recipe-gds.prod-code
     8370     ,output v-gds-code
     8371     )  .
     8372   define variable vss-include-info66 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8373   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     8374     (input  v-gds-code
     8375     ,output v-unit-base
     8376     )  .
     8377           find first buf_units no-lock
     8378                where buf_units.unit-name = v-unit-base
     8379           .
     8380           if lookup( 'шту':U, buf_units.type ) > 0
     8381           and ( truncate( buf_recipe-gds.qnty, 0 ) - buf_recipe-gds.qnty ) <> 0
     8382           and buf_recipe.recipe-type <> 'альтернатива':U
     8383           then do:
     8384               assign
     8385                   p-bad-data   = yes
     8386                   p-error-text =  "Товар-ингредиент штучный, его количество не может быть дробным."
     8387                                   + chr(10) + substitute( "Артикул: &1", buf_recipe-gds.artic )
     8388               .
     8389               undo, return.
     8390           end.
     8391           if buf_recipe-gds.brutto-qnty < buf_recipe-gds.qnty
     8392           then do:
     8393               assign
     8394                   p-bad-data   = yes
     8395                   p-error-text = "Брутто товара не может быть меньше нетто."
     8396                                   + chr(10) + substitute( "Артикул: &1", buf_recipe-gds.artic )
     8397               .
     8398               undo, return.
     8399           end.
     8400   define variable vss-include-info67 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8401   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     8402     (input  buf_recipe-gds.artic
     8403     ,input  buf_recipe-gds.prod-type
     8404     ,input  buf_recipe-gds.prod-code
     8405     ,input  'gds-goods=request':u
     8406     ,output v-is-goods
     8407     )  .
     8408           if buf_recipe.recipe-type = 'комплектация':U
     8409           and lookup( 'шту':U, buf_units.type ) = 0
     8410           and v-is-goods = yes
     8411           then do:
     8412               assign
     8413                   p-bad-data   = yes
     8414                   p-error-text = "В рецепте на комплектацию должен быть только штучный товар."
     8415               .
     8416               undo, return.
     8417           end.
     8418           if buf_recipe.recipe-type = 'разделка':U
     8419           and lookup( 'вес':U, buf_units.type ) = 0
     8420           and v-is-goods = yes
     8421           then do:
     8422               assign
     8423                   p-bad-data   = yes
     8424                   p-error-text = "В рецепте на разделку должен быть только весовой товар."
     8425               .
     8426               undo, return.
     8427           end.
     8428           if lookup( 'сер':U, buf_units.type ) > 0
     8429           then do:
     8430               assign
     8431                   p-bad-data   = yes
     8432                   p-error-text = "В рецепте не может быть серийного товара."
     8433               .
     8434               undo, return.
     8435           end.
     8436           if ( buf_recipe.recipe-type <> 'топливо':U
     8437               and lookup( 'топ':U, buf_units.type ) > 0 )
     8438           or ( buf_recipe.recipe-type = 'топливо':U
     8439               and lookup( 'топ':U, buf_units.type ) = 0 )
     8440           then do:
     8441               assign
     8442                   p-bad-data   = yes
     8443                   p-error-text = "Топливный товар (услуга) может входить только в топливный рецепт."
     8444               .
     8445               undo, return.
     8446           end.
     8447           assign
     8448               v-ingr-count = v-ingr-count + 1
     8449           .
     8450           if buf_recipe-gds.is-waste = yes
     8451           then do:
     8452               assign
     8453                   v-waste-count = v-waste-count + 1
     8454               .
     8455           end.
     8456       end.
     8457       if v-ingr-count = 0
     8458       then do:
     8459           assign
     8460               p-bad-data   = yes
     8461               p-error-text = "В рецепте нет ни одной строки."
     8462           .
     8463           undo, return.
     8464       end.
     8465       if buf_recipe.recipe-type = 'топливо':U
     8466       and v-ingr-count <> 1
     8467       then do:
     8468           assign
     8469               p-bad-data   = yes
     8470               p-error-text = "В топливном рецепте должна быть ровно 1 строка."
     8471           .
     8472           undo, return.
     8473       end.
     8474       if buf_recipe.recipe-type = 'разделка':U
     8475       and v-ingr-count = 1
     8476       then do:
     8477           assign
     8478               p-bad-data   = yes
     8479               p-error-text = "В рецепте разделки не может быть только 1 строка."
     8480           .
     8481           undo, return.
     8482       end.
     8483       if v-ingr-count = v-waste-count
     8484       then do:
     8485           assign
     8486               p-bad-data   = yes
     8487               p-error-text = "Рецепт не может состоять из одних отходов."
     8488           .
     8489           undo, return.
     8490       end.
     8491   end.
     8492   END PROCEDURE.
     8493   PROCEDURE disable_UI :
     8494     HIDE FRAME Dialog-Frame.
     8495   END PROCEDURE.
     8496   PROCEDURE enable_UI :
     8497     DISPLAY fi-recipe-name fi-recipe-qnty fi-recipe-ref-num fi-recipe-portion-weight fi-portion-qnty
     8498             fi-init-units fi-recipe-technique-label ed-recipe-technique
     8499             br-table-label v-fat v-protein v-carbohydrate v-calories
     8500         WITH FRAME Dialog-Frame.
     8501     ENABLE b-close b-cancel b-gds b-hst b-rcp b-additional b-print b-help
     8502            fi-recipe-name fi-recipe-qnty fi-recipe-ref-num fi-recipe-portion-weight fi-portion-qnty
     8503            ed-recipe-technique b-change b-up b-down br-table v-fat v-protein
     8504            v-carbohydrate v-calories
     8505         WITH FRAME Dialog-Frame.
     8506     VIEW FRAME Dialog-Frame.
     8507     OPEN QUERY br-table FOR EACH ub.fbr-recipe-gds       WHERE fbr-recipe-gds.recipe-code = buf_init_recipe.recipe-code  AND fbr-recipe-gds.doc-code = p-doc-code NO-LOCK     BY ub.fbr-recipe-gds.proc-number.
     8508   END PROCEDURE.
     8509   PROCEDURE get-obj-name :
     8510   do
     8511   on error undo, return error
     8512   :
     8513   define input parameter p-obj-type as character no-undo.
     8514   define input parameter p-obj-code as integer no-undo.
     8515   define output parameter p-obj-name as character no-undo.
     8516       define buffer buf_clients for clients.
     8517       find first buf_clients no-lock
     8518           where buf_clients.obj-type = p-obj-type
     8519             and buf_clients.obj-code = p-obj-code
     8520       no-error.
     8521       if available buf_clients
     8522       then do:
     8523           assign
     8524               p-obj-name = buf_clients.obj-name
     8525           .
     8526       end.
     8527       else do:
     8528           assign
     8529               p-obj-name = ""
     8530           .
     8531       end.
     8532   end.
     8533   END PROCEDURE.
     8534   PROCEDURE init-fields :
     8535   do
     8536   on error undo, return error
     8537   :
     8538       assign
     8539           fi-recipe-name          = buf_init_recipe.recipe-name
     8540           fi-recipe-qnty          = buf_init_recipe.qnty
     8541           fi-brutto-qnty          = buf_init_recipe.brutto-qnty
     8542           fi-portion-qnty         = buf_init_recipe.portion-qnty
     8543           fi-recipe-ref-num       = buf_init_recipe.recipe-ref-num
     8544           fi-recipe-portion-weight        = buf_init_recipe.portion-weight
     8545           ed-recipe-technique     = buf_init_recipe.recipe-technique
     8546       .
     8547   end.
     8548   END PROCEDURE.
     8549   FUNCTION get-browse-field RETURNS CHARACTER
     8550     ( input p-parameter-number as integer, input p-artic as character, input p-prod-type as character, input p-prod-code as integer ) :
     8551       define variable v-is-goods  as logical no-undo.
     8552       define variable v-output-string as character no-undo.
     8553       define variable v-gds-code as integer no-undo.
     8554       if p-parameter-number = 1
     8555       then do:
     8556   define variable vss-include-info68 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8557   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     8558     (input  p-artic
     8559     ,input  p-prod-type
     8560     ,input  p-prod-code
     8561     ,input  'gds-goods=request':u
     8562     ,output v-is-goods
     8563     )  .
     8564           assign
     8565               v-output-string = ( if v-is-goods = yes then "-":U else "+":U )
     8566           .
     8567       end.
     8568       if p-parameter-number = 2
     8569       then do:
     8570   define variable vss-include-info69 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8571   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     8572     (input  p-artic
     8573     ,input  p-prod-type
     8574     ,input  p-prod-code
     8575     ,output v-output-string
     8576     )  .
     8577       end.
     8578       if p-parameter-number = 3
     8579       then do:
     8580   define variable vss-include-info70 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8581   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     8582     (input  p-artic
     8583     ,input  p-prod-type
     8584     ,input  p-prod-code
     8585     ,output v-gds-code
     8586     )  .
     8587   define variable vss-include-info71 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8588   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     8589     (input  v-gds-code
     8590     ,output v-output-string
     8591     )  .
     8592       end.
     8593       if p-parameter-number = 4
     8594       then do:
     8595           run get-obj-name in this-procedure (
     8596                 input p-prod-type
     8597               , input p-prod-code
     8598               , output v-output-string
     8599           ).
     8600       end.
     8601       RETURN v-output-string.
     8602   END FUNCTION.
