     4373     define variable v-cntxt-obj-code      as integer   no-undo .
     4374     define variable v-cntxt-db-num-obj    as integer   no-undo .
     4375     define variable v-cntxt-is-admin      as logical   no-undo .
     4376   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4377   define new global shared variable g#attr-lib  as handle no-undo .
