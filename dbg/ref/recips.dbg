     8019       run get-report-num in p-mainmenu-handle (
     8020           output g#report-num
     8021       ).
     8022       run get-quest-print in p-mainmenu-handle (
     8023           output g#quest-print
     8024       ).
     8025       find first buf_init_goods no-lock
     8026            where recid( buf_init_goods ) = p-goods-recid
     8027       no-error.
     8028       if error-status :error
     8029       then do:
     8030           message
     8031                    vss-workfile vss-revision vss-description
     8032               skip "Неверно выбран товар."
     8033               skip return-value
     8034               skip trim(error-status :get-message(1))
     8035                    trim(error-status :get-message(2))
     8036                    trim(error-status :get-message(3))
     8037           view-as alert-box error.
     8038           undo, return error .
     8039       end.
