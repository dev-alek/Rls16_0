     1391   define variable v-fbrlib-recipe-order               as integer  no-undo.
     1392   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1393   procedure fbrlib_create-fbr-doc :
     1394   define input parameter p-obj-type as character no-undo .
     1395   define input parameter p-obj-code as integer no-undo .
     1396   define input parameter p-userid as character no-undo .
     1397   define output parameter p-fbr-doc-code as character no-undo .
     1398   define output parameter p-recid as recid no-undo .
     1399   define variable v-host-code as integer no-undo .
     1400   define variable v-base-code as integer no-undo .
     1401   define variable v-obj-db-num as integer no-undo .
     1402   define variable v-db-num as integer no-undo .
     1403   DEFINE VARIABLE v-today as date no-undo .
     1404   DEFINE VARIABLE v-time as integer no-undo .
     1405   define variable v-doc-code as character no-undo .
     1406   define variable fi-pay-code as integer no-undo .
     1407   define buffer buf_fbr-doc for ub.fbr-doc.
     1408   define buffer buf_curr-accnt for ub.curr-accnt.
     1409   do
     1410   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
