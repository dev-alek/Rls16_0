     6235   end.
     6236   define variable scr-qnty    like fbr-recipe.qnty no-undo.
     6237   define variable scr-name    like fbr-recipe.recipe-name no-undo.
     6238   define variable line-order  as integer no-undo.
     6239   define buffer buf_fbr-doc for ub.fbr-doc.
     6240       assign
     6241           scr-qnty = input frame Dialog-Frame fi-recipe-qnty
     6242           scr-name = input frame Dialog-Frame fi-recipe-name
     6243       .
     6244   if session :set-wait-state( "compiler" ) then.
     6245       assign
     6246           line-order = 0
     6247       .
     6248       for each fbr-recipe-gds
     6249          where fbr-recipe-gds.doc-code    = p-doc-code
     6250            and fbr-recipe-gds.recipe-code = buf_init_recipe.recipe-code
     6251         , each goods no-lock
     6252          where goods.artic     = fbr-recipe-gds.artic
     6253            and goods.prod-type = fbr-recipe-gds.prod-type
     6254            and goods.prod-code = fbr-recipe-gds.prod-code
     6255       :
     6256   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6257   find scn-list
     6258     where scn-list.prod-type = goods.prod-type
     6259       and scn-list.prod-code = goods.prod-code
     6260       and scn-list.artic     = goods.artic
     6261     no-error .
     6262   if available scn-list then do:
     6263     assign
     6264       scn-list.to-del = no
     6265     .
     6266   end.
     6267   else do:
     6268     define variable v-last48 as integer no-undo .
     6269     find last scn-list use-index oi no-error.
     6270     if available scn-list then do:
     6271       v-last48 = scn-list.order-num .
     6272     end.
     6273     else do:
     6274       v-last48 = 0 .
     6275     end.
     6276     create scn-list .
     6277     buffer-copy goods to scn-list
     6278     assign
     6279       scn-list.to-del = no
     6280       scn-list.order-num = v-last48 + 1
     6281     .
     6282     assign
     6283       lns-cnt = lns-cnt + 1
     6284       line-rec = recid (scn-list)
     6285     .
     6286   end.
     6287           assign
     6288               scn-list.qnty = fbr-recipe-gds.qnty
     6289           .
     6290           if fbr-recipe-gds.proc-number > line-order
     6291           then do:
     6292               assign
     6293                   line-order = fbr-recipe-gds.proc-number
     6294               .
     6295           end.
     6296       end.
     6297       for each scn-list
     6298          where scn-list.to-del = yes
     6299       :
     6300           delete scn-list.
     6301       end.
     6302   if session :set-wait-state( "" ) then.
     6303       run str/scn-list.w (
     6304             input p-mainmenu-handle
     6305           , input v-cntxt-host-code-obj
     6306           , input v-cntxt-obj-type
     6307           , input v-cntxt-obj-code
     6308       ).
     6309   if session :set-wait-state( "compiler" ) then.
     6310       if buf_init_recipe.recipe-type <> 'альтернатива':U
     6311       then do:
     6312           assign
     6313               line-order = 0
     6314           .
     6315       end.
     6316       for each scn-list
     6317         , each goods no-lock
     6318          where goods.prod-type = scn-list.prod-type
     6319            and goods.prod-code = scn-list.prod-code
     6320            and goods.artic     = scn-list.artic
     6321       by scn-list.artic
     6322       :
     6323           assign
     6324               scn-list.to-del = yes
     6325           .
     6326           if goods.gds-type = 'у':U
     6327           and buf_init_recipe.recipe-type = 'альтернатива':U
     6328           then do:
     6329               next.
     6330           end.
     6331           find first fbr-recipe-gds
     6332                where fbr-recipe-gds.doc-code    = p-doc-code
     6333                  and fbr-recipe-gds.recipe-code = buf_init_recipe.recipe-code
     6334                  and fbr-recipe-gds.prod-type   = scn-list.prod-type
     6335                  and fbr-recipe-gds.prod-code   = scn-list.prod-code
     6336                  and fbr-recipe-gds.artic       = scn-list.artic
     6337           no-error.
     6338           if not available fbr-recipe-gds
     6339           then do:
     6340               find first buf_fbr-doc no-lock
     6341                    where buf_fbr-doc.doc-code = p-doc-code
     6342               no-error.
     6343               if error-status:error
     6344               then do:
     6345                   message substitute ("Не найден документ производства с номером &1", p-doc-code) view-as alert-box error.
     6346                   undo, return no-apply.
     6347               end.
     6348               run fbrlib_create-fbr-recipe-gds in this-procedure (
     6349                     input p-doc-code
     6350                   , input buf_init_recipe.recipe-code
     6351                   , input scn-list.prod-type
     6352                   , input scn-list.prod-code
     6353                   , input scn-list.artic
     6354                   , input scn-list.gds-code
     6355                   , input no
     6356                   , input 0
     6357                   , input buf_fbr-doc.doc-date
     6358                   , input buf_fbr-doc.obj-type
     6359                   , input buf_fbr-doc.obj-code
     6360                   , input 1
     6361                   , input 0
     6362                   , input 0
     6363                   , input 0
     6364               ) no-error.
     6365               if error-status:error
     6366               then do:
     6367                   message substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)) view-as alert-box error.
     6368                   undo, return no-apply.
     6369               end.
     6370               find first fbr-recipe-gds exclusive-lock
     6371                    where fbr-recipe-gds.doc-code    = p-doc-code
     6372                      and fbr-recipe-gds.recipe-code = buf_init_recipe.recipe-code
     6373                      and fbr-recipe-gds.prod-type   = scn-list.prod-type
     6374                      and fbr-recipe-gds.prod-code   = scn-list.prod-code
     6375                      and fbr-recipe-gds.artic       = scn-list.artic
     6376               .
     6377           end.
     6378           assign
     6379               fbr-recipe-gds.qnty         = scn-list.qnty
     6380               fbr-recipe-gds.brutto-qnty  = fbr-recipe-gds.qnty
     6381           .
     6382           case buf_init_recipe.recipe-type
     6383           :
     6384               when 'разделка':U
     6385               then do:
     6386                   assign
     6387                       line-order                  = line-order + 1
     6388                       fbr-recipe-gds.proc-number  = line-order
     6389                   .
     6390               end.
     6391               when 'комплектация':U
     6392               then do:
     6393                   if fbr-recipe-gds.qnty = ?
     6394                   then do:
     6395                       assign
     6396                           fbr-recipe-gds.qnty         = 1
     6397                           fbr-recipe-gds.brutto-qnty  = fbr-recipe-gds.qnty
     6398                       .
     6399                   end.
     6400                   assign
     6401                       line-order              = line-order + 1
     6402                       fbr-recipe-gds.proc-number  = line-order
     6403                   .
     6404               end.
     6405               when 'производство':U
     6406               then do:
     6407                   if fbr-recipe-gds.qnty = ?
     6408                   then do:
     6409                       assign
     6410                           fbr-recipe-gds.qnty         = 0
     6411                           fbr-recipe-gds.brutto-qnty  = fbr-recipe-gds.qnty
     6412                       .
     6413                   end.
     6414                   assign
     6415                       line-order              = line-order + 1
     6416                       fbr-recipe-gds.proc-number  = line-order
     6417                   .
     6418               end.
     6419               when 'альтернатива':U
     6420               then do:
     6421                   if fbr-recipe-gds.qnty = ?
     6422                   then do:
     6423                       assign
     6424                           fbr-recipe-gds.qnty         = 0
     6425                           fbr-recipe-gds.brutto-qnty  = fbr-recipe-gds.qnty
     6426                       .
     6427                   end.
     6428                   if fbr-recipe-gds.proc-number = 0
     6429                   then do:
     6430                       assign
     6431                           line-order              = line-order + 1
     6432                           fbr-recipe-gds.proc-number  = line-order
     6433                       .
     6434                   end.
     6435               end.
     6436           end case.
     6437       end.
     6438       for each fbr-recipe-gds
     6439          where fbr-recipe-gds.doc-code    = p-doc-code
     6440            and fbr-recipe-gds.recipe-code = buf_init_recipe.recipe-code
     6441       :
     6442           if not can-find( scn-list where scn-list.artic = fbr-recipe-gds.artic
     6443                                       and scn-list.prod-type = fbr-recipe-gds.prod-type
     6444                                       and scn-list.prod-code = fbr-recipe-gds.prod-code )
     6445           then do:
     6446               delete fbr-recipe-gds.
     6447           end.
     6448       end.
     6449   if session :set-wait-state( "" ) then.
     6450       run enable_UI.
     6451       assign
     6452           fi-recipe-name = scr-name
     6453           fi-recipe-qnty = scr-qnty
     6454       .
     6455       display
     6456           fi-recipe-name
     6457           fi-recipe-qnty
     6458       with frame Dialog-Frame .
     6459   END.
     6460   ON CHOOSE OF b-hst IN FRAME Dialog-Frame
     6461   DO:
     6462   define variable vss-include-info49 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6463   if lookup(self :type
     6464            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
