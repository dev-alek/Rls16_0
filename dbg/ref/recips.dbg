     4547   procedure gds-attr_check-ptrl-divis :
     4548     define input  parameter p-gds-code    like ub.goods-attr.gds-code     no-undo .
     4549     define input  parameter p-code        like ub.goods-attr.attr-code  no-undo .
     4550     define input  parameter p-value       as character no-undo .
     4551     define input  parameter p-mode        as character no-undo .
     4552     define output parameter p-correct     as logical no-undo .
     4553     define output parameter p-error-code  as character no-undo .
     4554     do
