     6483   ON CHOOSE OF b-print IN FRAME Dialog-Frame
     6484   DO:
     6485   define variable vss-include-info50 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6486   if lookup(self :type
     6487            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     6488            ) = 0
     6489   then do:
     6490     message
     6491       "$Workfile$"
     6492       "Указанному интерфейсному элементу фокус не может быть передан" skip
     6493       "Интерфейсный элемент" self :name  skip
     6494       "Тип" self :type  skip
     6495       "Процедура" this-procedure :file-name skip
     6496       view-as alert-box .
     6497   end.
     6498   else do:
     6499     apply "entry":u to self  .
     6500     if focus :handle <> self :handle  then do:
     6501       return no-apply .
     6502     end.
     6503   end.
     6504       define variable sym1          as character init ":"   no-undo.
     6505       define variable sym2          as character init ":"   no-undo.
     6506       define variable sym3          as character init ":"   no-undo.
     6507       define variable sym4          as character init ":"   no-undo.
     6508       define variable sym5          as character init ":"   no-undo.
     6509       define variable sym6          as character init ":"   no-undo.
     6510       define variable sym7          as character init ":"   no-undo.
     6511       define variable sym8          as character init ":"   no-undo.
     6512       define variable Line          as character            no-undo.
     6513       define variable prod-attr     as character            no-undo.
     6514       define variable ii            as integer              no-undo.
     6515       define variable StartRecid    as recid                no-undo.
     6516       DEFINE FRAME List
     6517           sym1 column-label ":" format "x(1)" space(0)
     6518           fbr-recipe-gds.artic column-label "Артикул" format "X(16)" space(0)
     6519           sym2 column-label ":" format "x(1)" space(0)
     6520           goods.gds-name COLUMN-LABEL "Название товара" FORMAT "X(40)" space(0)
     6521           sym3 column-label ":" format "x(1)" space(0)
     6522           fbr-recipe-gds.qnty column-label "Количество     " format "->>,>>>,>>9.<<<" space(0)
     6523           sym4 column-label ":" format "x(1)" space(0)
     6524           goods.unit-base column-label "Ед.Изм." format "X(7)" space(0)
     6525           sym5 column-label ":" format "x(1)" space(0)
     6526           fbr-recipe-gds.is-waste COLUMN-LABEL "Отходы" FORMAT "+/" space(0)
     6527           sym6 column-label ":" format "x(1)" space(0)
     6528           prod-attr COLUMN-LABEL "Производитель" format "x(13)" space(0)
     6529           sym7 column-label ":" format "x(1)" space(0)
     6530           clients.obj-name COLUMN-LABEL "Наименование производителя" FORMAT "X(30)" space(0)
     6531           sym8 column-label ":" format "x(1)" space(0)
     6532           HEADER
     6533               cur-time-print() AT 5 format "X(35)"
     6534                   string( "Страница " + string( PAGE-NUMBER( ListStream ) , ">>9") )
     6535                       AT 116 format "X(15)" SKIP
     6536               Line format "x(135)" AT 1
     6537           with width 160 down use-text stream-io no-box .
     6538       if num-results( "br-table" ) = 0 then
     6539           do:
     6540               message "Список  П У С Т !" skip view-as alert-box information .
     6541               return no-apply .
     6542           end.
     6543   if session :set-wait-state( "compiler" ) then.
     6544       Line = fill( "-" , 150 ) .
     6545       StartRecid = recid( fbr-recipe-gds ) .
     6546       DO WHILE available fbr-recipe-gds :
     6547           GET prev br-table NO-LOCK .
     6548       END.
     6549       GET next br-table NO-LOCK .
     6550       ii = 1 .
     6551   output stream ListStream to value( string( session:temp-directory +
     6552                                        "rpt" + string( g#report-num ) ) )
     6553                                        page-size 62 .
     6554       FORM HEADER
     6555                   Line format "X(135)" SKIP
     6556                   "Продолжение - на следующей странице" AT 30 SKIP
     6557                   with FRAME CliBottomFrame width 160 PAGE-BOTTOM NO-LABELS no-box.
     6558       VIEW stream ListStream FRAME CliBottomFrame .
     6559       FIND first goods NO-LOCK
     6560            WHERE goods.prod-type = buf_init_recipe.prod-type
     6561              AND goods.prod-code = buf_init_recipe.prod-code
     6562              AND goods.artic     = buf_init_recipe.artic
     6563       .
     6564       PUT stream ListStream
     6565           space(10) string( "Р Е Ц Е П Т: "  + trim( buf_init_recipe.recipe-name) + " (артикул: " + trim(buf_init_recipe.artic) + ")" ) format "X(100)" skip
     6566           space(10) string( "Д Л Я   Т О В А Р А: " + trim(goods.gds-name) ) format "X(100)" skip(1)
     6567           space(30) string( "Количество : " + string( buf_init_recipe.qnty ) ) format "X(80)" SKIP(1) .
     6568       FORM with frame List .
     6569       DO WHILE available fbr-recipe-gds :
     6570           FIND goods WHERE goods.prod-type = fbr-recipe-gds.prod-type AND
     6571                            goods.prod-code = fbr-recipe-gds.prod-code AND
     6572                            goods.artic = fbr-recipe-gds.artic NO-LOCK .
     6573           FIND clients WHERE clients.obj-type = fbr-recipe-gds.prod-type AND
     6574                              clients.obj-code = fbr-recipe-gds.prod-code NO-LOCK .
     6575           DISPLAY stream ListStream
     6576                           sym1 fbr-recipe-gds.artic
     6577                           sym2 goods.gds-name
     6578                           sym3 fbr-recipe-gds.qnty
     6579                           sym4 goods.unit-base
     6580                           sym5 fbr-recipe-gds.is-waste
     6581                           sym6 fbr-recipe-gds.prod-type + " " + STRING (fbr-recipe-gds.prod-code) @ prod-attr
     6582                           sym7 clients.obj-name
     6583                           sym8    with frame List .
     6584           DOWN stream ListStream 1 with frame List .
     6585           ii =  ii + 1 .
     6586           GET next br-table .
     6587       END.
     6588       PUT stream ListStream Line format "X(135)" SKIP.
     6589       HIDE stream ListStream FRAME CliBottomFrame .
     6590       output stream ListStream close .
     6591   if session :set-wait-state( "" ) then.
     6592       define variable v-user-action           as character            no-undo.
     6593       define variable v-printed               as logical              no-undo.
     6594       run gbl/prnfilen.w (
     6595             input "":U
     6596           , input 0
     6597           , input string( session :temp-directory ) + "rpt" + string( g#report-num )
     6598           , input 7
     6599           , output v-user-action
     6600           , output v-printed
     6601       ) .
     6602       reposition br-table to recid StartRecid .
     6603   END.
     6604   ON CHOOSE OF b-rcp IN FRAME Dialog-Frame
     6605   DO:
     6606   define variable vss-include-info51 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6607   if lookup(self :type
     6608            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     6609            ) = 0
     6610   then do:
     6611     message
     6612       "$Workfile$"
     6613       "Указанному интерфейсному элементу фокус не может быть передан" skip
     6614       "Интерфейсный элемент" self :name  skip
     6615       "Тип" self :type  skip
     6616       "Процедура" this-procedure :file-name skip
     6617       view-as alert-box .
     6618   end.
     6619   else do:
     6620     apply "entry":u to self  .
     6621     if focus :handle <> self :handle  then do:
     6622       return no-apply .
     6623     end.
     6624   end.
     6625       if not available fbr-recipe-gds
     6626       then do:
     6627           message "Неправильно выбрана строка рецепта.".
     6628           return no-apply.
     6629       end.
     6630       else do:
     6631           run add-recipe in this-procedure (
     6632                 input fbr-recipe-gds.artic
     6633               , input fbr-recipe-gds.prod-type
     6634               , input fbr-recipe-gds.prod-code
     6635           ).
     6636       end.
     6637       run enable_UI.
     6638   END.
     6639   ON CHOOSE OF b-up IN FRAME Dialog-Frame
     6640   DO:
     6641   define variable vss-include-info52 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6642   if lookup(self :type
     6643            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     6644            ) = 0
     6645   then do:
     6646     message
     6647       "$Workfile$"
     6648       "Указанному интерфейсному элементу фокус не может быть передан" skip
     6649       "Интерфейсный элемент" self :name  skip
     6650       "Тип" self :type  skip
     6651       "Процедура" this-procedure :file-name skip
     6652       view-as alert-box .
     6653   end.
     6654   else do:
     6655     apply "entry":u to self  .
     6656     if focus :handle <> self :handle  then do:
     6657       return no-apply .
     6658     end.
     6659   end.
     6660       define variable v-cur-line          as recid                    no-undo.
     6661       define variable v-proc-number       as integer                  no-undo.
     6662       define variable v-old-proc-number   as integer        no-undo.
     6663       define variable v-focused-row       as integer        no-undo.
     6664       if not available fbr-recipe-gds
     6665       then do:
     6666           return no-apply.
     6667       end.
     6668       apply "entry" to br-table .
     6669       assign
     6670           v-focused-row   = br-table :focused-row in frame Dialog-Frame
     6671           v-cur-line      = recid( fbr-recipe-gds )
     6672           v-proc-number   = fbr-recipe-gds.proc-number
     6673       .
     6674       get prev br-table.
     6675       if not available fbr-recipe-gds
     6676       then do:
     6677           apply "entry" to br-table.
     6678           return no-apply.
     6679       end.
     6680   if session :set-wait-state( "compiler" ) then.
     6681       swap-up:
     6682       do
     6683       on error undo swap-up, return no-apply
     6684       :
     6685           find current fbr-recipe-gds exclusive-lock .
     6686           assign
     6687               v-old-proc-number       = fbr-recipe-gds.proc-number
     6688               fbr-recipe-gds.proc-number  = v-proc-number
     6689           .
     6690           find first fbr-recipe-gds exclusive-lock
     6691                where recid( fbr-recipe-gds ) = v-cur-line
     6692           .
     6693           assign
     6694               fbr-recipe-gds.proc-number = v-old-proc-number
     6695               v-focused-row          = v-focused-row - 1
     6696           .
     6697       end.
     6698       OPEN QUERY br-table FOR EACH ub.fbr-recipe-gds       WHERE fbr-recipe-gds.recipe-code = buf_init_recipe.recipe-code  AND fbr-recipe-gds.doc-code = p-doc-code NO-LOCK     BY ub.fbr-recipe-gds.proc-number.
     6699       br-table :set-repositioned-row( v-focused-row, "ALWAYS") in frame Dialog-Frame.
     6700       reposition br-table to recid v-cur-line .
     6701       apply "entry" to browse br-table.
     6702   if session :set-wait-state( "" ) then.
     6703   END.
     6704   ON LEAVE OF fi-brutto-qnty IN FRAME Dialog-Frame
     6705   DO:
     6706   END.
     6707   ON LEAVE OF fi-recipe-qnty IN FRAME Dialog-Frame
     6708   DO:
     6709       define variable v-yesno    as logical        no-undo.
     6710       assign
     6711           fi-recipe-qnty
     6712       .
     6713       run calc-and-display-nutrition-info in this-procedure .
     6714   END.
     6715   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6716   on help of frame Dialog-Frame
     6717   do:
     6718     run gbl/app_help.p
     6719       (input this-procedure :file-name
     6720       ,input ''
     6721       ,input ?
     6722       ) no-error.
     6723     if error-status :error then do:
     6724       message
     6725         "Ошибка при вызове помощи"
     6726         error-status :get-message(1)
     6727         view-as alert-box .
     6728     end.
     6729   end.
     6730   run minbtn-set in this-procedure .
     6731   on choose of b-help in frame Dialog-Frame
     6732   do:
     6733     apply "help":u to frame Dialog-Frame .
     6734   end.
     6735   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6736   procedure minbtn-set :
     6737       do
     6738           on error undo, return error return-value
     6739           :
     6740           define variable ii              as integer       no-undo .
     6741           define variable fh              as widget-handle no-undo .
     6742           define variable hh              as widget-handle no-undo .
     6743           define variable v-h             as handle        extent 4 no-undo .
     6744           define variable v-name-button   as character     no-undo .
     6745           define variable v-help-old-x    as decimal       no-undo .
     6746           define variable v-help-old-y    as decimal       no-undo .
     6747           define variable v-help-old-size as decimal       no-undo .
     6748           define variable v-frame-width   as decimal       no-undo .
     6749           define variable jj              as integer       no-undo .
     6750           do
     6751               on error undo, return error
     6752               :
     6753               assign
     6754                   v-frame-width = frame Dialog-Frame:width - 0.3
     6755                   fh            = frame Dialog-Frame:first-child
     6756                   hh            = fh:first-child
     6757                   ii            = 1
     6758                   .
     6759               do while valid-handle(hh):
     6760                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     6761                   do:
     6762                       case lc(hh:name) :
     6763                           when "b-help" then
     6764                               do:
     6765                                   hh:load-image-up("cmp/b-help.bmp":u) .
     6766                                   hh:load-image-down("cmp/b-help.bmp":u) .
     6767                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     6768                                   hh:TOOLTIP = "Помощь" .
     6769                                   v-help-old-x = hh:column .
     6770                                   v-help-old-y = hh:row    .
     6771                                   v-help-old-size = hh:width .
     6772                                   hh:width-chars = 2.5 .
     6773                               end.
     6774                           when "b-print" then
     6775                               do:
     6776                                   hh:load-image("cmp/b-print.bmp":u) .
     6777                                   hh:TOOLTIP = "Печать" .
     6778                                   v-h[ii] = hh:handle .
     6779                                   ii = ii + 1 .
     6780                                   hh:width-chars = 3 .
     6781                               end.
     6782                           when "b-history" or
     6783                           when "b-hist" then
     6784                               do:
     6785                                   hh:load-image("cmp/b-hist.bmp":u) .
     6786                                   hh:TOOLTIP = "История" .
     6787                                   v-h[ii] = hh:handle .
     6788                                   ii = ii + 1 .
     6789                                   hh:width-chars = 3 .
     6790                               end.
     6791                           when "b-sch" then
     6792                               do:
     6793                                   hh:load-image("cmp/b-sch.bmp":u) .
     6794                                   hh:TOOLTIP = "Установка Фильтра" .
     6795                                   v-h[ii] = hh:handle .
     6796                                   ii = ii + 1 .
     6797                                   hh:width-chars = 3 .
     6798                               end.
     6799                           when "b-hist-user" then
     6800                               do:
     6801                                   hh:load-image("cmp/b-hist.bmp":u) .
     6802                                   hh:TOOLTIP = "История пользователя" .
     6803                                   ii = ii + 1 .
     6804                               end.
     6805                       end case.
     6806                   end.
     6807                   hh = hh:next-sibling.
     6808               end.
     6809               b-help:column = v-frame-width - b-help:width-chars.
     6810               jj = 0.
     6811               repeat ii = 4 to 1 by -1 :
     6812                   if valid-handle (v-h[ii] ) then
     6813                   do:
     6814                       jj  = jj + 1 .
     6815                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     6816                       v-h[ii]:row    = v-help-old-y .
     6817                   end.
     6818               end.
     6819           end.
     6820       end.
     6821   end procedure.
     6822   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     6823   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     6824   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     6825   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     6826   define variable v-diasize-current-frame-width  as decimal   no-undo .
     6827   define variable v-diasize-current-frame-height as decimal   no-undo .
     6828   define variable v-diasize-change-size          as logical   no-undo .
     6829   define variable v-diasize-resize-button        as handle    no-undo .
     6830   define variable v-diasize-wndmax               as logical   no-undo .
     6831   define variable v-diasize-wndstore             as logical   no-undo .
     6832   define variable v-diasize-proc-name            as character no-undo .
     6833   define variable v-diasize-browse-handle        as handle    no-undo .
     6834   define variable v-diasize-browse-number        as integer   no-undo .
     6835   define variable v-diasize-need-full-display    as logical   no-undo init false .
     6836   define temp-table temp-diasize-handle no-undo
     6837     field handle-value  as handle
     6838     field save-position as decimal
     6839     index xpk is primary unique handle-value
     6840     .
     6841   define temp-table temp-browse-handle no-undo
     6842     field browse-type   as character
     6843     field browse-number as integer
     6844     field browse-handle as handle
     6845     field original-size as decimal
     6846     index xpk is primary unique browse-type browse-number
     6847     index xie browse-type browse-handle
     6848   .
     6849   procedure diasize_change-height :
     6850     define input  parameter p-change-value  as decimal   no-undo .
     6851     define input  parameter p-move-resize   as logical   no-undo .
     6852     define variable v-field-group-handle    as handle    no-undo .
     6853     define variable v-object-handle         as handle    no-undo .
     6854     define variable v-frame-height          as decimal   no-undo .
     6855     define variable v-frame-virtual-height  as decimal   no-undo .
     6856     define variable v-browse-height         as decimal   no-undo .
     6857     define variable v-window-height         as decimal   no-undo .
     6858     define variable v-window-virtual-height as decimal   no-undo .
     6859     define variable v-change-sign           as integer   no-undo .
     6860     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     6861     define buffer buf_temp-browse-handle  for temp-browse-handle .
     6862     if p-change-value > 0
     6863     then do:
     6864       if frame Dialog-Frame :height + p-change-value
     6865           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     6866       then do:
     6867         assign
     6868           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     6869                           - (frame Dialog-Frame :height-chars)
     6870         .
     6871         if p-change-value <= 0
     6872         then do:
     6873           run diasize_position-resize-button in this-procedure .
     6874           return .
     6875         end.
     6876       end.
     6877     end.
     6878     if p-change-value < 0
     6879     then do:
     6880       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     6881       then do:
     6882         assign
     6883           p-change-value = v-diasize-orig-frame-height
     6884                          - (frame Dialog-Frame :height-chars)
     6885         .
     6886         if p-change-value >= 0
     6887         then do:
     6888           run diasize_position-resize-button in this-procedure .
     6889           return .
     6890         end.
     6891       end.
     6892     end.
     6893     if p-change-value >= 0
     6894     then do:
     6895       assign
     6896         v-change-sign = 1
     6897       .
     6898     end.
     6899     else do:
     6900       assign
     6901         v-change-sign = -1
     6902       .
     6903     end.
     6904     assign
     6905       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     6906     .
     6907     if p-change-value = 0
     6908     then do:
     6909       run diasize_position-resize-button in this-procedure .
     6910       return .
     6911     end.
     6912     move_block:
     6913     do
     6914     on error undo move_block, retry move_block
     6915     :
     6916       if retry
     6917       then do:
     6918         do
     6919         on error undo move_block, leave move_block
     6920         :
     6921           if p-change-value > 0
     6922           then do:
     6923             for each buf_temp-diasize-handle
     6924             on error undo, next
     6925             :
     6926               assign
     6927                 v-object-handle = buf_temp-diasize-handle.handle-value
     6928               .
     6929               if v-object-handle <> v-diasize-resize-button
     6930               then do:
     6931                 assign
     6932                   v-object-handle :row = buf_temp-diasize-handle.save-position
     6933                 .
     6934               end.
     6935             end.
     6936             assign
     6937               v-diasize-browse-handle :height = v-browse-height
     6938             .
     6939             for each buf_temp-browse-handle
     6940               where buf_temp-browse-handle.browse-type = 'height':u
     6941             on error undo, next
     6942             :
     6943               assign
     6944                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     6945               .
     6946             end.
     6947             assign
     6948               frame Dialog-Frame :height = v-frame-height
     6949             .
     6950             if frame Dialog-Frame :scrollable = true
     6951             then do:
     6952               assign
     6953                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     6954               .
     6955             end.
     6956             run diasize_position-resize-button in this-procedure .
     6957           end.
     6958           else do:
     6959             if frame Dialog-Frame :scrollable = true
     6960             then do:
     6961               assign
     6962                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     6963               .
     6964             end.
     6965             assign
     6966               frame Dialog-Frame :height = v-frame-height
     6967             .
     6968             assign
     6969               v-diasize-browse-handle :height = v-browse-height
     6970             .
     6971             for each buf_temp-browse-handle
     6972               where buf_temp-browse-handle.browse-type = 'height':u
     6973             on error undo, next
     6974             :
     6975               assign
     6976                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     6977               .
     6978             end.
     6979             for each buf_temp-diasize-handle
     6980             on error undo, next
     6981             :
     6982               assign
     6983                 v-object-handle = buf_temp-diasize-handle.handle-value
     6984               .
     6985               if v-object-handle <> v-diasize-resize-button
     6986               then do:
     6987                 assign
     6988                   v-object-handle :row = buf_temp-diasize-handle.save-position
     6989                 .
     6990               end.
     6991             end.
     6992             run diasize_position-resize-button in this-procedure .
     6993           end.
     6994           assign
     6995             v-diasize-change-size = false
     6996           .
     6997           leave move_block .
     6998         end.
     6999       end.
     7000       assign
     7001         v-diasize-need-full-display = true
     7002       .
     7003       if v-diasize-change-size = false
     7004       then do:
     7005         assign
     7006           v-diasize-change-size = true
     7007         .
     7008       end.
     7009       else do:
     7010         return .
     7011       end.
     7012       assign
     7013         v-frame-height = frame Dialog-Frame :height
     7014         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     7015         v-browse-height = v-diasize-browse-handle :height
     7016       .
     7017       for each buf_temp-browse-handle
     7018         where buf_temp-browse-handle.browse-type = 'height':u
     7019       :
     7020         assign
     7021           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     7022         .
     7023       end.
     7024       for each buf_temp-diasize-handle
     7025       :
     7026         delete buf_temp-diasize-handle .
     7027       end.
     7028       assign
     7029         v-field-group-handle = frame Dialog-Frame :first-child
     7030       .
     7031       do while valid-handle(v-field-group-handle)
     7032       :
     7033         assign
     7034           v-object-handle = v-field-group-handle :first-child
     7035         .
     7036         do while valid-handle(v-object-handle)
     7037         :
     7038           if  v-object-handle <> v-diasize-browse-handle :handle
     7039           and can-query(v-object-handle, "row")
     7040           and can-query(v-object-handle, "height")
     7041           and ( v-object-handle :row > v-diasize-browse-handle :row )
     7042           then do:
     7043             find first buf_temp-browse-handle
     7044               where buf_temp-browse-handle.browse-type   = 'height':u
     7045                 and buf_temp-browse-handle.browse-handle = v-object-handle
     7046               no-error .
     7047             if available buf_temp-browse-handle
     7048             then do:
     7049             end.
     7050             else do:
     7051               create buf_temp-diasize-handle .
     7052               assign
     7053                 buf_temp-diasize-handle.handle-value  = v-object-handle
     7054                 buf_temp-diasize-handle.save-position = v-object-handle :row
     7055               .
     7056             end.
     7057           end.
     7058           assign
     7059             v-object-handle = v-object-handle :next-sibling
     7060           .
     7061         end.
     7062         assign
     7063           v-field-group-handle = v-field-group-handle :next-sibling
     7064         .
     7065       end.
     7066       do with frame Dialog-Frame
     7067       :
     7068         hide v-diasize-resize-button .
     7069         assign
     7070           v-diasize-resize-button :row    = 1
     7071           v-diasize-resize-button :column = 1
     7072         .
     7073       end.
     7074       if p-change-value > 0
     7075       then do:
     7076         if frame Dialog-Frame :scrollable = true
     7077         then do:
     7078           assign
     7079             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     7080             no-error .
     7081           if error-status :error
     7082           or error-status :get-message(1) <> ""
     7083           then do:
     7084             undo move_block, retry move_block .
     7085           end.
     7086         end.
     7087         assign
     7088           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     7089           no-error .
     7090         if error-status :error
     7091         or error-status :get-message(1) <> ""
     7092         then do:
     7093           undo move_block, retry move_block .
     7094         end.
     7095         assign
     7096           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     7097           no-error .
     7098         if error-status :error
     7099         or error-status :get-message(1) <> ""
     7100         then do:
     7101           undo move_block, retry move_block .
     7102         end.
     7103         for each buf_temp-browse-handle
     7104           where buf_temp-browse-handle.browse-type = 'height':u
     7105         on error undo move_block, retry move_block
     7106         :
     7107           assign
     7108             buf_temp-browse-handle.browse-handle :height
     7109               = buf_temp-browse-handle.browse-handle :height + p-change-value
     7110             no-error .
     7111           if error-status :error
     7112           or error-status :get-message(1) <> ""
     7113           then do:
     7114             undo move_block, retry move_block .
     7115           end.
     7116         end.
     7117         for each buf_temp-diasize-handle
     7118         on error undo move_block, retry move_block
     7119         :
     7120           assign
     7121             v-object-handle = buf_temp-diasize-handle.handle-value
     7122           .
     7123           if v-object-handle <> v-diasize-resize-button
     7124           then do:
     7125             assign
     7126               v-object-handle :row = v-object-handle :row + p-change-value
     7127               no-error .
     7128             if error-status :error
     7129             or error-status :get-message(1) <> ""
     7130             then do:
     7131               undo move_block, retry move_block .
     7132             end.
     7133           end.
     7134         end.
     7135       end.
     7136       else do:
     7137         for each buf_temp-diasize-handle
     7138         on error undo move_block, retry move_block
     7139         :
     7140           assign
     7141             v-object-handle = buf_temp-diasize-handle.handle-value
     7142           .
     7143           if v-object-handle <> v-diasize-resize-button
     7144           then do:
     7145             assign
     7146               v-object-handle :row = v-object-handle :row + p-change-value
     7147               no-error .
     7148             if error-status :error
     7149             or error-status :get-message(1) <> ""
     7150             then do:
     7151               undo move_block, retry move_block .
     7152             end.
     7153           end.
     7154         end.
     7155         assign
     7156           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     7157           no-error .
     7158         if error-status :error
     7159         or error-status :get-message(1) <> ""
     7160         then do:
     7161           undo move_block, retry move_block .
     7162         end.
     7163         for each buf_temp-browse-handle
     7164           where buf_temp-browse-handle.browse-type = 'height':u
     7165         on error undo move_block, retry move_block
     7166         :
     7167           assign
     7168             buf_temp-browse-handle.browse-handle :height
     7169               = buf_temp-browse-handle.browse-handle :height + p-change-value
     7170             no-error .
     7171           if error-status :error
     7172           or error-status :get-message(1) <> ""
     7173           then do:
     7174             undo move_block, retry move_block .
     7175           end.
     7176         end.
     7177         assign
     7178           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     7179           no-error .
     7180         if error-status :error
     7181         or error-status :get-message(1) <> ""
     7182         then do:
     7183           undo move_block, retry move_block .
     7184         end.
     7185         if frame Dialog-Frame :scrollable = true
     7186         then do:
     7187           assign
     7188             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     7189             no-error .
     7190           if error-status :error
     7191           or error-status :get-message(1) <> ""
     7192           then do:
     7193             undo move_block, retry move_block .
     7194           end.
     7195         end.
     7196       end.
     7197       if p-move-resize = true
     7198       then do:
     7199         run diasize_position-resize-button in this-procedure .
     7200       end.
     7201       if v-diasize-wndstore = true
     7202       then do:
     7203         if connected("ub") = true
     7204         then do:
     7205           define variable v-cntxt-db-num        as integer   no-undo .
     7206           define variable v-cntxt-userid        as character no-undo .
     7207           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     7208                                             , OUTPUT v-cntxt-userid
     7209                                             ) .
     7210           run gbl/wndsizew.p
     7211             (input  v-cntxt-db-num
     7212             ,input  v-cntxt-userid
     7213             ,input  v-diasize-proc-name
     7214             ,input  'height':u
     7215             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     7216             ) .
     7217         end.
     7218       end.
     7219     end.
     7220     assign
     7221       v-diasize-change-size = false
     7222     .
     7223   end procedure.
     7224   procedure diasize_set-height :
     7225     define input  parameter p-new-height  as decimal   no-undo .
     7226     define input  parameter p-move-resize as logical   no-undo .
     7227     do
     7228     on error undo, return error return-value
     7229     :
     7230       run diasize_change-height in this-procedure
     7231         (input  (p-new-height - frame Dialog-Frame :height)
     7232         ,input  p-move-resize
     7233         ) .
     7234     end.
     7235   end procedure.
     7236   procedure diasize_change-width :
     7237     define input  parameter p-change-value as decimal   no-undo .
     7238     define input  parameter p-move-resize  as logical   no-undo .
     7239     define variable v-field-group-handle   as handle    no-undo .
     7240     define variable v-object-handle        as handle    no-undo .
     7241     define variable v-frame-width          as decimal   no-undo .
     7242     define variable v-frame-virtual-width  as decimal   no-undo .
     7243     define variable v-browse-width         as decimal   no-undo .
     7244     define variable v-window-width         as decimal   no-undo .
     7245     define variable v-window-virtual-width as decimal   no-undo .
     7246     define variable v-change-sign          as integer   no-undo .
     7247     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     7248     define buffer buf_temp-browse-handle  for temp-browse-handle .
     7249     if p-change-value > 0
     7250     then do:
     7251       if frame Dialog-Frame :width + p-change-value >
     7252           session :width-chars
     7253       then do:
     7254         assign
     7255           p-change-value = session :width-chars - frame Dialog-Frame :width
     7256         .
     7257         if p-change-value <= 0
     7258         then do:
     7259           run diasize_position-resize-button in this-procedure .
     7260           return .
     7261         end.
     7262       end.
     7263     end.
     7264     if p-change-value < 0
     7265     then do:
     7266       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     7267       then do:
     7268         assign
     7269           p-change-value = v-diasize-orig-frame-width
     7270                          - frame Dialog-Frame :width
     7271         .
     7272         if p-change-value >= 0
     7273         then do:
     7274           run diasize_position-resize-button in this-procedure .
     7275           return .
     7276         end.
     7277       end.
     7278     end.
     7279     if p-change-value >= 0
     7280     then do:
     7281       assign
     7282         v-change-sign = 1
     7283       .
     7284     end.
     7285     else do:
     7286       assign
     7287         v-change-sign = -1
     7288       .
     7289     end.
     7290     assign
     7291       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     7292     .
     7293     if p-change-value = 0
     7294     then do:
     7295       run diasize_position-resize-button in this-procedure .
     7296       return .
     7297     end.
     7298     move_block:
     7299     do
     7300     on error undo move_block, leave move_block
     7301     :
     7302       if retry
     7303       then do:
     7304         do
     7305         on error undo move_block, leave move_block
     7306         :
     7307           if p-change-value > 0
     7308           then do:
     7309             for each buf_temp-diasize-handle
     7310             on error undo, next
     7311             :
     7312               assign
     7313                 v-object-handle = buf_temp-diasize-handle.handle-value
     7314               .
     7315               if v-object-handle <> v-diasize-resize-button
     7316               then do:
     7317                 assign
     7318                   v-object-handle :col = buf_temp-diasize-handle.save-position
     7319                 .
     7320               end.
     7321             end.
     7322             assign
     7323               v-diasize-browse-handle :width = v-browse-width
     7324             .
     7325             for each buf_temp-browse-handle
     7326               where buf_temp-browse-handle.browse-type = 'width':u
     7327             on error undo, next
     7328             :
     7329               assign
     7330                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     7331               .
     7332             end.
     7333             assign
     7334               frame Dialog-Frame :width = v-frame-width
     7335             .
     7336             if frame Dialog-Frame :scrollable = true
     7337             then do:
     7338               assign
     7339                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     7340               .
     7341             end.
     7342             run diasize_position-resize-button in this-procedure .
     7343           end.
     7344           else do:
     7345             if frame Dialog-Frame :scrollable = true
     7346             then do:
     7347               assign
     7348                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     7349               .
     7350             end.
     7351             assign
     7352               frame Dialog-Frame :width = v-frame-width
     7353             .
     7354             for each buf_temp-browse-handle
     7355               where buf_temp-browse-handle.browse-type = 'width':u
     7356             on error undo, next
     7357             :
     7358               assign
     7359                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     7360               .
     7361             end.
     7362             assign
     7363               v-diasize-browse-handle :width = v-browse-width
     7364             .
     7365             for each buf_temp-diasize-handle
     7366             on error undo, next
     7367             :
     7368               assign
     7369                 v-object-handle = buf_temp-diasize-handle.handle-value
     7370               .
     7371               if v-object-handle <> v-diasize-resize-button
     7372               then do:
     7373                 assign
     7374                   v-object-handle :col = buf_temp-diasize-handle.save-position
     7375                 .
     7376               end.
     7377             end.
     7378             run diasize_position-resize-button in this-procedure .
     7379           end.
     7380           assign
     7381             v-diasize-change-size = false
     7382           .
     7383           leave move_block .
     7384         end.
     7385       end.
     7386       assign
     7387         v-diasize-need-full-display = true
     7388       .
     7389       if v-diasize-change-size = false
     7390       then do:
     7391         assign
     7392           v-diasize-change-size = true
     7393         .
     7394       end.
     7395       else do:
     7396         return .
     7397       end.
     7398       assign
     7399         v-frame-width = frame Dialog-Frame :width
     7400         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     7401         v-browse-width = v-diasize-browse-handle :width
     7402       .
     7403       for each buf_temp-browse-handle
     7404         where buf_temp-browse-handle.browse-type = 'width':u
     7405       :
     7406         assign
     7407           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     7408         .
     7409       end.
     7410       for each buf_temp-diasize-handle
     7411       :
     7412         delete buf_temp-diasize-handle .
     7413       end.
     7414       assign
     7415         v-field-group-handle = frame Dialog-Frame :first-child
     7416       .
     7417       do while valid-handle(v-field-group-handle)
     7418       :
     7419         assign
     7420           v-object-handle = v-field-group-handle :first-child
     7421         .
     7422         do while valid-handle(v-object-handle)
     7423         :
     7424           if  v-object-handle <> v-diasize-browse-handle :handle
     7425           and v-object-handle <> v-diasize-resize-button
     7426           and can-query(v-object-handle, "row")
     7427           and can-query(v-object-handle, "height")
     7428           and ( v-object-handle :col + v-object-handle :width
     7429                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     7430               )
     7431           then do:
     7432             find first buf_temp-browse-handle
     7433               where buf_temp-browse-handle.browse-type   = 'width':u
     7434                 and buf_temp-browse-handle.browse-handle = v-object-handle
     7435               no-error .
     7436             if available buf_temp-browse-handle
     7437             then do:
     7438             end.
     7439             else do:
     7440               create buf_temp-diasize-handle .
     7441               assign
     7442                 buf_temp-diasize-handle.handle-value  = v-object-handle
     7443                 buf_temp-diasize-handle.save-position = v-object-handle :col
     7444               .
     7445             end.
     7446           end.
     7447           assign
     7448             v-object-handle = v-object-handle :next-sibling
     7449           .
     7450         end.
     7451         assign
     7452           v-field-group-handle = v-field-group-handle :next-sibling
     7453         .
     7454       end.
     7455       do with frame Dialog-Frame
     7456       :
     7457         hide v-diasize-resize-button .
     7458         v-diasize-resize-button :row = 1.
     7459         v-diasize-resize-button :column = 1.
     7460       end.
     7461       if p-change-value > 0
     7462       then do:
     7463         if frame Dialog-Frame :scrollable = true
     7464         then do:
     7465           assign
     7466             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     7467             no-error .
     7468           if error-status :error
     7469           or error-status :get-message(1) <> ""
     7470           then do:
     7471             undo move_block, retry move_block.
     7472           end.
     7473         end.
     7474         assign
     7475           frame Dialog-Frame :width = v-frame-width + p-change-value
     7476           no-error .
     7477         if error-status :error
     7478         or error-status :get-message(1) <> ""
     7479         then do:
     7480           undo move_block, retry move_block.
     7481         end.
     7482         assign
     7483           v-diasize-browse-handle :width = v-browse-width + p-change-value
     7484         no-error .
     7485         if error-status :error
     7486         or error-status :get-message(1) <> ""
     7487         then do:
     7488           undo move_block, retry move_block.
     7489         end.
     7490         for each buf_temp-browse-handle
     7491           where buf_temp-browse-handle.browse-type = 'width':u
     7492         on error undo move_block, retry move_block
     7493         :
     7494           assign
     7495             buf_temp-browse-handle.browse-handle :width
     7496               = buf_temp-browse-handle.browse-handle :width + p-change-value
     7497             no-error .
     7498           if error-status :error
     7499           or error-status :get-message(1) <> ""
     7500           then do:
     7501             undo move_block, retry move_block .
     7502           end.
     7503         end.
     7504         for each buf_temp-diasize-handle
     7505         on error undo move_block, retry move_block
     7506         :
     7507           assign
     7508             v-object-handle = buf_temp-diasize-handle.handle-value
     7509           .
     7510           if v-object-handle <> v-diasize-resize-button
     7511           then do:
     7512             assign
     7513               v-object-handle :col = v-object-handle :col + p-change-value
     7514               no-error .
     7515             if error-status :error
     7516             or error-status :get-message(1) <> ""
     7517             then do:
     7518               undo move_block, retry move_block .
     7519             end.
     7520           end.
     7521         end.
     7522       end.
     7523       else do:
     7524         for each buf_temp-diasize-handle
     7525         on error undo move_block, retry move_block
     7526         :
     7527           assign
     7528             v-object-handle = buf_temp-diasize-handle.handle-value
     7529           .
     7530           if v-object-handle <> v-diasize-resize-button
     7531           then do:
     7532             assign
     7533               v-object-handle :col = v-object-handle :col + p-change-value
     7534               no-error .
     7535             if error-status :error
     7536             or error-status :get-message(1) <> ""
     7537             then do:
     7538               undo move_block, retry move_block .
     7539             end.
     7540           end.
     7541         end.
     7542         for each buf_temp-browse-handle
     7543           where buf_temp-browse-handle.browse-type = 'width':u
     7544         on error undo move_block, retry move_block
     7545         :
     7546           assign
     7547             buf_temp-browse-handle.browse-handle :width
     7548               = buf_temp-browse-handle.browse-handle :width + p-change-value
     7549             no-error .
     7550           if error-status :error
     7551           or error-status :get-message(1) <> ""
     7552           then do:
     7553             undo move_block, retry move_block .
     7554           end.
     7555         end.
     7556         assign
     7557           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     7558           no-error .
     7559         if error-status :error
     7560         or error-status :get-message(1) <> ""
     7561         then do:
     7562           undo move_block, retry move_block.
     7563         end.
     7564         assign
     7565           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     7566         no-error .
     7567         if error-status :error
     7568         or error-status :get-message(1) <> ""
     7569         then do:
     7570           undo move_block, retry move_block.
     7571         end.
     7572         if frame Dialog-Frame :scrollable = true
     7573         then do:
     7574           assign
     7575             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     7576           no-error .
     7577           if error-status :error
     7578           or error-status :get-message(1) <> ""
     7579           then do:
     7580             undo move_block, retry move_block.
     7581           end.
     7582         end.
     7583       end.
     7584       if p-move-resize
     7585       then do:
     7586         run diasize_position-resize-button in this-procedure .
     7587       end.
     7588       if v-diasize-wndstore = true
     7589       then do:
     7590         if connected("ub") = true
     7591         then do:
     7592           define variable v-cntxt-db-num        as integer   no-undo .
     7593           define variable v-cntxt-userid        as character no-undo .
     7594           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     7595                                             , OUTPUT v-cntxt-userid
     7596                                             ) .
     7597           run gbl/wndsizew.p
     7598             (input  v-cntxt-db-num
     7599             ,input  v-cntxt-userid
     7600             ,input  v-diasize-proc-name
     7601             ,input  'width':u
     7602             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     7603             ) .
     7604         end.
     7605       end.
     7606     end.
     7607     assign
     7608       v-diasize-change-size = false
     7609     .
     7610   end procedure.
     7611   procedure diasize_set-width :
     7612     define input  parameter p-new-width  as decimal   no-undo .
     7613     define input  parameter p-move-resize as logical   no-undo .
     7614     do
     7615     on error undo, return error return-value
     7616     :
     7617       run diasize_change-width in this-procedure
     7618         (input  (p-new-width - frame Dialog-Frame :width)
     7619         ,input  p-move-resize
     7620         ) .
     7621     end.
     7622   end procedure.
     7623   procedure diasize_position-resize-button :
     7624     do with frame Dialog-Frame
     7625     :
     7626       hide v-diasize-resize-button .
     7627       assign
     7628         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     7629                     - 1
     7630                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     7631         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     7632                     - 1
     7633                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     7634       .
     7635       view v-diasize-resize-button .
     7636     end.
     7637   end procedure.
     7638   on alt-right anywhere
     7639   do:
     7640     run diasize_change-width in this-procedure
     7641       (input 1
     7642       ,input true
     7643       ) .
     7644     return no-apply .
     7645   end.
     7646   on alt-left anywhere
     7647   do:
     7648     run diasize_change-width in this-procedure
     7649       (input -1
     7650       ,input true
     7651       ) .
     7652     return no-apply .
     7653   end.
     7654   on alt-down anywhere
     7655   do:
     7656     run diasize_change-height in this-procedure
     7657       (input 1
     7658       ,input true
     7659       ) .
     7660     return no-apply .
     7661   end.
     7662   on alt-up anywhere
     7663   do:
     7664     run diasize_change-height in this-procedure
     7665       (input -1
     7666       ,input true
     7667       ) .
     7668     return no-apply .
     7669   end.
     7670   on alt-enter of frame Dialog-Frame
     7671   do:
     7672     run diasize_maximize in this-procedure
     7673       (input  ?
     7674       ).
     7675     return no-apply .
     7676   end.
     7677   procedure diasize_end-move :
     7678     do
     7679     on error undo, return error return-value
     7680     :
     7681       define variable v-row-delta as decimal   no-undo .
     7682       define variable v-col-delta as decimal   no-undo .
     7683       define variable v-new-row as decimal   no-undo .
     7684       define variable v-new-col as decimal   no-undo .
     7685       assign
     7686         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     7687         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     7688       .
     7689       assign
     7690         v-row-delta = v-new-row - frame Dialog-Frame :height
     7691         v-col-delta = v-new-col - frame Dialog-Frame :width
     7692       .
     7693       run diasize_change-height in this-procedure
     7694         (input v-row-delta
     7695         ,input true
     7696         ) .
     7697       run diasize_change-width in this-procedure
     7698         (input v-col-delta
     7699         ,input true
     7700         ) .
     7701     end.
     7702   end procedure.
     7703   procedure diasize_maximize :
     7704     define input  parameter p-action as logical   no-undo .
     7705     do
     7706     on error undo, return error return-value
     7707     :
     7708       if p-action = ?
     7709       then do:
     7710         if v-diasize-need-maximize = true
     7711         then do:
     7712           assign
     7713             p-action = true
     7714           .
     7715         end.
     7716         else do:
     7717           assign
     7718             p-action = false
     7719           .
     7720         end.
     7721       end.
     7722       if p-action = true
     7723       then do:
     7724         run diasize_change-height in this-procedure
     7725           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     7726               - frame Dialog-Frame :height-chars
     7727           ,input true
     7728           ) .
     7729         run diasize_change-width in this-procedure
     7730           (input session :width-chars
     7731               - frame Dialog-Frame :width-chars
     7732           ,input true
     7733           ) .
     7734         assign
     7735           v-diasize-need-maximize = false
     7736         .
     7737       end.
     7738       else do:
     7739         run diasize_change-width in this-procedure
     7740           (input v-diasize-orig-frame-width
     7741               - frame Dialog-Frame :width-chars
     7742           ,input true
     7743           ) .
     7744         run diasize_change-height in this-procedure
     7745           (input v-diasize-orig-frame-height
     7746               - frame Dialog-Frame :height-chars
     7747           ,input true
     7748           ) .
     7749         assign
     7750           v-diasize-need-maximize = true
     7751         .
     7752       end.
     7753     end.
     7754   end procedure.
     7755   procedure diasize_restore-orig-size :
     7756     do
     7757     on error undo, return error return-value
     7758     :
     7759       assign
     7760         v-diasize-current-frame-width  = frame Dialog-Frame :width
     7761         v-diasize-current-frame-height = frame Dialog-Frame :height
     7762       .
     7763       run diasize_set-height in this-procedure
     7764         (input  v-diasize-orig-frame-height
     7765         ,input  true
     7766         ) .
     7767       run diasize_set-width in this-procedure
     7768         (input  v-diasize-orig-frame-width
     7769         ,input  true
     7770         ) .
     7771     end.
     7772   end procedure.
     7773   procedure diasize_restore-current-size :
     7774     do
     7775     on error undo, return error return-value
     7776     :
     7777       run diasize_set-height in this-procedure
     7778         (input  v-diasize-current-frame-height
     7779         ,input  true
     7780         ) .
     7781       run diasize_set-width in this-procedure
     7782         (input  v-diasize-current-frame-width
     7783         ,input  true
     7784         ) .
     7785     end.
     7786   end procedure.
     7787   procedure diasize_set-browse-handle :
     7788     define input  parameter p-browse-handle as handle   no-undo .
     7789     define buffer buf_temp-browse-handle for temp-browse-handle .
     7790     do
     7791     on error undo, return error return-value
     7792     :
     7793       assign
     7794         v-diasize-browse-handle = p-browse-handle
     7795       .
     7796       for each buf_temp-browse-handle
     7797       on error undo, return error return-value
     7798       :
     7799         delete buf_temp-browse-handle .
     7800       end.
     7801     end.
     7802   end procedure.
     7803   procedure diasize_add_browse :
     7804     define input  parameter p-browse-type   as character no-undo .
     7805     define input  parameter p-browse-handle as handle    no-undo .
     7806     define buffer buf_temp-browse-handle for temp-browse-handle .
     7807     do
     7808     on error undo, return error return-value
     7809     :
     7810       assign
     7811         v-diasize-browse-number = v-diasize-browse-number + 1
     7812       .
     7813       create buf_temp-browse-handle .
     7814       assign
     7815         buf_temp-browse-handle.browse-type   = p-browse-type
     7816         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     7817         buf_temp-browse-handle.browse-handle = p-browse-handle
     7818       .
     7819     end.
     7820   end procedure.
     7821   procedure diasize_init :
     7822     define variable v-default-value    as logical   no-undo .
     7823     define variable v-restore-saved    as logical   no-undo .
     7824     define variable v-resize-value-str as character no-undo .
     7825     do
     7826     on error undo, return error return-value
     7827     :
     7828       do with frame Dialog-Frame
     7829       :
     7830         assign
     7831           v-diasize-orig-frame-height = frame Dialog-Frame :height
     7832           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     7833           v-diasize-browse-handle     = browse br-table :handle
     7834         .
     7835         create button v-diasize-resize-button
     7836         assign
     7837           parent        = frame Dialog-Frame :first-child
     7838           label         = "s"
     7839           height-pixels = 16
     7840           width-pixels  = 16
     7841           visible       = true
     7842           sensitive     = true
     7843           movable       = true
     7844           triggers:
     7845             on end-move persistent run diasize_end-move in this-procedure .
     7846           end triggers.
     7847         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     7848         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     7849         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     7850         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     7851         assign
     7852           v-diasize-wndmax = false
     7853         .
     7854         if connected("ub") = true
     7855         then do:
     7856           define variable v-cntxt-db-num        as integer   no-undo .
     7857           define variable v-cntxt-userid        as character no-undo .
     7858           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     7859                                             , OUTPUT v-cntxt-userid
     7860                                             ) .
     7861           run gbl/wndpar_r.p
     7862             (input  v-cntxt-db-num
     7863             ,input  v-cntxt-userid
     7864             ,input  'wndmax':U
     7865             ,output v-diasize-wndmax
     7866             ,output v-default-value
     7867             ) .
     7868         end.
     7869         assign
     7870           v-diasize-wndstore = false
     7871         .
     7872         if connected("ub") = true
     7873         then do:
     7874           run gbl/wndpar_r.p
     7875             (input  v-cntxt-db-num
     7876             ,input  v-cntxt-userid
     7877             ,input  'wndstore':U
     7878             ,output v-diasize-wndstore
     7879             ,output v-default-value
     7880             ) .
     7881         end.
     7882         assign
     7883           v-diasize-proc-name = entry(1, program-name(2), '.')
     7884         .
     7885         if v-diasize-wndstore = true
     7886         then do:
     7887           assign
     7888             v-restore-saved = false
     7889           .
     7890           if connected("ub") = true
     7891           then do:
     7892             run gbl/wndsizer.p
     7893               (input  v-cntxt-db-num
     7894               ,input  v-cntxt-userid
     7895               ,input  v-diasize-proc-name
     7896               ,input  'height':u
     7897               ,output v-resize-value-str
     7898               ) .
     7899             if v-resize-value-str <> '':U
     7900             then do:
     7901               run diasize_change-height in this-procedure
     7902                 (input  integer(v-resize-value-str)
     7903                 ,input  true
     7904                 ) .
     7905               assign
     7906                 v-restore-saved = true
     7907               .
     7908             end.
     7909           end.
     7910           if connected("ub") = true
     7911           then do:
     7912             run gbl/wndsizer.p
     7913               (input  v-cntxt-db-num
     7914               ,input  v-cntxt-userid
     7915               ,input  v-diasize-proc-name
     7916               ,input  'width':u
     7917               ,output v-resize-value-str
     7918               ) .
     7919             if v-resize-value-str <> '':U
     7920             then do:
     7921               run diasize_change-width in this-procedure
     7922                 (input  integer(v-resize-value-str)
     7923                 ,input  true
     7924                 ) .
     7925               assign
     7926                 v-restore-saved = true
     7927               .
     7928             end.
     7929           end.
     7930           if v-restore-saved <> true
     7931           then do:
     7932             if v-diasize-wndmax = true
     7933             then do:
     7934               run diasize_maximize in this-procedure
     7935                 (input  true
     7936                 ) .
     7937             end.
     7938           end.
     7939         end.
     7940         else do:
     7941           if v-diasize-wndmax = true
     7942           then do:
     7943             run diasize_maximize in this-procedure
     7944               (input  true
     7945               ) .
     7946           end.
     7947         end.
     7948       end.
     7949     end.
     7950   end procedure.
     7951   procedure diasize_need-full-display :
     7952     define output parameter p-need-full-display as logical   no-undo .
     7953     do
     7954     on error undo, return error return-value
     7955     :
     7956       assign
     7957         p-need-full-display = v-diasize-need-full-display
     7958       .
     7959       assign
     7960         v-diasize-need-full-display = false
     7961       .
     7962     end.
     7963   end procedure.
     7964   procedure get-context :
     7965      define output parameter p-db-num as integer          no-undo.
     7966      define output parameter p-user-id as character        no-undo.
     7967      define variable v-login               as character    no-undo.
     7968      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     7969      define buffer buf_user-login  for ub.user-login .
     7970      do
     7971      on error undo, return error
     7972      :
     7973            FIND FIRST buf_sys-ctrl no-lock.
     7974            ASSIGN
     7975               v-login = USERID("ub")
     7976               p-db-num = buf_sys-ctrl.db-num
     7977            .
     7978            FIND FIRST buf_user-login
     7979                 WHERE buf_user-login.db-num = p-db-num
     7980                   AND buf_user-login.user-login = v-login
     7981                 no-lock
     7982                 no-error
     7983                 .
     7984            IF AVAILABLE buf_user-login
     7985            THEN DO:
     7986               assign
     7987                  p-user-id = buf_user-login.user-id
     7988               .
     7989            END.
     7990      end.
     7991   end procedure.
     7992       run diasize_init in this-procedure .
     7993   define variable vss-include-info56 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7994   on CTRL-F7 of frame Dialog-Frame anywhere do:
     7995     if b-close :sensitive then DO: apply "CHOOSE":U to b-close in frame Dialog-Frame. END.
     7996     return no-apply.
     7997   end.
     7998   define variable vss-include-info57 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7999   on CTRL-P, CTRL-З of frame Dialog-Frame anywhere do:
     8000     if b-print :sensitive then DO: apply "CHOOSE":U to b-print in frame Dialog-Frame. END.
     8001     return no-apply.
     8002   end.
     8003   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     8004   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     8005   MAIN-BLOCK:
     8006   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     8007      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     8008   define variable vss-include-info58 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8009     run mainmenu_getcntxt in p-mainmenu-handle
     8010       (output v-cntxt-db-num
     8011       ,output v-cntxt-userid
