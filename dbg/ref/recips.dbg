     8071                           vss-workfile vss-revision vss-description
     8072                       skip "Неверно выбран рецепт."
     8073                       skip return-value
     8074                       skip trim(error-status :get-message(1))
     8075                           trim(error-status :get-message(2))
     8076                           trim(error-status :get-message(3))
     8077                   view-as alert-box error.
     8078                   undo, return error .
     8079               end.
     8080           end.
     8081           when 'ПРОСМОТР':U
     8082           then do:
     8083               find first buf_init_recipe no-lock
     8084                    where buf_init_recipe.doc-code    = p-doc-code
     8085                      and buf_init_recipe.recipe-code = p-in-recipe-code
     8086               no-error.
     8087               if not available buf_init_recipe
     8088               then do:
     8089                   message
     8090                           vss-workfile vss-revision vss-description
     8091                       skip "Неверно выбран рецепт."
     8092                       skip return-value
     8093                       skip trim(error-status :get-message(1))
     8094                           trim(error-status :get-message(2))
     8095                           trim(error-status :get-message(3))
     8096                   view-as alert-box error.
     8097                   undo, return error .
     8098               end.
     8099           end.
     8100       end case.
     8101       FRAME Dialog-Frame :title = (                        buf_init_recipe.recipe-type
     8102                                       + " № "             + buf_init_recipe.recipe-code
     8103                                       + "    артикул : "  + buf_init_recipe.artic
     8104                                       + "     "           + buf_init_goods.gds-name
     8105                                       + "        "        + p-mode )
     8106       .
     8107       run init-fields in this-procedure .
     8108       RUN enable_UI.
     8109       run calc-and-display-nutrition-info in this-procedure .
     8110       case p-mode
     8111       :
     8112           when 'ПРОСМОТР':U
     8113           then do:
     8114               disable
     8115                   fi-recipe-name
     8116                   fi-recipe-qnty
     8117                   fi-brutto-qnty
     8118                   fi-portion-qnty
     8119                   fi-recipe-ref-num
     8120                   fi-recipe-portion-weight
     8121                   b-cancel
     8122                   b-gds
     8123                   b-hst
     8124                   b-rcp
     8125                   b-up
     8126                   b-down
     8127                   b-change
     8128               with frame Dialog-Frame .
     8129               assign
     8130                   fi-recipe-name         :fgcolor = 4
     8131                   fi-recipe-qnty         :fgcolor = 4
     8132                   fi-brutto-qnty         :fgcolor = 4
     8133                   fi-portion-qnty        :fgcolor = 4
     8134                   fi-recipe-ref-num      :fgcolor = 4
     8135                   fi-recipe-portion-weight       :fgcolor = 4
     8136                   ed-recipe-technique    :fgcolor = 4
     8137                   ed-recipe-technique    :read-only in frame Dialog-Frame = yes
     8138               .
     8139           end.
     8140           otherwise do:
     8141           end.
     8142       end case.
     8143       if lookup( 'шту':U, buf_init_units.type ) > 0
     8144       then do:
     8145           disable
     8146               fi-brutto-qnty
     8147           with frame Dialog-Frame .
     8148           assign
     8149               fi-brutto-qnty         :fgcolor = 4
     8150           .
     8151       end.
     8152       apply "entry" to br-table.
     8153       WAIT-FOR GO OF FRAME Dialog-Frame.
     8154   END.
     8155   RUN disable_UI.
     8156   PROCEDURE add-recipe :
     8157   do
     8158   on error undo, return error
     8159   :
     8160   define input parameter p-artic      as character    no-undo.
     8161   define input parameter p-prod-type  as character    no-undo.
     8162   define input parameter p-prod-code  as integer      no-undo.
     8163       define variable v-ref-list as character no-undo.
     8164       define buffer buf_goods     for goods.
     8165       define buffer buf_fbr-doc   for fbr-doc.
     8166       find first buf_fbr-doc no-lock
     8167            where buf_fbr-doc.doc-code = p-doc-code
     8168       .
     8169       find first buf_goods no-lock
     8170            where buf_goods.artic     = p-artic
     8171              AND buf_goods.prod-type = p-prod-type
     8172              AND buf_goods.prod-code = p-prod-code
     8173       .
     8174       run ref/rcp-all.w (
     8175             input p-mainmenu-handle
     8176           , input ( if p-mode = 'ПРОСМОТР':U then "" else "b-add" )
     8177           , input 'все':U
     8178           , input recid( buf_goods )
     8179           , input buf_fbr-doc.obj-type
     8180           , input buf_fbr-doc.obj-code
     8181           , output v-ref-list
     8182       ).
     8183   end.
     8184   END PROCEDURE.
     8185   PROCEDURE calc-and-display-nutrition-info :
     8186   do
     8187   on error undo, return error return-value
     8188   :
     8189     assign
     8190       v-calories      = fbrnutro_get-recipe-nutrition-by-code ( buf_init_recipe.recipe-code, buf_init_recipe.artic, buf_init_recipe.prod-type, buf_init_recipe.prod-code, 'calories':U    ,fi-recipe-qnty)
     8191       v-protein       = fbrnutro_get-recipe-nutrition-by-code ( buf_init_recipe.recipe-code, buf_init_recipe.artic, buf_init_recipe.prod-type, buf_init_recipe.prod-code, 'protein':U     ,fi-recipe-qnty)
     8192       v-fat           = fbrnutro_get-recipe-nutrition-by-code ( buf_init_recipe.recipe-code, buf_init_recipe.artic, buf_init_recipe.prod-type, buf_init_recipe.prod-code, 'fat':U         ,fi-recipe-qnty)
     8193       v-carbohydrate  = fbrnutro_get-recipe-nutrition-by-code ( buf_init_recipe.recipe-code, buf_init_recipe.artic, buf_init_recipe.prod-type, buf_init_recipe.prod-code, 'carbohydrate':U,fi-recipe-qnty)
     8194     .
     8195     display
     8196       v-calories
     8197       v-protein
     8198       v-fat
     8199       v-carbohydrate
     8200     with frame Dialog-Frame .
     8201   end.
     8202   END PROCEDURE.
     8203   PROCEDURE check-recipe :
     8204   do
     8205   on error undo, return error
     8206   :
     8207   define input parameter p-recipe-code        as character    no-undo.
     8208   define input parameter p-recipe-name        as character    no-undo.
     8209   define input parameter p-recipe-qnty        as decimal      no-undo.
     8210   define input parameter p-brutto-qnty        as decimal      no-undo.
     8211   define input parameter p-portion-qnty       as decimal      no-undo.
     8212   define input parameter p-recipe-ref-num     as character    no-undo.
     8213   define input parameter p-recipe-portion-weight as char      no-undo.
     8214   define input parameter p-recipe-technique   as character    no-undo.
     8215   define output parameter p-bad-data          as logical      no-undo.
     8216   define output parameter p-error-text        as character    no-undo.
     8217       define variable v-gds-code          as integer        no-undo.
     8218       define variable v-unit-base         as character      no-undo.
     8219       define variable v-is-goods          as logical        no-undo.
     8220       define variable v-empty-scale       as logical        no-undo.
     8221       define variable v-ingr-count        as integer        no-undo.
     8222       define variable v-waste-count       as integer        no-undo.
     8223       define buffer buf_units             for units.
     8224       define buffer buf_recipe            for fbr-recipe.
     8225       define buffer buf_recipe-gds        for fbr-recipe-gds.
     8226       define buffer buf_other_recipe-gds  for fbr-recipe-gds.
     8227       if p-portion-qnty < 1
     8228       then do:
     8229           assign
     8230               p-bad-data   = yes
     8231               p-error-text = "Количество порций не может быть меньше 1."
     8232           .
     8233           undo, return.
     8234       end.
     8235       if lookup( 'шту':U, buf_init_units.type ) > 0
     8236       then do:
     8237           if p-portion-qnty > p-recipe-qnty
     8238           then do:
     8239               assign
     8240                   p-bad-data   = yes
     8241                   p-error-text = "Для штучного товара количество порций не может быть больше количества товара рецепта."
     8242               .
     8243               undo, return.
     8244           end.
     8245       end.
     8246       if p-recipe-name = ?
     8247       or p-recipe-name = ""
     8248       then do:
     8249           assign
     8250               p-bad-data   = yes
     8251               p-error-text = "Название рецепта не может быть пустым."
     8252           .
     8253           undo, return.
     8254       end.
     8255       find first buf_recipe no-lock
     8256            where buf_recipe.doc-code    = p-doc-code
     8257              and buf_recipe.recipe-code = p-recipe-code
     8258       .
     8259   define variable vss-include-info61 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8260   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     8261     (input  buf_recipe.artic
     8262     ,input  buf_recipe.prod-type
     8263     ,input  buf_recipe.prod-code
     8264     ,input  'empty-scale=request':u
     8265     ,output v-empty-scale
     8266     )  .
     8267       if v-empty-scale = no
     8268       then do:
     8269           assign
     8270               p-bad-data   = yes
     8271               p-error-text = "В рецепте могут быть только товары без шкал."
     8272           .
     8273           undo, return.
     8274       end.
     8275       if ( buf_recipe.recipe-type = 'производство':U
     8276         or buf_recipe.recipe-type = 'комплектация':U
     8277         or buf_recipe.recipe-type = 'альтернатива':U )
     8278       and ( p-recipe-qnty <= 0
     8279          or p-recipe-qnty = ? )
     8280       then do:
     8281           assign
     8282               p-bad-data   = yes
     8283               p-error-text = "Количество составного товара рецепта должно быть больше 0."
     8284           .
     8285           undo, return.
     8286       end.
     8287   define variable vss-include-info62 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8288   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
