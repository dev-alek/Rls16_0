     4379   procedure gds-attr-name :
     4380     define input  parameter p-code           as character no-undo .
     4381     define output parameter p-type           as character no-undo .
     4382     define output parameter p-format         as character no-undo .
     4383     define output parameter p-label          as character no-undo .
     4384     define output parameter p-user-can-edit  as logical   no-undo .
     4385     define output parameter p-output-display as logical   no-undo .
     4386     define output parameter p-other          as character no-undo .
     4387     do
     4388     on error undo, return error
     4389     :
     4390           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-name in g#attr-lib
     4391         (input  p-code
     4392         ,output p-type
     4393         ,output p-format
     4394         ,output p-label
     4395         ,output p-user-can-edit
     4396         ,output p-output-display
     4397         ,output p-other
     4398         ) no-error .
     4399       if error-status :error
