     1482                                   , chr(10)
     1483                                   , error-status:get-message(1)
     1484                                   , return-value ).
     1485   end.
     1486   create buf_fbr-doc.
     1487   assign
     1488   buf_fbr-doc.doc-code  = v-doc-code
     1489   buf_fbr-doc.creid     = p-userid
     1490   buf_fbr-doc.doc-date  = v-today
     1491   buf_fbr-doc.doc-type  = 'производство':U
     1492   buf_fbr-doc.host-code = v-host-code
     1493   buf_fbr-doc.obj-code  = p-obj-code
     1494   buf_fbr-doc.obj-type  = p-obj-type
     1495   buf_fbr-doc.PS        = "@"
