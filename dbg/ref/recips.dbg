     1431     return error substitute("Запрещено создание документа производства в чужой БД:&1БД &2&3 - &4&1текущая БД - &5"
     1432                             , chr(10)
     1433                             , p-obj-type
     1434                             , p-obj-code
     1435                             , v-obj-db-num
     1436                             , v-db-num).
     1437   end.
     1438   run cur-time in this-procedure ( output v-today, output v-time).
     1439   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1440   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1441     (input  p-obj-type
     1442     ,input  p-obj-code
     1443     ,output v-today
     1444     )  .
     1445   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1446   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1447     (input  v-host-code
     1448     ,output v-base-code
     1449     )  .
     1450   find last buf_curr-accnt no-lock
     1451       where buf_curr-accnt.curr-code = v-base-code
     1452         and buf_curr-accnt.exch-date <= v-today use-index pi
     1453   no-error.
     1454   if not available buf_curr-accnt
     1455   then do:
     1456     undo, return error substitute("На дату &1 неизвестен курс базовой валюты с кодом &2"
     1457                                     , string(v-today, "99/99/9999")
     1458                                     , v-base-code).
     1459   end.
     1460   run doc-code in this-procedure (
     1461         input  "main"
     1462       , input  p-obj-type
     1463       , input  p-obj-code
     1464       , input  ?
     1465       , output v-doc-code
     1466   ) no-error.
     1467   if error-status:error
