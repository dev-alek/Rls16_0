     1510   procedure fbrlib_get-default-pay-code :
     1511   define input parameter p-obj-type   as character        no-undo.
     1512   define input parameter p-obj-code   as integer          no-undo.
     1513   define output parameter p-pay-code  as integer          no-undo.
     1514   define variable v-host-code as integer no-undo .
     1515   define buffer buf_shop          for ub.shop.
     1516   define buffer buf_store         for ub.store.
     1517   define buffer buf_sysconf       for ub.sysconf.
     1518   do
     1519   for buf_shop
     1520     , buf_store
     1521     , buf_sysconf
     1522   on error undo, return error
     1523   :
     1524     case p-obj-type  :
     1525       when 'маг':U then do:
     1526           find first buf_shop no-lock
     1527                 where buf_shop.obj-code = p-obj-code
     1528           no-error.
     1529           if available buf_shop
     1530           then do:
     1531               assign
     1532                   p-pay-code = buf_shop.fbr-pay
     1533               .
     1534           end.
     1535       end.
     1536       when 'скл':U then do:
     1537           find first buf_store no-lock
     1538                 where buf_store.obj-code = p-obj-code
     1539           no-error.
     1540           if available buf_store
     1541           then do:
     1542               assign
     1543                   p-pay-code = buf_store.fbr-pay
     1544               .
     1545           end.
     1546       end.
     1547     end case.
     1548     if p-pay-code = ?
     1549     or p-pay-code = 0
     1550     then do:
     1551   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1552   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1553     (input  p-obj-type
     1554     ,input  p-obj-code
     1555     ,output v-host-code
     1556     )  .
     1557         find first buf_sysconf no-lock
     1558               where buf_sysconf.host-code = v-host-code
     1559         no-error.
     1560         if available buf_sysconf
     1561         then do:
     1562             assign
     1563                 p-pay-code = buf_sysconf.fbr-pay
     1564             .
     1565         end.
     1566     end.
     1567     if p-pay-code = ?
     1568     or p-pay-code = 0
     1569     then do:
     1570   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1571   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdnpay in g#library
     1572     (input  p-obj-type
     1573     ,input  p-obj-code
     1574     ,output p-pay-code
     1575     )  .
     1576     end.
     1577   end.
     1578   end procedure.
     1579   procedure fbrlib-fill-and-check-temp_fbrlib_recipe :
     1580   do
     1581   on error undo, return error
     1582   :
     1583   define input parameter p-fbr-doc-code as character    no-undo.
     1584       define variable vss-description as character    no-undo init "fbrlib-fill-and-check-temp_fbrlib_recipe: ".
     1585       define variable v-gds-name      as character    no-undo.
     1586       define buffer buf_fbr-doc               for ub.fbr-doc.
     1587       define buffer buf_fbr-line              for ub.fbr-line.
     1588       define buffer buf_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     1589       define buffer buf_out_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     1590       find first buf_fbr-doc no-lock
     1591            where buf_fbr-doc.doc-code = p-fbr-doc-code
     1592       .
     1593       for each buf_temp_fbrlib_recipe
     1594       :
     1595           delete buf_temp_fbrlib_recipe.
     1596       end.
     1597       for each buf_fbr-line no-lock
     1598          where buf_fbr-line.doc-code = p-fbr-doc-code
     1599       :
     1600           find first buf_temp_fbrlib_recipe
     1601                where buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     1602           no-error.
     1603           if not available buf_temp_fbrlib_recipe
     1604           then do:
     1605               create buf_temp_fbrlib_recipe.
     1606               assign
     1607                   buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     1608                   buf_temp_fbrlib_recipe.fbr-doc-code = buf_fbr-line.doc-code
     1609               .
     1610           end.
     1611       end.
     1612       for each buf_temp_fbrlib_recipe
     1613       :
     1614           assign
     1615               buf_temp_fbrlib_recipe.count-income                = 0
     1616               buf_temp_fbrlib_recipe.qnty-income                 = 0
     1617               buf_temp_fbrlib_recipe.sum-income-sale             = 0
     1618               buf_temp_fbrlib_recipe.sum-income-cost-base        = 0
     1619               buf_temp_fbrlib_recipe.sum-income-cost-rubl        = 0
     1620               buf_temp_fbrlib_recipe.sum-income-vat-cost-base    = 0
     1621               buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl    = 0
     1622               buf_temp_fbrlib_recipe.count-write-off             = 0
     1623               buf_temp_fbrlib_recipe.qnty-write-off              = 0
     1624               buf_temp_fbrlib_recipe.sum-write-off-sale          = 0
     1625               buf_temp_fbrlib_recipe.sum-write-off-cost-base     = 0
     1626               buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = 0
     1627               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = 0
     1628               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = 0
     1629           .
     1630           for each buf_fbr-line no-lock
     1631              where buf_fbr-line.doc-code     = p-fbr-doc-code
     1632                and buf_fbr-line.trn-type     = 'при':U
     1633                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     1634           :
     1635               if ( buf_fbr-line.price-base   = ?
     1636                   or buf_fbr-line.price-rubl = ?
     1637                   or buf_fbr-line.price-base <= 0
     1638                   or buf_fbr-line.price-rubl <= 0 )
     1639               and buf_fbr-line.fact-qnty <> 0
     1640               and buf_fbr-line.rsrv-qnty <> ?
     1641               and buf_fbr-doc.is-free    = no
     1642               then do:
     1643   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1644   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1645     (input  buf_fbr-line.artic
     1646     ,input  buf_fbr-line.prod-type
     1647     ,input  buf_fbr-line.prod-code
     1648     ,output v-gds-name
     1649     ) no-error .
     1650                   if error-status :error
     1651                   then do:
     1652                       assign
     1653                           v-gds-name = ""
     1654                       .
     1655                   end.
     1656                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     1657                                                 ,vss-description
     1658                                                 ,buf_fbr-doc.doc-code
     1659                                                 ,chr(10)
     1660                                                 ,buf_fbr-line.recipe-code
     1661                                                 ,buf_fbr-line.artic
     1662                                                 ,v-gds-name).
     1663               end.
     1664               assign
     1665                   buf_temp_fbrlib_recipe.count-income             = buf_temp_fbrlib_recipe.count-income + 1
     1666                   buf_temp_fbrlib_recipe.qnty-income              = buf_temp_fbrlib_recipe.qnty-income
     1667                                                                   + buf_fbr-line.fact-qnty
     1668                   buf_temp_fbrlib_recipe.sum-income-sale          = buf_temp_fbrlib_recipe.sum-income-sale
     1669                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     1670               .
     1671               if buf_fbr-line.is-waste = no
     1672               then do:
     1673                   assign
     1674                       buf_temp_fbrlib_recipe.sum-income-cost-base     = buf_temp_fbrlib_recipe.sum-income-cost-base
     1675                                                                       + buf_fbr-line.price-sum-base
     1676                       buf_temp_fbrlib_recipe.sum-income-cost-rubl     = buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1677                                                                       + buf_fbr-line.price-sum-rubl
     1678                       buf_temp_fbrlib_recipe.sum-income-vat-cost-base = buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1679                                                                       + buf_fbr-line.price-sum-vat-base
     1680                       buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1681                                                                       + buf_fbr-line.price-sum-vat-rubl
     1682                   .
     1683               end.
     1684           end.
     1685           for each buf_fbr-line no-lock
     1686              where buf_fbr-line.doc-code     = p-fbr-doc-code
     1687                and buf_fbr-line.trn-type     = 'спи':U
     1688                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     1689           :
     1690               if ( buf_fbr-line.price-base   = ?
     1691                   or buf_fbr-line.price-rubl = ?
     1692                   or buf_fbr-line.price-base <= 0
     1693                   or buf_fbr-line.price-rubl <= 0 )
     1694               and buf_fbr-line.fact-qnty <> 0
     1695               and buf_fbr-line.rsrv-qnty <> ?
     1696               and buf_fbr-doc.is-free    = no
     1697               and buf_fbr-doc.status_    = 'разрешен':U
     1698               then do:
     1699   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1700   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1701     (input  buf_fbr-line.artic
     1702     ,input  buf_fbr-line.prod-type
     1703     ,input  buf_fbr-line.prod-code
     1704     ,output v-gds-name
     1705     ) no-error .
     1706                   if error-status :error
     1707                   then do:
     1708                       assign
     1709                           v-gds-name = ""
     1710                       .
     1711                   end.
     1712                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     1713                                                 ,vss-description
     1714                                                 ,buf_fbr-doc.doc-code
     1715                                                 ,chr(10)
     1716                                                 ,buf_fbr-line.recipe-code
     1717                                                 ,buf_fbr-line.artic
     1718                                                 ,v-gds-name).
     1719               end.
     1720               assign
     1721                   buf_temp_fbrlib_recipe.count-write-off             = buf_temp_fbrlib_recipe.count-write-off + 1
     1722                   buf_temp_fbrlib_recipe.qnty-write-off              = buf_temp_fbrlib_recipe.qnty-write-off
     1723                                                                   + buf_fbr-line.fact-qnty
     1724                   buf_temp_fbrlib_recipe.sum-write-off-sale          = buf_temp_fbrlib_recipe.sum-write-off-sale
     1725                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     1726               .
     1727               if buf_fbr-line.is-waste = no
     1728               then do:
     1729                   assign
     1730                       buf_temp_fbrlib_recipe.sum-write-off-cost-base     = buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1731                                                                       + buf_fbr-line.price-sum-base
     1732                       buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1733                                                                       + buf_fbr-line.price-sum-rubl
     1734                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1735                                                                       + buf_fbr-line.price-sum-vat-base
     1736                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1737                                                                       + buf_fbr-line.price-sum-vat-rubl
     1738                   .
     1739               end.
     1740           end.
     1741           if buf_fbr-doc.status_    = 'разрешен':U
     1742           and ( abs( buf_temp_fbrlib_recipe.sum-write-off-cost-base     - buf_temp_fbrlib_recipe.sum-income-cost-base     ) > 0.01
     1743           or abs( buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     - buf_temp_fbrlib_recipe.sum-income-cost-rubl     ) > 0.01
     1744           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base - buf_temp_fbrlib_recipe.sum-income-vat-cost-base ) > 0.01
     1745           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl - buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl ) > 0.01
     1746               )
     1747           then do:
     1748            undo, return error
     1749               substitute("В документе пр-ва &1 Не совпадают суммы учетных цен для списанного и оприходованного по рецепту товара.&2" +
     1750                           "Рецепт: &3&2&4&4по списанному товару&4по оприходованному товару&2"  +
     1751                           "Сумма в баз.вал.&4&5&4&4&6&2" +
     1752                           "Сумма в &9.&4&7&4&4&8&2"
     1753                          , buf_fbr-doc.doc-code
     1754                          , chr(10)
     1755                          , buf_temp_fbrlib_recipe.recipe-code
     1756                          , chr(9)
     1757                          , buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1758                          , buf_temp_fbrlib_recipe.sum-income-cost-base
     1759                          , buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1760                          , buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1761                          , "руб"
     1762                          )
     1763              +
     1764              substitute("НДС в баз.вал.&1&2&1&1&3&4" +
     1765                         "НДС в &7.&1&5&1&1&6&4"
     1766                        ,  chr(9)
     1767                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1768                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1769                        ,chr(10)
     1770                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1771                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1772                        ,"руб"
     1773                        )       .
     1774           end.
     1775       end.
     1776   end.
     1777   end procedure.
     1778   procedure fbrlib-fill-sum-fbr-doc :
     1779   do
     1780   on error undo, return error
     1781   :
     1782   define input parameter p-fbr-doc-recid  as recid        no-undo.
     1783   define input parameter p-mode           as character    no-undo.
     1784       define variable vss-description as character init "fbrlib-fill-sum-fbr-doc: "  no-undo.
     1785       define buffer buf_fbr-doc           for ub.fbr-doc.
     1786       define buffer buf_fbr-line          for ub.fbr-line.
     1787       define buffer buf_temp_fbrlib_recipe   for temp_fbrlib_recipe.
     1788       define variable v-in-count          as integer       no-undo.
     1789       define variable v-out-count         as integer       no-undo.
     1790       find first buf_fbr-doc exclusive-lock
     1791            where recid ( buf_fbr-doc ) = p-fbr-doc-recid
     1792       .
     1793       find first buf_temp_fbrlib_recipe no-error.
     1794       if not available buf_temp_fbrlib_recipe
     1795       then do:
     1796           run fbrlib-fill-and-check-temp_fbrlib_recipe in this-procedure (
     1797               input buf_fbr-doc.doc-code
     1798           ) no-error.
     1799           if error-status :error
     1800           then do:
     1801               undo, return error substitute("&1 Ошибка расчета сумм при заполнении шапки документа производства.&2&3&2&4"
     1802                                              , vss-description
     1803                                              , chr(10)
     1804                                              , error-status:get-message(1)
     1805                                              , return-value ).
     1806           end.
     1807       end.
     1808       assign
     1809           v-in-count                  = 0
     1810           buf_fbr-doc.in-qnty         = 0
     1811           buf_fbr-doc.in-sale         = 0
     1812           buf_fbr-doc.in-base         = 0
     1813           buf_fbr-doc.in-rubl         = 0
     1814           buf_fbr-doc.in-vat-base     = 0
     1815           buf_fbr-doc.in-vat-rubl     = 0
     1816           v-out-count                 = 0
     1817           buf_fbr-doc.out-qnty        = 0
     1818           buf_fbr-doc.out-sale        = 0
     1819           buf_fbr-doc.out-base        = 0
     1820           buf_fbr-doc.out-rubl        = 0
     1821           buf_fbr-doc.out-vat-base    = 0
     1822           buf_fbr-doc.out-vat-rubl    = 0
     1823       .
     1824       for each buf_temp_fbrlib_recipe
     1825       :
     1826           assign
     1827               v-in-count                  = v-in-count                + buf_temp_fbrlib_recipe.count-income
     1828               buf_fbr-doc.in-qnty         = buf_fbr-doc.in-qnty       + buf_temp_fbrlib_recipe.qnty-income
     1829               buf_fbr-doc.in-sale         = buf_fbr-doc.in-sale       + buf_temp_fbrlib_recipe.sum-income-sale
     1830               buf_fbr-doc.in-base         = buf_fbr-doc.in-base       + buf_temp_fbrlib_recipe.sum-income-cost-base
     1831               buf_fbr-doc.in-rubl         = buf_fbr-doc.in-rubl       + buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1832               buf_fbr-doc.in-vat-base     = buf_fbr-doc.in-vat-base   + buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1833               buf_fbr-doc.in-vat-rubl     = buf_fbr-doc.in-vat-rubl   + buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1834               v-out-count                 = v-out-count               + buf_temp_fbrlib_recipe.count-write-off
     1835               buf_fbr-doc.out-qnty        = buf_fbr-doc.out-qnty      + buf_temp_fbrlib_recipe.qnty-write-off
     1836               buf_fbr-doc.out-sale        = buf_fbr-doc.out-sale      + buf_temp_fbrlib_recipe.sum-write-off-sale
     1837               buf_fbr-doc.out-base        = buf_fbr-doc.out-base      + buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1838               buf_fbr-doc.out-rubl        = buf_fbr-doc.out-rubl      + buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1839               buf_fbr-doc.out-vat-base    = buf_fbr-doc.out-vat-base  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1840               buf_fbr-doc.out-vat-rubl    = buf_fbr-doc.out-vat-rubl  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1841           .
     1842       end.
     1843       if ( abs (buf_fbr-doc.in-rubl - buf_fbr-doc.out-rubl) <= 0.01
     1844       and   abs (buf_fbr-doc.in-base - buf_fbr-doc.out-base) <= 0.01 )
     1845       or p-mode <> 'факт':U
     1846       then do:
     1847           if substring( buf_fbr-doc.PS, 1, 1 ) = "@"
     1848           then do:
     1849               assign
     1850                   buf_fbr-doc.PS = "@ Строк полученных товаров : "
     1851                                   + string( v-out-count, ">>>,>>9" )
     1852                                   + chr(10) + "Строк исходных товаров : "
     1853                                   + string( v-in-count, ">>>,>>9" )
     1854               .
     1855           end.
     1856       end.
     1857       else do:
     1858         undo, return error substitute("В док-те пр-ва &1 не совпадают суммы списанных и оприходованных товаров.&2" +
     1859                                       "Сумма списанных товаров в &3 - &4&2" +
     1860                                       "Сумма оприходованных товаров в &3 - &5&2" +
     1861                                       "Сумма оприходованных товаров в &3 - &6&2" +
     1862                                       "Сумма списанных товаров в баз.вал. - &7&2" +
     1863                                       "Сумма оприходованных товаров в баз.вал. - &8&2"
     1864                                       , buf_fbr-doc.doc-code
     1865                                       , chr(10)
     1866                                       , "рублях"
     1867                                       , round( buf_fbr-doc.out-rubl, 2 )
     1868                                       , round( buf_fbr-doc.in-rubl,  2 )
     1869                                       , round( buf_fbr-doc.in-rubl,  2 )
     1870                                       , round( buf_fbr-doc.out-base, 2 )
     1871                                       , round( buf_fbr-doc.in-base,  2 )).
     1872       end.
     1873   end.
     1874   end procedure.
     1875   procedure fbrlib-calc-prices :
     1876   do
     1877   on error undo, return error
     1878   :
     1879   define input parameter p-fbr-line-recid as recid        no-undo.
     1880   define input parameter p-price-obj-type as character    no-undo.
     1881   define input parameter p-price-obj-code as integer      no-undo.
     1882   define output parameter p-current-price as decimal      no-undo.
     1883       define variable v-void          as decimal       no-undo.
     1884       define variable v-void-char     as character     no-undo.
     1885       define variable v-gds-code      as integer       no-undo.
     1886       define variable v-b-code        as integer       no-undo.
     1887       define buffer buf_fbr-doc   for ub.fbr-doc.
     1888       define buffer buf_fbr-line  for ub.fbr-line.
     1889       define buffer buf_gds-prt   for ub.gds-prt.
     1890       define buffer buf_bar-code  for ub.bar-code.
     1891       find first buf_fbr-line no-lock
     1892           where recid( buf_fbr-line ) = p-fbr-line-recid
     1893       .
     1894   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1895   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     1896     (input  buf_fbr-line.artic
     1897     ,input  buf_fbr-line.prod-type
     1898     ,input  buf_fbr-line.prod-code
     1899     ,output v-gds-code
     1900     ) no-error .
     1901       if error-status :error
     1902       then do:
     1903         undo, return error substitute("&1 &2 &3&4Ошибка определения кода товара (артикул &7).&4&5&4&6"
     1904                                         ,vss-workfile
     1905                                         ,vss-revision
     1906                                         ,vss-description
     1907                                         ,chr(10)
     1908                                         , error-status:get-message(1)
     1909                                         , return-value
     1910                                         , buf_fbr-line.artic
     1911                                         ).
     1912       end.
     1913   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1914     (input  v-gds-code
     1915     ,input  ?
     1916     ,output v-b-code
     1917     ) no-error .
     1918       if error-status :error
     1919       then do:
     1920         undo, return error substitute("&1 &2 &3&4Ошибка определения основного бар-кода товара (код товара) &7.&4&5&4&6"
     1921                                         ,vss-workfile
     1922                                         ,vss-revision
     1923                                         ,vss-description
     1924                                         ,chr(10)
     1925                                         , error-status:get-message(1)
     1926                                         , return-value
     1927                                         , v-gds-code
     1928                                         ).
     1929       end.
     1930       if buf_fbr-line.is-calc = no
     1931       then do:
     1932   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1933   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1934     (input  p-price-obj-type
     1935     ,input  p-price-obj-code
     1936     ,input  v-b-code
     1937     ,input  0
     1938     ,input  0
     1939     ,output v-void-char
     1940     ,output p-current-price
     1941     ,output v-void
     1942     ,output v-void
     1943     ) no-error .
     1944           if error-status :error
     1945           then do:
     1946             undo, return error substitute("&1 &2 &3&4Ошибка определения продажной цены основного бар-кода товара (код товара) &7.&4&5&4&6"
     1947                                             ,vss-workfile
     1948                                             ,vss-revision
     1949                                             ,vss-description
     1950                                             ,chr(10)
     1951                                             , error-status:get-message(1)
     1952                                             , return-value
     1953                                             , v-gds-code
     1954                                             ).
     1955           end.
     1956       end.
     1957       else do:
     1958           assign
     1959               p-current-price = buf_fbr-line.price-sale
     1960           .
     1961       end.
     1962   end.
     1963   end procedure.
     1964   procedure fbrlib-put-in-order-recipe :
     1965   do
     1966   on error undo, return error
     1967   :
     1968   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     1969       define variable v-recipe-counter    as integer          no-undo.
     1970       define variable v-recipe-amount     as integer init 0   no-undo.
     1971       define variable v-child-counter     as integer          no-undo.
     1972       define variable v-is-call-cycle     as logical          no-undo.
     1973       define variable v-str as character     no-undo.
     1974       define buffer buf_in_fbr-line       for ub.fbr-line.
     1975       define buffer buf_dress_fbr-line    for ub.fbr-line.
     1976       define buffer buf_fbr-line          for ub.fbr-line.
     1977       define buffer buf_recipe-gds        for ub.recipe-gds.
     1978       define buffer buf_recipe            for ub.recipe.
     1979       for each temp_recipe-childs-qnty
     1980       :
     1981           delete temp_recipe-childs-qnty.
     1982       end.
     1983       for each temp_recipe-childs
     1984       :
     1985           delete temp_recipe-childs.
     1986       end.
     1987       for each temp_recipe-order
     1988       :
     1989           delete temp_recipe-order.
     1990       end.
     1991       for each buf_fbr-line no-lock
     1992          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     1993       on error undo, return error
     1994       :
     1995           find first temp_recipe-childs-qnty
     1996                where temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     1997           no-error.
     1998           if not available temp_recipe-childs-qnty
     1999           then do:
     2000               create temp_recipe-childs-qnty.
     2001               assign
     2002                   v-recipe-amount                     = v-recipe-amount + 1
     2003                   temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     2004                   temp_recipe-childs-qnty.order       = v-recipe-amount
     2005                   temp_recipe-childs-qnty.childs-qnty = 0
     2006                   v-child-counter                     = 0
     2007               .
     2008           end.
     2009       end.
     2010       for each buf_in_fbr-line no-lock
     2011          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     2012            and buf_in_fbr-line.trn-type = 'спи':U
     2013       on error undo, return error
     2014       :
     2015           for each buf_dress_fbr-line no-lock
     2016              where buf_dress_fbr-line.doc-code    = p-fbr-doc-doc-code
     2017                and buf_dress_fbr-line.trn-type    = 'при':U
     2018                and buf_dress_fbr-line.artic       = buf_in_fbr-line.artic
     2019                and buf_dress_fbr-line.prod-type   = buf_in_fbr-line.prod-type
     2020                and buf_dress_fbr-line.prod-code   = buf_in_fbr-line.prod-code
     2021           on error undo, return error
     2022           :
     2023               find first buf_recipe no-lock
     2024                    where buf_recipe.recipe-code = buf_dress_fbr-line.recipe-code
     2025               .
     2026               if buf_in_fbr-line.is-comp = yes
     2027               then do:
     2028                   find last temp_recipe-childs-qnty
     2029                       where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     2030                   .
     2031                   assign
     2032                       temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     2033                   .
     2034                   create temp_recipe-childs.
     2035                   assign
     2036                       temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     2037                       temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     2038                       temp_recipe-childs.child-recipe-code    = buf_dress_fbr-line.recipe-code
     2039                   .
     2040               end.
     2041               else do:
     2042               end.
     2043           end.
     2044       end.
     2045       for each buf_in_fbr-line no-lock
     2046          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     2047            and buf_in_fbr-line.trn-type = 'при':U
     2048       on error undo, return error
     2049       :
     2050           find first buf_recipe no-lock
     2051                where buf_recipe.recipe-code = buf_in_fbr-line.recipe-code
     2052           no-error.
     2053           if buf_in_fbr-line.is-comp = no
     2054           then do:
     2055           end.
     2056           else do:
     2057               for each buf_recipe-gds no-lock
     2058               where buf_recipe-gds.recipe-code = buf_in_fbr-line.recipe-code
     2059               :
     2060                   for each buf_fbr-line no-lock
     2061                   where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     2062                       and buf_fbr-line.trn-type    = 'при':U
     2063                       and buf_fbr-line.artic       = buf_recipe-gds.artic
     2064                       and buf_fbr-line.prod-type   = buf_recipe-gds.prod-type
     2065                       and buf_fbr-line.prod-code   = buf_recipe-gds.prod-code
     2066                   on error undo, return error
     2067                   :
     2068                       find first buf_recipe no-lock
     2069                            where buf_recipe.recipe-code = buf_fbr-line.recipe-code
     2070                       .
     2071                       if buf_recipe.recipe-type = 'разделка':U
     2072                       then do:
     2073                       end.
     2074                       else do:
     2075                           find last temp_recipe-childs-qnty
     2076                               where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     2077                           .
     2078                           assign
     2079                               temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     2080                           .
     2081                           create temp_recipe-childs.
     2082                           assign
     2083                               temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     2084                               temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     2085                               temp_recipe-childs.child-recipe-code    = buf_fbr-line.recipe-code
     2086                           .
     2087                       end.
     2088                   end.
     2089               end.
     2090           end.
     2091       end.
     2092       for each temp_recipe-order
     2093       on error undo, return error
     2094       :
     2095           delete temp_recipe-order.
     2096       end.
     2097       assign
     2098           v-fbrlib-recipe-order = 0
     2099       .
     2100       do v-recipe-counter = 1 to v-recipe-amount
     2101       on error undo, return error
     2102       :
     2103           run fbrlib-add-recipe-in-tmp-order in this-procedure (
     2104                 input v-recipe-counter
     2105               , input 0
     2106               , output v-is-call-cycle
     2107           ).
     2108           if v-is-call-cycle = yes
     2109           then do:
     2110               message
     2111                       "Достигнут максимальный уровень вложенности рецептов."
     2112                   skip(1)
     2113                   skip "Невозможно упорядочить рецепты."
     2114                   skip(1)
     2115                   skip "Необходимо изменить структуру рецептов,"
     2116                   skip "используемых при формировании"
     2117                   skip "данного документа производства."
     2118               view-as alert-box error
     2119               title "Невозможно рассчитать документ производства".
     2120               for each temp_recipe-childs-qnty
     2121               :
     2122                   delete temp_recipe-childs-qnty.
     2123               end.
     2124               for each temp_recipe-childs
     2125               :
     2126                   delete temp_recipe-childs.
     2127               end.
     2128               for each temp_recipe-order
     2129               :
     2130                   delete temp_recipe-order.
     2131               end.
     2132               for each temp_recipe-order
     2133               on error undo, return error
     2134               :
     2135                   delete temp_recipe-order.
     2136               end.
     2137               for each temp_fbrlib_recipe
     2138               on error undo, return error
     2139               :
     2140                   delete temp_recipe-order.
     2141               end.
     2142               undo, return error.
     2143           end.
     2144       end.
     2145   end.
     2146   end procedure.
     2147   procedure fbrlib-add-recipe-in-tmp-order :
     2148   do
     2149   on error undo, return error
     2150   :
     2151   define input parameter p-order              as integer      no-undo.
     2152   define input parameter p-call-counter       as integer      no-undo.
     2153   define output parameter p-is-call-cycle     as logical      no-undo.
     2154       define variable v-nodes-counter     as integer       no-undo.
     2155       define buffer buf_c_temp_recipe-childs-qnty for temp_recipe-childs-qnty.
     2156       define buffer buf_temp_recipe-childs-qnty   for temp_recipe-childs-qnty.
     2157       define buffer buf_temp_recipe-childs        for temp_recipe-childs     .
     2158       define buffer buf_temp_recipe-order         for temp_recipe-order.
     2159       assign
     2160           p-call-counter = p-call-counter + 1
     2161       .
     2162       if p-call-counter > 50
     2163       then do:
     2164           assign
     2165               p-is-call-cycle = yes
     2166           .
     2167       end.
     2168       else do:
     2169           find first buf_temp_recipe-childs-qnty
     2170                where buf_temp_recipe-childs-qnty.order = p-order
     2171           .
     2172           find first buf_temp_recipe-order
     2173                where buf_temp_recipe-order.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     2174           no-error.
     2175           if not available buf_temp_recipe-order
     2176           then do:
     2177               do v-nodes-counter = 1 to buf_temp_recipe-childs-qnty.childs-qnty
     2178               :
     2179                   find first buf_temp_recipe-childs
     2180                        where buf_temp_recipe-childs.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     2181                          and buf_temp_recipe-childs.child-code  = v-nodes-counter
     2182                   .
     2183                   find first buf_c_temp_recipe-childs-qnty
     2184                        where buf_c_temp_recipe-childs-qnty.recipe-code = buf_temp_recipe-childs.child-recipe-code
     2185                   .
     2186                   run fbrlib-add-recipe-in-tmp-order in this-procedure (
     2187                         input buf_c_temp_recipe-childs-qnty.order
     2188                       , input p-call-counter
     2189                       , output p-is-call-cycle
     2190                   ).
     2191                   if p-is-call-cycle = yes
     2192                   then do:
     2193                       return.
     2194                   end.
     2195               end.
     2196               assign
     2197                   v-fbrlib-recipe-order = v-fbrlib-recipe-order + 1
     2198               .
     2199               create buf_temp_recipe-order.
     2200               assign
     2201                   buf_temp_recipe-order.recipe-code   = buf_temp_recipe-childs-qnty.recipe-code
     2202                   buf_temp_recipe-order.order         = v-fbrlib-recipe-order
     2203               .
     2204           end.
     2205       end.
     2206   end.
     2207   end procedure.
     2208   procedure fbrlib-get-trn-type :
     2209   define input parameter p-recipe-code    as character    no-undo.
     2210   define input parameter p-goods-recid    as recid        no-undo.
     2211   define input parameter p-is-integration as logical      no-undo.
     2212   define output parameter p-is-comp       as logical      no-undo.
     2213   define output parameter p-trn-type      as character    no-undo.
     2214   define buffer buf_recipe    for ub.recipe.
     2215   define buffer buf_goods     for ub.goods.
     2216   do
     2217   for buf_recipe
     2218     , buf_goods
     2219   on error undo, return error
     2220   :
     2221       find first buf_goods no-lock
     2222            where recid( buf_goods ) = p-goods-recid
     2223       .
     2224       find first buf_recipe no-lock
     2225            where buf_recipe.recipe-code = p-recipe-code
     2226       no-error.
     2227       if not available buf_recipe
     2228       then do:
     2229           assign
     2230               p-is-comp = no
     2231               p-trn-type = "":U
     2232           .
     2233           undo, return.
     2234       end.
     2235       if  buf_recipe.artic        = buf_goods.artic
     2236       and buf_recipe.prod-type    = buf_goods.prod-type
     2237       and buf_recipe.prod-code    = buf_goods.prod-code
     2238       then do:
     2239           assign
     2240               p-is-comp = yes
     2241           .
     2242       end.
     2243       else do:
     2244           assign
     2245               p-is-comp = no
     2246           .
     2247       end.
     2248       case buf_recipe.recipe-type
     2249       :
     2250           when 'производство':U
     2251           then do:
     2252               if p-is-comp = yes
     2253               then do:
     2254                   assign
     2255                       p-trn-type = 'при':U
     2256                   .
     2257               end.
     2258               else do:
     2259                   assign
     2260                       p-trn-type = 'спи':U
     2261                   .
     2262               end.
     2263           end.
     2264           when 'альтернатива':U
     2265           then do:
     2266               if p-is-comp = yes
     2267               then do:
     2268                   assign
     2269                       p-trn-type = 'при':U
     2270                   .
     2271               end.
     2272               else do:
     2273                   assign
     2274                       p-trn-type = 'спи':U
     2275                   .
     2276               end.
     2277           end.
     2278           when 'разделка':U
     2279           then do:
     2280               if p-is-comp = no
     2281               then do:
     2282                   assign
     2283                       p-trn-type = 'при':U
     2284                   .
     2285               end.
     2286               else do:
     2287                   assign
     2288                       p-trn-type = 'спи':U
     2289                   .
     2290               end.
     2291           end.
     2292           when 'комплектация':U
     2293           then do:
     2294               if p-is-integration = ?
     2295               then do:
     2296                   message
     2297                       "Выберите тип операции по рецепту комплектации:"
     2298                       skip (2) "YES - комплектация"
     2299                       skip     "NO - разукомплектация"
     2300                   view-as alert-box question
     2301                   buttons YES-NO
     2302                   update p-is-integration.
     2303               end.
     2304               if p-is-integration = yes
     2305               then do:
     2306                   if p-is-comp = yes
     2307                   then do:
     2308                       assign
     2309                           p-trn-type = 'при':U
     2310                       .
     2311                   end.
     2312                   else do:
     2313                       assign
     2314                           p-trn-type = 'спи':U
     2315                       .
     2316                   end.
     2317               end.
     2318               else do:
     2319                   if p-is-comp = yes
     2320                   then do:
     2321                       assign
     2322                           p-trn-type = 'спи':U
     2323                       .
     2324                   end.
     2325                   else do:
     2326                       assign
     2327                           p-trn-type = 'при':U
     2328                       .
     2329                   end.
     2330               end.
     2331           end.
     2332       end case.
     2333   end.
     2334   end procedure.
     2335   procedure fbrlib-get-mark :
     2336   define input parameter p-recipe-code    as character    no-undo.
     2337   define output parameter p-mark          as logical    no-undo.
     2338   define buffer buf_goods-attr     for ub.goods-attr.
     2339   define buffer buf_recipe-gds for ub.recipe-gds .
     2340       for each buf_recipe-gds no-lock where buf_recipe-gds.recipe-code = p-recipe-code,
     2341            first buf_goods-attr no-lock where buf_goods-attr.gds-code = buf_recipe-gds.gds-code and
     2342                                               buf_goods-attr.attr-code = 'mark-type':U:
     2343            if buf_goods-attr.attr-value <> "" and buf_goods-attr.attr-value <> "not-type" then do:
     2344               p-mark = true .
     2345               return .
     2346            end.
     2347       end.
     2348   end procedure.
     2349   procedure fbrlib-check-temp-tables :
     2350   do
     2351   on error undo, return error
     2352   :
     2353   define input parameter p-title  as character    no-undo.
     2354       define variable v-str               as character        no-undo.
     2355       assign
     2356           v-str = v-str + chr(10) + "temp_recipe-childs-qnty:" + chr(10)
     2357       .
     2358       for each temp_recipe-childs-qnty
     2359       on error undo, return error
     2360       :
     2361           assign
     2362               v-str   = v-str + string( temp_recipe-childs-qnty.recipe-code )
     2363                       + "   " + string( temp_recipe-childs-qnty.childs-qnty )
     2364                       + "   " + string( temp_recipe-childs-qnty.order )
     2365                       + chr(10)
     2366           .
     2367       end.
     2368       assign
     2369           v-str = v-str + "temp_recipe-childs:" + chr(10)
     2370       .
     2371       for each temp_recipe-childs
     2372       on error undo, return error
     2373       :
     2374           assign
     2375               v-str   = v-str + string( temp_recipe-childs.recipe-code )
     2376                       + "   " + string( temp_recipe-childs.child-code )
     2377                       + "   " + string( temp_recipe-childs.child-recipe-code )
     2378                       + chr(10)
     2379           .
     2380       end.
     2381       assign
     2382           v-str = v-str + chr(10) + "temp_recipe-order:" + chr(10)
     2383       .
     2384       for each temp_recipe-order
     2385       on error undo, return error
     2386       :
     2387           assign
     2388               v-str   = v-str + string( temp_recipe-order.recipe-code )
     2389                       + "   " + string( temp_recipe-order.order )
     2390                       + chr(10)
     2391           .
     2392       end.
     2393       assign
     2394           v-str = v-str + chr(10) + "temp_fbrlib_recipe:" + chr(10)
     2395       .
     2396       run writelog in this-procedure ( input "fbr.log", input 0, input p-title ).
     2397       run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     2398       for each temp_fbrlib_recipe
     2399       on error undo, return error
     2400       :
     2401           assign
     2402               v-str   = "recipe-code: "                   + string( temp_fbrlib_recipe.recipe-code                 )
     2403                       + "   " + "count-income: "                  + string( temp_fbrlib_recipe.count-income                )
     2404                       + "   " + "qnty-income: "                   + string( temp_fbrlib_recipe.qnty-income                 )
     2405                       + "   " + "sum-income-sale: "               + string( temp_fbrlib_recipe.sum-income-sale             )
     2406                       + "   " + "sum-income-cost-base: "          + string( temp_fbrlib_recipe.sum-income-cost-base        )
     2407                       + "   " + "sum-income-cost-rubl: "          + string( temp_fbrlib_recipe.sum-income-cost-rubl        )
     2408                       + "   " + "sum-income-vat-cost-base: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-base    )
     2409                       + "   " + "sum-income-vat-cost-rubl: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-rubl    )
     2410                       + "   " + "count-write-off: "               + string( temp_fbrlib_recipe.count-write-off             )
     2411                       + "   " + "qnty-write-off: "                + string( temp_fbrlib_recipe.qnty-write-off              )
     2412                       + "   " + "sum-write-off-sale: "            + string( temp_fbrlib_recipe.sum-write-off-sale          )
     2413                       + "   " + "sum-write-off-cost-base: "       + string( temp_fbrlib_recipe.sum-write-off-cost-base     )
     2414                       + "   " + "sum-write-off-cost-rubl: "       + string( temp_fbrlib_recipe.sum-write-off-cost-rubl     )
     2415                       + "   " + "sum-write-off-vat-cost-base: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-base )
     2416                       + "   " + "sum-write-off-vat-cost-rubl: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-rubl )
     2417                       + chr(10)
     2418           .
     2419           run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     2420       end.
     2421   end.
     2422   end procedure.
     2423   procedure fbrlib-s-coeff-value :
     2424   define input  parameter p-gds-code    as integer        no-undo.
     2425   define input  parameter p-date        as date           no-undo.
     2426   define input  parameter p-obj-type    as character      no-undo.
     2427   define input  parameter p-obj-code    as integer        no-undo.
     2428   define output parameter p-coeff-value as decimal        no-undo.
     2429   define variable vss-description as character init "fbrlib-s-coeff-value-01: определяет значение сезонного коэффициента" no-undo.
     2430       define variable v-date          as date         no-undo.
     2431       define variable v-host-code     as integer      no-undo.
     2432       define buffer buf_goods       for ub.goods.
     2433       define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     2434       define buffer buf_clients     for ub.clients.
     2435       define buffer buf_s-coeff     for ub.s-coeff.
     2436   do
     2437   for buf_goods
     2438     , buf_fbr-gds-obj
     2439     , buf_clients
     2440     , buf_s-coeff
     2441   on error undo, return error return-value
     2442   :
     2443       find first buf_goods no-lock
     2444            where buf_goods.gds-code = p-gds-code
     2445       no-error .
     2446       if not available buf_goods
     2447       then do:
     2448          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден товар с кодом &1", p-gds-code).
     2449       end.
     2450       find first buf_clients no-lock
     2451            where buf_clients.obj-type = p-obj-type
     2452              and buf_clients.obj-code = p-obj-code
     2453       no-error.
     2454       if not available buf_clients
     2455       then do:
     2456          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден объект &1&2", p-obj-type, p-obj-code).
     2457       end.
     2458       assign
     2459           v-date = date(month(p-date), day(p-date), Year(01/01/1996))
     2460       .
     2461       find first buf_fbr-gds-obj no-lock
     2462            where buf_fbr-gds-obj.gds-code = p-gds-code
     2463              and buf_fbr-gds-obj.obj-type = p-obj-type
     2464              and buf_fbr-gds-obj.obj-code = p-obj-code
     2465       no-error.
     2466       if not available buf_fbr-gds-obj
     2467       or buf_fbr-gds-obj.is-season = no
     2468       then do:
     2469           assign
     2470               p-coeff-value = 0
     2471           .
     2472           return.
     2473       end.
     2474   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2475   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2476     (input  p-obj-type
     2477     ,input  p-obj-code
     2478     ,output v-host-code
     2479     )  .
     2480       find last buf_s-coeff no-lock
     2481           where buf_s-coeff.gds-code = p-gds-code
     2482             and buf_s-coeff.host-code = v-host-code
     2483             and buf_s-coeff.obj-type = p-obj-type
     2484             and buf_s-coeff.obj-code = p-obj-code
     2485             and buf_s-coeff.s-date <= v-date
     2486       no-error.
     2487       if available buf_s-coeff
     2488       then do:
     2489           assign
     2490               p-coeff-value = buf_s-coeff.coeff-value
     2491           .
     2492           return.
     2493       end.
     2494       find last buf_s-coeff no-lock
     2495           where buf_s-coeff.gds-code = p-gds-code
     2496             and buf_s-coeff.host-code = v-host-code
     2497             and buf_s-coeff.obj-type = "":U
     2498             and buf_s-coeff.obj-code = 0
     2499             and buf_s-coeff.s-date <= v-date
     2500       no-error.
     2501       if available buf_s-coeff
     2502       then do:
     2503           assign
     2504               p-coeff-value = buf_s-coeff.coeff-value
     2505           .
     2506           return.
     2507       end.
     2508       find last buf_s-coeff no-lock
     2509           where buf_s-coeff.gds-code = p-gds-code
     2510             and buf_s-coeff.host-code = 0
     2511             and buf_s-coeff.obj-type = "":U
     2512             and buf_s-coeff.obj-code = 0
     2513             and buf_s-coeff.s-date <= v-date
     2514       no-error.
     2515       if available buf_s-coeff
     2516       then do:
     2517           assign
     2518               p-coeff-value = buf_s-coeff.coeff-value
     2519           .
     2520       end.
     2521       else do:
     2522           assign
     2523               p-coeff-value = 0
     2524           .
     2525       end.
     2526   end.
     2527   end procedure.
     2528   procedure fbrlib_create-fbr-recipe-gds :
     2529   define input parameter p-doc-code         as character      no-undo.
     2530   define input parameter p-recipe-code      as character      no-undo.
     2531   define input parameter p-prod-type        as character      no-undo.
     2532   define input parameter p-prod-code        as integer        no-undo.
     2533   define input parameter p-artic            as character      no-undo.
     2534   define input parameter p-gds-code         as integer        no-undo.
     2535   define input parameter p-is-waste         as logical        no-undo.
     2536   define input parameter p-proc-number      as integer        no-undo.
     2537   define input parameter p-obj-date         as date           no-undo.
     2538   define input parameter p-obj-type         as character      no-undo.
     2539   define input parameter p-obj-code         as integer        no-undo.
     2540   define input parameter p-calc-method      as decimal        no-undo.
     2541   define input parameter p-coeff-waste      as decimal        no-undo.
     2542   define input parameter p-orig-qnty        as decimal        no-undo.
     2543   define input parameter p-orig-brutto-qnty as decimal        no-undo.
     2544       define variable v-coeff-season  as decimal      no-undo.
     2545       define variable v-void-decimal  as decimal      no-undo.
     2546       define variable v-void-integer  as integer      no-undo.
     2547       define variable v-recipe-type   as character    no-undo.
     2548       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     2549       define buffer buf_goods             for ub.goods.
     2550       define buffer buf_recipe            for ub.recipe.
     2551   do
     2552   for buf_fbr-recipe-gds
     2553     , buf_recipe
     2554     , buf_goods
     2555   on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2556   :
     2557       find first buf_fbr-recipe-gds exclusive-lock
     2558            where buf_fbr-recipe-gds.doc-code    = p-doc-code
     2559              and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     2560              and buf_fbr-recipe-gds.prod-type   = p-prod-type
     2561              and buf_fbr-recipe-gds.prod-code   = p-prod-code
     2562              and buf_fbr-recipe-gds.artic       = p-artic
     2563       no-error.
     2564       if not available buf_fbr-recipe-gds
     2565       then do:
     2566           create buf_fbr-recipe-gds.
     2567           assign
     2568               buf_fbr-recipe-gds.doc-code           = p-doc-code
     2569               buf_fbr-recipe-gds.recipe-code        = p-recipe-code
     2570               buf_fbr-recipe-gds.prod-type          = p-prod-type
     2571               buf_fbr-recipe-gds.prod-code          = p-prod-code
     2572               buf_fbr-recipe-gds.artic              = p-artic
     2573               buf_fbr-recipe-gds.gds-code           = p-gds-code
     2574               buf_fbr-recipe-gds.is-waste           = p-is-waste
     2575               buf_fbr-recipe-gds.proc-number        = p-proc-number
     2576               buf_fbr-recipe-gds.recipe-qnty        = p-orig-qnty
     2577               buf_fbr-recipe-gds.recipe-brutto-qnty = p-orig-brutto-qnty
     2578           .
     2579           find first buf_goods no-lock
     2580                where buf_goods.prod-type = buf_fbr-recipe-gds.prod-type
     2581                  and buf_goods.prod-code = buf_fbr-recipe-gds.prod-code
     2582                  and buf_goods.artic     = buf_fbr-recipe-gds.artic
     2583           .
     2584           run fbrlib-s-coeff-value in this-procedure (
     2585                 input buf_goods.gds-code
     2586               , input p-obj-date
     2587               , input p-obj-type
     2588               , input p-obj-code
     2589               , output v-coeff-season
     2590           ) no-error.
     2591           if error-status:error
     2592           then do:
     2593               return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
     2594           end.
     2595           assign
     2596               buf_fbr-recipe-gds.qnty         = p-orig-qnty
     2597               buf_fbr-recipe-gds.coeff-value  = v-coeff-season
     2598               buf_fbr-recipe-gds.coeff-waste  = p-coeff-waste
     2599           .
     2600           run fbrlib-get-recipe-type in this-procedure (
     2601                 input buf_fbr-recipe-gds.doc-code
     2602               , input buf_fbr-recipe-gds.recipe-code
     2603               , output v-recipe-type
     2604           ).
     2605           if v-recipe-type <> 'производство':U
     2606           then do:
     2607               assign
     2608                   buf_fbr-recipe-gds.coeff-value  = 0
     2609                   buf_fbr-recipe-gds.coeff-waste  = 0
     2610                   buf_fbr-recipe-gds.calc-method  = 1
     2611                   buf_fbr-recipe-gds.brutto-qnty  = buf_fbr-recipe-gds.qnty
     2612               .
     2613           end.
     2614           else do:
     2615               run fbrlib-calc-brutto in this-procedure (
     2616                     input v-recipe-type
     2617                   , input buf_fbr-recipe-gds.qnty
     2618                   , input buf_fbr-recipe-gds.coeff-value
     2619                   , input buf_fbr-recipe-gds.coeff-waste
     2620                   , input 0
     2621                   , input 3
     2622                   , output v-void-decimal
     2623                   , output v-void-decimal
     2624                   , output buf_fbr-recipe-gds.brutto-qnty
     2625                   , output v-void-integer
     2626               ).
     2627               assign
     2628                   buf_fbr-recipe-gds.calc-method  = p-calc-method
     2629               .
     2630               run fbrlib-calc-brutto in this-procedure (
     2631                     input v-recipe-type
     2632                   , input buf_fbr-recipe-gds.qnty
     2633                   , input buf_fbr-recipe-gds.coeff-value
     2634                   , input buf_fbr-recipe-gds.coeff-waste
     2635                   , input buf_fbr-recipe-gds.brutto-qnty
     2636                   , input buf_fbr-recipe-gds.calc-method
     2637                   , output buf_fbr-recipe-gds.qnty
     2638                   , output v-void-decimal
     2639                   , output v-void-decimal
     2640                   , output v-void-integer
     2641               ).
     2642           end.
     2643       end.
     2644   end.
     2645   end procedure.
     2646   procedure fbrlib-set-default-recipe :
     2647   define input parameter p-obj-type   as character    no-undo.
     2648   define input parameter p-obj-code   as integer      no-undo.
     2649   define input parameter p-gds-code   as integer      no-undo.
     2650       define variable v-artic             as character    no-undo.
     2651       define variable v-prod-type         as character    no-undo.
     2652       define variable v-prod-code         as character    no-undo.
     2653       define variable v-recipe-code       as character    no-undo.
     2654       define variable v-fbr-gds-obj-recid as recid        no-undo.
     2655       define variable v-recipe-found      as logical      no-undo.
     2656       define buffer buf_recipe        for ub.recipe.
     2657       define buffer buf_other_recipe  for ub.recipe.
     2658       define buffer buf_goods         for ub.goods.
     2659       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     2660   do
     2661   for buf_recipe
     2662     , buf_goods
     2663     , buf_fbr-gds-obj
     2664   on error undo, return error
     2665   :
     2666       find first buf_goods no-lock
     2667            where buf_goods.gds-code = p-gds-code
     2668       .
     2669       run fbrlib-get-obj-recipe in this-procedure (
     2670             input p-obj-type
     2671           , input p-obj-code
     2672           , input p-gds-code
     2673           , output v-recipe-code
     2674       ).
     2675       if v-recipe-code <> ""
     2676       then do:
     2677           find first buf_recipe no-lock
     2678               where buf_recipe.recipe-code = v-recipe-code
     2679           no-error.
     2680           if not available buf_recipe
     2681           then do:
     2682               assign
     2683                   v-recipe-code = ""
     2684               .
     2685           end.
     2686       end.
     2687       if v-recipe-code = ""
     2688       then do:
     2689           find first buf_fbr-gds-obj exclusive-lock
     2690                where buf_fbr-gds-obj.obj-type = p-obj-type
     2691                  and buf_fbr-gds-obj.obj-code = p-obj-code
     2692                  and buf_fbr-gds-obj.gds-code = p-gds-code
     2693           no-error.
     2694           if not available buf_fbr-gds-obj
     2695           then do:
     2696               run ref/fgdsobj1.p (
     2697                     input-output v-fbr-gds-obj-recid
     2698                   , input 'ДОБАВЛЕНИЕ':U
     2699                   , input no
     2700                   , input p-gds-code
     2701                   , input p-obj-type
     2702                   , input p-obj-code
     2703                   , input 0
     2704                   , input ""
     2705                   , input 0
     2706                   , input no
     2707                   , input no
     2708                   , input no
     2709                   , input no
     2710                   , input no
     2711                   , input no
     2712               ) no-error.
     2713               if error-status:error
     2714               then do:
     2715                   message
     2716                           vss-workfile vss-revision vss-description
     2717                       skip "Ошибка изменения атрибутов товара на объекте"
     2718                       skip return-value
     2719                       skip trim(error-status :get-message(1))
     2720                               trim(error-status :get-message(2))
     2721                               trim(error-status :get-message(3))
     2722                   view-as alert-box error.
     2723                   undo, return error .
     2724               end.
     2725               find first buf_fbr-gds-obj exclusive-lock
     2726                    where recid( buf_fbr-gds-obj ) = v-fbr-gds-obj-recid
     2727               .
     2728           end.
     2729           assign
     2730               v-recipe-found = no
     2731           .
     2732           for first buf_recipe no-lock
     2733               where buf_recipe.obj-type    = p-obj-type
     2734                 and buf_recipe.obj-code    = p-obj-code
     2735                 and buf_recipe.artic       = buf_goods.artic
     2736                 and buf_recipe.prod-type   = buf_goods.prod-type
     2737                 and buf_recipe.prod-code   = buf_goods.prod-code
     2738                 and buf_recipe.recipe-type = 'производство':U
     2739                 or (
     2740                     buf_recipe.obj-type    = ""
     2741                 and buf_recipe.obj-code    = 0
     2742                 and buf_recipe.artic       = buf_goods.artic
     2743                 and buf_recipe.prod-type   = buf_goods.prod-type
     2744                 and buf_recipe.prod-code   = buf_goods.prod-code
     2745                 and buf_recipe.recipe-type = 'производство':U
     2746                     )
     2747           :
     2748               assign
     2749                   v-recipe-found = yes
     2750                   buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2751               .
     2752           end.
     2753           if v-recipe-found = no
     2754           then do:
     2755               for first buf_recipe no-lock
     2756                   where buf_recipe.obj-type    = p-obj-type
     2757                     and buf_recipe.obj-code    = p-obj-code
     2758                     and buf_recipe.artic       = buf_goods.artic
     2759                     and buf_recipe.prod-type   = buf_goods.prod-type
     2760                     and buf_recipe.prod-code   = buf_goods.prod-code
     2761                     and buf_recipe.recipe-type <> 'альтернатива':U
     2762                     or (
     2763                         buf_recipe.obj-type    = ""
     2764                     and buf_recipe.obj-code    = 0
     2765                     and buf_recipe.artic       = buf_goods.artic
     2766                     and buf_recipe.prod-type   = buf_goods.prod-type
     2767                     and buf_recipe.prod-code   = buf_goods.prod-code
     2768                     and buf_recipe.recipe-type <> 'альтернатива':U
     2769                         )
     2770               :
     2771                   assign
     2772                       v-recipe-found = yes
     2773                       buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2774                   .
     2775               end.
     2776               if v-recipe-found = no
     2777               then do:
     2778                   for first buf_recipe no-lock
     2779                       where buf_recipe.obj-type    = p-obj-type
     2780                         and buf_recipe.obj-code    = p-obj-code
     2781                         and buf_recipe.artic       = buf_goods.artic
     2782                         and buf_recipe.prod-type   = buf_goods.prod-type
     2783                         and buf_recipe.prod-code   = buf_goods.prod-code
     2784                         or (
     2785                             buf_recipe.obj-type    = ""
     2786                         and buf_recipe.obj-code    = 0
     2787                         and buf_recipe.artic       = buf_goods.artic
     2788                         and buf_recipe.prod-type   = buf_goods.prod-type
     2789                         and buf_recipe.prod-code   = buf_goods.prod-code
     2790                             )
     2791                   :
     2792                       assign
     2793                           v-recipe-found = yes
     2794                           buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2795                       .
     2796                   end.
     2797                   if v-recipe-found = no
     2798                   then do:
     2799                       assign
     2800                           buf_fbr-gds-obj.default-recipe-code = ""
     2801                       .
     2802                   end.
     2803               end.
     2804           end.
     2805       end.
     2806   end.
     2807   end procedure.
     2808   procedure fbrlib-get-obj-recipe :
     2809   define input parameter p-obj-type       as character    no-undo.
     2810   define input parameter p-obj-code       as integer      no-undo.
     2811   define input parameter p-gds-code       as integer      no-undo.
     2812   define output parameter p-recipe-code   as character    no-undo.
     2813       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     2814   do
     2815   for buf_fbr-gds-obj
     2816   on error undo, return error
     2817   :
     2818       find first buf_fbr-gds-obj no-lock
     2819            where buf_fbr-gds-obj.obj-type = p-obj-type
     2820              and buf_fbr-gds-obj.obj-code = p-obj-code
     2821              and buf_fbr-gds-obj.gds-code = p-gds-code
     2822       no-error.
     2823       if available buf_fbr-gds-obj
     2824       then do:
     2825           assign
     2826               p-recipe-code = buf_fbr-gds-obj.default-recipe-code
     2827           .
     2828       end.
     2829       else do:
     2830           assign
     2831               p-recipe-code = ""
     2832           .
     2833       end.
     2834   end.
     2835   end procedure.
     2836   procedure fbrlib-create-or-update-recipe-gds :
     2837   define input parameter p-recipe-code    as character        no-undo.
     2838   define input parameter p-gds-code       as integer          no-undo.
     2839   define input parameter p-is-waste       as logical          no-undo.
     2840   define input parameter p-qnty           as decimal          no-undo.
     2841   define input parameter p-proc-number    as integer          no-undo.
     2842   define input parameter p-nws-self       as logical          no-undo.
     2843       define variable v-max-proc-num  as integer      no-undo.
     2844       define variable v-recipe-type   as character    no-undo.
     2845       define buffer buf_goods             for ub.goods.
     2846       define buffer buf_recipe-gds        for ub.recipe-gds.
     2847       define buffer buf_recipe            for ub.recipe.
     2848       define buffer buf_proc_recipe-gds   for ub.recipe-gds.
     2849   do
     2850   for buf_goods
     2851     , buf_recipe-gds
     2852     , buf_recipe
     2853     , buf_proc_recipe-gds
     2854   on error undo, return error
     2855   :
     2856       find first buf_recipe no-lock
     2857            where buf_recipe.recipe-code = p-recipe-code
     2858       .
     2859       find first buf_goods no-lock
     2860            where buf_goods.gds-code = p-gds-code
     2861       .
     2862       find first buf_recipe-gds
     2863            where buf_recipe-gds.recipe-code = p-recipe-code
     2864              and buf_recipe-gds.prod-type   = buf_goods.prod-type
     2865              and buf_recipe-gds.prod-code   = buf_goods.prod-code
     2866              and buf_recipe-gds.artic       = buf_goods.artic
     2867       no-error.
     2868       if not available buf_recipe-gds
     2869       then do:
     2870           create buf_recipe-gds.
     2871           assign
     2872               buf_recipe-gds.recipe-code = p-recipe-code
     2873               buf_recipe-gds.gds-code    = p-gds-code
     2874               buf_recipe-gds.prod-type   = buf_goods.prod-type
     2875               buf_recipe-gds.prod-code   = buf_goods.prod-code
     2876               buf_recipe-gds.artic       = buf_goods.artic
     2877           .
     2878           assign
     2879               buf_recipe-gds.is-waste    = no
     2880               buf_recipe-gds.qnty        = 0
     2881               buf_recipe-gds.coeff-waste = 0
     2882               buf_recipe-gds.brutto-qnty = 0
     2883               buf_recipe-gds.proc-number = 0
     2884               buf_recipe-gds.nws-self    = no
     2885           .
     2886       end.
     2887       assign
     2888           buf_recipe-gds.is-waste    = p-is-waste
     2889       .
     2890       run fbrlib-get-recipe-type in this-procedure (
     2891             input "":U
     2892           , input buf_recipe-gds.recipe-code
     2893           , output v-recipe-type
     2894       ).
     2895       if v-recipe-type <> 'производство':U
     2896       then do:
     2897           assign
     2898               buf_recipe-gds.calc-method = 1
     2899               buf_recipe-gds.qnty        = p-qnty
     2900               buf_recipe-gds.brutto-qnty = p-qnty
     2901               buf_recipe-gds.coeff-waste = 0
     2902           .
     2903       end.
     2904       else do:
     2905           assign
     2906               buf_recipe-gds.calc-method = 1
     2907               buf_recipe-gds.brutto-qnty = p-qnty
     2908           .
     2909           run fbrlib-calc-brutto in this-procedure (
     2910                 input v-recipe-type
     2911               , input 0
     2912               , input 0
     2913               , input buf_recipe-gds.coeff-waste
     2914               , input buf_recipe-gds.brutto-qnty
     2915               , input 1
     2916               , output buf_recipe-gds.qnty
     2917               , output buf_recipe-gds.coeff-waste
     2918               , output buf_recipe-gds.brutto-qnty
     2919               , output buf_recipe-gds.calc-method
     2920           ).
     2921       end.
     2922       assign
     2923           buf_recipe-gds.nws-self    = p-nws-self
     2924       .
     2925       if buf_recipe.recipe-type = 'альтернатива':U
     2926       and buf_recipe-gds.proc-number <> 0
     2927       then do:
     2928       end.
     2929       else do:
     2930           if p-proc-number <> 0
     2931           then do:
     2932               assign
     2933                   buf_recipe-gds.proc-number = p-proc-number
     2934               .
     2935           end.
     2936           else do:
     2937               assign
     2938                   v-max-proc-num = 0
     2939               .
     2940               for each buf_proc_recipe-gds no-lock
     2941                  where buf_proc_recipe-gds.recipe-code = p-recipe-code
     2942               :
     2943                   if recid( buf_proc_recipe-gds ) <> recid( buf_recipe-gds )
     2944                   then do:
     2945                       assign
     2946                           v-max-proc-num = ( if v-max-proc-num < buf_proc_recipe-gds.proc-number then buf_proc_recipe-gds.proc-number else v-max-proc-num )
     2947                       .
     2948                   end.
     2949               end.
     2950               assign
     2951                   buf_recipe-gds.proc-number = v-max-proc-num + 1
     2952               .
     2953           end.
     2954       end.
     2955   end.
     2956   end procedure.
     2957   PROCEDURE fbrlib-create-or-update-recipe :
     2958   define input parameter p-mode               as character    no-undo.
     2959   define input parameter p-obj-type           as character    no-undo.
     2960   define input parameter p-obj-code           as integer      no-undo.
     2961   define input parameter p-recipe-code        as character    no-undo.
     2962   define input parameter p-recipe-type        as character    no-undo.
     2963   define input parameter p-gds-code           as integer      no-undo.
     2964   define input parameter p-name               as character    no-undo.
     2965   define input parameter p-design             as character    no-undo.
     2966   define input parameter p-order              as integer      no-undo.
     2967   define input parameter p-quality            as character    no-undo.
     2968   define input parameter p-ref-num            as character    no-undo.
     2969   define input parameter p-technique          as character    no-undo.
     2970   define input parameter p-template           as character    no-undo.
     2971   define input parameter p-qnty               as decimal      no-undo.
     2972   define input parameter p-portion-qnty       as integer      no-undo.
     2973   define input parameter p-portion-weight     as decimal      no-undo.
     2974   define output parameter p-new-recipe-code   as character    no-undo.
     2975       define variable v-host-code         as integer      no-undo.
     2976       define variable v-fbr-gds-obj-recid as recid        no-undo.
     2977       define buffer buf_recipe    for ub.recipe.
     2978       define buffer buf_goods     for ub.goods.
     2979   do
     2980   for buf_recipe
     2981     , buf_goods
     2982   on error undo, return error
     2983   :
     2984       if p-mode <> 'ДОБАВЛЕНИЕ':U
     2985       and p-mode <> 'ИЗМЕНЕНИЕ':U
     2986       then do:
     2987           message
     2988               skip "Ошибка задания типа операции для создания или измения рецепта."
     2989               skip (1)
     2990               skip "Задан тип операции:" p-mode
     2991           view-as alert-box error.
     2992           undo, return error .
     2993       end.
     2994       if p-recipe-code = ""
     2995       then do:
     2996   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2997   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2998     (input  p-obj-type
     2999     ,input  p-obj-code
     3000     ,output v-host-code
     3001     )  .
     3002           find first buf_goods no-lock
     3003                where buf_goods.gds-code = p-gds-code
     3004           .
     3005           create buf_recipe .
     3006           run fbrcode-gen-recipe-code in this-procedure (
     3007                 input p-obj-type
     3008               , input p-obj-code
     3009               , output buf_recipe.recipe-code
     3010           ).
     3011           assign
     3012               buf_recipe.artic               = buf_goods.artic
     3013               buf_recipe.prod-type           = buf_goods.prod-type
     3014               buf_recipe.prod-code           = buf_goods.prod-code
     3015               buf_recipe.recipe-type         = p-recipe-type
     3016               buf_recipe.recipe-name         = ( if p-name = "" then buf_goods.gds-name else p-name )
     3017               buf_recipe.gds-code            = p-gds-code
     3018               buf_recipe.host-code           = v-host-code
     3019               buf_recipe.obj-type            = p-obj-type
     3020               buf_recipe.obj-code            = p-obj-code
     3021               buf_recipe.recipe-design       = ""
     3022               buf_recipe.recipe-order        = 0
     3023               buf_recipe.recipe-quality      = ""
     3024               buf_recipe.recipe-ref-num      = ""
     3025               buf_recipe.recipe-technique    = ""
     3026               buf_recipe.recipe-template     = ""
     3027               buf_recipe.qnty                = 1.0
     3028               buf_recipe.portion-qnty        = 1
     3029               buf_recipe.portion-weight      = 0
     3030           .
     3031       end.
     3032       if p-name <> ""
     3033       then do:
     3034           assign
     3035               buf_recipe.recipe-name = p-name
     3036           .
     3037       end.
     3038       assign
     3039           buf_recipe.recipe-design       = p-design
     3040           buf_recipe.recipe-order        = p-order
     3041           buf_recipe.recipe-quality      = p-quality
     3042           buf_recipe.recipe-ref-num      = p-ref-num
     3043           buf_recipe.recipe-technique    = p-technique
     3044           buf_recipe.recipe-template     = p-template
     3045           buf_recipe.qnty                = p-qnty
     3046           buf_recipe.portion-qnty        = p-portion-qnty
     3047           buf_recipe.portion-weight      = p-portion-weight
     3048       .
     3049       assign
     3050           p-new-recipe-code = buf_recipe.recipe-code
     3051       .
     3052       run fbrlib-set-default-recipe in this-procedure (
     3053             input p-obj-type
     3054           , input p-obj-code
     3055           , input buf_goods.gds-code
     3056       ).
     3057   end.
     3058   END PROCEDURE.
     3059   PROCEDURE fbrlib-delete-fact-fbr-doc :
     3060   define input parameter parparentproc-handle as widget-handle no-undo .
     3061   define input parameter p-doc-code   as character no-undo.
     3062   define input parameter p-chip-num   like ub.c-trn-doc.chip-num no-undo .
     3063       define variable v-shift-on      as logical      no-undo.
     3064       define variable v-shift-date    as date         no-undo.
     3065       define variable v-shift-num     as integer      no-undo.
     3066       define variable v-shift-name    as character    no-undo.
     3067       define variable v-obj-date      as date         no-undo.
     3068       define variable v-chip-num      as integer      no-undo.
     3069       define buffer buf_fbr-doc       for ub.fbr-doc.
     3070       define buffer buf_fbr-line      for ub.fbr-line.
     3071       define buffer buf_c-fbr-doc     for ub.c-fbr-doc.
     3072       define buffer buf_fbr-recipe     for ub.fbr-recipe.
     3073       define buffer buf_fbr-recipe-gds for ub.fbr-recipe-gds.
     3074       define buffer buf_marking-lines for ub.marking-lines .
     3075       define buffer buf_marking       for ub.marking .
     3076       define buffer buf_goods         for ub.goods .
     3077   do
     3078   for buf_fbr-doc
     3079     , buf_fbr-line
     3080     , buf_c-fbr-doc
     3081     , buf_fbr-recipe
     3082     , buf_fbr-recipe-gds
     3083     , buf_goods
     3084     , buf_marking
     3085     , buf_marking-lines
     3086   on error undo, return error
     3087   :
     3088   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3089     define variable v-cntxt-db-num        as integer   no-undo .
     3090     define variable v-cntxt-userid        as character no-undo .
     3091     define variable v-cntxt-level         as character no-undo .
     3092     define variable v-cntxt-host-code-obj as integer   no-undo .
     3093     define variable v-cntxt-obj-type      as character no-undo .
     3094     define variable v-cntxt-obj-code      as integer   no-undo .
     3095     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3096     define variable v-cntxt-is-admin      as logical   no-undo .
     3097   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3098     run mainmenu_getcntxt in parparentproc-handle
     3099       (output v-cntxt-db-num
     3100       ,output v-cntxt-userid
     3101       ,output v-cntxt-level
     3102       ,output v-cntxt-host-code-obj
     3103       ,output v-cntxt-obj-type
     3104       ,output v-cntxt-obj-code
     3105       ,output v-cntxt-db-num-obj
     3106       ,output v-cntxt-is-admin
     3107       ) .
     3108       if search ("delfbr.err") <> ?
     3109       then do:
     3110           os-delete "delfbr.err".
     3111       end.
     3112     _del-block:
     3113       do transaction
     3114     on error undo _del-block, return error return-value
     3115     on endkey undo _del-block , return error return-value
     3116     on stop undo _del-block , return error return-value
     3117       :
     3118           find first buf_fbr-doc exclusive-lock
     3119                where buf_fbr-doc.doc-code = p-doc-code
     3120           no-error.
     3121           if not available buf_fbr-doc
     3122           then do:
     3123         undo _del-block, return error substitute("&1 &2 &3&4Не найден документ производства &5 для удаления."
     3124                                           ,vss-workfile
     3125                                           ,vss-revision
     3126                                           ,vss-description
     3127                                           ,chr(10)
     3128                                           , p-doc-code).
     3129           end.
     3130           run fbrlib-delete-fact-trn-doc in this-procedure (
     3131               input parparentproc-handle
     3132              ,input p-doc-code
     3133              ,input 'при':U
     3134              ,input p-chip-num
     3135              ,output v-chip-num
     3136           ) no-error.
     3137           if error-status :error
     3138           then do:
     3139               run fbrlib-print-del-error-message in this-procedure .
     3140         undo _del-block, return error.
     3141           end.
     3142           assign
     3143           p-chip-num = (if p-chip-num = ?
     3144                         then v-chip-num
     3145                         else p-chip-num).
     3146           run fbrlib-delete-fact-trn-doc in this-procedure (
     3147               input parparentproc-handle
     3148              ,input p-doc-code
     3149              ,input 'рас':U
     3150              ,input p-chip-num
     3151              ,output v-chip-num
     3152           ) no-error.
     3153           if error-status :error
     3154           then do:
     3155               run fbrlib-print-del-error-message in this-procedure .
     3156         undo _del-block, return error.
     3157           end.
     3158           run fbrlib-delete-fact-trn-doc in this-procedure (
     3159               input parparentproc-handle
     3160              ,input p-doc-code
     3161              ,input 'спи':U
     3162              ,input p-chip-num
     3163              ,output v-chip-num
     3164           ) no-error.
     3165           if error-status :error
     3166           then do:
     3167               run fbrlib-print-del-error-message in this-procedure .
     3168         undo _del-block, return error.
     3169           end.
     3170           create buf_c-fbr-doc.
     3171           buffer-copy buf_fbr-doc to buf_c-fbr-doc.
     3172   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3173   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     3174     (input  buf_fbr-doc.obj-type
     3175     ,input  buf_fbr-doc.obj-code
     3176     ,output v-obj-date
     3177     ) no-error .
     3178           if error-status :error
     3179           or v-obj-date = ?
     3180           then do:
     3181         undo _del-block, return error "Нет текущей даты на объекте документа.".
     3182           end.
     3183   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3184   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     3185     (input  buf_fbr-doc.obj-type
     3186     ,input  buf_fbr-doc.obj-code
     3187     ,input  'shift-on=request'
     3188     ,output v-shift-on
     3189     )  .
     3190           if v-shift-on
     3191           then do:
     3192   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3193   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     3194     (input  buf_fbr-doc.obj-type
     3195     ,input  buf_fbr-doc.obj-code
     3196     ,output v-shift-date
     3197     ,output v-shift-num
     3198     ,output v-shift-name
     3199     ) no-error .
     3200               if error-status :error
     3201               then do:
     3202           undo _del-block, return error "Ошибка при поиске текущей смены на объекте".
     3203               end.
     3204           end.
     3205           else do:
     3206               assign
     3207                   v-shift-date = ?
     3208                   v-shift-num  = ?
     3209                   v-shift-name = ?
     3210               .
     3211           end.
     3212           define variable v-today       as date         no-undo.
     3213           define variable v-time        as integer      no-undo.
     3214           run cur-time in this-procedure (
     3215                 output v-today
     3216               , output v-time
     3217           ).
     3218           assign
     3219               buf_c-fbr-doc.chip-num         = (if p-chip-num <> ? then p-chip-num else next-value( s-corr-chip, ub  ))
     3220               buf_c-fbr-doc.corr-user-name   = v-cntxt-userid
     3221               buf_c-fbr-doc.corr-user-db-num = v-cntxt-db-num
     3222               buf_c-fbr-doc.corr-date        = v-today
     3223               buf_c-fbr-doc.corr-time        = v-time
     3224               buf_c-fbr-doc.corr-shift-date  = v-shift-date
     3225               buf_c-fbr-doc.corr-shift-num   = v-shift-num
     3226               buf_c-fbr-doc.corr-shift-name  = v-shift-name
     3227               buf_c-fbr-doc.is-del           = yes
     3228           .
     3229           assign
     3230               buf_fbr-doc.is-del = yes
     3231           .
     3232           for each buf_fbr-line exclusive-lock
     3233              where buf_fbr-line.doc-code = p-doc-code
     3234       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3235       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3236       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3237           :
     3238               for first buf_goods no-lock where buf_goods.artic      = buf_fbr-line.artic
     3239                                             and buf_goods.prod-type  = buf_fbr-line.prod-type
     3240                                             and buf_goods.prod-code  = buf_fbr-line.prod-code,
     3241               each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = buf_goods.gds-code
     3242                                                       and buf_marking-lines.obj-type = buf_fbr-doc.obj-type
     3243                                                       and buf_marking-lines.obj-code = buf_fbr-doc.obj-code
     3244                                                       and buf_marking-lines.in-code  = "manufacturing"
     3245                                                       and buf_marking-lines.out-code = buf_fbr-line.doc-code
     3246                                                       and buf_marking-lines.part-code = buf_fbr-line.recipe-code
     3247                                                       and buf_marking-lines.prt-code = 0
     3248               :
     3249                 for first buf_marking exclusive-lock where buf_marking.mark begins buf_marking-lines.mark :
     3250                   assign
     3251                     buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB when buf_fbr-line.is-comp
     3252                   .
     3253                 end .
     3254                 delete buf_marking-lines.
     3255               end .
     3256               delete buf_fbr-line.
     3257           end.
     3258           for each buf_fbr-recipe exclusive-lock
     3259              where buf_fbr-recipe.doc-code = p-doc-code
     3260       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3261       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3262       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3263           :
     3264               delete buf_fbr-recipe.
     3265           end.
     3266           for each buf_fbr-recipe-gds exclusive-lock
     3267              where buf_fbr-recipe-gds.doc-code = p-doc-code
     3268       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     3269       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     3270       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     3271           :
     3272               delete buf_fbr-recipe-gds.
     3273           end.
     3274           delete buf_fbr-doc.
     3275       end.
     3276   end.
     3277   END PROCEDURE.
     3278   PROCEDURE fbrlib-del-trn-doc :
     3279   do
     3280   on error undo, return error
     3281   :
     3282   define input parameter parparentproc        as widget-handle no-undo .
     3283   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     3284   define input parameter p-trn-doc-type       as character    no-undo.
     3285   define input parameter p-phchip-num         like ub.c-trn-doc.chip-num no-undo .
     3286   define output parameter p-chip-num           like ub.c-trn-doc.chip-num no-undo .
     3287       define variable v-trn-doc-doc-code  as character     no-undo.
     3288       define buffer buf_trn-doc       for ub.trn-doc.
     3289   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3290     define variable v-cntxt-db-num        as integer   no-undo .
     3291     define variable v-cntxt-userid        as character no-undo .
     3292     define variable v-cntxt-level         as character no-undo .
     3293     define variable v-cntxt-host-code-obj as integer   no-undo .
     3294     define variable v-cntxt-obj-type      as character no-undo .
     3295     define variable v-cntxt-obj-code      as integer   no-undo .
     3296     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3297     define variable v-cntxt-is-admin      as logical   no-undo .
     3298   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3299     run mainmenu_getcntxt in parparentproc
     3300       (output v-cntxt-db-num
     3301       ,output v-cntxt-userid
     3302       ,output v-cntxt-level
     3303       ,output v-cntxt-host-code-obj
     3304       ,output v-cntxt-obj-type
     3305       ,output v-cntxt-obj-code
     3306       ,output v-cntxt-db-num-obj
     3307       ,output v-cntxt-is-admin
     3308       ) .
     3309       run fbrcode-trn-doc in this-procedure (
     3310             input 'производство':U
     3311           , input p-fbr-doc-doc-code
     3312           , input p-trn-doc-type
     3313           , output v-trn-doc-doc-code
     3314       ).
     3315       find first buf_trn-doc no-lock
     3316            where buf_trn-doc.doc-code = v-trn-doc-doc-code
     3317       no-error.
     3318       if available buf_trn-doc
     3319       then do:
     3320           run str/del-doc.p (
     3321                 input parparentproc
     3322               , input buf_trn-doc.doc-code
     3323               , input v-cntxt-db-num
     3324               , input "del-doc.err"
     3325               , input ?
     3326               , input p-fbr-doc-doc-code
     3327               , input v-cntxt-userid
     3328               , input 0
     3329               , input p-phchip-num
     3330               , output p-chip-num
     3331           ) no-error.
     3332           if error-status :error
     3333           then do:
     3334             undo, return error substitute("Не удалось удалить складской документ &1, созданный по документу производства &2.&3&4&3&5"
     3335                                           ,v-trn-doc-doc-code
     3336                                           ,p-fbr-doc-doc-code
     3337                                           , chr(10)
     3338                                           , error-status:get-message(1)
     3339                                           , return-value ).
     3340           end.
     3341       end.
     3342   end.
     3343   END PROCEDURE.
     3344   PROCEDURE fbrlib-delete-fact-trn-doc :
     3345   define input parameter parparentproc    as widget-handle    no-undo.
     3346   define input parameter p-fbr-doc-code   as character        no-undo.
     3347   define input parameter p-doc-type       as character    no-undo.
     3348   define input parameter p-ph-chip-num       like ub.c-trn-doc.chip-num no-undo .
     3349   define output parameter p-chip-num      like ub.c-trn-doc.chip-num no-undo .
     3350       define variable v-doc-code          as character        no-undo.
     3351       define variable v-ext-doc-type      as character        no-undo.
     3352       define variable v-trn-doc-recid     as recid            no-undo.
     3353       define variable varchip-code        as integer          no-undo.
     3354       define variable varchip-code2       as integer          no-undo.
     3355       define variable v-chip-counter      as integer          no-undo.
     3356       define buffer buf_trn-doc       for ub.trn-doc.
     3357       define buffer buf_pri_trn-doc   for ub.trn-doc.
     3358       define buffer buf_cons_trn-doc  for ub.trn-doc.
     3359   do
     3360   for buf_trn-doc
     3361     , buf_pri_trn-doc
     3362     , buf_cons_trn-doc
     3363   on error undo, return error
     3364   :
     3365   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3366     define variable v-cntxt-db-num        as integer   no-undo .
     3367     define variable v-cntxt-userid        as character no-undo .
     3368     define variable v-cntxt-level         as character no-undo .
     3369     define variable v-cntxt-host-code-obj as integer   no-undo .
     3370     define variable v-cntxt-obj-type      as character no-undo .
     3371     define variable v-cntxt-obj-code      as integer   no-undo .
     3372     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3373     define variable v-cntxt-is-admin      as logical   no-undo .
     3374   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3375     run mainmenu_getcntxt in parparentproc
     3376       (output v-cntxt-db-num
     3377       ,output v-cntxt-userid
     3378       ,output v-cntxt-level
     3379       ,output v-cntxt-host-code-obj
     3380       ,output v-cntxt-obj-type
     3381       ,output v-cntxt-obj-code
     3382       ,output v-cntxt-db-num-obj
     3383       ,output v-cntxt-is-admin
     3384       ) .
     3385       run fbrcode-trn-doc in this-procedure (
     3386             input 'производство':U
     3387           , input p-fbr-doc-code
     3388           , input p-doc-type
     3389           , output v-doc-code
     3390       ).
     3391       find first buf_trn-doc no-lock
     3392            where buf_trn-doc.doc-code = v-doc-code
     3393       no-error.
     3394       if not available buf_trn-doc
     3395       then do:
     3396           if p-doc-type <> 'спи':U
     3397           then do:
     3398               message
     3399                   "Не найден документ '" p-doc-type "'"
     3400                   "по документу производства " p-fbr-doc-code
     3401               view-as alert-box.
     3402               undo, return error.
     3403           end.
     3404           else do:
     3405           end.
     3406       end.
     3407       else do:
     3408           assign
     3409               v-trn-doc-recid = recid( buf_trn-doc )
     3410               v-ext-doc-type  = buf_trn-doc.ext-doc-type
     3411           .
     3412           if v-ext-doc-type = 'ev':U
     3413           then do:
     3414               find first buf_pri_trn-doc no-lock
     3415                    where buf_pri_trn-doc.out-code     = v-doc-code
     3416                      and buf_pri_trn-doc.ext-doc-type = 'iv':U
     3417               no-error.
     3418               if available buf_pri_trn-doc
     3419               then do:
     3420                   run str/del-doc.p (
     3421                         input parparentproc
     3422                       , input buf_pri_trn-doc.doc-code
     3423                       , input v-cntxt-db-num
     3424                       , input "delfbr.err"
     3425                       , input ?
     3426                       , input p-fbr-doc-code
     3427                       , input v-cntxt-userid
     3428                       , input 0
     3429                       , input (if p-ph-chip-num <> ?
     3430                               then p-ph-chip-num
     3431                               else (if varchip-code <> 0
     3432                                   then varchip-code
     3433                                   else ?)
     3434                               )
     3435                       , output varchip-code2
     3436                   ) no-error.
     3437                   if error-status :error
     3438                   then do:
     3439                     undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     3440                                                   ,buf_pri_trn-doc.doc-code
     3441                                                   ,p-fbr-doc-code
     3442                                                   , chr(10)
     3443                                                   , error-status:get-message(1)
     3444                                                   , return-value ).
     3445                   end.
     3446               end.
     3447           end.
     3448           define buffer buf_out_trn-doc       for ub.trn-doc.
     3449           if p-doc-type = 'при':U
     3450           then do:
     3451               assign
     3452                   v-chip-counter = 0
     3453               .
     3454               for each buf_out_trn-doc exclusive-lock
     3455                  where buf_out_trn-doc.out-code = buf_trn-doc.doc-code
     3456               on error undo, return error
     3457               :
     3458                   assign
     3459                       v-chip-counter = v-chip-counter + 1
     3460                   .
     3461                   if v-chip-counter > 1
     3462                   then do:
     3463                       assign
     3464                           varchip-code = varchip-code2
     3465                       .
     3466                   end.
     3467                   run str/del-doc.p (
     3468                         input parparentproc
     3469                       , input buf_out_trn-doc.doc-code
     3470                       , input v-cntxt-db-num
     3471                       , input "delfbr.err"
     3472                       , input ?
     3473                       , input p-fbr-doc-code
     3474                       , input v-cntxt-userid
     3475                       , input 0
     3476                       , input (if p-ph-chip-num <> ?
     3477                               then p-ph-chip-num
     3478                               else (if varchip-code <> 0
     3479                                   then varchip-code
     3480                                   else ?)
     3481                               )
     3482                       , output varchip-code2
     3483                   ) no-error.
     3484                   if error-status :error
     3485                   then do:
     3486                     undo, return error substitute("Ошибка при удалении складского документа &1, связанного со складским документов прихода &2, созданный по документу производства &3.&4&5&4&6"
     3487                                                   ,buf_out_trn-doc.doc-code
     3488                                                   ,buf_trn-doc.doc-code
     3489                                                   ,p-fbr-doc-code
     3490                                                   , chr(10)
     3491                                                   , error-status:get-message(1)
     3492                                                   , return-value ).
     3493                   end.
     3494               end.
     3495           end.
     3496           run str/del-doc.p (
     3497                 input parparentproc
     3498               , input buf_trn-doc.doc-code
     3499               , input v-cntxt-db-num
     3500               , input "delfbr.err"
     3501               , input ?
     3502               , input p-fbr-doc-code
     3503               , input v-cntxt-userid
     3504               , input 0
     3505               , input (if p-ph-chip-num <> ?
     3506                        then p-ph-chip-num
     3507                        else (if varchip-code <> 0
     3508                              then varchip-code
     3509                              else ?)
     3510                        )
     3511               , output varchip-code2
     3512           ) no-error.
     3513           if error-status :error
     3514           then do:
     3515               undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     3516                                             ,buf_trn-doc.doc-code
     3517                                             ,p-fbr-doc-code
     3518                                             , chr(10)
     3519                                             , error-status:get-message(1)
     3520                                             , return-value ).
     3521           end.
     3522           if p-doc-type = 'рас':U
     3523           or p-doc-type = 'спи':U
     3524           then do:
     3525               assign
     3526                   v-chip-counter = 0
     3527               .
     3528               for each buf_cons_trn-doc no-lock
     3529                  where buf_cons_trn-doc.out-code      = v-doc-code
     3530                    and buf_cons_trn-doc.ext-doc-type  = 'pc':U
     3531               :
     3532                   assign
     3533                       v-trn-doc-recid = recid( buf_cons_trn-doc )
     3534                       v-chip-counter = v-chip-counter + 1
     3535                   .
     3536                   assign
     3537                   varchip-code = if v-chip-counter = 2
     3538                                  then varchip-code2
     3539                                  else varchip-code.
     3540                   run str/del-doc.p (
     3541                         input parparentproc
     3542                       , input buf_cons_trn-doc.doc-code
     3543                       , input v-cntxt-db-num
     3544                       , input "delfbr.err"
     3545                       , input ?
     3546                       , input ?
     3547                       , input v-cntxt-userid
     3548                       , input 0
     3549                       , input (if p-ph-chip-num <> ?
     3550                                then p-ph-chip-num
     3551                                else ( if v-chip-counter = 1
     3552                                       then ?
     3553                                       else varchip-code )
     3554                                )
     3555                       , output varchip-code2
     3556                   ) no-error.
     3557                   if error-status :error
     3558                   then do:
     3559                       undo, return error substitute("Ошибка при удалении складского документа смены типа приобретения &1, созданный по документу производства &2.&3&4&3&5"
     3560                                                     ,buf_cons_trn-doc.doc-code
     3561                                                     ,p-fbr-doc-code
     3562                                                     , chr(10)
     3563                                                     , error-status:get-message(1)
     3564                                                     , return-value ).
     3565                   end.
     3566                   assign
     3567                       p-chip-num = varchip-code2
     3568                   .
     3569               end.
     3570           end.
     3571           assign
     3572               p-chip-num = varchip-code2
     3573           .
     3574       end.
     3575   end.
     3576   END PROCEDURE.
     3577   PROCEDURE fbrlib-print-del-error-message :
     3578   do
     3579   on error undo, return error
     3580   :
     3581       define variable v-user-action   as character    no-undo.
     3582       define variable v-printed       as logical      no-undo.
     3583       message
     3584           vss-workfile vss-revision vss-description
     3585           skip "Ошибка при удалении документа."
     3586           skip return-value
     3587           skip trim(error-status :get-message(1))
     3588           skip trim(error-status :get-message(2))
     3589           skip trim(error-status :get-message(3))
     3590       view-as alert-box error.
     3591       if search ("delfbr.err") <> ?
     3592       then do:
     3593         run gbl/prnfilen.w
     3594           (input  "Ошибки при удалении документа производства"
     3595           ,input  0
     3596           ,input  "delfbr.err"
     3597           ,input  7
     3598           ,output v-user-action
     3599           ,output v-printed
     3600           ).
     3601       end.
     3602   end.
     3603   END PROCEDURE.
     3604   procedure fbrlib-calc-brutto :
     3605   define input parameter p-recipe-type        as character        no-undo.
     3606   define input parameter p-netto              as decimal          no-undo.
     3607   define input parameter p-coeff-value        as decimal          no-undo.
     3608   define input parameter p-coeff-waste        as decimal          no-undo.
     3609   define input parameter p-brutto             as decimal          no-undo.
     3610   define input parameter p-calc-method        as integer          no-undo.
     3611   define output parameter p-new-netto         as decimal          no-undo.
     3612   define output parameter p-new-coeff-waste   as decimal          no-undo.
     3613   define output parameter p-new-brutto        as decimal          no-undo.
     3614   define output parameter p-new-calc-method   as integer          no-undo.
     3615   do
     3616   on error undo, return error
     3617   :
     3618       if p-recipe-type <> 'производство':U
     3619       then do:
     3620           assign
     3621               p-new-coeff-waste = 0
     3622               p-new-calc-method = 1
     3623               p-new-netto       = ( if p-calc-method = 1 then p-brutto else p-netto )
     3624               p-new-brutto      = ( if p-calc-method = 1 then p-brutto else p-netto )
     3625           .
     3626       end.
     3627       else do:
     3628           assign
     3629               p-new-calc-method = p-calc-method
     3630           .
     3631           if p-coeff-waste = 0
     3632           then do:
     3633               assign
     3634                   p-coeff-value = 0
     3635               .
     3636           end.
     3637           case p-calc-method
     3638           :
     3639               when 1
     3640               then do:
     3641                   assign
     3642                       p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     3643                       p-new-coeff-waste   = p-coeff-waste
     3644                       p-new-brutto        = p-brutto
     3645                   .
     3646               end.
     3647               when 2
     3648               then do:
     3649                   assign
     3650                       p-new-netto         = p-netto
     3651                       p-new-coeff-waste   = 100 - p-coeff-value - ( 100 * p-netto / p-brutto )
     3652                       p-new-brutto        = p-brutto
     3653                   .
     3654               end.
     3655               when 3
     3656               then do:
     3657                   assign
     3658                       p-new-netto         = p-netto
     3659                       p-new-coeff-waste   = p-coeff-waste
     3660                       p-new-brutto        = 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste )
     3661                   .
     3662               end.
     3663               otherwise do:
     3664                   define variable v-yesno    as logical      no-undo.
     3665                   assign
     3666                       v-yesno = yes
     3667                   .
     3668                   message
     3669                       "Неверный метод для расчета брутто, нетто и процента потерь."
     3670                       skip "Значение метода должно быть 1, 2 или 3."
     3671                       skip(1)
     3672                       skip "Заданное значение:" p-calc-method
     3673                       skip(1)
     3674                       skip "Установить значение метода расчета 1"
     3675                       skip "(расчет нетто по брутто и проценту потерь)?"
     3676                   view-as alert-box warning
     3677                   buttons yes-no
     3678                   title "Неверное значение метода пересчета в строках документа-производства"
     3679                   update v-yesno
     3680                   .
     3681                   if v-yesno = yes
     3682                   then do:
     3683                       assign
     3684                           p-new-calc-method   = 1
     3685                           p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     3686                           p-new-coeff-waste   = p-coeff-waste
     3687                           p-new-brutto        = p-brutto
     3688                       .
     3689                   end.
     3690                   else do:
     3691                       message
     3692                               vss-workfile vss-revision vss-description
     3693                           skip(1)
     3694                           skip "Ошибка расчета брутто, нетто и процента потерь."
     3695                           skip return-value
     3696                           skip trim(error-status :get-message(1))
     3697                               trim(error-status :get-message(2))
     3698                               trim(error-status :get-message(3))
     3699                       view-as alert-box error
     3700                       title "Неверное значение метода расчета"
     3701                       .
     3702                       undo, return error .
     3703                   end.
     3704               end.
     3705           end case.
     3706       end.
     3707   end.
     3708   end procedure.
     3709   procedure fbrlib-check-brutto :
     3710   define input parameter p-recipe-type        as character        no-undo.
     3711   define input parameter p-netto              as decimal          no-undo.
     3712   define input parameter p-coeff-value        as decimal          no-undo.
     3713   define input parameter p-coeff-waste        as decimal          no-undo.
     3714   define input parameter p-brutto             as decimal          no-undo.
     3715   define input parameter p-calc-method        as integer          no-undo.
     3716   define output parameter p-error-message     as character        no-undo.
     3717   define output parameter p-not-good          as logical          no-undo.
     3718   do
     3719   on error undo, return error
     3720   :
     3721       if p-recipe-type <> 'производство':U
     3722       then do:
     3723           if p-netto <> p-brutto
     3724           or p-coeff-waste <> 0
     3725           then do:
     3726               assign
     3727                   p-not-good      = yes
     3728                   p-error-message = substitute( "Во всех рецептах кроме рецепта производства должно выполняться:&1брутто = нетто и процент потерь = 0.&1&1Тип рецепта: &2&1Брутто: &3&1Нетто: &4&1Процент потерь: &5"
     3729                                           , chr(10), p-recipe-type, p-brutto, p-netto, p-coeff-waste )
     3730               .
     3731           end.
     3732       end.
     3733       else do:
     3734           if p-coeff-waste = 0
     3735           then do:
     3736               assign
     3737                   p-coeff-value = 0
     3738               .
     3739           end.
     3740           case p-calc-method
     3741           :
     3742               when 1
     3743               then do:
     3744                   if round( p-netto, 9 ) <> round( p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100, 9 )
     3745                   then do:
     3746                       assign
     3747                           p-not-good      = yes
     3748                           p-error-message = substitute( "Ошибка расчета нетто ( &2 ) &1 по брутто ( &3 ) &1 и процентам потерь ( &4, &5 )."
     3749                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     3750                       .
     3751                   end.
     3752               end.
     3753               when 2
     3754               then do:
     3755                   if round( p-coeff-waste, 9 ) <> round( 100 - p-coeff-value - ( 100 * p-netto / p-brutto ), 9 )
     3756                   then do:
     3757                       assign
     3758                           p-not-good      = yes
     3759                           p-error-message =  substitute( "Ошибка расчета процента потерь ( &2 ) &1 по нетто ( &3 ) &1 брутто ( &4 ) &1 и cезонному проценту ( &5 )."
     3760                                                   , chr(10), p-coeff-waste, p-netto, p-brutto, p-coeff-value )
     3761                       .
     3762                   end.
     3763               end.
     3764               when 3
     3765               then do:
     3766                   if round( p-brutto, 9 ) <> round( 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste ), 9 )
     3767                   then do:
     3768                       assign
     3769                           p-not-good      = yes
     3770                           p-error-message = substitute( "Ошибка расчета брутто ( &3 ) &1 по нетто ( &2 ) &1 и процентам потерь ( &4, &5 )."
     3771                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     3772                       .
     3773                   end.
     3774               end.
     3775               otherwise do:
     3776                   assign
     3777                       p-not-good      = yes
     3778                       p-error-message = substitute( "Ошибка ввода метода расчета ( &1 ).", p-calc-method )
     3779                   .
     3780               end.
     3781           end case.
     3782       end.
     3783   end.
     3784   end procedure.
     3785   procedure fbrlib-check-fbr-recipe :
     3786   define input parameter p-doc-code       as character        no-undo.
     3787   define input parameter p-recipe-code    as character        no-undo.
     3788   define output parameter p-is-correct    as logical          no-undo.
     3789       define variable v-comp-factor    as decimal      no-undo.
     3790       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     3791       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     3792       define buffer buf_fbr-line          for ub.fbr-line.
     3793   do
     3794   for buf_fbr-recipe
     3795     , buf_fbr-recipe-gds
     3796     , buf_fbr-line
     3797   on error undo, return error
     3798   :
     3799       assign
     3800           p-is-correct = yes
     3801       .
     3802       find first buf_fbr-recipe no-lock
     3803            where buf_fbr-recipe.doc-code    = p-doc-code
     3804              and buf_fbr-recipe.recipe-code = p-recipe-code no-error
     3805       .
     3806       if not available buf_fbr-recipe then do:
     3807         undo, return error substitute("Не найден рецепт (fbr-recipe) с кодом &1 для  документа пр-ва &2", p-recipe-code, p-doc-code).
     3808       end.
     3809       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     3810       then do:
     3811       end.
     3812       else do:
     3813           find first buf_fbr-line no-lock
     3814                where buf_fbr-line.doc-code    = buf_fbr-recipe.doc-code
     3815                  and buf_fbr-line.is-comp     = yes
     3816                  and buf_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     3817                  and buf_fbr-line.artic       = buf_fbr-recipe.artic
     3818                  and buf_fbr-line.prod-type   = buf_fbr-recipe.prod-type
     3819                  and buf_fbr-line.prod-code   = buf_fbr-recipe.prod-code
     3820           .
     3821           assign
     3822               v-comp-factor = buf_fbr-line.fact-qnty / buf_fbr-recipe.qnty
     3823           .
     3824           recipe-line-cycle:
     3825           for each buf_fbr-recipe-gds no-lock
     3826              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     3827                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     3828           on error undo, return error
     3829           :
     3830               find first buf_fbr-line no-lock
     3831                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     3832                      and buf_fbr-line.is-comp     = no
     3833                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     3834                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3835                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3836                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3837               .
     3838               if absolute( buf_fbr-line.fact-qnty / buf_fbr-recipe-gds.brutto-qnty - v-comp-factor ) > 0.000000001
     3839               then do:
     3840                   assign
     3841                       p-is-correct = no
     3842                   .
     3843                   leave recipe-line-cycle.
     3844               end.
     3845           end.
     3846       end.
     3847   end.
     3848   end procedure.
     3849   procedure fbrlib-get-recipe-type :
     3850   define input parameter p-fbr-doc-code   as character        no-undo.
     3851   define input parameter p-recipe-code    as character        no-undo.
     3852   define output parameter p-recipe-type   as character        no-undo.
     3853       define buffer buf_recipe        for ub.recipe.
     3854       define buffer buf_fbr-recipe    for ub.fbr-recipe.
     3855   do
     3856   for buf_recipe
     3857     , buf_fbr-recipe
     3858   on error undo, return error
     3859   :
     3860       if p-fbr-doc-code = ""
     3861       then do:
     3862           find first buf_recipe no-lock
     3863                where buf_recipe.recipe-code = p-recipe-code
     3864           no-error.
     3865           if available buf_recipe
     3866           then do:
     3867               assign
     3868                   p-recipe-type = buf_recipe.recipe-type
     3869               .
     3870           end.
     3871           else do:
     3872               assign
     3873                   p-recipe-type = "":U
     3874               .
     3875           end.
     3876       end.
     3877       else do:
     3878           find first buf_fbr-recipe no-lock
     3879                where buf_fbr-recipe.doc-code      = p-fbr-doc-code
     3880                  and buf_fbr-recipe.recipe-code   = p-recipe-code
     3881           no-error.
     3882           if available buf_fbr-recipe
     3883           then do:
     3884               assign
     3885                   p-recipe-type = buf_fbr-recipe.recipe-type
     3886               .
     3887           end.
     3888           else do:
     3889               assign
     3890                   p-recipe-type = "":U
     3891               .
     3892           end.
     3893       end.
     3894   end.
     3895   end procedure.
     3896   PROCEDURE calc-comp-from-ingr :
     3897   define input parameter p-fbr-v-fbr-doc-line-recid           as recid        no-undo.
     3898   define input parameter p-fact-qnty                          as decimal      no-undo.
     3899   define output parameter p-comp-fbr-v-fbr-doc-line-recid     as recid        no-undo.
     3900   define output parameter p-comp-qnty                         as decimal      no-undo.
     3901       define variable v-ingr-qnty     as decimal       no-undo.
     3902       define buffer buf_i_fbr-line    for ub.fbr-line.
     3903       define buffer buf_fbr-line      for ub.fbr-line.
     3904       define buffer buf_recipe        for ub.fbr-recipe.
     3905       define buffer buf_recipe-gds    for ub.fbr-recipe-gds.
     3906   do
     3907   for buf_i_fbr-line
     3908     , buf_fbr-line
     3909     , buf_recipe
     3910     , buf_recipe-gds
     3911   on error undo, return error
     3912   :
     3913       find first buf_i_fbr-line no-lock
     3914            where recid( buf_i_fbr-line ) = p-fbr-v-fbr-doc-line-recid
     3915       .
     3916       find first buf_recipe no-lock
     3917            where buf_recipe.doc-code      = buf_i_fbr-line.doc-code
     3918              and buf_recipe.recipe-code   = buf_i_fbr-line.recipe-code
     3919       no-error.
     3920       if not available buf_recipe
     3921       then do:
     3922           message
     3923                   vss-workfile vss-revision vss-description
     3924               skip "В строке производства не указан рецепт."
     3925               skip "Невозможно рассчитать количество составного товара."
     3926               skip return-value
     3927               skip trim(error-status :get-message(1))
     3928                   trim(error-status :get-message(2))
     3929                   trim(error-status :get-message(3))
     3930           view-as alert-box error.
     3931           undo, return error .
     3932       end.
     3933       if buf_recipe.recipe-type = 'альтернатива':U
     3934       then do:
     3935           for each buf_fbr-line no-lock
     3936              where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     3937                and buf_fbr-line.trn-type    = buf_i_fbr-line.trn-type
     3938                and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     3939           on error undo, return error
     3940           :
     3941               find first buf_recipe-gds no-lock
     3942                    where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     3943                      and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     3944                      and buf_recipe-gds.artic       = buf_fbr-line.artic
     3945                      and buf_recipe-gds.prod-type   = buf_fbr-line.prod-type
     3946                      and buf_recipe-gds.prod-code   = buf_fbr-line.prod-code
     3947               .
     3948               assign
     3949                   p-comp-qnty         = p-comp-qnty       + ( buf_fbr-line.fact-qnty * buf_recipe-gds.brutto-qnty )
     3950               .
     3951           end.
     3952           assign
     3953               p-comp-qnty         = p-comp-qnty       / buf_recipe.qnty
     3954           .
     3955       end.
     3956       else do:
     3957           find first buf_recipe-gds no-lock
     3958                where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     3959                  and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     3960                  and buf_recipe-gds.artic       = buf_i_fbr-line.artic
     3961                  and buf_recipe-gds.prod-type   = buf_i_fbr-line.prod-type
     3962                  and buf_recipe-gds.prod-code   = buf_i_fbr-line.prod-code
     3963           .
     3964           assign
     3965               p-comp-qnty = p-fact-qnty / buf_recipe-gds.brutto-qnty * buf_recipe.qnty
     3966           .
     3967       end.
     3968       find first buf_fbr-line no-lock
     3969            where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     3970              and buf_fbr-line.is-comp     = yes
     3971              and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     3972       .
     3973       assign
     3974           p-comp-fbr-v-fbr-doc-line-recid = recid( buf_fbr-line )
     3975       .
     3976   end.
     3977   END PROCEDURE.
     3978   PROCEDURE get-temp_dressing-ingr-used-qnty :
     3979   define input parameter p-recipe-code    as character    no-undo.
     3980   define input parameter p-gds-code       as integer      no-undo.
     3981   define output parameter p-line-qnty     as decimal      no-undo.
     3982   define output parameter p-used-qnty     as decimal      no-undo.
     3983   define output parameter p-recipe-qnty   as decimal      no-undo.
     3984       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     3985   do
     3986   for buf_temp_dressing-ingr
     3987   on error undo, return error
     3988   :
     3989       find first buf_temp_dressing-ingr no-lock
     3990            where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     3991              and buf_temp_dressing-ingr.gds-code    = p-gds-code
     3992       no-error.
     3993       if available buf_temp_dressing-ingr
     3994       then do:
     3995           assign
     3996               p-line-qnty     = buf_temp_dressing-ingr.line-qnty
     3997               p-used-qnty     = buf_temp_dressing-ingr.used-qnty
     3998               p-recipe-qnty   = buf_temp_dressing-ingr.recipe-qnty
     3999           .
     4000       end.
     4001       else do:
     4002           assign
     4003               p-line-qnty     = 0
     4004               p-used-qnty     = 0
     4005               p-recipe-qnty   = 0
     4006           .
     4007       end.
     4008   end.
     4009   END PROCEDURE.
     4010   PROCEDURE fbrlib_adjust-recipe :
     4011   do
     4012   on error undo, return error
     4013   :
     4014   define input parameter parparentproc as widget-handle no-undo .
     4015   define input parameter p-fbrhist-handle as handle no-undo .
     4016   define input parameter p-doc-code       as character    no-undo.
     4017   define input parameter p-recipe-code    as character    no-undo.
     4018   define input parameter p-price-sale-obj-type as character no-undo .
     4019   define input parameter p-price-sale-obj-code as integer no-undo .
     4020       define variable v-recipe-qnty       as decimal      no-undo.
     4021       define variable v-comp-qnty         as decimal      no-undo.
     4022       define variable v-recipe-gds-qnty   as decimal      no-undo.
     4023       define variable v-ingr-qnty         as decimal      no-undo.
     4024       define variable v-qnty              as decimal      no-undo.
     4025       define variable v-coeff-waste       as decimal      no-undo.
     4026       define variable v-brutto-qnty       as decimal      no-undo.
     4027       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4028       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4029       define buffer buf_fbr-line          for ub.fbr-line.
     4030       define buffer buf_el_fbr-recipe-gds for ub.fbr-recipe-gds.
     4031       find first buf_fbr-recipe no-lock
     4032            where buf_fbr-recipe.doc-code      = p-doc-code
     4033              and buf_fbr-recipe.recipe-code   = p-recipe-code
     4034       .
     4035       assign
     4036           v-recipe-qnty = buf_fbr-recipe.qnty
     4037       .
     4038       find first buf_fbr-line no-lock
     4039            where buf_fbr-line.doc-code    = p-doc-code
     4040              and buf_fbr-line.is-comp     = yes
     4041              and buf_fbr-line.recipe-code = p-recipe-code
     4042       .
     4043       assign
     4044           v-comp-qnty = buf_fbr-line.fact-qnty
     4045       .
     4046       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     4047       then do:
     4048       end.
     4049       else do:
     4050           for each buf_fbr-recipe-gds no-lock
     4051              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     4052                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     4053           on error undo, return error
     4054           :
     4055               find first buf_fbr-line no-lock
     4056                    where buf_fbr-line.doc-code    = p-doc-code
     4057                      and buf_fbr-line.is-comp     = no
     4058                      and buf_fbr-line.recipe-code = p-recipe-code
     4059                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4060                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4061                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4062               .
     4063               if buf_fbr-line.fact-qnty / v-comp-qnty <> buf_fbr-recipe-gds.brutto-qnty / v-recipe-qnty
     4064               then do:
     4065                   do transaction
     4066                   on error undo, return error
     4067                   :
     4068                       find first buf_el_fbr-recipe-gds exclusive-lock
     4069                            where recid( buf_el_fbr-recipe-gds ) = recid( buf_fbr-recipe-gds )
     4070                       .
     4071                       assign
     4072                           buf_el_fbr-recipe-gds.calc-method   = 1
     4073                           buf_el_fbr-recipe-gds.brutto-qnty   = buf_fbr-line.fact-qnty * v-recipe-qnty / v-comp-qnty
     4074                       .
     4075                       run fbrlib-calc-brutto in this-procedure (
     4076                             input buf_fbr-recipe.recipe-type
     4077                           , input 0
     4078                           , input buf_el_fbr-recipe-gds.coeff-value
     4079                           , input buf_el_fbr-recipe-gds.coeff-waste
     4080                           , input buf_el_fbr-recipe-gds.brutto-qnty
     4081                           , input 1
     4082                           , output buf_el_fbr-recipe-gds.qnty
     4083                           , output buf_el_fbr-recipe-gds.coeff-waste
     4084                           , output buf_el_fbr-recipe-gds.brutto-qnty
     4085                           , output buf_el_fbr-recipe-gds.calc-method
     4086                       ).
     4087                   end.
     4088               end.
     4089           end.
     4090           run fbrlib_adjust-doc-lines in this-procedure (
     4091                 input parparentproc
     4092               , input p-fbrhist-handle
     4093               , input p-doc-code
     4094               , input p-recipe-code
     4095               , input p-price-sale-obj-type
     4096               , input p-price-sale-obj-code
     4097           ).
     4098       end.
     4099   end.
     4100   END PROCEDURE.
     4101   PROCEDURE fbrlib_adjust-doc-lines :
     4102   define input parameter parparentproc as widget-handle no-undo .
     4103   define input parameter p-fbrhist-handle as handle no-undo .
     4104   define input parameter p-doc-code       as character    no-undo.
     4105   define input parameter p-recipe-code    as character    no-undo.
     4106   define input parameter p-price-sale-obj-type as character no-undo .
     4107   define input parameter p-price-sale-obj-code as integer no-undo .
     4108   define variable v-comp-qnty         as decimal      no-undo.
     4109   define variable v-trn-type          as character    no-undo.
     4110   define variable v-ingr-qnty         as decimal      no-undo.
     4111   define variable v-recipe-qnty       as decimal      no-undo.
     4112   define variable v-fbr-v-fbr-doc-line-recid    as recid        no-undo.
     4113   define buffer buf_fbr-recipe        for ub.fbr-recipe.
     4114   define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     4115   define buffer buf_fbr-line          for ub.fbr-line.
     4116   define buffer buf_coeff_fbr-line    for ub.fbr-line.
     4117   define buffer buf_goods             for ub.goods.
     4118   define buffer buf_fbr-doc           for ub.fbr-doc.
     4119   do
     4120   for buf_fbr-recipe
     4121     , buf_fbr-recipe-gds
     4122     , buf_fbr-line
     4123     , buf_coeff_fbr-line
     4124     , buf_goods
     4125     , buf_fbr-doc
     4126   on error undo, return error
     4127   :
     4128       find first buf_fbr-line no-lock
     4129            where buf_fbr-line.doc-code      = p-doc-code
     4130              and buf_fbr-line.is-comp       = yes
     4131              and buf_fbr-line.recipe-code   = p-recipe-code
     4132       .
     4133       find first buf_fbr-doc no-lock
     4134            where buf_fbr-doc.doc-code      = p-doc-code
     4135       .
     4136       assign
     4137           v-comp-qnty = buf_fbr-line.fact-qnty
     4138           v-trn-type  = buf_fbr-line.trn-type
     4139       .
     4140       find first buf_fbr-recipe no-lock
     4141            where buf_fbr-recipe.doc-code    = p-doc-code
     4142              and buf_fbr-recipe.recipe-code = p-recipe-code
     4143       .
     4144       assign
     4145       v-recipe-qnty = buf_fbr-recipe.qnty
     4146       .
     4147       do transaction
     4148       on error undo, return error
     4149       :
     4150           for each buf_fbr-recipe-gds no-lock
     4151              where buf_fbr-recipe-gds.doc-code      = p-doc-code
     4152                and buf_fbr-recipe-gds.recipe-code   = p-recipe-code
     4153           on error undo, return error
     4154           :
     4155               find first buf_fbr-line no-lock
     4156                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4157                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4158                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4159                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4160                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4161               no-error.
     4162               if not available buf_fbr-line
     4163               then do:
     4164                   find first buf_goods no-lock
     4165                        where buf_goods.artic      = buf_fbr-recipe-gds.artic
     4166                          and buf_goods.prod-type  = buf_fbr-recipe-gds.prod-type
     4167                          and buf_goods.prod-code  = buf_fbr-recipe-gds.prod-code
     4168                   .
     4169                   run str/fbr-crln.p (
     4170                         input parparentproc
     4171                       , input recid( buf_fbr-doc )
     4172                       , input recid( buf_goods )
     4173                       , input buf_fbr-recipe-gds.recipe-code
     4174                       , input v-trn-type
     4175                       , input no
     4176                       , input no
     4177                       , input buf_fbr-doc.obj-type
     4178                       , input buf_fbr-doc.obj-code
     4179                       , output v-fbr-v-fbr-doc-line-recid
     4180                   ).
     4181                   find first buf_fbr-line no-lock
     4182                        where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     4183                          and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     4184                          and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     4185                          and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     4186                          and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     4187                   no-error.
     4188                   if not available buf_fbr-line
     4189                   then do:
     4190                       undo, return error substitute("Не удалось создать строку документа производства &1 &2&3&4"
     4191                                                      , p-doc-code
     4192                                                      , buf_fbr-recipe-gds.artic
     4193                                                      , buf_fbr-recipe-gds.prod-type
     4194                                                      , buf_fbr-recipe-gds.prod-code).
     4195                   end.
     4196               end.
     4197               find first buf_coeff_fbr-line exclusive-lock
     4198                    where recid( buf_coeff_fbr-line ) = recid( buf_fbr-line )
     4199               .
     4200               if buf_coeff_fbr-line.calc-method <> buf_fbr-recipe-gds.calc-method
     4201               or buf_coeff_fbr-line.coeff-value <> buf_fbr-recipe-gds.coeff-value
     4202               or buf_coeff_fbr-line.coeff-waste <> buf_fbr-recipe-gds.coeff-waste
     4203               then do:
     4204                   assign
     4205                       buf_coeff_fbr-line.calc-method = buf_fbr-recipe-gds.calc-method
     4206                       buf_coeff_fbr-line.coeff-value = buf_fbr-recipe-gds.coeff-value
     4207                       buf_coeff_fbr-line.coeff-waste = buf_fbr-recipe-gds.coeff-waste
     4208                   .
     4209               end.
     4210           end.
     4211       end.
     4212       define variable v-need-goods    as logical       no-undo.
     4213       define variable v-need-goods-list       as character     no-undo.
     4214       define variable v-need-goods-qnty-list  as character     no-undo.
     4215       find first buf_fbr-line no-lock
     4216            where buf_fbr-line.doc-code    = buf_fbr-doc.doc-code
     4217              and buf_fbr-line.is-comp     = yes
     4218              and buf_fbr-line.recipe-code = p-recipe-code
     4219       .
     4220       run str/fbr-qnty.p (
     4221             input parparentproc
     4222           , input p-fbrhist-handle
     4223           , input recid( buf_fbr-doc )
     4224           , input recid( buf_fbr-line )
     4225           , input no
     4226           , input "ingr"
     4227           , input no
     4228           , input p-price-sale-obj-type
     4229           , input p-price-sale-obj-code
     4230           , input no
     4231           , input no
     4232           , input no
     4233           , output v-need-goods
     4234           , output v-need-goods-list
     4235           , output v-need-goods-qnty-list
     4236       ).
     4237   end.
     4238   END PROCEDURE.
     4239   procedure fbrlib_check-before-close :
     4240   define input parameter p-doc-code as character no-undo .
     4241   define variable same-sale as decimal no-undo .
     4242   define variable is-waste as logical no-undo .
     4243   define variable fix-price as logical no-undo .
     4244   define buffer buf_fbr-doc for ub.fbr-doc.
     4245   define buffer buf_fbr-line for ub.fbr-line.
     4246   define buffer buf_goods for ub.goods.
     4247   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     4248   do
     4249   on error undo, return error
     4250   :
     4251     for each buf_fbr-line no-lock
     4252         where buf_fbr-line.doc-code = p-doc-code
     4253       , each buf_goods no-lock
     4254         where buf_goods.artic     = buf_fbr-line.artic
     4255           and buf_goods.prod-type = buf_fbr-line.prod-type
     4256           and buf_goods.prod-code = buf_fbr-line.prod-code
     4257     break by buf_fbr-line.prod-type
     4258           by buf_fbr-line.prod-code
     4259           by buf_fbr-line.artic
     4260     :
     4261       if first-of (buf_fbr-line.artic)
     4262       then do:
     4263         assign
     4264         same-sale = buf_fbr-line.price-sale
     4265         is-waste = (buf_fbr-line.rsrv-qnty = ?)
     4266         fix-price = buf_fbr-line.is-calc
     4267         .
     4268       end.
     4269       if same-sale <> buf_fbr-line.price-sale
     4270       then do:
     4271           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром должна быть указана одна и та же цена продажи."
     4272                                         ,p-doc-code
     4273                                         ,buf_goods.artic
     4274                                         ,buf_goods.gds-name
     4275                                         ,chr(10)).
     4276       end.
     4277       if fix-price <> buf_fbr-line.is-calc then do:
     4278           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром цена должна быть фиксирована или нет."
     4279                                         ,p-doc-code
     4280                                         ,buf_goods.artic
     4281                                         ,buf_goods.gds-name
     4282                                         ,chr(10)).
     4283       end.
     4284       if is-waste <> (buf_fbr-line.rsrv-qnty = ?)
     4285       then do:
     4286         undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа этот товар должен быть отходом либо не отходом."
     4287                                         ,p-doc-code
     4288                                         ,buf_goods.artic
     4289                                         ,buf_goods.gds-name
     4290                                         ,chr(10)).
     4291       end.
     4292       if buf_fbr-line.rsrv-qnty <> ?
     4293       and buf_goods.gds-type <> 'у':U
     4294       and ( buf_fbr-line.price-sale <= 0 or buf_fbr-line.price-sale = ?  )
     4295       and buf_fbr-line.fact-qnty <> 0
     4296       then do:
     4297         if buf_fbr-line.trn-type     = 'при':U  then for first buf_fbr-doc where buf_fbr-doc.doc-code =  p-doc-code no-lock:
     4298           if  can-find(first buf_fbr-gds-obj no-lock where
     4299                   buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     4300               AND buf_fbr-gds-obj.obj-type = buf_fbr-doc.obj-type
     4301               AND buf_fbr-gds-obj.obj-code = buf_fbr-doc.obj-code
     4302               and buf_fbr-gds-obj.is-null-price  )  then .
     4303                     else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     4304                                         ,p-doc-code
     4305                                         ,buf_goods.artic
     4306                                         ,buf_goods.gds-name
     4307                                         ,chr(10)
     4308                                         ,buf_fbr-line.recipe-code
     4309                                         ).
     4310         end.
     4311         else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     4312                                         ,p-doc-code
     4313                                         ,buf_goods.artic
     4314                                         ,buf_goods.gds-name
     4315                                         ,chr(10)
     4316                                         ,buf_fbr-line.recipe-code
     4317                                         ).
     4318       end.
     4319     end.
     4320   end.
     4321   end procedure.
     4322   procedure proc-alt-shift-f2:
     4323     if not ibs.th.gbl.gbl-var:rcode
     4324   then
     4325     run gbl\inidebug.p .
     4326   end.
     4327   procedure proc-alt-shift-f3:
     4328     run gbl/prvssinf.p
     4329       ( input this-procedure
     4330       ) .
     4331   end.
     4332   define variable v-inform-launched as logical no-undo initial false .
     4333   procedure proc-alt-shift-f4:
     4334     define variable v-action as character no-undo .
     4335     if v-inform-launched = false then do:
     4336       assign
     4337         v-inform-launched = true
     4338       .
     4339       run gbl/d-inform.w
     4340         (  input self
     4341         ,  input this-procedure
     4342         , output v-action
     4343         ) no-error .
     4344       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     4345       assign
     4346         v-inform-launched = false
     4347       .
     4348     end.
     4349   end.
     4350   procedure proc-alt-f1:
     4351     run gbl/corrhelp.p
     4352       (input this-procedure
     4353       ) .
     4354   end .
     4355   on alt-shift-f2 anywhere do:
     4356     run proc-alt-shift-f2.
     4357   end.
     4358   on alt-shift-f3 anywhere do:
     4359     run proc-alt-shift-f3 in this-procedure .
     4360   end.
     4361   on alt-shift-f4 anywhere do:
     4362     run proc-alt-shift-f4 in this-procedure.
     4363   end.
     4364   on alt-f1 anywhere do:
     4365     run proc-alt-f1 in this-procedure .
     4366   end.
