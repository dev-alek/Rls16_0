     1770   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1771   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1772   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1773   on help of frame Dialog-Frame
     1774   do:
     1775     run gbl/app_help.p
     1776       (input this-procedure :file-name
     1777       ,input ''
     1778       ,input ?
     1779       ) no-error.
     1780     if error-status :error then do:
     1781       message
     1782         "Ошибка при вызове помощи"
     1783         error-status :get-message(1)
     1784         view-as alert-box .
     1785     end.
     1786   end.
     1787   run minbtn-set in this-procedure .
     1788   on choose of b-help in frame Dialog-Frame
     1789   do:
     1790     apply "help":u to frame Dialog-Frame .
     1791   end.
     1792   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1793   procedure minbtn-set :
     1794       do
     1795           on error undo, return error return-value
     1796           :
     1797           define variable ii              as integer       no-undo .
     1798           define variable fh              as widget-handle no-undo .
     1799           define variable hh              as widget-handle no-undo .
     1800           define variable v-h             as handle        extent 4 no-undo .
     1801           define variable v-name-button   as character     no-undo .
     1802           define variable v-help-old-x    as decimal       no-undo .
     1803           define variable v-help-old-y    as decimal       no-undo .
     1804           define variable v-help-old-size as decimal       no-undo .
     1805           define variable v-frame-width   as decimal       no-undo .
     1806           define variable jj              as integer       no-undo .
     1807           do
     1808               on error undo, return error
     1809               :
     1810               assign
     1811                   v-frame-width = frame Dialog-Frame:width - 0.3
     1812                   fh            = frame Dialog-Frame:first-child
     1813                   hh            = fh:first-child
     1814                   ii            = 1
     1815                   .
     1816               do while valid-handle(hh):
     1817                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1818                   do:
     1819                       case lc(hh:name) :
     1820                           when "b-help" then
     1821                               do:
     1822                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1823                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1824                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1825                                   hh:TOOLTIP = "Помощь" .
     1826                                   v-help-old-x = hh:column .
     1827                                   v-help-old-y = hh:row    .
     1828                                   v-help-old-size = hh:width .
     1829                                   hh:width-chars = 2.5 .
     1830                               end.
     1831                           when "b-print" then
     1832                               do:
     1833                                   hh:load-image("cmp/b-print.bmp":u) .
     1834                                   hh:TOOLTIP = "Печать" .
     1835                                   v-h[ii] = hh:handle .
     1836                                   ii = ii + 1 .
     1837                                   hh:width-chars = 3 .
     1838                               end.
     1839                           when "b-history" or
     1840                           when "b-hist" then
     1841                               do:
     1842                                   hh:load-image("cmp/b-hist.bmp":u) .
     1843                                   hh:TOOLTIP = "История" .
     1844                                   v-h[ii] = hh:handle .
     1845                                   ii = ii + 1 .
     1846                                   hh:width-chars = 3 .
     1847                               end.
     1848                           when "b-sch" then
     1849                               do:
     1850                                   hh:load-image("cmp/b-sch.bmp":u) .
     1851                                   hh:TOOLTIP = "Установка Фильтра" .
     1852                                   v-h[ii] = hh:handle .
     1853                                   ii = ii + 1 .
     1854                                   hh:width-chars = 3 .
     1855                               end.
     1856                           when "b-hist-user" then
     1857                               do:
     1858                                   hh:load-image("cmp/b-hist.bmp":u) .
     1859                                   hh:TOOLTIP = "История пользователя" .
     1860                                   ii = ii + 1 .
     1861                               end.
     1862                       end case.
     1863                   end.
     1864                   hh = hh:next-sibling.
     1865               end.
     1866               b-help:column = v-frame-width - b-help:width-chars.
     1867               jj = 0.
     1868               repeat ii = 4 to 1 by -1 :
     1869                   if valid-handle (v-h[ii] ) then
     1870                   do:
     1871                       jj  = jj + 1 .
     1872                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1873                       v-h[ii]:row    = v-help-old-y .
     1874                   end.
     1875               end.
     1876           end.
     1877       end.
     1878   end procedure.
     1879   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1880   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1881   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1882   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1883   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1884   define variable v-diasize-current-frame-height as decimal   no-undo .
     1885   define variable v-diasize-change-size          as logical   no-undo .
     1886   define variable v-diasize-resize-button        as handle    no-undo .
     1887   define variable v-diasize-wndmax               as logical   no-undo .
     1888   define variable v-diasize-wndstore             as logical   no-undo .
     1889   define variable v-diasize-proc-name            as character no-undo .
     1890   define variable v-diasize-browse-handle        as handle    no-undo .
     1891   define variable v-diasize-browse-number        as integer   no-undo .
     1892   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1893   define temp-table temp-diasize-handle no-undo
     1894     field handle-value  as handle
     1895     field save-position as decimal
     1896     index xpk is primary unique handle-value
     1897     .
     1898   define temp-table temp-browse-handle no-undo
     1899     field browse-type   as character
     1900     field browse-number as integer
     1901     field browse-handle as handle
     1902     field original-size as decimal
     1903     index xpk is primary unique browse-type browse-number
     1904     index xie browse-type browse-handle
     1905   .
     1906   procedure diasize_change-height :
     1907     define input  parameter p-change-value  as decimal   no-undo .
     1908     define input  parameter p-move-resize   as logical   no-undo .
     1909     define variable v-field-group-handle    as handle    no-undo .
     1910     define variable v-object-handle         as handle    no-undo .
     1911     define variable v-frame-height          as decimal   no-undo .
     1912     define variable v-frame-virtual-height  as decimal   no-undo .
     1913     define variable v-browse-height         as decimal   no-undo .
     1914     define variable v-window-height         as decimal   no-undo .
     1915     define variable v-window-virtual-height as decimal   no-undo .
     1916     define variable v-change-sign           as integer   no-undo .
     1917     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1918     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1919     if p-change-value > 0
     1920     then do:
     1921       if frame Dialog-Frame :height + p-change-value
     1922           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1923       then do:
     1924         assign
     1925           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1926                           - (frame Dialog-Frame :height-chars)
     1927         .
     1928         if p-change-value <= 0
     1929         then do:
     1930           run diasize_position-resize-button in this-procedure .
     1931           return .
     1932         end.
     1933       end.
     1934     end.
     1935     if p-change-value < 0
     1936     then do:
     1937       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1938       then do:
     1939         assign
     1940           p-change-value = v-diasize-orig-frame-height
     1941                          - (frame Dialog-Frame :height-chars)
     1942         .
     1943         if p-change-value >= 0
     1944         then do:
     1945           run diasize_position-resize-button in this-procedure .
     1946           return .
     1947         end.
     1948       end.
     1949     end.
     1950     if p-change-value >= 0
     1951     then do:
     1952       assign
     1953         v-change-sign = 1
     1954       .
     1955     end.
     1956     else do:
     1957       assign
     1958         v-change-sign = -1
     1959       .
     1960     end.
     1961     assign
     1962       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1963     .
     1964     if p-change-value = 0
     1965     then do:
     1966       run diasize_position-resize-button in this-procedure .
     1967       return .
     1968     end.
     1969     move_block:
     1970     do
     1971     on error undo move_block, retry move_block
     1972     :
     1973       if retry
     1974       then do:
     1975         do
     1976         on error undo move_block, leave move_block
     1977         :
     1978           if p-change-value > 0
     1979           then do:
     1980             for each buf_temp-diasize-handle
     1981             on error undo, next
     1982             :
     1983               assign
     1984                 v-object-handle = buf_temp-diasize-handle.handle-value
     1985               .
     1986               if v-object-handle <> v-diasize-resize-button
     1987               then do:
     1988                 assign
     1989                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1990                 .
     1991               end.
     1992             end.
     1993             assign
     1994               v-diasize-browse-handle :height = v-browse-height
     1995             .
     1996             for each buf_temp-browse-handle
     1997               where buf_temp-browse-handle.browse-type = 'height':u
     1998             on error undo, next
     1999             :
     2000               assign
     2001                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2002               .
     2003             end.
     2004             assign
     2005               frame Dialog-Frame :height = v-frame-height
     2006             .
     2007             if frame Dialog-Frame :scrollable = true
     2008             then do:
     2009               assign
     2010                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2011               .
     2012             end.
     2013             run diasize_position-resize-button in this-procedure .
     2014           end.
     2015           else do:
     2016             if frame Dialog-Frame :scrollable = true
     2017             then do:
     2018               assign
     2019                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2020               .
     2021             end.
     2022             assign
     2023               frame Dialog-Frame :height = v-frame-height
     2024             .
     2025             assign
     2026               v-diasize-browse-handle :height = v-browse-height
     2027             .
     2028             for each buf_temp-browse-handle
     2029               where buf_temp-browse-handle.browse-type = 'height':u
     2030             on error undo, next
     2031             :
     2032               assign
     2033                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2034               .
     2035             end.
     2036             for each buf_temp-diasize-handle
     2037             on error undo, next
     2038             :
     2039               assign
     2040                 v-object-handle = buf_temp-diasize-handle.handle-value
     2041               .
     2042               if v-object-handle <> v-diasize-resize-button
     2043               then do:
     2044                 assign
     2045                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2046                 .
     2047               end.
     2048             end.
     2049             run diasize_position-resize-button in this-procedure .
     2050           end.
     2051           assign
     2052             v-diasize-change-size = false
     2053           .
     2054           leave move_block .
     2055         end.
     2056       end.
     2057       assign
     2058         v-diasize-need-full-display = true
     2059       .
     2060       if v-diasize-change-size = false
     2061       then do:
     2062         assign
     2063           v-diasize-change-size = true
     2064         .
     2065       end.
     2066       else do:
     2067         return .
     2068       end.
     2069       assign
     2070         v-frame-height = frame Dialog-Frame :height
     2071         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2072         v-browse-height = v-diasize-browse-handle :height
     2073       .
     2074       for each buf_temp-browse-handle
     2075         where buf_temp-browse-handle.browse-type = 'height':u
     2076       :
     2077         assign
     2078           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2079         .
     2080       end.
     2081       for each buf_temp-diasize-handle
     2082       :
     2083         delete buf_temp-diasize-handle .
     2084       end.
     2085       assign
     2086         v-field-group-handle = frame Dialog-Frame :first-child
     2087       .
     2088       do while valid-handle(v-field-group-handle)
     2089       :
     2090         assign
     2091           v-object-handle = v-field-group-handle :first-child
     2092         .
     2093         do while valid-handle(v-object-handle)
     2094         :
     2095           if  v-object-handle <> v-diasize-browse-handle :handle
     2096           and can-query(v-object-handle, "row")
     2097           and can-query(v-object-handle, "height")
     2098           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2099           then do:
     2100             find first buf_temp-browse-handle
     2101               where buf_temp-browse-handle.browse-type   = 'height':u
     2102                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2103               no-error .
     2104             if available buf_temp-browse-handle
     2105             then do:
     2106             end.
     2107             else do:
