     2229           or error-status :get-message(1) <> ""
     2230           then do:
     2231             undo move_block, retry move_block .
     2232           end.
     2233         end.
     2234         assign
     2235           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2236           no-error .
     2237         if error-status :error
     2238         or error-status :get-message(1) <> ""
     2239         then do:
     2240           undo move_block, retry move_block .
     2241         end.
     2242         if frame Dialog-Frame :scrollable = true
     2243         then do:
     2244           assign
     2245             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2246             no-error .
     2247           if error-status :error
     2248           or error-status :get-message(1) <> ""
     2249           then do:
     2250             undo move_block, retry move_block .
     2251           end.
     2252         end.
     2253       end.
     2254       if p-move-resize = true
     2255       then do:
     2256         run diasize_position-resize-button in this-procedure .
     2257       end.
     2258       if v-diasize-wndstore = true
     2259       then do:
     2260         if connected("ub") = true
     2261         then do:
     2262           define variable v-cntxt-db-num        as integer   no-undo .
     2263           define variable v-cntxt-userid        as character no-undo .
     2264           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2265                                             , OUTPUT v-cntxt-userid
     2266                                             ) .
