     1673         FIND PS_c-fin-statement where
     1674              recid (ps_c-fin-statement) = recid(X_c-fin-statement) exclusive.
     1675         if ps_c-fin-statement.PS <> input frame Dialog-Frame ed-notes then
     1676         assign
     1677         ps_c-fin-statement.PS = input frame Dialog-Frame ed-notes
     1678         .
     1679      END.
