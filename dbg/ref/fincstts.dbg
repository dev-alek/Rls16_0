     2268             (input  v-cntxt-db-num
     2269             ,input  v-cntxt-userid
     2270             ,input  v-diasize-proc-name
     2271             ,input  'height':u
     2272             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2273             ) .
     2274         end.
     2275       end.
     2276     end.
     2277     assign
