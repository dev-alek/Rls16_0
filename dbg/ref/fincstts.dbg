     4899                  , INPUT (filter-point + chr(4) +
     4900                           filter-label + chr(4) +
     4901                           string(yes))
     4902                  , INPUT tbl
     4903                  , INPUT join-tbl
     4904                  , INPUT fld
     4905                  , INPUT lab
     4906                  , INPUT spr
     4907                  , INPUT dim ).
     4908     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
