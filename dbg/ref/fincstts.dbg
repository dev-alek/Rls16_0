      132     run proc-alt-f1 in this-procedure .
      133   end.
      134   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      135   define variable c-point  as character no-undo .
      136   define variable tbl      as character no-undo .
      137   define variable join-tbl as character no-undo .
      138   define variable fld      as character no-undo .
      139   define variable lab      as character no-undo .
      140   define variable spr      as character no-undo .
      141   define variable dim      as character no-undo .
      142   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      143   procedure cur-time :
      144      define output parameter p-today as date      no-undo .
      145      define output parameter p-time  as integer   no-undo .
      146     do
      147     on error undo, return error
      148     :
      149       define variable v-date1 as date      no-undo .
      150       define variable v-date2 as date      no-undo .
      151       define variable v-time  as integer   no-undo .
      152       assign
      153         v-date1 = today
      154         v-time  = time
      155         v-date2 = today
      156       .
      157       if v-date1 <> v-date2
      158       then do:
      159         assign
      160           v-date1 = today
      161           v-time  = v-time
      162         .
      163       end.
      164       assign
      165         p-today = v-date1
      166         p-time  = v-time
      167       .
      168     end.
      169   end.
      170   function cur-time-date returns character
      171   :
      172     return string(today, '99/99/9999':U) .
      173   end.
      174   function cur-time-mjd returns decimal
      175   :
      176     define variable v-date as date      no-undo .
      177     define variable v-time as integer   no-undo .
      178     run cur-time in this-procedure
      179       (output v-date
      180       ,output v-time
      181       ) .
      182     return integer(v-date) - 2400002 + (v-time / 86400) .
      183   end.
      184   function cur-time-get-ending-index returns integer
      185   (input p-number as integer
      186   )
      187   :
      188     if p-number < 0
      189     or p-number = ?
      190     then do:
      191       return 1 .
      192     end.
      193     define variable v-rest as integer   no-undo .
      194     assign
      195       p-number = p-number modulo 100
      196     .
      197     if p-number < 20
      198     then do:
      199       assign
      200         v-rest = p-number
      201       .
      202     end.
      203     else do:
      204       assign
      205         v-rest = p-number modulo 10
      206       .
      207     end.
      208     case v-rest :
      209       when 1
      210       then do:
      211         return 2 .
      212       end.
      213       when 2 or
      214       when 3 or
      215       when 4
      216       then do:
      217         return 3 .
      218       end.
      219       otherwise do:
      220         return 1 .
      221       end.
      222     end case .
      223   end.
      224   procedure cur-time-mjd-to-date :
      225      define input  parameter i-mjd-diff as decimal no-undo.
      226      define output parameter o-Date     as date    no-undo.
      227      define output parameter o-Time     as integer no-undo.
      228      define variable v-day-number as integer   no-undo .
      229      if    i-mjd-diff < 0
      230         or i-mjd-diff = ?
      231      then do:
      232         return "?" .
      233      end.
      234      assign
      235         v-day-number = truncate(i-mjd-diff,0).
      236         o-Date = date(v-day-number + 2400002).
      237         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      238     .
      239   end.
      240   function cur-time-mjd-to-string returns character
      241   (input p-mjd-diff as decimal
      242   )
      243   :
      244     define variable v-day-number as integer   no-undo .
      245     define variable v-seconds    as integer   no-undo .
      246     define variable v-hour       as integer   no-undo .
      247     define variable v-min        as integer   no-undo .
      248     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      249     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      250     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      251     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      252     if p-mjd-diff < 0
      253     or p-mjd-diff = ?
      254     then do:
      255       return "?" .
      256     end.
      257     assign
      258       v-day-number = integer(truncate(p-mjd-diff,0))
      259       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      260     .
      261     if v-seconds > 86400
      262     then do:
      263       assign
      264         v-seconds = 86400 - 1
      265       .
      266     end.
      267     if v-seconds < 0
      268     then do:
      269       assign
      270         v-seconds = 0
      271       .
      272     end.
      273     assign
      274       v-hour = truncate(v-seconds / 3600, 0)
      275     .
      276     assign
      277       v-seconds = v-seconds modulo 3600
      278     .
      279     assign
      280       v-min = truncate(v-seconds / 60, 0)
      281     .
      282     assign
      283       v-seconds = v-seconds modulo 60
      284     .
      285     return
      286         (if v-day-number <> 0
      287           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      288           else ""
      289         )
      290       + (if v-day-number <> 0 or v-hour <> 0
      291           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      292           else ""
      293         )
      294       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      295           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      296           else ""
      297         )
      298       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      299       .
      300   end.
      301   function cur-time-string returns character
      302   :
      303     define variable v-date as date      no-undo .
      304     define variable v-time as integer   no-undo .
      305     run cur-time in this-procedure
      306       (output v-date
      307       ,output v-time
      308       ) .
      309     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      310   end.
      311   function cur-time-string-sec returns character
      312   :
      313     define variable v-date as date      no-undo .
      314     define variable v-time as integer   no-undo .
      315     run cur-time in this-procedure
      316       (output v-date
      317       ,output v-time
      318       ) .
      319     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      320   end.
      321   function cur-time-custom  returns character
      322   (input p-prefix as character
      323   ,input p-date-format as character
      324   ,input p-delimiter as character
      325   ,input p-time-format as character
      326   ,input p-suffix as character
      327   )
      328   :
      329     define variable v-date as date      no-undo .
      330     define variable v-time as integer   no-undo .
      331     run cur-time in this-procedure
      332       (output v-date
      333       ,output v-time
      334       ) .
      335     return
      336       p-prefix
      337       + string(v-date, p-date-format)
      338       + p-delimiter
      339       + string(v-time, p-time-format)
      340       + p-suffix
      341       .
      342   end.
      343   function cur-time-print  returns character
      344   :
      345     define variable v-date as date      no-undo .
      346     define variable v-time as integer   no-undo .
      347     run cur-time in this-procedure
      348       (output v-date
      349       ,output v-time
      350       ) .
      351     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      352   end.
      353   function cur-time-datetime returns datetime
      354   :
      355     define variable v-char as character no-undo .
      356     define variable v-datetime as datetime no-undo .
      357     v-char = cur-time-string().
      358     v-datetime = datetime(v-char).
      359     return  v-datetime.
      360   end.
      361   function cur-time-string-msec returns character
      362   :
      363     define variable v-date as datetime  no-undo .
      364     v-date = now.
      365     return string(v-date) .
      366   end.
      367   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      368   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      369   define new shared variable RepPathName        as character no-undo .
      370   define new shared variable PrintRubl          as logical   no-undo .
      371   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      372   define variable v-waitfram-action01         as character   no-undo .
      373   define variable v-waitfram-action02         as character   no-undo .
      374   define variable v-waitfram-action03         as character   no-undo .
      375   define variable mWaitFramTextBeg            as character   no-undo.
      376   define variable mWaitFramTextEnd            as character   no-undo.
      377   define variable mWaitFramView               as logical     no-undo.
      378   define variable mWaitProcEvent              as logical     no-undo init yes.
      379   define variable mWaitFramInterval           as integer     no-undo init 1 .
      380   define variable mWaitFramStop               as logical     no-undo.
      381   define variable mWaitFramStopUser           as logical     no-undo.
      382   define variable mWaitFramStopTimeOut        as logical     no-undo.
      383   define variable mWaitFramStartProc          as datetime-tz no-undo.
      384   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      385   define button B-WaitFramStop auto-end-key
      386        label "Стоп"
      387        size 10 by 1 tooltip "Остоновить процесс".
      388   define button B-viewProcInfo
      389        label "Информация"
      390        size 15 by 1 tooltip "Информация о процесс".
      391   define frame waitfram
      392     v-waitfram-action01 format "x(72)" no-label skip
      393     v-waitfram-action02 format "x(72)" no-label skip
      394     v-waitfram-action03 format "x(72)" no-label skip
      395     B-viewProcInfo
      396     B-WaitFramStop at row 4 col 30
      397     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      398     .
      399   define new global shared variable mBatchMode as logical no-undo init ?.
      400   define variable mFramBachModHandle as handle no-undo.
      401   mFramBachModHandle = frame waitfram:handle.
      402   define variable mFameOldVis as logical no-undo.
      403   define variable mVisCUrentVin as logical no-undo.
      404   if session:batch-mode
      405   then
      406      mBatchMode = yes.
      407   if mBatchMode = ? then do:
      408     mVisCUrentVin = current-window:visible.
      409     mFameOldVis = mFramBachModHandle:visible.
      410     mFramBachModHandle:visible  = yes.
      411     mBatchMode = mFramBachModHandle:visible ne yes.
      412     mFramBachModHandle:visible = mFameOldVis.
      413     current-window:visible = mVisCUrentVin.
      414   end.
      415    if  log-manager:logfile-name ne ?
      416     then DO:
      417         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      418         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      419         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      420     end.
      421   on choose of B-WaitFramStop in frame waitfram
      422   do:
      423     mWaitFramStop = yes.
      424     mWaitFramStopUser = yes.
      425   end.
      426   function waitfram-check-timeout returns logical():
      427      define variable vtime as int64 no-undo.
      428      if mWaitFramStopTimeOut
      429      then
      430         return yes.
      431      vtime = ( now - mWaitFramStartProc ) / 1000 .
      432      if     mWaitFramTimeOut ne ?
      433         and mWaitFramTimeOut ne 0
      434         and mWaitFramTimeOut lt vtime
      435      then do:
      436         mWaitFramStopTimeOut = yes.
      437      end.
      438      return mWaitFramStopTimeOut.
      439   end.
      440   procedure waitfram-hide :
      441     if not session:batch-mode
      442     then do
      443     on error undo, return error return-value
      444     :
      445       pause 0 before-hide .
      446       if not mBatchMode then
      447         hide frame waitfram .
      448     if     not mWaitFramView
      449        and mWaitProcEvent
      450     then
      451       process events .
      452     end.
      453   end procedure.
      454   procedure waitfram-show :
      455     define input  parameter p-message as character no-undo .
      456     define variable v-left-margin as integer   no-undo .
      457     if not session:batch-mode
      458     then do
      459     on error undo, return error return-value
      460     :
      461       if length(p-message) <= 70 then do:
      462         assign
      463           v-left-margin = integer((70 - length(p-message)) / 2)
      464         .
      465         assign
      466           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      467         .
      468         assign
      469           v-waitfram-action01 = " "
      470           v-waitfram-action02 = " "
      471                                    + fill(" ", v-left-margin)
      472                                    + p-message
      473           v-waitfram-action03 = " "
      474         .
      475       end.
      476       else do:
      477         define variable vRindex1 as integer no-undo.
      478         define variable vRindex2 as integer no-undo.
      479         vRindex1 = r-index(p-message," ",70).
      480         if vRindex1 = 0
      481         then
      482            vRindex1 = 70.
      483         if length(p-message)  <= vRindex1 + 70 then do:
      484           assign
      485             v-waitfram-action01 = " "
      486             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      487             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      488           .
      489         end.
      490         else do:
      491           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      492           if vRindex2 <= vRindex1
      493           then
      494              vRindex2 = vRindex1 + 70.
      495           assign
      496             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      497             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      498             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      499           .
      500         end.
      501       end.
      502       B-viewProcInfo:visible   in frame waitfram = no.
      503       B-viewProcInfo:sensitive in frame waitfram = no.
      504       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      505       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      506       if  (   mWaitFramView
      507          or  mWaitProcEvent)
      508          and not mBatchMode
      509       then
      510          display
      511             v-waitfram-action01 skip
      512             v-waitfram-action02 skip
      513             v-waitfram-action03 skip
      514          with frame waitfram .
      515       if     mWaitFramView
      516          then do:
      517             if     mWaitFramInterval ne ?
      518                and not mBatchMode
      519             then
      520                wait-for go of frame waitfram pause mWaitFramInterval.
      521          end.
      522          else
      523             if     mWaitProcEvent
      524                and not mBatchMode
      525             then
      526                process events .
      527     end.
      528   end procedure.
      529      procedure waitfram-show-this:
      530         define input  parameter iInterval as int64 no-undo.
      531         define variable vtime as int64 no-undo.
      532         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      533         mWaitFramInterval = iInterval.
      534         run waitfram-show (substitute("&1&2 &3&4" ,
      535                                       mWaitFramTextBeg ,
      536                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      537                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      538                                       mWaitFramTextEnd
      539                                      )
      540                           ).
      541      end.
      542      procedure WaitFramRunPause:
      543         define input  parameter iInterval as dec no-undo.
      544         define variable vStart  as datetime-tz no-undo.
      545         define variable vend    as datetime-tz no-undo.
      546         define variable vint as int64 no-undo.
      547         define variable vOk as logical no-undo.
      548         vStart = now.
      549         vend   = vStart.
      550         publish "WaitFramPause" (iInterval,output vOk).
      551         vend   =  now.
      552         vint = vend - vStart.
      553         vint = iInterval - vint / 1000.
      554         if     not mWaitFramStop
      555            and (   vint > 0
      556                 or (    not vOk
      557                     and iInterval eq ?
      558                     )
      559                 )
      560         then
      561            run waitfram-show-this (iInterval).
      562         vend   =  now.
      563         vint = vend - vStart.
      564         vint = iInterval - vint / 1000.
      565         if     not mWaitFramStop
      566            and vint > 0
      567         then do:
      568            run gbl/pause.p (vint * 1000).
      569         end.
      570         if iInterval ne ?
      571         then
      572            publish "WaitFramStop".
      573         waitfram-check-timeout().
      574      end.
      575      procedure WaitFramWaitFor:
      576         define input  parameter iInterval as dec no-undo.
      577         assign
      578            mWaitFramStartProc   = now
      579            mWaitFramStopUser    = no
      580            mWaitFramStopTimeOut = no
      581         .
      582         block-wait:
      583         do while not mWaitFramStop:
      584            run WaitFramRunPause (iInterval).
      585            if  waitfram-check-timeout()
      586            then do:
      587               leave block-wait.
      588            end.
      589         end.
      590         run waitfram-hide.
      591      end.
      592   procedure waitfram-join :
      593     define input  parameter p-line-1  as character no-undo .
      594     define input  parameter p-line-2  as character no-undo .
      595     define input  parameter p-line-3  as character no-undo .
      596     define output parameter p-message as character no-undo .
      597     do
      598     on error undo, return error return-value
      599     :
      600       assign
      601         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      602                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      603                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      604       .
      605     end.
      606   end procedure.
      607   function waitfram-join-function returns character
      608     (input p-line-1 as character
      609     ,input p-line-2 as character
      610     ,input p-line-3 as character
      611     ).
      612     define variable v-message as character no-undo .
      613     run waitfram-join in this-procedure
      614       (input  p-line-1
      615       ,input  p-line-2
      616       ,input  p-line-3
      617       ,output v-message
      618       ) .
      619     return v-message .
      620   end function .
      621   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      622   procedure fltfield-clear :
      623     define output parameter loc-fld as character no-undo.
      624     define output parameter loc-lab as character no-undo .
      625     define output parameter loc-spr as character no-undo .
      626     define output parameter loc-dim as character no-undo .
      627     assign
      628       loc-fld = ""
      629       loc-lab = ""
      630       loc-spr = ""
      631       loc-dim = "0"
      632     .
      633   end procedure .
      634   procedure fltfield-add :
      635     define input        parameter par-fld as character no-undo.
      636     define input        parameter par-lab as character no-undo .
      637     define input        parameter par-spr as character no-undo .
      638     define input-output parameter loc-fld as character no-undo.
      639     define input-output parameter loc-lab as character no-undo .
      640     define input-output parameter loc-spr as character no-undo .
      641     define input-output parameter loc-dim as character no-undo .
      642     do
      643     on error undo, return error
      644     :
      645       assign
      646       loc-fld = if loc-dim = '0'
      647                 then par-fld
      648                 else (loc-fld + chr(44) + par-fld)
      649       loc-lab = if loc-dim = '0'
      650                 then par-lab
      651                 else (loc-lab + chr(44) + par-lab)
      652       loc-spr = if loc-dim = '0'
      653                 then par-spr
      654                 else (loc-spr + chr(44) + par-spr)
      655       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      656                 string(integer(if num-entries(loc-dim) > 1
      657                               then entry(2, loc-dim)
      658                               else entry(1, loc-dim)
      659                               ) + 1)
      660       no-error
      661       .
      662     end.
      663   end procedure.
      664   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      665   define  stream PrnLibStream.
      666   procedure prn-lib-prn-file :
      667     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      668     define input parameter p-DIsabledoptions as integer no-undo .
