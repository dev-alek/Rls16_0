     2281   procedure diasize_set-height :
     2282     define input  parameter p-new-height  as decimal   no-undo .
     2283     define input  parameter p-move-resize as logical   no-undo .
     2284     do
     2285     on error undo, return error return-value
     2286     :
     2287       run diasize_change-height in this-procedure
     2288         (input  (p-new-height - frame Dialog-Frame :height)
     2289         ,input  p-move-resize
     2290         ) .
     2291     end.
     2292   end procedure.
     2293   procedure diasize_change-width :
     2294     define input  parameter p-change-value as decimal   no-undo .
     2295     define input  parameter p-move-resize  as logical   no-undo .
     2296     define variable v-field-group-handle   as handle    no-undo .
     2297     define variable v-object-handle        as handle    no-undo .
     2298     define variable v-frame-width          as decimal   no-undo .
     2299     define variable v-frame-virtual-width  as decimal   no-undo .
     2300     define variable v-browse-width         as decimal   no-undo .
     2301     define variable v-window-width         as decimal   no-undo .
     2302     define variable v-window-virtual-width as decimal   no-undo .
     2303     define variable v-change-sign          as integer   no-undo .
     2304     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2305     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2306     if p-change-value > 0
     2307     then do:
     2308       if frame Dialog-Frame :width + p-change-value >
     2309           session :width-chars
     2310       then do:
     2311         assign
     2312           p-change-value = session :width-chars - frame Dialog-Frame :width
     2313         .
     2314         if p-change-value <= 0
     2315         then do:
     2316           run diasize_position-resize-button in this-procedure .
     2317           return .
     2318         end.
     2319       end.
     2320     end.
     2321     if p-change-value < 0
     2322     then do:
     2323       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2324       then do:
     2325         assign
     2326           p-change-value = v-diasize-orig-frame-width
     2327                          - frame Dialog-Frame :width
     2328         .
     2329         if p-change-value >= 0
     2330         then do:
     2331           run diasize_position-resize-button in this-procedure .
     2332           return .
     2333         end.
     2334       end.
     2335     end.
     2336     if p-change-value >= 0
     2337     then do:
     2338       assign
     2339         v-change-sign = 1
     2340       .
     2341     end.
     2342     else do:
     2343       assign
     2344         v-change-sign = -1
     2345       .
     2346     end.
     2347     assign
     2348       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2349     .
     2350     if p-change-value = 0
     2351     then do:
     2352       run diasize_position-resize-button in this-procedure .
     2353       return .
     2354     end.
     2355     move_block:
     2356     do
     2357     on error undo move_block, leave move_block
     2358     :
     2359       if retry
     2360       then do:
     2361         do
     2362         on error undo move_block, leave move_block
     2363         :
     2364           if p-change-value > 0
     2365           then do:
     2366             for each buf_temp-diasize-handle
     2367             on error undo, next
     2368             :
     2369               assign
     2370                 v-object-handle = buf_temp-diasize-handle.handle-value
     2371               .
     2372               if v-object-handle <> v-diasize-resize-button
     2373               then do:
     2374                 assign
     2375                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2376                 .
     2377               end.
     2378             end.
     2379             assign
     2380               v-diasize-browse-handle :width = v-browse-width
     2381             .
     2382             for each buf_temp-browse-handle
     2383               where buf_temp-browse-handle.browse-type = 'width':u
     2384             on error undo, next
     2385             :
     2386               assign
     2387                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2388               .
     2389             end.
     2390             assign
     2391               frame Dialog-Frame :width = v-frame-width
     2392             .
     2393             if frame Dialog-Frame :scrollable = true
     2394             then do:
     2395               assign
     2396                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2397               .
     2398             end.
     2399             run diasize_position-resize-button in this-procedure .
     2400           end.
     2401           else do:
     2402             if frame Dialog-Frame :scrollable = true
     2403             then do:
     2404               assign
     2405                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2406               .
     2407             end.
     2408             assign
     2409               frame Dialog-Frame :width = v-frame-width
     2410             .
     2411             for each buf_temp-browse-handle
     2412               where buf_temp-browse-handle.browse-type = 'width':u
     2413             on error undo, next
     2414             :
     2415               assign
     2416                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2417               .
     2418             end.
     2419             assign
     2420               v-diasize-browse-handle :width = v-browse-width
     2421             .
     2422             for each buf_temp-diasize-handle
     2423             on error undo, next
     2424             :
     2425               assign
     2426                 v-object-handle = buf_temp-diasize-handle.handle-value
     2427               .
