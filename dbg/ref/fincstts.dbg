     2134         then do:
     2135           assign
     2136             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2137             no-error .
     2138           if error-status :error
     2139           or error-status :get-message(1) <> ""
     2140           then do:
     2141             undo move_block, retry move_block .
     2142           end.
     2143         end.
     2144         assign
     2145           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2146           no-error .
     2147         if error-status :error
     2148         or error-status :get-message(1) <> ""
     2149         then do:
     2150           undo move_block, retry move_block .
     2151         end.
     2152         assign
     2153           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2154           no-error .
     2155         if error-status :error
     2156         or error-status :get-message(1) <> ""
     2157         then do:
     2158           undo move_block, retry move_block .
     2159         end.
     2160         for each buf_temp-browse-handle
     2161           where buf_temp-browse-handle.browse-type = 'height':u
     2162         on error undo move_block, retry move_block
     2163         :
     2164           assign
     2165             buf_temp-browse-handle.browse-handle :height
     2166               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2167             no-error .
     2168           if error-status :error
     2169           or error-status :get-message(1) <> ""
     2170           then do:
     2171             undo move_block, retry move_block .
     2172           end.
     2173         end.
     2174         for each buf_temp-diasize-handle
     2175         on error undo move_block, retry move_block
     2176         :
     2177           assign
     2178             v-object-handle = buf_temp-diasize-handle.handle-value
     2179           .
     2180           if v-object-handle <> v-diasize-resize-button
     2181           then do:
     2182             assign
     2183               v-object-handle :row = v-object-handle :row + p-change-value
     2184               no-error .
     2185             if error-status :error
     2186             or error-status :get-message(1) <> ""
     2187             then do:
     2188               undo move_block, retry move_block .
     2189             end.
     2190           end.
     2191         end.
     2192       end.
     2193       else do:
     2194         for each buf_temp-diasize-handle
     2195         on error undo move_block, retry move_block
     2196         :
     2197           assign
     2198             v-object-handle = buf_temp-diasize-handle.handle-value
     2199           .
     2200           if v-object-handle <> v-diasize-resize-button
     2201           then do:
     2202             assign
     2203               v-object-handle :row = v-object-handle :row + p-change-value
     2204               no-error .
     2205             if error-status :error
     2206             or error-status :get-message(1) <> ""
     2207             then do:
     2208               undo move_block, retry move_block .
     2209             end.
     2210           end.
     2211         end.
     2212         assign
     2213           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2214           no-error .
     2215         if error-status :error
     2216         or error-status :get-message(1) <> ""
     2217         then do:
     2218           undo move_block, retry move_block .
     2219         end.
     2220         for each buf_temp-browse-handle
     2221           where buf_temp-browse-handle.browse-type = 'height':u
     2222         on error undo move_block, retry move_block
     2223         :
     2224           assign
     2225             buf_temp-browse-handle.browse-handle :height
     2226               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2227             no-error .
