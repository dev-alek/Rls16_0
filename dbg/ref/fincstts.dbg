     5119   PROCEDURE proc-print-list :
     5120   define variable v-doc-rec as recid no-undo .
     5121   define variable accum-count as integer.
     5122   define variable date_string     as      char    no-undo.
     5123   define variable Line            as      char    no-undo.
     5124   define variable v-curr-abbr as character no-undo.
     5125   DEFINE VARIABLE v-time AS CHARACTER NO-UNDO.
     5126   DEFINE FRAME c-fin-statement-list
     5127   X_c-fin-statement.prn-doc-code FORMAT "X(22)"
     5128   X_c-fin-statement.corr-date FORMAT "99/99/9999" COLUMN-LABEL "Дата измен."
     5129   v-time FORMAT "X(8)" COLUMN-LABEL "Время"
     5130   X_c-fin-statement.corr-user-name FORMAT "99/99/9999" COLUMN-LABEL "Изменил"
     5131   X_c-fin-statement.code-schet COLUMN-LABEL "Вн.№счета"
     5132   X_c-fin-statement.start-date FORMAT "99/99/9999":U COLUMN-LABEL "С"
     5133   X_c-fin-statement.end-date FORMAT "99/99/9999":U COLUMN-LABEL "По"
     5134   X_c-fin-statement.doc-date
     5135   X_c-fin-statement.bank-date  COLUMn-LABEL "Дата прин!банком"
     5136   X_c-fin-statement.fact-date COLUMn-LABEL "Дата факт"
     5137   X_c-fin-statement.status_
     5138   X_c-fin-statement.sum-doc
     5139   X_c-fin-statement.cli-name COLUMN-LABEL "Назв.!плательщика" FORMAT "X(16)"
     5140   v-curr-abbr  COLUMN-LABEL "Вал" FORMAT "X(3)"
     5141   X_c-fin-statement.sttm-code COLUMN-LABEL "Вн.N" FORMAT "999999999":U
     5142   X_c-fin-statement.cl-bank COLUMN-LABEL "Кл-банк"
     5143   X_c-fin-statement.host-code COLUMN-LABEL "Код!фирмы"
     5144   HEADER  date_string AT 5 format "X(35)"
     5145    string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     5146   Line format "X(198)" AT 1
     5147   with width 232 down stream-io use-text    .
     5148   Line = fill("-", 198).
     5149   date_string = cur-time-print() .
     5150   run prn-lib-open-stream  in this-procedure (
     5151                                                input parParentProc
     5152                                               ,input 43
     5153                                               ,input yes
     5154                                               ,input no
     5155                                               ).
     5156   PUT  STREAM PrnLibStream
     5157   SPACE(25) ( frame Dialog-Frame:title + chr(32) + "Только отмеченные записи")
     5158   format "x(90)" SKIP(1) .
     5159   FORM HEADER
     5160   Line format "X(195)" AT 1 SKIP
     5161   "Продолжение - на следующей странице" AT 30 SKIP
     5162   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     5163   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     5164   FORM with FRAME c-fin-statement-list  .
     5165   run waitfram-show in this-procedure ( input "Ждите...").
     5166   v-doc-rec = recid(X_c-fin-statement).
     5167   DO WHILE available X_c-fin-statement :
     5168     GET prev br-c-fin-statement.
     5169   END.
     5170   GET next br-c-fin-statement.
     5171   DO WHILE available X_c-fin-statement :
     5172     Display STREAM PrnLibStream
     5173     X_c-fin-statement.prn-doc-code
     5174     X_c-fin-statement.corr-date
     5175     STRING(X_c-fin-statement.corr-time, "HH:MM:SS") @ v-time
     5176     X_c-fin-statement.corr-user-name
     5177     X_c-fin-statement.code-schet
     5178     X_c-fin-statement.start-date
     5179     X_c-fin-statement.end-date
     5180     X_c-fin-statement.doc-date
     5181     X_c-fin-statement.bank-date
     5182     X_c-fin-statement.fact-date
     5183     X_c-fin-statement.status_
     5184     X_c-fin-statement.sum-doc
     5185     X_c-fin-statement.cli-name
     5186     get-currency(buffer X_c-fin-statement) @ v-curr-abbr
     5187     X_c-fin-statement.sttm-code
     5188     X_c-fin-statement.cl-bank
     5189     X_c-fin-statement.host-code
     5190     with FRAME c-fin-statement-list .
     5191     DOWN STREAM PrnLibStream 1
     5192     with FRAME c-fin-statement-list  .
     5193     assign
     5194     accum-count = accum-count + 1
     5195     .
     5196     GET next br-c-fin-statement.
     5197   END.
     5198   UNDERLINE  STREAM PrnLibStream
     5199   X_c-fin-statement.prn-doc-code
     5200   X_c-fin-statement.code-schet
     5201   X_c-fin-statement.corr-date
     5202   v-time
     5203   X_c-fin-statement.corr-user-name
     5204   X_c-fin-statement.start-date
     5205   X_c-fin-statement.end-date
     5206   X_c-fin-statement.doc-date
     5207   X_c-fin-statement.bank-date
     5208   X_c-fin-statement.fact-date
     5209   X_c-fin-statement.status_
     5210   X_c-fin-statement.sum-doc
     5211   X_c-fin-statement.cli-name
     5212   v-curr-abbr
     5213   X_c-fin-statement.sttm-code
     5214   X_c-fin-statement.cl-bank
     5215   X_c-fin-statement.host-code
     5216   with FRAME c-fin-statement-list .
     5217   DISPLAY STREAM PrnLibStream
     5218   "ИТОГО" @ X_c-fin-statement.host-code
     5219   accum-count @ X_c-fin-statement.prn-doc-code
     5220   with frame c-fin-statement-list.
     5221   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     5222   HIDE  STREAM PrnLibStream FRAME c-fin-statement-List.
     5223   output  STREAM PrnLibStream CLOSE.
     5224   REPOSITION br-c-fin-statement to recid v-doc-rec no-error.
     5225   APPLY "entry" to br-c-fin-statement.
     5226   run waitfram-hide in this-procedure .
     5227   run prn-lib-prn-file in this-procedure (
     5228                                              input parParentProc
     5229                                             ,input 8
     5230                                             ).
     5231   END PROCEDURE.
     5232   PROCEDURE proc-view-changes :
     5233   for each temp-changes:
     5234       delete temp-changes.
     5235   END.
     5236   if not available X_c-fin-statement then do:
     5237     Open QUery br-changes for each temp-changes.
     5238     return.
     5239   end.
     5240   define variable v-label-param as character no-undo .
     5241   v-label-param =
     5242     "acc-date" + chr(4) + "Дата бухг.проводки" + chr(4) + "" + chr(8)
