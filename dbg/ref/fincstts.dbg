     2445       .
     2446       if v-diasize-change-size = false
     2447       then do:
     2448         assign
     2449           v-diasize-change-size = true
     2450         .
     2451       end.
     2452       else do:
     2453         return .
     2454       end.
     2455       assign
     2456         v-frame-width = frame Dialog-Frame :width
     2457         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2458         v-browse-width = v-diasize-browse-handle :width
     2459       .
     2460       for each buf_temp-browse-handle
     2461         where buf_temp-browse-handle.browse-type = 'width':u
     2462       :
     2463         assign
