     2644       end.
     2645       if v-diasize-wndstore = true
     2646       then do:
     2647         if connected("ub") = true
     2648         then do:
     2649           define variable v-cntxt-db-num        as integer   no-undo .
     2650           define variable v-cntxt-userid        as character no-undo .
     2651           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2652                                             , OUTPUT v-cntxt-userid
     2653                                             ) .
     2654           run gbl/wndsizew.p
     2655             (input  v-cntxt-db-num
     2656             ,input  v-cntxt-userid
     2657             ,input  v-diasize-proc-name
     2658             ,input  'width':u
     2659             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2660             ) .
     2661         end.
     2662       end.
     2663     end.
     2664     assign
     2665       v-diasize-change-size = false
     2666     .
     2667   end procedure.
     2668   procedure diasize_set-width :
     2669     define input  parameter p-new-width  as decimal   no-undo .
     2670     define input  parameter p-move-resize as logical   no-undo .
     2671     do
     2672     on error undo, return error return-value
     2673     :
     2674       run diasize_change-width in this-procedure
     2675         (input  (p-new-width - frame Dialog-Frame :width)
     2676         ,input  p-move-resize
     2677         ) .
     2678     end.
     2679   end procedure.
     2680   procedure diasize_position-resize-button :
     2681     do with frame Dialog-Frame
     2682     :
     2683       hide v-diasize-resize-button .
     2684       assign
     2685         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2686                     - 1
     2687                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2688         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2689                     - 1
     2690                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2691       .
     2692       view v-diasize-resize-button .
     2693     end.
     2694   end procedure.
     2695   on alt-right anywhere
     2696   do:
     2697     run diasize_change-width in this-procedure
     2698       (input 1
     2699       ,input true
     2700       ) .
     2701     return no-apply .
     2702   end.
     2703   on alt-left anywhere
     2704   do:
     2705     run diasize_change-width in this-procedure
     2706       (input -1
     2707       ,input true
     2708       ) .
     2709     return no-apply .
     2710   end.
     2711   on alt-down anywhere
     2712   do:
     2713     run diasize_change-height in this-procedure
     2714       (input 1
     2715       ,input true
     2716       ) .
     2717     return no-apply .
     2718   end.
     2719   on alt-up anywhere
     2720   do:
     2721     run diasize_change-height in this-procedure
     2722       (input -1
     2723       ,input true
     2724       ) .
     2725     return no-apply .
     2726   end.
     2727   on alt-enter of frame Dialog-Frame
     2728   do:
     2729     run diasize_maximize in this-procedure
     2730       (input  ?
     2731       ).
     2732     return no-apply .
     2733   end.
     2734   procedure diasize_end-move :
     2735     do
     2736     on error undo, return error return-value
     2737     :
     2738       define variable v-row-delta as decimal   no-undo .
     2739       define variable v-col-delta as decimal   no-undo .
     2740       define variable v-new-row as decimal   no-undo .
     2741       define variable v-new-col as decimal   no-undo .
     2742       assign
     2743         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2744         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2745       .
     2746       assign
     2747         v-row-delta = v-new-row - frame Dialog-Frame :height
     2748         v-col-delta = v-new-col - frame Dialog-Frame :width
     2749       .
     2750       run diasize_change-height in this-procedure
     2751         (input v-row-delta
     2752         ,input true
     2753         ) .
     2754       run diasize_change-width in this-procedure
     2755         (input v-col-delta
     2756         ,input true
     2757         ) .
     2758     end.
     2759   end procedure.
     2760   procedure diasize_maximize :
     2761     define input  parameter p-action as logical   no-undo .
     2762     do
     2763     on error undo, return error return-value
     2764     :
     2765       if p-action = ?
     2766       then do:
     2767         if v-diasize-need-maximize = true
     2768         then do:
     2769           assign
     2770             p-action = true
     2771           .
     2772         end.
     2773         else do:
     2774           assign
     2775             p-action = false
     2776           .
     2777         end.
     2778       end.
     2779       if p-action = true
     2780       then do:
     2781         run diasize_change-height in this-procedure
     2782           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2783               - frame Dialog-Frame :height-chars
     2784           ,input true
     2785           ) .
     2786         run diasize_change-width in this-procedure
     2787           (input session :width-chars
     2788               - frame Dialog-Frame :width-chars
     2789           ,input true
     2790           ) .
     2791         assign
     2792           v-diasize-need-maximize = false
     2793         .
     2794       end.
     2795       else do:
     2796         run diasize_change-width in this-procedure
     2797           (input v-diasize-orig-frame-width
     2798               - frame Dialog-Frame :width-chars
     2799           ,input true
     2800           ) .
     2801         run diasize_change-height in this-procedure
     2802           (input v-diasize-orig-frame-height
     2803               - frame Dialog-Frame :height-chars
     2804           ,input true
     2805           ) .
     2806         assign
     2807           v-diasize-need-maximize = true
     2808         .
     2809       end.
     2810     end.
     2811   end procedure.
     2812   procedure diasize_restore-orig-size :
     2813     do
     2814     on error undo, return error return-value
     2815     :
     2816       assign
     2817         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2818         v-diasize-current-frame-height = frame Dialog-Frame :height
     2819       .
     2820       run diasize_set-height in this-procedure
     2821         (input  v-diasize-orig-frame-height
     2822         ,input  true
     2823         ) .
     2824       run diasize_set-width in this-procedure
     2825         (input  v-diasize-orig-frame-width
     2826         ,input  true
     2827         ) .
     2828     end.
     2829   end procedure.
     2830   procedure diasize_restore-current-size :
     2831     do
     2832     on error undo, return error return-value
     2833     :
     2834       run diasize_set-height in this-procedure
     2835         (input  v-diasize-current-frame-height
     2836         ,input  true
     2837         ) .
     2838       run diasize_set-width in this-procedure
     2839         (input  v-diasize-current-frame-width
     2840         ,input  true
     2841         ) .
     2842     end.
     2843   end procedure.
     2844   procedure diasize_set-browse-handle :
     2845     define input  parameter p-browse-handle as handle   no-undo .
     2846     define buffer buf_temp-browse-handle for temp-browse-handle .
     2847     do
     2848     on error undo, return error return-value
     2849     :
     2850       assign
     2851         v-diasize-browse-handle = p-browse-handle
     2852       .
     2853       for each buf_temp-browse-handle
     2854       on error undo, return error return-value
     2855       :
     2856         delete buf_temp-browse-handle .
     2857       end.
     2858     end.
     2859   end procedure.
     2860   procedure diasize_add_browse :
     2861     define input  parameter p-browse-type   as character no-undo .
     2862     define input  parameter p-browse-handle as handle    no-undo .
     2863     define buffer buf_temp-browse-handle for temp-browse-handle .
     2864     do
     2865     on error undo, return error return-value
     2866     :
     2867       assign
     2868         v-diasize-browse-number = v-diasize-browse-number + 1
     2869       .
     2870       create buf_temp-browse-handle .
     2871       assign
     2872         buf_temp-browse-handle.browse-type   = p-browse-type
     2873         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2874         buf_temp-browse-handle.browse-handle = p-browse-handle
     2875       .
     2876     end.
     2877   end procedure.
     2878   procedure diasize_init :
     2879     define variable v-default-value    as logical   no-undo .
     2880     define variable v-restore-saved    as logical   no-undo .
     2881     define variable v-resize-value-str as character no-undo .
     2882     do
     2883     on error undo, return error return-value
     2884     :
     2885       do with frame Dialog-Frame
     2886       :
     2887         assign
     2888           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2889           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2890           v-diasize-browse-handle     = browse br-c-fin-statement :handle
     2891         .
     2892         create button v-diasize-resize-button
     2893         assign
     2894           parent        = frame Dialog-Frame :first-child
     2895           label         = "s"
     2896           height-pixels = 16
     2897           width-pixels  = 16
     2898           visible       = true
     2899           sensitive     = true
     2900           movable       = true
     2901           triggers:
     2902             on end-move persistent run diasize_end-move in this-procedure .
     2903           end triggers.
     2904         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2905         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2906         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2907         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2908         assign
     2909           v-diasize-wndmax = false
     2910         .
     2911         if connected("ub") = true
     2912         then do:
     2913           define variable v-cntxt-db-num        as integer   no-undo .
     2914           define variable v-cntxt-userid        as character no-undo .
     2915           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2916                                             , OUTPUT v-cntxt-userid
     2917                                             ) .
     2918           run gbl/wndpar_r.p
     2919             (input  v-cntxt-db-num
     2920             ,input  v-cntxt-userid
     2921             ,input  'wndmax':U
     2922             ,output v-diasize-wndmax
     2923             ,output v-default-value
     2924             ) .
     2925         end.
     2926         assign
     2927           v-diasize-wndstore = false
     2928         .
     2929         if connected("ub") = true
     2930         then do:
     2931           run gbl/wndpar_r.p
     2932             (input  v-cntxt-db-num
     2933             ,input  v-cntxt-userid
     2934             ,input  'wndstore':U
     2935             ,output v-diasize-wndstore
     2936             ,output v-default-value
     2937             ) .
     2938         end.
     2939         assign
     2940           v-diasize-proc-name = entry(1, program-name(2), '.')
     2941         .
     2942         if v-diasize-wndstore = true
     2943         then do:
     2944           assign
     2945             v-restore-saved = false
     2946           .
     2947           if connected("ub") = true
     2948           then do:
     2949             run gbl/wndsizer.p
     2950               (input  v-cntxt-db-num
     2951               ,input  v-cntxt-userid
     2952               ,input  v-diasize-proc-name
     2953               ,input  'height':u
     2954               ,output v-resize-value-str
     2955               ) .
     2956             if v-resize-value-str <> '':U
     2957             then do:
     2958               run diasize_change-height in this-procedure
     2959                 (input  integer(v-resize-value-str)
     2960                 ,input  true
     2961                 ) .
     2962               assign
     2963                 v-restore-saved = true
     2964               .
     2965             end.
     2966           end.
     2967           if connected("ub") = true
     2968           then do:
     2969             run gbl/wndsizer.p
     2970               (input  v-cntxt-db-num
     2971               ,input  v-cntxt-userid
     2972               ,input  v-diasize-proc-name
     2973               ,input  'width':u
     2974               ,output v-resize-value-str
     2975               ) .
     2976             if v-resize-value-str <> '':U
     2977             then do:
     2978               run diasize_change-width in this-procedure
     2979                 (input  integer(v-resize-value-str)
     2980                 ,input  true
     2981                 ) .
     2982               assign
     2983                 v-restore-saved = true
     2984               .
     2985             end.
     2986           end.
     2987           if v-restore-saved <> true
     2988           then do:
     2989             if v-diasize-wndmax = true
     2990             then do:
     2991               run diasize_maximize in this-procedure
     2992                 (input  true
     2993                 ) .
     2994             end.
     2995           end.
     2996         end.
     2997         else do:
     2998           if v-diasize-wndmax = true
     2999           then do:
     3000             run diasize_maximize in this-procedure
     3001               (input  true
     3002               ) .
     3003           end.
     3004         end.
     3005       end.
     3006     end.
     3007   end procedure.
     3008   procedure diasize_need-full-display :
     3009     define output parameter p-need-full-display as logical   no-undo .
     3010     do
     3011     on error undo, return error return-value
     3012     :
     3013       assign
     3014         p-need-full-display = v-diasize-need-full-display
     3015       .
     3016       assign
     3017         v-diasize-need-full-display = false
     3018       .
     3019     end.
     3020   end procedure.
     3021   procedure get-context :
     3022      define output parameter p-db-num as integer          no-undo.
     3023      define output parameter p-user-id as character        no-undo.
     3024      define variable v-login               as character    no-undo.
     3025      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3026      define buffer buf_user-login  for ub.user-login .
     3027      do
     3028      on error undo, return error
     3029      :
     3030            FIND FIRST buf_sys-ctrl no-lock.
     3031            ASSIGN
     3032               v-login = USERID("ub")
     3033               p-db-num = buf_sys-ctrl.db-num
     3034            .
     3035            FIND FIRST buf_user-login
     3036                 WHERE buf_user-login.db-num = p-db-num
     3037                   AND buf_user-login.user-login = v-login
     3038                 no-lock
     3039                 no-error
     3040                 .
     3041            IF AVAILABLE buf_user-login
     3042            THEN DO:
     3043               assign
     3044                  p-user-id = buf_user-login.user-id
     3045               .
     3046            END.
     3047      end.
     3048   end procedure.
     3049       run diasize_init in this-procedure .
     3050   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3051   procedure set-filter-name :
     3052   define input parameter p-filter-name as character no-undo .
     3053     do with frame Dialog-Frame:
     3054       if p-filter-name > "" then do:
     3055         assign
     3056           frame Dialog-Frame:title
     3057             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     3058         .
     3059         assign
     3060           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     3061         .
     3062       end.
     3063       else do:
     3064         assign
     3065           b-sch :tooltip = ""
     3066         .
     3067       end.
     3068     end.
     3069   end procedure.
     3070   def var sort-labelbr-c-fin-statement   as character no-undo .
     3071   def var sort-clmnbr-c-fin-statement    as handle    no-undo .
     3072   def var cur-clmnbr-c-fin-statement     as handle    no-undo .
     3073   def var cur-clmn-locbr-c-fin-statement as integer   no-undo .
     3074   def var re-querybr-c-fin-statement     as logical   initial no no-undo .
     3075   on start-search, ctrl-o of br-c-fin-statement in frame Dialog-Frame do:
     3076      run sort-brbr-c-fin-statement
     3077        (input (if available X_c-fin-statement
     3078                then recid(X_c-fin-statement)
     3079                else ?
     3080               )
     3081        ).
     3082   end.
     3083   PROCEDURE sort-brbr-c-fin-statement :
     3084     define input parameter p-recid as recid no-undo .
     3085     if re-querybr-c-fin-statement = no then do:
     3086       assign
     3087          cur-clmnbr-c-fin-statement = br-c-fin-statement:current-column in frame Dialog-Frame
     3088       .
     3089       if sort-clmnbr-c-fin-statement <> ? then sort-clmnbr-c-fin-statement:column-fgcolor = 0.
     3090       if cur-clmnbr-c-fin-statement = sort-clmnbr-c-fin-statement then do:
     3091         assign
     3092            sort-labelbr-c-fin-statement = ""
     3093            sort-clmnbr-c-fin-statement = ?
     3094         .
     3095        end.
     3096        else do:
     3097          assign
     3098            sort-labelbr-c-fin-statement = cur-clmnbr-c-fin-statement:label
     3099            sort-clmnbr-c-fin-statement  = cur-clmnbr-c-fin-statement
     3100            sort-clmnbr-c-fin-statement:column-fgcolor = 4
     3101          .
     3102        end.
     3103      end.
     3104     assign
     3105       cur-clmn-locbr-c-fin-statement = 1
     3106     .
     3107     def var column-handle as handle no-undo .
     3108     column-handle = br-c-fin-statement:first-column.
     3109     do while valid-handle(column-handle) :
     3110       if column-handle = cur-clmnbr-c-fin-statement then do:
     3111         leave .
     3112       end.
     3113       column-handle = column-handle:NEXT-COLUMN.
     3114       assign
     3115         cur-clmn-locbr-c-fin-statement = cur-clmn-locbr-c-fin-statement + 1
     3116       .
     3117     end.
     3118     case sort-labelbr-c-fin-statement:
     3119           when X_c-fin-statement.prn-doc-code:label in browse br-c-fin-statement then DO:    assign       sort-column-name = "X_c-fin-statement.prn-doc-code"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     3120       otherwise do:
     3121         assign
     3122           sort-column-name = ""
     3123         .
     3124         run OpenBr in this-procedure (  input yes, input no, input '':U).
     3125           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-c-fin-statement') then do:
     3126             run mv-brw-defaultbr-c-fin-statement.
     3127           end.
     3128         if sort-labelbr-c-fin-statement <> "" then do:
     3129           assign
     3130             cur-clmnbr-c-fin-statement:column-fgcolor = 0
     3131           .
     3132         end.
     3133         assign
     3134           cur-clmn-locbr-c-fin-statement = ?
     3135         .
     3136       end.
     3137     end case.
     3138       if cur-clmn-locbr-c-fin-statement <> ? then do:
     3139         if can-do( this-procedure:internal-entries, 'ch-clmnbr-c-fin-statement') then do:
     3140           run ch-clmnbr-c-fin-statement in this-procedure (cur-clmn-locbr-c-fin-statement).
     3141         end.
     3142       end.
     3143     if p-recid <> ? then do:
     3144       reposition br-c-fin-statement to recid p-recid no-error.
     3145       apply "value-changed" to br-c-fin-statement in frame Dialog-Frame.
     3146     end.
     3147     apply "entry" to br-c-fin-statement in frame Dialog-Frame.
     3148   END PROCEDURE.
     3149   procedure re-open-query-srt-clmnbr-c-fin-statement:
     3150   if cur-clmnbr-c-fin-statement = ? then do:
     3151      run OpenBr in this-procedure (  input yes, input no, input '':U).
     3152   end.
     3153   else do:
     3154      assign re-querybr-c-fin-statement = yes.
     3155      run sort-brbr-c-fin-statement
     3156        (input (if available X_c-fin-statement
     3157                then recid(X_c-fin-statement)
     3158                else ?
     3159               )
     3160        ).
     3161      assign re-querybr-c-fin-statement = no.
     3162   end.
     3163   end.
     3164   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3165   do:
     3166     br-c-fin-statement :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     3167   end.
     3168   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3169   on f5 of frame Dialog-Frame anywhere
     3170   do:
     3171     v-doc-rec = recid(X_c-fin-statement). run OpenBr in this-procedure ( input yes, input no, input '':U). reposition br-c-fin-statement to recid v-doc-rec no-error. v-doc-rec = ?.
     3172       apply "VALUE-CHANGED" to br-c-fin-statement.
     3173   end.
     3174   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
