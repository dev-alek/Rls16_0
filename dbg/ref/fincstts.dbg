     1081   FUNCTION get-all-fields returns character (p-file-name as character ):
     1082   define variable v-dop as character no-undo .
     1083     find first _file no-lock where _file._file-name = p-file-name no-error .
     1084     if not available _file then return "":U.
     1085     for each _field no-lock where
     1086              _field._file-recid = recid(_file) :
     1087       assign
     1088       v-dop = v-dop + _field._field-name + chr(44)
     1089       .
     1090     end.
     1091     return trim(v-dop).
     1092   END FUNCTION.
     1093   PROCEDURE proc-full-temp-changes :
     1094     define input  parameter p-hst-handle as handle    no-undo .
     1095     define input  parameter p-main-table as character no-undo .
     1096     define input  parameter p-field-list as character no-undo .
     1097     define input  parameter p-label-form as character no-undo .
     1098     define variable h-new-buf         as handle    no-undo .
     1099     define variable h-main-buf        as handle    no-undo .
     1100     define variable h-for-comp        as handle    no-undo .
     1101     define variable v-inform          as character no-undo .
     1102     define variable v-ind             as integer   no-undo .
     1103     define variable v-idx-field-qnty  as integer   no-undo .
     1104     define variable v-num-entries     as integer   no-undo .
     1105     define variable fh                as handle    no-undo .
     1106     define variable fh-main           as handle    no-undo .
     1107     define variable fh-old            as handle    no-undo .
     1108     define variable fh-new            as handle    no-undo .
     1109     define variable v-field-name      as character no-undo .
     1110     define variable v-field-lvl       as character no-undo .
     1111     define variable v-field-form      as character no-undo .
     1112     define variable v-search-exp      as character no-undo .
     1113     define variable v-srch-main       as character no-undo .
     1114     define variable v-word-link       as character no-undo .
     1115     define variable v-av-chip-num     as logical   no-undo .
     1116     define variable v-main-pi-fld-lst as character no-undo .
     1117     define variable v-main-fld-lst    as character no-undo .
     1118     define variable v-delim-list      as character no-undo .
     1119     define variable v-label           as character no-undo .
     1120     define variable v-old-value       as character no-undo case-sensitive.
     1121     define variable v-new-value       as character no-undo case-sensitive.
     1122     define variable v-chg-fields as character no-undo.
     1123     for each temp-changes:
     1124       delete temp-changes.
     1125     end.
     1126     if not p-hst-handle:available then do:
     1127       return .
     1128     end.
     1129     create buffer h-new-buf  for table p-hst-handle .
     1130     create buffer h-main-buf for table p-main-table .
     1131     assign
     1132       v-inform = h-main-buf:index-information(1)
     1133       v-ind    = 2
     1134     .
     1135     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1136     on error undo, return error
     1137     :
     1138       assign
     1139         v-inform = h-main-buf:index-information( v-ind )
     1140         v-ind    = v-ind + 1
     1141       .
     1142     end.
     1143     if v-inform = ?
     1144       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1145       or entry( 3, v-inform, ",":U ) <> "1":U
     1146     then do:
     1147       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1148     end.
     1149     assign
     1150       v-idx-field-qnty = num-entries( v-inform ) - 4
     1151     .
     1152     if v-idx-field-qnty < 2 then do:
     1153       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1154     end.
     1155     assign
     1156       v-srch-main   = "where":U
     1157       v-word-link   = "":U
     1158       v-av-chip-num = false
     1159       v-delim-list  = "":U
     1160     .
     1161     do v-ind = 1 to v-idx-field-qnty by 2
     1162     on error undo, return error
     1163     :
     1164       assign
     1165         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1166         fh                = p-hst-handle:buffer-field( v-field-name )
     1167         fh-main           = h-main-buf:buffer-field( v-field-name )
     1168         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1169         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1170       .
     1171       if fh:data-type ="character":U then do:
     1172         assign
     1173           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1174         .
     1175       end.
     1176       else do:
     1177         assign
     1178           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1179         .
     1180       end.
     1181       if v-delim-list = "":U then do:
     1182         assign
     1183           v-delim-list = ",":U
     1184         .
     1185       end.
     1186       if v-word-link = "":U then do:
     1187         assign
     1188           v-word-link = "and":U
     1189         .
     1190       end.
     1191     end.
     1192     assign
     1193       v-delim-list  = "":U
     1194     .
     1195     do v-ind = 1 to h-main-buf:num-fields
     1196     on error undo, return error
     1197     :
     1198       assign
     1199         fh-main      = h-main-buf:buffer-field( v-ind )
     1200         v-field-name = fh-main:name
     1201       .
     1202         assign
     1203           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1204         .
     1205         if v-delim-list = "":U then do:
     1206           assign
     1207             v-delim-list = ",":U
     1208           .
     1209         end.
     1210     end.
     1211     assign
     1212       v-inform = p-hst-handle:index-information(1)
     1213       v-ind    = 2
     1214     .
     1215     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1216     on error undo, return error
     1217     :
     1218       assign
     1219         v-inform = p-hst-handle:index-information( v-ind )
     1220         v-ind    = v-ind + 1
     1221       .
     1222     end.
     1223     if v-inform = ?
     1224       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1225       or entry( 3, v-inform, ",":U ) <> "1":U
     1226     then do:
     1227       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1228     end.
     1229     assign
     1230       v-idx-field-qnty = num-entries( v-inform ) - 4
     1231     .
     1232     if v-idx-field-qnty < 2 then do:
     1233       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1234     end.
     1235     assign
     1236       v-search-exp  = "where":U
     1237       v-word-link   = "":U
     1238       v-av-chip-num = false
     1239     .
     1240     do v-ind = 1 to v-idx-field-qnty by 2
     1241     on error undo, return error
     1242     :
     1243       assign
     1244         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1245         fh           = p-hst-handle:buffer-field( v-field-name )
     1246         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1247       .
     1248       if v-field-name = "chip-num":U then do:
     1249         assign
     1250           v-search-exp  = substitute( "&1 >", v-search-exp )
     1251           v-av-chip-num = true
     1252         .
     1253       end.
     1254       else do:
     1255         assign
     1256           v-search-exp = substitute( "&1 =", v-search-exp )
     1257         .
     1258       end.
     1259       if fh:data-type ="character":U then do:
     1260         assign
     1261           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1262         .
     1263       end.
     1264       else do:
     1265         assign
     1266           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1267         .
     1268       end.
     1269       if v-word-link = "":U then do:
     1270         assign
     1271           v-word-link = "and":U
     1272         .
     1273       end.
     1274     end.
     1275     if v-av-chip-num = false then do:
     1276       message
     1277         vss-workfile vss-revision vss-description skip
     1278         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1279         "Использование данной процедуры невозможно!" skip
     1280         view-as alert-box error .
     1281       return error .
     1282     end.
     1283     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1284     if not h-new-buf:available then do:
     1285       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1286       if not h-main-buf:available then do:
     1287         assign
     1288           h-for-comp = ?
     1289         .
     1290       end.
     1291       else do:
     1292         assign
     1293           h-for-comp = h-main-buf
     1294         .
     1295       end.
     1296     end.
     1297     else do:
     1298       assign
     1299         h-for-comp = h-new-buf
     1300       .
     1301     end.
     1302     assign
     1303       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1304     .
     1305     do v-ind = 1 to v-num-entries
     1306     on error undo, return error return-value
     1307     :
     1308       assign
     1309         v-field-name = entry( v-ind, v-main-fld-lst )
     1310         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1311         v-old-value  = fh-old:buffer-value()
     1312         v-label      = trim( fh-old:label )
     1313       .
     1314       if ( trim( p-field-list ) <> "":U
     1315            and lookup( v-field-name, p-field-list ) > 0
     1316          )
     1317          or trim( p-field-list ) = "":U
     1318       then do:
     1319         if h-for-comp <> ? then do:
     1320           assign
     1321             fh-new      = h-for-comp:buffer-field( v-field-name )
     1322             v-new-value = fh-new:buffer-value()
     1323           .
     1324         end.
     1325         else do:
     1326           assign
     1327             v-new-value = "":U
     1328           .
     1329         end.
     1330         if v-old-value <> v-new-value
     1331         then do:
     1332           create temp-changes.
     1333           assign
     1334             temp-changes.t_name = p-main-table
     1335             temp-changes.f_name = v-field-name
     1336             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1337             temp-changes.v_old  = trim( v-old-value )
     1338             temp-changes.v_new  = trim( v-new-value )
     1339             temp-changes.num_   = 0
     1340             temp-changes.fNotChange = v-old-value eq v-new-value
     1341           .
     1342         end.
     1343       end.
     1344     end.
     1345     assign
     1346       v-num-entries = num-entries( p-label-form, chr(8) )
     1347     .
     1348     do v-ind = 1 to v-num-entries
     1349     on error undo, return error return-value
     1350     :
     1351       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1352         assign
     1353           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1354           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1355           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1356         .
     1357         find first temp-changes
     1358           where temp-changes.f_name = v-field-name
     1359           no-error .
     1360         if available temp-changes then do:
     1361           if trim( v-field-lvl ) <> "":U then do:
     1362             assign
     1363               temp-changes.l_name = v-field-lvl
     1364             .
     1365           end.
     1366           if trim( v-field-form ) <> "":U then do:
     1367             assign
     1368               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1369             .
     1370             if h-for-comp <> ? then do:
     1371               assign
     1372                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1373               .
     1374             end.
     1375           end.
     1376         end.
     1377       end.
     1378       else do:
     1379         message
     1380           vss-workfile vss-revision vss-description skip
     1381           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1382           substitute( "список для поля '&1': '&2'"
     1383                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1384                       ,entry( v-ind, p-label-form, chr(8) )
     1385                     ) skip
     1386           substitute( "полный список: &2", p-label-form ) skip
     1387           view-as alert-box error .
     1388       end.
     1389     end.
     1390     delete object h-new-buf .
     1391     delete object h-main-buf .
     1392   END PROCEDURE.
     1393   FUNCTION get-currency RETURNS CHARACTER
     1394     ( BUFFER loc-c-fin-statement FOR ub.c-fin-statement )  FORWARD.
     1395   DEFINE BUTTON B-curr
     1396        IMAGE-UP FILE "btn-down-arrow":U
     1397        IMAGE-DOWN FILE "btn-down-arrow":U
     1398        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1399        LABEL "Btn 1"
     1400        SIZE 3 BY 1.
     1401   DEFINE BUTTON B-Help
     1402        LABEL "Помо&щь"
     1403        SIZE 3 BY 1
     1404        BGCOLOR 8 .
     1405   DEFINE BUTTON B-lookup
     1406        LABEL "&Просмотр"
     1407        SIZE 10 BY 1.
     1408   DEFINE BUTTON B-mark
     1409        LABEL "&*"
     1410        SIZE 3 BY 1.
     1411   DEFINE BUTTON B-print
     1412        LABEL "Пе&чать"
     1413        SIZE 3 BY 1.
     1414   DEFINE BUTTON b-quit AUTO-END-KEY
     1415        LABEL "&Выход"
     1416        SIZE 10 BY 1
     1417        BGCOLOR 8 .
     1418   DEFINE BUTTON B-sch
     1419        LABEL "&Фильтр"
     1420        SIZE 3 BY 1.
     1421   DEFINE BUTTON B-schet
     1422        LABEL "&Счет"
     1423        SIZE 10 BY 1.
     1424   DEFINE BUTTON b-sel AUTO-GO
     1425        LABEL "Вы&бор"
     1426        SIZE 10 BY 1
     1427        BGCOLOR 8 .
     1428   DEFINE VARIABLE ED-notes AS CHARACTER
     1429        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1430        SIZE 98 BY 2
     1431        BGCOLOR 8 FGCOLOR 4  NO-UNDO.
     1432   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1433         VIEW-AS TEXT
     1434        SIZE 6 BY 1
     1435        FGCOLOR 4  NO-UNDO.
     1436   DEFINE VARIABLE sch-bank-date AS DATE FORMAT "99/99/9999":U
     1437        LABEL "Дате банка."
     1438        VIEW-AS FILL-IN
     1439        SIZE 11 BY 1 NO-UNDO.
     1440   DEFINE VARIABLE sch-BIK AS CHARACTER FORMAT "X(9)":U
     1441        LABEL "БИК"
     1442        VIEW-AS FILL-IN
     1443        SIZE 12 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1444   DEFINE VARIABLE sch-curr-code AS INTEGER FORMAT ">>9":U INITIAL 0
     1445        LABEL "коду вал"
     1446        VIEW-AS FILL-IN
     1447        SIZE 4 BY 1 NO-UNDO.
     1448   DEFINE VARIABLE sch-doc-date AS DATE FORMAT "99/99/9999":U
     1449        LABEL "Дате док-та"
     1450        VIEW-AS FILL-IN
     1451        SIZE 11 BY 1 NO-UNDO.
     1452   DEFINE VARIABLE sch-fact-date AS DATE FORMAT "99/99/9999":U
     1453        LABEL "Дате факт."
     1454        VIEW-AS FILL-IN
     1455        SIZE 11 BY 1 NO-UNDO.
     1456   DEFINE VARIABLE sch-prn-doc-code AS CHARACTER FORMAT "X(22)":U
     1457        LABEL "номеру"
     1458        VIEW-AS FILL-IN
     1459        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1460   DEFINE VARIABLE sch-r-schet AS CHARACTER FORMAT "X(35)":U
     1461        LABEL "Расч.счет"
     1462        VIEW-AS FILL-IN
     1463        SIZE 22 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1464   DEFINE QUERY br-c-fin-statement FOR
     1465         X_c-fin-statement SCROLLING.
     1466   DEFINE QUERY BR-changes FOR
     1467         temp-changes SCROLLING.
     1468   DEFINE BROWSE br-c-fin-statement
     1469     QUERY br-c-fin-statement DISPLAY
     1470         mark-string(recid(X_c-fin-statement), v-rid-list) FORMAT "X(1)":U
     1471   WIDTH 2
     1472   X_c-fin-statement.host-code COLUMN-LABEL "Код!фирмы" FORMAT "99999":U
     1473   X_c-fin-statement.prn-doc-code FORMAT "X(22)":U
     1474   X_c-fin-statement.corr-date FORMAT "99/99/9999" COLUMN-LABEL "Дата измен."
     1475   string(X_c-fin-statement.corr-time, "HH:MM:SS") FORMAT "X(8)" COLUMN-LABEL "Время"
     1476   usrfulnf(X_c-fin-statement.corr-user-name) FORMAT "X(18)" COLUMN-LABEL "Изменил"
     1477   X_c-fin-statement.fins-ext-doc-type COLUMN-LABEL "Расш.тип" FORMAT "X(8)":U
     1478   X_c-fin-statement.code-schet COLUMN-LABEL "Вн.№счета"
     1479   X_c-fin-statement.start-date FORMAT "99/99/9999":U COLUMN-LABEL "С"
     1480   X_c-fin-statement.end-date FORMAT "99/99/9999":U COLUMN-LABEL "По"
     1481   X_c-fin-statement.status_ FORMAT "X(8)":U
     1482   X_c-fin-statement.bank-date COLUMN-LABEL "Дата банка!(пост.из банка)" FORMAT "99/99/9999":U
     1483   X_c-fin-statement.fact-date FORMAT "99/99/9999":U
     1484   X_c-fin-statement.sum-doc FORMAT "->,>>>,>>>,>>>,>>9.99":U
     1485   X_c-fin-statement.cli-name COLUMN-LABEL "Название держателя счета" FORMAT "X(255)":U WIDTH 20
     1486   get-currency(buffer X_c-fin-statement) COLUMN-LABEL "Вал" FORMAT "X(3)":U
     1487   X_c-fin-statement.sttm-code COLUMN-LABEL "Вн.N" FORMAT "999999999":U
     1488   X_c-fin-statement.cl-bank COLUMN-LABEL "Кл-банк" FORMAT "X(8)"
     1489   ENABLE
     1490   X_c-fin-statement.prn-doc-code
     1491       WITH NO-ROW-MARKERS SEPARATORS SIZE 97.5 BY 9.
     1492   DEFINE BROWSE BR-changes
     1493     QUERY BR-changes DISPLAY
     1494         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1495   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1496   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1497       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 6.
     1498   DEFINE FRAME Dialog-Frame
     1499        b-quit AT ROW 1 COL 1
     1500        B-mark AT ROW 1 COL 11
     1501        b-sel AT ROW 1 COL 21
     1502        B-lookup AT ROW 1 COL 31
     1503        B-schet AT ROW 1 COL 41
     1504        B-print AT ROW 1 COL 89
     1505        B-sch AT ROW 1 COL 92
     1506        B-Help AT ROW 1 COL 95
     1507        br-c-fin-statement AT ROW 2.03 COL 1.4
     1508        ED-notes AT ROW 11.27 COL 1 NO-LABEL
     1509        sch-prn-doc-code AT ROW 13.27 COL 16 COLON-ALIGNED
     1510        sch-doc-date AT ROW 13.27 COL 38.1 COLON-ALIGNED
     1511        sch-fact-date AT ROW 13.27 COL 62 COLON-ALIGNED
     1512        sch-bank-date AT ROW 13.27 COL 86 COLON-ALIGNED
     1513        sch-r-schet AT ROW 14.33 COL 75 COLON-ALIGNED
     1514        sch-curr-code AT ROW 14.63 COL 9 COLON-ALIGNED
     1515        B-curr AT ROW 14.63 COL 15.5
     1516        sch-BIK AT ROW 14.63 COL 27.5 COLON-ALIGNED
     1517        BR-changes AT ROW 16.03 COL 1
     1518        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1519        "ПОИСК ПО" VIEW-AS TEXT
     1520             SIZE 8.4 BY 1 AT ROW 13.27 COL 1
     1521        SPACE(89.89) SKIP(7.77)
     1522       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1523            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1524            TITLE "Список выписок"
     1525            CANCEL-BUTTON b-quit.
     1526   ASSIGN
     1527          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1528          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1529   ASSIGN
     1530          br-c-fin-statement:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 1.
     1531   ON ENDKEY OF FRAME Dialog-Frame
     1532   DO:
     1533     run gbl/markqwa.p (
     1534                           input b-mark:sensitive
     1535                         , input v-rid-list) no-error.
     1536     if error-status:error then return no-apply.
     1537   END.
     1538   ON GO OF FRAME Dialog-Frame
     1539   DO:
     1540     p-rid-list = v-rid-list.
     1541   END.
     1542   ON CHOOSE OF B-curr IN FRAME Dialog-Frame
     1543   DO:
     1544   define variable rr as recid no-undo.
     1545   define buffer buf_currency for ub.currency.
     1546       rr = ? .
     1547       run ref/currency.w (
     1548                           input parparentproc
     1549                          ,input "b-sel"
     1550                          ,input-output rr ).
     1551       if rr <> ? then do:
     1552         FIND FIRST buf_currency WHERE
     1553               recid( buf_currency ) = rr NO-LOCK .
     1554         DISPLAY
     1555         buf_currency.curr-code @ sch-curr-code
     1556         with frame Dialog-Frame .
     1557       end.
     1558   END.
     1559   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
     1560   DO:
     1561   if not available X_c-fin-statement then return no-apply.
     1562   run proc-b-lookup in this-procedure no-error.
     1563   if error-status:error then do:
     1564     return no-apply.
     1565   end.
     1566   END.
     1567   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1568   DO:
     1569   define variable loc#log as logical no-undo .
     1570     if available X_c-fin-statement then do:
     1571   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1572   define variable v-str-recid15 as character no-undo .
     1573   define variable v-num-entry15 as integer   no-undo .
     1574   assign
     1575     v-str-recid15 = trim( string( recid( X_c-fin-statement ) , "->>>>>>>>>>>9":U ) )
     1576     v-num-entry15 = lookup( v-str-recid15 , v-rid-list )
     1577   .
     1578   if v-num-entry15 > 0 then do:
     1579     assign
     1580       entry( v-num-entry15, v-rid-list ) = "":U
     1581       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1582     .
     1583   end.
     1584   else do:
     1585     assign
     1586       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid15
     1587     .
     1588   end.
     1589       loc#log = br-c-fin-statement:refresh() .
     1590       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1591           loc#log = br-c-fin-statement:select-next-row ().
     1592           apply "VALUE-CHANGED" to br-c-fin-statement in frame Dialog-Frame.
     1593       end.
     1594       if num-entries( v-rid-list ) = 0
     1595       then
     1596           hide mark-num in frame Dialog-Frame.
     1597       else
     1598           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1599     end.
     1600     apply "entry" to br-c-fin-statement in frame Dialog-Frame.
     1601   END.
