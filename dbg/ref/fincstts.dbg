     4910   END PROCEDURE.
     4911   PROCEDURE proc-br-c-fin-statement :
     4912   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4913   if b-sel:sensitive in frame Dialog-Frame then dO:
     4914       if b-mark:sensitive then do:
     4915           apply "choose" to b-mark in frame Dialog-Frame.
     4916       end.
     4917       else do:
     4918           apply "choose" to b-sel in frame Dialog-Frame.
     4919       end.
     4920   end.
     4921   else do:
     4922       if b-lookup:sensitive then
     4923       apply "choose" to b-lookup in frame Dialog-Frame.
     4924   end.
     4925   END PROCEDURE.
     4926   PROCEDURE proc-find-bik :
     4927   define input parameter p-next as logical no-undo.
     4928   define input parameter p-bik like ub.c-fin-statement.bik no-undo.
     4929   assign
     4930   sch-doc-date = ?
     4931   sch-bank-date = ?
     4932   sch-fact-date = ?
     4933   .
     4934   display
     4935   "":U @ sch-prn-doc-code
     4936   0 @ sch-curr-code
     4937   sch-doc-date
     4938   sch-fact-date
     4939   sch-bank-date
     4940   with frame Dialog-Frame.
     4941   display
     4942   "":U @ sch-r-schet
     4943   with frame Dialog-Frame .
     4944   assign
     4945   p-bik = replace(p-bik, chr(34), "":U)
     4946   p-bik = replace(p-bik, chr(39), chr(39) + chr(39))
     4947   p-bik = chr(34) + p-bik + chr(34).
     4948   run OpenBr in this-procedure
     4949       ( input false
     4950        ,input p-next
     4951        ,input substitute("and X_c-fin-statement.bik   begins &1 "
     4952                         , p-bik)
     4953       ).
     4954   apply "entry":u to sch-bik in frame Dialog-Frame .
     4955   END PROCEDURE.
     4956   PROCEDURE proc-find-curr-code :
     4957   define input parameter p-next as logical no-undo.
     4958   define input parameter p-curr-code like ub.c-fin-statement.curr-code no-undo.
     4959   define variable v-curr-code-chr as character no-undo.
     4960   assign
     4961   sch-doc-date = ?
     4962   sch-bank-date = ?
     4963   sch-fact-date = ?
     4964   .
     4965   display
     4966   "":U @ sch-prn-doc-code
     4967   "":U @ sch-BIK
     4968   sch-doc-date
     4969   sch-fact-date
     4970   sch-bank-date
     4971   "":U @ sch-r-schet
     4972   with frame Dialog-Frame.
     4973   assign
     4974   v-curr-code-chr = string(p-curr-code)
     4975   .
     4976   run OpenBr in this-procedure
     4977       ( input false
     4978        ,input p-next
     4979        ,input substitute("and X_c-fin-statement.curr-code = &1 "
     4980                          , v-curr-code-chr)
     4981       ).
     4982   apply "entry":u to sch-curr-code in frame Dialog-Frame .
     4983   END PROCEDURE.
     4984   PROCEDURE proc-find-date :
     4985   define input parameter p-next as logical no-undo.
     4986   define input parameter p-date like ub.c-fin-statement.doc-date no-undo.
     4987   define input parameter p-what-date as character no-undo.
     4988   define variable v-date-chr as character no-undo.
     4989   if p-date = ? then return .
     4990   display
     4991   "":U @ sch-BIK
     4992   0 @ sch-curr-code
     4993   "":U @ sch-prn-doc-code
     4994   "":U @ sch-r-schet
     4995   with frame Dialog-Frame.
     4996   CASE p-what-date:
     4997       when "doc-date":U then do:
     4998         assign
     4999         sch-bank-date = ?
     5000         sch-fact-date = ?
     5001         .
     5002         display
     5003         sch-fact-date
     5004         sch-bank-date
     5005         with frame Dialog-Frame.
     5006       end.
     5007       when "fact-date":U then do:
     5008         assign
     5009         sch-doc-date = ?
     5010         sch-bank-date = ?
     5011         .
     5012         display
     5013         sch-doc-date
     5014         sch-bank-date
     5015         with frame Dialog-Frame.
     5016       end.
     5017       when "bank-date":U then do:
     5018         assign
     5019         sch-doc-date = ?
     5020         sch-fact-date = ?
     5021         .
     5022         display
     5023         sch-fact-date
     5024         sch-doc-date
     5025         with frame Dialog-Frame.
     5026       end.
     5027   END CASE.
     5028   assign
     5029   v-date-chr = string(day(p-date)) + chr(47) +
     5030                    string(month(p-date)) + chr(47) +
     5031                    string(year(p-date)).
     5032   CASE p-what-date:
     5033       when "doc-date":U then do:
     5034          run OpenBr in this-procedure
     5035           ( input false
     5036            ,input true
     5037            ,input substitute("and X_c-fin-statement.doc-date = &1 "
     5038                             , v-date-chr)
     5039           ).
     5040         apply "entry":u to sch-doc-date in frame Dialog-Frame.
     5041       end.
     5042       when "fact-date":U then do:
     5043          run OpenBr in this-procedure
     5044           ( input false
     5045            ,input true
     5046            ,input substitute("and X_c-fin-statement.fact-date = &1 "
     5047                               , v-date-chr)
     5048           ).
     5049         apply "entry":u to sch-fact-date in frame Dialog-Frame.
     5050       end.
     5051           when "bank-date":U then do:
     5052          run OpenBr in this-procedure
     5053           ( input false
     5054            ,input true
     5055            ,input substitute("and X_c-fin-statement.bank-date = &1 "
     5056                             , v-date-chr)
     5057           ).
     5058         apply "entry":u to sch-bank-date in frame Dialog-Frame.
     5059       end.
     5060   END CASE.
     5061   END PROCEDURE.
