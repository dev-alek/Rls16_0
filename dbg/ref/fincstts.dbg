     2480         :
     2481           if  v-object-handle <> v-diasize-browse-handle :handle
     2482           and v-object-handle <> v-diasize-resize-button
     2483           and can-query(v-object-handle, "row")
     2484           and can-query(v-object-handle, "height")
     2485           and ( v-object-handle :col + v-object-handle :width
     2486                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2487               )
     2488           then do:
     2489             find first buf_temp-browse-handle
     2490               where buf_temp-browse-handle.browse-type   = 'width':u
     2491                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2492               no-error .
     2493             if available buf_temp-browse-handle
     2494             then do:
     2495             end.
     2496             else do:
     2497               create buf_temp-diasize-handle .
     2498               assign
     2499                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2500                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2501               .
     2502             end.
     2503           end.
     2504           assign
     2505             v-object-handle = v-object-handle :next-sibling
     2506           .
     2507         end.
     2508         assign
     2509           v-field-group-handle = v-field-group-handle :next-sibling
     2510         .
     2511       end.
     2512       do with frame Dialog-Frame
     2513       :
     2514         hide v-diasize-resize-button .
     2515         v-diasize-resize-button :row = 1.
     2516         v-diasize-resize-button :column = 1.
     2517       end.
     2518       if p-change-value > 0
     2519       then do:
     2520         if frame Dialog-Frame :scrollable = true
     2521         then do:
     2522           assign
     2523             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2524             no-error .
     2525           if error-status :error
     2526           or error-status :get-message(1) <> ""
     2527           then do:
     2528             undo move_block, retry move_block.
     2529           end.
     2530         end.
     2531         assign
     2532           frame Dialog-Frame :width = v-frame-width + p-change-value
     2533           no-error .
     2534         if error-status :error
     2535         or error-status :get-message(1) <> ""
     2536         then do:
     2537           undo move_block, retry move_block.
     2538         end.
     2539         assign
     2540           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2541         no-error .
     2542         if error-status :error
     2543         or error-status :get-message(1) <> ""
     2544         then do:
     2545           undo move_block, retry move_block.
     2546         end.
     2547         for each buf_temp-browse-handle
     2548           where buf_temp-browse-handle.browse-type = 'width':u
     2549         on error undo move_block, retry move_block
     2550         :
     2551           assign
     2552             buf_temp-browse-handle.browse-handle :width
     2553               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2554             no-error .
     2555           if error-status :error
     2556           or error-status :get-message(1) <> ""
     2557           then do:
     2558             undo move_block, retry move_block .
     2559           end.
     2560         end.
     2561         for each buf_temp-diasize-handle
     2562         on error undo move_block, retry move_block
     2563         :
     2564           assign
     2565             v-object-handle = buf_temp-diasize-handle.handle-value
     2566           .
     2567           if v-object-handle <> v-diasize-resize-button
     2568           then do:
     2569             assign
     2570               v-object-handle :col = v-object-handle :col + p-change-value
     2571               no-error .
     2572             if error-status :error
     2573             or error-status :get-message(1) <> ""
     2574             then do:
     2575               undo move_block, retry move_block .
     2576             end.
     2577           end.
     2578         end.
     2579       end.
     2580       else do:
     2581         for each buf_temp-diasize-handle
     2582         on error undo move_block, retry move_block
     2583         :
     2584           assign
     2585             v-object-handle = buf_temp-diasize-handle.handle-value
     2586           .
     2587           if v-object-handle <> v-diasize-resize-button
     2588           then do:
     2589             assign
     2590               v-object-handle :col = v-object-handle :col + p-change-value
     2591               no-error .
     2592             if error-status :error
     2593             or error-status :get-message(1) <> ""
     2594             then do:
     2595               undo move_block, retry move_block .
     2596             end.
     2597           end.
     2598         end.
     2599         for each buf_temp-browse-handle
     2600           where buf_temp-browse-handle.browse-type = 'width':u
     2601         on error undo move_block, retry move_block
     2602         :
     2603           assign
     2604             buf_temp-browse-handle.browse-handle :width
     2605               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2606             no-error .
     2607           if error-status :error
     2608           or error-status :get-message(1) <> ""
     2609           then do:
     2610             undo move_block, retry move_block .
     2611           end.
     2612         end.
     2613         assign
     2614           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2615           no-error .
     2616         if error-status :error
     2617         or error-status :get-message(1) <> ""
     2618         then do:
     2619           undo move_block, retry move_block.
     2620         end.
     2621         assign
     2622           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2623         no-error .
     2624         if error-status :error
     2625         or error-status :get-message(1) <> ""
     2626         then do:
     2627           undo move_block, retry move_block.
     2628         end.
