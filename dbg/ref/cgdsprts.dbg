     2189         end.
     2190       end.
     2191       if p-move-resize
     2192       then do:
     2193         run diasize_position-resize-button in this-procedure .
     2194       end.
     2195       if v-diasize-wndstore = true
     2196       then do:
     2197         if connected("ub") = true
     2198         then do:
     2199           define variable v-cntxt-db-num        as integer   no-undo .
     2200           define variable v-cntxt-userid        as character no-undo .
     2201           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2202                                             , OUTPUT v-cntxt-userid
     2203                                             ) .
     2204           run gbl/wndsizew.p
     2205             (input  v-cntxt-db-num
     2206             ,input  v-cntxt-userid
     2207             ,input  v-diasize-proc-name
     2208             ,input  'width':u
     2209             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2210             ) .
     2211         end.
     2212       end.
     2213     end.
     2214     assign
     2215       v-diasize-change-size = false
     2216     .
     2217   end procedure.
     2218   procedure diasize_set-width :
     2219     define input  parameter p-new-width  as decimal   no-undo .
     2220     define input  parameter p-move-resize as logical   no-undo .
     2221     do
     2222     on error undo, return error return-value
     2223     :
     2224       run diasize_change-width in this-procedure
     2225         (input  (p-new-width - frame Dialog-Frame :width)
     2226         ,input  p-move-resize
     2227         ) .
     2228     end.
     2229   end procedure.
     2230   procedure diasize_position-resize-button :
     2231     do with frame Dialog-Frame
     2232     :
     2233       hide v-diasize-resize-button .
     2234       assign
     2235         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2236                     - 1
     2237                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2238         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2239                     - 1
     2240                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2241       .
     2242       view v-diasize-resize-button .
     2243     end.
     2244   end procedure.
     2245   on alt-right anywhere
     2246   do:
     2247     run diasize_change-width in this-procedure
     2248       (input 1
     2249       ,input true
     2250       ) .
     2251     return no-apply .
     2252   end.
     2253   on alt-left anywhere
     2254   do:
     2255     run diasize_change-width in this-procedure
     2256       (input -1
     2257       ,input true
     2258       ) .
     2259     return no-apply .
     2260   end.
     2261   on alt-down anywhere
     2262   do:
     2263     run diasize_change-height in this-procedure
     2264       (input 1
     2265       ,input true
     2266       ) .
     2267     return no-apply .
     2268   end.
     2269   on alt-up anywhere
     2270   do:
     2271     run diasize_change-height in this-procedure
     2272       (input -1
     2273       ,input true
     2274       ) .
     2275     return no-apply .
     2276   end.
     2277   on alt-enter of frame Dialog-Frame
     2278   do:
     2279     run diasize_maximize in this-procedure
     2280       (input  ?
     2281       ).
     2282     return no-apply .
     2283   end.
     2284   procedure diasize_end-move :
     2285     do
     2286     on error undo, return error return-value
     2287     :
     2288       define variable v-row-delta as decimal   no-undo .
     2289       define variable v-col-delta as decimal   no-undo .
     2290       define variable v-new-row as decimal   no-undo .
     2291       define variable v-new-col as decimal   no-undo .
     2292       assign
     2293         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2294         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2295       .
     2296       assign
     2297         v-row-delta = v-new-row - frame Dialog-Frame :height
     2298         v-col-delta = v-new-col - frame Dialog-Frame :width
     2299       .
     2300       run diasize_change-height in this-procedure
     2301         (input v-row-delta
     2302         ,input true
     2303         ) .
     2304       run diasize_change-width in this-procedure
     2305         (input v-col-delta
     2306         ,input true
     2307         ) .
     2308     end.
     2309   end procedure.
     2310   procedure diasize_maximize :
     2311     define input  parameter p-action as logical   no-undo .
     2312     do
     2313     on error undo, return error return-value
     2314     :
     2315       if p-action = ?
     2316       then do:
     2317         if v-diasize-need-maximize = true
     2318         then do:
     2319           assign
     2320             p-action = true
     2321           .
     2322         end.
     2323         else do:
     2324           assign
     2325             p-action = false
     2326           .
     2327         end.
     2328       end.
     2329       if p-action = true
     2330       then do:
     2331         run diasize_change-height in this-procedure
     2332           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2333               - frame Dialog-Frame :height-chars
     2334           ,input true
     2335           ) .
     2336         run diasize_change-width in this-procedure
     2337           (input session :width-chars
     2338               - frame Dialog-Frame :width-chars
     2339           ,input true
     2340           ) .
     2341         assign
     2342           v-diasize-need-maximize = false
     2343         .
     2344       end.
     2345       else do:
     2346         run diasize_change-width in this-procedure
     2347           (input v-diasize-orig-frame-width
     2348               - frame Dialog-Frame :width-chars
     2349           ,input true
     2350           ) .
     2351         run diasize_change-height in this-procedure
     2352           (input v-diasize-orig-frame-height
     2353               - frame Dialog-Frame :height-chars
     2354           ,input true
     2355           ) .
     2356         assign
     2357           v-diasize-need-maximize = true
     2358         .
     2359       end.
     2360     end.
     2361   end procedure.
     2362   procedure diasize_restore-orig-size :
     2363     do
     2364     on error undo, return error return-value
     2365     :
     2366       assign
     2367         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2368         v-diasize-current-frame-height = frame Dialog-Frame :height
     2369       .
     2370       run diasize_set-height in this-procedure
     2371         (input  v-diasize-orig-frame-height
     2372         ,input  true
     2373         ) .
     2374       run diasize_set-width in this-procedure
     2375         (input  v-diasize-orig-frame-width
     2376         ,input  true
     2377         ) .
     2378     end.
     2379   end procedure.
     2380   procedure diasize_restore-current-size :
     2381     do
     2382     on error undo, return error return-value
     2383     :
     2384       run diasize_set-height in this-procedure
     2385         (input  v-diasize-current-frame-height
     2386         ,input  true
     2387         ) .
     2388       run diasize_set-width in this-procedure
     2389         (input  v-diasize-current-frame-width
     2390         ,input  true
     2391         ) .
     2392     end.
     2393   end procedure.
     2394   procedure diasize_set-browse-handle :
     2395     define input  parameter p-browse-handle as handle   no-undo .
     2396     define buffer buf_temp-browse-handle for temp-browse-handle .
     2397     do
     2398     on error undo, return error return-value
     2399     :
     2400       assign
     2401         v-diasize-browse-handle = p-browse-handle
     2402       .
     2403       for each buf_temp-browse-handle
     2404       on error undo, return error return-value
     2405       :
     2406         delete buf_temp-browse-handle .
     2407       end.
     2408     end.
     2409   end procedure.
     2410   procedure diasize_add_browse :
     2411     define input  parameter p-browse-type   as character no-undo .
     2412     define input  parameter p-browse-handle as handle    no-undo .
     2413     define buffer buf_temp-browse-handle for temp-browse-handle .
     2414     do
     2415     on error undo, return error return-value
     2416     :
     2417       assign
     2418         v-diasize-browse-number = v-diasize-browse-number + 1
     2419       .
     2420       create buf_temp-browse-handle .
     2421       assign
     2422         buf_temp-browse-handle.browse-type   = p-browse-type
     2423         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2424         buf_temp-browse-handle.browse-handle = p-browse-handle
     2425       .
     2426     end.
     2427   end procedure.
     2428   procedure diasize_init :
     2429     define variable v-default-value    as logical   no-undo .
     2430     define variable v-restore-saved    as logical   no-undo .
     2431     define variable v-resize-value-str as character no-undo .
     2432     do
     2433     on error undo, return error return-value
     2434     :
     2435       do with frame Dialog-Frame
     2436       :
     2437         assign
     2438           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2439           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2440           v-diasize-browse-handle     = browse br-c-gds-prt :handle
     2441         .
     2442         create button v-diasize-resize-button
     2443         assign
     2444           parent        = frame Dialog-Frame :first-child
     2445           label         = "s"
     2446           height-pixels = 16
     2447           width-pixels  = 16
     2448           visible       = true
     2449           sensitive     = true
     2450           movable       = true
     2451           triggers:
     2452             on end-move persistent run diasize_end-move in this-procedure .
     2453           end triggers.
     2454         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2455         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2456         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2457         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2458         assign
     2459           v-diasize-wndmax = false
     2460         .
     2461         if connected("ub") = true
     2462         then do:
     2463           define variable v-cntxt-db-num        as integer   no-undo .
     2464           define variable v-cntxt-userid        as character no-undo .
     2465           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2466                                             , OUTPUT v-cntxt-userid
     2467                                             ) .
     2468           run gbl/wndpar_r.p
     2469             (input  v-cntxt-db-num
     2470             ,input  v-cntxt-userid
     2471             ,input  'wndmax':U
     2472             ,output v-diasize-wndmax
     2473             ,output v-default-value
     2474             ) .
     2475         end.
     2476         assign
     2477           v-diasize-wndstore = false
     2478         .
     2479         if connected("ub") = true
     2480         then do:
     2481           run gbl/wndpar_r.p
     2482             (input  v-cntxt-db-num
     2483             ,input  v-cntxt-userid
     2484             ,input  'wndstore':U
     2485             ,output v-diasize-wndstore
     2486             ,output v-default-value
     2487             ) .
     2488         end.
     2489         assign
     2490           v-diasize-proc-name = entry(1, program-name(2), '.')
     2491         .
     2492         if v-diasize-wndstore = true
     2493         then do:
     2494           assign
     2495             v-restore-saved = false
     2496           .
     2497           if connected("ub") = true
     2498           then do:
     2499             run gbl/wndsizer.p
     2500               (input  v-cntxt-db-num
     2501               ,input  v-cntxt-userid
     2502               ,input  v-diasize-proc-name
     2503               ,input  'height':u
     2504               ,output v-resize-value-str
     2505               ) .
     2506             if v-resize-value-str <> '':U
     2507             then do:
     2508               run diasize_change-height in this-procedure
     2509                 (input  integer(v-resize-value-str)
     2510                 ,input  true
     2511                 ) .
     2512               assign
     2513                 v-restore-saved = true
     2514               .
     2515             end.
     2516           end.
     2517           if connected("ub") = true
     2518           then do:
     2519             run gbl/wndsizer.p
     2520               (input  v-cntxt-db-num
     2521               ,input  v-cntxt-userid
     2522               ,input  v-diasize-proc-name
     2523               ,input  'width':u
     2524               ,output v-resize-value-str
     2525               ) .
     2526             if v-resize-value-str <> '':U
     2527             then do:
     2528               run diasize_change-width in this-procedure
     2529                 (input  integer(v-resize-value-str)
     2530                 ,input  true
     2531                 ) .
     2532               assign
     2533                 v-restore-saved = true
     2534               .
     2535             end.
     2536           end.
     2537           if v-restore-saved <> true
     2538           then do:
     2539             if v-diasize-wndmax = true
     2540             then do:
     2541               run diasize_maximize in this-procedure
     2542                 (input  true
     2543                 ) .
     2544             end.
     2545           end.
     2546         end.
     2547         else do:
     2548           if v-diasize-wndmax = true
     2549           then do:
     2550             run diasize_maximize in this-procedure
     2551               (input  true
     2552               ) .
     2553           end.
     2554         end.
     2555       end.
     2556     end.
     2557   end procedure.
     2558   procedure diasize_need-full-display :
     2559     define output parameter p-need-full-display as logical   no-undo .
     2560     do
     2561     on error undo, return error return-value
     2562     :
     2563       assign
     2564         p-need-full-display = v-diasize-need-full-display
     2565       .
     2566       assign
     2567         v-diasize-need-full-display = false
     2568       .
     2569     end.
     2570   end procedure.
     2571   procedure get-context :
     2572      define output parameter p-db-num as integer          no-undo.
     2573      define output parameter p-user-id as character        no-undo.
     2574      define variable v-login               as character    no-undo.
     2575      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2576      define buffer buf_user-login  for ub.user-login .
     2577      do
     2578      on error undo, return error
     2579      :
     2580            FIND FIRST buf_sys-ctrl no-lock.
     2581            ASSIGN
     2582               v-login = USERID("ub")
     2583               p-db-num = buf_sys-ctrl.db-num
     2584            .
     2585            FIND FIRST buf_user-login
     2586                 WHERE buf_user-login.db-num = p-db-num
     2587                   AND buf_user-login.user-login = v-login
     2588                 no-lock
     2589                 no-error
     2590                 .
     2591            IF AVAILABLE buf_user-login
     2592            THEN DO:
     2593               assign
     2594                  p-user-id = buf_user-login.user-id
     2595               .
     2596            END.
     2597      end.
     2598   end procedure.
     2599   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2600   procedure set-filter-name :
     2601   define input parameter p-filter-name as character no-undo .
     2602     do with frame Dialog-Frame:
     2603       if p-filter-name > "" then do:
     2604         assign
     2605           frame Dialog-Frame:title
     2606             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2607         .
     2608         assign
     2609           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2610         .
     2611       end.
     2612       else do:
     2613         assign
     2614           b-sch :tooltip = ""
     2615         .
     2616       end.
     2617     end.
     2618   end procedure.
     2619   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2620   on f5 of frame Dialog-Frame anywhere
     2621   do:
     2622     v-doc-rec = recid(X_c-gds-prt). run openbr in this-procedure ( input yes, input no, input '':U). reposition br-c-gds-prt to recid v-doc-rec no-error.
     2623                 APPLY 'VALUE-CHANGED' to br-c-gds-prt.
     2624       apply "VALUE-CHANGED" to BR-c-gds-prt.
     2625   end.
     2626   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2627   do:
     2628     BR-c-gds-prt :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2629   end.
     2630   def var sort-labelbr-c-gds-prt   as character no-undo .
     2631   def var sort-clmnbr-c-gds-prt    as handle    no-undo .
     2632   def var cur-clmnbr-c-gds-prt     as handle    no-undo .
     2633   def var cur-clmn-locbr-c-gds-prt as integer   no-undo .
     2634   def var re-querybr-c-gds-prt     as logical   initial no no-undo .
     2635   on start-search, ctrl-o of br-c-gds-prt in frame Dialog-Frame do:
     2636      run sort-brbr-c-gds-prt
     2637        (input (if available X_c-gds-prt
     2638                then recid(X_c-gds-prt)
     2639                else ?
     2640               )
     2641        ).
     2642   end.
     2643   PROCEDURE sort-brbr-c-gds-prt :
     2644     define input parameter p-recid as recid no-undo .
     2645     if re-querybr-c-gds-prt = no then do:
     2646       assign
     2647          cur-clmnbr-c-gds-prt = br-c-gds-prt:current-column in frame Dialog-Frame
     2648       .
     2649       if sort-clmnbr-c-gds-prt <> ? then sort-clmnbr-c-gds-prt:column-fgcolor = 0.
     2650       if cur-clmnbr-c-gds-prt = sort-clmnbr-c-gds-prt then do:
     2651         assign
     2652            sort-labelbr-c-gds-prt = ""
     2653            sort-clmnbr-c-gds-prt = ?
     2654         .
     2655        end.
     2656        else do:
     2657          assign
     2658            sort-labelbr-c-gds-prt = cur-clmnbr-c-gds-prt:label
     2659            sort-clmnbr-c-gds-prt  = cur-clmnbr-c-gds-prt
     2660            sort-clmnbr-c-gds-prt:column-fgcolor = 4
     2661          .
     2662        end.
     2663      end.
     2664     assign
     2665       cur-clmn-locbr-c-gds-prt = 1
     2666     .
     2667     def var column-handle as handle no-undo .
     2668     column-handle = br-c-gds-prt:first-column.
     2669     do while valid-handle(column-handle) :
     2670       if column-handle = cur-clmnbr-c-gds-prt then do:
     2671         leave .
     2672       end.
     2673       column-handle = column-handle:NEXT-COLUMN.
     2674       assign
     2675         cur-clmn-locbr-c-gds-prt = cur-clmn-locbr-c-gds-prt + 1
     2676       .
     2677     end.
     2678     case sort-labelbr-c-gds-prt:
     2679           when X_c-gds-prt.corr-date:label in browse br-c-gds-prt then DO:    assign       sort-column-name = "X_c-gds-prt.corr-date"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     2680           when X_c-gds-prt.corr-user-db-num:label in browse br-c-gds-prt then DO:    assign       sort-column-name = "X_c-gds-prt.corr-user-db-num"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     2681       otherwise do:
     2682         assign
     2683           sort-column-name = ""
     2684         .
     2685         run OpenBr in this-procedure ( input yes, input no, input '':U).
     2686         if sort-labelbr-c-gds-prt <> "" then do:
     2687           assign
     2688             cur-clmnbr-c-gds-prt:column-fgcolor = 0
     2689           .
     2690         end.
     2691         assign
     2692           cur-clmn-locbr-c-gds-prt = ?
     2693         .
     2694       end.
     2695     end case.
     2696     if p-recid <> ? then do:
     2697       reposition br-c-gds-prt to recid p-recid no-error.
     2698       apply "value-changed" to br-c-gds-prt in frame Dialog-Frame.
     2699     end.
     2700     apply "entry" to br-c-gds-prt in frame Dialog-Frame.
     2701   END PROCEDURE.
     2702   procedure re-open-query-srt-clmnbr-c-gds-prt:
     2703   if cur-clmnbr-c-gds-prt = ? then do:
     2704      run OpenBr in this-procedure ( input yes, input no, input '':U).
     2705   end.
     2706   else do:
     2707      assign re-querybr-c-gds-prt = yes.
     2708      run sort-brbr-c-gds-prt
     2709        (input (if available X_c-gds-prt
     2710                then recid(X_c-gds-prt)
     2711                else ?
     2712               )
     2713        ).
     2714      assign re-querybr-c-gds-prt = no.
     2715   end.
     2716   end.
     2717   MAIN-BLOCK:
     2718   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2719      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2720      if LOOKUP(p-mode, ("one":U  + chr(4) +
     2721                        "prt-root":U + chr(4) +
     2722                        'все':U + chr(4)),
     2723                        chr(4)
     2724                        ) > 0
     2725      THEN DO:
     2726        if p-mode = "one":U
     2727        then do:
     2728         find first X_gds-prt no-lock where
     2729                     X_gds-prt.node-code = p-node-code
     2730                 no-error .
     2731         if not available X_gds-prt
     2732         and not p-is-del
     2733         then do:
     2734             message
     2735             vss-workfile vss-revision vss-description skip
     2736             "Неверное значение параметра p-node-code и/или p-is-del" p-node-code p-is-del
     2737             view-as alert-box ERROR.
     2738             return.
     2739         end.
     2740        end.
     2741        if p-mode = "prt-root":U then do:
     2742         find first X_gds-prt no-lock where
     2743                     X_gds-prt.prt-root = p-node-code
     2744                 no-error .
     2745         if not available X_gds-prt
     2746         and not p-is-del
     2747         then do:
     2748             message
     2749             vss-workfile vss-revision vss-description skip
     2750             "Неверное значение параметра p-node-code и/или p-is-del" p-node-code p-is-del
     2751             view-as alert-box ERROR.
     2752             return.
     2753         end.
     2754        end.
     2755      end.
     2756     else do:
     2757         message vss-workfile vss-revision vss-description skip
     2758         "Неверный вызов - p-mode=" p-mode
     2759         view-as alert-box ERROR.
     2760         return.
     2761     end.
     2762     v-rid-list = p-rid-list.
     2763     RUN MyEnable.
     2764     HIDE mark-num in frame Dialog-Frame .
     2765     run OpenBR in this-procedure ( input yes, input no, input '':U).
     2766     run diasize_add_browse in this-procedure
     2767       (input  'width':u
     2768       ,input  browse br-changes :handle
     2769       ) .
     2770     run diasize_add_browse in this-procedure
     2771       (input  'width':u
     2772       ,input  v-full-name-old:handle
     2773       ) .
     2774     run diasize_add_browse in this-procedure
     2775       (input  'width':u
     2776       ,input  v-full-name-new:handle
     2777       ) .
     2778       run diasize_init in this-procedure .
     2779     WAIT-FOR GO OF FRAME Dialog-Frame.
     2780   END.
     2781   RUN disable_UI.
     2782   PROCEDURE disable_UI :
     2783     HIDE FRAME Dialog-Frame.
     2784   END PROCEDURE.
     2785   PROCEDURE enable_UI :
     2786     DISPLAY mark-num v-full-name-old v-full-name-new
     2787         WITH FRAME Dialog-Frame.
     2788     ENABLE b-quit B-mark b-sel B-sch B-Help mark-num BR-c-gds-prt BR-changes
     2789            v-full-name-old v-full-name-new
     2790         WITH FRAME Dialog-Frame.
     2791     VIEW FRAME Dialog-Frame.
     2792     OPEN QUERY BR-c-gds-prt FOR EACH X_c-gds-prt NO-LOCK.
     2793   END PROCEDURE.
     2794   PROCEDURE MyEnable :
     2795   br-changes:title in frame Dialog-Frame  = "":U.
     2796   assign
     2797   temp-changes.l_name:resizable in browse br-changes = true
     2798   temp-changes.v_old:resizable in browse br-changes = true
     2799   temp-changes.v_new:resizable in browse br-changes = true
     2800   temp-changes.l_name:width in browse br-changes = 30
     2801   temp-changes.v_old:width in browse br-changes = 40
     2802   temp-changes.v_new:width in browse br-changes = 40
     2803   .
     2804   DISPLAY
     2805   mark-num
     2806   br-changes
     2807   WITH FRAME Dialog-Frame .
     2808   ENABLE
     2809   B-quit
     2810   B-mark when lookup('b-mark':U, bttns) >0
     2811   B-sel when lookup('b-sel':U, bttns) >0
     2812   B-sch
     2813   B-Help
     2814   BR-c-gds-prt
     2815   br-changes
     2816   mark-num
     2817   WITH FRAME Dialog-Frame .
     2818   VIEW FRAME Dialog-Frame .
     2819   END PROCEDURE.
     2820   PROCEDURE OpenBr :
     2821   define input  parameter p-open-query     as logical   no-undo .
     2822   define input  parameter p-find-next      as logical   no-undo .
     2823   define input  parameter p-find-condition as character no-undo .
     2824   define variable l-query-was-opened as logical no-undo .
     2825   run waitfram-show in this-procedure ("Ждите...").
     2826   define variable sort-column-phrase as character no-undo .
     2827   case sort-column-name :
     2828     when "" then do:
     2829       assign
     2830         sort-column-phrase = ""
     2831       .
     2832     end.
     2833     otherwise do:
     2834       assign
     2835         sort-column-phrase = "by " + sort-column-name
     2836       .
     2837     end.
     2838   end case.
     2839   CASE p-mode:
     2840       when "one":U then do:
     2841           ASSIGN frame Dialog-Frame:TITLE = substitute("Справочник истории шкал товаров: вн № узла шкалы &1",
     2842                                                          p-node-code)
     2843           filter-point = filter-point0 + p-mode
     2844           filter-label = filter-label0 + " Один узел шкалы"
     2845           .
     2846   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2847   define variable  l-disable-where-20  as logical   no-undo .
     2848   define variable  l-filter-open-20    as logical   .
     2849   define variable  flt-rec-20       as recid     no-undo .
     2850   define variable  filter-name-20      as character no-undo .
     2851   define variable  where-phrase-20     as character no-undo .
     2852   define variable  sort-phrase-20      as character no-undo .
     2853   define variable  where-phrase-rus-20 as character no-undo .
     2854   define variable  sort-phrase-rus-20  as character no-undo .
     2855     run waitfram-show in this-procedure
     2856       (input "ЖДИТЕ ..."
     2857       ).
     2858   run gbl/flt-get.p
     2859     (input filter-point
     2860     ,output flt-rec-20
     2861     ,output filter-name-20
     2862     ,output where-phrase-20
     2863     ,output sort-phrase-20
     2864     ,output where-phrase-rus-20
     2865     ,output sort-phrase-rus-20
     2866     ).
     2867       run set-filter-name in this-procedure
     2868         (INPUT filter-name-20
     2869         ) no-error .
     2870     assign
     2871       l-filter-open-20 = false
     2872     .
     2873     if flt-rec-20 <> ?
     2874       or sort-column-phrase > ""
     2875     then do:
     2876       define variable  parameter-2-20 as character no-undo .
     2877       define variable  parameter-3-20 as character no-undo .
     2878       define variable  parameter-4-20 as character no-undo .
     2879       define variable  parameter-5-20 as character no-undo .
     2880       define variable  parameter-6-20 as character no-undo .
     2881       define variable  parameter-7-20 as character no-undo .
     2882         assign
     2883         parameter-3-20 =
     2884                                 "FOR EACH X_c-gds-prt"
     2885         parameter-4-20 =
     2886           (
     2887             if (" X_c-gds-prt.node-code = p-node-code " + " " + where-phrase-20) <> ""
     2888             then  substitute('X_c-gds-prt.node-code = &1', p-node-code)  + " " + where-phrase-20
     2889             else "true"
     2890           )
     2891         parameter-5-20 = (" " + "" + " " + "")
     2892         parameter-6-20 = if sort-phrase-20 = ''
     2893                              then
     2894           (
     2895           " " + "  " +
     2896             " " + sort-column-phrase +
     2897           " " + "  "
     2898           )
     2899                              else
     2900           (
     2901           " " + "  " +
     2902             " " + sort-column-phrase +
     2903           " " + sort-phrase-20
     2904           )
     2905         parameter-7-20 =
     2906           "   "
     2907       .
     2908       do
     2909       on stop undo, leave
     2910       on error undo, leave
     2911       :
     2912         assign
     2913           l-disable-where-20 =
     2914             (" X_c-gds-prt.node-code = p-node-code " + " " + where-phrase-20 = "")
     2915         .
     2916         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2917                             ,input query br-c-gds-prt:handle
     2918                             ,input parameter-3-20
     2919                             ,input parameter-4-20
     2920                             ,input parameter-5-20
     2921                             ,input parameter-6-20
     2922                             ,input parameter-7-20
     2923                             )
     2924         .
     2925         assign
     2926           l-filter-open-20 = true
     2927         .
     2928       end.
     2929       if l-filter-open-20 = false then do:
     2930         message
     2931           "Ошибка при фильтрации / сортировке" skip
     2932           "Будут показаны записи без учета фильтра" skip
     2933           view-as alert-box .
     2934       end.
     2935       else do:
     2936           assign
     2937             l-query-was-opened = true
     2938           .
     2939       end.
     2940     end.
     2941     if l-filter-open-20 = false then do:
     2942       OPEN QUERY br-c-gds-prt FOR EACH X_c-gds-prt
     2943         where  X_c-gds-prt.node-code = p-node-code
     2944     .
     2945         assign
     2946           l-query-was-opened = true
     2947         .
     2948     end.
     2949     run waitfram-hide in this-procedure .
     2950       end.
     2951       when "prt-root":U then do:
     2952           ASSIGN frame Dialog-Frame:TITLE = substitute("Справочник истории шкал товаров: Шкала &1",
     2953                                                          X_gds-prt.node-name)
     2954           filter-point = filter-point0 + p-mode
     2955           filter-label = filter-label0 + " Одна шкала"
     2956           .
     2957   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2958   define variable  l-disable-where-22  as logical   no-undo .
     2959   define variable  l-filter-open-22    as logical   .
     2960   define variable  flt-rec-22       as recid     no-undo .
     2961   define variable  filter-name-22      as character no-undo .
     2962   define variable  where-phrase-22     as character no-undo .
     2963   define variable  sort-phrase-22      as character no-undo .
     2964   define variable  where-phrase-rus-22 as character no-undo .
     2965   define variable  sort-phrase-rus-22  as character no-undo .
     2966     run waitfram-show in this-procedure
     2967       (input "ЖДИТЕ ..."
     2968       ).
     2969   run gbl/flt-get.p
     2970     (input filter-point
     2971     ,output flt-rec-22
     2972     ,output filter-name-22
     2973     ,output where-phrase-22
     2974     ,output sort-phrase-22
     2975     ,output where-phrase-rus-22
     2976     ,output sort-phrase-rus-22
     2977     ).
     2978       run set-filter-name in this-procedure
     2979         (INPUT filter-name-22
     2980         ) no-error .
     2981     assign
     2982       l-filter-open-22 = false
     2983     .
     2984     if flt-rec-22 <> ?
     2985       or sort-column-phrase > ""
     2986     then do:
     2987       define variable  parameter-2-22 as character no-undo .
     2988       define variable  parameter-3-22 as character no-undo .
     2989       define variable  parameter-4-22 as character no-undo .
     2990       define variable  parameter-5-22 as character no-undo .
     2991       define variable  parameter-6-22 as character no-undo .
     2992       define variable  parameter-7-22 as character no-undo .
     2993         assign
     2994         parameter-3-22 =
     2995                                 "FOR EACH X_c-gds-prt"
     2996         parameter-4-22 =
     2997           (
     2998             if (" X_c-gds-prt.prt-root = p-node-code " + " " + where-phrase-22) <> ""
     2999             then  substitute('X_c-gds-prt.prt-root = &1', p-node-code)  + " " + where-phrase-22
     3000             else "true"
     3001           )
     3002         parameter-5-22 = (" " + "" + " " + "")
     3003         parameter-6-22 = if sort-phrase-22 = ''
     3004                              then
     3005           (
     3006           " " + "  " +
     3007             " " + sort-column-phrase +
     3008           " " + "  "
     3009           )
     3010                              else
     3011           (
     3012           " " + "  " +
     3013             " " + sort-column-phrase +
     3014           " " + sort-phrase-22
     3015           )
     3016         parameter-7-22 =
     3017           "   "
     3018       .
     3019       do
     3020       on stop undo, leave
     3021       on error undo, leave
     3022       :
     3023         assign
     3024           l-disable-where-22 =
     3025             (" X_c-gds-prt.prt-root = p-node-code " + " " + where-phrase-22 = "")
     3026         .
     3027         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3028                             ,input query br-c-gds-prt:handle
     3029                             ,input parameter-3-22
     3030                             ,input parameter-4-22
     3031                             ,input parameter-5-22
     3032                             ,input parameter-6-22
     3033                             ,input parameter-7-22
     3034                             )
     3035         .
     3036         assign
     3037           l-filter-open-22 = true
     3038         .
     3039       end.
     3040       if l-filter-open-22 = false then do:
     3041         message
     3042           "Ошибка при фильтрации / сортировке" skip
     3043           "Будут показаны записи без учета фильтра" skip
     3044           view-as alert-box .
     3045       end.
     3046       else do:
     3047           assign
     3048             l-query-was-opened = true
     3049           .
     3050       end.
     3051     end.
     3052     if l-filter-open-22 = false then do:
     3053       OPEN QUERY br-c-gds-prt FOR EACH X_c-gds-prt
     3054         where  X_c-gds-prt.prt-root = p-node-code
     3055     .
     3056         assign
     3057           l-query-was-opened = true
     3058         .
     3059     end.
     3060     run waitfram-hide in this-procedure .
     3061       end.
     3062   END CASE.
     3063   apply "entry" to br-c-gds-prt in frame Dialog-Frame.
     3064   reposition br-c-gds-prt to row 1 no-error.
     3065   run waitfram-hide in this-procedure .
     3066   APPLY "VALUE-CHANGED":U to br-c-gds-prt.
     3067   END PROCEDURE.
     3068   PROCEDURE proc-b-sch :
     3069   assign
     3070   tbl = 'c-gds-prt'
     3071   join-tbl = 'X_c-gds-prt'
     3072   fld = ""
     3073   lab = ""
     3074   spr = ""
     3075   dim = '0'
     3076   .
     3077   run fltfield-add in this-procedure('action', 'Действие', 'hist-action',
     3078   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3079   run fltfield-add in this-procedure('corr-date', 'Дата изменений', '',
     3080   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3081   run fltfield-add in this-procedure('corr-time', 'Время изменений', 'time',
     3082   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3083   run fltfield-add in this-procedure('corr-user-db-num', 'БД изменений', '',
     3084   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3085   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     3086   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3087   DO on stop undo, leave:
     3088       run gbl/filter.w ( input parparentproc
     3089                       , input (filter-point + chr(4) +
     3090                                filter-label + chr(4) +
     3091                         string(yes))
     3092                       , input tbl
     3093                       , input join-tbl
     3094                       , input fld
     3095                       , input lab
     3096                       , input spr
     3097                       , input dim).
     3098       RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     3099   END .
     3100   END PROCEDURE.
     3101   PROCEDURE proc-view-changes :
     3102   define variable v-description as character no-undo .
     3103   define variable v-is-created as logical no-undo .
     3104   define variable v-is-deleted as logical no-undo .
     3105   define variable v-chg-fields as character no-undo.
     3106   define variable v-old-fields as character no-undo.
     3107   define variable ii as integer no-undo .
     3108   define variable jj as integer no-undo .
     3109   define variable v-field-name as character no-undo .
     3110   define variable v-field-label as character no-undo .
     3111   define buffer current_gds-prt for ub.gds-prt  .
     3112   define buffer new_c-gds-prt for ub.c-gds-prt  .
     3113   for each temp-changes:
     3114       delete temp-changes.
     3115   END.
     3116   if not available X_c-gds-prt then do:
     3117     Open QUery br-changes for each temp-changes.
     3118     return.
     3119   end.
     3120   assign
     3121   v-full-name-old = "":U
     3122   v-full-name-new = "":U
     3123   .
     3124   if X_c-gds-prt.action = integer('1':U) then do:
     3125     assign
     3126     v-is-created = yes
     3127     v-chg-fields = get-all-fields ("gds-prt")
     3128     .
     3129   end.
     3130   if X_c-gds-prt.action = integer('99':U) then do:
     3131     assign
     3132     v-is-deleted = yes
     3133     v-chg-fields = get-all-fields ("gds-prt")
     3134     .
     3135   end.
     3136   find first new_c-gds-prt no-lock where
     3137               new_c-gds-prt.node-code = X_c-gds-prt.node-code
     3138           AND new_c-gds-prt.chip-num > X_c-gds-prt.chip-num
     3139           AND new_c-gds-prt.corr-user-db-num = X_c-gds-prt.corr-user-db-num
     3140           no-error .
     3141   if not available new_c-gds-prt then do:
     3142       find first current_gds-prt no-lock where
     3143               current_gds-prt.node-code = X_c-gds-prt.node-code no-error .
     3144       if not available current_gds-prt
     3145       and not  v-is-deleted
     3146       then do:
     3147           return error.
     3148       end.
     3149       if available current_gds-prt then
     3150       buffer-compare current_gds-prt to X_c-gds-prt
     3151       case-sensitive
     3152       save result in v-chg-fields.
     3153   end.
     3154   else do:
     3155       buffer-compare new_c-gds-prt
     3156       except chip-num corr-date corr-time corr-user-name corr-user-db-num
     3157       to X_c-gds-prt
     3158       case-sensitive
     3159       save result in v-chg-fields.
     3160   end.
     3161   if lookup("node-code", v-chg-fields ) > 0
     3162   or lookup("upper-code", v-chg-fields ) > 0 then do:
     3163       if not v-is-created then do:
     3164       assign
     3165       v-full-name-old = X_c-gds-prt.f-name.
     3166       end.
     3167       if not v-is-deleted then do:
     3168       assign
     3169       v-full-name-old = if available current_gds-prt then current_gds-prt.f-name  else new_c-gds-prt.f-name.
     3170       end.
     3171   end.
     3172   _ii:
     3173   do ii = 1 to num-entries(v-chg-fields):
     3174     assign
     3175     v-field-name = entry(ii, v-chg-fields)
     3176     jj = lookup(v-field-name, "prt-num,prt-root,is-term,lvl-num,node-code,node-name,root,upper-code").
     3177     if jj = 0 then next _ii.
     3178     assign
     3179     v-field-label = entry(jj, "Порядковый № в группе признаков одного уровня,Вн № выш.узла корневого признака шкалы,Терминальная,Уровень,Вн №,Наименование,Корневой?,Вн № выш.узла")
     3180     .
     3181     create temp-changes.
     3182     assign
     3183     temp-changes.f_name = v-field-name
     3184     temp-changes.l_name = v-field-label
     3185     temp-changes.v_old =  (if v-is-created
     3186                             then "":U
     3187                             else  string(buffer X_c-gds-prt:buffer-field(v-field-name):buffer-value))
     3188     temp-changes.v_new = (if available new_c-gds-prt
     3189                           then string(buffer new_c-gds-prt:buffer-field(v-field-name):buffer-value)
     3190                           else (if v-is-deleted
     3191                                 then '':U
     3192                                 else string(buffer current_gds-prt:buffer-field(v-field-name):buffer-value))
     3193                           )
     3194     .
     3195   end.
     3196   Open QUery br-changes for each temp-changes.
     3197   assign
     3198   br-changes:title in frame Dialog-Frame = v-description
     3199   .
     3200   if v-full-name-old <> "":U
     3201   or v-full-name-new <> "":U  then do:
     3202     DISPLAY
     3203     v-full-name-old
     3204     v-full-name-new
     3205     WITH FRAME Dialog-Frame.
     3206   end.
     3207   else do:
     3208     hide
     3209     v-full-name-old
     3210     v-full-name-new
     3211     IN FRAME Dialog-Frame.
     3212   end.
     3213   END PROCEDURE.
     3214   FUNCTION get-action RETURNS CHARACTER
     3215     (  p-action as integer ) :
     3216     define variable dops as character no-undo.
     3217   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     3218   RETURN dops.
     3219   END FUNCTION.
