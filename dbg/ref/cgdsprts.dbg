      876   FUNCTION get-all-fields returns character (p-file-name as character ):
      877   define variable v-dop as character no-undo .
      878     find first _file no-lock where _file._file-name = p-file-name no-error .
      879     if not available _file then return "":U.
      880     for each _field no-lock where
      881              _field._file-recid = recid(_file) :
      882       assign
      883       v-dop = v-dop + _field._field-name + chr(44)
      884       .
      885     end.
      886     return trim(v-dop).
      887   END FUNCTION.
      888   PROCEDURE proc-full-temp-changes :
      889     define input  parameter p-hst-handle as handle    no-undo .
      890     define input  parameter p-main-table as character no-undo .
      891     define input  parameter p-field-list as character no-undo .
      892     define input  parameter p-label-form as character no-undo .
      893     define variable h-new-buf         as handle    no-undo .
      894     define variable h-main-buf        as handle    no-undo .
      895     define variable h-for-comp        as handle    no-undo .
      896     define variable v-inform          as character no-undo .
      897     define variable v-ind             as integer   no-undo .
      898     define variable v-idx-field-qnty  as integer   no-undo .
      899     define variable v-num-entries     as integer   no-undo .
      900     define variable fh                as handle    no-undo .
      901     define variable fh-main           as handle    no-undo .
      902     define variable fh-old            as handle    no-undo .
      903     define variable fh-new            as handle    no-undo .
      904     define variable v-field-name      as character no-undo .
      905     define variable v-field-lvl       as character no-undo .
      906     define variable v-field-form      as character no-undo .
      907     define variable v-search-exp      as character no-undo .
      908     define variable v-srch-main       as character no-undo .
      909     define variable v-word-link       as character no-undo .
      910     define variable v-av-chip-num     as logical   no-undo .
      911     define variable v-main-pi-fld-lst as character no-undo .
      912     define variable v-main-fld-lst    as character no-undo .
      913     define variable v-delim-list      as character no-undo .
      914     define variable v-label           as character no-undo .
      915     define variable v-old-value       as character no-undo case-sensitive.
      916     define variable v-new-value       as character no-undo case-sensitive.
      917     define variable v-chg-fields as character no-undo.
      918     for each temp-changes:
      919       delete temp-changes.
      920     end.
      921     if not p-hst-handle:available then do:
      922       return .
      923     end.
      924     create buffer h-new-buf  for table p-hst-handle .
      925     create buffer h-main-buf for table p-main-table .
      926     assign
      927       v-inform = h-main-buf:index-information(1)
      928       v-ind    = 2
      929     .
      930     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      931     on error undo, return error
      932     :
      933       assign
      934         v-inform = h-main-buf:index-information( v-ind )
      935         v-ind    = v-ind + 1
      936       .
      937     end.
      938     if v-inform = ?
      939       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      940       or entry( 3, v-inform, ",":U ) <> "1":U
      941     then do:
      942       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      943     end.
      944     assign
      945       v-idx-field-qnty = num-entries( v-inform ) - 4
      946     .
      947     if v-idx-field-qnty < 2 then do:
      948       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      949     end.
      950     assign
      951       v-srch-main   = "where":U
      952       v-word-link   = "":U
      953       v-av-chip-num = false
      954       v-delim-list  = "":U
      955     .
      956     do v-ind = 1 to v-idx-field-qnty by 2
      957     on error undo, return error
      958     :
      959       assign
      960         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      961         fh                = p-hst-handle:buffer-field( v-field-name )
      962         fh-main           = h-main-buf:buffer-field( v-field-name )
      963         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      964         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      965       .
      966       if fh:data-type ="character":U then do:
      967         assign
      968           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      969         .
      970       end.
      971       else do:
      972         assign
      973           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      974         .
      975       end.
      976       if v-delim-list = "":U then do:
      977         assign
      978           v-delim-list = ",":U
      979         .
      980       end.
      981       if v-word-link = "":U then do:
      982         assign
      983           v-word-link = "and":U
      984         .
      985       end.
      986     end.
      987     assign
      988       v-delim-list  = "":U
      989     .
      990     do v-ind = 1 to h-main-buf:num-fields
      991     on error undo, return error
      992     :
      993       assign
      994         fh-main      = h-main-buf:buffer-field( v-ind )
      995         v-field-name = fh-main:name
      996       .
      997         assign
      998           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      999         .
     1000         if v-delim-list = "":U then do:
     1001           assign
     1002             v-delim-list = ",":U
     1003           .
     1004         end.
     1005     end.
     1006     assign
     1007       v-inform = p-hst-handle:index-information(1)
     1008       v-ind    = 2
     1009     .
     1010     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1011     on error undo, return error
     1012     :
     1013       assign
     1014         v-inform = p-hst-handle:index-information( v-ind )
     1015         v-ind    = v-ind + 1
     1016       .
     1017     end.
     1018     if v-inform = ?
     1019       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1020       or entry( 3, v-inform, ",":U ) <> "1":U
     1021     then do:
     1022       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1023     end.
     1024     assign
     1025       v-idx-field-qnty = num-entries( v-inform ) - 4
     1026     .
     1027     if v-idx-field-qnty < 2 then do:
     1028       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1029     end.
     1030     assign
     1031       v-search-exp  = "where":U
     1032       v-word-link   = "":U
     1033       v-av-chip-num = false
     1034     .
     1035     do v-ind = 1 to v-idx-field-qnty by 2
     1036     on error undo, return error
     1037     :
     1038       assign
     1039         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1040         fh           = p-hst-handle:buffer-field( v-field-name )
     1041         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1042       .
     1043       if v-field-name = "chip-num":U then do:
     1044         assign
     1045           v-search-exp  = substitute( "&1 >", v-search-exp )
     1046           v-av-chip-num = true
     1047         .
     1048       end.
     1049       else do:
     1050         assign
     1051           v-search-exp = substitute( "&1 =", v-search-exp )
     1052         .
     1053       end.
     1054       if fh:data-type ="character":U then do:
     1055         assign
     1056           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1057         .
     1058       end.
     1059       else do:
     1060         assign
     1061           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1062         .
     1063       end.
     1064       if v-word-link = "":U then do:
     1065         assign
     1066           v-word-link = "and":U
     1067         .
     1068       end.
     1069     end.
     1070     if v-av-chip-num = false then do:
     1071       message
     1072         vss-workfile vss-revision vss-description skip
     1073         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1074         "Использование данной процедуры невозможно!" skip
     1075         view-as alert-box error .
     1076       return error .
     1077     end.
     1078     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1079     if not h-new-buf:available then do:
     1080       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1081       if not h-main-buf:available then do:
     1082         assign
     1083           h-for-comp = ?
     1084         .
     1085       end.
     1086       else do:
     1087         assign
     1088           h-for-comp = h-main-buf
     1089         .
     1090       end.
     1091     end.
     1092     else do:
     1093       assign
     1094         h-for-comp = h-new-buf
     1095       .
     1096     end.
     1097     assign
     1098       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1099     .
     1100     do v-ind = 1 to v-num-entries
     1101     on error undo, return error return-value
     1102     :
     1103       assign
     1104         v-field-name = entry( v-ind, v-main-fld-lst )
     1105         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1106         v-old-value  = fh-old:buffer-value()
     1107         v-label      = trim( fh-old:label )
     1108       .
     1109       if ( trim( p-field-list ) <> "":U
     1110            and lookup( v-field-name, p-field-list ) > 0
     1111          )
     1112          or trim( p-field-list ) = "":U
     1113       then do:
     1114         if h-for-comp <> ? then do:
     1115           assign
     1116             fh-new      = h-for-comp:buffer-field( v-field-name )
     1117             v-new-value = fh-new:buffer-value()
     1118           .
     1119         end.
     1120         else do:
     1121           assign
     1122             v-new-value = "":U
     1123           .
     1124         end.
     1125         if v-old-value <> v-new-value
     1126         then do:
     1127           create temp-changes.
     1128           assign
     1129             temp-changes.t_name = p-main-table
     1130             temp-changes.f_name = v-field-name
     1131             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1132             temp-changes.v_old  = trim( v-old-value )
     1133             temp-changes.v_new  = trim( v-new-value )
     1134             temp-changes.num_   = 0
     1135             temp-changes.fNotChange = v-old-value eq v-new-value
     1136           .
     1137         end.
     1138       end.
     1139     end.
     1140     assign
     1141       v-num-entries = num-entries( p-label-form, chr(8) )
     1142     .
     1143     do v-ind = 1 to v-num-entries
     1144     on error undo, return error return-value
     1145     :
     1146       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1147         assign
     1148           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1149           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1150           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1151         .
     1152         find first temp-changes
     1153           where temp-changes.f_name = v-field-name
     1154           no-error .
     1155         if available temp-changes then do:
     1156           if trim( v-field-lvl ) <> "":U then do:
     1157             assign
     1158               temp-changes.l_name = v-field-lvl
     1159             .
     1160           end.
     1161           if trim( v-field-form ) <> "":U then do:
     1162             assign
     1163               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1164             .
     1165             if h-for-comp <> ? then do:
     1166               assign
     1167                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1168               .
     1169             end.
     1170           end.
     1171         end.
     1172       end.
     1173       else do:
     1174         message
     1175           vss-workfile vss-revision vss-description skip
     1176           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1177           substitute( "список для поля '&1': '&2'"
     1178                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1179                       ,entry( v-ind, p-label-form, chr(8) )
     1180                     ) skip
     1181           substitute( "полный список: &2", p-label-form ) skip
     1182           view-as alert-box error .
     1183       end.
     1184     end.
     1185     delete object h-new-buf .
     1186     delete object h-main-buf .
     1187   END PROCEDURE.
     1188   FUNCTION get-action RETURNS CHARACTER
     1189     (  p-action as integer )  FORWARD.
     1190   DEFINE BUTTON B-Help
     1191        LABEL "Помо&щь"
     1192        SIZE 3 BY 1
     1193        BGCOLOR 8 .
     1194   DEFINE BUTTON B-mark
     1195        LABEL "&*"
     1196        SIZE 3 BY 1.
     1197   DEFINE BUTTON b-quit AUTO-END-KEY
     1198        LABEL "&Выход"
     1199        SIZE 10 BY 1
     1200        BGCOLOR 8 .
     1201   DEFINE BUTTON B-sch
     1202        LABEL "&Фильтр"
     1203        SIZE 3 BY 1.
     1204   DEFINE BUTTON b-sel AUTO-GO
     1205        LABEL "Вы&бор"
     1206        SIZE 10 BY 1.
     1207   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1208        VIEW-AS FILL-IN
     1209        SIZE 9 BY 1
     1210        FGCOLOR 4  NO-UNDO.
     1211   DEFINE VARIABLE v-full-name-new AS CHARACTER FORMAT "X(256)":U
     1212        LABEL "Стало"
     1213        VIEW-AS FILL-IN
     1214        SIZE 91 BY 1 NO-UNDO.
     1215   DEFINE VARIABLE v-full-name-old AS CHARACTER FORMAT "X(256)":U
     1216        LABEL "Было"
     1217        VIEW-AS FILL-IN
     1218        SIZE 91 BY 1 NO-UNDO.
     1219   DEFINE QUERY BR-c-gds-prt FOR
     1220         X_c-gds-prt SCROLLING.
     1221   DEFINE QUERY BR-changes FOR
     1222         temp-changes SCROLLING.
     1223   DEFINE BROWSE BR-c-gds-prt
     1224     QUERY BR-c-gds-prt DISPLAY
     1225         mark-string( recid(X_c-gds-prt), v-rid-list ) COLUMN-LABEL "*" FORMAT "X(1)":U
     1226   X_c-gds-prt.corr-date COLUMN-LABEL "Дата корр" FORMAT "99/99/9999":U
     1227   usrfulnf(X_c-gds-prt.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
     1228   X_c-gds-prt.corr-user-db-num COLUMN-LABEL "БД" FORMAT ">>>>9":U
     1229       WIDTH 6
     1230   X_c-gds-prt.node-code COLUMN-LABEL "Вн.№ узла" FORMAT ">,>>>,>>9":U
     1231   get-action(X_c-gds-prt.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1232   string(X_c-gds-prt.corr-time, "HH:MM") COLUMN-LABEL "Время!корр" FORMAT "X(5)":U
     1233       WIDTH 6
     1234       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.25.
     1235   DEFINE BROWSE BR-changes
     1236     QUERY BR-changes DISPLAY
     1237         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1238   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1239   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1240       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 5.25.
     1241   DEFINE FRAME Dialog-Frame
     1242        b-quit AT ROW 1 COL 1
     1243        B-mark AT ROW 1 COL 11
     1244        b-sel AT ROW 1 COL 14
     1245        B-sch AT ROW 1 COL 92
     1246        B-Help AT ROW 1 COL 95
     1247        mark-num AT ROW 1.92 COL 9 COLON-ALIGNED NO-LABEL
     1248        BR-c-gds-prt AT ROW 3 COL 1
     1249        BR-changes AT ROW 14.5 COL 1
     1250        v-full-name-old AT ROW 20 COL 2
     1251        v-full-name-new AT ROW 21 COL 1
     1252        SPACE(0.24) SKIP(0.04)
     1253       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1254            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1255            TITLE "Справочник истории шкал"
     1256            CANCEL-BUTTON b-quit.
     1257   ASSIGN
     1258          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1259          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1260   ON GO OF FRAME Dialog-Frame
     1261   DO:
     1262     p-rid-list = v-rid-list.
     1263   END.
     1264   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1265   DO:
     1266     APPLY "END-ERROR":U TO SELF.
     1267   END.
     1268   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1269   DO:
     1270   define variable g#log as logical no-undo .
     1271   if not available X_c-gds-prt then return no-apply.
     1272   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1273   define variable v-str-recid12 as character no-undo .
     1274   define variable v-num-entry12 as integer   no-undo .
     1275   assign
     1276     v-str-recid12 = trim( string( recid( X_c-gds-prt ) , "->>>>>>>>>>>9":U ) )
     1277     v-num-entry12 = lookup( v-str-recid12 , v-rid-list )
     1278   .
     1279   if v-num-entry12 > 0 then do:
     1280     assign
     1281       entry( v-num-entry12, v-rid-list ) = "":U
     1282       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1283     .
     1284   end.
     1285   else do:
     1286     assign
     1287       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid12
     1288     .
     1289   end.
     1290     g#log = br-c-gds-prt :refresh( )  in frame Dialog-Frame.
     1291     if not can-do ("MOUSE-SELECT-DBLCLICK,Return", last-event:function) then do:
     1292             g#log = br-c-gds-prt:select-next-row () in frame Dialog-Frame.
     1293             apply "value-changed" to br-c-gds-prt in frame Dialog-Frame.
     1294     end.
     1295     if num-entries (v-rid-list) = 0 then
     1296         hide mark-num in frame Dialog-Frame.
     1297     else
     1298     disp num-entries (v-rid-list) @ mark-num
     1299     with frame Dialog-Frame.
     1300     apply "entry" to br-c-gds-prt in frame Dialog-Frame.
     1301   END.
     1302   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1303   DO:
     1304     run proc-b-sch in this-procedure no-error.
     1305     if error-status:error then return no-apply.
     1306   END.
     1307   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1308   DO:
     1309       if ( available X_c-gds-prt ) AND ( v-rid-list = "" ) then
     1310           v-rid-list = string( recid( X_c-gds-prt ) ) .
     1311   END.
     1312   ON RETURN OF BR-c-gds-prt IN FRAME Dialog-Frame
     1313   DO:
     1314         apply "DEFAULT-ACTION":U to self.
     1315   END.
     1316   ON VALUE-CHANGED OF BR-c-gds-prt IN FRAME Dialog-Frame
     1317   DO:
     1318     run proc-view-changes in this-procedure no-error.
     1319   END.
     1320   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1321   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1322   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1323   on help of frame Dialog-Frame
     1324   do:
     1325     run gbl/app_help.p
     1326       (input this-procedure :file-name
     1327       ,input ''
     1328       ,input ?
     1329       ) no-error.
     1330     if error-status :error then do:
     1331       message
     1332         "Ошибка при вызове помощи"
     1333         error-status :get-message(1)
     1334         view-as alert-box .
     1335     end.
     1336   end.
     1337   run minbtn-set in this-procedure .
     1338   on choose of b-help in frame Dialog-Frame
     1339   do:
     1340     apply "help":u to frame Dialog-Frame .
     1341   end.
     1342   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1343   procedure minbtn-set :
     1344       do
     1345           on error undo, return error return-value
     1346           :
     1347           define variable ii              as integer       no-undo .
     1348           define variable fh              as widget-handle no-undo .
     1349           define variable hh              as widget-handle no-undo .
     1350           define variable v-h             as handle        extent 4 no-undo .
     1351           define variable v-name-button   as character     no-undo .
     1352           define variable v-help-old-x    as decimal       no-undo .
     1353           define variable v-help-old-y    as decimal       no-undo .
     1354           define variable v-help-old-size as decimal       no-undo .
     1355           define variable v-frame-width   as decimal       no-undo .
     1356           define variable jj              as integer       no-undo .
     1357           do
     1358               on error undo, return error
     1359               :
     1360               assign
     1361                   v-frame-width = frame Dialog-Frame:width - 0.3
     1362                   fh            = frame Dialog-Frame:first-child
     1363                   hh            = fh:first-child
     1364                   ii            = 1
     1365                   .
     1366               do while valid-handle(hh):
     1367                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1368                   do:
     1369                       case lc(hh:name) :
     1370                           when "b-help" then
     1371                               do:
     1372                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1373                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1374                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1375                                   hh:TOOLTIP = "Помощь" .
     1376                                   v-help-old-x = hh:column .
     1377                                   v-help-old-y = hh:row    .
     1378                                   v-help-old-size = hh:width .
     1379                                   hh:width-chars = 2.5 .
     1380                               end.
     1381                           when "b-print" then
     1382                               do:
     1383                                   hh:load-image("cmp/b-print.bmp":u) .
     1384                                   hh:TOOLTIP = "Печать" .
     1385                                   v-h[ii] = hh:handle .
     1386                                   ii = ii + 1 .
     1387                                   hh:width-chars = 3 .
     1388                               end.
     1389                           when "b-history" or
     1390                           when "b-hist" then
     1391                               do:
     1392                                   hh:load-image("cmp/b-hist.bmp":u) .
     1393                                   hh:TOOLTIP = "История" .
     1394                                   v-h[ii] = hh:handle .
     1395                                   ii = ii + 1 .
     1396                                   hh:width-chars = 3 .
     1397                               end.
     1398                           when "b-sch" then
     1399                               do:
     1400                                   hh:load-image("cmp/b-sch.bmp":u) .
     1401                                   hh:TOOLTIP = "Установка Фильтра" .
     1402                                   v-h[ii] = hh:handle .
     1403                                   ii = ii + 1 .
     1404                                   hh:width-chars = 3 .
     1405                               end.
     1406                           when "b-hist-user" then
     1407                               do:
     1408                                   hh:load-image("cmp/b-hist.bmp":u) .
     1409                                   hh:TOOLTIP = "История пользователя" .
     1410                                   ii = ii + 1 .
     1411                               end.
     1412                       end case.
     1413                   end.
     1414                   hh = hh:next-sibling.
     1415               end.
     1416               b-help:column = v-frame-width - b-help:width-chars.
     1417               jj = 0.
     1418               repeat ii = 4 to 1 by -1 :
     1419                   if valid-handle (v-h[ii] ) then
     1420                   do:
     1421                       jj  = jj + 1 .
     1422                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1423                       v-h[ii]:row    = v-help-old-y .
     1424                   end.
     1425               end.
     1426           end.
     1427       end.
     1428   end procedure.
     1429   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1430   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1431   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1432   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1433   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1434   define variable v-diasize-current-frame-height as decimal   no-undo .
     1435   define variable v-diasize-change-size          as logical   no-undo .
     1436   define variable v-diasize-resize-button        as handle    no-undo .
     1437   define variable v-diasize-wndmax               as logical   no-undo .
     1438   define variable v-diasize-wndstore             as logical   no-undo .
     1439   define variable v-diasize-proc-name            as character no-undo .
     1440   define variable v-diasize-browse-handle        as handle    no-undo .
     1441   define variable v-diasize-browse-number        as integer   no-undo .
     1442   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1443   define temp-table temp-diasize-handle no-undo
     1444     field handle-value  as handle
     1445     field save-position as decimal
     1446     index xpk is primary unique handle-value
     1447     .
     1448   define temp-table temp-browse-handle no-undo
     1449     field browse-type   as character
     1450     field browse-number as integer
     1451     field browse-handle as handle
     1452     field original-size as decimal
     1453     index xpk is primary unique browse-type browse-number
     1454     index xie browse-type browse-handle
     1455   .
     1456   procedure diasize_change-height :
     1457     define input  parameter p-change-value  as decimal   no-undo .
     1458     define input  parameter p-move-resize   as logical   no-undo .
     1459     define variable v-field-group-handle    as handle    no-undo .
     1460     define variable v-object-handle         as handle    no-undo .
     1461     define variable v-frame-height          as decimal   no-undo .
     1462     define variable v-frame-virtual-height  as decimal   no-undo .
     1463     define variable v-browse-height         as decimal   no-undo .
     1464     define variable v-window-height         as decimal   no-undo .
     1465     define variable v-window-virtual-height as decimal   no-undo .
     1466     define variable v-change-sign           as integer   no-undo .
     1467     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1468     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1469     if p-change-value > 0
     1470     then do:
     1471       if frame Dialog-Frame :height + p-change-value
     1472           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1473       then do:
     1474         assign
     1475           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1476                           - (frame Dialog-Frame :height-chars)
     1477         .
     1478         if p-change-value <= 0
     1479         then do:
     1480           run diasize_position-resize-button in this-procedure .
     1481           return .
     1482         end.
     1483       end.
     1484     end.
     1485     if p-change-value < 0
     1486     then do:
     1487       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1488       then do:
     1489         assign
     1490           p-change-value = v-diasize-orig-frame-height
     1491                          - (frame Dialog-Frame :height-chars)
     1492         .
     1493         if p-change-value >= 0
     1494         then do:
     1495           run diasize_position-resize-button in this-procedure .
     1496           return .
     1497         end.
     1498       end.
     1499     end.
     1500     if p-change-value >= 0
     1501     then do:
     1502       assign
     1503         v-change-sign = 1
     1504       .
     1505     end.
     1506     else do:
     1507       assign
     1508         v-change-sign = -1
     1509       .
     1510     end.
     1511     assign
     1512       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1513     .
     1514     if p-change-value = 0
     1515     then do:
     1516       run diasize_position-resize-button in this-procedure .
     1517       return .
     1518     end.
     1519     move_block:
     1520     do
     1521     on error undo move_block, retry move_block
     1522     :
     1523       if retry
     1524       then do:
     1525         do
     1526         on error undo move_block, leave move_block
     1527         :
     1528           if p-change-value > 0
     1529           then do:
     1530             for each buf_temp-diasize-handle
     1531             on error undo, next
     1532             :
     1533               assign
     1534                 v-object-handle = buf_temp-diasize-handle.handle-value
     1535               .
     1536               if v-object-handle <> v-diasize-resize-button
     1537               then do:
     1538                 assign
     1539                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1540                 .
     1541               end.
     1542             end.
     1543             assign
     1544               v-diasize-browse-handle :height = v-browse-height
     1545             .
     1546             for each buf_temp-browse-handle
     1547               where buf_temp-browse-handle.browse-type = 'height':u
     1548             on error undo, next
     1549             :
     1550               assign
     1551                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1552               .
     1553             end.
     1554             assign
     1555               frame Dialog-Frame :height = v-frame-height
     1556             .
     1557             if frame Dialog-Frame :scrollable = true
     1558             then do:
     1559               assign
     1560                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1561               .
     1562             end.
     1563             run diasize_position-resize-button in this-procedure .
     1564           end.
     1565           else do:
     1566             if frame Dialog-Frame :scrollable = true
     1567             then do:
     1568               assign
     1569                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1570               .
     1571             end.
     1572             assign
     1573               frame Dialog-Frame :height = v-frame-height
     1574             .
     1575             assign
     1576               v-diasize-browse-handle :height = v-browse-height
     1577             .
     1578             for each buf_temp-browse-handle
     1579               where buf_temp-browse-handle.browse-type = 'height':u
     1580             on error undo, next
     1581             :
     1582               assign
     1583                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1584               .
     1585             end.
     1586             for each buf_temp-diasize-handle
     1587             on error undo, next
     1588             :
     1589               assign
     1590                 v-object-handle = buf_temp-diasize-handle.handle-value
     1591               .
     1592               if v-object-handle <> v-diasize-resize-button
     1593               then do:
     1594                 assign
     1595                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1596                 .
     1597               end.
     1598             end.
     1599             run diasize_position-resize-button in this-procedure .
     1600           end.
     1601           assign
     1602             v-diasize-change-size = false
     1603           .
     1604           leave move_block .
     1605         end.
     1606       end.
     1607       assign
     1608         v-diasize-need-full-display = true
     1609       .
     1610       if v-diasize-change-size = false
     1611       then do:
     1612         assign
     1613           v-diasize-change-size = true
     1614         .
     1615       end.
     1616       else do:
     1617         return .
     1618       end.
     1619       assign
     1620         v-frame-height = frame Dialog-Frame :height
     1621         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1622         v-browse-height = v-diasize-browse-handle :height
     1623       .
     1624       for each buf_temp-browse-handle
     1625         where buf_temp-browse-handle.browse-type = 'height':u
     1626       :
     1627         assign
     1628           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1629         .
     1630       end.
     1631       for each buf_temp-diasize-handle
     1632       :
     1633         delete buf_temp-diasize-handle .
     1634       end.
     1635       assign
     1636         v-field-group-handle = frame Dialog-Frame :first-child
     1637       .
     1638       do while valid-handle(v-field-group-handle)
     1639       :
     1640         assign
     1641           v-object-handle = v-field-group-handle :first-child
     1642         .
     1643         do while valid-handle(v-object-handle)
     1644         :
     1645           if  v-object-handle <> v-diasize-browse-handle :handle
     1646           and can-query(v-object-handle, "row")
     1647           and can-query(v-object-handle, "height")
     1648           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1649           then do:
     1650             find first buf_temp-browse-handle
     1651               where buf_temp-browse-handle.browse-type   = 'height':u
     1652                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1653               no-error .
     1654             if available buf_temp-browse-handle
     1655             then do:
     1656             end.
     1657             else do:
     1658               create buf_temp-diasize-handle .
     1659               assign
     1660                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1661                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1662               .
     1663             end.
     1664           end.
     1665           assign
     1666             v-object-handle = v-object-handle :next-sibling
     1667           .
     1668         end.
     1669         assign
     1670           v-field-group-handle = v-field-group-handle :next-sibling
     1671         .
     1672       end.
     1673       do with frame Dialog-Frame
     1674       :
     1675         hide v-diasize-resize-button .
     1676         assign
     1677           v-diasize-resize-button :row    = 1
     1678           v-diasize-resize-button :column = 1
     1679         .
     1680       end.
     1681       if p-change-value > 0
     1682       then do:
     1683         if frame Dialog-Frame :scrollable = true
     1684         then do:
     1685           assign
     1686             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1687             no-error .
     1688           if error-status :error
     1689           or error-status :get-message(1) <> ""
     1690           then do:
     1691             undo move_block, retry move_block .
     1692           end.
     1693         end.
     1694         assign
     1695           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1696           no-error .
     1697         if error-status :error
     1698         or error-status :get-message(1) <> ""
     1699         then do:
     1700           undo move_block, retry move_block .
     1701         end.
     1702         assign
     1703           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1704           no-error .
     1705         if error-status :error
     1706         or error-status :get-message(1) <> ""
     1707         then do:
     1708           undo move_block, retry move_block .
     1709         end.
     1710         for each buf_temp-browse-handle
     1711           where buf_temp-browse-handle.browse-type = 'height':u
     1712         on error undo move_block, retry move_block
     1713         :
     1714           assign
     1715             buf_temp-browse-handle.browse-handle :height
     1716               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1717             no-error .
     1718           if error-status :error
     1719           or error-status :get-message(1) <> ""
     1720           then do:
     1721             undo move_block, retry move_block .
     1722           end.
     1723         end.
     1724         for each buf_temp-diasize-handle
     1725         on error undo move_block, retry move_block
     1726         :
     1727           assign
     1728             v-object-handle = buf_temp-diasize-handle.handle-value
     1729           .
     1730           if v-object-handle <> v-diasize-resize-button
     1731           then do:
     1732             assign
     1733               v-object-handle :row = v-object-handle :row + p-change-value
     1734               no-error .
     1735             if error-status :error
     1736             or error-status :get-message(1) <> ""
     1737             then do:
     1738               undo move_block, retry move_block .
     1739             end.
     1740           end.
     1741         end.
     1742       end.
     1743       else do:
     1744         for each buf_temp-diasize-handle
     1745         on error undo move_block, retry move_block
     1746         :
     1747           assign
     1748             v-object-handle = buf_temp-diasize-handle.handle-value
     1749           .
     1750           if v-object-handle <> v-diasize-resize-button
     1751           then do:
     1752             assign
     1753               v-object-handle :row = v-object-handle :row + p-change-value
     1754               no-error .
     1755             if error-status :error
     1756             or error-status :get-message(1) <> ""
     1757             then do:
     1758               undo move_block, retry move_block .
     1759             end.
     1760           end.
     1761         end.
     1762         assign
     1763           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1764           no-error .
     1765         if error-status :error
     1766         or error-status :get-message(1) <> ""
     1767         then do:
     1768           undo move_block, retry move_block .
     1769         end.
     1770         for each buf_temp-browse-handle
     1771           where buf_temp-browse-handle.browse-type = 'height':u
     1772         on error undo move_block, retry move_block
     1773         :
     1774           assign
     1775             buf_temp-browse-handle.browse-handle :height
     1776               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1777             no-error .
     1778           if error-status :error
     1779           or error-status :get-message(1) <> ""
     1780           then do:
     1781             undo move_block, retry move_block .
     1782           end.
     1783         end.
     1784         assign
     1785           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1786           no-error .
     1787         if error-status :error
     1788         or error-status :get-message(1) <> ""
     1789         then do:
     1790           undo move_block, retry move_block .
     1791         end.
     1792         if frame Dialog-Frame :scrollable = true
     1793         then do:
     1794           assign
     1795             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1796             no-error .
     1797           if error-status :error
     1798           or error-status :get-message(1) <> ""
     1799           then do:
     1800             undo move_block, retry move_block .
     1801           end.
     1802         end.
     1803       end.
     1804       if p-move-resize = true
     1805       then do:
     1806         run diasize_position-resize-button in this-procedure .
     1807       end.
     1808       if v-diasize-wndstore = true
     1809       then do:
     1810         if connected("ub") = true
     1811         then do:
     1812           define variable v-cntxt-db-num        as integer   no-undo .
     1813           define variable v-cntxt-userid        as character no-undo .
     1814           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1815                                             , OUTPUT v-cntxt-userid
     1816                                             ) .
     1817           run gbl/wndsizew.p
     1818             (input  v-cntxt-db-num
     1819             ,input  v-cntxt-userid
     1820             ,input  v-diasize-proc-name
     1821             ,input  'height':u
     1822             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1823             ) .
     1824         end.
     1825       end.
     1826     end.
     1827     assign
     1828       v-diasize-change-size = false
     1829     .
     1830   end procedure.
     1831   procedure diasize_set-height :
     1832     define input  parameter p-new-height  as decimal   no-undo .
     1833     define input  parameter p-move-resize as logical   no-undo .
     1834     do
     1835     on error undo, return error return-value
     1836     :
     1837       run diasize_change-height in this-procedure
     1838         (input  (p-new-height - frame Dialog-Frame :height)
     1839         ,input  p-move-resize
     1840         ) .
     1841     end.
     1842   end procedure.
     1843   procedure diasize_change-width :
     1844     define input  parameter p-change-value as decimal   no-undo .
     1845     define input  parameter p-move-resize  as logical   no-undo .
     1846     define variable v-field-group-handle   as handle    no-undo .
     1847     define variable v-object-handle        as handle    no-undo .
     1848     define variable v-frame-width          as decimal   no-undo .
     1849     define variable v-frame-virtual-width  as decimal   no-undo .
     1850     define variable v-browse-width         as decimal   no-undo .
     1851     define variable v-window-width         as decimal   no-undo .
     1852     define variable v-window-virtual-width as decimal   no-undo .
     1853     define variable v-change-sign          as integer   no-undo .
     1854     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1855     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1856     if p-change-value > 0
     1857     then do:
     1858       if frame Dialog-Frame :width + p-change-value >
     1859           session :width-chars
     1860       then do:
     1861         assign
     1862           p-change-value = session :width-chars - frame Dialog-Frame :width
     1863         .
     1864         if p-change-value <= 0
     1865         then do:
     1866           run diasize_position-resize-button in this-procedure .
     1867           return .
     1868         end.
     1869       end.
     1870     end.
     1871     if p-change-value < 0
     1872     then do:
     1873       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1874       then do:
     1875         assign
     1876           p-change-value = v-diasize-orig-frame-width
     1877                          - frame Dialog-Frame :width
     1878         .
     1879         if p-change-value >= 0
     1880         then do:
     1881           run diasize_position-resize-button in this-procedure .
     1882           return .
     1883         end.
     1884       end.
     1885     end.
     1886     if p-change-value >= 0
     1887     then do:
     1888       assign
     1889         v-change-sign = 1
     1890       .
     1891     end.
     1892     else do:
     1893       assign
     1894         v-change-sign = -1
     1895       .
     1896     end.
     1897     assign
     1898       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1899     .
     1900     if p-change-value = 0
     1901     then do:
     1902       run diasize_position-resize-button in this-procedure .
     1903       return .
     1904     end.
     1905     move_block:
     1906     do
     1907     on error undo move_block, leave move_block
     1908     :
     1909       if retry
     1910       then do:
     1911         do
     1912         on error undo move_block, leave move_block
     1913         :
     1914           if p-change-value > 0
     1915           then do:
     1916             for each buf_temp-diasize-handle
     1917             on error undo, next
     1918             :
     1919               assign
     1920                 v-object-handle = buf_temp-diasize-handle.handle-value
     1921               .
     1922               if v-object-handle <> v-diasize-resize-button
     1923               then do:
     1924                 assign
     1925                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1926                 .
     1927               end.
     1928             end.
     1929             assign
     1930               v-diasize-browse-handle :width = v-browse-width
     1931             .
     1932             for each buf_temp-browse-handle
     1933               where buf_temp-browse-handle.browse-type = 'width':u
     1934             on error undo, next
     1935             :
     1936               assign
     1937                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1938               .
     1939             end.
     1940             assign
     1941               frame Dialog-Frame :width = v-frame-width
     1942             .
     1943             if frame Dialog-Frame :scrollable = true
     1944             then do:
     1945               assign
     1946                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1947               .
     1948             end.
     1949             run diasize_position-resize-button in this-procedure .
     1950           end.
     1951           else do:
     1952             if frame Dialog-Frame :scrollable = true
     1953             then do:
     1954               assign
     1955                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1956               .
     1957             end.
     1958             assign
     1959               frame Dialog-Frame :width = v-frame-width
     1960             .
     1961             for each buf_temp-browse-handle
     1962               where buf_temp-browse-handle.browse-type = 'width':u
     1963             on error undo, next
     1964             :
     1965               assign
     1966                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1967               .
     1968             end.
     1969             assign
     1970               v-diasize-browse-handle :width = v-browse-width
     1971             .
     1972             for each buf_temp-diasize-handle
     1973             on error undo, next
     1974             :
     1975               assign
     1976                 v-object-handle = buf_temp-diasize-handle.handle-value
     1977               .
     1978               if v-object-handle <> v-diasize-resize-button
     1979               then do:
     1980                 assign
     1981                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1982                 .
     1983               end.
     1984             end.
     1985             run diasize_position-resize-button in this-procedure .
     1986           end.
     1987           assign
     1988             v-diasize-change-size = false
     1989           .
     1990           leave move_block .
     1991         end.
     1992       end.
     1993       assign
     1994         v-diasize-need-full-display = true
     1995       .
     1996       if v-diasize-change-size = false
     1997       then do:
     1998         assign
     1999           v-diasize-change-size = true
     2000         .
     2001       end.
     2002       else do:
     2003         return .
     2004       end.
     2005       assign
     2006         v-frame-width = frame Dialog-Frame :width
     2007         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2008         v-browse-width = v-diasize-browse-handle :width
     2009       .
     2010       for each buf_temp-browse-handle
     2011         where buf_temp-browse-handle.browse-type = 'width':u
     2012       :
     2013         assign
     2014           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2015         .
     2016       end.
     2017       for each buf_temp-diasize-handle
     2018       :
     2019         delete buf_temp-diasize-handle .
     2020       end.
     2021       assign
     2022         v-field-group-handle = frame Dialog-Frame :first-child
     2023       .
     2024       do while valid-handle(v-field-group-handle)
     2025       :
     2026         assign
     2027           v-object-handle = v-field-group-handle :first-child
     2028         .
     2029         do while valid-handle(v-object-handle)
     2030         :
     2031           if  v-object-handle <> v-diasize-browse-handle :handle
     2032           and v-object-handle <> v-diasize-resize-button
     2033           and can-query(v-object-handle, "row")
     2034           and can-query(v-object-handle, "height")
     2035           and ( v-object-handle :col + v-object-handle :width
     2036                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2037               )
     2038           then do:
     2039             find first buf_temp-browse-handle
     2040               where buf_temp-browse-handle.browse-type   = 'width':u
     2041                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2042               no-error .
     2043             if available buf_temp-browse-handle
     2044             then do:
     2045             end.
     2046             else do:
     2047               create buf_temp-diasize-handle .
     2048               assign
     2049                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2050                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2051               .
     2052             end.
     2053           end.
     2054           assign
     2055             v-object-handle = v-object-handle :next-sibling
     2056           .
     2057         end.
     2058         assign
     2059           v-field-group-handle = v-field-group-handle :next-sibling
     2060         .
     2061       end.
     2062       do with frame Dialog-Frame
     2063       :
     2064         hide v-diasize-resize-button .
     2065         v-diasize-resize-button :row = 1.
     2066         v-diasize-resize-button :column = 1.
     2067       end.
     2068       if p-change-value > 0
     2069       then do:
     2070         if frame Dialog-Frame :scrollable = true
     2071         then do:
     2072           assign
     2073             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2074             no-error .
     2075           if error-status :error
     2076           or error-status :get-message(1) <> ""
     2077           then do:
     2078             undo move_block, retry move_block.
     2079           end.
     2080         end.
     2081         assign
     2082           frame Dialog-Frame :width = v-frame-width + p-change-value
     2083           no-error .
     2084         if error-status :error
     2085         or error-status :get-message(1) <> ""
     2086         then do:
     2087           undo move_block, retry move_block.
     2088         end.
     2089         assign
     2090           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2091         no-error .
     2092         if error-status :error
     2093         or error-status :get-message(1) <> ""
     2094         then do:
     2095           undo move_block, retry move_block.
     2096         end.
     2097         for each buf_temp-browse-handle
     2098           where buf_temp-browse-handle.browse-type = 'width':u
     2099         on error undo move_block, retry move_block
     2100         :
     2101           assign
     2102             buf_temp-browse-handle.browse-handle :width
     2103               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2104             no-error .
     2105           if error-status :error
     2106           or error-status :get-message(1) <> ""
     2107           then do:
     2108             undo move_block, retry move_block .
     2109           end.
     2110         end.
     2111         for each buf_temp-diasize-handle
     2112         on error undo move_block, retry move_block
     2113         :
     2114           assign
     2115             v-object-handle = buf_temp-diasize-handle.handle-value
     2116           .
     2117           if v-object-handle <> v-diasize-resize-button
     2118           then do:
     2119             assign
     2120               v-object-handle :col = v-object-handle :col + p-change-value
     2121               no-error .
     2122             if error-status :error
     2123             or error-status :get-message(1) <> ""
     2124             then do:
     2125               undo move_block, retry move_block .
     2126             end.
     2127           end.
     2128         end.
     2129       end.
     2130       else do:
     2131         for each buf_temp-diasize-handle
     2132         on error undo move_block, retry move_block
     2133         :
     2134           assign
     2135             v-object-handle = buf_temp-diasize-handle.handle-value
     2136           .
     2137           if v-object-handle <> v-diasize-resize-button
     2138           then do:
     2139             assign
     2140               v-object-handle :col = v-object-handle :col + p-change-value
     2141               no-error .
     2142             if error-status :error
     2143             or error-status :get-message(1) <> ""
     2144             then do:
     2145               undo move_block, retry move_block .
     2146             end.
     2147           end.
     2148         end.
     2149         for each buf_temp-browse-handle
     2150           where buf_temp-browse-handle.browse-type = 'width':u
     2151         on error undo move_block, retry move_block
     2152         :
     2153           assign
     2154             buf_temp-browse-handle.browse-handle :width
     2155               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2156             no-error .
     2157           if error-status :error
     2158           or error-status :get-message(1) <> ""
     2159           then do:
     2160             undo move_block, retry move_block .
     2161           end.
     2162         end.
     2163         assign
     2164           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2165           no-error .
     2166         if error-status :error
     2167         or error-status :get-message(1) <> ""
     2168         then do:
     2169           undo move_block, retry move_block.
     2170         end.
     2171         assign
     2172           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2173         no-error .
     2174         if error-status :error
     2175         or error-status :get-message(1) <> ""
     2176         then do:
     2177           undo move_block, retry move_block.
     2178         end.
     2179         if frame Dialog-Frame :scrollable = true
     2180         then do:
     2181           assign
     2182             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2183           no-error .
     2184           if error-status :error
     2185           or error-status :get-message(1) <> ""
     2186           then do:
