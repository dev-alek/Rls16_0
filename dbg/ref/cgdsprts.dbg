        1   DEFINE BUFFER buf_cli FOR ub.clients.
        2   DEFINE BUFFER for-c-gds-prt FOR ub.c-gds-prt.
        3   DEFINE BUFFER X_c-gds-prt FOR ub.c-gds-prt.
        4   define input parameter parparentproc as widget-handle no-undo .
        5   DEFINE INPUT PARAMETER bttns  as character  no-undo .
        6   DEFINE INPUT PARAMETER p-mode as character no-undo.
        7   DEFINE INPUT PARAMETER p-node-code like ub.c-gds-prt.node-code no-undo.
        8   define input parameter p-is-del    as logical no-undo .
        9   DEFINE OUTPUT PARAMETER  p-rid-list    as  char no-undo .
       10   define variable vss-revision    as character no-undo init "$Revision$":u .
       11   define variable vss-author      as character no-undo init "$Author$":u .
       12   define variable vss-date        as character no-undo init "$Date$":u .
       13   define variable vss-workfile    as character no-undo init "$Workfile$":u .
       14   define variable vss-archive     as character no-undo init "$Archive$":u .
       15   define variable vss-description as character no-undo init "Справочник истории шкал" .
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   procedure proc-alt-shift-f2:
       77     if not ibs.th.gbl.gbl-var:rcode
       78   then
       79     run gbl\inidebug.p .
       80   end.
       81   procedure proc-alt-shift-f3:
       82     run gbl/prvssinf.p
       83       ( input this-procedure
       84       ) .
       85   end.
       86   define variable v-inform-launched as logical no-undo initial false .
       87   procedure proc-alt-shift-f4:
       88     define variable v-action as character no-undo .
       89     if v-inform-launched = false then do:
       90       assign
       91         v-inform-launched = true
       92       .
       93       run gbl/d-inform.w
       94         (  input self
       95         ,  input this-procedure
       96         , output v-action
       97         ) no-error .
       98       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       99       assign
      100         v-inform-launched = false
      101       .
      102     end.
      103   end.
      104   procedure proc-alt-f1:
      105     run gbl/corrhelp.p
      106       (input this-procedure
      107       ) .
      108   end .
      109   on alt-shift-f2 anywhere do:
      110     run proc-alt-shift-f2.
      111   end.
      112   on alt-shift-f3 anywhere do:
      113     run proc-alt-shift-f3 in this-procedure .
      114   end.
      115   on alt-shift-f4 anywhere do:
      116     run proc-alt-shift-f4 in this-procedure.
      117   end.
      118   on alt-f1 anywhere do:
      119     run proc-alt-f1 in this-procedure .
      120   end.
      121   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      122   procedure cur-time :
      123      define output parameter p-today as date      no-undo .
      124      define output parameter p-time  as integer   no-undo .
      125     do
      126     on error undo, return error
      127     :
      128       define variable v-date1 as date      no-undo .
      129       define variable v-date2 as date      no-undo .
      130       define variable v-time  as integer   no-undo .
      131       assign
      132         v-date1 = today
      133         v-time  = time
      134         v-date2 = today
      135       .
      136       if v-date1 <> v-date2
      137       then do:
      138         assign
      139           v-date1 = today
      140           v-time  = v-time
      141         .
      142       end.
      143       assign
      144         p-today = v-date1
      145         p-time  = v-time
      146       .
      147     end.
      148   end.
      149   function cur-time-date returns character
      150   :
      151     return string(today, '99/99/9999':U) .
      152   end.
      153   function cur-time-mjd returns decimal
      154   :
      155     define variable v-date as date      no-undo .
      156     define variable v-time as integer   no-undo .
      157     run cur-time in this-procedure
      158       (output v-date
      159       ,output v-time
      160       ) .
      161     return integer(v-date) - 2400002 + (v-time / 86400) .
      162   end.
      163   function cur-time-get-ending-index returns integer
      164   (input p-number as integer
      165   )
      166   :
      167     if p-number < 0
      168     or p-number = ?
      169     then do:
      170       return 1 .
      171     end.
      172     define variable v-rest as integer   no-undo .
      173     assign
      174       p-number = p-number modulo 100
      175     .
      176     if p-number < 20
      177     then do:
      178       assign
      179         v-rest = p-number
      180       .
      181     end.
      182     else do:
      183       assign
      184         v-rest = p-number modulo 10
      185       .
      186     end.
      187     case v-rest :
      188       when 1
      189       then do:
      190         return 2 .
      191       end.
      192       when 2 or
      193       when 3 or
      194       when 4
      195       then do:
      196         return 3 .
      197       end.
      198       otherwise do:
      199         return 1 .
      200       end.
      201     end case .
      202   end.
      203   procedure cur-time-mjd-to-date :
      204      define input  parameter i-mjd-diff as decimal no-undo.
      205      define output parameter o-Date     as date    no-undo.
      206      define output parameter o-Time     as integer no-undo.
      207      define variable v-day-number as integer   no-undo .
      208      if    i-mjd-diff < 0
      209         or i-mjd-diff = ?
      210      then do:
      211         return "?" .
      212      end.
      213      assign
      214         v-day-number = truncate(i-mjd-diff,0).
      215         o-Date = date(v-day-number + 2400002).
      216         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      217     .
      218   end.
      219   function cur-time-mjd-to-string returns character
      220   (input p-mjd-diff as decimal
      221   )
      222   :
      223     define variable v-day-number as integer   no-undo .
      224     define variable v-seconds    as integer   no-undo .
      225     define variable v-hour       as integer   no-undo .
      226     define variable v-min        as integer   no-undo .
      227     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      228     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      229     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      230     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      231     if p-mjd-diff < 0
      232     or p-mjd-diff = ?
      233     then do:
      234       return "?" .
      235     end.
      236     assign
      237       v-day-number = integer(truncate(p-mjd-diff,0))
      238       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      239     .
      240     if v-seconds > 86400
      241     then do:
      242       assign
      243         v-seconds = 86400 - 1
      244       .
      245     end.
      246     if v-seconds < 0
      247     then do:
      248       assign
      249         v-seconds = 0
      250       .
      251     end.
      252     assign
      253       v-hour = truncate(v-seconds / 3600, 0)
      254     .
      255     assign
      256       v-seconds = v-seconds modulo 3600
      257     .
      258     assign
      259       v-min = truncate(v-seconds / 60, 0)
      260     .
      261     assign
      262       v-seconds = v-seconds modulo 60
      263     .
      264     return
      265         (if v-day-number <> 0
      266           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      267           else ""
      268         )
      269       + (if v-day-number <> 0 or v-hour <> 0
      270           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      271           else ""
      272         )
      273       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      274           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      275           else ""
      276         )
      277       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      278       .
      279   end.
      280   function cur-time-string returns character
      281   :
      282     define variable v-date as date      no-undo .
      283     define variable v-time as integer   no-undo .
      284     run cur-time in this-procedure
      285       (output v-date
      286       ,output v-time
      287       ) .
      288     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      289   end.
      290   function cur-time-string-sec returns character
      291   :
      292     define variable v-date as date      no-undo .
      293     define variable v-time as integer   no-undo .
      294     run cur-time in this-procedure
      295       (output v-date
      296       ,output v-time
      297       ) .
      298     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      299   end.
      300   function cur-time-custom  returns character
      301   (input p-prefix as character
      302   ,input p-date-format as character
      303   ,input p-delimiter as character
      304   ,input p-time-format as character
      305   ,input p-suffix as character
      306   )
      307   :
      308     define variable v-date as date      no-undo .
      309     define variable v-time as integer   no-undo .
      310     run cur-time in this-procedure
      311       (output v-date
      312       ,output v-time
      313       ) .
      314     return
      315       p-prefix
      316       + string(v-date, p-date-format)
      317       + p-delimiter
      318       + string(v-time, p-time-format)
      319       + p-suffix
      320       .
      321   end.
      322   function cur-time-print  returns character
      323   :
      324     define variable v-date as date      no-undo .
      325     define variable v-time as integer   no-undo .
      326     run cur-time in this-procedure
      327       (output v-date
      328       ,output v-time
      329       ) .
      330     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      331   end.
      332   function cur-time-datetime returns datetime
      333   :
      334     define variable v-char as character no-undo .
      335     define variable v-datetime as datetime no-undo .
      336     v-char = cur-time-string().
      337     v-datetime = datetime(v-char).
      338     return  v-datetime.
      339   end.
      340   function cur-time-string-msec returns character
      341   :
      342     define variable v-date as datetime  no-undo .
      343     v-date = now.
      344     return string(v-date) .
      345   end.
      346   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      347   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      348   define new shared variable RepPathName        as character no-undo .
      349   define new shared variable PrintRubl          as logical   no-undo .
      350   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      351   define variable c-point  as character no-undo .
      352   define variable tbl      as character no-undo .
      353   define variable join-tbl as character no-undo .
      354   define variable fld      as character no-undo .
      355   define variable lab      as character no-undo .
      356   define variable spr      as character no-undo .
      357   define variable dim      as character no-undo .
      358   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      359   procedure fltfield-clear :
      360     define output parameter loc-fld as character no-undo.
      361     define output parameter loc-lab as character no-undo .
      362     define output parameter loc-spr as character no-undo .
      363     define output parameter loc-dim as character no-undo .
      364     assign
      365       loc-fld = ""
      366       loc-lab = ""
      367       loc-spr = ""
      368       loc-dim = "0"
      369     .
      370   end procedure .
      371   procedure fltfield-add :
      372     define input        parameter par-fld as character no-undo.
      373     define input        parameter par-lab as character no-undo .
      374     define input        parameter par-spr as character no-undo .
      375     define input-output parameter loc-fld as character no-undo.
      376     define input-output parameter loc-lab as character no-undo .
      377     define input-output parameter loc-spr as character no-undo .
      378     define input-output parameter loc-dim as character no-undo .
      379     do
      380     on error undo, return error
      381     :
      382       assign
      383       loc-fld = if loc-dim = '0'
      384                 then par-fld
      385                 else (loc-fld + chr(44) + par-fld)
      386       loc-lab = if loc-dim = '0'
      387                 then par-lab
      388                 else (loc-lab + chr(44) + par-lab)
      389       loc-spr = if loc-dim = '0'
      390                 then par-spr
      391                 else (loc-spr + chr(44) + par-spr)
      392       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      393                 string(integer(if num-entries(loc-dim) > 1
      394                               then entry(2, loc-dim)
      395                               else entry(1, loc-dim)
      396                               ) + 1)
      397       no-error
      398       .
      399     end.
      400   end procedure.
      401   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      402   define variable v-waitfram-action01         as character   no-undo .
      403   define variable v-waitfram-action02         as character   no-undo .
      404   define variable v-waitfram-action03         as character   no-undo .
      405   define variable mWaitFramTextBeg            as character   no-undo.
      406   define variable mWaitFramTextEnd            as character   no-undo.
      407   define variable mWaitFramView               as logical     no-undo.
      408   define variable mWaitProcEvent              as logical     no-undo init yes.
      409   define variable mWaitFramInterval           as integer     no-undo init 1 .
      410   define variable mWaitFramStop               as logical     no-undo.
      411   define variable mWaitFramStopUser           as logical     no-undo.
      412   define variable mWaitFramStopTimeOut        as logical     no-undo.
      413   define variable mWaitFramStartProc          as datetime-tz no-undo.
      414   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      415   define button B-WaitFramStop auto-end-key
      416        label "Стоп"
      417        size 10 by 1 tooltip "Остоновить процесс".
      418   define button B-viewProcInfo
      419        label "Информация"
      420        size 15 by 1 tooltip "Информация о процесс".
      421   define frame waitfram
      422     v-waitfram-action01 format "x(72)" no-label skip
      423     v-waitfram-action02 format "x(72)" no-label skip
      424     v-waitfram-action03 format "x(72)" no-label skip
      425     B-viewProcInfo
      426     B-WaitFramStop at row 4 col 30
      427     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      428     .
      429   define new global shared variable mBatchMode as logical no-undo init ?.
      430   define variable mFramBachModHandle as handle no-undo.
      431   mFramBachModHandle = frame waitfram:handle.
      432   define variable mFameOldVis as logical no-undo.
      433   define variable mVisCUrentVin as logical no-undo.
      434   if session:batch-mode
      435   then
      436      mBatchMode = yes.
      437   if mBatchMode = ? then do:
      438     mVisCUrentVin = current-window:visible.
      439     mFameOldVis = mFramBachModHandle:visible.
      440     mFramBachModHandle:visible  = yes.
      441     mBatchMode = mFramBachModHandle:visible ne yes.
      442     mFramBachModHandle:visible = mFameOldVis.
      443     current-window:visible = mVisCUrentVin.
      444   end.
      445    if  log-manager:logfile-name ne ?
      446     then DO:
      447         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      448         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      449         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      450     end.
      451   on choose of B-WaitFramStop in frame waitfram
      452   do:
      453     mWaitFramStop = yes.
      454     mWaitFramStopUser = yes.
      455   end.
      456   function waitfram-check-timeout returns logical():
      457      define variable vtime as int64 no-undo.
      458      if mWaitFramStopTimeOut
      459      then
      460         return yes.
      461      vtime = ( now - mWaitFramStartProc ) / 1000 .
      462      if     mWaitFramTimeOut ne ?
      463         and mWaitFramTimeOut ne 0
      464         and mWaitFramTimeOut lt vtime
      465      then do:
      466         mWaitFramStopTimeOut = yes.
      467      end.
      468      return mWaitFramStopTimeOut.
      469   end.
      470   procedure waitfram-hide :
      471     if not session:batch-mode
      472     then do
      473     on error undo, return error return-value
      474     :
      475       pause 0 before-hide .
      476       if not mBatchMode then
      477         hide frame waitfram .
      478     if     not mWaitFramView
      479        and mWaitProcEvent
      480     then
      481       process events .
      482     end.
      483   end procedure.
      484   procedure waitfram-show :
      485     define input  parameter p-message as character no-undo .
      486     define variable v-left-margin as integer   no-undo .
      487     if not session:batch-mode
      488     then do
      489     on error undo, return error return-value
      490     :
      491       if length(p-message) <= 70 then do:
      492         assign
      493           v-left-margin = integer((70 - length(p-message)) / 2)
      494         .
      495         assign
      496           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      497         .
      498         assign
      499           v-waitfram-action01 = " "
      500           v-waitfram-action02 = " "
      501                                    + fill(" ", v-left-margin)
      502                                    + p-message
      503           v-waitfram-action03 = " "
      504         .
      505       end.
      506       else do:
      507         define variable vRindex1 as integer no-undo.
      508         define variable vRindex2 as integer no-undo.
      509         vRindex1 = r-index(p-message," ",70).
      510         if vRindex1 = 0
      511         then
      512            vRindex1 = 70.
      513         if length(p-message)  <= vRindex1 + 70 then do:
      514           assign
      515             v-waitfram-action01 = " "
      516             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      517             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      518           .
      519         end.
      520         else do:
      521           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      522           if vRindex2 <= vRindex1
      523           then
      524              vRindex2 = vRindex1 + 70.
      525           assign
      526             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      527             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      528             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      529           .
      530         end.
      531       end.
      532       B-viewProcInfo:visible   in frame waitfram = no.
      533       B-viewProcInfo:sensitive in frame waitfram = no.
      534       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      535       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      536       if  (   mWaitFramView
      537          or  mWaitProcEvent)
      538          and not mBatchMode
      539       then
      540          display
      541             v-waitfram-action01 skip
      542             v-waitfram-action02 skip
      543             v-waitfram-action03 skip
      544          with frame waitfram .
      545       if     mWaitFramView
      546          then do:
      547             if     mWaitFramInterval ne ?
      548                and not mBatchMode
      549             then
      550                wait-for go of frame waitfram pause mWaitFramInterval.
      551          end.
      552          else
      553             if     mWaitProcEvent
      554                and not mBatchMode
      555             then
      556                process events .
      557     end.
      558   end procedure.
      559      procedure waitfram-show-this:
      560         define input  parameter iInterval as int64 no-undo.
      561         define variable vtime as int64 no-undo.
      562         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      563         mWaitFramInterval = iInterval.
      564         run waitfram-show (substitute("&1&2 &3&4" ,
      565                                       mWaitFramTextBeg ,
      566                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      567                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      568                                       mWaitFramTextEnd
      569                                      )
      570                           ).
      571      end.
      572      procedure WaitFramRunPause:
      573         define input  parameter iInterval as dec no-undo.
      574         define variable vStart  as datetime-tz no-undo.
      575         define variable vend    as datetime-tz no-undo.
      576         define variable vint as int64 no-undo.
      577         define variable vOk as logical no-undo.
      578         vStart = now.
      579         vend   = vStart.
      580         publish "WaitFramPause" (iInterval,output vOk).
      581         vend   =  now.
      582         vint = vend - vStart.
      583         vint = iInterval - vint / 1000.
      584         if     not mWaitFramStop
      585            and (   vint > 0
      586                 or (    not vOk
      587                     and iInterval eq ?
      588                     )
      589                 )
      590         then
      591            run waitfram-show-this (iInterval).
      592         vend   =  now.
      593         vint = vend - vStart.
      594         vint = iInterval - vint / 1000.
      595         if     not mWaitFramStop
      596            and vint > 0
      597         then do:
      598            run gbl/pause.p (vint * 1000).
      599         end.
      600         if iInterval ne ?
      601         then
      602            publish "WaitFramStop".
      603         waitfram-check-timeout().
      604      end.
      605      procedure WaitFramWaitFor:
      606         define input  parameter iInterval as dec no-undo.
      607         assign
      608            mWaitFramStartProc   = now
      609            mWaitFramStopUser    = no
      610            mWaitFramStopTimeOut = no
      611         .
      612         block-wait:
      613         do while not mWaitFramStop:
      614            run WaitFramRunPause (iInterval).
      615            if  waitfram-check-timeout()
      616            then do:
      617               leave block-wait.
      618            end.
      619         end.
      620         run waitfram-hide.
      621      end.
      622   procedure waitfram-join :
      623     define input  parameter p-line-1  as character no-undo .
      624     define input  parameter p-line-2  as character no-undo .
      625     define input  parameter p-line-3  as character no-undo .
      626     define output parameter p-message as character no-undo .
      627     do
      628     on error undo, return error return-value
      629     :
      630       assign
      631         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      632                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      633                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      634       .
      635     end.
      636   end procedure.
      637   function waitfram-join-function returns character
      638     (input p-line-1 as character
      639     ,input p-line-2 as character
      640     ,input p-line-3 as character
      641     ).
      642     define variable v-message as character no-undo .
      643     run waitfram-join in this-procedure
      644       (input  p-line-1
      645       ,input  p-line-2
      646       ,input  p-line-3
      647       ,output v-message
      648       ) .
      649     return v-message .
      650   end function .
      651   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      652   FUNCTION mark-string RETURNS CHARACTER
      653     ( input p-recid as recid, input mark-list as character  ) :
      654     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      655   END FUNCTION.
      656   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      657   function usrfulnf returns character ( input p-user-id as character):
      658   define variable v-user-name as character no-undo .
      659   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      660   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      661     (input  p-user-id
      662     ,output v-user-name
      663     ) no-error .
      664   if error-status:error
      665   or v-user-name = ""
      666   then do:
      667     return p-user-id.
      668   end.
      669   else do:
      670     return v-user-name.
      671   end.
      672   end function.
      673   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      674   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      675   procedure fltopend_fltopend :
      676   define input parameter p-parent-handle as handle no-undo .
      677   define input parameter p-qh as handle no-undo .
      678   define input parameter p-flt-open-open-query  as character no-undo .
      679   define input parameter p-where-cond as character no-undo .
      680   define input parameter p-use-indFIRST-query-tail as character no-undo .
      681   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      682   define input parameter p-indexed-reposition as character no-undo .
      683     do
      684     on error undo, return error
      685     :
      686   define variable v-prepare-string as character no-undo .
      687   define variable glog as logical no-undo .
      688   assign
      689   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      690                      p-where-cond + chr(32)  +
      691                      p-use-indFIRST-query-tail + chr(32) +
      692                      p-use-ind-sort-clmn-by + chr(32) +
      693                      p-indexed-reposition
      694   .
      695   assign
      696   glog = p-qh:query-prepare(v-prepare-string) no-error .
      697   if not glog
      698   or error-status:error then do:
      699     message error-status:get-message(1) view-as alert-box .
      700     undo, return error .
      701   end.
      702   assign
      703   glog = p-qh:query-open no-error .
      704   if not glog
      705   or error-status:error then do:
      706     message error-status:get-message(1) view-as alert-box .
      707     undo, return error .
      708   end.
      709     end.
      710   end procedure.
      711   procedure fltopend_fltfindd :
      712   define input parameter p-parent-handle as handle no-undo .
      713   define input parameter p-qh as handle no-undo .
      714   define input parameter p-rowid as rowid no-undo .
      715   define input parameter p-next as logical no-undo .
      716   define input parameter p-lock as integer no-undo .
      717   define input parameter p-bh as handle no-undo .
      718   define input parameter p-where-cond as character no-undo .
      719   define input parameter p-use-index-phrase as character no-undo .
      720   define variable glog as logical no-undo .
      721   define variable v-qh as handle no-undo .
      722   define variable v-bh as handle no-undo .
      723   define variable v-recid as recid no-undo .
      724   define variable v-prepare-string as character no-undo .
      725   do
      726   on error undo, return error
      727   on stop undo, return error
      728   :
      729     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      730     create buffer v-bh for table p-bh buffer-name p-bh:name.
      731     create query v-qh.
      732     v-qh:set-buffers(v-bh).
      733     v-prepare-string = substitute("for each &1 &2 &3"
      734                                     ,v-bh:name
      735                                     ,p-where-cond
      736                                     ,p-use-index-phrase).
      737     glog = v-qh:query-prepare(v-prepare-string) no-error.
      738     if not glog then do:
      739       delete object v-qh.
      740       delete object v-bh.
      741       undo, return error .
      742     end.
      743     glog = v-qh:query-open no-error .
      744     if not glog then do:
      745       delete object v-qh.
      746       delete object v-bh.
      747       undo, return error .
      748     end.
      749     if p-next then do:
      750       v-qh:reposition-to-rowid(p-rowid) no-error .
      751       glog = v-qh:get-next( p-lock) no-error .
      752       glog = v-qh:get-next( p-lock) no-error .
      753       if not glog or v-qh:query-off-end = yes then do:
      754         glog = v-qh:get-first( p-lock) no-error .
      755       end.
      756     end.
      757     else do:
      758       glog = v-qh:get-first( p-lock) no-error .
      759     end.
      760     v-recid = v-bh:recid no-error .
      761     delete object v-qh.
      762     delete object v-bh.
      763     return string(v-recid) .
      764   end.
      765   end procedure.
      766   procedure fltopend_fltfindq :
      767   define input parameter p-parent-handle as handle no-undo .
      768   define input parameter p-qh as handle no-undo .
      769   define input parameter p-next as logical no-undo .
      770   define input parameter p-lock as integer no-undo .
      771   define input parameter p-flt-open-open-query  as character no-undo .
      772   define input parameter p-where-cond as character no-undo .
      773   define input parameter p-use-indFIRST-query-tail as character no-undo .
      774   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      775   define input parameter p-indexed-reposition as character no-undo .
      776   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      777   define variable glog as logical no-undo .
      778   define variable v-qh as handle no-undo .
      779   define variable v-bh as handle no-undo extent 18.
      780   define variable v-rowid as rowid no-undo extent 18.
      781   define variable v-ii as integer no-undo .
      782   define variable v-prepare-string as character no-undo .
      783   do
      784   on error undo, return error
      785   on stop undo, return error
      786   :
      787     create query v-qh.
      788     do v-ii = 1 to p-qh:num-buffers:
      789       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      790       assign
      791       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      792       no-error.
      793       v-qh:add-buffer(v-bh[v-ii]).
      794     end.
      795     assign
      796     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      797                       p-where-cond + chr(32)  +
      798                       p-use-indFIRST-query-tail + chr(32) +
      799                       p-use-ind-sort-clmn-by + chr(32) +
      800                       p-indexed-reposition
      801     .
      802     glog = v-qh:query-prepare( v-prepare-string) no-error .
      803     if not glog then do:
      804       delete object v-qh.
      805       do v-ii = 1 to p-qh:num-buffers:
      806         delete object v-bh[v-ii].
      807       end.
      808       undo, return error .
      809     end.
      810     glog = v-qh:query-open no-error .
      811     if not glog then do:
      812       delete object v-qh.
      813       do v-ii = 1 to p-qh:num-buffers:
      814         delete object v-bh[v-ii].
      815       end.
      816       undo, return error .
      817     end.
      818     if p-next then do:
      819       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      820       glog = v-qh:get-next( p-lock) no-error .
      821       glog = v-qh:get-next( p-lock) no-error .
      822       if not glog or v-qh:query-off-end = yes then do:
      823         glog = v-qh:get-first( p-lock) no-error .
      824       end.
      825     end.
      826     else do:
      827       glog = v-qh:get-first( p-lock) no-error .
      828     end.
      829     do v-ii = 1 to p-qh:num-buffers:
      830       assign
      831       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      832       no-error.
      833     end.
      834     delete object v-qh.
      835     do v-ii = 1 to p-qh:num-buffers:
      836       delete object v-bh[v-ii].
      837     end.
      838   end.
      839   end procedure.
      840   define variable log-res as log no-undo.
      841   define variable rr as recid no-undo.
      842   define variable jj as integer no-undo .
      843   define variable str as char no-undo.
      844   define variable vartbl-name as char no-undo.
      845   define variable varact      as char no-undo.
      846   define variable filter-point0 as character no-undo init "cgdsprts":U .
      847   define variable filter-point as character no-undo .
      848   define variable filter-label0 as character no-undo init "История шкал":U .
      849   define variable filter-label as character no-undo init "История шкал":U .
      850   define variable sort-column-name as character no-undo .
      851   define variable v-doc-rec as recid no-undo .
      852   define variable v-rid-list as character no-undo .
      853   define buffer X_gds-prt for ub.gds-prt.
      854   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      855   define  temp-table temp-changes no-undo
      856   field f_name as character
      857   field l_name as character
      858   field v_old as character
      859   field v_new as character
      860   field t_name as character
      861   field num_ as integer
      862   field uniq-key-rec as character
      863   field action as integer
      864   field fNotChange as logical
