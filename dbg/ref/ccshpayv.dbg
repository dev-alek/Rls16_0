       88   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       89   define temp-table temp-drt-prop no-undo like ub.drt-prop.
       90   procedure disrules-fill-properties:
       91   define input  parameter p-templ-rl-root as integer   no-undo .
       92   define buffer buf_drt-prop for ub.drt-prop.
       93   define buffer buf_temp-drt-prop for temp-drt-prop.
       94   do
       95   on error undo, return error return-value
       96   :
       97     for each buf_temp-drt-prop:
       98       delete buf_temp-drt-prop.
       99     end.
      100     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
      101       create buf_temp-drt-prop.
      102       buffer-copy buf_drt-prop to buf_temp-drt-prop.
      103     end.
      104   end.
      105   end procedure.
      106   ~
      107   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      108   procedure discfgru-check :
      109   define input parameter p-table-name as character no-undo .
      110   define input parameter p-templ-rl-root as integer no-undo .
      111   define input parameter p-time-templ-rl-root as integer no-undo .
      112   define input parameter p-pos-type as character no-undo .
      113   define output parameter p-disnct-role as character no-undo .
      114   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      115     do
      116     on error undo, return error return-value
      117     :
      118       find first buf_dis-cfg-rule no-lock where
      119               buf_dis-cfg-rule.table-name = p-table-name
      120           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
      121           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
      122           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
      123       if not available buf_dis-cfg-rule
      124       or p-pos-type = "":U
      125       then do:
      126          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
      127                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
      128                                  , p-templ-rl-root
      129                                  , (if p-time-templ-rl-root = ?
      130                                     then '':U
      131                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
      132                                     )
      133                                  ).
      134       end.
      135       assign
      136       p-disnct-role = buf_dis-cfg-rule.discnt-role
      137       .
      138     end.
      139   end procedure.
      140   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      141   FUNCTION get-region RETURNS CHARACTER
      142     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      143     define variable par-region as character no-undo.
      144     if parhost-code = 0 and
      145          parobj-type = "":U and
      146          parobj-code = 0 then do:
      147          par-region = "Глобально".
      148          return par-region.
      149       end.
      150       if parobj-type = 'орг':U then do:
      151          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      152          return par-region.
      153       end.
      154       if parobj-type = 'регион':U
      155       then do:
      156          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      157          return par-region.
      158       end.
      159       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      160       return par-region.
      161   END FUNCTION.
      162   FUNCTION get-objregion RETURNS CHARACTER
      163     (  input parobj-type as character, input parobj-code as integer ) :
      164     define variable par-region as character no-undo.
      165     if  parobj-type = "":U and
      166         parobj-code = 0
      167     then do:
      168        par-region = "Глобально".
      169     end.
      170     else if parobj-type = 'орг':U
      171     then do:
      172        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      173     end.
      174     else if parobj-type = 'регион':U
      175     then do:
      176        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      177     end.
      178     else
      179        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      180     return par-region.
      181   END FUNCTION.
      182   procedure discpru-name :
      183   define buffer buf_dis-rule for ub.dis-rule.
      184   do
      185     on error undo, return error
      186     :
      187     define input  parameter p-templ-rl-root  as integer no-undo .
      188     define output parameter p-label          as character no-undo .
      189     find first buf_dis-rule no-lock where
      190               buf_dis-rule.rule-num = p-templ-rl-root no-error.
      191     if available buf_dis-rule then do:
      192       if buf_dis-rule.rule-num > 0 then
      193       p-label = buf_dis-rule.des.
      194     end.
      195     else do:
      196       p-label = substitute("Неизвестный шаблон правила скидки &1", p-templ-rl-root).
      197     end.
      198   end.
      199   end procedure.
      200   function discpru-get-disc-label returns character ( input p-templ-rl-root as integer):
      201   define variable v-rule-label as character no-undo .
      202   run discpru-name in this-procedure ( input p-templ-rl-root
      203                                        ,output v-rule-label) no-error.
      204   return v-rule-label.
      205   end function.
      206   function discpru-get-disc-role-label returns character ( input p-discnt-role as character):
      207   define variable v-rule-label as character no-undo .
      208   return entry (lookup (p-discnt-role, 'simple-pay,qnty-pay':u) + 1, ',' + 'Скидка при оплате,Скидка на количество при оплате':u).
      209   end function.
      210   procedure discpru-write :
      211     do
      212     on error undo, return error
      213     :
      214       define input parameter p-cdpay-code     like ub.dis-cp-rule.cdpay-code  no-undo .
      215       define input parameter p-curr-code      like ub.dis-cp-rule.curr-code  no-undo .
      216       define input parameter p-host-code      like ub.dis-cp-rule.host-code   no-undo .
      217       define input parameter p-obj-type       like ub.dis-cp-rule.obj-type   no-undo .
      218       define input parameter p-obj-code       like ub.dis-cp-rule.obj-code   no-undo .
      219       define input parameter p-pos-type       like ub.dis-cp-rule.pos-type   no-undo .
      220       define input parameter p-discnt-role    like ub.dis-cp-rule.discnt-role no-undo .
      221       define input parameter p-templ-rl-root  like ub.dis-cp-rule.templ-rl-root  no-undo .
      222       define input parameter p-time-templ-rl-root  like ub.dis-cp-rule.time-templ-rl-root  no-undo .
      223       define input parameter p-rule-num       like ub.dis-cp-rule.rule-num    no-undo .
      224       define input parameter p-nonunique      like ub.dis-cp-rule.nonunique   no-undo .
      225       define buffer buf_dis-rule for ub.dis-rule.
      226       define buffer buf_dis-cp-rule for ub.dis-cp-rule .
      227       define buffer lock_dis-cp-rule for ub.dis-cp-rule .
      228       define variable v-label          as character no-undo .
      229       define variable v-discnt-role as character no-undo .
      230       run discfgru-check in this-procedure (
      231                                             input 'dis-cp-rule':U
      232                                            ,input p-templ-rl-root
      233                                            ,input p-time-templ-rl-root
      234                                            ,input p-pos-type
      235                                            ,output v-discnt-role
      236                                             ) no-error .
      237       if error-status :error then do:
      238         undo, return error return-value .
      239       end.
      240       if p-discnt-role = ? then do:
      241         p-discnt-role = v-discnt-role.
      242       end.
      243       if p-discnt-role <> v-discnt-role then do:
      244         undo, return error substitute("Тип платежа &1 код валюты &2 фирма &3 &4 место использ. &5 скидка типа &6&7не может быть по шаблону &8 и расписанию &9"
      245                                 ,p-cdpay-code
      246                                 ,p-curr-code
      247                                 ,p-host-code
      248                                 ,(p-obj-type + string(p-obj-code))
      249                                 ,p-pos-type
      250                                 ,entry (lookup (p-discnt-role, 'simple-pay,qnty-pay':u) + 1, ',' + 'Скидка при оплате,Скидка на количество при оплате':u)
      251                                 ,chr(10)
      252                                 ,p-templ-rl-root
      253                                 ,p-rule-num).
      254       end.
      255       if p-pos-type = ? then do:
      256   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      257   define variable v-param-type4 as character no-undo .
      258   define variable v-value-date4 as date no-undo .
      259   define variable v-value-decimal4 as decimal no-undo .
      260   define variable v-value-integer4 as INTEGER no-undo .
      261   define variable v-value-logical4 AS LOGICAL no-undo .
      262   define variable v-tth4 as handle no-undo .
      263   run adm/shattri.p (
      264       input "get":U
      265       ,input  p-obj-type
      266       ,input  p-obj-code
      267       ,input  'cd-sending':U
      268       ,input  'dflt-cd':U
      269       ,output p-pos-type
      270       ,output v-value-date4
      271       ,output v-value-decimal4
      272       ,output v-value-integer4
      273       ,output v-value-logical4
      274       ,output v-param-type4
      275       ,INPUT-OUTPUT table-handle v-tth4
      276       )  .
      277   delete object v-tth4 no-error.
      278       end.
      279       find first buf_dis-rule no-lock where
      280                 buf_dis-rule.rule-num = p-rule-num no-error.
      281       if not available buf_Dis-rule then do:
      282         undo, return error substitute("Тип платежа &1 код валюты &2 фирма &3 &4 место использ. &5 скидка типа &6&7не найдено правило скидки &8"
      283                                 ,p-cdpay-code
      284                                 ,p-curr-code
      285                                 ,p-host-code
      286                                 ,(p-obj-type + string(p-obj-code))
      287                                 ,p-pos-type
      288                                 ,entry (lookup (p-discnt-role, 'simple-pay,qnty-pay':u) + 1, ',' + 'Скидка при оплате,Скидка на количество при оплате':u)
      289                                 ,chr(10)
      290                                 ,p-rule-num).
      291       end.
      292       if buf_dis-rule.root <> yes then do:
      293         undo, return error substitute("Тип платежа &1 код валюты &2 фирма &3 &4 место использ. &5 скидка типа &6&7правило скидки &8 - некорневое"
      294                                 ,p-cdpay-code
      295                                 ,p-curr-code
      296                                 ,p-host-code
      297                                 ,(p-obj-type + string(p-obj-code))
      298                                 ,p-pos-type
      299                                 ,entry (lookup (p-discnt-role, 'simple-pay,qnty-pay':u) + 1, ',' + 'Скидка при оплате,Скидка на количество при оплате':u)
      300                                 ,chr(10)
      301                                 ,p-rule-num).
      302       end.
      303       if not (p-obj-type = buf_dis-rule.obj-type
      304           and p-obj-code = buf_dis-rule.obj-code) then do:
      305         undo, return error (substitute("Тип платежа &1 код валюты &2 фирма &3 &4 место использ. &5 скидка типа &6&7правило скидки &8"
      306                                 ,p-cdpay-code
      307                                 ,p-curr-code
      308                                 ,p-host-code
      309                                 ,(p-obj-type + string(p-obj-code))
      310                                 ,p-pos-type
      311                                 ,entry (lookup (p-discnt-role, 'simple-pay,qnty-pay':u) + 1, ',' + 'Скидка при оплате,Скидка на количество при оплате':u)
      312                                 ,chr(10)
      313                                 ,p-rule-num)
      314                             +
      315                             substitute("Правило скидки &1 определено для &1&2" +
      316                                        "а привязка к ДК для &3"
      317                                        ,get-region( buf_Dis-rule.host-code, buf_dis-rule.obj-type, buf_Dis-rule.obj-code)
      318                                        ,chr(10)
      319                                        ,get-region( p-host-code, p-obj-type, p-obj-code)
      320                                        ))
      321                                 .
      322       end.
      323       find first buf_dis-cp-rule exclusive-lock where
      324                  buf_dis-cp-rule.cdpay-code  = p-cdpay-code
      325              AND buf_dis-cp-rule.curr-code  = p-curr-code
      326              AND buf_dis-cp-rule.obj-type  = p-obj-type
      327              AND buf_dis-cp-rule.host-code = p-host-code
      328              AND buf_dis-cp-rule.obj-code  = p-obj-code
      329              AND buf_dis-cp-rule.pos-type  = p-pos-type
      330              AND buf_dis-cp-rule.discnt-role = p-discnt-role
      331              and buf_dis-cp-rule.nonunique = p-nonunique
      332              no-error .
      333       if not available buf_dis-cp-rule then do:
      334         create buf_dis-cp-rule .
      335         assign
      336         buf_dis-cp-rule.cdpay-code  = p-cdpay-code
      337         buf_dis-cp-rule.curr-code  = p-curr-code
      338         buf_dis-cp-rule.host-code  = p-host-code
      339         buf_dis-cp-rule.obj-type  = p-obj-type
      340         buf_dis-cp-rule.obj-code  = p-obj-code
      341         buf_dis-cp-rule.pos-type = p-pos-type
      342         buf_dis-cp-rule.discnt-role = v-discnt-role
      343         buf_dis-cp-rule.rule-num = p-rule-num
      344         buf_dis-cp-rule.nonunique = p-nonunique
      345         no-error
      346         .
      347       end.
      348       ASSIGN
      349       buf_dis-cp-rule.rule-num = p-rule-num
      350       buf_dis-cp-rule.rl-root = buf_Dis-rule.rl-root
      351       buf_dis-cp-rule.templ-rl-root = p-templ-rl-root
      352       buf_dis-cp-rule.time-templ-rl-root = p-time-templ-rl-root
      353       buf_dis-cp-rule.nonunique = p-nonunique
      354       no-error.
      355     end.
      356   end procedure.
      357   procedure discpru-delete :
      358   define input parameter p-cdpay-code     like ub.dis-cp-rule.cdpay-code  no-undo .
      359   define input parameter p-curr-code      like ub.dis-cp-rule.curr-code  no-undo .
      360   define input parameter p-host-code      like ub.dis-cp-rule.host-code   no-undo .
      361   define input parameter p-obj-type       like ub.dis-cp-rule.obj-type   no-undo .
      362   define input parameter p-obj-code       like ub.dis-cp-rule.obj-code   no-undo .
      363   define input parameter p-pos-type       like ub.dis-cp-rule.pos-type   no-undo .
      364   define input parameter p-discnt-role    like ub.dis-cp-rule.discnt-role no-undo .
      365   define input parameter p-nonunique      like ub.dis-cp-rule.nonunique   no-undo .
      366   define output parameter p-deleted       as logical no-undo .
      367   define variable v-rule-label as character no-undo .
      368   define buffer buf_dis-cp-rule for ub.dis-cp-rule.
      369   do
      370   on error undo, return error
      371   :
      372   find first buf_dis-cp-rule exclusive-lock where
      373               buf_dis-cp-rule.cdpay-code  = p-cdpay-code
      374           AND buf_dis-cp-rule.curr-code  = p-curr-code
      375           AND buf_dis-cp-rule.obj-type  = p-obj-type
      376           AND buf_dis-cp-rule.host-code = p-host-code
      377           AND buf_dis-cp-rule.obj-code  = p-obj-code
      378           AND buf_dis-cp-rule.pos-type  = p-pos-type
      379           AND buf_dis-cp-rule.discnt-role = p-discnt-role
      380           and buf_dis-cp-rule.nonunique = p-nonunique
      381           no-error .
      382   if not available buf_dis-cp-rule then do:
      383     return '':U.
      384   end.
      385   delete buf_dis-cp-rule no-error.
      386   if error-status:error then do:
      387     run discpru-name in this-procedure
      388       (input  buf_dis-cp-rule.templ-rl-root
      389       ,output v-rule-label
      390       ) no-error .
      391     undo, return error substitute("Ошибка при удалении скидки по типу касс. платежа:&1" +
      392                                  "скидка &2 (POS &3) на фирме &4 &5&6 для платежа&1&7&1&8"
      393                                   ,chr(10)
      394                                   ,v-rule-label
      395                                   ,p-pos-type
      396                                   ,p-host-code
      397                                   ,p-obj-type
      398                                   ,p-obj-code
      399                                   ,error-status:get-message(1)
      400                                   ,return-value ).
      401   end.
      402   p-deleted = yes.
      403   return '':U.
      404   end.
      405   end procedure.
      406   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      407   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      408   procedure cur-time :
      409      define output parameter p-today as date      no-undo .
      410      define output parameter p-time  as integer   no-undo .
      411     do
      412     on error undo, return error
      413     :
      414       define variable v-date1 as date      no-undo .
      415       define variable v-date2 as date      no-undo .
      416       define variable v-time  as integer   no-undo .
      417       assign
      418         v-date1 = today
      419         v-time  = time
      420         v-date2 = today
      421       .
      422       if v-date1 <> v-date2
      423       then do:
      424         assign
      425           v-date1 = today
      426           v-time  = v-time
      427         .
      428       end.
      429       assign
      430         p-today = v-date1
      431         p-time  = v-time
      432       .
      433     end.
      434   end.
      435   function cur-time-date returns character
      436   :
      437     return string(today, '99/99/9999':U) .
      438   end.
      439   function cur-time-mjd returns decimal
      440   :
      441     define variable v-date as date      no-undo .
      442     define variable v-time as integer   no-undo .
      443     run cur-time in this-procedure
      444       (output v-date
      445       ,output v-time
      446       ) .
      447     return integer(v-date) - 2400002 + (v-time / 86400) .
      448   end.
      449   function cur-time-get-ending-index returns integer
      450   (input p-number as integer
      451   )
      452   :
      453     if p-number < 0
      454     or p-number = ?
      455     then do:
      456       return 1 .
      457     end.
      458     define variable v-rest as integer   no-undo .
      459     assign
      460       p-number = p-number modulo 100
      461     .
      462     if p-number < 20
      463     then do:
      464       assign
      465         v-rest = p-number
      466       .
      467     end.
      468     else do:
      469       assign
      470         v-rest = p-number modulo 10
      471       .
      472     end.
      473     case v-rest :
      474       when 1
      475       then do:
      476         return 2 .
      477       end.
      478       when 2 or
      479       when 3 or
      480       when 4
      481       then do:
      482         return 3 .
      483       end.
      484       otherwise do:
      485         return 1 .
      486       end.
      487     end case .
      488   end.
      489   procedure cur-time-mjd-to-date :
      490      define input  parameter i-mjd-diff as decimal no-undo.
      491      define output parameter o-Date     as date    no-undo.
      492      define output parameter o-Time     as integer no-undo.
      493      define variable v-day-number as integer   no-undo .
      494      if    i-mjd-diff < 0
      495         or i-mjd-diff = ?
      496      then do:
      497         return "?" .
      498      end.
      499      assign
      500         v-day-number = truncate(i-mjd-diff,0).
      501         o-Date = date(v-day-number + 2400002).
      502         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      503     .
      504   end.
      505   function cur-time-mjd-to-string returns character
      506   (input p-mjd-diff as decimal
      507   )
      508   :
      509     define variable v-day-number as integer   no-undo .
      510     define variable v-seconds    as integer   no-undo .
      511     define variable v-hour       as integer   no-undo .
      512     define variable v-min        as integer   no-undo .
      513     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      514     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      515     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      516     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      517     if p-mjd-diff < 0
      518     or p-mjd-diff = ?
      519     then do:
      520       return "?" .
      521     end.
      522     assign
      523       v-day-number = integer(truncate(p-mjd-diff,0))
      524       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      525     .
      526     if v-seconds > 86400
      527     then do:
      528       assign
      529         v-seconds = 86400 - 1
      530       .
      531     end.
      532     if v-seconds < 0
      533     then do:
      534       assign
      535         v-seconds = 0
      536       .
      537     end.
      538     assign
      539       v-hour = truncate(v-seconds / 3600, 0)
      540     .
      541     assign
      542       v-seconds = v-seconds modulo 3600
      543     .
      544     assign
      545       v-min = truncate(v-seconds / 60, 0)
      546     .
      547     assign
      548       v-seconds = v-seconds modulo 60
      549     .
      550     return
      551         (if v-day-number <> 0
      552           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      553           else ""
      554         )
      555       + (if v-day-number <> 0 or v-hour <> 0
      556           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      557           else ""
      558         )
      559       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      560           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      561           else ""
      562         )
      563       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      564       .
      565   end.
      566   function cur-time-string returns character
      567   :
      568     define variable v-date as date      no-undo .
      569     define variable v-time as integer   no-undo .
      570     run cur-time in this-procedure
      571       (output v-date
      572       ,output v-time
      573       ) .
      574     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      575   end.
      576   function cur-time-string-sec returns character
      577   :
      578     define variable v-date as date      no-undo .
      579     define variable v-time as integer   no-undo .
      580     run cur-time in this-procedure
      581       (output v-date
      582       ,output v-time
      583       ) .
      584     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      585   end.
      586   function cur-time-custom  returns character
      587   (input p-prefix as character
      588   ,input p-date-format as character
      589   ,input p-delimiter as character
      590   ,input p-time-format as character
      591   ,input p-suffix as character
      592   )
      593   :
      594     define variable v-date as date      no-undo .
      595     define variable v-time as integer   no-undo .
      596     run cur-time in this-procedure
      597       (output v-date
      598       ,output v-time
      599       ) .
      600     return
      601       p-prefix
      602       + string(v-date, p-date-format)
      603       + p-delimiter
      604       + string(v-time, p-time-format)
      605       + p-suffix
      606       .
      607   end.
      608   function cur-time-print  returns character
      609   :
      610     define variable v-date as date      no-undo .
      611     define variable v-time as integer   no-undo .
      612     run cur-time in this-procedure
      613       (output v-date
      614       ,output v-time
      615       ) .
      616     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      617   end.
      618   function cur-time-datetime returns datetime
      619   :
      620     define variable v-char as character no-undo .
      621     define variable v-datetime as datetime no-undo .
      622     v-char = cur-time-string().
      623     v-datetime = datetime(v-char).
      624     return  v-datetime.
      625   end.
      626   function cur-time-string-msec returns character
      627   :
      628     define variable v-date as datetime  no-undo .
      629     v-date = now.
      630     return string(v-date) .
      631   end.
      632   procedure cp-attr-code :
      633     do
      634     on error undo, return error
      635     :
      636       define input  parameter p-code           as character no-undo .
      637       define output parameter p-type           as character no-undo .
      638       define output parameter p-format         as character no-undo .
      639       define output parameter p-label          as character no-undo .
      640       define output parameter p-range          as integer   no-undo .
      641       define output parameter p-user-can-edit  as logical   no-undo .
      642       define output parameter p-output-display as logical   no-undo .
      643       define output parameter p-other          as character no-undo .
      644       case p-code :
      645               when 'paycard-export-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для выгрузки в XML)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      646               when 'grp-code':U then do:     assign     p-label = "Группа платежа"     p-type = 'C':U      p-format = "X(45)"     p-label = "Группа платежа"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=grp-code':u      .   end.
      647               when 'is-use':U then do:     assign     p-label = "Используется"     p-type = 'C':U      p-format = "X(255)"     p-label = "Используется"     p-range = 4     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=is-use':u      .   end.
      648               when 'dop-doc':U then do:     assign     p-label = "Дополнительный документ"     p-type = 'C':U      p-format = "X(255)"     p-label = "Дополнительный документ"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=dop-doc':u      .   end.
      649               when 'paycard-all-prefix':U then do:     assign     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      650               when 'paycard-edit-prefix':U then do:     assign     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-type = 'C':U      p-format = "X(19)"     p-label = "Префиксы платежных карт, разрешенных для редактирования"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = 'spr=paycard-prefix':u      .   end.
      651               when 'form_km3':U then do:     assign     p-label = "Формировать КМ-3 по чекам возврата"     p-type = 'L':U      p-format = "+/-"     p-label = "Формировать КМ-3 по чекам возврата"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      652               when 'bal_malina':U then do:     assign     p-label = "Оплата баллами Малина"     p-type = 'L':U      p-format = "+/-"     p-label = "Оплата баллами Малина"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      653               when 'max_proc_sum':U then do:     assign     p-label = "Максимальный % порог от суммы"     p-type = 'D':U      p-format = ">>9.99"     p-label = "Максимальный % порог от суммы"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      654               when 'mask_card_kup':U then do:     assign     p-label = "Маска карты\купона"     p-type = 'C':U      p-format = "x(129)"     p-label = "Маска карты\купона"     p-range = 0     p-user-can-edit  = true     p-output-display = true     p-other = '':u      .   end.
      655         otherwise do:
      656           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code ).
      657         end.
      658       end.
      659     end.
      660   end procedure.
      661   procedure cp-attr-tooltip :
      662     do
      663     on error undo, return error
      664     :
      665       define input  parameter p-code    as character no-undo .
      666       define output parameter p-tooltip as character no-undo .
      667       define output parameter p-label   as character no-undo .
      668       case p-code :
      669               when 'paycard-export-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для выгрузки в XML)"     p-label = "Префиксы платежных карт (для выгрузки в XML)" .   end.
      670               when 'grp-code':U then do:     assign     p-tooltip = "Группа платежа"     p-label = "Группа платежа" .   end.
      671               when 'is-use':U then do:     assign     p-tooltip = "Используется"     p-label = "Используется" .   end.
      672               when 'dop-doc':U then do:     assign     p-tooltip = "Дополнительный документ"     p-label = "Дополнительный документ" .   end.
      673               when 'paycard-all-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт (для разбора чеков и т.д.)"     p-label = "Префиксы платежных карт (для разбора чеков и т.д.)" .   end.
      674               when 'paycard-edit-prefix':U then do:     assign     p-tooltip = "Префиксы платежных карт, разрешенных для редактировани"     p-label = "Префиксы платежных карт, разрешенных для редактирования" .   end.
      675               when 'form_km3':U then do:     assign     p-tooltip = "Формировать КМ-3 по чекам возврата"     p-label = "Формировать КМ-3 по чекам возврата" .   end.
      676               when 'bal_malina':U then do:     assign     p-tooltip = "Оплата баллами Малина"     p-label = "Оплата баллами Малина" .   end.
      677               when 'max_proc_sum':U then do:     assign     p-tooltip = "Максимальный % порог от суммы"     p-label = "Максимальный % порог от суммы" .   end.
      678               when 'mask_card_kup':U then do:     assign     p-tooltip = "Маска карты\купона"     p-label = "Маска карты\купона" .   end.
      679         otherwise do:
      680           undo, return error substitute("неизвестный атрибут типа кассового платежа &1", p-code) .
      681         end.
      682       end.
      683     end.
      684   end procedure.
      685   procedure cp-attr-value :
      686     do
      687     on error undo, return error
      688     :
      689       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      690       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      691       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      692       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      693       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      694       define input  parameter p-code        like ub.cash-pay-attr.attr-code      no-undo .
      695       define output parameter p-value       like ub.cash-pay-attr.attr-value    no-undo .
      696       define output parameter p-type        as character no-undo .
      697       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      698       define variable v-format         as character no-undo .
      699       define variable v-label          as character no-undo .
      700       define variable v-range          as integer   no-undo .
      701       define variable v-user-can-edit  as logical   no-undo .
      702       define variable v-output-display as logical   no-undo .
      703       define variable v-other          as character no-undo .
      704       run cp-attr-code in this-procedure
      705         (input  p-code
      706         ,output p-type
      707         ,output v-format
      708         ,output v-label
      709         ,output v-range
      710         ,output v-user-can-edit
      711         ,output v-output-display
      712         ,output v-other
      713         ) no-error .
      714       if error-status :error then do:
      715         undo, return error return-value .
      716       end.
      717       find first buf_cash-pay-attr no-lock
      718         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      719           and buf_cash-pay-attr.curr-code  = p-curr-code
      720           and buf_cash-pay-attr.host-code  = p-host-code
      721           and buf_cash-pay-attr.obj-type   = p-obj-type
      722           and buf_cash-pay-attr.obj-code   = p-obj-code
      723           and buf_cash-pay-attr.attr-code  = p-code
      724         no-error .
      725       if avail buf_cash-pay-attr then do:
      726         assign
      727           p-value =  buf_cash-pay-attr.attr-value
      728         .
      729       end.
      730       else do:
      731         assign
      732           p-value = if p-type = 'L':U then "no":U else ""
      733         .
      734       end.
      735     end.
      736   end procedure.
      737   procedure cp-attr-write :
      738     do
      739     on error undo, return error
      740     :
      741       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      742       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      743       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      744       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      745       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      746       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      747       define input parameter p-value    like ub.cash-pay-attr.attr-value no-undo .
      748       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      749       define buffer last_cash-pay-attr for ub.cash-pay-attr .
      750       define variable v-type           as character no-undo .
      751       define variable v-format         as character no-undo .
      752       define variable v-label          as character no-undo .
      753       define variable v-range          as integer   no-undo .
      754       define variable v-user-can-edit  as logical   no-undo .
      755       define variable v-output-display as logical   no-undo .
      756       define variable v-other          as character no-undo .
      757       run cp-attr-code in this-procedure
      758         (input  p-code
      759         ,output v-type
      760         ,output v-format
      761         ,output v-label
      762         ,output v-range
      763         ,output v-user-can-edit
      764         ,output v-output-display
      765         ,output v-other
      766         ) no-error .
      767       if error-status :error then do:
      768         undo, return error return-value .
      769       end.
      770       find first buf_cash-pay-attr exclusive-lock
      771         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      772           and buf_cash-pay-attr.curr-code  = p-curr-code
      773           and buf_cash-pay-attr.host-code  = p-host-code
      774           and buf_cash-pay-attr.obj-type   = p-obj-type
      775           and buf_cash-pay-attr.obj-code   = p-obj-code
      776           and buf_cash-pay-attr.attr-code = p-code
      777         no-error .
      778       if not available buf_cash-pay-attr then do:
      779         create buf_cash-pay-attr .
      780         assign
      781         buf_cash-pay-attr.cdpay-code = p-cdpay-code
      782         buf_cash-pay-attr.curr-code  = p-curr-code
      783         buf_cash-pay-attr.host-code  = p-host-code
      784         buf_cash-pay-attr.obj-type   = p-obj-type
      785         buf_cash-pay-attr.obj-code   = p-obj-code
      786         buf_cash-pay-attr.attr-code = p-code
      787         .
      788       end.
      789       assign
      790         buf_cash-pay-attr.attr-value = p-value
      791       .
      792       release buf_cash-pay-attr no-error .
      793       if error-status:error then do:
      794         undo, return error return-value .
      795       end.
      796     end.
      797   end procedure.
      798   procedure cp-attr-exist :
      799     do
      800     on error undo, return error
      801     :
      802       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      803       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      804       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      805       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      806       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      807       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      808       define output parameter p-exist   as logical  no-undo .
      809       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      810       define variable v-type           as character no-undo .
      811       define variable v-format         as character no-undo .
      812       define variable v-label          as character no-undo .
      813       define variable v-range          as integer   no-undo .
      814       define variable v-user-can-edit  as logical   no-undo .
      815       define variable v-output-display as logical   no-undo .
      816       define variable v-other          as character no-undo .
      817       run cp-attr-code in this-procedure
      818         (input  p-code
      819         ,output v-type
      820         ,output v-format
      821         ,output v-label
      822         ,output v-range
      823         ,output v-user-can-edit
      824         ,output v-output-display
      825         ,output v-other
      826         ) no-error .
      827       if error-status :error then do:
      828         undo, return error return-value .
      829       end.
      830       find first buf_cash-pay-attr exclusive-lock
      831         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      832           and buf_cash-pay-attr.curr-code  = p-curr-code
      833           and buf_cash-pay-attr.host-code  = p-host-code
      834           and buf_cash-pay-attr.obj-type   = p-obj-type
      835           and buf_cash-pay-attr.obj-code   = p-obj-code
      836           and buf_cash-pay-attr.attr-code = p-code
      837         no-error .
      838       if  available buf_cash-pay-attr then do:
      839         p-exist = yes.
      840       end.
      841     end.
      842   end procedure.
      843   procedure cp-attr-delete :
      844     do
      845     on error undo, return error
      846     :
      847       define input parameter p-cdpay-code   like ub.cash-pay-attr.cdpay-code     no-undo .
      848       define input parameter p-curr-code    like ub.cash-pay-attr.curr-code      no-undo .
      849       define input parameter p-host-code    like ub.cash-pay-attr.host-code      no-undo .
      850       define input parameter p-obj-type     like ub.cash-pay-attr.obj-type       no-undo .
      851       define input parameter p-obj-code     like ub.cash-pay-attr.obj-code       no-undo .
      852       define input parameter p-code     like ub.cash-pay-attr.attr-code  no-undo .
      853       define output parameter p-deleted  as logical no-undo.
      854       define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      855       define variable v-type           as character no-undo .
      856       define variable v-format         as character no-undo .
      857       define variable v-label          as character no-undo .
      858       define variable v-range          as integer   no-undo .
      859       define variable v-user-can-edit  as logical   no-undo .
      860       define variable v-output-display as logical   no-undo .
      861       define variable v-other          as character no-undo .
      862       run cp-attr-code in this-procedure
      863         (input  p-code
      864         ,output v-type
      865         ,output v-format
      866         ,output v-label
      867         ,output v-range
      868         ,output v-user-can-edit
      869         ,output v-output-display
      870         ,output v-other
      871         ) no-error .
      872       if error-status :error then do:
      873         undo, return error return-value .
      874       end.
      875       find first buf_cash-pay-attr exclusive-lock
      876         where buf_cash-pay-attr.cdpay-code = p-cdpay-code
      877           and buf_cash-pay-attr.curr-code  = p-curr-code
      878           and buf_cash-pay-attr.host-code  = p-host-code
      879           and buf_cash-pay-attr.obj-type   = p-obj-type
      880           and buf_cash-pay-attr.obj-code   = p-obj-code
      881           and buf_cash-pay-attr.attr-code = p-code
      882         no-error NO-WAIT.
      883       if not available buf_cash-pay-attr then do:
      884         p-deleted = no.
      885       end.
      886       else do:
      887         delete buf_cash-pay-attr no-error .
      888         if error-status:error then do:
      889           undo, return error return-value .
      890         end.
      891         p-deleted = yes.
      892       end.
      893     end.
      894   end procedure.
      895   procedure cp-attr-news :
      896     do
      897     on error undo, return error
      898     :
      899       define input  parameter p-code           as character no-undo .
      900       define output parameter p-news           as logical   no-undo .
      901       case p-code :
      902               when 'paycard-export-prefix':U then do:     assign     p-news = true.   end.
      903               when 'grp-code':U then do:     assign     p-news = true.   end.
      904               when 'is-use':U then do:     assign     p-news = true.   end.
      905               when 'dop-doc':U then do:     assign     p-news = true.   end.
      906               when 'paycard-all-prefix':U then do:     assign     p-news = true.   end.
      907               when 'paycard-edit-prefix':U then do:     assign     p-news = true.   end.
      908               when 'form_km3':U then do:     assign     p-news = false.   end.
      909               when 'bal_malina':U then do:     assign     p-news = false.   end.
      910               when 'max_proc_sum':U then do:     assign     p-news = true.   end.
      911               when 'mask_card_kup':U then do:     assign     p-news = true.   end.
      912         otherwise do:
      913           p-news = no.
      914         end.
      915       end.
      916     end.
      917   end procedure.
      918   procedure cp-attr-hist :
      919     do
      920     on error undo, return error
      921     :
      922       define input  parameter p-code           as character no-undo .
      923       define output parameter p-hist           as logical   no-undo .
      924       case p-code :
      925               when 'paycard-export-prefix':U then do:     assign     p-hist = true.   end.
      926               when 'paycard-all-prefix':U then do:     assign     p-hist = true.   end.
      927               when 'paycard-edit-prefix':U then do:     assign     p-hist = true.   end.
      928               when 'form_km3':U then do:     assign     p-hist = true.   end.
      929               when 'bal_malina':U then do:     assign     p-hist = true.   end.
      930               when 'max_proc_sum':U then do:     assign     p-hist = true.   end.
      931               when 'mask_card_kup':U then do:     assign     p-hist = true.   end.
      932         otherwise do:
      933           p-hist = no.
      934         end.
      935       end.
      936     end.
      937   end procedure.
      938   define variable v-chg-fields as character no-undo.
      939   define variable v-old-fields as character no-undo.
      940   define variable v-new-fields as character no-undo.
      941   define variable ii as integer no-undo.
      942   define variable v-mess as character no-undo .
      943   define buffer buf_c-cash-pay for ub.c-cash-pay.
      944   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      945   define SHARED temp-table temp-changes no-undo
      946   field f_name as character
      947   field l_name as character
      948   field v_old as character
      949   field v_new as character
      950   field t_name as character
      951   field num_ as integer
      952   field uniq-key-rec as character
      953   field action as integer
      954   field fNotChange as logical
      955   index pi is unique primary
      956   num_
      957   t_name
      958   f_name
      959   index
      960   Chan
      961   fnotChange
      962   t_name
      963   f_name
      964   index imain uniq-key-rec
      965   .
      966   FUNCTION get-all-fields returns character (p-file-name as character ):
      967   define variable v-dop as character no-undo .
      968     find first _file no-lock where _file._file-name = p-file-name no-error .
      969     if not available _file then return "":U.
      970     for each _field no-lock where
      971              _field._file-recid = recid(_file) :
      972       assign
      973       v-dop = v-dop + _field._field-name + chr(44)
      974       .
      975     end.
      976     return trim(v-dop).
      977   END FUNCTION.
      978   PROCEDURE proc-full-temp-changes :
      979     define input  parameter p-act-create as logical   no-undo .
      980     define input  parameter p-act-delete as logical   no-undo .
      981     define input  parameter p-hst-handle as handle    no-undo .
      982     define input  parameter p-main-table as character no-undo .
      983     define input  parameter p-field-list as character no-undo .
      984     define input  parameter p-label-form as character no-undo .
      985     define variable h-new-buf         as handle    no-undo .
      986     define variable h-main-buf        as handle    no-undo .
      987     define variable h-for-comp        as handle    no-undo .
      988     define variable v-inform          as character no-undo .
      989     define variable v-ind             as integer   no-undo .
      990     define variable v-idx-field-qnty  as integer   no-undo .
      991     define variable v-num-entries     as integer   no-undo .
      992     define variable fh                as handle    no-undo .
      993     define variable fh-main           as handle    no-undo .
      994     define variable fh-old            as handle    no-undo .
      995     define variable fh-new            as handle    no-undo .
      996     define variable v-field-name      as character no-undo .
      997     define variable v-field-lvl       as character no-undo .
      998     define variable v-field-form      as character no-undo .
      999     define variable v-search-exp      as character no-undo .
     1000     define variable v-srch-main       as character no-undo .
     1001     define variable v-word-link       as character no-undo .
     1002     define variable v-av-chip-num     as logical   no-undo .
     1003     define variable v-main-pi-fld-lst as character no-undo .
     1004     define variable v-main-fld-lst    as character no-undo .
     1005     define variable v-delim-list      as character no-undo .
     1006     define variable v-label           as character no-undo .
     1007     define variable v-old-value       as character no-undo case-sensitive.
     1008     define variable v-new-value       as character no-undo case-sensitive.
     1009     define variable v-chg-fields as character no-undo.
     1010     for each temp-changes:
     1011       delete temp-changes.
     1012     end.
     1013     if not p-hst-handle:available then do:
     1014       return .
     1015     end.
     1016     create buffer h-new-buf  for table p-hst-handle .
     1017     create buffer h-main-buf for table p-main-table .
     1018     assign
     1019       v-inform = h-main-buf:index-information(1)
     1020       v-ind    = 2
     1021     .
     1022     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1023     on error undo, return error
     1024     :
     1025       assign
     1026         v-inform = h-main-buf:index-information( v-ind )
     1027         v-ind    = v-ind + 1
     1028       .
     1029     end.
     1030     if v-inform = ?
     1031       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1032       or entry( 3, v-inform, ",":U ) <> "1":U
     1033     then do:
     1034       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1035     end.
     1036     assign
     1037       v-idx-field-qnty = num-entries( v-inform ) - 4
     1038     .
     1039     if v-idx-field-qnty < 2 then do:
     1040       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1041     end.
     1042     assign
     1043       v-srch-main   = "where":U
     1044       v-word-link   = "":U
     1045       v-av-chip-num = false
     1046       v-delim-list  = "":U
     1047     .
     1048     do v-ind = 1 to v-idx-field-qnty by 2
     1049     on error undo, return error
     1050     :
     1051       assign
     1052         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1053         fh                = p-hst-handle:buffer-field( v-field-name )
     1054         fh-main           = h-main-buf:buffer-field( v-field-name )
     1055         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1056         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1057       .
     1058       if fh:data-type ="character":U then do:
     1059         assign
     1060           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1061         .
     1062       end.
     1063       else do:
     1064         assign
     1065           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1066         .
     1067       end.
     1068       if v-delim-list = "":U then do:
     1069         assign
     1070           v-delim-list = ",":U
     1071         .
     1072       end.
     1073       if v-word-link = "":U then do:
     1074         assign
     1075           v-word-link = "and":U
     1076         .
     1077       end.
     1078     end.
     1079     assign
     1080       v-delim-list  = "":U
     1081     .
     1082     do v-ind = 1 to h-main-buf:num-fields
     1083     on error undo, return error
     1084     :
     1085       assign
     1086         fh-main      = h-main-buf:buffer-field( v-ind )
     1087         v-field-name = fh-main:name
     1088       .
     1089         assign
     1090           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1091         .
     1092         if v-delim-list = "":U then do:
     1093           assign
     1094             v-delim-list = ",":U
     1095           .
     1096         end.
     1097     end.
     1098     assign
     1099       v-inform = p-hst-handle:index-information(1)
     1100       v-ind    = 2
     1101     .
     1102     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1103     on error undo, return error
     1104     :
     1105       assign
     1106         v-inform = p-hst-handle:index-information( v-ind )
     1107         v-ind    = v-ind + 1
     1108       .
     1109     end.
     1110     if v-inform = ?
     1111       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1112       or entry( 3, v-inform, ",":U ) <> "1":U
     1113     then do:
     1114       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1115     end.
     1116     assign
     1117       v-idx-field-qnty = num-entries( v-inform ) - 4
     1118     .
     1119     if v-idx-field-qnty < 2 then do:
     1120       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1121     end.
     1122     assign
     1123       v-search-exp  = "where":U
     1124       v-word-link   = "":U
     1125       v-av-chip-num = false
     1126     .
     1127     do v-ind = 1 to v-idx-field-qnty by 2
     1128     on error undo, return error
     1129     :
     1130       assign
     1131         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1132         fh           = p-hst-handle:buffer-field( v-field-name )
     1133         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1134       .
     1135       if v-field-name = "chip-num":U then do:
     1136         assign
     1137           v-search-exp  = substitute( "&1 >", v-search-exp )
     1138           v-av-chip-num = true
     1139         .
     1140       end.
     1141       else do:
     1142         assign
     1143           v-search-exp = substitute( "&1 =", v-search-exp )
     1144         .
     1145       end.
     1146       if fh:data-type ="character":U then do:
     1147         assign
     1148           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1149         .
     1150       end.
     1151       else do:
     1152         assign
     1153           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1154         .
     1155       end.
     1156       if v-word-link = "":U then do:
     1157         assign
     1158           v-word-link = "and":U
     1159         .
     1160       end.
     1161     end.
     1162     if v-av-chip-num = false then do:
     1163       message
     1164         vss-workfile vss-revision vss-description skip
     1165         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1166         "Использование данной процедуры невозможно!" skip
     1167         view-as alert-box error .
     1168       return error .
     1169     end.
     1170     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1171     if not h-new-buf:available then do:
     1172       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1173       if not h-main-buf:available then do:
     1174         assign
     1175           h-for-comp = ?
     1176         .
     1177       end.
     1178       else do:
     1179         assign
     1180           h-for-comp = h-main-buf
     1181         .
     1182       end.
     1183     end.
     1184     else do:
     1185       assign
     1186         h-for-comp = h-new-buf
     1187       .
     1188     end.
     1189     assign
     1190       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1191     .
     1192     do v-ind = 1 to v-num-entries
     1193     on error undo, return error return-value
     1194     :
     1195       assign
     1196         v-field-name = entry( v-ind, v-main-fld-lst )
     1197         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1198         v-old-value  = fh-old:buffer-value()
     1199         v-label      = trim( fh-old:label )
     1200       .
     1201       if ( trim( p-field-list ) <> "":U
     1202            and lookup( v-field-name, p-field-list ) > 0
     1203          )
     1204          or trim( p-field-list ) = "":U
     1205       then do:
     1206         if h-for-comp <> ? then do:
     1207           assign
     1208             fh-new      = h-for-comp:buffer-field( v-field-name )
     1209             v-new-value = fh-new:buffer-value()
     1210           .
     1211         end.
     1212         else do:
     1213           assign
     1214             v-new-value = "":U
     1215           .
     1216         end.
     1217           if p-act-create = true then do:
     1218             assign
     1219               v-old-value = "":U
     1220             .
     1221           end.
     1222           if p-act-delete = true then do:
     1223             assign
     1224               v-new-value = "":U
     1225             .
     1226           end.
     1227         if v-old-value <> v-new-value
     1228         then do:
     1229           create temp-changes.
     1230           assign
     1231             temp-changes.t_name = p-main-table
     1232             temp-changes.f_name = v-field-name
     1233             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1234             temp-changes.v_old  = trim( v-old-value )
     1235             temp-changes.v_new  = trim( v-new-value )
     1236             temp-changes.num_   = 0
     1237             temp-changes.fNotChange = v-old-value eq v-new-value
     1238           .
     1239         end.
     1240       end.
     1241     end.
     1242     assign
     1243       v-num-entries = num-entries( p-label-form, chr(8) )
     1244     .
     1245     do v-ind = 1 to v-num-entries
     1246     on error undo, return error return-value
     1247     :
     1248       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1249         assign
     1250           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1251           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1252           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1253         .
     1254         find first temp-changes
     1255           where temp-changes.f_name = v-field-name
     1256           no-error .
     1257         if available temp-changes then do:
     1258           if trim( v-field-lvl ) <> "":U then do:
     1259             assign
     1260               temp-changes.l_name = v-field-lvl
     1261             .
     1262           end.
     1263           if trim( v-field-form ) <> "":U then do:
     1264             assign
     1265               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1266             .
     1267             if h-for-comp <> ? then do:
     1268               assign
     1269                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1270               .
     1271             end.
     1272           end.
     1273         end.
     1274       end.
     1275       else do:
     1276         message
     1277           vss-workfile vss-revision vss-description skip
     1278           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1279           substitute( "список для поля '&1': '&2'"
     1280                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1281                       ,entry( v-ind, p-label-form, chr(8) )
     1282                     ) skip
     1283           substitute( "полный список: &2", p-label-form ) skip
     1284           view-as alert-box error .
     1285       end.
     1286     end.
     1287     delete object h-new-buf .
     1288     delete object h-main-buf .
     1289   END PROCEDURE.
     1290   if p-action = integer('99':U) then return.
     1291   find first buf_c-cash-pay no-lock where
     1292             buf_c-cash-pay.cdpay-code   = p-cdpay-code
     1293         AND buf_c-cash-pay.curr-code = p-curr-code
     1294         AND buf_c-cash-pay.corr-user-db-num = p-corr-user-db-num
     1295         AND buf_c-cash-pay.chip-num = p-chip-num
     1296         AND buf_c-cash-pay.subject  = p-subject no-error .
     1297   if not available buf_c-cash-pay then do:
     1298     return error .
     1299   end.
     1300   CASE p-subject:
     1301     when 'cash-pay':U or when "":U then do:
     1302       run cash-pay-proc in this-procedure(output p-description) no-error .
     1303     end.
     1304     when 'cash-pay-attr':U then do:
     1305       run cash-pay-attr-proc in this-procedure(output p-description) no-error .
     1306     end.
     1307     when 'dis-cp-rule':U then do:
     1308       run dis-cp-rule-proc in this-procedure(output p-description) no-error .
     1309     end.
     1310   END CASE.
     1311   if error-status:error then do:
     1312     return error .
     1313   end.
     1314   procedure cash-pay-proc :
     1315   define output parameter p-description as character no-undo .
     1316   define buffer current_c-cash-pay for ub.c-cash-pay  .
     1317     do
     1318     on error undo, return error
     1319     :
     1320       find first current_c-cash-pay no-lock where
     1321                  current_c-cash-pay.cdpay-code   = p-cdpay-code
     1322              AND current_c-cash-pay.curr-code = p-curr-code
     1323              AND current_c-cash-pay.corr-user-db-num = p-corr-user-db-num
     1324              AND current_c-cash-pay.chip-num = p-chip-num
     1325              no-error .
     1326       if not avail current_c-cash-pay then do:
     1327          v-mess = "Неверная ссылка на c-cash-pay в таблице c-cash-pay".
     1328          run err-mess in this-procedure ( input-output v-mess).
     1329          return error.
     1330       end.
     1331   define variable v-label-param as character no-undo .
     1332   v-label-param =
     1333     "atr1" + chr(4) + "Разрешается сдача на платеж" + chr(4) + "" + chr(8)
     1334    + "atr128" + chr(4) + "Smart карта" + chr(4) + "" + chr(8)
     1335    + "atr16" + chr(4) + "Необходима on-line авторизаци" + chr(4) + "" + chr(8)
     1336    + "atr2" + chr(4) + "Разрешается перевод оплаты на платеж" + chr(4) + "" + chr(8)
     1337    + "atr32" + chr(4) + "Обязателен ввод PIN-кода" + chr(4) + "" + chr(8)
     1338    + "atr4" + chr(4) + "Принудительная печать слипа по платежу" + chr(4) + "" + chr(8)
     1339    + "atr64" + chr(4) + "Топливный платеж" + chr(4) + "" + chr(8)
     1340    + "atr8" + chr(4) + "Принудительная печать фактуры по платежу" + chr(4) + "" + chr(8)
     1341    + "cdpay-code" + chr(4) + "Код" + chr(4) + "" + chr(8)
     1342    + "curr-code" + chr(4) + "Код валюты" + chr(4) + "" + chr(8)
     1343    + "is-advance" + chr(4) + "Учет авансового платежа" + chr(4) + "" + chr(8)
     1344    + "is-all-pay" + chr(4) + "<Общий> платеж" + chr(4) + "" + chr(8)
     1345    + "is-bar-read" + chr(4) + "Сканер бар-кодов" + chr(4) + "" + chr(8)
     1346    + "is-card-swap" + chr(4) + "<Прокатывать> карту" + chr(4) + "" + chr(8)
     1347    + "is-cash" + chr(4) + "Наличные" + chr(4) + "" + chr(8)
     1348    + "is-credit" + chr(4) + "Кредит" + chr(4) + "" + chr(8)
     1349    + "is-credit-card" + chr(4) + "Кред.карта" + chr(4) + "" + chr(8)
     1350    + "is-debet-card" + chr(4) + "Расчетн.карта" + chr(4) + "" + chr(8)
     1351    + "is-goods-pay" + chr(4) + "Платеж за товары" + chr(4) + "" + chr(8)
     1352    + "is-service-pay" + chr(4) + "Сервисный платеж" + chr(4) + "" + chr(8)
     1353    + "obj-name" + chr(4) + "Название" + chr(4) + "" + chr(8)
     1354    + "pay-card-view" + chr(4) + "Виден N плат.карты" + chr(4) + "" + chr(8)
     1355    + "pay-code" + chr(4) + "Оплата" + chr(4) + "" + chr(8)
     1356    + "pay-limit" + chr(4) + "Предел без авторизации" + chr(4) + "" + chr(8)
     1357    + "rule-file-name" + chr(4) + "Файл правила обработки" + chr(4) + "" + chr(8)
     1358    + "slip-file-name" + chr(4) + "Файл слипа" + chr(4) + "" + chr(8)
     1359    + "status_" + chr(4) + "Статус" + chr(4) + "" + chr(8)
     1360    + "wth-code" + chr(4) + "Код МЦ" + chr(4) + "" + chr(8)
     1361    + "register" + chr(4) + "Ведомость" + chr(4) + ""  +  chr(8)
     1362    + "is-kbo" + chr(4) + "КБО" + chr(4) + "" +  chr(8)
     1363    + "can-mix" + chr(4) + "Разрешена смеш.оплата" + chr(4) + ""
     1364    .
     1365    run proc-full-temp-changes in this-procedure (
     1366                                                input  (buf_c-cash-pay.action = integer('1':U))
     1367                                               ,input  (buf_c-cash-pay.action = integer('99':U))
     1368                                               ,input  buffer current_c-cash-pay:handle
     1369                                               ,input  'cash-pay':U
     1370                                               ,input  "atr1,atr128,atr16,atr2,atr32," + "atr4,atr64,atr8,cdpay-code,curr-code,is-advance," + "is-all-pay,is-bar-read,is-card-swap,is-cash,is-credit,is-credit-card,is-debet-card,is-goods-pay,is-service-pay," + "obj-name,pay-card-view,pay-code,pay-limit,rule-file-name,slip-file-name,status_,wth-code,register"
     1371                                               ,input  v-label-param).
     1372   end.
     1373   end procedure.
     1374   procedure cash-pay-attr-proc :
     1375   define output parameter p-description as character no-undo .
     1376   define variable v-tooltip as character no-undo .
     1377   define variable v-label as character no-undo .
     1378   define buffer current_c-cash-pay-attr for ub.c-cash-pay-attr  .
     1379     do
     1380     on error undo, return error
     1381     :
     1382       find first current_c-cash-pay-attr no-lock where
     1383                  current_c-cash-pay-attr.cdpay-code   = p-cdpay-code
     1384              AND current_c-cash-pay-attr.curr-code = p-curr-code
     1385              AND current_c-cash-pay-attr.chip-num = p-chip-num
     1386              AND current_c-cash-pay-attr.corr-user-db-num = p-corr-user-db-num
     1387              AND current_c-cash-pay-attr.attr-code  = buf_c-cash-pay.attr-code
     1388              no-error .
     1389       if not avail current_c-cash-pay-attr then do:
     1390          v-mess = "Неверная ссылка на c-cash-pay-attr в таблице c-cash-pay".
     1391          run err-mess in this-procedure ( input-output v-mess).
     1392          return error.
     1393       end.
     1394       run cp-attr-tooltip in this-procedure (
     1395                   input  current_c-cash-pay-attr.attr-code
     1396                   ,output v-tooltip
     1397                   ,output v-label
     1398                   ) no-error .
     1399       assign
     1400       p-description = "Атрибут" + chr(32) + v-label
     1401       .
     1402   define variable v-label-param as character no-undo .
     1403   v-label-param =
     1404     "cdpay-code" + chr(4) + "Код" + chr(4) + "" + chr(8)
     1405    + "curr-code" + chr(4) + "Код валюты" + chr(4) + "" + chr(8)
     1406    + "attr-code" + chr(4) + "Атрибут" + chr(4) + "" + chr(8)
     1407    + "obj-type" + chr(4) + "Тип объекта" + chr(4) + "" + chr(8)
     1408    + "obj-code" + chr(4) + "Код объекта" + chr(4) + "" + chr(8)
     1409    + "host-code" + chr(4) + "Код фирмы" + chr(4) + "" + chr(8)
     1410    + "attr-value" + chr(4) + "Значение атрибута" + chr(4) + ""  .
     1411    run proc-full-temp-changes in this-procedure (
     1412                                                input  (buf_c-cash-pay.action = integer('1':U))
     1413                                               ,input  (buf_c-cash-pay.action = integer('99':U))
     1414                                               ,input  buffer current_c-cash-pay-attr:handle
     1415                                               ,input  'cash-pay-attr':U
     1416                                               ,input  "cdpay-code,curr-code,attr-code,obj-type,obj-code,host-code,attr-value"
     1417                                               ,input  v-label-param).
     1418   end.
     1419   end procedure.
     1420   procedure dis-cp-rule-proc :
     1421   define output parameter p-description as character no-undo .
     1422   define variable v-label as character no-undo .
     1423   define buffer current_c-dis-cp-rule for ub.c-dis-cp-rule  .
     1424   do
     1425   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1426   :
     1427       find first current_c-dis-cp-rule no-lock where
     1428                  current_c-dis-cp-rule.cdpay-code = p-cdpay-code
     1429              AND current_c-dis-cp-rule.curr-code = p-curr-code
     1430              AND current_c-dis-cp-rule.chip-num = p-chip-num
     1431              AND current_c-dis-cp-rule.corr-user-db-num = p-corr-user-db-num    no-error .
     1432       run discpru-name in this-procedure (
     1433                   input  current_c-dis-cp-rule.templ-rl-root
     1434                   ,output v-label
     1435                   ) no-error .
     1436       assign
     1437       p-description = substitute("Тип скидки &1", v-label)
     1438       .
     1439   define variable v-label-param as character no-undo .
     1440   v-label-param =
     1441     "rule-num" + chr(4) + "Номер правила скидки" + chr(4) + "" + chr(8)
     1442    + "pos-type" + chr(4) + "Тип POS" + chr(4) + "" + chr(8)
     1443    + "templ-rl-root" + chr(4) + "Шаблон скидки" + chr(4) + "discpru-get-disc-label" + chr(8)
     1444    + "discnt-role" + chr(4) + "Тип скидки" + chr(4) + "discpru-get-disc-role-label" + chr(8)
     1445    + "host-code" + chr(4) + "Фирма" + chr(4) + "" + chr(8)
     1446    + "obj-type" + chr(4) + "Тип объекта" + chr(4) + "" + chr(8)
     1447    + "obj-code" + chr(4) + "Код объекта" + chr(4) + ""  .
     1448    run proc-full-temp-changes in this-procedure (
     1449                                                input  (buf_c-cash-pay.action = integer('1':U))
     1450                                               ,input  (buf_c-cash-pay.action = integer('99':U))
     1451                                               ,input  buffer current_c-dis-cp-rule:handle
     1452                                               ,input  'dis-cp-rule':U
     1453                                               ,input  "rule-num,pos-type,templ-rl-root,discnt-role,host-code,obj-type,obj-code"
     1454                                               ,input  v-label-param).
     1455   end.
     1456   end procedure.
     1457   PROCEDURE err-mess:
     1458     DEFINE INPUT-output PARAMETER p-mess as character No-UNDO.
     1459     CASE p-silent:
     1460       when yes then do:
     1461         p-mess =
     1462         substitute("История касс. платежа  код платежа &1 код валюты &2 : щепка &3 Предмет изменений &4&5&6"
     1463                    ,p-cdpay-code
     1464                    ,p-curr-code
     1465                    ,p-chip-num
     1466                    ,p-subject
     1467                    , chr(10)
     1468                    , p-mess
     1469                    ).
     1470       end.
     1471       otherwise do:
     1472         message
     1473         p-mess
     1474         view-as alert-box error .
     1475       end.
     1476     end.
     1477   END PROCEDURE.
