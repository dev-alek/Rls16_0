        1   block-level on error undo, throw.
        2   define input parameter  p-cdpay-code            like  ub.c-cash-pay.cdpay-code         no-undo .
        3   define input parameter  p-curr-code             like  ub.c-cash-pay.curr-code          no-undo .
        4   define input parameter  p-attr-code             like  ub.c-cash-pay.attr-code          no-undo .
        5   define input parameter  p-corr-user-db-num      like  ub.c-cash-pay.corr-user-db-num   no-undo .
        6   define input parameter  p-chip-num              like  ub.c-cash-pay.chip-num           no-undo .
        7   define input parameter  p-subject               like  ub.c-cash-pay.subject            no-undo .
        8   define input parameter p-action   like ub.c-cash-pay.action no-undo .
        9   define input parameter p-silent  as logical no-undo .
       10   define input parameter p-log-file as character no-undo .
       11   define output parameter p-description as character no-undo .
       12   define variable vss-revision    as character no-undo init "$Revision: 99feb687c1d2, 89, rls $":U .
       13   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
       14   define variable vss-date        as character no-undo init "$Date: Thu Oct 30 18:56:09 2014 +0300 $":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile: ccshpayv.p $":U .
       16   define variable vss-archive     as character no-undo init "$Archive: ref/ccshpayv.p $":U .
       17   define variable vss-description as character no-undo init "Заполнение временной таблицы для показа изменений по таблицам истории касс платежей".
       18   procedure vss-get-info :
