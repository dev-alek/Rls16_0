        1   block-level on error undo, throw.
        2   define parameter buffer bf-dis-time-rule for ub.dis-time-rule.
        3   define input parameter p-silent as logical no-undo .
        4   define input-output parameter par-sts like ub.dis-time-rule.sts no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: dis-tim2.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: ref/dis-tim2.p $":U .
       10   define variable vss-description as character no-undo init "Изменение статуса расписаний".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       81   define variable v-waitfram-action01         as character   no-undo .
       82   define variable v-waitfram-action02         as character   no-undo .
       83   define variable v-waitfram-action03         as character   no-undo .
       84   define variable mWaitFramTextBeg            as character   no-undo.
       85   define variable mWaitFramTextEnd            as character   no-undo.
       86   define variable mWaitFramView               as logical     no-undo.
       87   define variable mWaitProcEvent              as logical     no-undo init yes.
       88   define variable mWaitFramInterval           as integer     no-undo init 1 .
       89   define variable mWaitFramStop               as logical     no-undo.
       90   define variable mWaitFramStopUser           as logical     no-undo.
       91   define variable mWaitFramStopTimeOut        as logical     no-undo.
       92   define variable mWaitFramStartProc          as datetime-tz no-undo.
       93   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       94   define button B-WaitFramStop auto-end-key
       95        label "Стоп"
       96        size 10 by 1 tooltip "Остоновить процесс".
       97   define button B-viewProcInfo
       98        label "Информация"
       99        size 15 by 1 tooltip "Информация о процесс".
      100   define frame waitfram
      101     v-waitfram-action01 format "x(72)" no-label skip
      102     v-waitfram-action02 format "x(72)" no-label skip
      103     v-waitfram-action03 format "x(72)" no-label skip
      104     B-viewProcInfo
      105     B-WaitFramStop at row 4 col 30
      106     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      107     .
      108   define new global shared variable mBatchMode as logical no-undo init ?.
      109   define variable mFramBachModHandle as handle no-undo.
      110   mFramBachModHandle = frame waitfram:handle.
      111   define variable mFameOldVis as logical no-undo.
      112   define variable mVisCUrentVin as logical no-undo.
      113   if session:batch-mode
      114   then
      115      mBatchMode = yes.
      116   if mBatchMode = ? then do:
      117     mVisCUrentVin = current-window:visible.
      118     mFameOldVis = mFramBachModHandle:visible.
      119     mFramBachModHandle:visible  = yes.
      120     mBatchMode = mFramBachModHandle:visible ne yes.
      121     mFramBachModHandle:visible = mFameOldVis.
      122     current-window:visible = mVisCUrentVin.
      123   end.
      124    if  log-manager:logfile-name ne ?
      125     then DO:
      126         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      127         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      128         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      129     end.
      130   on choose of B-WaitFramStop in frame waitfram
      131   do:
      132     mWaitFramStop = yes.
      133     mWaitFramStopUser = yes.
      134   end.
      135   function waitfram-check-timeout returns logical():
      136      define variable vtime as int64 no-undo.
      137      if mWaitFramStopTimeOut
      138      then
      139         return yes.
      140      vtime = ( now - mWaitFramStartProc ) / 1000 .
      141      if     mWaitFramTimeOut ne ?
      142         and mWaitFramTimeOut ne 0
      143         and mWaitFramTimeOut lt vtime
      144      then do:
      145         mWaitFramStopTimeOut = yes.
      146      end.
      147      return mWaitFramStopTimeOut.
      148   end.
      149   procedure waitfram-hide :
      150     if not session:batch-mode
      151     then do
      152     on error undo, return error return-value
      153     :
      154       pause 0 before-hide .
      155       if not mBatchMode then
      156         hide frame waitfram .
      157     if     not mWaitFramView
      158        and mWaitProcEvent
      159     then
      160       process events .
      161     end.
      162   end procedure.
      163   procedure waitfram-show :
      164     define input  parameter p-message as character no-undo .
      165     define variable v-left-margin as integer   no-undo .
      166     if not session:batch-mode
      167     then do
      168     on error undo, return error return-value
      169     :
      170       if length(p-message) <= 70 then do:
      171         assign
      172           v-left-margin = integer((70 - length(p-message)) / 2)
      173         .
      174         assign
      175           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      176         .
      177         assign
      178           v-waitfram-action01 = " "
      179           v-waitfram-action02 = " "
      180                                    + fill(" ", v-left-margin)
      181                                    + p-message
      182           v-waitfram-action03 = " "
      183         .
      184       end.
      185       else do:
      186         define variable vRindex1 as integer no-undo.
      187         define variable vRindex2 as integer no-undo.
      188         vRindex1 = r-index(p-message," ",70).
      189         if vRindex1 = 0
      190         then
      191            vRindex1 = 70.
      192         if length(p-message)  <= vRindex1 + 70 then do:
      193           assign
      194             v-waitfram-action01 = " "
      195             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      196             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      197           .
      198         end.
      199         else do:
      200           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      201           if vRindex2 <= vRindex1
      202           then
      203              vRindex2 = vRindex1 + 70.
      204           assign
      205             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      206             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      207             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      208           .
      209         end.
      210       end.
      211       B-viewProcInfo:visible   in frame waitfram = no.
      212       B-viewProcInfo:sensitive in frame waitfram = no.
      213       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      214       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      215       if  (   mWaitFramView
      216          or  mWaitProcEvent)
      217          and not mBatchMode
      218       then
      219          display
      220             v-waitfram-action01 skip
      221             v-waitfram-action02 skip
      222             v-waitfram-action03 skip
      223          with frame waitfram .
      224       if     mWaitFramView
      225          then do:
      226             if     mWaitFramInterval ne ?
      227                and not mBatchMode
      228             then
      229                wait-for go of frame waitfram pause mWaitFramInterval.
      230          end.
      231          else
      232             if     mWaitProcEvent
      233                and not mBatchMode
      234             then
      235                process events .
      236     end.
      237   end procedure.
      238      procedure waitfram-show-this:
      239         define input  parameter iInterval as int64 no-undo.
      240         define variable vtime as int64 no-undo.
      241         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      242         mWaitFramInterval = iInterval.
      243         run waitfram-show (substitute("&1&2 &3&4" ,
      244                                       mWaitFramTextBeg ,
      245                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      246                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      247                                       mWaitFramTextEnd
      248                                      )
      249                           ).
      250      end.
      251      procedure WaitFramRunPause:
      252         define input  parameter iInterval as dec no-undo.
      253         define variable vStart  as datetime-tz no-undo.
      254         define variable vend    as datetime-tz no-undo.
      255         define variable vint as int64 no-undo.
      256         define variable vOk as logical no-undo.
      257         vStart = now.
      258         vend   = vStart.
      259         publish "WaitFramPause" (iInterval,output vOk).
      260         vend   =  now.
      261         vint = vend - vStart.
      262         vint = iInterval - vint / 1000.
      263         if     not mWaitFramStop
      264            and (   vint > 0
      265                 or (    not vOk
      266                     and iInterval eq ?
      267                     )
      268                 )
      269         then
      270            run waitfram-show-this (iInterval).
      271         vend   =  now.
      272         vint = vend - vStart.
      273         vint = iInterval - vint / 1000.
      274         if     not mWaitFramStop
      275            and vint > 0
      276         then do:
      277            run gbl/pause.p (vint * 1000).
      278         end.
      279         if iInterval ne ?
      280         then
      281            publish "WaitFramStop".
      282         waitfram-check-timeout().
      283      end.
      284      procedure WaitFramWaitFor:
      285         define input  parameter iInterval as dec no-undo.
      286         assign
      287            mWaitFramStartProc   = now
      288            mWaitFramStopUser    = no
      289            mWaitFramStopTimeOut = no
      290         .
      291         block-wait:
      292         do while not mWaitFramStop:
      293            run WaitFramRunPause (iInterval).
      294            if  waitfram-check-timeout()
      295            then do:
      296               leave block-wait.
      297            end.
      298         end.
      299         run waitfram-hide.
      300      end.
      301   procedure waitfram-join :
      302     define input  parameter p-line-1  as character no-undo .
      303     define input  parameter p-line-2  as character no-undo .
      304     define input  parameter p-line-3  as character no-undo .
      305     define output parameter p-message as character no-undo .
      306     do
      307     on error undo, return error return-value
      308     :
      309       assign
      310         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      311                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      312                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      313       .
      314     end.
      315   end procedure.
      316   function waitfram-join-function returns character
      317     (input p-line-1 as character
      318     ,input p-line-2 as character
      319     ,input p-line-3 as character
      320     ).
      321     define variable v-message as character no-undo .
      322     run waitfram-join in this-procedure
      323       (input  p-line-1
      324       ,input  p-line-2
      325       ,input  p-line-3
      326       ,output v-message
      327       ) .
      328     return v-message .
      329   end function .
      330   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      331   procedure dtr-code :
      332     do
      333     on error undo, return error
      334     :
      335       define input  parameter  p-templ-rl-root     like ub.dis-time-rule.templ-rl-root     no-undo .
      336       define output parameter  p-des               like ub.dis-time-rule.des               no-undo .
      337       define output parameter  p-upper-time-rule-num    like ub.dis-time-rule.upper-time-rule-num    no-undo .
      338       define output parameter  p-value-type        like ub.dis-time-rule.value-type        no-undo .
      339       define output parameter  p-level-1 as character no-undo .
      340       define output parameter  p-level-2 as character no-undo .
      341       define output parameter  p-output-display as logical   no-undo .
      342       define output parameter  p-tree           as char  no-undo .
      343       define output parameter  p-other          as character no-undo .
      344       define variable v-templ-rl-root like ub.dis-time-rule.templ-rl-root no-undo .
      345       define buffer buf_dis-time-rule for ub.dis-time-rule .
      346       define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      347       if p-templ-rl-root < 50000 then
      348       v-templ-rl-root = (p-templ-rl-root + 50000).
      349       else v-templ-rl-root = p-templ-rl-root.
      350       find first buf_dis-time-rule no-lock where
      351                 buf_dis-time-rule.time-rule-num = v-templ-rl-root no-error .
      352       if not available buf_dis-time-rule then do:
      353         undo, return error substitute("неизвестный тип расписания &1", p-templ-rl-root) .
      354       end.
      355       find first buf_dis-cfg-rule no-lock where
      356               buf_dis-cfg-rule.templ-rl-root = 0
      357           and buf_dis-cfg-rule.time-templ-rl-root = p-templ-rl-root
      358           and buf_dis-cfg-rule.pos-type = '':U
      359           and buf_dis-cfg-rule.table-name = '':U
      360           and buf_dis-cfg-rule.discnt-role = '':U
      361           and buf_dis-cfg-rule.self-nonunique = '':U
      362               no-error.
      363       if not available buf_Dis-cfg-rule then do:
      364           undo, return error substitute("неизвестный тип расписания &1", p-templ-rl-root ).
      365       end.
      366       assign
      367       p-des = buf_dis-time-rule.des
      368       p-upper-time-rule-num = (buf_dis-time-rule.upper-time-rule-num - 50000)
      369       p-value-type = buf_dis-time-rule.value-type
      370       p-level-1 = entry(1, buf_dis-cfg-rule.other-inf, ";":U)
      371       p-level-2 = (if num-entries(buf_dis-cfg-rule.other-inf, ";":U) > 1
      372                    then entry(2, buf_dis-cfg-rule.other-inf, ";":U)
      373                    else '')
      374       p-output-display = (buf_dis-time-rule.sts = integer('0':U))
      375       p-tree = buf_dis-time-rule.uniq-field
      376       p-other = buf_dis-time-rule.other-inf
      377       .
      378     end.
      379   end procedure.
      380   DEFINE VARIABLE loc#log as logical no-undo .
      381   define buffer buf_dis-time-rule for ub.dis-time-rule.
      382   DEFINE VARIABLE choice as logical no-undo .
      383   DEFINE VARIABLE varold-sts like ub.dis-time-rule.sts no-undo .
      384   define variable v-mess as character no-undo .
      385   define variable v-time-rule-num like ub.dis-time-rule.time-rule-num no-undo .
      386   _main:
      387   do
      388   on error undo, return error return-value
      389   :
      390   find current bf-dis-time-rule exclusive-lock.
      391   if bf-dis-time-rule.lvl-num <> 0 then do:
      392     v-mess = substitute("РАСПИСАНИЕ №&1: невозможно изменить статус&2" +
      393                         "Менять статус можно только для неиспользуемых шаблонов расписаний&2"  +
      394                         "и расписаний уровня 1"
      395                         , bf-dis-time-rule.time-rule-num
      396                         ).
      397     if not p-silent then do:
      398       message
      399       v-mess
      400       view-as alert-box error .
      401     end.
      402     undo, return error (if p-silent then v-mess else '':U).
      403   end.
      404   varold-sts = bf-dis-time-rule.sts.
      405   if par-sts = ? then do:
      406     CASE varold-sts:
      407       when integer('0':U) then do:
      408         assign
      409         par-sts = integer('1':U).
      410       end.
      411       when integer('1':U)
      412       or
      413       when integer('2':U)
      414       then do:
      415         assign
      416         par-sts = integer('0':U).
      417       end.
      418     END CASE.
      419   end.
      420   CASE par-sts:
      421     WHEN integer('0':U) then do:
      422       if integer('0':U) = bf-dis-time-rule.sts  then do:
      423         if p-silent then do:
      424           return .
      425         end.
      426         else do:
      427           message "Запись уже имеет статус ИСПОЛЬЗУЕТСЯ!"
      428           view-as alert-box ERROR.
      429           par-sts = ?.
      430           return error.
      431         end.
      432       end.
      433       else do:
      434         if p-silent then do:
      435           choice = yes.
      436         end.
      437         else do:
      438           message
      439           "Запись не используется - восстановить?"
      440           view-as alert-box QUestion buttons YEs-no update choice.
      441         end.
      442       end.
      443     end.
      444     WHEN integer('1':U) then do:
      445       if integer('1':U) = bf-dis-time-rule.sts  then do:
      446         if p-silent then do:
      447           return .
      448         end.
      449         else do:
      450           message "Запись уже имеет статус НЕ ИСПОЛЬЗУЕТСЯ!"
      451           view-as alert-box ERROR.
      452           par-sts = ?.
      453           return error.
      454         end.
      455       end.
      456       else do:
      457         if p-silent then do:
      458           choice = yes.
      459         end.
      460         else do:
      461           message
      462           "Поставить статус НЕ ИСПОЛЬЗУЕТСЯ?" skip
      463           "Все расписания данного типа будут удалены!"
      464           view-as alert-box QUestion buttons yes-no update choice.
      465         end.
      466       end.
      467     end.
      468   END CASE.
      469   if choice then do:
      470     if bf-dis-time-rule.sts = integer('0':U)
      471     then do:
      472       if bf-dis-time-rule.time-rule-num <= 99999 then do:
      473         for each BUF_dis-time-rule where
      474                 buf_dis-time-rule.upper-time-rule-num = bf-dis-time-rule.time-rule-num:
      475           v-time-rule-num = buf_dis-time-rule.time-rule-num.
      476           run ref/dis-tim3.p (buffer buf_dis-time-rule
      477                          ,input no
      478                          ,input p-silent) no-error .
      479           if error-status:error then do:
      480             v-mess = substitute("Ошибка при удалении РАСПИСАНИЯ №&1&2&3&2&4"
      481                                 , buf_dis-time-rule.time-rule-num
      482                                 , chr(10)
      483                                 , error-status:get-message(1)
      484                                 , return-value ).
      485             undo _main, return error (if p-silent then v-mess else '':U).
      486           end.
      487         end.
      488       end.
      489     end.
      490     assign
      491     bf-dis-time-rule.sts = par-sts.
      492     v-time-rule-num = bf-dis-time-rule.time-rule-num.
      493     release bf-dis-time-rule no-error .
      494     if error-status:error then do:
      495       v-mess = substitute("Ошибка при сохранении записи РАСПИСАНИЯ №&1&2&3&2&4"
      496                                , v-time-rule-num
      497                                , chr(10)
      498                                , error-status:get-message(1)
      499                                , return-value ).
      500       if not p-silent then do:
      501         message
      502         v-mess
      503         view-as alert-box error .
      504       end.
      505       undo _main, return error (if p-silent then v-mess else '':U).
      506     end.
      507   end.
      508   par-sts = ?.
      509   end.
