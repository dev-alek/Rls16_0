     2617             if (" X_clients.obj-name contains NameOrCode                              AND X_clients.is-prod = yes                             AND X_clients.stts <> 0                             AND (   ( if SupGds = yes AND X_clients.sup-gds = yes     then yes else no ) OR      ( if SupCons = yes AND X_clients.sup-cons = yes     then yes else no ) OR    ( if BuyGds = yes AND X_clients.buy-gds = yes     then yes else no ) OR      ( if BuyCons = yes AND X_clients.buy-cons = yes     then yes else no ) OR    ( if BuyServ = yes AND X_clients.buy-serv = yes     then yes else no ) OR    ( if WLim-kr = yes AND X_clients.lim-kr <> 0    then yes else no )         ) " + " " + where-phrase-25) <> ""
     2618             then  (substitute('X_clients.obj-name contains &1&2&1                              AND X_clients.is-prod = yes                             AND X_clients.stts <> 0                             AND ', chr(34), NameOrCode) + substitute('(   ( if &1 = yes AND X_clients.sup-gds = yes     then yes else no ) OR      ( if &2 = yes AND X_clients.sup-cons = yes     then yes else no ) OR    ( if &3 = yes AND X_clients.buy-gds = yes     then yes else no ) OR      ( if &4 = yes AND X_clients.buy-cons = yes     then yes else no ) OR    ( if &5 = yes AND X_clients.buy-serv = yes     then yes else no ) OR    ( if &6 = yes AND X_clients.lim-kr <> 0    then yes else no )         )',  SupGds, SupCons, BuyGds, BuyCons, BuyServ, WLim-kr))  + " " + where-phrase-25
     2619             else "true"
     2620           )
     2621         parameter-5-25 = (" " + "" + " " + substitute(', FIRST X_clients-attr NO-LOCK  WHERE  X_clients-attr.obj-type = X_clients.obj-type AND                                                                     X_clients-attr.obj-code = X_clients.obj-code AND                                                                     X_clients-attr.attr-code = &1&2&1 AND                                                                    X_clients-attr.attr-value = &1yes&1', chr(34), attr-option_) + " " + p-find-condition)
     2622         parameter-6-25 = if sort-phrase-25 = ''
     2623                              then
     2624           (
     2625           " " + " " +
     2626             " " + sort-column-phrase +
     2627           " " + " BY X_clients.obj-name  "
     2628           )
     2629                              else
     2630           (
     2631           " " + " " +
     2632             " " + sort-column-phrase +
     2633           " " + sort-phrase-25
     2634           )
     2635         parameter-7-25 =
     2636           " indexed-reposition  "
     2637       .
     2638         run fltopend_fltfindq in this-procedure  (
     2639                             input this-procedure:handle
     2640                             ,input query cli-listA:handle
     2641                             ,input logical(parameter-2-25)
     2642                             ,input no-lock
     2643                             ,input parameter-3-25
     2644                             ,input parameter-4-25
     2645                             ,input parameter-5-25
     2646                             ,input parameter-6-25
     2647                             ,input parameter-7-25
     2648                             ,output v-fltopend-rowid
     2649                             ) no-error.
     2650         .
     2651         v-doc-rec = ?.
     2652       end.
     2653       assign
     2654         l-query-was-opened = true
     2655       .
     2656     end.
     2657   end.
     2658     run waitfram-hide in this-procedure .
     2659         end.
     2660         when "NO" then do:
     2661   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2662   define variable  l-disable-where-27  as logical   no-undo .
     2663   define variable  l-filter-open-27    as logical   .
     2664   define variable  flt-rec-27       as recid     no-undo .
     2665   define variable  filter-name-27      as character no-undo .
     2666   define variable  where-phrase-27     as character no-undo .
     2667   define variable  sort-phrase-27      as character no-undo .
     2668   define variable  where-phrase-rus-27 as character no-undo .
     2669   define variable  sort-phrase-rus-27  as character no-undo .
     2670     run waitfram-show in this-procedure
     2671       (input "ЖДИТЕ ..."
     2672       ).
     2673   run gbl/flt-get.p
     2674     (input filter-point
     2675     ,output flt-rec-27
     2676     ,output filter-name-27
     2677     ,output where-phrase-27
     2678     ,output sort-phrase-27
     2679     ,output where-phrase-rus-27
     2680     ,output sort-phrase-rus-27
     2681     ).
     2682   if p-open-query then do:
     2683       run set-filter-name in this-procedure
     2684         (INPUT filter-name-27
     2685         ) no-error .
     2686     assign
     2687       l-filter-open-27 = false
     2688     .
     2689     if flt-rec-27 <> ?
     2690       or sort-column-phrase > ""
     2691     then do:
     2692       define variable  parameter-2-27 as character no-undo .
     2693       define variable  parameter-3-27 as character no-undo .
     2694       define variable  parameter-4-27 as character no-undo .
     2695       define variable  parameter-5-27 as character no-undo .
     2696       define variable  parameter-6-27 as character no-undo .
     2697       define variable  parameter-7-27 as character no-undo .
     2698         assign
     2699         parameter-3-27 =
     2700                                 "FOR EACH X_clients"
     2701         parameter-4-27 =
     2702           (
     2703             if (" X_clients.obj-name contains NameOrCode                              AND X_clients.is-prod = yes                             AND X_clients.stts <> 0 " + " " + where-phrase-27) <> ""
     2704             then  substitute('X_clients.obj-name contains &1&2&1                              AND X_clients.is-prod = yes                             AND X_clients.stts <> 0 ', chr(34), NameOrCode) + " " + where-phrase-27
     2705             else "true"
     2706           )
     2707         parameter-5-27 = (" " + "" + " " + substitute(', FIRST X_clients-attr NO-LOCK  WHERE  X_clients-attr.obj-type = X_clients.obj-type AND                                                                     X_clients-attr.obj-code = X_clients.obj-code AND                                                                     X_clients-attr.attr-code = &1&2&1 AND                                                                    X_clients-attr.attr-value = &1yes&1', chr(34), attr-option_))
     2708         parameter-6-27 = if sort-phrase-27 = ''
     2709                              then
     2710           (
     2711           " " + " " +
     2712             " " + sort-column-phrase +
     2713           " " + " BY X_clients.obj-name  "
     2714           )
     2715                              else
     2716           (
     2717           " " + " " +
     2718             " " + sort-column-phrase +
     2719           " " + sort-phrase-27
     2720           )
     2721         parameter-7-27 =
     2722           " indexed-reposition  "
     2723       .
     2724       do
     2725       on stop undo, leave
     2726       on error undo, leave
     2727       :
     2728         assign
     2729           l-disable-where-27 =
     2730             (" X_clients.obj-name contains NameOrCode                              AND X_clients.is-prod = yes                             AND X_clients.stts <> 0 " + " " + where-phrase-27 = "")
     2731         .
     2732         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2733                             ,input query cli-listA:handle
     2734                             ,input parameter-3-27
     2735                             ,input parameter-4-27
     2736                             ,input parameter-5-27
     2737                             ,input parameter-6-27
     2738                             ,input parameter-7-27
     2739                             )
     2740         .
     2741         assign
     2742           l-filter-open-27 = true
     2743         .
     2744       end.
     2745       if l-filter-open-27 = false then do:
     2746         message
     2747           "Ошибка при фильтрации / сортировке" skip
     2748           "Будут показаны записи без учета фильтра" skip
     2749           view-as alert-box .
     2750       end.
     2751       else do:
     2752           assign
     2753             l-query-was-opened = true
     2754           .
     2755       end.
     2756     end.
     2757     if l-filter-open-27 = false then do:
     2758       OPEN QUERY CLi-ListA FOR EACH X_clients no-lock
     2759         where  X_clients.obj-name contains NameOrCode                              AND X_clients.is-prod = yes                             AND X_clients.stts <> 0
     2760       , FIRST X_clients-attr NO-LOCK  WHERE  X_clients-attr.obj-type = X_clients.obj-type AND                                                                     X_clients-attr.obj-code = X_clients.obj-code AND                                                                     X_clients-attr.attr-code = attr-option_ AND                                                                    X_clients-attr.attr-value = 'yes':U
     2761          BY X_clients.obj-name
     2762         indexed-reposition
     2763     .
     2764         assign
     2765           l-query-was-opened = true
     2766         .
     2767     end.
     2768   end.
     2769   else do:
     2770     assign
     2771       v-doc-rec = recid( ub.clients )
     2772     .
     2773     do
     2774     on stop undo, leave
     2775     on error undo, leave
     2776     :
     2777       if query cli-listA:handle:get-buffer-handle(1) = (buffer X_clients:handle) then do:
     2778         assign
     2779         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     2780         parameter-4-27 =
     2781           "where ":u +  substitute('X_clients.obj-name contains &1&2&1                              AND X_clients.is-prod = yes                             AND X_clients.stts <> 0 ', chr(34), NameOrCode) + " ":u + where-phrase-27 + " ":u + p-find-condition + " " + ""
     2782         parameter-5-27 = " "
     2783       .
     2784         run fltopend_fltfindd in this-procedure  (
     2785                             input this-procedure:handle
     2786                             ,input query cli-listA:handle
     2787                             ,input rowid(ub.clients)
     2788                             ,input logical(parameter-2-27)
     2789                             ,input no-lock
     2790                             ,input (buffer ub.clients:handle)
     2791                             ,input parameter-4-27
     2792                             ,input parameter-5-27
     2793                             ) no-error.
     2794         .
     2795         assign
     2796           v-doc-rec = integer(return-value)
     2797           v-fltopend-rowid[1] = ?
     2798         .
     2799       end.
     2800       else do:
     2801         assign
     2802         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     2803         parameter-3-27 =  "FOR EACH X_clients"
     2804         parameter-4-27 =
     2805           (
     2806             if (" X_clients.obj-name contains NameOrCode                              AND X_clients.is-prod = yes                             AND X_clients.stts <> 0 " + " " + where-phrase-27) <> ""
     2807             then  substitute('X_clients.obj-name contains &1&2&1                              AND X_clients.is-prod = yes                             AND X_clients.stts <> 0 ', chr(34), NameOrCode) + " " + where-phrase-27
     2808             else "true"
     2809           )
     2810         parameter-5-27 = (" " + "" + " " + substitute(', FIRST X_clients-attr NO-LOCK  WHERE  X_clients-attr.obj-type = X_clients.obj-type AND                                                                     X_clients-attr.obj-code = X_clients.obj-code AND                                                                     X_clients-attr.attr-code = &1&2&1 AND                                                                    X_clients-attr.attr-value = &1yes&1', chr(34), attr-option_) + " " + p-find-condition)
     2811         parameter-6-27 = if sort-phrase-27 = ''
     2812                              then
     2813           (
     2814           " " + " " +
     2815             " " + sort-column-phrase +
     2816           " " + " BY X_clients.obj-name  "
     2817           )
     2818                              else
     2819           (
     2820           " " + " " +
     2821             " " + sort-column-phrase +
     2822           " " + sort-phrase-27
     2823           )
     2824         parameter-7-27 =
     2825           " indexed-reposition  "
     2826       .
     2827         run fltopend_fltfindq in this-procedure  (
     2828                             input this-procedure:handle
     2829                             ,input query cli-listA:handle
     2830                             ,input logical(parameter-2-27)
     2831                             ,input no-lock
     2832                             ,input parameter-3-27
     2833                             ,input parameter-4-27
     2834                             ,input parameter-5-27
     2835                             ,input parameter-6-27
     2836                             ,input parameter-7-27
     2837                             ,output v-fltopend-rowid
     2838                             ) no-error.
     2839         .
     2840         v-doc-rec = ?.
     2841       end.
     2842       assign
     2843         l-query-was-opened = true
     2844       .
     2845     end.
     2846   end.
     2847     run waitfram-hide in this-procedure .
     2848         end.
     2849       END CASE .
     2850     end.
     2851   END CASE .
     2852     end.
     2853   end procedure.
