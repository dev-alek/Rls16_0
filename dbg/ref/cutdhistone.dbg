     3450   PROCEDURE disable_UI :
     3451     HIDE FRAME Dialog-Frame.
     3452   END PROCEDURE.
     3453   PROCEDURE enable_UI :
     3454     DISPLAY v-corr-user-db-num sch-db-num sch-corr-date sch-obj-code
     3455             sch-corr-user-name mark-num
     3456         WITH FRAME Dialog-Frame.
     3457     ENABLE b-quit B-mark b-sel v-corr-user-db-num B-print B-sch
     3458            B-Help br-obj-hist sch-db-num sch-corr-date sch-obj-code
     3459            sch-corr-user-name BR-changes mark-num b-nextlevel
     3460         WITH FRAME Dialog-Frame.
     3461     VIEW FRAME Dialog-Frame.
     3462   END PROCEDURE.
     3463   PROCEDURE MyEnable :
     3464   DEFINE VARIABLE v-h AS handle NO-UNDO.
     3465   assign
     3466   br-obj-hist:num-locked-columns in frame Dialog-Frame = 1
     3467   X_c-obj-hist.corr-date:read-only in browse br-obj-hist = yes
     3468   br-changes:title = "":U
     3469   v-corr-user-db-num = v-db-num
     3470   temp-changes.l_name:resizable in browse br-changes = true
     3471   temp-changes.v_old:resizable in browse br-changes = true
     3472   temp-changes.v_new:resizable in browse br-changes = true
     3473   temp-changes.l_name:width in browse br-changes = 30
     3474   temp-changes.v_old:width in browse br-changes = 40
     3475   temp-changes.v_new:width in browse br-changes = 40
     3476   v-h = br-obj-hist:FIRST-COLUMN IN FRAME Dialog-Frame
     3477   .
     3478   DO while valid-handle(v-h) :
     3479     if v-h:LABEL = "Предмет изменения"
     3480     or v-h:LABEL = "Изменил"
     3481       then do:
     3482       v-h:RESIZABLE = YES.
     3483     end.
     3484       v-h = v-h:NEXT-COLUMN.
     3485     END.
     3486   DISPLAY
     3487   v-corr-user-db-num
     3488   sch-db-num
     3489   sch-corr-date
     3490   sch-obj-code
     3491   sch-corr-user-name
     3492   mark-num
     3493   WITH FRAME Dialog-Frame.
     3494   ENABLE
     3495   v-corr-user-db-num
     3496   b-quit
     3497   B-mark when lookup("b-mark":U, bttns) > 0
     3498   b-sel when lookup("b-sel":U, bttns) > 0
     3499   B-sch
     3500   B-Print
     3501   B-Help
     3502   br-obj-hist
     3503   sch-corr-date
     3504   sch-corr-user-name
     3505   sch-obj-code when p-mode = 'все':U
     3506   sch-db-num when p-mode = 'все':U
     3507   BR-changes mark-num
     3508   b-nextlevel
     3509   WITH FRAME Dialog-Frame.
     3510   VIEW FRAME Dialog-Frame.
     3511   HIDE sch-corr-user-name IN FRAME Dialog-Frame.
     3512   END PROCEDURE.
     3513   PROCEDURE OpenBr :
     3514   define input  parameter p-open-query     as logical   no-undo .
     3515   define input  parameter p-find-next      as logical   no-undo .
     3516   define input  parameter p-find-condition as character no-undo .
     3517   define input  parameter p-db-num like c-utd-head.corr-user-db-num no-undo .
     3518   define variable l-query-was-opened as logical no-undo .
     3519   define variable title0 as character no-undo.
     3520   title0 = "Список полной истории контрагента" + chr(32).
     3521   run waitfram-show in this-procedure ("Ждите...").
     3522   define variable sort-column-phrase as character no-undo .
     3523   case sort-column-name :
     3524     when "" then do:
     3525       assign
     3526         sort-column-phrase = ""
     3527       .
     3528     end.
     3529     otherwise do:
     3530       assign
     3531         sort-column-phrase = "by " + sort-column-name
     3532       .
     3533     end.
     3534   end case.
     3535   define variable l-open-query as logical   no-undo .
     3536   if p-mode = 'все':U then
     3537   do:
     3538         assign
     3539         filter-point = filter-point0 + p-mode
     3540         filter-label = substitute("&1", filter-label0)
     3541         .
     3542   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3543   define variable  l-disable-where-27  as logical   no-undo .
     3544   define variable  l-filter-open-27    as logical   .
     3545   define variable  flt-rec-27       as recid     no-undo .
     3546   define variable  filter-name-27      as character no-undo .
     3547   define variable  where-phrase-27     as character no-undo .
     3548   define variable  sort-phrase-27      as character no-undo .
     3549   define variable  where-phrase-rus-27 as character no-undo .
     3550   define variable  sort-phrase-rus-27  as character no-undo .
     3551     run waitfram-show in this-procedure
     3552       (input "ЖДИТЕ ..."
     3553       ).
     3554   run gbl/flt-get.p
     3555     (input filter-point
     3556     ,output flt-rec-27
     3557     ,output filter-name-27
     3558     ,output where-phrase-27
     3559     ,output sort-phrase-27
     3560     ,output where-phrase-rus-27
     3561     ,output sort-phrase-rus-27
     3562     ).
     3563   if p-open-query then do:
     3564       run set-filter-name in this-procedure
     3565         (INPUT filter-name-27
     3566         ) no-error .
     3567     assign
     3568       l-filter-open-27 = false
     3569     .
     3570     if flt-rec-27 <> ?
     3571       or sort-column-phrase > ""
     3572     then do:
     3573       define variable  parameter-2-27 as character no-undo .
     3574       define variable  parameter-3-27 as character no-undo .
     3575       define variable  parameter-4-27 as character no-undo .
     3576       define variable  parameter-5-27 as character no-undo .
     3577       define variable  parameter-6-27 as character no-undo .
     3578       define variable  parameter-7-27 as character no-undo .
     3579         assign
     3580         parameter-3-27 =
     3581                                 "FOR EACH X_c-obj-hist"
     3582         parameter-4-27 =
     3583           (
     3584             if (" TRUE " + " " + where-phrase-27) <> ""
     3585             then " TRUE " + " " + where-phrase-27
     3586             else "true"
     3587           )
     3588         parameter-5-27 = (" " + "" + " " + "")
     3589         parameter-6-27 = if sort-phrase-27 = ''
     3590                              then
     3591           (
     3592           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC  " +
     3593             " " + sort-column-phrase +
     3594           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC  "
     3595           )
     3596                              else
     3597           (
     3598           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC  " +
     3599             " " + sort-column-phrase +
     3600           " " + sort-phrase-27
     3601           )
     3602         parameter-7-27 =
     3603           " indexed-reposition  "
     3604       .
     3605       do
     3606       on stop undo, leave
     3607       on error undo, leave
     3608       :
     3609         assign
     3610           l-disable-where-27 =
     3611             (" TRUE " + " " + where-phrase-27 = "")
     3612         .
     3613         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3614                             ,input query br-obj-hist:handle
     3615                             ,input parameter-3-27
     3616                             ,input parameter-4-27
     3617                             ,input parameter-5-27
     3618                             ,input parameter-6-27
     3619                             ,input parameter-7-27
     3620                             )
     3621         .
     3622         assign
     3623           l-filter-open-27 = true
     3624         .
     3625       end.
     3626       if l-filter-open-27 = false then do:
     3627         message
     3628           "Ошибка при фильтрации / сортировке" skip
     3629           "Будут показаны записи без учета фильтра" skip
     3630           view-as alert-box .
     3631       end.
     3632       else do:
     3633           assign
     3634             l-query-was-opened = true
     3635           .
     3636       end.
     3637     end.
     3638     if l-filter-open-27 = false then do:
     3639       OPEN QUERY br-obj-hist FOR EACH X_c-obj-hist
     3640         where  TRUE
     3641          BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC
     3642          BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC
     3643         indexed-reposition
     3644     .
     3645         assign
     3646           l-query-was-opened = true
     3647         .
     3648     end.
     3649   end.
     3650   else do:
     3651     assign
     3652       v-doc-rec = recid( X_c-obj-hist )
     3653     .
     3654     do
     3655     on stop undo, leave
     3656     on error undo, leave
     3657     :
     3658       if query br-obj-hist:handle:get-buffer-handle(1) = (buffer X_c-obj-hist:handle) then do:
     3659         assign
     3660         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     3661         parameter-4-27 =
     3662           "where ":u + " TRUE " + " ":u + where-phrase-27 + " ":u + p-find-condition + " " + ""
     3663         parameter-5-27 = " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC  "
     3664       .
     3665         run fltopend_fltfindd in this-procedure  (
     3666                             input this-procedure:handle
     3667                             ,input query br-obj-hist:handle
     3668                             ,input rowid(X_c-obj-hist)
     3669                             ,input logical(parameter-2-27)
     3670                             ,input no-lock
     3671                             ,input (buffer X_c-obj-hist:handle)
     3672                             ,input parameter-4-27
     3673                             ,input parameter-5-27
     3674                             ) no-error.
     3675         .
     3676         assign
     3677           v-doc-rec = integer(return-value)
     3678           v-fltopend-rowid[1] = ?
     3679         .
     3680       end.
     3681       else do:
     3682         assign
     3683         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     3684         parameter-3-27 =  "FOR EACH X_c-obj-hist"
     3685         parameter-4-27 =
     3686           (
     3687             if (" TRUE " + " " + where-phrase-27) <> ""
     3688             then " TRUE " + " " + where-phrase-27
     3689             else "true"
     3690           )
     3691         parameter-5-27 = (" " + "" + " " + "" + " " + p-find-condition)
     3692         parameter-6-27 = if sort-phrase-27 = ''
     3693                              then
     3694           (
     3695           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC  " +
     3696             " " + sort-column-phrase +
     3697           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC  "
     3698           )
     3699                              else
     3700           (
     3701           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC  " +
     3702             " " + sort-column-phrase +
     3703           " " + sort-phrase-27
     3704           )
     3705         parameter-7-27 =
     3706           " indexed-reposition  "
     3707       .
     3708         run fltopend_fltfindq in this-procedure  (
     3709                             input this-procedure:handle
     3710                             ,input query br-obj-hist:handle
     3711                             ,input logical(parameter-2-27)
     3712                             ,input no-lock
     3713                             ,input parameter-3-27
     3714                             ,input parameter-4-27
     3715                             ,input parameter-5-27
     3716                             ,input parameter-6-27
     3717                             ,input parameter-7-27
     3718                             ,output v-fltopend-rowid
     3719                             ) no-error.
     3720         .
     3721         v-doc-rec = ?.
     3722       end.
     3723       assign
     3724         l-query-was-opened = true
     3725       .
     3726     end.
     3727   end.
     3728     run waitfram-hide in this-procedure .
     3729   end.
     3730   else do:
     3731     if not local-open-br( p-open-query      ,
     3732                           p-find-next         ,
     3733                          p-find-condition )
     3734     then do:
     3735   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3736   define variable  l-disable-where-29  as logical   no-undo .
     3737   define variable  l-filter-open-29    as logical   .
     3738   define variable  flt-rec-29       as recid     no-undo .
     3739   define variable  filter-name-29      as character no-undo .
     3740   define variable  where-phrase-29     as character no-undo .
     3741   define variable  sort-phrase-29      as character no-undo .
     3742   define variable  where-phrase-rus-29 as character no-undo .
     3743   define variable  sort-phrase-rus-29  as character no-undo .
     3744     run waitfram-show in this-procedure
     3745       (input "ЖДИТЕ ..."
     3746       ).
     3747   run gbl/flt-get.p
     3748     (input filter-point
     3749     ,output flt-rec-29
     3750     ,output filter-name-29
     3751     ,output where-phrase-29
     3752     ,output sort-phrase-29
     3753     ,output where-phrase-rus-29
     3754     ,output sort-phrase-rus-29
     3755     ).
     3756   if p-open-query then do:
     3757       run set-filter-name in this-procedure
     3758         (INPUT filter-name-29
     3759         ) no-error .
     3760     assign
     3761       l-filter-open-29 = false
     3762     .
     3763     if flt-rec-29 <> ?
     3764       or sort-column-phrase > ""
     3765     then do:
     3766       define variable  parameter-2-29 as character no-undo .
     3767       define variable  parameter-3-29 as character no-undo .
     3768       define variable  parameter-4-29 as character no-undo .
     3769       define variable  parameter-5-29 as character no-undo .
     3770       define variable  parameter-6-29 as character no-undo .
     3771       define variable  parameter-7-29 as character no-undo .
     3772         assign
     3773         parameter-3-29 =
     3774                                 "FOR EACH X_c-obj-hist"
     3775         parameter-4-29 =
     3776           (
     3777             if (" TRUE " + " " + where-phrase-29) <> ""
     3778             then " TRUE " + " " + where-phrase-29
     3779             else "true"
     3780           )
     3781         parameter-5-29 = (" " + "" + " " + "")
     3782         parameter-6-29 = if sort-phrase-29 = ''
     3783                              then
     3784           (
     3785           " " + "" +
     3786             " " + sort-column-phrase +
     3787           " " + "  "
     3788           )
     3789                              else
     3790           (
     3791           " " + "" +
     3792             " " + sort-column-phrase +
     3793           " " + sort-phrase-29
     3794           )
     3795         parameter-7-29 =
     3796           " indexed-reposition  "
     3797       .
     3798       do
     3799       on stop undo, leave
     3800       on error undo, leave
     3801       :
     3802         assign
     3803           l-disable-where-29 =
     3804             (" TRUE " + " " + where-phrase-29 = "")
     3805         .
     3806         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3807                             ,input query br-obj-hist:handle
     3808                             ,input parameter-3-29
     3809                             ,input parameter-4-29
     3810                             ,input parameter-5-29
     3811                             ,input parameter-6-29
     3812                             ,input parameter-7-29
     3813                             )
     3814         .
     3815         assign
     3816           l-filter-open-29 = true
     3817         .
     3818       end.
     3819       if l-filter-open-29 = false then do:
     3820         message
     3821           "Ошибка при фильтрации / сортировке" skip
     3822           "Будут показаны записи без учета фильтра" skip
     3823           view-as alert-box .
     3824       end.
     3825       else do:
     3826           assign
     3827             l-query-was-opened = true
     3828           .
     3829       end.
     3830     end.
     3831     if l-filter-open-29 = false then do:
     3832       OPEN QUERY br-obj-hist FOR EACH X_c-obj-hist
     3833         where  TRUE
     3834         indexed-reposition
     3835     .
     3836         assign
     3837           l-query-was-opened = true
     3838         .
     3839     end.
     3840   end.
     3841   else do:
     3842     assign
     3843       v-doc-rec = recid( X_c-obj-hist )
     3844     .
     3845     do
     3846     on stop undo, leave
     3847     on error undo, leave
     3848     :
     3849       if query br-obj-hist:handle:get-buffer-handle(1) = (buffer X_c-obj-hist:handle) then do:
     3850         assign
     3851         parameter-2-29 = (if p-find-next then "true":u else "false":u )
     3852         parameter-4-29 =
     3853           "where ":u + " TRUE " + " ":u + where-phrase-29 + " ":u + p-find-condition + " " + ""
     3854         parameter-5-29 = ""
     3855       .
     3856         run fltopend_fltfindd in this-procedure  (
     3857                             input this-procedure:handle
     3858                             ,input query br-obj-hist:handle
     3859                             ,input rowid(X_c-obj-hist)
     3860                             ,input logical(parameter-2-29)
     3861                             ,input no-lock
     3862                             ,input (buffer X_c-obj-hist:handle)
     3863                             ,input parameter-4-29
     3864                             ,input parameter-5-29
     3865                             ) no-error.
     3866         .
     3867         assign
     3868           v-doc-rec = integer(return-value)
     3869           v-fltopend-rowid[1] = ?
     3870         .
     3871       end.
     3872       else do:
     3873         assign
     3874         parameter-2-29 = (if p-find-next then "true":u else "false":u )
     3875         parameter-3-29 =  "FOR EACH X_c-obj-hist"
     3876         parameter-4-29 =
     3877           (
     3878             if (" TRUE " + " " + where-phrase-29) <> ""
     3879             then " TRUE " + " " + where-phrase-29
     3880             else "true"
     3881           )
     3882         parameter-5-29 = (" " + "" + " " + "" + " " + p-find-condition)
     3883         parameter-6-29 = if sort-phrase-29 = ''
     3884                              then
     3885           (
     3886           " " + "" +
     3887             " " + sort-column-phrase +
     3888           " " + "  "
     3889           )
     3890                              else
     3891           (
     3892           " " + "" +
     3893             " " + sort-column-phrase +
     3894           " " + sort-phrase-29
     3895           )
     3896         parameter-7-29 =
     3897           " indexed-reposition  "
     3898       .
     3899         run fltopend_fltfindq in this-procedure  (
     3900                             input this-procedure:handle
     3901                             ,input query br-obj-hist:handle
     3902                             ,input logical(parameter-2-29)
     3903                             ,input no-lock
     3904                             ,input parameter-3-29
     3905                             ,input parameter-4-29
     3906                             ,input parameter-5-29
     3907                             ,input parameter-6-29
     3908                             ,input parameter-7-29
     3909                             ,output v-fltopend-rowid
     3910                             ) no-error.
     3911         .
     3912         v-doc-rec = ?.
     3913       end.
     3914       assign
     3915         l-query-was-opened = true
     3916       .
     3917     end.
     3918   end.
     3919     run waitfram-hide in this-procedure .
     3920     end.
     3921   end.
     3922   if not p-open-query and v-doc-rec <> ? then
     3923   REPOSITION br-obj-hist to recid v-doc-rec No-ERROR.
     3924   if not p-open-query and v-fltopend-rowid[1] <> ? then
     3925   query br-obj-hist:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     3926   run waitfram-hide in this-procedure .
     3927   APPLY "VALUE-CHANGED" TO br-obj-hist in frame Dialog-Frame.
     3928   APPLY "ENTRY" TO br-obj-hist.
     3929   END PROCEDURE.
     3930   PROCEDURE proc-b-print :
     3931   define variable date_string     as      char    no-undo.
     3932   define variable Line                as      char    no-undo.
     3933   define variable for-time as char.
     3934   define variable accum-count as integer.
     3935   define variable v-doc-rec as recid no-undo.
     3936   define variable v-subject-chr as character no-undo .
     3937   define variable v-upd-time as character no-undo .
     3938   define variable v-obj as character no-undo .
     3939   define variable v-action-chr as character no-undo .
     3940   define variable v-source-type as character no-undo .
     3941   DEFINE FRAME HistoryList
     3942   v-action-chr FORMAT "X(10)" COLUMN-LABEL "Действие"
     3943   v-subject-chr COLUMN-LABEL "Предмет изменений" FORMAT "X(20)"
     3944   X_c-obj-hist.is-news COLUMn-LABEL "СПН" FORMAT "+/ "
     3945   v-source-type COLUMn-LABEL "Источн.!измен"
     3946   X_c-obj-hist.source-ref COLUMn-LABEL "№"
     3947   X_c-obj-hist.corr-date
     3948   v-upd-time COLUMN-LABEL "Время изм." FORMAT "X(8)"
     3949   X_c-obj-hist.corr-user-name
     3950   X_c-obj-hist.corr-user-db-num
     3951   HEADER  date_string AT 5 format "X(35)"
     3952   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     3953   Line format "X(195)" AT 1
     3954   with width 232 down stream-io use-text    .
     3955   Line = fill("-", 195).
     3956   date_string = cur-time-print() .
     3957   assign
     3958   v-doc-rec = recid( X_c-obj-hist ).
     3959   DO WHILE available X_c-obj-hist :
     3960         GET prev br-obj-hist.
     3961   END.
     3962   run prn-lib-open-stream  in this-procedure (
     3963                                                input parparentProc
     3964                                               ,input 43
     3965                                               ,input yes
     3966                                               ,input no
     3967                                               ).
     3968   PUT  STREAM PrnLibStream
     3969   SPACE(25) ( frame Dialog-Frame:title )
     3970   format "x(90)" SKIP(1) .
     3971   FORM HEADER
     3972   Line format "X(180)" AT 1 SKIP
     3973   "Продолжение - на следующей странице" AT 30 SKIP
     3974   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3975   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     3976   FORM with FRAME HistoryList  .
     3977   run waitfram-show in this-procedure ("Ждите...").
     3978     GET next br-obj-hist.
     3979       DO WHILE available X_c-obj-hist :
     3980         Display STREAM PrnLibStream
     3981          get-action(X_c-obj-hist.action) @ v-action-chr
     3982          get-subject(X_c-obj-hist.subject) @ v-subject-chr
     3983         X_c-obj-hist.is-news
     3984         get-source-type(X_c-obj-hist.source-type) @ v-source-type
     3985         X_c-obj-hist.source-ref
     3986         X_c-obj-hist.corr-date
     3987         string(X_c-obj-hist.corr-time, "HH:MM:SS":U) @ v-upd-time
     3988         X_c-obj-hist.corr-user-name
     3989         X_c-obj-hist.corr-user-db-num
     3990         with FRAME HistoryList .
     3991     DOWN STREAM PrnLibStream 1 with FRAME HistoryList  .
     3992     assign
     3993     accum-count = accum-count + 1
     3994     .
     3995     GET next br-obj-hist.
     3996   END.
     3997   UNDERLINE  STREAM PrnLibStream
     3998   v-action-chr
     3999   v-subject-chr
     4000   X_c-obj-hist.is-news
     4001   v-source-type
     4002   X_c-obj-hist.source-ref
     4003   X_c-obj-hist.corr-date
     4004   v-upd-time
     4005   X_c-obj-hist.corr-user-name
     4006   X_c-obj-hist.corr-user-db-num
     4007   with FRAME HistoryList .
     4008   DISPLAY STREAM PrnLibStream
     4009   "ИТОГО"  @ v-obj
     4010   string(accum-count)  @ v-action-chr
     4011   with frame HistoryList.
     4012   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     4013   HIDE  STREAM PrnLibStream FRAME CheckList.
     4014   output  STREAM PrnLibStream CLOSE.
     4015   run waitfram-hide in this-procedure.
     4016   run prn-lib-prn-file in this-procedure (
     4017                                             input parparentproc
     4018                                             ,input 8
     4019                                             ).
     4020   reposition br-obj-hist to recid v-doc-rec no-error.
     4021   apply "entry" to br-obj-hist in frame Dialog-Frame.
     4022   END PROCEDURE.
     4023   PROCEDURE proc-b-sch :
     4024   assign
     4025     tbl = "c-utd-head"
     4026     join-tbl = 'X_c-obj-hist'
     4027     fld = ""
     4028     lab = ""
     4029     spr = ""
     4030     dim = '0'
     4031     .
     4032   run fltfield-add in this-procedure('corr-date', 'Дата корр.', '',
     4033   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4034   run fltfield-add in this-procedure('corr-time', 'Время корр.', 'time',
     4035   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4036   run fltfield-add in this-procedure('corr-user-db-num', 'БД корр.', '',
     4037   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4038   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     4039   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4040   run fltfield-add in this-procedure('action', 'Действие', 'hist-action',
     4041   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4042   run fltfield-add in this-procedure('subject', 'Предмет изменения', 'obj-hist-subject',
     4043   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4044   run fltfield-add in this-procedure('source-type', 'Источник измен-я', 'hist-source-type',
     4045   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4046   run fltfield-add in this-procedure('source-ref', 'Код источника измен-я', '',
     4047   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4048   Filter-Block:
     4049   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4050       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4051       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4052     run gbl/filter.w ( INPUT parparentproc
     4053                      , INPUT filter-point + chr(4) + filter-label
     4054                      , INPUT tbl
     4055                      , INPUT join-tbl
     4056                      , INPUT fld
     4057                      , INPUT lab
     4058                      , INPUT spr
     4059                      , INPUT dim ).
     4060     RUN OpenBr in this-procedure ( input yes, input no, input '':U, input v-corr-user-db-num).
     4061   END.
     4062   END PROCEDURE.
     4063   PROCEDURE proc-find-corr-date :
     4064   define input parameter p-next as logical no-undo.
     4065   define input parameter p-date like ub.fin-doc.doc-date no-undo.
     4066   define variable v-date-chr as character no-undo.
     4067   if p-date = ? then return .
     4068   display
     4069   0 @ sch-obj-code
     4070   0 @ sch-db-num
     4071   "":U @ sch-corr-user-name
     4072   with frame Dialog-Frame.
     4073   assign
     4074   v-date-chr = string(day(p-date)) + chr(47) +
     4075                    string(month(p-date)) + chr(47) +
     4076                    string(year(p-date)).
     4077          run OpenBr in this-procedure
     4078           (input false
     4079           ,input true
     4080           ,input substitute("and X_c-obj-hist.corr-date = &1 "
     4081             , v-date-chr)
     4082           ,input v-corr-user-db-num
     4083           ).
     4084         apply "entry":u to sch-corr-date in frame Dialog-Frame.
     4085   END PROCEDURE.
     4086   PROCEDURE proc-find-db-num :
     4087   define input parameter p-next as logical no-undo.
     4088   define input parameter p-db-num like c-utd-head.corr-user-db-num no-undo.
     4089   define variable v-db-num as character no-undo.
     4090   assign
     4091   sch-corr-date = ?
     4092   .
     4093   display
     4094   "":U @ sch-corr-user-name
     4095   0 @ sch-obj-code
     4096   sch-corr-date
     4097   with frame Dialog-Frame.
     4098   assign
     4099   v-db-num = string(p-db-num).
     4100   run OpenBr in this-procedure
     4101       (input false
     4102       ,input p-next
     4103       ,input substitute("and X_c-obj-hist.corr-user-db-num = &1 "
     4104         , v-db-num)
     4105       ,input v-corr-user-db-num
     4106       ).
     4107   apply "entry":u to sch-db-num in frame Dialog-Frame .
     4108   END PROCEDURE.
     4109   PROCEDURE proc-find-user :
     4110   define input parameter p-next as logical no-undo.
     4111   define input parameter p-user like c-utd-head.corr-user-name no-undo.
     4112   assign
     4113   sch-corr-date = ?.
     4114   display
     4115   0 @ sch-db-num
     4116   sch-corr-date
     4117   0 @ sch-obj-code
     4118   with frame Dialog-Frame.
     4119   p-user = chr(34) + p-user + chr(34).
     4120   run OpenBr in this-procedure
     4121       (input false
     4122       ,input p-next
     4123       ,input substitute("and X_c-obj-hist.corr-user-name = &1 "
     4124         , p-user)
     4125       ,input v-corr-user-db-num
     4126       ).
     4127   apply "entry":u to sch-corr-user-name in frame Dialog-Frame .
     4128   END PROCEDURE.
     4129   PROCEDURE proc-view-changes :
     4130   define variable v-description as character no-undo .
     4131   for each temp-changes:
     4132       delete temp-changes.
     4133   END.
     4134   if not available X_c-obj-hist then do:
     4135     b-nextlevel:visible IN FRAME Dialog-Frame = no.
     4136     Open QUery br-changes for each temp-changes.
     4137     return.
     4138   end.
     4139   b-nextlevel:visible IN FRAME Dialog-Frame = X_c-obj-hist.subject eq "*" .
     4140   run local-view-cange in this-procedure (output v-description) .
     4141   Open QUery br-changes for each temp-changes by temp-changes.fNotChange.
     4142   assign
     4143   br-changes:title in frame Dialog-Frame = v-description
     4144   .
     4145   END PROCEDURE.
     4146   FUNCTION get-action RETURNS CHARACTER
     4147     ( p-action as integer ) :
     4148   define variable dops as character no-undo.
     4149   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     4150   RETURN dops.
     4151   END FUNCTION.
     4152   FUNCTION get-source-type RETURNS CHARACTER
     4153     ( p-source-type as character ) :
     4154   define variable v-dop as character no-undo .
     4155   assign
     4156   v-dop = entry (lookup (p-source-type, ',db,esys,trn-doc,payment,fin-doc,import,recalc,wth-doc,ren-gdsc,upgrade,grp-chg,stop-list,dis-card':U), ',БД,ВС,Документ,Платеж,Фин.док.,Импорт,Пересчет,Документ МЦ,Коллизия,Апгрейд,Изм.группы,Стоплист,ДК':U)
     4157   no-error
     4158   .
     4159   RETURN v-dop.
     4160   END FUNCTION.
     4161   def var vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4162   define new global shared variable g#attr-lib  as handle no-undo .
     4163   define variable v-attr-lib-variable as handle no-undo .
     4164   def var vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4165   function getattrUtdex returns char
     4166   (idb-num   as integer,
     4167    idoc-id   as integer,
     4168    iattrcode as character,
     4169    iExValue  as character  ):
     4170      define buffer utd-attr for utd-attr.
     4171      find first utd-attr where utd-attr.db-num eq idb-num
     4172                            and utd-attr.doc-id eq idoc-id
     4173                            and utd-attr.attr-code eq iattrcode
     4174      no-lock no-error.
     4175      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
     4176   end.
     4177   function getattrUtd returns char
     4178   (idb-num   as integer,
     4179    idoc-id   as integer,
     4180    iattrcode as character ):
     4181     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
     4182   end.
     4183   function setattrUtd returns logical
     4184   (idb-num   as integer,
     4185    idoc-id   as integer,
     4186    iattrcode as character,
     4187    iattrval  as character ):
     4188      define buffer utd-attr for utd-attr.
     4189      find first utd-attr where utd-attr.db-num eq idb-num
     4190                            and utd-attr.doc-id eq idoc-id
     4191                            and utd-attr.attr-code eq iattrcode
     4192      no-lock no-error.
     4193      if not available utd-attr
     4194      then do:
     4195         create utd-attr.
     4196         assign
     4197            utd-attr.db-num    = idb-num
     4198            utd-attr.doc-id    = idoc-id
     4199            utd-attr.attr-code = iattrcode
     4200            utd-attr.attr-value = iattrval
     4201         .
     4202      end.
     4203      else do:
     4204         if utd-attr.attr-value ne iattrval
     4205         then do:
     4206            find current utd-attr exclusive-lock no-error.
     4207            if available utd-attr
     4208            then
     4209               utd-attr.attr-value = iattrval.
     4210         end.
     4211      end.
     4212      release utd-attr.
     4213   end.
     4214   function GetAttrUtdlinesEx returns char
     4215   (idb-num   as integer,
     4216    idoc-id   as integer,
     4217    ilinenum  as integer,
     4218    iattrcode as character,
     4219    iExValue  as character  ):
     4220      define buffer utd-lines-attr for utd-lines-attr.
     4221      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     4222                                  and utd-lines-attr.doc-id    eq idoc-id
     4223                                  and utd-lines-attr.lineNum   eq ilineNum
     4224                                  and utd-lines-attr.attr-code eq iattrcode
     4225      no-lock no-error.
     4226      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
     4227   end.
     4228   function GetAttrUtdlines returns char
     4229   (idb-num   as integer,
     4230    idoc-id   as integer,
     4231    ilinenum  as integer,
     4232    iattrcode as character ):
     4233      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
     4234   end.
     4235   function setattrUtdlines returns logical
     4236   (idb-num   as integer,
     4237    idoc-id   as integer,
     4238    ilinenum  as integer,
     4239    iattrcode as character,
     4240    iattrval  as character ):
     4241      define buffer utd-lines-attr for utd-lines-attr.
     4242      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
     4243                                  and utd-lines-attr.doc-id    eq idoc-id
     4244                                  and utd-lines-attr.lineNum   eq ilineNum
     4245                                  and utd-lines-attr.attr-code eq iattrcode
     4246      no-lock no-error.
     4247      if not available utd-lines-attr
     4248      then do:
     4249         if iattrval ne ?
     4250            and iattrval ne ""
     4251         then do:
     4252            create utd-lines-attr.
     4253            assign
     4254               utd-lines-attr.db-num    = idb-num
     4255               utd-lines-attr.doc-id    = idoc-id
     4256               utd-lines-attr.lineNum   = ilineNum
     4257               utd-lines-attr.attr-code = iattrcode
     4258               utd-lines-attr.attr-value = iattrval
     4259            .
     4260         end.
     4261      end.
     4262      else do:
     4263         if utd-lines-attr.attr-value ne iattrval
     4264         then do:
     4265            find current utd-lines-attr exclusive-lock no-error.
     4266            if available utd-lines-attr
     4267            then do:
     4268               if    iattrval eq ?
     4269                  or iattrval eq ""
     4270               then do:
     4271                  delete utd-lines-attr.
     4272               end.
     4273               else do:
     4274                  utd-lines-attr.attr-value = iattrval.
     4275               end.
     4276            end.
     4277         end.
     4278      end.
     4279      release utd-lines-attr.
     4280   end.
     4281   function GetAttrUtdMarkingLinesEx returns char
     4282   (idb-num   as integer,
     4283    idoc-id   as integer,
     4284    ilinenum  as integer,
     4285    imark     as character,
     4286    iattrcode as character,
     4287    iExValue  as character  ):
     4288      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
     4289      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
     4290                                          and utd-marking-lines-attr.doc-id    eq idoc-id
     4291                                          and utd-marking-lines-attr.lineNum   eq ilineNum
     4292                                          and utd-marking-lines-attr.mark      eq imark
     4293                                          and utd-marking-lines-attr.attr-code eq iattrcode
     4294      no-lock no-error.
     4295      return if not available utd-marking-lines-attr  then iExValue    else  utd-marking-lines-attr.attr-value.
     4296   end.
     4297   function GetAttrUtdMarkingLines returns char
     4298   (idb-num   as integer,
     4299    idoc-id   as integer,
     4300    ilinenum  as integer,
     4301    imark     as character,
     4302    iattrcode as character ):
     4303      return GetAttrUtdMarkingLinesEx (idb-num,idoc-id,ilinenum,imark,iattrcode,?).
     4304   end.
     4305   function setattrUtdMarkingLines returns logical
     4306   (idb-num   as integer,
     4307    idoc-id   as integer,
     4308    ilinenum  as integer,
     4309    imark     as character,
     4310    iattrcode as character,
     4311    iattrval  as character ):
     4312      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
     4313      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
     4314                                          and utd-marking-lines-attr.doc-id    eq idoc-id
     4315                                          and utd-marking-lines-attr.lineNum   eq ilineNum
     4316                                          and utd-marking-lines-attr.mark      eq imark
     4317                                          and utd-marking-lines-attr.attr-code eq iattrcode
     4318      no-lock no-error.
     4319      if not available utd-marking-lines-attr
     4320      then do:
     4321         if iattrval ne ?
     4322            and iattrval ne ""
     4323         then do:
     4324            create utd-marking-lines-attr.
     4325            assign
     4326               utd-marking-lines-attr.db-num     = idb-num
     4327               utd-marking-lines-attr.doc-id     = idoc-id
     4328               utd-marking-lines-attr.lineNum    = ilineNum
     4329               utd-marking-lines-attr.mark       = imark
     4330               utd-marking-lines-attr.attr-code  = iattrcode
     4331               utd-marking-lines-attr.attr-value = iattrval
     4332            .
     4333         end.
     4334      end.
     4335      else do:
     4336         if utd-marking-lines-attr.attr-value ne iattrval
     4337         then do:
     4338            find current utd-marking-lines-attr exclusive-lock no-error.
     4339            if available utd-marking-lines-attr
     4340            then do:
     4341               if    iattrval eq ?
     4342                  or iattrval eq ""
     4343               then do:
     4344                  delete utd-marking-lines-attr.
     4345               end.
     4346               else do:
     4347                  utd-marking-lines-attr.attr-value = iattrval.
     4348               end.
     4349            end.
     4350         end.
     4351      end.
     4352      release utd-marking-lines-attr.
     4353   end.
     4354   def var vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4355   define variable vss-include-info33 as character format "X(65)" no-undo
     4356   initial "@(#)$Workfile$ $Revision$".
     4357   procedure xmlchar-test :
     4358   define input parameter p-in-string          as character        no-undo.
     4359   define output parameter p-out-string-enc    as character        no-undo.
     4360   define output parameter p-out-string-dec    as character        no-undo.
     4361   do
     4362   on error undo, return error
     4363   :
     4364          run xmlchar-encode in this-procedure
     4365       (
     4366             input p-in-string
     4367           , output p-out-string-enc
     4368       ).
     4369          run xmlchar-decode in this-procedure
     4370       (
     4371             input p-out-string-enc
     4372           , output p-out-string-dec
     4373       ).
     4374   end.
     4375   end .
     4376   procedure xmlchar-encode :
     4377   define input parameter p-in-string      as character        no-undo.
     4378   define output parameter p-out-string    as character        no-undo.
     4379       define variable v-position      as integer      no-undo.
     4380       define variable v-current-char  as character    no-undo.
     4381   do
     4382   on error undo, return error
     4383   :
     4384       assign
     4385           p-out-string = "":U
     4386       .
     4387       case p-in-string
     4388       :
     4389           when ?
     4390           then do:
     4391               assign
     4392                   p-out-string = "?":U
     4393               .
     4394           end.
     4395           when "?":U
     4396           then do:
     4397               assign
     4398                   p-out-string = "&#63;":U
     4399               .
     4400           end.
     4401           otherwise do:
     4402               do v-position = 1 to length( p-in-string )
     4403               :
     4404                   assign
     4405                       v-current-char = substring( p-in-string, v-position, 1 )
     4406                   .
     4407                   case v-current-char
     4408                   :
     4409                       when "&":U
     4410                       then do:
     4411                           assign
     4412                               p-out-string = p-out-string + "&amp;":U
     4413                           .
     4414                       end.
     4415                       when ">":U
     4416                       then do:
     4417                           assign
     4418                               p-out-string = p-out-string + "&gt;":U
     4419                           .
     4420                       end.
     4421                       when "<":U
     4422                       then do:
     4423                           assign
     4424                               p-out-string = p-out-string + "&lt;":U
     4425                           .
     4426                       end.
     4427                       when "'":U
     4428                       then do:
     4429                           assign
     4430                               p-out-string = p-out-string + "&apos;":U
     4431                           .
     4432                       end.
     4433                       when '"':U
     4434                       then do:
     4435                           assign
     4436                               p-out-string = p-out-string + "&quot;":U
     4437                           .
     4438                       end.
     4439                       when chr(1)
     4440                       then do:
     4441                           assign
     4442                               p-out-string = p-out-string + "":U
     4443                           .
     4444                       end.
     4445                       when chr(2)
     4446                       then do:
     4447                           assign
     4448                               p-out-string = p-out-string + "":U
     4449                           .
     4450                       end.
     4451                       when chr(3)
     4452                       then do:
     4453                           assign
     4454                               p-out-string = p-out-string + "":U
     4455                           .
     4456                       end.
     4457                       when chr(4)
     4458                       then do:
     4459                           assign
     4460                               p-out-string = p-out-string + "":U
     4461                           .
     4462                       end.
     4463                       when chr(5)
     4464                       then do:
     4465                           assign
     4466                               p-out-string = p-out-string + "":U
     4467                           .
     4468                       end.
     4469                       when chr(6)
     4470                       then do:
     4471                           assign
     4472                               p-out-string = p-out-string + "":U
     4473                           .
     4474                       end.
     4475                       when chr(7)
     4476                       then do:
     4477                           assign
     4478                               p-out-string = p-out-string + "":U
     4479                           .
     4480                       end.
     4481                       when chr(8)
     4482                       then do:
     4483                           assign
     4484                               p-out-string = p-out-string + "":U
     4485                           .
     4486                       end.
     4487                       when chr(9)
     4488                       then do:
     4489                           assign
     4490                               p-out-string = p-out-string + "":U
     4491                           .
     4492                       end.
     4493                       when chr(29)
     4494                       then do:
     4495                           assign
     4496                               p-out-string = p-out-string + "":U
     4497                           .
     4498                       end.
     4499                       when chr(10)
     4500                       then do:
     4501                           assign
     4502                               p-out-string = p-out-string + "&#10;":U
     4503                           .
     4504                       end.
     4505                       when chr(13)
     4506                       then do:
     4507                           assign
     4508                               p-out-string = p-out-string + "&#13;":U
     4509                           .
     4510                       end.
     4511                       otherwise do:
     4512                           assign
     4513                               p-out-string = p-out-string + v-current-char
     4514                           .
     4515                       end.
     4516                   end case.
     4517               end.
     4518           end.
     4519       end case.
     4520   end.
     4521   end .
     4522   procedure xmlchar-encode-1c :
     4523   define input parameter p-in-string      as character        no-undo.
     4524   define output parameter p-out-string    as character        no-undo.
     4525       define variable v-position      as integer      no-undo.
     4526       define variable v-current-char  as character    no-undo.
     4527   do
     4528   on error undo, return error
     4529   :
     4530       assign
     4531           p-out-string = "":U
     4532       .
     4533       case p-in-string
     4534       :
     4535           when ?
     4536           then do:
     4537               assign
     4538                   p-out-string = "?":U
     4539               .
     4540           end.
     4541           otherwise do:
     4542               do v-position = 1 to length( p-in-string )
     4543               :
     4544                   assign
     4545                       v-current-char = substring( p-in-string, v-position, 1 )
     4546                   .
     4547                   case v-current-char
     4548                   :
     4549                       when chr(1)
     4550                       then do:
     4551                           assign
     4552                               p-out-string = p-out-string + " ":U
     4553                           .
     4554                       end.
     4555                       when chr(2)
     4556                       then do:
     4557                           assign
     4558                               p-out-string = p-out-string + " ":U
     4559                           .
     4560                       end.
     4561                       when chr(3)
     4562                       then do:
     4563                           assign
     4564                               p-out-string = p-out-string + " ":U
     4565                           .
     4566                       end.
     4567                       when chr(4)
     4568                       then do:
     4569                           assign
     4570                               p-out-string = p-out-string + " ":U
     4571                           .
     4572                       end.
     4573                       when chr(5)
     4574                       then do:
     4575                           assign
     4576                               p-out-string = p-out-string + " ":U
     4577                           .
     4578                       end.
     4579                       when chr(6)
     4580                       then do:
     4581                           assign
     4582                               p-out-string = p-out-string + " ":U
     4583                           .
     4584                       end.
     4585                       when chr(7)
     4586                       then do:
     4587                           assign
     4588                               p-out-string = p-out-string + " ":U
     4589                           .
     4590                       end.
     4591                       when chr(8)
     4592                       then do:
     4593                           assign
     4594                               p-out-string = p-out-string + " ":U
     4595                           .
     4596                       end.
     4597                       when chr(9)
     4598                       then do:
     4599                           assign
     4600                               p-out-string = p-out-string + " ":U
     4601                           .
     4602                       end.
     4603                       when chr(29)
     4604                       then do:
     4605                           assign
     4606                               p-out-string = p-out-string + " ":U
     4607                           .
     4608                       end.
     4609                       when chr(10)
     4610                       then do:
     4611                           assign
     4612                               p-out-string = p-out-string + " ":U
     4613                           .
     4614                       end.
     4615                       when chr(13)
     4616                       then do:
     4617                           assign
     4618                               p-out-string = p-out-string + " ":U
     4619                           .
     4620                       end.
     4621                       otherwise do:
     4622                           assign
     4623                               p-out-string = p-out-string + v-current-char
     4624                           .
     4625                       end.
     4626                   end case.
     4627               end.
     4628           end.
     4629       end case.
     4630   end.
     4631   end .
     4632   procedure xmlchar-decode :
     4633   define input parameter p-in-string      as character        no-undo.
     4634   define output parameter p-out-string    as character        no-undo.
     4635       define variable v-position      as integer      no-undo.
     4636       define variable v-last-position as integer      no-undo.
     4637       define variable v-temp-integer  as integer      no-undo.
     4638       define variable v-current-char  as character    no-undo.
     4639       define variable v-next-char     as character    no-undo.
     4640       define variable v-success       as logical      no-undo.
     4641   do
     4642   on error undo, return error
     4643   :
     4644       assign
     4645           p-out-string = "":U
     4646           v-position   = 0
     4647       .
     4648       replace-cycle:
     4649       do while yes
     4650       on error undo, return error
     4651       :
     4652           assign
     4653               v-last-position = index( p-in-string, "&":U, v-position + 1 )
     4654           .
     4655           if v-last-position <= v-position
     4656           then do:
     4657               if v-position = 0
     4658               then do:
     4659                   assign
     4660                       p-out-string = p-in-string
     4661                   .
     4662               end.
     4663               else do:
     4664                   assign
     4665                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
     4666                   .
     4667               end.
     4668               leave replace-cycle.
     4669           end.
     4670           else do:
     4671               assign
     4672                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
     4673                   v-position      = v-last-position
     4674                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
     4675               .
     4676               if v-current-char = "#":U
     4677               then do:
     4678                   assign
     4679                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
     4680                   .
     4681                   if v-last-position > 0
     4682                   then do:
     4683                       run xmlchar-read-integer in this-procedure
     4684                        (
     4685                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
     4686                           , output v-temp-integer
     4687                           , output v-success
     4688                       ).
     4689                       if v-success = yes
     4690                       and v-temp-integer >= 1
     4691                       and v-temp-integer <= 255
     4692                       then do:
     4693                           assign
     4694                               p-out-string = p-out-string + chr( v-temp-integer )
     4695                               v-position   = v-last-position + 1
     4696                           .
     4697                       end.
     4698                       else do:
     4699                           assign
     4700                               p-out-string = p-out-string + "&":U
     4701                               v-position   = v-position   + 1
     4702                           .
     4703                       end.
     4704                   end.
     4705                   else do:
     4706                       assign
     4707                           p-out-string = p-out-string + "&":U
     4708                           v-position   = v-position   + 1
     4709                       .
     4710                   end.
     4711               end.
     4712               else do:
     4713                   case substring( p-in-string, v-position + 1, 3 )
     4714                   :
     4715                       when "lt;":U
     4716                       then do:
     4717                           assign
     4718                               p-out-string = p-out-string + "<":U
     4719                               v-position   = v-position   + 3
     4720                           .
     4721                       end.
     4722                       when "gt;":U
     4723                       then do:
     4724                           assign
     4725                               p-out-string = p-out-string + ">":U
     4726                               v-position   = v-position   + 3
     4727                           .
     4728                       end.
     4729                       otherwise do:
     4730                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
     4731                           then do:
     4732                               assign
     4733                                   p-out-string = p-out-string + "&":U
     4734                                   v-position   = v-position   + 4
     4735                               .
     4736                           end.
     4737                           else do:
     4738                               case substring( p-in-string, v-position + 1, 5 )
     4739                               :
     4740                                   when "quot;":U
     4741                                   then do:
     4742                                       assign
     4743                                           p-out-string = p-out-string + '"':U
     4744                                           v-position   = v-position   + 5
     4745                                       .
     4746                                   end.
     4747                                   when "apos;":U
     4748                                   then do:
     4749                                       assign
     4750                                           p-out-string = p-out-string + "'":U
     4751                                           v-position   = v-position   + 5
     4752                                       .
     4753                                   end.
     4754                                   otherwise do:
     4755                                       assign
     4756                                           p-out-string = p-out-string + "&":U
     4757                                       .
     4758                                   end.
     4759                               end case.
     4760                           end.
     4761                       end.
     4762                   end case.
     4763               end.
     4764           end.
     4765       end.
     4766   end.
     4767   end .
     4768   procedure xmlchar-read-integer :
     4769   define input parameter p-input-string      as character        no-undo.
     4770   define output parameter p-output-integer   as integer          no-undo.
     4771   define output parameter p-success       as logical          no-undo.
     4772   do
     4773   on error undo, return error
     4774   :
     4775       assign
     4776           p-output-integer = integer( p-input-string )
     4777       no-error.
     4778       if error-status :error
     4779       then do:
     4780           assign
     4781               p-success           = no
     4782               p-output-integer    = 0
     4783           .
     4784       end.
     4785       else do:
     4786           assign
     4787               p-success           = yes
     4788           .
     4789       end.
     4790   end.
     4791   end.
     4792   define variable mMRCCode  as logical    no-undo.
     4793   define variable mTypeMark as character  no-undo.
     4794   function IS-NeedMark returns logical
     4795   ( input ib-code as integer  ,
     4796     input ib-str as character ):
     4797      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
     4798      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
     4799                                    and buf_prod-bc-attr.b-str  eq ib-str
     4800                                    and buf_prod-bc-attr.attr-code eq 'mark':U
     4801        no-lock no-error.
     4802      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
     4803   end.
     4804   function repTegforDm return char
     4805   (iDM as char ):
     4806       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
     4807       define variable vteg as character no-undo.
     4808       define variable oDM as character no-undo.
     4809       define variable vi as integer no-undo.
     4810       oDM = iDm.
     4811       do vi = 1 to num-entries(vTeglist):
     4812          vTeg = entry(vi,vTeglist).
     4813          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
     4814       end.
     4815       return oDM.
     4816   end.
     4817   function repSpecSimbforDm return char
     4818   (iDM as char ):
     4819       define variable oDM as character no-undo.
     4820     run
     4821       xmlchar-decode(iDM, output oDM).
     4822     return repTegforDm (oDM).
     4823   end.
     4824   function CheckGtin return logical
     4825   (iGtin as char):
     4826      define variable bar_code as character no-undo.
     4827      define variable vGtin as logical no-undo init "yes".
     4828      if length(iGtin) eq 14
     4829      then do:
     4830         bar_code = substr (iGtin, 1, length (iGtin) - 1).
     4831         run str/chk-sum.p
     4832          (input-output bar_code ) no-error .
     4833         if iGtin ne  bar_code
     4834         then
     4835            vGtin = no.
     4836      end.
     4837      else
     4838         vGtin = no.
     4839      return vgtin.
     4840   end.
     4841   function repSpecSimbforXlm return char
     4842   (iDM as char ):
     4843       iDM = replace(iDM,chr(29),"").
     4844       return iDM.
     4845   end.
     4846   function getGtinByDM return char
     4847   (IDM as char):
     4848      define variable VTXT as char no-undo.
     4849      define variable vGtin as char no-undo.
     4850      vTXt = IdM.
     4851      vGtin = IDM.
     4852      if    length(vtxt) > 14
     4853      then do:
     4854         if   vtxt begins "(01)"
     4855                or vtxt begins "(02)"
     4856         then
     4857            vGtin = substring(vtxt,5,14).
     4858         else if   (vtxt begins "01"
     4859                or vtxt begins "02" )
     4860                and (   (    substring(iDm,17,2) eq "21"
     4861                         and length(vtxt) >= 21)
     4862                     or substring(iDm,17,2) eq "37"
     4863                     or substring(iDm,17,4) eq "(37)" )
     4864         then do:
     4865            vGtin = substring(vtxt,3,14).
     4866            if not checkGtin(vGtin)
     4867            then
     4868               vGtin = substring(vtxt,1,14).
     4869         end.
     4870         else if     length(vtxt) eq 14 + 7 + 4 + 4
     4871             or length(vtxt) eq 14 + 7 + 4
     4872             or length(vtxt) eq 14 + 7
     4873         then
     4874            vGtin = substring(vtxt,1,14).
     4875      end.
     4876      if not checkGtin(vGtin)
     4877      then
     4878         vGtin = "".
     4879      return vgtin.
     4880   end.
     4881   function getGdsCodeByGtin return int
     4882   (iGtin as char):
     4883      define buffer prod-bc  for ub.prod-bc.
     4884      define buffer bar-code for ub.bar-code.
     4885      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
     4886      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     4887      return if avail bar-code then bar-code.gds-code else ?.
     4888   end.
     4889   function getQntyCodeByGtin return decimal
     4890   (iGtin as char):
     4891      define buffer prod-bc  for ub.prod-bc.
     4892      define buffer bar-code for ub.bar-code.
     4893      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
     4894      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
     4895      return if avail bar-code then bar-code.cli-base-rate else ?.
     4896   end.
     4897   function getGdsCodeByDM return int
     4898   (iDm as char):
     4899      define variable vGtin as char no-undo.
     4900      define buffer prod-bc for ub.prod-bc.
     4901      vGtin  = getGtinByDM (IDM ).
     4902      return getGdsCodeByGtin (vGtin).
     4903   end.
     4904   function ChekTypeMarkByGds return logical
     4905   (iGds-code as integer ):
     4906      define buffer goods-attr for ub.goods-attr.
     4907      find first goods-attr where goods-attr.gds-code   = iGds-code
     4908                              and goods-attr.attr-code  = 'mark-type':U
     4909      no-lock no-error.
     4910      if available goods-attr
     4911      then do:
     4912         mTypeMark = goods-attr.attr-value.
     4913         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
     4914           .
     4915      end.
     4916      else
     4917         return no.
     4918   end.
     4919   function ChekTypeMarkByDm return logical
     4920   (iDM as char ):
     4921      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
     4922   end.
     4923   function ChekTypeMarkByGtin return logical
     4924   (iGtin as char ):
     4925      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
     4926   end.
     4927   function GetNextElement return character
     4928     (input iAllTeg        as logical
     4929     ,output oteg          as character
     4930     ,output otegval       as character
     4931     ,input-output pstr    as character
     4932      ):
     4933        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
     4934        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
     4935        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
     4936        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
     4937        define variable vTeg as character no-undo.
     4938        define variable vLength as integer no-undo.
     4939        define variable vi as integer no-undo.
     4940        define variable vj as integer no-undo.
     4941        define buffer code for ub.code.
     4942        find first code where Code.parent eq "MarkType"
     4943                          and Code.CodeValue   eq mTypeMark
     4944                          no-lock no-error.
     4945        if     available code
     4946           and Code.misc1 ne ""
     4947           and Code.misc1 ne ?
     4948        then do:
     4949           integer (Code.misc1) no-error.
     4950           if not error-status:error
     4951           then
     4952             entry (4,vlistleng) = Code.misc1.
     4953        end.
     4954        if iAllTeg
     4955        then
     4956           assign
     4957              vlistElem     = vlistElem    + vlistElemDop
     4958              vlistleng     = vlistleng    + vlistlengDop
     4959           .
     4960        else if mMRCCode
     4961        then
     4962           assign
     4963              vlistElem     = vlistElem    + ",(8005),8005"
     4964              vlistleng     = vlistleng    + ",000006,0006"
     4965           .
     4966       block-elem:
     4967       do vi = 1 to num-entries(vlistElem):
     4968          vTeg = entry(vi,vlistElem).
     4969          if pstr begins vTeg
     4970          then do:
     4971             if    vTeg eq "21"
     4972             then
     4973                vLength = index(pstr,chr(29)) - 2 no-error.
     4974             if vLength  <= 0
     4975             then
     4976                vLength = int(entry(vi,vlistleng)).
     4977             otegval = substring (pstr,length(vteg) + 1, vLength).
     4978             oteg = replace(replace(vteg,")",""),"(","").
     4979             vTeg = vteg + otegval.
     4980             otegval = replace(otegval,chr(29),"").
     4981             oteg = replace(replace(oteg,")",""),"(","").
     4982             pstr = substring (pstr,length(vTeg)+ 1).
     4983             vTeg = replace(vTeg,chr(29),"").
     4984             leave block-elem.
     4985          end.
     4986          else
     4987             vTeg = "".
     4988       end.
     4989       return vteg.
     4990   end.
     4991   function GetCodeIdent return character
     4992   (iDm as char):
     4993      define variable Velement   as character no-undo init "first".
     4994      define variable oCodeIdent as character no-undo.
     4995      define variable vteg as character no-undo.
     4996      define variable vtegval as character no-undo.
     4997      define variable vGtin as character no-undo.
     4998      define buffer marking for ub.marking.
     4999      for first marking no-lock where
     5000                marking.mark eq iDm
     5001            and marking.unit-ext = "LEVEL2"
     5002      :
     5003        return iDm.
     5004      end.
     5005      vGtin  = getGtinByDM (iDm ).
     5006      ChekTypeMarkByDm(idm).
     5007      if iDm begins 'tech_':U
     5008      then
     5009         oCodeIdent = iDm.
     5010      else if length(iDm) < 21
     5011      then do:
     5012         find first marking where marking.mark eq idm
     5013         no-lock no-error.
     5014         oCodeIdent = if available marking then marking.mark else  ?.
     5015      end.
     5016      else if     length(iDm) eq 29
     5017         and not iDm begins "01"
     5018         and not iDm begins "02"
     5019      then
     5020         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     5021      else  if     length(iDm) >= 24
     5022               and (  iDm begins "01"
     5023                   or iDm begins "02")
     5024               and  substring(iDm,17,2) ne "21"
     5025      then do:
     5026         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     5027                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     5028         then
     5029            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     5030         else
     5031            oCodeIdent = iDM.
     5032      end.
     5033      else  if     (   length(iDm) eq 25
     5034                    or length(iDm) eq 21)
     5035               and (not iDm begins "01"
     5036               and  not iDm begins "02")
     5037      then
     5038         oCodeIdent = substring(iDm,1,21).
     5039      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     5040      then
     5041         oCodeIdent = substring(iDm,1,21).
     5042      else do while Velement ne "" and idm ne "":
     5043         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     5044         oCodeIdent = oCodeIdent + Velement.
     5045      end.
     5046      return oCodeIdent.
     5047   end.
     5048   function GetTegCod return character
     5049   (icodeIdent as char, iTeg as char):
     5050      define variable Velement   as character no-undo init "first".
     5051      define variable oTeg as character no-undo init ?.
     5052      define variable vteg as character no-undo.
     5053      define variable vtegval as character no-undo.
     5054      if     ((length(icodeIdent) eq 21
     5055         and not icodeIdent begins "01"
     5056         and not icodeIdent begins "02")
     5057         or
     5058             ( length(icodeIdent) eq 25
     5059               and not icodeIdent begins "01"
     5060               and not icodeIdent begins "02"))
     5061      then do:
     5062         if iTeg eq "01" or iTeg eq "02"
     5063         then
     5064            oTeg = substring(icodeIdent,1,21).
     5065         else  if  iTeg eq "21"
     5066         then
     5067            oTeg = substring(icodeIdent,15,7).
     5068      end.
     5069      else do:
     5070         ChekTypeMarkByDm(icodeIdent).
     5071         block-teg:
     5072            do while Velement ne "" and icodeIdent ne "":
     5073            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     5074            if    Velement begins iTeg
     5075               or Velement begins "(" + iTeg + ")"
     5076            then do:
     5077               oTeg = vtegval.
     5078               leave block-teg.
     5079            end.
     5080         end.
     5081      end.
     5082      return oTeg.
     5083   end.
     5084   function isOAD return logical
     5085   (icodeIdent as character):
     5086      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     5087   end.
     5088   function isMark return logical
     5089   (icodeIdent as character):
     5090      define buffer buf_marking for ub.marking.
     5091      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     5092             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     5093   end.
     5094   function addBracketForCode return character
     5095   (icodeIdent as char):
     5096      define variable Velement   as character no-undo init "first".
     5097      define variable oTeg as character no-undo.
     5098      define variable vteg as character no-undo.
     5099      define variable vtegval as character no-undo.
     5100      define buffer marking for ub.marking.
     5101      find first marking no-lock where
     5102                 marking.mark begins icodeIdent no-error.
     5103      if    not ChekTypeMarkByDm(icodeIdent)
     5104         or length(icodeIdent) le 24
     5105         or (avail marking and marking.unit-ext = "LEVEL2")
     5106      then
     5107         oTeg = icodeIdent.
     5108      else do:
     5109         if (  icodeIdent begins "01"
     5110            or icodeIdent begins "02"
     5111            ) and CheckGtin(substring (icodeIdent,3,14))
     5112            and substring (icodeIdent,17,2) eq "21"
     5113         then do:
     5114            mMRCCode = yes.
     5115            ChekTypeMarkByDm(icodeIdent).
     5116            block-teg:
     5117            do while Velement ne "" and icodeIdent ne "":
     5118               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     5119               if vteg ne ""
     5120               then
     5121                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     5122            end.
     5123            mMRCCode = no.
     5124         end.
     5125         else do:
     5126            oTeg = icodeIdent.
     5127         end.
     5128      end.
     5129      return oTeg.
     5130   end.
     5131   function getlevelByCodId return int
     5132   (iCode as char):
     5133      define variable vLength as int no-undo.
     5134      define variable vLevel  as int no-undo.
     5135      if not ChekTypeMarkByDM (icode) then return ?.
     5136      vLength = length(iCode).
     5137      if    vLength eq 18
     5138         or vLength eq 20
     5139      then
     5140         Vlevel = 4.
     5141      else if vLength eq 21
     5142      then
     5143         Vlevel = 1.
     5144      else if vLength eq 25
     5145      then do:
     5146         if  iCode begins "01"
     5147         then
     5148            Vlevel = 3.
     5149         else
     5150            Vlevel = 1.
     5151      end.
     5152      else if     vLength >= 26
     5153              and vLength <= 46
     5154      then do:
     5155         if    substring(iCode,17,2) eq "11"
     5156            or substring(iCode,17,2) eq "13"
     5157            or (    substring(iCode,17,2) eq "21"
     5158                and vLength >= 33
     5159                and substring(iCode,26,4) ne "8005")
     5160         then
     5161            Vlevel = 4.
     5162         else if    vLength eq 31
     5163                 or vLength eq 38
     5164                 or vLength eq 39
     5165                 or vLength eq 45
     5166         then
     5167            Vlevel = 1.
     5168         else if    vLength eq 35
     5169                 or vLength eq 43
     5170         then
     5171            Vlevel = 3.
     5172         else
     5173            Vlevel = ?.
     5174      end.
     5175      else
     5176         Vlevel = ?.
     5177      return Vlevel.
     5178   end.
     5179   function getLevelMotpBycodid return character
     5180   (iDm as char):
     5181      define variable vLevel as integer no-undo.
     5182      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     5183      vLevel = getlevelByCodId(iDm).
     5184      if    vLevel eq ?
     5185         or vLevel < 1
     5186         or vLevel > 6
     5187      then
     5188         return ?.
     5189      else
     5190         return entry(vlevel,vList).
     5191   end.
     5192   function getLevelUTDByLevelMotp return character
     5193   (iUnit as char):
     5194      define variable vLevel as integer no-undo.
     5195      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     5196      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     5197      vLevel = lookup(iUnit,vListMOTP).
     5198      if    vLevel eq ?
     5199         or vLevel < 1
     5200         or vLevel > 4
     5201      then
     5202         return ?.
     5203      else
     5204         return entry(vlevel,vListutd).
     5205   end.
     5206   function getLevelMotpByDM return character
     5207   (iDm as char):
     5208      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     5209   end.
     5210   function getLevelUTDByCodId return character
     5211   (iDm as char):
     5212      define variable vLevel as integer no-undo.
     5213      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     5214      vLevel = getlevelByCodId(iDm).
     5215      if    vLevel eq ?
     5216         or vLevel < 1
     5217         or vLevel > 4
     5218      then
     5219         return ?.
     5220      else
     5221         return entry(vlevel,vList).
     5222   end.
     5223   function getLevelUTDByDM return character
     5224   (iDm as char):
     5225      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     5226   end.
     5227   define variable mNotMarkQnty as logical no-undo.
     5228   function getQntyUTDByCodId return decimal
     5229   (iDM as char):
     5230      define variable vLevel as integer no-undo.
     5231      define variable vList as character no-undo init "1,5,10,500".
     5232      define variable vGtin as character no-undo.
     5233      define variable vqnty as decimal no-undo init ?.
     5234      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     5235      if vqnty eq ?
     5236      then do:
     5237         if not mNotMarkQnty
     5238         then do:
     5239            define buffer marking for ub.marking.
     5240            define variable vCodident as character no-undo.
     5241            vCodident = GetCodeIdent(idm).
     5242            find first marking where marking.mark begins vCodident no-lock no-error.
     5243            if     available marking
     5244               and marking.box-qnty ne ?
     5245            then
     5246               return marking.box-qnty.
     5247         end.
     5248         vGtin = getGtinByDm(iDM).
     5249         if ChekTypeMarkByGtin (vGtin)
     5250         then do:
     5251            vLevel = getlevelByCodId(iDM).
     5252            if     vLevel >= 1
     5253               and vLevel <= 4
     5254            then
     5255               vqnty = int(entry(vlevel,vList)).
     5256         end.
     5257         else
     5258            vqnty = getQntyCodeByGtin(vgtin).
     5259      end.
     5260      return vqnty.
     5261   end.
     5262   function getQntyUTDByDM return decimal
     5263   (iDm as char):
     5264      define variable vDM as character no-undo.
     5265      if     length (iDm) ne 25
     5266         and length (iDm) ne 29
     5267         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     5268      then
     5269         vDM = substring (iDm,1,length (iDm) - 6 ).
     5270      else
     5271         vDM = substring (iDm,1,length (iDm) - 4 ).
     5272      return getQntyUTDByCodId(vDM).
     5273   end.
     5274   function getMRC4 return decimal
     5275   (iMRC as char):
     5276      define variable oMrc     as decimal no-undo init ?.
     5277      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     5278      define variable vi       as integer no-undo.
     5279      define variable vfound   as integer no-undo.
     5280      define variable vposStart   as integer no-undo.
     5281      do:
     5282      OMRc = 0.
     5283      do vi = 1 to 4:
     5284         define variable vsimb as character no-undo.
     5285         vsimb = substring(iMRC,vi,1).
     5286         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     5287         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     5288         if vfound > 0
     5289         then
     5290            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     5291         end.
     5292         OMRc = OMRc / 100.
     5293      end.
     5294      return OMRc.
     5295   end.
     5296   function getMRCByDM return decimal
     5297   (iDm as char):
     5298      define variable vMRC     as character no-undo.
     5299      define variable oMrc     as decimal no-undo init ?.
     5300      define variable Velement as character no-undo init "empty".
     5301      define variable vteg as character no-undo.
     5302      define variable vtegval as character no-undo.
     5303      if    length(idm) eq 14 + 7 + 4 + 4
     5304         or length(idm) eq 14 + 7 + 4
     5305      then do:
     5306         vMRC = substring(idm,22,4).
     5307         omrc = getMRC4(vMRC).
     5308      end.
     5309      else do:
     5310          ChekTypeMarkByDm(iDm).
     5311          block-mrc:
     5312          do while Velement ne "" and idm ne "":
     5313             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     5314             if Velement begins "8005"
     5315             then do:
     5316                vMRC = substring(Velement,5,6).
     5317                leave block-mrc.
     5318             end.
     5319             else if Velement begins "(8005)"
     5320             then do:
     5321                vMRC = substring(Velement,7,6).
     5322                leave block-mrc.
     5323             end.
     5324          end.
     5325          if vMRC ne ""
     5326          then
     5327             OMRc = dec(vmrc) / 100 no-error.
     5328      end.
     5329      return OMRc.
     5330   end.
     5331   function MoveDate return Date
     5332   (idate as date,
     5333    iMonth as int64):
     5334      define variable vMonth   as int64 no-undo.
     5335      define variable vYear    as int64 no-undo.
     5336      define variable vDateNew as date  no-undo.
     5337       define variable vDay     as int64 no-undo.
     5338       vMonth = month(iDate) + iMonth.
     5339       vYear =  year(iDate).
     5340       if vMonth <= 0
     5341       then assign
     5342          vMonth = vMonth + 12
     5343           vYear  = vYear - 1
     5344       .
     5345       else if vMonth > 12
     5346       then assign
     5347          vMonth = vMonth - 12
     5348           vYear  = vYear + 1
     5349       .
     5350       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     5351       do while error-status:error eq yes:
     5352          VDay = vDay + 1.
     5353          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     5354       end.
     5355       if VDay > 0
     5356       then
     5357          vDateNew + 1.
     5358       return vDateNew.
     5359   end.
     5360   procedure checkEMRC:
     5361   define input  parameter iDm as character no-undo.
     5362   define output parameter vok as logical   no-undo init yes.
     5363      define variable v-value-emrc as character no-undo.
     5364      define variable v-type-emrc  as character no-undo.
     5365      define variable vDateIso     as character no-undo.
     5366      define variable vMRC         as decimal no-undo.
     5367      define variable vqnty        as decimal no-undo.
     5368      define variable vPrice       as decimal no-undo.
     5369      define variable vparent      as character no-undo.
     5370      define variable vgds-code    as integer no-undo.
     5371      define buffer code for ub.code.
     5372      vMRC = getMRCByDM(iDm).
     5373      if vMRC > 0
     5374      then do:
     5375         vgds-code = getGdsCodeByDM(iDm).
     5376         vqnty     = getQntyUTDByDM(iDm).
     5377               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     5378            (
     5379             input   vgds-code
     5380            ,input   'emrc-type':U
     5381            ,output   v-value-emrc
     5382            ,output   v-type-emrc
     5383          ) no-error.
     5384          if     v-value-emrc ne ""
     5385             and v-value-emrc ne ?
     5386          then do:
     5387             vDateIso = iso-date(today).
     5388             vPrice = vMRC / vqnty.
     5389             vparent ="emc" + chr(4) + v-value-emrc.
     5390             find last code where Code.parent      eq vparent
     5391                              and Code.code        le vDateIso
     5392                              and code.status_  eq 0
     5393             no-lock no-error.
     5394             if not available code or ( vPrice  >= dec(Code.CodeValue))
     5395             then
     5396                vOk = true .
     5397             else do:
     5398                 define variable vText      as character no-undo.
     5399                 define variable vDate      as date no-undo.
     5400                 define variable vDateLast  as character no-undo.
     5401                 define variable vDateFirst as character no-undo.
     5402                 define variable vDate3     as date no-undo.
     5403                 vdate = date(code.misc1).
     5404                 vDateLast = code.misc1.
     5405                 vDate3 = MoveDate(today, - 3 ).
     5406                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     5407                                      string(vDate3  , "99/99/9999"),
     5408                                      string(vDate   , "99/99/9999")
     5409                                      ).
     5410                 vdateIso = iso-date(vdate3).
     5411                 find last code  where Code.parent      eq vparent
     5412                                   and Code.code        le vDateIso
     5413                                   and code.status_  eq 0 no-lock no-error.
     5414                 if available code
     5415                 then
     5416                    vDateIso = code.code.
     5417                 vDateFirst = vDateIso.
     5418                 vDateLast = iso-date(vdate).
     5419                 define variable vGood as logical no-undo.
     5420                 define variable vDateSale as date no-undo.
     5421                 define buffer bcode for code.
     5422                 for last code where Code.parent   eq vparent
     5423                                 and code.status_  eq 0
     5424                                 and code.code     < vDateLast
     5425                                 and code.code     >= vDateFirst
     5426                 no-lock:
     5427                    find first bcode where bCode.parent   eq vparent
     5428                                       and bcode.status_  eq 0
     5429                                       and bcode.code     > code.code no-lock no-error.
     5430                    if available bcode
     5431                    then do:
     5432                       if vPrice < dec(Code.CodeValue)
     5433                       then
     5434                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     5435                                                     chr(10),
     5436                                                     string(    date( code.misc1)       ,"99/99/9999"),
     5437                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     5438                                                     ).
     5439                       else do:
     5440                          vGood = yes.
     5441                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     5442                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     5443                                                     chr(10),
     5444                                                     string(    date( code.misc1)         ,"99/99/9999"),
     5445                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     5446                                                     string(         vDateSale            ,"99/99/9999"),
     5447                                                     string(vDateSale - today)
     5448                                                     ).
     5449                       end.
     5450                    end.
     5451                 end.
     5452                 if vgood
     5453                 then do:
     5454                    define variable choice as integer no-undo .
     5455                    run gbl/d-askw.w (input "Уточнение"
     5456                           ,input  vText
     5457                           ,input "|"
     5458                           ,input "Принять|Вернуть"
     5459                           ,input "Принять данный товар|Вернуть товар постащику"
     5460                           ,input 1
     5461                           ,input 2
     5462                           ,output choice) no-error.
     5463                    vok = choice eq 1.
     5464                 end.
     5465                 else
     5466                    vok =false.
     5467             end.
     5468          end.
     5469      end.
     5470   end.
     5471   function addGs2Mark return character
     5472   (iMark as char):
     5473      define variable vDM   as character no-undo.
     5474      define variable vIdx  as integer   no-undo.
     5475      if index(iMark,chr(29),1) > 0
     5476      then return iMark.
     5477      if substring(iMark,26,4) = "8005" then
     5478      do:
     5479        vIdx = index(iMark,"93",26 + 4 + 5).
     5480        if vIdx > 1 then do:
     5481          vDM = substitute("&1&4&2&4&3",
     5482                           substring(iMark,1,25),
     5483                           substring(iMark,26,vIdx - 25 - 1),
     5484                           substring(iMark,vIdx),
     5485                           chr(29)) no-error.
     5486          vIdx = index(vDm,"240",vIdx + 4).
     5487          if vIdx > 0 then
     5488          do:
     5489            vDM = substitute("&1&3&2",
     5490                             substring(vDm,1,vIdx - 1),
     5491                             substring(vDm,vIdx),
     5492                             chr(29)) no-error.
     5493          end.
     5494        end.
     5495        else
     5496          vDM = substitute("&1&3&2",
     5497                           substring(iMark,1,25),
     5498                           substring(iMark,26),
     5499                           chr(29)) no-error.
     5500      end.
     5501      else if substring(iMark,32,2) = "91" then
     5502      do:
     5503        vIdx = index(iMark,"92",32).
     5504        if vIdx > 1 then
     5505          vDM = substitute("&1&4&2&4&3",
     5506                           substring(iMark,1,31),
     5507                           substring(iMark,32,vIdx - 31 - 1),
     5508                           substring(iMark,vIdx),
     5509                           chr(29)) no-error.
     5510        else
     5511          vDM = substitute("&1&3&2",
     5512                           substring(iMark,1,31),
     5513                           substring(iMark,32),
     5514                           chr(29)) no-error.
     5515      end.
     5516      else if substring(iMark,39,2) = "91" then
     5517      do:
     5518        vIdx = index(iMark,"92",38).
     5519        if vIdx > 1 then
     5520          vDM = substitute("&1&4&2&4&3",
     5521                           substring(iMark,1,38),
     5522                           substring(iMark,39,vIdx - 38 - 1),
     5523                           substring(iMark,vIdx),
     5524                           chr(29)) no-error.
     5525        else
     5526          vDM = substitute("&1&3&2",
     5527                           substring(iMark,1,38),
     5528                           substring(iMark,39),
     5529                           chr(29)) no-error.
     5530      end.
     5531      else if substring(iMark,25,2) = "93" then
     5532      do:
     5533        vIdx = index(iMark,"92",25).
     5534        if vIdx > 1 then
     5535          vDM = substitute("&1&4&2&4&3",
     5536                           substring(iMark,1,24),
     5537                           substring(iMark,25,vIdx - 24 - 1),
     5538                           substring(iMark,vIdx),
     5539                           chr(29)) no-error.
     5540        else
     5541          vIdx = index(iMark,"3103",25).
     5542          if vIdx > 0 then
     5543          vDM = substitute("&1&4&2&4&3",
     5544                           substring(iMark,1,24),
     5545                           substring(iMark,25,vIdx - 24 - 1),
     5546                           substring(iMark,vIdx),
     5547                           chr(29)) no-error.
     5548          else
     5549            vDM = substitute("&1&3&2",
     5550                             substring(iMark,1,24),
     5551                             substring(iMark,25),
     5552                             chr(29)) no-error.
     5553      end.
     5554      else if substring(iMark,32,2) = "93" then
     5555      do:
     5556        vDM = substitute("&1&3&2",
     5557              substring(iMark,1,31),
     5558              substring(iMark,32),
     5559              chr(29)) no-error.
     5560      end.
     5561      return if vDM <> "" then vDm else iMark.
     5562   end.
     5563   def var vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5564   procedure gen-key-rec :
     5565     define input  parameter p-tbl-name    as character no-undo.
     5566     define input  parameter p-bh_tbl-name as handle    no-undo.
     5567     define output parameter p-key-rec     as character no-undo.
     5568     do
     5569     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5570     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     5571     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     5572     :
     5573       define variable fh               as handle    no-undo .
     5574       define variable v-ok             as logical   no-undo .
     5575       define variable v-inform         as character no-undo .
     5576       define variable v-ind            as integer   no-undo .
     5577       define variable v-idx-field-qnty as integer   no-undo .
     5578       if p-tbl-name = ?
     5579         or p-tbl-name = "":U
     5580       then do:
     5581         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info34 ).
     5582       end.
     5583       if not p-bh_tbl-name:available then do:
     5584         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info34, p-tbl-name ).
     5585       end.
     5586       assign
     5587         p-key-rec = p-tbl-name
     5588         v-inform  = p-bh_tbl-name:index-information(1)
     5589         v-ind     = 2
     5590       .
     5591       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     5592       on error undo, return error
     5593       :
     5594         assign
     5595           v-inform = p-bh_tbl-name:index-information( v-ind )
     5596           v-ind    = v-ind + 1
     5597         .
     5598       end.
     5599       if v-inform = ?
     5600         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     5601         or entry( 3, v-inform, ",":U ) <> "1":U
     5602       then do:
     5603         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info34, p-tbl-name ).
     5604       end.
     5605       else do:
     5606         assign
     5607           v-idx-field-qnty = num-entries( v-inform ) - 4
     5608         .
     5609         if v-idx-field-qnty < 2 then do:
     5610           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info34, v-inform, p-tbl-name ).
     5611         end.
     5612         do v-ind = 1 to v-idx-field-qnty by 2
     5613         on error undo, return error
     5614         :
     5615           assign
     5616             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     5617             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     5618           .
     5619         end.
     5620       end.
     5621       if p-key-rec = ? then do:
     5622         assign
     5623           p-key-rec = "":U
     5624         .
     5625         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info34, p-tbl-name ).
     5626       end.
     5627     end.
     5628     return.
     5629   end procedure.
     5630   procedure gen-where-keyr-tab :
     5631     define input  parameter i-tableSerach as character no-undo.
     5632     define input  parameter i-tablekey   as character  no-undo.
     5633     define input  parameter p-key-rec    as character  no-undo.
     5634     define input  parameter p-key-handle as handle     no-undo .
     5635     define input  parameter p-db-name    as character  no-undo .
     5636     define input  parameter p-tt-handle  as handle     no-undo .
     5637     define output parameter o-Where      as character  no-undo.
     5638     do
     5639     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5640     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     5641     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     5642     :
     5643       define variable v-full-tbl-name  as character no-undo .
     5644       define variable bh_tbl-name      as handle    no-undo .
     5645       define variable fh_key           as handle    no-undo .
     5646       define variable fh_search        as handle    no-undo .
     5647       define variable v-field-num      as integer   no-undo .
     5648       define variable v-count-fld      as integer   no-undo .
     5649       define variable v-inform         as character no-undo .
     5650       define variable v-ind            as integer   no-undo .
     5651       define variable v-idx-field-qnty as integer   no-undo .
     5652       define variable v-field-name     as character no-undo .
     5653       define variable v-field-val      as character no-undo .
     5654       define variable v-word-link      as character no-undo .
     5655       define variable vTable           as character no-undo.
     5656       define variable bh_tbl-key       as handle    no-undo .
     5657       assign
     5658         p-key-rec = trim( p-key-rec )
     5659       .
     5660       if p-key-handle <> ? then do:
     5661         if not valid-handle(p-key-handle)
     5662            or p-key-handle:type <> "buffer"
     5663         then do:
     5664           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info34 ).
     5665         end.
     5666         if num-entries( p-key-rec, chr(3) ) > 1
     5667           or p-key-rec = ?
     5668           or p-key-rec = "":U
     5669         then do:
     5670           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info34, p-key-rec ).
     5671         end.
     5672       end.
     5673       else do:
     5674         if p-key-rec = ?
     5675           or p-key-rec = "":U
     5676         then do:
     5677           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info34 ).
     5678         end.
     5679       end.
     5680       assign
     5681         vTable = entry( 1 , p-key-rec, chr(3) )
     5682       .
     5683       if p-tt-handle <> ?
     5684         and ( not valid-handle(p-tt-handle)
     5685               or p-tt-handle:type <> "buffer"
     5686             )
     5687       then do:
     5688         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info34, vTable, chr(10) ).
     5689       end.
     5690       if p-tt-handle = ? then do:
     5691         assign
     5692           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     5693         .
     5694         create buffer bh_tbl-name for table v-full-tbl-name .
     5695       end.
     5696       else do:
     5697         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     5698       end.
     5699       assign
     5700         v-inform = bh_tbl-name:index-information(1)
     5701         v-ind    = 2
     5702       .
     5703       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     5704       on error undo, return error
     5705       :
     5706         assign
     5707           v-inform = bh_tbl-name:index-information( v-ind )
     5708           v-ind    = v-ind + 1
     5709         .
     5710       end.
     5711       if v-inform = ?
     5712         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     5713         or entry( 3, v-inform, ",":U ) <> "1":U
     5714       then do:
     5715         delete object bh_tbl-name no-error.
     5716         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info34, vTable ).
     5717       end.
     5718       assign
     5719         v-idx-field-qnty = num-entries( v-inform ) - 4
     5720       .
     5721       if v-idx-field-qnty < 2 then do:
     5722         delete object bh_tbl-name no-error.
     5723         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info34, v-inform, vTable ).
     5724       end.
     5725       assign
     5726         o-where     = "where":U
     5727         v-word-link = "":U
     5728         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     5729         v-count-fld = 0
     5730       .
     5731       if i-tablekey ne "" and i-tablekey ne ?
     5732       then do:
     5733         assign
     5734           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     5735         .
     5736         create buffer bh_tbl-key for table v-full-tbl-name .
     5737       end.
     5738       if i-tableSerach ne "" and i-tableSerach ne ?
     5739       then do:
     5740         delete object bh_tbl-name no-error.
     5741         assign
     5742           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     5743         .
     5744         create buffer bh_tbl-name for table v-full-tbl-name .
     5745       end.
     5746       block_where:
     5747       do v-ind = 1 to v-idx-field-qnty by 2
     5748       on error undo, return error
     5749       :
     5750         assign
     5751           v-count-fld = v-count-fld + 1
     5752         .
     5753         if p-key-handle = ?
     5754           and v-count-fld > v-field-num
     5755         then do:
     5756           leave block_where.
     5757         end.
     5758         define variable VfieldKeyTable as handle no-undo.
     5759         assign
     5760           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     5761           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     5762         .
     5763         if     bh_tbl-key ne ?
     5764         then do:
     5765            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     5766            if VfieldKeyTable eq ?
     5767            then next block_where.
     5768         end.
     5769         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     5770         then
     5771            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     5772         else
     5773            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     5774         if p-key-handle = ? then do:
     5775           assign
     5776             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     5777           .
     5778         end.
     5779         else do:
     5780           assign
     5781             fh_key = p-key-handle:buffer-field( v-field-name )
     5782           .
     5783           if fh_key = ?
     5784             or not valid-handle( fh_key )
     5785           then do:
     5786             delete object bh_tbl-name.
     5787             if     bh_tbl-key ne ?
     5788             then
     5789                delete object bh_tbl-key.
     5790             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info34, p-key-handle:name, v-field-name ).
     5791           end.
     5792           assign
     5793             v-field-val = fh_key:buffer-value
     5794           .
     5795         end.
     5796         if fh_search:data-type ="character":U then do:
     5797           assign
     5798             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     5799             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     5800             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     5801             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     5802             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     5803             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     5804             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     5805             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     5806             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     5807             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     5808             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     5809             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     5810             v-field-val = substitute( '"&1"', v-field-val )
     5811           .
     5812         end.
     5813         assign
     5814           o-where = substitute( "&1 &2", o-where, v-field-val )
     5815         .
     5816         if v-word-link = "":U then do:
     5817           assign
     5818             v-word-link = "and":U
     5819           .
     5820         end.
     5821       end.
     5822       delete object bh_tbl-name.
     5823       if     bh_tbl-key ne ?
     5824       then
     5825          delete object bh_tbl-key.
     5826       if p-key-handle = ?
     5827         and v-count-fld <> v-field-num
     5828       then do:
     5829         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info34, vTable ).
     5830       end.
     5831     end.
     5832   end procedure.
     5833   procedure gen-hn-keyr-tab :
     5834     define input  parameter i-tableSerach as character no-undo.
     5835     define input  parameter i-tablekey   as character no-undo.
     5836     define input  parameter p-key-rec    as character no-undo.
     5837     define input  parameter p-key-handle as handle    no-undo .
     5838     define input  parameter p-db-name    as character no-undo .
     5839     define input  parameter p-tt-handle  as handle    no-undo .
     5840     define input  parameter p-stts-lock  as integer   no-undo .
     5841     define output parameter o-hn         as handle    no-undo.
     5842     define variable v-full-tbl-name as character no-undo.
     5843     define variable v-where         as character no-undo.
     5844     define variable bh_tbl-name     as handle    no-undo.
     5845     define variable vTable          as character no-undo.
     5846     do
     5847     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5848     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     5849     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     5850         run gen-where-keyr-tab(i-tableSerach,
     5851                                i-tablekey,
     5852                                p-key-rec,
     5853                                p-key-handle,
     5854                                p-db-name,
     5855                                p-tt-handle,
     5856                                output v-where).
     5857         if i-tableSerach ne "" and i-tableSerach ne ?
     5858         then do:
     5859            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     5860            create buffer bh_tbl-name for table v-full-tbl-name .
     5861         end.
     5862         else do:
     5863            if p-tt-handle = ? then do:
     5864               assign
     5865                  vTable = entry( 1 , p-key-rec, chr(3) )
     5866               .
     5867               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     5868               create buffer bh_tbl-name for table v-full-tbl-name .
     5869            end.
     5870            else do:
     5871               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     5872            end.
     5873         end.
     5874         if p-tt-handle = ? then do:
     5875            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     5876         end.
     5877         else do:
     5878            bh_tbl-name:find-first( v-where ) no-error .
     5879         end.
     5880         o-hn = bh_tbl-name.
     5881      end.
     5882   end procedure.
     5883   procedure gen-hn-keyr :
     5884     define input  parameter p-key-rec    as character no-undo.
     5885     define input  parameter p-key-handle as handle    no-undo .
     5886     define input  parameter p-db-name    as character no-undo .
     5887     define input  parameter p-tt-handle  as handle    no-undo .
     5888     define input  parameter p-stts-lock  as integer   no-undo .
     5889     define output parameter o-hn         as handle    no-undo.
     5890     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     5891   end.
     5892   procedure gen-row-keyr :
     5893     define input  parameter p-key-rec    as character no-undo.
     5894     define input  parameter p-key-handle as handle    no-undo .
     5895     define input  parameter p-db-name    as character no-undo .
     5896     define input  parameter p-tt-handle  as handle    no-undo .
     5897     define input  parameter p-stts-lock  as integer   no-undo .
     5898     define output parameter p-tbl-row    as rowid     no-undo.
     5899     define output parameter p-tbl-name   as character no-undo.
     5900     define variable vHn as handle no-undo.
     5901       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     5902       p-tbl-row = if vHn:available then vHn:rowid else ?.
     5903       p-tbl-name =  vHn:table.
     5904       delete object vHn no-error.
     5905     if p-tbl-row = ? then do:
     5906       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info34, p-tbl-name, p-key-rec ).
     5907     end.
     5908     else do:
     5909       return.
     5910     end.
     5911   end procedure.
     5912   procedure gen-key-fv :
     5913     define input  parameter p-key-rec    as character no-undo .
     5914     define output parameter p-field-list as character no-undo .
     5915     define output parameter p-value-list as character no-undo.
     5916     do
     5917     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5918     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     5919     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     5920     :
     5921       define variable v-full-tbl-name  as character no-undo .
     5922       define variable bh_tbl-name      as handle    no-undo .
     5923       define variable v-tbl-name       as character no-undo .
     5924       define variable v-field-num      as integer   no-undo .
     5925       define variable v-count-fld      as integer   no-undo .
     5926       define variable v-inform         as character no-undo .
     5927       define variable v-ind            as integer   no-undo .
     5928       define variable v-idx-field-qnty as integer   no-undo .
     5929       define variable v-delim-key      as character no-undo .
     5930       if p-key-rec = ?
     5931         or p-key-rec = "":U
     5932       then do:
     5933         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info34 ).
     5934       end.
     5935       assign
     5936         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     5937         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     5938       .
     5939       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     5940       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info34 ).
     5941       assign
     5942         v-inform = bh_tbl-name:index-information(1)
     5943         v-ind    = 2
     5944       .
     5945       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     5946       on error undo, return error
     5947       :
     5948         assign
     5949           v-inform = bh_tbl-name:index-information( v-ind )
     5950           v-ind    = v-ind + 1
     5951         .
     5952       end.
     5953       if v-inform = ?
     5954         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     5955         or entry( 3, v-inform, ",":U ) <> "1":U
     5956       then do:
     5957         delete object bh_tbl-name no-error.
     5958         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info34, v-tbl-name ).
     5959       end.
     5960       assign
     5961         v-idx-field-qnty = num-entries( v-inform ) - 4
     5962       .
     5963       if v-idx-field-qnty < 2 then do:
     5964         delete object bh_tbl-name no-error.
     5965         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info34, v-inform, v-tbl-name ).
     5966       end.
     5967       assign
     5968         p-field-list = "":U
     5969         p-value-list = "":U
     5970         v-delim-key  = "":U
     5971         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     5972         v-count-fld  = 0
     5973       .
     5974       block_where:
     5975       do v-ind = 1 to v-idx-field-qnty by 2
     5976       on error undo, return error
     5977       :
     5978         assign
     5979           v-count-fld = v-count-fld + 1
     5980         .
     5981         if v-count-fld > v-field-num then do:
     5982           leave block_where.
     5983         end.
     5984         assign
     5985           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     5986           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     5987         .
     5988         if v-ind = 1 then do:
     5989           assign
     5990             v-delim-key = chr(3)
     5991           .
     5992         end.
     5993       end.
     5994       delete object bh_tbl-name.
     5995       if v-count-fld <> v-field-num then do:
     5996         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info34, v-tbl-name ).
     5997       end.
     5998     end.
     5999   end procedure.
     6000   procedure gen-key-field :
     6001     define input  parameter p-table      as character no-undo .
     6002     define output parameter p-field-list as character no-undo .
     6003     do
     6004     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     6005     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     6006     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     6007     :
     6008       define variable v-full-tbl-name  as character no-undo .
     6009       define variable bh_tbl-name      as handle    no-undo .
     6010       define variable v-tbl-name       as character no-undo .
     6011       define variable v-field-num      as integer   no-undo .
     6012       define variable v-count-fld      as integer   no-undo .
     6013       define variable v-inform         as character no-undo .
     6014       define variable v-ind            as integer   no-undo .
     6015       define variable v-idx-field-qnty as integer   no-undo .
     6016       define variable v-delim-key      as character no-undo .
     6017       if p-table = ?
     6018         or p-table = "":U
     6019       then do:
     6020         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info34 ).
     6021       end.
     6022       assign
     6023         v-tbl-name      = p-table
     6024         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     6025       .
     6026       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     6027       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info34 ).
     6028       assign
     6029         v-inform = bh_tbl-name:index-information(1)
     6030         v-ind    = 2
     6031       .
     6032       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     6033       on error undo, return error
     6034       :
     6035         assign
     6036           v-inform = bh_tbl-name:index-information( v-ind )
     6037           v-ind    = v-ind + 1
     6038         .
     6039       end.
     6040       if v-inform = ?
     6041         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     6042         or entry( 3, v-inform, ",":U ) <> "1":U
     6043       then do:
     6044         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info34, v-tbl-name ).
     6045       end.
     6046       assign
     6047         v-idx-field-qnty = num-entries( v-inform ) - 4
     6048       .
     6049       if v-idx-field-qnty < 2 then do:
     6050         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info34, v-inform, v-tbl-name ).
     6051       end.
     6052       assign
     6053         p-field-list = "":U
     6054         v-delim-key  = "":U
     6055         v-count-fld  = 0
     6056       .
     6057       block_where:
     6058       do v-ind = 1 to v-idx-field-qnty by 2
     6059       on error undo, return error
     6060       :
     6061         assign
     6062           v-count-fld = v-count-fld + 1
     6063         .
     6064         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     6065         if v-ind = 1 then do:
     6066           assign
     6067             v-delim-key = chr(3)
     6068           .
     6069         end.
     6070       end.
     6071       delete object bh_tbl-name.
     6072     end.
     6073   end procedure.
     6074   function AddUtdErrForTab returns logical
     6075   (idb-num         as integer ,
     6076    idoc-id         as integer ,
     6077    iTab            as character,
     6078    iObj            as handle ,
     6079    iCheckType      as character,
     6080    iCodeErr        as character,
     6081    iCheckObj       as character ):
     6082      define buffer utd-err for utd-err.
     6083      define buffer utd for utd.
     6084      find first utd where utd.db-num     eq idb-num
     6085                       and utd.doc-id     eq idoc-id
     6086                       and utd.Direction  eq 'Outbound'
     6087      no-lock no-error.
     6088      if available utd
     6089      then
     6090         return no.
     6091      define variable vRecKey as character no-undo.
     6092            run gen-key-rec (input iTab,
     6093                             input  iObj,
     6094                             output vRecKey).
     6095      find first utd-err where utd-err.db-num     eq idb-num
     6096                           and utd-err.doc-id     eq idoc-id
     6097                           and utd-err.CheckType  eq iCheckType
     6098                           and utd-err.CodeErr    eq iCodeErr
     6099                           and utd-err.CheckObj   eq iCheckObj
     6100      exclusive-lock no-error.
     6101      if not available utd-err
     6102      then do:
     6103         create utd-err.
     6104         assign
     6105            utd-err.db-num         = idb-num
     6106            utd-err.doc-id         = idoc-id
     6107            utd-err.CheckType      = iCheckType
     6108            utd-err.CodeErr        = iCodeErr
     6109            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     6110            utd-err.reckey         = vRecKey
     6111            utd-err.qnty           = 1
     6112         .
     6113      end.
     6114      else
     6115         utd-err.qnty = utd-err.qnty + 1.
     6116      return utd-err.qnty eq 1.
     6117   end.
     6118   function AddUtdErr returns logical
     6119   (idb-num         as integer ,
     6120    idoc-id         as integer ,
     6121    iObj            as handle ,
     6122    iCheckType      as character,
     6123    iCodeErr        as character,
     6124    iCheckObj       as character ):
     6125      AddUtdErrForTab
     6126         (idb-num,
     6127          idoc-id,
     6128          iObj:table,
     6129          iObj,
     6130          iCheckType,
     6131          iCodeErr,
     6132          iCheckObj).
     6133   end.
     6134   function ClearUtdErrTypeCode returns logical
     6135   (idb-num         as integer,
     6136    idoc-id         as integer ,
     6137    iCheckType      as character,
     6138    iCodeErr        as character
     6139    ):
     6140      define buffer utd-err for utd-err.
     6141      if    iCheckType eq "*"
     6142         or iCheckType eq ?
     6143      then do:
     6144         if     iCodeErr ne ?
     6145            and iCodeErr ne "*"
     6146         then
     6147            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     6148            view-as alert-box.
     6149         else
     6150         for each utd-err where utd-err.db-num  eq idb-num
     6151                            and utd-err.doc-id  eq idoc-id
     6152         exclusive-lock:
     6153            delete utd-err.
     6154         end.
     6155      end.
     6156      else do:
     6157         if    iCodeErr eq ?
     6158            or iCodeErr eq "*"
     6159         then do:
     6160            for each utd-err where utd-err.db-num     eq idb-num
     6161                               and utd-err.doc-id     eq idoc-id
     6162                               and utd-err.CheckType  eq iCheckType
     6163            exclusive-lock:
     6164               delete utd-err.
     6165            end.
     6166         end.
     6167         else do:
     6168            for each utd-err where utd-err.db-num     eq idb-num
     6169                               and utd-err.doc-id     eq idoc-id
     6170                               and utd-err.CheckType  eq iCheckType
     6171                               and ub.utd-err.CodeErr eq iCodeErr
     6172            exclusive-lock:
     6173               delete utd-err.
     6174            end.
     6175         end.
     6176      end.
     6177   end.
     6178   function ClearUtdErr returns logical
     6179   (idb-num         as integer,
     6180    idoc-id         as integer ,
     6181    iCheckType      as character
     6182    ):
     6183      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     6184   end.
     6185   function GetMesError returns character
     6186   (itxt as character,
     6187    iobj as character ):
     6188    define variable vi as integer no-undo.
     6189    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     6190       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     6191    end.
     6192    return itxt.
     6193   end.
     6194   function GetTextErrorType returns character
     6195   (iCheckType as character,
     6196    iCodeErr   as character,
     6197    iChechObj  as character,
     6198    iType      as character  ):
     6199      define buffer code    for code.
     6200      define variable vError as character no-undo.
     6201      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     6202                        and code.code   eq iCodeErr
     6203      no-lock no-error.
     6204      if available code
     6205      then do:
     6206         define variable vType as integer no-undo.
     6207         if code.misc3 eq "error"
     6208         then
     6209            vType = 0.
     6210         else if code.misc3 eq "warning"
     6211         then
     6212            vType = 1.
     6213         else if code.misc3 eq "Hiden"
     6214         then
     6215            vType = 2.
     6216         else
     6217            vtype = int(code.misc3) no-error.
     6218         case itype:
     6219            when "error"
     6220            then do:
     6221               if vtype eq 0
     6222               then
     6223                  vError = GetMesError(Code.CodeValue,iChechObj).
     6224            end.
     6225            when "warning"
     6226            then do:
     6227               if vtype <= 1
     6228               then
     6229                  vError = GetMesError(Code.CodeValue,iChechObj).
     6230            end.
     6231            otherwise do:
     6232               vError = GetMesError(Code.CodeValue,iChechObj).
     6233            end.
     6234         end.
     6235      end.
     6236      else
     6237         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     6238      return vError.
     6239   end.
     6240   function GetTypeError returns integer
     6241   (iCheckType as character,
     6242    iCodeErr   as character):
     6243      define buffer code    for code.
     6244      define variable vType as integer no-undo.
     6245      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     6246                        and code.code   eq iCodeErr
     6247      no-lock no-error.
     6248      if     not available code
     6249         and code.misc3 eq "error"
     6250      then
     6251         vType = 0.
     6252      else if code.misc3 eq "warning"
     6253      then
     6254         vType = 1.
     6255      else if code.misc3 eq "Hiden"
     6256      then
     6257         vType = 2.
     6258      else
     6259         vtype = int(code.misc3) no-error.
     6260      return vtype.
     6261   end.
     6262   function GetTextError returns character
     6263   (iCheckType as character,
     6264    iCodeErr   as character,
     6265    iChechObj  as character ):
     6266      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     6267   end.
     6268   function GetErrForUtdStr returns character
     6269   (idb-num     as integer ,
     6270    idoc-id     as integer ,
     6271    iCheckType  as character
     6272    ):
     6273      define buffer utd-err for utd-err.
     6274      define buffer code    for code.
     6275      define variable vHQry as handle no-undo.
     6276      define variable vError as longchar no-undo.
     6277      define variable vErrorOne as longchar  no-undo.
     6278      define variable oError as character no-undo.
     6279      create query vHQry.
     6280      vHQry:set-buffers(buffer utd-err:handle).
     6281      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     6282                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     6283                               + if    iCheckType eq "*"
     6284                                    or iCheckType eq ?
     6285                                 then       ""
     6286                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     6287      vHQry:query-open().
     6288      vHQry:get-first().
     6289      QRY-BLOCK:
     6290      repeat while not vHQry:query-off-end:
     6291         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     6292         if     vErrorOne ne ""
     6293            and vErrorOne ne ?
     6294         then
     6295            vError = vError + ", " + vErrorOne.
     6296         vHQry:get-next().
     6297      end.
     6298      oError = substring(vError,3,4002).
     6299      return oError.
     6300   end.
     6301   function GetErrJsonForUtd returns character
     6302   (idb-num         as integer ,
     6303    idoc-id         as integer ,
     6304    iCheckType      as character
     6305    ):
     6306      define buffer utd-err for utd-err.
     6307      define variable vHQry as handle no-undo.
     6308      define variable vError as longchar no-undo.
     6309      define variable oError as character no-undo.
     6310      create query vHQry.
     6311      define variable vi as integer no-undo.
     6312      vHQry:set-buffers(buffer utd-err:handle).
     6313      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     6314                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     6315                               + if    iCheckType eq "*"
     6316                                    or iCheckType eq ?
     6317                                 then       ""
     6318                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     6319      vHQry:query-open().
     6320      vHQry:get-first().
     6321      QRY-BLOCK:
     6322      repeat while not vHQry:query-off-end:
     6323         define variable vErrorOne as character no-undo.
     6324         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     6325         if     vErrorOne ne ?
     6326            and vErrorOne ne ""
     6327         then do:
     6328            vi = vi + 1.
     6329            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     6330                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     6331                            + '","ТекстОш":"' + vErrorOne + '"}'.
     6332         end.
     6333         vHQry:get-next().
     6334      end.
     6335      for first utd where utd.db-num eq idb-num
     6336                      and utd.doc-id eq idoc-id
     6337                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     6338      no-lock,
     6339         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     6340                                  and utd-marking-lines.doc-id eq idoc-id
     6341                                  and utd-marking-lines.doc-level eq 1
     6342      no-lock,
     6343         first marking where marking.mark eq utd-marking-lines.mark
     6344                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     6345      no-lock:
     6346         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     6347         if     vErrorOne ne ?
     6348            and vErrorOne ne ""
     6349         then do:
     6350            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     6351                            + '","ОбъектОш":"' + marking.mark
     6352                            + '","ТекстОш":"' + vErrorOne + '"}'.
     6353         end.
     6354      end.
     6355      if vError ne ""
     6356      then
     6357         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     6358      return oError.
     6359   end.
     6360   function GetErrJsonForUtdReturn returns character
     6361   (idb-num         as integer ,
     6362    idoc-id         as integer ,
     6363    iCheckType      as character
     6364    ):
     6365      define buffer utd-err for utd-err.
     6366      define variable vHQry as handle no-undo.
     6367      define variable vError as longchar no-undo.
     6368      define variable oError as character no-undo.
     6369      define variable vi as integer no-undo.
     6370      create query vHQry.
     6371      vHQry:set-buffers(buffer utd-err:handle).
     6372      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     6373                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     6374                               + if    iCheckType eq "*"
     6375                                    or iCheckType eq ?
     6376                                 then       ""
     6377                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     6378      vHQry:query-open().
     6379      vHQry:get-first().
     6380      QRY-BLOCK:
     6381      repeat while not vHQry:query-off-end:
     6382         define variable vErrorOne as character no-undo.
     6383         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     6384         if     vErrorOne ne ?
     6385            and vErrorOne ne ""
     6386         then do:
     6387            vi = vi + 1.
     6388            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     6389                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     6390                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     6391         end.
     6392         vHQry:get-next().
     6393      end.
     6394      if vError ne ""
     6395      then
     6396         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     6397      return oError.
     6398   end.
     6399   function GetCodeTextError returns character
     6400   (iCheckType as character,
     6401    iCodeErr   as character,
     6402    iChechObj  as character,
     6403    output oCode as character,
     6404    output ovalue as character ):
     6405      define buffer code    for code.
     6406      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     6407                        and code.code   eq iCodeErr
     6408      no-lock no-error.
     6409      if     available code
     6410      then do:
     6411         define variable vi as integer no-undo init ?.
     6412         vi = int(Code.misc3) no-error.
     6413         if    code.misc3 ne "error"
     6414            and vi ne 0
     6415         then
     6416            oCode = ?.
     6417         else if     Code.misc1 ne ?
     6418                 and Code.misc1 ne ""
     6419         then
     6420            assign
     6421               oCode  = GetMesError(Code.misc1,iChechObj)
     6422               ovalue = GetMesError(Code.misc2,iChechObj)
     6423            .
     6424      end.
     6425      return if oCode eq ""
     6426             then ""
     6427             else (oCode + "_" + ovalue).
     6428   end.
     6429   define temp-table TT-err no-undo
     6430     field code_ as character
     6431     field text_ as character
     6432   index code_ code_.
     6433   function GetErrTxtForUtd returns character
     6434   (idb-num         as integer ,
     6435    idoc-id         as integer ,
     6436    iCheckType      as character
     6437    ):
     6438      define buffer utd-err for utd-err.
     6439      define variable vHQry as handle no-undo.
     6440      define variable oError as character no-undo.
     6441      create query vHQry.
     6442      define variable vi as integer no-undo.
     6443      for each tt-err :
     6444         delete tt-err.
     6445      end.
     6446      vHQry:set-buffers(buffer utd-err:handle).
     6447      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     6448                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     6449                               + if    iCheckType eq "*"
     6450                                    or iCheckType eq ?
     6451                                 then       ""
     6452                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     6453      vHQry:query-open().
     6454      vHQry:get-first().
     6455      define variable vcode as character no-undo.
     6456      define variable vvalue as character no-undo.
     6457      QRY-BLOCK:
     6458      repeat while not vHQry:query-off-end:
     6459         vi = vi + 1.
     6460         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     6461         if vcode ne ?
     6462         then do:
     6463            find first tt-err where tt-err.code eq vcode
     6464            no-error.
     6465            if not available tt-err
     6466            then do:
     6467               create tt-err.
     6468               assign
     6469                  tt-err.code_ = vcode
     6470                  tt-err.text_ = vvalue
     6471               .
     6472            end.
     6473            else
     6474               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     6475         end.
     6476         vHQry:get-next().
     6477      end.
     6478     find first utd where utd.db-num eq idb-num
     6479                         and utd.doc-id eq idoc-id
     6480         no-lock.
     6481      define buffer cancel_utd-lines for utd-lines.
     6482      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     6483                                  and cancel_utd-lines.doc-id eq idoc-id
     6484      no-lock:
     6485         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     6486         then do:
     6487            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     6488                                        and utd-marking-lines.doc-id eq idoc-id
     6489                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     6490            no-lock,
     6491               first marking where marking.mark eq utd-marking-lines.mark
     6492                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     6493            no-lock:
     6494               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     6495               find first tt-err where tt-err.code eq vcode
     6496               no-error.
     6497               if not available tt-err
     6498               then do:
     6499                  create tt-err.
     6500                  assign
     6501                     tt-err.code_ = vcode
     6502                     tt-err.text_ = vvalue
     6503                  .
     6504               end.
     6505               else
     6506                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     6507            end.
     6508         end.
     6509         else do:
     6510            define variable vqnty as decimal no-undo.
     6511            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     6512            if vqnty eq ? then vqnty = 0.
     6513            if vqnty ne cancel_utd-lines.Quantity
     6514            then do:
     6515               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     6516               find first tt-err where tt-err.code eq vcode
     6517               no-error.
     6518               if not available tt-err
     6519               then do:
     6520                  create tt-err.
     6521                  assign
     6522                     tt-err.code_ = vcode
     6523                     tt-err.text_ = vvalue
     6524                  .
     6525               end.
     6526               else
     6527                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     6528            end.
     6529         end.
     6530      end.
     6531      for each tt-err:
     6532         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     6533      end.
     6534      return oError.
     6535   end.
     6536   define variable mFormatErr as character no-undo init "text".
     6537   function GetErrForUtd returns character
     6538   (idb-num         as integer ,
     6539    idoc-id         as integer ,
     6540    iType           as character
     6541    ):
     6542      if mFormatErr eq "text"
     6543      then
     6544         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     6545      else do:
     6546         if itype eq "return"
     6547         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     6548         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     6549      end.
     6550   end.
     6551   function GetErrComText returns longchar
     6552   (icomment as character,
     6553    itext    as longchar ):
     6554       define variable vText as longchar no-undo.
     6555      if mFormatErr eq "text"
     6556      then do:
     6557         if icomment ne ""
     6558         then
     6559            icomment = substitute("comment:|&1|",icomment).
     6560         vText = icomment + itext.
     6561      end.
     6562      else do:
     6563         icomment = if icomment begins  '"'
     6564                    then icomment
     6565                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     6566         vText = icomment + "," + itext.
     6567         vText = "~{" + trim(vText,",") + "~}".
     6568      end.
     6569      return vText.
     6570   end.
     6571   function CheckTypeForMarkLineType returns logical
     6572   (iObj            as handle,
     6573    iCheckType      as character,
     6574    iCodeErr        as character ,
     6575    iTypeErr        as character ):
     6576      define variable vRecKey-markLine as character no-undo.
     6577      define variable vGoodMark        as logical no-undo.
     6578      define variable vdb-num          as integer no-undo.
     6579      define variable vdoc-id          as integer no-undo.
     6580      define variable vlinenum         as integer no-undo.
     6581      define variable vErrorOne as character no-undo.
     6582      define buffer buf_utd-err for utd-err.
     6583      run gen-key-rec (input "utd-marking-lines",
     6584                       input  iObj,
     6585                       output vRecKey-markLine).
     6586      vGoodMark = yes.
     6587      vdb-num = iObj::db-num.
     6588      vdoc-id = iObj::doc-id.
     6589      vlinenum = iObj::linenum.
     6590      block-mark-err:
     6591      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     6592                               and buf_utd-err.db-num = vdb-num
     6593                               and buf_utd-err.reckey = vRecKey-markLine
     6594                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     6595                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     6596      no-lock:
     6597         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     6598         if     vErrorOne ne ?
     6599            and vErrorOne ne ""
     6600         then do:
     6601            vGoodMark = no.
     6602            leave block-mark-err.
     6603         end.
     6604      end.
     6605      return not vGoodMark.
     6606   end.
     6607   function CheckErrForMarkLineType returns logical
     6608   (iObj            as handle,
     6609    iType           as character  ):
     6610      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     6611   end.
     6612   function CheckErrForMarkLine returns logical
     6613   (iObj            as handle):
     6614      return CheckErrForMarkLineType(iObj,"*").
     6615   end.
     6616   function CheckErrForLineTypeCode returns logical
     6617   (iObj                 as handle,
     6618    iCheckType           as character,
     6619    iCodeErr             as character,
     6620    iTypeErr             as character,
     6621    iOneErr              as logical):
     6622      define variable vRecKey-line     as character no-undo.
     6623      define buffer buf_utd-err for utd-err.
     6624      define variable vUtdlineError as logical no-undo.
     6625      define variable vErrorOne as character no-undo.
     6626            run gen-key-rec (input "utd-lines",
     6627                             input  iObj,
     6628                             output vRecKey-line).
     6629         define variable vdb-num as integer no-undo.
     6630         define variable vdoc-id as integer no-undo.
     6631         define variable vlinenum as integer no-undo.
     6632         vdb-num = iObj::db-num.
     6633         vdoc-id = iObj::doc-id.
     6634         vlinenum = iObj::linenum.
     6635         block-err:
     6636         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     6637                                  and buf_utd-err.db-num = vdb-num
     6638                                  and buf_utd-err.reckey = vRecKey-line
     6639                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     6640                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     6641         no-lock:
     6642            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     6643            if     vErrorOne ne ?
     6644               and vErrorOne ne ""
     6645            then do:
     6646               vUtdlineError = yes.
     6647               leave block-err.
     6648            end.
     6649         end.
     6650         if  not vUtdlineError
     6651         then do:
     6652            define variable vGoodMark as logical no-undo.
     6653            vGoodMark = yes.
     6654            block-line-err:
     6655            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     6656                                         and utd-marking-lines.doc-id  eq vdoc-id
     6657                                         and utd-marking-lines.LineNum eq vLineNum
     6658            no-lock:
     6659               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     6660               if     vGoodMark
     6661                  and iOneErr eq no
     6662               then
     6663                  leave block-line-err.
     6664               if     iOneErr = yes
     6665                  and not vGoodMark
     6666               then
     6667                  leave block-line-err.
     6668            end.
     6669            vUtdlineError = not vGoodMark.
     6670         end.
     6671      return vUtdlineError.
     6672   end.
     6673   function getErrForLineType returns character
     6674   (iObj            as handle,
     6675    iType           as character  ):
     6676      define variable vRecKey-line     as character no-undo.
     6677      define buffer buf_utd-err for utd-err.
     6678      define variable vUtdlineError as logical no-undo.
     6679      define variable vErrorOne as character no-undo.
     6680      define variable oError as character no-undo.
     6681            run gen-key-rec (input "utd-lines",
     6682                             input  iObj,
     6683                             output vRecKey-line).
     6684         define variable vdb-num as integer no-undo.
     6685         define variable vdoc-id as integer no-undo.
     6686         define variable vlinenum as integer no-undo.
     6687         vdb-num = iObj::db-num.
     6688         vdoc-id = iObj::doc-id.
     6689         vlinenum = iObj::linenum.
     6690         block-err:
     6691         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     6692                                  and buf_utd-err.db-num = vdb-num
     6693                                  and buf_utd-err.reckey = vRecKey-line
     6694                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     6695         no-lock:
     6696            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     6697            if     vErrorOne ne ?
     6698               and vErrorOne ne ""
     6699            then do:
     6700               oError = oError + vErrorOne + " ".
     6701            end.
     6702         end.
     6703      return oError.
     6704   end.
     6705   function CheckErrForLineType returns logical
     6706   (iObj            as handle,
     6707    iType           as character  ):
     6708       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     6709   end.
     6710   function CheckErrForLine returns logical
     6711   (iObj            as handle):
     6712      return CheckErrForLineType(iobj,"*").
     6713   end.
     6714   function CheckErrForUtd returns logical
     6715   (idb-num         as integer ,
     6716    idoc-id         as integer ):
     6717      for each utd-lines where utd-lines.db-num eq idb-num
     6718                           and utd-lines.doc-id eq idoc-id
     6719      no-lock :
     6720         if not CheckErrForLine (buffer ub.utd-lines:handle)
     6721         then
     6722            return no.
     6723      end.
     6724      return yes.
     6725   end.
     6726   function CheckMarkUtd-28rel return logical
     6727    (input idb-num as integer,
     6728    input idoc-id as integer):
     6729    define buffer utd                   for utd.
     6730    define buffer utd-lines             for utd-lines.
     6731    define buffer utd-marking-lines     for utd-marking-lines.
     6732    define variable v-par-type as character no-undo.
     6733    define variable vgdsNoMark as logical no-undo.
     6734    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     6735      define variable v-par-val  as character no-undo.
     6736      find first utd where utd.db-num eq idb-num
     6737                       and utd.doc-id eq idoc-id
     6738      no-lock no-error.
     6739      if available utd
     6740      then do:
     6741         if     utd.obj-code ne ?
     6742            and utd.obj-type ne ?
     6743         then do:
     6744            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     6745            Block-utd-lines:
     6746            for each utd-lines where utd-lines.db-num eq idb-num
     6747                                 and utd-lines.doc-id eq idoc-id
     6748            no-lock:
     6749               if     utd-lines.gds-code ne ?
     6750                  and utd-lines.gds-code ne 0
     6751               then do:
     6752                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     6753                       ( utd-lines.gds-code,
     6754                         'mark-type':U,
     6755                          output v-par-val,
     6756                          output v-par-type
     6757                       ).
     6758                  if     EDOParSec:IsEdo
     6759                     and EDOParSec:GetIsEDOForType(v-par-val)
     6760                  then do:
     6761                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     6762                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     6763                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     6764                                                    and length(utd-marking-lines.mark) > 13
     6765                     no-lock no-error.
     6766                     if     avail utd-marking-lines
     6767                        and not CheckErrForLine(buffer utd-lines:handle)
     6768                     then
     6769                        leave Block-utd-lines.
     6770                  end.
     6771                  else
     6772                     vgdsNoMark = yes.
     6773               end.
     6774            end.
     6775            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     6776            if vgdsNoMark then return available utd-lines . else return yes .
     6777         end.
     6778      end.
     6779      return yes.
     6780   end.
     6781   function get-subject returns character
     6782     ( p-subject as character ) :
     6783     return p-subject.
     6784   end function.
     6785   procedure local-view-cange:
     6786      define output parameter odescription as character no-undo.
     6787      if X_c-obj-hist.subject eq "utd"
     6788      then
     6789         run utd-proc (output odescription).
     6790      else if X_c-obj-hist.subject eq "utd-err"
     6791      then
     6792         run utd-err-proc (output odescription).
     6793      else if X_c-obj-hist.subject eq "utd-lines"
     6794      then
     6795         run utd-lines-proc (output odescription).
     6796      else if X_c-obj-hist.subject eq "utd-marking-lines"
     6797      then
     6798         run utd-marking-lines-proc (output odescription).
     6799      else if X_c-obj-hist.subject eq "utd-attr"
     6800      then
     6801         run utd-attr-proc (output odescription).
     6802      else if X_c-obj-hist.subject eq "utd-err-attr"
     6803      then
     6804         run utd-err-attr-proc (output odescription).
     6805      else if X_c-obj-hist.subject eq "utd-lines-attr"
     6806      then
     6807         run utd-lines-attr-proc (output odescription).
     6808      else if X_c-obj-hist.subject eq "utd-marking-lines-attr"
     6809      then
     6810         run utd-marking-lines-attr-proc (output odescription).
     6811   end procedure.
     6812   function local-open-br returns logical
     6813   (  p-open-query     as logical    ,
     6814     p-find-next       as logical    ,
     6815     p-find-condition as character ):
     6816        define variable sort-column-phrase as character no-undo .
     6817        define variable l-query-was-opened as logical no-undo .
     6818      for each X_c-obj-hist :
     6819         delete X_c-obj-hist.
     6820      end.
     6821      if p-mode eq "one"
     6822      then do:
     6823         if p-chip-num eq ?
     6824         then do:
     6825            for each c-utd-head where c-utd-head.DB-NUM = p-DB-NUM-utd
     6826                                       and c-utd-head.doc-id = p-doc-id-utd
     6827                                       and c-utd-head.corr-user-db-num = v-corr-user-db-num
     6828            no-lock:
     6829               create X_c-obj-hist.
     6830               buffer-copy c-utd-head to X_c-obj-hist.
     6831            end.
     6832         end.
     6833         else do:
     6834            for each c-utd-head where c-utd-head.corr-user-db-num   eq v-corr-user-db-num
     6835                                       and c-utd-head.chip-num           eq p-chip-num
     6836            no-lock:
     6837                           for each c-utd-err where c-utd-err.corr-user-db-num   eq v-corr-user-db-num
     6838                                      and c-utd-err.chip-num           eq p-chip-num
     6839               no-lock:
     6840                  create X_c-obj-hist.
     6841                  buffer-copy c-utd-head to X_c-obj-hist.
     6842                  buffer-copy c-utd-err to X_c-obj-hist
     6843                  assign
     6844                     X_c-obj-hist.subject = "utd-err"
     6845                  .
     6846               end.
     6847                           for each c-utd-lines where c-utd-lines.corr-user-db-num   eq v-corr-user-db-num
     6848                                      and c-utd-lines.chip-num           eq p-chip-num
     6849               no-lock:
     6850                  create X_c-obj-hist.
     6851                  buffer-copy c-utd-head to X_c-obj-hist.
     6852                  buffer-copy c-utd-lines to X_c-obj-hist
     6853                  assign
     6854                     X_c-obj-hist.subject = "utd-lines"
     6855                  .
     6856               end.
     6857                           for each c-utd-marking-lines where c-utd-marking-lines.corr-user-db-num   eq v-corr-user-db-num
     6858                                      and c-utd-marking-lines.chip-num           eq p-chip-num
     6859               no-lock:
     6860                  create X_c-obj-hist.
     6861                  buffer-copy c-utd-head to X_c-obj-hist.
     6862                  buffer-copy c-utd-marking-lines to X_c-obj-hist
     6863                  assign
     6864                     X_c-obj-hist.subject = "utd-marking-lines"
     6865                  .
     6866               end.
     6867                           for each c-utd-attr where c-utd-attr.corr-user-db-num   eq v-corr-user-db-num
     6868                                      and c-utd-attr.chip-num           eq p-chip-num
     6869               no-lock:
     6870                  create X_c-obj-hist.
     6871                  buffer-copy c-utd-head to X_c-obj-hist.
     6872                  buffer-copy c-utd-attr to X_c-obj-hist
     6873                  assign
     6874                     X_c-obj-hist.subject = "utd-attr"
     6875                  .
     6876               end.
     6877                           for each c-utd-err-attr where c-utd-err-attr.corr-user-db-num   eq v-corr-user-db-num
     6878                                      and c-utd-err-attr.chip-num           eq p-chip-num
     6879               no-lock:
     6880                  create X_c-obj-hist.
     6881                  buffer-copy c-utd-head to X_c-obj-hist.
     6882                  buffer-copy c-utd-err-attr to X_c-obj-hist
     6883                  assign
     6884                     X_c-obj-hist.subject = "utd-err-attr"
     6885                  .
     6886               end.
     6887                           for each c-utd-lines-attr where c-utd-lines-attr.corr-user-db-num   eq v-corr-user-db-num
     6888                                      and c-utd-lines-attr.chip-num           eq p-chip-num
     6889               no-lock:
     6890                  create X_c-obj-hist.
     6891                  buffer-copy c-utd-head to X_c-obj-hist.
     6892                  buffer-copy c-utd-lines-attr to X_c-obj-hist
     6893                  assign
     6894                     X_c-obj-hist.subject = "utd-lines-attr"
     6895                  .
     6896               end.
     6897                           for each c-utd-marking-lines-attr where c-utd-marking-lines-attr.corr-user-db-num   eq v-corr-user-db-num
     6898                                      and c-utd-marking-lines-attr.chip-num           eq p-chip-num
     6899               no-lock:
     6900                  create X_c-obj-hist.
     6901                  buffer-copy c-utd-head to X_c-obj-hist.
     6902                  buffer-copy c-utd-marking-lines-attr to X_c-obj-hist
     6903                  assign
     6904                     X_c-obj-hist.subject = "utd-marking-lines-attr"
     6905                  .
     6906               end.
     6907                           for each c-utd where c-utd.corr-user-db-num   eq v-corr-user-db-num
     6908                                      and c-utd.chip-num           eq p-chip-num
     6909               no-lock:
     6910                  create X_c-obj-hist.
     6911                  buffer-copy c-utd-head to X_c-obj-hist.
     6912                  buffer-copy c-utd to X_c-obj-hist
     6913                  assign
     6914                     X_c-obj-hist.subject = "utd"
     6915                  .
     6916               end.
     6917            end.
     6918         end.
     6919      end.
     6920   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6921   define variable  l-disable-where-36  as logical   no-undo .
     6922   define variable  l-filter-open-36    as logical   .
     6923   define variable  flt-rec-36       as recid     no-undo .
     6924   define variable  filter-name-36      as character no-undo .
     6925   define variable  where-phrase-36     as character no-undo .
     6926   define variable  sort-phrase-36      as character no-undo .
     6927   define variable  where-phrase-rus-36 as character no-undo .
     6928   define variable  sort-phrase-rus-36  as character no-undo .
     6929     run waitfram-show in this-procedure
     6930       (input "ЖДИТЕ ..."
     6931       ).
     6932   run gbl/flt-get.p
     6933     (input filter-point
     6934     ,output flt-rec-36
     6935     ,output filter-name-36
     6936     ,output where-phrase-36
     6937     ,output sort-phrase-36
     6938     ,output where-phrase-rus-36
     6939     ,output sort-phrase-rus-36
     6940     ).
     6941   if p-open-query then do:
     6942       run set-filter-name in this-procedure
     6943         (INPUT filter-name-36
     6944         ) no-error .
     6945     assign
     6946       l-filter-open-36 = false
     6947     .
     6948     if flt-rec-36 <> ?
     6949       or sort-column-phrase > ""
     6950     then do:
     6951       define variable  parameter-2-36 as character no-undo .
     6952       define variable  parameter-3-36 as character no-undo .
     6953       define variable  parameter-4-36 as character no-undo .
     6954       define variable  parameter-5-36 as character no-undo .
     6955       define variable  parameter-6-36 as character no-undo .
     6956       define variable  parameter-7-36 as character no-undo .
     6957         assign
     6958         parameter-3-36 =
     6959                                 "FOR EACH X_c-obj-hist"
     6960         parameter-4-36 =
     6961           (
     6962             if (" TRUE " + " " + where-phrase-36) <> ""
     6963             then " TRUE " + " " + where-phrase-36
     6964             else "true"
     6965           )
     6966         parameter-5-36 = (" " + "" + " " + "")
     6967         parameter-6-36 = if sort-phrase-36 = ''
     6968                              then
     6969           (
     6970           " " + "" +
     6971             " " + sort-column-phrase +
     6972           " " + " by X_c-obj-hist.chip-num  "
     6973           )
     6974                              else
     6975           (
     6976           " " + "" +
     6977             " " + sort-column-phrase +
     6978           " " + sort-phrase-36
     6979           )
     6980         parameter-7-36 =
     6981           " indexed-reposition  "
     6982       .
     6983       do
     6984       on stop undo, leave
     6985       on error undo, leave
     6986       :
     6987         assign
     6988           l-disable-where-36 =
     6989             (" TRUE " + " " + where-phrase-36 = "")
     6990         .
     6991         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     6992                             ,input query br-obj-hist:handle
     6993                             ,input parameter-3-36
     6994                             ,input parameter-4-36
     6995                             ,input parameter-5-36
     6996                             ,input parameter-6-36
     6997                             ,input parameter-7-36
     6998                             )
     6999         .
     7000         assign
     7001           l-filter-open-36 = true
     7002         .
     7003       end.
     7004       if l-filter-open-36 = false then do:
     7005         message
     7006           "Ошибка при фильтрации / сортировке" skip
     7007           "Будут показаны записи без учета фильтра" skip
     7008           view-as alert-box .
     7009       end.
     7010       else do:
     7011           assign
     7012             l-query-was-opened = true
     7013           .
     7014       end.
     7015     end.
     7016     if l-filter-open-36 = false then do:
     7017       OPEN QUERY br-obj-hist FOR EACH X_c-obj-hist
     7018         where  TRUE
     7019          by X_c-obj-hist.chip-num
     7020         indexed-reposition
     7021     .
     7022         assign
     7023           l-query-was-opened = true
     7024         .
     7025     end.
     7026   end.
     7027   else do:
     7028     assign
     7029       v-doc-rec = recid( X_c-obj-hist )
     7030     .
     7031     do
     7032     on stop undo, leave
     7033     on error undo, leave
     7034     :
     7035       if query br-obj-hist:handle:get-buffer-handle(1) = (buffer X_c-obj-hist:handle) then do:
     7036         assign
     7037         parameter-2-36 = (if p-find-next then "true":u else "false":u )
     7038         parameter-4-36 =
     7039           "where ":u + " TRUE " + " ":u + where-phrase-36 + " ":u + p-find-condition + " " + ""
     7040         parameter-5-36 = ""
     7041       .
     7042         run fltopend_fltfindd in this-procedure  (
     7043                             input this-procedure:handle
     7044                             ,input query br-obj-hist:handle
     7045                             ,input rowid(X_c-obj-hist)
     7046                             ,input logical(parameter-2-36)
     7047                             ,input no-lock
     7048                             ,input (buffer X_c-obj-hist:handle)
     7049                             ,input parameter-4-36
     7050                             ,input parameter-5-36
     7051                             ) no-error.
     7052         .
     7053         assign
     7054           v-doc-rec = integer(return-value)
     7055           v-fltopend-rowid[1] = ?
     7056         .
     7057       end.
     7058       else do:
     7059         assign
     7060         parameter-2-36 = (if p-find-next then "true":u else "false":u )
     7061         parameter-3-36 =  "FOR EACH X_c-obj-hist"
     7062         parameter-4-36 =
     7063           (
     7064             if (" TRUE " + " " + where-phrase-36) <> ""
     7065             then " TRUE " + " " + where-phrase-36
     7066             else "true"
     7067           )
     7068         parameter-5-36 = (" " + "" + " " + "" + " " + p-find-condition)
     7069         parameter-6-36 = if sort-phrase-36 = ''
     7070                              then
     7071           (
     7072           " " + "" +
     7073             " " + sort-column-phrase +
     7074           " " + " by X_c-obj-hist.chip-num  "
     7075           )
     7076                              else
     7077           (
     7078           " " + "" +
     7079             " " + sort-column-phrase +
     7080           " " + sort-phrase-36
     7081           )
     7082         parameter-7-36 =
     7083           " indexed-reposition  "
     7084       .
     7085         run fltopend_fltfindq in this-procedure  (
     7086                             input this-procedure:handle
     7087                             ,input query br-obj-hist:handle
     7088                             ,input logical(parameter-2-36)
     7089                             ,input no-lock
     7090                             ,input parameter-3-36
     7091                             ,input parameter-4-36
     7092                             ,input parameter-5-36
     7093                             ,input parameter-6-36
     7094                             ,input parameter-7-36
     7095                             ,output v-fltopend-rowid
     7096                             ) no-error.
     7097         .
     7098         v-doc-rec = ?.
     7099       end.
     7100       assign
     7101         l-query-was-opened = true
     7102       .
     7103     end.
     7104   end.
     7105     run waitfram-hide in this-procedure .
     7106     return true.
     7107   end.
     7108   function  getStsMark returns character (ists as int ):
     7109      return StatusMark:GetLabel(ists).
     7110   end.
     7111   function  getStsTh returns character (ists as int ):
     7112      return StatusTH:GetLabel(ists).
     7113   end.
     7114   function  getStsEdi returns character (ists as int ):
     7115      return if ists eq 0 then "" else StatusEDI:GetLabel(ists).
     7116   end.
     7117   function  getStsEdocType returns character (itype as int ):
     7118      return if itype eq 0 then "" else  EdocType:GetLabel(itype).
     7119   end.
     7120   procedure utd-proc :
     7121   define output parameter p-description as character no-undo .
     7122   define buffer current_c-utd for ub.c-utd  .
     7123   define variable v-mess as character no-undo.
     7124   do
     7125   on error undo, return error return-value
     7126   :
     7127     find first current_c-utd no-lock where
     7128                  current_c-utd.db-num = X_c-obj-hist.db-num
     7129              and current_c-utd.doc-id = X_c-obj-hist.doc-id
     7130             and current_c-utd.chip-num = X_c-obj-hist.chip-num
     7131             and current_c-utd.corr-user-db-num = X_c-obj-hist.corr-user-db-num no-error .
     7132     if not avail current_c-utd then do:
     7133         v-mess = "Неверная ссылка на c-utd в таблице c-utd-head".
     7134         return error  v-mess .
     7135     end.
     7136   define variable v-label-param as character no-undo .
     7137     v-label-param =
     7138      "OrganizationExt"     + chr(4) + "ID организации в ЭДО"                              + chr(4) + "" + chr(8)
     7139    + "DocumentExt" + chr(4) + "ID документа в ЭДО"                          + chr(4) + "" + chr(8)
     7140    + "LoadDate"      + chr(4) + "Дата загрузки"    + chr(4) + "" + chr(8)
     7141    + "parentOrganizationExt"     + chr(4) + "ID организации в родительском документе в ЭДО"   + chr(4) + "" + chr(8)
     7142    + "parentDocumentExt"      + chr(4) + "ID родительского документа в ЭДО"                                + chr(4) + "" + chr(8)
     7143    + "RevocationStatus"       + chr(4) + "Статус аннулирования документа" + chr(4) + "" + chr(8)
     7144    + "RecipientResponseStatus"  + chr(4) + "Состояние ответного действия"        + chr(4) + "" + chr(8)
     7145    + "TypeId"  + chr(4) + "Тип документа ЭДО"                    + chr(4) + "" + chr(8)
     7146    + "CounteragentId"     + chr(4) + "Контрагент документа"                       + chr(4) + "" + chr(8)
     7147    + "CustomDocumentId"     + chr(4) + "Идентификатор документа, определяемый внешней системой"                       + chr(4) + "" + chr(8)
     7148    + "DocumentNumber"    + chr(4) + "Номер документа"                            + chr(4) + "" + chr(8)
     7149    + "DocumentDate"     + chr(4) + "Дата документа"                       + chr(4) + "" + chr(8)
     7150    + "Timestamp"    + chr(4) + "Дата и время создания в ЭДО"                            + chr(4) + "" + chr(8)
     7151    + "ReceiptStatus"     + chr(4) + "Состояние ИОП на документ"                       + chr(4) + "" + chr(8)
     7152    + "Direction"    + chr(4) + "Направление документа"                            + chr(4) + "" + chr(8)
     7153    + "ModifyDate"     + chr(4) + "Дата изменения"                       + chr(4) + "" + chr(8)
     7154    + "ModifyTime"     + chr(4) + "Время изменения"                       + chr(4) + "" + chr(8)
     7155    + "PackageId"    + chr(4) + "ID пакета в ЭДО"                            + chr(4) + "" + chr(8)
     7156    + "EDocType"     + chr(4) + "Тип документа"                       + chr(4) + "getStsEdocType" + chr(8)
     7157    + "AmendmentRequested"    + chr(4) + "Зарошена корректировка"                            + chr(4) + "" + chr(8)
     7158    + "BaseDocumentNumber"     + chr(4) + "Номер договора"                       + chr(4) + "" + chr(8)
     7159    + "BaseDocumentName"    + chr(4) + "Наименование договора"                            + chr(4) + "" + chr(8)
     7160    + "BaseDocumentDate"     + chr(4) + "Дата договора"                       + chr(4) + "" + chr(8)
     7161    + "cli-FnsParticipantId"    + chr(4) + "ID подразделения отправителя"                            + chr(4) + "" + chr(8)
     7162    + "cli-info"    + chr(4) + "Инф. отправителя"                            + chr(4) + "" + chr(8)
     7163    + "obj-FnsParticipantId"     + chr(4) + "ID подразделения получателя"                       + chr(4) + "" + chr(8)
     7164    + "obj-info"    + chr(4) + "Инф. получателя"                            + chr(4) + "" + chr(8)
     7165    + "sts"     + chr(4) + "Статус TH"                       + chr(4) + "getStsTh" + chr(8)
     7166    + "sts-edi"    + chr(4) + "Статус ЭДО"                            + chr(4) + "getStsEdi" + chr(8)
     7167    + "cli-type"    + chr(4) + "Тип отправителя"                            + chr(4) + "" + chr(8)
     7168    + "cli-code"     + chr(4) + "Код отправителя"                       + chr(4) + "" + chr(8)
     7169    + "host-code"    + chr(4) + "Фирма"                            + chr(4) + "" + chr(8)
     7170    + "obj-type"     + chr(4) + "Тип объекта"                       + chr(4) + "" + chr(8)
     7171    + "obj-code"    + chr(4) + "Код объекта"                            + chr(4) + "" + chr(8)
     7172    + "doc-code"    + chr(4) + "Номер накладной"                            + chr(4) + "" + chr(8)
     7173    + "total"    + chr(4) + "Сумма"                            + chr(4) + "" + chr(8)
     7174    + "comment"    + chr(4) + "Комментарий"                            + chr(4) + "" + chr(8)
     7175    + "Vat"    + chr(4) + "НДС"                            + chr(4) + "" + chr(8)
     7176    + "AdditInfo"        + chr(4) + "Ошибки"  + chr(4) + ""  + chr(8)
     7177    + "db-num"     + chr(4) + "db-num"  + chr(4) + "" + chr(8)
     7178    + "doc-id"     + chr(4) + "doc-id"  + chr(4) + "".
     7179     run proc-full-temp-changes in this-procedure (
     7180                                                  input current_c-utd.action = integer('1':U)
     7181                                                 ,input current_c-utd.action = integer('99':U)
     7182                                                 ,input  buffer current_c-utd:handle
     7183                                                 ,input  "utd"
     7184                                                 ,input  "DocumentExt,OrganizationExt,LoadDate,parentDocumentExt,parentOrganizationExt,RevocationStatus,RecipientResponseStatus,TypeId,CounteragentId,CustomDocumentId,DocumentNumber,DocumentDate,Timestamp,ReceiptStatus,Direction,ModifyDate,PackageId,EDocType,AmendmentRequested,BaseDocumentNumber,BaseDocumentName,BaseDocumentDate,cli-FnsParticipantId,cli-info,obj-FnsParticipantId,obj-info,sts,sts-edi,cli-type,cli-code,host-code,contract-code,obj-type,obj-code,ModifyTime,doc-code,AdditInfo,comment,db-num,doc-id"
     7185                                                 ,input  v-label-param).
     7186   end.
     7187   end procedure.
     7188   procedure utd-attr-proc :
     7189   define output parameter p-description as character no-undo .
     7190   define buffer current_c-utd-attr for ub.c-utd-attr  .
     7191   define variable v-mess as character no-undo.
     7192      do
     7193      on error undo, return error return-value
     7194      :
     7195        find first current_c-utd-attr no-lock where
     7196                     current_c-utd-attr.db-num = X_c-obj-hist.db-num
     7197                 and current_c-utd-attr.doc-id = X_c-obj-hist.doc-id
     7198                and current_c-utd-attr.attr-code = X_c-obj-hist.attr-code
     7199                and current_c-utd-attr.chip-num = X_c-obj-hist.chip-num
     7200                and current_c-utd-attr.corr-user-db-num = X_c-obj-hist.corr-user-db-num no-error .
     7201        if not avail current_c-utd-attr then do:
     7202            v-mess = "Неверная ссылка на c-utd-attr в таблице c-utd-head".
     7203            return error  v-mess .
     7204        end.
     7205      define variable v-label-param as character no-undo .
     7206        v-label-param =
     7207         "attr-code"     + chr(4) + "атрибут"                              + chr(4) + "" + chr(8)
     7208       + "attr-value"        + chr(4) + "Значение атрибута"  + chr(4) + "" .
     7209        run proc-full-temp-changes in this-procedure (
     7210                                                     input current_c-utd-attr.action = integer('1':U)
     7211                                                    ,input current_c-utd-attr.action = integer('99':U)
     7212                                                    ,input  buffer current_c-utd-attr:handle
     7213                                                    ,input  "utd-attr"
     7214                                                    ,input  "attr-code,attr-value"
     7215                                                    ,input  v-label-param).
     7216      end.
     7217   end.
     7218   define variable mCheckType as character no-undo.
     7219   define variable mCodeErr as character no-undo.
     7220   function  err-text returns character (iCheckObj as character ):
     7221      return if iCheckObj  eq "" then "" else GetTextErrortype( mCheckType, mCodeErr, iCheckObj,"all").
     7222   end.
     7223   procedure utd-err-proc :
     7224   define output parameter p-description as character no-undo .
     7225   define buffer current_c-utd-err for ub.c-utd-err  .
     7226   define variable v-mess as character no-undo.
     7227   do
     7228   on error undo, return error return-value
     7229   :
     7230     find first current_c-utd-err no-lock where
     7231                  current_c-utd-err.db-num = X_c-obj-hist.db-num
     7232              and current_c-utd-err.doc-id = X_c-obj-hist.doc-id
     7233          and current_c-utd-err.CheckType = X_c-obj-hist.CheckType
     7234          and current_c-utd-err.CodeErr = X_c-obj-hist.CodeErr
     7235          and current_c-utd-err.CheckObj = X_c-obj-hist.CheckObj
     7236          and current_c-utd-err.reckey = X_c-obj-hist.reckey
     7237             and current_c-utd-err.chip-num = X_c-obj-hist.chip-num
     7238             and current_c-utd-err.corr-user-db-num = X_c-obj-hist.corr-user-db-num no-error .
     7239     if not avail current_c-utd-err then do:
     7240         v-mess = "Неверная ссылка на c-utd в таблице c-utd-head".
     7241         return error  v-mess .
     7242     end.
     7243    mCheckType = current_c-utd-err.CheckType.
     7244    mCodeErr = current_c-utd-err.CodeErr.
     7245   define variable v-label-param as character no-undo .
     7246     v-label-param =
     7247      "CheckType"     + chr(4) + "Тип ошибки"                              + chr(4) + "" + chr(8)
     7248    + "LineNum" + chr(4) + "Линия"                          + chr(4) + "" + chr(8)
     7249    + "CodeErr" + chr(4) + "Код ошибки"                          + chr(4) + "" + chr(8)
     7250    + "CheckObj"      + chr(4) + "Текст"    + chr(4) + "err-text" + chr(8)
     7251    + "reckey"        + chr(4) + "ключ записи с ошибкой"  + chr(4) + "" .
     7252     run proc-full-temp-changes in this-procedure (
     7253                                                  input current_c-utd-err.action = integer('1':U)
     7254                                                 ,input current_c-utd-err.action = integer('99':U)
     7255                                                 ,input  buffer current_c-utd-err:handle
     7256                                                 ,input  "utd-err"
     7257                                                 ,input  "CheckType,CodeErr,CheckObj,reckey,LineNum"
     7258                                                 ,input  v-label-param).
     7259   end.
     7260   end procedure.
     7261   procedure utd-err-attr-proc :
     7262   define output parameter p-description as character no-undo .
     7263   define buffer current_c-utd-err-attr for ub.c-utd-err-attr  .
     7264   define variable v-mess as character no-undo.
     7265      do
     7266      on error undo, return error return-value
     7267      :
     7268        find first current_c-utd-err-attr no-lock where
     7269                     current_c-utd-err-attr.db-num = X_c-obj-hist.db-num
     7270                 and current_c-utd-err-attr.doc-id = X_c-obj-hist.doc-id
     7271                 and current_c-utd-err-attr.CheckType = X_c-obj-hist.CheckType
     7272                 and current_c-utd-err-attr.CodeErr = X_c-obj-hist.CodeErr
     7273                 and current_c-utd-err-attr.CheckObj = X_c-obj-hist.CheckObj
