      143   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      144   define variable c-point  as character no-undo .
      145   define variable tbl      as character no-undo .
      146   define variable join-tbl as character no-undo .
      147   define variable fld      as character no-undo .
      148   define variable lab      as character no-undo .
      149   define variable spr      as character no-undo .
      150   define variable dim      as character no-undo .
      151   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      152   procedure cur-time :
      153      define output parameter p-today as date      no-undo .
      154      define output parameter p-time  as integer   no-undo .
      155     do
      156     on error undo, return error
      157     :
      158       define variable v-date1 as date      no-undo .
      159       define variable v-date2 as date      no-undo .
      160       define variable v-time  as integer   no-undo .
      161       assign
      162         v-date1 = today
      163         v-time  = time
      164         v-date2 = today
      165       .
      166       if v-date1 <> v-date2
      167       then do:
      168         assign
      169           v-date1 = today
      170           v-time  = v-time
      171         .
      172       end.
      173       assign
      174         p-today = v-date1
      175         p-time  = v-time
      176       .
      177     end.
      178   end.
      179   function cur-time-date returns character
      180   :
      181     return string(today, '99/99/9999':U) .
      182   end.
      183   function cur-time-mjd returns decimal
      184   :
      185     define variable v-date as date      no-undo .
      186     define variable v-time as integer   no-undo .
      187     run cur-time in this-procedure
      188       (output v-date
      189       ,output v-time
      190       ) .
      191     return integer(v-date) - 2400002 + (v-time / 86400) .
      192   end.
      193   function cur-time-get-ending-index returns integer
      194   (input p-number as integer
      195   )
      196   :
      197     if p-number < 0
      198     or p-number = ?
      199     then do:
      200       return 1 .
      201     end.
      202     define variable v-rest as integer   no-undo .
      203     assign
      204       p-number = p-number modulo 100
      205     .
      206     if p-number < 20
      207     then do:
      208       assign
      209         v-rest = p-number
      210       .
      211     end.
      212     else do:
      213       assign
      214         v-rest = p-number modulo 10
      215       .
      216     end.
      217     case v-rest :
      218       when 1
      219       then do:
      220         return 2 .
      221       end.
      222       when 2 or
      223       when 3 or
      224       when 4
      225       then do:
      226         return 3 .
      227       end.
      228       otherwise do:
      229         return 1 .
      230       end.
      231     end case .
      232   end.
      233   procedure cur-time-mjd-to-date :
      234      define input  parameter i-mjd-diff as decimal no-undo.
      235      define output parameter o-Date     as date    no-undo.
      236      define output parameter o-Time     as integer no-undo.
      237      define variable v-day-number as integer   no-undo .
      238      if    i-mjd-diff < 0
      239         or i-mjd-diff = ?
      240      then do:
      241         return "?" .
      242      end.
      243      assign
      244         v-day-number = truncate(i-mjd-diff,0).
      245         o-Date = date(v-day-number + 2400002).
      246         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      247     .
      248   end.
      249   function cur-time-mjd-to-string returns character
      250   (input p-mjd-diff as decimal
      251   )
      252   :
      253     define variable v-day-number as integer   no-undo .
      254     define variable v-seconds    as integer   no-undo .
      255     define variable v-hour       as integer   no-undo .
      256     define variable v-min        as integer   no-undo .
      257     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      258     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      259     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      260     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      261     if p-mjd-diff < 0
      262     or p-mjd-diff = ?
      263     then do:
      264       return "?" .
      265     end.
      266     assign
      267       v-day-number = integer(truncate(p-mjd-diff,0))
      268       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      269     .
      270     if v-seconds > 86400
      271     then do:
      272       assign
      273         v-seconds = 86400 - 1
      274       .
      275     end.
      276     if v-seconds < 0
      277     then do:
      278       assign
      279         v-seconds = 0
      280       .
      281     end.
      282     assign
      283       v-hour = truncate(v-seconds / 3600, 0)
      284     .
      285     assign
      286       v-seconds = v-seconds modulo 3600
      287     .
      288     assign
      289       v-min = truncate(v-seconds / 60, 0)
      290     .
      291     assign
      292       v-seconds = v-seconds modulo 60
      293     .
      294     return
      295         (if v-day-number <> 0
      296           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      297           else ""
      298         )
      299       + (if v-day-number <> 0 or v-hour <> 0
      300           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      301           else ""
      302         )
      303       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      304           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      305           else ""
      306         )
      307       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      308       .
      309   end.
      310   function cur-time-string returns character
      311   :
      312     define variable v-date as date      no-undo .
      313     define variable v-time as integer   no-undo .
      314     run cur-time in this-procedure
      315       (output v-date
      316       ,output v-time
      317       ) .
      318     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      319   end.
      320   function cur-time-string-sec returns character
      321   :
      322     define variable v-date as date      no-undo .
      323     define variable v-time as integer   no-undo .
      324     run cur-time in this-procedure
      325       (output v-date
      326       ,output v-time
      327       ) .
      328     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      329   end.
      330   function cur-time-custom  returns character
      331   (input p-prefix as character
      332   ,input p-date-format as character
      333   ,input p-delimiter as character
      334   ,input p-time-format as character
      335   ,input p-suffix as character
      336   )
      337   :
      338     define variable v-date as date      no-undo .
      339     define variable v-time as integer   no-undo .
      340     run cur-time in this-procedure
      341       (output v-date
      342       ,output v-time
      343       ) .
      344     return
      345       p-prefix
      346       + string(v-date, p-date-format)
      347       + p-delimiter
      348       + string(v-time, p-time-format)
      349       + p-suffix
      350       .
      351   end.
      352   function cur-time-print  returns character
      353   :
      354     define variable v-date as date      no-undo .
      355     define variable v-time as integer   no-undo .
      356     run cur-time in this-procedure
      357       (output v-date
      358       ,output v-time
      359       ) .
      360     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      361   end.
      362   function cur-time-datetime returns datetime
      363   :
      364     define variable v-char as character no-undo .
      365     define variable v-datetime as datetime no-undo .
      366     v-char = cur-time-string().
      367     v-datetime = datetime(v-char).
      368     return  v-datetime.
      369   end.
      370   function cur-time-string-msec returns character
      371   :
      372     define variable v-date as datetime  no-undo .
      373     v-date = now.
      374     return string(v-date) .
      375   end.
      376   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      377   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      378   define new shared variable RepPathName        as character no-undo .
      379   define new shared variable PrintRubl          as logical   no-undo .
      380   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      381   define variable v-waitfram-action01         as character   no-undo .
      382   define variable v-waitfram-action02         as character   no-undo .
      383   define variable v-waitfram-action03         as character   no-undo .
      384   define variable mWaitFramTextBeg            as character   no-undo.
      385   define variable mWaitFramTextEnd            as character   no-undo.
      386   define variable mWaitFramView               as logical     no-undo.
      387   define variable mWaitProcEvent              as logical     no-undo init yes.
      388   define variable mWaitFramInterval           as integer     no-undo init 1 .
      389   define variable mWaitFramStop               as logical     no-undo.
      390   define variable mWaitFramStopUser           as logical     no-undo.
      391   define variable mWaitFramStopTimeOut        as logical     no-undo.
      392   define variable mWaitFramStartProc          as datetime-tz no-undo.
      393   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      394   define button B-WaitFramStop auto-end-key
      395        label "Стоп"
      396        size 10 by 1 tooltip "Остоновить процесс".
      397   define button B-viewProcInfo
      398        label "Информация"
      399        size 15 by 1 tooltip "Информация о процесс".
      400   define frame waitfram
      401     v-waitfram-action01 format "x(72)" no-label skip
      402     v-waitfram-action02 format "x(72)" no-label skip
      403     v-waitfram-action03 format "x(72)" no-label skip
      404     B-viewProcInfo
      405     B-WaitFramStop at row 4 col 30
      406     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      407     .
      408   define new global shared variable mBatchMode as logical no-undo init ?.
      409   define variable mFramBachModHandle as handle no-undo.
      410   mFramBachModHandle = frame waitfram:handle.
      411   define variable mFameOldVis as logical no-undo.
      412   define variable mVisCUrentVin as logical no-undo.
      413   if session:batch-mode
      414   then
      415      mBatchMode = yes.
      416   if mBatchMode = ? then do:
      417     mVisCUrentVin = current-window:visible.
      418     mFameOldVis = mFramBachModHandle:visible.
      419     mFramBachModHandle:visible  = yes.
      420     mBatchMode = mFramBachModHandle:visible ne yes.
      421     mFramBachModHandle:visible = mFameOldVis.
      422     current-window:visible = mVisCUrentVin.
      423   end.
      424    if  log-manager:logfile-name ne ?
      425     then DO:
      426         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      427         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      428         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      429     end.
      430   on choose of B-WaitFramStop in frame waitfram
      431   do:
      432     mWaitFramStop = yes.
      433     mWaitFramStopUser = yes.
      434   end.
      435   function waitfram-check-timeout returns logical():
      436      define variable vtime as int64 no-undo.
      437      if mWaitFramStopTimeOut
      438      then
      439         return yes.
      440      vtime = ( now - mWaitFramStartProc ) / 1000 .
      441      if     mWaitFramTimeOut ne ?
      442         and mWaitFramTimeOut ne 0
      443         and mWaitFramTimeOut lt vtime
      444      then do:
      445         mWaitFramStopTimeOut = yes.
      446      end.
      447      return mWaitFramStopTimeOut.
      448   end.
      449   procedure waitfram-hide :
      450     if not session:batch-mode
      451     then do
      452     on error undo, return error return-value
      453     :
      454       pause 0 before-hide .
      455       if not mBatchMode then
      456         hide frame waitfram .
      457     end.
      458   end procedure.
      459   procedure waitfram-show :
      460     define input  parameter p-message as character no-undo .
      461     define variable v-left-margin as integer   no-undo .
      462     if not session:batch-mode
      463     then do
      464     on error undo, return error return-value
      465     :
      466       if length(p-message) <= 70 then do:
      467         assign
      468           v-left-margin = integer((70 - length(p-message)) / 2)
      469         .
      470         assign
      471           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      472         .
      473         assign
      474           v-waitfram-action01 = " "
      475           v-waitfram-action02 = " "
      476                                    + fill(" ", v-left-margin)
      477                                    + p-message
      478           v-waitfram-action03 = " "
      479         .
      480       end.
      481       else do:
      482         define variable vRindex1 as integer no-undo.
      483         define variable vRindex2 as integer no-undo.
      484         vRindex1 = r-index(p-message," ",70).
      485         if vRindex1 = 0
      486         then
      487            vRindex1 = 70.
      488         if length(p-message)  <= vRindex1 + 70 then do:
      489           assign
      490             v-waitfram-action01 = " "
      491             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      492             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      493           .
      494         end.
      495         else do:
      496           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      497           if vRindex2 <= vRindex1
      498           then
      499              vRindex2 = vRindex1 + 70.
      500           assign
      501             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      502             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      503             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      504           .
      505         end.
      506       end.
      507       B-viewProcInfo:visible   in frame waitfram = no.
      508       B-viewProcInfo:sensitive in frame waitfram = no.
      509       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      510       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      511       if  (   mWaitFramView
      512          or  mWaitProcEvent)
      513          and not mBatchMode
      514       then
      515          display
      516             v-waitfram-action01 skip
      517             v-waitfram-action02 skip
      518             v-waitfram-action03 skip
      519          with frame waitfram .
      520     end.
      521   end procedure.
      522      procedure waitfram-show-this:
      523         define input  parameter iInterval as int64 no-undo.
      524         define variable vtime as int64 no-undo.
      525         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      526         mWaitFramInterval = iInterval.
      527         run waitfram-show (substitute("&1&2 &3&4" ,
      528                                       mWaitFramTextBeg ,
      529                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      530                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      531                                       mWaitFramTextEnd
      532                                      )
      533                           ).
      534      end.
      535      procedure WaitFramRunPause:
      536         define input  parameter iInterval as dec no-undo.
      537         define variable vStart  as datetime-tz no-undo.
      538         define variable vend    as datetime-tz no-undo.
      539         define variable vint as int64 no-undo.
      540         define variable vOk as logical no-undo.
      541         vStart = now.
      542         vend   = vStart.
      543         publish "WaitFramPause" (iInterval,output vOk).
      544         vend   =  now.
      545         vint = vend - vStart.
      546         vint = iInterval - vint / 1000.
      547         if     not mWaitFramStop
      548            and (   vint > 0
      549                 or (    not vOk
      550                     and iInterval eq ?
      551                     )
      552                 )
      553         then
      554            run waitfram-show-this (iInterval).
      555         vend   =  now.
      556         vint = vend - vStart.
      557         vint = iInterval - vint / 1000.
      558         if     not mWaitFramStop
      559            and vint > 0
      560         then do:
      561            run gbl/pause.p (vint * 1000).
      562         end.
      563         if iInterval ne ?
      564         then
      565            publish "WaitFramStop".
      566         waitfram-check-timeout().
      567      end.
      568      procedure WaitFramWaitFor:
      569         define input  parameter iInterval as dec no-undo.
      570         assign
      571            mWaitFramStartProc   = now
      572            mWaitFramStopUser    = no
      573            mWaitFramStopTimeOut = no
      574         .
      575         block-wait:
      576         do while not mWaitFramStop:
      577            run WaitFramRunPause (iInterval).
      578            if  waitfram-check-timeout()
      579            then do:
      580               leave block-wait.
      581            end.
      582         end.
      583         run waitfram-hide.
      584      end.
      585   procedure waitfram-join :
      586     define input  parameter p-line-1  as character no-undo .
      587     define input  parameter p-line-2  as character no-undo .
      588     define input  parameter p-line-3  as character no-undo .
      589     define output parameter p-message as character no-undo .
      590     do
      591     on error undo, return error return-value
      592     :
      593       assign
      594         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      595                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      596                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      597       .
      598     end.
      599   end procedure.
      600   function waitfram-join-function returns character
      601     (input p-line-1 as character
      602     ,input p-line-2 as character
      603     ,input p-line-3 as character
      604     ).
      605     define variable v-message as character no-undo .
      606     run waitfram-join in this-procedure
      607       (input  p-line-1
      608       ,input  p-line-2
      609       ,input  p-line-3
      610       ,output v-message
      611       ) .
      612     return v-message .
      613   end function .
      614   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      615   procedure fltfield-clear :
      616     define output parameter loc-fld as character no-undo.
      617     define output parameter loc-lab as character no-undo .
      618     define output parameter loc-spr as character no-undo .
      619     define output parameter loc-dim as character no-undo .
      620     assign
      621       loc-fld = ""
      622       loc-lab = ""
      623       loc-spr = ""
      624       loc-dim = "0"
      625     .
      626   end procedure .
      627   procedure fltfield-add :
      628     define input        parameter par-fld as character no-undo.
      629     define input        parameter par-lab as character no-undo .
      630     define input        parameter par-spr as character no-undo .
      631     define input-output parameter loc-fld as character no-undo.
      632     define input-output parameter loc-lab as character no-undo .
      633     define input-output parameter loc-spr as character no-undo .
      634     define input-output parameter loc-dim as character no-undo .
      635     do
      636     on error undo, return error
      637     :
      638       assign
      639       loc-fld = if loc-dim = '0'
      640                 then par-fld
      641                 else (loc-fld + chr(44) + par-fld)
      642       loc-lab = if loc-dim = '0'
      643                 then par-lab
      644                 else (loc-lab + chr(44) + par-lab)
      645       loc-spr = if loc-dim = '0'
      646                 then par-spr
      647                 else (loc-spr + chr(44) + par-spr)
      648       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      649                 string(integer(if num-entries(loc-dim) > 1
      650                               then entry(2, loc-dim)
      651                               else entry(1, loc-dim)
      652                               ) + 1)
      653       no-error
      654       .
      655     end.
      656   end procedure.
