      680       DO:
      681         Message
      682           "Нет заданий на печать ! "
      683           view-as alert-box .
      684         Return  .
      685       End.
      686       run gbl/prnfilen.w
      687         (input  ""
      688         ,input  p-DisabledOptions
      689         ,input  string(v-report-name )
      690         ,input  7
      691         ,output v-user-action
      692         ,output v-printed
      693         ) .
      694       if v-printed then
      695       do:
      696         return "YES" .
      697       end.
      698       else
      699       do:
      700         return "NO" .
      701       end.
