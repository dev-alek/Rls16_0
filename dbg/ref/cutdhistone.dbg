     2940   procedure get-context :
     2941      define output parameter p-db-num as integer          no-undo.
     2942      define output parameter p-user-id as character        no-undo.
     2943      define variable v-login               as character    no-undo.
     2944      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2945      define buffer buf_user-login  for ub.user-login .
     2946      do
     2947      on error undo, return error
     2948      :
     2949            FIND FIRST buf_sys-ctrl no-lock.
     2950            ASSIGN
     2951               v-login = USERID("ub")
     2952               p-db-num = buf_sys-ctrl.db-num
     2953            .
     2954            FIND FIRST buf_user-login
     2955                 WHERE buf_user-login.db-num = p-db-num
     2956                   AND buf_user-login.user-login = v-login
     2957                 no-lock
     2958                 no-error
     2959                 .
     2960            IF AVAILABLE buf_user-login
     2961            THEN DO:
     2962               assign
     2963                  p-user-id = buf_user-login.user-id
     2964               .
     2965            END.
     2966      end.
     2967   end procedure.
