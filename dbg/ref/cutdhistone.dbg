     1606   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1607   DO:
     1608     if ( available X_c-obj-hist ) then do:
     1609       if ( v-rid-list = "" ) or b-mark:sensitive = no
     1610       then
     1611       v-rid-list = string( recid( X_c-obj-hist ) ) .
     1612     end.
     1613   END.
     1614   ON MOUSE-SELECT-DBLCLICK OF br-obj-hist IN FRAME Dialog-Frame
     1615   DO:
     1616        run proc-br-obj-hist in this-procedure no-error.
     1617     if error-status:error then return no-apply.
     1618   END.
     1619   ON RETURN OF br-obj-hist IN FRAME Dialog-Frame
     1620   DO:
     1621       run proc-br-obj-hist in this-procedure no-error.
     1622     if error-status:error then return no-apply.
     1623   END.
     1624   ON VALUE-CHANGED OF br-obj-hist IN FRAME Dialog-Frame
     1625   DO:
     1626     run proc-view-changes in this-procedure no-error.
     1627   END.
     1628   ON ROW-DISPLAY OF BR-changes IN FRAME Dialog-Frame
     1629   DO:
     1630      if temp-changes.fNotChange
     1631      then do:
     1632         temp-changes.l_name:fGCOLOR in browse BR-changes = GRAY_COLOR.
     1633         temp-changes.v_old:fGCOLOR in browse BR-changes  = GRAY_COLOR.
     1634         temp-changes.v_new:fGCOLOR in browse BR-changes  = GRAY_COLOR.
     1635      end.
     1636      else do:
     1637         temp-changes.l_name:fGCOLOR in browse BR-changes = BLACK_COLOR.
     1638         temp-changes.v_old:fGCOLOR in browse BR-changes = BLACK_COLOR.
     1639         temp-changes.v_new:fGCOLOR in browse BR-changes = BLACK_COLOR.
     1640      end.
     1641   END.
     1642   ON CTRL-J OF sch-obj-code IN FRAME Dialog-Frame
     1643   DO:
     1644     run proc-find-obj-code in this-procedure(yes, input frame Dialog-Frame sch-obj-code) no-error.
     1645     if error-status:error then return no-apply.
     1646   END.
     1647   ON RETURN OF sch-obj-code IN FRAME Dialog-Frame
     1648   DO:
     1649     run proc-find-obj-code in this-procedure(no, input frame Dialog-Frame sch-obj-code) no-error.
     1650     if error-status:error then return no-apply.
     1651   END.
     1652   ON CTRL-J OF sch-corr-date IN FRAME Dialog-Frame
