     1064   define buffer X_clients-sysconf for ub.clients.
     1065   define buffer X_clients-obj for ub.clients.
     1066   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1067   define   temp-table temp-changes no-undo
     1068   field f_name as character
     1069   field l_name as character
     1070   field v_old as character
     1071   field v_new as character
     1072   field t_name as character
     1073   field num_ as integer
     1074   field uniq-key-rec as character
     1075   field action as integer
     1076   field fNotChange as logical
     1077   index pi is unique primary
     1078   num_
     1079   t_name
     1080   f_name
     1081   index
     1082   Chan
     1083   fnotChange
     1084   t_name
     1085   f_name
     1086   index imain uniq-key-rec
     1087   .
     1088   FUNCTION get-all-fields returns character (p-file-name as character ):
     1089   define variable v-dop as character no-undo .
     1090     find first _file no-lock where _file._file-name = p-file-name no-error .
     1091     if not available _file then return "":U.
     1092     for each _field no-lock where
     1093              _field._file-recid = recid(_file) :
     1094       assign
     1095       v-dop = v-dop + _field._field-name + chr(44)
     1096       .
     1097     end.
     1098     return trim(v-dop).
     1099   END FUNCTION.
     1100   PROCEDURE proc-full-temp-changes :
     1101     define input  parameter p-act-create as logical   no-undo .
     1102     define input  parameter p-act-delete as logical   no-undo .
     1103     define input  parameter p-hst-handle as handle    no-undo .
     1104     define input  parameter p-main-table as character no-undo .
     1105     define input  parameter p-field-list as character no-undo .
     1106     define input  parameter p-label-form as character no-undo .
     1107     define variable h-new-buf         as handle    no-undo .
     1108     define variable h-main-buf        as handle    no-undo .
     1109     define variable h-for-comp        as handle    no-undo .
     1110     define variable v-inform          as character no-undo .
     1111     define variable v-ind             as integer   no-undo .
     1112     define variable v-idx-field-qnty  as integer   no-undo .
     1113     define variable v-num-entries     as integer   no-undo .
     1114     define variable fh                as handle    no-undo .
     1115     define variable fh-main           as handle    no-undo .
     1116     define variable fh-old            as handle    no-undo .
     1117     define variable fh-new            as handle    no-undo .
     1118     define variable v-field-name      as character no-undo .
     1119     define variable v-field-lvl       as character no-undo .
     1120     define variable v-field-form      as character no-undo .
     1121     define variable v-search-exp      as character no-undo .
     1122     define variable v-srch-main       as character no-undo .
     1123     define variable v-word-link       as character no-undo .
     1124     define variable v-av-chip-num     as logical   no-undo .
     1125     define variable v-main-pi-fld-lst as character no-undo .
     1126     define variable v-main-fld-lst    as character no-undo .
     1127     define variable v-delim-list      as character no-undo .
     1128     define variable v-label           as character no-undo .
     1129     define variable v-old-value       as character no-undo case-sensitive.
     1130     define variable v-new-value       as character no-undo case-sensitive.
     1131     define variable v-chg-fields as character no-undo.
     1132     for each temp-changes:
     1133       delete temp-changes.
     1134     end.
     1135     if not p-hst-handle:available then do:
     1136       return .
     1137     end.
     1138     create buffer h-new-buf  for table p-hst-handle .
     1139     create buffer h-main-buf for table p-main-table .
     1140     assign
     1141       v-inform = h-main-buf:index-information(1)
     1142       v-ind    = 2
     1143     .
     1144     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1145     on error undo, return error
     1146     :
     1147       assign
     1148         v-inform = h-main-buf:index-information( v-ind )
     1149         v-ind    = v-ind + 1
     1150       .
     1151     end.
     1152     if v-inform = ?
     1153       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1154       or entry( 3, v-inform, ",":U ) <> "1":U
     1155     then do:
     1156       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1157     end.
     1158     assign
     1159       v-idx-field-qnty = num-entries( v-inform ) - 4
     1160     .
     1161     if v-idx-field-qnty < 2 then do:
     1162       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1163     end.
     1164     assign
     1165       v-srch-main   = "where":U
     1166       v-word-link   = "":U
     1167       v-av-chip-num = false
     1168       v-delim-list  = "":U
     1169     .
     1170     do v-ind = 1 to v-idx-field-qnty by 2
     1171     on error undo, return error
     1172     :
     1173       assign
     1174         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1175         fh                = p-hst-handle:buffer-field( v-field-name )
     1176         fh-main           = h-main-buf:buffer-field( v-field-name )
     1177         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1178         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1179       .
     1180       if fh:data-type ="character":U then do:
     1181         assign
     1182           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1183         .
     1184       end.
     1185       else do:
     1186         assign
     1187           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1188         .
     1189       end.
     1190       if v-delim-list = "":U then do:
     1191         assign
     1192           v-delim-list = ",":U
     1193         .
     1194       end.
     1195       if v-word-link = "":U then do:
     1196         assign
     1197           v-word-link = "and":U
     1198         .
     1199       end.
     1200     end.
     1201     assign
     1202       v-delim-list  = "":U
     1203     .
     1204     do v-ind = 1 to h-main-buf:num-fields
     1205     on error undo, return error
     1206     :
     1207       assign
     1208         fh-main      = h-main-buf:buffer-field( v-ind )
     1209         v-field-name = fh-main:name
     1210       .
     1211         assign
     1212           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1213         .
     1214         if v-delim-list = "":U then do:
     1215           assign
     1216             v-delim-list = ",":U
     1217           .
     1218         end.
     1219     end.
     1220     assign
     1221       v-inform = p-hst-handle:index-information(1)
     1222       v-ind    = 2
     1223     .
     1224     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1225     on error undo, return error
     1226     :
     1227       assign
     1228         v-inform = p-hst-handle:index-information( v-ind )
     1229         v-ind    = v-ind + 1
     1230       .
     1231     end.
     1232     if v-inform = ?
     1233       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1234       or entry( 3, v-inform, ",":U ) <> "1":U
     1235     then do:
     1236       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1237     end.
     1238     assign
     1239       v-idx-field-qnty = num-entries( v-inform ) - 4
     1240     .
     1241     if v-idx-field-qnty < 2 then do:
     1242       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1243     end.
     1244     assign
     1245       v-search-exp  = "where":U
     1246       v-word-link   = "":U
     1247       v-av-chip-num = false
     1248     .
     1249     do v-ind = 1 to v-idx-field-qnty by 2
     1250     on error undo, return error
     1251     :
     1252       assign
     1253         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1254         fh           = p-hst-handle:buffer-field( v-field-name )
     1255         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1256       .
     1257       if v-field-name = "chip-num":U then do:
     1258         assign
     1259           v-search-exp  = substitute( "&1 >", v-search-exp )
     1260           v-av-chip-num = true
     1261         .
     1262       end.
     1263       else do:
     1264         assign
     1265           v-search-exp = substitute( "&1 =", v-search-exp )
     1266         .
     1267       end.
     1268       if fh:data-type ="character":U then do:
     1269         assign
     1270           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1271         .
     1272       end.
     1273       else do:
     1274         assign
     1275           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1276         .
     1277       end.
     1278       if v-word-link = "":U then do:
     1279         assign
     1280           v-word-link = "and":U
     1281         .
     1282       end.
     1283     end.
     1284     if v-av-chip-num = false then do:
     1285       message
     1286         vss-workfile vss-revision vss-description skip
     1287         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1288         "Использование данной процедуры невозможно!" skip
     1289         view-as alert-box error .
     1290       return error .
     1291     end.
     1292     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1293     if not h-new-buf:available then do:
     1294       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1295       if not h-main-buf:available then do:
     1296         assign
     1297           h-for-comp = ?
     1298         .
     1299       end.
     1300       else do:
     1301         assign
     1302           h-for-comp = h-main-buf
     1303         .
     1304       end.
     1305     end.
     1306     else do:
     1307       assign
     1308         h-for-comp = h-new-buf
     1309       .
     1310     end.
     1311     assign
     1312       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1313     .
     1314     do v-ind = 1 to v-num-entries
     1315     on error undo, return error return-value
     1316     :
     1317       assign
     1318         v-field-name = entry( v-ind, v-main-fld-lst )
     1319         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1320         v-old-value  = fh-old:buffer-value()
     1321         v-label      = trim( fh-old:label )
     1322       .
     1323       if ( trim( p-field-list ) <> "":U
     1324            and lookup( v-field-name, p-field-list ) > 0
     1325          )
     1326          or trim( p-field-list ) = "":U
     1327       then do:
     1328         if h-for-comp <> ? then do:
     1329           assign
     1330             fh-new      = h-for-comp:buffer-field( v-field-name )
     1331             v-new-value = fh-new:buffer-value()
     1332           .
     1333         end.
     1334         else do:
     1335           assign
     1336             v-new-value = "":U
     1337           .
     1338         end.
     1339           if p-act-create = true then do:
     1340             assign
     1341               v-old-value = "":U
     1342             .
     1343           end.
     1344           if p-act-delete = true then do:
     1345             assign
     1346               v-new-value = "":U
     1347             .
     1348           end.
     1349         if v-old-value <> v-new-value
     1350           or lookup(v-field-name,v-main-pi-fld-lst) ne 0
     1351         then do:
     1352           create temp-changes.
     1353           assign
     1354             temp-changes.t_name = p-main-table
     1355             temp-changes.f_name = v-field-name
     1356             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1357             temp-changes.v_old  = trim( v-old-value )
     1358             temp-changes.v_new  = trim( v-new-value )
     1359             temp-changes.num_   = 0
     1360             temp-changes.fNotChange = v-old-value eq v-new-value
     1361           .
     1362         end.
     1363       end.
     1364     end.
     1365     assign
     1366       v-num-entries = num-entries( p-label-form, chr(8) )
     1367     .
     1368     do v-ind = 1 to v-num-entries
     1369     on error undo, return error return-value
     1370     :
     1371       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1372         assign
     1373           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1374           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1375           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1376         .
     1377         find first temp-changes
     1378           where temp-changes.f_name = v-field-name
     1379           no-error .
     1380         if available temp-changes then do:
     1381           if trim( v-field-lvl ) <> "":U then do:
     1382             assign
     1383               temp-changes.l_name = v-field-lvl
     1384             .
     1385           end.
     1386           if trim( v-field-form ) <> "":U then do:
     1387             assign
     1388               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1389             .
     1390             if h-for-comp <> ? then do:
     1391               assign
     1392                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1393               .
     1394             end.
     1395           end.
     1396         end.
     1397       end.
     1398       else do:
     1399         message
     1400           vss-workfile vss-revision vss-description skip
     1401           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1402           substitute( "список для поля '&1': '&2'"
     1403                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1404                       ,entry( v-ind, p-label-form, chr(8) )
     1405                     ) skip
     1406           substitute( "полный список: &2", p-label-form ) skip
     1407           view-as alert-box error .
     1408       end.
     1409     end.
     1410     delete object h-new-buf .
     1411     delete object h-main-buf .
     1412   END PROCEDURE.
     1413   FUNCTION get-action RETURNS CHARACTER
     1414     ( p-action as integer )  FORWARD.
     1415   FUNCTION get-source-type RETURNS CHARACTER
     1416     ( p-source-type as character )  FORWARD.
     1417   FUNCTION get-subject RETURNS CHARACTER
     1418     ( p-subject as character )  FORWARD.
     1419   FUNCTION local-open-br RETURNS logical
     1420     (  p-open-query     as logical    ,
     1421     p-find-next       as logical    ,
     1422     p-find-condition as character )  FORWARD.
     1423   DEFINE BUTTON B-Help
     1424        LABEL "Помо&щь"
     1425        SIZE 3 BY 1
     1426        BGCOLOR 8 .
     1427   DEFINE BUTTON B-mark
     1428        LABEL "&*"
     1429        SIZE 3 BY 1.
     1430   DEFINE BUTTON B-print
     1431        LABEL "Пе&чать"
     1432        SIZE 3 BY 1.
     1433   DEFINE BUTTON b-quit AUTO-END-KEY
     1434        LABEL "&Выход"
     1435        SIZE 10 BY 1
     1436        BGCOLOR 8 .
     1437   DEFINE BUTTON b-reason
     1438        LABEL "&Причина"
     1439        SIZE 10 BY 1.
     1440   DEFINE BUTTON B-sch
     1441        LABEL "&Фильтр"
     1442        SIZE 3 BY 1.
     1443   DEFINE BUTTON b-sel AUTO-GO
     1444        LABEL "Вы&бор"
     1445        SIZE 10 BY 1
     1446        BGCOLOR 8 .
     1447   DEFINE BUTTON b-nextlevel
     1448        LABEL "Детали"
     1449        SIZE 10 BY 1
     1450        BGCOLOR 8 .
     1451   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1452         VIEW-AS TEXT
     1453        SIZE 6 BY 1
     1454        FGCOLOR 4  NO-UNDO.
     1455   DEFINE VARIABLE sch-obj-code AS CHARACTER FORMAT "X(50)":U
     1456        LABEL "коду"
     1457        VIEW-AS FILL-IN
     1458        SIZE 10 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1459   DEFINE VARIABLE sch-corr-date AS DATE FORMAT "99/99/9999":U
     1460        LABEL "Дате изменения"
     1461        VIEW-AS FILL-IN
     1462        SIZE 11 BY 1 NO-UNDO.
     1463   DEFINE VARIABLE sch-corr-user-name AS CHARACTER FORMAT "X(9)":U
     1464        LABEL "пользователю"
     1465        VIEW-AS FILL-IN
     1466        SIZE 12 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1467   DEFINE VARIABLE sch-db-num AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1468        LABEL "БД"
     1469        VIEW-AS FILL-IN
     1470        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1471   DEFINE VARIABLE v-corr-user-db-num AS INTEGER FORMAT ">>>>9":U INITIAL 0
     1472        LABEL "по БД"
     1473        VIEW-AS FILL-IN
     1474        SIZE 6 BY 1 NO-UNDO.
     1475   DEFINE QUERY BR-changes FOR
     1476         temp-changes SCROLLING.
     1477   DEFINE QUERY br-obj-hist FOR
     1478         X_c-obj-hist SCROLLING.
     1479   DEFINE BROWSE BR-changes
     1480     QUERY BR-changes DISPLAY
     1481         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(200)" width 40
     1482   temp-changes.v_old COLUMn-LABEL "Было" format "X(255)"
     1483   temp-changes.v_new COLUMn-LABEL "Стало" format "X(255)"
     1484       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.25.
     1485   DEFINE BROWSE br-obj-hist
     1486     QUERY br-obj-hist NO-LOCK DISPLAY
     1487         mark-string(recid(X_c-obj-hist), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1488         X_c-obj-hist.corr-date FORMAT "99/99/9999":U COLUMN-LABEL "Дата изм."
     1489         string(X_c-obj-hist.corr-time, "HH:MM:SS":U) COLUMN-LABEL "Время изм." FORMAT "X(8)":U
     1490         usrfulnf(X_c-obj-hist.corr-user-name) COLUMn-LABEL "Изменил" FORMAT "X(255)":U width 18
     1491         get-action(X_c-obj-hist.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1492         X_c-obj-hist.corr-user-db-num FORMAT ">>>>9":U COLUMN-LABEL "Дб!созд."
     1493         X_c-obj-hist.is-news FORMAT "+/":U COLUMN-LABEL "Прием.!нов."
     1494         get-source-type(X_c-obj-hist.source-type) COLUMN-LABEL "Источн.!измен." WIDTH 7
     1495         X_c-obj-hist.source-ref FORMAT "X(20)":U COLUMN-LABEL "Ссылка на!источник." WIDTH 9
     1496          get-subject(X_c-obj-hist.subject) COLUMN-LABEL "Предмет изменения" FORMAT "X(35)":U WIDTH 15
     1497     ENABLE
     1498         X_c-obj-hist.corr-date
     1499       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.46.
     1500   DEFINE FRAME Dialog-Frame
     1501        b-quit AT ROW 1 COL 1
     1502        B-mark AT ROW 1 COL 11
     1503        b-sel AT ROW 1 COL 21
     1504        v-corr-user-db-num AT ROW 1 COL 37 COLON-ALIGNED
     1505        b-nextlevel AT ROW 1 COL 70
     1506        b-reason AT ROW 1 COL 59
     1507        B-print AT ROW 1 COL 89
     1508        B-sch AT ROW 1 COL 92
     1509        B-Help AT ROW 1 COL 95
     1510        br-obj-hist AT ROW 2 COL 1
     1511        sch-db-num AT ROW 13.63 COL 60.13 COLON-ALIGNED
     1512        sch-corr-date AT ROW 13.63 COL 85.75 COLON-ALIGNED
     1513        sch-obj-code AT ROW 13.67 COL 45.13 COLON-ALIGNED
     1514        sch-corr-user-name AT ROW 13.71 COL 22.5 COLON-ALIGNED
     1515        BR-changes AT ROW 14.79 COL 1
     1516        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1517        "ПОИСК ПО" VIEW-AS TEXT
     1518             SIZE 8.38 BY 1 AT ROW 13.63 COL 1.38
     1519             FGCOLOR 4
     1520        SPACE(89.48) SKIP(7.44)
     1521       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1522            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1523            TITLE
     1524            vLabel
     1525            CANCEL-BUTTON b-quit.
     1526   ASSIGN
     1527          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1528          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1529   ASSIGN
     1530          br-obj-hist:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     1531   ON GO OF FRAME Dialog-Frame
     1532   DO:
     1533     p-rid-list = v-rid-list.
     1534   END.
     1535   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1536   DO:
     1537     APPLY "END-ERROR":U TO SELF.
     1538   END.
     1539   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1540   DO:
     1541   define variable loc#log as logical no-undo .
     1542     if available X_c-obj-hist then do:
     1543   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1544   define variable v-str-recid15 as character no-undo .
     1545   define variable v-num-entry15 as integer   no-undo .
     1546   assign
     1547     v-str-recid15 = trim( string( recid( X_c-obj-hist ) , "->>>>>>>>>>>9":U ) )
     1548     v-num-entry15 = lookup( v-str-recid15 , v-rid-list )
     1549   .
     1550   if v-num-entry15 > 0 then do:
     1551     assign
     1552       entry( v-num-entry15, v-rid-list ) = "":U
     1553       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1554     .
     1555   end.
     1556   else do:
     1557     assign
     1558       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid15
     1559     .
     1560   end.
     1561       loc#log = br-obj-hist:refresh() .
     1562       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1563           loc#log = br-obj-hist:select-next-row ().
     1564           apply "VALUE-CHANGED" to br-obj-hist in frame Dialog-Frame.
     1565       end.
     1566       if num-entries( v-rid-list ) = 0
     1567       then
     1568           hide mark-num in frame Dialog-Frame.
     1569       else
     1570           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1571     end.
     1572     apply "entry" to br-obj-hist in frame Dialog-Frame.
     1573   END.
     1574   ON CHOOSE OF b-nextlevel IN FRAME Dialog-Frame
     1575   DO:
     1576      define variable vRun as character no-undo.
     1577      vRun = this-procedure:file-name.
     1578      run value(vRun)
     1579         (
     1580          p-dB-NUM-utd,
     1581          p-doc-id-utd,
     1582          parParentProc,
     1583          p-curr-host-code,
     1584          p-curr-obj-type,
     1585          p-curr-obj-code,
     1586          bttns,
     1587          "one",
     1588          p-corr-user-db-num,
     1589          p-corr-user-name,
     1590          p-subject,
     1591          p-db-num,
     1592          X_c-obj-hist.chip-num ,
     1593          input-output p-rid-list ).
     1594      apply "entry" to br-obj-hist in frame Dialog-Frame.
     1595   END.
     1596   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1597   DO:
     1598       run proc-b-print in this-procedure no-error.
     1599     if error-status:error then return no-apply.
     1600   END.
     1601   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
