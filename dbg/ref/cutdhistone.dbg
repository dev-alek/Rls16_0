     1682   ON RETURN OF v-corr-user-db-num IN FRAME Dialog-Frame
     1683   DO:
     1684     assign
     1685     v-corr-user-db-num
     1686     .
     1687     RUn OpenBR(yes, no, '':U, v-corr-user-db-num).
     1688   END.
     1689   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1690   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1691   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1692   on help of frame Dialog-Frame
     1693   do:
     1694     run gbl/app_help.p
     1695       (input this-procedure :file-name
     1696       ,input ''
     1697       ,input ?
     1698       ) no-error.
     1699     if error-status :error then do:
     1700       message
     1701         "Ошибка при вызове помощи"
     1702         error-status :get-message(1)
     1703         view-as alert-box .
     1704     end.
     1705   end.
     1706   run minbtn-set in this-procedure .
     1707   on choose of b-help in frame Dialog-Frame
     1708   do:
     1709     apply "help":u to frame Dialog-Frame .
     1710   end.
     1711   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1712   procedure minbtn-set :
     1713       do
     1714           on error undo, return error return-value
     1715           :
     1716           define variable ii              as integer       no-undo .
     1717           define variable fh              as widget-handle no-undo .
     1718           define variable hh              as widget-handle no-undo .
     1719           define variable v-h             as handle        extent 4 no-undo .
     1720           define variable v-name-button   as character     no-undo .
     1721           define variable v-help-old-x    as decimal       no-undo .
     1722           define variable v-help-old-y    as decimal       no-undo .
     1723           define variable v-help-old-size as decimal       no-undo .
     1724           define variable v-frame-width   as decimal       no-undo .
     1725           define variable jj              as integer       no-undo .
     1726           do
     1727               on error undo, return error
     1728               :
     1729               assign
     1730                   v-frame-width = frame Dialog-Frame:width - 0.3
     1731                   fh            = frame Dialog-Frame:first-child
     1732                   hh            = fh:first-child
     1733                   ii            = 1
     1734                   .
     1735               do while valid-handle(hh):
     1736                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1737                   do:
     1738                       case lc(hh:name) :
     1739                           when "b-help" then
     1740                               do:
     1741                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1742                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1743                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1744                                   hh:TOOLTIP = "Помощь" .
     1745                                   v-help-old-x = hh:column .
     1746                                   v-help-old-y = hh:row    .
     1747                                   v-help-old-size = hh:width .
     1748                                   hh:width-chars = 2.5 .
     1749                               end.
     1750                           when "b-print" then
     1751                               do:
     1752                                   hh:load-image("cmp/b-print.bmp":u) .
     1753                                   hh:TOOLTIP = "Печать" .
     1754                                   v-h[ii] = hh:handle .
     1755                                   ii = ii + 1 .
     1756                                   hh:width-chars = 3 .
     1757                               end.
     1758                           when "b-history" or
     1759                           when "b-hist" then
     1760                               do:
     1761                                   hh:load-image("cmp/b-hist.bmp":u) .
     1762                                   hh:TOOLTIP = "История" .
     1763                                   v-h[ii] = hh:handle .
     1764                                   ii = ii + 1 .
     1765                                   hh:width-chars = 3 .
     1766                               end.
     1767                           when "b-sch" then
     1768                               do:
     1769                                   hh:load-image("cmp/b-sch.bmp":u) .
     1770                                   hh:TOOLTIP = "Установка Фильтра" .
     1771                                   v-h[ii] = hh:handle .
     1772                                   ii = ii + 1 .
     1773                                   hh:width-chars = 3 .
     1774                               end.
     1775                           when "b-hist-user" then
     1776                               do:
     1777                                   hh:load-image("cmp/b-hist.bmp":u) .
     1778                                   hh:TOOLTIP = "История пользователя" .
     1779                                   ii = ii + 1 .
     1780                               end.
     1781                       end case.
     1782                   end.
     1783                   hh = hh:next-sibling.
     1784               end.
     1785               b-help:column = v-frame-width - b-help:width-chars.
     1786               jj = 0.
     1787               repeat ii = 4 to 1 by -1 :
     1788                   if valid-handle (v-h[ii] ) then
     1789                   do:
     1790                       jj  = jj + 1 .
     1791                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1792                       v-h[ii]:row    = v-help-old-y .
     1793                   end.
     1794               end.
     1795           end.
     1796       end.
     1797   end procedure.
     1798   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1799   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1800   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1801   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1802   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1803   define variable v-diasize-current-frame-height as decimal   no-undo .
     1804   define variable v-diasize-change-size          as logical   no-undo .
     1805   define variable v-diasize-resize-button        as handle    no-undo .
     1806   define variable v-diasize-wndmax               as logical   no-undo .
     1807   define variable v-diasize-wndstore             as logical   no-undo .
     1808   define variable v-diasize-proc-name            as character no-undo .
     1809   define variable v-diasize-browse-handle        as handle    no-undo .
     1810   define variable v-diasize-browse-number        as integer   no-undo .
     1811   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1812   define temp-table temp-diasize-handle no-undo
     1813     field handle-value  as handle
     1814     field save-position as decimal
     1815     index xpk is primary unique handle-value
     1816     .
     1817   define temp-table temp-browse-handle no-undo
     1818     field browse-type   as character
     1819     field browse-number as integer
     1820     field browse-handle as handle
     1821     field original-size as decimal
     1822     index xpk is primary unique browse-type browse-number
     1823     index xie browse-type browse-handle
     1824   .
     1825   procedure diasize_change-height :
     1826     define input  parameter p-change-value  as decimal   no-undo .
     1827     define input  parameter p-move-resize   as logical   no-undo .
     1828     define variable v-field-group-handle    as handle    no-undo .
     1829     define variable v-object-handle         as handle    no-undo .
     1830     define variable v-frame-height          as decimal   no-undo .
     1831     define variable v-frame-virtual-height  as decimal   no-undo .
     1832     define variable v-browse-height         as decimal   no-undo .
     1833     define variable v-window-height         as decimal   no-undo .
     1834     define variable v-window-virtual-height as decimal   no-undo .
     1835     define variable v-change-sign           as integer   no-undo .
     1836     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1837     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1838     if p-change-value > 0
     1839     then do:
     1840       if frame Dialog-Frame :height + p-change-value
     1841           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1842       then do:
     1843         assign
     1844           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1845                           - (frame Dialog-Frame :height-chars)
     1846         .
     1847         if p-change-value <= 0
     1848         then do:
     1849           run diasize_position-resize-button in this-procedure .
     1850           return .
     1851         end.
     1852       end.
     1853     end.
     1854     if p-change-value < 0
     1855     then do:
     1856       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1857       then do:
     1858         assign
     1859           p-change-value = v-diasize-orig-frame-height
     1860                          - (frame Dialog-Frame :height-chars)
     1861         .
     1862         if p-change-value >= 0
     1863         then do:
     1864           run diasize_position-resize-button in this-procedure .
     1865           return .
     1866         end.
     1867       end.
     1868     end.
     1869     if p-change-value >= 0
     1870     then do:
     1871       assign
     1872         v-change-sign = 1
     1873       .
     1874     end.
     1875     else do:
     1876       assign
     1877         v-change-sign = -1
     1878       .
     1879     end.
     1880     assign
     1881       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1882     .
     1883     if p-change-value = 0
     1884     then do:
     1885       run diasize_position-resize-button in this-procedure .
     1886       return .
     1887     end.
     1888     move_block:
     1889     do
     1890     on error undo move_block, retry move_block
     1891     :
     1892       if retry
     1893       then do:
     1894         do
     1895         on error undo move_block, leave move_block
     1896         :
     1897           if p-change-value > 0
     1898           then do:
     1899             for each buf_temp-diasize-handle
     1900             on error undo, next
     1901             :
     1902               assign
     1903                 v-object-handle = buf_temp-diasize-handle.handle-value
     1904               .
     1905               if v-object-handle <> v-diasize-resize-button
     1906               then do:
     1907                 assign
     1908                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1909                 .
     1910               end.
     1911             end.
     1912             assign
     1913               v-diasize-browse-handle :height = v-browse-height
     1914             .
     1915             for each buf_temp-browse-handle
     1916               where buf_temp-browse-handle.browse-type = 'height':u
     1917             on error undo, next
     1918             :
     1919               assign
     1920                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1921               .
     1922             end.
     1923             assign
     1924               frame Dialog-Frame :height = v-frame-height
     1925             .
     1926             if frame Dialog-Frame :scrollable = true
     1927             then do:
     1928               assign
     1929                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1930               .
     1931             end.
     1932             run diasize_position-resize-button in this-procedure .
     1933           end.
     1934           else do:
     1935             if frame Dialog-Frame :scrollable = true
     1936             then do:
     1937               assign
     1938                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1939               .
     1940             end.
     1941             assign
     1942               frame Dialog-Frame :height = v-frame-height
     1943             .
     1944             assign
     1945               v-diasize-browse-handle :height = v-browse-height
     1946             .
     1947             for each buf_temp-browse-handle
     1948               where buf_temp-browse-handle.browse-type = 'height':u
     1949             on error undo, next
     1950             :
     1951               assign
     1952                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1953               .
     1954             end.
     1955             for each buf_temp-diasize-handle
     1956             on error undo, next
     1957             :
     1958               assign
     1959                 v-object-handle = buf_temp-diasize-handle.handle-value
     1960               .
     1961               if v-object-handle <> v-diasize-resize-button
     1962               then do:
     1963                 assign
     1964                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1965                 .
     1966               end.
     1967             end.
     1968             run diasize_position-resize-button in this-procedure .
     1969           end.
     1970           assign
     1971             v-diasize-change-size = false
     1972           .
     1973           leave move_block .
     1974         end.
     1975       end.
     1976       assign
     1977         v-diasize-need-full-display = true
     1978       .
     1979       if v-diasize-change-size = false
     1980       then do:
     1981         assign
     1982           v-diasize-change-size = true
     1983         .
     1984       end.
     1985       else do:
     1986         return .
     1987       end.
     1988       assign
     1989         v-frame-height = frame Dialog-Frame :height
     1990         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1991         v-browse-height = v-diasize-browse-handle :height
     1992       .
     1993       for each buf_temp-browse-handle
     1994         where buf_temp-browse-handle.browse-type = 'height':u
     1995       :
     1996         assign
     1997           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1998         .
     1999       end.
     2000       for each buf_temp-diasize-handle
     2001       :
     2002         delete buf_temp-diasize-handle .
     2003       end.
     2004       assign
     2005         v-field-group-handle = frame Dialog-Frame :first-child
     2006       .
     2007       do while valid-handle(v-field-group-handle)
     2008       :
     2009         assign
     2010           v-object-handle = v-field-group-handle :first-child
     2011         .
     2012         do while valid-handle(v-object-handle)
     2013         :
     2014           if  v-object-handle <> v-diasize-browse-handle :handle
     2015           and can-query(v-object-handle, "row")
     2016           and can-query(v-object-handle, "height")
     2017           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2018           then do:
     2019             find first buf_temp-browse-handle
     2020               where buf_temp-browse-handle.browse-type   = 'height':u
     2021                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2022               no-error .
     2023             if available buf_temp-browse-handle
     2024             then do:
     2025             end.
     2026             else do:
     2027               create buf_temp-diasize-handle .
     2028               assign
     2029                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2030                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2031               .
     2032             end.
     2033           end.
     2034           assign
     2035             v-object-handle = v-object-handle :next-sibling
     2036           .
     2037         end.
     2038         assign
     2039           v-field-group-handle = v-field-group-handle :next-sibling
     2040         .
     2041       end.
     2042       do with frame Dialog-Frame
     2043       :
     2044         hide v-diasize-resize-button .
     2045         assign
     2046           v-diasize-resize-button :row    = 1
     2047           v-diasize-resize-button :column = 1
     2048         .
     2049       end.
     2050       if p-change-value > 0
     2051       then do:
     2052         if frame Dialog-Frame :scrollable = true
     2053         then do:
     2054           assign
     2055             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2056             no-error .
     2057           if error-status :error
     2058           or error-status :get-message(1) <> ""
     2059           then do:
     2060             undo move_block, retry move_block .
     2061           end.
     2062         end.
     2063         assign
     2064           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2065           no-error .
     2066         if error-status :error
     2067         or error-status :get-message(1) <> ""
     2068         then do:
     2069           undo move_block, retry move_block .
     2070         end.
     2071         assign
     2072           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2073           no-error .
     2074         if error-status :error
     2075         or error-status :get-message(1) <> ""
     2076         then do:
     2077           undo move_block, retry move_block .
     2078         end.
     2079         for each buf_temp-browse-handle
     2080           where buf_temp-browse-handle.browse-type = 'height':u
     2081         on error undo move_block, retry move_block
     2082         :
     2083           assign
     2084             buf_temp-browse-handle.browse-handle :height
     2085               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2086             no-error .
     2087           if error-status :error
     2088           or error-status :get-message(1) <> ""
     2089           then do:
     2090             undo move_block, retry move_block .
     2091           end.
     2092         end.
     2093         for each buf_temp-diasize-handle
     2094         on error undo move_block, retry move_block
     2095         :
     2096           assign
     2097             v-object-handle = buf_temp-diasize-handle.handle-value
     2098           .
     2099           if v-object-handle <> v-diasize-resize-button
     2100           then do:
     2101             assign
     2102               v-object-handle :row = v-object-handle :row + p-change-value
     2103               no-error .
     2104             if error-status :error
     2105             or error-status :get-message(1) <> ""
     2106             then do:
     2107               undo move_block, retry move_block .
     2108             end.
     2109           end.
     2110         end.
     2111       end.
     2112       else do:
     2113         for each buf_temp-diasize-handle
     2114         on error undo move_block, retry move_block
     2115         :
     2116           assign
     2117             v-object-handle = buf_temp-diasize-handle.handle-value
     2118           .
     2119           if v-object-handle <> v-diasize-resize-button
     2120           then do:
     2121             assign
     2122               v-object-handle :row = v-object-handle :row + p-change-value
     2123               no-error .
     2124             if error-status :error
     2125             or error-status :get-message(1) <> ""
     2126             then do:
     2127               undo move_block, retry move_block .
     2128             end.
     2129           end.
     2130         end.
     2131         assign
     2132           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2133           no-error .
     2134         if error-status :error
     2135         or error-status :get-message(1) <> ""
     2136         then do:
     2137           undo move_block, retry move_block .
     2138         end.
     2139         for each buf_temp-browse-handle
     2140           where buf_temp-browse-handle.browse-type = 'height':u
     2141         on error undo move_block, retry move_block
     2142         :
     2143           assign
     2144             buf_temp-browse-handle.browse-handle :height
     2145               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2146             no-error .
     2147           if error-status :error
     2148           or error-status :get-message(1) <> ""
     2149           then do:
     2150             undo move_block, retry move_block .
     2151           end.
     2152         end.
     2153         assign
     2154           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2155           no-error .
     2156         if error-status :error
     2157         or error-status :get-message(1) <> ""
     2158         then do:
     2159           undo move_block, retry move_block .
     2160         end.
     2161         if frame Dialog-Frame :scrollable = true
     2162         then do:
     2163           assign
     2164             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2165             no-error .
     2166           if error-status :error
     2167           or error-status :get-message(1) <> ""
     2168           then do:
     2169             undo move_block, retry move_block .
     2170           end.
     2171         end.
     2172       end.
     2173       if p-move-resize = true
     2174       then do:
     2175         run diasize_position-resize-button in this-procedure .
     2176       end.
     2177       if v-diasize-wndstore = true
     2178       then do:
     2179         if connected("ub") = true
     2180         then do:
     2181           define variable v-cntxt-db-num        as integer   no-undo .
     2182           define variable v-cntxt-userid        as character no-undo .
     2183           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2184                                             , OUTPUT v-cntxt-userid
     2185                                             ) .
     2186           run gbl/wndsizew.p
     2187             (input  v-cntxt-db-num
     2188             ,input  v-cntxt-userid
     2189             ,input  v-diasize-proc-name
     2190             ,input  'height':u
     2191             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2192             ) .
     2193         end.
     2194       end.
     2195     end.
     2196     assign
     2197       v-diasize-change-size = false
     2198     .
     2199   end procedure.
     2200   procedure diasize_set-height :
     2201     define input  parameter p-new-height  as decimal   no-undo .
     2202     define input  parameter p-move-resize as logical   no-undo .
     2203     do
     2204     on error undo, return error return-value
     2205     :
     2206       run diasize_change-height in this-procedure
     2207         (input  (p-new-height - frame Dialog-Frame :height)
     2208         ,input  p-move-resize
     2209         ) .
     2210     end.
     2211   end procedure.
     2212   procedure diasize_change-width :
     2213     define input  parameter p-change-value as decimal   no-undo .
     2214     define input  parameter p-move-resize  as logical   no-undo .
     2215     define variable v-field-group-handle   as handle    no-undo .
     2216     define variable v-object-handle        as handle    no-undo .
     2217     define variable v-frame-width          as decimal   no-undo .
     2218     define variable v-frame-virtual-width  as decimal   no-undo .
     2219     define variable v-browse-width         as decimal   no-undo .
     2220     define variable v-window-width         as decimal   no-undo .
     2221     define variable v-window-virtual-width as decimal   no-undo .
     2222     define variable v-change-sign          as integer   no-undo .
     2223     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2224     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2225     if p-change-value > 0
     2226     then do:
     2227       if frame Dialog-Frame :width + p-change-value >
     2228           session :width-chars
     2229       then do:
     2230         assign
     2231           p-change-value = session :width-chars - frame Dialog-Frame :width
     2232         .
     2233         if p-change-value <= 0
     2234         then do:
     2235           run diasize_position-resize-button in this-procedure .
     2236           return .
     2237         end.
     2238       end.
     2239     end.
     2240     if p-change-value < 0
     2241     then do:
     2242       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2243       then do:
     2244         assign
     2245           p-change-value = v-diasize-orig-frame-width
     2246                          - frame Dialog-Frame :width
     2247         .
     2248         if p-change-value >= 0
     2249         then do:
     2250           run diasize_position-resize-button in this-procedure .
     2251           return .
     2252         end.
     2253       end.
     2254     end.
     2255     if p-change-value >= 0
     2256     then do:
     2257       assign
     2258         v-change-sign = 1
     2259       .
     2260     end.
     2261     else do:
     2262       assign
     2263         v-change-sign = -1
     2264       .
     2265     end.
     2266     assign
     2267       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2268     .
     2269     if p-change-value = 0
     2270     then do:
     2271       run diasize_position-resize-button in this-procedure .
     2272       return .
     2273     end.
     2274     move_block:
     2275     do
     2276     on error undo move_block, leave move_block
     2277     :
     2278       if retry
     2279       then do:
     2280         do
     2281         on error undo move_block, leave move_block
     2282         :
     2283           if p-change-value > 0
     2284           then do:
     2285             for each buf_temp-diasize-handle
     2286             on error undo, next
     2287             :
     2288               assign
     2289                 v-object-handle = buf_temp-diasize-handle.handle-value
     2290               .
     2291               if v-object-handle <> v-diasize-resize-button
     2292               then do:
     2293                 assign
     2294                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2295                 .
     2296               end.
     2297             end.
     2298             assign
     2299               v-diasize-browse-handle :width = v-browse-width
     2300             .
     2301             for each buf_temp-browse-handle
     2302               where buf_temp-browse-handle.browse-type = 'width':u
     2303             on error undo, next
     2304             :
     2305               assign
     2306                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2307               .
     2308             end.
     2309             assign
     2310               frame Dialog-Frame :width = v-frame-width
     2311             .
     2312             if frame Dialog-Frame :scrollable = true
     2313             then do:
     2314               assign
     2315                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2316               .
     2317             end.
     2318             run diasize_position-resize-button in this-procedure .
     2319           end.
     2320           else do:
     2321             if frame Dialog-Frame :scrollable = true
     2322             then do:
     2323               assign
     2324                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2325               .
     2326             end.
     2327             assign
     2328               frame Dialog-Frame :width = v-frame-width
     2329             .
     2330             for each buf_temp-browse-handle
     2331               where buf_temp-browse-handle.browse-type = 'width':u
     2332             on error undo, next
     2333             :
     2334               assign
     2335                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2336               .
     2337             end.
     2338             assign
     2339               v-diasize-browse-handle :width = v-browse-width
     2340             .
     2341             for each buf_temp-diasize-handle
     2342             on error undo, next
     2343             :
     2344               assign
     2345                 v-object-handle = buf_temp-diasize-handle.handle-value
     2346               .
     2347               if v-object-handle <> v-diasize-resize-button
     2348               then do:
     2349                 assign
     2350                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2351                 .
     2352               end.
     2353             end.
     2354             run diasize_position-resize-button in this-procedure .
     2355           end.
     2356           assign
     2357             v-diasize-change-size = false
     2358           .
     2359           leave move_block .
     2360         end.
     2361       end.
     2362       assign
     2363         v-diasize-need-full-display = true
     2364       .
     2365       if v-diasize-change-size = false
     2366       then do:
     2367         assign
     2368           v-diasize-change-size = true
     2369         .
     2370       end.
     2371       else do:
     2372         return .
     2373       end.
     2374       assign
     2375         v-frame-width = frame Dialog-Frame :width
     2376         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2377         v-browse-width = v-diasize-browse-handle :width
     2378       .
     2379       for each buf_temp-browse-handle
     2380         where buf_temp-browse-handle.browse-type = 'width':u
     2381       :
     2382         assign
     2383           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2384         .
     2385       end.
     2386       for each buf_temp-diasize-handle
     2387       :
     2388         delete buf_temp-diasize-handle .
     2389       end.
     2390       assign
     2391         v-field-group-handle = frame Dialog-Frame :first-child
     2392       .
     2393       do while valid-handle(v-field-group-handle)
     2394       :
     2395         assign
     2396           v-object-handle = v-field-group-handle :first-child
     2397         .
     2398         do while valid-handle(v-object-handle)
     2399         :
     2400           if  v-object-handle <> v-diasize-browse-handle :handle
     2401           and v-object-handle <> v-diasize-resize-button
     2402           and can-query(v-object-handle, "row")
     2403           and can-query(v-object-handle, "height")
     2404           and ( v-object-handle :col + v-object-handle :width
     2405                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2406               )
     2407           then do:
     2408             find first buf_temp-browse-handle
     2409               where buf_temp-browse-handle.browse-type   = 'width':u
     2410                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2411               no-error .
     2412             if available buf_temp-browse-handle
     2413             then do:
     2414             end.
     2415             else do:
     2416               create buf_temp-diasize-handle .
     2417               assign
     2418                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2419                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2420               .
     2421             end.
     2422           end.
     2423           assign
     2424             v-object-handle = v-object-handle :next-sibling
     2425           .
     2426         end.
     2427         assign
     2428           v-field-group-handle = v-field-group-handle :next-sibling
     2429         .
     2430       end.
     2431       do with frame Dialog-Frame
     2432       :
     2433         hide v-diasize-resize-button .
     2434         v-diasize-resize-button :row = 1.
     2435         v-diasize-resize-button :column = 1.
     2436       end.
     2437       if p-change-value > 0
     2438       then do:
     2439         if frame Dialog-Frame :scrollable = true
     2440         then do:
     2441           assign
     2442             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2443             no-error .
     2444           if error-status :error
     2445           or error-status :get-message(1) <> ""
     2446           then do:
     2447             undo move_block, retry move_block.
     2448           end.
     2449         end.
     2450         assign
     2451           frame Dialog-Frame :width = v-frame-width + p-change-value
     2452           no-error .
     2453         if error-status :error
     2454         or error-status :get-message(1) <> ""
     2455         then do:
     2456           undo move_block, retry move_block.
     2457         end.
     2458         assign
     2459           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2460         no-error .
     2461         if error-status :error
     2462         or error-status :get-message(1) <> ""
     2463         then do:
     2464           undo move_block, retry move_block.
     2465         end.
     2466         for each buf_temp-browse-handle
     2467           where buf_temp-browse-handle.browse-type = 'width':u
     2468         on error undo move_block, retry move_block
     2469         :
     2470           assign
     2471             buf_temp-browse-handle.browse-handle :width
     2472               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2473             no-error .
     2474           if error-status :error
     2475           or error-status :get-message(1) <> ""
     2476           then do:
     2477             undo move_block, retry move_block .
     2478           end.
     2479         end.
     2480         for each buf_temp-diasize-handle
     2481         on error undo move_block, retry move_block
     2482         :
     2483           assign
     2484             v-object-handle = buf_temp-diasize-handle.handle-value
     2485           .
     2486           if v-object-handle <> v-diasize-resize-button
     2487           then do:
     2488             assign
     2489               v-object-handle :col = v-object-handle :col + p-change-value
     2490               no-error .
     2491             if error-status :error
     2492             or error-status :get-message(1) <> ""
     2493             then do:
     2494               undo move_block, retry move_block .
     2495             end.
     2496           end.
     2497         end.
     2498       end.
     2499       else do:
     2500         for each buf_temp-diasize-handle
     2501         on error undo move_block, retry move_block
     2502         :
     2503           assign
     2504             v-object-handle = buf_temp-diasize-handle.handle-value
     2505           .
     2506           if v-object-handle <> v-diasize-resize-button
     2507           then do:
     2508             assign
     2509               v-object-handle :col = v-object-handle :col + p-change-value
     2510               no-error .
     2511             if error-status :error
     2512             or error-status :get-message(1) <> ""
     2513             then do:
     2514               undo move_block, retry move_block .
     2515             end.
     2516           end.
     2517         end.
     2518         for each buf_temp-browse-handle
     2519           where buf_temp-browse-handle.browse-type = 'width':u
     2520         on error undo move_block, retry move_block
     2521         :
     2522           assign
     2523             buf_temp-browse-handle.browse-handle :width
     2524               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2525             no-error .
     2526           if error-status :error
     2527           or error-status :get-message(1) <> ""
     2528           then do:
     2529             undo move_block, retry move_block .
     2530           end.
     2531         end.
     2532         assign
     2533           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2534           no-error .
     2535         if error-status :error
     2536         or error-status :get-message(1) <> ""
     2537         then do:
     2538           undo move_block, retry move_block.
     2539         end.
     2540         assign
     2541           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2542         no-error .
     2543         if error-status :error
     2544         or error-status :get-message(1) <> ""
     2545         then do:
     2546           undo move_block, retry move_block.
     2547         end.
     2548         if frame Dialog-Frame :scrollable = true
     2549         then do:
     2550           assign
     2551             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2552           no-error .
     2553           if error-status :error
     2554           or error-status :get-message(1) <> ""
     2555           then do:
     2556             undo move_block, retry move_block.
     2557           end.
     2558         end.
     2559       end.
     2560       if p-move-resize
     2561       then do:
     2562         run diasize_position-resize-button in this-procedure .
     2563       end.
     2564       if v-diasize-wndstore = true
     2565       then do:
     2566         if connected("ub") = true
     2567         then do:
     2568           define variable v-cntxt-db-num        as integer   no-undo .
     2569           define variable v-cntxt-userid        as character no-undo .
     2570           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2571                                             , OUTPUT v-cntxt-userid
     2572                                             ) .
     2573           run gbl/wndsizew.p
     2574             (input  v-cntxt-db-num
     2575             ,input  v-cntxt-userid
     2576             ,input  v-diasize-proc-name
     2577             ,input  'width':u
     2578             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2579             ) .
     2580         end.
     2581       end.
     2582     end.
     2583     assign
     2584       v-diasize-change-size = false
     2585     .
     2586   end procedure.
     2587   procedure diasize_set-width :
     2588     define input  parameter p-new-width  as decimal   no-undo .
     2589     define input  parameter p-move-resize as logical   no-undo .
     2590     do
     2591     on error undo, return error return-value
     2592     :
     2593       run diasize_change-width in this-procedure
     2594         (input  (p-new-width - frame Dialog-Frame :width)
     2595         ,input  p-move-resize
     2596         ) .
     2597     end.
     2598   end procedure.
     2599   procedure diasize_position-resize-button :
     2600     do with frame Dialog-Frame
     2601     :
     2602       hide v-diasize-resize-button .
     2603       assign
     2604         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2605                     - 1
     2606                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2607         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2608                     - 1
     2609                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2610       .
     2611       view v-diasize-resize-button .
     2612     end.
     2613   end procedure.
     2614   on alt-right anywhere
     2615   do:
     2616     run diasize_change-width in this-procedure
     2617       (input 1
     2618       ,input true
     2619       ) .
     2620     return no-apply .
     2621   end.
     2622   on alt-left anywhere
     2623   do:
     2624     run diasize_change-width in this-procedure
     2625       (input -1
     2626       ,input true
     2627       ) .
     2628     return no-apply .
     2629   end.
     2630   on alt-down anywhere
     2631   do:
     2632     run diasize_change-height in this-procedure
     2633       (input 1
     2634       ,input true
     2635       ) .
     2636     return no-apply .
     2637   end.
     2638   on alt-up anywhere
     2639   do:
     2640     run diasize_change-height in this-procedure
     2641       (input -1
     2642       ,input true
     2643       ) .
     2644     return no-apply .
     2645   end.
     2646   on alt-enter of frame Dialog-Frame
     2647   do:
     2648     run diasize_maximize in this-procedure
     2649       (input  ?
     2650       ).
     2651     return no-apply .
     2652   end.
     2653   procedure diasize_end-move :
     2654     do
     2655     on error undo, return error return-value
     2656     :
     2657       define variable v-row-delta as decimal   no-undo .
     2658       define variable v-col-delta as decimal   no-undo .
     2659       define variable v-new-row as decimal   no-undo .
     2660       define variable v-new-col as decimal   no-undo .
     2661       assign
     2662         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2663         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2664       .
     2665       assign
     2666         v-row-delta = v-new-row - frame Dialog-Frame :height
     2667         v-col-delta = v-new-col - frame Dialog-Frame :width
     2668       .
     2669       run diasize_change-height in this-procedure
     2670         (input v-row-delta
     2671         ,input true
     2672         ) .
     2673       run diasize_change-width in this-procedure
     2674         (input v-col-delta
     2675         ,input true
     2676         ) .
     2677     end.
     2678   end procedure.
     2679   procedure diasize_maximize :
     2680     define input  parameter p-action as logical   no-undo .
     2681     do
     2682     on error undo, return error return-value
     2683     :
     2684       if p-action = ?
     2685       then do:
     2686         if v-diasize-need-maximize = true
     2687         then do:
     2688           assign
     2689             p-action = true
     2690           .
     2691         end.
     2692         else do:
     2693           assign
     2694             p-action = false
     2695           .
     2696         end.
     2697       end.
     2698       if p-action = true
     2699       then do:
     2700         run diasize_change-height in this-procedure
     2701           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2702               - frame Dialog-Frame :height-chars
     2703           ,input true
     2704           ) .
     2705         run diasize_change-width in this-procedure
     2706           (input session :width-chars
     2707               - frame Dialog-Frame :width-chars
     2708           ,input true
     2709           ) .
     2710         assign
     2711           v-diasize-need-maximize = false
     2712         .
     2713       end.
     2714       else do:
     2715         run diasize_change-width in this-procedure
     2716           (input v-diasize-orig-frame-width
     2717               - frame Dialog-Frame :width-chars
     2718           ,input true
     2719           ) .
     2720         run diasize_change-height in this-procedure
     2721           (input v-diasize-orig-frame-height
     2722               - frame Dialog-Frame :height-chars
     2723           ,input true
     2724           ) .
     2725         assign
     2726           v-diasize-need-maximize = true
     2727         .
     2728       end.
     2729     end.
     2730   end procedure.
     2731   procedure diasize_restore-orig-size :
