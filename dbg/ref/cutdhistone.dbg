      802   procedure prn-lib-reportviewer :
      803     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      804     define input parameter p-report-name-html as character no-undo .
      805     define input parameter p-param        as character no-undo .
      806     define variable v-excel           as character no-undo init 'TRUE' .
      807     define variable v-value-character as character no-undo .
      808     define variable v-value-integer   as character no-undo .
      809     define variable v-value-date      as date      no-undo .
      810     define variable v-value-decimal   as decimal   no-undo .
