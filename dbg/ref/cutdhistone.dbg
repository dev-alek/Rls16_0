     2797   procedure diasize_init :
     2798     define variable v-default-value    as logical   no-undo .
     2799     define variable v-restore-saved    as logical   no-undo .
     2800     define variable v-resize-value-str as character no-undo .
     2801     do
     2802     on error undo, return error return-value
     2803     :
     2804       do with frame Dialog-Frame
     2805       :
     2806         assign
     2807           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2808           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2809           v-diasize-browse-handle     = browse br-obj-hist :handle
     2810         .
     2811         create button v-diasize-resize-button
     2812         assign
     2813           parent        = frame Dialog-Frame :first-child
     2814           label         = "s"
     2815           height-pixels = 16
     2816           width-pixels  = 16
     2817           visible       = true
     2818           sensitive     = true
     2819           movable       = true
     2820           triggers:
     2821             on end-move persistent run diasize_end-move in this-procedure .
     2822           end triggers.
     2823         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2824         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2825         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2826         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2827         assign
     2828           v-diasize-wndmax = false
     2829         .
     2830         if connected("ub") = true
     2831         then do:
     2832           define variable v-cntxt-db-num        as integer   no-undo .
     2833           define variable v-cntxt-userid        as character no-undo .
     2834           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2835                                             , OUTPUT v-cntxt-userid
     2836                                             ) .
     2837           run gbl/wndpar_r.p
     2838             (input  v-cntxt-db-num
     2839             ,input  v-cntxt-userid
     2840             ,input  'wndmax':U
     2841             ,output v-diasize-wndmax
     2842             ,output v-default-value
     2843             ) .
     2844         end.
     2845         assign
     2846           v-diasize-wndstore = false
     2847         .
     2848         if connected("ub") = true
     2849         then do:
     2850           run gbl/wndpar_r.p
     2851             (input  v-cntxt-db-num
     2852             ,input  v-cntxt-userid
     2853             ,input  'wndstore':U
     2854             ,output v-diasize-wndstore
     2855             ,output v-default-value
     2856             ) .
     2857         end.
     2858         assign
     2859           v-diasize-proc-name = entry(1, program-name(2), '.')
     2860         .
     2861         if v-diasize-wndstore = true
     2862         then do:
     2863           assign
     2864             v-restore-saved = false
     2865           .
     2866           if connected("ub") = true
     2867           then do:
     2868             run gbl/wndsizer.p
     2869               (input  v-cntxt-db-num
     2870               ,input  v-cntxt-userid
     2871               ,input  v-diasize-proc-name
     2872               ,input  'height':u
     2873               ,output v-resize-value-str
     2874               ) .
     2875             if v-resize-value-str <> '':U
     2876             then do:
     2877               run diasize_change-height in this-procedure
     2878                 (input  integer(v-resize-value-str)
     2879                 ,input  true
     2880                 ) .
     2881               assign
     2882                 v-restore-saved = true
     2883               .
     2884             end.
     2885           end.
     2886           if connected("ub") = true
     2887           then do:
     2888             run gbl/wndsizer.p
     2889               (input  v-cntxt-db-num
     2890               ,input  v-cntxt-userid
     2891               ,input  v-diasize-proc-name
     2892               ,input  'width':u
     2893               ,output v-resize-value-str
     2894               ) .
     2895             if v-resize-value-str <> '':U
     2896             then do:
     2897               run diasize_change-width in this-procedure
     2898                 (input  integer(v-resize-value-str)
     2899                 ,input  true
     2900                 ) .
     2901               assign
     2902                 v-restore-saved = true
     2903               .
     2904             end.
     2905           end.
     2906           if v-restore-saved <> true
     2907           then do:
     2908             if v-diasize-wndmax = true
     2909             then do:
     2910               run diasize_maximize in this-procedure
     2911                 (input  true
     2912                 ) .
     2913             end.
     2914           end.
     2915         end.
     2916         else do:
     2917           if v-diasize-wndmax = true
     2918           then do:
     2919             run diasize_maximize in this-procedure
     2920               (input  true
     2921               ) .
     2922           end.
     2923         end.
     2924       end.
     2925     end.
     2926   end procedure.
     2927   procedure diasize_need-full-display :
     2928     define output parameter p-need-full-display as logical   no-undo .
     2929     do
     2930     on error undo, return error return-value
     2931     :
     2932       assign
     2933         p-need-full-display = v-diasize-need-full-display
