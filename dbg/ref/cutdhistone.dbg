      815     run adm/shattri.p (
      816       input "get":U
      817       ,input  ""
      818       ,input  0
      819       ,input  'report-glob':U
      820       ,input  'rep-excel':U
      821       ,output v-value-character
      822       ,output v-value-date
      823       ,output v-value-decimal
      824       ,output v-value-integer
      825       ,output rep-excel
      826       ,output v-param-type
      827       ,INPUT-OUTPUT table-handle v-tth
      828       )  .
      829     if rep-excel then v-excel = "TRUE" .
      830     else v-excel = "FALSE" .
      831     if p-param eq ""
      832     then
      833        p-param = "EXCEL:" + v-excel.
      834     else
      835        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      836     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      837   end procedure.
