        1   define input  parameter p-dB-NUM-utd as int64 no-undo.
        2   define input  parameter p-doc-id-utd as int64 no-undo.
        3   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
        4   run gbl/getobjsrvhndl.p (input-output ObjSrv).
        5   define variable StatusTH   as class     ibs.th.str.utd.sts.th  no-undo .
        6   define variable StatusEDI  as class     ibs.th.str.utd.sts.edi no-undo .
        7   define variable EdocType  as class     ibs.th.str.utd.edoctype no-undo .
        8   define variable StatusMark  as class     ibs.th.str.marking.sts.mark no-undo .
        9   StatusTH = ObjSrv:Env:Utd:Sts:TH.
       10   StatusEDI = ObjSrv:Env:Utd:Sts:EDI.
       11   EdocType = ObjSrv:Env:Utd:EDocType.
       12   StatusMark = ObjSrv:Env:marking:sts:mark.
       13   define variable vLabel as character no-undo.
       14   vLabel = "История по УПД " + string(p-doc-id-utd) + " по ДБ " + string(p-dB-NUM-utd).
       15   define temp-table X_c-obj-hist like c-utd-head .
       16   DEFINE BUFFER find_c-obj-hist FOR X_c-obj-hist.
       17   DEFINE BUFFER X_curr-sysconf FOR sysconf.
       18   DEFINE BUFFER X_db FOR db.
       19   DEFINE BUFFER X_sysconf FOR sysconf.
       20   define input     parameter parParentProc  as widget-handle no-undo.
       21   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo.
       22   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo.
       23   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo.
       24   define input parameter bttns  as char   no-undo .
       25   define input parameter p-mode  as char   no-undo .
       26   define input parameter p-corr-user-db-num  like ub.c-cli-hist.corr-user-db-num no-undo .
       27   define input parameter p-corr-user-name  like ub.c-cli-hist.corr-user-name no-undo .
       28   define input parameter p-subject  like ub.c-cli-hist.subject no-undo .
       29   define input parameter p-db-num  like ub.c-cli-hist.corr-user-db-num no-undo .
       30   define input parameter p-chip-num  as int64 no-undo.
       31   define input-output param p-rid-list    as  char no-undo .
       32   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       33   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       34   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       35   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
       36   define variable vss-archive     AS CHAR NO-UNDO INIT "$Archive$":U.
       37   define variable vss-description AS CHAR NO-UNDO INIT "Список полной истории":U.
       38   procedure vss-get-info :
       39     define output parameter p-vss-revision    like vss-revision    no-undo .
       40     define output parameter p-vss-author      like vss-author      no-undo .
       41     define output parameter p-vss-date        like vss-date        no-undo .
       42     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       43     define output parameter p-vss-archive     like vss-archive     no-undo .
       44     define output parameter p-vss-description like vss-description no-undo .
       45     assign
       46       p-vss-revision    = vss-revision
       47       p-vss-author      = vss-author
       48       p-vss-date        = vss-date
       49       p-vss-workfile    = vss-workfile
       50       p-vss-archive     = vss-archive
       51       p-vss-description = vss-description
       52     .
       53   end procedure.
       54   procedure vss-get-parameters :
       55     define output parameter p-vss-parameters as character no-undo .
       56   end procedure.
       57   define new global shared variable g#vssrevis-logger as handle    no-undo .
       58   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       59   define variable v-vssrevis-logger                   as handle    no-undo .
       60   procedure vss-logevent :
       61     define input  parameter p-extra-paramters as character no-undo .
       62     define variable v-vssrevis-parameters as character no-undo .
       63     do
       64     on error undo, return error return-value
       65     :
       66       if  valid-handle(v-vssrevis-logger)
       67       and v-vssrevis-logger :get-signature("logevent") <> ""
       68       then do:
       69         run vss-get-parameters in this-procedure
       70           (output v-vssrevis-parameters
       71           ).
       72         run logevent in v-vssrevis-logger
       73           (input vss-workfile
       74           ,input vss-revision
       75           ,input v-vssrevis-parameters
       76           ,input p-extra-paramters
       77           ).
       78       end.
       79     end.
       80   end procedure.
       81   assign
       82     v-vssrevis-logger = g#vssrevis-logger
       83   .
       84   if  valid-handle(v-vssrevis-logger)
       85   and v-vssrevis-logger :get-signature("logevent") <> ""
       86   then do:
       87     assign
       88       v-vssrevis-logevent = true
       89     .
       90     run vss-logevent in this-procedure (input vss-description) .
       91   end.
       92   define new global shared variable g#language as character no-undo .
       93   if g#language <> '' and g#language <> 'rus':U then do:
       94     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       95   end.
       96   define new global shared variable g#library  as handle no-undo .
       97   define new global shared variable g#library2 as handle no-undo .
       98   procedure proc-alt-shift-f2:
       99     if not ibs.th.gbl.gbl-var:rcode
      100   then
      101     run gbl\inidebug.p .
      102   end.
      103   procedure proc-alt-shift-f3:
      104     run gbl/prvssinf.p
      105       ( input this-procedure
      106       ) .
