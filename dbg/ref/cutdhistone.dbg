      879   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      880   procedure fltopend_fltopend :
      881   define input parameter p-parent-handle as handle no-undo .
      882   define input parameter p-qh as handle no-undo .
      883   define input parameter p-flt-open-open-query  as character no-undo .
      884   define input parameter p-where-cond as character no-undo .
      885   define input parameter p-use-indFIRST-query-tail as character no-undo .
      886   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      887   define input parameter p-indexed-reposition as character no-undo .
      888     do
      889     on error undo, return error
      890     :
      891   define variable v-prepare-string as character no-undo .
      892   define variable glog as logical no-undo .
      893   assign
      894   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      895                      p-where-cond + chr(32)  +
      896                      p-use-indFIRST-query-tail + chr(32) +
      897                      p-use-ind-sort-clmn-by + chr(32) +
      898                      p-indexed-reposition
      899   .
      900   assign
      901   glog = p-qh:query-prepare(v-prepare-string) no-error .
      902   if not glog
      903   or error-status:error then do:
      904     message error-status:get-message(1) view-as alert-box .
      905     undo, return error .
      906   end.
      907   assign
      908   glog = p-qh:query-open no-error .
      909   if not glog
      910   or error-status:error then do:
      911     message error-status:get-message(1) view-as alert-box .
      912     undo, return error .
      913   end.
      914     end.
      915   end procedure.
      916   procedure fltopend_fltfindd :
      917   define input parameter p-parent-handle as handle no-undo .
      918   define input parameter p-qh as handle no-undo .
      919   define input parameter p-rowid as rowid no-undo .
      920   define input parameter p-next as logical no-undo .
      921   define input parameter p-lock as integer no-undo .
      922   define input parameter p-bh as handle no-undo .
      923   define input parameter p-where-cond as character no-undo .
      924   define input parameter p-use-index-phrase as character no-undo .
      925   define variable glog as logical no-undo .
      926   define variable v-qh as handle no-undo .
      927   define variable v-bh as handle no-undo .
      928   define variable v-recid as recid no-undo .
      929   define variable v-prepare-string as character no-undo .
      930   do
      931   on error undo, return error
      932   on stop undo, return error
      933   :
      934     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      935     create buffer v-bh for table p-bh buffer-name p-bh:name.
      936     create query v-qh.
      937     v-qh:set-buffers(v-bh).
      938     v-prepare-string = substitute("for each &1 &2 &3"
      939                                     ,v-bh:name
      940                                     ,p-where-cond
      941                                     ,p-use-index-phrase).
      942     glog = v-qh:query-prepare(v-prepare-string) no-error.
      943     if not glog then do:
      944       delete object v-qh.
      945       delete object v-bh.
      946       undo, return error .
      947     end.
      948     glog = v-qh:query-open no-error .
      949     if not glog then do:
      950       delete object v-qh.
      951       delete object v-bh.
      952       undo, return error .
      953     end.
      954     if p-next then do:
      955       v-qh:reposition-to-rowid(p-rowid) no-error .
      956       glog = v-qh:get-next( p-lock) no-error .
      957       glog = v-qh:get-next( p-lock) no-error .
      958       if not glog or v-qh:query-off-end = yes then do:
      959         glog = v-qh:get-first( p-lock) no-error .
      960       end.
      961     end.
      962     else do:
      963       glog = v-qh:get-first( p-lock) no-error .
      964     end.
      965     v-recid = v-bh:recid no-error .
      966     delete object v-qh.
      967     delete object v-bh.
      968     return string(v-recid) .
      969   end.
      970   end procedure.
      971   procedure fltopend_fltfindq :
      972   define input parameter p-parent-handle as handle no-undo .
      973   define input parameter p-qh as handle no-undo .
      974   define input parameter p-next as logical no-undo .
      975   define input parameter p-lock as integer no-undo .
      976   define input parameter p-flt-open-open-query  as character no-undo .
      977   define input parameter p-where-cond as character no-undo .
      978   define input parameter p-use-indFIRST-query-tail as character no-undo .
      979   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      980   define input parameter p-indexed-reposition as character no-undo .
      981   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      982   define variable glog as logical no-undo .
      983   define variable v-qh as handle no-undo .
      984   define variable v-bh as handle no-undo extent 18.
      985   define variable v-rowid as rowid no-undo extent 18.
      986   define variable v-ii as integer no-undo .
      987   define variable v-prepare-string as character no-undo .
      988   do
      989   on error undo, return error
      990   on stop undo, return error
      991   :
      992     create query v-qh.
      993     do v-ii = 1 to p-qh:num-buffers:
      994       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      995       assign
      996       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      997       no-error.
      998       v-qh:add-buffer(v-bh[v-ii]).
      999     end.
     1000     assign
     1001     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1002                       p-where-cond + chr(32)  +
     1003                       p-use-indFIRST-query-tail + chr(32) +
     1004                       p-use-ind-sort-clmn-by + chr(32) +
     1005                       p-indexed-reposition
     1006     .
     1007     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1008     if not glog then do:
     1009       delete object v-qh.
     1010       do v-ii = 1 to p-qh:num-buffers:
     1011         delete object v-bh[v-ii].
     1012       end.
     1013       undo, return error .
     1014     end.
     1015     glog = v-qh:query-open no-error .
     1016     if not glog then do:
     1017       delete object v-qh.
     1018       do v-ii = 1 to p-qh:num-buffers:
     1019         delete object v-bh[v-ii].
     1020       end.
     1021       undo, return error .
     1022     end.
     1023     if p-next then do:
     1024       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1025       glog = v-qh:get-next( p-lock) no-error .
     1026       glog = v-qh:get-next( p-lock) no-error .
     1027       if not glog or v-qh:query-off-end = yes then do:
     1028         glog = v-qh:get-first( p-lock) no-error .
     1029       end.
     1030     end.
     1031     else do:
     1032       glog = v-qh:get-first( p-lock) no-error .
     1033     end.
     1034     do v-ii = 1 to p-qh:num-buffers:
     1035       assign
     1036       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1037       no-error.
     1038     end.
     1039     delete object v-qh.
     1040     do v-ii = 1 to p-qh:num-buffers:
     1041       delete object v-bh[v-ii].
     1042     end.
     1043   end.
     1044   end procedure.
