     7439   PROCEDURE proc-find-obj-code :
     7440   define input parameter p-next as logical no-undo.
     7441   define input parameter p-obj-code as character no-undo.
     7442   if p-obj-code = "" then return .
     7443   run OpenBr in this-procedure
     7444       (input false
     7445       ,input true
     7446       ,input substitute("and X_c-obj-hist.doc-id = &1 "
     7447         , p-obj-code)
     7448       ,input v-corr-user-db-num
     7449       ).
     7450   apply "entry":u to sch-obj-code in frame Dialog-Frame.
     7451   END PROCEDURE.
