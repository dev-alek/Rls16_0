      704   procedure prn-lib-open-stream :
      705     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      706     define input parameter p-page-size    as integer no-undo .
      707     define input parameter p-is-stream    as logical no-undo .
      708     define input parameter p-append       as logical no-undo .
      709     define variable v-report-name as character no-undo .
      710     do
      711       on error undo, return error
      712       :
      713       run prn-lib-get-report-name  in this-procedure (
      714         input parParentProc
      715         ,output v-report-name
      716         ).
      717       if p-is-stream then
      718       do:
      719         if p-append then
      720         do:
      721           output stream PrnLibStream to value( v-report-name )
      722             page-size value(p-page-size) append .
      723         end.
      724         if not p-append then
      725         do:
      726           output stream PrnLibStream to value( v-report-name )
      727             page-size value(p-page-size) .
      728         end.
      729       end.
      730       if not p-is-stream then
      731       do:
      732         if p-append then
      733         do:
      734           output to value( v-report-name )
      735             page-size value(p-page-size) append .
      736         end.
      737         if not p-append then
      738         do:
      739           output to value( v-report-name )
      740             page-size value(p-page-size) .
      741         end.
      742       end.
      743     end.
      744   end procedure.
      745   procedure prn-lib-open-exp :
      746     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      747     define input parameter p-is-stream    as logical no-undo .
      748     define input parameter p-is-append    as logical no-undo .
      749     define output parameter p-ReportFileName as char init "report" no-undo.
      750     define output parameter p-process as logical no-undo .
      751     define variable glog as logical no-undo .
      752     do
      753       on error undo, return error
      754       :
      755       SYSTEM-DIALOG GET-FILE p-ReportFileName
      756         TITLE      "Укажите путь"
      757         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      758         ASK-OVERWRITE
      759         CREATE-TEST-FILE
      760         SAVE-AS
      761         USE-FILENAME
      762         DEFAULT-EXTENSION "txt"
      763         UPDATE glog
      764         .
      765       if not glog then  return.
      766       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      767       if p-is-stream then
      768       do:
      769         if p-is-append then
      770         do:
      771           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      772         end.
      773         else
      774         do:
      775           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      776         end.
      777       end.
      778       else
      779       do:
      780         if p-is-append then
      781         do:
      782           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      783         end.
      784         else
      785         do:
      786           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      787         end.
      788       end.
      789       p-process = yes.
      790     end.
      791   end procedure.
