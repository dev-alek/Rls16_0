        1   block-level on error undo, throw.
        2   define input parameter p-silent as logical no-undo .
        3   DEFINE INPUT PARAMETER parunit-base like ub.goods.unit-base no-undo.
        4   DEFINE INPUT PARAMETER parnode-code like ub.gds-grp.node-code no-undo.
        5   DEFINE INPUT PARAMETER par-recid as recid no-undo.
        6   DEFINE INPUT PARAMETER par-copy as recid no-undo.
        7   define input parameter parhost-code like ub.sysconf.host-code no-undo .
        8   define input parameter parobj-type like ub.clients.obj-type no-undo .
        9   define input parameter parobj-code like ub.clients.obj-code no-undo .
       10   define variable vss-revision    as character no-undo init "$Revision: da70ce2a1328, 1072, rls $":U .
       11   define variable vss-author      as character no-undo init "$Author: SMMolotkov $":U .
       12   define variable vss-date        as character no-undo init "$Date: Fri Oct 06 18:35:13 2017 +0300 $":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile: dtaxgdss.p $":U .
       14   define variable vss-archive     as character no-undo init "$Archive: ref/dtaxgdss.p $":U .
       15   define variable vss-description as character no-undo init "Заполнение полей временной таблицы tt-tax для показа в карточке товара".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70     define SHARED temp-table  tt-tax no-undo
       71   field tax-code    like ub.tax.tax-code
       72   FIELD individual  like ub.tax.individual
       73   FIELD tax-name    like ub.tax.tax-name format "X(12)" column-label "Налог"
       74   field rate-code   like ub.tax-rate.rate-code
       75   FIELD rate-name   like ub.tax-rate.rate-name FORMAT "X(12)"
       76   FIELD tax-type    like ub.tax.tax-type
       77   field rate-value  like ub.tax-rate-value.rate-value
       78   FIELD tax-rate-gds-rc  as recid
       79   FIELD to-cashdesk like ub.tax.to-cashdesk
       80   FIELD fact-date like ub.tax-rate-value.fact-date
       81   FIELD fact-order like ub.tax-rate-value.fact-order
       82   FIELD next-order like ub.tax-rate-value.fact-order
       83   FIELD corr-user-name like ub.tax-rate-gds.corr-user-name
       84   FIELD corr-user-db-num   like ub.tax-rate-gds.corr-user-db-num
       85   FIELD corr-date like ub.tax-rate-gds.corr-date
       86   FIELD corr-time like ub.tax-rate-gds.corr-time
       87   index tax-code is unique primary tax-code fact-order descending rate-code.
       88   define new global shared variable g#language as character no-undo .
       89   if g#language <> '' and g#language <> 'rus':U then do:
       90     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       91   end.
       92   define new global shared variable g#library  as handle no-undo .
       93   define new global shared variable g#library2 as handle no-undo .
       94   define   shared variable g#auto as logical no-undo.
       95   define   shared variable g#news as logical no-undo.
       96   define   shared variable g#oxml as logical no-undo.
       97   define   shared variable g#esys as logical no-undo.
       98   define   shared variable g#news-source-db as integer no-undo.
       99   define   shared variable g#esys-source-esys as integer no-undo.
      100   define   shared variable g#db-num as integer   no-undo .
      101   define   shared variable g#userid as character no-undo .
      102   define   shared variable g#passwd as character no-undo .
      103   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      104   procedure factord :
      105     define input  parameter p-fact-date            as date    no-undo .
      106     define input  parameter p-fact-time            as integer no-undo .
      107     define input  parameter p-fact-num             as integer no-undo .
      108     define input  parameter p-shift-date           as date    no-undo .
      109     define input  parameter p-shift-num            as integer no-undo .
      110     define input  parameter p-shift-on             as logical no-undo .
      111     define output parameter p-fact-order           as decimal no-undo .
      112     define output parameter p-shift-end-fact-order as decimal no-undo .
      113     define output parameter p-day-end-fact-order   as decimal no-undo .
      114     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      115     if p-fact-date = ?
      116     then do:
      117       return error "Не указана фактическая дата" .
      118     end.
      119     define variable v-fact-date-num as integer no-undo .
      120     assign
      121       v-fact-date-num = integer(p-fact-date)
      122     .
      123     if p-fact-num = ?
      124     or p-fact-num = 0
      125     then do:
      126       return error "Не задан p-fact-num " + string(p-fact-num) .
      127     end.
      128     if p-fact-num < 0
      129     then do:
      130       return error "Отрицательный fact-num " + string(p-fact-num) .
      131     end.
      132     if p-fact-num >= 100000000
      133     then do:
      134       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      135     end.
      136     if p-shift-on = true
      137     then do:
      138       if p-shift-date = ?
      139       then do:
      140         return error "Не задана дата смены" .
      141       end.
      142       if p-shift-num = ?
      143       or p-shift-num = 0
      144       then do:
      145         return error "Не задан номер смены" .
      146       end.
      147     end.
      148     else do:
      149       assign
      150         p-shift-date = p-fact-date
      151         p-shift-num  = 24
      152       .
      153     end.
      154     define variable v-shift-offset as integer no-undo .
      155     if p-shift-date = p-fact-date
      156     then do:
      157       assign
      158         v-shift-offset = 1
      159       .
      160     end.
      161     if p-shift-date < p-fact-date
      162     then do:
      163       assign
      164         v-shift-offset = 0
      165       .
      166     end.
      167     if p-shift-date > p-fact-date
      168     then do:
      169       message
      170         vss-workfile vss-revision vss-description skip
      171         "Неправильная дата закрытия смены" skip
      172         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      173         view-as alert-box error .
      174       undo, return error
      175         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      176           ,string(p-fact-date, '99/99/9999':U)
      177           ,string(p-shift-date, '99/99/9999':U)
      178           )
      179       .
      180     end.
      181     if p-shift-num < 1
      182     or p-shift-num > 24
      183     then do:
      184       message
      185         vss-workfile vss-revision vss-description skip
      186         "Неправильный номер смены" skip
      187         "p-shift-num" p-shift-num skip
      188         view-as alert-box error .
      189       undo, return error return-value .
      190     end.
      191     assign
      192       p-fact-order           = v-fact-date-num
      193                              + v-shift-offset * 0.5
      194                              + p-shift-num    * 0.02 - 0.01
      195                              + p-fact-num     * 0.0000000001
      196       p-shift-end-fact-order = v-fact-date-num
      197                              + v-shift-offset * 0.5
      198                              + p-shift-num    * 0.02
      199       p-day-end-fact-order   = v-fact-date-num
      200                              + 0.99
      201     .
      202     if p-fact-order           <= v-fact-date-num
      203     or p-shift-end-fact-order <= v-fact-date-num
      204     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      205     or p-shift-end-fact-order >= p-day-end-fact-order
      206     then do:
      207       message
      208         vss-workfile vss-revision vss-description skip
      209         "Внутренняя ошибка при генерации фактического номера" skip
      210         "p-fact-date"            p-fact-date            skip
      211         "p-fact-time"            p-fact-time            skip
      212         "p-fact-num"             p-fact-num             skip
      213         "p-shift-date"           p-shift-date           skip
      214         "p-shift-num"            p-shift-num            skip
      215         "p-shift-on"             p-shift-on             skip
      216         "p-shift-end-fact-order" p-shift-end-fact-order skip
      217         "p-day-end-fact-order"   p-day-end-fact-order   skip
      218         "v-fact-date-num"        v-fact-date-num        skip
      219         view-as alert-box error .
      220       undo, return error return-value .
      221     end.
      222   end procedure.
      223   procedure day-begin-fact-order :
      224     define input  parameter p-fact-date            as date    no-undo .
      225     define output parameter p-day-begin-fact-order as decimal no-undo .
      226     do
      227     on error undo, return error return-value
      228     :
      229       if p-fact-date = ?
      230       then do:
      231         assign
      232           p-day-begin-fact-order = 0
      233         .
      234       end.
      235       else do:
      236         assign
      237           p-day-begin-fact-order = integer(p-fact-date)
      238         .
      239       end.
      240     end.
      241   end procedure.
      242   procedure factord-max-fact-order :
      243     define output parameter p-max-fact-order as decimal   no-undo .
      244     do
      245     on error undo, return error return-value
      246     :
      247       run day-begin-fact-order in this-procedure
      248         (input  date(1, 1, 5000)
      249         ,output p-max-fact-order
      250         ) .
      251     end.
      252   end procedure.
      253   procedure factord-cut-archive :
      254     define input  parameter p-obj-type             as character no-undo .
      255     define input  parameter p-obj-code             as integer   no-undo .
      256     define input  parameter p-fact-date            as date      no-undo .
      257     define output parameter p-shift-on             as logical   no-undo .
      258     define output parameter p-shift-date           as date      no-undo .
      259     define output parameter p-shift-num            as integer   no-undo .
      260     define output parameter p-day-end-fact-order   as decimal   no-undo .
      261     define output parameter p-shift-end-fact-order as decimal   no-undo .
      262     define variable v-fact-order as decimal   no-undo .
      263     define buffer buf_shift-obj for ub.shift-obj .
      264     do
      265     on error undo, return error return-value
      266     :
      267   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      268   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      269     (input  p-obj-type
      270     ,input  p-obj-code
      271     ,input  'shift-on=request'
      272     ,output p-shift-on
      273     ) no-error .
      274       if error-status :error
      275       then do:
      276         message
      277           vss-workfile vss-revision vss-description skip
      278           "Ошибка при определении атрибута объекта" skip
      279           "Объект" p-obj-type p-obj-code skip
      280           error-status :get-message(1) skip
      281           return-value skip
      282           view-as alert-box error .
      283         undo, return error return-value .
      284       end.
      285       if p-shift-on = false
      286       then do:
      287         assign
      288           p-shift-date               = ?
      289           p-shift-num                = 0
      290         .
      291       end.
      292       else do:
      293         find first buf_shift-obj share-lock
      294           where buf_shift-obj.obj-type   = p-obj-type
      295             and buf_shift-obj.obj-code   = p-obj-code
      296             and buf_shift-obj.shift-date > p-fact-date
      297           use-index pi
      298           no-error .
      299         if not available buf_shift-obj
      300         or buf_shift-obj.status_ <> 'зкр':U
      301         then do:
      302           message
      303             vss-workfile vss-revision vss-description skip
      304             "Невозможно вычислить последнюю смену" skip
      305             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      306             "Объект" p-obj-type p-obj-code skip
      307             "Дата" p-fact-date skip
      308             view-as alert-box error .
      309           undo, return error return-value .
      310         end.
      311         find last buf_shift-obj share-lock
      312           where buf_shift-obj.obj-type = p-obj-type
      313             and buf_shift-obj.obj-code = p-obj-code
      314             and buf_shift-obj.shift-date <= p-fact-date
      315           use-index pi
      316           no-error .
      317         if available buf_shift-obj
      318         then do:
      319           if  buf_shift-obj.status_ = 'зкр':U
      320           then do:
      321             assign
      322               p-shift-date = buf_shift-obj.shift-date
      323               p-shift-num  = buf_shift-obj.shift-num
      324             .
      325           end.
      326           else do:
      327             message
      328               vss-workfile vss-revision vss-description skip
      329               "Невозможно вычислить последнюю смену" skip
      330               "Статус смены отличен от статуса" 'зкр':U skip
      331               "Объект" p-obj-type p-obj-code skip
      332               "Дата" p-fact-date skip
      333               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      334               view-as alert-box error .
      335             undo, return error return-value .
      336           end.
      337         end.
      338         else do:
      339           assign
      340             p-shift-date = p-fact-date - 1
      341             p-shift-num  = 1
      342           .
      343         end.
      344       end.
      345       run factord in this-procedure
      346         (input  p-fact-date
      347         ,input  1
      348         ,input  1
      349         ,input  p-shift-date
      350         ,input  p-shift-num
      351         ,input  p-shift-on
      352         ,output v-fact-order
      353         ,output p-shift-end-fact-order
      354         ,output p-day-end-fact-order
      355         ) no-error .
      356       if error-status :error
      357       then do:
      358         message
      359           vss-workfile vss-revision vss-description skip
      360           "Ошибка при вызове процедуры factord"
      361           error-status :get-message(1) skip
      362           return-value skip
      363           view-as alert-box error .
      364         undo, return error return-value .
      365       end.
      366     end.
      367   end procedure.
      368   procedure factord-lock-shift :
      369     define input  parameter p-obj-type  as character no-undo .
      370     define input  parameter p-obj-code  as integer   no-undo .
      371     define input  parameter p-fact-date as date      no-undo .
      372     define parameter buffer buf_shift-obj for ub.shift-obj .
      373     define variable v-shift-on      as logical   no-undo .
      374     define variable v-extra-message as character no-undo .
      375     define variable v-error as character no-undo .
      376     do
      377     on error undo, return error return-value
      378     :
      379   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      380   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      381     (input  p-obj-type
      382     ,input  p-obj-code
      383     ,input  'shift-on=request'
      384     ,output v-shift-on
      385     ) no-error .
      386       if error-status :error
      387       then do:
      388         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      389         undo, return error v-error .
      390       end.
      391       if v-shift-on = true
      392       then do:
      393         find first buf_shift-obj share-lock
      394           where buf_shift-obj.obj-type   = p-obj-type
      395             and buf_shift-obj.obj-code   = p-obj-code
      396             and buf_shift-obj.shift-date > p-fact-date
      397           use-index pi
      398           no-error .
      399         if not available buf_shift-obj
      400         or buf_shift-obj.status_ <> 'зкр':U
      401         then do:
      402           find last buf_shift-obj
      403             where buf_shift-obj.obj-type = p-obj-type
      404               and buf_shift-obj.obj-code = p-obj-code
      405               and buf_shift-obj.status_  = 'зкр':U
      406             use-index stts
      407             no-error .
      408           if available buf_shift-obj
      409           then do:
      410             assign
      411               v-extra-message =
      412                     substitute("Дата начала последеней закрытой смены на объекте &1"
      413                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      414                               )
      415             .
      416           end.
      417           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      418           undo, return error v-error .
      419         end.
      420       end.
      421     end.
      422   end procedure.
      423   procedure factord-end-day :
      424     define input  parameter p-fact-date            as date    no-undo .
      425     define output parameter p-day-end-fact-order   as decimal no-undo .
      426     do
      427     on error undo, return error return-value
      428     :
      429       if p-fact-date = ?
      430       then do:
      431         return error "Не указана фактическая дата" .
      432       end.
      433       assign
      434         p-day-end-fact-order = integer(p-fact-date) + 0.99
      435       .
      436     end.
      437   end procedure.
      438   procedure factord-to-date :
      439     define input  parameter p-fact-order as decimal no-undo .
      440     define output parameter p-fact-date  as date    no-undo .
      441     define variable v-ref-date  as date      no-undo .
      442     define variable v-ref-delta as integer   no-undo .
      443     do
      444     on error undo, return error return-value
      445     :
      446       if p-fact-order = ?
      447       or p-fact-order = 0
      448       then do:
      449         return error "Не указан fact-order" .
      450       end.
      451       assign
      452         v-ref-date  = date(1, 1, 2000)
      453       .
      454       assign
      455         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      456       .
      457       assign
      458         p-fact-date = v-ref-date + v-ref-delta
      459       .
      460     end.
      461   end procedure.
      462   procedure factord-to-fact-num :
      463     define input  parameter p-fact-order as decimal no-undo .
      464     define output parameter p-fact-num   as integer no-undo .
      465     define variable v-fact-order-trunc as decimal no-undo .
      466     do
      467     on error undo, return error return-value
      468     :
      469       if p-fact-order = ?
      470       or p-fact-order = 0
      471       then do:
      472         return error "Не указан fact-order" .
      473       end.
      474       assign
      475        v-fact-order-trunc = truncate(p-fact-order, 2)
      476       .
      477       assign
      478         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      479       .
      480     end.
      481   end procedure.
      482   procedure factord-to-shift-num :
      483     define input  parameter p-fact-order as decimal no-undo .
      484     define output parameter p-shift-num   as integer no-undo .
      485     define variable  p-shift-numd  as decimal   no-undo .
      486     define variable v-fact-order-trunc as decimal no-undo .
      487     do
      488     on error undo, return error return-value
      489     :
      490       if p-fact-order = ?
      491       or p-fact-order = 0
      492       then do:
      493         return error "Не указан fact-order" .
      494       end.
      495       assign
      496        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      497       .
      498       if v-fact-order-trunc < 0.5 then do:
      499         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      500       end.
      501       assign
      502         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      503         .
      504        assign
      505         p-shift-num = truncate (p-shift-numd , 0)
      506       .
      507     end.
      508   end procedure.
      509   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      510   procedure cur-time :
      511      define output parameter p-today as date      no-undo .
      512      define output parameter p-time  as integer   no-undo .
      513     do
      514     on error undo, return error
      515     :
      516       define variable v-date1 as date      no-undo .
      517       define variable v-date2 as date      no-undo .
      518       define variable v-time  as integer   no-undo .
      519       assign
      520         v-date1 = today
      521         v-time  = time
      522         v-date2 = today
      523       .
      524       if v-date1 <> v-date2
      525       then do:
      526         assign
      527           v-date1 = today
      528           v-time  = v-time
      529         .
      530       end.
      531       assign
      532         p-today = v-date1
      533         p-time  = v-time
      534       .
      535     end.
      536   end.
      537   function cur-time-date returns character
      538   :
      539     return string(today, '99/99/9999':U) .
      540   end.
      541   function cur-time-mjd returns decimal
      542   :
      543     define variable v-date as date      no-undo .
      544     define variable v-time as integer   no-undo .
      545     run cur-time in this-procedure
      546       (output v-date
      547       ,output v-time
      548       ) .
      549     return integer(v-date) - 2400002 + (v-time / 86400) .
      550   end.
      551   function cur-time-get-ending-index returns integer
      552   (input p-number as integer
      553   )
      554   :
      555     if p-number < 0
      556     or p-number = ?
      557     then do:
      558       return 1 .
      559     end.
      560     define variable v-rest as integer   no-undo .
      561     assign
      562       p-number = p-number modulo 100
      563     .
      564     if p-number < 20
      565     then do:
      566       assign
      567         v-rest = p-number
      568       .
      569     end.
      570     else do:
      571       assign
      572         v-rest = p-number modulo 10
      573       .
      574     end.
      575     case v-rest :
      576       when 1
      577       then do:
      578         return 2 .
      579       end.
      580       when 2 or
      581       when 3 or
      582       when 4
      583       then do:
      584         return 3 .
      585       end.
      586       otherwise do:
      587         return 1 .
      588       end.
      589     end case .
      590   end.
      591   procedure cur-time-mjd-to-date :
      592      define input  parameter i-mjd-diff as decimal no-undo.
      593      define output parameter o-Date     as date    no-undo.
      594      define output parameter o-Time     as integer no-undo.
      595      define variable v-day-number as integer   no-undo .
      596      if    i-mjd-diff < 0
      597         or i-mjd-diff = ?
      598      then do:
      599         return "?" .
      600      end.
      601      assign
      602         v-day-number = truncate(i-mjd-diff,0).
      603         o-Date = date(v-day-number + 2400002).
      604         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      605     .
      606   end.
      607   function cur-time-mjd-to-string returns character
      608   (input p-mjd-diff as decimal
      609   )
      610   :
      611     define variable v-day-number as integer   no-undo .
      612     define variable v-seconds    as integer   no-undo .
      613     define variable v-hour       as integer   no-undo .
      614     define variable v-min        as integer   no-undo .
      615     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      616     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      617     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      618     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      619     if p-mjd-diff < 0
      620     or p-mjd-diff = ?
      621     then do:
      622       return "?" .
      623     end.
      624     assign
      625       v-day-number = integer(truncate(p-mjd-diff,0))
      626       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      627     .
      628     if v-seconds > 86400
      629     then do:
      630       assign
      631         v-seconds = 86400 - 1
      632       .
      633     end.
      634     if v-seconds < 0
      635     then do:
      636       assign
      637         v-seconds = 0
      638       .
      639     end.
      640     assign
      641       v-hour = truncate(v-seconds / 3600, 0)
      642     .
      643     assign
      644       v-seconds = v-seconds modulo 3600
      645     .
      646     assign
      647       v-min = truncate(v-seconds / 60, 0)
      648     .
      649     assign
      650       v-seconds = v-seconds modulo 60
      651     .
      652     return
      653         (if v-day-number <> 0
      654           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      655           else ""
      656         )
      657       + (if v-day-number <> 0 or v-hour <> 0
      658           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      659           else ""
      660         )
      661       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      662           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      663           else ""
      664         )
      665       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      666       .
      667   end.
      668   function cur-time-string returns character
      669   :
      670     define variable v-date as date      no-undo .
      671     define variable v-time as integer   no-undo .
      672     run cur-time in this-procedure
      673       (output v-date
      674       ,output v-time
      675       ) .
      676     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      677   end.
      678   function cur-time-string-sec returns character
      679   :
      680     define variable v-date as date      no-undo .
      681     define variable v-time as integer   no-undo .
      682     run cur-time in this-procedure
      683       (output v-date
      684       ,output v-time
      685       ) .
      686     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      687   end.
      688   function cur-time-custom  returns character
      689   (input p-prefix as character
      690   ,input p-date-format as character
      691   ,input p-delimiter as character
      692   ,input p-time-format as character
      693   ,input p-suffix as character
      694   )
      695   :
      696     define variable v-date as date      no-undo .
      697     define variable v-time as integer   no-undo .
      698     run cur-time in this-procedure
      699       (output v-date
      700       ,output v-time
      701       ) .
      702     return
      703       p-prefix
      704       + string(v-date, p-date-format)
      705       + p-delimiter
      706       + string(v-time, p-time-format)
      707       + p-suffix
      708       .
      709   end.
      710   function cur-time-print  returns character
      711   :
      712     define variable v-date as date      no-undo .
      713     define variable v-time as integer   no-undo .
      714     run cur-time in this-procedure
      715       (output v-date
      716       ,output v-time
      717       ) .
      718     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      719   end.
      720   function cur-time-datetime returns datetime
      721   :
      722     define variable v-char as character no-undo .
      723     define variable v-datetime as datetime no-undo .
      724     v-char = cur-time-string().
      725     v-datetime = datetime(v-char).
      726     return  v-datetime.
      727   end.
      728   function cur-time-string-msec returns character
      729   :
      730     define variable v-date as datetime  no-undo .
      731     v-date = now.
      732     return string(v-date) .
      733   end.
      734   define variable v-mess as character no-undo .
      735   DEFINE buffer for-goods for ub.goods.
      736   define buffer buf_goods for ub.goods.
      737   define variable found as logical no-undo.
      738   define variable vargds-code like ub.goods.gds-code no-undo.
      739   DEFINE VARIABLE varrate-code like ub.tax-rate.rate-code no-undo .
      740   DEFINE VARIABLE vartax-value like ub.tax-rate-value.rate-value no-undo .
      741   DEFINE VARIABLE vtoday-fact-order as decimal no-undo .
      742   DEFINE VARIABLE vgds-fact-order as decimal no-undo .
      743   DEFINE VARIABLE varfact-date like ub.tax-rate-gds.fact-date no-undo .
      744   DEFINE VARIABLE is-copy as logical no-undo .
      745   DEFINE VARIABLE v-today as date no-undo .
      746   DEFINE VARIABLE v-time as integer no-undo .
      747   define buffer buf_units for ub.units.
      748   define buffer buf_tax-units for ub.tax-units.
      749   define buffer buf_tax-rate-gds for ub.tax-rate-gds.
      750   define buffer buf_tax-rate-gds-grp for ub.tax-rate-gds-grp.
      751   define buffer buf_tax-rate for ub.tax-rate.
      752   define buffer buf_tax for ub.tax.
      753   if (parhost-code = 0 or
      754      parobj-type = "":U or
      755      parobj-code = 0)
      756   and p-silent = no
      757   then do:
      758      message
      759      vss-workfile vss-revision vss-description skip
      760      "Неверные значения параметров объект и/или фирма при вызове процедуры dtaxgdss.p "
      761      view-as alert-box error .
      762   end.
      763   for each tt-tax:
      764       delete tt-tax.
      765   end.
      766   FIND FIRST buf_units no-lock where
      767              buf_units.unit-name = parunit-base NO-ERROR.
      768   if not avail buf_units then do:
      769     v-mess = substitute("Нет ед. изм. &1", parunit-base).
      770     run err-mess in this-procedure ( input-output v-mess).
      771     return error (if p-silent = yes then v-mess else '':U).
      772   end.
      773   _main:
      774   do
      775   on error undo, return error
      776   :
      777     IF not par-recid = par-copy then do:
      778       FIND FIRST for-goods NO-LOCK WHERE
      779                   recid(for-goods) = par-copy no-error.
      780       if not avail for-goods then do:
      781         v-mess = substitute("Нет товара с recid &1, заданного как источник при копировании", par-copy).
      782         run err-mess in this-procedure ( input-output v-mess).
      783         undo _main, return error (if p-silent = yes then v-mess else '':U).
      784       end.
      785       assign
      786       vargds-code = for-goods.gds-code
      787       is-copy = yes
      788       .
      789     end.
      790     else do:
      791       if par-recid <> ? then do:
      792         find first buf_goods no-lock where
      793                   recid(buf_goods) = par-recid no-error .
      794         if not available buf_goods then do:
      795           v-mess = substitute("Нет товара с recid &1", par-recid).
      796           run err-mess in this-procedure ( input-output v-mess).
      797           undo _main, return error (if p-silent = yes then v-mess else '':U).
      798         end.
      799       end.
      800       if avail buf_goods
      801       then
      802       assign
      803       vargds-code = buf_goods.gds-code
      804       .
      805     end.
      806     if par-recid <> ? then do:
      807       run cur-time in this-procedure(output v-today, output v-time).
      808     end.
      809     else do:
      810       assign
      811       v-today = 01/01/1990
      812       .
      813     end.
      814     run factord-end-day in this-procedure (
      815                                             input v-today
      816                                            ,output vtoday-fact-order).
      817     FOR EACH buf_tax-units No-LOCK WHERE
      818               LOOKUP(buf_tax-units.type, buf_units.type) > 0
      819         BREAK BY
      820         buf_tax-units.tax-code:
      821       IF FIRST-OF(buf_tax-units.tax-code) then do:
      822         found = no.
      823         FIND FIRST buf_tax No-LOCK WHERE
      824                     buf_tax.tax-code = buf_tax-units.tax-code No-ERROR.
      825         if error-status:error or not avail buf_tax then do:
      826           v-mess = substitute("Не найден налог с кодом &1 для ед.изм. с типом &2"
      827                              , buf_tax-units.tax-code
      828                              ,buf_units.type).
      829           run err-mess in this-procedure ( input-output v-mess).
      830           undo _main, return error (if p-silent = yes then v-mess else '':U).
      831         end.
      832         if NOT buf_tax.individual then do:
      833           if par-copy <> ? then do:
      834             FIND LAST buf_tax-rate-gds No-LOCK WHERE
      835                       buf_tax-rate-gds.gds-code = vargds-code AND
      836                       buf_tax-rate-gds.tax-code = buf_tax.tax-code AND
      837                       buf_tax-rate-gds.host-code = 0 AND
      838                       buf_tax-rate-gds.obj-type = "" AND
      839                       buf_tax-rate-gds.obj-code = 0
      840                        use-index pi
      841                         No-ERROR.
      842             if avail buf_tax-rate-gds then do:
      843               found = yes.
      844               assign
      845               varrate-code = buf_tax-rate-gds.rate-code
      846               varfact-date = ( if is-copy then v-today else  buf_tax-rate-gds.fact-date)
      847               .
      848               run factord-end-day in this-procedure (input varfact-date,
      849                                                     output vgds-fact-order).
      850             end.
      851             else do:
      852               if vargds-code <> 0 then do:
      853                 v-mess = substitute("Не найдена запись ставки налога на товар &1&2"  +
      854                                     "Код налога &3&2"  +
      855                                     "Будет показана ставка налога по соответствующей группе&2" +
      856                                     "Для исправления ошибки и создания записи ставки налога&2"  +
      857                                     "откройте карточку товара на изменение и сохраните её.&2" +
      858                                     "Будет создана запись ставки налога на товар с датой 01/01/1990"
      859                                      , vargds-code
      860                                      ,chr(10)
      861                                      ,buf_tax.tax-code ).
      862                 run err-mess in this-procedure ( input-output v-mess).
      863                 if p-silent then undo _main, return error (if p-silent = yes then v-mess else '':U).
      864               end.
      865             end.
      866           end.
      867           if par-copy = ? or not found then do:
      868             FIND FIRST buf_tax-rate-gds-grp No-LOCK WHERE
      869                         buf_tax-rate-gds-grp.node-code = parnode-code AND
      870                         buf_tax-rate-gds-grp.tax-code = buf_tax.tax-code No-ERROR.
      871             if not avail buf_tax-rate-gds-grp then do:
      872               v-mess = substitute("Не найдена ставка налога на товар группы товаров с кодом группы &1&2"  +
      873                                   "Код налога &3"
      874                                     ,parnode-code
      875                                     ,chr(10)
      876                                     ,buf_tax.tax-code ).
      877               run err-mess in this-procedure ( input-output v-mess).
      878               undo _main, return error (if p-silent = yes then v-mess else '':U).
      879             end.
      880             assign
      881             varrate-code = buf_tax-rate-gds-grp.rate-code
      882             varfact-date = v-today
      883             .
      884             run factord-end-day in this-procedure (input varfact-date, output vgds-fact-order).
      885           end.
      886           FIND FIRST buf_tax-rate No-LOCK WHERE
      887                     buf_tax-rate.tax-code = buf_tax.tax-code AND
      888                     buf_tax-rate.rate-code = varrate-code No-ERROR.
      889           if error-status:error or not avail buf_tax-rate then do:
      890             v-mess = substitute("Не найдена запись ставки налога:&1"  +
      891                                 "Код налога &2&1" +
      892                                 "Код ставки &3"
      893                                 ,chr(10)
      894                                 ,buf_tax.tax-code
      895                                 ,varrate-code).
      896             run err-mess in this-procedure ( input-output v-mess).
      897             undo _main, return error (if p-silent = yes then v-mess else '':U).
      898           end.
      899   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      900   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftaxval in g#library
      901     (input  recid(buf_tax-rate)
      902     ,input  0
      903     ,input  0
      904     ,input  ?
      905     ,input  parhost-code
      906     ,input  parobj-type
      907     ,input  parobj-code
      908     ,output vartax-value
      909     ) no-error .
      910           if error-status:error or vartax-value = ? then do:
      911             v-mess = substitute("Ошибка при определении значения ставки налога на товар&1"  +
      912                                "код налога: &2&1" +
      913                                "ставка налога: &3"
      914                                ,chr(10)
      915                                ,buf_tax-rate.tax-code
      916                                ,buf_tax-rate.rate-code).
      917             run err-mess in this-procedure ( input-output v-mess).
      918             undo _main, return error (if p-silent = yes then v-mess else '':U).
      919           end.
      920         end.
      921         FIND FIRST tt-tax NO-LOCK WHERE
      922                   tt-tax.tax-code = buf_tax.tax-code No-ERROR.
      923         if not avail tt-tax then do:
      924             create
      925             tt-tax.
      926             assign
      927             tt-tax.tax-code = buf_tax.tax-code
      928             tt-tax.tax-name = buf_tax.tax-name
      929             tt-tax.rate-code = if buf_tax.individual then ? else buf_tax-rate.rate-code
      930             tt-tax.rate-name = if buf_tax.individual then buf_tax.tax-name else buf_tax-rate.rate-name
      931             tt-tax.tax-type = buf_tax.tax-type
      932             tt-tax.rate-value = if buf_tax.individual then ? else vartax-value
      933             tt-tax.individual = buf_tax.individual
      934             tt-tax.tax-rate-gds-rc = if (avail buf_goods and recid(buf_goods) = par-copy and avail buf_tax-rate-gds )
      935                                 then recid(buf_tax-rate-gds)
      936                                 else ?
      937             tt-tax.fact-date = varfact-date
      938             tt-tax.fact-order = vgds-fact-order
      939             .
      940             if (avail buf_goods and recid(buf_goods) = par-copy and avail buf_tax-rate-gds ) then
      941             assign
      942             tt-tax.corr-user-name    = buf_tax-rate-gds.corr-user-name
      943             tt-tax.corr-user-db-num  = buf_tax-rate-gds.corr-user-db-num
      944             tt-tax.corr-date         = buf_tax-rate-gds.corr-date
      945             tt-tax.corr-time         = buf_tax-rate-gds.corr-time
      946             .
      947         end.
      948       END.
      949     END.
      950   end.
      951   PROCEDURE err-mess:
      952     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      953     CASE p-silent:
      954       when yes then do:
      955         assign
      956         p-mess = substitute("Определение налогов на товар:&1&2"
      957                            , chr(10)
      958                            , p-mess)
      959         .
      960       end.
      961       when no then do:
      962         message
      963         p-mess
      964         view-as alert-box error .
      965       end.
      966     end.
      967   END PROCEDURE.
