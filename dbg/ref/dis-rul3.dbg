      850             and buf_Dis-cfg-rule.discnt-role = buf_dis-grp-rule.discnt-role
      851             and buf_Dis-cfg-rule.self-nonunique = buf_Dis-grp-rule.classif-type
      852             and buf_Dis-cfg-rule.link-prop = integer('0':U)
      853         on error undo, return error :
      854           delete buf_dis-grp-rule.
      855         end.
      856       end.
      857       if v-dis-some-rule-log then do:
      858         for each buf_dis-some-rule share-lock where
      859                 buf_dis-some-rule.rule-num = buf2_dis-rule.rule-num
      860         on error undo, return error :
      861           delete buf_dis-some-rule.
      862         end.
      863       end.
      864       delete buf2_dis-rule no-error .
      865       if error-status:error then do:
      866         run err-mess in this-procedure ( substitute("Ошибка при удалении ПРАВИЛА СКИДКИ №&1: &2 &3", buf2_dis-rule.rule-num, error-status:get-message(1), return-value  ), output v-ret-mess).
      867         undo, return error (if p-silent then v-ret-mess else "":U).
      868       end.
      869     end.
      870     for each buf_dis-thbj-rule exclusive-lock where
      871             buf_dis-thbj-rule.rule-num = buf_dis-rule.rule-num,
      872     first buf_dis-cfg-rule no-lock where
      873         buf_Dis-cfg-rule.table-name = 'dis-thbj-rule':U
      874     and buf_Dis-cfg-rule.templ-rl-root = buf_dis-thbj-rule.templ-rl-root
      875     and buf_Dis-cfg-rule.pos-type = buf_dis-thbj-rule.pos-type
      876     and (buf_Dis-cfg-rule.time-templ-rl-root = buf_dis-thbj-rule.time-templ-rl-root
      877         or (buf_dis-thbj-rule.time-templ-rl-root = 0
      878             and
      879             lookup("time-rule-num", v-level-2) > 0))
      880     and buf_Dis-cfg-rule.discnt-role = buf_dis-thbj-rule.discnt-role
      881     on error  undo,  return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      882     on stop   undo, return error substitute( "&1. stop", vss-workfile )
      883     on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      884     :
      885       if buf_Dis-cfg-rule.link-prop = integer('0':U)
      886       then do:
      887         define buffer buf2_dis-cfg-rule for ub.dis-cfg-rule.
      888         define buffer buf2_dis-thbj-rule for ub.dis-thbj-rule.
      889         for each buf2_dis-cfg-rule no-lock where
      890             buf2_Dis-cfg-rule.table-name = 'dis-thbj-rule':U
      891         and buf2_Dis-cfg-rule.pos-type = buf_dis-thbj-rule.pos-type
      892         and buf2_Dis-cfg-rule.discnt-role = buf_dis-thbj-rule.discnt-role
      893         and buf2_Dis-cfg-rule.link-prop = integer('3':U),
      894            each buf2_dis-thbj-rule where
      895                buf2_dis-thbj-rule.templ-rl-root = buf2_dis-cfg-rule.templ-rl-root
      896            and buf2_dis-thbj-rule.pos-type = buf2_dis-cfg-rule.pos-type
      897            and buf2_dis-thbj-rule.discnt-role = buf2_dis-cfg-rule.discnt-role
      898            and buf2_dis-thbj-rule.rule-num = buf_dis-rule.key#_one
      899         on error  undo,  return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      900         on stop   undo, return error substitute( "&1. stop", vss-workfile )
      901         on endkey undo, return error substitute( "&1. endkey", vss-workfile )
      902         :
      903           delete buf2_dis-thbj-rule.
      904         end.
      905         delete buf_dis-thbj-rule.
      906       end.
      907     end.
      908     for each buf2_dis-rule where
      909             buf2_dis-rule.rl-root = buf_dis-rule.rule-num
      910     on error undo, return error
      911     on stop undo, return error :
      912       if buf2_dis-rule.rule-num = buf_dis-rule.rule-num then next.
      913       delete buf2_dis-rule.
      914     end.
      915     delete buf_dis-rule no-error.
      916     if error-status:error then do:
      917       run err-mess in this-procedure ( substitute("Ошибка при удалении ПРАВИЛА СКИДКИ №&1: &2 &3", buf_dis-rule.rule-num, error-status:get-message(1), return-value  ), output v-ret-mess).
      918       undo, return error (if p-silent then v-ret-mess else "":U).
      919     end.
      920   end.
      921   PROCEDURE err-mess:
      922     DEFINE INPUT PARAMETER p-mess as character No-UNDO.
      923     define output parameter p-ret-mess as character no-undo .
      924     CASE p-silent:
      925       when yes then do:
      926         p-ret-mess = substitute("ПРАВИЛО СКИДКИ №&1:&2&3", buf_dis-rule.rule-num, chr(10), p-mess).
      927       end.
      928       otherwise do:
      929         message
      930         p-mess
      931         view-as alert-box error .
      932       end.
      933     end.
      934   END PROCEDURE.
