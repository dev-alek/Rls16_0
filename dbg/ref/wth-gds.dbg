        1   block-level on error undo, throw.
        2   define input parameter        p-mode as character no-undo .
        3   define input parameter        p-silent as logical no-undo .
        4   define input-output parameter p-rec  as recid     no-undo .
        5   define input PARAMETER        p-wth-code LIKE ub.wealth.wth-code NO-UNDO.
        6   define input PARAMETER        p-gds LIKE ub.wth-gds.gds-code NO-UNDO.
        7   define input parameter        p-stts like ub.wth-gds.stts no-undo.
        8   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: wth-gds.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: ref/wth-gds.p $":U .
       13   define variable vss-description as character no-undo init "Добавление\изменение записи в таблице связи МЦ с товарами".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   define variable v-mess as character no-undo .
       84   define buffer buf_wth-gds for ub.wth-gds.
       85   define buffer buf_wealth for ub.wealth.
       86   define buffer buf_goods for ub.goods.
       87    if p-mode <> 'ДОБАВЛЕНИЕ':U
       88    AND p-mode <> 'ИЗМЕНЕНИЕ':U then do:
       89      message vss-workfile vss-revision vss-description skip
       90              "Неверный параметр p-mode - " p-mode
       91      view-as alert-box error .
       92      return error '':u.
       93    end.
       94   main-block:
       95   do
       96    on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
       97    on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       98    on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       99   :
      100     find first  buf_goods where buf_goods.gds-code = p-gds no-lock no-error.
      101      if not available buf_goods then do:
      102        v-mess = substitute("Не найден товар с кодом &1",p-gds).
      103        run err-mess in this-procedure ( input-output v-mess).
      104        return error (if p-silent = yes then v-mess else 'gds-code':U).
      105      end.
      106     FIND FIRST  buf_wealth where buf_wealth.wth-code = p-wth-code  NO-LOCK NO-ERROR.
      107      if not available buf_wealth then do:
      108        v-mess = substitute("Не найдена МЦ с кодом &1",p-wth-code).
      109        run err-mess in this-procedure ( input-output v-mess).
      110        return error (if p-silent = yes then v-mess else 'wth-code':U).
      111      end.
      112     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      113       create buf_wth-gds.
      114     end.
      115     else do:
      116       find first buf_wth-gds where RECID(buf_wth-gds) = p-rec exclusive-lock no-wait no-error.
      117       if not available buf_wth-gds then do:
      118         v-mess = substitute('Запись связи МЦ с товаром не найдена!').
      119         run err-mess in this-procedure ( input-output v-mess).
      120         return error (if p-silent = yes then v-mess else '':U).
      121       end.
      122     end.
      123       assign
      124       buf_wth-gds.wth-code = p-wth-code
      125       buf_wth-gds.gds-code = p-gds
      126       buf_wth-gds.stts = p-stts
      127       p-rec = recid(buf_wth-gds)
      128     .
      129     release buf_wth-gds no-error .
      130     if error-status:error then do:
      131       v-mess = substitute("Ошибка при сохранения связи МЦ с товарами:&1&2&3"
      132                            , error-status:get-message(1)
      133                            , chr(10)
      134                            , return-value
      135                            ).
      136       run err-mess in this-procedure ( input-output v-mess).
      137       return error (if p-silent = yes then v-mess else '':U).
      138     end.
      139   end.
      140   PROCEDURE err-mess:
      141     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      142     CASE p-silent:
      143       when yes then do:
      144         assign
      145         p-mess = substitute("Материальная ценность: код &1&3&4"
      146                            , p-wth-code
      147                            , chr(10)
      148                            , p-mess)
      149         .
      150       end.
      151       when no then do:
      152         message
      153         p-mess
      154         view-as alert-box error .
      155       end.
      156     end.
      157   END PROCEDURE.
