     2721       define variable  parameter-7-27 as character no-undo .
     2722         assign
     2723         parameter-3-27 =
     2724                                 "FOR EACH X_clients"
     2725         parameter-4-27 =
     2726           (
     2727             if (" X_clients.obj-type = Cli-Types                             AND X_clients.grp-name begins Curr-Grp-Name                             AND X_clients.stts <> 0 " + " " + where-phrase-27) <> ""
     2728             then  substitute('X_clients.obj-type = &1&2&1                             AND X_clients.grp-name begins &1&3&1                             AND X_clients.stts <> 0 ', chr(34), Cli-Types, Curr-Grp-Name)  + " " + where-phrase-27
     2729             else "true"
     2730           )
     2731         parameter-5-27 = (" " + "" + " " + "")
     2732         parameter-6-27 = if sort-phrase-27 = ''
     2733                              then
     2734           (
     2735           " " + " use-index obj-type_obj-name " +
     2736             " " + sort-column-phrase +
     2737           " " + " BY X_clients.obj-name  "
     2738           )
     2739                              else
     2740           (
     2741           " " + " use-index obj-type_obj-name " +
     2742             " " + sort-column-phrase +
     2743           " " + sort-phrase-27
     2744           )
     2745         parameter-7-27 =
     2746           " indexed-reposition  "
     2747       .
     2748       do
     2749       on stop undo, leave
     2750       on error undo, leave
     2751       :
     2752         assign
     2753           l-disable-where-27 =
     2754             (" X_clients.obj-type = Cli-Types                             AND X_clients.grp-name begins Curr-Grp-Name                             AND X_clients.stts <> 0 " + " " + where-phrase-27 = "")
     2755         .
     2756         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2757                             ,input query cli-list:handle
     2758                             ,input parameter-3-27
     2759                             ,input parameter-4-27
     2760                             ,input parameter-5-27
     2761                             ,input parameter-6-27
     2762                             ,input parameter-7-27
     2763                             )
     2764         .
     2765         assign
     2766           l-filter-open-27 = true
     2767         .
     2768       end.
     2769       if l-filter-open-27 = false then do:
     2770         message
     2771           "Ошибка при фильтрации / сортировке" skip
     2772           "Будут показаны записи без учета фильтра" skip
     2773           view-as alert-box .
     2774       end.
     2775       else do:
     2776           assign
     2777             l-query-was-opened = true
     2778           .
     2779       end.
     2780     end.
     2781     if l-filter-open-27 = false then do:
     2782       OPEN QUERY CLi-List FOR EACH X_clients no-lock
     2783         where  X_clients.obj-type = Cli-Types                             AND X_clients.grp-name begins Curr-Grp-Name                             AND X_clients.stts <> 0
     2784          use-index obj-type_obj-name
     2785          BY X_clients.obj-name
     2786         indexed-reposition
     2787     .
     2788         assign
     2789           l-query-was-opened = true
     2790         .
     2791     end.
     2792   end.
     2793   else do:
     2794     assign
     2795       v-doc-rec = recid( ub.clients )
     2796     .
     2797     do
     2798     on stop undo, leave
     2799     on error undo, leave
     2800     :
     2801       if query cli-list:handle:get-buffer-handle(1) = (buffer X_clients:handle) then do:
     2802         assign
     2803         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     2804         parameter-4-27 =
     2805           "where ":u +  substitute('X_clients.obj-type = &1&2&1                             AND X_clients.grp-name begins &1&3&1                             AND X_clients.stts <> 0 ', chr(34), Cli-Types, Curr-Grp-Name)  + " ":u + where-phrase-27 + " ":u + p-find-condition + " " + ""
     2806         parameter-5-27 = " use-index obj-type_obj-name "
     2807       .
     2808         run fltopend_fltfindd in this-procedure  (
     2809                             input this-procedure:handle
     2810                             ,input query cli-list:handle
     2811                             ,input rowid(ub.clients)
     2812                             ,input logical(parameter-2-27)
     2813                             ,input no-lock
     2814                             ,input (buffer ub.clients:handle)
     2815                             ,input parameter-4-27
     2816                             ,input parameter-5-27
     2817                             ) no-error.
     2818         .
     2819         assign
     2820           v-doc-rec = integer(return-value)
     2821           v-fltopend-rowid[1] = ?
     2822         .
     2823       end.
     2824       else do:
     2825         assign
     2826         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     2827         parameter-3-27 =  "FOR EACH X_clients"
     2828         parameter-4-27 =
     2829           (
     2830             if (" X_clients.obj-type = Cli-Types                             AND X_clients.grp-name begins Curr-Grp-Name                             AND X_clients.stts <> 0 " + " " + where-phrase-27) <> ""
     2831             then  substitute('X_clients.obj-type = &1&2&1                             AND X_clients.grp-name begins &1&3&1                             AND X_clients.stts <> 0 ', chr(34), Cli-Types, Curr-Grp-Name)  + " " + where-phrase-27
     2832             else "true"
     2833           )
     2834         parameter-5-27 = (" " + "" + " " + "" + " " + p-find-condition)
     2835         parameter-6-27 = if sort-phrase-27 = ''
     2836                              then
     2837           (
     2838           " " + " use-index obj-type_obj-name " +
     2839             " " + sort-column-phrase +
     2840           " " + " BY X_clients.obj-name  "
     2841           )
     2842                              else
     2843           (
     2844           " " + " use-index obj-type_obj-name " +
     2845             " " + sort-column-phrase +
     2846           " " + sort-phrase-27
     2847           )
     2848         parameter-7-27 =
     2849           " indexed-reposition  "
     2850       .
     2851         run fltopend_fltfindq in this-procedure  (
     2852                             input this-procedure:handle
     2853                             ,input query cli-list:handle
     2854                             ,input logical(parameter-2-27)
     2855                             ,input no-lock
     2856                             ,input parameter-3-27
     2857                             ,input parameter-4-27
     2858                             ,input parameter-5-27
     2859                             ,input parameter-6-27
     2860                             ,input parameter-7-27
     2861                             ,output v-fltopend-rowid
     2862                             ) no-error.
     2863         .
     2864         v-doc-rec = ?.
     2865       end.
     2866       assign
     2867         l-query-was-opened = true
     2868       .
     2869     end.
     2870   end.
     2871     run waitfram-hide in this-procedure .
     2872         end.
     2873       END CASE .
     2874     end.
     2875   END CASE.
     2876     end.
     2877   end procedure.
