      865   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      866   procedure fltopend_fltopend :
      867   define input parameter p-parent-handle as handle no-undo .
      868   define input parameter p-qh as handle no-undo .
      869   define input parameter p-flt-open-open-query  as character no-undo .
      870   define input parameter p-where-cond as character no-undo .
      871   define input parameter p-use-indFIRST-query-tail as character no-undo .
      872   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      873   define input parameter p-indexed-reposition as character no-undo .
      874     do
      875     on error undo, return error
      876     :
      877   define variable v-prepare-string as character no-undo .
      878   define variable glog as logical no-undo .
      879   assign
      880   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      881                      p-where-cond + chr(32)  +
      882                      p-use-indFIRST-query-tail + chr(32) +
      883                      p-use-ind-sort-clmn-by + chr(32) +
      884                      p-indexed-reposition
      885   .
      886   assign
      887   glog = p-qh:query-prepare(v-prepare-string) no-error .
      888   if not glog
      889   or error-status:error then do:
      890     message error-status:get-message(1) view-as alert-box .
      891     undo, return error .
      892   end.
      893   assign
      894   glog = p-qh:query-open no-error .
      895   if not glog
      896   or error-status:error then do:
      897     message error-status:get-message(1) view-as alert-box .
      898     undo, return error .
      899   end.
      900     end.
      901   end procedure.
      902   procedure fltopend_fltfindd :
      903   define input parameter p-parent-handle as handle no-undo .
      904   define input parameter p-qh as handle no-undo .
      905   define input parameter p-rowid as rowid no-undo .
      906   define input parameter p-next as logical no-undo .
      907   define input parameter p-lock as integer no-undo .
      908   define input parameter p-bh as handle no-undo .
      909   define input parameter p-where-cond as character no-undo .
      910   define input parameter p-use-index-phrase as character no-undo .
      911   define variable glog as logical no-undo .
      912   define variable v-qh as handle no-undo .
      913   define variable v-bh as handle no-undo .
      914   define variable v-recid as recid no-undo .
      915   define variable v-prepare-string as character no-undo .
      916   do
      917   on error undo, return error
      918   on stop undo, return error
      919   :
      920     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      921     create buffer v-bh for table p-bh buffer-name p-bh:name.
      922     create query v-qh.
      923     v-qh:set-buffers(v-bh).
      924     v-prepare-string = substitute("for each &1 &2 &3"
      925                                     ,v-bh:name
      926                                     ,p-where-cond
      927                                     ,p-use-index-phrase).
      928     glog = v-qh:query-prepare(v-prepare-string) no-error.
      929     if not glog then do:
      930       delete object v-qh.
      931       delete object v-bh.
      932       undo, return error .
      933     end.
      934     glog = v-qh:query-open no-error .
      935     if not glog then do:
      936       delete object v-qh.
      937       delete object v-bh.
      938       undo, return error .
      939     end.
      940     if p-next then do:
      941       v-qh:reposition-to-rowid(p-rowid) no-error .
      942       glog = v-qh:get-next( p-lock) no-error .
      943       glog = v-qh:get-next( p-lock) no-error .
      944       if not glog or v-qh:query-off-end = yes then do:
      945         glog = v-qh:get-first( p-lock) no-error .
      946       end.
      947     end.
      948     else do:
      949       glog = v-qh:get-first( p-lock) no-error .
      950     end.
      951     v-recid = v-bh:recid no-error .
      952     delete object v-qh.
      953     delete object v-bh.
      954     return string(v-recid) .
      955   end.
      956   end procedure.
      957   procedure fltopend_fltfindq :
      958   define input parameter p-parent-handle as handle no-undo .
      959   define input parameter p-qh as handle no-undo .
      960   define input parameter p-next as logical no-undo .
      961   define input parameter p-lock as integer no-undo .
      962   define input parameter p-flt-open-open-query  as character no-undo .
      963   define input parameter p-where-cond as character no-undo .
      964   define input parameter p-use-indFIRST-query-tail as character no-undo .
      965   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      966   define input parameter p-indexed-reposition as character no-undo .
      967   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      968   define variable glog as logical no-undo .
      969   define variable v-qh as handle no-undo .
      970   define variable v-bh as handle no-undo extent 18.
      971   define variable v-rowid as rowid no-undo extent 18.
      972   define variable v-ii as integer no-undo .
      973   define variable v-prepare-string as character no-undo .
      974   do
      975   on error undo, return error
      976   on stop undo, return error
      977   :
      978     create query v-qh.
      979     do v-ii = 1 to p-qh:num-buffers:
      980       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      981       assign
      982       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      983       no-error.
      984       v-qh:add-buffer(v-bh[v-ii]).
      985     end.
      986     assign
      987     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      988                       p-where-cond + chr(32)  +
      989                       p-use-indFIRST-query-tail + chr(32) +
      990                       p-use-ind-sort-clmn-by + chr(32) +
      991                       p-indexed-reposition
      992     .
      993     glog = v-qh:query-prepare( v-prepare-string) no-error .
      994     if not glog then do:
      995       delete object v-qh.
      996       do v-ii = 1 to p-qh:num-buffers:
      997         delete object v-bh[v-ii].
      998       end.
      999       undo, return error .
     1000     end.
     1001     glog = v-qh:query-open no-error .
     1002     if not glog then do:
     1003       delete object v-qh.
     1004       do v-ii = 1 to p-qh:num-buffers:
     1005         delete object v-bh[v-ii].
     1006       end.
     1007       undo, return error .
     1008     end.
     1009     if p-next then do:
     1010       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1011       glog = v-qh:get-next( p-lock) no-error .
     1012       glog = v-qh:get-next( p-lock) no-error .
     1013       if not glog or v-qh:query-off-end = yes then do:
     1014         glog = v-qh:get-first( p-lock) no-error .
     1015       end.
     1016     end.
     1017     else do:
     1018       glog = v-qh:get-first( p-lock) no-error .
     1019     end.
     1020     do v-ii = 1 to p-qh:num-buffers:
     1021       assign
     1022       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1023       no-error.
     1024     end.
     1025     delete object v-qh.
     1026     do v-ii = 1 to p-qh:num-buffers:
     1027       delete object v-bh[v-ii].
     1028     end.
     1029   end.
     1030   end procedure.
