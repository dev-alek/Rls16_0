     5191   PROCEDURE proc-b-print :
     5192   define variable date_string     as      char    no-undo.
     5193   define variable Line                as      char    no-undo.
     5194   define variable for-time as char.
     5195   define variable accum-count as integer.
     5196   define variable v-doc-rec as recid no-undo.
     5197   define variable v-subject-chr as character no-undo .
     5198   define variable v-upd-time as character no-undo .
     5199   define variable v-obj as character no-undo .
     5200   define variable v-action-chr as character no-undo .
     5201   define variable v-source-type as character no-undo .
     5202   DEFINE FRAME HistoryList
     5203   v-obj COLUMN-LABEL "Контрагент" FORMAT "X(12)"
     5204   v-action-chr FORMAT "X(10)" COLUMN-LABEL "Действие"
     5205   v-cli-name COLUMN-LABEL "Назв. контрагента" FORMAT "X(20)"
     5206   v-subject-chr COLUMN-LABEL "Предмет изменений" FORMAT "X(20)"
     5207   X_c-cli-hist.is-news COLUMn-LABEL "СПН" FORMAT "+/ "
     5208   v-source-type COLUMn-LABEL "Источн.!измен"
     5209   X_c-cli-hist.source-ref COLUMn-LABEL "№"
     5210   X_c-cli-hist.corr-date
     5211   v-upd-time COLUMN-LABEL "Время изм." FORMAT "X(8)"
     5212   X_c-cli-hist.corr-user-name
     5213   X_c-cli-hist.corr-user-db-num
     5214   X_c-cli-hist.host-code COLUMN-LABEL "Фирма"
     5215   HEADER  date_string AT 5 format "X(35)"
     5216   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     5217   Line format "X(195)" AT 1
     5218   with width 232 down stream-io use-text    .
     5219   Line = fill("-", 195).
     5220   date_string = cur-time-print() .
     5221   assign
     5222   v-doc-rec = recid( X_c-cli-hist ).
     5223   DO WHILE available X_c-cli-hist :
     5224         GET prev br-cli-hist.
     5225   END.
     5226   run prn-lib-open-stream  in this-procedure (
     5227                                                input parparentProc
     5228                                               ,input 43
     5229                                               ,input yes
     5230                                               ,input no
     5231                                               ).
     5232   PUT  STREAM PrnLibStream
     5233   SPACE(25) ( frame Dialog-Frame:title )
     5234   format "x(90)" SKIP(1) .
     5235   FORM HEADER
     5236   Line format "X(180)" AT 1 SKIP
     5237   "Продолжение - на следующей странице" AT 30 SKIP
     5238   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     5239   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     5240   FORM with FRAME HistoryList  .
     5241   run waitfram-show in this-procedure ("Ждите...").
     5242     GET next br-cli-hist.
     5243       DO WHILE available X_c-cli-hist :
     5244         Display STREAM PrnLibStream
     5245          X_c-cli-hist.obj-type + string(X_c-cli-hist.obj-code) @ v-obj
     5246         get-action(X_c-cli-hist.action) @ v-action-chr
     5247         (if v-find then get-cli(X_c-cli-hist.obj-type, X_c-cli-hist.obj-code) else "":U )
     5248         @ v-cli-name
     5249         get-subject(X_c-cli-hist.subject) @ v-subject-chr
     5250         X_c-cli-hist.is-news
     5251         get-source-type(X_c-cli-hist.source-type) @ v-source-type
     5252         X_c-cli-hist.source-ref
     5253         X_c-cli-hist.corr-date
     5254         string(X_c-cli-hist.corr-time, "HH:MM:SS":U) @ v-upd-time
     5255         X_c-cli-hist.corr-user-name
     5256         X_c-cli-hist.corr-user-db-num
     5257         X_c-cli-hist.host-code
     5258         with FRAME HistoryList .
     5259     DOWN STREAM PrnLibStream 1 with FRAME HistoryList  .
     5260     assign
     5261     accum-count = accum-count + 1
     5262     .
     5263     GET next br-cli-hist.
     5264   END.
     5265   UNDERLINE  STREAM PrnLibStream
     5266   v-obj
     5267   v-action-chr
     5268   v-cli-name
     5269   v-subject-chr
     5270   X_c-cli-hist.is-news
     5271   v-source-type
     5272   X_c-cli-hist.source-ref
     5273   X_c-cli-hist.corr-date
     5274   v-upd-time
     5275   X_c-cli-hist.corr-user-name
     5276   X_c-cli-hist.corr-user-db-num
     5277   X_c-cli-hist.host-code
     5278   with FRAME HistoryList .
     5279   DISPLAY STREAM PrnLibStream
     5280   "ИТОГО"  @ v-obj
     5281   string(accum-count)  @ v-action-chr
     5282   with frame HistoryList.
     5283   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     5284   HIDE  STREAM PrnLibStream FRAME CheckList.
     5285   output  STREAM PrnLibStream CLOSE.
     5286   run waitfram-hide in this-procedure.
     5287   run prn-lib-prn-file in this-procedure (
     5288                                             input parparentproc
     5289                                             ,input 8
     5290                                             ).
     5291   reposition br-cli-hist to recid v-doc-rec no-error.
     5292   apply "entry" to br-cli-hist in frame Dialog-Frame.
     5293   END PROCEDURE.
     5294   PROCEDURE proc-b-sch :
     5295   assign
     5296     tbl = 'c-cli-hist'
     5297     join-tbl = 'X_c-cli-hist'
     5298     fld = ""
     5299     lab = ""
     5300     spr = ""
     5301     dim = '0'
     5302     .
     5303   run fltfield-add in this-procedure('obj-type*obj-code', 'Контрагент', '',
     5304   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5305   run fltfield-add in this-procedure('host-code', '', '',
     5306   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5307   run fltfield-add in this-procedure('corr-date', '', '',
     5308   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5309   run fltfield-add in this-procedure('corr-time', 'Время корр.', 'time',
     5310   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5311   run fltfield-add in this-procedure('corr-user-db-num', '', '',
     5312   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5313   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     5314   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5315   run fltfield-add in this-procedure('subject', 'Предмет изменения', 'cli-hist-subject',
     5316   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5317   run fltfield-add in this-procedure('action', 'Действие', 'hist-action',
     5318   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5319   run fltfield-add in this-procedure('source-type', 'Источник_измен-я', 'hist-source-type',
     5320   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5321   run fltfield-add in this-procedure('source-ref', '', '',
     5322   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     5323   Filter-Block:
     5324   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     5325       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     5326       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     5327     run gbl/filter.w ( INPUT parparentproc
     5328                      , INPUT filter-point + chr(4) + filter-label
     5329                      , INPUT tbl
     5330                      , INPUT join-tbl
     5331                      , INPUT fld
     5332                      , INPUT lab
     5333                      , INPUT spr
     5334                      , INPUT dim ).
     5335     RUN OpenBr in this-procedure ( input yes, input no, input '':U, input v-corr-user-db-num).
     5336   END.
     5337   END PROCEDURE.
     5338   PROCEDURE proc-br-cli-hist :
     5339   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5340   if b-sel:sensitive in frame Dialog-Frame then dO:
     5341       if b-mark:sensitive then do:
     5342           apply "choose" to b-mark in frame Dialog-Frame.
     5343       end.
     5344       else do:
     5345           apply "choose" to b-sel in frame Dialog-Frame.
     5346       end.
     5347   end.
     5348   else do:
     5349       if b-lookup:sensitive then
     5350       apply "choose" to b-lookup in frame Dialog-Frame.
     5351   end.
     5352   END PROCEDURE.
     5353   PROCEDURE proc-find-corr-date :
     5354   define input parameter p-next as logical no-undo.
     5355   define input parameter p-date like ub.fin-doc.doc-date no-undo.
     5356   define variable v-date-chr as character no-undo.
     5357   if p-date = ? then return .
     5358   display
     5359   0 @ sch-cli-code
     5360   0 @ sch-db-num
     5361   "":U @ sch-corr-user-name
     5362   with frame Dialog-Frame.
     5363   assign
     5364   v-date-chr = string(day(p-date)) + chr(47) +
     5365                    string(month(p-date)) + chr(47) +
     5366                    string(year(p-date)).
     5367          run OpenBr in this-procedure
     5368           (input false
     5369           ,input true
     5370           ,input substitute("and X_c-cli-hist.corr-date = &1 "
     5371             , v-date-chr)
     5372           ,input v-corr-user-db-num
     5373           ).
     5374         apply "entry":u to sch-corr-date in frame Dialog-Frame.
     5375   END PROCEDURE.
     5376   PROCEDURE proc-find-db-num :
     5377   define input parameter p-next as logical no-undo.
     5378   define input parameter p-db-num like ub.c-cli-hist.corr-user-db-num no-undo.
     5379   define variable v-db-num as character no-undo.
     5380   assign
     5381   sch-corr-date = ?
     5382   .
     5383   display
     5384   "":U @ sch-corr-user-name
     5385   0 @ sch-cli-code
     5386   sch-corr-date
     5387   with frame Dialog-Frame.
     5388   assign
     5389   v-db-num = string(p-db-num).
     5390   run OpenBr in this-procedure
     5391       (input false
     5392       ,input p-next
     5393       ,input substitute("and X_c-cli-hist.corr-user-db-num = &1 "
     5394         , v-db-num)
     5395       ,input v-corr-user-db-num
     5396       ).
     5397   apply "entry":u to sch-db-num in frame Dialog-Frame .
     5398   END PROCEDURE.
     5399   PROCEDURE proc-find-obj-code :
     5400   define input parameter p-next as logical no-undo.
     5401   define input parameter p-obj-code like ub.c-cli-hist.obj-code no-undo.
     5402   define variable v-obj-code as character no-undo.
     5403   display
     5404   "":U @ sch-corr-user-name
     5405   with frame Dialog-Frame.
     5406   display
     5407   "":U @ sch-corr-user-name
     5408   0 @ sch-db-num
     5409   sch-corr-date
     5410   with frame Dialog-Frame.
     5411   assign
     5412   v-obj-code = string(p-obj-code).
     5413   run OpenBr in this-procedure
     5414       (input false
     5415       ,input p-next
     5416       ,input substitute("and X_c-cli-hist.obj-code = &1 "
     5417         , v-obj-code)
     5418       ,input v-corr-user-db-num
     5419       ).
     5420   apply "entry":u to sch-cli-code in frame Dialog-Frame .
     5421   END PROCEDURE.
     5422   PROCEDURE proc-find-user :
     5423   define input parameter p-next as logical no-undo.
     5424   define input parameter p-user like ub.c-cli-hist.corr-user-name no-undo.
     5425   assign
     5426   sch-corr-date = ?.
     5427   display
     5428   0 @ sch-db-num
     5429   sch-corr-date
     5430   0 @ sch-cli-code
     5431   with frame Dialog-Frame.
     5432   p-user = chr(34) + p-user + chr(34).
     5433   run OpenBr in this-procedure
     5434       (input false
     5435       ,input p-next
     5436       ,input substitute("and X_c-cli-hist.corr-user-name = &1 "
     5437         , p-user)
     5438       ,input v-corr-user-db-num
     5439       ).
     5440   apply "entry":u to sch-corr-user-name in frame Dialog-Frame .
     5441   END PROCEDURE.
     5442   PROCEDURE proc-view-changes :
     5443   define variable v-description as character no-undo .
     5444   RUN get-show-reason IN THIS-PROCEDURE.
     5445   for each temp-changes:
     5446       delete temp-changes.
     5447   END.
     5448   if not available X_c-cli-hist then do:
     5449     Open QUery br-changes for each temp-changes.
     5450     return.
     5451   end.
     5452   if v-show-reason = ? then do:
     5453   end.
     5454   run ref/cclihisv.p (
     5455                      input X_c-cli-hist.obj-type
     5456                     ,input X_c-cli-hist.obj-code
     5457                     ,input X_c-cli-hist.chip-num
     5458                     ,input X_c-cli-hist.corr-user-db-num
     5459                     ,input X_c-cli-hist.host-code
     5460                     ,input X_c-cli-hist.subject
     5461                     ,input X_c-cli-hist.action
     5462                     ,input no
     5463                     ,output v-description
     5464                  ) no-error .
     5465   Open QUery br-changes for each temp-changes.
     5466   assign
     5467   br-changes:title in frame Dialog-Frame = v-description
     5468   .
     5469   END PROCEDURE.
     5470   FUNCTION get-action RETURNS CHARACTER
     5471     ( p-action as integer ) :
     5472   define variable dops as character no-undo.
     5473   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     5474   RETURN dops.
     5475   END FUNCTION.
     5476   FUNCTION get-cli RETURNS CHARACTER
     5477     ( p-obj-type as character, p-obj-code as integer ) :
     5478   define buffer buf_clients for ub.clients.
     5479   find first buf_clients no-lock where
     5480             buf_clients.obj-type = p-obj-type
     5481         AND buf_clients.obj-code = p-obj-code
     5482         no-error.
     5483   if not available buf_clients then do:
     5484       return "!!! Неизвестный контрагент!!!".
     5485   end.
     5486     RETURN buf_clients.obj-name.
     5487   END FUNCTION.
     5488   FUNCTION get-source-type RETURNS CHARACTER
     5489     ( p-source-type as character ) :
     5490   define variable v-dop as character no-undo .
     5491   assign
     5492   v-dop = entry (lookup (p-source-type, ',db,esys,trn-doc,payment,fin-doc,import,recalc,wth-doc,ren-gdsc,upgrade,grp-chg,stop-list,dis-card':U), ',БД,ВС,Документ,Платеж,Фин.док.,Импорт,Пересчет,Документ МЦ,Коллизия,Апгрейд,Изм.группы,Стоплист,ДК':U)
     5493   no-error
     5494   .
     5495   RETURN v-dop.
     5496   END FUNCTION.
     5497   FUNCTION get-subject RETURNS CHARACTER
     5498     ( p-subject as character ) :
     5499     RETURN entry (lookup (p-subject, 'clients,clients-attr,thbj-attr,sysconf,firm,person,shop,store,staff,dis-thbj-rule,ext-classif':U), 'Клиент,Атрибут клиента,Параметры объекта TH,Своя фирма,Организация,Физ.лицо,Магазин,store,Персонал,Общие скидки,Внешний классификатор':U).
     5500   END FUNCTION.
