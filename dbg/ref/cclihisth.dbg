      619   procedure fltfield-clear :
      620     define output parameter loc-fld as character no-undo.
      621     define output parameter loc-lab as character no-undo .
      622     define output parameter loc-spr as character no-undo .
      623     define output parameter loc-dim as character no-undo .
      624     assign
      625       loc-fld = ""
      626       loc-lab = ""
      627       loc-spr = ""
      628       loc-dim = "0"
      629     .
      630   end procedure .
      631   procedure fltfield-add :
      632     define input        parameter par-fld as character no-undo.
      633     define input        parameter par-lab as character no-undo .
      634     define input        parameter par-spr as character no-undo .
      635     define input-output parameter loc-fld as character no-undo.
      636     define input-output parameter loc-lab as character no-undo .
      637     define input-output parameter loc-spr as character no-undo .
      638     define input-output parameter loc-dim as character no-undo .
      639     do
      640     on error undo, return error
      641     :
      642       assign
      643       loc-fld = if loc-dim = '0'
      644                 then par-fld
      645                 else (loc-fld + chr(44) + par-fld)
      646       loc-lab = if loc-dim = '0'
      647                 then par-lab
      648                 else (loc-lab + chr(44) + par-lab)
      649       loc-spr = if loc-dim = '0'
      650                 then par-spr
      651                 else (loc-spr + chr(44) + par-spr)
      652       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      653                 string(integer(if num-entries(loc-dim) > 1
      654                               then entry(2, loc-dim)
      655                               else entry(1, loc-dim)
      656                               ) + 1)
      657       no-error
      658       .
      659     end.
      660   end procedure.
