      120     run proc-alt-shift-f2.
      121   end.
      122   on alt-shift-f3 anywhere do:
      123     run proc-alt-shift-f3 in this-procedure .
      124   end.
      125   on alt-shift-f4 anywhere do:
      126     run proc-alt-shift-f4 in this-procedure.
      127   end.
      128   on alt-f1 anywhere do:
      129     run proc-alt-f1 in this-procedure .
      130   end.
      131   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      132   define variable c-point  as character no-undo .
      133   define variable tbl      as character no-undo .
      134   define variable join-tbl as character no-undo .
      135   define variable fld      as character no-undo .
      136   define variable lab      as character no-undo .
      137   define variable spr      as character no-undo .
      138   define variable dim      as character no-undo .
      139   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      140   procedure cur-time :
      141      define output parameter p-today as date      no-undo .
      142      define output parameter p-time  as integer   no-undo .
      143     do
      144     on error undo, return error
      145     :
      146       define variable v-date1 as date      no-undo .
      147       define variable v-date2 as date      no-undo .
      148       define variable v-time  as integer   no-undo .
      149       assign
      150         v-date1 = today
      151         v-time  = time
      152         v-date2 = today
      153       .
      154       if v-date1 <> v-date2
      155       then do:
      156         assign
      157           v-date1 = today
      158           v-time  = v-time
      159         .
      160       end.
      161       assign
      162         p-today = v-date1
      163         p-time  = v-time
      164       .
      165     end.
      166   end.
      167   function cur-time-date returns character
      168   :
      169     return string(today, '99/99/9999':U) .
      170   end.
      171   function cur-time-mjd returns decimal
      172   :
      173     define variable v-date as date      no-undo .
      174     define variable v-time as integer   no-undo .
      175     run cur-time in this-procedure
      176       (output v-date
      177       ,output v-time
      178       ) .
      179     return integer(v-date) - 2400002 + (v-time / 86400) .
      180   end.
      181   function cur-time-get-ending-index returns integer
      182   (input p-number as integer
      183   )
      184   :
      185     if p-number < 0
      186     or p-number = ?
      187     then do:
      188       return 1 .
      189     end.
      190     define variable v-rest as integer   no-undo .
      191     assign
      192       p-number = p-number modulo 100
      193     .
      194     if p-number < 20
      195     then do:
      196       assign
      197         v-rest = p-number
      198       .
      199     end.
      200     else do:
      201       assign
      202         v-rest = p-number modulo 10
      203       .
      204     end.
      205     case v-rest :
      206       when 1
      207       then do:
      208         return 2 .
      209       end.
      210       when 2 or
      211       when 3 or
      212       when 4
      213       then do:
      214         return 3 .
      215       end.
      216       otherwise do:
      217         return 1 .
      218       end.
      219     end case .
      220   end.
      221   procedure cur-time-mjd-to-date :
      222      define input  parameter i-mjd-diff as decimal no-undo.
      223      define output parameter o-Date     as date    no-undo.
      224      define output parameter o-Time     as integer no-undo.
      225      define variable v-day-number as integer   no-undo .
      226      if    i-mjd-diff < 0
      227         or i-mjd-diff = ?
      228      then do:
      229         return "?" .
      230      end.
      231      assign
      232         v-day-number = truncate(i-mjd-diff,0).
      233         o-Date = date(v-day-number + 2400002).
      234         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      235     .
      236   end.
      237   function cur-time-mjd-to-string returns character
      238   (input p-mjd-diff as decimal
      239   )
      240   :
      241     define variable v-day-number as integer   no-undo .
      242     define variable v-seconds    as integer   no-undo .
      243     define variable v-hour       as integer   no-undo .
      244     define variable v-min        as integer   no-undo .
      245     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      246     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      247     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      248     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      249     if p-mjd-diff < 0
      250     or p-mjd-diff = ?
      251     then do:
      252       return "?" .
      253     end.
      254     assign
      255       v-day-number = integer(truncate(p-mjd-diff,0))
      256       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      257     .
      258     if v-seconds > 86400
      259     then do:
      260       assign
      261         v-seconds = 86400 - 1
      262       .
      263     end.
      264     if v-seconds < 0
      265     then do:
      266       assign
      267         v-seconds = 0
      268       .
      269     end.
      270     assign
      271       v-hour = truncate(v-seconds / 3600, 0)
      272     .
      273     assign
      274       v-seconds = v-seconds modulo 3600
      275     .
      276     assign
      277       v-min = truncate(v-seconds / 60, 0)
      278     .
      279     assign
      280       v-seconds = v-seconds modulo 60
      281     .
      282     return
      283         (if v-day-number <> 0
      284           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      285           else ""
      286         )
      287       + (if v-day-number <> 0 or v-hour <> 0
      288           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      289           else ""
      290         )
      291       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      292           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      293           else ""
      294         )
      295       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      296       .
      297   end.
      298   function cur-time-string returns character
      299   :
      300     define variable v-date as date      no-undo .
      301     define variable v-time as integer   no-undo .
      302     run cur-time in this-procedure
      303       (output v-date
      304       ,output v-time
      305       ) .
      306     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      307   end.
      308   function cur-time-string-sec returns character
      309   :
      310     define variable v-date as date      no-undo .
      311     define variable v-time as integer   no-undo .
      312     run cur-time in this-procedure
      313       (output v-date
      314       ,output v-time
      315       ) .
      316     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      317   end.
      318   function cur-time-custom  returns character
      319   (input p-prefix as character
      320   ,input p-date-format as character
      321   ,input p-delimiter as character
      322   ,input p-time-format as character
      323   ,input p-suffix as character
      324   )
      325   :
      326     define variable v-date as date      no-undo .
      327     define variable v-time as integer   no-undo .
      328     run cur-time in this-procedure
      329       (output v-date
      330       ,output v-time
      331       ) .
      332     return
      333       p-prefix
      334       + string(v-date, p-date-format)
      335       + p-delimiter
      336       + string(v-time, p-time-format)
      337       + p-suffix
      338       .
      339   end.
      340   function cur-time-print  returns character
      341   :
      342     define variable v-date as date      no-undo .
      343     define variable v-time as integer   no-undo .
      344     run cur-time in this-procedure
      345       (output v-date
      346       ,output v-time
      347       ) .
      348     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      349   end.
      350   function cur-time-datetime returns datetime
      351   :
      352     define variable v-char as character no-undo .
      353     define variable v-datetime as datetime no-undo .
      354     v-char = cur-time-string().
      355     v-datetime = datetime(v-char).
      356     return  v-datetime.
      357   end.
      358   function cur-time-string-msec returns character
      359   :
      360     define variable v-date as datetime  no-undo .
      361     v-date = now.
      362     return string(v-date) .
      363   end.
      364   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      365   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      366   define new shared variable RepPathName        as character no-undo .
      367   define new shared variable PrintRubl          as logical   no-undo .
      368   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      369   define variable v-waitfram-action01         as character   no-undo .
      370   define variable v-waitfram-action02         as character   no-undo .
      371   define variable v-waitfram-action03         as character   no-undo .
      372   define variable mWaitFramTextBeg            as character   no-undo.
      373   define variable mWaitFramTextEnd            as character   no-undo.
      374   define variable mWaitFramView               as logical     no-undo.
      375   define variable mWaitProcEvent              as logical     no-undo init yes.
      376   define variable mWaitFramInterval           as integer     no-undo init 1 .
      377   define variable mWaitFramStop               as logical     no-undo.
      378   define variable mWaitFramStopUser           as logical     no-undo.
      379   define variable mWaitFramStopTimeOut        as logical     no-undo.
      380   define variable mWaitFramStartProc          as datetime-tz no-undo.
      381   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      382   define button B-WaitFramStop auto-end-key
      383        label "Стоп"
      384        size 10 by 1 tooltip "Остоновить процесс".
      385   define button B-viewProcInfo
      386        label "Информация"
      387        size 15 by 1 tooltip "Информация о процесс".
      388   define frame waitfram
      389     v-waitfram-action01 format "x(72)" no-label skip
      390     v-waitfram-action02 format "x(72)" no-label skip
      391     v-waitfram-action03 format "x(72)" no-label skip
      392     B-viewProcInfo
      393     B-WaitFramStop at row 4 col 30
      394     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      395     .
      396   define new global shared variable mBatchMode as logical no-undo init ?.
      397   define variable mFramBachModHandle as handle no-undo.
      398   mFramBachModHandle = frame waitfram:handle.
      399   define variable mFameOldVis as logical no-undo.
      400   define variable mVisCUrentVin as logical no-undo.
      401   if session:batch-mode
      402   then
      403      mBatchMode = yes.
      404   if mBatchMode = ? then do:
      405     mVisCUrentVin = current-window:visible.
      406     mFameOldVis = mFramBachModHandle:visible.
      407     mFramBachModHandle:visible  = yes.
      408     mBatchMode = mFramBachModHandle:visible ne yes.
      409     mFramBachModHandle:visible = mFameOldVis.
      410     current-window:visible = mVisCUrentVin.
      411   end.
      412    if  log-manager:logfile-name ne ?
      413     then DO:
      414         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      415         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      416         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      417     end.
      418   on choose of B-WaitFramStop in frame waitfram
      419   do:
      420     mWaitFramStop = yes.
      421     mWaitFramStopUser = yes.
      422   end.
      423   function waitfram-check-timeout returns logical():
      424      define variable vtime as int64 no-undo.
      425      if mWaitFramStopTimeOut
      426      then
      427         return yes.
      428      vtime = ( now - mWaitFramStartProc ) / 1000 .
      429      if     mWaitFramTimeOut ne ?
      430         and mWaitFramTimeOut ne 0
      431         and mWaitFramTimeOut lt vtime
      432      then do:
      433         mWaitFramStopTimeOut = yes.
      434      end.
      435      return mWaitFramStopTimeOut.
      436   end.
      437   procedure waitfram-hide :
      438     if not session:batch-mode
      439     then do
      440     on error undo, return error return-value
      441     :
      442       pause 0 before-hide .
      443       if not mBatchMode then
      444         hide frame waitfram .
      445     if     not mWaitFramView
      446        and mWaitProcEvent
      447     then
      448       process events .
      449     end.
      450   end procedure.
      451   procedure waitfram-show :
      452     define input  parameter p-message as character no-undo .
      453     define variable v-left-margin as integer   no-undo .
      454     if not session:batch-mode
      455     then do
      456     on error undo, return error return-value
      457     :
      458       if length(p-message) <= 70 then do:
      459         assign
      460           v-left-margin = integer((70 - length(p-message)) / 2)
      461         .
      462         assign
      463           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      464         .
      465         assign
      466           v-waitfram-action01 = " "
      467           v-waitfram-action02 = " "
      468                                    + fill(" ", v-left-margin)
      469                                    + p-message
      470           v-waitfram-action03 = " "
      471         .
      472       end.
      473       else do:
      474         define variable vRindex1 as integer no-undo.
      475         define variable vRindex2 as integer no-undo.
      476         vRindex1 = r-index(p-message," ",70).
      477         if vRindex1 = 0
      478         then
      479            vRindex1 = 70.
      480         if length(p-message)  <= vRindex1 + 70 then do:
      481           assign
      482             v-waitfram-action01 = " "
      483             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      484             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      485           .
      486         end.
      487         else do:
      488           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      489           if vRindex2 <= vRindex1
      490           then
      491              vRindex2 = vRindex1 + 70.
      492           assign
      493             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      494             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      495             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      496           .
      497         end.
      498       end.
      499       B-viewProcInfo:visible   in frame waitfram = no.
      500       B-viewProcInfo:sensitive in frame waitfram = no.
      501       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      502       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      503       if  (   mWaitFramView
      504          or  mWaitProcEvent)
      505          and not mBatchMode
      506       then
      507          display
      508             v-waitfram-action01 skip
      509             v-waitfram-action02 skip
      510             v-waitfram-action03 skip
      511          with frame waitfram .
      512       if     mWaitFramView
      513          then do:
      514             if     mWaitFramInterval ne ?
      515                and not mBatchMode
      516             then
      517                wait-for go of frame waitfram pause mWaitFramInterval.
      518          end.
      519          else
      520             if     mWaitProcEvent
      521                and not mBatchMode
      522             then
      523                process events .
      524     end.
      525   end procedure.
      526      procedure waitfram-show-this:
      527         define input  parameter iInterval as int64 no-undo.
      528         define variable vtime as int64 no-undo.
      529         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      530         mWaitFramInterval = iInterval.
      531         run waitfram-show (substitute("&1&2 &3&4" ,
      532                                       mWaitFramTextBeg ,
      533                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      534                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      535                                       mWaitFramTextEnd
      536                                      )
      537                           ).
      538      end.
      539      procedure WaitFramRunPause:
      540         define input  parameter iInterval as dec no-undo.
      541         define variable vStart  as datetime-tz no-undo.
      542         define variable vend    as datetime-tz no-undo.
      543         define variable vint as int64 no-undo.
      544         define variable vOk as logical no-undo.
      545         vStart = now.
      546         vend   = vStart.
      547         publish "WaitFramPause" (iInterval,output vOk).
      548         vend   =  now.
      549         vint = vend - vStart.
      550         vint = iInterval - vint / 1000.
      551         if     not mWaitFramStop
      552            and (   vint > 0
      553                 or (    not vOk
      554                     and iInterval eq ?
      555                     )
      556                 )
      557         then
      558            run waitfram-show-this (iInterval).
      559         vend   =  now.
      560         vint = vend - vStart.
      561         vint = iInterval - vint / 1000.
      562         if     not mWaitFramStop
      563            and vint > 0
      564         then do:
      565            run gbl/pause.p (vint * 1000).
      566         end.
      567         if iInterval ne ?
      568         then
      569            publish "WaitFramStop".
      570         waitfram-check-timeout().
      571      end.
      572      procedure WaitFramWaitFor:
      573         define input  parameter iInterval as dec no-undo.
      574         assign
      575            mWaitFramStartProc   = now
      576            mWaitFramStopUser    = no
      577            mWaitFramStopTimeOut = no
      578         .
      579         block-wait:
      580         do while not mWaitFramStop:
      581            run WaitFramRunPause (iInterval).
      582            if  waitfram-check-timeout()
      583            then do:
      584               leave block-wait.
      585            end.
      586         end.
      587         run waitfram-hide.
      588      end.
      589   procedure waitfram-join :
      590     define input  parameter p-line-1  as character no-undo .
      591     define input  parameter p-line-2  as character no-undo .
      592     define input  parameter p-line-3  as character no-undo .
      593     define output parameter p-message as character no-undo .
      594     do
      595     on error undo, return error return-value
      596     :
      597       assign
      598         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      599                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      600                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      601       .
      602     end.
      603   end procedure.
      604   function waitfram-join-function returns character
      605     (input p-line-1 as character
      606     ,input p-line-2 as character
      607     ,input p-line-3 as character
      608     ).
      609     define variable v-message as character no-undo .
      610     run waitfram-join in this-procedure
      611       (input  p-line-1
      612       ,input  p-line-2
      613       ,input  p-line-3
      614       ,output v-message
      615       ) .
      616     return v-message .
      617   end function .
