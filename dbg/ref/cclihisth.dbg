     1638      run proc-find-corr-date in this-procedure(yes, input frame Dialog-Frame sch-corr-date) no-error.
     1639     if error-status:error then return no-apply.
     1640   END.
     1641   ON RETURN OF sch-corr-date IN FRAME Dialog-Frame
     1642   DO:
     1643     run proc-find-corr-date in this-procedure(no, input frame Dialog-Frame sch-corr-date) no-error.
     1644     if error-status:error then return no-apply.
     1645   END.
     1646   ON CTRL-J OF sch-corr-user-name IN FRAME Dialog-Frame
     1647   DO:
     1648     run proc-find-user in this-procedure(yes, input frame Dialog-Frame sch-corr-user-name) no-error.
     1649     if error-status:error then return no-apply.
     1650   END.
     1651   ON RETURN OF sch-corr-user-name IN FRAME Dialog-Frame
     1652   DO:
     1653     run proc-find-user in this-procedure(no, input frame Dialog-Frame sch-corr-user-name) no-error.
     1654     if error-status:error then return no-apply.
     1655   END.
     1656   ON CTRL-J OF sch-db-num IN FRAME Dialog-Frame
     1657   DO:
     1658     run proc-find-db-num in this-procedure(yes, input frame Dialog-Frame sch-db-num) no-error.
     1659     if error-status:error then return no-apply.
     1660   END.
     1661   ON RETURN OF sch-db-num IN FRAME Dialog-Frame
     1662   DO:
     1663     run proc-find-db-num in this-procedure(no, input frame Dialog-Frame sch-db-num) no-error.
     1664     if error-status:error then return no-apply.
     1665   END.
     1666   ON RETURN OF v-corr-user-db-num IN FRAME Dialog-Frame
     1667   DO:
     1668     assign
     1669     v-corr-user-db-num
     1670     .
     1671     RUn OpenBR(yes, no, '':U, v-corr-user-db-num).
     1672   END.
     1673   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1674   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1675   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1676   on help of frame Dialog-Frame
     1677   do:
     1678     run gbl/app_help.p
     1679       (input this-procedure :file-name
     1680       ,input ''
     1681       ,input ?
     1682       ) no-error.
     1683     if error-status :error then do:
     1684       message
     1685         "Ошибка при вызове помощи"
     1686         error-status :get-message(1)
     1687         view-as alert-box .
     1688     end.
     1689   end.
     1690   run minbtn-set in this-procedure .
     1691   on choose of b-help in frame Dialog-Frame
     1692   do:
     1693     apply "help":u to frame Dialog-Frame .
     1694   end.
     1695   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1696   procedure minbtn-set :
     1697       do
     1698           on error undo, return error return-value
     1699           :
     1700           define variable ii              as integer       no-undo .
     1701           define variable fh              as widget-handle no-undo .
     1702           define variable hh              as widget-handle no-undo .
     1703           define variable v-h             as handle        extent 4 no-undo .
     1704           define variable v-name-button   as character     no-undo .
     1705           define variable v-help-old-x    as decimal       no-undo .
     1706           define variable v-help-old-y    as decimal       no-undo .
     1707           define variable v-help-old-size as decimal       no-undo .
     1708           define variable v-frame-width   as decimal       no-undo .
     1709           define variable jj              as integer       no-undo .
     1710           do
     1711               on error undo, return error
     1712               :
     1713               assign
     1714                   v-frame-width = frame Dialog-Frame:width - 0.3
     1715                   fh            = frame Dialog-Frame:first-child
     1716                   hh            = fh:first-child
     1717                   ii            = 1
     1718                   .
     1719               do while valid-handle(hh):
     1720                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1721                   do:
     1722                       case lc(hh:name) :
     1723                           when "b-help" then
     1724                               do:
     1725                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1726                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1727                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1728                                   hh:TOOLTIP = "Помощь" .
     1729                                   v-help-old-x = hh:column .
     1730                                   v-help-old-y = hh:row    .
     1731                                   v-help-old-size = hh:width .
     1732                                   hh:width-chars = 2.5 .
     1733                               end.
     1734                           when "b-print" then
     1735                               do:
     1736                                   hh:load-image("cmp/b-print.bmp":u) .
     1737                                   hh:TOOLTIP = "Печать" .
     1738                                   v-h[ii] = hh:handle .
     1739                                   ii = ii + 1 .
     1740                                   hh:width-chars = 3 .
     1741                               end.
     1742                           when "b-history" or
     1743                           when "b-hist" then
     1744                               do:
     1745                                   hh:load-image("cmp/b-hist.bmp":u) .
     1746                                   hh:TOOLTIP = "История" .
     1747                                   v-h[ii] = hh:handle .
     1748                                   ii = ii + 1 .
     1749                                   hh:width-chars = 3 .
     1750                               end.
     1751                           when "b-sch" then
     1752                               do:
     1753                                   hh:load-image("cmp/b-sch.bmp":u) .
     1754                                   hh:TOOLTIP = "Установка Фильтра" .
     1755                                   v-h[ii] = hh:handle .
     1756                                   ii = ii + 1 .
     1757                                   hh:width-chars = 3 .
     1758                               end.
     1759                           when "b-hist-user" then
     1760                               do:
     1761                                   hh:load-image("cmp/b-hist.bmp":u) .
     1762                                   hh:TOOLTIP = "История пользователя" .
     1763                                   ii = ii + 1 .
     1764                               end.
     1765                       end case.
     1766                   end.
     1767                   hh = hh:next-sibling.
     1768               end.
     1769               b-help:column = v-frame-width - b-help:width-chars.
     1770               jj = 0.
     1771               repeat ii = 4 to 1 by -1 :
     1772                   if valid-handle (v-h[ii] ) then
     1773                   do:
     1774                       jj  = jj + 1 .
     1775                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1776                       v-h[ii]:row    = v-help-old-y .
     1777                   end.
     1778               end.
     1779           end.
     1780       end.
     1781   end procedure.
     1782   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1783   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1784   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1785   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1786   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1787   define variable v-diasize-current-frame-height as decimal   no-undo .
     1788   define variable v-diasize-change-size          as logical   no-undo .
     1789   define variable v-diasize-resize-button        as handle    no-undo .
     1790   define variable v-diasize-wndmax               as logical   no-undo .
     1791   define variable v-diasize-wndstore             as logical   no-undo .
     1792   define variable v-diasize-proc-name            as character no-undo .
     1793   define variable v-diasize-browse-handle        as handle    no-undo .
     1794   define variable v-diasize-browse-number        as integer   no-undo .
     1795   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1796   define temp-table temp-diasize-handle no-undo
     1797     field handle-value  as handle
     1798     field save-position as decimal
     1799     index xpk is primary unique handle-value
     1800     .
     1801   define temp-table temp-browse-handle no-undo
     1802     field browse-type   as character
     1803     field browse-number as integer
     1804     field browse-handle as handle
     1805     field original-size as decimal
     1806     index xpk is primary unique browse-type browse-number
     1807     index xie browse-type browse-handle
     1808   .
     1809   procedure diasize_change-height :
     1810     define input  parameter p-change-value  as decimal   no-undo .
     1811     define input  parameter p-move-resize   as logical   no-undo .
     1812     define variable v-field-group-handle    as handle    no-undo .
     1813     define variable v-object-handle         as handle    no-undo .
     1814     define variable v-frame-height          as decimal   no-undo .
     1815     define variable v-frame-virtual-height  as decimal   no-undo .
     1816     define variable v-browse-height         as decimal   no-undo .
     1817     define variable v-window-height         as decimal   no-undo .
     1818     define variable v-window-virtual-height as decimal   no-undo .
     1819     define variable v-change-sign           as integer   no-undo .
     1820     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1821     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1822     if p-change-value > 0
     1823     then do:
     1824       if frame Dialog-Frame :height + p-change-value
     1825           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1826       then do:
     1827         assign
     1828           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1829                           - (frame Dialog-Frame :height-chars)
     1830         .
     1831         if p-change-value <= 0
     1832         then do:
     1833           run diasize_position-resize-button in this-procedure .
     1834           return .
     1835         end.
     1836       end.
     1837     end.
     1838     if p-change-value < 0
     1839     then do:
     1840       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1841       then do:
     1842         assign
     1843           p-change-value = v-diasize-orig-frame-height
     1844                          - (frame Dialog-Frame :height-chars)
     1845         .
     1846         if p-change-value >= 0
     1847         then do:
     1848           run diasize_position-resize-button in this-procedure .
     1849           return .
     1850         end.
     1851       end.
     1852     end.
     1853     if p-change-value >= 0
     1854     then do:
     1855       assign
     1856         v-change-sign = 1
     1857       .
     1858     end.
     1859     else do:
     1860       assign
     1861         v-change-sign = -1
     1862       .
     1863     end.
     1864     assign
     1865       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1866     .
     1867     if p-change-value = 0
     1868     then do:
     1869       run diasize_position-resize-button in this-procedure .
     1870       return .
     1871     end.
     1872     move_block:
     1873     do
     1874     on error undo move_block, retry move_block
     1875     :
     1876       if retry
     1877       then do:
     1878         do
     1879         on error undo move_block, leave move_block
     1880         :
     1881           if p-change-value > 0
     1882           then do:
     1883             for each buf_temp-diasize-handle
     1884             on error undo, next
     1885             :
     1886               assign
     1887                 v-object-handle = buf_temp-diasize-handle.handle-value
     1888               .
     1889               if v-object-handle <> v-diasize-resize-button
     1890               then do:
     1891                 assign
     1892                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1893                 .
     1894               end.
     1895             end.
     1896             assign
     1897               v-diasize-browse-handle :height = v-browse-height
     1898             .
     1899             for each buf_temp-browse-handle
     1900               where buf_temp-browse-handle.browse-type = 'height':u
     1901             on error undo, next
     1902             :
     1903               assign
     1904                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1905               .
     1906             end.
     1907             assign
     1908               frame Dialog-Frame :height = v-frame-height
     1909             .
     1910             if frame Dialog-Frame :scrollable = true
     1911             then do:
     1912               assign
     1913                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1914               .
     1915             end.
     1916             run diasize_position-resize-button in this-procedure .
     1917           end.
     1918           else do:
     1919             if frame Dialog-Frame :scrollable = true
     1920             then do:
     1921               assign
     1922                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1923               .
     1924             end.
     1925             assign
     1926               frame Dialog-Frame :height = v-frame-height
     1927             .
     1928             assign
     1929               v-diasize-browse-handle :height = v-browse-height
     1930             .
     1931             for each buf_temp-browse-handle
     1932               where buf_temp-browse-handle.browse-type = 'height':u
     1933             on error undo, next
     1934             :
     1935               assign
     1936                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1937               .
     1938             end.
     1939             for each buf_temp-diasize-handle
     1940             on error undo, next
     1941             :
     1942               assign
     1943                 v-object-handle = buf_temp-diasize-handle.handle-value
     1944               .
     1945               if v-object-handle <> v-diasize-resize-button
     1946               then do:
     1947                 assign
     1948                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1949                 .
     1950               end.
     1951             end.
     1952             run diasize_position-resize-button in this-procedure .
     1953           end.
     1954           assign
     1955             v-diasize-change-size = false
     1956           .
     1957           leave move_block .
     1958         end.
     1959       end.
     1960       assign
     1961         v-diasize-need-full-display = true
     1962       .
     1963       if v-diasize-change-size = false
     1964       then do:
     1965         assign
     1966           v-diasize-change-size = true
     1967         .
     1968       end.
     1969       else do:
     1970         return .
     1971       end.
     1972       assign
     1973         v-frame-height = frame Dialog-Frame :height
     1974         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1975         v-browse-height = v-diasize-browse-handle :height
     1976       .
     1977       for each buf_temp-browse-handle
     1978         where buf_temp-browse-handle.browse-type = 'height':u
     1979       :
     1980         assign
     1981           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1982         .
     1983       end.
     1984       for each buf_temp-diasize-handle
     1985       :
     1986         delete buf_temp-diasize-handle .
     1987       end.
     1988       assign
     1989         v-field-group-handle = frame Dialog-Frame :first-child
     1990       .
     1991       do while valid-handle(v-field-group-handle)
     1992       :
     1993         assign
     1994           v-object-handle = v-field-group-handle :first-child
     1995         .
     1996         do while valid-handle(v-object-handle)
     1997         :
     1998           if  v-object-handle <> v-diasize-browse-handle :handle
     1999           and can-query(v-object-handle, "row")
     2000           and can-query(v-object-handle, "height")
     2001           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2002           then do:
     2003             find first buf_temp-browse-handle
     2004               where buf_temp-browse-handle.browse-type   = 'height':u
     2005                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2006               no-error .
     2007             if available buf_temp-browse-handle
     2008             then do:
     2009             end.
     2010             else do:
     2011               create buf_temp-diasize-handle .
     2012               assign
     2013                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2014                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2015               .
     2016             end.
     2017           end.
     2018           assign
     2019             v-object-handle = v-object-handle :next-sibling
     2020           .
     2021         end.
     2022         assign
     2023           v-field-group-handle = v-field-group-handle :next-sibling
     2024         .
     2025       end.
     2026       do with frame Dialog-Frame
     2027       :
     2028         hide v-diasize-resize-button .
     2029         assign
     2030           v-diasize-resize-button :row    = 1
     2031           v-diasize-resize-button :column = 1
     2032         .
     2033       end.
     2034       if p-change-value > 0
     2035       then do:
     2036         if frame Dialog-Frame :scrollable = true
     2037         then do:
     2038           assign
     2039             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2040             no-error .
     2041           if error-status :error
     2042           or error-status :get-message(1) <> ""
     2043           then do:
     2044             undo move_block, retry move_block .
     2045           end.
     2046         end.
     2047         assign
     2048           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2049           no-error .
     2050         if error-status :error
     2051         or error-status :get-message(1) <> ""
     2052         then do:
     2053           undo move_block, retry move_block .
     2054         end.
     2055         assign
     2056           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2057           no-error .
     2058         if error-status :error
     2059         or error-status :get-message(1) <> ""
     2060         then do:
     2061           undo move_block, retry move_block .
     2062         end.
     2063         for each buf_temp-browse-handle
     2064           where buf_temp-browse-handle.browse-type = 'height':u
     2065         on error undo move_block, retry move_block
     2066         :
     2067           assign
     2068             buf_temp-browse-handle.browse-handle :height
     2069               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2070             no-error .
     2071           if error-status :error
     2072           or error-status :get-message(1) <> ""
     2073           then do:
     2074             undo move_block, retry move_block .
     2075           end.
     2076         end.
     2077         for each buf_temp-diasize-handle
     2078         on error undo move_block, retry move_block
     2079         :
     2080           assign
     2081             v-object-handle = buf_temp-diasize-handle.handle-value
     2082           .
     2083           if v-object-handle <> v-diasize-resize-button
     2084           then do:
     2085             assign
     2086               v-object-handle :row = v-object-handle :row + p-change-value
     2087               no-error .
     2088             if error-status :error
     2089             or error-status :get-message(1) <> ""
     2090             then do:
     2091               undo move_block, retry move_block .
     2092             end.
     2093           end.
     2094         end.
     2095       end.
     2096       else do:
     2097         for each buf_temp-diasize-handle
     2098         on error undo move_block, retry move_block
     2099         :
     2100           assign
     2101             v-object-handle = buf_temp-diasize-handle.handle-value
     2102           .
     2103           if v-object-handle <> v-diasize-resize-button
     2104           then do:
     2105             assign
     2106               v-object-handle :row = v-object-handle :row + p-change-value
     2107               no-error .
     2108             if error-status :error
     2109             or error-status :get-message(1) <> ""
     2110             then do:
     2111               undo move_block, retry move_block .
     2112             end.
     2113           end.
     2114         end.
     2115         assign
     2116           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2117           no-error .
     2118         if error-status :error
     2119         or error-status :get-message(1) <> ""
     2120         then do:
     2121           undo move_block, retry move_block .
     2122         end.
     2123         for each buf_temp-browse-handle
     2124           where buf_temp-browse-handle.browse-type = 'height':u
     2125         on error undo move_block, retry move_block
     2126         :
     2127           assign
     2128             buf_temp-browse-handle.browse-handle :height
     2129               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2130             no-error .
     2131           if error-status :error
     2132           or error-status :get-message(1) <> ""
     2133           then do:
     2134             undo move_block, retry move_block .
     2135           end.
     2136         end.
     2137         assign
     2138           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2139           no-error .
     2140         if error-status :error
     2141         or error-status :get-message(1) <> ""
     2142         then do:
     2143           undo move_block, retry move_block .
     2144         end.
     2145         if frame Dialog-Frame :scrollable = true
     2146         then do:
     2147           assign
     2148             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2149             no-error .
     2150           if error-status :error
     2151           or error-status :get-message(1) <> ""
     2152           then do:
     2153             undo move_block, retry move_block .
     2154           end.
     2155         end.
     2156       end.
     2157       if p-move-resize = true
     2158       then do:
     2159         run diasize_position-resize-button in this-procedure .
     2160       end.
     2161       if v-diasize-wndstore = true
     2162       then do:
     2163         if connected("ub") = true
     2164         then do:
     2165           define variable v-cntxt-db-num        as integer   no-undo .
     2166           define variable v-cntxt-userid        as character no-undo .
     2167           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2168                                             , OUTPUT v-cntxt-userid
     2169                                             ) .
     2170           run gbl/wndsizew.p
     2171             (input  v-cntxt-db-num
     2172             ,input  v-cntxt-userid
     2173             ,input  v-diasize-proc-name
     2174             ,input  'height':u
     2175             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2176             ) .
     2177         end.
     2178       end.
     2179     end.
     2180     assign
     2181       v-diasize-change-size = false
     2182     .
     2183   end procedure.
     2184   procedure diasize_set-height :
     2185     define input  parameter p-new-height  as decimal   no-undo .
     2186     define input  parameter p-move-resize as logical   no-undo .
     2187     do
     2188     on error undo, return error return-value
     2189     :
     2190       run diasize_change-height in this-procedure
     2191         (input  (p-new-height - frame Dialog-Frame :height)
     2192         ,input  p-move-resize
     2193         ) .
     2194     end.
     2195   end procedure.
     2196   procedure diasize_change-width :
     2197     define input  parameter p-change-value as decimal   no-undo .
     2198     define input  parameter p-move-resize  as logical   no-undo .
     2199     define variable v-field-group-handle   as handle    no-undo .
     2200     define variable v-object-handle        as handle    no-undo .
     2201     define variable v-frame-width          as decimal   no-undo .
     2202     define variable v-frame-virtual-width  as decimal   no-undo .
     2203     define variable v-browse-width         as decimal   no-undo .
     2204     define variable v-window-width         as decimal   no-undo .
     2205     define variable v-window-virtual-width as decimal   no-undo .
     2206     define variable v-change-sign          as integer   no-undo .
     2207     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2208     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2209     if p-change-value > 0
     2210     then do:
     2211       if frame Dialog-Frame :width + p-change-value >
     2212           session :width-chars
     2213       then do:
     2214         assign
     2215           p-change-value = session :width-chars - frame Dialog-Frame :width
     2216         .
     2217         if p-change-value <= 0
     2218         then do:
     2219           run diasize_position-resize-button in this-procedure .
     2220           return .
     2221         end.
     2222       end.
     2223     end.
     2224     if p-change-value < 0
     2225     then do:
     2226       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2227       then do:
     2228         assign
     2229           p-change-value = v-diasize-orig-frame-width
     2230                          - frame Dialog-Frame :width
     2231         .
     2232         if p-change-value >= 0
     2233         then do:
     2234           run diasize_position-resize-button in this-procedure .
     2235           return .
     2236         end.
     2237       end.
     2238     end.
     2239     if p-change-value >= 0
     2240     then do:
     2241       assign
     2242         v-change-sign = 1
     2243       .
     2244     end.
     2245     else do:
     2246       assign
     2247         v-change-sign = -1
     2248       .
     2249     end.
     2250     assign
     2251       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2252     .
     2253     if p-change-value = 0
     2254     then do:
     2255       run diasize_position-resize-button in this-procedure .
     2256       return .
     2257     end.
     2258     move_block:
     2259     do
     2260     on error undo move_block, leave move_block
     2261     :
     2262       if retry
     2263       then do:
     2264         do
     2265         on error undo move_block, leave move_block
     2266         :
     2267           if p-change-value > 0
     2268           then do:
     2269             for each buf_temp-diasize-handle
     2270             on error undo, next
     2271             :
     2272               assign
     2273                 v-object-handle = buf_temp-diasize-handle.handle-value
     2274               .
     2275               if v-object-handle <> v-diasize-resize-button
     2276               then do:
     2277                 assign
     2278                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2279                 .
     2280               end.
     2281             end.
     2282             assign
     2283               v-diasize-browse-handle :width = v-browse-width
     2284             .
     2285             for each buf_temp-browse-handle
     2286               where buf_temp-browse-handle.browse-type = 'width':u
     2287             on error undo, next
     2288             :
     2289               assign
     2290                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2291               .
     2292             end.
     2293             assign
     2294               frame Dialog-Frame :width = v-frame-width
     2295             .
     2296             if frame Dialog-Frame :scrollable = true
     2297             then do:
     2298               assign
     2299                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2300               .
     2301             end.
     2302             run diasize_position-resize-button in this-procedure .
     2303           end.
     2304           else do:
     2305             if frame Dialog-Frame :scrollable = true
     2306             then do:
     2307               assign
     2308                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2309               .
     2310             end.
     2311             assign
     2312               frame Dialog-Frame :width = v-frame-width
     2313             .
     2314             for each buf_temp-browse-handle
     2315               where buf_temp-browse-handle.browse-type = 'width':u
     2316             on error undo, next
     2317             :
     2318               assign
     2319                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2320               .
     2321             end.
     2322             assign
     2323               v-diasize-browse-handle :width = v-browse-width
     2324             .
     2325             for each buf_temp-diasize-handle
     2326             on error undo, next
     2327             :
     2328               assign
     2329                 v-object-handle = buf_temp-diasize-handle.handle-value
     2330               .
     2331               if v-object-handle <> v-diasize-resize-button
     2332               then do:
     2333                 assign
     2334                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2335                 .
     2336               end.
     2337             end.
     2338             run diasize_position-resize-button in this-procedure .
     2339           end.
     2340           assign
     2341             v-diasize-change-size = false
     2342           .
     2343           leave move_block .
     2344         end.
     2345       end.
     2346       assign
     2347         v-diasize-need-full-display = true
     2348       .
     2349       if v-diasize-change-size = false
     2350       then do:
     2351         assign
     2352           v-diasize-change-size = true
     2353         .
     2354       end.
     2355       else do:
     2356         return .
     2357       end.
     2358       assign
     2359         v-frame-width = frame Dialog-Frame :width
     2360         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2361         v-browse-width = v-diasize-browse-handle :width
     2362       .
     2363       for each buf_temp-browse-handle
     2364         where buf_temp-browse-handle.browse-type = 'width':u
     2365       :
     2366         assign
     2367           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2368         .
     2369       end.
     2370       for each buf_temp-diasize-handle
     2371       :
     2372         delete buf_temp-diasize-handle .
     2373       end.
     2374       assign
     2375         v-field-group-handle = frame Dialog-Frame :first-child
     2376       .
     2377       do while valid-handle(v-field-group-handle)
     2378       :
     2379         assign
     2380           v-object-handle = v-field-group-handle :first-child
     2381         .
     2382         do while valid-handle(v-object-handle)
     2383         :
     2384           if  v-object-handle <> v-diasize-browse-handle :handle
     2385           and v-object-handle <> v-diasize-resize-button
     2386           and can-query(v-object-handle, "row")
     2387           and can-query(v-object-handle, "height")
     2388           and ( v-object-handle :col + v-object-handle :width
     2389                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2390               )
     2391           then do:
     2392             find first buf_temp-browse-handle
     2393               where buf_temp-browse-handle.browse-type   = 'width':u
     2394                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2395               no-error .
     2396             if available buf_temp-browse-handle
     2397             then do:
     2398             end.
     2399             else do:
     2400               create buf_temp-diasize-handle .
     2401               assign
     2402                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2403                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2404               .
     2405             end.
     2406           end.
     2407           assign
     2408             v-object-handle = v-object-handle :next-sibling
     2409           .
     2410         end.
     2411         assign
     2412           v-field-group-handle = v-field-group-handle :next-sibling
     2413         .
     2414       end.
     2415       do with frame Dialog-Frame
     2416       :
     2417         hide v-diasize-resize-button .
     2418         v-diasize-resize-button :row = 1.
     2419         v-diasize-resize-button :column = 1.
     2420       end.
     2421       if p-change-value > 0
     2422       then do:
     2423         if frame Dialog-Frame :scrollable = true
     2424         then do:
     2425           assign
     2426             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2427             no-error .
     2428           if error-status :error
     2429           or error-status :get-message(1) <> ""
     2430           then do:
     2431             undo move_block, retry move_block.
     2432           end.
     2433         end.
     2434         assign
     2435           frame Dialog-Frame :width = v-frame-width + p-change-value
     2436           no-error .
     2437         if error-status :error
     2438         or error-status :get-message(1) <> ""
     2439         then do:
     2440           undo move_block, retry move_block.
     2441         end.
     2442         assign
     2443           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2444         no-error .
     2445         if error-status :error
     2446         or error-status :get-message(1) <> ""
     2447         then do:
     2448           undo move_block, retry move_block.
     2449         end.
     2450         for each buf_temp-browse-handle
     2451           where buf_temp-browse-handle.browse-type = 'width':u
     2452         on error undo move_block, retry move_block
     2453         :
     2454           assign
     2455             buf_temp-browse-handle.browse-handle :width
     2456               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2457             no-error .
     2458           if error-status :error
     2459           or error-status :get-message(1) <> ""
     2460           then do:
     2461             undo move_block, retry move_block .
     2462           end.
     2463         end.
     2464         for each buf_temp-diasize-handle
     2465         on error undo move_block, retry move_block
     2466         :
     2467           assign
     2468             v-object-handle = buf_temp-diasize-handle.handle-value
     2469           .
     2470           if v-object-handle <> v-diasize-resize-button
     2471           then do:
     2472             assign
     2473               v-object-handle :col = v-object-handle :col + p-change-value
     2474               no-error .
     2475             if error-status :error
     2476             or error-status :get-message(1) <> ""
     2477             then do:
     2478               undo move_block, retry move_block .
     2479             end.
     2480           end.
     2481         end.
     2482       end.
     2483       else do:
     2484         for each buf_temp-diasize-handle
     2485         on error undo move_block, retry move_block
     2486         :
     2487           assign
     2488             v-object-handle = buf_temp-diasize-handle.handle-value
     2489           .
     2490           if v-object-handle <> v-diasize-resize-button
     2491           then do:
     2492             assign
     2493               v-object-handle :col = v-object-handle :col + p-change-value
     2494               no-error .
     2495             if error-status :error
     2496             or error-status :get-message(1) <> ""
     2497             then do:
     2498               undo move_block, retry move_block .
     2499             end.
     2500           end.
     2501         end.
     2502         for each buf_temp-browse-handle
     2503           where buf_temp-browse-handle.browse-type = 'width':u
     2504         on error undo move_block, retry move_block
     2505         :
     2506           assign
     2507             buf_temp-browse-handle.browse-handle :width
     2508               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2509             no-error .
     2510           if error-status :error
     2511           or error-status :get-message(1) <> ""
     2512           then do:
     2513             undo move_block, retry move_block .
     2514           end.
     2515         end.
     2516         assign
     2517           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2518           no-error .
     2519         if error-status :error
     2520         or error-status :get-message(1) <> ""
     2521         then do:
     2522           undo move_block, retry move_block.
     2523         end.
     2524         assign
     2525           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2526         no-error .
     2527         if error-status :error
     2528         or error-status :get-message(1) <> ""
     2529         then do:
     2530           undo move_block, retry move_block.
     2531         end.
     2532         if frame Dialog-Frame :scrollable = true
     2533         then do:
     2534           assign
     2535             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2536           no-error .
     2537           if error-status :error
     2538           or error-status :get-message(1) <> ""
     2539           then do:
     2540             undo move_block, retry move_block.
     2541           end.
     2542         end.
     2543       end.
     2544       if p-move-resize
     2545       then do:
     2546         run diasize_position-resize-button in this-procedure .
     2547       end.
     2548       if v-diasize-wndstore = true
     2549       then do:
     2550         if connected("ub") = true
     2551         then do:
     2552           define variable v-cntxt-db-num        as integer   no-undo .
     2553           define variable v-cntxt-userid        as character no-undo .
     2554           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2555                                             , OUTPUT v-cntxt-userid
     2556                                             ) .
     2557           run gbl/wndsizew.p
     2558             (input  v-cntxt-db-num
     2559             ,input  v-cntxt-userid
     2560             ,input  v-diasize-proc-name
     2561             ,input  'width':u
     2562             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2563             ) .
     2564         end.
     2565       end.
     2566     end.
     2567     assign
     2568       v-diasize-change-size = false
     2569     .
     2570   end procedure.
     2571   procedure diasize_set-width :
     2572     define input  parameter p-new-width  as decimal   no-undo .
     2573     define input  parameter p-move-resize as logical   no-undo .
     2574     do
     2575     on error undo, return error return-value
     2576     :
     2577       run diasize_change-width in this-procedure
     2578         (input  (p-new-width - frame Dialog-Frame :width)
     2579         ,input  p-move-resize
     2580         ) .
     2581     end.
     2582   end procedure.
     2583   procedure diasize_position-resize-button :
     2584     do with frame Dialog-Frame
     2585     :
     2586       hide v-diasize-resize-button .
     2587       assign
     2588         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2589                     - 1
     2590                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2591         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2592                     - 1
     2593                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2594       .
     2595       view v-diasize-resize-button .
     2596     end.
     2597   end procedure.
     2598   on alt-right anywhere
     2599   do:
     2600     run diasize_change-width in this-procedure
     2601       (input 1
     2602       ,input true
     2603       ) .
     2604     return no-apply .
     2605   end.
     2606   on alt-left anywhere
     2607   do:
     2608     run diasize_change-width in this-procedure
     2609       (input -1
     2610       ,input true
     2611       ) .
     2612     return no-apply .
     2613   end.
     2614   on alt-down anywhere
     2615   do:
     2616     run diasize_change-height in this-procedure
     2617       (input 1
     2618       ,input true
     2619       ) .
     2620     return no-apply .
     2621   end.
     2622   on alt-up anywhere
     2623   do:
     2624     run diasize_change-height in this-procedure
     2625       (input -1
     2626       ,input true
     2627       ) .
     2628     return no-apply .
     2629   end.
     2630   on alt-enter of frame Dialog-Frame
     2631   do:
     2632     run diasize_maximize in this-procedure
     2633       (input  ?
     2634       ).
     2635     return no-apply .
     2636   end.
     2637   procedure diasize_end-move :
     2638     do
     2639     on error undo, return error return-value
     2640     :
     2641       define variable v-row-delta as decimal   no-undo .
     2642       define variable v-col-delta as decimal   no-undo .
     2643       define variable v-new-row as decimal   no-undo .
     2644       define variable v-new-col as decimal   no-undo .
     2645       assign
     2646         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2647         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2648       .
     2649       assign
     2650         v-row-delta = v-new-row - frame Dialog-Frame :height
     2651         v-col-delta = v-new-col - frame Dialog-Frame :width
     2652       .
     2653       run diasize_change-height in this-procedure
     2654         (input v-row-delta
     2655         ,input true
     2656         ) .
     2657       run diasize_change-width in this-procedure
     2658         (input v-col-delta
     2659         ,input true
     2660         ) .
     2661     end.
     2662   end procedure.
     2663   procedure diasize_maximize :
     2664     define input  parameter p-action as logical   no-undo .
     2665     do
     2666     on error undo, return error return-value
     2667     :
     2668       if p-action = ?
     2669       then do:
     2670         if v-diasize-need-maximize = true
     2671         then do:
     2672           assign
     2673             p-action = true
     2674           .
     2675         end.
     2676         else do:
     2677           assign
     2678             p-action = false
     2679           .
     2680         end.
     2681       end.
     2682       if p-action = true
     2683       then do:
     2684         run diasize_change-height in this-procedure
     2685           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2686               - frame Dialog-Frame :height-chars
     2687           ,input true
     2688           ) .
     2689         run diasize_change-width in this-procedure
     2690           (input session :width-chars
     2691               - frame Dialog-Frame :width-chars
     2692           ,input true
     2693           ) .
     2694         assign
     2695           v-diasize-need-maximize = false
     2696         .
     2697       end.
     2698       else do:
     2699         run diasize_change-width in this-procedure
     2700           (input v-diasize-orig-frame-width
     2701               - frame Dialog-Frame :width-chars
     2702           ,input true
     2703           ) .
     2704         run diasize_change-height in this-procedure
     2705           (input v-diasize-orig-frame-height
     2706               - frame Dialog-Frame :height-chars
     2707           ,input true
     2708           ) .
     2709         assign
     2710           v-diasize-need-maximize = true
     2711         .
     2712       end.
     2713     end.
     2714   end procedure.
     2715   procedure diasize_restore-orig-size :
     2716     do
     2717     on error undo, return error return-value
     2718     :
     2719       assign
     2720         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2721         v-diasize-current-frame-height = frame Dialog-Frame :height
     2722       .
     2723       run diasize_set-height in this-procedure
     2724         (input  v-diasize-orig-frame-height
     2725         ,input  true
     2726         ) .
     2727       run diasize_set-width in this-procedure
     2728         (input  v-diasize-orig-frame-width
     2729         ,input  true
     2730         ) .
     2731     end.
     2732   end procedure.
     2733   procedure diasize_restore-current-size :
     2734     do
     2735     on error undo, return error return-value
     2736     :
     2737       run diasize_set-height in this-procedure
     2738         (input  v-diasize-current-frame-height
     2739         ,input  true
     2740         ) .
     2741       run diasize_set-width in this-procedure
     2742         (input  v-diasize-current-frame-width
     2743         ,input  true
     2744         ) .
     2745     end.
     2746   end procedure.
     2747   procedure diasize_set-browse-handle :
     2748     define input  parameter p-browse-handle as handle   no-undo .
     2749     define buffer buf_temp-browse-handle for temp-browse-handle .
     2750     do
     2751     on error undo, return error return-value
     2752     :
     2753       assign
     2754         v-diasize-browse-handle = p-browse-handle
     2755       .
     2756       for each buf_temp-browse-handle
     2757       on error undo, return error return-value
     2758       :
     2759         delete buf_temp-browse-handle .
     2760       end.
     2761     end.
     2762   end procedure.
     2763   procedure diasize_add_browse :
     2764     define input  parameter p-browse-type   as character no-undo .
     2765     define input  parameter p-browse-handle as handle    no-undo .
     2766     define buffer buf_temp-browse-handle for temp-browse-handle .
     2767     do
     2768     on error undo, return error return-value
     2769     :
     2770       assign
     2771         v-diasize-browse-number = v-diasize-browse-number + 1
     2772       .
     2773       create buf_temp-browse-handle .
     2774       assign
     2775         buf_temp-browse-handle.browse-type   = p-browse-type
     2776         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2777         buf_temp-browse-handle.browse-handle = p-browse-handle
     2778       .
     2779     end.
     2780   end procedure.
     2781   procedure diasize_init :
     2782     define variable v-default-value    as logical   no-undo .
     2783     define variable v-restore-saved    as logical   no-undo .
     2784     define variable v-resize-value-str as character no-undo .
     2785     do
     2786     on error undo, return error return-value
     2787     :
     2788       do with frame Dialog-Frame
     2789       :
     2790         assign
     2791           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2792           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2793           v-diasize-browse-handle     = browse br-cli-hist :handle
     2794         .
     2795         create button v-diasize-resize-button
     2796         assign
     2797           parent        = frame Dialog-Frame :first-child
     2798           label         = "s"
     2799           height-pixels = 16
     2800           width-pixels  = 16
     2801           visible       = true
     2802           sensitive     = true
     2803           movable       = true
     2804           triggers:
     2805             on end-move persistent run diasize_end-move in this-procedure .
     2806           end triggers.
     2807         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2808         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2809         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2810         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2811         assign
     2812           v-diasize-wndmax = false
     2813         .
     2814         if connected("ub") = true
     2815         then do:
     2816           define variable v-cntxt-db-num        as integer   no-undo .
     2817           define variable v-cntxt-userid        as character no-undo .
     2818           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2819                                             , OUTPUT v-cntxt-userid
     2820                                             ) .
     2821           run gbl/wndpar_r.p
     2822             (input  v-cntxt-db-num
     2823             ,input  v-cntxt-userid
     2824             ,input  'wndmax':U
     2825             ,output v-diasize-wndmax
     2826             ,output v-default-value
     2827             ) .
     2828         end.
     2829         assign
     2830           v-diasize-wndstore = false
     2831         .
     2832         if connected("ub") = true
     2833         then do:
     2834           run gbl/wndpar_r.p
     2835             (input  v-cntxt-db-num
     2836             ,input  v-cntxt-userid
     2837             ,input  'wndstore':U
     2838             ,output v-diasize-wndstore
     2839             ,output v-default-value
     2840             ) .
     2841         end.
     2842         assign
     2843           v-diasize-proc-name = entry(1, program-name(2), '.')
     2844         .
     2845         if v-diasize-wndstore = true
     2846         then do:
     2847           assign
     2848             v-restore-saved = false
     2849           .
     2850           if connected("ub") = true
     2851           then do:
     2852             run gbl/wndsizer.p
     2853               (input  v-cntxt-db-num
     2854               ,input  v-cntxt-userid
     2855               ,input  v-diasize-proc-name
     2856               ,input  'height':u
     2857               ,output v-resize-value-str
     2858               ) .
     2859             if v-resize-value-str <> '':U
     2860             then do:
     2861               run diasize_change-height in this-procedure
     2862                 (input  integer(v-resize-value-str)
     2863                 ,input  true
     2864                 ) .
     2865               assign
     2866                 v-restore-saved = true
     2867               .
     2868             end.
     2869           end.
     2870           if connected("ub") = true
     2871           then do:
     2872             run gbl/wndsizer.p
     2873               (input  v-cntxt-db-num
     2874               ,input  v-cntxt-userid
     2875               ,input  v-diasize-proc-name
     2876               ,input  'width':u
     2877               ,output v-resize-value-str
     2878               ) .
     2879             if v-resize-value-str <> '':U
     2880             then do:
     2881               run diasize_change-width in this-procedure
     2882                 (input  integer(v-resize-value-str)
     2883                 ,input  true
     2884                 ) .
     2885               assign
     2886                 v-restore-saved = true
     2887               .
     2888             end.
     2889           end.
     2890           if v-restore-saved <> true
     2891           then do:
     2892             if v-diasize-wndmax = true
     2893             then do:
     2894               run diasize_maximize in this-procedure
     2895                 (input  true
     2896                 ) .
     2897             end.
     2898           end.
     2899         end.
     2900         else do:
     2901           if v-diasize-wndmax = true
     2902           then do:
     2903             run diasize_maximize in this-procedure
     2904               (input  true
     2905               ) .
     2906           end.
     2907         end.
     2908       end.
     2909     end.
     2910   end procedure.
     2911   procedure diasize_need-full-display :
     2912     define output parameter p-need-full-display as logical   no-undo .
     2913     do
     2914     on error undo, return error return-value
     2915     :
     2916       assign
     2917         p-need-full-display = v-diasize-need-full-display
     2918       .
     2919       assign
     2920         v-diasize-need-full-display = false
     2921       .
     2922     end.
     2923   end procedure.
     2924   procedure get-context :
     2925      define output parameter p-db-num as integer          no-undo.
     2926      define output parameter p-user-id as character        no-undo.
     2927      define variable v-login               as character    no-undo.
     2928      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2929      define buffer buf_user-login  for ub.user-login .
     2930      do
     2931      on error undo, return error
     2932      :
     2933            FIND FIRST buf_sys-ctrl no-lock.
     2934            ASSIGN
     2935               v-login = USERID("ub")
     2936               p-db-num = buf_sys-ctrl.db-num
     2937            .
     2938            FIND FIRST buf_user-login
     2939                 WHERE buf_user-login.db-num = p-db-num
     2940                   AND buf_user-login.user-login = v-login
     2941                 no-lock
     2942                 no-error
     2943                 .
     2944            IF AVAILABLE buf_user-login
     2945            THEN DO:
     2946               assign
     2947                  p-user-id = buf_user-login.user-id
     2948               .
     2949            END.
     2950      end.
     2951   end procedure.
