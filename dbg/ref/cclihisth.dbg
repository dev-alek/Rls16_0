      663   procedure prn-lib-prn-file :
      664     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      665     define input parameter p-DIsabledoptions as integer no-undo .
      666     define variable v-report-name as character no-undo .
      667     define variable v-user-action as character no-undo .
