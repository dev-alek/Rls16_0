     1074   FUNCTION get-all-fields returns character (p-file-name as character ):
     1075   define variable v-dop as character no-undo .
     1076     find first _file no-lock where _file._file-name = p-file-name no-error .
     1077     if not available _file then return "":U.
     1078     for each _field no-lock where
     1079              _field._file-recid = recid(_file) :
     1080       assign
     1081       v-dop = v-dop + _field._field-name + chr(44)
     1082       .
     1083     end.
     1084     return trim(v-dop).
     1085   END FUNCTION.
     1086   PROCEDURE proc-full-temp-changes :
     1087     define input  parameter p-hst-handle as handle    no-undo .
     1088     define input  parameter p-main-table as character no-undo .
     1089     define input  parameter p-field-list as character no-undo .
     1090     define input  parameter p-label-form as character no-undo .
     1091     define variable h-new-buf         as handle    no-undo .
     1092     define variable h-main-buf        as handle    no-undo .
     1093     define variable h-for-comp        as handle    no-undo .
     1094     define variable v-inform          as character no-undo .
     1095     define variable v-ind             as integer   no-undo .
     1096     define variable v-idx-field-qnty  as integer   no-undo .
     1097     define variable v-num-entries     as integer   no-undo .
     1098     define variable fh                as handle    no-undo .
     1099     define variable fh-main           as handle    no-undo .
     1100     define variable fh-old            as handle    no-undo .
     1101     define variable fh-new            as handle    no-undo .
     1102     define variable v-field-name      as character no-undo .
     1103     define variable v-field-lvl       as character no-undo .
     1104     define variable v-field-form      as character no-undo .
     1105     define variable v-search-exp      as character no-undo .
     1106     define variable v-srch-main       as character no-undo .
     1107     define variable v-word-link       as character no-undo .
     1108     define variable v-av-chip-num     as logical   no-undo .
     1109     define variable v-main-pi-fld-lst as character no-undo .
     1110     define variable v-main-fld-lst    as character no-undo .
     1111     define variable v-delim-list      as character no-undo .
     1112     define variable v-label           as character no-undo .
     1113     define variable v-old-value       as character no-undo case-sensitive.
     1114     define variable v-new-value       as character no-undo case-sensitive.
     1115     define variable v-chg-fields as character no-undo.
     1116     for each temp-changes:
     1117       delete temp-changes.
     1118     end.
     1119     if not p-hst-handle:available then do:
     1120       return .
     1121     end.
     1122     create buffer h-new-buf  for table p-hst-handle .
     1123     create buffer h-main-buf for table p-main-table .
     1124     assign
     1125       v-inform = h-main-buf:index-information(1)
     1126       v-ind    = 2
     1127     .
     1128     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1129     on error undo, return error
     1130     :
     1131       assign
     1132         v-inform = h-main-buf:index-information( v-ind )
     1133         v-ind    = v-ind + 1
     1134       .
     1135     end.
     1136     if v-inform = ?
     1137       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1138       or entry( 3, v-inform, ",":U ) <> "1":U
     1139     then do:
     1140       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1141     end.
     1142     assign
     1143       v-idx-field-qnty = num-entries( v-inform ) - 4
     1144     .
     1145     if v-idx-field-qnty < 2 then do:
     1146       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1147     end.
     1148     assign
     1149       v-srch-main   = "where":U
     1150       v-word-link   = "":U
     1151       v-av-chip-num = false
     1152       v-delim-list  = "":U
     1153     .
     1154     do v-ind = 1 to v-idx-field-qnty by 2
     1155     on error undo, return error
     1156     :
     1157       assign
     1158         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1159         fh                = p-hst-handle:buffer-field( v-field-name )
     1160         fh-main           = h-main-buf:buffer-field( v-field-name )
     1161         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1162         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1163       .
     1164       if fh:data-type ="character":U then do:
     1165         assign
     1166           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1167         .
     1168       end.
     1169       else do:
     1170         assign
     1171           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1172         .
     1173       end.
     1174       if v-delim-list = "":U then do:
     1175         assign
     1176           v-delim-list = ",":U
     1177         .
     1178       end.
     1179       if v-word-link = "":U then do:
     1180         assign
     1181           v-word-link = "and":U
     1182         .
     1183       end.
     1184     end.
     1185     assign
     1186       v-delim-list  = "":U
     1187     .
     1188     do v-ind = 1 to h-main-buf:num-fields
     1189     on error undo, return error
     1190     :
     1191       assign
     1192         fh-main      = h-main-buf:buffer-field( v-ind )
     1193         v-field-name = fh-main:name
     1194       .
     1195         assign
     1196           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1197         .
     1198         if v-delim-list = "":U then do:
     1199           assign
     1200             v-delim-list = ",":U
     1201           .
     1202         end.
     1203     end.
     1204     assign
     1205       v-inform = p-hst-handle:index-information(1)
     1206       v-ind    = 2
     1207     .
     1208     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1209     on error undo, return error
     1210     :
     1211       assign
     1212         v-inform = p-hst-handle:index-information( v-ind )
     1213         v-ind    = v-ind + 1
     1214       .
     1215     end.
     1216     if v-inform = ?
     1217       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1218       or entry( 3, v-inform, ",":U ) <> "1":U
     1219     then do:
     1220       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1221     end.
     1222     assign
     1223       v-idx-field-qnty = num-entries( v-inform ) - 4
     1224     .
     1225     if v-idx-field-qnty < 2 then do:
     1226       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1227     end.
     1228     assign
     1229       v-search-exp  = "where":U
     1230       v-word-link   = "":U
     1231       v-av-chip-num = false
     1232     .
     1233     do v-ind = 1 to v-idx-field-qnty by 2
     1234     on error undo, return error
     1235     :
     1236       assign
     1237         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1238         fh           = p-hst-handle:buffer-field( v-field-name )
     1239         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1240       .
     1241       if v-field-name = "chip-num":U then do:
     1242         assign
     1243           v-search-exp  = substitute( "&1 >", v-search-exp )
     1244           v-av-chip-num = true
     1245         .
     1246       end.
     1247       else do:
     1248         assign
     1249           v-search-exp = substitute( "&1 =", v-search-exp )
     1250         .
     1251       end.
     1252       if fh:data-type ="character":U then do:
     1253         assign
     1254           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1255         .
     1256       end.
     1257       else do:
     1258         assign
     1259           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1260         .
     1261       end.
     1262       if v-word-link = "":U then do:
     1263         assign
     1264           v-word-link = "and":U
     1265         .
     1266       end.
     1267     end.
     1268     if v-av-chip-num = false then do:
     1269       message
     1270         vss-workfile vss-revision vss-description skip
     1271         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1272         "Использование данной процедуры невозможно!" skip
     1273         view-as alert-box error .
     1274       return error .
     1275     end.
     1276     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1277     if not h-new-buf:available then do:
     1278       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1279       if not h-main-buf:available then do:
     1280         assign
     1281           h-for-comp = ?
     1282         .
     1283       end.
     1284       else do:
     1285         assign
     1286           h-for-comp = h-main-buf
     1287         .
     1288       end.
     1289     end.
     1290     else do:
     1291       assign
     1292         h-for-comp = h-new-buf
     1293       .
     1294     end.
     1295     assign
     1296       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1297     .
     1298     do v-ind = 1 to v-num-entries
     1299     on error undo, return error return-value
     1300     :
     1301       assign
     1302         v-field-name = entry( v-ind, v-main-fld-lst )
     1303         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1304         v-old-value  = fh-old:buffer-value()
     1305         v-label      = trim( fh-old:label )
     1306       .
     1307       if ( trim( p-field-list ) <> "":U
     1308            and lookup( v-field-name, p-field-list ) > 0
     1309          )
     1310          or trim( p-field-list ) = "":U
     1311       then do:
     1312         if h-for-comp <> ? then do:
     1313           assign
     1314             fh-new      = h-for-comp:buffer-field( v-field-name )
     1315             v-new-value = fh-new:buffer-value()
     1316           .
     1317         end.
     1318         else do:
     1319           assign
     1320             v-new-value = "":U
     1321           .
     1322         end.
     1323         if v-old-value <> v-new-value
     1324         then do:
     1325           create temp-changes.
     1326           assign
     1327             temp-changes.t_name = p-main-table
     1328             temp-changes.f_name = v-field-name
     1329             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1330             temp-changes.v_old  = trim( v-old-value )
     1331             temp-changes.v_new  = trim( v-new-value )
     1332             temp-changes.num_   = 0
     1333             temp-changes.fNotChange = v-old-value eq v-new-value
     1334           .
     1335         end.
     1336       end.
     1337     end.
     1338     assign
     1339       v-num-entries = num-entries( p-label-form, chr(8) )
     1340     .
     1341     do v-ind = 1 to v-num-entries
     1342     on error undo, return error return-value
     1343     :
     1344       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1345         assign
     1346           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1347           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1348           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1349         .
     1350         find first temp-changes
     1351           where temp-changes.f_name = v-field-name
     1352           no-error .
     1353         if available temp-changes then do:
     1354           if trim( v-field-lvl ) <> "":U then do:
     1355             assign
     1356               temp-changes.l_name = v-field-lvl
     1357             .
     1358           end.
     1359           if trim( v-field-form ) <> "":U then do:
     1360             assign
     1361               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1362             .
     1363             if h-for-comp <> ? then do:
     1364               assign
     1365                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1366               .
     1367             end.
     1368           end.
     1369         end.
     1370       end.
     1371       else do:
     1372         message
     1373           vss-workfile vss-revision vss-description skip
     1374           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1375           substitute( "список для поля '&1': '&2'"
     1376                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1377                       ,entry( v-ind, p-label-form, chr(8) )
     1378                     ) skip
     1379           substitute( "полный список: &2", p-label-form ) skip
     1380           view-as alert-box error .
     1381       end.
     1382     end.
     1383     delete object h-new-buf .
     1384     delete object h-main-buf .
     1385   END PROCEDURE.
     1386   FUNCTION get-action RETURNS CHARACTER
     1387     ( p-action as integer )  FORWARD.
     1388   FUNCTION get-cli RETURNS CHARACTER
     1389     ( p-obj-type as character, p-obj-code as integer )  FORWARD.
     1390   FUNCTION get-source-type RETURNS CHARACTER
     1391     ( p-source-type as character )  FORWARD.
     1392   FUNCTION get-subject RETURNS CHARACTER
     1393     ( p-subject as character )  FORWARD.
     1394   DEFINE BUTTON B-Help
     1395        LABEL "Помо&щь"
     1396        SIZE 3 BY 1
     1397        BGCOLOR 8 .
     1398   DEFINE BUTTON B-lookup
     1399        LABEL "&Контрагент"
     1400        SIZE 10 BY 1.
     1401   DEFINE BUTTON B-mark
     1402        LABEL "&*"
     1403        SIZE 3 BY 1.
     1404   DEFINE BUTTON B-print
     1405        LABEL "Пе&чать"
     1406        SIZE 3 BY 1.
     1407   DEFINE BUTTON b-quit AUTO-END-KEY
     1408        LABEL "&Выход"
     1409        SIZE 10 BY 1
     1410        BGCOLOR 8 .
     1411   DEFINE BUTTON b-reason
     1412        LABEL "&Причина"
     1413        SIZE 10 BY 1.
     1414   DEFINE BUTTON B-sch
     1415        LABEL "&Фильтр"
     1416        SIZE 3 BY 1.
     1417   DEFINE BUTTON b-sel AUTO-GO
     1418        LABEL "Вы&бор"
     1419        SIZE 10 BY 1
     1420        BGCOLOR 8 .
     1421   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1422         VIEW-AS TEXT
     1423        SIZE 6 BY 1
     1424        FGCOLOR 4  NO-UNDO.
     1425   DEFINE VARIABLE sch-cli-code AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1426        LABEL "коду"
     1427        VIEW-AS FILL-IN
     1428        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1429   DEFINE VARIABLE sch-corr-date AS DATE FORMAT "99/99/9999":U
     1430        LABEL "Дате изменения"
     1431        VIEW-AS FILL-IN
     1432        SIZE 11 BY 1 NO-UNDO.
     1433   DEFINE VARIABLE sch-corr-user-name AS CHARACTER FORMAT "X(9)":U
     1434        LABEL "пользователю"
     1435        VIEW-AS FILL-IN
     1436        SIZE 12 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1437   DEFINE VARIABLE sch-db-num AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1438        LABEL "БД"
     1439        VIEW-AS FILL-IN
     1440        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1441   DEFINE VARIABLE v-corr-user-db-num AS INTEGER FORMAT ">>>>9":U INITIAL 0
     1442        LABEL "по БД"
     1443        VIEW-AS FILL-IN
     1444        SIZE 6 BY 1 NO-UNDO.
     1445   DEFINE QUERY BR-changes FOR
     1446         temp-changes SCROLLING.
     1447   DEFINE QUERY br-cli-hist FOR
     1448         X_c-cli-hist SCROLLING.
     1449   DEFINE BROWSE BR-changes
     1450     QUERY BR-changes DISPLAY
     1451         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1452   temp-changes.v_old COLUMn-LABEL "Было" format "X(255)"
     1453   temp-changes.v_new COLUMn-LABEL "Стало" format "X(255)"
     1454       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.25.
     1455   DEFINE BROWSE br-cli-hist
     1456     QUERY br-cli-hist NO-LOCK DISPLAY
     1457         mark-string(recid(X_c-cli-hist), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1458         X_c-cli-hist.corr-date FORMAT "99/99/9999":U
     1459         string(X_c-cli-hist.corr-time, "HH:MM:SS":U) COLUMN-LABEL "Время изм." FORMAT "X(8)":U
     1460         usrfulnf(X_c-cli-hist.corr-user-name) COLUMn-LABEL "Изменил" FORMAT "X(255)":U width 18
     1461         get-action(X_c-cli-hist.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1462         X_c-cli-hist.corr-user-db-num FORMAT ">>>>9":U
     1463         X_c-cli-hist.is-news FORMAT "+/":U
     1464         get-source-type(X_c-cli-hist.source-type) COLUMN-LABEL "Источн.!измен."
     1465         X_c-cli-hist.source-ref FORMAT "X(14)":U
     1466         X_c-cli-hist.obj-type + string(X_c-cli-hist.obj-code) COLUMN-LABEL "Объект" FORMAT "X(12)":U
     1467         if v-find then get-cli(X_c-cli-hist.obj-type, X_c-cli-hist.obj-code) else "":U COLUMN-LABEL "Назв. контрагента" FORMAT "X(25)":U
     1468         get-subject(X_c-cli-hist.subject) COLUMN-LABEL "Предмет изменения" FORMAT "X(35)":U WIDTH 15
     1469         X_c-cli-hist.host-code COLUMN-LABEL "Фирма" FORMAT "999999999":U
     1470     ENABLE
     1471         X_c-cli-hist.corr-date
     1472       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.46.
     1473   DEFINE FRAME Dialog-Frame
     1474        b-quit AT ROW 1 COL 1
     1475        B-mark AT ROW 1 COL 11
     1476        b-sel AT ROW 1 COL 21
     1477        v-corr-user-db-num AT ROW 1 COL 37 COLON-ALIGNED
     1478        B-lookup AT ROW 1 COL 49
     1479        b-reason AT ROW 1 COL 59
     1480        B-print AT ROW 1 COL 89
     1481        B-sch AT ROW 1 COL 92
     1482        B-Help AT ROW 1 COL 95
     1483        br-cli-hist AT ROW 2 COL 1
     1484        sch-db-num AT ROW 13.63 COL 60.13 COLON-ALIGNED
     1485        sch-corr-date AT ROW 13.63 COL 85.75 COLON-ALIGNED
     1486        sch-cli-code AT ROW 13.67 COL 48.13 COLON-ALIGNED
     1487        sch-corr-user-name AT ROW 13.71 COL 22.5 COLON-ALIGNED
     1488        BR-changes AT ROW 14.79 COL 1
     1489        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1490        "ПОИСК ПО" VIEW-AS TEXT
     1491             SIZE 8.38 BY 1 AT ROW 13.63 COL 1.38
     1492             FGCOLOR 4
     1493        SPACE(89.48) SKIP(7.44)
     1494       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1495            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1496            TITLE "Полная история по контрагенту"
     1497            CANCEL-BUTTON b-quit.
     1498   ASSIGN
     1499          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1500          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1501   ASSIGN
     1502          br-cli-hist:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     1503   ON GO OF FRAME Dialog-Frame
     1504   DO:
     1505     p-rid-list = v-rid-list.
     1506   END.
     1507   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1508   DO:
     1509     APPLY "END-ERROR":U TO SELF.
     1510   END.
     1511   ON CHOOSE OF B-lookup IN FRAME Dialog-Frame
     1512   DO:
     1513   run ref/showcli.p (
     1514                  input parparentproc
     1515                 ,input X_c-cli-hist.obj-type
     1516                 ,input X_c-cli-hist.obj-code
     1517                 ) no-error.
     1518   if error-status:error then return no-apply.
     1519   END.
     1520   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1521   DO:
     1522   define variable loc#log as logical no-undo .
     1523     if available X_c-cli-hist then do:
     1524   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1525   define variable v-str-recid14 as character no-undo .
     1526   define variable v-num-entry14 as integer   no-undo .
     1527   assign
     1528     v-str-recid14 = trim( string( recid( X_c-cli-hist ) , "->>>>>>>>>>>9":U ) )
     1529     v-num-entry14 = lookup( v-str-recid14 , v-rid-list )
     1530   .
     1531   if v-num-entry14 > 0 then do:
     1532     assign
     1533       entry( v-num-entry14, v-rid-list ) = "":U
     1534       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1535     .
     1536   end.
     1537   else do:
     1538     assign
     1539       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid14
     1540     .
     1541   end.
     1542       loc#log = br-cli-hist:refresh() .
     1543       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1544           loc#log = br-cli-hist:select-next-row ().
     1545           apply "VALUE-CHANGED" to br-cli-hist in frame Dialog-Frame.
     1546       end.
     1547       if num-entries( v-rid-list ) = 0
     1548       then
     1549           hide mark-num in frame Dialog-Frame.
     1550       else
     1551           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1552     end.
     1553     apply "entry" to br-cli-hist in frame Dialog-Frame.
     1554   END.
     1555   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1556   DO:
     1557       run proc-b-print in this-procedure no-error.
     1558     if error-status:error then return no-apply.
     1559   END.
     1560   ON CHOOSE OF b-reason IN FRAME Dialog-Frame
     1561   DO:
     1562     define variable v-list as character no-undo.
     1563     case X_c-cli-hist.obj-type :
     1564       when 'орг':U   then do:
     1565         run str/hstcrsns.w (
     1566                          input        parparentproc
     1567                        , input        "":U
     1568                        , input        "frm":U
     1569                        , input        (if p-mode = 'все':U
     1570                                        then X_c-cli-hist.obj-code
     1571                                        else p-obj-code)
     1572                        , input        ?
     1573                        , input        ?
     1574                        , input-output v-list
     1575                        ) no-error.
     1576       end.
     1577       when 'маг':U  or
     1578       when 'скл':U then do:
     1579         run str/objcrsns.w ( input        parparentproc
     1580                        , input        "":U
     1581                        , input        "obj":U
     1582                        , input        (if p-mode = 'все':U
     1583                                        then X_c-cli-hist.obj-type
     1584                                        else p-obj-type)
     1585                        , input        (if p-mode = 'все':U
     1586                                        then X_c-cli-hist.obj-code
     1587                                        else p-obj-code)
     1588                        , input        ?
     1589                        , input        ?
     1590                        , input-output v-list
     1591                        ) no-error.
     1592       end.
     1593       otherwise          do:
     1594         return no-apply.
     1595       end.
     1596     end case.
     1597     if error-status :error then do: return no-apply. end.
     1598   END.
     1599   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1600   DO:
     1601       run proc-b-sch in this-procedure no-error.
     1602     if error-status:error then return no-apply.
     1603   END.
     1604   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1605   DO:
     1606     if ( available X_c-cli-hist ) then do:
     1607       if ( v-rid-list = "" ) or b-mark:sensitive = no
     1608       then
     1609       v-rid-list = string( recid( X_c-cli-hist ) ) .
     1610     end.
     1611   END.
     1612   ON MOUSE-SELECT-DBLCLICK OF br-cli-hist IN FRAME Dialog-Frame
     1613   DO:
     1614        run proc-br-cli-hist in this-procedure no-error.
     1615     if error-status:error then return no-apply.
     1616   END.
     1617   ON RETURN OF br-cli-hist IN FRAME Dialog-Frame
     1618   DO:
     1619       run proc-br-cli-hist in this-procedure no-error.
     1620     if error-status:error then return no-apply.
     1621   END.
     1622   ON VALUE-CHANGED OF br-cli-hist IN FRAME Dialog-Frame
     1623   DO:
     1624     run proc-view-changes in this-procedure no-error.
