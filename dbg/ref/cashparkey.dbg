      570   if session:batch-mode
      571   then
      572      mBatchMode = yes.
      573   if mBatchMode = ? then do:
      574     mVisCUrentVin = current-window:visible.
      575     mFameOldVis = mFramBachModHandle:visible.
      576     mFramBachModHandle:visible  = yes.
      577     mBatchMode = mFramBachModHandle:visible ne yes.
      578     mFramBachModHandle:visible = mFameOldVis.
      579     current-window:visible = mVisCUrentVin.
      580   end.
      581    if  log-manager:logfile-name ne ?
      582     then DO:
      583         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      584         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      585         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      586     end.
      587   on choose of B-WaitFramStop in frame waitfram
      588   do:
      589     mWaitFramStop = yes.
      590     mWaitFramStopUser = yes.
      591   end.
      592   function waitfram-check-timeout returns logical():
      593      define variable vtime as int64 no-undo.
      594      if mWaitFramStopTimeOut
      595      then
      596         return yes.
      597      vtime = ( now - mWaitFramStartProc ) / 1000 .
      598      if     mWaitFramTimeOut ne ?
      599         and mWaitFramTimeOut ne 0
      600         and mWaitFramTimeOut lt vtime
      601      then do:
      602         mWaitFramStopTimeOut = yes.
      603      end.
      604      return mWaitFramStopTimeOut.
      605   end.
      606   procedure waitfram-hide :
      607     if not session:batch-mode
      608     then do
      609     on error undo, return error return-value
      610     :
      611       pause 0 before-hide .
      612       if not mBatchMode then
      613         hide frame waitfram .
      614     if     not mWaitFramView
      615        and mWaitProcEvent
      616     then
      617       process events .
      618     end.
      619   end procedure.
      620   procedure waitfram-show :
      621     define input  parameter p-message as character no-undo .
      622     define variable v-left-margin as integer   no-undo .
      623     if not session:batch-mode
      624     then do
      625     on error undo, return error return-value
      626     :
      627       if length(p-message) <= 70 then do:
      628         assign
      629           v-left-margin = integer((70 - length(p-message)) / 2)
      630         .
      631         assign
      632           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      633         .
      634         assign
      635           v-waitfram-action01 = " "
      636           v-waitfram-action02 = " "
      637                                    + fill(" ", v-left-margin)
      638                                    + p-message
      639           v-waitfram-action03 = " "
      640         .
      641       end.
      642       else do:
      643         define variable vRindex1 as integer no-undo.
      644         define variable vRindex2 as integer no-undo.
      645         vRindex1 = r-index(p-message," ",70).
      646         if vRindex1 = 0
      647         then
      648            vRindex1 = 70.
      649         if length(p-message)  <= vRindex1 + 70 then do:
      650           assign
      651             v-waitfram-action01 = " "
      652             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      653             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      654           .
      655         end.
      656         else do:
      657           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      658           if vRindex2 <= vRindex1
      659           then
      660              vRindex2 = vRindex1 + 70.
      661           assign
      662             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      663             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      664             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      665           .
      666         end.
      667       end.
      668       B-viewProcInfo:visible   in frame waitfram = no.
      669       B-viewProcInfo:sensitive in frame waitfram = no.
      670       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      671       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      672       if  (   mWaitFramView
      673          or  mWaitProcEvent)
      674          and not mBatchMode
      675       then
      676          display
      677             v-waitfram-action01 skip
      678             v-waitfram-action02 skip
      679             v-waitfram-action03 skip
      680          with frame waitfram .
      681       if     mWaitFramView
      682          then do:
      683             if     mWaitFramInterval ne ?
      684                and not mBatchMode
      685             then
      686                wait-for go of frame waitfram pause mWaitFramInterval.
      687          end.
      688          else
      689             if     mWaitProcEvent
      690                and not mBatchMode
      691             then
      692                process events .
      693     end.
      694   end procedure.
      695      procedure waitfram-show-this:
      696         define input  parameter iInterval as int64 no-undo.
      697         define variable vtime as int64 no-undo.
      698         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      699         mWaitFramInterval = iInterval.
      700         run waitfram-show (substitute("&1&2 &3&4" ,
      701                                       mWaitFramTextBeg ,
      702                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      703                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      704                                       mWaitFramTextEnd
      705                                      )
      706                           ).
      707      end.
      708      procedure WaitFramRunPause:
      709         define input  parameter iInterval as dec no-undo.
      710         define variable vStart  as datetime-tz no-undo.
      711         define variable vend    as datetime-tz no-undo.
      712         define variable vint as int64 no-undo.
      713         define variable vOk as logical no-undo.
      714         vStart = now.
      715         vend   = vStart.
      716         publish "WaitFramPause" (iInterval,output vOk).
      717         vend   =  now.
      718         vint = vend - vStart.
      719         vint = iInterval - vint / 1000.
      720         if     not mWaitFramStop
      721            and (   vint > 0
      722                 or (    not vOk
      723                     and iInterval eq ?
      724                     )
      725                 )
      726         then
      727            run waitfram-show-this (iInterval).
      728         vend   =  now.
      729         vint = vend - vStart.
      730         vint = iInterval - vint / 1000.
      731         if     not mWaitFramStop
      732            and vint > 0
      733         then do:
      734            run gbl/pause.p (vint * 1000).
      735         end.
      736         if iInterval ne ?
      737         then
      738            publish "WaitFramStop".
      739         waitfram-check-timeout().
      740      end.
      741      procedure WaitFramWaitFor:
      742         define input  parameter iInterval as dec no-undo.
      743         assign
      744            mWaitFramStartProc   = now
      745            mWaitFramStopUser    = no
      746            mWaitFramStopTimeOut = no
      747         .
      748         block-wait:
      749         do while not mWaitFramStop:
      750            run WaitFramRunPause (iInterval).
      751            if  waitfram-check-timeout()
      752            then do:
      753               leave block-wait.
      754            end.
      755         end.
      756         run waitfram-hide.
      757      end.
      758   procedure waitfram-join :
      759     define input  parameter p-line-1  as character no-undo .
      760     define input  parameter p-line-2  as character no-undo .
      761     define input  parameter p-line-3  as character no-undo .
      762     define output parameter p-message as character no-undo .
      763     do
      764     on error undo, return error return-value
      765     :
      766       assign
      767         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      768                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      769                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      770       .
      771     end.
      772   end procedure.
      773   function waitfram-join-function returns character
      774     (input p-line-1 as character
      775     ,input p-line-2 as character
      776     ,input p-line-3 as character
      777     ).
      778     define variable v-message as character no-undo .
      779     run waitfram-join in this-procedure
      780       (input  p-line-1
      781       ,input  p-line-2
      782       ,input  p-line-3
      783       ,output v-message
      784       ) .
      785     return v-message .
      786   end function .
      787   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      788   FUNCTION mark-string RETURNS CHARACTER
      789     ( input p-recid as recid, input mark-list as character  ) :
      790     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      791   END FUNCTION.
      792   function getstatus return char
      793      (iStatus as integer  ):
      794      define variable vStatus as character no-undo.
      795         vStatus = entry (lookup (string(iStatus), '0,1,50,99':U), 'тек,удал,блок,удаление':U) no-error.
      796      return vStatus.
      797   end.
      798   function getproceditEx return character
      799      (ibuffertt  as handle,
      800       iProcDefut as character):
      801      define variable oProc as character no-undo.
      802      define variable vparent     as character no-undo.
      803      define variable vcode       as character no-undo.
      804      define variable vLastdelim  as integer no-undo.
      805      define buffer code for code.
      806      if     ibuffertt::procedit ne ""
      807         and ibuffertt::procedit ne  ?
      808      then
      809         oProc = ibuffertt::procedit.
      810      else do:
      811         assign
      812            vLastdelim = r-index(ibuffertt::parent,chr(4))
      813            vparent    = if vLastdelim eq 0 then "" else substring(ibuffertt::parent,1,vLastdelim - 1)
      814            vcode      = if vLastdelim eq 0 then ibuffertt::parent else substring(ibuffertt::parent,vLastdelim + 1)
      815         .
      816         find first code where Code.parent eq vparent
      817                            and code.code  eq vcode
      818         no-lock no-error.
      819         block-code:
      820         do while available code and code.code ne "":
      821            if     code.procedit ne ?
      822               and code.procedit ne ""
      823            then do:
      824               oProc = code.procedit.
      825               leave block-code.
      826            end.
      827            assign
      828               vLastdelim = r-index(Code.parent,chr(4))
      829               vparent    = if vLastdelim eq 0 then "" else substring(Code.parent,1,vLastdelim - 1)
      830               vcode      = if vLastdelim eq 0 then Code.parent else substring(Code.parent,vLastdelim + 1)
      831            .
      832            find first code where Code.parent eq vparent
      833                               and code.code  eq vcode
      834            no-lock no-error.
      835         end.
      836      end.
      837      if    oProc eq ""
      838         or oProc eq ?
      839      then
      840         oProc = iProcDefut.
      841      return oProc.
      842   end.
      843   function getprocedit return character
      844      (ibuffertt  as handle):
      845      return getproceditEx(ibuffertt,"").
      846   end.
      847   if imode eq 'ПРОСМОТР':U
      848   then
      849      imode = 'ИЗМЕНЕНИЕ':U.
      850   define variable log-res  as log   no-undo.
      851   define variable ri       as recid no-undo.
      852   define variable v-rid    as recid no-undo .
      853   define variable v-db-num like ub.db.db-num no-undo .
      854   define buffer b2-code for code .
      855   find first b2-code where b2-code.parent eq iparent
      856                        and b2-code.code eq icode
      857   no-lock no-error.
      858   FUNCTION getKeyName RETURNS CHARACTER
      859      ( iCode as char   )  FORWARD.
      860   DEFINE BUTTON b-exit AUTO-GO
      861      LABEL "&Выход ":L
      862      SIZE 10 BY 1.
      863   DEFINE BUTTON b-chiled
      864      LABEL "&Открыть":L
      865      SIZE 10 BY 1.
      866   DEFINE BUTTON b-help
      867        LABEL "Помо&щь":L
      868        SIZE 3 BY 1.
      869   define variable mSearch   as character       format "x(60)":U
      870      label "Поиск"
      871      view-as fill-in
      872      size 60 by 1 no-undo.
      873   DEFINE QUERY BROWSE-Code FOR
      874      buf-code SCROLLING.
      875   DEFINE BROWSE BROWSE-Code
      876      QUERY BROWSE-Code NO-LOCK DISPLAY
      877      buf-code.code  FORMAT "x(20)":U WIDTH 32
      878      getKeyName (buf-code.code) COLUMN-LABEL "Наименование" format "x(40)"
      879       WITH NO-ROW-MARKERS SEPARATORS SIZE 100.6 BY 20 ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
      880   DEFINE FRAME f-c-p
      881      b-exit AT ROW 1 COL 1
      882      b-chiled AT ROW 1 COL 13.6
      883      b-help AT ROW 1 COL 71
      884      mSearch AT ROW 2.5 COL 1.2
      885      BROWSE-Code AT ROW 4 COL 1 WIDGET-ID 200
      886      SPACE(0.00) SKIP(0.04)
      887      WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      888      SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      889      TITLE "Функции":L.
      890   ASSIGN
      891      FRAME f-c-p:SCROLLABLE = FALSE.
      892   ON GO OF FRAME f-c-p
      893   DO:
      894   END.
      895   ON CHOOSE OF b-chiled IN FRAME f-c-p
      896      DO:
      897         define buffer b-code for code.
      898         if not avail buf-code then return.
      899         find first b-code of buf-code no-lock no-error.
      900         if avail b-code then do:
      901            v-rid = recid(b-code).
      902            define variable vProcNextLevel as character no-undo init "ref/cashparam.w".
      903            define variable vListRecId as character no-undo.
      904            run value(vProcNextLevel) (
      905                                     input parparentproc
      906                                   , input iMode
      907                                   , input b-code.parent
      908                                   , input b-code.code
      909                                   , input ?
      910                                   ).
      911            if ri <> ? then  do:
      912                     reposition BROWSE-Code to recid ri.
      913                     apply "ENTRY" to BROWSE-Code.
      914            end.
      915         end.
      916      END.
      917   on mouse-select-dblclick of BROWSE-Code in frame f-c-p
      918   or return of b-chiled in frame f-c-p
      919   do:
      920     apply "choose" to b-chiled in frame f-c-p.
      921   end.
      922   on ENTER of mSearch in frame f-c-p
      923   do:
      924         define buffer buf-code-search for ub.code.
      925      assign
      926        msearch
      927      .
      928      define variable vRec as recid no-undo init ?.
      929      block-code:
      930      for each buf-code-search where buf-code-search.parent = b2-code.parent + chr(4) + b2-code.code
      931      no-lock:
      932         if               buf-code-search.code  begins msearch
      933            or getKeyName(buf-code-search.code) begins msearch
      934         then do:
      935            vRec = recid(buf-code-search).
      936            leave block-code.
      937         end.
      938      end.
      939         if vRec eq ?
      940      then do:
      941         message "Запись не найдена"
      942         view-as alert-box.
      943      end.
      944      else do:
      945         OPEN QUERY BROWSE-Code FOR EACH buf-code       where buf-code.parent = b2-code.parent + chr(4) + b2-code.code   NO-LOCK by buf-code.status_ by buf-code.code INDEXED-REPOSITION.
      946         reposition BROWSE-Code to recid vRec no-error .
      947         apply "ENTRY" to BROWSE-Code.
      948      end.
      949   end.
      950   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME f-c-p:PARENT eq ?
      951      THEN FRAME f-c-p:PARENT = ACTIVE-WINDOW.
      952   ON WINDOW-CLOSE OF FRAME f-c-p
      953      APPLY "END-ERROR":U TO SELF.
      954   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      955   on help of frame f-c-p
      956   do:
      957     run gbl/app_help.p
      958       (input this-procedure :file-name
      959       ,input ''
      960       ,input ?
      961       ) no-error.
      962     if error-status :error then do:
      963       message
      964         "Ошибка при вызове помощи"
      965         error-status :get-message(1)
      966         view-as alert-box .
      967     end.
      968   end.
      969   run minbtn-set in this-procedure .
      970   on choose of b-help in frame f-c-p
      971   do:
      972     apply "help":u to frame f-c-p .
      973   end.
      974   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      975   procedure minbtn-set :
      976       do
      977           on error undo, return error return-value
      978           :
      979           define variable ii              as integer       no-undo .
      980           define variable fh              as widget-handle no-undo .
      981           define variable hh              as widget-handle no-undo .
      982           define variable v-h             as handle        extent 4 no-undo .
      983           define variable v-name-button   as character     no-undo .
      984           define variable v-help-old-x    as decimal       no-undo .
      985           define variable v-help-old-y    as decimal       no-undo .
      986           define variable v-help-old-size as decimal       no-undo .
      987           define variable v-frame-width   as decimal       no-undo .
      988           define variable jj              as integer       no-undo .
      989           do
      990               on error undo, return error
      991               :
      992               assign
      993                   v-frame-width = frame f-c-p:width - 0.3
      994                   fh            = frame f-c-p:first-child
      995                   hh            = fh:first-child
      996                   ii            = 1
      997                   .
      998               do while valid-handle(hh):
      999                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1000                   do:
     1001                       case lc(hh:name) :
     1002                           when "b-help" then
     1003                               do:
     1004                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1005                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1006                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1007                                   hh:TOOLTIP = "Помощь" .
     1008                                   v-help-old-x = hh:column .
     1009                                   v-help-old-y = hh:row    .
     1010                                   v-help-old-size = hh:width .
     1011                                   hh:width-chars = 2.5 .
     1012                               end.
     1013                           when "b-print" then
     1014                               do:
     1015                                   hh:load-image("cmp/b-print.bmp":u) .
     1016                                   hh:TOOLTIP = "Печать" .
     1017                                   v-h[ii] = hh:handle .
     1018                                   ii = ii + 1 .
     1019                                   hh:width-chars = 3 .
     1020                               end.
     1021                           when "b-history" or
     1022                           when "b-hist" then
     1023                               do:
     1024                                   hh:load-image("cmp/b-hist.bmp":u) .
     1025                                   hh:TOOLTIP = "История" .
     1026                                   v-h[ii] = hh:handle .
     1027                                   ii = ii + 1 .
     1028                                   hh:width-chars = 3 .
     1029                               end.
     1030                           when "b-sch" then
     1031                               do:
     1032                                   hh:load-image("cmp/b-sch.bmp":u) .
     1033                                   hh:TOOLTIP = "Установка Фильтра" .
     1034                                   v-h[ii] = hh:handle .
     1035                                   ii = ii + 1 .
     1036                                   hh:width-chars = 3 .
     1037                               end.
     1038                           when "b-hist-user" then
     1039                               do:
     1040                                   hh:load-image("cmp/b-hist.bmp":u) .
     1041                                   hh:TOOLTIP = "История пользователя" .
     1042                                   ii = ii + 1 .
     1043                               end.
     1044                       end case.
     1045                   end.
     1046                   hh = hh:next-sibling.
     1047               end.
     1048               b-help:column = v-frame-width - b-help:width-chars.
     1049               jj = 0.
     1050               repeat ii = 4 to 1 by -1 :
     1051                   if valid-handle (v-h[ii] ) then
     1052                   do:
     1053                       jj  = jj + 1 .
     1054                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1055                       v-h[ii]:row    = v-help-old-y .
     1056                   end.
     1057               end.
     1058           end.
     1059       end.
     1060   end procedure.
     1061   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1062   define variable v-diasize-need-maximize        as logical   no-undo init true  .
