     1068   define variable v-diasize-resize-button        as handle    no-undo .
     1069   define variable v-diasize-wndmax               as logical   no-undo .
     1070   define variable v-diasize-wndstore             as logical   no-undo .
     1071   define variable v-diasize-proc-name            as character no-undo .
     1072   define variable v-diasize-browse-handle        as handle    no-undo .
