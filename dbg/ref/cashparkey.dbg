     1087   .
     1088   procedure diasize_change-height :
     1089     define input  parameter p-change-value  as decimal   no-undo .
     1090     define input  parameter p-move-resize   as logical   no-undo .
     1091     define variable v-field-group-handle    as handle    no-undo .
     1092     define variable v-object-handle         as handle    no-undo .
     1093     define variable v-frame-height          as decimal   no-undo .
     1094     define variable v-frame-virtual-height  as decimal   no-undo .
     1095     define variable v-browse-height         as decimal   no-undo .
     1096     define variable v-window-height         as decimal   no-undo .
     1097     define variable v-window-virtual-height as decimal   no-undo .
     1098     define variable v-change-sign           as integer   no-undo .
     1099     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1100     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1101     if p-change-value > 0
     1102     then do:
     1103       if frame f-c-p :height + p-change-value
     1104           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1105       then do:
     1106         assign
     1107           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1108                           - (frame f-c-p :height-chars)
     1109         .
     1110         if p-change-value <= 0
     1111         then do:
     1112           run diasize_position-resize-button in this-procedure .
     1113           return .
     1114         end.
     1115       end.
     1116     end.
     1117     if p-change-value < 0
     1118     then do:
     1119       if frame f-c-p :height + p-change-value < v-diasize-orig-frame-height
     1120       then do:
     1121         assign
     1122           p-change-value = v-diasize-orig-frame-height
     1123                          - (frame f-c-p :height-chars)
     1124         .
     1125         if p-change-value >= 0
     1126         then do:
     1127           run diasize_position-resize-button in this-procedure .
     1128           return .
     1129         end.
     1130       end.
     1131     end.
     1132     if p-change-value >= 0
     1133     then do:
     1134       assign
     1135         v-change-sign = 1
     1136       .
     1137     end.
     1138     else do:
     1139       assign
     1140         v-change-sign = -1
     1141       .
     1142     end.
     1143     assign
     1144       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1145     .
     1146     if p-change-value = 0
     1147     then do:
     1148       run diasize_position-resize-button in this-procedure .
     1149       return .
     1150     end.
     1151     move_block:
     1152     do
     1153     on error undo move_block, retry move_block
     1154     :
     1155       if retry
     1156       then do:
     1157         do
     1158         on error undo move_block, leave move_block
     1159         :
     1160           if p-change-value > 0
     1161           then do:
     1162             for each buf_temp-diasize-handle
     1163             on error undo, next
     1164             :
     1165               assign
     1166                 v-object-handle = buf_temp-diasize-handle.handle-value
     1167               .
     1168               if v-object-handle <> v-diasize-resize-button
     1169               then do:
     1170                 assign
     1171                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1172                 .
     1173               end.
     1174             end.
     1175             assign
     1176               v-diasize-browse-handle :height = v-browse-height
     1177             .
     1178             for each buf_temp-browse-handle
     1179               where buf_temp-browse-handle.browse-type = 'height':u
     1180             on error undo, next
     1181             :
     1182               assign
     1183                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1184               .
     1185             end.
     1186             assign
     1187               frame f-c-p :height = v-frame-height
     1188             .
     1189             if frame f-c-p :scrollable = true
     1190             then do:
     1191               assign
     1192                 frame f-c-p :virtual-height = v-frame-virtual-height
     1193               .
     1194             end.
     1195             run diasize_position-resize-button in this-procedure .
     1196           end.
     1197           else do:
     1198             if frame f-c-p :scrollable = true
     1199             then do:
     1200               assign
     1201                 frame f-c-p :virtual-height = v-frame-virtual-height
     1202               .
     1203             end.
     1204             assign
     1205               frame f-c-p :height = v-frame-height
     1206             .
     1207             assign
     1208               v-diasize-browse-handle :height = v-browse-height
     1209             .
     1210             for each buf_temp-browse-handle
     1211               where buf_temp-browse-handle.browse-type = 'height':u
     1212             on error undo, next
     1213             :
     1214               assign
     1215                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1216               .
     1217             end.
     1218             for each buf_temp-diasize-handle
     1219             on error undo, next
     1220             :
     1221               assign
     1222                 v-object-handle = buf_temp-diasize-handle.handle-value
     1223               .
     1224               if v-object-handle <> v-diasize-resize-button
     1225               then do:
     1226                 assign
     1227                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1228                 .
     1229               end.
     1230             end.
     1231             run diasize_position-resize-button in this-procedure .
     1232           end.
     1233           assign
     1234             v-diasize-change-size = false
     1235           .
     1236           leave move_block .
     1237         end.
     1238       end.
     1239       assign
     1240         v-diasize-need-full-display = true
     1241       .
     1242       if v-diasize-change-size = false
     1243       then do:
     1244         assign
     1245           v-diasize-change-size = true
     1246         .
     1247       end.
     1248       else do:
     1249         return .
     1250       end.
     1251       assign
     1252         v-frame-height = frame f-c-p :height
     1253         v-frame-virtual-height = frame f-c-p :virtual-height
     1254         v-browse-height = v-diasize-browse-handle :height
     1255       .
     1256       for each buf_temp-browse-handle
     1257         where buf_temp-browse-handle.browse-type = 'height':u
     1258       :
     1259         assign
     1260           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1261         .
     1262       end.
     1263       for each buf_temp-diasize-handle
     1264       :
     1265         delete buf_temp-diasize-handle .
     1266       end.
     1267       assign
     1268         v-field-group-handle = frame f-c-p :first-child
     1269       .
     1270       do while valid-handle(v-field-group-handle)
     1271       :
     1272         assign
     1273           v-object-handle = v-field-group-handle :first-child
     1274         .
     1275         do while valid-handle(v-object-handle)
     1276         :
     1277           if  v-object-handle <> v-diasize-browse-handle :handle
     1278           and can-query(v-object-handle, "row")
     1279           and can-query(v-object-handle, "height")
     1280           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1281           then do:
     1282             find first buf_temp-browse-handle
     1283               where buf_temp-browse-handle.browse-type   = 'height':u
     1284                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1285               no-error .
     1286             if available buf_temp-browse-handle
     1287             then do:
     1288             end.
     1289             else do:
     1290               create buf_temp-diasize-handle .
     1291               assign
     1292                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1293                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1294               .
     1295             end.
     1296           end.
     1297           assign
     1298             v-object-handle = v-object-handle :next-sibling
     1299           .
     1300         end.
     1301         assign
     1302           v-field-group-handle = v-field-group-handle :next-sibling
     1303         .
     1304       end.
     1305       do with frame f-c-p
     1306       :
     1307         hide v-diasize-resize-button .
     1308         assign
     1309           v-diasize-resize-button :row    = 1
     1310           v-diasize-resize-button :column = 1
     1311         .
     1312       end.
     1313       if p-change-value > 0
     1314       then do:
     1315         if frame f-c-p :scrollable = true
     1316         then do:
     1317           assign
     1318             frame f-c-p :virtual-height = frame f-c-p :virtual-height + p-change-value
     1319             no-error .
     1320           if error-status :error
     1321           or error-status :get-message(1) <> ""
     1322           then do:
     1323             undo move_block, retry move_block .
     1324           end.
     1325         end.
     1326         assign
     1327           frame f-c-p :height = frame f-c-p :height + p-change-value
     1328           no-error .
     1329         if error-status :error
     1330         or error-status :get-message(1) <> ""
     1331         then do:
     1332           undo move_block, retry move_block .
     1333         end.
     1334         assign
     1335           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1336           no-error .
     1337         if error-status :error
     1338         or error-status :get-message(1) <> ""
     1339         then do:
     1340           undo move_block, retry move_block .
     1341         end.
     1342         for each buf_temp-browse-handle
     1343           where buf_temp-browse-handle.browse-type = 'height':u
     1344         on error undo move_block, retry move_block
     1345         :
     1346           assign
     1347             buf_temp-browse-handle.browse-handle :height
     1348               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1349             no-error .
     1350           if error-status :error
     1351           or error-status :get-message(1) <> ""
     1352           then do:
     1353             undo move_block, retry move_block .
     1354           end.
     1355         end.
     1356         for each buf_temp-diasize-handle
     1357         on error undo move_block, retry move_block
     1358         :
     1359           assign
     1360             v-object-handle = buf_temp-diasize-handle.handle-value
     1361           .
     1362           if v-object-handle <> v-diasize-resize-button
     1363           then do:
     1364             assign
     1365               v-object-handle :row = v-object-handle :row + p-change-value
     1366               no-error .
     1367             if error-status :error
     1368             or error-status :get-message(1) <> ""
     1369             then do:
     1370               undo move_block, retry move_block .
     1371             end.
     1372           end.
     1373         end.
     1374       end.
     1375       else do:
     1376         for each buf_temp-diasize-handle
     1377         on error undo move_block, retry move_block
     1378         :
     1379           assign
     1380             v-object-handle = buf_temp-diasize-handle.handle-value
     1381           .
     1382           if v-object-handle <> v-diasize-resize-button
     1383           then do:
     1384             assign
     1385               v-object-handle :row = v-object-handle :row + p-change-value
     1386               no-error .
     1387             if error-status :error
     1388             or error-status :get-message(1) <> ""
     1389             then do:
     1390               undo move_block, retry move_block .
     1391             end.
     1392           end.
     1393         end.
     1394         assign
     1395           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1396           no-error .
     1397         if error-status :error
     1398         or error-status :get-message(1) <> ""
     1399         then do:
     1400           undo move_block, retry move_block .
     1401         end.
     1402         for each buf_temp-browse-handle
     1403           where buf_temp-browse-handle.browse-type = 'height':u
     1404         on error undo move_block, retry move_block
     1405         :
     1406           assign
     1407             buf_temp-browse-handle.browse-handle :height
     1408               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1409             no-error .
     1410           if error-status :error
     1411           or error-status :get-message(1) <> ""
     1412           then do:
     1413             undo move_block, retry move_block .
     1414           end.
     1415         end.
     1416         assign
     1417           frame f-c-p :height = frame f-c-p :height + p-change-value
     1418           no-error .
     1419         if error-status :error
     1420         or error-status :get-message(1) <> ""
     1421         then do:
     1422           undo move_block, retry move_block .
     1423         end.
     1424         if frame f-c-p :scrollable = true
     1425         then do:
     1426           assign
     1427             frame f-c-p :virtual-height = frame f-c-p :virtual-height + p-change-value
     1428             no-error .
     1429           if error-status :error
     1430           or error-status :get-message(1) <> ""
     1431           then do:
     1432             undo move_block, retry move_block .
     1433           end.
     1434         end.
     1435       end.
     1436       if p-move-resize = true
     1437       then do:
     1438         run diasize_position-resize-button in this-procedure .
     1439       end.
     1440       if v-diasize-wndstore = true
     1441       then do:
     1442         if connected("ub") = true
     1443         then do:
     1444           define variable v-cntxt-db-num        as integer   no-undo .
     1445           define variable v-cntxt-userid        as character no-undo .
     1446           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1447                                             , OUTPUT v-cntxt-userid
     1448                                             ) .
     1449           run gbl/wndsizew.p
     1450             (input  v-cntxt-db-num
     1451             ,input  v-cntxt-userid
     1452             ,input  v-diasize-proc-name
     1453             ,input  'height':u
     1454             ,input  string(frame f-c-p :height - v-diasize-orig-frame-height)
     1455             ) .
     1456         end.
     1457       end.
     1458     end.
     1459     assign
     1460       v-diasize-change-size = false
     1461     .
     1462   end procedure.
     1463   procedure diasize_set-height :
     1464     define input  parameter p-new-height  as decimal   no-undo .
     1465     define input  parameter p-move-resize as logical   no-undo .
     1466     do
     1467     on error undo, return error return-value
     1468     :
     1469       run diasize_change-height in this-procedure
     1470         (input  (p-new-height - frame f-c-p :height)
     1471         ,input  p-move-resize
     1472         ) .
     1473     end.
     1474   end procedure.
     1475   procedure diasize_change-width :
     1476     define input  parameter p-change-value as decimal   no-undo .
     1477     define input  parameter p-move-resize  as logical   no-undo .
     1478     define variable v-field-group-handle   as handle    no-undo .
     1479     define variable v-object-handle        as handle    no-undo .
     1480     define variable v-frame-width          as decimal   no-undo .
     1481     define variable v-frame-virtual-width  as decimal   no-undo .
     1482     define variable v-browse-width         as decimal   no-undo .
     1483     define variable v-window-width         as decimal   no-undo .
     1484     define variable v-window-virtual-width as decimal   no-undo .
     1485     define variable v-change-sign          as integer   no-undo .
     1486     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1487     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1488     if p-change-value > 0
     1489     then do:
     1490       if frame f-c-p :width + p-change-value >
     1491           session :width-chars
     1492       then do:
     1493         assign
     1494           p-change-value = session :width-chars - frame f-c-p :width
     1495         .
     1496         if p-change-value <= 0
     1497         then do:
     1498           run diasize_position-resize-button in this-procedure .
     1499           return .
     1500         end.
     1501       end.
     1502     end.
     1503     if p-change-value < 0
     1504     then do:
     1505       if frame f-c-p :width + p-change-value < v-diasize-orig-frame-width
     1506       then do:
     1507         assign
     1508           p-change-value = v-diasize-orig-frame-width
     1509                          - frame f-c-p :width
     1510         .
     1511         if p-change-value >= 0
     1512         then do:
     1513           run diasize_position-resize-button in this-procedure .
     1514           return .
     1515         end.
     1516       end.
     1517     end.
     1518     if p-change-value >= 0
     1519     then do:
     1520       assign
     1521         v-change-sign = 1
     1522       .
     1523     end.
     1524     else do:
     1525       assign
     1526         v-change-sign = -1
     1527       .
     1528     end.
     1529     assign
     1530       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1531     .
     1532     if p-change-value = 0
     1533     then do:
     1534       run diasize_position-resize-button in this-procedure .
     1535       return .
     1536     end.
     1537     move_block:
     1538     do
     1539     on error undo move_block, leave move_block
     1540     :
     1541       if retry
     1542       then do:
     1543         do
     1544         on error undo move_block, leave move_block
     1545         :
     1546           if p-change-value > 0
     1547           then do:
     1548             for each buf_temp-diasize-handle
     1549             on error undo, next
     1550             :
     1551               assign
     1552                 v-object-handle = buf_temp-diasize-handle.handle-value
     1553               .
     1554               if v-object-handle <> v-diasize-resize-button
     1555               then do:
     1556                 assign
     1557                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1558                 .
     1559               end.
     1560             end.
     1561             assign
     1562               v-diasize-browse-handle :width = v-browse-width
     1563             .
     1564             for each buf_temp-browse-handle
     1565               where buf_temp-browse-handle.browse-type = 'width':u
     1566             on error undo, next
     1567             :
     1568               assign
     1569                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1570               .
     1571             end.
     1572             assign
     1573               frame f-c-p :width = v-frame-width
     1574             .
     1575             if frame f-c-p :scrollable = true
     1576             then do:
     1577               assign
     1578                 frame f-c-p :virtual-width = v-frame-virtual-width
     1579               .
     1580             end.
     1581             run diasize_position-resize-button in this-procedure .
     1582           end.
     1583           else do:
     1584             if frame f-c-p :scrollable = true
     1585             then do:
     1586               assign
     1587                 frame f-c-p :virtual-width = v-frame-virtual-width
     1588               .
     1589             end.
     1590             assign
     1591               frame f-c-p :width = v-frame-width
     1592             .
     1593             for each buf_temp-browse-handle
     1594               where buf_temp-browse-handle.browse-type = 'width':u
     1595             on error undo, next
     1596             :
     1597               assign
     1598                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1599               .
     1600             end.
     1601             assign
     1602               v-diasize-browse-handle :width = v-browse-width
     1603             .
     1604             for each buf_temp-diasize-handle
     1605             on error undo, next
     1606             :
     1607               assign
     1608                 v-object-handle = buf_temp-diasize-handle.handle-value
     1609               .
     1610               if v-object-handle <> v-diasize-resize-button
     1611               then do:
     1612                 assign
     1613                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1614                 .
     1615               end.
     1616             end.
     1617             run diasize_position-resize-button in this-procedure .
     1618           end.
     1619           assign
     1620             v-diasize-change-size = false
     1621           .
     1622           leave move_block .
     1623         end.
     1624       end.
     1625       assign
     1626         v-diasize-need-full-display = true
     1627       .
     1628       if v-diasize-change-size = false
     1629       then do:
     1630         assign
     1631           v-diasize-change-size = true
     1632         .
     1633       end.
     1634       else do:
     1635         return .
     1636       end.
     1637       assign
     1638         v-frame-width = frame f-c-p :width
     1639         v-frame-virtual-width = frame f-c-p :virtual-width
     1640         v-browse-width = v-diasize-browse-handle :width
     1641       .
     1642       for each buf_temp-browse-handle
     1643         where buf_temp-browse-handle.browse-type = 'width':u
     1644       :
     1645         assign
     1646           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1647         .
     1648       end.
     1649       for each buf_temp-diasize-handle
     1650       :
     1651         delete buf_temp-diasize-handle .
     1652       end.
     1653       assign
     1654         v-field-group-handle = frame f-c-p :first-child
     1655       .
     1656       do while valid-handle(v-field-group-handle)
     1657       :
     1658         assign
     1659           v-object-handle = v-field-group-handle :first-child
     1660         .
     1661         do while valid-handle(v-object-handle)
     1662         :
     1663           if  v-object-handle <> v-diasize-browse-handle :handle
     1664           and v-object-handle <> v-diasize-resize-button
     1665           and can-query(v-object-handle, "row")
     1666           and can-query(v-object-handle, "height")
     1667           and ( v-object-handle :col + v-object-handle :width
     1668                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1669               )
     1670           then do:
     1671             find first buf_temp-browse-handle
     1672               where buf_temp-browse-handle.browse-type   = 'width':u
     1673                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1674               no-error .
     1675             if available buf_temp-browse-handle
     1676             then do:
     1677             end.
     1678             else do:
     1679               create buf_temp-diasize-handle .
     1680               assign
     1681                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1682                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1683               .
     1684             end.
     1685           end.
     1686           assign
     1687             v-object-handle = v-object-handle :next-sibling
     1688           .
     1689         end.
     1690         assign
     1691           v-field-group-handle = v-field-group-handle :next-sibling
     1692         .
     1693       end.
     1694       do with frame f-c-p
     1695       :
     1696         hide v-diasize-resize-button .
     1697         v-diasize-resize-button :row = 1.
     1698         v-diasize-resize-button :column = 1.
     1699       end.
     1700       if p-change-value > 0
     1701       then do:
     1702         if frame f-c-p :scrollable = true
     1703         then do:
     1704           assign
     1705             frame f-c-p :virtual-width = frame f-c-p :virtual-width + p-change-value
     1706             no-error .
     1707           if error-status :error
     1708           or error-status :get-message(1) <> ""
     1709           then do:
     1710             undo move_block, retry move_block.
     1711           end.
     1712         end.
     1713         assign
     1714           frame f-c-p :width = v-frame-width + p-change-value
     1715           no-error .
     1716         if error-status :error
     1717         or error-status :get-message(1) <> ""
     1718         then do:
     1719           undo move_block, retry move_block.
     1720         end.
     1721         assign
     1722           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1723         no-error .
     1724         if error-status :error
     1725         or error-status :get-message(1) <> ""
     1726         then do:
     1727           undo move_block, retry move_block.
     1728         end.
     1729         for each buf_temp-browse-handle
     1730           where buf_temp-browse-handle.browse-type = 'width':u
     1731         on error undo move_block, retry move_block
     1732         :
     1733           assign
     1734             buf_temp-browse-handle.browse-handle :width
     1735               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1736             no-error .
     1737           if error-status :error
     1738           or error-status :get-message(1) <> ""
     1739           then do:
     1740             undo move_block, retry move_block .
     1741           end.
     1742         end.
     1743         for each buf_temp-diasize-handle
     1744         on error undo move_block, retry move_block
     1745         :
     1746           assign
     1747             v-object-handle = buf_temp-diasize-handle.handle-value
     1748           .
     1749           if v-object-handle <> v-diasize-resize-button
     1750           then do:
     1751             assign
     1752               v-object-handle :col = v-object-handle :col + p-change-value
     1753               no-error .
     1754             if error-status :error
     1755             or error-status :get-message(1) <> ""
     1756             then do:
     1757               undo move_block, retry move_block .
     1758             end.
     1759           end.
     1760         end.
     1761       end.
     1762       else do:
     1763         for each buf_temp-diasize-handle
     1764         on error undo move_block, retry move_block
     1765         :
     1766           assign
     1767             v-object-handle = buf_temp-diasize-handle.handle-value
     1768           .
     1769           if v-object-handle <> v-diasize-resize-button
     1770           then do:
     1771             assign
     1772               v-object-handle :col = v-object-handle :col + p-change-value
     1773               no-error .
     1774             if error-status :error
     1775             or error-status :get-message(1) <> ""
     1776             then do:
     1777               undo move_block, retry move_block .
     1778             end.
     1779           end.
     1780         end.
     1781         for each buf_temp-browse-handle
     1782           where buf_temp-browse-handle.browse-type = 'width':u
     1783         on error undo move_block, retry move_block
     1784         :
     1785           assign
     1786             buf_temp-browse-handle.browse-handle :width
     1787               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1788             no-error .
     1789           if error-status :error
     1790           or error-status :get-message(1) <> ""
     1791           then do:
     1792             undo move_block, retry move_block .
     1793           end.
     1794         end.
     1795         assign
     1796           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1797           no-error .
     1798         if error-status :error
     1799         or error-status :get-message(1) <> ""
     1800         then do:
     1801           undo move_block, retry move_block.
     1802         end.
     1803         assign
     1804           frame f-c-p :width = frame f-c-p :width + p-change-value
     1805         no-error .
     1806         if error-status :error
     1807         or error-status :get-message(1) <> ""
     1808         then do:
     1809           undo move_block, retry move_block.
     1810         end.
     1811         if frame f-c-p :scrollable = true
     1812         then do:
     1813           assign
     1814             frame f-c-p :virtual-width = frame f-c-p :virtual-width + p-change-value
     1815           no-error .
     1816           if error-status :error
     1817           or error-status :get-message(1) <> ""
     1818           then do:
     1819             undo move_block, retry move_block.
     1820           end.
     1821         end.
     1822       end.
     1823       if p-move-resize
     1824       then do:
     1825         run diasize_position-resize-button in this-procedure .
     1826       end.
     1827       if v-diasize-wndstore = true
     1828       then do:
     1829         if connected("ub") = true
     1830         then do:
     1831           define variable v-cntxt-db-num        as integer   no-undo .
     1832           define variable v-cntxt-userid        as character no-undo .
     1833           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1834                                             , OUTPUT v-cntxt-userid
     1835                                             ) .
     1836           run gbl/wndsizew.p
     1837             (input  v-cntxt-db-num
     1838             ,input  v-cntxt-userid
     1839             ,input  v-diasize-proc-name
     1840             ,input  'width':u
     1841             ,input  string(frame f-c-p :width - v-diasize-orig-frame-width)
     1842             ) .
     1843         end.
     1844       end.
     1845     end.
     1846     assign
     1847       v-diasize-change-size = false
     1848     .
     1849   end procedure.
     1850   procedure diasize_set-width :
     1851     define input  parameter p-new-width  as decimal   no-undo .
     1852     define input  parameter p-move-resize as logical   no-undo .
     1853     do
     1854     on error undo, return error return-value
     1855     :
     1856       run diasize_change-width in this-procedure
     1857         (input  (p-new-width - frame f-c-p :width)
     1858         ,input  p-move-resize
     1859         ) .
     1860     end.
     1861   end procedure.
     1862   procedure diasize_position-resize-button :
     1863     do with frame f-c-p
     1864     :
     1865       hide v-diasize-resize-button .
     1866       assign
     1867         v-diasize-resize-button :row = frame f-c-p :height - v-diasize-resize-button :height
     1868                     - 1
     1869                     - (frame f-c-p :border-bottom-pixels / session :pixels-per-row)
     1870         v-diasize-resize-button :col = frame f-c-p :width - v-diasize-resize-button :width
     1871                     - 1
     1872                     - (frame f-c-p :border-right-pixels / session :pixels-per-column)
     1873       .
     1874       view v-diasize-resize-button .
     1875     end.
     1876   end procedure.
     1877   on alt-right anywhere
     1878   do:
     1879     run diasize_change-width in this-procedure
     1880       (input 1
     1881       ,input true
     1882       ) .
     1883     return no-apply .
     1884   end.
     1885   on alt-left anywhere
     1886   do:
     1887     run diasize_change-width in this-procedure
     1888       (input -1
     1889       ,input true
     1890       ) .
     1891     return no-apply .
     1892   end.
     1893   on alt-down anywhere
     1894   do:
     1895     run diasize_change-height in this-procedure
     1896       (input 1
     1897       ,input true
     1898       ) .
     1899     return no-apply .
     1900   end.
     1901   on alt-up anywhere
     1902   do:
     1903     run diasize_change-height in this-procedure
     1904       (input -1
     1905       ,input true
     1906       ) .
     1907     return no-apply .
     1908   end.
     1909   on alt-enter of frame f-c-p
     1910   do:
     1911     run diasize_maximize in this-procedure
     1912       (input  ?
     1913       ).
     1914     return no-apply .
     1915   end.
     1916   procedure diasize_end-move :
     1917     do
     1918     on error undo, return error return-value
     1919     :
     1920       define variable v-row-delta as decimal   no-undo .
     1921       define variable v-col-delta as decimal   no-undo .
     1922       define variable v-new-row as decimal   no-undo .
     1923       define variable v-new-col as decimal   no-undo .
     1924       assign
     1925         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1926         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1927       .
     1928       assign
     1929         v-row-delta = v-new-row - frame f-c-p :height
     1930         v-col-delta = v-new-col - frame f-c-p :width
     1931       .
     1932       run diasize_change-height in this-procedure
     1933         (input v-row-delta
     1934         ,input true
     1935         ) .
     1936       run diasize_change-width in this-procedure
     1937         (input v-col-delta
     1938         ,input true
     1939         ) .
     1940     end.
     1941   end procedure.
     1942   procedure diasize_maximize :
     1943     define input  parameter p-action as logical   no-undo .
     1944     do
     1945     on error undo, return error return-value
     1946     :
     1947       if p-action = ?
     1948       then do:
     1949         if v-diasize-need-maximize = true
     1950         then do:
     1951           assign
     1952             p-action = true
     1953           .
     1954         end.
     1955         else do:
     1956           assign
     1957             p-action = false
     1958           .
     1959         end.
     1960       end.
     1961       if p-action = true
     1962       then do:
     1963         run diasize_change-height in this-procedure
     1964           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1965               - frame f-c-p :height-chars
     1966           ,input true
     1967           ) .
     1968         run diasize_change-width in this-procedure
     1969           (input session :width-chars
     1970               - frame f-c-p :width-chars
     1971           ,input true
     1972           ) .
     1973         assign
     1974           v-diasize-need-maximize = false
     1975         .
     1976       end.
     1977       else do:
     1978         run diasize_change-width in this-procedure
     1979           (input v-diasize-orig-frame-width
     1980               - frame f-c-p :width-chars
     1981           ,input true
     1982           ) .
     1983         run diasize_change-height in this-procedure
     1984           (input v-diasize-orig-frame-height
     1985               - frame f-c-p :height-chars
     1986           ,input true
     1987           ) .
     1988         assign
     1989           v-diasize-need-maximize = true
     1990         .
     1991       end.
     1992     end.
     1993   end procedure.
     1994   procedure diasize_restore-orig-size :
     1995     do
     1996     on error undo, return error return-value
     1997     :
     1998       assign
     1999         v-diasize-current-frame-width  = frame f-c-p :width
     2000         v-diasize-current-frame-height = frame f-c-p :height
     2001       .
     2002       run diasize_set-height in this-procedure
     2003         (input  v-diasize-orig-frame-height
     2004         ,input  true
     2005         ) .
     2006       run diasize_set-width in this-procedure
     2007         (input  v-diasize-orig-frame-width
     2008         ,input  true
     2009         ) .
     2010     end.
     2011   end procedure.
     2012   procedure diasize_restore-current-size :
     2013     do
     2014     on error undo, return error return-value
     2015     :
     2016       run diasize_set-height in this-procedure
     2017         (input  v-diasize-current-frame-height
     2018         ,input  true
     2019         ) .
     2020       run diasize_set-width in this-procedure
     2021         (input  v-diasize-current-frame-width
     2022         ,input  true
     2023         ) .
     2024     end.
     2025   end procedure.
     2026   procedure diasize_set-browse-handle :
     2027     define input  parameter p-browse-handle as handle   no-undo .
     2028     define buffer buf_temp-browse-handle for temp-browse-handle .
     2029     do
     2030     on error undo, return error return-value
     2031     :
     2032       assign
     2033         v-diasize-browse-handle = p-browse-handle
     2034       .
     2035       for each buf_temp-browse-handle
     2036       on error undo, return error return-value
     2037       :
     2038         delete buf_temp-browse-handle .
     2039       end.
     2040     end.
     2041   end procedure.
     2042   procedure diasize_add_browse :
     2043     define input  parameter p-browse-type   as character no-undo .
     2044     define input  parameter p-browse-handle as handle    no-undo .
     2045     define buffer buf_temp-browse-handle for temp-browse-handle .
     2046     do
     2047     on error undo, return error return-value
     2048     :
     2049       assign
     2050         v-diasize-browse-number = v-diasize-browse-number + 1
     2051       .
     2052       create buf_temp-browse-handle .
     2053       assign
     2054         buf_temp-browse-handle.browse-type   = p-browse-type
     2055         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2056         buf_temp-browse-handle.browse-handle = p-browse-handle
     2057       .
     2058     end.
     2059   end procedure.
     2060   procedure diasize_init :
     2061     define variable v-default-value    as logical   no-undo .
     2062     define variable v-restore-saved    as logical   no-undo .
     2063     define variable v-resize-value-str as character no-undo .
     2064     do
     2065     on error undo, return error return-value
     2066     :
     2067       do with frame f-c-p
     2068       :
     2069         assign
     2070           v-diasize-orig-frame-height = frame f-c-p :height
     2071           v-diasize-orig-frame-width  = frame f-c-p :width
     2072           v-diasize-browse-handle     = browse BROWSE-Code :handle
     2073         .
     2074         create button v-diasize-resize-button
     2075         assign
     2076           parent        = frame f-c-p :first-child
     2077           label         = "s"
     2078           height-pixels = 16
     2079           width-pixels  = 16
     2080           visible       = true
     2081           sensitive     = true
     2082           movable       = true
     2083           triggers:
     2084             on end-move persistent run diasize_end-move in this-procedure .
     2085           end triggers.
     2086         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2087         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2088         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2089         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2090         assign
     2091           v-diasize-wndmax = false
     2092         .
     2093         if connected("ub") = true
     2094         then do:
     2095           define variable v-cntxt-db-num        as integer   no-undo .
     2096           define variable v-cntxt-userid        as character no-undo .
     2097           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2098                                             , OUTPUT v-cntxt-userid
     2099                                             ) .
     2100           run gbl/wndpar_r.p
     2101             (input  v-cntxt-db-num
     2102             ,input  v-cntxt-userid
     2103             ,input  'wndmax':U
     2104             ,output v-diasize-wndmax
     2105             ,output v-default-value
     2106             ) .
     2107         end.
     2108         assign
     2109           v-diasize-wndstore = false
     2110         .
     2111         if connected("ub") = true
     2112         then do:
     2113           run gbl/wndpar_r.p
     2114             (input  v-cntxt-db-num
     2115             ,input  v-cntxt-userid
     2116             ,input  'wndstore':U
     2117             ,output v-diasize-wndstore
     2118             ,output v-default-value
     2119             ) .
     2120         end.
     2121         assign
     2122           v-diasize-proc-name = entry(1, program-name(2), '.')
     2123         .
     2124         if v-diasize-wndstore = true
     2125         then do:
     2126           assign
     2127             v-restore-saved = false
     2128           .
     2129           if connected("ub") = true
     2130           then do:
     2131             run gbl/wndsizer.p
     2132               (input  v-cntxt-db-num
     2133               ,input  v-cntxt-userid
     2134               ,input  v-diasize-proc-name
     2135               ,input  'height':u
     2136               ,output v-resize-value-str
     2137               ) .
     2138             if v-resize-value-str <> '':U
     2139             then do:
     2140               run diasize_change-height in this-procedure
     2141                 (input  integer(v-resize-value-str)
     2142                 ,input  true
     2143                 ) .
     2144               assign
     2145                 v-restore-saved = true
     2146               .
     2147             end.
     2148           end.
     2149           if connected("ub") = true
     2150           then do:
     2151             run gbl/wndsizer.p
     2152               (input  v-cntxt-db-num
     2153               ,input  v-cntxt-userid
     2154               ,input  v-diasize-proc-name
     2155               ,input  'width':u
     2156               ,output v-resize-value-str
     2157               ) .
     2158             if v-resize-value-str <> '':U
     2159             then do:
     2160               run diasize_change-width in this-procedure
     2161                 (input  integer(v-resize-value-str)
     2162                 ,input  true
     2163                 ) .
     2164               assign
     2165                 v-restore-saved = true
     2166               .
     2167             end.
     2168           end.
     2169           if v-restore-saved <> true
     2170           then do:
     2171             if v-diasize-wndmax = true
     2172             then do:
     2173               run diasize_maximize in this-procedure
     2174                 (input  true
     2175                 ) .
     2176             end.
     2177           end.
     2178         end.
     2179         else do:
     2180           if v-diasize-wndmax = true
     2181           then do:
     2182             run diasize_maximize in this-procedure
     2183               (input  true
     2184               ) .
     2185           end.
     2186         end.
     2187       end.
     2188     end.
     2189   end procedure.
     2190   procedure diasize_need-full-display :
     2191     define output parameter p-need-full-display as logical   no-undo .
     2192     do
     2193     on error undo, return error return-value
     2194     :
     2195       assign
     2196         p-need-full-display = v-diasize-need-full-display
     2197       .
     2198       assign
     2199         v-diasize-need-full-display = false
     2200       .
     2201     end.
     2202   end procedure.
     2203   procedure get-context :
     2204      define output parameter p-db-num as integer          no-undo.
     2205      define output parameter p-user-id as character        no-undo.
     2206      define variable v-login               as character    no-undo.
     2207      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2208      define buffer buf_user-login  for ub.user-login .
     2209      do
     2210      on error undo, return error
     2211      :
     2212            FIND FIRST buf_sys-ctrl no-lock.
     2213            ASSIGN
     2214               v-login = USERID("ub")
     2215               p-db-num = buf_sys-ctrl.db-num
     2216            .
     2217            FIND FIRST buf_user-login
     2218                 WHERE buf_user-login.db-num = p-db-num
     2219                   AND buf_user-login.user-login = v-login
     2220                 no-lock
     2221                 no-error
     2222                 .
     2223            IF AVAILABLE buf_user-login
     2224            THEN DO:
     2225               assign
     2226                  p-user-id = buf_user-login.user-id
     2227               .
     2228            END.
     2229      end.
     2230   end procedure.
     2231       run diasize_init in this-procedure .
     2232   MAIN-BLOCK:
     2233   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2234      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2235      run enable_UI in this-procedure .
     2236      apply "ENTRY" to BROWSE-Code.
     2237      WAIT-FOR GO OF FRAME f-c-p focus BROWSE-Code.
     2238   END.
     2239   run disable_UI in this-procedure .
     2240   PROCEDURE disable_UI :
     2241      HIDE FRAME f-c-p.
     2242   END PROCEDURE.
     2243   PROCEDURE enable_UI :
     2244      ENABLE
     2245         mSearch
     2246         BROWSE-Code
     2247         b-exit
     2248         b-chiled
     2249         WITH FRAME f-c-p.
     2250      OPEN QUERY BROWSE-Code FOR EACH buf-code       where buf-code.parent = b2-code.parent + chr(4) + b2-code.code   NO-LOCK by buf-code.status_ by buf-code.code INDEXED-REPOSITION.
     2251   END PROCEDURE.
     2252   FUNCTION getKeyName RETURNS CHARACTER
     2253      ( iCode as char):
     2254      define buffer code for ub.code.
     2255      find first code where code.parent eq "CashFunKey"
     2256                        and code.code   eq iCode
     2257      no-lock no-error.
     2258      return if available code then code.codename else "".
     2259   end.
