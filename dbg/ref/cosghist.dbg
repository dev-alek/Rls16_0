     3561           )
     3562                              else
     3563           (
     3564           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC  " +
     3565             " " + sort-column-phrase +
     3566           " " + sort-phrase-27
     3567           )
     3568         parameter-7-27 =
     3569           " indexed-reposition  "
     3570       .
     3571       do
     3572       on stop undo, leave
