     2960   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2961   on ' ' of sch-corr-date in frame Dialog-Frame
     2962   do:
     2963     if (can-query (self, "sensitive")
     2964        and
     2965        self :sensitive = true
     2966        )
     2967     or (can-query (self, "read-only")
     2968        and
     2969        self :read-only = false
     2970        )
     2971     then do:
     2972       assign
     2973         self :screen-value = ?
     2974       .
     2975     end.
     2976     return no-apply.
     2977   end.
     2978   on delete-character of sch-corr-date in frame Dialog-Frame
     2979   do:
     2980     if (can-query (self, "sensitive")
     2981        and
     2982        self :sensitive = true
     2983        )
     2984     or (can-query (self, "read-only")
     2985        and
     2986        self :read-only = false
     2987        )
     2988     then do:
     2989       assign
     2990         self :screen-value = ?
     2991       .
     2992     end.
     2993     return no-apply.
     2994   end.
     2995   on ctrl-d of sch-corr-date in frame Dialog-Frame
     2996   do:
     2997     define variable v-curr-sv-date as date no-undo .
     2998     if (can-query (self, "sensitive")
     2999        and
     3000        self :sensitive = true
     3001        )
     3002     or (can-query (self, "read-only")
     3003        and
     3004        self :read-only = false
     3005        )
     3006     then do:
     3007       if self :handle <> focus :handle
     3008       then do:
     3009         apply "entry":u to self .
     3010       end.
     3011       run gbl/getcurdt.p
