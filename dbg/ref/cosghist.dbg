      691   procedure prn-lib-open-stream :
      692     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      693     define input parameter p-page-size    as integer no-undo .
      694     define input parameter p-is-stream    as logical no-undo .
      695     define input parameter p-append       as logical no-undo .
      696     define variable v-report-name as character no-undo .
      697     do
      698       on error undo, return error
      699       :
      700       run prn-lib-get-report-name  in this-procedure (
      701         input parParentProc
      702         ,output v-report-name
      703         ).
      704       if p-is-stream then
      705       do:
      706         if p-append then
      707         do:
      708           output stream PrnLibStream to value( v-report-name )
      709             page-size value(p-page-size) append .
      710         end.
      711         if not p-append then
      712         do:
      713           output stream PrnLibStream to value( v-report-name )
      714             page-size value(p-page-size) .
      715         end.
      716       end.
      717       if not p-is-stream then
      718       do:
      719         if p-append then
      720         do:
      721           output to value( v-report-name )
      722             page-size value(p-page-size) append .
      723         end.
      724         if not p-append then
      725         do:
      726           output to value( v-report-name )
      727             page-size value(p-page-size) .
      728         end.
      729       end.
      730     end.
      731   end procedure.
      732   procedure prn-lib-open-exp :
      733     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      734     define input parameter p-is-stream    as logical no-undo .
      735     define input parameter p-is-append    as logical no-undo .
      736     define output parameter p-ReportFileName as char init "report" no-undo.
      737     define output parameter p-process as logical no-undo .
      738     define variable glog as logical no-undo .
      739     do
      740       on error undo, return error
      741       :
      742       SYSTEM-DIALOG GET-FILE p-ReportFileName
      743         TITLE      "Укажите путь"
      744         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      745         ASK-OVERWRITE
      746         CREATE-TEST-FILE
      747         SAVE-AS
      748         USE-FILENAME
      749         DEFAULT-EXTENSION "txt"
      750         UPDATE glog
      751         .
      752       if not glog then  return.
      753       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      754       if p-is-stream then
      755       do:
      756         if p-is-append then
      757         do:
      758           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      759         end.
      760         else
      761         do:
      762           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      763         end.
      764       end.
      765       else
      766       do:
      767         if p-is-append then
      768         do:
      769           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      770         end.
      771         else
      772         do:
      773           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      774         end.
      775       end.
      776       p-process = yes.
      777     end.
      778   end procedure.
