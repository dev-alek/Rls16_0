     3429   PROCEDURE MyEnable :
     3430   DEFINE VARIABLE v-h AS handle NO-UNDO.
     3431   assign
     3432   br-obj-hist:num-locked-columns in frame Dialog-Frame = 1
     3433   X_c-obj-hist.corr-date:read-only in browse br-obj-hist = yes
     3434   br-changes:title = "":U
     3435   v-corr-user-db-num = v-db-num
     3436   temp-changes.l_name:resizable in browse br-changes = true
     3437   temp-changes.v_old:resizable in browse br-changes = true
     3438   temp-changes.v_new:resizable in browse br-changes = true
     3439   temp-changes.l_name:width in browse br-changes = 30
     3440   temp-changes.v_old:width in browse br-changes = 40
     3441   temp-changes.v_new:width in browse br-changes = 40
     3442   v-h = br-obj-hist:FIRST-COLUMN IN FRAME Dialog-Frame
     3443   .
     3444   DO while valid-handle(v-h) :
     3445     if v-h:LABEL = "Предмет изменения"
     3446     or v-h:LABEL = "Изменил"
     3447       then do:
     3448       v-h:RESIZABLE = YES.
     3449     end.
     3450       v-h = v-h:NEXT-COLUMN.
     3451     END.
