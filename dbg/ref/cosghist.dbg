     3806   end.
     3807   else do:
     3808     assign
     3809       v-doc-rec = recid( X_c-obj-hist )
     3810     .
     3811     do
     3812     on stop undo, leave
     3813     on error undo, leave
     3814     :
     3815       if query br-obj-hist:handle:get-buffer-handle(1) = (buffer X_c-obj-hist:handle) then do:
     3816         assign
     3817         parameter-2-29 = (if p-find-next then "true":u else "false":u )
     3818         parameter-4-29 =
     3819           "where ":u + " TRUE " + " ":u + where-phrase-29 + " ":u + p-find-condition + " " + ""
     3820         parameter-5-29 = ""
     3821       .
     3822         run fltopend_fltfindd in this-procedure  (
     3823                             input this-procedure:handle
     3824                             ,input query br-obj-hist:handle
     3825                             ,input rowid(X_c-obj-hist)
     3826                             ,input logical(parameter-2-29)
     3827                             ,input no-lock
     3828                             ,input (buffer X_c-obj-hist:handle)
     3829                             ,input parameter-4-29
     3830                             ,input parameter-5-29
     3831                             ) no-error.
     3832         .
     3833         assign
     3834           v-doc-rec = integer(return-value)
     3835           v-fltopend-rowid[1] = ?
     3836         .
     3837       end.
     3838       else do:
     3839         assign
     3840         parameter-2-29 = (if p-find-next then "true":u else "false":u )
     3841         parameter-3-29 =  "FOR EACH X_c-obj-hist"
     3842         parameter-4-29 =
     3843           (
     3844             if (" TRUE " + " " + where-phrase-29) <> ""
     3845             then " TRUE " + " " + where-phrase-29
     3846             else "true"
     3847           )
     3848         parameter-5-29 = (" " + "" + " " + "" + " " + p-find-condition)
     3849         parameter-6-29 = if sort-phrase-29 = ''
     3850                              then
     3851           (
     3852           " " + "" +
     3853             " " + sort-column-phrase +
     3854           " " + "  "
     3855           )
     3856                              else
     3857           (
     3858           " " + "" +
     3859             " " + sort-column-phrase +
     3860           " " + sort-phrase-29
     3861           )
     3862         parameter-7-29 =
     3863           " indexed-reposition  "
     3864       .
     3865         run fltopend_fltfindq in this-procedure  (
     3866                             input this-procedure:handle
     3867                             ,input query br-obj-hist:handle
     3868                             ,input logical(parameter-2-29)
     3869                             ,input no-lock
     3870                             ,input parameter-3-29
     3871                             ,input parameter-4-29
     3872                             ,input parameter-5-29
     3873                             ,input parameter-6-29
     3874                             ,input parameter-7-29
     3875                             ,output v-fltopend-rowid
     3876                             ) no-error.
     3877         .
     3878         v-doc-rec = ?.
     3879       end.
     3880       assign
     3881         l-query-was-opened = true
     3882       .
     3883     end.
     3884   end.
     3885     run waitfram-hide in this-procedure .
     3886     end.
     3887   end.
     3888   if not p-open-query and v-doc-rec <> ? then
     3889   REPOSITION br-obj-hist to recid v-doc-rec No-ERROR.
     3890   if not p-open-query and v-fltopend-rowid[1] <> ? then
     3891   query br-obj-hist:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     3892   run waitfram-hide in this-procedure .
     3893   APPLY "VALUE-CHANGED" TO br-obj-hist in frame Dialog-Frame.
     3894   APPLY "ENTRY" TO br-obj-hist.
     3895   END PROCEDURE.
     3896   PROCEDURE proc-b-print :
     3897   define variable date_string     as      char    no-undo.
     3898   define variable Line                as      char    no-undo.
     3899   define variable for-time as char.
     3900   define variable accum-count as integer.
     3901   define variable v-doc-rec as recid no-undo.
     3902   define variable v-subject-chr as character no-undo .
     3903   define variable v-upd-time as character no-undo .
     3904   define variable v-obj as character no-undo .
     3905   define variable v-action-chr as character no-undo .
     3906   define variable v-source-type as character no-undo .
     3907   DEFINE FRAME HistoryList
     3908   v-action-chr FORMAT "X(10)" COLUMN-LABEL "Действие"
     3909   X_c-obj-hist.corr-date
     3910   v-upd-time COLUMN-LABEL "Время изм." FORMAT "X(8)"
     3911   X_c-obj-hist.corr-user-name
     3912   X_c-obj-hist.corr-user-db-num
     3913   HEADER  date_string AT 5 format "X(35)"
     3914   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     3915   Line format "X(195)" AT 1
     3916   with width 232 down stream-io use-text    .
     3917   Line = fill("-", 195).
     3918   date_string = cur-time-print() .
     3919   assign
     3920   v-doc-rec = recid( X_c-obj-hist ).
     3921   DO WHILE available X_c-obj-hist :
     3922         GET prev br-obj-hist.
     3923   END.
     3924   run prn-lib-open-stream  in this-procedure (
     3925                                                input parparentProc
     3926                                               ,input 43
     3927                                               ,input yes
     3928                                               ,input no
     3929                                               ).
     3930   PUT  STREAM PrnLibStream
     3931   SPACE(25) ( frame Dialog-Frame:title )
     3932   format "x(90)" SKIP(1) .
     3933   FORM HEADER
     3934   Line format "X(180)" AT 1 SKIP
     3935   "Продолжение - на следующей странице" AT 30 SKIP
     3936   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3937   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     3938   FORM with FRAME HistoryList  .
     3939   run waitfram-show in this-procedure ("Ждите...").
     3940     GET next br-obj-hist.
     3941       DO WHILE available X_c-obj-hist :
     3942         Display STREAM PrnLibStream
     3943          get-action(X_c-obj-hist.action) @ v-action-chr
     3944         X_c-obj-hist.corr-date
     3945         string(X_c-obj-hist.corr-time, "HH:MM:SS":U) @ v-upd-time
     3946         X_c-obj-hist.corr-user-name
     3947         X_c-obj-hist.corr-user-db-num
     3948         with FRAME HistoryList .
     3949     DOWN STREAM PrnLibStream 1 with FRAME HistoryList  .
     3950     assign
     3951     accum-count = accum-count + 1
     3952     .
     3953     GET next br-obj-hist.
     3954   END.
     3955   UNDERLINE  STREAM PrnLibStream
     3956   v-action-chr
     3957   v-subject-chr
     3958   X_c-obj-hist.corr-date
     3959   v-upd-time
     3960   X_c-obj-hist.corr-user-name
     3961   X_c-obj-hist.corr-user-db-num
     3962   with FRAME HistoryList .
     3963   DISPLAY STREAM PrnLibStream
     3964   "ИТОГО"  @ v-obj
     3965   string(accum-count)  @ v-action-chr
     3966   with frame HistoryList.
     3967   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     3968   HIDE  STREAM PrnLibStream FRAME CheckList.
     3969   output  STREAM PrnLibStream CLOSE.
     3970   run waitfram-hide in this-procedure.
     3971   run prn-lib-prn-file in this-procedure (
     3972                                             input parparentproc
     3973                                             ,input 8
     3974                                             ).
     3975   reposition br-obj-hist to recid v-doc-rec no-error.
     3976   apply "entry" to br-obj-hist in frame Dialog-Frame.
     3977   END PROCEDURE.
     3978   PROCEDURE proc-b-sch :
     3979   assign
     3980     tbl = "c-goods-attr-any"
     3981     join-tbl = 'X_c-obj-hist'
     3982     fld = ""
     3983     lab = ""
     3984     spr = ""
     3985     dim = '0'
     3986     .
     3987   run fltfield-add in this-procedure('corr-date', 'Дата корр.', '',
     3988   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3989   run fltfield-add in this-procedure('corr-time', 'Время корр.', 'time',
     3990   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3991   run fltfield-add in this-procedure('corr-user-db-num', 'БД корр.', '',
     3992   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3993   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     3994   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3995   run fltfield-add in this-procedure('action', 'Действие', 'hist-action',
     3996   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3997   Filter-Block:
     3998   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     3999       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4000       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4001     run gbl/filter.w ( INPUT parparentproc
     4002                      , INPUT filter-point + chr(4) + filter-label
     4003                      , INPUT tbl
     4004                      , INPUT join-tbl
     4005                      , INPUT fld
     4006                      , INPUT lab
     4007                      , INPUT spr
     4008                      , INPUT dim ).
     4009     RUN OpenBr in this-procedure ( input yes, input no, input '':U, input v-corr-user-db-num).
     4010   END.
     4011   END PROCEDURE.
     4012   PROCEDURE proc-find-corr-date :
     4013   define input parameter p-next as logical no-undo.
     4014   define input parameter p-date like ub.fin-doc.doc-date no-undo.
     4015   define variable v-date-chr as character no-undo.
     4016   if p-date = ? then return .
     4017   display
     4018   0 @ sch-obj-code
     4019   0 @ sch-db-num
     4020   "":U @ sch-corr-user-name
     4021   with frame Dialog-Frame.
     4022   assign
     4023   v-date-chr = string(day(p-date)) + chr(47) +
     4024                    string(month(p-date)) + chr(47) +
     4025                    string(year(p-date)).
     4026          run OpenBr in this-procedure
     4027           (input false
     4028           ,input true
     4029           ,input substitute("and X_c-obj-hist.corr-date = &1 "
     4030             , v-date-chr)
     4031           ,input v-corr-user-db-num
     4032           ).
     4033         apply "entry":u to sch-corr-date in frame Dialog-Frame.
     4034   END PROCEDURE.
     4035   PROCEDURE proc-find-db-num :
     4036   define input parameter p-next as logical no-undo.
     4037   define input parameter p-db-num like c-goods-attr-any.corr-user-db-num no-undo.
     4038   define variable v-db-num as character no-undo.
     4039   assign
     4040   sch-corr-date = ?
     4041   .
     4042   display
     4043   "":U @ sch-corr-user-name
     4044   0 @ sch-obj-code
     4045   sch-corr-date
     4046   with frame Dialog-Frame.
     4047   assign
     4048   v-db-num = string(p-db-num).
     4049   run OpenBr in this-procedure
     4050       (input false
     4051       ,input p-next
     4052       ,input substitute("and X_c-obj-hist.corr-user-db-num = &1 "
     4053         , v-db-num)
     4054       ,input v-corr-user-db-num
     4055       ).
     4056   apply "entry":u to sch-db-num in frame Dialog-Frame .
     4057   END PROCEDURE.
     4058   PROCEDURE proc-find-user :
     4059   define input parameter p-next as logical no-undo.
     4060   define input parameter p-user like c-goods-attr-any.corr-user-name no-undo.
     4061   assign
     4062   sch-corr-date = ?.
     4063   display
     4064   0 @ sch-db-num
     4065   sch-corr-date
     4066   0 @ sch-obj-code
     4067   with frame Dialog-Frame.
     4068   p-user = chr(34) + p-user + chr(34).
     4069   run OpenBr in this-procedure
     4070       (input false
     4071       ,input p-next
     4072       ,input substitute("and X_c-obj-hist.corr-user-name = &1 "
     4073         , p-user)
     4074       ,input v-corr-user-db-num
     4075       ).
     4076   apply "entry":u to sch-corr-user-name in frame Dialog-Frame .
     4077   END PROCEDURE.
     4078   PROCEDURE proc-view-changes :
     4079   define variable v-description as character no-undo .
     4080   for each temp-changes:
     4081       delete temp-changes.
     4082   END.
     4083   if not available X_c-obj-hist then do:
     4084     b-nextlevel:visible IN FRAME Dialog-Frame = no.
     4085     Open QUery br-changes for each temp-changes.
     4086     return.
     4087   end.
     4088   b-nextlevel:visible IN FRAME Dialog-Frame =  no .
     4089   run local-view-cange in this-procedure (output v-description) .
     4090   Open QUery br-changes for each temp-changes by temp-changes.fNotChange.
     4091   assign
     4092   br-changes:title in frame Dialog-Frame = v-description
     4093   .
     4094   END PROCEDURE.
     4095   FUNCTION get-action RETURNS CHARACTER
     4096     ( p-action as integer ) :
     4097   define variable dops as character no-undo.
     4098   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     4099   RETURN dops.
     4100   END FUNCTION.
     4101   FUNCTION get-source-type RETURNS CHARACTER
     4102     ( p-source-type as character ) :
     4103   define variable v-dop as character no-undo .
     4104   assign
     4105   v-dop = entry (lookup (p-source-type, ',db,esys,trn-doc,payment,fin-doc,import,recalc,wth-doc,ren-gdsc,upgrade,grp-chg,stop-list,dis-card':U), ',БД,ВС,Документ,Платеж,Фин.док.,Импорт,Пересчет,Документ МЦ,Коллизия,Апгрейд,Изм.группы,Стоплист,ДК':U)
     4106   no-error
     4107   .
     4108   RETURN v-dop.
     4109   END FUNCTION.
     4110   function get-subject returns character
     4111     ( p-subject as character ) :
     4112     return p-subject.
     4113   end function.
     4114   procedure local-view-cange:
     4115      define output parameter odescription as character no-undo.
     4116      run obj-proc (output odescription).
     4117   end procedure.
     4118   function local-open-br returns logical
     4119   (  p-open-query     as logical    ,
     4120     p-find-next       as logical    ,
     4121     p-find-condition as character ):
     4122        define variable sort-column-phrase as character no-undo .
     4123        define variable l-query-was-opened as logical no-undo .
     4124        if p-mode eq "one"
     4125        then do:
     4126   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4127   define variable  l-disable-where-31  as logical   no-undo .
     4128   define variable  l-filter-open-31    as logical   .
     4129   define variable  flt-rec-31       as recid     no-undo .
     4130   define variable  filter-name-31      as character no-undo .
     4131   define variable  where-phrase-31     as character no-undo .
     4132   define variable  sort-phrase-31      as character no-undo .
     4133   define variable  where-phrase-rus-31 as character no-undo .
     4134   define variable  sort-phrase-rus-31  as character no-undo .
     4135     run waitfram-show in this-procedure
     4136       (input "ЖДИТЕ ..."
     4137       ).
     4138   run gbl/flt-get.p
     4139     (input filter-point
     4140     ,output flt-rec-31
     4141     ,output filter-name-31
     4142     ,output where-phrase-31
     4143     ,output sort-phrase-31
     4144     ,output where-phrase-rus-31
     4145     ,output sort-phrase-rus-31
     4146     ).
     4147   if p-open-query then do:
     4148       run set-filter-name in this-procedure
     4149         (INPUT filter-name-31
     4150         ) no-error .
     4151     assign
     4152       l-filter-open-31 = false
     4153     .
     4154     if flt-rec-31 <> ?
     4155       or sort-column-phrase > ""
     4156     then do:
     4157       define variable  parameter-2-31 as character no-undo .
     4158       define variable  parameter-3-31 as character no-undo .
     4159       define variable  parameter-4-31 as character no-undo .
     4160       define variable  parameter-5-31 as character no-undo .
     4161       define variable  parameter-6-31 as character no-undo .
     4162       define variable  parameter-7-31 as character no-undo .
     4163         assign
     4164         parameter-3-31 =
     4165                                 "FOR EACH X_c-obj-hist"
     4166         parameter-4-31 =
     4167           (
     4168             if ("           X_c-obj-hist.Bush                = 'operserv'          and X_c-obj-hist.attr-code          = 'operservid'          and X_c-obj-hist.attr-value         = string(pid)  " + " " + where-phrase-31) <> ""
     4169             then  substitute('  X_c-obj-hist.Bush                = &1operserv&1                                         and X_c-obj-hist.attr-code          = &1operservid&1          and X_c-obj-hist.attr-value         = &1&2&1 ', chr(34), pid)   + " " + where-phrase-31
     4170             else "true"
     4171           )
     4172         parameter-5-31 = (" " + "" + " " + "")
     4173         parameter-6-31 = if sort-phrase-31 = ''
     4174                              then
     4175           (
     4176           " " + " " +
     4177             " " + sort-column-phrase +
     4178           " " + "  "
     4179           )
     4180                              else
     4181           (
     4182           " " + " " +
     4183             " " + sort-column-phrase +
     4184           " " + sort-phrase-31
     4185           )
     4186         parameter-7-31 =
     4187           " indexed-reposition  "
     4188       .
     4189       do
     4190       on stop undo, leave
     4191       on error undo, leave
     4192       :
     4193         assign
     4194           l-disable-where-31 =
     4195             ("           X_c-obj-hist.Bush                = 'operserv'          and X_c-obj-hist.attr-code          = 'operservid'          and X_c-obj-hist.attr-value         = string(pid)  " + " " + where-phrase-31 = "")
     4196         .
     4197         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4198                             ,input query br-obj-hist:handle
     4199                             ,input parameter-3-31
     4200                             ,input parameter-4-31
     4201                             ,input parameter-5-31
     4202                             ,input parameter-6-31
     4203                             ,input parameter-7-31
     4204                             )
     4205         .
     4206         assign
     4207           l-filter-open-31 = true
     4208         .
     4209       end.
     4210       if l-filter-open-31 = false then do:
     4211         message
     4212           "Ошибка при фильтрации / сортировке" skip
     4213           "Будут показаны записи без учета фильтра" skip
     4214           view-as alert-box .
     4215       end.
     4216       else do:
     4217           assign
     4218             l-query-was-opened = true
     4219           .
     4220       end.
     4221     end.
     4222     if l-filter-open-31 = false then do:
     4223       OPEN QUERY br-obj-hist FOR EACH X_c-obj-hist
     4224         where            X_c-obj-hist.Bush                = 'operserv'          and X_c-obj-hist.attr-code          = 'operservid'          and X_c-obj-hist.attr-value         = string(pid)
     4225         indexed-reposition
     4226     .
     4227         assign
     4228           l-query-was-opened = true
     4229         .
     4230     end.
     4231   end.
     4232   else do:
     4233     assign
     4234       v-doc-rec = recid( X_c-obj-hist )
     4235     .
     4236     do
     4237     on stop undo, leave
     4238     on error undo, leave
     4239     :
     4240       if query br-obj-hist:handle:get-buffer-handle(1) = (buffer X_c-obj-hist:handle) then do:
     4241         assign
     4242         parameter-2-31 = (if p-find-next then "true":u else "false":u )
     4243         parameter-4-31 =
     4244           "where ":u +  substitute('  X_c-obj-hist.Bush                = &1operserv&1                                         and X_c-obj-hist.attr-code          = &1operservid&1          and X_c-obj-hist.attr-value         = &1&2&1 ', chr(34), pid)   + " ":u + where-phrase-31 + " ":u + p-find-condition + " " + ""
     4245         parameter-5-31 = " "
     4246       .
     4247         run fltopend_fltfindd in this-procedure  (
     4248                             input this-procedure:handle
     4249                             ,input query br-obj-hist:handle
     4250                             ,input rowid(X_c-obj-hist)
     4251                             ,input logical(parameter-2-31)
     4252                             ,input no-lock
     4253                             ,input (buffer X_c-obj-hist:handle)
     4254                             ,input parameter-4-31
     4255                             ,input parameter-5-31
     4256                             ) no-error.
     4257         .
     4258         assign
     4259           v-doc-rec = integer(return-value)
     4260           v-fltopend-rowid[1] = ?
     4261         .
     4262       end.
     4263       else do:
     4264         assign
     4265         parameter-2-31 = (if p-find-next then "true":u else "false":u )
     4266         parameter-3-31 =  "FOR EACH X_c-obj-hist"
     4267         parameter-4-31 =
     4268           (
     4269             if ("           X_c-obj-hist.Bush                = 'operserv'          and X_c-obj-hist.attr-code          = 'operservid'          and X_c-obj-hist.attr-value         = string(pid)  " + " " + where-phrase-31) <> ""
     4270             then  substitute('  X_c-obj-hist.Bush                = &1operserv&1                                         and X_c-obj-hist.attr-code          = &1operservid&1          and X_c-obj-hist.attr-value         = &1&2&1 ', chr(34), pid)   + " " + where-phrase-31
     4271             else "true"
     4272           )
     4273         parameter-5-31 = (" " + "" + " " + "" + " " + p-find-condition)
     4274         parameter-6-31 = if sort-phrase-31 = ''
     4275                              then
     4276           (
     4277           " " + " " +
     4278             " " + sort-column-phrase +
     4279           " " + "  "
     4280           )
     4281                              else
     4282           (
     4283           " " + " " +
     4284             " " + sort-column-phrase +
     4285           " " + sort-phrase-31
     4286           )
     4287         parameter-7-31 =
     4288           " indexed-reposition  "
     4289       .
     4290         run fltopend_fltfindq in this-procedure  (
     4291                             input this-procedure:handle
     4292                             ,input query br-obj-hist:handle
     4293                             ,input logical(parameter-2-31)
     4294                             ,input no-lock
     4295                             ,input parameter-3-31
     4296                             ,input parameter-4-31
     4297                             ,input parameter-5-31
     4298                             ,input parameter-6-31
     4299                             ,input parameter-7-31
     4300                             ,output v-fltopend-rowid
     4301                             ) no-error.
     4302         .
     4303         v-doc-rec = ?.
     4304       end.
     4305       assign
     4306         l-query-was-opened = true
     4307       .
     4308     end.
     4309   end.
     4310     run waitfram-hide in this-procedure .
     4311        end.
     4312        else do:
     4313   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4314   define variable  l-disable-where-33  as logical   no-undo .
     4315   define variable  l-filter-open-33    as logical   .
     4316   define variable  flt-rec-33       as recid     no-undo .
     4317   define variable  filter-name-33      as character no-undo .
     4318   define variable  where-phrase-33     as character no-undo .
     4319   define variable  sort-phrase-33      as character no-undo .
     4320   define variable  where-phrase-rus-33 as character no-undo .
     4321   define variable  sort-phrase-rus-33  as character no-undo .
     4322     run waitfram-show in this-procedure
     4323       (input "ЖДИТЕ ..."
     4324       ).
     4325   run gbl/flt-get.p
     4326     (input filter-point
     4327     ,output flt-rec-33
     4328     ,output filter-name-33
     4329     ,output where-phrase-33
     4330     ,output sort-phrase-33
     4331     ,output where-phrase-rus-33
     4332     ,output sort-phrase-rus-33
     4333     ).
     4334   if p-open-query then do:
     4335       run set-filter-name in this-procedure
     4336         (INPUT filter-name-33
     4337         ) no-error .
     4338     assign
     4339       l-filter-open-33 = false
     4340     .
     4341     if flt-rec-33 <> ?
     4342       or sort-column-phrase > ""
     4343     then do:
     4344       define variable  parameter-2-33 as character no-undo .
     4345       define variable  parameter-3-33 as character no-undo .
     4346       define variable  parameter-4-33 as character no-undo .
     4347       define variable  parameter-5-33 as character no-undo .
     4348       define variable  parameter-6-33 as character no-undo .
     4349       define variable  parameter-7-33 as character no-undo .
     4350         assign
     4351         parameter-3-33 =
     4352                                 "FOR EACH X_c-obj-hist"
     4353         parameter-4-33 =
     4354           (
     4355             if (" TRUE " + " " + where-phrase-33) <> ""
     4356             then " TRUE " + " " + where-phrase-33
     4357             else "true"
     4358           )
     4359         parameter-5-33 = (" " + "" + " " + "")
     4360         parameter-6-33 = if sort-phrase-33 = ''
     4361                              then
     4362           (
     4363           " " + "" +
     4364             " " + sort-column-phrase +
     4365           " " + "  "
     4366           )
     4367                              else
     4368           (
     4369           " " + "" +
     4370             " " + sort-column-phrase +
     4371           " " + sort-phrase-33
     4372           )
     4373         parameter-7-33 =
     4374           " indexed-reposition  "
     4375       .
     4376       do
     4377       on stop undo, leave
     4378       on error undo, leave
     4379       :
     4380         assign
     4381           l-disable-where-33 =
     4382             (" TRUE " + " " + where-phrase-33 = "")
     4383         .
     4384         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4385                             ,input query br-obj-hist:handle
     4386                             ,input parameter-3-33
     4387                             ,input parameter-4-33
     4388                             ,input parameter-5-33
     4389                             ,input parameter-6-33
     4390                             ,input parameter-7-33
     4391                             )
     4392         .
     4393         assign
     4394           l-filter-open-33 = true
     4395         .
     4396       end.
     4397       if l-filter-open-33 = false then do:
     4398         message
     4399           "Ошибка при фильтрации / сортировке" skip
     4400           "Будут показаны записи без учета фильтра" skip
     4401           view-as alert-box .
     4402       end.
     4403       else do:
     4404           assign
     4405             l-query-was-opened = true
     4406           .
     4407       end.
     4408     end.
     4409     if l-filter-open-33 = false then do:
     4410       OPEN QUERY br-obj-hist FOR EACH X_c-obj-hist
     4411         where  TRUE
     4412         indexed-reposition
     4413     .
     4414         assign
     4415           l-query-was-opened = true
     4416         .
     4417     end.
     4418   end.
     4419   else do:
     4420     assign
     4421       v-doc-rec = recid( X_c-obj-hist )
     4422     .
     4423     do
     4424     on stop undo, leave
     4425     on error undo, leave
     4426     :
     4427       if query br-obj-hist:handle:get-buffer-handle(1) = (buffer X_c-obj-hist:handle) then do:
     4428         assign
     4429         parameter-2-33 = (if p-find-next then "true":u else "false":u )
     4430         parameter-4-33 =
     4431           "where ":u + " TRUE " + " ":u + where-phrase-33 + " ":u + p-find-condition + " " + ""
     4432         parameter-5-33 = ""
     4433       .
     4434         run fltopend_fltfindd in this-procedure  (
     4435                             input this-procedure:handle
     4436                             ,input query br-obj-hist:handle
     4437                             ,input rowid(X_c-obj-hist)
     4438                             ,input logical(parameter-2-33)
     4439                             ,input no-lock
     4440                             ,input (buffer X_c-obj-hist:handle)
     4441                             ,input parameter-4-33
     4442                             ,input parameter-5-33
     4443                             ) no-error.
     4444         .
     4445         assign
     4446           v-doc-rec = integer(return-value)
     4447           v-fltopend-rowid[1] = ?
     4448         .
     4449       end.
     4450       else do:
     4451         assign
     4452         parameter-2-33 = (if p-find-next then "true":u else "false":u )
     4453         parameter-3-33 =  "FOR EACH X_c-obj-hist"
     4454         parameter-4-33 =
     4455           (
     4456             if (" TRUE " + " " + where-phrase-33) <> ""
     4457             then " TRUE " + " " + where-phrase-33
     4458             else "true"
     4459           )
     4460         parameter-5-33 = (" " + "" + " " + "" + " " + p-find-condition)
     4461         parameter-6-33 = if sort-phrase-33 = ''
     4462                              then
     4463           (
     4464           " " + "" +
     4465             " " + sort-column-phrase +
     4466           " " + "  "
     4467           )
     4468                              else
     4469           (
     4470           " " + "" +
     4471             " " + sort-column-phrase +
     4472           " " + sort-phrase-33
     4473           )
     4474         parameter-7-33 =
     4475           " indexed-reposition  "
     4476       .
     4477         run fltopend_fltfindq in this-procedure  (
     4478                             input this-procedure:handle
     4479                             ,input query br-obj-hist:handle
     4480                             ,input logical(parameter-2-33)
     4481                             ,input no-lock
     4482                             ,input parameter-3-33
     4483                             ,input parameter-4-33
     4484                             ,input parameter-5-33
     4485                             ,input parameter-6-33
     4486                             ,input parameter-7-33
     4487                             ,output v-fltopend-rowid
     4488                             ) no-error.
     4489         .
     4490         v-doc-rec = ?.
     4491       end.
     4492       assign
     4493         l-query-was-opened = true
     4494       .
     4495     end.
     4496   end.
     4497     run waitfram-hide in this-procedure .
     4498        end.
     4499     return true.
     4500   end.
     4501   procedure obj-proc :
     4502   define output parameter p-description as character no-undo .
     4503   define variable v-mess as character no-undo.
     4504   do
     4505   on error undo, return error return-value
     4506   :
     4507   define variable v-label-param as character no-undo .
     4508     v-label-param =
     4509      "gds-code"     + chr(4) + "Код товара " + chr(4) + "" .
     4510     run proc-full-temp-changes in this-procedure (
     4511                                                  input X_c-obj-hist.action = integer('1':U)
     4512                                                 ,input X_c-obj-hist.action = integer('99':U)
     4513                                                 ,input  buffer X_c-obj-hist:handle
     4514                                                 ,input  'goods-attr':U
     4515                                                 ,input  "gds-code"
     4516                                                 ,input  v-label-param).
     4517   end.
     4518   end procedure.
