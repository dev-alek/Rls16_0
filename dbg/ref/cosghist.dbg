        1   define input  parameter pid as int64 no-undo.
        2   DEFINE BUFFER X_c-obj-hist FOR c-goods-attr-any.
        3   DEFINE BUFFER find_c-obj-hist FOR c-goods-attr-any.
        4   DEFINE BUFFER X_curr-sysconf FOR sysconf.
        5   DEFINE BUFFER X_db FOR db.
        6   DEFINE BUFFER X_sysconf FOR sysconf.
        7   define input     parameter parParentProc  as widget-handle no-undo.
        8   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo.
        9   define input parameter p-curr-obj-type like ub.clients.obj-type no-undo.
       10   define input parameter p-curr-obj-code like ub.clients.obj-code no-undo.
       11   define input parameter bttns  as char   no-undo .
       12   define input parameter p-mode  as char   no-undo .
       13   define input parameter p-corr-user-db-num  like ub.c-cli-hist.corr-user-db-num no-undo .
       14   define input parameter p-corr-user-name  like ub.c-cli-hist.corr-user-name no-undo .
       15   define input parameter p-subject  like ub.c-cli-hist.subject no-undo .
       16   define input parameter p-db-num  like ub.c-cli-hist.corr-user-db-num no-undo .
       17   define input parameter p-chip-num  as int64 no-undo.
       18   define input-output param p-rid-list    as  char no-undo .
       19   define variable vss-revision    AS CHAR NO-UNDO INIT "$Revision$":U.
       20   define variable vss-author      AS CHAR NO-UNDO INIT "$Author$":U.
       21   define variable vss-date        AS CHAR NO-UNDO INIT "$Date$":U.
       22   define variable vss-workfile    AS CHAR NO-UNDO INIT "$Workfile$":U.
