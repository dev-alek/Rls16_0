     3151     then do:
     3152       ASSIGN
     3153         sch-corr-date :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date22 :HANDLE
     3154         sch-corr-date :MENU-MOUSE in frame Dialog-Frame = 3
     3155       .
     3156     end.
     3157     define variable v-label-handle22 as handle no-undo .
     3158     assign
     3159       v-label-handle22 = sch-corr-date :side-label-handle in frame Dialog-Frame
     3160     .
     3161     if valid-handle (v-label-handle22)
     3162     then do:
     3163       if v-label-handle22 :tooltip = ""
     3164       or v-label-handle22 :tooltip = ?
     3165       then do:
     3166         assign
     3167           v-label-handle22 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     3168         .
     3169       end.
     3170     end.
