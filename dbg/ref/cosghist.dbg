     1075   FUNCTION get-all-fields returns character (p-file-name as character ):
     1076   define variable v-dop as character no-undo .
     1077     find first _file no-lock where _file._file-name = p-file-name no-error .
     1078     if not available _file then return "":U.
     1079     for each _field no-lock where
     1080              _field._file-recid = recid(_file) :
     1081       assign
     1082       v-dop = v-dop + _field._field-name + chr(44)
     1083       .
     1084     end.
     1085     return trim(v-dop).
     1086   END FUNCTION.
     1087   PROCEDURE proc-full-temp-changes :
     1088     define input  parameter p-act-create as logical   no-undo .
     1089     define input  parameter p-act-delete as logical   no-undo .
     1090     define input  parameter p-hst-handle as handle    no-undo .
     1091     define input  parameter p-main-table as character no-undo .
     1092     define input  parameter p-field-list as character no-undo .
     1093     define input  parameter p-label-form as character no-undo .
     1094     define variable h-new-buf         as handle    no-undo .
     1095     define variable h-main-buf        as handle    no-undo .
     1096     define variable h-for-comp        as handle    no-undo .
     1097     define variable v-inform          as character no-undo .
     1098     define variable v-ind             as integer   no-undo .
     1099     define variable v-idx-field-qnty  as integer   no-undo .
     1100     define variable v-num-entries     as integer   no-undo .
     1101     define variable fh                as handle    no-undo .
     1102     define variable fh-main           as handle    no-undo .
     1103     define variable fh-old            as handle    no-undo .
     1104     define variable fh-new            as handle    no-undo .
     1105     define variable v-field-name      as character no-undo .
     1106     define variable v-field-lvl       as character no-undo .
     1107     define variable v-field-form      as character no-undo .
     1108     define variable v-search-exp      as character no-undo .
     1109     define variable v-srch-main       as character no-undo .
     1110     define variable v-word-link       as character no-undo .
     1111     define variable v-av-chip-num     as logical   no-undo .
     1112     define variable v-main-pi-fld-lst as character no-undo .
     1113     define variable v-main-fld-lst    as character no-undo .
     1114     define variable v-delim-list      as character no-undo .
     1115     define variable v-label           as character no-undo .
     1116     define variable v-old-value       as character no-undo case-sensitive.
     1117     define variable v-new-value       as character no-undo case-sensitive.
     1118     define variable v-chg-fields as character no-undo.
     1119     for each temp-changes:
     1120       delete temp-changes.
     1121     end.
     1122     if not p-hst-handle:available then do:
     1123       return .
     1124     end.
     1125     create buffer h-new-buf  for table p-hst-handle .
     1126     create buffer h-main-buf for table p-main-table .
     1127     assign
     1128       v-inform = h-main-buf:index-information(1)
     1129       v-ind    = 2
     1130     .
     1131     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1132     on error undo, return error
     1133     :
     1134       assign
     1135         v-inform = h-main-buf:index-information( v-ind )
     1136         v-ind    = v-ind + 1
     1137       .
     1138     end.
     1139     if v-inform = ?
     1140       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1141       or entry( 3, v-inform, ",":U ) <> "1":U
     1142     then do:
     1143       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1144     end.
     1145     assign
     1146       v-idx-field-qnty = num-entries( v-inform ) - 4
     1147     .
     1148     if v-idx-field-qnty < 2 then do:
     1149       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1150     end.
     1151     assign
     1152       v-srch-main   = "where":U
     1153       v-word-link   = "":U
     1154       v-av-chip-num = false
     1155       v-delim-list  = "":U
     1156     .
     1157     do v-ind = 1 to v-idx-field-qnty by 2
     1158     on error undo, return error
     1159     :
     1160       assign
     1161         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1162         fh                = p-hst-handle:buffer-field( v-field-name )
     1163         fh-main           = h-main-buf:buffer-field( v-field-name )
     1164         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1165         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1166       .
     1167       if fh:data-type ="character":U then do:
     1168         assign
     1169           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1170         .
     1171       end.
     1172       else do:
     1173         assign
     1174           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1175         .
     1176       end.
     1177       if v-delim-list = "":U then do:
     1178         assign
     1179           v-delim-list = ",":U
     1180         .
     1181       end.
     1182       if v-word-link = "":U then do:
     1183         assign
     1184           v-word-link = "and":U
     1185         .
     1186       end.
     1187     end.
     1188     assign
     1189       v-delim-list  = "":U
     1190     .
     1191     do v-ind = 1 to h-main-buf:num-fields
     1192     on error undo, return error
     1193     :
     1194       assign
     1195         fh-main      = h-main-buf:buffer-field( v-ind )
     1196         v-field-name = fh-main:name
     1197       .
     1198         assign
     1199           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1200         .
     1201         if v-delim-list = "":U then do:
     1202           assign
     1203             v-delim-list = ",":U
     1204           .
     1205         end.
     1206     end.
     1207     assign
     1208       v-inform = p-hst-handle:index-information(1)
     1209       v-ind    = 2
     1210     .
     1211     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1212     on error undo, return error
     1213     :
     1214       assign
     1215         v-inform = p-hst-handle:index-information( v-ind )
     1216         v-ind    = v-ind + 1
     1217       .
     1218     end.
     1219     if v-inform = ?
     1220       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1221       or entry( 3, v-inform, ",":U ) <> "1":U
     1222     then do:
     1223       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1224     end.
     1225     assign
     1226       v-idx-field-qnty = num-entries( v-inform ) - 4
     1227     .
     1228     if v-idx-field-qnty < 2 then do:
     1229       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1230     end.
     1231     assign
     1232       v-search-exp  = "where":U
     1233       v-word-link   = "":U
     1234       v-av-chip-num = false
     1235     .
     1236     do v-ind = 1 to v-idx-field-qnty by 2
     1237     on error undo, return error
     1238     :
     1239       assign
     1240         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1241         fh           = p-hst-handle:buffer-field( v-field-name )
     1242         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1243       .
     1244       if v-field-name = "chip-num":U then do:
     1245         assign
     1246           v-search-exp  = substitute( "&1 >", v-search-exp )
     1247           v-av-chip-num = true
     1248         .
     1249       end.
     1250       else do:
     1251         assign
     1252           v-search-exp = substitute( "&1 =", v-search-exp )
     1253         .
     1254       end.
     1255       if fh:data-type ="character":U then do:
     1256         assign
     1257           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1258         .
     1259       end.
     1260       else do:
     1261         assign
     1262           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1263         .
     1264       end.
     1265       if v-word-link = "":U then do:
     1266         assign
     1267           v-word-link = "and":U
     1268         .
     1269       end.
     1270     end.
     1271     if v-av-chip-num = false then do:
     1272       message
     1273         vss-workfile vss-revision vss-description skip
     1274         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1275         "Использование данной процедуры невозможно!" skip
     1276         view-as alert-box error .
     1277       return error .
     1278     end.
     1279     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1280     if not h-new-buf:available then do:
     1281       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1282       if not h-main-buf:available then do:
     1283         assign
     1284           h-for-comp = ?
     1285         .
     1286       end.
     1287       else do:
     1288         assign
     1289           h-for-comp = h-main-buf
     1290         .
     1291       end.
     1292     end.
     1293     else do:
     1294       assign
     1295         h-for-comp = h-new-buf
     1296       .
     1297     end.
     1298     assign
     1299       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1300     .
     1301     do v-ind = 1 to v-num-entries
     1302     on error undo, return error return-value
     1303     :
     1304       assign
     1305         v-field-name = entry( v-ind, v-main-fld-lst )
     1306         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1307         v-old-value  = fh-old:buffer-value()
     1308         v-label      = trim( fh-old:label )
     1309       .
     1310       if ( trim( p-field-list ) <> "":U
     1311            and lookup( v-field-name, p-field-list ) > 0
     1312          )
     1313          or trim( p-field-list ) = "":U
     1314       then do:
     1315         if h-for-comp <> ? then do:
     1316           assign
     1317             fh-new      = h-for-comp:buffer-field( v-field-name )
     1318             v-new-value = fh-new:buffer-value()
     1319           .
     1320         end.
     1321         else do:
     1322           assign
     1323             v-new-value = "":U
     1324           .
     1325         end.
     1326           if p-act-create = true then do:
     1327             assign
     1328               v-old-value = "":U
     1329             .
     1330           end.
     1331           if p-act-delete = true then do:
     1332             assign
     1333               v-new-value = "":U
     1334             .
     1335           end.
     1336         if v-old-value <> v-new-value
     1337         then do:
     1338           create temp-changes.
     1339           assign
     1340             temp-changes.t_name = p-main-table
     1341             temp-changes.f_name = v-field-name
     1342             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1343             temp-changes.v_old  = trim( v-old-value )
     1344             temp-changes.v_new  = trim( v-new-value )
     1345             temp-changes.num_   = 0
     1346             temp-changes.fNotChange = v-old-value eq v-new-value
     1347           .
     1348         end.
     1349       end.
     1350     end.
     1351     assign
     1352       v-num-entries = num-entries( p-label-form, chr(8) )
     1353     .
     1354     do v-ind = 1 to v-num-entries
     1355     on error undo, return error return-value
     1356     :
     1357       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1358         assign
     1359           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1360           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1361           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1362         .
     1363         find first temp-changes
     1364           where temp-changes.f_name = v-field-name
     1365           no-error .
     1366         if available temp-changes then do:
     1367           if trim( v-field-lvl ) <> "":U then do:
     1368             assign
     1369               temp-changes.l_name = v-field-lvl
     1370             .
     1371           end.
     1372           if trim( v-field-form ) <> "":U then do:
     1373             assign
     1374               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1375             .
     1376             if h-for-comp <> ? then do:
     1377               assign
     1378                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1379               .
     1380             end.
     1381           end.
     1382         end.
     1383       end.
     1384       else do:
     1385         message
     1386           vss-workfile vss-revision vss-description skip
     1387           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1388           substitute( "список для поля '&1': '&2'"
     1389                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1390                       ,entry( v-ind, p-label-form, chr(8) )
     1391                     ) skip
     1392           substitute( "полный список: &2", p-label-form ) skip
     1393           view-as alert-box error .
     1394       end.
     1395     end.
     1396     delete object h-new-buf .
     1397     delete object h-main-buf .
     1398   END PROCEDURE.
     1399   FUNCTION get-action RETURNS CHARACTER
     1400     ( p-action as integer )  FORWARD.
     1401   FUNCTION get-source-type RETURNS CHARACTER
     1402     ( p-source-type as character )  FORWARD.
     1403   FUNCTION get-subject RETURNS CHARACTER
     1404     ( p-subject as character )  FORWARD.
     1405   FUNCTION local-open-br RETURNS logical
     1406     (  p-open-query     as logical    ,
     1407     p-find-next       as logical    ,
     1408     p-find-condition as character )  FORWARD.
     1409   DEFINE BUTTON B-Help
     1410        LABEL "Помо&щь"
     1411        SIZE 3 BY 1
     1412        BGCOLOR 8 .
     1413   DEFINE BUTTON B-mark
     1414        LABEL "&*"
     1415        SIZE 3 BY 1.
     1416   DEFINE BUTTON B-print
     1417        LABEL "Пе&чать"
     1418        SIZE 3 BY 1.
     1419   DEFINE BUTTON b-quit AUTO-END-KEY
     1420        LABEL "&Выход"
     1421        SIZE 10 BY 1
     1422        BGCOLOR 8 .
     1423   DEFINE BUTTON b-reason
     1424        LABEL "&Причина"
     1425        SIZE 10 BY 1.
     1426   DEFINE BUTTON B-sch
     1427        LABEL "&Фильтр"
     1428        SIZE 3 BY 1.
     1429   DEFINE BUTTON b-sel AUTO-GO
     1430        LABEL "Вы&бор"
     1431        SIZE 10 BY 1
     1432        BGCOLOR 8 .
     1433   DEFINE BUTTON b-nextlevel
     1434        LABEL "Детали"
     1435        SIZE 10 BY 1
     1436        BGCOLOR 8 .
     1437   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1438         VIEW-AS TEXT
     1439        SIZE 6 BY 1
     1440        FGCOLOR 4  NO-UNDO.
     1441   DEFINE VARIABLE sch-obj-code AS CHARACTER FORMAT "X(50)":U
     1442        LABEL "коду"
     1443        VIEW-AS FILL-IN
     1444        SIZE 10 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1445   DEFINE VARIABLE sch-corr-date AS DATE FORMAT "99/99/9999":U
     1446        LABEL "Дате изменения"
     1447        VIEW-AS FILL-IN
     1448        SIZE 11 BY 1 NO-UNDO.
     1449   DEFINE VARIABLE sch-corr-user-name AS CHARACTER FORMAT "X(9)":U
     1450        LABEL "пользователю"
     1451        VIEW-AS FILL-IN
     1452        SIZE 12 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1453   DEFINE VARIABLE sch-db-num AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1454        LABEL "БД"
     1455        VIEW-AS FILL-IN
     1456        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1457   DEFINE VARIABLE v-corr-user-db-num AS INTEGER FORMAT ">>>>9":U INITIAL 0
     1458        LABEL "по БД"
     1459        VIEW-AS FILL-IN
     1460        SIZE 6 BY 1 NO-UNDO.
     1461   DEFINE QUERY BR-changes FOR
     1462         temp-changes SCROLLING.
     1463   DEFINE QUERY br-obj-hist FOR
     1464         X_c-obj-hist SCROLLING.
     1465   DEFINE BROWSE BR-changes
     1466     QUERY BR-changes DISPLAY
     1467         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(200)" width 40
     1468   temp-changes.v_old COLUMn-LABEL "Было" format "X(255)"
     1469   temp-changes.v_new COLUMn-LABEL "Стало" format "X(255)"
     1470       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.25.
     1471   DEFINE BROWSE br-obj-hist
     1472     QUERY br-obj-hist NO-LOCK DISPLAY
     1473         mark-string(recid(X_c-obj-hist), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1474         X_c-obj-hist.corr-date FORMAT "99/99/9999":U COLUMN-LABEL "Дата изм."
     1475         string(X_c-obj-hist.corr-time, "HH:MM:SS":U) COLUMN-LABEL "Время изм." FORMAT "X(8)":U
     1476         usrfulnf(X_c-obj-hist.corr-user-name) COLUMn-LABEL "Изменил" FORMAT "X(255)":U width 18
     1477         get-action(X_c-obj-hist.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1478         X_c-obj-hist.corr-user-db-num FORMAT ">>>>9":U COLUMN-LABEL "Дб!созд."
     1479     ENABLE
     1480         X_c-obj-hist.corr-date
     1481       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.46.
     1482   DEFINE FRAME Dialog-Frame
     1483        b-quit AT ROW 1 COL 1
     1484        B-mark AT ROW 1 COL 11
     1485        b-sel AT ROW 1 COL 21
     1486        v-corr-user-db-num AT ROW 1 COL 37 COLON-ALIGNED
     1487        b-nextlevel AT ROW 1 COL 70
     1488        b-reason AT ROW 1 COL 59
     1489        B-print AT ROW 1 COL 89
     1490        B-sch AT ROW 1 COL 92
     1491        B-Help AT ROW 1 COL 95
     1492        br-obj-hist AT ROW 2 COL 1
     1493        sch-db-num AT ROW 13.63 COL 60.13 COLON-ALIGNED
     1494        sch-corr-date AT ROW 13.63 COL 85.75 COLON-ALIGNED
     1495        sch-obj-code AT ROW 13.67 COL 45.13 COLON-ALIGNED
     1496        sch-corr-user-name AT ROW 13.71 COL 22.5 COLON-ALIGNED
     1497        BR-changes AT ROW 14.79 COL 1
     1498        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1499        "ПОИСК ПО" VIEW-AS TEXT
     1500             SIZE 8.38 BY 1 AT ROW 13.63 COL 1.38
     1501             FGCOLOR 4
     1502        SPACE(89.48) SKIP(7.44)
     1503       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1504            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1505            TITLE
     1506            "Полная история"
     1507            CANCEL-BUTTON b-quit.
     1508   ASSIGN
     1509          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1510          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1511   ASSIGN
     1512          br-obj-hist:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     1513   ON GO OF FRAME Dialog-Frame
     1514   DO:
     1515     p-rid-list = v-rid-list.
     1516   END.
     1517   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1518   DO:
     1519     APPLY "END-ERROR":U TO SELF.
     1520   END.
     1521   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1522   DO:
     1523   define variable loc#log as logical no-undo .
     1524     if available X_c-obj-hist then do:
     1525   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1526   define variable v-str-recid15 as character no-undo .
     1527   define variable v-num-entry15 as integer   no-undo .
     1528   assign
     1529     v-str-recid15 = trim( string( recid( X_c-obj-hist ) , "->>>>>>>>>>>9":U ) )
     1530     v-num-entry15 = lookup( v-str-recid15 , v-rid-list )
     1531   .
     1532   if v-num-entry15 > 0 then do:
     1533     assign
     1534       entry( v-num-entry15, v-rid-list ) = "":U
     1535       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1536     .
     1537   end.
     1538   else do:
     1539     assign
     1540       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid15
     1541     .
     1542   end.
     1543       loc#log = br-obj-hist:refresh() .
     1544       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1545           loc#log = br-obj-hist:select-next-row ().
     1546           apply "VALUE-CHANGED" to br-obj-hist in frame Dialog-Frame.
     1547       end.
     1548       if num-entries( v-rid-list ) = 0
     1549       then
     1550           hide mark-num in frame Dialog-Frame.
     1551       else
     1552           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1553     end.
     1554     apply "entry" to br-obj-hist in frame Dialog-Frame.
     1555   END.
     1556   ON CHOOSE OF b-nextlevel IN FRAME Dialog-Frame
     1557   DO:
     1558      define variable vRun as character no-undo.
     1559      vRun = this-procedure:file-name.
     1560      run value(vRun)
     1561         (
     1562          parParentProc,
     1563          p-curr-host-code,
     1564          p-curr-obj-type,
     1565          p-curr-obj-code,
     1566          bttns,
     1567          "one",
     1568          p-corr-user-db-num,
     1569          p-corr-user-name,
     1570          p-subject,
     1571          p-db-num,
     1572          X_c-obj-hist.chip-num ,
     1573          input-output p-rid-list ).
     1574      apply "entry" to br-obj-hist in frame Dialog-Frame.
     1575   END.
     1576   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1577   DO:
     1578       run proc-b-print in this-procedure no-error.
     1579     if error-status:error then return no-apply.
     1580   END.
     1581   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1582   DO:
     1583       run proc-b-sch in this-procedure no-error.
     1584     if error-status:error then return no-apply.
     1585   END.
     1586   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1587   DO:
     1588     if ( available X_c-obj-hist ) then do:
     1589       if ( v-rid-list = "" ) or b-mark:sensitive = no
     1590       then
     1591       v-rid-list = string( recid( X_c-obj-hist ) ) .
     1592     end.
     1593   END.
     1594   ON MOUSE-SELECT-DBLCLICK OF br-obj-hist IN FRAME Dialog-Frame
     1595   DO:
     1596        run proc-br-obj-hist in this-procedure no-error.
     1597     if error-status:error then return no-apply.
     1598   END.
     1599   ON RETURN OF br-obj-hist IN FRAME Dialog-Frame
     1600   DO:
     1601       run proc-br-obj-hist in this-procedure no-error.
     1602     if error-status:error then return no-apply.
     1603   END.
     1604   ON VALUE-CHANGED OF br-obj-hist IN FRAME Dialog-Frame
     1605   DO:
     1606     run proc-view-changes in this-procedure no-error.
     1607   END.
     1608   ON CTRL-J OF sch-obj-code IN FRAME Dialog-Frame
