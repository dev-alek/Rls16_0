     3138           .
     3139         end.
     3140       end.
     3141     end.
     3142     return no-apply .
     3143   end.
     3144     define MENU m-ed-date22
     3145       MENU-ITEM m-ed-date22-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     3146       MENU-ITEM m-ed-date22-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     3147       MENU-ITEM m-ed-date22-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     3148       MENU-ITEM m-ed-date22-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     3149       .
