     3325     REPOSITION br-obj-hist to recid integer(entry(1, v-rid-list)) No-ERROR.
     3326   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3327   DEF VAR cur-clmn-numbr-obj-hist as INT EXTENT 6 no-undo.
     3328   DEF VAR varmvibr-obj-hist       as INT no-undo.
     3329   DEF VAR varmvjbr-obj-hist       as INT no-undo.
     3330   DEF VAR varmvkbr-obj-hist       as INT no-undo.
     3331   DEF VAR varmvlbr-obj-hist       as INT no-undo.
     3332   DEF VAR move-elementbr-obj-hist as INT no-undo.
     3333   def var jjbr-obj-hist           as int no-undo.
     3334   do varmvibr-obj-hist = 1 to EXTENT(cur-clmn-numbr-obj-hist):
     3335     ASSIGN cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = varmvibr-obj-hist.
     3336   END.
     3337   RUN start-mv-clmnbr-obj-hist.
     3338   PROCEDURE start-mv-clmnbr-obj-hist:
     3339   def var old-session as logical no-undo.
     3340      old-session = SESSION:IMMEDIATE-DISPLAY.
     3341      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3342          IF  p-mode = 'все':U  THEN DO:
     3343      DO jjbr-obj-hist = NUM-ENTRIES('1,2,3,4,5,6') TO 1 BY -1:
     3344        RUN re-move-clmnbr-obj-hist ( cur-clmn-numbr-obj-hist[INTEGER(ENTRY (jjbr-obj-hist, '1,2,3,4,5,6'))] , 1).
     3345      END.
     3346          END.
     3347          IF  p-mode <> 'все':U  THEN DO:
     3348      DO jjbr-obj-hist = NUM-ENTRIES('1,2,3,5,6') TO 1 BY -1:
     3349        RUN re-move-clmnbr-obj-hist ( cur-clmn-numbr-obj-hist[INTEGER(ENTRY (jjbr-obj-hist, '1,2,3,5,6'))] , 1).
     3350      END.
     3351          END.
     3352      SESSION:IMMEDIATE-DISPLAY = old-session.
     3353   END.
     3354   ON ctrl-cursor-right OF BROWSE br-obj-hist do:
     3355     RUN re-move-clmnbr-obj-hist ( 1, 6).
     3356   END.
     3357   ON ctrl-cursor-left OF BROWSE br-obj-hist do:
     3358     RUN re-move-clmnbr-obj-hist (6, 1).
     3359   END.
     3360   PROCEDURE re-move-clmnbr-obj-hist:
     3361     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3362     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3363     DO varmvibr-obj-hist = 1 TO EXTENT(cur-clmn-numbr-obj-hist):
     3364       if cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = source-column THEN cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = -1.
     3365     END.
     3366     if br-obj-hist:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     3367     if source-column > target-column THEN
     3368     DO varmvjbr-obj-hist = source-column - 1 to target-column BY -1:
     3369       DO varmvibr-obj-hist = 1 TO EXTENT(cur-clmn-numbr-obj-hist):
     3370           if cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = varmvjbr-obj-hist THEN DO:
     3371             cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = cur-clmn-numbr-obj-hist[varmvibr-obj-hist] + 1.
     3372           END.
     3373       END.
     3374     END.
     3375     ELSE
     3376     DO varmvjbr-obj-hist = source-column + 1 to target-column:
     3377       DO varmvibr-obj-hist = 1 TO EXTENT(cur-clmn-numbr-obj-hist):
     3378         if cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = varmvjbr-obj-hist THEN DO:
     3379           cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = cur-clmn-numbr-obj-hist[varmvibr-obj-hist] - 1.
     3380         END.
     3381       END.
     3382     END.
     3383     DO varmvibr-obj-hist = 1 TO EXTENT(cur-clmn-numbr-obj-hist):
     3384       if cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = -1 THEN cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = target-column.
     3385     END.
     3386   END PROCEDURE.
     3387   PROCEDURE ch-clmnbr-obj-hist:
     3388     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3389     if cur-clmn-loc <= 1 then do:
     3390       return .
     3391     end.
     3392     DO varmvibr-obj-hist = 1 TO EXTENT(cur-clmn-numbr-obj-hist):
     3393       if cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = cur-clmn-loc THEN move-elementbr-obj-hist = varmvibr-obj-hist.
     3394     END.
     3395     RUN re-move-clmnbr-obj-hist (cur-clmn-loc, 1).
     3396   END PROCEDURE.
     3397   PROCEDURE mv-brw-defaultbr-obj-hist:
     3398   def var old-session as logical no-undo.
     3399     old-session = SESSION:IMMEDIATE-DISPLAY.
     3400     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3401     do varmvlbr-obj-hist = 1 to EXTENT(cur-clmn-numbr-obj-hist):
     3402       RUN re-move-clmnbr-obj-hist (cur-clmn-numbr-obj-hist[varmvlbr-obj-hist], varmvlbr-obj-hist).
     3403     END.
     3404     RUN start-mv-clmnbr-obj-hist.
     3405     SESSION:IMMEDIATE-DISPLAY = old-session.
     3406   END PROCEDURE.
