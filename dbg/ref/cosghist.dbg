     3013         ) .
     3014       assign
     3015         self :screen-value = string(v-curr-sv-date) .
     3016       .
     3017     end.
     3018     return no-apply.
     3019   end.
     3020   on ctrl-b of sch-corr-date in frame Dialog-Frame
     3021   do:
     3022     if (can-query (self, "sensitive")
     3023        and
     3024        self :sensitive = true
     3025        )
     3026     or (can-query (self, "read-only")
     3027        and
     3028        self :read-only = false
     3029        )
     3030     then do:
     3031       if self :handle <> focus :handle
