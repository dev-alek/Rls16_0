     3487   run waitfram-show in this-procedure ("Ждите...").
     3488   define variable sort-column-phrase as character no-undo .
     3489   case sort-column-name :
     3490     when "" then do:
     3491       assign
     3492         sort-column-phrase = ""
     3493       .
     3494     end.
     3495     otherwise do:
     3496       assign
     3497         sort-column-phrase = "by " + sort-column-name
     3498       .
     3499     end.
     3500   end case.
     3501   define variable l-open-query as logical   no-undo .
     3502   if p-mode = 'все':U then
