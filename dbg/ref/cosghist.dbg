     3183   def var sort-labelbr-obj-hist   as character no-undo .
     3184   def var sort-clmnbr-obj-hist    as handle    no-undo .
     3185   def var cur-clmnbr-obj-hist     as handle    no-undo .
     3186   def var cur-clmn-locbr-obj-hist as integer   no-undo .
     3187   def var re-querybr-obj-hist     as logical   initial no no-undo .
     3188   on start-search, ctrl-o of br-obj-hist in frame Dialog-Frame do:
     3189      run sort-brbr-obj-hist
     3190        (input (if available X_c-obj-hist
     3191                then recid(X_c-obj-hist)
     3192                else ?
     3193               )
     3194        ).
     3195   end.
     3196   PROCEDURE sort-brbr-obj-hist :
     3197     define input parameter p-recid as recid no-undo .
     3198     if re-querybr-obj-hist = no then do:
     3199       assign
     3200          cur-clmnbr-obj-hist = br-obj-hist:current-column in frame Dialog-Frame
     3201       .
     3202       if sort-clmnbr-obj-hist <> ? then sort-clmnbr-obj-hist:column-fgcolor = 0.
     3203       if cur-clmnbr-obj-hist = sort-clmnbr-obj-hist then do:
     3204         assign
     3205            sort-labelbr-obj-hist = ""
     3206            sort-clmnbr-obj-hist = ?
     3207         .
     3208        end.
     3209        else do:
     3210          assign
     3211            sort-labelbr-obj-hist = cur-clmnbr-obj-hist:label
     3212            sort-clmnbr-obj-hist  = cur-clmnbr-obj-hist
     3213            sort-clmnbr-obj-hist:column-fgcolor = 4
     3214          .
     3215        end.
     3216      end.
     3217     assign
     3218       cur-clmn-locbr-obj-hist = 1
     3219     .
     3220     def var column-handle as handle no-undo .
     3221     column-handle = br-obj-hist:first-column.
     3222     do while valid-handle(column-handle) :
     3223       if column-handle = cur-clmnbr-obj-hist then do:
     3224         leave .
     3225       end.
     3226       column-handle = column-handle:NEXT-COLUMN.
     3227       assign
     3228         cur-clmn-locbr-obj-hist = cur-clmn-locbr-obj-hist + 1
     3229       .
     3230     end.
     3231     case sort-labelbr-obj-hist:
     3232           when X_c-obj-hist.corr-date:label in browse br-obj-hist then DO:    assign       sort-column-name = "X_c-obj-hist.corr-date"     .     run OpenBr(yes, no, no, v-corr-user-db-num).   . END.
     3233           when X_c-obj-hist.corr-user-db-num:label in browse br-obj-hist then DO:    assign       sort-column-name = "X_c-obj-hist.corr-user-db-num"     .     run OpenBr(yes, no, no, v-corr-user-db-num).   . END.
     3234       otherwise do:
     3235         assign
     3236           sort-column-name = ""
     3237         .
     3238         run OpenBr(yes, no, no, v-corr-user-db-num).
     3239           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-obj-hist') then do:
     3240             run mv-brw-defaultbr-obj-hist.
     3241           end.
     3242         if sort-labelbr-obj-hist <> "" then do:
     3243           assign
     3244             cur-clmnbr-obj-hist:column-fgcolor = 0
     3245           .
     3246         end.
     3247         assign
     3248           cur-clmn-locbr-obj-hist = ?
     3249         .
     3250       end.
     3251     end case.
     3252       if cur-clmn-locbr-obj-hist <> ? then do:
     3253         if can-do( this-procedure:internal-entries, 'ch-clmnbr-obj-hist') then do:
     3254           run ch-clmnbr-obj-hist in this-procedure (cur-clmn-locbr-obj-hist).
     3255         end.
     3256       end.
     3257     if p-recid <> ? then do:
     3258       reposition br-obj-hist to recid p-recid no-error.
     3259       apply "value-changed" to br-obj-hist in frame Dialog-Frame.
     3260     end.
     3261     apply "entry" to br-obj-hist in frame Dialog-Frame.
     3262   END PROCEDURE.
     3263   procedure re-open-query-srt-clmnbr-obj-hist:
     3264   if cur-clmnbr-obj-hist = ? then do:
     3265      run OpenBr(yes, no, no, v-corr-user-db-num).
     3266   end.
     3267   else do:
     3268      assign re-querybr-obj-hist = yes.
     3269      run sort-brbr-obj-hist
     3270        (input (if available X_c-obj-hist
     3271                then recid(X_c-obj-hist)
     3272                else ?
     3273               )
     3274        ).
     3275      assign re-querybr-obj-hist = no.
     3276   end.
     3277   end.
     3278   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3279   do:
     3280     BR-changes :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     3281   end.
     3282   MAIN-BLOCK:
     3283   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3284      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3285      if p-mode <> 'все':U
     3286    and p-mode <> 'фирма':U
     3287    and p-mode <> "one":U
     3288    and p-mode <> "subject":U
     3289    and p-mode <> "parentbeg":U
     3290    then dO:
     3291       message
     3292       vss-workfile vss-revision vss-description skip
     3293       "Неверное значение параметров вызова p-mode"
     3294       p-mode
     3295       view-as alert-box ERROR.
     3296       return.
     3297    end.
     3298    v-rid-list = p-rid-list.
     3299     if v-rid-list <> "" then do:
     3300         FIND FIRST find_c-obj-hist No-LOCK where
     3301                    recid(find_c-obj-hist) = integer(entry(1, v-rid-list)) No-ERROR.
     3302         if not avail find_c-obj-hist then do:
     3303           message
     3304           vss-workfile vss-revision vss-description skip
     3305           "Неверное значение параметра вызова v-rid-list" v-rid-list
     3306           view-as alert-box error .
     3307           return error.
     3308         end.
     3309         v-doc-rec = integer(entry(1, v-rid-list)).
     3310       end.
     3311   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
