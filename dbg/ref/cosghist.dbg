     3575         assign
     3576           l-disable-where-27 =
     3577             (" TRUE " + " " + where-phrase-27 = "")
     3578         .
     3579         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3580                             ,input query br-obj-hist:handle
     3581                             ,input parameter-3-27
     3582                             ,input parameter-4-27
     3583                             ,input parameter-5-27
     3584                             ,input parameter-6-27
     3585                             ,input parameter-7-27
     3586                             )
     3587         .
