     3523     ,output filter-name-27
     3524     ,output where-phrase-27
     3525     ,output sort-phrase-27
     3526     ,output where-phrase-rus-27
     3527     ,output sort-phrase-rus-27
     3528     ).
     3529   if p-open-query then do:
     3530       run set-filter-name in this-procedure
     3531         (INPUT filter-name-27
     3532         ) no-error .
     3533     assign
     3534       l-filter-open-27 = false
     3535     .
     3536     if flt-rec-27 <> ?
     3537       or sort-column-phrase > ""
     3538     then do:
     3539       define variable  parameter-2-27 as character no-undo .
     3540       define variable  parameter-3-27 as character no-undo .
     3541       define variable  parameter-4-27 as character no-undo .
     3542       define variable  parameter-5-27 as character no-undo .
     3543       define variable  parameter-6-27 as character no-undo .
     3544       define variable  parameter-7-27 as character no-undo .
     3545         assign
     3546         parameter-3-27 =
     3547                                 "FOR EACH X_c-obj-hist"
     3548         parameter-4-27 =
     3549           (
     3550             if (" TRUE " + " " + where-phrase-27) <> ""
     3551             then " TRUE " + " " + where-phrase-27
     3552             else "true"
     3553           )
     3554         parameter-5-27 = (" " + "" + " " + "")
     3555         parameter-6-27 = if sort-phrase-27 = ''
     3556                              then
     3557           (
     3558           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC  " +
     3559             " " + sort-column-phrase +
