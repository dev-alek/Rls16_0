     3106        )
     3107     then do:
     3108       if self :handle <> focus :handle
     3109       then do:
     3110         apply "entry":u to self .
     3111       end.
     3112       define variable v-ok            as logical   no-undo .
     3113       define variable v-curr-sv-date  as date      no-undo .
