      602   procedure fltfield-clear :
      603     define output parameter loc-fld as character no-undo.
      604     define output parameter loc-lab as character no-undo .
      605     define output parameter loc-spr as character no-undo .
      606     define output parameter loc-dim as character no-undo .
      607     assign
      608       loc-fld = ""
      609       loc-lab = ""
      610       loc-spr = ""
      611       loc-dim = "0"
      612     .
      613   end procedure .
      614   procedure fltfield-add :
      615     define input        parameter par-fld as character no-undo.
      616     define input        parameter par-lab as character no-undo .
      617     define input        parameter par-spr as character no-undo .
      618     define input-output parameter loc-fld as character no-undo.
      619     define input-output parameter loc-lab as character no-undo .
      620     define input-output parameter loc-spr as character no-undo .
      621     define input-output parameter loc-dim as character no-undo .
      622     do
      623     on error undo, return error
      624     :
      625       assign
      626       loc-fld = if loc-dim = '0'
      627                 then par-fld
      628                 else (loc-fld + chr(44) + par-fld)
      629       loc-lab = if loc-dim = '0'
      630                 then par-lab
      631                 else (loc-lab + chr(44) + par-lab)
      632       loc-spr = if loc-dim = '0'
      633                 then par-spr
      634                 else (loc-spr + chr(44) + par-spr)
      635       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      636                 string(integer(if num-entries(loc-dim) > 1
      637                               then entry(2, loc-dim)
      638                               else entry(1, loc-dim)
      639                               ) + 1)
      640       no-error
      641       .
      642     end.
      643   end procedure.
