        1   DEFINE BUFFER X_country FOR ub.country.
        2   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        3   define input  parameter bttns    as character no-undo .
        4   define input-output parameter p-rid-list  as character    no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Справочник стран".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29       assign
       30         p-vss-parameters = substitute('&1',bttns)
       31       .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define   shared variable g#auto as logical no-undo.
       75   define   shared variable g#news as logical no-undo.
       76   define   shared variable g#oxml as logical no-undo.
       77   define   shared variable g#esys as logical no-undo.
       78   define   shared variable g#news-source-db as integer no-undo.
       79   define   shared variable g#esys-source-esys as integer no-undo.
       80   define   shared variable g#db-num as integer   no-undo .
       81   define   shared variable g#userid as character no-undo .
       82   define   shared variable g#passwd as character no-undo .
       83   procedure proc-alt-shift-f2:
       84     if not ibs.th.gbl.gbl-var:rcode
       85   then
       86     run gbl\inidebug.p .
       87   end.
       88   procedure proc-alt-shift-f3:
       89     run gbl/prvssinf.p
       90       ( input this-procedure
       91       ) .
       92   end.
       93   define variable v-inform-launched as logical no-undo initial false .
       94   procedure proc-alt-shift-f4:
       95     define variable v-action as character no-undo .
       96     if v-inform-launched = false then do:
       97       assign
       98         v-inform-launched = true
       99       .
      100       run gbl/d-inform.w
      101         (  input self
      102         ,  input this-procedure
      103         , output v-action
      104         ) no-error .
      105       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      106       assign
      107         v-inform-launched = false
      108       .
      109     end.
      110   end.
      111   procedure proc-alt-f1:
      112     run gbl/corrhelp.p
      113       (input this-procedure
      114       ) .
      115   end .
      116   on alt-shift-f2 anywhere do:
      117     run proc-alt-shift-f2.
      118   end.
      119   on alt-shift-f3 anywhere do:
      120     run proc-alt-shift-f3 in this-procedure .
      121   end.
      122   on alt-shift-f4 anywhere do:
      123     run proc-alt-shift-f4 in this-procedure.
      124   end.
      125   on alt-f1 anywhere do:
      126     run proc-alt-f1 in this-procedure .
      127   end.
      128   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      129     define variable v-cntxt-db-num        as integer   no-undo .
      130     define variable v-cntxt-userid        as character no-undo .
      131     define variable v-cntxt-level         as character no-undo .
      132     define variable v-cntxt-host-code-obj as integer   no-undo .
      133     define variable v-cntxt-obj-type      as character no-undo .
      134     define variable v-cntxt-obj-code      as integer   no-undo .
      135     define variable v-cntxt-db-num-obj    as integer   no-undo .
      136     define variable v-cntxt-is-admin      as logical   no-undo .
      137   define variable lns-cnt as integer no-undo .
      138   define variable line-rec as recid no-undo .
      139   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      140   def new shared  temp-table cntrlist no-undo like ub.country
      141     field to-del as logical
      142     index obj  is primary unique alpha1
      143     index iname      short-name
      144     .
      145   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      146   define  new shared   temp-table cntrlist-hist no-undo
      147   field list-table as character
      148   field id as integer
      149   field line as integer
      150   field hist-mode as character
      151   field des as character
      152   field num-recs as integer
      153   field option_ as character
      154   field item_ as character
      155   field status_ as character
      156   field num-add as integer
      157   field num-ignored as integer
      158   field done as logical
      159   field err_ as logical
      160   field err-mes as character
      161   index pi is primary
      162   id
      163   line
      164   index isdone
      165   done
      166   .
      167   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      168   FUNCTION mark-string RETURNS CHARACTER
      169     ( input p-recid as recid, input mark-list as character  ) :
      170     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      171   END FUNCTION.
      172   define variable v-country-recid as recid  no-undo .
      173   define variable v-rec           as recid no-undo .
      174   DEFINE VARIABLE rum-option AS CHARACTER NO-UNDO.
      175   define buffer buf_country for country.
      176   define variable v-rid-list as character no-undo .
      177   DEFINE MENU MENU-B-rum
      178          MENU-ITEM m_xml-file-export LABEL "Экспорт в XML-файл"
      179          MENU-ITEM m_batchwork-routing LABEL "Маршрутизация в ВС".
      180   DEFINE BUTTON B-add
      181        LABEL "&Добавить"
      182        SIZE 10 BY 1.
      183   DEFINE BUTTON B-chg
      184        LABEL "&Изменить"
      185        SIZE 10 BY 1.
      186   DEFINE BUTTON B-exit AUTO-GO
      187        LABEL "&Выход "
      188        SIZE 10 BY 1
      189        BGCOLOR 8 .
      190   DEFINE BUTTON B-help
      191        LABEL "Помо&щь"
      192        SIZE 3 BY 1
      193        BGCOLOR 8 .
      194   DEFINE BUTTON B-hist
      195        LABEL "Ис&тория"
      196        SIZE 3 BY 1.
      197   DEFINE BUTTON B-mark
      198        LABEL "&*"
      199        SIZE 3 BY 1.
      200   DEFINE BUTTON B-rum
      201        LABEL "&Операции"
      202        SIZE 10 BY 1.
      203   DEFINE BUTTON B-sel AUTO-GO
      204        LABEL "&Вы&бор "
      205        SIZE 10 BY 1.
      206   DEFINE VARIABLE loc-alpha-1 AS CHARACTER FORMAT "X(2)":U
      207        LABEL "Букв. код. 1"
      208         VIEW-AS TEXT
      209        SIZE 3.9 BY .67
      210        FGCOLOR 12  NO-UNDO.
      211   DEFINE VARIABLE loc-name AS CHARACTER FORMAT "X(40)":U
      212        LABEL "Назв."
      213        VIEW-AS FILL-IN
      214        SIZE 30.4 BY 1
      215        FGCOLOR 12  NO-UNDO.
      216   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
      217         VIEW-AS TEXT
      218        SIZE 6 BY 1
      219        FGCOLOR 4  NO-UNDO.
      220   DEFINE VARIABLE a-n-c AS CHARACTER
      221        VIEW-AS RADIO-SET HORIZONTAL
      222        RADIO-BUTTONS
      223             "Букв. код 1", "alpha1",
      224   "Назв.", "name"
      225        SIZE 23.3 BY 1 NO-UNDO.
      226   DEFINE VARIABLE t-pck AS LOGICAL INITIAL no
      227        LABEL "Пктн.рж"
      228        VIEW-AS TOGGLE-BOX
      229        SIZE 13 BY 1 NO-UNDO.
      230   DEFINE QUERY BR-countries FOR
      231         X_country SCROLLING.
      232   DEFINE BROWSE BR-countries
      233     QUERY BR-countries DISPLAY
      234         mark-string(recid(X_country), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
      235         X_country.alpha1 COLUMN-LABEL "Код!страны-1" FORMAT "X(2)":U
      236         X_country.alpha2 COLUMN-LABEL "Код!страны-2" FORMAT "X(3)":U
      237         X_country.short-name FORMAT "X(25)":U
      238         X_country.long-name FORMAT "X(40)":U
      239         X_country.num-code COLUMN-LABEL "Цифр!код" FORMAT "999":U
      240       WITH NO-ROW-MARKERS SEPARATORS SIZE 90.4 BY 20.
      241   DEFINE FRAME Dialog-Frame
      242        B-exit AT ROW 1 COL 1
      243        B-mark AT ROW 1 COL 11 WIDGET-ID 6
      244        B-sel AT ROW 1 COL 14
      245        B-add AT ROW 1 COL 24
      246        B-chg AT ROW 1 COL 34
      247        t-pck AT ROW 1 COL 48 WIDGET-ID 10
      248        B-rum AT ROW 1 COL 61 WIDGET-ID 4
      249        B-hist AT ROW 1 COL 85
      250        B-help AT ROW 1 COL 88
      251        a-n-c AT ROW 2 COL 10 NO-LABEL
      252        loc-name AT ROW 2 COL 60 COLON-ALIGNED
      253        BR-countries AT ROW 3.5 COL 1
      254        loc-alpha-1 AT ROW 2 COL 49 COLON-ALIGNED
      255        mark-num AT ROW 2.07 COL 1 NO-LABEL WIDGET-ID 8
      256        SPACE(85.49) SKIP(20.59)
      257       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      258            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      259            TITLE "Классификатор стран"
      260            DEFAULT-BUTTON B-exit.
      261   ASSIGN
      262          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      263          FRAME Dialog-Frame:HIDDEN           = TRUE.
      264   ASSIGN
      265          B-rum:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-rum:HANDLE.
      266   ASSIGN
      267          loc-name:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      268   ON GO OF FRAME Dialog-Frame
      269   DO:
      270     p-rid-list = v-rid-list.
      271   END.
      272   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      273   DO:
      274     APPLY "END-ERROR":U TO SELF.
      275   END.
      276   ON VALUE-CHANGED OF a-n-c IN FRAME Dialog-Frame
      277   DO:
      278     case input frame Dialog-Frame a-n-c :
      279       when "alpha1" then do:
      280         apply "entry" to br-countries in frame Dialog-Frame.
      281         hide loc-name in frame Dialog-Frame.
      282         loc-alpha-1 = "".
      283       end.
      284       when "name" then do:
      285         enable loc-name with frame Dialog-Frame.
      286         disp loc-name with frame Dialog-Frame.
      287         hide loc-alpha-1 in frame Dialog-Frame.
      288         apply "entry" to loc-name in frame Dialog-Frame.
      289       end.
      290     END CASE.
      291   END.
      292   ON CHOOSE OF B-add IN FRAME Dialog-Frame
      293   DO:
      294     define variable v-ok as logical no-undo .
      295   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      296   do:
      297     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      298       (input  v-cntxt-db-num
      299       ,input  v-cntxt-userid
      300       ,input  0
      301       ,input  'actn_country-reference_work':U
      302       ,input  'global':U
      303       ,input  0
      304       ,input  '':U
      305       ,input  0
      306       ,input  0
      307       ,input  0
      308       ,input  0
      309       ,input  true
      310       ,output v-ok
      311       )  .
      312   end.
      313     if v-ok <> true
      314     then do:
      315       undo, return no-apply .
      316     end.
      317     if not ( g#db-num > 0 )
      318     then do:
      319       run ref/country.w
      320         (input parparentproc
      321         ,input        'ДОБАВЛЕНИЕ':U
      322         ,input 0
      323         ,input-output v-country-recid
      324         ).
      325       if v-country-recid <> ?
      326       then do:
      327         OPEN QUERY BR-countries FOR EACH X_country NO-LOCK     BY X_country.short-name.
      328         reposition br-countries to recid v-country-recid .
      329         v-ok = br-countries:select-focused-row( ).
      330         apply "ENTRY":U to br-countries.
      331         apply "VALUE-CHANGED":U to br-countries.
      332       end.
      333     end.
      334   END.
      335   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
      336   DO:
      337     define variable v-ok as logical   no-undo .
      338   define variable vss-include-info5 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      339   do:
      340     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      341       (input  v-cntxt-db-num
      342       ,input  v-cntxt-userid
      343       ,input  0
      344       ,input  'actn_country-reference_work':U
      345       ,input  'global':U
      346       ,input  0
      347       ,input  '':U
      348       ,input  0
      349       ,input  0
      350       ,input  0
      351       ,input  0
      352       ,input  true
      353       ,output v-ok
      354       )  .
      355   end.
      356     if v-ok <> true
      357     then do:
      358       undo, return no-apply .
      359     end.
      360     if not available X_country
      361     then do:
      362       return no-apply.
      363     end.
      364     assign
      365       v-country-recid = recid( X_country )
      366     .
      367     if NOT ( g#db-num > 0 ) then do:
      368       run ref/country.w
      369         (input parparentproc
      370         ,input        'ИЗМЕНЕНИЕ':U
      371         ,input X_country.alpha1
      372         ,input-output v-country-recid
      373         ).
      374     end.
      375     DISPLAY
      376     X_country.alpha1
      377     X_country.alpha2
      378     X_country.short-name
      379     X_country.long-name
      380       with browse br-countries.
      381   END.
      382   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
      383   DO:
      384     DEFINE VARIABLE v-rid-list AS CHARACTER NO-undo.
      385       IF AVAILABLE X_country THEN DO:
      386         run ref/ccountrs.w (
      387                        INPUT parparentproc
      388                       ,INPUT '':U
      389                       ,INPUT 'one':U
      390                       ,INPUT X_country.num-code
      391                       ,INPUT-OUTPUT v-rid-list) NO-ERROR.
      392     END.
      393   END.
      394   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
      395   DO:
      396   define variable glog as logical no-undo .
      397     if available X_country then do:
      398   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      399   define variable v-str-recid7 as character no-undo .
      400   define variable v-num-entry7 as integer   no-undo .
      401   assign
      402     v-str-recid7 = trim( string( recid( X_country ) , "->>>>>>>>>>>9":U ) )
      403     v-num-entry7 = lookup( v-str-recid7 , v-rid-list )
      404   .
      405   if v-num-entry7 > 0 then do:
      406     assign
      407       entry( v-num-entry7, v-rid-list ) = "":U
      408       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      409     .
      410   end.
      411   else do:
      412     assign
      413       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid7
      414     .
      415   end.
      416       glog = br-countries:refresh() .
      417       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      418           glog = br-countries:select-next-row ().
      419           apply "VALUE-CHANGED" to br-countries in frame Dialog-Frame.
      420       end.
      421       if num-entries( v-rid-list ) = 0
      422       then
      423           hide mark-num in frame Dialog-Frame.
      424       else
      425           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
      426     end.
      427     apply "entry" to br-countries in frame Dialog-Frame.
      428   END.
      429   ON CHOOSE OF B-rum IN FRAME Dialog-Frame
      430   DO:
      431     if rum-option = "":U then do:
      432       run gbl/pop-up.p ( input self :handle, input no ) no-error.
      433       if error-status :error then do: return no-apply. end.
      434     end.
      435     if rum-option = "":U then do:
      436         return no-apply.
      437     end.
      438     RUN proc-b-rum IN THIS-PROCEDURE ( INPUT rum-option) NO-ERROR.
      439     IF ERROR-STATUS:ERROR THEN DO:
      440         rum-option = "".
      441         RETURN NO-APPLY.
      442     END.
      443     rum-option = "".
      444   END.
      445   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
      446   DO:
      447    if ( available X_country ) then do:
      448       if  ( v-rid-list = "" ) or b-mark:sensitive = no
      449       then
      450       v-rid-list = string( recid( X_country ) ) .
      451     end.
      452   END.
      453   ON ITERATION-CHANGED OF BR-countries IN FRAME Dialog-Frame
      454   DO:
      455     if not avail X_country or recid (X_country) <> v-rec then do:
      456       hide loc-alpha-1 in frame Dialog-Frame.
      457       loc-alpha-1 = "".
      458     end.
      459   END.
      460   ON LEFT-MOUSE-DBLCLICK OF BR-countries IN FRAME Dialog-Frame
      461   DO:
      462      if b-sel:sensitive then
      463           apply "CHOOSE":U to b-sel.
      464   END.
      465   ON RETURN OF BR-countries IN FRAME Dialog-Frame
      466   DO:
      467      if b-sel:sensitive then
      468           apply "CHOOSE":U to b-sel.
      469   END.
      470   ON CTRL-J OF loc-name IN FRAME Dialog-Frame
      471   DO:
      472     assign loc-name a-n-c.
      473     FIND NEXT buf_country No-LOCK WHERE
      474                buf_country.short-name begins loc-name No-ERROR.
      475     if avail buf_country then do:
      476       assign
      477       v-rec = recid (buf_country).
      478       reposition br-countries to recid v-rec no-error.
      479       APPLY "ENTRY" to br-countries.
      480     end.
      481     else do:
      482          message "Строка не найдена.".
      483          apply "entry" to loc-name in frame Dialog-Frame.
      484     end.
      485      return no-apply.
      486   END.
      487   ON MOUSE-SELECT-DBLCLICK OF loc-name IN FRAME Dialog-Frame
      488   DO:
      489     APPLY "RETURN" to loc-name.
      490   END.
      491   ON RETURN OF loc-name IN FRAME Dialog-Frame
      492   DO:
      493     assign loc-name a-n-c.
      494     FIND FIRST buf_country No-LOCK WHERE
      495                buf_country.short-name begins loc-name No-ERROR.
      496     if avail buf_country then do:
      497       assign
      498       v-rec = recid (buf_country).
      499       reposition br-countries to recid v-rec no-error.
      500       APPLY "ENTRY" to br-countries.
      501     end.
      502     else do:
      503          message "Строка не найдена.".
      504          apply "entry" to loc-name in frame Dialog-Frame.
      505      end.
      506     return no-apply.
      507   END.
      508   ON CHOOSE OF MENU-ITEM m_batchwork-routing
      509   DO:
      510     rum-option = 'batchwork-routing':U.
      511     RUN proc-b-rum IN THIS-PROCEDURE ( INPUT rum-option) NO-ERROR.
      512     IF ERROR-STATUS:ERROR THEN DO:
      513         rum-option = "".
      514         RETURN NO-APPLY.
      515     END.
      516     rum-option = "".
      517   END.
      518   ON CHOOSE OF MENU-ITEM m_xml-file-export
      519   DO:
      520     rum-option = 'batchwork-export':U.
      521     RUN proc-b-rum IN THIS-PROCEDURE ( INPUT rum-option) NO-ERROR.
      522     IF ERROR-STATUS:ERROR THEN DO:
      523         rum-option = "".
      524         RETURN NO-APPLY.
      525     END.
      526     rum-option = "".
      527   END.
      528   ON VALUE-CHANGED OF t-pck IN FRAME Dialog-Frame
      529   DO:
      530     ASSIGN
      531     t-pck
      532     b-mark:SENSITIVE IN FRAME Dialog-Frame = (t-pck OR LOOKUP("b-mark", bttns) > 0)
      533     .
      534   END.
      535   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      536   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      537   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      538   on help of frame Dialog-Frame
      539   do:
      540     run gbl/app_help.p
      541       (input this-procedure :file-name
      542       ,input ''
      543       ,input ?
      544       ) no-error.
      545     if error-status :error then do:
      546       message
      547         "Ошибка при вызове помощи"
      548         error-status :get-message(1)
      549         view-as alert-box .
      550     end.
      551   end.
      552   run minbtn-set in this-procedure .
      553   on choose of b-help in frame Dialog-Frame
      554   do:
      555     apply "help":u to frame Dialog-Frame .
      556   end.
      557   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      558   procedure minbtn-set :
      559       do
      560           on error undo, return error return-value
      561           :
      562           define variable ii              as integer       no-undo .
      563           define variable fh              as widget-handle no-undo .
      564           define variable hh              as widget-handle no-undo .
      565           define variable v-h             as handle        extent 4 no-undo .
      566           define variable v-name-button   as character     no-undo .
      567           define variable v-help-old-x    as decimal       no-undo .
      568           define variable v-help-old-y    as decimal       no-undo .
      569           define variable v-help-old-size as decimal       no-undo .
      570           define variable v-frame-width   as decimal       no-undo .
      571           define variable jj              as integer       no-undo .
      572           do
      573               on error undo, return error
      574               :
      575               assign
      576                   v-frame-width = frame Dialog-Frame:width - 0.3
      577                   fh            = frame Dialog-Frame:first-child
      578                   hh            = fh:first-child
      579                   ii            = 1
      580                   .
      581               do while valid-handle(hh):
      582                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      583                   do:
      584                       case lc(hh:name) :
      585                           when "b-help" then
      586                               do:
      587                                   hh:load-image-up("cmp/b-help.bmp":u) .
      588                                   hh:load-image-down("cmp/b-help.bmp":u) .
      589                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      590                                   hh:TOOLTIP = "Помощь" .
      591                                   v-help-old-x = hh:column .
      592                                   v-help-old-y = hh:row    .
      593                                   v-help-old-size = hh:width .
      594                                   hh:width-chars = 2.5 .
      595                               end.
      596                           when "b-print" then
      597                               do:
      598                                   hh:load-image("cmp/b-print.bmp":u) .
      599                                   hh:TOOLTIP = "Печать" .
      600                                   v-h[ii] = hh:handle .
      601                                   ii = ii + 1 .
      602                                   hh:width-chars = 3 .
      603                               end.
      604                           when "b-history" or
      605                           when "b-hist" then
      606                               do:
      607                                   hh:load-image("cmp/b-hist.bmp":u) .
      608                                   hh:TOOLTIP = "История" .
      609                                   v-h[ii] = hh:handle .
      610                                   ii = ii + 1 .
      611                                   hh:width-chars = 3 .
      612                               end.
      613                           when "b-sch" then
      614                               do:
      615                                   hh:load-image("cmp/b-sch.bmp":u) .
      616                                   hh:TOOLTIP = "Установка Фильтра" .
      617                                   v-h[ii] = hh:handle .
      618                                   ii = ii + 1 .
      619                                   hh:width-chars = 3 .
      620                               end.
      621                           when "b-hist-user" then
      622                               do:
      623                                   hh:load-image("cmp/b-hist.bmp":u) .
      624                                   hh:TOOLTIP = "История пользователя" .
      625                                   ii = ii + 1 .
      626                               end.
      627                       end case.
      628                   end.
      629                   hh = hh:next-sibling.
      630               end.
      631               b-help:column = v-frame-width - b-help:width-chars.
      632               jj = 0.
      633               repeat ii = 4 to 1 by -1 :
      634                   if valid-handle (v-h[ii] ) then
      635                   do:
      636                       jj  = jj + 1 .
      637                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      638                       v-h[ii]:row    = v-help-old-y .
      639                   end.
      640               end.
      641           end.
      642       end.
      643   end procedure.
      644   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      645   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      646   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      647   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      648   define variable v-diasize-current-frame-width  as decimal   no-undo .
      649   define variable v-diasize-current-frame-height as decimal   no-undo .
      650   define variable v-diasize-change-size          as logical   no-undo .
      651   define variable v-diasize-resize-button        as handle    no-undo .
      652   define variable v-diasize-wndmax               as logical   no-undo .
      653   define variable v-diasize-wndstore             as logical   no-undo .
      654   define variable v-diasize-proc-name            as character no-undo .
      655   define variable v-diasize-browse-handle        as handle    no-undo .
      656   define variable v-diasize-browse-number        as integer   no-undo .
      657   define variable v-diasize-need-full-display    as logical   no-undo init false .
      658   define temp-table temp-diasize-handle no-undo
      659     field handle-value  as handle
      660     field save-position as decimal
      661     index xpk is primary unique handle-value
      662     .
      663   define temp-table temp-browse-handle no-undo
      664     field browse-type   as character
      665     field browse-number as integer
      666     field browse-handle as handle
      667     field original-size as decimal
      668     index xpk is primary unique browse-type browse-number
      669     index xie browse-type browse-handle
      670   .
      671   procedure diasize_change-height :
      672     define input  parameter p-change-value  as decimal   no-undo .
      673     define input  parameter p-move-resize   as logical   no-undo .
      674     define variable v-field-group-handle    as handle    no-undo .
      675     define variable v-object-handle         as handle    no-undo .
      676     define variable v-frame-height          as decimal   no-undo .
      677     define variable v-frame-virtual-height  as decimal   no-undo .
      678     define variable v-browse-height         as decimal   no-undo .
      679     define variable v-window-height         as decimal   no-undo .
      680     define variable v-window-virtual-height as decimal   no-undo .
      681     define variable v-change-sign           as integer   no-undo .
      682     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      683     define buffer buf_temp-browse-handle  for temp-browse-handle .
      684     if p-change-value > 0
      685     then do:
      686       if frame Dialog-Frame :height + p-change-value
      687           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      688       then do:
      689         assign
      690           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      691                           - (frame Dialog-Frame :height-chars)
      692         .
      693         if p-change-value <= 0
      694         then do:
      695           run diasize_position-resize-button in this-procedure .
      696           return .
      697         end.
      698       end.
      699     end.
      700     if p-change-value < 0
      701     then do:
      702       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      703       then do:
      704         assign
      705           p-change-value = v-diasize-orig-frame-height
      706                          - (frame Dialog-Frame :height-chars)
      707         .
      708         if p-change-value >= 0
      709         then do:
      710           run diasize_position-resize-button in this-procedure .
      711           return .
      712         end.
      713       end.
      714     end.
      715     if p-change-value >= 0
      716     then do:
      717       assign
      718         v-change-sign = 1
      719       .
      720     end.
      721     else do:
      722       assign
      723         v-change-sign = -1
      724       .
      725     end.
      726     assign
      727       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      728     .
      729     if p-change-value = 0
      730     then do:
      731       run diasize_position-resize-button in this-procedure .
      732       return .
      733     end.
      734     move_block:
      735     do
      736     on error undo move_block, retry move_block
      737     :
      738       if retry
      739       then do:
      740         do
      741         on error undo move_block, leave move_block
      742         :
      743           if p-change-value > 0
      744           then do:
      745             for each buf_temp-diasize-handle
      746             on error undo, next
      747             :
      748               assign
      749                 v-object-handle = buf_temp-diasize-handle.handle-value
      750               .
      751               if v-object-handle <> v-diasize-resize-button
      752               then do:
      753                 assign
      754                   v-object-handle :row = buf_temp-diasize-handle.save-position
      755                 .
      756               end.
      757             end.
      758             assign
      759               v-diasize-browse-handle :height = v-browse-height
      760             .
      761             for each buf_temp-browse-handle
      762               where buf_temp-browse-handle.browse-type = 'height':u
      763             on error undo, next
      764             :
      765               assign
      766                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      767               .
      768             end.
      769             assign
      770               frame Dialog-Frame :height = v-frame-height
      771             .
      772             if frame Dialog-Frame :scrollable = true
      773             then do:
      774               assign
      775                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      776               .
      777             end.
      778             run diasize_position-resize-button in this-procedure .
      779           end.
      780           else do:
      781             if frame Dialog-Frame :scrollable = true
      782             then do:
      783               assign
      784                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      785               .
      786             end.
      787             assign
      788               frame Dialog-Frame :height = v-frame-height
      789             .
      790             assign
      791               v-diasize-browse-handle :height = v-browse-height
      792             .
      793             for each buf_temp-browse-handle
      794               where buf_temp-browse-handle.browse-type = 'height':u
      795             on error undo, next
      796             :
      797               assign
      798                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      799               .
      800             end.
      801             for each buf_temp-diasize-handle
      802             on error undo, next
      803             :
      804               assign
      805                 v-object-handle = buf_temp-diasize-handle.handle-value
      806               .
      807               if v-object-handle <> v-diasize-resize-button
      808               then do:
      809                 assign
      810                   v-object-handle :row = buf_temp-diasize-handle.save-position
      811                 .
      812               end.
      813             end.
      814             run diasize_position-resize-button in this-procedure .
      815           end.
      816           assign
      817             v-diasize-change-size = false
      818           .
      819           leave move_block .
      820         end.
      821       end.
      822       assign
      823         v-diasize-need-full-display = true
      824       .
      825       if v-diasize-change-size = false
      826       then do:
      827         assign
      828           v-diasize-change-size = true
      829         .
      830       end.
      831       else do:
      832         return .
      833       end.
      834       assign
      835         v-frame-height = frame Dialog-Frame :height
      836         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      837         v-browse-height = v-diasize-browse-handle :height
      838       .
      839       for each buf_temp-browse-handle
      840         where buf_temp-browse-handle.browse-type = 'height':u
      841       :
      842         assign
      843           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      844         .
      845       end.
      846       for each buf_temp-diasize-handle
      847       :
      848         delete buf_temp-diasize-handle .
      849       end.
      850       assign
      851         v-field-group-handle = frame Dialog-Frame :first-child
      852       .
      853       do while valid-handle(v-field-group-handle)
      854       :
      855         assign
      856           v-object-handle = v-field-group-handle :first-child
      857         .
      858         do while valid-handle(v-object-handle)
      859         :
      860           if  v-object-handle <> v-diasize-browse-handle :handle
      861           and can-query(v-object-handle, "row")
      862           and can-query(v-object-handle, "height")
      863           and ( v-object-handle :row > v-diasize-browse-handle :row )
      864           then do:
      865             find first buf_temp-browse-handle
      866               where buf_temp-browse-handle.browse-type   = 'height':u
      867                 and buf_temp-browse-handle.browse-handle = v-object-handle
      868               no-error .
      869             if available buf_temp-browse-handle
      870             then do:
      871             end.
      872             else do:
      873               create buf_temp-diasize-handle .
      874               assign
      875                 buf_temp-diasize-handle.handle-value  = v-object-handle
      876                 buf_temp-diasize-handle.save-position = v-object-handle :row
      877               .
      878             end.
      879           end.
      880           assign
      881             v-object-handle = v-object-handle :next-sibling
      882           .
      883         end.
      884         assign
      885           v-field-group-handle = v-field-group-handle :next-sibling
      886         .
      887       end.
      888       do with frame Dialog-Frame
      889       :
      890         hide v-diasize-resize-button .
      891         assign
      892           v-diasize-resize-button :row    = 1
      893           v-diasize-resize-button :column = 1
      894         .
      895       end.
      896       if p-change-value > 0
      897       then do:
      898         if frame Dialog-Frame :scrollable = true
      899         then do:
      900           assign
      901             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      902             no-error .
      903           if error-status :error
      904           or error-status :get-message(1) <> ""
      905           then do:
      906             undo move_block, retry move_block .
      907           end.
      908         end.
      909         assign
      910           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      911           no-error .
      912         if error-status :error
      913         or error-status :get-message(1) <> ""
      914         then do:
      915           undo move_block, retry move_block .
      916         end.
      917         assign
      918           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      919           no-error .
      920         if error-status :error
      921         or error-status :get-message(1) <> ""
      922         then do:
      923           undo move_block, retry move_block .
      924         end.
      925         for each buf_temp-browse-handle
      926           where buf_temp-browse-handle.browse-type = 'height':u
      927         on error undo move_block, retry move_block
      928         :
      929           assign
      930             buf_temp-browse-handle.browse-handle :height
      931               = buf_temp-browse-handle.browse-handle :height + p-change-value
      932             no-error .
      933           if error-status :error
      934           or error-status :get-message(1) <> ""
      935           then do:
      936             undo move_block, retry move_block .
      937           end.
      938         end.
      939         for each buf_temp-diasize-handle
      940         on error undo move_block, retry move_block
      941         :
      942           assign
      943             v-object-handle = buf_temp-diasize-handle.handle-value
      944           .
      945           if v-object-handle <> v-diasize-resize-button
      946           then do:
      947             assign
      948               v-object-handle :row = v-object-handle :row + p-change-value
      949               no-error .
      950             if error-status :error
      951             or error-status :get-message(1) <> ""
      952             then do:
      953               undo move_block, retry move_block .
      954             end.
      955           end.
      956         end.
      957       end.
      958       else do:
      959         for each buf_temp-diasize-handle
      960         on error undo move_block, retry move_block
      961         :
      962           assign
      963             v-object-handle = buf_temp-diasize-handle.handle-value
      964           .
      965           if v-object-handle <> v-diasize-resize-button
      966           then do:
      967             assign
      968               v-object-handle :row = v-object-handle :row + p-change-value
      969               no-error .
      970             if error-status :error
      971             or error-status :get-message(1) <> ""
      972             then do:
      973               undo move_block, retry move_block .
      974             end.
      975           end.
      976         end.
      977         assign
      978           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      979           no-error .
      980         if error-status :error
      981         or error-status :get-message(1) <> ""
      982         then do:
      983           undo move_block, retry move_block .
      984         end.
      985         for each buf_temp-browse-handle
      986           where buf_temp-browse-handle.browse-type = 'height':u
      987         on error undo move_block, retry move_block
      988         :
      989           assign
      990             buf_temp-browse-handle.browse-handle :height
      991               = buf_temp-browse-handle.browse-handle :height + p-change-value
      992             no-error .
      993           if error-status :error
      994           or error-status :get-message(1) <> ""
      995           then do:
      996             undo move_block, retry move_block .
      997           end.
      998         end.
      999         assign
     1000           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1001           no-error .
     1002         if error-status :error
     1003         or error-status :get-message(1) <> ""
     1004         then do:
     1005           undo move_block, retry move_block .
     1006         end.
     1007         if frame Dialog-Frame :scrollable = true
     1008         then do:
     1009           assign
     1010             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1011             no-error .
     1012           if error-status :error
     1013           or error-status :get-message(1) <> ""
     1014           then do:
     1015             undo move_block, retry move_block .
     1016           end.
     1017         end.
     1018       end.
     1019       if p-move-resize = true
     1020       then do:
     1021         run diasize_position-resize-button in this-procedure .
     1022       end.
     1023       if v-diasize-wndstore = true
     1024       then do:
     1025         if connected("ub") = true
     1026         then do:
     1027           define variable v-cntxt-db-num        as integer   no-undo .
     1028           define variable v-cntxt-userid        as character no-undo .
     1029           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1030                                             , OUTPUT v-cntxt-userid
     1031                                             ) .
     1032           run gbl/wndsizew.p
     1033             (input  v-cntxt-db-num
     1034             ,input  v-cntxt-userid
     1035             ,input  v-diasize-proc-name
     1036             ,input  'height':u
     1037             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1038             ) .
     1039         end.
     1040       end.
     1041     end.
     1042     assign
     1043       v-diasize-change-size = false
     1044     .
     1045   end procedure.
     1046   procedure diasize_set-height :
     1047     define input  parameter p-new-height  as decimal   no-undo .
     1048     define input  parameter p-move-resize as logical   no-undo .
     1049     do
     1050     on error undo, return error return-value
     1051     :
     1052       run diasize_change-height in this-procedure
     1053         (input  (p-new-height - frame Dialog-Frame :height)
     1054         ,input  p-move-resize
     1055         ) .
     1056     end.
     1057   end procedure.
     1058   procedure diasize_change-width :
     1059     define input  parameter p-change-value as decimal   no-undo .
     1060     define input  parameter p-move-resize  as logical   no-undo .
     1061     define variable v-field-group-handle   as handle    no-undo .
     1062     define variable v-object-handle        as handle    no-undo .
     1063     define variable v-frame-width          as decimal   no-undo .
     1064     define variable v-frame-virtual-width  as decimal   no-undo .
     1065     define variable v-browse-width         as decimal   no-undo .
     1066     define variable v-window-width         as decimal   no-undo .
     1067     define variable v-window-virtual-width as decimal   no-undo .
     1068     define variable v-change-sign          as integer   no-undo .
     1069     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1070     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1071     if p-change-value > 0
     1072     then do:
     1073       if frame Dialog-Frame :width + p-change-value >
     1074           session :width-chars
     1075       then do:
     1076         assign
     1077           p-change-value = session :width-chars - frame Dialog-Frame :width
     1078         .
     1079         if p-change-value <= 0
     1080         then do:
     1081           run diasize_position-resize-button in this-procedure .
     1082           return .
     1083         end.
     1084       end.
     1085     end.
     1086     if p-change-value < 0
     1087     then do:
     1088       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1089       then do:
     1090         assign
     1091           p-change-value = v-diasize-orig-frame-width
     1092                          - frame Dialog-Frame :width
     1093         .
     1094         if p-change-value >= 0
     1095         then do:
     1096           run diasize_position-resize-button in this-procedure .
     1097           return .
     1098         end.
     1099       end.
     1100     end.
     1101     if p-change-value >= 0
     1102     then do:
     1103       assign
     1104         v-change-sign = 1
     1105       .
     1106     end.
     1107     else do:
     1108       assign
     1109         v-change-sign = -1
     1110       .
     1111     end.
     1112     assign
     1113       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1114     .
     1115     if p-change-value = 0
     1116     then do:
     1117       run diasize_position-resize-button in this-procedure .
     1118       return .
     1119     end.
     1120     move_block:
     1121     do
     1122     on error undo move_block, leave move_block
     1123     :
     1124       if retry
     1125       then do:
     1126         do
     1127         on error undo move_block, leave move_block
     1128         :
     1129           if p-change-value > 0
     1130           then do:
     1131             for each buf_temp-diasize-handle
     1132             on error undo, next
     1133             :
     1134               assign
     1135                 v-object-handle = buf_temp-diasize-handle.handle-value
     1136               .
     1137               if v-object-handle <> v-diasize-resize-button
     1138               then do:
     1139                 assign
     1140                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1141                 .
     1142               end.
     1143             end.
     1144             assign
     1145               v-diasize-browse-handle :width = v-browse-width
     1146             .
     1147             for each buf_temp-browse-handle
     1148               where buf_temp-browse-handle.browse-type = 'width':u
     1149             on error undo, next
     1150             :
     1151               assign
     1152                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1153               .
     1154             end.
     1155             assign
     1156               frame Dialog-Frame :width = v-frame-width
     1157             .
     1158             if frame Dialog-Frame :scrollable = true
     1159             then do:
     1160               assign
     1161                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1162               .
     1163             end.
     1164             run diasize_position-resize-button in this-procedure .
     1165           end.
     1166           else do:
     1167             if frame Dialog-Frame :scrollable = true
     1168             then do:
     1169               assign
     1170                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1171               .
     1172             end.
     1173             assign
     1174               frame Dialog-Frame :width = v-frame-width
     1175             .
     1176             for each buf_temp-browse-handle
     1177               where buf_temp-browse-handle.browse-type = 'width':u
     1178             on error undo, next
     1179             :
     1180               assign
     1181                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1182               .
     1183             end.
     1184             assign
     1185               v-diasize-browse-handle :width = v-browse-width
     1186             .
     1187             for each buf_temp-diasize-handle
     1188             on error undo, next
     1189             :
     1190               assign
     1191                 v-object-handle = buf_temp-diasize-handle.handle-value
     1192               .
     1193               if v-object-handle <> v-diasize-resize-button
     1194               then do:
     1195                 assign
     1196                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1197                 .
     1198               end.
     1199             end.
     1200             run diasize_position-resize-button in this-procedure .
     1201           end.
     1202           assign
     1203             v-diasize-change-size = false
     1204           .
     1205           leave move_block .
     1206         end.
     1207       end.
     1208       assign
     1209         v-diasize-need-full-display = true
     1210       .
     1211       if v-diasize-change-size = false
     1212       then do:
     1213         assign
     1214           v-diasize-change-size = true
     1215         .
     1216       end.
     1217       else do:
     1218         return .
     1219       end.
     1220       assign
     1221         v-frame-width = frame Dialog-Frame :width
     1222         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1223         v-browse-width = v-diasize-browse-handle :width
     1224       .
     1225       for each buf_temp-browse-handle
     1226         where buf_temp-browse-handle.browse-type = 'width':u
     1227       :
     1228         assign
     1229           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1230         .
     1231       end.
     1232       for each buf_temp-diasize-handle
     1233       :
     1234         delete buf_temp-diasize-handle .
     1235       end.
     1236       assign
     1237         v-field-group-handle = frame Dialog-Frame :first-child
     1238       .
     1239       do while valid-handle(v-field-group-handle)
     1240       :
     1241         assign
     1242           v-object-handle = v-field-group-handle :first-child
     1243         .
     1244         do while valid-handle(v-object-handle)
     1245         :
     1246           if  v-object-handle <> v-diasize-browse-handle :handle
     1247           and v-object-handle <> v-diasize-resize-button
     1248           and can-query(v-object-handle, "row")
     1249           and can-query(v-object-handle, "height")
     1250           and ( v-object-handle :col + v-object-handle :width
     1251                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1252               )
     1253           then do:
     1254             find first buf_temp-browse-handle
     1255               where buf_temp-browse-handle.browse-type   = 'width':u
     1256                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1257               no-error .
     1258             if available buf_temp-browse-handle
     1259             then do:
     1260             end.
     1261             else do:
     1262               create buf_temp-diasize-handle .
     1263               assign
     1264                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1265                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1266               .
     1267             end.
     1268           end.
     1269           assign
     1270             v-object-handle = v-object-handle :next-sibling
     1271           .
     1272         end.
     1273         assign
     1274           v-field-group-handle = v-field-group-handle :next-sibling
     1275         .
     1276       end.
     1277       do with frame Dialog-Frame
     1278       :
     1279         hide v-diasize-resize-button .
     1280         v-diasize-resize-button :row = 1.
     1281         v-diasize-resize-button :column = 1.
     1282       end.
     1283       if p-change-value > 0
     1284       then do:
     1285         if frame Dialog-Frame :scrollable = true
     1286         then do:
     1287           assign
     1288             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1289             no-error .
     1290           if error-status :error
     1291           or error-status :get-message(1) <> ""
     1292           then do:
     1293             undo move_block, retry move_block.
     1294           end.
     1295         end.
     1296         assign
     1297           frame Dialog-Frame :width = v-frame-width + p-change-value
     1298           no-error .
     1299         if error-status :error
     1300         or error-status :get-message(1) <> ""
     1301         then do:
     1302           undo move_block, retry move_block.
     1303         end.
     1304         assign
     1305           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1306         no-error .
     1307         if error-status :error
     1308         or error-status :get-message(1) <> ""
     1309         then do:
     1310           undo move_block, retry move_block.
     1311         end.
     1312         for each buf_temp-browse-handle
     1313           where buf_temp-browse-handle.browse-type = 'width':u
     1314         on error undo move_block, retry move_block
     1315         :
     1316           assign
     1317             buf_temp-browse-handle.browse-handle :width
     1318               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1319             no-error .
     1320           if error-status :error
     1321           or error-status :get-message(1) <> ""
     1322           then do:
     1323             undo move_block, retry move_block .
     1324           end.
     1325         end.
     1326         for each buf_temp-diasize-handle
     1327         on error undo move_block, retry move_block
     1328         :
     1329           assign
     1330             v-object-handle = buf_temp-diasize-handle.handle-value
     1331           .
     1332           if v-object-handle <> v-diasize-resize-button
     1333           then do:
     1334             assign
     1335               v-object-handle :col = v-object-handle :col + p-change-value
     1336               no-error .
     1337             if error-status :error
     1338             or error-status :get-message(1) <> ""
     1339             then do:
     1340               undo move_block, retry move_block .
     1341             end.
     1342           end.
     1343         end.
     1344       end.
     1345       else do:
     1346         for each buf_temp-diasize-handle
     1347         on error undo move_block, retry move_block
     1348         :
     1349           assign
     1350             v-object-handle = buf_temp-diasize-handle.handle-value
     1351           .
     1352           if v-object-handle <> v-diasize-resize-button
     1353           then do:
     1354             assign
     1355               v-object-handle :col = v-object-handle :col + p-change-value
     1356               no-error .
     1357             if error-status :error
     1358             or error-status :get-message(1) <> ""
     1359             then do:
     1360               undo move_block, retry move_block .
     1361             end.
     1362           end.
     1363         end.
     1364         for each buf_temp-browse-handle
     1365           where buf_temp-browse-handle.browse-type = 'width':u
     1366         on error undo move_block, retry move_block
     1367         :
     1368           assign
     1369             buf_temp-browse-handle.browse-handle :width
     1370               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1371             no-error .
     1372           if error-status :error
     1373           or error-status :get-message(1) <> ""
     1374           then do:
     1375             undo move_block, retry move_block .
     1376           end.
     1377         end.
     1378         assign
     1379           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1380           no-error .
     1381         if error-status :error
     1382         or error-status :get-message(1) <> ""
     1383         then do:
     1384           undo move_block, retry move_block.
     1385         end.
     1386         assign
     1387           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1388         no-error .
     1389         if error-status :error
     1390         or error-status :get-message(1) <> ""
     1391         then do:
     1392           undo move_block, retry move_block.
     1393         end.
     1394         if frame Dialog-Frame :scrollable = true
     1395         then do:
     1396           assign
     1397             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1398           no-error .
     1399           if error-status :error
     1400           or error-status :get-message(1) <> ""
     1401           then do:
     1402             undo move_block, retry move_block.
     1403           end.
     1404         end.
     1405       end.
     1406       if p-move-resize
     1407       then do:
     1408         run diasize_position-resize-button in this-procedure .
     1409       end.
     1410       if v-diasize-wndstore = true
     1411       then do:
     1412         if connected("ub") = true
     1413         then do:
     1414           define variable v-cntxt-db-num        as integer   no-undo .
     1415           define variable v-cntxt-userid        as character no-undo .
     1416           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1417                                             , OUTPUT v-cntxt-userid
     1418                                             ) .
     1419           run gbl/wndsizew.p
     1420             (input  v-cntxt-db-num
     1421             ,input  v-cntxt-userid
     1422             ,input  v-diasize-proc-name
     1423             ,input  'width':u
     1424             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1425             ) .
     1426         end.
     1427       end.
     1428     end.
     1429     assign
     1430       v-diasize-change-size = false
     1431     .
     1432   end procedure.
     1433   procedure diasize_set-width :
     1434     define input  parameter p-new-width  as decimal   no-undo .
     1435     define input  parameter p-move-resize as logical   no-undo .
     1436     do
     1437     on error undo, return error return-value
     1438     :
     1439       run diasize_change-width in this-procedure
     1440         (input  (p-new-width - frame Dialog-Frame :width)
     1441         ,input  p-move-resize
     1442         ) .
     1443     end.
     1444   end procedure.
     1445   procedure diasize_position-resize-button :
     1446     do with frame Dialog-Frame
     1447     :
     1448       hide v-diasize-resize-button .
     1449       assign
     1450         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1451                     - 1
     1452                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1453         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1454                     - 1
     1455                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1456       .
     1457       view v-diasize-resize-button .
     1458     end.
     1459   end procedure.
     1460   on alt-right anywhere
     1461   do:
     1462     run diasize_change-width in this-procedure
     1463       (input 1
     1464       ,input true
     1465       ) .
     1466     return no-apply .
     1467   end.
     1468   on alt-left anywhere
     1469   do:
     1470     run diasize_change-width in this-procedure
     1471       (input -1
     1472       ,input true
     1473       ) .
     1474     return no-apply .
     1475   end.
     1476   on alt-down anywhere
     1477   do:
     1478     run diasize_change-height in this-procedure
     1479       (input 1
     1480       ,input true
     1481       ) .
     1482     return no-apply .
     1483   end.
     1484   on alt-up anywhere
     1485   do:
     1486     run diasize_change-height in this-procedure
     1487       (input -1
     1488       ,input true
     1489       ) .
     1490     return no-apply .
     1491   end.
     1492   on alt-enter of frame Dialog-Frame
     1493   do:
     1494     run diasize_maximize in this-procedure
     1495       (input  ?
     1496       ).
     1497     return no-apply .
     1498   end.
     1499   procedure diasize_end-move :
     1500     do
     1501     on error undo, return error return-value
     1502     :
     1503       define variable v-row-delta as decimal   no-undo .
     1504       define variable v-col-delta as decimal   no-undo .
     1505       define variable v-new-row as decimal   no-undo .
     1506       define variable v-new-col as decimal   no-undo .
     1507       assign
     1508         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1509         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1510       .
     1511       assign
     1512         v-row-delta = v-new-row - frame Dialog-Frame :height
     1513         v-col-delta = v-new-col - frame Dialog-Frame :width
     1514       .
     1515       run diasize_change-height in this-procedure
     1516         (input v-row-delta
     1517         ,input true
     1518         ) .
     1519       run diasize_change-width in this-procedure
     1520         (input v-col-delta
     1521         ,input true
     1522         ) .
     1523     end.
     1524   end procedure.
     1525   procedure diasize_maximize :
     1526     define input  parameter p-action as logical   no-undo .
     1527     do
     1528     on error undo, return error return-value
     1529     :
     1530       if p-action = ?
     1531       then do:
     1532         if v-diasize-need-maximize = true
     1533         then do:
     1534           assign
     1535             p-action = true
     1536           .
     1537         end.
     1538         else do:
     1539           assign
     1540             p-action = false
     1541           .
     1542         end.
     1543       end.
     1544       if p-action = true
     1545       then do:
     1546         run diasize_change-height in this-procedure
     1547           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1548               - frame Dialog-Frame :height-chars
     1549           ,input true
     1550           ) .
     1551         run diasize_change-width in this-procedure
     1552           (input session :width-chars
     1553               - frame Dialog-Frame :width-chars
     1554           ,input true
     1555           ) .
     1556         assign
     1557           v-diasize-need-maximize = false
     1558         .
     1559       end.
     1560       else do:
     1561         run diasize_change-width in this-procedure
     1562           (input v-diasize-orig-frame-width
     1563               - frame Dialog-Frame :width-chars
     1564           ,input true
     1565           ) .
     1566         run diasize_change-height in this-procedure
     1567           (input v-diasize-orig-frame-height
     1568               - frame Dialog-Frame :height-chars
     1569           ,input true
     1570           ) .
     1571         assign
     1572           v-diasize-need-maximize = true
     1573         .
     1574       end.
     1575     end.
     1576   end procedure.
     1577   procedure diasize_restore-orig-size :
     1578     do
     1579     on error undo, return error return-value
     1580     :
     1581       assign
     1582         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1583         v-diasize-current-frame-height = frame Dialog-Frame :height
     1584       .
     1585       run diasize_set-height in this-procedure
     1586         (input  v-diasize-orig-frame-height
     1587         ,input  true
     1588         ) .
     1589       run diasize_set-width in this-procedure
     1590         (input  v-diasize-orig-frame-width
     1591         ,input  true
     1592         ) .
     1593     end.
     1594   end procedure.
     1595   procedure diasize_restore-current-size :
     1596     do
     1597     on error undo, return error return-value
     1598     :
     1599       run diasize_set-height in this-procedure
     1600         (input  v-diasize-current-frame-height
     1601         ,input  true
     1602         ) .
     1603       run diasize_set-width in this-procedure
     1604         (input  v-diasize-current-frame-width
     1605         ,input  true
     1606         ) .
     1607     end.
     1608   end procedure.
     1609   procedure diasize_set-browse-handle :
     1610     define input  parameter p-browse-handle as handle   no-undo .
     1611     define buffer buf_temp-browse-handle for temp-browse-handle .
     1612     do
     1613     on error undo, return error return-value
     1614     :
     1615       assign
     1616         v-diasize-browse-handle = p-browse-handle
     1617       .
     1618       for each buf_temp-browse-handle
     1619       on error undo, return error return-value
     1620       :
     1621         delete buf_temp-browse-handle .
     1622       end.
     1623     end.
     1624   end procedure.
     1625   procedure diasize_add_browse :
     1626     define input  parameter p-browse-type   as character no-undo .
     1627     define input  parameter p-browse-handle as handle    no-undo .
     1628     define buffer buf_temp-browse-handle for temp-browse-handle .
     1629     do
     1630     on error undo, return error return-value
     1631     :
     1632       assign
     1633         v-diasize-browse-number = v-diasize-browse-number + 1
     1634       .
     1635       create buf_temp-browse-handle .
     1636       assign
     1637         buf_temp-browse-handle.browse-type   = p-browse-type
     1638         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1639         buf_temp-browse-handle.browse-handle = p-browse-handle
     1640       .
     1641     end.
     1642   end procedure.
     1643   procedure diasize_init :
     1644     define variable v-default-value    as logical   no-undo .
     1645     define variable v-restore-saved    as logical   no-undo .
     1646     define variable v-resize-value-str as character no-undo .
     1647     do
     1648     on error undo, return error return-value
     1649     :
     1650       do with frame Dialog-Frame
     1651       :
     1652         assign
     1653           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1654           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1655           v-diasize-browse-handle     = browse BR-countries :handle
     1656         .
     1657         create button v-diasize-resize-button
     1658         assign
     1659           parent        = frame Dialog-Frame :first-child
     1660           label         = "s"
     1661           height-pixels = 16
     1662           width-pixels  = 16
     1663           visible       = true
     1664           sensitive     = true
     1665           movable       = true
     1666           triggers:
     1667             on end-move persistent run diasize_end-move in this-procedure .
     1668           end triggers.
     1669         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1670         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1671         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1672         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1673         assign
     1674           v-diasize-wndmax = false
     1675         .
     1676         if connected("ub") = true
     1677         then do:
     1678           define variable v-cntxt-db-num        as integer   no-undo .
     1679           define variable v-cntxt-userid        as character no-undo .
     1680           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1681                                             , OUTPUT v-cntxt-userid
     1682                                             ) .
     1683           run gbl/wndpar_r.p
     1684             (input  v-cntxt-db-num
     1685             ,input  v-cntxt-userid
     1686             ,input  'wndmax':U
     1687             ,output v-diasize-wndmax
     1688             ,output v-default-value
     1689             ) .
     1690         end.
     1691         assign
     1692           v-diasize-wndstore = false
     1693         .
     1694         if connected("ub") = true
     1695         then do:
     1696           run gbl/wndpar_r.p
     1697             (input  v-cntxt-db-num
     1698             ,input  v-cntxt-userid
     1699             ,input  'wndstore':U
     1700             ,output v-diasize-wndstore
     1701             ,output v-default-value
     1702             ) .
     1703         end.
     1704         assign
     1705           v-diasize-proc-name = entry(1, program-name(2), '.')
     1706         .
     1707         if v-diasize-wndstore = true
     1708         then do:
     1709           assign
     1710             v-restore-saved = false
     1711           .
     1712           if connected("ub") = true
     1713           then do:
     1714             run gbl/wndsizer.p
     1715               (input  v-cntxt-db-num
     1716               ,input  v-cntxt-userid
     1717               ,input  v-diasize-proc-name
     1718               ,input  'height':u
     1719               ,output v-resize-value-str
     1720               ) .
     1721             if v-resize-value-str <> '':U
     1722             then do:
     1723               run diasize_change-height in this-procedure
     1724                 (input  integer(v-resize-value-str)
     1725                 ,input  true
     1726                 ) .
     1727               assign
     1728                 v-restore-saved = true
     1729               .
     1730             end.
     1731           end.
     1732           if connected("ub") = true
     1733           then do:
     1734             run gbl/wndsizer.p
     1735               (input  v-cntxt-db-num
     1736               ,input  v-cntxt-userid
     1737               ,input  v-diasize-proc-name
     1738               ,input  'width':u
     1739               ,output v-resize-value-str
     1740               ) .
     1741             if v-resize-value-str <> '':U
     1742             then do:
     1743               run diasize_change-width in this-procedure
     1744                 (input  integer(v-resize-value-str)
     1745                 ,input  true
     1746                 ) .
     1747               assign
     1748                 v-restore-saved = true
     1749               .
     1750             end.
     1751           end.
     1752           if v-restore-saved <> true
     1753           then do:
     1754             if v-diasize-wndmax = true
     1755             then do:
     1756               run diasize_maximize in this-procedure
     1757                 (input  true
     1758                 ) .
     1759             end.
     1760           end.
     1761         end.
     1762         else do:
     1763           if v-diasize-wndmax = true
     1764           then do:
     1765             run diasize_maximize in this-procedure
     1766               (input  true
     1767               ) .
     1768           end.
     1769         end.
     1770       end.
     1771     end.
     1772   end procedure.
     1773   procedure diasize_need-full-display :
     1774     define output parameter p-need-full-display as logical   no-undo .
     1775     do
     1776     on error undo, return error return-value
     1777     :
     1778       assign
     1779         p-need-full-display = v-diasize-need-full-display
     1780       .
     1781       assign
     1782         v-diasize-need-full-display = false
     1783       .
     1784     end.
     1785   end procedure.
     1786   procedure get-context :
     1787      define output parameter p-db-num as integer          no-undo.
     1788      define output parameter p-user-id as character        no-undo.
     1789      define variable v-login               as character    no-undo.
     1790      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1791      define buffer buf_user-login  for ub.user-login .
     1792      do
     1793      on error undo, return error
     1794      :
     1795            FIND FIRST buf_sys-ctrl no-lock.
     1796            ASSIGN
     1797               v-login = USERID("ub")
     1798               p-db-num = buf_sys-ctrl.db-num
     1799            .
     1800            FIND FIRST buf_user-login
     1801                 WHERE buf_user-login.db-num = p-db-num
     1802                   AND buf_user-login.user-login = v-login
     1803                 no-lock
     1804                 no-error
     1805                 .
     1806            IF AVAILABLE buf_user-login
     1807            THEN DO:
     1808               assign
     1809                  p-user-id = buf_user-login.user-id
     1810               .
     1811            END.
     1812      end.
     1813   end procedure.
     1814       run diasize_init in this-procedure .
     1815   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1816   do:
     1817     BR-countries :SET-REPOSITIONED-ROW(10, "CONDITIONAL") .
     1818   end.
     1819   on any-printable of br-countries in frame Dialog-Frame
     1820   do:
     1821     if last-event:label = " " and loc-alpha-1 = ""
     1822     then do:
     1823       return no-apply.
     1824     end.
     1825     find first buf_country no-lock
     1826       where buf_country.alpha1 begins (loc-alpha-1 + last-event:label)
     1827       no-error .
     1828     if available buf_country
     1829     then do:
     1830       loc-alpha-1 = loc-alpha-1 + last-event:label.
     1831       disp loc-alpha-1 with frame Dialog-Frame.
     1832       v-rec = recid (buf_country).
     1833       reposition br-countries to recid v-rec no-error.
     1834     end.
     1835   end.
     1836   on backspace of br-countries in frame Dialog-Frame
     1837   do:
     1838     if loc-alpha-1 = "" then do:
     1839       return no-apply.
     1840     end.
     1841     assign
     1842       loc-alpha-1 = substr (loc-alpha-1, 1, length (loc-alpha-1) - 1)
     1843     .
     1844     find first buf_country no-lock
     1845       where buf_country.alpha1 begins loc-alpha-1
     1846       no-error .
     1847     display loc-alpha-1 with frame Dialog-Frame.
     1848     v-rec = recid (buf_country).
     1849     reposition br-countries to recid v-rec no-error.
     1850   end.
     1851   MAIN-BLOCK:
     1852   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1853      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1854     RUN MYenable.
     1855   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1856     run mainmenu_getcntxt in parparentproc
     1857       (output v-cntxt-db-num
     1858       ,output v-cntxt-userid
     1859       ,output v-cntxt-level
     1860       ,output v-cntxt-host-code-obj
     1861       ,output v-cntxt-obj-type
     1862       ,output v-cntxt-obj-code
     1863       ,output v-cntxt-db-num-obj
     1864       ,output v-cntxt-is-admin
     1865       ) .
     1866     v-rid-list = p-rid-list.
     1867     APPLY "ENTRY" to BR-countries.
     1868     WAIT-FOR GO OF FRAME Dialog-Frame.
     1869   END.
     1870   RUN disable_UI.
     1871   PROCEDURE disable_UI :
     1872     HIDE FRAME Dialog-Frame.
     1873   END PROCEDURE.
     1874   PROCEDURE enable_UI :
     1875     DISPLAY t-pck a-n-c mark-num
     1876         WITH FRAME Dialog-Frame.
     1877     ENABLE B-exit B-mark B-sel B-add B-chg t-pck B-rum B-hist B-help a-n-c
     1878            BR-countries loc-alpha-1 mark-num
     1879         WITH FRAME Dialog-Frame.
     1880     VIEW FRAME Dialog-Frame.
     1881     OPEN QUERY BR-countries FOR EACH X_country NO-LOCK     BY X_country.short-name.
     1882   END PROCEDURE.
     1883   PROCEDURE MyEnable :
     1884   ASSIGN
     1885   b-rum:MENU-MOUSE in frame Dialog-Frame =  1
     1886   MENU-ITEM m_xml-file-export:SENSITIVE IN MENU menu-b-rum = no
     1887   .
     1888   DEFINE buffer b-country for country.
     1889   DISPLAY a-n-c
     1890         WITH FRAME Dialog-Frame .
     1891     ENABLE
     1892     B-exit
     1893     B-sel when lookup("b-sel", bttns) > 0
     1894     B-add when lookup("b-add", bttns) > 0
     1895     B-chg when lookup("b-add", bttns) > 0
     1896   b-mark WHEN LOOKUP("b-mark", bttns) > 0
     1897     b-hist
     1898     B-help
     1899     a-n-c
     1900     BR-countries
     1901   b-rum
     1902   t-pck
     1903     loc-alpha-1
     1904     WITH FRAME Dialog-Frame.
     1905     VIEW FRAME Dialog-Frame.
     1906     OPEN QUERY BR-countries FOR EACH X_country NO-LOCK     BY X_country.short-name.
     1907   IF v-rid-list <> '' then do:
     1908       FIND FIRST b-country  No-LOCK WHERE
     1909              recid(b-country) = integer(entry(1, v-rid-list)) No-ERROR.
     1910       IF avail b-country then do:
     1911           REPOSITION br-countries to recid recid(b-country) NO-ERROR.
     1912           APPLY "Entry" to br-countries.
     1913           APPLY "VALUE-CHANGED" to br-countries.
     1914       end.
     1915     end.
     1916   END PROCEDURE.
     1917   PROCEDURE proc-b-rum :
     1918   define input parameter p-rum-option as character no-undo .
     1919   define variable v-ii as integer no-undo .
     1920   define variable v-radio-button-parameter as character no-undo .
     1921   if p-rum-option = 'batchwork-export':U then do:
     1922     v-radio-button-parameter = 'batchwork-export':U.
     1923   end.
     1924   else do:
     1925     v-radio-button-parameter = 'batchwork-routing':U  .
     1926   end.
     1927   if v-rid-list = '' then do:
     1928     message
     1929     "Не выбрана ни одной записи"
     1930     view-as alert-box warning.
     1931     return.
     1932   end.
     1933   for each cntrlist:
     1934     delete cntrlist.
     1935   end.
     1936   do v-ii = 1 to num-entries(v-rid-list):
     1937     find first buf_country no-lock where
     1938               recid(buf_country) = integer(entry(v-ii, v-rid-list)) no-error.
     1939     if available buf_country then do:
     1940   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1941   find cntrlist
     1942     where cntrlist.alpha1 = buf_country.alpha1
     1943     no-error .
     1944   if available cntrlist then do:
     1945     assign
     1946       cntrlist.to-del = no
     1947     .
     1948   end.
     1949   else do:
     1950     create cntrlist .
     1951     buffer-copy buf_country to cntrlist
     1952     assign
     1953       cntrlist.to-del = no
     1954     .
     1955     assign
     1956       lns-cnt = lns-cnt + 1
     1957       line-rec = recid (cntrlist)
     1958     .
     1959   end.
     1960     end.
     1961   end.
     1962   run str/diallog.w (
     1963         input parParentProc
     1964       , input this-procedure
     1965       , input "utl/thbjrumr.w":U
     1966       , input 'thref':U + chr(4) + v-radio-button-parameter
     1967       , input no
     1968       , input "&Стоп"
     1969       , input substitute("Операции над странами") ) no-error .
     1970   END PROCEDURE.
