      981   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      982   procedure cur-time :
      983      define output parameter p-today as date      no-undo .
      984      define output parameter p-time  as integer   no-undo .
      985     do
      986     on error undo, return error
      987     :
      988       define variable v-date1 as date      no-undo .
      989       define variable v-date2 as date      no-undo .
      990       define variable v-time  as integer   no-undo .
      991       assign
      992         v-date1 = today
      993         v-time  = time
      994         v-date2 = today
      995       .
      996       if v-date1 <> v-date2
      997       then do:
      998         assign
      999           v-date1 = today
     1000           v-time  = v-time
     1001         .
     1002       end.
     1003       assign
     1004         p-today = v-date1
     1005         p-time  = v-time
     1006       .
     1007     end.
     1008   end.
     1009   function cur-time-date returns character
     1010   :
     1011     return string(today, '99/99/9999':U) .
     1012   end.
     1013   function cur-time-mjd returns decimal
     1014   :
     1015     define variable v-date as date      no-undo .
     1016     define variable v-time as integer   no-undo .
     1017     run cur-time in this-procedure
     1018       (output v-date
     1019       ,output v-time
     1020       ) .
     1021     return integer(v-date) - 2400002 + (v-time / 86400) .
     1022   end.
     1023   function cur-time-get-ending-index returns integer
     1024   (input p-number as integer
     1025   )
     1026   :
     1027     if p-number < 0
     1028     or p-number = ?
     1029     then do:
     1030       return 1 .
     1031     end.
     1032     define variable v-rest as integer   no-undo .
     1033     assign
     1034       p-number = p-number modulo 100
     1035     .
     1036     if p-number < 20
     1037     then do:
     1038       assign
     1039         v-rest = p-number
     1040       .
     1041     end.
     1042     else do:
     1043       assign
     1044         v-rest = p-number modulo 10
     1045       .
     1046     end.
     1047     case v-rest :
     1048       when 1
     1049       then do:
     1050         return 2 .
     1051       end.
     1052       when 2 or
     1053       when 3 or
     1054       when 4
     1055       then do:
     1056         return 3 .
     1057       end.
     1058       otherwise do:
     1059         return 1 .
     1060       end.
     1061     end case .
     1062   end.
     1063   procedure cur-time-mjd-to-date :
     1064      define input  parameter i-mjd-diff as decimal no-undo.
     1065      define output parameter o-Date     as date    no-undo.
     1066      define output parameter o-Time     as integer no-undo.
     1067      define variable v-day-number as integer   no-undo .
     1068      if    i-mjd-diff < 0
     1069         or i-mjd-diff = ?
     1070      then do:
     1071         return "?" .
     1072      end.
     1073      assign
     1074         v-day-number = truncate(i-mjd-diff,0).
     1075         o-Date = date(v-day-number + 2400002).
     1076         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1077     .
     1078   end.
     1079   function cur-time-mjd-to-string returns character
     1080   (input p-mjd-diff as decimal
     1081   )
     1082   :
     1083     define variable v-day-number as integer   no-undo .
     1084     define variable v-seconds    as integer   no-undo .
     1085     define variable v-hour       as integer   no-undo .
     1086     define variable v-min        as integer   no-undo .
     1087     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1088     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1089     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1090     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1091     if p-mjd-diff < 0
     1092     or p-mjd-diff = ?
     1093     then do:
     1094       return "?" .
     1095     end.
     1096     assign
     1097       v-day-number = integer(truncate(p-mjd-diff,0))
     1098       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1099     .
     1100     if v-seconds > 86400
     1101     then do:
     1102       assign
     1103         v-seconds = 86400 - 1
     1104       .
     1105     end.
     1106     if v-seconds < 0
     1107     then do:
     1108       assign
     1109         v-seconds = 0
     1110       .
     1111     end.
     1112     assign
     1113       v-hour = truncate(v-seconds / 3600, 0)
     1114     .
     1115     assign
     1116       v-seconds = v-seconds modulo 3600
     1117     .
     1118     assign
     1119       v-min = truncate(v-seconds / 60, 0)
     1120     .
     1121     assign
     1122       v-seconds = v-seconds modulo 60
     1123     .
     1124     return
     1125         (if v-day-number <> 0
     1126           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1127           else ""
     1128         )
     1129       + (if v-day-number <> 0 or v-hour <> 0
     1130           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1131           else ""
     1132         )
     1133       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1134           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1135           else ""
     1136         )
     1137       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1138       .
     1139   end.
     1140   function cur-time-string returns character
     1141   :
     1142     define variable v-date as date      no-undo .
     1143     define variable v-time as integer   no-undo .
     1144     run cur-time in this-procedure
     1145       (output v-date
     1146       ,output v-time
     1147       ) .
     1148     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1149   end.
     1150   function cur-time-string-sec returns character
     1151   :
     1152     define variable v-date as date      no-undo .
     1153     define variable v-time as integer   no-undo .
     1154     run cur-time in this-procedure
     1155       (output v-date
     1156       ,output v-time
     1157       ) .
     1158     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1159   end.
     1160   function cur-time-custom  returns character
     1161   (input p-prefix as character
     1162   ,input p-date-format as character
     1163   ,input p-delimiter as character
     1164   ,input p-time-format as character
     1165   ,input p-suffix as character
     1166   )
     1167   :
     1168     define variable v-date as date      no-undo .
     1169     define variable v-time as integer   no-undo .
     1170     run cur-time in this-procedure
     1171       (output v-date
     1172       ,output v-time
     1173       ) .
     1174     return
     1175       p-prefix
     1176       + string(v-date, p-date-format)
     1177       + p-delimiter
     1178       + string(v-time, p-time-format)
     1179       + p-suffix
     1180       .
     1181   end.
     1182   function cur-time-print  returns character
     1183   :
     1184     define variable v-date as date      no-undo .
     1185     define variable v-time as integer   no-undo .
     1186     run cur-time in this-procedure
     1187       (output v-date
     1188       ,output v-time
     1189       ) .
     1190     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1191   end.
     1192   function cur-time-datetime returns datetime
     1193   :
     1194     define variable v-char as character no-undo .
     1195     define variable v-datetime as datetime no-undo .
     1196     v-char = cur-time-string().
     1197     v-datetime = datetime(v-char).
     1198     return  v-datetime.
     1199   end.
     1200   function cur-time-string-msec returns character
     1201   :
     1202     define variable v-date as datetime  no-undo .
     1203     v-date = now.
     1204     return string(v-date) .
     1205   end.
     1206   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1207     define variable v-cntxt-db-num        as integer   no-undo .
     1208     define variable v-cntxt-userid        as character no-undo .
     1209     define variable v-cntxt-level         as character no-undo .
     1210     define variable v-cntxt-host-code-obj as integer   no-undo .
     1211     define variable v-cntxt-obj-type      as character no-undo .
     1212     define variable v-cntxt-obj-code      as integer   no-undo .
     1213     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1214     define variable v-cntxt-is-admin      as logical   no-undo .
     1215   DEFINE VARIABLE dflt-cd AS CHARACTER NO-UNDO.
     1216   DEFINE VARIABLE v-obj-db-num AS INTEGER NO-UNDO.
     1217   DEFINE VARIABLE rr AS RECID NO-UNDO.
     1218   DEFINE VARIABLE conf-attr AS CHARACTER NO-UNDO.
     1219   DEFINE VARIABLE conf-par AS CHARACTER NO-UNDO.
     1220   DEFINE VARIABLE par-type AS CHARACTER NO-UNDO.
     1221   define variable v-attr-code as character no-undo .
     1222   define variable v-upper-attr-code as character no-undo .
     1223   define buffer locked_cash-desk-attr for ub.cash-desk-attr.
     1224   DEFINE BUTTON b-add
     1225        LABEL "&Добавить"
     1226        SIZE 10 BY 1.
     1227   DEFINE BUTTON b-chg
     1228        LABEL "&Изменить"
     1229        SIZE 10 BY 1.
     1230   DEFINE BUTTON b-del
     1231        LABEL "&Удалить"
     1232        SIZE 10 BY 1.
     1233   DEFINE BUTTON B-Help
     1234        LABEL "Помо&щь"
     1235        SIZE 10 BY 1
     1236        BGCOLOR 8 .
     1237   DEFINE BUTTON b-mark
     1238        LABEL "&*"
     1239        SIZE 3 BY 1.
     1240   DEFINE BUTTON b-quit
     1241        LABEL "&Выход"
     1242        SIZE 10 BY 1
     1243        BGCOLOR 8 .
     1244   DEFINE BUTTON b-sel
     1245        LABEL "В&ыбор"
     1246        SIZE 10 BY 1.
     1247   DEFINE VARIABLE mark-num AS INTEGER FORMAT ">9":U INITIAL 0
     1248        VIEW-AS FILL-IN
     1249        SIZE 5 BY 1
     1250        FGCOLOR 10  NO-UNDO.
     1251   DEFINE QUERY BR-taracodes FOR
     1252         X_cash-desk-attr SCROLLING.
     1253   DEFINE BROWSE BR-taracodes
     1254     QUERY BR-taracodes NO-LOCK DISPLAY
     1255         entry(2, X_cash-desk-attr.attr-code, chr(4)) COLUMN-LABEL "Код тары"
     1256   X_cash-desk-attr.attr-value-character COLUMN-LABEL "Вес тары" FORMAT "X(4)":U
     1257       WITH NO-ROW-MARKERS SEPARATORS SIZE 33.5 BY 13.77 FIT-LAST-COLUMN.
     1258   DEFINE FRAME Dialog-Frame
     1259        b-quit AT ROW 1 COL 1
     1260        b-mark AT ROW 1 COL 11
     1261        b-sel AT ROW 1 COL 14
     1262        b-add AT ROW 1 COL 24
     1263        b-chg AT ROW 1 COL 34
     1264        b-del AT ROW 1 COL 44
     1265        B-Help AT ROW 1 COL 54
     1266        mark-num AT ROW 2 COL 1 NO-LABEL
     1267        BR-taracodes AT ROW 3.5 COL 1
     1268        SPACE(30.19) SKIP(0.59)
     1269       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1270            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1271            TITLE "Соответствие кодов тары и весов тары для сканер-весов NCR"
     1272            DEFAULT-BUTTON b-quit.
     1273   ASSIGN
     1274          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1275          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1276   ON END-ERROR OF FRAME Dialog-Frame
     1277   OR ENDKEY OF FRAME Dialog-Frame DO:
     1278      run gbl/markqwa.p (
     1279                              input b-mark:sensitive
     1280                             , input p-rid-list) no-error.
     1281      if error-status:error then return no-apply.
     1282      APPLY "GO" TO FRAME Dialog-Frame.
     1283   END.
     1284   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1285   DO:
     1286     APPLY "END-ERROR":U TO SELF.
     1287   END.
     1288   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     1289   DO:
     1290     run proc-b-add IN THIS-PROCEDURE NO-ERROR.
     1291     IF ERROR-STATUS:error THEN RETURN NO-APPLY.
     1292   END.
     1293   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     1294   DO:
     1295     run proc-b-chg IN THIS-PROCEDURE NO-ERROR.
     1296     IF ERROR-STATUS:error THEN RETURN NO-APPLY.
     1297   END.
     1298   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     1299   DO:
     1300     run proc-b-del IN THIS-PROCEDURE NO-ERROR.
     1301     IF ERROR-STATUS:error THEN RETURN NO-APPLY.
     1302   END.
     1303   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
     1304   DO:
     1305   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     1306       if available X_cash-desk-attr then do:
     1307   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1308   define variable v-str-recid5 as character no-undo .
     1309   define variable v-num-entry5 as integer   no-undo .
     1310   assign
     1311     v-str-recid5 = trim( string( recid( X_cash-desk-attr ) , "->>>>>>>>>>>9":U ) )
     1312     v-num-entry5 = lookup( v-str-recid5 , p-rid-list )
     1313   .
     1314   if v-num-entry5 > 0 then do:
     1315     assign
     1316       entry( v-num-entry5, p-rid-list ) = "":U
     1317       p-rid-list = trim( replace( p-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1318     .
     1319   end.
     1320   else do:
     1321     assign
     1322       p-rid-list = p-rid-list + ( if p-rid-list = "":U then "":U else chr(44) ) + v-str-recid5
     1323     .
     1324   end.
     1325       glog = br-taracodes:refresh() .
     1326       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1327           glog = br-taracodes:select-next-row ().
     1328           apply "VALUE-CHANGED" to br-taracodes in frame Dialog-Frame.
     1329       end.
     1330       if num-entries( p-rid-list ) = 0 then
     1331           hide mark-num in frame Dialog-Frame.
     1332       else
     1333           DISPLAY
     1334           num-entries( p-rid-list ) @ mark-num with frame Dialog-Frame.
     1335     end.
     1336     apply "entry" to br-taracodes in frame Dialog-Frame.
     1337   END.
     1338   ON CHOOSE OF b-quit IN FRAME Dialog-Frame
     1339   DO:
     1340     APPLY "GO" TO FRAME Dialog-Frame.
     1341   END.
     1342   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1343   DO:
     1344     if ( available X_cash-desk-attr ) AND (( p-rid-list = "" ) or b-mark:sensitive = no) then
     1345       p-rid-list = string( recid( X_cash-desk-attr ) ) .
     1346     APPLY "GO" to frame Dialog-Frame .
     1347   END.
     1348   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1349   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1350   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1351   on help of frame Dialog-Frame
     1352   do:
     1353     run gbl/app_help.p
     1354       (input this-procedure :file-name
     1355       ,input ''
     1356       ,input ?
     1357       ) no-error.
     1358     if error-status :error then do:
     1359       message
     1360         "Ошибка при вызове помощи"
     1361         error-status :get-message(1)
     1362         view-as alert-box .
     1363     end.
     1364   end.
     1365   run minbtn-set in this-procedure .
     1366   on choose of b-help in frame Dialog-Frame
     1367   do:
     1368     apply "help":u to frame Dialog-Frame .
     1369   end.
     1370   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1371   procedure minbtn-set :
     1372       do
     1373           on error undo, return error return-value
     1374           :
     1375           define variable ii              as integer       no-undo .
     1376           define variable fh              as widget-handle no-undo .
     1377           define variable hh              as widget-handle no-undo .
     1378           define variable v-h             as handle        extent 4 no-undo .
     1379           define variable v-name-button   as character     no-undo .
     1380           define variable v-help-old-x    as decimal       no-undo .
     1381           define variable v-help-old-y    as decimal       no-undo .
     1382           define variable v-help-old-size as decimal       no-undo .
     1383           define variable v-frame-width   as decimal       no-undo .
     1384           define variable jj              as integer       no-undo .
     1385           do
     1386               on error undo, return error
     1387               :
     1388               assign
     1389                   v-frame-width = frame Dialog-Frame:width - 0.3
     1390                   fh            = frame Dialog-Frame:first-child
     1391                   hh            = fh:first-child
     1392                   ii            = 1
     1393                   .
     1394               do while valid-handle(hh):
     1395                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1396                   do:
     1397                       case lc(hh:name) :
     1398                           when "b-help" then
     1399                               do:
     1400                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1401                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1402                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1403                                   hh:TOOLTIP = "Помощь" .
     1404                                   v-help-old-x = hh:column .
     1405                                   v-help-old-y = hh:row    .
     1406                                   v-help-old-size = hh:width .
     1407                                   hh:width-chars = 2.5 .
     1408                               end.
     1409                           when "b-print" then
     1410                               do:
     1411                                   hh:load-image("cmp/b-print.bmp":u) .
     1412                                   hh:TOOLTIP = "Печать" .
     1413                                   v-h[ii] = hh:handle .
     1414                                   ii = ii + 1 .
     1415                                   hh:width-chars = 3 .
     1416                               end.
     1417                           when "b-history" or
     1418                           when "b-hist" then
     1419                               do:
     1420                                   hh:load-image("cmp/b-hist.bmp":u) .
     1421                                   hh:TOOLTIP = "История" .
     1422                                   v-h[ii] = hh:handle .
     1423                                   ii = ii + 1 .
     1424                                   hh:width-chars = 3 .
     1425                               end.
     1426                           when "b-sch" then
     1427                               do:
     1428                                   hh:load-image("cmp/b-sch.bmp":u) .
     1429                                   hh:TOOLTIP = "Установка Фильтра" .
     1430                                   v-h[ii] = hh:handle .
     1431                                   ii = ii + 1 .
     1432                                   hh:width-chars = 3 .
     1433                               end.
     1434                           when "b-hist-user" then
     1435                               do:
     1436                                   hh:load-image("cmp/b-hist.bmp":u) .
     1437                                   hh:TOOLTIP = "История пользователя" .
     1438                                   ii = ii + 1 .
     1439                               end.
     1440                       end case.
     1441                   end.
     1442                   hh = hh:next-sibling.
     1443               end.
     1444               b-help:column = v-frame-width - b-help:width-chars.
     1445               jj = 0.
     1446               repeat ii = 4 to 1 by -1 :
     1447                   if valid-handle (v-h[ii] ) then
     1448                   do:
     1449                       jj  = jj + 1 .
     1450                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1451                       v-h[ii]:row    = v-help-old-y .
     1452                   end.
     1453               end.
     1454           end.
     1455       end.
     1456   end procedure.
     1457   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1458   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1459   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1460   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1461   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1462   define variable v-diasize-current-frame-height as decimal   no-undo .
     1463   define variable v-diasize-change-size          as logical   no-undo .
     1464   define variable v-diasize-resize-button        as handle    no-undo .
     1465   define variable v-diasize-wndmax               as logical   no-undo .
     1466   define variable v-diasize-wndstore             as logical   no-undo .
     1467   define variable v-diasize-proc-name            as character no-undo .
     1468   define variable v-diasize-browse-handle        as handle    no-undo .
     1469   define variable v-diasize-browse-number        as integer   no-undo .
     1470   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1471   define temp-table temp-diasize-handle no-undo
     1472     field handle-value  as handle
     1473     field save-position as decimal
     1474     index xpk is primary unique handle-value
     1475     .
     1476   define temp-table temp-browse-handle no-undo
     1477     field browse-type   as character
     1478     field browse-number as integer
     1479     field browse-handle as handle
     1480     field original-size as decimal
     1481     index xpk is primary unique browse-type browse-number
     1482     index xie browse-type browse-handle
     1483   .
     1484   procedure diasize_change-height :
     1485     define input  parameter p-change-value  as decimal   no-undo .
     1486     define input  parameter p-move-resize   as logical   no-undo .
     1487     define variable v-field-group-handle    as handle    no-undo .
     1488     define variable v-object-handle         as handle    no-undo .
     1489     define variable v-frame-height          as decimal   no-undo .
     1490     define variable v-frame-virtual-height  as decimal   no-undo .
     1491     define variable v-browse-height         as decimal   no-undo .
     1492     define variable v-window-height         as decimal   no-undo .
     1493     define variable v-window-virtual-height as decimal   no-undo .
     1494     define variable v-change-sign           as integer   no-undo .
     1495     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1496     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1497     if p-change-value > 0
     1498     then do:
     1499       if frame Dialog-Frame :height + p-change-value
     1500           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1501       then do:
     1502         assign
     1503           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1504                           - (frame Dialog-Frame :height-chars)
     1505         .
     1506         if p-change-value <= 0
     1507         then do:
     1508           run diasize_position-resize-button in this-procedure .
     1509           return .
     1510         end.
     1511       end.
     1512     end.
     1513     if p-change-value < 0
     1514     then do:
     1515       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1516       then do:
     1517         assign
     1518           p-change-value = v-diasize-orig-frame-height
     1519                          - (frame Dialog-Frame :height-chars)
     1520         .
     1521         if p-change-value >= 0
     1522         then do:
     1523           run diasize_position-resize-button in this-procedure .
     1524           return .
     1525         end.
     1526       end.
     1527     end.
     1528     if p-change-value >= 0
     1529     then do:
     1530       assign
     1531         v-change-sign = 1
     1532       .
     1533     end.
     1534     else do:
     1535       assign
     1536         v-change-sign = -1
     1537       .
     1538     end.
     1539     assign
     1540       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1541     .
     1542     if p-change-value = 0
     1543     then do:
     1544       run diasize_position-resize-button in this-procedure .
     1545       return .
     1546     end.
     1547     move_block:
     1548     do
     1549     on error undo move_block, retry move_block
     1550     :
     1551       if retry
     1552       then do:
     1553         do
     1554         on error undo move_block, leave move_block
     1555         :
     1556           if p-change-value > 0
     1557           then do:
     1558             for each buf_temp-diasize-handle
     1559             on error undo, next
     1560             :
     1561               assign
     1562                 v-object-handle = buf_temp-diasize-handle.handle-value
     1563               .
     1564               if v-object-handle <> v-diasize-resize-button
     1565               then do:
     1566                 assign
     1567                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1568                 .
     1569               end.
     1570             end.
     1571             assign
     1572               v-diasize-browse-handle :height = v-browse-height
     1573             .
     1574             for each buf_temp-browse-handle
     1575               where buf_temp-browse-handle.browse-type = 'height':u
     1576             on error undo, next
     1577             :
     1578               assign
     1579                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1580               .
     1581             end.
     1582             assign
     1583               frame Dialog-Frame :height = v-frame-height
     1584             .
     1585             if frame Dialog-Frame :scrollable = true
     1586             then do:
     1587               assign
     1588                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1589               .
     1590             end.
     1591             run diasize_position-resize-button in this-procedure .
     1592           end.
     1593           else do:
     1594             if frame Dialog-Frame :scrollable = true
     1595             then do:
     1596               assign
     1597                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1598               .
     1599             end.
     1600             assign
     1601               frame Dialog-Frame :height = v-frame-height
     1602             .
     1603             assign
     1604               v-diasize-browse-handle :height = v-browse-height
     1605             .
     1606             for each buf_temp-browse-handle
     1607               where buf_temp-browse-handle.browse-type = 'height':u
     1608             on error undo, next
     1609             :
     1610               assign
     1611                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1612               .
     1613             end.
     1614             for each buf_temp-diasize-handle
     1615             on error undo, next
     1616             :
     1617               assign
     1618                 v-object-handle = buf_temp-diasize-handle.handle-value
     1619               .
     1620               if v-object-handle <> v-diasize-resize-button
     1621               then do:
     1622                 assign
     1623                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1624                 .
     1625               end.
     1626             end.
     1627             run diasize_position-resize-button in this-procedure .
     1628           end.
     1629           assign
     1630             v-diasize-change-size = false
     1631           .
     1632           leave move_block .
     1633         end.
     1634       end.
     1635       assign
     1636         v-diasize-need-full-display = true
     1637       .
     1638       if v-diasize-change-size = false
     1639       then do:
     1640         assign
     1641           v-diasize-change-size = true
     1642         .
     1643       end.
     1644       else do:
     1645         return .
     1646       end.
     1647       assign
     1648         v-frame-height = frame Dialog-Frame :height
     1649         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1650         v-browse-height = v-diasize-browse-handle :height
     1651       .
     1652       for each buf_temp-browse-handle
     1653         where buf_temp-browse-handle.browse-type = 'height':u
     1654       :
     1655         assign
     1656           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1657         .
     1658       end.
     1659       for each buf_temp-diasize-handle
     1660       :
     1661         delete buf_temp-diasize-handle .
     1662       end.
     1663       assign
     1664         v-field-group-handle = frame Dialog-Frame :first-child
     1665       .
     1666       do while valid-handle(v-field-group-handle)
     1667       :
     1668         assign
     1669           v-object-handle = v-field-group-handle :first-child
     1670         .
     1671         do while valid-handle(v-object-handle)
     1672         :
     1673           if  v-object-handle <> v-diasize-browse-handle :handle
     1674           and can-query(v-object-handle, "row")
     1675           and can-query(v-object-handle, "height")
     1676           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1677           then do:
     1678             find first buf_temp-browse-handle
     1679               where buf_temp-browse-handle.browse-type   = 'height':u
     1680                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1681               no-error .
     1682             if available buf_temp-browse-handle
     1683             then do:
     1684             end.
     1685             else do:
     1686               create buf_temp-diasize-handle .
     1687               assign
     1688                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1689                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1690               .
     1691             end.
     1692           end.
     1693           assign
     1694             v-object-handle = v-object-handle :next-sibling
     1695           .
     1696         end.
     1697         assign
     1698           v-field-group-handle = v-field-group-handle :next-sibling
     1699         .
     1700       end.
     1701       do with frame Dialog-Frame
     1702       :
     1703         hide v-diasize-resize-button .
     1704         assign
     1705           v-diasize-resize-button :row    = 1
     1706           v-diasize-resize-button :column = 1
     1707         .
     1708       end.
     1709       if p-change-value > 0
     1710       then do:
     1711         if frame Dialog-Frame :scrollable = true
     1712         then do:
     1713           assign
     1714             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1715             no-error .
     1716           if error-status :error
     1717           or error-status :get-message(1) <> ""
     1718           then do:
     1719             undo move_block, retry move_block .
     1720           end.
     1721         end.
     1722         assign
     1723           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1724           no-error .
     1725         if error-status :error
     1726         or error-status :get-message(1) <> ""
     1727         then do:
     1728           undo move_block, retry move_block .
     1729         end.
     1730         assign
     1731           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1732           no-error .
     1733         if error-status :error
     1734         or error-status :get-message(1) <> ""
     1735         then do:
     1736           undo move_block, retry move_block .
     1737         end.
     1738         for each buf_temp-browse-handle
     1739           where buf_temp-browse-handle.browse-type = 'height':u
     1740         on error undo move_block, retry move_block
     1741         :
     1742           assign
     1743             buf_temp-browse-handle.browse-handle :height
     1744               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1745             no-error .
     1746           if error-status :error
     1747           or error-status :get-message(1) <> ""
     1748           then do:
     1749             undo move_block, retry move_block .
     1750           end.
     1751         end.
     1752         for each buf_temp-diasize-handle
     1753         on error undo move_block, retry move_block
     1754         :
     1755           assign
     1756             v-object-handle = buf_temp-diasize-handle.handle-value
     1757           .
     1758           if v-object-handle <> v-diasize-resize-button
     1759           then do:
     1760             assign
     1761               v-object-handle :row = v-object-handle :row + p-change-value
     1762               no-error .
     1763             if error-status :error
     1764             or error-status :get-message(1) <> ""
     1765             then do:
     1766               undo move_block, retry move_block .
     1767             end.
     1768           end.
     1769         end.
     1770       end.
     1771       else do:
     1772         for each buf_temp-diasize-handle
     1773         on error undo move_block, retry move_block
     1774         :
     1775           assign
     1776             v-object-handle = buf_temp-diasize-handle.handle-value
     1777           .
     1778           if v-object-handle <> v-diasize-resize-button
     1779           then do:
     1780             assign
     1781               v-object-handle :row = v-object-handle :row + p-change-value
     1782               no-error .
     1783             if error-status :error
     1784             or error-status :get-message(1) <> ""
     1785             then do:
     1786               undo move_block, retry move_block .
     1787             end.
     1788           end.
     1789         end.
     1790         assign
     1791           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1792           no-error .
     1793         if error-status :error
     1794         or error-status :get-message(1) <> ""
     1795         then do:
     1796           undo move_block, retry move_block .
     1797         end.
     1798         for each buf_temp-browse-handle
     1799           where buf_temp-browse-handle.browse-type = 'height':u
     1800         on error undo move_block, retry move_block
     1801         :
     1802           assign
     1803             buf_temp-browse-handle.browse-handle :height
     1804               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1805             no-error .
     1806           if error-status :error
     1807           or error-status :get-message(1) <> ""
     1808           then do:
     1809             undo move_block, retry move_block .
     1810           end.
     1811         end.
     1812         assign
     1813           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1814           no-error .
     1815         if error-status :error
     1816         or error-status :get-message(1) <> ""
     1817         then do:
     1818           undo move_block, retry move_block .
     1819         end.
     1820         if frame Dialog-Frame :scrollable = true
     1821         then do:
     1822           assign
     1823             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1824             no-error .
     1825           if error-status :error
     1826           or error-status :get-message(1) <> ""
     1827           then do:
     1828             undo move_block, retry move_block .
     1829           end.
     1830         end.
     1831       end.
     1832       if p-move-resize = true
     1833       then do:
     1834         run diasize_position-resize-button in this-procedure .
     1835       end.
     1836       if v-diasize-wndstore = true
     1837       then do:
     1838         if connected("ub") = true
     1839         then do:
     1840           define variable v-cntxt-db-num        as integer   no-undo .
     1841           define variable v-cntxt-userid        as character no-undo .
     1842           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1843                                             , OUTPUT v-cntxt-userid
     1844                                             ) .
     1845           run gbl/wndsizew.p
     1846             (input  v-cntxt-db-num
     1847             ,input  v-cntxt-userid
     1848             ,input  v-diasize-proc-name
     1849             ,input  'height':u
     1850             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1851             ) .
     1852         end.
     1853       end.
     1854     end.
     1855     assign
     1856       v-diasize-change-size = false
     1857     .
     1858   end procedure.
     1859   procedure diasize_set-height :
     1860     define input  parameter p-new-height  as decimal   no-undo .
     1861     define input  parameter p-move-resize as logical   no-undo .
     1862     do
     1863     on error undo, return error return-value
     1864     :
     1865       run diasize_change-height in this-procedure
     1866         (input  (p-new-height - frame Dialog-Frame :height)
     1867         ,input  p-move-resize
     1868         ) .
     1869     end.
     1870   end procedure.
     1871   procedure diasize_change-width :
     1872     define input  parameter p-change-value as decimal   no-undo .
     1873     define input  parameter p-move-resize  as logical   no-undo .
     1874     define variable v-field-group-handle   as handle    no-undo .
     1875     define variable v-object-handle        as handle    no-undo .
     1876     define variable v-frame-width          as decimal   no-undo .
     1877     define variable v-frame-virtual-width  as decimal   no-undo .
     1878     define variable v-browse-width         as decimal   no-undo .
     1879     define variable v-window-width         as decimal   no-undo .
     1880     define variable v-window-virtual-width as decimal   no-undo .
     1881     define variable v-change-sign          as integer   no-undo .
     1882     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1883     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1884     if p-change-value > 0
     1885     then do:
     1886       if frame Dialog-Frame :width + p-change-value >
     1887           session :width-chars
     1888       then do:
     1889         assign
     1890           p-change-value = session :width-chars - frame Dialog-Frame :width
     1891         .
     1892         if p-change-value <= 0
     1893         then do:
     1894           run diasize_position-resize-button in this-procedure .
     1895           return .
     1896         end.
     1897       end.
     1898     end.
     1899     if p-change-value < 0
     1900     then do:
     1901       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1902       then do:
     1903         assign
     1904           p-change-value = v-diasize-orig-frame-width
     1905                          - frame Dialog-Frame :width
     1906         .
     1907         if p-change-value >= 0
     1908         then do:
     1909           run diasize_position-resize-button in this-procedure .
     1910           return .
     1911         end.
     1912       end.
     1913     end.
     1914     if p-change-value >= 0
     1915     then do:
     1916       assign
     1917         v-change-sign = 1
     1918       .
     1919     end.
     1920     else do:
     1921       assign
     1922         v-change-sign = -1
     1923       .
     1924     end.
     1925     assign
     1926       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1927     .
     1928     if p-change-value = 0
     1929     then do:
     1930       run diasize_position-resize-button in this-procedure .
     1931       return .
     1932     end.
     1933     move_block:
     1934     do
     1935     on error undo move_block, leave move_block
     1936     :
     1937       if retry
     1938       then do:
     1939         do
     1940         on error undo move_block, leave move_block
     1941         :
     1942           if p-change-value > 0
     1943           then do:
     1944             for each buf_temp-diasize-handle
     1945             on error undo, next
     1946             :
     1947               assign
     1948                 v-object-handle = buf_temp-diasize-handle.handle-value
     1949               .
     1950               if v-object-handle <> v-diasize-resize-button
     1951               then do:
     1952                 assign
     1953                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1954                 .
     1955               end.
     1956             end.
     1957             assign
     1958               v-diasize-browse-handle :width = v-browse-width
     1959             .
     1960             for each buf_temp-browse-handle
     1961               where buf_temp-browse-handle.browse-type = 'width':u
     1962             on error undo, next
     1963             :
     1964               assign
     1965                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1966               .
     1967             end.
     1968             assign
     1969               frame Dialog-Frame :width = v-frame-width
     1970             .
     1971             if frame Dialog-Frame :scrollable = true
     1972             then do:
     1973               assign
     1974                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1975               .
     1976             end.
     1977             run diasize_position-resize-button in this-procedure .
     1978           end.
     1979           else do:
     1980             if frame Dialog-Frame :scrollable = true
     1981             then do:
     1982               assign
     1983                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1984               .
     1985             end.
     1986             assign
     1987               frame Dialog-Frame :width = v-frame-width
     1988             .
     1989             for each buf_temp-browse-handle
     1990               where buf_temp-browse-handle.browse-type = 'width':u
     1991             on error undo, next
     1992             :
     1993               assign
     1994                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1995               .
     1996             end.
     1997             assign
     1998               v-diasize-browse-handle :width = v-browse-width
     1999             .
     2000             for each buf_temp-diasize-handle
     2001             on error undo, next
     2002             :
     2003               assign
     2004                 v-object-handle = buf_temp-diasize-handle.handle-value
     2005               .
     2006               if v-object-handle <> v-diasize-resize-button
     2007               then do:
     2008                 assign
     2009                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2010                 .
     2011               end.
     2012             end.
     2013             run diasize_position-resize-button in this-procedure .
     2014           end.
     2015           assign
     2016             v-diasize-change-size = false
     2017           .
     2018           leave move_block .
     2019         end.
     2020       end.
     2021       assign
     2022         v-diasize-need-full-display = true
     2023       .
     2024       if v-diasize-change-size = false
     2025       then do:
     2026         assign
     2027           v-diasize-change-size = true
     2028         .
     2029       end.
     2030       else do:
     2031         return .
     2032       end.
     2033       assign
     2034         v-frame-width = frame Dialog-Frame :width
     2035         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2036         v-browse-width = v-diasize-browse-handle :width
     2037       .
     2038       for each buf_temp-browse-handle
     2039         where buf_temp-browse-handle.browse-type = 'width':u
     2040       :
     2041         assign
     2042           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2043         .
     2044       end.
     2045       for each buf_temp-diasize-handle
     2046       :
     2047         delete buf_temp-diasize-handle .
     2048       end.
     2049       assign
     2050         v-field-group-handle = frame Dialog-Frame :first-child
     2051       .
     2052       do while valid-handle(v-field-group-handle)
     2053       :
     2054         assign
     2055           v-object-handle = v-field-group-handle :first-child
     2056         .
     2057         do while valid-handle(v-object-handle)
     2058         :
     2059           if  v-object-handle <> v-diasize-browse-handle :handle
     2060           and v-object-handle <> v-diasize-resize-button
     2061           and can-query(v-object-handle, "row")
     2062           and can-query(v-object-handle, "height")
     2063           and ( v-object-handle :col + v-object-handle :width
     2064                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2065               )
     2066           then do:
     2067             find first buf_temp-browse-handle
     2068               where buf_temp-browse-handle.browse-type   = 'width':u
     2069                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2070               no-error .
     2071             if available buf_temp-browse-handle
     2072             then do:
     2073             end.
     2074             else do:
     2075               create buf_temp-diasize-handle .
     2076               assign
     2077                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2078                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2079               .
     2080             end.
     2081           end.
     2082           assign
     2083             v-object-handle = v-object-handle :next-sibling
     2084           .
     2085         end.
     2086         assign
     2087           v-field-group-handle = v-field-group-handle :next-sibling
     2088         .
     2089       end.
     2090       do with frame Dialog-Frame
     2091       :
     2092         hide v-diasize-resize-button .
     2093         v-diasize-resize-button :row = 1.
     2094         v-diasize-resize-button :column = 1.
     2095       end.
     2096       if p-change-value > 0
     2097       then do:
     2098         if frame Dialog-Frame :scrollable = true
     2099         then do:
     2100           assign
     2101             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2102             no-error .
     2103           if error-status :error
     2104           or error-status :get-message(1) <> ""
     2105           then do:
     2106             undo move_block, retry move_block.
     2107           end.
     2108         end.
     2109         assign
     2110           frame Dialog-Frame :width = v-frame-width + p-change-value
     2111           no-error .
     2112         if error-status :error
     2113         or error-status :get-message(1) <> ""
     2114         then do:
     2115           undo move_block, retry move_block.
     2116         end.
     2117         assign
     2118           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2119         no-error .
     2120         if error-status :error
     2121         or error-status :get-message(1) <> ""
     2122         then do:
     2123           undo move_block, retry move_block.
     2124         end.
     2125         for each buf_temp-browse-handle
     2126           where buf_temp-browse-handle.browse-type = 'width':u
     2127         on error undo move_block, retry move_block
     2128         :
     2129           assign
     2130             buf_temp-browse-handle.browse-handle :width
     2131               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2132             no-error .
     2133           if error-status :error
     2134           or error-status :get-message(1) <> ""
     2135           then do:
     2136             undo move_block, retry move_block .
     2137           end.
     2138         end.
     2139         for each buf_temp-diasize-handle
     2140         on error undo move_block, retry move_block
     2141         :
     2142           assign
     2143             v-object-handle = buf_temp-diasize-handle.handle-value
     2144           .
     2145           if v-object-handle <> v-diasize-resize-button
     2146           then do:
     2147             assign
     2148               v-object-handle :col = v-object-handle :col + p-change-value
     2149               no-error .
     2150             if error-status :error
     2151             or error-status :get-message(1) <> ""
     2152             then do:
     2153               undo move_block, retry move_block .
     2154             end.
     2155           end.
     2156         end.
     2157       end.
     2158       else do:
     2159         for each buf_temp-diasize-handle
     2160         on error undo move_block, retry move_block
     2161         :
     2162           assign
     2163             v-object-handle = buf_temp-diasize-handle.handle-value
     2164           .
     2165           if v-object-handle <> v-diasize-resize-button
     2166           then do:
     2167             assign
     2168               v-object-handle :col = v-object-handle :col + p-change-value
     2169               no-error .
     2170             if error-status :error
     2171             or error-status :get-message(1) <> ""
     2172             then do:
     2173               undo move_block, retry move_block .
     2174             end.
     2175           end.
     2176         end.
     2177         for each buf_temp-browse-handle
     2178           where buf_temp-browse-handle.browse-type = 'width':u
     2179         on error undo move_block, retry move_block
     2180         :
     2181           assign
     2182             buf_temp-browse-handle.browse-handle :width
     2183               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2184             no-error .
     2185           if error-status :error
     2186           or error-status :get-message(1) <> ""
     2187           then do:
     2188             undo move_block, retry move_block .
     2189           end.
     2190         end.
     2191         assign
     2192           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2193           no-error .
     2194         if error-status :error
     2195         or error-status :get-message(1) <> ""
     2196         then do:
     2197           undo move_block, retry move_block.
     2198         end.
     2199         assign
     2200           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2201         no-error .
     2202         if error-status :error
     2203         or error-status :get-message(1) <> ""
     2204         then do:
     2205           undo move_block, retry move_block.
     2206         end.
     2207         if frame Dialog-Frame :scrollable = true
     2208         then do:
     2209           assign
     2210             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2211           no-error .
     2212           if error-status :error
     2213           or error-status :get-message(1) <> ""
     2214           then do:
     2215             undo move_block, retry move_block.
     2216           end.
     2217         end.
     2218       end.
     2219       if p-move-resize
     2220       then do:
     2221         run diasize_position-resize-button in this-procedure .
     2222       end.
     2223       if v-diasize-wndstore = true
     2224       then do:
     2225         if connected("ub") = true
     2226         then do:
     2227           define variable v-cntxt-db-num        as integer   no-undo .
     2228           define variable v-cntxt-userid        as character no-undo .
     2229           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2230                                             , OUTPUT v-cntxt-userid
     2231                                             ) .
     2232           run gbl/wndsizew.p
     2233             (input  v-cntxt-db-num
     2234             ,input  v-cntxt-userid
     2235             ,input  v-diasize-proc-name
     2236             ,input  'width':u
     2237             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2238             ) .
     2239         end.
     2240       end.
     2241     end.
     2242     assign
     2243       v-diasize-change-size = false
     2244     .
     2245   end procedure.
     2246   procedure diasize_set-width :
     2247     define input  parameter p-new-width  as decimal   no-undo .
     2248     define input  parameter p-move-resize as logical   no-undo .
     2249     do
     2250     on error undo, return error return-value
     2251     :
     2252       run diasize_change-width in this-procedure
     2253         (input  (p-new-width - frame Dialog-Frame :width)
     2254         ,input  p-move-resize
     2255         ) .
     2256     end.
     2257   end procedure.
     2258   procedure diasize_position-resize-button :
     2259     do with frame Dialog-Frame
     2260     :
     2261       hide v-diasize-resize-button .
     2262       assign
     2263         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2264                     - 1
     2265                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2266         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2267                     - 1
     2268                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2269       .
     2270       view v-diasize-resize-button .
     2271     end.
     2272   end procedure.
     2273   on alt-right anywhere
     2274   do:
     2275     run diasize_change-width in this-procedure
     2276       (input 1
     2277       ,input true
     2278       ) .
     2279     return no-apply .
     2280   end.
     2281   on alt-left anywhere
     2282   do:
     2283     run diasize_change-width in this-procedure
     2284       (input -1
     2285       ,input true
     2286       ) .
     2287     return no-apply .
     2288   end.
     2289   on alt-down anywhere
     2290   do:
     2291     run diasize_change-height in this-procedure
     2292       (input 1
     2293       ,input true
     2294       ) .
     2295     return no-apply .
     2296   end.
     2297   on alt-up anywhere
     2298   do:
     2299     run diasize_change-height in this-procedure
     2300       (input -1
     2301       ,input true
     2302       ) .
     2303     return no-apply .
     2304   end.
     2305   on alt-enter of frame Dialog-Frame
     2306   do:
     2307     run diasize_maximize in this-procedure
     2308       (input  ?
     2309       ).
     2310     return no-apply .
     2311   end.
     2312   procedure diasize_end-move :
     2313     do
     2314     on error undo, return error return-value
     2315     :
     2316       define variable v-row-delta as decimal   no-undo .
     2317       define variable v-col-delta as decimal   no-undo .
     2318       define variable v-new-row as decimal   no-undo .
     2319       define variable v-new-col as decimal   no-undo .
     2320       assign
     2321         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2322         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2323       .
     2324       assign
     2325         v-row-delta = v-new-row - frame Dialog-Frame :height
     2326         v-col-delta = v-new-col - frame Dialog-Frame :width
     2327       .
     2328       run diasize_change-height in this-procedure
     2329         (input v-row-delta
     2330         ,input true
     2331         ) .
     2332       run diasize_change-width in this-procedure
     2333         (input v-col-delta
     2334         ,input true
     2335         ) .
     2336     end.
     2337   end procedure.
     2338   procedure diasize_maximize :
     2339     define input  parameter p-action as logical   no-undo .
     2340     do
     2341     on error undo, return error return-value
     2342     :
     2343       if p-action = ?
     2344       then do:
     2345         if v-diasize-need-maximize = true
     2346         then do:
     2347           assign
     2348             p-action = true
     2349           .
     2350         end.
     2351         else do:
     2352           assign
     2353             p-action = false
     2354           .
     2355         end.
     2356       end.
     2357       if p-action = true
     2358       then do:
     2359         run diasize_change-height in this-procedure
     2360           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2361               - frame Dialog-Frame :height-chars
     2362           ,input true
     2363           ) .
     2364         run diasize_change-width in this-procedure
     2365           (input session :width-chars
     2366               - frame Dialog-Frame :width-chars
     2367           ,input true
     2368           ) .
     2369         assign
     2370           v-diasize-need-maximize = false
     2371         .
     2372       end.
     2373       else do:
     2374         run diasize_change-width in this-procedure
     2375           (input v-diasize-orig-frame-width
     2376               - frame Dialog-Frame :width-chars
     2377           ,input true
     2378           ) .
     2379         run diasize_change-height in this-procedure
     2380           (input v-diasize-orig-frame-height
     2381               - frame Dialog-Frame :height-chars
     2382           ,input true
     2383           ) .
     2384         assign
     2385           v-diasize-need-maximize = true
     2386         .
     2387       end.
     2388     end.
     2389   end procedure.
     2390   procedure diasize_restore-orig-size :
     2391     do
     2392     on error undo, return error return-value
     2393     :
     2394       assign
     2395         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2396         v-diasize-current-frame-height = frame Dialog-Frame :height
     2397       .
     2398       run diasize_set-height in this-procedure
     2399         (input  v-diasize-orig-frame-height
     2400         ,input  true
     2401         ) .
     2402       run diasize_set-width in this-procedure
     2403         (input  v-diasize-orig-frame-width
     2404         ,input  true
     2405         ) .
     2406     end.
     2407   end procedure.
     2408   procedure diasize_restore-current-size :
     2409     do
     2410     on error undo, return error return-value
     2411     :
     2412       run diasize_set-height in this-procedure
     2413         (input  v-diasize-current-frame-height
     2414         ,input  true
     2415         ) .
     2416       run diasize_set-width in this-procedure
     2417         (input  v-diasize-current-frame-width
     2418         ,input  true
     2419         ) .
     2420     end.
     2421   end procedure.
     2422   procedure diasize_set-browse-handle :
     2423     define input  parameter p-browse-handle as handle   no-undo .
     2424     define buffer buf_temp-browse-handle for temp-browse-handle .
     2425     do
     2426     on error undo, return error return-value
     2427     :
     2428       assign
     2429         v-diasize-browse-handle = p-browse-handle
     2430       .
     2431       for each buf_temp-browse-handle
     2432       on error undo, return error return-value
     2433       :
     2434         delete buf_temp-browse-handle .
     2435       end.
     2436     end.
     2437   end procedure.
     2438   procedure diasize_add_browse :
     2439     define input  parameter p-browse-type   as character no-undo .
     2440     define input  parameter p-browse-handle as handle    no-undo .
     2441     define buffer buf_temp-browse-handle for temp-browse-handle .
     2442     do
     2443     on error undo, return error return-value
     2444     :
     2445       assign
     2446         v-diasize-browse-number = v-diasize-browse-number + 1
     2447       .
     2448       create buf_temp-browse-handle .
     2449       assign
     2450         buf_temp-browse-handle.browse-type   = p-browse-type
     2451         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2452         buf_temp-browse-handle.browse-handle = p-browse-handle
     2453       .
     2454     end.
     2455   end procedure.
     2456   procedure diasize_init :
     2457     define variable v-default-value    as logical   no-undo .
     2458     define variable v-restore-saved    as logical   no-undo .
     2459     define variable v-resize-value-str as character no-undo .
     2460     do
     2461     on error undo, return error return-value
     2462     :
     2463       do with frame Dialog-Frame
     2464       :
     2465         assign
     2466           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2467           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2468           v-diasize-browse-handle     = browse BR-taracodes :handle
     2469         .
     2470         create button v-diasize-resize-button
     2471         assign
     2472           parent        = frame Dialog-Frame :first-child
     2473           label         = "s"
     2474           height-pixels = 16
     2475           width-pixels  = 16
     2476           visible       = true
     2477           sensitive     = true
     2478           movable       = true
     2479           triggers:
     2480             on end-move persistent run diasize_end-move in this-procedure .
     2481           end triggers.
     2482         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2483         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2484         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2485         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2486         assign
     2487           v-diasize-wndmax = false
     2488         .
     2489         if connected("ub") = true
     2490         then do:
     2491           define variable v-cntxt-db-num        as integer   no-undo .
     2492           define variable v-cntxt-userid        as character no-undo .
     2493           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2494                                             , OUTPUT v-cntxt-userid
     2495                                             ) .
     2496           run gbl/wndpar_r.p
     2497             (input  v-cntxt-db-num
     2498             ,input  v-cntxt-userid
     2499             ,input  'wndmax':U
     2500             ,output v-diasize-wndmax
     2501             ,output v-default-value
     2502             ) .
     2503         end.
     2504         assign
     2505           v-diasize-wndstore = false
     2506         .
     2507         if connected("ub") = true
     2508         then do:
     2509           run gbl/wndpar_r.p
     2510             (input  v-cntxt-db-num
     2511             ,input  v-cntxt-userid
     2512             ,input  'wndstore':U
     2513             ,output v-diasize-wndstore
     2514             ,output v-default-value
     2515             ) .
     2516         end.
     2517         assign
     2518           v-diasize-proc-name = entry(1, program-name(2), '.')
     2519         .
     2520         if v-diasize-wndstore = true
     2521         then do:
     2522           assign
     2523             v-restore-saved = false
     2524           .
     2525           if connected("ub") = true
     2526           then do:
     2527             run gbl/wndsizer.p
     2528               (input  v-cntxt-db-num
     2529               ,input  v-cntxt-userid
     2530               ,input  v-diasize-proc-name
     2531               ,input  'height':u
     2532               ,output v-resize-value-str
     2533               ) .
     2534             if v-resize-value-str <> '':U
     2535             then do:
     2536               run diasize_change-height in this-procedure
     2537                 (input  integer(v-resize-value-str)
     2538                 ,input  true
     2539                 ) .
     2540               assign
     2541                 v-restore-saved = true
     2542               .
     2543             end.
     2544           end.
     2545           if connected("ub") = true
     2546           then do:
     2547             run gbl/wndsizer.p
     2548               (input  v-cntxt-db-num
     2549               ,input  v-cntxt-userid
     2550               ,input  v-diasize-proc-name
     2551               ,input  'width':u
     2552               ,output v-resize-value-str
     2553               ) .
     2554             if v-resize-value-str <> '':U
     2555             then do:
     2556               run diasize_change-width in this-procedure
     2557                 (input  integer(v-resize-value-str)
     2558                 ,input  true
     2559                 ) .
     2560               assign
     2561                 v-restore-saved = true
     2562               .
     2563             end.
     2564           end.
     2565           if v-restore-saved <> true
     2566           then do:
     2567             if v-diasize-wndmax = true
     2568             then do:
     2569               run diasize_maximize in this-procedure
     2570                 (input  true
     2571                 ) .
     2572             end.
     2573           end.
     2574         end.
     2575         else do:
     2576           if v-diasize-wndmax = true
     2577           then do:
     2578             run diasize_maximize in this-procedure
     2579               (input  true
     2580               ) .
     2581           end.
     2582         end.
     2583       end.
     2584     end.
     2585   end procedure.
     2586   procedure diasize_need-full-display :
     2587     define output parameter p-need-full-display as logical   no-undo .
     2588     do
     2589     on error undo, return error return-value
     2590     :
     2591       assign
     2592         p-need-full-display = v-diasize-need-full-display
     2593       .
     2594       assign
     2595         v-diasize-need-full-display = false
     2596       .
     2597     end.
     2598   end procedure.
     2599   procedure get-context :
     2600      define output parameter p-db-num as integer          no-undo.
     2601      define output parameter p-user-id as character        no-undo.
     2602      define variable v-login               as character    no-undo.
     2603      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2604      define buffer buf_user-login  for ub.user-login .
     2605      do
     2606      on error undo, return error
     2607      :
     2608            FIND FIRST buf_sys-ctrl no-lock.
     2609            ASSIGN
     2610               v-login = USERID("ub")
     2611               p-db-num = buf_sys-ctrl.db-num
     2612            .
     2613            FIND FIRST buf_user-login
     2614                 WHERE buf_user-login.db-num = p-db-num
     2615                   AND buf_user-login.user-login = v-login
     2616                 no-lock
     2617                 no-error
     2618                 .
     2619            IF AVAILABLE buf_user-login
     2620            THEN DO:
     2621               assign
     2622                  p-user-id = buf_user-login.user-id
     2623               .
     2624            END.
     2625      end.
     2626   end procedure.
     2627       run diasize_init in this-procedure .
     2628   MAIN-BLOCK:
     2629   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2630      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2631   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2632     run mainmenu_getcntxt in parparentproc
     2633       (output v-cntxt-db-num
     2634       ,output v-cntxt-userid
     2635       ,output v-cntxt-level
     2636       ,output v-cntxt-host-code-obj
     2637       ,output v-cntxt-obj-type
     2638       ,output v-cntxt-obj-code
     2639       ,output v-cntxt-db-num-obj
     2640       ,output v-cntxt-is-admin
     2641       ) .
     2642     if p-db-num = ? then do:
     2643   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2644   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     2645     (input  p-obj-type
     2646     ,input  p-obj-code
     2647     ,output v-obj-db-num
     2648     )  .
     2649       p-db-num = v-obj-db-num.
     2650     end.
     2651     if p-pos-type = ? then do:
     2652   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2653   define variable v-param-type11 as character no-undo .
     2654   define variable v-value-date11 as date no-undo .
     2655   define variable v-value-decimal11 as decimal no-undo .
     2656   define variable v-value-integer11 as INTEGER no-undo .
     2657   define variable v-value-logical11 AS LOGICAL no-undo .
     2658   define variable v-tth11 as handle no-undo .
     2659   run adm/shattri.p (
     2660       input "get":U
     2661       ,input  p-obj-type
     2662       ,input  p-obj-code
     2663       ,input  'cd-sending':U
     2664       ,input  'dflt-cd':U
     2665       ,output dflt-cd
     2666       ,output v-value-date11
     2667       ,output v-value-decimal11
     2668       ,output v-value-integer11
     2669       ,output v-value-logical11
     2670       ,output v-param-type11
     2671       ,INPUT-OUTPUT table-handle v-tth11
     2672       )  .
     2673   delete object v-tth11 no-error.
     2674       p-pos-type = dflt-cd.
     2675     end.
     2676     if p-cash-num = ? then do:
     2677       if p-pos-type = 'NCR-GM':U
     2678       or p-pos-type = 'NCR-AS@R':U then do:
     2679         p-cash-num = 0.
     2680       end.
     2681     end.
     2682     case p-pos-type:
     2683       when 'NCR-GM':U then do:
     2684         v-attr-code = 'tara-ref':U.
     2685         v-upper-attr-code = 'NCR-GM_general':U.
     2686       end.
     2687       when 'NCR-AS@R':U then do:
     2688         v-attr-code = 'tara-ref':U.
     2689         v-upper-attr-code = 'NCR-AS-R_general':U.
     2690       end.
     2691     end.
     2692     if lookup("b-add", bttns) > 0 then do:
     2693       find first locked_cash-desk-attr no-lock where
     2694                 locked_cash-desk-attr.db-num = p-db-num
     2695              and locked_cash-desk-attr.obj-code = p-obj-code
     2696              and locked_cash-desk-attr.pos-type = p-pos-type
     2697              and locked_cash-desk-attr.cash-num = p-cash-num
     2698              AND locked_cash-desk-attr.upper-attr-code = v-upper-attr-code
     2699              and locked_cash-desk-attr.attr-code = v-attr-code no-error .
     2700       if not available locked_cash-desk-attr then do:
     2701         run refresh-root-record in this-procedure .
     2702       end.
     2703       find first locked_cash-desk-attr exclusive-lock where
     2704                 locked_cash-desk-attr.db-num = p-db-num
     2705              and locked_cash-desk-attr.obj-code = p-obj-code
     2706              and locked_cash-desk-attr.pos-type = p-pos-type
     2707              and locked_cash-desk-attr.cash-num = p-cash-num
     2708              AND locked_cash-desk-attr.upper-attr-code = v-upper-attr-code
     2709              and locked_cash-desk-attr.attr-code = v-attr-code .
     2710     end.
     2711     run Myenable IN THIS-PROCEDURE.
     2712     HIDE
     2713     mark-num in frame Dialog-Frame.
     2714     if p-rid-list <> "":U then do:
     2715       assign
     2716       rr = integer(p-rid-list) no-error .
     2717       .
     2718       if not error-status:error then do:
     2719         reposition br-taracodes to recid rr no-error .
     2720       end.
     2721       APPLY "ENTRY" to br-taracodes.
     2722     end.
     2723     WAIT-FOR GO OF FRAME Dialog-Frame.
     2724   END.
     2725   run disable_UI in this-procedure .
     2726   PROCEDURE disable_UI :
     2727     HIDE FRAME Dialog-Frame.
     2728   END PROCEDURE.
     2729   PROCEDURE enable_UI :
     2730     DISPLAY mark-num
     2731         WITH FRAME Dialog-Frame.
     2732     ENABLE b-quit b-mark b-sel b-add b-chg b-del B-Help mark-num BR-taracodes
     2733         WITH FRAME Dialog-Frame.
     2734     VIEW FRAME Dialog-Frame.
     2735     OPEN QUERY BR-taracodes FOR EACH X_cash-desk-attr NO-LOCK where         X_cash-desk-attr.obj-code = p-obj-code     AND X_cash-desk-attr.db-num = p-db-num     AND X_cash-desk-attr.pos-type = p-pos-type     AND X_cash-desk-attr.cash-num = p-cash-num     AND X_cash-desk-attr.upper-attr-code = v-upper-attr-code     AND X_cash-desk-attr.attr-code BEGINS (v-attr-code + chr(4)) INDEXED-REPOSITION.
     2736   END PROCEDURE.
     2737   PROCEDURE MyEnable :
     2738   ASSIGN
     2739   FRAME Dialog-Frame:TITLE = SUBSTITUTE ("&1 &2&3"
     2740                                            , FRAME Dialog-Frame:TITLE
     2741                                           , p-obj-type
     2742                                           , p-obj-code ).
     2743   ENABLE
     2744   b-sel WHEN LOOKUP("b-sel", bttns) > 0
     2745   b-mark WHEN LOOKUP("b-mark", bttns) > 0
     2746   b-quit
     2747   b-add WHEN LOOKUP("b-add", bttns) > 0
     2748   b-chg WHEN LOOKUP("b-add", bttns) > 0
     2749   b-del WHEN LOOKUP("b-add", bttns) > 0
     2750   B-Help
     2751   BR-taracodes
     2752   WITH FRAME Dialog-Frame.
     2753   VIEW FRAME Dialog-Frame.
     2754   OPEN QUERY BR-taracodes FOR EACH X_cash-desk-attr NO-LOCK where         X_cash-desk-attr.obj-code = p-obj-code     AND X_cash-desk-attr.db-num = p-db-num     AND X_cash-desk-attr.pos-type = p-pos-type     AND X_cash-desk-attr.cash-num = p-cash-num     AND X_cash-desk-attr.upper-attr-code = v-upper-attr-code     AND X_cash-desk-attr.attr-code BEGINS (v-attr-code + chr(4)) INDEXED-REPOSITION.
     2755   END PROCEDURE.
     2756   PROCEDURE proc-b-add :
     2757   DEFINE buffer buf_cash-desk-attr FOR ub.cash-desk-attr.
     2758   DEFINE VARIABLE v-value AS CHARACTER NO-UNDO.
     2759   define variable v-rid as recid no-undo .
     2760   run gbl/d-prompt.w (
     2761             'title=':u + "Введите код тары" + '\':u
     2762           + 'format=' + "99" + '\':u
     2763           + 'type=' + 'I':U + '\':u
     2764           + 'fillin_row=2\':u
     2765           + 'fillin_col=4\':u
     2766           + 'fillin_width=10\':u
     2767           + 'fillin_height=1\':u
     2768           + 'max-chars=12\':u
     2769           + 'readonly=no\':u
     2770           , input-output v-value
     2771           ).
     2772   if return-value = 'false':u then return NO-apply.
     2773   if v-value = '00' then do:
     2774     message
     2775     "Нельзя ввести код <00>" skip
     2776     "Разрешенные значения кодов 01-99"
     2777     view-as alert-box error
     2778     .
     2779     undo, return error .
     2780   end.
     2781   FIND FIRST buf_cash-desk-attr no-LOCK WHERE
     2782            buf_cash-desk-attr.attr-code = (v-attr-code + chr(4) + v-value)
     2783       AND buf_cash-desk-attr.upper-attr-code = v-upper-attr-code
     2784      AND   buf_cash-desk-attr.db-num = p-db-num
     2785       AND   buf_cash-desk-attr.obj-code = p-obj-code
     2786       AND   buf_cash-desk-attr.pos-type = p-pos-type
     2787       AND   buf_cash-desk-attr.cash-num = p-cash-num NO-ERROR.
     2788   IF AVAILABLE buf_cash-desk-attr THEN DO:
     2789     MESSAGE
     2790     SUBSTITUTE("Тара с таким кодом уже есть в справочнике для касс магазина &1", p-obj-code)
     2791     VIEW-AS ALERT-BOX ERROR.
     2792   END.
     2793   CREATE buf_cash-desk-attr.
     2794   ASSIGN
     2795   buf_cash-desk-attr.attr-code = (v-attr-code + chr(4) + v-value)
     2796   buf_cash-desk-attr.upper-attr-code = v-upper-attr-code
     2797   buf_cash-desk-attr.db-num = p-db-num
     2798   buf_cash-desk-attr.obj-code = p-obj-code
     2799   buf_cash-desk-attr.pos-type = p-pos-type
     2800   buf_cash-desk-attr.cash-num = p-cash-num
     2801   v-rid = recid(buf_cash-desk-attr).
     2802   .
     2803   release buf_cash-desk-attr no-error.
     2804   if error-status:error then return no-apply.
     2805   OPEN QUERY BR-taracodes FOR EACH X_cash-desk-attr NO-LOCK where         X_cash-desk-attr.obj-code = p-obj-code     AND X_cash-desk-attr.db-num = p-db-num     AND X_cash-desk-attr.pos-type = p-pos-type     AND X_cash-desk-attr.cash-num = p-cash-num     AND X_cash-desk-attr.upper-attr-code = v-upper-attr-code     AND X_cash-desk-attr.attr-code BEGINS (v-attr-code + chr(4)) INDEXED-REPOSITION.
     2806   run refresh-root-record in this-procedure .
     2807   reposition br-taracodes to recid v-rid no-error.
     2808   APPLY "ENTRY" TO br-taracodes in frame Dialog-Frame .
     2809   END PROCEDURE.
     2810   PROCEDURE proc-b-chg :
     2811   DEFINE VARIABLE v-value AS CHARACTER NO-UNDO.
     2812   DEFINE buffer buf_cash-desk-attr FOR ub.cash-desk-attr.
     2813   IF NOT AVAILABLE X_cash-desk-attr THEN RETURN NO-APPLY.
     2814   run gbl/d-prompt.w (
     2815         'title=':u + "Изменить вес тары (гр)" + '\':u
     2816       + 'format=' + "9999" + '\':u
     2817       + 'type=' + 'D':U + '\':u
     2818       + 'fillin_row=2\':u
     2819       + 'fillin_col=4\':u
     2820       + 'fillin_width=10\':u
     2821       + 'fillin_height=1\':u
     2822       + 'max-chars=12\':u
     2823       + 'readonly=no\':u
     2824       , input-output v-value
     2825       ).
     2826       if return-value = 'false':u then return NO-apply.
     2827   FIND FIRST buf_cash-desk-attr EXCLUSIVE-LOCK WHERE
     2828            buf_cash-desk-attr.attr-code = X_cash-desk-attr.attr-code
     2829      AND buf_cash-desk-attr.upper-attr-code = v-upper-attr-code
     2830      AND   buf_cash-desk-attr.db-num = X_cash-desk-attr.db-num
     2831       AND   buf_cash-desk-attr.obj-code = X_cash-desk-attr.obj-code
     2832       AND   buf_cash-desk-attr.pos-type = X_cash-desk-attr.pos-type
     2833       AND   buf_cash-desk-attr.cash-num = X_cash-desk-attr.cash-num .
     2834   ASSIGN
     2835   buf_cash-desk-attr.attr-value-character = v-value.
     2836   run refresh-root-record in this-procedure .
     2837   br-taracodes:REFRESH() IN FRAME Dialog-Frame.
     2838   APPLY "ENTRY" TO br-taracodes.
     2839   END PROCEDURE.
     2840   PROCEDURE proc-b-del :
     2841   DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     2842   DEFINE buffer buf_cash-desk-attr FOR ub.cash-desk-attr.
     2843   IF NOT AVAILABLE X_cash-desk-attr THEN RETURN NO-APPLY.
     2844   MESSAGE
     2845   substitute("Вы уверены, что хотите удалить код тары &1?&2" +
     2846              "Если данный код может использоваться"
     2847              ,entry(2, X_cash-desk-attr.attr-code, chr(4))
     2848             ,chr(10))
     2849   VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     2850   IF NOT glog  THEN RETURN ERROR.
     2851   FIND FIRST buf_cash-desk-attr EXCLUSIVE-LOCK WHERE
     2852            buf_cash-desk-attr.attr-code = X_cash-desk-attr.attr-code
     2853       AND buf_cash-desk-attr.upper-attr-code = v-upper-attr-code
     2854      AND   buf_cash-desk-attr.db-num = X_cash-desk-attr.db-num
     2855       AND   buf_cash-desk-attr.obj-code = X_cash-desk-attr.obj-code
     2856       AND   buf_cash-desk-attr.pos-type = X_cash-desk-attr.pos-type
     2857       AND   buf_cash-desk-attr.cash-num = X_cash-desk-attr.cash-num .
     2858   DELETE buf_cash-desk-attr.
     2859   run refresh-root-record in this-procedure .
     2860   OPEN QUERY BR-taracodes FOR EACH X_cash-desk-attr NO-LOCK where         X_cash-desk-attr.obj-code = p-obj-code     AND X_cash-desk-attr.db-num = p-db-num     AND X_cash-desk-attr.pos-type = p-pos-type     AND X_cash-desk-attr.cash-num = p-cash-num     AND X_cash-desk-attr.upper-attr-code = v-upper-attr-code     AND X_cash-desk-attr.attr-code BEGINS (v-attr-code + chr(4)) INDEXED-REPOSITION.
     2861   APPLY "ENTRY" TO br-taracodes IN FRAME Dialog-Frame.
     2862   END PROCEDURE.
     2863   PROCEDURE refresh-root-record :
     2864   DEFINE VARIABLE v-today as date no-undo .
     2865   DEFINE VARIABLE v-time as integer no-undo .
     2866   DEFINE VARIABLE v-comp-name AS CHARACTER NO-UNDO.
     2867   DEFINE BUFFER buf_cash-desk-attr FOR ub.cash-desk-attr .
     2868   FIND FIRST buf_cash-desk-attr no-LOCK WHERE
     2869            buf_cash-desk-attr.attr-code = (v-attr-code )
     2870       AND buf_cash-desk-attr.upper-attr-code = v-upper-attr-code
     2871      AND   buf_cash-desk-attr.db-num = p-db-num
     2872       AND   buf_cash-desk-attr.obj-code = p-obj-code
     2873       AND   buf_cash-desk-attr.pos-type = p-pos-type
     2874       AND   buf_cash-desk-attr.cash-num = p-cash-num NO-ERROR.
     2875   IF NOT AVAILABLE buf_cash-desk-attr THEN DO:
     2876       CREATE buf_cash-desk-attr.
     2877       ASSIGN
     2878       buf_cash-desk-attr.attr-code = (v-attr-code)
     2879       buf_cash-desk-attr.upper-attr-code = v-upper-attr-code
     2880       buf_cash-desk-attr.db-num = p-db-num
     2881       buf_cash-desk-attr.obj-code = p-obj-code
     2882       buf_cash-desk-attr.pos-type = p-pos-type
     2883       buf_cash-desk-attr.cash-num = p-cash-num .
     2884   END.
     2885   run cur-time in this-procedure ( output v-today, output v-time).
     2886   assign
     2887   buf_cash-desk-attr.attr-value-character = SUBSTITUTE ("... (послед. изменение &1 &2 &3)"
     2888                                              ,v-cntxt-userid
     2889                                              ,string(v-today, "99/99/9999")
     2890                                              ,string(v-time, "hh:mm:ss")
     2891                                              ).
     2892   END PROCEDURE.
