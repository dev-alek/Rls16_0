      914   define input  parameter p-obj-code    like ub.cash-desk-attr.obj-code no-undo .
      915   define input  parameter p-pos-type    like ub.cash-desk-attr.pos-type no-undo .
      916   define input  parameter p-cash-num    like ub.cash-desk-attr.cash-num no-undo .
      917   define input-output parameter p-character as character no-undo .
      918   define input-output parameter p-date      as date      no-undo .
      919   define input-output parameter p-decimal   as decimal   no-undo .
      920   define input-output parameter p-integer   as integer   no-undo .
      921   define input-output parameter p-logical   as logical   no-undo .
      922   define output parameter p-setted      as logical no-undo .
      923     do
      924     on error undo, return error return-value
      925     :
      926           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run cd-attr-spr-tara-ref in g#attr-lib
      927         (input  parparentproc
