     4162     return no-apply.
     4163   end.
     4164   ON return OF loc-code IN FRAME d-gob-doc-ref do:
     4165     run proc-mouse-dbl-click-loc-code in this-procedure   no-error.
     4166     return no-apply.
     4167   end.
     4168   ON return, Ctrl-J OF loc-name IN FRAME d-gob-doc-ref do:
     4169     run proc-mouse-dbl-click-loc-name in this-procedure   no-error.
     4170     return no-apply.
