     3537   procedure fltfield-clear :
     3538     define output parameter loc-fld as character no-undo.
     3539     define output parameter loc-lab as character no-undo .
     3540     define output parameter loc-spr as character no-undo .
     3541     define output parameter loc-dim as character no-undo .
     3542     assign
     3543       loc-fld = ""
     3544       loc-lab = ""
     3545       loc-spr = ""
     3546       loc-dim = "0"
     3547     .
     3548   end procedure .
     3549   procedure fltfield-add :
     3550     define input        parameter par-fld as character no-undo.
     3551     define input        parameter par-lab as character no-undo .
     3552     define input        parameter par-spr as character no-undo .
     3553     define input-output parameter loc-fld as character no-undo.
     3554     define input-output parameter loc-lab as character no-undo .
     3555     define input-output parameter loc-spr as character no-undo .
     3556     define input-output parameter loc-dim as character no-undo .
     3557     do
     3558     on error undo, return error
     3559     :
     3560       assign
     3561       loc-fld = if loc-dim = '0'
     3562                 then par-fld
     3563                 else (loc-fld + chr(44) + par-fld)
     3564       loc-lab = if loc-dim = '0'
     3565                 then par-lab
     3566                 else (loc-lab + chr(44) + par-lab)
     3567       loc-spr = if loc-dim = '0'
     3568                 then par-spr
     3569                 else (loc-spr + chr(44) + par-spr)
     3570       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
     3571                 string(integer(if num-entries(loc-dim) > 1
     3572                               then entry(2, loc-dim)
     3573                               else entry(1, loc-dim)
     3574                               ) + 1)
     3575       no-error
     3576       .
     3577     end.
     3578   end procedure.
