     2189   FUNCTION gdsreffi_last-pcnt returns decimal ( buffer buf_goods for ub.goods
     2190                                             ,input p-obj-type as character
     2191                                             ,input p-obj-code as integer):
     2192   define buffer buf_gds-obj for ub.gds-obj.
     2193   define variable v-value as decimal no-undo .
     2194   find first buf_gds-obj no-lock where
     2195               buf_gds-obj.gds-code = buf_goods.gds-code
     2196         AND  buf_gds-obj.obj-type = p-obj-type
     2197         AND  buf_gds-obj.obj-code = p-obj-code no-error .
     2198   if available buf_gds-obj then do:
     2199     assign
     2200     v-value =
     2201               (buf_gds-obj.price-sale / (if v-curr-r-b = 'base':U
     2202                                         then buf_gds-obj.last-base
     2203                                         else buf_gds-obj.last-rubl)
     2204                 * 100 - 100)
     2205     no-error
     2206     .
     2207   end.
     2208   else do:
     2209     v-value = ?  .
     2210   end.
     2211   return v-value.
     2212   end FUNCTION.
     2213   FUNCTION gdsreffi_in-doc-cli-name returns character ( buffer buf_goods for ub.goods
     2214                                             ,input p-obj-type as character
     2215                                             ,input p-obj-code as integer):
     2216   define buffer buf_gds-obj for ub.gds-obj.
     2217   define buffer buf_trn-doc for ub.trn-doc.
     2218   define buffer buf_clients for ub.clients.
     2219   define buffer buf_parts for ub.parts.
     2220   define variable v-value as decimal no-undo .
     2221   for first buf_gds-obj no-lock where
     2222               buf_gds-obj.gds-code = buf_goods.gds-code
     2223         AND  buf_gds-obj.obj-type = p-obj-type
     2224         AND  buf_gds-obj.obj-code = p-obj-code ,
     2225             first buf_trn-doc no-lock where buf_trn-doc.doc-code = buf_gds-obj.in-code,
     2226             first buf_clients no-lock where buf_clients.obj-type = buf_trn-doc.cli-type and  buf_clients.obj-code = buf_trn-doc.cli-code:
     2227           return buf_clients.obj-name .
     2228   end.
     2229   for first buf_parts no-lock where
     2230              buf_parts.artic = buf_goods.artic
     2231         and  buf_parts.prod-type = buf_goods.prod-type
     2232         and  buf_parts.prod-code = buf_goods.prod-code
     2233         AND  buf_parts.obj-type = p-obj-type
     2234         AND  buf_parts.obj-code = p-obj-code
     2235         and  buf_parts.out-code = 'free-zone':U ,
     2236             first buf_clients no-lock where buf_clients.obj-type = buf_parts.supp-type and  buf_clients.obj-code = buf_parts.supp-code:
     2237           return buf_clients.obj-name .
     2238   end.
     2239   end FUNCTION.
     2240   PROCEDURE gds-ref-fi:
     2241   DEFINE PARAMETER BUFFER fi-goods for ub.goods.
     2242   DEFINE PARAMETER BUFFER fi-gds-obj for ub.gds-obj.
     2243   DEFINE INPUT PARAMETER v-obj-type like ub.clients.obj-type.
     2244   DEFINE INPUT PARAMETER v-obj-code like ub.clients.obj-code.
     2245   DEFINE INPUT PARAMETER v-gds-ref-fi as char no-undo.
     2246   define input parameter p-excel as logical no-undo .
     2247   DEFINE INPUT-OUTPUT PARAMETER fi-1 as char no-undo.
     2248   DEFINE INPUT-OUTPUT PARAMETER fi-2 as char no-undo.
     2249   DEFINE INPUT-OUTPUT PARAMETER fi-3 as char no-undo.
     2250   DEFINE INPUT-OUTPUT PARAMETER fi-4 as char no-undo.
     2251   DEFINE INPUT-OUTPUT PARAMETER fi-5 as char no-undo.
     2252   DEFINE INPUT-OUTPUT PARAMETER fi-6 as char no-undo.
     2253   DEFINE INPUT-OUTPUT PARAMETER fi-7 as char no-undo.
     2254   DEFINE INPUT-OUTPUT PARAMETER fi-8 as char no-undo.
     2255   DEFINE VARiable II AS INTEGER NO-UNDO.
     2256   DEFINE BUFFER fi-gds-prt for ub.gds-prt.
     2257   define buffer fi-condition-keeping for ub.condition-keeping .
     2258   DEFINE variable myfi as char no-undo extent 8.
     2259   DEFINE VARiable jj as integer no-undo init 1.
     2260   DEFINE variable Myformat as character no-undo.
     2261   DEFINE VARiable vNum-entries as integer no-undo.
     2262   DEFINE VARiable entry-ii as character no-undo.
     2263   DEFINE VARiable vvalue as character no-undo.
     2264   DEFINE VARiable vtype as character no-undo.
     2265   DEFINE VARiable vlabel as character no-undo.
     2266   define buffer buf_usr-flt_custom-labels for usr-flt_custom-labels.
     2267     IF v-gds-ref-fi = "" then
     2268     v-gds-ref-fi = 'goods.gds-name,goods.#prod-name,goods.#prt-root-name,goods.negative-rest,gds-obj.#VAT-PC,goods.ALPHA1,gds-obj.in-date':U.
     2269    if avail fi-goods then do:
     2270   vNum-entries = NUm-ENTRIES(v-gds-ref-fi).
     2271     DO ii = 1 to vNum-entries:
     2272       entry-ii = ENTRY(ii, v-gds-ref-fi).
     2273       find first buf_usr-flt_custom-labels where
     2274                 buf_usr-flt_custom-labels.tbl-name = entry(1, entry-ii, ".")
     2275            and  buf_usr-flt_custom-labels.fld-name = entry(2, entry-ii, ".")
     2276            and  buf_usr-flt_custom-labels.call-point =  'gdsreffi':U
     2277            and  buf_usr-flt_custom-labels.call-type = 'add-fields':U no-error.
     2278       if  available buf_usr-flt_custom-labels then do:
     2279         case buf_usr-flt_custom-labels.tbl-name:
     2280           when 'goods':U then do:
     2281             if entry(2, entry-ii, ".") begins "#" then do:
     2282               assign
     2283               myfi[jj] =
     2284               buf_usr-flt_custom-labels.custom-label  + chr(32) +
     2285                          string(dynamic-function(buf_usr-flt_custom-labels.custom-view-func, buffer fi-goods)
     2286                                 , buf_usr-flt_custom-labels.custom-format) no-error .
     2287             end.
     2288             else do:
     2289               myfi[jj] =
     2290               buf_usr-flt_custom-labels.custom-label  + chr(32) +
     2291                           string(buffer fi-goods:buffer-field(buf_usr-flt_custom-labels.fld-name):buffer-value, buf_usr-flt_custom-labels.custom-format).
     2292             end.
     2293           end.
     2294           when 'gds-obj':U then do:
     2295             if entry(2, entry-ii, ".") begins "#" then do:
     2296               assign
     2297               myfi[jj] =
     2298               buf_usr-flt_custom-labels.custom-label  + chr(32) +
     2299                          string(dynamic-function(buf_usr-flt_custom-labels.custom-view-func
     2300                                         ,buffer fi-goods
     2301                                         ,input v-obj-type
     2302                                         ,input v-obj-code
     2303                                         )
     2304                          , buf_usr-flt_custom-labels.custom-format) no-error .
     2305             end.
     2306             else do:
     2307               if available fi-gds-obj then do:
     2308                 myfi[jj] =
     2309                             buf_usr-flt_custom-labels.custom-label  + chr(32) +
     2310                             string(buffer fi-gds-obj:buffer-field(buf_usr-flt_custom-labels.fld-name):buffer-value, buf_usr-flt_custom-labels.custom-format).
     2311               end.
     2312               else do:
     2313                 myfi[jj] =
     2314                 buf_usr-flt_custom-labels.custom-label +
     2315                 ""
     2316                 .
     2317               end.
     2318             end.
     2319           end.
     2320           when 'goods-attr':U then do:
     2321             if entry(2, entry-ii, ".") begins "#" then do:
     2322             end.
     2323             else do:
     2324               vvalue = "[!!Ошибка]".
     2325               run gds-attr-value in this-procedure ( fi-goods.gds-code
     2326                                                     ,input entry(2, buf_usr-flt_custom-labels.fld-name, "_")
     2327                                                     ,output vvalue
     2328                                                     ,output vtype) no-error.
     2329               myfi[jj] =
     2330               buf_usr-flt_custom-labels.custom-label  + chr(32) +
     2331                          native-string(vvalue, buf_usr-flt_custom-labels.fld-data-type, buf_usr-flt_custom-labels.custom-format).
     2332             end.
     2333           end.
     2334           when 'gds-obj-attr':U then do:
     2335             if entry(2, entry-ii, ".") begins "#" then do:
     2336             end.
     2337             else do:
     2338               vvalue = "[!!Ошибка]".
     2339               run gdsoattr-value in this-procedure (
     2340                                                     input  entry(2, buf_usr-flt_custom-labels.fld-name, "_")
     2341                                                    ,input  fi-goods.gds-code
     2342                                                    ,input v-obj-type
     2343                                                    ,input v-obj-code
     2344                                                    ,output vvalue
     2345                                                    ,output vtype
     2346                                                    ) no-error .
     2347               myfi[jj] =
     2348               buf_usr-flt_custom-labels.custom-label  + chr(32) +
     2349                          native-string(vvalue, buf_usr-flt_custom-labels.fld-data-type, buf_usr-flt_custom-labels.custom-format).
     2350             end.
     2351           end.
     2352           when 'gds-host-attr':U then do:
     2353             if entry(2, entry-ii, ".") begins "#" then do:
     2354             end.
     2355             else do:
     2356               vvalue = "[!!Ошибка]".
     2357               run gdshattr-value in this-procedure (
     2358                                                     input  entry(2, buf_usr-flt_custom-labels.fld-name, "_")
     2359                                                    ,input  fi-goods.gds-code
     2360                                                    ,input v-obj-type
     2361                                                    ,input v-obj-code
     2362                                                    ,output vvalue
     2363                                                    ,output vtype
     2364                                                    ) no-error .
     2365               myfi[jj] =
     2366               buf_usr-flt_custom-labels.custom-label  + chr(32) +
     2367                          native-string(vvalue, buf_usr-flt_custom-labels.fld-data-type, buf_usr-flt_custom-labels.custom-format).
     2368             end.
     2369           end.
     2370         end case.
     2371         if p-excel then do:
     2372           if buf_usr-flt_custom-labels.fld-data-type = 'decimal':U
     2373           or buf_usr-flt_custom-labels.fld-data-type = 'integer':U
     2374           then do:
     2375             myfi[jj] = replace(myfi[jj], chr(44), "").
     2376           end.
     2377         end.
     2378         jj = jj + 1.
     2379         if jj = 9 then LEAVE.
     2380       end.
     2381         else if entry(1, entry-ii, ".") = 'goods-attr':U then  do:
     2382           vvalue = "[!!Ошибка]".
     2383                   run gds-attr-value in this-procedure ( fi-goods.gds-code
     2384                                                         ,input (SUBSTRING (entry-ii,INDEX(entry-ii,"_") + 1))
     2385                                                         ,output vvalue
     2386                                                         ,output vtype) no-error.
     2387                   myfi[jj] = vvalue.
     2388         end.
     2389     END.
     2390     end.
     2391     assign
     2392     fi-1 = myfi[1]
     2393     fi-2 = myfi[2]
     2394     fi-3 = myfi[3]
     2395     fi-4 = myfi[4]
     2396     fi-5 = myfi[5]
     2397     fi-6 = myfi[6]
     2398     fi-7 = myfi[7]
     2399     fi-8 = myfi[8]
     2400     .
     2401   END PROCEDURE.
     2402   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2403   PROCEDURE gds-ref-to:
     2404   DEFINE INPUT PARAMETER v-gds-ref-fi as char no-undo.
     2405   DEFINE INPUT-OUTPUT PARAMETER to-1 as char no-undo.
     2406   DEFINE INPUT-OUTPUT PARAMETER to-2 as char no-undo.
     2407   DEFINE INPUT-OUTPUT PARAMETER to-3 as char no-undo.
     2408   DEFINE INPUT-OUTPUT PARAMETER to-4 as char no-undo.
     2409   DEFINE INPUT-OUTPUT PARAMETER to-5 as char no-undo.
     2410   DEFINE INPUT-OUTPUT PARAMETER to-6 as char no-undo.
     2411   DEFINE INPUT-OUTPUT PARAMETER to-7 as char no-undo.
     2412   DEFINE INPUT-OUTPUT PARAMETER to-8 as char no-undo.
     2413   DEFINE VARiable II AS INTEGER NO-UNDO.
     2414   DEFINE variable myto as char no-undo extent 8.
     2415   DEFINE variable mypr as char no-undo extent 8.
     2416   DEFINE VARiable jj as integer no-undo init 1.
     2417   DEFINE VARiable vNum-entries as integer no-undo.
     2418   DEFINE VARiable entry-ii as char no-undo.
     2419   define buffer buf_custom-labels for ub.custom-labels.
     2420   define buffer buf_usr-flt_custom-labels for usr-flt_custom-labels.
     2421   IF v-gds-ref-fi = "" then
     2422   v-gds-ref-fi = 'goods.gds-name,goods.#prod-name,goods.#prt-root-name,goods.negative-rest,gds-obj.#VAT-PC,goods.ALPHA1,gds-obj.in-date':U.
     2423   vNum-entries = NUm-ENTRIES(v-gds-ref-fi).
     2424   for each usr-flt_custom-labels:
     2425     delete usr-flt_custom-labels.
     2426   end.
     2427   DO ii = 1 to vNum-entries:
     2428      entry-ii = ENTRY(ii, v-gds-ref-fi).
     2429     find first buf_custom-labels no-lock where
     2430             buf_custom-labels.tbl-name = entry(1, entry-ii, ".":U)
     2431         and buf_custom-labels.fld-name = entry(2, entry-ii, ".":U)
     2432         and buf_custom-labels.call-point = 'gdsreffi':U
     2433         and buf_custom-labels.call-type = 'add-fields':U
     2434         no-error.
     2435      if available buf_custom-labels then do:
     2436        create buf_usr-flt_custom-labels.
     2437        buffer-copy buf_custom-labels to buf_usr-flt_custom-labels.
     2438         assign
     2439         myto[jj] =  buf_custom-labels.custom-tooltip
     2440         .
     2441      end.
     2442      else do:
     2443       message "Для пользователя " v-cntxt-userid skip "настройки доп.поле справочника товаров содержат неопознанный элемент " ENTRY-ii skip "Обратитесь к администратору системы" skip error-status:get-message(1) skip return-value skip view-as alert-box ERROR.
     2444      END.
     2445      jj = jj + 1.
     2446      if jj = 9 then LEAVE.
     2447   END.
     2448   assign
     2449   to-1 = myto[1]
     2450   to-2 = myto[2]
     2451   to-3 = myto[3]
     2452   to-4 = myto[4]
     2453   to-5 = myto[5]
     2454   to-6 = myto[6]
     2455   to-7 = myto[7]
     2456   to-8 = myto[8]
     2457   .
     2458   END PROCEDURE.
     2459   PROCEDURE gds-ref-to-description:
     2460   define variable v-ok  as logical no-undo .
     2461     run ref/cstmlabs.w ( input parparentproc
     2462                        ,input 'add-fields':U
     2463                        ,input 'gdsreffi':U
     2464                        ,input no
     2465                        ,input 8
     2466                        ,output v-ok
     2467                        ) no-error.
     2468   if v-ok then do:
     2469     message
     2470     "Изменения вступят в силу при следующем входе в справочник товаров"
     2471     view-as alert-box warning.
     2472   end.
     2473   END PROCEDURE.
     2474   define new global shared variable g#libbcrcn as handle no-undo .
     2475   define new global shared variable g#lib-trn  as handle no-undo .
     2476   define new global shared variable g#lib-trn2 as handle no-undo .
     2477   define new global shared variable g#lib-trn3 as handle no-undo .
     2478   define new global shared variable g#lib-trn4 as handle no-undo .
     2479   define variable vss-include-info16 as character format "X(65)" no-undo
     2480   initial "@(#)$Workfile$ $Revision$".
     2481   procedure grplib-get-full-name :
     2482      define input parameter p-node-code  as integer      no-undo.
     2483      define output parameter p-full-name as character    no-undo.
     2484      do
     2485   on error undo, return error
     2486   :
     2487       define variable v-upper-code    as integer           no-undo.
     2488       define buffer buf_gds-grp       for ub.gds-grp.
     2489       define buffer buf_upper_gds-grp for ub.gds-grp.
     2490       find first buf_gds-grp no-lock
     2491            where buf_gds-grp.node-code = p-node-code
     2492       no-error.
     2493       if not available buf_gds-grp
     2494       then do:
     2495           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     2496       end.
     2497       assign
     2498           p-full-name  = ""
     2499           v-upper-code = 1
     2500       .
     2501       do while buf_gds-grp.upper-code <> 0
     2502       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     2503       :
     2504           assign
     2505               p-full-name  = buf_gds-grp.node-name
     2506                            + (if p-full-name <> "" then chr(47) else "")
     2507                            + p-full-name
     2508               v-upper-code = buf_gds-grp.upper-code
     2509           .
     2510           find first buf_gds-grp no-lock
     2511                where buf_gds-grp.node-code = v-upper-code
     2512           no-error.
     2513           if not available buf_gds-grp
     2514           then do:
     2515               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     2516                                   + string( v-upper-code )
     2517                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     2518           end.
     2519       end.
     2520       assign
     2521       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     2522       .
     2523   end.
     2524   end .
     2525   procedure grplib-get-node-from-full-name :
     2526   define input parameter p-full-name as character no-undo .
     2527   define output parameter p-node-code as integer no-undo .
     2528   define variable v-ii as integer no-undo .
     2529   define variable v-upper-code as integer no-undo .
     2530   define variable v-root-code as integer no-undo .
     2531   define variable v-entry as character no-undo .
     2532   define buffer buf_gds-grp       for ub.gds-grp.
     2533   do
     2534   on error undo, return error
     2535   :
     2536     find first buf_gds-grp no-lock
     2537         where buf_gds-grp.upper-code = 0
     2538     no-error .
     2539     if not available buf_gds-grp
     2540     then do:
     2541         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     2542     end.
     2543     else do:
     2544       assign
     2545       v-root-code = buf_gds-grp.node-code
     2546       .
     2547     end.
     2548     v-upper-code = v-root-code.
     2549     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     2550       assign
     2551       v-entry = entry(v-ii, p-full-name, chr(47)).
     2552       if v-entry = '' then leave.
     2553       find first buf_gds-grp no-lock where
     2554                 buf_gds-grp.node-name = v-entry
     2555             and buf_gds-grp.upper-code = v-upper-code
     2556             no-error.
     2557       if not available buf_gds-grp then do:
     2558         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     2559       end.
     2560       else do:
     2561         p-node-code = buf_gds-grp.node-code.
     2562         v-upper-code = buf_gds-grp.node-code.
     2563       end.
     2564     end.
     2565   end.
     2566   end .
     2567   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2568   define variable v-waitfram-action01         as character   no-undo .
     2569   define variable v-waitfram-action02         as character   no-undo .
     2570   define variable v-waitfram-action03         as character   no-undo .
     2571   define variable mWaitFramTextBeg            as character   no-undo.
     2572   define variable mWaitFramTextEnd            as character   no-undo.
     2573   define variable mWaitFramView               as logical     no-undo.
     2574   define variable mWaitProcEvent              as logical     no-undo init yes.
     2575   define variable mWaitFramInterval           as integer     no-undo init 1 .
     2576   define variable mWaitFramStop               as logical     no-undo.
     2577   define variable mWaitFramStopUser           as logical     no-undo.
     2578   define variable mWaitFramStopTimeOut        as logical     no-undo.
     2579   define variable mWaitFramStartProc          as datetime-tz no-undo.
     2580   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     2581   define button B-WaitFramStop auto-end-key
     2582        label "Стоп"
     2583        size 10 by 1 tooltip "Остоновить процесс".
     2584   define button B-viewProcInfo
     2585        label "Информация"
     2586        size 15 by 1 tooltip "Информация о процесс".
     2587   define frame waitfram
     2588     v-waitfram-action01 format "x(72)" no-label skip
     2589     v-waitfram-action02 format "x(72)" no-label skip
     2590     v-waitfram-action03 format "x(72)" no-label skip
     2591     B-viewProcInfo
     2592     B-WaitFramStop at row 4 col 30
     2593     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     2594     .
     2595   define new global shared variable mBatchMode as logical no-undo init ?.
     2596   define variable mFramBachModHandle as handle no-undo.
     2597   mFramBachModHandle = frame waitfram:handle.
     2598   define variable mFameOldVis as logical no-undo.
     2599   define variable mVisCUrentVin as logical no-undo.
     2600   if session:batch-mode
     2601   then
     2602      mBatchMode = yes.
     2603   if mBatchMode = ? then do:
     2604     mVisCUrentVin = current-window:visible.
     2605     mFameOldVis = mFramBachModHandle:visible.
     2606     mFramBachModHandle:visible  = yes.
     2607     mBatchMode = mFramBachModHandle:visible ne yes.
     2608     mFramBachModHandle:visible = mFameOldVis.
     2609     current-window:visible = mVisCUrentVin.
     2610   end.
     2611    if  log-manager:logfile-name ne ?
     2612     then DO:
     2613         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     2614         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     2615         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     2616     end.
     2617   on choose of B-WaitFramStop in frame waitfram
     2618   do:
     2619     mWaitFramStop = yes.
     2620     mWaitFramStopUser = yes.
     2621   end.
     2622   function waitfram-check-timeout returns logical():
     2623      define variable vtime as int64 no-undo.
     2624      if mWaitFramStopTimeOut
     2625      then
     2626         return yes.
     2627      vtime = ( now - mWaitFramStartProc ) / 1000 .
     2628      if     mWaitFramTimeOut ne ?
     2629         and mWaitFramTimeOut ne 0
     2630         and mWaitFramTimeOut lt vtime
     2631      then do:
     2632         mWaitFramStopTimeOut = yes.
     2633      end.
     2634      return mWaitFramStopTimeOut.
     2635   end.
     2636   procedure waitfram-hide :
     2637     if not session:batch-mode
     2638     then do
     2639     on error undo, return error return-value
     2640     :
     2641       pause 0 before-hide .
     2642       if not mBatchMode then
     2643         hide frame waitfram .
     2644     if     not mWaitFramView
     2645        and mWaitProcEvent
     2646     then
     2647       process events .
     2648     end.
     2649   end procedure.
     2650   procedure waitfram-show :
     2651     define input  parameter p-message as character no-undo .
     2652     define variable v-left-margin as integer   no-undo .
     2653     if not session:batch-mode
     2654     then do
     2655     on error undo, return error return-value
     2656     :
     2657       if length(p-message) <= 70 then do:
     2658         assign
     2659           v-left-margin = integer((70 - length(p-message)) / 2)
     2660         .
     2661         assign
     2662           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     2663         .
     2664         assign
     2665           v-waitfram-action01 = " "
     2666           v-waitfram-action02 = " "
     2667                                    + fill(" ", v-left-margin)
     2668                                    + p-message
     2669           v-waitfram-action03 = " "
     2670         .
     2671       end.
     2672       else do:
     2673         define variable vRindex1 as integer no-undo.
     2674         define variable vRindex2 as integer no-undo.
     2675         vRindex1 = r-index(p-message," ",70).
     2676         if vRindex1 = 0
     2677         then
     2678            vRindex1 = 70.
     2679         if length(p-message)  <= vRindex1 + 70 then do:
     2680           assign
     2681             v-waitfram-action01 = " "
     2682             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     2683             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     2684           .
     2685         end.
     2686         else do:
     2687           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     2688           if vRindex2 <= vRindex1
     2689           then
     2690              vRindex2 = vRindex1 + 70.
     2691           assign
     2692             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     2693             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     2694             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     2695           .
     2696         end.
     2697       end.
     2698       B-viewProcInfo:visible   in frame waitfram = no.
     2699       B-viewProcInfo:sensitive in frame waitfram = no.
     2700       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2701       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     2702       if  (   mWaitFramView
     2703          or  mWaitProcEvent)
     2704          and not mBatchMode
     2705       then
     2706          display
     2707             v-waitfram-action01 skip
     2708             v-waitfram-action02 skip
     2709             v-waitfram-action03 skip
     2710          with frame waitfram .
     2711       if     mWaitFramView
     2712          then do:
     2713             if     mWaitFramInterval ne ?
     2714                and not mBatchMode
     2715             then
     2716                wait-for go of frame waitfram pause mWaitFramInterval.
     2717          end.
     2718          else
     2719             if     mWaitProcEvent
     2720                and not mBatchMode
     2721             then
     2722                process events .
     2723     end.
     2724   end procedure.
     2725      procedure waitfram-show-this:
     2726         define input  parameter iInterval as int64 no-undo.
     2727         define variable vtime as int64 no-undo.
     2728         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     2729         mWaitFramInterval = iInterval.
     2730         run waitfram-show (substitute("&1&2 &3&4" ,
     2731                                       mWaitFramTextBeg ,
     2732                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     2733                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     2734                                       mWaitFramTextEnd
     2735                                      )
     2736                           ).
     2737      end.
     2738      procedure WaitFramRunPause:
     2739         define input  parameter iInterval as dec no-undo.
     2740         define variable vStart  as datetime-tz no-undo.
     2741         define variable vend    as datetime-tz no-undo.
     2742         define variable vint as int64 no-undo.
     2743         define variable vOk as logical no-undo.
     2744         vStart = now.
     2745         vend   = vStart.
     2746         publish "WaitFramPause" (iInterval,output vOk).
     2747         vend   =  now.
     2748         vint = vend - vStart.
     2749         vint = iInterval - vint / 1000.
     2750         if     not mWaitFramStop
     2751            and (   vint > 0
     2752                 or (    not vOk
     2753                     and iInterval eq ?
     2754                     )
     2755                 )
     2756         then
     2757            run waitfram-show-this (iInterval).
     2758         vend   =  now.
     2759         vint = vend - vStart.
     2760         vint = iInterval - vint / 1000.
     2761         if     not mWaitFramStop
     2762            and vint > 0
     2763         then do:
     2764            run gbl/pause.p (vint * 1000).
     2765         end.
     2766         if iInterval ne ?
     2767         then
     2768            publish "WaitFramStop".
     2769         waitfram-check-timeout().
     2770      end.
     2771      procedure WaitFramWaitFor:
     2772         define input  parameter iInterval as dec no-undo.
     2773         assign
     2774            mWaitFramStartProc   = now
     2775            mWaitFramStopUser    = no
     2776            mWaitFramStopTimeOut = no
     2777         .
     2778         block-wait:
     2779         do while not mWaitFramStop:
     2780            run WaitFramRunPause (iInterval).
     2781            if  waitfram-check-timeout()
     2782            then do:
     2783               leave block-wait.
     2784            end.
     2785         end.
     2786         run waitfram-hide.
     2787      end.
     2788   procedure waitfram-join :
     2789     define input  parameter p-line-1  as character no-undo .
     2790     define input  parameter p-line-2  as character no-undo .
     2791     define input  parameter p-line-3  as character no-undo .
     2792     define output parameter p-message as character no-undo .
     2793     do
     2794     on error undo, return error return-value
     2795     :
     2796       assign
     2797         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     2798                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     2799                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     2800       .
     2801     end.
     2802   end procedure.
     2803   function waitfram-join-function returns character
     2804     (input p-line-1 as character
     2805     ,input p-line-2 as character
     2806     ,input p-line-3 as character
     2807     ).
     2808     define variable v-message as character no-undo .
     2809     run waitfram-join in this-procedure
     2810       (input  p-line-1
     2811       ,input  p-line-2
     2812       ,input  p-line-3
     2813       ,output v-message
     2814       ) .
     2815     return v-message .
     2816   end function .
     2817   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2818   FUNCTION prep-nameorcode RETURNS CHARACTER
     2819     ( input p-nameorcode as character ) :
     2820   define variable v-nameorcode as character no-undo .
     2821   define variable v-dopi as character no-undo .
     2822   if trim(p-nameorcode) = '' then  return ''.
     2823   v-nameorcode = trim( trim( p-NameOrCode) , "*" ) .
     2824   if index(v-NameOrCode, chr(34) ,1 ) = 1
     2825   and R-index(v-NameOrCode, chr(34) ,1 ) = 1 then do:
     2826     assign
     2827     v-NameOrCode = trim(v-NameOrCode, chr(34))
     2828     .
     2829   end.
     2830   assign
     2831   v-dopi = substring(v-NameOrCode, length(v-NameOrCode), 1)
     2832   .
     2833   if index("abcdefghijklmnopqrstuvwxyzабвгдеёжзийклмнопрстуфхцчшщъыьэюя", v-dopi) > 0
     2834   or index("1234567890", v-dopi) > 0
     2835   then do:
     2836     v-NameOrCode = v-NameOrCOde + "*".
     2837   end.
     2838   v-NameOrCode = LC(v-NameOrCode).
     2839   RETURN v-nameorcode.
     2840   END FUNCTION.
     2841   def var vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2842   procedure gen-key-rec :
     2843     define input  parameter p-tbl-name    as character no-undo.
     2844     define input  parameter p-bh_tbl-name as handle    no-undo.
     2845     define output parameter p-key-rec     as character no-undo.
     2846     do
     2847     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2848     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     2849     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     2850     :
     2851       define variable fh               as handle    no-undo .
     2852       define variable v-ok             as logical   no-undo .
     2853       define variable v-inform         as character no-undo .
     2854       define variable v-ind            as integer   no-undo .
     2855       define variable v-idx-field-qnty as integer   no-undo .
     2856       if p-tbl-name = ?
     2857         or p-tbl-name = "":U
     2858       then do:
     2859         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info19 ).
     2860       end.
     2861       if not p-bh_tbl-name:available then do:
     2862         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info19, p-tbl-name ).
     2863       end.
     2864       assign
     2865         p-key-rec = p-tbl-name
     2866         v-inform  = p-bh_tbl-name:index-information(1)
     2867         v-ind     = 2
     2868       .
     2869       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2870       on error undo, return error
     2871       :
     2872         assign
     2873           v-inform = p-bh_tbl-name:index-information( v-ind )
     2874           v-ind    = v-ind + 1
     2875         .
     2876       end.
     2877       if v-inform = ?
     2878         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2879         or entry( 3, v-inform, ",":U ) <> "1":U
     2880       then do:
     2881         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info19, p-tbl-name ).
     2882       end.
     2883       else do:
     2884         assign
     2885           v-idx-field-qnty = num-entries( v-inform ) - 4
     2886         .
     2887         if v-idx-field-qnty < 2 then do:
     2888           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info19, v-inform, p-tbl-name ).
     2889         end.
     2890         do v-ind = 1 to v-idx-field-qnty by 2
     2891         on error undo, return error
     2892         :
     2893           assign
     2894             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     2895             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     2896           .
     2897         end.
     2898       end.
     2899       if p-key-rec = ? then do:
     2900         assign
     2901           p-key-rec = "":U
     2902         .
     2903         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info19, p-tbl-name ).
     2904       end.
     2905     end.
     2906     return.
     2907   end procedure.
     2908   procedure gen-where-keyr-tab :
     2909     define input  parameter i-tableSerach as character no-undo.
     2910     define input  parameter i-tablekey   as character  no-undo.
     2911     define input  parameter p-key-rec    as character  no-undo.
     2912     define input  parameter p-key-handle as handle     no-undo .
     2913     define input  parameter p-db-name    as character  no-undo .
     2914     define input  parameter p-tt-handle  as handle     no-undo .
     2915     define output parameter o-Where      as character  no-undo.
     2916     do
     2917     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2918     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     2919     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     2920     :
     2921       define variable v-full-tbl-name  as character no-undo .
     2922       define variable bh_tbl-name      as handle    no-undo .
     2923       define variable fh_key           as handle    no-undo .
     2924       define variable fh_search        as handle    no-undo .
     2925       define variable v-field-num      as integer   no-undo .
     2926       define variable v-count-fld      as integer   no-undo .
     2927       define variable v-inform         as character no-undo .
     2928       define variable v-ind            as integer   no-undo .
     2929       define variable v-idx-field-qnty as integer   no-undo .
     2930       define variable v-field-name     as character no-undo .
     2931       define variable v-field-val      as character no-undo .
     2932       define variable v-word-link      as character no-undo .
     2933       define variable vTable           as character no-undo.
     2934       define variable bh_tbl-key       as handle    no-undo .
     2935       assign
     2936         p-key-rec = trim( p-key-rec )
     2937       .
     2938       if p-key-handle <> ? then do:
     2939         if not valid-handle(p-key-handle)
     2940            or p-key-handle:type <> "buffer"
     2941         then do:
     2942           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info19 ).
     2943         end.
     2944         if num-entries( p-key-rec, chr(3) ) > 1
     2945           or p-key-rec = ?
     2946           or p-key-rec = "":U
     2947         then do:
     2948           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info19, p-key-rec ).
     2949         end.
     2950       end.
     2951       else do:
     2952         if p-key-rec = ?
     2953           or p-key-rec = "":U
     2954         then do:
     2955           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info19 ).
     2956         end.
     2957       end.
     2958       assign
     2959         vTable = entry( 1 , p-key-rec, chr(3) )
     2960       .
     2961       if p-tt-handle <> ?
     2962         and ( not valid-handle(p-tt-handle)
     2963               or p-tt-handle:type <> "buffer"
     2964             )
     2965       then do:
     2966         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info19, vTable, chr(10) ).
     2967       end.
     2968       if p-tt-handle = ? then do:
     2969         assign
     2970           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     2971         .
     2972         create buffer bh_tbl-name for table v-full-tbl-name .
     2973       end.
     2974       else do:
     2975         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     2976       end.
     2977       assign
     2978         v-inform = bh_tbl-name:index-information(1)
     2979         v-ind    = 2
     2980       .
     2981       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2982       on error undo, return error
     2983       :
     2984         assign
     2985           v-inform = bh_tbl-name:index-information( v-ind )
     2986           v-ind    = v-ind + 1
     2987         .
     2988       end.
     2989       if v-inform = ?
     2990         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2991         or entry( 3, v-inform, ",":U ) <> "1":U
     2992       then do:
     2993         delete object bh_tbl-name no-error.
     2994         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info19, vTable ).
     2995       end.
     2996       assign
     2997         v-idx-field-qnty = num-entries( v-inform ) - 4
     2998       .
     2999       if v-idx-field-qnty < 2 then do:
     3000         delete object bh_tbl-name no-error.
     3001         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info19, v-inform, vTable ).
     3002       end.
     3003       assign
     3004         o-where     = "where":U
     3005         v-word-link = "":U
     3006         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     3007         v-count-fld = 0
     3008       .
     3009       if i-tablekey ne "" and i-tablekey ne ?
     3010       then do:
     3011         assign
     3012           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     3013         .
     3014         create buffer bh_tbl-key for table v-full-tbl-name .
     3015       end.
     3016       if i-tableSerach ne "" and i-tableSerach ne ?
     3017       then do:
     3018         delete object bh_tbl-name no-error.
     3019         assign
     3020           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     3021         .
     3022         create buffer bh_tbl-name for table v-full-tbl-name .
     3023       end.
     3024       block_where:
     3025       do v-ind = 1 to v-idx-field-qnty by 2
     3026       on error undo, return error
     3027       :
     3028         assign
     3029           v-count-fld = v-count-fld + 1
     3030         .
     3031         if p-key-handle = ?
     3032           and v-count-fld > v-field-num
     3033         then do:
     3034           leave block_where.
     3035         end.
     3036         define variable VfieldKeyTable as handle no-undo.
     3037         assign
     3038           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     3039           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     3040         .
     3041         if     bh_tbl-key ne ?
     3042         then do:
     3043            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     3044            if VfieldKeyTable eq ?
     3045            then next block_where.
     3046         end.
     3047         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     3048         then
     3049            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     3050         else
     3051            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     3052         if p-key-handle = ? then do:
     3053           assign
     3054             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     3055           .
     3056         end.
     3057         else do:
     3058           assign
     3059             fh_key = p-key-handle:buffer-field( v-field-name )
     3060           .
     3061           if fh_key = ?
     3062             or not valid-handle( fh_key )
     3063           then do:
     3064             delete object bh_tbl-name.
     3065             if     bh_tbl-key ne ?
     3066             then
     3067                delete object bh_tbl-key.
     3068             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info19, p-key-handle:name, v-field-name ).
     3069           end.
     3070           assign
     3071             v-field-val = fh_key:buffer-value
     3072           .
     3073         end.
     3074         if fh_search:data-type ="character":U then do:
     3075           assign
     3076             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     3077             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     3078             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     3079             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     3080             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     3081             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     3082             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     3083             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     3084             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     3085             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     3086             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     3087             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     3088             v-field-val = substitute( '"&1"', v-field-val )
     3089           .
     3090         end.
     3091         assign
     3092           o-where = substitute( "&1 &2", o-where, v-field-val )
     3093         .
     3094         if v-word-link = "":U then do:
     3095           assign
     3096             v-word-link = "and":U
     3097           .
     3098         end.
     3099       end.
     3100       delete object bh_tbl-name.
     3101       if     bh_tbl-key ne ?
     3102       then
     3103          delete object bh_tbl-key.
     3104       if p-key-handle = ?
     3105         and v-count-fld <> v-field-num
     3106       then do:
     3107         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info19, vTable ).
     3108       end.
     3109     end.
     3110   end procedure.
     3111   procedure gen-hn-keyr-tab :
     3112     define input  parameter i-tableSerach as character no-undo.
     3113     define input  parameter i-tablekey   as character no-undo.
     3114     define input  parameter p-key-rec    as character no-undo.
     3115     define input  parameter p-key-handle as handle    no-undo .
     3116     define input  parameter p-db-name    as character no-undo .
     3117     define input  parameter p-tt-handle  as handle    no-undo .
     3118     define input  parameter p-stts-lock  as integer   no-undo .
     3119     define output parameter o-hn         as handle    no-undo.
     3120     define variable v-full-tbl-name as character no-undo.
     3121     define variable v-where         as character no-undo.
     3122     define variable bh_tbl-name     as handle    no-undo.
     3123     define variable vTable          as character no-undo.
     3124     do
     3125     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3126     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     3127     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     3128         run gen-where-keyr-tab(i-tableSerach,
     3129                                i-tablekey,
     3130                                p-key-rec,
     3131                                p-key-handle,
     3132                                p-db-name,
     3133                                p-tt-handle,
     3134                                output v-where).
     3135         if i-tableSerach ne "" and i-tableSerach ne ?
     3136         then do:
     3137            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     3138            create buffer bh_tbl-name for table v-full-tbl-name .
     3139         end.
     3140         else do:
     3141            if p-tt-handle = ? then do:
     3142               assign
     3143                  vTable = entry( 1 , p-key-rec, chr(3) )
     3144               .
     3145               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     3146               create buffer bh_tbl-name for table v-full-tbl-name .
     3147            end.
     3148            else do:
     3149               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     3150            end.
     3151         end.
     3152         if p-tt-handle = ? then do:
     3153            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     3154         end.
     3155         else do:
     3156            bh_tbl-name:find-first( v-where ) no-error .
     3157         end.
     3158         o-hn = bh_tbl-name.
     3159      end.
     3160   end procedure.
     3161   procedure gen-hn-keyr :
     3162     define input  parameter p-key-rec    as character no-undo.
     3163     define input  parameter p-key-handle as handle    no-undo .
     3164     define input  parameter p-db-name    as character no-undo .
     3165     define input  parameter p-tt-handle  as handle    no-undo .
     3166     define input  parameter p-stts-lock  as integer   no-undo .
     3167     define output parameter o-hn         as handle    no-undo.
     3168     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     3169   end.
     3170   procedure gen-row-keyr :
     3171     define input  parameter p-key-rec    as character no-undo.
     3172     define input  parameter p-key-handle as handle    no-undo .
     3173     define input  parameter p-db-name    as character no-undo .
     3174     define input  parameter p-tt-handle  as handle    no-undo .
     3175     define input  parameter p-stts-lock  as integer   no-undo .
     3176     define output parameter p-tbl-row    as rowid     no-undo.
     3177     define output parameter p-tbl-name   as character no-undo.
     3178     define variable vHn as handle no-undo.
     3179       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     3180       p-tbl-row = if vHn:available then vHn:rowid else ?.
     3181       p-tbl-name =  vHn:table.
     3182       delete object vHn no-error.
     3183     if p-tbl-row = ? then do:
     3184       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info19, p-tbl-name, p-key-rec ).
     3185     end.
     3186     else do:
     3187       return.
     3188     end.
     3189   end procedure.
     3190   procedure gen-key-fv :
     3191     define input  parameter p-key-rec    as character no-undo .
     3192     define output parameter p-field-list as character no-undo .
     3193     define output parameter p-value-list as character no-undo.
     3194     do
     3195     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3196     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     3197     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     3198     :
     3199       define variable v-full-tbl-name  as character no-undo .
     3200       define variable bh_tbl-name      as handle    no-undo .
     3201       define variable v-tbl-name       as character no-undo .
     3202       define variable v-field-num      as integer   no-undo .
     3203       define variable v-count-fld      as integer   no-undo .
     3204       define variable v-inform         as character no-undo .
     3205       define variable v-ind            as integer   no-undo .
     3206       define variable v-idx-field-qnty as integer   no-undo .
     3207       define variable v-delim-key      as character no-undo .
     3208       if p-key-rec = ?
     3209         or p-key-rec = "":U
     3210       then do:
     3211         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info19 ).
     3212       end.
     3213       assign
     3214         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     3215         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     3216       .
     3217       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     3218       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info19 ).
     3219       assign
     3220         v-inform = bh_tbl-name:index-information(1)
     3221         v-ind    = 2
     3222       .
     3223       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3224       on error undo, return error
     3225       :
     3226         assign
     3227           v-inform = bh_tbl-name:index-information( v-ind )
     3228           v-ind    = v-ind + 1
     3229         .
     3230       end.
     3231       if v-inform = ?
     3232         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3233         or entry( 3, v-inform, ",":U ) <> "1":U
     3234       then do:
     3235         delete object bh_tbl-name no-error.
     3236         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info19, v-tbl-name ).
     3237       end.
     3238       assign
     3239         v-idx-field-qnty = num-entries( v-inform ) - 4
     3240       .
     3241       if v-idx-field-qnty < 2 then do:
     3242         delete object bh_tbl-name no-error.
     3243         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info19, v-inform, v-tbl-name ).
     3244       end.
     3245       assign
     3246         p-field-list = "":U
     3247         p-value-list = "":U
     3248         v-delim-key  = "":U
     3249         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     3250         v-count-fld  = 0
     3251       .
     3252       block_where:
     3253       do v-ind = 1 to v-idx-field-qnty by 2
     3254       on error undo, return error
     3255       :
     3256         assign
     3257           v-count-fld = v-count-fld + 1
     3258         .
     3259         if v-count-fld > v-field-num then do:
     3260           leave block_where.
     3261         end.
     3262         assign
     3263           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     3264           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     3265         .
     3266         if v-ind = 1 then do:
     3267           assign
     3268             v-delim-key = chr(3)
     3269           .
     3270         end.
     3271       end.
     3272       delete object bh_tbl-name.
     3273       if v-count-fld <> v-field-num then do:
     3274         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info19, v-tbl-name ).
     3275       end.
     3276     end.
     3277   end procedure.
     3278   procedure gen-key-field :
     3279     define input  parameter p-table      as character no-undo .
     3280     define output parameter p-field-list as character no-undo .
     3281     do
     3282     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3283     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     3284     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     3285     :
     3286       define variable v-full-tbl-name  as character no-undo .
     3287       define variable bh_tbl-name      as handle    no-undo .
     3288       define variable v-tbl-name       as character no-undo .
     3289       define variable v-field-num      as integer   no-undo .
     3290       define variable v-count-fld      as integer   no-undo .
     3291       define variable v-inform         as character no-undo .
     3292       define variable v-ind            as integer   no-undo .
     3293       define variable v-idx-field-qnty as integer   no-undo .
     3294       define variable v-delim-key      as character no-undo .
     3295       if p-table = ?
     3296         or p-table = "":U
     3297       then do:
     3298         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info19 ).
     3299       end.
     3300       assign
     3301         v-tbl-name      = p-table
     3302         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     3303       .
     3304       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     3305       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info19 ).
     3306       assign
     3307         v-inform = bh_tbl-name:index-information(1)
     3308         v-ind    = 2
     3309       .
     3310       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3311       on error undo, return error
     3312       :
     3313         assign
     3314           v-inform = bh_tbl-name:index-information( v-ind )
     3315           v-ind    = v-ind + 1
     3316         .
     3317       end.
     3318       if v-inform = ?
     3319         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3320         or entry( 3, v-inform, ",":U ) <> "1":U
     3321       then do:
     3322         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info19, v-tbl-name ).
     3323       end.
     3324       assign
     3325         v-idx-field-qnty = num-entries( v-inform ) - 4
     3326       .
     3327       if v-idx-field-qnty < 2 then do:
     3328         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info19, v-inform, v-tbl-name ).
     3329       end.
     3330       assign
     3331         p-field-list = "":U
     3332         v-delim-key  = "":U
     3333         v-count-fld  = 0
     3334       .
     3335       block_where:
     3336       do v-ind = 1 to v-idx-field-qnty by 2
     3337       on error undo, return error
     3338       :
     3339         assign
     3340           v-count-fld = v-count-fld + 1
     3341         .
     3342         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     3343         if v-ind = 1 then do:
     3344           assign
     3345             v-delim-key = chr(3)
     3346           .
     3347         end.
     3348       end.
     3349       delete object bh_tbl-name.
     3350     end.
     3351   end procedure.
     3352   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3353   PROCEDURE verify-ini-entry:
     3354   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
     3355   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
     3356   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
     3357   DEFINE INPUT  PARAMETER silence          as logical no-undo.
     3358   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
     3359   define variable v-mess as character no-undo .
     3360   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
     3361   if ini-entry-value = ? and ini-key-name begins "spl"
     3362   then
     3363   get-key-value section ini-section-name key "splall" value ini-entry-value.
     3364   if ini-entry-value = ? and ini-key-name begins "sav"
     3365   then
     3366   get-key-value section ini-section-name key "savall" value ini-entry-value.
     3367   if ini-entry-value = ? then do:
     3368     assign
     3369     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
     3370                       , chr(10)
     3371                       , ini-section-name
     3372                       , ini-key-name
     3373                       , error-msg-text).
     3374       if not silence then do:
     3375         message
     3376         v-mess
     3377         view-as alert-box ERROR  .
     3378         return error.
     3379       end.
     3380       else do:
     3381         return error v-mess.
     3382       end.
     3383   end.
     3384   END PROCEDURE.
     3385   PROCEDURE verify-file:
     3386   DEFINE INPUT  PARAMETER filename       as character no-undo.
     3387   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
     3388   DEFINE INPUT  PARAMETER silence        as logical no-undo.
     3389   DEFINE OUTPUT PARAMETER found          as logical no-undo.
     3390   file-info:file-name = filename.
     3391   found = NOT (file-info:full-pathname = ?).
     3392   if NOT found  then do:
     3393     if not silence then do:
     3394       message error-msg-text
     3395       view-as alert-box ERROR.
     3396       return error.
     3397     end.
     3398     else return error error-msg-text.
     3399   end.
     3400   END PROCEDURE.
     3401   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3402   FUNCTION check-ban-sales-via-cd return logical ( input p-gds-code as integer ) :
     3403       define variable v-upper-code as int no-undo.
     3404       define variable v-value as character no-undo.
     3405       define variable v-type as character no-undo.
     3406       define buffer lc_gds-grp for ub.gds-grp.
     3407       define buffer lc_goods for ub.goods.
     3408      if p-gds-code <> 0 then do:
     3409       find first lc_goods where lc_goods.gds-code = p-gds-code.
     3410       v-upper-code = lc_goods.grp-code.
     3411       do while v-upper-code > 0 :
     3412           find first lc_gds-grp where lc_gds-grp.node-code = v-upper-code.
     3413           run ggoattr-value(
     3414             input lc_gds-grp.node-code,
     3415             input 0,
     3416             input "",
     3417             input 0,
     3418             input 'ban-sales-via-cd':U,
     3419             output v-value,
     3420             output v-type
     3421           ).
     3422          if v-value = "yes" then
     3423             return true.
     3424          else
     3425          do:
     3426             run ggoattr-value(
     3427                input lc_gds-grp.node-code,
     3428                input v-cntxt-host-code-obj,
     3429                input "",
     3430                input 0,
     3431                input 'ban-sales-via-cd':U,
     3432                output v-value,
     3433                output v-type
     3434                ).
     3435             if v-value = "yes" then
     3436                return true.
     3437             else
     3438             do:
     3439                run ggoattr-value(
     3440                   input lc_gds-grp.node-code,
     3441                   input v-cntxt-host-code-obj,
     3442                   input v-cntxt-obj-type,
     3443                   input v-cntxt-obj-code,
     3444                   input 'ban-sales-via-cd':U,
     3445                   output v-value,
     3446                   output v-type
     3447                   ).
     3448                if v-value = "yes" then
     3449                   return true.
     3450                else v-upper-code = lc_gds-grp.upper-code.
     3451             end .
     3452          end.
     3453         end.
     3454       end.
     3455       if v-value = "" or logical(v-value) = false then return false .
     3456   end.
     3457   FUNCTION check-ban-sales-via-cd-grp return logical ( input p-grp-code as integer ) :
     3458       define variable v-upper-code as int no-undo.
     3459       define variable v-value as character no-undo.
     3460       define variable v-type as character no-undo.
     3461       define buffer lc_gds-grp for ub.gds-grp.
     3462       define buffer lc_goods for ub.goods.
     3463       v-upper-code = p-grp-code.
     3464       do while v-upper-code > 0 :
     3465           find first lc_gds-grp where lc_gds-grp.node-code = v-upper-code.
     3466           run ggoattr-value(
     3467             input lc_gds-grp.node-code,
     3468             input 0,
     3469             input "",
     3470             input 0,
     3471             input 'ban-sales-via-cd':U,
     3472             output v-value,
     3473             output v-type
     3474           ).
     3475          if v-value = "yes" then
     3476             return true.
     3477          else
     3478          do:
     3479             run ggoattr-value(
     3480                input lc_gds-grp.node-code,
     3481                input v-cntxt-host-code-obj,
     3482                input "",
     3483                input 0,
     3484                input 'ban-sales-via-cd':U,
     3485                output v-value,
     3486                output v-type
     3487                ).
     3488             if v-value = "yes" then
     3489                return true.
     3490             else
     3491             do:
     3492                run ggoattr-value(
     3493                   input lc_gds-grp.node-code,
     3494                   input v-cntxt-host-code-obj,
     3495                   input v-cntxt-obj-type,
     3496                   input v-cntxt-obj-code,
     3497                   input 'ban-sales-via-cd':U,
     3498                   output v-value,
     3499                   output v-type
     3500                   ).
     3501                if v-value = "yes" then
     3502                   return true.
     3503                else v-upper-code = lc_gds-grp.upper-code.
     3504             end .
     3505          end.
     3506         end.
     3507   end.
