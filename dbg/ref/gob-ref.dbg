     4372   PROCEDURE proc-mouse-dbl-click-loc-code:
     4373   def var str-code as integer no-undo.
     4374   define variable varresult   as character         no-undo.
     4375   define variable vartype-bc  as character         no-undo.
     4376   define variable varweight   as decimal           no-undo.
     4377   define buffer l-goods for ub.goods.
     4378   define buffer l-bar-code for ub.bar-code.
     4379   define buffer buf_bar-code for ub.bar-code .
     4380   define buffer buf_prod-bc for ub.prod-bc.
     4381   define buffer buf_place for ub.place.
     4382     assign
     4383     frame d-gob-doc-ref
     4384     loc-code
     4385     a-n-c.
     4386     if a-n-c = "datamatrix"
     4387     then do:
     4388   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_dm-rcnz in g#libbcrcn
     4389   (
     4390    input  parparentproc
     4391   ,input  loc-code
     4392   ,input  ?
     4393   ,input  p-obj-type
     4394   ,input  p-obj-code
     4395   ,input  yes
     4396   ,input  no
     4397   ,input  varscales-pref25
     4398   ,input  varpgscales-pref25
     4399   ,output varresult
     4400   ,output vartype-bc
     4401   ,output varweight
     4402   ,buffer buf_bar-code
     4403   ,buffer buf_prod-bc
     4404   ,buffer buf_place
     4405   ) no-error.
     4406        if varresult eq "prod-bc"
     4407        then
     4408           loc-code:screen-value in frame d-gob-doc-ref = buf_prod-bc.b-str.
     4409     end.
     4410     else do:
     4411   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     4412   (
     4413    input  parparentproc
     4414   ,input  loc-code
     4415   ,input  ?
     4416   ,input  p-obj-type
     4417   ,input  p-obj-code
     4418   ,input  yes
     4419   ,input  no
     4420   ,input  varscales-pref25
     4421   ,input  varpgscales-pref25
     4422   ,output varresult
     4423   ,output vartype-bc
     4424   ,output varweight
     4425   ,buffer buf_bar-code
     4426   ,buffer buf_prod-bc
     4427   ,buffer buf_place
     4428   ) no-error.
     4429     end.
     4430     if available buf_bar-code then do:
     4431       find first l-gob-doc where
     4432                  l-gob-doc.gds-code = buf_bar-code.gds-code AND
     4433                  l-gob-doc.obj-type = p-obj-type AND
     4434                  l-gob-doc.obj-code = p-obj-code no-lock no-error.
     4435       if not available l-gob-doc then
     4436       find first l-gob-doc where
     4437                   buf_bar-code.gds-code = l-gob-doc.gds-code
     4438                  no-lock no-error.
     4439       if available l-gob-doc then do:
     4440         line-rec = recid (l-gob-doc).
     4441         reposition br-gds to recid line-rec no-error.
     4442         if error-status:error then do:     run ref/gdsrepos.p (input 1,                    input g-cond,                    input g-list,                    input g-stat,                    input flt-rec,                    output g#log,                    output contin).     if g#log then do:       run full-sch.       return error.     end.   end.   apply "VALUE-changed" to br-gds in frame d-gob-doc-ref.
     4443         if b-mark:sensitive then apply "choose" to b-mark in frame d-gob-doc-ref.
     4444       end.
     4445       else do:
     4446         message "Строка не найдена."
     4447                 view-as alert-box error.
     4448       end.
     4449     end.
     4450     else
     4451       message "Бар-код не найден."
     4452               view-as alert-box error.
     4453     apply "entry" to loc-code in frame d-gob-doc-ref.
     4454   END PROCEDURE.
