     4301   PROCEDURE proc-backspace-br-gds:
     4302     if input frame d-gob-doc-ref a-n-c = "art" then do:
     4303       if loc-art = "" then
     4304         return error.
     4305       loc-art = substr (loc-art, 1, length (loc-art) - 1).
     4306   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4307     case g-list :
     4308       when 'все':U then do:
