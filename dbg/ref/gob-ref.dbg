        1   define variable vss-revision    as character no-undo initial "$Revision$":U .
        2   define variable vss-author      as character no-undo initial "$Author$":U .
        3   define variable vss-date        as character no-undo initial "$Date$":U .
        4   define variable vss-workfile    as character no-undo initial "$Workfile$":U .
        5   define variable vss-archive     as character no-undo initial "$Archive$":U .
        6   define variable vss-description as character no-undo initial "Справочник товаров - режим товары на объекте".
        7   DEFINE INPUT        PARAMETER parParentProc   AS   WIDGET-HANDLE       NO-UNDO.
        8   DEFINE INPUT        PARAMETER bttns           AS   CHARACTER           NO-UNDO.
        9   DEFINE INPUT-OUTPUT PARAMETER g-stat          AS   CHARACTER           NO-UNDO.
       10   DEFINE INPUT-OUTPUT PARAMETER g-list          AS   CHARACTER           NO-UNDO.
       11   DEFINE INPUT-OUTPUT PARAMETER g-cond          AS   CHARACTER           NO-UNDO.
       12   DEFINE INPUT-OUTPUT PARAMETER g-rep           AS   RECID               NO-UNDO.
       13   DEFINE INPUT-OUTPUT PARAMETER g-grp           LIKE ub.goods.grp-name   NO-UNDO.
       14   DEFINE INPUT-OUTPUT PARAMETER p-producer-type LIKE ub.clients.obj-type NO-UNDO.
       15   DEFINE INPUT-OUTPUT PARAMETER p-producer-code LIKE ub.clients.obj-code NO-UNDO.
       16   DEFINE INPUT-OUTPUT PARAMETER p-obj-type      LIKE ub.clients.obj-type NO-UNDO.
       17   DEFINE INPUT-OUTPUT PARAMETER p-obj-code      LIKE ub.clients.obj-code NO-UNDO.
       18   DEFINE INPUT-OUTPUT PARAMETER p-gds-name-width as decimal              NO-UNDO.
       19   DEFINE INPUT-OUTPUT PARAMETER p-grp-name-width as decimal              NO-UNDO.
       20   define input-output parameter p-other as character no-undo .
       21   define input-output parameter rid-list as character no-undo.
       22   procedure vss-get-info :
       23     define output parameter p-vss-revision    like vss-revision    no-undo .
       24     define output parameter p-vss-author      like vss-author      no-undo .
       25     define output parameter p-vss-date        like vss-date        no-undo .
       26     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       27     define output parameter p-vss-archive     like vss-archive     no-undo .
       28     define output parameter p-vss-description like vss-description no-undo .
       29     assign
       30       p-vss-revision    = vss-revision
       31       p-vss-author      = vss-author
       32       p-vss-date        = vss-date
       33       p-vss-workfile    = vss-workfile
       34       p-vss-archive     = vss-archive
       35       p-vss-description = vss-description
       36     .
       37   end procedure.
       38   procedure vss-get-parameters :
       39     define output parameter p-vss-parameters as character no-undo .
       40       assign
       41         p-vss-parameters = substitute('&1|&2':u,substitute('&1|&2|&3|&4|&5|&6':u,parParentProc,bttns,g-stat,g-list,g-cond,g-rep),substitute('&1|&2|&3|&4|&5|&6':u,g-grp,p-producer-type,p-producer-code,p-obj-type,p-obj-code,p-other))
       42       .
       43   end procedure.
       44   define new global shared variable g#vssrevis-logger as handle    no-undo .
       45   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       46   define variable v-vssrevis-logger                   as handle    no-undo .
       47   procedure vss-logevent :
       48     define input  parameter p-extra-paramters as character no-undo .
       49     define variable v-vssrevis-parameters as character no-undo .
       50     do
       51     on error undo, return error return-value
       52     :
       53       if  valid-handle(v-vssrevis-logger)
       54       and v-vssrevis-logger :get-signature("logevent") <> ""
       55       then do:
       56         run vss-get-parameters in this-procedure
       57           (output v-vssrevis-parameters
       58           ).
       59         run logevent in v-vssrevis-logger
       60           (input vss-workfile
       61           ,input vss-revision
       62           ,input v-vssrevis-parameters
       63           ,input p-extra-paramters
       64           ).
       65       end.
       66     end.
       67   end procedure.
       68   assign
       69     v-vssrevis-logger = g#vssrevis-logger
       70   .
       71   if  valid-handle(v-vssrevis-logger)
       72   and v-vssrevis-logger :get-signature("logevent") <> ""
       73   then do:
       74     assign
       75       v-vssrevis-logevent = true
       76     .
       77     run vss-logevent in this-procedure (input vss-description) .
       78   end.
       79   define new global shared variable g#language as character no-undo .
       80   if g#language <> '' and g#language <> 'rus':U then do:
       81     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       82   end.
       83   define new global shared variable g#library  as handle no-undo .
       84   define new global shared variable g#library2 as handle no-undo .
       85   procedure proc-alt-shift-f2:
       86     if not ibs.th.gbl.gbl-var:rcode
       87   then
       88     run gbl\inidebug.p .
       89   end.
       90   procedure proc-alt-shift-f3:
       91     run gbl/prvssinf.p
       92       ( input this-procedure
       93       ) .
       94   end.
       95   define variable v-inform-launched as logical no-undo initial false .
       96   procedure proc-alt-shift-f4:
       97     define variable v-action as character no-undo .
       98     if v-inform-launched = false then do:
       99       assign
      100         v-inform-launched = true
      101       .
      102       run gbl/d-inform.w
      103         (  input self
      104         ,  input this-procedure
      105         , output v-action
      106         ) no-error .
      107       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      108       assign
      109         v-inform-launched = false
      110       .
      111     end.
      112   end.
      113   procedure proc-alt-f1:
      114     run gbl/corrhelp.p
      115       (input this-procedure
      116       ) .
      117   end .
      118   on alt-shift-f2 anywhere do:
      119     run proc-alt-shift-f2.
      120   end.
      121   on alt-shift-f3 anywhere do:
      122     run proc-alt-shift-f3 in this-procedure .
      123   end.
      124   on alt-shift-f4 anywhere do:
      125     run proc-alt-shift-f4 in this-procedure.
      126   end.
      127   on alt-f1 anywhere do:
      128     run proc-alt-f1 in this-procedure .
      129   end.
      130   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      131     define variable v-cntxt-db-num        as integer   no-undo .
      132     define variable v-cntxt-userid        as character no-undo .
      133     define variable v-cntxt-level         as character no-undo .
      134     define variable v-cntxt-host-code-obj as integer   no-undo .
      135     define variable v-cntxt-obj-type      as character no-undo .
      136     define variable v-cntxt-obj-code      as integer   no-undo .
      137     define variable v-cntxt-db-num-obj    as integer   no-undo .
      138     define variable v-cntxt-is-admin      as logical   no-undo .
      139   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      140   define temp-table userobjs_temp-user-obj no-undo
      141     field obj-type as character
      142     field obj-code as integer
      143     index xpk is primary unique obj-type obj-code
      144     .
      145   procedure userobjs_clear :
      146     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      147     do
      148     on error undo, return error return-value
      149     :
      150       for each buf_userobjs_temp-user-obj
      151       on error undo, return error return-value
      152       :
      153         delete buf_userobjs_temp-user-obj .
      154       end.
      155     end.
      156   end .
      157   procedure userobjs_object-count :
      158     define output parameter p-total-count as integer   no-undo .
      159     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      160     do
      161     on error undo, return error return-value
      162     :
      163       assign
      164         p-total-count = 0
      165       .
      166       for each buf_userobjs_temp-user-obj
      167       on error undo, return error return-value
      168       :
      169         assign
      170           p-total-count = p-total-count + 1
      171         .
      172       end.
      173     end.
      174   end.
      175   procedure userobjs_append :
      176      define input  parameter p-obj-type as character no-undo .
      177      define input  parameter p-obj-code as integer   no-undo .
      178     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      179     do
      180     on error undo, return error return-value
      181     :
      182       find first buf_userobjs_temp-user-obj
      183         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      184           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      185         no-error .
      186       if not available buf_userobjs_temp-user-obj
      187       then do:
      188         create buf_userobjs_temp-user-obj .
      189         assign
      190           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      191           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      192         .
      193       end.
      194     end.
      195   end.
      196   procedure userobjs_object-exist :
      197     define output parameter p-object-exist as logical   no-undo .
      198     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      199     do
      200     on error undo, return error return-value
      201     :
      202       find first buf_userobjs_temp-user-obj
      203         no-error .
      204       if not available buf_userobjs_temp-user-obj
      205       then do:
      206         assign
      207           p-object-exist = false
      208         .
      209       end.
      210       else do:
      211         assign
      212           p-object-exist = true
      213         .
      214       end.
      215     end.
      216   end.
      217   procedure userobjs_transfer :
      218     define input  parameter p-callback-handle as handle no-undo .
      219     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      220     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      221     do
      222     on error undo, return error return-value
      223     :
      224       if valid-handle(p-callback-handle) <> true
      225       then do:
      226         message
      227           vss-workfile vss-revision vss-description skip
      228           "Ошибка задания входных параметров" skip
      229           "Неизвестный указатель на процедуру" skip
      230           view-as alert-box error .
      231         undo, return error return-value .
      232       end.
      233       if p-callback-handle :get-signature("userobjs_append") = ""
      234       then do:
      235         message
      236           vss-workfile vss-revision vss-description skip
      237           "Ошибка задания входных параметров" skip
      238           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      239                     ,p-callback-handle :file-name
      240                     ) skip
      241           view-as alert-box error .
      242         undo, return error return-value .
      243       end.
      244       for each buf_userobjs_temp-user-obj
      245       on error undo, return error return-value
      246       :
      247         run userobjs_append in p-callback-handle
      248           (input  buf_userobjs_temp-user-obj.obj-type
      249           ,input  buf_userobjs_temp-user-obj.obj-code
      250           ) .
      251       end.
      252     end.
      253   end procedure.
