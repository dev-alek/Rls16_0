     9254   procedure proc-b-obj :
     9255     define input parameter p-mode as character no-undo .
     9256     define variable v-host-code   as integer   no-undo .
     9257     define variable v-user-select as logical   no-undo .
     9258     define variable v-obj-type    as character no-undo .
     9259     define variable v-obj-code    as integer   no-undo .
     9260     define buffer buf_clients  for ub.clients.
     9261     do
     9262     on error undo, return error
     9263     :
     9264       if p-mode = "change":U
     9265       then do:
     9266   define variable vss-include-info104 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9267   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     9268     (input  p-obj-type
     9269     ,input  p-obj-code
     9270     ,output v-host-code
     9271     )  .
     9272   define variable vss-include-info105 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9273   run userobjs_select-one in this-procedure
     9274     (input  parparentproc
     9275     ,input  v-cntxt-db-num
     9276     ,input  v-cntxt-userid
     9277     ,input  v-cntxt-host-code-obj
     9278     ,input  v-cntxt-obj-type
     9279     ,input  v-cntxt-obj-code
     9280     ,output v-user-select
     9281     ,output v-obj-type
     9282     ,output v-obj-code
     9283     )  .
     9284         if v-user-select <> true
     9285         then do:
     9286           return .
     9287         end.
     9288       end.
     9289       else do:
     9290         assign
     9291           v-obj-type = p-obj-type
     9292           v-obj-code = p-obj-code
     9293         .
     9294       end.
     9295       find first buf_clients no-lock
     9296         where buf_clients.obj-type = v-obj-type
     9297           and buf_clients.obj-code = v-obj-code
     9298         no-error .
     9299       if not available buf_clients
     9300       then do:
     9301         undo, return error.
     9302       end.
     9303       assign
     9304         p-obj-type = buf_clients.obj-type
     9305         p-obj-code = buf_clients.obj-code
     9306         v-obj-type = buf_clients.obj-type
     9307         v-obj-code = buf_clients.obj-code
     9308         v-obj-name = buf_clients.obj-name
     9309       .
     9310       run main-block-proc in this-procedure .
     9311     end.
     9312   end procedure.
     9313   procedure get-petrol-weight-qty :
     9314     define        parameter buffer loc-goo-doc   for ub.goods.
     9315     define        parameter buffer loc-gob-doc   for ub.gds-obj.
     9316     define output parameter        p-free-q-cli as  decimal no-undo initial 0.0.
     9317     define output parameter        p-fact-q-cli as  decimal no-undo initial 0.0.
     9318     define variable is-petrol as logical no-undo.
     9319     define variable is-pieces as logical no-undo.
     9320     define buffer buf_pl-gds for ub.pl-gds .
     9321     do on error undo, return error return-value :
     9322       if available loc-goo-doc then do:
     9323         assign
     9324           p-free-q-cli = 0.0
     9325           p-fact-q-cli = 0.0
     9326         .
     9327         if v-is-ptrl = "yes" then do:
     9328   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     9329     (
     9330        input loc-goo-doc.artic
     9331     ,  input loc-goo-doc.prod-type
     9332     ,  input loc-goo-doc.prod-code
     9333     , output is-petrol
     9334     , output is-pieces
     9335     ) no-error.
     9336           if error-status :error then do:
     9337             return error return-value.
     9338           end.
     9339           if is-petrol = true
     9340             and is-pieces = false
     9341           then do:
     9342             for each buf_pl-gds no-lock
     9343               where buf_pl-gds.gds-code = loc-goo-doc.gds-code
     9344                 and buf_pl-gds.obj-type = p-obj-type
     9345                 and buf_pl-gds.obj-code = p-obj-code
     9346             on error undo, return error return-value
     9347             :
     9348               assign
     9349                 p-fact-q-cli = p-fact-q-cli + buf_pl-gds.cli-fact-qnty
     9350                 p-free-q-cli = p-free-q-cli + buf_pl-gds.cli-free-qnty
     9351               .
     9352             end.
     9353           end.
     9354         end.
     9355       end.
     9356     end.
     9357   end procedure.
     9358   procedure assort-polit :
     9359   do
     9360   on error undo, return error return-value
     9361   :
     9362   define input  parameter p-gds-code as integer   no-undo .
     9363   define input  parameter p-obj-type as character no-undo .
     9364   define input  parameter p-obj-code as integer   no-undo .
     9365   define output parameter p-indicator-life-gds like  ub.gds-obj-prop.gdop-igt                     no-undo .
     9366   define output parameter p-assort-min         like  ub.gds-obj-prop.gdop-assort-min format "*/ " no-undo .
     9367    define variable p-gdop-min-stock              as decimal   no-undo .
     9368    define variable p-grop-max-stock              as decimal   no-undo .
     9369    define variable p-grop-level-always-presence  as decimal   no-undo .
     9370    define variable p-grop-min-order              as decimal   no-undo .
     9371   if p-gds-code = 0 or p-gds-code = ? then message 444.
     9372   define variable vss-include-info106 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9373   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjpr in g#library
     9374     (input  p-obj-type
     9375     ,input  p-obj-code
     9376     ,input  ?
     9377     ,input  ?
     9378     ,input  ?
     9379     ,input  p-gds-code
     9380     ,output p-assort-min
     9381     ,output p-indicator-life-gds
     9382     ,output p-gdop-min-stock
     9383     ,output p-grop-max-stock
     9384     ,output p-grop-level-always-presence
     9385     ,output p-grop-min-order
     9386     )  .
     9387   end.
     9388   end procedure.
     9389   PROCEDURE reposition-goods :
     9390   define input  parameter p-direction   as character no-undo .
     9391   define output parameter p-recid as recid no-undo .
     9392     case p-direction :
     9393       when "first":U
     9394       then do:
     9395         get first br-gds.
     9396       end.
     9397       when "last":U
     9398       then do:
     9399         get last br-gds.
     9400       end.
     9401       when "prev":U
     9402       then do:
     9403         get prev br-gds.
     9404         if not available gob-doc then do:
     9405           message
     9406           "Это первый товар списка"
     9407           view-as alert-box.
     9408         end.
     9409       end.
     9410       when "next":U
     9411       then do:
     9412         get next br-gds.
     9413         if not available gob-doc then do:
     9414           message
     9415           "Это последний товар списка"
     9416           view-as alert-box.
     9417         end.
     9418       end.
     9419     end case .
     9420     run reposition-query in this-procedure
     9421       (input recid(gob-doc)
     9422       ).
     9423     assign
     9424     p-recid = recid(goo-doc)
     9425     .
     9426   END PROCEDURE.
     9427   PROCEDURE reposition-query :
     9428   define input parameter p-recid as recid no-undo .
     9429   if p-recid <> ?
     9430   then do:
     9431     reposition br-gds to recid p-recid no-error.
     9432   end.
     9433   do with frame d-gob-doc-ref:
     9434     apply "entry":u to browse br-gds .
     9435     apply "VALUE-CHANGED":u to browse br-gds .
     9436   end.
     9437   END PROCEDURE.
     9438   procedure recalc-assgds :
     9439   define input  parameter p-gds-code as integer   no-undo .
     9440   define input  parameter p-old-grp as integer   no-undo .
     9441   define input  parameter p-new-grp as integer   no-undo .
     9442   define output parameter p-ok      as logical    no-undo .
     9443   define buffer buf_assortment-matrix       for ub.assortment-matrix  .
     9444   define buffer buf_assortment-matrix-goods for ub.assortment-matrix-goods  .
     9445     do
     9446     on error undo, return error return-value
     9447     :
     9448     find first buf_assortment-matrix-goods no-lock where
     9449                  buf_assortment-matrix-goods.gds-code =  p-gds-code and
     9450                  buf_assortment-matrix-goods.obj-type <> "" and
     9451                  buf_assortment-matrix-goods.asmg-status =  0 no-error.
     9452     if not AVAILABLE buf_assortment-matrix-goods then do: p-ok = yes .
     9453     end.
     9454     else do:
     9455     for each buf_assortment-matrix-goods no-lock where
     9456              buf_assortment-matrix-goods.gds-code =  p-gds-code and
     9457              buf_assortment-matrix-goods.obj-type <> "" and
     9458              buf_assortment-matrix-goods.asmg-status =  0 ,
     9459         first buf_assortment-matrix no-lock where
     9460               buf_assortment-matrix.asmt-status =  0 and
     9461               buf_assortment-matrix.obj-type <> "" and
     9462               buf_assortment-matrix.asmt-id = buf_assortment-matrix-goods.asmt-id  and
     9463               buf_assortment-matrix.db-num  = buf_assortment-matrix-goods.db-num
     9464              :
     9465          run utl/uassmgrp.p ( p-old-grp, p-new-grp, buf_assortment-matrix.asmt-id , buf_assortment-matrix.db-num, output p-ok ) no-error.
     9466     end.
     9467     end.
     9468     end.
     9469   end procedure.
