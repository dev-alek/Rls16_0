     8302   PROCEDURE proc-vc-rs-cond:
     8303     DEFINE PARAMETER BUFFER loc-goo-doc FOR ub.goods.
     8304     DEFINE PARAMETER BUFFER loc-gob-doc FOR ub.gds-obj.
     8305       if rs-cond :screen-value in frame d-gob-doc-ref = 'все':U
     8306       and dbtype("ub") = 'PROGRESS'
     8307       then do:
     8308         assign
     8309           g#log = a-n-c :enable( "Нач.слова" )
     8310         .
     8311       end.
     8312       else do:
     8313         assign
     8314           g#log = a-n-c :disable( "Нач.слова" )
     8315         .
     8316       end.
     8317       DISPLAY
     8318         a-n-c
     8319       WITH FRAME d-gob-doc-ref .
     8320       if input frame d-gob-doc-ref rs-cond = 'все':U or g-cond = 'все':U then do:
     8321               assign
     8322                 g-cond = input frame d-gob-doc-ref rs-cond
     8323               .
     8324                   FIND FIRST loc-goo-doc NO-LOCK WHERE
     8325                              loc-goo-doc.artic     = loc-gob-doc.artic     AND
     8326                              loc-goo-doc.prod-type = loc-gob-doc.prod-type AND
     8327                              loc-goo-doc.prod-code = loc-gob-doc.prod-code NO-ERROR.
     8328                   assign
     8329                     g-rep = ( if available loc-goo-doc then recid( loc-goo-doc ) else g-rep )
     8330                   .
     8331               a-n-c = "".
     8332               apply "go":U to frame d-gob-doc-ref.
     8333               return error.
     8334           end.
     8335       assign
     8336           g-cond = input frame d-gob-doc-ref rs-cond
     8337           a-n-c :screen-value in frame d-gob-doc-ref = "art"
     8338       .
     8339       apply "value-changed":U to a-n-c in frame d-gob-doc-ref .
     8340       RUN enable_UI IN THIS-PROCEDURE.
     8341   END PROCEDURE.
     8342   PROCEDURE proc-b-add:
