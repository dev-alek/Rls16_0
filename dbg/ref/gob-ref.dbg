     4176   PROCEDURE proc-valchg-a-n-c:
     4177     case input frame d-gob-doc-ref a-n-c :
     4178       when "art" then do:
     4179         apply "entry" to br-gds in frame d-gob-doc-ref.
     4180         hide loc-name loc-code
     4181         in frame d-gob-doc-ref.
     4182         loc-art = "".
     4183           NameContext = "" .
     4184           hide NameContext in frame d-gob-doc-ref.
     4185           if a-n-c <> a-n-c:screen-value then do:
     4186             assign a-n-c.
     4187             RUN openbr in this-procedure ( input no, input yes ,input no, input '').
     4188           end.
     4189       end.
     4190       when "name" then do:
     4191         enable loc-name with frame d-gob-doc-ref.
     4192         disp loc-name with frame d-gob-doc-ref.
     4193         hide loc-art loc-code
     4194         in frame d-gob-doc-ref.
     4195         NameContext = "" .
     4196         hide NameContext in frame d-gob-doc-ref.
     4197         if a-n-c <> a-n-c:screen-value then do:
     4198           assign a-n-c.
     4199           RUN openbr in this-procedure ( input no, input yes ,input no, input '').
     4200         end.
     4201         apply "entry" to loc-name in frame d-gob-doc-ref.
     4202       end.
     4203       when "code"
     4204    or when "DataMatrix" then
     4205       do:
     4206         enable loc-code with frame d-gob-doc-ref.
     4207         disp loc-code with frame d-gob-doc-ref.
     4208         hide loc-art loc-name
     4209         in frame d-gob-doc-ref.
     4210         NameContext = "" .
     4211         hide NameContext in frame d-gob-doc-ref.
     4212         if a-n-c <> a-n-c:screen-value then do:
     4213           assign a-n-c.
     4214           RUN openbr in this-procedure ( input no, input yes ,input no, input '').
     4215         end.
     4216         apply "entry" to loc-code in frame d-gob-doc-ref.
     4217       end.
     4218       when "context" then do:
     4219         assign a-n-c .
     4220         enable NameContext with frame d-gob-doc-ref.
     4221         disp NameContext with frame d-gob-doc-ref.
     4222         apply "entry" to NameContext in frame d-gob-doc-ref.
     4223         HIDE loc-art loc-name loc-code in frame d-gob-doc-ref.
     4224       end .
     4225     end CASE.
     4226   END PROCEDURE.
     4227   PROCEDURE proc-any-printable-br-gds :
