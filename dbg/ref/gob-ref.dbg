     6066           frame d-gob-doc-ref :width = frame d-gob-doc-ref :width + p-change-value
     6067         no-error .
     6068         if error-status :error
     6069         or error-status :get-message(1) <> ""
     6070         then do:
     6071           undo move_block, retry move_block.
     6072         end.
     6073         if frame d-gob-doc-ref :scrollable = true
     6074         then do:
     6075           assign
     6076             frame d-gob-doc-ref :virtual-width = frame d-gob-doc-ref :virtual-width + p-change-value
     6077           no-error .
     6078           if error-status :error
     6079           or error-status :get-message(1) <> ""
     6080           then do:
     6081             undo move_block, retry move_block.
     6082           end.
     6083         end.
     6084       end.
     6085       if p-move-resize
     6086       then do:
     6087         run diasize_position-resize-button in this-procedure .
     6088       end.
     6089       if v-diasize-wndstore = true
     6090       then do:
     6091         if connected("ub") = true
     6092         then do:
     6093           define variable v-cntxt-db-num        as integer   no-undo .
     6094           define variable v-cntxt-userid        as character no-undo .
     6095           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     6096                                             , OUTPUT v-cntxt-userid
     6097                                             ) .
     6098           run gbl/wndsizew.p
     6099             (input  v-cntxt-db-num
     6100             ,input  v-cntxt-userid
     6101             ,input  v-diasize-proc-name
     6102             ,input  'width':u
     6103             ,input  string(frame d-gob-doc-ref :width - v-diasize-orig-frame-width)
     6104             ) .
     6105         end.
     6106       end.
     6107     end.
     6108     assign
     6109       v-diasize-change-size = false
     6110     .
     6111   end procedure.
     6112   procedure diasize_set-width :
     6113     define input  parameter p-new-width  as decimal   no-undo .
     6114     define input  parameter p-move-resize as logical   no-undo .
     6115     do
     6116     on error undo, return error return-value
     6117     :
     6118       run diasize_change-width in this-procedure
     6119         (input  (p-new-width - frame d-gob-doc-ref :width)
     6120         ,input  p-move-resize
     6121         ) .
     6122     end.
     6123   end procedure.
     6124   procedure diasize_position-resize-button :
     6125     do with frame d-gob-doc-ref
     6126     :
     6127       hide v-diasize-resize-button .
     6128       assign
     6129         v-diasize-resize-button :row = frame d-gob-doc-ref :height - v-diasize-resize-button :height
     6130                     - 1
     6131                     - (frame d-gob-doc-ref :border-bottom-pixels / session :pixels-per-row)
     6132         v-diasize-resize-button :col = frame d-gob-doc-ref :width - v-diasize-resize-button :width
     6133                     - 1
     6134                     - (frame d-gob-doc-ref :border-right-pixels / session :pixels-per-column)
     6135       .
     6136       view v-diasize-resize-button .
     6137     end.
     6138   end procedure.
     6139   on alt-right anywhere
     6140   do:
     6141     run diasize_change-width in this-procedure
     6142       (input 1
     6143       ,input true
     6144       ) .
     6145     return no-apply .
     6146   end.
     6147   on alt-left anywhere
     6148   do:
     6149     run diasize_change-width in this-procedure
     6150       (input -1
     6151       ,input true
     6152       ) .
     6153     return no-apply .
     6154   end.
     6155   on alt-down anywhere
     6156   do:
     6157     run diasize_change-height in this-procedure
     6158       (input 1
     6159       ,input true
     6160       ) .
     6161     return no-apply .
     6162   end.
     6163   on alt-up anywhere
     6164   do:
     6165     run diasize_change-height in this-procedure
     6166       (input -1
     6167       ,input true
     6168       ) .
     6169     return no-apply .
     6170   end.
     6171   on alt-enter of frame d-gob-doc-ref
     6172   do:
     6173     run diasize_maximize in this-procedure
     6174       (input  ?
     6175       ).
     6176     return no-apply .
     6177   end.
     6178   procedure diasize_end-move :
     6179     do
     6180     on error undo, return error return-value
     6181     :
     6182       define variable v-row-delta as decimal   no-undo .
     6183       define variable v-col-delta as decimal   no-undo .
     6184       define variable v-new-row as decimal   no-undo .
     6185       define variable v-new-col as decimal   no-undo .
     6186       assign
     6187         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     6188         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     6189       .
     6190       assign
     6191         v-row-delta = v-new-row - frame d-gob-doc-ref :height
     6192         v-col-delta = v-new-col - frame d-gob-doc-ref :width
     6193       .
     6194       run diasize_change-height in this-procedure
     6195         (input v-row-delta
     6196         ,input true
     6197         ) .
     6198       run diasize_change-width in this-procedure
     6199         (input v-col-delta
     6200         ,input true
     6201         ) .
     6202     end.
     6203   end procedure.
     6204   procedure diasize_maximize :
     6205     define input  parameter p-action as logical   no-undo .
     6206     do
     6207     on error undo, return error return-value
     6208     :
     6209       if p-action = ?
     6210       then do:
     6211         if v-diasize-need-maximize = true
     6212         then do:
     6213           assign
     6214             p-action = true
     6215           .
     6216         end.
     6217         else do:
     6218           assign
     6219             p-action = false
     6220           .
     6221         end.
     6222       end.
     6223       if p-action = true
     6224       then do:
     6225         run diasize_change-height in this-procedure
     6226           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     6227               - frame d-gob-doc-ref :height-chars
     6228           ,input true
     6229           ) .
     6230         run diasize_change-width in this-procedure
     6231           (input session :width-chars
     6232               - frame d-gob-doc-ref :width-chars
     6233           ,input true
     6234           ) .
     6235         assign
     6236           v-diasize-need-maximize = false
     6237         .
     6238       end.
     6239       else do:
     6240         run diasize_change-width in this-procedure
     6241           (input v-diasize-orig-frame-width
     6242               - frame d-gob-doc-ref :width-chars
     6243           ,input true
     6244           ) .
     6245         run diasize_change-height in this-procedure
     6246           (input v-diasize-orig-frame-height
     6247               - frame d-gob-doc-ref :height-chars
     6248           ,input true
     6249           ) .
     6250         assign
     6251           v-diasize-need-maximize = true
     6252         .
     6253       end.
     6254     end.
     6255   end procedure.
     6256   procedure diasize_restore-orig-size :
     6257     do
     6258     on error undo, return error return-value
     6259     :
     6260       assign
     6261         v-diasize-current-frame-width  = frame d-gob-doc-ref :width
     6262         v-diasize-current-frame-height = frame d-gob-doc-ref :height
     6263       .
     6264       run diasize_set-height in this-procedure
     6265         (input  v-diasize-orig-frame-height
     6266         ,input  true
     6267         ) .
     6268       run diasize_set-width in this-procedure
     6269         (input  v-diasize-orig-frame-width
     6270         ,input  true
     6271         ) .
     6272     end.
     6273   end procedure.
     6274   procedure diasize_restore-current-size :
     6275     do
     6276     on error undo, return error return-value
     6277     :
     6278       run diasize_set-height in this-procedure
     6279         (input  v-diasize-current-frame-height
     6280         ,input  true
     6281         ) .
     6282       run diasize_set-width in this-procedure
     6283         (input  v-diasize-current-frame-width
     6284         ,input  true
     6285         ) .
     6286     end.
     6287   end procedure.
     6288   procedure diasize_set-browse-handle :
     6289     define input  parameter p-browse-handle as handle   no-undo .
     6290     define buffer buf_temp-browse-handle for temp-browse-handle .
     6291     do
     6292     on error undo, return error return-value
     6293     :
     6294       assign
     6295         v-diasize-browse-handle = p-browse-handle
     6296       .
     6297       for each buf_temp-browse-handle
     6298       on error undo, return error return-value
     6299       :
     6300         delete buf_temp-browse-handle .
     6301       end.
     6302     end.
     6303   end procedure.
     6304   procedure diasize_add_browse :
     6305     define input  parameter p-browse-type   as character no-undo .
     6306     define input  parameter p-browse-handle as handle    no-undo .
     6307     define buffer buf_temp-browse-handle for temp-browse-handle .
     6308     do
     6309     on error undo, return error return-value
     6310     :
     6311       assign
     6312         v-diasize-browse-number = v-diasize-browse-number + 1
     6313       .
     6314       create buf_temp-browse-handle .
     6315       assign
     6316         buf_temp-browse-handle.browse-type   = p-browse-type
     6317         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     6318         buf_temp-browse-handle.browse-handle = p-browse-handle
     6319       .
     6320     end.
     6321   end procedure.
     6322   procedure diasize_init :
     6323     define variable v-default-value    as logical   no-undo .
     6324     define variable v-restore-saved    as logical   no-undo .
     6325     define variable v-resize-value-str as character no-undo .
     6326     do
     6327     on error undo, return error return-value
     6328     :
     6329       do with frame d-gob-doc-ref
     6330       :
     6331         assign
     6332           v-diasize-orig-frame-height = frame d-gob-doc-ref :height
     6333           v-diasize-orig-frame-width  = frame d-gob-doc-ref :width
     6334           v-diasize-browse-handle     = browse br-gds :handle
     6335         .
     6336         create button v-diasize-resize-button
     6337         assign
     6338           parent        = frame d-gob-doc-ref :first-child
     6339           label         = "s"
     6340           height-pixels = 16
     6341           width-pixels  = 16
     6342           visible       = true
     6343           sensitive     = true
     6344           movable       = true
     6345           triggers:
     6346             on end-move persistent run diasize_end-move in this-procedure .
     6347           end triggers.
     6348         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     6349         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     6350         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     6351         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     6352         assign
     6353           v-diasize-wndmax = false
     6354         .
     6355         if connected("ub") = true
     6356         then do:
     6357           define variable v-cntxt-db-num        as integer   no-undo .
     6358           define variable v-cntxt-userid        as character no-undo .
     6359           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     6360                                             , OUTPUT v-cntxt-userid
     6361                                             ) .
     6362           run gbl/wndpar_r.p
     6363             (input  v-cntxt-db-num
     6364             ,input  v-cntxt-userid
     6365             ,input  'wndmax':U
     6366             ,output v-diasize-wndmax
     6367             ,output v-default-value
     6368             ) .
     6369         end.
     6370         assign
     6371           v-diasize-wndstore = false
     6372         .
     6373         if connected("ub") = true
     6374         then do:
     6375           run gbl/wndpar_r.p
     6376             (input  v-cntxt-db-num
     6377             ,input  v-cntxt-userid
     6378             ,input  'wndstore':U
     6379             ,output v-diasize-wndstore
     6380             ,output v-default-value
     6381             ) .
     6382         end.
     6383         assign
     6384           v-diasize-proc-name = entry(1, program-name(2), '.')
     6385         .
     6386         if v-diasize-wndstore = true
     6387         then do:
     6388           assign
     6389             v-restore-saved = false
     6390           .
     6391           if connected("ub") = true
     6392           then do:
     6393             run gbl/wndsizer.p
     6394               (input  v-cntxt-db-num
     6395               ,input  v-cntxt-userid
     6396               ,input  v-diasize-proc-name
     6397               ,input  'height':u
     6398               ,output v-resize-value-str
     6399               ) .
     6400             if v-resize-value-str <> '':U
     6401             then do:
     6402               run diasize_change-height in this-procedure
     6403                 (input  integer(v-resize-value-str)
     6404                 ,input  true
     6405                 ) .
     6406               assign
     6407                 v-restore-saved = true
     6408               .
     6409             end.
     6410           end.
     6411           if connected("ub") = true
     6412           then do:
     6413             run gbl/wndsizer.p
     6414               (input  v-cntxt-db-num
     6415               ,input  v-cntxt-userid
     6416               ,input  v-diasize-proc-name
     6417               ,input  'width':u
     6418               ,output v-resize-value-str
     6419               ) .
     6420             if v-resize-value-str <> '':U
     6421             then do:
     6422               run diasize_change-width in this-procedure
     6423                 (input  integer(v-resize-value-str)
     6424                 ,input  true
     6425                 ) .
     6426               assign
     6427                 v-restore-saved = true
     6428               .
     6429             end.
     6430           end.
     6431           if v-restore-saved <> true
     6432           then do:
     6433             if v-diasize-wndmax = true
     6434             then do:
     6435               run diasize_maximize in this-procedure
     6436                 (input  true
     6437                 ) .
     6438             end.
     6439           end.
     6440         end.
     6441         else do:
     6442           if v-diasize-wndmax = true
     6443           then do:
     6444             run diasize_maximize in this-procedure
     6445               (input  true
     6446               ) .
     6447           end.
     6448         end.
     6449       end.
     6450     end.
     6451   end procedure.
     6452   procedure diasize_need-full-display :
     6453     define output parameter p-need-full-display as logical   no-undo .
     6454     do
     6455     on error undo, return error return-value
     6456     :
     6457       assign
     6458         p-need-full-display = v-diasize-need-full-display
     6459       .
     6460       assign
     6461         v-diasize-need-full-display = false
     6462       .
     6463     end.
     6464   end procedure.
     6465   procedure get-context :
     6466      define output parameter p-db-num as integer          no-undo.
     6467      define output parameter p-user-id as character        no-undo.
     6468      define variable v-login               as character    no-undo.
     6469      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     6470      define buffer buf_user-login  for ub.user-login .
     6471      do
     6472      on error undo, return error
     6473      :
     6474            FIND FIRST buf_sys-ctrl no-lock.
     6475            ASSIGN
     6476               v-login = USERID("ub")
     6477               p-db-num = buf_sys-ctrl.db-num
     6478            .
     6479            FIND FIRST buf_user-login
     6480                 WHERE buf_user-login.db-num = p-db-num
     6481                   AND buf_user-login.user-login = v-login
     6482                 no-lock
     6483                 no-error
     6484                 .
     6485            IF AVAILABLE buf_user-login
     6486            THEN DO:
     6487               assign
     6488                  p-user-id = buf_user-login.user-id
     6489               .
     6490            END.
     6491      end.
     6492   end procedure.
     6493       run diasize_init in this-procedure .
     6494   define variable vss-include-info66 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6495   do:
     6496     br-gds :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     6497   end.
     6498   define variable vss-include-info67 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6499   on f5 of frame d-gob-doc-ref anywhere
     6500   do:
     6501      if available goo-doc then gds-rec = recid(goo-doc). RUN openbr IN THIS-PROCEDURE ( INPUT YES, input yes, input no, input '' ).
     6502       apply "VALUE-CHANGED" to br-gds.
     6503   end.
     6504   define variable vss-include-info68 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6505   procedure set-filter-name :
     6506   define input parameter p-filter-name as character no-undo .
     6507     do with frame d-gob-doc-ref:
     6508       if p-filter-name > "" then do:
     6509         assign
     6510           frame d-gob-doc-ref:title
     6511             = frame d-gob-doc-ref:title + "   ФИЛЬТР: " + p-filter-name.
     6512         .
     6513         assign
     6514           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     6515         .
     6516       end.
     6517       else do:
     6518         assign
     6519           b-sch :tooltip = ""
     6520         .
     6521       end.
     6522     end.
     6523   end procedure.
     6524   MAIN-BLOCK:
     6525   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     6526      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     6527   define variable vss-include-info69 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6528     run mainmenu_getcntxt in parparentproc
     6529       (output v-cntxt-db-num
     6530       ,output v-cntxt-userid
     6531       ,output v-cntxt-level
     6532       ,output v-cntxt-host-code-obj
     6533       ,output v-cntxt-obj-type
     6534       ,output v-cntxt-obj-code
     6535       ,output v-cntxt-db-num-obj
     6536       ,output v-cntxt-is-admin
     6537       ) .
     6538     run main-block-proc in this-procedure no-error.
     6539     if error-status :error then do: return error. end.
     6540     WAIT-FOR GO OF FRAME d-gob-doc-ref FOCUS br-gds.
     6541   END.
     6542   assign
     6543   p-gds-name-width = gds-n:width in browse br-gds
     6544   p-grp-name-width = gob-doc.grp-name:width in browse br-gds
     6545   .
     6546   RUN disable_UI IN THIS-PROCEDURE.
     6547   PROCEDURE disable_UI :
     6548     HIDE FRAME d-gob-doc-ref NO-PAUSE.
     6549   END PROCEDURE.
     6550   PROCEDURE openbr :
     6551   define input parameter p-repos-message as logical no-undo .
     6552   define input parameter p-open-query as logical   no-undo .
     6553   define input parameter p-find-next as logical   no-undo .
     6554   define input parameter p-find-condition as character no-undo .
     6555   DEFINE VARIABLE pos-rec AS RECID NO-UNDO .
     6556   define buffer pos_goods for ub.goods.
     6557   define buffer cur-obj   for ub.clients.
     6558   FIND FIRST cur-obj NO-LOCK WHERE
     6559             cur-obj.obj-type = p-obj-type
     6560         AND cur-obj.obj-code = p-obj-code .
     6561   ASSIGN
     6562   FRAME d-gob-doc-ref rs-sort
     6563   .
     6564   assign
     6565     filter-point = "gob-doc" + "_" + string( g-stat )
     6566     filter-label = "Все_товары_по_объекту" + "_" + string( g-stat )
     6567   .
     6568     run ref/gds-refb.p ( input  p-open-query                         ,input  p-find-next                         ,input  p-find-condition                                                  ,input a-n-c                         ,input NameContext                         ,input rs-sort                         ,input g-cond                          ,input g-list                          ,input g-stat                          ,input g-grp                           ,input p-obj-type                         ,input p-obj-code                         ,buffer g-producer                         ,buffer cur-obj                            ,output for-title                                                  ,input filter-point                          ,input filter-point0                         ,input sort-column-name                         ,output v-filter-name                         ,input-output g-rep                         ).
     6569   assign
     6570   frame d-gob-doc-ref :title = for-title
     6571   .
     6572   if g-list = "ptrl"
     6573   or g-list = "lgas"
     6574   or g-list = "ptrlsug"
     6575   or g-list = "only-np"
     6576   then do:
     6577     assign
     6578     rs-list = 'все':U
     6579     rs-stat = 'текущие':U
     6580     rs-cond = 'все':U
     6581     .
     6582     DISPLAY
     6583     rs-list rs-cond rs-stat
     6584     WITH FRAME d-gob-doc-ref.
     6585     disable
     6586     rs-list rs-cond rs-stat
     6587     WITH FRAME d-gob-doc-ref.
     6588   end.
     6589   else do:
     6590     assign
     6591     rs-list = g-list
     6592     rs-stat = g-stat
     6593     rs-cond = g-cond
     6594     .
     6595     DISPLAY
     6596     rs-list rs-cond rs-stat
     6597     WITH FRAME d-gob-doc-ref.
     6598   end.
     6599   run set-filter-name in this-procedure (INPUT v-filter-name) no-error .
     6600   if g-rep <> ? then do:
     6601     reposition br-gds to recid g-rep no-error.
     6602     if error-status :error then do:
     6603       if p-repos-message and g-rep = v-chg-rec then do:
     6604         pos-rec = g-rep.
     6605         find first pos_goods no-lock where       recid( pos_goods ) = pos-rec no-error .   message     "Невозможно позиционироваться на товаре" skip      string( if available pos_goods              then  ( pos_goods.artic + chr(32) + pos_goods.prod-type + " ":U +              string( pos_goods.prod-code ) + " ":U + pos_goods.gds-name )              else "":U ) skip     "Товар был добавлен (или изменен или удален) -" skip     "и теперь не попадает в текущую выборку"   view-as alert-box WARNING.
     6606         v-chg-rec = ?.
     6607       end.
     6608       if num-results( "br-gds" ) <> 0 then do:
     6609         g#log = br-gds :select-row( 1 ) .
     6610         g#log = br-gds :scroll-to-selected-row( 1 ) .
     6611       end.
     6612     end.
     6613   end.
     6614   apply "entry":U to br-gds in frame d-gob-doc-ref.
     6615   if available gob-doc then do:
     6616     assign
     6617       g#log = br-gds :SELECT-PREV-ROW( )
     6618     .
     6619     if g#log = yes then do:
     6620       assign
     6621         g#log = br-gds :SELECT-NEXT-ROW( )
     6622       .
     6623     end.
     6624   end.
     6625   apply "value-changed":U to br-gds in frame d-gob-doc-ref.
     6626   if ( g-list = g-cond or ( g-cond = 'объект':U and g-list = 'все':U ) ) and rs-sort = 'Артикул':U then do:
     6627     assign
     6628       start = yes
     6629     .
     6630   end.
     6631   if start and not from-b-sch then do:
     6632     run UI-on in this-procedure.
     6633     if v-chg-rec <> ? then do:
     6634       reposition br-gds to recid v-chg-rec no-error.
     6635       if error-status :error then do:
     6636         if p-repos-message then do:
     6637           pos-rec = v-chg-rec.
     6638           find first pos_goods no-lock where       recid( pos_goods ) = pos-rec no-error .   message     "Невозможно позиционироваться на товаре" skip      string( if available pos_goods              then  ( pos_goods.artic + chr(32) + pos_goods.prod-type + " ":U +              string( pos_goods.prod-code ) + " ":U + pos_goods.gds-name )              else "":U ) skip     "Товар был добавлен (или изменен или удален) -" skip     "и теперь не попадает в текущую выборку"   view-as alert-box WARNING.
     6639         end.
     6640         if num-results( "br-gds" ) <> 0 then do:
     6641           assign
     6642           g#log = br-gds :select-row( 1 )
     6643           .
     6644           assign
     6645           g#log = br-gds :scroll-to-selected-row( 1 )
     6646           .
     6647         end.
     6648       end.
     6649       assign
     6650       v-chg-rec = ?
     6651       .
     6652     end.
     6653   end.
     6654   RUN buttons IN THIS-PROCEDURE.
     6655   assign
     6656   start = no
     6657   .
     6658   END PROCEDURE.
     6659   PROCEDURE full-sch :
     6660           FIND FIRST goo-doc NO-LOCK WHERE
     6661                      goo-doc.artic     = l-gob-doc.artic     AND
     6662                      goo-doc.prod-type = l-gob-doc.prod-type AND
     6663                      goo-doc.prod-code = l-gob-doc.prod-code .
     6664           assign
     6665             g-rep = recid( goo-doc )
     6666           .
     6667           if a-n-c = "art" then do:
     6668             assign
     6669               sch-rec = g-rep
     6670             .
     6671           end.
     6672           assign
     6673             g-stat = 'все':U
     6674             g-cond = 'все':U
     6675             g-list = 'все':U
     6676           .
     6677           apply "go":U to frame d-gob-doc-ref.
     6678   END PROCEDURE.
     6679   PROCEDURE buttons :
     6680     if lookup( "b-add", bttns ) > 0
     6681     AND ub.db.add-goods AND NOT transaction and lookup( "no-object":U, p-other, chr(4) ) = 0
     6682     then do:
     6683       enable
     6684       b-add
     6685       b-add-office
     6686       b-grp
     6687       b-del    b-copy b-chg
     6688       with frame d-gob-doc-ref.
     6689     end.
     6690     else do:
     6691       disable
     6692       b-add
     6693       b-add-office
     6694       b-grp
     6695       b-del
     6696       b-copy
     6697       b-chg
     6698       with frame d-gob-doc-ref.
     6699     end.
     6700     if not ub.db.add-goods
     6701     and v-cntxt-db-num = 0 then do:
     6702       enable
     6703       b-grp
     6704       with frame d-gob-doc-ref .
     6705     end.
     6706     if is-fbr = yes then do:
     6707       enable
     6708         b-recip
     6709       with frame d-gob-doc-ref.
     6710     end.
     6711     else do:
     6712       disable
     6713         b-recip
     6714       with frame d-gob-doc-ref.
     6715     end.
     6716     if is-fbr <> yes then do:
     6717       assign
     6718       menu-item m-dopinf-lfgds :sensitive in menu m-dopinf = no
     6719       menu-item m-dopinf-lscoef :sensitive in menu m-dopinf = no
     6720       menu-item m-dopinf-cfgds :sensitive in menu m-dopinf = no
     6721       menu-item m-dopinf-cscoef :sensitive in menu m-dopinf = no
     6722       .
     6723     end.
     6724   END PROCEDURE.
     6725   PROCEDURE controls :
     6726   ENABLE
     6727   b-exit b-arch b-price b-rest b-card b-chk b-lkp b-prt b-parts b-gdsreffi b-place b-dinamo b-sert b-hist add-inf
     6728   b-alt-bc
     6729   b-help
     6730   rs-list rs-cond rs-stat rs-sort a-n-c br-gds
     6731   b-sch
     6732   b-sel  WHEN LOOKUP( "b-sel",  bttns ) > 0
     6733   b-mark WHEN LOOKUP( "b-mark", bttns ) > 0
     6734   b-extart
     6735   WITH FRAME d-gob-doc-ref.
     6736   IF mImagePh THEN
     6737       ASSIGN
     6738           g-image:HIDDEN     = NO
     6739           g-image:VISIBLE    = YES
     6740           g-image:SENSITIVE  = YES
     6741           .
     6742   ELSE
     6743       ASSIGN
     6744           g-image:HIDDEN     = YES
     6745           g-image:VISIBLE    = NO
     6746           g-image:SENSITIVE  = NO
     6747           .
     6748   if lookup( "no-object":U, p-other, chr(4) ) > 0 then do:
     6749     if v-obj-name = "":U then do:
     6750       run proc-b-obj in this-procedure ( input "":U ).
     6751     end.
     6752     hide
     6753     b-add b-add-office
     6754     b-grp b-del b-copy b-chg
     6755     in frame d-gob-doc-ref .
     6756     display
     6757     b-obj
     6758     v-obj-type
     6759     v-obj-code
     6760     v-obj-name
     6761     with frame d-gob-doc-ref .
     6762     enable
     6763     b-obj
     6764     with frame d-gob-doc-ref .
     6765   end.
     6766   if a-n-c = "art" then do:
     6767     display
     6768     loc-art
     6769     with frame d-gob-doc-ref.
     6770   end.
     6771   else do:
     6772     hide loc-art loc-name loc-code NameContext in frame d-gob-doc-ref.
     6773   end.
     6774   CASE g-cond :
     6775     when 'все':U then do:
     6776       assign
     6777       rs-sort = 'Артикул':U
     6778       .
     6779       display
     6780       rs-sort
     6781       with frame d-gob-doc-ref .
     6782       disable
     6783       rs-sort
     6784       with frame d-gob-doc-ref .
     6785     end.
     6786     when 'объект':U then do:
     6787       assign
     6788       rs-sort = 'Артикул':U
     6789       .
     6790       enable
     6791       rs-sort
     6792       with frame d-gob-doc-ref .
     6793       assign
     6794       g#log = rs-sort :disable("Количество")
     6795       .
     6796       display
     6797       rs-sort
     6798       with frame d-gob-doc-ref .
     6799     end.
     6800     otherwise do:
     6801       enable
     6802       rs-sort
     6803       with frame d-gob-doc-ref .
     6804       assign
     6805       g#log = rs-sort :enable("Количество")
     6806       .
     6807       display
     6808       rs-sort
     6809       with frame d-gob-doc-ref .
     6810     end.
     6811   END CASE .
     6812   END PROCEDURE.
     6813   PROCEDURE enable_UI :
     6814   RUN buttons  IN THIS-PROCEDURE.
     6815   RUN controls IN THIS-PROCEDURE.
     6816   RUN openbr  IN THIS-PROCEDURE ( INPUT NO, input yes, input no, input '':U).
     6817   END PROCEDURE.
     6818   PROCEDURE UI-on :
     6819   DEFINE VARIABLE var-disable-sort AS LOGICAL NO-UNDO .
     6820   if flt-rec <> ? then do:
     6821     if var-disable-sort then do:
     6822       DISABLE
     6823       rs-sort
     6824       WITH FRAME d-gob-doc-ref.
     6825     end.
     6826     else do:
     6827       ENABLE
     6828       rs-sort
     6829       WITH FRAME d-gob-doc-ref.
     6830     end.
     6831   end.
     6832   else do:
     6833     ENABLE
     6834     rs-sort
     6835     WITH FRAME d-gob-doc-ref.
     6836     if from-b-sch then do:
     6837       RUN openbr IN THIS-PROCEDURE ( INPUT YES, input yes, input no, input '' ) .
     6838     end.
     6839   end.
     6840   apply "entry":U             to br-gds in frame d-gob-doc-ref.
     6841   apply "value-changed":U to br-gds in frame d-gob-doc-ref.
     6842   END PROCEDURE.
     6843   PROCEDURE b-mark-proc:
     6844       if not available gob-doc then do:   message     "Неправильно выбран товар."   view-as alert-box error.   return no-apply. end. FIND FIRST goo-doc WHERE goo-doc.artic     = gob-doc.artic                      AND goo-doc.prod-type = gob-doc.prod-type                      AND goo-doc.prod-code = gob-doc.prod-code NO-LOCK. assign   gds-rec = recid( goo-doc ) .
     6845       define variable v-num-entry as integer no-undo .
     6846       assign
     6847         v-num-entry = lookup( string( recid( goo-doc ) ), rid-list )
     6848       .
     6849       if v-num-entry > 0 then do:
     6850         assign
     6851           entry( v-num-entry, rid-list ) = "":U
     6852         .
     6853         assign
     6854           rid-list = trim( replace( rid-list, chr(44) + chr(44), chr(44) ), chr(44) )
     6855         .
     6856       end.
     6857       else do:
     6858         if num-entries( rid-list ) >= 4000 then do:
     6859           message "Превышено максимально допустимое количество выбранных товаров"
     6860                   "Воспользуйстесь добавлением товаров через список товаров, если это возможно"
     6861           view-as alert-box WARNING.
     6862           undo, return error.
     6863         end.
     6864         assign
     6865           rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + string( recid( goo-doc) )
     6866         .
     6867       end.
     6868       assign
     6869         g#log = br-gds :refresh( ) in frame d-gob-doc-ref
     6870       .
     6871       if num-entries( rid-list ) = 0 then do:
     6872           hide
     6873             mark-num in frame d-gob-doc-ref.
     6874       end.
     6875       else do:
     6876           display
     6877             num-entries( rid-list ) @ mark-num
     6878           with frame d-gob-doc-ref.
     6879       end.
     6880       if lookup( last-event :function, "MOUSE-SELECT-DBLCLICK,Return" ) = 0 then
     6881           do:
     6882               assign
     6883                 g#log = br-gds :select-next-row () in frame d-gob-doc-ref
     6884               .
     6885               apply "value-changed":U to br-gds in frame d-gob-doc-ref.
     6886           end.
     6887       apply "entry":U to br-gds in frame d-gob-doc-ref.
     6888   END PROCEDURE.
     6889   PROCEDURE b-del-proc:
     6890     DEFINE PARAMETER BUFFER loc-goo-doc FOR ub.goods.
     6891     DEFINE PARAMETER BUFFER loc-gob-doc FOR ub.gds-obj.
     6892     define variable v-stts like ub.goods.stts no-undo .
     6893     define buffer loc_gds-obj for ub.gds-obj.
     6894       if not available loc-gob-doc then do:   message     "Неправильно выбран товар."   view-as alert-box error.   return no-apply. end. FIND FIRST loc-goo-doc WHERE loc-goo-doc.artic     = loc-gob-doc.artic                          AND loc-goo-doc.prod-type = loc-gob-doc.prod-type                          AND loc-goo-doc.prod-code = loc-gob-doc.prod-code NO-LOCK. assign   gds-rec = recid( loc-goo-doc ) .
     6895       assign
     6896         g#log = FALSE
     6897       .
     6898       CASE loc-goo-doc.gds-type :
     6899         when 'т':U then do:
     6900   define variable vss-include-info70 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6901   do:
     6902     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     6903       (input  v-cntxt-db-num
     6904       ,input  v-cntxt-userid
     6905       ,input  0
     6906       ,input  'actn_reference_deletion':U
     6907       ,input  'object':U
     6908       ,input  0
     6909       ,input  '':U
     6910       ,input  0
     6911       ,input  0
     6912       ,input  loc-goo-doc.grp-code
     6913       ,input  0
     6914       ,input  true
     6915       ,output g#log
     6916       )  .
     6917   end.
     6918         end.
     6919         when 'у':U then do:
     6920   define variable vss-include-info71 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6921   do:
     6922     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     6923       (input  v-cntxt-db-num
     6924       ,input  v-cntxt-userid
     6925       ,input  0
     6926       ,input  'actn_reference-services_deletion':U
     6927       ,input  'object':U
     6928       ,input  0
     6929       ,input  '':U
     6930       ,input  0
     6931       ,input  0
     6932       ,input  loc-goo-doc.grp-code
     6933       ,input  0
     6934       ,input  true
     6935       ,output g#log
     6936       )  .
     6937   end.
     6938         end.
     6939         otherwise do:
     6940           message
     6941             vss-workfile vss-revision vss-description skip
     6942             "Неизвестный тип товара" skip
     6943             "Тип товара" loc-goo-doc.gds-type skip
     6944             "Код товара" loc-goo-doc.gds-code skip
     6945             view-as alert-box error .
     6946           undo, return error return-value .
     6947         end.
     6948       END CASE.
     6949       if NOT g#log then do: return error . end.
     6950       v-stts = ?.
     6951       run ref/goods02.p (
     6952                      input gds-rec
     6953                     ,input no
     6954                     ,input-output v-stts) no-error.
     6955       if error-status:error then do:
     6956         apply "entry":U to br-gds in frame d-gob-doc-ref.
     6957         return error.
     6958       end.
     6959       assign
     6960       g-rep            = recid( loc-gob-doc )
     6961       v-chg-rec        = g-rep.
     6962   END PROCEDURE.
     6963   PROCEDURE local-find:
     6964     DEFINE PARAMETER BUFFER loc-goo-doc FOR ub.goods.
     6965     DEFINE PARAMETER BUFFER loc-gob-doc FOR ub.gds-obj.
     6966     assign
     6967       vat-p = ?
     6968       SLT-p = ?
     6969     .
     6970     FIND FIRST loc-goo-doc NO-LOCK WHERE
     6971                loc-goo-doc.artic     = loc-gob-doc.artic     AND
     6972                loc-goo-doc.prod-code = loc-gob-doc.prod-code AND
     6973                loc-goo-doc.prod-type = loc-gob-doc.prod-type
     6974                                     USE-INDEX pi NO-ERROR.
     6975   define variable vss-include-info72 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6976   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     6977     (input  loc-goo-doc.gds-code
     6978     ,input  '1':U
     6979     ,input  ?
     6980     ,input  v-host-code
     6981     ,input  p-obj-type
     6982     ,input  p-obj-code
     6983     ,output vat-p
     6984     ) no-error .
     6985   define variable vss-include-info73 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6986   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     6987     (input  loc-goo-doc.gds-code
     6988     ,input  '2':U
     6989     ,input  ?
     6990     ,input  v-host-code
     6991     ,input  p-obj-type
     6992     ,input  p-obj-code
     6993     ,output slt-p
     6994     ) no-error .
     6995     assign
     6996       e-name = loc-goo-doc.engl-name
     6997       gds-n  = (if loc-goo-doc.stts = 0 then loc-goo-doc.gds-name else  (substring( loc-goo-doc.gds-name, 1, 15 ) + chr(32) + '<':U + CAPS(entry (lookup (string(loc-goo-doc.stts), '0,1,50,51':U), 'тек,удал,блок.для.смены.арт.,смена.арт.':U)) + '>':U  ))
     6998       gds-t  = ( if loc-goo-doc.gds-type = 'т':U then "-" else "+" )
     6999       unit-b = loc-goo-doc.unit-base
     7000       qnty-c = loc-goo-doc.qnty-cart
     7001     .
     7002   END PROCEDURE.
     7003   PROCEDURE b-chk-proc:
     7004     DEFINE PARAMETER BUFFER loc-goo-doc FOR ub.goods.
     7005     DEFINE PARAMETER BUFFER loc-gob-doc FOR ub.gds-obj.
     7006     DEFINE VARIABLE rid-list    AS   CHARACTER          NO-UNDO .
     7007     DEFINE VARIABLE v-main-code LIKE ub.bar-code.b-code NO-UNDO .
     7008     DEFINE BUFFER buf_units FOR ub.units.
     7009     do
     7010     on error undo, return error
     7011     :
     7012       if not available loc-gob-doc then do:   message     "Неправильно выбран товар."   view-as alert-box error.   return no-apply. end. FIND FIRST loc-goo-doc WHERE loc-goo-doc.artic     = loc-gob-doc.artic                          AND loc-goo-doc.prod-type = loc-gob-doc.prod-type                          AND loc-goo-doc.prod-code = loc-gob-doc.prod-code NO-LOCK. assign   gds-rec = recid( loc-goo-doc ) .
     7013   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     7014     (input  loc-goo-doc.gds-code
     7015     ,input  ?
     7016     ,output v-main-code
     7017     )  .
     7018       FIND FIRST ub.gds-prt NO-LOCK WHERE
     7019                  ub.gds-prt.upper-code = loc-goo-doc.prt-root.
     7020       find first buf_units No-LOCK WHERE
     7021                  buf_units.unit-name = loc-goo-doc.unit-base .
     7022       if ub.gds-prt.node-name = '_Пустая шкала':U
     7023       or not v-doc-prt = yes then do:
     7024         if lookup( 'сер':U, buf_units.type ) > 0 then do:
     7025           run ref/gds-chks.w (  INPUT parparentproc
     7026                          ,  INPUT RECID( loc-goo-doc )
     7027                          ,  INPUT "":U
     7028                          ,  INPUT 'объект':U
     7029                          ,  INPUT ?
     7030                          ,  INPUT p-obj-type
     7031                          ,  INPUT p-obj-code
     7032                          ,  INPUT "":U
     7033                          ,  INPUT "":U
     7034                          , OUTPUT rid-list
     7035                          ) .
     7036         end.
     7037         else do:
     7038           run ref/gds-chk.w (  INPUT parparentproc
     7039                         ,  INPUT v-main-code
     7040                         ,  INPUT "":U
     7041                         ,  INPUT 'объект':U
     7042                         ,  INPUT ?
     7043                         ,  INPUT p-obj-type
     7044                         ,  INPUT p-obj-code
     7045                         ,  INPUT "":U
     7046                         ,  INPUT "":U
     7047                         , OUTPUT rid-list
     7048                         ) .
     7049         end.
     7050       end.
     7051       else do:
     7052         message
     7053           "Товар делится на признаки - смотрите чеки через шкалу."
     7054         view-as alert-box.
     7055       end.
     7056       apply "entry":U to br-gds in frame d-gob-doc-ref.
     7057     end.
     7058   END PROCEDURE.
     7059   PROCEDURE proc-m-ostatki-1:
     7060     DEFINE PARAMETER BUFFER loc-goo-doc FOR ub.goods.
     7061     DEFINE PARAMETER BUFFER loc-gob-doc FOR ub.gds-obj.
     7062       if not available loc-gob-doc then do:   message     "Неправильно выбран товар."   view-as alert-box error.   return error. end. FIND FIRST loc-goo-doc WHERE loc-goo-doc.artic     = loc-gob-doc.artic                          AND loc-goo-doc.prod-type = loc-gob-doc.prod-type                          AND loc-goo-doc.prod-code = loc-gob-doc.prod-code NO-LOCK. assign   gds-rec = recid( loc-goo-doc ) .
     7063       FIND FIRST ub.gds-prt NO-LOCK WHERE
     7064                  ub.gds-prt.upper-code = loc-goo-doc.prt-root .
     7065       run rep/gds-objs.w (
     7066                        INPUT parparentproc,
     7067                        INPUT loc-goo-doc.artic,
     7068                        INPUT loc-goo-doc.prod-type,
     7069                        INPUT loc-goo-doc.prod-code,
     7070                        INPUT v-host-code,
     7071                        INPUT -1
     7072                      ).
     7073       apply "entry":U to br-gds in frame d-gob-doc-ref.
     7074   END PROCEDURE.
     7075   PROCEDURE proc-m-ostatki-2:
     7076     DEFINE PARAMETER BUFFER loc-goo-doc FOR ub.goods.
     7077     DEFINE PARAMETER BUFFER loc-gob-doc FOR ub.gds-obj.
     7078     if not available loc-gob-doc then do:   message     "Неправильно выбран товар."   view-as alert-box error.   return error. end. FIND FIRST loc-goo-doc WHERE loc-goo-doc.artic     = loc-gob-doc.artic                          AND loc-goo-doc.prod-type = loc-gob-doc.prod-type                          AND loc-goo-doc.prod-code = loc-gob-doc.prod-code NO-LOCK. assign   gds-rec = recid( loc-goo-doc ) .
     7079     run ref/cli-gdss.w
     7080                    (input parparentproc
     7081                    ,input 'Товар,Остатки':U
     7082                    ,input recid( loc-goo-doc )
     7083                    ,input ?
     7084                    )
     7085     .
     7086     apply "entry":U to br-gds in frame d-gob-doc-ref.
     7087   END PROCEDURE.
     7088   PROCEDURE proc-m-oborot-1:
     7089     DEFINE PARAMETER BUFFER loc-goo-doc FOR ub.goods.
     7090     DEFINE PARAMETER BUFFER loc-gob-doc FOR ub.gds-obj.
     7091     if not available loc-gob-doc then do:   message     "Неправильно выбран товар."   view-as alert-box error.   return error. end. FIND FIRST loc-goo-doc WHERE loc-goo-doc.artic     = loc-gob-doc.artic                          AND loc-goo-doc.prod-type = loc-gob-doc.prod-type                          AND loc-goo-doc.prod-code = loc-gob-doc.prod-code NO-LOCK. assign   gds-rec = recid( loc-goo-doc ) .
     7092     assign
     7093       g#log = no
     7094     .
     7095     message "Вывод отчета предполагает РАСЧЕТ АРХИВОВ по товарам" skip
     7096             "Продолжать?"
     7097     view-as alert-box QUESTION buttons YES-NO update g#log.
     7098     if g#log = yes then do:
     7099       run rep/e-good2.w ( input parParentProc,
     7100                       input loc-gob-doc.artic,
     7101                       input loc-gob-doc.prod-type,
     7102                       input loc-gob-doc.prod-code,
     7103                       input ?,
     7104                       input ?,
     7105                       input p-obj-type,
     7106                       input p-obj-code          ) no-error.
     7107     end.
     7108     apply "entry":U to br-gds in frame d-gob-doc-ref.
     7109   END PROCEDURE.
     7110   PROCEDURE proc-m-oborot-2:
     7111     DEFINE PARAMETER BUFFER loc-goo-doc FOR ub.goods.
     7112     DEFINE PARAMETER BUFFER loc-gob-doc FOR ub.gds-obj.
     7113     if not available loc-gob-doc then do:   message     "Неправильно выбран товар."   view-as alert-box error.   return error. end. FIND FIRST loc-goo-doc WHERE loc-goo-doc.artic     = loc-gob-doc.artic                          AND loc-goo-doc.prod-type = loc-gob-doc.prod-type                          AND loc-goo-doc.prod-code = loc-gob-doc.prod-code NO-LOCK. assign   gds-rec = recid( loc-goo-doc ) .
     7114     run ref/cli-gdss.w (
     7115                      input parparentproc
     7116                    , input 'Товар,Обороты':U
     7117                    , input recid( loc-goo-doc )
     7118                    , input ?
     7119                    ).
