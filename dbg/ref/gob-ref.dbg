     9092   RUN gds-ref-to IN THIS-PROCEDURE (
     9093                                        INPUT        gdsreffi
     9094                                       ,INPUT-OUTPUT myto[1]
     9095                                       ,INPUT-OUTPUT myto[2]
     9096                                       ,INPUT-OUTPUT myto[3]
     9097                                       ,INPUT-OUTPUT myto[4]
     9098                                       ,INPUT-OUTPUT myto[5]
     9099                                       ,INPUT-OUTPUT myto[6]
     9100                                       ,INPUT-OUTPUT myto[7]
     9101                                       ,INPUT-OUTPUT myto[8]
     9102                                     ) NO-ERROR.
     9103   assign
     9104   fi-1 :tooltip in frame d-gob-doc-ref = myto[1]
     9105   fi-2 :tooltip      = myto[2]
     9106   fi-3 :tooltip      = myto[3]
     9107   fi-4 :tooltip      = myto[4]
     9108   fi-5 :tooltip      = myto[5]
     9109   fi-6 :tooltip      = myto[6]
     9110   fi-7 :tooltip      = myto[7]
