     4238   find first l-gob-doc where l-gob-doc.obj-type = p-obj-type                                  and l-gob-doc.obj-code = p-obj-code AND (if g-stat = 'все':U then true else (if g-stat = 'текущие':U then (l-gob-doc.stts = 0) else (l-gob-doc.stts = 1)))
     4239                                     and l-gob-doc.artic begins (loc-art + last-event:label) no-lock no-error.
