     3592   RUN imagelist_loaddef IN THIS-PROCEDURE NO-ERROR.
     3593   PROCEDURE imagelist_loaddef:
     3594       DEFINE VARIABLE vPar-val       AS CHARACTER   NO-UNDO.
     3595       DEFINE VARIABLE vPar-type      AS CHARACTER   NO-UNDO.
     3596       ASSIGN
     3597           vPar-val  = "":U
     3598           vPar-type = "":U
     3599           .
     3600   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3601     (input  'photo':u
     3602     ,input  '':u
     3603     ,input  '':u
     3604     ,input  0
     3605     ,input  '':u
     3606     ,input  '':u
     3607     ,input  '':u
     3608     ,input  no
     3609     ,output vPar-val
     3610     ,output vPar-type
     3611     ) no-error .
     3612           mImagePh = LOOKUP (vPar-val, "true,yes":U) > 0.
     3613       IF mImagePh THEN .
     3614       ELSE RETURN.
     3615       ASSIGN
     3616           vPar-val  = "":U
     3617           vPar-type = "":U
     3618           .
     3619   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3620     (input  'ph-dir':u
     3621     ,input  '':u
     3622     ,input  '':u
     3623     ,input  0
     3624     ,input  '':u
     3625     ,input  '':u
     3626     ,input  '':u
     3627     ,input  NO
     3628     ,output vPar-val
     3629     ,output vPar-type
     3630     ) no-error .
     3631       IF LENGTH (vPar-val) = 0 THEN
     3632           RUN verify-ini-entry("ph-dir":U, "REP-SETS":U, "":U, YES, OUTPUT vPar-val) NO-ERROR.
     3633       IF LENGTH (vPar-val) = 0 THEN vPar-val = "c:\temp\":U.
     3634       ASSIGN
     3635           mImagePath   = RIGHT-TRIM (vPar-val, "~\~/":U)
     3636           mImagePath   = mImagePath + (IF LENGTH (mImagePath) > 0 THEN "\":U ELSE "":U)
     3637           mImagePreDir = mImagePath
     3638           mImageDir    = mImagePreDir
     3639           mImageTrash  = mImagePath + "trash\":U
     3640           .
     3641       ASSIGN
     3642           vPar-val  = "":U
     3643           vPar-type = "":U
     3644           .
     3645               run adm/shattri.p (
     3646           input "get":U
     3647           ,input  '':U
     3648           ,input  0
     3649           ,input  'gds-ref':U
     3650           ,input  'shema-foto':U
     3651           ,output v-value-char
     3652           ,output v-val-date
     3653           ,output v-val-decimal
     3654           ,output v-val-integer
     3655           ,output v-val-logical
     3656           ,output v-param-types
     3657           ,INPUT-OUTPUT table-handle v-tthd
     3658           ) no-error.
     3659           delete object v-tthd.
     3660           mPhotomgd = IF v-val-integer = 2 then yes else no.
     3661   END PROCEDURE.
     3662   PROCEDURE imagelist_decode:
     3663       DEFINE INPUT  PARAMETER iImageList AS LONGCHAR  NO-UNDO.
     3664       DEFINE INPUT  PARAMETER iImageGdsCode AS int    NO-UNDO.
     3665       DEFINE OUTPUT PARAMETER oImageList AS LONGCHAR  NO-UNDO.
     3666       DEFINE VARIABLE vCh                AS CHARACTER NO-UNDO.
     3667       DEFINE VARIABLE vInt               AS INTEGER   NO-UNDO.
     3668       ASSIGN
     3669           oImageList = iImageList
     3670           .
     3671       DO vInt = 1 TO NUM-ENTRIES (iImageList, ",":U):
     3672           vCh =ENTRY (vInt, iImageList, ",":U).
     3673           IF SUBSTRING (vCh, 1, 2) = "~\~\":U THEN .
     3674           ELSE
     3675           DO:
     3676               ASSIGN
     3677                   vCh = REPLACE (vCh, "~/":U, "\":U)
     3678                   vCh = REPLACE (vCh, "~\":U, "\":U)
     3679                   .
     3680               IF SUBSTRING (vCh, 2, 2) = ":\":U OR vCh BEGINS mImageDir THEN .
     3681               ELSE vCh = mImagePreDir + (if mPhotomgd then string(iImageGdsCode) + "\":U else '':U ) +  vCh.
     3682               ENTRY (vInt, oImageList, ",":U) = vCh.
     3683           END.
     3684       END.
     3685   END PROCEDURE.
     3686   PROCEDURE imagelist_encode:
     3687       DEFINE INPUT  PARAMETER iImageList AS LONGCHAR  NO-UNDO.
     3688       DEFINE OUTPUT PARAMETER oImageList AS LONGCHAR  NO-UNDO.
     3689       DEFINE VARIABLE vCh                AS CHARACTER NO-UNDO.
     3690       DEFINE VARIABLE vInt               AS INTEGER   NO-UNDO.
     3691       DEFINE VARIABLE vLen               AS INTEGER   NO-UNDO.
     3692       ASSIGN
     3693           oImageList = iImageList
     3694           vLen       = LENGTH (mImageDir)
     3695           .
     3696       DO vInt = 1 TO NUM-ENTRIES (iImageList, ",":U):
     3697           vCh =ENTRY (vInt, iImageList, ",":U).
     3698           IF LENGTH (vCh) > 0 AND vLen > 0 AND vCh BEGINS mImageDir THEN
     3699               ENTRY (vInt, oImageList, ",":U) =
     3700                   SUBSTRING (vCh, vLen + 1).
     3701       END.
     3702   END PROCEDURE.
