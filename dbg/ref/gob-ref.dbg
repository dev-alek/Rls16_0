     4029            SIDE-LABELS NO-UNDERLINE THREE-D SCROLLABLE TITLE 'справочник':U.
     4030   ASSIGN FRAME d-gob-doc-ref :SCROLLABLE = FALSE.
     4031   ASSIGN br-gds :NUM-LOCKED-COLUMNS IN FRAME d-gob-doc-ref = 4 .
     4032   ASSIGN b-rest  :POPUP-MENU IN FRAME d-gob-doc-ref = MENU m-ostatki :HANDLE.
     4033   ASSIGN b-rest  :MENU-MOUSE = 1.
     4034   ASSIGN b-card  :POPUP-MENU IN FRAME d-gob-doc-ref = MENU m-oborot  :HANDLE.
     4035   ASSIGN b-card  :MENU-MOUSE = 1.
     4036   ASSIGN add-inf :POPUP-MENU IN FRAME d-gob-doc-ref = MENU m-dopinf  :HANDLE.
     4037   ASSIGN add-inf :MENU-MOUSE = 1.
     4038   ASSIGN b-price:POPUP-MENU IN FRAME d-gob-doc-ref = MENU m-price:HANDLE.
     4039   ASSIGN b-price:MENU-MOUSE = 1.
     4040   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4041   DEF VAR cur-clmn-numbr-gds as INT EXTENT 15 no-undo.
     4042   DEF VAR varmvibr-gds       as INT no-undo.
     4043   DEF VAR varmvjbr-gds       as INT no-undo.
     4044   DEF VAR varmvkbr-gds       as INT no-undo.
     4045   DEF VAR varmvlbr-gds       as INT no-undo.
     4046   DEF VAR move-elementbr-gds as INT no-undo.
     4047   def var jjbr-gds           as int no-undo.
     4048   do varmvibr-gds = 1 to EXTENT(cur-clmn-numbr-gds):
     4049     ASSIGN cur-clmn-numbr-gds[varmvibr-gds] = varmvibr-gds.
     4050   END.
     4051   RUN start-mv-clmnbr-gds.
     4052   PROCEDURE start-mv-clmnbr-gds:
     4053   def var old-session as logical no-undo.
     4054      old-session = SESSION:IMMEDIATE-DISPLAY.
     4055      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4056      SESSION:IMMEDIATE-DISPLAY = old-session.
     4057   END.
     4058   ON ctrl-cursor-right OF BROWSE br-gds do:
     4059     RUN re-move-clmnbr-gds ( 6, 15).
     4060   END.
     4061   ON ctrl-cursor-left OF BROWSE br-gds do:
     4062     RUN re-move-clmnbr-gds (15, 6).
     4063   END.
     4064   PROCEDURE re-move-clmnbr-gds:
     4065     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     4066     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     4067     DO varmvibr-gds = 1 TO EXTENT(cur-clmn-numbr-gds):
     4068       if cur-clmn-numbr-gds[varmvibr-gds] = source-column THEN cur-clmn-numbr-gds[varmvibr-gds] = -1.
     4069     END.
     4070     if br-gds:MOVE-COLUMN(source-column, target-column) IN FRAME d-gob-doc-ref then.
     4071     if source-column > target-column THEN
     4072     DO varmvjbr-gds = source-column - 1 to target-column BY -1:
     4073       DO varmvibr-gds = 1 TO EXTENT(cur-clmn-numbr-gds):
     4074           if cur-clmn-numbr-gds[varmvibr-gds] = varmvjbr-gds THEN DO:
     4075             cur-clmn-numbr-gds[varmvibr-gds] = cur-clmn-numbr-gds[varmvibr-gds] + 1.
     4076           END.
     4077       END.
     4078     END.
     4079     ELSE
     4080     DO varmvjbr-gds = source-column + 1 to target-column:
     4081       DO varmvibr-gds = 1 TO EXTENT(cur-clmn-numbr-gds):
     4082         if cur-clmn-numbr-gds[varmvibr-gds] = varmvjbr-gds THEN DO:
     4083           cur-clmn-numbr-gds[varmvibr-gds] = cur-clmn-numbr-gds[varmvibr-gds] - 1.
     4084         END.
     4085       END.
     4086     END.
     4087     DO varmvibr-gds = 1 TO EXTENT(cur-clmn-numbr-gds):
     4088       if cur-clmn-numbr-gds[varmvibr-gds] = -1 THEN cur-clmn-numbr-gds[varmvibr-gds] = target-column.
     4089     END.
     4090   END PROCEDURE.
     4091   PROCEDURE ch-clmnbr-gds:
     4092     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     4093     if cur-clmn-loc <= 6 then do:
     4094       return .
     4095     end.
     4096     DO varmvibr-gds = 1 TO EXTENT(cur-clmn-numbr-gds):
     4097       if cur-clmn-numbr-gds[varmvibr-gds] = cur-clmn-loc THEN move-elementbr-gds = varmvibr-gds.
     4098     END.
     4099     RUN re-move-clmnbr-gds (cur-clmn-loc, 6).
     4100   END PROCEDURE.
     4101   PROCEDURE mv-brw-defaultbr-gds:
     4102   def var old-session as logical no-undo.
     4103     old-session = SESSION:IMMEDIATE-DISPLAY.
     4104     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     4105     do varmvlbr-gds = 6 to EXTENT(cur-clmn-numbr-gds):
     4106       RUN re-move-clmnbr-gds (cur-clmn-numbr-gds[varmvlbr-gds], varmvlbr-gds).
     4107     END.
     4108     RUN start-mv-clmnbr-gds.
     4109     SESSION:IMMEDIATE-DISPLAY = old-session.
     4110   END PROCEDURE.
