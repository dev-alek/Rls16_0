     1797     define output parameter p-use-sort-gr   as logical   no-undo .
     1798     define output parameter p-use-type-price as logical   no-undo .
     1799     define output parameter p-use-type-val  as logical   no-undo .
     1800     define output parameter p-label          as character no-undo .
