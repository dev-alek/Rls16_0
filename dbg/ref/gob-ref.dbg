     7122   PROCEDURE proc-b-sch:
     7123   run init-flt in this-procedure no-error.
     7124   if error-status :error then do:
     7125     return error.
     7126    end.
     7127   DO ON STOP UNDO, LEAVE :
     7128     run gbl/filter.w ( INPUT parparentproc
     7129                       ,INPUT (filter-point + chr(4) + filter-label)
     7130                       ,INPUT tbl
     7131                       ,INPUT join-tbl
     7132                       ,INPUT fld
     7133                       ,INPUT lab
     7134                       ,INPUT spr
     7135                       ,INPUT dim
     7136                       )
     7137                           .
     7138     ASSIGN
     7139     from-b-sch = YES
     7140     .
     7141     RUN UI-on IN THIS-PROCEDURE.
     7142     ASSIGN
     7143     from-b-sch = NO
     7144     .
     7145   END.
     7146   run buttons in this-procedure.
     7147   END PROCEDURE.
     7148   PROCEDURE proc-find:
     7149     DEFINE PARAMETER BUFFER loc-goo-doc FOR ub.goods.
     7150     DEFINE PARAMETER BUFFER loc-gob-doc FOR ub.gds-obj.
     7151     define variable for-last-pcnt as decimal column-label "Торг.наценка" format "->>>,>>9.99%" no-undo.
     7152     assign
     7153       val-vat = ?
     7154       val-SLT = ?
     7155     .
     7156     FIND FIRST ub.recipe NO-LOCK WHERE
     7157                ub.recipe.prod-type = loc-goo-doc.prod-type
     7158            AND ub.recipe.prod-code = loc-goo-doc.prod-code
     7159            AND ub.recipe.artic     = loc-goo-doc.artic
     7160            AND
     7161              (
     7162              ( ub.recipe.obj-type  = loc-gob-doc.obj-type
     7163            AND ub.recipe.obj-code  = loc-gob-doc.obj-code
     7164              )
     7165             OR
     7166              ( ub.recipe.obj-type  = "":U
     7167            AND ub.recipe.obj-code  = 0
     7168              )
     7169              )
     7170            NO-ERROR.
     7171       assign
     7172         mark-recipe = ( if available ub.recipe then ub.recipe.recipe-type else "":U )
     7173         mark        = ( if lookup( string( recid( loc-goo-doc ) ), rid-list ) > 0 then "*" else "":U )
     7174       .
     7175   define variable vss-include-info74 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7176   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     7177     (input  loc-goo-doc.gds-code
     7178     ,input  '1':U
     7179     ,input  ?
     7180     ,input  v-host-code
     7181     ,input  p-obj-type
     7182     ,input  p-obj-code
     7183     ,output val-vat
     7184     ) no-error .
     7185   define variable vss-include-info75 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7186   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     7187     (input  loc-goo-doc.gds-code
     7188     ,input  '2':U
     7189     ,input  ?
     7190     ,input  v-host-code
     7191     ,input  p-obj-type
     7192     ,input  p-obj-code
     7193     ,output val-slt
     7194     ) no-error .
     7195       if available loc-gob-doc then do:
     7196         assign
     7197           fact-q         = loc-gob-doc.fact-qnty
     7198           free-q         = loc-gob-doc.free-qnty
     7199           price          = loc-gob-doc.price-sale
     7200           for-cash-parts = loc-gob-doc.cash-parts
     7201           for-last-price = ( if v-lookup-cost then loc-gob-doc.last-base else ? )
     7202           for-last-pcnt  = ( if v-lookup-cost then ( price /
     7203                            ( if v-curr-r-b = 'base':U then loc-gob-doc.last-base else loc-gob-doc.last-rubl ) *
     7204                              100 - 100 )      else ? )
     7205         .
     7206         if abs( for-last-pcnt ) > 999999.99 then do:
     7207           assign
     7208             for-last-pcnt-str = "############":U
     7209           .
     7210         end.
     7211         else do:
     7212           assign
     7213             for-last-pcnt-str = string( for-last-pcnt, "->>>,>>9.99%":U )
     7214           .
     7215         end.
     7216         if v-is-ptrl = "yes" then do:
     7217           run get-petrol-weight-qty in this-procedure ( buffer loc-goo-doc,
     7218                                                         buffer loc-gob-doc,
     7219                                                         output free-q-cli,
     7220                                                         output fact-q-cli ) no-error.
     7221           if error-status :error then do: return error return-value. end.
     7222         end.
     7223       end.
     7224       else do:
     7225         assign
     7226           fact-q         = 0
     7227           free-q         = 0
     7228           price          = 0
     7229           for-cash-parts = no
     7230           for-last-price = 0
     7231           for-last-pcnt  = ?
     7232           free-q-cli    = 0.0
     7233           fact-q-cli    = 0.0
     7234           v-indicator-life-gds = ""
     7235           v-assort-min         = no
     7236         .
     7237       end.
     7238   END PROCEDURE.
     7239   PROCEDURE b-recip-proc:
     7240   DEFINE PARAMETER BUFFER loc-goo-doc FOR ub.goods.
     7241   DEFINE PARAMETER BUFFER loc-gob-doc FOR ub.gds-obj.
     7242   if is-fbr then do:
     7243     if not available loc-gob-doc then do:   message     "Неправильно выбран товар."   view-as alert-box error.   return no-apply. end. FIND FIRST loc-goo-doc WHERE loc-goo-doc.artic     = loc-gob-doc.artic                          AND loc-goo-doc.prod-type = loc-gob-doc.prod-type                          AND loc-goo-doc.prod-code = loc-gob-doc.prod-code NO-LOCK. assign   gds-rec = recid( loc-goo-doc ) .
     7244     if loc-goo-doc.gds-type = 'у':U then do:
     7245       BELL.
     7246       return error.
     7247     end.
     7248     FIND FIRST ub.units NO-LOCK WHERE ub.units.unit-name = loc-goo-doc.unit-base .
     7249     if lookup( ub.units.type, 'сер':U ) > 0 then do:
     7250       message "Для серийного товара" skip
     7251               "рецепт задать нельзя !"
     7252       view-as alert-box INFORMATION .
     7253     end.
     7254     else do:
     7255       FIND FIRST ub.gds-prt NO-LOCK WHERE ub.gds-prt.upper-code = loc-goo-doc.prt-root .
     7256       if lookup( ub.gds-prt.node-name, '_Пустая шкала':U ) > 0 then do:
     7257         run ref/rcp-all.w (
     7258                         input parparentproc
     7259                       , input ( if loc-goo-doc.stts = 0
     7260                                     AND ub.db.add-goods
     7261                                     AND NOT transaction
     7262                                   then "b-add"
     7263                                   else "":U )
     7264                       , input 'все':U
     7265                       , input recid( loc-goo-doc )
     7266                       , input p-obj-type
     7267                       , input p-obj-code
     7268                       , output ref-list
     7269                       ) .
     7270         FIND FIRST ub.recipe NO-LOCK WHERE
     7271                     ub.recipe.prod-type = loc-goo-doc.prod-type
     7272                 AND ub.recipe.prod-code = loc-goo-doc.prod-code
     7273                 AND ub.recipe.artic     = loc-goo-doc.artic
     7274                 AND
     7275                   (
     7276                   ( ub.recipe.obj-type  = loc-gob-doc.obj-type
     7277                 AND ub.recipe.obj-code  = loc-gob-doc.obj-code
     7278                   )
     7279                 OR
     7280                   ( ub.recipe.obj-type  = "":U
     7281                 AND ub.recipe.obj-code  = 0
     7282                   )
     7283                   )
     7284                 NO-ERROR.
     7285         assign
     7286           mark-recipe = ( if available ub.recipe then substring( ub.recipe.recipe-type, 1, 1 ) else " ":U )
     7287         .
     7288         DISPLAY
     7289           mark-recipe
     7290         WITH BROWSE br-gds.
     7291       end.
     7292       else do:
     7293         message "Рецепт можно определить" skip
     7294                 "только для товара БЕЗ ПРИЗНАКОВ."
     7295         view-as alert-box INFORMATION .
     7296       end.
     7297     end.
     7298     apply "entry":U to br-gds in frame d-gob-doc-ref.
     7299   end.
     7300   END PROCEDURE.
     7301   PROCEDURE proc-rs-list:
     7302     define variable i-rs-list like rs-list no-undo .
     7303     define variable ref-rec   as   recid   no-undo .
     7304       assign
     7305           i-rs-list = input frame d-gob-doc-ref rs-list
     7306       .
     7307       CASE i-rs-list :
     7308           when 'Производитель':U then do:
     7309             assign
     7310               ref-list = "":U
     7311             .
     7312             run ref/cli-all.w (
     7313                              input parparentproc
     7314                           ,  input "b-sel"
     7315                           ,  input 'про':U
     7316                           ,  input 'все':U
     7317                           ,  input 'текущие':U
     7318                           ,  input ?
     7319                           ,  input ",,,,,,NO,,,"
     7320                           ,  input ?
     7321                           , output ref-list
     7322                           ) .
     7323             if ref-list = "":U then do:
     7324               assign
     7325                 g-list = 'все':U
     7326               .
     7327               RUN enable_UI IN THIS-PROCEDURE.
     7328               return error.
     7329             end.
     7330             ref-rec = integer( ref-list ).
     7331             FIND FIRST g-producer NO-LOCK WHERE
     7332                 RECID( g-producer ) = ref-rec .
     7333             if available g-producer then do:
     7334               assign
     7335                 p-producer-type = g-producer.obj-type
     7336                 p-producer-code = g-producer.obj-code
     7337               .
     7338             end.
     7339           end.
     7340           when 'группа':U then do:
     7341             ASSIGN
     7342               g-grp = "":U
     7343             .
     7344             run ref/gds-grp.w ( input parparentproc
     7345                             ,INPUT "b-sel"
     7346                             , input p-obj-type
     7347                             , input p-obj-code
     7348                             , INPUT-OUTPUT g-grp ).
     7349             IF g-grp = "":U THEN DO:
     7350               ASSIGN
     7351                 g-list = 'все':U
     7352               .
     7353               RUN enable_UI IN THIS-PROCEDURE.
     7354               RETURN ERROR.
     7355             END.
     7356             FIND FIRST ub.gds-grp NO-LOCK WHERE
     7357                 RECID( ub.gds-grp ) = INTEGER( g-grp ) .
     7358             ASSIGN
     7359               g-grp = "":U
     7360             .
     7361             RUN grplib-get-full-name IN THIS-PROCEDURE ( INPUT gds-grp.node-code, OUTPUT g-grp ).
     7362           end.
     7363       END CASE .
     7364       assign
     7365         g-list = input frame d-gob-doc-ref rs-list
     7366         a-n-c :screen-value = "art"
     7367       .
     7368       apply "value-changed":U to a-n-c in frame d-gob-doc-ref .
     7369       RUN enable_UI IN THIS-PROCEDURE.
     7370   END PROCEDURE.
     7371   FUNCTION Get-good RETURNS CHARACTER
     7372     ( buffer loc-goods for goo-doc, buffer loc-gds-obj for gob-doc ) :
     7373     define variable for-last-pcnt as decimal column-label "Торг.наценка" format "->>>,>>9.99%" no-undo.
     7374     DEFINE VARIABLE vImageList AS CHARACTER  NO-UNDO.
     7375     DEFINE VARIABLE vCh        AS CHARACTER  NO-UNDO.
     7376     mphcol = NO.
     7377       FIND FIRST loc-goods NO-LOCK WHERE
     7378                  loc-goods.artic     = loc-gds-obj.artic     AND
     7379                  loc-goods.prod-code = loc-gds-obj.prod-code AND
     7380                  loc-goods.prod-type = loc-gds-obj.prod-type
     7381                                       USE-INDEX pi NO-ERROR.
     7382       if not available loc-goods then do:
     7383         assign
     7384           e-name         = "?"
     7385           gds-n          = "?"
     7386           gds-t          = "?"
     7387           unit-b         = "?"
     7388           qnty-c         = ?
     7389           VAT-p          = ?
     7390           SLT-p          = ?
     7391           mark-recipe    = "":U
     7392           mark           = "":U
     7393           fact-q         = 0
     7394           free-q         = 0
     7395           price          = 0
     7396           for-cash-parts = no
     7397           for-last-price = 0
     7398           for-last-pcnt  = ?
     7399           free-q-cli    = 0.0
     7400           fact-q-cli    = 0.0
     7401           v-indicator-life-gds = ""
     7402           v-assort-min         = no
     7403         .
     7404         RETURN MARK.
     7405       END.
     7406       assign
     7407         e-name = loc-goods.engl-name
     7408         gds-t  = ( if loc-goods.gds-type = 'т':U then "-" else "+" )
     7409         unit-b = loc-goods.unit-base
     7410         qnty-c = loc-goods.qnty-cart
     7411       .
     7412       IF mImagePh THEN
     7413       DO:
     7414           RUN gds-attr-value (loc-goods.gds-code, "image-list":U, OUTPUT vImageList, OUTPUT vCh).
     7415           mphcol = LENGTH (vImageList) > 0.
     7416       END.
     7417       gds-n  = (if loc-goods.stts = 0 then loc-goods.gds-name else  (substring( loc-goods.gds-name, 1, 15 ) + chr(32) + '<':U + CAPS(entry (lookup (string(loc-goods.stts), '0,1,50,51':U), 'тек,удал,блок.для.смены.арт.,смена.арт.':U)) + '>':U )).
     7418       FIND FIRST ub.recipe NO-LOCK WHERE
     7419                  ub.recipe.prod-type = loc-goods.prod-type
     7420              AND ub.recipe.prod-code = loc-goods.prod-code
     7421              AND ub.recipe.artic     = loc-goods.artic
     7422              AND
     7423                (
     7424                (
     7425                  ub.recipe.obj-type  = loc-gds-obj.obj-type
     7426              AND ub.recipe.obj-code  = loc-gds-obj.obj-code
     7427                )
     7428               OR
     7429                (
     7430                  ub.recipe.obj-type  = "":U
     7431              AND ub.recipe.obj-code  = 0
     7432                )
     7433                )
     7434                  NO-ERROR.
     7435       assign
     7436         mark-recipe = ( if available ub.recipe then ub.recipe.recipe-type else "":U )
     7437         mark        = ( if lookup( string( recid( loc-goods ) ), rid-list ) > 0 then "*" else "":U )
     7438       .
     7439   define variable vss-include-info76 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7440   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     7441     (input  loc-goods.gds-code
     7442     ,input  '1':U
     7443     ,input  ?
     7444     ,input  v-host-code
     7445     ,input  p-obj-type
     7446     ,input  p-obj-code
     7447     ,output vat-p
     7448     ) no-error .
     7449   define variable vss-include-info77 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7450   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     7451     (input  loc-goods.gds-code
     7452     ,input  '2':U
     7453     ,input  ?
     7454     ,input  v-host-code
     7455     ,input  p-obj-type
     7456     ,input  p-obj-code
     7457     ,output slt-p
     7458     ) no-error .
     7459       if available loc-gds-obj then do:
     7460         assign
     7461           fact-q         = loc-gds-obj.fact-qnty
     7462           free-q         = loc-gds-obj.free-qnty
     7463           price          = loc-gds-obj.price-sale
     7464           for-cash-parts = loc-gds-obj.cash-parts
     7465           for-last-price = ( if v-lookup-cost then loc-gds-obj.last-base  else ? )
     7466           for-last-pcnt  = ( if v-lookup-cost then ( price /
     7467                            ( if v-curr-r-b = 'base':U then loc-gds-obj.last-base else loc-gds-obj.last-rubl ) *
     7468                                                               100 - 100 ) else ? )
     7469         .
     7470         if abs(for-last-pcnt) > 999999.99 then do:
     7471           assign
     7472             for-last-pcnt-str = "############":U
     7473           .
     7474         end.
     7475         else do:
     7476           assign
     7477             for-last-pcnt-str = string( for-last-pcnt, "->>>,>>9.99%":U )
     7478           .
     7479         end.
     7480         if v-is-ptrl = "yes" then do:
     7481           run get-petrol-weight-qty in this-procedure ( buffer loc-goods,
     7482                                                         buffer loc-gds-obj,
     7483                                                         output free-q-cli,
     7484                                                         output fact-q-cli ) no-error.
     7485           if error-status :error then do: return error return-value. end.
     7486         end.
     7487       end.
     7488       else do:
     7489         assign
     7490           fact-q         = 0
     7491           free-q         = 0
     7492           price          = 0
     7493           for-cash-parts = no
     7494           for-last-price = 0
     7495           for-last-pcnt  = ?
     7496           fact-q-cli    = 0.0
     7497           free-q-cli    = 0.0
     7498           v-indicator-life-gds = ""
     7499           v-assort-min         = no
     7500         .
     7501       end.
     7502          IF mImagePh THEN
     7503         DO:
     7504           RUN gds-attr-value (loc-goods.gds-code, "image-list":U, OUTPUT vImageList, OUTPUT vCh).
     7505           mphcol = LENGTH (vImageList) > 0.
     7506         END.
     7507    RETURN mark.
     7508   END FUNCTION.
     7509   PROCEDURE b-place-proc:
     7510     define variable old-list-mode as character no-undo.
     7511     define variable old-gds-rec   as recid     no-undo.
     7512     define variable rid-list      as character no-undo.
     7513     run ref/pl-gdss.w (
     7514                    input parparentproc
     7515                   ,input "":U
     7516                   ,input p-obj-type
     7517                   ,input p-obj-code
     7518                   ,input 'ТОВАР':U
     7519                   ,input recid(goo-doc)
     7520                   ,input ?
     7521                   ,output rid-list
     7522                   ).
     7523   END PROCEDURE.
     7524   PROCEDURE b-dinamo-proc:
     7525     define variable old-list-mode as character no-undo.
     7526     define variable old-gds-rec   as recid     no-undo.
     7527     define variable rid-list      as character no-undo.
     7528     run rep/g-dinamo.p ( input parparentproc
     7529                    , input goo-doc.gds-code ) no-error .
