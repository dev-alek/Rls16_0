     7617                      buf_clients.obj-type = loc-goods.prod-type
     7618                 AND  buf_clients.obj-code = loc-goods.prod-code no-error .
     7619           if available buf_clients then do:
     7620             case buf_clients.obj-type :
     7621               when 'орг':U then do:
     7622                 find first buf_firm no-lock where
