     8483     end.
     8484   END CASE.
     8485   if NOT g#log or loc-goo-doc.stts <> 0 then do:
     8486     BELL.
     8487     return no-apply.
     8488   end.
     8489   assign
     8490     gds-rec       = recid (loc-goo-doc)
     8491     for-engl-name = loc-goo-doc.engl-name
     8492     for-gds-name  = loc-goo-doc.gds-name
     8493     for-chk-name  = loc-goo-doc.chk-name
     8494   .
     8495   run ref/gds-form.w (
     8496                     input parparentproc
     8497                   , input 'ИЗМЕНЕНИЕ':U
     8498                   , input p-obj-type
     8499                   , input p-obj-code
     8500                   , input v-handle
     8501                   , input-output gds-rec
     8502                   ) .
     8503   if gds-rec = ? then do:
     8504     apply "entry":U to br-gds in frame d-gob-doc-ref.
     8505   end.
     8506   else do:
     8507     FIND FIRST loc-goo-doc NO-LOCK WHERE RECID( loc-goo-doc ) = gds-rec NO-ERROR.
     8508     if available loc-goo-doc then do:
     8509       FIND FIRST loc-gob-doc NO-LOCK WHERE
     8510                   loc-goo-doc.artic     = loc-gob-doc.artic
     8511               AND loc-goo-doc.prod-type = loc-gob-doc.prod-type
     8512               AND loc-goo-doc.prod-code = loc-gob-doc.prod-code
     8513               AND loc-gob-doc.obj-type  = p-obj-type
     8514               AND loc-gob-doc.obj-code  = p-obj-code NO-ERROR.
     8515       if available loc-gob-doc then do:
     8516         assign
     8517           g-rep     = recid( loc-gob-doc )
     8518           v-chg-rec = g-rep
     8519         .
     8520       end.
     8521       else do:
     8522         assign
     8523           v-chg-rec = ?
     8524         .
     8525       end.
     8526     end.
     8527     RUN openbr    IN THIS-PROCEDURE ( INPUT YES, input yes, input no, input '':U ).
     8528     run gds-ref-fi IN THIS-PROCEDURE (   BUFFER       loc-goo-doc
     8529                                         ,BUFFER       loc-gob-doc
     8530                                         ,INPUT        p-obj-type
     8531                                         ,INPUT        p-obj-code
     8532                                         ,INPUT        gdsreffi
     8533                                         ,input        no
     8534                                         ,INPUT-OUTPUT fi-1
     8535                                         ,INPUT-OUTPUT fi-2
     8536                                         ,INPUT-OUTPUT fi-3
     8537                                         ,INPUT-OUTPUT fi-4
     8538                                         ,INPUT-OUTPUT fi-5
     8539                                         ,INPUT-OUTPUT fi-6
     8540                                         ,INPUT-OUTPUT fi-7
     8541                                         ,INPUT-OUTPUT fi-8
     8542                                       ) NO-ERROR.
     8543     DISPLAY
     8544       fi-1
     8545       fi-2
     8546       fi-3
     8547       fi-4
     8548       fi-5
     8549       fi-6
     8550       fi-7
     8551       fi-8
     8552       loc-goo-doc.gds-code @ goo-doc.gds-code
     8553     WITH FRAME d-gob-doc-ref.
     8554   end.
     8555   END PROCEDURE.
     8556   PROCEDURE proc-b-grp:
     8557     DEFINE PARAMETER BUFFER loc-goo-doc FOR ub.goods.
     8558     DEFINE PARAMETER BUFFER loc-gob-doc FOR ub.gds-obj.
     8559     define variable was-deleted as integer initial 0 no-undo.
     8560     define variable loc_g-grp as character no-undo .
     8561     define variable lns-cnt as integer no-undo .
     8562     define variable v-ok as logical no-undo .
     8563     define variable v-old-code as integer no-undo .
     8564     define buffer buf_gds-grp for ub.gds-grp.
     8565     if not available loc-gob-doc then do:   message     "Неправильно выбран товар."   view-as alert-box error.   return no-apply. end. FIND FIRST loc-goo-doc WHERE loc-goo-doc.artic     = loc-gob-doc.artic                          AND loc-goo-doc.prod-type = loc-gob-doc.prod-type                          AND loc-goo-doc.prod-code = loc-gob-doc.prod-code NO-LOCK. assign   gds-rec = recid( loc-goo-doc ) .
     8566     assign
     8567       g#log = FALSE
     8568     .
     8569   define variable vss-include-info93 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8570   do:
     8571     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     8572       (input  v-cntxt-db-num
     8573       ,input  v-cntxt-userid
     8574       ,input  0
     8575       ,input  'actn_reference_upd-group':U
     8576       ,input  'object':U
     8577       ,input  0
     8578       ,input  '':U
     8579       ,input  0
     8580       ,input  0
     8581       ,input  loc-goo-doc.grp-code
     8582       ,input  0
     8583       ,input  true
     8584       ,output g#log
     8585       )  .
     8586   end.
     8587     if NOT g#log then do:
     8588       return no-apply .
     8589     end.
     8590     assign
     8591       g#log = yes
     8592     .
     8593     v-old-code = loc-goo-doc.grp-code .
     8594     message
     8595       "Выберите группу, в которую нужно переместить товар(ы)."
     8596     view-as alert-box question buttons OK-Cancel update g#log.
     8597     if not g#log then do:
     8598       apply "entry":U to br-gds in frame d-gob-doc-ref.
     8599       return no-apply.
     8600     end.
     8601     run ref/gds-grp.w (
     8602                       input parparentproc
     8603                     , input 'терм':U + ',b-sel'
     8604                     , input p-obj-type
     8605                     , input p-obj-code
     8606                     , input-output loc_g-grp ).
     8607     if loc_g-grp = "":U then do:
     8608       apply "entry":U to br-gds in frame d-gob-doc-ref.
     8609       return no-apply.
     8610     end.
     8611     FIND FIRST buf_gds-grp WHERE RECID( buf_gds-grp ) = INTEGER( loc_g-grp ) .
     8612     if rid-list = "":U then do:
     8613       assign
     8614         rid-list = string( recid( loc-goo-doc ) )
     8615       .
     8616     end.
     8617   define variable vss-include-info94 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     8618   do:
     8619     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     8620       (input  v-cntxt-db-num
     8621       ,input  v-cntxt-userid
     8622       ,input  0
     8623       ,input  'actn_reference_upd-group':U
     8624       ,input  'object':U
     8625       ,input  0
     8626       ,input  '':U
     8627       ,input  0
     8628       ,input  0
     8629       ,input  buf_gds-grp.node-code
     8630       ,input  0
     8631       ,input  true
     8632       ,output g#log
     8633       )  .
     8634   end.
     8635     if NOT g#log then do:
     8636       return no-apply .
     8637     end.
     8638     assign
     8639       g#log = yes
     8640     .
     8641     assign
     8642       lns-cnt = 1
     8643     .
     8644   if session :set-wait-state( "compiler" ) then.
     8645     DO TRANSACTION WHILE lns-cnt <= NUM-ENTRIES( rid-list ) :
     8646       assign
     8647         gds-rec = integer( entry( lns-cnt, rid-list ) )
     8648       .
     8649       FIND FIRST loc-goo-doc WHERE RECID( loc-goo-doc ) = gds-rec.
     8650       IF loc-goo-doc.stts <> 0 then do:
     8651         assign
     8652           was-deleted = was-deleted + 1
     8653           lns-cnt     = lns-cnt     + 1
     8654         .
     8655         next.
     8656       end.
     8657       FIND FIRST loc-goo-doc WHERE RECID( loc-goo-doc ) = gds-rec .
     8658       assign
     8659         lns-cnt   = lns-cnt + 1
     8660         v-chg-rec = gds-rec
     8661       .
     8662       run recalc-assgds in this-procedure  ( input loc-goo-doc.gds-code,
     8663                                              input loc-goo-doc.grp-code,
     8664                                              input buf_gds-grp.node-code,
     8665                                              output v-ok    ) .
     8666       if v-ok then loc-goo-doc.grp-code = buf_gds-grp.node-code.
     8667            if check-ban-sales-via-cd-grp(loc-goo-doc.grp-code) then do:
     8668              run str/diallog.w (parparentproc, this-procedure, 'str/del-grp.p':U, string(v-cntxt-obj-code) + chr(4) + string(loc-goo-doc.grp-code), no,
     8669                                'Прервать', 'Удаление товаров с касс') .
     8670           end.
     8671        define variable v-value-emrc as character no-undo .
     8672        define variable v-type-emrc  as character no-undo .
     8673        old-value-emrc = "" .
     8674        for first ub.gds-grp-obj-attr no-lock
     8675           where ub.gds-grp-obj-attr.node-code   = v-old-code
     8676           and ub.gds-grp-obj-attr.host-code   = 0
     8677           and ub.gds-grp-obj-attr.obj-type    = ""
     8678           and ub.gds-grp-obj-attr.obj-code    = 0
     8679           and ub.gds-grp-obj-attr.attr-code   = 'emrc-type':U:
     8680           old-value-emrc = ub.gds-grp-obj-attr.attr-value .
     8681        end.
     8682        for first ub.gds-grp exclusive-lock where ub.gds-grp.node-code = loc-goo-doc.grp-code:
     8683           for first ub.gds-grp-obj-attr no-lock
     8684              where ub.gds-grp-obj-attr.node-code   = loc-goo-doc.grp-code
     8685              and ub.gds-grp-obj-attr.host-code   = 0
     8686              and ub.gds-grp-obj-attr.obj-type    = ""
     8687              and ub.gds-grp-obj-attr.obj-code    = 0
     8688              and ub.gds-grp-obj-attr.attr-code   = 'emrc-type':U:
     8689              v-value-emrc = ub.gds-grp-obj-attr.attr-value .
     8690           end.
     8691           define variable v-attr-emrc as character no-undo .
     8692           define variable v-attr-type as character no-undo .
     8693           define variable v-del       as logical   no-undo .
     8694           define buffer buf_goods-attr for ub.goods-attr .
     8695           define variable v-emrc-name as character no-undo .
     8696           for first buf_goods-attr no-lock where buf_goods-attr.attr-code = 'emrc-type':U and
     8697              buf_goods-attr.gds-code = loc-goo-doc.gds-code:
     8698              v-attr-emrc = buf_goods-attr.attr-value .
     8699           end.
     8700           if v-value-emrc <> old-value-emrc and v-attr-emrc = "" then
     8701           do:
     8702              find first ub.code no-lock where ub.Code.parent = "EMC" and ub.Code.code = v-value-emrc no-error .
     8703              if not available (ub.Code) then v-emrc-name = "Нет" .
     8704              else v-emrc-name = ub.Code.CodeName .
     8705              message "При переносе в группу " + string(ub.gds-grp.node-name) + " для товара " + string(loc-goo-doc.gds-name) skip
     8706                 "будет наследоваться значение новой группы тип ЕМЦ - " + v-emrc-name + ". " skip
     8707                 "При утвердительном ответе товар переносится в новую группу, значение тип ЕМЦ - " + v-emrc-name
     8708                 view-as alert-box question buttons yes-no-cancel update choice as logical .
     8709              CASE choice:
     8710                 WHEN TRUE THEN
     8711                    DO:
     8712                    END.
     8713                 WHEN FALSE THEN
     8714                    DO:
     8715                       run gds-attr-write IN THIS-PROCEDURE(
     8716                          input loc-goo-doc.gds-code
     8717                          ,INPUT 'emrc-type':U
     8718                          ,INPUT old-value-emrc ) .
     8719                    END.
     8720                 OTHERWISE
     8721                 DO:
     8722                    loc-goo-doc.grp-code = v-old-code .
     8723                 end.
     8724              END CASE.
     8725           end.
     8726           if v-value-emrc <> v-attr-emrc and v-attr-emrc <> "" then do:
     8727              define variable ichoice as integer no-undo .
     8728              find first ub.code no-lock where ub.Code.parent = "EMC" and ub.Code.code = v-attr-emrc no-error .
     8729              if not available (ub.Code) then v-emrc-name = "Нет" .
     8730              else v-emrc-name = ub.Code.CodeName .
     8731                     run gbl/d-askw.w (
     8732                        input "Сообщение"
     8733                        ,input  "На товар установлен атрибут «тип ЕМЦ» - " + v-emrc-name + ". При переносе товара значение может быть изменено."
     8734                        ,input "|"
     8735                        ,input "Наследовать|Оставить|Отмена"
     8736                        ,input "Наследовать атрибут от новой группы|Оставить текущее значение атрибута|Отмена"
     8737                        ,input 1
     8738                        ,input 3
     8739                        ,output ichoice).
     8740              CASE iChoice:
     8741                 WHEN 1 THEN
     8742                    DO:
     8743                 if v-value-emrc = "" then do:
     8744                 run gds-attr-delete IN THIS-PROCEDURE(
     8745                    input loc-goo-doc.gds-code
     8746                    ,INPUT 'emrc-type':U
     8747                    ,output v-del ) .
     8748                 end.
     8749                 else do:
     8750                 run gds-attr-write IN THIS-PROCEDURE(
     8751                    input loc-goo-doc.gds-code
     8752                    ,INPUT 'emrc-type':U
     8753                    ,INPUT v-value-emrc ) NO-ERROR.
     8754                 end.
     8755                    END.
     8756                 WHEN 2 THEN
     8757                    DO:
     8758                 run gds-attr-write IN THIS-PROCEDURE(
     8759                    input loc-goo-doc.gds-code
     8760                    ,INPUT 'emrc-type':U
     8761                    ,INPUT v-attr-emrc ) .
     8762                    END.
     8763                 OTHERWISE DO:
     8764                 loc-goo-doc.grp-code = v-old-code .
     8765                 end.
     8766              END CASE.
     8767           end.
     8768        end.
     8769     END .
     8770   if session :set-wait-state( "compiler" ) then.
     8771     assign
     8772       rid-list = "":U
     8773       mark-num = 0
     8774     .
     8775     if was-deleted > 0 then do:
     8776       message ("Из " + string(lns-cnt - 1) + " товаров удалось перенести в другую группу " +
     8777               string (lns-cnt  - 1 - was-deleted) + chr(44)) skip
     8778               "остальные товары являются неактивными -" skip
     8779               "для них перенос ЗАПРЕЩЕН!"
     8780       view-as alert-box WARNING.
     8781     end.
     8782     hide mark-num in frame d-gob-doc-ref.
     8783     RUN openbr IN THIS-PROCEDURE ( INPUT YES, input yes, input no, input '':U ).
     8784   END PROCEDURE.
     8785   PROCEDURE proc-rs-stat:
     8786   ASSIGN
     8787   FRAME d-gob-doc-ref
     8788   rs-stat
     8789   g-stat = rs-stat
     8790   a-n-c :SCREEN-VALUE = "art"
     8791   .
     8792   APPLY "VALUE-CHANGED":U TO a-n-c IN FRAME d-gob-doc-ref.
     8793   RUN openbr IN THIS-PROCEDURE ( INPUT YES, input yes, input no, input '':U ).
     8794   END PROCEDURE.
     8795   PROCEDURE proc-rs-sort:
     8796   assign
     8797   a-n-c :screen-value in frame d-gob-doc-ref = "art"
     8798   .
     8799   apply "value-changed":U to a-n-c in frame d-gob-doc-ref .
     8800   if rs-sort :screen-value <> 'Артикул':U then do:
     8801     message "При большой товарной номенклатуре" skip
     8802             "по текущему объекту" skip
     8803             "процесс сортировки товаров" skip
     8804             "по выбранному Вами условию" skip
     8805             "может занять длительное время." skip(1)
     8806             "Продолжать ?" skip
     8807             " "
     8808     view-as alert-box INFORMATION buttons YES-NO update g#log .
     8809     if g#log = yes then do:
     8810       assign
     8811         frame d-gob-doc-ref rs-sort
     8812       .
     8813       RUN openbr IN THIS-PROCEDURE ( INPUT NO, input yes, input no, input '':U ).
     8814     end.
     8815     else do:
     8816       assign
     8817         rs-sort :screen-value in frame d-gob-doc-ref = 'Артикул':U
     8818       .
     8819     end.
     8820   end.
     8821   else do:
     8822     assign
     8823       frame d-gob-doc-ref rs-sort
     8824     .
     8825     RUN openbr IN THIS-PROCEDURE ( INPUT NO, input yes, input no, input '':U ).
     8826   end.
     8827   END PROCEDURE.
     8828   PROCEDURE proc-br-gds:
     8829     if b-sel :sensitive in frame d-gob-doc-ref then do:
     8830         apply "choose":U to b-sel in frame d-gob-doc-ref.
     8831     end.
     8832     else do:
     8833       if b-lkp :sensitive then do:
     8834         apply "choose":U to b-lkp in frame d-gob-doc-ref.
     8835       end.
     8836     end.
     8837   END PROCEDURE.
     8838   PROCEDURE proc-b-exit:
     8839     assign
     8840       a-n-c    = "вых":U
     8841       rid-list = ""
     8842     .
     8843   END PROCEDURE.
     8844   PROCEDURE proc-b-sel:
     8845     DEFINE PARAMETER BUFFER loc-goo-doc FOR ub.goods.
     8846     DEFINE PARAMETER BUFFER loc-gob-doc FOR ub.gds-obj.
     8847     if rid-list = "" then do:
     8848       if not available loc-gob-doc then do:   message     "Неправильно выбран товар."   view-as alert-box error.   return no-apply. end. FIND FIRST loc-goo-doc WHERE loc-goo-doc.artic     = loc-gob-doc.artic                          AND loc-goo-doc.prod-type = loc-gob-doc.prod-type                          AND loc-goo-doc.prod-code = loc-gob-doc.prod-code NO-LOCK. assign   gds-rec = recid( loc-goo-doc ) .
     8849       rid-list = string (recid (loc-goo-doc)).
     8850     end.
     8851     assign
     8852       a-n-c = "вых":U
     8853     .
     8854   END PROCEDURE.
     8855   PROCEDURE proc-b-price:
     8856   define input  parameter p-var as integer   no-undo .
     8857   define parameter buffer loc-goo-doc for ub.goods.
     8858   define parameter buffer loc-gob-doc for ub.gds-obj.
     8859   define variable v-fact-order     as decimal no-undo .
     8860   define variable v-plt-id         as integer no-undo .
     8861   define variable v-plt-db-num     as integer no-undo .
     8862   define variable v-pdf-id         as integer no-undo .
     8863   define variable v-pdf-db-num     as integer no-undo .
     8864   define variable v-sale-price-doc as decimal no-undo .
     8865     if not available loc-gob-doc then do:   message     "Неправильно выбран товар."   view-as alert-box error.   return no-apply. end. FIND FIRST loc-goo-doc WHERE loc-goo-doc.artic     = loc-gob-doc.artic                          AND loc-goo-doc.prod-type = loc-gob-doc.prod-type                          AND loc-goo-doc.prod-code = loc-gob-doc.prod-code NO-LOCK. assign   gds-rec = recid( loc-goo-doc ) .
     8866     if p-var = 2 then do:
     8867     run str/chg-sale.w
     8868      ( input parparentproc,
     8869        input p-obj-type ,
     8870        input p-obj-code ,
     8871        BUFFER loc-goo-doc ).
     8872     end.
     8873     else do:
     8874     run str/chmplgds.w
     8875     ( input  parparentproc ,
     8876       input  loc-goo-doc.gds-code ,
     8877       input  p-obj-type    ,
     8878       input  p-obj-code    ,
     8879       input  v-fact-order  ,
     8880       output v-plt-id      ,
     8881       output v-plt-db-num  ,
     8882       output v-pdf-id      ,
     8883       output v-pdf-db-num  ,
     8884       output v-sale-price-doc ).
     8885     end.
     8886     APPLY "ENTRY":U TO br-gds IN FRAME d-gob-doc-ref.
     8887   END PROCEDURE.
     8888   PROCEDURE proc-b-lkp:
     8889   DEFINE PARAMETER BUFFER loc-goo-doc FOR ub.goods.
     8890   DEFINE PARAMETER BUFFER loc-gob-doc FOR ub.gds-obj.
     8891   define variable v-handle as handle no-undo .
     8892   if not available loc-gob-doc then do:   message     "Неправильно выбран товар."   view-as alert-box error.   return no-apply. end. FIND FIRST loc-goo-doc WHERE loc-goo-doc.artic     = loc-gob-doc.artic                          AND loc-goo-doc.prod-type = loc-gob-doc.prod-type                          AND loc-goo-doc.prod-code = loc-gob-doc.prod-code NO-LOCK. assign   gds-rec = recid( loc-goo-doc ) .
     8893   ASSIGN
     8894   gds-rec = RECID( loc-goo-doc )
     8895   v-handle = this-procedure :handle.
     8896   .
     8897   run ref/gds-form.w (
     8898                     INPUT parparentproc
     8899                   , INPUT 'ПРОСМОТР':U
     8900                   , INPUT p-obj-type
     8901                   , INPUT p-obj-code
     8902                   , input v-handle
     8903                   , input-output gds-rec
     8904                   ) .
     8905   APPLY "ENTRY":U TO br-gds IN FRAME d-gob-doc-ref.
     8906   END PROCEDURE.
     8907   PROCEDURE proc-b-prt:
     8908     DEFINE PARAMETER BUFFER loc-goo-doc FOR ub.goods.
     8909     DEFINE PARAMETER BUFFER loc-gob-doc FOR ub.gds-obj.
     8910     if not available loc-gob-doc then do:   message     "Неправильно выбран товар."   view-as alert-box error.   return no-apply. end. FIND FIRST loc-goo-doc WHERE loc-goo-doc.artic     = loc-gob-doc.artic                          AND loc-goo-doc.prod-type = loc-gob-doc.prod-type                          AND loc-goo-doc.prod-code = loc-gob-doc.prod-code NO-LOCK. assign   gds-rec = recid( loc-goo-doc ) .
     8911     define variable v-sel-node-code as integer   no-undo .
     8912     run str/prt-ref.w
     8913       (
     8914          input parparentproc
     8915       ,  input loc-goo-doc.gds-code
     8916       ,  input 'ПРОСМОТР':U
