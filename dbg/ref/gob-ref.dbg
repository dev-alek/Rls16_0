     1637   procedure grp-obj-notcorr-value :
     1638   do
     1639   on error undo, return error
     1640   :
     1641   define input parameter p-node-code             as integer      no-undo.
     1642   define input parameter p-obj-type              as character    no-undo.
     1643   define input parameter p-obj-code              as integer      no-undo.
     1644   define output parameter p-notcorr              as character    no-undo init ?.
     1645   define output parameter p-range-notcorr     as integer      no-undo.
     1646   define output parameter p-exists-notcorr    as logical      no-undo.
     1647   define variable v-host-code as integer      no-undo.
     1648   DEFINE VARIABLE v-found as logical no-undo .
     1649   DEFINE VARIABLE v-exists as logical no-undo .
     1650   DEFINE VARIABLE v-range as integer no-undo .
     1651   DEFINE VARIABLE jj as integer no-undo .
     1652   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     1653   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     1654   define buffer buf_gds-grp for ub.gds-grp.
     1655   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     1656   find first buf_gds-grp no-lock where
     1657              buf_gds-grp.node-code = p-node-code no-error .
     1658   if not avail buf_gds-grp and p-node-code <> 0 then do:
     1659     message
     1660       vss-workfile vss-revision vss-description
     1661       skip "Не удалось найти группу товаров с кодом" p-node-code
     1662       view-as alert-box error .
     1663     undo, return error .
     1664   end.
     1665   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1666   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1667     (input  p-obj-type
     1668     ,input  p-obj-code
     1669     ,output v-host-code
     1670     ) no-error .
     1671   if error-status :error
     1672   then do:
     1673       message
     1674         vss-workfile vss-revision vss-description
     1675         skip "Не удалось найти фирму объекта"
     1676         skip p-obj-type p-obj-code
     1677         skip return-value
     1678         skip trim(error-status :get-message(1))
     1679       view-as alert-box error.
     1680       undo, return error .
     1681   end.
     1682   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     1683   do while v-found = no and jj < 2:
     1684     if v-range <> 3 then do:
     1685       find first buf_gds-grp-obj no-lock
     1686           where buf_gds-grp-obj.node-code = p-node-code
     1687             and buf_gds-grp-obj.host-code = v-host-code
     1688             and buf_gds-grp-obj.obj-type  = p-obj-type
     1689             and buf_gds-grp-obj.obj-code  = p-obj-code
     1690       no-error .
     1691     end.
     1692     if v-range = 3 or not available buf_gds-grp-obj
     1693     then do:
     1694        if v-range <> 2 then do:
     1695           find first buf_gds-grp-obj no-lock
     1696               where buf_gds-grp-obj.node-code = p-node-code
     1697                 and buf_gds-grp-obj.host-code = v-host-code
     1698                 and buf_gds-grp-obj.obj-type  = ""
     1699                 and buf_gds-grp-obj.obj-code  = 0
     1700           no-error .
     1701         end.
     1702         if v-range = 2 or not available buf_gds-grp-obj
     1703         then do:
     1704             if v-range <> 1 then do:
     1705               find first buf_gds-grp-obj no-lock
     1706                   where buf_gds-grp-obj.node-code = p-node-code
     1707                   and buf_gds-grp-obj.host-code = 0
     1708                   and buf_gds-grp-obj.obj-type  = ""
     1709                   and buf_gds-grp-obj.obj-code  = 0
     1710               no-error .
     1711             end.
     1712             if v-range = 1 or not available buf_gds-grp-obj
     1713             then do:
     1714                 assign
     1715                     v-exists = no
     1716                 .
     1717             end.
     1718             else do:
     1719                 assign
     1720                     v-exists = yes
     1721                     v-range = 1
     1722                 .
     1723             end.
     1724         end.
     1725         else do:
     1726             assign
     1727                 v-exists = yes
     1728                 v-range  = 2
     1729             .
     1730         end.
     1731     end.
     1732     else do:
     1733         assign
     1734             v-exists = yes
     1735             v-range  = 3
     1736         .
     1737     end.
     1738     if available buf_gds-grp-obj
     1739     then do:
     1740       find first buf_gds-grp-obj-attr no-lock
     1741         where buf_gds-grp-obj-attr.node-code   = p-node-code
     1742           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     1743           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     1744           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     1745           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     1746         no-error .
     1747       if available buf_gds-grp-obj-attr then do:
     1748         assign
     1749           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     1750         .
     1751       end.
     1752       else do:
     1753         assign
     1754           v-notcorr-value = ?
     1755         .
     1756       end.
     1757       assign
     1758       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     1759                           then yes
     1760                           else p-exists-notcorr)
     1761       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     1762                         then v-range
     1763                         else p-range-notcorr
     1764       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     1765                         then v-notcorr-value
     1766                         else p-notcorr
     1767       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     1768       jj = jj + 1
     1769       .
     1770     end.
     1771     else do:
     1772       assign
     1773       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     1774       jj = jj + 1
     1775       .
     1776     end.
     1777   end.
     1778   end.
     1779   end procedure.
     1780   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1781   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
