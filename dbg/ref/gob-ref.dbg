     5207   END.
     5208   ON MOUSE-SELECT-DBLCLICK OF g-image IN FRAME d-gob-doc-ref
     5209   DO:
     5210       DEFINE VARIABLE v-main-code LIKE ub.bar-code.b-code NO-UNDO.
     5211       RUN ref/imagelist.w (parParentProc, "":U, goo-doc.gds-code, 'ПРОСМОТР':U).
     5212   END.
     5213   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-gob-doc-ref:PARENT eq ?
     5214   THEN FRAME d-gob-doc-ref:PARENT = ACTIVE-WINDOW.
     5215   ON WINDOW-CLOSE OF FRAME d-gob-doc-ref APPLY "END-ERROR":U TO SELF.
     5216   define variable vss-include-info63 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5217   on help of frame d-gob-doc-ref
     5218   do:
     5219     run gbl/app_help.p
     5220       (input this-procedure :file-name
     5221       ,input ''
     5222       ,input ?
     5223       ) no-error.
     5224     if error-status :error then do:
     5225       message
     5226         "Ошибка при вызове помощи"
     5227         error-status :get-message(1)
     5228         view-as alert-box .
     5229     end.
     5230   end.
     5231   run minbtn-set in this-procedure .
     5232   on choose of b-help in frame d-gob-doc-ref
     5233   do:
     5234     apply "help":u to frame d-gob-doc-ref .
     5235   end.
     5236   define variable vss-include-info64 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5237   procedure minbtn-set :
     5238       do
     5239           on error undo, return error return-value
     5240           :
     5241           define variable ii              as integer       no-undo .
     5242           define variable fh              as widget-handle no-undo .
     5243           define variable hh              as widget-handle no-undo .
     5244           define variable v-h             as handle        extent 4 no-undo .
     5245           define variable v-name-button   as character     no-undo .
     5246           define variable v-help-old-x    as decimal       no-undo .
     5247           define variable v-help-old-y    as decimal       no-undo .
     5248           define variable v-help-old-size as decimal       no-undo .
     5249           define variable v-frame-width   as decimal       no-undo .
     5250           define variable jj              as integer       no-undo .
     5251           do
     5252               on error undo, return error
     5253               :
     5254               assign
     5255                   v-frame-width = frame d-gob-doc-ref:width - 0.3
     5256                   fh            = frame d-gob-doc-ref:first-child
     5257                   hh            = fh:first-child
     5258                   ii            = 1
     5259                   .
     5260               do while valid-handle(hh):
     5261                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     5262                   do:
     5263                       case lc(hh:name) :
     5264                           when "b-help" then
     5265                               do:
     5266                                   hh:load-image-up("cmp/b-help.bmp":u) .
     5267                                   hh:load-image-down("cmp/b-help.bmp":u) .
     5268                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     5269                                   hh:TOOLTIP = "Помощь" .
     5270                                   v-help-old-x = hh:column .
     5271                                   v-help-old-y = hh:row    .
     5272                                   v-help-old-size = hh:width .
     5273                                   hh:width-chars = 2.5 .
     5274                               end.
     5275                           when "b-print" then
     5276                               do:
     5277                                   hh:load-image("cmp/b-print.bmp":u) .
     5278                                   hh:TOOLTIP = "Печать" .
     5279                                   v-h[ii] = hh:handle .
     5280                                   ii = ii + 1 .
     5281                                   hh:width-chars = 3 .
     5282                               end.
     5283                           when "b-history" or
     5284                           when "b-hist" then
     5285                               do:
     5286                                   hh:load-image("cmp/b-hist.bmp":u) .
     5287                                   hh:TOOLTIP = "История" .
     5288                                   v-h[ii] = hh:handle .
     5289                                   ii = ii + 1 .
     5290                                   hh:width-chars = 3 .
     5291                               end.
     5292                           when "b-sch" then
     5293                               do:
     5294                                   hh:load-image("cmp/b-sch.bmp":u) .
     5295                                   hh:TOOLTIP = "Установка Фильтра" .
     5296                                   v-h[ii] = hh:handle .
     5297                                   ii = ii + 1 .
     5298                                   hh:width-chars = 3 .
     5299                               end.
     5300                           when "b-hist-user" then
     5301                               do:
     5302                                   hh:load-image("cmp/b-hist.bmp":u) .
     5303                                   hh:TOOLTIP = "История пользователя" .
     5304                                   ii = ii + 1 .
     5305                               end.
     5306                       end case.
     5307                   end.
     5308                   hh = hh:next-sibling.
     5309               end.
     5310               b-help:column = v-frame-width - b-help:width-chars.
     5311               jj = 0.
     5312               repeat ii = 4 to 1 by -1 :
     5313                   if valid-handle (v-h[ii] ) then
     5314                   do:
     5315                       jj  = jj + 1 .
     5316                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     5317                       v-h[ii]:row    = v-help-old-y .
     5318                   end.
     5319               end.
     5320           end.
     5321       end.
     5322   end procedure.
     5323   define variable vss-include-info65 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     5324   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     5325   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     5326   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     5327   define variable v-diasize-current-frame-width  as decimal   no-undo .
     5328   define variable v-diasize-current-frame-height as decimal   no-undo .
     5329   define variable v-diasize-change-size          as logical   no-undo .
     5330   define variable v-diasize-resize-button        as handle    no-undo .
     5331   define variable v-diasize-wndmax               as logical   no-undo .
     5332   define variable v-diasize-wndstore             as logical   no-undo .
     5333   define variable v-diasize-proc-name            as character no-undo .
     5334   define variable v-diasize-browse-handle        as handle    no-undo .
     5335   define variable v-diasize-browse-number        as integer   no-undo .
     5336   define variable v-diasize-need-full-display    as logical   no-undo init false .
     5337   define temp-table temp-diasize-handle no-undo
     5338     field handle-value  as handle
     5339     field save-position as decimal
     5340     index xpk is primary unique handle-value
     5341     .
     5342   define temp-table temp-browse-handle no-undo
     5343     field browse-type   as character
     5344     field browse-number as integer
     5345     field browse-handle as handle
     5346     field original-size as decimal
     5347     index xpk is primary unique browse-type browse-number
     5348     index xie browse-type browse-handle
     5349   .
     5350   procedure diasize_change-height :
     5351     define input  parameter p-change-value  as decimal   no-undo .
     5352     define input  parameter p-move-resize   as logical   no-undo .
     5353     define variable v-field-group-handle    as handle    no-undo .
     5354     define variable v-object-handle         as handle    no-undo .
     5355     define variable v-frame-height          as decimal   no-undo .
     5356     define variable v-frame-virtual-height  as decimal   no-undo .
     5357     define variable v-browse-height         as decimal   no-undo .
     5358     define variable v-window-height         as decimal   no-undo .
     5359     define variable v-window-virtual-height as decimal   no-undo .
     5360     define variable v-change-sign           as integer   no-undo .
     5361     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     5362     define buffer buf_temp-browse-handle  for temp-browse-handle .
     5363     if p-change-value > 0
     5364     then do:
     5365       if frame d-gob-doc-ref :height + p-change-value
     5366           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     5367       then do:
     5368         assign
     5369           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     5370                           - (frame d-gob-doc-ref :height-chars)
     5371         .
     5372         if p-change-value <= 0
     5373         then do:
     5374           run diasize_position-resize-button in this-procedure .
     5375           return .
     5376         end.
     5377       end.
     5378     end.
     5379     if p-change-value < 0
     5380     then do:
     5381       if frame d-gob-doc-ref :height + p-change-value < v-diasize-orig-frame-height
     5382       then do:
     5383         assign
     5384           p-change-value = v-diasize-orig-frame-height
     5385                          - (frame d-gob-doc-ref :height-chars)
     5386         .
     5387         if p-change-value >= 0
     5388         then do:
     5389           run diasize_position-resize-button in this-procedure .
     5390           return .
     5391         end.
     5392       end.
     5393     end.
     5394     if p-change-value >= 0
     5395     then do:
     5396       assign
     5397         v-change-sign = 1
     5398       .
     5399     end.
     5400     else do:
     5401       assign
     5402         v-change-sign = -1
     5403       .
     5404     end.
     5405     assign
     5406       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     5407     .
     5408     if p-change-value = 0
     5409     then do:
     5410       run diasize_position-resize-button in this-procedure .
     5411       return .
     5412     end.
     5413     move_block:
     5414     do
     5415     on error undo move_block, retry move_block
     5416     :
     5417       if retry
     5418       then do:
     5419         do
     5420         on error undo move_block, leave move_block
     5421         :
     5422           if p-change-value > 0
     5423           then do:
     5424             for each buf_temp-diasize-handle
     5425             on error undo, next
     5426             :
     5427               assign
     5428                 v-object-handle = buf_temp-diasize-handle.handle-value
     5429               .
     5430               if v-object-handle <> v-diasize-resize-button
     5431               then do:
     5432                 assign
     5433                   v-object-handle :row = buf_temp-diasize-handle.save-position
     5434                 .
     5435               end.
     5436             end.
     5437             assign
     5438               v-diasize-browse-handle :height = v-browse-height
     5439             .
     5440             for each buf_temp-browse-handle
     5441               where buf_temp-browse-handle.browse-type = 'height':u
     5442             on error undo, next
     5443             :
     5444               assign
     5445                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     5446               .
     5447             end.
     5448             assign
     5449               frame d-gob-doc-ref :height = v-frame-height
     5450             .
     5451             if frame d-gob-doc-ref :scrollable = true
     5452             then do:
     5453               assign
     5454                 frame d-gob-doc-ref :virtual-height = v-frame-virtual-height
     5455               .
     5456             end.
     5457             run diasize_position-resize-button in this-procedure .
     5458           end.
     5459           else do:
     5460             if frame d-gob-doc-ref :scrollable = true
     5461             then do:
     5462               assign
     5463                 frame d-gob-doc-ref :virtual-height = v-frame-virtual-height
     5464               .
     5465             end.
     5466             assign
     5467               frame d-gob-doc-ref :height = v-frame-height
     5468             .
     5469             assign
     5470               v-diasize-browse-handle :height = v-browse-height
     5471             .
