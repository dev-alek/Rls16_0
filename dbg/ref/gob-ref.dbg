     8244   PROCEDURE b-copy-proc:
     8245     DEFINE PARAMETER BUFFER loc-goo-doc FOR ub.goods.
     8246     DEFINE PARAMETER BUFFER loc-gob-doc FOR ub.gds-obj.
     8247       assign
     8248         gds-rec  = recid( loc-goo-doc )
     8249         copymode = yes
     8250       .
     8251       CASE loc-goo-doc.gds-type:
     8252         when 'т':U then do:
     8253           apply "choose":U to b-add in frame d-gob-doc-ref.
     8254         end.
     8255         when  'у':U then do:
     8256           apply "choose":U to b-add-office in frame d-gob-doc-ref.
     8257         end.
     8258       END CASE.
     8259       assign
     8260         copymode = no
     8261       .
     8262   END.
