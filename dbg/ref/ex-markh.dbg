        1   DEFINE BUFFER buf_ex-mark FOR ub.ex-mark.
        2   DEFINE BUFFER x_c-ex-mark FOR ub.c-ex-mark.
        3   DEFINE BUFFER x_ex-mark FOR ub.ex-mark.
        4   define input  parameter parParentProc   as widget-handle  no-undo .
        5   define input  parameter p-ex-mark-rowid as rowid          no-undo .
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "История акцизных и спец марок".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   procedure proc-alt-shift-f2:
       71     if not ibs.th.gbl.gbl-var:rcode
       72   then
       73     run gbl\inidebug.p .
       74   end.
       75   procedure proc-alt-shift-f3:
       76     run gbl/prvssinf.p
       77       ( input this-procedure
       78       ) .
       79   end.
       80   define variable v-inform-launched as logical no-undo initial false .
       81   procedure proc-alt-shift-f4:
       82     define variable v-action as character no-undo .
       83     if v-inform-launched = false then do:
       84       assign
       85         v-inform-launched = true
       86       .
       87       run gbl/d-inform.w
       88         (  input self
       89         ,  input this-procedure
       90         , output v-action
       91         ) no-error .
       92       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       93       assign
       94         v-inform-launched = false
       95       .
       96     end.
       97   end.
       98   procedure proc-alt-f1:
       99     run gbl/corrhelp.p
      100       (input this-procedure
      101       ) .
      102   end .
      103   on alt-shift-f2 anywhere do:
      104     run proc-alt-shift-f2.
      105   end.
      106   on alt-shift-f3 anywhere do:
      107     run proc-alt-shift-f3 in this-procedure .
      108   end.
      109   on alt-shift-f4 anywhere do:
      110     run proc-alt-shift-f4 in this-procedure.
      111   end.
      112   on alt-f1 anywhere do:
      113     run proc-alt-f1 in this-procedure .
      114   end.
      115   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      116   define variable v-waitfram-action01         as character   no-undo .
      117   define variable v-waitfram-action02         as character   no-undo .
      118   define variable v-waitfram-action03         as character   no-undo .
      119   define variable mWaitFramTextBeg            as character   no-undo.
      120   define variable mWaitFramTextEnd            as character   no-undo.
      121   define variable mWaitFramView               as logical     no-undo.
      122   define variable mWaitProcEvent              as logical     no-undo init yes.
      123   define variable mWaitFramInterval           as integer     no-undo init 1 .
      124   define variable mWaitFramStop               as logical     no-undo.
      125   define variable mWaitFramStopUser           as logical     no-undo.
      126   define variable mWaitFramStopTimeOut        as logical     no-undo.
      127   define variable mWaitFramStartProc          as datetime-tz no-undo.
      128   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      129   define button B-WaitFramStop auto-end-key
      130        label "Стоп"
      131        size 10 by 1 tooltip "Остоновить процесс".
      132   define button B-viewProcInfo
      133        label "Информация"
      134        size 15 by 1 tooltip "Информация о процесс".
      135   define frame waitfram
      136     v-waitfram-action01 format "x(72)" no-label skip
      137     v-waitfram-action02 format "x(72)" no-label skip
      138     v-waitfram-action03 format "x(72)" no-label skip
      139     B-viewProcInfo
      140     B-WaitFramStop at row 4 col 30
      141     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      142     .
      143   define new global shared variable mBatchMode as logical no-undo init ?.
      144   define variable mFramBachModHandle as handle no-undo.
      145   mFramBachModHandle = frame waitfram:handle.
      146   define variable mFameOldVis as logical no-undo.
      147   define variable mVisCUrentVin as logical no-undo.
      148   if session:batch-mode
      149   then
      150      mBatchMode = yes.
      151   if mBatchMode = ? then do:
      152     mVisCUrentVin = current-window:visible.
      153     mFameOldVis = mFramBachModHandle:visible.
      154     mFramBachModHandle:visible  = yes.
      155     mBatchMode = mFramBachModHandle:visible ne yes.
      156     mFramBachModHandle:visible = mFameOldVis.
      157     current-window:visible = mVisCUrentVin.
      158   end.
      159    if  log-manager:logfile-name ne ?
      160     then DO:
      161         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      162         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      163         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      164     end.
      165   on choose of B-WaitFramStop in frame waitfram
      166   do:
      167     mWaitFramStop = yes.
      168     mWaitFramStopUser = yes.
      169   end.
      170   function waitfram-check-timeout returns logical():
      171      define variable vtime as int64 no-undo.
      172      if mWaitFramStopTimeOut
      173      then
      174         return yes.
      175      vtime = ( now - mWaitFramStartProc ) / 1000 .
      176      if     mWaitFramTimeOut ne ?
      177         and mWaitFramTimeOut ne 0
      178         and mWaitFramTimeOut lt vtime
      179      then do:
      180         mWaitFramStopTimeOut = yes.
      181      end.
      182      return mWaitFramStopTimeOut.
      183   end.
      184   procedure waitfram-hide :
      185     if not session:batch-mode
      186     then do
      187     on error undo, return error return-value
      188     :
      189       pause 0 before-hide .
      190       if not mBatchMode then
      191         hide frame waitfram .
      192     if     not mWaitFramView
      193        and mWaitProcEvent
      194     then
      195       process events .
      196     end.
      197   end procedure.
      198   procedure waitfram-show :
      199     define input  parameter p-message as character no-undo .
      200     define variable v-left-margin as integer   no-undo .
      201     if not session:batch-mode
      202     then do
      203     on error undo, return error return-value
      204     :
      205       if length(p-message) <= 70 then do:
      206         assign
      207           v-left-margin = integer((70 - length(p-message)) / 2)
      208         .
      209         assign
      210           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      211         .
      212         assign
      213           v-waitfram-action01 = " "
      214           v-waitfram-action02 = " "
      215                                    + fill(" ", v-left-margin)
      216                                    + p-message
      217           v-waitfram-action03 = " "
      218         .
      219       end.
      220       else do:
      221         define variable vRindex1 as integer no-undo.
      222         define variable vRindex2 as integer no-undo.
      223         vRindex1 = r-index(p-message," ",70).
      224         if vRindex1 = 0
      225         then
      226            vRindex1 = 70.
      227         if length(p-message)  <= vRindex1 + 70 then do:
      228           assign
      229             v-waitfram-action01 = " "
      230             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      231             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      232           .
      233         end.
      234         else do:
      235           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      236           if vRindex2 <= vRindex1
      237           then
      238              vRindex2 = vRindex1 + 70.
      239           assign
      240             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      241             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      242             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      243           .
      244         end.
      245       end.
      246       B-viewProcInfo:visible   in frame waitfram = no.
      247       B-viewProcInfo:sensitive in frame waitfram = no.
      248       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      249       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      250       if  (   mWaitFramView
      251          or  mWaitProcEvent)
      252          and not mBatchMode
      253       then
      254          display
      255             v-waitfram-action01 skip
      256             v-waitfram-action02 skip
      257             v-waitfram-action03 skip
      258          with frame waitfram .
      259       if     mWaitFramView
      260          then do:
      261             if     mWaitFramInterval ne ?
      262                and not mBatchMode
      263             then
      264                wait-for go of frame waitfram pause mWaitFramInterval.
      265          end.
      266          else
      267             if     mWaitProcEvent
      268                and not mBatchMode
      269             then
      270                process events .
      271     end.
      272   end procedure.
      273      procedure waitfram-show-this:
      274         define input  parameter iInterval as int64 no-undo.
      275         define variable vtime as int64 no-undo.
      276         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      277         mWaitFramInterval = iInterval.
      278         run waitfram-show (substitute("&1&2 &3&4" ,
      279                                       mWaitFramTextBeg ,
      280                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      281                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      282                                       mWaitFramTextEnd
      283                                      )
      284                           ).
      285      end.
      286      procedure WaitFramRunPause:
      287         define input  parameter iInterval as dec no-undo.
      288         define variable vStart  as datetime-tz no-undo.
      289         define variable vend    as datetime-tz no-undo.
      290         define variable vint as int64 no-undo.
      291         define variable vOk as logical no-undo.
      292         vStart = now.
      293         vend   = vStart.
      294         publish "WaitFramPause" (iInterval,output vOk).
      295         vend   =  now.
      296         vint = vend - vStart.
      297         vint = iInterval - vint / 1000.
      298         if     not mWaitFramStop
      299            and (   vint > 0
      300                 or (    not vOk
      301                     and iInterval eq ?
      302                     )
      303                 )
      304         then
      305            run waitfram-show-this (iInterval).
      306         vend   =  now.
      307         vint = vend - vStart.
      308         vint = iInterval - vint / 1000.
      309         if     not mWaitFramStop
      310            and vint > 0
      311         then do:
      312            run gbl/pause.p (vint * 1000).
      313         end.
      314         if iInterval ne ?
      315         then
      316            publish "WaitFramStop".
      317         waitfram-check-timeout().
      318      end.
      319      procedure WaitFramWaitFor:
      320         define input  parameter iInterval as dec no-undo.
      321         assign
      322            mWaitFramStartProc   = now
      323            mWaitFramStopUser    = no
      324            mWaitFramStopTimeOut = no
      325         .
      326         block-wait:
      327         do while not mWaitFramStop:
      328            run WaitFramRunPause (iInterval).
      329            if  waitfram-check-timeout()
      330            then do:
      331               leave block-wait.
      332            end.
      333         end.
      334         run waitfram-hide.
      335      end.
      336   procedure waitfram-join :
      337     define input  parameter p-line-1  as character no-undo .
      338     define input  parameter p-line-2  as character no-undo .
      339     define input  parameter p-line-3  as character no-undo .
      340     define output parameter p-message as character no-undo .
      341     do
      342     on error undo, return error return-value
      343     :
      344       assign
      345         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      346                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      347                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      348       .
      349     end.
      350   end procedure.
      351   function waitfram-join-function returns character
      352     (input p-line-1 as character
      353     ,input p-line-2 as character
      354     ,input p-line-3 as character
      355     ).
      356     define variable v-message as character no-undo .
      357     run waitfram-join in this-procedure
      358       (input  p-line-1
      359       ,input  p-line-2
      360       ,input  p-line-3
      361       ,output v-message
      362       ) .
      363     return v-message .
      364   end function .
      365   define new global shared variable g#library  as handle no-undo .
      366   define new global shared variable g#library2 as handle no-undo .
      367   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      368   function usrfulnf returns character ( input p-user-id as character):
      369   define variable v-user-name as character no-undo .
      370   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      371   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      372     (input  p-user-id
      373     ,output v-user-name
      374     ) no-error .
      375   if error-status:error
      376   or v-user-name = ""
      377   then do:
      378     return p-user-id.
      379   end.
      380   else do:
      381     return v-user-name.
      382   end.
      383   end function.
      384   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      385   function exmrklib_get-type-name returns character
      386     ( input p-mark-type as integer ) :
      387     define variable ret    as character no-undo .
      388     case p-mark-type:
      389         when 0 then ret = "Специальная".
      390         when 1 then ret = "Акцизная".
      391         otherwise   ret = "<неизвестен>".
      392     end case.
      393     return ret .
      394   end function.
      395   function exmrklib_get-status-name returns character
      396     ( input p-stts as integer ) :
      397     return entry (lookup (string(p-stts), '0,1,50,99':U), 'тек,удал,блок,удаление':U) .
      398   end function.
      399   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      400   define  temp-table temp-changes no-undo
      401   field f_name as character
      402   field l_name as character
      403   field v_old as character
      404   field v_new as character
      405   field t_name as character
      406   field num_ as integer
      407   field uniq-key-rec as character
      408   field action as integer
      409   field fNotChange as logical
      410   index pi is unique primary
      411   num_
      412   t_name
      413   f_name
      414   index
      415   Chan
      416   fnotChange
      417   t_name
      418   f_name
      419   index imain uniq-key-rec
      420   .
      421   FUNCTION get-all-fields returns character (p-file-name as character ):
      422   define variable v-dop as character no-undo .
      423     find first _file no-lock where _file._file-name = p-file-name no-error .
      424     if not available _file then return "":U.
      425     for each _field no-lock where
      426              _field._file-recid = recid(_file) :
      427       assign
      428       v-dop = v-dop + _field._field-name + chr(44)
      429       .
      430     end.
      431     return trim(v-dop).
      432   END FUNCTION.
      433   PROCEDURE proc-full-temp-changes :
      434     define input  parameter p-hst-handle as handle    no-undo .
      435     define input  parameter p-main-table as character no-undo .
      436     define input  parameter p-field-list as character no-undo .
      437     define input  parameter p-label-form as character no-undo .
      438     define variable h-new-buf         as handle    no-undo .
      439     define variable h-main-buf        as handle    no-undo .
      440     define variable h-for-comp        as handle    no-undo .
      441     define variable v-inform          as character no-undo .
      442     define variable v-ind             as integer   no-undo .
      443     define variable v-idx-field-qnty  as integer   no-undo .
      444     define variable v-num-entries     as integer   no-undo .
      445     define variable fh                as handle    no-undo .
      446     define variable fh-main           as handle    no-undo .
      447     define variable fh-old            as handle    no-undo .
      448     define variable fh-new            as handle    no-undo .
      449     define variable v-field-name      as character no-undo .
      450     define variable v-field-lvl       as character no-undo .
      451     define variable v-field-form      as character no-undo .
      452     define variable v-search-exp      as character no-undo .
      453     define variable v-srch-main       as character no-undo .
      454     define variable v-word-link       as character no-undo .
      455     define variable v-av-chip-num     as logical   no-undo .
      456     define variable v-main-pi-fld-lst as character no-undo .
      457     define variable v-main-fld-lst    as character no-undo .
      458     define variable v-delim-list      as character no-undo .
      459     define variable v-label           as character no-undo .
      460     define variable v-old-value       as character no-undo case-sensitive.
      461     define variable v-new-value       as character no-undo case-sensitive.
      462     define variable v-chg-fields as character no-undo.
      463     for each temp-changes:
      464       delete temp-changes.
      465     end.
      466     if not p-hst-handle:available then do:
      467       return .
      468     end.
      469     create buffer h-new-buf  for table p-hst-handle .
      470     create buffer h-main-buf for table p-main-table .
      471     assign
      472       v-inform = h-main-buf:index-information(1)
      473       v-ind    = 2
      474     .
      475     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      476     on error undo, return error
      477     :
      478       assign
      479         v-inform = h-main-buf:index-information( v-ind )
      480         v-ind    = v-ind + 1
      481       .
      482     end.
      483     if v-inform = ?
      484       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      485       or entry( 3, v-inform, ",":U ) <> "1":U
      486     then do:
      487       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      488     end.
      489     assign
      490       v-idx-field-qnty = num-entries( v-inform ) - 4
      491     .
      492     if v-idx-field-qnty < 2 then do:
      493       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      494     end.
      495     assign
      496       v-srch-main   = "where":U
      497       v-word-link   = "":U
      498       v-av-chip-num = false
      499       v-delim-list  = "":U
      500     .
      501     do v-ind = 1 to v-idx-field-qnty by 2
      502     on error undo, return error
      503     :
      504       assign
      505         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      506         fh                = p-hst-handle:buffer-field( v-field-name )
      507         fh-main           = h-main-buf:buffer-field( v-field-name )
      508         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      509         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      510       .
      511       if fh:data-type ="character":U then do:
      512         assign
      513           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      514         .
      515       end.
      516       else do:
      517         assign
      518           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      519         .
      520       end.
      521       if v-delim-list = "":U then do:
      522         assign
      523           v-delim-list = ",":U
      524         .
      525       end.
      526       if v-word-link = "":U then do:
      527         assign
      528           v-word-link = "and":U
      529         .
      530       end.
      531     end.
      532     assign
      533       v-delim-list  = "":U
      534     .
      535     do v-ind = 1 to h-main-buf:num-fields
      536     on error undo, return error
      537     :
      538       assign
      539         fh-main      = h-main-buf:buffer-field( v-ind )
      540         v-field-name = fh-main:name
      541       .
      542         assign
      543           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      544         .
      545         if v-delim-list = "":U then do:
      546           assign
      547             v-delim-list = ",":U
      548           .
      549         end.
      550     end.
      551     assign
      552       v-inform = p-hst-handle:index-information(1)
      553       v-ind    = 2
      554     .
      555     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      556     on error undo, return error
      557     :
      558       assign
      559         v-inform = p-hst-handle:index-information( v-ind )
      560         v-ind    = v-ind + 1
      561       .
      562     end.
      563     if v-inform = ?
      564       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      565       or entry( 3, v-inform, ",":U ) <> "1":U
      566     then do:
      567       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      568     end.
      569     assign
      570       v-idx-field-qnty = num-entries( v-inform ) - 4
      571     .
      572     if v-idx-field-qnty < 2 then do:
      573       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      574     end.
      575     assign
      576       v-search-exp  = "where":U
      577       v-word-link   = "":U
      578       v-av-chip-num = false
      579     .
      580     do v-ind = 1 to v-idx-field-qnty by 2
      581     on error undo, return error
      582     :
      583       assign
      584         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      585         fh           = p-hst-handle:buffer-field( v-field-name )
      586         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      587       .
      588       if v-field-name = "chip-num":U then do:
      589         assign
      590           v-search-exp  = substitute( "&1 >", v-search-exp )
      591           v-av-chip-num = true
      592         .
      593       end.
      594       else do:
      595         assign
      596           v-search-exp = substitute( "&1 =", v-search-exp )
      597         .
      598       end.
      599       if fh:data-type ="character":U then do:
      600         assign
      601           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      602         .
      603       end.
      604       else do:
      605         assign
      606           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
      607         .
      608       end.
      609       if v-word-link = "":U then do:
      610         assign
      611           v-word-link = "and":U
      612         .
      613       end.
      614     end.
      615     if v-av-chip-num = false then do:
      616       message
      617         vss-workfile vss-revision vss-description skip
      618         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
      619         "Использование данной процедуры невозможно!" skip
      620         view-as alert-box error .
      621       return error .
      622     end.
      623     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
      624     if not h-new-buf:available then do:
      625       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
      626       if not h-main-buf:available then do:
      627         assign
      628           h-for-comp = ?
      629         .
      630       end.
      631       else do:
      632         assign
      633           h-for-comp = h-main-buf
      634         .
      635       end.
      636     end.
      637     else do:
      638       assign
      639         h-for-comp = h-new-buf
      640       .
      641     end.
      642     assign
      643       v-num-entries = num-entries( v-main-fld-lst, ",":U )
      644     .
      645     do v-ind = 1 to v-num-entries
      646     on error undo, return error return-value
      647     :
      648       assign
      649         v-field-name = entry( v-ind, v-main-fld-lst )
      650         fh-old       = p-hst-handle:buffer-field( v-field-name )
      651         v-old-value  = fh-old:buffer-value()
      652         v-label      = trim( fh-old:label )
      653       .
      654       if ( trim( p-field-list ) <> "":U
      655            and lookup( v-field-name, p-field-list ) > 0
      656          )
      657          or trim( p-field-list ) = "":U
      658       then do:
      659         if h-for-comp <> ? then do:
      660           assign
      661             fh-new      = h-for-comp:buffer-field( v-field-name )
      662             v-new-value = fh-new:buffer-value()
      663           .
      664         end.
      665         else do:
      666           assign
      667             v-new-value = "":U
      668           .
      669         end.
      670         if v-old-value <> v-new-value
      671         then do:
      672           create temp-changes.
      673           assign
      674             temp-changes.t_name = p-main-table
      675             temp-changes.f_name = v-field-name
      676             temp-changes.l_name = replace( v-label, "&":U, "":U )
      677             temp-changes.v_old  = trim( v-old-value )
      678             temp-changes.v_new  = trim( v-new-value )
      679             temp-changes.num_   = 0
      680             temp-changes.fNotChange = v-old-value eq v-new-value
      681           .
      682         end.
      683       end.
      684     end.
      685     assign
      686       v-num-entries = num-entries( p-label-form, chr(8) )
      687     .
      688     do v-ind = 1 to v-num-entries
      689     on error undo, return error return-value
      690     :
      691       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
      692         assign
      693           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      694           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      695           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      696         .
      697         find first temp-changes
      698           where temp-changes.f_name = v-field-name
      699           no-error .
      700         if available temp-changes then do:
      701           if trim( v-field-lvl ) <> "":U then do:
      702             assign
      703               temp-changes.l_name = v-field-lvl
      704             .
      705           end.
      706           if trim( v-field-form ) <> "":U then do:
      707             assign
      708               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
      709             .
      710             if h-for-comp <> ? then do:
      711               assign
      712                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
      713               .
      714             end.
      715           end.
      716         end.
      717       end.
      718       else do:
      719         message
      720           vss-workfile vss-revision vss-description skip
      721           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
      722           substitute( "список для поля '&1': '&2'"
      723                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
      724                       ,entry( v-ind, p-label-form, chr(8) )
      725                     ) skip
      726           substitute( "полный список: &2", p-label-form ) skip
      727           view-as alert-box error .
      728       end.
      729     end.
      730     delete object h-new-buf .
      731     delete object h-main-buf .
      732   END PROCEDURE.
      733   define variable v-curr-rowid  as rowid     no-undo .
      734   DEFINE BUTTON b-exit AUTO-GO
      735        LABEL "&Выход"
      736        SIZE 10 BY 1
      737        BGCOLOR 8 .
      738   DEFINE BUTTON b-help
      739        LABEL "Помо&щь"
      740        SIZE 10 BY 1
      741        BGCOLOR 8 .
      742   DEFINE QUERY br-c-ex-mark FOR
      743         x_c-ex-mark SCROLLING.
      744   DEFINE QUERY br-changes FOR
      745         temp-changes SCROLLING.
      746   DEFINE BROWSE br-c-ex-mark
      747     QUERY br-c-ex-mark NO-LOCK DISPLAY
      748         usrfulnf(x_c-ex-mark.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(25)":U
      749               WIDTH 25
      750         x_c-ex-mark.corr-date FORMAT "99/99/9999":U
      751         string( x_c-ex-mark.corr-time, "hh:mm:ss" ) COLUMN-LABEL "Время" FORMAT "X(8)":U
      752         x_c-ex-mark.corr-user-db-num FORMAT ">>>>9":U WIDTH 10
      753       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 12 FIT-LAST-COLUMN.
      754   DEFINE BROWSE br-changes
      755     QUERY br-changes DISPLAY
      756         temp-changes.l_name   COLUMN-LABEL "Изменилось" format "X(20)"
      757         temp-changes.v_old    COLUMN-LABEL "Было"       format "X(30)"
      758         temp-changes.v_new    COLUMN-LABEL "Стало"      format "X(30)"
      759       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 6 FIT-LAST-COLUMN.
      760   DEFINE FRAME Dialog-Frame
      761        b-exit AT ROW 1 COL 1
      762        b-help AT ROW 1 COL 86
      763        br-c-ex-mark AT ROW 3 COL 1 WIDGET-ID 200
      764        br-changes AT ROW 16 COL 1 WIDGET-ID 300
      765       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      766            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      767            TITLE "История"
      768            DEFAULT-BUTTON b-exit WIDGET-ID 100.
      769   ASSIGN
      770          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      771          FRAME Dialog-Frame:HIDDEN           = TRUE.
      772   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      773   DO:
      774     APPLY "END-ERROR":U TO SELF.
      775   END.
      776   ON CHOOSE OF b-help IN FRAME Dialog-Frame
      777   OR HELP OF FRAME Dialog-Frame
      778   DO:
      779   END.
      780   ON VALUE-CHANGED OF br-c-ex-mark IN FRAME Dialog-Frame
      781   DO:
      782     RUN proc-view-changes IN THIS-PROCEDURE.
      783   END.
      784   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      785   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      786   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      787   on help of frame Dialog-Frame
      788   do:
      789     run gbl/app_help.p
      790       (input this-procedure :file-name
      791       ,input ''
      792       ,input ?
      793       ) no-error.
      794     if error-status :error then do:
      795       message
      796         "Ошибка при вызове помощи"
      797         error-status :get-message(1)
      798         view-as alert-box .
      799     end.
      800   end.
      801   run minbtn-set in this-procedure .
      802   on choose of b-help in frame Dialog-Frame
      803   do:
      804     apply "help":u to frame Dialog-Frame .
      805   end.
      806   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      807   procedure minbtn-set :
      808       do
      809           on error undo, return error return-value
      810           :
      811           define variable ii              as integer       no-undo .
      812           define variable fh              as widget-handle no-undo .
      813           define variable hh              as widget-handle no-undo .
      814           define variable v-h             as handle        extent 4 no-undo .
      815           define variable v-name-button   as character     no-undo .
      816           define variable v-help-old-x    as decimal       no-undo .
      817           define variable v-help-old-y    as decimal       no-undo .
      818           define variable v-help-old-size as decimal       no-undo .
      819           define variable v-frame-width   as decimal       no-undo .
      820           define variable jj              as integer       no-undo .
      821           do
      822               on error undo, return error
      823               :
      824               assign
      825                   v-frame-width = frame Dialog-Frame:width - 0.3
      826                   fh            = frame Dialog-Frame:first-child
      827                   hh            = fh:first-child
      828                   ii            = 1
      829                   .
      830               do while valid-handle(hh):
      831                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      832                   do:
      833                       case lc(hh:name) :
      834                           when "b-help" then
      835                               do:
      836                                   hh:load-image-up("cmp/b-help.bmp":u) .
      837                                   hh:load-image-down("cmp/b-help.bmp":u) .
      838                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      839                                   hh:TOOLTIP = "Помощь" .
      840                                   v-help-old-x = hh:column .
      841                                   v-help-old-y = hh:row    .
      842                                   v-help-old-size = hh:width .
      843                                   hh:width-chars = 2.5 .
      844                               end.
      845                           when "b-print" then
      846                               do:
      847                                   hh:load-image("cmp/b-print.bmp":u) .
      848                                   hh:TOOLTIP = "Печать" .
      849                                   v-h[ii] = hh:handle .
      850                                   ii = ii + 1 .
      851                                   hh:width-chars = 3 .
      852                               end.
      853                           when "b-history" or
      854                           when "b-hist" then
      855                               do:
      856                                   hh:load-image("cmp/b-hist.bmp":u) .
      857                                   hh:TOOLTIP = "История" .
      858                                   v-h[ii] = hh:handle .
      859                                   ii = ii + 1 .
      860                                   hh:width-chars = 3 .
      861                               end.
      862                           when "b-sch" then
      863                               do:
      864                                   hh:load-image("cmp/b-sch.bmp":u) .
      865                                   hh:TOOLTIP = "Установка Фильтра" .
      866                                   v-h[ii] = hh:handle .
      867                                   ii = ii + 1 .
      868                                   hh:width-chars = 3 .
      869                               end.
      870                           when "b-hist-user" then
      871                               do:
      872                                   hh:load-image("cmp/b-hist.bmp":u) .
      873                                   hh:TOOLTIP = "История пользователя" .
      874                                   ii = ii + 1 .
      875                               end.
      876                       end case.
      877                   end.
      878                   hh = hh:next-sibling.
      879               end.
      880               b-help:column = v-frame-width - b-help:width-chars.
      881               jj = 0.
      882               repeat ii = 4 to 1 by -1 :
      883                   if valid-handle (v-h[ii] ) then
      884                   do:
      885                       jj  = jj + 1 .
      886                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      887                       v-h[ii]:row    = v-help-old-y .
      888                   end.
      889               end.
      890           end.
      891       end.
      892   end procedure.
      893   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      894   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      895   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      896   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      897   define variable v-diasize-current-frame-width  as decimal   no-undo .
      898   define variable v-diasize-current-frame-height as decimal   no-undo .
      899   define variable v-diasize-change-size          as logical   no-undo .
      900   define variable v-diasize-resize-button        as handle    no-undo .
      901   define variable v-diasize-wndmax               as logical   no-undo .
      902   define variable v-diasize-wndstore             as logical   no-undo .
      903   define variable v-diasize-proc-name            as character no-undo .
      904   define variable v-diasize-browse-handle        as handle    no-undo .
      905   define variable v-diasize-browse-number        as integer   no-undo .
      906   define variable v-diasize-need-full-display    as logical   no-undo init false .
      907   define temp-table temp-diasize-handle no-undo
      908     field handle-value  as handle
      909     field save-position as decimal
      910     index xpk is primary unique handle-value
      911     .
      912   define temp-table temp-browse-handle no-undo
      913     field browse-type   as character
      914     field browse-number as integer
      915     field browse-handle as handle
      916     field original-size as decimal
      917     index xpk is primary unique browse-type browse-number
      918     index xie browse-type browse-handle
      919   .
      920   procedure diasize_change-height :
      921     define input  parameter p-change-value  as decimal   no-undo .
      922     define input  parameter p-move-resize   as logical   no-undo .
      923     define variable v-field-group-handle    as handle    no-undo .
      924     define variable v-object-handle         as handle    no-undo .
      925     define variable v-frame-height          as decimal   no-undo .
      926     define variable v-frame-virtual-height  as decimal   no-undo .
      927     define variable v-browse-height         as decimal   no-undo .
      928     define variable v-window-height         as decimal   no-undo .
      929     define variable v-window-virtual-height as decimal   no-undo .
      930     define variable v-change-sign           as integer   no-undo .
      931     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      932     define buffer buf_temp-browse-handle  for temp-browse-handle .
      933     if p-change-value > 0
      934     then do:
      935       if frame Dialog-Frame :height + p-change-value
      936           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      937       then do:
      938         assign
      939           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      940                           - (frame Dialog-Frame :height-chars)
      941         .
      942         if p-change-value <= 0
      943         then do:
      944           run diasize_position-resize-button in this-procedure .
      945           return .
      946         end.
      947       end.
      948     end.
      949     if p-change-value < 0
      950     then do:
      951       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      952       then do:
      953         assign
      954           p-change-value = v-diasize-orig-frame-height
      955                          - (frame Dialog-Frame :height-chars)
      956         .
      957         if p-change-value >= 0
      958         then do:
      959           run diasize_position-resize-button in this-procedure .
      960           return .
      961         end.
      962       end.
      963     end.
      964     if p-change-value >= 0
      965     then do:
      966       assign
      967         v-change-sign = 1
      968       .
      969     end.
      970     else do:
      971       assign
      972         v-change-sign = -1
      973       .
      974     end.
      975     assign
      976       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      977     .
      978     if p-change-value = 0
      979     then do:
      980       run diasize_position-resize-button in this-procedure .
      981       return .
      982     end.
      983     move_block:
      984     do
      985     on error undo move_block, retry move_block
      986     :
      987       if retry
      988       then do:
      989         do
      990         on error undo move_block, leave move_block
      991         :
      992           if p-change-value > 0
      993           then do:
      994             for each buf_temp-diasize-handle
      995             on error undo, next
      996             :
      997               assign
      998                 v-object-handle = buf_temp-diasize-handle.handle-value
      999               .
     1000               if v-object-handle <> v-diasize-resize-button
     1001               then do:
     1002                 assign
     1003                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1004                 .
     1005               end.
     1006             end.
     1007             assign
     1008               v-diasize-browse-handle :height = v-browse-height
     1009             .
     1010             for each buf_temp-browse-handle
     1011               where buf_temp-browse-handle.browse-type = 'height':u
     1012             on error undo, next
     1013             :
     1014               assign
     1015                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1016               .
     1017             end.
     1018             assign
     1019               frame Dialog-Frame :height = v-frame-height
     1020             .
     1021             if frame Dialog-Frame :scrollable = true
     1022             then do:
     1023               assign
     1024                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1025               .
     1026             end.
     1027             run diasize_position-resize-button in this-procedure .
     1028           end.
     1029           else do:
     1030             if frame Dialog-Frame :scrollable = true
     1031             then do:
     1032               assign
     1033                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1034               .
     1035             end.
     1036             assign
     1037               frame Dialog-Frame :height = v-frame-height
     1038             .
     1039             assign
     1040               v-diasize-browse-handle :height = v-browse-height
     1041             .
     1042             for each buf_temp-browse-handle
     1043               where buf_temp-browse-handle.browse-type = 'height':u
     1044             on error undo, next
     1045             :
     1046               assign
     1047                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1048               .
     1049             end.
     1050             for each buf_temp-diasize-handle
     1051             on error undo, next
     1052             :
     1053               assign
     1054                 v-object-handle = buf_temp-diasize-handle.handle-value
     1055               .
     1056               if v-object-handle <> v-diasize-resize-button
     1057               then do:
     1058                 assign
     1059                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1060                 .
     1061               end.
     1062             end.
     1063             run diasize_position-resize-button in this-procedure .
     1064           end.
     1065           assign
     1066             v-diasize-change-size = false
     1067           .
     1068           leave move_block .
     1069         end.
     1070       end.
     1071       assign
     1072         v-diasize-need-full-display = true
     1073       .
     1074       if v-diasize-change-size = false
     1075       then do:
     1076         assign
     1077           v-diasize-change-size = true
     1078         .
     1079       end.
     1080       else do:
     1081         return .
     1082       end.
     1083       assign
     1084         v-frame-height = frame Dialog-Frame :height
     1085         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1086         v-browse-height = v-diasize-browse-handle :height
     1087       .
     1088       for each buf_temp-browse-handle
     1089         where buf_temp-browse-handle.browse-type = 'height':u
     1090       :
     1091         assign
     1092           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1093         .
     1094       end.
     1095       for each buf_temp-diasize-handle
     1096       :
     1097         delete buf_temp-diasize-handle .
     1098       end.
     1099       assign
     1100         v-field-group-handle = frame Dialog-Frame :first-child
     1101       .
     1102       do while valid-handle(v-field-group-handle)
     1103       :
     1104         assign
     1105           v-object-handle = v-field-group-handle :first-child
     1106         .
     1107         do while valid-handle(v-object-handle)
     1108         :
     1109           if  v-object-handle <> v-diasize-browse-handle :handle
     1110           and can-query(v-object-handle, "row")
     1111           and can-query(v-object-handle, "height")
     1112           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1113           then do:
     1114             find first buf_temp-browse-handle
     1115               where buf_temp-browse-handle.browse-type   = 'height':u
     1116                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1117               no-error .
     1118             if available buf_temp-browse-handle
     1119             then do:
     1120             end.
     1121             else do:
     1122               create buf_temp-diasize-handle .
     1123               assign
     1124                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1125                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1126               .
     1127             end.
     1128           end.
     1129           assign
     1130             v-object-handle = v-object-handle :next-sibling
     1131           .
     1132         end.
     1133         assign
     1134           v-field-group-handle = v-field-group-handle :next-sibling
     1135         .
     1136       end.
     1137       do with frame Dialog-Frame
     1138       :
     1139         hide v-diasize-resize-button .
     1140         assign
     1141           v-diasize-resize-button :row    = 1
     1142           v-diasize-resize-button :column = 1
     1143         .
     1144       end.
     1145       if p-change-value > 0
     1146       then do:
     1147         if frame Dialog-Frame :scrollable = true
     1148         then do:
     1149           assign
     1150             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1151             no-error .
     1152           if error-status :error
     1153           or error-status :get-message(1) <> ""
     1154           then do:
     1155             undo move_block, retry move_block .
     1156           end.
     1157         end.
     1158         assign
     1159           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1160           no-error .
     1161         if error-status :error
     1162         or error-status :get-message(1) <> ""
     1163         then do:
     1164           undo move_block, retry move_block .
     1165         end.
     1166         assign
     1167           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1168           no-error .
     1169         if error-status :error
     1170         or error-status :get-message(1) <> ""
     1171         then do:
     1172           undo move_block, retry move_block .
     1173         end.
     1174         for each buf_temp-browse-handle
     1175           where buf_temp-browse-handle.browse-type = 'height':u
     1176         on error undo move_block, retry move_block
     1177         :
     1178           assign
     1179             buf_temp-browse-handle.browse-handle :height
     1180               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1181             no-error .
     1182           if error-status :error
     1183           or error-status :get-message(1) <> ""
     1184           then do:
     1185             undo move_block, retry move_block .
     1186           end.
     1187         end.
     1188         for each buf_temp-diasize-handle
     1189         on error undo move_block, retry move_block
     1190         :
     1191           assign
     1192             v-object-handle = buf_temp-diasize-handle.handle-value
     1193           .
     1194           if v-object-handle <> v-diasize-resize-button
     1195           then do:
     1196             assign
     1197               v-object-handle :row = v-object-handle :row + p-change-value
     1198               no-error .
     1199             if error-status :error
     1200             or error-status :get-message(1) <> ""
     1201             then do:
     1202               undo move_block, retry move_block .
     1203             end.
     1204           end.
     1205         end.
     1206       end.
     1207       else do:
     1208         for each buf_temp-diasize-handle
     1209         on error undo move_block, retry move_block
     1210         :
     1211           assign
     1212             v-object-handle = buf_temp-diasize-handle.handle-value
     1213           .
     1214           if v-object-handle <> v-diasize-resize-button
     1215           then do:
     1216             assign
     1217               v-object-handle :row = v-object-handle :row + p-change-value
     1218               no-error .
     1219             if error-status :error
     1220             or error-status :get-message(1) <> ""
     1221             then do:
     1222               undo move_block, retry move_block .
     1223             end.
     1224           end.
     1225         end.
     1226         assign
     1227           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1228           no-error .
     1229         if error-status :error
     1230         or error-status :get-message(1) <> ""
     1231         then do:
     1232           undo move_block, retry move_block .
     1233         end.
     1234         for each buf_temp-browse-handle
     1235           where buf_temp-browse-handle.browse-type = 'height':u
     1236         on error undo move_block, retry move_block
     1237         :
     1238           assign
     1239             buf_temp-browse-handle.browse-handle :height
     1240               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1241             no-error .
     1242           if error-status :error
     1243           or error-status :get-message(1) <> ""
     1244           then do:
     1245             undo move_block, retry move_block .
     1246           end.
     1247         end.
     1248         assign
     1249           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1250           no-error .
     1251         if error-status :error
     1252         or error-status :get-message(1) <> ""
     1253         then do:
     1254           undo move_block, retry move_block .
     1255         end.
     1256         if frame Dialog-Frame :scrollable = true
     1257         then do:
     1258           assign
     1259             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1260             no-error .
     1261           if error-status :error
     1262           or error-status :get-message(1) <> ""
     1263           then do:
     1264             undo move_block, retry move_block .
     1265           end.
     1266         end.
     1267       end.
     1268       if p-move-resize = true
     1269       then do:
     1270         run diasize_position-resize-button in this-procedure .
     1271       end.
     1272       if v-diasize-wndstore = true
     1273       then do:
     1274         if connected("ub") = true
     1275         then do:
     1276           define variable v-cntxt-db-num        as integer   no-undo .
     1277           define variable v-cntxt-userid        as character no-undo .
     1278           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1279                                             , OUTPUT v-cntxt-userid
     1280                                             ) .
     1281           run gbl/wndsizew.p
     1282             (input  v-cntxt-db-num
     1283             ,input  v-cntxt-userid
     1284             ,input  v-diasize-proc-name
     1285             ,input  'height':u
     1286             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1287             ) .
     1288         end.
     1289       end.
     1290     end.
     1291     assign
     1292       v-diasize-change-size = false
     1293     .
     1294   end procedure.
     1295   procedure diasize_set-height :
     1296     define input  parameter p-new-height  as decimal   no-undo .
     1297     define input  parameter p-move-resize as logical   no-undo .
     1298     do
     1299     on error undo, return error return-value
     1300     :
     1301       run diasize_change-height in this-procedure
     1302         (input  (p-new-height - frame Dialog-Frame :height)
     1303         ,input  p-move-resize
     1304         ) .
     1305     end.
     1306   end procedure.
     1307   procedure diasize_change-width :
     1308     define input  parameter p-change-value as decimal   no-undo .
     1309     define input  parameter p-move-resize  as logical   no-undo .
     1310     define variable v-field-group-handle   as handle    no-undo .
     1311     define variable v-object-handle        as handle    no-undo .
     1312     define variable v-frame-width          as decimal   no-undo .
     1313     define variable v-frame-virtual-width  as decimal   no-undo .
     1314     define variable v-browse-width         as decimal   no-undo .
     1315     define variable v-window-width         as decimal   no-undo .
     1316     define variable v-window-virtual-width as decimal   no-undo .
     1317     define variable v-change-sign          as integer   no-undo .
     1318     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1319     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1320     if p-change-value > 0
     1321     then do:
     1322       if frame Dialog-Frame :width + p-change-value >
     1323           session :width-chars
     1324       then do:
     1325         assign
     1326           p-change-value = session :width-chars - frame Dialog-Frame :width
     1327         .
     1328         if p-change-value <= 0
     1329         then do:
     1330           run diasize_position-resize-button in this-procedure .
     1331           return .
     1332         end.
     1333       end.
     1334     end.
     1335     if p-change-value < 0
     1336     then do:
     1337       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1338       then do:
     1339         assign
     1340           p-change-value = v-diasize-orig-frame-width
     1341                          - frame Dialog-Frame :width
     1342         .
     1343         if p-change-value >= 0
     1344         then do:
     1345           run diasize_position-resize-button in this-procedure .
     1346           return .
     1347         end.
     1348       end.
     1349     end.
     1350     if p-change-value >= 0
     1351     then do:
     1352       assign
     1353         v-change-sign = 1
     1354       .
     1355     end.
     1356     else do:
     1357       assign
     1358         v-change-sign = -1
     1359       .
     1360     end.
     1361     assign
     1362       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1363     .
     1364     if p-change-value = 0
     1365     then do:
     1366       run diasize_position-resize-button in this-procedure .
     1367       return .
     1368     end.
     1369     move_block:
     1370     do
     1371     on error undo move_block, leave move_block
     1372     :
     1373       if retry
     1374       then do:
     1375         do
     1376         on error undo move_block, leave move_block
     1377         :
     1378           if p-change-value > 0
     1379           then do:
     1380             for each buf_temp-diasize-handle
     1381             on error undo, next
     1382             :
     1383               assign
     1384                 v-object-handle = buf_temp-diasize-handle.handle-value
     1385               .
     1386               if v-object-handle <> v-diasize-resize-button
     1387               then do:
     1388                 assign
     1389                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1390                 .
     1391               end.
     1392             end.
     1393             assign
     1394               v-diasize-browse-handle :width = v-browse-width
     1395             .
     1396             for each buf_temp-browse-handle
     1397               where buf_temp-browse-handle.browse-type = 'width':u
     1398             on error undo, next
     1399             :
     1400               assign
     1401                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1402               .
     1403             end.
     1404             assign
     1405               frame Dialog-Frame :width = v-frame-width
     1406             .
     1407             if frame Dialog-Frame :scrollable = true
     1408             then do:
     1409               assign
     1410                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1411               .
     1412             end.
     1413             run diasize_position-resize-button in this-procedure .
     1414           end.
     1415           else do:
     1416             if frame Dialog-Frame :scrollable = true
     1417             then do:
     1418               assign
     1419                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1420               .
     1421             end.
     1422             assign
     1423               frame Dialog-Frame :width = v-frame-width
     1424             .
     1425             for each buf_temp-browse-handle
     1426               where buf_temp-browse-handle.browse-type = 'width':u
     1427             on error undo, next
     1428             :
     1429               assign
     1430                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1431               .
     1432             end.
     1433             assign
     1434               v-diasize-browse-handle :width = v-browse-width
     1435             .
     1436             for each buf_temp-diasize-handle
     1437             on error undo, next
     1438             :
     1439               assign
     1440                 v-object-handle = buf_temp-diasize-handle.handle-value
     1441               .
     1442               if v-object-handle <> v-diasize-resize-button
     1443               then do:
     1444                 assign
     1445                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1446                 .
     1447               end.
     1448             end.
     1449             run diasize_position-resize-button in this-procedure .
     1450           end.
     1451           assign
     1452             v-diasize-change-size = false
     1453           .
     1454           leave move_block .
     1455         end.
     1456       end.
     1457       assign
     1458         v-diasize-need-full-display = true
     1459       .
     1460       if v-diasize-change-size = false
     1461       then do:
     1462         assign
     1463           v-diasize-change-size = true
     1464         .
     1465       end.
     1466       else do:
     1467         return .
     1468       end.
     1469       assign
     1470         v-frame-width = frame Dialog-Frame :width
     1471         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1472         v-browse-width = v-diasize-browse-handle :width
     1473       .
     1474       for each buf_temp-browse-handle
     1475         where buf_temp-browse-handle.browse-type = 'width':u
     1476       :
     1477         assign
     1478           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1479         .
     1480       end.
     1481       for each buf_temp-diasize-handle
     1482       :
     1483         delete buf_temp-diasize-handle .
     1484       end.
     1485       assign
     1486         v-field-group-handle = frame Dialog-Frame :first-child
     1487       .
     1488       do while valid-handle(v-field-group-handle)
     1489       :
     1490         assign
     1491           v-object-handle = v-field-group-handle :first-child
     1492         .
     1493         do while valid-handle(v-object-handle)
     1494         :
     1495           if  v-object-handle <> v-diasize-browse-handle :handle
     1496           and v-object-handle <> v-diasize-resize-button
     1497           and can-query(v-object-handle, "row")
     1498           and can-query(v-object-handle, "height")
     1499           and ( v-object-handle :col + v-object-handle :width
     1500                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1501               )
     1502           then do:
     1503             find first buf_temp-browse-handle
     1504               where buf_temp-browse-handle.browse-type   = 'width':u
     1505                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1506               no-error .
     1507             if available buf_temp-browse-handle
     1508             then do:
     1509             end.
     1510             else do:
     1511               create buf_temp-diasize-handle .
     1512               assign
     1513                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1514                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1515               .
     1516             end.
     1517           end.
     1518           assign
     1519             v-object-handle = v-object-handle :next-sibling
     1520           .
     1521         end.
     1522         assign
     1523           v-field-group-handle = v-field-group-handle :next-sibling
     1524         .
     1525       end.
     1526       do with frame Dialog-Frame
     1527       :
     1528         hide v-diasize-resize-button .
     1529         v-diasize-resize-button :row = 1.
     1530         v-diasize-resize-button :column = 1.
     1531       end.
     1532       if p-change-value > 0
     1533       then do:
     1534         if frame Dialog-Frame :scrollable = true
     1535         then do:
     1536           assign
     1537             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1538             no-error .
     1539           if error-status :error
     1540           or error-status :get-message(1) <> ""
     1541           then do:
     1542             undo move_block, retry move_block.
     1543           end.
     1544         end.
     1545         assign
     1546           frame Dialog-Frame :width = v-frame-width + p-change-value
     1547           no-error .
     1548         if error-status :error
     1549         or error-status :get-message(1) <> ""
     1550         then do:
     1551           undo move_block, retry move_block.
     1552         end.
     1553         assign
     1554           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1555         no-error .
     1556         if error-status :error
     1557         or error-status :get-message(1) <> ""
     1558         then do:
     1559           undo move_block, retry move_block.
     1560         end.
     1561         for each buf_temp-browse-handle
     1562           where buf_temp-browse-handle.browse-type = 'width':u
     1563         on error undo move_block, retry move_block
     1564         :
     1565           assign
     1566             buf_temp-browse-handle.browse-handle :width
     1567               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1568             no-error .
     1569           if error-status :error
     1570           or error-status :get-message(1) <> ""
     1571           then do:
     1572             undo move_block, retry move_block .
     1573           end.
     1574         end.
     1575         for each buf_temp-diasize-handle
     1576         on error undo move_block, retry move_block
     1577         :
     1578           assign
     1579             v-object-handle = buf_temp-diasize-handle.handle-value
     1580           .
     1581           if v-object-handle <> v-diasize-resize-button
     1582           then do:
     1583             assign
     1584               v-object-handle :col = v-object-handle :col + p-change-value
     1585               no-error .
     1586             if error-status :error
     1587             or error-status :get-message(1) <> ""
     1588             then do:
     1589               undo move_block, retry move_block .
     1590             end.
     1591           end.
     1592         end.
     1593       end.
     1594       else do:
     1595         for each buf_temp-diasize-handle
     1596         on error undo move_block, retry move_block
     1597         :
     1598           assign
     1599             v-object-handle = buf_temp-diasize-handle.handle-value
     1600           .
     1601           if v-object-handle <> v-diasize-resize-button
     1602           then do:
     1603             assign
     1604               v-object-handle :col = v-object-handle :col + p-change-value
     1605               no-error .
     1606             if error-status :error
     1607             or error-status :get-message(1) <> ""
     1608             then do:
     1609               undo move_block, retry move_block .
     1610             end.
     1611           end.
     1612         end.
     1613         for each buf_temp-browse-handle
     1614           where buf_temp-browse-handle.browse-type = 'width':u
     1615         on error undo move_block, retry move_block
     1616         :
     1617           assign
     1618             buf_temp-browse-handle.browse-handle :width
     1619               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1620             no-error .
     1621           if error-status :error
     1622           or error-status :get-message(1) <> ""
     1623           then do:
     1624             undo move_block, retry move_block .
     1625           end.
     1626         end.
     1627         assign
     1628           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1629           no-error .
     1630         if error-status :error
     1631         or error-status :get-message(1) <> ""
     1632         then do:
     1633           undo move_block, retry move_block.
     1634         end.
     1635         assign
     1636           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1637         no-error .
     1638         if error-status :error
     1639         or error-status :get-message(1) <> ""
     1640         then do:
     1641           undo move_block, retry move_block.
     1642         end.
     1643         if frame Dialog-Frame :scrollable = true
     1644         then do:
     1645           assign
     1646             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1647           no-error .
     1648           if error-status :error
     1649           or error-status :get-message(1) <> ""
     1650           then do:
     1651             undo move_block, retry move_block.
     1652           end.
     1653         end.
     1654       end.
     1655       if p-move-resize
     1656       then do:
     1657         run diasize_position-resize-button in this-procedure .
     1658       end.
     1659       if v-diasize-wndstore = true
     1660       then do:
     1661         if connected("ub") = true
     1662         then do:
     1663           define variable v-cntxt-db-num        as integer   no-undo .
     1664           define variable v-cntxt-userid        as character no-undo .
     1665           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1666                                             , OUTPUT v-cntxt-userid
     1667                                             ) .
     1668           run gbl/wndsizew.p
     1669             (input  v-cntxt-db-num
     1670             ,input  v-cntxt-userid
     1671             ,input  v-diasize-proc-name
     1672             ,input  'width':u
     1673             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1674             ) .
     1675         end.
     1676       end.
     1677     end.
     1678     assign
     1679       v-diasize-change-size = false
     1680     .
     1681   end procedure.
     1682   procedure diasize_set-width :
     1683     define input  parameter p-new-width  as decimal   no-undo .
     1684     define input  parameter p-move-resize as logical   no-undo .
     1685     do
     1686     on error undo, return error return-value
     1687     :
     1688       run diasize_change-width in this-procedure
     1689         (input  (p-new-width - frame Dialog-Frame :width)
     1690         ,input  p-move-resize
     1691         ) .
     1692     end.
     1693   end procedure.
     1694   procedure diasize_position-resize-button :
     1695     do with frame Dialog-Frame
     1696     :
     1697       hide v-diasize-resize-button .
     1698       assign
     1699         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1700                     - 1
     1701                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1702         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1703                     - 1
     1704                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1705       .
     1706       view v-diasize-resize-button .
     1707     end.
     1708   end procedure.
     1709   on alt-right anywhere
     1710   do:
     1711     run diasize_change-width in this-procedure
     1712       (input 1
     1713       ,input true
     1714       ) .
     1715     return no-apply .
     1716   end.
     1717   on alt-left anywhere
     1718   do:
     1719     run diasize_change-width in this-procedure
     1720       (input -1
     1721       ,input true
     1722       ) .
     1723     return no-apply .
     1724   end.
     1725   on alt-down anywhere
     1726   do:
     1727     run diasize_change-height in this-procedure
     1728       (input 1
     1729       ,input true
     1730       ) .
     1731     return no-apply .
     1732   end.
     1733   on alt-up anywhere
     1734   do:
     1735     run diasize_change-height in this-procedure
     1736       (input -1
     1737       ,input true
     1738       ) .
     1739     return no-apply .
     1740   end.
     1741   on alt-enter of frame Dialog-Frame
     1742   do:
     1743     run diasize_maximize in this-procedure
     1744       (input  ?
     1745       ).
     1746     return no-apply .
     1747   end.
     1748   procedure diasize_end-move :
     1749     do
     1750     on error undo, return error return-value
     1751     :
     1752       define variable v-row-delta as decimal   no-undo .
     1753       define variable v-col-delta as decimal   no-undo .
     1754       define variable v-new-row as decimal   no-undo .
     1755       define variable v-new-col as decimal   no-undo .
     1756       assign
     1757         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1758         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1759       .
     1760       assign
     1761         v-row-delta = v-new-row - frame Dialog-Frame :height
     1762         v-col-delta = v-new-col - frame Dialog-Frame :width
     1763       .
     1764       run diasize_change-height in this-procedure
     1765         (input v-row-delta
     1766         ,input true
     1767         ) .
     1768       run diasize_change-width in this-procedure
     1769         (input v-col-delta
     1770         ,input true
     1771         ) .
     1772     end.
     1773   end procedure.
     1774   procedure diasize_maximize :
     1775     define input  parameter p-action as logical   no-undo .
     1776     do
     1777     on error undo, return error return-value
     1778     :
     1779       if p-action = ?
     1780       then do:
     1781         if v-diasize-need-maximize = true
     1782         then do:
     1783           assign
     1784             p-action = true
     1785           .
     1786         end.
     1787         else do:
     1788           assign
     1789             p-action = false
     1790           .
     1791         end.
     1792       end.
     1793       if p-action = true
     1794       then do:
     1795         run diasize_change-height in this-procedure
     1796           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1797               - frame Dialog-Frame :height-chars
     1798           ,input true
     1799           ) .
     1800         run diasize_change-width in this-procedure
     1801           (input session :width-chars
     1802               - frame Dialog-Frame :width-chars
     1803           ,input true
     1804           ) .
     1805         assign
     1806           v-diasize-need-maximize = false
     1807         .
     1808       end.
     1809       else do:
     1810         run diasize_change-width in this-procedure
     1811           (input v-diasize-orig-frame-width
     1812               - frame Dialog-Frame :width-chars
     1813           ,input true
     1814           ) .
     1815         run diasize_change-height in this-procedure
     1816           (input v-diasize-orig-frame-height
     1817               - frame Dialog-Frame :height-chars
     1818           ,input true
     1819           ) .
     1820         assign
     1821           v-diasize-need-maximize = true
     1822         .
     1823       end.
     1824     end.
     1825   end procedure.
     1826   procedure diasize_restore-orig-size :
     1827     do
     1828     on error undo, return error return-value
     1829     :
     1830       assign
     1831         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1832         v-diasize-current-frame-height = frame Dialog-Frame :height
     1833       .
     1834       run diasize_set-height in this-procedure
     1835         (input  v-diasize-orig-frame-height
     1836         ,input  true
     1837         ) .
     1838       run diasize_set-width in this-procedure
     1839         (input  v-diasize-orig-frame-width
     1840         ,input  true
     1841         ) .
     1842     end.
     1843   end procedure.
     1844   procedure diasize_restore-current-size :
     1845     do
     1846     on error undo, return error return-value
     1847     :
     1848       run diasize_set-height in this-procedure
     1849         (input  v-diasize-current-frame-height
     1850         ,input  true
     1851         ) .
     1852       run diasize_set-width in this-procedure
     1853         (input  v-diasize-current-frame-width
     1854         ,input  true
     1855         ) .
     1856     end.
     1857   end procedure.
     1858   procedure diasize_set-browse-handle :
     1859     define input  parameter p-browse-handle as handle   no-undo .
     1860     define buffer buf_temp-browse-handle for temp-browse-handle .
     1861     do
     1862     on error undo, return error return-value
     1863     :
     1864       assign
     1865         v-diasize-browse-handle = p-browse-handle
     1866       .
     1867       for each buf_temp-browse-handle
     1868       on error undo, return error return-value
     1869       :
     1870         delete buf_temp-browse-handle .
     1871       end.
     1872     end.
     1873   end procedure.
     1874   procedure diasize_add_browse :
     1875     define input  parameter p-browse-type   as character no-undo .
     1876     define input  parameter p-browse-handle as handle    no-undo .
     1877     define buffer buf_temp-browse-handle for temp-browse-handle .
     1878     do
     1879     on error undo, return error return-value
     1880     :
     1881       assign
     1882         v-diasize-browse-number = v-diasize-browse-number + 1
     1883       .
     1884       create buf_temp-browse-handle .
     1885       assign
     1886         buf_temp-browse-handle.browse-type   = p-browse-type
     1887         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1888         buf_temp-browse-handle.browse-handle = p-browse-handle
     1889       .
     1890     end.
     1891   end procedure.
     1892   procedure diasize_init :
     1893     define variable v-default-value    as logical   no-undo .
     1894     define variable v-restore-saved    as logical   no-undo .
     1895     define variable v-resize-value-str as character no-undo .
     1896     do
     1897     on error undo, return error return-value
     1898     :
     1899       do with frame Dialog-Frame
     1900       :
     1901         assign
     1902           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1903           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1904           v-diasize-browse-handle     = browse br-c-ex-mark :handle
     1905         .
     1906         create button v-diasize-resize-button
     1907         assign
     1908           parent        = frame Dialog-Frame :first-child
     1909           label         = "s"
     1910           height-pixels = 16
     1911           width-pixels  = 16
     1912           visible       = true
     1913           sensitive     = true
     1914           movable       = true
     1915           triggers:
     1916             on end-move persistent run diasize_end-move in this-procedure .
     1917           end triggers.
     1918         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1919         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1920         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1921         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1922         assign
     1923           v-diasize-wndmax = false
     1924         .
     1925         if connected("ub") = true
     1926         then do:
     1927           define variable v-cntxt-db-num        as integer   no-undo .
     1928           define variable v-cntxt-userid        as character no-undo .
     1929           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1930                                             , OUTPUT v-cntxt-userid
     1931                                             ) .
     1932           run gbl/wndpar_r.p
     1933             (input  v-cntxt-db-num
     1934             ,input  v-cntxt-userid
     1935             ,input  'wndmax':U
     1936             ,output v-diasize-wndmax
     1937             ,output v-default-value
     1938             ) .
     1939         end.
     1940         assign
     1941           v-diasize-wndstore = false
     1942         .
     1943         if connected("ub") = true
     1944         then do:
     1945           run gbl/wndpar_r.p
     1946             (input  v-cntxt-db-num
     1947             ,input  v-cntxt-userid
     1948             ,input  'wndstore':U
     1949             ,output v-diasize-wndstore
     1950             ,output v-default-value
     1951             ) .
     1952         end.
     1953         assign
     1954           v-diasize-proc-name = entry(1, program-name(2), '.')
     1955         .
     1956         if v-diasize-wndstore = true
     1957         then do:
     1958           assign
     1959             v-restore-saved = false
     1960           .
     1961           if connected("ub") = true
     1962           then do:
     1963             run gbl/wndsizer.p
     1964               (input  v-cntxt-db-num
     1965               ,input  v-cntxt-userid
     1966               ,input  v-diasize-proc-name
     1967               ,input  'height':u
     1968               ,output v-resize-value-str
     1969               ) .
     1970             if v-resize-value-str <> '':U
     1971             then do:
     1972               run diasize_change-height in this-procedure
     1973                 (input  integer(v-resize-value-str)
     1974                 ,input  true
     1975                 ) .
     1976               assign
     1977                 v-restore-saved = true
     1978               .
     1979             end.
     1980           end.
     1981           if connected("ub") = true
     1982           then do:
     1983             run gbl/wndsizer.p
     1984               (input  v-cntxt-db-num
     1985               ,input  v-cntxt-userid
     1986               ,input  v-diasize-proc-name
     1987               ,input  'width':u
     1988               ,output v-resize-value-str
     1989               ) .
     1990             if v-resize-value-str <> '':U
     1991             then do:
     1992               run diasize_change-width in this-procedure
     1993                 (input  integer(v-resize-value-str)
     1994                 ,input  true
     1995                 ) .
     1996               assign
     1997                 v-restore-saved = true
     1998               .
     1999             end.
     2000           end.
     2001           if v-restore-saved <> true
     2002           then do:
     2003             if v-diasize-wndmax = true
     2004             then do:
     2005               run diasize_maximize in this-procedure
     2006                 (input  true
     2007                 ) .
     2008             end.
     2009           end.
     2010         end.
     2011         else do:
     2012           if v-diasize-wndmax = true
     2013           then do:
     2014             run diasize_maximize in this-procedure
     2015               (input  true
     2016               ) .
     2017           end.
     2018         end.
     2019       end.
     2020     end.
     2021   end procedure.
     2022   procedure diasize_need-full-display :
     2023     define output parameter p-need-full-display as logical   no-undo .
     2024     do
     2025     on error undo, return error return-value
     2026     :
     2027       assign
     2028         p-need-full-display = v-diasize-need-full-display
     2029       .
     2030       assign
     2031         v-diasize-need-full-display = false
     2032       .
     2033     end.
     2034   end procedure.
     2035   procedure get-context :
     2036      define output parameter p-db-num as integer          no-undo.
     2037      define output parameter p-user-id as character        no-undo.
     2038      define variable v-login               as character    no-undo.
     2039      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2040      define buffer buf_user-login  for ub.user-login .
     2041      do
     2042      on error undo, return error
     2043      :
     2044            FIND FIRST buf_sys-ctrl no-lock.
     2045            ASSIGN
     2046               v-login = USERID("ub")
     2047               p-db-num = buf_sys-ctrl.db-num
     2048            .
     2049            FIND FIRST buf_user-login
     2050                 WHERE buf_user-login.db-num = p-db-num
     2051                   AND buf_user-login.user-login = v-login
     2052                 no-lock
     2053                 no-error
     2054                 .
     2055            IF AVAILABLE buf_user-login
     2056            THEN DO:
     2057               assign
     2058                  p-user-id = buf_user-login.user-id
     2059               .
     2060            END.
     2061      end.
     2062   end procedure.
     2063       run diasize_init in this-procedure .
     2064   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2065   do:
     2066     br-c-ex-mark :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2067   end.
     2068   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2069   on f5 of frame Dialog-Frame anywhere
     2070   do:
     2071     if available x_c-ex-mark then do:   assign     v-curr-rowid = rowid(x_c-ex-mark)   .   end.   run open-br in this-procedure .   reposition br-c-ex-mark to rowid v-curr-rowid no-error .   apply 'entry' to br-c-ex-mark in frame Dialog-Frame.
     2072       apply "VALUE-CHANGED" to br-c-ex-mark.
     2073   end.
     2074   MAIN-BLOCK:
     2075   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2076      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2077     run my-enable in this-procedure .
     2078     WAIT-FOR GO OF FRAME Dialog-Frame.
     2079   END.
     2080   RUN disable_UI.
     2081   PROCEDURE disable_UI :
     2082     HIDE FRAME Dialog-Frame.
     2083   END PROCEDURE.
     2084   PROCEDURE enable_UI :
     2085     ENABLE b-exit b-help br-c-ex-mark br-changes
     2086         WITH FRAME Dialog-Frame.
     2087     VIEW FRAME Dialog-Frame.
     2088     OPEN QUERY br-c-ex-mark FOR EACH x_c-ex-mark NO-LOCK INDEXED-REPOSITION.    OPEN QUERY br-changes FOR EACH temp-changes.
     2089   END PROCEDURE.
     2090   PROCEDURE my-enable :
     2091     find first buf_ex-mark no-lock
     2092       where rowid(buf_ex-mark) = p-ex-mark-rowid
     2093     no-error .
     2094     if not available buf_ex-mark then do:
     2095       message
     2096         "Не определена запись для показа истории."
     2097       view-as alert-box error.
     2098       return error.
     2099     end.
     2100     assign
     2101       frame Dialog-Frame:title = substitute( "История марки БД: &1 внутренний код: &2" , buf_ex-mark.db-num , buf_ex-mark.mark-code )
     2102     .
     2103     enable
     2104       b-exit
     2105       b-help
     2106       br-c-ex-mark
     2107       br-changes
     2108     with frame Dialog-Frame.
     2109     view frame Dialog-Frame.
     2110     run open-br in this-procedure .
     2111   END PROCEDURE.
     2112   PROCEDURE open-br :
     2113     run waitfram-show in this-procedure ( "Подождите..." ) .
     2114     open query br-c-ex-mark
     2115       for each x_c-ex-mark no-lock
     2116         where x_c-ex-mark.db-num    = buf_ex-mark.db-num
     2117           and x_c-ex-mark.mark-code = buf_ex-mark.mark-code
     2118       by x_c-ex-mark.corr-date descending
     2119       by x_c-ex-mark.corr-time descending
     2120     indexed-reposition.
     2121     apply "value-changed" to br-c-ex-mark in frame Dialog-Frame.
     2122     apply "entry" to br-c-ex-mark in frame Dialog-Frame.
     2123     run waitfram-hide in this-procedure .
     2124   END PROCEDURE.
     2125   PROCEDURE proc-view-changes :
     2126     for each temp-changes:
     2127         delete temp-changes.
     2128     end.
     2129     if not available X_c-ex-mark then do:
     2130       open query br-changes for each temp-changes.
     2131       return.
     2132     end.
     2133     define variable v-label-param as character no-undo .
     2134     v-label-param =
     2135       "mark-name" + chr(4) + "Код марки" + chr(4) + "" + chr(8)
     2136     + "mark-type" + chr(4) + "Тип марки" + chr(4) + "exmrklib_get-type-name" + chr(8)
     2137     + "stts"      + chr(4) + "Статус"    + chr(4) + "exmrklib_get-status-name"  .
     2138     run proc-full-temp-changes in this-procedure ( input  buffer X_c-ex-mark:handle
     2139                                                  , input  'ex-mark':U
     2140                                                  , input  "mark-name,mark-type,stts":U
     2141                                                  , input  v-label-param
     2142                                                  ) .
     2143     open query br-changes for each temp-changes.
     2144   END PROCEDURE.
