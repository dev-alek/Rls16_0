      422   procedure prn-lib-open-stream :
      423     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      424     define input parameter p-page-size    as integer no-undo .
      425     define input parameter p-is-stream    as logical no-undo .
      426     define input parameter p-append       as logical no-undo .
      427     define variable v-report-name as character no-undo .
      428     do
      429       on error undo, return error
      430       :
      431       run prn-lib-get-report-name  in this-procedure (
      432         input parParentProc
      433         ,output v-report-name
      434         ).
      435       if p-is-stream then
      436       do:
      437         if p-append then
      438         do:
      439           output stream PrnLibStream to value( v-report-name )
      440             page-size value(p-page-size) append .
      441         end.
      442         if not p-append then
      443         do:
      444           output stream PrnLibStream to value( v-report-name )
      445             page-size value(p-page-size) .
      446         end.
      447       end.
      448       if not p-is-stream then
      449       do:
      450         if p-append then
      451         do:
      452           output to value( v-report-name )
      453             page-size value(p-page-size) append .
      454         end.
      455         if not p-append then
      456         do:
      457           output to value( v-report-name )
      458             page-size value(p-page-size) .
      459         end.
      460       end.
      461     end.
      462   end procedure.
      463   procedure prn-lib-open-exp :
      464     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      465     define input parameter p-is-stream    as logical no-undo .
      466     define input parameter p-is-append    as logical no-undo .
      467     define output parameter p-ReportFileName as char init "report" no-undo.
      468     define output parameter p-process as logical no-undo .
      469     define variable glog as logical no-undo .
      470     do
      471       on error undo, return error
      472       :
      473       SYSTEM-DIALOG GET-FILE p-ReportFileName
      474         TITLE      "Укажите путь"
      475         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      476         ASK-OVERWRITE
      477         CREATE-TEST-FILE
      478         SAVE-AS
      479         USE-FILENAME
      480         DEFAULT-EXTENSION "txt"
      481         UPDATE glog
      482         .
      483       if not glog then  return.
      484       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      485       if p-is-stream then
      486       do:
      487         if p-is-append then
      488         do:
      489           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      490         end.
      491         else
      492         do:
      493           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      494         end.
      495       end.
      496       else
      497       do:
      498         if p-is-append then
      499         do:
      500           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      501         end.
      502         else
      503         do:
      504           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      505         end.
      506       end.
      507       p-process = yes.
      508     end.
      509   end procedure.
      510   procedure prn-lib-get-report-name :
      511     define input parameter parParentProc  as widget-handle no-undo.
      512     define output parameter p-report-name as character no-undo .
      513     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      514   end procedure.
      515   procedure prn-lib-reportviewer-report-name :
      516     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      517     define input parameter p-report-name-html as character no-undo .
      518     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      519   end procedure.
      520   procedure prn-lib-reportviewer :
      521     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      522     define input parameter p-report-name-html as character no-undo .
      523     define input parameter p-param        as character no-undo .
      524     define variable v-excel           as character no-undo init 'TRUE' .
      525     define variable v-value-character as character no-undo .
      526     define variable v-value-integer   as character no-undo .
      527     define variable v-value-date      as date      no-undo .
      528     define variable v-value-decimal   as decimal   no-undo .
      529     define variable rep-excel         as logical   no-undo .
      530     define variable excel-string      as character no-undo .
      531     define variable v-param-type      as character no-undo .
      532     define variable v-tth             as handle    no-undo .
      533     run adm/shattri.p (
      534       input "get":U
      535       ,input  ""
      536       ,input  0
      537       ,input  'report-glob':U
      538       ,input  'rep-excel':U
      539       ,output v-value-character
      540       ,output v-value-date
      541       ,output v-value-decimal
      542       ,output v-value-integer
      543       ,output rep-excel
      544       ,output v-param-type
      545       ,INPUT-OUTPUT table-handle v-tth
      546       )  .
      547     if rep-excel then v-excel = "TRUE" .
      548     else v-excel = "FALSE" .
      549     if p-param eq ""
      550     then
      551        p-param = "EXCEL:" + v-excel.
      552     else
      553        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      554     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      555   end procedure.
      556   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      557   procedure cur-time :
      558      define output parameter p-today as date      no-undo .
      559      define output parameter p-time  as integer   no-undo .
      560     do
      561     on error undo, return error
      562     :
      563       define variable v-date1 as date      no-undo .
      564       define variable v-date2 as date      no-undo .
      565       define variable v-time  as integer   no-undo .
      566       assign
      567         v-date1 = today
      568         v-time  = time
      569         v-date2 = today
      570       .
      571       if v-date1 <> v-date2
      572       then do:
      573         assign
      574           v-date1 = today
      575           v-time  = v-time
      576         .
      577       end.
      578       assign
      579         p-today = v-date1
      580         p-time  = v-time
      581       .
      582     end.
      583   end.
      584   function cur-time-date returns character
      585   :
      586     return string(today, '99/99/9999':U) .
      587   end.
      588   function cur-time-mjd returns decimal
      589   :
      590     define variable v-date as date      no-undo .
      591     define variable v-time as integer   no-undo .
      592     run cur-time in this-procedure
      593       (output v-date
      594       ,output v-time
      595       ) .
      596     return integer(v-date) - 2400002 + (v-time / 86400) .
      597   end.
      598   function cur-time-get-ending-index returns integer
      599   (input p-number as integer
      600   )
      601   :
      602     if p-number < 0
      603     or p-number = ?
      604     then do:
      605       return 1 .
      606     end.
      607     define variable v-rest as integer   no-undo .
      608     assign
      609       p-number = p-number modulo 100
      610     .
      611     if p-number < 20
      612     then do:
      613       assign
      614         v-rest = p-number
      615       .
      616     end.
      617     else do:
      618       assign
      619         v-rest = p-number modulo 10
      620       .
      621     end.
      622     case v-rest :
      623       when 1
      624       then do:
      625         return 2 .
      626       end.
      627       when 2 or
      628       when 3 or
      629       when 4
      630       then do:
      631         return 3 .
      632       end.
      633       otherwise do:
      634         return 1 .
      635       end.
      636     end case .
      637   end.
      638   procedure cur-time-mjd-to-date :
      639      define input  parameter i-mjd-diff as decimal no-undo.
      640      define output parameter o-Date     as date    no-undo.
      641      define output parameter o-Time     as integer no-undo.
      642      define variable v-day-number as integer   no-undo .
      643      if    i-mjd-diff < 0
      644         or i-mjd-diff = ?
      645      then do:
      646         return "?" .
      647      end.
      648      assign
      649         v-day-number = truncate(i-mjd-diff,0).
      650         o-Date = date(v-day-number + 2400002).
      651         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      652     .
      653   end.
      654   function cur-time-mjd-to-string returns character
      655   (input p-mjd-diff as decimal
      656   )
      657   :
      658     define variable v-day-number as integer   no-undo .
      659     define variable v-seconds    as integer   no-undo .
      660     define variable v-hour       as integer   no-undo .
      661     define variable v-min        as integer   no-undo .
      662     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      663     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      664     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      665     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      666     if p-mjd-diff < 0
      667     or p-mjd-diff = ?
      668     then do:
      669       return "?" .
      670     end.
      671     assign
      672       v-day-number = integer(truncate(p-mjd-diff,0))
      673       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      674     .
      675     if v-seconds > 86400
      676     then do:
      677       assign
      678         v-seconds = 86400 - 1
      679       .
      680     end.
      681     if v-seconds < 0
      682     then do:
      683       assign
      684         v-seconds = 0
      685       .
      686     end.
      687     assign
      688       v-hour = truncate(v-seconds / 3600, 0)
      689     .
      690     assign
      691       v-seconds = v-seconds modulo 3600
      692     .
      693     assign
      694       v-min = truncate(v-seconds / 60, 0)
      695     .
      696     assign
      697       v-seconds = v-seconds modulo 60
      698     .
      699     return
      700         (if v-day-number <> 0
      701           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      702           else ""
      703         )
      704       + (if v-day-number <> 0 or v-hour <> 0
      705           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      706           else ""
      707         )
      708       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      709           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      710           else ""
      711         )
      712       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      713       .
      714   end.
      715   function cur-time-string returns character
      716   :
      717     define variable v-date as date      no-undo .
      718     define variable v-time as integer   no-undo .
      719     run cur-time in this-procedure
      720       (output v-date
      721       ,output v-time
      722       ) .
      723     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      724   end.
      725   function cur-time-string-sec returns character
      726   :
      727     define variable v-date as date      no-undo .
      728     define variable v-time as integer   no-undo .
      729     run cur-time in this-procedure
      730       (output v-date
      731       ,output v-time
      732       ) .
      733     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      734   end.
      735   function cur-time-custom  returns character
      736   (input p-prefix as character
      737   ,input p-date-format as character
      738   ,input p-delimiter as character
      739   ,input p-time-format as character
      740   ,input p-suffix as character
      741   )
      742   :
      743     define variable v-date as date      no-undo .
      744     define variable v-time as integer   no-undo .
      745     run cur-time in this-procedure
      746       (output v-date
      747       ,output v-time
      748       ) .
      749     return
      750       p-prefix
      751       + string(v-date, p-date-format)
      752       + p-delimiter
      753       + string(v-time, p-time-format)
      754       + p-suffix
      755       .
      756   end.
      757   function cur-time-print  returns character
      758   :
      759     define variable v-date as date      no-undo .
      760     define variable v-time as integer   no-undo .
      761     run cur-time in this-procedure
      762       (output v-date
      763       ,output v-time
      764       ) .
      765     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      766   end.
      767   function cur-time-datetime returns datetime
      768   :
      769     define variable v-char as character no-undo .
      770     define variable v-datetime as datetime no-undo .
      771     v-char = cur-time-string().
      772     v-datetime = datetime(v-char).
      773     return  v-datetime.
      774   end.
      775   function cur-time-string-msec returns character
      776   :
      777     define variable v-date as datetime  no-undo .
      778     v-date = now.
      779     return string(v-date) .
      780   end.
      781   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      782   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      783   define temp-table temp-drt-prop no-undo like ub.drt-prop.
      784   procedure disrules-fill-properties:
      785   define input  parameter p-templ-rl-root as integer   no-undo .
      786   define buffer buf_drt-prop for ub.drt-prop.
      787   define buffer buf_temp-drt-prop for temp-drt-prop.
      788   do
      789   on error undo, return error return-value
      790   :
      791     for each buf_temp-drt-prop:
      792       delete buf_temp-drt-prop.
      793     end.
      794     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
      795       create buf_temp-drt-prop.
      796       buffer-copy buf_drt-prop to buf_temp-drt-prop.
      797     end.
      798   end.
      799   end procedure.
      800   ~
      801   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      802   procedure discfgru-check :
      803   define input parameter p-table-name as character no-undo .
      804   define input parameter p-templ-rl-root as integer no-undo .
      805   define input parameter p-time-templ-rl-root as integer no-undo .
      806   define input parameter p-pos-type as character no-undo .
      807   define output parameter p-disnct-role as character no-undo .
      808   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      809     do
      810     on error undo, return error return-value
      811     :
      812       find first buf_dis-cfg-rule no-lock where
      813               buf_dis-cfg-rule.table-name = p-table-name
      814           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
      815           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
      816           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
      817       if not available buf_dis-cfg-rule
      818       or p-pos-type = "":U
      819       then do:
      820          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
      821                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
      822                                  , p-templ-rl-root
      823                                  , (if p-time-templ-rl-root = ?
      824                                     then '':U
      825                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
      826                                     )
      827                                  ).
      828       end.
      829       assign
      830       p-disnct-role = buf_dis-cfg-rule.discnt-role
      831       .
      832     end.
      833   end procedure.
      834   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      835   FUNCTION get-region RETURNS CHARACTER
      836     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      837     define variable par-region as character no-undo.
      838     if parhost-code = 0 and
      839          parobj-type = "":U and
      840          parobj-code = 0 then do:
      841          par-region = "Глобально".
      842          return par-region.
      843       end.
      844       if parobj-type = 'орг':U then do:
      845          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      846          return par-region.
      847       end.
      848       if parobj-type = 'регион':U
      849       then do:
      850          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      851          return par-region.
      852       end.
      853       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      854       return par-region.
      855   END FUNCTION.
      856   FUNCTION get-objregion RETURNS CHARACTER
      857     (  input parobj-type as character, input parobj-code as integer ) :
      858     define variable par-region as character no-undo.
      859     if  parobj-type = "":U and
      860         parobj-code = 0
      861     then do:
      862        par-region = "Глобально".
      863     end.
      864     else if parobj-type = 'орг':U
      865     then do:
      866        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      867     end.
      868     else if parobj-type = 'регион':U
      869     then do:
      870        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      871     end.
      872     else
      873        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      874     return par-region.
      875   END FUNCTION.
      876   procedure disgrpru-name :
      877   define buffer buf_dis-rule for ub.dis-rule.
      878   do
      879     on error undo, return error
      880     :
      881     define input  parameter p-templ-rl-root  as integer no-undo .
      882     define output parameter p-label          as character no-undo .
      883     find first buf_dis-rule no-lock where
      884               buf_dis-rule.rule-num = p-templ-rl-root no-error.
      885     if available buf_dis-rule then do:
      886       if buf_dis-rule.rule-num > 0 then
      887       p-label = buf_dis-rule.des.
      888     end.
      889     else do:
      890       p-label = substitute("Неизвестный тип правила скидки &1", p-templ-rl-root).
      891     end.
      892   end.
      893   end procedure.
      894   function disgrpru-get-disc-label returns character ( input p-templ-rl-root as integer):
      895   define variable v-rule-label as character no-undo .
      896   run disgrpru-name in this-procedure ( input p-templ-rl-root
      897                                        ,output v-rule-label) no-error.
      898   return v-rule-label.
      899   end function.
      900   function disgrpru-get-disc-role-label returns character ( input p-discnt-role as character):
      901   define variable v-role-label as character no-undo .
      902   v-role-label =  entry (lookup (p-discnt-role, 'gds-grp-pcnt,gds-grp-pcnt-kat,gds-grp-abs,gds-grp-qnty,gds-grp-sum':u) + 1, ',' + '% скидка на группу товара,% скидка на группу товара для кат.клиентов,Abs скидка на группу товара,% Скидка на группу товара по кол-ву,% Скидка на группу товара на сумму':u).
      903   if v-role-label = '':u then do:
      904     v-role-label = entry (lookup (p-discnt-role, 'cli-grp-pcnt':u) + 1, ',' + '% скидка на группу клиентов':u).
      905   end.
      906   return v-role-label.
      907   end function.
      908   procedure disgrpru-write :
      909     do
      910     on error undo, return error
      911     :
      912       define input parameter p-classif-type   like ub.dis-grp-rule.classif-type no-undo .
      913       define input parameter p-node-code      like ub.dis-grp-rule.node-code  no-undo .
      914       define input parameter p-host-code      like ub.dis-grp-rule.host-code no-undo .
      915       define input parameter p-obj-type       like ub.dis-grp-rule.obj-type   no-undo .
      916       define input parameter p-obj-code       like ub.dis-grp-rule.obj-code   no-undo .
      917       define input parameter p-pos-type       like ub.dis-grp-rule.pos-type   no-undo .
      918       define input parameter p-discnt-role    like ub.dis-grp-rule.discnt-role no-undo .
      919       define input parameter p-templ-rl-root  like ub.dis-grp-rule.templ-rl-root  no-undo .
      920       define input parameter p-time-templ-rl-root  like ub.dis-grp-rule.time-templ-rl-root  no-undo .
      921       define input parameter p-rule-num       like ub.dis-grp-rule.rule-num    no-undo .
      922       define input parameter p-nonunique      like ub.dis-grp-rule.nonunique   no-undo .
      923       define buffer buf_dis-grp-rule for ub.dis-grp-rule .
      924       define buffer lock_dis-grp-rule for ub.dis-grp-rule .
      925       define buffer buf_dis-rule for ub.dis-rule.
      926       define variable v-label          as character no-undo .
      927       define variable v-discnt-role as character no-undo .
      928       define variable v-host-code as integer no-undo .
      929       run discfgru-check in this-procedure (
      930                                             input 'dis-grp-rule':U
      931                                            ,input p-templ-rl-root
      932                                            ,input p-time-templ-rl-root
      933                                            ,input p-pos-type
      934                                            ,output v-discnt-role
      935                                             ) no-error .
      936       if error-status :error then do:
      937         undo, return error return-value .
      938       end.
      939      if p-discnt-role = ? then do:
      940         p-discnt-role = v-discnt-role.
      941       end.
      942       if p-discnt-role <> v-discnt-role then do:
      943         undo, return error substitute("Группа с кодом &1 &2 место использ.&3 уже есть скидка типа &4&5не может быть по шаблону &6 и расписанию &7"
      944                                 ,p-node-code
      945                                 ,p-obj-type + string(p-obj-code)
      946                                 ,p-pos-type
      947                                 ,entry (lookup (p-discnt-role, 'gds-grp-pcnt,gds-grp-pcnt-kat,gds-grp-abs,gds-grp-qnty,gds-grp-sum':u) + 1, ',' + '% скидка на группу товара,% скидка на группу товара для кат.клиентов,Abs скидка на группу товара,% Скидка на группу товара по кол-ву,% Скидка на группу товара на сумму':u)
      948                                 ,chr(10)
      949                                 ,p-templ-rl-root
      950                                 ,p-rule-num).
      951       end.
      952       if p-pos-type = ? then do:
      953   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      954   define variable v-param-type9 as character no-undo .
      955   define variable v-value-date9 as date no-undo .
      956   define variable v-value-decimal9 as decimal no-undo .
      957   define variable v-value-integer9 as INTEGER no-undo .
      958   define variable v-value-logical9 AS LOGICAL no-undo .
      959   define variable v-tth9 as handle no-undo .
      960   run adm/shattri.p (
      961       input "get":U
      962       ,input  p-obj-type
      963       ,input  p-obj-code
      964       ,input  'cd-sending':U
      965       ,input  'dflt-cd':U
      966       ,output p-pos-type
      967       ,output v-value-date9
      968       ,output v-value-decimal9
      969       ,output v-value-integer9
      970       ,output v-value-logical9
      971       ,output v-param-type9
      972       ,INPUT-OUTPUT table-handle v-tth9
      973       )  .
      974   delete object v-tth9 no-error.
      975       end.
      976       find first buf_dis-rule no-lock where
      977                 buf_dis-rule.rule-num = p-rule-num no-error.
      978       if not available buf_Dis-rule then do:
      979         undo, return error substitute("Группа с кодом &1 &2 место использ.&3 уже есть скидка типа &4&5не найдено правило скидки &6"
      980                                 ,p-node-code
      981                                 ,p-obj-type + string(p-obj-code)
      982                                 ,p-pos-type
      983                                 ,entry (lookup (p-discnt-role, 'gds-grp-pcnt,gds-grp-pcnt-kat,gds-grp-abs,gds-grp-qnty,gds-grp-sum':u) + 1, ',' + '% скидка на группу товара,% скидка на группу товара для кат.клиентов,Abs скидка на группу товара,% Скидка на группу товара по кол-ву,% Скидка на группу товара на сумму':u)
      984                                 ,chr(10)
      985                                 ,p-rule-num).
      986       end.
      987       if buf_dis-rule.root <> yes then do:
      988         undo, return error substitute("Группа с кодом &1 &2 место использ.&3 уже есть скидка типа &4&5правило скидки &6 - некорневое"
      989                                 ,p-node-code
      990                                 ,p-obj-type + string(p-obj-code)
      991                                 ,p-pos-type
      992                                 ,entry (lookup (p-discnt-role, 'gds-grp-pcnt,gds-grp-pcnt-kat,gds-grp-abs,gds-grp-qnty,gds-grp-sum':u) + 1, ',' + '% скидка на группу товара,% скидка на группу товара для кат.клиентов,Abs скидка на группу товара,% Скидка на группу товара по кол-ву,% Скидка на группу товара на сумму':u)
      993                                 ,chr(10)
      994                                 ,p-rule-num).
      995       end.
      996       if not (p-obj-type = buf_dis-rule.obj-type
      997           and p-obj-code = buf_dis-rule.obj-code) then do:
      998         undo, return error (substitute("Группа с кодом &1 &2 место использ.&3 уже есть скидка типа &4&5правило скидки &6"
      999                                 ,p-node-code
     1000                                 ,p-obj-type + string(p-obj-code)
     1001                                 ,p-pos-type
     1002                                 ,entry (lookup (p-discnt-role, 'gds-grp-pcnt,gds-grp-pcnt-kat,gds-grp-abs,gds-grp-qnty,gds-grp-sum':u) + 1, ',' + '% скидка на группу товара,% скидка на группу товара для кат.клиентов,Abs скидка на группу товара,% Скидка на группу товара по кол-ву,% Скидка на группу товара на сумму':u)
     1003                                 ,chr(10)
     1004                                 ,p-rule-num)
     1005                             +
     1006                             substitute("Правило скидки &1 определено для &1&2" +
     1007                                        "а привязка к ДК для &3"
     1008                                        ,get-region( buf_Dis-rule.host-code, buf_dis-rule.obj-type, buf_Dis-rule.obj-code)
     1009                                        ,chr(10)
     1010                                        ,get-region( p-host-code, p-obj-type, p-obj-code)
     1011                                        ))
     1012                                 .
     1013       end.
     1014       find first buf_dis-grp-rule exclusive-lock where
     1015                  buf_dis-grp-rule.classif-type  = p-classif-type
     1016              AND buf_dis-grp-rule.node-code  = p-node-code
     1017              AND buf_dis-grp-rule.host-code  = p-host-code
     1018              AND buf_dis-grp-rule.obj-type  = p-obj-type
     1019              AND buf_dis-grp-rule.obj-code  = p-obj-code
     1020              AND buf_dis-grp-rule.pos-type  = p-pos-type
     1021              AND buf_dis-grp-rule.discnt-role = p-discnt-role
     1022              and buf_dis-grp-rule.nonunique = p-nonunique
     1023              no-error .
     1024       if not available buf_dis-grp-rule then do:
     1025         create buf_dis-grp-rule .
     1026         assign
     1027         buf_dis-grp-rule.classif-type  = p-classif-type
     1028         buf_dis-grp-rule.node-code  = p-node-code
     1029         buf_dis-grp-rule.obj-type  = p-obj-type
     1030         buf_dis-grp-rule.obj-code  = p-obj-code
     1031         buf_dis-grp-rule.host-code  = p-host-code
     1032         buf_dis-grp-rule.pos-type = p-pos-type
     1033         buf_dis-grp-rule.discnt-role = v-discnt-role
     1034         buf_dis-grp-rule.rule-num = p-rule-num
     1035         buf_dis-grp-rule.nonunique = p-nonunique
     1036         no-error
     1037         .
     1038       end.
     1039       ASSIGN
     1040       buf_dis-grp-rule.rule-num = p-rule-num
     1041       buf_dis-grp-rule.rl-root = p-rule-num
     1042       buf_dis-grp-rule.templ-rl-root = p-templ-rl-root
     1043       buf_dis-grp-rule.time-templ-rl-root = p-time-templ-rl-root
     1044       buf_dis-grp-rule.nonunique = p-nonunique
     1045       no-error.
     1046     end.
     1047   end procedure.
     1048   procedure disgrpru-delete :
     1049   define input parameter p-classif-type   like ub.dis-grp-rule.classif-type no-undo .
     1050   define input parameter p-node-code      like ub.dis-grp-rule.node-code  no-undo .
     1051   define input parameter p-host-code      like ub.dis-grp-rule.host-code   no-undo .
     1052   define input parameter p-obj-type       like ub.dis-grp-rule.obj-type   no-undo .
     1053   define input parameter p-obj-code       like ub.dis-grp-rule.obj-code   no-undo .
     1054   define input parameter p-pos-type       like ub.dis-grp-rule.pos-type   no-undo .
     1055   define input parameter p-discnt-role    like ub.dis-grp-rule.discnt-role no-undo .
     1056   define input parameter p-nonunique      like ub.dis-grp-rule.nonunique   no-undo .
     1057   define output parameter p-deleted       as logical no-undo .
     1058   define variable v-rule-label as character no-undo .
     1059   define buffer buf_dis-grp-rule for ub.dis-grp-rule.
     1060   do
     1061   on error undo, return error
     1062   :
     1063   find first buf_dis-grp-rule exclusive-lock where
     1064               buf_dis-grp-rule.classif-type  = p-classif-type
     1065           AND buf_dis-grp-rule.node-code  = p-node-code
     1066           AND buf_dis-grp-rule.obj-type  = p-obj-type
     1067           AND buf_dis-grp-rule.host-code = p-host-code
     1068           AND buf_dis-grp-rule.obj-code  = p-obj-code
     1069           AND buf_dis-grp-rule.pos-type  = p-pos-type
     1070           AND buf_dis-grp-rule.discnt-role = p-discnt-role
     1071           and buf_dis-grp-rule.nonunique = p-nonunique
     1072           no-error .
     1073   if not available buf_dis-grp-rule then do:
     1074     return '':U.
     1075   end.
     1076   delete buf_dis-grp-rule no-error.
     1077   if error-status:error then do:
     1078     run disgrpru-name in this-procedure
     1079       (input  buf_dis-grp-rule.templ-rl-root
     1080       ,output v-rule-label
     1081       ) no-error .
     1082     undo, return error substitute("Ошибка при удалении скидки по группе:&1" +
     1083                                  "&2 (место использ. &3) на фирме &4 &5&6 для группы &7&1&8&1&9"
     1084                                   ,chr(10)
     1085                                   ,v-rule-label
     1086                                   ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
     1087                                   ,p-host-code
     1088                                   ,p-obj-type
     1089                                   ,p-obj-code
     1090                                   ,error-status:get-message(1)
     1091                                   ,return-value ).
     1092   end.
     1093   p-deleted = yes.
     1094   return '':U.
     1095   end.
     1096   end procedure.
     1097   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1098   FUNCTION mark-string RETURNS CHARACTER
     1099     ( input p-recid as recid, input mark-list as character  ) :
     1100     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     1101   END FUNCTION.
     1102   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1103   function usrfulnf returns character ( input p-user-id as character):
     1104   define variable v-user-name as character no-undo .
     1105   define variable vss-include-info12 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1106   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
     1107     (input  p-user-id
     1108     ,output v-user-name
     1109     ) no-error .
     1110   if error-status:error
     1111   or v-user-name = ""
     1112   then do:
     1113     return p-user-id.
     1114   end.
     1115   else do:
     1116     return v-user-name.
     1117   end.
     1118   end function.
     1119   define variable v-rid-list as character no-undo .
     1120   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
     1121   define variable sort-column-name as character no-undo .
     1122   define variable v-db-num LIKE ub.db.db-num no-undo.
     1123   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1124   define   temp-table temp-changes no-undo
     1125   field f_name as character
     1126   field l_name as character
     1127   field v_old as character
     1128   field v_new as character
     1129   field t_name as character
     1130   field num_ as integer
     1131   field uniq-key-rec as character
     1132   field action as integer
     1133   field fNotChange as logical
     1134   index pi is unique primary
     1135   num_
     1136   t_name
     1137   f_name
     1138   index
     1139   Chan
     1140   fnotChange
     1141   t_name
     1142   f_name
     1143   index imain uniq-key-rec
     1144   .
     1145   FUNCTION get-all-fields returns character (p-file-name as character ):
     1146   define variable v-dop as character no-undo .
     1147     find first _file no-lock where _file._file-name = p-file-name no-error .
     1148     if not available _file then return "":U.
     1149     for each _field no-lock where
     1150              _field._file-recid = recid(_file) :
     1151       assign
     1152       v-dop = v-dop + _field._field-name + chr(44)
     1153       .
     1154     end.
     1155     return trim(v-dop).
     1156   END FUNCTION.
     1157   PROCEDURE proc-full-temp-changes :
     1158     define input  parameter p-act-create as logical   no-undo .
     1159     define input  parameter p-act-delete as logical   no-undo .
     1160     define input  parameter p-hst-handle as handle    no-undo .
     1161     define input  parameter p-main-table as character no-undo .
     1162     define input  parameter p-field-list as character no-undo .
     1163     define input  parameter p-label-form as character no-undo .
     1164     define variable h-new-buf         as handle    no-undo .
     1165     define variable h-main-buf        as handle    no-undo .
     1166     define variable h-for-comp        as handle    no-undo .
     1167     define variable v-inform          as character no-undo .
     1168     define variable v-ind             as integer   no-undo .
     1169     define variable v-idx-field-qnty  as integer   no-undo .
     1170     define variable v-num-entries     as integer   no-undo .
     1171     define variable fh                as handle    no-undo .
     1172     define variable fh-main           as handle    no-undo .
     1173     define variable fh-old            as handle    no-undo .
     1174     define variable fh-new            as handle    no-undo .
     1175     define variable v-field-name      as character no-undo .
     1176     define variable v-field-lvl       as character no-undo .
     1177     define variable v-field-form      as character no-undo .
     1178     define variable v-search-exp      as character no-undo .
     1179     define variable v-srch-main       as character no-undo .
     1180     define variable v-word-link       as character no-undo .
     1181     define variable v-av-chip-num     as logical   no-undo .
     1182     define variable v-main-pi-fld-lst as character no-undo .
     1183     define variable v-main-fld-lst    as character no-undo .
     1184     define variable v-delim-list      as character no-undo .
     1185     define variable v-label           as character no-undo .
     1186     define variable v-old-value       as character no-undo case-sensitive.
     1187     define variable v-new-value       as character no-undo case-sensitive.
     1188     define variable v-chg-fields as character no-undo.
     1189     for each temp-changes:
     1190       delete temp-changes.
     1191     end.
     1192     if not p-hst-handle:available then do:
     1193       return .
     1194     end.
     1195     create buffer h-new-buf  for table p-hst-handle .
     1196     create buffer h-main-buf for table p-main-table .
     1197     assign
     1198       v-inform = h-main-buf:index-information(1)
     1199       v-ind    = 2
     1200     .
     1201     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1202     on error undo, return error
     1203     :
     1204       assign
     1205         v-inform = h-main-buf:index-information( v-ind )
     1206         v-ind    = v-ind + 1
     1207       .
     1208     end.
     1209     if v-inform = ?
     1210       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1211       or entry( 3, v-inform, ",":U ) <> "1":U
     1212     then do:
     1213       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1214     end.
     1215     assign
     1216       v-idx-field-qnty = num-entries( v-inform ) - 4
     1217     .
     1218     if v-idx-field-qnty < 2 then do:
     1219       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1220     end.
     1221     assign
     1222       v-srch-main   = "where":U
     1223       v-word-link   = "":U
     1224       v-av-chip-num = false
     1225       v-delim-list  = "":U
     1226     .
     1227     do v-ind = 1 to v-idx-field-qnty by 2
     1228     on error undo, return error
     1229     :
     1230       assign
     1231         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1232         fh                = p-hst-handle:buffer-field( v-field-name )
     1233         fh-main           = h-main-buf:buffer-field( v-field-name )
     1234         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1235         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1236       .
     1237       if fh:data-type ="character":U then do:
     1238         assign
     1239           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1240         .
     1241       end.
     1242       else do:
     1243         assign
     1244           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1245         .
     1246       end.
     1247       if v-delim-list = "":U then do:
     1248         assign
     1249           v-delim-list = ",":U
     1250         .
     1251       end.
     1252       if v-word-link = "":U then do:
     1253         assign
     1254           v-word-link = "and":U
     1255         .
     1256       end.
     1257     end.
     1258     assign
     1259       v-delim-list  = "":U
     1260     .
     1261     do v-ind = 1 to h-main-buf:num-fields
     1262     on error undo, return error
     1263     :
     1264       assign
     1265         fh-main      = h-main-buf:buffer-field( v-ind )
     1266         v-field-name = fh-main:name
     1267       .
     1268         assign
     1269           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1270         .
     1271         if v-delim-list = "":U then do:
     1272           assign
     1273             v-delim-list = ",":U
     1274           .
     1275         end.
     1276     end.
     1277     assign
     1278       v-inform = p-hst-handle:index-information(1)
     1279       v-ind    = 2
     1280     .
     1281     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1282     on error undo, return error
     1283     :
     1284       assign
     1285         v-inform = p-hst-handle:index-information( v-ind )
     1286         v-ind    = v-ind + 1
     1287       .
     1288     end.
     1289     if v-inform = ?
     1290       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1291       or entry( 3, v-inform, ",":U ) <> "1":U
     1292     then do:
     1293       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1294     end.
     1295     assign
     1296       v-idx-field-qnty = num-entries( v-inform ) - 4
     1297     .
     1298     if v-idx-field-qnty < 2 then do:
     1299       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1300     end.
     1301     assign
     1302       v-search-exp  = "where":U
     1303       v-word-link   = "":U
     1304       v-av-chip-num = false
     1305     .
     1306     do v-ind = 1 to v-idx-field-qnty by 2
     1307     on error undo, return error
     1308     :
     1309       assign
     1310         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1311         fh           = p-hst-handle:buffer-field( v-field-name )
     1312         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1313       .
     1314       if v-field-name = "chip-num":U then do:
     1315         assign
     1316           v-search-exp  = substitute( "&1 >", v-search-exp )
     1317           v-av-chip-num = true
     1318         .
     1319       end.
     1320       else do:
     1321         assign
     1322           v-search-exp = substitute( "&1 =", v-search-exp )
     1323         .
     1324       end.
     1325       if fh:data-type ="character":U then do:
     1326         assign
     1327           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1328         .
     1329       end.
     1330       else do:
     1331         assign
     1332           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1333         .
     1334       end.
     1335       if v-word-link = "":U then do:
     1336         assign
     1337           v-word-link = "and":U
     1338         .
     1339       end.
     1340     end.
     1341     if v-av-chip-num = false then do:
     1342       message
     1343         vss-workfile vss-revision vss-description skip
     1344         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1345         "Использование данной процедуры невозможно!" skip
     1346         view-as alert-box error .
     1347       return error .
     1348     end.
     1349     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1350     if not h-new-buf:available then do:
     1351       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1352       if not h-main-buf:available then do:
     1353         assign
     1354           h-for-comp = ?
     1355         .
     1356       end.
     1357       else do:
     1358         assign
     1359           h-for-comp = h-main-buf
     1360         .
     1361       end.
     1362     end.
     1363     else do:
     1364       assign
     1365         h-for-comp = h-new-buf
     1366       .
     1367     end.
     1368     assign
     1369       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1370     .
     1371     do v-ind = 1 to v-num-entries
     1372     on error undo, return error return-value
     1373     :
     1374       assign
     1375         v-field-name = entry( v-ind, v-main-fld-lst )
     1376         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1377         v-old-value  = fh-old:buffer-value()
     1378         v-label      = trim( fh-old:label )
     1379       .
     1380       if ( trim( p-field-list ) <> "":U
     1381            and lookup( v-field-name, p-field-list ) > 0
     1382          )
     1383          or trim( p-field-list ) = "":U
     1384       then do:
     1385         if h-for-comp <> ? then do:
     1386           assign
     1387             fh-new      = h-for-comp:buffer-field( v-field-name )
     1388             v-new-value = fh-new:buffer-value()
     1389           .
     1390         end.
     1391         else do:
     1392           assign
     1393             v-new-value = "":U
     1394           .
     1395         end.
     1396           if p-act-create = true then do:
     1397             assign
     1398               v-old-value = "":U
     1399             .
     1400           end.
     1401           if p-act-delete = true then do:
     1402             assign
     1403               v-new-value = "":U
     1404             .
     1405           end.
     1406         if v-old-value <> v-new-value
     1407         then do:
     1408           create temp-changes.
     1409           assign
     1410             temp-changes.t_name = p-main-table
     1411             temp-changes.f_name = v-field-name
     1412             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1413             temp-changes.v_old  = trim( v-old-value )
     1414             temp-changes.v_new  = trim( v-new-value )
     1415             temp-changes.num_   = 0
     1416             temp-changes.fNotChange = v-old-value eq v-new-value
     1417           .
     1418         end.
     1419       end.
     1420     end.
     1421     assign
     1422       v-num-entries = num-entries( p-label-form, chr(8) )
     1423     .
     1424     do v-ind = 1 to v-num-entries
     1425     on error undo, return error return-value
     1426     :
     1427       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1428         assign
     1429           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1430           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1431           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1432         .
     1433         find first temp-changes
     1434           where temp-changes.f_name = v-field-name
     1435           no-error .
     1436         if available temp-changes then do:
     1437           if trim( v-field-lvl ) <> "":U then do:
     1438             assign
     1439               temp-changes.l_name = v-field-lvl
     1440             .
     1441           end.
     1442           if trim( v-field-form ) <> "":U then do:
     1443             assign
     1444               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1445             .
     1446             if h-for-comp <> ? then do:
     1447               assign
     1448                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1449               .
     1450             end.
     1451           end.
     1452         end.
     1453       end.
     1454       else do:
     1455         message
     1456           vss-workfile vss-revision vss-description skip
     1457           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1458           substitute( "список для поля '&1': '&2'"
     1459                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1460                       ,entry( v-ind, p-label-form, chr(8) )
     1461                     ) skip
     1462           substitute( "полный список: &2", p-label-form ) skip
     1463           view-as alert-box error .
     1464       end.
     1465     end.
     1466     delete object h-new-buf .
     1467     delete object h-main-buf .
     1468   END PROCEDURE.
     1469   FUNCTION get-subject RETURNS CHARACTER
     1470     ( p-subject as character )  FORWARD.
     1471   DEFINE BUTTON B-Help
     1472        LABEL "Помо&щь"
     1473        SIZE 3 BY 1
     1474        BGCOLOR 8 .
     1475   DEFINE BUTTON B-lookup
     1476        LABEL "&Просмотр"
     1477        SIZE 10 BY 1.
     1478   DEFINE BUTTON B-mark
     1479        LABEL "&*"
     1480        SIZE 3 BY 1.
     1481   DEFINE BUTTON b-quit AUTO-END-KEY
     1482        LABEL "&Выход"
     1483        SIZE 10 BY 1
     1484        BGCOLOR 8 .
     1485   DEFINE BUTTON B-sel AUTO-GO
     1486        LABEL "Вы&бор"
     1487        SIZE 10 BY 1.
     1488   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1489         VIEW-AS TEXT
     1490        SIZE 6 BY 1
     1491        FGCOLOR 4  NO-UNDO.
     1492   DEFINE QUERY BR-changes FOR
     1493         temp-changes SCROLLING.
     1494   DEFINE QUERY br-csum-grp FOR
     1495         X_c-sum-grp SCROLLING.
     1496   DEFINE BROWSE BR-changes
     1497     QUERY BR-changes DISPLAY
     1498         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1499   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1500   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1501       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.04.
     1502   DEFINE BROWSE br-csum-grp
     1503     QUERY br-csum-grp NO-LOCK DISPLAY
     1504         mark-string(recid(X_c-sum-grp), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1505         get-subject(X_c-sum-grp.subject) COLUMN-LABEL "Предмет изменений" FORMAT "X(15)":U
     1506         usrfulnf(X_c-sum-grp.corr-user-name) COLUMN-LABEL "Изменил" FORMAT "X(18)":U
     1507         X_c-sum-grp.corr-date COLUMN-LABEL "Дата!измен" FORMAT "99/99/9999":U
     1508         string(X_c-sum-grp.corr-time, "HH:MM") COLUMN-LABEL "Время!измен" FORMAT "X(5)":U
     1509         X_c-sum-grp.grp-name FORMAT "X(255)":U COLUMN-LABEL "Название группы" WIDTH 35
     1510         X_c-sum-grp.grp-code COLUMN-LABEL "Код!группы" FORMAT "999":U WIDTH 6
     1511       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 9.25 FIT-LAST-COLUMN.
     1512   DEFINE FRAME Dialog-Frame
     1513        b-quit AT ROW 1 COL 1
     1514        B-mark AT ROW 1 COL 11
     1515        B-sel AT ROW 1 COL 21
     1516        B-lookup AT ROW 1 COL 61
     1517        B-Help AT ROW 1 COL 95
     1518        br-csum-grp AT ROW 3 COL 1
     1519        BR-changes AT ROW 13 COL 1
     1520        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1521        SPACE(78.62) SKIP(20.04)
     1522       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1523            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1524            TITLE "История групп товаров на кассах"
     1525            CANCEL-BUTTON b-quit.
     1526   ASSIGN
     1527          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1528          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1529   ASSIGN
     1530          B-lookup:HIDDEN IN FRAME Dialog-Frame           = TRUE.
     1531   ON GO OF FRAME Dialog-Frame
     1532   DO:
     1533     p-rid-list = v-rid-list.
     1534   END.
     1535   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1536   DO:
     1537     APPLY "END-ERROR":U TO SELF.
     1538   END.
     1539   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1540   DO:
     1541     define variable loc#log as logical no-undo .
     1542     if available X_c-sum-grp then do:
     1543   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1544   define variable v-str-recid15 as character no-undo .
     1545   define variable v-num-entry15 as integer   no-undo .
     1546   assign
     1547     v-str-recid15 = trim( string( recid( X_c-sum-grp ) , "->>>>>>>>>>>9":U ) )
     1548     v-num-entry15 = lookup( v-str-recid15 , v-rid-list )
     1549   .
     1550   if v-num-entry15 > 0 then do:
     1551     assign
     1552       entry( v-num-entry15, v-rid-list ) = "":U
     1553       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1554     .
     1555   end.
     1556   else do:
     1557     assign
     1558       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid15
     1559     .
     1560   end.
     1561       loc#log = br-csum-grp:refresh() .
     1562       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1563           loc#log = br-csum-grp:select-next-row ().
     1564           apply "VALUE-CHANGED" to br-csum-grp in frame Dialog-Frame.
     1565       end.
     1566       if num-entries( v-rid-list ) = 0
     1567       then
     1568           hide mark-num in frame Dialog-Frame.
     1569       else
     1570           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1571     end.
     1572     apply "entry" to br-csum-grp in frame Dialog-Frame.
     1573   END.
     1574   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     1575   DO:
     1576       if ( available X_c-sum-grp ) then do:
     1577       if  ( v-rid-list = "" ) or b-mark:sensitive = no
     1578       then
     1579       v-rid-list = string( recid( X_c-sum-grp ) ) .
     1580     end.
     1581   END.
     1582   ON RETURN OF br-csum-grp IN FRAME Dialog-Frame
     1583   or MOUSE-SELECT-DBLCLICK OF br-csum-grp IN FRAME Dialog-Frame
     1584       DO:
     1585       run proc-br-csum-grp no-error.
     1586     if error-status:error then return no-apply.
     1587   END.
     1588   ON VALUE-CHANGED OF br-csum-grp IN FRAME Dialog-Frame
     1589   DO:
     1590     run proc-view-changes in this-procedure no-error.
     1591   END.
     1592   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1593   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1594   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1595   on help of frame Dialog-Frame
     1596   do:
     1597     run gbl/app_help.p
     1598       (input this-procedure :file-name
     1599       ,input ''
     1600       ,input ?
     1601       ) no-error.
     1602     if error-status :error then do:
     1603       message
     1604         "Ошибка при вызове помощи"
     1605         error-status :get-message(1)
     1606         view-as alert-box .
     1607     end.
     1608   end.
     1609   run minbtn-set in this-procedure .
     1610   on choose of b-help in frame Dialog-Frame
     1611   do:
     1612     apply "help":u to frame Dialog-Frame .
     1613   end.
     1614   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1615   procedure minbtn-set :
     1616       do
     1617           on error undo, return error return-value
     1618           :
     1619           define variable ii              as integer       no-undo .
     1620           define variable fh              as widget-handle no-undo .
     1621           define variable hh              as widget-handle no-undo .
     1622           define variable v-h             as handle        extent 4 no-undo .
     1623           define variable v-name-button   as character     no-undo .
     1624           define variable v-help-old-x    as decimal       no-undo .
     1625           define variable v-help-old-y    as decimal       no-undo .
     1626           define variable v-help-old-size as decimal       no-undo .
     1627           define variable v-frame-width   as decimal       no-undo .
     1628           define variable jj              as integer       no-undo .
     1629           do
     1630               on error undo, return error
     1631               :
     1632               assign
     1633                   v-frame-width = frame Dialog-Frame:width - 0.3
     1634                   fh            = frame Dialog-Frame:first-child
     1635                   hh            = fh:first-child
     1636                   ii            = 1
     1637                   .
     1638               do while valid-handle(hh):
     1639                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1640                   do:
     1641                       case lc(hh:name) :
     1642                           when "b-help" then
     1643                               do:
     1644                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1645                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1646                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1647                                   hh:TOOLTIP = "Помощь" .
     1648                                   v-help-old-x = hh:column .
     1649                                   v-help-old-y = hh:row    .
     1650                                   v-help-old-size = hh:width .
     1651                                   hh:width-chars = 2.5 .
     1652                               end.
     1653                           when "b-print" then
     1654                               do:
     1655                                   hh:load-image("cmp/b-print.bmp":u) .
     1656                                   hh:TOOLTIP = "Печать" .
     1657                                   v-h[ii] = hh:handle .
     1658                                   ii = ii + 1 .
     1659                                   hh:width-chars = 3 .
     1660                               end.
     1661                           when "b-history" or
     1662                           when "b-hist" then
     1663                               do:
     1664                                   hh:load-image("cmp/b-hist.bmp":u) .
     1665                                   hh:TOOLTIP = "История" .
     1666                                   v-h[ii] = hh:handle .
     1667                                   ii = ii + 1 .
     1668                                   hh:width-chars = 3 .
     1669                               end.
     1670                           when "b-sch" then
     1671                               do:
     1672                                   hh:load-image("cmp/b-sch.bmp":u) .
     1673                                   hh:TOOLTIP = "Установка Фильтра" .
     1674                                   v-h[ii] = hh:handle .
     1675                                   ii = ii + 1 .
     1676                                   hh:width-chars = 3 .
     1677                               end.
     1678                           when "b-hist-user" then
     1679                               do:
     1680                                   hh:load-image("cmp/b-hist.bmp":u) .
     1681                                   hh:TOOLTIP = "История пользователя" .
     1682                                   ii = ii + 1 .
     1683                               end.
     1684                       end case.
     1685                   end.
     1686                   hh = hh:next-sibling.
     1687               end.
     1688               b-help:column = v-frame-width - b-help:width-chars.
     1689               jj = 0.
     1690               repeat ii = 4 to 1 by -1 :
     1691                   if valid-handle (v-h[ii] ) then
     1692                   do:
     1693                       jj  = jj + 1 .
     1694                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1695                       v-h[ii]:row    = v-help-old-y .
     1696                   end.
     1697               end.
     1698           end.
     1699       end.
     1700   end procedure.
     1701   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1702   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1703   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1704   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1705   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1706   define variable v-diasize-current-frame-height as decimal   no-undo .
     1707   define variable v-diasize-change-size          as logical   no-undo .
     1708   define variable v-diasize-resize-button        as handle    no-undo .
     1709   define variable v-diasize-wndmax               as logical   no-undo .
     1710   define variable v-diasize-wndstore             as logical   no-undo .
     1711   define variable v-diasize-proc-name            as character no-undo .
     1712   define variable v-diasize-browse-handle        as handle    no-undo .
     1713   define variable v-diasize-browse-number        as integer   no-undo .
     1714   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1715   define temp-table temp-diasize-handle no-undo
     1716     field handle-value  as handle
     1717     field save-position as decimal
     1718     index xpk is primary unique handle-value
     1719     .
     1720   define temp-table temp-browse-handle no-undo
     1721     field browse-type   as character
     1722     field browse-number as integer
     1723     field browse-handle as handle
     1724     field original-size as decimal
     1725     index xpk is primary unique browse-type browse-number
     1726     index xie browse-type browse-handle
     1727   .
     1728   procedure diasize_change-height :
     1729     define input  parameter p-change-value  as decimal   no-undo .
     1730     define input  parameter p-move-resize   as logical   no-undo .
     1731     define variable v-field-group-handle    as handle    no-undo .
     1732     define variable v-object-handle         as handle    no-undo .
     1733     define variable v-frame-height          as decimal   no-undo .
     1734     define variable v-frame-virtual-height  as decimal   no-undo .
     1735     define variable v-browse-height         as decimal   no-undo .
     1736     define variable v-window-height         as decimal   no-undo .
     1737     define variable v-window-virtual-height as decimal   no-undo .
     1738     define variable v-change-sign           as integer   no-undo .
     1739     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1740     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1741     if p-change-value > 0
     1742     then do:
     1743       if frame Dialog-Frame :height + p-change-value
     1744           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1745       then do:
     1746         assign
     1747           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1748                           - (frame Dialog-Frame :height-chars)
     1749         .
     1750         if p-change-value <= 0
     1751         then do:
     1752           run diasize_position-resize-button in this-procedure .
     1753           return .
     1754         end.
     1755       end.
     1756     end.
     1757     if p-change-value < 0
     1758     then do:
     1759       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1760       then do:
     1761         assign
     1762           p-change-value = v-diasize-orig-frame-height
     1763                          - (frame Dialog-Frame :height-chars)
     1764         .
     1765         if p-change-value >= 0
     1766         then do:
     1767           run diasize_position-resize-button in this-procedure .
     1768           return .
     1769         end.
     1770       end.
     1771     end.
     1772     if p-change-value >= 0
     1773     then do:
     1774       assign
     1775         v-change-sign = 1
     1776       .
     1777     end.
     1778     else do:
     1779       assign
     1780         v-change-sign = -1
     1781       .
     1782     end.
     1783     assign
     1784       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1785     .
     1786     if p-change-value = 0
     1787     then do:
     1788       run diasize_position-resize-button in this-procedure .
     1789       return .
     1790     end.
     1791     move_block:
     1792     do
     1793     on error undo move_block, retry move_block
     1794     :
     1795       if retry
     1796       then do:
     1797         do
     1798         on error undo move_block, leave move_block
     1799         :
     1800           if p-change-value > 0
     1801           then do:
     1802             for each buf_temp-diasize-handle
     1803             on error undo, next
     1804             :
     1805               assign
     1806                 v-object-handle = buf_temp-diasize-handle.handle-value
     1807               .
     1808               if v-object-handle <> v-diasize-resize-button
     1809               then do:
     1810                 assign
     1811                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1812                 .
     1813               end.
     1814             end.
     1815             assign
     1816               v-diasize-browse-handle :height = v-browse-height
     1817             .
     1818             for each buf_temp-browse-handle
     1819               where buf_temp-browse-handle.browse-type = 'height':u
     1820             on error undo, next
     1821             :
     1822               assign
     1823                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1824               .
     1825             end.
     1826             assign
     1827               frame Dialog-Frame :height = v-frame-height
     1828             .
     1829             if frame Dialog-Frame :scrollable = true
     1830             then do:
     1831               assign
     1832                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1833               .
     1834             end.
     1835             run diasize_position-resize-button in this-procedure .
     1836           end.
     1837           else do:
     1838             if frame Dialog-Frame :scrollable = true
     1839             then do:
     1840               assign
     1841                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1842               .
     1843             end.
     1844             assign
     1845               frame Dialog-Frame :height = v-frame-height
     1846             .
     1847             assign
     1848               v-diasize-browse-handle :height = v-browse-height
     1849             .
     1850             for each buf_temp-browse-handle
     1851               where buf_temp-browse-handle.browse-type = 'height':u
     1852             on error undo, next
     1853             :
     1854               assign
     1855                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1856               .
     1857             end.
     1858             for each buf_temp-diasize-handle
     1859             on error undo, next
     1860             :
     1861               assign
     1862                 v-object-handle = buf_temp-diasize-handle.handle-value
     1863               .
     1864               if v-object-handle <> v-diasize-resize-button
     1865               then do:
     1866                 assign
     1867                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1868                 .
     1869               end.
     1870             end.
     1871             run diasize_position-resize-button in this-procedure .
     1872           end.
     1873           assign
     1874             v-diasize-change-size = false
     1875           .
     1876           leave move_block .
     1877         end.
     1878       end.
     1879       assign
     1880         v-diasize-need-full-display = true
     1881       .
     1882       if v-diasize-change-size = false
     1883       then do:
     1884         assign
     1885           v-diasize-change-size = true
     1886         .
     1887       end.
     1888       else do:
     1889         return .
     1890       end.
     1891       assign
     1892         v-frame-height = frame Dialog-Frame :height
     1893         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1894         v-browse-height = v-diasize-browse-handle :height
     1895       .
     1896       for each buf_temp-browse-handle
     1897         where buf_temp-browse-handle.browse-type = 'height':u
     1898       :
     1899         assign
     1900           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1901         .
     1902       end.
     1903       for each buf_temp-diasize-handle
     1904       :
     1905         delete buf_temp-diasize-handle .
     1906       end.
     1907       assign
     1908         v-field-group-handle = frame Dialog-Frame :first-child
     1909       .
     1910       do while valid-handle(v-field-group-handle)
     1911       :
     1912         assign
     1913           v-object-handle = v-field-group-handle :first-child
     1914         .
     1915         do while valid-handle(v-object-handle)
     1916         :
     1917           if  v-object-handle <> v-diasize-browse-handle :handle
     1918           and can-query(v-object-handle, "row")
     1919           and can-query(v-object-handle, "height")
     1920           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1921           then do:
     1922             find first buf_temp-browse-handle
     1923               where buf_temp-browse-handle.browse-type   = 'height':u
     1924                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1925               no-error .
     1926             if available buf_temp-browse-handle
     1927             then do:
     1928             end.
     1929             else do:
     1930               create buf_temp-diasize-handle .
     1931               assign
     1932                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1933                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1934               .
     1935             end.
     1936           end.
     1937           assign
     1938             v-object-handle = v-object-handle :next-sibling
     1939           .
     1940         end.
     1941         assign
     1942           v-field-group-handle = v-field-group-handle :next-sibling
     1943         .
     1944       end.
     1945       do with frame Dialog-Frame
     1946       :
     1947         hide v-diasize-resize-button .
     1948         assign
     1949           v-diasize-resize-button :row    = 1
     1950           v-diasize-resize-button :column = 1
     1951         .
     1952       end.
     1953       if p-change-value > 0
     1954       then do:
     1955         if frame Dialog-Frame :scrollable = true
     1956         then do:
     1957           assign
     1958             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1959             no-error .
     1960           if error-status :error
     1961           or error-status :get-message(1) <> ""
     1962           then do:
     1963             undo move_block, retry move_block .
     1964           end.
     1965         end.
     1966         assign
     1967           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1968           no-error .
     1969         if error-status :error
     1970         or error-status :get-message(1) <> ""
     1971         then do:
     1972           undo move_block, retry move_block .
     1973         end.
     1974         assign
     1975           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1976           no-error .
     1977         if error-status :error
     1978         or error-status :get-message(1) <> ""
     1979         then do:
     1980           undo move_block, retry move_block .
     1981         end.
     1982         for each buf_temp-browse-handle
     1983           where buf_temp-browse-handle.browse-type = 'height':u
     1984         on error undo move_block, retry move_block
     1985         :
     1986           assign
     1987             buf_temp-browse-handle.browse-handle :height
     1988               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1989             no-error .
     1990           if error-status :error
     1991           or error-status :get-message(1) <> ""
     1992           then do:
     1993             undo move_block, retry move_block .
     1994           end.
     1995         end.
     1996         for each buf_temp-diasize-handle
     1997         on error undo move_block, retry move_block
     1998         :
     1999           assign
     2000             v-object-handle = buf_temp-diasize-handle.handle-value
     2001           .
     2002           if v-object-handle <> v-diasize-resize-button
     2003           then do:
     2004             assign
     2005               v-object-handle :row = v-object-handle :row + p-change-value
     2006               no-error .
     2007             if error-status :error
     2008             or error-status :get-message(1) <> ""
     2009             then do:
     2010               undo move_block, retry move_block .
     2011             end.
     2012           end.
     2013         end.
     2014       end.
     2015       else do:
     2016         for each buf_temp-diasize-handle
     2017         on error undo move_block, retry move_block
     2018         :
     2019           assign
     2020             v-object-handle = buf_temp-diasize-handle.handle-value
     2021           .
     2022           if v-object-handle <> v-diasize-resize-button
     2023           then do:
     2024             assign
     2025               v-object-handle :row = v-object-handle :row + p-change-value
     2026               no-error .
     2027             if error-status :error
     2028             or error-status :get-message(1) <> ""
     2029             then do:
     2030               undo move_block, retry move_block .
     2031             end.
     2032           end.
     2033         end.
     2034         assign
     2035           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2036           no-error .
     2037         if error-status :error
     2038         or error-status :get-message(1) <> ""
     2039         then do:
     2040           undo move_block, retry move_block .
     2041         end.
     2042         for each buf_temp-browse-handle
     2043           where buf_temp-browse-handle.browse-type = 'height':u
     2044         on error undo move_block, retry move_block
     2045         :
     2046           assign
     2047             buf_temp-browse-handle.browse-handle :height
     2048               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2049             no-error .
     2050           if error-status :error
     2051           or error-status :get-message(1) <> ""
     2052           then do:
     2053             undo move_block, retry move_block .
     2054           end.
     2055         end.
     2056         assign
     2057           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2058           no-error .
     2059         if error-status :error
     2060         or error-status :get-message(1) <> ""
     2061         then do:
     2062           undo move_block, retry move_block .
     2063         end.
     2064         if frame Dialog-Frame :scrollable = true
     2065         then do:
     2066           assign
     2067             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2068             no-error .
     2069           if error-status :error
     2070           or error-status :get-message(1) <> ""
     2071           then do:
     2072             undo move_block, retry move_block .
     2073           end.
     2074         end.
     2075       end.
     2076       if p-move-resize = true
     2077       then do:
     2078         run diasize_position-resize-button in this-procedure .
     2079       end.
     2080       if v-diasize-wndstore = true
     2081       then do:
     2082         if connected("ub") = true
     2083         then do:
     2084           define variable v-cntxt-db-num        as integer   no-undo .
     2085           define variable v-cntxt-userid        as character no-undo .
     2086           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2087                                             , OUTPUT v-cntxt-userid
     2088                                             ) .
     2089           run gbl/wndsizew.p
     2090             (input  v-cntxt-db-num
     2091             ,input  v-cntxt-userid
     2092             ,input  v-diasize-proc-name
     2093             ,input  'height':u
     2094             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2095             ) .
     2096         end.
     2097       end.
     2098     end.
     2099     assign
     2100       v-diasize-change-size = false
     2101     .
     2102   end procedure.
     2103   procedure diasize_set-height :
     2104     define input  parameter p-new-height  as decimal   no-undo .
     2105     define input  parameter p-move-resize as logical   no-undo .
     2106     do
     2107     on error undo, return error return-value
     2108     :
     2109       run diasize_change-height in this-procedure
     2110         (input  (p-new-height - frame Dialog-Frame :height)
     2111         ,input  p-move-resize
     2112         ) .
     2113     end.
     2114   end procedure.
     2115   procedure diasize_change-width :
     2116     define input  parameter p-change-value as decimal   no-undo .
     2117     define input  parameter p-move-resize  as logical   no-undo .
     2118     define variable v-field-group-handle   as handle    no-undo .
     2119     define variable v-object-handle        as handle    no-undo .
     2120     define variable v-frame-width          as decimal   no-undo .
     2121     define variable v-frame-virtual-width  as decimal   no-undo .
     2122     define variable v-browse-width         as decimal   no-undo .
     2123     define variable v-window-width         as decimal   no-undo .
     2124     define variable v-window-virtual-width as decimal   no-undo .
     2125     define variable v-change-sign          as integer   no-undo .
     2126     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2127     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2128     if p-change-value > 0
     2129     then do:
     2130       if frame Dialog-Frame :width + p-change-value >
     2131           session :width-chars
     2132       then do:
     2133         assign
     2134           p-change-value = session :width-chars - frame Dialog-Frame :width
     2135         .
     2136         if p-change-value <= 0
     2137         then do:
     2138           run diasize_position-resize-button in this-procedure .
     2139           return .
     2140         end.
     2141       end.
     2142     end.
     2143     if p-change-value < 0
     2144     then do:
     2145       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2146       then do:
     2147         assign
     2148           p-change-value = v-diasize-orig-frame-width
     2149                          - frame Dialog-Frame :width
     2150         .
     2151         if p-change-value >= 0
     2152         then do:
     2153           run diasize_position-resize-button in this-procedure .
     2154           return .
     2155         end.
     2156       end.
     2157     end.
     2158     if p-change-value >= 0
     2159     then do:
     2160       assign
     2161         v-change-sign = 1
     2162       .
     2163     end.
     2164     else do:
     2165       assign
     2166         v-change-sign = -1
     2167       .
     2168     end.
     2169     assign
     2170       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2171     .
     2172     if p-change-value = 0
     2173     then do:
     2174       run diasize_position-resize-button in this-procedure .
     2175       return .
     2176     end.
     2177     move_block:
     2178     do
     2179     on error undo move_block, leave move_block
     2180     :
     2181       if retry
     2182       then do:
     2183         do
     2184         on error undo move_block, leave move_block
     2185         :
     2186           if p-change-value > 0
     2187           then do:
     2188             for each buf_temp-diasize-handle
     2189             on error undo, next
     2190             :
     2191               assign
     2192                 v-object-handle = buf_temp-diasize-handle.handle-value
     2193               .
     2194               if v-object-handle <> v-diasize-resize-button
     2195               then do:
     2196                 assign
     2197                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2198                 .
     2199               end.
     2200             end.
     2201             assign
     2202               v-diasize-browse-handle :width = v-browse-width
     2203             .
     2204             for each buf_temp-browse-handle
     2205               where buf_temp-browse-handle.browse-type = 'width':u
     2206             on error undo, next
     2207             :
     2208               assign
     2209                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2210               .
     2211             end.
     2212             assign
     2213               frame Dialog-Frame :width = v-frame-width
     2214             .
     2215             if frame Dialog-Frame :scrollable = true
     2216             then do:
     2217               assign
     2218                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2219               .
     2220             end.
     2221             run diasize_position-resize-button in this-procedure .
     2222           end.
     2223           else do:
     2224             if frame Dialog-Frame :scrollable = true
     2225             then do:
     2226               assign
     2227                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2228               .
     2229             end.
     2230             assign
     2231               frame Dialog-Frame :width = v-frame-width
     2232             .
     2233             for each buf_temp-browse-handle
     2234               where buf_temp-browse-handle.browse-type = 'width':u
     2235             on error undo, next
     2236             :
     2237               assign
     2238                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2239               .
     2240             end.
     2241             assign
     2242               v-diasize-browse-handle :width = v-browse-width
     2243             .
     2244             for each buf_temp-diasize-handle
     2245             on error undo, next
     2246             :
     2247               assign
     2248                 v-object-handle = buf_temp-diasize-handle.handle-value
     2249               .
     2250               if v-object-handle <> v-diasize-resize-button
     2251               then do:
     2252                 assign
     2253                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2254                 .
     2255               end.
     2256             end.
     2257             run diasize_position-resize-button in this-procedure .
     2258           end.
     2259           assign
     2260             v-diasize-change-size = false
     2261           .
     2262           leave move_block .
     2263         end.
     2264       end.
     2265       assign
     2266         v-diasize-need-full-display = true
     2267       .
     2268       if v-diasize-change-size = false
     2269       then do:
     2270         assign
     2271           v-diasize-change-size = true
     2272         .
     2273       end.
     2274       else do:
     2275         return .
     2276       end.
     2277       assign
     2278         v-frame-width = frame Dialog-Frame :width
     2279         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2280         v-browse-width = v-diasize-browse-handle :width
     2281       .
     2282       for each buf_temp-browse-handle
     2283         where buf_temp-browse-handle.browse-type = 'width':u
     2284       :
     2285         assign
     2286           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2287         .
     2288       end.
     2289       for each buf_temp-diasize-handle
     2290       :
     2291         delete buf_temp-diasize-handle .
     2292       end.
     2293       assign
     2294         v-field-group-handle = frame Dialog-Frame :first-child
     2295       .
     2296       do while valid-handle(v-field-group-handle)
     2297       :
     2298         assign
     2299           v-object-handle = v-field-group-handle :first-child
     2300         .
     2301         do while valid-handle(v-object-handle)
     2302         :
     2303           if  v-object-handle <> v-diasize-browse-handle :handle
     2304           and v-object-handle <> v-diasize-resize-button
     2305           and can-query(v-object-handle, "row")
     2306           and can-query(v-object-handle, "height")
     2307           and ( v-object-handle :col + v-object-handle :width
     2308                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2309               )
     2310           then do:
     2311             find first buf_temp-browse-handle
     2312               where buf_temp-browse-handle.browse-type   = 'width':u
     2313                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2314               no-error .
     2315             if available buf_temp-browse-handle
     2316             then do:
     2317             end.
     2318             else do:
     2319               create buf_temp-diasize-handle .
     2320               assign
     2321                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2322                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2323               .
     2324             end.
     2325           end.
     2326           assign
     2327             v-object-handle = v-object-handle :next-sibling
     2328           .
     2329         end.
     2330         assign
     2331           v-field-group-handle = v-field-group-handle :next-sibling
     2332         .
     2333       end.
     2334       do with frame Dialog-Frame
     2335       :
     2336         hide v-diasize-resize-button .
     2337         v-diasize-resize-button :row = 1.
     2338         v-diasize-resize-button :column = 1.
     2339       end.
     2340       if p-change-value > 0
     2341       then do:
     2342         if frame Dialog-Frame :scrollable = true
     2343         then do:
     2344           assign
     2345             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2346             no-error .
     2347           if error-status :error
     2348           or error-status :get-message(1) <> ""
     2349           then do:
     2350             undo move_block, retry move_block.
     2351           end.
     2352         end.
     2353         assign
     2354           frame Dialog-Frame :width = v-frame-width + p-change-value
     2355           no-error .
     2356         if error-status :error
     2357         or error-status :get-message(1) <> ""
     2358         then do:
     2359           undo move_block, retry move_block.
     2360         end.
     2361         assign
     2362           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2363         no-error .
     2364         if error-status :error
     2365         or error-status :get-message(1) <> ""
     2366         then do:
     2367           undo move_block, retry move_block.
     2368         end.
     2369         for each buf_temp-browse-handle
     2370           where buf_temp-browse-handle.browse-type = 'width':u
     2371         on error undo move_block, retry move_block
     2372         :
     2373           assign
     2374             buf_temp-browse-handle.browse-handle :width
     2375               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2376             no-error .
     2377           if error-status :error
     2378           or error-status :get-message(1) <> ""
     2379           then do:
     2380             undo move_block, retry move_block .
     2381           end.
     2382         end.
     2383         for each buf_temp-diasize-handle
     2384         on error undo move_block, retry move_block
     2385         :
     2386           assign
     2387             v-object-handle = buf_temp-diasize-handle.handle-value
     2388           .
     2389           if v-object-handle <> v-diasize-resize-button
     2390           then do:
     2391             assign
     2392               v-object-handle :col = v-object-handle :col + p-change-value
     2393               no-error .
     2394             if error-status :error
     2395             or error-status :get-message(1) <> ""
     2396             then do:
     2397               undo move_block, retry move_block .
     2398             end.
     2399           end.
     2400         end.
     2401       end.
     2402       else do:
     2403         for each buf_temp-diasize-handle
     2404         on error undo move_block, retry move_block
     2405         :
     2406           assign
     2407             v-object-handle = buf_temp-diasize-handle.handle-value
     2408           .
     2409           if v-object-handle <> v-diasize-resize-button
     2410           then do:
     2411             assign
     2412               v-object-handle :col = v-object-handle :col + p-change-value
     2413               no-error .
     2414             if error-status :error
     2415             or error-status :get-message(1) <> ""
     2416             then do:
     2417               undo move_block, retry move_block .
     2418             end.
     2419           end.
     2420         end.
     2421         for each buf_temp-browse-handle
     2422           where buf_temp-browse-handle.browse-type = 'width':u
     2423         on error undo move_block, retry move_block
     2424         :
     2425           assign
     2426             buf_temp-browse-handle.browse-handle :width
     2427               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2428             no-error .
     2429           if error-status :error
     2430           or error-status :get-message(1) <> ""
     2431           then do:
     2432             undo move_block, retry move_block .
     2433           end.
     2434         end.
     2435         assign
     2436           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2437           no-error .
     2438         if error-status :error
     2439         or error-status :get-message(1) <> ""
     2440         then do:
     2441           undo move_block, retry move_block.
     2442         end.
     2443         assign
     2444           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2445         no-error .
     2446         if error-status :error
     2447         or error-status :get-message(1) <> ""
     2448         then do:
     2449           undo move_block, retry move_block.
     2450         end.
     2451         if frame Dialog-Frame :scrollable = true
     2452         then do:
     2453           assign
     2454             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2455           no-error .
     2456           if error-status :error
     2457           or error-status :get-message(1) <> ""
     2458           then do:
     2459             undo move_block, retry move_block.
     2460           end.
     2461         end.
     2462       end.
     2463       if p-move-resize
     2464       then do:
     2465         run diasize_position-resize-button in this-procedure .
     2466       end.
     2467       if v-diasize-wndstore = true
     2468       then do:
     2469         if connected("ub") = true
     2470         then do:
     2471           define variable v-cntxt-db-num        as integer   no-undo .
     2472           define variable v-cntxt-userid        as character no-undo .
     2473           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2474                                             , OUTPUT v-cntxt-userid
     2475                                             ) .
     2476           run gbl/wndsizew.p
     2477             (input  v-cntxt-db-num
     2478             ,input  v-cntxt-userid
     2479             ,input  v-diasize-proc-name
     2480             ,input  'width':u
     2481             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2482             ) .
     2483         end.
     2484       end.
     2485     end.
     2486     assign
     2487       v-diasize-change-size = false
     2488     .
     2489   end procedure.
     2490   procedure diasize_set-width :
     2491     define input  parameter p-new-width  as decimal   no-undo .
     2492     define input  parameter p-move-resize as logical   no-undo .
     2493     do
     2494     on error undo, return error return-value
     2495     :
     2496       run diasize_change-width in this-procedure
     2497         (input  (p-new-width - frame Dialog-Frame :width)
     2498         ,input  p-move-resize
     2499         ) .
     2500     end.
     2501   end procedure.
     2502   procedure diasize_position-resize-button :
     2503     do with frame Dialog-Frame
     2504     :
     2505       hide v-diasize-resize-button .
     2506       assign
     2507         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2508                     - 1
     2509                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2510         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2511                     - 1
     2512                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2513       .
     2514       view v-diasize-resize-button .
     2515     end.
     2516   end procedure.
     2517   on alt-right anywhere
     2518   do:
     2519     run diasize_change-width in this-procedure
     2520       (input 1
     2521       ,input true
     2522       ) .
     2523     return no-apply .
     2524   end.
     2525   on alt-left anywhere
     2526   do:
     2527     run diasize_change-width in this-procedure
     2528       (input -1
     2529       ,input true
     2530       ) .
     2531     return no-apply .
     2532   end.
     2533   on alt-down anywhere
     2534   do:
     2535     run diasize_change-height in this-procedure
     2536       (input 1
     2537       ,input true
     2538       ) .
     2539     return no-apply .
     2540   end.
     2541   on alt-up anywhere
     2542   do:
     2543     run diasize_change-height in this-procedure
     2544       (input -1
     2545       ,input true
     2546       ) .
     2547     return no-apply .
     2548   end.
     2549   on alt-enter of frame Dialog-Frame
     2550   do:
     2551     run diasize_maximize in this-procedure
     2552       (input  ?
     2553       ).
     2554     return no-apply .
     2555   end.
     2556   procedure diasize_end-move :
     2557     do
     2558     on error undo, return error return-value
     2559     :
     2560       define variable v-row-delta as decimal   no-undo .
     2561       define variable v-col-delta as decimal   no-undo .
     2562       define variable v-new-row as decimal   no-undo .
     2563       define variable v-new-col as decimal   no-undo .
     2564       assign
     2565         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2566         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2567       .
     2568       assign
     2569         v-row-delta = v-new-row - frame Dialog-Frame :height
     2570         v-col-delta = v-new-col - frame Dialog-Frame :width
     2571       .
     2572       run diasize_change-height in this-procedure
     2573         (input v-row-delta
     2574         ,input true
     2575         ) .
     2576       run diasize_change-width in this-procedure
     2577         (input v-col-delta
     2578         ,input true
     2579         ) .
     2580     end.
     2581   end procedure.
     2582   procedure diasize_maximize :
     2583     define input  parameter p-action as logical   no-undo .
     2584     do
     2585     on error undo, return error return-value
     2586     :
     2587       if p-action = ?
     2588       then do:
     2589         if v-diasize-need-maximize = true
     2590         then do:
     2591           assign
     2592             p-action = true
     2593           .
     2594         end.
     2595         else do:
     2596           assign
     2597             p-action = false
     2598           .
     2599         end.
     2600       end.
     2601       if p-action = true
     2602       then do:
     2603         run diasize_change-height in this-procedure
     2604           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2605               - frame Dialog-Frame :height-chars
     2606           ,input true
     2607           ) .
     2608         run diasize_change-width in this-procedure
     2609           (input session :width-chars
     2610               - frame Dialog-Frame :width-chars
     2611           ,input true
     2612           ) .
     2613         assign
     2614           v-diasize-need-maximize = false
     2615         .
     2616       end.
     2617       else do:
     2618         run diasize_change-width in this-procedure
     2619           (input v-diasize-orig-frame-width
     2620               - frame Dialog-Frame :width-chars
     2621           ,input true
     2622           ) .
     2623         run diasize_change-height in this-procedure
     2624           (input v-diasize-orig-frame-height
     2625               - frame Dialog-Frame :height-chars
     2626           ,input true
     2627           ) .
     2628         assign
     2629           v-diasize-need-maximize = true
     2630         .
     2631       end.
     2632     end.
     2633   end procedure.
     2634   procedure diasize_restore-orig-size :
     2635     do
     2636     on error undo, return error return-value
     2637     :
     2638       assign
     2639         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2640         v-diasize-current-frame-height = frame Dialog-Frame :height
     2641       .
     2642       run diasize_set-height in this-procedure
     2643         (input  v-diasize-orig-frame-height
     2644         ,input  true
     2645         ) .
     2646       run diasize_set-width in this-procedure
     2647         (input  v-diasize-orig-frame-width
     2648         ,input  true
     2649         ) .
     2650     end.
     2651   end procedure.
     2652   procedure diasize_restore-current-size :
     2653     do
     2654     on error undo, return error return-value
     2655     :
     2656       run diasize_set-height in this-procedure
     2657         (input  v-diasize-current-frame-height
     2658         ,input  true
     2659         ) .
     2660       run diasize_set-width in this-procedure
     2661         (input  v-diasize-current-frame-width
     2662         ,input  true
     2663         ) .
     2664     end.
     2665   end procedure.
     2666   procedure diasize_set-browse-handle :
     2667     define input  parameter p-browse-handle as handle   no-undo .
     2668     define buffer buf_temp-browse-handle for temp-browse-handle .
     2669     do
     2670     on error undo, return error return-value
     2671     :
     2672       assign
     2673         v-diasize-browse-handle = p-browse-handle
     2674       .
     2675       for each buf_temp-browse-handle
     2676       on error undo, return error return-value
     2677       :
     2678         delete buf_temp-browse-handle .
     2679       end.
     2680     end.
