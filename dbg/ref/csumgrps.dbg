     2682   procedure diasize_add_browse :
     2683     define input  parameter p-browse-type   as character no-undo .
     2684     define input  parameter p-browse-handle as handle    no-undo .
     2685     define buffer buf_temp-browse-handle for temp-browse-handle .
     2686     do
     2687     on error undo, return error return-value
     2688     :
     2689       assign
     2690         v-diasize-browse-number = v-diasize-browse-number + 1
     2691       .
     2692       create buf_temp-browse-handle .
     2693       assign
     2694         buf_temp-browse-handle.browse-type   = p-browse-type
     2695         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2696         buf_temp-browse-handle.browse-handle = p-browse-handle
     2697       .
     2698     end.
