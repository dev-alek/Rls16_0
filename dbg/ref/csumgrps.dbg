     2700   procedure diasize_init :
     2701     define variable v-default-value    as logical   no-undo .
     2702     define variable v-restore-saved    as logical   no-undo .
     2703     define variable v-resize-value-str as character no-undo .
     2704     do
     2705     on error undo, return error return-value
     2706     :
     2707       do with frame Dialog-Frame
     2708       :
     2709         assign
     2710           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2711           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2712           v-diasize-browse-handle     = browse br-csum-grp :handle
     2713         .
     2714         create button v-diasize-resize-button
     2715         assign
     2716           parent        = frame Dialog-Frame :first-child
     2717           label         = "s"
     2718           height-pixels = 16
     2719           width-pixels  = 16
     2720           visible       = true
     2721           sensitive     = true
     2722           movable       = true
     2723           triggers:
     2724             on end-move persistent run diasize_end-move in this-procedure .
     2725           end triggers.
     2726         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2727         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2728         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2729         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2730         assign
     2731           v-diasize-wndmax = false
     2732         .
     2733         if connected("ub") = true
     2734         then do:
     2735           define variable v-cntxt-db-num        as integer   no-undo .
     2736           define variable v-cntxt-userid        as character no-undo .
     2737           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2738                                             , OUTPUT v-cntxt-userid
     2739                                             ) .
     2740           run gbl/wndpar_r.p
     2741             (input  v-cntxt-db-num
     2742             ,input  v-cntxt-userid
     2743             ,input  'wndmax':U
     2744             ,output v-diasize-wndmax
     2745             ,output v-default-value
     2746             ) .
     2747         end.
     2748         assign
     2749           v-diasize-wndstore = false
     2750         .
     2751         if connected("ub") = true
     2752         then do:
     2753           run gbl/wndpar_r.p
     2754             (input  v-cntxt-db-num
     2755             ,input  v-cntxt-userid
     2756             ,input  'wndstore':U
     2757             ,output v-diasize-wndstore
     2758             ,output v-default-value
     2759             ) .
     2760         end.
     2761         assign
     2762           v-diasize-proc-name = entry(1, program-name(2), '.')
     2763         .
     2764         if v-diasize-wndstore = true
     2765         then do:
     2766           assign
     2767             v-restore-saved = false
     2768           .
     2769           if connected("ub") = true
     2770           then do:
     2771             run gbl/wndsizer.p
     2772               (input  v-cntxt-db-num
     2773               ,input  v-cntxt-userid
     2774               ,input  v-diasize-proc-name
     2775               ,input  'height':u
     2776               ,output v-resize-value-str
     2777               ) .
     2778             if v-resize-value-str <> '':U
     2779             then do:
     2780               run diasize_change-height in this-procedure
     2781                 (input  integer(v-resize-value-str)
     2782                 ,input  true
     2783                 ) .
     2784               assign
     2785                 v-restore-saved = true
     2786               .
     2787             end.
     2788           end.
     2789           if connected("ub") = true
     2790           then do:
     2791             run gbl/wndsizer.p
     2792               (input  v-cntxt-db-num
     2793               ,input  v-cntxt-userid
     2794               ,input  v-diasize-proc-name
     2795               ,input  'width':u
     2796               ,output v-resize-value-str
     2797               ) .
     2798             if v-resize-value-str <> '':U
     2799             then do:
     2800               run diasize_change-width in this-procedure
     2801                 (input  integer(v-resize-value-str)
     2802                 ,input  true
     2803                 ) .
     2804               assign
     2805                 v-restore-saved = true
     2806               .
     2807             end.
     2808           end.
     2809           if v-restore-saved <> true
     2810           then do:
     2811             if v-diasize-wndmax = true
     2812             then do:
     2813               run diasize_maximize in this-procedure
     2814                 (input  true
     2815                 ) .
     2816             end.
     2817           end.
     2818         end.
     2819         else do:
     2820           if v-diasize-wndmax = true
     2821           then do:
     2822             run diasize_maximize in this-procedure
     2823               (input  true
     2824               ) .
     2825           end.
     2826         end.
     2827       end.
     2828     end.
     2829   end procedure.
     2830   procedure diasize_need-full-display :
     2831     define output parameter p-need-full-display as logical   no-undo .
     2832     do
     2833     on error undo, return error return-value
     2834     :
     2835       assign
     2836         p-need-full-display = v-diasize-need-full-display
     2837       .
     2838       assign
     2839         v-diasize-need-full-display = false
     2840       .
     2841     end.
     2842   end procedure.
     2843   procedure get-context :
     2844      define output parameter p-db-num as integer          no-undo.
     2845      define output parameter p-user-id as character        no-undo.
     2846      define variable v-login               as character    no-undo.
     2847      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2848      define buffer buf_user-login  for ub.user-login .
     2849      do
     2850      on error undo, return error
     2851      :
     2852            FIND FIRST buf_sys-ctrl no-lock.
     2853            ASSIGN
     2854               v-login = USERID("ub")
     2855               p-db-num = buf_sys-ctrl.db-num
     2856            .
     2857            FIND FIRST buf_user-login
     2858                 WHERE buf_user-login.db-num = p-db-num
     2859                   AND buf_user-login.user-login = v-login
     2860                 no-lock
     2861                 no-error
     2862                 .
     2863            IF AVAILABLE buf_user-login
     2864            THEN DO:
     2865               assign
     2866                  p-user-id = buf_user-login.user-id
     2867               .
     2868            END.
     2869      end.
     2870   end procedure.
     2871   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2872   on f5 of frame Dialog-Frame anywhere
     2873   do:
     2874     v-doc-rec = recid(X_sum-grp). run openbr in this-procedure. reposition br-csum-grp to recid v-doc-rec no-error.               apply 'value-changed' to br-csum-grp.
     2875       apply "VALUE-CHANGED" to BR-changes.
     2876   end.
     2877   def var sort-labelbr-csum-grp   as character no-undo .
     2878   def var sort-clmnbr-csum-grp    as handle    no-undo .
     2879   def var cur-clmnbr-csum-grp     as handle    no-undo .
     2880   def var cur-clmn-locbr-csum-grp as integer   no-undo .
     2881   def var re-querybr-csum-grp     as logical   initial no no-undo .
     2882   on start-search, ctrl-o of br-csum-grp in frame Dialog-Frame do:
     2883      run sort-brbr-csum-grp
     2884        (input (if available temp-changes
     2885                then recid(temp-changes)
     2886                else ?
     2887               )
     2888        ).
     2889   end.
     2890   PROCEDURE sort-brbr-csum-grp :
     2891     define input parameter p-recid as recid no-undo .
     2892     if re-querybr-csum-grp = no then do:
     2893       assign
     2894          cur-clmnbr-csum-grp = br-csum-grp:current-column in frame Dialog-Frame
     2895       .
     2896       if sort-clmnbr-csum-grp <> ? then sort-clmnbr-csum-grp:column-fgcolor = 0.
     2897       if cur-clmnbr-csum-grp = sort-clmnbr-csum-grp then do:
     2898         assign
     2899            sort-labelbr-csum-grp = ""
     2900            sort-clmnbr-csum-grp = ?
     2901         .
     2902        end.
     2903        else do:
     2904          assign
     2905            sort-labelbr-csum-grp = cur-clmnbr-csum-grp:label
     2906            sort-clmnbr-csum-grp  = cur-clmnbr-csum-grp
     2907            sort-clmnbr-csum-grp:column-fgcolor = 4
     2908          .
     2909        end.
     2910      end.
     2911     assign
     2912       cur-clmn-locbr-csum-grp = 1
     2913     .
     2914     def var column-handle as handle no-undo .
     2915     column-handle = br-csum-grp:first-column.
     2916     do while valid-handle(column-handle) :
     2917       if column-handle = cur-clmnbr-csum-grp then do:
     2918         leave .
     2919       end.
     2920       column-handle = column-handle:NEXT-COLUMN.
     2921       assign
     2922         cur-clmn-locbr-csum-grp = cur-clmn-locbr-csum-grp + 1
     2923       .
     2924     end.
     2925     case sort-labelbr-csum-grp:
     2926           when X_c-sum-grp.grp-name:label in browse br-csum-grp then DO:   assign     sort-column-name = "X_c-sum-grp.grp-name"   .   run OpenBr.   . END.
     2927           when X_c-sum-grp.corr-date:label in browse br-csum-grp then DO:   assign     sort-column-name = "X_c-sum-grp.corr-date"   .   run OpenBr.   . END.
     2928       otherwise do:
     2929         assign
     2930           sort-column-name = ""
     2931         .
     2932         run OpenBr.
     2933           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-csum-grp') then do:
     2934             run mv-brw-defaultbr-csum-grp.
     2935           end.
     2936         if sort-labelbr-csum-grp <> "" then do:
     2937           assign
     2938             cur-clmnbr-csum-grp:column-fgcolor = 0
     2939           .
     2940         end.
     2941         assign
     2942           cur-clmn-locbr-csum-grp = ?
     2943         .
     2944       end.
     2945     end case.
     2946       if cur-clmn-locbr-csum-grp <> ? then do:
     2947         if can-do( this-procedure:internal-entries, 'ch-clmnbr-csum-grp') then do:
     2948           run ch-clmnbr-csum-grp in this-procedure (cur-clmn-locbr-csum-grp).
     2949         end.
     2950       end.
     2951     if p-recid <> ? then do:
     2952       reposition br-csum-grp to recid p-recid no-error.
     2953       apply "value-changed" to br-csum-grp in frame Dialog-Frame.
     2954     end.
     2955     apply "entry" to br-csum-grp in frame Dialog-Frame.
     2956   END PROCEDURE.
     2957   procedure re-open-query-srt-clmnbr-csum-grp:
     2958   if cur-clmnbr-csum-grp = ? then do:
     2959      run OpenBr.
     2960   end.
     2961   else do:
     2962      assign re-querybr-csum-grp = yes.
     2963      run sort-brbr-csum-grp
     2964        (input (if available temp-changes
     2965                then recid(temp-changes)
     2966                else ?
     2967               )
     2968        ).
     2969      assign re-querybr-csum-grp = no.
     2970   end.
     2971   end.
     2972   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2973   do:
     2974     BR-changes :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2975   end.
     2976   MAIN-BLOCK:
     2977   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2978      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2979    if LOOKUP(p-mode, 'one':U,
     2980                   chr(4)) = 0
     2981        then dO:
     2982       message
     2983       vss-workfile vss-revision vss-description skip
     2984       "Неверное значение параметров вызова p-mode"
     2985       p-mode
     2986       view-as alert-box ERROR.
     2987       return error .
     2988    end.
     2989    if p-mode = "one":U then do:
     2990     find first X_sum-grp no-lock where
     2991                   X_sum-grp.grp-code = p-grp-code no-error.
     2992       if not available X_sum-grp then do:
     2993           message
     2994           vss-workfile vss-revision vss-description skip
     2995           "Неверное значение параметра вызова p-grp-code"
     2996           p-grp-code
     2997           view-as alert-box ERROR.
     2998           return.
     2999       end.
     3000     end.
     3001    v-rid-list = p-rid-list.
     3002   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3003   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     3004     (output v-db-num
     3005     )  .
     3006     RUN MyEnable.
     3007     RUn OpenBR.
     3008     HIDE mark-num in frame Dialog-Frame .
     3009     if v-doc-rec <> ? then
     3010     REPOSITION br-csum-grp to recid v-doc-rec No-ERROR.
     3011   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3012   DEF VAR cur-clmn-numbr-csum-grp as INT EXTENT 6 no-undo.
     3013   DEF VAR varmvibr-csum-grp       as INT no-undo.
     3014   DEF VAR varmvjbr-csum-grp       as INT no-undo.
     3015   DEF VAR varmvkbr-csum-grp       as INT no-undo.
     3016   DEF VAR varmvlbr-csum-grp       as INT no-undo.
     3017   DEF VAR move-elementbr-csum-grp as INT no-undo.
     3018   def var jjbr-csum-grp           as int no-undo.
     3019   do varmvibr-csum-grp = 1 to EXTENT(cur-clmn-numbr-csum-grp):
     3020     ASSIGN cur-clmn-numbr-csum-grp[varmvibr-csum-grp] = varmvibr-csum-grp.
     3021   END.
     3022   RUN start-mv-clmnbr-csum-grp.
     3023   PROCEDURE start-mv-clmnbr-csum-grp:
     3024   def var old-session as logical no-undo.
     3025      old-session = SESSION:IMMEDIATE-DISPLAY.
     3026      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3027          IF  p-mode = 'one'  THEN DO:
     3028      DO jjbr-csum-grp = NUM-ENTRIES('1,2,3,4,5,6') TO 1 BY -1:
     3029        RUN re-move-clmnbr-csum-grp ( cur-clmn-numbr-csum-grp[INTEGER(ENTRY (jjbr-csum-grp, '1,2,3,4,5,6'))] , 1).
     3030      END.
     3031          END.
     3032      SESSION:IMMEDIATE-DISPLAY = old-session.
     3033   END.
     3034   ON ctrl-cursor-right OF BROWSE br-csum-grp do:
     3035     RUN re-move-clmnbr-csum-grp ( 1, 6).
     3036   END.
     3037   ON ctrl-cursor-left OF BROWSE br-csum-grp do:
     3038     RUN re-move-clmnbr-csum-grp (6, 1).
     3039   END.
     3040   PROCEDURE re-move-clmnbr-csum-grp:
     3041     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3042     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3043     DO varmvibr-csum-grp = 1 TO EXTENT(cur-clmn-numbr-csum-grp):
     3044       if cur-clmn-numbr-csum-grp[varmvibr-csum-grp] = source-column THEN cur-clmn-numbr-csum-grp[varmvibr-csum-grp] = -1.
     3045     END.
     3046     if br-csum-grp:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     3047     if source-column > target-column THEN
     3048     DO varmvjbr-csum-grp = source-column - 1 to target-column BY -1:
     3049       DO varmvibr-csum-grp = 1 TO EXTENT(cur-clmn-numbr-csum-grp):
     3050           if cur-clmn-numbr-csum-grp[varmvibr-csum-grp] = varmvjbr-csum-grp THEN DO:
     3051             cur-clmn-numbr-csum-grp[varmvibr-csum-grp] = cur-clmn-numbr-csum-grp[varmvibr-csum-grp] + 1.
     3052           END.
     3053       END.
     3054     END.
     3055     ELSE
     3056     DO varmvjbr-csum-grp = source-column + 1 to target-column:
     3057       DO varmvibr-csum-grp = 1 TO EXTENT(cur-clmn-numbr-csum-grp):
     3058         if cur-clmn-numbr-csum-grp[varmvibr-csum-grp] = varmvjbr-csum-grp THEN DO:
     3059           cur-clmn-numbr-csum-grp[varmvibr-csum-grp] = cur-clmn-numbr-csum-grp[varmvibr-csum-grp] - 1.
     3060         END.
     3061       END.
     3062     END.
     3063     DO varmvibr-csum-grp = 1 TO EXTENT(cur-clmn-numbr-csum-grp):
     3064       if cur-clmn-numbr-csum-grp[varmvibr-csum-grp] = -1 THEN cur-clmn-numbr-csum-grp[varmvibr-csum-grp] = target-column.
     3065     END.
     3066   END PROCEDURE.
     3067   PROCEDURE ch-clmnbr-csum-grp:
     3068     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3069     if cur-clmn-loc <= 1 then do:
     3070       return .
     3071     end.
     3072     DO varmvibr-csum-grp = 1 TO EXTENT(cur-clmn-numbr-csum-grp):
     3073       if cur-clmn-numbr-csum-grp[varmvibr-csum-grp] = cur-clmn-loc THEN move-elementbr-csum-grp = varmvibr-csum-grp.
     3074     END.
     3075     RUN re-move-clmnbr-csum-grp (cur-clmn-loc, 1).
     3076   END PROCEDURE.
     3077   PROCEDURE mv-brw-defaultbr-csum-grp:
     3078   def var old-session as logical no-undo.
     3079     old-session = SESSION:IMMEDIATE-DISPLAY.
     3080     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3081     do varmvlbr-csum-grp = 1 to EXTENT(cur-clmn-numbr-csum-grp):
     3082       RUN re-move-clmnbr-csum-grp (cur-clmn-numbr-csum-grp[varmvlbr-csum-grp], varmvlbr-csum-grp).
     3083     END.
     3084     RUN start-mv-clmnbr-csum-grp.
     3085     SESSION:IMMEDIATE-DISPLAY = old-session.
     3086   END PROCEDURE.
     3087   .
     3088    run diasize_add_browse in this-procedure
     3089       (input  'width':u
     3090       ,input  browse br-changes :handle
     3091       ) .
     3092    run diasize_init in this-procedure .
     3093   WAIT-FOR GO OF FRAME Dialog-Frame.
     3094   END.
     3095   RUN disable_UI.
     3096   PROCEDURE disable_UI :
     3097     HIDE FRAME Dialog-Frame.
     3098   END PROCEDURE.
     3099   PROCEDURE enable_UI :
     3100     DISPLAY mark-num
     3101         WITH FRAME Dialog-Frame.
     3102     ENABLE b-quit B-mark B-sel B-Help br-csum-grp BR-changes mark-num
     3103         WITH FRAME Dialog-Frame.
     3104     VIEW FRAME Dialog-Frame.
     3105     OPEN QUERY br-csum-grp FOR EACH X_c-sum-grp NO-LOCK INDEXED-REPOSITION.
     3106   END PROCEDURE.
     3107   PROCEDURE MyEnable :
     3108   X_c-sum-grp.grp-name:resizable in browse br-csum-grp = yes.
     3109   assign
     3110   temp-changes.l_name:resizable in browse br-changes = true
     3111   temp-changes.v_old:resizable in browse br-changes = true
     3112   temp-changes.v_new:resizable in browse br-changes = true
     3113   temp-changes.l_name:width in browse br-changes = 30
     3114   temp-changes.v_old:width in browse br-changes = 40
     3115   temp-changes.v_new:width in browse br-changes = 40
     3116   .
     3117   DISPLAY mark-num
     3118   WITH FRAME Dialog-Frame .
     3119   ENABLE
     3120   b-quit
     3121   B-mark when LOOKUP("b-mark":U, bttns) > 0
     3122   B-sel when LOOKUP("b-sel":U, bttns) > 0
     3123   B-Help
     3124   br-csum-grp mark-num
     3125   br-changes
     3126   with FRAME Dialog-Frame .
     3127   VIEW FRAME Dialog-Frame .
     3128   END PROCEDURE.
     3129   PROCEDURE OpenBr :
     3130   CASE p-mode:
     3131     when "one":U then do:
     3132       OPEN QUERY br-csum-grp FOR EACH X_c-sum-grp NO-LOCK where
     3133                                     X_c-sum-grp.grp-code = p-grp-code
     3134                                 AND X_c-sum-grp.corr-user-db-num = 0
     3135                                     INDEXED-REPOSITION.
     3136     end.
     3137     when "subject" then do:
     3138       OPEN QUERY br-csum-grp FOR EACH X_c-sum-grp NO-LOCK where
     3139                                     X_c-sum-grp.subject = p-subject
     3140                                 and X_c-sum-grp.grp-code = p-grp-code
     3141                                 AND X_c-sum-grp.corr-user-db-num = 0
     3142                                     INDEXED-REPOSITION.
     3143     end.
     3144   end case.
     3145   APPLY "VALUE-CHANGED" TO br-csum-grp in frame Dialog-Frame.
     3146   APPLY "ENTRY" TO br-csum-grp.
     3147   END PROCEDURE.
     3148   PROCEDURE proc-br-csum-grp :
     3149   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3150   if b-sel:sensitive in frame Dialog-Frame then dO:
     3151       if b-mark:sensitive then do:
     3152           apply "choose" to b-mark in frame Dialog-Frame.
     3153       end.
     3154       else do:
     3155           apply "choose" to b-sel in frame Dialog-Frame.
     3156       end.
     3157   end.
     3158   else do:
     3159       if b-lookup:sensitive then
     3160       apply "choose" to b-lookup in frame Dialog-Frame.
     3161   end.
     3162   END PROCEDURE.
     3163   PROCEDURE proc-view-changes :
     3164   define buffer buf_c-dis-grp-rule for ub.c-dis-grp-rule.
     3165   for each temp-changes:
     3166       delete temp-changes.
     3167   END.
     3168   if not available X_c-sum-grp then do:
     3169     Open QUery br-changes for each temp-changes.
     3170     return.
     3171   end.
     3172   define variable v-label-param as character no-undo .
     3173   CASE X_c-sum-grp.subject:
     3174     when 'sum-grp':U then do:
     3175       v-label-param =
     3176         "grp-code" + chr(4) + "Код группы" + chr(4) + "" + chr(8)
     3177       + "grp-name" + chr(4) + "Наименование группы" + chr(4) + ""  .
     3178       run proc-full-temp-changes in this-procedure (
     3179                                                   input  (X_c-sum-grp.action = integer('1':U))
     3180                                                   ,input  (X_c-sum-grp.action = integer('99':U))
     3181                                                   ,input  buffer X_c-sum-grp:handle
     3182                                                   ,input  'sum-grp':U
     3183                                                   ,input  "grp-code,grp-name"
     3184                                                   ,input  v-label-param).
     3185     end.
     3186     when 'dis-grp-rule':U then do:
     3187           find first buf_c-dis-grp-rule no-lock where
     3188                 buf_c-dis-grp-rule.classif-type = 'sum-grp':U
     3189            and  buf_c-dis-grp-rule.node-code = X_c-sum-grp.grp-code
     3190           and  buf_c-dis-grp-rule.corr-user-db-num = X_c-sum-grp.corr-user-db-num
     3191           and  buf_c-dis-grp-rule.chip-num = X_c-sum-grp.chip-num no-error.
     3192      if not available buf_c-dis-grp-rule then do:
     3193        message
     3194        "Неверная ссылка на c-dis-grp-rule в таблице c-sum-grp"
     3195        view-as alert-box error.
     3196      end.
     3197   v-label-param =
     3198     "rule-num" + chr(4) + "Номер правила скидки" + chr(4) + "" + chr(8)
     3199    + "pos-type" + chr(4) + "Место использ." + chr(4) + "" + chr(8)
     3200    + "templ-rl-root" + chr(4) + "Тип шаблона" + chr(4) + "disgrpru-get-disc-label"  + chr(8)
     3201    + "discnt-role" + chr(4) + "Тип скидки" + chr(4) + "disgrpru-get-disc-role-label"
     3202    .
     3203       run proc-full-temp-changes in this-procedure (
     3204                                                   input  (X_c-sum-grp.action = integer('1':U))
     3205                                                   ,input  (X_c-sum-grp.action = integer('99':U))
     3206                                                   ,input  buffer buf_c-dis-grp-rule:handle
     3207                                                   ,input  'dis-grp-rule':U
     3208                                                   ,input  "rule-num,pos-type,templ-rl-root,discnt-role"
     3209                                                   ,input  v-label-param).
     3210     end.
     3211   END CASe.
     3212   Open QUery br-changes for each temp-changes.
     3213   END PROCEDURE.
     3214   FUNCTION get-subject RETURNS CHARACTER
     3215     ( p-subject as character ) :
     3216       RETURN entry (lookup (p-subject, 'sum-grp,dis-grp-rule':U), 'Группа товаров,Скидки по группе':U).
     3217   END FUNCTION.
