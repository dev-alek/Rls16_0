        1   block-level on error undo, throw.
        2   define input-output parameter p-rec                 as recid     no-undo.
        3   define input parameter        p-mode                as character no-undo .
        4   define input parameter        p-silent              as logical   no-undo .
        5   define input parameter        p-curr-code           like ub.currency.curr-code            no-undo .
        6   define input parameter        p-curr-abbr           like ub.currency.curr-abbr            no-undo .
        7   define input parameter        p-part-abbr           like ub.currency.part-abbr            no-undo .
        8   define input parameter        p-curr-name           like ub.currency.curr-name            no-undo .
        9   define input parameter        p-curr-name-one       like ub.currency.curr-name-one        no-undo .
       10   define input parameter        p-curr-name-three     like ub.currency.curr-name-three      no-undo .
       11   define input parameter        p-curr-name-five      like ub.currency.curr-name-five       no-undo .
       12   define input parameter        p-curr-eng-name       like ub.currency.curr-eng-name        no-undo .
       13   define input parameter        p-curr-eng-name-one   like ub.currency.curr-eng-name-one    no-undo .
       14   define input parameter        p-curr-eng-name-three like ub.currency.curr-eng-name-three  no-undo .
       15   define input parameter        p-curr-eng-name-five  like ub.currency.curr-eng-name-five   no-undo .
       16   define input parameter        p-part-name           like ub.currency.part-name            no-undo .
       17   define input parameter        p-part-name-one       like ub.currency.part-name-one        no-undo .
       18   define input parameter        p-part-name-three     like ub.currency.part-name-three      no-undo .
       19   define input parameter        p-part-name-five      like ub.currency.part-name-five       no-undo .
       20   define input parameter        p-okv-code            like ub.currency.okv-code             no-undo .
       21   define input parameter        p-okv-code-chr        as character no-undo .
       22   define variable vss-revision    as character no-undo init "$Revision: 7872d7f298c6, 1094, rls $":U .
       23   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
       24   define variable vss-date        as character no-undo init "$Date: Thu Dec 14 02:13:52 2017 +0300 $":U .
       25   define variable vss-workfile    as character no-undo init "$Workfile: currenc1.p $":U .
       26   define variable vss-archive     as character no-undo init "$Archive: ref/currenc1.p $":U .
       27   define variable vss-description as character no-undo init "Сохранение изменений в карточке валюты".
       28   procedure vss-get-info :
       29     define output parameter p-vss-revision    like vss-revision    no-undo .
       30     define output parameter p-vss-author      like vss-author      no-undo .
       31     define output parameter p-vss-date        like vss-date        no-undo .
       32     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       33     define output parameter p-vss-archive     like vss-archive     no-undo .
       34     define output parameter p-vss-description like vss-description no-undo .
       35     assign
       36       p-vss-revision    = vss-revision
       37       p-vss-author      = vss-author
       38       p-vss-date        = vss-date
       39       p-vss-workfile    = vss-workfile
       40       p-vss-archive     = vss-archive
       41       p-vss-description = vss-description
       42     .
       43   end procedure.
       44   procedure vss-get-parameters :
       45     define output parameter p-vss-parameters as character no-undo .
       46   end procedure.
       47   define new global shared variable g#vssrevis-logger as handle    no-undo .
       48   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       49   define variable v-vssrevis-logger                   as handle    no-undo .
       50   procedure vss-logevent :
       51     define input  parameter p-extra-paramters as character no-undo .
       52     define variable v-vssrevis-parameters as character no-undo .
       53     do
       54     on error undo, return error return-value
       55     :
       56       if  valid-handle(v-vssrevis-logger)
       57       and v-vssrevis-logger :get-signature("logevent") <> ""
       58       then do:
       59         run vss-get-parameters in this-procedure
       60           (output v-vssrevis-parameters
       61           ).
       62         run logevent in v-vssrevis-logger
       63           (input vss-workfile
       64           ,input vss-revision
       65           ,input v-vssrevis-parameters
       66           ,input p-extra-paramters
       67           ).
       68       end.
       69     end.
       70   end procedure.
       71   assign
       72     v-vssrevis-logger = g#vssrevis-logger
       73   .
       74   if  valid-handle(v-vssrevis-logger)
       75   and v-vssrevis-logger :get-signature("logevent") <> ""
       76   then do:
       77     assign
       78       v-vssrevis-logevent = true
       79     .
       80     run vss-logevent in this-procedure (input vss-description) .
       81   end.
       82   define new global shared variable g#language as character no-undo .
       83   if g#language <> '' and g#language <> 'rus':U then do:
       84     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       85   end.
       86   define new global shared variable g#library  as handle no-undo .
       87   define new global shared variable g#library2 as handle no-undo .
       88   define variable v-db-num like ub.db.db-num no-undo .
       89   define variable dopi              as integer   no-undo.
       90   define variable v-param-type      as character no-undo .
       91   define variable v-value-character as character no-undo .
       92   define variable v-value-date      as date      no-undo .
       93   define variable v-value-decimal   as decimal   no-undo .
       94   define variable v-value-integer   as integer   no-undo .
       95   define variable v-value-logical   as logical   no-undo .
       96   define variable v-tth             as handle    no-undo .
       97   define variable v-mess            as character no-undo .
       98   define variable v-value as character no-undo.
       99   define variable v-ttype as character no-undo.
      100   define buffer buf_currency for ub.currency.
      101   define buffer buf_shop for ub.shop.
      102   define temp-table ibmrubc no-undo
      103     field code as integer
      104     index pi is unique primary code
      105     .
      106   main-block:
      107   do
      108   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      109   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      110   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      111   :
      112     if p-mode <> 'ДОБАВЛЕНИЕ':U
      113     and p-mode <> 'ИЗМЕНЕНИЕ':U
      114     then do:
      115       assign
      116         v-mess = substitute( "&1 (&2). Ошибка задания входных параметров. Неверный параметр p-mode (&3).", vss-workfile, vss-revision, p-mode )
      117       .
      118       run err-mess in this-procedure ( input-output v-mess ).
      119       undo main-block, return error (if p-silent = yes then v-mess else '':U ).
      120     end.
      121   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      122   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
      123     (output v-db-num
      124     )  .
      125      run gbl/conf-rd.p ("is-erpRN", "", "", 0, "", "", "", no, output v-value, output v-ttype) no-error.
      126     if v-value = "no"  then do:
      127     if v-db-num <> 0
      128     then do:
      129       assign
      130         v-mess = substitute( "Нельзя изменять запись ВАЛЮТЫ в УБД: Номер текущей БД &1.", v-db-num )
      131       .
      132       run err-mess in this-procedure ( input-output v-mess ).
      133       undo main-block, return error (if p-silent = yes then v-mess else '':U ).
      134     end.
      135     end.
      136     for each ibmrubc :
      137       delete ibmrubc.
      138     end.
      139     for each buf_shop no-lock
      140     on error undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      141     :
      142       run adm/shattri.p (
      143           input "get":U
      144           ,input  'маг':U
      145           ,input  buf_shop.obj-code
      146           ,input  'cd-type-ibm':U
      147           ,input  'ibmrubc':U
      148           ,output v-value-character
      149           ,output v-value-date
      150           ,output v-value-decimal
      151           ,output v-value-integer
      152           ,output v-value-logical
      153           ,output v-param-type
      154           ,INPUT-OUTPUT table-handle v-tth
      155           ) no-error .
      156       IF error-status:error then do:
      157         delete object v-tth.
      158         assign
      159           v-mess = substitute("&1 (&2). Ошибка при получении настроек кассы &6 по умолчанию НА ОБЪЕКТЕ &3&4:&5&6 &7"
      160                               , vss-workfile
      161                               , vss-revision
      162                               , 'маг':U
      163                               , buf_shop.obj-code
      164                               , chr(10)
      165                               , error-status:get-message(1)
      166                               , return-value
      167                               , 'IBM':U
      168                               )
      169           .
      170         run err-mess in this-procedure ( input-output v-mess ).
      171         undo main-block, return error (if p-silent = yes then v-mess else '':U ).
      172       end.
      173       delete object v-tth.
      174       FIND FIRST ibmrubc where
      175                   ibmrubc.code = v-value-integer NO-ERROR.
      176       IF not avail ibmrubc then do:
      177         create ibmrubc.
      178         assign
      179         ibmrubc.code = v-value-integer.
      180       end.
      181       run adm/shattri.p (
      182           input "get":U
      183           ,input  'маг':U
      184           ,input  buf_shop.obj-code
      185           ,input  'cd-type-IBM-XML':U
      186           ,input  'ibmrubc':U
      187           ,output v-value-character
      188           ,output v-value-date
      189           ,output v-value-decimal
      190           ,output v-value-integer
      191           ,output v-value-logical
      192           ,output v-param-type
      193           ,INPUT-OUTPUT table-handle v-tth
      194           ) no-error .
      195       IF error-status:error then do:
      196         delete object v-tth.
      197         assign
      198           v-mess = substitute("&1 (&2).Ошибка при получении настроек кассы &8 по умолчанию НА ОБЪЕКТЕ &3&4:&5&6 &7"
      199                               , vss-workfile
      200                               , vss-revision
      201                               , 'маг':U
      202                               , buf_shop.obj-code
      203                               , chr(10)
      204                               , error-status:get-message(1)
      205                               , return-value
      206                               , 'IBM-XML':U
      207                               )
      208           .
      209         run err-mess in this-procedure ( input-output v-mess ).
      210         undo main-block, return error (if p-silent = yes then v-mess else '':U ).
      211       end.
      212       delete object v-tth.
      213       FIND FIRST ibmrubc where
      214                   ibmrubc.code = v-value-integer NO-ERROR.
      215       IF not avail ibmrubc then do:
      216         create ibmrubc.
      217         assign
      218         ibmrubc.code = v-value-integer.
      219       end.
      220     end.
      221     if p-mode =  'ДОБАВЛЕНИЕ':U then do:
      222       if can-find(first ibmrubc where p-curr-code = ibmrubc.code) then do:
      223         assign
      224           v-mess = substitute("Код валюты не может быть равен &1", p-curr-code )
      225           .
      226         run err-mess in this-procedure ( input-output v-mess ).
      227         undo main-block, return error (if p-silent = yes then v-mess else "curr-code":U ).
      228       end.
      229       if can-find( first buf_currency where buf_currency.curr-code = p-curr-code ) then do:
      230         assign
      231           v-mess = substitute("Уже есть валюта с кодом &1", p-curr-code )
      232           .
      233         run err-mess in this-procedure ( input-output v-mess ).
      234         undo main-block, return error (if p-silent = yes then v-mess else "curr-code":U ).
      235       end.
      236       if can-find( first buf_currency where buf_currency.curr-abbr = p-curr-abbr ) then do:
      237         assign
      238           v-mess = substitute("Уже есть валюта с аббревиатурой &1", p-curr-abbr )
      239           .
      240         run err-mess in this-procedure ( input-output v-mess ).
      241         undo main-block, return error (if p-silent = yes then v-mess else "curr-abbr":U ).
      242       end.
      243     end.
      244     if p-curr-abbr = "":U then do:
      245       assign
      246         v-mess = substitute("Не задана аббревиатура валюты (код &1)", p-curr-code )
      247         .
      248       run err-mess in this-procedure ( input-output v-mess ).
      249       undo main-block, return error (if p-silent = yes then v-mess else "curr-abbr":U ).
      250     end.
      251     if p-curr-name = "":U then do:
      252       assign
      253         v-mess = substitute("Не задано название валюты (код &1)", p-curr-code )
      254         .
      255       run err-mess in this-procedure ( input-output v-mess ).
      256       undo main-block, return error (if p-silent = yes then v-mess else "curr-name":U ).
      257     end.
      258     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      259       create buf_currency.
      260       assign
      261       buf_currency.curr-code = p-curr-code
      262       buf_currency.curr-abbr = p-curr-abbr
      263       p-rec = recid(buf_currency)
      264       .
      265     end.
      266     else do:
      267       FIND FIRST buf_currency where
      268                 recid(buf_currency) = p-rec No-ERROR.
      269       if not available buf_currency then do:
      270         assign
      271           v-mess = substitute("&1 (&2). Не найдена запись валюты p-rec = &3", vss-workfile, vss-revision, p-rec )
      272           .
      273         run err-mess in this-procedure ( input-output v-mess ).
      274         undo main-block, return error (if p-silent = yes then v-mess else "":U ).
      275       end.
      276       if buf_currency.curr-abbr <> p-curr-abbr
      277       or buf_currency.curr-code <> p-curr-code
      278       then do:
      279         assign
      280           v-mess = substitute("Для уже имеющейся записи ВАЛЮТЫ нельзя изменить аббревиатуру и/или код валюты" )
      281           .
      282         run err-mess in this-procedure ( input-output v-mess ).
      283         undo main-block, return error (if p-silent = yes then v-mess else "":U ).
      284       end.
      285     end.
      286     assign
      287     buf_currency.curr-name           = p-curr-name
      288     buf_currency.curr-abbr           = p-curr-abbr
      289     buf_currency.part-abbr           = p-part-abbr
      290     buf_currency.curr-name           = p-curr-name
      291     buf_currency.curr-name-one       = p-curr-name-one
      292     buf_currency.curr-name-three     = p-curr-name-three
      293     buf_currency.curr-name-five      = p-curr-name-five
      294     buf_currency.curr-eng-name       = p-curr-eng-name + chr(4) + p-okv-code-chr
      295     buf_currency.curr-eng-name-one   = p-curr-eng-name-one
      296     buf_currency.curr-eng-name-three = p-curr-eng-name-three
      297     buf_currency.curr-eng-name-five  = p-curr-eng-name-five
      298     buf_currency.part-name           = p-part-name
      299     buf_currency.part-name-one       = p-part-name-one
      300     buf_currency.part-name-three     = p-part-name-three
      301     buf_currency.part-name-five      = p-part-name-five
      302     buf_currency.okv-code            = p-okv-code
      303     .
      304     release buf_currency no-error.
      305     if error-status:error then do:
      306       assign
      307         v-mess = substitute("&1 (&2). Ошибка при сохранении записи ВАЛЮТЫ &3: &4: &5", vss-workfile, vss-revision, p-curr-code, error-status:get-message(1), return-value )
      308         .
      309       run err-mess in this-procedure ( input-output v-mess ).
      310       undo main-block, return error (if p-silent = yes then v-mess else "":U ).
      311    end.
      312   end.
      313   return '':U .
      314   procedure err-mess:
      315     define input-output parameter p-mess as character no-undo.
      316       case p-silent:
      317       when yes then do:
      318         assign
      319         p-mess = substitute("Сохранение изменений в карточке ВАЛЮТЫ&1"
      320                             + "Код валюты &2&1"
      321                             + "Аббревиатура валюты &3&1"
      322                             + "Название валюты &4&1"
      323                             + "&5"
      324                            , chr(10)
      325                            , p-curr-code
      326                            , p-curr-abbr
      327                            , p-curr-name
      328                            , p-mess)
      329         .
      330       end.
      331       when no then do:
      332         message
      333         p-mess
      334         view-as alert-box error .
      335       end.
      336     end.
      337   end procedure.
