        1   define input  parameter parparentproc  as widget-handle no-undo .
        2   define input  parameter bttns          as character     no-undo .
        3   define input-output parameter rid-list       as character     no-undo .
        4   define output parameter p-ok       as logical     no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "типы алкоголя".
       11   define buffer br_alc-type for ub.alc-type.
       12   define buffer br_alc-type-attr for ub.alc-type-attr.
       13   define temp-table tt-alc-type no-undo like ub.alc-type
       14   field alc-type            like ub.alc-type-attr.attr-value
       15   field rec                 as recid
       16   .
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   procedure proc-alt-shift-f2:
       78     if not ibs.th.gbl.gbl-var:rcode
       79   then
       80     run gbl\inidebug.p .
       81   end.
       82   procedure proc-alt-shift-f3:
       83     run gbl/prvssinf.p
       84       ( input this-procedure
       85       ) .
       86   end.
       87   define variable v-inform-launched as logical no-undo initial false .
       88   procedure proc-alt-shift-f4:
       89     define variable v-action as character no-undo .
       90     if v-inform-launched = false then do:
       91       assign
       92         v-inform-launched = true
       93       .
       94       run gbl/d-inform.w
       95         (  input self
       96         ,  input this-procedure
       97         , output v-action
       98         ) no-error .
       99       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      100       assign
      101         v-inform-launched = false
      102       .
      103     end.
      104   end.
      105   procedure proc-alt-f1:
      106     run gbl/corrhelp.p
      107       (input this-procedure
      108       ) .
      109   end .
      110   on alt-shift-f2 anywhere do:
      111     run proc-alt-shift-f2.
      112   end.
      113   on alt-shift-f3 anywhere do:
      114     run proc-alt-shift-f3 in this-procedure .
      115   end.
      116   on alt-shift-f4 anywhere do:
      117     run proc-alt-shift-f4 in this-procedure.
      118   end.
      119   on alt-f1 anywhere do:
      120     run proc-alt-f1 in this-procedure .
      121   end.
      122   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      123     define variable v-cntxt-db-num        as integer   no-undo .
      124     define variable v-cntxt-userid        as character no-undo .
      125     define variable v-cntxt-level         as character no-undo .
      126     define variable v-cntxt-host-code-obj as integer   no-undo .
      127     define variable v-cntxt-obj-type      as character no-undo .
      128     define variable v-cntxt-obj-code      as integer   no-undo .
      129     define variable v-cntxt-db-num-obj    as integer   no-undo .
      130     define variable v-cntxt-is-admin      as logical   no-undo .
      131   define variable v-brws-mark      as character no-undo COLUMN-LABEL "*"        FORMAT "X(1)":U  .
      132   define variable v-status         as character no-undo COLUMN-LABEL "Статус"   FORMAT "X(5)":U  .
      133   define variable v-sort-column-name as character no-undo .
      134   define variable v-ok    as logical      no-undo.
      135   DEFINE BUTTON b-add
      136        LABEL "&Добавить"
      137        SIZE 10 BY 1.
      138   DEFINE BUTTON b-cng
      139        LABEL "&Изменить"
      140        SIZE 10 BY 1.
      141   DEFINE BUTTON b-del
      142        LABEL "&Удалить"
      143        SIZE 10 BY 1.
      144   DEFINE BUTTON b-exit AUTO-GO
      145        LABEL "&Выход"
      146        SIZE 10 BY 1
      147        BGCOLOR 8 .
      148   DEFINE BUTTON b-goods
      149        LABEL "&Товары"
      150        SIZE 10 BY 1.
      151   DEFINE BUTTON b-help
      152        LABEL "&Помощь"
      153        SIZE 10 BY 1
      154        BGCOLOR 8 .
      155   DEFINE BUTTON b-hist
      156        LABEL "Ис&тория"
      157        SIZE 10 BY 1.
      158   DEFINE BUTTON b-load
      159        LABEL "&Загрузить"
      160        SIZE 10 BY 1.
      161   DEFINE BUTTON b-mark
      162        LABEL "&*"
      163        SIZE 3 BY 1.
      164   DEFINE BUTTON b-sel AUTO-GO
      165        LABEL "&Выбрать"
      166        SIZE 10 BY 1.
      167   DEFINE VARIABLE rs-sort AS INTEGER
      168        VIEW-AS RADIO-SET HORIZONTAL
      169        RADIO-BUTTONS
      170             "&названию", 1,
      171   "&коду", 2
      172        SIZE 17.5 BY .79 NO-UNDO.
      173   DEFINE QUERY BROWSE-2 FOR
      174         tt-alc-type
      175         SCROLLING.
      176   DEFINE BROWSE BROWSE-2
      177     QUERY BROWSE-2 DISPLAY
      178         (IF ( INDEX (rid-list, string( tt-alc-type.rec ) ) > 0 ) THEN ("*") ELSE (" ")) @ v-brws-mark
      179        tt-alc-type.alc-type-code
      180        tt-alc-type.alc-type-name FORMAT "x(80)"
      181        tt-alc-type.alc-type FORMAT "x(20)"
      182       (IF (tt-alc-type.alc-type-status = 0) then ("") else ("помечен на удаление")) @ v-status
      183       WITH NO-ROW-MARKERS SEPARATORS SIZE 80 BY 13.88 ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
      184   DEFINE FRAME Dialog-Frame
      185        b-exit AT ROW 1 COL 1
      186        b-mark AT ROW 1 COL 11 WIDGET-ID 20
      187        b-sel AT ROW 1 COL 14 WIDGET-ID 22
      188        b-hist AT ROW 1 COL 61 WIDGET-ID 10
      189        b-help AT ROW 1 COL 71
      190        rs-sort AT ROW 2.17 COL 18 NO-LABEL WIDGET-ID 14
      191        b-add AT ROW 3 COL 1 WIDGET-ID 2
      192        b-cng AT ROW 3 COL 11 WIDGET-ID 4
      193        b-del AT ROW 3 COL 21 WIDGET-ID 6
      194        b-load AT ROW 3 COL 31 WIDGET-ID 8
      195        b-goods AT ROW 3 COL 41 WIDGET-ID 12
      196        BROWSE-2 AT ROW 4.21 COL 1 WIDGET-ID 200
      197        "Сортировать по:" VIEW-AS TEXT
      198             SIZE 15 BY .79 AT ROW 2.08 COL 3 WIDGET-ID 18
      199        SPACE(63.19) SKIP(15.29)
      200       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      201            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      202            TITLE "Виды алкогольной продукции"
      203            DEFAULT-BUTTON b-exit WIDGET-ID 100.
      204   ASSIGN
      205          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      206          FRAME Dialog-Frame:HIDDEN           = TRUE.
      207   ASSIGN
      208          BROWSE-2:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
      209   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      210   DO:
      211     APPLY "END-ERROR":U TO SELF.
      212   END.
      213   ON CHOOSE OF b-add IN FRAME Dialog-Frame
      214   DO:
      215   define variable v-rr as recid no-undo.
      216       run ref/alctypei.w ( input parparentproc
      217                          , input 'ДОБАВЛЕНИЕ':U
      218                          , input-output v-rr
      219                          ) no-error.
      220       IF ERROR-STATUS:ERROR THEN DO:
      221         message
      222           vss-workfile vss-revision vss-description skip
      223           "Ошибка при создании вида алкоголя" skip
      224           error-status :get-message(1) skip
      225           return-value skip
      226           view-as alert-box error .
      227         return no-apply .
      228       end.
      229     run refresh-query in this-procedure.
      230   END.
      231   ON CHOOSE OF b-cng IN FRAME Dialog-Frame
      232   DO:
      233      define variable v-rr as recid no-undo.
      234      if available tt-alc-type then do:
      235         assign
      236         v-rr = tt-alc-type.rec
      237         .
      238         run ref/alctypei.w ( input parparentproc
      239                            , input 'ИЗМЕНЕНИЕ':U
      240                            , input-output v-rr
      241                            ) no-error.
      242         IF ERROR-STATUS:ERROR THEN DO:
      243            message
      244            vss-workfile vss-revision vss-description skip
      245            "Ошибка при редактировании вида алкоголя" skip
      246            error-status :get-message(1) skip
      247            return-value skip
      248            view-as alert-box error .
      249            return no-apply .
      250         end.
      251      end.
      252      else do:
      253         run ref/alctypei.w ( input parparentproc
      254                            , input 'ДОБАВЛЕНИЕ':U
      255                            , input-output v-rr
      256                            ) no-error.
      257         IF ERROR-STATUS:ERROR THEN DO:
      258            message
      259            vss-workfile vss-revision vss-description skip
      260            "Ошибка при создании вида алкоголя" skip
      261            error-status :get-message(1) skip
      262            return-value skip
      263            view-as alert-box error .
      264            return no-apply .
      265         end.
      266      end.
      267      run refresh-query in this-procedure.
      268   END.
      269   ON CHOOSE OF b-del IN FRAME Dialog-Frame
      270   DO:
      271      define buffer buf_alc-type-gds for ub.alc-type-gds.
      272      if available tt-alc-type then do:
      273         if can-find ( first buf_alc-type-gds
      274                       where buf_alc-type-gds.alc-type-inner-code = tt-alc-type.alc-type-inner-code
      275                       no-lock
      276                       ) then do:
      277            message "Удалить вид алкоголя невозможно," skip
      278                    " к нему прикреплены товары."
      279            view-as alert-box question
      280            .
      281            return no-apply.
      282         end.
      283         message "Удалить вид алкоголя?" skip
      284         tt-alc-type.alc-type-name
      285         view-as alert-box question
      286         buttons ok-cancel
      287         update v-ok as logical
      288         .
      289         if v-ok then do:
      290           run delete-alc-type in this-procedure.
      291           run refresh-query in this-procedure.
      292         end.
      293      end.
      294   END.
      295   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      296   DO:
      297     p-ok = FALSE.
      298   END.
      299   ON CHOOSE OF b-goods IN FRAME Dialog-Frame
      300   DO:
      301     if available tt-alc-type then do:
      302       run ref/alc-gds.w
      303         ( input parparentproc
      304         , input tt-alc-type.alc-type-inner-code
      305         , input tt-alc-type.create-user-db-num
      306         , input tt-alc-type.alc-type-name
      307         ) no-error.
      308       IF ERROR-STATUS :ERROR THEN DO:
      309         message
      310           vss-workfile vss-revision vss-description skip
      311           "Ошибка при товаров, прикрепленных к виду алкоголя" skip
      312           error-status :get-message(1) skip
      313           return-value skip
      314           view-as alert-box error .
      315         return no-apply .
      316       end.
      317     end.
      318   END.
      319   ON CHOOSE OF b-hist IN FRAME Dialog-Frame
      320   DO:
      321     if not available tt-alc-type then return .
      322     run ref/alctypeh.w ( input parparentproc
      323                        , input tt-alc-type.alc-type-inner-code
      324                        , input tt-alc-type.create-user-db-num
      325                        ) no-error .
      326      IF ERROR-STATUS:ERROR THEN DO:
      327         message
      328         vss-workfile vss-revision vss-description skip
      329         "Ошибка при просмотре истории видов алкоголя" skip
      330         error-status :get-message(1) skip
      331         return-value skip
      332         view-as alert-box error .
      333         return no-apply .
      334      end.
      335   END.
      336   ON CHOOSE OF b-load IN FRAME Dialog-Frame
      337   DO:
      338     run utl/i-alcref.p (input parparentproc ) no-error.
      339       IF ERROR-STATUS :ERROR THEN DO:
      340         message
      341           vss-workfile vss-revision vss-description skip
      342           "Ошибка при загрузке видов алкоголя из файла" skip
      343           error-status :get-message(1) skip
      344           return-value skip
      345           view-as alert-box error .
      346         return no-apply .
      347       end.
      348     run refresh-query in this-procedure.
      349   END.
      350   ON CHOOSE OF b-mark IN FRAME Dialog-Frame
      351   DO:
      352      define variable v-ok as logical no-undo .
      353      if not available tt-alc-type then do:
      354         return no-apply.
      355      end.
      356   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      357   define variable v-str-recid2 as character no-undo .
      358   define variable v-num-entry2 as integer   no-undo .
      359   assign
      360     v-str-recid2 = trim( string( tt-alc-type.rec , "->>>>>>>>>>>9":U ) )
      361     v-num-entry2 = lookup( v-str-recid2 , rid-list )
      362   .
      363   if v-num-entry2 > 0 then do:
      364     assign
      365       entry( v-num-entry2, rid-list ) = "":U
      366       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      367     .
      368   end.
      369   else do:
      370     assign
      371       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid2
      372     .
      373   end.
      374      v-ok = BROWSE-2:select-next-row ().
      375      v-ok = BROWSE-2:refresh( )  in frame Dialog-Frame.
      376   END.
      377   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
      378   DO:
      379      IF  available tt-alc-type
      380      AND rid-list = ""
      381      then DO:
      382         assign
      383            rid-list = string( tt-alc-type.rec )
      384         .
      385      end.
      386      p-ok = true.
      387   END.
      388   ON MOUSE-SELECT-DBLCLICK OF BROWSE-2 IN FRAME Dialog-Frame
      389   DO:
      390       if ((lookup  ( "b-add" , bttns) > 0 ) AND ( v-cntxt-db-num = 0 )) then do:
      391        define variable v-rr as recid no-undo.
      392      if available tt-alc-type then do:
      393         assign
      394         v-rr = tt-alc-type.rec
      395         .
      396         run ref/alctypei.w ( input parparentproc
      397                            , input 'ИЗМЕНЕНИЕ':U
      398                            , input-output v-rr
      399                            ) no-error.
      400         IF ERROR-STATUS:ERROR THEN DO:
      401            message
      402            vss-workfile vss-revision vss-description skip
      403            "Ошибка при редактировании вида алкоголя" skip
      404            error-status :get-message(1) skip
      405            return-value skip
      406            view-as alert-box error .
      407            return no-apply .
      408         end.
      409      end.
      410      else do:
      411         run ref/alctypei.w ( input parparentproc
      412                            , input 'ДОБАВЛЕНИЕ':U
      413                            , input-output v-rr
      414                            ) no-error.
      415         IF ERROR-STATUS:ERROR THEN DO:
      416            message
      417            vss-workfile vss-revision vss-description skip
      418            "Ошибка при создании вида алкоголя" skip
      419            error-status :get-message(1) skip
      420            return-value skip
      421            view-as alert-box error .
      422            return no-apply .
      423         end.
      424      end.
      425      run refresh-query in this-procedure.
      426      end.
      427   END.
      428   ON VALUE-CHANGED OF rs-sort IN FRAME Dialog-Frame
      429   DO:
      430     assign
      431       rs-sort
      432     .
      433     run refresh-query in this-procedure.
      434   END.
      435   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      436   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      437   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      438     run mainmenu_getcntxt in parparentproc
      439       (output v-cntxt-db-num
      440       ,output v-cntxt-userid
      441       ,output v-cntxt-level
      442       ,output v-cntxt-host-code-obj
      443       ,output v-cntxt-obj-type
      444       ,output v-cntxt-obj-code
      445       ,output v-cntxt-db-num-obj
      446       ,output v-cntxt-is-admin
      447       ) .
      448   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      449   do:
      450     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      451       (input  v-cntxt-db-num
      452       ,input  v-cntxt-userid
      453       ,input  0
      454       ,input  'actn_alc-type-lookup':U
      455       ,input  'object':U
      456       ,input  0
      457       ,input  v-cntxt-obj-type
      458       ,input  v-cntxt-obj-code
      459       ,input  0
      460       ,input  0
      461       ,input  0
      462       ,input  TRUE
      463       ,output v-ok
      464       )  .
      465   end.
      466       IF NOT v-ok then do:
      467          return.
      468       end.
      469   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      470   on help of frame Dialog-Frame
      471   do:
      472     run gbl/app_help.p
      473       (input this-procedure :file-name
      474       ,input ''
      475       ,input ?
      476       ) no-error.
      477     if error-status :error then do:
      478       message
      479         "Ошибка при вызове помощи"
      480         error-status :get-message(1)
      481         view-as alert-box .
      482     end.
      483   end.
      484   run minbtn-set in this-procedure .
      485   on choose of b-help in frame Dialog-Frame
      486   do:
      487     apply "help":u to frame Dialog-Frame .
      488   end.
      489   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      490   procedure minbtn-set :
      491       do
      492           on error undo, return error return-value
      493           :
      494           define variable ii              as integer       no-undo .
      495           define variable fh              as widget-handle no-undo .
      496           define variable hh              as widget-handle no-undo .
      497           define variable v-h             as handle        extent 4 no-undo .
      498           define variable v-name-button   as character     no-undo .
      499           define variable v-help-old-x    as decimal       no-undo .
      500           define variable v-help-old-y    as decimal       no-undo .
      501           define variable v-help-old-size as decimal       no-undo .
      502           define variable v-frame-width   as decimal       no-undo .
      503           define variable jj              as integer       no-undo .
      504           do
      505               on error undo, return error
      506               :
      507               assign
      508                   v-frame-width = frame Dialog-Frame:width - 0.3
      509                   fh            = frame Dialog-Frame:first-child
      510                   hh            = fh:first-child
      511                   ii            = 1
      512                   .
      513               do while valid-handle(hh):
      514                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      515                   do:
      516                       case lc(hh:name) :
      517                           when "b-help" then
      518                               do:
      519                                   hh:load-image-up("cmp/b-help.bmp":u) .
      520                                   hh:load-image-down("cmp/b-help.bmp":u) .
      521                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      522                                   hh:TOOLTIP = "Помощь" .
      523                                   v-help-old-x = hh:column .
      524                                   v-help-old-y = hh:row    .
      525                                   v-help-old-size = hh:width .
      526                                   hh:width-chars = 2.5 .
      527                               end.
      528                           when "b-print" then
      529                               do:
      530                                   hh:load-image("cmp/b-print.bmp":u) .
      531                                   hh:TOOLTIP = "Печать" .
      532                                   v-h[ii] = hh:handle .
      533                                   ii = ii + 1 .
      534                                   hh:width-chars = 3 .
      535                               end.
      536                           when "b-history" or
      537                           when "b-hist" then
      538                               do:
      539                                   hh:load-image("cmp/b-hist.bmp":u) .
      540                                   hh:TOOLTIP = "История" .
      541                                   v-h[ii] = hh:handle .
      542                                   ii = ii + 1 .
      543                                   hh:width-chars = 3 .
      544                               end.
      545                           when "b-sch" then
      546                               do:
      547                                   hh:load-image("cmp/b-sch.bmp":u) .
      548                                   hh:TOOLTIP = "Установка Фильтра" .
      549                                   v-h[ii] = hh:handle .
      550                                   ii = ii + 1 .
      551                                   hh:width-chars = 3 .
      552                               end.
      553                           when "b-hist-user" then
      554                               do:
      555                                   hh:load-image("cmp/b-hist.bmp":u) .
      556                                   hh:TOOLTIP = "История пользователя" .
      557                                   ii = ii + 1 .
      558                               end.
      559                       end case.
      560                   end.
      561                   hh = hh:next-sibling.
      562               end.
      563               b-help:column = v-frame-width - b-help:width-chars.
      564               jj = 0.
      565               repeat ii = 4 to 1 by -1 :
      566                   if valid-handle (v-h[ii] ) then
      567                   do:
      568                       jj  = jj + 1 .
      569                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      570                       v-h[ii]:row    = v-help-old-y .
      571                   end.
      572               end.
      573           end.
      574       end.
      575   end procedure.
      576   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      577   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      578   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      579   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      580   define variable v-diasize-current-frame-width  as decimal   no-undo .
      581   define variable v-diasize-current-frame-height as decimal   no-undo .
      582   define variable v-diasize-change-size          as logical   no-undo .
      583   define variable v-diasize-resize-button        as handle    no-undo .
      584   define variable v-diasize-wndmax               as logical   no-undo .
      585   define variable v-diasize-wndstore             as logical   no-undo .
      586   define variable v-diasize-proc-name            as character no-undo .
      587   define variable v-diasize-browse-handle        as handle    no-undo .
      588   define variable v-diasize-browse-number        as integer   no-undo .
      589   define variable v-diasize-need-full-display    as logical   no-undo init false .
      590   define temp-table temp-diasize-handle no-undo
      591     field handle-value  as handle
      592     field save-position as decimal
      593     index xpk is primary unique handle-value
      594     .
      595   define temp-table temp-browse-handle no-undo
      596     field browse-type   as character
      597     field browse-number as integer
      598     field browse-handle as handle
      599     field original-size as decimal
      600     index xpk is primary unique browse-type browse-number
      601     index xie browse-type browse-handle
      602   .
      603   procedure diasize_change-height :
      604     define input  parameter p-change-value  as decimal   no-undo .
      605     define input  parameter p-move-resize   as logical   no-undo .
      606     define variable v-field-group-handle    as handle    no-undo .
      607     define variable v-object-handle         as handle    no-undo .
      608     define variable v-frame-height          as decimal   no-undo .
      609     define variable v-frame-virtual-height  as decimal   no-undo .
      610     define variable v-browse-height         as decimal   no-undo .
      611     define variable v-window-height         as decimal   no-undo .
      612     define variable v-window-virtual-height as decimal   no-undo .
      613     define variable v-change-sign           as integer   no-undo .
      614     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      615     define buffer buf_temp-browse-handle  for temp-browse-handle .
      616     if p-change-value > 0
      617     then do:
      618       if frame Dialog-Frame :height + p-change-value
      619           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      620       then do:
      621         assign
      622           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      623                           - (frame Dialog-Frame :height-chars)
      624         .
      625         if p-change-value <= 0
      626         then do:
      627           run diasize_position-resize-button in this-procedure .
      628           return .
      629         end.
      630       end.
      631     end.
      632     if p-change-value < 0
      633     then do:
      634       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      635       then do:
      636         assign
      637           p-change-value = v-diasize-orig-frame-height
      638                          - (frame Dialog-Frame :height-chars)
      639         .
      640         if p-change-value >= 0
      641         then do:
      642           run diasize_position-resize-button in this-procedure .
      643           return .
      644         end.
      645       end.
      646     end.
      647     if p-change-value >= 0
      648     then do:
      649       assign
      650         v-change-sign = 1
      651       .
      652     end.
      653     else do:
      654       assign
      655         v-change-sign = -1
      656       .
      657     end.
      658     assign
      659       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      660     .
      661     if p-change-value = 0
      662     then do:
      663       run diasize_position-resize-button in this-procedure .
      664       return .
      665     end.
      666     move_block:
      667     do
      668     on error undo move_block, retry move_block
      669     :
      670       if retry
      671       then do:
      672         do
      673         on error undo move_block, leave move_block
      674         :
      675           if p-change-value > 0
      676           then do:
      677             for each buf_temp-diasize-handle
      678             on error undo, next
      679             :
      680               assign
      681                 v-object-handle = buf_temp-diasize-handle.handle-value
      682               .
      683               if v-object-handle <> v-diasize-resize-button
      684               then do:
      685                 assign
      686                   v-object-handle :row = buf_temp-diasize-handle.save-position
      687                 .
      688               end.
      689             end.
      690             assign
      691               v-diasize-browse-handle :height = v-browse-height
      692             .
      693             for each buf_temp-browse-handle
      694               where buf_temp-browse-handle.browse-type = 'height':u
      695             on error undo, next
      696             :
      697               assign
      698                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      699               .
      700             end.
      701             assign
      702               frame Dialog-Frame :height = v-frame-height
      703             .
      704             if frame Dialog-Frame :scrollable = true
      705             then do:
      706               assign
      707                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      708               .
      709             end.
      710             run diasize_position-resize-button in this-procedure .
      711           end.
      712           else do:
      713             if frame Dialog-Frame :scrollable = true
      714             then do:
      715               assign
      716                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      717               .
      718             end.
      719             assign
      720               frame Dialog-Frame :height = v-frame-height
      721             .
      722             assign
      723               v-diasize-browse-handle :height = v-browse-height
      724             .
      725             for each buf_temp-browse-handle
      726               where buf_temp-browse-handle.browse-type = 'height':u
      727             on error undo, next
      728             :
      729               assign
      730                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      731               .
      732             end.
      733             for each buf_temp-diasize-handle
      734             on error undo, next
      735             :
      736               assign
      737                 v-object-handle = buf_temp-diasize-handle.handle-value
      738               .
      739               if v-object-handle <> v-diasize-resize-button
      740               then do:
      741                 assign
      742                   v-object-handle :row = buf_temp-diasize-handle.save-position
      743                 .
      744               end.
      745             end.
      746             run diasize_position-resize-button in this-procedure .
      747           end.
      748           assign
      749             v-diasize-change-size = false
      750           .
      751           leave move_block .
      752         end.
      753       end.
      754       assign
      755         v-diasize-need-full-display = true
      756       .
      757       if v-diasize-change-size = false
      758       then do:
      759         assign
      760           v-diasize-change-size = true
      761         .
      762       end.
      763       else do:
      764         return .
      765       end.
      766       assign
      767         v-frame-height = frame Dialog-Frame :height
      768         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      769         v-browse-height = v-diasize-browse-handle :height
      770       .
      771       for each buf_temp-browse-handle
      772         where buf_temp-browse-handle.browse-type = 'height':u
      773       :
      774         assign
      775           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      776         .
      777       end.
      778       for each buf_temp-diasize-handle
      779       :
      780         delete buf_temp-diasize-handle .
      781       end.
      782       assign
      783         v-field-group-handle = frame Dialog-Frame :first-child
      784       .
      785       do while valid-handle(v-field-group-handle)
      786       :
      787         assign
      788           v-object-handle = v-field-group-handle :first-child
      789         .
      790         do while valid-handle(v-object-handle)
      791         :
      792           if  v-object-handle <> v-diasize-browse-handle :handle
      793           and can-query(v-object-handle, "row")
      794           and can-query(v-object-handle, "height")
      795           and ( v-object-handle :row > v-diasize-browse-handle :row )
      796           then do:
      797             find first buf_temp-browse-handle
      798               where buf_temp-browse-handle.browse-type   = 'height':u
      799                 and buf_temp-browse-handle.browse-handle = v-object-handle
      800               no-error .
      801             if available buf_temp-browse-handle
      802             then do:
      803             end.
      804             else do:
      805               create buf_temp-diasize-handle .
      806               assign
      807                 buf_temp-diasize-handle.handle-value  = v-object-handle
      808                 buf_temp-diasize-handle.save-position = v-object-handle :row
      809               .
      810             end.
      811           end.
      812           assign
      813             v-object-handle = v-object-handle :next-sibling
      814           .
      815         end.
      816         assign
      817           v-field-group-handle = v-field-group-handle :next-sibling
      818         .
      819       end.
      820       do with frame Dialog-Frame
      821       :
      822         hide v-diasize-resize-button .
      823         assign
      824           v-diasize-resize-button :row    = 1
      825           v-diasize-resize-button :column = 1
      826         .
      827       end.
      828       if p-change-value > 0
      829       then do:
      830         if frame Dialog-Frame :scrollable = true
      831         then do:
      832           assign
      833             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      834             no-error .
      835           if error-status :error
      836           or error-status :get-message(1) <> ""
      837           then do:
      838             undo move_block, retry move_block .
      839           end.
      840         end.
      841         assign
      842           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      843           no-error .
      844         if error-status :error
      845         or error-status :get-message(1) <> ""
      846         then do:
      847           undo move_block, retry move_block .
      848         end.
      849         assign
      850           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      851           no-error .
      852         if error-status :error
      853         or error-status :get-message(1) <> ""
      854         then do:
      855           undo move_block, retry move_block .
      856         end.
      857         for each buf_temp-browse-handle
      858           where buf_temp-browse-handle.browse-type = 'height':u
      859         on error undo move_block, retry move_block
      860         :
      861           assign
      862             buf_temp-browse-handle.browse-handle :height
      863               = buf_temp-browse-handle.browse-handle :height + p-change-value
      864             no-error .
      865           if error-status :error
      866           or error-status :get-message(1) <> ""
      867           then do:
      868             undo move_block, retry move_block .
      869           end.
      870         end.
      871         for each buf_temp-diasize-handle
      872         on error undo move_block, retry move_block
      873         :
      874           assign
      875             v-object-handle = buf_temp-diasize-handle.handle-value
      876           .
      877           if v-object-handle <> v-diasize-resize-button
      878           then do:
      879             assign
      880               v-object-handle :row = v-object-handle :row + p-change-value
      881               no-error .
      882             if error-status :error
      883             or error-status :get-message(1) <> ""
      884             then do:
      885               undo move_block, retry move_block .
      886             end.
      887           end.
      888         end.
      889       end.
      890       else do:
      891         for each buf_temp-diasize-handle
      892         on error undo move_block, retry move_block
      893         :
      894           assign
      895             v-object-handle = buf_temp-diasize-handle.handle-value
      896           .
      897           if v-object-handle <> v-diasize-resize-button
      898           then do:
      899             assign
      900               v-object-handle :row = v-object-handle :row + p-change-value
      901               no-error .
      902             if error-status :error
      903             or error-status :get-message(1) <> ""
      904             then do:
      905               undo move_block, retry move_block .
      906             end.
      907           end.
      908         end.
      909         assign
      910           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      911           no-error .
      912         if error-status :error
      913         or error-status :get-message(1) <> ""
      914         then do:
      915           undo move_block, retry move_block .
      916         end.
      917         for each buf_temp-browse-handle
      918           where buf_temp-browse-handle.browse-type = 'height':u
      919         on error undo move_block, retry move_block
      920         :
      921           assign
      922             buf_temp-browse-handle.browse-handle :height
      923               = buf_temp-browse-handle.browse-handle :height + p-change-value
      924             no-error .
      925           if error-status :error
      926           or error-status :get-message(1) <> ""
      927           then do:
      928             undo move_block, retry move_block .
      929           end.
      930         end.
      931         assign
      932           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      933           no-error .
      934         if error-status :error
      935         or error-status :get-message(1) <> ""
      936         then do:
      937           undo move_block, retry move_block .
      938         end.
      939         if frame Dialog-Frame :scrollable = true
      940         then do:
      941           assign
      942             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      943             no-error .
      944           if error-status :error
      945           or error-status :get-message(1) <> ""
      946           then do:
      947             undo move_block, retry move_block .
      948           end.
      949         end.
      950       end.
      951       if p-move-resize = true
      952       then do:
      953         run diasize_position-resize-button in this-procedure .
      954       end.
      955       if v-diasize-wndstore = true
      956       then do:
      957         if connected("ub") = true
      958         then do:
      959           define variable v-cntxt-db-num        as integer   no-undo .
      960           define variable v-cntxt-userid        as character no-undo .
      961           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      962                                             , OUTPUT v-cntxt-userid
      963                                             ) .
      964           run gbl/wndsizew.p
      965             (input  v-cntxt-db-num
      966             ,input  v-cntxt-userid
      967             ,input  v-diasize-proc-name
      968             ,input  'height':u
      969             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
      970             ) .
      971         end.
      972       end.
      973     end.
      974     assign
      975       v-diasize-change-size = false
      976     .
      977   end procedure.
      978   procedure diasize_set-height :
      979     define input  parameter p-new-height  as decimal   no-undo .
      980     define input  parameter p-move-resize as logical   no-undo .
      981     do
      982     on error undo, return error return-value
      983     :
      984       run diasize_change-height in this-procedure
      985         (input  (p-new-height - frame Dialog-Frame :height)
      986         ,input  p-move-resize
      987         ) .
      988     end.
      989   end procedure.
      990   procedure diasize_change-width :
      991     define input  parameter p-change-value as decimal   no-undo .
      992     define input  parameter p-move-resize  as logical   no-undo .
      993     define variable v-field-group-handle   as handle    no-undo .
      994     define variable v-object-handle        as handle    no-undo .
      995     define variable v-frame-width          as decimal   no-undo .
      996     define variable v-frame-virtual-width  as decimal   no-undo .
      997     define variable v-browse-width         as decimal   no-undo .
      998     define variable v-window-width         as decimal   no-undo .
      999     define variable v-window-virtual-width as decimal   no-undo .
     1000     define variable v-change-sign          as integer   no-undo .
     1001     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1002     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1003     if p-change-value > 0
     1004     then do:
     1005       if frame Dialog-Frame :width + p-change-value >
     1006           session :width-chars
     1007       then do:
     1008         assign
     1009           p-change-value = session :width-chars - frame Dialog-Frame :width
     1010         .
     1011         if p-change-value <= 0
     1012         then do:
     1013           run diasize_position-resize-button in this-procedure .
     1014           return .
     1015         end.
     1016       end.
     1017     end.
     1018     if p-change-value < 0
     1019     then do:
     1020       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1021       then do:
     1022         assign
     1023           p-change-value = v-diasize-orig-frame-width
     1024                          - frame Dialog-Frame :width
     1025         .
     1026         if p-change-value >= 0
     1027         then do:
     1028           run diasize_position-resize-button in this-procedure .
     1029           return .
     1030         end.
     1031       end.
     1032     end.
     1033     if p-change-value >= 0
     1034     then do:
     1035       assign
     1036         v-change-sign = 1
     1037       .
     1038     end.
     1039     else do:
     1040       assign
     1041         v-change-sign = -1
     1042       .
     1043     end.
     1044     assign
     1045       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1046     .
     1047     if p-change-value = 0
     1048     then do:
     1049       run diasize_position-resize-button in this-procedure .
     1050       return .
     1051     end.
     1052     move_block:
     1053     do
     1054     on error undo move_block, leave move_block
     1055     :
     1056       if retry
     1057       then do:
     1058         do
     1059         on error undo move_block, leave move_block
     1060         :
     1061           if p-change-value > 0
     1062           then do:
     1063             for each buf_temp-diasize-handle
     1064             on error undo, next
     1065             :
     1066               assign
     1067                 v-object-handle = buf_temp-diasize-handle.handle-value
     1068               .
     1069               if v-object-handle <> v-diasize-resize-button
     1070               then do:
     1071                 assign
     1072                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1073                 .
     1074               end.
     1075             end.
     1076             assign
     1077               v-diasize-browse-handle :width = v-browse-width
     1078             .
     1079             for each buf_temp-browse-handle
     1080               where buf_temp-browse-handle.browse-type = 'width':u
     1081             on error undo, next
     1082             :
     1083               assign
     1084                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1085               .
     1086             end.
     1087             assign
     1088               frame Dialog-Frame :width = v-frame-width
     1089             .
     1090             if frame Dialog-Frame :scrollable = true
     1091             then do:
     1092               assign
     1093                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1094               .
     1095             end.
     1096             run diasize_position-resize-button in this-procedure .
     1097           end.
     1098           else do:
     1099             if frame Dialog-Frame :scrollable = true
     1100             then do:
     1101               assign
     1102                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1103               .
     1104             end.
     1105             assign
     1106               frame Dialog-Frame :width = v-frame-width
     1107             .
     1108             for each buf_temp-browse-handle
     1109               where buf_temp-browse-handle.browse-type = 'width':u
     1110             on error undo, next
     1111             :
     1112               assign
     1113                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1114               .
     1115             end.
     1116             assign
     1117               v-diasize-browse-handle :width = v-browse-width
     1118             .
     1119             for each buf_temp-diasize-handle
     1120             on error undo, next
     1121             :
     1122               assign
     1123                 v-object-handle = buf_temp-diasize-handle.handle-value
     1124               .
     1125               if v-object-handle <> v-diasize-resize-button
     1126               then do:
     1127                 assign
     1128                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1129                 .
     1130               end.
     1131             end.
     1132             run diasize_position-resize-button in this-procedure .
     1133           end.
     1134           assign
     1135             v-diasize-change-size = false
     1136           .
     1137           leave move_block .
     1138         end.
     1139       end.
     1140       assign
     1141         v-diasize-need-full-display = true
     1142       .
     1143       if v-diasize-change-size = false
     1144       then do:
     1145         assign
     1146           v-diasize-change-size = true
     1147         .
     1148       end.
     1149       else do:
     1150         return .
     1151       end.
     1152       assign
     1153         v-frame-width = frame Dialog-Frame :width
     1154         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1155         v-browse-width = v-diasize-browse-handle :width
     1156       .
     1157       for each buf_temp-browse-handle
     1158         where buf_temp-browse-handle.browse-type = 'width':u
     1159       :
     1160         assign
     1161           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1162         .
     1163       end.
     1164       for each buf_temp-diasize-handle
     1165       :
     1166         delete buf_temp-diasize-handle .
     1167       end.
     1168       assign
     1169         v-field-group-handle = frame Dialog-Frame :first-child
     1170       .
     1171       do while valid-handle(v-field-group-handle)
     1172       :
     1173         assign
     1174           v-object-handle = v-field-group-handle :first-child
     1175         .
     1176         do while valid-handle(v-object-handle)
     1177         :
     1178           if  v-object-handle <> v-diasize-browse-handle :handle
     1179           and v-object-handle <> v-diasize-resize-button
     1180           and can-query(v-object-handle, "row")
     1181           and can-query(v-object-handle, "height")
     1182           and ( v-object-handle :col + v-object-handle :width
     1183                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1184               )
     1185           then do:
     1186             find first buf_temp-browse-handle
     1187               where buf_temp-browse-handle.browse-type   = 'width':u
     1188                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1189               no-error .
     1190             if available buf_temp-browse-handle
     1191             then do:
     1192             end.
     1193             else do:
     1194               create buf_temp-diasize-handle .
     1195               assign
     1196                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1197                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1198               .
     1199             end.
     1200           end.
     1201           assign
     1202             v-object-handle = v-object-handle :next-sibling
     1203           .
     1204         end.
     1205         assign
     1206           v-field-group-handle = v-field-group-handle :next-sibling
     1207         .
     1208       end.
     1209       do with frame Dialog-Frame
     1210       :
     1211         hide v-diasize-resize-button .
     1212         v-diasize-resize-button :row = 1.
     1213         v-diasize-resize-button :column = 1.
     1214       end.
     1215       if p-change-value > 0
     1216       then do:
     1217         if frame Dialog-Frame :scrollable = true
     1218         then do:
     1219           assign
     1220             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1221             no-error .
     1222           if error-status :error
     1223           or error-status :get-message(1) <> ""
     1224           then do:
     1225             undo move_block, retry move_block.
     1226           end.
     1227         end.
     1228         assign
     1229           frame Dialog-Frame :width = v-frame-width + p-change-value
     1230           no-error .
     1231         if error-status :error
     1232         or error-status :get-message(1) <> ""
     1233         then do:
     1234           undo move_block, retry move_block.
     1235         end.
     1236         assign
     1237           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1238         no-error .
     1239         if error-status :error
     1240         or error-status :get-message(1) <> ""
     1241         then do:
     1242           undo move_block, retry move_block.
     1243         end.
     1244         for each buf_temp-browse-handle
     1245           where buf_temp-browse-handle.browse-type = 'width':u
     1246         on error undo move_block, retry move_block
     1247         :
     1248           assign
     1249             buf_temp-browse-handle.browse-handle :width
     1250               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1251             no-error .
     1252           if error-status :error
     1253           or error-status :get-message(1) <> ""
     1254           then do:
     1255             undo move_block, retry move_block .
     1256           end.
     1257         end.
     1258         for each buf_temp-diasize-handle
     1259         on error undo move_block, retry move_block
     1260         :
     1261           assign
     1262             v-object-handle = buf_temp-diasize-handle.handle-value
     1263           .
     1264           if v-object-handle <> v-diasize-resize-button
     1265           then do:
     1266             assign
     1267               v-object-handle :col = v-object-handle :col + p-change-value
     1268               no-error .
     1269             if error-status :error
     1270             or error-status :get-message(1) <> ""
     1271             then do:
     1272               undo move_block, retry move_block .
     1273             end.
     1274           end.
     1275         end.
     1276       end.
     1277       else do:
     1278         for each buf_temp-diasize-handle
     1279         on error undo move_block, retry move_block
     1280         :
     1281           assign
     1282             v-object-handle = buf_temp-diasize-handle.handle-value
     1283           .
     1284           if v-object-handle <> v-diasize-resize-button
     1285           then do:
     1286             assign
     1287               v-object-handle :col = v-object-handle :col + p-change-value
     1288               no-error .
     1289             if error-status :error
     1290             or error-status :get-message(1) <> ""
     1291             then do:
     1292               undo move_block, retry move_block .
     1293             end.
     1294           end.
     1295         end.
     1296         for each buf_temp-browse-handle
     1297           where buf_temp-browse-handle.browse-type = 'width':u
     1298         on error undo move_block, retry move_block
     1299         :
     1300           assign
     1301             buf_temp-browse-handle.browse-handle :width
     1302               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1303             no-error .
     1304           if error-status :error
     1305           or error-status :get-message(1) <> ""
     1306           then do:
     1307             undo move_block, retry move_block .
     1308           end.
     1309         end.
     1310         assign
     1311           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1312           no-error .
     1313         if error-status :error
     1314         or error-status :get-message(1) <> ""
     1315         then do:
     1316           undo move_block, retry move_block.
     1317         end.
     1318         assign
     1319           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1320         no-error .
     1321         if error-status :error
     1322         or error-status :get-message(1) <> ""
     1323         then do:
     1324           undo move_block, retry move_block.
     1325         end.
     1326         if frame Dialog-Frame :scrollable = true
     1327         then do:
     1328           assign
     1329             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1330           no-error .
     1331           if error-status :error
     1332           or error-status :get-message(1) <> ""
     1333           then do:
     1334             undo move_block, retry move_block.
     1335           end.
     1336         end.
     1337       end.
     1338       if p-move-resize
     1339       then do:
     1340         run diasize_position-resize-button in this-procedure .
     1341       end.
     1342       if v-diasize-wndstore = true
     1343       then do:
     1344         if connected("ub") = true
     1345         then do:
     1346           define variable v-cntxt-db-num        as integer   no-undo .
     1347           define variable v-cntxt-userid        as character no-undo .
     1348           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1349                                             , OUTPUT v-cntxt-userid
     1350                                             ) .
     1351           run gbl/wndsizew.p
     1352             (input  v-cntxt-db-num
     1353             ,input  v-cntxt-userid
     1354             ,input  v-diasize-proc-name
     1355             ,input  'width':u
     1356             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1357             ) .
     1358         end.
     1359       end.
     1360     end.
     1361     assign
     1362       v-diasize-change-size = false
     1363     .
     1364   end procedure.
     1365   procedure diasize_set-width :
     1366     define input  parameter p-new-width  as decimal   no-undo .
     1367     define input  parameter p-move-resize as logical   no-undo .
     1368     do
     1369     on error undo, return error return-value
     1370     :
     1371       run diasize_change-width in this-procedure
     1372         (input  (p-new-width - frame Dialog-Frame :width)
     1373         ,input  p-move-resize
     1374         ) .
     1375     end.
     1376   end procedure.
     1377   procedure diasize_position-resize-button :
     1378     do with frame Dialog-Frame
     1379     :
     1380       hide v-diasize-resize-button .
     1381       assign
     1382         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1383                     - 1
     1384                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1385         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1386                     - 1
     1387                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1388       .
     1389       view v-diasize-resize-button .
     1390     end.
     1391   end procedure.
     1392   on alt-right anywhere
     1393   do:
     1394     run diasize_change-width in this-procedure
     1395       (input 1
     1396       ,input true
     1397       ) .
     1398     return no-apply .
     1399   end.
     1400   on alt-left anywhere
     1401   do:
     1402     run diasize_change-width in this-procedure
     1403       (input -1
     1404       ,input true
     1405       ) .
     1406     return no-apply .
     1407   end.
     1408   on alt-down anywhere
     1409   do:
     1410     run diasize_change-height in this-procedure
     1411       (input 1
     1412       ,input true
     1413       ) .
     1414     return no-apply .
     1415   end.
     1416   on alt-up anywhere
     1417   do:
     1418     run diasize_change-height in this-procedure
     1419       (input -1
     1420       ,input true
     1421       ) .
     1422     return no-apply .
     1423   end.
     1424   on alt-enter of frame Dialog-Frame
     1425   do:
     1426     run diasize_maximize in this-procedure
     1427       (input  ?
     1428       ).
     1429     return no-apply .
     1430   end.
     1431   procedure diasize_end-move :
     1432     do
     1433     on error undo, return error return-value
     1434     :
     1435       define variable v-row-delta as decimal   no-undo .
     1436       define variable v-col-delta as decimal   no-undo .
     1437       define variable v-new-row as decimal   no-undo .
     1438       define variable v-new-col as decimal   no-undo .
     1439       assign
     1440         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1441         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1442       .
     1443       assign
     1444         v-row-delta = v-new-row - frame Dialog-Frame :height
     1445         v-col-delta = v-new-col - frame Dialog-Frame :width
     1446       .
     1447       run diasize_change-height in this-procedure
     1448         (input v-row-delta
     1449         ,input true
     1450         ) .
     1451       run diasize_change-width in this-procedure
     1452         (input v-col-delta
     1453         ,input true
     1454         ) .
     1455     end.
     1456   end procedure.
     1457   procedure diasize_maximize :
     1458     define input  parameter p-action as logical   no-undo .
     1459     do
     1460     on error undo, return error return-value
     1461     :
     1462       if p-action = ?
     1463       then do:
     1464         if v-diasize-need-maximize = true
     1465         then do:
     1466           assign
     1467             p-action = true
     1468           .
     1469         end.
     1470         else do:
     1471           assign
     1472             p-action = false
     1473           .
     1474         end.
     1475       end.
     1476       if p-action = true
     1477       then do:
     1478         run diasize_change-height in this-procedure
     1479           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1480               - frame Dialog-Frame :height-chars
     1481           ,input true
     1482           ) .
     1483         run diasize_change-width in this-procedure
     1484           (input session :width-chars
     1485               - frame Dialog-Frame :width-chars
     1486           ,input true
     1487           ) .
     1488         assign
     1489           v-diasize-need-maximize = false
     1490         .
     1491       end.
     1492       else do:
     1493         run diasize_change-width in this-procedure
     1494           (input v-diasize-orig-frame-width
     1495               - frame Dialog-Frame :width-chars
     1496           ,input true
     1497           ) .
     1498         run diasize_change-height in this-procedure
     1499           (input v-diasize-orig-frame-height
     1500               - frame Dialog-Frame :height-chars
     1501           ,input true
     1502           ) .
     1503         assign
     1504           v-diasize-need-maximize = true
     1505         .
     1506       end.
     1507     end.
     1508   end procedure.
     1509   procedure diasize_restore-orig-size :
     1510     do
     1511     on error undo, return error return-value
     1512     :
     1513       assign
     1514         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1515         v-diasize-current-frame-height = frame Dialog-Frame :height
     1516       .
     1517       run diasize_set-height in this-procedure
     1518         (input  v-diasize-orig-frame-height
     1519         ,input  true
     1520         ) .
     1521       run diasize_set-width in this-procedure
     1522         (input  v-diasize-orig-frame-width
     1523         ,input  true
     1524         ) .
     1525     end.
     1526   end procedure.
     1527   procedure diasize_restore-current-size :
     1528     do
     1529     on error undo, return error return-value
     1530     :
     1531       run diasize_set-height in this-procedure
     1532         (input  v-diasize-current-frame-height
     1533         ,input  true
     1534         ) .
     1535       run diasize_set-width in this-procedure
     1536         (input  v-diasize-current-frame-width
     1537         ,input  true
     1538         ) .
     1539     end.
     1540   end procedure.
     1541   procedure diasize_set-browse-handle :
     1542     define input  parameter p-browse-handle as handle   no-undo .
     1543     define buffer buf_temp-browse-handle for temp-browse-handle .
     1544     do
     1545     on error undo, return error return-value
     1546     :
     1547       assign
     1548         v-diasize-browse-handle = p-browse-handle
     1549       .
     1550       for each buf_temp-browse-handle
     1551       on error undo, return error return-value
     1552       :
     1553         delete buf_temp-browse-handle .
     1554       end.
     1555     end.
     1556   end procedure.
     1557   procedure diasize_add_browse :
     1558     define input  parameter p-browse-type   as character no-undo .
     1559     define input  parameter p-browse-handle as handle    no-undo .
     1560     define buffer buf_temp-browse-handle for temp-browse-handle .
     1561     do
     1562     on error undo, return error return-value
     1563     :
     1564       assign
     1565         v-diasize-browse-number = v-diasize-browse-number + 1
     1566       .
     1567       create buf_temp-browse-handle .
     1568       assign
     1569         buf_temp-browse-handle.browse-type   = p-browse-type
     1570         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1571         buf_temp-browse-handle.browse-handle = p-browse-handle
     1572       .
     1573     end.
     1574   end procedure.
     1575   procedure diasize_init :
     1576     define variable v-default-value    as logical   no-undo .
     1577     define variable v-restore-saved    as logical   no-undo .
     1578     define variable v-resize-value-str as character no-undo .
     1579     do
     1580     on error undo, return error return-value
     1581     :
     1582       do with frame Dialog-Frame
     1583       :
     1584         assign
     1585           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1586           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1587           v-diasize-browse-handle     = browse BROWSE-2 :handle
     1588         .
     1589         create button v-diasize-resize-button
     1590         assign
     1591           parent        = frame Dialog-Frame :first-child
     1592           label         = "s"
     1593           height-pixels = 16
     1594           width-pixels  = 16
     1595           visible       = true
     1596           sensitive     = true
     1597           movable       = true
     1598           triggers:
     1599             on end-move persistent run diasize_end-move in this-procedure .
     1600           end triggers.
     1601         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1602         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1603         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1604         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1605         assign
     1606           v-diasize-wndmax = false
     1607         .
     1608         if connected("ub") = true
     1609         then do:
     1610           define variable v-cntxt-db-num        as integer   no-undo .
     1611           define variable v-cntxt-userid        as character no-undo .
     1612           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1613                                             , OUTPUT v-cntxt-userid
     1614                                             ) .
     1615           run gbl/wndpar_r.p
     1616             (input  v-cntxt-db-num
     1617             ,input  v-cntxt-userid
     1618             ,input  'wndmax':U
     1619             ,output v-diasize-wndmax
     1620             ,output v-default-value
     1621             ) .
     1622         end.
     1623         assign
     1624           v-diasize-wndstore = false
     1625         .
     1626         if connected("ub") = true
     1627         then do:
     1628           run gbl/wndpar_r.p
     1629             (input  v-cntxt-db-num
     1630             ,input  v-cntxt-userid
     1631             ,input  'wndstore':U
     1632             ,output v-diasize-wndstore
     1633             ,output v-default-value
     1634             ) .
     1635         end.
     1636         assign
     1637           v-diasize-proc-name = entry(1, program-name(2), '.')
     1638         .
     1639         if v-diasize-wndstore = true
     1640         then do:
     1641           assign
     1642             v-restore-saved = false
     1643           .
     1644           if connected("ub") = true
     1645           then do:
     1646             run gbl/wndsizer.p
     1647               (input  v-cntxt-db-num
     1648               ,input  v-cntxt-userid
     1649               ,input  v-diasize-proc-name
     1650               ,input  'height':u
     1651               ,output v-resize-value-str
     1652               ) .
     1653             if v-resize-value-str <> '':U
     1654             then do:
     1655               run diasize_change-height in this-procedure
     1656                 (input  integer(v-resize-value-str)
     1657                 ,input  true
     1658                 ) .
     1659               assign
     1660                 v-restore-saved = true
     1661               .
     1662             end.
     1663           end.
     1664           if connected("ub") = true
     1665           then do:
     1666             run gbl/wndsizer.p
     1667               (input  v-cntxt-db-num
     1668               ,input  v-cntxt-userid
     1669               ,input  v-diasize-proc-name
     1670               ,input  'width':u
     1671               ,output v-resize-value-str
     1672               ) .
     1673             if v-resize-value-str <> '':U
     1674             then do:
     1675               run diasize_change-width in this-procedure
     1676                 (input  integer(v-resize-value-str)
     1677                 ,input  true
     1678                 ) .
     1679               assign
     1680                 v-restore-saved = true
     1681               .
     1682             end.
     1683           end.
     1684           if v-restore-saved <> true
     1685           then do:
     1686             if v-diasize-wndmax = true
     1687             then do:
     1688               run diasize_maximize in this-procedure
     1689                 (input  true
     1690                 ) .
     1691             end.
     1692           end.
     1693         end.
     1694         else do:
     1695           if v-diasize-wndmax = true
     1696           then do:
     1697             run diasize_maximize in this-procedure
     1698               (input  true
     1699               ) .
     1700           end.
     1701         end.
     1702       end.
     1703     end.
     1704   end procedure.
     1705   procedure diasize_need-full-display :
     1706     define output parameter p-need-full-display as logical   no-undo .
     1707     do
     1708     on error undo, return error return-value
     1709     :
     1710       assign
     1711         p-need-full-display = v-diasize-need-full-display
     1712       .
     1713       assign
     1714         v-diasize-need-full-display = false
     1715       .
     1716     end.
     1717   end procedure.
     1718   procedure get-context :
     1719      define output parameter p-db-num as integer          no-undo.
     1720      define output parameter p-user-id as character        no-undo.
     1721      define variable v-login               as character    no-undo.
     1722      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1723      define buffer buf_user-login  for ub.user-login .
     1724      do
     1725      on error undo, return error
     1726      :
     1727            FIND FIRST buf_sys-ctrl no-lock.
     1728            ASSIGN
     1729               v-login = USERID("ub")
     1730               p-db-num = buf_sys-ctrl.db-num
     1731            .
     1732            FIND FIRST buf_user-login
     1733                 WHERE buf_user-login.db-num = p-db-num
     1734                   AND buf_user-login.user-login = v-login
     1735                 no-lock
     1736                 no-error
     1737                 .
     1738            IF AVAILABLE buf_user-login
     1739            THEN DO:
     1740               assign
     1741                  p-user-id = buf_user-login.user-id
     1742               .
     1743            END.
     1744      end.
     1745   end procedure.
     1746       run diasize_init in this-procedure .
     1747   def var sort-labelBROWSE-2   as character no-undo .
     1748   def var sort-clmnBROWSE-2    as handle    no-undo .
     1749   def var cur-clmnBROWSE-2     as handle    no-undo .
     1750   def var cur-clmn-locBROWSE-2 as integer   no-undo .
     1751   def var re-queryBROWSE-2     as logical   initial no no-undo .
     1752   on start-search, ctrl-o of BROWSE-2 in frame Dialog-Frame do:
     1753      run sort-brBROWSE-2
     1754        (input (if available tt-alc-type
     1755                then recid(tt-alc-type)
     1756                else ?
     1757               )
     1758        ).
     1759   end.
     1760   PROCEDURE sort-brBROWSE-2 :
     1761     define input parameter p-recid as recid no-undo .
     1762     if re-queryBROWSE-2 = no then do:
     1763       assign
     1764          cur-clmnBROWSE-2 = BROWSE-2:current-column in frame Dialog-Frame
     1765       .
     1766       if sort-clmnBROWSE-2 <> ? then sort-clmnBROWSE-2:column-fgcolor = 0.
     1767       if cur-clmnBROWSE-2 = sort-clmnBROWSE-2 then do:
     1768         assign
     1769            sort-labelBROWSE-2 = ""
     1770            sort-clmnBROWSE-2 = ?
     1771         .
     1772        end.
     1773        else do:
     1774          assign
     1775            sort-labelBROWSE-2 = cur-clmnBROWSE-2:label
     1776            sort-clmnBROWSE-2  = cur-clmnBROWSE-2
     1777            sort-clmnBROWSE-2:column-fgcolor = 4
     1778          .
     1779        end.
     1780      end.
     1781     assign
     1782       cur-clmn-locBROWSE-2 = 1
     1783     .
     1784     def var column-handle as handle no-undo .
     1785     column-handle = BROWSE-2:first-column.
     1786     do while valid-handle(column-handle) :
     1787       if column-handle = cur-clmnBROWSE-2 then do:
     1788         leave .
     1789       end.
     1790       column-handle = column-handle:NEXT-COLUMN.
     1791       assign
     1792         cur-clmn-locBROWSE-2 = cur-clmn-locBROWSE-2 + 1
     1793       .
     1794     end.
     1795     case sort-labelBROWSE-2:
     1796           when v-brws-mark:label in browse BROWSE-2 then DO:   run refresh-query in this-procedure.   . END.
     1797           when tt-alc-type.alc-type-code:label in browse BROWSE-2 then DO:   run refresh-query in this-procedure.   . END.
     1798           when tt-alc-type.alc-type-name:label in browse BROWSE-2 then DO:   run refresh-query in this-procedure.   . END.
     1799           when v-status:label in browse BROWSE-2 then DO:   run refresh-query in this-procedure.   . END.
     1800           when tt-alc-type.alc-type:label in browse BROWSE-2 then DO:   run refresh-query in this-procedure.   . END.
     1801       otherwise do:
     1802         run refresh-query in this-procedure.
     1803         if sort-labelBROWSE-2 <> "" then do:
     1804           assign
     1805             cur-clmnBROWSE-2:column-fgcolor = 0
     1806           .
     1807         end.
     1808         assign
     1809           cur-clmn-locBROWSE-2 = ?
     1810         .
     1811       end.
     1812     end case.
     1813     if p-recid <> ? then do:
     1814       reposition BROWSE-2 to recid p-recid no-error.
     1815       apply "value-changed" to BROWSE-2 in frame Dialog-Frame.
     1816     end.
     1817     apply "entry" to BROWSE-2 in frame Dialog-Frame.
     1818   END PROCEDURE.
     1819   procedure re-open-query-srt-clmnBROWSE-2:
     1820   if cur-clmnBROWSE-2 = ? then do:
     1821      run refresh-query in this-procedure.
     1822   end.
     1823   else do:
     1824      assign re-queryBROWSE-2 = yes.
     1825      run sort-brBROWSE-2
     1826        (input (if available tt-alc-type
     1827                then recid(tt-alc-type)
     1828                else ?
     1829               )
     1830        ).
     1831      assign re-queryBROWSE-2 = no.
     1832   end.
     1833   end.
     1834   MAIN-BLOCK:
     1835   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1836      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1837      assign
     1838         rs-sort = 1
     1839     .
     1840     assign
     1841       tt-alc-type.alc-type-code  :resizable in browse BROWSE-2 = true
     1842       tt-alc-type.alc-type-name  :resizable in browse BROWSE-2 = true
     1843       v-status                   :resizable in browse BROWSE-2 = true
     1844       tt-alc-type.alc-type       :resizable in browse BROWSE-2 = true
     1845     .
     1846     RUN enable_UI in this-procedure.
     1847     run post-enable-UI in this-procedure.
     1848     WAIT-FOR GO OF FRAME Dialog-Frame.
     1849   END.
     1850   RUN disable_UI in this-procedure.
     1851   PROCEDURE delete-alc-type :
     1852     define buffer del_alc-type for ub.alc-type.
     1853     find first del_alc-type
     1854          where recid(del_alc-type) = tt-alc-type.rec
     1855          exclusive-lock
     1856          no-error.
     1857     if not available del_alc-type then DO:
     1858        return error.
     1859     end.
     1860     delete del_alc-type.
     1861   END PROCEDURE.
     1862   PROCEDURE disable_UI :
     1863     HIDE FRAME Dialog-Frame.
     1864   END PROCEDURE.
     1865   PROCEDURE enable_UI :
     1866     DISPLAY rs-sort
     1867         WITH FRAME Dialog-Frame.
     1868     ENABLE b-exit b-mark b-sel b-hist b-help rs-sort b-add b-cng b-del b-load
     1869            b-goods BROWSE-2
     1870         WITH FRAME Dialog-Frame.
     1871     VIEW FRAME Dialog-Frame.
     1872     run refresh-query in this-procedure.
     1873   END PROCEDURE.
     1874   PROCEDURE post-enable-UI :
     1875       disable
     1876           b-add
     1877           b-sel
     1878           b-mark
     1879           b-cng
     1880           b-del
     1881           b-load
     1882       WITH FRAME  Dialog-Frame.
     1883       ENABLE
     1884           b-add  WHEN  ((lookup  ( "b-add" , bttns) > 0 ) AND ( v-cntxt-db-num = 0 ))
     1885           b-sel  WHEN  ( lookup  ( "b-sel" , bttns) > 0 )
     1886           b-mark when  ( lookup  ( "b-mark", bttns) > 0 )
     1887           b-cng  WHEN  ((lookup  ( "b-add" , bttns) > 0 ) AND ( v-cntxt-db-num = 0 ))
     1888           b-del  WHEN  ((lookup  ( "b-add" , bttns) > 0 ) AND ( v-cntxt-db-num = 0 ))
     1889           b-load WHEN  ((lookup  ( "b-add" , bttns) > 0 ) AND ( v-cntxt-db-num = 0 ))
     1890       WITH FRAME  Dialog-Frame.
     1891   define variable vss-include-info8 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1892   do:
     1893     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1894       (input  v-cntxt-db-num
     1895       ,input  v-cntxt-userid
     1896       ,input  0
     1897       ,input  'actn_alc-type-update':U
     1898       ,input  'object':U
     1899       ,input  0
     1900       ,input  v-cntxt-obj-type
     1901       ,input  v-cntxt-obj-code
     1902       ,input  0
     1903       ,input  0
     1904       ,input  0
     1905       ,input  false
     1906       ,output v-ok
     1907       )  .
     1908   end.
     1909       IF NOT v-ok then do:
     1910         disable
     1911            b-add
     1912            b-cng
     1913            b-del
     1914            b-load
     1915         WITH FRAME  Dialog-Frame.
     1916       end.
     1917   END PROCEDURE.
     1918   PROCEDURE refresh-query :
     1919    define variable v-alc as integer no-undo initial 0 .
     1920     for each br_alc-type:
     1921         find first tt-alc-type where tt-alc-type.alc-type-inner-code = br_alc-type.alc-type-inner-code no-lock no-error .
     1922         if not available tt-alc-type then do:
     1923         create tt-alc-type .
     1924         BUFFER-COPY br_alc-type to tt-alc-type
     1925         assign
     1926         tt-alc-type.rec = recid(br_alc-type).
     1927         end.
     1928         find br_alc-type-attr where br_alc-type-attr.alc-type-inner-code = br_alc-type.alc-type-inner-code
     1929                                 and br_alc-type-attr.attr-code = "alc-type" no-lock no-error .
     1930         if available br_alc-type-attr then do:
     1931           if br_alc-type-attr.attr-value = "1" then tt-alc-type.alc-type = "Алког. продукция" .
     1932           else tt-alc-type.alc-type = "Пивная продукция" .
     1933         end.
     1934     end.
     1935         if (lookup  ( "alc" , bttns) > 0 ) then do:
     1936           v-alc = 1 .
     1937         end.
     1938         if (lookup  ( "alc-p" , bttns) > 0 ) then do:
     1939           v-alc = 2 .
     1940         end.
     1941         case v-alc:
     1942           when 0 then do:
     1943               case rs-sort :
     1944                 when 1 then do:
     1945                   OPEN QUERY BROWSE-2 FOR EACH tt-alc-type
     1946                              by tt-alc-type.alc-type-name
     1947                              indexed-reposition .
     1948                 end.
     1949                 OTHERWISE do:
     1950                   OPEN QUERY BROWSE-2 FOR EACH tt-alc-type
     1951                              by tt-alc-type.alc-type-code
     1952                              indexed-reposition .
     1953                 end.
     1954               end case.
     1955           end.
     1956           when 1 then do:
     1957               case rs-sort :
     1958                 when 1 then do:
     1959                   OPEN QUERY BROWSE-2 FOR EACH tt-alc-type where tt-alc-type.alc-type <> "Пивная продукция"
     1960                              by tt-alc-type.alc-type-name
     1961                              indexed-reposition .
     1962                 end.
     1963                 OTHERWISE do:
     1964                   OPEN QUERY BROWSE-2 FOR EACH tt-alc-type where tt-alc-type.alc-type <> "Пивная продукция"
     1965                              by tt-alc-type.alc-type-code
     1966                              indexed-reposition .
     1967                 end.
     1968               end case.
     1969           end.
     1970           when 2 then do:
     1971               case rs-sort :
     1972                 when 1 then do:
     1973                   OPEN QUERY BROWSE-2 FOR EACH tt-alc-type where tt-alc-type.alc-type = "Пивная продукция"
     1974                              by tt-alc-type.alc-type-name
     1975                              indexed-reposition .
     1976                 end.
     1977                 OTHERWISE do:
     1978                   OPEN QUERY BROWSE-2 FOR EACH tt-alc-type where tt-alc-type.alc-type = "Пивная продукция"
     1979                              by tt-alc-type.alc-type-code
     1980                              indexed-reposition .
     1981                 end.
     1982               end case.
     1983           end.
     1984         end case.
     1985   END PROCEDURE.
