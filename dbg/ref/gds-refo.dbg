     5104     (input filter-point
     5105     ,output flt-rec-48
     5106     ,output filter-name-48
     5107     ,output where-phrase-48
     5108     ,output sort-phrase-48
     5109     ,output where-phrase-rus-48
     5110     ,output sort-phrase-rus-48
     5111     ).
     5112   if p-open-query then do:
     5113       run set-filter-name in this-procedure
     5114         (INPUT filter-name-48
     5115         ) no-error .
     5116     assign
     5117       l-filter-open-48 = false
     5118     .
     5119     if flt-rec-48 <> ?
     5120     then do:
     5121       define variable  parameter-2-48 as character no-undo .
     5122       define variable  parameter-3-48 as character no-undo .
     5123       define variable  parameter-4-48 as character no-undo .
     5124       define variable  parameter-5-48 as character no-undo .
     5125       define variable  parameter-6-48 as character no-undo .
     5126       define variable  parameter-7-48 as character no-undo .
     5127         assign
     5128         parameter-3-48 =
     5129                                 "FOR EACH goo-doc no-lock"
     5130         parameter-4-48 =
     5131           (
     5132             if (" goo-doc.grp-name begins g-grp and goo-doc.stts <> 0 and goo-doc.gds-name contains NameContext " + " " + where-phrase-48) <> ""
     5133             then  substitute('goo-doc.grp-name begins &1&2&1  and goo-doc.stts <> 0 and goo-doc.gds-name contains &1&3&1 ', chr(34), g-grp, NameContext) + " " + where-phrase-48
     5134             else "true"
     5135           )
     5136         parameter-5-48 = (" " + "" + " " + "")
     5137         parameter-6-48 = if sort-phrase-48 = ''
     5138                              then
     5139           (
     5140           " " + " " +
     5141           " " + " by goo-doc.artic                           by goo-doc.prod-type                           by goo-doc.prod-code "
     5142           )
     5143                              else
     5144           (
     5145           " " + " " +
     5146           " " + sort-phrase-48
     5147           )
     5148         parameter-7-48 =
     5149           " indexed-reposition  "
     5150       .
     5151       do
     5152       on stop undo, leave
     5153       on error undo, leave
     5154       :
     5155         assign
     5156           l-disable-where-48 =
     5157             (" goo-doc.grp-name begins g-grp and goo-doc.stts <> 0 and goo-doc.gds-name contains NameContext " + " " + where-phrase-48 = "")
     5158         .
     5159         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     5160                             ,input query br-gds:handle
     5161                             ,input parameter-3-48
     5162                             ,input parameter-4-48
     5163                             ,input parameter-5-48
     5164                             ,input parameter-6-48
     5165                             ,input parameter-7-48
     5166                             )
     5167         .
     5168         assign
     5169           l-filter-open-48 = true
     5170         .
     5171       end.
     5172       if l-filter-open-48 = false then do:
     5173         message
     5174           "Ошибка при фильтрации / сортировке" skip
     5175           "Будут показаны записи без учета фильтра" skip
     5176           view-as alert-box .
     5177       end.
     5178       else do:
     5179           assign
     5180             l-query-was-opened = true
     5181           .
     5182       end.
     5183     end.
     5184     if l-filter-open-48 = false then do:
     5185       OPEN QUERY br-gds FOR EACH goo-doc no-lock
     5186         where  goo-doc.grp-name begins g-grp and goo-doc.stts <> 0 and goo-doc.gds-name contains NameContext
     5187          by goo-doc.artic                           by goo-doc.prod-type                           by goo-doc.prod-code
     5188         indexed-reposition
     5189     .
