     5073                             ,input parameter-6-46
     5074                             ,input parameter-7-46
     5075                             ,output v-fltopend-rowid
     5076                             ) no-error.
     5077         .
     5078         v-doc-rec = ?.
     5079       end.
     5080       assign
     5081         l-query-was-opened = true
     5082       .
     5083     end.
     5084   end.
     5085     run waitfram-hide in this-procedure .
     5086           end.
     5087           else do:
     5088             for-title = substitute("НЕАКТИВНЫЕ товары группы : &1, содержащие в названии &2"
     5089                         , g-grp
     5090                         , trim( NameContext, "*" )).
     5091   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5092   define variable  l-disable-where-48  as logical   no-undo .
