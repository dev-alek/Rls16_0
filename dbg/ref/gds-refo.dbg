     5201     on error undo, leave
     5202     :
     5203       if query br-gds:handle:get-buffer-handle(1) = (buffer goo-doc:handle) then do:
     5204         assign
     5205         parameter-2-48 = (if p-find-next then "true":u else "false":u )
     5206         parameter-4-48 =
     5207           "where ":u +  substitute('goo-doc.grp-name begins &1&2&1  and goo-doc.stts <> 0 and goo-doc.gds-name contains &1&3&1 ', chr(34), g-grp, NameContext) + " ":u + where-phrase-48 + " ":u + p-find-condition + " " + ""
     5208         parameter-5-48 = " "
     5209       .
     5210         run fltopend_fltfindd in this-procedure  (
     5211                             input this-procedure:handle
     5212                             ,input query br-gds:handle
     5213                             ,input rowid(goo-doc)
     5214                             ,input logical(parameter-2-48)
     5215                             ,input no-lock
     5216                             ,input (buffer goo-doc:handle)
     5217                             ,input parameter-4-48
     5218                             ,input parameter-5-48
     5219                             ) no-error.
     5220         .
     5221         assign
     5222           v-doc-rec = integer(return-value)
     5223           v-fltopend-rowid[1] = ?
     5224         .
     5225       end.
     5226       else do:
