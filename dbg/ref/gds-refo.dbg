     5095   define variable  filter-name-48      as character no-undo .
     5096   define variable  where-phrase-48     as character no-undo .
     5097   define variable  sort-phrase-48      as character no-undo .
     5098   define variable  where-phrase-rus-48 as character no-undo .
     5099   define variable  sort-phrase-rus-48  as character no-undo .
     5100     run waitfram-show in this-procedure
     5101       (input "ЖДИТЕ ..."
     5102       ).
