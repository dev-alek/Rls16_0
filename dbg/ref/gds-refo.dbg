     5064       .
     5065         run fltopend_fltfindq in this-procedure  (
     5066                             input this-procedure:handle
     5067                             ,input query br-gds:handle
     5068                             ,input logical(parameter-2-46)
     5069                             ,input no-lock
     5070                             ,input parameter-3-46
     5071                             ,input parameter-4-46
