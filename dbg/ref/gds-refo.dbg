     5233             then  substitute('goo-doc.grp-name begins &1&2&1  and goo-doc.stts <> 0 and goo-doc.gds-name contains &1&3&1 ', chr(34), g-grp, NameContext) + " " + where-phrase-48
     5234             else "true"
     5235           )
     5236         parameter-5-48 = (" " + "" + " " + "" + " " + p-find-condition)
     5237         parameter-6-48 = if sort-phrase-48 = ''
     5238                              then
     5239           (
     5240           " " + " " +
     5241           " " + " by goo-doc.artic                           by goo-doc.prod-type                           by goo-doc.prod-code "
     5242           )
     5243                              else
     5244           (
     5245           " " + " " +
     5246           " " + sort-phrase-48
     5247           )
     5248         parameter-7-48 =
     5249           " indexed-reposition  "
     5250       .
     5251         run fltopend_fltfindq in this-procedure  (
     5252                             input this-procedure:handle
     5253                             ,input query br-gds:handle
     5254                             ,input logical(parameter-2-48)
     5255                             ,input no-lock
     5256                             ,input parameter-3-48
     5257                             ,input parameter-4-48
     5258                             ,input parameter-5-48
     5259                             ,input parameter-6-48
     5260                             ,input parameter-7-48
     5261                             ,output v-fltopend-rowid
     5262                             ) no-error.
