     5054           " " + " " +
     5055           " " + " by goo-doc.artic                           by goo-doc.prod-type                           by goo-doc.prod-code "
     5056           )
     5057                              else
     5058           (
     5059           " " + " " +
     5060           " " + sort-phrase-46
     5061           )
     5062         parameter-7-46 =
