     4878                                input v-range
     4879                               ,input p-d-card
     4880                               ,input p-host-code
     4881                               ,input p-obj-type
     4882                               ,input p-obj-code
     4883                               ,input p-dtm-code
     4884                               ,input p-node-code
     4885                               ,input p-dt-code
     4886                             ) no-error .
     4887         if error-status:error then undo,  return error return-value .
     4888       end.
     4889       find first buf_tt0-dis-card-property exclusive-lock
     4890         where buf_tt0-dis-card-property.d-card    = p-d-card
     4891           and buf_tt0-dis-card-property.host-code = p-host-code
     4892           and buf_tt0-dis-card-property.obj-type  = p-obj-type
     4893           and buf_tt0-dis-card-property.obj-code  = p-obj-code
     4894           and buf_tt0-dis-card-property.dt-code = p-dt-code
     4895           and buf_tt0-dis-card-property.node-code = p-node-code
     4896         no-error .
     4897       if not available buf_tt0-dis-card-property then do:
     4898         create buf_tt0-dis-card-property .
     4899         assign
     4900           buf_tt0-dis-card-property.d-card    = p-d-card
     4901           buf_tt0-dis-card-property.host-code = p-host-code
     4902           buf_tt0-dis-card-property.obj-type  = p-obj-type
     4903           buf_tt0-dis-card-property.obj-code  = p-obj-code
     4904           buf_tt0-dis-card-property.dtm-code = p-dtm-code
     4905           buf_tt0-dis-card-property.node-code = p-node-code
     4906           buf_tt0-dis-card-property.dt-code = p-dt-code
     4907           buf_tt0-dis-card-property.sum-id = p-sum-id
     4908           buf_tt0-dis-card-property.card-num  = 0
     4909         .
     4910       end.
     4911       else do:
     4912         if (v-type = 'character':U
     4913         and buf_tt0-dis-card-property.property-value-character = p-value-character)
     4914         or  (v-type = 'date':U
     4915             and buf_tt0-dis-card-property.property-value-date = p-value-date)
     4916         or  (v-type = 'decimal':U
     4917             and buf_tt0-dis-card-property.property-value-decimal = p-value-decimal)
     4918         or  (v-type = 'integer':U
     4919             and buf_tt0-dis-card-property.property-value-integer = p-value-integer)
     4920         or  (v-type = 'logical':U
     4921             and buf_tt0-dis-card-property.property-value-logical = p-value-logical)
     4922         then return.
     4923       end.
     4924       assign
     4925       buf_tt0-dis-card-property.property-value-character = p-value-character
     4926       buf_tt0-dis-card-property.property-value-date = p-value-date
     4927       buf_tt0-dis-card-property.property-value-decimal = p-value-decimal
     4928       buf_tt0-dis-card-property.property-value-integer = p-value-integer
     4929       buf_tt0-dis-card-property.property-value-logical = p-value-logical
     4930       .
     4931       release buf_tt0-dis-card-property no-error .
     4932       if error-status:error then do:
     4933         return error return-value .
     4934       end.
     4935     end.
     4936   END PROCEDURE.
     4937   FUNCTION display-character RETURNS CHARACTER
     4938     ( INPUT p-character AS CHARACTER, INPUT p-format AS CHARACTER) :
     4939   DEFINE VARIABLE v-string AS CHARACTER NO-UNDO.
     4940   IF trim(p-format, "*") = "" THEN
     4941     v-string = string(p-character, p-format).
     4942   ELSE DO:
     4943     v-string = p-character.
     4944   END.
     4945   RETURN v-string.
     4946   END FUNCTION.
     4947   FUNCTION get-prop-value RETURNS CHARACTER
     4948        ( INPUT p-data-type AS CHARACTER
     4949      ,INPUT p-value-character AS CHARACTER
     4950      ,INPUT p-value-date AS DATE
     4951      ,INPUT p-value-decimal AS DECIMAL
     4952      ,INPUT p-value-integer AS INTEGER
     4953      ,INPUT p-value-logical AS LOGICAL
     4954    ) :
     4955   define buffer buf_cash-pay for ub.cash-pay.
     4956   case trim(p-data-type, chr(44)):
     4957     when 'character':U then do:
     4958       return p-value-character.
     4959     end.
     4960     when 'date':U then do:
     4961       return string(p-value-date, "99/99/9999").
     4962     end.
     4963     when 'decimal':U then do:
     4964       return string(p-value-decimal).
     4965     end.
     4966     when 'integer':U then do:
     4967       return string(p-value-integer).
     4968     end.
     4969     when 'logical':U then do:
     4970       return string(p-value-logical).
     4971     end.
     4972   end.
     4973   END FUNCTION.
