     4856       define input parameter p-value-logical   like ub.dis-card-property.property-value-logical no-undo .
     4857       define buffer buf_tt0-dis-card-property for tt0-dis-card-property .
     4858       define buffer buf_dis-card for ub.dis-card.
     4859       define variable v-type           as character no-undo .
     4860       define variable v-format         as character no-undo .
     4861       define variable v-label          as character no-undo .
     4862       define variable v-range          as integer no-undo .
     4863       define variable v-rw-option      as character  no-undo .
     4864       run discprop-node-code in this-procedure (
     4865                                            input  p-dtm-code
     4866                                           ,input  p-node-code
     4867                                           ,output v-type
     4868                                           ,output v-format
     4869                                           ,output v-label
     4870                                           ,output v-range
     4871                                           ,output v-rw-option
     4872                                           ) no-error .
     4873       if error-status :error then do:
     4874         undo, return error return-value .
     4875       end.
     4876       if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
