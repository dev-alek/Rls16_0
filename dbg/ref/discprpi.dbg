      543   index pi is unique primary
      544   d-card
      545   dc-petrol-code
      546   dc-sum-id
      547   caller_id
      548   .
      549   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      550   define variable v-disprop-menu-section-num as integer no-undo .
      551   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      552   def var vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      553   procedure gen-key-rec :
      554     define input  parameter p-tbl-name    as character no-undo.
      555     define input  parameter p-bh_tbl-name as handle    no-undo.
      556     define output parameter p-key-rec     as character no-undo.
      557     do
      558     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      559     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      560     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      561     :
      562       define variable fh               as handle    no-undo .
      563       define variable v-ok             as logical   no-undo .
      564       define variable v-inform         as character no-undo .
      565       define variable v-ind            as integer   no-undo .
      566       define variable v-idx-field-qnty as integer   no-undo .
      567       if p-tbl-name = ?
      568         or p-tbl-name = "":U
      569       then do:
      570         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info7 ).
      571       end.
      572       if not p-bh_tbl-name:available then do:
      573         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info7, p-tbl-name ).
      574       end.
      575       assign
      576         p-key-rec = p-tbl-name
      577         v-inform  = p-bh_tbl-name:index-information(1)
      578         v-ind     = 2
      579       .
      580       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      581       on error undo, return error
      582       :
      583         assign
      584           v-inform = p-bh_tbl-name:index-information( v-ind )
      585           v-ind    = v-ind + 1
      586         .
      587       end.
      588       if v-inform = ?
      589         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      590         or entry( 3, v-inform, ",":U ) <> "1":U
      591       then do:
      592         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, p-tbl-name ).
      593       end.
      594       else do:
      595         assign
      596           v-idx-field-qnty = num-entries( v-inform ) - 4
      597         .
      598         if v-idx-field-qnty < 2 then do:
      599           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, p-tbl-name ).
      600         end.
      601         do v-ind = 1 to v-idx-field-qnty by 2
      602         on error undo, return error
      603         :
      604           assign
      605             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      606             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      607           .
      608         end.
      609       end.
      610       if p-key-rec = ? then do:
      611         assign
      612           p-key-rec = "":U
      613         .
      614         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info7, p-tbl-name ).
      615       end.
      616     end.
      617     return.
      618   end procedure.
      619   procedure gen-where-keyr-tab :
      620     define input  parameter i-tableSerach as character no-undo.
      621     define input  parameter i-tablekey   as character  no-undo.
      622     define input  parameter p-key-rec    as character  no-undo.
      623     define input  parameter p-key-handle as handle     no-undo .
      624     define input  parameter p-db-name    as character  no-undo .
      625     define input  parameter p-tt-handle  as handle     no-undo .
      626     define output parameter o-Where      as character  no-undo.
      627     do
      628     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      629     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      630     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      631     :
      632       define variable v-full-tbl-name  as character no-undo .
      633       define variable bh_tbl-name      as handle    no-undo .
      634       define variable fh_key           as handle    no-undo .
      635       define variable fh_search        as handle    no-undo .
      636       define variable v-field-num      as integer   no-undo .
      637       define variable v-count-fld      as integer   no-undo .
      638       define variable v-inform         as character no-undo .
      639       define variable v-ind            as integer   no-undo .
      640       define variable v-idx-field-qnty as integer   no-undo .
      641       define variable v-field-name     as character no-undo .
      642       define variable v-field-val      as character no-undo .
      643       define variable v-word-link      as character no-undo .
      644       define variable vTable           as character no-undo.
      645       define variable bh_tbl-key       as handle    no-undo .
      646       assign
      647         p-key-rec = trim( p-key-rec )
      648       .
      649       if p-key-handle <> ? then do:
      650         if not valid-handle(p-key-handle)
      651            or p-key-handle:type <> "buffer"
      652         then do:
      653           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info7 ).
      654         end.
      655         if num-entries( p-key-rec, chr(3) ) > 1
      656           or p-key-rec = ?
      657           or p-key-rec = "":U
      658         then do:
      659           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info7, p-key-rec ).
      660         end.
      661       end.
      662       else do:
      663         if p-key-rec = ?
      664           or p-key-rec = "":U
      665         then do:
      666           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info7 ).
      667         end.
      668       end.
      669       assign
      670         vTable = entry( 1 , p-key-rec, chr(3) )
      671       .
      672       if p-tt-handle <> ?
      673         and ( not valid-handle(p-tt-handle)
      674               or p-tt-handle:type <> "buffer"
      675             )
      676       then do:
      677         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info7, vTable, chr(10) ).
      678       end.
      679       if p-tt-handle = ? then do:
      680         assign
      681           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      682         .
      683         create buffer bh_tbl-name for table v-full-tbl-name .
      684       end.
      685       else do:
      686         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      687       end.
      688       assign
      689         v-inform = bh_tbl-name:index-information(1)
      690         v-ind    = 2
      691       .
      692       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      693       on error undo, return error
      694       :
      695         assign
      696           v-inform = bh_tbl-name:index-information( v-ind )
      697           v-ind    = v-ind + 1
      698         .
      699       end.
      700       if v-inform = ?
      701         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      702         or entry( 3, v-inform, ",":U ) <> "1":U
      703       then do:
      704         delete object bh_tbl-name no-error.
      705         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info7, vTable ).
      706       end.
      707       assign
      708         v-idx-field-qnty = num-entries( v-inform ) - 4
      709       .
      710       if v-idx-field-qnty < 2 then do:
      711         delete object bh_tbl-name no-error.
      712         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, vTable ).
      713       end.
      714       assign
      715         o-where     = "where":U
      716         v-word-link = "":U
      717         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      718         v-count-fld = 0
      719       .
      720       if i-tablekey ne "" and i-tablekey ne ?
      721       then do:
      722         assign
      723           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      724         .
      725         create buffer bh_tbl-key for table v-full-tbl-name .
      726       end.
      727       if i-tableSerach ne "" and i-tableSerach ne ?
      728       then do:
      729         delete object bh_tbl-name no-error.
      730         assign
      731           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      732         .
      733         create buffer bh_tbl-name for table v-full-tbl-name .
      734       end.
      735       block_where:
      736       do v-ind = 1 to v-idx-field-qnty by 2
      737       on error undo, return error
      738       :
      739         assign
      740           v-count-fld = v-count-fld + 1
      741         .
      742         if p-key-handle = ?
      743           and v-count-fld > v-field-num
      744         then do:
      745           leave block_where.
      746         end.
      747         define variable VfieldKeyTable as handle no-undo.
      748         assign
      749           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      750           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      751         .
      752         if     bh_tbl-key ne ?
      753         then do:
      754            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      755            if VfieldKeyTable eq ?
      756            then next block_where.
      757         end.
      758         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      759         then
      760            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      761         else
      762            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      763         if p-key-handle = ? then do:
      764           assign
      765             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      766           .
      767         end.
      768         else do:
      769           assign
      770             fh_key = p-key-handle:buffer-field( v-field-name )
      771           .
      772           if fh_key = ?
      773             or not valid-handle( fh_key )
      774           then do:
      775             delete object bh_tbl-name.
      776             if     bh_tbl-key ne ?
      777             then
      778                delete object bh_tbl-key.
      779             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info7, p-key-handle:name, v-field-name ).
      780           end.
      781           assign
      782             v-field-val = fh_key:buffer-value
      783           .
      784         end.
      785         if fh_search:data-type ="character":U then do:
      786           assign
      787             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      788             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      789             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      790             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      791             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      792             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      793             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      794             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      795             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      796             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      797             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      798             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      799             v-field-val = substitute( '"&1"', v-field-val )
      800           .
      801         end.
      802         assign
      803           o-where = substitute( "&1 &2", o-where, v-field-val )
      804         .
      805         if v-word-link = "":U then do:
      806           assign
      807             v-word-link = "and":U
      808           .
      809         end.
      810       end.
      811       delete object bh_tbl-name.
      812       if     bh_tbl-key ne ?
      813       then
      814          delete object bh_tbl-key.
      815       if p-key-handle = ?
      816         and v-count-fld <> v-field-num
      817       then do:
      818         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info7, vTable ).
      819       end.
      820     end.
      821   end procedure.
      822   procedure gen-hn-keyr-tab :
      823     define input  parameter i-tableSerach as character no-undo.
      824     define input  parameter i-tablekey   as character no-undo.
      825     define input  parameter p-key-rec    as character no-undo.
      826     define input  parameter p-key-handle as handle    no-undo .
      827     define input  parameter p-db-name    as character no-undo .
      828     define input  parameter p-tt-handle  as handle    no-undo .
      829     define input  parameter p-stts-lock  as integer   no-undo .
      830     define output parameter o-hn         as handle    no-undo.
      831     define variable v-full-tbl-name as character no-undo.
      832     define variable v-where         as character no-undo.
      833     define variable bh_tbl-name     as handle    no-undo.
      834     define variable vTable          as character no-undo.
      835     do
      836     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      837     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      838     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      839         run gen-where-keyr-tab(i-tableSerach,
      840                                i-tablekey,
      841                                p-key-rec,
      842                                p-key-handle,
      843                                p-db-name,
      844                                p-tt-handle,
      845                                output v-where).
      846         if i-tableSerach ne "" and i-tableSerach ne ?
      847         then do:
      848            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      849            create buffer bh_tbl-name for table v-full-tbl-name .
      850         end.
      851         else do:
      852            if p-tt-handle = ? then do:
      853               assign
      854                  vTable = entry( 1 , p-key-rec, chr(3) )
      855               .
      856               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      857               create buffer bh_tbl-name for table v-full-tbl-name .
      858            end.
      859            else do:
      860               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      861            end.
      862         end.
      863         if p-tt-handle = ? then do:
      864            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      865         end.
      866         else do:
      867            bh_tbl-name:find-first( v-where ) no-error .
      868         end.
      869         o-hn = bh_tbl-name.
      870      end.
      871   end procedure.
      872   procedure gen-hn-keyr :
      873     define input  parameter p-key-rec    as character no-undo.
      874     define input  parameter p-key-handle as handle    no-undo .
      875     define input  parameter p-db-name    as character no-undo .
      876     define input  parameter p-tt-handle  as handle    no-undo .
      877     define input  parameter p-stts-lock  as integer   no-undo .
      878     define output parameter o-hn         as handle    no-undo.
      879     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
      880   end.
      881   procedure gen-row-keyr :
      882     define input  parameter p-key-rec    as character no-undo.
      883     define input  parameter p-key-handle as handle    no-undo .
      884     define input  parameter p-db-name    as character no-undo .
      885     define input  parameter p-tt-handle  as handle    no-undo .
      886     define input  parameter p-stts-lock  as integer   no-undo .
      887     define output parameter p-tbl-row    as rowid     no-undo.
      888     define output parameter p-tbl-name   as character no-undo.
      889     define variable vHn as handle no-undo.
      890       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
      891       p-tbl-row = if vHn:available then vHn:rowid else ?.
      892       p-tbl-name =  vHn:table.
      893       delete object vHn no-error.
      894     if p-tbl-row = ? then do:
      895       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info7, p-tbl-name, p-key-rec ).
      896     end.
      897     else do:
      898       return.
      899     end.
      900   end procedure.
      901   procedure gen-key-fv :
      902     define input  parameter p-key-rec    as character no-undo .
      903     define output parameter p-field-list as character no-undo .
      904     define output parameter p-value-list as character no-undo.
      905     do
      906     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      907     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      908     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      909     :
      910       define variable v-full-tbl-name  as character no-undo .
      911       define variable bh_tbl-name      as handle    no-undo .
      912       define variable v-tbl-name       as character no-undo .
      913       define variable v-field-num      as integer   no-undo .
      914       define variable v-count-fld      as integer   no-undo .
      915       define variable v-inform         as character no-undo .
      916       define variable v-ind            as integer   no-undo .
      917       define variable v-idx-field-qnty as integer   no-undo .
      918       define variable v-delim-key      as character no-undo .
      919       if p-key-rec = ?
      920         or p-key-rec = "":U
      921       then do:
      922         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info7 ).
      923       end.
      924       assign
      925         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
      926         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
      927       .
      928       create buffer bh_tbl-name for table v-full-tbl-name no-error .
      929       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info7 ).
      930       assign
      931         v-inform = bh_tbl-name:index-information(1)
      932         v-ind    = 2
      933       .
      934       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      935       on error undo, return error
      936       :
      937         assign
      938           v-inform = bh_tbl-name:index-information( v-ind )
      939           v-ind    = v-ind + 1
      940         .
      941       end.
      942       if v-inform = ?
      943         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      944         or entry( 3, v-inform, ",":U ) <> "1":U
      945       then do:
      946         delete object bh_tbl-name no-error.
      947         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, v-tbl-name ).
      948       end.
      949       assign
      950         v-idx-field-qnty = num-entries( v-inform ) - 4
      951       .
      952       if v-idx-field-qnty < 2 then do:
      953         delete object bh_tbl-name no-error.
      954         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, v-tbl-name ).
      955       end.
      956       assign
      957         p-field-list = "":U
      958         p-value-list = "":U
      959         v-delim-key  = "":U
      960         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
      961         v-count-fld  = 0
      962       .
      963       block_where:
      964       do v-ind = 1 to v-idx-field-qnty by 2
      965       on error undo, return error
      966       :
      967         assign
      968           v-count-fld = v-count-fld + 1
      969         .
      970         if v-count-fld > v-field-num then do:
      971           leave block_where.
      972         end.
      973         assign
      974           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
      975           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
      976         .
      977         if v-ind = 1 then do:
      978           assign
      979             v-delim-key = chr(3)
      980           .
      981         end.
      982       end.
      983       delete object bh_tbl-name.
      984       if v-count-fld <> v-field-num then do:
      985         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info7, v-tbl-name ).
      986       end.
      987     end.
      988   end procedure.
      989   procedure gen-key-field :
      990     define input  parameter p-table      as character no-undo .
      991     define output parameter p-field-list as character no-undo .
      992     do
      993     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      994     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
      995     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
      996     :
      997       define variable v-full-tbl-name  as character no-undo .
      998       define variable bh_tbl-name      as handle    no-undo .
      999       define variable v-tbl-name       as character no-undo .
     1000       define variable v-field-num      as integer   no-undo .
     1001       define variable v-count-fld      as integer   no-undo .
     1002       define variable v-inform         as character no-undo .
     1003       define variable v-ind            as integer   no-undo .
     1004       define variable v-idx-field-qnty as integer   no-undo .
     1005       define variable v-delim-key      as character no-undo .
     1006       if p-table = ?
     1007         or p-table = "":U
     1008       then do:
     1009         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info7 ).
     1010       end.
     1011       assign
     1012         v-tbl-name      = p-table
     1013         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1014       .
     1015       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1016       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info7 ).
     1017       assign
     1018         v-inform = bh_tbl-name:index-information(1)
     1019         v-ind    = 2
     1020       .
     1021       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1022       on error undo, return error
     1023       :
     1024         assign
     1025           v-inform = bh_tbl-name:index-information( v-ind )
     1026           v-ind    = v-ind + 1
     1027         .
     1028       end.
     1029       if v-inform = ?
     1030         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1031         or entry( 3, v-inform, ",":U ) <> "1":U
     1032       then do:
     1033         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info7, v-tbl-name ).
     1034       end.
     1035       assign
     1036         v-idx-field-qnty = num-entries( v-inform ) - 4
     1037       .
     1038       if v-idx-field-qnty < 2 then do:
     1039         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info7, v-inform, v-tbl-name ).
     1040       end.
     1041       assign
     1042         p-field-list = "":U
     1043         v-delim-key  = "":U
     1044         v-count-fld  = 0
     1045       .
     1046       block_where:
     1047       do v-ind = 1 to v-idx-field-qnty by 2
     1048       on error undo, return error
     1049       :
     1050         assign
     1051           v-count-fld = v-count-fld + 1
     1052         .
     1053         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1054         if v-ind = 1 then do:
     1055           assign
     1056             v-delim-key = chr(3)
     1057           .
     1058         end.
     1059       end.
     1060       delete object bh_tbl-name.
     1061     end.
     1062   end procedure.
