     2014   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2015   FUNCTION proprefd_sum-id-des RETURNS CHARACTER
     2016     ( INPUT p-sum-id AS CHARACTER, INPUT p-ref-type AS CHARACTER ) :
     2017   CASE p-ref-type:
     2018       WHEN 'one-ptrl':U THEN DO:
     2019          DEFINE BUFFER buf_goods FOR ub.goods.
     2020          FIND FIRST buf_goods NO-LOCK WHERE
     2021                    buf_goods.gds-code = integer(ENTRY(2, p-sum-id, "-")) NO-ERROR.
     2022          IF NOT AVAILABLE buf_goods  THEN DO:
     2023              RETURN "Неизвестное топливо".
     2024          END.
     2025          RETURN buf_goods.gds-name.
     2026       END.
     2027       OTHERWISE DO:
     2028          RETURN "".
     2029       END.
     2030   END CASE.
     2031   END FUNCTION.
     2032   FUNCTION proprefd_sum-id-des2 RETURNS CHARACTER
     2033     ( INPUT p-sum-id AS CHARACTER, INPUT p-ref-type AS CHARACTER ) :
     2034   CASE p-ref-type:
     2035       WHEN 'one-ptrl':U THEN DO:
     2036          DEFINE BUFFER buf_goods FOR ub.goods.
     2037          FIND FIRST buf_goods NO-LOCK WHERE
     2038                    buf_goods.gds-code = integer(ENTRY(2, p-sum-id, "-")) NO-ERROR.
     2039          IF NOT AVAILABLE buf_goods  THEN DO:
     2040              RETURN "Неизвестное топливо".
     2041          END.
     2042          RETURN buf_goods.gds-name.
     2043       END.
     2044       OTHERWISE DO:
     2045          RETURN p-sum-id.
     2046       END.
     2047   END CASE.
     2048   END FUNCTION.
