     2126        SIZE 49 BY 1 NO-UNDO.
     2127   DEFINE QUERY br-prop FOR
     2128         temp-dis-card-property,
     2129         X_prop-map,
     2130         X_prop-ref SCROLLING.
     2131   DEFINE BROWSE br-prop
