     2133         substitute("&1:&2", temp-dis-card-property.prop-label, temp-dis-card-property.node-label) COLUMN-LABEL "Свойство" FORMAT "X(60)" WIDTH 25
     2134   proprefd_sum-id-des2(temp-dis-card-property.sum-id, X_prop-ref.ref-type) COLUMN-LABEL "Идентификатор/!Описание" FORMAT "X(255)" WIDTH 15
     2135   get-region( temp-dis-card-property.host-code, temp-dis-card-property.obj-type, temp-dis-card-property.obj-code) COLUMN-LABEL "Область!действия" FORMAT "X(14)":U
     2136   get-prop-value( X_prop-map.node-value-type
     2137                  ,temp-dis-card-property.property-value-character
     2138                   ,temp-dis-card-property.property-value-date
     2139                   ,temp-dis-card-property.property-value-decimal
     2140                   ,temp-dis-card-property.property-value-integer
     2141                   ,temp-dis-card-property.property-value-logical) COLUMN-LABEL "Значение" FORMAT "X(255)"
     2142             WIDTH 45
     2143   substitute("&1:&2", temp-dis-card-property.dtm-code, temp-dis-card-property.node-code) COLUMN-LABEL "Объект!-операнд:!свойство"
     2144   temp-dis-card-property.dt-code COLUMN-LABEL "Код среза"
     2145       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 15
     2146            FONT 4.
     2147   DEFINE FRAME Dialog-Frame
     2148        b-exit AT ROW 1 COL 1
     2149        B-quit AT ROW 1 COL 11
     2150        b-ins AT ROW 1 COL 31
     2151        b-lkp AT ROW 1 COL 41
     2152        b-chg AT ROW 1 COL 51
     2153        b-del AT ROW 1 COL 61
     2154        b-hist AT ROW 1 COL 92 WIDGET-ID 10
     2155        b-help AT ROW 1 COL 95
     2156        rs-view AT ROW 4 COL 12 NO-LABEL WIDGET-ID 12
     2157        br-prop AT ROW 5 COL 1
     2158        vard-card AT ROW 2 COL 18.5 COLON-ALIGNED
     2159        v-first-main-card AT ROW 2 COL 75.5 COLON-ALIGNED WIDGET-ID 4
     2160        v-cli-name AT ROW 3 COL 18.5 COLON-ALIGNED WIDGET-ID 2
     2161        v-first-card AT ROW 3 COL 75.5 COLON-ALIGNED WIDGET-ID 6
     2162        v-main-card AT ROW 4 COL 75.5 COLON-ALIGNED WIDGET-ID 8
     2163        "Показывать:" VIEW-AS TEXT
     2164             SIZE 10.5 BY 1 AT ROW 4 COL 1 WIDGET-ID 16
     2165        SPACE(87.50) SKIP(15.22)
     2166       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2167            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2168            TITLE "Свойства дисконтной карты"
     2169            CANCEL-BUTTON B-quit.
     2170   ASSIGN
     2171          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2172          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2173   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2174   DO:
     2175     APPLY "END-ERROR":U TO SELF.
     2176   END.
     2177   ON CHOOSE OF b-chg IN FRAME Dialog-Frame
     2178   DO:
     2179     if not avail temp-dis-card-property then return no-apply.
     2180     run proc-add-chg in this-procedure ( input no ) no-error .
     2181     if error-status:error then return no-apply.
     2182     run Openbr in this-procedure .
     2183   END.
     2184   ON CHOOSE OF b-del IN FRAME Dialog-Frame
     2185   DO:
     2186   define variable loc#log as logical no-undo.
     2187   define variable v-data-type as character no-undo .
     2188   define variable v-format as character no-undo .
     2189   define variable v-label as character no-undo .
     2190   define variable v-range as integer no-undo .
     2191   define variable v-rw-option as character no-undo .
     2192   define variable glog as logical no-undo .
     2193   define variable v-dtm-code as integer no-undo .
     2194   define variable v-host-code as integer no-undo .
     2195   define variable v-obj-type as character no-undo .
     2196   define variable v-obj-code as integer no-undo .
     2197   define variable v-dt-code as integer no-undo .
     2198   define variable v-node-code as integer   no-undo .
     2199   define variable v-num as integer   no-undo .
     2200   define buffer buf_attr-prop for ub.attr-prop.
     2201   define buffer buf_temp-dis-card-property for temp-dis-card-property.
     2202   if not avail temp-dis-card-property then return no-apply.
     2203   run discprop-node-code in this-procedure (
     2204                                        input  temp-dis-card-property.dtm-code
     2205                                       ,input  temp-dis-card-property.node-code
     2206                                       ,output v-data-type
     2207                                       ,output v-format
     2208                                       ,output v-label
     2209                                       ,output v-range
     2210                                       ,output v-rw-option
     2211                                       ).
     2212   if index(v-rw-option, "W") = 0
     2213   then do:
     2214       message
     2215       "Свойство нельзя удалить вручную"
     2216       view-as alert-box error .
     2217       return no-apply.
     2218   end.
     2219     if discprop-usercanedit( input temp-dis-card-property.dtm-code, input v-cntxt-db-num) = no then do:
     2220       message
     2221       "Свойство нельзя удалить в данной БД"
     2222       view-as alert-box error .
     2223       return no-apply.
     2224     end.
     2225     glog = no.
     2226   run gbl/d-askw.w (
     2227     input "Удаление свойства ДК"
     2228   ,input substitute("Вы уверены, что хотите удалить свойство &1 (срез &2) для дисконтной карты &3"
     2229                 ,temp-dis-card-property.prop-label
     2230                 ,temp-dis-card-property.sum-id
     2231                 ,vard-card
     2232              )
     2233   ,input "|^"
     2234   ,input substitute("Полностью^confirm|Элемент&1|Отказ"
     2235                     ,(if index(v-rw-option, "O") > 0
     2236                       then ""
     2237                       else "^disable"))
     2238   ,input "Все элементы свойства|"
     2239         + v-label + "|"
     2240         + "Отказ "
     2241   ,input 2
     2242   ,input 3
     2243   ,output v-num
     2244   ).
     2245   if v-num = 3 then do:
     2246     return no-apply.
     2247   end.
     2248     assign
     2249     v-dtm-code =  temp-dis-card-property.dtm-code
     2250     v-host-code = temp-dis-card-property.host-code
     2251     v-obj-type = temp-dis-card-property.obj-type
     2252     v-obj-code = temp-dis-card-property.obj-code
     2253     v-dt-code = temp-dis-card-property.dt-code
     2254   v-node-code = temp-dis-card-property.node-code
     2255     .
     2256     for each buf_temp-dis-card-property where
     2257             buf_temp-dis-card-property.dtm-code = v-dtm-code
     2258         and buf_temp-dis-card-property.host-code = v-host-code
     2259         and buf_temp-dis-card-property.obj-type = v-obj-type
     2260         and buf_temp-dis-card-property.obj-code = v-obj-code
     2261         and buf_temp-dis-card-property.dt-code = v-dt-code
     2262     :
     2263     if v-num = 2 and buf_temp-dis-card-property.node-code <> v-node-code then next.
     2264      delete buf_temp-dis-card-property.
     2265     end.
     2266     updated = yes.
     2267   run Openbr in this-procedure .
     2268   END.
     2269   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
     2270   DO:
     2271     RUN proc-save IN THIS-PROCEDURE NO-ERROR.
     2272     IF ERROR-STATUS:ERROR THEN DO:
     2273        RETURN NO-APPLY.
     2274     END.
     2275   END.
     2276   ON CHOOSE OF b-hist IN FRAME Dialog-Frame
     2277   DO:
     2278    DEFINE VARIABLE v-ref-list AS CHARACTER NO-UNDO.
     2279    IF NOT AVAILABLE temp-dis-card-property THEN RETURN NO-APPLY.
     2280   run ref/cdchist.w (
     2281                   INPUT parparentproc
     2282                   ,input p-host-code
     2283                   ,input p-obj-type
     2284                   ,input p-obj-code
     2285                   ,input "":U
     2286                   ,input "subject":U
     2287                   ,input temp-dis-card-property.d-card
     2288                   ,input ?
     2289                   ,input temp-dis-card-property.obj-type
     2290                   ,input temp-dis-card-property.obj-code
     2291                   ,input temp-dis-card-property.host-code
     2292                   ,input ?
     2293                   ,input "":U
     2294                   ,input 'dis-card-property':U
     2295                   ,input ?
     2296                   ,input-output v-ref-list
     2297               ) no-error .
     2298     APPLY "entry" TO br-prop.
     2299   END.
     2300   ON CHOOSE OF b-ins IN FRAME Dialog-Frame
     2301   DO:
     2302   define buffer buf_temp-dis-card-property for temp-dis-card-property.
     2303   if dtm-node-option = '':U then do:
     2304     run gbl/pop-up.p ( input self:handle, input no) no-error.
     2305   end.
     2306   if dtm-node-option = '':U then return no-apply.
     2307   run proc-add-chg in this-procedure ( input yes) no-error .
     2308   if error-status:error then do:
     2309     assign
     2310     dtm-node-option = ''
     2311     dtm-option = 0
     2312     node-code-option = 0
     2313     .
     2314     return no-apply.
     2315   end.
     2316   Run Openbr in this-procedure .
     2317   find first buf_temp-dis-card-property no-lock where
     2318              buf_temp-dis-card-property.dtm-code = dtm-option
     2319          and buf_temp-dis-card-property.node-code = node-code-option
     2320          and buf_temp-dis-card-property.host-code = v-host-code
     2321         and buf_temp-dis-card-property.obj-type = v-obj-type
     2322         and buf_temp-dis-card-property.obj-code = v-obj-code
     2323                     no-error.
     2324   assign
     2325   dtm-node-option = '':U
     2326   dtm-option = 0
     2327   node-code-option = 0
     2328   .
     2329   if avail buf_temp-dis-card-property then
     2330       temp-doc-rec = recid(buf_temp-dis-card-property).
     2331       else temp-doc-rec = ?.
     2332   reposition br-prop to recid temp-doc-rec no-error.
     2333   if error-status:error then return no-apply.
     2334   END.
     2335   ON CHOOSE OF b-lkp IN FRAME Dialog-Frame
     2336   DO:
     2337     if not avail temp-dis-card-property then return no-apply.
     2338     RUN proc-b-lkp IN THIS-PROCEDURE NO-ERROR.
     2339     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     2340   END.
     2341   ON MOUSE-SELECT-DBLCLICK OF br-prop IN FRAME Dialog-Frame
     2342   DO:
     2343     if not avail temp-dis-card-property then return no-apply.
     2344     RUN proc-b-lkp IN THIS-PROCEDURE NO-ERROR.
     2345     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     2346   END.
     2347   ON RETURN OF br-prop IN FRAME Dialog-Frame
     2348   DO:
     2349     if not avail temp-dis-card-property then return no-apply.
     2350     RUN proc-b-lkp IN THIS-PROCEDURE NO-ERROR.
     2351     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     2352   END.
     2353   ON VALUE-CHANGED OF br-prop IN FRAME Dialog-Frame
     2354   DO:
     2355     DEFINE BUFFER buf_attr-prop FOR ub.attr-prop.
     2356     IF NOT AVAILABLE temp-dis-card-property THEN do:
     2357        DISABLE
     2358        b-lkp
     2359        WITH frame Dialog-Frame.
     2360        RETURN NO-APPLY.
     2361     END.
     2362     FIND FIRST buf_attr-prop NO-LOCK WHERE
     2363               buf_attr-prop.TABLE-name = 'dis-card-property':U
     2364          AND buf_attr-prop.templ-rl-root  = temp-dis-card-property.dtm-code
     2365         AND buf_attr-prop.upper-prop-code = "InputForm":U
     2366         AND buf_attr-prop.prop-code = "FormName" no-error.
     2367     IF AVAILABLE buf_attr-prop THEN DO:
     2368        ENABLE
     2369        b-lkp
     2370        WITH FRAME Dialog-Frame.
     2371     END.
     2372     ELSE DO:
     2373       DISABLE
     2374       b-lkp
     2375       WITH frame Dialog-Frame.
     2376     END.
     2377     if p-mode <> 'ПРОСМОТР':U then do:
     2378       enable
     2379       b-del
     2380       with frame Dialog-Frame .
     2381       if g#db-num  > 0
     2382       and (temp-dis-card-property.obj-type = ''
     2383       or temp-dis-card-property.obj-code =0
     2384       or temp-dis-card-property.host-code = 0) then do:
     2385         disable
     2386         b-del
     2387         with frame Dialog-Frame .
     2388       end.
     2389     end.
     2390   END.
     2391   ON VALUE-CHANGED OF rs-view IN FRAME Dialog-Frame
     2392   DO:
     2393     ASSIGN
     2394     rs-view.
     2395     RUN Openbr IN THIS-PROCEDURE.
     2396   END.
     2397   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2398   on help of frame Dialog-Frame
     2399   do:
     2400     run gbl/app_help.p
     2401       (input this-procedure :file-name
     2402       ,input ''
     2403       ,input ?
     2404       ) no-error.
     2405     if error-status :error then do:
     2406       message
     2407         "Ошибка при вызове помощи"
     2408         error-status :get-message(1)
     2409         view-as alert-box .
     2410     end.
     2411   end.
     2412   run minbtn-set in this-procedure .
     2413   on choose of b-help in frame Dialog-Frame
     2414   do:
     2415     apply "help":u to frame Dialog-Frame .
     2416   end.
     2417   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2418   procedure minbtn-set :
     2419       do
     2420           on error undo, return error return-value
     2421           :
     2422           define variable ii              as integer       no-undo .
     2423           define variable fh              as widget-handle no-undo .
     2424           define variable hh              as widget-handle no-undo .
     2425           define variable v-h             as handle        extent 4 no-undo .
     2426           define variable v-name-button   as character     no-undo .
     2427           define variable v-help-old-x    as decimal       no-undo .
     2428           define variable v-help-old-y    as decimal       no-undo .
     2429           define variable v-help-old-size as decimal       no-undo .
     2430           define variable v-frame-width   as decimal       no-undo .
     2431           define variable jj              as integer       no-undo .
     2432           do
     2433               on error undo, return error
     2434               :
     2435               assign
     2436                   v-frame-width = frame Dialog-Frame:width - 0.3
     2437                   fh            = frame Dialog-Frame:first-child
     2438                   hh            = fh:first-child
     2439                   ii            = 1
     2440                   .
     2441               do while valid-handle(hh):
     2442                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2443                   do:
     2444                       case lc(hh:name) :
     2445                           when "b-help" then
     2446                               do:
     2447                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2448                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2449                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2450                                   hh:TOOLTIP = "Помощь" .
     2451                                   v-help-old-x = hh:column .
     2452                                   v-help-old-y = hh:row    .
     2453                                   v-help-old-size = hh:width .
     2454                                   hh:width-chars = 2.5 .
     2455                               end.
     2456                           when "b-print" then
     2457                               do:
     2458                                   hh:load-image("cmp/b-print.bmp":u) .
     2459                                   hh:TOOLTIP = "Печать" .
     2460                                   v-h[ii] = hh:handle .
     2461                                   ii = ii + 1 .
     2462                                   hh:width-chars = 3 .
     2463                               end.
     2464                           when "b-history" or
     2465                           when "b-hist" then
     2466                               do:
     2467                                   hh:load-image("cmp/b-hist.bmp":u) .
     2468                                   hh:TOOLTIP = "История" .
     2469                                   v-h[ii] = hh:handle .
     2470                                   ii = ii + 1 .
     2471                                   hh:width-chars = 3 .
     2472                               end.
     2473                           when "b-sch" then
     2474                               do:
     2475                                   hh:load-image("cmp/b-sch.bmp":u) .
     2476                                   hh:TOOLTIP = "Установка Фильтра" .
     2477                                   v-h[ii] = hh:handle .
     2478                                   ii = ii + 1 .
     2479                                   hh:width-chars = 3 .
     2480                               end.
     2481                           when "b-hist-user" then
     2482                               do:
     2483                                   hh:load-image("cmp/b-hist.bmp":u) .
     2484                                   hh:TOOLTIP = "История пользователя" .
     2485                                   ii = ii + 1 .
     2486                               end.
     2487                       end case.
     2488                   end.
     2489                   hh = hh:next-sibling.
     2490               end.
     2491               b-help:column = v-frame-width - b-help:width-chars.
     2492               jj = 0.
     2493               repeat ii = 4 to 1 by -1 :
     2494                   if valid-handle (v-h[ii] ) then
     2495                   do:
     2496                       jj  = jj + 1 .
     2497                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2498                       v-h[ii]:row    = v-help-old-y .
     2499                   end.
     2500               end.
     2501           end.
     2502       end.
     2503   end procedure.
     2504   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2505   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2506   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2507   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2508   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2509   define variable v-diasize-current-frame-height as decimal   no-undo .
     2510   define variable v-diasize-change-size          as logical   no-undo .
     2511   define variable v-diasize-resize-button        as handle    no-undo .
     2512   define variable v-diasize-wndmax               as logical   no-undo .
     2513   define variable v-diasize-wndstore             as logical   no-undo .
     2514   define variable v-diasize-proc-name            as character no-undo .
     2515   define variable v-diasize-browse-handle        as handle    no-undo .
     2516   define variable v-diasize-browse-number        as integer   no-undo .
     2517   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2518   define temp-table temp-diasize-handle no-undo
     2519     field handle-value  as handle
     2520     field save-position as decimal
     2521     index xpk is primary unique handle-value
     2522     .
     2523   define temp-table temp-browse-handle no-undo
     2524     field browse-type   as character
     2525     field browse-number as integer
     2526     field browse-handle as handle
     2527     field original-size as decimal
     2528     index xpk is primary unique browse-type browse-number
     2529     index xie browse-type browse-handle
     2530   .
     2531   procedure diasize_change-height :
     2532     define input  parameter p-change-value  as decimal   no-undo .
     2533     define input  parameter p-move-resize   as logical   no-undo .
     2534     define variable v-field-group-handle    as handle    no-undo .
     2535     define variable v-object-handle         as handle    no-undo .
     2536     define variable v-frame-height          as decimal   no-undo .
     2537     define variable v-frame-virtual-height  as decimal   no-undo .
     2538     define variable v-browse-height         as decimal   no-undo .
     2539     define variable v-window-height         as decimal   no-undo .
     2540     define variable v-window-virtual-height as decimal   no-undo .
     2541     define variable v-change-sign           as integer   no-undo .
     2542     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2543     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2544     if p-change-value > 0
     2545     then do:
     2546       if frame Dialog-Frame :height + p-change-value
     2547           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2548       then do:
     2549         assign
     2550           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2551                           - (frame Dialog-Frame :height-chars)
     2552         .
     2553         if p-change-value <= 0
     2554         then do:
     2555           run diasize_position-resize-button in this-procedure .
     2556           return .
     2557         end.
     2558       end.
     2559     end.
     2560     if p-change-value < 0
     2561     then do:
     2562       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2563       then do:
     2564         assign
     2565           p-change-value = v-diasize-orig-frame-height
     2566                          - (frame Dialog-Frame :height-chars)
     2567         .
     2568         if p-change-value >= 0
     2569         then do:
     2570           run diasize_position-resize-button in this-procedure .
     2571           return .
     2572         end.
     2573       end.
     2574     end.
     2575     if p-change-value >= 0
     2576     then do:
     2577       assign
     2578         v-change-sign = 1
     2579       .
     2580     end.
     2581     else do:
     2582       assign
     2583         v-change-sign = -1
     2584       .
     2585     end.
     2586     assign
     2587       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2588     .
     2589     if p-change-value = 0
     2590     then do:
     2591       run diasize_position-resize-button in this-procedure .
     2592       return .
     2593     end.
     2594     move_block:
     2595     do
     2596     on error undo move_block, retry move_block
     2597     :
     2598       if retry
     2599       then do:
     2600         do
     2601         on error undo move_block, leave move_block
     2602         :
     2603           if p-change-value > 0
     2604           then do:
     2605             for each buf_temp-diasize-handle
     2606             on error undo, next
     2607             :
     2608               assign
     2609                 v-object-handle = buf_temp-diasize-handle.handle-value
     2610               .
     2611               if v-object-handle <> v-diasize-resize-button
     2612               then do:
     2613                 assign
     2614                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2615                 .
     2616               end.
     2617             end.
     2618             assign
     2619               v-diasize-browse-handle :height = v-browse-height
     2620             .
     2621             for each buf_temp-browse-handle
     2622               where buf_temp-browse-handle.browse-type = 'height':u
     2623             on error undo, next
     2624             :
     2625               assign
     2626                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2627               .
     2628             end.
     2629             assign
     2630               frame Dialog-Frame :height = v-frame-height
     2631             .
     2632             if frame Dialog-Frame :scrollable = true
     2633             then do:
     2634               assign
     2635                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2636               .
     2637             end.
     2638             run diasize_position-resize-button in this-procedure .
     2639           end.
     2640           else do:
     2641             if frame Dialog-Frame :scrollable = true
     2642             then do:
     2643               assign
     2644                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2645               .
     2646             end.
     2647             assign
     2648               frame Dialog-Frame :height = v-frame-height
     2649             .
     2650             assign
     2651               v-diasize-browse-handle :height = v-browse-height
     2652             .
     2653             for each buf_temp-browse-handle
     2654               where buf_temp-browse-handle.browse-type = 'height':u
     2655             on error undo, next
     2656             :
     2657               assign
     2658                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2659               .
     2660             end.
     2661             for each buf_temp-diasize-handle
     2662             on error undo, next
     2663             :
     2664               assign
     2665                 v-object-handle = buf_temp-diasize-handle.handle-value
     2666               .
     2667               if v-object-handle <> v-diasize-resize-button
     2668               then do:
     2669                 assign
     2670                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2671                 .
     2672               end.
     2673             end.
     2674             run diasize_position-resize-button in this-procedure .
     2675           end.
     2676           assign
     2677             v-diasize-change-size = false
     2678           .
     2679           leave move_block .
     2680         end.
     2681       end.
     2682       assign
     2683         v-diasize-need-full-display = true
     2684       .
     2685       if v-diasize-change-size = false
     2686       then do:
     2687         assign
     2688           v-diasize-change-size = true
     2689         .
     2690       end.
     2691       else do:
     2692         return .
     2693       end.
     2694       assign
     2695         v-frame-height = frame Dialog-Frame :height
     2696         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2697         v-browse-height = v-diasize-browse-handle :height
     2698       .
     2699       for each buf_temp-browse-handle
     2700         where buf_temp-browse-handle.browse-type = 'height':u
     2701       :
     2702         assign
     2703           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2704         .
     2705       end.
     2706       for each buf_temp-diasize-handle
     2707       :
     2708         delete buf_temp-diasize-handle .
     2709       end.
     2710       assign
     2711         v-field-group-handle = frame Dialog-Frame :first-child
     2712       .
     2713       do while valid-handle(v-field-group-handle)
     2714       :
     2715         assign
     2716           v-object-handle = v-field-group-handle :first-child
     2717         .
     2718         do while valid-handle(v-object-handle)
     2719         :
     2720           if  v-object-handle <> v-diasize-browse-handle :handle
     2721           and can-query(v-object-handle, "row")
     2722           and can-query(v-object-handle, "height")
     2723           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2724           then do:
     2725             find first buf_temp-browse-handle
     2726               where buf_temp-browse-handle.browse-type   = 'height':u
     2727                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2728               no-error .
     2729             if available buf_temp-browse-handle
     2730             then do:
     2731             end.
     2732             else do:
     2733               create buf_temp-diasize-handle .
     2734               assign
     2735                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2736                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2737               .
     2738             end.
     2739           end.
     2740           assign
     2741             v-object-handle = v-object-handle :next-sibling
     2742           .
     2743         end.
     2744         assign
     2745           v-field-group-handle = v-field-group-handle :next-sibling
     2746         .
     2747       end.
     2748       do with frame Dialog-Frame
     2749       :
     2750         hide v-diasize-resize-button .
     2751         assign
     2752           v-diasize-resize-button :row    = 1
     2753           v-diasize-resize-button :column = 1
     2754         .
     2755       end.
     2756       if p-change-value > 0
     2757       then do:
     2758         if frame Dialog-Frame :scrollable = true
     2759         then do:
     2760           assign
     2761             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2762             no-error .
     2763           if error-status :error
     2764           or error-status :get-message(1) <> ""
     2765           then do:
     2766             undo move_block, retry move_block .
     2767           end.
     2768         end.
     2769         assign
     2770           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2771           no-error .
     2772         if error-status :error
     2773         or error-status :get-message(1) <> ""
     2774         then do:
     2775           undo move_block, retry move_block .
     2776         end.
     2777         assign
     2778           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2779           no-error .
     2780         if error-status :error
     2781         or error-status :get-message(1) <> ""
     2782         then do:
     2783           undo move_block, retry move_block .
     2784         end.
     2785         for each buf_temp-browse-handle
     2786           where buf_temp-browse-handle.browse-type = 'height':u
     2787         on error undo move_block, retry move_block
     2788         :
     2789           assign
     2790             buf_temp-browse-handle.browse-handle :height
     2791               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2792             no-error .
     2793           if error-status :error
     2794           or error-status :get-message(1) <> ""
     2795           then do:
     2796             undo move_block, retry move_block .
     2797           end.
     2798         end.
     2799         for each buf_temp-diasize-handle
     2800         on error undo move_block, retry move_block
     2801         :
     2802           assign
     2803             v-object-handle = buf_temp-diasize-handle.handle-value
     2804           .
     2805           if v-object-handle <> v-diasize-resize-button
     2806           then do:
     2807             assign
     2808               v-object-handle :row = v-object-handle :row + p-change-value
     2809               no-error .
     2810             if error-status :error
     2811             or error-status :get-message(1) <> ""
     2812             then do:
     2813               undo move_block, retry move_block .
     2814             end.
     2815           end.
     2816         end.
     2817       end.
     2818       else do:
     2819         for each buf_temp-diasize-handle
     2820         on error undo move_block, retry move_block
     2821         :
     2822           assign
     2823             v-object-handle = buf_temp-diasize-handle.handle-value
     2824           .
     2825           if v-object-handle <> v-diasize-resize-button
     2826           then do:
     2827             assign
     2828               v-object-handle :row = v-object-handle :row + p-change-value
     2829               no-error .
     2830             if error-status :error
     2831             or error-status :get-message(1) <> ""
     2832             then do:
     2833               undo move_block, retry move_block .
     2834             end.
     2835           end.
     2836         end.
     2837         assign
     2838           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2839           no-error .
     2840         if error-status :error
     2841         or error-status :get-message(1) <> ""
     2842         then do:
     2843           undo move_block, retry move_block .
     2844         end.
     2845         for each buf_temp-browse-handle
     2846           where buf_temp-browse-handle.browse-type = 'height':u
     2847         on error undo move_block, retry move_block
     2848         :
     2849           assign
     2850             buf_temp-browse-handle.browse-handle :height
     2851               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2852             no-error .
     2853           if error-status :error
     2854           or error-status :get-message(1) <> ""
     2855           then do:
     2856             undo move_block, retry move_block .
     2857           end.
     2858         end.
     2859         assign
     2860           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2861           no-error .
     2862         if error-status :error
     2863         or error-status :get-message(1) <> ""
     2864         then do:
     2865           undo move_block, retry move_block .
     2866         end.
     2867         if frame Dialog-Frame :scrollable = true
     2868         then do:
     2869           assign
     2870             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2871             no-error .
     2872           if error-status :error
     2873           or error-status :get-message(1) <> ""
     2874           then do:
     2875             undo move_block, retry move_block .
     2876           end.
     2877         end.
     2878       end.
     2879       if p-move-resize = true
     2880       then do:
     2881         run diasize_position-resize-button in this-procedure .
     2882       end.
     2883       if v-diasize-wndstore = true
     2884       then do:
     2885         if connected("ub") = true
     2886         then do:
     2887           define variable v-cntxt-db-num        as integer   no-undo .
     2888           define variable v-cntxt-userid        as character no-undo .
     2889           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2890                                             , OUTPUT v-cntxt-userid
     2891                                             ) .
     2892           run gbl/wndsizew.p
     2893             (input  v-cntxt-db-num
     2894             ,input  v-cntxt-userid
     2895             ,input  v-diasize-proc-name
     2896             ,input  'height':u
     2897             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2898             ) .
     2899         end.
     2900       end.
     2901     end.
     2902     assign
     2903       v-diasize-change-size = false
     2904     .
     2905   end procedure.
     2906   procedure diasize_set-height :
     2907     define input  parameter p-new-height  as decimal   no-undo .
     2908     define input  parameter p-move-resize as logical   no-undo .
     2909     do
     2910     on error undo, return error return-value
     2911     :
     2912       run diasize_change-height in this-procedure
     2913         (input  (p-new-height - frame Dialog-Frame :height)
     2914         ,input  p-move-resize
     2915         ) .
     2916     end.
     2917   end procedure.
     2918   procedure diasize_change-width :
     2919     define input  parameter p-change-value as decimal   no-undo .
     2920     define input  parameter p-move-resize  as logical   no-undo .
     2921     define variable v-field-group-handle   as handle    no-undo .
     2922     define variable v-object-handle        as handle    no-undo .
     2923     define variable v-frame-width          as decimal   no-undo .
     2924     define variable v-frame-virtual-width  as decimal   no-undo .
     2925     define variable v-browse-width         as decimal   no-undo .
     2926     define variable v-window-width         as decimal   no-undo .
     2927     define variable v-window-virtual-width as decimal   no-undo .
     2928     define variable v-change-sign          as integer   no-undo .
     2929     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2930     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2931     if p-change-value > 0
     2932     then do:
     2933       if frame Dialog-Frame :width + p-change-value >
     2934           session :width-chars
     2935       then do:
     2936         assign
     2937           p-change-value = session :width-chars - frame Dialog-Frame :width
     2938         .
     2939         if p-change-value <= 0
     2940         then do:
     2941           run diasize_position-resize-button in this-procedure .
     2942           return .
     2943         end.
     2944       end.
     2945     end.
     2946     if p-change-value < 0
     2947     then do:
     2948       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2949       then do:
     2950         assign
     2951           p-change-value = v-diasize-orig-frame-width
     2952                          - frame Dialog-Frame :width
     2953         .
     2954         if p-change-value >= 0
     2955         then do:
     2956           run diasize_position-resize-button in this-procedure .
     2957           return .
     2958         end.
     2959       end.
     2960     end.
     2961     if p-change-value >= 0
     2962     then do:
     2963       assign
     2964         v-change-sign = 1
     2965       .
     2966     end.
     2967     else do:
     2968       assign
     2969         v-change-sign = -1
     2970       .
     2971     end.
     2972     assign
     2973       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2974     .
     2975     if p-change-value = 0
     2976     then do:
     2977       run diasize_position-resize-button in this-procedure .
     2978       return .
     2979     end.
     2980     move_block:
     2981     do
     2982     on error undo move_block, leave move_block
     2983     :
     2984       if retry
     2985       then do:
     2986         do
     2987         on error undo move_block, leave move_block
     2988         :
     2989           if p-change-value > 0
     2990           then do:
     2991             for each buf_temp-diasize-handle
     2992             on error undo, next
     2993             :
     2994               assign
     2995                 v-object-handle = buf_temp-diasize-handle.handle-value
     2996               .
     2997               if v-object-handle <> v-diasize-resize-button
     2998               then do:
     2999                 assign
     3000                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3001                 .
     3002               end.
     3003             end.
     3004             assign
     3005               v-diasize-browse-handle :width = v-browse-width
     3006             .
     3007             for each buf_temp-browse-handle
     3008               where buf_temp-browse-handle.browse-type = 'width':u
     3009             on error undo, next
     3010             :
     3011               assign
     3012                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3013               .
     3014             end.
     3015             assign
     3016               frame Dialog-Frame :width = v-frame-width
     3017             .
     3018             if frame Dialog-Frame :scrollable = true
     3019             then do:
     3020               assign
     3021                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3022               .
     3023             end.
     3024             run diasize_position-resize-button in this-procedure .
     3025           end.
     3026           else do:
     3027             if frame Dialog-Frame :scrollable = true
     3028             then do:
     3029               assign
     3030                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3031               .
     3032             end.
     3033             assign
     3034               frame Dialog-Frame :width = v-frame-width
     3035             .
     3036             for each buf_temp-browse-handle
     3037               where buf_temp-browse-handle.browse-type = 'width':u
     3038             on error undo, next
     3039             :
     3040               assign
     3041                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3042               .
     3043             end.
     3044             assign
     3045               v-diasize-browse-handle :width = v-browse-width
     3046             .
     3047             for each buf_temp-diasize-handle
     3048             on error undo, next
     3049             :
     3050               assign
     3051                 v-object-handle = buf_temp-diasize-handle.handle-value
     3052               .
     3053               if v-object-handle <> v-diasize-resize-button
     3054               then do:
     3055                 assign
     3056                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3057                 .
     3058               end.
     3059             end.
     3060             run diasize_position-resize-button in this-procedure .
     3061           end.
     3062           assign
     3063             v-diasize-change-size = false
     3064           .
     3065           leave move_block .
     3066         end.
     3067       end.
     3068       assign
     3069         v-diasize-need-full-display = true
     3070       .
     3071       if v-diasize-change-size = false
     3072       then do:
     3073         assign
     3074           v-diasize-change-size = true
     3075         .
     3076       end.
     3077       else do:
     3078         return .
     3079       end.
     3080       assign
     3081         v-frame-width = frame Dialog-Frame :width
     3082         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3083         v-browse-width = v-diasize-browse-handle :width
     3084       .
     3085       for each buf_temp-browse-handle
     3086         where buf_temp-browse-handle.browse-type = 'width':u
     3087       :
     3088         assign
     3089           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3090         .
     3091       end.
     3092       for each buf_temp-diasize-handle
     3093       :
     3094         delete buf_temp-diasize-handle .
     3095       end.
     3096       assign
     3097         v-field-group-handle = frame Dialog-Frame :first-child
     3098       .
     3099       do while valid-handle(v-field-group-handle)
     3100       :
     3101         assign
     3102           v-object-handle = v-field-group-handle :first-child
     3103         .
     3104         do while valid-handle(v-object-handle)
     3105         :
     3106           if  v-object-handle <> v-diasize-browse-handle :handle
     3107           and v-object-handle <> v-diasize-resize-button
     3108           and can-query(v-object-handle, "row")
     3109           and can-query(v-object-handle, "height")
     3110           and ( v-object-handle :col + v-object-handle :width
     3111                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3112               )
     3113           then do:
     3114             find first buf_temp-browse-handle
     3115               where buf_temp-browse-handle.browse-type   = 'width':u
     3116                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3117               no-error .
     3118             if available buf_temp-browse-handle
     3119             then do:
     3120             end.
     3121             else do:
     3122               create buf_temp-diasize-handle .
     3123               assign
     3124                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3125                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3126               .
     3127             end.
     3128           end.
     3129           assign
     3130             v-object-handle = v-object-handle :next-sibling
     3131           .
     3132         end.
     3133         assign
     3134           v-field-group-handle = v-field-group-handle :next-sibling
     3135         .
     3136       end.
     3137       do with frame Dialog-Frame
     3138       :
     3139         hide v-diasize-resize-button .
     3140         v-diasize-resize-button :row = 1.
     3141         v-diasize-resize-button :column = 1.
     3142       end.
     3143       if p-change-value > 0
     3144       then do:
     3145         if frame Dialog-Frame :scrollable = true
     3146         then do:
     3147           assign
     3148             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3149             no-error .
     3150           if error-status :error
     3151           or error-status :get-message(1) <> ""
     3152           then do:
     3153             undo move_block, retry move_block.
     3154           end.
     3155         end.
     3156         assign
     3157           frame Dialog-Frame :width = v-frame-width + p-change-value
     3158           no-error .
     3159         if error-status :error
     3160         or error-status :get-message(1) <> ""
     3161         then do:
     3162           undo move_block, retry move_block.
     3163         end.
     3164         assign
     3165           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3166         no-error .
     3167         if error-status :error
     3168         or error-status :get-message(1) <> ""
     3169         then do:
     3170           undo move_block, retry move_block.
     3171         end.
     3172         for each buf_temp-browse-handle
     3173           where buf_temp-browse-handle.browse-type = 'width':u
     3174         on error undo move_block, retry move_block
     3175         :
     3176           assign
     3177             buf_temp-browse-handle.browse-handle :width
     3178               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3179             no-error .
     3180           if error-status :error
     3181           or error-status :get-message(1) <> ""
     3182           then do:
     3183             undo move_block, retry move_block .
     3184           end.
     3185         end.
     3186         for each buf_temp-diasize-handle
     3187         on error undo move_block, retry move_block
     3188         :
     3189           assign
     3190             v-object-handle = buf_temp-diasize-handle.handle-value
     3191           .
     3192           if v-object-handle <> v-diasize-resize-button
     3193           then do:
     3194             assign
     3195               v-object-handle :col = v-object-handle :col + p-change-value
     3196               no-error .
     3197             if error-status :error
     3198             or error-status :get-message(1) <> ""
     3199             then do:
     3200               undo move_block, retry move_block .
     3201             end.
     3202           end.
     3203         end.
     3204       end.
     3205       else do:
     3206         for each buf_temp-diasize-handle
     3207         on error undo move_block, retry move_block
     3208         :
     3209           assign
     3210             v-object-handle = buf_temp-diasize-handle.handle-value
     3211           .
     3212           if v-object-handle <> v-diasize-resize-button
     3213           then do:
     3214             assign
     3215               v-object-handle :col = v-object-handle :col + p-change-value
     3216               no-error .
     3217             if error-status :error
     3218             or error-status :get-message(1) <> ""
     3219             then do:
     3220               undo move_block, retry move_block .
     3221             end.
     3222           end.
     3223         end.
     3224         for each buf_temp-browse-handle
     3225           where buf_temp-browse-handle.browse-type = 'width':u
     3226         on error undo move_block, retry move_block
     3227         :
     3228           assign
     3229             buf_temp-browse-handle.browse-handle :width
     3230               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3231             no-error .
     3232           if error-status :error
     3233           or error-status :get-message(1) <> ""
     3234           then do:
     3235             undo move_block, retry move_block .
     3236           end.
     3237         end.
     3238         assign
     3239           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3240           no-error .
     3241         if error-status :error
     3242         or error-status :get-message(1) <> ""
     3243         then do:
     3244           undo move_block, retry move_block.
     3245         end.
     3246         assign
     3247           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3248         no-error .
     3249         if error-status :error
     3250         or error-status :get-message(1) <> ""
     3251         then do:
     3252           undo move_block, retry move_block.
     3253         end.
     3254         if frame Dialog-Frame :scrollable = true
     3255         then do:
     3256           assign
     3257             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3258           no-error .
     3259           if error-status :error
     3260           or error-status :get-message(1) <> ""
     3261           then do:
     3262             undo move_block, retry move_block.
     3263           end.
     3264         end.
     3265       end.
     3266       if p-move-resize
     3267       then do:
     3268         run diasize_position-resize-button in this-procedure .
     3269       end.
     3270       if v-diasize-wndstore = true
     3271       then do:
     3272         if connected("ub") = true
     3273         then do:
     3274           define variable v-cntxt-db-num        as integer   no-undo .
     3275           define variable v-cntxt-userid        as character no-undo .
     3276           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3277                                             , OUTPUT v-cntxt-userid
     3278                                             ) .
     3279           run gbl/wndsizew.p
     3280             (input  v-cntxt-db-num
     3281             ,input  v-cntxt-userid
     3282             ,input  v-diasize-proc-name
     3283             ,input  'width':u
     3284             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3285             ) .
     3286         end.
     3287       end.
     3288     end.
     3289     assign
     3290       v-diasize-change-size = false
     3291     .
     3292   end procedure.
     3293   procedure diasize_set-width :
     3294     define input  parameter p-new-width  as decimal   no-undo .
     3295     define input  parameter p-move-resize as logical   no-undo .
     3296     do
     3297     on error undo, return error return-value
     3298     :
     3299       run diasize_change-width in this-procedure
     3300         (input  (p-new-width - frame Dialog-Frame :width)
     3301         ,input  p-move-resize
     3302         ) .
     3303     end.
     3304   end procedure.
     3305   procedure diasize_position-resize-button :
     3306     do with frame Dialog-Frame
     3307     :
     3308       hide v-diasize-resize-button .
     3309       assign
     3310         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3311                     - 1
     3312                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3313         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3314                     - 1
     3315                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3316       .
     3317       view v-diasize-resize-button .
     3318     end.
     3319   end procedure.
     3320   on alt-right anywhere
     3321   do:
     3322     run diasize_change-width in this-procedure
     3323       (input 1
     3324       ,input true
     3325       ) .
     3326     return no-apply .
     3327   end.
     3328   on alt-left anywhere
     3329   do:
     3330     run diasize_change-width in this-procedure
     3331       (input -1
     3332       ,input true
     3333       ) .
     3334     return no-apply .
     3335   end.
     3336   on alt-down anywhere
     3337   do:
     3338     run diasize_change-height in this-procedure
     3339       (input 1
     3340       ,input true
     3341       ) .
     3342     return no-apply .
     3343   end.
     3344   on alt-up anywhere
     3345   do:
     3346     run diasize_change-height in this-procedure
     3347       (input -1
     3348       ,input true
     3349       ) .
     3350     return no-apply .
     3351   end.
     3352   on alt-enter of frame Dialog-Frame
     3353   do:
     3354     run diasize_maximize in this-procedure
     3355       (input  ?
     3356       ).
     3357     return no-apply .
     3358   end.
     3359   procedure diasize_end-move :
     3360     do
     3361     on error undo, return error return-value
     3362     :
     3363       define variable v-row-delta as decimal   no-undo .
     3364       define variable v-col-delta as decimal   no-undo .
     3365       define variable v-new-row as decimal   no-undo .
     3366       define variable v-new-col as decimal   no-undo .
     3367       assign
     3368         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3369         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3370       .
     3371       assign
     3372         v-row-delta = v-new-row - frame Dialog-Frame :height
     3373         v-col-delta = v-new-col - frame Dialog-Frame :width
     3374       .
     3375       run diasize_change-height in this-procedure
     3376         (input v-row-delta
     3377         ,input true
     3378         ) .
     3379       run diasize_change-width in this-procedure
     3380         (input v-col-delta
     3381         ,input true
     3382         ) .
     3383     end.
     3384   end procedure.
     3385   procedure diasize_maximize :
     3386     define input  parameter p-action as logical   no-undo .
     3387     do
     3388     on error undo, return error return-value
     3389     :
     3390       if p-action = ?
     3391       then do:
     3392         if v-diasize-need-maximize = true
     3393         then do:
     3394           assign
     3395             p-action = true
     3396           .
     3397         end.
     3398         else do:
     3399           assign
     3400             p-action = false
     3401           .
     3402         end.
     3403       end.
     3404       if p-action = true
     3405       then do:
     3406         run diasize_change-height in this-procedure
     3407           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3408               - frame Dialog-Frame :height-chars
     3409           ,input true
     3410           ) .
     3411         run diasize_change-width in this-procedure
     3412           (input session :width-chars
     3413               - frame Dialog-Frame :width-chars
     3414           ,input true
     3415           ) .
     3416         assign
     3417           v-diasize-need-maximize = false
     3418         .
     3419       end.
     3420       else do:
     3421         run diasize_change-width in this-procedure
     3422           (input v-diasize-orig-frame-width
     3423               - frame Dialog-Frame :width-chars
     3424           ,input true
     3425           ) .
     3426         run diasize_change-height in this-procedure
     3427           (input v-diasize-orig-frame-height
     3428               - frame Dialog-Frame :height-chars
     3429           ,input true
     3430           ) .
     3431         assign
     3432           v-diasize-need-maximize = true
     3433         .
     3434       end.
     3435     end.
     3436   end procedure.
     3437   procedure diasize_restore-orig-size :
     3438     do
     3439     on error undo, return error return-value
     3440     :
     3441       assign
     3442         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3443         v-diasize-current-frame-height = frame Dialog-Frame :height
     3444       .
     3445       run diasize_set-height in this-procedure
     3446         (input  v-diasize-orig-frame-height
     3447         ,input  true
     3448         ) .
     3449       run diasize_set-width in this-procedure
     3450         (input  v-diasize-orig-frame-width
     3451         ,input  true
     3452         ) .
     3453     end.
     3454   end procedure.
     3455   procedure diasize_restore-current-size :
     3456     do
     3457     on error undo, return error return-value
     3458     :
     3459       run diasize_set-height in this-procedure
     3460         (input  v-diasize-current-frame-height
     3461         ,input  true
     3462         ) .
     3463       run diasize_set-width in this-procedure
     3464         (input  v-diasize-current-frame-width
     3465         ,input  true
     3466         ) .
     3467     end.
     3468   end procedure.
     3469   procedure diasize_set-browse-handle :
     3470     define input  parameter p-browse-handle as handle   no-undo .
     3471     define buffer buf_temp-browse-handle for temp-browse-handle .
     3472     do
     3473     on error undo, return error return-value
     3474     :
     3475       assign
     3476         v-diasize-browse-handle = p-browse-handle
     3477       .
     3478       for each buf_temp-browse-handle
     3479       on error undo, return error return-value
     3480       :
     3481         delete buf_temp-browse-handle .
     3482       end.
     3483     end.
     3484   end procedure.
     3485   procedure diasize_add_browse :
     3486     define input  parameter p-browse-type   as character no-undo .
     3487     define input  parameter p-browse-handle as handle    no-undo .
     3488     define buffer buf_temp-browse-handle for temp-browse-handle .
     3489     do
     3490     on error undo, return error return-value
     3491     :
     3492       assign
     3493         v-diasize-browse-number = v-diasize-browse-number + 1
     3494       .
     3495       create buf_temp-browse-handle .
     3496       assign
     3497         buf_temp-browse-handle.browse-type   = p-browse-type
     3498         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3499         buf_temp-browse-handle.browse-handle = p-browse-handle
     3500       .
     3501     end.
     3502   end procedure.
     3503   procedure diasize_init :
     3504     define variable v-default-value    as logical   no-undo .
     3505     define variable v-restore-saved    as logical   no-undo .
     3506     define variable v-resize-value-str as character no-undo .
     3507     do
     3508     on error undo, return error return-value
     3509     :
     3510       do with frame Dialog-Frame
     3511       :
     3512         assign
     3513           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3514           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3515           v-diasize-browse-handle     = browse br-prop :handle
     3516         .
     3517         create button v-diasize-resize-button
     3518         assign
     3519           parent        = frame Dialog-Frame :first-child
     3520           label         = "s"
     3521           height-pixels = 16
     3522           width-pixels  = 16
     3523           visible       = true
     3524           sensitive     = true
     3525           movable       = true
     3526           triggers:
     3527             on end-move persistent run diasize_end-move in this-procedure .
     3528           end triggers.
     3529         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3530         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3531         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3532         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3533         assign
     3534           v-diasize-wndmax = false
     3535         .
     3536         if connected("ub") = true
     3537         then do:
     3538           define variable v-cntxt-db-num        as integer   no-undo .
     3539           define variable v-cntxt-userid        as character no-undo .
     3540           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3541                                             , OUTPUT v-cntxt-userid
     3542                                             ) .
     3543           run gbl/wndpar_r.p
     3544             (input  v-cntxt-db-num
     3545             ,input  v-cntxt-userid
     3546             ,input  'wndmax':U
     3547             ,output v-diasize-wndmax
     3548             ,output v-default-value
     3549             ) .
     3550         end.
     3551         assign
     3552           v-diasize-wndstore = false
     3553         .
     3554         if connected("ub") = true
     3555         then do:
     3556           run gbl/wndpar_r.p
     3557             (input  v-cntxt-db-num
     3558             ,input  v-cntxt-userid
     3559             ,input  'wndstore':U
     3560             ,output v-diasize-wndstore
     3561             ,output v-default-value
     3562             ) .
     3563         end.
     3564         assign
     3565           v-diasize-proc-name = entry(1, program-name(2), '.')
     3566         .
     3567         if v-diasize-wndstore = true
     3568         then do:
     3569           assign
     3570             v-restore-saved = false
     3571           .
     3572           if connected("ub") = true
     3573           then do:
     3574             run gbl/wndsizer.p
     3575               (input  v-cntxt-db-num
     3576               ,input  v-cntxt-userid
     3577               ,input  v-diasize-proc-name
     3578               ,input  'height':u
     3579               ,output v-resize-value-str
     3580               ) .
     3581             if v-resize-value-str <> '':U
     3582             then do:
     3583               run diasize_change-height in this-procedure
     3584                 (input  integer(v-resize-value-str)
     3585                 ,input  true
     3586                 ) .
     3587               assign
     3588                 v-restore-saved = true
     3589               .
     3590             end.
     3591           end.
     3592           if connected("ub") = true
     3593           then do:
     3594             run gbl/wndsizer.p
     3595               (input  v-cntxt-db-num
     3596               ,input  v-cntxt-userid
     3597               ,input  v-diasize-proc-name
     3598               ,input  'width':u
     3599               ,output v-resize-value-str
     3600               ) .
     3601             if v-resize-value-str <> '':U
     3602             then do:
     3603               run diasize_change-width in this-procedure
     3604                 (input  integer(v-resize-value-str)
     3605                 ,input  true
     3606                 ) .
     3607               assign
     3608                 v-restore-saved = true
     3609               .
     3610             end.
     3611           end.
     3612           if v-restore-saved <> true
     3613           then do:
     3614             if v-diasize-wndmax = true
     3615             then do:
     3616               run diasize_maximize in this-procedure
     3617                 (input  true
     3618                 ) .
     3619             end.
     3620           end.
     3621         end.
     3622         else do:
     3623           if v-diasize-wndmax = true
     3624           then do:
     3625             run diasize_maximize in this-procedure
     3626               (input  true
     3627               ) .
     3628           end.
     3629         end.
     3630       end.
     3631     end.
     3632   end procedure.
     3633   procedure diasize_need-full-display :
     3634     define output parameter p-need-full-display as logical   no-undo .
     3635     do
     3636     on error undo, return error return-value
     3637     :
     3638       assign
     3639         p-need-full-display = v-diasize-need-full-display
     3640       .
     3641       assign
     3642         v-diasize-need-full-display = false
     3643       .
     3644     end.
     3645   end procedure.
     3646   procedure get-context :
     3647      define output parameter p-db-num as integer          no-undo.
     3648      define output parameter p-user-id as character        no-undo.
     3649      define variable v-login               as character    no-undo.
     3650      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3651      define buffer buf_user-login  for ub.user-login .
     3652      do
     3653      on error undo, return error
     3654      :
     3655            FIND FIRST buf_sys-ctrl no-lock.
     3656            ASSIGN
     3657               v-login = USERID("ub")
     3658               p-db-num = buf_sys-ctrl.db-num
     3659            .
     3660            FIND FIRST buf_user-login
     3661                 WHERE buf_user-login.db-num = p-db-num
     3662                   AND buf_user-login.user-login = v-login
     3663                 no-lock
     3664                 no-error
     3665                 .
     3666            IF AVAILABLE buf_user-login
     3667            THEN DO:
     3668               assign
     3669                  p-user-id = buf_user-login.user-id
     3670               .
     3671            END.
     3672      end.
     3673   end procedure.
     3674       run diasize_init in this-procedure .
     3675   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3676   do:
     3677     br-prop :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     3678   end.
     3679    frame Dialog-Frame:TITLE = frame Dialog-Frame:TITLE.
     3680   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     3681   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     3682   ON ROW-DISPLAY OF br-prop IN frame Dialog-Frame
     3683   DO:
     3684     IF AVAIL temp-dis-card-property THEN DO:
     3685     END.
     3686   END.
     3687   MAIN-BLOCK:
     3688   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3689      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3690   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3691     run mainmenu_getcntxt in parparentproc
     3692       (output v-cntxt-db-num
     3693       ,output v-cntxt-userid
     3694       ,output v-cntxt-level
     3695       ,output v-cntxt-host-code-obj
     3696       ,output v-cntxt-obj-type
     3697       ,output v-cntxt-obj-code
     3698       ,output v-cntxt-db-num-obj
     3699       ,output v-cntxt-is-admin
     3700       ) .
     3701     if NOT (p-mode = 'ПРОСМОТР':U
     3702           or p-mode = 'ИЗМЕНЕНИЕ':U
     3703           or p-mode = 'ДОБАВЛЕНИЕ':U
     3704           ) then do:
     3705       message
     3706       vss-workfile vss-revision vss-description skip
     3707       "Неверный параметр вызова p-mode"
     3708       view-as alert-box ERROR.
     3709       return error.
     3710     end.
     3711     find first locked_dis-card no-lock where
     3712                 locked_dis-card.d-card = pard-card No-ERROR.
     3713     IF NOT avail locked_dis-card  and p-mode <> 'ДОБАВЛЕНИЕ':U then do:
     3714       message
     3715       vss-workfile vss-revision vss-description skip
     3716       "Не найдена дисконтная карта" pard-card
     3717       view-as alert-box.
     3718       return error.
     3719     END .
     3720     IF AVAIL locked_dis-card THEN
     3721     DO:
     3722         assign
     3723         v-card-num = locked_dis-card.card-num
     3724         .
     3725     END.
     3726     IF p-mode <> 'ДОБАВЛЕНИЕ':U THEN DO:
     3727         FIND FIRST buf_clients NO-LOCK WHERE
     3728                   buf_clients.obj-type = LOCKED_dis-card.cli-type
     3729             AND    buf_clients.obj-code = LOCKED_dis-card.cli-code.
     3730     END.
     3731       find first ub.sysconf No-LOCK WHERE
     3732                        ub.sysconf.host-code = p-host-code No-ERROR.
     3733       if not avail ub.sysconf then do:
     3734           message vss-workfile vss-revision vss-description skip
     3735                           "Неверный параметр вызова p-host-code"
     3736               view-as alert-box ERROR.
     3737               return error.
     3738       end.
     3739       find first ub.clients No-LOCK WHERE
     3740                   ub.clients.obj-type = p-obj-type AND
     3741                   ub.clients.obj-code = p-obj-code No-ERROR.
     3742       if not avail ub.clients then do:
     3743           message vss-workfile vss-revision vss-description skip
     3744            "Неверный параметр вызова p-obj-type/p-obj-code"
     3745           p-obj-type p-obj-code
     3746           view-as alert-box ERROR.
     3747           return error.
     3748       end.
     3749   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3750     RUN MyEnable in this-procedure .
     3751     Run init-proc in this-procedure .
     3752     OPEN QUERY br-prop FOR EACH temp-dis-card-property,            FIRST X_prop-map NO-LOCK WHERE         X_prop-map.dtm-code = temp-dis-card-property.dtm-code     AND X_prop-map.node-code = temp-dis-card-property.node-code,           FIRST X_prop-ref  NO-LOCK outer-join WHERE         X_prop-ref.dt-code = temp-dis-card-property.dt-code by temp-dis-card-property.dtm-code by temp-dis-card-property.dt-code by temp-dis-card-property.node-code      INDEXED-REPOSITION.
     3753     APPLY "ENTRY" TO br-prop in frame Dialog-Frame .
     3754     APPLY "VALUE-CHANGED" TO br-prop in frame Dialog-Frame .
     3755     WAIT-FOR GO OF FRAME Dialog-Frame.
     3756   END.
     3757   RUN disable_UI in this-procedure .
     3758   run attr-pop-clean-up in this-procedure ( input 'dis-card-property':U ).
     3759   if updated then return 'ИЗМЕНЕНИЕ':U.
     3760   PROCEDURE choose-to-edit :
     3761   define input parameter p-dtm-code as integer no-undo .
     3762   assign
     3763   dtm-node-option = string(p-dtm-code) + chr(4) + string(0)
     3764   dtm-option = p-dtm-code
     3765   .
     3766   APPLY "CHOOSE" to b-ins in frame Dialog-Frame .
     3767   END PROCEDURE.
     3768   PROCEDURE choose-to-edit-2 :
     3769   define input parameter p-dtm-code as integer no-undo .
     3770   define input parameter p-node-code-option as integer no-undo .
     3771   assign
     3772   dtm-node-option = string(p-dtm-code) + chr(4) + string(p-node-code-option)
     3773   .
     3774   APPLY "CHOOSE" to b-ins in frame Dialog-Frame .
     3775   END PROCEDURE.
     3776   PROCEDURE disable_UI :
     3777     HIDE FRAME Dialog-Frame.
     3778   END PROCEDURE.
     3779   PROCEDURE enable_UI :
     3780     DISPLAY rs-view vard-card v-first-main-card v-cli-name v-first-card
     3781             v-main-card
     3782         WITH FRAME Dialog-Frame.
     3783     ENABLE b-exit B-quit b-ins b-lkp b-chg b-del b-hist b-help rs-view br-prop
     3784            vard-card v-first-main-card v-cli-name v-first-card v-main-card
     3785         WITH FRAME Dialog-Frame.
     3786     VIEW FRAME Dialog-Frame.
     3787     OPEN QUERY br-prop FOR EACH temp-dis-card-property,            FIRST X_prop-map NO-LOCK WHERE         X_prop-map.dtm-code = temp-dis-card-property.dtm-code     AND X_prop-map.node-code = temp-dis-card-property.node-code,           FIRST X_prop-ref  NO-LOCK outer-join WHERE         X_prop-ref.dt-code = temp-dis-card-property.dt-code by temp-dis-card-property.dtm-code by temp-dis-card-property.dt-code by temp-dis-card-property.node-code      INDEXED-REPOSITION.
     3788   END PROCEDURE.
     3789   PROCEDURE init-proc :
     3790   define variable v-data-type as character no-undo .
     3791   define variable v-format as character no-undo .
     3792   define variable v-label as character no-undo .
     3793   define variable v-property-value-character as character no-undo .
     3794   define variable v-rw-option as character no-undo .
     3795   define variable v-range as integer no-undo .
     3796   define variable v-node-code-label as character no-undo .
     3797   define variable v-entry as character no-undo .
     3798   define variable ii as integer no-undo .
     3799   define variable v-entry2 as character no-undo .
     3800   define buffer buf_prop-head for ub.prop-head.
     3801   for each  Temp-dis-card-property share-lock:
     3802     delete Temp-dis-card-property.
     3803   end.
     3804   assign
     3805   dtm-node-option = '':U
     3806   dtm-option = 0
     3807   node-code-option = 0
     3808   .
     3809   if p-mode <> 'ДОБАВЛЕНИЕ':U then
     3810   Assign
     3811   vard-card = locked_dis-card.d-card
     3812   .
     3813   for each temp-dis-card-property:
     3814     delete temp-dis-card-property.
     3815   end.
     3816   display vard-card
     3817   with frame Dialog-Frame  .
     3818   For each tt0-dis-card-property where
     3819           tt0-dis-card-property.d-card = pard-card
     3820           no-lock :
     3821     find first buf_prop-head no-lock where
     3822               buf_prop-head.dtm-code = tt0-dis-card-property.dtm-code no-error .
     3823     run discprop-node-code (
     3824                          input tt0-dis-card-property.dtm-code
     3825                         ,input tt0-dis-card-property.node-code
     3826                         ,output v-data-type
     3827                         ,output v-format
     3828                         ,output v-label
     3829                         ,output v-range
     3830                         ,output v-rw-option
     3831                          ).
     3832       create temp-dis-card-property.
     3833       assign
     3834       temp-dis-card-property.d-card    = tt0-dis-card-property.d-card
     3835       temp-dis-card-property.dt-code   = tt0-dis-card-property.dt-code
     3836       temp-dis-card-property.sum-id    = tt0-dis-card-property.sum-id
     3837       temp-dis-card-property.dtm-code = tt0-dis-card-property.dtm-code
     3838       temp-dis-card-property.data-type  = v-data-type
     3839       temp-dis-card-property.range      = v-range
     3840       temp-dis-card-property.node-label = v-label
     3841       temp-dis-card-property.prop-label = (if available buf_prop-head
     3842                                            then buf_prop-head.prop-label
     3843                                            else '':U)
     3844       temp-dis-card-property.property-value-character = tt0-dis-card-property.property-value-character
     3845       temp-dis-card-property.property-value-date = tt0-dis-card-property.property-value-date
     3846       temp-dis-card-property.property-value-decimal = tt0-dis-card-property.property-value-decimal
     3847       temp-dis-card-property.property-value-integer = tt0-dis-card-property.property-value-integer
     3848       temp-dis-card-property.rw-option = v-rw-option
     3849       temp-dis-card-property.node-code = tt0-dis-card-property.node-code
     3850       temp-dis-card-property.host-code = tt0-dis-card-property.host-code
     3851       temp-dis-card-property.obj-type = tt0-dis-card-property.obj-type
     3852       temp-dis-card-property.obj-code = tt0-dis-card-property.obj-code
     3853       .
     3854   End.
     3855   Run Openbr in this-procedure .
     3856   END PROCEDURE.
     3857   PROCEDURE MyEnable :
     3858   define variable v-db-edit-prop-code as character no-undo .
     3859   define variable v-list as character no-undo .
     3860   define buffer buf_prop-head for ub.prop-head.
     3861   define buffer buf_prop-map for ub.prop-map.
     3862   define buffer buf_attr-prop for ub.attr-prop.
     3863   define buffer buf2_attr-prop for ub.attr-prop.
     3864   DEFINE VARIABLE v-h AS handle NO-UNDO.
     3865   v-h = br-prop:FIRST-COLUMN IN FRAME Dialog-Frame.
     3866   DO while valid-handle(v-h) :
     3867     if v-h:LABEL = "Свойство" then do:
     3868       v-h:RESIZABLE = YES.
     3869      end.
     3870      IF v-h:LABEL =  "Идентификатор/!Описание" THEN DO:
     3871         v-h:RESIZABLE = YES.
     3872      END.
     3873      IF v-h:LABEL = "Значение!(строковое)" THEN
     3874      v-ch[1] = v-h.
     3875      IF v-h:LABEL = "Значение!(Дата)" THEN
     3876      v-ch[2] = v-h.
     3877      IF v-h:LABEL = "Значение!(Десятичное)" THEN
     3878      v-ch[3] = v-h.
     3879      IF v-h:LABEL = "Значение!(Целое)" THEN
     3880      v-ch[4] = v-h.
     3881      IF v-h:LABEL = "Значение!(Логическое)" THEN
     3882      v-ch[5] = v-h.
     3883      v-h = v-h:NEXT-COLUMN.
     3884   END.
     3885   assign
     3886   b-ins:POPUP-MENU IN FRAME Dialog-Frame = MENU MENU-b-ins:HANDLE
     3887   b-ins:MENU-MOUSE = 1
     3888   .
     3889   if p-mode <> 'ПРОСМОТР':U then do:
     3890     if v-cntxt-db-num = 0 then do:
     3891      v-db-edit-prop-code = 'DB0Edit':U.
     3892     end.
     3893     else do:
     3894      v-db-edit-prop-code = 'DBREdit':U.
     3895     end.
     3896     for each buf_prop-head where
     3897             buf_prop-head.storage-place = 'dis-card-property':U
     3898         or  buf_prop-head.storage-place-host = 'dis-card-property':U
     3899         or  buf_prop-head.storage-place-obj = 'dis-card-property':U:
     3900       if discprop-usercanedit ( input buf_prop-head.dtm-code, input v-cntxt-db-num) = yes then do:
     3901         v-list = v-list + (if v-list = '' then '' else chr(44)) + (string(buf_prop-head.dtm-code) + chr(4) + '':U).
     3902       end.
     3903     end.
     3904     run attr-pop-create-items in this-procedure  (
     3905                                               input 'dis-card-property':U
     3906                                               ,input 'discprop-edit'
     3907                                               ,input 'discprop-node-name'
     3908                                               ,input 'choose-to-edit'
     3909                                               ,input menu menu-b-ins:handle
     3910                                               ,input v-list
     3911                                             ).
     3912   end.
     3913   IF p-mode <> 'ДОБАВЛЕНИЕ':U THEN DO:
     3914     DISPLAY
     3915     buf_clients.obj-name @ v-cli-name
     3916     locked_dis-card.first-main-card @ v-first-main-card
     3917     locked_dis-card.main-card @ v-main-card
     3918     locked_dis-card.first-card @ v-first-card
     3919     WITH FRAME Dialog-Frame.
     3920   END.
     3921   ELSE do:
     3922      HIDE
     3923      v-cli-name
     3924      v-first-main-card
     3925      v-first-card
     3926      v-main-card
     3927      IN FRAME Dialog-Frame.
     3928   END.
     3929   ENABLE
     3930   rs-view
     3931   b-exit when p-mode <> 'ПРОСМОТР':U
     3932   b-quit
     3933   b-del when p-mode <> 'ПРОСМОТР':U
     3934   b-ins when (p-mode <> 'ПРОСМОТР':U and  can-find( first tt-attr-property where
     3935                                                       tt-attr-property.table-name = 'dis-card-property':U
     3936                                                   and tt-attr-property.edit-menu-section-num > 0))
     3937   b-chg when p-mode <> 'ПРОСМОТР':U
     3938   b-help
     3939   br-prop
     3940   b-hist WHEN p-mode <> 'ДОБАВЛЕНИЕ':U
     3941   WITH FRAME Dialog-Frame .
     3942   VIEW FRAME Dialog-Frame .
     3943   rs-view = 0.
     3944   run Openbr in this-procedure .
     3945   if p-mode = 'ПРОСМОТР':U then do:
     3946     hide
     3947     b-exit
     3948     in frame Dialog-Frame .
     3949     assign
     3950     b-quit:label = "&Выход"
     3951     b-quit:col    = 1
     3952     .
     3953   end.
     3954   APPLY "ENTRY" TO br-prop.
     3955   APPLY "VALUE-CHANGED" TO br-prop.
     3956   END PROCEDURE.
     3957   PROCEDURE Openbr :
     3958   CASE rs-view:
     3959     WHEN 1  THEN DO:
     3960         OPEN QUERY br-prop
     3961         FOR EACH temp-dis-card-property,
     3962             FIRST X_prop-map NO-LOCK WHERE
     3963                 X_prop-map.dtm-code = temp-dis-card-property.dtm-code
     3964             AND X_prop-map.node-code = temp-dis-card-property.node-code,
     3965             FIRST X_prop-ref NO-LOCK OUTER-JOIN WHERE
     3966                 X_prop-ref.dt-code = temp-dis-card-property.dt-code
     3967         by temp-dis-card-property.dtm-code
     3968         by temp-dis-card-property.dt-code
     3969         by temp-dis-card-property.node-code
     3970             INDEXED-REPOSITION.
     3971     END.
     3972     WHEN 0  THEN DO:
     3973         OPEN QUERY br-prop
     3974         FOR EACH temp-dis-card-property
     3975         WHERE temp-dis-card-property.host-code = 0
     3976         OR (temp-dis-card-property.host-code = p-host-code AND
     3977             temp-dis-card-property.obj-type = '')
     3978         OR (temp-dis-card-property.host-code = p-host-code AND
     3979             temp-dis-card-property.obj-type = p-obj-type AND
     3980             temp-dis-card-property.obj-code = p-obj-code
     3981              ),
     3982             FIRST X_prop-map NO-LOCK WHERE
     3983                 X_prop-map.dtm-code = temp-dis-card-property.dtm-code
     3984             AND X_prop-map.node-code = temp-dis-card-property.node-code,
     3985             FIRST X_prop-ref NO-LOCK OUTER-JOIN WHERE
     3986                 X_prop-ref.dt-code = temp-dis-card-property.dt-code
     3987         by temp-dis-card-property.dtm-code
     3988         by temp-dis-card-property.dt-code
     3989         by temp-dis-card-property.node-code
     3990             INDEXED-REPOSITION.
     3991     END.
     3992   END CASE.
     3993   END PROCEDURE.
     3994   PROCEDURE proc-add-chg :
     3995   define input parameter p-add as logical no-undo .
     3996   define variable v-data-type as character no-undo .
     3997   define variable v-format as character no-undo .
     3998   define variable v-label as character no-undo .
     3999   define variable v-range as integer no-undo .
     4000   define variable v-rw-option as character no-undo .
     4001   define variable v-value-character as character no-undo .
     4002   define variable v-value-date as date no-undo .
     4003   define variable v-value-decimal as decimal no-undo .
     4004   define variable v-value-integer as integer no-undo .
     4005   define variable v-value-logical as logical no-undo .
     4006   define variable loc#log as logical no-undo.
     4007   define variable var-region  as character no-undo.
     4008   DEFINE VARIABLE v-sel-vals as character no-undo .
     4009   DEFINE VARIABLE v-sel-labels as character no-undo .
     4010   DEFINE VARIABLE jj as integer no-undo .
     4011   DEFINE VARIABLE v-dtm-option as integer no-undo .
     4012   define variable v-spr as character no-undo .
     4013   define variable v-spr-param as character no-undo .
     4014   DEFINE VARIABLE v-deleted as logical no-undo .
     4015   define variable v-check as character no-undo .
     4016   define variable v-error-code as character no-undo .
     4017   define variable v-correct as logical no-undo .
     4018   define variable v-setted as logical no-undo .
     4019   define variable v-ok as logical no-undo .
     4020   define variable v-old-kat like ub.dis-card-property.property-value-character no-undo .
     4021   define buffer buf_attr-prop for ub.attr-prop.
     4022   if  discprop-usercanedit ( if p-add
     4023                              then dtm-option
     4024                              else temp-dis-card-property.dtm-code
     4025                              , v-cntxt-db-num)  = no then do:
     4026      message
     4027     "Нельзя редактировать Данное свойство в данной БД"
     4028     view-as alert-box .
     4029     undo, return error .
     4030   end.
     4031   case p-add:
     4032     when yes then do:
     4033        run discprop-node-code in this-procedure (
     4034                                            input  dtm-option
     4035                                           ,input  node-code-option
     4036                                           ,output v-data-type
     4037                                           ,output v-format
     4038                                           ,output v-label
     4039                                           ,output v-range
     4040                                           ,output v-rw-option
     4041                                           ) no-error .
     4042       if error-status :error then do:
     4043         return error .
     4044       end.
     4045       if v-range > 4 then do:
     4046         assign
     4047         v-sel-vals =  if p-emitent-host-code = 0 and BinMask(integer(v-range), "XXX1":U)
     4048                       then  ("1" + chr(44) )
     4049                       else ''
     4050         v-sel-labels = if p-emitent-host-code = 0 and BinMask(integer(v-range), "XXX1":U)
     4051                       then  ("Глобально" + chr(44) )
     4052                       else ''
     4053         .
     4054         assign
     4055         v-sel-vals = v-sel-vals +
     4056                      if p-emitent-host-code <> 0 and BinMask(integer(v-range), "XX1X":U)
     4057                      then ("1":U + chr(44))
     4058                      else "":U
     4059         v-sel-labels = v-sel-labels +
     4060                      if p-emitent-host-code <> 0 and BinMask(integer(v-range), "XX1X":U)
     4061                      then ( substitute("Эмитент (фирма &1)", p-emitent-host-code) + chr(44))
     4062                      else "":U
     4063         .
     4064         assign
     4065         v-sel-vals = v-sel-vals +
     4066                      if p-emitent-host-code = 0 and  BinMask(integer(v-range), "X1XX":U)
     4067                      then ("2":U + chr(44))
     4068                      else "":U
     4069         v-sel-labels = v-sel-labels +
     4070                      if p-emitent-host-code = 0 and  BinMask(integer(v-range), "X1XX":U)
     4071                      then ( substitute("Фирма &1", p-host-code) + chr(44))
     4072                      else "":U
     4073         .
     4074         assign
     4075         v-sel-vals = v-sel-vals +
     4076                      if BinMask(integer(v-range), "1XXX":U)
     4077                      then ("4":U + chr(44))
     4078                      else "":U
     4079         v-sel-labels = v-sel-labels +
     4080                      if BinMask(integer(v-range), "1XXX":U)
     4081                      then ( substitute("&1&2", p-obj-type, p-obj-code) + chr(44))
     4082                      else "":U
     4083         .
     4084           assign
     4085         v-sel-labels = trim(v-sel-labels, chr(44))
     4086         v-sel-vals   = trim(v-sel-vals, chr(44))
     4087           .
     4088         run gbl/d-list.w (
     4089                             input "b-sel":U
     4090                             ,input "Выберите область действия"
     4091                             ,v-sel-vals
     4092                             ,v-sel-labels
     4093                             ,chr(44)
     4094                             ,"":U
     4095                             ,output var-region) no-error.
     4096         if error-status:error then do:
     4097           assign
     4098           dtm-node-option = '':U
     4099           dtm-option = 0
     4100           node-code-option = 0
     4101           .
     4102           return error.
     4103         end.
     4104       end.
     4105       else do:
     4106         assign
     4107         var-region = string(v-range)
     4108         .
     4109       end.
     4110       CASE var-region:
     4111           when "0":U then do:
     4112               assign
     4113               v-host-code = 0
     4114               v-obj-type = "":U
     4115               v-obj-code = 0
     4116               .
     4117           end.
     4118           when "1":U then do:
     4119               assign
     4120               v-host-code = (if p-emitent-host-code = 0 then 0 else p-emitent-host-code)
     4121               v-obj-type = "":U
     4122               v-obj-code = 0
     4123               .
     4124           end.
     4125           when "2":U then do:
     4126               assign
     4127               v-host-code = p-host-code
     4128               v-obj-type = "":U
     4129               v-obj-code = 0
     4130               .
     4131           end.
     4132           when "4":U then do:
     4133               assign
     4134               v-host-code = p-host-code
     4135               v-obj-type = p-obj-type
     4136               v-obj-code = p-obj-code
     4137               .
     4138           end.
     4139       END CASE.
     4140       define variable v-ref-list as character no-undo .
     4141       define buffer buf_prop-ref for ub.prop-ref.
     4142       define buffer buf_dis-card-type for ub.dis-card-type.
     4143       find first buf_dis-card-type no-lock where
     4144                 buf_Dis-card-type.type = p-type
     4145             and buf_Dis-card-type.emitent-host-code = p-emitent-host-code
     4146             and buf_Dis-card-type.host-code = 0
     4147             and buf_Dis-card-type.obj-type = '':U
     4148             and buf_Dis-card-type.obj-code = 0 .
     4149       run ref/proprefs.w (
     4150                       input parparentproc
     4151                     ,input 'b-sel'
     4152                     ,input "dtm-code"
     4153                     ,input dtm-option
     4154                     ,input '':U
     4155                     ,input buf_Dis-card-type.uniq-key-rec
     4156                     ,input-output  v-ref-list) no-error.
     4157       find first buf_prop-ref no-lock where
     4158                 recid(buf_prop-ref) = integer(v-ref-list) no-error .
     4159       if not available buf_prop-ref then return no-apply.
     4160       run temp-dc-prop-exist in this-procedure (
     4161                                                  input pard-card
     4162                                                 ,input v-host-code
     4163                                                 ,input v-obj-type
     4164                                                 ,input v-obj-code
     4165                                                 ,input dtm-option
     4166                                                 ,input node-code-option
     4167                                                 ,input buf_prop-ref.dt-code
     4168                                                 ,output loc#log)  no-error.
     4169       if error-status:error or loc#log then do:
     4170         if loc#log then do:
     4171           message
     4172           "Уже есть такое свойство"
     4173           view-as alert-box error .
     4174         end.
     4175         return error.
     4176       end.
     4177       assign
     4178       v-dtm-option = dtm-option
     4179       .
     4180       if node-code-option > 0 then do:
     4181         run discprop-initial in this-procedure (
     4182                                                 input  dtm-option
     4183                                                 ,input  node-code-option
     4184                                                 ,output v-value-character
     4185                                                 ,output v-value-date
     4186                                                 ,output v-value-decimal
     4187                                                 ,output v-value-integer
     4188                                                 ,output v-value-logical ) no-error .
     4189       if error-status:error then do:
     4190         message error-status:error error-status:get-message(1)  return-value
     4191         view-as alert-box error .
     4192         undo, return error .
     4193       end.
     4194      end.
     4195     end.
     4196     when no then do:
     4197       run discprop-node-code in this-procedure (
     4198                                        input TEMP-dis-card-property.dtm-code
     4199                                       ,input TEMP-dis-card-property.node-code
     4200                                       ,output v-data-type
     4201                                       ,output v-format
     4202                                       ,output v-label
     4203                                       ,output v-range
     4204                                       ,output v-rw-option
     4205                                       ) no-error.
     4206       IF ERROR-STATUS:ERROR THEN DO:
     4207           message "Ошибка при определении названия и типа свойства дисконтной карты!"         "Обратитесь к администратору системы" skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     4208           return error.
     4209       END.
     4210       assign
     4211       v-value-character  = temp-dis-card-property.property-value-character
     4212       v-value-date       = temp-dis-card-property.property-value-date
     4213       v-value-decimal    = temp-dis-card-property.property-value-decimal
     4214       v-value-integer    = temp-dis-card-property.property-value-integer
     4215       v-value-logical    = temp-dis-card-property.property-value-logical
     4216       .
     4217     end.
     4218   END CASE.
     4219   if node-code-option > 0 then do:
     4220     IF index(v-rw-option, "W") > 0
     4221     Then DO:
     4222       case v-data-type:
     4223         when 'integer':U then do:
     4224           run gbl/d-integer.w (
     4225                 input ?
     4226                 ,input (
     4227                 'title=':u + substitute("Изменение свойства &1", v-label) + '\':u
     4228               + 'text1=':u  + v-label + '\':u
     4229               + 'format=' + v-format + '\':u
     4230               + 'fillin_row=2\':u
     4231               + 'fillin_col=4\':u
     4232               + 'fillin_width=20\':u
     4233               + 'fillin_height=1\':u
     4234               + 'max-chars=70\':u
     4235               + 'readonly=' + (if p-mode <> 'ИЗМЕНЕНИЕ':U then 'yes':u else 'no':u) + '\':u)
     4236               , input-output v-value-integer
     4237               , output v-ok
     4238                   ).
     4239               if not v-ok then return error.
     4240           assign
     4241           temp-dis-card-property.property-value-integer = v-value-integer.
     4242         end.
     4243         when 'decimal':U then do:
     4244           run gbl/d-decimal.w (
     4245                 input ?
     4246                 ,input (
     4247                 'title=':u + substitute("Изменение свойства &1", v-label) + '\':u
     4248               + 'text1=':u  + v-label + '\':u
     4249               + 'format=' + v-format + '\':u
     4250               + 'fillin_row=2\':u
     4251               + 'fillin_col=4\':u
     4252               + 'fillin_width=20\':u
     4253               + 'fillin_height=1\':u
     4254               + 'max-chars=70\':u
     4255               + 'readonly=' + (if p-mode <> 'ИЗМЕНЕНИЕ':U then 'yes':u else 'no':u) + '\':u)
     4256               , input-output v-value-integer
     4257               , output v-ok
     4258                   ).
     4259               if not v-ok then return error.
     4260           assign
     4261           temp-dis-card-property.property-value-decimal = v-value-decimal.
     4262         end.
     4263         when 'character':U then do:
     4264           run gbl/d-character.w (
     4265                 input ?
     4266                 ,input (
     4267                 'title=':u + substitute("Изменение свойства &1", v-label) + '\':u
     4268               + 'text1=':u + v-label + '\':u
     4269               + 'format=' + v-format + '\':u
     4270               + 'fillin_row=2\':u
     4271               + 'fillin_col=4\':u
     4272               + 'fillin_width=20\':u
     4273               + 'fillin_height=1\':u
     4274               + 'max-chars=70\':u
     4275               + 'readonly=' + (if p-mode <> 'ИЗМЕНЕНИЕ':U then 'yes':u else 'no':u) + '\':u)
     4276               , input-output v-value-character
     4277               , output v-ok
     4278                   ).
     4279               if not v-ok then return error.
     4280           assign
     4281           temp-dis-card-property.property-value-character = v-value-character.
     4282         end.
     4283         when 'logical':U then do:
     4284           run gbl/d-logical.w (
     4285                 input ?
     4286                 ,input ('title=':u + substitute("Изменение свойства &1", v-label) + '\':u
     4287               + 'text1=':u + v-label + '\':u
     4288               + 'format=' + v-format + '\':u
     4289               + 'fillin_row=2\':u
     4290               + 'fillin_col=4\':u
     4291               + 'fillin_width=20\':u
     4292               + 'fillin_height=1\':u
     4293               + 'max-chars=70\':u
     4294               + 'readonly=' + (if p-mode <> 'ИЗМЕНЕНИЕ':U then 'yes':u else 'no':u) + '\':u)
     4295               , input-output v-value-logical
     4296               , output v-ok
     4297                   ).
     4298               if not v-ok then return error.
     4299           assign
     4300           temp-dis-card-property.property-value-logical = v-value-logical.
     4301         end.
     4302       end case.
     4303     end.
     4304     Else do:
     4305       message "Изменение свойства невозможно !" view-as alert-box error.
     4306       return error.
     4307     end.
     4308     run temp-dc-prop-write in this-procedure (
     4309                     input pard-card
     4310                     ,input (if p-add then v-host-code else temp-dis-card-property.host-code)
     4311                     ,input (if p-add then v-obj-type else temp-dis-card-property.OBJ-TYPE)
     4312                     ,input (if p-add then v-obj-code else temp-dis-card-property.obj-code)
     4313                     ,input (if p-add then dtm-option else  temp-dis-card-property.dtm-code)
     4314                     ,input (if p-add then node-code-option else  temp-dis-card-property.node-code)
     4315                     ,input (if p-add then buf_prop-ref.dt-code else  temp-dis-card-property.dt-code)
     4316                     ,input (if p-add then buf_prop-ref.sum-id else  temp-dis-card-property.sum-id)
     4317                     ,input property-value-character
     4318                     ,input property-value-date
     4319                     ,input property-value-decimal
     4320                     ,input property-value-integer
     4321                     ,input property-value-logical
     4322                     ) no-error.
     4323     IF not error-status:error then do:
     4324       assign
     4325       updated = yes
     4326       .
     4327       br-prop:refresh() in frame Dialog-Frame no-error .
     4328     END.
     4329     else do:
     4330       message
     4331       substitute("Ошибка при сохранении свойства ДК&1" +
     4332                   "ДК &2&1" +
     4333                   "Свойство  &3.&4 &5"
     4334                   , chr(10)
     4335                   , pard-card
     4336                   ,(if p-add then dtm-option else  temp-dis-card-property.dtm-code)
     4337                   ,(if p-add then node-code-option else  temp-dis-card-property.node-code)
     4338                   ,(if p-add then buf_prop-ref.sum-id else  temp-dis-card-property.sum-id)
     4339                   )
     4340       return-value view-as alert-box .
     4341       return error .
     4342     end.
     4343   end.
     4344   else do:
     4345     find first buf_attr-prop no-lock where
     4346               buf_attr-prop.table-name = 'dis-card-property':U
     4347           and buf_attr-prop.templ-rl-root = (if p-add then dtm-option else temp-dis-card-property.dtm-code)
     4348           and buf_attr-prop.upper-prop-code = "InputForm":U
     4349           and buf_attr-prop.prop-code = "FormName":U no-error.
     4350     if not available buf_attr-prop then do:
     4351     end.
     4352     else do:
     4353        run value ( buf_attr-prop.property-value) (
     4354                                                  INPUT parparentproc
     4355                                                 ,INPUT (if p-add then 'ДОБАВЛЕНИЕ':U else 'ИЗМЕНЕНИЕ':U)
     4356                                                 ,INPUT (if p-add then dtm-option else temp-dis-card-property.dtm-code)
     4357                                                 ,INPUT (if p-add then buf_prop-ref.sum-id else temp-dis-card-property.sum-id)
     4358                                                 ,INPUT (if p-add then buf_prop-ref.dt-code else temp-dis-card-property.dt-code)
     4359                                                 ,INPUT (if p-add then 0 else temp-dis-card-property.node-code)
     4360                                                 ,INPUT p-emitent-host-code
     4361                                                 ,INPUT p-type
     4362                                                 ,INPUT pard-card
     4363                                                 ,INPUT (if p-add then v-host-code else temp-dis-card-property.host-code)
     4364                                                 ,INPUT (if p-add then v-obj-type else temp-dis-card-property.obj-type)
     4365                                                 ,INPUT (if p-add then v-obj-code else temp-dis-card-property.obj-code)
     4366                                                 ,INPUT-OUTPUT TABLE temp-dis-card-property
     4367                                                 ,OUTPUT v-ok
     4368                                                   ) no-error .
     4369         IF not error-status:error then do:
     4370           if v-ok then do:
     4371             assign
     4372             updated = yes
     4373             .
     4374             br-prop:refresh() in frame Dialog-Frame no-error .
     4375           end.
     4376         END.
     4377         else do:
     4378           message
     4379           substitute("Ошибка при сохранении свойства ДК&1" +
     4380                       "ДК &2&1" +
     4381                       "Свойство  &3 срез &4"
     4382                       , chr(10)
     4383                       , pard-card
     4384                       ,(if p-add then dtm-option else  temp-dis-card-property.dtm-code)
     4385                       ,(if p-add then buf_prop-ref.sum-id else  temp-dis-card-property.sum-id)
     4386                       )
     4387           return-value view-as alert-box .
     4388           return error .
     4389         end.
     4390     end.
     4391   end.
     4392   END PROCEDURE.
     4393   PROCEDURE proc-b-lkp :
     4394   define variable v-type as character no-undo .
     4395   define variable v-format as character no-undo .
     4396   define variable v-label as character no-undo .
     4397   define variable v-rw-option as character no-undo .
     4398   define variable property-value-character as character no-undo .
     4399   define variable property-value-date as date no-undo .
     4400   define variable property-value-decimal as decimal no-undo .
     4401   define variable property-value-integer as integer no-undo .
     4402   define variable property-value-logical as logical no-undo .
     4403   define variable v-range as integer no-undo .
     4404   define variable v-run-name as character no-undo .
     4405   define variable jj as integer no-undo .
     4406   define variable v-ok as logical no-undo .
     4407   define buffer buf_attr-prop for ub.attr-prop.
     4408     run discprop-node-code (
     4409                          input temp-dis-card-property.dtm-code
     4410                         ,input temp-dis-card-property.node-code
     4411                         ,output v-type
     4412                         ,output v-format
     4413                         ,output v-label
     4414                         ,output v-range
     4415                         ,output v-rw-option
     4416                         ) NO-ERROR.
     4417   IF ERROR-STATUS:ERROR THEN DO:
     4418       message "Ошибка при определении названия и типа свойства дисконтной карты!"         "Обратитесь к администратору системы" skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     4419       return error.
     4420   END.
     4421   find first buf_attr-prop no-lock where
     4422             buf_attr-prop.table-name = 'dis-card-property':U
     4423         and buf_attr-prop.templ-rl-root = temp-dis-card-property.dtm-code
     4424         and buf_attr-prop.upper-prop-code = "InputForm":U
     4425         and buf_attr-prop.prop-code = "FormName":U no-error.
     4426   if not available buf_attr-prop then do:
     4427   end.
     4428   else do:
     4429     run value ( buf_attr-prop.property-value) (
     4430                                              INPUT parparentproc
     4431                                             ,INPUT 'ПРОСМОТР':U
     4432                                             ,INPUT temp-dis-card-property.dtm-code
     4433                                             ,INPUT temp-dis-card-property.sum-id
     4434                                             ,INPUT temp-dis-card-property.dt-code
     4435                                             ,INPUT temp-dis-card-property.node-code
     4436                                             ,INPUT p-emitent-host-code
     4437                                             ,INPUT p-type
     4438                                             ,INPUT pard-card
     4439                                             ,INPUT temp-dis-card-property.host-code
     4440                                             ,INPUT temp-dis-card-property.obj-type
     4441                                             ,INPUT temp-dis-card-property.obj-code
     4442                                             ,INPUT-OUTPUT TABLE temp-dis-card-property
     4443                                             ,OUTPUT v-ok
     4444                                               ) no-error .
     4445     apply "entry" to br-prop in frame Dialog-Frame .
     4446   end.
     4447   END PROCEDURE.
     4448   PROCEDURE proc-save :
     4449   DEFINE VARIABLE v-updated AS LOGICAL NO-UNDO.
     4450   define variable v-created as logical no-undo .
     4451   define variable v-deleted as logical no-undo .
     4452   define variable v-updated-str as character no-undo .
     4453   define variable v-type as character no-undo .
     4454   define variable v-issue-host-code like ub.sysconf.host-code no-undo .
     4455   define variable v-chip-num as integer no-undo init 0.
     4456   define variable v-corr-date as date init ?.
     4457   define variable v-corr-time as integer no-undo init ?.
     4458   for each temp-dis-card-property NO-LOCK
     4459   break
     4460   by temp-dis-card-property.dt-code
     4461   :
     4462      find first tt0-dis-card-property NO-LOCK WHERE
     4463             tt0-dis-card-property.d-card = temp-dis-card-property.d-card
     4464       AND   tt0-dis-card-property.host-code = temp-dis-card-property.host-code
     4465       AND   tt0-dis-card-property.obj-type = temp-dis-card-property.obj-type
     4466       AND   tt0-dis-card-property.obj-code = temp-dis-card-property.obj-code
     4467       AND   tt0-dis-card-property.node-code = temp-dis-card-property.node-code
     4468       AND   tt0-dis-card-property.dt-code = temp-dis-card-property.dt-code  no-error.
     4469     assign
     4470     v-updated = no.
     4471     if available  tt0-dis-card-property then do:
     4472       BUFFER-COMPARE temp-dis-card-property
     4473       except card-num main-card first-card first-main-card
     4474       TO tt0-dis-card-property
     4475       case-sensitive
     4476       SAVE result IN v-updated-str.
     4477       assign
     4478       v-created = yes
     4479       v-updated = (v-updated-str <> "":U)
     4480       .
     4481     end.
     4482     else do:
     4483       assign
     4484       v-updated = yes.
     4485     end.
     4486     if v-updated then do:
     4487       CASE p-update-instantly:
     4488         when no then do:
     4489           run tt0-dc-prop-write in this-procedure(
     4490                                                      input PARd-card
     4491                                                     ,input temp-dis-card-property.host-code
     4492                                                     ,input temp-dis-card-property.obj-type
     4493                                                     ,input temp-dis-card-property.obj-code
     4494                                                     ,input temp-dis-card-property.dtm-code
     4495                                                     ,input temp-dis-card-property.node-code
     4496                                                     ,input temp-dis-card-property.dt-code
     4497                                                     ,input temp-dis-card-property.sum-id
     4498                                                     ,input temp-dis-card-property.property-value-character
     4499                                                     ,input temp-dis-card-property.property-value-date
     4500                                                     ,input temp-dis-card-property.property-value-decimal
     4501                                                     ,input temp-dis-card-property.property-value-integer
     4502                                                     ,input temp-dis-card-property.property-value-logical
     4503                                                     )  no-error.
     4504           if error-status:error then do:
     4505             message
     4506             substitute("Ошибка при сохранении свойства ДК&1" +
     4507                        "ДК &2&1" +
     4508                        "Свойство &3.&4 срез &5" +
     4509                        "&6&1&7"
     4510                       ,chr(10)
     4511                       ,pard-card
     4512                       ,temp-dis-card-property.dtm-code
     4513                       ,temp-dis-card-property.node-code
     4514                       ,temp-dis-card-property.dt-code
     4515                       ,error-status:get-message(1)
     4516                       ,return-value
     4517                       )
     4518             view-as alert-box  error .
     4519             undo, return error  .
     4520           end.
     4521           updated = yes.
     4522         end.
     4523         when yes then do:
     4524           if first-of(temp-dis-card-property.dt-code) then do:
     4525             assign
     4526             v-chip-num = 0
     4527             v-corr-date = ?
     4528             v-corr-time = ?
     4529             .
     4530           end.
     4531           run discprop-write in this-procedure (
     4532                                                input PARd-card
     4533                                               ,input temp-dis-card-property.host-code
     4534                                               ,input temp-dis-card-property.obj-type
     4535                                               ,input temp-dis-card-property.obj-code
     4536                                               ,input temp-dis-card-property.dtm-code
     4537                                               ,input temp-dis-card-property.node-code
     4538                                               ,input temp-dis-card-property.dt-code
     4539                                               ,input temp-dis-card-property.sum-id
     4540                                               ,input temp-dis-card-property.property-value-character
     4541                                               ,input temp-dis-card-property.property-value-date
     4542                                               ,input temp-dis-card-property.property-value-decimal
     4543                                               ,input temp-dis-card-property.property-value-integer
     4544                                               ,input temp-dis-card-property.property-value-logical
     4545                                               ,input '':U
     4546                                               ,input '':U
     4547                                               ,input-output v-chip-num
     4548                                               ,input-output v-corr-date
     4549                                               ,input-output v-corr-time
     4550                                               )  no-error.
     4551           if error-status:error then do:
     4552             message
     4553             substitute("Ошибка при сохранении свойства ДК&1" +
     4554                        "ДК &2&1"  +
     4555                        "Свойство &3.&4 срез &5" +
     4556                        "&6&1&7"
     4557                       ,chr(10)
     4558                       ,pard-card
     4559                       ,temp-dis-card-property.dtm-code
     4560                       ,temp-dis-card-property.node-code
     4561                       ,temp-dis-card-property.dt-code
     4562                       ,error-status:get-message(1)
     4563                       ,return-value
     4564                       )
     4565             view-as alert-box error .
     4566             undo, return error  .
     4567           end.
     4568           updated = yes.
     4569         end.
     4570       END CASE.
     4571     end.
     4572     ASSIGN
     4573     p-updated = v-updated OR p-updated.
     4574   End.
     4575   FOR EACH tt0-dis-card-property
     4576   break by tt0-dis-card-property.dt-code
     4577   :
     4578     if first-of(tt0-dis-card-property.dt-code) then do:
     4579       assign
     4580       v-chip-num = 0
     4581       v-corr-date = ?
     4582       v-corr-time = ?
     4583       .
     4584     end.
     4585     FIND FIRST temp-dis-card-property NO-LOCK WHERE
     4586               temp-dis-card-property.d-card = tt0-dis-card-property.d-card
     4587           AND temp-dis-card-property.host-code = tt0-dis-card-property.host-code
     4588           AND temp-dis-card-property.obj-type = tt0-dis-card-property.obj-type
     4589           AND temp-dis-card-property.obj-code = tt0-dis-card-property.obj-code
     4590           AND temp-dis-card-property.dtm-code = tt0-dis-card-property.dtm-code
     4591           AND temp-dis-card-property.node-code = tt0-dis-card-property.node-code
     4592           AND temp-dis-card-property.dt-code = tt0-dis-card-property.dt-code    NO-ERROR.
     4593       IF NOT AVAILABLE temp-dis-card-property THEN DO:
     4594         CASE p-update-instantly:
     4595           when no then do:
     4596             DELETE tt0-dis-card-property.
     4597             assign
     4598             v-deleted = yes.
     4599           end.
     4600           when yes then do:
     4601             v-deleted = no.
     4602             run discprop-delete in this-procedure(
     4603                                                    input PARd-card
     4604                                                   ,input tt0-dis-card-property.host-code
     4605                                                   ,input tt0-dis-card-property.OBJ-TYPE
     4606                                                   ,input tt0-dis-card-property.obj-code
     4607                                                   ,input tt0-dis-card-property.dtm-code
     4608                                                   ,input tt0-dis-card-property.node-code
     4609                                                   ,input tt0-dis-card-property.dt-code
     4610                                                   ,input '':U
     4611                                                   ,input '':U
     4612                                                   ,output v-deleted
     4613                                                   ,input-output v-chip-num
     4614                                                   ,input-output v-corr-date
     4615                                                   ,input-output v-corr-time
     4616                                                   ) no-error   .
     4617             if error-status:error or not v-deleted then do:
     4618               message
     4619               substitute("Ошибка при удалении свойства ДК&1" +
     4620                          "ДК &2&1" +
     4621                          "Свойство &3.&4 срез &5"
     4622                         ,chr(10)
     4623                         ,pard-card
     4624                         ,tt0-dis-card-property.dtm-code
     4625                         ,tt0-dis-card-property.node-code
     4626                         ,tt0-dis-card-property.dt-code
     4627                       ,error-status:get-message(1)
     4628                       ,return-value
     4629                         )
     4630               return-value view-as alert-box .
     4631               undo, return error.
     4632             end.
     4633           end.
     4634         END CASE.
     4635         ASSIGN
     4636         p-updated = (v-deleted OR p-updated).
     4637       END.
     4638   END.
     4639   if can-find(first dcp-list) then do:
     4640     run str/diallog.w (
     4641                     input parparentproc
     4642                   , input this-procedure
     4643                   , input 'str/sendclia.p':U
     4644                   , input(string(g#db-num) + chr(4) + "shop=" + string(locked_Dis-card.issue-code) + chr(4) + "no":U + chr(4) + "E":U)
     4645                   , input yes
     4646                   , input '':U
     4647                   , input 'Отправка информации по клиентским картам на кассу ЭКСПОРТА') no-error .
     4648   end.
     4649   END PROCEDURE.
     4650   PROCEDURE set-row-color :
     4651   DEFINE INPUT PARAMETER p-data-type AS CHARACTER NO-UNDO.
     4652   ASSIGN
     4653   v-ch[1]:FGCOLOR = GREY_COLOR
     4654   v-ch[1]:BGCOLOR = GREY_Color
     4655   v-ch[1]:PFCOLOR = GREY_Color
     4656   v-ch[2]:FGCOLOR = GREY_COLOR
     4657   v-ch[2]:BGCOLOR = GREY_Color
     4658   v-ch[2]:PFCOLOR = GREY_Color
     4659   v-ch[3]:FGCOLOR = GREY_COLOR
     4660   v-ch[3]:BGCOLOR = GREY_Color
     4661   v-ch[3]:PFCOLOR = GREY_Color
     4662   v-ch[4]:FGCOLOR = GREY_COLOR
     4663   v-ch[4]:BGCOLOR = GREY_Color
     4664   v-ch[4]:PFCOLOR = GREY_Color
     4665   v-ch[5]:FGCOLOR = GREY_COLOR
     4666   v-ch[5]:BGCOLOR = GREY_Color
     4667   v-ch[5]:PFCOLOR = GREY_Color
     4668   .
     4669   CASE entry(1, p-data-type):
     4670        WHEN 'character':U THEN DO:
     4671         ASSIGN
     4672         v-ch[1]:FGCOLOR = BLACK_COLOR
     4673         v-ch[1]:BGCOLOR = WHITE_Color.
     4674       END.
     4675       WHEN 'decimal':U THEN DO:
     4676         ASSIGN
     4677         v-ch[3]:FGCOLOR = BLACK_COLOR
     4678         v-ch[3]:BGCOLOR = WHITE_Color.
     4679       END.
     4680       WHEN 'integer':U THEN DO:
     4681         ASSIGN
     4682         v-ch[4]:FGCOLOR = BLACK_COLOR
     4683         v-ch[4]:BGCOLOR = WHITE_Color.
     4684       END.
     4685       WHEN 'date':U THEN DO:
     4686         ASSIGN
     4687         v-ch[2]:FGCOLOR = BLACK_COLOR
     4688         v-ch[2]:BGCOLOR = WHITE_Color.
     4689        END.
     4690        WHEN 'logical':U THEN DO:
     4691          ASSIGN
     4692          v-ch[5]:FGCOLOR = BLACK_COLOR
     4693          v-ch[5]:BGCOLOR = WHITE_Color.
     4694        END.
     4695   END CASE.
     4696   END PROCEDURE.
     4697   PROCEDURE temp-dc-prop-exist :
     4698   do
     4699     on error undo, return error
     4700     :
     4701       define input parameter p-d-card     like ub.dis-card-property.d-card     no-undo .
     4702       define input parameter p-host-code  like ub.dis-card-property.host-code  no-undo .
     4703       define input parameter p-obj-type   like ub.dis-card-property.obj-type   no-undo .
     4704       define input parameter p-obj-code   like ub.dis-card-property.obj-code   no-undo .
     4705       define input parameter p-dtm-code   like ub.dis-card-property.dtm-code  no-undo .
     4706       define input parameter p-node-code  like ub.dis-card-property.node-code  no-undo .
     4707       define input parameter p-dt-code    like ub.dis-card-property.dt-code  no-undo .
     4708       define output parameter p-exist      as logical  no-undo .
     4709       define buffer buf_temp-dis-card-property for temp-dis-card-property .
     4710       define variable v-type           as character no-undo .
     4711       define variable v-format         as character no-undo .
     4712       define variable v-label          as character no-undo .
     4713       define variable V-RANGE          as integer   no-undo .
     4714       define variable v-rw-option      as character no-undo .
     4715       run discprop-node-code in this-procedure (
     4716          input  p-dtm-code
     4717         ,input  p-node-code
     4718         ,output v-type
     4719         ,output v-format
     4720         ,output v-label
     4721         ,OUTPUT V-RANGE
     4722         ,output v-rw-option
     4723         ) no-error .
     4724       if error-status :error then do:
     4725         undo, return error return-value .
     4726       end.
     4727       find first buf_temp-dis-card-property no-lock
     4728         where buf_temp-dis-card-property.d-card    = p-d-card
     4729           and buf_temp-dis-card-property.host-code = p-host-code
     4730           and buf_temp-dis-card-property.obj-type  = p-obj-type
     4731           and buf_temp-dis-card-property.obj-code  = p-obj-code
     4732           and buf_temp-dis-card-property.dtm-code = p-dtm-code
     4733           and buf_temp-dis-card-property.node-code = p-node-code
     4734           and buf_temp-dis-card-property.dt-code = p-dt-code
     4735         no-error .
     4736       if  available buf_temp-dis-card-property then do:
     4737         p-exist = yes.
     4738       end.
     4739     end.
     4740   END PROCEDURE.
     4741   PROCEDURE temp-dc-prop-write :
     4742   do
     4743     on error undo, return error
     4744     :
     4745       define input parameter p-d-card    like ub.dis-card-property.d-card     no-undo .
     4746       define input parameter p-host-code like ub.dis-card-property.host-code  no-undo .
     4747       define input parameter p-obj-type  like ub.dis-card-property.obj-type   no-undo .
     4748       define input parameter p-obj-code  like ub.dis-card-property.obj-code   no-undo .
     4749       define input parameter p-dtm-code  like ub.dis-card-property.dtm-code   no-undo .
     4750       define input parameter p-node-code like ub.dis-card-property.node-code  no-undo .
     4751       define input parameter p-dt-code   like ub.dis-card-property.dt-code    no-undo .
     4752       define input parameter p-sum-id    like ub.dis-card-property.sum-id     no-undo .
     4753       define input parameter p-value-character like ub.dis-card-property.property-value-character no-undo .
     4754       define input parameter p-value-date      like ub.dis-card-property.property-value-date no-undo .
     4755       define input parameter p-value-decimal   like ub.dis-card-property.property-value-decimal no-undo .
     4756       define input parameter p-value-integer   like ub.dis-card-property.property-value-integer no-undo .
     4757       define input parameter p-value-logical   like ub.dis-card-property.property-value-logical no-undo .
     4758       define buffer buf_temp-dis-card-property for temp-dis-card-property .
     4759       define buffer buf_dis-card for ub.dis-card.
     4760       define variable v-type           as character no-undo .
     4761       define variable v-format         as character no-undo .
     4762       define variable v-label          as character no-undo .
     4763       define variable v-range          as integer   no-undo .
     4764       define variable v-rw-option      as character no-undo .
     4765       run discprop-node-code in this-procedure (
     4766          input  p-dtm-code
     4767         ,input  p-node-code
     4768         ,output v-type
     4769         ,output v-format
     4770         ,output v-label
     4771         ,output v-range
     4772         ,output v-rw-option
     4773         ) no-error .
     4774       if error-status :error then do:
     4775         undo, return error return-value .
     4776       end.
     4777       if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
     4778         run discprop-check in this-procedure  (
     4779                          input v-range
     4780                         ,input p-d-card
     4781                         ,input p-host-code
     4782                         ,input p-obj-type
     4783                         ,input p-obj-code
     4784                         ,input p-dtm-code
     4785                         ,input p-node-code
     4786                         ,input p-dt-code
     4787                       ) no-error .
     4788         if error-status:error then undo,  return error return-value .
     4789       end.
     4790       find first buf_temp-dis-card-property exclusive-lock
     4791         where buf_temp-dis-card-property.d-card    = p-d-card
     4792           and buf_temp-dis-card-property.host-code = p-host-code
     4793           and buf_temp-dis-card-property.obj-type  = p-obj-type
     4794           and buf_temp-dis-card-property.obj-code  = p-obj-code
     4795           and buf_temp-dis-card-property.dtm-code = p-dtm-code
     4796           and buf_temp-dis-card-property.node-code = p-node-code
     4797           and buf_temp-dis-card-property.dt-code = p-dt-code
     4798         no-error .
     4799       if not available buf_temp-dis-card-property then do:
     4800         create buf_temp-dis-card-property .
     4801         assign
     4802         buf_temp-dis-card-property.d-card    = p-d-card
     4803         buf_temp-dis-card-property.host-code = p-host-code
     4804         buf_temp-dis-card-property.obj-type  = p-obj-type
     4805         buf_temp-dis-card-property.obj-code  = p-obj-code
     4806         buf_temp-dis-card-property.dtm-code = p-dtm-code
     4807         buf_temp-dis-card-property.dt-code = p-dt-code
     4808         buf_temp-dis-card-property.sum-id = p-sum-id
     4809         buf_temp-dis-card-property.node-code = p-node-code
     4810         buf_temp-dis-card-property.node-label = v-label
     4811         buf_temp-dis-card-property.card-num  = 0
     4812         .
     4813       end.
     4814       else do:
     4815         if (v-type = 'character':U
     4816         and buf_temp-dis-card-property.property-value-character = p-value-character)
     4817         or  (v-type = 'date':U
     4818             and buf_temp-dis-card-property.property-value-date = p-value-date)
     4819         or  (v-type = 'decimal':U
     4820             and buf_temp-dis-card-property.property-value-decimal = p-value-decimal)
     4821         or  (v-type = 'integer':U
     4822             and buf_temp-dis-card-property.property-value-integer = p-value-integer)
     4823         or  (v-type = 'logical':U
     4824             and buf_temp-dis-card-property.property-value-logical = p-value-logical)
     4825         then return.
     4826       end.
     4827       assign
     4828       buf_temp-dis-card-property.property-value-character = p-value-character
     4829       buf_temp-dis-card-property.property-value-date = p-value-date
     4830       buf_temp-dis-card-property.property-value-decimal = p-value-decimal
     4831       buf_temp-dis-card-property.property-value-integer = p-value-integer
     4832       buf_temp-dis-card-property.property-value-logical = p-value-logical
     4833       .
     4834       release buf_temp-dis-card-property no-error .
     4835       if error-status:error then do:
     4836         return error return-value .
     4837       end.
     4838     end.
     4839   END PROCEDURE.
     4840   PROCEDURE tt0-dc-prop-write :
     4841   do
     4842     on error undo, return error
     4843     :
     4844       define input parameter p-d-card          like ub.dis-card-property.d-card     no-undo .
     4845       define input parameter p-host-code       like ub.dis-card-property.host-code  no-undo .
     4846       define input parameter p-obj-type        like ub.dis-card-property.obj-type   no-undo .
     4847       define input parameter p-obj-code        like ub.dis-card-property.obj-code   no-undo .
     4848       define input parameter p-dtm-code        like ub.dis-card-property.dtm-code  no-undo .
     4849       define input parameter p-node-code       like ub.dis-card-property.node-code  no-undo .
     4850       define input parameter p-dt-code         like ub.dis-card-property.dt-code  no-undo .
     4851       define input parameter p-sum-id          like ub.dis-card-property.sum-id  no-undo .
     4852       define input parameter p-value-character like ub.dis-card-property.property-value-character no-undo .
     4853       define input parameter p-value-date      like ub.dis-card-property.property-value-date no-undo .
