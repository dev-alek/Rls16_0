     1238   procedure disproph_send-nws :
     1239   define parameter buffer buf_c-dis-card-property for ub.c-dis-card-property.
     1240   define parameter buffer buf_c-dc-hist for ub.c-dc-hist.
     1241   define parameter buffer buf_Dis-card for ub.dis-card.
     1242   define variable v-dh-hn as integer no-undo .
     1243   main-block:
     1244   do
     1245   on error undo, return error return-value
     1246   :
     1247     if g#news
     1248     and g#db-num > 0
     1249     and buf_c-dis-card-property.corr-user-db-num <> g#db-num
     1250     then return.
     1251     if g#db-num = 0
     1252     or (g#news
     1253         and g#db-num > 0
     1254         and buf_c-dis-card-property.corr-user-name = (chr(4) +  'СПН':U)
     1255         )
     1256     then do:
     1257       if not available buf_dis-card then do:
     1258         find first buf_dis-card no-lock where
     1259                   buf_Dis-card.d-card = buf_c-dis-card-property.d-card no-error.
     1260       end.
     1261       if not available buf_dis-card then do:
     1262         assign
     1263         v-dh-hn = integer('0':U).
     1264       end.
     1265       else do:
     1266   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1267   if (valid-handle(g#lib-nws) <> true) then do:   run nws/lib-nws.p persistent no-error .   if error-status :error or (valid-handle(g#lib-nws) <> true) then do:     message       "Error starting nws/lib-nws.p" skip       g#lib-nws skip       g#lib-nws :type skip       g#lib-nws :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-nws_get-hn-option in g#lib-nws
     1268     (input  g#db-num
     1269     ,input  'dis-card-property':U
     1270     ,input  0
     1271     ,input  '':U
     1272     ,input  0
     1273     ,input  buf_dis-card.type
     1274     ,input  '':U
     1275     ,input  '':U
     1276     ,input  buf_dis-card.emitent-host-code
     1277     ,input  (if buf_c-dis-card-property.dt-code > 0 then 0 else -1)
     1278     ,input  0
     1279     ,input  'hist-to-nws'
     1280     ,output v-dh-hn
     1281     ) no-error .
     1282       end.
     1283       if v-dh-hn >= 0 then do:
     1284         run str/callnews.p (
     1285           input 'c-dis-card-property':U
     1286           ,input (buffer buf_c-dis-card-property:handle)
     1287           ) no-error .
     1288         if error-status:error then do:
     1289           undo main-block,  return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) ).
     1290         end.
     1291         if available buf_c-dc-hist then do:
     1292           run str/callnews.p (
     1293             input 'c-dc-hist':U
     1294             ,input (buffer buf_c-dc-hist:handle)
     1295             ) no-error .
     1296           if error-status:error then do:
     1297             undo main-block,  return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1) ).
     1298           end.
     1299         end.
     1300       end.
     1301     end.
     1302   end.
     1303   end procedure.
     1304   procedure discprop-node-code :
     1305   define input parameter p-dtm-code as integer no-undo .
     1306   define input parameter p-node-code as integer no-undo .
     1307   define output parameter p-data-type as character no-undo .
     1308   define output parameter p-format as character no-undo .
     1309   define output parameter p-label as character no-undo .
     1310   define output parameter p-range as integer no-undo .
     1311   define output parameter p-rw-option as character no-undo .
     1312   define buffer buf_prop-map for ub.prop-map.
     1313   define buffer buf_prop-head for ub.prop-head.
     1314   do
     1315   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1316   :
     1317   find first buf_prop-head no-lock where
     1318             buf_prop-head.dtm-code = p-dtm-code no-error .
     1319   if available buf_prop-head then do:
     1320     if p-node-code > 0 then do:
     1321       find first buf_prop-map no-lock where
     1322                 buf_prop-map.dtm-code = p-dtm-code
     1323             and buf_prop-map.node-code = p-node-code no-error .
     1324       if available buf_prop-map then do:
     1325         assign
     1326         p-data-type = buf_prop-map.node-value-type
     1327         p-format = buf_prop-map.node-format
     1328         p-label = buf_prop-map.node-label
     1329         p-rw-option = buf_prop-map.rw-option
     1330         .
     1331       end.
     1332     end.
     1333     if buf_prop-head.storage-place  = "":U
     1334     and buf_prop-head.storage-place-host  > "":U
     1335     and buf_prop-head.storage-place-obj  > "":U then do:
     1336       p-range =  12.
     1337     end.
     1338     if buf_prop-head.storage-place  > "":U
     1339     and buf_prop-head.storage-place-host  > "":U
     1340     and buf_prop-head.storage-place-obj  > "":U then do:
     1341       p-range =  3.
     1342     end.
     1343     if buf_prop-head.storage-place  > "":U
     1344     and buf_prop-head.storage-place-host  > "":U
     1345     and buf_prop-head.storage-place-obj  = "":U then do:
     1346       p-range =  2.
     1347     end.
     1348     if buf_prop-head.storage-place  = "":U
     1349     and buf_prop-head.storage-place-host  > "":U
     1350     and buf_prop-head.storage-place-obj  = "":U then do:
     1351       p-range =  1.
     1352     end.
     1353     if buf_prop-head.storage-place  > "":U
     1354     and buf_prop-head.storage-place-host  = "":U
     1355     and buf_prop-head.storage-place-obj  = "":U then do:
     1356       p-range =  0.
     1357     end.
     1358   end.
     1359   end.
     1360   end procedure.
     1361   procedure discprop-initial:
     1362   define input parameter p-dtm-code as integer no-undo .
     1363   define input parameter p-node-code as integer no-undo .
     1364   define output parameter p-init-value-character as character no-undo .
     1365   define output parameter p-init-value-date as date no-undo .
     1366   define output parameter p-init-value-decimal as decimal no-undo .
     1367   define output parameter p-init-value-integer as integer no-undo .
     1368   define output parameter p-init-value-logical as logical no-undo .
     1369   define buffer buf_prop-map for ub.prop-map.
     1370   find first buf_prop-map no-lock where
     1371             buf_prop-map.dtm-code = p-dtm-code
     1372         and buf_prop-map.node-code = p-node-code no-error.
     1373   if not available buf_prop-map then return error substitute("Не найдено свойство &1 для объекта &2"
     1374                                                               , p-node-code
     1375                                                               , p-dtm-code).
     1376   assign
     1377   p-init-value-character = buf_prop-map.init-value-character
     1378   p-init-value-date = buf_prop-map.init-value-date
     1379   p-init-value-decimal = buf_prop-map.init-value-decimal
     1380   p-init-value-integer = buf_prop-map.init-value-integer
     1381   p-init-value-logical = buf_prop-map.init-value-logical
     1382   .
     1383   end procedure.
     1384   Function discprop-usercanedit returns logical (  input p-dtm-code as integer, input p-db-num as integer):
     1385   define buffer buf_attr-prop for ub.attr-prop.
     1386   find first buf_attr-prop no-lock where
     1387             buf_attr-prop.table-name = 'dis-card-property':U
     1388         and buf_attr-prop.templ-rl-root = p-dtm-code
     1389         and buf_attr-prop.upper-prop-code = "UserCanEdit"
     1390         and buf_attr-prop.prop-code = (if p-db-num = 0 then 'DB0' else 'DBR':U) no-error.
     1391   if not available buf_attr-prop
     1392   or logical(buf_attr-prop.property-value) = no then do:
     1393     return no.
     1394   end.
     1395   return yes.
     1396   end function.
     1397   procedure discprop-edit :
     1398   define input parameter p-dtm-code-node-name as character no-undo .
     1399   define output parameter p-edit-menu-section-num as integer no-undo .
     1400   define buffer buf_attr-prop for ub.attr-prop.
     1401   do
     1402   on error undo, return error return-value
     1403   :
     1404     find first buf_attr-prop no-lock where
     1405             buf_attr-prop.table-name = 'dis-card-property':U
     1406        and  buf_attr-prop.templ-rl-root = integer(entry(1, p-dtm-code-node-name, chr(4)))
     1407        and  buf_attr-prop.upper-prop-code = "ManualEdit":U
     1408        and  buf_attr-prop.prop-code = "SectionNum":U no-error .
     1409     if available buf_attr-prop then do:
     1410       assign
     1411       p-edit-menu-section-num = integer(buf_attr-prop.property-value).
     1412     end.
     1413   end.
     1414   end procedure.
     1415   procedure discprop-node-name :
     1416   define input parameter p-dtm-code-node-name as character no-undo .
     1417   define output parameter p-tool-tip as character no-undo .
     1418   define output parameter p-node-label as character no-undo .
     1419   define buffer buf_prop-map for ub.prop-map.
     1420   define buffer buf_prop-head for ub.prop-head.
     1421   do
     1422   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1423   :
     1424     find first buf_prop-head no-lock where
     1425               buf_prop-head.dtm-code = integer(entry(1, p-dtm-code-node-name, chr(4) )) no-error .
     1426     assign
     1427     p-tool-tip   = if available buf_prop-head
     1428                    then buf_prop-head.prop-des
     1429                    else entry(1, p-dtm-code-node-name, chr(4) )
     1430     p-node-label = (if available buf_prop-head
     1431                     then buf_prop-head.prop-label
     1432                     else '':U)
     1433     .
     1434     if entry(2, p-dtm-code-node-name, chr(4) ) <> "" then do:
     1435       find first buf_prop-map no-lock where
     1436                 buf_prop-map.dtm-code = integer(entry(1, p-dtm-code-node-name, chr(4) ))
     1437           and  buf_prop-map.node-code = integer(entry(2, p-dtm-code-node-name, chr(4) )) no-error.
     1438       if available buf_prop-map then do:
     1439         assign
     1440         p-tool-tip   = buf_prop-map.node-description
     1441         p-node-label = (if available buf_prop-head
     1442                         then buf_prop-head.prop-label
     1443                         else '':U) + ":" + buf_prop-map.node-label
     1444         .
     1445       end.
     1446     end.
     1447   end.
     1448   end procedure.
     1449   procedure discprop-write :
     1450   define input parameter p-d-card          like ub.dis-card-property.d-card     no-undo .
     1451   define input parameter p-host-code       like ub.dis-card-property.host-code  no-undo .
     1452   define input parameter p-obj-type        like ub.dis-card-property.obj-type   no-undo .
     1453   define input parameter p-obj-code        like ub.dis-card-property.obj-code   no-undo .
     1454   define input parameter p-dtm-code        like ub.dis-card-property.dtm-code   no-undo .
     1455   define input parameter p-node-code       like ub.dis-card-property.node-code  no-undo .
     1456   define input parameter p-dt-code         like ub.dis-card-property.dt-code    no-undo .
     1457   define input parameter p-sum-id          like ub.dis-card-property.sum-id     no-undo .
     1458   define input parameter p-value-character like ub.dis-card-property.property-value-character no-undo .
     1459   define input parameter p-value-date      like ub.dis-card-property.property-value-date no-undo .
     1460   define input parameter p-value-decimal   like ub.dis-card-property.property-value-decimal no-undo .
     1461   define input parameter p-value-integer   like ub.dis-card-property.property-value-integer no-undo .
     1462   define input parameter p-value-logical   like ub.dis-card-property.property-value-logical no-undo .
     1463   define input parameter p-source-type     as character no-undo .
     1464   define input parameter p-source-ref      as character no-undo .
     1465   define input-output parameter p-chip-num as integer no-undo .
     1466   define input-output parameter p-corr-date as date no-undo .
     1467   define input-output parameter p-corr-time as integer no-undo .
     1468   do
     1469   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1470   :
     1471     define buffer buf_dis-card-property for ub.dis-card-property .
     1472     define buffer buf_dis-card for ub.dis-card.
     1473     define buffer buf_prop-ref for ub.prop-ref.
     1474     define variable v-data-type      as character no-undo .
     1475     define variable v-data-type-1    as character no-undo .
     1476     define variable v-format         as character no-undo .
     1477     define variable v-label          as character no-undo .
     1478     define variable v-range          as integer   no-undo .
     1479     define variable v-rw-option      as character no-undo .
     1480     run discprop-node-code in this-procedure
     1481       (
     1482        input  p-dtm-code
     1483       ,input  p-node-code
     1484       ,output v-data-type
     1485       ,output v-format
     1486       ,output v-label
     1487       ,output v-range
     1488       ,output v-rw-option
     1489       ) no-error .
     1490     if error-status :error then do:
     1491       undo, return error return-value .
     1492     end.
     1493     v-data-type-1 = entry(1, v-data-type).
     1494     if p-dt-code = ? then do:
     1495       find buf_prop-ref no-lock where
     1496           buf_prop-ref.dtm-code = p-dtm-code
     1497       and buf_prop-ref.sum-id = p-sum-id no-error.
     1498       if not available buf_prop-ref then do:
     1499         undo, return error substitute("Неопределен или неоднозначен ИТОГ/СРЕЗ для объекта-операнда &1 &2"
     1500                                       ,p-dtm-code
     1501                                       ,p-sum-id).
     1502       end.
     1503       assign
     1504       p-dt-code = buf_prop-ref.dt-code.
     1505     end.
     1506     if discprop-usercanedit ( input p-dtm-code, input g#db-num)  = no then do:
     1507       undo, return error "Нельзя редактировать свойство в данной БД".
     1508     end.
     1509     run discprop-check in this-procedure (
     1510                                             input v-range
     1511                                           ,input p-d-card
     1512                                           ,input p-host-code
     1513                                           ,input p-obj-type
     1514                                           ,input p-obj-code
     1515                                           ,input p-dtm-code
     1516                                           ,input p-node-code
     1517                                           ,input p-dt-code
     1518                                         ) no-error .
     1519     if error-status:error then undo,  return error return-value .
     1520     find first buf_dis-card-property exclusive-lock
     1521       where buf_dis-card-property.d-card    = p-d-card
     1522         and buf_dis-card-property.host-code = p-host-code
     1523         and buf_dis-card-property.obj-type  = p-obj-type
     1524         and buf_dis-card-property.obj-code  = p-obj-code
     1525         and buf_dis-card-property.dt-code = p-dt-code
     1526         and buf_dis-card-property.node-code = p-node-code
     1527       no-error .
     1528       find first buf_dis-card no-lock where
     1529                   buf_dis-card.d-card = p-d-card.
     1530     if not available buf_dis-card-property then do:
     1531       create buf_dis-card-property .
     1532       assign
     1533         buf_dis-card-property.d-card    = p-d-card
     1534         buf_dis-card-property.host-code = p-host-code
     1535         buf_dis-card-property.obj-type  = p-obj-type
     1536         buf_dis-card-property.obj-code  = p-obj-code
     1537         buf_dis-card-property.dt-code = p-dt-code
     1538         buf_dis-card-property.node-code = p-node-code
     1539         buf_dis-card-property.dtm-code = p-dtm-code
     1540         buf_dis-card-property.sum-id   = p-sum-id
     1541         buf_dis-card-property.card-num  = buf_dis-card.card-num
     1542         buf_dis-card-property.main-card  = buf_dis-card.main-card
     1543         buf_dis-card-property.first-card  = buf_dis-card.first-card
     1544         buf_dis-card-property.first-main-card  = buf_dis-card.first-main-card
     1545       .
     1546     end.
     1547     else do:
     1548       if (v-data-type-1 = 'character':U
     1549       and buf_dis-card-property.property-value-character = p-value-character)
     1550       or  (v-data-type-1 = 'date':U
     1551           and buf_dis-card-property.property-value-date = p-value-date)
     1552       or  (v-data-type-1 = 'decimal':U
     1553           and buf_dis-card-property.property-value-decimal = p-value-decimal)
     1554       or  (v-data-type-1 = 'integer':U
     1555           and buf_dis-card-property.property-value-integer = p-value-integer)
     1556       or  (v-data-type-1 = 'logical':U
     1557           and buf_dis-card-property.property-value-logical = p-value-logical)
     1558       then return.
     1559     end.
     1560     run disproph_write-dis-card-property-proc  in this-procedure (
     1561             buffer buf_dis-card-property
     1562             ,buffer Buf_dis-card
     1563             ,input p-d-card
     1564             ,input p-dt-code
     1565             ,input p-host-code
     1566             ,input p-obj-type
     1567             ,input p-obj-code
     1568             ,input p-dtm-code
     1569             ,input buf_dis-card.card-num
     1570             ,input buf_dis-card.main-card
     1571             ,input buf_dis-card.first-card
     1572             ,input buf_dis-card.first-main-card
     1573             ,input p-node-code
     1574             ,input (if new(buf_dis-card-property) then integer('1':U) else integer('2':U))
     1575             ,input p-source-type
     1576             ,input p-source-ref
     1577             ,input-output p-chip-num
     1578             ,input-output p-corr-date
     1579             ,input-output p-corr-time
     1580             ).
     1581     assign
     1582     buf_dis-card-property.property-value-character = (if v-data-type-1 = 'character':U
     1583                                                       then p-value-character
     1584                                                       else buf_dis-card-property.property-value-character)
     1585     buf_dis-card-property.property-value-date      = (if v-data-type-1 = 'date':U
     1586                                                       then p-value-date
     1587                                                       else buf_dis-card-property.property-value-date)
     1588     buf_dis-card-property.property-value-decimal   = (if v-data-type-1 = 'decimal':U
     1589                                                       then p-value-decimal
     1590                                                       else buf_dis-card-property.property-value-decimal)
     1591     buf_dis-card-property.property-value-integer   = (if v-data-type-1 = 'integer':U
     1592                                                       then p-value-integer
     1593                                                       else buf_dis-card-property.property-value-integer)
     1594     buf_dis-card-property.property-value-logical   = (if v-data-type-1 = 'logical':U
     1595                                                       then p-value-logical
     1596                                                       else buf_dis-card-property.property-value-logical)
     1597     buf_dis-card-property.trg-param = (if p-source-type = '':U then '':U else 'no-hist':U)
     1598     .
     1599     release buf_dis-card-property no-error .
     1600     if error-status:error then do:
     1601       return error return-value .
     1602     end.
     1603   end.
     1604   end procedure.
     1605   procedure discprop-delete :
     1606   define input parameter p-d-card    like ub.dis-card-property.d-card     no-undo .
     1607   define input parameter p-host-code like ub.dis-card-property.host-code  no-undo .
     1608   define input parameter p-obj-type  like ub.dis-card-property.obj-type   no-undo .
     1609   define input parameter p-obj-code  like ub.dis-card-property.obj-code   no-undo .
     1610   define input parameter p-dtm-code  like ub.dis-card-property.dtm-code   no-undo .
     1611   define input parameter p-node-code like ub.dis-card-property.node-code  no-undo .
     1612   define input parameter p-dt-code   like ub.dis-card-property.dt-code    no-undo .
     1613   define input parameter p-source-type as character no-undo .
     1614   define input parameter p-source-ref as character no-undo .
     1615   define output parameter p-deleted  as logical no-undo.
     1616   define input-output parameter p-chip-num as integer no-undo .
     1617   define input-output parameter p-corr-date as date no-undo .
     1618   define input-output parameter p-corr-time as integer no-undo .
     1619   do
     1620   on error undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1621   :
     1622   define buffer buf_dis-card-property for ub.dis-card-property .
     1623   define buffer buf_dis-card for ub.dis-card.
     1624   define variable v-data-type      as character no-undo .
     1625   define variable v-format         as character no-undo .
     1626   define variable v-label          as character no-undo .
     1627   define variable v-range          as integer   no-undo .
     1628   define variable v-rw-option      as character   no-undo .
     1629     run discprop-node-code in this-procedure
     1630       (input  p-dtm-code
     1631       ,input  p-node-code
     1632       ,output v-data-type
     1633       ,output v-format
     1634       ,output v-label
     1635       ,output v-range
     1636       ,output v-rw-option
     1637       ) no-error .
     1638     if error-status :error then do:
     1639       undo, return error return-value .
     1640     end.
     1641     find first buf_dis-card-property exclusive-lock
     1642       where buf_dis-card-property.d-card    = p-d-card
     1643         and buf_dis-card-property.host-code = p-host-code
     1644         and buf_dis-card-property.obj-type  = p-obj-type
     1645         and buf_dis-card-property.obj-code  = p-obj-code
     1646         and buf_dis-card-property.dt-code = p-dt-code
     1647         and buf_dis-card-property.node-code = p-node-code
     1648       no-error NO-WAIT.
     1649     if not available buf_dis-card-property then do:
     1650       p-deleted = no.
     1651     end.
     1652     else do:
     1653       run disproph_write-dis-card-property-proc  in this-procedure (
     1654            buffer buf_dis-card-property
     1655           ,buffer buf_dis-card
     1656           ,input buf_dis-card-property.d-card
     1657           ,input buf_dis-card-property.dt-code
     1658           ,input buf_dis-card-property.host-code
     1659           ,input buf_dis-card-property.obj-type
     1660           ,input buf_dis-card-property.obj-code
     1661           ,input buf_dis-card-property.dtm-code
     1662           ,input buf_dis-card-property.card-num
     1663           ,input buf_dis-card-property.main-card
     1664           ,input buf_dis-card-property.first-card
     1665           ,input buf_dis-card-property.first-main-card
     1666           ,input buf_dis-card-property.node-code
     1667           ,input integer('99':U)
     1668           ,input p-source-type
     1669           ,input p-source-ref
     1670           ,input-output p-chip-num
     1671           ,input-output p-corr-date
     1672           ,input-output p-corr-time
     1673            ).
     1674       buf_dis-card-property.trg-param = (if p-source-type = '':U then '':U else 'no-hist':U).
     1675       delete buf_dis-card-property no-error .
     1676       if error-status:error then do:
     1677         return error return-value.
     1678       end.
     1679       p-deleted = yes.
     1680     end.
     1681   end.
     1682   end procedure.
     1683   procedure discprop-check :
     1684   define input parameter p-range  as integer no-undo .
     1685   define input parameter p-d-card like ub.dis-card-property.d-card no-undo .
     1686   define input parameter p-host-code like ub.dis-card-property.host-code no-undo .
     1687   define input parameter p-obj-type like ub.dis-card-property.obj-type no-undo .
     1688   define input parameter p-obj-code like ub.dis-card-property.obj-code no-undo .
     1689   define input parameter p-dtm-code like ub.dis-card-property.dtm-code no-undo .
     1690   define input parameter p-node-code like ub.dis-card-property.node-code no-undo .
     1691   define input parameter p-dt-code like ub.dis-card-property.dt-code no-undo .
     1692   define variable v-message as character no-undo .
     1693   define buffer buf_sysconf for ub.sysconf.
     1694   define buffer buf_clients for ub.clients.
     1695   define buffer buf_dis-card for ub.dis-card.
     1696   define buffer buf_attr-prop for ub.attr-prop.
     1697   do
     1698   on error undo, return error return-value
     1699   :
     1700     if p-host-code > 0 then do:
     1701       FIND FIRST buf_sysconf No-LOCK WHERE
     1702                 buf_sysconf.host-code = p-host-code No-ERROR.
     1703       IF NOT AVAIL buf_sysconf THEN DO:
     1704         v-message = substitute("Не найдена фирма &1", p-host-code).
     1705         RETURN ERROR v-message.
     1706       END.
     1707     end.
     1708     if p-obj-type <> "":U or
     1709         p-obj-code <> 0 then do:
     1710       find first buf_clients No-LOCK WHERE
     1711                 buf_clients.obj-type = p-obj-type AND
     1712                 buf_clients.obj-code = p-obj-code no-error .
     1713       if not available buf_clients then do:
     1714         v-message = substitute("Не найден объект &1&2", p-obj-type, p-obj-code).
     1715         RETURN ERROR v-message.
     1716       end.
     1717     end.
     1718     else if NOT (p-obj-type = "":U and p-obj-code = 0) then do:
     1719       v-message = substitute("Неверные значения параметров p-obj-type/p-obj-code и/или p-host-code: &1&2 &3"
     1720                               , p-obj-type
     1721                               , p-obj-code
     1722                               , p-host-code).
     1723       RETURN ERROR v-message.
     1724     end.
     1725     if p-d-card <> "":U then do:
     1726       find first buf_dis-card No-LOCK WHERE
     1727                   buf_dis-card.d-card = p-d-card No-ERROR.
     1728       if not avail buf_dis-card then do:
     1729         v-message =substitute("Не найдена ДК").
     1730         return error  v-message.
     1731       end.
     1732       if buf_dis-card.emitent-host-code <> 0
     1733       and p-host-code <> buf_dis-card.emitent-host-code then do:
     1734         v-message = substitute("Для фирменной карты свойство можно ввести только с привязкой к фирме-эмитенту").
     1735         return error v-message.
     1736       end.
     1737       if buf_dis-card.emitent-host-code = 0
     1738       and p-range = 1
     1739       and p-host-code <> 0 then do:
     1740         v-message = substitute("Для свойство с ОБЛАСТЬЮ ДЕЙСТВИЯ СОГЛАСНО КОДУ ЭМИТЕНТА&1" +
     1741                               "для ГЛОБАЛЬНОЙ карты можно ввести только ГЛОБАЛЬНОЕ свойство"
     1742                                 , chr(10)
     1743                               ).
     1744         return error v-message.
     1745       end.
     1746     end.
     1747   end.
     1748   end procedure.
     1749   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1750   define new shared temp-table dc-list no-undo like ub.dis-card
     1751     field to-del as logical
     1752     field order-num as integer
     1753     field fdec as decimal
     1754     field fint as integer
     1755     field flog as logical
     1756     field fchar as character
     1757     index pi  is primary unique d-card
     1758     index cn      card-num
     1759     index cli cli-type cli-code
     1760     index host-dscnt  emitent-host-code status_ d-pcnt
     1761     index host-type  emitent-host-code type d-pcnt
     1762     index oi order-num
     1763     .
     1764   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1765   define  new shared  temp-table dc-list-hist no-undo
     1766   field list-table as character
     1767   field id as integer
     1768   field line as integer
     1769   field hist-mode as character
     1770   field des as character
     1771   field num-recs as integer
     1772   field option_ as character
     1773   field item_ as character
     1774   field status_ as character
     1775   field num-add as integer
     1776   field num-ignored as integer
     1777   field done as logical
     1778   field err_ as logical
     1779   field err-mes as character
     1780   index pi is primary
     1781   id
     1782   line
     1783   index isdone
     1784   done
     1785   .
     1786   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1787   def new SHARED temp-table dcp-list no-undo like ub.dis-card-property
     1788                           field rc as recid
     1789                           field to-del as  logical
     1790                           field order-num as integer
     1791                           index rci is unique rc to-del
     1792                           index d-card-i is primary d-card host-code obj-type obj-code dt-code node-code to-del
     1793                           index iobj obj-type obj-code
     1794                           index io order-num
     1795                           .
     1796   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1797   define temp-table tt-attr-property  no-undo
     1798   field upper-attr-code as character
     1799   field attr-code as character
     1800   field table-name as character
     1801   field edit-menu-section-num as integer
     1802   field attr-label as character
     1803   field menu-item-handle as widget-handle
     1804   field user-can-edit as logical
     1805   field menu-name as character
     1806   field parent-handle as handle
     1807   index pi is unique primary
     1808   table-name
     1809   menu-name
     1810   upper-attr-code
     1811   attr-code
     1812   index i-section
     1813   edit-menu-section-num
     1814   .
     1815   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1816   procedure attr-pop-create-items :
     1817   define input parameter p-table-name as character no-undo .
     1818   define input parameter p-get-section-num-proc-name as character no-undo .
     1819   define input parameter p-get-attr-label-proc-name as character no-undo .
     1820   define input parameter p-attr-choose-proc-name as character no-undo .
     1821   define input parameter p-menu-handle as widget-handle no-undo .
     1822   define input parameter p-attr-list as character no-undo .
     1823   define variable ii as integer no-undo .
     1824   define variable V-CREATED as logical no-undo .
     1825   define variable v-tool-tip as character no-undo .
     1826   define variable v-dop as character no-undo .
     1827   define variable v-attr-item as character no-undo .
     1828   define variable p-upper-attr-code as character no-undo .
     1829   define buffer buf_tt-attr-property for tt-attr-property.
     1830     do
     1831     on error undo, return error return-value
     1832     :
     1833        do ii = 1 to num-entries (p-attr-list):
     1834          v-attr-item = entry(ii, p-attr-list) .
     1835          find first tt-attr-property where
     1836                    tt-attr-property.table-name = p-table-name
     1837                and tt-attr-property.attr-code = v-attr-item
     1838                and tt-attr-property.upper-attr-code = p-upper-attr-code
     1839                and tt-attr-property.menu-name = p-menu-handle:name  no-error .
     1840          if not available tt-attr-property then do:
     1841            create tt-attr-property.
     1842            assign
     1843            tt-attr-property.table-name = p-table-name
     1844            tt-attr-property.attr-code = v-attr-item
     1845            tt-attr-property.upper-attr-code = p-upper-attr-code
     1846            tt-attr-property.menu-name = p-menu-handle:name
     1847            .
     1848            run value ( p-get-section-num-proc-name) (
     1849                                                      input tt-attr-property.attr-code
     1850                                                     ,output tt-attr-property.edit-menu-section-num ) no-error .
     1851            run value ( p-get-attr-label-proc-name ) (
     1852                                           input tt-attr-property.attr-code
     1853                                          ,output v-tool-tip
     1854                                          ,output tt-attr-property.attr-label
     1855                                         ) no-error .
     1856            release tt-attr-property.
     1857          end.
     1858        end.
     1859        for each tt-attr-property where tt-attr-property.menu-name = p-menu-handle:name
     1860        break
     1861        by  tt-attr-property.edit-menu-section-num
     1862        by  tt-attr-property.attr-label
     1863        :
     1864          if tt-attr-property.edit-menu-section-num > 0
     1865          then do:
     1866             if not valid-handle(tt-attr-property.menu-item-handle) then do:
     1867               if num-entries(tt-attr-property.attr-code, chr(4)) > 1
     1868               and entry(2, tt-attr-property.attr-code, chr(4)) <> '':U
     1869               then do:
     1870                 find first buf_tt-attr-property where
     1871                           buf_tt-attr-property.table-name = p-table-name
     1872                       and buf_tt-attr-property.menu-name = p-menu-handle:name
     1873                       and buf_tt-attr-property.upper-attr-code = p-upper-attr-code
     1874                       and buf_tt-attr-property.attr-code = entry(1, tt-attr-property.attr-code, chr(4)) no-error .
     1875                 if not available buf_tt-attr-property then do:
     1876                   create buf_tt-attr-property.
     1877                   assign
     1878                   buf_tt-attr-property.table-name = p-table-name
     1879                   buf_tt-attr-property.attr-code = entry(1, tt-attr-property.attr-code, chr(4))
     1880                   buf_tt-attr-property.upper-attr-code = p-upper-attr-code
     1881                   buf_tt-attr-property.menu-name = p-menu-handle:name
     1882                   .
     1883                   create sub-menu buf_tt-attr-property.menu-item-handle
     1884                   assign
     1885                   name = entry(1, tt-attr-property.attr-code, chr(4))  + chr(4)  + p-menu-handle:name
     1886                   parent = p-menu-handle.
     1887                 end.
     1888                 create menu-item tt-attr-property.menu-item-handle
     1889                 assign
     1890                 label = tt-attr-property.attr-label
     1891                 name = tt-attr-property.attr-code  + chr(4)  + p-menu-handle:name
     1892                 parent = buf_tt-attr-property.menu-item-handle
     1893                 triggers:
     1894                   on choose
     1895                     persistent run value(p-attr-choose-proc-name + "-2") (
     1896                                                                            input  entry(1, tt-attr-property.attr-code, chr(4) )
     1897                                                                           ,input entry(2, tt-attr-property.attr-code, chr(4) )
     1898                                                                             ) .
     1899                 end triggers.
     1900                 assign
     1901                 v-created = yes.
     1902               end.
     1903               else do:
     1904                 create menu-item tt-attr-property.menu-item-handle
     1905                 assign
     1906                 label = tt-attr-property.attr-label
     1907                 name = entry(1, tt-attr-property.attr-code, chr(4)) + chr(4)  + p-menu-handle:name
     1908                 parent = p-menu-handle
     1909                 triggers:
     1910                   on choose
     1911                     persistent run value(p-attr-choose-proc-name) (
     1912                                                                    input  entry(1, tt-attr-property.attr-code, chr(4) )) .
     1913                 end triggers.
     1914                 assign
     1915                 v-created = yes.
     1916               end.
     1917             end.
     1918             if last-of(tt-attr-property.edit-menu-section-num)
     1919               then do:
     1920               find first buf_tt-attr-property where
     1921                         buf_tt-attr-property.table-name = p-table-name
     1922                    and  buf_tt-attr-property.attr-code = substitute("&1&2&3"
     1923                                                            , p-table-name
     1924                                                            , tt-attr-property.edit-menu-section-num
     1925                                                            , p-menu-handle:name
     1926                                                            )
     1927                     and buf_tt-attr-property.menu-name = p-menu-handle:name  no-error .
     1928               if not available buf_tt-attr-property then do:
     1929                 create buf_tt-attr-property.
     1930                 assign
     1931                 buf_tt-attr-property.table-name = p-table-name
     1932                 buf_tt-attr-property.edit-menu-section-num =  - 1
     1933                 buf_tt-attr-property.menu-name = p-menu-handle:name
     1934                 buf_tt-attr-property.upper-attr-code = ''
     1935                 buf_tt-attr-property.attr-code = substitute("&1&2&3"
     1936                                                             , p-table-name
     1937                                                             , tt-attr-property.edit-menu-section-num
     1938                                                             , p-menu-handle:name
     1939                                                             )
     1940                 .
     1941                 create menu-item buf_tt-attr-property.menu-item-handle
     1942                 assign
     1943                 subtype = "rule"
     1944                 parent = p-menu-handle
     1945                 .
     1946               end.
     1947             end.
     1948          end.
     1949        end.
     1950        if not v-created then do:
     1951           run attr-pop-clean-up in this-procedure ( input p-table-name).
     1952        end.
     1953     end.
     1954   end procedure.
     1955   procedure attr-pop-clean-up :
     1956   define input parameter p-table-name as character no-undo .
     1957     for each tt-attr-property where
     1958             tt-attr-property.table-name = p-table-name
     1959       and tt-attr-property.edit-menu-section-num > 0:
     1960       if valid-handle ( tt-attr-property.menu-item-handle) then do:
     1961         delete widget tt-attr-property.menu-item-handle.
     1962       end.
     1963       delete tt-attr-property.
     1964     end.
     1965     for each tt-attr-property where
     1966              tt-attr-property.table-name = p-table-name
     1967          and tt-attr-property.edit-menu-section-num =  - 1:
     1968       if valid-handle ( tt-attr-property.menu-item-handle) then do:
     1969         delete widget tt-attr-property.menu-item-handle.
     1970       end.
     1971       delete tt-attr-property.
     1972     end.
     1973   end procedure.
     1974   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
