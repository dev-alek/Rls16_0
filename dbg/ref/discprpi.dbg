      136   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      137     define variable v-cntxt-db-num        as integer   no-undo .
      138     define variable v-cntxt-userid        as character no-undo .
      139     define variable v-cntxt-level         as character no-undo .
      140     define variable v-cntxt-host-code-obj as integer   no-undo .
      141     define variable v-cntxt-obj-type      as character no-undo .
      142     define variable v-cntxt-obj-code      as integer   no-undo .
      143     define variable v-cntxt-db-num-obj    as integer   no-undo .
      144     define variable v-cntxt-is-admin      as logical   no-undo .
      145   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      146   FUNCTION CIntBinS RETURNS CHARACTER(input vl_int as integer):
      147   def var vl_bin as char no-undo init "".
      148   if vl_int < 0 OR vl_int = ? then return ?.
      149   do while vl_int > 0:
      150     assign
      151     vl_bin = (if vl_int modulo 2 = 0
      152                 then "0":U
      153                 else "1":U) + vl_bin
      154     vl_int = truncate(vl_int / 2,0).
      155   end.
      156   return fill( "0":U, 32 - length(vl_bin)) + vl_bin .
      157   END FUNCTION.
      158   FUNCTION BinMask RETURNS LOGICAL(input vl_int as integer,
      159                                    input vl_binm as character):
      160   DEFINE VARIABLE vl_bin as character no-undo.
      161   DEFINE VARIABLE ii as integer no-undo.
      162   DEFINE VARIABLE ii-len as integer no-undo.
      163   DEFINE VARIABLE ii-lenm as integer no-undo.
      164   DEFINE VARIABLE mchar as character no-undo.
      165   DEFINE VARIABLE ichar as character no-undo.
      166   if vl_binm = ? then return ?.
      167   vl_bin = CIntBinS(vl_int).
      168   if vl_bin = ? then return ?.
      169   assign
      170   vl_binm = LEFT-TRIM(vl_binm, "X":U)
      171   ii-lenm = LENGTH(vl_binm)
      172   ii-len = LENGTH(vl_bin) - ii-lenm
      173   .
      174   if II-LENM > 32 THEN RETURN ?.
      175   DO II = 1 to II-LENm:
      176     assign
      177     mchar = SUBSTR(vl_binm, ii, 1)
      178     ichar = SUBSTR(vl_bin, ii + ii-len, 1)
      179     .
      180     IF not (MCHAR = "0":u or MCHAR = "1":u or MCHAR = "X":u) then return ?.
      181     IF ichar <> mchar AND mchar <> "X":U then return no.
      182   END.
      183   return yes.
      184   END FUNCTION.
      185   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      186   FUNCTION get-region RETURNS CHARACTER
      187     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      188     define variable par-region as character no-undo.
      189     if parhost-code = 0 and
      190          parobj-type = "":U and
      191          parobj-code = 0 then do:
      192          par-region = "Глобально".
      193          return par-region.
      194       end.
      195       if parobj-type = 'орг':U then do:
      196          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      197          return par-region.
      198       end.
      199       if parobj-type = 'регион':U
      200       then do:
      201          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      202          return par-region.
      203       end.
      204       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      205       return par-region.
      206   END FUNCTION.
      207   FUNCTION get-objregion RETURNS CHARACTER
      208     (  input parobj-type as character, input parobj-code as integer ) :
      209     define variable par-region as character no-undo.
      210     if  parobj-type = "":U and
      211         parobj-code = 0
      212     then do:
      213        par-region = "Глобально".
      214     end.
      215     else if parobj-type = 'орг':U
      216     then do:
      217        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      218     end.
      219     else if parobj-type = 'регион':U
      220     then do:
      221        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      222     end.
      223     else
      224        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      225     return par-region.
      226   END FUNCTION.
      227   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      228   procedure cur-time :
      229      define output parameter p-today as date      no-undo .
      230      define output parameter p-time  as integer   no-undo .
      231     do
      232     on error undo, return error
      233     :
      234       define variable v-date1 as date      no-undo .
      235       define variable v-date2 as date      no-undo .
      236       define variable v-time  as integer   no-undo .
      237       assign
      238         v-date1 = today
      239         v-time  = time
      240         v-date2 = today
      241       .
      242       if v-date1 <> v-date2
      243       then do:
      244         assign
      245           v-date1 = today
      246           v-time  = v-time
      247         .
      248       end.
      249       assign
      250         p-today = v-date1
      251         p-time  = v-time
      252       .
      253     end.
      254   end.
      255   function cur-time-date returns character
      256   :
      257     return string(today, '99/99/9999':U) .
      258   end.
      259   function cur-time-mjd returns decimal
      260   :
      261     define variable v-date as date      no-undo .
      262     define variable v-time as integer   no-undo .
      263     run cur-time in this-procedure
      264       (output v-date
      265       ,output v-time
      266       ) .
      267     return integer(v-date) - 2400002 + (v-time / 86400) .
      268   end.
      269   function cur-time-get-ending-index returns integer
      270   (input p-number as integer
      271   )
      272   :
      273     if p-number < 0
      274     or p-number = ?
      275     then do:
      276       return 1 .
      277     end.
      278     define variable v-rest as integer   no-undo .
      279     assign
      280       p-number = p-number modulo 100
      281     .
      282     if p-number < 20
      283     then do:
      284       assign
      285         v-rest = p-number
      286       .
      287     end.
      288     else do:
      289       assign
      290         v-rest = p-number modulo 10
      291       .
      292     end.
      293     case v-rest :
      294       when 1
      295       then do:
      296         return 2 .
      297       end.
      298       when 2 or
      299       when 3 or
      300       when 4
      301       then do:
      302         return 3 .
      303       end.
      304       otherwise do:
      305         return 1 .
      306       end.
      307     end case .
      308   end.
      309   procedure cur-time-mjd-to-date :
      310      define input  parameter i-mjd-diff as decimal no-undo.
      311      define output parameter o-Date     as date    no-undo.
      312      define output parameter o-Time     as integer no-undo.
      313      define variable v-day-number as integer   no-undo .
      314      if    i-mjd-diff < 0
      315         or i-mjd-diff = ?
      316      then do:
      317         return "?" .
      318      end.
      319      assign
      320         v-day-number = truncate(i-mjd-diff,0).
      321         o-Date = date(v-day-number + 2400002).
      322         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      323     .
      324   end.
      325   function cur-time-mjd-to-string returns character
      326   (input p-mjd-diff as decimal
      327   )
      328   :
      329     define variable v-day-number as integer   no-undo .
      330     define variable v-seconds    as integer   no-undo .
      331     define variable v-hour       as integer   no-undo .
      332     define variable v-min        as integer   no-undo .
      333     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      334     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      335     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      336     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      337     if p-mjd-diff < 0
      338     or p-mjd-diff = ?
      339     then do:
      340       return "?" .
      341     end.
      342     assign
      343       v-day-number = integer(truncate(p-mjd-diff,0))
      344       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      345     .
      346     if v-seconds > 86400
      347     then do:
      348       assign
      349         v-seconds = 86400 - 1
      350       .
      351     end.
      352     if v-seconds < 0
      353     then do:
      354       assign
      355         v-seconds = 0
      356       .
      357     end.
      358     assign
      359       v-hour = truncate(v-seconds / 3600, 0)
      360     .
      361     assign
      362       v-seconds = v-seconds modulo 3600
      363     .
      364     assign
      365       v-min = truncate(v-seconds / 60, 0)
      366     .
      367     assign
      368       v-seconds = v-seconds modulo 60
      369     .
      370     return
      371         (if v-day-number <> 0
      372           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      373           else ""
      374         )
      375       + (if v-day-number <> 0 or v-hour <> 0
      376           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      377           else ""
      378         )
      379       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      380           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      381           else ""
      382         )
      383       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      384       .
      385   end.
      386   function cur-time-string returns character
      387   :
      388     define variable v-date as date      no-undo .
      389     define variable v-time as integer   no-undo .
      390     run cur-time in this-procedure
      391       (output v-date
      392       ,output v-time
      393       ) .
      394     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      395   end.
      396   function cur-time-string-sec returns character
      397   :
      398     define variable v-date as date      no-undo .
      399     define variable v-time as integer   no-undo .
      400     run cur-time in this-procedure
      401       (output v-date
      402       ,output v-time
      403       ) .
      404     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      405   end.
      406   function cur-time-custom  returns character
      407   (input p-prefix as character
      408   ,input p-date-format as character
      409   ,input p-delimiter as character
      410   ,input p-time-format as character
      411   ,input p-suffix as character
      412   )
      413   :
      414     define variable v-date as date      no-undo .
      415     define variable v-time as integer   no-undo .
      416     run cur-time in this-procedure
      417       (output v-date
      418       ,output v-time
      419       ) .
      420     return
      421       p-prefix
      422       + string(v-date, p-date-format)
      423       + p-delimiter
      424       + string(v-time, p-time-format)
      425       + p-suffix
      426       .
      427   end.
      428   function cur-time-print  returns character
      429   :
      430     define variable v-date as date      no-undo .
      431     define variable v-time as integer   no-undo .
      432     run cur-time in this-procedure
      433       (output v-date
      434       ,output v-time
      435       ) .
      436     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      437   end.
      438   function cur-time-datetime returns datetime
      439   :
      440     define variable v-char as character no-undo .
      441     define variable v-datetime as datetime no-undo .
      442     v-char = cur-time-string().
      443     v-datetime = datetime(v-char).
      444     return  v-datetime.
      445   end.
      446   function cur-time-string-msec returns character
      447   :
      448     define variable v-date as datetime  no-undo .
      449     v-date = now.
      450     return string(v-date) .
      451   end.
