        1   block-level on error undo, throw.
        2   DEFINE INPUT PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        3   define input parameter p-host-code like ub.fin-bank.host-code no-undo.
        4   define input parameter p-code-bank like ub.fin-bank.code-bank no-undo.
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: finbankp.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: ref/finbankp.p $":U .
       10   define variable vss-description as character no-undo init "Печать карточки банка".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       73   define  shared variable RepPathName        as character no-undo .
       74   define  shared variable PrintRubl          as logical   no-undo .
       75   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   define  stream PrnLibStream.
       77   procedure prn-lib-prn-file :
       78     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
       79     define input parameter p-DIsabledoptions as integer no-undo .
       80     define variable v-report-name as character no-undo .
       81     define variable v-user-action as character no-undo .
       82     define variable v-printed     as logical   no-undo .
       83     define variable v-exist       as logical   no-undo .
       84     do
       85       on error undo, return error
       86       :
       87       run prn-lib-get-report-name  in this-procedure (
       88         input parParentProc
       89         ,output v-report-name
       90         ).
       91   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       92   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
       93     (input  v-report-name
       94     ,input  2
       95     ,output v-exist
       96     )  .
       97       if NOT v-exist then
       98       DO:
       99         Message
      100           "Нет заданий на печать ! "
      101           view-as alert-box .
      102         Return  .
      103       End.
      104       run gbl/prnfilen.w
      105         (input  ""
      106         ,input  p-DisabledOptions
      107         ,input  string(v-report-name )
      108         ,input  7
      109         ,output v-user-action
      110         ,output v-printed
      111         ) .
      112       if v-printed then
      113       do:
      114         return "YES" .
      115       end.
      116       else
      117       do:
      118         return "NO" .
      119       end.
      120     end.
      121   end procedure.
      122   procedure prn-lib-open-stream :
      123     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      124     define input parameter p-page-size    as integer no-undo .
      125     define input parameter p-is-stream    as logical no-undo .
      126     define input parameter p-append       as logical no-undo .
      127     define variable v-report-name as character no-undo .
      128     do
      129       on error undo, return error
      130       :
      131       run prn-lib-get-report-name  in this-procedure (
      132         input parParentProc
      133         ,output v-report-name
      134         ).
      135       if p-is-stream then
      136       do:
      137         if p-append then
      138         do:
      139           output stream PrnLibStream to value( v-report-name )
      140             page-size value(p-page-size) append .
      141         end.
      142         if not p-append then
      143         do:
      144           output stream PrnLibStream to value( v-report-name )
      145             page-size value(p-page-size) .
      146         end.
      147       end.
      148       if not p-is-stream then
      149       do:
      150         if p-append then
      151         do:
      152           output to value( v-report-name )
      153             page-size value(p-page-size) append .
      154         end.
      155         if not p-append then
      156         do:
      157           output to value( v-report-name )
      158             page-size value(p-page-size) .
      159         end.
      160       end.
      161     end.
      162   end procedure.
      163   procedure prn-lib-open-exp :
      164     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      165     define input parameter p-is-stream    as logical no-undo .
      166     define input parameter p-is-append    as logical no-undo .
      167     define output parameter p-ReportFileName as char init "report" no-undo.
      168     define output parameter p-process as logical no-undo .
      169     define variable glog as logical no-undo .
      170     do
      171       on error undo, return error
      172       :
      173       SYSTEM-DIALOG GET-FILE p-ReportFileName
      174         TITLE      "Укажите путь"
      175         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      176         ASK-OVERWRITE
      177         CREATE-TEST-FILE
      178         SAVE-AS
      179         USE-FILENAME
      180         DEFAULT-EXTENSION "txt"
      181         UPDATE glog
      182         .
      183       if not glog then  return.
      184       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      185       if p-is-stream then
      186       do:
      187         if p-is-append then
      188         do:
      189           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      190         end.
      191         else
      192         do:
      193           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      194         end.
      195       end.
      196       else
      197       do:
      198         if p-is-append then
      199         do:
      200           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      201         end.
      202         else
      203         do:
      204           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      205         end.
      206       end.
      207       p-process = yes.
      208     end.
      209   end procedure.
      210   procedure prn-lib-get-report-name :
      211     define input parameter parParentProc  as widget-handle no-undo.
      212     define output parameter p-report-name as character no-undo .
      213     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      214   end procedure.
      215   procedure prn-lib-reportviewer-report-name :
      216     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      217     define input parameter p-report-name-html as character no-undo .
      218     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      219   end procedure.
      220   procedure prn-lib-reportviewer :
      221     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      222     define input parameter p-report-name-html as character no-undo .
      223     define input parameter p-param        as character no-undo .
      224     define variable v-excel           as character no-undo init 'TRUE' .
      225     define variable v-value-character as character no-undo .
      226     define variable v-value-integer   as character no-undo .
      227     define variable v-value-date      as date      no-undo .
      228     define variable v-value-decimal   as decimal   no-undo .
      229     define variable rep-excel         as logical   no-undo .
      230     define variable excel-string      as character no-undo .
      231     define variable v-param-type      as character no-undo .
      232     define variable v-tth             as handle    no-undo .
      233     run adm/shattri.p (
      234       input "get":U
      235       ,input  ""
      236       ,input  0
      237       ,input  'report-glob':U
      238       ,input  'rep-excel':U
      239       ,output v-value-character
      240       ,output v-value-date
      241       ,output v-value-decimal
      242       ,output v-value-integer
      243       ,output rep-excel
      244       ,output v-param-type
      245       ,INPUT-OUTPUT table-handle v-tth
      246       )  .
      247     if rep-excel then v-excel = "TRUE" .
      248     else v-excel = "FALSE" .
      249     if p-param eq ""
      250     then
      251        p-param = "EXCEL:" + v-excel.
      252     else
      253        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      254     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      255   end procedure.
      256   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      257   procedure cur-time :
      258      define output parameter p-today as date      no-undo .
      259      define output parameter p-time  as integer   no-undo .
      260     do
      261     on error undo, return error
      262     :
      263       define variable v-date1 as date      no-undo .
      264       define variable v-date2 as date      no-undo .
      265       define variable v-time  as integer   no-undo .
      266       assign
      267         v-date1 = today
      268         v-time  = time
      269         v-date2 = today
      270       .
      271       if v-date1 <> v-date2
      272       then do:
      273         assign
      274           v-date1 = today
      275           v-time  = v-time
      276         .
      277       end.
      278       assign
      279         p-today = v-date1
      280         p-time  = v-time
      281       .
      282     end.
      283   end.
      284   function cur-time-date returns character
      285   :
      286     return string(today, '99/99/9999':U) .
      287   end.
      288   function cur-time-mjd returns decimal
      289   :
      290     define variable v-date as date      no-undo .
      291     define variable v-time as integer   no-undo .
      292     run cur-time in this-procedure
      293       (output v-date
      294       ,output v-time
      295       ) .
      296     return integer(v-date) - 2400002 + (v-time / 86400) .
      297   end.
      298   function cur-time-get-ending-index returns integer
      299   (input p-number as integer
      300   )
      301   :
      302     if p-number < 0
      303     or p-number = ?
      304     then do:
      305       return 1 .
      306     end.
      307     define variable v-rest as integer   no-undo .
      308     assign
      309       p-number = p-number modulo 100
      310     .
      311     if p-number < 20
      312     then do:
      313       assign
      314         v-rest = p-number
      315       .
      316     end.
      317     else do:
      318       assign
      319         v-rest = p-number modulo 10
      320       .
      321     end.
      322     case v-rest :
      323       when 1
      324       then do:
      325         return 2 .
      326       end.
      327       when 2 or
      328       when 3 or
      329       when 4
      330       then do:
      331         return 3 .
      332       end.
      333       otherwise do:
      334         return 1 .
      335       end.
      336     end case .
      337   end.
      338   procedure cur-time-mjd-to-date :
      339      define input  parameter i-mjd-diff as decimal no-undo.
      340      define output parameter o-Date     as date    no-undo.
      341      define output parameter o-Time     as integer no-undo.
      342      define variable v-day-number as integer   no-undo .
      343      if    i-mjd-diff < 0
      344         or i-mjd-diff = ?
      345      then do:
      346         return "?" .
      347      end.
      348      assign
      349         v-day-number = truncate(i-mjd-diff,0).
      350         o-Date = date(v-day-number + 2400002).
      351         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      352     .
      353   end.
      354   function cur-time-mjd-to-string returns character
      355   (input p-mjd-diff as decimal
      356   )
      357   :
      358     define variable v-day-number as integer   no-undo .
      359     define variable v-seconds    as integer   no-undo .
      360     define variable v-hour       as integer   no-undo .
      361     define variable v-min        as integer   no-undo .
      362     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      363     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      364     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      365     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      366     if p-mjd-diff < 0
      367     or p-mjd-diff = ?
      368     then do:
      369       return "?" .
      370     end.
      371     assign
      372       v-day-number = integer(truncate(p-mjd-diff,0))
      373       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      374     .
      375     if v-seconds > 86400
      376     then do:
      377       assign
      378         v-seconds = 86400 - 1
      379       .
      380     end.
      381     if v-seconds < 0
      382     then do:
      383       assign
      384         v-seconds = 0
      385       .
      386     end.
      387     assign
      388       v-hour = truncate(v-seconds / 3600, 0)
      389     .
      390     assign
      391       v-seconds = v-seconds modulo 3600
      392     .
      393     assign
      394       v-min = truncate(v-seconds / 60, 0)
      395     .
      396     assign
      397       v-seconds = v-seconds modulo 60
      398     .
      399     return
      400         (if v-day-number <> 0
      401           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      402           else ""
      403         )
      404       + (if v-day-number <> 0 or v-hour <> 0
      405           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      406           else ""
      407         )
      408       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      409           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      410           else ""
      411         )
      412       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      413       .
      414   end.
      415   function cur-time-string returns character
      416   :
      417     define variable v-date as date      no-undo .
      418     define variable v-time as integer   no-undo .
      419     run cur-time in this-procedure
      420       (output v-date
      421       ,output v-time
      422       ) .
      423     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      424   end.
      425   function cur-time-string-sec returns character
      426   :
      427     define variable v-date as date      no-undo .
      428     define variable v-time as integer   no-undo .
      429     run cur-time in this-procedure
      430       (output v-date
      431       ,output v-time
      432       ) .
      433     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      434   end.
      435   function cur-time-custom  returns character
      436   (input p-prefix as character
      437   ,input p-date-format as character
      438   ,input p-delimiter as character
      439   ,input p-time-format as character
      440   ,input p-suffix as character
      441   )
      442   :
      443     define variable v-date as date      no-undo .
      444     define variable v-time as integer   no-undo .
      445     run cur-time in this-procedure
      446       (output v-date
      447       ,output v-time
      448       ) .
      449     return
      450       p-prefix
      451       + string(v-date, p-date-format)
      452       + p-delimiter
      453       + string(v-time, p-time-format)
      454       + p-suffix
      455       .
      456   end.
      457   function cur-time-print  returns character
      458   :
      459     define variable v-date as date      no-undo .
      460     define variable v-time as integer   no-undo .
      461     run cur-time in this-procedure
      462       (output v-date
      463       ,output v-time
      464       ) .
      465     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      466   end.
      467   function cur-time-datetime returns datetime
      468   :
      469     define variable v-char as character no-undo .
      470     define variable v-datetime as datetime no-undo .
      471     v-char = cur-time-string().
      472     v-datetime = datetime(v-char).
      473     return  v-datetime.
      474   end.
      475   function cur-time-string-msec returns character
      476   :
      477     define variable v-date as datetime  no-undo .
      478     v-date = now.
      479     return string(v-date) .
      480   end.
      481   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      482   define variable v-waitfram-action01         as character   no-undo .
      483   define variable v-waitfram-action02         as character   no-undo .
      484   define variable v-waitfram-action03         as character   no-undo .
      485   define variable mWaitFramTextBeg            as character   no-undo.
      486   define variable mWaitFramTextEnd            as character   no-undo.
      487   define variable mWaitFramView               as logical     no-undo.
      488   define variable mWaitProcEvent              as logical     no-undo init yes.
      489   define variable mWaitFramInterval           as integer     no-undo init 1 .
      490   define variable mWaitFramStop               as logical     no-undo.
      491   define variable mWaitFramStopUser           as logical     no-undo.
      492   define variable mWaitFramStopTimeOut        as logical     no-undo.
      493   define variable mWaitFramStartProc          as datetime-tz no-undo.
      494   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      495   define button B-WaitFramStop auto-end-key
      496        label "Стоп"
      497        size 10 by 1 tooltip "Остоновить процесс".
      498   define button B-viewProcInfo
      499        label "Информация"
      500        size 15 by 1 tooltip "Информация о процесс".
      501   define frame waitfram
      502     v-waitfram-action01 format "x(72)" no-label skip
      503     v-waitfram-action02 format "x(72)" no-label skip
      504     v-waitfram-action03 format "x(72)" no-label skip
      505     B-viewProcInfo
      506     B-WaitFramStop at row 4 col 30
      507     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      508     .
      509   define new global shared variable mBatchMode as logical no-undo init ?.
      510   define variable mFramBachModHandle as handle no-undo.
      511   mFramBachModHandle = frame waitfram:handle.
      512   define variable mFameOldVis as logical no-undo.
      513   define variable mVisCUrentVin as logical no-undo.
      514   if session:batch-mode
      515   then
      516      mBatchMode = yes.
      517   if mBatchMode = ? then do:
      518     mVisCUrentVin = current-window:visible.
      519     mFameOldVis = mFramBachModHandle:visible.
      520     mFramBachModHandle:visible  = yes.
      521     mBatchMode = mFramBachModHandle:visible ne yes.
      522     mFramBachModHandle:visible = mFameOldVis.
      523     current-window:visible = mVisCUrentVin.
      524   end.
      525    if  log-manager:logfile-name ne ?
      526     then DO:
      527         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      528         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      529         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      530     end.
      531   on choose of B-WaitFramStop in frame waitfram
      532   do:
      533     mWaitFramStop = yes.
      534     mWaitFramStopUser = yes.
      535   end.
      536   function waitfram-check-timeout returns logical():
      537      define variable vtime as int64 no-undo.
      538      if mWaitFramStopTimeOut
      539      then
      540         return yes.
      541      vtime = ( now - mWaitFramStartProc ) / 1000 .
      542      if     mWaitFramTimeOut ne ?
      543         and mWaitFramTimeOut ne 0
      544         and mWaitFramTimeOut lt vtime
      545      then do:
      546         mWaitFramStopTimeOut = yes.
      547      end.
      548      return mWaitFramStopTimeOut.
      549   end.
      550   procedure waitfram-hide :
      551     if not session:batch-mode
      552     then do
      553     on error undo, return error return-value
      554     :
      555       pause 0 before-hide .
      556       if not mBatchMode then
      557         hide frame waitfram .
      558     if     not mWaitFramView
      559        and mWaitProcEvent
      560     then
      561       process events .
      562     end.
      563   end procedure.
      564   procedure waitfram-show :
      565     define input  parameter p-message as character no-undo .
      566     define variable v-left-margin as integer   no-undo .
      567     if not session:batch-mode
      568     then do
      569     on error undo, return error return-value
      570     :
      571       if length(p-message) <= 70 then do:
      572         assign
      573           v-left-margin = integer((70 - length(p-message)) / 2)
      574         .
      575         assign
      576           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      577         .
      578         assign
      579           v-waitfram-action01 = " "
      580           v-waitfram-action02 = " "
      581                                    + fill(" ", v-left-margin)
      582                                    + p-message
      583           v-waitfram-action03 = " "
      584         .
      585       end.
      586       else do:
      587         define variable vRindex1 as integer no-undo.
      588         define variable vRindex2 as integer no-undo.
      589         vRindex1 = r-index(p-message," ",70).
      590         if vRindex1 = 0
      591         then
      592            vRindex1 = 70.
      593         if length(p-message)  <= vRindex1 + 70 then do:
      594           assign
      595             v-waitfram-action01 = " "
      596             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      597             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      598           .
      599         end.
      600         else do:
      601           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      602           if vRindex2 <= vRindex1
      603           then
      604              vRindex2 = vRindex1 + 70.
      605           assign
      606             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      607             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      608             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      609           .
      610         end.
      611       end.
      612       B-viewProcInfo:visible   in frame waitfram = no.
      613       B-viewProcInfo:sensitive in frame waitfram = no.
      614       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      615       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      616       if  (   mWaitFramView
      617          or  mWaitProcEvent)
      618          and not mBatchMode
      619       then
      620          display
      621             v-waitfram-action01 skip
      622             v-waitfram-action02 skip
      623             v-waitfram-action03 skip
      624          with frame waitfram .
      625       if     mWaitFramView
      626          then do:
      627             if     mWaitFramInterval ne ?
      628                and not mBatchMode
      629             then
      630                wait-for go of frame waitfram pause mWaitFramInterval.
      631          end.
      632          else
      633             if     mWaitProcEvent
      634                and not mBatchMode
      635             then
      636                process events .
      637     end.
      638   end procedure.
      639      procedure waitfram-show-this:
      640         define input  parameter iInterval as int64 no-undo.
      641         define variable vtime as int64 no-undo.
      642         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      643         mWaitFramInterval = iInterval.
      644         run waitfram-show (substitute("&1&2 &3&4" ,
      645                                       mWaitFramTextBeg ,
      646                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      647                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      648                                       mWaitFramTextEnd
      649                                      )
      650                           ).
      651      end.
      652      procedure WaitFramRunPause:
      653         define input  parameter iInterval as dec no-undo.
      654         define variable vStart  as datetime-tz no-undo.
      655         define variable vend    as datetime-tz no-undo.
      656         define variable vint as int64 no-undo.
      657         define variable vOk as logical no-undo.
      658         vStart = now.
      659         vend   = vStart.
      660         publish "WaitFramPause" (iInterval,output vOk).
      661         vend   =  now.
      662         vint = vend - vStart.
      663         vint = iInterval - vint / 1000.
      664         if     not mWaitFramStop
      665            and (   vint > 0
      666                 or (    not vOk
      667                     and iInterval eq ?
      668                     )
      669                 )
      670         then
      671            run waitfram-show-this (iInterval).
      672         vend   =  now.
      673         vint = vend - vStart.
      674         vint = iInterval - vint / 1000.
      675         if     not mWaitFramStop
      676            and vint > 0
      677         then do:
      678            run gbl/pause.p (vint * 1000).
      679         end.
      680         if iInterval ne ?
      681         then
      682            publish "WaitFramStop".
      683         waitfram-check-timeout().
      684      end.
      685      procedure WaitFramWaitFor:
      686         define input  parameter iInterval as dec no-undo.
      687         assign
      688            mWaitFramStartProc   = now
      689            mWaitFramStopUser    = no
      690            mWaitFramStopTimeOut = no
      691         .
      692         block-wait:
      693         do while not mWaitFramStop:
      694            run WaitFramRunPause (iInterval).
      695            if  waitfram-check-timeout()
      696            then do:
      697               leave block-wait.
      698            end.
      699         end.
      700         run waitfram-hide.
      701      end.
      702   procedure waitfram-join :
      703     define input  parameter p-line-1  as character no-undo .
      704     define input  parameter p-line-2  as character no-undo .
      705     define input  parameter p-line-3  as character no-undo .
      706     define output parameter p-message as character no-undo .
      707     do
      708     on error undo, return error return-value
      709     :
      710       assign
      711         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      712                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      713                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      714       .
      715     end.
      716   end procedure.
      717   function waitfram-join-function returns character
      718     (input p-line-1 as character
      719     ,input p-line-2 as character
      720     ,input p-line-3 as character
      721     ).
      722     define variable v-message as character no-undo .
      723     run waitfram-join in this-procedure
      724       (input  p-line-1
      725       ,input  p-line-2
      726       ,input  p-line-3
      727       ,output v-message
      728       ) .
      729     return v-message .
      730   end function .
      731   define variable date_string     as      char    no-undo.
      732   define variable Line            as      char    no-undo.
      733   define variable v-title         as character no-undo .
      734   define variable v-status        as character no-undo .
      735   define buffer buf_fin-bank for ub.fin-bank.
      736   define buffer buf_clients for ub.clients.
      737   do
      738   on error undo, return error
      739   :
      740     find first buf_fin-bank no-lock where
      741               buf_fin-bank.host-code = p-host-code
      742           AND buf_fin-bank.code-bank = p-code-bank no-error.
      743     if not available buf_fin-bank then do:
      744       message
      745       vss-workfile vss-revision vss-description skip
      746       "Не найден банк" skip
      747       "p-host-code"  p-host-code skip
      748       "p-code-bnak" p-code-bank
      749       view-as alert-box error .
      750       undo, return error.
      751     end.
      752     find first buf_clients no-lock where
      753               buf_clients.obj-type = 'орг':U
      754           AND buf_clients.obj-code = buf_fin-bank.host-code .
      755     DEFINE FRAME TopFrame
      756     buf_fin-bank.host-code column-label "Код фирмы"
      757     buf_clients.obj-name   column-label "Фирма"
      758     buf_fin-bank.code-bank column-label "Код банка"
      759     buf_fin-bank.status_   column-label "Статус"
      760     HEADER
      761     date_string AT 5 format "X(35)"
      762     string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
      763     Line format "X(195)" AT 1
      764     with FRAME TopFrame width 232 down stream-io use-text    .
      765     Line = fill("-", 195).
      766     date_string = cur-time-print() .
      767     run prn-lib-open-stream  in this-procedure (
      768                                                 input parParentProc
      769                                                 ,input 43
      770                                                 ,input yes
      771                                                 ,input no
      772                                                 ).
      773     PUT  STREAM PrnLibStream UNFORMATTED
      774     SPACE(25) "Информация о банке"
      775     SKIP(1) .
      776     FORM HEADER
      777     Line format "X(195)" AT 1 SKIP
      778     "Продолжение - на следующей странице" AT 30 SKIP
      779     with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
      780     VIEW  STREAM PrnLibStream FRAME BottomFrame .
      781     run waitfram-show in this-procedure ("Ждите...").
      782     FORM with frame TopFrame.
      783     display stream PrnLibStream
      784     buf_fin-bank.host-code
      785     buf_clients.obj-name
      786     buf_fin-bank.code-bank
      787     buf_fin-bank.status_
      788     with frame TopFrame.
      789     DOWN stream PrnLibStream 3
      790     with frame TopFrame.
      791     Put Stream PrnLibStream unformatted
      792     "БИК" chr(32) buf_fin-bank.bik fill(chr(32), 5)
      793     "ИНН" chr(32) buf_fin-bank.inn fill(chr(32), 5)
      794     "КПП" chr(32) buf_fin-bank.kpp fill(chr(32), 5)
      795     skip
      796     "Корр.счет"  chr(32) buf_fin-bank.cor-acc skip
      797     "Наим. банка" chr(32) buf_fin-bank.bank-name skip
      798     "Кратк. назв." chr(32)  buf_fin-bank.short-name  skip
      799     "Лицензия" chr(32) buf_fin-bank.licenz skip
      800     "Адрес юрид." chr(32) entry(1, buf_fin-bank.addres, chr(4)) skip
      801     "Адрес почт." chr(32) buf_fin-bank.addres1 skip
      802     "Телефон" chr(32) buf_fin-bank.phone fill( chr(32), 5)
      803     "Факс" chr(32) buf_fin-bank.fax skip
      804     "E-mail" chr(32) buf_fin-bank.e-mail skip
      805     "ОКАТО" chr(32) buf_fin-bank.okato  fill ( chr(32), 5)
      806     "ОКОНХ" chr(32) buf_fin-bank.okonx fill ( chr(32), 5)
      807     "ОКПО" chr(32)  buf_fin-bank.okpo format "X(10)" skip
      808     "Примечания" chr(32)   buf_fin-bank.PS
      809     skip.
      810     HIDE  STREAM PrnLibStream FRAME BottomFrame .
      811     output  STREAM PrnLibStream CLOSE.
      812     run waitfram-hide in this-procedure .
      813     run prn-lib-prn-file in this-procedure (
      814                                               input parParentProc
      815                                               ,input 8
      816                                               ).
      817   end.
