      822   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      823   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      824   procedure paramls-clear :
      825     define buffer buf_temp-param for temp-param .
      826     do
      827     on error undo, return error return-value
      828     :
      829       for each buf_temp-param
      830       on error undo, return error
      831       :
      832         delete buf_temp-param .
      833       end.
      834     end.
      835   end procedure.
      836   procedure paramls-write :
      837     define input  parameter p-code     as character no-undo .
      838     define input  parameter p-sub-code as character no-undo .
      839     define input  parameter p-value    as character no-undo .
      840     define buffer buf_temp-param for temp-param .
      841     do
      842     on error undo, return error return-value
      843     :
      844       find first buf_temp-param
      845         where buf_temp-param.param-code     = p-code
      846           and buf_temp-param.param-sub-code = p-sub-code
      847         no-error .
      848       if not available buf_temp-param then do:
      849         create buf_temp-param .
      850         assign
      851           buf_temp-param.param-code     = p-code
      852           buf_temp-param.param-sub-code = p-sub-code
      853         .
      854       end.
      855       assign
      856         buf_temp-param.param-value = p-value
      857       .
      858     end.
      859   end procedure.
      860   procedure paramls-read :
      861     define input  parameter p-code          as character no-undo .
      862     define input  parameter p-sub-code      as character no-undo .
      863     define input  parameter p-default-value as character no-undo .
      864     define output parameter p-value         as character no-undo .
      865     define buffer buf_temp-param for temp-param .
      866     do
      867     on error undo, return error return-value
      868     :
      869       find first buf_temp-param
      870         where buf_temp-param.param-code     = p-code
      871           and buf_temp-param.param-sub-code = p-sub-code
      872         no-error .
      873       if available buf_temp-param then do:
      874         assign
      875           p-value = buf_temp-param.param-value
      876         .
      877       end.
      878       else do:
      879         assign
      880           p-value = p-default-value
      881         .
      882       end.
      883     end.
      884   end procedure.
      885   procedure paramls-append :
      886     define input  parameter p-code     as character no-undo .
      887     define input  parameter p-sub-code as character no-undo .
      888     define input  parameter p-value    as character no-undo .
      889     define buffer buf_temp-param for temp-param .
      890     do
      891     on error undo, return error return-value
      892     :
      893       find first buf_temp-param
      894            where buf_temp-param.param-code     = p-code
      895              and buf_temp-param.param-sub-code = p-sub-code
      896         no-error .
      897       if not available buf_temp-param then do:
      898         create buf_temp-param .
      899         assign
      900           buf_temp-param.param-code     = p-code
      901           buf_temp-param.param-sub-code = p-sub-code
      902           buf_temp-param.param-value    = p-value
      903         .
      904       end.
      905       else do:
      906           assign
      907               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      908           .
      909       end.
      910     end.
      911   end procedure.
      912   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      913     if num-entries(string(p-dec), '.') = 2
      914       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      915       else return( string(p-dec)) .
      916   end function.
      917   function format-point-to-comma returns char (input orig as char ) .
      918   define variable rtext as character no-undo .
      919   define variable strt as integer no-undo .
      920   define variable leng as integer no-undo .
      921   assign rtext = orig .
      922   repeat:
      923     strt =  index(rtext,'.').
      924     if strt = 0 then leave.
      925     leng = 1.
      926     substring(rtext,strt,leng,"character") = v-delim .
      927   end.
      928   return rtext.
      929   end function.
      930   function format-excel-text returns char ( input start-text as char ) :
      931   def var  i    as int no-undo.
      932   def var  ch   as char no-undo.
      933   def var  n    as int no-undo.
      934   def var  ipos as int no-undo.
      935     n = num-entries(trim(start-text), chr(10)) - 1 .
      936     do i = 1 to n :
      937       ipos = index( start-text, chr(10)).
      938       if ipos > 0 then
      939         substr( start-text, ipos, 1 ) = ' '.
      940     end.
      941     n = num-entries(trim(start-text), chr(13)) - 1 .
      942     do i = 1 to n :
      943       ipos = index( start-text, chr(13)).
      944       if ipos > 0 then
      945         substr( start-text, ipos, 1 ) = ' '.
      946     end.
      947     if index( start-text, '"' ) = 0 then
      948       start-text =  '="'   + trim( start-text) + '"'   .
      949       else do:
      950         n = num-entries(trim(start-text), '"') - 1.
      951         do i = 1 to n :
      952           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      953         end.
      954         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      955         start-text = '="'  + ch  + '"' .
      956       end.
      957     return start-text.
      958   end.
      959   function excel-sum returns char (input p-dec as decimal ).
      960     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      961   end function.
      962   function excel-qnty returns char (input p-dec as decimal ).
      963     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      964   end function.
      965   function format-excel-text-macr returns char ( input start-text as char ) :
      966   def var  i    as int no-undo.
      967   def var  ch   as char no-undo.
      968   def var  n    as int no-undo.
      969   def var  ipos as int no-undo.
      970     n = num-entries(trim(start-text), chr(10)) - 1 .
      971     do i = 1 to n :
      972       ipos = index( start-text, chr(10)).
      973       if ipos > 0 then
      974         substring( start-text, ipos , 1 ) = ' '.
      975     end.
      976     n = num-entries(trim(start-text), chr(13)) - 1 .
      977     do i = 1 to n :
      978       ipos = index( start-text, chr(13)).
      979       if ipos > 0 then
      980         substring( start-text, ipos, 1 ) = ' '.
      981     end.
      982     if index( start-text, '"' ) = 0 then
      983       start-text =  '"'   + trim( start-text) + '"'   .
      984       else do:
      985         n = num-entries(trim(start-text), '"') - 1.
      986         do i = 1 to n :
      987           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      988         end.
      989         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      990         start-text = '"'  + ch  + '"' .
      991       end.
      992     n = num-entries(trim(start-text), chr(10)) - 1 .
      993     do i = 1 to n :
      994       ipos = index( start-text, chr(10)).
      995       if ipos > 0 then
      996         substring( start-text, ipos , 1 ) = ' '.
      997     end.
      998       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      999     return start-text.
     1000   end.
     1001   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1002   function func-get-name-from-ext-type   returns char
     1003     ( p-ext-type as character   ,
     1004       p-caps     as logical ).
     1005   define variable v-ext-name as character no-undo .
     1006   run get-name-from-ext-type in this-procedure (
     1007       input p-ext-type  ,
     1008       input p-caps  ,
     1009       output v-ext-name )
     1010       no-error .
     1011       if error-status :error then do:
     1012          assign
     1013            v-ext-name = p-ext-type
     1014          .
     1015       end.
     1016    return (v-ext-name) .
     1017   end.
     1018   procedure get-name-from-ext-type :
     1019    do
     1020    on error undo, return error return-value
     1021    :
     1022   define input  parameter p-ext-type as character no-undo .
     1023   define input  parameter p-caps     as logical no-undo   .
     1024   define output parameter p-ext-name as character no-undo .
     1025   define variable v-num as integer no-undo .
     1026     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
     1027       message
     1028         vss-include-info10 skip
     1029         "Неправильно задано значение входящего параметра! "
     1030         "Нет такого типа документов " p-ext-type
     1031         view-as alert-box error .
     1032         undo, return error .
     1033     end.
     1034     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
     1035     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
     1036     if p-caps  = true then do :
     1037        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
     1038     end .
     1039     end.
     1040   end procedure.
     1041   Make-Excel      = true.
     1042   Make-Excel-com  = false .
     1043   define buffer buf_abc-analysis            for ub.abc-analysis.
     1044   define buffer buf_abc-analysis-goods      for ub.abc-analysis-goods.
     1045   define buffer buf_abc-analysis-gds-obj    for ub.abc-analysis-gds-obj.
     1046   define buffer buf_abc-analysis-obj        for ub.abc-analysis-obj.
     1047   define buffer buf_assortment-matrix       for ub.assortment-matrix.
     1048   define buffer buf_assortment-matrix-goods for ub.assortment-matrix-goods.
     1049   define buffer buf_gds-obj-prop            for ub.gds-obj-prop.
     1050   define buffer buf_criterion-analysis      for ub.criterion-analysis.
     1051   DEFINE temp-table temp-str no-undo
     1052     field   gds-code           as integer
     1053     field   artic              as char
     1054     field   gds-name           as char
     1055     field   acc_min            as char
     1056     field   acc_matr           as char
     1057     field   izt                as char
     1058   .
     1059   define temp-table temp-abc no-undo
     1060     field nn           as integer
     1061     field id           as integer
     1062     field  db-num      like ub.abc-analysis.db-num
     1063     field  name        like ub.abc-analysis.abc-name
     1064     field  des         like ub.abc-analysis.abc-des
     1065     field  name-cral   like ub.criterion-analysis.cral-name
     1066     field  A           like ub.abc-analysis.abc-a
     1067     field  B           like ub.abc-analysis.abc-b
     1068     field  C           like ub.abc-analysis.abc-c
     1069     field  D           like ub.abc-analysis.abc-d
     1070     field  E           like ub.abc-analysis.abc-E
     1071     field  F           like ub.abc-analysis.abc-F
     1072     field  date-cr     like ub.abc-analysis.abc-date-create
     1073     field  period       as character
     1074     field  ext-doc-type as character
     1075     field  obj          as character
     1076     index pi nn
     1077     index pi2 id db-num
     1078   .
     1079   define variable var-i as integer   no-undo .
     1080   define variable var-kol as integer   no-undo .
     1081   var-kol = num-entries (p-rez).
     1082   repeat var-i = 1 to var-kol :
     1083      find first buf_abc-analysis no-lock where recid(buf_abc-analysis) = int(entry(var-i,p-rez )) no-error .
     1084      if not available buf_abc-analysis  then next.
     1085      find first  buf_criterion-analysis no-lock where buf_criterion-analysis.cral-id = buf_abc-analysis.cral-id no-error .
     1086      if not available buf_criterion-analysis  then next.
     1087       create temp-abc.
     1088       assign
     1089       temp-abc.nn           = var-i
     1090       temp-abc.id           = buf_abc-analysis.abc-id
     1091       temp-abc.db-num       = buf_abc-analysis.db-num
     1092       temp-abc.name         = buf_abc-analysis.abc-name
     1093       temp-abc.des          = buf_abc-analysis.abc-des
     1094       temp-abc.name-cral   = buf_criterion-analysis.cral-name
     1095       temp-abc.A           = buf_abc-analysis.abc-a
     1096       temp-abc.B           = buf_abc-analysis.abc-b
     1097       temp-abc.C           = buf_abc-analysis.abc-c
     1098       temp-abc.D           = buf_abc-analysis.abc-d
     1099       temp-abc.E           = buf_abc-analysis.abc-E
     1100       temp-abc.F           = buf_abc-analysis.abc-F
     1101       temp-abc.date-cr     = buf_abc-analysis.abc-date-create
     1102       temp-abc.period      = buf_abc-analysis.abc-string-period
     1103       temp-abc.ext-doc-type = ""
     1104       .
     1105       define buffer buf_abc-analysis-doc for ub.abc-analysis-doc.
     1106        for each buf_abc-analysis-doc no-lock where
     1107                 buf_abc-analysis-doc.abc-id = buf_abc-analysis.abc-id and
     1108                 buf_abc-analysis-doc.db-num = buf_abc-analysis.db-num
     1109        :
     1110        temp-abc.ext-doc-type = temp-abc.ext-doc-type + func-get-name-from-ext-type (buf_abc-analysis-doc.abcd-ext-doc-type , true ) + "," .
     1111        end.
     1112        for each buf_abc-analysis-obj no-lock where
     1113                 buf_abc-analysis-obj.abc-id = buf_abc-analysis.abc-id and
     1114                 buf_abc-analysis-obj.db-num = buf_abc-analysis.db-num
     1115        :
     1116        temp-abc.obj = temp-abc.obj +  buf_abc-analysis-obj.obj-type + " " + string(buf_abc-analysis-obj.obj-code) + "," .
     1117        end.
     1118   end.
     1119   define stream  macr_excel .
     1120   define variable g#report-num  as integer   no-undo .
     1121   define variable v-file-name as character no-undo .
     1122   define variable p-file-name as character no-undo .
     1123   define variable v-ind       as integer   no-undo .
     1124   define variable num#col#    as integer no-undo .
     1125   define variable C-c         as integer no-undo .
     1126   define variable C-str       as character no-undo .
     1127   define variable str--1      as character Format "x(60)" no-undo.
     1128   define variable str--2      as integer no-undo .
     1129   define variable C-i         as integer no-undo .
     1130   define variable p-var       as integer no-undo .
     1131   define variable var-1       as integer no-undo .
     1132   define variable var-2       as integer no-undo .
     1133   def buffer buf_clients for ub.clients .
     1134   def buffer This_Object for ub.clients .
     1135   def buffer buf_goods   for ub.goods .
     1136   define variable qnty as decimal   no-undo .
     1137   define variable sum  as decimal   no-undo .
     1138   define variable vv-qnty1 as decimal   no-undo .
     1139   define variable vv-qnty2 as decimal   no-undo .
     1140   define variable num-ln as integer   no-undo .
     1141   def var i as int no-undo.
     1142   def var j as int no-undo.
     1143   define variable Counter1 as integer init 0  no-undo .
     1144   def var LineBuf       as char    no-undo.
     1145   def var Line       as char    no-undo.
     1146   def var UndLine    as char    no-undo.
     1147   def var Lines_Counter as   int  init 0  no-undo.
     1148   def var Tmp_Counter   as   int  init 0  no-undo.
     1149   def var tdoc-date     as date      no-undo .
     1150   def var tdoc-code     as character no-undo .
     1151   def var  abbr              as  char no-undo.
     1152   def var  pp                as  char no-undo.
     1153     if session:set-wait-state("compiler") then.
     1154     define variable v-prn0 as character no-undo .
     1155     if var-report-r-b = "rubl" then assign pp = "Цены руб.".
     1156                                else assign pp = "Цены  баз.вал." .
     1157   define variable v-account as integer init 0 no-undo .
     1158   define variable v-account-lavel as character no-undo .
     1159   define variable v-button-stop as logical no-undo .
     1160   define variable v-kol-spice as integer no-undo .
     1161   define variable v-kol-spice2 as integer no-undo .
     1162   define variable v-kol-spice3 as integer no-undo .
     1163   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1164   DEFINE BUTTON StopBtn AUTO-END-KEY
     1165        LABEL "Стоп"
     1166        SIZE 10 BY 1.
     1167   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1168        LABEL "Обработано записей"
     1169         VIEW-AS TEXT
     1170        SIZE 14 BY .67 NO-UNDO.
     1171   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1172         VIEW-AS TEXT
     1173        SIZE 53.25 BY .67
     1174        FGCOLOR 1  NO-UNDO.
     1175   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1176         VIEW-AS TEXT
     1177        SIZE 53.25 BY .67
     1178        FGCOLOR 1  NO-UNDO.
     1179   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1180         VIEW-AS TEXT
     1181        SIZE 53.25 BY .67
     1182        FGCOLOR 1  NO-UNDO.
     1183   DEFINE RECTANGLE RECT-1
     1184        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1185        SIZE 55.13 BY 4.46.
     1186   DEFINE FRAME InfoFrame
     1187        StopBtn AT ROW 4.25 COL 21.75
     1188        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1189        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1190        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1191        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1192        RECT-1 AT ROW 1 COL 1
     1193       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1194            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1195            TITLE "Процесс"
     1196            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1197   define variable mFrameView      as logical   no-undo init yes.
     1198     define variable mFramHandle as handle no-undo.
     1199     mFramHandle = frame InfoFrame:handle.
     1200     if  log-manager:logfile-name ne ?
     1201     then DO:
     1202         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1203         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1204         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1205     end.
     1206     mFrameView = not session:batch-mode and mFramHandle:visible.
     1207     if mFrameView
     1208     then do:
     1209       ASSIGN
     1210          FRAME InfoFrame:HIDDEN                           = TRUE
     1211          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1212     end.
     1213   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1214   DO:
     1215     IF not StopProcessing THEN
     1216       Message "Вы действительно хотите прервать" SKIP
     1217               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1218                 UPDATE StopProcessing.
     1219     IF StopProcessing THEN do:
     1220        if mFrameView
     1221        then do:
     1222           HIDE FRAME InfoFrame.
     1223        end.
     1224     End.
     1225   END.
     1226   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     1227     if  log-manager:logfile-name ne ?
     1228     then DO:
     1229         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1230     end.
     1231     if not session:batch-mode then
     1232     do:
     1233       VIEW FRAME InfoFrame.
     1234       mFrameView = true.
     1235     end.
     1236      v-button-stop = false .
     1237         if mFrameView
     1238         then do:
     1239         if v-button-stop then view STOPBTN in frame InfoFrame.
     1240                          else Hide STOPBTN in frame InfoFrame.
     1241         end.
     1242   v-ind = 0    .
     1243       Output stream Macr_Excel  close .
     1244       num#str# = 0 .
     1245       run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     1246       output stream macr_excel to value(v-file-name)   .
     1247       v-ind = v-ind + 1.
     1248    run get-report-num  in parParentProc(output g#report-num).
     1249       define stream  Stream-rpt .
     1250       p-file-name =  string( session:temp-directory +
     1251                     "rpt" + string( g#report-num ) + ".txt" ) .
     1252       output stream stream-rpt to value(p-file-name)   .
     1253       output stream stream-rpt close  .
     1254     run PrintTitul in this-procedure .
     1255     for each temp-str :  delete temp-str.  end.
     1256     run make-tt.
     1257     for each temp-str no-lock :
     1258          run print-line in this-procedure .
     1259     end.
     1260     run PrintPodval in this-procedure .
     1261     run paramls-write in this-procedure
     1262       (input "file"
     1263       ,input string(v-ind)
     1264       ,input v-file-name
     1265       ) .
     1266   Output stream Macr_Excel  close .
     1267   if mFrameView
     1268   then do:
     1269      HIDE FRAME InfoFrame.
     1270   end.
     1271       run paramls-write in this-procedure
     1272           (input "charcol"
     1273           ,input ""
     1274           ,input "1,3,4,5,6"
     1275           ) .
     1276     run end-proc in this-procedure .
     1277     run rep/runexcel.p (p-file-name ).
     1278   procedure print-line :
     1279     do on error undo, return error return-value :
     1280   num#str# = num#str# + 1.
     1281   num#col# = 1.
     1282   run macr_excel_char ( temp-str.artic     , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1283   run macr_excel_char ( temp-str.gds-code  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1284   run macr_excel_char ( temp-str.gds-name  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1285   run macr_excel_char ( temp-str.acc_min   , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1286   run macr_excel_char ( temp-str.acc_matr  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1287   run macr_excel_char ( temp-str.izt       , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1288   for each temp-abc:
     1289     find first ub.abc-analysis-goods no-lock where
     1290                ub.abc-analysis-goods.abc-id = temp-abc.id and
     1291                ub.abc-analysis-goods.db-num = temp-abc.db-num and
     1292                ub.abc-analysis-goods.gds-code = temp-STR.gds-code no-error .
     1293     if available ub.abc-analysis-goods then do:
     1294        run macr_excel_char ( ub.abc-analysis-goods.abcg-abc                , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1295        run macr_excel_DEC ( ub.abc-analysis-goods.abcg-prcnt-for-estimate , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1296        run macr_excel_DEC ( ub.abc-analysis-goods.abcg-sum-for-estimate   , num#str# , num#col#   ) .
     1297   define variable v-color as integer   no-undo .
     1298       if ub.abc-analysis-goods.abcg-abc = "A" then
     1299          assign
     1300            v-color = 3
     1301          .
     1302       if ub.abc-analysis-goods.abcg-abc = "C" then
     1303          assign
     1304            v-color = 0
     1305          .
     1306       if ub.abc-analysis-goods.abcg-abc = "B" then
     1307          assign
     1308             v-color = 41
     1309          .
     1310       if ub.abc-analysis-goods.abcg-abc = "D" then
     1311          assign
     1312            v-color = 14
     1313          .
     1314       if ub.abc-analysis-goods.abcg-abc = "E" then
     1315          assign
     1316            v-color = 13
     1317          .
     1318       if ub.abc-analysis-goods.abcg-abc = "F" then
     1319          assign
     1320             v-color = 48
     1321          .
     1322      put  stream macr_excel unformatted
     1323           substitute('select("r&1c&2:r&3c&4 ")' , num#str# , num#col# - 2 , num#str# , num#col# ) + chr(10)
     1324           substitute('font.properties(,,,,,,,,,&1,,,)', v-color ) + chr(10) .
     1325        assign    num#col# = num#col# + 1 .
     1326     end.
     1327     ELSE
     1328     num#col# = num#col# + 3 .
     1329   end.
     1330     end.
     1331   end procedure.
     1332   procedure print-all-itog :
     1333   end procedure.
     1334   procedure PrintTitul :
     1335     do  on error undo, return error return-value  :
     1336     define variable cc as integer no-undo .
     1337     define variable tt as integer no-undo .
     1338       num#str# = num#str# + 1.
     1339       num#col# = 2.
     1340       cc = num#str# .
     1341       run macr_excel_char ( "Сравнение ABC анализов"  , num#str# , num#col#   ) .
     1342       num#str# = num#str# + 1.
     1343       num#col# = 2.
     1344       run macr_excel_char ("Печать " + cur-time-date()  , num#str# , num#col#   ) .
     1345       run macr_cell_format
     1346           ( 12     ,
     1347             true   ,
     1348             false  ,
     1349             ?      ,
     1350             cc     ,
     1351             2      ,
     1352             num#str# ,
     1353             2 ) .
     1354       run pshap in this-procedure .
     1355        num#str# = num#str# + 1.
     1356       num#col# = 1.
     1357       run macr_excel_char ( "Артикул товара"   , num#str# , num#col#   ) .
     1358       run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1359       num#col# = 2.
     1360       run macr_excel_char ( "Код"   , num#str# , num#col#   ) .
     1361       run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1362       num#col# = 3.
     1363       run macr_excel_char ( "Наименование товара"   , num#str# , num#col#   ) .
     1364       run macr_cell_size ( 25 , ? , num#str# , num#col# , ?, ? ) .
     1365       num#col# = 4.
     1366       run macr_excel_char ( "Ассортиментный минимум"   , num#str# , num#col#   ) .
     1367       run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1368       num#col# = 5.
     1369       run macr_excel_char ( "Ассортиментная матрица"   , num#str# , num#col#   ) .
     1370       run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1371       num#col# = 6.
     1372       run macr_excel_char ( "ИЖТ"   , num#str# , num#col#   ) .
     1373       run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1374       for each temp-abc :
     1375           num#col# = num#col# + 1.
     1376           run macr_excel_char ( "Анализ № " + string(temp-abc.nn) , num#str# , num#col#   ) .
     1377           run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1378           num#col# = num#col# + 1.
     1379           run macr_excel_char (  "%"  , num#str# , num#col#   ) .
     1380           run macr_cell_size ( 5 , ? , num#str# , num#col# , ?, ? ) .
     1381           num#col# = num#col# + 1.
     1382           run macr_excel_char ( "Сумма по критерию"  , num#str# , num#col#   ) .
     1383           run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1384           if temp-abc.nn modulo 2 = 0 then do:
     1385               run macr_cell_format
     1386               ( 10    ,
     1387                 true  ,
     1388                 false  ,
     1389                 33    ,
     1390                 num#str# ,
     1391                 num#col# - 2 ,
     1392                 num#str# ,
     1393                 num#col# ) .
     1394           end.
     1395           else do:
     1396               run macr_cell_format
     1397               ( 10    ,
     1398                 true  ,
     1399                 false  ,
     1400                 34    ,
     1401                 num#str# ,
     1402                 num#col# - 2 ,
     1403                 num#str# ,
     1404                 num#col# ) .
     1405           end.
     1406       end.
     1407       run macr_cell_format
     1408       ( 10    ,
     1409         true  ,
     1410         false  ,
     1411         ?    ,
     1412         num#str# ,
     1413         1 ,
     1414         num#str# ,
     1415         14 ) .
     1416        put  stream macr_excel unformatted
     1417          substitute('select("r&1c&2:r&3c&4 ")' , num#str# , 1 , num#str# ,  num#col# ) + chr(10)  +
     1418          'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     1419          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1420          .
     1421     end.
     1422   end procedure.
     1423   procedure PrintPodval :
     1424     do on error undo, return error return-value  :
     1425       num#str# = num#str# + 3.
     1426       num#col# = 2.
     1427       run macr_excel_char ( "Исполнитель: "   , num#str# , num#col#   ) .
     1428       num#col# = 3.
     1429       run macr_excel_char ( p-user-name  , num#str# , num#col#   ) .
     1430     end.
     1431   end procedure.
     1432   procedure make-tt :
     1433     do
     1434     on error undo, return error return-value
     1435     :
     1436   define buffer buf_abc-analysis-goods for ub.abc-analysis-goods.
     1437   define buffer buf_goods for ub.goods.
     1438   define variable  v-izt      as character no-undo .
     1439   define variable  v-acc-mat as character no-undo .
     1440   define variable  v-Amin    as character no-undo .
     1441   for each temp-abc :
     1442     for each buf_abc-analysis-goods no-lock where
     1443              buf_abc-analysis-goods.abc-id = temp-abc.id  and
     1444              buf_abc-analysis-goods.db-num = temp-abc.db-num :
     1445       if not can-find ( first temp-str where temp-str.gds-code  = buf_abc-analysis-goods.gds-code) then do:
     1446           find first buf_goods no-lock where buf_goods.gds-code =  buf_abc-analysis-goods.gds-code no-error .
     1447           create temp-str .
     1448           run proc-disp-goods (
     1449                 input buf_goods.gds-code
     1450               , output v-izt
     1451               , output v-acc-mat
     1452               , output v-Amin      ).
     1453           assign
     1454               temp-str.gds-code = buf_abc-analysis-goods.gds-code
     1455               temp-str.artic    = buf_goods.artic
     1456               temp-str.gds-name = buf_goods.gds-name
     1457               temp-str.acc_min  = v-Amin
     1458               temp-str.acc_matr = v-acc-mat
     1459               temp-str.izt      = v-izt
     1460           .
     1461       end.
     1462     end.
     1463   end.
     1464     end.
     1465    end procedure.
     1466   procedure pshap :
     1467     do
     1468     on error undo, return error return-value
     1469     :
     1470     define variable tt as integer   no-undo .
     1471       num#str# = num#str# + 1.
     1472       num#col# = 1.
     1473       tt = num#str# .
     1474       for each temp-abc :
     1475           run macr_excel_char ( "Анализ № " + string(temp-abc.nn )                , num#str# , num#col#   ) .
     1476               run macr_cell_format
     1477               ( 10    ,
     1478                 true  ,
     1479                 false  ,
     1480                 ?    ,
     1481                 num#str# ,
     1482                 num#col#  ,
     1483                 num#str# ,
     1484                 num#col# ) .
     1485           num#str# = num#str# + 1.
     1486           run macr_excel_char ( temp-abc.name               , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1487           if temp-abc.des <> "" then do:  run macr_excel_char ( temp-abc.des                , num#str# , num#col#   ) . num#str# = num#str# + 1. end.
     1488           run macr_excel_char ( temp-abc.name-cral          , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1489           run macr_excel_char ( "A=" + string( temp-abc.A )                 , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1490           run macr_excel_char ( "B=" + string( temp-abc.B )                 , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1491           run macr_excel_char ( "C=" + string( temp-abc.C )                 , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1492           if temp-abc.D > 0 then do:  run macr_excel_char ( "D=" + string(temp-abc.D )   , num#str# , num#col#   ) .    num#str# = num#str# + 1. end.
     1493           if temp-abc.E > 0 then do:  run macr_excel_char ( "E=" + string(temp-abc.E )   , num#str# , num#col#   ) .    num#str# = num#str# + 1. end.
     1494           if temp-abc.F > 0 then do:  run macr_excel_char ( "F=" + string(temp-abc.F )   , num#str# , num#col#   ) .    num#str# = num#str# + 1. end.
     1495           run macr_excel_char ( "создан : " + string(temp-abc.date-cr , "99/99/9999")            , num#str# , num#col#   ) . num#str# = num#str# + 1.
     1496           run macr_excel_char ( temp-abc.period             , num#str# , num#col#   ) .  num#str# = num#str# + 1.
     1497           run macr_excel_char ( temp-abc.ext-doc-type       , num#str# , num#col#   ) .  num#str# = num#str# + 1.
     1498           run macr_excel_char ( temp-abc.obj                , num#str# , num#col#   ) .  num#str# = num#str# + 1.
     1499       end.
     1500     end.
     1501   end procedure.
     1502   PROCEDURE proc-disp-goods :
     1503   define input  parameter p-gds-code as integer   no-undo .
     1504   define output parameter  v-izt      as character no-undo .
     1505   define output parameter  v-acc-mat as character no-undo .
     1506   define output parameter  v-Amin    as character no-undo .
     1507   define variable   v-old-izt  as character no-undo .
     1508   define variable   v-old-amin  as character no-undo .
     1509   define variable   v-old-acc-mat  as character no-undo .
     1510   define variable vt-Amin as character no-undo .
     1511   define variable v-id    as integer   no-undo .
     1512   define variable v-db-num  as integer   no-undo .
     1513   define variable t-izt as character no-undo .
     1514   define variable t-Amin as character no-undo .
     1515   define variable t-asm as character no-undo .
     1516       assign
     1517       v-old-izt  = ""
     1518       v-izt      = ""
     1519       v-Amin     = ""
     1520       v-old-Amin = ""
     1521       v-acc-mat     =  ""
     1522       v-old-acc-mat = ""
     1523       .
     1524   define buffer buf2_abc-analysis-gds-obj for ub.abc-analysis-gds-obj   .
     1525   define buffer buf2_assortment-matrix for ub.assortment-matrix.
     1526   define buffer buf2_assortment-matrix-goods for ub.assortment-matrix-goods.
     1527   define variable            v-gdop-min-stock                as decimal   no-undo .
     1528   define variable            v-grop-max-stock                as decimal   no-undo .
     1529   define variable            v-grop-level-always-presence    as decimal   no-undo .
     1530   define variable            v-grop-min-order                as decimal   no-undo .
     1531   FOR EACH Buf_abc-analysis-obj WHERE
     1532            Buf_abc-analysis-obj.abc-id = TEMP-ABC.id AND
     1533            Buf_abc-analysis-obj.db-num = TEMP-ABC.db-num
     1534            NO-LOCK ,
     1535           EACH buf2_abc-analysis-gds-obj WHERE
     1536               buf2_abc-analysis-gds-obj.obj-type = Buf_abc-analysis-obj.obj-type AND
     1537               buf2_abc-analysis-gds-obj.obj-code = Buf_abc-analysis-obj.obj-code AND
     1538               buf2_abc-analysis-gds-obj.gds-code = p-gds-code AND
     1539               buf2_abc-analysis-gds-obj.abc-id   = TEMP-ABC.id AND
     1540               buf2_abc-analysis-gds-obj.db-num   = TEMP-ABC.db-num
     1541               NO-LOCK break
     1542               by Buf2_abc-analysis-gds-OBJ.gds-code
     1543               :
     1544                   find first buf2_assortment-matrix WHERE
     1545                         buf2_assortment-matrix.asmt-status        = 0  AND
     1546                         buf2_assortment-matrix.obj-type =  Buf_abc-analysis-obj.obj-type AND
     1547                         buf2_assortment-matrix.obj-code =  Buf_abc-analysis-obj.obj-code
     1548                         NO-LOCK no-error .
     1549                   find first buf2_assortment-matrix-goods WHERE
     1550                         buf2_assortment-matrix-goods.asmg-status        = 0  AND
     1551                         buf2_assortment-matrix-goods.asmt-id  =  buf2_assortment-matrix.asmt-id AND
     1552                         buf2_assortment-matrix-goods.db-num   =  buf2_assortment-matrix.db-num  AND
     1553                         buf2_assortment-matrix-goods.gds-code =  p-gds-code
     1554                         NO-LOCK no-error .
     1555   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1556   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjpr in g#library
     1557     (input  Buf_abc-analysis-obj.obj-type
     1558     ,input  Buf_abc-analysis-obj.obj-code
     1559     ,input  ?
     1560     ,input  ?
     1561     ,input  ?
     1562     ,input  p-gds-code
     1563     ,output t-amin
     1564     ,output t-izt
     1565     ,output v-gdop-min-stock
     1566     ,output v-grop-max-stock
     1567     ,output v-grop-level-always-presence
     1568     ,output v-grop-min-order
     1569     )  .
     1570                if not available buf2_assortment-matrix-goods then t-asm = "0" .
     1571                                                              else t-asm = string(buf2_assortment-matrix-goods.asmt-id).
     1572               if first-of(Buf2_abc-analysis-gds-OBJ.gds-code) then do:
     1573                     assign
     1574                     v-old-izt  =  t-izt
     1575                     v-izt      =  t-izt
     1576                     v-Amin     =  t-amin
     1577                     v-old-Amin =  t-amin
     1578                     v-acc-mat     =  t-asm
     1579                     v-old-acc-mat =  t-asm
     1580                     .
     1581                     if  v-Amin = 'no'  then v-Amin = "не входит" .
     1582                                        else v-Amin = "входит" .
     1583                     if v-acc-mat = "0" then v-acc-mat = "не входит" .
     1584                                        else v-acc-mat = "входит" .
     1585               end.
     1586           if v-old-izt     <> t-izt            then  v-izt = "разное" .
     1587           if v-old-Amin    <> t-Amin           then  v-Amin = "разное" .
     1588           if v-old-acc-mat <> t-asm            then  v-acc-mat = "разное" .
     1589         assign
     1590           v-old-izt     = t-izt
     1591           v-old-Amin    = t-Amin
     1592           v-old-acc-mat = t-asm
     1593         .
     1594   end.
     1595   END PROCEDURE.
     1596   def var vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1597   procedure macr_excel_char :
     1598    do
     1599    on error undo, return error return-value
     1600    :
     1601    define input parameter  p-val as character no-undo .
     1602    define input parameter  p-row as integer no-undo .
     1603    define input parameter  p-col as integer no-undo .
     1604    if p-val = ? then p-val = "" .
     1605       put stream macr_excel unformatted
     1606             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1607    end.
     1608   end procedure.
     1609   procedure macr_excel_char_with_format :
     1610    do
     1611    on error undo, return error return-value
     1612    :
     1613    define input parameter  p-val as character no-undo .
     1614    define input parameter  p-row as integer no-undo .
     1615    define input parameter  p-col as integer no-undo .
     1616    if p-val = ? then p-val = "" .
     1617       put stream macr_excel unformatted
     1618             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1619       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     1620       put stream macr_excel unformatted
     1621             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1622    end.
     1623   end procedure.
     1624   procedure macr_excel_cell_format :
     1625    do
     1626    on error undo, return error return-value
     1627    :
     1628    define input parameter  p-val    as character no-undo .
     1629    define input parameter  p-row    as integer   no-undo .
     1630    define input parameter  p-col    as integer   no-undo .
     1631    define input parameter  p-format as character no-undo .
     1632    if p-val = ? then p-val = "" .
     1633       put stream macr_excel unformatted
     1634             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1635       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     1636       put stream macr_excel unformatted
     1637             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1638    end.
     1639   end procedure.
     1640   procedure macr_excel_sum :
     1641    do
     1642    on error undo, return error return-value
     1643    :
     1644    define input parameter  p-row as integer no-undo .
     1645    define input parameter  p-col as integer no-undo .
     1646    define input parameter  p-row1 as integer no-undo .
     1647    define input parameter  p-col1 as integer no-undo .
     1648    define input parameter  p-row2 as integer no-undo .
     1649    define input parameter  p-col2 as integer no-undo .
     1650       put stream macr_excel unformatted
     1651             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     1652    end.
     1653   end procedure.
     1654   procedure macr_excel_dec :
     1655    do
     1656    on error undo, return error return-value
     1657    :
     1658    define input parameter  p-val as character no-undo .
     1659    define input parameter  p-row as integer   no-undo .
     1660    define input parameter  p-col as integer   no-undo .
     1661     if p-val = ? then p-val =  "" .
     1662      put  stream macr_excel unformatted
     1663           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     1664    end.
     1665   end procedure.
     1666   procedure macr_cell_format :
     1667    do
     1668    on error undo, return error return-value
     1669    :
     1670    define input parameter  p-size   as integer   no-undo .
     1671    define input parameter  p-bold   as logical   no-undo .
     1672    define input parameter  p-italic as logical   no-undo .
     1673    define input parameter  p-color  as integer   no-undo .
     1674    define input parameter  p-row    as integer   no-undo .
     1675    define input parameter  p-col    as integer   no-undo .
     1676    define input parameter  p-row-2  as integer   no-undo .
     1677    define input parameter  p-col-2  as integer   no-undo .
     1678     if p-size = ? then p-size = 10 .
     1679     if p-bold = ? then p-bold = false .
     1680     if p-italic = ? then p-italic = false .
     1681     if p-row-2 = ? then p-row-2 = p-row .
     1682     if p-col-2 = ? then p-col-2 = p-col .
     1683     put  stream macr_excel unformatted
     1684      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     1685     if p-color <> ? then do:
     1686        put  stream macr_excel unformatted
     1687          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     1688     end.
     1689     put  stream macr_excel unformatted
     1690          substitute('format.font(,&1,&2,&3)' , p-size,
     1691                                           string ( p-bold  , "true/false" ) ,
     1692                                           string ( p-italic , "true/false" )
     1693                                           ) + chr(10) .
     1694    end.
     1695   end procedure.
     1696   procedure macr_cell_size :
     1697    do
     1698    on error undo, return error return-value
     1699    :
     1700    define input parameter  p-w   as integer   no-undo .
     1701    define input parameter  p-l   as integer   no-undo .
     1702    define input parameter  p-row    as integer   no-undo .
     1703    define input parameter  p-col    as integer   no-undo .
     1704    define input parameter  p-row-2  as integer   no-undo .
     1705    define input parameter  p-col-2  as integer   no-undo .
     1706     if p-row-2 = ? then p-row-2 = p-row .
     1707     if p-col-2 = ? then p-col-2 = p-col .
     1708     if p-w = ? then    p-w = 0 .
     1709     if p-l = ? then    p-l = 0 .
     1710    define variable s-w as character no-undo .
     1711    define variable s-l as character no-undo .
     1712    if p-w = 0 then s-w = "" .
     1713               else s-w = string(p-w)  .
     1714    if p-l = 0 then s-l = "" .
     1715               else s-l = string(p-l)  .
     1716   put  stream macr_excel unformatted
     1717        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     1718   put  stream macr_excel unformatted
     1719        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     1720   put  stream macr_excel unformatted
     1721        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     1722    end.
     1723   end procedure.
     1724   procedure proc-print-header :
     1725    do
     1726    on error undo, return error return-value
     1727    :
     1728      find first sheetf .
     1729        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     1730        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     1731        var-1 =  num#str# .
     1732        repeat c-c = 1 to sheetf.excel-row-title :
     1733        num#str# = num#str# + 1 .
     1734        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     1735        do c-i = 1 to p-var :
     1736           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     1737           str--2 = integer(entry( c-i, sheetf.sizes )) .
     1738           num#col# = c-i .
     1739           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     1740           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     1741        end.
     1742       c-i = 0.
     1743       end.
     1744       run macr_cell_format (
     1745           10       ,
     1746           true     ,
     1747           false    ,
     1748           35       ,
     1749           var-1 + 1,
     1750           1        ,
     1751           num#str# ,
     1752           num#col# )
     1753           .
     1754     put  stream macr_excel unformatted
     1755          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     1756          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1757          .
     1758    end.
     1759   end procedure.
     1760   procedure end-proc :
     1761    do
     1762    on error undo, return error return-value
     1763    :
     1764     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     1765     OUTPUT to VALUE (v-file-name) .
     1766     for each temp-param :
     1767       export  temp-param  .
     1768     end.
     1769    end.
     1770   end procedure.
