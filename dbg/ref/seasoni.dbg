        1   define input  parameter parParentProc  as widget-handle no-undo.
        2   define input  parameter p-def          as character no-undo.
        3   define input-output parameter  rr      as recid no-undo.
        4   define shared variable g#db-num as integer   no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision$":U .
        6   define variable vss-author      as character no-undo init "$Author$":U .
        7   define variable vss-date        as character no-undo init "$Date$":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        9   define variable vss-archive     as character no-undo init "$Archive$":U .
       10   define variable vss-description as character no-undo init "Корректировка сезона" .
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   procedure proc-alt-shift-f2:
       66     if not ibs.th.gbl.gbl-var:rcode
       67   then
       68     run gbl\inidebug.p .
       69   end.
       70   procedure proc-alt-shift-f3:
       71     run gbl/prvssinf.p
       72       ( input this-procedure
       73       ) .
       74   end.
       75   define variable v-inform-launched as logical no-undo initial false .
       76   procedure proc-alt-shift-f4:
       77     define variable v-action as character no-undo .
       78     if v-inform-launched = false then do:
       79       assign
       80         v-inform-launched = true
       81       .
       82       run gbl/d-inform.w
       83         (  input self
       84         ,  input this-procedure
       85         , output v-action
       86         ) no-error .
       87       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       88       assign
       89         v-inform-launched = false
       90       .
       91     end.
       92   end.
       93   procedure proc-alt-f1:
       94     run gbl/corrhelp.p
       95       (input this-procedure
       96       ) .
       97   end .
       98   on alt-shift-f2 anywhere do:
       99     run proc-alt-shift-f2.
      100   end.
      101   on alt-shift-f3 anywhere do:
      102     run proc-alt-shift-f3 in this-procedure .
      103   end.
      104   on alt-shift-f4 anywhere do:
      105     run proc-alt-shift-f4 in this-procedure.
      106   end.
      107   on alt-f1 anywhere do:
      108     run proc-alt-f1 in this-procedure .
      109   end.
      110   define new global shared variable g#language as character no-undo .
      111   if g#language <> '' and g#language <> 'rus':U then do:
      112     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      113   end.
      114   define new global shared variable g#library  as handle no-undo .
      115   define new global shared variable g#library2 as handle no-undo .
      116   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      117     define variable v-cntxt-db-num        as integer   no-undo .
      118     define variable v-cntxt-userid        as character no-undo .
      119     define variable v-cntxt-level         as character no-undo .
      120     define variable v-cntxt-host-code-obj as integer   no-undo .
      121     define variable v-cntxt-obj-type      as character no-undo .
      122     define variable v-cntxt-obj-code      as integer   no-undo .
      123     define variable v-cntxt-db-num-obj    as integer   no-undo .
      124     define variable v-cntxt-is-admin      as logical   no-undo .
      125   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      126   define temp-table userobjs_temp-user-obj no-undo
      127     field obj-type as character
      128     field obj-code as integer
      129     index xpk is primary unique obj-type obj-code
      130     .
      131   procedure userobjs_clear :
      132     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      133     do
      134     on error undo, return error return-value
      135     :
      136       for each buf_userobjs_temp-user-obj
      137       on error undo, return error return-value
      138       :
      139         delete buf_userobjs_temp-user-obj .
      140       end.
      141     end.
      142   end .
      143   procedure userobjs_object-count :
      144     define output parameter p-total-count as integer   no-undo .
      145     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      146     do
      147     on error undo, return error return-value
      148     :
      149       assign
      150         p-total-count = 0
      151       .
      152       for each buf_userobjs_temp-user-obj
      153       on error undo, return error return-value
      154       :
      155         assign
      156           p-total-count = p-total-count + 1
      157         .
      158       end.
      159     end.
      160   end.
      161   procedure userobjs_append :
      162      define input  parameter p-obj-type as character no-undo .
      163      define input  parameter p-obj-code as integer   no-undo .
      164     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      165     do
      166     on error undo, return error return-value
      167     :
      168       find first buf_userobjs_temp-user-obj
      169         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      170           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      171         no-error .
      172       if not available buf_userobjs_temp-user-obj
      173       then do:
      174         create buf_userobjs_temp-user-obj .
      175         assign
      176           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      177           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      178         .
      179       end.
      180     end.
      181   end.
      182   procedure userobjs_object-exist :
      183     define output parameter p-object-exist as logical   no-undo .
      184     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      185     do
      186     on error undo, return error return-value
      187     :
      188       find first buf_userobjs_temp-user-obj
      189         no-error .
      190       if not available buf_userobjs_temp-user-obj
      191       then do:
      192         assign
      193           p-object-exist = false
      194         .
      195       end.
      196       else do:
      197         assign
      198           p-object-exist = true
      199         .
      200       end.
      201     end.
      202   end.
      203   procedure userobjs_transfer :
      204     define input  parameter p-callback-handle as handle no-undo .
      205     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      206     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      207     do
      208     on error undo, return error return-value
      209     :
      210       if valid-handle(p-callback-handle) <> true
      211       then do:
      212         message
      213           vss-workfile vss-revision vss-description skip
      214           "Ошибка задания входных параметров" skip
      215           "Неизвестный указатель на процедуру" skip
      216           view-as alert-box error .
      217         undo, return error return-value .
      218       end.
      219       if p-callback-handle :get-signature("userobjs_append") = ""
      220       then do:
      221         message
      222           vss-workfile vss-revision vss-description skip
      223           "Ошибка задания входных параметров" skip
      224           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      225                     ,p-callback-handle :file-name
      226                     ) skip
      227           view-as alert-box error .
      228         undo, return error return-value .
      229       end.
      230       for each buf_userobjs_temp-user-obj
      231       on error undo, return error return-value
      232       :
      233         run userobjs_append in p-callback-handle
      234           (input  buf_userobjs_temp-user-obj.obj-type
      235           ,input  buf_userobjs_temp-user-obj.obj-code
      236           ) .
      237       end.
      238     end.
      239   end procedure.
      240   procedure userobjs_select-one :
      241      define input  parameter parparentproc     as widget-handle no-undo .
      242      define input  parameter p-db-num          as integer   no-undo .
      243      define input  parameter p-user-id         as character no-undo .
      244      define input  parameter p-host-code-obj   as integer   no-undo .
      245      define input  parameter p-obj-type        as character no-undo .
      246      define input  parameter p-obj-code        as integer   no-undo .
      247      define output parameter p-user-select     as logical   no-undo .
      248      define output parameter p-select-obj-type as character no-undo .
      249      define output parameter p-select-obj-code as character no-undo .
      250     do
      251     on error undo, return error return-value
      252     :
      253       run gbl/userobjs.w
      254         (input  parparentproc
      255         ,input  this-procedure :handle
      256         ,input  p-db-num
      257         ,input  p-user-id
      258         ,input  p-host-code-obj
      259         ,input  p-obj-type
      260         ,input  p-obj-code
      261         ,INPUT  "b-sel"
      262         ,output p-user-select
      263         ,output p-select-obj-type
      264         ,output p-select-obj-code
      265         ) .
      266     end.
      267   end.
      268   procedure userobjs_select-many :
      269     define input  parameter parparentproc   as widget-handle no-undo .
      270     define input  parameter p-db-num        as integer   no-undo .
      271     define input  parameter p-user-id       as character no-undo .
      272     define input  parameter p-host-code-obj as integer   no-undo .
      273     define input  parameter p-obj-type      as character no-undo .
      274     define input  parameter p-obj-code      as integer   no-undo .
      275     define output parameter p-user-select   as logical   no-undo .
      276     define variable v-select-obj-type as character no-undo .
      277     define variable v-select-obj-code as integer   no-undo .
      278     do
      279     on error undo, return error return-value
      280     :
      281       run gbl/userobjs.w
      282         (input  parparentproc
      283         ,input  this-procedure :handle
      284         ,input  p-db-num
      285         ,input  p-user-id
      286         ,input  p-host-code-obj
      287         ,input  p-obj-type
      288         ,input  p-obj-code
      289         ,INPUT  "b-sel,b-mark"
      290         ,output p-user-select
      291         ,output v-select-obj-type
      292         ,output v-select-obj-code
      293         ) .
