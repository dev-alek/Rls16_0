      295   end.
      296   procedure thobjs :
      297      define input        parameter parparentproc     as widget-handle no-undo .
      298      define input        parameter i-bttns           as character     no-undo .
      299      define input        parameter i-list-mode       as character     no-undo.
      300      define input        parameter i-obj-type        as character     no-undo.
      301      define input        parameter i-db-num          as integer       no-undo.
      302      define input        parameter i-host-code       as integer       no-undo.
      303      define input-output parameter p-rid-list        as character     no-undo .
      304   run ref/thobjs.p
      305           ( input parparentproc
      306            ,input  this-procedure :handle
      307           , input i-bttns
      308           , input i-list-mode
      309           , input i-obj-type
      310           , input i-db-num
      311           , input i-host-code
      312           , input-output p-rid-list ) no-error .
      313   end.
      314   define buffer buf_season for ub.season .
      315   define buffer season-1 for ub.season .
      316   define buffer buf_season-attr for ub.season-attr .
      317   define variable loc-month-1 as integer no-undo.
      318   define variable loc-month-2 as integer no-undo.
      319   define variable v-user-select as logical no-undo .
      320   define variable v-sel-obj-type like ub.clients.obj-type no-undo .
      321   define variable v-sel-obj-code like ub.clients.obj-code no-undo .
      322   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      323     run mainmenu_getcntxt in parparentproc
      324       (output v-cntxt-db-num
      325       ,output v-cntxt-userid
      326       ,output v-cntxt-level
      327       ,output v-cntxt-host-code-obj
      328       ,output v-cntxt-obj-type
      329       ,output v-cntxt-obj-code
      330       ,output v-cntxt-db-num-obj
      331       ,output v-cntxt-is-admin
      332       ) .
      333   PROCEDURE chk-gdssea :
      334   define input  parameter p-gds-code as integer no-undo.
      335   define input  parameter p-seaobj as character no-undo.
      336   define input  parameter p-i-date1 as integer no-undo.
      337   define input  parameter p-i-date2 as integer no-undo.
      338   define input  parameter p-rowid as rowid no-undo.
      339   define output parameter p-sea-code as integer no-undo.
      340   define output parameter p-db-num as integer no-undo.
      341   define output parameter p-ok as logical no-undo init yes.
      342   define buffer buf_season for ub.season.
      343   define buffer buf1_season for ub.season.
      344   define buffer buf1_gds-season for ub.gds-season.
      345   define buffer buf_season-attr for ub.season-attr.
      346   define buffer buf1_season-attr for ub.season-attr.
      347     for each buf1_season no-lock where ((buf1_season.sea-month-1 <= p-i-date1 and buf1_season.sea-month-2 >= p-i-date1)
      348       or (buf1_season.sea-month-1 <= p-i-date2 and buf1_season.sea-month-2 >= p-i-date2)
      349       or (buf1_season.sea-month-1 <= p-i-date1 and buf1_season.sea-month-2 >= p-i-date1))
      350       and (rowid (buf1_season) <> p-rowid or p-rowid = ?):
      351         if can-find (first buf1_season-attr where buf1_season-attr.sea-code = buf1_season.sea-code
      352                                               and buf1_season-attr.db-num = buf1_season.db-num
      353                                               and buf1_season-attr.attr-code = 'sea-obj':U
      354                                               and buf1_season-attr.attr-value = p-seaobj
      355                                               )
      356           or
      357           (not can-find (first buf1_season-attr where buf1_season-attr.sea-code = buf1_season.sea-code
      358                                                 and buf1_season-attr.db-num = buf1_season.db-num
      359                                                 and buf1_season-attr.attr-code = 'sea-obj':U
      360                                                 )
      361           and p-seaobj = "")
      362         then do:
      363           if can-find (first buf1_gds-season where  buf1_gds-season.sea-code = buf1_season.sea-code
      364                                                 and buf1_gds-season.db-num = buf1_gds-season.db-num
      365                                                 and buf1_gds-season.gds-code = p-gds-code)
      366           then do:
      367           assign
      368             p-ok = false
      369             p-sea-code = buf1_season.sea-code
      370             p-db-num = buf1_season.db-num.
      371             leave.
      372           end.
      373         end.
      374     end.
      375   END PROCEDURE.
      376   DEFINE BUTTON B-Cancel AUTO-END-KEY
      377        LABEL "&Отмена"
      378        SIZE 10 BY 1
      379        BGCOLOR 8 .
      380   DEFINE BUTTON B-Help
      381        LABEL "&Помощь"
      382        SIZE 10 BY 1
      383        BGCOLOR 8 .
      384   DEFINE BUTTON B-OK AUTO-GO
      385        LABEL "&Ввод"
      386        SIZE 10 BY 1
      387        BGCOLOR 8 .
      388   DEFINE VARIABLE loc-month-1-date AS date FORMAT "99/99/99":U
      389        LABEL "c"
      390        view-as fill-in
      391        SIZE 9.00 BY 1 NO-UNDO.
      392   DEFINE VARIABLE loc-month-2-date AS date FORMAT "99/99/99":U
      393        LABEL "по"
      394        view-as fill-in
      395        SIZE 9.00 BY 1 NO-UNDO.
      396   DEFINE VARIABLE loc-code AS INTEGER FORMAT ">>>>>>>>>9":U INITIAL 0
      397        LABEL "Код"
      398         VIEW-AS TEXT
      399        SIZE 14 BY .67
      400        FGCOLOR 1  NO-UNDO.
      401   DEFINE VARIABLE loc-name AS CHARACTER FORMAT "X(256)":U
      402        LABEL "Название"
      403        VIEW-AS FILL-IN
      404        SIZE 47.13 BY 1 NO-UNDO.
      405   DEFINE VARIABLE rs-area AS CHARACTER INIT 'sea-global':U
      406        LABEL "Сезон"
      407        VIEW-AS RADIO-SET HORIZONTAL
      408        RADIO-BUTTONS
      409             "глобальный", 'sea-global':U,
      410             "локальный", 'sea-local':U
      411        SIZE 25 BY 1 NO-UNDO.
      412   DEFINE VARIABLE obj-name AS character
      413        LABEL "Объект"
      414        VIEW-AS TEXT
      415        SIZE 7.50 BY .67
      416        FGCOLOR 1  NO-UNDO.
      417   DEFINE BUTTON B-obj
      418        IMAGE-UP FILE "btn-down-arrow":U
      419        IMAGE-DOWN FILE "btn-down-arrow":U
      420        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      421        LABEL "Объект"
      422        SIZE 3 BY 1.
      423   DEFINE FRAME Dialog-Frame
      424        B-OK AT ROW 1 COL 1
      425        B-Cancel AT ROW 1 COL 11
      426        B-Help AT ROW 1 COL 21
      427        rs-area AT ROW 2.25 COL 6.25
      428        loc-name AT ROW 4.5 COL 11.25 COLON-ALIGNED
      429        loc-month-1-date AT ROW 6 COL 11 COLON-ALIGNED
      430        loc-month-2-date AT ROW 6 COL 25 COLON-ALIGNED
      431        loc-code AT ROW 3.5 COL 11.25 COLON-ALIGNED
      432        obj-name AT ROW 7.5 COL 5.0
      433        b-obj AT ROW 7.35 COL 20.25
      434        SPACE(40.00) SKIP(1.00)
      435       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      436            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      437            TITLE "Сезон"
      438            DEFAULT-BUTTON B-OK CANCEL-BUTTON B-Cancel.
      439   ASSIGN
      440          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      441          FRAME Dialog-Frame:HIDDEN           = TRUE.
      442   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      443   DO:
      444     APPLY "END-ERROR":U TO SELF.
      445   END.
      446   ON CHOOSE OF B-OK IN FRAME Dialog-Frame
      447   DO:
      448     define variable v-ok as logical no-undo.
      449     define variable v-sea-code as integer no-undo.
      450     define variable v-db-num as integer no-undo.
      451     define variable v-longchar as longchar no-undo .
      452     define buffer buf_goods for ub.goods.
      453     define buffer buf_gds-season for ub.gds-season.
      454     Assign frame Dialog-Frame
      455       loc-code loc-month-1-date loc-month-2-date loc-name.
      456     assign
      457       loc-month-1 = integer(loc-month-1-date)
      458       loc-month-2 = integer(loc-month-2-date)
      459       .
      460     if loc-month-1 > loc-month-2 Then
      461     do:
      462       message "В интервале дат первая должна быть меньше второй ! " view-as  alert-box  error.
      463       apply "entry"  to loc-month-1-date .
      464         return no-apply.
      465        end.
      466     if loc-month-1 = ? or loc-month-2 = ? Then
      467     do:
      468       message "Значение дат не может быть пустым " view-as  alert-box  error.
      469       apply "entry"  to loc-month-1-date .
      470         return no-apply.
      471         end.
      472     if loc-name = "" then
      473     do:
      474       message "Введите название сезона ! " view-as  alert-box  error.
      475       apply "entry"  to loc-name .
      476         return no-apply.
      477         end.
      478     if obj-name = "" and rs-area = 'sea-local':U then
      479     do:
      480       message "Укажите объект локального сезона ! " view-as  alert-box  error.
      481       apply "entry"  to loc-name .
      482       return no-apply.
      483     end.
      484     for each buf_gds-season no-lock where buf_gds-season.sea-code = buf_season.sea-code
      485       and buf_gds-season.db-num = buf_season.db-num:
      486       run chk-gdssea in this-procedure
      487         ( input buf_gds-season.gds-code,
      488           input obj-name,
      489           input buf_season.sea-month-1,
      490           input buf_season.sea-month-2,
      491           input rowid (buf_season),
      492           output v-sea-code,
      493           output v-db-num,
      494           output v-ok) no-error.
      495       if not v-ok then do:
      496         find first buf_goods no-lock where buf_goods.gds-code = buf_gds-season.gds-code no-error.
      497         assign
      498           v-longchar = v-longchar +
      499             substitute ("Товар &1 &2 пересекается с сезоном &3 &4.&5", buf_goods.gds-code, buf_goods.gds-name, v-sea-code, buf_season.sea-name, chr(10))
      500           .
      501         run gbl/d-longchar.w (
      502                 ?,
      503                 'Editor_row=2\':u
      504               + 'title=Проверка товарного наполнения сезона: при изменении сезона возникли пересечения\':u
      505               + 'Editor_col=1\':u
      506               + 'Editor_width=96\':u
      507               + 'Editor_height=21\':u
      508               + 'readonly=yes\':u
      509             ,input-output v-longchar
      510             ,output v-ok ) no-error .
      511             if error-status :error then message
      512               vss-workfile vss-revision vss-description skip
      513               error-status :get-message(1) skip
      514               return-value skip
      515               "4"
      516               view-as alert-box error
      517             .
      518         assign
      519           v-longchar = "".
      520         return no-apply.
      521         end.
      522       end.
      523     if p-def = 'ДОБАВЛЕНИЕ':U then
      524     do:
      525       create buf_season.
      526       Assign
      527         buf_season.sea-code = loc-code
      528         buf_season.db-num   = v-cntxt-db-num
      529         .
      530         end.
      531     find first buf_season-attr exclusive-lock where buf_season-attr.sea-code = buf_season.sea-code and buf_season-attr.attr-code = 'sea-obj':U no-error.
      532     if rs-area = 'sea-global':U then do:
      533       if available buf_season-attr then do:
      534         delete buf_season-attr.
      535       end.
      536     end.
      537     else do:
      538       if not available buf_season-attr then do:
      539         create buf_season-attr.
      540         assign
      541           buf_season-attr.db-num = v-cntxt-db-num
      542         .
      543       end.
      544          Assign
      545         buf_season-attr.sea-code = buf_season.sea-code
      546         buf_season-attr.attr-code = 'sea-obj':U
      547         buf_season-attr.attr-value = obj-name
      548            .
      549       end.
      550     if p-def = 'ДОБАВЛЕНИЕ':U OR p-def = 'ИЗМЕНЕНИЕ':U  then do:
      551          Assign
      552         buf_season.sea-name    = loc-name
      553         buf_season.sea-month-1 = integer(loc-month-1-date)
      554         buf_season.sea-month-2 = integer(loc-month-2-date)
      555         rr                 = recid(buf_season)
      556           .
      557     end.
      558       else rr = ? .
      559   END.
      560   ON CHOOSE OF B-obj IN FRAME Dialog-Frame
      561   DO:
      562   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      563   run userobjs_select-one in this-procedure
      564     (input  parparentproc
      565     ,input  v-cntxt-db-num
      566     ,input  v-cntxt-userid
      567     ,input  v-cntxt-host-code-obj
      568     ,input  v-cntxt-obj-type
      569     ,input  v-cntxt-obj-code
      570     ,output v-user-select
      571     ,output v-sel-obj-type
      572     ,output v-sel-obj-code
      573     )  .
      574     obj-name:screen-value in frame Dialog-Frame = if v-sel-obj-code <> 0 then string (v-sel-obj-type) + string (v-sel-obj-code) else "".
      575     assign
      576       obj-name.
      577   END.
      578   ON VALUE-CHANGED OF rs-area IN FRAME Dialog-Frame
      579   DO:
      580     assign rs-area.
      581     if rs-area = 'sea-global':U then do:
      582       DISABLE
      583         B-obj with frame Dialog-Frame.
      584       obj-name = "".
      585       DISPLAY obj-name with frame Dialog-Frame.
      586     end.
      587     else do:
      588       ENABLE
      589         B-obj with frame Dialog-Frame.
      590       obj-name = "".
      591       DISPLAY obj-name with frame Dialog-Frame.
      592     end.
      593   END.
      594   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      595   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      596   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      597   on help of frame Dialog-Frame
      598   do:
      599     run gbl/app_help.p
      600       (input this-procedure :file-name
      601       ,input ''
      602       ,input ?
      603       ) no-error.
      604     if error-status :error then do:
      605       message
      606         "Ошибка при вызове помощи"
      607         error-status :get-message(1)
      608         view-as alert-box .
      609     end.
      610   end.
      611   run minbtn-set in this-procedure .
      612   on choose of b-help in frame Dialog-Frame
      613   do:
      614     apply "help":u to frame Dialog-Frame .
      615   end.
      616   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      617   procedure minbtn-set :
      618       do
      619           on error undo, return error return-value
      620           :
      621           define variable ii              as integer       no-undo .
      622           define variable fh              as widget-handle no-undo .
      623           define variable hh              as widget-handle no-undo .
      624           define variable v-h             as handle        extent 4 no-undo .
      625           define variable v-name-button   as character     no-undo .
      626           define variable v-help-old-x    as decimal       no-undo .
      627           define variable v-help-old-y    as decimal       no-undo .
      628           define variable v-help-old-size as decimal       no-undo .
      629           define variable v-frame-width   as decimal       no-undo .
      630           define variable jj              as integer       no-undo .
      631           do
      632               on error undo, return error
      633               :
      634               assign
      635                   v-frame-width = frame Dialog-Frame:width - 0.3
      636                   fh            = frame Dialog-Frame:first-child
      637                   hh            = fh:first-child
      638                   ii            = 1
      639                   .
      640               do while valid-handle(hh):
      641                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      642                   do:
      643                       case lc(hh:name) :
      644                           when "b-help" then
      645                               do:
      646                                   hh:load-image-up("cmp/b-help.bmp":u) .
      647                                   hh:load-image-down("cmp/b-help.bmp":u) .
      648                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      649                                   hh:TOOLTIP = "Помощь" .
      650                                   v-help-old-x = hh:column .
      651                                   v-help-old-y = hh:row    .
      652                                   v-help-old-size = hh:width .
      653                                   hh:width-chars = 2.5 .
      654                               end.
      655                           when "b-print" then
      656                               do:
      657                                   hh:load-image("cmp/b-print.bmp":u) .
      658                                   hh:TOOLTIP = "Печать" .
      659                                   v-h[ii] = hh:handle .
      660                                   ii = ii + 1 .
      661                                   hh:width-chars = 3 .
      662                               end.
      663                           when "b-history" or
      664                           when "b-hist" then
      665                               do:
      666                                   hh:load-image("cmp/b-hist.bmp":u) .
      667                                   hh:TOOLTIP = "История" .
      668                                   v-h[ii] = hh:handle .
      669                                   ii = ii + 1 .
      670                                   hh:width-chars = 3 .
      671                               end.
      672                           when "b-sch" then
      673                               do:
      674                                   hh:load-image("cmp/b-sch.bmp":u) .
      675                                   hh:TOOLTIP = "Установка Фильтра" .
      676                                   v-h[ii] = hh:handle .
      677                                   ii = ii + 1 .
      678                                   hh:width-chars = 3 .
      679                               end.
      680                           when "b-hist-user" then
      681                               do:
      682                                   hh:load-image("cmp/b-hist.bmp":u) .
      683                                   hh:TOOLTIP = "История пользователя" .
      684                                   ii = ii + 1 .
      685                               end.
      686                       end case.
      687                   end.
      688                   hh = hh:next-sibling.
      689               end.
      690               b-help:column = v-frame-width - b-help:width-chars.
      691               jj = 0.
      692               repeat ii = 4 to 1 by -1 :
      693                   if valid-handle (v-h[ii] ) then
      694                   do:
      695                       jj  = jj + 1 .
      696                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      697                       v-h[ii]:row    = v-help-old-y .
      698                   end.
      699               end.
      700           end.
      701       end.
      702   end procedure.
      703   assign frame Dialog-Frame:title = "Сезон - " + p-def.
      704   MAIN-BLOCK:
      705   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      706      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      707     run enable_UI in this-procedure .
      708     run local-init in this-procedure  no-error .
      709         if error-status :error then return error.
      710     WAIT-FOR GO OF FRAME Dialog-Frame.
      711   END.
      712   run disable_UI in this-procedure .
      713   PROCEDURE disable_UI :
      714     HIDE FRAME Dialog-Frame.
      715   END PROCEDURE.
      716   PROCEDURE enable_UI :
      717     DISPLAY loc-name loc-month-1-date loc-month-2-date loc-code b-obj obj-name rs-area
      718         WITH FRAME Dialog-Frame.
      719     ENABLE B-OK B-Cancel B-Help loc-name loc-month-1-date loc-month-2-date loc-code b-obj obj-name rs-area
      720         WITH FRAME Dialog-Frame.
      721     VIEW FRAME Dialog-Frame.
      722   END PROCEDURE.
      723   PROCEDURE local-init :
      724   if Lookup(p-def, 'ДОБАВЛЕНИЕ':U + "," + 'ПРОСМОТР':U + "," +  'ИЗМЕНЕНИЕ':U)  = 0 then return error.
      725     if p-def = 'ИЗМЕНЕНИЕ':U then
      726     do:
      727       find first buf_season where recid(buf_season) = rr  exclusive-lock  no-error .
      728         if error-status :error then return error.
      729       find first buf_season-attr exclusive-lock where buf_season-attr.sea-code = buf_season.sea-code and buf_season-attr.attr-code = 'sea-obj':U no-error.
      730       DISABLE
      731         B-obj obj-name rs-area with frame Dialog-Frame.
      732       if available buf_season-attr then do:
      733         rs-area = 'sea-local':U.
      734         obj-name:screen-value in frame Dialog-Frame = buf_season-attr.attr-value.
      735         assign
      736           obj-name.
      737     end.
      738       else do:
      739         rs-area = 'sea-global':U.
      740         if g#db-num <> 0 then disable b-ok with frame Dialog-Frame.
      741       end.
      742     end.
      743     if p-def = 'ПРОСМОТР':U then
      744     do:
      745       find first buf_season where recid(buf_season) = rr  no-lock  no-error .
      746         if error-status :error then return error.
      747     end.
      748     if available buf_season then
      749     do:
      750           assign
      751         loc-code         = buf_season.sea-code
      752         loc-name         = buf_season.sea-name
      753         loc-month-1      = buf_season.sea-month-1
      754         loc-month-2      = buf_season.sea-month-2
      755         loc-month-1-date = date (buf_season.sea-month-1)
      756         loc-month-2-date = date (buf_season.sea-month-2)
      757             .
      758       end.
      759     else
      760     do:
      761       if p-def = 'ДОБАВЛЕНИЕ':U then
      762       do:
      763         assign
      764           loc-code = next-value ( s-casm , ub )
      765           loc-code:screen-value in frame Dialog-Frame = string(loc-code)
      766         .
      767         disable b-obj with frame Dialog-Frame.
      768         if g#db-num <> 0 then do:
      769           rs-area = 'sea-local':U.
      770           display rs-area with frame Dialog-Frame.
      771           disable rs-area with frame Dialog-Frame.
      772           enable b-obj with frame Dialog-Frame.
      773         end.
      774           end.
      775       end.
      776     DISPLAY loc-name loc-month-1-date loc-month-2-date loc-code rs-area
      777         WITH FRAME Dialog-Frame.
      778   END PROCEDURE.
