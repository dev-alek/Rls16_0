     1154         return no-apply.
     1155       end.
     1156       else do:
     1157         assign
     1158           tt-clients.reg-code = buf_regions.reg-code
     1159         .
     1160         display
     1161           tt-clients.reg-code
     1162         with frame Dialog-Frame.
     1163       end.
     1164     end.
     1165   END.
     1166   ON CHOOSE OF B-sysconf IN FRAME Dialog-Frame
     1167   DO:
     1168   define variable v-ok as logical no-undo.
     1169   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1170   do:
     1171     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1172       (input  v-cntxt-db-num
     1173       ,input  v-cntxt-userid
     1174       ,input  0
     1175       ,input  'actn_host-reference_lookup':U
     1176       ,input  'global':U
     1177       ,input  0
     1178       ,input  '':U
     1179       ,input  0
     1180       ,input  0
     1181       ,input  0
     1182       ,input  0
     1183       ,input  true
     1184       ,output v-ok
     1185       )  .
     1186   end.
     1187       if v-ok <> true
     1188       then do:
     1189         return no-apply.
     1190       end.
     1191       run adm/config.w
     1192         (input  parParentProc
     1193         ,input  tt-firm.firm-code
     1194         ,input  'ПРОСМОТР':U
     1195         ,input  no
     1196         ) no-error.
     1197       if error-status :error
     1198       then do:
     1199         return no-apply.
     1200       end.
     1201   END.
     1202   ON CHOOSE OF Docs IN FRAME Dialog-Frame
     1203   DO:
