     1921   PROCEDURE Proc-save :
     1922   define variable v-no-check-inn as logical no-undo .
     1923   define variable ii as integer no-undo .
     1924   define variable v-return-value as character no-undo .
     1925   define variable glog as logical no-undo .
     1926   if p-mode = 'ДОБАВЛЕНИЕ':U then
     1927   assign
     1928   frame Dialog-Frame
     1929   tt-firm.firm-code
     1930   .
     1931   assign
     1932   f3 = input frame Dialog-Frame tt-firm.addres1
     1933   f4 = input frame Dialog-Frame tt-firm.addres2
     1934   fp3 = input frame Dialog-Frame tt-firm.post-addr1
     1935   fp4 = input frame Dialog-Frame tt-firm.post-addr2
     1936   .
     1937   if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
     1938     if tt-firm.addres1:visible     in frame Dialog-Frame
     1939     then assign tt-firm.addres1.
     1940     if tt-firm.addres2:visible     in frame Dialog-Frame
     1941     then assign tt-firm.addres2.
     1942     if tt-firm.post-addr1:visible in frame Dialog-Frame
     1943     then assign tt-firm.post-addr1.
     1944     if tt-firm.post-addr2:visible in frame Dialog-Frame
     1945     then assign tt-firm.post-addr2.
     1946     if tt-firm.post-city:visible in frame Dialog-Frame
     1947     then assign tt-firm.post-city.
     1948     if tt-firm.post-ind:visible in frame Dialog-Frame
     1949     then assign tt-firm.post-ind.
     1950     if tt-firm.city:visible in frame Dialog-Frame
     1951     then assign tt-firm.city.
     1952     if tt-firm.ind:visible in frame Dialog-Frame
     1953     then assign tt-firm.ind.
     1954   end.
     1955   else do:
     1956     assign
     1957     tt-firm.post-addr1 = string(fp3, "X(50)")
     1958     tt-firm.post-addr2 = string(fp4, "X(50)")
     1959     tt-firm.addres1 = string(f3, "X(50)")
     1960     tt-firm.addres2 = string(f4, "X(50)")
     1961     .
     1962   end.
     1963   if f1:visible   in frame Dialog-Frame
     1964   then assign f1.
     1965   if f2:visible   in frame Dialog-Frame
     1966   then assign f2.
     1967   if fp1:visible  in frame Dialog-Frame
     1968   then assign fp1.
     1969   if fp2:visible  in frame Dialog-Frame
     1970   then assign fp2.
     1971   IF (tt-firm.addres1 <> ''
     1972   or tt-firm.addres2 <> ''
     1973   or tt-firm.city <> ''
     1974   OR tt-firm.ind <> 0)
     1975   AND (tt-firm.post-addr1 = ''
     1976        AND
     1977        tt-firm.post-addr2 = ''
     1978        AND
     1979        tt-firm.post-city = ''
     1980        AND
     1981       tt-firm.post-ind = 0) THEN DO:
     1982     message
     1983     substitute("Вы заполнили (некоторые) поля ЮРИДИЧЕСКОГО адреса,&1" +
     1984                "но не заполнили ни одного поля ПОЧТОВОГО адреса&1" +
     1985                "Скопировать поля ЮРИДИЧЕСКОГО адреса в поля ПОЧТОВОГО адреса?"
     1986                , chr(10))
     1987     VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
     1988     IF glog THEN DO:
     1989       APPLY "VALUE-CHANGED" to jj_change-address.
     1990       ASSIGN
     1991       tt-firm.post-addr1 = tt-firm.addres1
     1992       tt-firm.post-addr2 = tt-firm.addres2
     1993       tt-firm.post-city = tt-firm.city
     1994       tt-firm.post-ind = tt-firm.ind
     1995       fp1 = f1
     1996       fp2 = f2
     1997       .
     1998       DISPLAY
     1999       tt-firm.post-addr1
     2000       tt-firm.post-addr2
     2001       tt-firm.post-city
     2002       tt-firm.post-ind
     2003       fp1
     2004       fp2
     2005       WITH FRAME Dialog-Frame.
     2006     END.
     2007   END.
     2008   assign
     2009   tt-clients.obj-name
     2010   tt-clients.PS
     2011   tt-clients.lim-kr
     2012   tt-firm.contact-psn
     2013   tt-firm.director
     2014   tt-firm.e-mail
     2015   tt-firm.engl-name
     2016   tt-firm.fax
     2017   tt-firm.given-by
     2018   tt-firm.inn
     2019   t-check-inn
     2020   tt-firm.is-pboul
     2021   tt-firm.kpp
     2022   tt-firm.okonh
     2023   tt-firm.okpo
     2024   tt-firm.passp-num = IF tt-firm.passp-num:SCREEN-VALUE = ? THEN "":U ELSE tt-firm.passp-num:SCREEN-VALUE
     2025   tt-firm.passp-ser
     2026   tt-firm.phone
     2027   tt-firm.phone1-note
     2028   tt-firm.telex
     2029   tt-firm.tobj-code
     2030   tt-clients.turnover-buyer
     2031   tt-clients.turnover-buyer-gds
     2032   substring( tt-firm.addres1, 51, 50 ) = f1
     2033   substring( tt-firm.addres1, 101, 50 ) = f2
     2034   substring( tt-firm.post-addr1, 51, 50 ) = fp1
     2035   substring( tt-firm.post-addr1, 101, 50 ) = fp2
     2036   .
     2037   _ii:
     2038   do ii = 1 to (if nocorinn AND t-check-inn then 2 else 1):
     2039     run ref/firm1.p (
     2040                    input parparentproc
     2041                   ,input-output p-rid
     2042                   ,input p-mode
     2043                   ,input (if p-callpoint = 'sysconf':U then "cli-all" else p-callpoint)
     2044                   ,input no
     2045                   ,input tt-firm.firm-code
     2046                   ,input tt-clients.stts
     2047                   ,input tt-clients.obj-name
     2048                   ,input tt-clients.lim-kr
     2049                   ,input tt-clients.PS
     2050                   ,input tt-clients.grp-code
     2051                   ,input tt-firm.addres1
     2052                   ,input tt-firm.addres2
     2053                   ,input tt-firm.city
     2054                   ,input tt-firm.contact-psn
     2055                   ,input tt-firm.director
     2056                   ,input tt-firm.e-mail
     2057                   ,input tt-firm.engl-name
     2058                   ,input tt-firm.fax
     2059                   ,INPUT tt-firm.given-by
     2060                   ,input tt-firm.ind
     2061                   ,input tt-firm.inn
     2062                   ,INPUT (v-no-check-inn OR not t-check-inn)
     2063                   ,INPUT tt-firm.is-pboul
     2064                   ,input tt-firm.kpp
     2065                   ,input tt-firm.okonh
     2066                   ,input tt-firm.okpo
     2067                   ,INPUT tt-firm.passp-num
     2068                   ,INPUT tt-firm.passp-ser
     2069                   ,input tt-firm.phone
     2070                   ,input tt-firm.phone1-note
     2071                   ,input tt-firm.post-addr1
     2072                   ,input tt-firm.post-addr2
     2073                   ,input tt-firm.post-city
     2074                   ,input tt-firm.post-ind
     2075                   ,input tt-clients.reg-code
     2076                   ,input tt-firm.telex
     2077                   ,input tt-firm.tobj-code
     2078                   ,input tt-clients.turnover-buyer
     2079                   ,input tt-clients.turnover-buyer-gds
     2080     ) no-error .
     2081     if error-status:error then do:
     2082       if return-value = "inn" and nocorinn then do:
     2083         message
     2084         "Введенный ИНН некорректен или не является ИНН для Вашей страны" skip
     2085         "Подтверждаете ввод ТАКОГО ИНН?"
     2086         view-as alert-box question buttons yes-no update v-no-check-inn.
     2087         if not v-no-check-inn then undo, return error .
     2088         next _ii.
     2089       end.
     2090       v-return-value = return-value .
     2091       if v-return-value = 'inn-uniq' then do:
     2092         v-return-value = 'inn'.
     2093       end.
     2094   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2095   define variable fh as widget-handle no-undo .
     2096   define variable hh as widget-handle no-undo .
     2097   define variable rv as character no-undo .
     2098   assign
     2099   rv = entry(1, v-return-value , chr(4)).
     2100   if rv <> "":U then do:
     2101     assign
     2102     fh = frame Dialog-Frame:first-child
     2103     hh = fh:first-child
     2104     .
     2105     do while valid-handle(hh):
     2106       if hh:name = rv then do:
     2107         APPLY "ENTRY" to hh.
     2108         undo  ,
     2109         return error.
     2110       end.
     2111       hh = hh:next-sibling.
     2112     end.
     2113   end.
     2114       undo, return error.
     2115     end.
     2116     else leave _ii.
     2117   end.
     2118   END PROCEDURE.
