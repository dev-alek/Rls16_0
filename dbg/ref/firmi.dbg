     1207                  input parparentproc
     1208                 ,input ?
     1209                 ,input ?
     1210                 ,input ?
     1211                 ,input 'Контрагент':U
     1212                 ,input ?
     1213                 ,input ?
     1214                 ,input ?
     1215                 ,input ?
     1216                 ,input '':U
     1217                 ,input '':U
     1218                 ,input ?
     1219                 ,input recid(locked_clients)
     1220                 ,output v-input-output
     1221                 ) no-error .
     1222    apply "ENTRY" to b-exit.
