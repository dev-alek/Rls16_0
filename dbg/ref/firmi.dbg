      974    run ref/ca-attrr.p (
      975                       input parparentproc
      976                      ,input 'ПРОСМОТР':U
      977                      ,input 'орг':U
      978                      ,input tt-firm.firm-code
      979                      ,input YES
      980                      ,output v-updated
      981                      ,output v-is-error
      982                      ) no-error.
      983     if error-status:error
      984     or v-is-error then do:
      985       message
      986       "Ошибка при вызове списка атрибутов клиента" skip
      987       error-status:get-message(1) skip
      988       return-value
      989       view-as alert-box .
      990       undo, return no-apply.
      991     end.
      992   END.
      993   ON CHOOSE OF b-bank IN FRAME Dialog-Frame
      994   DO:
      995   define variable v-rid-list as character no-undo .
      996   define variable v-rid as recid no-undo .
      997   define variable glog as logical no-undo .
      998   define variable v-status_ like ub.fin-schet.status_ no-undo init 'все':U.
      999   define buffer buf_sysconf for ub.sysconf.
     1000   if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     1001     glog = no.
     1002     message "Вы завершили ввод карточки клиента?"
     1003     view-as alert-box QUESTION buttons YEs-No update glog.
     1004     if not glog then return no-apply.
     1005     if glog then do:
     1006       run proc-save in this-procedure no-error .
     1007       if error-status:error then return no-apply.
     1008       assign
     1009       p-mode = 'ИЗМЕНЕНИЕ':U.
     1010       run fill-table in this-procedure no-error .
     1011       if error-status:error then return no-apply.
     1012       run Myenable in this-procedure .
     1013     END.
     1014   end.
     1015     if p-callpoint = 'sysconf':U then do:
     1016       find first buf_sysconf no-lock where
     1017                 buf_sysconf.host-code = tt-firm.firm-code no-error.
     1018       if available buf_sysconf then do:
     1019         run ref/finschts.w (
     1020                           INPUT parParentProc
     1021                           ,input (if v-cntxt-host-code-obj = 0
     1022                                   then tt-firm.firm-code
     1023                                   else v-cntxt-host-code-obj)
     1024                           ,input (if v-cntxt-host-code-obj > 0
     1025                                   then "b-add":U
     1026                                   else '')
     1027                           ,input "company-host":U
     1028                           ,input 'орг':U
     1029                           ,input tt-firm.firm-code
     1030                           ,input ?
     1031                           ,input (if v-cntxt-host-code-obj = 0
     1032                                  then tt-firm.firm-code
     1033                                  else v-cntxt-host-code-obj)
     1034                           ,input 0
     1035                           ,input-output v-status_
     1036                           ,input-output v-rid-list ).
     1037       end.
     1038     end.
     1039     else do:
     1040       if v-cntxt-host-code-obj = 0 then do:
     1041         message
     1042         "Нельзя посмотреть счета, так как в настоящий момент не определена текущая фирма"
     1043         view-as alert-box error.
     1044         undo, return no-apply.
     1045       end.
     1046       else do:
     1047         run ref/finschts.w (
     1048                           INPUT parParentProc
     1049                           ,input v-cntxt-host-code-obj
     1050                           ,input "b-add":U
     1051                           ,input "cmp-host":U
     1052                           ,input 'орг':U
     1053                           ,input tt-firm.firm-code
     1054                           ,input ?
     1055                           ,input v-cntxt-host-code-obj
     1056                           ,input 0
     1057                           ,input-output v-status_
     1058                           ,input-output v-rid-list ).
     1059       end.
     1060     end.
     1061   END.
     1062   ON CHOOSE OF b-cli IN FRAME Dialog-Frame
     1063   DO:
     1064       define variable ri-str as char init "" no-undo .
     1065       run ref/cli-all.w (
     1066                          input parParentProc
     1067                         ,input "b-sel"
     1068                         ,input 'чел':U
     1069                         ,input 'все':U
     1070                         ,input ?
     1071                         ,input ?
     1072                         ,input ",,,,,,NO"
     1073                         ,input ?
     1074                         ,output ri-str ) .
     1075       apply "ENTRY" to b-exit.
     1076       if ri-str <> "" then   do:
     1077               find first buf_clients where recid ( buf_clients ) = integer( ri-str ) no-lock.
     1078               if buf_clients.obj-type <> 'чел':U then  do:
     1079                       message
     1080                       "Нужно выбрать ЧЕЛОВЕКА (тип чел) !"
     1081                       view-as alert-box WARNING.
     1082                       return no-apply.
     1083                   end.
     1084               fcli = buf_clients.obj-name.
     1085               disp
     1086               fcli
     1087               buf_clients.obj-code @ tt-firm.tobj-code with frame Dialog-Frame.
     1088           end.
     1089   END.
     1090   ON CHOOSE OF b-cli-cl IN FRAME Dialog-Frame
     1091   DO:
     1092         assign fcli = "".
     1093         if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
     1094           assign
     1095           tt-firm.tobj-code = 0.
     1096           display
     1097           tt-firm.tobj-code
     1098           fcli with frame Dialog-Frame.
     1099         end.
     1100         else
     1101         display
     1102         0 @ tt-firm.tobj-code
     1103         fcli with frame Dialog-Frame.
     1104   END.
     1105   ON CHOOSE OF b-dc IN FRAME Dialog-Frame
