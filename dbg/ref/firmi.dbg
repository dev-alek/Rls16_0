     1224   ON VALUE-CHANGED OF tt-firm.is-pboul IN FRAME Dialog-Frame
     1225   DO:
     1226     ASSIGN
     1227     tt-firm.is-pboul.
     1228     CASE tt-firm.is-pboul:
     1229         WHEN NO  THEN DO:
     1230             IF p-mode <> 'ПРОСМОТР':U THEN DO:
     1231               ASSIGN
     1232               tt-firm.given-by  = "":U
     1233               tt-firm.passp-num  = "":U
     1234               tt-firm.passp-ser = "":U
     1235               .
     1236                DISPLAY
     1237                 tt-firm.given-by
     1238                 tt-firm.passp-num
     1239                 tt-firm.passp-ser
     1240                 WITH FRAME Dialog-Frame.
     1241                 disable
     1242                 tt-firm.given-by
     1243                 tt-firm.passp-num
     1244                 tt-firm.passp-ser
     1245                 WITH FRAME Dialog-Frame.
     1246            END.
     1247         END.
     1248         WHEN yes  THEN DO:
     1249           IF p-mode <> 'ПРОСМОТР':U THEN DO:
     1250             ENABLE
     1251             tt-firm.given-by
     1252             tt-firm.passp-num
     1253             tt-firm.passp-ser
     1254             WITH FRAME Dialog-Frame.
     1255           END.
     1256         END.
     1257   END CASE.
     1258   END.
     1259   ON VALUE-CHANGED OF jj_change-address IN FRAME Dialog-Frame
     1260   DO:
     1261   ASSIGN jj_change-address.
     1262   CASE jj_change-address:
     1263     when 0 THEN DO:
     1264       ASSIGN
     1265       fp3 = input tt-firm.post-addr1
     1266       fp4 = input tt-firm.post-addr2
     1267       fp1
     1268       fp2
     1269       .
     1270       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     1271         ASSIGN
     1272         tt-firm.post-addr1
     1273         tt-firm.post-addr2
     1274         tt-firm.post-city
     1275         tt-firm.post-ind
     1276         .
     1277       end.
     1278       DISABLE
     1279       tt-firm.post-addr1
     1280       tt-firm.post-addr2
     1281       fp1
     1282       fp2
     1283       tt-firm.post-city
     1284       tt-firm.post-ind
     1285       WITH FRAME Dialog-Frame.
     1286       HIDE
     1287       tt-firm.post-addr1
     1288       tt-firm.post-addr2
     1289       fp1
     1290       fp2
     1291       tt-firm.post-city
     1292       tt-firm.post-ind
     1293       IN FRAME Dialog-Frame.
     1294       if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     1295         DISPLAY
     1296         f3 @ tt-firm.addres1
     1297         f4 @ tt-firm.addres2
     1298         f1
     1299         f2
     1300         tt-firm.city
     1301         tt-firm.ind
     1302         WITH FRAME Dialog-Frame.
     1303       end.
     1304       else do:
     1305         DISPLAY
     1306         tt-firm.addres1
     1307         tt-firm.addres2
     1308         f1
     1309         f2
     1310          tt-firm.city
     1311          tt-firm.ind
     1312         WITH FRAME Dialog-Frame.
     1313       end.
     1314       if p-mode <> 'ПРОСМОТР':U then do:
     1315         ENABLE
     1316         tt-firm.addres1
     1317         tt-firm.addres2
     1318         f1
     1319         f2
     1320         tt-firm.city
     1321         tt-firm.ind
     1322         WITH FRAME Dialog-Frame.
     1323       end.
     1324     END.
     1325     when 1 THEN DO:
     1326       ASSIGN
     1327       f3 = input tt-firm.addres1
     1328       f4 = input tt-firm.addres2
     1329       f1
     1330       f2.
     1331       if p-mode = 'ИЗМЕНЕНИЕ':U then
     1332       ASSIGN
     1333       tt-firm.addres1
     1334       tt-firm.addres2
     1335       tt-firm.city
     1336       tt-firm.ind
     1337       .
     1338       DISABLE
     1339       tt-firm.addres1
     1340       tt-firm.addres2
     1341       f1
     1342       f2
     1343       tt-firm.city
     1344       tt-firm.ind
     1345       WITH FRAME Dialog-Frame.
     1346       HIDE
     1347       tt-firm.addres1
     1348       tt-firm.addres2
     1349       f1
     1350       f2
     1351       tt-firm.city
     1352       tt-firm.ind
     1353       IN FRAME Dialog-Frame.
     1354       if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     1355         DISPLAY
     1356         fp3 @ tt-firm.post-addr1
     1357         fp4 @ tt-firm.post-addr2
     1358         fp1
     1359         fp2
     1360         TT-FIRM.post-city
     1361         tt-firm.post-ind
     1362         WITH FRAME Dialog-Frame.
     1363       end.
     1364       else do:
     1365         DISPLAY
     1366         tt-firm.post-addr1
     1367         tt-firm.post-addr2
     1368         fp1
     1369         fp2
     1370         tt-firm.post-city
     1371         tt-firm.post-ind
     1372         WITH FRAME Dialog-Frame.
     1373       end.
     1374       if p-mode <> 'ПРОСМОТР':U then do:
     1375         ENABLE
     1376         tt-firm.post-addr1
     1377         tt-firm.post-addr2
     1378         fp1
     1379         fp2
     1380         tt-firm.post-city
     1381         tt-firm.post-ind
     1382         WITH FRAME Dialog-Frame.
     1383       end.
     1384     END.
     1385   END CASE.
     1386   END.
     1387   ON CHOOSE OF MENU-ITEM m-choose
     1388   DO:
     1389     DEFINE VARIABLE v-obj-code LIKE ub.clients.obj-code NO-UNDO.
     1390     run ref/chs-code.w ( input 'орг':U
     1391                         ,input v-cntxt-db-num
     1392                         ,OUTPUT v-obj-code) no-error .
     1393     if not error-status:error
     1394     and v-obj-code <> ? then do:
     1395       display
     1396       v-obj-code @ tt-firm.firm-code
     1397       with frame Dialog-Frame .
     1398     end.
     1399   END.
     1400   ON LEAVE OF tt-firm.passp-num IN FRAME Dialog-Frame
     1401   DO:
     1402      IF trim(tt-firm.passp-num:SCREEN-VALUE) = "":U THEN
     1403         ASSIGN
     1404         tt-firm.passp-num:SCREEN-VALUE = ?.
     1405   END.
     1406   ON VALUE-CHANGED OF tt-clients.turnover-buyer IN FRAME Dialog-Frame
     1407   DO:
     1408     ASSIGN tt-clients.turnover-buyer .
     1409     IF tt-clients.turnover-buyer THEN ENABLE tt-clients.turnover-buyer-gds WITH FRAME Dialog-Frame.
     1410         ELSE DISABLE tt-clients.turnover-buyer-gds WITH FRAME Dialog-Frame.
     1411   END.
     1412   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1413   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1414   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1415   on help of frame Dialog-Frame
     1416   do:
     1417     run gbl/app_help.p
     1418       (input this-procedure :file-name
     1419       ,input ''
     1420       ,input ?
     1421       ) no-error.
     1422     if error-status :error then do:
     1423       message
     1424         "Ошибка при вызове помощи"
     1425         error-status :get-message(1)
     1426         view-as alert-box .
     1427     end.
     1428   end.
     1429   run minbtn-set in this-procedure .
     1430   on choose of b-help in frame Dialog-Frame
     1431   do:
     1432     apply "help":u to frame Dialog-Frame .
     1433   end.
     1434   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1435   procedure minbtn-set :
     1436       do
     1437           on error undo, return error return-value
     1438           :
     1439           define variable ii              as integer       no-undo .
     1440           define variable fh              as widget-handle no-undo .
     1441           define variable hh              as widget-handle no-undo .
     1442           define variable v-h             as handle        extent 4 no-undo .
     1443           define variable v-name-button   as character     no-undo .
     1444           define variable v-help-old-x    as decimal       no-undo .
     1445           define variable v-help-old-y    as decimal       no-undo .
     1446           define variable v-help-old-size as decimal       no-undo .
     1447           define variable v-frame-width   as decimal       no-undo .
     1448           define variable jj              as integer       no-undo .
     1449           do
     1450               on error undo, return error
     1451               :
     1452               assign
     1453                   v-frame-width = frame Dialog-Frame:width - 0.3
     1454                   fh            = frame Dialog-Frame:first-child
     1455                   hh            = fh:first-child
     1456                   ii            = 1
     1457                   .
     1458               do while valid-handle(hh):
     1459                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1460                   do:
     1461                       case lc(hh:name) :
     1462                           when "b-help" then
     1463                               do:
     1464                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1465                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1466                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1467                                   hh:TOOLTIP = "Помощь" .
     1468                                   v-help-old-x = hh:column .
     1469                                   v-help-old-y = hh:row    .
     1470                                   v-help-old-size = hh:width .
     1471                                   hh:width-chars = 2.5 .
     1472                               end.
     1473                           when "b-print" then
     1474                               do:
     1475                                   hh:load-image("cmp/b-print.bmp":u) .
     1476                                   hh:TOOLTIP = "Печать" .
     1477                                   v-h[ii] = hh:handle .
     1478                                   ii = ii + 1 .
     1479                                   hh:width-chars = 3 .
     1480                               end.
     1481                           when "b-history" or
     1482                           when "b-hist" then
     1483                               do:
     1484                                   hh:load-image("cmp/b-hist.bmp":u) .
     1485                                   hh:TOOLTIP = "История" .
     1486                                   v-h[ii] = hh:handle .
     1487                                   ii = ii + 1 .
     1488                                   hh:width-chars = 3 .
     1489                               end.
     1490                           when "b-sch" then
     1491                               do:
     1492                                   hh:load-image("cmp/b-sch.bmp":u) .
     1493                                   hh:TOOLTIP = "Установка Фильтра" .
     1494                                   v-h[ii] = hh:handle .
     1495                                   ii = ii + 1 .
     1496                                   hh:width-chars = 3 .
     1497                               end.
     1498                           when "b-hist-user" then
     1499                               do:
     1500                                   hh:load-image("cmp/b-hist.bmp":u) .
     1501                                   hh:TOOLTIP = "История пользователя" .
     1502                                   ii = ii + 1 .
     1503                               end.
     1504                       end case.
     1505                   end.
     1506                   hh = hh:next-sibling.
     1507               end.
     1508               b-help:column = v-frame-width - b-help:width-chars.
     1509               jj = 0.
     1510               repeat ii = 4 to 1 by -1 :
     1511                   if valid-handle (v-h[ii] ) then
     1512                   do:
     1513                       jj  = jj + 1 .
     1514                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1515                       v-h[ii]:row    = v-help-old-y .
     1516                   end.
     1517               end.
     1518           end.
     1519       end.
     1520   end procedure.
     1521   MAIN-BLOCK:
     1522   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1523      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1524      ON STOP UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1525      :
     1526   assign
     1527   v-s-deploy = lookup("s-deploy":U, p-mode, ";") > 0
     1528   .
     1529   assign
     1530   p-mode = trim(replace(p-mode, "s-deploy":U, "":U), ";":U)
     1531   .
     1532   if p-mode  <> 'ДОБАВЛЕНИЕ':U
     1533     and p-mode <> 'ИЗМЕНЕНИЕ':U
     1534     and p-mode <> 'ПРОСМОТР':U
     1535     then do:
     1536         message
     1537         vss-workfile vss-revision vss-description skip
     1538         "Неверное значение параметров вызова p-mode"  p-mode
     1539         view-as alert-box ERROR.
     1540         undo, return error.
     1541     end.
     1542     if p-callpoint  <> "":U
     1543     and p-callpoint <> "discards":U
     1544     and p-callpoint <> "cli-all":U
     1545     and p-callpoint <> 'sysconf':U
     1546     then do:
     1547         message
     1548         vss-workfile vss-revision vss-description skip
     1549         "Неверное значение параметров вызова p-callpoint"  p-callpoint
     1550         view-as alert-box ERROR.
     1551         undo, return error.
     1552     end.
