     1555     (output v-db-num
     1556     )  .
     1557     if v-s-deploy then do:
     1558   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1559     run mainmenu_getcntxt in parparentproc
     1560       (output v-cntxt-db-num
