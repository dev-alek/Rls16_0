     1123                         input parparentproc
     1124                       , input 0
     1125                       , input "":U
     1126                       , input 0
     1127                       , input "":U
     1128                       , input "one":U
     1129                       , input 'орг':U
     1130                       , input tt-firm.firm-code
     1131                       , input ?
     1132                       , input ?
     1133                       , input "":U
     1134                       , input "":U
