     1570     else do:
     1571   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1572     run mainmenu_getcntxt in parparentproc
     1573       (output v-cntxt-db-num
     1574       ,output v-cntxt-userid
     1575       ,output v-cntxt-level
