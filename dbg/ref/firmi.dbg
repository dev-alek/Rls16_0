     1586     WAIT-FOR GO OF FRAME Dialog-Frame.
     1587   END.
     1588   RUN disable_UI in this-procedure .
     1589   PROCEDURE disable_UI :
     1590     HIDE FRAME Dialog-Frame.
     1591   END PROCEDURE.
     1592   PROCEDURE enable_UI :
     1593     DISPLAY T-check-inn jj_change-address fcli
     1594         WITH FRAME Dialog-Frame.
     1595     IF AVAILABLE tt-clients THEN
     1596       DISPLAY tt-clients.obj-name tt-clients.reg-code tt-clients.PS
     1597             tt-clients.lim-kr tt-clients.turnover-buyer tt-clients.turnover-buyer-gds
     1598         WITH FRAME Dialog-Frame.
     1599     IF AVAILABLE tt-firm THEN
     1600       DISPLAY tt-firm.firm-code tt-firm.engl-name tt-firm.is-pboul tt-firm.inn
     1601             tt-firm.okpo tt-firm.kpp tt-firm.okonh tt-firm.city tt-firm.ind
     1602             tt-firm.director tt-firm.contact-psn tt-firm.phone1-note tt-firm.phone
     1603             tt-firm.fax tt-firm.telex tt-firm.e-mail tt-firm.passp-ser
     1604             tt-firm.passp-num tt-firm.given-by tt-firm.tobj-code
     1605             tt-firm.post-city
     1606         WITH FRAME Dialog-Frame.
     1607     ENABLE B-exit b-quit b-dc b-bank Docs b-attr B-sysconf b-hist B-Help
     1608            tt-firm.firm-code tt-clients.obj-name tt-firm.engl-name
     1609            tt-firm.is-pboul tt-firm.inn T-check-inn tt-firm.okpo tt-firm.kpp
     1610            tt-firm.okonh tt-clients.reg-code b-region jj_change-address
     1611            tt-firm.city tt-firm.ind tt-firm.director tt-firm.contact-psn
     1612            tt-firm.phone1-note tt-firm.phone tt-firm.fax tt-firm.telex
     1613            tt-firm.e-mail tt-firm.passp-ser tt-firm.passp-num tt-firm.given-by
     1614            fcli b-cli tt-clients.PS tt-clients.lim-kr tt-clients.turnover-buyer
     1615            tt-clients.turnover-buyer-gds tt-firm.post-city  tt-firm.post-ind
     1616            tt-firm.contact-psn
     1617         WITH FRAME Dialog-Frame.
     1618     VIEW FRAME Dialog-Frame.
     1619   END PROCEDURE.
     1620   PROCEDURE fill-table :
     1621   define variable v-type as character no-undo .
     1622   define variable v-exist as logical no-undo .
     1623     for each tt-clients :
     1624       delete tt-clients.
     1625     end.
     1626     for each tt-firm :
     1627       delete tt-firm.
     1628     end.
     1629     if p-mode = 'ИЗМЕНЕНИЕ':U
     1630     or p-mode = 'ПРОСМОТР':U then do:
     1631       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     1632         find first locked_clients EXclusive-lock where
     1633               recid(locked_clients) = p-rid no-wait no-error.
     1634         if locked locked_clients then do:
     1635           find first locked_clients EXclusive-lock where
     1636                 recid(locked_clients) = p-rid no-error.
     1637         end.
     1638       end.
     1639       else do:
     1640         find first locked_clients no-lock where
     1641                          recid(locked_clients) = p-rid no-error .
     1642         if not avail locked_clients then do:
     1643           find first locked_clients where
     1644                     locKed_clients.obj-type = 'орг':U
     1645                AND locKed_clients.obj-code = p-code no-error .
     1646         end.
     1647       end.
     1648       if not available locked_clients then do:
     1649         message
     1650         vss-workfile vss-revision vss-description skip
     1651         "Не найдена запись КЛИЕНТ"
     1652         view-as alert-box error .
     1653         undo, return error.
     1654       end.
     1655       if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     1656         find first locked_firm EXclusive-lock where
     1657               locked_firm.firm-code = locked_clients.obj-code no-wait no-error.
     1658         if locked locked_firm then do:
     1659           find first locked_firm EXclusive-lock where
     1660                 locked_firm.firm-code = locked_clients.obj-code  no-error.
     1661         end.
     1662       end.
     1663       else do:
     1664         find first locked_firm no-lock where
     1665                 locked_firm.firm-code = locked_clients.obj-code no-error .
     1666       end.
     1667       if not available locked_firm then do:
     1668         message
     1669         vss-workfile vss-revision vss-description skip
     1670         "Не найдена запись ОРГАНИЗАЦИЯ"
     1671         view-as alert-box error .
     1672         undo, return error.
     1673       end.
     1674       create tt-clients.
     1675       buffer-copy locked_clients to tt-clients.
     1676       create tt-firm.
     1677       buffer-copy locked_firm to tt-firm.
     1678     end.
     1679     else do:
     1680       create tt-clients.
     1681       create tt-firm.
     1682       assign
     1683       tt-clients.obj-type = 'орг':U
     1684       tt-clients.obj-code = 0
     1685       tt-clients.grp-code = p-grp-code
     1686       tt-firm.firm-code = tt-clients.obj-code
     1687       tt-clients.stts = 0
     1688       .
     1689     end.
     1690   END PROCEDURE.
