        1   DEFINE BUFFER locked_clients FOR ub.clients.
        2   DEFINE BUFFER locked_firm FOR ub.firm.
        3   DEFINE TEMP-TABLE tt-clients NO-UNDO LIKE ub.clients.
        4   DEFINE TEMP-TABLE tt-firm NO-UNDO LIKE ub.firm.
        5   DEFINE INPUT PARAMETER         parParentProc  AS WIDGET-HANDLE NO-UNDO.
        6   define input parameter         p-mode        as       character                    no-undo.
        7   define input parameter         p-code        like ub.firm.firm-code no-undo .
        8   define input parameter         p-grp-code    like ub.clients.grp-code no-undo.
        9   define input parameter         p-CallPoint   as character  no-undo .
       10   define input-output parameter  p-rid          as      recid   init ?          no-undo.
       11   define variable vss-revision    as character no-undo init "$Revision$":U .
       12   define variable vss-author      as character no-undo init "$Author$":U .
       13   define variable vss-date        as character no-undo init "$Date$":U .
       14   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       15   define variable vss-archive     as character no-undo init "$Archive$":U .
       16   define variable vss-description as character no-undo init "Карточка редактирования фирмы".
       17   procedure vss-get-info :
       18     define output parameter p-vss-revision    like vss-revision    no-undo .
       19     define output parameter p-vss-author      like vss-author      no-undo .
       20     define output parameter p-vss-date        like vss-date        no-undo .
       21     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       22     define output parameter p-vss-archive     like vss-archive     no-undo .
       23     define output parameter p-vss-description like vss-description no-undo .
       24     assign
       25       p-vss-revision    = vss-revision
       26       p-vss-author      = vss-author
       27       p-vss-date        = vss-date
       28       p-vss-workfile    = vss-workfile
       29       p-vss-archive     = vss-archive
       30       p-vss-description = vss-description
       31     .
       32   end procedure.
       33   procedure vss-get-parameters :
       34     define output parameter p-vss-parameters as character no-undo .
       35   end procedure.
       36   define new global shared variable g#vssrevis-logger as handle    no-undo .
       37   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       38   define variable v-vssrevis-logger                   as handle    no-undo .
       39   procedure vss-logevent :
       40     define input  parameter p-extra-paramters as character no-undo .
       41     define variable v-vssrevis-parameters as character no-undo .
       42     do
       43     on error undo, return error return-value
       44     :
       45       if  valid-handle(v-vssrevis-logger)
       46       and v-vssrevis-logger :get-signature("logevent") <> ""
       47       then do:
       48         run vss-get-parameters in this-procedure
       49           (output v-vssrevis-parameters
       50           ).
       51         run logevent in v-vssrevis-logger
       52           (input vss-workfile
       53           ,input vss-revision
       54           ,input v-vssrevis-parameters
       55           ,input p-extra-paramters
       56           ).
       57       end.
       58     end.
       59   end procedure.
       60   assign
       61     v-vssrevis-logger = g#vssrevis-logger
       62   .
       63   if  valid-handle(v-vssrevis-logger)
       64   and v-vssrevis-logger :get-signature("logevent") <> ""
       65   then do:
       66     assign
       67       v-vssrevis-logevent = true
       68     .
       69     run vss-logevent in this-procedure (input vss-description) .
       70   end.
       71   define new global shared variable g#language as character no-undo .
       72   if g#language <> '' and g#language <> 'rus':U then do:
       73     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       74   end.
       75   define new global shared variable g#library  as handle no-undo .
       76   define new global shared variable g#library2 as handle no-undo .
       77   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       78   define variable v-waitfram-action01         as character   no-undo .
       79   define variable v-waitfram-action02         as character   no-undo .
       80   define variable v-waitfram-action03         as character   no-undo .
       81   define variable mWaitFramTextBeg            as character   no-undo.
       82   define variable mWaitFramTextEnd            as character   no-undo.
       83   define variable mWaitFramView               as logical     no-undo.
       84   define variable mWaitProcEvent              as logical     no-undo init yes.
       85   define variable mWaitFramInterval           as integer     no-undo init 1 .
       86   define variable mWaitFramStop               as logical     no-undo.
       87   define variable mWaitFramStopUser           as logical     no-undo.
       88   define variable mWaitFramStopTimeOut        as logical     no-undo.
       89   define variable mWaitFramStartProc          as datetime-tz no-undo.
       90   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       91   define button B-WaitFramStop auto-end-key
       92        label "Стоп"
       93        size 10 by 1 tooltip "Остоновить процесс".
       94   define button B-viewProcInfo
       95        label "Информация"
       96        size 15 by 1 tooltip "Информация о процесс".
       97   define frame waitfram
       98     v-waitfram-action01 format "x(72)" no-label skip
       99     v-waitfram-action02 format "x(72)" no-label skip
      100     v-waitfram-action03 format "x(72)" no-label skip
      101     B-viewProcInfo
      102     B-WaitFramStop at row 4 col 30
      103     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      104     .
      105   define new global shared variable mBatchMode as logical no-undo init ?.
      106   define variable mFramBachModHandle as handle no-undo.
      107   mFramBachModHandle = frame waitfram:handle.
      108   define variable mFameOldVis as logical no-undo.
      109   define variable mVisCUrentVin as logical no-undo.
      110   if session:batch-mode
      111   then
      112      mBatchMode = yes.
      113   if mBatchMode = ? then do:
      114     mVisCUrentVin = current-window:visible.
      115     mFameOldVis = mFramBachModHandle:visible.
      116     mFramBachModHandle:visible  = yes.
      117     mBatchMode = mFramBachModHandle:visible ne yes.
      118     mFramBachModHandle:visible = mFameOldVis.
      119     current-window:visible = mVisCUrentVin.
      120   end.
      121    if  log-manager:logfile-name ne ?
      122     then DO:
      123         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      124         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      125         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      126     end.
      127   on choose of B-WaitFramStop in frame waitfram
      128   do:
      129     mWaitFramStop = yes.
      130     mWaitFramStopUser = yes.
      131   end.
      132   function waitfram-check-timeout returns logical():
      133      define variable vtime as int64 no-undo.
      134      if mWaitFramStopTimeOut
      135      then
      136         return yes.
      137      vtime = ( now - mWaitFramStartProc ) / 1000 .
      138      if     mWaitFramTimeOut ne ?
      139         and mWaitFramTimeOut ne 0
      140         and mWaitFramTimeOut lt vtime
      141      then do:
      142         mWaitFramStopTimeOut = yes.
      143      end.
      144      return mWaitFramStopTimeOut.
      145   end.
      146   procedure waitfram-hide :
      147     if not session:batch-mode
      148     then do
      149     on error undo, return error return-value
      150     :
      151       pause 0 before-hide .
      152       if not mBatchMode then
      153         hide frame waitfram .
      154     if     not mWaitFramView
      155        and mWaitProcEvent
      156     then
      157       process events .
      158     end.
      159   end procedure.
      160   procedure waitfram-show :
      161     define input  parameter p-message as character no-undo .
      162     define variable v-left-margin as integer   no-undo .
      163     if not session:batch-mode
      164     then do
      165     on error undo, return error return-value
      166     :
      167       if length(p-message) <= 70 then do:
      168         assign
      169           v-left-margin = integer((70 - length(p-message)) / 2)
      170         .
      171         assign
      172           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      173         .
      174         assign
      175           v-waitfram-action01 = " "
      176           v-waitfram-action02 = " "
      177                                    + fill(" ", v-left-margin)
      178                                    + p-message
      179           v-waitfram-action03 = " "
      180         .
      181       end.
      182       else do:
      183         define variable vRindex1 as integer no-undo.
      184         define variable vRindex2 as integer no-undo.
      185         vRindex1 = r-index(p-message," ",70).
      186         if vRindex1 = 0
      187         then
      188            vRindex1 = 70.
      189         if length(p-message)  <= vRindex1 + 70 then do:
      190           assign
      191             v-waitfram-action01 = " "
      192             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      193             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      194           .
      195         end.
      196         else do:
      197           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      198           if vRindex2 <= vRindex1
      199           then
      200              vRindex2 = vRindex1 + 70.
      201           assign
      202             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      203             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      204             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      205           .
      206         end.
      207       end.
      208       B-viewProcInfo:visible   in frame waitfram = no.
      209       B-viewProcInfo:sensitive in frame waitfram = no.
      210       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      211       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      212       if  (   mWaitFramView
      213          or  mWaitProcEvent)
      214          and not mBatchMode
      215       then
      216          display
      217             v-waitfram-action01 skip
      218             v-waitfram-action02 skip
      219             v-waitfram-action03 skip
      220          with frame waitfram .
      221       if     mWaitFramView
      222          then do:
      223             if     mWaitFramInterval ne ?
      224                and not mBatchMode
      225             then
      226                wait-for go of frame waitfram pause mWaitFramInterval.
      227          end.
      228          else
      229             if     mWaitProcEvent
      230                and not mBatchMode
      231             then
      232                process events .
      233     end.
      234   end procedure.
      235      procedure waitfram-show-this:
      236         define input  parameter iInterval as int64 no-undo.
      237         define variable vtime as int64 no-undo.
      238         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      239         mWaitFramInterval = iInterval.
      240         run waitfram-show (substitute("&1&2 &3&4" ,
      241                                       mWaitFramTextBeg ,
      242                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      243                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      244                                       mWaitFramTextEnd
      245                                      )
      246                           ).
      247      end.
      248      procedure WaitFramRunPause:
      249         define input  parameter iInterval as dec no-undo.
      250         define variable vStart  as datetime-tz no-undo.
      251         define variable vend    as datetime-tz no-undo.
      252         define variable vint as int64 no-undo.
      253         define variable vOk as logical no-undo.
      254         vStart = now.
      255         vend   = vStart.
      256         publish "WaitFramPause" (iInterval,output vOk).
      257         vend   =  now.
      258         vint = vend - vStart.
      259         vint = iInterval - vint / 1000.
      260         if     not mWaitFramStop
      261            and (   vint > 0
      262                 or (    not vOk
      263                     and iInterval eq ?
      264                     )
      265                 )
      266         then
      267            run waitfram-show-this (iInterval).
      268         vend   =  now.
      269         vint = vend - vStart.
      270         vint = iInterval - vint / 1000.
      271         if     not mWaitFramStop
      272            and vint > 0
      273         then do:
      274            run gbl/pause.p (vint * 1000).
      275         end.
      276         if iInterval ne ?
      277         then
      278            publish "WaitFramStop".
      279         waitfram-check-timeout().
      280      end.
      281      procedure WaitFramWaitFor:
      282         define input  parameter iInterval as dec no-undo.
      283         assign
      284            mWaitFramStartProc   = now
      285            mWaitFramStopUser    = no
      286            mWaitFramStopTimeOut = no
      287         .
      288         block-wait:
      289         do while not mWaitFramStop:
      290            run WaitFramRunPause (iInterval).
      291            if  waitfram-check-timeout()
      292            then do:
      293               leave block-wait.
      294            end.
      295         end.
      296         run waitfram-hide.
      297      end.
      298   procedure waitfram-join :
      299     define input  parameter p-line-1  as character no-undo .
      300     define input  parameter p-line-2  as character no-undo .
      301     define input  parameter p-line-3  as character no-undo .
      302     define output parameter p-message as character no-undo .
      303     do
      304     on error undo, return error return-value
      305     :
      306       assign
      307         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      308                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      309                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      310       .
      311     end.
      312   end procedure.
      313   function waitfram-join-function returns character
      314     (input p-line-1 as character
      315     ,input p-line-2 as character
      316     ,input p-line-3 as character
      317     ).
      318     define variable v-message as character no-undo .
      319     run waitfram-join in this-procedure
      320       (input  p-line-1
      321       ,input  p-line-2
      322       ,input  p-line-3
      323       ,output v-message
      324       ) .
      325     return v-message .
      326   end function .
      327   procedure proc-alt-shift-f2:
      328     if not ibs.th.gbl.gbl-var:rcode
      329   then
      330     run gbl\inidebug.p .
      331   end.
      332   procedure proc-alt-shift-f3:
