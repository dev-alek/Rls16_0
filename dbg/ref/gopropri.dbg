      706   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      707   procedure is-tpsi-object :
      708   define input parameter p-obj-type like ub.clients.obj-type no-undo .
      709   define input parameter p-obj-code like ub.clients.obj-code no-undo .
      710   define output parameter p-is-tpsi-object as logical no-undo .
      711   define variable vss-description as character no-undo init "is-tpsi-object-01: получение признака объекта - участвует в TPSI".
      712   define variable conf-par as character no-undo .
      713   define variable par-type as character no-undo .
      714   define variable v-attr-value as character no-undo .
      715   define variable v-attr-type as character no-undo .
      716   define variable v-is-tpsi-object as logical no-undo .
      717   define buffer buf_clients for ub.clients.
      718     do
      719     on error undo, return error
      720     :
      721       find first buf_clients no-lock where
      722                 buf_clients.obj-type = p-obj-type
      723             AND buf_clients.obj-code = p-obj-code no-error .
      724       if not available buf_clients then do:
      725         return error substitute("&1 &2&3 не найден объект", vss-description, p-obj-type, p-obj-code).
      726       end.
      727       if not (buf_clients.db-num = g#db-num  or g#db-num = 0) then do:
      728         return error substitute("&1 &2&3 нельзя определить значение свойства УЧАСТВУЕТ В ТСПИ не в ГБД и не в свое УБД", vss-description, p-obj-type, p-obj-code).
      729       end.
      730       run clntattr-value  in this-procedure (
      731             input  'орг':U
      732           ,input   buf_clients.host-code
      733           ,input   'als-gds':U
      734           ,output v-attr-value
      735           ,output v-attr-type
      736                                               ) no-error .
      737       if not error-status:error
      738       and logical (v-attr-value) = yes then do:
      739         assign
      740         v-is-tpsi-object = yes
      741         .
      742   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      743     (input  'tpsi'
      744     ,input  0
      745     ,input  ''
      746     ,input  0
      747     ,input  ''
      748     ,input  ''
      749     ,input  ''
      750     ,input  no
      751     ,output conf-par
      752     ,output par-type
      753     ) no-error .
      754         if not error-status:error
      755         and v-is-tpsi-object
      756         and (conf-par = "yes") then do:
      757           assign
      758           p-is-tpsi-object = yes
      759           .
      760         end.
      761       end.
      762     end.
      763   end procedure.
      764   define temp-table temp-tpsi-clients no-undo like ub.clients.
      765   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      766   procedure tpsi-gds-fill-tpsi-obj-table :
      767   define input parameter p-db-num like ub.db.db-num no-undo .
      768   define variable v-is-tpsi-obj as logical no-undo .
      769   define buffer buf_clients for ub.clients.
      770     do
      771     on error undo, return error return-value
      772     :
      773       for each temp-tpsi-clients :
      774         delete temp-tpsi-clients.
      775       end.
      776       _clients:
      777       for each buf_clients no-lock where
      778             buf_clients.db-num = p-db-num:
      779         assign
      780         v-is-tpsi-obj = no.
      781         run gbl/tpsi-obj.p (
      782                         input buf_clients.obj-type
      783                       ,input buf_clients.obj-code
      784                       ,output v-is-tpsi-obj) .
      785         if not v-is-tpsi-obj then NEXT _clients.
      786         create temp-tpsi-clients.
      787         buffer-copy
      788         buf_clients to
      789         temp-tpsi-clients.
      790       end.
      791     end.
      792   end procedure.
      793   procedure tpsi-gds-proprietor :
      794   define input parameter p-gds-code like ub.goods.gds-code no-undo .
      795   define input parameter p-db-num   like ub.db.db-num      no-undo .
      796   define output parameter p-proprietor-host-code like ub.clients.host-code no-undo .
      797   define output parameter p-proprietor-obj-type like ub.clients.obj-type no-undo .
      798   define output parameter p-proprietor-obj-code like ub.clients.obj-code no-undo .
      799   define variable v-is-tpsi-obj as logical no-undo .
      800   do
      801   on error undo, return error return-value
      802   :
      803       define buffer buf_clients for ub.clients.
      804       define buffer buf_gds-obj-attr for ub.gds-obj-attr.
      805       assign
      806       p-proprietor-obj-type = "":U
      807       p-proprietor-obj-code = ?
      808       p-proprietor-host-code = ?
      809       .
      810       _gds-obj-attr:
      811       for each buf_clients no-lock where
      812               buf_clients.db-num = p-db-num,
      813         each buf_gds-obj-attr no-lock where
      814             buf_gds-obj-attr.obj-type = buf_Clients.obj-type
      815         AND buf_gds-obj-attr.obj-code = buf_clients.obj-code
      816         AND buf_gds-obj-attr.gds-code = p-gds-code
      817         AND buf_gds-obj-attr.attr-code = 'proprietor':U:
      818         if logical(buf_gds-obj-attr.attr-value) = yes then do:
      819           assign
      820           v-is-tpsi-obj = no.
      821           run gbl/tpsi-obj.p (
      822                           input buf_gds-obj-attr.obj-type
      823                         ,input buf_gds-obj-attr.obj-code
      824                         ,output v-is-tpsi-obj) .
      825           if not v-is-tpsi-obj then NEXT _gds-obj-attr.
      826           assign
      827           p-proprietor-obj-type = buf_gds-obj-attr.obj-type
      828           p-proprietor-obj-code = buf_gds-obj-attr.obj-code
      829           p-proprietor-host-code = buf_clients.host-code
      830           .
      831           LEAVE.
      832         end.
      833       end.
      834   end.
      835   end procedure.
      836   procedure tpsi-preselect-gds-proprietor :
      837   define input parameter p-gds-code like ub.goods.gds-code no-undo .
      838   define input parameter p-db-num   like ub.db.db-num      no-undo .
      839   define output parameter p-proprietor-host-code like ub.clients.host-code no-undo .
      840   define output parameter p-proprietor-obj-type like ub.clients.obj-type no-undo .
      841   define output parameter p-proprietor-obj-code like ub.clients.obj-code no-undo .
      842   do
      843   on error undo, return error return-value
      844   :
      845       define buffer buf_clients for ub.clients.
      846       define buffer buf_gds-obj-attr for ub.gds-obj-attr.
      847       assign
      848       p-proprietor-obj-type = "":U
      849       p-proprietor-obj-code = ?
      850       p-proprietor-host-code = ?
      851       .
      852       _gds-obj-attr:
      853       for each temp-tpsi-clients no-lock where
      854               temp-tpsi-clients.db-num = p-db-num,
      855         each buf_gds-obj-attr no-lock where
      856             buf_gds-obj-attr.obj-type = temp-tpsi-clients.obj-type
      857         AND buf_gds-obj-attr.obj-code = temp-tpsi-clients.obj-code
      858         AND buf_gds-obj-attr.gds-code = p-gds-code
      859         AND buf_gds-obj-attr.attr-code = 'proprietor':U:
      860         if logical(buf_gds-obj-attr.attr-value) = yes then do:
      861           assign
      862           p-proprietor-obj-type = buf_gds-obj-attr.obj-type
      863           p-proprietor-obj-code = buf_gds-obj-attr.obj-code
      864           p-proprietor-host-code = temp-tpsi-clients.host-code
      865           .
      866           LEAVE.
      867         end.
      868       end.
      869   end.
      870   end procedure.
      871   define variable v-db-num like ub.db.db-num no-undo .
      872   define variable v-is-tpsi-object as logical no-undo .
      873   define variable v-type as character no-undo .
      874   define buffer buf_goods for ub.goods.
      875   define buffer buf_gds-obj-attr for ub.gds-obj-attr.
      876   define buffer buf_clients for ub.clients.
      877   define buffer buf_units for ub.units.
      878   define buffer buf_inkas for ub.inkas.
      879   do
      880   on error undo, return error return-value
      881   :
      882   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      883   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      884     (input  p-obj-type
      885     ,input  p-obj-code
      886     ,output v-db-num
      887     )  .
      888       if v-db-num <> g#db-num then do:
      889         assign
      890         p-error-code = "other-db":U.
      891         return substitute("&1:&2установить атрибут товара на объекте &3&4 невозможно, так как объекте принадлежит другой БД"
      892                             ,vss-description
      893                             , chr(10)
      894                             ,p-obj-type
      895                             ,p-obj-code).
      896       end.
      897       if p-mode = 'удаление':U
      898       or logical(p-value) = no  then do:
      899         assign
      900         p-correct = yes.
      901         return.
      902       end.
      903       find first buf_goods no-lock where
      904                 buf_goods.gds-code = p-gds-code no-error .
      905       if not available buf_goods then do:
      906         return error substitute("&1&2 не найден товар с кодом &3"
      907                            ,vss-description
      908                            , chr(10)
      909                            , p-gds-code
      910                           ).
      911       end.
      912       if buf_goods.gds-type = 'у':U then do:
      913         return substitute("&1&2 товар является УСЛУГОЙ - установка атрибута ПРИНАДЛЕЖНОСТЬ ТОВАРА невозможна"
      914                            ,vss-description
      915                            , chr(10)
      916                           ).
      917       end.
      918       find first buf_units no-lock where
      919                 buf_units.unit-name = buf_goods.unit-base no-error .
      920       if not available buf_units then do:
      921         return error substitute("&1&2 не найдена ед.изм. &3 для товара с кодом &4"
      922                            ,vss-description
      923                            , chr(10)
      924                            , buf_goods.unit-base
      925                            , p-gds-code
      926                           ).
      927       end.
      928       if LOOKUP('сер':U, buf_units.type) > 0 then do:
      929         return substitute("&1&2 товар с кодом &3 является СЕРИЙНЫМ (осн.ед.изм. &4) - установка атрибута ПРИНАДЛЕЖНОСТЬ ТОВАРА невозможна"
      930                            , vss-description
      931                            , chr(10)
      932                            , p-gds-code
      933                            , buf_goods.unit-base
      934                           ).
      935       end.
      936       run is-tpsi-object in this-procedure (
      937                                             input p-obj-type
      938                                            ,input p-obj-code
      939                                            ,output v-is-tpsi-object) no-error .
      940       if error-status:error then do:
      941         return substitute("&1&2 ошибка при получении признака объекта &3&4 УЧАСТВУЕТ В TPSI:&2&5 &6"
      942                            ,vss-description
      943                            , chr(10)
      944                           ,p-obj-type
      945                           ,p-obj-code
      946                           , error-status:get-message(1)
      947                           , return-value
      948                           ).
      949       end.
      950       if v-is-tpsi-object = no then do:
      951         assign
      952         p-error-code = "not-tpsi-object":U.
      953         return substitute("&1&2 &3&4 не входит в число объектов ТПСИ, потому добавить атрибут для товара невозможно"
      954                            ,vss-description
      955                            , chr(10)
      956                           ,p-obj-type
      957                           ,p-obj-code
      958                           ).
      959       end.
      960   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      961   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
      962     (input  p-obj-type
      963     ,input  p-obj-code
      964     ,output v-db-num
      965     )  .
      966       run tpsi-gds-fill-tpsi-obj-table  in this-procedure(v-db-num).
      967       _objects:
      968       for each temp-tpsi-clients no-lock,
      969           first buf_gds-obj-attr where
      970                 buf_gds-obj-attr.obj-type = temp-tpsi-clients.obj-type
      971             AND buf_gds-obj-attr.obj-code = temp-tpsi-clients.obj-code
      972             AND buf_gds-obj-attr.gds-code = p-gds-code
      973             AND buf_gds-obj-attr.attr-code = 'proprietor':U:
      974          if buf_gds-obj-attr.obj-type = p-obj-type
      975         AND buf_gds-obj-attr.obj-code = p-obj-code then next.
      976         if logical(buf_gds-obj-attr.attr-value) = yes then do:
      977           assign
      978           p-error-code = "other-proprietor":U.
      979           return substitute("&1:&2товар на ТПСИ БД &3 принадлежит &4&5, потому добавить атрибут товара на объекте невозможно"
      980                               ,vss-description
      981                               , chr(10)
      982                               ,v-db-num
      983                               ,buf_gds-obj-attr.obj-type
      984                               ,buf_gds-obj-attr.obj-code).
      985         end.
      986         find first buf_inkas no-lock where
      987                   buf_inkas.obj-type = temp-tpsi-clients.obj-type
      988              and  buf_inkas.obj-code = temp-tpsi-clients.obj-code
      989              And buf_inkas.status_ = 'новый':U no-error.
      990         if available buf_inkas then do:
      991           assign
      992           p-error-code = "open-inkas":U.
      993           return substitute("&1:&2установить атрибут товара на объекте невозможно, так как на объекте &3&4 - участнике ТПСИ есть открытая продажа"
      994                               ,vss-description
      995                               , chr(10)
      996                               ,temp-tpsi-clients.obj-type
      997                               ,temp-tpsi-clients.obj-code).
      998         end.
      999       end.
     1000       assign
     1001       p-correct = yes.
     1002   end.
