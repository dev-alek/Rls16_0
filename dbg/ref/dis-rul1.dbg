     2686                                                 , v-num-rec[jj]
     2687                                                 , v-field-label)
     2688                                                 , output v-ret-mess).
     2689                   undo, return error (if p-silent then v-ret-mess else "":U).
     2690                 end.
     2691               end.
     2692               when ">=":U then do:
     2693                 if last(dub_tt-dis-rule.rule-num) and
     2694                 iib[jj] < v-num-rec[jj] then do:
     2695                   assign
     2696                   v-dub = yes
     2697                   .
     2698                   run err-mess in this-procedure ( input substitute("Количество правил детализированных &2 не может быть меньше &1"
     2699                                                               ,v-num-rec[jj]
     2700                                                               ,v-field-label)
     2701                                                               ,output v-ret-mess).
     2702                   undo, return error (if p-silent then v-ret-mess else "":U).
     2703                 end.
     2704               end.
     2705               when "==":U then do:
     2706                 if last(dub_tt-dis-rule.rule-num) and
     2707                 iib[jj] <> v-num-rec[jj] then do:
     2708                   assign
     2709                   v-dub = yes
     2710                   .
     2711                   run err-mess in this-procedure ( input substitute("Количество правил детализированных &2 должно быть равно &1"
     2712                                                               , v-num-rec[jj]
     2713                                                               , v-field-label)
     2714                                                               , output v-ret-mess).
     2715                   undo, return error (if p-silent then v-ret-mess else "":U).
     2716                 end.
     2717               end.
     2718             END CASE.
     2719           end.
     2720         end.
     2721       end.
     2722     end.
     2723     if v-dub then do:
     2724       undo, return error "rule-num":U.
     2725     end.
     2726   end.
     2727   _MAIN:
     2728   DO ON ERROR UNDO, RETURN ERROR
     2729   ON STOP UNDO, RETURN ERROR:
