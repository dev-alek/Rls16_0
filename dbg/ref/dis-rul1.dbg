     3058       term_dis-rule.lvl-num           = 2
     3059       term_dis-rule.is-term           = yes
     3060       term_dis-rule.uniq-field        = v-tree
     3061       term_dis-rule.other-inf         = v-other
     3062       .
     3063       release term_dis-rule no-error .
     3064       if error-status:error then do:
     3065         run err-mess in this-procedure ( substitute("Ошибка при попытке сохранения правила скидки: &1 (детализация к правилу &2): &3 ", v-new-rule-num, v-rule-num, return-value ), output v-ret-mess).
     3066         undo _main, return error (if p-silent then v-ret-mess else '':U).
     3067       end.
     3068       v-run-cn = yes.
     3069       for each buf_dis-cfg-rule no-lock where
     3070              buf_Dis-cfg-rule.templ-rl-root = p-templ-rl-root
     3071         and buf_Dis-cfg-rule.pos-type = p-pos-type
     3072         and buf_Dis-cfg-rule.time-templ-rl-root = v-term-time-templ-rl-root
     3073         on error undo _main, return error error-status:get-message(1) :
     3074          if buf_dis-cfg-rule.link-prop <> integer('0':U)
     3075          and buf_dis-cfg-rule.link-prop <> integer('3':U)
     3076          and p-mode = 'ДОБАВЛЕНИЕ':U
     3077          then do:
     3078            run create-from-projection in this-procedure ( input v-new-rule-num
     3079                                                          ,buffer buf_dis-cfg-rule
     3080                                                          ).
     3081          end.
     3082       end.
     3083     end.
     3084     if v-run-cn then do:
     3085       find first ub.dis-rule no-lock where
     3086                 ub.dis-rule.rule-num = v-rule-num .
     3087       run str/callnews.p
     3088           (input 'dis-rule':U
     3089           ,input (buffer ub.dis-rule:handle)
     3090           ).
     3091     end.
     3092   end.
     3093   PROCEDURE err-mess:
     3094     DEFINE INPUT PARAMETER p-mess as character No-UNDO.
     3095     define output parameter p-ret-mess as character no-undo .
     3096     CASE p-silent:
     3097       when yes then do:
     3098         p-ret-mess =
     3099         substitute("ПРАВИЛО СКИДКИ &1: &2&3"
     3100                   , (if p-mode = 'ИЗМЕНЕНИЕ':U then string(p-rule-num) else p-des)
     3101                   , chr(10)
     3102                   , p-mess).
     3103       end.
     3104       otherwise do:
     3105         message
     3106         p-mess
     3107         view-as alert-box error .
     3108       end.
     3109     end.
     3110   END PROCEDURE.
     3111   procedure check-projection :
     3112   define parameter buffer buf_tt0-term_dis-rule for tt0-term_dis-rule.
     3113   define input parameter p-table-name as character no-undo .
     3114   define input parameter p-projection as character no-undo .
     3115   define output parameter p-reason as character no-undo .
     3116   define variable v-uniq-key-rec as character no-undo .
     3117   define variable v-tbl-row as rowid no-undo .
     3118   define variable v-tbl-name as character no-undo .
     3119   define variable v-ii as integer no-undo .
     3120   do
     3121   on error undo, return error
     3122   :
     3123      v-uniq-key-rec = p-table-name.
     3124      do v-ii = 1 to num-entries(p-projection):
     3125        assign
     3126        v-uniq-key-rec = v-uniq-key-rec + chr(3) +
     3127                         string(buffer buf_tt0-term_dis-rule:buffer-field(entry(2, entry(v-ii, p-projection), "=":U)):buffer-value)
     3128        .
     3129      end.
     3130      run gen-row-keyr in this-procedure (
     3131                                            input  v-uniq-key-rec
     3132                                           ,input  ?
     3133                                           ,input  "Ub"
     3134                                           ,input  ?
     3135                                           ,input  no-lock
     3136                                           ,output v-tbl-row
     3137                                           ,output v-tbl-name   ) no-error.
     3138      if not error-status:error then do:
     3139        return '':U.
     3140      end.
     3141      assign
     3142      p-reason = substitute("&1", entry (lookup (p-table-name, 'dis-gds-rule,dis-cp-rule,dis-dc-rule,dis-dct-rule,dis-thbj-rule,dis-grp-rule,dis-some-rule':u) + 1, ',' + 'Скидка Товара на объ.,Скидки на платеж,Скидки для ДК,Скидки на типы ДК,Общие скидки,Скидки по группе,Привязка прв скид':u))
     3143      .
     3144   end.
     3145   end procedure.
     3146   procedure disrules-override-labels-2 :
     3147   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
     3148   define input parameter p-field-name as character no-undo .
     3149   define output parameter p-label as character no-undo .
     3150   define buffer buf_temp-drt-prop for temp-drt-prop.
     3151   do
     3152   on error undo, return error
     3153   :
     3154     for each buf_temp-drt-prop no-lock where
     3155                     buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
     3156                 and buf_temp-drt-prop.prop-code = "Label":U
     3157                 aND buf_temp-drt-prop.UPPER-prop-code = p-field-name
     3158                 :
     3159       assign
     3160       p-label = buf_temp-drt-prop.property-value
     3161       .
     3162       leave.
     3163     end.
     3164     if p-label = '':U then do:
     3165       case p-field-name:
     3166         when "dis-kat" then do:
     3167           p-label = "Категория".
     3168         end.
     3169         when "tot-sum" then do:
     3170           p-label = "Сумма".
     3171         end.
     3172         when "doc-qnty" then do:
     3173           p-label = "Кол-во".
     3174         end.
     3175         when "time-rule-num" then do:
     3176           p-label = "Расписание".
     3177         end.
     3178         when "value-type" then do:
     3179           p-label = "Тип".
     3180         end.
     3181       end case.
     3182     end.
     3183     end.
     3184   end procedure.
     3185   procedure create-from-projection :
     3186   define input  parameter p-link-rule-num as integer   no-undo .
     3187   define parameter buffer buf_Dis-cfg-rule for ub.dis-cfg-rule.
     3188   define buffer buf_dis-rule for ub.dis-rule.
     3189   define buffer buf_dis-cp-rule for ub.dis-cp-rule.
     3190   define buffer buf_dis-grp-rule for ub.dis-grp-rule.
     3191   define variable buf_h as handle no-undo .
     3192   define variable v-ii as integer   no-undo .
     3193   define variable v-dop as character no-undo .
     3194   define variable glog as logical   no-undo .
     3195   do
     3196   on error undo, return error return-value
     3197   :
     3198     find first buf_dis-rule no-lock where
     3199               buf_dis-rule.rule-num = p-link-rule-num.
     3200     create buffer buf_h for table buf_dis-cfg-rule.table-name.
     3201     assign
     3202     glog = buf_h:buffer-copy(buffer buf_dis-rule:handle) no-error.
     3203     if not glog then do:
     3204       delete widget buf_h.
     3205       undo, return error substitute("Ошибка копирования при связи правила с &1&2&3"
     3206                                     ,buf_dis-cfg-rule.table-name
     3207                                     , chr(10)
     3208                                     , error-status:get-message(1)).
     3209     end.
     3210     assign
     3211     buf_h:buffer-field("pos-type"):buffer-value = buffer buf_dis-cfg-rule:buffer-field("pos-type"):buffer-value
     3212     .
     3213     if buf_dis-cfg-rule.self-nonunique <>'':U then do:
     3214       assign
     3215       buf_h:buffer-field("classif-type"):buffer-value = buffer buf_dis-cfg-rule:buffer-field("self-nonunique"):buffer-value
     3216       .
     3217     end.
     3218     if buf_dis-cfg-rule.nonunique <> '':U then do:
     3219       assign
     3220       buf_h:buffer-field("nonunique"):buffer-value = string(buffer buf_Dis-rule:handle:buffer-field(buf_dis-cfg-rule.nonunique):buffer-value)
     3221       .
     3222     end.
     3223     assign
     3224     buf_h:buffer-field("discnt-role"):buffer-value = buffer buf_Dis-cfg-rule:handle:buffer-field("discnt-role"):buffer-value
     3225     .
     3226     do v-ii = 1 to num-entries(buf_dis-cfg-rule.projection):
     3227        v-dop = entry(v-ii, buf_dis-cfg-rule.projection).
     3228        assign
     3229        buf_h:buffer-field(entry(1, v-dop, "=":U)):buffer-value = buffer buf_dis-rule:buffer-field(entry(2, v-dop, "=":U)):buffer-value
     3230        no-error
     3231        .
     3232        if error-status :error then do:
     3233           delete widget buf_h.
     3234           undo, return error substitute("Ошибка копирования при связи правила с &1&2&3"
     3235                                         ,buf_dis-cfg-rule.table-name
     3236                                         , chr(10)
     3237                                         , error-status:get-message(1)).
     3238        end.
     3239     end.
     3240     assign
     3241     glog = buf_h:buffer-release no-error .
     3242     if not glog then do:
     3243       delete widget buf_h.
     3244       undo, return error substitute("Ошибка сохранения связи правила с &1&2&3"
     3245                                     ,buf_dis-cfg-rule.table-name
     3246                                     ,chr(10)
     3247                                     ,error-status:get-message(1)).
     3248     end.
     3249     delete widget buf_h.
     3250   end.
     3251   end procedure.
     3252   procedure delete-from-projection :
     3253   define input  parameter p-link-rule-num as integer   no-undo .
     3254   define parameter buffer buf_Dis-cfg-rule for ub.dis-cfg-rule.
     3255   define buffer buf_dis-rule for ub.dis-rule.
     3256   define buffer buf_dis-cp-rule for ub.dis-cp-rule.
     3257   define buffer buf_dis-grp-rule for ub.dis-grp-rule.
     3258   define variable buf_h as handle no-undo .
     3259   define variable buf_h2 as handle no-undo .
     3260   define variable t_h as handle no-undo .
     3261   define variable v-ii as integer   no-undo .
     3262   define variable v-dop as character no-undo .
     3263   define variable glog as logical   no-undo .
     3264   define variable v-keys as character no-undo .
     3265   define variable v-uniq-key-rec as character no-undo .
     3266   define variable v-tbl-row as rowid no-undo .
     3267   define variable v-tbl-name as character no-undo .
     3268   do
     3269   on error undo, return error return-value
     3270   :
     3271     find first buf_dis-rule no-lock where
     3272               buf_dis-rule.rule-num = p-link-rule-num.
     3273     create temp-table t_h.
     3274   assign
     3275   t_h:undo = no
     3276   glog = false
     3277   .
     3278     assign
     3279     glog = t_h:create-like(buf_dis-cfg-rule.table-name ) no-error
     3280     .
     3281     if glog <> true then do:
     3282       delete object t_h.
     3283       undo, return error substitute("Ошибка создания врем.таблицы при удалении связи правила с &1&2&3"
     3284                                     ,buf_dis-cfg-rule.table-name
     3285                                     , chr(10)
     3286                                     , error-status:get-message(1)).
     3287     end.
     3288     glog = no.
     3289     assign
     3290     glog = t_h:temp-table-prepare( substitute("temp_&1", buf_dis-cfg-rule.table-name )) no-error
     3291     .
     3292     if glog <> true then do:
     3293       delete object t_h.
     3294       undo, return error substitute("Ошибка создания врем.таблицы при удалении связи правила с &1&2&3"
     3295                                     ,buf_dis-cfg-rule.table-name
     3296                                     , chr(10)
     3297                                     , error-status:get-message(1)).
     3298     end.
     3299     assign
     3300     buf_h = t_h:default-buffer-handle
     3301     .
     3302     assign
     3303     glog = buf_h:buffer-copy(buffer buf_dis-rule:handle) no-error.
     3304     if not glog then do:
     3305       delete widget t_h.
     3306       undo, return error substitute("Ошибка копирования при удалении связи правила с &1&2&3"
     3307                                     ,buf_dis-cfg-rule.table-name
     3308                                     , chr(10)
     3309                                     , error-status:get-message(1)).
     3310     end.
     3311     assign
     3312     buf_h:buffer-field("pos-type"):buffer-value = buffer buf_dis-cfg-rule:buffer-field("pos-type"):buffer-value
     3313     .
     3314     if buf_dis-cfg-rule.self-nonunique <>'':U then do:
     3315       assign
     3316       buf_h:buffer-field("classif-type"):buffer-value = buffer buf_dis-cfg-rule:buffer-field("self-nonunique"):buffer-value
     3317       .
     3318     end.
     3319     if buf_dis-cfg-rule.nonunique <> '':U then do:
     3320       assign
     3321       buf_h:buffer-field("nonunique"):buffer-value = string(buffer buf_Dis-rule:handle:buffer-field(buf_dis-cfg-rule.nonunique):buffer-value)
     3322       .
     3323     end.
     3324     assign
     3325     buf_h:buffer-field("discnt-role"):buffer-value = buffer buf_Dis-cfg-rule:handle:buffer-field("discnt-role"):buffer-value
     3326     .
     3327     do v-ii = 1 to num-entries(buf_dis-cfg-rule.projection):
     3328        v-dop = entry(v-ii, buf_dis-cfg-rule.projection).
     3329        assign
     3330        buf_h:buffer-field(entry(1, v-dop, "=":U)):buffer-value = buffer buf_dis-rule:buffer-field(entry(2, v-dop, "=":U)):buffer-value
     3331        no-error
     3332        .
     3333        if error-status :error then do:
     3334           delete widget t_h.
     3335           undo, return error substitute("Ошибка копирования при связи правила с &1&2&3"
     3336                                         ,buf_dis-cfg-rule.table-name
     3337                                         , chr(10)
     3338                                         , error-status:get-message(1)).
     3339        end.
     3340     end.
     3341     v-keys = buf_h:keys.
     3342     v-uniq-key-rec = buf_dis-cfg-rule.table-name .
     3343     do v-ii = 1 to num-entries(v-keys):
     3344       v-uniq-key-rec = v-uniq-key-rec + chr(3) + string(buf_h:buffer-field(entry(v-ii, v-keys)):buffer-value).
     3345     end.
     3346     v-uniq-key-rec = trim(v-uniq-key-rec, chr(3)).
     3347     run gen-row-keyr in this-procedure (
     3348      input  v-uniq-key-rec
     3349     ,input ?
     3350     ,input "ub"
     3351     ,input ?
     3352     ,input exclusive-lock
     3353     ,output v-tbl-row
     3354     ,output v-tbl-name).
     3355     create buffer buf_h2 for table buf_dis-cfg-rule.table-name.
     3356     glog = buf_h2:find-by-rowid( v-tbl-row).
     3357     assign
     3358     glog = buf_h2:buffer-delete no-error .
     3359     if not glog then do:
     3360       delete widget t_h.
     3361       undo, return error substitute("Ошибка удаления связи правила с &1&2&3"
     3362                                     ,buf_dis-cfg-rule.table-name
     3363                                     ,chr(10)
     3364                                     ,error-status:get-message(1)).
     3365     end.
     3366     delete widget t_h.
     3367     delete widget buf_h2.
     3368   end.
     3369   end procedure.
