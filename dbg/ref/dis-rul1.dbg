     2661         do jj = 1 to num-entries("dis-kat,doc-qnty,tot-sum,time-rule-num,discnt-value,charkey_one,charkey_two,charkey_three,deckey_one,deckey_two,deckey_three,key#_one,key#_two,key#_three"):
     2662           assign
     2663           v-curr-field = entry(jj, "dis-kat,doc-qnty,tot-sum,time-rule-num,discnt-value,charkey_one,charkey_two,charkey_three,deckey_one,deckey_two,deckey_three,key#_one,key#_two,key#_three")
     2664           .
     2665           if v-tree-field[jj]  = no
     2666           and not can-find(first temp-drt-prop no-lock where
     2667                               temp-drt-prop.templ-rl-root = p-templ-rl-root
     2668                           and temp-drt-prop.upper-prop-code = "Level2_UsingFields":U
     2669                           and temp-drt-prop.prop-code = v-curr-field) then do:
     2670             next _jj.
     2671           end.
     2672           run disrules-override-labels-2 in this-procedure ( input p-templ-rl-root
     2673                                                           ,input v-curr-field
     2674                                                           ,output v-field-label).
     2675           assign
     2676           iib[jj] = iib[jj] + 1
     2677           .
     2678           if v-num-rec[jj] > 0 then do:
     2679             CASE v-num-rec-sign[jj]:
     2680               when "<=":U then do:
     2681                 if iib[jj] > v-num-rec[jj] then do:
