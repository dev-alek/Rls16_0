        1   block-level on error undo, throw.
        2   define input parameter  p-rule-num          like ub.dis-rule.rule-num          no-undo .
        3   define input parameter  p-pos-type          as character no-undo .
        4   define input parameter  p-rl-root           like ub.dis-rule.rl-root           no-undo .
        5   define input parameter  p-templ-rl-root     like ub.dis-rule.templ-rl-root     no-undo .
        6   define input parameter  p-des               like ub.dis-rule.des               no-undo .
        7   define input parameter  p-dis-kat           like ub.dis-rule.dis-kat           no-undo .
        8   define input parameter  p-discnt-type       like ub.dis-rule.discnt-type       no-undo .
        9   define input parameter  p-doc-qnty          like ub.dis-rule.doc-qnty          no-undo .
       10   define input parameter  p-tot-sum           like ub.dis-rule.tot-sum           no-undo .
       11   define input parameter  p-charkey_one       like ub.dis-rule.charkey_one       no-undo .
       12   define input parameter  p-charkey_two       like ub.dis-rule.charkey_two       no-undo .
       13   define input parameter  p-charkey_three     like ub.dis-rule.charkey_three     no-undo .
       14   define input parameter  p-deckey_one        like ub.dis-rule.deckey_one       no-undo .
       15   define input parameter  p-deckey_two        like ub.dis-rule.deckey_two       no-undo .
       16   define input parameter  p-deckey_three      like ub.dis-rule.deckey_three     no-undo .
       17   define input parameter  p-key#_one          like ub.dis-rule.key#_one          no-undo .
       18   define input parameter  p-key#_two          like ub.dis-rule.key#_two          no-undo .
       19   define input parameter  p-key#_three        like ub.dis-rule.key#_three        no-undo .
       20   define input parameter  p-subject-type      like ub.dis-rule.subject-type      no-undo .
       21   define input parameter  p-time-templ-rl-root like ub.dis-rule.time-templ-rl-root  no-undo .
       22   define input parameter  p-time-rule-num     like ub.dis-rule.time-rule-num     no-undo .
       23   define input parameter  p-upper-rule-num    like ub.dis-rule.upper-rule-num    no-undo .
       24   define input parameter  p-value-type        like ub.dis-rule.value-type        no-undo .
       25   define input parameter  p-host-code         like ub.dis-rule.host-code         no-undo .
       26   DEFINE INPUT PARAMETER  p-obj-type          LIKE ub.dis-rule.obj-type          NO-UNDO.
       27   DEFINE INPUT PARAMETER  p-obj-code          LIKE ub.dis-rule.obj-code          NO-UNDO.
       28   DEFINE INPUT PARAMETER  p-discnt-value      LIKE ub.dis-rule.discnt-value      NO-UNDO.
       29   define temp-table tt0-term_dis-rule no-undo like ub.dis-rule.
       30   DEFINE INPUT PARAMETER TABLE FOR tt0-term_dis-rule.
       31   define input-output parameter p-recid as recid no-undo.
       32   define input parameter p-mode                         as character no-undo .
       33   define input parameter p-silent                       as logical no-undo .
       34   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       35   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       36   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       37   define variable vss-workfile    as character no-undo init "$Workfile: dis-rul1.p $":U .
       38   define variable vss-archive     as character no-undo init "$Archive: ref/dis-rul1.p $":U .
       39   define variable vss-description as character no-undo init "Сохранение изменений в правилах скидок".
       40   procedure vss-get-info :
       41     define output parameter p-vss-revision    like vss-revision    no-undo .
       42     define output parameter p-vss-author      like vss-author      no-undo .
       43     define output parameter p-vss-date        like vss-date        no-undo .
       44     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       45     define output parameter p-vss-archive     like vss-archive     no-undo .
       46     define output parameter p-vss-description like vss-description no-undo .
       47     assign
       48       p-vss-revision    = vss-revision
       49       p-vss-author      = vss-author
       50       p-vss-date        = vss-date
       51       p-vss-workfile    = vss-workfile
       52       p-vss-archive     = vss-archive
       53       p-vss-description = vss-description
       54     .
       55   end procedure.
       56   procedure vss-get-parameters :
       57     define output parameter p-vss-parameters as character no-undo .
       58   end procedure.
       59   define new global shared variable g#vssrevis-logger as handle    no-undo .
       60   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       61   define variable v-vssrevis-logger                   as handle    no-undo .
       62   procedure vss-logevent :
       63     define input  parameter p-extra-paramters as character no-undo .
       64     define variable v-vssrevis-parameters as character no-undo .
       65     do
       66     on error undo, return error return-value
       67     :
       68       if  valid-handle(v-vssrevis-logger)
       69       and v-vssrevis-logger :get-signature("logevent") <> ""
       70       then do:
       71         run vss-get-parameters in this-procedure
       72           (output v-vssrevis-parameters
       73           ).
       74         run logevent in v-vssrevis-logger
       75           (input vss-workfile
       76           ,input vss-revision
       77           ,input v-vssrevis-parameters
       78           ,input p-extra-paramters
       79           ).
       80       end.
       81     end.
       82   end procedure.
       83   assign
       84     v-vssrevis-logger = g#vssrevis-logger
       85   .
       86   if  valid-handle(v-vssrevis-logger)
       87   and v-vssrevis-logger :get-signature("logevent") <> ""
       88   then do:
       89     assign
       90       v-vssrevis-logevent = true
       91     .
       92     run vss-logevent in this-procedure (input vss-description) .
       93   end.
       94   define new global shared variable g#language as character no-undo .
       95   if g#language <> '' and g#language <> 'rus':U then do:
       96     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       97   end.
       98   define new global shared variable g#library  as handle no-undo .
       99   define new global shared variable g#library2 as handle no-undo .
      100   define   shared variable g#auto as logical no-undo.
      101   define   shared variable g#news as logical no-undo.
      102   define   shared variable g#oxml as logical no-undo.
      103   define   shared variable g#esys as logical no-undo.
      104   define   shared variable g#news-source-db as integer no-undo.
      105   define   shared variable g#esys-source-esys as integer no-undo.
      106   define   shared variable g#db-num as integer   no-undo .
      107   define   shared variable g#userid as character no-undo .
      108   define   shared variable g#passwd as character no-undo .
      109   def var vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      110   procedure dr-code :
      111     do
      112     on error undo, return error
      113     :
      114       define input  parameter  p-templ-rl-root     like ub.dis-rule.templ-rl-root     no-undo .
      115       define output parameter  p-des               like ub.dis-rule.des               no-undo .
      116       define output parameter  p-discnt-type       like ub.dis-rule.discnt-type       no-undo .
      117       define output parameter  p-subject-type      like ub.dis-rule.subject-type      no-undo .
      118       define output parameter  p-value-type        like ub.dis-rule.value-type        no-undo .
      119       define output parameter  p-level-1           as character no-undo .
      120       define output parameter  p-level-2           as character no-undo .
      121       define output parameter  p-global             as integer no-undo .
      122       define output parameter  p-host               as integer no-undo .
      123       define output parameter  p-object             as integer no-undo .
      124       define output parameter  p-output-display as logical   no-undo .
      125       define output parameter  p-tree           as char  no-undo .
      126       define output parameter  p-other          as character no-undo .
      127       define variable v-other as character no-undo .
      128       define buffer buf_dis-rule for ub.dis-rule .
      129       define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      130       find first buf_dis-rule no-lock where
      131                 buf_dis-rule.rule-num = p-templ-rl-root no-error.
      132       find first buf_dis-cfg-rule no-lock where
      133               buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
      134           and buf_dis-cfg-rule.pos-type = '':U
      135           and buf_dis-cfg-rule.table-name = '':U
      136           and buf_dis-cfg-rule.discnt-role = '':U
      137           and buf_dis-cfg-rule.self-nonunique = '':U
      138               no-error.
      139       if not available buf_Dis-cfg-rule then do:
      140           undo, return error substitute("неизвестный шаблон скидки &1", p-templ-rl-root ).
      141       end.
      142       assign
      143       p-des = buf_dis-rule.des
      144       p-discnt-type = buf_dis-rule.discnt-type
      145       p-subject-type = buf_dis-rule.subject-type
      146       p-value-type = buf_dis-rule.value-type
      147       p-global = (if available buf_dis-cfg-rule
      148                   then buf_dis-cfg-rule.has-global
      149                   else 0)
      150       p-host = (if available buf_dis-cfg-rule
      151                 then buf_dis-cfg-rule.has-host
      152                 else 0)
      153       p-object = (if available buf_dis-cfg-rule
      154                 then buf_dis-cfg-rule.has-obj
      155                 else 0)
      156       p-output-display = (buf_dis-rule.sts = integer('0':U))
      157       p-tree = buf_Dis-rule.uniq-field
      158       p-other = buf_dis-rule.other-inf
      159       p-level-1 = entry(1, buf_dis-cfg-rule.other-inf, ";":U)
      160       p-level-2 = (if num-entries(buf_dis-cfg-rule.other-inf, ";":U) > 1
      161                    then entry(2, buf_dis-cfg-rule.other-inf, ";":U)
      162                    else '')
      163       .
      164     end.
      165   end procedure.
      166   define temp-table temp-drt-prop no-undo like ub.drt-prop.
      167   procedure disrules-fill-properties:
      168   define input  parameter p-templ-rl-root as integer   no-undo .
      169   define buffer buf_drt-prop for ub.drt-prop.
      170   define buffer buf_temp-drt-prop for temp-drt-prop.
      171   do
      172   on error undo, return error return-value
      173   :
      174     for each buf_temp-drt-prop:
      175       delete buf_temp-drt-prop.
      176     end.
      177     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
      178       create buf_temp-drt-prop.
      179       buffer-copy buf_drt-prop to buf_temp-drt-prop.
      180     end.
      181   end.
      182   end procedure.
      183   procedure disrules-get-interface-form :
      184   define input parameter p-templ-rl-root like ub.dis-rule.templ-rl-root no-undo .
      185   define output parameter p-form-name as character no-undo .
      186   define buffer buf_temp-drt-prop for temp-drt-prop.
      187   define buffer buf_drt-prop for ub.drt-prop.
      188   find first buf_temp-drt-prop where
      189             buf_temp-drt-prop.templ-rl-root = p-templ-rl-root
      190         and buf_temp-drt-prop.upper-prop-code = "InputForm"
      191         and buf_temp-drt-prop.prop-code = "FormName" no-error.
      192   if not available buf_temp-drt-prop then do:
      193     find first buf_drt-prop where
      194               buf_drt-prop.templ-rl-root = p-templ-rl-root
      195           and buf_drt-prop.upper-prop-code = "InputForm"
      196           and buf_drt-prop.prop-code = "FormName" no-error.
      197     if available buf_drt-prop then do:
      198       p-form-name = buf_drt-prop.property-value.
      199     end.
      200     else do:
      201       p-form-name = "ref/dis-ruli.w".
      202     end.
      203   end.
      204   else do:
      205     p-form-name = buf_temp-drt-prop.property-value.
      206   end.
      207   end procedure.
      208   ~
      209   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      210   procedure gen-b-code :
      211     define input  parameter type-code like ub.code-range.range-type no-undo .
      212     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
      213     do
      214     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      215     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
      216     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
      217     :
      218       define buffer buf_thbj-attr     for ub.thbj-attr .
      219       define buffer buf_sys-ctrl   for ub.sys-ctrl .
      220       define buffer buf_code-range for ub.code-range .
      221       define variable l-code         as   integer              no-undo .
      222       define variable v-db-num       like ub.db.db-num         no-undo .
      223       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      224       if type-code = 'sslc':U
      225       or type-code = 'ssgb':U
      226       then do:
      227         message
      228           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
      229           "Обратитесь к администратору системы."
      230           view-as alert-box error .
      231         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
      232       end.
      233       run trg/getpcode.p ( input  type-code
      234                      ,output cfg-param-code
      235                     ).
      236       run get-next-seq( input  type-code,
      237                         output l-code
      238                       ).
      239       find first buf_sys-ctrl no-lock.
      240       if type-code = 'sclc':U
      241       or type-code = 'pglc':U
      242       then do:
      243         assign
      244           v-db-num = 0
      245         .
      246       end.
      247       else do:
      248         assign
      249           v-db-num = buf_sys-ctrl.db-num
      250         .
      251       end.
      252       find first buf_code-range no-lock
      253         where buf_code-range.db-num     = v-db-num
      254           and buf_code-range.range-type = type-code
      255           and buf_code-range.stts       = "a"
      256         use-index stts
      257         no-error .
      258       if available buf_code-range
      259          and l-code <= buf_code-range.last-code
      260          and l-code >= buf_code-range.first-code then do:
      261         assign
      262           p-b-code = l-code
      263         .
      264       end.
      265       else do:
      266         if available buf_code-range
      267            and l-code < buf_code-range.last-code then do:
      268           message
      269             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      270             "Обратитесь к администратору системы."
      271             view-as alert-box error .
      272           undo, return error "sequence":U .
      273         end.
      274         do transaction
      275         on error undo, return error
      276         :
      277           find first buf_thbj-attr exclusive-lock
      278             where buf_thbj-attr.upper-prop-code = 'code-range':U
      279               and buf_thbj-attr.prop-code = cfg-param-code
      280               and buf_thbj-attr.obj-type   = 'БД':U
      281               and buf_thbj-attr.obj-code   = v-db-num
      282             no-error .
      283           if not available buf_thbj-attr then do:
      284             find first buf_thbj-attr exclusive-lock
      285               where buf_thbj-attr.upper-prop-code = 'code-range':U
      286                 and buf_thbj-attr.prop-code = cfg-param-code
      287                 and buf_thbj-attr.obj-type   = ''
      288                 and buf_thbj-attr.obj-code   = 0
      289               no-error .
      290             if not available buf_thbj-attr then do:
      291               if not locked buf_thbj-attr then do:
      292                 message
      293                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      294                   "Обратитесь к администратору системы."
      295                   view-as alert-box error .
      296               end.
      297               undo, return error "config":U .
      298             end.
      299           end.
      300           run get-next-seq( input type-code,
      301                             output l-code
      302                           ).
      303           find first buf_code-range
      304             where buf_code-range.db-num     = v-db-num
      305               and buf_code-range.range-type = type-code
      306               and buf_code-range.stts       = "a"
      307             use-index stts
      308             no-error .
      309           if available buf_code-range
      310           and l-code <= buf_code-range.last-code
      311           and l-code >= buf_code-range.first-code
      312           then do:
      313             assign
      314               p-b-code = l-code
      315             .
      316           end.
      317           else do:
      318             if available buf_code-range then do:
      319               assign
      320                 buf_code-range.stts = "u"
      321               .
      322             end.
      323             find first buf_code-range
      324               where buf_code-range.db-num     = v-db-num
      325                 and buf_code-range.range-type = type-code
      326                 and buf_code-range.stts       = "f"
      327               use-index stts
      328               no-error .
      329             if not available buf_code-range then do:
      330               message
      331                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      332                 "Обратитесь к администратору системы"
      333                 view-as alert-box error .
      334               undo, return error "code-range":U .
      335             end.
      336             assign
      337               buf_code-range.stts           = "a"
      338             .
      339             if buf_code-range.first-code = 1 then do:
      340               run set-seq-cr( input type-code,
      341                               input buf_code-range.first-code
      342                             ).
      343               assign
      344                 p-b-code = 1
      345               .
      346             end.
      347             else do:
      348               run set-seq-cr( input type-code,
      349                               input ( buf_code-range.first-code - 1 )
      350                             ).
      351               run get-next-seq( input type-code,
      352                                 output p-b-code
      353                               ).
      354             end.
      355           end.
      356         end.
      357       end.
      358     end.
      359   end procedure.
      360   procedure get-next-seq :
      361     define input  parameter type-code like ub.code-range.range-type no-undo .
      362     define output parameter next-seq  as   integer                  no-undo .
      363     do
      364     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      365     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      366     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      367     :
      368       case type-code:
      369         when 'bcgb':U then do:
      370           assign
      371             next-seq = next-value(s-bcgb-code, ub)
      372           .
      373         end.
      374         when 'scgb':U then do:
      375           assign
      376             next-seq = next-value(s-scgb-code, ub)
      377           .
      378         end.
      379         when 'sclc':U then do:
      380           assign
      381             next-seq = next-value(s-sclc-code, ub)
      382           .
      383         end.
      384         when 'pglc':U then do:
      385           assign
      386             next-seq = next-value(s-pglc-code, ub)
      387           .
      388         end.
      389         when 'dcgb':U then do:
      390           assign
      391             next-seq = next-value(s-dcgb-code, ub)
      392           .
      393         end.
      394         when 'ctgb':U then do:
      395           assign
      396             next-seq = next-value(s-ctgb-code, ub)
      397           .
      398         end.
      399         when 'drgb':U then do:
      400           assign
      401             next-seq = next-value(s-drgb-code, ub)
      402           .
      403         end.
      404         when 'fmgb':U then do:
      405           assign
      406             next-seq = next-value(s-fmgb-code, ub)
      407           .
      408         end.
      409         when 'pngb':U then do:
      410           assign
      411             next-seq = next-value(s-pngb-code, ub)
      412           .
      413         end.
      414         when 'cagb':U then do:
      415           assign
      416             next-seq = next-value(s-cagb-code, ub)
      417           .
      418         end.
      419         when 'fdgb':U then do:
      420           assign
      421             next-seq = next-value(s-fin-doc, ub)
      422           .
      423         end.
      424       end case.
      425     end.
      426   end procedure.
      427   procedure set-seq-cr :
      428     define input parameter type-code like ub.code-range.range-type no-undo .
      429     define input parameter set-val   like ub.code-range.first-code no-undo .
      430     do
      431     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      432     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
      433     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
      434     :
      435       case type-code:
      436         when 'bcgb':U then do:
      437           assign
      438             current-value(s-bcgb-code, ub) = set-val
      439           .
      440         end.
      441         when 'scgb':U then do:
      442           assign
      443             current-value(s-scgb-code, ub) = set-val
      444           .
      445         end.
      446         when 'sclc':U then do:
      447           assign
      448             current-value(s-sclc-code, ub) = set-val
      449           .
      450         end.
      451         when 'pglc':U then do:
      452           assign
      453             current-value(s-pglc-code, ub) = set-val
      454           .
      455         end.
      456         when 'dcgb':U then do:
      457           assign
      458             current-value(s-dcgb-code, ub) = set-val
      459           .
      460         end.
      461         when 'ctgb':U then do:
      462           assign
      463             current-value(s-ctgb-code, ub) = set-val
      464           .
      465         end.
      466         when 'drgb':U then do:
      467           assign
      468             current-value(s-drgb-code, ub) = set-val
      469           .
      470         end.
      471         when 'fmgb':U then do:
      472           assign
      473             current-value(s-fmgb-code, ub) = set-val
      474           .
      475         end.
      476         when 'pngb':U then do:
      477           assign
      478             current-value(s-pngb-code, ub) = set-val
      479           .
      480         end.
      481         when 'cagb':U then do:
      482           assign
      483             current-value(s-cagb-code, ub) = set-val
      484           .
      485         end.
      486         when 'fdgb':U then do:
      487           assign
      488             current-value(s-fin-doc, ub) = set-val
      489           .
      490         end.
      491       end case.
      492     end.
      493   end procedure.
      494   procedure new-bcod-gen-code-range :
      495     do
      496     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      497     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      498     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      499     :
      500       define input parameter p-db-num  like ub.db.db-num             no-undo .
      501       define input parameter type-code like ub.code-range.range-type no-undo .
      502       define buffer buf_code-range      for ub.code-range .
      503       define buffer last_code-range     for ub.code-range .
      504       define buffer last-1_code-range   for ub.code-range .
      505       define buffer last-2_code-range   for ub.code-range .
      506       define buffer last-3_code-range   for ub.code-range .
      507       define buffer buf_sys-ctrl        for ub.sys-ctrl .
      508       define variable conf-par       as character no-undo .
      509       define variable par-type       as character no-undo .
      510       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      511       define variable v-cre-cdrg as logical   no-undo .
      512       define variable v-cre-str  as character no-undo .
      513       define variable v-cr1      as integer no-undo .
      514       define variable v-cr2      as integer no-undo .
      515       define variable v-cr3      as integer no-undo .
      516       define variable v-cmax     as integer no-undo .
      517       find first buf_sys-ctrl no-lock .
      518       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
      519         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
      520                                       ,vss-workfile
      521                                       ,vss-revision
      522                                       ,vss-description
      523                                       ,chr(10)
      524                                       , p-db-num
      525                                      ).
      526       end.
      527       run trg/getpcode.p ( input  type-code
      528                      ,output cfg-param-code
      529                     ).
      530       for each buf_code-range
      531         where buf_code-range.db-num     = -1
      532           and buf_code-range.range-type = type-code
      533           and buf_code-range.stts       = "f"
      534       by buf_code-range.first-code
      535       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      536       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      537       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      538       :
      539         assign
      540           buf_code-range.db-num = p-db-num
      541         .
      542         return .
      543       end.
      544       assign
      545         v-cre-cdrg = TRUE
      546       .
      547       case type-code:
      548         when 'sclc':U
      549         or when 'scgb':U
      550         or when 'pglc':U
      551         then do:
      552           find last last-1_code-range no-lock
      553             where last-1_code-range.range-type = 'sclc':U
      554             no-error .
      555           if available last-1_code-range then do:
      556             v-cr1 = last-1_code-range.last-code.
      557           end.
      558           find last last-2_code-range no-lock
      559             where last-2_code-range.range-type = 'scgb':U
      560             no-error .
      561           if available last-2_code-range then do:
      562             v-cr2 = last-2_code-range.last-code.
      563             end.
      564           find last last-3_code-range no-lock
      565             where last-3_code-range.range-type = 'pglc':U
      566             no-error .
      567           if available last-3_code-range then do:
      568             v-cr3 = last-3_code-range.last-code.
      569           end.
      570           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      571           .
      572           if v-cmax = v-cr1  then do:
      573               find last last_code-range no-lock
      574                 where recid( last_code-range ) = recid( last-1_code-range )
      575                 .
      576             end.
      577           if v-cmax = v-cr2  then do:
      578               find last last_code-range no-lock
      579                 where recid( last_code-range ) = recid( last-2_code-range )
      580                 .
      581             end.
      582           if v-cmax = v-cr3  then do:
      583             find last last_code-range no-lock
      584               where recid( last_code-range ) = recid( last-3_code-range )
      585               .
      586           end.
      587           if last_code-range.last-code + 1 > 99999 then do:
      588             assign
      589               v-cre-cdrg = FALSE
      590             .
      591           end.
      592         end.
      593         when 'bcgb':U
      594         or when 'sslc':U
      595         or when 'ssgb':U
      596         then do:
      597           find last last-1_code-range no-lock
      598             where last-1_code-range.range-type = 'sslc':U
      599             no-error .
      600           if available last-1_code-range then do:
      601             v-cr1 = last-1_code-range.last-code.
      602           end.
      603           find last last-2_code-range no-lock
      604             where last-2_code-range.range-type = 'bcgb':U
      605             no-error .
      606           if available last-2_code-range then do:
      607             v-cr2 = last-2_code-range.last-code.
      608             end.
      609           find last last-3_code-range no-lock
      610             where last-3_code-range.range-type = 'ssgb':U
      611             no-error .
      612           if available last-3_code-range then do:
      613             v-cr3 = last-3_code-range.last-code.
      614           end.
      615           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      616           .
      617           if v-cmax = v-cr1  then do:
      618               find last last_code-range no-lock
      619                 where recid( last_code-range ) = recid( last-1_code-range )
      620                 .
      621             end.
      622           if v-cmax = v-cr2  then do:
      623               find last last_code-range no-lock
      624                 where recid( last_code-range ) = recid( last-2_code-range )
      625                 .
      626             end.
      627           if v-cmax = v-cr3  then do:
      628             find last last_code-range no-lock
      629               where recid( last_code-range ) = recid( last-3_code-range )
      630               .
      631           end.
      632         end.
      633         otherwise do:
      634           find last last_code-range no-lock
      635             where last_code-range.range-type = type-code
      636             no-error .
      637         end.
      638       end case.
      639       if not available last_code-range then do:
      640         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
      641                                       ,vss-workfile
      642                                       ,vss-revision
      643                                       ,vss-description
      644                                       , chr(10)
      645                                       , type-code
      646                                      ) .
      647       end.
      648       define variable v-mes1 as character no-undo .
      649       define variable v-param-type1 as character no-undo .
      650       define variable v-value-character1 as INTEGER no-undo .
      651       define variable v-value-date1 as date no-undo .
      652       define variable v-value-decimal1 as decimal no-undo .
      653       define variable v-value-integer1 AS integer no-undo .
      654       define variable v-value-logical1 AS LOGICAL no-undo .
      655       define variable v-tth1 as handle no-undo .
      656       run adm/shattri.p (
      657           input "get":U
      658           ,input  'БД':U
      659           ,input  p-db-num
      660           ,input  'code-range':U
      661           ,input  cfg-param-code
      662           ,output v-value-character1
      663           ,output v-value-date1
      664           ,output v-value-decimal1
      665           ,output v-value-integer1
      666           ,output v-value-logical1
      667           ,output v-param-type1
      668           ,INPUT-OUTPUT table-handle v-tth1
      669           ) no-error .
      670       if error-status :error then do:
      671         delete object v-tth1.
      672         v-mes1 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
      673                            , error-status:get-message(1)
      674                            , chr(10)
      675                            , return-value ).
      676         undo, return error v-mes1.
      677       end.
      678       delete object v-tth1.
      679       if v-cre-cdrg = TRUE then do:
      680         create buf_code-range .
      681         assign
      682           buf_code-range.db-num     = p-db-num
      683           buf_code-range.range-type = type-code
      684           buf_code-range.stts       = "f"
      685           buf_code-range.first-code = last_code-range.last-code + 1
      686           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer1)
      687           v-cre-str = "Свободный диапазон успешно создан"
      688         .
      689       end.
      690       else do:
      691         assign
      692           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
      693                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
      694         .
      695       end.
      696     end.
      697     return v-cre-str .
      698   end procedure.
      699   procedure gen-new-code-range-if-neces :
      700     define input parameter v-db-num           like ub.db.db-num             no-undo .
      701     define input parameter v-range-type       like ub.code-range.range-type no-undo .
      702     define input parameter v-cur-code         as   integer                  no-undo .
      703     define input parameter v-g#news           as   logical                  no-undo .
      704     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
      705     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
      706     do
      707     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      708     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
      709     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
      710     :
      711       define variable l-code-range-exist as logical   no-undo init false .
      712       define variable v-db-for-send      as character no-undo .
      713       define buffer buf_code-range  for ub.code-range .
      714       define buffer buf1_code-range for ub.code-range .
      715       define buffer buf_db          for ub.db .
      716       find first buf_code-range
      717         where buf_code-range.range-type = v-range-type
      718           and buf_code-range.last-code >= v-cur-code
      719         use-index last-codei
      720         no-error .
      721       if
      722       (
      723          available buf_code-range
      724          and
      725         (buf_code-range.db-num = v-db-num
      726           and
      727         buf_code-range.first-code <= v-cur-code
      728         )
      729       or
      730         (
      731           v-range-type = 'drgb':U
      732           AND
      733           v-cur-code = 0
      734         )
      735      )
      736      then do:
      737         assign
      738           l-code-range-exist = true
      739         .
      740         if v-g#news
      741         and buf_code-range.stts = "f" then do:
      742           assign
      743             buf_code-range.stts = "u"
      744           .
      745         end.
      746       end.
      747       if not l-code-range-exist
      748          and v-g#news-source-db <> 0
      749       then do:
      750         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
      751                                       ,vss-workfile
      752                                       ,vss-revision
      753                                       ,vss-description
      754                                       ,chr(10)
      755                                       ,v-db-num
      756                                       ,v-range-type
      757                                       ,v-cur-code
      758                                      ).
      759       end.
      760       if (not l-code-range-exist
      761           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
      762          )
      763       and ( not can-find (first buf1_code-range no-lock
      764                           where buf1_code-range.db-num = v-db-num
      765                             and buf1_code-range.range-type = v-range-type
      766                             and buf1_code-range.stts = "f"
      767                          )
      768           )
      769       then do:
      770         if v-g#db-num = 0 then do:
      771           run new-bcod-gen-code-range in this-procedure
      772             (input v-db-num,
      773              input v-range-type
      774             ) no-error .
      775           if error-status :error then do:
      776             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
      777                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
      778                                           ,v-db-num
      779                                           ,v-range-type
      780                                           ,v-cur-code
      781                                           ,chr(10)
      782                                           ,error-status:get-message(1)
      783                                           ,return-value
      784                                          ).
      785           end.
      786         end.
      787         else do:
      788           if v-range-type = 'sclc':U
      789           or v-range-type = 'pglc':U
      790           then do:
      791             assign
      792               v-db-for-send = "":U
      793             .
      794             if v-g#db-num = 0 then do:
      795               for each buf_db no-lock
      796                 where buf_db.db-num > 0
      797                   and buf_db.db-num <> v-g#news-source-db
      798               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      799               :
      800                 assign
      801                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
      802                 .
      803               end.
      804               assign
      805                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
      806               .
      807             end.
      808             else do:
      809               if not v-g#news then do:
      810                 assign
      811                   v-db-for-send = "0":U
      812                 .
      813               end.
      814             end.
      815             run nws/cr-route.p ( input 'send-cmd':U
      816                           ,input ("command":U + chr(1) + "create":U + chr(1) +
      817                                  "code-range":U + chr(1) +
      818                                  (if v-range-type = 'sclc':U
      819                                   then string( current-value(s-sclc-code, ub))
      820                                   else string( current-value(s-pglc-code, ub))
      821                                   ) + chr(1) +
      822                                   v-range-type)
      823                           ,input ?
      824                           ,input v-db-for-send
      825                           ) no-error .
      826             if error-status :error then do:
      827               undo, return error return-value.
      828             end.
      829           end.
      830         end.
      831       end.
      832     end.
      833   end procedure.
      834   procedure cre-loc-sc-code-range :
      835     define input parameter v-cur-code as integer no-undo .
      836   define input parameter p-cdrg-type as character no-undo .
      837     do
      838     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      839     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
      840     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
      841     :
      842       define buffer buf_code-range for ub.code-range .
      843       find first buf_code-range
      844            where buf_code-range.range-type = p-cdrg-type
      845              and buf_code-range.first-code >= v-cur-code
      846            no-error .
      847       if not available buf_code-range then do:
      848         run new-bcod-gen-code-range in this-procedure
      849           ( input 0,
      850             input p-cdrg-type
      851           ) no-error .
      852         if error-status :error then do:
      853           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
      854                                          + "Код &2&1&3 &4"
      855                                         , chr(10)
      856                                         , v-cur-code
      857                                         , error-status:get-message(1)
      858                                         , return-value
      859                                        ) .
      860         end.
      861       end.
      862     end.
      863   end procedure.
      864   procedure mark-used-if-need :
      865   define input parameter p-cur-code as integer no-undo .
      866   define input parameter p-range-type like ub.code-range.range-type no-undo .
      867   define input parameter p-db-num like ub.code-range.db-num no-undo .
      868     do
      869     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      870     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
      871     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
      872     :
      873       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
      874       define buffer buf_code-range for ub.code-range .
      875       assign
      876       v-db-num = if p-range-type = 'sclc':U
      877                  then 0
      878                  else p-db-num
      879       .
      880   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      881   define buffer locK-batchprocess2 for ub.batchprocess.
      882   run gbl/lock-prc.p
      883       (input 'lscc':U
      884       ,input 0
      885       ,input 0
      886       ,input 0
      887       ,input ""
      888       ,input ""
      889       ,input ""
      890       ,input (
      891               ",,,Вкл/выкл лок. вес. кодов"
      892              )
      893       ,input true
      894       ,buffer lock-batchprocess2
      895       ) no-error .
      896     if error-status :error then do:
      897       message
      898         vss-workfile vss-revision vss-description skip
      899         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
      900         view-as alert-box error .
      901       undo, return error .
      902     end.
      903       find first buf_code-range
      904            where buf_code-range.range-type = p-range-type
      905              and buf_code-range.first-code >= p-cur-code
      906              and buf_code-range.last-code <= p-cur-code
      907              and buf_code-range.db-num = v-db-num
      908            no-error .
      909       if not available buf_code-range then do:
      910         message
      911           vss-workfile vss-revision vss-description skip
      912           "Ошибка при создании поиске диапазона" skip
      913           "База данных" p-db-num skip
      914           "Код" p-cur-code skip
      915           "Тип" p-range-type
      916           error-status :get-message(1) skip
      917           return-value skip
      918           view-as alert-box error .
      919         undo, return error .
      920       end.
      921       if buf_code-range.stts = "f":U then do:
      922         assign
      923         buf_code-range.stts = "u":U
      924         .
      925       end.
      926     end.
      927   end procedure.
      928   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      929   FUNCTION gtregion RETURNS CHARACTER
      930     ( input parhost-code as integer
      931     , input parobj-type as character
      932     , input parobj-code as integer
      933     , input p-tab as logical
      934     ) :
      935     def var par-region as character no-undo.
      936     if parhost-code = 0 and
      937          parobj-type = "":U and
      938          parobj-code = 0 then do:
      939          par-region = "Глобально".
      940          return par-region.
      941       end.
      942       if parobj-type = "" and
      943          parobj-code = 0 then do:
      944          par-region = if p-tab then fill(chr(32), 2) else "":U +
      945                       "Фирма" + chr(32) + string(parhost-code).
      946          return par-region.
      947       end.
      948       par-region = if p-tab then fill(chr(32), 4) else "":U +
      949                    parobj-type + chr(32) + string(parobj-code).
      950       return par-region.
      951   END FUNCTION.
      952   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      953   define variable v-waitfram-action01         as character   no-undo .
      954   define variable v-waitfram-action02         as character   no-undo .
      955   define variable v-waitfram-action03         as character   no-undo .
      956   define variable mWaitFramTextBeg            as character   no-undo.
      957   define variable mWaitFramTextEnd            as character   no-undo.
      958   define variable mWaitFramView               as logical     no-undo.
      959   define variable mWaitProcEvent              as logical     no-undo init yes.
      960   define variable mWaitFramInterval           as integer     no-undo init 1 .
      961   define variable mWaitFramStop               as logical     no-undo.
      962   define variable mWaitFramStopUser           as logical     no-undo.
      963   define variable mWaitFramStopTimeOut        as logical     no-undo.
      964   define variable mWaitFramStartProc          as datetime-tz no-undo.
      965   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      966   define button B-WaitFramStop auto-end-key
      967        label "Стоп"
      968        size 10 by 1 tooltip "Остоновить процесс".
      969   define button B-viewProcInfo
      970        label "Информация"
      971        size 15 by 1 tooltip "Информация о процесс".
      972   define frame waitfram
      973     v-waitfram-action01 format "x(72)" no-label skip
      974     v-waitfram-action02 format "x(72)" no-label skip
      975     v-waitfram-action03 format "x(72)" no-label skip
      976     B-viewProcInfo
      977     B-WaitFramStop at row 4 col 30
      978     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      979     .
      980   define new global shared variable mBatchMode as logical no-undo init ?.
      981   define variable mFramBachModHandle as handle no-undo.
      982   mFramBachModHandle = frame waitfram:handle.
      983   define variable mFameOldVis as logical no-undo.
      984   define variable mVisCUrentVin as logical no-undo.
      985   if session:batch-mode
      986   then
      987      mBatchMode = yes.
      988   if mBatchMode = ? then do:
      989     mVisCUrentVin = current-window:visible.
      990     mFameOldVis = mFramBachModHandle:visible.
      991     mFramBachModHandle:visible  = yes.
      992     mBatchMode = mFramBachModHandle:visible ne yes.
      993     mFramBachModHandle:visible = mFameOldVis.
      994     current-window:visible = mVisCUrentVin.
      995   end.
      996    if  log-manager:logfile-name ne ?
      997     then DO:
      998         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      999         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1000         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1001     end.
     1002   on choose of B-WaitFramStop in frame waitfram
     1003   do:
     1004     mWaitFramStop = yes.
     1005     mWaitFramStopUser = yes.
     1006   end.
     1007   function waitfram-check-timeout returns logical():
     1008      define variable vtime as int64 no-undo.
     1009      if mWaitFramStopTimeOut
     1010      then
     1011         return yes.
     1012      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1013      if     mWaitFramTimeOut ne ?
     1014         and mWaitFramTimeOut ne 0
     1015         and mWaitFramTimeOut lt vtime
     1016      then do:
     1017         mWaitFramStopTimeOut = yes.
     1018      end.
     1019      return mWaitFramStopTimeOut.
     1020   end.
     1021   procedure waitfram-hide :
     1022     if not session:batch-mode
     1023     then do
     1024     on error undo, return error return-value
     1025     :
     1026       pause 0 before-hide .
     1027       if not mBatchMode then
     1028         hide frame waitfram .
     1029     if     not mWaitFramView
     1030        and mWaitProcEvent
     1031     then
     1032       process events .
     1033     end.
     1034   end procedure.
     1035   procedure waitfram-show :
     1036     define input  parameter p-message as character no-undo .
     1037     define variable v-left-margin as integer   no-undo .
     1038     if not session:batch-mode
     1039     then do
     1040     on error undo, return error return-value
     1041     :
     1042       if length(p-message) <= 70 then do:
     1043         assign
     1044           v-left-margin = integer((70 - length(p-message)) / 2)
     1045         .
     1046         assign
     1047           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1048         .
     1049         assign
     1050           v-waitfram-action01 = " "
     1051           v-waitfram-action02 = " "
     1052                                    + fill(" ", v-left-margin)
     1053                                    + p-message
     1054           v-waitfram-action03 = " "
     1055         .
     1056       end.
     1057       else do:
     1058         define variable vRindex1 as integer no-undo.
     1059         define variable vRindex2 as integer no-undo.
     1060         vRindex1 = r-index(p-message," ",70).
     1061         if vRindex1 = 0
     1062         then
     1063            vRindex1 = 70.
     1064         if length(p-message)  <= vRindex1 + 70 then do:
     1065           assign
     1066             v-waitfram-action01 = " "
     1067             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1068             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1069           .
     1070         end.
     1071         else do:
     1072           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1073           if vRindex2 <= vRindex1
     1074           then
     1075              vRindex2 = vRindex1 + 70.
     1076           assign
     1077             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1078             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1079             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1080           .
     1081         end.
     1082       end.
     1083       B-viewProcInfo:visible   in frame waitfram = no.
     1084       B-viewProcInfo:sensitive in frame waitfram = no.
     1085       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1086       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1087       if  (   mWaitFramView
     1088          or  mWaitProcEvent)
     1089          and not mBatchMode
     1090       then
     1091          display
     1092             v-waitfram-action01 skip
     1093             v-waitfram-action02 skip
     1094             v-waitfram-action03 skip
     1095          with frame waitfram .
     1096       if     mWaitFramView
     1097          then do:
     1098             if     mWaitFramInterval ne ?
     1099                and not mBatchMode
     1100             then
     1101                wait-for go of frame waitfram pause mWaitFramInterval.
     1102          end.
     1103          else
     1104             if     mWaitProcEvent
     1105                and not mBatchMode
     1106             then
     1107                process events .
     1108     end.
     1109   end procedure.
     1110      procedure waitfram-show-this:
     1111         define input  parameter iInterval as int64 no-undo.
     1112         define variable vtime as int64 no-undo.
     1113         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1114         mWaitFramInterval = iInterval.
     1115         run waitfram-show (substitute("&1&2 &3&4" ,
     1116                                       mWaitFramTextBeg ,
     1117                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1118                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1119                                       mWaitFramTextEnd
     1120                                      )
     1121                           ).
     1122      end.
     1123      procedure WaitFramRunPause:
     1124         define input  parameter iInterval as dec no-undo.
     1125         define variable vStart  as datetime-tz no-undo.
     1126         define variable vend    as datetime-tz no-undo.
     1127         define variable vint as int64 no-undo.
     1128         define variable vOk as logical no-undo.
     1129         vStart = now.
     1130         vend   = vStart.
     1131         publish "WaitFramPause" (iInterval,output vOk).
     1132         vend   =  now.
     1133         vint = vend - vStart.
     1134         vint = iInterval - vint / 1000.
     1135         if     not mWaitFramStop
     1136            and (   vint > 0
     1137                 or (    not vOk
     1138                     and iInterval eq ?
     1139                     )
     1140                 )
     1141         then
     1142            run waitfram-show-this (iInterval).
     1143         vend   =  now.
     1144         vint = vend - vStart.
     1145         vint = iInterval - vint / 1000.
     1146         if     not mWaitFramStop
     1147            and vint > 0
     1148         then do:
     1149            run gbl/pause.p (vint * 1000).
     1150         end.
     1151         if iInterval ne ?
     1152         then
     1153            publish "WaitFramStop".
     1154         waitfram-check-timeout().
     1155      end.
     1156      procedure WaitFramWaitFor:
     1157         define input  parameter iInterval as dec no-undo.
     1158         assign
     1159            mWaitFramStartProc   = now
     1160            mWaitFramStopUser    = no
     1161            mWaitFramStopTimeOut = no
     1162         .
     1163         block-wait:
     1164         do while not mWaitFramStop:
     1165            run WaitFramRunPause (iInterval).
     1166            if  waitfram-check-timeout()
     1167            then do:
     1168               leave block-wait.
     1169            end.
     1170         end.
     1171         run waitfram-hide.
     1172      end.
     1173   procedure waitfram-join :
     1174     define input  parameter p-line-1  as character no-undo .
     1175     define input  parameter p-line-2  as character no-undo .
     1176     define input  parameter p-line-3  as character no-undo .
     1177     define output parameter p-message as character no-undo .
     1178     do
     1179     on error undo, return error return-value
     1180     :
     1181       assign
     1182         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1183                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1184                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1185       .
     1186     end.
     1187   end procedure.
     1188   function waitfram-join-function returns character
     1189     (input p-line-1 as character
     1190     ,input p-line-2 as character
     1191     ,input p-line-3 as character
     1192     ).
     1193     define variable v-message as character no-undo .
     1194     run waitfram-join in this-procedure
     1195       (input  p-line-1
     1196       ,input  p-line-2
     1197       ,input  p-line-3
     1198       ,output v-message
     1199       ) .
     1200     return v-message .
     1201   end function .
     1202   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1203   procedure gen-key-rec :
     1204     define input  parameter p-tbl-name    as character no-undo.
     1205     define input  parameter p-bh_tbl-name as handle    no-undo.
     1206     define output parameter p-key-rec     as character no-undo.
     1207     do
     1208     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1209     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1210     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1211     :
     1212       define variable fh               as handle    no-undo .
     1213       define variable v-ok             as logical   no-undo .
     1214       define variable v-inform         as character no-undo .
     1215       define variable v-ind            as integer   no-undo .
     1216       define variable v-idx-field-qnty as integer   no-undo .
     1217       if p-tbl-name = ?
     1218         or p-tbl-name = "":U
     1219       then do:
     1220         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info5 ).
     1221       end.
     1222       if not p-bh_tbl-name:available then do:
     1223         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info5, p-tbl-name ).
     1224       end.
     1225       assign
     1226         p-key-rec = p-tbl-name
     1227         v-inform  = p-bh_tbl-name:index-information(1)
     1228         v-ind     = 2
     1229       .
     1230       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1231       on error undo, return error
     1232       :
     1233         assign
     1234           v-inform = p-bh_tbl-name:index-information( v-ind )
     1235           v-ind    = v-ind + 1
     1236         .
     1237       end.
     1238       if v-inform = ?
     1239         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1240         or entry( 3, v-inform, ",":U ) <> "1":U
     1241       then do:
     1242         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, p-tbl-name ).
     1243       end.
     1244       else do:
     1245         assign
     1246           v-idx-field-qnty = num-entries( v-inform ) - 4
     1247         .
     1248         if v-idx-field-qnty < 2 then do:
     1249           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, p-tbl-name ).
     1250         end.
     1251         do v-ind = 1 to v-idx-field-qnty by 2
     1252         on error undo, return error
     1253         :
     1254           assign
     1255             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1256             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1257           .
     1258         end.
     1259       end.
     1260       if p-key-rec = ? then do:
     1261         assign
     1262           p-key-rec = "":U
     1263         .
     1264         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info5, p-tbl-name ).
     1265       end.
     1266     end.
     1267     return.
     1268   end procedure.
     1269   procedure gen-where-keyr-tab :
     1270     define input  parameter i-tableSerach as character no-undo.
     1271     define input  parameter i-tablekey   as character  no-undo.
     1272     define input  parameter p-key-rec    as character  no-undo.
     1273     define input  parameter p-key-handle as handle     no-undo .
     1274     define input  parameter p-db-name    as character  no-undo .
     1275     define input  parameter p-tt-handle  as handle     no-undo .
     1276     define output parameter o-Where      as character  no-undo.
     1277     do
     1278     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1279     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1280     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1281     :
     1282       define variable v-full-tbl-name  as character no-undo .
     1283       define variable bh_tbl-name      as handle    no-undo .
     1284       define variable fh_key           as handle    no-undo .
     1285       define variable fh_search        as handle    no-undo .
     1286       define variable v-field-num      as integer   no-undo .
     1287       define variable v-count-fld      as integer   no-undo .
     1288       define variable v-inform         as character no-undo .
     1289       define variable v-ind            as integer   no-undo .
     1290       define variable v-idx-field-qnty as integer   no-undo .
     1291       define variable v-field-name     as character no-undo .
     1292       define variable v-field-val      as character no-undo .
     1293       define variable v-word-link      as character no-undo .
     1294       define variable vTable           as character no-undo.
     1295       define variable bh_tbl-key       as handle    no-undo .
     1296       assign
     1297         p-key-rec = trim( p-key-rec )
     1298       .
     1299       if p-key-handle <> ? then do:
     1300         if not valid-handle(p-key-handle)
     1301            or p-key-handle:type <> "buffer"
     1302         then do:
     1303           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info5 ).
     1304         end.
     1305         if num-entries( p-key-rec, chr(3) ) > 1
     1306           or p-key-rec = ?
     1307           or p-key-rec = "":U
     1308         then do:
     1309           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info5, p-key-rec ).
     1310         end.
     1311       end.
     1312       else do:
     1313         if p-key-rec = ?
     1314           or p-key-rec = "":U
     1315         then do:
     1316           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
     1317         end.
     1318       end.
     1319       assign
     1320         vTable = entry( 1 , p-key-rec, chr(3) )
     1321       .
     1322       if p-tt-handle <> ?
     1323         and ( not valid-handle(p-tt-handle)
     1324               or p-tt-handle:type <> "buffer"
     1325             )
     1326       then do:
     1327         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info5, vTable, chr(10) ).
     1328       end.
     1329       if p-tt-handle = ? then do:
     1330         assign
     1331           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1332         .
     1333         create buffer bh_tbl-name for table v-full-tbl-name .
     1334       end.
     1335       else do:
     1336         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1337       end.
     1338       assign
     1339         v-inform = bh_tbl-name:index-information(1)
     1340         v-ind    = 2
     1341       .
     1342       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1343       on error undo, return error
     1344       :
     1345         assign
     1346           v-inform = bh_tbl-name:index-information( v-ind )
     1347           v-ind    = v-ind + 1
     1348         .
     1349       end.
     1350       if v-inform = ?
     1351         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1352         or entry( 3, v-inform, ",":U ) <> "1":U
     1353       then do:
     1354         delete object bh_tbl-name no-error.
     1355         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info5, vTable ).
     1356       end.
     1357       assign
     1358         v-idx-field-qnty = num-entries( v-inform ) - 4
     1359       .
     1360       if v-idx-field-qnty < 2 then do:
     1361         delete object bh_tbl-name no-error.
     1362         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, vTable ).
     1363       end.
     1364       assign
     1365         o-where     = "where":U
     1366         v-word-link = "":U
     1367         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1368         v-count-fld = 0
     1369       .
     1370       if i-tablekey ne "" and i-tablekey ne ?
     1371       then do:
     1372         assign
     1373           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1374         .
     1375         create buffer bh_tbl-key for table v-full-tbl-name .
     1376       end.
     1377       if i-tableSerach ne "" and i-tableSerach ne ?
     1378       then do:
     1379         delete object bh_tbl-name no-error.
     1380         assign
     1381           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1382         .
     1383         create buffer bh_tbl-name for table v-full-tbl-name .
     1384       end.
     1385       block_where:
     1386       do v-ind = 1 to v-idx-field-qnty by 2
     1387       on error undo, return error
     1388       :
     1389         assign
     1390           v-count-fld = v-count-fld + 1
     1391         .
     1392         if p-key-handle = ?
     1393           and v-count-fld > v-field-num
     1394         then do:
     1395           leave block_where.
     1396         end.
     1397         define variable VfieldKeyTable as handle no-undo.
     1398         assign
     1399           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1400           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1401         .
     1402         if     bh_tbl-key ne ?
     1403         then do:
     1404            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1405            if VfieldKeyTable eq ?
     1406            then next block_where.
     1407         end.
     1408         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1409         then
     1410            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1411         else
     1412            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1413         if p-key-handle = ? then do:
     1414           assign
     1415             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1416           .
     1417         end.
     1418         else do:
     1419           assign
     1420             fh_key = p-key-handle:buffer-field( v-field-name )
     1421           .
     1422           if fh_key = ?
     1423             or not valid-handle( fh_key )
     1424           then do:
     1425             delete object bh_tbl-name.
     1426             if     bh_tbl-key ne ?
     1427             then
     1428                delete object bh_tbl-key.
     1429             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info5, p-key-handle:name, v-field-name ).
     1430           end.
     1431           assign
     1432             v-field-val = fh_key:buffer-value
     1433           .
     1434         end.
     1435         if fh_search:data-type ="character":U then do:
     1436           assign
     1437             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1438             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1439             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1440             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1441             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1442             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1443             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1444             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1445             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1446             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1447             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1448             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1449             v-field-val = substitute( '"&1"', v-field-val )
     1450           .
     1451         end.
     1452         assign
     1453           o-where = substitute( "&1 &2", o-where, v-field-val )
     1454         .
     1455         if v-word-link = "":U then do:
     1456           assign
     1457             v-word-link = "and":U
     1458           .
     1459         end.
     1460       end.
     1461       delete object bh_tbl-name.
     1462       if     bh_tbl-key ne ?
     1463       then
     1464          delete object bh_tbl-key.
     1465       if p-key-handle = ?
     1466         and v-count-fld <> v-field-num
     1467       then do:
     1468         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info5, vTable ).
     1469       end.
     1470     end.
     1471   end procedure.
     1472   procedure gen-hn-keyr-tab :
     1473     define input  parameter i-tableSerach as character no-undo.
     1474     define input  parameter i-tablekey   as character no-undo.
     1475     define input  parameter p-key-rec    as character no-undo.
     1476     define input  parameter p-key-handle as handle    no-undo .
     1477     define input  parameter p-db-name    as character no-undo .
     1478     define input  parameter p-tt-handle  as handle    no-undo .
     1479     define input  parameter p-stts-lock  as integer   no-undo .
     1480     define output parameter o-hn         as handle    no-undo.
     1481     define variable v-full-tbl-name as character no-undo.
     1482     define variable v-where         as character no-undo.
     1483     define variable bh_tbl-name     as handle    no-undo.
     1484     define variable vTable          as character no-undo.
     1485     do
     1486     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1487     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1488     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1489         run gen-where-keyr-tab(i-tableSerach,
     1490                                i-tablekey,
     1491                                p-key-rec,
     1492                                p-key-handle,
     1493                                p-db-name,
     1494                                p-tt-handle,
     1495                                output v-where).
     1496         if i-tableSerach ne "" and i-tableSerach ne ?
     1497         then do:
     1498            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1499            create buffer bh_tbl-name for table v-full-tbl-name .
     1500         end.
     1501         else do:
     1502            if p-tt-handle = ? then do:
     1503               assign
     1504                  vTable = entry( 1 , p-key-rec, chr(3) )
     1505               .
     1506               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1507               create buffer bh_tbl-name for table v-full-tbl-name .
     1508            end.
     1509            else do:
     1510               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1511            end.
     1512         end.
     1513         if p-tt-handle = ? then do:
     1514            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1515         end.
     1516         else do:
     1517            bh_tbl-name:find-first( v-where ) no-error .
     1518         end.
     1519         o-hn = bh_tbl-name.
     1520      end.
     1521   end procedure.
     1522   procedure gen-hn-keyr :
     1523     define input  parameter p-key-rec    as character no-undo.
     1524     define input  parameter p-key-handle as handle    no-undo .
     1525     define input  parameter p-db-name    as character no-undo .
     1526     define input  parameter p-tt-handle  as handle    no-undo .
     1527     define input  parameter p-stts-lock  as integer   no-undo .
     1528     define output parameter o-hn         as handle    no-undo.
     1529     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1530   end.
     1531   procedure gen-row-keyr :
     1532     define input  parameter p-key-rec    as character no-undo.
     1533     define input  parameter p-key-handle as handle    no-undo .
     1534     define input  parameter p-db-name    as character no-undo .
     1535     define input  parameter p-tt-handle  as handle    no-undo .
     1536     define input  parameter p-stts-lock  as integer   no-undo .
     1537     define output parameter p-tbl-row    as rowid     no-undo.
     1538     define output parameter p-tbl-name   as character no-undo.
     1539     define variable vHn as handle no-undo.
     1540       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1541       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1542       p-tbl-name =  vHn:table.
     1543       delete object vHn no-error.
     1544     if p-tbl-row = ? then do:
     1545       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info5, p-tbl-name, p-key-rec ).
     1546     end.
     1547     else do:
     1548       return.
     1549     end.
     1550   end procedure.
     1551   procedure gen-key-fv :
     1552     define input  parameter p-key-rec    as character no-undo .
     1553     define output parameter p-field-list as character no-undo .
     1554     define output parameter p-value-list as character no-undo.
     1555     do
     1556     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1557     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1558     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1559     :
     1560       define variable v-full-tbl-name  as character no-undo .
     1561       define variable bh_tbl-name      as handle    no-undo .
     1562       define variable v-tbl-name       as character no-undo .
     1563       define variable v-field-num      as integer   no-undo .
     1564       define variable v-count-fld      as integer   no-undo .
     1565       define variable v-inform         as character no-undo .
     1566       define variable v-ind            as integer   no-undo .
     1567       define variable v-idx-field-qnty as integer   no-undo .
     1568       define variable v-delim-key      as character no-undo .
     1569       if p-key-rec = ?
     1570         or p-key-rec = "":U
     1571       then do:
     1572         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info5 ).
     1573       end.
     1574       assign
     1575         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1576         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1577       .
     1578       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1579       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info5 ).
     1580       assign
     1581         v-inform = bh_tbl-name:index-information(1)
     1582         v-ind    = 2
     1583       .
     1584       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1585       on error undo, return error
     1586       :
     1587         assign
     1588           v-inform = bh_tbl-name:index-information( v-ind )
     1589           v-ind    = v-ind + 1
     1590         .
     1591       end.
     1592       if v-inform = ?
     1593         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1594         or entry( 3, v-inform, ",":U ) <> "1":U
     1595       then do:
     1596         delete object bh_tbl-name no-error.
     1597         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
     1598       end.
     1599       assign
     1600         v-idx-field-qnty = num-entries( v-inform ) - 4
     1601       .
     1602       if v-idx-field-qnty < 2 then do:
     1603         delete object bh_tbl-name no-error.
     1604         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
     1605       end.
     1606       assign
     1607         p-field-list = "":U
     1608         p-value-list = "":U
     1609         v-delim-key  = "":U
     1610         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1611         v-count-fld  = 0
     1612       .
     1613       block_where:
     1614       do v-ind = 1 to v-idx-field-qnty by 2
     1615       on error undo, return error
     1616       :
     1617         assign
     1618           v-count-fld = v-count-fld + 1
     1619         .
     1620         if v-count-fld > v-field-num then do:
     1621           leave block_where.
     1622         end.
     1623         assign
     1624           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1625           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1626         .
     1627         if v-ind = 1 then do:
     1628           assign
     1629             v-delim-key = chr(3)
     1630           .
     1631         end.
     1632       end.
     1633       delete object bh_tbl-name.
     1634       if v-count-fld <> v-field-num then do:
     1635         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info5, v-tbl-name ).
     1636       end.
     1637     end.
     1638   end procedure.
     1639   procedure gen-key-field :
     1640     define input  parameter p-table      as character no-undo .
     1641     define output parameter p-field-list as character no-undo .
     1642     do
     1643     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1644     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1645     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1646     :
     1647       define variable v-full-tbl-name  as character no-undo .
     1648       define variable bh_tbl-name      as handle    no-undo .
     1649       define variable v-tbl-name       as character no-undo .
     1650       define variable v-field-num      as integer   no-undo .
     1651       define variable v-count-fld      as integer   no-undo .
     1652       define variable v-inform         as character no-undo .
     1653       define variable v-ind            as integer   no-undo .
     1654       define variable v-idx-field-qnty as integer   no-undo .
     1655       define variable v-delim-key      as character no-undo .
     1656       if p-table = ?
     1657         or p-table = "":U
     1658       then do:
     1659         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info5 ).
     1660       end.
     1661       assign
     1662         v-tbl-name      = p-table
     1663         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1664       .
     1665       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1666       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info5 ).
     1667       assign
     1668         v-inform = bh_tbl-name:index-information(1)
     1669         v-ind    = 2
     1670       .
     1671       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1672       on error undo, return error
     1673       :
     1674         assign
     1675           v-inform = bh_tbl-name:index-information( v-ind )
     1676           v-ind    = v-ind + 1
     1677         .
     1678       end.
     1679       if v-inform = ?
     1680         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1681         or entry( 3, v-inform, ",":U ) <> "1":U
     1682       then do:
     1683         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info5, v-tbl-name ).
     1684       end.
     1685       assign
     1686         v-idx-field-qnty = num-entries( v-inform ) - 4
     1687       .
     1688       if v-idx-field-qnty < 2 then do:
     1689         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info5, v-inform, v-tbl-name ).
     1690       end.
     1691       assign
     1692         p-field-list = "":U
     1693         v-delim-key  = "":U
     1694         v-count-fld  = 0
     1695       .
     1696       block_where:
     1697       do v-ind = 1 to v-idx-field-qnty by 2
     1698       on error undo, return error
     1699       :
     1700         assign
     1701           v-count-fld = v-count-fld + 1
     1702         .
     1703         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1704         if v-ind = 1 then do:
     1705           assign
     1706             v-delim-key = chr(3)
     1707           .
     1708         end.
     1709       end.
     1710       delete object bh_tbl-name.
     1711     end.
     1712   end procedure.
     1713   define variable v-db-num like ub.db.db-num no-undo .
     1714   define variable v-hostcode like ub.sysconf.host-code no-undo .
     1715   define variable  v-new-rule-num      like ub.dis-rule.rule-num          no-undo .
     1716   define variable  v-rule-num          like ub.dis-rule.rule-num          no-undo .
     1717   define variable  v-des               like ub.dis-rule.des               no-undo .
     1718   define variable  v-level-1           as character no-undo .
     1719   define variable  v-level-2           as character no-undo .
     1720   define variable  v-discnt-type       like ub.dis-rule.discnt-type       no-undo .
     1721   define variable  v-subject-type      like ub.dis-rule.subject-type      no-undo .
     1722   define variable  v-value-type        like ub.dis-rule.value-type        no-undo .
     1723   define variable  v-term-value-type   like ub.dis-rule.value-type        no-undo .
     1724   define variable  v-global            as integer no-undo .
     1725   define variable  v-host              as integer no-undo .
     1726   define variable  v-object            as integer no-undo .
     1727   define variable  v-output-display    as logical   no-undo .
     1728   define variable  v-tree              as character no-undo .
     1729   define variable  v-other             as character no-undo .
     1730   define variable  v-dub               as logical no-undo .
     1731   define variable  v-region            as character no-undo .
     1732   define variable  v-entry             as character no-undo .
     1733   define variable ii as integer no-undo .
     1734   define variable iib as integer no-undo extent 14.
     1735   define variable jj as integer no-undo .
     1736   define variable v-curr-field as character no-undo .
     1737   define variable v-tree-field as logical no-undo extent 14.
     1738   define variable v-num-rec as integer no-undo extent 14.
     1739   define variable v-num-rec-sign as character no-undo extent 14.
     1740   define variable v-uniq-field as logical no-undo extent 14.
     1741   define variable v-down-limit as character no-undo extent 14.
     1742   define variable v-up-limit as character no-undo extent 14.
     1743   define variable v-dv-up-limit as character no-undo .
     1744   define variable v-dv-down-limit as character no-undo .
     1745   define variable v-des-len-up-limit as character no-undo .
     1746   define variable v-dis-gds-rule as integer no-undo init ?.
     1747   define variable v-dis-thbj-rule as integer no-undo init ?.
     1748   define variable v-dis-dc-rule as integer no-undo init ?.
     1749   define variable v-dis-dct-rule as integer no-undo init ?.
     1750   define variable v-dis-cp-rule as integer no-undo init ?.
     1751   define variable v-dis-gds-rule-log as logical no-undo.
     1752   define variable v-dis-thbj-rule-log as logical no-undo.
     1753   define variable v-dis-dc-rule-log as logical no-undo.
     1754   define variable v-dis-dct-rule-log as logical no-undo.
     1755   define variable v-dis-cp-rule-log as logical no-undo.
     1756   define variable v-gds-grp-log as logical   no-undo .
     1757   define variable v-dis-some-rule-log as logical   no-undo .
     1758   define variable v-field-label as character no-undo .
     1759   define variable v-found as logical no-undo .
     1760   define variable v-sts-mode as logical no-undo .
     1761   define variable v-ret-mess as character no-undo .
     1762   define variable v-dop as character no-undo .
     1763   define variable v-value-option-list as character no-undo .
     1764   define variable v-run-cn as logical no-undo .
     1765   define variable v-discnt-role as character no-undo .
     1766   define variable v-nonunique as character no-undo .
     1767   define variable v-nonunique2 as character no-undo .
     1768   define variable v-term-time-templ-rl-root as integer no-undo .
     1769   define buffer buf_temp-drt-prop for temp-drt-prop.
     1770   define buffer buf_sysconf  for ub.sysconf.
     1771   DEFINE BUFFER buf_clients-obj FOR ub.clients.
     1772   define buffer buf_db for ub.db .
     1773   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     1774   define buffer buf_dis-gds-rule for ub.dis-gds-rule.
     1775   define buffer buf_dis-thbj-rule for ub.dis-thbj-rule.
     1776   define buffer buf_dis-dc-rule for ub.dis-dc-rule.
     1777   define buffer buf_dis-dct-rule for ub.dis-dct-rule.
     1778   define buffer buf_dis-cp-rule for ub.dis-cp-rule.
     1779   define buffer buf_dis-time-rule for ub.dis-time-rule.
     1780   define buffer buf_dis-rule for ub.dis-rule.
     1781   define buffer dub_dis-rule for ub.dis-rule.
     1782   define buffer term_dis-rule for ub.dis-rule.
     1783   define buffer dub_tt-dis-rule  for tt0-term_dis-rule.
     1784   define temp-table temp-dis-rule no-undo like ub.dis-rule.
     1785   define buffer check_dis-rule for temp-dis-rule.
     1786   define buffer buf_price-list-type for ub.price-list-type.
     1787   if p-mode <> 'ДОБАВЛЕНИЕ':U
     1788   AND p-mode <> 'ИЗМЕНЕНИЕ':U
     1789   AND p-mode <> ('ИЗМЕНЕНИЕ':U + chr(4) + 'sts':U)
     1790   then do:
     1791     message
     1792     vss-workfile vss-revision vss-description skip
     1793     "Неверный параметр p-mode" p-mode
     1794     view-as alert-box error .
     1795     undo, return error '':u.
     1796   end.
     1797   if p-mode = ('ИЗМЕНЕНИЕ':U + chr(4) + 'sts':U) then do:
     1798     assign
     1799     v-sts-mode = yes
     1800     p-mode = 'ИЗМЕНЕНИЕ':U
     1801     .
     1802   end.
     1803   if p-host-code <> 0 then do:
     1804     find first buf_sysconf no-lock where
     1805               buf_sysconf.host-code = p-host-code no-error .
     1806     if not available buf_sysconf then do:
     1807       run err-mess in this-procedure ( substitute("Не найдена фирма с кодом &1", string(p-host-code)), output v-ret-mess).
     1808       undo, return error (if p-silent then v-ret-mess else "host-code":U).
     1809     end.
     1810   end.
     1811   if p-obj-type <> "":U
     1812   or p-obj-code <> 0 then do:
     1813     find first buf_clients-obj no-lock where
     1814               buf_clients-obj.obj-type = p-obj-type
     1815           AND buf_clients-obj.obj-code = p-obj-code no-error .
     1816     if not available buf_clients-obj
     1817     or (p-obj-type <> 'маг':U and p-obj-type <> 'скл':U)
     1818     then do:
     1819       run err-mess in this-procedure ( substitute("Не найден объект &1&2", p-obj-type, p-obj-code), output v-ret-mess).
     1820       undo, return error (if p-silent then v-ret-mess else "obj-code":U).
     1821     end.
     1822     if buf_clients-obj.host-code <> p-host-code then do:
     1823       run err-mess in this-procedure ( substitute("Объект &1&2 принадлежит фирме &3, а правило скидки принадлежит фирме &4"
     1824                     , p-obj-type, p-obj-code, buf_clients-obj.host-code , p-host-code), output v-ret-mess).
     1825       undo, return error (if p-silent then v-ret-mess else "obj-code":U).
     1826     end.
     1827   end.
     1828   if g#db-num <> 0
     1829   and (p-host-code = 0
     1830   or   p-obj-type = "":U
     1831   or   p-obj-code = 0)
     1832   then do:
     1833     run err-mess in this-procedure ( substitute("Нельзя изменять/добавлять глобальную запись ПРАВИЛА СКИДКИ или запись по фирме в УБД:&1" +
     1834                              "номер текущей БД &2"
     1835                              , chr(10)
     1836                              , g#db-num), output v-ret-mess).
     1837     undo, return error (if p-silent then v-ret-mess else "host-code":U).
     1838   end.
     1839   run dr-code  in this-procedure (
     1840        input  p-templ-rl-root
     1841       ,output v-des
     1842       ,output v-discnt-type
     1843       ,output v-subject-type
     1844       ,output v-value-type
     1845       ,output v-level-1
     1846       ,output v-level-2
     1847       ,output v-global
     1848       ,output v-host
     1849       ,output v-object
     1850       ,output v-output-display
     1851       ,output v-tree
     1852       ,output v-other
     1853                                  ) no-error .
     1854   if error-status:error then do:
     1855       run err-mess in this-procedure ( substitute("Неверный номер шаблона для скидки: &1&2&3&2&4"
     1856                                  , p-templ-rl-root
     1857                                  , chr(10)
     1858                                  , error-status:get-message(1)
     1859                                  ,return-value), output v-ret-mess).
     1860       undo, return error (if p-silent then v-ret-mess else "rule-num":U).
     1861   end.
     1862   run disrules-fill-properties in this-procedure ( input p-templ-rl-root).
     1863   for each buf_dis-cfg-rule no-lock where
     1864           buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
     1865       and buf_dis-cfg-rule.table-name > '':U
     1866           :
     1867     if buf_dis-cfg-rule.table-name = 'dis-gds-rule':U then do:
     1868       v-dis-gds-rule-log = yes.
     1869     end.
     1870     if buf_dis-cfg-rule.table-name = 'dis-thbj-rule':U then do:
     1871       v-dis-thbj-rule-log = yes.
     1872     end.
     1873     if buf_dis-cfg-rule.table-name = 'dis-dc-rule':U then do:
     1874       v-dis-dc-rule-log = yes.
     1875     end.
     1876     if buf_dis-cfg-rule.table-name = 'dis-dct-rule':U then do:
     1877       v-dis-dct-rule-log = yes.
     1878     end.
     1879     if buf_dis-cfg-rule.table-name = 'dis-cp-rule':U then do:
     1880       v-dis-cp-rule-log = yes.
     1881     end.
     1882     if buf_dis-cfg-rule.table-name = 'dis-grp-rule':U
     1883     and buf_dis-cfg-rule.self-nonunique = 'gds-grp':U
     1884     then do:
     1885       v-gds-grp-log = yes.
     1886     end.
     1887     if buf_dis-cfg-rule.table-name = 'dis-some-rule':U
     1888     then do:
     1889       v-dis-some-rule-log = yes.
     1890     end.
     1891   end.
     1892   do jj = 1 to num-entries("dis-kat,doc-qnty,tot-sum,time-rule-num,discnt-value,charkey_one,charkey_two,charkey_three,deckey_one,deckey_two,deckey_three,key#_one,key#_two,key#_three"):
