      622                       then do:
      623                           assign
      624                               p-out-string = p-out-string + " ":U
      625                           .
      626                       end.
      627                       when chr(9)
      628                       then do:
      629                           assign
      630                               p-out-string = p-out-string + " ":U
      631                           .
      632                       end.
      633                       when chr(29)
      634                       then do:
      635                           assign
      636                               p-out-string = p-out-string + " ":U
      637                           .
      638                       end.
      639                       when chr(10)
      640                       then do:
      641                           assign
      642                               p-out-string = p-out-string + " ":U
      643                           .
      644                       end.
      645                       when chr(13)
      646                       then do:
      647                           assign
      648                               p-out-string = p-out-string + " ":U
      649                           .
      650                       end.
      651                       otherwise do:
      652                           assign
      653                               p-out-string = p-out-string + v-current-char
      654                           .
      655                       end.
      656                   end case.
      657               end.
      658           end.
      659       end case.
      660   end.
      661   end .
      662   procedure xmlchar-decode :
      663   define input parameter p-in-string      as character        no-undo.
      664   define output parameter p-out-string    as character        no-undo.
      665       define variable v-position      as integer      no-undo.
      666       define variable v-last-position as integer      no-undo.
      667       define variable v-temp-integer  as integer      no-undo.
      668       define variable v-current-char  as character    no-undo.
      669       define variable v-next-char     as character    no-undo.
      670       define variable v-success       as logical      no-undo.
      671   do
      672   on error undo, return error
      673   :
      674       assign
      675           p-out-string = "":U
      676           v-position   = 0
      677       .
      678       replace-cycle:
      679       do while yes
      680       on error undo, return error
      681       :
      682           assign
      683               v-last-position = index( p-in-string, "&":U, v-position + 1 )
      684           .
      685           if v-last-position <= v-position
      686           then do:
      687               if v-position = 0
      688               then do:
      689                   assign
      690                       p-out-string = p-in-string
      691                   .
      692               end.
      693               else do:
      694                   assign
      695                       p-out-string = p-out-string + substring( p-in-string, v-position + 1 )
      696                   .
      697               end.
      698               leave replace-cycle.
      699           end.
      700           else do:
      701               assign
      702                   p-out-string    = p-out-string + substring( p-in-string, v-position + 1, v-last-position - v-position - 1 )
      703                   v-position      = v-last-position
      704                   v-current-char  = substring( p-in-string, v-position + 1, 1 )
      705               .
      706               if v-current-char = "#":U
      707               then do:
      708                   assign
      709                       v-last-position = index( p-in-string, ";":U, v-position + 2 )
      710                   .
      711                   if v-last-position > 0
      712                   then do:
      713                       run xmlchar-read-integer in this-procedure
      714                        (
      715                             input substring( p-in-string, v-position + 2, v-last-position - v-position - 2 )
      716                           , output v-temp-integer
      717                           , output v-success
      718                       ).
      719                       if v-success = yes
      720                       and v-temp-integer >= 1
      721                       and v-temp-integer <= 255
      722                       then do:
      723                           assign
      724                               p-out-string = p-out-string + chr( v-temp-integer )
      725                               v-position   = v-last-position + 1
      726                           .
      727                       end.
      728                       else do:
      729                           assign
      730                               p-out-string = p-out-string + "&":U
      731                               v-position   = v-position   + 1
      732                           .
      733                       end.
      734                   end.
      735                   else do:
      736                       assign
      737                           p-out-string = p-out-string + "&":U
      738                           v-position   = v-position   + 1
      739                       .
      740                   end.
      741               end.
      742               else do:
      743                   case substring( p-in-string, v-position + 1, 3 )
      744                   :
      745                       when "lt;":U
      746                       then do:
      747                           assign
      748                               p-out-string = p-out-string + "<":U
      749                               v-position   = v-position   + 3
      750                           .
      751                       end.
      752                       when "gt;":U
      753                       then do:
      754                           assign
      755                               p-out-string = p-out-string + ">":U
      756                               v-position   = v-position   + 3
      757                           .
      758                       end.
      759                       otherwise do:
      760                           if substring( p-in-string, v-position + 1, 4 ) = "amp;":U
      761                           then do:
      762                               assign
      763                                   p-out-string = p-out-string + "&":U
      764                                   v-position   = v-position   + 4
      765                               .
      766                           end.
      767                           else do:
      768                               case substring( p-in-string, v-position + 1, 5 )
      769                               :
      770                                   when "quot;":U
      771                                   then do:
      772                                       assign
      773                                           p-out-string = p-out-string + '"':U
      774                                           v-position   = v-position   + 5
      775                                       .
      776                                   end.
      777                                   when "apos;":U
      778                                   then do:
      779                                       assign
      780                                           p-out-string = p-out-string + "'":U
      781                                           v-position   = v-position   + 5
      782                                       .
      783                                   end.
      784                                   otherwise do:
      785                                       assign
      786                                           p-out-string = p-out-string + "&":U
      787                                       .
      788                                   end.
      789                               end case.
      790                           end.
      791                       end.
      792                   end case.
      793               end.
      794           end.
      795       end.
      796   end.
      797   end .
      798   procedure xmlchar-read-integer :
      799   define input parameter p-input-string      as character        no-undo.
      800   define output parameter p-output-integer   as integer          no-undo.
      801   define output parameter p-success       as logical          no-undo.
      802   do
      803   on error undo, return error
      804   :
      805       assign
      806           p-output-integer = integer( p-input-string )
      807       no-error.
      808       if error-status :error
      809       then do:
      810           assign
      811               p-success           = no
      812               p-output-integer    = 0
      813           .
      814       end.
      815       else do:
      816           assign
      817               p-success           = yes
      818           .
      819       end.
      820   end.
      821   end.
      822   define variable mMRCCode  as logical    no-undo.
      823   define variable mTypeMark as character  no-undo.
      824   function IS-NeedMark returns logical
      825   ( input ib-code as integer  ,
      826     input ib-str as character ):
      827      define buffer buf_prod-bc-attr for ub.prod-bc-attr.
      828      find first buf_prod-bc-attr where buf_prod-bc-attr.b-code eq ib-code
      829                                    and buf_prod-bc-attr.b-str  eq ib-str
      830                                    and buf_prod-bc-attr.attr-code eq 'mark':U
      831        no-lock no-error.
      832      return if available buf_prod-bc-attr then logical(buf_prod-bc-attr.attr-value) else no .
      833   end.
      834   function repTegforDm return char
      835   (iDM as char ):
      836       define variable vTeglist as character no-undo init "01,02,11,13,17,21,8005,37".
      837       define variable vteg as character no-undo.
      838       define variable oDM as character no-undo.
      839       define variable vi as integer no-undo.
      840       oDM = iDm.
      841       do vi = 1 to num-entries(vTeglist):
      842          vTeg = entry(vi,vTeglist).
      843          oDM = replace(oDM,"(" + vTeg + ")",vTeg).
      844       end.
      845       return oDM.
      846   end.
      847   function repSpecSimbforDm return char
      848   (iDM as char ):
      849       define variable oDM as character no-undo.
      850     run
      851       xmlchar-decode(iDM, output oDM).
      852     return repTegforDm (oDM).
      853   end.
      854   function CheckGtin return logical
      855   (iGtin as char):
      856      define variable bar_code as character no-undo.
      857      define variable vGtin as logical no-undo init "yes".
      858      if length(iGtin) eq 14
      859      then do:
      860         bar_code = substr (iGtin, 1, length (iGtin) - 1).
      861         run str/chk-sum.p
      862          (input-output bar_code ) no-error .
      863         if iGtin ne  bar_code
      864         then
      865            vGtin = no.
      866      end.
      867      else
      868         vGtin = no.
      869      return vgtin.
      870   end.
      871   function repSpecSimbforXlm return char
      872   (iDM as char ):
      873       iDM = replace(iDM,chr(29),"").
      874       return iDM.
      875   end.
      876   function getGtinByDM return char
      877   (IDM as char):
      878      define variable VTXT as char no-undo.
      879      define variable vGtin as char no-undo.
      880      vTXt = IdM.
      881      vGtin = IDM.
      882      if    length(vtxt) > 14
      883      then do:
      884         if   vtxt begins "(01)"
      885                or vtxt begins "(02)"
      886         then
      887            vGtin = substring(vtxt,5,14).
      888         else if   (vtxt begins "01"
      889                or vtxt begins "02" )
      890                and (   (    substring(iDm,17,2) eq "21"
      891                         and length(vtxt) >= 21)
      892                     or substring(iDm,17,2) eq "37"
      893                     or substring(iDm,17,4) eq "(37)" )
      894         then do:
      895            vGtin = substring(vtxt,3,14).
      896            if not checkGtin(vGtin)
      897            then
      898               vGtin = substring(vtxt,1,14).
      899         end.
      900         else if     length(vtxt) eq 14 + 7 + 4 + 4
      901             or length(vtxt) eq 14 + 7 + 4
      902             or length(vtxt) eq 14 + 7
      903         then
      904            vGtin = substring(vtxt,1,14).
      905      end.
      906      if not checkGtin(vGtin)
      907      then
      908         vGtin = "".
      909      return vgtin.
      910   end.
      911   function getGdsCodeByGtin return int
      912   (iGtin as char):
      913      define buffer prod-bc  for ub.prod-bc.
      914      define buffer bar-code for ub.bar-code.
      915      find first prod-bc where prod-bc.b-str eq iGtin  and prod-bc.bc-on no-lock no-error.
      916      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      917      return if avail bar-code then bar-code.gds-code else ?.
      918   end.
      919   function getQntyCodeByGtin return decimal
      920   (iGtin as char):
      921      define buffer prod-bc  for ub.prod-bc.
      922      define buffer bar-code for ub.bar-code.
      923      find first prod-bc where prod-bc.b-str eq iGtin no-lock no-error.
      924      find first bar-code where bar-code.b-code eq prod-bc.b-code no-lock no-error.
      925      return if avail bar-code then bar-code.cli-base-rate else ?.
      926   end.
      927   function getGdsCodeByDM return int
      928   (iDm as char):
      929      define variable vGtin as char no-undo.
      930      define buffer prod-bc for ub.prod-bc.
      931      vGtin  = getGtinByDM (IDM ).
      932      return getGdsCodeByGtin (vGtin).
      933   end.
      934   function ChekTypeMarkByGds return logical
      935   (iGds-code as integer ):
      936      define buffer goods-attr for ub.goods-attr.
      937      find first goods-attr where goods-attr.gds-code   = iGds-code
      938                              and goods-attr.attr-code  = 'mark-type':U
      939      no-lock no-error.
      940      if available goods-attr
      941      then do:
      942         mTypeMark = goods-attr.attr-value.
      943         return goods-attr.attr-value = objsrv:Env:Marking:Types:tabak:NameProp
      944           .
      945      end.
      946      else
      947         return no.
      948   end.
      949   function ChekTypeMarkByDm return logical
      950   (iDM as char ):
      951      return ChekTypeMarkByGds(getGdsCodeByDM(idm)).
      952   end.
      953   function ChekTypeMarkByGtin return logical
      954   (iGtin as char ):
      955      return ChekTypeMarkByGds(getGdsCodeByGtin(iGtin)).
      956   end.
      957   function GetNextElement return character
      958     (input iAllTeg        as logical
      959     ,output oteg          as character
      960     ,output otegval       as character
      961     ,input-output pstr    as character
      962      ):
      963        define variable vlistElem   as character no-undo init "00,01,02,21,17,11,13,(01),(02),(21),(17),(11),(13)".
      964        define variable vlistleng   as character no-undo init "27,14,14,13,06,06,06,0014,0014,0013,0006,0006,0006".
      965        define variable vlistElemDop   as character no-undo init ",37,(37),(8005),8005,93,(93)".
      966        define variable vlistlengDop   as character no-undo init ",08,0008,000006,0006,04,0004".
      967        define variable vTeg as character no-undo.
      968        define variable vLength as integer no-undo.
      969        define variable vi as integer no-undo.
      970        define variable vj as integer no-undo.
      971        define buffer code for ub.code.
      972        find first code where Code.parent eq "MarkType"
      973                          and Code.CodeValue   eq mTypeMark
      974                          no-lock no-error.
      975        if     available code
      976           and Code.misc1 ne ""
      977           and Code.misc1 ne ?
      978        then do:
      979           integer (Code.misc1) no-error.
      980           if not error-status:error
      981           then
      982             entry (4,vlistleng) = Code.misc1.
      983        end.
      984        if iAllTeg
      985        then
      986           assign
      987              vlistElem     = vlistElem    + vlistElemDop
      988              vlistleng     = vlistleng    + vlistlengDop
      989           .
      990        else if mMRCCode
      991        then
      992           assign
      993              vlistElem     = vlistElem    + ",(8005),8005"
      994              vlistleng     = vlistleng    + ",000006,0006"
      995           .
      996       block-elem:
      997       do vi = 1 to num-entries(vlistElem):
      998          vTeg = entry(vi,vlistElem).
      999          if pstr begins vTeg
     1000          then do:
     1001             if    vTeg eq "21"
     1002             then
     1003                vLength = index(pstr,chr(29)) - 2 no-error.
     1004             if vLength  <= 0
     1005             then
     1006                vLength = int(entry(vi,vlistleng)).
     1007             otegval = substring (pstr,length(vteg) + 1, vLength).
     1008             oteg = replace(replace(vteg,")",""),"(","").
     1009             vTeg = vteg + otegval.
     1010             otegval = replace(otegval,chr(29),"").
     1011             oteg = replace(replace(oteg,")",""),"(","").
     1012             pstr = substring (pstr,length(vTeg)+ 1).
     1013             vTeg = replace(vTeg,chr(29),"").
     1014             leave block-elem.
     1015          end.
     1016          else
     1017             vTeg = "".
     1018       end.
     1019       return vteg.
     1020   end.
     1021   function GetCodeIdent return character
     1022   (iDm as char):
     1023      define variable Velement   as character no-undo init "first".
     1024      define variable oCodeIdent as character no-undo.
     1025      define variable vteg as character no-undo.
     1026      define variable vtegval as character no-undo.
     1027      define variable vGtin as character no-undo.
     1028      define buffer marking for ub.marking.
     1029      for first marking no-lock where
     1030                marking.mark eq iDm
     1031            and marking.unit-ext = "LEVEL2"
     1032      :
     1033        return iDm.
     1034      end.
     1035      vGtin  = getGtinByDM (iDm ).
     1036      ChekTypeMarkByDm(idm).
     1037      if iDm begins 'tech_':U
     1038      then
     1039         oCodeIdent = iDm.
     1040      else if length(iDm) < 21
     1041      then do:
     1042         find first marking where marking.mark eq idm
     1043         no-lock no-error.
     1044         oCodeIdent = if available marking then marking.mark else  ?.
     1045      end.
     1046      else if     length(iDm) eq 29
     1047         and not iDm begins "01"
     1048         and not iDm begins "02"
     1049      then
     1050         oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21 ).
     1051      else  if     length(iDm) >= 24
     1052               and (  iDm begins "01"
     1053                   or iDm begins "02")
     1054               and  substring(iDm,17,2) ne "21"
     1055      then do:
     1056         if checkGtin(substring(iDm,1,14)) and ( (length(idm) eq 25 and substring(iDm,22,1) eq "A")
     1057                                                   or (length(idm) eq 29 and substring(iDm,22,1) eq "A"))
     1058         then
     1059            oCodeIdent = substring(iDm,1,if mMRCCode then 25 else 21).
     1060         else
     1061            oCodeIdent = iDM.
     1062      end.
     1063      else  if     (   length(iDm) eq 25
     1064                    or length(iDm) eq 21)
     1065               and (not iDm begins "01"
     1066               and  not iDm begins "02")
     1067      then
     1068         oCodeIdent = substring(iDm,1,21).
     1069      else if vGtin = substring(iDm,1,14) and checkGtin(substring(iDm,1,14)) and ( length(idm) eq 21 or (length(idm) eq 25 and substring(iDm,22,1) eq "A"))
     1070      then
     1071         oCodeIdent = substring(iDm,1,21).
     1072      else do while Velement ne "" and idm ne "":
     1073         Velement = GetNextElement(no,output vteg, output vtegval, input-output idm).
     1074         oCodeIdent = oCodeIdent + Velement.
     1075      end.
     1076      return oCodeIdent.
     1077   end.
     1078   function GetTegCod return character
     1079   (icodeIdent as char, iTeg as char):
     1080      define variable Velement   as character no-undo init "first".
     1081      define variable oTeg as character no-undo init ?.
     1082      define variable vteg as character no-undo.
     1083      define variable vtegval as character no-undo.
     1084      if     ((length(icodeIdent) eq 21
     1085         and not icodeIdent begins "01"
     1086         and not icodeIdent begins "02")
     1087         or
     1088             ( length(icodeIdent) eq 25
     1089               and not icodeIdent begins "01"
     1090               and not icodeIdent begins "02"))
     1091      then do:
     1092         if iTeg eq "01" or iTeg eq "02"
     1093         then
     1094            oTeg = substring(icodeIdent,1,21).
     1095         else  if  iTeg eq "21"
     1096         then
     1097            oTeg = substring(icodeIdent,15,7).
     1098      end.
     1099      else do:
     1100         ChekTypeMarkByDm(icodeIdent).
     1101         block-teg:
     1102            do while Velement ne "" and icodeIdent ne "":
     1103            Velement = GetNextElement(yes,output vteg, output vtegval, input-output icodeIdent).
     1104            if    Velement begins iTeg
     1105               or Velement begins "(" + iTeg + ")"
     1106            then do:
     1107               oTeg = vtegval.
     1108               leave block-teg.
     1109            end.
     1110         end.
     1111      end.
     1112      return oTeg.
     1113   end.
     1114   function isOAD return logical
     1115   (icodeIdent as character):
     1116      return length(icodeIdent) > 18 and GetTegCod(icodeIdent,"37") ne ? and GetTegCod(icodeIdent,"02") ne ?.
     1117   end.
     1118   function isMark return logical
     1119   (icodeIdent as character):
     1120      define buffer buf_marking for ub.marking.
     1121      return can-find(first buf_marking where buf_marking.mark begins icodeIdent) or
     1122             (length(icodeIdent) > 20 and not isOAD(icodeIdent)).
     1123   end.
     1124   function addBracketForCode return character
     1125   (icodeIdent as char):
     1126      define variable Velement   as character no-undo init "first".
     1127      define variable oTeg as character no-undo.
     1128      define variable vteg as character no-undo.
     1129      define variable vtegval as character no-undo.
     1130      define buffer marking for ub.marking.
     1131      find first marking no-lock where
     1132                 marking.mark begins icodeIdent no-error.
     1133      if    not ChekTypeMarkByDm(icodeIdent)
     1134         or length(icodeIdent) le 24
     1135         or (avail marking and marking.unit-ext = "LEVEL2")
     1136      then
     1137         oTeg = icodeIdent.
     1138      else do:
     1139         if (  icodeIdent begins "01"
     1140            or icodeIdent begins "02"
     1141            ) and CheckGtin(substring (icodeIdent,3,14))
     1142            and substring (icodeIdent,17,2) eq "21"
     1143         then do:
     1144            mMRCCode = yes.
     1145            ChekTypeMarkByDm(icodeIdent).
     1146            block-teg:
     1147            do while Velement ne "" and icodeIdent ne "":
     1148               Velement = GetNextElement(no,output vteg, output vtegval, input-output icodeIdent).
     1149               if vteg ne ""
     1150               then
     1151                  oTeg = oTeg + "(" + vteg + ")" + vtegval .
     1152            end.
     1153            mMRCCode = no.
     1154         end.
     1155         else do:
     1156            oTeg = icodeIdent.
     1157         end.
     1158      end.
     1159      return oTeg.
     1160   end.
     1161   function getlevelByCodId return int
     1162   (iCode as char):
     1163      define variable vLength as int no-undo.
     1164      define variable vLevel  as int no-undo.
     1165      if not ChekTypeMarkByDM (icode) then return ?.
     1166      vLength = length(iCode).
     1167      if    vLength eq 18
     1168         or vLength eq 20
     1169      then
     1170         Vlevel = 4.
     1171      else if vLength eq 21
     1172      then
     1173         Vlevel = 1.
     1174      else if vLength eq 25
     1175      then do:
     1176         if  iCode begins "01"
     1177         then
     1178            Vlevel = 3.
     1179         else
     1180            Vlevel = 1.
     1181      end.
     1182      else if     vLength >= 26
     1183              and vLength <= 46
     1184      then do:
     1185         if    substring(iCode,17,2) eq "11"
     1186            or substring(iCode,17,2) eq "13"
     1187            or (    substring(iCode,17,2) eq "21"
     1188                and vLength >= 33
     1189                and substring(iCode,26,4) ne "8005")
     1190         then
     1191            Vlevel = 4.
     1192         else if    vLength eq 31
     1193                 or vLength eq 38
     1194                 or vLength eq 39
     1195                 or vLength eq 45
     1196         then
     1197            Vlevel = 1.
     1198         else if    vLength eq 35
     1199                 or vLength eq 43
     1200         then
     1201            Vlevel = 3.
     1202         else
     1203            Vlevel = ?.
     1204      end.
     1205      else
     1206         Vlevel = ?.
     1207      return Vlevel.
     1208   end.
     1209   function getLevelMotpBycodid return character
     1210   (iDm as char):
     1211      define variable vLevel as integer no-undo.
     1212      define variable vList as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1213      vLevel = getlevelByCodId(iDm).
     1214      if    vLevel eq ?
     1215         or vLevel < 1
     1216         or vLevel > 6
     1217      then
     1218         return ?.
     1219      else
     1220         return entry(vlevel,vList).
     1221   end.
     1222   function getLevelUTDByLevelMotp return character
     1223   (iUnit as char):
     1224      define variable vLevel as integer no-undo.
     1225      define variable vListMOTP    as character no-undo init "Unit,kin,Level1,Level2,Level3,Level4,Level5".
     1226      define variable vListutd as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1227      vLevel = lookup(iUnit,vListMOTP).
     1228      if    vLevel eq ?
     1229         or vLevel < 1
     1230         or vLevel > 4
     1231      then
     1232         return ?.
     1233      else
     1234         return entry(vlevel,vListutd).
     1235   end.
     1236   function getLevelMotpByDM return character
     1237   (iDm as char):
     1238      return getLevelMotpByCodId(GetCodeIdent(iDm)).
     1239   end.
     1240   function getLevelUTDByCodId return character
     1241   (iDm as char):
     1242      define variable vLevel as integer no-undo.
     1243      define variable vList as character no-undo init "КИ,КИН,КИГУ,КИТУ".
     1244      vLevel = getlevelByCodId(iDm).
     1245      if    vLevel eq ?
     1246         or vLevel < 1
     1247         or vLevel > 4
     1248      then
     1249         return ?.
     1250      else
     1251         return entry(vlevel,vList).
     1252   end.
     1253   function getLevelUTDByDM return character
     1254   (iDm as char):
     1255      return getLevelUTDByCodId(GetCodeIdent(iDm)).
     1256   end.
     1257   define variable mNotMarkQnty as logical no-undo.
     1258   function getQntyUTDByCodId return decimal
     1259   (iDM as char):
     1260      define variable vLevel as integer no-undo.
     1261      define variable vList as character no-undo init "1,5,10,500".
     1262      define variable vGtin as character no-undo.
     1263      define variable vqnty as decimal no-undo init ?.
     1264      vqnty = dec(GetTegCod(iDM,"37")) no-error.
     1265      if vqnty eq ?
     1266      then do:
     1267         if not mNotMarkQnty
     1268         then do:
     1269            define buffer marking for ub.marking.
     1270            define variable vCodident as character no-undo.
     1271            vCodident = GetCodeIdent(idm).
     1272            find first marking where marking.mark begins vCodident no-lock no-error.
     1273            if     available marking
     1274               and marking.box-qnty ne ?
     1275            then
     1276               return marking.box-qnty.
     1277         end.
     1278         vGtin = getGtinByDm(iDM).
     1279         if ChekTypeMarkByGtin (vGtin)
     1280         then do:
     1281            vLevel = getlevelByCodId(iDM).
     1282            if     vLevel >= 1
     1283               and vLevel <= 4
     1284            then
     1285               vqnty = int(entry(vlevel,vList)).
     1286         end.
     1287         else
     1288            vqnty = getQntyCodeByGtin(vgtin).
     1289      end.
     1290      return vqnty.
     1291   end.
     1292   function getQntyUTDByDM return decimal
     1293   (iDm as char):
     1294      define variable vDM as character no-undo.
     1295      if     length (iDm) ne 25
     1296         and length (iDm) ne 29
     1297         and substring (iDm,length (iDm) - 6 + 1, 2 ) eq "93"
     1298      then
     1299         vDM = substring (iDm,1,length (iDm) - 6 ).
     1300      else
     1301         vDM = substring (iDm,1,length (iDm) - 4 ).
     1302      return getQntyUTDByCodId(vDM).
     1303   end.
     1304   function getMRC4 return decimal
     1305   (iMRC as char):
     1306      define variable oMrc     as decimal no-undo init ?.
     1307      define variable vAlphabet as character no-undo init "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!~"%&'*+-./_,:;=<>?".
     1308      define variable vi       as integer no-undo.
     1309      define variable vfound   as integer no-undo.
     1310      define variable vposStart   as integer no-undo.
     1311      do:
     1312      OMRc = 0.
     1313      do vi = 1 to 4:
     1314         define variable vsimb as character no-undo.
     1315         vsimb = substring(iMRC,vi,1).
     1316         vposStart = if keycode("Z") < keycode(vsimb) then 27 else 1.
     1317         vfound = index(vAlphabet,vsimb,vposStart) - 1.
     1318         if vfound > 0
     1319         then
     1320            OMRc = OMRc + exp (80,(4 - vi) ) * vfound  .
     1321         end.
     1322         OMRc = OMRc / 100.
     1323      end.
     1324      return OMRc.
     1325   end.
     1326   function getMRCByDM return decimal
     1327   (iDm as char):
     1328      define variable vMRC     as character no-undo.
     1329      define variable oMrc     as decimal no-undo init ?.
     1330      define variable Velement as character no-undo init "empty".
     1331      define variable vteg as character no-undo.
     1332      define variable vtegval as character no-undo.
     1333      if    length(idm) eq 14 + 7 + 4 + 4
     1334         or length(idm) eq 14 + 7 + 4
     1335      then do:
     1336         vMRC = substring(idm,22,4).
     1337         omrc = getMRC4(vMRC).
     1338      end.
     1339      else do:
     1340          ChekTypeMarkByDm(iDm).
     1341          block-mrc:
     1342          do while Velement ne "" and idm ne "":
     1343             Velement = GetNextElement(yes,output vteg, output vtegval, input-output idm).
     1344             if Velement begins "8005"
     1345             then do:
     1346                vMRC = substring(Velement,5,6).
     1347                leave block-mrc.
     1348             end.
     1349             else if Velement begins "(8005)"
     1350             then do:
     1351                vMRC = substring(Velement,7,6).
     1352                leave block-mrc.
     1353             end.
     1354          end.
     1355          if vMRC ne ""
     1356          then
     1357             OMRc = dec(vmrc) / 100 no-error.
     1358      end.
     1359      return OMRc.
     1360   end.
     1361   function MoveDate return Date
     1362   (idate as date,
     1363    iMonth as int64):
     1364      define variable vMonth   as int64 no-undo.
     1365      define variable vYear    as int64 no-undo.
     1366      define variable vDateNew as date  no-undo.
     1367       define variable vDay     as int64 no-undo.
     1368       vMonth = month(iDate) + iMonth.
     1369       vYear =  year(iDate).
     1370       if vMonth <= 0
     1371       then assign
     1372          vMonth = vMonth + 12
     1373           vYear  = vYear - 1
     1374       .
     1375       else if vMonth > 12
     1376       then assign
     1377          vMonth = vMonth - 12
     1378           vYear  = vYear + 1
     1379       .
     1380       vDateNew = date(vMonth,day(iDate),vYear) no-error.
     1381       do while error-status:error eq yes:
     1382          VDay = vDay + 1.
     1383          vDateNew = date(vMonth,day(iDate) - vDay,vYear) no-error.
     1384       end.
     1385       if VDay > 0
     1386       then
     1387          vDateNew + 1.
     1388       return vDateNew.
     1389   end.
     1390   procedure checkEMRC:
     1391   define input  parameter iDm as character no-undo.
     1392   define output parameter vok as logical   no-undo init yes.
     1393      define variable v-value-emrc as character no-undo.
     1394      define variable v-type-emrc  as character no-undo.
     1395      define variable vDateIso     as character no-undo.
     1396      define variable vMRC         as decimal no-undo.
     1397      define variable vqnty        as decimal no-undo.
     1398      define variable vPrice       as decimal no-undo.
     1399      define variable vparent      as character no-undo.
     1400      define variable vgds-code    as integer no-undo.
     1401      define buffer code for ub.code.
     1402      vMRC = getMRCByDM(iDm).
     1403      if vMRC > 0
     1404      then do:
     1405         vgds-code = getGdsCodeByDM(iDm).
     1406         vqnty     = getQntyUTDByDM(iDm).
     1407               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     1408            (
     1409             input   vgds-code
     1410            ,input   'emrc-type':U
     1411            ,output   v-value-emrc
     1412            ,output   v-type-emrc
     1413          ) no-error.
     1414          if     v-value-emrc ne ""
     1415             and v-value-emrc ne ?
     1416          then do:
     1417             vDateIso = iso-date(today).
     1418             vPrice = vMRC / vqnty.
     1419             vparent ="emc" + chr(4) + v-value-emrc.
     1420             find last code where Code.parent      eq vparent
     1421                              and Code.code        le vDateIso
     1422                              and code.status_  eq 0
     1423             no-lock no-error.
     1424             if not available code or ( vPrice  >= dec(Code.CodeValue))
     1425             then
     1426                vOk = true .
     1427             else do:
     1428                 define variable vText      as character no-undo.
     1429                 define variable vDate      as date no-undo.
     1430                 define variable vDateLast  as character no-undo.
     1431                 define variable vDateFirst as character no-undo.
     1432                 define variable vDate3     as date no-undo.
     1433                 vdate = date(code.misc1).
     1434                 vDateLast = code.misc1.
     1435                 vDate3 = MoveDate(today, - 3 ).
     1436                 vText =  substitute ("ТОВАР ИМЕЕТ ОГРАНИЧЕННЫЙ СРОК РЕАЛИЗАЦИИ. Если товар произведен после &2, то его приемка и продажа запрещена.",
     1437                                      string(vDate3  , "99/99/9999"),
     1438                                      string(vDate   , "99/99/9999")
     1439                                      ).
     1440                 vdateIso = iso-date(vdate3).
     1441                 find last code  where Code.parent      eq vparent
     1442                                   and Code.code        le vDateIso
     1443                                   and code.status_  eq 0 no-lock no-error.
     1444                 if available code
     1445                 then
     1446                    vDateIso = code.code.
     1447                 vDateFirst = vDateIso.
     1448                 vDateLast = iso-date(vdate).
     1449                 define variable vGood as logical no-undo.
     1450                 define variable vDateSale as date no-undo.
     1451                 define buffer bcode for code.
     1452                 for last code where Code.parent   eq vparent
     1453                                 and code.status_  eq 0
     1454                                 and code.code     < vDateLast
     1455                                 and code.code     >= vDateFirst
     1456                 no-lock:
     1457                    find first bcode where bCode.parent   eq vparent
     1458                                       and bcode.status_  eq 0
     1459                                       and bcode.code     > code.code no-lock no-error.
     1460                    if available bcode
     1461                    then do:
     1462                       if vPrice < dec(Code.CodeValue)
     1463                       then
     1464                          vText = vtext + substitute ("&1Если товар произведен с &2 до &3, ТО ЕГО ПРИЕМКА И ПРОДАЖА ЗАПРЕЩЕНА",
     1465                                                     chr(10),
     1466                                                     string(    date( code.misc1)       ,"99/99/9999"),
     1467                                                     string(    date(bcode.misc1)       ,"99/99/9999")
     1468                                                     ).
     1469                       else do:
     1470                          vGood = yes.
     1471                          vDateSale = MoveDate(date(bcode.misc1), 3) - 1.
     1472                          vText = vtext + substitute ("&1Если товар произведен до &3, то продажа разрешена до &4.~Осталось &5 дней.",
     1473                                                     chr(10),
     1474                                                     string(    date( code.misc1)         ,"99/99/9999"),
     1475                                                     string(    date(bcode.misc1)         ,"99/99/9999"),
     1476                                                     string(         vDateSale            ,"99/99/9999"),
     1477                                                     string(vDateSale - today)
     1478                                                     ).
     1479                       end.
     1480                    end.
     1481                 end.
     1482                 if vgood
     1483                 then do:
     1484                    define variable choice as integer no-undo .
     1485                    run gbl/d-askw.w (input "Уточнение"
     1486                           ,input  vText
     1487                           ,input "|"
     1488                           ,input "Принять|Вернуть"
     1489                           ,input "Принять данный товар|Вернуть товар постащику"
     1490                           ,input 1
     1491                           ,input 2
     1492                           ,output choice) no-error.
     1493                    vok = choice eq 1.
     1494                 end.
     1495                 else
     1496                    vok =false.
     1497             end.
     1498          end.
     1499      end.
     1500   end.
     1501   function addGs2Mark return character
     1502   (iMark as char):
     1503      define variable vDM   as character no-undo.
     1504      define variable vIdx  as integer   no-undo.
     1505      if index(iMark,chr(29),1) > 0
     1506      then return iMark.
     1507      if substring(iMark,26,4) = "8005" then
     1508      do:
     1509        vIdx = index(iMark,"93",26 + 4 + 5).
     1510        if vIdx > 1 then do:
     1511          vDM = substitute("&1&4&2&4&3",
     1512                           substring(iMark,1,25),
     1513                           substring(iMark,26,vIdx - 25 - 1),
     1514                           substring(iMark,vIdx),
     1515                           chr(29)) no-error.
     1516          vIdx = index(vDm,"240",vIdx + 4).
     1517          if vIdx > 0 then
     1518          do:
     1519            vDM = substitute("&1&3&2",
     1520                             substring(vDm,1,vIdx - 1),
     1521                             substring(vDm,vIdx),
     1522                             chr(29)) no-error.
     1523          end.
     1524        end.
     1525        else
     1526          vDM = substitute("&1&3&2",
     1527                           substring(iMark,1,25),
     1528                           substring(iMark,26),
     1529                           chr(29)) no-error.
     1530      end.
     1531      else if substring(iMark,32,2) = "91" then
     1532      do:
     1533        vIdx = index(iMark,"92",32).
     1534        if vIdx > 1 then
     1535          vDM = substitute("&1&4&2&4&3",
     1536                           substring(iMark,1,31),
     1537                           substring(iMark,32,vIdx - 31 - 1),
     1538                           substring(iMark,vIdx),
     1539                           chr(29)) no-error.
     1540        else
     1541          vDM = substitute("&1&3&2",
     1542                           substring(iMark,1,31),
     1543                           substring(iMark,32),
     1544                           chr(29)) no-error.
     1545      end.
     1546      else if substring(iMark,39,2) = "91" then
     1547      do:
     1548        vIdx = index(iMark,"92",38).
     1549        if vIdx > 1 then
     1550          vDM = substitute("&1&4&2&4&3",
     1551                           substring(iMark,1,38),
     1552                           substring(iMark,39,vIdx - 38 - 1),
     1553                           substring(iMark,vIdx),
     1554                           chr(29)) no-error.
     1555        else
     1556          vDM = substitute("&1&3&2",
     1557                           substring(iMark,1,38),
     1558                           substring(iMark,39),
     1559                           chr(29)) no-error.
     1560      end.
     1561      else if substring(iMark,25,2) = "93" then
     1562      do:
     1563        vIdx = index(iMark,"92",25).
     1564        if vIdx > 1 then
     1565          vDM = substitute("&1&4&2&4&3",
     1566                           substring(iMark,1,24),
     1567                           substring(iMark,25,vIdx - 24 - 1),
     1568                           substring(iMark,vIdx),
     1569                           chr(29)) no-error.
     1570        else
     1571          vIdx = index(iMark,"3103",25).
     1572          if vIdx > 0 then
     1573          vDM = substitute("&1&4&2&4&3",
     1574                           substring(iMark,1,24),
     1575                           substring(iMark,25,vIdx - 24 - 1),
     1576                           substring(iMark,vIdx),
     1577                           chr(29)) no-error.
     1578          else
     1579            vDM = substitute("&1&3&2",
     1580                             substring(iMark,1,24),
     1581                             substring(iMark,25),
     1582                             chr(29)) no-error.
     1583      end.
     1584      else if substring(iMark,32,2) = "93" then
     1585      do:
     1586        vDM = substitute("&1&3&2",
     1587              substring(iMark,1,31),
     1588              substring(iMark,32),
     1589              chr(29)) no-error.
     1590      end.
     1591      return if vDM <> "" then vDm else iMark.
     1592   end.
     1593   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1594   procedure gen-key-rec :
     1595     define input  parameter p-tbl-name    as character no-undo.
     1596     define input  parameter p-bh_tbl-name as handle    no-undo.
     1597     define output parameter p-key-rec     as character no-undo.
     1598     do
     1599     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1600     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1601     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1602     :
     1603       define variable fh               as handle    no-undo .
     1604       define variable v-ok             as logical   no-undo .
     1605       define variable v-inform         as character no-undo .
     1606       define variable v-ind            as integer   no-undo .
     1607       define variable v-idx-field-qnty as integer   no-undo .
     1608       if p-tbl-name = ?
     1609         or p-tbl-name = "":U
     1610       then do:
     1611         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info4 ).
     1612       end.
     1613       if not p-bh_tbl-name:available then do:
     1614         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info4, p-tbl-name ).
     1615       end.
     1616       assign
     1617         p-key-rec = p-tbl-name
     1618         v-inform  = p-bh_tbl-name:index-information(1)
     1619         v-ind     = 2
     1620       .
     1621       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1622       on error undo, return error
     1623       :
     1624         assign
     1625           v-inform = p-bh_tbl-name:index-information( v-ind )
     1626           v-ind    = v-ind + 1
     1627         .
     1628       end.
     1629       if v-inform = ?
     1630         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1631         or entry( 3, v-inform, ",":U ) <> "1":U
     1632       then do:
     1633         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, p-tbl-name ).
     1634       end.
     1635       else do:
     1636         assign
     1637           v-idx-field-qnty = num-entries( v-inform ) - 4
     1638         .
     1639         if v-idx-field-qnty < 2 then do:
     1640           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, p-tbl-name ).
     1641         end.
     1642         do v-ind = 1 to v-idx-field-qnty by 2
     1643         on error undo, return error
     1644         :
     1645           assign
     1646             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1647             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1648           .
     1649         end.
     1650       end.
     1651       if p-key-rec = ? then do:
     1652         assign
     1653           p-key-rec = "":U
     1654         .
     1655         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info4, p-tbl-name ).
     1656       end.
     1657     end.
     1658     return.
     1659   end procedure.
     1660   procedure gen-where-keyr-tab :
     1661     define input  parameter i-tableSerach as character no-undo.
     1662     define input  parameter i-tablekey   as character  no-undo.
     1663     define input  parameter p-key-rec    as character  no-undo.
     1664     define input  parameter p-key-handle as handle     no-undo .
     1665     define input  parameter p-db-name    as character  no-undo .
     1666     define input  parameter p-tt-handle  as handle     no-undo .
     1667     define output parameter o-Where      as character  no-undo.
     1668     do
     1669     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1670     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1671     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1672     :
     1673       define variable v-full-tbl-name  as character no-undo .
     1674       define variable bh_tbl-name      as handle    no-undo .
     1675       define variable fh_key           as handle    no-undo .
     1676       define variable fh_search        as handle    no-undo .
     1677       define variable v-field-num      as integer   no-undo .
     1678       define variable v-count-fld      as integer   no-undo .
     1679       define variable v-inform         as character no-undo .
     1680       define variable v-ind            as integer   no-undo .
     1681       define variable v-idx-field-qnty as integer   no-undo .
     1682       define variable v-field-name     as character no-undo .
     1683       define variable v-field-val      as character no-undo .
     1684       define variable v-word-link      as character no-undo .
     1685       define variable vTable           as character no-undo.
     1686       define variable bh_tbl-key       as handle    no-undo .
     1687       assign
     1688         p-key-rec = trim( p-key-rec )
     1689       .
     1690       if p-key-handle <> ? then do:
     1691         if not valid-handle(p-key-handle)
     1692            or p-key-handle:type <> "buffer"
     1693         then do:
     1694           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info4 ).
     1695         end.
     1696         if num-entries( p-key-rec, chr(3) ) > 1
     1697           or p-key-rec = ?
     1698           or p-key-rec = "":U
     1699         then do:
     1700           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info4, p-key-rec ).
     1701         end.
     1702       end.
     1703       else do:
     1704         if p-key-rec = ?
     1705           or p-key-rec = "":U
     1706         then do:
     1707           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
     1708         end.
     1709       end.
     1710       assign
     1711         vTable = entry( 1 , p-key-rec, chr(3) )
     1712       .
     1713       if p-tt-handle <> ?
     1714         and ( not valid-handle(p-tt-handle)
     1715               or p-tt-handle:type <> "buffer"
     1716             )
     1717       then do:
     1718         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info4, vTable, chr(10) ).
     1719       end.
     1720       if p-tt-handle = ? then do:
     1721         assign
     1722           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1723         .
     1724         create buffer bh_tbl-name for table v-full-tbl-name .
     1725       end.
     1726       else do:
     1727         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1728       end.
     1729       assign
     1730         v-inform = bh_tbl-name:index-information(1)
     1731         v-ind    = 2
     1732       .
     1733       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1734       on error undo, return error
     1735       :
     1736         assign
     1737           v-inform = bh_tbl-name:index-information( v-ind )
     1738           v-ind    = v-ind + 1
     1739         .
     1740       end.
     1741       if v-inform = ?
     1742         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1743         or entry( 3, v-inform, ",":U ) <> "1":U
     1744       then do:
     1745         delete object bh_tbl-name no-error.
     1746         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info4, vTable ).
     1747       end.
     1748       assign
     1749         v-idx-field-qnty = num-entries( v-inform ) - 4
     1750       .
     1751       if v-idx-field-qnty < 2 then do:
     1752         delete object bh_tbl-name no-error.
     1753         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, vTable ).
     1754       end.
     1755       assign
     1756         o-where     = "where":U
     1757         v-word-link = "":U
     1758         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1759         v-count-fld = 0
     1760       .
     1761       if i-tablekey ne "" and i-tablekey ne ?
     1762       then do:
     1763         assign
     1764           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1765         .
     1766         create buffer bh_tbl-key for table v-full-tbl-name .
     1767       end.
     1768       if i-tableSerach ne "" and i-tableSerach ne ?
     1769       then do:
     1770         delete object bh_tbl-name no-error.
     1771         assign
     1772           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1773         .
     1774         create buffer bh_tbl-name for table v-full-tbl-name .
     1775       end.
     1776       block_where:
     1777       do v-ind = 1 to v-idx-field-qnty by 2
     1778       on error undo, return error
     1779       :
     1780         assign
     1781           v-count-fld = v-count-fld + 1
     1782         .
     1783         if p-key-handle = ?
     1784           and v-count-fld > v-field-num
     1785         then do:
     1786           leave block_where.
     1787         end.
     1788         define variable VfieldKeyTable as handle no-undo.
     1789         assign
     1790           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1791           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1792         .
     1793         if     bh_tbl-key ne ?
     1794         then do:
     1795            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1796            if VfieldKeyTable eq ?
     1797            then next block_where.
     1798         end.
     1799         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1800         then
     1801            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1802         else
     1803            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1804         if p-key-handle = ? then do:
     1805           assign
     1806             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1807           .
     1808         end.
     1809         else do:
     1810           assign
     1811             fh_key = p-key-handle:buffer-field( v-field-name )
     1812           .
     1813           if fh_key = ?
     1814             or not valid-handle( fh_key )
     1815           then do:
     1816             delete object bh_tbl-name.
     1817             if     bh_tbl-key ne ?
     1818             then
     1819                delete object bh_tbl-key.
     1820             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info4, p-key-handle:name, v-field-name ).
     1821           end.
     1822           assign
     1823             v-field-val = fh_key:buffer-value
     1824           .
     1825         end.
     1826         if fh_search:data-type ="character":U then do:
     1827           assign
     1828             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1829             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1830             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1831             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1832             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1833             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1834             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1835             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1836             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1837             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1838             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1839             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1840             v-field-val = substitute( '"&1"', v-field-val )
     1841           .
     1842         end.
     1843         assign
     1844           o-where = substitute( "&1 &2", o-where, v-field-val )
     1845         .
     1846         if v-word-link = "":U then do:
     1847           assign
     1848             v-word-link = "and":U
     1849           .
     1850         end.
     1851       end.
     1852       delete object bh_tbl-name.
     1853       if     bh_tbl-key ne ?
     1854       then
     1855          delete object bh_tbl-key.
     1856       if p-key-handle = ?
     1857         and v-count-fld <> v-field-num
     1858       then do:
     1859         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info4, vTable ).
     1860       end.
     1861     end.
     1862   end procedure.
     1863   procedure gen-hn-keyr-tab :
     1864     define input  parameter i-tableSerach as character no-undo.
     1865     define input  parameter i-tablekey   as character no-undo.
     1866     define input  parameter p-key-rec    as character no-undo.
     1867     define input  parameter p-key-handle as handle    no-undo .
     1868     define input  parameter p-db-name    as character no-undo .
     1869     define input  parameter p-tt-handle  as handle    no-undo .
     1870     define input  parameter p-stts-lock  as integer   no-undo .
     1871     define output parameter o-hn         as handle    no-undo.
     1872     define variable v-full-tbl-name as character no-undo.
     1873     define variable v-where         as character no-undo.
     1874     define variable bh_tbl-name     as handle    no-undo.
     1875     define variable vTable          as character no-undo.
     1876     do
     1877     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1878     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1879     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1880         run gen-where-keyr-tab(i-tableSerach,
     1881                                i-tablekey,
     1882                                p-key-rec,
     1883                                p-key-handle,
     1884                                p-db-name,
     1885                                p-tt-handle,
     1886                                output v-where).
     1887         if i-tableSerach ne "" and i-tableSerach ne ?
     1888         then do:
     1889            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1890            create buffer bh_tbl-name for table v-full-tbl-name .
     1891         end.
     1892         else do:
     1893            if p-tt-handle = ? then do:
     1894               assign
     1895                  vTable = entry( 1 , p-key-rec, chr(3) )
     1896               .
     1897               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1898               create buffer bh_tbl-name for table v-full-tbl-name .
     1899            end.
     1900            else do:
     1901               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1902            end.
     1903         end.
     1904         if p-tt-handle = ? then do:
     1905            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1906         end.
     1907         else do:
     1908            bh_tbl-name:find-first( v-where ) no-error .
     1909         end.
     1910         o-hn = bh_tbl-name.
     1911      end.
     1912   end procedure.
     1913   procedure gen-hn-keyr :
     1914     define input  parameter p-key-rec    as character no-undo.
     1915     define input  parameter p-key-handle as handle    no-undo .
     1916     define input  parameter p-db-name    as character no-undo .
     1917     define input  parameter p-tt-handle  as handle    no-undo .
     1918     define input  parameter p-stts-lock  as integer   no-undo .
     1919     define output parameter o-hn         as handle    no-undo.
     1920     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1921   end.
     1922   procedure gen-row-keyr :
     1923     define input  parameter p-key-rec    as character no-undo.
     1924     define input  parameter p-key-handle as handle    no-undo .
     1925     define input  parameter p-db-name    as character no-undo .
     1926     define input  parameter p-tt-handle  as handle    no-undo .
     1927     define input  parameter p-stts-lock  as integer   no-undo .
     1928     define output parameter p-tbl-row    as rowid     no-undo.
     1929     define output parameter p-tbl-name   as character no-undo.
     1930     define variable vHn as handle no-undo.
     1931       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1932       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1933       p-tbl-name =  vHn:table.
     1934       delete object vHn no-error.
     1935     if p-tbl-row = ? then do:
     1936       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info4, p-tbl-name, p-key-rec ).
     1937     end.
     1938     else do:
     1939       return.
     1940     end.
     1941   end procedure.
     1942   procedure gen-key-fv :
     1943     define input  parameter p-key-rec    as character no-undo .
     1944     define output parameter p-field-list as character no-undo .
     1945     define output parameter p-value-list as character no-undo.
     1946     do
     1947     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1948     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1949     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1950     :
     1951       define variable v-full-tbl-name  as character no-undo .
     1952       define variable bh_tbl-name      as handle    no-undo .
     1953       define variable v-tbl-name       as character no-undo .
     1954       define variable v-field-num      as integer   no-undo .
     1955       define variable v-count-fld      as integer   no-undo .
     1956       define variable v-inform         as character no-undo .
     1957       define variable v-ind            as integer   no-undo .
     1958       define variable v-idx-field-qnty as integer   no-undo .
     1959       define variable v-delim-key      as character no-undo .
     1960       if p-key-rec = ?
     1961         or p-key-rec = "":U
     1962       then do:
     1963         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
     1964       end.
     1965       assign
     1966         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1967         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1968       .
     1969       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1970       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info4 ).
     1971       assign
     1972         v-inform = bh_tbl-name:index-information(1)
     1973         v-ind    = 2
     1974       .
     1975       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1976       on error undo, return error
     1977       :
     1978         assign
     1979           v-inform = bh_tbl-name:index-information( v-ind )
     1980           v-ind    = v-ind + 1
     1981         .
     1982       end.
     1983       if v-inform = ?
     1984         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1985         or entry( 3, v-inform, ",":U ) <> "1":U
     1986       then do:
     1987         delete object bh_tbl-name no-error.
     1988         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
     1989       end.
     1990       assign
     1991         v-idx-field-qnty = num-entries( v-inform ) - 4
     1992       .
     1993       if v-idx-field-qnty < 2 then do:
     1994         delete object bh_tbl-name no-error.
     1995         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
     1996       end.
     1997       assign
     1998         p-field-list = "":U
     1999         p-value-list = "":U
     2000         v-delim-key  = "":U
     2001         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     2002         v-count-fld  = 0
     2003       .
     2004       block_where:
     2005       do v-ind = 1 to v-idx-field-qnty by 2
     2006       on error undo, return error
     2007       :
     2008         assign
     2009           v-count-fld = v-count-fld + 1
     2010         .
     2011         if v-count-fld > v-field-num then do:
     2012           leave block_where.
     2013         end.
     2014         assign
     2015           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     2016           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     2017         .
     2018         if v-ind = 1 then do:
     2019           assign
     2020             v-delim-key = chr(3)
     2021           .
     2022         end.
     2023       end.
     2024       delete object bh_tbl-name.
     2025       if v-count-fld <> v-field-num then do:
     2026         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info4, v-tbl-name ).
     2027       end.
     2028     end.
     2029   end procedure.
     2030   procedure gen-key-field :
     2031     define input  parameter p-table      as character no-undo .
     2032     define output parameter p-field-list as character no-undo .
     2033     do
     2034     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     2035     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     2036     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     2037     :
     2038       define variable v-full-tbl-name  as character no-undo .
     2039       define variable bh_tbl-name      as handle    no-undo .
     2040       define variable v-tbl-name       as character no-undo .
     2041       define variable v-field-num      as integer   no-undo .
     2042       define variable v-count-fld      as integer   no-undo .
     2043       define variable v-inform         as character no-undo .
     2044       define variable v-ind            as integer   no-undo .
     2045       define variable v-idx-field-qnty as integer   no-undo .
     2046       define variable v-delim-key      as character no-undo .
     2047       if p-table = ?
     2048         or p-table = "":U
     2049       then do:
     2050         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info4 ).
     2051       end.
     2052       assign
     2053         v-tbl-name      = p-table
     2054         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     2055       .
     2056       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     2057       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info4 ).
     2058       assign
     2059         v-inform = bh_tbl-name:index-information(1)
     2060         v-ind    = 2
     2061       .
     2062       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     2063       on error undo, return error
     2064       :
     2065         assign
     2066           v-inform = bh_tbl-name:index-information( v-ind )
     2067           v-ind    = v-ind + 1
     2068         .
     2069       end.
     2070       if v-inform = ?
     2071         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     2072         or entry( 3, v-inform, ",":U ) <> "1":U
     2073       then do:
     2074         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
     2075       end.
     2076       assign
     2077         v-idx-field-qnty = num-entries( v-inform ) - 4
     2078       .
     2079       if v-idx-field-qnty < 2 then do:
     2080         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
     2081       end.
     2082       assign
     2083         p-field-list = "":U
     2084         v-delim-key  = "":U
     2085         v-count-fld  = 0
     2086       .
     2087       block_where:
     2088       do v-ind = 1 to v-idx-field-qnty by 2
     2089       on error undo, return error
     2090       :
     2091         assign
     2092           v-count-fld = v-count-fld + 1
     2093         .
     2094         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     2095         if v-ind = 1 then do:
     2096           assign
     2097             v-delim-key = chr(3)
     2098           .
     2099         end.
     2100       end.
     2101       delete object bh_tbl-name.
     2102     end.
     2103   end procedure.
     2104   function AddUtdErrForTab returns logical
     2105   (idb-num         as integer ,
     2106    idoc-id         as integer ,
     2107    iTab            as character,
     2108    iObj            as handle ,
     2109    iCheckType      as character,
     2110    iCodeErr        as character,
     2111    iCheckObj       as character ):
     2112      define buffer utd-err for utd-err.
     2113      define buffer utd for utd.
     2114      find first utd where utd.db-num     eq idb-num
     2115                       and utd.doc-id     eq idoc-id
     2116                       and utd.Direction  eq 'Outbound'
     2117      no-lock no-error.
     2118      if available utd
     2119      then
     2120         return no.
     2121      define variable vRecKey as character no-undo.
     2122            run gen-key-rec (input iTab,
     2123                             input  iObj,
     2124                             output vRecKey).
     2125      find first utd-err where utd-err.db-num     eq idb-num
     2126                           and utd-err.doc-id     eq idoc-id
     2127                           and utd-err.CheckType  eq iCheckType
     2128                           and utd-err.CodeErr    eq iCodeErr
     2129                           and utd-err.CheckObj   eq iCheckObj
     2130      exclusive-lock no-error.
     2131      if not available utd-err
     2132      then do:
     2133         create utd-err.
     2134         assign
     2135            utd-err.db-num         = idb-num
     2136            utd-err.doc-id         = idoc-id
     2137            utd-err.CheckType      = iCheckType
     2138            utd-err.CodeErr        = iCodeErr
     2139            utd-err.CheckObj       = if iCheckObj eq ? then "?" else iCheckObj
     2140            utd-err.reckey         = vRecKey
     2141            utd-err.qnty           = 1
     2142         .
     2143      end.
     2144      else
     2145         utd-err.qnty = utd-err.qnty + 1.
     2146      return utd-err.qnty eq 1.
     2147   end.
     2148   function AddUtdErr returns logical
     2149   (idb-num         as integer ,
     2150    idoc-id         as integer ,
     2151    iObj            as handle ,
     2152    iCheckType      as character,
     2153    iCodeErr        as character,
     2154    iCheckObj       as character ):
     2155      AddUtdErrForTab
     2156         (idb-num,
     2157          idoc-id,
     2158          iObj:table,
     2159          iObj,
     2160          iCheckType,
     2161          iCodeErr,
     2162          iCheckObj).
     2163   end.
     2164   function ClearUtdErrTypeCode returns logical
     2165   (idb-num         as integer,
     2166    idoc-id         as integer ,
     2167    iCheckType      as character,
     2168    iCodeErr        as character
     2169    ):
     2170      define buffer utd-err for utd-err.
     2171      if    iCheckType eq "*"
     2172         or iCheckType eq ?
     2173      then do:
     2174         if     iCodeErr ne ?
     2175            and iCodeErr ne "*"
     2176         then
     2177            message "Задан код ошибки " iCodeErr " для удаления, но не задан тип"
     2178            view-as alert-box.
     2179         else
     2180         for each utd-err where utd-err.db-num  eq idb-num
     2181                            and utd-err.doc-id  eq idoc-id
     2182         exclusive-lock:
     2183            delete utd-err.
     2184         end.
     2185      end.
     2186      else do:
     2187         if    iCodeErr eq ?
     2188            or iCodeErr eq "*"
     2189         then do:
     2190            for each utd-err where utd-err.db-num     eq idb-num
     2191                               and utd-err.doc-id     eq idoc-id
     2192                               and utd-err.CheckType  eq iCheckType
     2193            exclusive-lock:
     2194               delete utd-err.
     2195            end.
     2196         end.
     2197         else do:
     2198            for each utd-err where utd-err.db-num     eq idb-num
     2199                               and utd-err.doc-id     eq idoc-id
     2200                               and utd-err.CheckType  eq iCheckType
     2201                               and ub.utd-err.CodeErr eq iCodeErr
     2202            exclusive-lock:
     2203               delete utd-err.
     2204            end.
     2205         end.
     2206      end.
     2207   end.
     2208   function ClearUtdErr returns logical
     2209   (idb-num         as integer,
     2210    idoc-id         as integer ,
     2211    iCheckType      as character
     2212    ):
     2213      ClearUtdErrTypeCode(idb-num,idoc-id,iCheckType,?).
     2214   end.
     2215   function GetMesError returns character
     2216   (itxt as character,
     2217    iobj as character ):
     2218    define variable vi as integer no-undo.
     2219    do vi = num-entries(iobj ,chr(4) ) to 1 by -1 :
     2220       itxt = replace(itxt,"&" + string(vi),entry(vi,iobj,chr(4))).
     2221    end.
     2222    return itxt.
     2223   end.
     2224   function GetTextErrorType returns character
     2225   (iCheckType as character,
     2226    iCodeErr   as character,
     2227    iChechObj  as character,
     2228    iType      as character  ):
     2229      define buffer code    for code.
     2230      define variable vError as character no-undo.
     2231      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2232                        and code.code   eq iCodeErr
     2233      no-lock no-error.
     2234      if available code
     2235      then do:
     2236         define variable vType as integer no-undo.
     2237         if code.misc3 eq "error"
     2238         then
     2239            vType = 0.
     2240         else if code.misc3 eq "warning"
     2241         then
     2242            vType = 1.
     2243         else if code.misc3 eq "Hiden"
     2244         then
     2245            vType = 2.
     2246         else
     2247            vtype = int(code.misc3) no-error.
     2248         case itype:
     2249            when "error"
     2250            then do:
     2251               if vtype eq 0
     2252               then
     2253                  vError = GetMesError(Code.CodeValue,iChechObj).
     2254            end.
     2255            when "warning"
     2256            then do:
     2257               if vtype <= 1
     2258               then
     2259                  vError = GetMesError(Code.CodeValue,iChechObj).
     2260            end.
     2261            otherwise do:
     2262               vError = GetMesError(Code.CodeValue,iChechObj).
     2263            end.
     2264         end.
     2265      end.
     2266      else
     2267         vError =  iCodeErr + ":" + replace (iChechObj,chr(4),"|").
     2268      return vError.
     2269   end.
     2270   function GetTypeError returns integer
     2271   (iCheckType as character,
     2272    iCodeErr   as character):
     2273      define buffer code    for code.
     2274      define variable vType as integer no-undo.
     2275      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2276                        and code.code   eq iCodeErr
     2277      no-lock no-error.
     2278      if     not available code
     2279         and code.misc3 eq "error"
     2280      then
     2281         vType = 0.
     2282      else if code.misc3 eq "warning"
     2283      then
     2284         vType = 1.
     2285      else if code.misc3 eq "Hiden"
     2286      then
     2287         vType = 2.
     2288      else
     2289         vtype = int(code.misc3) no-error.
     2290      return vtype.
     2291   end.
     2292   function GetTextError returns character
     2293   (iCheckType as character,
     2294    iCodeErr   as character,
     2295    iChechObj  as character ):
     2296      return GetTextErrortype(iCheckType,iCodeErr,iChechObj,"warning").
     2297   end.
     2298   function GetErrForUtdStr returns character
     2299   (idb-num     as integer ,
     2300    idoc-id     as integer ,
     2301    iCheckType  as character
     2302    ):
     2303      define buffer utd-err for utd-err.
     2304      define buffer code    for code.
     2305      define variable vHQry as handle no-undo.
     2306      define variable vError as longchar no-undo.
     2307      define variable vErrorOne as longchar  no-undo.
     2308      define variable oError as character no-undo.
     2309      create query vHQry.
     2310      vHQry:set-buffers(buffer utd-err:handle).
     2311      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2312                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2313                               + if    iCheckType eq "*"
     2314                                    or iCheckType eq ?
     2315                                 then       ""
     2316                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2317      vHQry:query-open().
     2318      vHQry:get-first().
     2319      QRY-BLOCK:
     2320      repeat while not vHQry:query-off-end:
     2321         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2322         if     vErrorOne ne ""
     2323            and vErrorOne ne ?
     2324         then
     2325            vError = vError + ", " + vErrorOne.
     2326         vHQry:get-next().
     2327      end.
     2328      oError = substring(vError,3,4002).
     2329      return oError.
     2330   end.
     2331   function GetErrJsonForUtd returns character
     2332   (idb-num         as integer ,
     2333    idoc-id         as integer ,
     2334    iCheckType      as character
     2335    ):
     2336      define buffer utd-err for utd-err.
     2337      define variable vHQry as handle no-undo.
     2338      define variable vError as longchar no-undo.
     2339      define variable oError as character no-undo.
     2340      create query vHQry.
     2341      define variable vi as integer no-undo.
     2342      vHQry:set-buffers(buffer utd-err:handle).
     2343      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2344                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2345                               + if    iCheckType eq "*"
     2346                                    or iCheckType eq ?
     2347                                 then       ""
     2348                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2349      vHQry:query-open().
     2350      vHQry:get-first().
     2351      QRY-BLOCK:
     2352      repeat while not vHQry:query-off-end:
     2353         define variable vErrorOne as character no-undo.
     2354         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2355         if     vErrorOne ne ?
     2356            and vErrorOne ne ""
     2357         then do:
     2358            vi = vi + 1.
     2359            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     2360                            + '","ОбъектОш":"' + replace(utd-err.CheckObj,chr(4),"|")
     2361                            + '","ТекстОш":"' + vErrorOne + '"}'.
     2362         end.
     2363         vHQry:get-next().
     2364      end.
     2365      for first utd where utd.db-num eq idb-num
     2366                      and utd.doc-id eq idoc-id
     2367                      and utd.sts    eq ObjSrv:Env:Utd:Sts:th:DeliveryCodeMismatch:KeyIntDB
     2368      no-lock,
     2369         each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     2370                                  and utd-marking-lines.doc-id eq idoc-id
     2371                                  and utd-marking-lines.doc-level eq 1
     2372      no-lock,
     2373         first marking where marking.mark eq utd-marking-lines.mark
     2374                         and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     2375      no-lock:
     2376         vErrorOne = GetTextErrortype("CheckShip","NotMark",marking.mark,"error").
     2377         if     vErrorOne ne ?
     2378            and vErrorOne ne ""
     2379         then do:
     2380            vError = vError + ',"Ошибка_' + string(vi) +  '":~{"КодОш":"'    + "CheckShip" + "_" + "NotMark"
     2381                            + '","ОбъектОш":"' + marking.mark
     2382                            + '","ТекстОш":"' + vErrorOne + '"}'.
     2383         end.
     2384      end.
     2385      if vError ne ""
     2386      then
     2387         oError = '"Ошибки":~{' + substring(vError,2,31002) + "}".
     2388      return oError.
     2389   end.
     2390   function GetErrJsonForUtdReturn returns character
     2391   (idb-num         as integer ,
     2392    idoc-id         as integer ,
     2393    iCheckType      as character
     2394    ):
     2395      define buffer utd-err for utd-err.
     2396      define variable vHQry as handle no-undo.
     2397      define variable vError as longchar no-undo.
     2398      define variable oError as character no-undo.
     2399      define variable vi as integer no-undo.
     2400      create query vHQry.
     2401      vHQry:set-buffers(buffer utd-err:handle).
     2402      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2403                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2404                               + if    iCheckType eq "*"
     2405                                    or iCheckType eq ?
     2406                                 then       ""
     2407                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2408      vHQry:query-open().
     2409      vHQry:get-first().
     2410      QRY-BLOCK:
     2411      repeat while not vHQry:query-off-end:
     2412         define variable vErrorOne as character no-undo.
     2413         vErrorOne = GetTextErrorType(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj,"error").
     2414         if     vErrorOne ne ?
     2415            and vErrorOne ne ""
     2416         then do:
     2417            vi = vi + 1.
     2418            vError = vError + ',"Возврат_' + string(vi) +  '":~{"КодВозр":"'    + utd-err.CheckType + "_" + utd-err.CodeErr
     2419                            + '","ОбъектВозр":"' + replace(utd-err.CheckObj,chr(4),"|")
     2420                            + '","ТекстВозр":"' + GetTextError(utd-err.CheckType,utd-err.CodeErr,utd-err.CheckObj) + '"}'.
     2421         end.
     2422         vHQry:get-next().
     2423      end.
     2424      if vError ne ""
     2425      then
     2426         oError = '"Возвраты":~{' + substring(vError,2,31002) + "}".
     2427      return oError.
     2428   end.
     2429   function GetCodeTextError returns character
     2430   (iCheckType as character,
     2431    iCodeErr   as character,
     2432    iChechObj  as character,
     2433    output oCode as character,
     2434    output ovalue as character ):
     2435      define buffer code    for code.
     2436      find first code where code.parent eq "CodeError" +  chr(4)  + "UTD" +  chr(4) + iCheckType
     2437                        and code.code   eq iCodeErr
     2438      no-lock no-error.
     2439      if     available code
     2440      then do:
     2441         define variable vi as integer no-undo init ?.
     2442         vi = int(Code.misc3) no-error.
     2443         if    code.misc3 ne "error"
     2444            and vi ne 0
     2445         then
     2446            oCode = ?.
     2447         else if     Code.misc1 ne ?
     2448                 and Code.misc1 ne ""
     2449         then
     2450            assign
     2451               oCode  = GetMesError(Code.misc1,iChechObj)
     2452               ovalue = GetMesError(Code.misc2,iChechObj)
     2453            .
     2454      end.
     2455      return if oCode eq ""
     2456             then ""
     2457             else (oCode + "_" + ovalue).
     2458   end.
     2459   define temp-table TT-err no-undo
     2460     field code_ as character
     2461     field text_ as character
     2462   index code_ code_.
     2463   function GetErrTxtForUtd returns character
     2464   (idb-num         as integer ,
     2465    idoc-id         as integer ,
     2466    iCheckType      as character
     2467    ):
     2468      define buffer utd-err for utd-err.
     2469      define variable vHQry as handle no-undo.
     2470      define variable oError as character no-undo.
     2471      create query vHQry.
     2472      define variable vi as integer no-undo.
     2473      for each tt-err :
     2474         delete tt-err.
     2475      end.
     2476      vHQry:set-buffers(buffer utd-err:handle).
     2477      vHQry:query-prepare("for each utd-err where utd-err.db-num         eq " + QUOTER(idb-num)
     2478                               +            " and utd-err.doc-id         eq " + QUOTER(idoc-id)
     2479                               + if    iCheckType eq "*"
     2480                                    or iCheckType eq ?
     2481                                 then       ""
     2482                                 else       " and utd-err.CheckType      eq " + QUOTER(iCheckType)).
     2483      vHQry:query-open().
     2484      vHQry:get-first().
     2485      define variable vcode as character no-undo.
     2486      define variable vvalue as character no-undo.
     2487      QRY-BLOCK:
     2488      repeat while not vHQry:query-off-end:
     2489         vi = vi + 1.
     2490         GetCodeTextError (utd-err.CheckType, utd-err.CodeErr, utd-err.CheckObj, output vcode, output vvalue).
     2491         if vcode ne ?
     2492         then do:
     2493            find first tt-err where tt-err.code eq vcode
     2494            no-error.
     2495            if not available tt-err
     2496            then do:
     2497               create tt-err.
     2498               assign
     2499                  tt-err.code_ = vcode
     2500                  tt-err.text_ = vvalue
     2501               .
     2502            end.
     2503            else
     2504               tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2505         end.
     2506         vHQry:get-next().
     2507      end.
     2508     find first utd where utd.db-num eq idb-num
     2509                         and utd.doc-id eq idoc-id
     2510         no-lock.
     2511      define buffer cancel_utd-lines for utd-lines.
     2512      for each cancel_utd-lines where cancel_utd-lines.db-num eq idb-num
     2513                                  and cancel_utd-lines.doc-id eq idoc-id
     2514      no-lock:
     2515         if logical(getattrutdlinesex  (idb-num,idoc-id,cancel_utd-lines.LineNum,"MarkUtdLine"        ,"no"))
     2516         then do:
     2517            for   each utd-marking-lines where utd-marking-lines.db-num eq idb-num
     2518                                        and utd-marking-lines.doc-id eq idoc-id
     2519                                        and utd-marking-lines.LineNum eq cancel_utd-lines.LineNum
     2520            no-lock,
     2521               first marking where marking.mark eq utd-marking-lines.mark
     2522                               and marking.sts  eq ObjSrv:Env:Marking:Sts:Mark:NotAvailable:KeyIntDB
     2523            no-lock:
     2524               GetCodeTextError ("CheckShip", "MARKDECLINED", utd-marking-lines.mark + chr(4) + string(utd-marking-lines.LineNum), output vcode, output vvalue).
     2525               find first tt-err where tt-err.code eq vcode
     2526               no-error.
     2527               if not available tt-err
     2528               then do:
     2529                  create tt-err.
     2530                  assign
     2531                     tt-err.code_ = vcode
     2532                     tt-err.text_ = vvalue
     2533                  .
     2534               end.
     2535               else
     2536                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2537            end.
     2538         end.
     2539         else do:
     2540            define variable vqnty as decimal no-undo.
     2541            vqnty = decimal(GetAttrUtdlines(cancel_utd-lines.db-num,cancel_utd-lines.doc-id,cancel_utd-lines.linenum,"QuantityBarCode")).
     2542            if vqnty eq ? then vqnty = 0.
     2543            if vqnty ne cancel_utd-lines.Quantity
     2544            then do:
     2545               GetCodeTextError ("CheckShip", "NotAcceptQuantity", string(cancel_utd-lines.LineNum) + chr(4) + string(cancel_utd-lines.Quantity - vqnty), output vcode, output vvalue).
     2546               find first tt-err where tt-err.code eq vcode
     2547               no-error.
     2548               if not available tt-err
     2549               then do:
     2550                  create tt-err.
     2551                  assign
     2552                     tt-err.code_ = vcode
     2553                     tt-err.text_ = vvalue
     2554                  .
     2555               end.
     2556               else
     2557                  tt-err.text_ = tt-err.text_ + "||" + vvalue.
     2558            end.
     2559         end.
     2560      end.
     2561      for each tt-err:
     2562         oError = oError + substitute("&1|&2|",tt-err.code_ , tt-err.text_ ) + chr(13) + chr(10) .
     2563      end.
     2564      return oError.
     2565   end.
     2566   define variable mFormatErr as character no-undo init "text".
     2567   function GetErrForUtd returns character
     2568   (idb-num         as integer ,
     2569    idoc-id         as integer ,
     2570    iType           as character
     2571    ):
     2572      if mFormatErr eq "text"
     2573      then
     2574         return GetErrTxtForUtd(idb-num,idoc-id,iType).
     2575      else do:
     2576         if itype eq "return"
     2577         then return GetErrJsonForUtdReturn (idb-num,idoc-id,iType).
     2578         else return GetErrJsonForUtd(idb-num,idoc-id,iType).
     2579      end.
     2580   end.
     2581   function GetErrComText returns longchar
     2582   (icomment as character,
     2583    itext    as longchar ):
     2584       define variable vText as longchar no-undo.
     2585      if mFormatErr eq "text"
     2586      then do:
     2587         if icomment ne ""
     2588         then
     2589            icomment = substitute("comment:|&1|",icomment).
     2590         vText = icomment + itext.
     2591      end.
     2592      else do:
     2593         icomment = if icomment begins  '"'
     2594                    then icomment
     2595                    else  if icomment eq "" then "" else ( '"Коментрии":~{"Коментарий":"' + icomment  + '"}') .
     2596         vText = icomment + "," + itext.
     2597         vText = "~{" + trim(vText,",") + "~}".
     2598      end.
     2599      return vText.
     2600   end.
     2601   function CheckTypeForMarkLineType returns logical
     2602   (iObj            as handle,
     2603    iCheckType      as character,
     2604    iCodeErr        as character ,
     2605    iTypeErr        as character ):
     2606      define variable vRecKey-markLine as character no-undo.
     2607      define variable vGoodMark        as logical no-undo.
     2608      define variable vdb-num          as integer no-undo.
     2609      define variable vdoc-id          as integer no-undo.
     2610      define variable vlinenum         as integer no-undo.
     2611      define variable vErrorOne as character no-undo.
     2612      define buffer buf_utd-err for utd-err.
     2613      run gen-key-rec (input "utd-marking-lines",
     2614                       input  iObj,
     2615                       output vRecKey-markLine).
     2616      vGoodMark = yes.
     2617      vdb-num = iObj::db-num.
     2618      vdoc-id = iObj::doc-id.
     2619      vlinenum = iObj::linenum.
     2620      block-mark-err:
     2621      for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2622                               and buf_utd-err.db-num = vdb-num
     2623                               and buf_utd-err.reckey = vRecKey-markLine
     2624                               and if iCheckType  eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     2625                               and if iCodeErr    eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     2626      no-lock:
     2627         vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     2628         if     vErrorOne ne ?
     2629            and vErrorOne ne ""
     2630         then do:
     2631            vGoodMark = no.
     2632            leave block-mark-err.
     2633         end.
     2634      end.
     2635      return not vGoodMark.
     2636   end.
     2637   function CheckErrForMarkLineType returns logical
     2638   (iObj            as handle,
     2639    iType           as character  ):
     2640      return CheckTypeForMarkLineType (iObj,iType,"*","error").
     2641   end.
     2642   function CheckErrForMarkLine returns logical
     2643   (iObj            as handle):
     2644      return CheckErrForMarkLineType(iObj,"*").
     2645   end.
     2646   function CheckErrForLineTypeCode returns logical
     2647   (iObj                 as handle,
     2648    iCheckType           as character,
     2649    iCodeErr             as character,
     2650    iTypeErr             as character,
     2651    iOneErr              as logical):
     2652      define variable vRecKey-line     as character no-undo.
     2653      define buffer buf_utd-err for utd-err.
     2654      define variable vUtdlineError as logical no-undo.
     2655      define variable vErrorOne as character no-undo.
     2656            run gen-key-rec (input "utd-lines",
     2657                             input  iObj,
     2658                             output vRecKey-line).
     2659         define variable vdb-num as integer no-undo.
     2660         define variable vdoc-id as integer no-undo.
     2661         define variable vlinenum as integer no-undo.
     2662         vdb-num = iObj::db-num.
     2663         vdoc-id = iObj::doc-id.
     2664         vlinenum = iObj::linenum.
     2665         block-err:
     2666         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2667                                  and buf_utd-err.db-num = vdb-num
     2668                                  and buf_utd-err.reckey = vRecKey-line
     2669                                  and if iCheckType eq "*" or iCheckType eq ? then yes else buf_utd-err.CheckType = iCheckType
     2670                                  and if iCodeErr   eq "*" or iCodeErr   eq ? then yes else buf_utd-err.CodeErr   = iCodeErr
     2671         no-lock:
     2672            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,iTypeErr).
     2673            if     vErrorOne ne ?
     2674               and vErrorOne ne ""
     2675            then do:
     2676               vUtdlineError = yes.
     2677               leave block-err.
     2678            end.
     2679         end.
     2680         if  not vUtdlineError
     2681         then do:
     2682            define variable vGoodMark as logical no-undo.
     2683            vGoodMark = yes.
     2684            block-line-err:
     2685            for each utd-marking-lines where utd-marking-lines.db-num  eq vdb-num
     2686                                         and utd-marking-lines.doc-id  eq vdoc-id
     2687                                         and utd-marking-lines.LineNum eq vLineNum
     2688            no-lock:
     2689               vGoodMark = not CheckTypeForMarkLineType(buffer utd-marking-lines:handle,iCheckType,iCodeErr,iTypeErr).
     2690               if     vGoodMark
     2691                  and iOneErr eq no
     2692               then
     2693                  leave block-line-err.
     2694               if     iOneErr = yes
     2695                  and not vGoodMark
     2696               then
     2697                  leave block-line-err.
     2698            end.
     2699            vUtdlineError = not vGoodMark.
     2700         end.
     2701      return vUtdlineError.
     2702   end.
     2703   function getErrForLineType returns character
     2704   (iObj            as handle,
     2705    iType           as character  ):
     2706      define variable vRecKey-line     as character no-undo.
     2707      define buffer buf_utd-err for utd-err.
     2708      define variable vUtdlineError as logical no-undo.
     2709      define variable vErrorOne as character no-undo.
     2710      define variable oError as character no-undo.
     2711            run gen-key-rec (input "utd-lines",
     2712                             input  iObj,
     2713                             output vRecKey-line).
     2714         define variable vdb-num as integer no-undo.
     2715         define variable vdoc-id as integer no-undo.
     2716         define variable vlinenum as integer no-undo.
     2717         vdb-num = iObj::db-num.
     2718         vdoc-id = iObj::doc-id.
     2719         vlinenum = iObj::linenum.
     2720         block-err:
     2721         for each buf_utd-err  where  buf_utd-err.doc-id = vdoc-id
     2722                                  and buf_utd-err.db-num = vdb-num
     2723                                  and buf_utd-err.reckey = vRecKey-line
     2724                                  and if iType eq "*" or iType eq ? then yes else buf_utd-err.CheckType = iType
     2725         no-lock:
     2726            vErrorOne = GetTextErrorType(buf_utd-err.CheckType,buf_utd-err.CodeErr,buf_utd-err.CheckObj,"error").
     2727            if     vErrorOne ne ?
     2728               and vErrorOne ne ""
     2729            then do:
     2730               oError = oError + vErrorOne + " ".
     2731            end.
     2732         end.
     2733      return oError.
     2734   end.
     2735   function CheckErrForLineType returns logical
     2736   (iObj            as handle,
     2737    iType           as character  ):
     2738       return CheckErrForLineTypeCode (iObj,itype,"*","error",no).
     2739   end.
     2740   function CheckErrForLine returns logical
     2741   (iObj            as handle):
     2742      return CheckErrForLineType(iobj,"*").
     2743   end.
     2744   function CheckErrForUtd returns logical
     2745   (idb-num         as integer ,
     2746    idoc-id         as integer ):
     2747      for each utd-lines where utd-lines.db-num eq idb-num
     2748                           and utd-lines.doc-id eq idoc-id
     2749      no-lock :
     2750         if not CheckErrForLine (buffer ub.utd-lines:handle)
     2751         then
     2752            return no.
     2753      end.
     2754      return yes.
     2755   end.
     2756   function CheckMarkUtd-28rel return logical
     2757    (input idb-num as integer,
     2758    input idoc-id as integer):
     2759    define buffer utd                   for utd.
     2760    define buffer utd-lines             for utd-lines.
     2761    define buffer utd-marking-lines     for utd-marking-lines.
     2762    define variable v-par-type as character no-undo.
     2763    define variable vgdsNoMark as logical no-undo.
     2764    define variable EDOParSec as class ibs.th.gbl.env.prmtrs.edo .
     2765      define variable v-par-val  as character no-undo.
     2766      find first utd where utd.db-num eq idb-num
     2767                       and utd.doc-id eq idoc-id
     2768      no-lock no-error.
     2769      if available utd
     2770      then do:
     2771         if     utd.obj-code ne ?
     2772            and utd.obj-type ne ?
     2773         then do:
     2774            EDOParSec = ObjSrv:Env:ParametrsOfSection:GetSectionEDO(utd.obj-type, utd.obj-code).
     2775            Block-utd-lines:
     2776            for each utd-lines where utd-lines.db-num eq idb-num
     2777                                 and utd-lines.doc-id eq idoc-id
     2778            no-lock:
     2779               if     utd-lines.gds-code ne ?
     2780                  and utd-lines.gds-code ne 0
     2781               then do:
     2782                                  if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2783                       ( utd-lines.gds-code,
     2784                         'mark-type':U,
     2785                          output v-par-val,
     2786                          output v-par-type
     2787                       ).
     2788                  if     EDOParSec:IsEdo
     2789                     and EDOParSec:GetIsEDOForType(v-par-val)
     2790                  then do:
     2791                     find first utd-marking-lines where utd-marking-lines.db-num  eq utd-lines.db-num
     2792                                                    and utd-marking-lines.doc-id  eq utd-lines.doc-id
     2793                                                    and utd-marking-lines.LineNum eq utd-lines.LineNum
     2794                                                    and length(utd-marking-lines.mark) > 13
     2795                     no-lock no-error.
     2796                     if     avail utd-marking-lines
     2797                        and not CheckErrForLine(buffer utd-lines:handle)
     2798                     then
     2799                        leave Block-utd-lines.
     2800                  end.
     2801                  else
     2802                     vgdsNoMark = yes.
     2803               end.
     2804            end.
     2805            setattrutd (utd.db-num,utd.doc-id,"MarkUtd",if vgdsNoMark then string(available utd-lines) else "yes").
     2806            if vgdsNoMark then return available utd-lines . else return yes .
     2807         end.
     2808      end.
     2809      return yes.
     2810   end.
     2811   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2812   define buffer buf_utd-err for ub.utd-err .
     2813   define buffer utd-err for tt-utd-err .
     2814   def var Marking as class mark no-undo .
     2815   FUNCTION StatusTHName RETURNS CHARACTER
     2816     (input p-stsTH as integer)  .
     2817     Return Marking:GetLabel(p-stsTH) .
