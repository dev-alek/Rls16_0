     2819   DEFINE BUTTON b-print
     2820       IMAGE-UP FILE "cmp/b-print.bmp":U
     2821       IMAGE-DOWN FILE "cmp/b-print.bmp":U
     2822       IMAGE-INSENSITIVE FILE "cmp/b-print.bmp":U NO-CONVERT-3D-COLORS
     2823       LABEL "Печать"
     2824       SIZE 3 BY 1.
     2825   DEFINE BUTTON Btn_OK AUTO-GO
     2826        LABEL "Выход"
     2827        SIZE 15 BY 1.13
     2828        BGCOLOR 8 .
     2829   DEFINE QUERY BROWSE-2 FOR
     2830         tt-utd-err SCROLLING.
     2831   DEFINE BROWSE BROWSE-2
     2832     QUERY BROWSE-2 NO-LOCK DISPLAY
     2833         tt-utd-err.LineNum COLUMN-LABEL "№" FORMAT "999":U
     2834         tt-utd-err.gds-code COLUMN-LABEL "Код товара" FORMAT ">>>>>>>>>>>>9":U
     2835         tt-utd-err.descr COLUMN-LABEL "Описание" FORMAT "x(256)":U width 120
     2836         tt-utd-err.CheckType FORMAT "x(8)":U
     2837         tt-utd-err.CodeErr FORMAT "x(15)":U
     2838         tt-utd-err.CheckObj FORMAT "x(256)":U width 120
     2839       WITH NO-ROW-MARKERS SEPARATORS SIZE 128 BY 13.5
     2840            FONT 2 FIT-LAST-COLUMN.
     2841   DEFINE FRAME Dialog-Frame
     2842        Btn_OK AT ROW 1 COL 1
