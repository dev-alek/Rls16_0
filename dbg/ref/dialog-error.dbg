      387   procedure xmlchar-test :
      388   define input parameter p-in-string          as character        no-undo.
      389   define output parameter p-out-string-enc    as character        no-undo.
      390   define output parameter p-out-string-dec    as character        no-undo.
      391   do
      392   on error undo, return error
      393   :
      394          run xmlchar-encode in this-procedure
      395       (
      396             input p-in-string
      397           , output p-out-string-enc
      398       ).
      399          run xmlchar-decode in this-procedure
      400       (
      401             input p-out-string-enc
      402           , output p-out-string-dec
      403       ).
      404   end.
      405   end .
      406   procedure xmlchar-encode :
      407   define input parameter p-in-string      as character        no-undo.
      408   define output parameter p-out-string    as character        no-undo.
      409       define variable v-position      as integer      no-undo.
      410       define variable v-current-char  as character    no-undo.
      411   do
      412   on error undo, return error
      413   :
      414       assign
      415           p-out-string = "":U
      416       .
      417       case p-in-string
      418       :
      419           when ?
      420           then do:
      421               assign
      422                   p-out-string = "?":U
      423               .
      424           end.
      425           when "?":U
      426           then do:
      427               assign
      428                   p-out-string = "&#63;":U
      429               .
      430           end.
      431           otherwise do:
      432               do v-position = 1 to length( p-in-string )
      433               :
      434                   assign
      435                       v-current-char = substring( p-in-string, v-position, 1 )
      436                   .
      437                   case v-current-char
      438                   :
      439                       when "&":U
      440                       then do:
      441                           assign
      442                               p-out-string = p-out-string + "&amp;":U
      443                           .
      444                       end.
      445                       when ">":U
      446                       then do:
      447                           assign
      448                               p-out-string = p-out-string + "&gt;":U
      449                           .
      450                       end.
      451                       when "<":U
      452                       then do:
      453                           assign
      454                               p-out-string = p-out-string + "&lt;":U
      455                           .
      456                       end.
      457                       when "'":U
      458                       then do:
      459                           assign
      460                               p-out-string = p-out-string + "&apos;":U
      461                           .
      462                       end.
      463                       when '"':U
      464                       then do:
      465                           assign
      466                               p-out-string = p-out-string + "&quot;":U
      467                           .
      468                       end.
      469                       when chr(1)
      470                       then do:
      471                           assign
      472                               p-out-string = p-out-string + "":U
      473                           .
      474                       end.
      475                       when chr(2)
      476                       then do:
      477                           assign
      478                               p-out-string = p-out-string + "":U
      479                           .
      480                       end.
      481                       when chr(3)
      482                       then do:
      483                           assign
      484                               p-out-string = p-out-string + "":U
      485                           .
      486                       end.
      487                       when chr(4)
      488                       then do:
      489                           assign
      490                               p-out-string = p-out-string + "":U
      491                           .
      492                       end.
      493                       when chr(5)
      494                       then do:
      495                           assign
      496                               p-out-string = p-out-string + "":U
      497                           .
      498                       end.
      499                       when chr(6)
      500                       then do:
      501                           assign
      502                               p-out-string = p-out-string + "":U
      503                           .
      504                       end.
      505                       when chr(7)
      506                       then do:
      507                           assign
      508                               p-out-string = p-out-string + "":U
      509                           .
      510                       end.
      511                       when chr(8)
      512                       then do:
      513                           assign
      514                               p-out-string = p-out-string + "":U
      515                           .
      516                       end.
      517                       when chr(9)
      518                       then do:
      519                           assign
      520                               p-out-string = p-out-string + "":U
      521                           .
      522                       end.
      523                       when chr(29)
      524                       then do:
      525                           assign
      526                               p-out-string = p-out-string + "":U
      527                           .
      528                       end.
      529                       when chr(10)
      530                       then do:
      531                           assign
      532                               p-out-string = p-out-string + "&#10;":U
      533                           .
      534                       end.
      535                       when chr(13)
      536                       then do:
      537                           assign
      538                               p-out-string = p-out-string + "&#13;":U
      539                           .
      540                       end.
      541                       otherwise do:
      542                           assign
      543                               p-out-string = p-out-string + v-current-char
      544                           .
      545                       end.
      546                   end case.
      547               end.
      548           end.
      549       end case.
      550   end.
      551   end .
      552   procedure xmlchar-encode-1c :
      553   define input parameter p-in-string      as character        no-undo.
      554   define output parameter p-out-string    as character        no-undo.
      555       define variable v-position      as integer      no-undo.
      556       define variable v-current-char  as character    no-undo.
      557   do
      558   on error undo, return error
      559   :
      560       assign
      561           p-out-string = "":U
      562       .
      563       case p-in-string
      564       :
      565           when ?
      566           then do:
      567               assign
      568                   p-out-string = "?":U
      569               .
