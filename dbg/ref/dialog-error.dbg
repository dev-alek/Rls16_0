      571           otherwise do:
      572               do v-position = 1 to length( p-in-string )
      573               :
      574                   assign
      575                       v-current-char = substring( p-in-string, v-position, 1 )
      576                   .
      577                   case v-current-char
      578                   :
      579                       when chr(1)
