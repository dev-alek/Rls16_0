      194   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      195   function getattrUtdex returns char
      196   (idb-num   as integer,
      197    idoc-id   as integer,
      198    iattrcode as character,
      199    iExValue  as character  ):
      200      define buffer utd-attr for utd-attr.
      201      find first utd-attr where utd-attr.db-num eq idb-num
      202                            and utd-attr.doc-id eq idoc-id
      203                            and utd-attr.attr-code eq iattrcode
      204      no-lock no-error.
      205      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
      206   end.
      207   function getattrUtd returns char
      208   (idb-num   as integer,
      209    idoc-id   as integer,
      210    iattrcode as character ):
      211     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
      212   end.
      213   function setattrUtd returns logical
      214   (idb-num   as integer,
      215    idoc-id   as integer,
      216    iattrcode as character,
      217    iattrval  as character ):
      218      define buffer utd-attr for utd-attr.
      219      find first utd-attr where utd-attr.db-num eq idb-num
      220                            and utd-attr.doc-id eq idoc-id
      221                            and utd-attr.attr-code eq iattrcode
      222      no-lock no-error.
      223      if not available utd-attr
      224      then do:
      225         create utd-attr.
      226         assign
      227            utd-attr.db-num    = idb-num
      228            utd-attr.doc-id    = idoc-id
      229            utd-attr.attr-code = iattrcode
      230            utd-attr.attr-value = iattrval
      231         .
      232      end.
      233      else do:
      234         if utd-attr.attr-value ne iattrval
      235         then do:
      236            find current utd-attr exclusive-lock no-error.
      237            if available utd-attr
      238            then
      239               utd-attr.attr-value = iattrval.
      240         end.
      241      end.
      242      release utd-attr.
      243   end.
      244   function GetAttrUtdlinesEx returns char
      245   (idb-num   as integer,
      246    idoc-id   as integer,
      247    ilinenum  as integer,
      248    iattrcode as character,
      249    iExValue  as character  ):
      250      define buffer utd-lines-attr for utd-lines-attr.
      251      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
      252                                  and utd-lines-attr.doc-id    eq idoc-id
      253                                  and utd-lines-attr.lineNum   eq ilineNum
      254                                  and utd-lines-attr.attr-code eq iattrcode
      255      no-lock no-error.
      256      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
      257   end.
      258   function GetAttrUtdlines returns char
      259   (idb-num   as integer,
      260    idoc-id   as integer,
      261    ilinenum  as integer,
      262    iattrcode as character ):
      263      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
      264   end.
      265   function setattrUtdlines returns logical
      266   (idb-num   as integer,
      267    idoc-id   as integer,
      268    ilinenum  as integer,
      269    iattrcode as character,
      270    iattrval  as character ):
      271      define buffer utd-lines-attr for utd-lines-attr.
      272      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
      273                                  and utd-lines-attr.doc-id    eq idoc-id
      274                                  and utd-lines-attr.lineNum   eq ilineNum
      275                                  and utd-lines-attr.attr-code eq iattrcode
      276      no-lock no-error.
      277      if not available utd-lines-attr
      278      then do:
      279         if iattrval ne ?
      280            and iattrval ne ""
      281         then do:
      282            create utd-lines-attr.
      283            assign
      284               utd-lines-attr.db-num    = idb-num
      285               utd-lines-attr.doc-id    = idoc-id
      286               utd-lines-attr.lineNum   = ilineNum
      287               utd-lines-attr.attr-code = iattrcode
      288               utd-lines-attr.attr-value = iattrval
      289            .
      290         end.
      291      end.
      292      else do:
      293         if utd-lines-attr.attr-value ne iattrval
      294         then do:
      295            find current utd-lines-attr exclusive-lock no-error.
      296            if available utd-lines-attr
      297            then do:
      298               if    iattrval eq ?
      299                  or iattrval eq ""
      300               then do:
      301                  delete utd-lines-attr.
      302               end.
      303               else do:
      304                  utd-lines-attr.attr-value = iattrval.
      305               end.
      306            end.
      307         end.
      308      end.
      309      release utd-lines-attr.
      310   end.
      311   function GetAttrUtdMarkingLinesEx returns char
      312   (idb-num   as integer,
      313    idoc-id   as integer,
      314    ilinenum  as integer,
      315    imark     as character,
      316    iattrcode as character,
      317    iExValue  as character  ):
      318      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
      319      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
      320                                          and utd-marking-lines-attr.doc-id    eq idoc-id
      321                                          and utd-marking-lines-attr.lineNum   eq ilineNum
      322                                          and utd-marking-lines-attr.mark      eq imark
      323                                          and utd-marking-lines-attr.attr-code eq iattrcode
      324      no-lock no-error.
      325      return if not available utd-marking-lines-attr  then iExValue    else  utd-marking-lines-attr.attr-value.
      326   end.
      327   function GetAttrUtdMarkingLines returns char
      328   (idb-num   as integer,
      329    idoc-id   as integer,
      330    ilinenum  as integer,
      331    imark     as character,
      332    iattrcode as character ):
      333      return GetAttrUtdMarkingLinesEx (idb-num,idoc-id,ilinenum,imark,iattrcode,?).
      334   end.
      335   function setattrUtdMarkingLines returns logical
      336   (idb-num   as integer,
      337    idoc-id   as integer,
      338    ilinenum  as integer,
      339    imark     as character,
      340    iattrcode as character,
      341    iattrval  as character ):
      342      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
      343      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
      344                                          and utd-marking-lines-attr.doc-id    eq idoc-id
      345                                          and utd-marking-lines-attr.lineNum   eq ilineNum
      346                                          and utd-marking-lines-attr.mark      eq imark
      347                                          and utd-marking-lines-attr.attr-code eq iattrcode
      348      no-lock no-error.
      349      if not available utd-marking-lines-attr
      350      then do:
      351         if iattrval ne ?
      352            and iattrval ne ""
      353         then do:
      354            create utd-marking-lines-attr.
      355            assign
      356               utd-marking-lines-attr.db-num     = idb-num
      357               utd-marking-lines-attr.doc-id     = idoc-id
      358               utd-marking-lines-attr.lineNum    = ilineNum
      359               utd-marking-lines-attr.mark       = imark
      360               utd-marking-lines-attr.attr-code  = iattrcode
      361               utd-marking-lines-attr.attr-value = iattrval
      362            .
      363         end.
      364      end.
      365      else do:
      366         if utd-marking-lines-attr.attr-value ne iattrval
      367         then do:
      368            find current utd-marking-lines-attr exclusive-lock no-error.
      369            if available utd-marking-lines-attr
      370            then do:
      371               if    iattrval eq ?
      372                  or iattrval eq ""
      373               then do:
      374                  delete utd-marking-lines-attr.
      375               end.
      376               else do:
      377                  utd-marking-lines-attr.attr-value = iattrval.
      378               end.
      379            end.
      380         end.
      381      end.
      382      release utd-marking-lines-attr.
      383   end.
