     2871     END.
     2872   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2873     THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2874   MAIN-BLOCK:
     2875   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2876     ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2877     Marking = ObjSrv:Env:Marking:Sts:Mark.
     2878     run init-temp .
     2879   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2880   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2881   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2882   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2883   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2884   define variable v-diasize-current-frame-height as decimal   no-undo .
     2885   define variable v-diasize-change-size          as logical   no-undo .
     2886   define variable v-diasize-resize-button        as handle    no-undo .
     2887   define variable v-diasize-wndmax               as logical   no-undo .
     2888   define variable v-diasize-wndstore             as logical   no-undo .
     2889   define variable v-diasize-proc-name            as character no-undo .
     2890   define variable v-diasize-browse-handle        as handle    no-undo .
     2891   define variable v-diasize-browse-number        as integer   no-undo .
     2892   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2893   define temp-table temp-diasize-handle no-undo
     2894     field handle-value  as handle
     2895     field save-position as decimal
     2896     index xpk is primary unique handle-value
     2897     .
     2898   define temp-table temp-browse-handle no-undo
     2899     field browse-type   as character
     2900     field browse-number as integer
     2901     field browse-handle as handle
     2902     field original-size as decimal
     2903     index xpk is primary unique browse-type browse-number
     2904     index xie browse-type browse-handle
     2905   .
     2906   procedure diasize_change-height :
     2907     define input  parameter p-change-value  as decimal   no-undo .
     2908     define input  parameter p-move-resize   as logical   no-undo .
     2909     define variable v-field-group-handle    as handle    no-undo .
     2910     define variable v-object-handle         as handle    no-undo .
     2911     define variable v-frame-height          as decimal   no-undo .
     2912     define variable v-frame-virtual-height  as decimal   no-undo .
     2913     define variable v-browse-height         as decimal   no-undo .
     2914     define variable v-window-height         as decimal   no-undo .
     2915     define variable v-window-virtual-height as decimal   no-undo .
     2916     define variable v-change-sign           as integer   no-undo .
     2917     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2918     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2919     if p-change-value > 0
     2920     then do:
     2921       if frame Dialog-Frame :height + p-change-value
     2922           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2923       then do:
     2924         assign
     2925           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2926                           - (frame Dialog-Frame :height-chars)
     2927         .
     2928         if p-change-value <= 0
     2929         then do:
     2930           run diasize_position-resize-button in this-procedure .
     2931           return .
     2932         end.
     2933       end.
     2934     end.
     2935     if p-change-value < 0
     2936     then do:
     2937       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2938       then do:
     2939         assign
     2940           p-change-value = v-diasize-orig-frame-height
     2941                          - (frame Dialog-Frame :height-chars)
     2942         .
     2943         if p-change-value >= 0
     2944         then do:
     2945           run diasize_position-resize-button in this-procedure .
     2946           return .
     2947         end.
     2948       end.
     2949     end.
     2950     if p-change-value >= 0
     2951     then do:
     2952       assign
     2953         v-change-sign = 1
     2954       .
     2955     end.
     2956     else do:
     2957       assign
     2958         v-change-sign = -1
     2959       .
     2960     end.
     2961     assign
     2962       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2963     .
     2964     if p-change-value = 0
     2965     then do:
     2966       run diasize_position-resize-button in this-procedure .
     2967       return .
     2968     end.
     2969     move_block:
     2970     do
     2971     on error undo move_block, retry move_block
     2972     :
     2973       if retry
     2974       then do:
     2975         do
     2976         on error undo move_block, leave move_block
     2977         :
     2978           if p-change-value > 0
     2979           then do:
     2980             for each buf_temp-diasize-handle
     2981             on error undo, next
     2982             :
     2983               assign
     2984                 v-object-handle = buf_temp-diasize-handle.handle-value
     2985               .
     2986               if v-object-handle <> v-diasize-resize-button
     2987               then do:
     2988                 assign
     2989                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2990                 .
     2991               end.
     2992             end.
     2993             assign
     2994               v-diasize-browse-handle :height = v-browse-height
     2995             .
     2996             for each buf_temp-browse-handle
     2997               where buf_temp-browse-handle.browse-type = 'height':u
     2998             on error undo, next
     2999             :
     3000               assign
     3001                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3002               .
     3003             end.
     3004             assign
     3005               frame Dialog-Frame :height = v-frame-height
     3006             .
     3007             if frame Dialog-Frame :scrollable = true
     3008             then do:
     3009               assign
     3010                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3011               .
     3012             end.
     3013             run diasize_position-resize-button in this-procedure .
     3014           end.
     3015           else do:
     3016             if frame Dialog-Frame :scrollable = true
     3017             then do:
     3018               assign
     3019                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     3020               .
     3021             end.
     3022             assign
     3023               frame Dialog-Frame :height = v-frame-height
     3024             .
     3025             assign
     3026               v-diasize-browse-handle :height = v-browse-height
     3027             .
     3028             for each buf_temp-browse-handle
     3029               where buf_temp-browse-handle.browse-type = 'height':u
     3030             on error undo, next
     3031             :
     3032               assign
     3033                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     3034               .
     3035             end.
     3036             for each buf_temp-diasize-handle
     3037             on error undo, next
     3038             :
     3039               assign
     3040                 v-object-handle = buf_temp-diasize-handle.handle-value
     3041               .
     3042               if v-object-handle <> v-diasize-resize-button
     3043               then do:
     3044                 assign
     3045                   v-object-handle :row = buf_temp-diasize-handle.save-position
     3046                 .
     3047               end.
     3048             end.
     3049             run diasize_position-resize-button in this-procedure .
     3050           end.
     3051           assign
     3052             v-diasize-change-size = false
     3053           .
     3054           leave move_block .
     3055         end.
     3056       end.
     3057       assign
     3058         v-diasize-need-full-display = true
     3059       .
     3060       if v-diasize-change-size = false
     3061       then do:
     3062         assign
     3063           v-diasize-change-size = true
     3064         .
     3065       end.
     3066       else do:
     3067         return .
     3068       end.
     3069       assign
     3070         v-frame-height = frame Dialog-Frame :height
     3071         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     3072         v-browse-height = v-diasize-browse-handle :height
     3073       .
     3074       for each buf_temp-browse-handle
     3075         where buf_temp-browse-handle.browse-type = 'height':u
     3076       :
     3077         assign
     3078           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     3079         .
     3080       end.
     3081       for each buf_temp-diasize-handle
     3082       :
     3083         delete buf_temp-diasize-handle .
     3084       end.
     3085       assign
     3086         v-field-group-handle = frame Dialog-Frame :first-child
     3087       .
     3088       do while valid-handle(v-field-group-handle)
     3089       :
     3090         assign
     3091           v-object-handle = v-field-group-handle :first-child
     3092         .
     3093         do while valid-handle(v-object-handle)
     3094         :
     3095           if  v-object-handle <> v-diasize-browse-handle :handle
     3096           and can-query(v-object-handle, "row")
     3097           and can-query(v-object-handle, "height")
     3098           and ( v-object-handle :row > v-diasize-browse-handle :row )
     3099           then do:
     3100             find first buf_temp-browse-handle
     3101               where buf_temp-browse-handle.browse-type   = 'height':u
     3102                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3103               no-error .
     3104             if available buf_temp-browse-handle
     3105             then do:
     3106             end.
     3107             else do:
     3108               create buf_temp-diasize-handle .
     3109               assign
     3110                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3111                 buf_temp-diasize-handle.save-position = v-object-handle :row
     3112               .
     3113             end.
     3114           end.
     3115           assign
     3116             v-object-handle = v-object-handle :next-sibling
     3117           .
     3118         end.
     3119         assign
     3120           v-field-group-handle = v-field-group-handle :next-sibling
     3121         .
     3122       end.
     3123       do with frame Dialog-Frame
     3124       :
     3125         hide v-diasize-resize-button .
     3126         assign
     3127           v-diasize-resize-button :row    = 1
     3128           v-diasize-resize-button :column = 1
     3129         .
     3130       end.
     3131       if p-change-value > 0
     3132       then do:
     3133         if frame Dialog-Frame :scrollable = true
     3134         then do:
     3135           assign
     3136             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3137             no-error .
     3138           if error-status :error
     3139           or error-status :get-message(1) <> ""
     3140           then do:
     3141             undo move_block, retry move_block .
     3142           end.
     3143         end.
     3144         assign
     3145           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3146           no-error .
     3147         if error-status :error
     3148         or error-status :get-message(1) <> ""
     3149         then do:
     3150           undo move_block, retry move_block .
     3151         end.
     3152         assign
     3153           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3154           no-error .
     3155         if error-status :error
     3156         or error-status :get-message(1) <> ""
     3157         then do:
     3158           undo move_block, retry move_block .
     3159         end.
     3160         for each buf_temp-browse-handle
     3161           where buf_temp-browse-handle.browse-type = 'height':u
     3162         on error undo move_block, retry move_block
     3163         :
     3164           assign
     3165             buf_temp-browse-handle.browse-handle :height
     3166               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3167             no-error .
     3168           if error-status :error
     3169           or error-status :get-message(1) <> ""
     3170           then do:
     3171             undo move_block, retry move_block .
     3172           end.
     3173         end.
     3174         for each buf_temp-diasize-handle
     3175         on error undo move_block, retry move_block
     3176         :
     3177           assign
     3178             v-object-handle = buf_temp-diasize-handle.handle-value
     3179           .
     3180           if v-object-handle <> v-diasize-resize-button
     3181           then do:
     3182             assign
     3183               v-object-handle :row = v-object-handle :row + p-change-value
     3184               no-error .
     3185             if error-status :error
     3186             or error-status :get-message(1) <> ""
     3187             then do:
     3188               undo move_block, retry move_block .
     3189             end.
     3190           end.
     3191         end.
     3192       end.
     3193       else do:
     3194         for each buf_temp-diasize-handle
     3195         on error undo move_block, retry move_block
     3196         :
     3197           assign
     3198             v-object-handle = buf_temp-diasize-handle.handle-value
     3199           .
     3200           if v-object-handle <> v-diasize-resize-button
     3201           then do:
     3202             assign
     3203               v-object-handle :row = v-object-handle :row + p-change-value
     3204               no-error .
     3205             if error-status :error
     3206             or error-status :get-message(1) <> ""
     3207             then do:
     3208               undo move_block, retry move_block .
     3209             end.
     3210           end.
     3211         end.
     3212         assign
     3213           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     3214           no-error .
     3215         if error-status :error
     3216         or error-status :get-message(1) <> ""
     3217         then do:
     3218           undo move_block, retry move_block .
     3219         end.
     3220         for each buf_temp-browse-handle
     3221           where buf_temp-browse-handle.browse-type = 'height':u
     3222         on error undo move_block, retry move_block
     3223         :
     3224           assign
     3225             buf_temp-browse-handle.browse-handle :height
     3226               = buf_temp-browse-handle.browse-handle :height + p-change-value
     3227             no-error .
     3228           if error-status :error
     3229           or error-status :get-message(1) <> ""
     3230           then do:
     3231             undo move_block, retry move_block .
     3232           end.
     3233         end.
     3234         assign
     3235           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3236           no-error .
     3237         if error-status :error
     3238         or error-status :get-message(1) <> ""
     3239         then do:
     3240           undo move_block, retry move_block .
     3241         end.
     3242         if frame Dialog-Frame :scrollable = true
     3243         then do:
     3244           assign
     3245             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3246             no-error .
     3247           if error-status :error
     3248           or error-status :get-message(1) <> ""
     3249           then do:
     3250             undo move_block, retry move_block .
     3251           end.
     3252         end.
     3253       end.
     3254       if p-move-resize = true
     3255       then do:
     3256         run diasize_position-resize-button in this-procedure .
     3257       end.
     3258       if v-diasize-wndstore = true
     3259       then do:
     3260         if connected("ub") = true
     3261         then do:
     3262           define variable v-cntxt-db-num        as integer   no-undo .
     3263           define variable v-cntxt-userid        as character no-undo .
     3264           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3265                                             , OUTPUT v-cntxt-userid
     3266                                             ) .
     3267           run gbl/wndsizew.p
     3268             (input  v-cntxt-db-num
     3269             ,input  v-cntxt-userid
     3270             ,input  v-diasize-proc-name
     3271             ,input  'height':u
     3272             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3273             ) .
     3274         end.
     3275       end.
     3276     end.
     3277     assign
     3278       v-diasize-change-size = false
     3279     .
     3280   end procedure.
     3281   procedure diasize_set-height :
     3282     define input  parameter p-new-height  as decimal   no-undo .
     3283     define input  parameter p-move-resize as logical   no-undo .
     3284     do
     3285     on error undo, return error return-value
     3286     :
     3287       run diasize_change-height in this-procedure
     3288         (input  (p-new-height - frame Dialog-Frame :height)
     3289         ,input  p-move-resize
     3290         ) .
     3291     end.
     3292   end procedure.
     3293   procedure diasize_change-width :
     3294     define input  parameter p-change-value as decimal   no-undo .
     3295     define input  parameter p-move-resize  as logical   no-undo .
     3296     define variable v-field-group-handle   as handle    no-undo .
     3297     define variable v-object-handle        as handle    no-undo .
     3298     define variable v-frame-width          as decimal   no-undo .
     3299     define variable v-frame-virtual-width  as decimal   no-undo .
     3300     define variable v-browse-width         as decimal   no-undo .
     3301     define variable v-window-width         as decimal   no-undo .
     3302     define variable v-window-virtual-width as decimal   no-undo .
     3303     define variable v-change-sign          as integer   no-undo .
     3304     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3305     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3306     if p-change-value > 0
     3307     then do:
     3308       if frame Dialog-Frame :width + p-change-value >
     3309           session :width-chars
     3310       then do:
     3311         assign
     3312           p-change-value = session :width-chars - frame Dialog-Frame :width
     3313         .
     3314         if p-change-value <= 0
     3315         then do:
     3316           run diasize_position-resize-button in this-procedure .
     3317           return .
     3318         end.
     3319       end.
     3320     end.
     3321     if p-change-value < 0
     3322     then do:
     3323       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3324       then do:
     3325         assign
     3326           p-change-value = v-diasize-orig-frame-width
     3327                          - frame Dialog-Frame :width
     3328         .
     3329         if p-change-value >= 0
     3330         then do:
     3331           run diasize_position-resize-button in this-procedure .
     3332           return .
     3333         end.
     3334       end.
     3335     end.
     3336     if p-change-value >= 0
     3337     then do:
     3338       assign
     3339         v-change-sign = 1
     3340       .
     3341     end.
     3342     else do:
     3343       assign
     3344         v-change-sign = -1
     3345       .
     3346     end.
     3347     assign
     3348       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3349     .
     3350     if p-change-value = 0
     3351     then do:
     3352       run diasize_position-resize-button in this-procedure .
     3353       return .
     3354     end.
     3355     move_block:
     3356     do
     3357     on error undo move_block, leave move_block
     3358     :
     3359       if retry
     3360       then do:
     3361         do
     3362         on error undo move_block, leave move_block
     3363         :
     3364           if p-change-value > 0
     3365           then do:
     3366             for each buf_temp-diasize-handle
     3367             on error undo, next
     3368             :
     3369               assign
     3370                 v-object-handle = buf_temp-diasize-handle.handle-value
     3371               .
     3372               if v-object-handle <> v-diasize-resize-button
     3373               then do:
     3374                 assign
     3375                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3376                 .
     3377               end.
     3378             end.
     3379             assign
     3380               v-diasize-browse-handle :width = v-browse-width
     3381             .
     3382             for each buf_temp-browse-handle
     3383               where buf_temp-browse-handle.browse-type = 'width':u
     3384             on error undo, next
     3385             :
     3386               assign
     3387                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3388               .
     3389             end.
     3390             assign
     3391               frame Dialog-Frame :width = v-frame-width
     3392             .
     3393             if frame Dialog-Frame :scrollable = true
     3394             then do:
     3395               assign
     3396                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3397               .
     3398             end.
     3399             run diasize_position-resize-button in this-procedure .
     3400           end.
     3401           else do:
     3402             if frame Dialog-Frame :scrollable = true
     3403             then do:
     3404               assign
     3405                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     3406               .
     3407             end.
     3408             assign
     3409               frame Dialog-Frame :width = v-frame-width
     3410             .
     3411             for each buf_temp-browse-handle
     3412               where buf_temp-browse-handle.browse-type = 'width':u
     3413             on error undo, next
     3414             :
     3415               assign
     3416                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     3417               .
     3418             end.
     3419             assign
     3420               v-diasize-browse-handle :width = v-browse-width
     3421             .
     3422             for each buf_temp-diasize-handle
     3423             on error undo, next
     3424             :
     3425               assign
     3426                 v-object-handle = buf_temp-diasize-handle.handle-value
     3427               .
     3428               if v-object-handle <> v-diasize-resize-button
     3429               then do:
     3430                 assign
     3431                   v-object-handle :col = buf_temp-diasize-handle.save-position
     3432                 .
     3433               end.
     3434             end.
     3435             run diasize_position-resize-button in this-procedure .
     3436           end.
     3437           assign
     3438             v-diasize-change-size = false
     3439           .
     3440           leave move_block .
     3441         end.
     3442       end.
     3443       assign
     3444         v-diasize-need-full-display = true
     3445       .
     3446       if v-diasize-change-size = false
     3447       then do:
     3448         assign
     3449           v-diasize-change-size = true
     3450         .
     3451       end.
     3452       else do:
     3453         return .
     3454       end.
     3455       assign
     3456         v-frame-width = frame Dialog-Frame :width
     3457         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     3458         v-browse-width = v-diasize-browse-handle :width
     3459       .
     3460       for each buf_temp-browse-handle
     3461         where buf_temp-browse-handle.browse-type = 'width':u
     3462       :
     3463         assign
     3464           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     3465         .
     3466       end.
     3467       for each buf_temp-diasize-handle
     3468       :
     3469         delete buf_temp-diasize-handle .
     3470       end.
     3471       assign
     3472         v-field-group-handle = frame Dialog-Frame :first-child
     3473       .
     3474       do while valid-handle(v-field-group-handle)
     3475       :
     3476         assign
     3477           v-object-handle = v-field-group-handle :first-child
     3478         .
     3479         do while valid-handle(v-object-handle)
     3480         :
     3481           if  v-object-handle <> v-diasize-browse-handle :handle
     3482           and v-object-handle <> v-diasize-resize-button
     3483           and can-query(v-object-handle, "row")
     3484           and can-query(v-object-handle, "height")
     3485           and ( v-object-handle :col + v-object-handle :width
     3486                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     3487               )
     3488           then do:
     3489             find first buf_temp-browse-handle
     3490               where buf_temp-browse-handle.browse-type   = 'width':u
     3491                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3492               no-error .
     3493             if available buf_temp-browse-handle
     3494             then do:
     3495             end.
     3496             else do:
     3497               create buf_temp-diasize-handle .
     3498               assign
     3499                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3500                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3501               .
     3502             end.
     3503           end.
     3504           assign
     3505             v-object-handle = v-object-handle :next-sibling
     3506           .
     3507         end.
     3508         assign
     3509           v-field-group-handle = v-field-group-handle :next-sibling
     3510         .
     3511       end.
     3512       do with frame Dialog-Frame
     3513       :
     3514         hide v-diasize-resize-button .
     3515         v-diasize-resize-button :row = 1.
     3516         v-diasize-resize-button :column = 1.
     3517       end.
     3518       if p-change-value > 0
     3519       then do:
     3520         if frame Dialog-Frame :scrollable = true
     3521         then do:
     3522           assign
     3523             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3524             no-error .
     3525           if error-status :error
     3526           or error-status :get-message(1) <> ""
     3527           then do:
     3528             undo move_block, retry move_block.
     3529           end.
     3530         end.
     3531         assign
     3532           frame Dialog-Frame :width = v-frame-width + p-change-value
     3533           no-error .
     3534         if error-status :error
     3535         or error-status :get-message(1) <> ""
     3536         then do:
     3537           undo move_block, retry move_block.
     3538         end.
     3539         assign
     3540           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3541         no-error .
     3542         if error-status :error
     3543         or error-status :get-message(1) <> ""
     3544         then do:
     3545           undo move_block, retry move_block.
     3546         end.
     3547         for each buf_temp-browse-handle
     3548           where buf_temp-browse-handle.browse-type = 'width':u
     3549         on error undo move_block, retry move_block
     3550         :
     3551           assign
     3552             buf_temp-browse-handle.browse-handle :width
     3553               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3554             no-error .
     3555           if error-status :error
     3556           or error-status :get-message(1) <> ""
     3557           then do:
     3558             undo move_block, retry move_block .
     3559           end.
     3560         end.
     3561         for each buf_temp-diasize-handle
     3562         on error undo move_block, retry move_block
     3563         :
     3564           assign
     3565             v-object-handle = buf_temp-diasize-handle.handle-value
     3566           .
     3567           if v-object-handle <> v-diasize-resize-button
     3568           then do:
     3569             assign
     3570               v-object-handle :col = v-object-handle :col + p-change-value
     3571               no-error .
     3572             if error-status :error
     3573             or error-status :get-message(1) <> ""
     3574             then do:
     3575               undo move_block, retry move_block .
     3576             end.
     3577           end.
     3578         end.
     3579       end.
     3580       else do:
     3581         for each buf_temp-diasize-handle
     3582         on error undo move_block, retry move_block
     3583         :
     3584           assign
     3585             v-object-handle = buf_temp-diasize-handle.handle-value
     3586           .
     3587           if v-object-handle <> v-diasize-resize-button
     3588           then do:
     3589             assign
     3590               v-object-handle :col = v-object-handle :col + p-change-value
     3591               no-error .
     3592             if error-status :error
     3593             or error-status :get-message(1) <> ""
     3594             then do:
     3595               undo move_block, retry move_block .
     3596             end.
     3597           end.
     3598         end.
     3599         for each buf_temp-browse-handle
     3600           where buf_temp-browse-handle.browse-type = 'width':u
     3601         on error undo move_block, retry move_block
     3602         :
     3603           assign
     3604             buf_temp-browse-handle.browse-handle :width
     3605               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3606             no-error .
     3607           if error-status :error
     3608           or error-status :get-message(1) <> ""
     3609           then do:
     3610             undo move_block, retry move_block .
     3611           end.
     3612         end.
     3613         assign
     3614           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3615           no-error .
     3616         if error-status :error
     3617         or error-status :get-message(1) <> ""
     3618         then do:
     3619           undo move_block, retry move_block.
     3620         end.
     3621         assign
     3622           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3623         no-error .
     3624         if error-status :error
     3625         or error-status :get-message(1) <> ""
     3626         then do:
     3627           undo move_block, retry move_block.
     3628         end.
     3629         if frame Dialog-Frame :scrollable = true
     3630         then do:
     3631           assign
     3632             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3633           no-error .
     3634           if error-status :error
     3635           or error-status :get-message(1) <> ""
     3636           then do:
     3637             undo move_block, retry move_block.
     3638           end.
     3639         end.
     3640       end.
     3641       if p-move-resize
     3642       then do:
     3643         run diasize_position-resize-button in this-procedure .
     3644       end.
     3645       if v-diasize-wndstore = true
     3646       then do:
     3647         if connected("ub") = true
     3648         then do:
     3649           define variable v-cntxt-db-num        as integer   no-undo .
     3650           define variable v-cntxt-userid        as character no-undo .
     3651           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3652                                             , OUTPUT v-cntxt-userid
     3653                                             ) .
     3654           run gbl/wndsizew.p
     3655             (input  v-cntxt-db-num
     3656             ,input  v-cntxt-userid
     3657             ,input  v-diasize-proc-name
     3658             ,input  'width':u
     3659             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3660             ) .
     3661         end.
     3662       end.
     3663     end.
     3664     assign
     3665       v-diasize-change-size = false
     3666     .
     3667   end procedure.
     3668   procedure diasize_set-width :
     3669     define input  parameter p-new-width  as decimal   no-undo .
     3670     define input  parameter p-move-resize as logical   no-undo .
     3671     do
     3672     on error undo, return error return-value
     3673     :
     3674       run diasize_change-width in this-procedure
     3675         (input  (p-new-width - frame Dialog-Frame :width)
     3676         ,input  p-move-resize
     3677         ) .
     3678     end.
     3679   end procedure.
     3680   procedure diasize_position-resize-button :
     3681     do with frame Dialog-Frame
     3682     :
     3683       hide v-diasize-resize-button .
     3684       assign
     3685         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3686                     - 1
     3687                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3688         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3689                     - 1
     3690                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3691       .
     3692       view v-diasize-resize-button .
     3693     end.
     3694   end procedure.
     3695   on alt-right anywhere
     3696   do:
     3697     run diasize_change-width in this-procedure
     3698       (input 1
     3699       ,input true
     3700       ) .
     3701     return no-apply .
     3702   end.
     3703   on alt-left anywhere
     3704   do:
     3705     run diasize_change-width in this-procedure
     3706       (input -1
     3707       ,input true
     3708       ) .
     3709     return no-apply .
     3710   end.
     3711   on alt-down anywhere
     3712   do:
     3713     run diasize_change-height in this-procedure
     3714       (input 1
     3715       ,input true
     3716       ) .
     3717     return no-apply .
     3718   end.
     3719   on alt-up anywhere
     3720   do:
     3721     run diasize_change-height in this-procedure
     3722       (input -1
     3723       ,input true
     3724       ) .
     3725     return no-apply .
     3726   end.
     3727   on alt-enter of frame Dialog-Frame
     3728   do:
     3729     run diasize_maximize in this-procedure
     3730       (input  ?
     3731       ).
     3732     return no-apply .
     3733   end.
     3734   procedure diasize_end-move :
     3735     do
     3736     on error undo, return error return-value
     3737     :
     3738       define variable v-row-delta as decimal   no-undo .
     3739       define variable v-col-delta as decimal   no-undo .
     3740       define variable v-new-row as decimal   no-undo .
     3741       define variable v-new-col as decimal   no-undo .
     3742       assign
     3743         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3744         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3745       .
     3746       assign
     3747         v-row-delta = v-new-row - frame Dialog-Frame :height
     3748         v-col-delta = v-new-col - frame Dialog-Frame :width
     3749       .
     3750       run diasize_change-height in this-procedure
     3751         (input v-row-delta
     3752         ,input true
     3753         ) .
     3754       run diasize_change-width in this-procedure
     3755         (input v-col-delta
     3756         ,input true
     3757         ) .
     3758     end.
     3759   end procedure.
     3760   procedure diasize_maximize :
     3761     define input  parameter p-action as logical   no-undo .
     3762     do
     3763     on error undo, return error return-value
     3764     :
     3765       if p-action = ?
     3766       then do:
     3767         if v-diasize-need-maximize = true
     3768         then do:
     3769           assign
     3770             p-action = true
     3771           .
     3772         end.
     3773         else do:
     3774           assign
     3775             p-action = false
     3776           .
     3777         end.
     3778       end.
     3779       if p-action = true
     3780       then do:
     3781         run diasize_change-height in this-procedure
     3782           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3783               - frame Dialog-Frame :height-chars
     3784           ,input true
     3785           ) .
     3786         run diasize_change-width in this-procedure
     3787           (input session :width-chars
     3788               - frame Dialog-Frame :width-chars
     3789           ,input true
     3790           ) .
     3791         assign
     3792           v-diasize-need-maximize = false
     3793         .
     3794       end.
     3795       else do:
     3796         run diasize_change-width in this-procedure
     3797           (input v-diasize-orig-frame-width
     3798               - frame Dialog-Frame :width-chars
     3799           ,input true
     3800           ) .
     3801         run diasize_change-height in this-procedure
     3802           (input v-diasize-orig-frame-height
     3803               - frame Dialog-Frame :height-chars
     3804           ,input true
     3805           ) .
     3806         assign
     3807           v-diasize-need-maximize = true
     3808         .
     3809       end.
     3810     end.
     3811   end procedure.
     3812   procedure diasize_restore-orig-size :
     3813     do
     3814     on error undo, return error return-value
     3815     :
     3816       assign
     3817         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3818         v-diasize-current-frame-height = frame Dialog-Frame :height
     3819       .
     3820       run diasize_set-height in this-procedure
     3821         (input  v-diasize-orig-frame-height
     3822         ,input  true
     3823         ) .
     3824       run diasize_set-width in this-procedure
     3825         (input  v-diasize-orig-frame-width
     3826         ,input  true
     3827         ) .
     3828     end.
     3829   end procedure.
     3830   procedure diasize_restore-current-size :
     3831     do
     3832     on error undo, return error return-value
     3833     :
     3834       run diasize_set-height in this-procedure
     3835         (input  v-diasize-current-frame-height
     3836         ,input  true
     3837         ) .
     3838       run diasize_set-width in this-procedure
     3839         (input  v-diasize-current-frame-width
     3840         ,input  true
     3841         ) .
     3842     end.
     3843   end procedure.
     3844   procedure diasize_set-browse-handle :
     3845     define input  parameter p-browse-handle as handle   no-undo .
     3846     define buffer buf_temp-browse-handle for temp-browse-handle .
     3847     do
     3848     on error undo, return error return-value
     3849     :
     3850       assign
     3851         v-diasize-browse-handle = p-browse-handle
     3852       .
     3853       for each buf_temp-browse-handle
     3854       on error undo, return error return-value
     3855       :
     3856         delete buf_temp-browse-handle .
     3857       end.
     3858     end.
     3859   end procedure.
     3860   procedure diasize_add_browse :
     3861     define input  parameter p-browse-type   as character no-undo .
     3862     define input  parameter p-browse-handle as handle    no-undo .
     3863     define buffer buf_temp-browse-handle for temp-browse-handle .
     3864     do
     3865     on error undo, return error return-value
     3866     :
     3867       assign
     3868         v-diasize-browse-number = v-diasize-browse-number + 1
     3869       .
     3870       create buf_temp-browse-handle .
     3871       assign
     3872         buf_temp-browse-handle.browse-type   = p-browse-type
     3873         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3874         buf_temp-browse-handle.browse-handle = p-browse-handle
     3875       .
     3876     end.
     3877   end procedure.
     3878   procedure diasize_init :
     3879     define variable v-default-value    as logical   no-undo .
     3880     define variable v-restore-saved    as logical   no-undo .
     3881     define variable v-resize-value-str as character no-undo .
     3882     do
     3883     on error undo, return error return-value
     3884     :
     3885       do with frame Dialog-Frame
     3886       :
     3887         assign
     3888           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3889           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3890           v-diasize-browse-handle     = browse BROWSE-2 :handle
     3891         .
     3892         create button v-diasize-resize-button
     3893         assign
     3894           parent        = frame Dialog-Frame :first-child
     3895           label         = "s"
     3896           height-pixels = 16
     3897           width-pixels  = 16
     3898           visible       = true
     3899           sensitive     = true
     3900           movable       = true
     3901           triggers:
     3902             on end-move persistent run diasize_end-move in this-procedure .
     3903           end triggers.
     3904         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3905         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3906         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3907         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3908         assign
     3909           v-diasize-wndmax = false
     3910         .
     3911         if connected("ub") = true
     3912         then do:
     3913           define variable v-cntxt-db-num        as integer   no-undo .
     3914           define variable v-cntxt-userid        as character no-undo .
     3915           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3916                                             , OUTPUT v-cntxt-userid
     3917                                             ) .
     3918           run gbl/wndpar_r.p
     3919             (input  v-cntxt-db-num
     3920             ,input  v-cntxt-userid
     3921             ,input  'wndmax':U
     3922             ,output v-diasize-wndmax
     3923             ,output v-default-value
     3924             ) .
     3925         end.
     3926         assign
     3927           v-diasize-wndstore = false
     3928         .
     3929         if connected("ub") = true
     3930         then do:
     3931           run gbl/wndpar_r.p
     3932             (input  v-cntxt-db-num
     3933             ,input  v-cntxt-userid
     3934             ,input  'wndstore':U
     3935             ,output v-diasize-wndstore
     3936             ,output v-default-value
     3937             ) .
     3938         end.
     3939         assign
     3940           v-diasize-proc-name = entry(1, program-name(2), '.')
     3941         .
     3942         if v-diasize-wndstore = true
     3943         then do:
     3944           assign
     3945             v-restore-saved = false
     3946           .
     3947           if connected("ub") = true
     3948           then do:
     3949             run gbl/wndsizer.p
     3950               (input  v-cntxt-db-num
     3951               ,input  v-cntxt-userid
     3952               ,input  v-diasize-proc-name
     3953               ,input  'height':u
     3954               ,output v-resize-value-str
     3955               ) .
     3956             if v-resize-value-str <> '':U
     3957             then do:
     3958               run diasize_change-height in this-procedure
     3959                 (input  integer(v-resize-value-str)
     3960                 ,input  true
     3961                 ) .
     3962               assign
     3963                 v-restore-saved = true
     3964               .
     3965             end.
     3966           end.
     3967           if connected("ub") = true
     3968           then do:
     3969             run gbl/wndsizer.p
     3970               (input  v-cntxt-db-num
     3971               ,input  v-cntxt-userid
     3972               ,input  v-diasize-proc-name
     3973               ,input  'width':u
     3974               ,output v-resize-value-str
     3975               ) .
     3976             if v-resize-value-str <> '':U
     3977             then do:
     3978               run diasize_change-width in this-procedure
     3979                 (input  integer(v-resize-value-str)
     3980                 ,input  true
     3981                 ) .
     3982               assign
     3983                 v-restore-saved = true
     3984               .
     3985             end.
     3986           end.
     3987           if v-restore-saved <> true
     3988           then do:
     3989             if v-diasize-wndmax = true
     3990             then do:
     3991               run diasize_maximize in this-procedure
     3992                 (input  true
     3993                 ) .
     3994             end.
     3995           end.
     3996         end.
     3997         else do:
     3998           if v-diasize-wndmax = true
     3999           then do:
     4000             run diasize_maximize in this-procedure
     4001               (input  true
     4002               ) .
     4003           end.
     4004         end.
     4005       end.
     4006     end.
     4007   end procedure.
     4008   procedure diasize_need-full-display :
     4009     define output parameter p-need-full-display as logical   no-undo .
     4010     do
     4011     on error undo, return error return-value
     4012     :
     4013       assign
     4014         p-need-full-display = v-diasize-need-full-display
     4015       .
     4016       assign
     4017         v-diasize-need-full-display = false
     4018       .
     4019     end.
     4020   end procedure.
     4021   procedure get-context :
     4022      define output parameter p-db-num as integer          no-undo.
     4023      define output parameter p-user-id as character        no-undo.
     4024      define variable v-login               as character    no-undo.
     4025      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4026      define buffer buf_user-login  for ub.user-login .
     4027      do
     4028      on error undo, return error
     4029      :
     4030            FIND FIRST buf_sys-ctrl no-lock.
     4031            ASSIGN
     4032               v-login = USERID("ub")
     4033               p-db-num = buf_sys-ctrl.db-num
     4034            .
     4035            FIND FIRST buf_user-login
     4036                 WHERE buf_user-login.db-num = p-db-num
     4037                   AND buf_user-login.user-login = v-login
     4038                 no-lock
     4039                 no-error
     4040                 .
     4041            IF AVAILABLE buf_user-login
     4042            THEN DO:
     4043               assign
     4044                  p-user-id = buf_user-login.user-id
     4045               .
     4046            END.
     4047      end.
     4048   end procedure.
     4049     run diasize_init in this-procedure .
     4050     RUN enable_UI.
     4051     WAIT-FOR GO OF FRAME Dialog-Frame.
     4052   END.
     4053   RUN disable_UI.
     4054   PROCEDURE disable_UI :
     4055     HIDE FRAME Dialog-Frame.
     4056   END PROCEDURE.
     4057   PROCEDURE enable_UI :
     4058     ENABLE Btn_OK BROWSE-2 b-print
     4059         WITH FRAME Dialog-Frame.
     4060     VIEW FRAME Dialog-Frame.
     4061     OPEN QUERY BROWSE-2 FOR EACH tt-utd-err NO-LOCK INDEXED-REPOSITION.
     4062   END PROCEDURE.
     4063   PROCEDURE init-temp :
     4064   define buffer buf_marking for ub.marking .
     4065   define buffer buf_utd-marking-lines for ub.utd-marking-lines .
     4066   define variable ii as integer no-undo .
     4067   define variable status_ as character no-undo .
     4068   define variable vline as integer no-undo.
     4069   define variable vHn as handle no-undo.
     4070   define VARIABLE vRecKey-markLine as character no-undo .
     4071   ii = 0 .
     4072   if p-line-num <> 0 then do:
     4073       vRecKey-markLine = replace(p-reckey,"utd-lines","utd-marking-lines") + chr(3).
     4074     for each buf_utd-err no-lock where buf_utd-err.db-num = p-db-num
     4075                                    and buf_utd-err.doc-id = p-doc-id
     4076                                    and (buf_utd-err.reckey = p-reckey or buf_utd-err.reckey begins vRecKey-markLine):
     4077       create tt-utd-err .
     4078       buffer-copy buf_utd-err to tt-utd-err .
     4079       assign
     4080       tt-utd-err.descr = GetTextError(tt-utd-err.CheckType,tt-utd-err.CodeErr,tt-utd-err.CheckObj)
     4081       .
     4082       if buf_utd-err.reckey begins "utd-lines" or buf_utd-err.reckey begins "utd-marking-lines"
     4083       or buf_utd-err.reckey begins "marking" then do:
     4084         run gen-hn-keyr(input buf_utd-err.reckey,input ?,input "ub" , input ? ,input no-lock , output vHn).
     4085         if vHn:available
     4086         then do:
     4087         if buf_utd-err.reckey begins "marking" then do:
     4088             tt-utd-err.gds-code = vHn::gds-code .
     4089             tt-utd-err.LineNum  = 0 .
     4090         end.
     4091         else do:
     4092             tt-utd-err.LineNum = vHn::lineNum .
     4093             tt-utd-err.gds-code = vHn::gds-code .
     4094         end.
     4095         delete object vHn no-error.
     4096       end.
     4097       end.
     4098     end.
     4099   end.
     4100   else do:
     4101     for each buf_utd-err no-lock where buf_utd-err.db-num = p-db-num and buf_utd-err.doc-id = p-doc-id and buf_utd-err.reckey begins p-reckey:
     4102       create tt-utd-err .
     4103       buffer-copy buf_utd-err to tt-utd-err .
     4104       assign
     4105       tt-utd-err.descr = GetTextError(tt-utd-err.CheckType,tt-utd-err.CodeErr,tt-utd-err.CheckObj)
     4106       .
     4107       if buf_utd-err.reckey begins "utd-lines" or buf_utd-err.reckey begins "utd-marking-lines"
     4108       or buf_utd-err.reckey begins "marking" then do:
     4109         run gen-hn-keyr(input buf_utd-err.reckey,input ?,input "ub" , input ? ,input no-lock , output vHn).
     4110         if vHn:available
     4111         then do:
     4112         if buf_utd-err.reckey begins "marking" then do:
     4113             tt-utd-err.gds-code = vHn::gds-code .
     4114             tt-utd-err.LineNum  = 0 .
     4115         end.
     4116         else do:
     4117             tt-utd-err.LineNum = vHn::lineNum .
     4118             tt-utd-err.gds-code = vHn::gds-code .
     4119         end.
     4120         delete object vHn no-error.
     4121       end.
     4122       end.
     4123     end.
     4124    end.
     4125     if p-line-num <> 0 then
     4126     do:
     4127       for each buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num = p-db-num and
     4128         buf_utd-marking-lines.doc-id = p-doc-id and
     4129         buf_utd-marking-lines.LineNum = p-line-num and
     4130         buf_utd-marking-lines.doc-level = 1,
     4131         first buf_marking no-lock where buf_marking.mark = buf_utd-marking-lines.mark and
     4132         buf_marking.sts =  Marking:NotAvailable:KeyIntDB :
     4133         create tt-utd-err .
     4134         ii = ii + 1 .
     4135         assign
     4136           tt-utd-err.CheckType = "UCDСompar"
     4137           tt-utd-err.CheckObj  = "По товару " + string(buf_utd-marking-lines.gds-code) + " по линии " + string(buf_utd-marking-lines.LineNum)
     4138           tt-utd-err.CodeErr   = "MARKDECLINED"
     4139           tt-utd-err.db-num    = buf_utd-marking-lines.db-num
     4140           tt-utd-err.doc-id    = buf_utd-marking-lines.doc-id
     4141           tt-utd-err.reckey    = string(ii)
     4142           tt-utd-err.LineNum   = buf_utd-marking-lines.LineNum
     4143           tt-utd-err.gds-code  = buf_utd-marking-lines.gds-code
     4144           .
     4145         status_ = StatusTHName(buf_marking.sts) .
     4146         tt-utd-err.descr = "Ошибка № 15. В результате проверки товаров на АЗК по строке " + string(buf_utd-marking-lines.LineNum) +  " марка " + buf_utd-marking-lines.mark + " не была принята."
     4147           .
     4148       end.
     4149     end.
     4150     else
     4151     do:
     4152       for each buf_utd-marking-lines no-lock where buf_utd-marking-lines.db-num = p-db-num and
     4153         buf_utd-marking-lines.doc-id = p-doc-id and buf_utd-marking-lines.doc-level = 1,
     4154         first buf_marking no-lock where buf_marking.mark = buf_utd-marking-lines.mark and
     4155         buf_marking.sts =  Marking:NotAvailable:KeyIntDB :
     4156         create tt-utd-err .
     4157         ii = ii + 1 .
     4158         assign
     4159           tt-utd-err.CheckType = "UCDСompar"
     4160           tt-utd-err.CheckObj  = "По товару " + string(buf_utd-marking-lines.gds-code) + " по линии " + string(buf_utd-marking-lines.LineNum)
     4161           tt-utd-err.CodeErr   = "MARKDECLINED"
     4162           tt-utd-err.db-num    = buf_utd-marking-lines.db-num
     4163           tt-utd-err.doc-id    = buf_utd-marking-lines.doc-id
     4164           tt-utd-err.reckey    = string(ii)
     4165           tt-utd-err.LineNum   = buf_utd-marking-lines.LineNum
     4166           tt-utd-err.gds-code  = buf_utd-marking-lines.gds-code
     4167           .
     4168         status_ = StatusTHName(buf_marking.sts) .
     4169         tt-utd-err.descr = "Ошибка № 15. В результате проверки товаров на АЗК по строке " + string(buf_utd-marking-lines.LineNum) +  " марка " + buf_utd-marking-lines.mark + " не была принята."
     4170           .
     4171       end.
     4172     end.
     4173   END PROCEDURE.
