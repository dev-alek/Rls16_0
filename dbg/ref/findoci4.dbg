     4439         or tt-fin-doc.curr-code <> v-base-code
     4440         or tt-fin-doc.curr-code <> tt-fin-doc.contract-curr
     4441         then
     4442       do:
     4443         if tt-fin-doc.curr-code <> 0 then
     4444           display
     4445             tt-fin-doc.exch-rate
     4446             tt-fin-doc.exch-scale
     4447             with frame Dialog-Frame.
     4448         assign
     4449           p-main-widget = "sum-doc":U.
     4450       end.
     4451     end.
     4452     if p-main-widget  = "doc-date":U then
     4453     do:
     4454       assign
     4455         frame Dialog-Frame
     4456         tt-fin-doc.sum-doc
     4457         .
     4458   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4459   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     4460     (input  tt-fin-doc.host-code
     4461     ,input  tt-fin-doc.doc-date
     4462     ,output tt-fin-doc.base-rate
     4463     ,output tt-fin-doc.base-scale
     4464     )  .
     4465   define variable vss-include-info52 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4466   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     4467     (input  tt-fin-doc.curr-code
     4468     ,input  tt-fin-doc.doc-date
     4469     ,output tt-fin-doc.exch-rate
     4470     ,output tt-fin-doc.exch-scale
     4471     ,output v-curr-abbr
     4472     )  .
     4473   define variable vss-include-info53 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4474   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     4475     (input  tt-fin-doc.contract-curr
     4476     ,input  tt-fin-doc.doc-date
     4477     ,output tt-fin-doc.contract-rate
     4478     ,output tt-fin-doc.contract-scale
     4479     ,output v-curr-abbr
     4480     )  .
     4481       if tt-fin-doc.base-rate:visible in frame Dialog-Frame then
     4482       do:
     4483         display
     4484           tt-fin-doc.base-rate
     4485           tt-fin-doc.base-scale
     4486           with frame Dialog-Frame.
     4487         assign
     4488           p-main-widget = "sum-doc":U.
     4489       end.
     4490       if tt-fin-doc.exch-rate:visible in frame Dialog-Frame then
     4491       do:
     4492         display
     4493           tt-fin-doc.exch-rate
     4494           tt-fin-doc.exch-scale
     4495           with frame Dialog-Frame.
     4496         assign
     4497           p-main-widget = "sum-doc":U.
     4498       end.
     4499       if tt-fin-doc.contract-rate:visible in frame Dialog-Frame then
     4500       do:
     4501         display
     4502           tt-fin-doc.contract-rate
     4503           tt-fin-doc.contract-scale
     4504           with frame Dialog-Frame.
     4505         assign
     4506           p-main-widget = "sum-doc":U.
     4507       end.
     4508     end.
     4509     CASE p-main-widget:
     4510       when "sum-doc" then
     4511         do:
     4512           assign
     4513             frame Dialog-Frame
     4514             tt-fin-doc.exch-rate
     4515             tt-fin-doc.exch-scale
     4516             tt-fin-doc.sum-doc
     4517             .
     4518           CASE tt-fin-doc.curr-code:
     4519             when 0 then
     4520               do:
     4521                 assign
     4522                   tt-fin-doc.sum-rubl = tt-fin-doc.sum-doc
     4523                   tt-fin-doc.sum-base = tt-fin-doc.sum-doc / tt-fin-doc.base-rate * tt-fin-doc.base-scale
     4524                   tt-fin-doc.sum-contr = (if tt-fin-doc.contract-curr = 0                                                       then tt-fin-doc.sum-rubl                                                       else tt-fin-doc.sum-rubl / (tt-fin-doc.contract-rate / tt-fin-doc.contract-scale)                                                     )
     4525                   .
     4526               end.
     4527             when v-base-code then
     4528               do:
     4529                 assign
     4530                   tt-fin-doc.sum-rubl = tt-fin-doc.sum-doc * tt-fin-doc.exch-rate / tt-fin-doc.exch-scale
     4531                   tt-fin-doc.sum-base = tt-fin-doc.sum-rubl / tt-fin-doc.base-rate * tt-fin-doc.base-scale
     4532                   tt-fin-doc.sum-contr = (if tt-fin-doc.contract-curr = 0                                                       then tt-fin-doc.sum-rubl                                                       else tt-fin-doc.sum-rubl / (tt-fin-doc.contract-rate / tt-fin-doc.contract-scale)                                                     )
     4533                   .
     4534               end.
     4535             otherwise
     4536             do:
     4537               assign
     4538                 tt-fin-doc.sum-rubl = tt-fin-doc.sum-doc * tt-fin-doc.exch-rate / tt-fin-doc.exch-scale
     4539                 tt-fin-doc.sum-base = tt-fin-doc.sum-rubl / tt-fin-doc.base-rate * tt-fin-doc.base-scale
     4540                 tt-fin-doc.sum-contr = (if tt-fin-doc.contract-curr = 0                                                       then tt-fin-doc.sum-rubl                                                       else tt-fin-doc.sum-rubl / (tt-fin-doc.contract-rate / tt-fin-doc.contract-scale)                                                     )
     4541                 .
     4542             end.
     4543           END CASE.
     4544         end.
     4545     END CASE.
     4546     assign
     4547       f-rest-con-sum = tt-fin-doc.sum-contr - tt-fin-doc.con-sum-contr
     4548       .
     4549     display
     4550       f-rest-con-sum
     4551       with frame Dialog-Frame.
     4552     if tt-fin-doc.sum-doc:visible in frame Dialog-Frame then
     4553       display
     4554         tt-fin-doc.sum-doc
     4555         tt-fin-doc.curr-code
     4556         with frame Dialog-Frame.
     4557     if tt-fin-doc.sum-rubl:visible in frame Dialog-Frame then
     4558       display
     4559         tt-fin-doc.sum-rubl
     4560         tt-fin-doc.exch-rate
     4561         tt-fin-doc.exch-scale
     4562         with frame Dialog-Frame.
     4563     if tt-fin-doc.sum-base:visible in frame Dialog-Frame then
     4564       display
     4565         tt-fin-doc.sum-base
     4566         tt-fin-doc.base-rate
     4567         tt-fin-doc.base-scale
     4568         with frame Dialog-Frame.
     4569     if tt-fin-doc.sum-contr:visible in frame Dialog-Frame then
     4570       display
     4571         tt-fin-doc.sum-contr
     4572         tt-fin-doc.contract-rate
     4573         tt-fin-doc.contract-scale
     4574         with frame Dialog-Frame.
     4575     if not v-first-start then
     4576       run proc-update-sum-vat-chr in this-procedure (input-output v-start).
     4577   END PROCEDURE.
     4578   procedure proc-create-default-tax :
     4579     do
     4580       on error undo, return error
     4581       :
     4582       If p-mode = 'ДОБАВЛЕНИЕ':U then
     4583       do:
     4584         if p-ob-doc-code = "" then
     4585         do:
     4586           find tt0-fin-doc-tax where
     4587             tt0-fin-doc-tax.fin-doc-code = tt-fin-doc.fin-doc-code
     4588             AND tt0-fin-doc-tax.host-code = tt-fin-doc.host-code no-error .
     4589           if not avail tt0-fin-doc-tax
     4590             and not AMBIGUOUS tt0-fin-doc-tax
     4591             then
     4592           do:
     4593             create tt0-fin-doc-tax.
     4594           end.
     4595           if AMBIGUOUS tt0-fin-doc-tax then return.
     4596           assign
     4597             tt0-fin-doc-tax.fin-doc-code     = tt-fin-doc.fin-doc-code
     4598             tt0-fin-doc-tax.host-code        = tt-fin-doc.host-code
     4599             tt0-fin-doc-tax.line-num         = 1
     4600             tt0-fin-doc-tax.slt-pc           = 0
     4601             tt0-fin-doc-tax.sum-line-doc     = tt-fin-doc.sum-doc
     4602             tt0-fin-doc-tax.sum-slt-line-doc = 0
     4603             tt0-fin-doc-tax.with-slt         = no
     4604             .
     4605           case paramVne:
     4606             when "vne" then do:
     4607             assign
     4608               tt0-fin-doc-tax.sum-vat-line-doc = 0
     4609               tt0-fin-doc-tax.vat-pc           = -1
     4610               tt0-fin-doc-tax.with-vat         = no
     4611               .
     4612             end.
     4613             when "avans" then do:
     4614             assign
     4615               tt0-fin-doc-tax.vat-pc           = 22
     4616               tt0-fin-doc-tax.sum-vat-line-doc = (tt-fin-doc.sum-doc * tt0-fin-doc-tax.vat-pc)/(100 + tt0-fin-doc-tax.vat-pc)
     4617               tt0-fin-doc-tax.with-vat         = yes
     4618               .
     4619             end.
     4620             otherwise do:
     4621             assign
     4622               tt0-fin-doc-tax.sum-vat-line-doc = 0
     4623               tt0-fin-doc-tax.vat-pc           = 0
     4624               tt0-fin-doc-tax.with-vat         = no
     4625               .
     4626             end.
     4627           end case .
     4628           release tt0-fin-doc-tax.
     4629         end.
     4630       end.
     4631     end.
     4632   end procedure.
     4633   procedure proc-update-sum-vat-chr :
     4634     define input-output parameter p-start as integer no-undo .
     4635     define variable v-sum-vat      like ub.fin-doc-tax.sum-vat-line-doc no-undo .
     4636     define variable v-sum-vat-chr  as character no-undo .
     4637     define variable v-each-vat-chr as character no-undo.
     4638     define variable v-vat-pc       as integer no-undo .
     4639     do
     4640       on error undo, return error
     4641       :
     4642       for each tt0-fin-doc-tax no-lock where
     4643         tt0-fin-doc-tax.fin-doc-code = tt-fin-doc.fin-doc-code
     4644         AND tt0-fin-doc-tax.host-code = tt-fin-doc.host-code:
     4645         do:
     4646           if tt0-fin-doc-tax.with-vat then
     4647           do:
     4648             v-vat-pc = tt0-fin-doc-tax.vat-pc .
     4649             if paramVne <> "avans" then
     4650             do:
     4651               v-each-vat-chr = v-each-vat-chr +
     4652                 substitute (" &1% = &2;"
     4653                 , string(tt0-fin-doc-tax.vat-pc)
     4654                 , string(truncate(tt0-fin-doc-tax.sum-vat-line-doc, 0)) + chr(32) +  "руб." + chr(32) +
     4655                 (if tt0-fin-doc-tax.sum-vat-line-doc <> truncate(tt0-fin-doc-tax.sum-vat-line-doc, 0)
     4656                 then (string(100 * round(tt0-fin-doc-tax.sum-vat-line-doc - truncate(tt0-fin-doc-tax.sum-vat-line-doc, 0), 2))  + chr(32) + "коп.")
     4657                 else "":U)).
     4658             end.
     4659             else
     4660             do:
     4661               v-each-vat-chr = v-each-vat-chr +
     4662                 substitute (" = &1;"
     4663                 , string(truncate(tt0-fin-doc-tax.sum-vat-line-doc, 0)) + chr(32) +  "руб." + chr(32) +
     4664                 (if tt0-fin-doc-tax.sum-vat-line-doc <> truncate(tt0-fin-doc-tax.sum-vat-line-doc, 0)
     4665                 then (string(100 * round(tt0-fin-doc-tax.sum-vat-line-doc - truncate(tt0-fin-doc-tax.sum-vat-line-doc, 0), 2))  + chr(32) + "коп.")
     4666                 else "":U)).
     4667             end.
     4668           end.
     4669           v-sum-vat = v-sum-vat +
     4670             (if tt0-fin-doc-tax.with-vat then tt0-fin-doc-tax.sum-vat-line-doc else 0).
     4671         end.
     4672       end.
     4673       if tt-fin-doc.curr-code = 0 then
     4674       do:
     4675         case paramVne :
     4676         when "vne" then do:
     4677         if v-vat-pc > 0 then do:
     4678           v-sum-vat-chr = "в том числе НДС" + right-trim (v-each-vat-chr , ";").
     4679         end .
     4680         else
     4681         assign
     4682           v-sum-vat-chr = "в т.ч. без налога (НДС)"
     4683           .
     4684         end.
     4685         when "avans" then do:
     4686           if v-vat-pc <> 0 then v-sum-vat-chr = "в т.ч. " + string(v-vat-pc) + "/" + string(100 + v-vat-pc) + " (НДС)" + right-trim (v-each-vat-chr , ";").
     4687           else v-sum-vat-chr = "в т.ч. 22/122 (НДС)" + right-trim (v-each-vat-chr , ";").
     4688         end.
     4689         otherwise do:
     4690           v-sum-vat-chr = "в том числе НДС" + right-trim (v-each-vat-chr , ";").
     4691         end.
     4692       end case .
     4693       end.
     4694       else
     4695       do:
     4696         assign
     4697           v-sum-vat-chr = "в том числе НДС" + chr(32) +
     4698                         string(v-sum-vat)
     4699           .
     4700       end.
     4701       if p-start  = 0 then
     4702         assign
     4703           frame Dialog-Frame
     4704           tt-fin-doc.naznach-plat
     4705           .
     4706       if p-start = 1 then p-start = 0.
     4707       if num-entries(tt-fin-doc.naznach-plat, "@":U) < 2 and p-start = 2 then
     4708       do:
     4709         assign
     4710           tt-fin-doc.naznach-plat = tt-fin-doc.naznach-plat + "@" +
     4711                                     (if tt-fin-doc.naznach-plat = "":U
     4712                                     then "":U
     4713                                     else (chr(44) + chr(32) )
     4714                                     ) +
     4715                                     v-sum-vat-chr.
     4716       end.
     4717       if num-entries(tt-fin-doc.naznach-plat, "@":U) > 1 then
     4718       do:
     4719         assign
     4720           entry(2, tt-fin-doc.naznach-plat, "@":U) = chr(44) + chr(32)  + v-sum-vat-chr.
     4721       end.
     4722       display
     4723         tt-fin-doc.naznach-plat
     4724         with frame Dialog-Frame .
     4725       if p-start = 2 then p-start = 0.
     4726     end.
     4727   end procedure.
     4728   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4729   on help of frame Dialog-Frame
     4730   do:
     4731     run gbl/app_help.p
     4732       (input this-procedure :file-name
