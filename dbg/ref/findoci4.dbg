     4132   PROCEDURE check-sums-rate :
     4133     define variable v-exch-rate  like ub.fin-doc.sum-doc no-undo .
     4134     define variable v-exch-scale like ub.fin-doc.sum-doc no-undo .
     4135   END PROCEDURE.
     4136   PROCEDURE disable-enable :
     4137     define input parameter p-main-widget as character no-undo.
     4138     define input parameter p-main-curr as character no-undo .
     4139     disable
     4140       tt-fin-doc.sum-doc
     4141       tt-fin-doc.sum-rubl
     4142       tt-fin-doc.sum-base
     4143       tt-fin-doc.base-rate
     4144       tt-fin-doc.base-scale
     4145       tt-fin-doc.exch-rate
     4146       tt-fin-doc.exch-scale
     4147       tt-fin-doc.sum-contr
     4148       tt-fin-doc.contract-rate
     4149       tt-fin-doc.contract-scale
     4150       with frame Dialog-Frame .
     4151     assign
     4152       v-main-sum  = if p-main-widget <> "":U then p-main-widget else v-main-sum
     4153       v-main-curr = if p-main-curr <> "":U then p-main-curr else v-main-curr
     4154       .
     4155     if v-limit-access > 0 then
     4156     do:
     4157       display
     4158         tt-fin-doc.sum-rubl
     4159         when v-rubf
     4160         tt-fin-doc.sum-base
     4161         when v-basef
     4162         tt-fin-doc.exch-rate
     4163         when v-exchf
     4164         tt-fin-doc.exch-scale
     4165         when v-exchf
     4166         tt-fin-doc.base-rate
     4167         when v-basef
     4168         tt-fin-doc.base-scale
     4169         when v-basef
     4170         tt-fin-doc.sum-contr
     4171         when v-contractf
     4172         tt-fin-doc.contract-rate
     4173         when v-contractratef
     4174         tt-fin-doc.contract-scale
     4175         when v-contractratef
     4176         with frame Dialog-Frame.
     4177       return.
     4178     end.
     4179     CASE p-main-widget:
     4180       when "sum-doc" then
     4181         do:
     4182           enable
     4183             tt-fin-doc.sum-doc
     4184             with frame Dialog-Frame.
     4185           APPLY "ENTRY" to tt-fin-doc.sum-doc.
     4186         end.
     4187     END CASE.
     4188     display
     4189       tt-fin-doc.sum-rubl
     4190       when v-rubf
     4191       tt-fin-doc.sum-base
     4192       when v-basef
     4193       tt-fin-doc.exch-rate
     4194       when v-exchf
     4195       tt-fin-doc.exch-scale
     4196       when v-exchf
     4197       tt-fin-doc.base-rate
     4198       when v-basef
     4199       tt-fin-doc.base-scale
     4200       when v-basef
     4201       tt-fin-doc.sum-contr
     4202       when v-contractf
     4203       tt-fin-doc.contract-rate
     4204       when v-contractratef
     4205       tt-fin-doc.contract-scale
     4206       when v-contractratef
     4207       with frame Dialog-Frame.
     4208     CASE rs-view:
     4209       when "full":u then
     4210         do:
     4211           assign
     4212             v-tab-order = "b-exit,b-quit,b-tax,b-print,b-hist,b-help," +                             "prn-doc-code,vid-plat,doc-date,obj-type,obj-code,b-obj," +                             v-an-uchet-tab-order +  "b-payer-schet,b-payer-view," + v-sum-curr-tab-order +                             "receiver-type,receiver-code,b-receiver,receiver-name,b-receiver-schet,b-receiver-view," +                              "naznach-plat,PS,payer-sign1,payer-sign2"
     4213             .
     4214         end.
     4215       when "brief":u then
     4216         do:
     4217           assign
     4218             v-tab-order = "b-exit,b-quit,b-tax,b-print,b-hist,b-help," +                              "prn-doc-code,vid-plat,doc-date," +                             "obj-type,obj-code,b-obj,b-payer-schet,b-payer-view," + v-sum-curr-tab-order +                             "receiver-type,receiver-code,b-receiver,receiver-name,b-receiver-schet,b-receiver-view," +                              "naznach-plat,PS,payer-sign1,payer-sign2"
     4219             .
     4220         end.
     4221       when "contract":u then
     4222         do:
     4223           assign
     4224             v-tab-order = "b-exit,b-quit,b-tax,b-print,b-hist,b-help," +                             "prn-doc-code,vid-plat,doc-date,obj-type,obj-code,b-obj," +                              v-contract-tab-order +  "b-payer-schet,b-payer-view," + v-sum-curr-tab-order +                             "receiver-type,receiver-code,b-receiver,receiver-name,b-receiver-schet,b-receiver-view," +                              "naznach-plat,PS,payer-sign1,payer-sign2"
     4225             .
     4226         end.
     4227     END CASE.
     4228   END PROCEDURE.
     4229   define new global shared variable g#lib-farh as handle no-undo .
     4230   PROCEDURE fill-tables :
     4231     define buffer buf_fin-doc-tax  for ub.fin-doc-tax.
     4232     define buffer buf_fin-doc-attr for ub.fin-doc-attr.
     4233     define buffer buf_fin-ob-tax   for ub.fin-ob-tax.
     4234     define buffer buf_fin-connect  for ub.fin-connect.
     4235     define buffer buf_fin-ob       for ub.fin-ob.
     4236     define buffer buf_payment      for ub.payment.
     4237     if p-mode = 'ДОБАВЛЕНИЕ':U
     4238       AND p-ob-doc-code <> "" then
     4239     do:
     4240       for each buf_fin-ob-tax no-lock where
     4241         buf_fin-ob-tax.host-code = tt-fin-doc.fin-doc-code
     4242         AND buf_fin-ob-tax.doc-code = p-ob-doc-code:
     4243         create tt0-fin-doc-tax.
     4244         buffer-copy buf_fin-ob-tax to tt0-fin-doc-tax.
     4245       end.
     4246       return.
     4247     end.
     4248     if p-mode = 'ДОБАВЛЕНИЕ':U
     4249       and v-copy-mode = yes then
     4250     do:
     4251       for each buf_fin-doc-tax no-lock where
     4252         buf_fin-doc-tax.host-code = locked_fin-doc.host-code
     4253         AND buf_fin-doc-tax.fin-doc-code = locked_fin-doc.fin-doc-code
     4254         :
     4255         create tt0-fin-doc-tax.
     4256         buffer-copy buf_fin-doc-tax except fin-doc-code to tt0-fin-doc-tax
     4257           assign
     4258           tt0-fin-doc-tax.fin-doc-code = tt-fin-doc.fin-doc-code
     4259           .
     4260       end.
     4261       for each buf_payment no-lock where
     4262         buf_payment.source-type = 'платеж':U
     4263         AND buf_payment.source-ref = string(locked_fin-doc.fin-doc-code)
     4264         :
     4265         create tt0-payment.
     4266         buffer-copy buf_payment except source-ref to tt0-payment
     4267           assign
     4268           tt0-payment.source-ref = string(tt-fin-doc.fin-doc-code)
     4269           .
     4270       end.
     4271       for each buf_fin-doc-attr no-lock where
     4272         buf_fin-doc-attr.host-code = locked_fin-doc.host-code
     4273         AND buf_fin-doc-attr.fin-doc-code = locked_fin-doc.fin-doc-code
     4274         :
     4275         create tt0-fin-doc-attr.
     4276         buffer-copy buf_fin-doc-attr to tt0-fin-doc-attr
     4277           assign
     4278           tt0-fin-doc-attr.fin-doc-code = tt-fin-doc.fin-doc-code
     4279           .
     4280       end.
     4281     end.
     4282     else
     4283     do:
     4284       for each buf_fin-doc-tax no-lock where
     4285         buf_fin-doc-tax.host-code = tt-fin-doc.host-code
     4286         AND buf_fin-doc-tax.fin-doc-code = tt-fin-doc.fin-doc-code
     4287         :
     4288         create tt0-fin-doc-tax.
     4289         buffer-copy buf_fin-doc-tax to tt0-fin-doc-tax.
     4290       end.
     4291       for each buf_payment no-lock where
     4292         buf_payment.source-type = 'платеж':U
     4293         AND buf_payment.source-ref = string(tt-fin-doc.fin-doc-code)
     4294         :
     4295         create tt0-payment.
     4296         buffer-copy buf_payment to tt0-payment.
     4297       end.
     4298       for each buf_fin-doc-attr no-lock where
     4299         buf_fin-doc-attr.host-code = tt-fin-doc.host-code
     4300         AND buf_fin-doc-attr.fin-doc-code = tt-fin-doc.fin-doc-code
     4301         :
     4302         create tt0-fin-doc-attr.
     4303         buffer-copy buf_fin-doc-attr to tt0-fin-doc-attr.
     4304       end.
     4305       for each tt0-fin-doc-attr no-lock where
     4306         tt0-fin-doc-attr.host-code = tt-fin-doc.host-code
     4307         AND tt0-fin-doc-attr.fin-doc-code = tt-fin-doc.fin-doc-code
     4308         :
     4309       end.
     4310     end.
     4311   if (valid-handle(g#lib-farh) <> true) then do:   run str/lib-farh.p persistent no-error .   if error-status :error or (valid-handle(g#lib-farh) <> true) then do:     message       "Error starting lib-farh.p" skip       g#lib-farh skip       g#lib-farh :type skip       g#lib-farh :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-farh_fautoobj in g#lib-farh
     4312   (input tt-fin-doc.host-code
     4313   ,input tt-fin-doc.fin-doc-code
     4314   ,output v-is-auto-obj
     4315   )
     4316   .
     4317     if getCliKassa(tt-fin-doc.receiver-type, tt-fin-doc.receiver-code, "Vnecli", tt-fin-doc.cashbookId) then paramVne = "vne" .
     4318     else if getCliKassa(tt-fin-doc.receiver-type, tt-fin-doc.receiver-code, "Avanscli", tt-fin-doc.cashbookId) then paramVne = "avans" .
     4319     else paramVne = "" .
     4320     run proc-update-sum-vat-chr in this-procedure (input-output v-start).
     4321   END PROCEDURE.
     4322   PROCEDURE hide-view-currency :
     4323     define buffer buf_currency for ub.currency.
     4324     assign
     4325       v-rubf          = no
     4326       v-exchf         = no
     4327       v-basef         = no
     4328       v-baseratef     = no
     4329       v-contractf     = no
     4330       v-contractratef = no
     4331       .
     4332     hide
     4333       tt-fin-doc.sum-rubl in frame Dialog-Frame
     4334       tt-fin-doc.exch-rate
     4335       tt-fin-doc.exch-scale
     4336       tt-fin-doc.sum-base
     4337       tt-fin-doc.base-rate
     4338       tt-fin-doc.base-scale
     4339       tt-fin-doc.sum-contr
     4340       tt-fin-doc.contract-rate
     4341       tt-fin-doc.contract-scale
     4342       in frame Dialog-Frame .
     4343     if tt-fin-doc.curr-code <> 0 then
     4344     do:
     4345       if tt-fin-doc.curr-code:visible then
     4346         display
     4347           tt-fin-doc.exch-rate
     4348           tt-fin-doc.exch-scale
     4349           tt-fin-doc.sum-rubl
     4350           with frame Dialog-Frame.
     4351       assign
     4352         v-rubf  = yes
     4353         v-exchf = yes
     4354         .
     4355     end.
     4356     if v-base-code <> tt-fin-doc.curr-code
     4357       and v-base-code <> 0
     4358       then
     4359     do:
     4360       find first buf_currency no-lock where
     4361         buf_currency.curr-code = v-base-code .
     4362       assign
     4363         tt-fin-doc.sum-base:label = "Б.в.("  + buf_currency.curr-abbr + ")":U
     4364         .
     4365       if tt-fin-doc.curr-code:visible then
     4366         display
     4367           tt-fin-doc.base-rate
     4368           tt-fin-doc.base-scale
     4369           tt-fin-doc.sum-base
     4370           with frame Dialog-Frame.
     4371       assign
     4372         v-basef     = yes
     4373         v-baseratef = yes
     4374         .
     4375     end.
     4376     if tt-fin-doc.contract-code  <> 0 and
     4377       (tt-fin-doc.contract-curr <> 0
     4378       and tt-fin-doc.contract-curr <> tt-fin-doc.curr-code
     4379       and tt-fin-doc.contract-curr <> v-base-code
     4380       )
     4381       then
     4382     do:
     4383       find first buf_currency no-lock where
     4384         buf_currency.curr-code = tt-fin-doc.contract-curr .
     4385       assign
     4386         tt-fin-doc.sum-contr:label = "Вал.дог.("  + buf_currency.curr-abbr + ")":U
     4387         .
     4388       if tt-fin-doc.curr-code:visible then
     4389         display
     4390           tt-fin-doc.sum-contr
     4391           tt-fin-doc.contract-rate
     4392           tt-fin-doc.contract-scale
     4393           with frame Dialog-Frame.
     4394       assign
     4395         v-contractf     = yes
     4396         v-contractratef = yes
     4397         .
     4398     end.
     4399     assign
     4400       v-sum-curr-tab-order = v-sum-doc-tab-order
     4401       .
     4402     run disable-enable in this-procedure (v-main-sum, v-main-curr).
     4403   END PROCEDURE.
