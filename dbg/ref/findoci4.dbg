      148   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      149   define variable v-waitfram-action01         as character   no-undo .
      150   define variable v-waitfram-action02         as character   no-undo .
      151   define variable v-waitfram-action03         as character   no-undo .
      152   define variable mWaitFramTextBeg            as character   no-undo.
      153   define variable mWaitFramTextEnd            as character   no-undo.
      154   define variable mWaitFramView               as logical     no-undo.
      155   define variable mWaitProcEvent              as logical     no-undo init yes.
      156   define variable mWaitFramInterval           as integer     no-undo init 1 .
      157   define variable mWaitFramStop               as logical     no-undo.
      158   define variable mWaitFramStopUser           as logical     no-undo.
      159   define variable mWaitFramStopTimeOut        as logical     no-undo.
      160   define variable mWaitFramStartProc          as datetime-tz no-undo.
      161   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      162   define button B-WaitFramStop auto-end-key
      163        label "Стоп"
      164        size 10 by 1 tooltip "Остоновить процесс".
      165   define button B-viewProcInfo
      166        label "Информация"
      167        size 15 by 1 tooltip "Информация о процесс".
      168   define frame waitfram
      169     v-waitfram-action01 format "x(72)" no-label skip
      170     v-waitfram-action02 format "x(72)" no-label skip
      171     v-waitfram-action03 format "x(72)" no-label skip
      172     B-viewProcInfo
      173     B-WaitFramStop at row 4 col 30
      174     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      175     .
      176   define new global shared variable mBatchMode as logical no-undo init ?.
      177   define variable mFramBachModHandle as handle no-undo.
      178   mFramBachModHandle = frame waitfram:handle.
      179   define variable mFameOldVis as logical no-undo.
      180   define variable mVisCUrentVin as logical no-undo.
      181   if session:batch-mode
      182   then
      183      mBatchMode = yes.
      184   if mBatchMode = ? then do:
      185     mVisCUrentVin = current-window:visible.
      186     mFameOldVis = mFramBachModHandle:visible.
      187     mFramBachModHandle:visible  = yes.
      188     mBatchMode = mFramBachModHandle:visible ne yes.
      189     mFramBachModHandle:visible = mFameOldVis.
      190     current-window:visible = mVisCUrentVin.
      191   end.
      192    if  log-manager:logfile-name ne ?
      193     then DO:
      194         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      195         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      196         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      197     end.
      198   on choose of B-WaitFramStop in frame waitfram
      199   do:
      200     mWaitFramStop = yes.
      201     mWaitFramStopUser = yes.
      202   end.
      203   function waitfram-check-timeout returns logical():
      204      define variable vtime as int64 no-undo.
      205      if mWaitFramStopTimeOut
      206      then
      207         return yes.
      208      vtime = ( now - mWaitFramStartProc ) / 1000 .
      209      if     mWaitFramTimeOut ne ?
      210         and mWaitFramTimeOut ne 0
      211         and mWaitFramTimeOut lt vtime
      212      then do:
      213         mWaitFramStopTimeOut = yes.
      214      end.
      215      return mWaitFramStopTimeOut.
      216   end.
      217   procedure waitfram-hide :
      218     if not session:batch-mode
      219     then do
      220     on error undo, return error return-value
      221     :
      222       pause 0 before-hide .
      223       if not mBatchMode then
      224         hide frame waitfram .
      225     if     not mWaitFramView
      226        and mWaitProcEvent
      227     then
      228       process events .
      229     end.
      230   end procedure.
      231   procedure waitfram-show :
      232     define input  parameter p-message as character no-undo .
      233     define variable v-left-margin as integer   no-undo .
      234     if not session:batch-mode
      235     then do
      236     on error undo, return error return-value
      237     :
      238       if length(p-message) <= 70 then do:
      239         assign
      240           v-left-margin = integer((70 - length(p-message)) / 2)
      241         .
      242         assign
      243           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      244         .
      245         assign
      246           v-waitfram-action01 = " "
      247           v-waitfram-action02 = " "
      248                                    + fill(" ", v-left-margin)
      249                                    + p-message
      250           v-waitfram-action03 = " "
      251         .
      252       end.
      253       else do:
      254         define variable vRindex1 as integer no-undo.
      255         define variable vRindex2 as integer no-undo.
      256         vRindex1 = r-index(p-message," ",70).
      257         if vRindex1 = 0
      258         then
      259            vRindex1 = 70.
      260         if length(p-message)  <= vRindex1 + 70 then do:
      261           assign
      262             v-waitfram-action01 = " "
      263             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      264             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      265           .
      266         end.
      267         else do:
      268           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      269           if vRindex2 <= vRindex1
      270           then
      271              vRindex2 = vRindex1 + 70.
      272           assign
      273             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      274             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      275             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      276           .
      277         end.
      278       end.
      279       B-viewProcInfo:visible   in frame waitfram = no.
      280       B-viewProcInfo:sensitive in frame waitfram = no.
      281       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      282       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      283       if  (   mWaitFramView
      284          or  mWaitProcEvent)
      285          and not mBatchMode
      286       then
      287          display
      288             v-waitfram-action01 skip
      289             v-waitfram-action02 skip
      290             v-waitfram-action03 skip
      291          with frame waitfram .
      292       if     mWaitFramView
      293          then do:
      294             if     mWaitFramInterval ne ?
      295                and not mBatchMode
      296             then
      297                wait-for go of frame waitfram pause mWaitFramInterval.
      298          end.
      299          else
      300             if     mWaitProcEvent
      301                and not mBatchMode
      302             then
      303                process events .
      304     end.
      305   end procedure.
      306      procedure waitfram-show-this:
      307         define input  parameter iInterval as int64 no-undo.
      308         define variable vtime as int64 no-undo.
      309         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      310         mWaitFramInterval = iInterval.
      311         run waitfram-show (substitute("&1&2 &3&4" ,
      312                                       mWaitFramTextBeg ,
      313                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      314                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      315                                       mWaitFramTextEnd
      316                                      )
      317                           ).
      318      end.
      319      procedure WaitFramRunPause:
      320         define input  parameter iInterval as dec no-undo.
      321         define variable vStart  as datetime-tz no-undo.
      322         define variable vend    as datetime-tz no-undo.
      323         define variable vint as int64 no-undo.
      324         define variable vOk as logical no-undo.
      325         vStart = now.
      326         vend   = vStart.
      327         publish "WaitFramPause" (iInterval,output vOk).
      328         vend   =  now.
      329         vint = vend - vStart.
      330         vint = iInterval - vint / 1000.
      331         if     not mWaitFramStop
      332            and (   vint > 0
      333                 or (    not vOk
      334                     and iInterval eq ?
      335                     )
      336                 )
      337         then
      338            run waitfram-show-this (iInterval).
      339         vend   =  now.
      340         vint = vend - vStart.
      341         vint = iInterval - vint / 1000.
      342         if     not mWaitFramStop
      343            and vint > 0
      344         then do:
      345            run gbl/pause.p (vint * 1000).
      346         end.
      347         if iInterval ne ?
      348         then
      349            publish "WaitFramStop".
      350         waitfram-check-timeout().
      351      end.
      352      procedure WaitFramWaitFor:
      353         define input  parameter iInterval as dec no-undo.
      354         assign
      355            mWaitFramStartProc   = now
      356            mWaitFramStopUser    = no
      357            mWaitFramStopTimeOut = no
      358         .
      359         block-wait:
      360         do while not mWaitFramStop:
      361            run WaitFramRunPause (iInterval).
      362            if  waitfram-check-timeout()
      363            then do:
      364               leave block-wait.
      365            end.
      366         end.
      367         run waitfram-hide.
      368      end.
      369   procedure waitfram-join :
      370     define input  parameter p-line-1  as character no-undo .
      371     define input  parameter p-line-2  as character no-undo .
      372     define input  parameter p-line-3  as character no-undo .
      373     define output parameter p-message as character no-undo .
      374     do
      375     on error undo, return error return-value
      376     :
      377       assign
      378         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      379                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      380                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      381       .
      382     end.
      383   end procedure.
      384   function waitfram-join-function returns character
      385     (input p-line-1 as character
      386     ,input p-line-2 as character
      387     ,input p-line-3 as character
      388     ).
      389     define variable v-message as character no-undo .
      390     run waitfram-join in this-procedure
      391       (input  p-line-1
      392       ,input  p-line-2
      393       ,input  p-line-3
      394       ,output v-message
      395       ) .
      396     return v-message .
      397   end function .
      398   procedure proc-alt-shift-f2:
      399     if not ibs.th.gbl.gbl-var:rcode
      400   then
      401     run gbl\inidebug.p .
      402   end.
      403   procedure proc-alt-shift-f3:
      404     run gbl/prvssinf.p
      405       ( input this-procedure
      406       ) .
      407   end.
      408   define variable v-inform-launched as logical no-undo initial false .
      409   procedure proc-alt-shift-f4:
      410     define variable v-action as character no-undo .
      411     if v-inform-launched = false then do:
      412       assign
      413         v-inform-launched = true
      414       .
      415       run gbl/d-inform.w
      416         (  input self
      417         ,  input this-procedure
      418         , output v-action
      419         ) no-error .
      420       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      421       assign
      422         v-inform-launched = false
      423       .
      424     end.
      425   end.
      426   procedure proc-alt-f1:
      427     run gbl/corrhelp.p
      428       (input this-procedure
      429       ) .
      430   end .
      431   on alt-shift-f2 anywhere do:
      432     run proc-alt-shift-f2.
      433   end.
      434   on alt-shift-f3 anywhere do:
      435     run proc-alt-shift-f3 in this-procedure .
      436   end.
      437   on alt-shift-f4 anywhere do:
      438     run proc-alt-shift-f4 in this-procedure.
      439   end.
      440   on alt-f1 anywhere do:
      441     run proc-alt-f1 in this-procedure .
      442   end.
      443   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      444   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      445   define variable v-uf-List_        like ubflt.usr-flt.List_        no-undo .
      446   define variable v-uf-Naim         like ubflt.usr-flt.Naim         no-undo .
      447   define variable v-uf-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      448   define variable v-uf-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      449   define variable v-uf-type-price   like ubflt.usr-flt.type-price   no-undo .
      450   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
      451   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
      452   procedure uf-name :
      453     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      454     define output parameter p-use-List_     as logical   no-undo .
      455     define output parameter p-type-List_     as character no-undo .
      456     define output parameter p-format-List_   as character no-undo .
      457     define output parameter p-use-Naim      as logical   no-undo .
      458     define output parameter p-type-Naim      as character no-undo .
      459     define output parameter p-format-Naim    as character no-undo .
      460     define output parameter p-use-print-graft as logical   no-undo .
      461     define output parameter p-use-sort-gr   as logical   no-undo .
      462     define output parameter p-use-type-price as logical   no-undo .
      463     define output parameter p-use-type-val  as logical   no-undo .
      464     define output parameter p-label          as character no-undo .
      465     define output parameter p-tooltip        as character no-undo .
      466     define output parameter p-user-can-edit  as logical   no-undo .
      467     define output parameter p-output-display as logical   no-undo .
      468     define output parameter p-other          as character no-undo .
      469     do
      470     on error undo, return error
      471     :
