     4747   end.
     4748   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4749   procedure minbtn-set :
     4750       do
     4751           on error undo, return error return-value
     4752           :
     4753           define variable ii              as integer       no-undo .
     4754           define variable fh              as widget-handle no-undo .
     4755           define variable hh              as widget-handle no-undo .
     4756           define variable v-h             as handle        extent 4 no-undo .
     4757           define variable v-name-button   as character     no-undo .
     4758           define variable v-help-old-x    as decimal       no-undo .
     4759           define variable v-help-old-y    as decimal       no-undo .
     4760           define variable v-help-old-size as decimal       no-undo .
     4761           define variable v-frame-width   as decimal       no-undo .
     4762           define variable jj              as integer       no-undo .
     4763           do
     4764               on error undo, return error
     4765               :
     4766               assign
     4767                   v-frame-width = frame Dialog-Frame:width - 0.3
     4768                   fh            = frame Dialog-Frame:first-child
     4769                   hh            = fh:first-child
     4770                   ii            = 1
     4771                   .
     4772               do while valid-handle(hh):
     4773                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     4774                   do:
     4775                       case lc(hh:name) :
     4776                           when "b-help" then
     4777                               do:
     4778                                   hh:load-image-up("cmp/b-help.bmp":u) .
     4779                                   hh:load-image-down("cmp/b-help.bmp":u) .
     4780                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     4781                                   hh:TOOLTIP = "Помощь" .
     4782                                   v-help-old-x = hh:column .
     4783                                   v-help-old-y = hh:row    .
     4784                                   v-help-old-size = hh:width .
     4785                                   hh:width-chars = 2.5 .
     4786                               end.
     4787                           when "b-print" then
     4788                               do:
     4789                                   hh:load-image("cmp/b-print.bmp":u) .
     4790                                   hh:TOOLTIP = "Печать" .
     4791                                   v-h[ii] = hh:handle .
     4792                                   ii = ii + 1 .
     4793                                   hh:width-chars = 3 .
     4794                               end.
     4795                           when "b-history" or
     4796                           when "b-hist" then
     4797                               do:
     4798                                   hh:load-image("cmp/b-hist.bmp":u) .
     4799                                   hh:TOOLTIP = "История" .
     4800                                   v-h[ii] = hh:handle .
     4801                                   ii = ii + 1 .
     4802                                   hh:width-chars = 3 .
     4803                               end.
     4804                           when "b-sch" then
     4805                               do:
     4806                                   hh:load-image("cmp/b-sch.bmp":u) .
     4807                                   hh:TOOLTIP = "Установка Фильтра" .
     4808                                   v-h[ii] = hh:handle .
     4809                                   ii = ii + 1 .
     4810                                   hh:width-chars = 3 .
     4811                               end.
     4812                           when "b-hist-user" then
     4813                               do:
     4814                                   hh:load-image("cmp/b-hist.bmp":u) .
     4815                                   hh:TOOLTIP = "История пользователя" .
     4816                                   ii = ii + 1 .
     4817                               end.
     4818                       end case.
     4819                   end.
     4820                   hh = hh:next-sibling.
     4821               end.
     4822               b-help:column = v-frame-width - b-help:width-chars.
     4823               jj = 0.
     4824               repeat ii = 4 to 1 by -1 :
     4825                   if valid-handle (v-h[ii] ) then
     4826                   do:
     4827                       jj  = jj + 1 .
     4828                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     4829                       v-h[ii]:row    = v-help-old-y .
     4830                   end.
     4831               end.
     4832           end.
     4833       end.
     4834   end procedure.
     4835   define variable vss-include-info56 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4836   ON TAB ANYWHERE
     4837   DO:
     4838   define variable ii as integer no-undo .
     4839   define variable fh as widget-handle no-undo .
     4840   define variable hh as widget-handle no-undo .
     4841   define variable v-next-widget-name as character no-undo .
     4842   if v-tab-order <> '' then do:
     4843     if self:type = "TOGGLE-BOX" then
     4844     self:BGCOLOR = ?.
     4845     assign
     4846     ii = lookup(self:name, v-tab-order).
     4847     assign
     4848     ii = ii + 1
     4849     v-next-widget-name = entry(ii, v-tab-order)
     4850     no-error .
     4851     if error-status:error then do:
     4852       assign
     4853       ii = 1
     4854       v-next-widget-name = entry( ii, v-tab-order)
     4855       .
     4856     end.
     4857     assign
     4858     fh = frame Dialog-Frame:first-child
     4859     hh = fh:first-child
     4860     .
     4861     do while valid-handle(hh):
     4862       if hh:name = v-next-widget-name then do:
     4863         if hh:sensitive  = yes
     4864         AND hh:visible = yes then do:
     4865           if hh:type = "TOGGLE-BOX":U then do:
     4866             assign
     4867             hh:BGcolor = 1
     4868             .
     4869           end.
     4870           APPLY "ENTRY" to hh.
     4871           return no-apply.
     4872         end.
     4873         else do:
     4874           APPLY "TAB" to hh.
     4875           return no-apply.
     4876         end.
     4877       end.
     4878       hh = hh:next-sibling.
     4879     end.
     4880   end.
     4881   END.
     4882   ON BACK-TAB ANYWHERE
     4883   DO:
     4884   define variable ii as integer no-undo .
     4885   define variable fh as widget-handle no-undo .
     4886   define variable hh as widget-handle no-undo .
     4887   define variable v-next-widget-name as character no-undo .
     4888   if v-tab-order <> '' then do:
     4889     assign
     4890     ii = lookup(self:name, v-tab-order).
     4891     .
     4892     assign
     4893     ii = (if ii = 1
     4894           then  num-entries(v-tab-order)
     4895           else ii - 1
     4896           )
     4897     v-next-widget-name = entry(ii, v-tab-order)
     4898     .
     4899     assign
     4900     fh = frame Dialog-Frame:first-child
     4901     hh = fh:first-child
     4902     .
     4903     do while valid-handle(hh):
     4904       if hh:name = v-next-widget-name then do:
     4905         if hh:sensitive  = yes
     4906         AND hh:visible = yes then do:
     4907           if hh:type = "TOGGLE-BOX":U then do:
     4908             assign
     4909             hh:BGcolor = 1
     4910             .
     4911           end.
     4912           APPLY "ENTRY" to hh.
     4913           return no-apply.
     4914         end.
     4915         else do:
     4916         APPLY "BACK-TAB" to hh.
     4917         return no-apply.
     4918         end.
     4919       end.
     4920       hh = hh:next-sibling.
     4921     end.
     4922     end.
     4923   END.
     4924   define variable vss-include-info57 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4925   ON RETURN ANYWHERE
     4926   DO:
     4927   define variable ii as integer no-undo .
     4928   define variable fh as widget-handle no-undo .
     4929   define variable hh as widget-handle no-undo .
     4930   define variable v-next-widget-name as character no-undo .
     4931     if v-tab-order <> '' then do:
     4932       assign
     4933       ii = lookup(self:name, v-tab-order).
     4934       if ii = num-entries(v-tab-order) then do:
     4935           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     4936           return no-apply.
     4937       end.
     4938       if self:type <> "BUTTON" and
     4939         self:type <> "EDITOR"  then do:
     4940         run proc-move-forward in this-procedure .
     4941         return no-apply.
     4942       end.
     4943       if self:type = "BUTTON" then do:
     4944         APPLY "CHOOSE" to self.
     4945       end.
     4946       if self:type = "TOGGLE-BOX" then
     4947       self:BGCOLOR = ?.
     4948       assign
     4949       ii = ii + 1
     4950       v-next-widget-name = entry(ii, v-tab-order)
     4951       no-error .
     4952       if error-status:error then do:
     4953         assign
     4954         ii = 1
     4955         v-next-widget-name = entry( ii, v-tab-order)
     4956         .
     4957       end.
     4958       assign
     4959       fh = frame Dialog-Frame:first-child
     4960       hh = fh:first-child
     4961       .
     4962       do while valid-handle(hh):
     4963         if hh:name = v-next-widget-name then do:
     4964           if hh:sensitive  = yes
     4965           AND hh:visible = yes then do:
     4966             if hh:type = "TOGGLE-BOX":U then do:
     4967               assign
     4968               hh:BGcolor = 1
     4969               .
     4970             end.
     4971             APPLY "ENTRY" to hh.
     4972             return no-apply.
     4973           end.
     4974           else do:
     4975             APPLY "TAB" to hh.
     4976             return no-apply.
     4977           end.
     4978         end.
     4979         hh = hh:next-sibling.
     4980       end.
     4981     end.
     4982   END.
     4983   procedure proc-move-forward :
     4984   define variable ii as integer no-undo .
     4985   define variable fh as widget-handle no-undo .
     4986   define variable hh as widget-handle no-undo .
     4987   define variable v-next-widget-name as character no-undo .
     4988   do
     4989   on error undo, return error
     4990   :
     4991     if v-tab-order <> '' then do:
     4992       if self:type = "TOGGLE-BOX" then
     4993       self:BGCOLOR = ?.
     4994       assign
     4995       ii = lookup(self:name, v-tab-order).
     4996       assign
     4997       ii = ii + 1
     4998       v-next-widget-name = entry(ii, v-tab-order)
     4999       no-error .
     5000       if error-status:error then do:
     5001         assign
     5002         ii = 1
     5003         v-next-widget-name = entry( ii, v-tab-order)
     5004         .
     5005       end.
     5006       assign
     5007       fh = frame Dialog-Frame:first-child
     5008       hh = fh:first-child
     5009       .
     5010       do while valid-handle(hh):
     5011         if hh:name = v-next-widget-name then do:
     5012           if hh:sensitive  = yes
     5013           AND hh:visible = yes then do:
     5014             if hh:type = "TOGGLE-BOX":U then do:
     5015               assign
     5016               hh:BGcolor = 1
     5017               .
     5018             end.
     5019             APPLY "ENTRY" to hh.
     5020             return.
     5021           end.
     5022           else do:
     5023             assign
     5024             ii = ii + 1
     5025             v-next-widget-name = entry(ii, v-tab-order)
     5026             no-error .
     5027             if error-status:error then do:
     5028               assign
     5029               ii = 1
     5030               v-next-widget-name = entry( ii, v-tab-order)
     5031               .
     5032             end.
     5033           end.
     5034         end.
     5035         hh = hh:next-sibling.
     5036       end.
     5037     end.
     5038   end.
     5039   end procedure.
