     3199     and ub.CashBookRule.Obj-type   = 'всем':U
     3200     and ub.CashBookRule.Obj-code   = 0
     3201     and ub.CashBookRule.Code       = "RuleOsnPkoVne"
     3202     no-error.
     3203   if available (ub.CashBookRule) then tt-fin-doc.naznach-plat = ub.CashBookRule.RuleValue .
     3204   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     3205     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     3206     and X_fin-code-cor-acc.status_ = integer('0':U)
     3207     no-error .
