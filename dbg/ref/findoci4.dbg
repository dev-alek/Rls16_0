     5247     b-quit:column = 1
     5248     .
     5249   end.
     5250   run hide-view-currency in this-procedure.
     5251   CASE p-view:
     5252     when "full":U then do:
     5253       assign
     5254       v-tab-order = "b-exit,b-quit,b-tax,b-print,b-hist,b-help," +                             "prn-doc-code,vid-plat,doc-date,obj-type,obj-code,b-obj," +                             v-an-uchet-tab-order +  "b-payer-schet,b-payer-view," + v-sum-curr-tab-order +                             "receiver-type,receiver-code,b-receiver,receiver-name,b-receiver-schet,b-receiver-view," +                              "naznach-plat,PS,payer-sign1,payer-sign2"
     5255       .
