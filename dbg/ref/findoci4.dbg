     2973   PROCEDURE check-receiver :
     2974     define buffer buf_clients for ub.clients.
     2975     find first buf_clients no-lock where
     2976       buf_clients.obj-code = input frame Dialog-Frame tt-fin-doc.receiver-code
     2977       and buf_clients.obj-type = input frame Dialog-Frame tt-fin-doc.receiver-type no-error.
     2978     if not available buf_clients then
     2979     do:
     2980       if input frame Dialog-Frame tt-fin-doc.receiver-code <> ?  then
     2981         message "Неправильный код или тип " 'ПОЛУЧАТЕЛЯ'.
     2982       apply "entry" to tt-fin-doc.receiver-code in frame Dialog-Frame.
     2983       return error.
     2984     end.
     2985     find first X_receiver no-lock where recid(X_receiver) = recid(buf_clients).
     2986     assign
     2987       tt-fin-doc.receiver-type = buf_clients.obj-type
     2988       tt-fin-doc.receiver-code = buf_clients.obj-code
     2989       tt-fin-doc.receiver-name = buf_clients.obj-name
     2990       .
     2991   find first ub.CashBook no-lock where ub.CashBook.id = tt-fin-doc.cashbookId no-error .
     2992   if ub.CashBook.cli-code = tt-fin-doc.receiver-code and ub.CashBook.cli-type = tt-fin-doc.receiver-type then do:
     2993   assign
     2994     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     2995     tt-fin-doc.cor-acc-value  = ub.CashBook.corrPko
     2996     tt-fin-doc.naznach-plat   = ub.CashBook.RuleOsnPko
     2997     .
     2998   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     2999     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     3000     and X_fin-code-cor-acc.status_ = integer('0':U)
     3001     no-error .
     3002   if available X_fin-code-cor-acc
     3003     then
     3004   do :
     3005     assign
     3006       f-cor-acc-descr    = X_fin-code-cor-acc.descr
     3007       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     3008       .
     3009   end.
     3010   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     3011     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     3012     and X_fin-code-cor-acc1.status_ = integer('0':U)
     3013     no-error .
     3014   if available X_fin-code-cor-acc1
     3015     then
     3016   do :
     3017     assign
     3018       f-cor-acc1-descr   = X_fin-code-cor-acc1.descr
     3019       tt-fin-doc.cor-acc = X_fin-code-cor-acc1.fin-code
     3020       .
     3021   end.
     3022   end.
     3023   else
     3024   do:
     3025   if getCliKassa(tt-fin-doc.receiver-type, tt-fin-doc.receiver-code, "Vnecli", tt-fin-doc.cashbookId) then do:
     3026   assign
     3027     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     3028     .
     3029   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     3030     and ub.CashBookRule.Obj-type   = 'всем':U
     3031     and ub.CashBookRule.Obj-code   = 0
     3032     and ub.CashBookRule.Code       = "corrPkoVne"
     3033     no-error.
     3034   if available (ub.CashBookRule) then tt-fin-doc.cor-acc-value = ub.CashBookRule.RuleValue .
     3035   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     3036     and ub.CashBookRule.Obj-type   = 'всем':U
     3037     and ub.CashBookRule.Obj-code   = 0
     3038     and ub.CashBookRule.Code       = "RuleOsnPkoVne"
     3039     no-error.
     3040   if available (ub.CashBookRule) then tt-fin-doc.naznach-plat = ub.CashBookRule.RuleValue .
     3041   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     3042     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     3043     and X_fin-code-cor-acc.status_ = integer('0':U)
     3044     no-error .
     3045   if available X_fin-code-cor-acc
     3046     then
     3047   do :
     3048     assign
     3049       f-cor-acc-descr    = X_fin-code-cor-acc.descr
     3050       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     3051       .
     3052   end.
     3053   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     3054     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     3055     and X_fin-code-cor-acc1.status_ = integer('0':U)
     3056     no-error .
     3057   if available X_fin-code-cor-acc1
     3058     then
     3059   do :
     3060     assign
     3061       f-cor-acc1-descr   = X_fin-code-cor-acc1.descr
     3062       tt-fin-doc.cor-acc = X_fin-code-cor-acc1.fin-code
     3063       .
     3064   end.
     3065   end.
     3066   else do:
     3067   if getCliKassa(tt-fin-doc.receiver-type, tt-fin-doc.receiver-code, "Avanscli", tt-fin-doc.cashbookId) then do:
     3068   assign
     3069     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     3070     .
     3071   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     3072     and ub.CashBookRule.Obj-type   = 'всем':U
     3073     and ub.CashBookRule.Obj-code   = 0
     3074     and ub.CashBookRule.Code       = "corrPkoAvans"
     3075     no-error.
     3076   if available (ub.CashBookRule) then tt-fin-doc.cor-acc-value = ub.CashBookRule.RuleValue .
     3077   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     3078     and ub.CashBookRule.Obj-type   = 'всем':U
     3079     and ub.CashBookRule.Obj-code   = 0
     3080     and ub.CashBookRule.Code       = "RuleOsnPkoAvans"
     3081     no-error.
     3082   if available (ub.CashBookRule) then tt-fin-doc.naznach-plat = ub.CashBookRule.RuleValue .
     3083   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     3084     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     3085     and X_fin-code-cor-acc.status_ = integer('0':U)
     3086     no-error .
     3087   if available X_fin-code-cor-acc
     3088     then
     3089   do :
     3090     assign
     3091       f-cor-acc-descr    = X_fin-code-cor-acc.descr
     3092       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     3093       .
     3094   end.
     3095   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     3096     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     3097     and X_fin-code-cor-acc1.status_ = integer('0':U)
     3098     no-error .
     3099   if available X_fin-code-cor-acc1
     3100     then
     3101   do :
     3102     assign
     3103       f-cor-acc1-descr   = X_fin-code-cor-acc1.descr
     3104       tt-fin-doc.cor-acc = X_fin-code-cor-acc1.fin-code
     3105       .
     3106   end.
     3107   end.
     3108   else do:
     3109   tt-fin-doc.naznach-plat = "".
     3110   end.
     3111   end.
     3112   end.
     3113     display
     3114       tt-fin-doc.receiver-type
     3115       tt-fin-doc.receiver-code
     3116       tt-fin-doc.receiver-name
     3117       with frame Dialog-Frame.
     3118   END PROCEDURE.
     3119   on return of tt-fin-doc.payer-code in frame Dialog-Frame
     3120     do:
     3121       apply "leave" to tt-fin-doc.payer-code in frame Dialog-Frame.
     3122       return no-apply.
     3123     end.
