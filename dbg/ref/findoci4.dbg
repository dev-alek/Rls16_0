     5645       v-sttm-prn-doc-CODE = "@НЕИЗВЕСТНАЯ ВЫПИСКА".
     5646     END.
     5647     ELSE DO:
     5648         ASSIGN
     5649         v-sttm-prn-doc-CODE = X_fin-statement.prn-doc-code.
     5650     END.
     5651   END.
     5652   if p-mode = 'ПРОСМОТР':U then do:
     5653       run proc-color-widgets in this-procedure("f-an-uchet-descr,f-cel-nazn-descr,f-contract-curr-abbr,f-contract-date,f-contract-prn-code,f-contract-rate," +                         "f-contract-scale,f-contract-type,f-cor-acc-descr,base-rate,base-scale,curr-code,exch-rate,exch-scale,contract-rate,contract-scale," +                         "fact-date,fin-doc-code,receiver-code,receiver-type,pay-date,perm-date,PS,payer-code,payer-type,sum-base,sum-rubl,sum-contr," +                         "user-name-doc,user-name-fact,user-name-perm.user-name-pl", no, yes, ?, ?).
