     1612   ASSIGN
     1613          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1614          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1615   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1616   DO:
     1617     APPLY "END-ERROR":U TO SELF.
     1618   END.
     1619   ON CHOOSE OF b-other IN FRAME Dialog-Frame
     1620   DO:
     1621     run ref/fndoci4d.w (
     1622    INPUT     parParentProc
     1623   ,input p-curr-host-code
     1624   ,input p-mode
     1625   ,input tt-fin-doc.host-code
     1626   ,input tt-fin-doc.fin-doc-code
     1627   ,input tt-fin-doc.fin-ext-doc-type
     1628   ,input-output p-doc-rec ) no-error.
     1629   if error-status:error then return no-apply.
     1630   END.
     1631   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1632   DO:
     1633   define variable v-format as integer no-undo .
     1634   define variable v-cmp as character no-undo .
     1635   define variable v-log as logical no-undo .
     1636   buffer-compare tt-fin-doc to locked_fin-doc
     1637   case-sensitive
     1638   save result in v-cmp .
     1639   if v-cmp <> "":U then do:
     1640     message
     1641     "Вы изменили ПЛАТЕЖ, но не сохранили его" skip
     1642     "сохранить перед печатью?"
     1643     view-as alert-box QUESTION buttons YES-NO update v-log.
     1644   end.
     1645   run proc-save in this-procedure (v-log) no-error.
     1646   run ref/fdoc-prn.p (
     1647           input parparentproc
     1648         , input this-procedure
     1649         , input string(recid(locked_fin-doc))
     1650                         ) no-error.
     1651   if error-status:error then return no-apply.
     1652   END.
     1653   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1654   procedure proc-color-widgets :
     1655   define input parameter p-list as character no-undo .
     1656   define input parameter p-fg as logical no-undo .
     1657   define input parameter p-bg as logical no-undo .
     1658   define input parameter p-fgc as integer no-undo .
     1659   define input parameter p-bgc as integer no-undo .
     1660   define variable ii as integer no-undo .
     1661   define variable fh as widget-handle no-undo .
     1662   define variable hh as widget-handle no-undo .
     1663     do
     1664     on error undo, return error
     1665     :
     1666       assign
     1667       fh = frame Dialog-Frame:first-child
     1668       hh = fh:first-child
     1669       .
     1670       do while valid-handle(hh):
     1671         if LOOKUP(hh:name, p-list) > 0  then do:
     1672           assign
     1673           hh:fgcolor = (if p-fg then p-fgc else hh:fgcolor)
     1674           hh:bgcolor = (if p-bg then p-bgc else hh:bgcolor)
     1675           .
     1676         end.
     1677         hh = hh:next-sibling.
     1678       end.
     1679     end.
     1680   end procedure.
     1681   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile: findocip.i $ $Revision: ff8019e24d02, 2996, rls $".
     1682   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1683   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1684   procedure set-buffers :
     1685     DEFINE input parameter X_clients-host-recid as recid no-undo .
     1686     DEFINE input parameter X_firm-recid as recid no-undo .
     1687     DEFINE input parameter X_sysconf-recid as recid no-undo .
     1688     define input parameter X_fin-code-cor-acc-recid as recid no-undo .
     1689     define input parameter X_fin-code-cor-acc1-recid as recid no-undo .
     1690     define input parameter X_fin-code-an-uchet-recid as recid no-undo .
     1691     define input parameter X_fin-code-cel-nazn-recid as recid no-undo .
     1692     define input parameter X_currency-recid as recid no-undo .
     1693     define input parameter X_contract-currency-recid as recid no-undo .
     1694     DEFINE input parameter X_receiver-recid as recid no-undo .
     1695     DEFINE input parameter X_payer-recid as recid no-undo .
     1696     define input parameter X_curr_sysconf-recid as recid no-undo .
     1697     define input parameter X_payer-fin-schet-recid as recid no-undo .
     1698     define input parameter X_payer-fin-bank-recid as recid no-undo .
     1699     define input parameter X_payer-firm-recid as recid no-undo .
     1700     define input parameter X_payer-person-recid as recid no-undo .
     1701     define input parameter X_receiver-fin-schet-recid as recid no-undo .
     1702     define input parameter X_receiver-fin-bank-recid as recid no-undo .
     1703     define input parameter X_receiver-firm-recid as recid no-undo .
     1704     define input parameter X_receiver-person-recid as recid no-undo .
     1705     define input parameter X_contract-recid as recid no-undo .
     1706     define input parameter X_fin-ob-recid as recid no-undo .
     1707     define input parameter X_clients-obj-recid as recid no-undo .
     1708     define input parameter p-f-cor-acc1-descr as character no-undo .
     1709     define input parameter p-f-cor-acc-descr as character no-undo .
     1710     define input parameter p-f-an-uchet-descr as character no-undo .
     1711     define input parameter p-f-cel-nazn-descr as character no-undo .
     1712     do
     1713       on error undo, return error
     1714       :
     1715       find first X_clients-host no-lock where                   recid(X_clients-host)          = X_clients-host-recid no-error  .
     1716       find first X_firm no-lock where                           recid(X_firm)                  = X_firm-recid no-error .
     1717       find first X_sysconf no-lock where                        recid(X_sysconf)               = X_sysconf-recid no-error .
     1718       find first X_fin-code-cor-acc no-lock where               recid(X_fin-code-cor-acc)      = X_fin-code-cor-acc-recid no-error .
     1719       find first X_fin-code-cor-acc1 no-lock where              recid(X_fin-code-cor-acc1)     = X_fin-code-cor-acc1-recid no-error .
     1720       find first X_fin-code-an-uchet no-lock where              recid(X_fin-code-an-uchet)     = X_fin-code-an-uchet-recid no-error .
     1721       find first X_fin-code-cel-nazn no-lock where              recid(X_fin-code-cel-nazn)     = X_fin-code-cel-nazn-recid no-error .
     1722       find first X_currency no-lock where                       recid(X_currency)              = X_currency-recid no-error .
     1723       find first X_contract-currency no-lock where              recid(X_contract-currency)     = X_contract-currency-recid no-error .
     1724       find first X_receiver no-lock where                       recid(X_receiver)              = X_receiver-recid no-error .
     1725       find first X_payer no-lock where                          recid(X_payer)                 = X_payer-recid no-error .
     1726       find first X_curr_sysconf no-lock where                   recid(X_curr_sysconf)          = X_curr_sysconf-recid no-error .
     1727       find first X_payer-fin-schet no-lock where                recid(X_payer-fin-schet)       = X_payer-fin-schet-recid no-error .
     1728       find first X_payer-fin-bank no-lock where                 recid(X_payer-fin-bank)        = X_payer-fin-bank-recid no-error .
     1729       find first X_payer-firm no-lock where                     recid(X_payer-firm)            = X_payer-firm-recid no-error .
     1730       find first X_payer-person no-lock where                   recid(X_payer-person)          = X_payer-person-recid no-error .
     1731       find first X_receiver-fin-schet no-lock where             recid(X_receiver-fin-schet)    = X_receiver-fin-schet-recid no-error .
     1732       find first X_receiver-fin-bank no-lock where              recid(X_receiver-fin-bank)     = X_receiver-fin-bank-recid no-error .
     1733       find first X_receiver-firm no-lock where                  recid(X_receiver-firm)         = X_receiver-firm-recid no-error .
     1734       find first X_receiver-person no-lock where                recid(X_receiver-person)       = X_receiver-person-recid no-error .
     1735       find first X_contract no-lock where                       recid(X_contract)              = X_contract-recid no-error .
     1736       find first X_fin-ob no-lock where                         recid(X_fin-ob)                = X_fin-ob-recid no-error .
     1737       find first X_clients-obj no-lock where                    recid(X_clients-obj)           = X_clients-obj-recid no-error .
     1738       assign
     1739         f-cor-acc1-descr = p-f-cor-acc1-descr
     1740         f-cor-acc-descr  = p-f-cor-acc-descr
     1741         f-an-uchet-descr = p-f-an-uchet-descr
     1742         f-cel-nazn-descr = p-f-cel-nazn-descr
     1743         .
     1744     end.
     1745   end procedure.
     1746   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile: findocip.i $ $Revision: ff8019e24d02, 2996, rls $".
     1747   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1748   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1749   procedure get-single-schet :
     1750     define input parameter p-host-code like ub.sysconf.host-code no-undo .
     1751     define input parameter p-cli-type like ub.fin-schet.cli-type no-undo .
     1752     define input parameter p-cli-code like ub.fin-schet.cli-code no-undo .
     1753     define input parameter p-curr-code like ub.fin-schet.curr-code no-undo .
     1754     define output parameter p-recid-schet as recid no-undo .
     1755     define output parameter p-recid-bank as recid no-undo .
     1756     define variable ii as integer no-undo .
     1757     define buffer buf_fin-schet for ub.fin-schet.
     1758     define buffer buf_fin-bank  for ub.fin-bank.
     1759     do
     1760       on error undo, return error
     1761       :
     1762       for each buf_fin-schet no-lock where
     1763         buf_fin-schet.host-code = p-host-code
     1764         AND buf_fin-schet.cli-type = p-cli-type
     1765         AND buf_fin-schet.cli-code = p-cli-code
     1766         AND buf_fin-schet.curr-code = p-curr-code:
     1767         if buf_fin-schet.status_ = 'тек':U then
     1768         do:
     1769           find first buf_fin-bank no-lock where
     1770             buf_fin-bank.host-code = p-host-code
     1771             AND buf_fin-bank.code-bank = buf_fin-schet.code-bank no-error .
     1772           if avail buf_fin-bank and buf_fin-bank.status_ = 'тек':U then
     1773           do:
     1774             assign
     1775               p-recid-schet = recid(buf_fin-schet)
     1776               p-recid-bank  = recid(buf_fin-bank)
     1777               .
     1778             assign
     1779               ii = ii + 1
     1780               .
     1781           end.
     1782         end.
     1783         if ii > 1 then
     1784         do:
     1785           assign
     1786             p-recid-schet = ?
     1787             p-recid-bank  = ?
     1788             .
     1789         end.
     1790       end.
     1791     end.
     1792   end procedure.
     1793   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile: findocip.i $ $Revision: ff8019e24d02, 2996, rls $".
     1794   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1795   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1796   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1797   on ' ' of tt-fin-doc.doc-date in frame Dialog-Frame
     1798   do:
     1799     if (can-query (self, "sensitive")
     1800        and
     1801        self :sensitive = true
     1802        )
     1803     or (can-query (self, "read-only")
     1804        and
     1805        self :read-only = false
     1806        )
     1807     then do:
     1808       assign
     1809         self :screen-value = ?
     1810       .
     1811     end.
     1812     return no-apply.
     1813   end.
     1814   on delete-character of tt-fin-doc.doc-date in frame Dialog-Frame
     1815   do:
     1816     if (can-query (self, "sensitive")
     1817        and
     1818        self :sensitive = true
     1819        )
     1820     or (can-query (self, "read-only")
     1821        and
     1822        self :read-only = false
     1823        )
     1824     then do:
     1825       assign
     1826         self :screen-value = ?
     1827       .
     1828     end.
     1829     return no-apply.
     1830   end.
     1831   on ctrl-d of tt-fin-doc.doc-date in frame Dialog-Frame
     1832   do:
     1833     define variable v-curr-sv-date as date no-undo .
     1834     if (can-query (self, "sensitive")
     1835        and
     1836        self :sensitive = true
     1837        )
     1838     or (can-query (self, "read-only")
     1839        and
     1840        self :read-only = false
     1841        )
     1842     then do:
     1843       if self :handle <> focus :handle
     1844       then do:
     1845         apply "entry":u to self .
     1846       end.
     1847       run gbl/getcurdt.p
     1848         (output v-curr-sv-date
     1849         ) .
     1850       assign
     1851         self :screen-value = string(v-curr-sv-date) .
     1852       .
     1853     end.
     1854     return no-apply.
     1855   end.
     1856   on ctrl-b of tt-fin-doc.doc-date in frame Dialog-Frame
     1857   do:
     1858     if (can-query (self, "sensitive")
     1859        and
     1860        self :sensitive = true
     1861        )
     1862     or (can-query (self, "read-only")
     1863        and
     1864        self :read-only = false
     1865        )
     1866     then do:
     1867       if self :handle <> focus :handle
     1868       then do:
     1869         apply "entry":u to self .
     1870       end.
     1871       define variable v-curr-sv-date as date no-undo .
     1872       define variable v-new-sv-date  as date no-undo .
     1873       assign
     1874         v-curr-sv-date = date(self :screen-value) no-error
     1875       .
     1876       if v-curr-sv-date = ?
     1877       then do:
     1878         run gbl/getcurdt.p
     1879           (output v-curr-sv-date
     1880           ) .
     1881       end.
     1882       if v-curr-sv-date <> ?
     1883       then do:
     1884         assign
     1885           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1886         .
     1887         assign
     1888           self :screen-value = string(v-new-sv-date) .
     1889         .
     1890       end.
     1891     end.
     1892     return no-apply .
     1893   end.
     1894   on ctrl-e of tt-fin-doc.doc-date in frame Dialog-Frame
     1895   do:
     1896     if (can-query (self, "sensitive")
     1897        and
     1898        self :sensitive = true
     1899        )
     1900     or (can-query (self, "read-only")
     1901        and
     1902        self :read-only = false
     1903        )
     1904     then do:
     1905       if self :handle <> focus :handle
     1906       then do:
     1907         apply "entry":u to self .
     1908       end.
     1909       define variable v-curr-sv-date as date no-undo .
     1910       define variable v-new-sv-date  as date no-undo .
     1911       assign
     1912         v-curr-sv-date = date(self :screen-value) no-error
     1913       .
     1914       if v-curr-sv-date = ?
     1915       then do:
     1916         run gbl/getcurdt.p
     1917           (output v-curr-sv-date
     1918           ) .
     1919       end.
     1920       if v-curr-sv-date <> ?
     1921       then do:
     1922         run gbl/lastdate.p
     1923           (input  v-curr-sv-date
     1924           ,output v-new-sv-date
     1925           ).
     1926         assign
     1927           self :screen-value = string(v-new-sv-date) .
     1928         .
     1929       end.
     1930     end.
     1931     return no-apply .
     1932   end.
     1933   on ctrl-f of tt-fin-doc.doc-date in frame Dialog-Frame
     1934   do:
     1935     if (can-query (self, "sensitive")
     1936        and
     1937        self :sensitive = true
     1938        )
     1939     or (can-query (self, "read-only")
     1940        and
     1941        self :read-only = false
     1942        )
     1943     then do:
     1944       if self :handle <> focus :handle
     1945       then do:
     1946         apply "entry":u to self .
     1947       end.
     1948       define variable v-ok            as logical   no-undo .
     1949       define variable v-curr-sv-date  as date      no-undo .
     1950       define variable v-description   as character no-undo .
     1951       assign
     1952         v-curr-sv-date = date(self :screen-value) no-error
     1953       .
     1954       if v-curr-sv-date = ?
     1955       then do:
     1956         run gbl/getcurdt.p
     1957           (output v-curr-sv-date
     1958           ) .
     1959       end.
     1960       if v-curr-sv-date <> ?
     1961       then do:
     1962         run gbl/d-inpday.w
     1963           (input ?
     1964           ,input "Выбор даты"
     1965           ,input v-description
     1966           ,input ""
     1967           ,input-output v-curr-sv-date
     1968           ,output v-ok
     1969           ).
     1970         if v-ok = true
     1971         then do:
     1972           assign
     1973             self :screen-value = string(v-curr-sv-date) .
     1974           .
     1975         end.
     1976       end.
     1977     end.
     1978     return no-apply .
     1979   end.
     1980     define MENU m-ed-date21
     1981       MENU-ITEM m-ed-date21-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1982       MENU-ITEM m-ed-date21-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1983       MENU-ITEM m-ed-date21-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1984       MENU-ITEM m-ed-date21-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1985       .
     1986     if tt-fin-doc.doc-date :POPUP-MENU in frame Dialog-Frame = ?
     1987     then do:
     1988       ASSIGN
     1989         tt-fin-doc.doc-date :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date21 :HANDLE
     1990         tt-fin-doc.doc-date :MENU-MOUSE in frame Dialog-Frame = 3
     1991       .
     1992     end.
     1993     define variable v-label-handle21 as handle no-undo .
     1994     assign
     1995       v-label-handle21 = tt-fin-doc.doc-date :side-label-handle in frame Dialog-Frame
     1996     .
     1997     if valid-handle (v-label-handle21)
     1998     then do:
     1999       if v-label-handle21 :tooltip = ""
     2000       or v-label-handle21 :tooltip = ?
     2001       then do:
     2002         assign
     2003           v-label-handle21 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     2004         .
     2005       end.
     2006     end.
     2007     ON CHOOSE OF MENU-ITEM m-ed-date21-1 in menu m-ed-date21 DO:
     2008       apply "ctrl-b":U to tt-fin-doc.doc-date in frame Dialog-Frame .
     2009     END.
     2010     ON CHOOSE OF MENU-ITEM m-ed-date21-2 in menu m-ed-date21 DO:
     2011       apply "ctrl-d":U to tt-fin-doc.doc-date in frame Dialog-Frame .
     2012     END.
     2013     ON CHOOSE OF MENU-ITEM m-ed-date21-3 in menu m-ed-date21 DO:
     2014       apply "ctrl-e":U to tt-fin-doc.doc-date in frame Dialog-Frame .
     2015     END.
     2016     ON CHOOSE OF MENU-ITEM m-ed-date21-4 in menu m-ed-date21 DO:
     2017       apply "ctrl-f":U to tt-fin-doc.doc-date in frame Dialog-Frame .
     2018     END.
     2019   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2020   ON ANY-PRINTABLE OF tt-fin-doc.naznach-plat IN FRAME Dialog-Frame
     2021   DO:
     2022     RUN proc-uho-check IN THIS-PROCEDURE(1) NO-ERROR.
     2023     IF ERROR-STATUS :ERROR THEN DO: RETURN NO-APPLY. END.
     2024   END.
     2025   ON BACKSPACE OF tt-fin-doc.naznach-plat IN FRAME Dialog-Frame
     2026   DO:
     2027   define variable v-offset as integer no-undo .
     2028     RUN proc-uho-check IN THIS-PROCEDURE(1) NO-ERROR.
     2029     IF ERROR-STATUS :ERROR THEN DO: RETURN NO-APPLY. END.
     2030     if tt-fin-doc.naznach-plat :CURSOR-OFFSET > 1 then do :
     2031       assign
     2032       v-offset = tt-fin-doc.naznach-plat:CURSOR-OFFSET
     2033       tt-fin-doc.naznach-plat:screen-value = substring(tt-fin-doc.naznach-plat:screen-value, 1, tt-fin-doc.naznach-plat:CURSOR-OFFSET - 2) +
     2034                         substring(tt-fin-doc.naznach-plat:screen-value, tt-fin-doc.naznach-plat:CURSOR-OFFSET , length(tt-fin-doc.naznach-plat:screen-value)  -  tt-fin-doc.naznach-plat:CURSOR-OFFSET + 1)
     2035       tt-fin-doc.naznach-plat:CURSOR-OFFSET = v-offset - 1
     2036       .
     2037     end.
     2038   END.
     2039   ON DELETE-CHARACTER OF tt-fin-doc.naznach-plat IN FRAME Dialog-Frame
     2040   DO:
     2041   define variable v-offset as integer no-undo .
     2042     if tt-fin-doc.naznach-plat:selection-start = ? then do:
     2043       RUN proc-uho-check IN THIS-PROCEDURE(0) NO-ERROR.
     2044       IF ERROR-STATUS :ERROR THEN DO: RETURN NO-APPLY. END.
     2045       assign
     2046       v-offset = tt-fin-doc.naznach-plat:CURSOR-OFFSET
     2047       tt-fin-doc.naznach-plat:screen-value = substring(tt-fin-doc.naznach-plat:screen-value, 1, tt-fin-doc.naznach-plat:CURSOR-OFFSET - 1) +
     2048                         substring(tt-fin-doc.naznach-plat:screen-value, tt-fin-doc.naznach-plat:CURSOR-OFFSET + 1, length(tt-fin-doc.naznach-plat:screen-value)  -  tt-fin-doc.naznach-plat:CURSOR-OFFSET + 1)
     2049       tt-fin-doc.naznach-plat:CURSOR-OFFSET = v-offset
     2050       .
     2051     end.
     2052     else do:
     2053       IF  index(tt-fin-doc.naznach-plat:SCREEN-VALUE IN FRAME Dialog-Frame, "@") > 0 then do:
     2054         IF tt-fin-doc.naznach-plat:Selection-start >= index(tt-fin-doc.naznach-plat:SCREEN-VALUE, "@") + 1 THEN   do:
     2055           RETURN no-apply.
     2056         end.
     2057       END.
     2058       tt-fin-doc.naznach-plat:edit-clear().
     2059     end.
     2060   END.
     2061   ON CTRL-X OF tt-fin-doc.naznach-plat IN FRAME Dialog-Frame
     2062   DO:
     2063     IF  index(tt-fin-doc.naznach-plat:SCREEN-VALUE IN FRAME Dialog-Frame, "@") > 0 then do:
     2064       IF tt-fin-doc.naznach-plat:Selection-start >= index(tt-fin-doc.naznach-plat:SCREEN-VALUE, "@") + 1 THEN   do:
     2065         RETURN no-apply.
     2066       end.
     2067     END.
     2068     tt-fin-doc.naznach-plat:edit-cut().
     2069   END.
     2070   ON CTRL-V OF tt-fin-doc.naznach-plat IN FRAME Dialog-Frame
     2071   DO:
     2072     IF  index(tt-fin-doc.naznach-plat:SCREEN-VALUE IN FRAME Dialog-Frame, "@") > 0 then do:
     2073       IF tt-fin-doc.naznach-plat:Selection-start >= index(tt-fin-doc.naznach-plat:SCREEN-VALUE, "@") + 1 THEN   do:
     2074         RETURN no-apply.
     2075       end.
     2076     END.
     2077     tt-fin-doc.naznach-plat:edit-paste().
     2078   END.
     2079         procedure proc-uho-check :
     2080   DEFINE INPUT PARAMETER p-offset AS INTEGER NO-UNDO.
     2081     do
     2082     on error undo, return error
     2083     :
     2084       IF  index(tt-fin-doc.naznach-plat:SCREEN-VALUE IN FRAME Dialog-Frame, "@") > 0 then do:
     2085         IF (tt-fin-doc.naznach-plat:CURSOR-OFFSET >= index(tt-fin-doc.naznach-plat:SCREEN-VALUE, "@") + 1
     2086         AND p-offset = 0)
     2087         OR (tt-fin-doc.naznach-plat:CURSOR-OFFSET > index(tt-fin-doc.naznach-plat:SCREEN-VALUE, "@") + 1
     2088         AND p-offset = 1)  THEN   do:
     2089           RETURN ERROR.
     2090         end.
     2091       END.
     2092     end.
     2093   end procedure.
     2094   ON CHOOSE OF B-obj IN FRAME Dialog-Frame
     2095     DO:
     2096       define variable v-obj-type like ub.fin-doc.obj-type no-undo .
     2097       define variable v-obj-code like ub.fin-doc.obj-code no-undo .
     2098   define variable vss-include-info23 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2099   if lookup(self :type
     2100            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2101            ) = 0
     2102   then do:
     2103     message
     2104       "$Workfile$"
     2105       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2106       "Интерфейсный элемент" self :name  skip
     2107       "Тип" self :type  skip
     2108       "Процедура" this-procedure :file-name skip
     2109       view-as alert-box .
     2110   end.
     2111   else do:
     2112     apply "entry":u to self  .
     2113     if focus :handle <> self :handle  then do:
     2114       return no-apply .
     2115     end.
     2116   end.
     2117   run str/chshobj.w ( tt-fin-doc.host-code
     2118     , tt-fin-doc.obj-type
     2119     , tt-fin-doc.obj-code
     2120     , output v-obj-type
     2121     , output v-obj-code
     2122     ) no-error .
     2123   if error-status:error
     2124     or (
     2125     v-obj-type = tt-fin-doc.obj-type
     2126     AND v-obj-code = tt-fin-doc.obj-code)
     2127     or v-obj-code = 0
     2128     or v-obj-type = "":U
     2129     then
     2130   do:
     2131     return no-apply.
     2132   end.
     2133   find first X_clients-obj no-lock where
     2134     X_clients-obj.obj-type = v-obj-type
     2135     AND X_clients-obj.obj-code = v-obj-code .
     2136   assign
     2137     tt-fin-doc.obj-type = X_clients-obj.obj-type
     2138     tt-fin-doc.obj-code = X_clients-obj.obj-code
     2139     .
     2140   display
     2141     tt-fin-doc.obj-type
     2142     tt-fin-doc.obj-code
     2143     with frame Dialog-Frame.
     2144   run check-obj in this-procedure (  input tt-fin-doc.obj-type
     2145     ,input tt-fin-doc.obj-code
     2146     )
     2147     no-error.
     2148   END.
     2149   ON LEAVE OF tt-fin-doc.obj-code IN FRAME Dialog-Frame
     2150     DO:
     2151   define variable vss-include-info24 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2152   if lookup(self :type
     2153            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2154            ) = 0
     2155   then do:
     2156     message
     2157       "$Workfile$"
     2158       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2159       "Интерфейсный элемент" self :name  skip
     2160       "Тип" self :type  skip
     2161       "Процедура" this-procedure :file-name skip
     2162       view-as alert-box .
     2163   end.
     2164   else do:
     2165     apply "entry":u to self  .
     2166     if focus :handle <> self :handle  then do:
     2167       return no-apply .
     2168     end.
     2169   end.
     2170   if   input frame Dialog-Frame tt-fin-doc.obj-code <> 0 then
     2171   do:
     2172     run check-obj in this-procedure (
     2173       input frame Dialog-Frame tt-fin-doc.obj-type
     2174       ,input frame Dialog-Frame tt-fin-doc.obj-code
     2175       )
     2176       no-error.
     2177     if error-status:error then
     2178     do:
     2179       return no-apply.
     2180     end.
     2181   end.
     2182   END.
     2183   ON VALUE-CHANGED OF tt-fin-doc.obj-type IN FRAME Dialog-Frame
     2184     DO:
     2185       assign
     2186         tt-fin-doc.obj-type.
     2187       if   input frame Dialog-Frame tt-fin-doc.obj-code <> 0 then
     2188       do:
     2189         run check-obj in this-procedure (
     2190           input frame Dialog-Frame tt-fin-doc.obj-type
     2191           ,input frame Dialog-Frame tt-fin-doc.obj-code
     2192           )
     2193           no-error.
     2194         if error-status:error then
     2195         do:
     2196           return no-apply.
     2197         end.
     2198       end.
     2199     END.
     2200   PROCEDURE check-obj :
     2201     define input parameter p-check-obj-type as character no-undo .
     2202     define input parameter p-check-obj-code as integer no-undo .
     2203     define variable v-obj-db-num as integer no-undo init -1.
     2204     define variable v-cash-book  as integer no-undo .
     2205     define buffer buf_clients for ub.clients.
     2206     find first buf_clients no-lock where
     2207       buf_clients.obj-code = p-check-obj-code
     2208       and buf_clients.obj-type = p-check-obj-type no-error.
     2209     if not available buf_clients then
     2210     do:
     2211       if p-check-obj-code <> ?  then
     2212         message "Неправильный код или тип объекта" .
     2213       apply "entry" to tt-fin-doc.obj-code in frame Dialog-Frame.
     2214       return error.
     2215     end.
     2216     find first X_clients-obj no-lock where recid(X_clients-obj) = recid(buf_clients).
     2217     assign
     2218       tt-fin-doc.obj-type = buf_clients.obj-type
     2219       tt-fin-doc.obj-code = buf_clients.obj-code
     2220       .
     2221     display
     2222       tt-fin-doc.obj-type
     2223       tt-fin-doc.obj-code
     2224       with frame Dialog-Frame.
     2225     if not (tt-fin-doc.obj-type = '' and tt-fin-doc.obj-code = 0) then
     2226     do:
     2227   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2228   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     2229     (input  tt-fin-doc.obj-type
     2230     ,input  tt-fin-doc.obj-code
     2231     ,output v-obj-db-num
     2232     )  .
     2233       define variable l-shift-on as logical no-undo .
     2234   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2235   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2236     (input  tt-fin-doc.obj-type
     2237     ,input  tt-fin-doc.obj-code
     2238     ,input  'shift-on=request'
     2239     ,output l-shift-on
     2240     )  .
     2241       assign
     2242         tt-fin-doc.shift-flag = (if l-shift-on
     2243                                     and lookup(tt-fin-doc.fin-ext-doc-type, 'пко,рко':U) > 0
     2244                                     and (tt-fin-doc.doc-author = 'manual':U or tt-fin-doc.doc-author = 'auto':U)
     2245                                     and v-obj-db-num = v-cntxt-db-num
     2246                                     then integer('1':U)
     2247                                     else 0)
     2248         .
     2249       for each thbjattr_thbj-attr:
     2250         delete thbjattr_thbj-attr.
     2251       end.
     2252       define variable mCashBook         as class     ibs.th.ref.cashbookstorage no-undo .
     2253       define variable par-type          as character no-undo .
     2254       define variable v-dpt-option      as character no-undo .
     2255       define variable v-dpt-dflt-name   as character no-undo .
     2256       define variable v-dpt-dflt-type   as character no-undo .
     2257       define variable v-dpt-dflt-code   as integer   no-undo .
     2258       define variable v-value-character as character no-undo .
     2259       define variable v-value-date      as date      no-undo .
     2260       define variable v-value-decimal   as decimal   no-undo .
     2261       define variable v-value-integer   as INTEGER   no-undo .
     2262       define variable v-value-logical   AS LOGICAL   no-undo .
     2263       define variable v-tth             as handle    no-undo .
     2264       define variable v-naznach-plat    as character no-undo .
     2265       define variable v-enclosure       as character no-undo .
     2266       define variable o-head-position   as character no-undo .
     2267       define variable o-director        as character no-undo .
     2268       define variable o-snr-accnt       as character no-undo .
     2269       define variable o-cashier         as character no-undo .
     2270       define variable v-head-position   as character no-undo .
     2271       define variable v-director        as character no-undo .
     2272       define variable v-snr-accnt       as character no-undo .
     2273       define variable v-cashier         as character no-undo .
     2274       define variable v-hist-code       as character no-undo .
     2275       define variable v-hist-name       as character no-undo .
     2276       define buffer buf_sysconf for ub.sysconf.
     2277       define buffer buf_shop    for ub.shop .
     2278       define buffer buf_store   for ub.store .
     2279       define buffer buf_firm    for ub.firm .
     2280       assign
     2281         v-tth = buffer thbjattr_thbj-attr:table-handle .
     2282       mCashBook = new ibs.th.ref.cashbookstorage () .
     2283       v-dpt-option    = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "Struct") .
     2284       v-dpt-dflt-name = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "DptName") .
     2285       v-dpt-dflt-type = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "DptType") .
     2286       v-dpt-dflt-code = integer(mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "DptCode")) .
     2287       o-head-position = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "ManagerPosition") .
     2288       o-director      = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "ManagerFIO") .
     2289       o-snr-accnt     = mCashBook:getSinglRule(tt-fin-doc.CashBookId, tt-fin-doc.obj-type, tt-fin-doc.obj-code, "BuhFIO") .
     2290       delete object mCashBook no-error .
     2291       case v-dpt-option:
     2292         when "1" then
     2293           do:
     2294             for first ub.db-attr no-lock where ub.db-attr.db-num = v-cntxt-db-num
     2295             and ub.db-attr.attr-code = 'hist-code':U:
     2296               v-hist-code = ub.db-attr.attr-value .
     2297             end.
     2298             for first ub.db-attr no-lock where ub.db-attr.db-num = v-cntxt-db-num
     2299             and ub.db-attr.attr-code = 'hist-name':U:
     2300               v-hist-name = ub.db-attr.attr-value .
     2301             end.
     2302             if v-hist-code = "" then v-dpt-dflt-code = X_clients-obj.obj-code .
     2303             if v-hist-name = "" then v-dpt-dflt-name = X_clients-obj.obj-name .
     2304             v-dpt-dflt-type = X_clients-obj.obj-type  .
     2305           end.
     2306         when "0" then
     2307           do:
     2308             assign
     2309               v-dpt-dflt-name = ''
     2310               v-dpt-dflt-type = ''
     2311               v-dpt-dflt-code = 0
     2312               .
     2313           end.
     2314         otherwise
     2315         do:
     2316           assign
     2317             v-dpt-dflt-name = v-dpt-dflt-name
     2318             v-dpt-dflt-type = v-dpt-dflt-type
     2319             v-dpt-dflt-code = v-dpt-dflt-code
     2320             .
     2321         end.
     2322       end case.
     2323       find first buf_sysconf no-error .
     2324       case o-head-position:
     2325         when '0':U then
     2326           do:
     2327             v-head-position = buf_sysconf.head-position.
     2328           end.
     2329         when '1':U then
     2330           do:
     2331             v-head-position = "Директор".
     2332           end.
     2333         when '2':U then
     2334           do:
     2335             v-head-position = "Управляющий".
     2336           end.
     2337         otherwise
     2338         do :
     2339           v-head-position = o-head-position.
     2340         end.
     2341       end case.
     2342       find first buf_firm no-lock where
     2343         buf_firm.firm-code = buf_sysconf.host-code.
     2344       case o-director:
     2345         when '1':U then
     2346           do:
     2347             if p-obj-type = 'маг':U then
     2348             do:
     2349               find first buf_shop no-lock where
     2350                 buf_shop.obj-code = p-obj-code no-error .
     2351               if available buf_shop then
     2352               do:
     2353                 v-director = buf_shop.director.
     2354               end.
     2355             end.
     2356             if p-obj-type = 'скл':U then
     2357             do:
     2358               find first buf_store no-lock where
     2359                 buf_store.obj-code = p-obj-code no-error .
     2360               if available buf_store then
     2361               do:
     2362                 v-director = buf_store.store-boss.
     2363               end.
     2364             end.
     2365           end.
     2366         when '0':U then
     2367           do:
     2368             v-director = buf_firm.director.
     2369           end.
     2370         otherwise
     2371         do:
     2372           v-director = o-director .
     2373         end.
     2374       end case.
     2375       case o-snr-accnt:
     2376         when '1':U then
     2377           do:
     2378             if p-obj-type = 'маг':U then
     2379             do:
     2380               find first buf_shop no-lock where
     2381                 buf_shop.obj-code = p-obj-code no-error .
     2382               if available buf_shop then
     2383               do:
     2384                 v-snr-accnt = entry(1,buf_shop.acct,"|").
     2385               end.
     2386             end.
     2387             if p-obj-type = 'скл':U then
     2388             do:
     2389               v-snr-accnt = ''.
     2390             end.
     2391           end.
     2392         when '2':U then
     2393           do:
     2394             v-snr-accnt = buf_sysconf.snr-accnt.
     2395           end.
     2396         otherwise
     2397         do:
     2398           v-snr-accnt = o-snr-accnt .
     2399         end.
     2400       end case.
     2401     FIND FIRST ub.shift-staff No-LOCK WHERE
     2402       ub.shift-staff.obj-type   = p-obj-type AND
     2403       ub.shift-staff.obj-code   = p-obj-code AND
     2404       ub.shift-staff.shift-date = tt-fin-doc.shift-date AND
     2405       ub.shift-staff.shift-num  = tt-fin-doc.shift-num AND
     2406       ub.shift-staff.staff-role = no and
     2407       ub.shift-staff.psn-num    >= 0 No-ERROR.
     2408     assign
     2409       v-cashier = if available ub.shift-staff then string(ub.shift-staff.name, "X(30)") else "".
     2410     .
     2411     if tt-fin-doc.fin-ext-doc-type = 'рко':U then
     2412     do:
     2413       assign
     2414         tt-fin-doc.payer-sign1 = v-director
     2415         tt-fin-doc.payer-sign2 = v-snr-accnt
     2416         tt-fin-doc.payer-sign3 = v-cashier
     2417         .
     2418     end.
     2419     if tt-fin-doc.fin-ext-doc-type = 'пко':U then
     2420     do:
     2421       assign
     2422         tt-fin-doc.receiver-sign2 = v-snr-accnt
     2423         tt-fin-doc.receiver-sign3 = v-cashier
     2424         .
     2425     end.
     2426     find first ub.CashBook no-lock where ub.CashBook.id = tt-fin-doc.CashBookId no-error .
     2427     if available (ub.CashBook) then
     2428     do:
     2429       case ub.CashBook.RuleOsnRko:
     2430         when "0" then
     2431           tt-fin-doc.naznach-plat = "Выручка от реализации" .
     2432         when "1" or
     2433         when "2" then
     2434           tt-fin-doc.naznach-plat = "" .
     2435         otherwise
     2436         tt-fin-doc.naznach-plat = ub.CashBook.RuleOsnRko .
     2437       end case .
     2438       case ub.CashBook.RulePril:
     2439         when '0' then
     2440           do:
     2441             tt-fin-doc.enclosure = v-naznach-plat .
     2442           end.
     2443         when '1' then
     2444           do:
     2445             tt-fin-doc.enclosure = "" .
     2446           end.
     2447         otherwise
     2448         tt-fin-doc.enclosure = ub.CashBook.RulePril .
     2449       end case.
     2450       if ub.CashBook.CorrRko <> "" then
     2451       do:
     2452         for first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.code-value = ub.CashBook.CorrRko
     2453           and ub.fin-code-cor-acc.host-code = p-curr-host-code :
     2454           tt-fin-doc.cor-acc = ub.fin-code-cor-acc.fin-code .
     2455           tt-fin-doc.cor-acc-value = ub.fin-code-cor-acc.code-value .
     2456         end.
     2457       end.
     2458       if tt-fin-doc.cor-acc = ? or tt-fin-doc.cor-acc = 0 then
     2459       do:
     2460         for first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.code-value = "57.01"
     2461           and ub.fin-code-cor-acc.host-code = p-curr-host-code :
     2462           tt-fin-doc.cor-acc = ub.fin-code-cor-acc.fin-code .
     2463           tt-fin-doc.cor-acc-value = ub.fin-code-cor-acc.code-value .
     2464         end.
     2465       end.
     2466       if ub.CashBook.OsnAcct <> "" then
     2467       do:
     2468         for first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.code-value = ub.CashBook.OsnAcct
     2469           and ub.fin-code-cor-acc.host-code = p-curr-host-code :
     2470           tt-fin-doc.cor-acc1 = ub.fin-code-cor-acc.fin-code .
     2471           tt-fin-doc.cor-acc1-value = ub.fin-code-cor-acc.code-value .
     2472         end.
     2473       end.
     2474     end.
     2475     assign
     2476       tt-fin-doc.str-podr-name = if v-hist-name = "" then v-dpt-dflt-name else v-hist-name
     2477       tt-fin-doc.str-podr-type = v-dpt-dflt-type
     2478       tt-fin-doc.str-podr-code = v-dpt-dflt-code
     2479       .
     2480     display
     2481       tt-fin-doc.str-podr-name
     2482       tt-fin-doc.str-podr-type
     2483       tt-fin-doc.str-podr-code
     2484       tt-fin-doc.enclosure
     2485       tt-fin-doc.naznach-plat
     2486       tt-fin-doc.cor-acc
     2487       tt-fin-doc.cor-acc1
     2488       tt-fin-doc.cor-acc1-value
     2489       tt-fin-doc.cor-acc-value
     2490       with frame Dialog-Frame .
     2491     end.
     2492     else
     2493     do:
     2494       assign
     2495         tt-fin-doc.shift-flag = 0
     2496         .
     2497     end.
     2498   END PROCEDURE.
     2499   ON CHOOSE OF B-calc IN FRAME Dialog-Frame
     2500     DO:
     2501       run ref/findclci.w (
     2502         INPUT          parParentProc
     2503         ,input          "":U
     2504         ,INPUT          tt-fin-doc.doc-date
     2505         ,INPUT          tt-fin-doc.curr-code
     2506         ,INPUT          v-base-code
     2507         ,INPUT          tt-fin-doc.contract-curr
     2508         ,INPUT-OUTPUT   tt-fin-doc.sum-doc
     2509         ,INPUT-OUTPUT   tt-fin-doc.exch-rate
     2510         ,INPUT-OUTPUT   tt-fin-doc.exch-scale
     2511         ,INPUT-OUTPUT   tt-fin-doc.sum-rubl
     2512         ,INPUT-OUTPUT   tt-fin-doc.sum-base
     2513         ,INPUT-OUTPUT   tt-fin-doc.base-rate
     2514         ,INPUT-OUTPUT   tt-fin-doc.base-scale
     2515         ,INPUT-OUTPUT   tt-fin-doc.sum-contr
     2516         ,INPUT-OUTPUT   tt-fin-doc.contract-rate
     2517         ,INPUT-OUTPUT   tt-fin-doc.contract-scale ) no-error.
     2518       if error-status:error then return no-apply.
     2519       assign
     2520         f-rest-con-sum = tt-fin-doc.sum-contr - tt-fin-doc.con-sum-contr
     2521         .
     2522       display
     2523         tt-fin-doc.sum-rubl
     2524         when v-rubf
     2525         tt-fin-doc.sum-doc
     2526         tt-fin-doc.exch-rate
     2527         when v-exchf
     2528         tt-fin-doc.exch-scale
     2529         when v-exchf
     2530         tt-fin-doc.sum-base
     2531         when v-basef
     2532         tt-fin-doc.base-rate
     2533         when v-baseratef
     2534         tt-fin-doc.base-scale
     2535         when v-baseratef
     2536         tt-fin-doc.sum-contr
     2537         when v-contractf
     2538         tt-fin-doc.contract-rate
     2539         when v-contractratef
     2540         tt-fin-doc.contract-scale
     2541         when v-contractratef
     2542         f-rest-con-sum
     2543         with frame Dialog-Frame .
     2544     END.
     2545   ON CHOOSE OF B-payer-schet IN FRAME Dialog-Frame
     2546     DO:
     2547       define variable v-rid-list as character no-undo.
     2548       define variable ref-rec    as recid     no-undo.
     2549       define variable v-status_  like ub.fin-schet.status_ no-undo init 'тек':U.
     2550       define buffer buf_fin-schet for ub.fin-schet .
     2551   define variable vss-include-info27 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2552   if lookup(self :type
     2553            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2554            ) = 0
     2555   then do:
     2556     message
     2557       "$Workfile$"
     2558       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2559       "Интерфейсный элемент" self :name  skip
     2560       "Тип" self :type  skip
     2561       "Процедура" this-procedure :file-name skip
     2562       view-as alert-box .
     2563   end.
     2564   else do:
     2565     apply "entry":u to self  .
     2566     if focus :handle <> self :handle  then do:
     2567       return no-apply .
     2568     end.
     2569   end.
     2570   if available X_payer-fin-schet then
     2571     assign
     2572       v-rid-list = string(recid(X_payer-fin-schet))
     2573       v-status_  = X_payer-fin-schet.status_
     2574       .
     2575   run ref/finschts.w (
     2576     INPUT parParentProc
     2577     ,p-curr-host-code
     2578     ,input "b-sel,b-add":U
     2579     ,input "company-host":U
     2580     ,input 'орг':U
     2581     ,input p-host-code
     2582     ,input ?
     2583     ,input tt-fin-doc.host-code
     2584     ,input 0
     2585     ,input-output v-status_
     2586     ,input-output v-rid-list
     2587     ) no-error.
     2588   if v-rid-list = "" then
     2589   do:
     2590     apply "entry" to b-payer-schet in frame Dialog-Frame.
     2591     return no-apply.
     2592   end.
     2593   ref-rec = integer( v-rid-list ).
     2594   FIND FIRST buf_fin-schet WHERE
     2595     recid (buf_fin-schet) = ref-rec NO-LOCK  .
     2596   if buf_fin-schet.curr-code <> tt-fin-doc.curr-code then
     2597   do:
     2598     message
     2599       "Валюта выбранного Вами счета" 'ПЛАТЕЛЬЩИКА' "не совпадает с валютой платежа"
     2600       view-as alert-box error .
     2601     return no-apply.
     2602   end.
     2603   if buf_fin-schet.status_ <> 'тек':U then
     2604   do:
     2605     message
     2606       "Статус выбранного Вами счета" 'ПЛАТЕЛЬЩИКА' buf_fin-schet.status_ " - нельзя работать с таким счетом"
     2607       view-as alert-box error .
     2608     return no-apply.
     2609   end.
     2610   FIND FIRST X_payer-fin-schet WHERE
     2611     recid (X_payer-fin-schet) = ref-rec NO-LOCK  .
     2612   find first X_payer-fin-bank no-lock where
     2613     X_payer-fin-bank.host-code = tt-fin-doc.host-code
     2614     AND X_payer-fin-bank.code-bank = X_payer-fin-schet.code-bank .
     2615   assign
     2616     tt-fin-doc.payer-bank-name  = X_payer-fin-bank.bank-name
     2617     tt-fin-doc.payer-bank-city  = X_payer-fin-bank.bank-city
     2618     tt-fin-doc.payer-dop1       = X_payer-fin-schet.dop1
     2619     tt-fin-doc.payer-dop2       = X_payer-fin-schet.dop2
     2620     tt-fin-doc.payer-bik        = X_payer-fin-bank.bik
     2621     tt-fin-doc.payer-c-schet    = X_payer-fin-schet.c-schet
     2622     tt-fin-doc.payer-r-schet    = X_payer-fin-schet.r-schet
     2623     tt-fin-doc.payer-code-schet = X_payer-fin-schet.code-schet
     2624     .
     2625   display
     2626     tt-fin-doc.payer-bank-name
     2627     tt-fin-doc.payer-bank-city
     2628     tt-fin-doc.payer-bik
     2629     tt-fin-doc.payer-c-schet
     2630     tt-fin-doc.payer-r-schet
     2631     with frame Dialog-Frame.
     2632   END.
     2633   ON CHOOSE OF B-receiver IN FRAME Dialog-Frame
     2634     DO:
     2635       define variable ref-list as character no-undo.
     2636       define variable ref-rec  as recid     no-undo.
     2637       define variable v-sum-vat-chr  as character no-undo .
     2638       define variable v-each-vat-chr as character no-undo.
     2639       define variable v-sum-vat      like ub.fin-doc-tax.sum-vat-line-doc no-undo .
     2640       define buffer buf_clients for ub.clients.
     2641   define variable vss-include-info28 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2642   if lookup(self :type
     2643            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2644            ) = 0
     2645   then do:
     2646     message
     2647       "$Workfile$"
     2648       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2649       "Интерфейсный элемент" self :name  skip
     2650       "Тип" self :type  skip
     2651       "Процедура" this-procedure :file-name skip
     2652       view-as alert-box .
     2653   end.
     2654   else do:
     2655     apply "entry":u to self  .
     2656     if focus :handle <> self :handle  then do:
     2657       return no-apply .
     2658     end.
     2659   end.
     2660   run ref/cli-all.w ( parParentProc
     2661     ,"b-sel"
     2662     , tt-fin-doc.receiver-type
     2663     , ?
     2664     , ?
     2665     , (if available X_receiver then recid(X_receiver) else ?)
     2666     , ?
     2667     , "without-obj":U
     2668     , output ref-list) .
     2669   if ref-list = "" then
     2670   do:
     2671     return no-apply.
     2672   end.
     2673   ref-rec = integer( ref-list ).
     2674   FIND FIRST buf_clients WHERE recid (buf_clients) = ref-rec NO-LOCK .
     2675   if NOT (buf_clients.obj-type = 'орг':U
     2676     or
     2677     buf_clients.obj-type = 'чел':U ) then
     2678   do:
     2679     message
     2680       "Выберите контрагента типа" 'орг':U "или" 'чел':U
     2681       view-as alert-box error .
     2682     return no-apply.
     2683   end.
     2684   find first X_receiver no-lock where
     2685     recid(X_receiver) = recid(buf_clients).
     2686   assign
     2687     tt-fin-doc.receiver-type = buf_clients.obj-type
     2688     tt-fin-doc.receiver-code = buf_clients.obj-code
     2689     tt-fin-doc.receiver-name = buf_clients.obj-name
     2690     .
     2691   display
     2692     tt-fin-doc.receiver-type
     2693     tt-fin-doc.receiver-code
     2694     tt-fin-doc.receiver-name
     2695     with frame Dialog-Frame.
     2696   define variable v-recid-schet as recid no-undo . define variable v-recid-bank as recid no-undo . CASE X_receiver.obj-type:   when 'чел':U then do:              find first X_receiver-person no-lock where               X_receiver-person.psn-code = X_receiver.obj-code .   end.   when 'орг':U then do:     find first X_receiver-firm no-lock where               X_receiver-firm.firm-code = X_receiver.obj-code .   end. END CASE.   assign   tt-fin-doc.receiver-type =  X_receiver.obj-type   tt-fin-doc.receiver-code = X_receiver.obj-code   tt-fin-doc.receiver-name = X_receiver.obj-name   tt-fin-doc.receiver-inn = (if X_receiver.obj-type = 'чел':U                             then X_receiver-person.inn                             else X_receiver-firm.inn                             )   tt-fin-doc.receiver-kpp = (if X_receiver.obj-type = 'чел':U                             then X_receiver-person.kpp                             else X_receiver-firm.kpp                             )   .   run get-single-schet in this-procedure (                                           input p-host-code                                           ,input X_receiver.obj-type                                           ,input X_receiver.obj-code                                           ,input tt-fin-doc.curr-code                                           ,output v-recid-schet                                           ,output v-recid-bank).   if v-recid-schet <> ? then do:     find first X_receiver-fin-schet no-lock where                 recid(X_receiver-fin-schet) = v-recid-schet.     find first X_receiver-fin-bank no-lock where                 recid(X_receiver-fin-bank) = v-recid-bank.     assign     tt-fin-doc.receiver-code-schet = X_receiver-fin-schet.code-schet     tt-fin-doc.receiver-bank-name = X_receiver-fin-bank.bank-name       tt-fin-doc.receiver-bank-city = X_receiver-fin-bank.bank-city       tt-fin-doc.receiver-dop1       = X_receiver-fin-schet.dop1     tt-fin-doc.receiver-dop2       = X_receiver-fin-schet.dop2     tt-fin-doc.receiver-bik = X_receiver-fin-bank.bik     tt-fin-doc.receiver-r-schet = X_receiver-fin-schet.r-schet     tt-fin-doc.receiver-c-schet = X_receiver-fin-schet.c-schet     .   end.   else do:     RELEASE X_receiver-fin-schet.     RELEASE X_receiver-fin-bank.     assign     tt-fin-doc.receiver-code-schet = 0     tt-fin-doc.receiver-bank-name = "":U     tt-fin-doc.receiver-bank-city = "":U     tt-fin-doc.receiver-dop1      = "":U     tt-fin-doc.receiver-dop2      = "":U     tt-fin-doc.receiver-bik = "":U     tt-fin-doc.receiver-r-schet = "":U     tt-fin-doc.receiver-c-schet = "":U     .   end. display tt-fin-doc.receiver-type tt-fin-doc.receiver-code tt-fin-doc.receiver-name tt-fin-doc.receiver-inn tt-fin-doc.receiver-kpp tt-fin-doc.receiver-bank-name tt-fin-doc.receiver-bank-city tt-fin-doc.receiver-bik tt-fin-doc.receiver-r-schet tt-fin-doc.receiver-c-schet with frame Dialog-Frame.
     2697   find first ub.CashBook no-lock where ub.CashBook.id = tt-fin-doc.cashbookId no-error .
     2698   if ub.CashBook.cli-code = tt-fin-doc.receiver-code and ub.CashBook.cli-type = tt-fin-doc.receiver-type then do:
     2699   assign
     2700     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     2701     tt-fin-doc.cor-acc-value  = ub.CashBook.corrPko
     2702     tt-fin-doc.naznach-plat   = ub.CashBook.RuleOsnPko
     2703     .
     2704   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     2705     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     2706     and X_fin-code-cor-acc.status_ = integer('0':U)
     2707     no-error .
     2708   if available X_fin-code-cor-acc
     2709     then
     2710   do :
     2711     assign
     2712       f-cor-acc-descr    = X_fin-code-cor-acc.descr
     2713       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     2714       .
     2715   end.
     2716   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     2717     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     2718     and X_fin-code-cor-acc1.status_ = integer('0':U)
     2719     no-error .
     2720   if available X_fin-code-cor-acc1
     2721     then
     2722   do :
     2723     assign
     2724       f-cor-acc1-descr   = X_fin-code-cor-acc1.descr
     2725       tt-fin-doc.cor-acc = X_fin-code-cor-acc1.fin-code
     2726       .
     2727   end.
     2728   assign
     2729     tt-fin-doc.including = "@, в том числе НДС" .
     2730     paramVne = "" .
     2731   end.
     2732   else
     2733   do:
     2734     if getCliKassa(tt-fin-doc.receiver-type, tt-fin-doc.receiver-code, "Vnecli", tt-fin-doc.cashbookId) then do:
     2735   assign
     2736     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     2737     .
     2738   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     2739     and ub.CashBookRule.Obj-type   = 'всем':U
     2740     and ub.CashBookRule.Obj-code   = 0
     2741     and ub.CashBookRule.Code       = "corrPkoVne"
     2742     no-error.
     2743   if available (ub.CashBookRule) then tt-fin-doc.cor-acc-value = ub.CashBookRule.RuleValue .
     2744   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     2745     and ub.CashBookRule.Obj-type   = 'всем':U
     2746     and ub.CashBookRule.Obj-code   = 0
     2747     and ub.CashBookRule.Code       = "RuleOsnPkoVne"
     2748     no-error.
     2749   if available (ub.CashBookRule) then tt-fin-doc.naznach-plat = ub.CashBookRule.RuleValue .
     2750   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     2751     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     2752     and X_fin-code-cor-acc.status_ = integer('0':U)
     2753     no-error .
     2754   if available X_fin-code-cor-acc
     2755     then
     2756   do :
     2757     assign
     2758       f-cor-acc-descr    = X_fin-code-cor-acc.descr
     2759       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     2760       .
     2761   end.
     2762   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     2763     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     2764     and X_fin-code-cor-acc1.status_ = integer('0':U)
     2765     no-error .
     2766   if available X_fin-code-cor-acc1
     2767     then
     2768   do :
     2769     assign
     2770       f-cor-acc1-descr   = X_fin-code-cor-acc1.descr
     2771       tt-fin-doc.cor-acc = X_fin-code-cor-acc1.fin-code
     2772       .
     2773   end.
     2774   assign
     2775     tt-fin-doc.including = "@, в т.ч.: без налога (НДС)" .
     2776     paramVne = "vne" .
     2777   end.
     2778   else do:
     2779     if getCliKassa(tt-fin-doc.receiver-type, tt-fin-doc.receiver-code, "Avanscli", tt-fin-doc.cashbookId) then do:
     2780   assign
     2781     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     2782     .
     2783   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     2784     and ub.CashBookRule.Obj-type   = 'всем':U
     2785     and ub.CashBookRule.Obj-code   = 0
     2786     and ub.CashBookRule.Code       = "corrPkoAvans"
     2787     no-error.
     2788   if available (ub.CashBookRule) then tt-fin-doc.cor-acc-value = ub.CashBookRule.RuleValue .
     2789   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     2790     and ub.CashBookRule.Obj-type   = 'всем':U
     2791     and ub.CashBookRule.Obj-code   = 0
     2792     and ub.CashBookRule.Code       = "RuleOsnPkoAvans"
     2793     no-error.
     2794   if available (ub.CashBookRule) then tt-fin-doc.naznach-plat = ub.CashBookRule.RuleValue .
     2795   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     2796     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     2797     and X_fin-code-cor-acc.status_ = integer('0':U)
     2798     no-error .
     2799   if available X_fin-code-cor-acc
     2800     then
     2801   do :
     2802     assign
     2803       f-cor-acc-descr    = X_fin-code-cor-acc.descr
     2804       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     2805       .
     2806   end.
     2807   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     2808     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     2809     and X_fin-code-cor-acc1.status_ = integer('0':U)
     2810     no-error .
     2811   if available X_fin-code-cor-acc1
     2812     then
     2813   do :
     2814     assign
     2815       f-cor-acc1-descr   = X_fin-code-cor-acc1.descr
     2816       tt-fin-doc.cor-acc = X_fin-code-cor-acc1.fin-code
     2817       .
     2818   end.
     2819   assign
     2820     tt-fin-doc.including = "@, в т.ч. 22/122 (НДС)" .
     2821     paramVne = "avans" .
     2822   end.
     2823   else do:
     2824   tt-fin-doc.naznach-plat = "".
     2825   tt-fin-doc.including = "@, в том числе НДС" .
     2826   paramVne = "" .
     2827   end.
     2828   end.
     2829   end.
     2830   run proc-create-default-tax in this-procedure .
     2831   run change-view in this-procedure(rs-view).
     2832   END.
     2833   ON CHOOSE OF B-receiver-schet IN FRAME Dialog-Frame
     2834     DO:
     2835   define variable vss-include-info29 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2836   if lookup(self :type
     2837            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2838            ) = 0
     2839   then do:
     2840     message
     2841       "$Workfile$"
     2842       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2843       "Интерфейсный элемент" self :name  skip
     2844       "Тип" self :type  skip
     2845       "Процедура" this-procedure :file-name skip
     2846       view-as alert-box .
     2847   end.
     2848   else do:
     2849     apply "entry":u to self  .
     2850     if focus :handle <> self :handle  then do:
     2851       return no-apply .
     2852     end.
     2853   end.
     2854   define variable v-rid-list as character no-undo.
     2855   define variable ref-rec    as recid     no-undo.
     2856   define variable v-status_  like ub.fin-schet.status_ no-undo init 'тек':U.
     2857   define buffer buf_fin-schet for ub.fin-schet.
     2858   if not available X_receiver then
     2859   do:
     2860     message
     2861       "Не выбран" 'ПОЛУЧАТЕЛЬ'
     2862       view-as alert-box error .
     2863     return no-apply.
     2864   end.
     2865   if available X_receiver-fin-schet then
     2866     assign
     2867       v-rid-list = string(recid(X_receiver-fin-schet))
     2868       v-status_  = X_receiver-fin-schet.status_
     2869       .
     2870   run ref/finschts.w (
     2871     INPUT parParentProc
     2872     ,p-curr-host-code
     2873     ,input "b-sel,b-add":U
     2874     ,input "cmp-host":U
     2875     ,input X_receiver.obj-type
     2876     ,input X_receiver.obj-code
     2877     ,input ?
     2878     ,input tt-fin-doc.host-code
     2879     ,input 0
     2880     ,input-output v-status_
     2881     ,input-output v-rid-list
     2882     ) no-error.
     2883   if v-rid-list = "" then
     2884   do:
     2885     apply "entry" to b-receiver-schet in frame Dialog-Frame.
     2886     return no-apply.
     2887   end.
     2888   ref-rec = integer( v-rid-list ).
     2889   FIND FIRST buf_fin-schet WHERE
     2890     recid (buf_fin-schet) = ref-rec NO-LOCK  .
     2891   if tt-fin-doc.curr-code <> buf_fin-schet.curr-code then
     2892   do:
     2893     message
     2894       "Валюта выбранного Вами счета" 'ПОЛУЧАТЕЛЯ' "не совпадает с валютой платежа"
     2895       view-as alert-box error .
     2896     return no-apply.
     2897   end.
     2898   if buf_fin-schet.status_ <> 'тек':U then
     2899   do:
     2900     message
     2901       "Статус выбранного Вами счета" 'ПОЛУЧАТЕЛЯ' buf_fin-schet.status_ " - нельзя работать с таким счетом"
     2902       view-as alert-box error .
     2903     return no-apply.
     2904   end.
     2905   FIND FIRST X_receiver-fin-schet WHERE
     2906     recid (X_receiver-fin-schet) = ref-rec NO-LOCK .
     2907   find first X_receiver-fin-bank no-lock where
     2908     X_receiver-fin-bank.host-code = tt-fin-doc.host-code
     2909     AND X_receiver-fin-bank.code-bank = X_receiver-fin-schet.code-bank .
     2910   assign
     2911     tt-fin-doc.receiver-bank-name  = X_receiver-fin-bank.bank-name
     2912     tt-fin-doc.receiver-bank-city  = X_receiver-fin-bank.bank-city
     2913     tt-fin-doc.receiver-dop1       = X_receiver-fin-schet.dop1
     2914     tt-fin-doc.receiver-dop2       = X_receiver-fin-schet.dop2
     2915     tt-fin-doc.receiver-bik        = X_receiver-fin-bank.bik
     2916     tt-fin-doc.receiver-c-schet    = X_receiver-fin-schet.c-schet
     2917     tt-fin-doc.receiver-r-schet    = X_receiver-fin-schet.r-schet
     2918     tt-fin-doc.receiver-code-schet = X_receiver-fin-schet.code-schet
     2919     .
     2920   display
     2921     tt-fin-doc.receiver-bank-name
     2922     tt-fin-doc.receiver-bank-city
     2923     tt-fin-doc.receiver-bik
     2924     tt-fin-doc.receiver-c-schet
     2925     tt-fin-doc.receiver-r-schet
     2926     with frame Dialog-Frame.
     2927   END.
     2928   ON LEAVE OF tt-fin-doc.receiver-code IN FRAME Dialog-Frame
     2929     DO:
     2930   define variable vss-include-info30 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2931   if lookup(self :type
     2932            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     2933            ) = 0
     2934   then do:
     2935     message
     2936       "$Workfile$"
     2937       "Указанному интерфейсному элементу фокус не может быть передан" skip
     2938       "Интерфейсный элемент" self :name  skip
     2939       "Тип" self :type  skip
     2940       "Процедура" this-procedure :file-name skip
     2941       view-as alert-box .
     2942   end.
     2943   else do:
     2944     apply "entry":u to self  .
     2945     if focus :handle <> self :handle  then do:
     2946       return no-apply .
     2947     end.
     2948   end.
     2949   if   input frame Dialog-Frame tt-fin-doc.receiver-code <> 0 then
     2950   do:
     2951     run check-receiver in this-procedure no-error.
     2952     if error-status:error then
     2953     do:
     2954       return no-apply.
     2955     end.
     2956     define variable v-recid-schet as recid no-undo . define variable v-recid-bank as recid no-undo . CASE X_receiver.obj-type:   when 'чел':U then do:              find first X_receiver-person no-lock where               X_receiver-person.psn-code = X_receiver.obj-code .   end.   when 'орг':U then do:     find first X_receiver-firm no-lock where               X_receiver-firm.firm-code = X_receiver.obj-code .   end. END CASE.   assign   tt-fin-doc.receiver-type =  X_receiver.obj-type   tt-fin-doc.receiver-code = X_receiver.obj-code   tt-fin-doc.receiver-name = X_receiver.obj-name   tt-fin-doc.receiver-inn = (if X_receiver.obj-type = 'чел':U                             then X_receiver-person.inn                             else X_receiver-firm.inn                             )   tt-fin-doc.receiver-kpp = (if X_receiver.obj-type = 'чел':U                             then X_receiver-person.kpp                             else X_receiver-firm.kpp                             )   .   run get-single-schet in this-procedure (                                           input p-host-code                                           ,input X_receiver.obj-type                                           ,input X_receiver.obj-code                                           ,input tt-fin-doc.curr-code                                           ,output v-recid-schet                                           ,output v-recid-bank).   if v-recid-schet <> ? then do:     find first X_receiver-fin-schet no-lock where                 recid(X_receiver-fin-schet) = v-recid-schet.     find first X_receiver-fin-bank no-lock where                 recid(X_receiver-fin-bank) = v-recid-bank.     assign     tt-fin-doc.receiver-code-schet = X_receiver-fin-schet.code-schet     tt-fin-doc.receiver-bank-name = X_receiver-fin-bank.bank-name       tt-fin-doc.receiver-bank-city = X_receiver-fin-bank.bank-city       tt-fin-doc.receiver-dop1       = X_receiver-fin-schet.dop1     tt-fin-doc.receiver-dop2       = X_receiver-fin-schet.dop2     tt-fin-doc.receiver-bik = X_receiver-fin-bank.bik     tt-fin-doc.receiver-r-schet = X_receiver-fin-schet.r-schet     tt-fin-doc.receiver-c-schet = X_receiver-fin-schet.c-schet     .   end.   else do:     RELEASE X_receiver-fin-schet.     RELEASE X_receiver-fin-bank.     assign     tt-fin-doc.receiver-code-schet = 0     tt-fin-doc.receiver-bank-name = "":U     tt-fin-doc.receiver-bank-city = "":U     tt-fin-doc.receiver-dop1      = "":U     tt-fin-doc.receiver-dop2      = "":U     tt-fin-doc.receiver-bik = "":U     tt-fin-doc.receiver-r-schet = "":U     tt-fin-doc.receiver-c-schet = "":U     .   end. display tt-fin-doc.receiver-type tt-fin-doc.receiver-code tt-fin-doc.receiver-name tt-fin-doc.receiver-inn tt-fin-doc.receiver-kpp tt-fin-doc.receiver-bank-name tt-fin-doc.receiver-bank-city tt-fin-doc.receiver-bik tt-fin-doc.receiver-r-schet tt-fin-doc.receiver-c-schet with frame Dialog-Frame.
     2957   end.
     2958   END.
     2959   ON VALUE-CHANGED OF tt-fin-doc.receiver-type IN FRAME Dialog-Frame
     2960     DO:
     2961       assign
     2962         tt-fin-doc.receiver-type.
     2963       if   input frame Dialog-Frame tt-fin-doc.receiver-code <> 0 then
     2964       do:
     2965         run check-receiver in this-procedure no-error.
     2966         if error-status:error then
     2967         do:
     2968           return no-apply.
     2969         end.
     2970         define variable v-recid-schet as recid no-undo . define variable v-recid-bank as recid no-undo . CASE X_receiver.obj-type:   when 'чел':U then do:              find first X_receiver-person no-lock where               X_receiver-person.psn-code = X_receiver.obj-code .   end.   when 'орг':U then do:     find first X_receiver-firm no-lock where               X_receiver-firm.firm-code = X_receiver.obj-code .   end. END CASE.   assign   tt-fin-doc.receiver-type =  X_receiver.obj-type   tt-fin-doc.receiver-code = X_receiver.obj-code   tt-fin-doc.receiver-name = X_receiver.obj-name   tt-fin-doc.receiver-inn = (if X_receiver.obj-type = 'чел':U                             then X_receiver-person.inn                             else X_receiver-firm.inn                             )   tt-fin-doc.receiver-kpp = (if X_receiver.obj-type = 'чел':U                             then X_receiver-person.kpp                             else X_receiver-firm.kpp                             )   .   run get-single-schet in this-procedure (                                           input p-host-code                                           ,input X_receiver.obj-type                                           ,input X_receiver.obj-code                                           ,input tt-fin-doc.curr-code                                           ,output v-recid-schet                                           ,output v-recid-bank).   if v-recid-schet <> ? then do:     find first X_receiver-fin-schet no-lock where                 recid(X_receiver-fin-schet) = v-recid-schet.     find first X_receiver-fin-bank no-lock where                 recid(X_receiver-fin-bank) = v-recid-bank.     assign     tt-fin-doc.receiver-code-schet = X_receiver-fin-schet.code-schet     tt-fin-doc.receiver-bank-name = X_receiver-fin-bank.bank-name       tt-fin-doc.receiver-bank-city = X_receiver-fin-bank.bank-city       tt-fin-doc.receiver-dop1       = X_receiver-fin-schet.dop1     tt-fin-doc.receiver-dop2       = X_receiver-fin-schet.dop2     tt-fin-doc.receiver-bik = X_receiver-fin-bank.bik     tt-fin-doc.receiver-r-schet = X_receiver-fin-schet.r-schet     tt-fin-doc.receiver-c-schet = X_receiver-fin-schet.c-schet     .   end.   else do:     RELEASE X_receiver-fin-schet.     RELEASE X_receiver-fin-bank.     assign     tt-fin-doc.receiver-code-schet = 0     tt-fin-doc.receiver-bank-name = "":U     tt-fin-doc.receiver-bank-city = "":U     tt-fin-doc.receiver-dop1      = "":U     tt-fin-doc.receiver-dop2      = "":U     tt-fin-doc.receiver-bik = "":U     tt-fin-doc.receiver-r-schet = "":U     tt-fin-doc.receiver-c-schet = "":U     .   end. display tt-fin-doc.receiver-type tt-fin-doc.receiver-code tt-fin-doc.receiver-name tt-fin-doc.receiver-inn tt-fin-doc.receiver-kpp tt-fin-doc.receiver-bank-name tt-fin-doc.receiver-bank-city tt-fin-doc.receiver-bik tt-fin-doc.receiver-r-schet tt-fin-doc.receiver-c-schet with frame Dialog-Frame.
     2971       end.
