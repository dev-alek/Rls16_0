     3125     DO:
     3126   define buffer buf_clients for ub.clients .
     3127   assign tt-fin-doc.payer-code .
     3128   if tt-fin-doc.payer-code = 0 then leave.
     3129   FIND FIRST buf_clients WHERE buf_clients.obj-code = tt-fin-doc.payer-code
     3130   and buf_clients.obj-type = tt-fin-doc.payer-type NO-LOCK .
     3131   if NOT available (buf_clients) then
     3132   do:
     3133     message
     3134       "Выберите контрагента типа" 'орг':U "или" 'чел':U
     3135       view-as alert-box error .
     3136     return no-apply.
     3137   end.
     3138   find first X_receiver no-lock where
     3139     recid(X_receiver) = recid(buf_clients).
     3140   assign
     3141     tt-fin-doc.receiver-type = buf_clients.obj-type
     3142     tt-fin-doc.receiver-code = buf_clients.obj-code
     3143     tt-fin-doc.receiver-name = buf_clients.obj-name
     3144     .
     3145   display
     3146     tt-fin-doc.receiver-type
     3147     tt-fin-doc.receiver-code
     3148     tt-fin-doc.receiver-name
     3149     with frame Dialog-Frame.
