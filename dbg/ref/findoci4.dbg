     3270       tt-fin-doc.cor-acc = X_fin-code-cor-acc1.fin-code
     3271       .
     3272   end.
     3273   assign
     3274     tt-fin-doc.including = "@, в т.ч. 22/122 (НДС)" .
     3275     paramVne = "avans" .
     3276   end.
     3277   else do:
