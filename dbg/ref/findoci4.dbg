    = X_receiver-fin-schet.dop2     tt-fin-doc.receiver-bik = X_receiver-fin-bank.bik     tt-fin-doc.receiver-r-schet = X_receiver-fin-schet.r-schet     tt-fin-doc.receiver-c-schet = X_receiver-fin-schet.c-schet     .   end.   else do:     RELEASE X_receiver-fin-schet.     RELEASE X_receiver-fin-bank.     assign     tt-fin-doc.receiver-code-schet = 0     tt-fin-doc.receiver-bank-name = "":U     tt-fin-doc.receiver-bank-city = "":U     tt-fin-doc.receiver-dop1      = "":U     tt-fin-doc.receiver-dop2      = "":U     tt-fin-doc.receiver-bik = "":U     tt-fin-doc.receiver-r-schet = "":U     tt-fin-doc.receiver-c-schet = "":U     .   end. display tt-fin-doc.receiver-type tt-fin-doc.receiver-code tt-fin-doc.receiver-name tt-fin-doc.receiver-inn tt-fin-doc.receiver-kpp tt-fin-doc.receiver-bank-name tt-fin-doc.receiver-bank-city tt-fin-doc.receiver-bik tt-fin-doc.receiver-r-schet tt-fin-doc.receiver-c-schet with frame Dialog-Frame.
     3151   find first ub.CashBook no-lock where ub.CashBook.id = tt-fin-doc.cashbookId no-error .
