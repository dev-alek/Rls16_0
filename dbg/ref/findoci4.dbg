     5605   tt-fin-doc.vid-plat:list-items = 'почтой,телеграфом,электронно,':U
     5606   rs-view = v-view
     5607   v-an-uchet-tab-order = (if X_sysconf.is-corr-acc then "cor-acc-value,b-cor-acc," else "":U) +
     5608                          (if X_sysconf.is-an-uchet then "an-uchet-value,b-an-uchet," else "":U) +
     5609                          (if X_sysconf.is-code-cel-nazn then "cel-nazn-value,b-cel-nazn," else "":U)
     5610   v-an-uchet-tab-order = "cor-acc-value,b-cor-acc,"  +
     5611                          "an-uchet-value,b-an-uchet," +
     5612                          "cel-nazn-value,b-cel-nazn,"
