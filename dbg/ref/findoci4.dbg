      923   function getCliKassa returns logical (input p-type as character, input p-code as integer, input p-attr as character, cashbookId as integer) :
      924   define buffer bf_CashBookRule  for ub.CashBookRule .
      925   define buffer buf_CashBookRule for ub.CashBookRule .
      926   find first bf_CashBookRule no-lock where bf_CashBookRule.CashBookID = cashbookId
      927     and bf_CashBookRule.Obj-type   = 'всем':U
      928     and bf_CashBookRule.Obj-code   = 0
      929     and bf_CashBookRule.Code       = p-attr + "-type"
      930     no-error.
      931   if available (bf_CashBookRule) then
      932   do:
      933     if p-type = bf_CashBookRule.RuleValue then
      934     do:
      935       find first buf_CashBookRule no-lock where buf_CashBookRule.CashBookID = cashbookId
      936         and buf_CashBookRule.Obj-type   = 'всем':U
      937         and buf_CashBookRule.Obj-code   = 0
      938         and buf_CashBookRule.Code       = p-attr + "-code"
      939         no-error.
      940       if available (buf_CashBookRule) then do:
      941           if p-code = integer(buf_CashBookRule.RuleValue) then return true .
      942       end.
      943     end.
      944   end.
      945   return false .
      946   end function .
      947   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile: findocip.i $ $Revision: ff8019e24d02, 2996, rls $".
      948   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      949   procedure cur-time :
      950      define output parameter p-today as date      no-undo .
      951      define output parameter p-time  as integer   no-undo .
      952     do
      953     on error undo, return error
      954     :
      955       define variable v-date1 as date      no-undo .
      956       define variable v-date2 as date      no-undo .
      957       define variable v-time  as integer   no-undo .
      958       assign
      959         v-date1 = today
      960         v-time  = time
      961         v-date2 = today
      962       .
      963       if v-date1 <> v-date2
      964       then do:
      965         assign
      966           v-date1 = today
      967           v-time  = v-time
      968         .
      969       end.
      970       assign
      971         p-today = v-date1
      972         p-time  = v-time
      973       .
      974     end.
      975   end.
      976   function cur-time-date returns character
      977   :
      978     return string(today, '99/99/9999':U) .
      979   end.
      980   function cur-time-mjd returns decimal
      981   :
      982     define variable v-date as date      no-undo .
      983     define variable v-time as integer   no-undo .
      984     run cur-time in this-procedure
      985       (output v-date
      986       ,output v-time
      987       ) .
      988     return integer(v-date) - 2400002 + (v-time / 86400) .
      989   end.
      990   function cur-time-get-ending-index returns integer
      991   (input p-number as integer
      992   )
      993   :
      994     if p-number < 0
      995     or p-number = ?
      996     then do:
      997       return 1 .
      998     end.
      999     define variable v-rest as integer   no-undo .
     1000     assign
     1001       p-number = p-number modulo 100
     1002     .
     1003     if p-number < 20
     1004     then do:
     1005       assign
     1006         v-rest = p-number
     1007       .
     1008     end.
     1009     else do:
     1010       assign
     1011         v-rest = p-number modulo 10
     1012       .
     1013     end.
     1014     case v-rest :
     1015       when 1
     1016       then do:
     1017         return 2 .
     1018       end.
     1019       when 2 or
     1020       when 3 or
     1021       when 4
     1022       then do:
     1023         return 3 .
     1024       end.
     1025       otherwise do:
     1026         return 1 .
     1027       end.
     1028     end case .
     1029   end.
     1030   procedure cur-time-mjd-to-date :
     1031      define input  parameter i-mjd-diff as decimal no-undo.
     1032      define output parameter o-Date     as date    no-undo.
     1033      define output parameter o-Time     as integer no-undo.
     1034      define variable v-day-number as integer   no-undo .
     1035      if    i-mjd-diff < 0
     1036         or i-mjd-diff = ?
     1037      then do:
     1038         return "?" .
     1039      end.
     1040      assign
     1041         v-day-number = truncate(i-mjd-diff,0).
     1042         o-Date = date(v-day-number + 2400002).
     1043         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1044     .
     1045   end.
     1046   function cur-time-mjd-to-string returns character
     1047   (input p-mjd-diff as decimal
     1048   )
     1049   :
     1050     define variable v-day-number as integer   no-undo .
     1051     define variable v-seconds    as integer   no-undo .
     1052     define variable v-hour       as integer   no-undo .
     1053     define variable v-min        as integer   no-undo .
     1054     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1055     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1056     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1057     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1058     if p-mjd-diff < 0
     1059     or p-mjd-diff = ?
     1060     then do:
     1061       return "?" .
     1062     end.
     1063     assign
     1064       v-day-number = integer(truncate(p-mjd-diff,0))
     1065       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1066     .
     1067     if v-seconds > 86400
     1068     then do:
     1069       assign
     1070         v-seconds = 86400 - 1
     1071       .
     1072     end.
     1073     if v-seconds < 0
     1074     then do:
     1075       assign
     1076         v-seconds = 0
     1077       .
     1078     end.
     1079     assign
     1080       v-hour = truncate(v-seconds / 3600, 0)
     1081     .
     1082     assign
     1083       v-seconds = v-seconds modulo 3600
     1084     .
     1085     assign
     1086       v-min = truncate(v-seconds / 60, 0)
     1087     .
     1088     assign
     1089       v-seconds = v-seconds modulo 60
     1090     .
     1091     return
     1092         (if v-day-number <> 0
     1093           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1094           else ""
     1095         )
     1096       + (if v-day-number <> 0 or v-hour <> 0
     1097           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1098           else ""
     1099         )
     1100       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1101           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1102           else ""
     1103         )
     1104       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1105       .
     1106   end.
     1107   function cur-time-string returns character
     1108   :
     1109     define variable v-date as date      no-undo .
     1110     define variable v-time as integer   no-undo .
     1111     run cur-time in this-procedure
     1112       (output v-date
     1113       ,output v-time
     1114       ) .
     1115     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1116   end.
     1117   function cur-time-string-sec returns character
     1118   :
     1119     define variable v-date as date      no-undo .
     1120     define variable v-time as integer   no-undo .
     1121     run cur-time in this-procedure
     1122       (output v-date
     1123       ,output v-time
     1124       ) .
     1125     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1126   end.
     1127   function cur-time-custom  returns character
     1128   (input p-prefix as character
     1129   ,input p-date-format as character
     1130   ,input p-delimiter as character
     1131   ,input p-time-format as character
     1132   ,input p-suffix as character
     1133   )
     1134   :
     1135     define variable v-date as date      no-undo .
     1136     define variable v-time as integer   no-undo .
     1137     run cur-time in this-procedure
     1138       (output v-date
     1139       ,output v-time
     1140       ) .
     1141     return
     1142       p-prefix
     1143       + string(v-date, p-date-format)
     1144       + p-delimiter
     1145       + string(v-time, p-time-format)
     1146       + p-suffix
     1147       .
     1148   end.
     1149   function cur-time-print  returns character
     1150   :
     1151     define variable v-date as date      no-undo .
     1152     define variable v-time as integer   no-undo .
     1153     run cur-time in this-procedure
     1154       (output v-date
     1155       ,output v-time
     1156       ) .
     1157     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1158   end.
     1159   function cur-time-datetime returns datetime
     1160   :
     1161     define variable v-char as character no-undo .
     1162     define variable v-datetime as datetime no-undo .
     1163     v-char = cur-time-string().
     1164     v-datetime = datetime(v-char).
     1165     return  v-datetime.
     1166   end.
     1167   function cur-time-string-msec returns character
     1168   :
     1169     define variable v-date as datetime  no-undo .
     1170     v-date = now.
     1171     return string(v-date) .
     1172   end.
