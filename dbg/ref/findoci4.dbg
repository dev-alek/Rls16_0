     3622   ON CHOOSE OF B-currency IN FRAME Dialog-Frame
     3623     DO:
     3624       define variable rr          as recid no-undo.
     3625       define variable v-curr-code like ub.fin-doc.curr-code no-undo.
     3626   define variable vss-include-info37 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3627   if lookup(self :type
     3628            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
     3629            ) = 0
     3630   then do:
     3631     message
     3632       "$Workfile$"
     3633       "Указанному интерфейсному элементу фокус не может быть передан" skip
     3634       "Интерфейсный элемент" self :name  skip
     3635       "Тип" self :type  skip
     3636       "Процедура" this-procedure :file-name skip
     3637       view-as alert-box .
     3638   end.
     3639   else do:
     3640     apply "entry":u to self  .
     3641     if focus :handle <> self :handle  then do:
     3642       return no-apply .
     3643     end.
     3644   end.
     3645   assign
     3646     v-curr-code = tt-fin-doc.curr-code
     3647     tt-fin-doc.curr-code.
     3648   if available X_currency then rr = recid(X_currency).
     3649   else rr = ?.
     3650   run ref/currency.w (parparentproc, "b-sel", input-output rr ).
     3651   if rr <> ? then
     3652   do:
     3653     FIND FIRST X_currency WHERE
     3654       recid( X_currency ) = rr NO-LOCK .
     3655     assign
     3656       tt-fin-doc.curr-code = X_currency.curr-code
     3657       f-curr-abbr          = X_currency.curr-abbr
     3658       .
     3659     DISPLAY
     3660       tt-fin-doc.curr-code
     3661       f-curr-abbr
     3662       with frame Dialog-Frame .
     3663   end.
     3664   if tt-fin-doc.curr-code <> v-curr-code then
     3665   do:
     3666     run recalc in this-procedure("curr-code":U) no-error.
     3667     if error-status:error then
     3668     do:
