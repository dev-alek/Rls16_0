     3387   ON CHOOSE OF B-cashbook IN FRAME Dialog-Frame
     3388     DO:
     3389       define variable v-cb-brw as class ibs.th.ref.cashbookbrw no-undo .
     3390       v-cb-brw = new ibs.th.ref.cashbookbrw ( 'ВЫБОР':U, parparentproc ).
     3391       wait-for  v-cb-brw:ShowDialog() .
     3392       if v-cb-brw:out-list-id > ""
     3393         then
     3394       do :
     3395         find first ub.cashbook no-lock where ub.cashbook.id = int64(v-cb-brw:out-list-id) .
     3396         tt-fin-doc.cashbookId = ub.cashbook.id .
     3397         f-cashbook = ub.CashBook.CashBookName .
     3398         display
     3399           f-cashbook
     3400           with frame Dialog-Frame .
     3401         IF LOOKUP("update_prc-doc-code-mask", THIS-PROCEDURE:INTERNAL-ENTRIES) >  0
     3402           THEN
     3403           run update_prc-doc-code-mask (no).
     3404         run check-obj in this-procedure (   input tt-fin-doc.obj-type
     3405           ,input tt-fin-doc.obj-code
     3406           )
     3407           no-error.
     3408         find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = (if tt-fin-doc.fin-doc-type eq 'рко':U then ub.cashbook.corrRko else ub.cashbook.corrPko)
     3409           and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     3410           and X_fin-code-cor-acc.status_ = integer('0':U)
     3411           no-error .
     3412         if available X_fin-code-cor-acc
     3413           then
     3414         do :
     3415           assign
     3416             tt-fin-doc.cor-acc-value = X_fin-code-cor-acc.code-value
     3417             f-cor-acc-descr          = X_fin-code-cor-acc.descr
     3418             tt-fin-doc.cor-acc       = X_fin-code-cor-acc.fin-code
     3419             .
     3420         end.
     3421         else
     3422         do:
     3423           if ub.cashbook.corrRko = "" then
     3424           do:
     3425             for first ub.fin-code-cor-acc no-lock where ub.fin-code-cor-acc.code-value = "57.01"
     3426               and ub.fin-code-cor-acc.host-code = p-curr-host-code :
     3427               tt-fin-doc.cor-acc = ub.fin-code-cor-acc.fin-code .
     3428               tt-fin-doc.cor-acc-value = ub.fin-code-cor-acc.code-value .
     3429             end.
     3430           end.
     3431         end.
     3432         if ub.CashBook.OsnAcct <> "" then
     3433         do:
     3434           find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = ub.CashBook.OsnAcct
     3435             and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     3436             and X_fin-code-cor-acc.status_ = integer('0':U)
     3437             no-error .
     3438           if available X_fin-code-cor-acc
     3439             then
     3440           do :
     3441             assign
     3442               tt-fin-doc.cor-acc1-value = X_fin-code-cor-acc.code-value
     3443               f-cor-acc1-descr          = X_fin-code-cor-acc.descr
     3444               tt-fin-doc.cor-acc1       = X_fin-code-cor-acc.fin-code
     3445               .
     3446           end.
     3447           else
     3448           do:
     3449             assign
     3450               tt-fin-doc.cor-acc1-value = ""
     3451               f-cor-acc1-descr          = ""
     3452               tt-fin-doc.cor-acc1       = ?
     3453               .
     3454           end.
     3455         end.
     3456       end.
     3457       display
     3458         tt-fin-doc.cor-acc-value
     3459         f-cor-acc-descr
     3460         tt-fin-doc.cor-acc
     3461         tt-fin-doc.cor-acc1-value
     3462         f-cor-acc1-descr
     3463         tt-fin-doc.cor-acc1
     3464         with frame Dialog-Frame .
     3465     END.
