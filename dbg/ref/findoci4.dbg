     5363   PROCEDURE fill-main-table :
     5364   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5365   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     5366     (output v-db-num
     5367     )  .
     5368   define variable vss-include-info60 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5369   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     5370     (input  p-host-code
     5371     ,output v-base-code
     5372     )  .
     5373   for each tt-fin-doc:
     5374     delete tt-fin-doc.
     5375   end.
     5376   for each tt0-fin-doc-attr:
     5377     delete tt0-fin-doc-attr.
     5378   end.
     5379   for each tt0-fin-doc-tax:
     5380     delete tt0-fin-doc-tax.
     5381   end.
     5382   if p-mode = 'ИЗМЕНЕНИЕ':U
     5383   or p-mode = 'ПРОСМОТР':U
     5384   or p-mode = 'КОПИРОВАНИЕ':U
     5385   then do:
     5386     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
     5387       find first locked_fin-doc EXclusive-lock where
     5388                     recid(locked_fin-doc) = p-doc-rec no-wait no-error.
     5389       if locked locked_fin-doc then do:
     5390         message
     5391         substitute("Запись &1 занята", p-fin-doc-code)
     5392         view-as alert-box error .
     5393         undo, return error.
     5394       end.
     5395     end.
     5396     else do:
     5397       find first locked_fin-doc no-lock where
     5398                   recid(locked_fin-doc) = p-doc-rec no-error .
     5399         if not available locked_fin-doc then do:
     5400           find first locked_fin-doc no-lock where
     5401                       locked_fin-doc.host-code = p-host-code
     5402                   AND locked_fin-doc.fin-doc-code = p-fin-doc-code no-error .
     5403         end.
     5404     end.
     5405     if not available locked_fin-doc then do:
     5406       message
     5407       substitute("&1 &2 &3&4 Не найдена запись &5"
     5408                   ,vss-workfile
     5409                   ,vss-revision
     5410                   ,vss-description
     5411                   ,chr(10)
     5412                   ,p-fin-doc-code)
     5413       view-as alert-box error .
     5414       undo, return error.
     5415     end.
     5416     if p-mode = 'ИЗМЕНЕНИЕ':U
     5417     AND not (locked_fin-doc.status_ = 'новый':U
     5418               or locked_fin-doc.status_ = 'разрешен':U )
     5419     then do:
     5420       message
     5421       substitute("Финансовый документ &1 находится в статусе &2&3Изменение невозможно"
     5422                 ,p-fin-doc-code
     5423                 ,locked_fin-doc.status_
     5424                 ,chr(10))
     5425       view-as alert-box error .
     5426       undo, return error.
     5427     end.
     5428     create tt-fin-doc.
     5429     if p-mode = 'КОПИРОВАНИЕ':U then do:
     5430       buffer-copy locked_fin-doc
     5431       using
     5432       obj-type
     5433       obj-code
     5434       receiver-type
     5435       receiver-code
     5436       receiver-name
     5437       receiver-inn
     5438       receiver-kpp
     5439       receiver-code-schet
     5440       payer-type
     5441       payer-code
     5442       payer-name
     5443       payer-code-schet
     5444       payer-bank-name
     5445       payer-bank-city
     5446       payer-BIK
     5447       payer-INN
     5448       payer-KPP
     5449       payer-c-schet
     5450       payer-r-schet
     5451       payer-sign1
     5452       payer-sign2
     5453       receiver-bank-name
     5454       receiver-bank-city
     5455       receiver-BIK
     5456       receiver-c-schet
     5457       receiver-r-schet
     5458       an-uchet-code
     5459       an-uchet-value
     5460       cel-nazn-code
     5461       cel-nazn-value
     5462       contract-code
     5463       contract-curr
     5464       cor-acc-value
     5465       cor-acc
     5466       curr-code
     5467       naznach-plat
     5468       sum-doc
     5469       stat-pl
     5470       ocher-pl
     5471       CashBookId
     5472       to tt-fin-doc
     5473       assign
     5474       tt-fin-doc.host-code = p-host-code
     5475       .
     5476     end.
     5477     else do:
     5478       buffer-copy locked_fin-doc to tt-fin-doc.
     5479     end.
     5480   end.
     5481   if p-mode = 'ДОБАВЛЕНИЕ':U
     5482   or p-mode = 'КОПИРОВАНИЕ':U then do:
     5483     run ref/finfnoco.p (
     5484                     INPUT parParentProc
     5485                   ,INPUT this-procedure:handle
     5486                   ,input p-curr-host-code
     5487                   ,input p-mode  + chr(4) + 'manual':U
     5488                   ,input p-host-code
     5489                   ,input p-doc-rec
     5490                   ,input p-fin-doc-code
     5491                   ,input 'рпп':U
     5492                   ,input 'рпп':U
     5493                   ,input p-obj-type
     5494                   ,input p-obj-code
     5495                   ,input p-contract-code
     5496                   ,input p-ob-doc-code
     5497                   ,input 'орг':U
     5498                   ,input p-host-code
     5499                   ,input p-payer-code-schet
     5500                   ,input p-receiver-type
     5501                   ,input p-receiver-code
     5502                   ,input p-receiver-code-schet
     5503                   ,input p-curr-code
     5504                   ,input p-cor-acc
     5505                   ,input p-cor-acc1
     5506                   ,input p-an-uchet-code
     5507                   ,input p-cel-nazn-code
     5508                   ,input (if available tt-fin-doc then tt-fin-doc.CashBookId else 0)
     5509                   ,input ""
     5510                   ,INPUT-OUTPUT table tt-fin-doc
     5511                   ,INPUT-OUTPUT table ttc-fin-doc
     5512                   ,output table tt0-fin-doc-attr
     5513                   ,output v-limit-access ) no-error .
     5514   end.
     5515   else do:
     5516     run ref/finfnoco.p (
     5517                     INPUT parParentProc
     5518                   ,INPUT this-procedure:handle
     5519                   ,input p-curr-host-code
     5520                   ,input p-mode  + chr(4) + 'manual':U
     5521                   ,input p-host-code
     5522                   ,input p-doc-rec
     5523                   ,input tt-fin-doc.fin-doc-code
     5524                   ,input 'рпп':U
     5525                   ,input tt-fin-doc.fin-ext-doc-type
     5526                   ,input tt-fin-doc.obj-type
     5527                   ,input tt-fin-doc.obj-code
     5528                   ,input tt-fin-doc.contract-code
     5529                   ,input p-ob-doc-code
     5530                   ,input 'орг':U
     5531                   ,input p-host-code
     5532                   ,input tt-fin-doc.payer-code-schet
     5533                   ,input tt-fin-doc.receiver-type
     5534                   ,input tt-fin-doc.receiver-code
     5535                   ,input tt-fin-doc.receiver-code-schet
     5536                   ,input tt-fin-doc.curr-code
     5537                   ,input tt-fin-doc.cor-acc
     5538                   ,input tt-fin-doc.cor-acc1
     5539                   ,input tt-fin-doc.an-uchet-code
     5540                   ,input tt-fin-doc.cel-nazn-code
     5541                   ,input tt-fin-doc.CashBookId
     5542                   ,input ""
     5543                   ,INPUT-OUTPUT table ttc-fin-doc
     5544                   ,INPUT-OUTPUT table tt-fin-doc
     5545                   ,output table tt0-fin-doc-attr
     5546                   ,output v-limit-access ) no-error .
     5547   end.
     5548   if error-status:error then do:
     5549     if not return-value = "exit" then do:
     5550       message
     5551       vss-workfile vss-revision vss-description skip
     5552       error-status:get-message(1) skip
     5553       return-value
     5554       view-as alert-box .
     5555     end.
     5556     undo, return error.
     5557   end.
     5558   find first tt-fin-doc.
     5559   run recalc in this-procedure ( input "curr-code":U).
     5560   if p-mode = 'КОПИРОВАНИЕ':U then do:
     5561     assign
     5562     v-copy-mode = yes
     5563     p-mode = 'ДОБАВЛЕНИЕ':U.
     5564     if tt-fin-doc.curr-code = 0  then
     5565     run recalc in this-procedure ( input "sum-doc").
     5566   end.
     5567   END PROCEDURE.
     5568   PROCEDURE Myenable :
     5569   define variable v-inn like ub.firm.inn no-undo .
     5570   define variable v-kpp like ub.firm.kpp no-undo .
     5571   define variable g-log as logical no-undo.
     5572   tt-fin-doc.payer-inn:label in frame Dialog-Frame = "ИНН".
     5573   tt-fin-doc.receiver-inn:label in frame Dialog-Frame = "ИНН".
     5574   tt-fin-doc.payer-kpp:label in frame Dialog-Frame = "КПП".
     5575   tt-fin-doc.receiver-kpp:label in frame Dialog-Frame = "КПП".
     5576   assign
     5577       tt-fin-doc.sum-rubl :label in frame Dialog-Frame = "Рубли"
     5578   .
     5579   run uf-get in this-procedure(
     5580       input  ('findoci-p':U + chr(4) + 'рпп':U)
     5581       ,input  g#userid
     5582       ,output v-uf-List_
     5583       ,output v-uf-Naim
     5584       ,output v-uf-print-graft
     5585       ,output v-uf-sort-gr
     5586       ,output v-uf-type-price
     5587       ,output v-uf-type-val
     5588   )  no-error.
     5589   if not error-status:error
     5590   and not v-uf-LIst_ = "":U
     5591   then do:
     5592       assign
     5593       v-view =  entry(1, v-uf-List_, chr(4))
     5594       .
     5595   end.
     5596   assign
     5597   frame Dialog-Frame:title = frame Dialog-Frame:title + chr(32) + x_clients-host.obj-name
     5598   tt-fin-doc.receiver-type:radio-buttons = "Орг" + chr(44) + 'орг':U + chr(44) +
     5599                                            "Чел" + chr(44) + 'чел':U
     5600   rs-view:radio-buttons = "&Полн." + chr(44) + "full":U +  chr(44) +
     5601                                       "&Сокращ." + chr(44) + "brief":U + chr(44) +
     5602                                       "&Дог-р" + chr(44) + "contract":U
     5603   tt-fin-doc.obj-type:radio-buttons = "Маг" + chr(44) + 'маг':U + chr(44) +
