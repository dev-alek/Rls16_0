      125   define variable f-cor-acc1-descr as character no-undo .
      126   DEFINE TEMP-TABLE ttc-fin-doc NO-UNDO LIKE ub.fin-doc.
      127   define variable v-base-code like ub.sysconf.host-code no-undo.
      128   define variable v-tab-order as character no-undo.
      129   define variable v-an-uchet-tab-order as character no-undo.
      130   define variable v-sum-curr-tab-order as character no-undo.
      131   define variable v-contract-tab-order as character no-undo init "b-contract-view,":U.
