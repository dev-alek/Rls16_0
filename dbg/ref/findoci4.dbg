     3228   assign
     3229     tt-fin-doc.including = "@, в т.ч.: без налога (НДС)" .
     3230     paramVne = "vne" .
     3231   end.
     3232   else do:
     3233     if getCliKassa(tt-fin-doc.receiver-type, tt-fin-doc.receiver-code, "Avanscli", tt-fin-doc.cashbookId) then do:
     3234   assign
     3235     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     3236     .
     3237   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     3238     and ub.CashBookRule.Obj-type   = 'всем':U
     3239     and ub.CashBookRule.Obj-code   = 0
     3240     and ub.CashBookRule.Code       = "corrPkoAvans"
     3241     no-error.
     3242   if available (ub.CashBookRule) then tt-fin-doc.cor-acc-value = ub.CashBookRule.RuleValue .
     3243   find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = tt-fin-doc.cashbookId
     3244     and ub.CashBookRule.Obj-type   = 'всем':U
     3245     and ub.CashBookRule.Obj-code   = 0
     3246     and ub.CashBookRule.Code       = "RuleOsnPkoAvans"
     3247     no-error.
     3248   if available (ub.CashBookRule) then tt-fin-doc.naznach-plat = ub.CashBookRule.RuleValue .
     3249   find first X_fin-code-cor-acc no-lock where X_fin-code-cor-acc.code-value = tt-fin-doc.cor-acc-value
     3250     and X_fin-code-cor-acc.host-code = tt-fin-doc.host-code
     3251     and X_fin-code-cor-acc.status_ = integer('0':U)
     3252     no-error .
     3253   if available X_fin-code-cor-acc
     3254     then
     3255   do :
     3256     assign
