     5286       end.
     5287     end.
     5288     when "brief":U then do:
     5289        assign
     5290        v-tab-order = "b-exit,b-quit,b-tax,b-print,b-hist,b-help," +                              "prn-doc-code,vid-plat,doc-date," +                             "obj-type,obj-code,b-obj,b-payer-schet,b-payer-view," + v-sum-curr-tab-order +                             "receiver-type,receiver-code,b-receiver,receiver-name,b-receiver-schet,b-receiver-view," +                              "naznach-plat,PS,payer-sign1,payer-sign2"
     5291        .
     5292     end.
     5293     when "contract":U then do:
     5294       assign
     5295       v-tab-order = "b-exit,b-quit,b-tax,b-print,b-hist,b-help," +                             "prn-doc-code,vid-plat,doc-date,obj-type,obj-code,b-obj," +                              v-contract-tab-order +  "b-payer-schet,b-payer-view," + v-sum-curr-tab-order +                             "receiver-type,receiver-code,b-receiver,receiver-name,b-receiver-schet,b-receiver-view," +                              "naznach-plat,PS,payer-sign1,payer-sign2"
     5296       .
     5297       display
     5298       b-contract-view
     5299       f-contract-date when tt-fin-doc.contract-code <> 0
     5300       f-contract-prn-code when tt-fin-doc.contract-code <> 0
     5301       f-contract-type when tt-fin-doc.contract-code <> 0
     5302       f-contract-curr-abbr when tt-fin-doc.contract-code <> 0
     5303       tt-fin-doc.contract-curr when tt-fin-doc.contract-code <> 0
     5304       with frame Dialog-Frame
     5305       .
     5306       ENABLE
     5307       b-contract-view
     5308       with frame Dialog-Frame.
     5309     end.
     5310   END CASE.
     5311   END PROCEDURE.
     5312   PROCEDURE disable_UI :
     5313     HIDE FRAME Dialog-Frame.
     5314   END PROCEDURE.
