     3258       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     3259       .
     3260   end.
     3261   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     3262     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     3263     and X_fin-code-cor-acc1.status_ = integer('0':U)
     3264     no-error .
