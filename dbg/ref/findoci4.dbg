     3153   assign
     3154     tt-fin-doc.cor-acc1-value = ub.CashBook.OsnAcct
     3155     tt-fin-doc.cor-acc-value  = ub.CashBook.corrPko
     3156     tt-fin-doc.naznach-plat   = ub.CashBook.RuleOsnPko
     3157     .
