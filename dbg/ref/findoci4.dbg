     3167       tt-fin-doc.cor-acc = X_fin-code-cor-acc.fin-code
     3168       .
     3169   end.
     3170   find first X_fin-code-cor-acc1 no-lock where X_fin-code-cor-acc1.code-value = tt-fin-doc.cor-acc1-value
     3171     and X_fin-code-cor-acc1.host-code = tt-fin-doc.host-code
     3172     and X_fin-code-cor-acc1.status_ = integer('0':U)
