     4408     define variable v-contract-scale like ub.fin-doc.exch-scale no-undo.
     4409     if p-main-widget = "curr-code":u then
     4410     do:
     4411       assign
     4412         frame Dialog-Frame
     4413         tt-fin-doc.sum-doc
     4414         .
     4415   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
