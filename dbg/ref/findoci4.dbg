     5615                                       or tt-fin-doc.obj-type = 'скл':U
     5616                                       then tt-fin-doc.obj-type
     5617                                       else tt-fin-doc.obj-type:screen-value)
     5618   .
     5619   .
     5620   if p-mode = 'ПРОСМОТР':U and
     5621   tt-fin-doc.contract-code = 0 then do:
     5622       assign
     5623       g-log = rs-view:disable(radio-label("contract":U, RS-view:radio-buttons))
     5624       .
     5625       if rs-view = "contract":U then
     5626       assign
     5627       rs-view = "full":U
     5628       v-not-uf-set = yes.
     5629   end.
     5630   find first X_currency no-lock where
     5631                 X_currency.curr-code = tt-fin-doc.curr-code.
     5632   assign
     5633     f-curr-abbr = X_Currency.curr-abbr.
     5634   if p-mode = 'ДОБАВЛЕНИЕ':U and tt-fin-doc.receiver-type = "":U then do:
     5635     assign
     5636     tt-fin-doc.receiver-type = 'орг':U
     5637     .
     5638   end.
     5639   IF tt-fin-doc.sttm-code <> 0 THEN DO:
     5640     FIND FIRST X_fin-statement NO-LOCK WHERE
     5641               X_fin-statement.host-code  = tt-fin-doc.host-code
     5642           AND X_fin-statement.sttm-code  = tt-fin-doc.sttm-code NO-ERROR.
     5643     IF NOT AVAILABLE X_fin-statement THEN DO:
