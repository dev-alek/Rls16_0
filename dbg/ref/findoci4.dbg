      133   define new global shared variable g#language as character no-undo .
      134   if g#language <> '' and g#language <> 'rus':U then do:
      135     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
