        1   block-level on error undo, throw.
        2   define input parameter p-node-code  like ub.c-gds-grp-hist.node-code no-undo .
        3   define input parameter p-attr-code  like ub.c-gds-grp-hist.attr-code no-undo .
        4   define input parameter p-tax-code  like ub.c-gds-grp-hist.tax-code no-undo .
        5   define input parameter p-corr-user-db-num  like ub.c-gds-grp-hist.corr-user-db-num no-undo .
        6   define input parameter p-chip-num  like ub.c-gds-grp-hist.chip-num no-undo .
        7   define input parameter p-host-code like ub.c-gds-grp-hist.host-code no-undo .
        8   define input parameter p-obj-type like ub.c-gds-grp-hist.obj-type no-undo .
        9   define input parameter p-obj-code like ub.c-gds-grp-hist.obj-code no-undo .
       10   define input parameter p-subject like ub.c-gds-grp-hist.subject no-undo .
       11   define input parameter p-action   like ub.c-gds-grp-hist.action no-undo .
       12   define input parameter p-silent  as logical no-undo .
       13   define output parameter p-description as character no-undo .
       14   define output parameter p-full-name-old as character no-undo .
       15   define output parameter p-full-name-new as character no-undo .
       16   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       17   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       18   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       19   define variable vss-workfile    as character no-undo init "$Workfile: cggrhisv.p $":U .
       20   define variable vss-archive     as character no-undo init "$Archive: ref/cggrhisv.p $":U .
       21   define variable vss-description as character no-undo init "Заполнение временной таблицы для показа изменений по таблицам истории групп товаров".
       22   procedure vss-get-info :
       23     define output parameter p-vss-revision    like vss-revision    no-undo .
       24     define output parameter p-vss-author      like vss-author      no-undo .
       25     define output parameter p-vss-date        like vss-date        no-undo .
       26     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       27     define output parameter p-vss-archive     like vss-archive     no-undo .
       28     define output parameter p-vss-description like vss-description no-undo .
       29     assign
       30       p-vss-revision    = vss-revision
       31       p-vss-author      = vss-author
       32       p-vss-date        = vss-date
       33       p-vss-workfile    = vss-workfile
       34       p-vss-archive     = vss-archive
       35       p-vss-description = vss-description
       36     .
       37   end procedure.
       38   procedure vss-get-parameters :
       39     define output parameter p-vss-parameters as character no-undo .
       40   end procedure.
       41   define new global shared variable g#vssrevis-logger as handle    no-undo .
       42   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       43   define variable v-vssrevis-logger                   as handle    no-undo .
       44   procedure vss-logevent :
       45     define input  parameter p-extra-paramters as character no-undo .
       46     define variable v-vssrevis-parameters as character no-undo .
       47     do
       48     on error undo, return error return-value
       49     :
       50       if  valid-handle(v-vssrevis-logger)
       51       and v-vssrevis-logger :get-signature("logevent") <> ""
       52       then do:
       53         run vss-get-parameters in this-procedure
       54           (output v-vssrevis-parameters
       55           ).
       56         run logevent in v-vssrevis-logger
       57           (input vss-workfile
       58           ,input vss-revision
       59           ,input v-vssrevis-parameters
       60           ,input p-extra-paramters
       61           ).
       62       end.
       63     end.
       64   end procedure.
       65   assign
       66     v-vssrevis-logger = g#vssrevis-logger
       67   .
       68   if  valid-handle(v-vssrevis-logger)
       69   and v-vssrevis-logger :get-signature("logevent") <> ""
       70   then do:
       71     assign
       72       v-vssrevis-logevent = true
       73     .
       74     run vss-logevent in this-procedure (input vss-description) .
       75   end.
       76   define new global shared variable g#language as character no-undo .
       77   if g#language <> '' and g#language <> 'rus':U then do:
       78     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       79   end.
       80   define new global shared variable g#library  as handle no-undo .
       81   define new global shared variable g#library2 as handle no-undo .
       82   define   shared variable g#auto as logical no-undo.
       83   define   shared variable g#news as logical no-undo.
       84   define   shared variable g#oxml as logical no-undo.
       85   define   shared variable g#esys as logical no-undo.
       86   define   shared variable g#news-source-db as integer no-undo.
       87   define   shared variable g#esys-source-esys as integer no-undo.
       88   define   shared variable g#db-num as integer   no-undo .
       89   define   shared variable g#userid as character no-undo .
       90   define   shared variable g#passwd as character no-undo .
       91   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       92   procedure grp-attr-name :
       93   do
       94     on error undo, return error
       95     :
       96     define input  parameter p-code           as character no-undo .
       97     define output parameter p-type           as character no-undo .
       98     define output parameter p-format         as character no-undo .
       99     define output parameter p-label          as character no-undo .
      100     define output parameter p-user-can-edit  as logical   no-undo .
      101     define output parameter p-output-display as logical   no-undo .
      102     define output parameter p-other          as character no-undo .
      103       case p-code :
      104               when 'gds-grp-nabor':U then do:     assign     p-label = "Набор"     p-type = 'L':U      p-format = "yes/no"     p-label = "Набор"     p-user-can-edit  = true     p-output-display = true     p-other = ""      .   end.
      105         otherwise do:
      106           undo, return error "Неизвестный атрибут группы товаров на фирме" + " " + p-code .
      107         end.
      108       end.
      109     end.
      110   end procedure.
      111   procedure grp-attr-tooltip :
      112   do
      113     on error undo, return error
      114     :
      115       define input  parameter p-code    as character no-undo .
      116       define output parameter p-tooltip as character no-undo .
      117       define output parameter p-label   as character no-undo .
      118       case p-code :
      119               when 'gds-grp-nabor':U then do:     assign     p-tooltip = "Набор - не товарные позиции"     p-label = "Набор" .   end.
      120         otherwise do:
      121               undo, return error "Неизвестный атрибут группы товаров на фирме" + " " + p-code .
      122         end.
      123       end.
      124     end.
      125   end procedure.
      126   procedure grp-attr-value :
      127   do
      128   on error undo, return error
      129   :
      130   define input  parameter p-node-code   as integer    no-undo.
      131   define input  parameter p-code        as character  no-undo.
      132   define input  parameter p-host-code   as integer    no-undo.
      133   define input  parameter p-obj-type    as character  no-undo.
      134   define input  parameter p-obj-code    as integer    no-undo.
      135   define output parameter p-value       as character  no-undo.
      136   define output parameter p-type        as character  no-undo.
      137       define variable v-format         as character no-undo .
      138       define variable v-label          as character no-undo .
      139       define variable v-user-can-edit  as logical   no-undo .
      140       define variable v-output-display as logical   no-undo .
      141       define variable v-other          as character no-undo .
      142       define buffer buf_gds-grp-attr for ub.gds-grp-attr.
      143       run grp-attr-name in this-procedure (
      144             input  p-code
      145           , output p-type
      146           , output v-format
      147           , output v-label
      148           , output v-user-can-edit
      149           , output v-output-display
      150           , output v-other
      151       ) no-error .
      152       if error-status :error
      153       then do:
      154           undo, return error return-value .
      155       end.
      156       find first buf_gds-grp-attr no-lock
      157            where buf_gds-grp-attr.node-code = p-node-code
      158              and buf_gds-grp-attr.attr-code = p-code
      159              and buf_gds-grp-attr.host-code = p-host-code
      160              and buf_gds-grp-attr.obj-type  = p-obj-type
      161              and buf_gds-grp-attr.obj-code  = p-obj-code
      162       no-error .
      163       if available buf_gds-grp-attr
      164       then do:
      165           assign
      166               p-value = buf_gds-grp-attr.attr-value
      167           .
      168       end.
      169       else do:
      170           assign
      171               p-value = if p-type = 'L':U then "no":U else ""
      172           .
      173       end.
      174   end.
      175   end procedure.
      176   procedure grp-attr-write :
      177   do
      178   on error undo, return error
      179   :
      180   define input parameter p-node-code  like ub.gds-grp-attr.node-code      no-undo.
      181   define input parameter p-code       like ub.gds-grp-attr.attr-code      no-undo.
      182   define input parameter p-host-code  as integer                          no-undo.
      183   define input parameter p-obj-type   like ub.clients.obj-type            no-undo.
      184   define input parameter p-obj-code   like ub.clients.obj-code            no-undo.
      185   define input parameter p-value      like ub.gds-grp-attr.attr-value     no-undo.
      186       define variable v-type              as character                no-undo.
      187       define variable v-format            as character                no-undo.
      188       define variable v-label             as character                no-undo.
      189       define variable v-user-can-edit     as logical                  no-undo.
      190       define variable v-output-display    as logical                  no-undo.
      191       define variable v-other             as character                no-undo.
      192       define buffer buf_gds-grp-attr for ub.gds-grp-attr .
      193       run grp-attr-name in this-procedure (
      194                         input  p-code
      195                       , output v-type
      196                       , output v-format
      197                       , output v-label
      198                       , output v-user-can-edit
      199                       , output v-output-display
      200                       , output v-other
      201       ) no-error.
      202       if error-status :error
      203       then do:
      204           undo, return error return-value.
      205       end.
      206       find first buf_gds-grp-attr exclusive-lock
      207            where buf_gds-grp-attr.node-code  = p-node-code
      208              and buf_gds-grp-attr.attr-code  = p-code
      209              and buf_gds-grp-attr.host-code  = p-host-code
      210              and buf_gds-grp-attr.obj-type   = p-obj-type
      211              and buf_gds-grp-attr.obj-code   = p-obj-code
      212       no-error.
      213       if not available buf_gds-grp-attr
      214       then do:
      215           create buf_gds-grp-attr.
      216           assign
      217                   buf_gds-grp-attr.node-code  = p-node-code
      218                   buf_gds-grp-attr.attr-code  = p-code
      219                   buf_gds-grp-attr.host-code  = p-host-code
      220                   buf_gds-grp-attr.obj-type   = p-obj-type
      221                   buf_gds-grp-attr.obj-code   = p-obj-code
      222                   buf_gds-grp-attr.attr-value = p-value
      223           .
      224       end.
      225       else do:
      226           assign
      227               buf_gds-grp-attr.attr-value = p-value
      228           .
      229       end.
      230   end.
      231   end procedure.
      232   procedure grp-attr-delete :
      233   do
      234   on error undo, return error
      235   :
      236   define input parameter p-node-code  like ub.gds-grp-attr.node-code  no-undo.
      237   define input parameter p-code       like ub.gds-grp-attr.attr-code  no-undo.
      238   define input parameter p-host-code  as integer                      no-undo.
      239   define input parameter p-obj-type   like ub.clients.obj-type        no-undo.
      240   define input parameter p-obj-code   like ub.clients.obj-code        no-undo.
      241   define output parameter p-deleted   as logical                      no-undo.
      242       define buffer buf_gds-grp-attr for ub.gds-grp-attr .
      243       define variable v-type              as character                no-undo.
      244       define variable v-format            as character                no-undo.
      245       define variable v-label             as character                no-undo.
      246       define variable v-user-can-edit     as logical                  no-undo.
      247       define variable v-output-display    as logical                  no-undo.
      248       define variable v-other             as character                no-undo.
      249       run grp-attr-name in this-procedure
      250       ( input  p-code
      251       , output v-type
      252       , output v-format
      253       , output v-label
      254       , output v-user-can-edit
      255       , output v-output-display
      256       , output v-other
      257       ) no-error .
      258       if error-status :error then do:
      259           undo, return error return-value .
      260       end.
      261       find first buf_gds-grp-attr exclusive-lock
      262            where buf_gds-grp-attr.node-code  = p-node-code
      263              and buf_gds-grp-attr.attr-code  = p-code
      264              and buf_gds-grp-attr.host-code  = p-host-code
      265              and buf_gds-grp-attr.obj-type   = p-obj-type
      266              and buf_gds-grp-attr.obj-code   = p-obj-code
      267       no-error.
      268       if not available buf_gds-grp-attr
      269       then do:
      270           assign
      271               p-deleted = no
      272           .
      273       end.
      274       else do:
      275          delete buf_gds-grp-attr.
      276          assign
      277               p-deleted = yes
      278           .
      279       end.
      280   end.
      281   end procedure.
      282   procedure grp-attr-news :
      283   do
      284   on error undo, return error
      285   :
      286       define input  parameter p-code           as character no-undo .
      287       define output parameter p-news           as logical   no-undo .
      288       case p-code :
      289               when 'gds-grp-nabor':U then do:     assign     p-news = true.   end.
      290         otherwise do:
      291           undo, return error "неизвестный атрибут товара на фирме" + " " + p-code .
      292         end.
      293       end.
      294   end.
      295   end procedure.
      296   procedure grp-attr-obj-value :
      297   do
      298   on error undo, return error
      299   :
      300   define input parameter p-node-code as integer      no-undo.
      301   define input parameter p-obj-type  as character    no-undo.
      302   define input parameter p-obj-code  as integer      no-undo.
      303   define input parameter p-attr-code as character    no-undo .
      304   define output parameter p-attr-value     as character   no-undo.
      305   define output parameter p-range     as integer      no-undo.
      306   define output parameter p-exists    as logical      no-undo.
      307   define variable v-host-code as integer      no-undo.
      308   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      309   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      310     (input  p-obj-type
      311     ,input  p-obj-code
      312     ,output v-host-code
      313     ) no-error .
      314   if error-status :error
      315   then do:
      316       message
      317         vss-workfile vss-revision vss-description
      318         skip "Не удалось найти фирму объекта"
      319         skip p-obj-type p-obj-code
      320         skip return-value
      321         skip trim(error-status :get-message(1))
      322              trim(error-status :get-message(2))
      323              trim(error-status :get-message(3))
      324              trim(error-status :get-message(4))
      325              trim(error-status :get-message(5))
      326       view-as alert-box error.
      327       undo, return error .
      328   end.
      329   define buffer buf_gds-grp-attr      for ub.gds-grp-attr.
      330   find first buf_gds-grp-attr no-lock
      331        where buf_gds-grp-attr.node-code = p-node-code
      332          and buf_gds-grp-attr.attr-code = p-attr-code
      333          and buf_gds-grp-attr.host-code = v-host-code
      334          and buf_gds-grp-attr.obj-type  = p-obj-type
      335          and buf_gds-grp-attr.obj-code  = p-obj-code
      336   no-error .
      337   if not available buf_gds-grp-attr
      338   then do:
      339       find first buf_gds-grp-attr no-lock
      340            where buf_gds-grp-attr.node-code = p-node-code
      341              and buf_gds-grp-attr.attr-code = p-attr-code
      342              and buf_gds-grp-attr.host-code = v-host-code
      343              and buf_gds-grp-attr.obj-type  = ""
      344              and buf_gds-grp-attr.obj-code  = 0
      345       no-error .
      346       if not available buf_gds-grp-attr
      347       then do:
      348           find first buf_gds-grp-attr no-lock
      349               where buf_gds-grp-attr.node-code = p-node-code
      350               and buf_gds-grp-attr.attr-code = p-attr-code
      351               and buf_gds-grp-attr.host-code = 0
      352               and buf_gds-grp-attr.obj-type  = ""
      353               and buf_gds-grp-attr.obj-code  = 0
      354           no-error .
      355           if not available buf_gds-grp-attr
      356           then do:
      357               assign
      358                   p-exists = no
      359               .
      360           end.
      361           else do:
      362               assign
      363                   p-exists = yes
      364                   p-range  = 1
      365               .
      366           end.
      367       end.
      368       else do:
      369           assign
      370               p-exists = yes
      371               p-range  = 2
      372           .
      373       end.
      374   end.
      375   else do:
      376       assign
      377           p-exists = yes
      378           p-range  = 3
      379       .
      380   end.
      381   if available buf_gds-grp-attr
      382   then do:
      383     assign
      384     p-attr-value = buf_gds-grp-attr.attr-value
      385     .
      386   end.
      387   end.
      388   end procedure.
      389   procedure ver-gds-grp-nabor :
      390   do
      391   on error undo, return error return-value
      392   :
      393   define input  parameter p-gds-code as integer   no-undo .
      394   define output parameter p-nabor as logical   no-undo .
      395   define buffer buf_goods for ub.goods.
      396   p-nabor = false .
      397   find first  buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
      398   if error-status :error then return error .
      399   define variable v-value       as character  no-undo.
      400   define variable v-type        as character  no-undo.
      401     run grp-attr-value (
      402        input   buf_goods.grp-code
      403       ,input   'gds-grp-nabor':U
      404       ,input   0
      405       ,input   ""
      406       ,input   0
      407       ,output  v-value
      408       ,output  v-type       ) no-error .
      409       if error-status :error then return error .
      410     if v-value = "yes" then p-nabor = true  .
      411   end.
      412   end procedure.
      413   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      414   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      415   define temp-table temp-drt-prop no-undo like ub.drt-prop.
      416   procedure disrules-fill-properties:
      417   define input  parameter p-templ-rl-root as integer   no-undo .
      418   define buffer buf_drt-prop for ub.drt-prop.
      419   define buffer buf_temp-drt-prop for temp-drt-prop.
      420   do
      421   on error undo, return error return-value
      422   :
      423     for each buf_temp-drt-prop:
      424       delete buf_temp-drt-prop.
      425     end.
      426     for each buf_drt-prop where buf_drt-prop.templ-rl-root = p-templ-rl-root:
      427       create buf_temp-drt-prop.
      428       buffer-copy buf_drt-prop to buf_temp-drt-prop.
      429     end.
      430   end.
      431   end procedure.
      432   ~
      433   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      434   procedure discfgru-check :
      435   define input parameter p-table-name as character no-undo .
      436   define input parameter p-templ-rl-root as integer no-undo .
      437   define input parameter p-time-templ-rl-root as integer no-undo .
      438   define input parameter p-pos-type as character no-undo .
      439   define output parameter p-disnct-role as character no-undo .
      440   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      441     do
      442     on error undo, return error return-value
      443     :
      444       find first buf_dis-cfg-rule no-lock where
      445               buf_dis-cfg-rule.table-name = p-table-name
      446           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
      447           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
      448           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
      449       if not available buf_dis-cfg-rule
      450       or p-pos-type = "":U
      451       then do:
      452          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
      453                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
      454                                  , p-templ-rl-root
      455                                  , (if p-time-templ-rl-root = ?
      456                                     then '':U
      457                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
      458                                     )
      459                                  ).
      460       end.
      461       assign
      462       p-disnct-role = buf_dis-cfg-rule.discnt-role
      463       .
      464     end.
      465   end procedure.
      466   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      467   FUNCTION get-region RETURNS CHARACTER
      468     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      469     define variable par-region as character no-undo.
      470     if parhost-code = 0 and
      471          parobj-type = "":U and
      472          parobj-code = 0 then do:
      473          par-region = "Глобально".
      474          return par-region.
      475       end.
      476       if parobj-type = 'орг':U then do:
      477          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      478          return par-region.
      479       end.
      480       if parobj-type = 'регион':U
      481       then do:
      482          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      483          return par-region.
      484       end.
      485       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      486       return par-region.
      487   END FUNCTION.
      488   FUNCTION get-objregion RETURNS CHARACTER
      489     (  input parobj-type as character, input parobj-code as integer ) :
      490     define variable par-region as character no-undo.
      491     if  parobj-type = "":U and
      492         parobj-code = 0
      493     then do:
      494        par-region = "Глобально".
      495     end.
      496     else if parobj-type = 'орг':U
      497     then do:
      498        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      499     end.
      500     else if parobj-type = 'регион':U
      501     then do:
      502        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      503     end.
      504     else
      505        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      506     return par-region.
      507   END FUNCTION.
      508   procedure disgrpru-name :
      509   define buffer buf_dis-rule for ub.dis-rule.
      510   do
      511     on error undo, return error
      512     :
      513     define input  parameter p-templ-rl-root  as integer no-undo .
      514     define output parameter p-label          as character no-undo .
      515     find first buf_dis-rule no-lock where
      516               buf_dis-rule.rule-num = p-templ-rl-root no-error.
      517     if available buf_dis-rule then do:
      518       if buf_dis-rule.rule-num > 0 then
      519       p-label = buf_dis-rule.des.
      520     end.
      521     else do:
      522       p-label = substitute("Неизвестный тип правила скидки &1", p-templ-rl-root).
      523     end.
      524   end.
      525   end procedure.
      526   function disgrpru-get-disc-label returns character ( input p-templ-rl-root as integer):
      527   define variable v-rule-label as character no-undo .
      528   run disgrpru-name in this-procedure ( input p-templ-rl-root
      529                                        ,output v-rule-label) no-error.
      530   return v-rule-label.
      531   end function.
      532   function disgrpru-get-disc-role-label returns character ( input p-discnt-role as character):
      533   define variable v-role-label as character no-undo .
      534   v-role-label =  entry (lookup (p-discnt-role, 'gds-grp-pcnt,gds-grp-pcnt-kat,gds-grp-abs,gds-grp-qnty,gds-grp-sum':u) + 1, ',' + '% скидка на группу товара,% скидка на группу товара для кат.клиентов,Abs скидка на группу товара,% Скидка на группу товара по кол-ву,% Скидка на группу товара на сумму':u).
      535   if v-role-label = '':u then do:
      536     v-role-label = entry (lookup (p-discnt-role, 'cli-grp-pcnt':u) + 1, ',' + '% скидка на группу клиентов':u).
      537   end.
      538   return v-role-label.
      539   end function.
      540   procedure disgrpru-write :
      541     do
      542     on error undo, return error
      543     :
      544       define input parameter p-classif-type   like ub.dis-grp-rule.classif-type no-undo .
      545       define input parameter p-node-code      like ub.dis-grp-rule.node-code  no-undo .
      546       define input parameter p-host-code      like ub.dis-grp-rule.host-code no-undo .
      547       define input parameter p-obj-type       like ub.dis-grp-rule.obj-type   no-undo .
      548       define input parameter p-obj-code       like ub.dis-grp-rule.obj-code   no-undo .
      549       define input parameter p-pos-type       like ub.dis-grp-rule.pos-type   no-undo .
      550       define input parameter p-discnt-role    like ub.dis-grp-rule.discnt-role no-undo .
      551       define input parameter p-templ-rl-root  like ub.dis-grp-rule.templ-rl-root  no-undo .
      552       define input parameter p-time-templ-rl-root  like ub.dis-grp-rule.time-templ-rl-root  no-undo .
      553       define input parameter p-rule-num       like ub.dis-grp-rule.rule-num    no-undo .
      554       define input parameter p-nonunique      like ub.dis-grp-rule.nonunique   no-undo .
      555       define buffer buf_dis-grp-rule for ub.dis-grp-rule .
      556       define buffer lock_dis-grp-rule for ub.dis-grp-rule .
      557       define buffer buf_dis-rule for ub.dis-rule.
      558       define variable v-label          as character no-undo .
      559       define variable v-discnt-role as character no-undo .
      560       define variable v-host-code as integer no-undo .
      561       run discfgru-check in this-procedure (
      562                                             input 'dis-grp-rule':U
      563                                            ,input p-templ-rl-root
      564                                            ,input p-time-templ-rl-root
      565                                            ,input p-pos-type
      566                                            ,output v-discnt-role
      567                                             ) no-error .
      568       if error-status :error then do:
      569         undo, return error return-value .
      570       end.
      571      if p-discnt-role = ? then do:
      572         p-discnt-role = v-discnt-role.
      573       end.
      574       if p-discnt-role <> v-discnt-role then do:
      575         undo, return error substitute("Группа с кодом &1 &2 место использ.&3 уже есть скидка типа &4&5не может быть по шаблону &6 и расписанию &7"
      576                                 ,p-node-code
      577                                 ,p-obj-type + string(p-obj-code)
      578                                 ,p-pos-type
      579                                 ,entry (lookup (p-discnt-role, 'gds-grp-pcnt,gds-grp-pcnt-kat,gds-grp-abs,gds-grp-qnty,gds-grp-sum':u) + 1, ',' + '% скидка на группу товара,% скидка на группу товара для кат.клиентов,Abs скидка на группу товара,% Скидка на группу товара по кол-ву,% Скидка на группу товара на сумму':u)
      580                                 ,chr(10)
      581                                 ,p-templ-rl-root
      582                                 ,p-rule-num).
      583       end.
      584       if p-pos-type = ? then do:
      585   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      586   define variable v-param-type6 as character no-undo .
      587   define variable v-value-date6 as date no-undo .
      588   define variable v-value-decimal6 as decimal no-undo .
      589   define variable v-value-integer6 as INTEGER no-undo .
      590   define variable v-value-logical6 AS LOGICAL no-undo .
      591   define variable v-tth6 as handle no-undo .
      592   run adm/shattri.p (
      593       input "get":U
      594       ,input  p-obj-type
      595       ,input  p-obj-code
      596       ,input  'cd-sending':U
      597       ,input  'dflt-cd':U
      598       ,output p-pos-type
      599       ,output v-value-date6
      600       ,output v-value-decimal6
      601       ,output v-value-integer6
      602       ,output v-value-logical6
      603       ,output v-param-type6
      604       ,INPUT-OUTPUT table-handle v-tth6
      605       )  .
      606   delete object v-tth6 no-error.
      607       end.
      608       find first buf_dis-rule no-lock where
      609                 buf_dis-rule.rule-num = p-rule-num no-error.
      610       if not available buf_Dis-rule then do:
      611         undo, return error substitute("Группа с кодом &1 &2 место использ.&3 уже есть скидка типа &4&5не найдено правило скидки &6"
      612                                 ,p-node-code
      613                                 ,p-obj-type + string(p-obj-code)
      614                                 ,p-pos-type
      615                                 ,entry (lookup (p-discnt-role, 'gds-grp-pcnt,gds-grp-pcnt-kat,gds-grp-abs,gds-grp-qnty,gds-grp-sum':u) + 1, ',' + '% скидка на группу товара,% скидка на группу товара для кат.клиентов,Abs скидка на группу товара,% Скидка на группу товара по кол-ву,% Скидка на группу товара на сумму':u)
      616                                 ,chr(10)
      617                                 ,p-rule-num).
      618       end.
      619       if buf_dis-rule.root <> yes then do:
      620         undo, return error substitute("Группа с кодом &1 &2 место использ.&3 уже есть скидка типа &4&5правило скидки &6 - некорневое"
      621                                 ,p-node-code
      622                                 ,p-obj-type + string(p-obj-code)
      623                                 ,p-pos-type
      624                                 ,entry (lookup (p-discnt-role, 'gds-grp-pcnt,gds-grp-pcnt-kat,gds-grp-abs,gds-grp-qnty,gds-grp-sum':u) + 1, ',' + '% скидка на группу товара,% скидка на группу товара для кат.клиентов,Abs скидка на группу товара,% Скидка на группу товара по кол-ву,% Скидка на группу товара на сумму':u)
      625                                 ,chr(10)
      626                                 ,p-rule-num).
      627       end.
      628       if not (p-obj-type = buf_dis-rule.obj-type
      629           and p-obj-code = buf_dis-rule.obj-code) then do:
      630         undo, return error (substitute("Группа с кодом &1 &2 место использ.&3 уже есть скидка типа &4&5правило скидки &6"
      631                                 ,p-node-code
      632                                 ,p-obj-type + string(p-obj-code)
      633                                 ,p-pos-type
      634                                 ,entry (lookup (p-discnt-role, 'gds-grp-pcnt,gds-grp-pcnt-kat,gds-grp-abs,gds-grp-qnty,gds-grp-sum':u) + 1, ',' + '% скидка на группу товара,% скидка на группу товара для кат.клиентов,Abs скидка на группу товара,% Скидка на группу товара по кол-ву,% Скидка на группу товара на сумму':u)
      635                                 ,chr(10)
      636                                 ,p-rule-num)
      637                             +
      638                             substitute("Правило скидки &1 определено для &1&2" +
      639                                        "а привязка к ДК для &3"
      640                                        ,get-region( buf_Dis-rule.host-code, buf_dis-rule.obj-type, buf_Dis-rule.obj-code)
      641                                        ,chr(10)
      642                                        ,get-region( p-host-code, p-obj-type, p-obj-code)
      643                                        ))
      644                                 .
      645       end.
      646       find first buf_dis-grp-rule exclusive-lock where
      647                  buf_dis-grp-rule.classif-type  = p-classif-type
      648              AND buf_dis-grp-rule.node-code  = p-node-code
      649              AND buf_dis-grp-rule.host-code  = p-host-code
      650              AND buf_dis-grp-rule.obj-type  = p-obj-type
      651              AND buf_dis-grp-rule.obj-code  = p-obj-code
      652              AND buf_dis-grp-rule.pos-type  = p-pos-type
      653              AND buf_dis-grp-rule.discnt-role = p-discnt-role
      654              and buf_dis-grp-rule.nonunique = p-nonunique
      655              no-error .
      656       if not available buf_dis-grp-rule then do:
      657         create buf_dis-grp-rule .
      658         assign
      659         buf_dis-grp-rule.classif-type  = p-classif-type
      660         buf_dis-grp-rule.node-code  = p-node-code
      661         buf_dis-grp-rule.obj-type  = p-obj-type
      662         buf_dis-grp-rule.obj-code  = p-obj-code
      663         buf_dis-grp-rule.host-code  = p-host-code
      664         buf_dis-grp-rule.pos-type = p-pos-type
      665         buf_dis-grp-rule.discnt-role = v-discnt-role
      666         buf_dis-grp-rule.rule-num = p-rule-num
      667         buf_dis-grp-rule.nonunique = p-nonunique
      668         no-error
      669         .
      670       end.
      671       ASSIGN
      672       buf_dis-grp-rule.rule-num = p-rule-num
      673       buf_dis-grp-rule.rl-root = p-rule-num
      674       buf_dis-grp-rule.templ-rl-root = p-templ-rl-root
      675       buf_dis-grp-rule.time-templ-rl-root = p-time-templ-rl-root
      676       buf_dis-grp-rule.nonunique = p-nonunique
      677       no-error.
      678     end.
      679   end procedure.
      680   procedure disgrpru-delete :
      681   define input parameter p-classif-type   like ub.dis-grp-rule.classif-type no-undo .
      682   define input parameter p-node-code      like ub.dis-grp-rule.node-code  no-undo .
      683   define input parameter p-host-code      like ub.dis-grp-rule.host-code   no-undo .
      684   define input parameter p-obj-type       like ub.dis-grp-rule.obj-type   no-undo .
      685   define input parameter p-obj-code       like ub.dis-grp-rule.obj-code   no-undo .
      686   define input parameter p-pos-type       like ub.dis-grp-rule.pos-type   no-undo .
      687   define input parameter p-discnt-role    like ub.dis-grp-rule.discnt-role no-undo .
      688   define input parameter p-nonunique      like ub.dis-grp-rule.nonunique   no-undo .
      689   define output parameter p-deleted       as logical no-undo .
      690   define variable v-rule-label as character no-undo .
      691   define buffer buf_dis-grp-rule for ub.dis-grp-rule.
      692   do
      693   on error undo, return error
      694   :
      695   find first buf_dis-grp-rule exclusive-lock where
      696               buf_dis-grp-rule.classif-type  = p-classif-type
      697           AND buf_dis-grp-rule.node-code  = p-node-code
      698           AND buf_dis-grp-rule.obj-type  = p-obj-type
      699           AND buf_dis-grp-rule.host-code = p-host-code
      700           AND buf_dis-grp-rule.obj-code  = p-obj-code
      701           AND buf_dis-grp-rule.pos-type  = p-pos-type
      702           AND buf_dis-grp-rule.discnt-role = p-discnt-role
      703           and buf_dis-grp-rule.nonunique = p-nonunique
      704           no-error .
      705   if not available buf_dis-grp-rule then do:
      706     return '':U.
      707   end.
      708   delete buf_dis-grp-rule no-error.
      709   if error-status:error then do:
      710     run disgrpru-name in this-procedure
      711       (input  buf_dis-grp-rule.templ-rl-root
      712       ,output v-rule-label
      713       ) no-error .
      714     undo, return error substitute("Ошибка при удалении скидки по группе:&1" +
      715                                  "&2 (место использ. &3) на фирме &4 &5&6 для группы &7&1&8&1&9"
      716                                   ,chr(10)
      717                                   ,v-rule-label
      718                                   ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
      719                                   ,p-host-code
      720                                   ,p-obj-type
      721                                   ,p-obj-code
      722                                   ,error-status:get-message(1)
      723                                   ,return-value ).
      724   end.
      725   p-deleted = yes.
      726   return '':U.
      727   end.
      728   end procedure.
      729   define variable v-chg-fields as character no-undo.
      730   define variable v-old-fields as character no-undo.
      731   define variable v-new-fields as character no-undo.
      732   define variable ii as integer no-undo.
      733   define variable v-mess as character no-undo .
      734   define buffer buf_c-gds-grp-hist for ub.c-gds-grp-hist.
      735   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      736   define SHARED temp-table temp-changes no-undo
      737   field f_name as character
      738   field l_name as character
      739   field v_old as character
      740   field v_new as character
      741   field t_name as character
      742   field num_ as integer
      743   field uniq-key-rec as character
      744   field action as integer
      745   field fNotChange as logical
      746   index pi is unique primary
      747   num_
      748   t_name
      749   f_name
      750   index
      751   Chan
      752   fnotChange
      753   t_name
      754   f_name
      755   index imain uniq-key-rec
      756   .
      757   FUNCTION get-all-fields returns character (p-file-name as character ):
      758   define variable v-dop as character no-undo .
      759     find first _file no-lock where _file._file-name = p-file-name no-error .
      760     if not available _file then return "":U.
      761     for each _field no-lock where
      762              _field._file-recid = recid(_file) :
      763       assign
      764       v-dop = v-dop + _field._field-name + chr(44)
      765       .
      766     end.
      767     return trim(v-dop).
      768   END FUNCTION.
      769   PROCEDURE proc-full-temp-changes :
      770     define input  parameter p-act-create as logical   no-undo .
      771     define input  parameter p-act-delete as logical   no-undo .
      772     define input  parameter p-hst-handle as handle    no-undo .
      773     define input  parameter p-main-table as character no-undo .
      774     define input  parameter p-field-list as character no-undo .
      775     define input  parameter p-label-form as character no-undo .
      776     define variable h-new-buf         as handle    no-undo .
      777     define variable h-main-buf        as handle    no-undo .
      778     define variable h-for-comp        as handle    no-undo .
      779     define variable v-inform          as character no-undo .
      780     define variable v-ind             as integer   no-undo .
      781     define variable v-idx-field-qnty  as integer   no-undo .
      782     define variable v-num-entries     as integer   no-undo .
      783     define variable fh                as handle    no-undo .
      784     define variable fh-main           as handle    no-undo .
      785     define variable fh-old            as handle    no-undo .
      786     define variable fh-new            as handle    no-undo .
      787     define variable v-field-name      as character no-undo .
      788     define variable v-field-lvl       as character no-undo .
      789     define variable v-field-form      as character no-undo .
      790     define variable v-search-exp      as character no-undo .
      791     define variable v-srch-main       as character no-undo .
      792     define variable v-word-link       as character no-undo .
      793     define variable v-av-chip-num     as logical   no-undo .
      794     define variable v-main-pi-fld-lst as character no-undo .
      795     define variable v-main-fld-lst    as character no-undo .
      796     define variable v-delim-list      as character no-undo .
      797     define variable v-label           as character no-undo .
      798     define variable v-old-value       as character no-undo case-sensitive.
      799     define variable v-new-value       as character no-undo case-sensitive.
      800     define variable v-chg-fields as character no-undo.
      801     for each temp-changes:
      802       delete temp-changes.
      803     end.
      804     if not p-hst-handle:available then do:
      805       return .
      806     end.
      807     create buffer h-new-buf  for table p-hst-handle .
      808     create buffer h-main-buf for table p-main-table .
      809     assign
      810       v-inform = h-main-buf:index-information(1)
      811       v-ind    = 2
      812     .
      813     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      814     on error undo, return error
      815     :
      816       assign
      817         v-inform = h-main-buf:index-information( v-ind )
      818         v-ind    = v-ind + 1
      819       .
      820     end.
      821     if v-inform = ?
      822       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      823       or entry( 3, v-inform, ",":U ) <> "1":U
      824     then do:
      825       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
      826     end.
      827     assign
      828       v-idx-field-qnty = num-entries( v-inform ) - 4
      829     .
      830     if v-idx-field-qnty < 2 then do:
      831       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
      832     end.
      833     assign
      834       v-srch-main   = "where":U
      835       v-word-link   = "":U
      836       v-av-chip-num = false
      837       v-delim-list  = "":U
      838     .
      839     do v-ind = 1 to v-idx-field-qnty by 2
      840     on error undo, return error
      841     :
      842       assign
      843         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
      844         fh                = p-hst-handle:buffer-field( v-field-name )
      845         fh-main           = h-main-buf:buffer-field( v-field-name )
      846         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
      847         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
      848       .
      849       if fh:data-type ="character":U then do:
      850         assign
      851           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      852         .
      853       end.
      854       else do:
      855         assign
      856           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
      857         .
      858       end.
      859       if v-delim-list = "":U then do:
      860         assign
      861           v-delim-list = ",":U
      862         .
      863       end.
      864       if v-word-link = "":U then do:
      865         assign
      866           v-word-link = "and":U
      867         .
      868       end.
      869     end.
      870     assign
      871       v-delim-list  = "":U
      872     .
      873     do v-ind = 1 to h-main-buf:num-fields
      874     on error undo, return error
      875     :
      876       assign
      877         fh-main      = h-main-buf:buffer-field( v-ind )
      878         v-field-name = fh-main:name
      879       .
      880         assign
      881           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
      882         .
      883         if v-delim-list = "":U then do:
      884           assign
      885             v-delim-list = ",":U
      886           .
      887         end.
      888     end.
      889     assign
      890       v-inform = p-hst-handle:index-information(1)
      891       v-ind    = 2
      892     .
      893     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      894     on error undo, return error
      895     :
      896       assign
      897         v-inform = p-hst-handle:index-information( v-ind )
      898         v-ind    = v-ind + 1
      899       .
      900     end.
      901     if v-inform = ?
      902       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      903       or entry( 3, v-inform, ",":U ) <> "1":U
      904     then do:
      905       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
      906     end.
      907     assign
      908       v-idx-field-qnty = num-entries( v-inform ) - 4
      909     .
      910     if v-idx-field-qnty < 2 then do:
      911       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
      912     end.
      913     assign
      914       v-search-exp  = "where":U
      915       v-word-link   = "":U
      916       v-av-chip-num = false
      917     .
      918     do v-ind = 1 to v-idx-field-qnty by 2
      919     on error undo, return error
      920     :
      921       assign
      922         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      923         fh           = p-hst-handle:buffer-field( v-field-name )
      924         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
      925       .
      926       if v-field-name = "chip-num":U then do:
      927         assign
      928           v-search-exp  = substitute( "&1 >", v-search-exp )
      929           v-av-chip-num = true
      930         .
      931       end.
      932       else do:
      933         assign
      934           v-search-exp = substitute( "&1 =", v-search-exp )
      935         .
      936       end.
      937       if fh:data-type ="character":U then do:
      938         assign
      939           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
      940         .
      941       end.
      942       else do:
      943         assign
      944           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
      945         .
      946       end.
      947       if v-word-link = "":U then do:
      948         assign
      949           v-word-link = "and":U
      950         .
      951       end.
      952     end.
      953     if v-av-chip-num = false then do:
      954       message
      955         vss-workfile vss-revision vss-description skip
      956         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
      957         "Использование данной процедуры невозможно!" skip
      958         view-as alert-box error .
      959       return error .
      960     end.
      961     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
      962     if not h-new-buf:available then do:
      963       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
      964       if not h-main-buf:available then do:
      965         assign
      966           h-for-comp = ?
      967         .
      968       end.
      969       else do:
      970         assign
      971           h-for-comp = h-main-buf
      972         .
      973       end.
      974     end.
      975     else do:
      976       assign
      977         h-for-comp = h-new-buf
      978       .
      979     end.
      980     assign
      981       v-num-entries = num-entries( v-main-fld-lst, ",":U )
      982     .
      983     do v-ind = 1 to v-num-entries
      984     on error undo, return error return-value
      985     :
      986       assign
      987         v-field-name = entry( v-ind, v-main-fld-lst )
      988         fh-old       = p-hst-handle:buffer-field( v-field-name )
      989         v-old-value  = fh-old:buffer-value()
      990         v-label      = trim( fh-old:label )
      991       .
      992       if ( trim( p-field-list ) <> "":U
      993            and lookup( v-field-name, p-field-list ) > 0
      994          )
      995          or trim( p-field-list ) = "":U
      996       then do:
      997         if h-for-comp <> ? then do:
      998           assign
      999             fh-new      = h-for-comp:buffer-field( v-field-name )
     1000             v-new-value = fh-new:buffer-value()
     1001           .
     1002         end.
     1003         else do:
     1004           assign
     1005             v-new-value = "":U
     1006           .
     1007         end.
     1008           if p-act-create = true then do:
     1009             assign
     1010               v-old-value = "":U
     1011             .
     1012           end.
     1013           if p-act-delete = true then do:
     1014             assign
     1015               v-new-value = "":U
     1016             .
     1017           end.
     1018         if v-old-value <> v-new-value
     1019         then do:
     1020           create temp-changes.
     1021           assign
     1022             temp-changes.t_name = p-main-table
     1023             temp-changes.f_name = v-field-name
     1024             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1025             temp-changes.v_old  = trim( v-old-value )
     1026             temp-changes.v_new  = trim( v-new-value )
     1027             temp-changes.num_   = 0
     1028             temp-changes.fNotChange = v-old-value eq v-new-value
     1029           .
     1030         end.
     1031       end.
     1032     end.
     1033     assign
     1034       v-num-entries = num-entries( p-label-form, chr(8) )
     1035     .
     1036     do v-ind = 1 to v-num-entries
     1037     on error undo, return error return-value
     1038     :
     1039       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1040         assign
     1041           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1042           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1043           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1044         .
     1045         find first temp-changes
     1046           where temp-changes.f_name = v-field-name
     1047           no-error .
     1048         if available temp-changes then do:
     1049           if trim( v-field-lvl ) <> "":U then do:
     1050             assign
     1051               temp-changes.l_name = v-field-lvl
     1052             .
     1053           end.
     1054           if trim( v-field-form ) <> "":U then do:
     1055             assign
     1056               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1057             .
     1058             if h-for-comp <> ? then do:
     1059               assign
     1060                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1061               .
     1062             end.
     1063           end.
     1064         end.
     1065       end.
     1066       else do:
     1067         message
     1068           vss-workfile vss-revision vss-description skip
     1069           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1070           substitute( "список для поля '&1': '&2'"
     1071                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1072                       ,entry( v-ind, p-label-form, chr(8) )
     1073                     ) skip
     1074           substitute( "полный список: &2", p-label-form ) skip
     1075           view-as alert-box error .
     1076       end.
     1077     end.
     1078     delete object h-new-buf .
     1079     delete object h-main-buf .
     1080   END PROCEDURE.
     1081   find first buf_c-gds-grp-hist no-lock where
     1082             buf_c-gds-grp-hist.node-code = p-node-code
     1083         AND buf_c-gds-grp-hist.attr-code = p-attr-code
     1084         AND buf_c-gds-grp-hist.tax-code = p-tax-code
     1085         AND buf_c-gds-grp-hist.chip-num = p-chip-num
     1086         AND buf_c-gds-grp-hist.corr-user-db-num = p-corr-user-db-num
     1087         AND buf_c-gds-grp-hist.host-code = p-host-code
     1088         AND buf_c-gds-grp-hist.obj-type = p-obj-type
     1089         AND buf_c-gds-grp-hist.obj-code = p-obj-code
     1090         AND buf_c-gds-grp-hist.subject  = p-subject no-error .
     1091   if not available buf_c-gds-grp-hist then do:
     1092     return error .
     1093   end.
     1094   CASE p-subject:
     1095     when 'gds-grp':U then do:
     1096       run gds-grp-proc in this-procedure(output p-description) no-error .
     1097     end.
     1098     when 'gds-grp-attr':U then do:
     1099       run gds-grp-attr-proc in this-procedure(output p-description) no-error .
     1100     end.
     1101     when 'gds-grp-obj':U then do:
     1102       run gds-grp-obj-proc in this-procedure(output p-description) no-error .
     1103     end.
     1104     when 'tax-rate-gds-grp':U then do:
     1105       run tax-rate-gds-grp-proc in this-procedure(output p-description) no-error .
     1106     end.
     1107     when 'dis-grp-rule':U then do:
     1108       run dis-grp-rule-proc in this-procedure(output p-description) no-error .
     1109     end.
     1110   END CASE.
     1111   if error-status:error then do:
     1112     return error .
     1113   end.
     1114   procedure gds-grp-proc :
     1115   define output parameter p-description as character no-undo .
     1116   define variable v-is-created as logical no-undo .
     1117   define variable v-is-deleted as logical no-undo .
     1118   define variable v-field-name as character no-undo .
     1119   define variable v-field-function as character no-undo .
     1120   define variable jj as integer no-undo .
     1121   define variable v-field-label  as character no-undo .
     1122   define variable v-field-list as character no-undo .
     1123   define buffer current_gds-grp for ub.gds-grp  .
     1124   define buffer current_c-gds-grp for ub.c-gds-grp  .
     1125   define buffer new_c-gds-grp for ub.c-gds-grp  .
     1126     do
     1127     on error undo, return error
     1128     :
     1129       find first current_c-gds-grp no-lock where
     1130                  current_c-gds-grp.node-code = p-node-code
     1131              AND current_c-gds-grp.chip-num = p-chip-num
     1132              AND current_c-gds-grp.corr-user-db-num = p-corr-user-db-num
     1133              no-error .
     1134       if not avail current_c-gds-grp then do:
     1135          v-mess = "Неверная ссылка на c-gds-grp в таблице c-gds-grp-hist".
     1136          run err-mess in this-procedure ( input-output v-mess).
     1137          return error (if p-silent then v-mess else '':U).
     1138       end.
     1139       if buf_c-gds-grp-hist.action = integer('1':U) then do:
     1140         assign
     1141         v-is-created = yes
     1142         v-chg-fields = get-all-fields ("gds-grp")
     1143         .
     1144       end.
     1145       if buf_c-gds-grp-hist.action = integer('99':U) then do:
     1146         assign
     1147         v-is-deleted = yes
     1148         v-chg-fields = get-all-fields ("gds-grp")
     1149         .
     1150       end.
     1151       find first new_c-gds-grp no-lock where
     1152                  new_c-gds-grp.node-code = p-node-code
     1153              AND new_c-gds-grp.chip-num > p-chip-num
     1154              AND new_c-gds-grp.corr-user-db-num = p-corr-user-db-num
     1155               no-error .
     1156       if not available new_c-gds-grp then do:
     1157           find first current_gds-grp no-lock where
     1158                  current_gds-grp.node-code = p-node-code no-error .
     1159           if not available current_gds-grp
     1160           and not  v-is-deleted
     1161           then do:
     1162               return error.
     1163           end.
     1164           if available current_gds-grp then
     1165           buffer-compare current_gds-grp to current_c-gds-grp
     1166           case-sensitive
     1167           save result in v-chg-fields.
     1168       end.
     1169       else do:
     1170           buffer-compare new_c-gds-grp except chip-num corr-date corr-time corr-user-name corr-user-db-num
     1171           to current_c-gds-grp
     1172           case-sensitive
     1173           save result in v-chg-fields.
     1174       end.
     1175       if lookup("node-code", v-chg-fields ) > 0
     1176       or lookup("upper-code", v-chg-fields ) > 0 then do:
     1177          if not v-is-created then
     1178          run c-get-full-name  in this-procedure (
     1179                                                     input  yes
     1180                                                    ,input p-node-code
     1181                                                    ,input p-chip-num
     1182                                                    ,input p-corr-user-db-num
     1183                                                    ,output p-full-name-old
     1184                                                   ) no-error .
     1185          if not v-is-deleted then
     1186          run c-get-full-name  in this-procedure (
     1187                                                     input  (if available new_c-gds-grp
     1188                                                             then yes
     1189                                                             else no)
     1190                                                    ,input p-node-code
     1191                                                    ,input (if available new_c-gds-grp
     1192                                                            then new_c-gds-grp.chip-num
     1193                                                            else 0)
     1194                                                    ,input p-corr-user-db-num
     1195                                                    ,output p-full-name-new
     1196                                                   ) no-error .
     1197       end.
     1198     _ii:
     1199     do ii = 1 to num-entries(v-chg-fields):
     1200       assign
     1201       v-field-name = entry(ii, v-chg-fields)
     1202       jj = lookup(v-field-name, "calc-method,d-pcnt,increase-pc,is-term,lvl-num,node-code,node-name,unit-base,upper-code").
     1203       if jj = 0 then next _ii.
     1204       assign
     1205       v-field-label = entry(jj, "Способ расчета,Процент скидки,Процент наценки,Терминальная,Уровень,Вн №,Наименование,Осн.ед.изм.,Вн № выш.группы")
     1206       v-field-function = entry(jj, ",,,,,,,,")
     1207       .
     1208       create temp-changes.
     1209       assign
     1210       temp-changes.f_name = v-field-name
     1211       temp-changes.l_name = v-field-label
     1212       temp-changes.v_old =  (if v-is-created
     1213                              then "":U
     1214                              else  string(buffer current_c-gds-grp:buffer-field(v-field-name):buffer-value))
     1215       temp-changes.v_new =  if available new_c-gds-grp
     1216                             then string(buffer new_c-gds-grp:buffer-field(v-field-name):buffer-value)
     1217                             else (if v-is-deleted
     1218                                   then '':U
     1219                                  else string(buffer current_gds-grp:buffer-field(v-field-name):buffer-value))
     1220       .
     1221       if v-field-function <> '':U then do:
     1222         assign
     1223         temp-changes.v_old = DYNAMIC-function(v-field-function, temp-changes.v_old)
     1224         temp-changes.v_new = DYNAMIC-function(v-field-function, temp-changes.v_new)
     1225         .
     1226       end.
     1227     end.
     1228   end.
     1229   end procedure.
     1230   procedure gds-grp-attr-proc :
     1231   define output parameter p-description as character no-undo .
     1232   define variable v-tooltip as character no-undo .
     1233   define variable v-label as character no-undo .
     1234   define buffer current_c-gds-grp-attr for ub.c-gds-grp-attr  .
     1235     do
     1236     on error undo, return error
     1237     :
     1238       find first current_c-gds-grp-attr no-lock where
     1239                  current_c-gds-grp-attr.node-code = p-node-code
     1240              AND current_c-gds-grp-attr.attr-code = p-attr-code
     1241              AND current_c-gds-grp-attr.host-code = p-host-code
     1242              AND current_c-gds-grp-attr.obj-type  = p-obj-type
     1243              AND current_c-gds-grp-attr.obj-code = p-obj-code
     1244              AND current_c-gds-grp-attr.chip-num = p-chip-num
     1245              AND current_c-gds-grp-attr.corr-user-db-num = p-corr-user-db-num
     1246              no-error .
     1247       if not avail current_c-gds-grp-attr then do:
     1248          v-mess = "Неверная ссылка на c-gds-grp-attr в таблице c-gds-grp-attr-hist".
     1249          run err-mess in this-procedure ( input-output v-mess).
     1250          return error (if p-silent then v-mess else '':U).
     1251       end.
     1252       run grp-attr-tooltip in this-procedure (
     1253                   input  string(current_c-gds-grp-attr.attr-code)
     1254                   ,output v-tooltip
     1255                   ,output v-label
     1256                   ) no-error .
     1257       assign
     1258       p-description = "Атрибут" + chr(32) + v-label
     1259       .
     1260   define variable v-label-param as character no-undo .
     1261   v-label-param =
     1262     "node-code" + chr(4) + "Вн № группы" + chr(4) + "" + chr(8)
     1263    + "attr-code" + chr(4) + "Атрибут" + chr(4) + "" + chr(8)
     1264    + "attr-value" + chr(4) + "Значение" + chr(4) + "" + chr(8)
     1265    + "host-code" + chr(4) + "Фирма" + chr(4) + "" + chr(8)
     1266    + "obj-type" + chr(4) + "Тип объекта" + chr(4) + "" + chr(8)
     1267    + "obj-code" + chr(4) + "Код объекта" + chr(4) + ""  .
     1268    run proc-full-temp-changes in this-procedure (
     1269                                                input  (buf_c-gds-grp-hist.action = integer('1':U))
     1270                                               ,input  (buf_c-gds-grp-hist.action = integer('99':U))
     1271                                               ,input  buffer current_c-gds-grp-attr:handle
     1272                                               ,input  'gds-grp-attr':U
     1273                                               ,input  "node-code,attr-code,attr-value,host-code,obj-type,obj-code"
     1274                                               ,input  v-label-param).
     1275   end.
     1276   end procedure.
     1277   procedure gds-grp-obj-proc :
     1278   define output parameter p-description as character no-undo .
     1279   define buffer current_c-gds-grp-obj for ub.c-gds-grp-obj  .
     1280     do
     1281     on error undo, return error
     1282     :
     1283       find first current_c-gds-grp-obj no-lock where
     1284                  current_c-gds-grp-obj.node-code = p-node-code
     1285              AND current_c-gds-grp-obj.host-code = p-host-code
     1286              AND current_c-gds-grp-obj.obj-type  = p-obj-type
     1287              AND current_c-gds-grp-obj.obj-code = p-obj-code
     1288              AND current_c-gds-grp-obj.chip-num = p-chip-num
     1289              AND current_c-gds-grp-obj.corr-user-db-num = p-corr-user-db-num
     1290              no-error .
     1291       if not avail current_c-gds-grp-obj then do:
     1292          v-mess = "Неверная ссылка на c-gds-grp-obj в таблице c-gds-grp-obj-hist".
     1293          run err-mess in this-procedure ( input-output v-mess ).
     1294          return error (if p-silent then v-mess else '':U).
     1295       end.
     1296                                                define variable v-label-param as character no-undo .
     1297   v-label-param =
     1298     "node-code" + chr(4) + "Вн № группы" + chr(4) + "" + chr(8)
     1299    + "host-code" + chr(4) + "Фирма" + chr(4) + "" + chr(8)
     1300    + "obj-type" + chr(4) + "Тип объекта" + chr(4) + "" + chr(8)
     1301    + "obj-code" + chr(4) + "Код объекта" + chr(4) + "" + chr(8)
     1302    + "calc-method" + chr(4) + "Способ расчета" + chr(4) + "" + chr(8)
     1303    + "cli-code" + chr(4) + "Код поставщика" + chr(4) + "" + chr(8)
     1304    + "cli-type" + chr(4) + "Тип поставщика" + chr(4) + "" + chr(8)
     1305    + "increase-pc" + chr(4) + "% наценки" + chr(4) + "" + chr(8)
     1306    + "max-increase" + chr(4) + "Max % наценки" + chr(4) + "" + chr(8)
     1307    + "min-increase" + chr(4) + "Min % наценки" + chr(4) + "" + chr(8)
     1308    + "round-coeff" + chr(4) + "Коэф.округ." + chr(4) + "" + chr(8)
     1309    + "round-method" + chr(4) + "Метод округл." + chr(4) + ""  .
     1310    run proc-full-temp-changes in this-procedure (
     1311                                                input  (buf_c-gds-grp-hist.action = integer('1':U))
     1312                                               ,input  (buf_c-gds-grp-hist.action = integer('99':U))
     1313                                               ,input  buffer current_c-gds-grp-obj:handle
     1314                                               ,input  'gds-grp-obj':U
     1315                                               ,input  "node-code,host-code,obj-type,obj-code,calc-method,cli-code,cli-type,increase-pc,max-increase," + "min-increase,round-coeff,round-method"
     1316                                               ,input  v-label-param).
     1317   end.
     1318   end procedure.
     1319   procedure tax-rate-gds-grp-proc :
     1320   define output parameter p-description as character no-undo .
     1321   define buffer current_c-tax-rate-gds-grp for ub.c-tax-rate-gds-grp  .
     1322   define buffer buf_tax for ub.tax.
     1323     do
     1324     on error undo, return error
     1325     :
     1326       find first current_c-tax-rate-gds-grp no-lock where
     1327                  current_c-tax-rate-gds-grp.node-code = p-node-code
     1328              AND current_c-tax-rate-gds-grp.tax-code = p-tax-code
     1329              AND current_c-tax-rate-gds-grp.host-code = p-host-code
     1330              AND current_c-tax-rate-gds-grp.obj-type  = p-obj-type
     1331              AND current_c-tax-rate-gds-grp.obj-code = p-obj-code
     1332              AND current_c-tax-rate-gds-grp.chip-num = p-chip-num
     1333              AND current_c-tax-rate-gds-grp.corr-user-db-num = p-corr-user-db-num
     1334              no-error .
     1335       if not avail current_c-tax-rate-gds-grp then do:
     1336          v-mess = "Неверная ссылка на c-tax-rate-gds-grp в таблице c-tax-rate-gds-grp-hist".
     1337          run err-mess in this-procedure ( input-output v-mess).
     1338          return error (if p-silent then v-mess else '':U).
     1339       end.
     1340       find first buf_tax no-lock where buf_tax.tax-code = p-tax-code .
     1341       assign
     1342       p-description = buf_tax.tax-name
     1343       .
     1344     define variable v-label-param as character no-undo .
     1345   v-label-param =
     1346     "node-code" + chr(4) + "Вн № группы" + chr(4) + "" + chr(8)
     1347    + "host-code" + chr(4) + "Фирма" + chr(4) + "" + chr(8)
     1348    + "obj-type" + chr(4) + "Тип объекта" + chr(4) + "" + chr(8)
     1349    + "obj-code" + chr(4) + "Код объекта" + chr(4) + "" + chr(8)
     1350    + "tax-code" + chr(4) + "Код налога" + chr(4) + "" + chr(8)
     1351    + "rate-code" + chr(4) + "Код ставки налога" + chr(4) + ""  .
     1352    run proc-full-temp-changes in this-procedure (
     1353                                                input  (buf_c-gds-grp-hist.action = integer('1':U))
     1354                                               ,input  (buf_c-gds-grp-hist.action = integer('99':U))
     1355                                               ,input  buffer current_c-tax-rate-gds-grp:handle
     1356                                               ,input  'tax-rate-gds-grp':U
     1357                                               ,input  "node-code,host-code,obj-type,obj-code,tax-code,rate-code"
     1358                                               ,input  v-label-param).
     1359   end.
     1360   end procedure.
     1361   procedure dis-grp-rule-proc :
     1362   define output parameter p-description as character no-undo .
     1363   define buffer current_c-dis-grp-rule for ub.c-dis-grp-rule  .
     1364     do
     1365     on error undo, return error
     1366     :
     1367       find first current_c-dis-grp-rule no-lock where
     1368                  current_c-dis-grp-rule.classif-type = 'gds-grp':U
     1369              AND current_c-dis-grp-rule.node-code = p-node-code
     1370              AND current_c-dis-grp-rule.host-code  = p-host-code
     1371              AND current_c-dis-grp-rule.obj-type  = p-obj-type
     1372              AND current_c-dis-grp-rule.obj-code = p-obj-code
     1373              AND current_c-dis-grp-rule.chip-num = p-chip-num
     1374              AND current_c-dis-grp-rule.corr-user-db-num = p-corr-user-db-num
     1375              no-error .
     1376       if not avail current_c-dis-grp-rule then do:
     1377          v-mess = "Неверная ссылка на c-dis-grp-rule в таблице c-dis-grp-rule-hist".
     1378          run err-mess in this-procedure ( input-output v-mess).
     1379          return error (if p-silent then v-mess else '':U).
     1380       end.
     1381       define variable v-label-param as character no-undo .
     1382       v-label-param =
     1383     "rule-num" + chr(4) + "Номер правила скидки" + chr(4) + "" + chr(8)
     1384    + "pos-type" + chr(4) + "Место использ." + chr(4) + "" + chr(8)
     1385    + "templ-rl-root" + chr(4) + "Тип шаблона" + chr(4) + "disgrpru-get-disc-label"  + chr(8)
     1386    + "discnt-role" + chr(4) + "Тип скидки" + chr(4) + "disgrpru-get-disc-role-label"
     1387    .
     1388       run proc-full-temp-changes in this-procedure (
     1389                                                   input  (p-action = integer('1':U))
     1390                                                   ,input  (p-action = integer('99':U))
     1391                                                   ,input  buffer current_c-dis-grp-rule:handle
     1392                                                   ,input  'dis-grp-rule':U
     1393                                                   ,input  "rule-num,pos-type,templ-rl-root,discnt-role"
     1394                                                   ,input  v-label-param).
     1395   end.
     1396   end procedure.
     1397   procedure c-get-full-name :
     1398   do
     1399   on error undo, return error
     1400   :
     1401   define input parameter p-c          as logical no-undo .
     1402   define input parameter p-node-code  as integer      no-undo.
     1403   define input parameter p-chip-num  as integer no-undo .
     1404   define input parameter p-corr-user-db-num as integer no-undo .
     1405   define output parameter p-full-name as character    no-undo.
     1406       define variable v-upper-code    as integer           no-undo.
     1407       define variable v-c as logical no-undo .
     1408       define buffer buf_gds-grp       for ub.gds-grp.
     1409       define buffer buf_upper_gds-grp for ub.gds-grp.
     1410       define buffer buf_c-gds-grp       for ub.c-gds-grp.
     1411       define buffer buf_c-upper_gds-grp for ub.c-gds-grp.
     1412       if p-c then do:
     1413         find first buf_c-gds-grp no-lock
     1414             where buf_c-gds-grp.node-code = p-node-code
     1415               AND buf_c-gds-grp.chip-num  = p-chip-num
     1416               AND buf_c-gds-grp.corr-user-db-num  = p-corr-user-db-num
     1417         no-error.
     1418         if not available buf_c-gds-grp
     1419         then do:
     1420             undo, return error substitute("Не найдена запись истории для группа товаров: вн № &1, chip-num &2, БД-корректор &3"
     1421                                           , p-node-code
     1422                                           , p-chip-num
     1423                                           , p-corr-user-db-num
     1424                                           ).
     1425         end.
     1426       end.
     1427       else do:
     1428         find first buf_gds-grp no-lock
     1429             where buf_gds-grp.node-code = p-node-code
     1430         no-error.
     1431         if not available buf_gds-grp
     1432         then do:
     1433             undo, return error substitute("Не найдена запись группы товаров: вн № &1"
     1434                                           , p-node-code
     1435                                           ).
     1436         end.
     1437       end.
     1438       assign
     1439           p-full-name  = ""
     1440           v-upper-code = 1
     1441           v-c = p-c
     1442       .
     1443       do while
     1444       ( v-c = no and buf_gds-grp.upper-code <> 0)
     1445       or ( v-c = yes and  buf_c-gds-grp.upper-code <> 0)
     1446       on error undo, return error "Ошибка составления полного имени группы"
     1447       :
     1448           assign
     1449               p-full-name  = (if v-c = yes
     1450                               then buf_c-gds-grp.node-name
     1451                               else buf_gds-grp.node-name)
     1452                            + (if p-full-name <> "" then chr(47) else "")
     1453                            + p-full-name
     1454               v-upper-code = (if v-c
     1455                               then buf_c-gds-grp.upper-code
     1456                               else buf_gds-grp.upper-code)
     1457           .
     1458           find first buf_c-gds-grp no-lock
     1459                where buf_c-gds-grp.node-code = v-upper-code
     1460                  AND buf_c-gds-grp.chip-num  > p-chip-num
     1461                  AND buf_c-gds-grp.corr-user-db-num  > p-corr-user-db-num no-error .
     1462           if not available buf_c-gds-grp then do:
     1463             assign
     1464             v-c = no
     1465             .
     1466             find first buf_gds-grp no-lock
     1467                 where buf_gds-grp.node-code = v-upper-code
     1468             no-error.
     1469             if not available buf_gds-grp
     1470             then do:
     1471                 undo, return error substitute("Не найдена группа товаров с кодом &1" +
     1472                                                ". Ошибка ссылки в дереве товаров для записи истории групп товаров:" +
     1473                                                "вн № &2, chip-num &3, БД-корректор &4"
     1474                                               ,  v-upper-code
     1475                                               ,  p-node-code
     1476                                               , p-chip-num
     1477                                               , p-corr-user-db-num).
     1478             end.
     1479           end.
     1480           else do:
     1481             assign
     1482             v-c = yes
     1483             .
     1484           end.
     1485       end.
     1486       assign
     1487       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1488       .
     1489   end.
     1490   end procedure.
     1491   PROCEDURE err-mess:
     1492     DEFINE INPUT-output PARAMETER p-mess as character No-UNDO.
     1493     CASE p-silent:
     1494       when yes then do:
     1495         assign
     1496         p-mess = substitute("История групп товаров&1" +
     1497                             "Вн Код группы: &2&1" +
     1498                             "щепка &3 БД:&4&1&5&6"
     1499                             ,chr(10)
     1500                             ,p-node-code
     1501                             ,p-chip-num
     1502                             ,p-corr-user-db-num
     1503                             ,chr(10)
     1504                             ,p-mess).
     1505       end.
     1506       otherwise do:
     1507         message
     1508         p-mess
     1509         view-as alert-box error .
     1510       end.
     1511     end.
     1512   END PROCEDURE.
