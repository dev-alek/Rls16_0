     3025                 and buf_temp-browse-handle.browse-handle = v-object-handle
     3026               no-error .
     3027             if available buf_temp-browse-handle
     3028             then do:
     3029             end.
     3030             else do:
     3031               create buf_temp-diasize-handle .
