      870   ~
      871   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      872   procedure discfgru-check :
      873   define input parameter p-table-name as character no-undo .
      874   define input parameter p-templ-rl-root as integer no-undo .
      875   define input parameter p-time-templ-rl-root as integer no-undo .
      876   define input parameter p-pos-type as character no-undo .
      877   define output parameter p-disnct-role as character no-undo .
      878   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      879     do
      880     on error undo, return error return-value
      881     :
      882       find first buf_dis-cfg-rule no-lock where
      883               buf_dis-cfg-rule.table-name = p-table-name
      884           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
      885           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
      886           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
      887       if not available buf_dis-cfg-rule
      888       or p-pos-type = "":U
      889       then do:
      890          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
      891                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
      892                                  , p-templ-rl-root
      893                                  , (if p-time-templ-rl-root = ?
      894                                     then '':U
      895                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
      896                                     )
      897                                  ).
      898       end.
      899       assign
      900       p-disnct-role = buf_dis-cfg-rule.discnt-role
      901       .
      902     end.
      903   end procedure.
      904   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      905   FUNCTION get-region RETURNS CHARACTER
      906     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      907     define variable par-region as character no-undo.
      908     if parhost-code = 0 and
      909          parobj-type = "":U and
      910          parobj-code = 0 then do:
      911          par-region = "Глобально".
      912          return par-region.
      913       end.
      914       if parobj-type = 'орг':U then do:
      915          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      916          return par-region.
      917       end.
      918       if parobj-type = 'регион':U
      919       then do:
      920          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      921          return par-region.
      922       end.
      923       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      924       return par-region.
      925   END FUNCTION.
      926   FUNCTION get-objregion RETURNS CHARACTER
      927     (  input parobj-type as character, input parobj-code as integer ) :
      928     define variable par-region as character no-undo.
      929     if  parobj-type = "":U and
      930         parobj-code = 0
      931     then do:
      932        par-region = "Глобально".
      933     end.
      934     else if parobj-type = 'орг':U
      935     then do:
      936        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      937     end.
      938     else if parobj-type = 'регион':U
      939     then do:
      940        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      941     end.
      942     else
      943        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      944     return par-region.
      945   END FUNCTION.
      946   procedure disgdsru-name :
      947   define buffer buf_dis-rule for ub.dis-rule.
      948   do
      949     on error undo, return error
      950     :
      951     define input  parameter p-templ-rl-root  as integer no-undo .
      952     define output parameter p-label          as character no-undo .
      953     find first buf_dis-rule no-lock where
      954               buf_dis-rule.rule-num = p-templ-rl-root no-error.
      955     if available buf_dis-rule
      956     then do:
      957       if buf_dis-rule.rule-num > 0 then
      958       p-label = buf_dis-rule.des.
      959     end.
      960     else do:
      961       p-label = substitute("Неизвестный тип правила скидки &1", p-templ-rl-root).
      962     end.
      963   end.
      964   end procedure.
      965   function disgdsru-get-disc-label returns character ( input p-templ-rl-root as integer):
      966   define variable v-rule-label as character no-undo .
      967   run disgdsru-name in this-procedure ( input p-templ-rl-root
      968                                        ,output v-rule-label) no-error.
      969   return v-rule-label.
      970   end function.
      971   function disgdsru-get-disc-role-label returns character ( input p-discnt-role as character):
      972   define variable v-rule-label as character no-undo .
      973   return entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u).
      974   end function.
      975   procedure disgdsru-write :
      976     do
      977     on error undo, return error
      978     :
      979       define input parameter p-obj-type       like ub.dis-gds-rule.obj-type   no-undo .
      980       define input parameter p-obj-code       like ub.dis-gds-rule.obj-code   no-undo .
      981       define input parameter p-gds-code       like ub.dis-gds-rule.gds-code   no-undo .
      982       define input parameter p-pos-type       like ub.dis-gds-rule.pos-type   no-undo .
      983       define input parameter p-discnt-role    like ub.dis-gds-rule.discnt-role no-undo .
      984       define input parameter p-templ-rl-root  like ub.dis-gds-rule.templ-rl-root  no-undo .
      985       define input parameter p-time-templ-rl-root  like ub.dis-gds-rule.time-templ-rl-root  no-undo .
      986       define input parameter p-rule-num       like ub.dis-gds-rule.rule-num    no-undo .
      987       define input parameter p-nonunique      like ub.dis-gds-rule.nonunique   no-undo .
      988       define buffer buf_dis-gds-rule for ub.dis-gds-rule .
      989       define buffer buf_dis-rule for ub.dis-rule.
      990       define buffer lock_dis-gds-rule for ub.dis-gds-rule .
      991       define variable v-label          as character no-undo .
      992       define variable v-discnt-role as character no-undo .
      993       run discfgru-check in this-procedure (
      994                                             input 'dis-gds-rule':U
      995                                            ,input p-templ-rl-root
      996                                            ,input p-time-templ-rl-root
      997                                            ,input p-pos-type
      998                                            ,output v-discnt-role
      999                                             ) no-error .
     1000       if error-status :error then do:
     1001         undo, return error return-value .
     1002       end.
     1003       if p-discnt-role = ? then do:
     1004         p-discnt-role = v-discnt-role.
     1005       end.
     1006       if p-discnt-role <> v-discnt-role then do:
     1007         undo, return error substitute("Товар &1 &2&3 место использ. &4 скидка типа &5&6не может быть по шаблону &7 и расписанию &8"
     1008                                 ,p-gds-code
     1009                                 ,p-obj-type
     1010                                 ,p-obj-code
     1011                                 ,p-pos-type
