     3171           or error-status :get-message(1) <> ""
     3172           then do:
     3173             undo move_block, retry move_block .
     3174           end.
     3175         end.
     3176       end.
     3177       if p-move-resize = true
     3178       then do:
     3179         run diasize_position-resize-button in this-procedure .
     3180       end.
     3181       if v-diasize-wndstore = true
     3182       then do:
     3183         if connected("ub") = true
     3184         then do:
     3185           define variable v-cntxt-db-num        as integer   no-undo .
     3186           define variable v-cntxt-userid        as character no-undo .
     3187           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3188                                             , OUTPUT v-cntxt-userid
     3189                                             ) .
     3190           run gbl/wndsizew.p
     3191             (input  v-cntxt-db-num
     3192             ,input  v-cntxt-userid
     3193             ,input  v-diasize-proc-name
     3194             ,input  'height':u
     3195             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     3196             ) .
     3197         end.
     3198       end.
     3199     end.
     3200     assign
     3201       v-diasize-change-size = false
     3202     .
     3203   end procedure.
     3204   procedure diasize_set-height :
     3205     define input  parameter p-new-height  as decimal   no-undo .
     3206     define input  parameter p-move-resize as logical   no-undo .
     3207     do
