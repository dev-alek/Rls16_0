     1146   PROCEDURE cmp-disgdsru-write :
     1147   do
     1148   on error undo, return error
     1149   :
     1150     define input parameter p-gds-code like ub.dis-gds-rule.gds-code   no-undo .
     1151     define input parameter p-obj-type like ub.dis-gds-rule.obj-type   no-undo .
     1152     define input parameter p-obj-code like ub.dis-gds-rule.obj-code   no-undo .
     1153     define input parameter p-pos-type like ub.dis-gds-rule.pos-type   no-undo .
     1154     define input parameter p-templ-rl-root     like ub.dis-gds-rule.templ-rl-root  no-undo .
     1155     define input parameter p-time-templ-rl-root     like ub.dis-gds-rule.time-templ-rl-root  no-undo .
     1156     define input parameter p-discnt-role like ub.dis-gds-rule.discnt-role no-undo .
     1157     define input parameter p-rule-num    like ub.dis-gds-rule.rule-num no-undo .
     1158     define input parameter p-nonunique like ub.dis-gds-rule.nonunique no-undo .
     1159     define variable v-rule-label          as character no-undo .
     1160     define buffer buf_tt0-dis-gds-rule for ub.dis-gds-rule .
     1161     define buffer buf_dis-rule     for ub.dis-rule.
     1162     run disgdsru-name in this-procedure (
     1163                                         input  p-templ-rl-root
     1164                                         ,output v-rule-label
     1165                                         ) no-error .
     1166     if error-status :error then do:
     1167       undo, return error return-value .
     1168     end.
     1169     find first buf_tt0-dis-gds-rule exclusive-lock where
     1170                 buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     1171             AND buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     1172             AND buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     1173             AND buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     1174             AND buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     1175             AND buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1176             no-error .
     1177     if not available buf_tt0-dis-gds-rule then do:
     1178       create buf_tt0-dis-gds-rule .
     1179       assign
     1180       buf_tt0-dis-gds-rule.gds-code  = p-gds-code
     1181       buf_tt0-dis-gds-rule.obj-type  = p-obj-type
     1182       buf_tt0-dis-gds-rule.obj-code  = p-obj-code
     1183       buf_tt0-dis-gds-rule.pos-type  = p-pos-type
     1184       buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1185       buf_tt0-dis-gds-rule.discnt-role = p-discnt-role
     1186       no-error
     1187       .
     1188     end.
     1189     find first buf_dis-rule no-lock where
     1190               buf_dis-rule.rule-num = p-rule-num.
     1191     ASSIGN
     1192     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     1193     buf_tt0-dis-gds-rule.rule-num = p-rule-num
     1194     buf_tt0-dis-gds-rule.time-templ-rl-root = p-time-templ-rl-root
     1195     buf_tt0-dis-gds-rule.nonunique = p-nonunique
     1196     buf_tt0-dis-gds-rule.templ-rl-root = p-templ-rl-root
     1197     buf_tt0-dis-gds-rule.rl-root = buf_Dis-rule.rl-root
     1198     no-error.
     1199     release buf_tt0-dis-gds-rule no-error .
     1200     if error-status:error then do:
     1201       undo, return error return-value .
     1202     end.
     1203   end.
     1204   END PROCEDURE.
     1205   procedure disgdsru-edit :
     1206   define input parameter p-mode as character no-undo .
     1207   define input parameter p-gds-code like ub.dis-gds-rule.gds-code no-undo .
     1208   define input parameter p-obj-type like ub.dis-gds-rule.obj-type no-undo .
     1209   define input parameter p-obj-code like ub.dis-gds-rule.obj-code no-undo .
     1210   define input parameter p-pos-type like ub.dis-gds-rule.pos-type no-undo .
     1211   define input parameter p-discnt-role like ub.dis-gds-rule.discnt-role no-undo .
     1212   define input parameter p-templ-rl-root like ub.dis-gds-rule.templ-rl-root no-undo .
     1213   define input parameter p-time-templ-rl-root like ub.dis-gds-rule.time-templ-rl-root no-undo .
     1214   define input parameter p-cfg-NONUNIQUE as character no-undo .
     1215   define input parameter p-check as integer no-undo .
     1216   define input-output parameter p-rule-num as integer no-undo .
     1217   define input-output parameter p-NONUNIQUE like ub.dis-gds-rule.NONUNIQUE no-undo .
     1218   define output parameter p-setted as logical no-undo .
     1219   define variable v-sts as integer no-undo .
     1220   define variable v-rid-list as character no-undo .
     1221   define variable r-b-code like ub.bar-code.b-code no-undo .
     1222   define variable v-label as character no-undo .
     1223   DEFINE VARIABLE v-rule-num as integer no-undo .
     1224   define variable v-cd-dr-correct  as logical no-undo .
     1225   define variable jj as integer no-undo .
     1226   define variable conf-par as character no-undo .
     1227   define variable conf-attr as character no-undo .
     1228   define variable par-type as character no-undo .
     1229   define variable dflt-cd as character no-undo .
     1230   define variable v-cd-list as character no-undo .
     1231   define variable v-is-time-rule as logical no-undo .
     1232   define variable v-nonunique as character no-undo .
     1233   define variable v-mode as character no-undo .
     1234   define variable v-time-templ-rl-root as integer   no-undo .
     1235   define variable v-cfg-nonunique as character no-undo .
     1236   define buffer buf_dis-gds-rule for ub.dis-gds-rule.
     1237   define buffer buf_dis-rule for ub.dis-rule.
     1238   define buffer buf_dis-time-rule for ub.dis-time-rule .
     1239   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     1240   define buffer term_dis-rule for ub.dis-rule.
     1241   define buffer buf_temp-disc for temp-disc.
     1242   assign
     1243   v-rule-num = p-rule-num.
     1244   v-sts = integer('0':U).
     1245   if v-rule-num <> 0
     1246   and v-rule-num <> ?
     1247   then do:
     1248     find first buf_dis-rule no-lock where
     1249               buf_dis-rule.rule-num = v-rule-num no-error .
     1250     if error-status:error then do:
     1251       message
     1252       "Ошибка при поиске правила с номером" v-rule-num
     1253       view-as alert-box error .
     1254       return .
     1255     end.
     1256     assign
     1257     v-rid-list = string(recid(buf_dis-rule))
     1258     .
     1259   end.
     1260   if p-gds-code <> 0 then do:
     1261   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1262     (input  p-gds-code
     1263     ,input  ?
     1264     ,output r-b-code
     1265     )  .
     1266   end.
     1267   run disgdsru-name in this-procedure (
     1268                                     input p-templ-rl-root
     1269                                    ,output v-label) no-error.
     1270   if p-pos-type = ?
     1271   or p-pos-type = '':U then do:
     1272   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1273   define variable v-param-type13 as character no-undo .
     1274   define variable v-value-date13 as date no-undo .
     1275   define variable v-value-decimal13 as decimal no-undo .
     1276   define variable v-value-integer13 as INTEGER no-undo .
     1277   define variable v-value-logical13 AS LOGICAL no-undo .
     1278   define variable v-tth13 as handle no-undo .
     1279   run adm/shattri.p (
     1280       input "get":U
     1281       ,input  p-obj-type
     1282       ,input  p-obj-code
     1283       ,input  'cd-sending':U
     1284       ,input  'dflt-cd':U
     1285       ,output dflt-cd
     1286       ,output v-value-date13
     1287       ,output v-value-decimal13
     1288       ,output v-value-integer13
     1289       ,output v-value-logical13
     1290       ,output v-param-type13
     1291       ,INPUT-OUTPUT table-handle v-tth13
     1292       )  .
     1293   delete object v-tth13 no-error.
     1294   end.
     1295   else do:
     1296     dflt-cd = p-pos-type.
     1297   end.
     1298   v-mode = (if p-obj-type = 'маг':U
     1299             or p-obj-type = 'скл':U
     1300             then (if p-gds-code = 0 then "upper-rule-num-all-obj" else "upper-rule-num-gds-obj":U)
     1301             else ('dis-gds-rule':U + "=" + p-discnt-role)).
     1302   if p-discnt-role <> ''
     1303   and p-pos-type <> '' then do:
     1304     find first buf_dis-cfg-rule no-lock where
     1305               buf_dis-cfg-rule.table-name = 'dis-gds-rule':U
     1306           and buf_dis-cfg-rule.discnt-role = p-discnt-role
     1307           and buf_dis-cfg-rule.pos-type = p-pos-type
     1308           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
     1309           no-error .
     1310     if available buf_dis-cfg-rule then do:
     1311       assign
     1312       v-cfg-nonunique = buf_dis-cfg-rule.nonunique.
     1313     end.
     1314   end.
     1315   if v-cfg-nonunique <> ''
     1316   and num-entries(v-cfg-nonunique, ".") > 1
     1317   then do:
     1318     case v-cfg-nonunique:
     1319       when "bar-code.b-code" then do:
     1320         r-b-code = integer(p-nonunique).
     1321       end.
     1322     end case.
     1323   end.
     1324   run ref/dis-ruls.w (
     1325                input parparentproc
     1326               ,input 0
     1327               ,input p-obj-type
     1328               ,input p-obj-code
     1329               ,input "b-add,b-sel":U
     1330               ,input v-mode
     1331               ,input p-templ-rl-root
     1332               ,input p-time-templ-rl-root
     1333               ,input r-b-code
     1334               ,input-output v-sts
     1335               ,input-output v-rid-list ) no-error .
     1336   do
     1337   on error undo, return error return-value
     1338   :
     1339     if v-rid-list <> "":U then do:
     1340       find first buf_dis-rule exclusive-lock where
     1341                   recid(buf_dis-rule) = integer(v-rid-list) no-wait no-error .
     1342       if not available buf_dis-rule
     1343       then do:
     1344         message
     1345         "Ошибка при поиске правила с recid" v-rid-list
     1346         view-as alert-box error .
     1347         return .
     1348       end.
     1349       if buf_dis-rule.sts <> integer('0':U) then do:
     1350         message
     1351         "Правило скидки имеет статус" entry (lookup (string(buf_dis-rule.sts), '0,1,2,99,98':U), 'исп,не-исп,детализ,удаление,запр.удал':U) skip
     1352         "Нельзя привязать к нему скидку на товар"
     1353         view-as alert-box error .
     1354         return .
     1355       end.
     1356       find first buf_dis-cfg-rule no-lock where
     1357               buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
     1358           and buf_dis-cfg-rule.time-templ-rl-root = (if buf_dis-rule.time-templ-rl-root = 0
     1359                                                      then 0
     1360                                                      else buf_dis-rule.time-templ-rl-root)
     1361           and buf_dis-cfg-rule.pos-type = dflt-cd
     1362           and buf_dis-cfg-rule.table-name = 'dis-gds-rule':U
     1363           no-error.
     1364       if available buf_dis-cfg-rule then do:
     1365         assign
     1366         v-cd-dr-correct = yes
     1367         .
     1368       end.
     1369       else do:
     1370          if buf_dis-rule.is-term = no then do:
     1371            for each term_dis-rule no-lock where
     1372               term_dis-rule.upper-rule-num = buf_dis-rule.rule-num:
     1373              find first buf_dis-cfg-rule no-lock where
     1374                     buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
     1375                 and buf_dis-cfg-rule.time-templ-rl-root = term_dis-rule.time-templ-rl-root
     1376                 and buf_dis-cfg-rule.pos-type = dflt-cd
     1377                 and buf_dis-cfg-rule.table-name = 'dis-gds-rule':U
     1378                 no-error.
     1379              if available buf_dis-cfg-rule
     1380              and v-time-templ-rl-root = 0
     1381              then do:
     1382                 v-time-templ-rl-root = term_dis-rule.time-templ-rl-root.
     1383                 v-cd-dr-correct = yes.
     1384              end.
     1385              if not available buf_dis-cfg-rule
     1386              or v-time-templ-rl-root <> term_dis-rule.time-templ-rl-root then do:
     1387                v-cd-dr-correct = no.
     1388                leave.
     1389              end.
     1390            end.
     1391          end.
     1392       end.
     1393       if not v-cd-dr-correct
     1394       then do:
     1395         message
     1396         substitute("Правило скидки &1 неприменимо для касс &2.&3" +
     1397                   "(АРМ АДМИНИСТРАТОР-Магазины(Фирмы)-Параметры-Общие опции коммуникации с кассами)"
     1398                   ,buf_dis-rule.rule-num
     1399                   ,dflt-cd
     1400                   ,chr(10)
     1401                   )
     1402         view-as alert-box error .
     1403         undo, return error .
     1404       end.
     1405       assign
     1406       v-nonunique = if p-cfg-nonunique = '':U
     1407                     then '':U
     1408                     else (if p-cfg-nonunique begins "@"
     1409                           then left-trim(p-cfg-nonunique, "@")
     1410                           else string(buffer buf_Dis-rule:handle:buffer-field(p-cfg-nonunique):buffer-value)
     1411                           )
     1412                     .
     1413       if p-check = 0
     1414       or p-check = 2
     1415       then do:
     1416         find first buf_dis-gds-rule no-lock where
     1417                     buf_dis-gds-rule.obj-type = p-obj-type
     1418                 and buf_dis-gds-rule.obj-code = p-obj-code
     1419                 and buf_dis-gds-rule.gds-code = p-gds-code
     1420                 and buf_dis-gds-rule.pos-type = p-pos-type
     1421                 and buf_dis-gds-rule.discnt-role = p-discnt-role
     1422                 and buf_dis-gds-rule.nonunique = v-nonunique no-error .
     1423         if available buf_dis-gds-rule
     1424         and p-mode <> 'ИЗМЕНЕНИЕ':U
     1425         then do:
     1426           message
     1427           "Скидка такого типа на данный товар уже существует"
     1428           view-as alert-box error .
     1429           return error.
     1430         end.
     1431         find first buf_dis-gds-rule no-lock where
     1432                     buf_dis-gds-rule.obj-type = p-obj-type
     1433                 and buf_dis-gds-rule.obj-code = p-obj-code
     1434                 and buf_dis-gds-rule.gds-code = p-gds-code
     1435                 and buf_dis-gds-rule.pos-type = p-pos-type
     1436                 and buf_dis-gds-rule.discnt-role = p-discnt-role
     1437                 no-error .
     1438         if v-nonunique = ''
     1439         and available buf_dis-gds-rule
     1440         and p-mode <> 'ИЗМЕНЕНИЕ':U
     1441         then do:
     1442           message
     1443           "Скидка такого типа на данный товар уже существует"
     1444           view-as alert-box error .
     1445           return error.
     1446         end.
     1447         if available buf_dis-gds-rule
     1448         and buf_dis-gds-rule.nonunique = ''
     1449         and v-nonunique <> ''
     1450         and p-mode <> 'ИЗМЕНЕНИЕ':U
     1451         then do:
     1452           message
     1453           "Скидка такого типа на данный товар уже существует"
     1454           view-as alert-box error .
     1455           return error.
     1456         end.
     1457       end.
     1458       if p-check = 1
     1459       or p-check = 2
     1460       then do:
     1461         find first buf_temp-disc no-lock where
     1462                     buf_temp-disc.obj-type = p-obj-type
     1463                 and buf_temp-disc.obj-code = p-obj-code
     1464                 and buf_temp-disc.pos-type = p-pos-type
     1465                 and buf_temp-disc.discnt-role = p-discnt-role
     1466                 and buf_temp-disc.nonunique = v-nonunique no-error .
     1467         if available buf_temp-disc
     1468         and buf_temp-disc.rule-num <> 0
     1469         and p-mode <> 'ИЗМЕНЕНИЕ':U
     1470         then do:
     1471           message
     1472           "Скидка такого типа на данный товар уже существует"
     1473           view-as alert-box error .
     1474           return error.
     1475         end.
     1476         find first buf_temp-disc no-lock where
     1477                     buf_temp-disc.obj-type = p-obj-type
     1478                 and buf_temp-disc.obj-code = p-obj-code
     1479                 and buf_temp-disc.pos-type = p-pos-type
     1480                 and buf_temp-disc.discnt-role = p-discnt-role
     1481                 no-error .
     1482         if v-nonunique = ''
     1483         and available buf_temp-disc
     1484         and p-mode <> 'ИЗМЕНЕНИЕ':U
     1485         then do:
     1486           message
     1487           "Скидка такого типа на данный товар уже существует"
     1488           view-as alert-box error .
     1489           return error.
     1490         end.
     1491         if available buf_temp-disc
     1492         and buf_temp-disc.nonunique = ''
     1493         and v-nonunique <> ''
     1494         and p-mode <> 'ИЗМЕНЕНИЕ':U
     1495         then do:
     1496           message
     1497           "Скидка такого типа на данный товар уже существует"
     1498           view-as alert-box error .
     1499           return error.
     1500         end.
     1501       end.
     1502       if p-rule-num <> buf_dis-rule.rule-num then do:
     1503         assign
     1504         p-setted = yes
     1505         p-rule-num = buf_dis-rule.rule-num
     1506         p-nonunique = v-nonunique
     1507         .
     1508       end.
     1509     end.
     1510   end.
     1511   end procedure.
     1512   procedure dsp-dis-rule :
     1513   define input parameter p-gds-code like ub.dis-gds-rule.gds-code no-undo .
     1514   define input parameter p-nonunique as character no-undo .
     1515   define input parameter p-obj-type like ub.dis-gds-rule.obj-type no-undo .
     1516   define input parameter p-obj-code like ub.dis-gds-rule.obj-code no-undo .
     1517   define input parameter p-discnt-role as character no-undo .
     1518   define input parameter p-pos-type as character no-undo .
     1519   define input parameter p-value like ub.dis-gds-rule.rule-num no-undo .
     1520   define buffer buf_dis-rule for ub.dis-rule.
     1521   DEFINE variable loc#log as logical no-undo.
     1522   define variable loc-doc-rec as recid no-undo .
     1523   define variable r-b-code like ub.bar-code.b-code no-undo .
     1524   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     1525   define variable v-cfg-nonunique as character no-undo .
     1526     do
     1527     on error undo, return error
     1528     :
     1529       find first buf_dis-rule no-lock where
     1530                 buf_dis-rule.rule-num = p-value no-error .
     1531       if not available buf_dis-rule then do:
     1532         message substitute("Не найдено правило скидки с номером &1", p-value)
     1533         view-as alert-box error .
     1534         .
     1535         return.
     1536       end.
     1537   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1538   do:
     1539     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1540       (input  v-cntxt-db-num
     1541       ,input  v-cntxt-userid
     1542       ,input  0
     1543       ,input  'actn_discount_work':U
     1544       ,input  'global':U
     1545       ,input  0
     1546       ,input  '':U
     1547       ,input  0
     1548       ,input  0
     1549       ,input  0
     1550       ,input  0
     1551       ,input  true
     1552       ,output loc#log
     1553       )  .
     1554   end.
     1555       if not loc#log then return error.
     1556       ASSIGN
     1557       loc-doc-rec = recid(buf_dis-rule)
     1558       .
     1559       if p-gds-code <> ? then do:
     1560   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1561     (input  p-gds-code
     1562     ,input  ?
     1563     ,output r-b-code
     1564     )  .
     1565       end.
     1566       define variable v-form-name as character no-undo init "ref/dis-ruli.w".
     1567       run disrules-get-interface-form in this-procedure ( input buf_dis-rule.templ-rl-root
     1568                                                         ,output v-form-name) .
     1569       if p-discnt-role <> ''
     1570       and p-pos-type <> '' then do:
     1571         find first buf_dis-cfg-rule no-lock where
     1572                   buf_dis-cfg-rule.table-name = 'dis-gds-rule':U
     1573               and buf_dis-cfg-rule.discnt-role = p-discnt-role
     1574               and buf_dis-cfg-rule.pos-type = p-pos-type
     1575               and buf_dis-cfg-rule.templ-rl-root = buf_dis-rule.templ-rl-root
     1576               no-error .
     1577         if available buf_dis-cfg-rule then do:
     1578           assign
     1579           v-cfg-nonunique = buf_dis-cfg-rule.nonunique.
     1580         end.
     1581       end.
     1582       if v-cfg-nonunique <> ''
     1583       and num-entries(v-cfg-nonunique, ".") > 1
     1584       then do:
     1585         case v-cfg-nonunique:
     1586           when "bar-code.b-code" then do:
     1587             r-b-code = integer(p-nonunique).
     1588           end.
     1589         end case.
     1590       end.
     1591       run value(v-form-name) (
     1592                        input parparentproc
     1593                       ,input 'ПРОСМОТР':U
     1594                       ,input buf_dis-rule.templ-rl-root
     1595                       ,input buf_dis-rule.host-code
     1596                       ,input buf_dis-rule.obj-type
     1597                       ,input buf_dis-rule.obj-code
     1598                       ,input buf_dis-rule.rule-num
     1599                       ,input buf_dis-rule.upper-rule-num
     1600                       ,input r-b-code
     1601                       ,input buf_dis-rule.time-templ-rl-root
     1602                       ,input '':U
     1603                       ,input-output loc-doc-rec
     1604                                   )
     1605       .
     1606     end.
     1607   end procedure.
     1608   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1609   procedure gen-b-code :
     1610     define input  parameter type-code like ub.code-range.range-type no-undo .
     1611     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
     1612     do
     1613     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1614     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
     1615     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
     1616     :
     1617       define buffer buf_thbj-attr     for ub.thbj-attr .
     1618       define buffer buf_sys-ctrl   for ub.sys-ctrl .
     1619       define buffer buf_code-range for ub.code-range .
     1620       define variable l-code         as   integer              no-undo .
     1621       define variable v-db-num       like ub.db.db-num         no-undo .
     1622       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
     1623       if type-code = 'sslc':U
     1624       or type-code = 'ssgb':U
     1625       then do:
     1626         message
     1627           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
     1628           "Обратитесь к администратору системы."
     1629           view-as alert-box error .
     1630         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
     1631       end.
     1632       run trg/getpcode.p ( input  type-code
     1633                      ,output cfg-param-code
     1634                     ).
     1635       run get-next-seq( input  type-code,
     1636                         output l-code
     1637                       ).
     1638       find first buf_sys-ctrl no-lock.
     1639       if type-code = 'sclc':U
     1640       or type-code = 'pglc':U
     1641       then do:
     1642         assign
     1643           v-db-num = 0
     1644         .
     1645       end.
     1646       else do:
     1647         assign
     1648           v-db-num = buf_sys-ctrl.db-num
     1649         .
     1650       end.
     1651       find first buf_code-range no-lock
     1652         where buf_code-range.db-num     = v-db-num
     1653           and buf_code-range.range-type = type-code
     1654           and buf_code-range.stts       = "a"
     1655         use-index stts
     1656         no-error .
     1657       if available buf_code-range
     1658          and l-code <= buf_code-range.last-code
     1659          and l-code >= buf_code-range.first-code then do:
     1660         assign
     1661           p-b-code = l-code
     1662         .
     1663       end.
     1664       else do:
     1665         if available buf_code-range
     1666            and l-code < buf_code-range.last-code then do:
     1667           message
     1668             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
     1669             "Обратитесь к администратору системы."
     1670             view-as alert-box error .
     1671           undo, return error "sequence":U .
     1672         end.
     1673         do transaction
     1674         on error undo, return error
     1675         :
     1676           find first buf_thbj-attr exclusive-lock
     1677             where buf_thbj-attr.upper-prop-code = 'code-range':U
     1678               and buf_thbj-attr.prop-code = cfg-param-code
     1679               and buf_thbj-attr.obj-type   = 'БД':U
     1680               and buf_thbj-attr.obj-code   = v-db-num
     1681             no-error .
     1682           if not available buf_thbj-attr then do:
     1683             find first buf_thbj-attr exclusive-lock
     1684               where buf_thbj-attr.upper-prop-code = 'code-range':U
     1685                 and buf_thbj-attr.prop-code = cfg-param-code
     1686                 and buf_thbj-attr.obj-type   = ''
     1687                 and buf_thbj-attr.obj-code   = 0
     1688               no-error .
     1689             if not available buf_thbj-attr then do:
     1690               if not locked buf_thbj-attr then do:
     1691                 message
     1692                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
     1693                   "Обратитесь к администратору системы."
     1694                   view-as alert-box error .
     1695               end.
     1696               undo, return error "config":U .
     1697             end.
     1698           end.
     1699           run get-next-seq( input type-code,
     1700                             output l-code
     1701                           ).
     1702           find first buf_code-range
     1703             where buf_code-range.db-num     = v-db-num
     1704               and buf_code-range.range-type = type-code
     1705               and buf_code-range.stts       = "a"
     1706             use-index stts
     1707             no-error .
     1708           if available buf_code-range
     1709           and l-code <= buf_code-range.last-code
     1710           and l-code >= buf_code-range.first-code
     1711           then do:
     1712             assign
     1713               p-b-code = l-code
     1714             .
     1715           end.
     1716           else do:
     1717             if available buf_code-range then do:
     1718               assign
     1719                 buf_code-range.stts = "u"
     1720               .
     1721             end.
     1722             find first buf_code-range
     1723               where buf_code-range.db-num     = v-db-num
     1724                 and buf_code-range.range-type = type-code
     1725                 and buf_code-range.stts       = "f"
     1726               use-index stts
     1727               no-error .
     1728             if not available buf_code-range then do:
     1729               message
     1730                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
     1731                 "Обратитесь к администратору системы"
     1732                 view-as alert-box error .
     1733               undo, return error "code-range":U .
     1734             end.
     1735             assign
     1736               buf_code-range.stts           = "a"
     1737             .
     1738             if buf_code-range.first-code = 1 then do:
     1739               run set-seq-cr( input type-code,
     1740                               input buf_code-range.first-code
     1741                             ).
     1742               assign
     1743                 p-b-code = 1
     1744               .
     1745             end.
     1746             else do:
     1747               run set-seq-cr( input type-code,
     1748                               input ( buf_code-range.first-code - 1 )
     1749                             ).
     1750               run get-next-seq( input type-code,
     1751                                 output p-b-code
     1752                               ).
     1753             end.
     1754           end.
     1755         end.
     1756       end.
     1757     end.
     1758   end procedure.
     1759   procedure get-next-seq :
     1760     define input  parameter type-code like ub.code-range.range-type no-undo .
     1761     define output parameter next-seq  as   integer                  no-undo .
     1762     do
     1763     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1764     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
     1765     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
     1766     :
     1767       case type-code:
     1768         when 'bcgb':U then do:
     1769           assign
     1770             next-seq = next-value(s-bcgb-code, ub)
     1771           .
     1772         end.
     1773         when 'scgb':U then do:
     1774           assign
     1775             next-seq = next-value(s-scgb-code, ub)
     1776           .
     1777         end.
     1778         when 'sclc':U then do:
     1779           assign
     1780             next-seq = next-value(s-sclc-code, ub)
     1781           .
     1782         end.
     1783         when 'pglc':U then do:
     1784           assign
     1785             next-seq = next-value(s-pglc-code, ub)
     1786           .
     1787         end.
     1788         when 'dcgb':U then do:
     1789           assign
     1790             next-seq = next-value(s-dcgb-code, ub)
     1791           .
     1792         end.
     1793         when 'ctgb':U then do:
     1794           assign
     1795             next-seq = next-value(s-ctgb-code, ub)
     1796           .
     1797         end.
     1798         when 'drgb':U then do:
     1799           assign
     1800             next-seq = next-value(s-drgb-code, ub)
     1801           .
     1802         end.
     1803         when 'fmgb':U then do:
     1804           assign
     1805             next-seq = next-value(s-fmgb-code, ub)
     1806           .
     1807         end.
     1808         when 'pngb':U then do:
     1809           assign
     1810             next-seq = next-value(s-pngb-code, ub)
     1811           .
     1812         end.
     1813         when 'cagb':U then do:
     1814           assign
     1815             next-seq = next-value(s-cagb-code, ub)
     1816           .
     1817         end.
     1818         when 'fdgb':U then do:
     1819           assign
     1820             next-seq = next-value(s-fin-doc, ub)
     1821           .
     1822         end.
     1823       end case.
     1824     end.
     1825   end procedure.
     1826   procedure set-seq-cr :
     1827     define input parameter type-code like ub.code-range.range-type no-undo .
     1828     define input parameter set-val   like ub.code-range.first-code no-undo .
     1829     do
     1830     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1831     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
     1832     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
     1833     :
     1834       case type-code:
     1835         when 'bcgb':U then do:
     1836           assign
     1837             current-value(s-bcgb-code, ub) = set-val
     1838           .
     1839         end.
     1840         when 'scgb':U then do:
     1841           assign
     1842             current-value(s-scgb-code, ub) = set-val
     1843           .
     1844         end.
     1845         when 'sclc':U then do:
     1846           assign
     1847             current-value(s-sclc-code, ub) = set-val
     1848           .
     1849         end.
     1850         when 'pglc':U then do:
     1851           assign
     1852             current-value(s-pglc-code, ub) = set-val
     1853           .
     1854         end.
     1855         when 'dcgb':U then do:
     1856           assign
     1857             current-value(s-dcgb-code, ub) = set-val
     1858           .
     1859         end.
     1860         when 'ctgb':U then do:
     1861           assign
     1862             current-value(s-ctgb-code, ub) = set-val
     1863           .
     1864         end.
     1865         when 'drgb':U then do:
     1866           assign
     1867             current-value(s-drgb-code, ub) = set-val
     1868           .
     1869         end.
     1870         when 'fmgb':U then do:
     1871           assign
     1872             current-value(s-fmgb-code, ub) = set-val
     1873           .
     1874         end.
     1875         when 'pngb':U then do:
     1876           assign
     1877             current-value(s-pngb-code, ub) = set-val
     1878           .
     1879         end.
     1880         when 'cagb':U then do:
     1881           assign
     1882             current-value(s-cagb-code, ub) = set-val
     1883           .
     1884         end.
     1885         when 'fdgb':U then do:
     1886           assign
     1887             current-value(s-fin-doc, ub) = set-val
     1888           .
     1889         end.
     1890       end case.
     1891     end.
     1892   end procedure.
     1893   procedure new-bcod-gen-code-range :
     1894     do
     1895     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1896     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
     1897     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
     1898     :
     1899       define input parameter p-db-num  like ub.db.db-num             no-undo .
     1900       define input parameter type-code like ub.code-range.range-type no-undo .
     1901       define buffer buf_code-range      for ub.code-range .
     1902       define buffer last_code-range     for ub.code-range .
     1903       define buffer last-1_code-range   for ub.code-range .
     1904       define buffer last-2_code-range   for ub.code-range .
     1905       define buffer last-3_code-range   for ub.code-range .
     1906       define buffer buf_sys-ctrl        for ub.sys-ctrl .
     1907       define variable conf-par       as character no-undo .
     1908       define variable par-type       as character no-undo .
     1909       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
     1910       define variable v-cre-cdrg as logical   no-undo .
     1911       define variable v-cre-str  as character no-undo .
     1912       define variable v-cr1      as integer no-undo .
     1913       define variable v-cr2      as integer no-undo .
     1914       define variable v-cr3      as integer no-undo .
     1915       define variable v-cmax     as integer no-undo .
     1916       find first buf_sys-ctrl no-lock .
     1917       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
     1918         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
     1919                                       ,vss-workfile
     1920                                       ,vss-revision
     1921                                       ,vss-description
     1922                                       ,chr(10)
     1923                                       , p-db-num
     1924                                      ).
     1925       end.
     1926       run trg/getpcode.p ( input  type-code
     1927                      ,output cfg-param-code
     1928                     ).
     1929       for each buf_code-range
     1930         where buf_code-range.db-num     = -1
     1931           and buf_code-range.range-type = type-code
     1932           and buf_code-range.stts       = "f"
     1933       by buf_code-range.first-code
     1934       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1935       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
     1936       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
     1937       :
     1938         assign
     1939           buf_code-range.db-num = p-db-num
     1940         .
     1941         return .
     1942       end.
     1943       assign
     1944         v-cre-cdrg = TRUE
     1945       .
     1946       case type-code:
     1947         when 'sclc':U
     1948         or when 'scgb':U
     1949         or when 'pglc':U
     1950         then do:
     1951           find last last-1_code-range no-lock
     1952             where last-1_code-range.range-type = 'sclc':U
     1953             no-error .
     1954           if available last-1_code-range then do:
     1955             v-cr1 = last-1_code-range.last-code.
     1956           end.
     1957           find last last-2_code-range no-lock
     1958             where last-2_code-range.range-type = 'scgb':U
     1959             no-error .
     1960           if available last-2_code-range then do:
     1961             v-cr2 = last-2_code-range.last-code.
     1962             end.
     1963           find last last-3_code-range no-lock
     1964             where last-3_code-range.range-type = 'pglc':U
     1965             no-error .
     1966           if available last-3_code-range then do:
     1967             v-cr3 = last-3_code-range.last-code.
     1968           end.
     1969           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
     1970           .
     1971           if v-cmax = v-cr1  then do:
     1972               find last last_code-range no-lock
     1973                 where recid( last_code-range ) = recid( last-1_code-range )
     1974                 .
     1975             end.
     1976           if v-cmax = v-cr2  then do:
     1977               find last last_code-range no-lock
     1978                 where recid( last_code-range ) = recid( last-2_code-range )
     1979                 .
     1980             end.
     1981           if v-cmax = v-cr3  then do:
     1982             find last last_code-range no-lock
     1983               where recid( last_code-range ) = recid( last-3_code-range )
     1984               .
     1985           end.
     1986           if last_code-range.last-code + 1 > 99999 then do:
     1987             assign
     1988               v-cre-cdrg = FALSE
     1989             .
     1990           end.
     1991         end.
     1992         when 'bcgb':U
     1993         or when 'sslc':U
     1994         or when 'ssgb':U
     1995         then do:
     1996           find last last-1_code-range no-lock
     1997             where last-1_code-range.range-type = 'sslc':U
     1998             no-error .
     1999           if available last-1_code-range then do:
     2000             v-cr1 = last-1_code-range.last-code.
     2001           end.
     2002           find last last-2_code-range no-lock
     2003             where last-2_code-range.range-type = 'bcgb':U
     2004             no-error .
     2005           if available last-2_code-range then do:
     2006             v-cr2 = last-2_code-range.last-code.
     2007             end.
     2008           find last last-3_code-range no-lock
     2009             where last-3_code-range.range-type = 'ssgb':U
     2010             no-error .
     2011           if available last-3_code-range then do:
     2012             v-cr3 = last-3_code-range.last-code.
     2013           end.
     2014           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
     2015           .
     2016           if v-cmax = v-cr1  then do:
     2017               find last last_code-range no-lock
     2018                 where recid( last_code-range ) = recid( last-1_code-range )
     2019                 .
     2020             end.
     2021           if v-cmax = v-cr2  then do:
     2022               find last last_code-range no-lock
     2023                 where recid( last_code-range ) = recid( last-2_code-range )
     2024                 .
     2025             end.
     2026           if v-cmax = v-cr3  then do:
     2027             find last last_code-range no-lock
     2028               where recid( last_code-range ) = recid( last-3_code-range )
     2029               .
     2030           end.
     2031         end.
     2032         otherwise do:
     2033           find last last_code-range no-lock
     2034             where last_code-range.range-type = type-code
     2035             no-error .
     2036         end.
     2037       end case.
     2038       if not available last_code-range then do:
     2039         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
     2040                                       ,vss-workfile
     2041                                       ,vss-revision
     2042                                       ,vss-description
     2043                                       , chr(10)
     2044                                       , type-code
     2045                                      ) .
     2046       end.
     2047       define variable v-mes15 as character no-undo .
     2048       define variable v-param-type15 as character no-undo .
     2049       define variable v-value-character15 as INTEGER no-undo .
     2050       define variable v-value-date15 as date no-undo .
     2051       define variable v-value-decimal15 as decimal no-undo .
     2052       define variable v-value-integer15 AS integer no-undo .
     2053       define variable v-value-logical15 AS LOGICAL no-undo .
     2054       define variable v-tth15 as handle no-undo .
     2055       run adm/shattri.p (
     2056           input "get":U
     2057           ,input  'БД':U
     2058           ,input  p-db-num
     2059           ,input  'code-range':U
     2060           ,input  cfg-param-code
     2061           ,output v-value-character15
     2062           ,output v-value-date15
     2063           ,output v-value-decimal15
     2064           ,output v-value-integer15
     2065           ,output v-value-logical15
     2066           ,output v-param-type15
     2067           ,INPUT-OUTPUT table-handle v-tth15
     2068           ) no-error .
     2069       if error-status :error then do:
     2070         delete object v-tth15.
     2071         v-mes15 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
     2072                            , error-status:get-message(1)
     2073                            , chr(10)
     2074                            , return-value ).
     2075         undo, return error v-mes15.
     2076       end.
     2077       delete object v-tth15.
     2078       if v-cre-cdrg = TRUE then do:
     2079         create buf_code-range .
     2080         assign
     2081           buf_code-range.db-num     = p-db-num
     2082           buf_code-range.range-type = type-code
     2083           buf_code-range.stts       = "f"
     2084           buf_code-range.first-code = last_code-range.last-code + 1
     2085           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer15)
     2086           v-cre-str = "Свободный диапазон успешно создан"
     2087         .
     2088       end.
     2089       else do:
     2090         assign
     2091           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
     2092                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
     2093         .
     2094       end.
     2095     end.
     2096     return v-cre-str .
     2097   end procedure.
     2098   procedure gen-new-code-range-if-neces :
     2099     define input parameter v-db-num           like ub.db.db-num             no-undo .
     2100     define input parameter v-range-type       like ub.code-range.range-type no-undo .
     2101     define input parameter v-cur-code         as   integer                  no-undo .
     2102     define input parameter v-g#news           as   logical                  no-undo .
     2103     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
     2104     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
     2105     do
     2106     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2107     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
     2108     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
     2109     :
     2110       define variable l-code-range-exist as logical   no-undo init false .
     2111       define variable v-db-for-send      as character no-undo .
     2112       define buffer buf_code-range  for ub.code-range .
     2113       define buffer buf1_code-range for ub.code-range .
     2114       define buffer buf_db          for ub.db .
     2115       find first buf_code-range
     2116         where buf_code-range.range-type = v-range-type
     2117           and buf_code-range.last-code >= v-cur-code
     2118         use-index last-codei
     2119         no-error .
     2120       if
     2121       (
     2122          available buf_code-range
     2123          and
     2124         (buf_code-range.db-num = v-db-num
     2125           and
     2126         buf_code-range.first-code <= v-cur-code
     2127         )
     2128       or
     2129         (
     2130           v-range-type = 'drgb':U
     2131           AND
     2132           v-cur-code = 0
     2133         )
     2134      )
     2135      then do:
     2136         assign
     2137           l-code-range-exist = true
     2138         .
     2139         if v-g#news
     2140         and buf_code-range.stts = "f" then do:
     2141           assign
     2142             buf_code-range.stts = "u"
     2143           .
     2144         end.
     2145       end.
     2146       if not l-code-range-exist
     2147          and v-g#news-source-db <> 0
     2148       then do:
     2149         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
     2150                                       ,vss-workfile
     2151                                       ,vss-revision
     2152                                       ,vss-description
     2153                                       ,chr(10)
     2154                                       ,v-db-num
     2155                                       ,v-range-type
     2156                                       ,v-cur-code
     2157                                      ).
     2158       end.
     2159       if (not l-code-range-exist
     2160           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
     2161          )
     2162       and ( not can-find (first buf1_code-range no-lock
     2163                           where buf1_code-range.db-num = v-db-num
     2164                             and buf1_code-range.range-type = v-range-type
     2165                             and buf1_code-range.stts = "f"
     2166                          )
     2167           )
     2168       then do:
     2169         if v-g#db-num = 0 then do:
     2170           run new-bcod-gen-code-range in this-procedure
     2171             (input v-db-num,
     2172              input v-range-type
     2173             ) no-error .
     2174           if error-status :error then do:
     2175             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
     2176                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
     2177                                           ,v-db-num
     2178                                           ,v-range-type
     2179                                           ,v-cur-code
     2180                                           ,chr(10)
     2181                                           ,error-status:get-message(1)
     2182                                           ,return-value
     2183                                          ).
     2184           end.
     2185         end.
     2186         else do:
     2187           if v-range-type = 'sclc':U
     2188           or v-range-type = 'pglc':U
     2189           then do:
     2190             assign
     2191               v-db-for-send = "":U
     2192             .
     2193             if v-g#db-num = 0 then do:
     2194               for each buf_db no-lock
     2195                 where buf_db.db-num > 0
     2196                   and buf_db.db-num <> v-g#news-source-db
     2197               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2198               :
     2199                 assign
     2200                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
     2201                 .
     2202               end.
     2203               assign
     2204                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
     2205               .
     2206             end.
     2207             else do:
     2208               if not v-g#news then do:
     2209                 assign
     2210                   v-db-for-send = "0":U
     2211                 .
     2212               end.
     2213             end.
     2214             run nws/cr-route.p ( input 'send-cmd':U
     2215                           ,input ("command":U + chr(1) + "create":U + chr(1) +
     2216                                  "code-range":U + chr(1) +
     2217                                  (if v-range-type = 'sclc':U
     2218                                   then string( current-value(s-sclc-code, ub))
     2219                                   else string( current-value(s-pglc-code, ub))
     2220                                   ) + chr(1) +
     2221                                   v-range-type)
     2222                           ,input ?
     2223                           ,input v-db-for-send
     2224                           ) no-error .
     2225             if error-status :error then do:
     2226               undo, return error return-value.
     2227             end.
     2228           end.
     2229         end.
     2230       end.
     2231     end.
     2232   end procedure.
     2233   procedure cre-loc-sc-code-range :
     2234     define input parameter v-cur-code as integer no-undo .
     2235   define input parameter p-cdrg-type as character no-undo .
     2236     do
     2237     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2238     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
     2239     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
     2240     :
     2241       define buffer buf_code-range for ub.code-range .
     2242       find first buf_code-range
     2243            where buf_code-range.range-type = p-cdrg-type
     2244              and buf_code-range.first-code >= v-cur-code
     2245            no-error .
     2246       if not available buf_code-range then do:
     2247         run new-bcod-gen-code-range in this-procedure
     2248           ( input 0,
     2249             input p-cdrg-type
     2250           ) no-error .
     2251         if error-status :error then do:
     2252           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
     2253                                          + "Код &2&1&3 &4"
     2254                                         , chr(10)
     2255                                         , v-cur-code
     2256                                         , error-status:get-message(1)
     2257                                         , return-value
     2258                                        ) .
     2259         end.
     2260       end.
     2261     end.
     2262   end procedure.
     2263   procedure mark-used-if-need :
     2264   define input parameter p-cur-code as integer no-undo .
     2265   define input parameter p-range-type like ub.code-range.range-type no-undo .
     2266   define input parameter p-db-num like ub.code-range.db-num no-undo .
     2267     do
     2268     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     2269     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
     2270     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
     2271     :
     2272       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
     2273       define buffer buf_code-range for ub.code-range .
     2274       assign
     2275       v-db-num = if p-range-type = 'sclc':U
     2276                  then 0
     2277                  else p-db-num
     2278       .
     2279   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2280   define buffer locK-batchprocess16 for ub.batchprocess.
     2281   run gbl/lock-prc.p
     2282       (input 'lscc':U
     2283       ,input 0
     2284       ,input 0
     2285       ,input 0
     2286       ,input ""
     2287       ,input ""
     2288       ,input ""
     2289       ,input (
     2290               ",,,Вкл/выкл лок. вес. кодов"
     2291              )
     2292       ,input true
     2293       ,buffer lock-batchprocess16
     2294       ) no-error .
     2295     if error-status :error then do:
     2296       message
     2297         vss-workfile vss-revision vss-description skip
     2298         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
     2299         view-as alert-box error .
     2300       undo, return error .
     2301     end.
     2302       find first buf_code-range
     2303            where buf_code-range.range-type = p-range-type
     2304              and buf_code-range.first-code >= p-cur-code
     2305              and buf_code-range.last-code <= p-cur-code
     2306              and buf_code-range.db-num = v-db-num
     2307            no-error .
     2308       if not available buf_code-range then do:
     2309         message
     2310           vss-workfile vss-revision vss-description skip
     2311           "Ошибка при создании поиске диапазона" skip
     2312           "База данных" p-db-num skip
     2313           "Код" p-cur-code skip
     2314           "Тип" p-range-type
     2315           error-status :get-message(1) skip
     2316           return-value skip
     2317           view-as alert-box error .
     2318         undo, return error .
     2319       end.
     2320       if buf_code-range.stts = "f":U then do:
     2321         assign
     2322         buf_code-range.stts = "u":U
     2323         .
     2324       end.
     2325     end.
     2326   end procedure.
     2327   define   shared variable g#auto as logical no-undo.
     2328   define   shared variable g#news as logical no-undo.
     2329   define   shared variable g#oxml as logical no-undo.
     2330   define   shared variable g#esys as logical no-undo.
     2331   define   shared variable g#news-source-db as integer no-undo.
     2332   define   shared variable g#esys-source-esys as integer no-undo.
     2333   define   shared variable g#db-num as integer   no-undo .
     2334   define   shared variable g#userid as character no-undo .
     2335   define   shared variable g#passwd as character no-undo .
     2336   define variable add-option as char no-undo.
     2337   DEFINE VARIABLE add-obj-type like ub.clients.obj-type no-undo .
     2338   DEFINE VARIABLE add-obj-code like ub.clients.obj-code no-undo .
     2339   define variable updated as logical no-undo.
     2340   define variable temp-doc-rec as recid no-undo.
     2341   define buffer del_temp-disc for temp-disc.
     2342   define variable glog as logical no-undo .
     2343   define variable v-tab-order AS character no-undo.
     2344   define variable loc-glob as logical no-undo .
     2345   define variable loc-firm as logical no-undo .
     2346   define variable loc-object as logical no-undo .
     2347   define variable dflt-cd as character no-undo .
     2348   define variable v-auto-go    as logical no-undo init yes .
     2349   define temp-table tt-dis-rule       no-undo like ub.dis-rule.
     2350   define temp-table tt0-term_dis-rule no-undo like ub.dis-rule.
     2351   define temp-table old-temp-disc     no-undo like temp-disc.
     2352   FUNCTION dis-gds-rule-name RETURNS CHARACTER
     2353     ( INPUT p-discnt-role AS character )  FORWARD.
     2354   DEFINE MENU MENU-b-add
     2355          MENU-ITEM m_pos-type     LABEL "m_pos-type"
     2356          MENU-ITEM m_no-pos       LABEL "По накладной"
     2357          MENU-ITEM m_bo           LABEL "Бэкофис"       .
     2358   DEFINE MENU MENU-b-add-2
     2359          MENU-ITEM m_pos-type-2   LABEL "m_pos-type-2"
     2360          MENU-ITEM m_no-pos-2     LABEL "По накладной"
     2361          MENU-ITEM m_bo-2         LABEL "Бэкофис"       .
     2362   DEFINE BUTTON b-add
     2363        LABEL "&Добавить":L
     2364        SIZE 10 BY 1 TOOLTIP "Выбрать скидку для добавления".
     2365   DEFINE BUTTON b-add-2
     2366        LABEL "&Добавить":L
     2367        SIZE 10 BY 1 TOOLTIP "Выбрать скидку для удаления".
     2368   DEFINE BUTTON B-chg
     2369        LABEL "&Изменить"
     2370        SIZE 10 BY 1.
     2371   DEFINE BUTTON B-chg-2
     2372        LABEL "&Изменить"
     2373        SIZE 10 BY 1.
     2374   DEFINE BUTTON B-del
     2375        LABEL "&Удалить"
     2376        SIZE 10 BY 1.
     2377   DEFINE BUTTON B-del-2
     2378        LABEL "&Удалить"
     2379        SIZE 10 BY 1.
     2380   DEFINE BUTTON B-exit
     2381        LABEL "&Ввод"
     2382        SIZE 10 BY 1 TOOLTIP "Установить/изменить/удалить скидки по списку"
     2383        BGCOLOR 8 .
     2384   DEFINE BUTTON B-Help
     2385        LABEL "Помо&щь"
     2386        SIZE 3 BY 1
     2387        BGCOLOR 8 .
     2388   DEFINE BUTTON B-list
     2389        LABEL "&Список товаров"
     2390        SIZE 20 BY 1 TOOLTIP "Создание списка".
     2391   DEFINE BUTTON B-list-2
     2392        LABEL "&Список кодов"
     2393        SIZE 20 BY 1 TOOLTIP "Создание списка".
     2394   DEFINE BUTTON B-obj
     2395        LABEL "&Список объектов"
     2396        SIZE 20 BY 1 TOOLTIP "Создание списка".
     2397   DEFINE BUTTON b-quit AUTO-END-KEY
     2398        LABEL "&Отмена"
     2399        SIZE 10 BY 1
     2400        BGCOLOR 8 .
     2401   DEFINE VARIABLE F-obj-name AS CHARACTER FORMAT "X(256)":U
     2402         VIEW-AS TEXT
     2403        SIZE 52.5 BY .67
     2404        FGCOLOR 4  NO-UNDO.
     2405   DEFINE VARIABLE rs-list AS CHARACTER INITIAL "gds-list"
     2406        VIEW-AS RADIO-SET HORIZONTAL
     2407        RADIO-BUTTONS
     2408             "Товары", "gds-list",
     2409   "Бар-коды", "bb-list"
     2410        SIZE 24 BY 1 NO-UNDO.
     2411   DEFINE VARIABLE T-delete-ok AS LOGICAL INITIAL no
     2412        LABEL "Удалять записи списка в случае удачного изменения"
     2413        VIEW-AS TOGGLE-BOX
     2414        SIZE 52 BY 1 NO-UNDO.
     2415   DEFINE QUERY BR-add FOR
     2416         temp-disc SCROLLING.
     2417   DEFINE QUERY BR-del FOR
     2418         del_temp-disc SCROLLING.
     2419   DEFINE BROWSE BR-add
     2420     QUERY BR-add DISPLAY
     2421         entry (lookup (temp-disc.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U) column-label "Место!использ."  format "X(10)"
     2422   dis-gds-rule-name (temp-disc.discnt-role) column-label "Тип скидки" FORMAT "X(255)":U WIDTH 35
     2423   temp-disc.templ-rl-root FORMAT ">>>>>>>>9":U COLUMN-LABEL "Код!шаблона"
     2424   temp-disc.time-templ-rl-root FORMAT ">>>>>>>>9":U COLUMN-LABEL "Код!типа!распис"
     2425   disgdsru-get-disc-label( INPUT temp-disc.templ-rl-root) FORMAT "X(255)":U WIDTH 45
     2426   temp-disc.rule-num COLUMN-LABEL "Код правила" FORMAT ">>>>>>>>9"
     2427   get-objregion(temp-disc.obj-type, temp-disc.obj-code) COLUMN-LABEL "Действует" FORMAT "X(12)"
     2428       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 8
     2429            TITLE "Будут добавлены/изменены скидки".
     2430   DEFINE BROWSE BR-del
     2431     QUERY BR-del DISPLAY
     2432         entry (lookup (del_temp-disc.pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U) column-label "Место!использ."  format "X(10)"
     2433   dis-gds-rule-name ( DEL_temp-disc.discnt-role) column-label "Тип скидки" FORMAT "X(255)":U WIDTH 35
     2434   del_temp-disc.templ-rl-root FORMAT ">>>>>>>>9":U COLUMN-LABEL "Код!шаблона"
     2435   del_temp-disc.time-templ-rl-root FORMAT ">>>>>>>>9":U COLUMN-LABEL "Код!типа!распис"
     2436   disgdsru-get-disc-label( INPUT del_temp-disc.templ-rl-root) FORMAT "X(255)":U WIDTH 45
     2437   del_temp-disc.rule-num COLUMN-LABEL "Код правила" FORMAT ">>>>>>>>9"
     2438   get-objregion(del_temp-disc.obj-type, del_temp-disc.obj-code) COLUMN-LABEL "Действует" FORMAT "X(12)"
     2439       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 8
     2440            TITLE "Будут удалены скидки".
     2441   DEFINE FRAME Dialog-Frame
     2442        B-exit AT ROW 1 COL 1
     2443        b-quit AT ROW 1 COL 11
     2444        rs-list AT ROW 1 COL 22 NO-LABEL WIDGET-ID 6
     2445        B-list AT ROW 1 COL 51
     2446        B-list-2 AT ROW 1 COL 71 WIDGET-ID 4
     2447        B-Help AT ROW 1 COL 92
     2448        T-delete-ok AT ROW 3.5 COL 1.5
     2449        b-add AT ROW 4.77 COL 1
     2450        B-chg AT ROW 4.77 COL 11
     2451        B-del AT ROW 4.77 COL 21
     2452        BR-add AT ROW 5.77 COL 1
     2453        b-add-2 AT ROW 14 COL 1
     2454        B-chg-2 AT ROW 14 COL 11 WIDGET-ID 2
     2455        B-del-2 AT ROW 14 COL 21
     2456        BR-del AT ROW 15 COL 1
     2457        B-obj AT ROW 2.27 COL 1
     2458        SPACE(15.12) SKIP(20.06)
     2459       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2460            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2461            TITLE "<insert dialog title>"
     2462            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
     2463   ASSIGN
     2464          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2465          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2466   ASSIGN
     2467          b-add:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-add:HANDLE.
     2468   ASSIGN
     2469          b-add-2:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-add-2:HANDLE.
     2470   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2471   DO:
     2472     APPLY "END-ERROR":U TO SELF.
     2473   END.
     2474   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     2475   DO:
     2476     if add-option = '':U then do:
     2477         run gbl/pop-up.p ( input self:handle, input no) no-error.
     2478     end.
     2479     if add-option = '':U then return no-apply.
     2480     run proc-b-add in this-procedure ( input add-option) no-error .
     2481     if error-status:error then do:
     2482       add-option = '':U.
     2483       return no-apply.
     2484     end.
     2485     add-option = '':U.
     2486   END.
     2487   ON CHOOSE OF b-add-2 IN FRAME Dialog-Frame
     2488   DO:
     2489     if add-option = '':U then do:
     2490         run gbl/pop-up.p ( input self:handle, input no) no-error.
     2491     end.
     2492     if add-option = '':U then return no-apply.
     2493     run proc-b-add-2 in this-procedure ( input add-option) no-error .
     2494     if error-status:error then do:
     2495       add-option = '':U.
     2496       return no-apply.
     2497     end.
     2498     add-option = '':U.
     2499   END.
     2500   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     2501   DO:
     2502     run proc-b-chg in this-procedure ( input "change":U) no-error.
     2503     if error-status:error then return no-apply.
     2504   END.
     2505   ON CHOOSE OF B-chg-2 IN FRAME Dialog-Frame
     2506   DO:
     2507     run proc-b-chg-2 in this-procedure ( input "change":U) no-error.
     2508     if error-status:error then return no-apply.
     2509   END.
     2510   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     2511   DO:
     2512     define variable loc#log as logical no-undo.
     2513     if not avail temp-disc then return no-apply.
     2514    loc#log = no.
     2515     message "Вы уверены, что хотите удалить скидку"  "<" temp-disc.label_ ">" skip
     2516                        "из списка скидок подлежащих установке/изменению?"  skip
     2517             view-as alert-box QUESTIOn buttons YES-NO update loc#log.
     2518     if NOT loc#log then return no-apply.
     2519       run temp-dsc-delete in this-procedure (
     2520                                                input temp-disc.pos-type
     2521                                               ,input temp-disc.discnt-role
     2522                                               ,input temp-disc.nonunique
     2523                                               ,input temp-disc.host-code
     2524                                               ,input temp-disc.obj-type
     2525                                               ,input temp-disc.obj-code
     2526                                               ,input temp-disc.action
     2527                                               ,output loc#log) no-error .
     2528       if error-status:error or not loc#log then do:
     2529           return no-apply.
     2530       end.
     2531        updated = yes.
     2532       run init-proc in this-procedure .
     2533       APPLY "ENTRY" to br-add.
     2534   END.
     2535   ON CHOOSE OF B-del-2 IN FRAME Dialog-Frame
     2536   DO:
     2537     define variable loc#log as logical no-undo.
     2538     if not avail del_temp-disc then return no-apply.
     2539     loc#log = no.
     2540     message
     2541     "Вы уверены, что хотите удалить скидку" "<" del_temp-disc.label_ ">" skip
     2542     "из списка скидок, подлежащих удалению?" skip
     2543      view-as alert-box QUESTIOn buttons YES-NO update loc#log.
     2544     if NOT loc#log then return no-apply.
     2545       run temp-dsc-delete in this-procedure (
     2546                                                input del_temp-disc.pos-type
     2547                                               ,input del_temp-disc.discnt-role
     2548                                               ,input del_temp-disc.nonunique
     2549                                               ,input del_temp-disc.host-code
     2550                                               ,input del_temp-disc.obj-type
     2551                                               ,input del_temp-disc.obj-code
     2552                                               ,input del_temp-disc.action
     2553                                               ,output loc#log) no-error .
     2554       if error-status:error or not loc#log then do:
     2555           return no-apply.
     2556       end.
     2557       updated = yes.
     2558       run init-proc in this-procedure .
     2559       APPLY "ENTRY" to br-del.
     2560   END.
     2561   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
     2562   DO:
     2563     RUN proc-b-exit IN THIS-PROCEDURE NO-ERROR.
     2564     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     2565   END.
     2566   ON CHOOSE OF B-list IN FRAME Dialog-Frame
     2567   DO:
     2568   define variable v-host-code as integer no-undo .
     2569     CASE par-subject:
     2570       when 'dis-gds-rule':U
     2571       then do:
     2572   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2573   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2574     (input  parobj-type
     2575     ,input  parobj-code
     2576     ,output v-host-code
     2577     )  .
     2578         run str/gds-list.w ( input parparentproc, input v-host-code, input parobj-type, input parobj-code).
     2579       end.
     2580     END CASE.
     2581     assign
     2582     b-list:label = "&Список товаров"
     2583     .
     2584   END.
     2585   ON CHOOSE OF B-list-2 IN FRAME Dialog-Frame
     2586   DO:
     2587   define variable v-host-code as integer no-undo .
     2588     CASE par-subject:
     2589       when 'dis-gds-rule':U
     2590       then do:
     2591         run str/bb-list.w ( input parparentproc, input parobj-type, input parobj-code, input '').
     2592       end.
     2593     END CASE.
     2594     assign
     2595     b-list-2:label = "&Список кодов"
     2596     .
     2597   END.
     2598   ON CHOOSE OF B-obj IN FRAME Dialog-Frame
     2599   DO:
     2600     RUN proc-b-obj IN THIS-PROCEDURE NO-ERROR.
     2601     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     2602   END.
     2603   ON CHOOSE OF MENU-ITEM m_bo
     2604   DO:
     2605     add-option = 'bo':U.
     2606     run proc-b-add in this-procedure ( input add-option ) no-error.
     2607     if error-status:error then do:
     2608       add-option = '':U.
     2609       return no-apply.
     2610     end.
     2611     add-option = '':U.
     2612   END.
     2613   ON CHOOSE OF MENU-ITEM m_bo-2
     2614   DO:
     2615       add-option = 'bo':U.
     2616     run proc-b-add-2 in this-procedure ( input add-option ) no-error.
     2617     if error-status:error then do:
     2618       add-option = '':U.
     2619       return no-apply.
     2620     end.
     2621     add-option = '':U.
     2622   END.
     2623   ON CHOOSE OF MENU-ITEM m_no-pos
     2624   DO:
     2625       add-option = '-':U.
     2626     run proc-b-add in this-procedure ( input add-option ) no-error.
     2627     if error-status:error then do:
     2628       add-option = '':U.
     2629       return no-apply.
     2630     end.
     2631     add-option = '':U.
     2632   END.
     2633   ON CHOOSE OF MENU-ITEM m_no-pos-2
     2634   DO:
     2635      add-option = '-':U.
     2636     run proc-b-add-2 in this-procedure ( input add-option ) no-error.
     2637     if error-status:error then do:
     2638       add-option = '':U.
     2639       return no-apply.
     2640     end.
     2641     add-option = '':U.
     2642   END.
     2643   ON CHOOSE OF MENU-ITEM m_pos-type
     2644   DO:
     2645      add-option = dflt-cd.
     2646     run proc-b-add in this-procedure ( input add-option ) no-error.
     2647     if error-status:error then do:
     2648       add-option = '':U.
     2649       return no-apply.
     2650     end.
     2651     add-option = '':U.
     2652   END.
     2653   ON CHOOSE OF MENU-ITEM m_pos-type-2
     2654   DO:
     2655      add-option = dflt-cd.
     2656     run proc-b-add-2 in this-procedure ( input add-option ) no-error.
     2657     if error-status:error then do:
     2658       add-option = '':U.
     2659       return no-apply.
     2660     end.
     2661     add-option = '':U.
     2662   END.
     2663   ON VALUE-CHANGED OF rs-list IN FRAME Dialog-Frame
     2664   DO:
     2665     assign
     2666     rs-list.
     2667     for each temp-disc:
     2668       delete temp-disc.
     2669     end.
     2670     Run init-proc in this-procedure no-error.
     2671     if error-status:error then do:
     2672       undo, return no-apply.
     2673     end.
     2674     CASE rs-list:
     2675       WHEN "gds-list" THEN DO:
     2676         ENABLE
     2677         b-list
     2678         WITH FRAME Dialog-Frame.
     2679         DISABLE
     2680         b-list-2
     2681         WITH FRAME Dialog-Frame.
     2682       END.
     2683       WHEN "bb-list" THEN DO:
     2684         ENABLE
     2685         b-list-2
     2686         WITH FRAME Dialog-Frame.
     2687         DISABLE
     2688         b-list
     2689         WITH FRAME Dialog-Frame.
     2690       END.
     2691     END CASE.
     2692   END.
     2693   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2694   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2695   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2696   on help of frame Dialog-Frame
     2697   do:
     2698     run gbl/app_help.p
     2699       (input this-procedure :file-name
     2700       ,input ''
     2701       ,input ?
     2702       ) no-error.
     2703     if error-status :error then do:
     2704       message
     2705         "Ошибка при вызове помощи"
     2706         error-status :get-message(1)
     2707         view-as alert-box .
     2708     end.
     2709   end.
     2710   run minbtn-set in this-procedure .
     2711   on choose of b-help in frame Dialog-Frame
     2712   do:
     2713     apply "help":u to frame Dialog-Frame .
     2714   end.
     2715   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2716   procedure minbtn-set :
     2717       do
     2718           on error undo, return error return-value
     2719           :
     2720           define variable ii              as integer       no-undo .
     2721           define variable fh              as widget-handle no-undo .
     2722           define variable hh              as widget-handle no-undo .
     2723           define variable v-h             as handle        extent 4 no-undo .
     2724           define variable v-name-button   as character     no-undo .
     2725           define variable v-help-old-x    as decimal       no-undo .
     2726           define variable v-help-old-y    as decimal       no-undo .
     2727           define variable v-help-old-size as decimal       no-undo .
     2728           define variable v-frame-width   as decimal       no-undo .
     2729           define variable jj              as integer       no-undo .
     2730           do
     2731               on error undo, return error
     2732               :
     2733               assign
     2734                   v-frame-width = frame Dialog-Frame:width - 0.3
     2735                   fh            = frame Dialog-Frame:first-child
     2736                   hh            = fh:first-child
     2737                   ii            = 1
     2738                   .
     2739               do while valid-handle(hh):
     2740                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2741                   do:
     2742                       case lc(hh:name) :
     2743                           when "b-help" then
     2744                               do:
     2745                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2746                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2747                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2748                                   hh:TOOLTIP = "Помощь" .
     2749                                   v-help-old-x = hh:column .
     2750                                   v-help-old-y = hh:row    .
     2751                                   v-help-old-size = hh:width .
     2752                                   hh:width-chars = 2.5 .
     2753                               end.
     2754                           when "b-print" then
     2755                               do:
     2756                                   hh:load-image("cmp/b-print.bmp":u) .
     2757                                   hh:TOOLTIP = "Печать" .
     2758                                   v-h[ii] = hh:handle .
     2759                                   ii = ii + 1 .
     2760                                   hh:width-chars = 3 .
     2761                               end.
     2762                           when "b-history" or
     2763                           when "b-hist" then
     2764                               do:
     2765                                   hh:load-image("cmp/b-hist.bmp":u) .
     2766                                   hh:TOOLTIP = "История" .
     2767                                   v-h[ii] = hh:handle .
     2768                                   ii = ii + 1 .
     2769                                   hh:width-chars = 3 .
     2770                               end.
     2771                           when "b-sch" then
     2772                               do:
     2773                                   hh:load-image("cmp/b-sch.bmp":u) .
     2774                                   hh:TOOLTIP = "Установка Фильтра" .
     2775                                   v-h[ii] = hh:handle .
     2776                                   ii = ii + 1 .
     2777                                   hh:width-chars = 3 .
     2778                               end.
     2779                           when "b-hist-user" then
     2780                               do:
     2781                                   hh:load-image("cmp/b-hist.bmp":u) .
     2782                                   hh:TOOLTIP = "История пользователя" .
     2783                                   ii = ii + 1 .
     2784                               end.
     2785                       end case.
     2786                   end.
     2787                   hh = hh:next-sibling.
     2788               end.
     2789               b-help:column = v-frame-width - b-help:width-chars.
     2790               jj = 0.
     2791               repeat ii = 4 to 1 by -1 :
     2792                   if valid-handle (v-h[ii] ) then
     2793                   do:
     2794                       jj  = jj + 1 .
     2795                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2796                       v-h[ii]:row    = v-help-old-y .
     2797                   end.
     2798               end.
     2799           end.
     2800       end.
     2801   end procedure.
     2802   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2803   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2804   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2805   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2806   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2807   define variable v-diasize-current-frame-height as decimal   no-undo .
     2808   define variable v-diasize-change-size          as logical   no-undo .
     2809   define variable v-diasize-resize-button        as handle    no-undo .
     2810   define variable v-diasize-wndmax               as logical   no-undo .
     2811   define variable v-diasize-wndstore             as logical   no-undo .
