      851   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      852   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      853   define temp-table temp-drt-prop no-undo like ub.drt-prop.
      854   procedure disrules-fill-properties:
      855   define input  parameter p-templ-rl-root as integer   no-undo .
      856   define buffer buf_drt-prop for ub.drt-prop.
