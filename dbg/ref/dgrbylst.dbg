     3057         then do:
     3058           assign
     3059             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     3060             no-error .
     3061           if error-status :error
     3062           or error-status :get-message(1) <> ""
     3063           then do:
     3064             undo move_block, retry move_block .
     3065           end.
     3066         end.
     3067         assign
     3068           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     3069           no-error .
