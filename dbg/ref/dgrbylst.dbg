     2839     define variable v-change-sign           as integer   no-undo .
     2840     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2841     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2842     if p-change-value > 0
     2843     then do:
     2844       if frame Dialog-Frame :height + p-change-value
     2845           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2846       then do:
     2847         assign
     2848           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2849                           - (frame Dialog-Frame :height-chars)
     2850         .
     2851         if p-change-value <= 0
     2852         then do:
     2853           run diasize_position-resize-button in this-procedure .
     2854           return .
     2855         end.
     2856       end.
     2857     end.
     2858     if p-change-value < 0
     2859     then do:
     2860       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2861       then do:
     2862         assign
     2863           p-change-value = v-diasize-orig-frame-height
     2864                          - (frame Dialog-Frame :height-chars)
     2865         .
     2866         if p-change-value >= 0
     2867         then do:
     2868           run diasize_position-resize-button in this-procedure .
     2869           return .
     2870         end.
     2871       end.
     2872     end.
     2873     if p-change-value >= 0
     2874     then do:
     2875       assign
     2876         v-change-sign = 1
     2877       .
     2878     end.
     2879     else do:
     2880       assign
     2881         v-change-sign = -1
     2882       .
     2883     end.
     2884     assign
     2885       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2886     .
     2887     if p-change-value = 0
     2888     then do:
     2889       run diasize_position-resize-button in this-procedure .
     2890       return .
     2891     end.
     2892     move_block:
     2893     do
     2894     on error undo move_block, retry move_block
     2895     :
     2896       if retry
     2897       then do:
     2898         do
     2899         on error undo move_block, leave move_block
     2900         :
     2901           if p-change-value > 0
     2902           then do:
     2903             for each buf_temp-diasize-handle
     2904             on error undo, next
     2905             :
     2906               assign
     2907                 v-object-handle = buf_temp-diasize-handle.handle-value
     2908               .
     2909               if v-object-handle <> v-diasize-resize-button
     2910               then do:
     2911                 assign
     2912                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2913                 .
     2914               end.
     2915             end.
     2916             assign
     2917               v-diasize-browse-handle :height = v-browse-height
     2918             .
     2919             for each buf_temp-browse-handle
     2920               where buf_temp-browse-handle.browse-type = 'height':u
     2921             on error undo, next
     2922             :
     2923               assign
     2924                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2925               .
