     3209     :
     3210       run diasize_change-height in this-procedure
     3211         (input  (p-new-height - frame Dialog-Frame :height)
     3212         ,input  p-move-resize
     3213         ) .
     3214     end.
     3215   end procedure.
     3216   procedure diasize_change-width :
     3217     define input  parameter p-change-value as decimal   no-undo .
