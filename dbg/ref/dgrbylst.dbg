     3416             if available buf_temp-browse-handle
     3417             then do:
     3418             end.
     3419             else do:
     3420               create buf_temp-diasize-handle .
     3421               assign
     3422                 buf_temp-diasize-handle.handle-value  = v-object-handle
     3423                 buf_temp-diasize-handle.save-position = v-object-handle :col
     3424               .
     3425             end.
     3426           end.
     3427           assign
     3428             v-object-handle = v-object-handle :next-sibling
     3429           .
     3430         end.
     3431         assign
     3432           v-field-group-handle = v-field-group-handle :next-sibling
     3433         .
     3434       end.
     3435       do with frame Dialog-Frame
     3436       :
     3437         hide v-diasize-resize-button .
     3438         v-diasize-resize-button :row = 1.
     3439         v-diasize-resize-button :column = 1.
     3440       end.
     3441       if p-change-value > 0
     3442       then do:
     3443         if frame Dialog-Frame :scrollable = true
     3444         then do:
     3445           assign
     3446             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3447             no-error .
     3448           if error-status :error
     3449           or error-status :get-message(1) <> ""
     3450           then do:
     3451             undo move_block, retry move_block.
     3452           end.
     3453         end.
     3454         assign
     3455           frame Dialog-Frame :width = v-frame-width + p-change-value
     3456           no-error .
     3457         if error-status :error
     3458         or error-status :get-message(1) <> ""
     3459         then do:
     3460           undo move_block, retry move_block.
     3461         end.
     3462         assign
     3463           v-diasize-browse-handle :width = v-browse-width + p-change-value
     3464         no-error .
     3465         if error-status :error
     3466         or error-status :get-message(1) <> ""
     3467         then do:
     3468           undo move_block, retry move_block.
     3469         end.
     3470         for each buf_temp-browse-handle
     3471           where buf_temp-browse-handle.browse-type = 'width':u
     3472         on error undo move_block, retry move_block
     3473         :
     3474           assign
     3475             buf_temp-browse-handle.browse-handle :width
     3476               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3477             no-error .
     3478           if error-status :error
     3479           or error-status :get-message(1) <> ""
     3480           then do:
     3481             undo move_block, retry move_block .
     3482           end.
     3483         end.
     3484         for each buf_temp-diasize-handle
     3485         on error undo move_block, retry move_block
     3486         :
     3487           assign
     3488             v-object-handle = buf_temp-diasize-handle.handle-value
     3489           .
     3490           if v-object-handle <> v-diasize-resize-button
     3491           then do:
     3492             assign
     3493               v-object-handle :col = v-object-handle :col + p-change-value
     3494               no-error .
     3495             if error-status :error
     3496             or error-status :get-message(1) <> ""
     3497             then do:
     3498               undo move_block, retry move_block .
     3499             end.
     3500           end.
     3501         end.
     3502       end.
     3503       else do:
     3504         for each buf_temp-diasize-handle
     3505         on error undo move_block, retry move_block
     3506         :
     3507           assign
     3508             v-object-handle = buf_temp-diasize-handle.handle-value
     3509           .
     3510           if v-object-handle <> v-diasize-resize-button
     3511           then do:
     3512             assign
     3513               v-object-handle :col = v-object-handle :col + p-change-value
     3514               no-error .
     3515             if error-status :error
     3516             or error-status :get-message(1) <> ""
     3517             then do:
     3518               undo move_block, retry move_block .
     3519             end.
     3520           end.
     3521         end.
     3522         for each buf_temp-browse-handle
     3523           where buf_temp-browse-handle.browse-type = 'width':u
     3524         on error undo move_block, retry move_block
     3525         :
     3526           assign
     3527             buf_temp-browse-handle.browse-handle :width
     3528               = buf_temp-browse-handle.browse-handle :width + p-change-value
     3529             no-error .
     3530           if error-status :error
     3531           or error-status :get-message(1) <> ""
     3532           then do:
     3533             undo move_block, retry move_block .
     3534           end.
     3535         end.
     3536         assign
     3537           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     3538           no-error .
     3539         if error-status :error
     3540         or error-status :get-message(1) <> ""
     3541         then do:
     3542           undo move_block, retry move_block.
     3543         end.
     3544         assign
     3545           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     3546         no-error .
     3547         if error-status :error
     3548         or error-status :get-message(1) <> ""
     3549         then do:
     3550           undo move_block, retry move_block.
     3551         end.
     3552         if frame Dialog-Frame :scrollable = true
     3553         then do:
     3554           assign
     3555             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     3556           no-error .
     3557           if error-status :error
     3558           or error-status :get-message(1) <> ""
     3559           then do:
     3560             undo move_block, retry move_block.
     3561           end.
     3562         end.
     3563       end.
     3564       if p-move-resize
     3565       then do:
     3566         run diasize_position-resize-button in this-procedure .
     3567       end.
     3568       if v-diasize-wndstore = true
     3569       then do:
     3570         if connected("ub") = true
     3571         then do:
     3572           define variable v-cntxt-db-num        as integer   no-undo .
     3573           define variable v-cntxt-userid        as character no-undo .
     3574           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3575                                             , OUTPUT v-cntxt-userid
     3576                                             ) .
     3577           run gbl/wndsizew.p
     3578             (input  v-cntxt-db-num
     3579             ,input  v-cntxt-userid
     3580             ,input  v-diasize-proc-name
     3581             ,input  'width':u
     3582             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     3583             ) .
     3584         end.
     3585       end.
     3586     end.
     3587     assign
     3588       v-diasize-change-size = false
     3589     .
     3590   end procedure.
     3591   procedure diasize_set-width :
     3592     define input  parameter p-new-width  as decimal   no-undo .
     3593     define input  parameter p-move-resize as logical   no-undo .
     3594     do
     3595     on error undo, return error return-value
     3596     :
     3597       run diasize_change-width in this-procedure
     3598         (input  (p-new-width - frame Dialog-Frame :width)
     3599         ,input  p-move-resize
     3600         ) .
     3601     end.
     3602   end procedure.
     3603   procedure diasize_position-resize-button :
     3604     do with frame Dialog-Frame
     3605     :
     3606       hide v-diasize-resize-button .
     3607       assign
     3608         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3609                     - 1
     3610                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3611         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3612                     - 1
     3613                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3614       .
     3615       view v-diasize-resize-button .
     3616     end.
     3617   end procedure.
     3618   on alt-right anywhere
     3619   do:
     3620     run diasize_change-width in this-procedure
     3621       (input 1
     3622       ,input true
     3623       ) .
     3624     return no-apply .
     3625   end.
     3626   on alt-left anywhere
     3627   do:
     3628     run diasize_change-width in this-procedure
     3629       (input -1
     3630       ,input true
     3631       ) .
     3632     return no-apply .
     3633   end.
     3634   on alt-down anywhere
     3635   do:
     3636     run diasize_change-height in this-procedure
     3637       (input 1
     3638       ,input true
     3639       ) .
     3640     return no-apply .
     3641   end.
     3642   on alt-up anywhere
     3643   do:
     3644     run diasize_change-height in this-procedure
     3645       (input -1
     3646       ,input true
     3647       ) .
     3648     return no-apply .
     3649   end.
     3650   on alt-enter of frame Dialog-Frame
     3651   do:
     3652     run diasize_maximize in this-procedure
     3653       (input  ?
     3654       ).
     3655     return no-apply .
     3656   end.
     3657   procedure diasize_end-move :
     3658     do
     3659     on error undo, return error return-value
     3660     :
     3661       define variable v-row-delta as decimal   no-undo .
     3662       define variable v-col-delta as decimal   no-undo .
     3663       define variable v-new-row as decimal   no-undo .
     3664       define variable v-new-col as decimal   no-undo .
     3665       assign
     3666         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3667         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3668       .
     3669       assign
     3670         v-row-delta = v-new-row - frame Dialog-Frame :height
     3671         v-col-delta = v-new-col - frame Dialog-Frame :width
     3672       .
     3673       run diasize_change-height in this-procedure
     3674         (input v-row-delta
     3675         ,input true
     3676         ) .
     3677       run diasize_change-width in this-procedure
     3678         (input v-col-delta
     3679         ,input true
     3680         ) .
     3681     end.
     3682   end procedure.
     3683   procedure diasize_maximize :
     3684     define input  parameter p-action as logical   no-undo .
     3685     do
     3686     on error undo, return error return-value
     3687     :
     3688       if p-action = ?
     3689       then do:
     3690         if v-diasize-need-maximize = true
     3691         then do:
     3692           assign
     3693             p-action = true
     3694           .
     3695         end.
     3696         else do:
     3697           assign
     3698             p-action = false
     3699           .
     3700         end.
     3701       end.
     3702       if p-action = true
     3703       then do:
     3704         run diasize_change-height in this-procedure
     3705           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3706               - frame Dialog-Frame :height-chars
     3707           ,input true
     3708           ) .
     3709         run diasize_change-width in this-procedure
     3710           (input session :width-chars
     3711               - frame Dialog-Frame :width-chars
     3712           ,input true
     3713           ) .
     3714         assign
     3715           v-diasize-need-maximize = false
     3716         .
     3717       end.
     3718       else do:
     3719         run diasize_change-width in this-procedure
     3720           (input v-diasize-orig-frame-width
     3721               - frame Dialog-Frame :width-chars
     3722           ,input true
     3723           ) .
     3724         run diasize_change-height in this-procedure
     3725           (input v-diasize-orig-frame-height
     3726               - frame Dialog-Frame :height-chars
     3727           ,input true
     3728           ) .
     3729         assign
     3730           v-diasize-need-maximize = true
     3731         .
     3732       end.
     3733     end.
     3734   end procedure.
     3735   procedure diasize_restore-orig-size :
     3736     do
     3737     on error undo, return error return-value
     3738     :
     3739       assign
     3740         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3741         v-diasize-current-frame-height = frame Dialog-Frame :height
     3742       .
     3743       run diasize_set-height in this-procedure
     3744         (input  v-diasize-orig-frame-height
     3745         ,input  true
     3746         ) .
     3747       run diasize_set-width in this-procedure
     3748         (input  v-diasize-orig-frame-width
     3749         ,input  true
     3750         ) .
     3751     end.
     3752   end procedure.
     3753   procedure diasize_restore-current-size :
     3754     do
     3755     on error undo, return error return-value
     3756     :
     3757       run diasize_set-height in this-procedure
     3758         (input  v-diasize-current-frame-height
     3759         ,input  true
     3760         ) .
     3761       run diasize_set-width in this-procedure
     3762         (input  v-diasize-current-frame-width
     3763         ,input  true
     3764         ) .
     3765     end.
     3766   end procedure.
     3767   procedure diasize_set-browse-handle :
     3768     define input  parameter p-browse-handle as handle   no-undo .
     3769     define buffer buf_temp-browse-handle for temp-browse-handle .
     3770     do
     3771     on error undo, return error return-value
     3772     :
     3773       assign
     3774         v-diasize-browse-handle = p-browse-handle
     3775       .
     3776       for each buf_temp-browse-handle
     3777       on error undo, return error return-value
     3778       :
     3779         delete buf_temp-browse-handle .
     3780       end.
     3781     end.
     3782   end procedure.
     3783   procedure diasize_add_browse :
     3784     define input  parameter p-browse-type   as character no-undo .
     3785     define input  parameter p-browse-handle as handle    no-undo .
     3786     define buffer buf_temp-browse-handle for temp-browse-handle .
     3787     do
     3788     on error undo, return error return-value
     3789     :
     3790       assign
     3791         v-diasize-browse-number = v-diasize-browse-number + 1
     3792       .
     3793       create buf_temp-browse-handle .
     3794       assign
     3795         buf_temp-browse-handle.browse-type   = p-browse-type
     3796         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3797         buf_temp-browse-handle.browse-handle = p-browse-handle
     3798       .
     3799     end.
     3800   end procedure.
     3801   procedure diasize_init :
     3802     define variable v-default-value    as logical   no-undo .
     3803     define variable v-restore-saved    as logical   no-undo .
     3804     define variable v-resize-value-str as character no-undo .
     3805     do
     3806     on error undo, return error return-value
     3807     :
     3808       do with frame Dialog-Frame
     3809       :
     3810         assign
     3811           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3812           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3813           v-diasize-browse-handle     = browse BR-add :handle
     3814         .
     3815         create button v-diasize-resize-button
     3816         assign
     3817           parent        = frame Dialog-Frame :first-child
     3818           label         = "s"
     3819           height-pixels = 16
     3820           width-pixels  = 16
     3821           visible       = true
     3822           sensitive     = true
     3823           movable       = true
     3824           triggers:
     3825             on end-move persistent run diasize_end-move in this-procedure .
     3826           end triggers.
     3827         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3828         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3829         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3830         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3831         assign
     3832           v-diasize-wndmax = false
     3833         .
     3834         if connected("ub") = true
     3835         then do:
     3836           define variable v-cntxt-db-num        as integer   no-undo .
     3837           define variable v-cntxt-userid        as character no-undo .
     3838           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3839                                             , OUTPUT v-cntxt-userid
     3840                                             ) .
     3841           run gbl/wndpar_r.p
     3842             (input  v-cntxt-db-num
     3843             ,input  v-cntxt-userid
     3844             ,input  'wndmax':U
     3845             ,output v-diasize-wndmax
     3846             ,output v-default-value
     3847             ) .
     3848         end.
     3849         assign
     3850           v-diasize-wndstore = false
     3851         .
     3852         if connected("ub") = true
     3853         then do:
     3854           run gbl/wndpar_r.p
     3855             (input  v-cntxt-db-num
     3856             ,input  v-cntxt-userid
     3857             ,input  'wndstore':U
     3858             ,output v-diasize-wndstore
     3859             ,output v-default-value
     3860             ) .
     3861         end.
     3862         assign
     3863           v-diasize-proc-name = entry(1, program-name(2), '.')
     3864         .
     3865         if v-diasize-wndstore = true
     3866         then do:
     3867           assign
     3868             v-restore-saved = false
     3869           .
     3870           if connected("ub") = true
     3871           then do:
     3872             run gbl/wndsizer.p
     3873               (input  v-cntxt-db-num
     3874               ,input  v-cntxt-userid
     3875               ,input  v-diasize-proc-name
     3876               ,input  'height':u
     3877               ,output v-resize-value-str
     3878               ) .
     3879             if v-resize-value-str <> '':U
     3880             then do:
     3881               run diasize_change-height in this-procedure
     3882                 (input  integer(v-resize-value-str)
     3883                 ,input  true
     3884                 ) .
     3885               assign
     3886                 v-restore-saved = true
     3887               .
     3888             end.
     3889           end.
     3890           if connected("ub") = true
     3891           then do:
     3892             run gbl/wndsizer.p
     3893               (input  v-cntxt-db-num
     3894               ,input  v-cntxt-userid
     3895               ,input  v-diasize-proc-name
     3896               ,input  'width':u
     3897               ,output v-resize-value-str
     3898               ) .
     3899             if v-resize-value-str <> '':U
     3900             then do:
     3901               run diasize_change-width in this-procedure
     3902                 (input  integer(v-resize-value-str)
     3903                 ,input  true
     3904                 ) .
     3905               assign
     3906                 v-restore-saved = true
     3907               .
     3908             end.
     3909           end.
     3910           if v-restore-saved <> true
     3911           then do:
     3912             if v-diasize-wndmax = true
     3913             then do:
     3914               run diasize_maximize in this-procedure
     3915                 (input  true
     3916                 ) .
     3917             end.
     3918           end.
     3919         end.
     3920         else do:
     3921           if v-diasize-wndmax = true
     3922           then do:
     3923             run diasize_maximize in this-procedure
     3924               (input  true
     3925               ) .
     3926           end.
     3927         end.
     3928       end.
     3929     end.
     3930   end procedure.
     3931   procedure diasize_need-full-display :
     3932     define output parameter p-need-full-display as logical   no-undo .
     3933     do
     3934     on error undo, return error return-value
     3935     :
     3936       assign
     3937         p-need-full-display = v-diasize-need-full-display
     3938       .
     3939       assign
     3940         v-diasize-need-full-display = false
     3941       .
     3942     end.
     3943   end procedure.
     3944   procedure get-context :
     3945      define output parameter p-db-num as integer          no-undo.
     3946      define output parameter p-user-id as character        no-undo.
     3947      define variable v-login               as character    no-undo.
     3948      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3949      define buffer buf_user-login  for ub.user-login .
     3950      do
     3951      on error undo, return error
     3952      :
     3953            FIND FIRST buf_sys-ctrl no-lock.
     3954            ASSIGN
     3955               v-login = USERID("ub")
     3956               p-db-num = buf_sys-ctrl.db-num
     3957            .
     3958            FIND FIRST buf_user-login
     3959                 WHERE buf_user-login.db-num = p-db-num
     3960                   AND buf_user-login.user-login = v-login
     3961                 no-lock
     3962                 no-error
     3963                 .
     3964            IF AVAILABLE buf_user-login
     3965            THEN DO:
     3966               assign
     3967                  p-user-id = buf_user-login.user-id
     3968               .
     3969            END.
     3970      end.
     3971   end procedure.
     3972       run diasize_init in this-procedure .
     3973   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3974   ON RETURN ANYWHERE
     3975   DO:
     3976   define variable ii as integer no-undo .
     3977   define variable fh as widget-handle no-undo .
     3978   define variable hh as widget-handle no-undo .
     3979   define variable v-next-widget-name as character no-undo .
     3980     if v-tab-order <> '' then do:
     3981       assign
     3982       ii = lookup(self:name, v-tab-order).
     3983       if ii = num-entries(v-tab-order) then do:
     3984           APPLY 'CHOOSE' TO b-exit in frame Dialog-Frame.
     3985           return no-apply.
     3986       end.
     3987       if self:type <> "BUTTON" and
     3988         self:type <> "EDITOR"  then do:
     3989         run proc-move-forward in this-procedure .
     3990         return no-apply.
     3991       end.
     3992       if self:type = "BUTTON" then do:
     3993         APPLY "CHOOSE" to self.
     3994       end.
     3995       if self:type = "TOGGLE-BOX" then
     3996       self:BGCOLOR = ?.
     3997       assign
     3998       ii = ii + 1
     3999       v-next-widget-name = entry(ii, v-tab-order)
     4000       no-error .
     4001       if error-status:error then do:
     4002         assign
     4003         ii = 1
     4004         v-next-widget-name = entry( ii, v-tab-order)
     4005         .
     4006       end.
     4007       assign
     4008       fh = frame Dialog-Frame:first-child
     4009       hh = fh:first-child
     4010       .
     4011       do while valid-handle(hh):
     4012         if hh:name = v-next-widget-name then do:
     4013           if hh:sensitive  = yes
     4014           AND hh:visible = yes then do:
     4015             if hh:type = "TOGGLE-BOX":U then do:
     4016               assign
     4017               hh:BGcolor = 1
     4018               .
     4019             end.
     4020             APPLY "ENTRY" to hh.
     4021             return no-apply.
     4022           end.
     4023           else do:
     4024             APPLY "TAB" to hh.
     4025             return no-apply.
     4026           end.
     4027         end.
     4028         hh = hh:next-sibling.
     4029       end.
     4030     end.
     4031   END.
     4032   procedure proc-move-forward :
     4033   define variable ii as integer no-undo .
     4034   define variable fh as widget-handle no-undo .
     4035   define variable hh as widget-handle no-undo .
     4036   define variable v-next-widget-name as character no-undo .
     4037   do
     4038   on error undo, return error
     4039   :
     4040     if v-tab-order <> '' then do:
     4041       if self:type = "TOGGLE-BOX" then
     4042       self:BGCOLOR = ?.
     4043       assign
     4044       ii = lookup(self:name, v-tab-order).
     4045       assign
     4046       ii = ii + 1
     4047       v-next-widget-name = entry(ii, v-tab-order)
     4048       no-error .
     4049       if error-status:error then do:
     4050         assign
     4051         ii = 1
     4052         v-next-widget-name = entry( ii, v-tab-order)
     4053         .
     4054       end.
     4055       assign
     4056       fh = frame Dialog-Frame:first-child
     4057       hh = fh:first-child
     4058       .
     4059       do while valid-handle(hh):
     4060         if hh:name = v-next-widget-name then do:
     4061           if hh:sensitive  = yes
     4062           AND hh:visible = yes then do:
     4063             if hh:type = "TOGGLE-BOX":U then do:
     4064               assign
     4065               hh:BGcolor = 1
     4066               .
     4067             end.
     4068             APPLY "ENTRY" to hh.
     4069             return.
     4070           end.
     4071           else do:
     4072             assign
     4073             ii = ii + 1
     4074             v-next-widget-name = entry(ii, v-tab-order)
     4075             no-error .
     4076             if error-status:error then do:
     4077               assign
     4078               ii = 1
     4079               v-next-widget-name = entry( ii, v-tab-order)
     4080               .
     4081             end.
     4082           end.
     4083         end.
     4084         hh = hh:next-sibling.
     4085       end.
     4086     end.
     4087   end.
     4088   end procedure.
     4089   MAIN-BLOCK:
     4090   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     4091      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     4092   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4093     run mainmenu_getcntxt in parparentproc
     4094       (output v-cntxt-db-num
     4095       ,output v-cntxt-userid
     4096       ,output v-cntxt-level
     4097       ,output v-cntxt-host-code-obj
     4098       ,output v-cntxt-obj-type
     4099       ,output v-cntxt-obj-code
     4100       ,output v-cntxt-db-num-obj
     4101       ,output v-cntxt-is-admin
     4102       ) .
     4103     if lookup(par-subject, 'dis-gds-rule':U) = 0 then do:
     4104       message
     4105       vss-workfile vss-revision vss-description skip
     4106       "Неверное значение параметра par-subject" par-subject
     4107       view-as alert-box error.
     4108       return error.
     4109     end.
     4110     find first X_clients-obj no-lock where
     4111                 X_clients-obj.obj-type = parobj-type AND
     4112                 X_clients-obj.obj-code = parobj-code no-error .
     4113     if not avail X_clients-obj then do:
     4114       message vss-workfile vss-revision vss-description skip
     4115       "Неверное значение параметра parobj-type и/или parobj-code" parobj-type parobj-code
     4116       view-as alert-box error.
     4117       return error.
     4118     end.
     4119     RUN enable_UI in this-procedure .
     4120     RUN MYenable in this-procedure .
     4121     WAIT-FOR GO OF FRAME Dialog-Frame.
     4122   END.
     4123   RUN disable_UI in this-procedure .
     4124   PROCEDURE choose-to-add :
     4125   define input parameter p-attr-code as character no-undo .
     4126   assign
     4127   add-option = p-attr-code
     4128   .
     4129    APPLY "CHOOSE" to b-add in frame Dialog-Frame .
     4130   END PROCEDURE.
     4131   PROCEDURE choose-to-delete :
     4132   define input parameter p-attr-code as character no-undo .
     4133   assign
     4134   add-option = p-attr-code
     4135   .
     4136   APPLY "CHOOSE" to b-add-2 in frame Dialog-Frame .
     4137   END PROCEDURE.
     4138   PROCEDURE disable_UI :
     4139     HIDE FRAME Dialog-Frame.
     4140   END PROCEDURE.
     4141   PROCEDURE enable_UI :
     4142     DISPLAY rs-list  T-delete-ok
     4143         WITH FRAME Dialog-Frame.
     4144     ENABLE B-exit b-quit rs-list B-list B-list-2 B-Help
     4145            B-obj T-delete-ok b-add B-chg B-del BR-add b-add-2 B-chg-2 B-del-2
     4146            BR-del
     4147         WITH FRAME Dialog-Frame.
     4148     VIEW FRAME Dialog-Frame.
     4149     OPEN QUERY BR-add FOR EACH temp-disc where temp-disc.action = yes NO-LOCK.    OPEN QUERY BR-del FOR EACH del_temp-disc where del_temp-disc.action = no NO-LOCK.
     4150   END PROCEDURE.
     4151   PROCEDURE init-proc :
     4152   assign
     4153   add-option = ""
     4154   add-obj-type = "":U
     4155   add-obj-code = 0
     4156   .
     4157   OPEN QUERY BR-add FOR EACH temp-disc where temp-disc.action = yes NO-LOCK.    OPEN QUERY BR-del FOR EACH del_temp-disc where del_temp-disc.action = no NO-LOCK.
     4158   END PROCEDURE.
     4159   PROCEDURE MyEnable :
     4160   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     4161   DEFINE VARIABLE ch AS WIDGET-HANDLE NO-UNDO.
     4162   ch = br-add:FIRST-COLUMN IN FRAME Dialog-Frame.
     4163   DO ii = 1 TO br-add:NUM-COLUMNS IN FRAME Dialog-Frame:
     4164       ASSIGN
     4165       ch:RESIZABLE = YES.
     4166       ch = ch:NEXT-COLUMN.
     4167   END.
     4168   assign
     4169   b-add:MENU-MOUSE in frame Dialog-Frame = 1
     4170   b-add-2:MENU-MOUSE in frame Dialog-Frame = 1
     4171   .
     4172   RUN proc-title IN THIS-PROCEDURE.
     4173   APPLY "VALUE-CHANGED" to rs-list.
     4174   END PROCEDURE.
     4175   PROCEDURE proc-b-add :
     4176   define input parameter p-pos-type as character no-undo.
     4177   define variable v-deleted       as logical   no-undo .
     4178   define variable v-rid-list as character no-undo .
     4179   define variable v-host-code as integer no-undo .
     4180   define variable v-rec as recid no-undo .
     4181   define variable v-obj-type as character no-undo .
     4182   define variable v-obj-code as integer no-undo .
     4183   define variable v-cfg-nonunique as character no-undo .
     4184   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     4185   define buffer buf_temp-disc    for temp-disc.
     4186   do
     4187   on error undo, return error :
     4188     run ref/dis-pos.w ( INPUT parparentproc
     4189                         ,INPUT "b-sel":U
     4190                         ,INPUT "cd-type-list"
     4191                         ,INPUT (if v-cntxt-db-num = 0 and loc-glob then 1 else 0)
     4192                         ,INPUT (if v-cntxt-db-num = 0 and loc-firm then 1 else 0)
     4193                         ,INPUT 1
     4194                         ,input 'dis-gds-rule':U
     4195                         ,input '':U
     4196                         ,input ?
     4197                         ,INPUT p-pos-type
     4198                         ,input '':U
     4199                         ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     4200     IF ERROR-STATUS:ERROR
     4201     OR v-rid-list = '':U THEN DO:
     4202       RETURN.
     4203     END.
     4204     FIND FIRST buf_dis-cfg-rule NO-LOCK where
     4205               recid(buf_dis-cfg-rule) = INTEGER(v-rid-list).
     4206     if buf_dis-cfg-rule.nonunique <> ''
     4207     and num-entries(buf_dis-cfg-rule.nonunique, ".") > 1 then do:
     4208       case buf_dis-cfg-rule.nonunique:
     4209         when "bar-code.b-code" then do:
     4210           if rs-list = "gds-list" then do:
     4211             message
     4212             "Нельзя задать такую скидку по списку товаров!"
     4213             view-as alert-box error .
     4214             return error.
     4215           end.
     4216           v-cfg-nonunique = substitute("@&1", buf_dis-cfg-rule.nonunique).
     4217         end.
     4218         otherwise do:
     4219           message
     4220           substitute("Неизвестная опция для дифференциации скидки внутри одного товара=&1", buf_dis-cfg-rule.nonunique)
     4221           view-as alert-box error .
     4222           return error.
     4223         end.
     4224       end case.
     4225     end.
     4226     else do:
     4227       if rs-list = "bb-list" then do:
     4228         message
     4229         "Нельзя задать такую скидку по списку бар-кодов!"
     4230         view-as alert-box error .
     4231         return error.
     4232       end.
     4233       v-cfg-nonunique = buf_dis-cfg-rule.nonunique.
     4234     end.
     4235     assign
     4236     v-obj-type = parobj-type
     4237     v-obj-code = parobj-code
     4238     .
     4239   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4240   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4241     (input  parobj-type
     4242     ,input  parobj-code
     4243     ,output v-host-code
     4244     )  .
     4245     run temp-dsc-write in this-procedure (
     4246                                            input yes
     4247                                           ,input buf_dis-cfg-rule.pos-type
     4248                                           ,input buf_dis-cfg-rule.templ-rl-root
     4249                                           ,input buf_dis-cfg-rule.time-templ-rl-root
     4250                                           ,input buf_dis-cfg-rule.discnt-role
     4251                                           ,input v-cfg-nonunique
     4252                                           ,input v-host-code
     4253                                           ,input v-obj-type
     4254                                           ,input v-obj-code
     4255                                           ,input 0
     4256                                           ,input yes
     4257                                           ,input-output v-rec
     4258                                     ) no-error .
     4259     IF ERROR-STATUS:ERROR THEN DO:
     4260       if return-value = "not-set" then do:
     4261       end.
     4262       else do:
     4263         message "Ошибка при определении названия и типа скидки !"         skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     4264       end.
     4265       undo,  return error.
     4266     END.
     4267     updated = yes.
     4268     find first buf_temp-disc no-lock where
     4269               recid(buf_temp-disc) = v-rec no-error.
     4270     if avail buf_temp-disc then
     4271     temp-doc-rec = recid(buf_temp-disc).
     4272     else temp-doc-rec = ?.
     4273     Run init-proc in this-procedure no-error.
     4274     if error-status:error then do:
     4275       undo, return error.
     4276     end.
     4277     REPOSITION br-add to recid temp-doc-rec no-error.
     4278     run proc-b-chg in this-procedure ( input "":U) no-error.
     4279     if error-status:error then do:
     4280         run temp-dsc-delete in this-procedure (
     4281                                                  input buf_dis-cfg-rule.pos-type
     4282                                                 ,input buf_dis-cfg-rule.discnt-role
     4283                                                 ,input v-cfg-nonunique
     4284                                                 ,input v-host-code
     4285                                                 ,input v-obj-type
     4286                                                 ,input v-obj-code
     4287                                                 ,input yes
     4288                                                 ,output v-deleted
     4289                                                 ) no-error .
     4290       Run init-proc in this-procedure no-error.
     4291       undo, return error.
     4292     end.
     4293     APPLY "ENTRY" to br-add in frame Dialog-Frame.
     4294   end.
     4295   END PROCEDURE.
     4296   PROCEDURE proc-b-add-2 :
     4297   define input parameter p-pos-type as character no-undo.
     4298   DEFINE VARIABLE v-deleted as logical no-undo .
     4299   define variable loc#log as logical no-undo.
     4300   define variable loc-action as logical no-undo.
     4301   define variable v-rid-list as character no-undo .
     4302   define variable v-obj-type as character no-undo .
     4303   define variable v-obj-code as integer no-undo .
     4304   define variable v-host-code as integer no-undo .
     4305   define variable v-rule-num as integer no-undo .
     4306   define variable v-cfg-nonunique as character no-undo .
     4307   define variable v-nonunique as character no-undo .
     4308   define variable v-rec as recid no-undo .
     4309   define buffer buf_temp-disc for temp-disc.
     4310   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
     4311   CASE par-subject :
     4312     WHEN 'dis-gds-rule':U THEN DO:
     4313       run ref/dis-pos.w ( INPUT parparentproc
     4314                           ,INPUT "b-sel":U
     4315                           ,INPUT "cd-type-list"
     4316                           ,INPUT (if v-cntxt-db-num = 0 then 1 else 0)
     4317                           ,INPUT (if v-cntxt-db-num = 0 then 1 else 0)
     4318                           ,INPUT 1
     4319                           ,input 'dis-gds-rule':U
     4320                           ,input '':U
     4321                           ,input ?
     4322                           ,INPUT p-pos-type
     4323                           ,input '':U
     4324                           ,INPUT-OUTPUT v-rid-list) NO-ERROR.
     4325       IF ERROR-STATUS:ERROR
     4326       OR v-rid-list = '':U THEN DO:
     4327         RETURN.
     4328       END.
     4329       FIND FIRST buf_dis-cfg-rule NO-LOCK where
     4330                 recid(buf_dis-cfg-rule) = INTEGER(v-rid-list).
     4331       if buf_dis-cfg-rule.nonunique <> ''
     4332       and num-entries(buf_dis-cfg-rule.nonunique, ".") > 1 then do:
     4333         case buf_dis-cfg-rule.nonunique:
     4334           when "bar-code.b-code" then do:
     4335             if rs-list = "gds-list" then do:
     4336               message
     4337               "Нельзя задать такую скидку по списку товаров!"
     4338               view-as alert-box error .
     4339               return error.
     4340             end.
     4341             v-cfg-nonunique = substitute("@&1", buf_dis-cfg-rule.nonunique).
     4342           end.
     4343           otherwise do:
     4344             message
     4345             substitute("Неизвестная опция для дифференциации скидки внутри одного товара=&1", buf_dis-cfg-rule.nonunique)
     4346             view-as alert-box error .
     4347             return error.
     4348           end.
     4349         end case.
     4350       end.
     4351       else do:
     4352         if rs-list = "bb-list" then do:
     4353           message
     4354           "Нельзя задать такую скидку по списку бар-кодов!"
     4355           view-as alert-box error .
     4356           return error.
     4357         end.
     4358         v-cfg-nonunique = buf_dis-cfg-rule.nonunique.
     4359       end.
     4360       assign
     4361       v-obj-type = parobj-type
     4362       v-obj-code = parobj-code
     4363       .
     4364   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4365   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4366     (input  parobj-type
     4367     ,input  parobj-code
     4368     ,output v-host-code
     4369     )  .
     4370       run temp-dsc-write in this-procedure (
     4371                                               input yes
     4372                                              ,input buf_dis-cfg-rule.pos-type
     4373                                              ,input buf_dis-cfg-rule.templ-rl-root
     4374                                              ,input buf_dis-cfg-rule.time-templ-rl-root
     4375                                              ,input buf_dis-cfg-rule.discnt-role
     4376                                              ,input v-cfg-nonunique
     4377                                              ,input v-host-code
     4378                                              ,input v-obj-type
     4379                                              ,input v-obj-code
     4380                                              ,input v-rule-num
     4381                                              ,input no
     4382                                              ,input-output v-rec )  no-error.
     4383        IF ERROR-STATUS:ERROR THEN DO:
     4384         if return-value = "not-set" then do:
     4385         end.
     4386         else do:
     4387           message "Ошибка при определении названия и типа скидки !"         skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     4388           return error.
     4389         end.
     4390       END.
     4391       define buffer bb_temp-disc for temp-disc.
     4392       find first bb_temp-disc no-error.
     4393     END.
     4394   END CASE.
     4395   updated = yes.
     4396   find first buf_temp-disc no-lock where
     4397             recid(buf_temp-disc) = v-rec no-error .
     4398   if avail buf_temp-disc then
     4399     temp-doc-rec = recid(buf_temp-disc).
     4400     else temp-doc-rec = ?.
     4401   Run init-proc in this-procedure .
     4402   reposition BR-del to recid temp-doc-rec no-error.
     4403   if error-status:error then return error.
     4404   run proc-b-chg-2 in this-procedure ( input "":U) no-error.
     4405   if error-status:error then do:
     4406       run temp-dsc-delete in this-procedure (
     4407                                                input buf_dis-cfg-rule.pos-type
     4408                                               ,input buf_dis-cfg-rule.discnt-role
     4409                                               ,input v-cfg-nonunique
     4410                                               ,input v-host-code
     4411                                               ,input v-obj-type
     4412                                               ,input v-obj-code
     4413                                               ,input no
     4414                                               ,output v-deleted
     4415                                               ) no-error .
     4416     Run init-proc in this-procedure no-error.
     4417     undo, return error.
     4418   end.
     4419   APPLY "ENTRY" to br-del in frame Dialog-Frame .
     4420   END PROCEDURE.
     4421   PROCEDURE proc-b-chg :
     4422   define input parameter p-mode as character no-undo .
     4423   define variable v-rule-num as integer no-undo .
     4424   define variable v-nonunique as character no-undo .
     4425   define variable v-rec as recid no-undo .
     4426   if not avail temp-disc then return error.
     4427     RUN temp-dsc-VALUE IN THIS-PROCEDURE (
     4428                                          input temp-disc.pos-type
     4429                                         ,input temp-disc.templ-rl-root
     4430                                         ,input temp-disc.time-templ-rl-root
     4431                                         ,input temp-disc.discnt-role
     4432                                         ,input temp-disc.cfg-nonunique
     4433                                         ,input temp-disc.host-code
     4434                                         ,input temp-disc.obj-type
     4435                                         ,input temp-disc.obj-code
     4436                                         ,input 'ДОБАВЛЕНИЕ':U
     4437                                         ,input p-mode
     4438                                         ,input recid(temp-disc)
     4439                                         ,OUTPUT v-rule-num
     4440                                         ,output v-nonunique
     4441                                         ) NO-ERROR.
     4442     IF ERROR-STATUS:ERROR THEN DO:
     4443       if return-value <> "not-set":U then do:
     4444         message "Ошибка при определении значения скидки !"         skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     4445         RETURN error.
     4446       end.
     4447     END.
     4448     if return-value = "not-set":U
     4449     and p-mode <> "change":U then do:
     4450       delete temp-disc.
     4451       glog = br-add:refresh() in frame Dialog-Frame no-error .
     4452       return .
     4453     end.
     4454     v-rec = recid(temp-disc).
     4455     run temp-dsc-write (
     4456                          input no
     4457                         ,input temp-disc.pos-type
     4458                         ,input temp-disc.templ-rl-root
     4459                         ,input temp-disc.time-templ-rl-root
     4460                         ,input temp-disc.discnt-role
     4461                         ,input temp-disc.cfg-nonunique
     4462                         ,input temp-disc.host-code
     4463                         ,input temp-disc.obj-type
     4464                         ,input temp-disc.obj-code
     4465                         ,input v-rule-num
     4466                         ,input temp-disc.action
     4467                         ,input-output v-rec
     4468                         ) no-error.
     4469     IF not error-status:error then do:
     4470       assign
     4471       updated = yes
     4472       .
     4473     END.
     4474     glog = br-add:refresh() in frame Dialog-Frame no-error .
     4475     APPLY "ENTRY" to br-add.
     4476   END PROCEDURE.
     4477   PROCEDURE proc-b-chg-2 :
     4478   define input parameter p-mode as character no-undo .
     4479   define variable v-rule-num as integer no-undo .
     4480   define variable v-nonunique as character no-undo .
     4481   define variable v-rec as recid no-undo .
     4482   if not avail del_temp-disc then return error.
     4483     RUN temp-dsc-VALUE IN THIS-PROCEDURE (
     4484                                          input del_temp-disc.pos-type
     4485                                         ,input del_temp-disc.templ-rl-root
     4486                                         ,input del_temp-disc.time-templ-rl-root
     4487                                         ,input del_temp-disc.discnt-role
     4488                                         ,input del_temp-disc.cfg-nonunique
     4489                                         ,input del_temp-disc.host-code
     4490                                         ,input del_temp-disc.obj-type
     4491                                         ,input del_temp-disc.obj-code
     4492                                         ,input 'удаление':U
     4493                                         ,input p-mode
     4494                                         ,input recid(del_temp-disc)
     4495                                         ,OUTPUT v-rule-num
     4496                                         ,output v-nonunique
     4497                                         ) NO-ERROR.
     4498     IF ERROR-STATUS:ERROR THEN DO:
     4499       if return-value <> "not-set":U then do:
     4500         message "Ошибка при определении значения скидки !"         skip error-status:get-message(1) skip         return-value skip view-as alert-box ERROR.
     4501         RETURN error.
     4502       end.
     4503     END.
     4504     if return-value = "not-set":U
     4505     and p-mode <> "change":U then do:
     4506       delete del_temp-disc.
     4507       glog = br-del:refresh() in frame Dialog-Frame no-error .
     4508       return .
     4509     end.
     4510     v-rec = recid(del_temp-disc).
     4511     run temp-dsc-write (
     4512                          input no
     4513                         ,input del_temp-disc.pos-type
     4514                         ,input del_temp-disc.templ-rl-root
     4515                         ,input del_temp-disc.time-templ-rl-root
     4516                         ,input del_temp-disc.discnt-role
     4517                         ,input del_temp-disc.cfg-nonunique
     4518                         ,input del_temp-disc.host-code
     4519                         ,input del_temp-disc.obj-type
     4520                         ,input del_temp-disc.obj-code
     4521                         ,input v-rule-num
     4522                         ,input del_temp-disc.action
     4523                         ,input-output v-rec
     4524                         ) no-error.
     4525     IF not error-status:error then do:
     4526       assign
     4527       updated = yes
     4528       .
     4529     END.
     4530     glog = br-del:refresh() in frame Dialog-Frame no-error .
     4531     APPLY "ENTRY" to br-del.
     4532   END PROCEDURE.
     4533   PROCEDURE proc-b-exit :
     4534   define variable loc#log as logical no-undo .
     4535   define variable v-not-all-ok as logical no-undo .
     4536   define variable v-host-code  as integer no-undo .
     4537   define variable v-des           like ub.dis-rule.des .
     4538   define variable v-templ-rl-root like ub.dis-rule.templ-rl-root .
     4539   define variable p-parent-handle  as widget-handle no-undo .
     4540   define variable v-view-log as logical no-undo .
     4541   define buffer buf_temp-disc for temp-disc.
     4542   define buffer buf_old-temp-disc          for old-temp-disc.
     4543   define buffer buf_dis-rule for ub.dis-rule.
     4544   define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     4545   if not can-find(first temp-disc) then do:
     4546       message "Вы не определили список скидок для изменения (добавления, удаления)"
     4547       view-as alert-box.
     4548       return no-apply.
     4549   end.
     4550       if (rs-list = "gds-list" and not can-find(first gds-list))
     4551       or (rs-list = "bb-list" and not can-find(first bb-list))
     4552         then do:
     4553         message "Вы не определили список товаров/бар-кодов"
     4554         view-as alert-box.
     4555         return no-apply.
     4556       end.
     4557   if not can-find(first buf_userobjs_temp-user-obj) then do:
     4558       message "Вы не определили список объектов, скидки" skip
     4559               "будут применены только к текущему объекту." skip
     4560               "Продолжить?"
     4561       view-as alert-box question buttons yes-no update loc#log .
     4562       if not loc#log then do:
     4563         return no-apply .
     4564         end.
     4565       end.
     4566   ASSIGN
     4567   FRAME Dialog-Frame t-delete-ok .
     4568       message
     4569       "Вы уверены, что Вы хотите провести изменение (добавление, удаление) скидок товара на объекте" SKIP
     4570       "по всему определенному Вами списку?"
     4571       view-as alert-box QUESTION buttons YES-NO update loc#log.
     4572       if loc#log then do:
     4573    _main:
     4574    DO
     4575    on error undo, return no-apply
     4576    :
     4577       CASE par-subject:
     4578       when 'dis-gds-rule':U then do:
     4579         run str/diallog.w (
     4580                 input parparentproc
     4581               , input this-procedure
     4582               , input "ref/dgr-lst.p":U
     4583               , input (parobj-type + chr(4) +
     4584                        string(parobj-code) + chr(4) +
     4585                        string(t-delete-ok) + chr(4) +
     4586                        rs-list
     4587                        )
     4588                 , input v-auto-go
     4589               , input "&Стоп":U
     4590               , input substitute("Изменение скидок товаров на объекте &1&2 по списку товаров (бар-кодов)"
     4591                                   , parobj-type
     4592                                   , parobj-code
     4593                                   )
     4594           ) no-error.
     4595           if error-status:error then do:
     4596               undo _main, return error .
     4597           end.
     4598       end .
     4599       END CASE .
     4600       run proc-check-rule1 in this-procedure no-error.
     4601       if error-status:error then do:
     4602           assign
     4603           v-view-log = yes.
     4604   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4605   if v-view-log
     4606   and not g#news
     4607   and not g#auto
     4608   then do:
     4609     message
     4610     '!!!При копировании скидок на объекты произошли ошибки!!!'  skip
     4611     "!!!Внимательно прочитайте Log-file!!"
     4612     view-as alert-box error .
     4613        define variable v-user-action26   as character no-undo .
     4614     define variable v-printed26       as logical   no-undo .
     4615     run gbl/prnfilen.w
     4616       (input  ('!!!При копировании скидок на объекты произошли ошибки!!!')
     4617       ,input  0
     4618       ,input  (string("./":U) + 'dgrbylst.txt')
     4619       ,input  7
     4620       ,output v-user-action26
     4621       ,output v-printed26
     4622       ) .
     4623   end.
     4624   if v-view-log = true
     4625   and (g#news
     4626   or g#auto)
     4627   and valid-handle(p-parent-handle) and lookup("cb_set-view-log", p-parent-handle:internal-entries) > 0
     4628   then do:
     4629      run cb_set-view-log in p-parent-handle ( input yes).
     4630   end.
     4631   if not v-view-log and search("cdviewlg_do-not-delete-log-file.txt") = ? then do:
     4632     OS-DELETE value(string("./":U) + 'dgrbylst.txt').
     4633   end.
     4634           undo _main, return error .
     4635       end .
     4636       for each old-temp-disc exclusive-lock :
     4637           delete old-temp-disc.
     4638       end.
     4639       for each buf_temp-disc no-lock :
     4640           create buf_old-temp-disc.
     4641           buffer-copy buf_temp-disc to buf_old-temp-disc.
     4642       end.
     4643       find first temp-disc no-lock
     4644       where temp-disc.action = no no-error.
     4645       if avail temp-disc then do:
     4646             for each temp-disc exclusive-lock
     4647             where temp-disc.action = yes :
     4648                 delete temp-disc.
     4649             end.
     4650             glog = br-add:refresh() in frame Dialog-Frame no-error .
     4651             find first temp-disc no-lock no-error.
     4652             _userobjs_temp-user-obj:
     4653             for each buf_userobjs_temp-user-obj no-lock :
     4654                 if buf_userobjs_temp-user-obj.obj-type = parobj-type and
     4655                    buf_userobjs_temp-user-obj.obj-code = parobj-code then do:
     4656                      next _userobjs_temp-user-obj .
     4657                 end.
     4658                 for each temp-disc exclusive-lock :
     4659                     assign
     4660                       temp-disc.obj-type = buf_userobjs_temp-user-obj.obj-type .
     4661                       temp-disc.obj-code = buf_userobjs_temp-user-obj.obj-code .
     4662                     .
     4663                     if not ( temp-disc.rule-num = ? or temp-disc.rule-num = 0 ) then do:
     4664                         find first buf_dis-rule no-lock
     4665                         where buf_dis-rule.rule-num = temp-disc.rule-num no-error.
     4666                         if avail buf_dis-rule then do:
     4667         assign
     4668                               v-des           = buf_dis-rule.des
     4669                               v-templ-rl-root = buf_dis-rule.templ-rl-root
     4670                             .
     4671                             find first buf_dis-rule no-lock
     4672                             where buf_dis-rule.des = v-des
     4673                               and buf_dis-rule.host-code = temp-disc.host-code
     4674                               and buf_dis-rule.obj-type  = temp-disc.obj-type
     4675                               and buf_dis-rule.obj-code  = temp-disc.obj-code
     4676                               and buf_dis-rule.templ-rl-root = v-templ-rl-root
     4677                               and buf_dis-rule.root = yes no-error.
     4678                             if avail buf_dis-rule then do:
     4679                                 assign
     4680                                   temp-disc.rule-num = buf_dis-rule.rule-num
     4681                                 .
     4682                             end.
     4683                         end.
     4684                     end.
     4685                 end.
     4686                 run str/diallog.w (
     4687                       input parparentproc
     4688                     , input this-procedure
     4689                     , input "ref/dgr-lst.p":U
     4690                     , input (buf_userobjs_temp-user-obj.obj-type + chr(4) +
     4691                              string( buf_userobjs_temp-user-obj.obj-code ) + chr(4) +
     4692                              string(t-delete-ok) + chr(4) +
     4693                              rs-list
     4694                              )
     4695                     , input v-auto-go
     4696                     , input "&Стоп":U
     4697                     , input substitute("Изменение скидок товаров на объекте &1&2 по списку товаров (баркодов)"
     4698                                         , buf_userobjs_temp-user-obj.obj-type
     4699                                         , buf_userobjs_temp-user-obj.obj-code
     4700                                         )
     4701                 ) no-error .
     4702                 if error-status:error then do:
     4703                      undo _main, return error .
     4704                 end.
     4705             end .
     4706       end .
     4707       for each temp-disc exclusive-lock :
     4708          delete temp-disc.
     4709       end.
     4710       for each buf_old-temp-disc no-lock :
     4711          create buf_temp-disc.
     4712          buffer-copy buf_old-temp-disc to buf_temp-disc.
     4713     end.
     4714       glog = br-del:refresh() in frame Dialog-Frame no-error .
     4715       glog = br-add:refresh() in frame Dialog-Frame no-error .
     4716     END.
     4717   end .
     4718   assign
     4719   v-not-all-ok = (if rs-list = "gds-list" then can-find(first gds-list) else can-find(bb-list)) .
     4720   if v-not-all-ok and t-delete-ok then do:
     4721     if rs-list = "gds-list" then do:
     4722       assign
     4723       b-list:label = "Неизменившиеся".
     4724     end.
     4725     else do:
     4726       assign
     4727       b-list-2:label = "Неизменившиеся".
     4728     end.
     4729   end.
     4730   END PROCEDURE.
     4731   PROCEDURE proc-check-rule1 :
     4732     define variable v-parameter    as character no-undo.
     4733     define variable t-dis-gds-rule as logical   no-undo init yes.
     4734     define variable v-cd-type      as character no-undo .
     4735     define variable v-host-code    as integer   no-undo .
     4736     define variable v-cli-host-code as integer   no-undo .
     4737     define variable v-cli-obj-code  as integer   no-undo .
     4738     define variable v-cli-obj-type  as character   no-undo .
     4739     define buffer buf_temp-dis-rule for temp-dis-rule.
     4740     define buffer buf_temp-clients  for temp-clients.
     4741     define buffer buf_dis-rule      for ub.dis-rule.
     4742     define buffer buf_clients       for ub.clients.
     4743     define buffer buf_host-clients  for ub.clients.
     4744     define buffer buf_temp-disc              for temp-disc .
     4745     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     4746     for each temp-dis-rule:
     4747         delete temp-dis-rule.
     4748     end.
     4749     for each temp-clients:
     4750         delete temp-clients.
     4751     end.
     4752   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4753   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4754     (input  parobj-type
     4755     ,input  parobj-code
     4756     ,output v-host-code
     4757     )  .
     4758   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4759   define variable v-param-type28 as character no-undo .
     4760   define variable v-value-date28 as date no-undo .
     4761   define variable v-value-decimal28 as decimal no-undo .
     4762   define variable v-value-integer28 as INTEGER no-undo .
     4763   define variable v-value-logical28 AS LOGICAL no-undo .
     4764   define variable v-tth28 as handle no-undo .
     4765   run adm/shattri.p (
     4766       input "get":U
     4767       ,input  parobj-type
     4768       ,input  parobj-code
     4769       ,input  'cd-sending':U
     4770       ,input  'dflt-cd':U
     4771       ,output v-cd-type
     4772       ,output v-value-date28
     4773       ,output v-value-decimal28
     4774       ,output v-value-integer28
     4775       ,output v-value-logical28
     4776       ,output v-param-type28
     4777       ,INPUT-OUTPUT table-handle v-tth28
     4778       )  .
     4779   delete object v-tth28 no-error.
     4780     _temp-disc:
     4781     for each buf_temp-disc no-lock :
     4782         if not buf_temp-disc.action = yes then do:
     4783             next _temp-disc .
     4784         end.
     4785         _temp-user-obj:
     4786         for each buf_userobjs_temp-user-obj no-lock :
     4787             if buf_userobjs_temp-user-obj.obj-type = parobj-type
     4788               and buf_userobjs_temp-user-obj.obj-code = parobj-code then do:
     4789                   next _temp-user-obj.
     4790             end.
     4791   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4792   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4793     (input  buf_userobjs_temp-user-obj.obj-type
     4794     ,input  buf_userobjs_temp-user-obj.obj-code
     4795     ,output v-cli-host-code
     4796     )  .
     4797             find first buf_temp-dis-rule no-lock
     4798             where buf_temp-dis-rule.rule-num = buf_temp-disc.rule-num no-error.
     4799             if not avail buf_temp-dis-rule then do:
     4800                     find first buf_dis-rule no-lock
     4801                 where buf_dis-rule.rule-num = buf_temp-disc.rule-num no-error.
     4802                 if avail buf_dis-rule and
     4803                    not buf_dis-rule.host-code = 0 and
     4804                    ( not buf_dis-rule.obj-code = 0 or not buf_dis-rule.host-code = v-cli-host-code )
     4805                 then do:
     4806                 create buf_temp-dis-rule.
     4807                 buffer-copy buf_dis-rule to buf_temp-dis-rule.
     4808             end.
     4809                 else do:
     4810                     next _temp-disc.
     4811                 end.
     4812             end.
     4813             if not buf_temp-dis-rule.host-code = 0 and not buf_temp-dis-rule.obj-code = 0 then do:
     4814                 assign
     4815                   v-cli-obj-type = buf_userobjs_temp-user-obj.obj-type
     4816                   v-cli-obj-code = buf_userobjs_temp-user-obj.obj-code
     4817                 .
     4818             end.
     4819             else if not buf_temp-dis-rule.host-code = v-cli-host-code and not buf_temp-dis-rule.host-code = 0 then do:
     4820                 assign
     4821                   v-cli-obj-type = 'орг':U
     4822                   v-cli-obj-code = v-cli-host-code
     4823                 .
     4824             end.
     4825             find first buf_temp-clients no-lock
     4826             where buf_temp-clients.obj-type = v-cli-obj-type
     4827               and buf_temp-clients.obj-code = v-cli-obj-code no-error.
     4828             if not avail buf_temp-clients then do:
     4829                 find first buf_clients no-lock
     4830                 where buf_clients.obj-type = v-cli-obj-type
     4831                   and buf_clients.obj-code = v-cli-obj-code no-error.
     4832                 if avail buf_clients then do:
     4833                     create buf_temp-clients.
     4834                     buffer-copy buf_clients to buf_temp-clients.
     4835                 end.
     4836             end.
     4837         end.
     4838     end.
     4839     FIND FIRST buf_temp-dis-rule NO-ERROR.
     4840     IF NOT AVAILABLE buf_temp-dis-rule THEN DO:
     4841        RETURN.
     4842     END.
     4843     FIND FIRST buf_temp-clients NO-ERROR.
     4844     IF NOT AVAILABLE buf_temp-clients THEN DO:
     4845        RETURN.
     4846     END.
     4847     ASSIGN
     4848     v-parameter = STRING(t-dis-gds-rule) + chr(4) + v-cd-type
     4849     .
     4850     run str/diallog.w ( input parparentproc
     4851               , input this-procedure
     4852               , input ('proc-copy':U + chr(4) +
     4853                        "1" + chr(4) +
     4854                        "0" + chr(4) +
     4855                        "1" + chr(4) +
     4856                        "1" + chr(4) +
     4857                        "yes")
     4858               , input v-parameter
     4859               , input v-auto-go
     4860               , input 'Прервать'
     4861               , input 'Копирование скидок') no-error .
     4862     if error-status:error then do:
     4863         return error .
     4864     end .
     4865   END PROCEDURE .
     4866   PROCEDURE proc-b-obj :
     4867   define variable v-user-select as logical   no-undo .
     4868   define variable v-obj-type    as character no-undo .
     4869   define variable v-obj-code    as integer   no-undo .
     4870   define variable v-host-code as integer   no-undo .
     4871   define buffer buf_clients-obj for ub.clients.
     4872   define buffer buf_temp-disc for temp-disc.
     4873   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4874   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4875     (input  parobj-type
     4876     ,input  parobj-code
     4877     ,output v-host-code
     4878     )  .
     4879   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4880   run userobjs_select-many in this-procedure
     4881     (input  parparentproc
     4882     ,input  v-cntxt-db-num
     4883     ,input  v-cntxt-userid
     4884     ,input  v-host-code
     4885     ,input  parobj-type
     4886     ,input  parobj-code
     4887     ,output v-user-select
     4888     )  .
     4889   define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
     4890   find first buf_userobjs_temp-user-obj no-lock no-error.
     4891   if not avail buf_userobjs_temp-user-obj
     4892   then do:
     4893     message
     4894     "Объект не выбран"
     4895     view-as alert-box information .
     4896     undo, return error return-value .
     4897   end.
     4898   OPEN QUERY BR-add FOR EACH temp-disc where temp-disc.action = yes NO-LOCK.    OPEN QUERY BR-del FOR EACH del_temp-disc where del_temp-disc.action = no NO-LOCK.
     4899   END PROCEDURE.
     4900   PROCEDURE proc-title :
     4901   IF parobj-type = 'маг':U THEN DO:
     4902   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4903   define variable v-param-type32 as character no-undo .
     4904   define variable v-value-date32 as date no-undo .
     4905   define variable v-value-decimal32 as decimal no-undo .
     4906   define variable v-value-integer32 as INTEGER no-undo .
     4907   define variable v-value-logical32 AS LOGICAL no-undo .
     4908   define variable v-tth32 as handle no-undo .
     4909   run adm/shattri.p (
     4910       input "get":U
     4911       ,input  parobj-type
     4912       ,input  parobj-code
     4913       ,input  'cd-sending':U
     4914       ,input  'dflt-cd':U
     4915       ,output dflt-cd
     4916       ,output v-value-date32
     4917       ,output v-value-decimal32
     4918       ,output v-value-integer32
     4919       ,output v-value-logical32
     4920       ,output v-param-type32
     4921       ,INPUT-OUTPUT table-handle v-tth32
     4922       )  .
     4923   delete object v-tth32 no-error.
     4924   END.
     4925   if parobj-type = 'скл':U then do:
     4926     dflt-cd = '-':U.
     4927   end.
     4928   ASSIGN
     4929   MENU-ITEM m_pos-type:LABEL IN MENU menu-b-add  = dflt-cd
     4930   MENU-ITEM m_pos-type:sensitive IN MENU menu-b-add  = ((dflt-cd <> '':U) and (dflt-cd <> '-':U))
     4931   MENU-ITEM m_pos-type-2:LABEL IN MENU menu-b-add-2  = dflt-cd
     4932   MENU-ITEM m_pos-type-2:sensitive IN MENU menu-b-add-2  = ((dflt-cd <> '':U) and (dflt-cd <> '-':U))
     4933   .
     4934   CASE par-subject:
     4935     WHEN 'dis-gds-rule':U THEN DO:
     4936       frame Dialog-Frame:title = substitute("Изменение скидок на товар (бар-код), действующих на объекте &1&2 по списку товаров"
     4937                                             ,parobj-type
     4938                                             ,parobj-code) .
     4939       assign
     4940       v-tab-order = "b-exit,b-quit,rs-list,b-list,b-list-2,b-help,rs-obj-type,b-obj,T-delete-ok,b-add,b-add-2" .
     4941     END.
     4942   END CASE.
     4943   APPLY "ENTRY" TO b-add IN FRAME Dialog-Frame.
     4944   END PROCEDURE.
     4945   PROCEDURE proc-write :
     4946   END PROCEDURE.
     4947   PROCEDURE set-region :
     4948   DEFINE PARAMETER BUFFER buf_dis-cfg-rule FOR ub.dis-cfg-rule.
     4949   DEFINE OUTPUT PARAMETER v-host-code AS integer NO-UNDO.
     4950   DEFINE OUTPUT PARAMETER v-obj-type AS CHARACTER NO-UNDO.
     4951   DEFINE OUTPUT PARAMETER v-obj-code AS integer NO-UNDO.
     4952   define variable v-sel-vals as character no-undo .
     4953   define variable v-sel-labels as character no-undo .
     4954   define variable var-region as character no-undo .
     4955     if (buf_dis-cfg-rule.has-global +
     4956         buf_dis-cfg-rule.has-host +
     4957         buf_dis-cfg-rule.has-obj) > 1 then do:
     4958       assign
     4959       v-sel-vals = v-sel-vals +
     4960                     (if buf_dis-cfg-rule.has-global = 1
     4961                     then (fill(chr(32), 3)  + string(0) + chr(44))
     4962                     else "":U)
     4963       v-sel-labels = v-sel-labels +
     4964                     (if buf_dis-cfg-rule.has-global  = 1
     4965                     then ("Глобально" + chr(44))
     4966                     else "":U)
     4967       .
     4968       assign
     4969       v-sel-vals = v-sel-vals +
     4970                     (if buf_dis-cfg-rule.has-host = 1
     4971                     then ('орг':U  + string(v-cntxt-host-code-obj)  + chr(44))
     4972                     else "":U)
     4973       v-sel-labels = v-sel-labels +
     4974                     (if buf_dis-cfg-rule.has-host = 1
     4975                     then ("Фирма"  + string(v-cntxt-host-code-obj) + chr(44))
     4976                     else "":U)
     4977       .
     4978       assign
     4979       v-sel-vals = v-sel-vals +
     4980                     (if buf_dis-cfg-rule.has-obj = 1
     4981                     then (v-cntxt-obj-type  + string(v-cntxt-obj-code)  + chr(44))
     4982                     else "":U)
     4983       v-sel-labels = v-sel-labels +
     4984                     (if buf_dis-cfg-rule.has-obj = 1
     4985                     then (v-cntxt-obj-type  + string(v-cntxt-obj-code)  + chr(44))
     4986                     else "":U)
     4987       .
     4988       run gbl/d-list.w (
     4989                           input "b-sel":U
     4990                           ,input "Выберите область действия"
     4991                           ,input v-sel-vals
     4992                           ,input v-sel-labels
     4993                           ,input chr(44)
     4994                           ,input "":U
     4995                           ,output var-region) no-error.
     4996       if error-status:error then do:
     4997         return error.
     4998       end.
     4999       assign
     5000       v-obj-type = substring(var-region, 1, 3)
     5001       v-obj-code = integer(substring(var-region, 4))
     5002       v-host-code = (IF v-obj-type = "" THEN 0 ELSE v-obj-code)
     5003       v-obj-code = (IF v-obj-type = 'маг':U
     5004                      OR v-obj-type = 'скл':U
     5005                      THEN parobj-code
     5006                      ELSE 0)
     5007       v-obj-type = (IF v-obj-type = 'маг':U
     5008                      OR v-obj-type = 'скл':U
     5009                      THEN parobj-type
     5010                      ELSE '':U)
     5011       .
     5012     end.
     5013     else do:
     5014       if buf_dis-cfg-rule.has-obj = 1 then do:
     5015         assign
     5016         v-obj-type = parobj-type
     5017         v-obj-code = parobj-code
     5018         .
     5019   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5020   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     5021     (input  parobj-type
     5022     ,input  parobj-code
     5023     ,output v-host-code
     5024     )  .
     5025       end.
     5026       if buf_dis-cfg-rule.has-host = 1 then do:
     5027   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5028   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     5029     (input  parobj-type
     5030     ,input  parobj-code
     5031     ,output v-host-code
     5032     )  .
     5033         assign
     5034         v-obj-type = "":U
     5035         v-obj-code = 0
     5036         .
     5037       end.
     5038       if buf_dis-cfg-rule.has-glob = 1 then do:
     5039         assign
     5040         v-host-code = 0
     5041         v-obj-type = '':U
     5042         v-obj-code = 0
     5043         .
     5044       end.
     5045     end.
     5046   END PROCEDURE.
     5047   FUNCTION dis-gds-rule-name RETURNS CHARACTER
     5048     ( INPUT p-discnt-role AS character ) :
     5049   DEFINE variable v-dis-gds-rule-name AS CHARACTER NO-UNDO.
     5050   v-dis-gds-rule-name = entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u).
     5051   RETURN v-dis-gds-rule-name.
     5052   END FUNCTION.
     5053   PROCEDURE proc-copy :
     5054   define input parameter parparentproc    as widget-handle    no-undo.
     5055   define input parameter p-parent-handle  as widget-handle no-undo .
     5056   define input parameter p-log-handle     as handle no-undo .
     5057   define input parameter p-parameter      as character        no-undo.
     5058   DEFINE VARIABLE V-DIS-GDS-RULE   AS LOGICAL   NO-UNDO.
     5059   define variable v-cd-type        as character no-undo .
     5060   define variable LOG-FILE-NAME    as character no-undo .
     5061   define variable v-dr-ii          as integer   no-undo .
     5062   define variable v-dr-ii-ok       as integer   no-undo .
     5063   define variable v-dgr-ii         as integer   no-undo .
     5064   define variable v-dgr-ii-ok      as integer   no-undo .
     5065   define variable v-loc-dgr-ii     as integer   no-undo .
     5066   define variable v-loc-dgr-ii-ok  as integer   no-undo .
     5067   define variable v-rule-num-count as integer   no-undo .
     5068   define variable v-rule-num       as integer   no-undo .
     5069   define variable v-upper-rule-num as integer   no-undo .
     5070   define variable v-err-cnt        as integer   no-undo init 0 .
     5071   define variable v-recid as recid     no-undo .
     5072   define variable glog    as logical   no-undo .
     5073   define variable dflt-cd as character no-undo .
     5074   define variable v-add-upd as logical no-undo .
     5075   define variable v-do-it   as logical no-undo init yes .
     5076   define buffer buf_temp-dis-rule for temp-dis-rule .
     5077   define buffer buf_temp-clients  for temp-clients .
     5078   define buffer term_dis-rule     for ub.dis-rule .
     5079   define buffer trg_dis-rule      for ub.dis-rule .
     5080   define buffer src_dis-rule      for ub.dis-rule .
     5081   define buffer src_dis-gds-rule  for ub.dis-gds-rule .
     5082   define buffer buf_dis-cfg-rule  for ub.dis-cfg-rule .
     5083   define buffer buf_dis-rule      for ub.dis-rule .
     5084   define buffer buf_tt0           for tt0-term_dis-rule .
     5085   define buffer src_dis-gds-rule-attr for ub.dis-gds-rule-attr .
     5086   define buffer trg_dis-gds-rule-attr for ub.dis-gds-rule-attr .
     5087   if num-entries(p-parameter, chr(4)) <> 2
     5088   then do:
     5089     MESSAGE substitute("Неверное количество ENTRY в составном параметре - &1, должно быть 2"
     5090                                , num-entries(p-parameter, chr(4)))
     5091     VIEW-AS ALERT-BOX ERROR
     5092     .
     5093     RETURN error.
     5094   end.
     5095   ASSIGN
     5096   V-DIS-GDS-RULE = LOGICAL(ENTRY(1, P-PARAMETER, chr(4) ))
     5097   v-cd-type = entry(2, p-parameter, chr(4) )
     5098   .
     5099   LOG-file-name = substitute("&1.txt", entry(1, this-procedure:file-name, ".")).
     5100   log-file-name = entry( num-entries(log-file-name, chr(47)), log-file-name, chr(47)).
     5101   for each tt0-term_dis-rule:
     5102     delete tt0-term_dis-rule.
     5103   end.
     5104   for each tt-dis-rule:
     5105     delete tt-dis-rule.
     5106   end.
     5107   create tt0-term_dis-rule.
     5108   _temp-dis-rule:
     5109   for each buf_temp-dis-rule:
     5110     if buf_temp-dis-rule.sts <> integer('0':U) then do:
     5111                  run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Нельзя копировать правило в статусе &1", entry (lookup (string(buf_temp-dis-rule.sts), '0,1,2,99,98':U), 'исп,не-исп,детализ,удаление,запр.удал':U))                                       ).
     5112        assign
     5113          v-dr-ii = v-dr-ii + 1
     5114          v-err-cnt = v-err-cnt + 1 .
     5115     end.
     5116     run disrules-fill-properties in this-procedure ( input buf_temp-dis-rule.templ-rl-root).
     5117     FIND FIRST buf_dis-cfg-rule NO-LOCK where
     5118               buf_dis-cfg-rule.table-name = 'dis-gds-rule':U
     5119           and buf_dis-cfg-rule.templ-rl-root = buf_temp-dis-rule.templ-rl-root
     5120           and buf_dis-cfg-rule.time-templ-rl-root = buf_temp-dis-rule.time-templ-rl-root
     5121           and buf_dis-cfg-rule.pos-type = v-cd-type
     5122           no-error
     5123            .
     5124     _temp-clients:
     5125     for each buf_temp-clients :
     5126       if not (v-cd-type = 'bo':U or v-cd-type = '-':U) and
     5127          not buf_temp-clients.obj-type = 'орг':U
     5128       then do:
     5129         if buf_temp-clients.obj-type = 'скл':U then do:
     5130                   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Нельзя скопировать правила скидки на объект &1&2"                                      , buf_temp-clients.obj-type                                     , buf_temp-clients.obj-code                                     )                                       ).
     5131           assign
     5132             v-dr-ii = v-dr-ii + 1
     5133             v-err-cnt = v-err-cnt + 1 .
     5134           next _temp-clients.
     5135         end.
     5136         dflt-cd = ''.
     5137   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5138   define variable v-param-type35 as character no-undo .
     5139   define variable v-value-date35 as date no-undo .
     5140   define variable v-value-decimal35 as decimal no-undo .
     5141   define variable v-value-integer35 as INTEGER no-undo .
     5142   define variable v-value-logical35 AS LOGICAL no-undo .
     5143   define variable v-tth35 as handle no-undo .
     5144   run adm/shattri.p (
     5145       input "get":U
     5146       ,input  buf_temp-clients.obj-type
     5147       ,input  buf_temp-clients.obj-code
     5148       ,input  'cd-sending':U
     5149       ,input  'dflt-cd':U
     5150       ,output dflt-cd
     5151       ,output v-value-date35
     5152       ,output v-value-decimal35
     5153       ,output v-value-integer35
     5154       ,output v-value-logical35
     5155       ,output v-param-type35
     5156       ,INPUT-OUTPUT table-handle v-tth35
     5157       )  .
     5158   delete object v-tth35 no-error.
     5159         if dflt-cd <> v-cd-type then do:
     5160                   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Нельзя скопировать правила скидки на объект &1&2&3" +                                     "На нем работает POS типа &4"                                     , buf_temp-clients.obj-type                                     , buf_temp-clients.obj-code                                     , chr(10)                                     , dflt-cd)                                       ).
     5161           assign
     5162             v-dr-ii = v-dr-ii + 1
     5163             v-err-cnt = v-err-cnt + 1 .
     5164           next _temp-clients.
     5165         end.
     5166       end.
     5167       for each tt-dis-rule:
     5168         delete tt-dis-rule.
     5169       end.
     5170       create tt-dis-rule.
     5171       assign
     5172       tt-dis-rule.des = buf_temp-dis-rule.des
     5173       tt-dis-rule.host-code          = ( if buf_temp-clients.host-code = ? then buf_temp-clients.obj-code  else buf_temp-clients.host-code )
     5174       tt-dis-rule.obj-type           = ( if buf_temp-clients.host-code = ? then buf_temp-dis-rule.obj-type else buf_temp-clients.obj-type )
     5175       tt-dis-rule.obj-code           = ( if buf_temp-clients.host-code = ? then buf_temp-dis-rule.obj-code else buf_temp-clients.obj-code )
     5176       tt-dis-rule.discnt-type        = buf_temp-dis-rule.discnt-type
     5177       tt-dis-rule.discnt-value       = buf_temp-dis-rule.discnt-value
     5178       tt-dis-rule.time-rule-num      = buf_temp-dis-rule.time-rule-num
     5179       tt-dis-rule.time-templ-rl-root = buf_temp-dis-rule.time-templ-rl-root
     5180       tt-dis-rule.tot-sum            = buf_temp-dis-rule.tot-sum
     5181       tt-dis-rule.sts                = buf_temp-dis-rule.sts
     5182       tt-dis-rule.doc-qnty           = buf_temp-dis-rule.doc-qnty
     5183       .
     5184       v-add-upd = true .
     5185       buffer-copy buf_temp-dis-rule
     5186       except des
     5187       host-code
     5188       obj-type
     5189       obj-code
     5190       to tt-dis-rule .
     5191       for each tt0-term_dis-rule:
     5192           delete tt0-term_dis-rule .
     5193       end.
     5194       v-rule-num-count = 0 .
     5195       for each term_dis-rule no-lock
     5196       where term_dis-rule.upper-rule-num = buf_temp-dis-rule.rule-num :
     5197           v-rule-num-count = v-rule-num-count + 1.
     5198           create tt0-term_dis-rule.
     5199           buffer-copy term_dis-rule
     5200           except host-code obj-type obj-code
     5201           rule-num upper-rule-num rl-root
     5202           to tt0-term_dis-rule
     5203           assign
     5204           tt0-term_dis-rule.host-code      = buf_temp-clients.host-code
     5205           tt0-term_dis-rule.obj-type       = buf_temp-clients.obj-type
     5206           tt0-term_dis-rule.obj-code       = buf_temp-clients.obj-code
     5207           tt0-term_dis-rule.rule-num       = v-rule-num-count
     5208           tt0-term_dis-rule.upper-rule-num = (if v-add-upd then buf_temp-dis-rule.templ-rl-root else v-upper-rule-num)
     5209           tt0-term_dis-rule.rl-root        = buf_temp-dis-rule.templ-rl-root
     5210           .
     5211           release tt0-term_dis-rule.
     5212       end.
     5213       if not v-add-upd then do:
     5214         find first tt0-term_dis-rule no-lock no-error .
     5215         find first buf_dis-rule no-lock where
     5216                 buf_dis-rule.host-code      = tt0-term_dis-rule.host-code
     5217             and buf_dis-rule.obj-type       = tt0-term_dis-rule.obj-type
     5218             and buf_dis-rule.obj-code       = tt0-term_dis-rule.obj-code
     5219             and buf_dis-rule.templ-rl-root  = tt0-term_dis-rule.templ-rl-root
     5220             and buf_dis-rule.root           = false
     5221             and buf_dis-rule.upper-rule-num = tt0-term_dis-rule.upper-rule-num
     5222         no-error.
     5223         if avail buf_dis-rule then do:
     5224             assign
     5225               tt0-term_dis-rule.rule-num = buf_dis-rule.rule-num
     5226             .
     5227         end.
     5228         else do:
     5229            run gen-b-code in this-procedure ( input 'drgb':U, output v-rule-num) no-error .
     5230            if error-status:error then do:
     5231                               run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Не удалось скопировать правило скидки &1 (gen-b-code) на &2&3&4&5&4&6"                                             , buf_temp-dis-rule.rule-num                                             , buf_temp-clients.obj-type                                             , buf_temp-clients.obj-code                                              , chr(10)                                             , error-status:get-message(1)                                              , return-value )                                       ).
     5232                 assign
     5233                   v-dr-ii = v-dr-ii + 1
     5234                   v-err-cnt = v-err-cnt + 1 .
     5235                 next _temp-clients.
     5236            end.
     5237            find first buf_tt0 no-lock no-error.
     5238            if avail buf_tt0 then do:
     5239                create buf_dis-rule.
     5240                buffer-copy buf_tt0
     5241                except rule-num
     5242                to buf_dis-rule
     5243                assign
     5244                buf_dis-rule.rule-num = v-rule-num
     5245                buf_tt0.rule-num = v-rule-num
     5246                .
     5247            end.
     5248            else do:
     5249               v-do-it = false .
     5250            end.
     5251         end.
     5252       end.
     5253       find first buf_tt0 no-lock no-error.
     5254       if avail buf_tt0 and buf_tt0.time-templ-rl-root > 0 then do:
     5255         assign
     5256           tt-dis-rule.time-rule-num = buf_tt0.time-rule-num
     5257         .
     5258       end.
     5259       v-dr-ii = v-dr-ii + 1.
     5260       if v-do-it then do:
     5261           run ref/dis-rul1.p (
     5262           input (if v-add-upd then ? else v-upper-rule-num)
     5263           ,input v-cd-type
     5264           ,input buf_temp-dis-rule.templ-rl-root
     5265           ,input buf_temp-dis-rule.templ-rl-root
     5266           ,input buf_temp-dis-rule.des
     5267           ,input tt-dis-rule.dis-kat
     5268           ,input tt-dis-rule.discnt-type
     5269           ,input tt-dis-rule.doc-qnty
     5270           ,input tt-dis-rule.tot-sum
     5271           ,input tt-dis-rule.charkey_one
     5272           ,input tt-dis-rule.charkey_two
     5273           ,input tt-dis-rule.charkey_three
     5274           ,input tt-dis-rule.deckey_one
     5275           ,input tt-dis-rule.deckey_two
     5276           ,input tt-dis-rule.deckey_three
     5277           ,input tt-dis-rule.key#_one
     5278           ,input tt-dis-rule.key#_two
     5279           ,input tt-dis-rule.key#_three
     5280           ,input tt-dis-rule.subject-type
     5281           ,input tt-dis-rule.time-templ-rl-root
     5282           ,input (if tt-dis-rule.time-templ-rl-root = 0 then 0 else tt-dis-rule.time-rule-num)
     5283           ,input tt-dis-rule.upper-rule-num
     5284           ,input tt-dis-rule.value-type
     5285           ,input tt-dis-rule.host-code
     5286           ,INPUT tt-dis-rule.obj-type
     5287           ,INPUT tt-dis-rule.obj-code
     5288           ,INPUT tt-dis-rule.discnt-value
     5289           ,input table tt0-term_dis-rule
     5290           ,input-output v-recid
     5291           ,input (if v-add-upd then 'ДОБАВЛЕНИЕ':U else 'ИЗМЕНЕНИЕ':U)
     5292           ,input yes
     5293           ) NO-ERROR.
     5294           if error-status:error then do:
     5295                       run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Не удалось скопировать правило скидки &1 на &2&3&4&5&4&6"                                         , buf_temp-dis-rule.rule-num                                         , buf_temp-clients.obj-type                                         , buf_temp-clients.obj-code                                          , chr(10)                                         , error-status:get-message(1)                                          , return-value )                                       ).
     5296             assign
     5297               v-dr-ii = v-dr-ii + 1
     5298               v-err-cnt = v-err-cnt + 1
     5299             .
     5300             next _temp-clients.
     5301           end.
     5302       end.
     5303       assign
     5304         v-do-it = true
     5305         v-dr-ii-ok = v-dr-ii-ok + 1
     5306       .
     5307       if v-dis-gds-rule then do:
     5308           assign
     5309             v-loc-dgr-ii = 0
     5310             v-loc-dgr-ii-ok = 0
     5311           .
     5312           find first trg_dis-rule no-lock
     5313           where recid(trg_dis-rule) = v-recid no-error.
     5314           if available buf_dis-cfg-rule then do:
     5315               for each src_dis-gds-rule no-lock
     5316               where src_dis-gds-rule.obj-type = ( if buf_temp-clients.host-code = ? then 'орг':U                      else buf_temp-dis-rule.obj-type )
     5317                 and src_dis-gds-rule.obj-code = ( if buf_temp-clients.host-code = ? then buf_temp-dis-rule.host-code else buf_temp-dis-rule.obj-code )
     5318                 and src_dis-gds-rule.rule-num = buf_temp-dis-rule.rule-num
     5319                 and src_dis-gds-rule.pos-type = v-cd-type :
     5320                   assign
     5321                     v-dgr-ii = v-dgr-ii + 1
     5322                     v-loc-dgr-ii = v-loc-dgr-ii + 1
     5323                   .
     5324                   if buf_temp-clients.host-code = ? then do:
     5325                       run cmp-disgdsru-write in this-procedure (
     5326                                                            input src_dis-gds-rule.gds-code
     5327                                                           ,input 'орг':U
     5328                                                           ,input trg_dis-rule.host-code
     5329                                                           ,input v-cd-type
     5330                                                           ,input trg_dis-rule.templ-rl-root
     5331                                                           ,input src_dis-gds-rule.time-templ-rl-root
     5332                                                           ,input buf_dis-cfg-rule.discnt-role
     5333                                                           ,input trg_dis-rule.rule-num
     5334                                                           ,input src_dis-gds-rule.nonunique
     5335                                                          )  no-error.
     5336                   end.
     5337                   else do:
     5338                   run disgdsru-write in this-procedure ( input buf_temp-clients.obj-type
     5339                                                         ,input buf_temp-clients.obj-code
     5340                                                         ,input src_dis-gds-rule.gds-code
     5341                                                         ,input v-cd-type
     5342                                                         ,input buf_dis-cfg-rule.discnt-role
     5343                                                         ,input trg_dis-rule.templ-rl-root
     5344                                                         ,input src_dis-gds-rule.time-templ-rl-root
     5345                                                         ,input trg_dis-rule.rule-num
     5346                                                         ,input src_dis-gds-rule.nonunique
     5347                   )  no-error.
     5348                   end.
     5349                   if error-status :error then do:
     5350                       run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Не удалось привязать правило скидки &1 к товару с кодом &2 на &3&4&5&6&5&7"                         , trg_dis-rule.rule-num                         , src_dis-gds-rule.gds-code                         , buf_temp-clients.obj-type                         , buf_temp-clients.obj-code                          , chr(10)                         , error-status:get-message(1)                          , return-value )                                       ) .
     5351                       assign
     5352                         v-dr-ii = v-dr-ii + 1
     5353                         v-err-cnt = v-err-cnt + 1
     5354                       .
     5355                   end.
     5356                   else do:
     5357                       if buf_dis-cfg-rule.discnt-role = 'bonus-qnty' and
     5358                          buf_dis-cfg-rule.nonunique   = 'bar-code.b-code'
     5359                       then do:
     5360                           for each src_dis-gds-rule-attr no-lock
     5361                           where src_dis-gds-rule-attr.gds-code    = src_dis-gds-rule.gds-code
     5362                             and src_dis-gds-rule-attr.obj-type    = src_dis-gds-rule.obj-type
     5363                             and src_dis-gds-rule-attr.obj-code    = src_dis-gds-rule.obj-code
     5364                             and src_dis-gds-rule-attr.pos-type    = v-cd-type
     5365                             and src_dis-gds-rule-attr.discnt-role = buf_dis-cfg-rule.discnt-role
     5366                             and src_dis-gds-rule-attr.nonunique   = src_dis-gds-rule.nonunique
     5367                           :
     5368                               find first trg_dis-gds-rule-attr exclusive-lock
     5369                               where trg_dis-gds-rule-attr.gds-code    = src_dis-gds-rule.gds-code
     5370                                 and trg_dis-gds-rule-attr.obj-type    = ( if buf_temp-clients.host-code = ? then 'орг':U                 else buf_temp-clients.obj-type )
     5371                                 and trg_dis-gds-rule-attr.obj-code    = ( if buf_temp-clients.host-code = ? then trg_dis-rule.host-code else buf_temp-clients.obj-code )
     5372                                 and trg_dis-gds-rule-attr.pos-type    = v-cd-type
     5373                                 and trg_dis-gds-rule-attr.discnt-role = buf_dis-cfg-rule.discnt-role
     5374                                 and trg_dis-gds-rule-attr.nonunique   = src_dis-gds-rule.nonunique
     5375                                 and trg_dis-gds-rule-attr.attr-value  = src_dis-gds-rule-attr.attr-value
     5376                               no-error.
     5377                               if not avail trg_dis-gds-rule-attr then do:
     5378                                   create trg_dis-gds-rule-attr .
     5379                                   buffer-copy src_dis-gds-rule-attr
     5380                                   except obj-type obj-code
     5381                                   to trg_dis-gds-rule-attr
     5382                                   assign
     5383                                     trg_dis-gds-rule-attr.obj-type = ( if buf_temp-clients.host-code = ? then 'орг':U                 else buf_temp-clients.obj-type )
     5384                                     trg_dis-gds-rule-attr.obj-code = ( if buf_temp-clients.host-code = ? then trg_dis-rule.host-code else buf_temp-clients.obj-code )
     5385                                   .
     5386                               end.
     5387                           end.
     5388                       end.
     5389                       assign
     5390                         v-dgr-ii-ok = v-dgr-ii-ok + 1
     5391                         v-loc-dgr-ii-ok = v-loc-dgr-ii-ok + 1
     5392                       .
     5393                   end.
     5394               end.
     5395           end.
     5396       end.
     5397       if v-dis-gds-rule then do:
     5398               run write-counter in p-log-handle (input substitute("Пр. скидок: OK &1 из &2, привязки: OK &3 из &4", v-dr-ii-ok, v-dr-ii, v-dgr-ii-ok, v-dgr-ii)) .
     5399       end.
     5400       else do:
     5401               run write-counter in p-log-handle (input substitute("Пр. скидок: OK &1 из &2", v-dr-ii-ok, v-dr-ii)) .
     5402       end.
     5403     end.
     5404     if v-dis-gds-rule  then do:
     5405           run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("привязки Правила &1: OK &2 из &3", buf_temp-dis-rule.rule-num, v-loc-dgr-ii, v-loc-dgr-ii-ok)                                       ).
     5406     end.
     5407     end.
     5408   if v-dis-gds-rule then do:
     5409       run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Пр. скидок: OK &1 из &2, привязки: OK &3 из &4", v-dr-ii-ok, v-dr-ii, v-dgr-ii-ok, v-dgr-ii)                                       ).
     5410   end.
     5411   else do:
     5412       run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Пр. скидок: OK &1 из &2", v-dr-ii-ok, v-dr-ii)                                       ).
     5413   end.
     5414   run write-log-and-file in p-log-handle (           input 1         , input log-file-name         , input 1         , input substitute("Копирование закончено")                                       ).
     5415   run write-counter in p-log-handle (input substitute("Пр. скидок: OK &1 из &2", v-dr-ii-ok, v-dr-ii)).
     5416   if v-err-cnt > 0 then do:
     5417       return error.
     5418   end.
     5419   END PROCEDURE.
