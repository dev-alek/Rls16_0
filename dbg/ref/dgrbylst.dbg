     2829   procedure diasize_change-height :
     2830     define input  parameter p-change-value  as decimal   no-undo .
     2831     define input  parameter p-move-resize   as logical   no-undo .
     2832     define variable v-field-group-handle    as handle    no-undo .
     2833     define variable v-object-handle         as handle    no-undo .
