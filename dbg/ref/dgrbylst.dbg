     2814   define variable v-diasize-browse-number        as integer   no-undo .
     2815   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2816   define temp-table temp-diasize-handle no-undo
     2817     field handle-value  as handle
     2818     field save-position as decimal
     2819     index xpk is primary unique handle-value
     2820     .
     2821   define temp-table temp-browse-handle no-undo
     2822     field browse-type   as character
     2823     field browse-number as integer
     2824     field browse-handle as handle
