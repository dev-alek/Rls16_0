      740   procedure userobjs_transfer :
      741     define input  parameter p-callback-handle as handle no-undo .
      742     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      743     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      744     do
      745     on error undo, return error return-value
      746     :
      747       if valid-handle(p-callback-handle) <> true
      748       then do:
      749         message
      750           vss-workfile vss-revision vss-description skip
      751           "Ошибка задания входных параметров" skip
      752           "Неизвестный указатель на процедуру" skip
      753           view-as alert-box error .
      754         undo, return error return-value .
      755       end.
      756       if p-callback-handle :get-signature("userobjs_append") = ""
      757       then do:
      758         message
      759           vss-workfile vss-revision vss-description skip
      760           "Ошибка задания входных параметров" skip
      761           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      762                     ,p-callback-handle :file-name
      763                     ) skip
      764           view-as alert-box error .
      765         undo, return error return-value .
      766       end.
      767       for each buf_userobjs_temp-user-obj
      768       on error undo, return error return-value
      769       :
      770         run userobjs_append in p-callback-handle
      771           (input  buf_userobjs_temp-user-obj.obj-type
      772           ,input  buf_userobjs_temp-user-obj.obj-code
      773           ) .
      774       end.
      775     end.
      776   end procedure.
