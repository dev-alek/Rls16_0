      217   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      218   FUNCTION CIntBinS RETURNS CHARACTER(input vl_int as integer):
      219   def var vl_bin as char no-undo init "".
      220   if vl_int < 0 OR vl_int = ? then return ?.
      221   do while vl_int > 0:
      222     assign
      223     vl_bin = (if vl_int modulo 2 = 0
      224                 then "0":U
      225                 else "1":U) + vl_bin
      226     vl_int = truncate(vl_int / 2,0).
      227   end.
      228   return fill( "0":U, 32 - length(vl_bin)) + vl_bin .
      229   END FUNCTION.
      230   FUNCTION BinMask RETURNS LOGICAL(input vl_int as integer,
      231                                    input vl_binm as character):
      232   DEFINE VARIABLE vl_bin as character no-undo.
      233   DEFINE VARIABLE ii as integer no-undo.
      234   DEFINE VARIABLE ii-len as integer no-undo.
      235   DEFINE VARIABLE ii-lenm as integer no-undo.
      236   DEFINE VARIABLE mchar as character no-undo.
      237   DEFINE VARIABLE ichar as character no-undo.
      238   if vl_binm = ? then return ?.
      239   vl_bin = CIntBinS(vl_int).
      240   if vl_bin = ? then return ?.
      241   assign
      242   vl_binm = LEFT-TRIM(vl_binm, "X":U)
      243   ii-lenm = LENGTH(vl_binm)
      244   ii-len = LENGTH(vl_bin) - ii-lenm
      245   .
      246   if II-LENM > 32 THEN RETURN ?.
      247   DO II = 1 to II-LENm:
      248     assign
      249     mchar = SUBSTR(vl_binm, ii, 1)
      250     ichar = SUBSTR(vl_bin, ii + ii-len, 1)
      251     .
      252     IF not (MCHAR = "0":u or MCHAR = "1":u or MCHAR = "X":u) then return ?.
      253     IF ichar <> mchar AND mchar <> "X":U then return no.
      254   END.
      255   return yes.
      256   END FUNCTION.
      257   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      258   define NEW SHARED temp-table temp-disc no-undo
      259   field rule-num as integer
      260   field host-code as integer
      261   field obj-type as character
      262   field obj-code as integer
      263   field templ-rl-root as integer
      264   field time-templ-rl-root as integer
      265   field discnt-role as character
      266   field nonunique as character
      267   field cfg-nonunique as character
      268   field pos-type as character
      269   field action as logical
      270   field label_ as character
      271   index pi is  unique primary
      272   pos-type discnt-role nonunique host-code obj-type obj-code action ASCENDING
      273   index action
      274   action
      275   index ipos
      276   pos-type discnt-role
      277   .
      278   procedure temp-dsc-value :
      279   define input  parameter p-pos-type  as character  no-undo .
      280   define input  parameter p-templ-rl-root as integer  no-undo .
      281   define input  parameter p-time-templ-rl-root as integer no-undo .
      282   define input  parameter p-discnt-role  as character  no-undo .
      283   define input  parameter p-cfg-nonunique as character no-undo .
      284   define input  parameter p-host-code as integer no-undo .
      285   define input  parameter p-obj-type  as character no-undo .
      286   define input  parameter p-obj-code as integer no-undo .
      287   define input  parameter p-0mode as character no-undo .
      288   define input  parameter p-mode      as character no-undo .
      289   define input  parameter p-rec as recid no-undo .
      290   define output parameter p-rule-num    as integer no-undo .
      291   define output parameter p-nonunique   as character no-undo .
      292   define buffer buf_temp-disc for temp-disc .
      293   define variable v-discnt-role as character no-undo .
      294   define variable v-rule-num as integer no-undo .
      295   define variable v-nonunique as character no-undo .
      296   define variable v-templ-rl-root as integer no-undo .
      297   define variable v-time-templ-rl-root as integer no-undo .
      298   define variable v-setted         as logical   no-undo .
      299   define variable choice as integer no-undo .
      300   do
      301   on error undo, return error
      302   :
      303     case 'dis-gds-rule':U:
      304       when 'dis-gds-rule':U
      305       then do:
      306         run discfgru-check  in this-procedure (
      307                                                  input 'dis-gds-rule':U
      308                                                 ,input p-templ-rl-root
      309                                                 ,input p-time-templ-rl-root
      310                                                 ,input p-pos-type
      311                                                 ,output v-discnt-role) no-error.
      312       end.
      313       when 'dis-dc-rule':U then do:
      314         run discfgru-check  in this-procedure (
      315                                                  input 'dis-dc-rule':U
      316                                                 ,input p-templ-rl-root
      317                                                 ,input p-time-templ-rl-root
      318                                                 ,input p-pos-type
      319                                                 ,output v-discnt-role) no-error.
      320       end.
      321       when 'dis-cp-rule':U then do:
      322         run discfgru-check  in this-procedure (
      323                                                  input 'dis-cp-rule':U
      324                                                 ,input p-templ-rl-root
      325                                                 ,input p-time-templ-rl-root
      326                                                 ,input p-pos-type
      327                                                 ,output v-discnt-role) no-error.
      328       end.
      329       otherwise do:
      330         undo, return error .
      331       end.
      332     end case.
      333     if error-status :error
      334     then do:
      335       undo, return error return-value .
      336     end.
      337     if p-mode = "change":U
      338     then do:
      339       if p-rec <> ? then do:
      340         find first buf_temp-disc no-lock where
      341               recid(buf_temp-disc) = p-rec
      342           no-error .
      343       end.
      344       else do:
      345         find first buf_temp-disc no-lock where
      346                   buf_temp-disc.pos-type = p-pos-type
      347               and buf_temp-disc.discnt-role = p-discnt-role
      348               and buf_temp-disc.nonunique  = p-nonunique
      349               and buf_temp-disc.host-code = p-host-code
      350               and buf_temp-disc.obj-type = p-obj-type
      351               and buf_temp-disc.obj-code = p-obj-code
      352           no-error .
      353       end.
      354       if avail buf_temp-disc then do:
      355         assign
      356         v-rule-num =  buf_temp-disc.rule-num
      357         v-nonunique = buf_temp-disc.nonunique
      358         v-templ-rl-root = buf_temp-disc.templ-rl-root
      359         v-time-templ-rl-root = buf_temp-disc.time-templ-rl-root
      360         .
      361       end.
      362     end.
      363     CASE 'dis-gds-rule':U:
      364       when 'dis-gds-rule':U then do:
      365         if p-0mode = 'удаление':U then do:
      366         run gbl/d-askw.w (   input "Вопрос"
      367                             ,input "Вы хотите удалить скидки на товарах"
      368                             ,input "|"
      369                             ,input "Конкретная|Все ТАКИЕ|Отмена"
      370                             ,input "по одному КОНКРЕТНОМУ правилу|СКИДКИ НА ТОВАР ЭТОГО ТИПА ПО ЭТОМУ ШАБЛОНУ И ТИПУ РАСПИСАНИЯ|Ничего не делать"
      371                             ,input 1
      372                             ,input 3
      373                             ,output choice).
      374       end.
      375       else do:
      376         choice = 1.
      377       end.
      378       if choice = 3
      379       then do:
      380         undo, return "not-set".
      381       end.
      382       if choice = 2 then do:
      383          v-rule-num = ?.
      384          v-setted = yes.
      385        end.
      386        else do:
      387         run disgdsru-edit in this-procedure (
      388                                      input 'ИЗМЕНЕНИЕ':U
      389                                     ,input 0
      390                                     ,input p-obj-type
      391                                     ,input p-obj-code
      392                                     ,INPUT p-pos-type
      393                                     ,input p-discnt-role
      394                                     ,input p-templ-rl-root
      395                                     ,input p-time-templ-rl-root
      396                                     ,input p-cfg-nonunique
      397                                     ,input 1
      398                                     ,input-output v-rule-num
      399                                     ,input-output v-nonunique
      400                                     ,output v-setted ) no-error.
      401         if error-status :error then do:
      402           undo, return error substitute("Ошибка при получения значения скидки товара на объекте:&1" +
      403                                         "место использ. &2 тип скидки &3"
      404                                         , chr(10)
      405                                         , p-pos-type
      406                                         , entry (lookup (p-discnt-role, 'std-disc,abs-disc,pcnt-tot,temp-disc,pcnt-kat,pcnt-qnty,pcnt-date,without-disc,without-gds-disc,dis-tot-flag,max-disc,bonus-qnty':u) + 1, ',' + 'Стандартная скидка,Абсолютная скидка,% скидка c суммы,Временная скидка,Категорийная скидка,Количественная скидка,Скидка по дате,Запрет на участие в бонусных программах\участие в скидке на итог,Запрет скидки на товар,Участие в итогах по ДК,Порог max скидки на товар,Начисление бонусов на кол-во товара':u)).
      407         end.
      408       end.
      409       end.
      410     END CASE.
      411     if v-setted = no then do:
      412       return "not-set":U.
      413     end.
      414     p-rule-num = v-rule-num.
      415     p-nonunique = v-nonunique.
      416   end.
      417   end procedure.
      418   procedure temp-dsc-write :
      419     do
      420     on error undo, return error
      421     :
      422       define input parameter p-add      as logical no-undo .
      423       define input parameter p-pos-type as character  no-undo .
      424       define input parameter p-templ-rl-root as integer  no-undo .
      425       define input parameter p-time-templ-rl-root as integer  no-undo .
      426       define input parameter p-discnt-role as character  no-undo .
      427       define input parameter p-cfg-nonunique as character no-undo .
      428       define input parameter p-host-code as integer no-undo .
      429       define input parameter p-obj-type as character no-undo .
      430       define input parameter p-obj-code as integer no-undo .
      431       define input parameter p-rule-num  as integer no-undo .
      432       define input parameter p-action   like temp-disc.action no-undo .
      433       define input-output parameter p-rec as recid no-undo .
      434       define buffer buf_temp-disc for temp-disc .
      435       define variable v-discnt-role as character no-undo .
      436       define variable varhost-code like ub.clients.host-code no-undo.
      437       define variable varobj-type like ub.clients.obj-type no-undo.
      438       define variable varobj-code like ub.clients.obj-code no-undo.
      439       define variable choice as integer no-undo .
      440       define var loc#log as logical no-undo.
      441       define variable loc-action as logical no-undo.
      442       define variable v-nonunique as character no-undo .
      443       define buffer buf_dis-rule for ub.dis-rule.
      444       case 'dis-gds-rule':U:
      445         when 'dis-gds-rule':U
      446         then do:
      447           run discfgru-check  in this-procedure (
      448                                                   input 'dis-gds-rule':U
      449                                                  ,input p-templ-rl-root
      450                                                  ,input p-time-templ-rl-root
      451                                                  ,input p-pos-type
      452                                                  ,output v-discnt-role) no-error.
      453         end.
      454         when 'dis-dc-rule':U
      455         then do:
      456           run discfgru-check  in this-procedure (
      457                                                   input 'dis-dc-rule':U
      458                                                  ,input p-templ-rl-root
      459                                                  ,input p-time-templ-rl-root
      460                                                  ,input p-pos-type
      461                                                  ,output v-discnt-role) no-error.
      462         end.
      463         when 'dis-cp-rule':U
      464         then do:
      465           run discfgru-check  in this-procedure (
      466                                                   input 'dis-cp-rule':U
      467                                                  ,input p-templ-rl-root
      468                                                  ,input p-time-templ-rl-root
      469                                                  ,input p-pos-type
      470                                                  ,output v-discnt-role) no-error.
      471         end.
      472         otherwise do:
      473           undo, return error .
      474         end.
      475       END CASE.
      476       if error-status :error then do:
      477         undo, return error return-value .
      478       end.
      479       if p-cfg-nonunique <> '':U
      480       and p-rule-num <> 0
      481       and p-rule-num <> ?
      482       then do:
      483         find first buf_dis-rule no-lock where
      484                 buf_dis-rule.rule-num = p-rule-num no-error.
      485         if not available buf_dis-rule then do:
      486           undo, return error substitute("Не найдено правило скидок &1", p-rule-num).
      487         end.
      488         assign
      489         v-nonunique = (if p-cfg-nonunique = '':U
      490                       then '':U
      491                       else (if p-cfg-nonunique begins "@"
      492                             then left-trim(p-cfg-nonunique, "@")
      493                             else string(buffer buf_Dis-rule:handle:buffer-field(p-cfg-nonunique):buffer-value)
      494                             ))
      495         .
      496       end.
      497       if p-rec <> ? then do:
      498         find first buf_temp-disc exclusive-lock where
      499                   recid(buf_temp-disc) = p-rec no-error .
      500       end.
      501       else do:
      502         find first buf_temp-disc exclusive-lock where
      503                   buf_temp-disc.pos-type = p-pos-type
      504                 and buf_temp-disc.discnt-role = p-discnt-role
      505                 and buf_temp-disc.host-code = p-host-code
      506                 and buf_temp-disc.obj-type = p-obj-type
      507                 and buf_temp-disc.obj-code = p-obj-code
      508                 and buf_temp-disc.nonunique = v-nonunique
      509                 no-error .
      510       end.
      511       if not available buf_temp-disc then do:
      512         create buf_temp-disc .
      513         assign
      514         buf_temp-disc.host-code = p-host-code
      515         buf_temp-disc.obj-type = p-obj-type
      516         buf_temp-disc.obj-code = p-obj-code
      517         buf_temp-disc.rule-num = p-rule-num
      518         buf_temp-disc.action = p-action
      519         buf_temp-disc.pos-type = p-pos-type
      520         buf_temp-disc.discnt-role = p-discnt-role
      521         buf_temp-disc.cfg-nonunique = p-cfg-nonunique
      522         buf_temp-disc.rule-num = p-rule-num
      523         buf_temp-disc.nonunique = v-nonunique
      524         buf_temp-disc.time-templ-rl-root = p-time-templ-rl-root
      525         buf_temp-disc.templ-rl-root = p-templ-rl-root
      526         p-rec = recid(buf_temp-disc)
      527         no-error
      528         .
      529       end.
      530       ELSE do:
      531         if p-add then do:
      532            message
      533            substitute("Такая скидка уже добавлена&1"
      534                       ,chr(10)
      535                   )
      536            view-as alert-box error .
      537           undo, return error "not-set" .
      538         end.
      539         ASSIGN
      540         buf_temp-disc.rule-num = p-rule-num
      541         buf_temp-disc.nonunique = v-nonunique
      542         buf_temp-disc.time-templ-rl-root = p-time-templ-rl-root
      543         buf_temp-disc.templ-rl-root = p-templ-rl-root
      544         p-rec = recid(buf_temp-disc)
      545         no-error.
      546       end.
      547     end.
      548   end procedure.
      549   procedure temp-dsc-exist :
      550   define input parameter p-pos-type as character  no-undo .
      551   define input parameter p-templ-rl-root as integer  no-undo .
      552   define input parameter p-time-templ-rl-root as integer no-undo .
      553   define input parameter p-discnt-role as character  no-undo .
      554   define input parameter p-nonunique as character no-undo .
      555   define input parameter p-host-code as integer no-undo .
      556   define input parameter p-obj-type as character no-undo .
      557   define input parameter p-obj-code as integer no-undo .
      558   define output parameter p-exist    as logical no-undo .
      559   define output parameter p-action as logical no-undo .
      560   define variable v-discnt-role as character no-undo .
      561   define buffer buf_temp-disc for temp-disc .
      562     do
      563     on error undo, return error
      564     :
      565       case 'dis-gds-rule':U:
      566         when 'dis-gds-rule':U then do:
      567           run discfgru-check  in this-procedure (
      568                                                   input 'dis-gds-rule':U
      569                                                  ,input p-templ-rl-root
      570                                                  ,input p-time-templ-rl-root
      571                                                  ,input p-pos-type
      572                                                  ,output v-discnt-role) no-error.
      573         end.
      574         when 'dis-dc-rule':U then do:
      575           run discfgru-check  in this-procedure (
      576                                                   input 'dis-dc-rule':U
      577                                                  ,input p-templ-rl-root
      578                                                  ,input p-time-templ-rl-root
      579                                                  ,input p-pos-type
      580                                                  ,output v-discnt-role) no-error.
      581         end.
      582         otherwise do:
      583           undo, return error .
      584         end.
      585       end case.
      586       if error-status :error
      587       then do:
      588         undo, return error return-value .
      589       end.
      590       find first buf_temp-disc no-lock where
      591                  buf_temp-disc.pos-type = p-pos-type
      592               and buf_temp-disc.discnt-role = p-discnt-role
      593               and buf_temp-disc.host-code = p-host-code
      594               and buf_temp-disc.obj-type = p-obj-type
      595               and buf_temp-disc.obj-code = p-obj-code
      596               and buf_temp-disc.nonunique = p-nonunique no-error .
      597       if available buf_temp-disc then do:
      598         P-EXIST = YES.
      599         p-action = buf_temp-disc.action.
      600       end.
      601     end.
      602   end procedure.
      603   procedure temp-dsc-delete :
      604   define input parameter p-pos-type as character  no-undo .
      605   define input parameter p-discnt-role as character no-undo .
      606   define input parameter p-nonunique as character no-undo .
      607   define input parameter p-host-code  as integer no-undo .
      608   define input parameter p-obj-type as character no-undo .
      609   define input parameter p-obj-code as integer no-undo .
      610   define input parameter p-action as logical no-undo .
      611   define output parameter p-deleted  as logical no-undo .
      612   define buffer buf_temp-disc for temp-disc .
      613     do
      614     on error undo, return error :
      615       case 'dis-gds-rule':U:
      616         when 'dis-gds-rule':U
      617         then do:
      618           error-status:error = no.
      619         end.
      620         when 'dis-dc-rule':U
      621         then do:
      622           error-status:error = no.
      623         end.
      624         when 'dis-cp-rule':U
      625         then do:
      626           error-status:error = no.
      627         end.
      628         otherwise do:
      629           undo, return error .
      630         end.
      631       END CASE.
      632       if error-status :error then do:
      633         undo, return error return-value .
      634       end.
      635       find first buf_temp-disc exclusive-lock where
      636                  buf_temp-disc.pos-type = p-pos-type
      637              and buf_temp-disc.discnt-role = p-discnt-role
      638              and buf_temp-disc.host-code = p-host-code
      639              and buf_temp-disc.obj-type = p-obj-type
      640              and buf_temp-disc.obj-code = p-obj-code
      641              and buf_temp-disc.nonunique = p-nonunique
      642              and buf_temp-disc.action = p-action
      643              no-error .
      644       if not available buf_temp-disc then do:
      645         P-DELETED = NO.
      646       end.
      647       ELSE DO:
      648          delete buf_temp-disc.
      649          P-DELETED = YES.
      650       END.
      651     end.
      652   end procedure.
