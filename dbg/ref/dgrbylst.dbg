     2984       then do:
     2985         assign
     2986           v-diasize-change-size = true
     2987         .
     2988       end.
     2989       else do:
     2990         return .
     2991       end.
     2992       assign
     2993         v-frame-height = frame Dialog-Frame :height
     2994         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2995         v-browse-height = v-diasize-browse-handle :height
     2996       .
     2997       for each buf_temp-browse-handle
     2998         where buf_temp-browse-handle.browse-type = 'height':u
     2999       :
     3000         assign
