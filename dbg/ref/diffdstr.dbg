        1   block-level on error undo, throw.
        2   define input parameter p-mode as character no-undo .
        3   define temp-table tt0-dis-time-rule no-undo like ub.dis-time-rule.
        4   define temp-table tt0-term_dis-time-rule no-undo like ub.dis-time-rule.
        5   DEFINE INPUT PARAMETER TABLE FOR tt0-dis-time-rule.
        6   DEFINE INPUT PARAMETER TABLE FOR tt0-term_dis-time-rule.
        7   define output parameter p-found-rule-num like ub.dis-time-rule.time-rule-num no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: diffdstr.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: ref/diffdstr.p $":U .
       13   define variable vss-description as character no-undo init "Поиск правила скидки идентичного вводимому".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define buffer buf_dis-time-rule for ub.dis-time-rule.
       73   define buffer dub_dis-time-rule for ub.dis-time-rule.
       74   define buffer dub_term-dis-time-rule for ub.dis-time-rule.
       75   define buffer dub-tt0-term_dis-time-rule for tt0-term_dis-time-rule.
       76   define variable v-res as character no-undo .
       77   define variable ii as integer no-undo .
       78   define variable kk as integer no-undo .
       79   define variable dub as integer no-undo .
       80   define temp-table tt-compare no-undo
       81   field f-recid as recid
       82   field time-rule-num like ub.dis-time-rule.time-rule-num
       83   index pi is unique primary f-recid
       84   .
       85   do
       86   on error undo, return error
       87   :
       88     find first tt0-dis-time-rule no-lock no-error.
       89     if error-status:error then do:
       90       undo, return error substitute("Неверно передана таблица tt0-dis-time-rule: нет записи").
       91     end.
       92     if tt0-dis-time-rule.is-term and tt0-dis-time-rule.root = no then do:
       93       undo, return error substitute("Неверно передана таблица tt0-dis-time-rule: запись правила скидки является записью детализации").
       94     end.
       95     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
       96       find first buf_dis-time-rule where
       97                 buf_dis-time-rule.time-rule-num  = tt0-dis-time-rule.time-rule-num no-error .
       98       if not available buf_dis-time-rule then do:
       99         undo, return error substitute("Неверно передана таблица tt0-dis-time-rule: нет расписания с № &1", tt0-dis-time-rule.time-rule-num).
      100       end.
      101     end.
      102     if tt0-dis-time-rule.is-term then do:
      103       for each dub_dis-time-rule no-lock where
      104               dub_dis-time-rule.templ-rl-root = tt0-dis-time-rule.templ-rl-root:
      105         if p-mode = 'ИЗМЕНЕНИЕ':U
      106         and dub_dis-time-rule.time-rule-num = tt0-dis-time-rule.time-rule-num then next.
      107         buffer-compare
      108         dub_dis-time-rule
      109         except
      110         time-rule-num
      111         des
      112         rl-root
      113         to tt0-dis-time-rule
      114         case-sensitive
      115         save result  in v-res
      116         .
      117         if v-res = "":u then do:
      118           assign
      119           p-found-rule-num = dub_dis-time-rule.time-rule-num
      120           .
      121           return.
      122         end.
      123       end.
      124     end.
      125     else do:
      126       for each dub_dis-time-rule no-lock where
      127               dub_dis-time-rule.templ-rl-root = tt0-dis-time-rule.templ-rl-root:
      128         assign
      129         dub = 0
      130         .
      131         for each tt-compare:
      132           delete tt-compare.
      133         end.
      134         for each dub_term-dis-time-rule no-lock where
      135               dub_term-dis-time-rule.upper-time-rule-num = dub_dis-time-rule.time-rule-num:
      136           assign
      137           dub = dub + 1
      138           .
      139           for each dub-tt0-term_dis-time-rule no-lock:
      140             buffer-compare
      141             dub_term-dis-time-rule
      142             except
      143             time-rule-num des
      144             upper-time-rule-num
      145             rl-root
      146             to dub-tt0-term_dis-time-rule
      147             case-sensitive
      148             save result  in v-res
      149             .
      150             if v-res = "":u then do:
      151               create tt-compare.
      152               assign
      153               tt-compare.time-rule-num = dub_term-dis-time-rule.time-rule-num
      154               tt-compare.f-recid = recid(dub-tt0-term_dis-time-rule)
      155               .
      156             end.
      157           end.
      158         end.
      159         assign
      160         ii = 0
      161         kk = 0
      162         .
      163         for each dub-tt0-term_dis-time-rule no-lock:
      164           assign
      165           ii = ii + 1
      166           .
      167           find first tt-compare no-lock where
      168                     tt-compare.f-recid = recid(dub-tt0-term_dis-time-rule) no-error .
      169           if available tt-compare then do:
      170             assign
      171             kk = kk + 1
      172             .
      173           end.
      174         end.
      175         if ii = kk and ii = dub then do:
      176           assign
      177           p-found-rule-num = dub_dis-time-rule.time-rule-num
      178           .
      179           return.
      180         end.
      181       end.
      182     end.
      183   end.
