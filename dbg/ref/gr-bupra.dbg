        1   define input  parameter parparentproc as handle no-undo .
        2   define input  parameter p-mode as character no-undo .
        3   define input-output parameter p-recid as recid no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Добавление новой группы покупателей".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   procedure proc-alt-shift-f2:
       71     if not ibs.th.gbl.gbl-var:rcode
       72   then
       73     run gbl\inidebug.p .
       74   end.
       75   procedure proc-alt-shift-f3:
       76     run gbl/prvssinf.p
       77       ( input this-procedure
       78       ) .
       79   end.
       80   define variable v-inform-launched as logical no-undo initial false .
       81   procedure proc-alt-shift-f4:
       82     define variable v-action as character no-undo .
       83     if v-inform-launched = false then do:
       84       assign
       85         v-inform-launched = true
       86       .
       87       run gbl/d-inform.w
       88         (  input self
       89         ,  input this-procedure
       90         , output v-action
       91         ) no-error .
       92       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       93       assign
       94         v-inform-launched = false
       95       .
       96     end.
       97   end.
       98   procedure proc-alt-f1:
       99     run gbl/corrhelp.p
      100       (input this-procedure
      101       ) .
      102   end .
      103   on alt-shift-f2 anywhere do:
      104     run proc-alt-shift-f2.
      105   end.
      106   on alt-shift-f3 anywhere do:
      107     run proc-alt-shift-f3 in this-procedure .
      108   end.
      109   on alt-shift-f4 anywhere do:
      110     run proc-alt-shift-f4 in this-procedure.
      111   end.
      112   on alt-f1 anywhere do:
      113     run proc-alt-f1 in this-procedure .
      114   end.
      115   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      116     define variable v-cntxt-db-num        as integer   no-undo .
      117     define variable v-cntxt-userid        as character no-undo .
      118     define variable v-cntxt-level         as character no-undo .
      119     define variable v-cntxt-host-code-obj as integer   no-undo .
      120     define variable v-cntxt-obj-type      as character no-undo .
      121     define variable v-cntxt-obj-code      as integer   no-undo .
      122     define variable v-cntxt-db-num-obj    as integer   no-undo .
      123     define variable v-cntxt-is-admin      as logical   no-undo .
      124   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125     run mainmenu_getcntxt in parparentproc
      126       (output v-cntxt-db-num
      127       ,output v-cntxt-userid
      128       ,output v-cntxt-level
      129       ,output v-cntxt-host-code-obj
      130       ,output v-cntxt-obj-type
      131       ,output v-cntxt-obj-code
      132       ,output v-cntxt-db-num-obj
      133       ,output v-cntxt-is-admin
      134       ) .
      135   DEFINE BUTTON B-Cancel AUTO-END-KEY
      136        LABEL "Отмена"
      137        SIZE 10 BY 1
      138        BGCOLOR 8 .
      139   DEFINE BUTTON B-Help
      140        LABEL "Помо&щь"
      141        SIZE 10 BY 1
      142        BGCOLOR 8 .
      143   DEFINE BUTTON B-save AUTO-GO
      144        LABEL "Ввод"
      145        SIZE 10 BY 1
      146        BGCOLOR 8 .
      147   DEFINE BUTTON r-cli
      148        IMAGE-UP FILE "btn-down-arrow":U
      149        IMAGE-DOWN FILE "btn-down-arrow":U
      150        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      151        LABEL "r-cli"
      152        SIZE 3 BY .88 TOOLTIP "Выбор из списка".
      153   DEFINE VARIABLE v-gr AS INTEGER FORMAT ">>>>>9":U INITIAL 0
      154        LABEL "Переходит в группу"
      155         VIEW-AS TEXT
      156        SIZE 11.5 BY .67 NO-UNDO.
      157   DEFINE VARIABLE v-gr-db-num AS INTEGER FORMAT "(>>9)":U INITIAL 0
      158         VIEW-AS TEXT
      159        SIZE 4 BY .67 NO-UNDO.
      160   DEFINE VARIABLE v-gr-name AS CHARACTER FORMAT "X(256)":U
      161         VIEW-AS TEXT
      162        SIZE 42 BY .67 NO-UNDO.
      163   DEFINE VARIABLE v-name LIKE ub.buyer-group.name
      164        LABEL "Название группы покупателей"
      165        VIEW-AS FILL-IN
      166        SIZE 55 BY 1 NO-UNDO.
      167   DEFINE VARIABLE v-oborot LIKE ub.buyer-group.oborot
      168        LABEL "Оборот для перехода в другую группу"
      169        VIEW-AS FILL-IN
      170        SIZE 21 BY 1 NO-UNDO.
      171   DEFINE VARIABLE v-rule-grp LIKE ub.buyer-group.rule-grp
      172        LABEL "Правило"
      173        VIEW-AS FILL-IN
      174        SIZE 26 BY 1 NO-UNDO.
      175   DEFINE VARIABLE v-use-alg LIKE ub.buyer-group.use-alg
      176        LABEL "Работает алгоритм при переходе по группам"
      177        VIEW-AS TOGGLE-BOX
      178        SIZE 44.5 BY .83 NO-UNDO.
      179   DEFINE FRAME Dialog-Frame
      180        B-Cancel AT ROW 1 COL 11
      181        B-save AT ROW 1 COL 1
      182        B-Help AT ROW 1 COL 77
      183        v-name AT ROW 2.75 COL 28 COLON-ALIGNED HELP
      184             ""
      185             LABEL "Название группы покупателей" FORMAT "X(80)"
      186        v-oborot AT ROW 4 COL 39 COLON-ALIGNED HELP
      187             ""
      188             LABEL "Оборот для перехода в другую группу" FORMAT "->>>,>>>,>>>,>>9.99"
      189        r-cli AT ROW 5.17 COL 39.5
      190        v-rule-grp AT ROW 8.25 COL 34.5 COLON-ALIGNED HELP
      191             ""
      192             LABEL "Правило" FORMAT "X(256)"
      193        v-use-alg AT ROW 9.5 COL 36.5 HELP
      194             ""
      195             LABEL "Работает алгоритм при переходе по группам"
      196        v-gr AT ROW 5.25 COL 20.5 COLON-ALIGNED
      197        v-gr-db-num AT ROW 5.25 COL 33.38 COLON-ALIGNED NO-LABEL
      198        v-gr-name AT ROW 5.25 COL 40.5 COLON-ALIGNED NO-LABEL
      199        SPACE(2.50) SKIP(6.36)
      200       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      201            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      202            TITLE "Добавление группы покупателей для ценообразования"
      203            DEFAULT-BUTTON B-save CANCEL-BUTTON B-Cancel.
      204   ASSIGN
      205          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      206          FRAME Dialog-Frame:HIDDEN           = TRUE.
      207   ASSIGN
      208          v-gr-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      209   ASSIGN
      210          v-rule-grp:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      211   ASSIGN
      212          v-use-alg:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      213   ON GO OF FRAME Dialog-Frame
      214   DO:
      215     RUN save-proc.
      216   END.
      217   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      218   DO:
      219     APPLY "END-ERROR":U TO SELF.
      220   END.
      221   ON CHOOSE OF r-cli IN FRAME Dialog-Frame
      222   DO:
      223     define variable v-recid as character no-undo .
      224     define buffer bf_buyer-group for ub.buyer-group  .
      225     run ref/gr-bupr.w  (parParentProc , "b-sel" , input-output  v-recid).
      226     find first bf_buyer-group no-lock where recid(bf_buyer-group) = int(v-recid)  no-error .
      227     if not available bf_buyer-group then do:
      228     display "" @ v-gr
      229             "" @ v-gr-db-num
      230             "" @ v-gr-name
      231             with frame Dialog-Frame .
      232     return .
      233     end.
      234     assign
      235         v-gr        = bf_buyer-group.bgr-id
      236         v-gr-db-num = bf_buyer-group.bgr-db-num
      237         v-gr-name   = bf_buyer-group.name
      238     .
      239     display v-gr
      240             v-gr-db-num
      241             v-gr-name
      242             with frame Dialog-Frame .
      243   END.
      244   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      245   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      246   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      247   on help of frame Dialog-Frame
      248   do:
      249     run gbl/app_help.p
      250       (input this-procedure :file-name
      251       ,input ''
      252       ,input ?
      253       ) no-error.
      254     if error-status :error then do:
      255       message
      256         "Ошибка при вызове помощи"
      257         error-status :get-message(1)
      258         view-as alert-box .
      259     end.
      260   end.
      261   run minbtn-set in this-procedure .
      262   on choose of b-help in frame Dialog-Frame
      263   do:
      264     apply "help":u to frame Dialog-Frame .
      265   end.
      266   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      267   procedure minbtn-set :
      268       do
      269           on error undo, return error return-value
      270           :
      271           define variable ii              as integer       no-undo .
      272           define variable fh              as widget-handle no-undo .
      273           define variable hh              as widget-handle no-undo .
      274           define variable v-h             as handle        extent 4 no-undo .
      275           define variable v-name-button   as character     no-undo .
      276           define variable v-help-old-x    as decimal       no-undo .
      277           define variable v-help-old-y    as decimal       no-undo .
      278           define variable v-help-old-size as decimal       no-undo .
      279           define variable v-frame-width   as decimal       no-undo .
      280           define variable jj              as integer       no-undo .
      281           do
      282               on error undo, return error
      283               :
      284               assign
      285                   v-frame-width = frame Dialog-Frame:width - 0.3
      286                   fh            = frame Dialog-Frame:first-child
      287                   hh            = fh:first-child
      288                   ii            = 1
      289                   .
      290               do while valid-handle(hh):
      291                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      292                   do:
      293                       case lc(hh:name) :
      294                           when "b-help" then
      295                               do:
      296                                   hh:load-image-up("cmp/b-help.bmp":u) .
      297                                   hh:load-image-down("cmp/b-help.bmp":u) .
      298                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      299                                   hh:TOOLTIP = "Помощь" .
      300                                   v-help-old-x = hh:column .
      301                                   v-help-old-y = hh:row    .
      302                                   v-help-old-size = hh:width .
      303                                   hh:width-chars = 2.5 .
      304                               end.
      305                           when "b-print" then
      306                               do:
      307                                   hh:load-image("cmp/b-print.bmp":u) .
      308                                   hh:TOOLTIP = "Печать" .
      309                                   v-h[ii] = hh:handle .
      310                                   ii = ii + 1 .
      311                                   hh:width-chars = 3 .
      312                               end.
      313                           when "b-history" or
      314                           when "b-hist" then
      315                               do:
      316                                   hh:load-image("cmp/b-hist.bmp":u) .
      317                                   hh:TOOLTIP = "История" .
      318                                   v-h[ii] = hh:handle .
      319                                   ii = ii + 1 .
      320                                   hh:width-chars = 3 .
      321                               end.
      322                           when "b-sch" then
      323                               do:
      324                                   hh:load-image("cmp/b-sch.bmp":u) .
      325                                   hh:TOOLTIP = "Установка Фильтра" .
      326                                   v-h[ii] = hh:handle .
      327                                   ii = ii + 1 .
      328                                   hh:width-chars = 3 .
      329                               end.
      330                           when "b-hist-user" then
      331                               do:
      332                                   hh:load-image("cmp/b-hist.bmp":u) .
      333                                   hh:TOOLTIP = "История пользователя" .
      334                                   ii = ii + 1 .
      335                               end.
      336                       end case.
      337                   end.
      338                   hh = hh:next-sibling.
      339               end.
      340               b-help:column = v-frame-width - b-help:width-chars.
      341               jj = 0.
      342               repeat ii = 4 to 1 by -1 :
      343                   if valid-handle (v-h[ii] ) then
      344                   do:
      345                       jj  = jj + 1 .
      346                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      347                       v-h[ii]:row    = v-help-old-y .
      348                   end.
      349               end.
      350           end.
      351       end.
      352   end procedure.
      353   MAIN-BLOCK:
      354   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      355      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      356     run init-proc in this-procedure .
      357     run enable_ui in this-procedure .
      358     WAIT-FOR GO OF FRAME Dialog-Frame FOCUS v-name.
      359   END.
      360   RUN disable_UI.
      361   PROCEDURE disable_UI :
      362     HIDE FRAME Dialog-Frame.
      363   END PROCEDURE.
      364   PROCEDURE enable_UI :
      365     DISPLAY v-name v-oborot v-gr v-gr-db-num v-gr-name
      366         WITH FRAME Dialog-Frame.
      367     ENABLE B-Cancel B-save B-Help v-name v-oborot r-cli v-gr v-gr-db-num
      368            v-gr-name
      369         WITH FRAME Dialog-Frame.
      370     VIEW FRAME Dialog-Frame.
      371   END PROCEDURE.
      372   PROCEDURE init-proc :
      373     if p-mode = 'ИЗМЕНЕНИЕ':U then do:
      374       find first  ub.buyer-group exclusive-lock where recid(ub.buyer-group) = p-recid no-error .
      375       if error-status :error then do:
      376           message
      377             vss-workfile vss-revision vss-description skip
      378             error-status :get-message(1) skip
      379             return-value skip
      380             ""
      381             view-as alert-box error
      382           .
      383           return .
      384       end.
      385       assign
      386         v-name     =     ub.buyer-group.name
      387         v-oborot   =     ub.buyer-group.oborot
      388         v-rule-grp =     ub.buyer-group.rule-grp
      389         v-use-alg  =     ub.buyer-group.use-alg
      390         v-gr-db-num =    ub.buyer-group.gop-db-num
      391         v-gr        =    ub.buyer-group.gop-id
      392       .
      393   define buffer bf_buyer-group for ub.buyer-group  .
      394   display v-name
      395           v-oborot
      396           v-gr-db-num
      397           v-gr
      398           with frame Dialog-Frame .
      399   find first bf_buyer-group no-lock where
      400               bf_buyer-group.bgr-id       = v-gr and
      401               bf_buyer-group.bgr-db-num   = v-gr-db-num
      402               no-error .
      403   if available bf_buyer-group then do:
      404   assign
      405       v-gr-name   = bf_buyer-group.name
      406   .
      407   display v-gr-db-num
      408           v-gr-name
      409           v-gr
      410           with frame Dialog-Frame .
      411     end.
      412     end.
      413   END PROCEDURE.
      414   PROCEDURE save-proc :
      415   ASSIGN frame Dialog-Frame
      416           v-name
      417           v-oborot
      418           v-rule-grp
      419           v-use-alg
      420           v-gr
      421           v-gr-db-num
      422           .
      423   if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      424   create ub.buyer-group.
      425   assign
      426     ub.buyer-group.bgr-db-num   = v-cntxt-db-num
      427     ub.buyer-group.bgr-id       = next-value ( s-bgr , ub )
      428     ub.buyer-group.db-num-chg   = v-cntxt-db-num
      429     ub.buyer-group.gop-db-num   = v-cntxt-db-num
      430     ub.buyer-group.gop-id       = 0
      431     ub.buyer-group.stts         = 0
      432     ub.buyer-group.name       = v-name
      433     ub.buyer-group.oborot     = v-oborot
      434     ub.buyer-group.gop-id     = v-gr
      435     ub.buyer-group.gop-db-num = v-gr-db-num
      436     ub.buyer-group.use-alg    = v-use-alg
      437     p-recid = recid(ub.buyer-group)
      438   .
      439   end.
      440   else do:
      441   assign
      442     ub.buyer-group.db-num-chg   = v-cntxt-db-num
      443     ub.buyer-group.stts         = 0
      444     ub.buyer-group.name       = v-name
      445     ub.buyer-group.oborot     = v-oborot
      446     ub.buyer-group.gop-id     = v-gr
      447     ub.buyer-group.gop-db-num = v-gr-db-num
      448     ub.buyer-group.use-alg    = v-use-alg
      449     p-recid = recid(ub.buyer-group)
      450   .
      451   end.
      452   END PROCEDURE.
