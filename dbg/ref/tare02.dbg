        1   block-level on error undo, throw.
        2   define input parameter par-recid as recid no-undo.
        3   define input parameter p-silent as logical no-undo .
        4   define input-output parameter p-stts like ub.tare.stts no-undo .
        5   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        6   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        7   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        8   define variable vss-workfile    as character no-undo init "$Workfile: tare02.p $":U .
        9   define variable vss-archive     as character no-undo init "$Archive: ref/tare02.p $":U .
       10   define variable vss-description as character no-undo init "Изменение статуса тары".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define   shared variable g#auto as logical no-undo.
       72   define   shared variable g#news as logical no-undo.
       73   define   shared variable g#oxml as logical no-undo.
       74   define   shared variable g#esys as logical no-undo.
       75   define   shared variable g#news-source-db as integer no-undo.
       76   define   shared variable g#esys-source-esys as integer no-undo.
       77   define   shared variable g#db-num as integer   no-undo .
       78   define   shared variable g#userid as character no-undo .
       79   define   shared variable g#passwd as character no-undo .
       80   DEFINE VARIABLE loc#log as logical no-undo .
       81   DEFINE BUFFER bf-tare for ub.tare.
       82   DEFINE VARIABLE choice as logical no-undo .
       83   DEFINE VARIABLE varold-stts like ub.tare.stts no-undo .
       84   define variable v-mess as character no-undo .
       85   main-block:
       86   do
       87   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
       88   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       89   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       90   :
       91     FIND FIRST bf-tare WHERE
       92               recid(bf-tare) = par-recid.
       93     varold-stts = bf-tare.stts.
       94     if p-stts = ? then do:
       95       CASE varold-stts:
       96         when integer('0':U) then do:
       97           assign
       98           p-stts = integer('1':U).
       99         end.
      100         when integer('1':U) then do:
      101           assign
      102           p-stts = integer('0':U).
      103         end.
      104       END CASE.
      105     end.
      106     CASE p-stts:
      107       WHEN integer('0':U) then do:
      108         if integer('0':U) = bf-tare.stts  then do:
      109             v-mess = substitute("Запись уже имеет статус &1!", entry (lookup (string(p-stts), '0,1,50,99':U), 'тек,удал,блок,удаление':U)).
      110           run err-mess in this-procedure ( input-output v-mess).
      111           undo main-block, return error (if p-silent then v-mess else '':U).
      112         end.
      113         else do:
      114           if p-silent = no then do:
      115             message
      116             "Запись уже удалена - восстановить?"
      117             view-as alert-box QUestion buttons YEs-no update choice.
      118           end.
      119         end.
      120       end.
      121       WHEN integer('1':U) then do:
      122         if integer('1':U) = bf-tare.stts  then do:
      123           v-mess = substitute("Запись уже имеет статус &1!", entry (lookup (string(p-stts), '0,1,50,99':U), 'тек,удал,блок,удаление':U)).
      124           run err-mess in this-procedure ( input-output v-mess).
      125           undo main-block, return error (if p-silent then v-mess else '':U).
      126         end.
      127         else do:
      128           if p-silent = no then do:
      129             message
      130             "Удалить запись?"
      131             view-as alert-box QUestion buttons yes-no update choice.
      132           end.
      133         end.
      134       end.
      135     END CASE.
      136     if choice then
      137     assign
      138     bf-tare.stts = p-stts.
      139     release bf-tare no-error .
      140     if error-status:error then do:
      141       v-mess =  substitute("Ошибка при сохранении записи ТАРЫ&1&2&1&3"
      142                               , chr(10)
      143                                 ,error-status:get-message(1)
      144                                 , return-value).
      145       run err-mess in this-procedure ( input-output v-mess).
      146       undo main-block, return error (if p-silent then v-mess else '':U).
      147     end.
      148     p-stts = ?.
      149   end.
      150   PROCEDURE err-mess:
      151     DEFINE INPUT-output PARAMETER p-mess as character No-UNDO.
      152     CASE p-silent:
      153       when yes then do:
      154         p-mess =  substitute("Правило №&1&2&3"
      155                              , p-mess).
      156       end.
      157       otherwise do:
      158         message
      159         p-mess
      160         view-as alert-box error .
      161       end.
      162     end.
      163   END PROCEDURE.
