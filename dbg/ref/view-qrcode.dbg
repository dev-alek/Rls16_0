      409   define  stream PrnLibStream.
      410   procedure prn-lib-prn-file :
      411     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      412     define input parameter p-DIsabledoptions as integer no-undo .
      413     define variable v-report-name as character no-undo .
      414     define variable v-user-action as character no-undo .
      415     define variable v-printed     as logical   no-undo .
      416     define variable v-exist       as logical   no-undo .
      417     do
      418       on error undo, return error
      419       :
      420       run prn-lib-get-report-name  in this-procedure (
      421         input parParentProc
      422         ,output v-report-name
      423         ).
      424   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      425   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      426     (input  v-report-name
      427     ,input  2
      428     ,output v-exist
      429     )  .
      430       if NOT v-exist then
      431       DO:
      432         Message
      433           "Нет заданий на печать ! "
      434           view-as alert-box .
      435         Return  .
      436       End.
      437       run gbl/prnfilen.w
      438         (input  ""
      439         ,input  p-DisabledOptions
      440         ,input  string(v-report-name )
      441         ,input  7
      442         ,output v-user-action
      443         ,output v-printed
      444         ) .
      445       if v-printed then
      446       do:
      447         return "YES" .
      448       end.
      449       else
      450       do:
      451         return "NO" .
      452       end.
      453     end.
      454   end procedure.
      455   procedure prn-lib-open-stream :
      456     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      457     define input parameter p-page-size    as integer no-undo .
      458     define input parameter p-is-stream    as logical no-undo .
      459     define input parameter p-append       as logical no-undo .
      460     define variable v-report-name as character no-undo .
      461     do
      462       on error undo, return error
      463       :
      464       run prn-lib-get-report-name  in this-procedure (
      465         input parParentProc
      466         ,output v-report-name
      467         ).
      468       if p-is-stream then
      469       do:
      470         if p-append then
      471         do:
      472           output stream PrnLibStream to value( v-report-name )
      473             page-size value(p-page-size) append .
      474         end.
      475         if not p-append then
      476         do:
      477           output stream PrnLibStream to value( v-report-name )
      478             page-size value(p-page-size) .
      479         end.
      480       end.
      481       if not p-is-stream then
      482       do:
      483         if p-append then
      484         do:
      485           output to value( v-report-name )
      486             page-size value(p-page-size) append .
      487         end.
      488         if not p-append then
      489         do:
      490           output to value( v-report-name )
      491             page-size value(p-page-size) .
      492         end.
      493       end.
      494     end.
      495   end procedure.
      496   procedure prn-lib-open-exp :
      497     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      498     define input parameter p-is-stream    as logical no-undo .
      499     define input parameter p-is-append    as logical no-undo .
      500     define output parameter p-ReportFileName as char init "report" no-undo.
      501     define output parameter p-process as logical no-undo .
      502     define variable glog as logical no-undo .
      503     do
      504       on error undo, return error
      505       :
      506       SYSTEM-DIALOG GET-FILE p-ReportFileName
      507         TITLE      "Укажите путь"
      508         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      509         ASK-OVERWRITE
      510         CREATE-TEST-FILE
      511         SAVE-AS
      512         USE-FILENAME
      513         DEFAULT-EXTENSION "txt"
      514         UPDATE glog
      515         .
      516       if not glog then  return.
      517       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      518       if p-is-stream then
      519       do:
      520         if p-is-append then
      521         do:
      522           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      523         end.
      524         else
      525         do:
      526           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      527         end.
      528       end.
      529       else
      530       do:
      531         if p-is-append then
      532         do:
      533           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      534         end.
      535         else
      536         do:
      537           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      538         end.
      539       end.
      540       p-process = yes.
      541     end.
      542   end procedure.
      543   procedure prn-lib-get-report-name :
      544     define input parameter parParentProc  as widget-handle no-undo.
      545     define output parameter p-report-name as character no-undo .
      546     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      547   end procedure.
      548   procedure prn-lib-reportviewer-report-name :
      549     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      550     define input parameter p-report-name-html as character no-undo .
      551     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      552   end procedure.
      553   procedure prn-lib-reportviewer :
      554     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      555     define input parameter p-report-name-html as character no-undo .
      556     define input parameter p-param        as character no-undo .
      557     define variable v-excel           as character no-undo init 'TRUE' .
      558     define variable v-value-character as character no-undo .
      559     define variable v-value-integer   as character no-undo .
      560     define variable v-value-date      as date      no-undo .
      561     define variable v-value-decimal   as decimal   no-undo .
      562     define variable rep-excel         as logical   no-undo .
      563     define variable excel-string      as character no-undo .
      564     define variable v-param-type      as character no-undo .
      565     define variable v-tth             as handle    no-undo .
      566     run adm/shattri.p (
      567       input "get":U
      568       ,input  ""
      569       ,input  0
      570       ,input  'report-glob':U
      571       ,input  'rep-excel':U
      572       ,output v-value-character
      573       ,output v-value-date
      574       ,output v-value-decimal
      575       ,output v-value-integer
      576       ,output rep-excel
      577       ,output v-param-type
      578       ,INPUT-OUTPUT table-handle v-tth
      579       )  .
      580     if rep-excel then v-excel = "TRUE" .
      581     else v-excel = "FALSE" .
      582     if p-param eq ""
      583     then
      584        p-param = "EXCEL:" + v-excel.
      585     else
      586        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      587     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      588   end procedure.
      589   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile: frmlib.i $ $Revision: aea5316774be, 0, rls $".
      590   FUNCTION Break-n-line RETURNS CHARACTER
      591     ( INPUT p-ost as char,
      592       INPUT p-lengths  as character,
      593       OUTPUT output-num-lines as integer
      594       ) :
      595   define variable ii as integer no-undo.
      596   define variable jj as integer no-undo.
      597   define variable linei as character no-undo extent 10.
      598   define variable line-length as integer no-undo extent 10.
      599   define variable num-line as integer no-undo .
      600   define variable v-line as character no-undo .
      601   do ii = 1 to MIN(num-entries(p-lengths), 10):
      602     assign
      603     line-length[ii] = integer(entry(ii, p-lengths))
      604     num-line = ii
      605     .
      606   end.
      607   do jj = 1 to num-line:
      608     if Length ( p-ost ) <= line-length[jj] then do:
      609       assign
      610       output-num-lines = jj
      611       v-line = v-line + (if jj = 1 then "":U else chr(4)) + p-ost
      612       .
      613       return v-line.
      614     end.
      615     assign
      616     ii = 1
      617     .
      618     if length( entry( ii, p-ost , chr(32)) ) > line-length[jj]
      619     then do:
      620       assign
      621       linei[jj] = substr( p-ost , 1 , line-length[jj] )
      622       p-ost = trim( substr( p-ost , line-length[jj] + 1 ) )
      623       .
      624     end.
      625     else do:
      626       DO WHILE length( linei[jj] + entry( ii, p-ost , chr(32)) ) < ( line-length[jj] + 1 ) :
      627         assign
      628         linei[jj] = linei[jj] + entry( ii, p-ost , chr(32)) + chr(32)
      629         ii = ii + 1
      630         .
      631         if length( entry( ii, p-ost, chr(32) ) ) > line-length[jj] then
      632         assign
      633         linei[jj] = linei[jj] + substr( p-ost , length( linei[jj] ) , line-length[jj] - length( linei[jj] ) + 1 )
      634         .
      635       END.
      636       assign
      637       p-ost = trim( substr( p-ost , length(linei[jj]) + 1  ))
      638       .
      639     end.
      640     assign
      641     v-line = v-line + (if jj = 1 then "":U else chr(4)) + linei[jj]
      642     .
      643     if p-ost = "":U then LEAVE.
      644   end.
      645   assign
      646   output-num-lines = jj.
      647   RETURN v-line.
      648   END FUNCTION.
      649   FUNCTION Center-Field RETURNS CHARACTER
      650     ( INPUT p-str as char,
      651       INPUT p-format as integer,
      652       INPUT p-Length as integer,
      653       INPUT p-fill as character
      654       ) :
      655   define variable v-str as character no-undo .
      656   define variable v-left as integer no-undo .
      657   define variable v-dop as integer no-undo .
      658   assign
      659   p-str = trim(p-str)
      660   .
      661   if p-str = "":U then return fill(p-fill, p-length).
      662   if length(p-str) >= p-format then
      663   p-str = substr(p-str, 1, p-format).
      664   else do:
      665     p-format = length(p-str).
      666   end.
      667   if p-format < p-length then do:
      668     assign
      669     v-left = (p-length - p-format )
      670     v-dop = (if v-left modulo 2 = 1
      671              then 1
      672              else 0)
      673     v-left = (if (v-left modulo 2 = 1)
      674              then (v-left - 1 ) / 2
      675              else v-left / 2)
      676     v-str =  fill(p-fill, v-left) +
      677              string(p-str, "X(":U + string(p-format) + ")":U) +
      678              fill(p-fill, v-left) + fill(p-fill, v-dop)
      679     .
      680     return v-str.
      681   end.
      682   else do:
      683     return string(p-str, "X(":U + string(p-length) + ")":U).
      684   end.
      685   END FUNCTION.
      686   FUNCTION Left-Field RETURNS CHARACTER
      687     ( INPUT p-str as char,
      688       INPUT p-format as integer,
      689       INPUT p-Length as integer,
      690       INPUT p-fill as character
      691       ) :
      692   define variable v-str as character no-undo .
      693   define variable v-left as integer no-undo .
      694   define variable v-dop as integer no-undo .
      695   assign
      696   p-str = trim(p-str)
      697   .
      698   if p-str = "":U then return fill(p-fill, p-length).
      699   if length(p-str) >= p-format then
      700   p-str = substr(p-str, 1, p-format).
      701   else do:
      702     p-format = length(p-str).
      703   end.
      704   if p-format < p-length then do:
      705     assign
      706     v-dop =  p-length - p-format
      707     v-str =  string(p-str, "X(":U + string(p-format) + ")":U) +
      708              fill(p-fill, v-dop)
      709     .
      710     return v-str.
      711   end.
      712   else do:
      713     return string(p-str, "X(":U + string(p-length) + ")":U).
      714   end.
      715   END FUNCTION.
      716   FUNCTION Sum-Rub-Kop-Digit RETURNS CHARACTER
      717     ( INPUT p-sum as decimal,
      718       INPUT p-rub-length as integer,
      719       INPUT p-kop-length as integer,
      720       INPUT p-fill as character,
      721       INPUT p-razr-delim as character,
      722       INPUT p-rub-str  as character,
      723       INPUT p-kop-str  as character
      724       ) :
      725   define variable v-str as character no-undo .
      726   define variable v-format as character no-undo .
      727   define variable v-dopi as integer no-undo .
      728   define variable v-dopi2 as integer no-undo .
      729   assign
      730   v-dopi = length(string(truncate(ABS(p-sum), 0)))
      731   v-dopi2 = truncate(v-dopi / 3, 0) - (if v-dopi modulo  3 = 0 then 1 else 0)
      732   .
      733   if v-dopi > p-rub-length or p-kop-length < 2 then return "?".
      734   assign
      735   v-format = (if p-sum < 0 then "-":U else "":U) + fill((">>>":U + p-razr-delim), v-dopi2) + ">>9":U
      736   v-dopi = length(trim(string(truncate(p-sum, 0), v-format)))
      737   .
      738   assign
      739   v-str = fill(p-fill, p-rub-length - v-dopi) +
      740           string(truncate(p-sum, 0), v-format) +
      741           p-rub-str +
      742           fill(p-fill, p-kop-length - 2) +
      743           string(truncate((ABS(p-sum) - ABS(truncate(p-sum, 0))), 2) * 100, "99":U) + p-kop-str
      744   .
      745   return v-str.
      746   END FUNCTION.
      747   FUNCTION Sum-Invalut-Digit RETURNS CHARACTER
      748     ( INPUT p-sum as decimal,
      749       INPUT p-sum-length as integer,
      750       INPUT p-curr-code as integer,
      751       INPUT p-fill as character,
      752       INPUT p-razr-delim as character
      753       ) :
      754   define variable v-str as character no-undo .
      755   define variable v-format as character no-undo .
      756   define variable v-dopi as integer no-undo .
      757   define variable v-dopi2 as integer no-undo .
      758   define variable v-curr-name as character no-undo .
      759   define buffer buf_currency for ub.currency.
      760   find first buf_currency no-lock where
      761             buf_currency.curr-code = p-curr-code no-error .
      762   if not avail buf_currency
      763   then v-curr-name = "неизвестная валюта".
      764   else
      765   assign
      766   v-curr-name = buf_currency.curr-name
      767   .
      768   assign
      769   v-dopi = length(string(truncate(ABS(p-sum), 0)))
      770   v-dopi2 = truncate(v-dopi / 3, 0) - (if v-dopi modulo  3 = 0 then 1 else 0)
      771   .
      772   if v-dopi > p-sum-length then return "?".
      773   assign
      774   v-format = (if p-sum < 0 then "-":U else "":U) + fill((">>>":U + p-razr-delim), v-dopi2) + ">>9.99":U
      775   v-dopi = length(trim(string(p-sum, v-format)))
      776   .
      777   assign
      778   v-str = "(":U + chr(32) + v-curr-name +  chr(32) + ")":U +
      779           fill(p-fill, p-sum-length - v-dopi - length(v-curr-name) - 4)  +
      780           trim(string(p-sum, v-format))
      781   .
      782   return v-str.
      783   END FUNCTION.
      784   FUNCTION Sum-in-Words-Without-Dec RETURNS CHARACTER
      785   (input v-sum as decimal
      786   ):
      787   define variable v-str as character no-undo .
      788   run gbl/num-rus.p ( input absolute( v-sum ) , output v-str).
      789   v-str = trim( caps( substring( v-str, 1, 1 ) ) ) + substring( v-str, 2 ).
      790   return v-str.
      791   END FUNCTION.
      792   FUNCTION Sum-in-Words-Invalut RETURNS CHARACTER
      793   (input p-sum as decimal
      794    ,input p-curr-code as integer
      795   ):
      796   define variable v-str as character no-undo .
      797   define variable Copeck as character no-undo.
      798   define variable Rouble as character no-undo.
      799   define variable v-Word as character no-undo.
      800   define variable ii as integer init 18 no-undo.
      801   define variable v-str-rubl as character no-undo .
      802   define variable v-kop as integer no-undo .
      803   define buffer buf_currency for ub.currency.
      804   assign
      805   v-Word = string( absolute( p-sum ) , "999999999999999.99" ).
      806   find first buf_currency no-lock where
      807             buf_currency.curr-code = p-curr-code no-error .
      808   if not available buf_currency then return chr(63).
      809   if decimal( substring(v-Word,1,ii - 3) ) <> 0 then do:
      810     CASE substring(v-Word, ii - 3,1):
      811       WHEN "1" THEN DO:
      812         if substring(v-Word, ii - 4,1) = "1" then
      813             Rouble = buf_currency.curr-name-five .
      814         else
      815             Rouble = buf_currency.curr-name-one .
      816       END.
      817       WHEN "2" OR WHEN "3" OR WHEN "4" THEN  DO:
      818         if substring(v-Word, ii - 4,1) = "1" then
      819            Rouble = buf_currency.curr-name-five .
      820            else
      821            Rouble = buf_currency.curr-name-three .
      822         END.
      823       WHEN "0" OR WHEN "5" OR WHEN "6" OR WHEN "7" OR WHEN "8" OR WHEN "9" THEN  DO:
      824          Rouble = buf_currency.curr-name-five .
      825       END.
      826     END CASE.
      827   end.
      828   CASE substring(v-Word, ii, 1):
      829     WHEN "1" THEN DO:
      830       if substring(v-Word, ii - 1, 1) = "1" then
      831           Copeck = buf_currency.part-name-five .
      832       else
      833           Copeck = buf_currency.part-name-one .
      834     END.
      835     WHEN "2" OR WHEN "3" OR WHEN "4" THEN DO:
      836       if substring(v-Word, ii - 1, 1) = "1" then
      837           Copeck = buf_currency.part-name-five .
      838       else
      839           Copeck = buf_currency.part-name-three .
      840     END.
      841     WHEN "0" OR WHEN "5" OR WHEN "6" OR WHEN "7" OR WHEN "8" OR WHEN "9" THEN DO:
      842       Copeck = buf_currency.part-name-five .
      843     END.
      844   END CASE.
      845   run gbl/num-rus.p ( input absolute( p-sum )
      846                , output v-str-rubl).
      847   assign
      848   v-kop = (absolute( p-sum ) - truncate(absolute(p-sum), 0)
      849           ) * 100
      850   .
      851   v-str = ( if p-Sum < 0 then "- " else "" ) +
      852               caps(substring(v-str-rubl, 1, 1)) +  substring(v-str-rubl, 2) + chr(32) + Rouble + chr(32) +
      853               string(v-kop, "99":U) + chr(32) + Copeck .
      854   return v-str.
      855   END FUNCTION.
      856   FUNCTION Sum-delim-with-defis RETURNS CHARACTER
      857   (input v-sum as decimal,
      858   input v-razr as integer
      859   ):
      860   define variable v-str as character no-undo .
      861   define variable v-dec-separ as character no-undo .
      862   case SESSION:NUMERIC-FORMAT:
      863     when "American":U then do:
      864       assign
      865       v-dec-separ = ".":U
      866       .
      867     end.
      868     when "European":U then do:
      869       assign
      870       v-dec-separ = ",":U
      871       .
      872     end.
      873   END CASE.
      874   assign
      875   v-str = replace(string(v-sum, fill(">":U, v-razr - 1) + "9.99"), v-dec-separ, "-":U)
      876   .
      877   return v-str.
      878   END FUNCTION.
      879   FUNCTION MonthNameRusGen RETURNS CHARACTER ( INPUT i-month AS INTEGER ) :
      880     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
      881     RUN get-month-name-gen IN THIS-PROCEDURE ( INPUT i-month, OUTPUT v-name ) NO-ERROR.
      882     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
      883   END FUNCTION.
      884   PROCEDURE get-month-name-gen :
      885     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
      886     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
      887     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO INITIAL "Января,Февраля,Марта,Апреля,Мая,Июня,Июля,Августа,Сентября,Октября,Ноября,Декабря".
      888     DO ON ERROR UNDO, RETURN ERROR :
      889       ASSIGN p-name = ( IF p-month >= 1 AND p-month <= 12 THEN ENTRY( p-month, v-list ) ELSE ? ).
      890     END.
      891   END PROCEDURE.
      892   define variable stat as log no-undo .
      893   define variable v-param-type as character no-undo .
      894   define variable v-value-date as date no-undo .
      895   define variable v-value-decimal as decimal no-undo .
      896   define variable v-value-integer as INTEGER no-undo .
      897   define variable v-value-logical AS LOGICAL no-undo .
      898   define variable v-tth as handle no-undo .
      899   define variable v-descriptions as character no-undo .
      900   define variable v-extensiond   as character no-undo .
      901   define variable v-extensiont   as character no-undo .
      902   define variable new-code as character no-undo .
      903   define stream Out-Stream.
      904   define stream OutStr-html.
      905   FUNCTION get-staff-name RETURNS CHARACTER ( input p-obj-name as character
      906                                             , input p-psn-code as integer
      907                                             , input p-stts as integer):
      908   define variable v-full-name as character no-undo .
      909   define buffer buf_person for ub.person.
      910   find first buf_person no-lock where
      911             buf_person.psn-code = p-psn-code no-error.
      912   v-full-name = substitute("&1 &2 &3"
      913                      , p-obj-name
      914                      , (if available buf_person then buf_person.name1 else '')
      915                      , (if available buf_person then buf_person.name2 else '')
      916                      ).
      917   RETURN
      918   (IF (p-stts = integer('0':U))
      919   THEN v-full-name
      920   ELSE (substring (v-full-name,1, 25) +
      921                   FILL (chr(32), 25 - LENGTH (substring (v-full-name, 1, 25)) )) +
      922                   '---  УДАЛЕН  ---':U).
      923   END FUNCTION.
      924   DEFINE BUTTON b-print
      925        IMAGE-UP FILE "cmp/b-print.bmp":U
      926        IMAGE-DOWN FILE "cmp/b-print.bmp":U
      927        IMAGE-INSENSITIVE FILE "cmp/b-print.bmp":U NO-CONVERT-3D-COLORS
      928        LABEL "Печать"
      929        SIZE 3 BY 1.
      930   DEFINE BUTTON B-qrCode
      931        LABEL "&Новый QR-код"
      932        SIZE 15 BY 1.
      933   DEFINE BUTTON Btn_Close AUTO-GO
      934        LABEL "&Выход ":L
      935        SIZE 15 BY 1
      936        BGCOLOR 8 .
      937   DEFINE IMAGE qr-code
      938        STRETCH-TO-FIT RETAIN-SHAPE
      939        SIZE 30.5 BY 10.75.
      940   DEFINE FRAME DLGCLOSE
      941        Btn_Close AT ROW 1 COL 1
      942        B-qrCode AT ROW 1 COL 16
      943        b-print AT ROW 1 COL 36.75 WIDGET-ID 62
      944        qr-code AT ROW 3 COL 5.63
      945        SPACE(4.36) SKIP(0.95)
      946       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      947            SIDE-LABELS THREE-D  SCROLLABLE
      948            BGCOLOR 8
      949            TITLE BGCOLOR 8 "QR-code кассира":L
      950            DEFAULT-BUTTON Btn_Close.
      951   ASSIGN
      952          FRAME DLGCLOSE:SCROLLABLE       = FALSE
      953          FRAME DLGCLOSE:PRIVATE-DATA     =
      954                   "DLGCLOSE".
      955   ASSIGN
      956          Btn_Close:PRIVATE-DATA IN FRAME DLGCLOSE     =
      957                   "Btn_Close".
      958   ASSIGN
      959          qr-code:RESIZABLE IN FRAME DLGCLOSE        = TRUE.
      960   ON CHOOSE OF B-qrCode IN FRAME DLGCLOSE
      961   DO:
      962     define variable recid_attr as recid no-undo .
      963     run generate_qrCode(output CashierQRCode) .
      964     find first ub.staff-attr exclusive-lock where ub.staff-attr.attr-code = "CashierQRCode" and
      965       ub.staff-attr.date-start <= today and
      966       ub.staff-attr.role = tt0-staff.role and
      967       ub.staff-attr.staff-code = tt0-staff.staff-code and
      968       ub.staff-attr.role-level = tt0-staff.role-level no-error .
      969     if not available (ub.staff-attr) then
      970     do:
      971       create ub.staff-attr .
      972       assign
      973         ub.staff-attr.attr-code  = "CashierQRCode"
      974         ub.staff-attr.date-start = today
      975         ub.staff-attr.role       = tt0-staff.role
      976         ub.staff-attr.role-level = tt0-staff.role-level
      977         ub.staff-attr.staff-code = tt0-staff.staff-code
      978         .
      979     end.
      980     ub.staff-attr.attr-value = CashierQRCode .
      981     run print_qrCode(CashierQRCode).
      982     stat = qr-code:load-image( "" + session:temp-directory + "\qr-code.png":U) .
      983     p-update = true .
      984     DISPLAY
      985       qr-code
      986       WITH FRAME DLGCLOSE.
      987   END.
      988   ON choose of b-print in frame DLGCLOSE
      989   DO:
      990     define variable p-report-id as character no-undo .
      991     define variable v-firm as character no-undo .
      992     define variable v-obj-name as character no-undo .
      993     define variable v-hist-code as character no-undo .
      994     define variable v-hist-name as character no-undo .
      995     define variable v-file-name-rep-htm as character no-undo .
      996     define variable par-type as character no-undo .
      997     define buffer buf_clients for ub.clients .
      998     define buffer buf_shop for ub.shop .
      999     run get-report-num (output p-report-id).
     1000     v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
     1001     output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8' .
     1002     find first buf_clients no-lock where buf_clients.obj-type = 'орг':U and buf_clients.obj-code = v-cntxt-host-code-obj no-error .
     1003     if available (buf_clients) then v-firm = buf_clients.obj-name .
     1004     find first ub.firm no-lock where ub.firm.firm-code = v-cntxt-host-code-obj no-error .
     1005     find first buf_shop no-lock where buf_shop.obj-code = v-cntxt-obj-code no-error .
     1006     run db-attr-value(INPUT v-cntxt-db-num,INPUT 'hist-code':U,OUTPUT v-hist-code ,OUTPUT par-type) .
     1007     run db-attr-value(INPUT v-cntxt-db-num,INPUT 'hist-name':U,OUTPUT v-hist-name ,OUTPUT par-type) .
     1008     if v-hist-name = "" then v-hist-name = v-obj-name .
     1009     do:
     1010       put stream OutStr-html unformatted
     1011   "<!DOCTYPE HTML>" skip
     1012   ' <html>' skip
     1013   '  <head>' skip
     1014   '   <meta charset="utf-8">' skip
     1015   '    <style type="text/css">' skip
     1016   '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1017   '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1018   '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black;' + chr(125) skip
     1019   '   </style>' skip
     1020   '  </head>' skip
     1021         '<body>' skip
     1022         substitute('<TABLE name="&1" fit_to_page="true" orientation="portrait" repeat_rows="1:4" outline_below="false">', 'QR-code') skip
     1023         '<thead>' skip
     1024         '  <tr class="set_columns">' skip
     1025         '    <td style="width: 400px;"></td>' skip
     1026         '  </tr>' skip
     1027         '  <tr>' skip
     1028         '    <td text_wrap="true" style="text-align: center;">' + v-firm + '</td>' skip
     1029         '  </tr>' skip
     1030         '  <tr>' skip
     1031         '    <td text_wrap="true" style="text-align: center;">' + v-hist-name + '</td>' skip
     1032         '  </tr>' skip
     1033         '  <tr>' skip
     1034         '    <td text_wrap="true" style="text-align: center;">' + buf_shop.addres1 + '</td>' skip
     1035         '  </tr>' skip
     1036         '  <tr>' skip
     1037         '    <td text_wrap="true" style="text-align: center;">' + buf_shop.addres2 + '</td>' skip
     1038         '  </tr>' skip
     1039         .
     1040       if search( "" + session:temp-directory + "\qr-code.png":U ) <> ? then
     1041       do:
     1042         put stream OutStr-html unformatted
     1043           '<tr>' skip
     1044           '<td style="text-align: center;"><img src="' + session:temp-directory + '\qr-code.png" width="130" height="130" alt=""/></td>' skip
     1045           '</tr>' skip .
     1046       end.
     1047       else
     1048       do:
     1049         put stream OutStr-html unformatted
     1050           '<tr>' skip
     1051           '<td text_wrap="true" style="text-align: center;"></td>' skip
     1052           '</tr>' skip.
     1053       end.
     1054       find first ub.clients NO-LOCK WHERE ub.clients.obj-type = 'чел':U and ub.clients.obj-code = tt0-staff.psn-code no-error .
     1055       put stream OutStr-html unformatted
     1056         '<tr>' skip
     1057         '<td text_wrap="true" style="text-align: center;">' + get-staff-name ( ub.clients.obj-name, ub.clients.obj-code, ub.clients.stts ) + '</td>' skip
     1058         '</tr>' skip.
     1059     end.
     1060     put stream OutStr-html unformatted
     1061       '</thead>' skip
     1062       '<tbody>' skip
     1063       .
     1064     put stream OutStr-html unformatted
     1065       '</tbody>' skip
     1066       '<tfoot>' skip
     1067       .
     1068     put stream OutStr-html unformatted
     1069       '</tfoot>' skip
     1070       '</table>' skip
     1071       '</body>' skip
     1072       '</html>' skip
     1073       .
     1074     output stream OutStr-html close.
     1075     run prn-lib-reportviewer in this-procedure (
     1076       input this-procedure
     1077       ,input v-file-name-rep-htm
     1078       ,input ""
     1079       ) .
     1080     if error-status:error then
     1081     do:
     1082       message return-value view-as alert-box.
     1083       return .
     1084     end.
     1085     END.
     1086   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME DLGCLOSE:PARENT eq ?
     1087   THEN FRAME DLGCLOSE:PARENT = ACTIVE-WINDOW.
     1088   ON WINDOW-CLOSE OF FRAME DLGCLOSE APPLY "END-ERROR":U TO SELF.
     1089   MAIN-BLOCK:
     1090   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1091      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1092   find first tt0-staff no-error .
     1093     run print_qrCode(CashierQRCode).
     1094     if CashierQRCode <> "" then
     1095       stat = qr-code:load-image( "" + session:temp-directory + "\qr-code.png":U) .
     1096       run enable_UI in this-procedure .
     1097       WAIT-FOR GO OF FRAME DLGCLOSE.
     1098   END.
     1099   run disable_UI in this-procedure .
     1100   PROCEDURE disable_UI :
     1101     HIDE FRAME DLGCLOSE.
     1102   END PROCEDURE.
     1103   PROCEDURE print_qrCode :
     1104     define input parameter p-code as character no-undo .
     1105       define variable v-arc as character no-undo .
     1106       define variable v-cmd as character no-undo .
     1107       assign
     1108         v-arc = search( "exe/qrgen.exe":U )
     1109         .
     1110       if v-arc = ? then
     1111       do:
     1112         return error "Не найдена программа qrgen.exe" .
     1113       end.
     1114       os-command silent value (v-arc + ' -size=128 -content="' + p-code + '"' + ' -filename="' + session:temp-directory + '\qr-code"') .
     1115   END PROCEDURE.
     1116   PROCEDURE generate_qrCode :
     1117     define output parameter qr-code-out as character no-undo .
     1118     define variable new-code as character no-undo .
     1119     define variable v-code as character no-undo .
     1120     v-code = string(v-cntxt-obj-code,"99999") + string(tt0-staff.staff-code,"999") + string(random( 11111 , 99999 )) .
     1121     run adm/pswd-enc.p (input v-code, output new-code) .
     1122     run base64-encode (new-code,output qr-code-out).
     1123   END PROCEDURE.
     1124   PROCEDURE enable_UI :
     1125     ENABLE Btn_Close qr-code B-qrCode b-print
     1126         WITH FRAME DLGCLOSE.
     1127   END PROCEDURE.
     1128   PROCEDURE get-report-num :
     1129     define output parameter p-report-num as integer no-undo .
     1130     do
     1131       on error undo, return error return-value
     1132       :
     1133       run gbl/getrpnum.p (output p-report-num).
     1134     end.
     1135   END PROCEDURE.
