      118   DEFINE VARIABLE v-image-order      AS CHARACTER NO-UNDO INIT "jpg,bmp":U.
      119   define variable v-image-format     as character extent 62 init
      120   [
      121    "Windows bitmap                                                          ", "*.bmp"
      122   ,"Computer-aided Acquisition and Logistics Support                        ", "*.cal"
      123   ,"Microsoft Windows Clipboard                                             ", "*.clp"
      124   ,"Halo CUT                                                                ", "*.cut"
      125   ,"Intel FAX format                                                        ", "*.dcx"
      126   ,"Windows device-independent bitmap                                       ", "*.dib"
      127   ,"Encapsulated PostScript                                                 ", "*.eps"
      128   ,"1 Graphics Interchange Format                                           ", "*.gif"
      129   ,"IBM IOCA                                                                ", "*.ica"
      130   ,"Microsoft Icon File format                                              ", "*.ico"
      131   ,"Amiga IFF                                                               ", "*.iff"
      132   ,"GEM bitmap                                                              ", "*.img"
      133   ,"Joint Bi-level Image Experts Group                                      ", "*.jbig"
      134   ,"JPEG                                                                    ", "*.jpg"
      135   ,"serView                                                                 ", "*.lv "
      136   ,"Macintosh MacPaint                                                      ", "*.mac"
      137   ,"Microsoft Windows Paint                                                 ", "*.msp"
      138   ,"Kodak Photo CD                                                          ", "*.pcd"
      139   ,"Macintosh PICT                                                          ", "*.pct"
      140   ,"PC Paintbrush                                                           ", "*.pcx"
      141   ,"GIF (Graphics Interchange Format) replacement                           ", "*.png"
      142   ,"Adobe Photoshop                                                         ", "*.psd"
      143   ,"Sun Raster (1-, 8-, 24-, or 32-bit Standard, BGR, RGB, and byte encoded)", "*.ras"
      144   ,"TARGA                                                                   ", "*.tga"
      145   ,"Tag image file format                                                   ", "*.tif"
      146   ,"Windows bitmap for wireless devices                                     ", "*.wbmp"
      147   ,"Windows metafiles                                                       ", "*.wmf"
      148   ,"WordPerfect graphics                                                    ", "*.wpg"
      149   ,"(also .bm) X bitmap                                                     ", "*.xbm"
      150   ,"Pixmap                                                                  ", "*.xpm"
      151   ,"UNIX X Window Dump File format                                          ", "*.xwd"
      152   ] no-undo.
      153   procedure get-custom-img-order :
      154   define output parameter p-descriptions as character no-undo .
      155   define output parameter p-extensiond   as character no-undo .
      156   define output parameter p-extensiont   as character no-undo .
      157   define variable ii as integer no-undo .
      158   define variable v-entry as integer no-undo .
      159     do
      160     on error undo, return error
      161     :
      162       assign
      163       p-descriptions = fill(chr(4), 30)
      164       p-extensiond   = fill(chr(4), 30)
      165       p-extensiont   = fill(chr(4), 30)
      166       .
      167       do ii = 2 to 62 by 2:
      168         assign
      169         v-entry = lookup(left-trim(v-image-format[ii], ".*"), v-image-order)
      170         .
      171         if v-entry > 0 then do:
      172           assign
      173           entry(v-entry, p-descriptions, chr(4)) = substitute("&1 &2", trim(v-image-format[ii - 1]), v-image-format[ii])
      174           entry(v-entry, p-extensiond, chr(4)) = v-image-format[ii]
      175           entry(v-entry, p-extensiont, chr(4)) = left-trim(v-image-format[ii], ".*")
      176           .
      177         end.
      178       end.
      179       assign
      180       p-descriptions = trim(p-descriptions, chr(4))
      181       p-extensiond   = trim(p-extensiond, chr(4))
      182       p-extensiont   = trim(p-extensiont, chr(4))
      183       p-descriptions = replace(p-descriptions, (chr(4) + chr(4)), chr(4))
      184       p-extensiond   = replace(p-extensiond, (chr(4) + chr(4)),  chr(4))
      185       p-extensiont   = replace(p-extensiont, (chr(4) + chr(4)), chr(4))
      186       .
      187     end.
      188   end procedure.
      189   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      190   procedure base64-encode :
      191     define input  parameter v-string        as character no-undo .
      192     define output parameter v-base64-encode as character no-undo .
      193     do
      194     on error undo, return error return-value
      195     :
      196       define variable v-raw     as raw       no-undo .
      197       define variable v-raw-str as character no-undo .
      198       if v-string = ?
      199       then do:
      200         undo, return error "base64-encode: строка имеет неопределенное значение" .
      201       end.
      202       assign
      203         length(v-raw) = length(v-string) + 1
      204       .
      205       assign
      206         put-string(v-raw, 1) = v-string
      207       .
      208       assign
      209         v-raw-str = string(v-raw)
      210       .
      211       assign
      212         length(v-raw) = 0
      213       .
      214       assign
      215         v-base64-encode = substring(v-raw-str, 7)
      216       .
      217     end.
      218   end.
