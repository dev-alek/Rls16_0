        1   DEFINE BUFFER buf_goods FOR goods.
        2   define input parameter p-gds-code like ub.goods.gds-code no-undo.
        3   define input parameter p-obj-type like ub.clients.obj-type no-undo.
        4   define input parameter p-obj-code like ub.clients.obj-code no-undo.
        5   define input-output parameter p-value as character no-undo.
        6   define variable vss-revision    as character no-undo init "$Revision$":U .
        7   define variable vss-author      as character no-undo init "$Author$":U .
        8   define variable vss-date        as character no-undo init "$Date$":U .
        9   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       10   define variable vss-archive     as character no-undo init "$Archive$":U .
       11   define variable vss-description as character no-undo init "Дополнение к альтернативному названию".
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   define new global shared variable g#library  as handle no-undo .
       71   define new global shared variable g#library2 as handle no-undo .
       72   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       73   define variable v-waitfram-action01         as character   no-undo .
       74   define variable v-waitfram-action02         as character   no-undo .
       75   define variable v-waitfram-action03         as character   no-undo .
       76   define variable mWaitFramTextBeg            as character   no-undo.
       77   define variable mWaitFramTextEnd            as character   no-undo.
       78   define variable mWaitFramView               as logical     no-undo.
       79   define variable mWaitProcEvent              as logical     no-undo init yes.
       80   define variable mWaitFramInterval           as integer     no-undo init 1 .
       81   define variable mWaitFramStop               as logical     no-undo.
       82   define variable mWaitFramStopUser           as logical     no-undo.
       83   define variable mWaitFramStopTimeOut        as logical     no-undo.
       84   define variable mWaitFramStartProc          as datetime-tz no-undo.
       85   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       86   define button B-WaitFramStop auto-end-key
       87        label "Стоп"
       88        size 10 by 1 tooltip "Остоновить процесс".
       89   define button B-viewProcInfo
       90        label "Информация"
       91        size 15 by 1 tooltip "Информация о процесс".
       92   define frame waitfram
       93     v-waitfram-action01 format "x(72)" no-label skip
       94     v-waitfram-action02 format "x(72)" no-label skip
       95     v-waitfram-action03 format "x(72)" no-label skip
       96     B-viewProcInfo
       97     B-WaitFramStop at row 4 col 30
       98     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       99     .
      100   define new global shared variable mBatchMode as logical no-undo init ?.
      101   define variable mFramBachModHandle as handle no-undo.
      102   mFramBachModHandle = frame waitfram:handle.
      103   define variable mFameOldVis as logical no-undo.
      104   define variable mVisCUrentVin as logical no-undo.
      105   if session:batch-mode
      106   then
      107      mBatchMode = yes.
      108   if mBatchMode = ? then do:
      109     mVisCUrentVin = current-window:visible.
      110     mFameOldVis = mFramBachModHandle:visible.
      111     mFramBachModHandle:visible  = yes.
      112     mBatchMode = mFramBachModHandle:visible ne yes.
      113     mFramBachModHandle:visible = mFameOldVis.
      114     current-window:visible = mVisCUrentVin.
      115   end.
      116    if  log-manager:logfile-name ne ?
      117     then DO:
      118         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      119         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      120         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      121     end.
      122   on choose of B-WaitFramStop in frame waitfram
      123   do:
      124     mWaitFramStop = yes.
      125     mWaitFramStopUser = yes.
      126   end.
      127   function waitfram-check-timeout returns logical():
      128      define variable vtime as int64 no-undo.
      129      if mWaitFramStopTimeOut
      130      then
      131         return yes.
      132      vtime = ( now - mWaitFramStartProc ) / 1000 .
      133      if     mWaitFramTimeOut ne ?
      134         and mWaitFramTimeOut ne 0
      135         and mWaitFramTimeOut lt vtime
      136      then do:
      137         mWaitFramStopTimeOut = yes.
      138      end.
      139      return mWaitFramStopTimeOut.
      140   end.
      141   procedure waitfram-hide :
      142     if not session:batch-mode
      143     then do
      144     on error undo, return error return-value
      145     :
      146       pause 0 before-hide .
      147       if not mBatchMode then
      148         hide frame waitfram .
      149     if     not mWaitFramView
      150        and mWaitProcEvent
      151     then
      152       process events .
      153     end.
      154   end procedure.
      155   procedure waitfram-show :
      156     define input  parameter p-message as character no-undo .
      157     define variable v-left-margin as integer   no-undo .
      158     if not session:batch-mode
      159     then do
      160     on error undo, return error return-value
      161     :
      162       if length(p-message) <= 70 then do:
      163         assign
      164           v-left-margin = integer((70 - length(p-message)) / 2)
      165         .
      166         assign
      167           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      168         .
      169         assign
      170           v-waitfram-action01 = " "
      171           v-waitfram-action02 = " "
      172                                    + fill(" ", v-left-margin)
      173                                    + p-message
      174           v-waitfram-action03 = " "
      175         .
      176       end.
      177       else do:
      178         define variable vRindex1 as integer no-undo.
      179         define variable vRindex2 as integer no-undo.
      180         vRindex1 = r-index(p-message," ",70).
      181         if vRindex1 = 0
      182         then
      183            vRindex1 = 70.
      184         if length(p-message)  <= vRindex1 + 70 then do:
      185           assign
      186             v-waitfram-action01 = " "
      187             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      188             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      189           .
      190         end.
      191         else do:
      192           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      193           if vRindex2 <= vRindex1
      194           then
      195              vRindex2 = vRindex1 + 70.
      196           assign
      197             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      198             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      199             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      200           .
      201         end.
      202       end.
      203       B-viewProcInfo:visible   in frame waitfram = no.
      204       B-viewProcInfo:sensitive in frame waitfram = no.
      205       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      206       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      207       if  (   mWaitFramView
      208          or  mWaitProcEvent)
      209          and not mBatchMode
      210       then
      211          display
      212             v-waitfram-action01 skip
      213             v-waitfram-action02 skip
      214             v-waitfram-action03 skip
      215          with frame waitfram .
      216       if     mWaitFramView
      217          then do:
      218             if     mWaitFramInterval ne ?
      219                and not mBatchMode
      220             then
      221                wait-for go of frame waitfram pause mWaitFramInterval.
      222          end.
      223          else
      224             if     mWaitProcEvent
      225                and not mBatchMode
      226             then
      227                process events .
      228     end.
      229   end procedure.
      230      procedure waitfram-show-this:
      231         define input  parameter iInterval as int64 no-undo.
      232         define variable vtime as int64 no-undo.
      233         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      234         mWaitFramInterval = iInterval.
      235         run waitfram-show (substitute("&1&2 &3&4" ,
      236                                       mWaitFramTextBeg ,
      237                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      238                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      239                                       mWaitFramTextEnd
      240                                      )
      241                           ).
      242      end.
      243      procedure WaitFramRunPause:
      244         define input  parameter iInterval as dec no-undo.
      245         define variable vStart  as datetime-tz no-undo.
      246         define variable vend    as datetime-tz no-undo.
      247         define variable vint as int64 no-undo.
      248         define variable vOk as logical no-undo.
      249         vStart = now.
      250         vend   = vStart.
      251         publish "WaitFramPause" (iInterval,output vOk).
      252         vend   =  now.
      253         vint = vend - vStart.
      254         vint = iInterval - vint / 1000.
      255         if     not mWaitFramStop
      256            and (   vint > 0
      257                 or (    not vOk
      258                     and iInterval eq ?
      259                     )
      260                 )
      261         then
      262            run waitfram-show-this (iInterval).
      263         vend   =  now.
      264         vint = vend - vStart.
      265         vint = iInterval - vint / 1000.
      266         if     not mWaitFramStop
      267            and vint > 0
      268         then do:
      269            run gbl/pause.p (vint * 1000).
      270         end.
      271         if iInterval ne ?
      272         then
      273            publish "WaitFramStop".
      274         waitfram-check-timeout().
      275      end.
      276      procedure WaitFramWaitFor:
      277         define input  parameter iInterval as dec no-undo.
      278         assign
      279            mWaitFramStartProc   = now
      280            mWaitFramStopUser    = no
      281            mWaitFramStopTimeOut = no
      282         .
      283         block-wait:
      284         do while not mWaitFramStop:
      285            run WaitFramRunPause (iInterval).
      286            if  waitfram-check-timeout()
      287            then do:
      288               leave block-wait.
      289            end.
      290         end.
      291         run waitfram-hide.
      292      end.
      293   procedure waitfram-join :
      294     define input  parameter p-line-1  as character no-undo .
      295     define input  parameter p-line-2  as character no-undo .
      296     define input  parameter p-line-3  as character no-undo .
      297     define output parameter p-message as character no-undo .
      298     do
      299     on error undo, return error return-value
      300     :
      301       assign
      302         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      303                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      304                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      305       .
      306     end.
      307   end procedure.
      308   function waitfram-join-function returns character
      309     (input p-line-1 as character
      310     ,input p-line-2 as character
      311     ,input p-line-3 as character
      312     ).
      313     define variable v-message as character no-undo .
      314     run waitfram-join in this-procedure
      315       (input  p-line-1
      316       ,input  p-line-2
      317       ,input  p-line-3
      318       ,output v-message
      319       ) .
      320     return v-message .
      321   end function .
      322   procedure proc-alt-shift-f2:
      323     if not ibs.th.gbl.gbl-var:rcode
      324   then
      325     run gbl\inidebug.p .
      326   end.
      327   procedure proc-alt-shift-f3:
      328     run gbl/prvssinf.p
      329       ( input this-procedure
      330       ) .
      331   end.
      332   define variable v-inform-launched as logical no-undo initial false .
      333   procedure proc-alt-shift-f4:
      334     define variable v-action as character no-undo .
      335     if v-inform-launched = false then do:
      336       assign
      337         v-inform-launched = true
      338       .
      339       run gbl/d-inform.w
      340         (  input self
      341         ,  input this-procedure
      342         , output v-action
      343         ) no-error .
      344       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      345       assign
      346         v-inform-launched = false
      347       .
      348     end.
      349   end.
      350   procedure proc-alt-f1:
      351     run gbl/corrhelp.p
      352       (input this-procedure
      353       ) .
      354   end .
      355   on alt-shift-f2 anywhere do:
      356     run proc-alt-shift-f2.
      357   end.
      358   on alt-shift-f3 anywhere do:
      359     run proc-alt-shift-f3 in this-procedure .
      360   end.
      361   on alt-shift-f4 anywhere do:
      362     run proc-alt-shift-f4 in this-procedure.
      363   end.
      364   on alt-f1 anywhere do:
      365     run proc-alt-f1 in this-procedure .
      366   end.
      367   DEFINE BUTTON B-exit AUTO-GO
      368        LABEL "&Ввод"
      369        SIZE 10 BY 1
      370        BGCOLOR 8 .
      371   DEFINE BUTTON B-Help
      372        LABEL "Помо&щь"
      373        SIZE 10 BY 1
      374        BGCOLOR 8 .
      375   DEFINE BUTTON b-quit AUTO-END-KEY
      376        LABEL "&Отмена"
      377        SIZE 10 BY 1
      378        BGCOLOR 8 .
      379   DEFINE VARIABLE e-dop-alt-name AS CHARACTER
      380        VIEW-AS EDITOR MAX-CHARS 40
      381        SIZE 60 BY 1 NO-UNDO.
      382   DEFINE FRAME Dialog-Frame
      383        B-exit AT ROW 1 COL 1
      384        b-quit AT ROW 1 COL 11
      385        B-Help AT ROW 1 COL 56
      386        e-dop-alt-name AT ROW 2.75 COL 3.5 NO-LABEL WIDGET-ID 12
      387        SPACE(2.62) SKIP(1.07)
      388       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      389            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      390            TITLE "Дополнение к альтернативному названию"
      391            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      392   ASSIGN
      393          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      394          FRAME Dialog-Frame:HIDDEN           = TRUE.
      395   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      396   DO:
      397     APPLY "END-ERROR":U TO SELF.
      398   END.
      399   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      400   DO:
      401   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      402   if lookup(self :type
      403            ,'BROWSE,FILL-IN,FRAME,BUTTON,RADIO-SET,COMBO-BOX,SELECTION-LIST,CONTROL-FRAME,SLIDER,DIALOG-BOX,TOGGLE-BOX,EDITOR,WINDOW'
      404            ) = 0
      405   then do:
      406     message
      407       "$Workfile$"
      408       "Указанному интерфейсному элементу фокус не может быть передан" skip
      409       "Интерфейсный элемент" self :name  skip
      410       "Тип" self :type  skip
      411       "Процедура" this-procedure :file-name skip
      412       view-as alert-box .
      413   end.
      414   else do:
      415     apply "entry":u to self  .
      416     if focus :handle <> self :handle  then do:
      417       return no-apply .
      418     end.
      419   end.
      420     assign
      421        e-dop-alt-name.
      422     run proc-go in this-procedure  no-error.
      423     if error-status:error then return no-apply.
      424   END.
      425   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      426   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      427   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      428   on help of frame Dialog-Frame
      429   do:
      430     run gbl/app_help.p
      431       (input this-procedure :file-name
      432       ,input ''
      433       ,input ?
      434       ) no-error.
      435     if error-status :error then do:
      436       message
      437         "Ошибка при вызове помощи"
      438         error-status :get-message(1)
      439         view-as alert-box .
      440     end.
      441   end.
      442   run minbtn-set in this-procedure .
      443   on choose of b-help in frame Dialog-Frame
      444   do:
      445     apply "help":u to frame Dialog-Frame .
      446   end.
      447   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      448   procedure minbtn-set :
      449       do
      450           on error undo, return error return-value
      451           :
      452           define variable ii              as integer       no-undo .
      453           define variable fh              as widget-handle no-undo .
      454           define variable hh              as widget-handle no-undo .
      455           define variable v-h             as handle        extent 4 no-undo .
      456           define variable v-name-button   as character     no-undo .
      457           define variable v-help-old-x    as decimal       no-undo .
      458           define variable v-help-old-y    as decimal       no-undo .
      459           define variable v-help-old-size as decimal       no-undo .
      460           define variable v-frame-width   as decimal       no-undo .
      461           define variable jj              as integer       no-undo .
      462           do
      463               on error undo, return error
      464               :
      465               assign
      466                   v-frame-width = frame Dialog-Frame:width - 0.3
      467                   fh            = frame Dialog-Frame:first-child
      468                   hh            = fh:first-child
      469                   ii            = 1
      470                   .
      471               do while valid-handle(hh):
      472                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      473                   do:
      474                       case lc(hh:name) :
      475                           when "b-help" then
      476                               do:
      477                                   hh:load-image-up("cmp/b-help.bmp":u) .
      478                                   hh:load-image-down("cmp/b-help.bmp":u) .
      479                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      480                                   hh:TOOLTIP = "Помощь" .
      481                                   v-help-old-x = hh:column .
      482                                   v-help-old-y = hh:row    .
      483                                   v-help-old-size = hh:width .
      484                                   hh:width-chars = 2.5 .
      485                               end.
      486                           when "b-print" then
      487                               do:
      488                                   hh:load-image("cmp/b-print.bmp":u) .
      489                                   hh:TOOLTIP = "Печать" .
      490                                   v-h[ii] = hh:handle .
      491                                   ii = ii + 1 .
      492                                   hh:width-chars = 3 .
      493                               end.
      494                           when "b-history" or
      495                           when "b-hist" then
      496                               do:
      497                                   hh:load-image("cmp/b-hist.bmp":u) .
      498                                   hh:TOOLTIP = "История" .
      499                                   v-h[ii] = hh:handle .
      500                                   ii = ii + 1 .
      501                                   hh:width-chars = 3 .
      502                               end.
      503                           when "b-sch" then
      504                               do:
      505                                   hh:load-image("cmp/b-sch.bmp":u) .
      506                                   hh:TOOLTIP = "Установка Фильтра" .
      507                                   v-h[ii] = hh:handle .
      508                                   ii = ii + 1 .
      509                                   hh:width-chars = 3 .
      510                               end.
      511                           when "b-hist-user" then
      512                               do:
      513                                   hh:load-image("cmp/b-hist.bmp":u) .
      514                                   hh:TOOLTIP = "История пользователя" .
      515                                   ii = ii + 1 .
      516                               end.
      517                       end case.
      518                   end.
      519                   hh = hh:next-sibling.
      520               end.
      521               b-help:column = v-frame-width - b-help:width-chars.
      522               jj = 0.
      523               repeat ii = 4 to 1 by -1 :
      524                   if valid-handle (v-h[ii] ) then
      525                   do:
      526                       jj  = jj + 1 .
      527                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      528                       v-h[ii]:row    = v-help-old-y .
      529                   end.
      530               end.
      531           end.
      532       end.
      533   end procedure.
      534   MAIN-BLOCK:
      535   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      536      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      537     find first buf_goods no-lock where
      538                    buf_goods.gds-code = p-gds-code no-error.
      539     RUN MYenable.
      540     WAIT-FOR GO OF FRAME Dialog-Frame.
      541   END.
      542   RUN disable_UI.
      543   PROCEDURE disable_UI :
      544     HIDE FRAME Dialog-Frame.
      545   END PROCEDURE.
      546   PROCEDURE enable_UI :
      547     DISPLAY e-dop-alt-name
      548         WITH FRAME Dialog-Frame.
      549     ENABLE B-exit b-quit B-Help e-dop-alt-name
      550         WITH FRAME Dialog-Frame.
      551     VIEW FRAME Dialog-Frame.
      552   END PROCEDURE.
      553   PROCEDURE MyeNABLe :
      554   IF AVAILABLE buf_goods then do:
      555   assign
      556   frame Dialog-Frame:title = frame Dialog-Frame:title + substitute(" код товара &1", p-gds-code).
      557   end.
      558     assign
      559     e-dop-alt-name = p-value .
      560     DISPLAY e-dop-alt-name
      561         WITH FRAME Dialog-Frame.
      562     ENABLE b-quit B-exit B-Help e-dop-alt-name
      563         WITH FRAME Dialog-Frame.
      564     VIEW FRAME Dialog-Frame.
      565   END PROCEDURE.
      566   PROCEDURE proc-go :
      567   assign
      568     p-value = e-dop-alt-name
      569     .
      570   END PROCEDURE.
