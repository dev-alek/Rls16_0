       20   DEFINE output PARAMETER p-value-logical-low AS logical NO-UNDO.
       21   DEFINE output PARAMETER p-value-logical-high AS logical NO-UNDO.
       22   DEFINE OUTPUT PARAMETER p-ok AS logical NO-UNDO.
       23   define variable vss-revision    as character no-undo init "$Revision$":U .
       24   define variable vss-author      as character no-undo init "$Author$":U .
       25   define variable vss-date        as character no-undo init "$Date$":U .
       26   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       27   define variable vss-archive     as character no-undo init "$Archive$":U .
       28   define variable vss-description as character no-undo init "Выбор объекта, среза, свойства ДК".
       29   procedure vss-get-info :
       30     define output parameter p-vss-revision    like vss-revision    no-undo .
       31     define output parameter p-vss-author      like vss-author      no-undo .
       32     define output parameter p-vss-date        like vss-date        no-undo .
       33     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       34     define output parameter p-vss-archive     like vss-archive     no-undo .
       35     define output parameter p-vss-description like vss-description no-undo .
       36     assign
       37       p-vss-revision    = vss-revision
       38       p-vss-author      = vss-author
       39       p-vss-date        = vss-date
       40       p-vss-workfile    = vss-workfile
       41       p-vss-archive     = vss-archive
       42       p-vss-description = vss-description
       43     .
       44   end procedure.
       45   procedure vss-get-parameters :
       46     define output parameter p-vss-parameters as character no-undo .
       47   end procedure.
       48   define new global shared variable g#vssrevis-logger as handle    no-undo .
       49   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       50   define variable v-vssrevis-logger                   as handle    no-undo .
       51   procedure vss-logevent :
       52     define input  parameter p-extra-paramters as character no-undo .
       53     define variable v-vssrevis-parameters as character no-undo .
       54     do
       55     on error undo, return error return-value
       56     :
       57       if  valid-handle(v-vssrevis-logger)
       58       and v-vssrevis-logger :get-signature("logevent") <> ""
       59       then do:
       60         run vss-get-parameters in this-procedure
       61           (output v-vssrevis-parameters
       62           ).
       63         run logevent in v-vssrevis-logger
       64           (input vss-workfile
       65           ,input vss-revision
       66           ,input v-vssrevis-parameters
       67           ,input p-extra-paramters
       68           ).
       69       end.
       70     end.
       71   end procedure.
       72   assign
       73     v-vssrevis-logger = g#vssrevis-logger
       74   .
       75   if  valid-handle(v-vssrevis-logger)
       76   and v-vssrevis-logger :get-signature("logevent") <> ""
       77   then do:
       78     assign
       79       v-vssrevis-logevent = true
       80     .
       81     run vss-logevent in this-procedure (input vss-description) .
       82   end.
       83   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       84   define variable v-waitfram-action01         as character   no-undo .
       85   define variable v-waitfram-action02         as character   no-undo .
       86   define variable v-waitfram-action03         as character   no-undo .
       87   define variable mWaitFramTextBeg            as character   no-undo.
       88   define variable mWaitFramTextEnd            as character   no-undo.
       89   define variable mWaitFramView               as logical     no-undo.
       90   define variable mWaitProcEvent              as logical     no-undo init yes.
       91   define variable mWaitFramInterval           as integer     no-undo init 1 .
       92   define variable mWaitFramStop               as logical     no-undo.
       93   define variable mWaitFramStopUser           as logical     no-undo.
       94   define variable mWaitFramStopTimeOut        as logical     no-undo.
       95   define variable mWaitFramStartProc          as datetime-tz no-undo.
       96   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       97   define button B-WaitFramStop auto-end-key
       98        label "Стоп"
       99        size 10 by 1 tooltip "Остоновить процесс".
      100   define button B-viewProcInfo
      101        label "Информация"
      102        size 15 by 1 tooltip "Информация о процесс".
      103   define frame waitfram
      104     v-waitfram-action01 format "x(72)" no-label skip
      105     v-waitfram-action02 format "x(72)" no-label skip
      106     v-waitfram-action03 format "x(72)" no-label skip
      107     B-viewProcInfo
      108     B-WaitFramStop at row 4 col 30
      109     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      110     .
      111   define new global shared variable mBatchMode as logical no-undo init ?.
      112   define variable mFramBachModHandle as handle no-undo.
      113   mFramBachModHandle = frame waitfram:handle.
      114   define variable mFameOldVis as logical no-undo.
      115   define variable mVisCUrentVin as logical no-undo.
      116   if session:batch-mode
      117   then
      118      mBatchMode = yes.
      119   if mBatchMode = ? then do:
      120     mVisCUrentVin = current-window:visible.
      121     mFameOldVis = mFramBachModHandle:visible.
      122     mFramBachModHandle:visible  = yes.
      123     mBatchMode = mFramBachModHandle:visible ne yes.
      124     mFramBachModHandle:visible = mFameOldVis.
      125     current-window:visible = mVisCUrentVin.
      126   end.
      127    if  log-manager:logfile-name ne ?
      128     then DO:
      129         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      130         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      131         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      132     end.
      133   on choose of B-WaitFramStop in frame waitfram
      134   do:
      135     mWaitFramStop = yes.
      136     mWaitFramStopUser = yes.
      137   end.
      138   function waitfram-check-timeout returns logical():
      139      define variable vtime as int64 no-undo.
      140      if mWaitFramStopTimeOut
      141      then
      142         return yes.
      143      vtime = ( now - mWaitFramStartProc ) / 1000 .
      144      if     mWaitFramTimeOut ne ?
      145         and mWaitFramTimeOut ne 0
      146         and mWaitFramTimeOut lt vtime
      147      then do:
      148         mWaitFramStopTimeOut = yes.
      149      end.
      150      return mWaitFramStopTimeOut.
      151   end.
      152   procedure waitfram-hide :
      153     if not session:batch-mode
      154     then do
      155     on error undo, return error return-value
      156     :
      157       pause 0 before-hide .
      158       if not mBatchMode then
      159         hide frame waitfram .
      160     if     not mWaitFramView
      161        and mWaitProcEvent
      162     then
      163       process events .
      164     end.
      165   end procedure.
      166   procedure waitfram-show :
      167     define input  parameter p-message as character no-undo .
      168     define variable v-left-margin as integer   no-undo .
      169     if not session:batch-mode
      170     then do
      171     on error undo, return error return-value
      172     :
      173       if length(p-message) <= 70 then do:
      174         assign
      175           v-left-margin = integer((70 - length(p-message)) / 2)
      176         .
      177         assign
      178           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      179         .
      180         assign
      181           v-waitfram-action01 = " "
      182           v-waitfram-action02 = " "
      183                                    + fill(" ", v-left-margin)
      184                                    + p-message
      185           v-waitfram-action03 = " "
      186         .
      187       end.
      188       else do:
      189         define variable vRindex1 as integer no-undo.
      190         define variable vRindex2 as integer no-undo.
      191         vRindex1 = r-index(p-message," ",70).
      192         if vRindex1 = 0
      193         then
      194            vRindex1 = 70.
      195         if length(p-message)  <= vRindex1 + 70 then do:
      196           assign
      197             v-waitfram-action01 = " "
      198             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      199             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      200           .
      201         end.
      202         else do:
      203           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      204           if vRindex2 <= vRindex1
      205           then
      206              vRindex2 = vRindex1 + 70.
      207           assign
      208             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      209             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      210             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      211           .
      212         end.
      213       end.
      214       B-viewProcInfo:visible   in frame waitfram = no.
      215       B-viewProcInfo:sensitive in frame waitfram = no.
      216       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      217       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      218       if  (   mWaitFramView
      219          or  mWaitProcEvent)
      220          and not mBatchMode
      221       then
      222          display
      223             v-waitfram-action01 skip
      224             v-waitfram-action02 skip
      225             v-waitfram-action03 skip
      226          with frame waitfram .
      227       if     mWaitFramView
      228          then do:
      229             if     mWaitFramInterval ne ?
      230                and not mBatchMode
      231             then
      232                wait-for go of frame waitfram pause mWaitFramInterval.
      233          end.
      234          else
      235             if     mWaitProcEvent
      236                and not mBatchMode
      237             then
      238                process events .
      239     end.
      240   end procedure.
      241      procedure waitfram-show-this:
      242         define input  parameter iInterval as int64 no-undo.
      243         define variable vtime as int64 no-undo.
      244         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      245         mWaitFramInterval = iInterval.
      246         run waitfram-show (substitute("&1&2 &3&4" ,
      247                                       mWaitFramTextBeg ,
      248                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      249                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      250                                       mWaitFramTextEnd
      251                                      )
      252                           ).
      253      end.
      254      procedure WaitFramRunPause:
      255         define input  parameter iInterval as dec no-undo.
      256         define variable vStart  as datetime-tz no-undo.
      257         define variable vend    as datetime-tz no-undo.
      258         define variable vint as int64 no-undo.
      259         define variable vOk as logical no-undo.
      260         vStart = now.
      261         vend   = vStart.
      262         publish "WaitFramPause" (iInterval,output vOk).
      263         vend   =  now.
      264         vint = vend - vStart.
      265         vint = iInterval - vint / 1000.
      266         if     not mWaitFramStop
      267            and (   vint > 0
      268                 or (    not vOk
      269                     and iInterval eq ?
      270                     )
      271                 )
      272         then
      273            run waitfram-show-this (iInterval).
      274         vend   =  now.
      275         vint = vend - vStart.
      276         vint = iInterval - vint / 1000.
      277         if     not mWaitFramStop
      278            and vint > 0
      279         then do:
      280            run gbl/pause.p (vint * 1000).
      281         end.
      282         if iInterval ne ?
      283         then
      284            publish "WaitFramStop".
      285         waitfram-check-timeout().
      286      end.
      287      procedure WaitFramWaitFor:
      288         define input  parameter iInterval as dec no-undo.
      289         assign
      290            mWaitFramStartProc   = now
      291            mWaitFramStopUser    = no
      292            mWaitFramStopTimeOut = no
      293         .
      294         block-wait:
      295         do while not mWaitFramStop:
      296            run WaitFramRunPause (iInterval).
      297            if  waitfram-check-timeout()
      298            then do:
      299               leave block-wait.
      300            end.
      301         end.
      302         run waitfram-hide.
      303      end.
      304   procedure waitfram-join :
      305     define input  parameter p-line-1  as character no-undo .
      306     define input  parameter p-line-2  as character no-undo .
      307     define input  parameter p-line-3  as character no-undo .
      308     define output parameter p-message as character no-undo .
      309     do
      310     on error undo, return error return-value
      311     :
      312       assign
      313         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      314                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      315                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      316       .
      317     end.
      318   end procedure.
      319   function waitfram-join-function returns character
      320     (input p-line-1 as character
      321     ,input p-line-2 as character
      322     ,input p-line-3 as character
      323     ).
      324     define variable v-message as character no-undo .
      325     run waitfram-join in this-procedure
      326       (input  p-line-1
      327       ,input  p-line-2
      328       ,input  p-line-3
      329       ,output v-message
      330       ) .
      331     return v-message .
      332   end function .
      333   define new global shared variable g#language as character no-undo .
      334   if g#language <> '' and g#language <> 'rus':U then do:
      335     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      336   end.
      337   define new global shared variable g#library  as handle no-undo .
      338   define new global shared variable g#library2 as handle no-undo .
      339   procedure proc-alt-shift-f2:
      340     if not ibs.th.gbl.gbl-var:rcode
      341   then
      342     run gbl\inidebug.p .
      343   end.
      344   procedure proc-alt-shift-f3:
