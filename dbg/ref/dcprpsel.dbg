        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input parameter p-curr-host-code as integer no-undo .
        3   define input parameter p-curr-obj-type as character no-undo .
        4   define input parameter p-curr-obj-code as integer no-undo .
        5   define input-output parameter p-dtm-code as integer no-undo .
        6   define input-output parameter p-dt-code as integer no-undo .
        7   define input-output parameter p-node-code as integer no-undo .
        8   define INPUT-OUTPUT parameter p-host-code like ub.sysconf.host-code no-undo .
        9   define INPUT-OUTPUT parameter p-obj-type like ub.clients.obj-type no-undo .
       10   define INPUT-OUTPUT parameter p-obj-code like ub.clients.obj-code no-undo .
       11   define INPUT-OUTPUT parameter p-cond as character no-undo .
       12   DEFINE output PARAMETER p-value-character-low AS CHARACTER NO-UNDO.
       13   DEFINE output PARAMETER p-value-character-high AS CHARACTER NO-UNDO.
       14   DEFINE output PARAMETER p-value-date-low AS date NO-UNDO.
