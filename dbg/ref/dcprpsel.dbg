      352     if v-inform-launched = false then do:
      353       assign
      354         v-inform-launched = true
      355       .
      356       run gbl/d-inform.w
      357         (  input self
      358         ,  input this-procedure
      359         , output v-action
      360         ) no-error .
      361       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      362       assign
      363         v-inform-launched = false
      364       .
      365     end.
      366   end.
      367   procedure proc-alt-f1:
