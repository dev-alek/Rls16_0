      393   function diff-list returns character (
      394     input parfirst-list  as character,
      395     input parsecond-list as character,
      396     input pardelim       as character).
      397     if pardelim = ""
      398     or pardelim = ?
      399     then do:
      400       assign
      401         pardelim = ","
      402       .
      403     end.
      404     def var ind as integer no-undo .
      405     def var v-elem as character no-undo .
      406     def var v-result-list as character no-undo init "".
      407     def var v-num-parfirst-list as integer no-undo .
      408     assign
      409       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      410     .
      411     do ind = 1 to v-num-parfirst-list
      412     :
      413       assign
      414         v-elem = entry(ind, parfirst-list, pardelim)
      415       .
      416       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      417         assign
      418           v-result-list = v-result-list
      419                         + (if v-result-list > "" then pardelim else "")
      420                         + v-elem
      421         .
      422       end.
      423     end.
      424     return v-result-list .
      425   end function.
      426   function add-list returns character (
      427    input parfirst-list  as character,
      428    input parsecond-list as character,
      429    input pardelim       as character).
      430     if pardelim = ""
      431     or pardelim = ?
      432     then do:
      433       assign
      434         pardelim = ","
      435       .
      436     end.
      437     def var ind as integer no-undo .
      438     def var v-elem as character no-undo .
      439     def var v-result-list as character no-undo init "".
      440     def var v-num-parfirst-list as integer no-undo .
      441     assign
      442       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      443     .
      444     do ind = 1 to v-num-parfirst-list
      445     :
      446       assign
      447         v-elem = entry(ind, parfirst-list, pardelim)
      448       .
      449       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      450         assign
      451           v-result-list = v-result-list
      452                         + (if v-result-list > "" then pardelim else "")
      453                         + v-elem
      454         .
      455       end.
      456     end.
      457     def var v-num-parsecond-list as integer no-undo .
      458     assign
      459       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      460     .
      461     do ind = 1 to v-num-parsecond-list
      462     :
      463       assign
      464         v-elem = entry(ind, parsecond-list, pardelim)
      465       .
      466       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      467         assign
      468           v-result-list = v-result-list
      469                         + (if v-result-list > "" then pardelim else "")
      470                         + v-elem
      471         .
      472       end.
      473     end.
      474     return v-result-list .
      475   end function.
      476   function cross-list returns character (
      477    input parfirst-list  as character,
      478    input parsecond-list as character,
      479    input pardelim       as character).
      480     if pardelim = ""
      481     or pardelim = ?
      482     then do:
      483       assign
      484         pardelim = ","
      485       .
      486     end.
      487     def var ind as integer no-undo .
      488     def var v-elem as character no-undo .
      489     def var v-result-list as character no-undo init "".
      490     def var v-num-parfirst-list as integer no-undo .
      491     assign
      492       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      493     .
      494     do ind = 1 to v-num-parfirst-list
      495     :
      496       assign
      497         v-elem = entry(ind, parfirst-list, pardelim)
      498       .
      499       if lookup(v-elem, v-result-list, pardelim) = 0
      500       and lookup(v-elem, parsecond-list, pardelim) > 0
      501       then do:
      502         assign
      503           v-result-list = v-result-list
      504                         + (if v-result-list > "" then pardelim else "")
      505                         + v-elem
      506         .
      507       end.
      508     end.
      509     return v-result-list .
      510   end function.
      511   function radio-label returns character (
      512    input par-rs-value  as character,
      513    input par-rs-radio-buttons as character)
      514    .
      515    DEFINE variable v-result-label as character no-undo.
      516    assign
      517    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      518                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      519                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      520                             ), par-rs-radio-buttons
      521                           )
      522    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      523    .
      524   return v-result-label.
      525   end function.
      526   function m-radio-label returns character (
      527    input par-rs-value  as character,
      528    input par-rs-radio-buttons as character,
      529    input par-delim as character
      530    )
      531    .
      532    DEFINE variable v-result-label as character no-undo.
      533    assign
      534    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      535                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      536                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      537                             ), par-rs-radio-buttons, par-delim
      538                           )
      539    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      540    .
      541   return v-result-label.
      542   end function.
      543   FUNCTION mixlist returns character
      544   (
      545    input parfirst-list  as character
      546    ,input parsecond-list as character
      547    ,input pardelim       as character
      548    ,input pardelim-result as character ) :
      549     if pardelim = ""
      550     or pardelim = ?
      551     then do:
      552       assign
      553         pardelim = ","
      554       .
      555     end.
      556     def var ind as integer no-undo .
      557     def var v-elem1 as character no-undo .
      558     def var v-elem2 as character no-undo .
      559     def var v-result-list as character no-undo init "".
      560     do ind = 1 to num-entries(parfirst-list, pardelim)
      561     :
      562       assign
      563         v-elem1 = entry(ind, parfirst-list, pardelim)
      564         v-elem2 = entry(ind, parsecond-list, pardelim)
      565       .
      566         assign
      567           v-result-list = v-result-list
      568                         + (if v-result-list > "" then pardelim-result else "")
      569                         + v-elem1 + pardelim-result + v-elem2
      570         .
      571     end.
      572     return v-result-list .
      573   END FUNCTION.
      574   DEFINE VARIABLE v-doc-rec AS RECID NO-UNDO.
      575   DEFINE VARIABLE link-option AS CHARACTER NO-UNDO.
      576   define variable v-short-mode as logical no-undo .
      577   DEFINE BUFFER buf_prop-head FOR ub.prop-head.
      578   DEFINE BUFFER buf_prop-ref FOR ub.prop-ref.
      579   define buffer buf_prop-map for ub.prop-map .
      580   DEFINE BUTTON b-dt-code
      581        IMAGE-UP FILE "btn-down-arrow":U
      582        IMAGE-DOWN FILE "btn-down-arrow":U
      583        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      584        LABEL "Btn 3"
      585        SIZE 3 BY 1.
      586   DEFINE BUTTON b-dtm-code
      587        IMAGE-UP FILE "btn-down-arrow":U
      588        IMAGE-DOWN FILE "btn-down-arrow":U
      589        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      590        LABEL "Btn 3"
      591        SIZE 3 BY 1.
      592   DEFINE BUTTON b-exit AUTO-GO
      593        LABEL "&Ввод"
      594        SIZE 10 BY 1.
      595   DEFINE BUTTON B-Help
      596        LABEL "Помо&щь"
      597        SIZE 3 BY 1
      598        BGCOLOR 8 .
      599   DEFINE BUTTON B-host
      600        IMAGE-UP FILE "btn-down-arrow":U
      601        IMAGE-DOWN FILE "btn-down-arrow":U
      602        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      603        LABEL "Btn 1"
      604        SIZE 3 BY 1.
      605   DEFINE BUTTON b-node-code
      606        IMAGE-UP FILE "btn-down-arrow":U
      607        IMAGE-DOWN FILE "btn-down-arrow":U
      608        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      609        LABEL "Btn 3"
      610        SIZE 3 BY 1.
      611   DEFINE BUTTON B-obj
      612        IMAGE-UP FILE "btn-down-arrow":U
      613        IMAGE-DOWN FILE "btn-down-arrow":U
      614        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      615        LABEL "Btn 1"
      616        SIZE 3 BY 1.
      617   DEFINE BUTTON b-quit AUTO-END-KEY
      618        LABEL "&Отмена"
      619        SIZE 10 BY 1
      620        BGCOLOR 8 .
      621   DEFINE VARIABLE CB-obj-type AS CHARACTER FORMAT "X(256)":U
      622        VIEW-AS COMBO-BOX INNER-LINES 3
      623        LIST-ITEMS "","Item 1","Item 2"
      624        DROP-DOWN-LIST
      625        SIZE 11 BY 1
      626        BGCOLOR 8  NO-UNDO.
      627   DEFINE VARIABLE f-dt-code AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      628        LABEL "Код среза"
      629        VIEW-AS FILL-IN NATIVE
      630        SIZE 8.5 BY 1 NO-UNDO.
      631   DEFINE VARIABLE f-dtm-code AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      632        LABEL "Код объ-та"
      633        VIEW-AS FILL-IN NATIVE
      634        SIZE 8.5 BY 1 NO-UNDO.
      635   DEFINE VARIABLE f-dtm-name AS CHARACTER FORMAT "X(256)":U
      636        VIEW-AS FILL-IN NATIVE
      637        SIZE 72.5 BY 1
      638        FGCOLOR 4  NO-UNDO.
      639   DEFINE VARIABLE f-high-character AS CHARACTER FORMAT "X(256)":U
      640        LABEL "Верхняя граница"
      641        VIEW-AS FILL-IN
      642        SIZE 27.5 BY 1
      643        FGCOLOR 4  NO-UNDO.
      644   DEFINE VARIABLE f-high-date AS DATE FORMAT "99/99/9999":U INITIAL ?
      645        LABEL "Верхняя граница"
      646        VIEW-AS FILL-IN
      647        SIZE 27.5 BY 1
      648        FGCOLOR 4  NO-UNDO.
      649   DEFINE VARIABLE f-high-decimal AS DECIMAL FORMAT "->>>,>>>,>>>,>>9.99":U INITIAL 0
      650        LABEL "Верхняя граница"
      651        VIEW-AS FILL-IN
      652        SIZE 27.5 BY 1
      653        FGCOLOR 4  NO-UNDO.
      654   DEFINE VARIABLE f-high-integer AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      655        LABEL "Верхняя граница"
      656        VIEW-AS FILL-IN
      657        SIZE 27.5 BY 1
      658        FGCOLOR 4  NO-UNDO.
      659   DEFINE VARIABLE f-host-code AS INTEGER FORMAT ">>>>9":U INITIAL 0
      660        LABEL "Фирма"
      661        VIEW-AS FILL-IN
      662        SIZE 7 BY 1
      663        BGCOLOR 8  NO-UNDO.
      664   DEFINE VARIABLE F-host-name AS CHARACTER FORMAT "X(256)":U
      665         VIEW-AS TEXT
      666        SIZE 56.5 BY .67
      667        FGCOLOR 1  NO-UNDO.
      668   DEFINE VARIABLE f-low-character AS CHARACTER FORMAT "X(256)":U
      669        LABEL "Нижняя граница"
      670        VIEW-AS FILL-IN
      671        SIZE 27.5 BY 1
      672        FGCOLOR 4  NO-UNDO.
      673   DEFINE VARIABLE f-low-date AS DATE FORMAT "99/99/9999":U INITIAL ?
      674        LABEL "Нижняя граница"
      675        VIEW-AS FILL-IN
      676        SIZE 27.5 BY 1
      677        FGCOLOR 4  NO-UNDO.
      678   DEFINE VARIABLE f-low-decimal AS DECIMAL FORMAT "->>>,>>>,>>>,>>9.99":U INITIAL 0
      679        LABEL "Нижняя граница"
      680        VIEW-AS FILL-IN
      681        SIZE 27.5 BY 1
      682        FGCOLOR 4  NO-UNDO.
      683   DEFINE VARIABLE f-low-integer AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      684        LABEL "Нижняя граница"
      685        VIEW-AS FILL-IN
      686        SIZE 27.5 BY 1
      687        FGCOLOR 4  NO-UNDO.
      688   DEFINE VARIABLE f-node-code AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      689        LABEL "Код св-ва"
      690        VIEW-AS FILL-IN NATIVE
      691        SIZE 8.5 BY 1 NO-UNDO.
      692   DEFINE VARIABLE f-node-label AS CHARACTER FORMAT "X(256)":U
      693        VIEW-AS FILL-IN NATIVE
      694        SIZE 72.5 BY 1
      695        FGCOLOR 4  NO-UNDO.
      696   DEFINE VARIABLE f-obj-code AS INTEGER FORMAT ">>>>9":U INITIAL 0
      697        VIEW-AS FILL-IN
      698        SIZE 7 BY 1
      699        BGCOLOR 8  NO-UNDO.
      700   DEFINE VARIABLE F-obj-name AS CHARACTER FORMAT "X(256)":U
      701         VIEW-AS TEXT
      702        SIZE 56.5 BY .67
      703        FGCOLOR 1  NO-UNDO.
      704   DEFINE VARIABLE f-sum-id AS CHARACTER FORMAT "X(256)":U
      705        VIEW-AS FILL-IN NATIVE
      706        SIZE 31.5 BY 1
      707        FGCOLOR 4  NO-UNDO.
      708   DEFINE VARIABLE rs-cond AS CHARACTER INITIAL ">"
      709        VIEW-AS RADIO-SET HORIZONTAL
      710        RADIO-BUTTONS
      711             "=", "=",
      712   ">", ">",
      713   "<", "<",
      714   ">=", ">=",
      715   "<=", "<="
      716        SIZE 30.5 BY 1 NO-UNDO.
      717   DEFINE VARIABLE RS-range AS CHARACTER
      718        VIEW-AS RADIO-SET HORIZONTAL
      719        RADIO-BUTTONS
      720             "Глобально", "global",
      721   "Фирма", "firm",
      722   "Объект", "object"
      723        SIZE 36 BY 1 NO-UNDO.
      724   DEFINE VARIABLE f-high-logical AS LOGICAL INITIAL no
      725        LABEL "Верхняя граница"
      726        VIEW-AS TOGGLE-BOX
      727        SIZE 27.5 BY 1 NO-UNDO.
      728   DEFINE VARIABLE f-low-logical AS LOGICAL INITIAL no
      729        LABEL "Нижняя граница"
      730        VIEW-AS TOGGLE-BOX
      731        SIZE 27.5 BY 1 NO-UNDO.
      732   DEFINE FRAME Dialog-Frame
      733        b-exit AT ROW 1 COL 1 WIDGET-ID 76
      734        b-quit AT ROW 1 COL 11
      735        B-Help AT ROW 1 COL 95
      736        f-dtm-code AT ROW 2.6 COL 1.5 WIDGET-ID 34
      737        b-dtm-code AT ROW 2.6 COL 22 WIDGET-ID 32
      738        f-dtm-name AT ROW 2.6 COL 25 NO-LABEL WIDGET-ID 30
      739        f-dt-code AT ROW 3.6 COL 2.5 WIDGET-ID 36
      740        b-dt-code AT ROW 3.6 COL 22 WIDGET-ID 38
      741        f-sum-id AT ROW 3.6 COL 25 NO-LABEL WIDGET-ID 40
      742        f-node-code AT ROW 4.6 COL 2.5 WIDGET-ID 44
      743        b-node-code AT ROW 4.6 COL 22 WIDGET-ID 42
      744        f-node-label AT ROW 4.6 COL 25 NO-LABEL WIDGET-ID 46
      745        RS-range AT ROW 6.33 COL 25.5 NO-LABEL WIDGET-ID 58
      746        f-host-code AT ROW 7.67 COL 12 COLON-ALIGNED WIDGET-ID 54
      747        B-host AT ROW 7.67 COL 22 WIDGET-ID 48
      748        CB-obj-type AT ROW 9.17 COL 1.5 NO-LABEL WIDGET-ID 52
      749        f-obj-code AT ROW 9.17 COL 12 COLON-ALIGNED NO-LABEL WIDGET-ID 56
      750        B-obj AT ROW 9.17 COL 22 WIDGET-ID 50
      751        f-low-decimal AT ROW 10.6 COL 19.5 COLON-ALIGNED WIDGET-ID 68
      752        f-low-logical AT ROW 10.6 COL 21.5 WIDGET-ID 90
      753        f-low-date AT ROW 10.6 COL 19.5 COLON-ALIGNED WIDGET-ID 86
      754        f-low-integer AT ROW 10.6 COL 19.5 COLON-ALIGNED WIDGET-ID 80
      755        f-low-character AT ROW 10.6 COL 19.5 COLON-ALIGNED WIDGET-ID 82
      756        f-high-logical AT ROW 12.47 COL 21.5 WIDGET-ID 92
      757        f-high-integer AT ROW 12.6 COL 19.5 COLON-ALIGNED WIDGET-ID 78
      758        f-high-character AT ROW 12.6 COL 19.5 COLON-ALIGNED WIDGET-ID 84
      759        f-high-date AT ROW 12.6 COL 19.5 COLON-ALIGNED WIDGET-ID 88
      760        f-high-decimal AT ROW 12.6 COL 19.5 COLON-ALIGNED WIDGET-ID 66
      761        rs-cond AT ROW 14.33 COL 21.5 NO-LABEL WIDGET-ID 70
      762        F-host-name AT ROW 7.67 COL 24 COLON-ALIGNED NO-LABEL WIDGET-ID 62
      763        F-obj-name AT ROW 9.17 COL 24 COLON-ALIGNED NO-LABEL WIDGET-ID 64
      764        SPACE(15.99) SKIP(7.38)
      765       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      766            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      767            TITLE "Выбор свойств ДК"
      768            CANCEL-BUTTON b-quit.
      769   ASSIGN
      770          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      771          FRAME Dialog-Frame:HIDDEN           = TRUE.
      772   ASSIGN
      773          f-high-character:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      774   ASSIGN
      775          f-high-date:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      776   ASSIGN
      777          f-high-decimal:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      778   ASSIGN
      779          f-high-integer:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      780   ASSIGN
      781          f-host-code:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      782   ASSIGN
      783          f-low-character:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      784   ASSIGN
      785          f-low-date:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      786   ASSIGN
      787          f-low-decimal:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      788   ASSIGN
      789          f-low-integer:HIDDEN IN FRAME Dialog-Frame           = TRUE.
      790   ASSIGN
      791          f-obj-code:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
      792   ON GO OF FRAME Dialog-Frame
      793   DO:
      794     assign
      795     p-dtm-code  = f-dtm-code
      796     p-dt-code   = f-dt-code
      797     p-node-code = f-node-code
      798     p-host-code = f-host-code
      799     p-obj-type  = cb-obj-type
      800     p-obj-code  = f-obj-code
      801     p-value-character-low = f-low-character
      802     p-value-character-high = f-high-character
      803     p-value-date-low = f-low-date
      804     p-value-date-high = f-high-date
      805     p-value-decimal-low = f-low-decimal
      806     p-value-decimal-high = f-high-decimal
      807     p-value-integer-low = f-low-integer
      808     p-value-integer-high = f-high-integer
      809     p-value-logical-low = f-low-logical
      810     p-value-logical-high = f-high-logical
      811     p-cond = rs-cond
      812     p-ok = YES
      813     .
      814   END.
      815   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      816   DO:
      817     APPLY "END-ERROR":U TO SELF.
      818   END.
      819   ON CHOOSE OF b-dt-code IN FRAME Dialog-Frame
      820   DO:
      821   DEFINE variable v-ref-list AS CHARACTER NO-UNDO.
      822   DEFINE BUFFER buf_prop-ref FOR ub.prop-ref.
      823   if f-dtm-code = ?
      824   or f-dtm-code = 0
      825   then do:
      826     message
      827     "Не выбран объект-операнд"
      828     view-as alert-box error .
      829     undo, return no-apply.
      830   end.
      831   run ref/proprefs.w (
      832                   input parparentproc
      833                 ,input 'b-sel'
      834                 ,input (if f-dtm-code = ?
      835                         then 'dis-card-property':U
      836                         else "dtm-code")
      837                 ,input (if f-dtm-code = ? then 0 else f-dtm-code)
      838                 ,input '':U
      839                 ,input '':U
      840                 ,input-output  v-ref-list) no-error.
      841   if error-status:error or v-ref-list = '':u then do:
      842     assign
      843     f-dt-code = ?
      844     f-sum-id = '':U.
      845     DISPLAY
      846     f-sum-id
      847     f-dt-code
      848     WITH FRAME Dialog-Frame.
      849     return.
      850   end.
      851   find first buf_prop-ref no-lock where
      852             recid(buf_prop-ref) = integer(v-ref-list) no-error.
      853   if not available buf_prop-ref then return.
      854   if buf_prop-ref.dt-code = f-dt-code then return no-apply.
      855   ASSIGN
      856   f-dt-code = buf_prop-ref.dt-code
      857   f-sum-id = buf_prop-ref.sum-id.
      858   DISPLAY
      859   f-sum-id
      860   f-dt-code
      861   WITH FRAME Dialog-Frame.
      862   END.
      863   ON CHOOSE OF b-dtm-code IN FRAME Dialog-Frame
      864   DO:
      865   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      866   DEFINE BUFFER buf_prop-head FOR ub.prop-head.
      867    run rul/prop-head-s.w ( INPUT parparentproc
      868                            ,INPUT "b-sel"
      869                            ,input "general-view"
      870                            ,input 'dc-prop':U
      871                            ,input-output v-rid-list ) NO-ERROR.
      872    IF ERROR-STATUS:error OR v-rid-list = '':U THEN DO:
      873       UNDO, RETURN NO-APPLY.
      874    END.
      875    FIND FIRST buf_prop-head NO-LOCK WHERE
      876              recid(buf_prop-head) = INTEGER(v-rid-list) NO-ERROR.
      877    IF NOT AVAILABLE buf_prop-head  THEN DO:
      878       assign
      879       f-dt-code = ?
      880       f-sum-id = '':U
      881       f-dtm-code = ?
      882       f-dtm-name = '':U
      883       f-node-code = ?
      884       f-node-label = '':U
      885       .
      886       DISABLE
      887       b-node-code
      888       WITH FRAME Dialog-Frame.
      889       DISPLAY
      890       f-sum-id
      891       f-dtm-code
      892       f-dtm-name
      893       f-dt-code
      894       f-node-code
      895       f-node-label
      896       WITH FRAME Dialog-Frame.
      897      RETURN.
      898    END.
      899    if buf_prop-head.dtm-code = f-dtm-code then return no-apply.
      900    assign
      901    f-dtm-code = buf_prop-head.dtm-code
      902    f-dtm-name = buf_prop-head.prop-label
      903    .
      904    display
      905    f-dtm-code
      906    f-dtm-name
      907    with frame Dialog-Frame .
      908    ENABLE
      909    b-node-code
      910    WITH FRAME Dialog-Frame.
      911    RUN enable-disable-rs-range IN THIS-PROCEDURE.
      912   END.
      913   ON CHOOSE OF B-host IN FRAME Dialog-Frame
      914   DO:
      915     IF f-dtm-code = ?
      916     OR f-dtm-code = 0 THEN DO:
      917       MESSAGE
      918       "Не выбран объект-операнд"
      919       VIEW-AS ALERT-BOX ERROR.
      920       UNDO, RETURN NO-APPLY.
      921     END.
      922     run proc-b-host IN THIS-PROCEDURE NO-ERROR.
      923     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      924   END.
      925   ON CHOOSE OF b-node-code IN FRAME Dialog-Frame
      926   DO:
      927   DEFINE variable v-ref-list AS CHARACTER NO-UNDO.
      928   DEFINE BUFFER buf_prop-map FOR ub.prop-map.
      929   IF f-dtm-code = ?
      930   OR f-dtm-code = 0  THEN DO:
      931     MESSAGE
      932     "Не выбран объект-операнд"
      933     VIEW-AS ALERT-BOX ERROR.
      934     UNDO, RETURN NO-APPLY.
      935   END.
      936   run rul/prop-map-s.w (
      937                   input parparentproc
      938                 ,input 'b-sel'
      939                 ,input "dtm-code"
      940                 ,input f-dtm-code
      941                 ,input-output  v-ref-list) no-error.
      942   if error-status:error or v-ref-list = '':u then do:
      943     assign
      944     f-node-code = ?
      945     f-node-label = '':U.
      946     DISPLAY
      947     f-node-code
      948     f-node-label
      949     WITH FRAME Dialog-Frame.
      950     return.
      951   end.
      952   find first buf_prop-map no-lock where
      953             recid(buf_prop-map) = integer(v-ref-list) no-error.
      954   if not available buf_prop-map then return.
      955   if buf_prop-map.dtm-code = f-dtm-code
      956   AND buf_prop-map.node-code = f-node-code then return no-apply.
      957   ASSIGN
      958   f-node-code = buf_prop-map.node-code
      959   f-node-label = buf_prop-map.node-label.
      960   DISPLAY
      961   f-node-code
      962   f-node-label
      963   WITH FRAME Dialog-Frame.
      964   END.
      965   ON CHOOSE OF B-obj IN FRAME Dialog-Frame
      966   DO:
      967   IF f-dtm-code = ?
      968   OR f-dtm-code = 0 THEN DO:
      969     MESSAGE
      970     "Не выбран объект-операнд"
      971     VIEW-AS ALERT-BOX ERROR.
      972     UNDO, RETURN NO-APPLY.
      973   END.
      974     run proc-b-obj IN THIS-PROCEDURE NO-ERROR.
      975     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      976   END.
      977   ON VALUE-CHANGED OF RS-range IN FRAME Dialog-Frame
      978   DO:
      979     ASSIGN
      980     rs-range.
      981     CASE rs-range:
      982         WHEN "GLOBAL":U THEN DO:
      983            ASSIGN
      984            f-host-code = 0
      985            f-host-name = '':U
      986            cb-obj-type = '':U
      987            f-obj-code = 0
      988            f-obj-name = '':U
      989            .
      990            DISABLE
      991            b-host
      992            b-obj
      993            WITH FRAME Dialog-Frame.
      994            DISPLAY
      995            f-host-code
      996            f-host-name
      997            cb-obj-type
      998            f-obj-code
      999            f-obj-name
     1000            WITH FRAME Dialog-Frame.
     1001         END.
     1002         WHEN 'фирма':U THEN DO:
     1003             ASSIGN
     1004             cb-obj-type = '':U
     1005             f-obj-code = 0
     1006             f-obj-name = '':U.
     1007             DISABLE
     1008             b-obj
     1009             WITH FRAME Dialog-Frame.
     1010             DISPLAY
     1011             f-host-code
     1012             f-host-name
     1013             cb-obj-type
     1014             f-obj-code
     1015             f-obj-name
     1016             WITH FRAME Dialog-Frame.
     1017             ENABLE
     1018             b-host
     1019             WITH FRAME Dialog-Frame.
     1020         END.
     1021         WHEN 'объект':U THEN DO:
     1022             ASSIGN
     1023             f-host-code = 0
     1024             f-host-name = '':U
     1025             cb-obj-type = '':U
     1026             f-obj-code = 0
     1027             f-obj-name = '':U.
     1028             DISABLE
     1029             b-host
     1030             WITH FRAME Dialog-Frame.
     1031             DISPLAY
     1032             f-host-code
     1033             f-host-name
     1034             cb-obj-type
     1035             f-obj-code
     1036             f-obj-name
     1037             WITH FRAME Dialog-Frame.
     1038             ENABLE
     1039             b-obj
     1040             WITH FRAME Dialog-Frame.
     1041         END.
     1042     END CASE.
     1043   END.
     1044   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1045   on help of frame Dialog-Frame
     1046   do:
     1047     run gbl/app_help.p
     1048       (input this-procedure :file-name
     1049       ,input ''
     1050       ,input ?
     1051       ) no-error.
     1052     if error-status :error then do:
     1053       message
     1054         "Ошибка при вызове помощи"
     1055         error-status :get-message(1)
     1056         view-as alert-box .
     1057     end.
     1058   end.
     1059   run minbtn-set in this-procedure .
     1060   on choose of b-help in frame Dialog-Frame
     1061   do:
     1062     apply "help":u to frame Dialog-Frame .
     1063   end.
     1064   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1065   procedure minbtn-set :
     1066       do
     1067           on error undo, return error return-value
     1068           :
     1069           define variable ii              as integer       no-undo .
     1070           define variable fh              as widget-handle no-undo .
     1071           define variable hh              as widget-handle no-undo .
     1072           define variable v-h             as handle        extent 4 no-undo .
     1073           define variable v-name-button   as character     no-undo .
     1074           define variable v-help-old-x    as decimal       no-undo .
     1075           define variable v-help-old-y    as decimal       no-undo .
     1076           define variable v-help-old-size as decimal       no-undo .
     1077           define variable v-frame-width   as decimal       no-undo .
     1078           define variable jj              as integer       no-undo .
     1079           do
     1080               on error undo, return error
     1081               :
     1082               assign
     1083                   v-frame-width = frame Dialog-Frame:width - 0.3
     1084                   fh            = frame Dialog-Frame:first-child
     1085                   hh            = fh:first-child
     1086                   ii            = 1
     1087                   .
     1088               do while valid-handle(hh):
     1089                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1090                   do:
     1091                       case lc(hh:name) :
     1092                           when "b-help" then
     1093                               do:
     1094                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1095                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1096                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1097                                   hh:TOOLTIP = "Помощь" .
     1098                                   v-help-old-x = hh:column .
     1099                                   v-help-old-y = hh:row    .
     1100                                   v-help-old-size = hh:width .
     1101                                   hh:width-chars = 2.5 .
     1102                               end.
     1103                           when "b-print" then
     1104                               do:
     1105                                   hh:load-image("cmp/b-print.bmp":u) .
     1106                                   hh:TOOLTIP = "Печать" .
     1107                                   v-h[ii] = hh:handle .
     1108                                   ii = ii + 1 .
     1109                                   hh:width-chars = 3 .
     1110                               end.
     1111                           when "b-history" or
     1112                           when "b-hist" then
     1113                               do:
     1114                                   hh:load-image("cmp/b-hist.bmp":u) .
     1115                                   hh:TOOLTIP = "История" .
     1116                                   v-h[ii] = hh:handle .
     1117                                   ii = ii + 1 .
     1118                                   hh:width-chars = 3 .
     1119                               end.
     1120                           when "b-sch" then
     1121                               do:
     1122                                   hh:load-image("cmp/b-sch.bmp":u) .
     1123                                   hh:TOOLTIP = "Установка Фильтра" .
     1124                                   v-h[ii] = hh:handle .
     1125                                   ii = ii + 1 .
     1126                                   hh:width-chars = 3 .
     1127                               end.
     1128                           when "b-hist-user" then
     1129                               do:
     1130                                   hh:load-image("cmp/b-hist.bmp":u) .
     1131                                   hh:TOOLTIP = "История пользователя" .
     1132                                   ii = ii + 1 .
     1133                               end.
     1134                       end case.
     1135                   end.
     1136                   hh = hh:next-sibling.
     1137               end.
     1138               b-help:column = v-frame-width - b-help:width-chars.
     1139               jj = 0.
     1140               repeat ii = 4 to 1 by -1 :
     1141                   if valid-handle (v-h[ii] ) then
     1142                   do:
     1143                       jj  = jj + 1 .
     1144                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1145                       v-h[ii]:row    = v-help-old-y .
     1146                   end.
     1147               end.
     1148           end.
     1149       end.
     1150   end procedure.
     1151   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1152   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1153   MAIN-BLOCK:
     1154   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1155      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1156   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1157     run mainmenu_getcntxt in parparentproc
     1158       (output v-cntxt-db-num
     1159       ,output v-cntxt-userid
     1160       ,output v-cntxt-level
     1161       ,output v-cntxt-host-code-obj
     1162       ,output v-cntxt-obj-type
     1163       ,output v-cntxt-obj-code
     1164       ,output v-cntxt-db-num-obj
     1165       ,output v-cntxt-is-admin
     1166       ) .
     1167     if p-dtm-code <> ? then do:
     1168       FIND FIRST buf_prop-head NO-LOCK WHERE
     1169               buf_prop-head.dtm-code = p-dtm-code NO-ERROR.
     1170       IF NOT AVAILABLE buf_prop-head THEN DO:
     1171           MESSAGE
     1172           vss-workfile vss-revision vss-description SKIP
     1173           "Неверное значение параметра p-dtm-code" p-dtm-code SKIP
     1174           "Нет объекта-операнда c кодом"  p-dtm-code
     1175           VIEW-AS ALERT-BOX.
     1176           UNDO, RETURN ERROR.
     1177       END.
     1178     end.
     1179     if p-dt-code <> ? then do:
     1180       FIND FIRST buf_prop-ref NO-LOCK WHERE
     1181                 buf_prop-ref.dt-code = p-dt-code NO-ERROR.
     1182       IF NOT AVAILABLE buf_prop-ref THEN DO:
     1183           MESSAGE
     1184           vss-workfile vss-revision vss-description SKIP
     1185           "Неверное значение параметра p-dt-code" p-dt-code SKIP
     1186           "Нет среза c кодом"  p-dt-code
     1187           VIEW-AS ALERT-BOX.
     1188           UNDO, RETURN ERROR.
     1189       END.
     1190       if p-dtm-code = ? then do:
     1191         p-dtm-code = buf_prop-ref.dtm-code .
     1192       end.
     1193       else do:
     1194         if buf_prop-ref.dtm-code <> p-dtm-code then do:
     1195           MESSAGE
     1196           vss-workfile vss-revision vss-description SKIP
     1197           "Неверное значение параметра p-dt-code" p-dt-code SKIP
     1198           "Срез c кодом"  p-dt-code "принадлежит объекту-операнду" buf_prop-ref.dtm-code skip
     1199           "а код объекта-операнда (p-dtm-code) = " p-dtm-code
     1200           VIEW-AS ALERT-BOX.
     1201           UNDO, RETURN ERROR.
     1202         end.
     1203       end.
     1204       if p-node-code <> ?
     1205       then do:
     1206         find first buf_prop-map no-lock where
     1207                   buf_prop-map.dtm-code = p-dtm-code
     1208               and buf_prop-map.node-code = p-node-code no-error.
     1209         if not available buf_prop-map then do:
     1210           MESSAGE
     1211           vss-workfile vss-revision vss-description SKIP
     1212           "Неверное значение параметра p-node-code" p-node-code SKIP
     1213           substitute("Не найдейно свойство &1 для объекта-операнда &2"
     1214                       ,p-node-code
     1215                       ,p-dtm-code) skip
     1216           VIEW-AS ALERT-BOX.
     1217           UNDO, RETURN ERROR.
     1218         end.
     1219       end.
     1220     end.
     1221     run Myenable in this-procedure .
     1222     WAIT-FOR GO OF FRAME Dialog-Frame.
     1223   END.
     1224   RUN disable_UI.
     1225   PROCEDURE disable_UI :
     1226     HIDE FRAME Dialog-Frame.
     1227   END PROCEDURE.
     1228   PROCEDURE enable-disable-rs-range :
     1229   DEFINE VARIABLE v-range AS CHARACTER NO-UNDO.
     1230   DEFINE BUFFER buf_prop-head FOR ub.prop-head.
     1231   v-range = "global" + chr(4) + 'фирма':U + chr(4) + 'объект':U.
     1232   ASSIGN
     1233   f-host-code = 0
     1234   cb-obj-type = '':U
     1235   f-obj-code = 0
     1236   f-host-name = '':U
     1237   f-obj-name = '':U
     1238   .
     1239   DISPLAY
     1240   f-host-code
     1241   cb-obj-type
     1242   f-obj-code
     1243   f-host-name
     1244   f-obj-name
     1245   WITH FRAME Dialog-Frame.
     1246   ENABLE
     1247   b-host
     1248   b-obj
     1249   WITH FRAME Dialog-Frame.
     1250   FIND FIRST buf_prop-head NO-LOCK WHERE
     1251            buf_prop-head.dtm-code = f-dtm-code NO-ERROR.
     1252   if available buf_prop-head then do:
     1253     if buf_prop-head.storage-place = '':U
     1254     or buf_prop-head.storage-place = chr(63)
     1255     or buf_prop-head.storage-place = ? then do:
     1256       rs-range:disable(radio-label("global", rs-range:radio-buttons)) IN FRAME Dialog-Frame.
     1257       entry(lookup("global", v-range, chr(4)), v-range,  chr(4)) = '':U.
     1258     end.
     1259     if buf_prop-head.storage-place-host = '':U
     1260     or buf_prop-head.storage-place-host = chr(63)
     1261     or buf_prop-head.storage-place-host = ? then do:
     1262       rs-range:disable(radio-label('фирма':U, rs-range:radio-buttons))  IN FRAME Dialog-Frame.
     1263       DISABLE b-host WITH FRAME Dialog-Frame.
     1264       entry(lookup('фирма':U, v-range, chr(4)), v-range,  chr(4)) = '':U.
     1265     end.
     1266     if buf_prop-head.storage-place-obj = '':U
     1267     or buf_prop-head.storage-place-obj = chr(63)
     1268     or buf_prop-head.storage-place-obj = ? then do:
     1269       rs-range:disable(radio-label('объект':U, rs-range:radio-buttons))  IN FRAME Dialog-Frame.
     1270       DISABLE b-obj WITH FRAME Dialog-Frame.
     1271       entry(lookup('объект':U, v-range, chr(4)), v-range,  chr(4)) = '':U.
     1272     end.
     1273     v-range = REPLACE(v-range, chr(4) + chr(4), chr(4)).
     1274     rs-range = ENTRY(1, v-range, chr(4)).
     1275     DISPLAY rs-range WITH FRAME Dialog-Frame.
     1276   end.
     1277   ELSE DO:
     1278     rs-range:disable(radio-label("global", rs-range:radio-buttons)).
     1279     rs-range:disable(radio-label('фирма':U, rs-range:radio-buttons)).
     1280     rs-range:disable(radio-label('объект':U, rs-range:radio-buttons)).
     1281   END.
     1282   END PROCEDURE.
     1283   PROCEDURE enable_UI :
     1284     DISPLAY f-dtm-code f-dtm-name f-dt-code f-sum-id f-node-code f-node-label
     1285             RS-range f-host-code CB-obj-type f-obj-code f-low-decimal
     1286             f-low-logical f-low-date f-low-integer f-low-character f-high-logical
     1287             f-high-integer f-high-character f-high-date f-high-decimal rs-cond
     1288             F-host-name F-obj-name
     1289         WITH FRAME Dialog-Frame.
     1290     ENABLE b-exit b-quit B-Help b-dtm-code b-dt-code RS-range CB-obj-type
     1291            f-low-decimal f-low-logical f-low-date f-low-integer f-low-character
     1292            f-high-logical f-high-integer f-high-character f-high-date
     1293            f-high-decimal rs-cond F-host-name F-obj-name
     1294         WITH FRAME Dialog-Frame.
     1295     VIEW FRAME Dialog-Frame.
     1296   END PROCEDURE.
     1297   PROCEDURE MyEnable :
     1298   define buffer buf_clients for ub.clients.
     1299   ASSIGN
     1300   rs-range:RADIO-BUTTONS IN FRAME Dialog-Frame  = "Объекты" + chr(44) + 'объект':U + chr(44) +
     1301                           "Фирмы" + chr(44) + 'фирма':U + chr(44) +
     1302                           "Глобально" + chr(44) + "global"
     1303   CB-obj-type:list-items = '':U + chr(44) + 'маг':U + chr(44) + 'скл':U
     1304   rs-range = "global"
     1305   f-dtm-code = p-dtm-code
     1306   f-dt-code = p-dt-code
     1307   f-node-code = p-node-code
     1308   .
     1309   if available buf_prop-head then do:
     1310     assign
     1311     f-dtm-name = buf_prop-head.prop-name
     1312     .
     1313   end.
     1314   if available buf_prop-head then do:
     1315     assign
     1316     f-sum-id = buf_prop-ref.sum-id
     1317     .
     1318   end.
     1319   if available buf_prop-map then do:
     1320     assign
     1321     f-node-label = buf_prop-map.node-label
     1322     .
     1323   end.
     1324   rs-cond = p-cond.
     1325   IF p-host-code <> 0  THEN DO:
     1326   FIND FIRST buf_clients NO-LOCK WHERE
     1327            buf_clients.obj-code = p-host-code
     1328         AND buf_clients.obj-type = 'орг':U NO-ERROR.
     1329   if available buf_clients then do:
     1330       assign
     1331       f-host-CODE = p-host-code
     1332       f-host-name = buf_clients.obj-name
     1333       .
     1334       DISPLAY
     1335       f-host-code
     1336       f-host-name
     1337       WITH FRAME Dialog-Frame.
     1338   END.
     1339   END.
     1340   IF NOT ( p-obj-type = '':U
     1341            AND p-obj-code = 0) THEN DO:
     1342       FIND FIRST buf_clients NO-LOCK WHERE
     1343              buf_clients.obj-type = p-obj-type
     1344          AND  buf_clients.obj-code = p-obj-code NO-ERROR.
     1345       if available buf_clients then do:
     1346           assign
     1347           f-obj-CODE = buf_clients.obj-code
     1348           CB-obj-type = buf_clients.obj-type
     1349           f-obj-name = buf_clients.obj-name
     1350           .
     1351           DISPLAY
     1352           f-obj-code
     1353           cb-obj-type
     1354           f-obj-name
     1355           WITH FRAME Dialog-Frame.
     1356       END.
     1357   END.
     1358   ASSIGN
     1359   CB-obj-type = p-obj-type
     1360   f-obj-code = p-obj-code
     1361   .
     1362   IF f-obj-code > 0 THEN DO:
     1363       ASSIGN
     1364       rs-range = 'объект':U.
     1365   END.
     1366   ELSE do:
     1367      IF f-host-code > 0 THEN DO:
     1368        ASSIGN
     1369        rs-range = 'фирма':U.
     1370      END.
     1371      ASSIGN
     1372      rs-range ="global":U.
     1373   END.
     1374   display
     1375   f-dtm-code
     1376   f-dtm-name
     1377   f-dt-code
     1378   f-sum-id
     1379   f-node-code
     1380   f-node-label
     1381   with frame Dialog-Frame .
     1382   ENABLE
     1383   b-quit
     1384   b-exit
     1385   B-Help
     1386   b-dtm-code
     1387   b-dt-code
     1388   b-node-code
     1389   rs-cond
     1390   WITH FRAME Dialog-Frame.
     1391   VIEW FRAME Dialog-Frame.
     1392   RUN enable-disable-rs-range IN THIS-PROCEDURE.
     1393   END PROCEDURE.
     1394   PROCEDURE proc-b-host :
     1395   define VARIABLE v-host-code LIKE ub.sysconf.host-code no-undo .
     1396   define variable v-rid-list as character no-undo .
     1397   define buffer buf_clients  for ub.clients.
     1398     do
     1399     on error undo, return error
     1400     :
     1401           run adm/sconfs.w (
     1402                 input parParentProc
     1403               , input "b-sel":U
     1404               , input no
     1405               , input v-cntxt-host-code-obj
     1406               , output v-host-code
     1407               , input-output v-rid-list
     1408           ) no-error.
     1409         IF v-rid-list = '':U THEN RETURN NO-APPLY.
     1410         FIND FIRST buf_clients NO-LOCK WHERE
     1411                    buf_clients.obj-code = v-host-code
     1412                 AND buf_clients.obj-type = 'орг':U NO-ERROR.
     1413         if not available buf_clients then do:
     1414              return error.
     1415         end.
     1416         assign
     1417         f-host-CODE = v-host-code
     1418         f-host-name = buf_clients.obj-name
     1419         .
     1420         DISPLAY
     1421         f-host-code
     1422         f-host-name
     1423         WITH FRAME Dialog-Frame.
     1424     end.
     1425   END PROCEDURE.
     1426   PROCEDURE proc-b-obj :
     1427   define variable v-rid-list as character no-undo .
     1428   define buffer buf_clients  for ub.clients.
     1429   define buffer buf_clients-host  for ub.clients.
     1430     do
     1431     on error undo, return error
     1432     :
     1433          run ref/cli-all.w (
     1434                    INPUT parparentproc
     1435                   ,INPUT "b-sel"
     1436                   ,INPUT 'объект':U
     1437                   ,INPUT 'все':U
     1438                   ,INPUT 'текущие':U
     1439                   ,INPUT ?
     1440                   ,INPUT ",,,,,,NO,,"
     1441                   ,INPUT "lock-cli-type"
     1442                   ,output v-rid-list ) NO-ERROR.
     1443        IF v-rid-list = '':U THEN RETURN error.
     1444         FIND FIRST buf_clients NO-LOCK WHERE
     1445             RECID( buf_clients) = INTEGER( v-rid-list ) NO-ERROR.
     1446         if not available buf_clients then do:
     1447              return error.
     1448         end.
     1449         IF NOT (buf_clients.obj-type = 'маг':U
     1450                 OR
     1451                 buf_clients.obj-type = 'скл':U)
     1452                 THEN DO:
     1453             MESSAGE
     1454             substitute("Неверный тип объекта &1", buf_clients.obj-type)
     1455             VIEW-AS ALERT-BOX ERROR.
     1456             RETURN ERROR.
     1457         END.
     1458         FIND FIRST buf_clients-host NO-LOCK WHERE
     1459                   buf_clients-host.obj-type = 'орг':U
     1460             AND   buf_clients-host.obj-code = buf_clients.host-code NO-ERROR.
     1461            IF NOT AVAILABLE buf_clients-host THEN DO:
     1462                MESSAGE
     1463                SUBSTITUTE("Не найдена фирма &1 для объекта &2&3"
     1464                           , buf_clients.host-code
     1465                           , buf_clients.obj-type
     1466                           , buf_clients.obj-code)
     1467                 VIEW-AS ALERT-BOX ERROR.
     1468                RETURN ERROR.
     1469            END.
     1470         assign
     1471         f-obj-CODE = buf_clients.obj-code
     1472         CB-obj-type = buf_clients.obj-type
     1473         f-obj-name = buf_clients.obj-name
     1474         f-host-code = buf_clients.host-code
     1475         f-host-name = buf_clients-host.obj-name
     1476         .
     1477         DISPLAY
     1478         f-obj-code
     1479         cb-obj-type
     1480         f-obj-name
     1481         f-host-name
     1482         f-host-code
     1483         WITH FRAME Dialog-Frame.
     1484     end.
     1485   END PROCEDURE.
