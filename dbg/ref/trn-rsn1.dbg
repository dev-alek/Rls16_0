        1   block-level on error undo, throw.
        2   define input-output parameter p-rid         as recid     no-undo .
        3   define input        parameter p-mode        as character no-undo .
        4   define input        parameter p-silent      as logical   no-undo .
        5   define input        parameter p-reason-code like ub.trn-reason.reason-code no-undo .
        6   define input        parameter p-reason-name like ub.trn-reason.reason-name no-undo .
        7   define input        parameter p-PS          like ub.trn-reason.PS          no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: trn-rsn1.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: ref/trn-rsn1.p $":U .
       13   define variable vss-description as character no-undo init "Сохранение основания (причины) создания документа".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   main-block:
       73   do
       74   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
       75   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
       76   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
       77   :
       78     define buffer buf_trn-reason      for ub.trn-reason .
       79     define buffer next_trn-reason     for ub.trn-reason .
       80     define buffer buf_trn-rsn-attr    for ub.trn-rsn-attr .
       81     define buffer buf_trn-reason-obj  for ub.trn-reason-obj .
       82     define buffer buf_trn-reason-host for ub.trn-reason-host .
       83     define variable v-mess as character no-undo .
       84     if p-mode <> 'ДОБАВЛЕНИЕ':U
       85       and p-mode <> 'ИЗМЕНЕНИЕ':U
       86       and p-mode <> 'удаление':U
       87     then do:
       88       assign
       89         v-mess = substitute( "&1 (&2). Ошибка задания входных параметров. Неверный параметр p-mode (&3).", vss-workfile, vss-revision, p-mode )
       90       .
       91       run err-mess in this-procedure ( input-output v-mess ).
       92       undo main-block, return error (if p-silent = true then v-mess else '':U ).
       93     end.
       94     if p-mode = 'ИЗМЕНЕНИЕ':U
       95       or p-mode = 'удаление':U
       96     then do:
       97       find first buf_trn-reason exclusive-lock
       98         where recid( buf_trn-reason ) = p-rid
       99         no-error .
      100       if not available buf_trn-reason then do:
      101         assign
      102           v-mess = substitute( "Запись основания (причины) создания документа не найдена." )
      103         .
      104         run err-mess in this-procedure ( input-output v-mess ).
      105         undo main-block, return error (if p-silent = true then v-mess else '':U ).
      106       end.
      107     end.
      108     case p-mode :
      109       when 'ИЗМЕНЕНИЕ':U
      110       or when 'ДОБАВЛЕНИЕ':U
      111       then do:
      112         if p-reason-code <= 0 then do:
      113           assign
      114             v-mess = substitute( "Код основания должен быть больше нуля." )
      115           .
      116           run err-mess in this-procedure ( input-output v-mess ).
      117           undo main-block, return error (if p-silent = true then v-mess else 'reason-code':U ).
      118         end.
      119         find first next_trn-reason no-lock
      120           where next_trn-reason.reason-code = p-reason-code
      121             and recid( next_trn-reason ) <> p-rid
      122           no-error .
      123         if available next_trn-reason then do:
      124           find first buf_trn-rsn-attr no-lock
      125             where buf_trn-rsn-attr.reason-code = p-reason-code
      126               and buf_trn-rsn-attr.attr-code   = "del":U
      127             no-error .
      128           if available buf_trn-rsn-attr then do:
      129             assign
      130               v-mess = substitute("Уже было основание с кодом &2 и было удалено.&1Повторное заведение невозможно.", chr(10), p-reason-code)
      131             .
      132             run err-mess in this-procedure ( input-output v-mess ).
      133             undo main-block, return error (if p-silent = true then v-mess else 'reason-code':U ).
      134           end.
      135           else do:
      136             assign
      137               v-mess = substitute("Уже есть основание с кодом &1.", p-reason-code)
      138             .
      139             run err-mess in this-procedure ( input-output v-mess ).
      140             undo main-block, return error (if p-silent = true then v-mess else 'reason-code':U ).
      141           end.
      142         end.
      143         if trim( p-reason-name ) = "":u then do:
      144           assign
      145             v-mess = substitute("Основание (причина) не может быть пустой.")
      146           .
      147           run err-mess in this-procedure ( input-output v-mess ).
      148           undo main-block, return error (if p-silent = true then v-mess else 'reason-name':U ).
      149         end.
      150         find first next_trn-reason no-lock
      151           where next_trn-reason.reason-name = p-reason-name
      152             and recid( next_trn-reason ) <> p-rid
      153           no-error .
      154         if available next_trn-reason then do:
      155           assign
      156             v-mess = substitute('Уже есть основание (причина) "&1" (код &2).', next_trn-reason.reason-name, next_trn-reason.reason-code)
      157           .
      158           run err-mess in this-procedure ( input-output v-mess ).
      159           undo main-block, return error (if p-silent = true then v-mess else 'reason-name':U ).
      160         end.
      161         if p-mode = 'ДОБАВЛЕНИЕ':U then do:
      162           create buf_trn-reason .
      163           assign
      164             buf_trn-reason.reason-code = p-reason-code
      165             p-rid                      = recid( buf_trn-reason )
      166           .
      167         end.
      168         assign
      169           buf_trn-reason.reason-name = p-reason-name
      170           buf_trn-reason.PS          = p-PS
      171         .
      172         release buf_trn-reason no-error .
      173         if error-status:error then do:
      174           assign
      175             v-mess = substitute( "&2 (&3). Ошибка при сохранении записи основания (причины) создания документа.&1&4&1&5"
      176                                   , chr(10)
      177                                   , vss-workfile
      178                                   , vss-revision
      179                                   , error-status:get-message(1)
      180                                   , return-value )
      181           .
      182           run err-mess in this-procedure ( input-output v-mess ).
      183           undo main-block, return error (if p-silent = true then v-mess else '':U ).
      184         end.
      185       end.
      186       when 'удаление':U then do:
      187         find first buf_trn-reason-obj no-lock
      188           where buf_trn-reason-obj.reason-code = buf_trn-reason.reason-code
      189           no-error.
      190         if available buf_trn-reason-obj then do:
      191           assign
      192             v-mess = substitute('Основание (причина) используется в настройках по умолчанию на объекте &2 &3.&1Удаление не возможно.'
      193                                 , chr(10)
      194                                 , buf_trn-reason-obj.obj-type
      195                                 , buf_trn-reason-obj.obj-code
      196                                )
      197           .
      198           run err-mess in this-procedure ( input-output v-mess ).
      199           undo main-block, return error (if p-silent = true then v-mess else '':U ).
      200         end.
      201         find first buf_trn-reason-host no-lock
      202           where buf_trn-reason-host.reason-code = buf_trn-reason.reason-code
      203           no-error.
      204         if available buf_trn-reason-host then do:
      205           assign
      206             v-mess = substitute('Основание (причина) используется в настройках по умолчанию на фирме &2.&1Удаление не возможно.'
      207                                 , chr(10)
      208                                 , buf_trn-reason-host.host-code
      209                                )
      210           .
      211           run err-mess in this-procedure ( input-output v-mess ).
      212           undo main-block, return error (if p-silent = true then v-mess else '':U ).
      213         end.
      214         find first buf_trn-rsn-attr exclusive-lock
      215           where buf_trn-rsn-attr.reason-code = buf_trn-reason.reason-code
      216             and buf_trn-rsn-attr.attr-code   = "del":U
      217           no-error
      218           .
      219         if not available buf_trn-rsn-attr then do:
      220           create buf_trn-rsn-attr.
      221           assign
      222             buf_trn-rsn-attr.reason-code = buf_trn-reason.reason-code
      223             buf_trn-rsn-attr.attr-code   = "del":U
      224           .
      225         end.
      226         assign
      227           buf_trn-rsn-attr.attr-value   = "yes":U
      228         .
      229       end.
      230     end case.
      231   end.
      232   return '':U .
      233   procedure err-mess:
      234     define input-output parameter p-mess as character no-undo.
      235     case p-silent:
      236       when true then do:
      237         assign
      238         p-mess = substitute("Сохранение изменений в карточке основания (причины) создания документа&1"
      239                             + "Код основания: &2&1"
      240                             + "Основание: &3&1"
      241                             + "&4"
      242                            , chr(10)
      243                            , p-reason-code
      244                            , p-reason-name
      245                            , p-mess)
      246         .
      247       end.
      248       when false then do:
      249         message
      250         p-mess
      251         view-as alert-box error .
      252       end.
      253     end.
      254   end procedure.
