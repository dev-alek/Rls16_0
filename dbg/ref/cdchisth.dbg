     3448   PROCEDURE OpenBr :
     3449   define input  parameter p-open-query     as logical   no-undo .
     3450   define input  parameter p-find-next      as logical   no-undo .
     3451   define input  parameter p-find-condition as character no-undo .
     3452   define input  parameter p-db-num like ub.c-dc-hist.corr-user-db-num no-undo .
     3453   define variable l-query-was-opened as logical no-undo .
     3454   define variable title0 as character no-undo.
     3455   title0 = "Список полной истории ДК" + chr(32).
     3456   run waitfram-show in this-procedure ( input "Ждите...").
     3457   define variable sort-column-phrase as character no-undo .
     3458   case sort-column-name :
     3459     when "" then do:
     3460       assign
     3461         sort-column-phrase = ""
     3462       .
     3463     end.
     3464     otherwise do:
     3465       assign
     3466         sort-column-phrase = "by " + sort-column-name
     3467       .
     3468     end.
     3469   end case.
     3470   define variable l-open-query as logical   no-undo .
     3471   CASE p-db-num:
     3472     when ? then do:
     3473       CASE p-mode :
     3474         WHEN "one":u THEN DO:
     3475           assign
     3476           filter-point = filter-point0 + p-mode
     3477           filter-label = substitute("&1: Карта", filter-label0)
     3478           .
