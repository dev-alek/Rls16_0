      120     run proc-alt-shift-f3 in this-procedure .
      121   end.
      122   on alt-shift-f4 anywhere do:
      123     run proc-alt-shift-f4 in this-procedure.
      124   end.
      125   on alt-f1 anywhere do:
      126     run proc-alt-f1 in this-procedure .
      127   end.
      128   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      129   define variable c-point  as character no-undo .
      130   define variable tbl      as character no-undo .
      131   define variable join-tbl as character no-undo .
      132   define variable fld      as character no-undo .
      133   define variable lab      as character no-undo .
      134   define variable spr      as character no-undo .
      135   define variable dim      as character no-undo .
      136   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      137   procedure cur-time :
      138      define output parameter p-today as date      no-undo .
      139      define output parameter p-time  as integer   no-undo .
      140     do
      141     on error undo, return error
      142     :
      143       define variable v-date1 as date      no-undo .
      144       define variable v-date2 as date      no-undo .
      145       define variable v-time  as integer   no-undo .
      146       assign
      147         v-date1 = today
      148         v-time  = time
      149         v-date2 = today
      150       .
      151       if v-date1 <> v-date2
      152       then do:
      153         assign
      154           v-date1 = today
      155           v-time  = v-time
      156         .
      157       end.
      158       assign
      159         p-today = v-date1
      160         p-time  = v-time
      161       .
      162     end.
      163   end.
      164   function cur-time-date returns character
      165   :
      166     return string(today, '99/99/9999':U) .
      167   end.
      168   function cur-time-mjd returns decimal
      169   :
      170     define variable v-date as date      no-undo .
      171     define variable v-time as integer   no-undo .
      172     run cur-time in this-procedure
      173       (output v-date
      174       ,output v-time
      175       ) .
      176     return integer(v-date) - 2400002 + (v-time / 86400) .
      177   end.
      178   function cur-time-get-ending-index returns integer
      179   (input p-number as integer
      180   )
      181   :
      182     if p-number < 0
      183     or p-number = ?
      184     then do:
      185       return 1 .
      186     end.
      187     define variable v-rest as integer   no-undo .
      188     assign
      189       p-number = p-number modulo 100
      190     .
      191     if p-number < 20
      192     then do:
      193       assign
      194         v-rest = p-number
      195       .
      196     end.
      197     else do:
      198       assign
      199         v-rest = p-number modulo 10
      200       .
      201     end.
      202     case v-rest :
      203       when 1
      204       then do:
      205         return 2 .
      206       end.
      207       when 2 or
      208       when 3 or
      209       when 4
      210       then do:
      211         return 3 .
      212       end.
      213       otherwise do:
      214         return 1 .
      215       end.
      216     end case .
      217   end.
      218   procedure cur-time-mjd-to-date :
      219      define input  parameter i-mjd-diff as decimal no-undo.
      220      define output parameter o-Date     as date    no-undo.
      221      define output parameter o-Time     as integer no-undo.
      222      define variable v-day-number as integer   no-undo .
      223      if    i-mjd-diff < 0
      224         or i-mjd-diff = ?
      225      then do:
      226         return "?" .
      227      end.
      228      assign
      229         v-day-number = truncate(i-mjd-diff,0).
      230         o-Date = date(v-day-number + 2400002).
      231         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      232     .
      233   end.
      234   function cur-time-mjd-to-string returns character
      235   (input p-mjd-diff as decimal
      236   )
      237   :
      238     define variable v-day-number as integer   no-undo .
      239     define variable v-seconds    as integer   no-undo .
      240     define variable v-hour       as integer   no-undo .
      241     define variable v-min        as integer   no-undo .
      242     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      243     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      244     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      245     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      246     if p-mjd-diff < 0
      247     or p-mjd-diff = ?
      248     then do:
      249       return "?" .
      250     end.
      251     assign
      252       v-day-number = integer(truncate(p-mjd-diff,0))
      253       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      254     .
      255     if v-seconds > 86400
      256     then do:
      257       assign
      258         v-seconds = 86400 - 1
      259       .
      260     end.
      261     if v-seconds < 0
      262     then do:
      263       assign
      264         v-seconds = 0
      265       .
      266     end.
      267     assign
      268       v-hour = truncate(v-seconds / 3600, 0)
      269     .
      270     assign
      271       v-seconds = v-seconds modulo 3600
      272     .
      273     assign
      274       v-min = truncate(v-seconds / 60, 0)
      275     .
      276     assign
      277       v-seconds = v-seconds modulo 60
      278     .
      279     return
      280         (if v-day-number <> 0
      281           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      282           else ""
      283         )
      284       + (if v-day-number <> 0 or v-hour <> 0
      285           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      286           else ""
      287         )
      288       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      289           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      290           else ""
      291         )
      292       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      293       .
      294   end.
      295   function cur-time-string returns character
      296   :
      297     define variable v-date as date      no-undo .
      298     define variable v-time as integer   no-undo .
      299     run cur-time in this-procedure
      300       (output v-date
      301       ,output v-time
      302       ) .
      303     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      304   end.
      305   function cur-time-string-sec returns character
      306   :
      307     define variable v-date as date      no-undo .
      308     define variable v-time as integer   no-undo .
      309     run cur-time in this-procedure
      310       (output v-date
      311       ,output v-time
      312       ) .
      313     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      314   end.
      315   function cur-time-custom  returns character
      316   (input p-prefix as character
      317   ,input p-date-format as character
      318   ,input p-delimiter as character
      319   ,input p-time-format as character
      320   ,input p-suffix as character
      321   )
      322   :
      323     define variable v-date as date      no-undo .
      324     define variable v-time as integer   no-undo .
      325     run cur-time in this-procedure
      326       (output v-date
      327       ,output v-time
      328       ) .
      329     return
      330       p-prefix
      331       + string(v-date, p-date-format)
      332       + p-delimiter
      333       + string(v-time, p-time-format)
      334       + p-suffix
      335       .
      336   end.
      337   function cur-time-print  returns character
      338   :
      339     define variable v-date as date      no-undo .
      340     define variable v-time as integer   no-undo .
      341     run cur-time in this-procedure
      342       (output v-date
      343       ,output v-time
      344       ) .
      345     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      346   end.
      347   function cur-time-datetime returns datetime
      348   :
      349     define variable v-char as character no-undo .
      350     define variable v-datetime as datetime no-undo .
      351     v-char = cur-time-string().
      352     v-datetime = datetime(v-char).
      353     return  v-datetime.
      354   end.
      355   function cur-time-string-msec returns character
      356   :
      357     define variable v-date as datetime  no-undo .
      358     v-date = now.
      359     return string(v-date) .
      360   end.
      361   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      362   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      363   define new shared variable RepPathName        as character no-undo .
      364   define new shared variable PrintRubl          as logical   no-undo .
      365   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      366   define variable v-waitfram-action01         as character   no-undo .
      367   define variable v-waitfram-action02         as character   no-undo .
      368   define variable v-waitfram-action03         as character   no-undo .
      369   define variable mWaitFramTextBeg            as character   no-undo.
      370   define variable mWaitFramTextEnd            as character   no-undo.
      371   define variable mWaitFramView               as logical     no-undo.
      372   define variable mWaitProcEvent              as logical     no-undo init yes.
      373   define variable mWaitFramInterval           as integer     no-undo init 1 .
      374   define variable mWaitFramStop               as logical     no-undo.
      375   define variable mWaitFramStopUser           as logical     no-undo.
      376   define variable mWaitFramStopTimeOut        as logical     no-undo.
      377   define variable mWaitFramStartProc          as datetime-tz no-undo.
      378   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      379   define button B-WaitFramStop auto-end-key
      380        label "Стоп"
      381        size 10 by 1 tooltip "Остоновить процесс".
      382   define button B-viewProcInfo
      383        label "Информация"
      384        size 15 by 1 tooltip "Информация о процесс".
      385   define frame waitfram
      386     v-waitfram-action01 format "x(72)" no-label skip
      387     v-waitfram-action02 format "x(72)" no-label skip
      388     v-waitfram-action03 format "x(72)" no-label skip
      389     B-viewProcInfo
      390     B-WaitFramStop at row 4 col 30
      391     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      392     .
      393   define new global shared variable mBatchMode as logical no-undo init ?.
      394   define variable mFramBachModHandle as handle no-undo.
      395   mFramBachModHandle = frame waitfram:handle.
      396   define variable mFameOldVis as logical no-undo.
      397   define variable mVisCUrentVin as logical no-undo.
      398   if session:batch-mode
      399   then
      400      mBatchMode = yes.
      401   if mBatchMode = ? then do:
      402     mVisCUrentVin = current-window:visible.
      403     mFameOldVis = mFramBachModHandle:visible.
      404     mFramBachModHandle:visible  = yes.
      405     mBatchMode = mFramBachModHandle:visible ne yes.
      406     mFramBachModHandle:visible = mFameOldVis.
      407     current-window:visible = mVisCUrentVin.
      408   end.
      409    if  log-manager:logfile-name ne ?
      410     then DO:
      411         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      412         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      413         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      414     end.
      415   on choose of B-WaitFramStop in frame waitfram
      416   do:
      417     mWaitFramStop = yes.
      418     mWaitFramStopUser = yes.
      419   end.
      420   function waitfram-check-timeout returns logical():
      421      define variable vtime as int64 no-undo.
      422      if mWaitFramStopTimeOut
      423      then
      424         return yes.
      425      vtime = ( now - mWaitFramStartProc ) / 1000 .
      426      if     mWaitFramTimeOut ne ?
      427         and mWaitFramTimeOut ne 0
      428         and mWaitFramTimeOut lt vtime
      429      then do:
      430         mWaitFramStopTimeOut = yes.
      431      end.
      432      return mWaitFramStopTimeOut.
      433   end.
      434   procedure waitfram-hide :
      435     if not session:batch-mode
      436     then do
      437     on error undo, return error return-value
      438     :
      439       pause 0 before-hide .
      440       if not mBatchMode then
      441         hide frame waitfram .
      442     if     not mWaitFramView
      443        and mWaitProcEvent
      444     then
      445       process events .
      446     end.
      447   end procedure.
      448   procedure waitfram-show :
      449     define input  parameter p-message as character no-undo .
      450     define variable v-left-margin as integer   no-undo .
      451     if not session:batch-mode
      452     then do
      453     on error undo, return error return-value
      454     :
      455       if length(p-message) <= 70 then do:
      456         assign
      457           v-left-margin = integer((70 - length(p-message)) / 2)
      458         .
      459         assign
      460           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      461         .
      462         assign
      463           v-waitfram-action01 = " "
      464           v-waitfram-action02 = " "
      465                                    + fill(" ", v-left-margin)
      466                                    + p-message
      467           v-waitfram-action03 = " "
      468         .
      469       end.
      470       else do:
      471         define variable vRindex1 as integer no-undo.
      472         define variable vRindex2 as integer no-undo.
      473         vRindex1 = r-index(p-message," ",70).
      474         if vRindex1 = 0
      475         then
      476            vRindex1 = 70.
      477         if length(p-message)  <= vRindex1 + 70 then do:
      478           assign
      479             v-waitfram-action01 = " "
      480             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      481             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      482           .
      483         end.
      484         else do:
      485           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      486           if vRindex2 <= vRindex1
      487           then
      488              vRindex2 = vRindex1 + 70.
      489           assign
      490             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      491             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      492             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      493           .
      494         end.
      495       end.
      496       B-viewProcInfo:visible   in frame waitfram = no.
      497       B-viewProcInfo:sensitive in frame waitfram = no.
      498       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      499       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      500       if  (   mWaitFramView
      501          or  mWaitProcEvent)
      502          and not mBatchMode
      503       then
      504          display
      505             v-waitfram-action01 skip
      506             v-waitfram-action02 skip
      507             v-waitfram-action03 skip
      508          with frame waitfram .
      509       if     mWaitFramView
      510          then do:
      511             if     mWaitFramInterval ne ?
      512                and not mBatchMode
      513             then
      514                wait-for go of frame waitfram pause mWaitFramInterval.
      515          end.
      516          else
      517             if     mWaitProcEvent
      518                and not mBatchMode
      519             then
      520                process events .
      521     end.
      522   end procedure.
      523      procedure waitfram-show-this:
      524         define input  parameter iInterval as int64 no-undo.
      525         define variable vtime as int64 no-undo.
      526         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      527         mWaitFramInterval = iInterval.
      528         run waitfram-show (substitute("&1&2 &3&4" ,
      529                                       mWaitFramTextBeg ,
      530                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      531                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      532                                       mWaitFramTextEnd
      533                                      )
      534                           ).
      535      end.
      536      procedure WaitFramRunPause:
      537         define input  parameter iInterval as dec no-undo.
      538         define variable vStart  as datetime-tz no-undo.
      539         define variable vend    as datetime-tz no-undo.
      540         define variable vint as int64 no-undo.
      541         define variable vOk as logical no-undo.
      542         vStart = now.
      543         vend   = vStart.
      544         publish "WaitFramPause" (iInterval,output vOk).
      545         vend   =  now.
      546         vint = vend - vStart.
      547         vint = iInterval - vint / 1000.
      548         if     not mWaitFramStop
      549            and (   vint > 0
      550                 or (    not vOk
      551                     and iInterval eq ?
      552                     )
      553                 )
      554         then
      555            run waitfram-show-this (iInterval).
      556         vend   =  now.
      557         vint = vend - vStart.
      558         vint = iInterval - vint / 1000.
      559         if     not mWaitFramStop
      560            and vint > 0
      561         then do:
      562            run gbl/pause.p (vint * 1000).
      563         end.
      564         if iInterval ne ?
      565         then
      566            publish "WaitFramStop".
      567         waitfram-check-timeout().
      568      end.
      569      procedure WaitFramWaitFor:
      570         define input  parameter iInterval as dec no-undo.
      571         assign
      572            mWaitFramStartProc   = now
      573            mWaitFramStopUser    = no
      574            mWaitFramStopTimeOut = no
      575         .
      576         block-wait:
      577         do while not mWaitFramStop:
      578            run WaitFramRunPause (iInterval).
      579            if  waitfram-check-timeout()
      580            then do:
      581               leave block-wait.
      582            end.
      583         end.
      584         run waitfram-hide.
      585      end.
      586   procedure waitfram-join :
      587     define input  parameter p-line-1  as character no-undo .
      588     define input  parameter p-line-2  as character no-undo .
      589     define input  parameter p-line-3  as character no-undo .
      590     define output parameter p-message as character no-undo .
      591     do
      592     on error undo, return error return-value
      593     :
      594       assign
      595         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      596                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      597                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      598       .
      599     end.
      600   end procedure.
      601   function waitfram-join-function returns character
      602     (input p-line-1 as character
      603     ,input p-line-2 as character
      604     ,input p-line-3 as character
      605     ).
      606     define variable v-message as character no-undo .
      607     run waitfram-join in this-procedure
      608       (input  p-line-1
      609       ,input  p-line-2
      610       ,input  p-line-3
      611       ,output v-message
      612       ) .
      613     return v-message .
      614   end function .
      615   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      616   procedure fltfield-clear :
      617     define output parameter loc-fld as character no-undo.
      618     define output parameter loc-lab as character no-undo .
      619     define output parameter loc-spr as character no-undo .
      620     define output parameter loc-dim as character no-undo .
      621     assign
      622       loc-fld = ""
      623       loc-lab = ""
      624       loc-spr = ""
      625       loc-dim = "0"
      626     .
      627   end procedure .
      628   procedure fltfield-add :
      629     define input        parameter par-fld as character no-undo.
      630     define input        parameter par-lab as character no-undo .
      631     define input        parameter par-spr as character no-undo .
      632     define input-output parameter loc-fld as character no-undo.
      633     define input-output parameter loc-lab as character no-undo .
      634     define input-output parameter loc-spr as character no-undo .
      635     define input-output parameter loc-dim as character no-undo .
      636     do
      637     on error undo, return error
      638     :
      639       assign
      640       loc-fld = if loc-dim = '0'
      641                 then par-fld
      642                 else (loc-fld + chr(44) + par-fld)
      643       loc-lab = if loc-dim = '0'
      644                 then par-lab
      645                 else (loc-lab + chr(44) + par-lab)
      646       loc-spr = if loc-dim = '0'
      647                 then par-spr
      648                 else (loc-spr + chr(44) + par-spr)
      649       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      650                 string(integer(if num-entries(loc-dim) > 1
      651                               then entry(2, loc-dim)
      652                               else entry(1, loc-dim)
      653                               ) + 1)
      654       no-error
      655       .
      656     end.
      657   end procedure.
