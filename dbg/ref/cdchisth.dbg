     2870   procedure get-context :
     2871      define output parameter p-db-num as integer          no-undo.
     2872      define output parameter p-user-id as character        no-undo.
     2873      define variable v-login               as character    no-undo.
     2874      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2875      define buffer buf_user-login  for ub.user-login .
     2876      do
     2877      on error undo, return error
     2878      :
     2879            FIND FIRST buf_sys-ctrl no-lock.
     2880            ASSIGN
     2881               v-login = USERID("ub")
     2882               p-db-num = buf_sys-ctrl.db-num
     2883            .
     2884            FIND FIRST buf_user-login
     2885                 WHERE buf_user-login.db-num = p-db-num
     2886                   AND buf_user-login.user-login = v-login
     2887                 no-lock
     2888                 no-error
     2889                 .
     2890            IF AVAILABLE buf_user-login
     2891            THEN DO:
     2892               assign
     2893                  p-user-id = buf_user-login.user-id
     2894               .
     2895            END.
     2896      end.
     2897   end procedure.
