     3679             ASSIGN frame Dialog-Frame:TITLE = title0 + substitute(" ДКарта &1: &2 БД: &3",
     3680                                                                   p-d-card, v-cli-name, p-db-num ).
     3681           end.
     3682   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
