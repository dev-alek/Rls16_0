     3611                             ,input parameter-4-26
     3612                             ,input parameter-5-26
     3613                             ) no-error.
     3614         .
     3615         assign
     3616           v-doc-rec = integer(return-value)
     3617           v-fltopend-rowid[1] = ?
     3618         .
     3619       end.
     3620       else do:
     3621         assign
     3622         parameter-2-26 = (if p-find-next then "true":u else "false":u )
     3623         parameter-3-26 =  "FOR EACH X_c-dc-hist"
     3624         parameter-4-26 =
