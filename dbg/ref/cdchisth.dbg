     1070   FUNCTION get-all-fields returns character (p-file-name as character ):
     1071   define variable v-dop as character no-undo .
     1072     find first _file no-lock where _file._file-name = p-file-name no-error .
     1073     if not available _file then return "":U.
     1074     for each _field no-lock where
     1075              _field._file-recid = recid(_file) :
     1076       assign
     1077       v-dop = v-dop + _field._field-name + chr(44)
     1078       .
     1079     end.
     1080     return trim(v-dop).
     1081   END FUNCTION.
     1082   PROCEDURE proc-full-temp-changes :
     1083     define input  parameter p-hst-handle as handle    no-undo .
     1084     define input  parameter p-main-table as character no-undo .
     1085     define input  parameter p-field-list as character no-undo .
     1086     define input  parameter p-label-form as character no-undo .
     1087     define variable h-new-buf         as handle    no-undo .
     1088     define variable h-main-buf        as handle    no-undo .
     1089     define variable h-for-comp        as handle    no-undo .
     1090     define variable v-inform          as character no-undo .
     1091     define variable v-ind             as integer   no-undo .
     1092     define variable v-idx-field-qnty  as integer   no-undo .
     1093     define variable v-num-entries     as integer   no-undo .
     1094     define variable fh                as handle    no-undo .
     1095     define variable fh-main           as handle    no-undo .
     1096     define variable fh-old            as handle    no-undo .
     1097     define variable fh-new            as handle    no-undo .
     1098     define variable v-field-name      as character no-undo .
     1099     define variable v-field-lvl       as character no-undo .
     1100     define variable v-field-form      as character no-undo .
     1101     define variable v-search-exp      as character no-undo .
     1102     define variable v-srch-main       as character no-undo .
     1103     define variable v-word-link       as character no-undo .
     1104     define variable v-av-chip-num     as logical   no-undo .
     1105     define variable v-main-pi-fld-lst as character no-undo .
     1106     define variable v-main-fld-lst    as character no-undo .
     1107     define variable v-delim-list      as character no-undo .
     1108     define variable v-label           as character no-undo .
     1109     define variable v-old-value       as character no-undo case-sensitive.
     1110     define variable v-new-value       as character no-undo case-sensitive.
     1111     define variable v-chg-fields as character no-undo.
     1112     for each temp-changes:
     1113       delete temp-changes.
     1114     end.
     1115     if not p-hst-handle:available then do:
     1116       return .
     1117     end.
     1118     create buffer h-new-buf  for table p-hst-handle .
     1119     create buffer h-main-buf for table p-main-table .
     1120     assign
     1121       v-inform = h-main-buf:index-information(1)
     1122       v-ind    = 2
     1123     .
     1124     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1125     on error undo, return error
     1126     :
     1127       assign
     1128         v-inform = h-main-buf:index-information( v-ind )
     1129         v-ind    = v-ind + 1
     1130       .
     1131     end.
     1132     if v-inform = ?
     1133       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1134       or entry( 3, v-inform, ",":U ) <> "1":U
     1135     then do:
     1136       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1137     end.
     1138     assign
     1139       v-idx-field-qnty = num-entries( v-inform ) - 4
     1140     .
     1141     if v-idx-field-qnty < 2 then do:
     1142       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1143     end.
     1144     assign
     1145       v-srch-main   = "where":U
     1146       v-word-link   = "":U
     1147       v-av-chip-num = false
     1148       v-delim-list  = "":U
     1149     .
     1150     do v-ind = 1 to v-idx-field-qnty by 2
     1151     on error undo, return error
     1152     :
     1153       assign
     1154         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1155         fh                = p-hst-handle:buffer-field( v-field-name )
     1156         fh-main           = h-main-buf:buffer-field( v-field-name )
     1157         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1158         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1159       .
     1160       if fh:data-type ="character":U then do:
     1161         assign
     1162           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1163         .
     1164       end.
     1165       else do:
     1166         assign
     1167           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1168         .
     1169       end.
     1170       if v-delim-list = "":U then do:
     1171         assign
     1172           v-delim-list = ",":U
     1173         .
     1174       end.
     1175       if v-word-link = "":U then do:
     1176         assign
     1177           v-word-link = "and":U
     1178         .
     1179       end.
     1180     end.
     1181     assign
     1182       v-delim-list  = "":U
     1183     .
     1184     do v-ind = 1 to h-main-buf:num-fields
     1185     on error undo, return error
     1186     :
     1187       assign
     1188         fh-main      = h-main-buf:buffer-field( v-ind )
     1189         v-field-name = fh-main:name
     1190       .
     1191         assign
     1192           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1193         .
     1194         if v-delim-list = "":U then do:
     1195           assign
     1196             v-delim-list = ",":U
     1197           .
     1198         end.
     1199     end.
     1200     assign
     1201       v-inform = p-hst-handle:index-information(1)
     1202       v-ind    = 2
     1203     .
     1204     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1205     on error undo, return error
     1206     :
     1207       assign
     1208         v-inform = p-hst-handle:index-information( v-ind )
     1209         v-ind    = v-ind + 1
     1210       .
     1211     end.
     1212     if v-inform = ?
     1213       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1214       or entry( 3, v-inform, ",":U ) <> "1":U
     1215     then do:
     1216       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1217     end.
     1218     assign
     1219       v-idx-field-qnty = num-entries( v-inform ) - 4
     1220     .
     1221     if v-idx-field-qnty < 2 then do:
     1222       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1223     end.
     1224     assign
     1225       v-search-exp  = "where":U
     1226       v-word-link   = "":U
     1227       v-av-chip-num = false
     1228     .
     1229     do v-ind = 1 to v-idx-field-qnty by 2
     1230     on error undo, return error
     1231     :
     1232       assign
     1233         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1234         fh           = p-hst-handle:buffer-field( v-field-name )
     1235         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1236       .
     1237       if v-field-name = "chip-num":U then do:
     1238         assign
     1239           v-search-exp  = substitute( "&1 >", v-search-exp )
     1240           v-av-chip-num = true
     1241         .
     1242       end.
     1243       else do:
     1244         assign
     1245           v-search-exp = substitute( "&1 =", v-search-exp )
     1246         .
     1247       end.
     1248       if fh:data-type ="character":U then do:
     1249         assign
     1250           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1251         .
     1252       end.
     1253       else do:
     1254         assign
     1255           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1256         .
     1257       end.
     1258       if v-word-link = "":U then do:
     1259         assign
     1260           v-word-link = "and":U
     1261         .
     1262       end.
     1263     end.
     1264     if v-av-chip-num = false then do:
     1265       message
     1266         vss-workfile vss-revision vss-description skip
     1267         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1268         "Использование данной процедуры невозможно!" skip
     1269         view-as alert-box error .
     1270       return error .
     1271     end.
     1272     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1273     if not h-new-buf:available then do:
     1274       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1275       if not h-main-buf:available then do:
     1276         assign
     1277           h-for-comp = ?
     1278         .
     1279       end.
     1280       else do:
     1281         assign
     1282           h-for-comp = h-main-buf
     1283         .
     1284       end.
     1285     end.
     1286     else do:
     1287       assign
     1288         h-for-comp = h-new-buf
     1289       .
     1290     end.
     1291     assign
     1292       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1293     .
     1294     do v-ind = 1 to v-num-entries
     1295     on error undo, return error return-value
     1296     :
     1297       assign
     1298         v-field-name = entry( v-ind, v-main-fld-lst )
     1299         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1300         v-old-value  = fh-old:buffer-value()
     1301         v-label      = trim( fh-old:label )
     1302       .
     1303       if ( trim( p-field-list ) <> "":U
     1304            and lookup( v-field-name, p-field-list ) > 0
     1305          )
     1306          or trim( p-field-list ) = "":U
     1307       then do:
     1308         if h-for-comp <> ? then do:
     1309           assign
     1310             fh-new      = h-for-comp:buffer-field( v-field-name )
     1311             v-new-value = fh-new:buffer-value()
     1312           .
     1313         end.
     1314         else do:
     1315           assign
     1316             v-new-value = "":U
     1317           .
     1318         end.
     1319         if v-old-value <> v-new-value
     1320         then do:
     1321           create temp-changes.
     1322           assign
     1323             temp-changes.t_name = p-main-table
     1324             temp-changes.f_name = v-field-name
     1325             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1326             temp-changes.v_old  = trim( v-old-value )
     1327             temp-changes.v_new  = trim( v-new-value )
     1328             temp-changes.num_   = 0
     1329             temp-changes.fNotChange = v-old-value eq v-new-value
     1330           .
     1331         end.
     1332       end.
     1333     end.
     1334     assign
     1335       v-num-entries = num-entries( p-label-form, chr(8) )
     1336     .
     1337     do v-ind = 1 to v-num-entries
     1338     on error undo, return error return-value
     1339     :
     1340       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1341         assign
     1342           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1343           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1344           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1345         .
     1346         find first temp-changes
     1347           where temp-changes.f_name = v-field-name
     1348           no-error .
     1349         if available temp-changes then do:
     1350           if trim( v-field-lvl ) <> "":U then do:
     1351             assign
     1352               temp-changes.l_name = v-field-lvl
     1353             .
     1354           end.
     1355           if trim( v-field-form ) <> "":U then do:
     1356             assign
     1357               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1358             .
     1359             if h-for-comp <> ? then do:
     1360               assign
     1361                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1362               .
     1363             end.
     1364           end.
     1365         end.
     1366       end.
     1367       else do:
     1368         message
     1369           vss-workfile vss-revision vss-description skip
     1370           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1371           substitute( "список для поля '&1': '&2'"
     1372                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1373                       ,entry( v-ind, p-label-form, chr(8) )
     1374                     ) skip
     1375           substitute( "полный список: &2", p-label-form ) skip
     1376           view-as alert-box error .
     1377       end.
     1378     end.
     1379     delete object h-new-buf .
     1380     delete object h-main-buf .
     1381   END PROCEDURE.
     1382   FUNCTION get-action RETURNS CHARACTER
     1383     ( p-action as integer )  FORWARD.
     1384   FUNCTION get-cli RETURNS CHARACTER
     1385     ( p-d-card as character )  FORWARD.
     1386   FUNCTION get-source-type RETURNS CHARACTER
     1387     ( p-source-type as character )  FORWARD.
     1388   FUNCTION get-subject RETURNS CHARACTER
     1389     ( p-subject as character )  FORWARD.
     1390   DEFINE BUTTON B-Help
     1391        LABEL "Помо&щь"
     1392        SIZE 3 BY 1
     1393        BGCOLOR 8 .
     1394   DEFINE BUTTON B-lookup
     1395        LABEL "&Дкарта"
     1396        SIZE 10 BY 1.
     1397   DEFINE BUTTON B-mark
     1398        LABEL "&*"
     1399        SIZE 3 BY 1.
     1400   DEFINE BUTTON B-print
     1401        LABEL "Пе&чать"
     1402        SIZE 3 BY 1.
     1403   DEFINE BUTTON b-quit AUTO-END-KEY
     1404        LABEL "&Выход"
     1405        SIZE 10 BY 1
     1406        BGCOLOR 8 .
     1407   DEFINE BUTTON B-sch
     1408        LABEL "&Фильтр"
     1409        SIZE 3 BY 1.
     1410   DEFINE BUTTON b-sel AUTO-GO
     1411        LABEL "Вы&бор"
     1412        SIZE 10 BY 1
     1413        BGCOLOR 8 .
     1414   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1415         VIEW-AS TEXT
     1416        SIZE 6 BY 1
     1417        FGCOLOR 4  NO-UNDO.
     1418   DEFINE VARIABLE sch-corr-date AS DATE FORMAT "99/99/9999":U
     1419        LABEL "Дате изменения"
     1420        VIEW-AS FILL-IN
     1421        SIZE 11 BY 1 NO-UNDO.
     1422   DEFINE VARIABLE sch-corr-user-name AS CHARACTER FORMAT "X(9)":U
     1423        LABEL "пользователю"
     1424        VIEW-AS FILL-IN
     1425        SIZE 12 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1426   DEFINE VARIABLE sch-d-card AS CHARACTER FORMAT "X(16)":U INITIAL "0"
     1427        LABEL "номеру"
     1428        VIEW-AS FILL-IN
     1429        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1430   DEFINE VARIABLE sch-db-num AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1431        LABEL "БД"
     1432        VIEW-AS FILL-IN
     1433        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1434   DEFINE VARIABLE v-corr-user-db-num AS INTEGER FORMAT ">>>>9":U INITIAL 0
     1435        LABEL "по БД"
     1436        VIEW-AS FILL-IN
     1437        SIZE 7.5 BY 1 NO-UNDO.
     1438   DEFINE QUERY BR-changes FOR
     1439         temp-changes SCROLLING.
     1440   DEFINE QUERY br-dc-hist FOR
     1441         X_c-dc-hist SCROLLING.
     1442   DEFINE BROWSE BR-changes
     1443     QUERY BR-changes DISPLAY
     1444         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1445   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1446   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1447       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.25.
     1448   DEFINE BROWSE br-dc-hist
     1449     QUERY br-dc-hist NO-LOCK DISPLAY
     1450         mark-string(recid(X_c-dc-hist), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1451         X_c-dc-hist.corr-date FORMAT "99/99/9999":U
     1452         usrfulnf(X_c-dc-hist.corr-user-name) FORMAT "X(18)":U
     1453         string(X_c-dc-hist.corr-time, "HH:MM:SS":U) COLUMN-LABEL "Время изм." FORMAT "X(8)":U
     1454         X_c-dc-hist.corr-user-db-num FORMAT ">>>>9":U
     1455         X_c-dc-hist.is-news FORMAT "+/":U
     1456         get-action(X_c-dc-hist.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1457         X_c-dc-hist.source-ref FORMAT "X(255)":U WIDTH 15
     1458         X_c-dc-hist.host-code COLUMN-LABEL "Фирма" FORMAT "99999":U
     1459         X_c-dc-hist.d-card COLUMN-LABEL "Дкарта" FORMAT "X(19)":U
     1460         get-source-type(X_c-dc-hist.source-type) COLUMN-LABEL "Источн.!измен."
     1461         if v-find then get-cli(X_c-dc-hist.d-card) else "":U COLUMN-LABEL "Влад-ц карты" FORMAT "X(12)":U
     1462         v-cli-name COLUMN-LABEL "Имя влад-ца карты" FORMAT "X(20)":U
     1463         get-subject(X_c-dc-hist.subject) COLUMN-LABEL "Предмет изменений" FORMAT "X(15)":U
     1464         X_c-dc-hist.obj-type + string(X_c-dc-hist.obj-code) COLUMN-LABEL "Объект" FORMAT "X(8)":U
     1465     ENABLE
     1466         X_c-dc-hist.corr-date
     1467       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.46.
     1468   DEFINE FRAME Dialog-Frame
     1469        b-quit AT ROW 1 COL 1
     1470        B-mark AT ROW 1 COL 11
     1471        b-sel AT ROW 1 COL 21
     1472        v-corr-user-db-num AT ROW 1 COL 37 COLON-ALIGNED
     1473        B-lookup AT ROW 1 COL 51
     1474        B-print AT ROW 1 COL 89
     1475        B-sch AT ROW 1 COL 92
     1476        B-Help AT ROW 1 COL 95
     1477        br-dc-hist AT ROW 2 COL 1
     1478        sch-db-num AT ROW 13.63 COL 60.13 COLON-ALIGNED
     1479        sch-corr-date AT ROW 13.63 COL 85.75 COLON-ALIGNED
     1480        sch-d-card AT ROW 13.67 COL 48.13 COLON-ALIGNED
     1481        sch-corr-user-name AT ROW 13.71 COL 22.5 COLON-ALIGNED
     1482        BR-changes AT ROW 14.79 COL 1
     1483        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1484        "ПОИСК ПО" VIEW-AS TEXT
     1485             SIZE 8.38 BY 1 AT ROW 13.63 COL 1.38
     1486             FGCOLOR 4
     1487        SPACE(89.48) SKIP(7.44)
     1488       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1489            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1490            TITLE "Полная история по ДК"
     1491            CANCEL-BUTTON b-quit.
     1492   ASSIGN
     1493          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1494          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1495   ASSIGN
     1496          br-dc-hist:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     1497   ON GO OF FRAME Dialog-Frame
     1498   DO:
     1499     p-rid-list = v-rid-list.
     1500   END.
     1501   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1502   DO:
     1503     APPLY "END-ERROR":U TO SELF.
     1504   END.
     1505   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1506   DO:
     1507   define variable loc#log as logical no-undo .
     1508     if available X_c-dc-hist then do:
     1509   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1510   define variable v-str-recid14 as character no-undo .
     1511   define variable v-num-entry14 as integer   no-undo .
     1512   assign
     1513     v-str-recid14 = trim( string( recid( X_c-dc-hist ) , "->>>>>>>>>>>9":U ) )
     1514     v-num-entry14 = lookup( v-str-recid14 , v-rid-list )
     1515   .
     1516   if v-num-entry14 > 0 then do:
     1517     assign
     1518       entry( v-num-entry14, v-rid-list ) = "":U
     1519       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1520     .
     1521   end.
     1522   else do:
     1523     assign
     1524       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid14
     1525     .
     1526   end.
     1527       loc#log = br-dc-hist:refresh() .
     1528       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1529           loc#log = br-dc-hist:select-next-row ().
     1530           apply "VALUE-CHANGED" to br-dc-hist in frame Dialog-Frame.
     1531       end.
     1532       if num-entries( v-rid-list ) = 0
     1533       then
     1534           hide mark-num in frame Dialog-Frame.
     1535       else
     1536           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1537     end.
     1538     apply "entry" to br-dc-hist in frame Dialog-Frame.
     1539   END.
     1540   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1541   DO:
     1542     run proc-b-print in this-procedure no-error.
     1543     if error-status:error then return no-apply.
     1544   END.
     1545   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1546   DO:
     1547     run proc-b-sch in this-procedure no-error.
     1548     if error-status:error then return no-apply.
     1549   END.
     1550   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1551   DO:
     1552     if ( available X_c-dc-hist ) then do:
     1553       if ( v-rid-list = "" ) or b-mark:sensitive = no
     1554       then
     1555       v-rid-list = string( recid( X_c-dc-hist ) ) .
     1556     end.
     1557   END.
     1558   ON MOUSE-SELECT-DBLCLICK OF br-dc-hist IN FRAME Dialog-Frame
     1559   DO:
     1560      run proc-br-dc-hist in this-procedure no-error.
     1561     if error-status:error then return no-apply.
     1562   END.
     1563   ON RETURN OF br-dc-hist IN FRAME Dialog-Frame
     1564   DO:
     1565     run proc-br-dc-hist in this-procedure no-error.
     1566     if error-status:error then return no-apply.
     1567   END.
     1568   ON VALUE-CHANGED OF br-dc-hist IN FRAME Dialog-Frame
     1569   DO:
     1570     run proc-view-changes in this-procedure no-error.
     1571   END.
     1572   ON CTRL-J OF sch-corr-date IN FRAME Dialog-Frame
     1573   DO:
     1574      run proc-find-corr-date in this-procedure ( yes, input frame Dialog-Frame sch-corr-date) no-error.
     1575     if error-status:error then return no-apply.
     1576   END.
     1577   ON RETURN OF sch-corr-date IN FRAME Dialog-Frame
     1578   DO:
     1579     run proc-find-corr-date in this-procedure ( no, input frame Dialog-Frame sch-corr-date) no-error.
     1580     if error-status:error then return no-apply.
     1581   END.
     1582   ON CTRL-J OF sch-corr-user-name IN FRAME Dialog-Frame
     1583   DO:
     1584     run proc-find-user in this-procedure ( yes, input frame Dialog-Frame sch-corr-user-name) no-error.
     1585     if error-status:error then return no-apply.
     1586   END.
     1587   ON RETURN OF sch-corr-user-name IN FRAME Dialog-Frame
     1588   DO:
     1589     run proc-find-user in this-procedure ( no, input frame Dialog-Frame sch-corr-user-name) no-error.
     1590     if error-status:error then return no-apply.
     1591   END.
     1592   ON CTRL-J OF sch-d-card IN FRAME Dialog-Frame
     1593   DO:
     1594     run proc-find-d-card in this-procedure ( yes, input frame Dialog-Frame sch-d-card) no-error.
     1595     if error-status:error then return no-apply.
     1596   END.
     1597   ON RETURN OF sch-d-card IN FRAME Dialog-Frame
     1598   DO:
     1599     run proc-find-d-card in this-procedure ( no, input frame Dialog-Frame sch-d-card) no-error.
     1600     if error-status:error then return no-apply.
     1601   END.
     1602   ON CTRL-J OF sch-db-num IN FRAME Dialog-Frame
     1603   DO:
     1604     run proc-find-db-num in this-procedure ( yes, input frame Dialog-Frame sch-db-num) no-error.
     1605     if error-status:error then return no-apply.
     1606   END.
     1607   ON RETURN OF sch-db-num IN FRAME Dialog-Frame
     1608   DO:
     1609     run proc-find-db-num in this-procedure ( no, input frame Dialog-Frame sch-db-num) no-error.
     1610     if error-status:error then return no-apply.
     1611   END.
     1612   ON RETURN OF v-corr-user-db-num IN FRAME Dialog-Frame
     1613   DO:
     1614     assign
     1615     v-corr-user-db-num
     1616     .
     1617     RUn OpenBR in this-procedure ( input yes, input no, input '':U, input v-corr-user-db-num).
     1618   END.
     1619   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1620   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1621   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1622   on help of frame Dialog-Frame
     1623   do:
     1624     run gbl/app_help.p
     1625       (input this-procedure :file-name
     1626       ,input ''
     1627       ,input ?
     1628       ) no-error.
     1629     if error-status :error then do:
     1630       message
     1631         "Ошибка при вызове помощи"
     1632         error-status :get-message(1)
     1633         view-as alert-box .
     1634     end.
     1635   end.
     1636   run minbtn-set in this-procedure .
     1637   on choose of b-help in frame Dialog-Frame
     1638   do:
     1639     apply "help":u to frame Dialog-Frame .
     1640   end.
     1641   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1642   procedure minbtn-set :
     1643       do
     1644           on error undo, return error return-value
     1645           :
     1646           define variable ii              as integer       no-undo .
     1647           define variable fh              as widget-handle no-undo .
     1648           define variable hh              as widget-handle no-undo .
     1649           define variable v-h             as handle        extent 4 no-undo .
     1650           define variable v-name-button   as character     no-undo .
     1651           define variable v-help-old-x    as decimal       no-undo .
     1652           define variable v-help-old-y    as decimal       no-undo .
     1653           define variable v-help-old-size as decimal       no-undo .
     1654           define variable v-frame-width   as decimal       no-undo .
     1655           define variable jj              as integer       no-undo .
     1656           do
     1657               on error undo, return error
     1658               :
     1659               assign
     1660                   v-frame-width = frame Dialog-Frame:width - 0.3
     1661                   fh            = frame Dialog-Frame:first-child
     1662                   hh            = fh:first-child
     1663                   ii            = 1
     1664                   .
     1665               do while valid-handle(hh):
     1666                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1667                   do:
     1668                       case lc(hh:name) :
     1669                           when "b-help" then
     1670                               do:
     1671                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1672                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1673                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1674                                   hh:TOOLTIP = "Помощь" .
     1675                                   v-help-old-x = hh:column .
     1676                                   v-help-old-y = hh:row    .
     1677                                   v-help-old-size = hh:width .
     1678                                   hh:width-chars = 2.5 .
     1679                               end.
     1680                           when "b-print" then
     1681                               do:
     1682                                   hh:load-image("cmp/b-print.bmp":u) .
     1683                                   hh:TOOLTIP = "Печать" .
     1684                                   v-h[ii] = hh:handle .
     1685                                   ii = ii + 1 .
     1686                                   hh:width-chars = 3 .
     1687                               end.
     1688                           when "b-history" or
     1689                           when "b-hist" then
     1690                               do:
     1691                                   hh:load-image("cmp/b-hist.bmp":u) .
     1692                                   hh:TOOLTIP = "История" .
     1693                                   v-h[ii] = hh:handle .
     1694                                   ii = ii + 1 .
     1695                                   hh:width-chars = 3 .
     1696                               end.
     1697                           when "b-sch" then
     1698                               do:
     1699                                   hh:load-image("cmp/b-sch.bmp":u) .
     1700                                   hh:TOOLTIP = "Установка Фильтра" .
     1701                                   v-h[ii] = hh:handle .
     1702                                   ii = ii + 1 .
     1703                                   hh:width-chars = 3 .
     1704                               end.
     1705                           when "b-hist-user" then
     1706                               do:
     1707                                   hh:load-image("cmp/b-hist.bmp":u) .
     1708                                   hh:TOOLTIP = "История пользователя" .
     1709                                   ii = ii + 1 .
     1710                               end.
     1711                       end case.
     1712                   end.
     1713                   hh = hh:next-sibling.
     1714               end.
     1715               b-help:column = v-frame-width - b-help:width-chars.
     1716               jj = 0.
     1717               repeat ii = 4 to 1 by -1 :
     1718                   if valid-handle (v-h[ii] ) then
     1719                   do:
     1720                       jj  = jj + 1 .
     1721                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1722                       v-h[ii]:row    = v-help-old-y .
     1723                   end.
     1724               end.
     1725           end.
     1726       end.
     1727   end procedure.
     1728   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1729   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1730   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1731   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1732   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1733   define variable v-diasize-current-frame-height as decimal   no-undo .
     1734   define variable v-diasize-change-size          as logical   no-undo .
     1735   define variable v-diasize-resize-button        as handle    no-undo .
     1736   define variable v-diasize-wndmax               as logical   no-undo .
     1737   define variable v-diasize-wndstore             as logical   no-undo .
     1738   define variable v-diasize-proc-name            as character no-undo .
     1739   define variable v-diasize-browse-handle        as handle    no-undo .
     1740   define variable v-diasize-browse-number        as integer   no-undo .
     1741   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1742   define temp-table temp-diasize-handle no-undo
     1743     field handle-value  as handle
     1744     field save-position as decimal
     1745     index xpk is primary unique handle-value
     1746     .
     1747   define temp-table temp-browse-handle no-undo
     1748     field browse-type   as character
     1749     field browse-number as integer
     1750     field browse-handle as handle
     1751     field original-size as decimal
     1752     index xpk is primary unique browse-type browse-number
     1753     index xie browse-type browse-handle
     1754   .
     1755   procedure diasize_change-height :
     1756     define input  parameter p-change-value  as decimal   no-undo .
     1757     define input  parameter p-move-resize   as logical   no-undo .
     1758     define variable v-field-group-handle    as handle    no-undo .
     1759     define variable v-object-handle         as handle    no-undo .
     1760     define variable v-frame-height          as decimal   no-undo .
     1761     define variable v-frame-virtual-height  as decimal   no-undo .
     1762     define variable v-browse-height         as decimal   no-undo .
     1763     define variable v-window-height         as decimal   no-undo .
     1764     define variable v-window-virtual-height as decimal   no-undo .
     1765     define variable v-change-sign           as integer   no-undo .
     1766     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1767     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1768     if p-change-value > 0
     1769     then do:
     1770       if frame Dialog-Frame :height + p-change-value
     1771           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1772       then do:
     1773         assign
     1774           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1775                           - (frame Dialog-Frame :height-chars)
     1776         .
     1777         if p-change-value <= 0
     1778         then do:
     1779           run diasize_position-resize-button in this-procedure .
     1780           return .
     1781         end.
     1782       end.
     1783     end.
     1784     if p-change-value < 0
     1785     then do:
     1786       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1787       then do:
     1788         assign
     1789           p-change-value = v-diasize-orig-frame-height
     1790                          - (frame Dialog-Frame :height-chars)
     1791         .
     1792         if p-change-value >= 0
     1793         then do:
     1794           run diasize_position-resize-button in this-procedure .
     1795           return .
     1796         end.
     1797       end.
     1798     end.
     1799     if p-change-value >= 0
     1800     then do:
     1801       assign
     1802         v-change-sign = 1
     1803       .
     1804     end.
     1805     else do:
     1806       assign
     1807         v-change-sign = -1
     1808       .
     1809     end.
     1810     assign
     1811       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1812     .
     1813     if p-change-value = 0
     1814     then do:
     1815       run diasize_position-resize-button in this-procedure .
     1816       return .
     1817     end.
     1818     move_block:
     1819     do
     1820     on error undo move_block, retry move_block
     1821     :
     1822       if retry
     1823       then do:
     1824         do
     1825         on error undo move_block, leave move_block
     1826         :
     1827           if p-change-value > 0
     1828           then do:
     1829             for each buf_temp-diasize-handle
     1830             on error undo, next
     1831             :
     1832               assign
     1833                 v-object-handle = buf_temp-diasize-handle.handle-value
     1834               .
     1835               if v-object-handle <> v-diasize-resize-button
     1836               then do:
     1837                 assign
     1838                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1839                 .
     1840               end.
     1841             end.
     1842             assign
     1843               v-diasize-browse-handle :height = v-browse-height
     1844             .
     1845             for each buf_temp-browse-handle
     1846               where buf_temp-browse-handle.browse-type = 'height':u
     1847             on error undo, next
     1848             :
     1849               assign
     1850                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1851               .
     1852             end.
     1853             assign
     1854               frame Dialog-Frame :height = v-frame-height
     1855             .
     1856             if frame Dialog-Frame :scrollable = true
     1857             then do:
     1858               assign
     1859                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1860               .
     1861             end.
     1862             run diasize_position-resize-button in this-procedure .
     1863           end.
     1864           else do:
     1865             if frame Dialog-Frame :scrollable = true
     1866             then do:
     1867               assign
     1868                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1869               .
     1870             end.
     1871             assign
     1872               frame Dialog-Frame :height = v-frame-height
     1873             .
     1874             assign
     1875               v-diasize-browse-handle :height = v-browse-height
     1876             .
     1877             for each buf_temp-browse-handle
     1878               where buf_temp-browse-handle.browse-type = 'height':u
     1879             on error undo, next
     1880             :
     1881               assign
     1882                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1883               .
     1884             end.
     1885             for each buf_temp-diasize-handle
     1886             on error undo, next
     1887             :
     1888               assign
     1889                 v-object-handle = buf_temp-diasize-handle.handle-value
     1890               .
     1891               if v-object-handle <> v-diasize-resize-button
     1892               then do:
     1893                 assign
     1894                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1895                 .
     1896               end.
     1897             end.
     1898             run diasize_position-resize-button in this-procedure .
     1899           end.
     1900           assign
     1901             v-diasize-change-size = false
     1902           .
     1903           leave move_block .
     1904         end.
     1905       end.
     1906       assign
     1907         v-diasize-need-full-display = true
     1908       .
     1909       if v-diasize-change-size = false
     1910       then do:
     1911         assign
     1912           v-diasize-change-size = true
     1913         .
     1914       end.
     1915       else do:
     1916         return .
     1917       end.
     1918       assign
     1919         v-frame-height = frame Dialog-Frame :height
     1920         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1921         v-browse-height = v-diasize-browse-handle :height
     1922       .
     1923       for each buf_temp-browse-handle
     1924         where buf_temp-browse-handle.browse-type = 'height':u
     1925       :
     1926         assign
     1927           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1928         .
     1929       end.
     1930       for each buf_temp-diasize-handle
     1931       :
     1932         delete buf_temp-diasize-handle .
     1933       end.
     1934       assign
     1935         v-field-group-handle = frame Dialog-Frame :first-child
     1936       .
     1937       do while valid-handle(v-field-group-handle)
     1938       :
     1939         assign
     1940           v-object-handle = v-field-group-handle :first-child
     1941         .
     1942         do while valid-handle(v-object-handle)
     1943         :
     1944           if  v-object-handle <> v-diasize-browse-handle :handle
     1945           and can-query(v-object-handle, "row")
     1946           and can-query(v-object-handle, "height")
     1947           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1948           then do:
     1949             find first buf_temp-browse-handle
     1950               where buf_temp-browse-handle.browse-type   = 'height':u
     1951                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1952               no-error .
     1953             if available buf_temp-browse-handle
     1954             then do:
     1955             end.
     1956             else do:
     1957               create buf_temp-diasize-handle .
     1958               assign
     1959                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1960                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1961               .
     1962             end.
     1963           end.
     1964           assign
     1965             v-object-handle = v-object-handle :next-sibling
     1966           .
     1967         end.
     1968         assign
     1969           v-field-group-handle = v-field-group-handle :next-sibling
     1970         .
     1971       end.
     1972       do with frame Dialog-Frame
     1973       :
     1974         hide v-diasize-resize-button .
     1975         assign
     1976           v-diasize-resize-button :row    = 1
     1977           v-diasize-resize-button :column = 1
     1978         .
     1979       end.
     1980       if p-change-value > 0
     1981       then do:
     1982         if frame Dialog-Frame :scrollable = true
     1983         then do:
     1984           assign
     1985             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1986             no-error .
     1987           if error-status :error
     1988           or error-status :get-message(1) <> ""
     1989           then do:
     1990             undo move_block, retry move_block .
     1991           end.
     1992         end.
     1993         assign
     1994           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1995           no-error .
     1996         if error-status :error
     1997         or error-status :get-message(1) <> ""
     1998         then do:
     1999           undo move_block, retry move_block .
     2000         end.
     2001         assign
     2002           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2003           no-error .
     2004         if error-status :error
     2005         or error-status :get-message(1) <> ""
     2006         then do:
     2007           undo move_block, retry move_block .
     2008         end.
     2009         for each buf_temp-browse-handle
     2010           where buf_temp-browse-handle.browse-type = 'height':u
     2011         on error undo move_block, retry move_block
     2012         :
     2013           assign
     2014             buf_temp-browse-handle.browse-handle :height
     2015               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2016             no-error .
     2017           if error-status :error
     2018           or error-status :get-message(1) <> ""
     2019           then do:
     2020             undo move_block, retry move_block .
     2021           end.
     2022         end.
     2023         for each buf_temp-diasize-handle
     2024         on error undo move_block, retry move_block
     2025         :
     2026           assign
     2027             v-object-handle = buf_temp-diasize-handle.handle-value
     2028           .
     2029           if v-object-handle <> v-diasize-resize-button
     2030           then do:
     2031             assign
     2032               v-object-handle :row = v-object-handle :row + p-change-value
     2033               no-error .
     2034             if error-status :error
     2035             or error-status :get-message(1) <> ""
     2036             then do:
     2037               undo move_block, retry move_block .
     2038             end.
     2039           end.
     2040         end.
     2041       end.
     2042       else do:
     2043         for each buf_temp-diasize-handle
     2044         on error undo move_block, retry move_block
     2045         :
     2046           assign
     2047             v-object-handle = buf_temp-diasize-handle.handle-value
     2048           .
     2049           if v-object-handle <> v-diasize-resize-button
     2050           then do:
     2051             assign
     2052               v-object-handle :row = v-object-handle :row + p-change-value
     2053               no-error .
     2054             if error-status :error
     2055             or error-status :get-message(1) <> ""
     2056             then do:
     2057               undo move_block, retry move_block .
     2058             end.
     2059           end.
     2060         end.
     2061         assign
     2062           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2063           no-error .
     2064         if error-status :error
     2065         or error-status :get-message(1) <> ""
     2066         then do:
     2067           undo move_block, retry move_block .
     2068         end.
     2069         for each buf_temp-browse-handle
     2070           where buf_temp-browse-handle.browse-type = 'height':u
     2071         on error undo move_block, retry move_block
     2072         :
     2073           assign
     2074             buf_temp-browse-handle.browse-handle :height
     2075               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2076             no-error .
     2077           if error-status :error
     2078           or error-status :get-message(1) <> ""
     2079           then do:
     2080             undo move_block, retry move_block .
     2081           end.
     2082         end.
     2083         assign
     2084           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2085           no-error .
     2086         if error-status :error
     2087         or error-status :get-message(1) <> ""
     2088         then do:
     2089           undo move_block, retry move_block .
     2090         end.
     2091         if frame Dialog-Frame :scrollable = true
     2092         then do:
     2093           assign
     2094             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2095             no-error .
     2096           if error-status :error
     2097           or error-status :get-message(1) <> ""
     2098           then do:
     2099             undo move_block, retry move_block .
     2100           end.
     2101         end.
     2102       end.
     2103       if p-move-resize = true
     2104       then do:
     2105         run diasize_position-resize-button in this-procedure .
     2106       end.
     2107       if v-diasize-wndstore = true
     2108       then do:
     2109         if connected("ub") = true
     2110         then do:
     2111           define variable v-cntxt-db-num        as integer   no-undo .
     2112           define variable v-cntxt-userid        as character no-undo .
     2113           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2114                                             , OUTPUT v-cntxt-userid
     2115                                             ) .
     2116           run gbl/wndsizew.p
     2117             (input  v-cntxt-db-num
     2118             ,input  v-cntxt-userid
     2119             ,input  v-diasize-proc-name
     2120             ,input  'height':u
     2121             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2122             ) .
     2123         end.
     2124       end.
     2125     end.
     2126     assign
     2127       v-diasize-change-size = false
     2128     .
     2129   end procedure.
     2130   procedure diasize_set-height :
     2131     define input  parameter p-new-height  as decimal   no-undo .
     2132     define input  parameter p-move-resize as logical   no-undo .
     2133     do
     2134     on error undo, return error return-value
     2135     :
     2136       run diasize_change-height in this-procedure
     2137         (input  (p-new-height - frame Dialog-Frame :height)
     2138         ,input  p-move-resize
     2139         ) .
     2140     end.
     2141   end procedure.
     2142   procedure diasize_change-width :
     2143     define input  parameter p-change-value as decimal   no-undo .
     2144     define input  parameter p-move-resize  as logical   no-undo .
     2145     define variable v-field-group-handle   as handle    no-undo .
     2146     define variable v-object-handle        as handle    no-undo .
     2147     define variable v-frame-width          as decimal   no-undo .
     2148     define variable v-frame-virtual-width  as decimal   no-undo .
     2149     define variable v-browse-width         as decimal   no-undo .
     2150     define variable v-window-width         as decimal   no-undo .
     2151     define variable v-window-virtual-width as decimal   no-undo .
     2152     define variable v-change-sign          as integer   no-undo .
     2153     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2154     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2155     if p-change-value > 0
     2156     then do:
     2157       if frame Dialog-Frame :width + p-change-value >
     2158           session :width-chars
     2159       then do:
     2160         assign
     2161           p-change-value = session :width-chars - frame Dialog-Frame :width
     2162         .
     2163         if p-change-value <= 0
     2164         then do:
     2165           run diasize_position-resize-button in this-procedure .
     2166           return .
     2167         end.
     2168       end.
     2169     end.
     2170     if p-change-value < 0
     2171     then do:
     2172       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2173       then do:
     2174         assign
     2175           p-change-value = v-diasize-orig-frame-width
     2176                          - frame Dialog-Frame :width
     2177         .
     2178         if p-change-value >= 0
     2179         then do:
     2180           run diasize_position-resize-button in this-procedure .
     2181           return .
     2182         end.
     2183       end.
     2184     end.
     2185     if p-change-value >= 0
     2186     then do:
     2187       assign
     2188         v-change-sign = 1
     2189       .
     2190     end.
     2191     else do:
     2192       assign
     2193         v-change-sign = -1
     2194       .
     2195     end.
     2196     assign
     2197       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2198     .
     2199     if p-change-value = 0
     2200     then do:
     2201       run diasize_position-resize-button in this-procedure .
     2202       return .
     2203     end.
     2204     move_block:
     2205     do
     2206     on error undo move_block, leave move_block
     2207     :
     2208       if retry
     2209       then do:
     2210         do
     2211         on error undo move_block, leave move_block
     2212         :
     2213           if p-change-value > 0
     2214           then do:
     2215             for each buf_temp-diasize-handle
     2216             on error undo, next
     2217             :
     2218               assign
     2219                 v-object-handle = buf_temp-diasize-handle.handle-value
     2220               .
     2221               if v-object-handle <> v-diasize-resize-button
     2222               then do:
     2223                 assign
     2224                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2225                 .
     2226               end.
     2227             end.
     2228             assign
     2229               v-diasize-browse-handle :width = v-browse-width
     2230             .
     2231             for each buf_temp-browse-handle
     2232               where buf_temp-browse-handle.browse-type = 'width':u
     2233             on error undo, next
     2234             :
     2235               assign
     2236                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2237               .
     2238             end.
     2239             assign
     2240               frame Dialog-Frame :width = v-frame-width
     2241             .
     2242             if frame Dialog-Frame :scrollable = true
     2243             then do:
     2244               assign
     2245                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2246               .
     2247             end.
     2248             run diasize_position-resize-button in this-procedure .
     2249           end.
     2250           else do:
     2251             if frame Dialog-Frame :scrollable = true
     2252             then do:
     2253               assign
     2254                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2255               .
     2256             end.
     2257             assign
     2258               frame Dialog-Frame :width = v-frame-width
     2259             .
     2260             for each buf_temp-browse-handle
     2261               where buf_temp-browse-handle.browse-type = 'width':u
     2262             on error undo, next
     2263             :
     2264               assign
     2265                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2266               .
     2267             end.
     2268             assign
     2269               v-diasize-browse-handle :width = v-browse-width
     2270             .
     2271             for each buf_temp-diasize-handle
     2272             on error undo, next
     2273             :
     2274               assign
     2275                 v-object-handle = buf_temp-diasize-handle.handle-value
     2276               .
     2277               if v-object-handle <> v-diasize-resize-button
     2278               then do:
     2279                 assign
     2280                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2281                 .
     2282               end.
     2283             end.
     2284             run diasize_position-resize-button in this-procedure .
     2285           end.
     2286           assign
     2287             v-diasize-change-size = false
     2288           .
     2289           leave move_block .
     2290         end.
     2291       end.
     2292       assign
     2293         v-diasize-need-full-display = true
     2294       .
     2295       if v-diasize-change-size = false
     2296       then do:
     2297         assign
     2298           v-diasize-change-size = true
     2299         .
     2300       end.
     2301       else do:
     2302         return .
     2303       end.
     2304       assign
     2305         v-frame-width = frame Dialog-Frame :width
     2306         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2307         v-browse-width = v-diasize-browse-handle :width
     2308       .
     2309       for each buf_temp-browse-handle
     2310         where buf_temp-browse-handle.browse-type = 'width':u
     2311       :
     2312         assign
     2313           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2314         .
     2315       end.
     2316       for each buf_temp-diasize-handle
     2317       :
     2318         delete buf_temp-diasize-handle .
     2319       end.
     2320       assign
     2321         v-field-group-handle = frame Dialog-Frame :first-child
     2322       .
     2323       do while valid-handle(v-field-group-handle)
     2324       :
     2325         assign
     2326           v-object-handle = v-field-group-handle :first-child
     2327         .
     2328         do while valid-handle(v-object-handle)
     2329         :
     2330           if  v-object-handle <> v-diasize-browse-handle :handle
     2331           and v-object-handle <> v-diasize-resize-button
     2332           and can-query(v-object-handle, "row")
     2333           and can-query(v-object-handle, "height")
     2334           and ( v-object-handle :col + v-object-handle :width
     2335                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2336               )
     2337           then do:
     2338             find first buf_temp-browse-handle
     2339               where buf_temp-browse-handle.browse-type   = 'width':u
     2340                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2341               no-error .
     2342             if available buf_temp-browse-handle
     2343             then do:
     2344             end.
     2345             else do:
     2346               create buf_temp-diasize-handle .
     2347               assign
     2348                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2349                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2350               .
     2351             end.
     2352           end.
     2353           assign
     2354             v-object-handle = v-object-handle :next-sibling
     2355           .
     2356         end.
     2357         assign
     2358           v-field-group-handle = v-field-group-handle :next-sibling
     2359         .
     2360       end.
     2361       do with frame Dialog-Frame
     2362       :
     2363         hide v-diasize-resize-button .
     2364         v-diasize-resize-button :row = 1.
     2365         v-diasize-resize-button :column = 1.
     2366       end.
     2367       if p-change-value > 0
     2368       then do:
     2369         if frame Dialog-Frame :scrollable = true
     2370         then do:
     2371           assign
     2372             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2373             no-error .
     2374           if error-status :error
     2375           or error-status :get-message(1) <> ""
     2376           then do:
     2377             undo move_block, retry move_block.
     2378           end.
     2379         end.
     2380         assign
     2381           frame Dialog-Frame :width = v-frame-width + p-change-value
     2382           no-error .
     2383         if error-status :error
     2384         or error-status :get-message(1) <> ""
     2385         then do:
     2386           undo move_block, retry move_block.
     2387         end.
     2388         assign
     2389           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2390         no-error .
     2391         if error-status :error
     2392         or error-status :get-message(1) <> ""
     2393         then do:
     2394           undo move_block, retry move_block.
     2395         end.
     2396         for each buf_temp-browse-handle
     2397           where buf_temp-browse-handle.browse-type = 'width':u
     2398         on error undo move_block, retry move_block
     2399         :
     2400           assign
     2401             buf_temp-browse-handle.browse-handle :width
     2402               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2403             no-error .
     2404           if error-status :error
     2405           or error-status :get-message(1) <> ""
     2406           then do:
     2407             undo move_block, retry move_block .
     2408           end.
     2409         end.
     2410         for each buf_temp-diasize-handle
     2411         on error undo move_block, retry move_block
     2412         :
     2413           assign
     2414             v-object-handle = buf_temp-diasize-handle.handle-value
     2415           .
     2416           if v-object-handle <> v-diasize-resize-button
     2417           then do:
     2418             assign
     2419               v-object-handle :col = v-object-handle :col + p-change-value
     2420               no-error .
     2421             if error-status :error
     2422             or error-status :get-message(1) <> ""
     2423             then do:
     2424               undo move_block, retry move_block .
     2425             end.
     2426           end.
     2427         end.
     2428       end.
     2429       else do:
     2430         for each buf_temp-diasize-handle
     2431         on error undo move_block, retry move_block
     2432         :
     2433           assign
     2434             v-object-handle = buf_temp-diasize-handle.handle-value
     2435           .
     2436           if v-object-handle <> v-diasize-resize-button
     2437           then do:
     2438             assign
     2439               v-object-handle :col = v-object-handle :col + p-change-value
     2440               no-error .
     2441             if error-status :error
     2442             or error-status :get-message(1) <> ""
     2443             then do:
     2444               undo move_block, retry move_block .
     2445             end.
     2446           end.
     2447         end.
     2448         for each buf_temp-browse-handle
     2449           where buf_temp-browse-handle.browse-type = 'width':u
     2450         on error undo move_block, retry move_block
     2451         :
     2452           assign
     2453             buf_temp-browse-handle.browse-handle :width
     2454               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2455             no-error .
     2456           if error-status :error
     2457           or error-status :get-message(1) <> ""
     2458           then do:
     2459             undo move_block, retry move_block .
     2460           end.
     2461         end.
     2462         assign
     2463           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2464           no-error .
     2465         if error-status :error
     2466         or error-status :get-message(1) <> ""
     2467         then do:
     2468           undo move_block, retry move_block.
     2469         end.
     2470         assign
     2471           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2472         no-error .
     2473         if error-status :error
     2474         or error-status :get-message(1) <> ""
     2475         then do:
     2476           undo move_block, retry move_block.
     2477         end.
     2478         if frame Dialog-Frame :scrollable = true
     2479         then do:
     2480           assign
     2481             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2482           no-error .
     2483           if error-status :error
     2484           or error-status :get-message(1) <> ""
     2485           then do:
     2486             undo move_block, retry move_block.
     2487           end.
     2488         end.
     2489       end.
     2490       if p-move-resize
     2491       then do:
     2492         run diasize_position-resize-button in this-procedure .
     2493       end.
     2494       if v-diasize-wndstore = true
     2495       then do:
     2496         if connected("ub") = true
     2497         then do:
     2498           define variable v-cntxt-db-num        as integer   no-undo .
     2499           define variable v-cntxt-userid        as character no-undo .
     2500           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2501                                             , OUTPUT v-cntxt-userid
     2502                                             ) .
     2503           run gbl/wndsizew.p
     2504             (input  v-cntxt-db-num
     2505             ,input  v-cntxt-userid
     2506             ,input  v-diasize-proc-name
     2507             ,input  'width':u
     2508             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2509             ) .
     2510         end.
     2511       end.
     2512     end.
     2513     assign
     2514       v-diasize-change-size = false
     2515     .
     2516   end procedure.
     2517   procedure diasize_set-width :
     2518     define input  parameter p-new-width  as decimal   no-undo .
     2519     define input  parameter p-move-resize as logical   no-undo .
     2520     do
     2521     on error undo, return error return-value
     2522     :
     2523       run diasize_change-width in this-procedure
     2524         (input  (p-new-width - frame Dialog-Frame :width)
     2525         ,input  p-move-resize
     2526         ) .
     2527     end.
     2528   end procedure.
     2529   procedure diasize_position-resize-button :
     2530     do with frame Dialog-Frame
     2531     :
     2532       hide v-diasize-resize-button .
     2533       assign
     2534         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2535                     - 1
     2536                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2537         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2538                     - 1
     2539                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2540       .
     2541       view v-diasize-resize-button .
     2542     end.
     2543   end procedure.
     2544   on alt-right anywhere
     2545   do:
     2546     run diasize_change-width in this-procedure
     2547       (input 1
     2548       ,input true
     2549       ) .
     2550     return no-apply .
     2551   end.
     2552   on alt-left anywhere
     2553   do:
     2554     run diasize_change-width in this-procedure
     2555       (input -1
     2556       ,input true
     2557       ) .
     2558     return no-apply .
     2559   end.
     2560   on alt-down anywhere
     2561   do:
     2562     run diasize_change-height in this-procedure
     2563       (input 1
     2564       ,input true
     2565       ) .
     2566     return no-apply .
     2567   end.
     2568   on alt-up anywhere
     2569   do:
     2570     run diasize_change-height in this-procedure
     2571       (input -1
     2572       ,input true
     2573       ) .
     2574     return no-apply .
     2575   end.
     2576   on alt-enter of frame Dialog-Frame
     2577   do:
     2578     run diasize_maximize in this-procedure
     2579       (input  ?
     2580       ).
     2581     return no-apply .
     2582   end.
     2583   procedure diasize_end-move :
     2584     do
     2585     on error undo, return error return-value
     2586     :
     2587       define variable v-row-delta as decimal   no-undo .
     2588       define variable v-col-delta as decimal   no-undo .
     2589       define variable v-new-row as decimal   no-undo .
     2590       define variable v-new-col as decimal   no-undo .
     2591       assign
     2592         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2593         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2594       .
     2595       assign
     2596         v-row-delta = v-new-row - frame Dialog-Frame :height
     2597         v-col-delta = v-new-col - frame Dialog-Frame :width
     2598       .
     2599       run diasize_change-height in this-procedure
     2600         (input v-row-delta
     2601         ,input true
     2602         ) .
     2603       run diasize_change-width in this-procedure
     2604         (input v-col-delta
     2605         ,input true
     2606         ) .
     2607     end.
     2608   end procedure.
     2609   procedure diasize_maximize :
     2610     define input  parameter p-action as logical   no-undo .
     2611     do
     2612     on error undo, return error return-value
     2613     :
     2614       if p-action = ?
     2615       then do:
     2616         if v-diasize-need-maximize = true
     2617         then do:
     2618           assign
     2619             p-action = true
     2620           .
     2621         end.
     2622         else do:
     2623           assign
     2624             p-action = false
     2625           .
     2626         end.
     2627       end.
     2628       if p-action = true
     2629       then do:
     2630         run diasize_change-height in this-procedure
     2631           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2632               - frame Dialog-Frame :height-chars
     2633           ,input true
     2634           ) .
     2635         run diasize_change-width in this-procedure
     2636           (input session :width-chars
     2637               - frame Dialog-Frame :width-chars
     2638           ,input true
     2639           ) .
     2640         assign
     2641           v-diasize-need-maximize = false
     2642         .
     2643       end.
     2644       else do:
     2645         run diasize_change-width in this-procedure
     2646           (input v-diasize-orig-frame-width
     2647               - frame Dialog-Frame :width-chars
     2648           ,input true
     2649           ) .
     2650         run diasize_change-height in this-procedure
     2651           (input v-diasize-orig-frame-height
     2652               - frame Dialog-Frame :height-chars
     2653           ,input true
     2654           ) .
     2655         assign
     2656           v-diasize-need-maximize = true
     2657         .
     2658       end.
     2659     end.
     2660   end procedure.
     2661   procedure diasize_restore-orig-size :
     2662     do
     2663     on error undo, return error return-value
     2664     :
     2665       assign
     2666         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2667         v-diasize-current-frame-height = frame Dialog-Frame :height
     2668       .
     2669       run diasize_set-height in this-procedure
     2670         (input  v-diasize-orig-frame-height
     2671         ,input  true
     2672         ) .
     2673       run diasize_set-width in this-procedure
     2674         (input  v-diasize-orig-frame-width
     2675         ,input  true
     2676         ) .
     2677     end.
     2678   end procedure.
     2679   procedure diasize_restore-current-size :
     2680     do
     2681     on error undo, return error return-value
     2682     :
     2683       run diasize_set-height in this-procedure
     2684         (input  v-diasize-current-frame-height
     2685         ,input  true
     2686         ) .
     2687       run diasize_set-width in this-procedure
     2688         (input  v-diasize-current-frame-width
     2689         ,input  true
     2690         ) .
     2691     end.
     2692   end procedure.
     2693   procedure diasize_set-browse-handle :
     2694     define input  parameter p-browse-handle as handle   no-undo .
     2695     define buffer buf_temp-browse-handle for temp-browse-handle .
     2696     do
     2697     on error undo, return error return-value
     2698     :
     2699       assign
     2700         v-diasize-browse-handle = p-browse-handle
     2701       .
     2702       for each buf_temp-browse-handle
     2703       on error undo, return error return-value
     2704       :
     2705         delete buf_temp-browse-handle .
     2706       end.
     2707     end.
     2708   end procedure.
     2709   procedure diasize_add_browse :
     2710     define input  parameter p-browse-type   as character no-undo .
     2711     define input  parameter p-browse-handle as handle    no-undo .
     2712     define buffer buf_temp-browse-handle for temp-browse-handle .
     2713     do
     2714     on error undo, return error return-value
     2715     :
     2716       assign
     2717         v-diasize-browse-number = v-diasize-browse-number + 1
     2718       .
     2719       create buf_temp-browse-handle .
     2720       assign
     2721         buf_temp-browse-handle.browse-type   = p-browse-type
     2722         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2723         buf_temp-browse-handle.browse-handle = p-browse-handle
     2724       .
     2725     end.
     2726   end procedure.
     2727   procedure diasize_init :
     2728     define variable v-default-value    as logical   no-undo .
     2729     define variable v-restore-saved    as logical   no-undo .
     2730     define variable v-resize-value-str as character no-undo .
     2731     do
     2732     on error undo, return error return-value
     2733     :
     2734       do with frame Dialog-Frame
     2735       :
     2736         assign
     2737           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2738           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2739           v-diasize-browse-handle     = browse br-dc-hist :handle
     2740         .
     2741         create button v-diasize-resize-button
     2742         assign
     2743           parent        = frame Dialog-Frame :first-child
     2744           label         = "s"
     2745           height-pixels = 16
     2746           width-pixels  = 16
     2747           visible       = true
     2748           sensitive     = true
     2749           movable       = true
     2750           triggers:
     2751             on end-move persistent run diasize_end-move in this-procedure .
     2752           end triggers.
     2753         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2754         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2755         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2756         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2757         assign
     2758           v-diasize-wndmax = false
     2759         .
     2760         if connected("ub") = true
     2761         then do:
     2762           define variable v-cntxt-db-num        as integer   no-undo .
     2763           define variable v-cntxt-userid        as character no-undo .
     2764           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2765                                             , OUTPUT v-cntxt-userid
     2766                                             ) .
     2767           run gbl/wndpar_r.p
     2768             (input  v-cntxt-db-num
     2769             ,input  v-cntxt-userid
     2770             ,input  'wndmax':U
     2771             ,output v-diasize-wndmax
     2772             ,output v-default-value
     2773             ) .
     2774         end.
     2775         assign
     2776           v-diasize-wndstore = false
     2777         .
     2778         if connected("ub") = true
     2779         then do:
     2780           run gbl/wndpar_r.p
     2781             (input  v-cntxt-db-num
     2782             ,input  v-cntxt-userid
     2783             ,input  'wndstore':U
     2784             ,output v-diasize-wndstore
     2785             ,output v-default-value
     2786             ) .
     2787         end.
     2788         assign
     2789           v-diasize-proc-name = entry(1, program-name(2), '.')
     2790         .
     2791         if v-diasize-wndstore = true
     2792         then do:
     2793           assign
     2794             v-restore-saved = false
     2795           .
     2796           if connected("ub") = true
     2797           then do:
     2798             run gbl/wndsizer.p
     2799               (input  v-cntxt-db-num
     2800               ,input  v-cntxt-userid
     2801               ,input  v-diasize-proc-name
     2802               ,input  'height':u
     2803               ,output v-resize-value-str
     2804               ) .
     2805             if v-resize-value-str <> '':U
     2806             then do:
     2807               run diasize_change-height in this-procedure
     2808                 (input  integer(v-resize-value-str)
     2809                 ,input  true
     2810                 ) .
     2811               assign
     2812                 v-restore-saved = true
     2813               .
     2814             end.
     2815           end.
     2816           if connected("ub") = true
     2817           then do:
     2818             run gbl/wndsizer.p
     2819               (input  v-cntxt-db-num
     2820               ,input  v-cntxt-userid
     2821               ,input  v-diasize-proc-name
     2822               ,input  'width':u
     2823               ,output v-resize-value-str
     2824               ) .
     2825             if v-resize-value-str <> '':U
     2826             then do:
     2827               run diasize_change-width in this-procedure
     2828                 (input  integer(v-resize-value-str)
     2829                 ,input  true
     2830                 ) .
     2831               assign
     2832                 v-restore-saved = true
     2833               .
     2834             end.
     2835           end.
     2836           if v-restore-saved <> true
     2837           then do:
     2838             if v-diasize-wndmax = true
     2839             then do:
     2840               run diasize_maximize in this-procedure
     2841                 (input  true
     2842                 ) .
     2843             end.
     2844           end.
     2845         end.
     2846         else do:
     2847           if v-diasize-wndmax = true
     2848           then do:
     2849             run diasize_maximize in this-procedure
     2850               (input  true
     2851               ) .
     2852           end.
     2853         end.
     2854       end.
     2855     end.
     2856   end procedure.
     2857   procedure diasize_need-full-display :
     2858     define output parameter p-need-full-display as logical   no-undo .
     2859     do
     2860     on error undo, return error return-value
     2861     :
     2862       assign
     2863         p-need-full-display = v-diasize-need-full-display
     2864       .
     2865       assign
     2866         v-diasize-need-full-display = false
     2867       .
