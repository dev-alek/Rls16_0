      687       run gbl/prnfilen.w
      688         (input  ""
      689         ,input  p-DisabledOptions
      690         ,input  string(v-report-name )
      691         ,input  7
      692         ,output v-user-action
      693         ,output v-printed
      694         ) .
      695       if v-printed then
