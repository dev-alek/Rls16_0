     3480             ASSIGN frame Dialog-Frame:TITLE = title0 + substitute(" ДКарта &1: &2",
     3481                                                                   p-d-card, v-cli-name ).
     3482           end.
     3483   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
