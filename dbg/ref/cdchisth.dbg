      660   procedure prn-lib-prn-file :
      661     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      662     define input parameter p-DIsabledoptions as integer no-undo .
      663     define variable v-report-name as character no-undo .
      664     define variable v-user-action as character no-undo .
      665     define variable v-printed     as logical   no-undo .
      666     define variable v-exist       as logical   no-undo .
      667     do
      668       on error undo, return error
      669       :
