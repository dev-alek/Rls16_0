     3509       l-filter-open-26 = false
     3510     .
     3511     if flt-rec-26 <> ?
     3512       or sort-column-phrase > ""
     3513     then do:
     3514       define variable  parameter-2-26 as character no-undo .
     3515       define variable  parameter-3-26 as character no-undo .
     3516       define variable  parameter-4-26 as character no-undo .
     3517       define variable  parameter-5-26 as character no-undo .
     3518       define variable  parameter-6-26 as character no-undo .
     3519       define variable  parameter-7-26 as character no-undo .
     3520         assign
     3521         parameter-3-26 =
     3522                                 "FOR EACH X_c-dc-hist"
     3523         parameter-4-26 =
     3524           (
     3525             if ("           X_c-dc-hist.d-card  = p-d-card                          " + " " + where-phrase-26) <> ""
     3526             then  substitute(' X_c-dc-hist.d-card  = &1&2&1', chr(34), p-d-card)   + " " + where-phrase-26
     3527             else "true"
     3528           )
     3529         parameter-5-26 = (" " + "" + " " + "")
     3530         parameter-6-26 = if sort-phrase-26 = ''
     3531                              then
     3532           (
     3533           " " + " " +
     3534             " " + sort-column-phrase +
     3535           " " + "  "
     3536           )
     3537                              else
     3538           (
     3539           " " + " " +
     3540             " " + sort-column-phrase +
     3541           " " + sort-phrase-26
     3542           )
     3543         parameter-7-26 =
