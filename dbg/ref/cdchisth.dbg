     3627             then  substitute(' X_c-dc-hist.d-card  = &1&2&1', chr(34), p-d-card)   + " " + where-phrase-26
     3628             else "true"
     3629           )
     3630         parameter-5-26 = (" " + "" + " " + "" + " " + p-find-condition)
     3631         parameter-6-26 = if sort-phrase-26 = ''
     3632                              then
     3633           (
     3634           " " + " " +
     3635             " " + sort-column-phrase +
     3636           " " + "  "
     3637           )
     3638                              else
     3639           (
     3640           " " + " " +
     3641             " " + sort-column-phrase +
     3642           " " + sort-phrase-26
     3643           )
     3644         parameter-7-26 =
     3645           " indexed-reposition  "
     3646       .
     3647         run fltopend_fltfindq in this-procedure  (
     3648                             input this-procedure:handle
     3649                             ,input query br-dc-hist:handle
     3650                             ,input logical(parameter-2-26)
     3651                             ,input no-lock
     3652                             ,input parameter-3-26
     3653                             ,input parameter-4-26
     3654                             ,input parameter-5-26
     3655                             ,input parameter-6-26
     3656                             ,input parameter-7-26
     3657                             ,output v-fltopend-rowid
     3658                             ) no-error.
     3659         .
     3660         v-doc-rec = ?.
     3661       end.
     3662       assign
     3663         l-query-was-opened = true
     3664       .
     3665     end.
     3666   end.
     3667     run waitfram-hide in this-procedure .
     3668         END.
     3669       END CASE.
     3670     end.
     3671     otherwise do:
