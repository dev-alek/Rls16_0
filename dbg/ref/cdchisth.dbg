      878   procedure fltopend_fltopend :
      879   define input parameter p-parent-handle as handle no-undo .
      880   define input parameter p-qh as handle no-undo .
      881   define input parameter p-flt-open-open-query  as character no-undo .
      882   define input parameter p-where-cond as character no-undo .
      883   define input parameter p-use-indFIRST-query-tail as character no-undo .
      884   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      885   define input parameter p-indexed-reposition as character no-undo .
      886     do
      887     on error undo, return error
      888     :
      889   define variable v-prepare-string as character no-undo .
      890   define variable glog as logical no-undo .
      891   assign
      892   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      893                      p-where-cond + chr(32)  +
      894                      p-use-indFIRST-query-tail + chr(32) +
      895                      p-use-ind-sort-clmn-by + chr(32) +
      896                      p-indexed-reposition
      897   .
      898   assign
      899   glog = p-qh:query-prepare(v-prepare-string) no-error .
      900   if not glog
      901   or error-status:error then do:
      902     message error-status:get-message(1) view-as alert-box .
      903     undo, return error .
      904   end.
      905   assign
      906   glog = p-qh:query-open no-error .
      907   if not glog
      908   or error-status:error then do:
      909     message error-status:get-message(1) view-as alert-box .
      910     undo, return error .
      911   end.
      912     end.
      913   end procedure.
      914   procedure fltopend_fltfindd :
      915   define input parameter p-parent-handle as handle no-undo .
      916   define input parameter p-qh as handle no-undo .
      917   define input parameter p-rowid as rowid no-undo .
      918   define input parameter p-next as logical no-undo .
      919   define input parameter p-lock as integer no-undo .
      920   define input parameter p-bh as handle no-undo .
      921   define input parameter p-where-cond as character no-undo .
      922   define input parameter p-use-index-phrase as character no-undo .
      923   define variable glog as logical no-undo .
      924   define variable v-qh as handle no-undo .
      925   define variable v-bh as handle no-undo .
      926   define variable v-recid as recid no-undo .
      927   define variable v-prepare-string as character no-undo .
      928   do
      929   on error undo, return error
      930   on stop undo, return error
      931   :
      932     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      933     create buffer v-bh for table p-bh buffer-name p-bh:name.
      934     create query v-qh.
      935     v-qh:set-buffers(v-bh).
      936     v-prepare-string = substitute("for each &1 &2 &3"
      937                                     ,v-bh:name
      938                                     ,p-where-cond
      939                                     ,p-use-index-phrase).
      940     glog = v-qh:query-prepare(v-prepare-string) no-error.
      941     if not glog then do:
      942       delete object v-qh.
      943       delete object v-bh.
      944       undo, return error .
      945     end.
      946     glog = v-qh:query-open no-error .
      947     if not glog then do:
      948       delete object v-qh.
      949       delete object v-bh.
      950       undo, return error .
      951     end.
      952     if p-next then do:
      953       v-qh:reposition-to-rowid(p-rowid) no-error .
      954       glog = v-qh:get-next( p-lock) no-error .
      955       glog = v-qh:get-next( p-lock) no-error .
      956       if not glog or v-qh:query-off-end = yes then do:
      957         glog = v-qh:get-first( p-lock) no-error .
      958       end.
      959     end.
      960     else do:
      961       glog = v-qh:get-first( p-lock) no-error .
      962     end.
      963     v-recid = v-bh:recid no-error .
      964     delete object v-qh.
      965     delete object v-bh.
      966     return string(v-recid) .
      967   end.
      968   end procedure.
      969   procedure fltopend_fltfindq :
      970   define input parameter p-parent-handle as handle no-undo .
      971   define input parameter p-qh as handle no-undo .
      972   define input parameter p-next as logical no-undo .
      973   define input parameter p-lock as integer no-undo .
      974   define input parameter p-flt-open-open-query  as character no-undo .
      975   define input parameter p-where-cond as character no-undo .
      976   define input parameter p-use-indFIRST-query-tail as character no-undo .
      977   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      978   define input parameter p-indexed-reposition as character no-undo .
      979   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      980   define variable glog as logical no-undo .
      981   define variable v-qh as handle no-undo .
      982   define variable v-bh as handle no-undo extent 18.
      983   define variable v-rowid as rowid no-undo extent 18.
      984   define variable v-ii as integer no-undo .
      985   define variable v-prepare-string as character no-undo .
      986   do
      987   on error undo, return error
      988   on stop undo, return error
      989   :
      990     create query v-qh.
      991     do v-ii = 1 to p-qh:num-buffers:
      992       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      993       assign
      994       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      995       no-error.
      996       v-qh:add-buffer(v-bh[v-ii]).
      997     end.
      998     assign
      999     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1000                       p-where-cond + chr(32)  +
     1001                       p-use-indFIRST-query-tail + chr(32) +
     1002                       p-use-ind-sort-clmn-by + chr(32) +
     1003                       p-indexed-reposition
     1004     .
     1005     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1006     if not glog then do:
     1007       delete object v-qh.
     1008       do v-ii = 1 to p-qh:num-buffers:
     1009         delete object v-bh[v-ii].
     1010       end.
     1011       undo, return error .
     1012     end.
     1013     glog = v-qh:query-open no-error .
     1014     if not glog then do:
     1015       delete object v-qh.
     1016       do v-ii = 1 to p-qh:num-buffers:
     1017         delete object v-bh[v-ii].
     1018       end.
     1019       undo, return error .
     1020     end.
     1021     if p-next then do:
     1022       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1023       glog = v-qh:get-next( p-lock) no-error .
     1024       glog = v-qh:get-next( p-lock) no-error .
     1025       if not glog or v-qh:query-off-end = yes then do:
     1026         glog = v-qh:get-first( p-lock) no-error .
     1027       end.
     1028     end.
     1029     else do:
     1030       glog = v-qh:get-first( p-lock) no-error .
     1031     end.
     1032     do v-ii = 1 to p-qh:num-buffers:
     1033       assign
     1034       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1035       no-error.
     1036     end.
     1037     delete object v-qh.
     1038     do v-ii = 1 to p-qh:num-buffers:
     1039       delete object v-bh[v-ii].
     1040     end.
     1041   end.
     1042   end procedure.
