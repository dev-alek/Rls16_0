     3795     on error undo, leave
     3796     :
     3797       if query br-dc-hist:handle:get-buffer-handle(1) = (buffer X_c-dc-hist:handle) then do:
     3798         assign
     3799         parameter-2-28 = (if p-find-next then "true":u else "false":u )
     3800         parameter-4-28 =
     3801           "where ":u +  substitute(' X_c-dc-hist.corr-user-db-num = &1 ANd            X_c-dc-hist.d-card  = &2&3&2', p-db-num , chr(34), p-d-card)  + " ":u + where-phrase-28 + " ":u + p-find-condition + " " + ""
     3802         parameter-5-28 = " use-index ishow "
     3803       .
     3804         run fltopend_fltfindd in this-procedure  (
     3805                             input this-procedure:handle
     3806                             ,input query br-dc-hist:handle
     3807                             ,input rowid(X_c-dc-hist)
     3808                             ,input logical(parameter-2-28)
     3809                             ,input no-lock
     3810                             ,input (buffer X_c-dc-hist:handle)
     3811                             ,input parameter-4-28
     3812                             ,input parameter-5-28
     3813                             ) no-error.
     3814         .
     3815         assign
     3816           v-doc-rec = integer(return-value)
     3817           v-fltopend-rowid[1] = ?
     3818         .
     3819       end.
     3820       else do:
     3821         assign
     3822         parameter-2-28 = (if p-find-next then "true":u else "false":u )
     3823         parameter-3-28 =  "FOR EACH X_c-dc-hist"
     3824         parameter-4-28 =
     3825           (
     3826             if ("           X_c-dc-hist.corr-user-db-num = p-db-num ANd            X_c-dc-hist.d-card  = p-d-card                          " + " " + where-phrase-28) <> ""
     3827             then  substitute(' X_c-dc-hist.corr-user-db-num = &1 ANd            X_c-dc-hist.d-card  = &2&3&2', p-db-num , chr(34), p-d-card)  + " " + where-phrase-28
     3828             else "true"
     3829           )
     3830         parameter-5-28 = (" " + "" + " " + "" + " " + p-find-condition)
     3831         parameter-6-28 = if sort-phrase-28 = ''
     3832                              then
     3833           (
     3834           " " + " use-index ishow " +
     3835             " " + sort-column-phrase +
     3836           " " + "  "
     3837           )
     3838                              else
     3839           (
     3840           " " + " use-index ishow " +
     3841             " " + sort-column-phrase +
     3842           " " + sort-phrase-28
     3843           )
     3844         parameter-7-28 =
     3845           " indexed-reposition  "
     3846       .
     3847         run fltopend_fltfindq in this-procedure  (
     3848                             input this-procedure:handle
     3849                             ,input query br-dc-hist:handle
     3850                             ,input logical(parameter-2-28)
     3851                             ,input no-lock
     3852                             ,input parameter-3-28
     3853                             ,input parameter-4-28
     3854                             ,input parameter-5-28
     3855                             ,input parameter-6-28
     3856                             ,input parameter-7-28
     3857                             ,output v-fltopend-rowid
     3858                             ) no-error.
     3859         .
     3860         v-doc-rec = ?.
     3861       end.
     3862       assign
     3863         l-query-was-opened = true
     3864       .
     3865     end.
     3866   end.
     3867     run waitfram-hide in this-procedure .
     3868         END.
     3869       END CASE.
     3870     end.
     3871   END CASE.
     3872   if not p-open-query and v-doc-rec <> ?  then
     3873   REPOSITION br-dc-hist to recid v-doc-rec No-ERROR.
     3874   if not p-open-query and v-fltopend-rowid[1] <> ? then
     3875   query br-dc-hist:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     3876   run waitfram-hide in this-procedure .
     3877   APPLY "VALUE-CHANGED" TO br-dc-hist in frame Dialog-Frame.
     3878   APPLY "ENTRY" TO br-dc-hist.
     3879   END PROCEDURE.
     3880   PROCEDURE proc-b-print :
     3881   define variable date_string     as      char    no-undo.
     3882   define variable Line                as      char    no-undo.
     3883   define variable for-time as char.
     3884   define variable accum-count as integer.
     3885   define variable v-doc-rec as recid no-undo.
     3886   define variable v-subject-chr as character no-undo .
     3887   define variable v-upd-time as character no-undo .
     3888   define variable v-obj as character no-undo .
     3889   define variable v-action-chr as character no-undo .
     3890   define variable v-source-type as character no-undo .
     3891   DEFINE VARIABLE v-for-user-name AS CHARACTER NO-UNDO.
     3892   DEFINE FRAME HistoryList
     3893   v-obj COLUMN-LABEL "Контрагент" FORMAT "X(8)"
     3894   v-action-chr FORMAT "X(10)" COLUMN-LABEL "Действие"
     3895   v-cli      COLUMN-LABEL "Влад-ц карты" FORMAT "X(12)"
     3896   v-cli-name COLUMN-LABEL "Имя влад-ца карты" FORMAT "X(20)"
     3897   v-subject-chr COLUMN-LABEL "Предмет изменений" FORMAT "X(20)"
     3898   X_c-dc-hist.is-news COLUMn-LABEL "СПН" FORMAT "+/ "
     3899   v-source-type COLUMn-LABEL "Источн.!измен"
     3900   X_c-dc-hist.source-ref COLUMn-LABEL "№"
     3901   X_c-dc-hist.corr-date
     3902   v-upd-time COLUMN-LABEL "Время изм." FORMAT "X(8)"
     3903   v-for-user-name COLUMN-LABEL "Изменил" FORMAT "X(18)"
     3904   X_c-dc-hist.corr-user-db-num
     3905   X_c-dc-hist.host-code COLUMN-LABEL "Фирма"
     3906   HEADER  date_string AT 5 format "X(35)"
     3907   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     3908   Line format "X(195)" AT 1
     3909   with width 232 down stream-io use-text    .
     3910   Line = fill("-", 195).
     3911   date_string = cur-time-print() .
     3912   assign
     3913   v-doc-rec = recid( X_c-dc-hist ).
     3914   DO WHILE available X_c-dc-hist :
     3915         GET prev br-dc-hist.
     3916   END.
     3917   run prn-lib-open-stream  in this-procedure (
     3918                                                input parparentProc
     3919                                               ,input 43
     3920                                               ,input yes
     3921                                               ,input no
     3922                                               ).
     3923   PUT  STREAM PrnLibStream
     3924   SPACE(25) ( frame Dialog-Frame:title )
     3925   format "x(90)" SKIP(1) .
     3926   FORM HEADER
     3927   Line format "X(180)" AT 1 SKIP
     3928   "Продолжение - на следующей странице" AT 30 SKIP
     3929   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3930   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     3931   FORM with FRAME HistoryList  .
     3932   run waitfram-show in this-procedure ( input "Ждите...").
     3933     GET next br-dc-hist.
     3934       DO WHILE available X_c-dc-hist :
     3935         Display STREAM PrnLibStream
     3936          X_c-dc-hist.obj-type + string(X_c-dc-hist.obj-code) @ v-obj
     3937         get-action(X_c-dc-hist.action) @ v-action-chr
     3938         (if v-find then get-cli(X_c-dc-hist.d-card) else "":U )  @ v-cli
     3939         v-cli-name
     3940         get-subject(X_c-dc-hist.subject) @ v-subject-chr
     3941         X_c-dc-hist.is-news
     3942         get-source-type(X_c-dc-hist.source-type) @ v-source-type
     3943         X_c-dc-hist.source-ref
     3944         X_c-dc-hist.corr-date
     3945         string(X_c-dc-hist.corr-time, "HH:MM:SS":U) @ v-upd-time
     3946         usrfulnf(X_c-dc-hist.corr-user-name) @ v-for-user-name
     3947         X_c-dc-hist.corr-user-db-num
     3948         X_c-dc-hist.host-code
     3949         with FRAME HistoryList .
     3950     DOWN STREAM PrnLibStream 1 with FRAME HistoryList  .
     3951     assign
     3952     accum-count = accum-count + 1
     3953     .
     3954     GET next br-dc-hist.
     3955   END.
     3956   UNDERLINE  STREAM PrnLibStream
     3957   v-obj
     3958   v-action-chr
     3959   v-cli
     3960   v-cli-name
     3961   v-subject-chr
     3962   X_c-dc-hist.is-news
     3963   v-source-type
     3964   X_c-dc-hist.source-ref
     3965   X_c-dc-hist.corr-date
     3966   v-upd-time
     3967   v-for-user-name
     3968   X_c-dc-hist.corr-user-db-num
     3969   X_c-dc-hist.host-code
     3970   with FRAME HistoryList .
     3971   DISPLAY STREAM PrnLibStream
     3972   "ИТОГО"  @ v-obj
     3973   string(accum-count)  @ v-action-chr
     3974   with frame HistoryList.
     3975   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     3976   HIDE  STREAM PrnLibStream FRAME CheckList.
     3977   output  STREAM PrnLibStream CLOSE.
     3978   run waitfram-hide in this-procedure.
     3979   run prn-lib-prn-file in this-procedure (
     3980                                             input parparentproc
     3981                                             ,input 8
     3982                                             ).
     3983   reposition br-dc-hist to recid v-doc-rec no-error.
     3984   apply "entry" to br-dc-hist in frame Dialog-Frame.
     3985   END PROCEDURE.
     3986   PROCEDURE proc-b-sch :
     3987   assign
     3988     tbl = 'c-dc-hist'
     3989     join-tbl = 'X_c-dc-hist'
     3990     fld = ""
     3991     lab = ""
     3992     spr = ""
     3993     dim = '0'
     3994     .
     3995   run fltfield-add in this-procedure('obj-type*obj-code', 'Контрагент', '',
     3996   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3997   run fltfield-add in this-procedure('host-code', '', '',
     3998   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     3999   run fltfield-add in this-procedure('corr-date', '', '',
     4000   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4001   run fltfield-add in this-procedure('corr-time', 'Время корр.', 'time',
     4002   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4003   run fltfield-add in this-procedure('corr-user-db-num', '', '',
     4004   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4005   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     4006   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4007   run fltfield-add in this-procedure('subject', 'Предмет изменения', 'dc-hist-subject',
     4008   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4009   run fltfield-add in this-procedure('action', 'Действие', 'hist-action',
     4010   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4011   run fltfield-add in this-procedure('source-type', 'Источник_измен-я', 'hist-source-type',
     4012   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4013   run fltfield-add in this-procedure('source-ref', '', '',
     4014   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4015   Filter-Block:
     4016   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4017       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4018       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4019     run gbl/filter.w ( INPUT parparentproc
     4020                      , INPUT (filter-point + chr(4) + filter-label)
     4021                      , INPUT tbl
     4022                      , INPUT join-tbl
     4023                      , INPUT fld
     4024                      , INPUT lab
     4025                      , INPUT spr
     4026                      , INPUT dim ).
     4027     RUN OpenBr in this-procedure ( input yes, input no, input '':U, input v-corr-user-db-num).
     4028   END.
     4029   END PROCEDURE.
     4030   PROCEDURE proc-br-dc-hist :
     4031   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4032   if b-sel:sensitive in frame Dialog-Frame then dO:
     4033       if b-mark:sensitive then do:
     4034           apply "choose" to b-mark in frame Dialog-Frame.
     4035       end.
     4036       else do:
     4037           apply "choose" to b-sel in frame Dialog-Frame.
     4038       end.
     4039   end.
     4040   else do:
     4041       if b-lookup:sensitive then
     4042       apply "choose" to b-lookup in frame Dialog-Frame.
     4043   end.
     4044   END PROCEDURE.
     4045   PROCEDURE proc-find-corr-date :
     4046   define input parameter p-next as logical no-undo.
     4047   define input parameter p-date like ub.fin-doc.doc-date no-undo.
     4048   define variable v-date-chr as character no-undo.
     4049   if p-date = ? then return .
     4050   display
     4051   "":U @ sch-d-card
     4052   0 @ sch-db-num
     4053   "":U @ sch-corr-user-name
     4054   with frame Dialog-Frame.
     4055   assign
     4056   v-date-chr = string(day(p-date)) + chr(47) +
     4057                    string(month(p-date)) + chr(47) +
     4058                    string(year(p-date)).
     4059          run OpenBr in this-procedure
     4060           (input false
     4061           ,input true
     4062           ,input substitute("and X_c-dc-hist.corr-date = &1 "
     4063             , v-date-chr)
     4064           ,input v-corr-user-db-num
     4065           ).
     4066         apply "entry":u to sch-corr-date in frame Dialog-Frame.
     4067   END PROCEDURE.
     4068   PROCEDURE proc-find-d-card :
     4069   define input parameter p-next as logical no-undo.
     4070   define input parameter p-d-card like ub.c-dc-hist.d-card no-undo.
     4071   display
     4072   "":U @ sch-corr-user-name
     4073   with frame Dialog-Frame.
     4074   display
     4075   "":U @ sch-corr-user-name
     4076   0 @ sch-db-num
     4077   sch-corr-date
     4078   with frame Dialog-Frame.
     4079   assign
     4080   p-d-card = replace(p-d-card, chr(34), "":U)
     4081   p-d-card = replace(p-d-card, chr(39), chr(39) + chr(39))
     4082   p-d-card = chr(34) + p-d-card + chr(34).
     4083   run OpenBr in this-procedure
     4084       (input false
     4085       ,input p-next
     4086       ,input substitute("and X_c-dc-hist.d-card = &1 "
     4087         , p-d-card)
     4088       ,input v-corr-user-db-num
     4089       ).
     4090   apply "entry":u to sch-d-card in frame Dialog-Frame .
     4091   END PROCEDURE.
     4092   PROCEDURE proc-find-db-num :
     4093   define input parameter p-next as logical no-undo.
     4094   define input parameter p-db-num like ub.c-dc-hist.corr-user-db-num no-undo.
     4095   define variable v-db-num as character no-undo.
     4096   assign
     4097   sch-corr-date = ?
     4098   .
     4099   display
     4100   "":U @ sch-corr-user-name
     4101   "":U @ sch-d-card
     4102   sch-corr-date
     4103   with frame Dialog-Frame.
     4104   assign
     4105   v-db-num = string(p-db-num).
     4106   run OpenBr in this-procedure
     4107       (input false
     4108       ,input p-next
     4109       ,input substitute("and X_c-dc-hist.corr-user-db-num = &1 "
     4110         , v-db-num)
     4111       ,input v-corr-user-db-num
     4112       ).
     4113   apply "entry":u to sch-db-num in frame Dialog-Frame .
     4114   END PROCEDURE.
     4115   PROCEDURE proc-find-user :
     4116   define input parameter p-next as logical no-undo.
     4117   define input parameter p-user like ub.c-dc-hist.corr-user-name no-undo.
     4118   assign
     4119   sch-corr-date = ?.
     4120   display
     4121   0 @ sch-db-num
     4122   sch-corr-date
     4123   0 @ sch-d-card
     4124   with frame Dialog-Frame.
     4125   p-user = chr(34) + p-user + chr(34).
     4126   run OpenBr in this-procedure
     4127       (input false
     4128       ,input p-next
     4129       ,input substitute("and X_c-dc-hist.corr-user-name = &1 "
     4130         , p-user)
     4131       ,input v-corr-user-db-num
     4132       ).
     4133   apply "entry":u to sch-corr-user-name in frame Dialog-Frame .
     4134   END PROCEDURE.
     4135   PROCEDURE proc-view-changes :
     4136   define variable v-description as character no-undo .
     4137   for each temp-changes:
     4138       delete temp-changes.
     4139   END.
     4140   if not available X_c-dc-hist then do:
     4141     Open QUery br-changes for each temp-changes.
     4142     return.
     4143   end.
     4144   run ref/cdchisv.p (
     4145                      input X_c-dc-hist.d-card
     4146                     ,input X_c-dc-hist.chip-num
     4147                     ,input X_c-dc-hist.corr-user-db-num
     4148                     ,input X_c-dc-hist.obj-type
     4149                     ,input X_c-dc-hist.obj-code
     4150                     ,input X_c-dc-hist.host-code
     4151                     ,input X_c-dc-hist.subject
     4152                     ,input X_c-dc-hist.action
     4153                     ,input no
     4154                     ,output v-description
     4155                  ) no-error .
     4156   Open QUery br-changes for each temp-changes.
     4157   assign
     4158   br-changes:title in frame Dialog-Frame = v-description
     4159   .
     4160   END PROCEDURE.
     4161   FUNCTION get-action RETURNS CHARACTER
     4162     ( p-action as integer ) :
     4163   define variable dops as character no-undo.
     4164   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     4165   RETURN dops.
     4166   END FUNCTION.
     4167   FUNCTION get-cli RETURNS CHARACTER
     4168     ( p-d-card as character ) :
     4169   define buffer buf_dis-card for ub.dis-card.
     4170   define buffer buf_clients for ub.clients.
     4171   find first buf_dis-card no-lock where
     4172             buf_dis-card.d-card = ENTRY(1, p-d-card, chr(4)) no-error .
     4173   if not avail buf_dis-card then do:
     4174     assign
     4175     v-cli-name = "!!! Неизвестный владелец ДК!!!".
     4176   end.
     4177   find first buf_clients no-lock where
     4178             buf_clients.obj-type = buf_dis-card.cli-type
     4179         AND buf_clients.obj-code = buf_dis-card.cli-code
     4180         no-error.
     4181   if not available buf_clients then do:
     4182     assign
     4183     v-cli-name = "!!! Неизвестный владелец ДК!!!".
     4184   end.
     4185   else do:
     4186     assign
     4187     v-cli-name = buf_clients.obj-name
     4188     .
     4189   end.
     4190   RETURN (buf_clients.obj-type + string(buf_clients.obj-code)).
     4191   END FUNCTION.
     4192   FUNCTION get-source-type RETURNS CHARACTER
     4193     ( p-source-type as character ) :
     4194   define variable v-dop as character no-undo .
     4195   assign
     4196   v-dop = entry (lookup (p-source-type, ',db,esys,trn-doc,payment,fin-doc,import,recalc,wth-doc,ren-gdsc,upgrade,grp-chg,stop-list,dis-card':U), ',БД,ВС,Документ,Платеж,Фин.док.,Импорт,Пересчет,Документ МЦ,Коллизия,Апгрейд,Изм.группы,Стоплист,ДК':U)
     4197   no-error
     4198   .
     4199   RETURN v-dop.
     4200   END FUNCTION.
     4201   FUNCTION get-subject RETURNS CHARACTER
     4202     ( p-subject as character ) :
     4203     RETURN entry (lookup (p-subject, 'dis-card,dis-card-property,dis-obj,dis-host,dis-dc-rule':U), 'Диск.карта,Свойства ДК,Итоги ДК на объ.,Итоги ДК фирма/общ,Скидки для ДК':U).
     4204   END FUNCTION.
