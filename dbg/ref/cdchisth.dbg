     3498     ,output filter-name-26
     3499     ,output where-phrase-26
     3500     ,output sort-phrase-26
     3501     ,output where-phrase-rus-26
     3502     ,output sort-phrase-rus-26
     3503     ).
     3504   if p-open-query then do:
     3505       run set-filter-name in this-procedure
     3506         (INPUT filter-name-26
