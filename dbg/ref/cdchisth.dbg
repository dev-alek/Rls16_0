     3595     on error undo, leave
     3596     :
     3597       if query br-dc-hist:handle:get-buffer-handle(1) = (buffer X_c-dc-hist:handle) then do:
     3598         assign
     3599         parameter-2-26 = (if p-find-next then "true":u else "false":u )
     3600         parameter-4-26 =
     3601           "where ":u +  substitute(' X_c-dc-hist.d-card  = &1&2&1', chr(34), p-d-card)   + " ":u + where-phrase-26 + " ":u + p-find-condition + " " + ""
     3602         parameter-5-26 = " "
     3603       .
     3604         run fltopend_fltfindd in this-procedure  (
     3605                             input this-procedure:handle
     3606                             ,input query br-dc-hist:handle
     3607                             ,input rowid(X_c-dc-hist)
     3608                             ,input logical(parameter-2-26)
     3609                             ,input no-lock
