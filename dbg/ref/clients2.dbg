        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo .
        3   define input parameter p-rid as recid no-undo .
        4   define input parameter p-stts like ub.clients.stts no-undo.
        5   define input parameter p-silent as logical no-undo .
        6   define input parameter p-thbj-included as logical no-undo .
        7   define input parameter p-mode2 as character no-undo .
        8   define input parameter p-source-type as character no-undo .
        9   define input parameter p-source-ref as character no-undo .
       10   define variable vss-revision    as character no-undo init "$Revision: 7d2fe421d6dd, 1113, rls $":U .
       11   define variable vss-author      as character no-undo init "$Author: SMMolotkov $":U .
       12   define variable vss-date        as character no-undo init "$Date: Thu Dec 14 02:13:53 2017 +0300 $":U .
       13   define variable vss-workfile    as character no-undo init "$Workfile: clients2.p $":U .
       14   define variable vss-archive     as character no-undo init "$Archive: ref/clients2.p $":U .
       15   define variable vss-description as character no-undo init "Изменение статуса клиента".
       16   procedure vss-get-info :
       17     define output parameter p-vss-revision    like vss-revision    no-undo .
       18     define output parameter p-vss-author      like vss-author      no-undo .
       19     define output parameter p-vss-date        like vss-date        no-undo .
       20     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       21     define output parameter p-vss-archive     like vss-archive     no-undo .
       22     define output parameter p-vss-description like vss-description no-undo .
       23     assign
       24       p-vss-revision    = vss-revision
       25       p-vss-author      = vss-author
       26       p-vss-date        = vss-date
       27       p-vss-workfile    = vss-workfile
       28       p-vss-archive     = vss-archive
       29       p-vss-description = vss-description
       30     .
       31   end procedure.
       32   procedure vss-get-parameters :
       33     define output parameter p-vss-parameters as character no-undo .
       34   end procedure.
       35   define new global shared variable g#vssrevis-logger as handle    no-undo .
       36   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       37   define variable v-vssrevis-logger                   as handle    no-undo .
       38   procedure vss-logevent :
       39     define input  parameter p-extra-paramters as character no-undo .
       40     define variable v-vssrevis-parameters as character no-undo .
       41     do
       42     on error undo, return error return-value
       43     :
       44       if  valid-handle(v-vssrevis-logger)
       45       and v-vssrevis-logger :get-signature("logevent") <> ""
       46       then do:
       47         run vss-get-parameters in this-procedure
       48           (output v-vssrevis-parameters
       49           ).
       50         run logevent in v-vssrevis-logger
       51           (input vss-workfile
       52           ,input vss-revision
       53           ,input v-vssrevis-parameters
       54           ,input p-extra-paramters
       55           ).
       56       end.
       57     end.
       58   end procedure.
       59   assign
       60     v-vssrevis-logger = g#vssrevis-logger
       61   .
       62   if  valid-handle(v-vssrevis-logger)
       63   and v-vssrevis-logger :get-signature("logevent") <> ""
       64   then do:
       65     assign
       66       v-vssrevis-logevent = true
       67     .
       68     run vss-logevent in this-procedure (input vss-description) .
       69   end.
       70   define new global shared variable g#language as character no-undo .
       71   if g#language <> '' and g#language <> 'rus':U then do:
       72     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       73   end.
       74   define new global shared variable g#library  as handle no-undo .
       75   define new global shared variable g#library2 as handle no-undo .
       76   define   shared variable g#auto as logical no-undo.
       77   define   shared variable g#news as logical no-undo.
       78   define   shared variable g#oxml as logical no-undo.
       79   define   shared variable g#esys as logical no-undo.
       80   define   shared variable g#news-source-db as integer no-undo.
       81   define   shared variable g#esys-source-esys as integer no-undo.
       82   define   shared variable g#db-num as integer   no-undo .
       83   define   shared variable g#userid as character no-undo .
       84   define   shared variable g#passwd as character no-undo .
       85   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       86     define variable v-cntxt-db-num        as integer   no-undo .
       87     define variable v-cntxt-userid        as character no-undo .
       88     define variable v-cntxt-level         as character no-undo .
       89     define variable v-cntxt-host-code-obj as integer   no-undo .
       90     define variable v-cntxt-obj-type      as character no-undo .
       91     define variable v-cntxt-obj-code      as integer   no-undo .
       92     define variable v-cntxt-db-num-obj    as integer   no-undo .
       93     define variable v-cntxt-is-admin      as logical   no-undo .
       94   define variable ri            as recid no-undo.
       95   define variable v-old-status as integer no-undo .
       96   define variable v-dc-status     as character no-undo .
       97   define variable glog         as logical no-undo .
       98   define variable v-mess as character no-undo .
       99   define variable choice as logical no-undo .
      100   define buffer buf_clients for ub.clients.
      101   define buffer buf_dis-card for ub.dis-card.
      102   main-block:
      103   do
      104   on error  undo main-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      105   on stop   undo main-block, return error substitute( "&1. stop", vss-workfile )
      106   on endkey undo main-block, return error substitute( "&1. endkey", vss-workfile )
      107   :
      108   define variable vss-include-info1 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      109   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run getcurus in g#library2
      110     (output v-cntxt-db-num
      111     ,output v-cntxt-userid
      112     )  .
      113     FIND first buf_clients exclusive-lock where recid( buf_clients ) = p-rid .
      114     CASE buf_clients.obj-type:
      115       when 'орг':U
      116       then do:
      117   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      118   do:
      119     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      120       (input  v-cntxt-db-num
      121       ,input  v-cntxt-userid
      122       ,input  0
      123       ,input  'actn_client-reference_add-del':U
      124       ,input  'global':U
      125       ,input  0
      126       ,input  '':U
      127       ,input  0
      128       ,input  0
      129       ,input  0
      130       ,input  0
      131       ,input  true
      132       ,output glog
      133       )  .
      134   end.
      135       end.
      136       when 'чел':U
      137       then do:
      138   define variable vss-include-info3 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      139   do:
      140     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      141       (input  v-cntxt-db-num
      142       ,input  v-cntxt-userid
      143       ,input  0
      144       ,input  'actn_client-reference-prs_add-del':U
      145       ,input  'global':U
      146       ,input  0
      147       ,input  '':U
      148       ,input  0
      149       ,input  0
      150       ,input  0
      151       ,input  0
      152       ,input  true
      153       ,output glog
      154       )  .
      155   end.
      156       end.
      157       otherwise do:
      158         if not p-thbj-included then do:
      159           if buf_clients.stts <> integer('0':U)  then  do:
      160             v-mess = substitute("Магазины и склады&1" +
      161                                 "можно восстановить только в АРМ'е <Администратор>.&1" +
      162                                 "Обратитесь к администратору системы."
      163                                 , chr(10)).
      164             run err-mess in this-procedure ( input-output v-mess).
      165             undo main-block, return error (if p-silent = yes then v-mess else '':U).
      166           end.
      167           else do:
      168             v-mess = substitute("Магазины и склады&1" +
      169                                 "можно удалять только в АРМ'е <Администратор>.&1" +
      170                                 "Обратитесь к администратору системы."
      171                                 , chr(10)).
      172             run err-mess in this-procedure ( input-output v-mess).
      173             undo main-block, return error (if p-silent = yes then v-mess else '':U).
      174           end.
      175         end.
      176         if buf_clients.obj-type = v-cntxt-obj-type
      177         and buf_clients.obj-code = v-cntxt-obj-code then do:
      178           v-mess = substitute("Нельзя удалять текущий объект&1"
      179                               , chr(10)).
      180           run err-mess in this-procedure ( input-output v-mess).
      181           undo main-block, return error (if p-silent = yes then v-mess else '':U).
      182         end.
      183         if v-cntxt-db-num <> 0 then do:
      184           v-mess = substitute("Нельзя удалять &1 и &2 в ГБД&3"
      185                               , chr(10)).
      186           run err-mess in this-procedure ( input-output v-mess).
      187           undo main-block, return error (if p-silent = yes then v-mess else '':U).
      188         end.
      189         define variable v-check-db-num as integer no-undo .
      190         define variable v-check-user-id as character no-undo .
      191         define variable v-check-administrator as logical no-undo .
      192   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      193   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usercred in g#library2
      194     (input  v-cntxt-db-num
      195     ,input  v-cntxt-userid
      196     ,output v-check-db-num
      197     ,output v-check-user-id
      198     ,output v-check-administrator
      199     ) no-error .
      200         if error-status :error
      201         or v-check-administrator = no then do:
      202           v-mess = substitute("Пользователь &1 не имеет прав администратора&2"
      203                               , v-cntxt-userid
      204                               , chr(10)).
      205           run err-mess in this-procedure ( input-output v-mess).
      206           undo main-block, return error (if p-silent = yes then v-mess else '':U).
      207         end.
      208         else do:
      209           glog = yes.
      210         end.
      211       end.
      212     END CASE.
      213     if not glog then do:
      214       v-mess = substitute("Нет прав на удаление клиентов типа &1", buf_clients.obj-type).
      215       run err-mess in this-procedure ( input-output v-mess).
      216       undo main-block, return error (if p-silent = yes then v-mess else '':U).
      217     end.
      218     if p-silent = no then do:
      219       if p-stts = ? then do:
      220         if buf_clients.stts <> integer('0':U)  then  do:
      221           message
      222           substitute("Клиент&1" +
      223                       "&2&1" +
      224                       "У Ж Е   У Д А Л Е Н.&1"  +
      225                       "Восстановить данного клиента?"
      226                       , chr(10)
      227                       , buf_clients.obj-name )
      228           view-as alert-box question buttons yes-no update choice .
      229           if not choice then do:
      230             undo main-block, return error '':U.
      231           end.
      232           p-stts = integer('0':U).
      233         end.
      234         else do:
      235           message
      236           substitute("Удалить клиента&1" +
      237                      "&2?"
      238                       , chr(10)
      239                       , buf_clients.obj-name )
      240           view-as alert-box question buttons yes-no update choice .
      241           if not choice then do:
      242             undo main-block, return error '':U.
      243           end.
      244           p-stts = integer('1':U).
      245         end.
      246       end.
      247       if buf_clients.obj-type = 'орг':U
      248       or buf_clients.obj-type = 'чел':U then do:
      249         glog = no.
      250         message
      251         substitute("Внимание!&1" +
      252                     "Все имеющиеся у данного контрагента ДК будут переведены в статус &2"
      253                     , chr(10)
      254                     , 'удал':U)
      255         view-as alert-box question buttons YEs-no update glog .
      256         if not glog then undo main-block, return error '':U.
      257       end.
      258     end.
      259     else do:
      260       if p-stts = ? then do:
      261         v-mess = substitute("Неопределен статус в который надо перевести клиента&1"
      262                             , chr(10)).
      263         run err-mess in this-procedure ( input-output v-mess).
      264         undo main-block, return error (if p-silent = yes then v-mess else '':U).
      265       end.
      266       else do:
      267         if buf_clients.stts = integer('0':U) and p-stts = integer('0':U)  then do:
      268           v-mess = substitute("Клиент уже имеет статус = &1&2"
      269                               , entry (lookup (string(buf_clients.stts), '0,1,50,99':U), 'тек,удал,блок,удаление':U)
      270                               , chr(10)).
      271           run err-mess in this-procedure ( input-output v-mess).
      272           undo main-block, return error (if p-silent = yes then v-mess else '':U).
      273         end.
      274         if buf_clients.stts = integer('1':U)  and p-stts = integer('1':U)  then do:
      275           v-mess = substitute("Клиент уже имеет статус = &1&2"
      276                               , entry (lookup (string(buf_clients.stts), '0,1,50,99':U), 'тек,удал,блок,удаление':U)
      277                               , chr(10)).
      278           run err-mess in this-procedure ( input-output v-mess).
      279           undo main-block, return error (if p-silent = yes then v-mess else '':U).
      280         end.
      281         if p-stts <> integer('0':U) and p-stts <> integer('1':U) then do:
      282           v-mess = substitute("Неизвестный статус для клиента = &1&2"
      283                              ,p-stts
      284                              ,chr(10)).
      285           run err-mess in this-procedure ( input-output v-mess).
      286           undo main-block, return error (if p-silent = yes then v-mess else '':U).
      287         end.
      288       end.
      289     end.
      290     assign
      291     buf_clients.stts = p-stts
      292     .
      293     if p-stts = integer('1':U) then do:
      294       if buf_clients.obj-type = 'орг':U
      295       or buf_clients.obj-type = 'чел':U then do:
      296         FOR EACH buf_dis-card no-lock WHERE
      297               buf_dis-card.cli-type = buf_clients.obj-type
      298         AND  buf_dis-card.cli-code = buf_clients.obj-code:
      299           v-dc-status =  'удал':U .
      300           run ref/dcardi02.p (
      301                             input parparentproc
      302                             ,input recid(buf_dis-card)
      303                             ,input yes
      304                             ,input no
      305                             ,input '':U
      306                             ,input '':U
      307                             ,input '':U
      308                             ,input v-cntxt-obj-type
      309                             ,input v-cntxt-obj-code
      310                             ,input-output v-dc-status ) no-error .
      311           if error-status:error then do:
      312             v-mess = substitute("Ошибка при изменении статуса ДК &1 для клиента &2&3&4" +
      313                       "&5&4&6"
      314                       ,buf_dis-card.d-card
      315                       ,buf_clients.obj-type
      316                       ,buf_clients.obj-code
      317                       ,chr(10)
      318                       , error-status:get-message(1)
      319                       , return-value ).
      320             run err-mess in this-procedure ( input-output v-mess).
      321             undo main-block, return error (if p-silent = yes then v-mess else '':U).
      322           end.
      323          END.
      324        end.
      325      end.
      326   end.
      327   PROCEDURE err-mess:
      328     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
      329     CASE p-silent:
      330       when yes then do:
      331         assign
      332         p-mess = substitute("Удаление клиента &1&2&3&4"
      333                            , buf_clients.obj-type
      334                            , buf_clients.obj-code
      335                            , chr(10)
      336                            , p-mess)
      337         .
      338       end.
      339       when no then do:
      340         message
      341         p-mess
      342         view-as alert-box error .
      343       end.
      344     end.
      345   END PROCEDURE.
