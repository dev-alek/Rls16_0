     4543   PROCEDURE proc-view-changes :
     4544   define buffer buf_c-dis-grp-rule for ub.c-dis-grp-rule.
     4545   define variable v-description as character no-undo .
     4546   for each temp-changes:
     4547       delete temp-changes.
     4548   END.
     4549   if not available X_c-sum-grp-obj then do:
     4550     Open QUery br-changes for each temp-changes.
     4551     return.
     4552   end.
     4553   define variable v-label-param as character no-undo .
     4554   CASE X_c-sum-grp-obj.subject:
     4555     when  'sum-grp-obj':U then do:
     4556       v-label-param =
     4557         "grp-code" + chr(4) + "Код группы" + chr(4) + "" + chr(8)
     4558       + "grp-name" + chr(4) + "Наименование группы" + chr(4) + "" + chr(8)
     4559       + "obj-code" + chr(4) + "Код объекта" + chr(4) + "" + chr(8)
     4560       + "obj-type" + chr(4) + "Тип объекта" + chr(4) + ""  .
     4561       run proc-full-temp-changes in this-procedure (
     4562                                                    input  (X_c-sum-grp-obj.action = integer('1':U))
     4563                                                   ,input  (X_c-sum-grp-obj.action = integer('99':U))
     4564                                                   ,input  buffer X_c-sum-grp-obj:handle
     4565                                                   ,input  'sum-grp-obj':U
     4566                                                   ,input  "grp-code,grp-name,obj-code,obj-type"
     4567                                                   ,input  v-label-param).
     4568     end.
     4569     when 'dis-grp-rule':U then do:
     4570         find first buf_c-dis-grp-rule no-lock where
     4571                 buf_c-dis-grp-rule.classif-type = 'sum-grp-obj':U
     4572            and  buf_c-dis-grp-rule.node-code = X_c-sum-grp-obj.grp-code
     4573            and  buf_c-dis-grp-rule.obj-type = X_c-sum-grp-obj.obj-type
     4574            and  buf_c-dis-grp-rule.obj-code = X_c-sum-grp-obj.obj-code
     4575           and  buf_c-dis-grp-rule.corr-user-db-num = X_c-sum-grp-obj.corr-user-db-num
     4576           and  buf_c-dis-grp-rule.chip-num = X_c-sum-grp-obj.chip-num no-error.
     4577      if not available buf_c-dis-grp-rule then do:
     4578        message
     4579        "Неверная ссылка на c-dis-grp-rule в таблице c-sum-grp-obj"
     4580        view-as alert-box error.
     4581      end.
     4582       v-label-param =
     4583         "rule-num" + chr(4) + "Номер правила скидки" + chr(4) + "" + chr(8)
     4584       + "pos-type" + chr(4) + "Место использ." + chr(4) + "" + chr(8)
     4585       + "templ-rl-root" + chr(4) + "Тип шаблона" + chr(4) + "disgrpru-get-disc-label"  + chr(8)
     4586       + "discnt-role" + chr(4) + "Тип скидки" + chr(4) + "disgrpru-get-disc-role-label"  + chr(8)
     4587       + "obj-type" + chr(4) + "Тип объекта" + chr(4) + "" + chr(8)
     4588       + "obj-code" + chr(4) + "Код" + chr(4) + ""
     4589       .
     4590       run proc-full-temp-changes in this-procedure (
     4591                                                   input  (X_c-sum-grp-obj.action = integer('1':U))
     4592                                                   ,input  (X_c-sum-grp-obj.action = integer('99':U))
     4593                                                   ,input  buffer buf_c-dis-grp-rule:handle
     4594                                                   ,input  'dis-grp-rule':U
     4595                                                   ,input  "rule-num,pos-type,templ-rl-root,discnt-role,obj-code,obj-type"
     4596                                                   ,input  v-label-param).
     4597     end.
     4598   END CASE.
     4599   Open QUery br-changes for each temp-changes.
     4600   assign
     4601   br-changes:title in frame Dialog-Frame = v-description
     4602   .
     4603   END PROCEDURE.
     4604   FUNCTION get-action RETURNS CHARACTER
     4605     ( p-action as integer ) :
     4606     define variable dops as character no-undo.
     4607   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     4608   RETURN dops.
     4609   END FUNCTION.
     4610   FUNCTION get-subject RETURNS CHARACTER
     4611     ( p-subject as character ) :
     4612     RETURN entry (lookup (p-subject, 'sum-grp-obj,dis-grp-rule':U), 'Группы товаров (на кассе объекта),Скидки по группе':U).
     4613   END FUNCTION.
