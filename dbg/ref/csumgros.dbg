     1176   define variable v-fltopend-rowid as rowid extent 18 no-undo .
     1177   procedure fltopend_fltopend :
     1178   define input parameter p-parent-handle as handle no-undo .
     1179   define input parameter p-qh as handle no-undo .
     1180   define input parameter p-flt-open-open-query  as character no-undo .
     1181   define input parameter p-where-cond as character no-undo .
     1182   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1183   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1184   define input parameter p-indexed-reposition as character no-undo .
     1185     do
     1186     on error undo, return error
     1187     :
     1188   define variable v-prepare-string as character no-undo .
     1189   define variable glog as logical no-undo .
     1190   assign
     1191   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1192                      p-where-cond + chr(32)  +
     1193                      p-use-indFIRST-query-tail + chr(32) +
     1194                      p-use-ind-sort-clmn-by + chr(32) +
     1195                      p-indexed-reposition
     1196   .
     1197   assign
     1198   glog = p-qh:query-prepare(v-prepare-string) no-error .
     1199   if not glog
     1200   or error-status:error then do:
     1201     message error-status:get-message(1) view-as alert-box .
     1202     undo, return error .
     1203   end.
     1204   assign
     1205   glog = p-qh:query-open no-error .
     1206   if not glog
     1207   or error-status:error then do:
     1208     message error-status:get-message(1) view-as alert-box .
     1209     undo, return error .
     1210   end.
     1211     end.
     1212   end procedure.
     1213   procedure fltopend_fltfindd :
     1214   define input parameter p-parent-handle as handle no-undo .
     1215   define input parameter p-qh as handle no-undo .
     1216   define input parameter p-rowid as rowid no-undo .
     1217   define input parameter p-next as logical no-undo .
     1218   define input parameter p-lock as integer no-undo .
     1219   define input parameter p-bh as handle no-undo .
     1220   define input parameter p-where-cond as character no-undo .
     1221   define input parameter p-use-index-phrase as character no-undo .
     1222   define variable glog as logical no-undo .
     1223   define variable v-qh as handle no-undo .
     1224   define variable v-bh as handle no-undo .
     1225   define variable v-recid as recid no-undo .
     1226   define variable v-prepare-string as character no-undo .
     1227   do
     1228   on error undo, return error
     1229   on stop undo, return error
     1230   :
     1231     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
     1232     create buffer v-bh for table p-bh buffer-name p-bh:name.
     1233     create query v-qh.
     1234     v-qh:set-buffers(v-bh).
     1235     v-prepare-string = substitute("for each &1 &2 &3"
     1236                                     ,v-bh:name
     1237                                     ,p-where-cond
     1238                                     ,p-use-index-phrase).
     1239     glog = v-qh:query-prepare(v-prepare-string) no-error.
     1240     if not glog then do:
     1241       delete object v-qh.
     1242       delete object v-bh.
     1243       undo, return error .
     1244     end.
     1245     glog = v-qh:query-open no-error .
     1246     if not glog then do:
     1247       delete object v-qh.
     1248       delete object v-bh.
     1249       undo, return error .
     1250     end.
     1251     if p-next then do:
     1252       v-qh:reposition-to-rowid(p-rowid) no-error .
     1253       glog = v-qh:get-next( p-lock) no-error .
     1254       glog = v-qh:get-next( p-lock) no-error .
     1255       if not glog or v-qh:query-off-end = yes then do:
     1256         glog = v-qh:get-first( p-lock) no-error .
     1257       end.
     1258     end.
     1259     else do:
     1260       glog = v-qh:get-first( p-lock) no-error .
     1261     end.
     1262     v-recid = v-bh:recid no-error .
     1263     delete object v-qh.
     1264     delete object v-bh.
     1265     return string(v-recid) .
     1266   end.
     1267   end procedure.
     1268   procedure fltopend_fltfindq :
     1269   define input parameter p-parent-handle as handle no-undo .
     1270   define input parameter p-qh as handle no-undo .
     1271   define input parameter p-next as logical no-undo .
     1272   define input parameter p-lock as integer no-undo .
     1273   define input parameter p-flt-open-open-query  as character no-undo .
     1274   define input parameter p-where-cond as character no-undo .
     1275   define input parameter p-use-indFIRST-query-tail as character no-undo .
     1276   define input parameter p-use-ind-sort-clmn-by as character no-undo .
     1277   define input parameter p-indexed-reposition as character no-undo .
     1278   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
     1279   define variable glog as logical no-undo .
     1280   define variable v-qh as handle no-undo .
     1281   define variable v-bh as handle no-undo extent 18.
     1282   define variable v-rowid as rowid no-undo extent 18.
     1283   define variable v-ii as integer no-undo .
     1284   define variable v-prepare-string as character no-undo .
     1285   do
     1286   on error undo, return error
     1287   on stop undo, return error
     1288   :
     1289     create query v-qh.
     1290     do v-ii = 1 to p-qh:num-buffers:
     1291       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
     1292       assign
     1293       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
     1294       no-error.
     1295       v-qh:add-buffer(v-bh[v-ii]).
     1296     end.
     1297     assign
     1298     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
     1299                       p-where-cond + chr(32)  +
     1300                       p-use-indFIRST-query-tail + chr(32) +
     1301                       p-use-ind-sort-clmn-by + chr(32) +
     1302                       p-indexed-reposition
     1303     .
     1304     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1305     if not glog then do:
     1306       delete object v-qh.
     1307       do v-ii = 1 to p-qh:num-buffers:
     1308         delete object v-bh[v-ii].
     1309       end.
     1310       undo, return error .
     1311     end.
     1312     glog = v-qh:query-open no-error .
     1313     if not glog then do:
     1314       delete object v-qh.
     1315       do v-ii = 1 to p-qh:num-buffers:
     1316         delete object v-bh[v-ii].
     1317       end.
     1318       undo, return error .
     1319     end.
     1320     if p-next then do:
     1321       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1322       glog = v-qh:get-next( p-lock) no-error .
     1323       glog = v-qh:get-next( p-lock) no-error .
     1324       if not glog or v-qh:query-off-end = yes then do:
     1325         glog = v-qh:get-first( p-lock) no-error .
     1326       end.
     1327     end.
     1328     else do:
     1329       glog = v-qh:get-first( p-lock) no-error .
     1330     end.
     1331     do v-ii = 1 to p-qh:num-buffers:
     1332       assign
     1333       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1334       no-error.
     1335     end.
     1336     delete object v-qh.
     1337     do v-ii = 1 to p-qh:num-buffers:
     1338       delete object v-bh[v-ii].
     1339     end.
     1340   end.
     1341   end procedure.
