     4344   PROCEDURE proc-b-print :
     4345   define variable date_string     as      char    no-undo.
     4346   define variable Line                as      char    no-undo.
     4347   define variable for-time as char.
     4348   define variable accum-count as integer.
     4349   define variable v-doc-rec as recid no-undo.
     4350   define variable v-prod as character no-undo .
     4351   define variable v-upd-time as character no-undo .
     4352   define variable v-obj as character no-undo .
     4353   define variable v-action-chr as character no-undo .
     4354   DEFINE VARIABLE v-for-user-name AS CHARACTER NO-UNDO.
     4355   DEFINE FRAME HistoryList
     4356   X_c-sum-grp-obj.grp-code COLUMn-LABEL "№ пистолета"
     4357   v-action-chr FORMAT "X(10)" COLUMN-LABEL "Действие"
     4358   X_c-sum-grp-obj.corr-date
     4359   v-upd-time COLUMN-LABEL "Время изм." FORMAT "X(8)"
     4360   v-for-user-name COLUMN-LABEL "Изменил" FORMAT "X(18)"
     4361   X_c-sum-grp-obj.corr-user-db-num
     4362   v-obj COLUMN-LABEL "Объект" FORMAT "X(8)"
     4363   HEADER  date_string AT 5 format "X(35)"
     4364   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     4365   Line format "X(195)" AT 1
     4366   with width 232 down stream-io use-text    .
     4367   Line = fill("-", 195).
     4368   date_string = cur-time-print() .
     4369   assign
     4370   v-doc-rec = recid( X_c-sum-grp-obj ).
     4371   DO WHILE available X_c-sum-grp-obj :
     4372         GET prev br-sum-grp-obj.
     4373   END.
     4374   run prn-lib-open-stream  in this-procedure (
     4375                                                input parparentProc
     4376                                               ,input 43
     4377                                               ,input yes
     4378                                               ,input no
     4379                                               ).
     4380   PUT  STREAM PrnLibStream
     4381   SPACE(25) ( frame Dialog-Frame:title )
     4382   format "x(90)" SKIP(1) .
     4383   FORM HEADER
     4384   Line format "X(180)" AT 1 SKIP
     4385   "Продолжение - на следующей странице" AT 30 SKIP
     4386   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     4387   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     4388   FORM with FRAME HistoryList  .
     4389   run waitfram-show in this-procedure ("Ждите...").
     4390     GET next br-sum-grp-obj.
     4391       DO WHILE available X_c-sum-grp-obj :
     4392         Display STREAM PrnLibStream
     4393         X_c-sum-grp-obj.grp-code
     4394         get-action(X_c-sum-grp-obj.action) @ v-action-chr
     4395         X_c-sum-grp-obj.corr-date
     4396         string(X_c-sum-grp-obj.corr-time, "HH:MM:SS":U) @ v-upd-time
     4397         usrfulnf(X_c-sum-grp-obj.corr-user-name) @ v-for-user-name
     4398         X_c-sum-grp-obj.corr-user-db-num
     4399         X_c-sum-grp-obj.obj-type + string(X_c-sum-grp-obj.obj-code) @ v-obj
     4400         with FRAME HistoryList .
     4401     DOWN STREAM PrnLibStream 1 with FRAME HistoryList  .
     4402     assign
     4403     accum-count = accum-count + 1
     4404     .
     4405     GET next br-sum-grp-obj.
     4406   END.
     4407   UNDERLINE  STREAM PrnLibStream
     4408   X_c-sum-grp-obj.grp-code
     4409   v-action-chr
     4410   X_c-sum-grp-obj.corr-date
     4411   v-upd-time
     4412   v-for-user-name
     4413   X_c-sum-grp-obj.corr-user-db-num
     4414   v-obj
     4415   with FRAME HistoryList .
     4416   DISPLAY STREAM PrnLibStream
     4417   "ИТОГО"  @ X_c-sum-grp-obj.grp-code
     4418   string(accum-count)  @ v-action-chr
     4419   with frame HistoryList.
     4420   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     4421   HIDE  STREAM PrnLibStream FRAME CheckList.
     4422   output  STREAM PrnLibStream CLOSE.
     4423   run waitfram-hide in this-procedure.
     4424   run prn-lib-prn-file in this-procedure (
     4425                                             input parparentproc
     4426                                             ,input 8
     4427                                             ).
     4428   reposition br-sum-grp-obj to recid v-doc-rec no-error.
     4429   apply "entry" to br-sum-grp-obj in frame Dialog-Frame.
     4430   END PROCEDURE.
     4431   PROCEDURE proc-b-sch :
     4432   assign
     4433     tbl = 'sum-grp-obj'
     4434     join-tbl = 'X_c-sum-grp-obj'
     4435     fld = ""
     4436     lab = ""
     4437     spr = ""
