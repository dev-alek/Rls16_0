      126   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      127   define variable c-point  as character no-undo .
      128   define variable tbl      as character no-undo .
      129   define variable join-tbl as character no-undo .
      130   define variable fld      as character no-undo .
      131   define variable lab      as character no-undo .
      132   define variable spr      as character no-undo .
      133   define variable dim      as character no-undo .
      134   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      135   procedure cur-time :
      136      define output parameter p-today as date      no-undo .
      137      define output parameter p-time  as integer   no-undo .
      138     do
      139     on error undo, return error
      140     :
      141       define variable v-date1 as date      no-undo .
      142       define variable v-date2 as date      no-undo .
      143       define variable v-time  as integer   no-undo .
      144       assign
      145         v-date1 = today
      146         v-time  = time
      147         v-date2 = today
      148       .
      149       if v-date1 <> v-date2
      150       then do:
      151         assign
      152           v-date1 = today
      153           v-time  = v-time
      154         .
      155       end.
      156       assign
      157         p-today = v-date1
      158         p-time  = v-time
      159       .
      160     end.
      161   end.
      162   function cur-time-date returns character
      163   :
      164     return string(today, '99/99/9999':U) .
      165   end.
      166   function cur-time-mjd returns decimal
      167   :
      168     define variable v-date as date      no-undo .
      169     define variable v-time as integer   no-undo .
      170     run cur-time in this-procedure
      171       (output v-date
      172       ,output v-time
      173       ) .
      174     return integer(v-date) - 2400002 + (v-time / 86400) .
      175   end.
      176   function cur-time-get-ending-index returns integer
      177   (input p-number as integer
      178   )
      179   :
      180     if p-number < 0
      181     or p-number = ?
      182     then do:
      183       return 1 .
      184     end.
      185     define variable v-rest as integer   no-undo .
      186     assign
      187       p-number = p-number modulo 100
      188     .
      189     if p-number < 20
      190     then do:
      191       assign
      192         v-rest = p-number
      193       .
      194     end.
      195     else do:
      196       assign
      197         v-rest = p-number modulo 10
      198       .
      199     end.
      200     case v-rest :
      201       when 1
      202       then do:
      203         return 2 .
      204       end.
      205       when 2 or
      206       when 3 or
      207       when 4
      208       then do:
      209         return 3 .
      210       end.
      211       otherwise do:
      212         return 1 .
      213       end.
      214     end case .
      215   end.
      216   procedure cur-time-mjd-to-date :
      217      define input  parameter i-mjd-diff as decimal no-undo.
      218      define output parameter o-Date     as date    no-undo.
      219      define output parameter o-Time     as integer no-undo.
      220      define variable v-day-number as integer   no-undo .
      221      if    i-mjd-diff < 0
      222         or i-mjd-diff = ?
      223      then do:
      224         return "?" .
      225      end.
      226      assign
      227         v-day-number = truncate(i-mjd-diff,0).
      228         o-Date = date(v-day-number + 2400002).
      229         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      230     .
      231   end.
      232   function cur-time-mjd-to-string returns character
      233   (input p-mjd-diff as decimal
      234   )
      235   :
      236     define variable v-day-number as integer   no-undo .
      237     define variable v-seconds    as integer   no-undo .
      238     define variable v-hour       as integer   no-undo .
      239     define variable v-min        as integer   no-undo .
      240     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      241     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      242     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      243     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      244     if p-mjd-diff < 0
      245     or p-mjd-diff = ?
      246     then do:
      247       return "?" .
      248     end.
      249     assign
      250       v-day-number = integer(truncate(p-mjd-diff,0))
      251       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      252     .
      253     if v-seconds > 86400
      254     then do:
      255       assign
      256         v-seconds = 86400 - 1
      257       .
      258     end.
      259     if v-seconds < 0
      260     then do:
      261       assign
      262         v-seconds = 0
      263       .
      264     end.
      265     assign
      266       v-hour = truncate(v-seconds / 3600, 0)
      267     .
      268     assign
      269       v-seconds = v-seconds modulo 3600
      270     .
      271     assign
      272       v-min = truncate(v-seconds / 60, 0)
      273     .
      274     assign
      275       v-seconds = v-seconds modulo 60
      276     .
      277     return
      278         (if v-day-number <> 0
      279           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      280           else ""
      281         )
      282       + (if v-day-number <> 0 or v-hour <> 0
      283           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      284           else ""
      285         )
      286       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      287           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      288           else ""
      289         )
      290       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      291       .
      292   end.
      293   function cur-time-string returns character
      294   :
      295     define variable v-date as date      no-undo .
      296     define variable v-time as integer   no-undo .
      297     run cur-time in this-procedure
      298       (output v-date
      299       ,output v-time
      300       ) .
      301     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      302   end.
      303   function cur-time-string-sec returns character
      304   :
      305     define variable v-date as date      no-undo .
      306     define variable v-time as integer   no-undo .
      307     run cur-time in this-procedure
      308       (output v-date
      309       ,output v-time
      310       ) .
      311     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      312   end.
      313   function cur-time-custom  returns character
      314   (input p-prefix as character
      315   ,input p-date-format as character
      316   ,input p-delimiter as character
      317   ,input p-time-format as character
      318   ,input p-suffix as character
      319   )
      320   :
      321     define variable v-date as date      no-undo .
      322     define variable v-time as integer   no-undo .
      323     run cur-time in this-procedure
      324       (output v-date
      325       ,output v-time
      326       ) .
      327     return
      328       p-prefix
      329       + string(v-date, p-date-format)
      330       + p-delimiter
      331       + string(v-time, p-time-format)
      332       + p-suffix
      333       .
      334   end.
      335   function cur-time-print  returns character
      336   :
      337     define variable v-date as date      no-undo .
      338     define variable v-time as integer   no-undo .
      339     run cur-time in this-procedure
      340       (output v-date
      341       ,output v-time
      342       ) .
      343     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      344   end.
      345   function cur-time-datetime returns datetime
      346   :
      347     define variable v-char as character no-undo .
      348     define variable v-datetime as datetime no-undo .
      349     v-char = cur-time-string().
      350     v-datetime = datetime(v-char).
      351     return  v-datetime.
      352   end.
      353   function cur-time-string-msec returns character
      354   :
      355     define variable v-date as datetime  no-undo .
      356     v-date = now.
      357     return string(v-date) .
      358   end.
      359   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      360   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      361   define new shared variable RepPathName        as character no-undo .
      362   define new shared variable PrintRubl          as logical   no-undo .
      363   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      364   define variable v-waitfram-action01         as character   no-undo .
      365   define variable v-waitfram-action02         as character   no-undo .
      366   define variable v-waitfram-action03         as character   no-undo .
      367   define variable mWaitFramTextBeg            as character   no-undo.
      368   define variable mWaitFramTextEnd            as character   no-undo.
      369   define variable mWaitFramView               as logical     no-undo.
      370   define variable mWaitProcEvent              as logical     no-undo init yes.
      371   define variable mWaitFramInterval           as integer     no-undo init 1 .
      372   define variable mWaitFramStop               as logical     no-undo.
      373   define variable mWaitFramStopUser           as logical     no-undo.
      374   define variable mWaitFramStopTimeOut        as logical     no-undo.
      375   define variable mWaitFramStartProc          as datetime-tz no-undo.
      376   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      377   define button B-WaitFramStop auto-end-key
      378        label "Стоп"
      379        size 10 by 1 tooltip "Остоновить процесс".
      380   define button B-viewProcInfo
      381        label "Информация"
      382        size 15 by 1 tooltip "Информация о процесс".
      383   define frame waitfram
      384     v-waitfram-action01 format "x(72)" no-label skip
      385     v-waitfram-action02 format "x(72)" no-label skip
      386     v-waitfram-action03 format "x(72)" no-label skip
      387     B-viewProcInfo
      388     B-WaitFramStop at row 4 col 30
      389     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      390     .
      391   define new global shared variable mBatchMode as logical no-undo init ?.
      392   define variable mFramBachModHandle as handle no-undo.
      393   mFramBachModHandle = frame waitfram:handle.
      394   define variable mFameOldVis as logical no-undo.
      395   define variable mVisCUrentVin as logical no-undo.
      396   if session:batch-mode
      397   then
      398      mBatchMode = yes.
      399   if mBatchMode = ? then do:
      400     mVisCUrentVin = current-window:visible.
      401     mFameOldVis = mFramBachModHandle:visible.
      402     mFramBachModHandle:visible  = yes.
      403     mBatchMode = mFramBachModHandle:visible ne yes.
      404     mFramBachModHandle:visible = mFameOldVis.
      405     current-window:visible = mVisCUrentVin.
      406   end.
      407    if  log-manager:logfile-name ne ?
      408     then DO:
      409         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      410         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      411         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      412     end.
      413   on choose of B-WaitFramStop in frame waitfram
      414   do:
      415     mWaitFramStop = yes.
      416     mWaitFramStopUser = yes.
      417   end.
      418   function waitfram-check-timeout returns logical():
      419      define variable vtime as int64 no-undo.
      420      if mWaitFramStopTimeOut
      421      then
      422         return yes.
      423      vtime = ( now - mWaitFramStartProc ) / 1000 .
      424      if     mWaitFramTimeOut ne ?
      425         and mWaitFramTimeOut ne 0
      426         and mWaitFramTimeOut lt vtime
      427      then do:
      428         mWaitFramStopTimeOut = yes.
      429      end.
      430      return mWaitFramStopTimeOut.
      431   end.
      432   procedure waitfram-hide :
      433     if not session:batch-mode
      434     then do
      435     on error undo, return error return-value
      436     :
      437       pause 0 before-hide .
      438       if not mBatchMode then
      439         hide frame waitfram .
      440     if     not mWaitFramView
      441        and mWaitProcEvent
      442     then
      443       process events .
      444     end.
      445   end procedure.
      446   procedure waitfram-show :
      447     define input  parameter p-message as character no-undo .
      448     define variable v-left-margin as integer   no-undo .
      449     if not session:batch-mode
      450     then do
      451     on error undo, return error return-value
      452     :
      453       if length(p-message) <= 70 then do:
      454         assign
      455           v-left-margin = integer((70 - length(p-message)) / 2)
      456         .
      457         assign
      458           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      459         .
      460         assign
      461           v-waitfram-action01 = " "
      462           v-waitfram-action02 = " "
      463                                    + fill(" ", v-left-margin)
      464                                    + p-message
      465           v-waitfram-action03 = " "
      466         .
      467       end.
      468       else do:
      469         define variable vRindex1 as integer no-undo.
      470         define variable vRindex2 as integer no-undo.
      471         vRindex1 = r-index(p-message," ",70).
      472         if vRindex1 = 0
      473         then
      474            vRindex1 = 70.
      475         if length(p-message)  <= vRindex1 + 70 then do:
      476           assign
      477             v-waitfram-action01 = " "
      478             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      479             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      480           .
      481         end.
      482         else do:
      483           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      484           if vRindex2 <= vRindex1
      485           then
      486              vRindex2 = vRindex1 + 70.
      487           assign
      488             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      489             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      490             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      491           .
      492         end.
      493       end.
      494       B-viewProcInfo:visible   in frame waitfram = no.
      495       B-viewProcInfo:sensitive in frame waitfram = no.
      496       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      497       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      498       if  (   mWaitFramView
      499          or  mWaitProcEvent)
      500          and not mBatchMode
      501       then
      502          display
      503             v-waitfram-action01 skip
      504             v-waitfram-action02 skip
      505             v-waitfram-action03 skip
      506          with frame waitfram .
      507       if     mWaitFramView
      508          then do:
      509             if     mWaitFramInterval ne ?
      510                and not mBatchMode
      511             then
      512                wait-for go of frame waitfram pause mWaitFramInterval.
      513          end.
      514          else
      515             if     mWaitProcEvent
      516                and not mBatchMode
      517             then
      518                process events .
      519     end.
      520   end procedure.
      521      procedure waitfram-show-this:
      522         define input  parameter iInterval as int64 no-undo.
      523         define variable vtime as int64 no-undo.
      524         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      525         mWaitFramInterval = iInterval.
      526         run waitfram-show (substitute("&1&2 &3&4" ,
      527                                       mWaitFramTextBeg ,
      528                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      529                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      530                                       mWaitFramTextEnd
      531                                      )
      532                           ).
      533      end.
      534      procedure WaitFramRunPause:
      535         define input  parameter iInterval as dec no-undo.
      536         define variable vStart  as datetime-tz no-undo.
      537         define variable vend    as datetime-tz no-undo.
      538         define variable vint as int64 no-undo.
      539         define variable vOk as logical no-undo.
      540         vStart = now.
      541         vend   = vStart.
      542         publish "WaitFramPause" (iInterval,output vOk).
      543         vend   =  now.
      544         vint = vend - vStart.
      545         vint = iInterval - vint / 1000.
      546         if     not mWaitFramStop
      547            and (   vint > 0
      548                 or (    not vOk
      549                     and iInterval eq ?
      550                     )
      551                 )
      552         then
      553            run waitfram-show-this (iInterval).
      554         vend   =  now.
      555         vint = vend - vStart.
      556         vint = iInterval - vint / 1000.
      557         if     not mWaitFramStop
      558            and vint > 0
      559         then do:
      560            run gbl/pause.p (vint * 1000).
      561         end.
      562         if iInterval ne ?
      563         then
      564            publish "WaitFramStop".
      565         waitfram-check-timeout().
      566      end.
      567      procedure WaitFramWaitFor:
      568         define input  parameter iInterval as dec no-undo.
      569         assign
      570            mWaitFramStartProc   = now
      571            mWaitFramStopUser    = no
      572            mWaitFramStopTimeOut = no
      573         .
      574         block-wait:
      575         do while not mWaitFramStop:
      576            run WaitFramRunPause (iInterval).
      577            if  waitfram-check-timeout()
      578            then do:
      579               leave block-wait.
      580            end.
      581         end.
      582         run waitfram-hide.
      583      end.
      584   procedure waitfram-join :
      585     define input  parameter p-line-1  as character no-undo .
      586     define input  parameter p-line-2  as character no-undo .
      587     define input  parameter p-line-3  as character no-undo .
      588     define output parameter p-message as character no-undo .
      589     do
      590     on error undo, return error return-value
      591     :
      592       assign
      593         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      594                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      595                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      596       .
      597     end.
      598   end procedure.
      599   function waitfram-join-function returns character
      600     (input p-line-1 as character
      601     ,input p-line-2 as character
      602     ,input p-line-3 as character
      603     ).
      604     define variable v-message as character no-undo .
      605     run waitfram-join in this-procedure
      606       (input  p-line-1
      607       ,input  p-line-2
      608       ,input  p-line-3
      609       ,output v-message
      610       ) .
      611     return v-message .
      612   end function .
      613   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      614   procedure fltfield-clear :
      615     define output parameter loc-fld as character no-undo.
      616     define output parameter loc-lab as character no-undo .
      617     define output parameter loc-spr as character no-undo .
      618     define output parameter loc-dim as character no-undo .
      619     assign
      620       loc-fld = ""
      621       loc-lab = ""
      622       loc-spr = ""
      623       loc-dim = "0"
      624     .
      625   end procedure .
      626   procedure fltfield-add :
      627     define input        parameter par-fld as character no-undo.
      628     define input        parameter par-lab as character no-undo .
      629     define input        parameter par-spr as character no-undo .
      630     define input-output parameter loc-fld as character no-undo.
      631     define input-output parameter loc-lab as character no-undo .
      632     define input-output parameter loc-spr as character no-undo .
      633     define input-output parameter loc-dim as character no-undo .
      634     do
      635     on error undo, return error
      636     :
      637       assign
      638       loc-fld = if loc-dim = '0'
      639                 then par-fld
      640                 else (loc-fld + chr(44) + par-fld)
      641       loc-lab = if loc-dim = '0'
      642                 then par-lab
      643                 else (loc-lab + chr(44) + par-lab)
      644       loc-spr = if loc-dim = '0'
      645                 then par-spr
      646                 else (loc-spr + chr(44) + par-spr)
      647       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      648                 string(integer(if num-entries(loc-dim) > 1
      649                               then entry(2, loc-dim)
      650                               else entry(1, loc-dim)
      651                               ) + 1)
      652       no-error
      653       .
      654     end.
      655   end procedure.
