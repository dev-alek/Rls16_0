     1350   define variable v-doc-rec as recid no-undo .
     1351   define variable v-find as logical no-undo.
     1352   define variable v-start-date-chr as character no-undo .
     1353   define variable v-end-date-chr as character no-undo .
     1354   define variable v-host-code like ub.sysconf.host-code no-undo .
