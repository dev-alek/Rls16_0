     4314                             input this-procedure:handle
     4315                             ,input QUERY br-sum-grp-obj:handle
     4316                             ,input logical(parameter-2-36)
     4317                             ,input no-lock
     4318                             ,input parameter-3-36
     4319                             ,input parameter-4-36
     4320                             ,input parameter-5-36
