      956   function disgrpru-get-disc-role-label returns character ( input p-discnt-role as character):
      957   define variable v-role-label as character no-undo .
      958   v-role-label =  entry (lookup (p-discnt-role, 'gds-grp-pcnt,gds-grp-pcnt-kat,gds-grp-abs,gds-grp-qnty,gds-grp-sum':u) + 1, ',' + '% скидка на группу товара,% скидка на группу товара для кат.клиентов,Abs скидка на группу товара,% Скидка на группу товара по кол-ву,% Скидка на группу товара на сумму':u).
      959   if v-role-label = '':u then do:
      960     v-role-label = entry (lookup (p-discnt-role, 'cli-grp-pcnt':u) + 1, ',' + '% скидка на группу клиентов':u).
      961   end.
      962   return v-role-label.
      963   end function.
      964   procedure disgrpru-write :
      965     do
      966     on error undo, return error
      967     :
      968       define input parameter p-classif-type   like ub.dis-grp-rule.classif-type no-undo .
      969       define input parameter p-node-code      like ub.dis-grp-rule.node-code  no-undo .
      970       define input parameter p-host-code      like ub.dis-grp-rule.host-code no-undo .
      971       define input parameter p-obj-type       like ub.dis-grp-rule.obj-type   no-undo .
      972       define input parameter p-obj-code       like ub.dis-grp-rule.obj-code   no-undo .
      973       define input parameter p-pos-type       like ub.dis-grp-rule.pos-type   no-undo .
      974       define input parameter p-discnt-role    like ub.dis-grp-rule.discnt-role no-undo .
      975       define input parameter p-templ-rl-root  like ub.dis-grp-rule.templ-rl-root  no-undo .
      976       define input parameter p-time-templ-rl-root  like ub.dis-grp-rule.time-templ-rl-root  no-undo .
      977       define input parameter p-rule-num       like ub.dis-grp-rule.rule-num    no-undo .
      978       define input parameter p-nonunique      like ub.dis-grp-rule.nonunique   no-undo .
      979       define buffer buf_dis-grp-rule for ub.dis-grp-rule .
      980       define buffer lock_dis-grp-rule for ub.dis-grp-rule .
      981       define buffer buf_dis-rule for ub.dis-rule.
      982       define variable v-label          as character no-undo .
      983       define variable v-discnt-role as character no-undo .
      984       define variable v-host-code as integer no-undo .
      985       run discfgru-check in this-procedure (
      986                                             input 'dis-grp-rule':U
      987                                            ,input p-templ-rl-root
      988                                            ,input p-time-templ-rl-root
      989                                            ,input p-pos-type
      990                                            ,output v-discnt-role
      991                                             ) no-error .
      992       if error-status :error then do:
      993         undo, return error return-value .
      994       end.
      995      if p-discnt-role = ? then do:
      996         p-discnt-role = v-discnt-role.
      997       end.
      998       if p-discnt-role <> v-discnt-role then do:
      999         undo, return error substitute("Группа с кодом &1 &2 место использ.&3 уже есть скидка типа &4&5не может быть по шаблону &6 и расписанию &7"
     1000                                 ,p-node-code
     1001                                 ,p-obj-type + string(p-obj-code)
     1002                                 ,p-pos-type
     1003                                 ,entry (lookup (p-discnt-role, 'gds-grp-pcnt,gds-grp-pcnt-kat,gds-grp-abs,gds-grp-qnty,gds-grp-sum':u) + 1, ',' + '% скидка на группу товара,% скидка на группу товара для кат.клиентов,Abs скидка на группу товара,% Скидка на группу товара по кол-ву,% Скидка на группу товара на сумму':u)
     1004                                 ,chr(10)
     1005                                 ,p-templ-rl-root
     1006                                 ,p-rule-num).
     1007       end.
     1008       if p-pos-type = ? then do:
     1009   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1010   define variable v-param-type11 as character no-undo .
     1011   define variable v-value-date11 as date no-undo .
     1012   define variable v-value-decimal11 as decimal no-undo .
     1013   define variable v-value-integer11 as INTEGER no-undo .
     1014   define variable v-value-logical11 AS LOGICAL no-undo .
     1015   define variable v-tth11 as handle no-undo .
     1016   run adm/shattri.p (
     1017       input "get":U
     1018       ,input  p-obj-type
     1019       ,input  p-obj-code
     1020       ,input  'cd-sending':U
     1021       ,input  'dflt-cd':U
     1022       ,output p-pos-type
     1023       ,output v-value-date11
     1024       ,output v-value-decimal11
     1025       ,output v-value-integer11
     1026       ,output v-value-logical11
     1027       ,output v-param-type11
     1028       ,INPUT-OUTPUT table-handle v-tth11
     1029       )  .
     1030   delete object v-tth11 no-error.
     1031       end.
     1032       find first buf_dis-rule no-lock where
     1033                 buf_dis-rule.rule-num = p-rule-num no-error.
     1034       if not available buf_Dis-rule then do:
     1035         undo, return error substitute("Группа с кодом &1 &2 место использ.&3 уже есть скидка типа &4&5не найдено правило скидки &6"
     1036                                 ,p-node-code
     1037                                 ,p-obj-type + string(p-obj-code)
     1038                                 ,p-pos-type
     1039                                 ,entry (lookup (p-discnt-role, 'gds-grp-pcnt,gds-grp-pcnt-kat,gds-grp-abs,gds-grp-qnty,gds-grp-sum':u) + 1, ',' + '% скидка на группу товара,% скидка на группу товара для кат.клиентов,Abs скидка на группу товара,% Скидка на группу товара по кол-ву,% Скидка на группу товара на сумму':u)
     1040                                 ,chr(10)
     1041                                 ,p-rule-num).
     1042       end.
     1043       if buf_dis-rule.root <> yes then do:
     1044         undo, return error substitute("Группа с кодом &1 &2 место использ.&3 уже есть скидка типа &4&5правило скидки &6 - некорневое"
     1045                                 ,p-node-code
     1046                                 ,p-obj-type + string(p-obj-code)
     1047                                 ,p-pos-type
     1048                                 ,entry (lookup (p-discnt-role, 'gds-grp-pcnt,gds-grp-pcnt-kat,gds-grp-abs,gds-grp-qnty,gds-grp-sum':u) + 1, ',' + '% скидка на группу товара,% скидка на группу товара для кат.клиентов,Abs скидка на группу товара,% Скидка на группу товара по кол-ву,% Скидка на группу товара на сумму':u)
     1049                                 ,chr(10)
     1050                                 ,p-rule-num).
     1051       end.
     1052       if not (p-obj-type = buf_dis-rule.obj-type
     1053           and p-obj-code = buf_dis-rule.obj-code) then do:
     1054         undo, return error (substitute("Группа с кодом &1 &2 место использ.&3 уже есть скидка типа &4&5правило скидки &6"
     1055                                 ,p-node-code
     1056                                 ,p-obj-type + string(p-obj-code)
     1057                                 ,p-pos-type
     1058                                 ,entry (lookup (p-discnt-role, 'gds-grp-pcnt,gds-grp-pcnt-kat,gds-grp-abs,gds-grp-qnty,gds-grp-sum':u) + 1, ',' + '% скидка на группу товара,% скидка на группу товара для кат.клиентов,Abs скидка на группу товара,% Скидка на группу товара по кол-ву,% Скидка на группу товара на сумму':u)
     1059                                 ,chr(10)
     1060                                 ,p-rule-num)
     1061                             +
     1062                             substitute("Правило скидки &1 определено для &1&2" +
     1063                                        "а привязка к ДК для &3"
     1064                                        ,get-region( buf_Dis-rule.host-code, buf_dis-rule.obj-type, buf_Dis-rule.obj-code)
     1065                                        ,chr(10)
     1066                                        ,get-region( p-host-code, p-obj-type, p-obj-code)
     1067                                        ))
     1068                                 .
     1069       end.
     1070       find first buf_dis-grp-rule exclusive-lock where
     1071                  buf_dis-grp-rule.classif-type  = p-classif-type
     1072              AND buf_dis-grp-rule.node-code  = p-node-code
     1073              AND buf_dis-grp-rule.host-code  = p-host-code
     1074              AND buf_dis-grp-rule.obj-type  = p-obj-type
     1075              AND buf_dis-grp-rule.obj-code  = p-obj-code
     1076              AND buf_dis-grp-rule.pos-type  = p-pos-type
     1077              AND buf_dis-grp-rule.discnt-role = p-discnt-role
     1078              and buf_dis-grp-rule.nonunique = p-nonunique
     1079              no-error .
     1080       if not available buf_dis-grp-rule then do:
     1081         create buf_dis-grp-rule .
     1082         assign
     1083         buf_dis-grp-rule.classif-type  = p-classif-type
     1084         buf_dis-grp-rule.node-code  = p-node-code
     1085         buf_dis-grp-rule.obj-type  = p-obj-type
     1086         buf_dis-grp-rule.obj-code  = p-obj-code
     1087         buf_dis-grp-rule.host-code  = p-host-code
     1088         buf_dis-grp-rule.pos-type = p-pos-type
     1089         buf_dis-grp-rule.discnt-role = v-discnt-role
     1090         buf_dis-grp-rule.rule-num = p-rule-num
     1091         buf_dis-grp-rule.nonunique = p-nonunique
     1092         no-error
     1093         .
     1094       end.
     1095       ASSIGN
     1096       buf_dis-grp-rule.rule-num = p-rule-num
     1097       buf_dis-grp-rule.rl-root = p-rule-num
     1098       buf_dis-grp-rule.templ-rl-root = p-templ-rl-root
     1099       buf_dis-grp-rule.time-templ-rl-root = p-time-templ-rl-root
     1100       buf_dis-grp-rule.nonunique = p-nonunique
     1101       no-error.
     1102     end.
     1103   end procedure.
     1104   procedure disgrpru-delete :
     1105   define input parameter p-classif-type   like ub.dis-grp-rule.classif-type no-undo .
     1106   define input parameter p-node-code      like ub.dis-grp-rule.node-code  no-undo .
     1107   define input parameter p-host-code      like ub.dis-grp-rule.host-code   no-undo .
     1108   define input parameter p-obj-type       like ub.dis-grp-rule.obj-type   no-undo .
     1109   define input parameter p-obj-code       like ub.dis-grp-rule.obj-code   no-undo .
     1110   define input parameter p-pos-type       like ub.dis-grp-rule.pos-type   no-undo .
     1111   define input parameter p-discnt-role    like ub.dis-grp-rule.discnt-role no-undo .
     1112   define input parameter p-nonunique      like ub.dis-grp-rule.nonunique   no-undo .
     1113   define output parameter p-deleted       as logical no-undo .
     1114   define variable v-rule-label as character no-undo .
     1115   define buffer buf_dis-grp-rule for ub.dis-grp-rule.
     1116   do
     1117   on error undo, return error
     1118   :
     1119   find first buf_dis-grp-rule exclusive-lock where
     1120               buf_dis-grp-rule.classif-type  = p-classif-type
     1121           AND buf_dis-grp-rule.node-code  = p-node-code
     1122           AND buf_dis-grp-rule.obj-type  = p-obj-type
     1123           AND buf_dis-grp-rule.host-code = p-host-code
     1124           AND buf_dis-grp-rule.obj-code  = p-obj-code
     1125           AND buf_dis-grp-rule.pos-type  = p-pos-type
     1126           AND buf_dis-grp-rule.discnt-role = p-discnt-role
     1127           and buf_dis-grp-rule.nonunique = p-nonunique
     1128           no-error .
     1129   if not available buf_dis-grp-rule then do:
     1130     return '':U.
     1131   end.
     1132   delete buf_dis-grp-rule no-error.
     1133   if error-status:error then do:
     1134     run disgrpru-name in this-procedure
     1135       (input  buf_dis-grp-rule.templ-rl-root
     1136       ,output v-rule-label
     1137       ) no-error .
     1138     undo, return error substitute("Ошибка при удалении скидки по группе:&1" +
     1139                                  "&2 (место использ. &3) на фирме &4 &5&6 для группы &7&1&8&1&9"
     1140                                   ,chr(10)
     1141                                   ,v-rule-label
     1142                                   ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
     1143                                   ,p-host-code
     1144                                   ,p-obj-type
     1145                                   ,p-obj-code
     1146                                   ,error-status:get-message(1)
     1147                                   ,return-value ).
     1148   end.
     1149   p-deleted = yes.
     1150   return '':U.
     1151   end.
     1152   end procedure.
     1153   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1154   FUNCTION mark-string RETURNS CHARACTER
     1155     ( input p-recid as recid, input mark-list as character  ) :
     1156     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
     1157   END FUNCTION.
     1158   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1159   function usrfulnf returns character ( input p-user-id as character):
     1160   define variable v-user-name as character no-undo .
     1161   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1162   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
     1163     (input  p-user-id
     1164     ,output v-user-name
     1165     ) no-error .
     1166   if error-status:error
