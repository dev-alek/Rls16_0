     4497          run OpenBr in this-procedure
     4498           (input false
     4499           ,input true
     4500           ,input substitute("and X_c-sum-grp-obj.corr-date = &1 "
     4501             , v-date-chr)
     4502           ).
     4503         apply "entry":u to sch-corr-date in frame Dialog-Frame.
