     4271                             input this-procedure:handle
     4272                             ,input QUERY br-sum-grp-obj:handle
     4273                             ,input rowid(X_c-sum-grp-obj)
     4274                             ,input logical(parameter-2-36)
     4275                             ,input no-lock
     4276                             ,input (buffer X_c-sum-grp-obj:handle)
     4277                             ,input parameter-4-36
     4278                             ,input parameter-5-36
     4279                             ) no-error.
     4280         .
