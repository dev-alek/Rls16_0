     3780       run set-filter-name in this-procedure
     3781         (INPUT filter-name-32
     3782         ) no-error .
     3783     assign
     3784       l-filter-open-32 = false
     3785     .
     3786     if flt-rec-32 <> ?
     3787       or sort-column-phrase > ""
     3788     then do:
     3789       define variable  parameter-2-32 as character no-undo .
     3790       define variable  parameter-3-32 as character no-undo .
     3791       define variable  parameter-4-32 as character no-undo .
     3792       define variable  parameter-5-32 as character no-undo .
     3793       define variable  parameter-6-32 as character no-undo .
     3794       define variable  parameter-7-32 as character no-undo .
     3795         assign
     3796         parameter-3-32 =
     3797                                 "FOR EACH X_c-sum-grp-obj"
     3798         parameter-4-32 =
     3799           (
     3800             if (" TRUE " + " " + where-phrase-32) <> ""
     3801             then " TRUE " + " " + where-phrase-32
     3802             else "true"
     3803           )
     3804         parameter-5-32 = (" " + "" + " " + "")
     3805         parameter-6-32 = if sort-phrase-32 = ''
     3806                              then
     3807           (
     3808           " " + "  " +
     3809             " " + sort-column-phrase +
     3810           " " + "  "
     3811           )
     3812                              else
     3813           (
     3814           " " + "  " +
     3815             " " + sort-column-phrase +
     3816           " " + sort-phrase-32
     3817           )
     3818         parameter-7-32 =
     3819           " indexed-reposition  "
     3820       .
     3821       do
     3822       on stop undo, leave
     3823       on error undo, leave
     3824       :
     3825         assign
     3826           l-disable-where-32 =
     3827             (" TRUE " + " " + where-phrase-32 = "")
     3828         .
