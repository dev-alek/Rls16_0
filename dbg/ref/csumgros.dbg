     4191             if (" X_c-sum-grp-obj.obj-type = p-obj-type and X_c-sum-grp-obj.obj-code = p-obj-code AND X_c-sum-grp-obj.grp-code  = p-grp-code " + " " + where-phrase-36) <> ""
     4192             then  substitute('X_c-sum-grp-obj.obj-type = &1&2&1 and X_c-sum-grp-obj.obj-code = &3 AND X_c-sum-grp-obj.grp-code  = &4 '                             , chr(34), p-obj-type, p-obj-code,  p-grp-code) + " " + where-phrase-36
     4193             else "true"
     4194           )
     4195         parameter-5-36 = (" " + "" + " " + "")
     4196         parameter-6-36 = if sort-phrase-36 = ''
     4197                              then
     4198           (
     4199           " " + "  " +
     4200             " " + sort-column-phrase +
     4201           " " + "  "
     4202           )
     4203                              else
     4204           (
     4205           " " + "  " +
     4206             " " + sort-column-phrase +
     4207           " " + sort-phrase-36
     4208           )
     4209         parameter-7-36 =
     4210           " indexed-reposition  "
     4211       .
     4212       do
     4213       on stop undo, leave
     4214       on error undo, leave
     4215       :
     4216         assign
     4217           l-disable-where-36 =
     4218             (" X_c-sum-grp-obj.obj-type = p-obj-type and X_c-sum-grp-obj.obj-code = p-obj-code AND X_c-sum-grp-obj.grp-code  = p-grp-code " + " " + where-phrase-36 = "")
     4219         .
     4220         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     4221                             ,input QUERY br-sum-grp-obj:handle
     4222                             ,input parameter-3-36
     4223                             ,input parameter-4-36
     4224                             ,input parameter-5-36
     4225                             ,input parameter-6-36
     4226                             ,input parameter-7-36
     4227                             )
     4228         .
     4229         assign
     4230           l-filter-open-36 = true
     4231         .
     4232       end.
     4233       if l-filter-open-36 = false then do:
     4234         message
     4235           "Ошибка при фильтрации / сортировке" skip
     4236           "Будут показаны записи без учета фильтра" skip
