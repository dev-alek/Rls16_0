     3430   def var sort-labelbr-sum-grp-obj   as character no-undo .
     3431   def var sort-clmnbr-sum-grp-obj    as handle    no-undo .
     3432   def var cur-clmnbr-sum-grp-obj     as handle    no-undo .
     3433   def var cur-clmn-locbr-sum-grp-obj as integer   no-undo .
     3434   def var re-querybr-sum-grp-obj     as logical   initial no no-undo .
     3435   on start-search, ctrl-o of br-sum-grp-obj in frame Dialog-Frame do:
     3436      run sort-brbr-sum-grp-obj
     3437        (input (if available X_c-sum-grp-obj
     3438                then recid(X_c-sum-grp-obj)
     3439                else ?
     3440               )
     3441        ).
     3442   end.
     3443   PROCEDURE sort-brbr-sum-grp-obj :
     3444     define input parameter p-recid as recid no-undo .
     3445     if re-querybr-sum-grp-obj = no then do:
     3446       assign
     3447          cur-clmnbr-sum-grp-obj = br-sum-grp-obj:current-column in frame Dialog-Frame
     3448       .
     3449       if sort-clmnbr-sum-grp-obj <> ? then sort-clmnbr-sum-grp-obj:column-fgcolor = 0.
     3450       if cur-clmnbr-sum-grp-obj = sort-clmnbr-sum-grp-obj then do:
     3451         assign
     3452            sort-labelbr-sum-grp-obj = ""
     3453            sort-clmnbr-sum-grp-obj = ?
     3454         .
     3455        end.
     3456        else do:
     3457          assign
     3458            sort-labelbr-sum-grp-obj = cur-clmnbr-sum-grp-obj:label
     3459            sort-clmnbr-sum-grp-obj  = cur-clmnbr-sum-grp-obj
     3460            sort-clmnbr-sum-grp-obj:column-fgcolor = 4
     3461          .
     3462        end.
     3463      end.
     3464     assign
     3465       cur-clmn-locbr-sum-grp-obj = 1
     3466     .
     3467     def var column-handle as handle no-undo .
     3468     column-handle = br-sum-grp-obj:first-column.
     3469     do while valid-handle(column-handle) :
     3470       if column-handle = cur-clmnbr-sum-grp-obj then do:
     3471         leave .
     3472       end.
     3473       column-handle = column-handle:NEXT-COLUMN.
     3474       assign
     3475         cur-clmn-locbr-sum-grp-obj = cur-clmn-locbr-sum-grp-obj + 1
     3476       .
     3477     end.
     3478     case sort-labelbr-sum-grp-obj:
     3479           when X_c-sum-grp-obj.grp-code:label in browse br-sum-grp-obj then DO:    assign       sort-column-name = "X_c-sum-grp-obj.grp-code"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     3480           when X_c-sum-grp-obj.corr-date:label in browse br-sum-grp-obj then DO:    assign       sort-column-name = "X_c-sum-grp-obj.corr-date"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     3481           when X_c-sum-grp-obj.corr-user-db-num:label in browse br-sum-grp-obj then DO:    assign       sort-column-name = "X_c-sum-grp-obj.corr-user-db-num"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     3482       otherwise do:
     3483         assign
     3484           sort-column-name = ""
     3485         .
     3486         run OpenBr in this-procedure ( input yes, input no, input '':U).
     3487           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-sum-grp-obj') then do:
     3488             run mv-brw-defaultbr-sum-grp-obj.
     3489           end.
     3490         if sort-labelbr-sum-grp-obj <> "" then do:
     3491           assign
     3492             cur-clmnbr-sum-grp-obj:column-fgcolor = 0
     3493           .
     3494         end.
     3495         assign
     3496           cur-clmn-locbr-sum-grp-obj = ?
     3497         .
     3498       end.
     3499     end case.
     3500       if cur-clmn-locbr-sum-grp-obj <> ? then do:
     3501         if can-do( this-procedure:internal-entries, 'ch-clmnbr-sum-grp-obj') then do:
     3502           run ch-clmnbr-sum-grp-obj in this-procedure (cur-clmn-locbr-sum-grp-obj).
     3503         end.
     3504       end.
     3505     if p-recid <> ? then do:
     3506       reposition br-sum-grp-obj to recid p-recid no-error.
     3507       apply "value-changed" to br-sum-grp-obj in frame Dialog-Frame.
     3508     end.
     3509     apply "entry" to br-sum-grp-obj in frame Dialog-Frame.
     3510   END PROCEDURE.
     3511   procedure re-open-query-srt-clmnbr-sum-grp-obj:
     3512   if cur-clmnbr-sum-grp-obj = ? then do:
     3513      run OpenBr in this-procedure ( input yes, input no, input '':U).
     3514   end.
     3515   else do:
     3516      assign re-querybr-sum-grp-obj = yes.
     3517      run sort-brbr-sum-grp-obj
     3518        (input (if available X_c-sum-grp-obj
     3519                then recid(X_c-sum-grp-obj)
     3520                else ?
     3521               )
     3522        ).
     3523      assign re-querybr-sum-grp-obj = no.
     3524   end.
     3525   end.
     3526   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3527   do:
     3528     BR-changes :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     3529   end.
     3530   MAIN-BLOCK:
     3531   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3532      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3533      if p-mode <> 'все':U
     3534    and p-mode <> "one":U
     3535    and p-mode <> 'объект':U
     3536     then dO:
     3537       message
     3538       vss-workfile vss-revision vss-description skip
     3539       "Неверное значение параметров вызова p-mode"
     3540       p-mode
     3541       view-as alert-box ERROR.
     3542       return.
     3543    end.
     3544    if p-mode = 'объект':U
     3545    or p-mode = "subject":U
     3546    then do:
     3547     find first X_clients no-lock where
     3548                   X_clients.obj-type = p-obj-type
     3549               and X_clients.obj-code = p-obj-code no-error.
     3550       if not available X_clients then do:
     3551           message
     3552           vss-workfile vss-revision vss-description skip
     3553           "Неверное значение параметра вызова p-obj-type/p-obj-code"
     3554           p-obj-type p-obj-code
     3555           view-as alert-box ERROR.
     3556           return.
     3557       end.
     3558   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3559   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3560     (input  p-obj-type
     3561     ,input  p-obj-code
     3562     ,output v-host-code
     3563     )  .
     3564    end.
     3565    v-rid-list = p-rid-list.
     3566     if v-rid-list <> "" then do:
     3567         FIND FIRST find_sum-grp-obj No-LOCK where
     3568                    recid(find_sum-grp-obj) = integer(entry(1, v-rid-list)) No-ERROR.
     3569         if not avail find_sum-grp-obj then do:
     3570           message
     3571           vss-workfile vss-revision vss-description skip
     3572           "Неверное значение параметра вызова v-rid-list" v-rid-list
     3573           view-as alert-box error .
     3574           return error.
     3575         end.
     3576         v-doc-rec = integer(entry(1, v-rid-list)).
     3577       end.
     3578   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3579   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     3580     (output v-db-num
     3581     )  .
     3582     if p-mode <> 'все':U then do:
     3583       assign
     3584       v-find = yes.
     3585     end.
     3586     RUN MyEnable.
     3587     RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     3588     HIDE mark-num in frame Dialog-Frame .
     3589     if v-rid-list <> "":U then
     3590     REPOSITION br-sum-grp-obj to recid integer(entry(1, v-rid-list)) No-ERROR.
     3591   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3592   DEF VAR cur-clmn-numbr-sum-grp-obj as INT EXTENT 8 no-undo.
     3593   DEF VAR varmvibr-sum-grp-obj       as INT no-undo.
     3594   DEF VAR varmvjbr-sum-grp-obj       as INT no-undo.
     3595   DEF VAR varmvkbr-sum-grp-obj       as INT no-undo.
     3596   DEF VAR varmvlbr-sum-grp-obj       as INT no-undo.
     3597   DEF VAR move-elementbr-sum-grp-obj as INT no-undo.
     3598   def var jjbr-sum-grp-obj           as int no-undo.
     3599   do varmvibr-sum-grp-obj = 1 to EXTENT(cur-clmn-numbr-sum-grp-obj):
     3600     ASSIGN cur-clmn-numbr-sum-grp-obj[varmvibr-sum-grp-obj] = varmvibr-sum-grp-obj.
     3601   END.
     3602   RUN start-mv-clmnbr-sum-grp-obj.
     3603   PROCEDURE start-mv-clmnbr-sum-grp-obj:
     3604   def var old-session as logical no-undo.
     3605      old-session = SESSION:IMMEDIATE-DISPLAY.
     3606      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3607          IF  p-mode = 'все':U  THEN DO:
     3608      DO jjbr-sum-grp-obj = NUM-ENTRIES('1,2,3,4,5,6,7,8') TO 1 BY -1:
     3609        RUN re-move-clmnbr-sum-grp-obj ( cur-clmn-numbr-sum-grp-obj[INTEGER(ENTRY (jjbr-sum-grp-obj, '1,2,3,4,5,6,7,8'))] , 1).
     3610      END.
     3611          END.
     3612          IF  p-mode <> 'все':U  THEN DO:
     3613      DO jjbr-sum-grp-obj = NUM-ENTRIES('1,2,3,4,5,6,7,8') TO 1 BY -1:
     3614        RUN re-move-clmnbr-sum-grp-obj ( cur-clmn-numbr-sum-grp-obj[INTEGER(ENTRY (jjbr-sum-grp-obj, '1,2,3,4,5,6,7,8'))] , 1).
     3615      END.
     3616          END.
     3617      SESSION:IMMEDIATE-DISPLAY = old-session.
     3618   END.
     3619   ON ctrl-cursor-right OF BROWSE br-sum-grp-obj do:
     3620     RUN re-move-clmnbr-sum-grp-obj ( 1, 8).
     3621   END.
     3622   ON ctrl-cursor-left OF BROWSE br-sum-grp-obj do:
     3623     RUN re-move-clmnbr-sum-grp-obj (8, 1).
     3624   END.
     3625   PROCEDURE re-move-clmnbr-sum-grp-obj:
     3626     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3627     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3628     DO varmvibr-sum-grp-obj = 1 TO EXTENT(cur-clmn-numbr-sum-grp-obj):
     3629       if cur-clmn-numbr-sum-grp-obj[varmvibr-sum-grp-obj] = source-column THEN cur-clmn-numbr-sum-grp-obj[varmvibr-sum-grp-obj] = -1.
     3630     END.
     3631     if br-sum-grp-obj:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     3632     if source-column > target-column THEN
     3633     DO varmvjbr-sum-grp-obj = source-column - 1 to target-column BY -1:
     3634       DO varmvibr-sum-grp-obj = 1 TO EXTENT(cur-clmn-numbr-sum-grp-obj):
     3635           if cur-clmn-numbr-sum-grp-obj[varmvibr-sum-grp-obj] = varmvjbr-sum-grp-obj THEN DO:
     3636             cur-clmn-numbr-sum-grp-obj[varmvibr-sum-grp-obj] = cur-clmn-numbr-sum-grp-obj[varmvibr-sum-grp-obj] + 1.
     3637           END.
     3638       END.
     3639     END.
     3640     ELSE
     3641     DO varmvjbr-sum-grp-obj = source-column + 1 to target-column:
     3642       DO varmvibr-sum-grp-obj = 1 TO EXTENT(cur-clmn-numbr-sum-grp-obj):
     3643         if cur-clmn-numbr-sum-grp-obj[varmvibr-sum-grp-obj] = varmvjbr-sum-grp-obj THEN DO:
     3644           cur-clmn-numbr-sum-grp-obj[varmvibr-sum-grp-obj] = cur-clmn-numbr-sum-grp-obj[varmvibr-sum-grp-obj] - 1.
     3645         END.
     3646       END.
     3647     END.
     3648     DO varmvibr-sum-grp-obj = 1 TO EXTENT(cur-clmn-numbr-sum-grp-obj):
     3649       if cur-clmn-numbr-sum-grp-obj[varmvibr-sum-grp-obj] = -1 THEN cur-clmn-numbr-sum-grp-obj[varmvibr-sum-grp-obj] = target-column.
     3650     END.
     3651   END PROCEDURE.
     3652   PROCEDURE ch-clmnbr-sum-grp-obj:
     3653     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3654     if cur-clmn-loc <= 1 then do:
     3655       return .
     3656     end.
     3657     DO varmvibr-sum-grp-obj = 1 TO EXTENT(cur-clmn-numbr-sum-grp-obj):
     3658       if cur-clmn-numbr-sum-grp-obj[varmvibr-sum-grp-obj] = cur-clmn-loc THEN move-elementbr-sum-grp-obj = varmvibr-sum-grp-obj.
     3659     END.
     3660     RUN re-move-clmnbr-sum-grp-obj (cur-clmn-loc, 1).
     3661   END PROCEDURE.
     3662   PROCEDURE mv-brw-defaultbr-sum-grp-obj:
     3663   def var old-session as logical no-undo.
     3664     old-session = SESSION:IMMEDIATE-DISPLAY.
     3665     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3666     do varmvlbr-sum-grp-obj = 1 to EXTENT(cur-clmn-numbr-sum-grp-obj):
     3667       RUN re-move-clmnbr-sum-grp-obj (cur-clmn-numbr-sum-grp-obj[varmvlbr-sum-grp-obj], varmvlbr-sum-grp-obj).
     3668     END.
     3669     RUN start-mv-clmnbr-sum-grp-obj.
     3670     SESSION:IMMEDIATE-DISPLAY = old-session.
     3671   END PROCEDURE.
     3672   .
     3673     run diasize_add_browse in this-procedure
     3674       (input  'width':u
     3675       ,input  browse br-changes :handle
     3676       ) .
     3677     run diasize_init in this-procedure .
     3678     WAIT-FOR GO OF FRAME Dialog-Frame.
