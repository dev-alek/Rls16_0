     1356   define variable dopst as character no-undo format "X(1)".
     1357   define buffer X_curr_sysconf for ub.sysconf.
     1358   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1359   define NEW SHARED temp-table temp-changes no-undo
     1360   field f_name as character
     1361   field l_name as character
     1362   field v_old as character
     1363   field v_new as character
     1364   field t_name as character
