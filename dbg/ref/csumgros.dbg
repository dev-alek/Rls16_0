      891   FUNCTION get-region RETURNS CHARACTER
      892     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
      893     define variable par-region as character no-undo.
      894     if parhost-code = 0 and
      895          parobj-type = "":U and
      896          parobj-code = 0 then do:
      897          par-region = "Глобально".
      898          return par-region.
      899       end.
      900       if parobj-type = 'орг':U then do:
      901          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
      902          return par-region.
      903       end.
      904       if parobj-type = 'регион':U
      905       then do:
      906          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      907          return par-region.
      908       end.
      909       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      910       return par-region.
      911   END FUNCTION.
      912   FUNCTION get-objregion RETURNS CHARACTER
      913     (  input parobj-type as character, input parobj-code as integer ) :
      914     define variable par-region as character no-undo.
      915     if  parobj-type = "":U and
      916         parobj-code = 0
      917     then do:
      918        par-region = "Глобально".
      919     end.
      920     else if parobj-type = 'орг':U
      921     then do:
      922        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
      923     end.
      924     else if parobj-type = 'регион':U
      925     then do:
      926        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
      927     end.
      928     else
      929        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
      930     return par-region.
      931   END FUNCTION.
      932   procedure disgrpru-name :
      933   define buffer buf_dis-rule for ub.dis-rule.
      934   do
      935     on error undo, return error
      936     :
      937     define input  parameter p-templ-rl-root  as integer no-undo .
      938     define output parameter p-label          as character no-undo .
      939     find first buf_dis-rule no-lock where
      940               buf_dis-rule.rule-num = p-templ-rl-root no-error.
      941     if available buf_dis-rule then do:
      942       if buf_dis-rule.rule-num > 0 then
      943       p-label = buf_dis-rule.des.
      944     end.
      945     else do:
      946       p-label = substitute("Неизвестный тип правила скидки &1", p-templ-rl-root).
      947     end.
      948   end.
      949   end procedure.
