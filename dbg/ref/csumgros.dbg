     4242           .
     4243       end.
     4244     end.
     4245     if l-filter-open-36 = false then do:
     4246       OPEN QUERY br-sum-grp-obj FOR EACH X_c-sum-grp-obj
     4247         where  X_c-sum-grp-obj.obj-type = p-obj-type and X_c-sum-grp-obj.obj-code = p-obj-code AND X_c-sum-grp-obj.grp-code  = p-grp-code
     4248         indexed-reposition
