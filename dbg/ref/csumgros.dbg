     1379   .
     1380   FUNCTION get-all-fields returns character (p-file-name as character ):
     1381   define variable v-dop as character no-undo .
     1382     find first _file no-lock where _file._file-name = p-file-name no-error .
     1383     if not available _file then return "":U.
     1384     for each _field no-lock where
     1385              _field._file-recid = recid(_file) :
     1386       assign
     1387       v-dop = v-dop + _field._field-name + chr(44)
     1388       .
     1389     end.
     1390     return trim(v-dop).
     1391   END FUNCTION.
     1392   PROCEDURE proc-full-temp-changes :
     1393     define input  parameter p-act-create as logical   no-undo .
     1394     define input  parameter p-act-delete as logical   no-undo .
     1395     define input  parameter p-hst-handle as handle    no-undo .
     1396     define input  parameter p-main-table as character no-undo .
     1397     define input  parameter p-field-list as character no-undo .
     1398     define input  parameter p-label-form as character no-undo .
     1399     define variable h-new-buf         as handle    no-undo .
     1400     define variable h-main-buf        as handle    no-undo .
     1401     define variable h-for-comp        as handle    no-undo .
     1402     define variable v-inform          as character no-undo .
     1403     define variable v-ind             as integer   no-undo .
     1404     define variable v-idx-field-qnty  as integer   no-undo .
     1405     define variable v-num-entries     as integer   no-undo .
     1406     define variable fh                as handle    no-undo .
     1407     define variable fh-main           as handle    no-undo .
     1408     define variable fh-old            as handle    no-undo .
     1409     define variable fh-new            as handle    no-undo .
     1410     define variable v-field-name      as character no-undo .
     1411     define variable v-field-lvl       as character no-undo .
     1412     define variable v-field-form      as character no-undo .
     1413     define variable v-search-exp      as character no-undo .
     1414     define variable v-srch-main       as character no-undo .
     1415     define variable v-word-link       as character no-undo .
     1416     define variable v-av-chip-num     as logical   no-undo .
     1417     define variable v-main-pi-fld-lst as character no-undo .
     1418     define variable v-main-fld-lst    as character no-undo .
     1419     define variable v-delim-list      as character no-undo .
     1420     define variable v-label           as character no-undo .
     1421     define variable v-old-value       as character no-undo case-sensitive.
     1422     define variable v-new-value       as character no-undo case-sensitive.
     1423     define variable v-chg-fields as character no-undo.
     1424     for each temp-changes:
     1425       delete temp-changes.
     1426     end.
     1427     if not p-hst-handle:available then do:
     1428       return .
     1429     end.
     1430     create buffer h-new-buf  for table p-hst-handle .
     1431     create buffer h-main-buf for table p-main-table .
     1432     assign
     1433       v-inform = h-main-buf:index-information(1)
     1434       v-ind    = 2
     1435     .
     1436     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1437     on error undo, return error
     1438     :
     1439       assign
     1440         v-inform = h-main-buf:index-information( v-ind )
     1441         v-ind    = v-ind + 1
     1442       .
     1443     end.
     1444     if v-inform = ?
     1445       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1446       or entry( 3, v-inform, ",":U ) <> "1":U
     1447     then do:
     1448       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1449     end.
     1450     assign
     1451       v-idx-field-qnty = num-entries( v-inform ) - 4
     1452     .
     1453     if v-idx-field-qnty < 2 then do:
     1454       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1455     end.
     1456     assign
     1457       v-srch-main   = "where":U
     1458       v-word-link   = "":U
     1459       v-av-chip-num = false
     1460       v-delim-list  = "":U
     1461     .
     1462     do v-ind = 1 to v-idx-field-qnty by 2
     1463     on error undo, return error
     1464     :
     1465       assign
     1466         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1467         fh                = p-hst-handle:buffer-field( v-field-name )
     1468         fh-main           = h-main-buf:buffer-field( v-field-name )
     1469         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1470         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1471       .
     1472       if fh:data-type ="character":U then do:
     1473         assign
     1474           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1475         .
     1476       end.
     1477       else do:
     1478         assign
     1479           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1480         .
     1481       end.
     1482       if v-delim-list = "":U then do:
     1483         assign
     1484           v-delim-list = ",":U
     1485         .
     1486       end.
     1487       if v-word-link = "":U then do:
     1488         assign
     1489           v-word-link = "and":U
     1490         .
     1491       end.
     1492     end.
     1493     assign
     1494       v-delim-list  = "":U
     1495     .
     1496     do v-ind = 1 to h-main-buf:num-fields
     1497     on error undo, return error
     1498     :
     1499       assign
     1500         fh-main      = h-main-buf:buffer-field( v-ind )
     1501         v-field-name = fh-main:name
     1502       .
     1503         assign
     1504           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1505         .
     1506         if v-delim-list = "":U then do:
     1507           assign
     1508             v-delim-list = ",":U
     1509           .
     1510         end.
     1511     end.
     1512     assign
     1513       v-inform = p-hst-handle:index-information(1)
     1514       v-ind    = 2
     1515     .
     1516     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1517     on error undo, return error
     1518     :
     1519       assign
     1520         v-inform = p-hst-handle:index-information( v-ind )
     1521         v-ind    = v-ind + 1
     1522       .
     1523     end.
     1524     if v-inform = ?
     1525       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1526       or entry( 3, v-inform, ",":U ) <> "1":U
     1527     then do:
     1528       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1529     end.
     1530     assign
     1531       v-idx-field-qnty = num-entries( v-inform ) - 4
     1532     .
     1533     if v-idx-field-qnty < 2 then do:
     1534       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1535     end.
     1536     assign
     1537       v-search-exp  = "where":U
     1538       v-word-link   = "":U
     1539       v-av-chip-num = false
     1540     .
     1541     do v-ind = 1 to v-idx-field-qnty by 2
     1542     on error undo, return error
     1543     :
     1544       assign
     1545         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1546         fh           = p-hst-handle:buffer-field( v-field-name )
     1547         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1548       .
     1549       if v-field-name = "chip-num":U then do:
     1550         assign
     1551           v-search-exp  = substitute( "&1 >", v-search-exp )
     1552           v-av-chip-num = true
     1553         .
     1554       end.
     1555       else do:
     1556         assign
     1557           v-search-exp = substitute( "&1 =", v-search-exp )
     1558         .
     1559       end.
     1560       if fh:data-type ="character":U then do:
     1561         assign
     1562           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1563         .
     1564       end.
     1565       else do:
     1566         assign
     1567           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1568         .
     1569       end.
     1570       if v-word-link = "":U then do:
     1571         assign
     1572           v-word-link = "and":U
     1573         .
     1574       end.
     1575     end.
     1576     if v-av-chip-num = false then do:
     1577       message
     1578         vss-workfile vss-revision vss-description skip
     1579         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1580         "Использование данной процедуры невозможно!" skip
     1581         view-as alert-box error .
     1582       return error .
     1583     end.
     1584     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1585     if not h-new-buf:available then do:
     1586       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1587       if not h-main-buf:available then do:
     1588         assign
     1589           h-for-comp = ?
     1590         .
     1591       end.
     1592       else do:
     1593         assign
     1594           h-for-comp = h-main-buf
     1595         .
     1596       end.
     1597     end.
     1598     else do:
     1599       assign
     1600         h-for-comp = h-new-buf
     1601       .
     1602     end.
     1603     assign
     1604       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1605     .
     1606     do v-ind = 1 to v-num-entries
     1607     on error undo, return error return-value
     1608     :
     1609       assign
     1610         v-field-name = entry( v-ind, v-main-fld-lst )
     1611         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1612         v-old-value  = fh-old:buffer-value()
     1613         v-label      = trim( fh-old:label )
     1614       .
     1615       if ( trim( p-field-list ) <> "":U
     1616            and lookup( v-field-name, p-field-list ) > 0
     1617          )
     1618          or trim( p-field-list ) = "":U
     1619       then do:
     1620         if h-for-comp <> ? then do:
     1621           assign
     1622             fh-new      = h-for-comp:buffer-field( v-field-name )
     1623             v-new-value = fh-new:buffer-value()
     1624           .
     1625         end.
     1626         else do:
     1627           assign
     1628             v-new-value = "":U
     1629           .
     1630         end.
     1631           if p-act-create = true then do:
     1632             assign
     1633               v-old-value = "":U
     1634             .
     1635           end.
     1636           if p-act-delete = true then do:
     1637             assign
     1638               v-new-value = "":U
     1639             .
     1640           end.
     1641         if v-old-value <> v-new-value
     1642         then do:
     1643           create temp-changes.
     1644           assign
     1645             temp-changes.t_name = p-main-table
     1646             temp-changes.f_name = v-field-name
     1647             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1648             temp-changes.v_old  = trim( v-old-value )
     1649             temp-changes.v_new  = trim( v-new-value )
     1650             temp-changes.num_   = 0
     1651             temp-changes.fNotChange = v-old-value eq v-new-value
     1652           .
     1653         end.
     1654       end.
     1655     end.
     1656     assign
     1657       v-num-entries = num-entries( p-label-form, chr(8) )
     1658     .
     1659     do v-ind = 1 to v-num-entries
     1660     on error undo, return error return-value
     1661     :
     1662       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1663         assign
     1664           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1665           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1666           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1667         .
     1668         find first temp-changes
     1669           where temp-changes.f_name = v-field-name
     1670           no-error .
     1671         if available temp-changes then do:
     1672           if trim( v-field-lvl ) <> "":U then do:
     1673             assign
     1674               temp-changes.l_name = v-field-lvl
     1675             .
     1676           end.
     1677           if trim( v-field-form ) <> "":U then do:
     1678             assign
     1679               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1680             .
     1681             if h-for-comp <> ? then do:
     1682               assign
     1683                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1684               .
     1685             end.
     1686           end.
     1687         end.
     1688       end.
     1689       else do:
     1690         message
     1691           vss-workfile vss-revision vss-description skip
     1692           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1693           substitute( "список для поля '&1': '&2'"
     1694                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1695                       ,entry( v-ind, p-label-form, chr(8) )
     1696                     ) skip
     1697           substitute( "полный список: &2", p-label-form ) skip
     1698           view-as alert-box error .
     1699       end.
     1700     end.
     1701     delete object h-new-buf .
     1702     delete object h-main-buf .
     1703   END PROCEDURE.
     1704   FUNCTION get-action RETURNS CHARACTER
     1705     ( p-action as integer )  FORWARD.
     1706   FUNCTION get-subject RETURNS CHARACTER
     1707     ( p-subject as character )  FORWARD.
     1708   DEFINE BUTTON B-Help
     1709        LABEL "Помо&щь"
     1710        SIZE 3 BY 1
     1711        BGCOLOR 8 .
     1712   DEFINE BUTTON B-lookup
     1713        LABEL "&Просмотр"
     1714        SIZE 10 BY 1.
     1715   DEFINE BUTTON B-mark
     1716        LABEL "&*"
     1717        SIZE 3 BY 1.
     1718   DEFINE BUTTON B-print
     1719        LABEL "Пе&чать"
     1720        SIZE 3 BY 1.
     1721   DEFINE BUTTON b-quit AUTO-END-KEY
     1722        LABEL "&Выход"
     1723        SIZE 10 BY 1
     1724        BGCOLOR 8 .
     1725   DEFINE BUTTON B-sch
     1726        LABEL "&Фильтр"
     1727        SIZE 3 BY 1.
     1728   DEFINE BUTTON b-sel AUTO-GO
     1729        LABEL "Вы&бор"
     1730        SIZE 10 BY 1
     1731        BGCOLOR 8 .
     1732   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1733         VIEW-AS TEXT
     1734        SIZE 6 BY 1
     1735        FGCOLOR 4  NO-UNDO.
     1736   DEFINE VARIABLE sch-corr-date AS DATE FORMAT "99/99/9999":U
     1737        LABEL "Дате изменения"
     1738        VIEW-AS FILL-IN
     1739        SIZE 11 BY 1 NO-UNDO.
     1740   DEFINE VARIABLE sch-corr-user-name AS CHARACTER FORMAT "X(9)":U
     1741        LABEL "пользователю"
     1742        VIEW-AS FILL-IN
     1743        SIZE 12 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1744   DEFINE VARIABLE sch-grp-code AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1745        LABEL "код группы"
     1746        VIEW-AS FILL-IN
     1747        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1748   DEFINE QUERY BR-changes FOR
     1749         temp-changes SCROLLING.
     1750   DEFINE QUERY br-sum-grp-obj FOR
     1751         X_c-sum-grp-obj SCROLLING.
     1752   DEFINE BROWSE BR-changes
     1753     QUERY BR-changes DISPLAY
     1754         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(40)"
     1755   temp-changes.v_old COLUMn-LABEL "Было" format "X(70)"
     1756   temp-changes.v_new COLUMn-LABEL "Стало" format "X(70)"
     1757       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.25.
     1758   DEFINE BROWSE br-sum-grp-obj
     1759     QUERY br-sum-grp-obj NO-LOCK DISPLAY
     1760         mark-string(recid(X_c-sum-grp-obj), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1761         X_c-sum-grp-obj.grp-code COLUMN-LABEL "Код группы" FORMAT "99":U
     1762         get-subject(X_c-sum-grp-obj.subject) "Предмет изменений" FORMAT "X(15)"
     1763         X_c-sum-grp-obj.corr-date FORMAT "99/99/9999":U
     1764         string(X_c-sum-grp-obj.corr-time, "HH:MM:SS":U) COLUMN-LABEL "Время изм." FORMAT "X(8)":U
     1765         usrfulnf(X_c-sum-grp-obj.corr-user-name) FORMAT "X(18)":U
     1766         get-action(X_c-sum-grp-obj.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1767         X_c-sum-grp-obj.corr-user-db-num FORMAT ">>>>9":U
     1768         X_c-sum-grp-obj.obj-type + string(X_c-sum-grp-obj.obj-code) COLUMN-LABEL "Объект" FORMAT "X(8)":U
     1769     ENABLE
     1770         X_c-sum-grp-obj.corr-date
     1771       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.46.
     1772   DEFINE FRAME Dialog-Frame
     1773        b-quit AT ROW 1 COL 1
     1774        B-mark AT ROW 1 COL 11
     1775        b-sel AT ROW 1 COL 21
     1776        B-print AT ROW 1 COL 89
     1777        B-sch AT ROW 1 COL 92
     1778        B-Help AT ROW 1 COL 95
     1779        B-lookup AT ROW 1.04 COL 45
     1780        br-sum-grp-obj AT ROW 2 COL 1
     1781        sch-corr-date AT ROW 13.63 COL 85.75 COLON-ALIGNED
     1782        sch-grp-code AT ROW 13.67 COL 56.13 COLON-ALIGNED
     1783        sch-corr-user-name AT ROW 13.71 COL 22.5 COLON-ALIGNED
     1784        BR-changes AT ROW 14.79 COL 1
     1785        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1786        "ПОИСК ПО" VIEW-AS TEXT
     1787             SIZE 8.38 BY 1 AT ROW 13.63 COL 1.38
     1788             FGCOLOR 4
     1789        SPACE(89.48) SKIP(7.44)
     1790       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1791            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1792            TITLE "Полная история группы товаров (на кассе)"
     1793            CANCEL-BUTTON b-quit.
     1794   ASSIGN
     1795          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1796          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1797   ON GO OF FRAME Dialog-Frame
     1798   DO:
     1799     p-rid-list = v-rid-list.
     1800   END.
     1801   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1802   DO:
     1803     APPLY "END-ERROR":U TO SELF.
     1804   END.
     1805   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1806   DO:
     1807   define variable loc#log as logical no-undo .
     1808     if available X_c-sum-grp-obj then do:
     1809   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1810   define variable v-str-recid19 as character no-undo .
     1811   define variable v-num-entry19 as integer   no-undo .
     1812   assign
     1813     v-str-recid19 = trim( string( recid( X_c-sum-grp-obj ) , "->>>>>>>>>>>9":U ) )
     1814     v-num-entry19 = lookup( v-str-recid19 , v-rid-list )
     1815   .
     1816   if v-num-entry19 > 0 then do:
     1817     assign
     1818       entry( v-num-entry19, v-rid-list ) = "":U
     1819       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1820     .
     1821   end.
     1822   else do:
     1823     assign
     1824       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid19
     1825     .
     1826   end.
     1827       loc#log = br-sum-grp-obj:refresh() .
     1828       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1829           loc#log = br-sum-grp-obj:select-next-row ().
     1830           apply "VALUE-CHANGED" to br-sum-grp-obj in frame Dialog-Frame.
     1831       end.
     1832       if num-entries( v-rid-list ) = 0
     1833       then
     1834           hide mark-num in frame Dialog-Frame.
     1835       else
     1836           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1837     end.
     1838     apply "entry" to br-sum-grp-obj in frame Dialog-Frame.
     1839   END.
     1840   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1841   DO:
     1842       run proc-b-print in this-procedure no-error.
     1843     if error-status:error then return no-apply.
     1844   END.
     1845   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1846   DO:
     1847       run proc-b-sch in this-procedure no-error.
     1848     if error-status:error then return no-apply.
     1849   END.
     1850   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1851   DO:
     1852     if ( available X_c-sum-grp-obj ) then do:
     1853       if ( v-rid-list = "" ) or b-mark:sensitive = no
     1854       then
     1855       v-rid-list = string( recid( X_c-sum-grp-obj ) ) .
     1856     end.
     1857   END.
     1858   ON MOUSE-SELECT-DBLCLICK OF br-sum-grp-obj IN FRAME Dialog-Frame
     1859   DO:
     1860        run proc-br-sum-grp-obj in this-procedure no-error.
     1861     if error-status:error then return no-apply.
     1862   END.
     1863   ON RETURN OF br-sum-grp-obj IN FRAME Dialog-Frame
     1864   DO:
     1865       run proc-br-sum-grp-obj in this-procedure no-error.
     1866     if error-status:error then return no-apply.
     1867   END.
     1868   ON VALUE-CHANGED OF br-sum-grp-obj IN FRAME Dialog-Frame
     1869   DO:
     1870     run proc-view-changes in this-procedure no-error.
     1871   END.
     1872   ON CTRL-J OF sch-corr-date IN FRAME Dialog-Frame
     1873   DO:
     1874      run proc-find-corr-date in this-procedure(yes, input frame Dialog-Frame sch-corr-date) no-error.
     1875     if error-status:error then return no-apply.
     1876   END.
     1877   ON RETURN OF sch-corr-date IN FRAME Dialog-Frame
     1878   DO:
     1879     run proc-find-corr-date in this-procedure(no, input frame Dialog-Frame sch-corr-date) no-error.
     1880     if error-status:error then return no-apply.
     1881   END.
     1882   ON CTRL-J OF sch-corr-user-name IN FRAME Dialog-Frame
     1883   DO:
     1884     run proc-find-user in this-procedure(yes, input frame Dialog-Frame sch-corr-user-name) no-error.
     1885     if error-status:error then return no-apply.
     1886   END.
     1887   ON RETURN OF sch-corr-user-name IN FRAME Dialog-Frame
     1888   DO:
     1889     run proc-find-user in this-procedure(no, input frame Dialog-Frame sch-corr-user-name) no-error.
     1890     if error-status:error then return no-apply.
     1891   END.
     1892   ON CTRL-J OF sch-grp-code IN FRAME Dialog-Frame
     1893   DO:
     1894     run proc-find-grp-code in this-procedure(yes, input frame Dialog-Frame sch-grp-code) no-error.
     1895     if error-status:error then return no-apply.
     1896   END.
     1897   ON RETURN OF sch-grp-code IN FRAME Dialog-Frame
     1898   DO:
     1899     run proc-find-grp-code in this-procedure(no, input frame Dialog-Frame sch-grp-code) no-error.
     1900     if error-status:error then return no-apply.
     1901   END.
     1902   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1903   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1904   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1905   on help of frame Dialog-Frame
     1906   do:
     1907     run gbl/app_help.p
     1908       (input this-procedure :file-name
     1909       ,input ''
     1910       ,input ?
     1911       ) no-error.
     1912     if error-status :error then do:
     1913       message
     1914         "Ошибка при вызове помощи"
     1915         error-status :get-message(1)
     1916         view-as alert-box .
     1917     end.
     1918   end.
     1919   run minbtn-set in this-procedure .
     1920   on choose of b-help in frame Dialog-Frame
     1921   do:
     1922     apply "help":u to frame Dialog-Frame .
     1923   end.
     1924   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1925   procedure minbtn-set :
     1926       do
     1927           on error undo, return error return-value
     1928           :
     1929           define variable ii              as integer       no-undo .
     1930           define variable fh              as widget-handle no-undo .
     1931           define variable hh              as widget-handle no-undo .
     1932           define variable v-h             as handle        extent 4 no-undo .
     1933           define variable v-name-button   as character     no-undo .
     1934           define variable v-help-old-x    as decimal       no-undo .
     1935           define variable v-help-old-y    as decimal       no-undo .
     1936           define variable v-help-old-size as decimal       no-undo .
     1937           define variable v-frame-width   as decimal       no-undo .
     1938           define variable jj              as integer       no-undo .
     1939           do
     1940               on error undo, return error
     1941               :
     1942               assign
     1943                   v-frame-width = frame Dialog-Frame:width - 0.3
     1944                   fh            = frame Dialog-Frame:first-child
     1945                   hh            = fh:first-child
     1946                   ii            = 1
     1947                   .
     1948               do while valid-handle(hh):
     1949                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1950                   do:
     1951                       case lc(hh:name) :
     1952                           when "b-help" then
     1953                               do:
     1954                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1955                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1956                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1957                                   hh:TOOLTIP = "Помощь" .
     1958                                   v-help-old-x = hh:column .
     1959                                   v-help-old-y = hh:row    .
     1960                                   v-help-old-size = hh:width .
     1961                                   hh:width-chars = 2.5 .
     1962                               end.
     1963                           when "b-print" then
     1964                               do:
     1965                                   hh:load-image("cmp/b-print.bmp":u) .
     1966                                   hh:TOOLTIP = "Печать" .
     1967                                   v-h[ii] = hh:handle .
     1968                                   ii = ii + 1 .
     1969                                   hh:width-chars = 3 .
     1970                               end.
     1971                           when "b-history" or
     1972                           when "b-hist" then
     1973                               do:
     1974                                   hh:load-image("cmp/b-hist.bmp":u) .
     1975                                   hh:TOOLTIP = "История" .
     1976                                   v-h[ii] = hh:handle .
     1977                                   ii = ii + 1 .
     1978                                   hh:width-chars = 3 .
     1979                               end.
     1980                           when "b-sch" then
     1981                               do:
     1982                                   hh:load-image("cmp/b-sch.bmp":u) .
     1983                                   hh:TOOLTIP = "Установка Фильтра" .
     1984                                   v-h[ii] = hh:handle .
     1985                                   ii = ii + 1 .
     1986                                   hh:width-chars = 3 .
     1987                               end.
     1988                           when "b-hist-user" then
     1989                               do:
     1990                                   hh:load-image("cmp/b-hist.bmp":u) .
     1991                                   hh:TOOLTIP = "История пользователя" .
     1992                                   ii = ii + 1 .
     1993                               end.
     1994                       end case.
     1995                   end.
     1996                   hh = hh:next-sibling.
     1997               end.
     1998               b-help:column = v-frame-width - b-help:width-chars.
     1999               jj = 0.
     2000               repeat ii = 4 to 1 by -1 :
     2001                   if valid-handle (v-h[ii] ) then
     2002                   do:
     2003                       jj  = jj + 1 .
     2004                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2005                       v-h[ii]:row    = v-help-old-y .
     2006                   end.
     2007               end.
     2008           end.
     2009       end.
     2010   end procedure.
     2011   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2012   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2013   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2014   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2015   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2016   define variable v-diasize-current-frame-height as decimal   no-undo .
     2017   define variable v-diasize-change-size          as logical   no-undo .
     2018   define variable v-diasize-resize-button        as handle    no-undo .
     2019   define variable v-diasize-wndmax               as logical   no-undo .
     2020   define variable v-diasize-wndstore             as logical   no-undo .
     2021   define variable v-diasize-proc-name            as character no-undo .
     2022   define variable v-diasize-browse-handle        as handle    no-undo .
     2023   define variable v-diasize-browse-number        as integer   no-undo .
     2024   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2025   define temp-table temp-diasize-handle no-undo
     2026     field handle-value  as handle
     2027     field save-position as decimal
     2028     index xpk is primary unique handle-value
     2029     .
     2030   define temp-table temp-browse-handle no-undo
     2031     field browse-type   as character
     2032     field browse-number as integer
     2033     field browse-handle as handle
     2034     field original-size as decimal
     2035     index xpk is primary unique browse-type browse-number
     2036     index xie browse-type browse-handle
     2037   .
     2038   procedure diasize_change-height :
     2039     define input  parameter p-change-value  as decimal   no-undo .
     2040     define input  parameter p-move-resize   as logical   no-undo .
     2041     define variable v-field-group-handle    as handle    no-undo .
     2042     define variable v-object-handle         as handle    no-undo .
     2043     define variable v-frame-height          as decimal   no-undo .
     2044     define variable v-frame-virtual-height  as decimal   no-undo .
     2045     define variable v-browse-height         as decimal   no-undo .
     2046     define variable v-window-height         as decimal   no-undo .
     2047     define variable v-window-virtual-height as decimal   no-undo .
     2048     define variable v-change-sign           as integer   no-undo .
     2049     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2050     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2051     if p-change-value > 0
     2052     then do:
     2053       if frame Dialog-Frame :height + p-change-value
     2054           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2055       then do:
     2056         assign
     2057           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2058                           - (frame Dialog-Frame :height-chars)
     2059         .
     2060         if p-change-value <= 0
     2061         then do:
     2062           run diasize_position-resize-button in this-procedure .
     2063           return .
     2064         end.
     2065       end.
     2066     end.
     2067     if p-change-value < 0
     2068     then do:
     2069       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     2070       then do:
     2071         assign
     2072           p-change-value = v-diasize-orig-frame-height
     2073                          - (frame Dialog-Frame :height-chars)
     2074         .
     2075         if p-change-value >= 0
     2076         then do:
     2077           run diasize_position-resize-button in this-procedure .
     2078           return .
     2079         end.
     2080       end.
     2081     end.
     2082     if p-change-value >= 0
     2083     then do:
     2084       assign
     2085         v-change-sign = 1
     2086       .
     2087     end.
     2088     else do:
     2089       assign
     2090         v-change-sign = -1
     2091       .
     2092     end.
     2093     assign
     2094       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2095     .
     2096     if p-change-value = 0
     2097     then do:
     2098       run diasize_position-resize-button in this-procedure .
     2099       return .
     2100     end.
     2101     move_block:
     2102     do
     2103     on error undo move_block, retry move_block
     2104     :
     2105       if retry
     2106       then do:
     2107         do
     2108         on error undo move_block, leave move_block
     2109         :
     2110           if p-change-value > 0
     2111           then do:
     2112             for each buf_temp-diasize-handle
     2113             on error undo, next
     2114             :
     2115               assign
     2116                 v-object-handle = buf_temp-diasize-handle.handle-value
     2117               .
     2118               if v-object-handle <> v-diasize-resize-button
     2119               then do:
     2120                 assign
     2121                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2122                 .
     2123               end.
     2124             end.
     2125             assign
     2126               v-diasize-browse-handle :height = v-browse-height
     2127             .
     2128             for each buf_temp-browse-handle
     2129               where buf_temp-browse-handle.browse-type = 'height':u
     2130             on error undo, next
     2131             :
     2132               assign
     2133                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2134               .
     2135             end.
     2136             assign
     2137               frame Dialog-Frame :height = v-frame-height
     2138             .
     2139             if frame Dialog-Frame :scrollable = true
     2140             then do:
     2141               assign
     2142                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2143               .
     2144             end.
     2145             run diasize_position-resize-button in this-procedure .
     2146           end.
     2147           else do:
     2148             if frame Dialog-Frame :scrollable = true
     2149             then do:
     2150               assign
     2151                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     2152               .
     2153             end.
     2154             assign
     2155               frame Dialog-Frame :height = v-frame-height
     2156             .
     2157             assign
     2158               v-diasize-browse-handle :height = v-browse-height
     2159             .
     2160             for each buf_temp-browse-handle
     2161               where buf_temp-browse-handle.browse-type = 'height':u
     2162             on error undo, next
     2163             :
     2164               assign
     2165                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2166               .
     2167             end.
     2168             for each buf_temp-diasize-handle
     2169             on error undo, next
     2170             :
     2171               assign
     2172                 v-object-handle = buf_temp-diasize-handle.handle-value
     2173               .
     2174               if v-object-handle <> v-diasize-resize-button
     2175               then do:
     2176                 assign
     2177                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2178                 .
     2179               end.
     2180             end.
     2181             run diasize_position-resize-button in this-procedure .
     2182           end.
     2183           assign
     2184             v-diasize-change-size = false
     2185           .
     2186           leave move_block .
     2187         end.
     2188       end.
     2189       assign
     2190         v-diasize-need-full-display = true
     2191       .
     2192       if v-diasize-change-size = false
     2193       then do:
     2194         assign
     2195           v-diasize-change-size = true
     2196         .
     2197       end.
     2198       else do:
     2199         return .
     2200       end.
     2201       assign
     2202         v-frame-height = frame Dialog-Frame :height
     2203         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     2204         v-browse-height = v-diasize-browse-handle :height
     2205       .
     2206       for each buf_temp-browse-handle
     2207         where buf_temp-browse-handle.browse-type = 'height':u
     2208       :
     2209         assign
     2210           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2211         .
     2212       end.
     2213       for each buf_temp-diasize-handle
     2214       :
     2215         delete buf_temp-diasize-handle .
     2216       end.
     2217       assign
     2218         v-field-group-handle = frame Dialog-Frame :first-child
     2219       .
     2220       do while valid-handle(v-field-group-handle)
     2221       :
     2222         assign
     2223           v-object-handle = v-field-group-handle :first-child
     2224         .
     2225         do while valid-handle(v-object-handle)
     2226         :
     2227           if  v-object-handle <> v-diasize-browse-handle :handle
     2228           and can-query(v-object-handle, "row")
     2229           and can-query(v-object-handle, "height")
     2230           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2231           then do:
     2232             find first buf_temp-browse-handle
     2233               where buf_temp-browse-handle.browse-type   = 'height':u
     2234                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2235               no-error .
     2236             if available buf_temp-browse-handle
     2237             then do:
     2238             end.
     2239             else do:
     2240               create buf_temp-diasize-handle .
     2241               assign
     2242                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2243                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2244               .
     2245             end.
     2246           end.
     2247           assign
     2248             v-object-handle = v-object-handle :next-sibling
     2249           .
     2250         end.
     2251         assign
     2252           v-field-group-handle = v-field-group-handle :next-sibling
     2253         .
     2254       end.
     2255       do with frame Dialog-Frame
     2256       :
     2257         hide v-diasize-resize-button .
     2258         assign
     2259           v-diasize-resize-button :row    = 1
     2260           v-diasize-resize-button :column = 1
     2261         .
     2262       end.
     2263       if p-change-value > 0
     2264       then do:
     2265         if frame Dialog-Frame :scrollable = true
     2266         then do:
     2267           assign
     2268             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2269             no-error .
     2270           if error-status :error
     2271           or error-status :get-message(1) <> ""
     2272           then do:
     2273             undo move_block, retry move_block .
     2274           end.
     2275         end.
     2276         assign
     2277           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2278           no-error .
     2279         if error-status :error
     2280         or error-status :get-message(1) <> ""
     2281         then do:
     2282           undo move_block, retry move_block .
     2283         end.
     2284         assign
     2285           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2286           no-error .
     2287         if error-status :error
     2288         or error-status :get-message(1) <> ""
     2289         then do:
     2290           undo move_block, retry move_block .
     2291         end.
     2292         for each buf_temp-browse-handle
     2293           where buf_temp-browse-handle.browse-type = 'height':u
     2294         on error undo move_block, retry move_block
     2295         :
     2296           assign
     2297             buf_temp-browse-handle.browse-handle :height
     2298               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2299             no-error .
     2300           if error-status :error
     2301           or error-status :get-message(1) <> ""
     2302           then do:
     2303             undo move_block, retry move_block .
     2304           end.
     2305         end.
     2306         for each buf_temp-diasize-handle
     2307         on error undo move_block, retry move_block
     2308         :
     2309           assign
     2310             v-object-handle = buf_temp-diasize-handle.handle-value
     2311           .
     2312           if v-object-handle <> v-diasize-resize-button
     2313           then do:
     2314             assign
     2315               v-object-handle :row = v-object-handle :row + p-change-value
     2316               no-error .
     2317             if error-status :error
     2318             or error-status :get-message(1) <> ""
     2319             then do:
     2320               undo move_block, retry move_block .
     2321             end.
     2322           end.
     2323         end.
     2324       end.
     2325       else do:
     2326         for each buf_temp-diasize-handle
     2327         on error undo move_block, retry move_block
     2328         :
     2329           assign
     2330             v-object-handle = buf_temp-diasize-handle.handle-value
     2331           .
     2332           if v-object-handle <> v-diasize-resize-button
     2333           then do:
     2334             assign
     2335               v-object-handle :row = v-object-handle :row + p-change-value
     2336               no-error .
     2337             if error-status :error
     2338             or error-status :get-message(1) <> ""
     2339             then do:
     2340               undo move_block, retry move_block .
     2341             end.
     2342           end.
     2343         end.
     2344         assign
     2345           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2346           no-error .
     2347         if error-status :error
     2348         or error-status :get-message(1) <> ""
     2349         then do:
     2350           undo move_block, retry move_block .
     2351         end.
     2352         for each buf_temp-browse-handle
     2353           where buf_temp-browse-handle.browse-type = 'height':u
     2354         on error undo move_block, retry move_block
     2355         :
     2356           assign
     2357             buf_temp-browse-handle.browse-handle :height
     2358               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2359             no-error .
     2360           if error-status :error
     2361           or error-status :get-message(1) <> ""
     2362           then do:
     2363             undo move_block, retry move_block .
     2364           end.
     2365         end.
     2366         assign
     2367           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2368           no-error .
     2369         if error-status :error
     2370         or error-status :get-message(1) <> ""
     2371         then do:
     2372           undo move_block, retry move_block .
     2373         end.
     2374         if frame Dialog-Frame :scrollable = true
     2375         then do:
     2376           assign
     2377             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2378             no-error .
     2379           if error-status :error
     2380           or error-status :get-message(1) <> ""
     2381           then do:
     2382             undo move_block, retry move_block .
     2383           end.
     2384         end.
     2385       end.
     2386       if p-move-resize = true
     2387       then do:
     2388         run diasize_position-resize-button in this-procedure .
     2389       end.
     2390       if v-diasize-wndstore = true
     2391       then do:
     2392         if connected("ub") = true
     2393         then do:
     2394           define variable v-cntxt-db-num        as integer   no-undo .
     2395           define variable v-cntxt-userid        as character no-undo .
     2396           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2397                                             , OUTPUT v-cntxt-userid
     2398                                             ) .
     2399           run gbl/wndsizew.p
     2400             (input  v-cntxt-db-num
     2401             ,input  v-cntxt-userid
     2402             ,input  v-diasize-proc-name
     2403             ,input  'height':u
     2404             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2405             ) .
     2406         end.
     2407       end.
     2408     end.
     2409     assign
     2410       v-diasize-change-size = false
     2411     .
     2412   end procedure.
     2413   procedure diasize_set-height :
     2414     define input  parameter p-new-height  as decimal   no-undo .
     2415     define input  parameter p-move-resize as logical   no-undo .
     2416     do
     2417     on error undo, return error return-value
     2418     :
     2419       run diasize_change-height in this-procedure
     2420         (input  (p-new-height - frame Dialog-Frame :height)
     2421         ,input  p-move-resize
     2422         ) .
     2423     end.
     2424   end procedure.
     2425   procedure diasize_change-width :
     2426     define input  parameter p-change-value as decimal   no-undo .
     2427     define input  parameter p-move-resize  as logical   no-undo .
     2428     define variable v-field-group-handle   as handle    no-undo .
     2429     define variable v-object-handle        as handle    no-undo .
     2430     define variable v-frame-width          as decimal   no-undo .
     2431     define variable v-frame-virtual-width  as decimal   no-undo .
     2432     define variable v-browse-width         as decimal   no-undo .
     2433     define variable v-window-width         as decimal   no-undo .
     2434     define variable v-window-virtual-width as decimal   no-undo .
     2435     define variable v-change-sign          as integer   no-undo .
     2436     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2437     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2438     if p-change-value > 0
     2439     then do:
     2440       if frame Dialog-Frame :width + p-change-value >
     2441           session :width-chars
     2442       then do:
     2443         assign
     2444           p-change-value = session :width-chars - frame Dialog-Frame :width
     2445         .
     2446         if p-change-value <= 0
     2447         then do:
     2448           run diasize_position-resize-button in this-procedure .
     2449           return .
     2450         end.
     2451       end.
     2452     end.
     2453     if p-change-value < 0
     2454     then do:
     2455       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2456       then do:
     2457         assign
     2458           p-change-value = v-diasize-orig-frame-width
     2459                          - frame Dialog-Frame :width
     2460         .
     2461         if p-change-value >= 0
     2462         then do:
     2463           run diasize_position-resize-button in this-procedure .
     2464           return .
     2465         end.
     2466       end.
     2467     end.
     2468     if p-change-value >= 0
     2469     then do:
     2470       assign
     2471         v-change-sign = 1
     2472       .
     2473     end.
     2474     else do:
     2475       assign
     2476         v-change-sign = -1
     2477       .
     2478     end.
     2479     assign
     2480       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2481     .
     2482     if p-change-value = 0
     2483     then do:
     2484       run diasize_position-resize-button in this-procedure .
     2485       return .
     2486     end.
     2487     move_block:
     2488     do
     2489     on error undo move_block, leave move_block
     2490     :
     2491       if retry
     2492       then do:
     2493         do
     2494         on error undo move_block, leave move_block
     2495         :
     2496           if p-change-value > 0
     2497           then do:
     2498             for each buf_temp-diasize-handle
     2499             on error undo, next
     2500             :
     2501               assign
     2502                 v-object-handle = buf_temp-diasize-handle.handle-value
     2503               .
     2504               if v-object-handle <> v-diasize-resize-button
     2505               then do:
     2506                 assign
     2507                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2508                 .
     2509               end.
     2510             end.
     2511             assign
     2512               v-diasize-browse-handle :width = v-browse-width
     2513             .
     2514             for each buf_temp-browse-handle
     2515               where buf_temp-browse-handle.browse-type = 'width':u
     2516             on error undo, next
     2517             :
     2518               assign
     2519                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2520               .
     2521             end.
     2522             assign
     2523               frame Dialog-Frame :width = v-frame-width
     2524             .
     2525             if frame Dialog-Frame :scrollable = true
     2526             then do:
     2527               assign
     2528                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2529               .
     2530             end.
     2531             run diasize_position-resize-button in this-procedure .
     2532           end.
     2533           else do:
     2534             if frame Dialog-Frame :scrollable = true
     2535             then do:
     2536               assign
     2537                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2538               .
     2539             end.
     2540             assign
     2541               frame Dialog-Frame :width = v-frame-width
     2542             .
     2543             for each buf_temp-browse-handle
     2544               where buf_temp-browse-handle.browse-type = 'width':u
     2545             on error undo, next
     2546             :
     2547               assign
     2548                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2549               .
     2550             end.
     2551             assign
     2552               v-diasize-browse-handle :width = v-browse-width
     2553             .
     2554             for each buf_temp-diasize-handle
     2555             on error undo, next
     2556             :
     2557               assign
     2558                 v-object-handle = buf_temp-diasize-handle.handle-value
     2559               .
     2560               if v-object-handle <> v-diasize-resize-button
     2561               then do:
     2562                 assign
     2563                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2564                 .
     2565               end.
     2566             end.
     2567             run diasize_position-resize-button in this-procedure .
     2568           end.
     2569           assign
     2570             v-diasize-change-size = false
     2571           .
     2572           leave move_block .
     2573         end.
     2574       end.
     2575       assign
     2576         v-diasize-need-full-display = true
     2577       .
     2578       if v-diasize-change-size = false
     2579       then do:
     2580         assign
     2581           v-diasize-change-size = true
     2582         .
     2583       end.
     2584       else do:
     2585         return .
     2586       end.
     2587       assign
     2588         v-frame-width = frame Dialog-Frame :width
     2589         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2590         v-browse-width = v-diasize-browse-handle :width
     2591       .
     2592       for each buf_temp-browse-handle
     2593         where buf_temp-browse-handle.browse-type = 'width':u
     2594       :
     2595         assign
     2596           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2597         .
     2598       end.
     2599       for each buf_temp-diasize-handle
     2600       :
     2601         delete buf_temp-diasize-handle .
     2602       end.
     2603       assign
     2604         v-field-group-handle = frame Dialog-Frame :first-child
     2605       .
     2606       do while valid-handle(v-field-group-handle)
     2607       :
     2608         assign
     2609           v-object-handle = v-field-group-handle :first-child
     2610         .
     2611         do while valid-handle(v-object-handle)
     2612         :
     2613           if  v-object-handle <> v-diasize-browse-handle :handle
     2614           and v-object-handle <> v-diasize-resize-button
     2615           and can-query(v-object-handle, "row")
     2616           and can-query(v-object-handle, "height")
     2617           and ( v-object-handle :col + v-object-handle :width
     2618                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2619               )
     2620           then do:
     2621             find first buf_temp-browse-handle
     2622               where buf_temp-browse-handle.browse-type   = 'width':u
     2623                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2624               no-error .
     2625             if available buf_temp-browse-handle
     2626             then do:
     2627             end.
     2628             else do:
     2629               create buf_temp-diasize-handle .
     2630               assign
     2631                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2632                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2633               .
     2634             end.
     2635           end.
     2636           assign
     2637             v-object-handle = v-object-handle :next-sibling
     2638           .
     2639         end.
     2640         assign
     2641           v-field-group-handle = v-field-group-handle :next-sibling
     2642         .
     2643       end.
     2644       do with frame Dialog-Frame
     2645       :
     2646         hide v-diasize-resize-button .
     2647         v-diasize-resize-button :row = 1.
     2648         v-diasize-resize-button :column = 1.
     2649       end.
     2650       if p-change-value > 0
     2651       then do:
     2652         if frame Dialog-Frame :scrollable = true
     2653         then do:
     2654           assign
     2655             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2656             no-error .
     2657           if error-status :error
     2658           or error-status :get-message(1) <> ""
     2659           then do:
     2660             undo move_block, retry move_block.
     2661           end.
     2662         end.
     2663         assign
     2664           frame Dialog-Frame :width = v-frame-width + p-change-value
     2665           no-error .
     2666         if error-status :error
     2667         or error-status :get-message(1) <> ""
     2668         then do:
     2669           undo move_block, retry move_block.
     2670         end.
     2671         assign
     2672           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2673         no-error .
     2674         if error-status :error
     2675         or error-status :get-message(1) <> ""
     2676         then do:
     2677           undo move_block, retry move_block.
     2678         end.
     2679         for each buf_temp-browse-handle
     2680           where buf_temp-browse-handle.browse-type = 'width':u
     2681         on error undo move_block, retry move_block
     2682         :
     2683           assign
     2684             buf_temp-browse-handle.browse-handle :width
     2685               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2686             no-error .
     2687           if error-status :error
     2688           or error-status :get-message(1) <> ""
     2689           then do:
     2690             undo move_block, retry move_block .
     2691           end.
     2692         end.
     2693         for each buf_temp-diasize-handle
     2694         on error undo move_block, retry move_block
     2695         :
     2696           assign
     2697             v-object-handle = buf_temp-diasize-handle.handle-value
     2698           .
     2699           if v-object-handle <> v-diasize-resize-button
     2700           then do:
     2701             assign
     2702               v-object-handle :col = v-object-handle :col + p-change-value
     2703               no-error .
     2704             if error-status :error
     2705             or error-status :get-message(1) <> ""
     2706             then do:
     2707               undo move_block, retry move_block .
     2708             end.
     2709           end.
     2710         end.
     2711       end.
     2712       else do:
     2713         for each buf_temp-diasize-handle
     2714         on error undo move_block, retry move_block
     2715         :
     2716           assign
     2717             v-object-handle = buf_temp-diasize-handle.handle-value
     2718           .
     2719           if v-object-handle <> v-diasize-resize-button
     2720           then do:
     2721             assign
     2722               v-object-handle :col = v-object-handle :col + p-change-value
     2723               no-error .
     2724             if error-status :error
     2725             or error-status :get-message(1) <> ""
     2726             then do:
     2727               undo move_block, retry move_block .
     2728             end.
     2729           end.
     2730         end.
     2731         for each buf_temp-browse-handle
     2732           where buf_temp-browse-handle.browse-type = 'width':u
     2733         on error undo move_block, retry move_block
     2734         :
     2735           assign
     2736             buf_temp-browse-handle.browse-handle :width
     2737               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2738             no-error .
     2739           if error-status :error
     2740           or error-status :get-message(1) <> ""
     2741           then do:
     2742             undo move_block, retry move_block .
     2743           end.
     2744         end.
     2745         assign
     2746           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2747           no-error .
     2748         if error-status :error
     2749         or error-status :get-message(1) <> ""
     2750         then do:
     2751           undo move_block, retry move_block.
     2752         end.
     2753         assign
     2754           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2755         no-error .
     2756         if error-status :error
     2757         or error-status :get-message(1) <> ""
     2758         then do:
     2759           undo move_block, retry move_block.
     2760         end.
     2761         if frame Dialog-Frame :scrollable = true
     2762         then do:
     2763           assign
     2764             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2765           no-error .
     2766           if error-status :error
     2767           or error-status :get-message(1) <> ""
     2768           then do:
     2769             undo move_block, retry move_block.
     2770           end.
     2771         end.
     2772       end.
     2773       if p-move-resize
     2774       then do:
     2775         run diasize_position-resize-button in this-procedure .
     2776       end.
     2777       if v-diasize-wndstore = true
     2778       then do:
     2779         if connected("ub") = true
     2780         then do:
     2781           define variable v-cntxt-db-num        as integer   no-undo .
     2782           define variable v-cntxt-userid        as character no-undo .
     2783           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2784                                             , OUTPUT v-cntxt-userid
     2785                                             ) .
     2786           run gbl/wndsizew.p
     2787             (input  v-cntxt-db-num
     2788             ,input  v-cntxt-userid
     2789             ,input  v-diasize-proc-name
     2790             ,input  'width':u
     2791             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2792             ) .
     2793         end.
     2794       end.
     2795     end.
     2796     assign
     2797       v-diasize-change-size = false
     2798     .
     2799   end procedure.
     2800   procedure diasize_set-width :
     2801     define input  parameter p-new-width  as decimal   no-undo .
     2802     define input  parameter p-move-resize as logical   no-undo .
     2803     do
     2804     on error undo, return error return-value
     2805     :
     2806       run diasize_change-width in this-procedure
     2807         (input  (p-new-width - frame Dialog-Frame :width)
     2808         ,input  p-move-resize
     2809         ) .
     2810     end.
     2811   end procedure.
     2812   procedure diasize_position-resize-button :
     2813     do with frame Dialog-Frame
     2814     :
     2815       hide v-diasize-resize-button .
     2816       assign
     2817         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2818                     - 1
     2819                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2820         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2821                     - 1
     2822                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2823       .
     2824       view v-diasize-resize-button .
     2825     end.
     2826   end procedure.
     2827   on alt-right anywhere
     2828   do:
     2829     run diasize_change-width in this-procedure
     2830       (input 1
     2831       ,input true
     2832       ) .
     2833     return no-apply .
     2834   end.
     2835   on alt-left anywhere
     2836   do:
     2837     run diasize_change-width in this-procedure
     2838       (input -1
     2839       ,input true
     2840       ) .
     2841     return no-apply .
     2842   end.
     2843   on alt-down anywhere
     2844   do:
     2845     run diasize_change-height in this-procedure
     2846       (input 1
     2847       ,input true
     2848       ) .
     2849     return no-apply .
     2850   end.
     2851   on alt-up anywhere
     2852   do:
     2853     run diasize_change-height in this-procedure
     2854       (input -1
     2855       ,input true
     2856       ) .
     2857     return no-apply .
     2858   end.
     2859   on alt-enter of frame Dialog-Frame
     2860   do:
     2861     run diasize_maximize in this-procedure
     2862       (input  ?
     2863       ).
     2864     return no-apply .
     2865   end.
     2866   procedure diasize_end-move :
     2867     do
     2868     on error undo, return error return-value
     2869     :
     2870       define variable v-row-delta as decimal   no-undo .
     2871       define variable v-col-delta as decimal   no-undo .
     2872       define variable v-new-row as decimal   no-undo .
     2873       define variable v-new-col as decimal   no-undo .
     2874       assign
     2875         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2876         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2877       .
     2878       assign
     2879         v-row-delta = v-new-row - frame Dialog-Frame :height
     2880         v-col-delta = v-new-col - frame Dialog-Frame :width
     2881       .
     2882       run diasize_change-height in this-procedure
     2883         (input v-row-delta
     2884         ,input true
     2885         ) .
     2886       run diasize_change-width in this-procedure
     2887         (input v-col-delta
     2888         ,input true
     2889         ) .
     2890     end.
     2891   end procedure.
     2892   procedure diasize_maximize :
     2893     define input  parameter p-action as logical   no-undo .
     2894     do
     2895     on error undo, return error return-value
     2896     :
     2897       if p-action = ?
     2898       then do:
     2899         if v-diasize-need-maximize = true
     2900         then do:
     2901           assign
     2902             p-action = true
     2903           .
     2904         end.
     2905         else do:
     2906           assign
     2907             p-action = false
     2908           .
     2909         end.
     2910       end.
     2911       if p-action = true
     2912       then do:
     2913         run diasize_change-height in this-procedure
     2914           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2915               - frame Dialog-Frame :height-chars
     2916           ,input true
     2917           ) .
     2918         run diasize_change-width in this-procedure
     2919           (input session :width-chars
     2920               - frame Dialog-Frame :width-chars
     2921           ,input true
     2922           ) .
     2923         assign
     2924           v-diasize-need-maximize = false
     2925         .
     2926       end.
     2927       else do:
     2928         run diasize_change-width in this-procedure
     2929           (input v-diasize-orig-frame-width
     2930               - frame Dialog-Frame :width-chars
     2931           ,input true
     2932           ) .
     2933         run diasize_change-height in this-procedure
     2934           (input v-diasize-orig-frame-height
     2935               - frame Dialog-Frame :height-chars
     2936           ,input true
     2937           ) .
     2938         assign
     2939           v-diasize-need-maximize = true
     2940         .
     2941       end.
     2942     end.
     2943   end procedure.
     2944   procedure diasize_restore-orig-size :
     2945     do
     2946     on error undo, return error return-value
     2947     :
     2948       assign
     2949         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2950         v-diasize-current-frame-height = frame Dialog-Frame :height
     2951       .
     2952       run diasize_set-height in this-procedure
     2953         (input  v-diasize-orig-frame-height
     2954         ,input  true
     2955         ) .
     2956       run diasize_set-width in this-procedure
     2957         (input  v-diasize-orig-frame-width
     2958         ,input  true
     2959         ) .
     2960     end.
     2961   end procedure.
     2962   procedure diasize_restore-current-size :
     2963     do
     2964     on error undo, return error return-value
     2965     :
     2966       run diasize_set-height in this-procedure
     2967         (input  v-diasize-current-frame-height
     2968         ,input  true
     2969         ) .
     2970       run diasize_set-width in this-procedure
     2971         (input  v-diasize-current-frame-width
     2972         ,input  true
     2973         ) .
     2974     end.
     2975   end procedure.
     2976   procedure diasize_set-browse-handle :
     2977     define input  parameter p-browse-handle as handle   no-undo .
     2978     define buffer buf_temp-browse-handle for temp-browse-handle .
     2979     do
     2980     on error undo, return error return-value
     2981     :
     2982       assign
     2983         v-diasize-browse-handle = p-browse-handle
     2984       .
     2985       for each buf_temp-browse-handle
     2986       on error undo, return error return-value
     2987       :
     2988         delete buf_temp-browse-handle .
     2989       end.
     2990     end.
     2991   end procedure.
     2992   procedure diasize_add_browse :
     2993     define input  parameter p-browse-type   as character no-undo .
     2994     define input  parameter p-browse-handle as handle    no-undo .
     2995     define buffer buf_temp-browse-handle for temp-browse-handle .
     2996     do
     2997     on error undo, return error return-value
     2998     :
     2999       assign
     3000         v-diasize-browse-number = v-diasize-browse-number + 1
     3001       .
     3002       create buf_temp-browse-handle .
     3003       assign
     3004         buf_temp-browse-handle.browse-type   = p-browse-type
     3005         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3006         buf_temp-browse-handle.browse-handle = p-browse-handle
     3007       .
     3008     end.
     3009   end procedure.
     3010   procedure diasize_init :
     3011     define variable v-default-value    as logical   no-undo .
     3012     define variable v-restore-saved    as logical   no-undo .
     3013     define variable v-resize-value-str as character no-undo .
     3014     do
     3015     on error undo, return error return-value
     3016     :
     3017       do with frame Dialog-Frame
     3018       :
     3019         assign
     3020           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3021           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3022           v-diasize-browse-handle     = browse br-sum-grp-obj :handle
     3023         .
     3024         create button v-diasize-resize-button
     3025         assign
     3026           parent        = frame Dialog-Frame :first-child
     3027           label         = "s"
     3028           height-pixels = 16
     3029           width-pixels  = 16
     3030           visible       = true
     3031           sensitive     = true
     3032           movable       = true
     3033           triggers:
     3034             on end-move persistent run diasize_end-move in this-procedure .
     3035           end triggers.
     3036         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3037         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3038         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3039         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3040         assign
     3041           v-diasize-wndmax = false
     3042         .
     3043         if connected("ub") = true
     3044         then do:
     3045           define variable v-cntxt-db-num        as integer   no-undo .
     3046           define variable v-cntxt-userid        as character no-undo .
     3047           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3048                                             , OUTPUT v-cntxt-userid
     3049                                             ) .
     3050           run gbl/wndpar_r.p
     3051             (input  v-cntxt-db-num
     3052             ,input  v-cntxt-userid
     3053             ,input  'wndmax':U
     3054             ,output v-diasize-wndmax
     3055             ,output v-default-value
     3056             ) .
     3057         end.
     3058         assign
     3059           v-diasize-wndstore = false
     3060         .
     3061         if connected("ub") = true
     3062         then do:
     3063           run gbl/wndpar_r.p
     3064             (input  v-cntxt-db-num
     3065             ,input  v-cntxt-userid
     3066             ,input  'wndstore':U
     3067             ,output v-diasize-wndstore
     3068             ,output v-default-value
     3069             ) .
     3070         end.
     3071         assign
     3072           v-diasize-proc-name = entry(1, program-name(2), '.')
     3073         .
     3074         if v-diasize-wndstore = true
     3075         then do:
     3076           assign
     3077             v-restore-saved = false
     3078           .
     3079           if connected("ub") = true
     3080           then do:
     3081             run gbl/wndsizer.p
     3082               (input  v-cntxt-db-num
     3083               ,input  v-cntxt-userid
     3084               ,input  v-diasize-proc-name
     3085               ,input  'height':u
     3086               ,output v-resize-value-str
     3087               ) .
     3088             if v-resize-value-str <> '':U
     3089             then do:
     3090               run diasize_change-height in this-procedure
     3091                 (input  integer(v-resize-value-str)
     3092                 ,input  true
     3093                 ) .
     3094               assign
     3095                 v-restore-saved = true
     3096               .
     3097             end.
     3098           end.
     3099           if connected("ub") = true
     3100           then do:
     3101             run gbl/wndsizer.p
     3102               (input  v-cntxt-db-num
     3103               ,input  v-cntxt-userid
     3104               ,input  v-diasize-proc-name
     3105               ,input  'width':u
     3106               ,output v-resize-value-str
     3107               ) .
     3108             if v-resize-value-str <> '':U
     3109             then do:
     3110               run diasize_change-width in this-procedure
     3111                 (input  integer(v-resize-value-str)
     3112                 ,input  true
     3113                 ) .
     3114               assign
     3115                 v-restore-saved = true
     3116               .
     3117             end.
     3118           end.
     3119           if v-restore-saved <> true
     3120           then do:
     3121             if v-diasize-wndmax = true
     3122             then do:
     3123               run diasize_maximize in this-procedure
     3124                 (input  true
     3125                 ) .
     3126             end.
     3127           end.
     3128         end.
     3129         else do:
     3130           if v-diasize-wndmax = true
     3131           then do:
     3132             run diasize_maximize in this-procedure
     3133               (input  true
     3134               ) .
     3135           end.
     3136         end.
     3137       end.
     3138     end.
     3139   end procedure.
     3140   procedure diasize_need-full-display :
     3141     define output parameter p-need-full-display as logical   no-undo .
     3142     do
     3143     on error undo, return error return-value
     3144     :
