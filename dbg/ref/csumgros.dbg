     3153   procedure get-context :
     3154      define output parameter p-db-num as integer          no-undo.
     3155      define output parameter p-user-id as character        no-undo.
     3156      define variable v-login               as character    no-undo.
     3157      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3158      define buffer buf_user-login  for ub.user-login .
     3159      do
     3160      on error undo, return error
     3161      :
     3162            FIND FIRST buf_sys-ctrl no-lock.
     3163            ASSIGN
     3164               v-login = USERID("ub")
     3165               p-db-num = buf_sys-ctrl.db-num
     3166            .
     3167            FIND FIRST buf_user-login
     3168                 WHERE buf_user-login.db-num = p-db-num
     3169                   AND buf_user-login.user-login = v-login
     3170                 no-lock
     3171                 no-error
     3172                 .
     3173            IF AVAILABLE buf_user-login
     3174            THEN DO:
     3175               assign
     3176                  p-user-id = buf_user-login.user-id
     3177               .
     3178            END.
     3179      end.
     3180   end procedure.
