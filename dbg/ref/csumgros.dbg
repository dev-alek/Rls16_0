     3680   RUN disable_UI.
     3681   PROCEDURE disable_UI :
     3682     HIDE FRAME Dialog-Frame.
     3683   END PROCEDURE.
     3684   PROCEDURE enable_UI :
     3685     DISPLAY sch-corr-date sch-grp-code sch-corr-user-name mark-num
     3686         WITH FRAME Dialog-Frame.
     3687     ENABLE b-quit B-mark b-sel B-print B-sch B-Help B-lookup br-sum-grp-obj
     3688            sch-corr-date sch-grp-code sch-corr-user-name BR-changes mark-num
     3689         WITH FRAME Dialog-Frame.
     3690     VIEW FRAME Dialog-Frame.
     3691   END PROCEDURE.
     3692   PROCEDURE MyEnable :
     3693   assign
     3694     br-sum-grp-obj:num-locked-columns in frame Dialog-Frame = 1
     3695     X_c-sum-grp-obj.corr-date:read-only in browse br-sum-grp-obj = yes
     3696     br-changes:title = "":U
     3697     temp-changes.l_name:resizable in browse br-changes = true
     3698     temp-changes.v_old:resizable in browse br-changes = true
     3699     temp-changes.v_new:resizable in browse br-changes = true
     3700     temp-changes.l_name:width in browse br-changes = 30
     3701     temp-changes.v_old:width in browse br-changes = 40
     3702     temp-changes.v_new:width in browse br-changes = 40
     3703     .
     3704     VIEW frame Dialog-Frame .
     3705     DISPLAY
     3706     sch-corr-date
     3707     sch-grp-code
     3708     sch-corr-user-name
     3709     mark-num
     3710     WITH FRAME Dialog-Frame .
     3711     ENABLE
     3712     b-quit
     3713     B-mark when lookup("b-mark":U, bttns) > 0
     3714     b-sel when lookup("b-sel":U, bttns) > 0
     3715     B-lookup
     3716     B-sch
     3717     B-Print
     3718     B-Help
     3719     br-sum-grp-obj
     3720     sch-corr-date
     3721     sch-grp-code when p-mode = 'все':U
     3722     sch-corr-user-name
     3723     BR-changes mark-num
     3724     WITH FRAME Dialog-Frame .
     3725     VIEW FRAME Dialog-Frame .
     3726     hide b-lookup sch-corr-user-name
     3727     in frame Dialog-Frame .
     3728   END PROCEDURE.
     3729   PROCEDURE OpenBr :
     3730   define input  parameter p-open-query     as logical   no-undo .
     3731   define input  parameter p-find-next      as logical   no-undo .
     3732   define input  parameter p-find-condition as character no-undo .
     3733   define variable l-query-was-opened as logical no-undo .
     3734   define variable v-title as character no-undo .
     3735   define variable title0 as character no-undo.
     3736   title0 = "История групп товаров на кассах объекта" + chr(32).
     3737   run waitfram-show in this-procedure ( input "Ждите...").
     3738   define variable sort-column-phrase as character no-undo .
     3739   case sort-column-name :
     3740     when "" then do:
     3741       assign
     3742         sort-column-phrase = ""
     3743       .
     3744     end.
     3745     otherwise do:
     3746       assign
     3747         sort-column-phrase = "by " + sort-column-name
     3748       .
     3749     end.
     3750   end case.
     3751   define variable l-open-query as logical   no-undo .
     3752   CASE p-mode :
     3753     WHEN 'все':U        THEN DO:
     3754       assign
     3755       filter-point = filter-point0 + p-mode
     3756       filter-label = substitute("&1", filter-labe0)
     3757       .
     3758   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3759   define variable  l-disable-where-32  as logical   no-undo .
