     4293             then  substitute('X_c-sum-grp-obj.obj-type = &1&2&1 and X_c-sum-grp-obj.obj-code = &3 AND X_c-sum-grp-obj.grp-code  = &4 '                             , chr(34), p-obj-type, p-obj-code,  p-grp-code) + " " + where-phrase-36
     4294             else "true"
     4295           )
     4296         parameter-5-36 = (" " + "" + " " + "" + " " + p-find-condition)
     4297         parameter-6-36 = if sort-phrase-36 = ''
     4298                              then
     4299           (
     4300           " " + "  " +
     4301             " " + sort-column-phrase +
