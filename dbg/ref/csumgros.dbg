      858   procedure discfgru-check :
      859   define input parameter p-table-name as character no-undo .
      860   define input parameter p-templ-rl-root as integer no-undo .
      861   define input parameter p-time-templ-rl-root as integer no-undo .
      862   define input parameter p-pos-type as character no-undo .
      863   define output parameter p-disnct-role as character no-undo .
      864   define buffer buf_dis-cfg-rule for ub.dis-cfg-rule.
      865     do
      866     on error undo, return error return-value
      867     :
      868       find first buf_dis-cfg-rule no-lock where
      869               buf_dis-cfg-rule.table-name = p-table-name
      870           and buf_dis-cfg-rule.templ-rl-root = p-templ-rl-root
      871           and (p-time-templ-rl-root = ? or  buf_dis-cfg-rule.time-templ-rl-root = p-time-templ-rl-root)
      872           and buf_dis-cfg-rule.pos-type = p-pos-type no-error.
      873       if not available buf_dis-cfg-rule
      874       or p-pos-type = "":U
      875       then do:
      876          return error substitute("Для места использования типа &1 не определен тип скидки с шаблоном &2 &3"
      877                                  ,entry (lookup (p-pos-type, 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,r-keeper,InfoKiosk,pricecheck-Servis+,Emulator-NKT-IBM,MARIA,-,bo,Autotank':U), 'IBM,IBM-XML,IPC-Servis+,OMRON-NEW,OMRON,NCR-GM,MAGIA-XML,NCR-AS@R,IBS-TH,IBS-TH-MOB,R-KEEPER,InfoKiosk,Прайс-чекер Servis+,Emulator-NKT-IBM,MARIA,Накладная,Бэкофис,Autotank':U)
      878                                  , p-templ-rl-root
      879                                  , (if p-time-templ-rl-root = ?
      880                                     then '':U
      881                                     else substitute("с расписанием типа &1", p-time-templ-rl-root)
      882                                     )
      883                                  ).
      884       end.
      885       assign
      886       p-disnct-role = buf_dis-cfg-rule.discnt-role
      887       .
      888     end.
      889   end procedure.
