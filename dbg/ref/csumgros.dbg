     4450   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     4451   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4452   run fltfield-add in this-procedure('action', 'Действие', 'hist-action',
     4453   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4454   Filter-Block:
     4455   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4456       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4457       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4458     run gbl/filter.w ( INPUT parparentproc
     4459                       ,INPUT (filter-point + chr(4) + filter-label + chr(4) + 'yes':U)
     4460                       ,INPUT tbl
     4461                       ,INPUT join-tbl
     4462                       ,INPUT fld
     4463                       ,INPUT lab
     4464                       ,INPUT spr
     4465                       ,INPUT dim ).
     4466     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     4467   END.
     4468   END PROCEDURE.
     4469   PROCEDURE proc-br-sum-grp-obj :
     4470   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4471   if b-sel:sensitive in frame Dialog-Frame then dO:
     4472       if b-mark:sensitive then do:
     4473           apply "choose" to b-mark in frame Dialog-Frame.
     4474       end.
     4475       else do:
     4476           apply "choose" to b-sel in frame Dialog-Frame.
     4477       end.
     4478   end.
     4479   else do:
     4480       if b-lookup:sensitive then
     4481       apply "choose" to b-lookup in frame Dialog-Frame.
     4482   end.
     4483   END PROCEDURE.
     4484   PROCEDURE proc-find-corr-date :
     4485   define input parameter p-next as logical no-undo.
     4486   define input parameter p-date like ub.fin-doc.doc-date no-undo.
     4487   define variable v-date-chr as character no-undo.
