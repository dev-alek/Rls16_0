        1   block-level on error undo, throw.
        2   define input parameter p-mode            as character no-undo .
        3   define input parameter p-gds-code        like ub.gds-obj-attr.gds-code no-undo .
        4   define input parameter p-obj-type        like ub.gds-obj-attr.obj-type no-undo .
