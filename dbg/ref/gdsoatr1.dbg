      406         ,input p-obj-code
      407         ,output p-gds-code
      408         ,output p-dt-code
      409         ) no-error .
      410       if error-status :error
      411       then do:
      412         undo, return error return-value .
      413       end.
      414     end.
      415   end.
      416   define variable v-deleted as logical no-undo .
      417   define variable v-err-mess as character no-undo .
      418   define buffer buf_gds-obj-attr for ub.gds-obj-attr.
      419   define buffer buf_goods for ub.goods.
      420   _main:
      421   do
      422   on error undo, return error return-value
      423   :
      424     find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
      425     if not available buf_goods then do:
      426       undo, return error substitute("&1 &2 &3&4Не найден товар с кодом &5"
      427                                    , vss-workfile
      428                                    , vss-revision
      429                                    , vss-description
      430                                    , chr(10)
      431                                    , p-gds-code).
      432     end.
      433     FOR EACH tt0-gds-obj-attr where
      434              tt0-gds-obj-attr.obj-type = p-obj-type
      435          AND tt0-gds-obj-attr.obj-code = p-obj-code
      436     on error undo, return error return-value
      437          :
      438       if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
      439         find FIRST buf_gds-obj-attr WHERE buf_gds-obj-attr.gds-code = p-gds-code
      440         AND buf_gds-obj-attr.obj-type = tt0-gds-obj-attr.obj-type
      441         AND buf_gds-obj-attr.obj-code = tt0-gds-obj-attr.obj-code
      442         AND buf_gds-obj-attr.attr-code = tt0-gds-obj-attr.attr-code no-error.
      443       end.
      444       IF p-mode = 'ДОБАВЛЕНИЕ':U
      445       or not available buf_gds-obj-attr
      446       or buf_gds-obj-attr.attr-value <> tt0-gds-obj-attr.attr-value THEN DO:
      447         run gdsoattr-write IN THIS-PROCEDURE(
      448                                              input p-gds-code
      449                                             ,INPUT tt0-gds-obj-attr.obj-type
      450                                             ,INPUT tt0-gds-obj-attr.obj-code
      451                                             ,INPUT tt0-gds-obj-attr.attr-code
      452                                             ,INPUT tt0-gds-obj-attr.attr-value) NO-ERROR.
      453         IF ERROR-STATUS:ERROR THEN DO:
      454           assign
      455           v-err-mess = substitute("Ошибка при сохранении атрибута товара на объекте &1 &2 &3 :&4&5 &6"
      456                                   , p-gds-code
      457                                   , (tt0-gds-obj-attr.obj-type + string(tt0-gds-obj-attr.obj-code))
      458                                   , tt0-gds-obj-attr.attr-code
      459                                   , chr(10)
      460                                   ,error-status:get-message(1)
      461                                   ,return-value).
      462           undo _main, return error v-err-mess.
      463         END.
      464       END.
      465     END.
      466     if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
      467       FOR EACH buf_gds-obj-attr where buf_gds-obj-attr.gds-code = p-gds-code
      468       on error undo, return error return-value
      469       :
      470         if buf_gds-obj-attr.obj-type <> p-obj-type
      471         or buf_gds-obj-attr.obj-code <> p-obj-code  then next.
      472         if buf_gds-obj-attr.attr-code = 'lock':U then next.
      473           FIND FIRST tt0-gds-obj-attr NO-LOCK WHERE
      474               tt0-gds-obj-attr.gds-code = p-gds-code
      475           AND tt0-gds-obj-attr.obj-type = buf_gds-obj-attr.obj-type
      476           AND tt0-gds-obj-attr.obj-code = buf_gds-obj-attr.obj-code
      477           AND tt0-gds-obj-attr.attr-code = buf_gds-obj-attr.attr-code NO-ERROR.
      478         IF NOT AVAILABLE tt0-gds-obj-attr THEN DO:
      479             ASSIGN
      480             v-deleted = NO.
      481             RUN gdsoattr-delete IN THIS-PROCEDURE (
      482                                                   input buf_gds-obj-attr.gds-code
      483                                                   ,input buf_gds-obj-attr.obj-type
      484                                                   ,INPUT buf_gds-obj-attr.obj-code
      485                                                   ,INPUT buf_gds-obj-attr.attr-code
      486                                                   ,output v-deleted ) NO-ERROR.
      487           IF NOT v-deleted
      488           or error-status:error
      489           THEN DO:
      490             assign
      491             v-err-mess = substitute("Ошибка при удалении атрибута товара на объекте &1 &2 &3 :&4&5 &6"
      492                                     , p-gds-code
      493                                     , (buf_gds-obj-attr.obj-type + string(buf_gds-obj-attr.obj-code))
      494                                     , buf_gds-obj-attr.attr-code
      495                                     , chr(10)
      496                                     ,error-status:get-message(1)
      497                                     ,return-value
      498                                     ).
      499             undo _main, return error v-err-mess.
      500           END.
      501         END.
      502       END.
      503     end.
      504   end.
