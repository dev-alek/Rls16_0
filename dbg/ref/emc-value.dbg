     1437   procedure diasize_set-height :
     1438     define input  parameter p-new-height  as decimal   no-undo .
     1439     define input  parameter p-move-resize as logical   no-undo .
     1440     do
     1441     on error undo, return error return-value
     1442     :
     1443       run diasize_change-height in this-procedure
     1444         (input  (p-new-height - frame f-okei3 :height)
     1445         ,input  p-move-resize
     1446         ) .
     1447     end.
     1448   end procedure.
     1449   procedure diasize_change-width :
     1450     define input  parameter p-change-value as decimal   no-undo .
     1451     define input  parameter p-move-resize  as logical   no-undo .
     1452     define variable v-field-group-handle   as handle    no-undo .
