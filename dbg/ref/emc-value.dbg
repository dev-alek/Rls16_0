      570   if session:batch-mode
      571   then
      572      mBatchMode = yes.
      573   if mBatchMode = ? then do:
      574     mVisCUrentVin = current-window:visible.
      575     mFameOldVis = mFramBachModHandle:visible.
      576     mFramBachModHandle:visible  = yes.
      577     mBatchMode = mFramBachModHandle:visible ne yes.
      578     mFramBachModHandle:visible = mFameOldVis.
      579     current-window:visible = mVisCUrentVin.
      580   end.
      581    if  log-manager:logfile-name ne ?
      582     then DO:
      583         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      584         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      585         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      586     end.
      587   on choose of B-WaitFramStop in frame waitfram
      588   do:
      589     mWaitFramStop = yes.
      590     mWaitFramStopUser = yes.
      591   end.
      592   function waitfram-check-timeout returns logical():
      593      define variable vtime as int64 no-undo.
      594      if mWaitFramStopTimeOut
      595      then
      596         return yes.
      597      vtime = ( now - mWaitFramStartProc ) / 1000 .
      598      if     mWaitFramTimeOut ne ?
      599         and mWaitFramTimeOut ne 0
      600         and mWaitFramTimeOut lt vtime
      601      then do:
      602         mWaitFramStopTimeOut = yes.
      603      end.
      604      return mWaitFramStopTimeOut.
      605   end.
      606   procedure waitfram-hide :
      607     if not session:batch-mode
      608     then do
      609     on error undo, return error return-value
      610     :
      611       pause 0 before-hide .
      612       if not mBatchMode then
      613         hide frame waitfram .
      614     if     not mWaitFramView
      615        and mWaitProcEvent
      616     then
      617       process events .
      618     end.
      619   end procedure.
      620   procedure waitfram-show :
      621     define input  parameter p-message as character no-undo .
      622     define variable v-left-margin as integer   no-undo .
      623     if not session:batch-mode
      624     then do
      625     on error undo, return error return-value
      626     :
      627       if length(p-message) <= 70 then do:
      628         assign
      629           v-left-margin = integer((70 - length(p-message)) / 2)
      630         .
      631         assign
      632           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      633         .
      634         assign
      635           v-waitfram-action01 = " "
      636           v-waitfram-action02 = " "
      637                                    + fill(" ", v-left-margin)
      638                                    + p-message
      639           v-waitfram-action03 = " "
      640         .
      641       end.
      642       else do:
      643         define variable vRindex1 as integer no-undo.
      644         define variable vRindex2 as integer no-undo.
      645         vRindex1 = r-index(p-message," ",70).
      646         if vRindex1 = 0
      647         then
      648            vRindex1 = 70.
      649         if length(p-message)  <= vRindex1 + 70 then do:
      650           assign
      651             v-waitfram-action01 = " "
      652             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      653             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      654           .
      655         end.
      656         else do:
      657           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      658           if vRindex2 <= vRindex1
      659           then
      660              vRindex2 = vRindex1 + 70.
      661           assign
      662             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      663             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      664             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      665           .
      666         end.
      667       end.
      668       B-viewProcInfo:visible   in frame waitfram = no.
      669       B-viewProcInfo:sensitive in frame waitfram = no.
      670       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      671       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      672       if  (   mWaitFramView
      673          or  mWaitProcEvent)
      674          and not mBatchMode
      675       then
      676          display
      677             v-waitfram-action01 skip
      678             v-waitfram-action02 skip
      679             v-waitfram-action03 skip
      680          with frame waitfram .
      681       if     mWaitFramView
      682          then do:
      683             if     mWaitFramInterval ne ?
      684                and not mBatchMode
      685             then
      686                wait-for go of frame waitfram pause mWaitFramInterval.
      687          end.
      688          else
      689             if     mWaitProcEvent
      690                and not mBatchMode
      691             then
      692                process events .
      693     end.
      694   end procedure.
      695      procedure waitfram-show-this:
      696         define input  parameter iInterval as int64 no-undo.
      697         define variable vtime as int64 no-undo.
      698         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      699         mWaitFramInterval = iInterval.
      700         run waitfram-show (substitute("&1&2 &3&4" ,
      701                                       mWaitFramTextBeg ,
      702                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      703                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      704                                       mWaitFramTextEnd
      705                                      )
      706                           ).
      707      end.
      708      procedure WaitFramRunPause:
      709         define input  parameter iInterval as dec no-undo.
      710         define variable vStart  as datetime-tz no-undo.
      711         define variable vend    as datetime-tz no-undo.
      712         define variable vint as int64 no-undo.
      713         define variable vOk as logical no-undo.
      714         vStart = now.
      715         vend   = vStart.
      716         publish "WaitFramPause" (iInterval,output vOk).
      717         vend   =  now.
      718         vint = vend - vStart.
      719         vint = iInterval - vint / 1000.
      720         if     not mWaitFramStop
      721            and (   vint > 0
      722                 or (    not vOk
      723                     and iInterval eq ?
      724                     )
      725                 )
      726         then
      727            run waitfram-show-this (iInterval).
      728         vend   =  now.
      729         vint = vend - vStart.
      730         vint = iInterval - vint / 1000.
      731         if     not mWaitFramStop
      732            and vint > 0
      733         then do:
      734            run gbl/pause.p (vint * 1000).
      735         end.
      736         if iInterval ne ?
      737         then
      738            publish "WaitFramStop".
      739         waitfram-check-timeout().
      740      end.
      741      procedure WaitFramWaitFor:
      742         define input  parameter iInterval as dec no-undo.
      743         assign
      744            mWaitFramStartProc   = now
      745            mWaitFramStopUser    = no
      746            mWaitFramStopTimeOut = no
      747         .
      748         block-wait:
      749         do while not mWaitFramStop:
      750            run WaitFramRunPause (iInterval).
      751            if  waitfram-check-timeout()
      752            then do:
      753               leave block-wait.
      754            end.
      755         end.
      756         run waitfram-hide.
      757      end.
      758   procedure waitfram-join :
      759     define input  parameter p-line-1  as character no-undo .
      760     define input  parameter p-line-2  as character no-undo .
      761     define input  parameter p-line-3  as character no-undo .
      762     define output parameter p-message as character no-undo .
      763     do
      764     on error undo, return error return-value
      765     :
      766       assign
      767         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      768                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      769                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      770       .
      771     end.
      772   end procedure.
      773   function waitfram-join-function returns character
      774     (input p-line-1 as character
      775     ,input p-line-2 as character
      776     ,input p-line-3 as character
      777     ).
      778     define variable v-message as character no-undo .
      779     run waitfram-join in this-procedure
      780       (input  p-line-1
      781       ,input  p-line-2
      782       ,input  p-line-3
      783       ,output v-message
      784       ) .
      785     return v-message .
      786   end function .
      787   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      788   FUNCTION mark-string RETURNS CHARACTER
      789     ( input p-recid as recid, input mark-list as character  ) :
      790     RETURN ( IF LOOKUP( STRING( p-recid), mark-list ) > 0 THEN '*' ELSE '':U ).
      791   END FUNCTION.
      792   define variable log-res  as log   no-undo.
      793   define variable ri       as recid no-undo.
      794   define variable v-rid    as recid no-undo .
      795   define variable v-db-num like ub.db.db-num no-undo .
      796   define buffer b2-code for code .
      797   find first b2-code where b2-code.parent eq iparent
      798                        and b2-code.code   eq icode
      799   no-lock no-error.
      800   FUNCTION getStatus RETURNS CHARACTER
      801      ( imisc as char, istatus as int   )  FORWARD.
      802   DEFINE BUTTON b-add
      803      LABEL "До&бавить"
      804      SIZE 10 BY 1.
      805   DEFINE BUTTON b-exit AUTO-GO
      806      LABEL "&Выход ":L
      807      SIZE 10 BY 1.
      808   DEFINE BUTTON b-help
      809      LABEL "Помо&щь":L
      810      SIZE 3 BY 1.
      811   DEFINE BUTTON b-hist
      812      LABEL "Ис&тория"
      813      SIZE 3 BY 1.
      814   DEFINE BUTTON b-print
      815      LABEL "Пе&чать":L
      816      SIZE 3 BY 1.
      817   DEFINE BUTTON b-sel AUTO-GO
      818      LABEL "Вы&бор ":L
      819      SIZE 10 BY 1.
      820   DEFINE BUTTON b-upd
      821      LABEL "&Изменить":L
      822      SIZE 10 BY 1.
      823   DEFINE QUERY BROWSE-4 FOR
      824      buf-code SCROLLING.
      825   DEFINE BROWSE BROWSE-4
      826      QUERY BROWSE-4 NO-LOCK DISPLAY
      827   buf-code.misc1 COLUMN-LABEL "Дата н.а." FORMAT "x(10)":U
      828      buf-code.CodeValue FORMAT "x(20)":U WIDTH 32
      829      getStatus (buf-code.misc1,buf-code.status_) COLUMN-LABEL "Текущий статус" format "x(25)"
      830       WITH NO-ROW-MARKERS SEPARATORS SIZE 80.6 BY 10.52 ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.
      831   DEFINE FRAME f-okei3
      832      b-exit AT ROW 1 COL 1
      833      b-sel AT ROW 1 COL 13.6
      834      b-upd AT ROW 1 COL 24.8
      835      b-add AT ROW 1 COL 36.6 WIDGET-ID 2
      836      b-print AT ROW 1 COL 62.4
      837      b-hist AT ROW 1 COL 65.4
      838      b-help AT ROW 1 COL 68.4
      839      BROWSE-4 AT ROW 2.76 COL 1 WIDGET-ID 200
      840      SPACE(0.00) SKIP(0.04)
      841      WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      842      SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      843      TITLE "Значение ЕМЦ":L.
      844   ASSIGN
      845      FRAME f-okei3:SCROLLABLE = FALSE.
      846   ON GO OF FRAME f-okei3
      847      DO:
      848      END.
      849   ON CHOOSE OF b-add IN FRAME f-okei3
      850      DO:
      851         define buffer b-code   for code.
      852         define buffer btt-code for code.
      853         define variable vRec as recid   no-undo.
      854         define variable v-ok as logical no-undo.
      855         if v-ok
      856            then
      857         do:
      858            find first b-code where b-code.code = "EMC2" no-lock no-error.
      859            if     avail b-code
      860               and not b-code.nwsgbd
      861               then
      862            do trans:
      863               find first b-code where b-code.code = "EMC2" exclusive-lock no-error.
      864               b-code.nwsgbd = yes.
      865            end.
      866         end.
      867         ri = ?.
      868         run ref/emcv-add.w (
      869            input parparentproc
      870            , input 'ДОБАВЛЕНИЕ':U
      871            , input-output ri
      872            , input b2-code.parent + chr(4) + b2-code.code).
      873         if ri <> ? then
      874         do:
      875            OPEN QUERY BROWSE-4 FOR EACH buf-code       WHERE buf-code.parent eq b2-code.parent + chr(4) + b2-code.code    NO-LOCK INDEXED-REPOSITION.
      876            reposition BROWSE-4 to recid ri no-error.
      877            apply "ENTRY" to BROWSE-4.
      878         end.
      879      END.
      880   ON CHOOSE OF b-sel IN FRAME f-okei3
      881      DO:
      882         define buffer b-code for code.
      883         if not avail buf-code then return.
      884         find first b-code of buf-code no-lock no-error.
      885         if avail b-code then
      886            v-rid = recid(b-code).
      887      END.
      888   ON CHOOSE OF b-upd IN FRAME f-okei3
      889      DO:
      890         define buffer b-code   for code.
      891         define buffer btt-code for code.
      892         define variable vRec as recid no-undo.
      893         if not avail buf-code then return.
      894         define variable v-ok as logical no-undo.
      895         if v-ok
      896            then
      897         do:
      898            find first b-code where b-code.code = "EMC2" no-lock no-error.
      899            if     avail b-code
      900               and not b-code.nwsgbd
      901               then
      902            do trans:
      903               find first b-code where b-code.code = "EMC2" exclusive-lock no-error.
      904               b-code.nwsgbd = yes.
      905            end.
      906         end.
      907         find first b-code of buf-code no-lock no-error.
      908         if not avail b-code then
      909         do:
      910            message
      911               vss-workfile vss-revision vss-description skip
      912               "Не найдена запись <Код ОКЕИ код ККТ>"
      913               view-as alert-box error .
      914            return no-apply.
      915         end.
      916         vRec = recid(b-code).
      917         run ref/emcv-add.w (
      918            input parparentproc
      919            , input 'ИЗМЕНЕНИЕ':U
      920            , input-output vRec
      921            , input b2-code.parent + chr(4) + b2-code.code).
      922         OPEN QUERY BROWSE-4 FOR EACH buf-code       WHERE buf-code.parent eq b2-code.parent + chr(4) + b2-code.code    NO-LOCK INDEXED-REPOSITION.
      923         reposition BROWSE-4 to recid vRec no-error .
      924         apply "ENTRY" to BROWSE-4.
      925      end.
      926   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME f-okei3:PARENT eq ?
      927      THEN FRAME f-okei3:PARENT = ACTIVE-WINDOW.
      928   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      929   on help of frame f-okei3
      930   do:
      931     run gbl/app_help.p
      932       (input this-procedure :file-name
      933       ,input ''
      934       ,input ?
      935       ) no-error.
      936     if error-status :error then do:
      937       message
      938         "Ошибка при вызове помощи"
      939         error-status :get-message(1)
      940         view-as alert-box .
      941     end.
      942   end.
      943   run minbtn-set in this-procedure .
      944   on choose of b-help in frame f-okei3
      945   do:
      946     apply "help":u to frame f-okei3 .
      947   end.
      948   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      949   procedure minbtn-set :
      950       do
      951           on error undo, return error return-value
      952           :
      953           define variable ii              as integer       no-undo .
      954           define variable fh              as widget-handle no-undo .
      955           define variable hh              as widget-handle no-undo .
      956           define variable v-h             as handle        extent 4 no-undo .
      957           define variable v-name-button   as character     no-undo .
      958           define variable v-help-old-x    as decimal       no-undo .
      959           define variable v-help-old-y    as decimal       no-undo .
      960           define variable v-help-old-size as decimal       no-undo .
      961           define variable v-frame-width   as decimal       no-undo .
      962           define variable jj              as integer       no-undo .
      963           do
      964               on error undo, return error
      965               :
      966               assign
      967                   v-frame-width = frame f-okei3:width - 0.3
      968                   fh            = frame f-okei3:first-child
      969                   hh            = fh:first-child
      970                   ii            = 1
      971                   .
      972               do while valid-handle(hh):
      973                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      974                   do:
      975                       case lc(hh:name) :
      976                           when "b-help" then
      977                               do:
      978                                   hh:load-image-up("cmp/b-help.bmp":u) .
      979                                   hh:load-image-down("cmp/b-help.bmp":u) .
      980                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      981                                   hh:TOOLTIP = "Помощь" .
      982                                   v-help-old-x = hh:column .
      983                                   v-help-old-y = hh:row    .
      984                                   v-help-old-size = hh:width .
      985                                   hh:width-chars = 2.5 .
      986                               end.
      987                           when "b-print" then
      988                               do:
      989                                   hh:load-image("cmp/b-print.bmp":u) .
      990                                   hh:TOOLTIP = "Печать" .
      991                                   v-h[ii] = hh:handle .
      992                                   ii = ii + 1 .
      993                                   hh:width-chars = 3 .
      994                               end.
      995                           when "b-history" or
      996                           when "b-hist" then
      997                               do:
      998                                   hh:load-image("cmp/b-hist.bmp":u) .
      999                                   hh:TOOLTIP = "История" .
     1000                                   v-h[ii] = hh:handle .
     1001                                   ii = ii + 1 .
     1002                                   hh:width-chars = 3 .
     1003                               end.
     1004                           when "b-sch" then
     1005                               do:
     1006                                   hh:load-image("cmp/b-sch.bmp":u) .
     1007                                   hh:TOOLTIP = "Установка Фильтра" .
     1008                                   v-h[ii] = hh:handle .
     1009                                   ii = ii + 1 .
     1010                                   hh:width-chars = 3 .
     1011                               end.
     1012                           when "b-hist-user" then
     1013                               do:
     1014                                   hh:load-image("cmp/b-hist.bmp":u) .
     1015                                   hh:TOOLTIP = "История пользователя" .
     1016                                   ii = ii + 1 .
     1017                               end.
     1018                       end case.
     1019                   end.
     1020                   hh = hh:next-sibling.
     1021               end.
     1022               b-help:column = v-frame-width - b-help:width-chars.
     1023               jj = 0.
     1024               repeat ii = 4 to 1 by -1 :
     1025                   if valid-handle (v-h[ii] ) then
     1026                   do:
     1027                       jj  = jj + 1 .
     1028                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1029                       v-h[ii]:row    = v-help-old-y .
     1030                   end.
     1031               end.
     1032           end.
     1033       end.
     1034   end procedure.
     1035   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1036   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1037   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1038   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1039   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1040   define variable v-diasize-current-frame-height as decimal   no-undo .
     1041   define variable v-diasize-change-size          as logical   no-undo .
     1042   define variable v-diasize-resize-button        as handle    no-undo .
     1043   define variable v-diasize-wndmax               as logical   no-undo .
     1044   define variable v-diasize-wndstore             as logical   no-undo .
     1045   define variable v-diasize-proc-name            as character no-undo .
     1046   define variable v-diasize-browse-handle        as handle    no-undo .
     1047   define variable v-diasize-browse-number        as integer   no-undo .
     1048   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1049   define temp-table temp-diasize-handle no-undo
     1050     field handle-value  as handle
     1051     field save-position as decimal
     1052     index xpk is primary unique handle-value
     1053     .
     1054   define temp-table temp-browse-handle no-undo
     1055     field browse-type   as character
     1056     field browse-number as integer
     1057     field browse-handle as handle
     1058     field original-size as decimal
     1059     index xpk is primary unique browse-type browse-number
     1060     index xie browse-type browse-handle
     1061   .
     1062   procedure diasize_change-height :
     1063     define input  parameter p-change-value  as decimal   no-undo .
     1064     define input  parameter p-move-resize   as logical   no-undo .
     1065     define variable v-field-group-handle    as handle    no-undo .
     1066     define variable v-object-handle         as handle    no-undo .
     1067     define variable v-frame-height          as decimal   no-undo .
     1068     define variable v-frame-virtual-height  as decimal   no-undo .
     1069     define variable v-browse-height         as decimal   no-undo .
     1070     define variable v-window-height         as decimal   no-undo .
     1071     define variable v-window-virtual-height as decimal   no-undo .
     1072     define variable v-change-sign           as integer   no-undo .
     1073     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1074     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1075     if p-change-value > 0
     1076     then do:
     1077       if frame f-okei3 :height + p-change-value
     1078           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1079       then do:
     1080         assign
     1081           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1082                           - (frame f-okei3 :height-chars)
     1083         .
     1084         if p-change-value <= 0
     1085         then do:
     1086           run diasize_position-resize-button in this-procedure .
     1087           return .
     1088         end.
     1089       end.
     1090     end.
     1091     if p-change-value < 0
     1092     then do:
     1093       if frame f-okei3 :height + p-change-value < v-diasize-orig-frame-height
     1094       then do:
     1095         assign
     1096           p-change-value = v-diasize-orig-frame-height
     1097                          - (frame f-okei3 :height-chars)
     1098         .
     1099         if p-change-value >= 0
     1100         then do:
     1101           run diasize_position-resize-button in this-procedure .
     1102           return .
     1103         end.
     1104       end.
     1105     end.
     1106     if p-change-value >= 0
     1107     then do:
     1108       assign
     1109         v-change-sign = 1
     1110       .
     1111     end.
     1112     else do:
     1113       assign
     1114         v-change-sign = -1
     1115       .
     1116     end.
     1117     assign
     1118       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1119     .
     1120     if p-change-value = 0
     1121     then do:
     1122       run diasize_position-resize-button in this-procedure .
