     1723           if v-object-handle <> v-diasize-resize-button
     1724           then do:
     1725             assign
     1726               v-object-handle :col = v-object-handle :col + p-change-value
     1727               no-error .
     1728             if error-status :error
     1729             or error-status :get-message(1) <> ""
     1730             then do:
     1731               undo move_block, retry move_block .
     1732             end.
     1733           end.
     1734         end.
     1735       end.
     1736       else do:
     1737         for each buf_temp-diasize-handle
     1738         on error undo move_block, retry move_block
     1739         :
     1740           assign
     1741             v-object-handle = buf_temp-diasize-handle.handle-value
     1742           .
     1743           if v-object-handle <> v-diasize-resize-button
     1744           then do:
     1745             assign
     1746               v-object-handle :col = v-object-handle :col + p-change-value
     1747               no-error .
     1748             if error-status :error
     1749             or error-status :get-message(1) <> ""
     1750             then do:
     1751               undo move_block, retry move_block .
     1752             end.
     1753           end.
     1754         end.
     1755         for each buf_temp-browse-handle
     1756           where buf_temp-browse-handle.browse-type = 'width':u
     1757         on error undo move_block, retry move_block
     1758         :
     1759           assign
     1760             buf_temp-browse-handle.browse-handle :width
     1761               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1762             no-error .
     1763           if error-status :error
     1764           or error-status :get-message(1) <> ""
     1765           then do:
     1766             undo move_block, retry move_block .
     1767           end.
     1768         end.
     1769         assign
     1770           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1771           no-error .
     1772         if error-status :error
     1773         or error-status :get-message(1) <> ""
     1774         then do:
     1775           undo move_block, retry move_block.
     1776         end.
     1777         assign
     1778           frame f-okei3 :width = frame f-okei3 :width + p-change-value
     1779         no-error .
     1780         if error-status :error
     1781         or error-status :get-message(1) <> ""
     1782         then do:
     1783           undo move_block, retry move_block.
     1784         end.
     1785         if frame f-okei3 :scrollable = true
     1786         then do:
     1787           assign
     1788             frame f-okei3 :virtual-width = frame f-okei3 :virtual-width + p-change-value
     1789           no-error .
     1790           if error-status :error
     1791           or error-status :get-message(1) <> ""
     1792           then do:
     1793             undo move_block, retry move_block.
     1794           end.
     1795         end.
     1796       end.
     1797       if p-move-resize
     1798       then do:
     1799         run diasize_position-resize-button in this-procedure .
     1800       end.
     1801       if v-diasize-wndstore = true
     1802       then do:
     1803         if connected("ub") = true
     1804         then do:
     1805           define variable v-cntxt-db-num        as integer   no-undo .
     1806           define variable v-cntxt-userid        as character no-undo .
     1807           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1808                                             , OUTPUT v-cntxt-userid
     1809                                             ) .
     1810           run gbl/wndsizew.p
     1811             (input  v-cntxt-db-num
     1812             ,input  v-cntxt-userid
     1813             ,input  v-diasize-proc-name
     1814             ,input  'width':u
     1815             ,input  string(frame f-okei3 :width - v-diasize-orig-frame-width)
     1816             ) .
     1817         end.
     1818       end.
     1819     end.
     1820     assign
     1821       v-diasize-change-size = false
     1822     .
     1823   end procedure.
     1824   procedure diasize_set-width :
     1825     define input  parameter p-new-width  as decimal   no-undo .
     1826     define input  parameter p-move-resize as logical   no-undo .
     1827     do
     1828     on error undo, return error return-value
     1829     :
     1830       run diasize_change-width in this-procedure
     1831         (input  (p-new-width - frame f-okei3 :width)
     1832         ,input  p-move-resize
     1833         ) .
     1834     end.
     1835   end procedure.
     1836   procedure diasize_position-resize-button :
     1837     do with frame f-okei3
     1838     :
     1839       hide v-diasize-resize-button .
     1840       assign
     1841         v-diasize-resize-button :row = frame f-okei3 :height - v-diasize-resize-button :height
     1842                     - 1
     1843                     - (frame f-okei3 :border-bottom-pixels / session :pixels-per-row)
     1844         v-diasize-resize-button :col = frame f-okei3 :width - v-diasize-resize-button :width
     1845                     - 1
     1846                     - (frame f-okei3 :border-right-pixels / session :pixels-per-column)
     1847       .
     1848       view v-diasize-resize-button .
     1849     end.
     1850   end procedure.
     1851   on alt-right anywhere
     1852   do:
     1853     run diasize_change-width in this-procedure
     1854       (input 1
     1855       ,input true
     1856       ) .
     1857     return no-apply .
     1858   end.
     1859   on alt-left anywhere
     1860   do:
     1861     run diasize_change-width in this-procedure
     1862       (input -1
     1863       ,input true
     1864       ) .
     1865     return no-apply .
     1866   end.
     1867   on alt-down anywhere
     1868   do:
     1869     run diasize_change-height in this-procedure
     1870       (input 1
     1871       ,input true
     1872       ) .
     1873     return no-apply .
     1874   end.
     1875   on alt-up anywhere
     1876   do:
     1877     run diasize_change-height in this-procedure
     1878       (input -1
     1879       ,input true
     1880       ) .
     1881     return no-apply .
     1882   end.
     1883   on alt-enter of frame f-okei3
     1884   do:
     1885     run diasize_maximize in this-procedure
     1886       (input  ?
     1887       ).
     1888     return no-apply .
     1889   end.
     1890   procedure diasize_end-move :
     1891     do
     1892     on error undo, return error return-value
     1893     :
     1894       define variable v-row-delta as decimal   no-undo .
     1895       define variable v-col-delta as decimal   no-undo .
     1896       define variable v-new-row as decimal   no-undo .
     1897       define variable v-new-col as decimal   no-undo .
     1898       assign
     1899         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1900         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1901       .
     1902       assign
     1903         v-row-delta = v-new-row - frame f-okei3 :height
     1904         v-col-delta = v-new-col - frame f-okei3 :width
     1905       .
     1906       run diasize_change-height in this-procedure
     1907         (input v-row-delta
     1908         ,input true
     1909         ) .
     1910       run diasize_change-width in this-procedure
     1911         (input v-col-delta
     1912         ,input true
     1913         ) .
     1914     end.
     1915   end procedure.
     1916   procedure diasize_maximize :
     1917     define input  parameter p-action as logical   no-undo .
     1918     do
     1919     on error undo, return error return-value
     1920     :
     1921       if p-action = ?
     1922       then do:
     1923         if v-diasize-need-maximize = true
     1924         then do:
     1925           assign
     1926             p-action = true
     1927           .
     1928         end.
     1929         else do:
     1930           assign
     1931             p-action = false
     1932           .
     1933         end.
     1934       end.
     1935       if p-action = true
     1936       then do:
     1937         run diasize_change-height in this-procedure
     1938           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1939               - frame f-okei3 :height-chars
     1940           ,input true
     1941           ) .
     1942         run diasize_change-width in this-procedure
     1943           (input session :width-chars
     1944               - frame f-okei3 :width-chars
     1945           ,input true
     1946           ) .
     1947         assign
     1948           v-diasize-need-maximize = false
     1949         .
     1950       end.
     1951       else do:
     1952         run diasize_change-width in this-procedure
     1953           (input v-diasize-orig-frame-width
     1954               - frame f-okei3 :width-chars
     1955           ,input true
     1956           ) .
     1957         run diasize_change-height in this-procedure
     1958           (input v-diasize-orig-frame-height
     1959               - frame f-okei3 :height-chars
     1960           ,input true
     1961           ) .
     1962         assign
     1963           v-diasize-need-maximize = true
     1964         .
     1965       end.
     1966     end.
     1967   end procedure.
     1968   procedure diasize_restore-orig-size :
     1969     do
     1970     on error undo, return error return-value
     1971     :
     1972       assign
     1973         v-diasize-current-frame-width  = frame f-okei3 :width
     1974         v-diasize-current-frame-height = frame f-okei3 :height
     1975       .
     1976       run diasize_set-height in this-procedure
     1977         (input  v-diasize-orig-frame-height
     1978         ,input  true
     1979         ) .
     1980       run diasize_set-width in this-procedure
     1981         (input  v-diasize-orig-frame-width
     1982         ,input  true
     1983         ) .
     1984     end.
     1985   end procedure.
     1986   procedure diasize_restore-current-size :
     1987     do
     1988     on error undo, return error return-value
     1989     :
     1990       run diasize_set-height in this-procedure
     1991         (input  v-diasize-current-frame-height
     1992         ,input  true
     1993         ) .
     1994       run diasize_set-width in this-procedure
     1995         (input  v-diasize-current-frame-width
     1996         ,input  true
     1997         ) .
     1998     end.
     1999   end procedure.
     2000   procedure diasize_set-browse-handle :
     2001     define input  parameter p-browse-handle as handle   no-undo .
     2002     define buffer buf_temp-browse-handle for temp-browse-handle .
     2003     do
     2004     on error undo, return error return-value
     2005     :
     2006       assign
     2007         v-diasize-browse-handle = p-browse-handle
     2008       .
     2009       for each buf_temp-browse-handle
     2010       on error undo, return error return-value
     2011       :
     2012         delete buf_temp-browse-handle .
     2013       end.
     2014     end.
     2015   end procedure.
     2016   procedure diasize_add_browse :
     2017     define input  parameter p-browse-type   as character no-undo .
     2018     define input  parameter p-browse-handle as handle    no-undo .
     2019     define buffer buf_temp-browse-handle for temp-browse-handle .
     2020     do
     2021     on error undo, return error return-value
     2022     :
     2023       assign
     2024         v-diasize-browse-number = v-diasize-browse-number + 1
     2025       .
     2026       create buf_temp-browse-handle .
     2027       assign
     2028         buf_temp-browse-handle.browse-type   = p-browse-type
     2029         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2030         buf_temp-browse-handle.browse-handle = p-browse-handle
     2031       .
     2032     end.
     2033   end procedure.
     2034   procedure diasize_init :
     2035     define variable v-default-value    as logical   no-undo .
     2036     define variable v-restore-saved    as logical   no-undo .
     2037     define variable v-resize-value-str as character no-undo .
     2038     do
     2039     on error undo, return error return-value
     2040     :
     2041       do with frame f-okei3
     2042       :
     2043         assign
     2044           v-diasize-orig-frame-height = frame f-okei3 :height
     2045           v-diasize-orig-frame-width  = frame f-okei3 :width
     2046           v-diasize-browse-handle     = browse BROWSE-4 :handle
     2047         .
     2048         create button v-diasize-resize-button
     2049         assign
     2050           parent        = frame f-okei3 :first-child
     2051           label         = "s"
     2052           height-pixels = 16
     2053           width-pixels  = 16
     2054           visible       = true
     2055           sensitive     = true
     2056           movable       = true
     2057           triggers:
     2058             on end-move persistent run diasize_end-move in this-procedure .
     2059           end triggers.
     2060         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2061         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2062         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2063         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2064         assign
     2065           v-diasize-wndmax = false
     2066         .
     2067         if connected("ub") = true
     2068         then do:
     2069           define variable v-cntxt-db-num        as integer   no-undo .
     2070           define variable v-cntxt-userid        as character no-undo .
     2071           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2072                                             , OUTPUT v-cntxt-userid
     2073                                             ) .
     2074           run gbl/wndpar_r.p
     2075             (input  v-cntxt-db-num
     2076             ,input  v-cntxt-userid
     2077             ,input  'wndmax':U
     2078             ,output v-diasize-wndmax
     2079             ,output v-default-value
     2080             ) .
     2081         end.
     2082         assign
     2083           v-diasize-wndstore = false
     2084         .
     2085         if connected("ub") = true
     2086         then do:
     2087           run gbl/wndpar_r.p
     2088             (input  v-cntxt-db-num
     2089             ,input  v-cntxt-userid
     2090             ,input  'wndstore':U
     2091             ,output v-diasize-wndstore
     2092             ,output v-default-value
     2093             ) .
     2094         end.
     2095         assign
     2096           v-diasize-proc-name = entry(1, program-name(2), '.')
     2097         .
     2098         if v-diasize-wndstore = true
     2099         then do:
     2100           assign
     2101             v-restore-saved = false
     2102           .
     2103           if connected("ub") = true
     2104           then do:
     2105             run gbl/wndsizer.p
     2106               (input  v-cntxt-db-num
     2107               ,input  v-cntxt-userid
     2108               ,input  v-diasize-proc-name
     2109               ,input  'height':u
     2110               ,output v-resize-value-str
     2111               ) .
     2112             if v-resize-value-str <> '':U
     2113             then do:
     2114               run diasize_change-height in this-procedure
     2115                 (input  integer(v-resize-value-str)
     2116                 ,input  true
     2117                 ) .
     2118               assign
     2119                 v-restore-saved = true
     2120               .
     2121             end.
     2122           end.
     2123           if connected("ub") = true
     2124           then do:
     2125             run gbl/wndsizer.p
     2126               (input  v-cntxt-db-num
     2127               ,input  v-cntxt-userid
     2128               ,input  v-diasize-proc-name
     2129               ,input  'width':u
     2130               ,output v-resize-value-str
     2131               ) .
     2132             if v-resize-value-str <> '':U
     2133             then do:
     2134               run diasize_change-width in this-procedure
     2135                 (input  integer(v-resize-value-str)
     2136                 ,input  true
     2137                 ) .
     2138               assign
     2139                 v-restore-saved = true
     2140               .
     2141             end.
     2142           end.
     2143           if v-restore-saved <> true
     2144           then do:
     2145             if v-diasize-wndmax = true
     2146             then do:
     2147               run diasize_maximize in this-procedure
     2148                 (input  true
     2149                 ) .
     2150             end.
     2151           end.
     2152         end.
     2153         else do:
     2154           if v-diasize-wndmax = true
     2155           then do:
     2156             run diasize_maximize in this-procedure
     2157               (input  true
     2158               ) .
     2159           end.
     2160         end.
     2161       end.
     2162     end.
     2163   end procedure.
     2164   procedure diasize_need-full-display :
     2165     define output parameter p-need-full-display as logical   no-undo .
     2166     do
     2167     on error undo, return error return-value
     2168     :
     2169       assign
     2170         p-need-full-display = v-diasize-need-full-display
     2171       .
     2172       assign
     2173         v-diasize-need-full-display = false
     2174       .
     2175     end.
     2176   end procedure.
     2177   procedure get-context :
     2178      define output parameter p-db-num as integer          no-undo.
     2179      define output parameter p-user-id as character        no-undo.
     2180      define variable v-login               as character    no-undo.
     2181      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2182      define buffer buf_user-login  for ub.user-login .
     2183      do
     2184      on error undo, return error
     2185      :
     2186            FIND FIRST buf_sys-ctrl no-lock.
     2187            ASSIGN
     2188               v-login = USERID("ub")
     2189               p-db-num = buf_sys-ctrl.db-num
     2190            .
     2191            FIND FIRST buf_user-login
     2192                 WHERE buf_user-login.db-num = p-db-num
     2193                   AND buf_user-login.user-login = v-login
     2194                 no-lock
     2195                 no-error
     2196                 .
     2197            IF AVAILABLE buf_user-login
     2198            THEN DO:
     2199               assign
     2200                  p-user-id = buf_user-login.user-id
     2201               .
     2202            END.
     2203      end.
     2204   end procedure.
     2205       run diasize_init in this-procedure .
     2206   ON WINDOW-CLOSE OF FRAME f-okei3
     2207      APPLY "END-ERROR":U TO SELF.
     2208   MAIN-BLOCK:
     2209   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2210      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2211   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2212     run mainmenu_getcntxt in parparentproc
     2213       (output v-cntxt-db-num
     2214       ,output v-cntxt-userid
     2215       ,output v-cntxt-level
     2216       ,output v-cntxt-host-code-obj
     2217       ,output v-cntxt-obj-type
     2218       ,output v-cntxt-obj-code
     2219       ,output v-cntxt-db-num-obj
     2220       ,output v-cntxt-is-admin
     2221       ) .
     2222   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2223   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2224     (output v-db-num
     2225     )  .
     2226      run enable_UI in this-procedure .
     2227      WAIT-FOR GO OF FRAME f-okei3 focus BROWSE-4.
     2228   END.
     2229   run disable_UI in this-procedure .
     2230   PROCEDURE disable_UI :
     2231      HIDE FRAME f-okei3.
     2232   END PROCEDURE.
     2233   PROCEDURE enable_UI :
     2234      ENABLE
     2235         BROWSE-4
     2236         b-exit
     2237         b-sel
     2238         WHEN imode eq 'ВЫБОР':U
     2239         b-add
     2240         when imode eq 'ИЗМЕНЕНИЕ':U and v-db-num = 0
     2241         b-upd
     2242         WHEN imode eq 'ИЗМЕНЕНИЕ':U and v-db-num = 0
     2243         b-help
     2244         WITH FRAME f-okei3.
     2245      OPEN QUERY BROWSE-4 FOR EACH buf-code       WHERE buf-code.parent eq b2-code.parent + chr(4) + b2-code.code    NO-LOCK INDEXED-REPOSITION.
     2246   END PROCEDURE.
     2247   FUNCTION getStatus RETURNS CHARACTER
     2248      ( imisc as char, istatus as int   ):
     2249      define buffer code for ub.code.
     2250      if istatus eq 1
     2251         then
     2252         return "Деактивирован".
     2253      else
     2254      do:
     2255         def var vdate         as date no-undo.
     2256         def var vdateiso      as char no-undo.
     2257         def var vDateTodayIso as char no-undo.
     2258         vdate = date(imisc) no-error.
     2259         if error-status:error
     2260            then
     2261            return "Ошибка".
     2262         else
     2263         do:
     2264            if vdate > today
     2265            then
     2266               return "Ожидает активации".
     2267            else if vdate = today
     2268            then
     2269               return "Текущий".
     2270            else
     2271            do:
     2272               vdateiso      = iso-date(vdate).
     2273               vDateTodayIso = iso-date(today).
     2274               find code where code.parent eq b2-code.parent + chr(4) + b2-code.code
     2275                  and code.code > vdateiso
     2276                  and code.code <= vDateTodayIso
     2277                  and code.status_ ne 1
     2278                  no-lock no-error.
     2279               if not avail code
     2280               then do:
     2281                  return if ambig code then "Устаревший" else  "Текущий".
     2282               end.
     2283               else
     2284               do:
     2285                  DEF VAR vMonth   AS INT64.
     2286                  DEF VAR vYear    AS INT64.
     2287                  DEF VAR vDateNew AS DATE.
     2288                  DEF VAR vDay     AS INT64.
     2289                  vMonth = MONTH(today) -  3.
     2290                  vYear =  YEAR(today).
     2291                  if vMonth < 1
     2292                     then assign
     2293                        vMonth = vMonth + 12
     2294                        vYear  = vYear - 1
     2295                        .
     2296                  vDateNew = DATE(vMonth,DAY(today),vYear) NO-ERROR.
     2297                  DO WHILE ERROR-STATUS:ERROR EQ YES:
     2298                     VDay = vDay + 1.
     2299                     vDateNew = DATE(vMonth,DAY(today) - vDay,vYear) NO-ERROR.
     2300                  END.
     2301                  if VDay > 0
     2302                     then
     2303                     vDateNew + 1.
     2304                  if vDateNew > Date(code.misc1)
     2305                     then
     2306                     return "Устаревший".
     2307                  else
     2308                     return "Предыдущий".
     2309               end.
     2310            end.
     2311         end.
     2312      end.
     2313   end.
