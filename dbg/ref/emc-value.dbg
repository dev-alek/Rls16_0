        1   DEFINE BUFFER buf-code FOR Code.
        2   define input  parameter Parparentproc  as handle    no-undo.
        3   define input  parameter iMode          as character no-undo.
        4   define input  parameter iParent        as character no-undo.
        5   define input  parameter iCode          as character no-undo.
        6   define input  parameter ititle         as character no-undo.
        7   define variable vss-revision    as character no-undo init "$Revision: $":U .
        8   define variable vss-author      as character no-undo init "$Author: $":U .
        9   define variable vss-date        as character no-undo init "$Date: $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: $":U .
       12   define variable vss-description as character no-undo init "Код ОКЕИ код ККТ".
       13   procedure vss-get-info :
