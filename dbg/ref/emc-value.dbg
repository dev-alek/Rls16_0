     1460     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1461     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1462     if p-change-value > 0
     1463     then do:
     1464       if frame f-okei3 :width + p-change-value >
     1465           session :width-chars
     1466       then do:
     1467         assign
     1468           p-change-value = session :width-chars - frame f-okei3 :width
     1469         .
     1470         if p-change-value <= 0
     1471         then do:
     1472           run diasize_position-resize-button in this-procedure .
     1473           return .
     1474         end.
     1475       end.
     1476     end.
     1477     if p-change-value < 0
     1478     then do:
     1479       if frame f-okei3 :width + p-change-value < v-diasize-orig-frame-width
     1480       then do:
     1481         assign
     1482           p-change-value = v-diasize-orig-frame-width
     1483                          - frame f-okei3 :width
     1484         .
     1485         if p-change-value >= 0
     1486         then do:
     1487           run diasize_position-resize-button in this-procedure .
     1488           return .
     1489         end.
     1490       end.
     1491     end.
     1492     if p-change-value >= 0
     1493     then do:
     1494       assign
     1495         v-change-sign = 1
     1496       .
     1497     end.
     1498     else do:
     1499       assign
     1500         v-change-sign = -1
     1501       .
     1502     end.
     1503     assign
     1504       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1505     .
     1506     if p-change-value = 0
