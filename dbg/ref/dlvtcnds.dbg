     4154   PROCEDURE proc-b-del :
     4155   define variable loc#log as logical no-undo.
     4156   define variable v-sts like ub.deliv-type-cond-keep.sts no-undo .
     4157   DEFINE VARIABLE loc-doc-rec AS RECID NO-UNDO.
     4158   if not available X_deliv-type-cond-keep then return error.
     4159   do
     4160   on error undo, return error
     4161   on stop undo, return error
     4162   :
     4163   define variable vss-include-info43 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4164   do:
     4165     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4166       (input  v-cntxt-db-num
     4167       ,input  v-cntxt-userid
     4168       ,input  0
     4169       ,input  'actn_delivery-storage_work':U
     4170       ,input  'global':U
     4171       ,input  0
     4172       ,input  '':U
     4173       ,input  0
     4174       ,input  0
     4175       ,input  0
     4176       ,input  0
     4177       ,input  true
     4178       ,output loc#log
     4179       )  .
     4180   end.
     4181   if not loc#log then return error.
     4182     assign
     4183     v-sts = ?
     4184     loc-doc-rec = RECID(X_deliv-type-cond-keep)
     4185     .
     4186     run ref/dlvtcnd2.p (
     4187                     input recid(X_deliv-type-cond-keep)
     4188                     ,input-output v-sts
     4189                    ) no-error .
     4190     if error-status:error then undo, return error.
     4191     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     4192     REPOSITION br-delivtypecndk to recid loc-doc-rec No-error.
     4193     if error-status:error then do:                           find first pos_deliv-type-cond-keep no-lock where                                   recid(pos_deliv-type-cond-keep) = loc-doc-rec no-error .                             message                             "Невозможно позиционироваться на записи ВОЗМОЖНОСТИ ДОСТАВКИ ПО УСЛОВИЯМ ХРАНЕНИЯ" skip                            string(if avail pos_deliv-type-cond-keep                                     then  substitute("Вн код типа доставки: &1 вн код услоий хранения: &2"                                                     , pos_deliv-type-cond-keep.deliv-type-code                                                     , pos_deliv-type-cond-keep.cond-keep-code)                                     else "":U) skip                             "Запись была добавлена (или изменена или удалена) -" skip                             "и теперь не попадает в текущую выборку"                             view-as alert-box WARNING.                           end.
     4194     if available X_deliv-type-cond-keep then do:
     4195       loc#log = br-delivtypecndk:select-focused-row( ) IN FRAME Dialog-Frame.
     4196     end.
     4197     apply "ENTRY" to br-delivtypecndk.
     4198   end.
     4199   END PROCEDURE.
