     2970   PROCEDURE OpenBr :
     2971   define input  parameter p-open-query     as logical   no-undo .
     2972   define input  parameter p-find-next      as logical   no-undo .
     2973   define input  parameter p-find-condition as character no-undo .
     2974   define variable l-query-was-opened as logical no-undo .
     2975   define variable title0 as character no-undo.
     2976   title0 = "Список возможностей доставки по условиям хранения" + chr(32).
     2977   run waitfram-show in this-procedure ("Ждите...").
     2978   define variable sort-column-phrase as character no-undo .
     2979   case sort-column-name :
     2980     when "" then do:
     2981       assign
     2982         sort-column-phrase = ""
     2983       .
     2984     end.
     2985     otherwise do:
     2986       assign
     2987         sort-column-phrase = "by " + sort-column-name
     2988       .
     2989     end.
     2990   end case.
     2991   define variable l-open-query as logical   no-undo .
     2992     CASE p-mode :
     2993       WHEN 'все':U        THEN DO:
     2994        assign
     2995        filter-point = filter-point0 + p-mode
     2996        filter-label = substitute("&1", filter-label0)
     2997        .
     2998        IF p-sts = ?  THEN DO:
     2999   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3000   define variable  l-disable-where-32  as logical   no-undo .
     3001   define variable  l-filter-open-32    as logical   .
     3002   define variable  flt-rec-32       as recid     no-undo .
     3003   define variable  filter-name-32      as character no-undo .
     3004   define variable  where-phrase-32     as character no-undo .
     3005   define variable  sort-phrase-32      as character no-undo .
     3006   define variable  where-phrase-rus-32 as character no-undo .
     3007   define variable  sort-phrase-rus-32  as character no-undo .
     3008     run waitfram-show in this-procedure
     3009       (input "ЖДИТЕ ..."
     3010       ).
     3011   run gbl/flt-get.p
     3012     (input filter-point
     3013     ,output flt-rec-32
     3014     ,output filter-name-32
     3015     ,output where-phrase-32
     3016     ,output sort-phrase-32
     3017     ,output where-phrase-rus-32
     3018     ,output sort-phrase-rus-32
     3019     ).
     3020   if p-open-query then do:
     3021       run set-filter-name in this-procedure
     3022         (INPUT filter-name-32
     3023         ) no-error .
     3024     assign
     3025       l-filter-open-32 = false
     3026     .
     3027     if flt-rec-32 <> ?
     3028       or sort-column-phrase > ""
     3029     then do:
     3030       define variable  parameter-2-32 as character no-undo .
     3031       define variable  parameter-3-32 as character no-undo .
     3032       define variable  parameter-4-32 as character no-undo .
     3033       define variable  parameter-5-32 as character no-undo .
     3034       define variable  parameter-6-32 as character no-undo .
     3035       define variable  parameter-7-32 as character no-undo .
     3036         assign
     3037         parameter-3-32 =
     3038                                 "FOR EACH X_deliv-type-cond-keep"
     3039         parameter-4-32 =
     3040           (
     3041             if (" TRUE " + " " + where-phrase-32) <> ""
     3042             then " TRUE " + " " + where-phrase-32
     3043             else "true"
     3044           )
     3045         parameter-5-32 = (" " + "" + " " + "")
     3046         parameter-6-32 = if sort-phrase-32 = ''
     3047                              then
     3048           (
     3049           " " + "  " +
     3050             " " + sort-column-phrase +
     3051           " " + "  "
     3052           )
     3053                              else
     3054           (
     3055           " " + "  " +
     3056             " " + sort-column-phrase +
     3057           " " + sort-phrase-32
     3058           )
     3059         parameter-7-32 =
     3060           " indexed-reposition  "
     3061       .
     3062       do
     3063       on stop undo, leave
     3064       on error undo, leave
     3065       :
     3066         assign
     3067           l-disable-where-32 =
     3068             (" TRUE " + " " + where-phrase-32 = "")
     3069         .
     3070         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3071                             ,input QUERY br-delivtypecndk:handle
     3072                             ,input parameter-3-32
     3073                             ,input parameter-4-32
     3074                             ,input parameter-5-32
     3075                             ,input parameter-6-32
     3076                             ,input parameter-7-32
     3077                             )
     3078         .
     3079         assign
     3080           l-filter-open-32 = true
     3081         .
     3082       end.
     3083       if l-filter-open-32 = false then do:
     3084         message
     3085           "Ошибка при фильтрации / сортировке" skip
     3086           "Будут показаны записи без учета фильтра" skip
     3087           view-as alert-box .
     3088       end.
     3089       else do:
     3090           assign
     3091             l-query-was-opened = true
     3092           .
     3093       end.
     3094     end.
     3095     if l-filter-open-32 = false then do:
     3096       OPEN QUERY br-delivtypecndk FOR EACH X_deliv-type-cond-keep
     3097         where  TRUE
     3098         indexed-reposition
     3099     .
     3100         assign
     3101           l-query-was-opened = true
     3102         .
     3103     end.
     3104   end.
     3105   else do:
     3106     assign
     3107       v-doc-rec = recid( X_deliv-type-cond-keep )
     3108     .
     3109     do
     3110     on stop undo, leave
     3111     on error undo, leave
     3112     :
     3113       if QUERY br-delivtypecndk:handle:get-buffer-handle(1) = (buffer X_deliv-type-cond-keep:handle) then do:
     3114         assign
     3115         parameter-2-32 = (if p-find-next then "true":u else "false":u )
     3116         parameter-4-32 =
     3117           "where ":u + " TRUE " + " ":u + where-phrase-32 + " ":u + p-find-condition + " " + ""
     3118         parameter-5-32 = "  "
     3119       .
     3120         run fltopend_fltfindd in this-procedure  (
     3121                             input this-procedure:handle
     3122                             ,input QUERY br-delivtypecndk:handle
     3123                             ,input rowid(X_deliv-type-cond-keep)
     3124                             ,input logical(parameter-2-32)
     3125                             ,input no-lock
     3126                             ,input (buffer X_deliv-type-cond-keep:handle)
     3127                             ,input parameter-4-32
     3128                             ,input parameter-5-32
     3129                             ) no-error.
     3130         .
     3131         assign
     3132           v-doc-rec = integer(return-value)
     3133           v-fltopend-rowid[1] = ?
     3134         .
     3135       end.
     3136       else do:
     3137         assign
     3138         parameter-2-32 = (if p-find-next then "true":u else "false":u )
     3139         parameter-3-32 =  "FOR EACH X_deliv-type-cond-keep"
     3140         parameter-4-32 =
     3141           (
     3142             if (" TRUE " + " " + where-phrase-32) <> ""
     3143             then " TRUE " + " " + where-phrase-32
     3144             else "true"
     3145           )
     3146         parameter-5-32 = (" " + "" + " " + "" + " " + p-find-condition)
     3147         parameter-6-32 = if sort-phrase-32 = ''
     3148                              then
     3149           (
     3150           " " + "  " +
     3151             " " + sort-column-phrase +
     3152           " " + "  "
     3153           )
     3154                              else
     3155           (
     3156           " " + "  " +
     3157             " " + sort-column-phrase +
     3158           " " + sort-phrase-32
     3159           )
     3160         parameter-7-32 =
     3161           " indexed-reposition  "
     3162       .
     3163         run fltopend_fltfindq in this-procedure  (
     3164                             input this-procedure:handle
     3165                             ,input QUERY br-delivtypecndk:handle
     3166                             ,input logical(parameter-2-32)
     3167                             ,input no-lock
     3168                             ,input parameter-3-32
     3169                             ,input parameter-4-32
     3170                             ,input parameter-5-32
     3171                             ,input parameter-6-32
     3172                             ,input parameter-7-32
     3173                             ,output v-fltopend-rowid
     3174                             ) no-error.
