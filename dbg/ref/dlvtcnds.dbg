     2773      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2774   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2775     run mainmenu_getcntxt in parparentproc
     2776       (output v-cntxt-db-num
     2777       ,output v-cntxt-userid
     2778       ,output v-cntxt-level
     2779       ,output v-cntxt-host-code-obj
     2780       ,output v-cntxt-obj-type
     2781       ,output v-cntxt-obj-code
     2782       ,output v-cntxt-db-num-obj
     2783       ,output v-cntxt-is-admin
     2784       ) .
     2785     find first X_curr_clients no-lock where
     2786               X_curr_clients.obj-type = p-curr-obj-type
     2787          AND X_curr_clients.obj-code = p-curr-obj-code no-error.
     2788     if not available X_curr_clients then do:
     2789       message
     2790       vss-workfile vss-revision vss-description skip
     2791       "Неверное значение параметра вызова p-curr-obj-type p-curr-obj-code"
     2792       p-curr-obj-type p-curr-obj-code
     2793       view-as alert-box ERROR.
     2794       return error .
     2795     end.
     2796    if LOOKUP(p-mode, ('все':U + chr(4) + "delivery-type" + chr(4) + "condition-keeping") ,
     2797                   chr(4)) = 0
     2798        then dO:
     2799       message
     2800       vss-workfile vss-revision vss-description skip
     2801       "Неверное значение параметров вызова p-mode"
     2802       p-mode
     2803       view-as alert-box ERROR.
     2804       return error .
     2805    end.
     2806    IF p-mode = "delivery-type" THEN DO:
     2807        FIND FIRST X_delivery-type NO-LOCK WHERE
     2808                   X_delivery-type.deliv-type-code = p-deliv-type-code NO-ERROR.
     2809       IF NOT AVAILABLE X_delivery-type THEN DO:
     2810           MESSAGE
     2811           vss-workfile vss-revision vss-description skip
     2812           "Неверное значение параметров вызова p-deliv-type-code"
     2813           p-DELIV-TYPE-CODE
     2814           view-as alert-box ERROR.
     2815           return error .
     2816      END.
     2817    END.
     2818   IF p-mode = "condition-keeping" THEN DO:
     2819        FIND FIRST X_condition-keeping NO-LOCK WHERE
     2820                   X_condition-keeping.cond-keep-code = p-cond-keep-code NO-ERROR.
     2821       IF NOT AVAILABLE X_delivery-type THEN DO:
     2822           MESSAGE
     2823           vss-workfile vss-revision vss-description skip
     2824           "Неверное значение параметров вызова p-cond-keep-code"
     2825           p-cond-keep-code
     2826           view-as alert-box ERROR.
     2827           return error .
     2828      END.
     2829    END.
     2830    v-rid-list = p-rid-list.
     2831   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2832   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     2833     (output v-db-num
     2834     )  .
     2835     RUN MyEnable.
     2836     RUn OpenBR in this-procedure ( input yes, input no, input '':U).
     2837     HIDE mark-num in frame Dialog-Frame .
     2838     if v-doc-rec <> ? then
     2839     REPOSITION br-delivtypecndk to recid v-doc-rec No-ERROR.
     2840   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2841   DEF VAR cur-clmn-numbr-delivtypecndk as INT EXTENT 7 no-undo.
     2842   DEF VAR varmvibr-delivtypecndk       as INT no-undo.
     2843   DEF VAR varmvjbr-delivtypecndk       as INT no-undo.
     2844   DEF VAR varmvkbr-delivtypecndk       as INT no-undo.
     2845   DEF VAR varmvlbr-delivtypecndk       as INT no-undo.
     2846   DEF VAR move-elementbr-delivtypecndk as INT no-undo.
     2847   def var jjbr-delivtypecndk           as int no-undo.
     2848   do varmvibr-delivtypecndk = 1 to EXTENT(cur-clmn-numbr-delivtypecndk):
     2849     ASSIGN cur-clmn-numbr-delivtypecndk[varmvibr-delivtypecndk] = varmvibr-delivtypecndk.
     2850   END.
     2851   RUN start-mv-clmnbr-delivtypecndk.
     2852   PROCEDURE start-mv-clmnbr-delivtypecndk:
     2853   def var old-session as logical no-undo.
     2854      old-session = SESSION:IMMEDIATE-DISPLAY.
     2855      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2856          IF  p-mode = 'все':U  THEN DO:
     2857      DO jjbr-delivtypecndk = NUM-ENTRIES('1,2,3,4,5,6,7') TO 1 BY -1:
     2858        RUN re-move-clmnbr-delivtypecndk ( cur-clmn-numbr-delivtypecndk[INTEGER(ENTRY (jjbr-delivtypecndk, '1,2,3,4,5,6,7'))] , 1).
     2859      END.
     2860          END.
     2861          IF  p-mode = 'delivery-type'  THEN DO:
     2862      DO jjbr-delivtypecndk = NUM-ENTRIES('1,4,5,6,7,2,3') TO 1 BY -1:
     2863        RUN re-move-clmnbr-delivtypecndk ( cur-clmn-numbr-delivtypecndk[INTEGER(ENTRY (jjbr-delivtypecndk, '1,4,5,6,7,2,3'))] , 1).
     2864      END.
     2865          END.
     2866          IF  p-mode = 'condition-keeping'  THEN DO:
     2867      DO jjbr-delivtypecndk = NUM-ENTRIES('1,2,3,6,7,4,5') TO 1 BY -1:
     2868        RUN re-move-clmnbr-delivtypecndk ( cur-clmn-numbr-delivtypecndk[INTEGER(ENTRY (jjbr-delivtypecndk, '1,2,3,6,7,4,5'))] , 1).
     2869      END.
     2870          END.
     2871      SESSION:IMMEDIATE-DISPLAY = old-session.
     2872   END.
     2873   ON ctrl-cursor-right OF BROWSE br-delivtypecndk do:
     2874     RUN re-move-clmnbr-delivtypecndk ( 1, 7).
     2875   END.
     2876   ON ctrl-cursor-left OF BROWSE br-delivtypecndk do:
     2877     RUN re-move-clmnbr-delivtypecndk (7, 1).
     2878   END.
     2879   PROCEDURE re-move-clmnbr-delivtypecndk:
     2880     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2881     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2882     DO varmvibr-delivtypecndk = 1 TO EXTENT(cur-clmn-numbr-delivtypecndk):
     2883       if cur-clmn-numbr-delivtypecndk[varmvibr-delivtypecndk] = source-column THEN cur-clmn-numbr-delivtypecndk[varmvibr-delivtypecndk] = -1.
     2884     END.
     2885     if br-delivtypecndk:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     2886     if source-column > target-column THEN
     2887     DO varmvjbr-delivtypecndk = source-column - 1 to target-column BY -1:
     2888       DO varmvibr-delivtypecndk = 1 TO EXTENT(cur-clmn-numbr-delivtypecndk):
     2889           if cur-clmn-numbr-delivtypecndk[varmvibr-delivtypecndk] = varmvjbr-delivtypecndk THEN DO:
     2890             cur-clmn-numbr-delivtypecndk[varmvibr-delivtypecndk] = cur-clmn-numbr-delivtypecndk[varmvibr-delivtypecndk] + 1.
     2891           END.
     2892       END.
     2893     END.
     2894     ELSE
     2895     DO varmvjbr-delivtypecndk = source-column + 1 to target-column:
     2896       DO varmvibr-delivtypecndk = 1 TO EXTENT(cur-clmn-numbr-delivtypecndk):
     2897         if cur-clmn-numbr-delivtypecndk[varmvibr-delivtypecndk] = varmvjbr-delivtypecndk THEN DO:
     2898           cur-clmn-numbr-delivtypecndk[varmvibr-delivtypecndk] = cur-clmn-numbr-delivtypecndk[varmvibr-delivtypecndk] - 1.
     2899         END.
     2900       END.
     2901     END.
     2902     DO varmvibr-delivtypecndk = 1 TO EXTENT(cur-clmn-numbr-delivtypecndk):
     2903       if cur-clmn-numbr-delivtypecndk[varmvibr-delivtypecndk] = -1 THEN cur-clmn-numbr-delivtypecndk[varmvibr-delivtypecndk] = target-column.
     2904     END.
     2905   END PROCEDURE.
     2906   PROCEDURE ch-clmnbr-delivtypecndk:
     2907     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2908     if cur-clmn-loc <= 1 then do:
     2909       return .
     2910     end.
     2911     DO varmvibr-delivtypecndk = 1 TO EXTENT(cur-clmn-numbr-delivtypecndk):
     2912       if cur-clmn-numbr-delivtypecndk[varmvibr-delivtypecndk] = cur-clmn-loc THEN move-elementbr-delivtypecndk = varmvibr-delivtypecndk.
     2913     END.
     2914     RUN re-move-clmnbr-delivtypecndk (cur-clmn-loc, 1).
     2915   END PROCEDURE.
     2916   PROCEDURE mv-brw-defaultbr-delivtypecndk:
     2917   def var old-session as logical no-undo.
     2918     old-session = SESSION:IMMEDIATE-DISPLAY.
     2919     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2920     do varmvlbr-delivtypecndk = 1 to EXTENT(cur-clmn-numbr-delivtypecndk):
     2921       RUN re-move-clmnbr-delivtypecndk (cur-clmn-numbr-delivtypecndk[varmvlbr-delivtypecndk], varmvlbr-delivtypecndk).
     2922     END.
     2923     RUN start-mv-clmnbr-delivtypecndk.
     2924     SESSION:IMMEDIATE-DISPLAY = old-session.
     2925   END PROCEDURE.
     2926   .
