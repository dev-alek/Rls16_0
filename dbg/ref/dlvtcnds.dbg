     1265     if available X_deliv-type-cond-keep then do:
     1266   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1267   define variable v-str-recid14 as character no-undo .
     1268   define variable v-num-entry14 as integer   no-undo .
     1269   assign
     1270     v-str-recid14 = trim( string( recid( X_deliv-type-cond-keep ) , "->>>>>>>>>>>9":U ) )
     1271     v-num-entry14 = lookup( v-str-recid14 , v-rid-list )
     1272   .
     1273   if v-num-entry14 > 0 then do:
     1274     assign
     1275       entry( v-num-entry14, v-rid-list ) = "":U
     1276       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1277     .
     1278   end.
     1279   else do:
     1280     assign
     1281       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid14
     1282     .
     1283   end.
     1284       loc#log = br-delivtypecndk:refresh() .
     1285       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1286           loc#log = br-delivtypecndk:select-next-row ().
     1287           apply "VALUE-CHANGED" to br-delivtypecndk in frame Dialog-Frame.
     1288       end.
     1289       if num-entries( v-rid-list ) = 0
     1290       then
     1291           hide mark-num in frame Dialog-Frame.
     1292       else
     1293           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1294     end.
