     2942   PROCEDURE MyEnable :
     2943   ASSIGN
     2944   rs-sts:RADIO-BUTTONS IN FRAME Dialog-Frame
     2945                          = "Текущие&+" + chr(44) +  '0':U + chr(44) +
     2946                          "Все&!" + chr(44) + 'все':U + chr(44) +
     2947                           "Удаленные&-" + chr(44) + '1':U
     2948   rs-sts = (IF p-sts = ? THEN 'все':U ELSE string(p-sts))
     2949   .
