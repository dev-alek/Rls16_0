     2152             assign
     2153               v-object-handle :col = v-object-handle :col + p-change-value
     2154               no-error .
     2155             if error-status :error
     2156             or error-status :get-message(1) <> ""
     2157             then do:
     2158               undo move_block, retry move_block .
     2159             end.
     2160           end.
     2161         end.
     2162         for each buf_temp-browse-handle
     2163           where buf_temp-browse-handle.browse-type = 'width':u
     2164         on error undo move_block, retry move_block
     2165         :
     2166           assign
     2167             buf_temp-browse-handle.browse-handle :width
     2168               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2169             no-error .
     2170           if error-status :error
     2171           or error-status :get-message(1) <> ""
     2172           then do:
     2173             undo move_block, retry move_block .
     2174           end.
     2175         end.
     2176         assign
     2177           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2178           no-error .
     2179         if error-status :error
     2180         or error-status :get-message(1) <> ""
     2181         then do:
     2182           undo move_block, retry move_block.
     2183         end.
     2184         assign
     2185           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2186         no-error .
     2187         if error-status :error
     2188         or error-status :get-message(1) <> ""
     2189         then do:
     2190           undo move_block, retry move_block.
     2191         end.
     2192         if frame Dialog-Frame :scrollable = true
     2193         then do:
     2194           assign
     2195             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2196           no-error .
     2197           if error-status :error
     2198           or error-status :get-message(1) <> ""
     2199           then do:
     2200             undo move_block, retry move_block.
     2201           end.
     2202         end.
     2203       end.
     2204       if p-move-resize
     2205       then do:
     2206         run diasize_position-resize-button in this-procedure .
     2207       end.
     2208       if v-diasize-wndstore = true
     2209       then do:
     2210         if connected("ub") = true
     2211         then do:
     2212           define variable v-cntxt-db-num        as integer   no-undo .
     2213           define variable v-cntxt-userid        as character no-undo .
     2214           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2215                                             , OUTPUT v-cntxt-userid
     2216                                             ) .
     2217           run gbl/wndsizew.p
     2218             (input  v-cntxt-db-num
     2219             ,input  v-cntxt-userid
     2220             ,input  v-diasize-proc-name
     2221             ,input  'width':u
     2222             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2223             ) .
     2224         end.
     2225       end.
     2226     end.
     2227     assign
     2228       v-diasize-change-size = false
     2229     .
     2230   end procedure.
     2231   procedure diasize_set-width :
     2232     define input  parameter p-new-width  as decimal   no-undo .
     2233     define input  parameter p-move-resize as logical   no-undo .
     2234     do
     2235     on error undo, return error return-value
     2236     :
     2237       run diasize_change-width in this-procedure
     2238         (input  (p-new-width - frame Dialog-Frame :width)
     2239         ,input  p-move-resize
     2240         ) .
     2241     end.
     2242   end procedure.
     2243   procedure diasize_position-resize-button :
     2244     do with frame Dialog-Frame
     2245     :
     2246       hide v-diasize-resize-button .
     2247       assign
     2248         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2249                     - 1
     2250                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2251         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2252                     - 1
     2253                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2254       .
     2255       view v-diasize-resize-button .
     2256     end.
     2257   end procedure.
     2258   on alt-right anywhere
     2259   do:
     2260     run diasize_change-width in this-procedure
     2261       (input 1
     2262       ,input true
     2263       ) .
     2264     return no-apply .
     2265   end.
     2266   on alt-left anywhere
     2267   do:
     2268     run diasize_change-width in this-procedure
     2269       (input -1
     2270       ,input true
     2271       ) .
     2272     return no-apply .
     2273   end.
     2274   on alt-down anywhere
     2275   do:
     2276     run diasize_change-height in this-procedure
     2277       (input 1
     2278       ,input true
     2279       ) .
     2280     return no-apply .
     2281   end.
     2282   on alt-up anywhere
     2283   do:
     2284     run diasize_change-height in this-procedure
     2285       (input -1
     2286       ,input true
     2287       ) .
     2288     return no-apply .
     2289   end.
     2290   on alt-enter of frame Dialog-Frame
     2291   do:
     2292     run diasize_maximize in this-procedure
     2293       (input  ?
     2294       ).
     2295     return no-apply .
     2296   end.
     2297   procedure diasize_end-move :
     2298     do
     2299     on error undo, return error return-value
     2300     :
     2301       define variable v-row-delta as decimal   no-undo .
     2302       define variable v-col-delta as decimal   no-undo .
     2303       define variable v-new-row as decimal   no-undo .
     2304       define variable v-new-col as decimal   no-undo .
     2305       assign
     2306         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2307         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2308       .
     2309       assign
     2310         v-row-delta = v-new-row - frame Dialog-Frame :height
     2311         v-col-delta = v-new-col - frame Dialog-Frame :width
     2312       .
     2313       run diasize_change-height in this-procedure
     2314         (input v-row-delta
     2315         ,input true
     2316         ) .
     2317       run diasize_change-width in this-procedure
     2318         (input v-col-delta
     2319         ,input true
     2320         ) .
     2321     end.
     2322   end procedure.
     2323   procedure diasize_maximize :
     2324     define input  parameter p-action as logical   no-undo .
     2325     do
     2326     on error undo, return error return-value
     2327     :
     2328       if p-action = ?
     2329       then do:
     2330         if v-diasize-need-maximize = true
     2331         then do:
     2332           assign
     2333             p-action = true
     2334           .
     2335         end.
     2336         else do:
     2337           assign
     2338             p-action = false
     2339           .
     2340         end.
     2341       end.
     2342       if p-action = true
     2343       then do:
     2344         run diasize_change-height in this-procedure
     2345           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2346               - frame Dialog-Frame :height-chars
     2347           ,input true
     2348           ) .
     2349         run diasize_change-width in this-procedure
     2350           (input session :width-chars
     2351               - frame Dialog-Frame :width-chars
     2352           ,input true
     2353           ) .
     2354         assign
     2355           v-diasize-need-maximize = false
     2356         .
     2357       end.
     2358       else do:
     2359         run diasize_change-width in this-procedure
     2360           (input v-diasize-orig-frame-width
     2361               - frame Dialog-Frame :width-chars
     2362           ,input true
     2363           ) .
     2364         run diasize_change-height in this-procedure
     2365           (input v-diasize-orig-frame-height
     2366               - frame Dialog-Frame :height-chars
     2367           ,input true
     2368           ) .
     2369         assign
     2370           v-diasize-need-maximize = true
     2371         .
     2372       end.
     2373     end.
     2374   end procedure.
     2375   procedure diasize_restore-orig-size :
     2376     do
     2377     on error undo, return error return-value
     2378     :
     2379       assign
     2380         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2381         v-diasize-current-frame-height = frame Dialog-Frame :height
     2382       .
     2383       run diasize_set-height in this-procedure
     2384         (input  v-diasize-orig-frame-height
     2385         ,input  true
     2386         ) .
     2387       run diasize_set-width in this-procedure
     2388         (input  v-diasize-orig-frame-width
     2389         ,input  true
     2390         ) .
     2391     end.
     2392   end procedure.
     2393   procedure diasize_restore-current-size :
     2394     do
     2395     on error undo, return error return-value
     2396     :
     2397       run diasize_set-height in this-procedure
     2398         (input  v-diasize-current-frame-height
     2399         ,input  true
     2400         ) .
     2401       run diasize_set-width in this-procedure
     2402         (input  v-diasize-current-frame-width
     2403         ,input  true
     2404         ) .
     2405     end.
     2406   end procedure.
     2407   procedure diasize_set-browse-handle :
     2408     define input  parameter p-browse-handle as handle   no-undo .
     2409     define buffer buf_temp-browse-handle for temp-browse-handle .
     2410     do
     2411     on error undo, return error return-value
     2412     :
     2413       assign
     2414         v-diasize-browse-handle = p-browse-handle
     2415       .
     2416       for each buf_temp-browse-handle
     2417       on error undo, return error return-value
     2418       :
     2419         delete buf_temp-browse-handle .
     2420       end.
     2421     end.
     2422   end procedure.
     2423   procedure diasize_add_browse :
     2424     define input  parameter p-browse-type   as character no-undo .
     2425     define input  parameter p-browse-handle as handle    no-undo .
     2426     define buffer buf_temp-browse-handle for temp-browse-handle .
     2427     do
     2428     on error undo, return error return-value
     2429     :
     2430       assign
     2431         v-diasize-browse-number = v-diasize-browse-number + 1
     2432       .
     2433       create buf_temp-browse-handle .
     2434       assign
     2435         buf_temp-browse-handle.browse-type   = p-browse-type
     2436         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2437         buf_temp-browse-handle.browse-handle = p-browse-handle
     2438       .
     2439     end.
     2440   end procedure.
     2441   procedure diasize_init :
     2442     define variable v-default-value    as logical   no-undo .
     2443     define variable v-restore-saved    as logical   no-undo .
     2444     define variable v-resize-value-str as character no-undo .
     2445     do
     2446     on error undo, return error return-value
     2447     :
     2448       do with frame Dialog-Frame
     2449       :
     2450         assign
     2451           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2452           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2453           v-diasize-browse-handle     = browse br-delivtypecndk :handle
     2454         .
     2455         create button v-diasize-resize-button
     2456         assign
     2457           parent        = frame Dialog-Frame :first-child
     2458           label         = "s"
     2459           height-pixels = 16
     2460           width-pixels  = 16
     2461           visible       = true
     2462           sensitive     = true
     2463           movable       = true
     2464           triggers:
     2465             on end-move persistent run diasize_end-move in this-procedure .
     2466           end triggers.
     2467         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2468         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2469         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2470         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2471         assign
     2472           v-diasize-wndmax = false
     2473         .
     2474         if connected("ub") = true
     2475         then do:
     2476           define variable v-cntxt-db-num        as integer   no-undo .
     2477           define variable v-cntxt-userid        as character no-undo .
     2478           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2479                                             , OUTPUT v-cntxt-userid
     2480                                             ) .
     2481           run gbl/wndpar_r.p
     2482             (input  v-cntxt-db-num
     2483             ,input  v-cntxt-userid
     2484             ,input  'wndmax':U
     2485             ,output v-diasize-wndmax
     2486             ,output v-default-value
     2487             ) .
     2488         end.
     2489         assign
     2490           v-diasize-wndstore = false
     2491         .
     2492         if connected("ub") = true
     2493         then do:
     2494           run gbl/wndpar_r.p
     2495             (input  v-cntxt-db-num
     2496             ,input  v-cntxt-userid
     2497             ,input  'wndstore':U
     2498             ,output v-diasize-wndstore
     2499             ,output v-default-value
     2500             ) .
     2501         end.
     2502         assign
     2503           v-diasize-proc-name = entry(1, program-name(2), '.')
     2504         .
     2505         if v-diasize-wndstore = true
     2506         then do:
     2507           assign
     2508             v-restore-saved = false
     2509           .
     2510           if connected("ub") = true
     2511           then do:
     2512             run gbl/wndsizer.p
     2513               (input  v-cntxt-db-num
     2514               ,input  v-cntxt-userid
     2515               ,input  v-diasize-proc-name
     2516               ,input  'height':u
     2517               ,output v-resize-value-str
     2518               ) .
     2519             if v-resize-value-str <> '':U
     2520             then do:
     2521               run diasize_change-height in this-procedure
     2522                 (input  integer(v-resize-value-str)
     2523                 ,input  true
     2524                 ) .
     2525               assign
     2526                 v-restore-saved = true
     2527               .
     2528             end.
     2529           end.
     2530           if connected("ub") = true
     2531           then do:
     2532             run gbl/wndsizer.p
     2533               (input  v-cntxt-db-num
     2534               ,input  v-cntxt-userid
     2535               ,input  v-diasize-proc-name
     2536               ,input  'width':u
     2537               ,output v-resize-value-str
     2538               ) .
     2539             if v-resize-value-str <> '':U
     2540             then do:
     2541               run diasize_change-width in this-procedure
     2542                 (input  integer(v-resize-value-str)
     2543                 ,input  true
     2544                 ) .
     2545               assign
     2546                 v-restore-saved = true
     2547               .
     2548             end.
     2549           end.
     2550           if v-restore-saved <> true
     2551           then do:
     2552             if v-diasize-wndmax = true
     2553             then do:
     2554               run diasize_maximize in this-procedure
     2555                 (input  true
     2556                 ) .
     2557             end.
     2558           end.
     2559         end.
     2560         else do:
     2561           if v-diasize-wndmax = true
     2562           then do:
     2563             run diasize_maximize in this-procedure
     2564               (input  true
     2565               ) .
     2566           end.
     2567         end.
     2568       end.
     2569     end.
     2570   end procedure.
     2571   procedure diasize_need-full-display :
     2572     define output parameter p-need-full-display as logical   no-undo .
     2573     do
     2574     on error undo, return error return-value
     2575     :
     2576       assign
     2577         p-need-full-display = v-diasize-need-full-display
     2578       .
     2579       assign
     2580         v-diasize-need-full-display = false
     2581       .
     2582     end.
     2583   end procedure.
     2584   procedure get-context :
     2585      define output parameter p-db-num as integer          no-undo.
     2586      define output parameter p-user-id as character        no-undo.
     2587      define variable v-login               as character    no-undo.
     2588      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2589      define buffer buf_user-login  for ub.user-login .
     2590      do
     2591      on error undo, return error
     2592      :
     2593            FIND FIRST buf_sys-ctrl no-lock.
     2594            ASSIGN
     2595               v-login = USERID("ub")
     2596               p-db-num = buf_sys-ctrl.db-num
     2597            .
     2598            FIND FIRST buf_user-login
     2599                 WHERE buf_user-login.db-num = p-db-num
     2600                   AND buf_user-login.user-login = v-login
     2601                 no-lock
     2602                 no-error
     2603                 .
     2604            IF AVAILABLE buf_user-login
     2605            THEN DO:
     2606               assign
     2607                  p-user-id = buf_user-login.user-id
     2608               .
     2609            END.
     2610      end.
     2611   end procedure.
     2612       run diasize_init in this-procedure .
     2613   def var sort-labelbr-delivtypecndk   as character no-undo .
     2614   def var sort-clmnbr-delivtypecndk    as handle    no-undo .
     2615   def var cur-clmnbr-delivtypecndk     as handle    no-undo .
     2616   def var cur-clmn-locbr-delivtypecndk as integer   no-undo .
     2617   def var re-querybr-delivtypecndk     as logical   initial no no-undo .
     2618   on start-search, ctrl-o of br-delivtypecndk in frame Dialog-Frame do:
     2619      run sort-brbr-delivtypecndk
     2620        (input (if available X_deliv-type-cond-keep
     2621                then recid(X_deliv-type-cond-keep)
     2622                else ?
     2623               )
     2624        ).
     2625   end.
     2626   PROCEDURE sort-brbr-delivtypecndk :
     2627     define input parameter p-recid as recid no-undo .
     2628     if re-querybr-delivtypecndk = no then do:
     2629       assign
     2630          cur-clmnbr-delivtypecndk = br-delivtypecndk:current-column in frame Dialog-Frame
     2631       .
     2632       if sort-clmnbr-delivtypecndk <> ? then sort-clmnbr-delivtypecndk:column-fgcolor = 0.
     2633       if cur-clmnbr-delivtypecndk = sort-clmnbr-delivtypecndk then do:
     2634         assign
     2635            sort-labelbr-delivtypecndk = ""
     2636            sort-clmnbr-delivtypecndk = ?
     2637         .
     2638        end.
     2639        else do:
     2640          assign
     2641            sort-labelbr-delivtypecndk = cur-clmnbr-delivtypecndk:label
     2642            sort-clmnbr-delivtypecndk  = cur-clmnbr-delivtypecndk
     2643            sort-clmnbr-delivtypecndk:column-fgcolor = 4
     2644          .
     2645        end.
     2646      end.
     2647     assign
     2648       cur-clmn-locbr-delivtypecndk = 1
     2649     .
     2650     def var column-handle as handle no-undo .
     2651     column-handle = br-delivtypecndk:first-column.
     2652     do while valid-handle(column-handle) :
     2653       if column-handle = cur-clmnbr-delivtypecndk then do:
     2654         leave .
     2655       end.
     2656       column-handle = column-handle:NEXT-COLUMN.
     2657       assign
     2658         cur-clmn-locbr-delivtypecndk = cur-clmn-locbr-delivtypecndk + 1
     2659       .
     2660     end.
     2661     case sort-labelbr-delivtypecndk:
     2662           when X_deliv-type-cond-keep.deliv-type-code:label in browse br-delivtypecndk then DO:    assign       sort-column-name = "X_deliv-type-cond-keep.deliv-type-code"     .     run OpenBr in this-procedure ( input yes, input no, input '':U).   . END.
     2663       otherwise do:
     2664         assign
     2665           sort-column-name = ""
     2666         .
     2667         run OpenBr in this-procedure ( input yes, input no, input '':U).
     2668           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-delivtypecndk') then do:
     2669             run mv-brw-defaultbr-delivtypecndk.
     2670           end.
     2671         if sort-labelbr-delivtypecndk <> "" then do:
     2672           assign
     2673             cur-clmnbr-delivtypecndk:column-fgcolor = 0
     2674           .
     2675         end.
     2676         assign
     2677           cur-clmn-locbr-delivtypecndk = ?
     2678         .
     2679       end.
     2680     end case.
     2681       if cur-clmn-locbr-delivtypecndk <> ? then do:
     2682         if can-do( this-procedure:internal-entries, 'ch-clmnbr-delivtypecndk') then do:
     2683           run ch-clmnbr-delivtypecndk in this-procedure (cur-clmn-locbr-delivtypecndk).
     2684         end.
     2685       end.
     2686     if p-recid <> ? then do:
     2687       reposition br-delivtypecndk to recid p-recid no-error.
     2688       apply "value-changed" to br-delivtypecndk in frame Dialog-Frame.
     2689     end.
     2690     apply "entry" to br-delivtypecndk in frame Dialog-Frame.
     2691   END PROCEDURE.
     2692   procedure re-open-query-srt-clmnbr-delivtypecndk:
     2693   if cur-clmnbr-delivtypecndk = ? then do:
     2694      run OpenBr in this-procedure ( input yes, input no, input '':U).
     2695   end.
     2696   else do:
     2697      assign re-querybr-delivtypecndk = yes.
     2698      run sort-brbr-delivtypecndk
     2699        (input (if available X_deliv-type-cond-keep
     2700                then recid(X_deliv-type-cond-keep)
     2701                else ?
     2702               )
     2703        ).
     2704      assign re-querybr-delivtypecndk = no.
     2705   end.
     2706   end.
     2707   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2708   do:
     2709     br-delivtypecndk :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2710   end.
     2711   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2712   procedure set-filter-name :
     2713   define input parameter p-filter-name as character no-undo .
     2714     do with frame Dialog-Frame:
     2715       if p-filter-name > "" then do:
     2716         assign
     2717           frame Dialog-Frame:title
     2718             = frame Dialog-Frame:title + "   ФИЛЬТР: " + p-filter-name.
     2719         .
     2720         assign
     2721           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2722         .
     2723       end.
     2724       else do:
     2725         assign
     2726           b-sch :tooltip = ""
     2727         .
     2728       end.
     2729     end.
     2730   end procedure.
     2731   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2732   on INS of frame Dialog-Frame anywhere do:
