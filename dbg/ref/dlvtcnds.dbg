     2951   WITH FRAME Dialog-Frame.
     2952   ENABLE
     2953   b-quit
     2954   B-mark when LOOKUP("b-mark":U, bttns) > 0
     2955   B-sel when LOOKUP("b-sel":U, bttns) > 0
     2956   B-add when LOOKUP("b-add":U, bttns) > 0 and v-db-num = 0
     2957   b-lkp
     2958   B-chg when LOOKUP("b-add":U, bttns) > 0 and v-db-num = 0
     2959   B-del when LOOKUP("b-add":U, bttns) > 0 and v-db-num = 0
     2960   B-print
     2961   B-Help
     2962   B-hist
     2963   b-sch
     2964   br-delivtypecndk
     2965       mark-num
     2966       rs-sts
     2967   with FRAME Dialog-Frame.
     2968   VIEW FRAME Dialog-Frame.
