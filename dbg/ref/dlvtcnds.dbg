     1335   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1336   on help of frame Dialog-Frame
     1337   do:
     1338     run gbl/app_help.p
     1339       (input this-procedure :file-name
     1340       ,input ''
     1341       ,input ?
     1342       ) no-error.
     1343     if error-status :error then do:
     1344       message
     1345         "Ошибка при вызове помощи"
     1346         error-status :get-message(1)
     1347         view-as alert-box .
     1348     end.
     1349   end.
     1350   run minbtn-set in this-procedure .
     1351   on choose of b-help in frame Dialog-Frame
     1352   do:
     1353     apply "help":u to frame Dialog-Frame .
     1354   end.
     1355   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1356   procedure minbtn-set :
     1357       do
     1358           on error undo, return error return-value
     1359           :
     1360           define variable ii              as integer       no-undo .
     1361           define variable fh              as widget-handle no-undo .
     1362           define variable hh              as widget-handle no-undo .
     1363           define variable v-h             as handle        extent 4 no-undo .
     1364           define variable v-name-button   as character     no-undo .
     1365           define variable v-help-old-x    as decimal       no-undo .
     1366           define variable v-help-old-y    as decimal       no-undo .
     1367           define variable v-help-old-size as decimal       no-undo .
     1368           define variable v-frame-width   as decimal       no-undo .
     1369           define variable jj              as integer       no-undo .
     1370           do
     1371               on error undo, return error
     1372               :
     1373               assign
     1374                   v-frame-width = frame Dialog-Frame:width - 0.3
     1375                   fh            = frame Dialog-Frame:first-child
     1376                   hh            = fh:first-child
     1377                   ii            = 1
     1378                   .
     1379               do while valid-handle(hh):
     1380                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1381                   do:
     1382                       case lc(hh:name) :
     1383                           when "b-help" then
     1384                               do:
     1385                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1386                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1387                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1388                                   hh:TOOLTIP = "Помощь" .
     1389                                   v-help-old-x = hh:column .
     1390                                   v-help-old-y = hh:row    .
     1391                                   v-help-old-size = hh:width .
     1392                                   hh:width-chars = 2.5 .
     1393                               end.
     1394                           when "b-print" then
     1395                               do:
     1396                                   hh:load-image("cmp/b-print.bmp":u) .
     1397                                   hh:TOOLTIP = "Печать" .
     1398                                   v-h[ii] = hh:handle .
     1399                                   ii = ii + 1 .
     1400                                   hh:width-chars = 3 .
     1401                               end.
     1402                           when "b-history" or
     1403                           when "b-hist" then
     1404                               do:
     1405                                   hh:load-image("cmp/b-hist.bmp":u) .
     1406                                   hh:TOOLTIP = "История" .
     1407                                   v-h[ii] = hh:handle .
     1408                                   ii = ii + 1 .
     1409                                   hh:width-chars = 3 .
     1410                               end.
     1411                           when "b-sch" then
     1412                               do:
     1413                                   hh:load-image("cmp/b-sch.bmp":u) .
     1414                                   hh:TOOLTIP = "Установка Фильтра" .
     1415                                   v-h[ii] = hh:handle .
     1416                                   ii = ii + 1 .
     1417                                   hh:width-chars = 3 .
     1418                               end.
     1419                           when "b-hist-user" then
     1420                               do:
     1421                                   hh:load-image("cmp/b-hist.bmp":u) .
     1422                                   hh:TOOLTIP = "История пользователя" .
     1423                                   ii = ii + 1 .
     1424                               end.
     1425                       end case.
     1426                   end.
     1427                   hh = hh:next-sibling.
     1428               end.
     1429               b-help:column = v-frame-width - b-help:width-chars.
     1430               jj = 0.
     1431               repeat ii = 4 to 1 by -1 :
     1432                   if valid-handle (v-h[ii] ) then
     1433                   do:
     1434                       jj  = jj + 1 .
     1435                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1436                       v-h[ii]:row    = v-help-old-y .
     1437                   end.
     1438               end.
     1439           end.
     1440       end.
     1441   end procedure.
     1442   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1443   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1444   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1445   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1446   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1447   define variable v-diasize-current-frame-height as decimal   no-undo .
     1448   define variable v-diasize-change-size          as logical   no-undo .
     1449   define variable v-diasize-resize-button        as handle    no-undo .
     1450   define variable v-diasize-wndmax               as logical   no-undo .
     1451   define variable v-diasize-wndstore             as logical   no-undo .
     1452   define variable v-diasize-proc-name            as character no-undo .
     1453   define variable v-diasize-browse-handle        as handle    no-undo .
     1454   define variable v-diasize-browse-number        as integer   no-undo .
     1455   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1456   define temp-table temp-diasize-handle no-undo
     1457     field handle-value  as handle
     1458     field save-position as decimal
     1459     index xpk is primary unique handle-value
     1460     .
     1461   define temp-table temp-browse-handle no-undo
     1462     field browse-type   as character
     1463     field browse-number as integer
     1464     field browse-handle as handle
     1465     field original-size as decimal
     1466     index xpk is primary unique browse-type browse-number
     1467     index xie browse-type browse-handle
     1468   .
     1469   procedure diasize_change-height :
     1470     define input  parameter p-change-value  as decimal   no-undo .
     1471     define input  parameter p-move-resize   as logical   no-undo .
     1472     define variable v-field-group-handle    as handle    no-undo .
     1473     define variable v-object-handle         as handle    no-undo .
     1474     define variable v-frame-height          as decimal   no-undo .
     1475     define variable v-frame-virtual-height  as decimal   no-undo .
     1476     define variable v-browse-height         as decimal   no-undo .
     1477     define variable v-window-height         as decimal   no-undo .
     1478     define variable v-window-virtual-height as decimal   no-undo .
     1479     define variable v-change-sign           as integer   no-undo .
     1480     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1481     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1482     if p-change-value > 0
     1483     then do:
     1484       if frame Dialog-Frame :height + p-change-value
     1485           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1486       then do:
     1487         assign
     1488           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1489                           - (frame Dialog-Frame :height-chars)
     1490         .
     1491         if p-change-value <= 0
     1492         then do:
     1493           run diasize_position-resize-button in this-procedure .
     1494           return .
     1495         end.
     1496       end.
     1497     end.
     1498     if p-change-value < 0
     1499     then do:
     1500       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1501       then do:
     1502         assign
     1503           p-change-value = v-diasize-orig-frame-height
     1504                          - (frame Dialog-Frame :height-chars)
     1505         .
     1506         if p-change-value >= 0
     1507         then do:
     1508           run diasize_position-resize-button in this-procedure .
     1509           return .
     1510         end.
     1511       end.
     1512     end.
     1513     if p-change-value >= 0
     1514     then do:
     1515       assign
     1516         v-change-sign = 1
     1517       .
     1518     end.
     1519     else do:
     1520       assign
     1521         v-change-sign = -1
     1522       .
     1523     end.
     1524     assign
     1525       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1526     .
     1527     if p-change-value = 0
     1528     then do:
     1529       run diasize_position-resize-button in this-procedure .
