     1080         mark-string(recid(X_deliv-type-cond-keep), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1081         X_deliv-type-cond-keep.deliv-type-code COLUMN-LABEL "Вн.код!типа!доставки" FORMAT ">>9":U
     1082         get-type(X_deliv-type-cond-keep.deliv-type-code) COLUMN-LABEL "Тип доставки" FORMAT "X(25)":U
     1083         X_deliv-type-cond-keep.cond-keep-code COLUMN-LABEL "Вн.код!условий!хранения" FORMAT ">>9":U
     1084         get-cond-keep(X_deliv-type-cond-keep.cond-keep-code) COLUMN-LABEL "Условия хранения" FORMAT "X(25)":U
