     4208   DEFINE FRAME deliv-type-cond-keep-list
     4209   v-sts-chr FORMAT "X(8)" COLUMN-LABEL "Статус"
     4210   X_deliv-type-cond-keep.deliv-type-code COLUMN-LABEL "Вн.код!типа дост-ки"
     4211   v-deliv-type-name COLUmn-LABEL "Тип доставки" format "X(25)"
     4212   X_deliv-type-cond-keep.cond-keep-code COLUMN-LABEL "Вн.код!условий!хранения"
     4213   v-cond-keep-name COLUmn-LABEL "Условия хранения" format "X(25)"
     4214   X_deliv-type-cond-keep.des FORMAT "X(100)"
     4215   HEADER  date_string AT 5 format "X(35)"
     4216    string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     4217   Line format "X(195)" AT 1
     4218   with width 232 down stream-io use-text    .
     4219   Line = fill("-", 195).
     4220   date_string = cur-time-print() .
     4221   run prn-lib-open-stream  in this-procedure (
     4222                                                input parParentProc
     4223                                               ,input 43
     4224                                               ,input yes
     4225                                               ,input no
     4226                                               ).
     4227   PUT  STREAM PrnLibStream
     4228   SPACE(25) ( frame Dialog-Frame:title )
     4229   format "x(90)" SKIP(1) .
     4230   FORM HEADER
     4231   Line format "X(195)" AT 1 SKIP
     4232   "Продолжение - на следующей странице" AT 30 SKIP
     4233   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     4234   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     4235   FORM with FRAME deliv-type-cond-keep-list  .
     4236   run waitfram-show in this-procedure ("Ждите...").
     4237   v-doc-rec = recid(X_deliv-type-cond-keep).
     4238   DO WHILE available X_deliv-type-cond-keep :
     4239     GET prev br-delivtypecndk.
     4240   END.
     4241   GET next br-delivtypecndk.
     4242   DO WHILE available X_deliv-type-cond-keep :
     4243     Display STREAM PrnLibStream
     4244     entry (lookup (STRING(p-sts), '0,1,50,99':U), 'тек,удал,блок,удаление':U) @ v-sts-chr
     4245     X_deliv-type-cond-keep.deliv-type-code
     4246     get-type(X_deliv-type-cond-keep.deliv-type-code) @ v-deliv-type-name
     4247     X_deliv-type-cond-keep.cond-keep-code
     4248     get-cond-keep(X_deliv-type-cond-keep.cond-keep-code) @ v-cond-keep-name
     4249     X_deliv-type-cond-keep.des
     4250   with FRAME deliv-type-cond-keep-list .
     4251     DOWN STREAM PrnLibStream 1
     4252     with FRAME deliv-type-cond-keep-list  .
     4253     assign
     4254     accum-count = accum-count + 1
     4255     .
     4256     GET next br-delivtypecndk.
     4257   END.
     4258   UNDERLINE  STREAM PrnLibStream
     4259   v-sts-chr
     4260   X_deliv-type-cond-keep.deliv-type-code
     4261   v-deliv-type-name
     4262   X_deliv-type-cond-keep.cond-keep-code
     4263   v-cond-keep-name
     4264   X_deliv-type-cond-keep.des
     4265   with FRAME deliv-type-cond-keep-list .
     4266   DISPLAY STREAM PrnLibStream
     4267   "ИТОГО" @ v-deliv-type-name
     4268   accum-count @ v-sts-chr
     4269   with frame deliv-type-cond-keep-list.
     4270   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     4271   HIDE  STREAM PrnLibStream FRAME deliv-type-cond-keep-List.
     4272   output  STREAM PrnLibStream CLOSE.
     4273   REPOSITION br-delivtypecndk to recid v-doc-rec no-error.
     4274   APPLY "entry" to br-delivtypecndk.
     4275   run waitfram-hide in this-procedure .
     4276   run prn-lib-prn-file in this-procedure (
     4277                                             input parParentProc
     4278                                             ,input 8
     4279                                             ).
     4280   END PROCEDURE.
     4281   PROCEDURE proc-b-sch :
     4282   assign
     4283     tbl = 'deliv-type-cond-keep'
     4284     join-tbl = 'X_deliv-type-cond-keep'
     4285     fld = ""
     4286     lab = ""
     4287     spr = ""
     4288     dim = '0'
     4289     .
     4290   run fltfield-add in this-procedure('deliv-type-code', 'Код типа доставки', '',
     4291   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4292   run fltfield-add in this-procedure('cond-keep-code', 'Код условий хранения', '',
     4293   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4294   run fltfield-add in this-procedure('des', 'Описание', '',
     4295   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4296   run fltfield-add in this-procedure('sts', 'Статус', '',
     4297   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4298   Filter-Block:
     4299   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4300       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4301       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4302     run gbl/filter.w ( INPUT parparentproc
     4303                      , INPUT filter-point
     4304                      , INPUT tbl
     4305                      , INPUT join-tbl
     4306                      , INPUT fld
     4307                      , INPUT lab
     4308                      , INPUT spr
     4309                      , INPUT dim ).
     4310     RUN OpenBr in this-procedure ( input yes, input no, input '':U).
     4311   END.
     4312   END PROCEDURE.
     4313   PROCEDURE proc-br-delivtypecndk :
     4314   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4315   if b-sel:sensitive in frame Dialog-Frame then dO:
     4316       if b-mark:sensitive then do:
     4317           apply "choose" to b-mark in frame Dialog-Frame.
     4318       end.
     4319       else do:
     4320           apply "choose" to b-sel in frame Dialog-Frame.
     4321       end.
     4322   end.
     4323   else do:
     4324       if b-lkp:sensitive then
     4325       apply "choose" to b-lkp in frame Dialog-Frame.
     4326   end.
     4327   END PROCEDURE.
     4328   FUNCTION get-cond-keep RETURNS CHARACTER
     4329     ( INPUT p-cond-keep-code AS INTEGER) :
     4330   DEFINE BUFFER loc_condition-keeping FOR ub.condition-keeping.
     4331   FIND FIRST loc_condition-keeping NO-LOCK WHERE
     4332             loc_condition-keeping.cond-keep-code = p-cond-keep-code NO-ERROR.
     4333   IF AVAILABLE loc_condition-keeping THEN RETURN loc_condition-keeping.cond-keep-name.
     4334     RETURN "Неизв.условия хранения".
     4335   END FUNCTION.
     4336   FUNCTION get-type RETURNS CHARACTER
     4337   ( INPUT p-deliv-type-code AS INTEGER) :
     4338   DEFINE BUFFER loc_delivery-type FOR ub.delivery-type.
     4339   FIND FIRST loc_delivery-type NO-LOCK WHERE
     4340             loc_delivery-type.deliv-type-code = p-deliv-type-code NO-ERROR.
     4341   IF AVAILABLE loc_delivery-type THEN RETURN loc_delivery-type.deliv-type-name.
     4342     RETURN "Неизв.тип доставки".
     4343   END FUNCTION.
