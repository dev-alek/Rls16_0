     1864     define variable v-window-width         as decimal   no-undo .
     1865     define variable v-window-virtual-width as decimal   no-undo .
     1866     define variable v-change-sign          as integer   no-undo .
     1867     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1868     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1869     if p-change-value > 0
     1870     then do:
     1871       if frame Dialog-Frame :width + p-change-value >
     1872           session :width-chars
     1873       then do:
     1874         assign
     1875           p-change-value = session :width-chars - frame Dialog-Frame :width
     1876         .
     1877         if p-change-value <= 0
     1878         then do:
     1879           run diasize_position-resize-button in this-procedure .
     1880           return .
     1881         end.
     1882       end.
     1883     end.
     1884     if p-change-value < 0
     1885     then do:
     1886       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1887       then do:
     1888         assign
     1889           p-change-value = v-diasize-orig-frame-width
     1890                          - frame Dialog-Frame :width
     1891         .
     1892         if p-change-value >= 0
     1893         then do:
     1894           run diasize_position-resize-button in this-procedure .
     1895           return .
     1896         end.
     1897       end.
     1898     end.
     1899     if p-change-value >= 0
     1900     then do:
     1901       assign
     1902         v-change-sign = 1
     1903       .
     1904     end.
     1905     else do:
     1906       assign
     1907         v-change-sign = -1
     1908       .
     1909     end.
     1910     assign
     1911       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1912     .
     1913     if p-change-value = 0
     1914     then do:
     1915       run diasize_position-resize-button in this-procedure .
     1916       return .
     1917     end.
