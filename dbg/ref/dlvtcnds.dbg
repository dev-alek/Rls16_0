     1844   procedure diasize_set-height :
     1845     define input  parameter p-new-height  as decimal   no-undo .
     1846     define input  parameter p-move-resize as logical   no-undo .
     1847     do
     1848     on error undo, return error return-value
     1849     :
     1850       run diasize_change-height in this-procedure
     1851         (input  (p-new-height - frame Dialog-Frame :height)
     1852         ,input  p-move-resize
     1853         ) .
     1854     end.
     1855   end procedure.
     1856   procedure diasize_change-width :
     1857     define input  parameter p-change-value as decimal   no-undo .
     1858     define input  parameter p-move-resize  as logical   no-undo .
     1859     define variable v-field-group-handle   as handle    no-undo .
     1860     define variable v-object-handle        as handle    no-undo .
