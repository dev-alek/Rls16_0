      794   procedure fltfield-clear :
      795     define output parameter loc-fld as character no-undo.
      796     define output parameter loc-lab as character no-undo .
      797     define output parameter loc-spr as character no-undo .
      798     define output parameter loc-dim as character no-undo .
      799     assign
      800       loc-fld = ""
      801       loc-lab = ""
      802       loc-spr = ""
      803       loc-dim = "0"
      804     .
      805   end procedure .
      806   procedure fltfield-add :
      807     define input        parameter par-fld as character no-undo.
      808     define input        parameter par-lab as character no-undo .
      809     define input        parameter par-spr as character no-undo .
      810     define input-output parameter loc-fld as character no-undo.
      811     define input-output parameter loc-lab as character no-undo .
      812     define input-output parameter loc-spr as character no-undo .
      813     define input-output parameter loc-dim as character no-undo .
      814     do
      815     on error undo, return error
      816     :
      817       assign
      818       loc-fld = if loc-dim = '0'
      819                 then par-fld
      820                 else (loc-fld + chr(44) + par-fld)
      821       loc-lab = if loc-dim = '0'
      822                 then par-lab
      823                 else (loc-lab + chr(44) + par-lab)
      824       loc-spr = if loc-dim = '0'
      825                 then par-spr
      826                 else (loc-spr + chr(44) + par-spr)
      827       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      828                 string(integer(if num-entries(loc-dim) > 1
      829                               then entry(2, loc-dim)
      830                               else entry(1, loc-dim)
      831                               ) + 1)
      832       no-error
      833       .
      834     end.
      835   end procedure.
