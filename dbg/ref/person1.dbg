       24   define input parameter p-inn             as character no-undo .
       25   define input parameter p-no-check-inn    as logical                    no-undo .
       26   define input parameter p-is-pboul        as logical no-undo .
       27   define input parameter p-kpp             as character no-undo .
       28   define input parameter p-name1           as character no-undo .
       29   define input parameter p-name2           as character no-undo .
       30   define input parameter p-okonh           as character no-undo .
       31   define input parameter p-okpo            as character no-undo .
       32   define input parameter p-passp-num       as character no-undo .
       33   define input parameter p-passp-ser       as character no-undo .
       34   define input parameter p-phone1          as character no-undo .
       35   define input parameter p-phone1-note     as character no-undo .
       36   define input parameter p-position        as character no-undo .
       37   define input parameter p-post-box        as character no-undo .
       38   define input parameter p-post-address    as character no-undo .
       39   define input parameter p-post-city       as character no-undo .
       40   define input parameter p-post-ind        as integer no-undo .
       41   define input parameter p-reg-code           like ub.clients.reg-code            no-undo .
       42   define input parameter p-turnover-buyer     like ub.clients.turnover-buyer      no-undo .
       43   define input parameter p-turnover-buyer-gds like ub.clients.turnover-buyer-gds  no-undo .
       44   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       45   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       46   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       47   define variable vss-workfile    as character no-undo init "$Workfile: person1.p $":U .
       48   define variable vss-archive     as character no-undo init "$Archive: ref/person1.p $":U .
       49   define variable vss-description as character no-undo init "Сохранение изменений в карточке человека".
       50   procedure vss-get-info :
       51     define output parameter p-vss-revision    like vss-revision    no-undo .
       52     define output parameter p-vss-author      like vss-author      no-undo .
       53     define output parameter p-vss-date        like vss-date        no-undo .
       54     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       55     define output parameter p-vss-archive     like vss-archive     no-undo .
       56     define output parameter p-vss-description like vss-description no-undo .
       57     assign
       58       p-vss-revision    = vss-revision
       59       p-vss-author      = vss-author
       60       p-vss-date        = vss-date
       61       p-vss-workfile    = vss-workfile
       62       p-vss-archive     = vss-archive
       63       p-vss-description = vss-description
       64     .
       65   end procedure.
       66   procedure vss-get-parameters :
       67     define output parameter p-vss-parameters as character no-undo .
       68   end procedure.
       69   define new global shared variable g#vssrevis-logger as handle    no-undo .
       70   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       71   define variable v-vssrevis-logger                   as handle    no-undo .
       72   procedure vss-logevent :
       73     define input  parameter p-extra-paramters as character no-undo .
       74     define variable v-vssrevis-parameters as character no-undo .
       75     do
       76     on error undo, return error return-value
       77     :
       78       if  valid-handle(v-vssrevis-logger)
       79       and v-vssrevis-logger :get-signature("logevent") <> ""
       80       then do:
       81         run vss-get-parameters in this-procedure
       82           (output v-vssrevis-parameters
       83           ).
       84         run logevent in v-vssrevis-logger
       85           (input vss-workfile
       86           ,input vss-revision
       87           ,input v-vssrevis-parameters
       88           ,input p-extra-paramters
       89           ).
       90       end.
       91     end.
       92   end procedure.
       93   assign
       94     v-vssrevis-logger = g#vssrevis-logger
       95   .
       96   if  valid-handle(v-vssrevis-logger)
       97   and v-vssrevis-logger :get-signature("logevent") <> ""
       98   then do:
       99     assign
      100       v-vssrevis-logevent = true
      101     .
      102     run vss-logevent in this-procedure (input vss-description) .
      103   end.
      104   define new global shared variable g#language as character no-undo .
      105   if g#language <> '' and g#language <> 'rus':U then do:
      106     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      107   end.
      108   define new global shared variable g#library  as handle no-undo .
      109   define new global shared variable g#library2 as handle no-undo .
      110   define   shared variable g#auto as logical no-undo.
      111   define   shared variable g#news as logical no-undo.
      112   define   shared variable g#oxml as logical no-undo.
      113   define   shared variable g#esys as logical no-undo.
      114   define   shared variable g#news-source-db as integer no-undo.
      115   define   shared variable g#esys-source-esys as integer no-undo.
      116   define   shared variable g#db-num as integer   no-undo .
      117   define   shared variable g#userid as character no-undo .
      118   define   shared variable g#passwd as character no-undo .
      119   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      120   FUNCTION calc-range RETURNS LOGICAL(
      121                                        input  my-db-num as integer
      122                                       ,input  my-code-src as integer
      123                                       ,input p-range-type as character
      124                                       ):
      125   define variable mycode as integer no-undo .
      126   mycode = abs(my-code-src).
      127   if mycode = 0 then return no.
      128   define buffer buf_code-range for ub.code-range.
      129   find first  buf_code-range no-lock where
      130           buf_code-range.db-num = my-db-num
      131       and buf_code-range.range-type = p-range-type
      132       and buf_code-range.stts = 'u'
      133       and buf_code-range.first-code <= mycode
      134       and buf_code-range.last-code >= mycode no-error .
      135   if available buf_code-range then return yes.
      136   find first buf_code-range no-lock where
      137           buf_code-range.db-num = my-db-num
      138       and buf_code-range.range-type = p-range-type
      139       and buf_code-range.stts = 'a':U
      140       and buf_code-range.first-code <= mycode no-error .
      141   if p-range-type = 'fmgb':U
      142   and available buf_code-range
      143   and (buf_code-range.stts = 'u'
      144       or
      145       mycode <  current-value(s-fmgb-code, ub)) then return yes.
      146   if p-range-type = 'pngb':U
      147   and available buf_code-range
      148   and (buf_code-range.stts = 'u'
      149       or
      150       mycode <  current-value(s-pngb-code, ub)) then return yes.
      151   if my-code-src < 0 then do:
      152     find first buf_code-range no-lock where
      153             buf_code-range.db-num = my-db-num
      154         and buf_code-range.range-type = p-range-type
      155         and buf_code-range.stts = 'f':U
      156         and buf_code-range.first-code <= mycode
      157         and buf_code-range.last-code >= mycode  no-error .
      158     if available buf_code-range then return yes.
      159   end.
      160     find first buf_code-range no-lock where
      161             buf_code-range.db-num = my-db-num
      162         and buf_code-range.range-type = p-range-type
      163         and buf_code-range.first-code <= mycode
      164         and buf_code-range.last-code >= mycode  no-error .
      165   if available buf_code-range then return no.
      166   return ?.
      167   END FUNCTION.
      168   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      169   define variable v-waitfram-action01         as character   no-undo .
      170   define variable v-waitfram-action02         as character   no-undo .
      171   define variable v-waitfram-action03         as character   no-undo .
      172   define variable mWaitFramTextBeg            as character   no-undo.
      173   define variable mWaitFramTextEnd            as character   no-undo.
      174   define variable mWaitFramView               as logical     no-undo.
      175   define variable mWaitProcEvent              as logical     no-undo init yes.
      176   define variable mWaitFramInterval           as integer     no-undo init 1 .
      177   define variable mWaitFramStop               as logical     no-undo.
      178   define variable mWaitFramStopUser           as logical     no-undo.
      179   define variable mWaitFramStopTimeOut        as logical     no-undo.
      180   define variable mWaitFramStartProc          as datetime-tz no-undo.
      181   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      182   define button B-WaitFramStop auto-end-key
      183        label "Стоп"
      184        size 10 by 1 tooltip "Остоновить процесс".
      185   define button B-viewProcInfo
      186        label "Информация"
      187        size 15 by 1 tooltip "Информация о процесс".
      188   define frame waitfram
      189     v-waitfram-action01 format "x(72)" no-label skip
      190     v-waitfram-action02 format "x(72)" no-label skip
      191     v-waitfram-action03 format "x(72)" no-label skip
      192     B-viewProcInfo
      193     B-WaitFramStop at row 4 col 30
      194     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      195     .
      196   define new global shared variable mBatchMode as logical no-undo init ?.
      197   define variable mFramBachModHandle as handle no-undo.
      198   mFramBachModHandle = frame waitfram:handle.
      199   define variable mFameOldVis as logical no-undo.
      200   define variable mVisCUrentVin as logical no-undo.
      201   if session:batch-mode
      202   then
      203      mBatchMode = yes.
      204   if mBatchMode = ? then do:
      205     mVisCUrentVin = current-window:visible.
      206     mFameOldVis = mFramBachModHandle:visible.
      207     mFramBachModHandle:visible  = yes.
      208     mBatchMode = mFramBachModHandle:visible ne yes.
      209     mFramBachModHandle:visible = mFameOldVis.
      210     current-window:visible = mVisCUrentVin.
      211   end.
      212    if  log-manager:logfile-name ne ?
      213     then DO:
      214         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      215         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      216         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      217     end.
      218   on choose of B-WaitFramStop in frame waitfram
      219   do:
      220     mWaitFramStop = yes.
      221     mWaitFramStopUser = yes.
      222   end.
      223   function waitfram-check-timeout returns logical():
      224      define variable vtime as int64 no-undo.
      225      if mWaitFramStopTimeOut
      226      then
      227         return yes.
      228      vtime = ( now - mWaitFramStartProc ) / 1000 .
      229      if     mWaitFramTimeOut ne ?
      230         and mWaitFramTimeOut ne 0
      231         and mWaitFramTimeOut lt vtime
      232      then do:
      233         mWaitFramStopTimeOut = yes.
      234      end.
      235      return mWaitFramStopTimeOut.
      236   end.
      237   procedure waitfram-hide :
      238     if not session:batch-mode
      239     then do
      240     on error undo, return error return-value
      241     :
      242       pause 0 before-hide .
      243       if not mBatchMode then
      244         hide frame waitfram .
      245     if     not mWaitFramView
      246        and mWaitProcEvent
      247     then
      248       process events .
      249     end.
      250   end procedure.
      251   procedure waitfram-show :
      252     define input  parameter p-message as character no-undo .
      253     define variable v-left-margin as integer   no-undo .
      254     if not session:batch-mode
      255     then do
      256     on error undo, return error return-value
      257     :
      258       if length(p-message) <= 70 then do:
      259         assign
      260           v-left-margin = integer((70 - length(p-message)) / 2)
      261         .
      262         assign
      263           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      264         .
      265         assign
      266           v-waitfram-action01 = " "
      267           v-waitfram-action02 = " "
      268                                    + fill(" ", v-left-margin)
      269                                    + p-message
      270           v-waitfram-action03 = " "
      271         .
      272       end.
      273       else do:
      274         define variable vRindex1 as integer no-undo.
      275         define variable vRindex2 as integer no-undo.
      276         vRindex1 = r-index(p-message," ",70).
      277         if vRindex1 = 0
      278         then
      279            vRindex1 = 70.
      280         if length(p-message)  <= vRindex1 + 70 then do:
      281           assign
      282             v-waitfram-action01 = " "
      283             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      284             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      285           .
      286         end.
      287         else do:
      288           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      289           if vRindex2 <= vRindex1
      290           then
      291              vRindex2 = vRindex1 + 70.
      292           assign
      293             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      294             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      295             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      296           .
      297         end.
      298       end.
      299       B-viewProcInfo:visible   in frame waitfram = no.
      300       B-viewProcInfo:sensitive in frame waitfram = no.
      301       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      302       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      303       if  (   mWaitFramView
      304          or  mWaitProcEvent)
      305          and not mBatchMode
      306       then
      307          display
      308             v-waitfram-action01 skip
      309             v-waitfram-action02 skip
      310             v-waitfram-action03 skip
      311          with frame waitfram .
      312       if     mWaitFramView
      313          then do:
      314             if     mWaitFramInterval ne ?
      315                and not mBatchMode
      316             then
      317                wait-for go of frame waitfram pause mWaitFramInterval.
      318          end.
      319          else
      320             if     mWaitProcEvent
      321                and not mBatchMode
      322             then
      323                process events .
      324     end.
      325   end procedure.
      326      procedure waitfram-show-this:
      327         define input  parameter iInterval as int64 no-undo.
      328         define variable vtime as int64 no-undo.
      329         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      330         mWaitFramInterval = iInterval.
      331         run waitfram-show (substitute("&1&2 &3&4" ,
      332                                       mWaitFramTextBeg ,
      333                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      334                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      335                                       mWaitFramTextEnd
      336                                      )
      337                           ).
      338      end.
      339      procedure WaitFramRunPause:
      340         define input  parameter iInterval as dec no-undo.
      341         define variable vStart  as datetime-tz no-undo.
      342         define variable vend    as datetime-tz no-undo.
      343         define variable vint as int64 no-undo.
      344         define variable vOk as logical no-undo.
      345         vStart = now.
      346         vend   = vStart.
      347         publish "WaitFramPause" (iInterval,output vOk).
      348         vend   =  now.
      349         vint = vend - vStart.
      350         vint = iInterval - vint / 1000.
      351         if     not mWaitFramStop
      352            and (   vint > 0
      353                 or (    not vOk
      354                     and iInterval eq ?
      355                     )
      356                 )
      357         then
      358            run waitfram-show-this (iInterval).
      359         vend   =  now.
      360         vint = vend - vStart.
      361         vint = iInterval - vint / 1000.
      362         if     not mWaitFramStop
      363            and vint > 0
      364         then do:
      365            run gbl/pause.p (vint * 1000).
      366         end.
      367         if iInterval ne ?
      368         then
      369            publish "WaitFramStop".
      370         waitfram-check-timeout().
      371      end.
      372      procedure WaitFramWaitFor:
      373         define input  parameter iInterval as dec no-undo.
      374         assign
      375            mWaitFramStartProc   = now
      376            mWaitFramStopUser    = no
      377            mWaitFramStopTimeOut = no
      378         .
      379         block-wait:
      380         do while not mWaitFramStop:
      381            run WaitFramRunPause (iInterval).
      382            if  waitfram-check-timeout()
      383            then do:
      384               leave block-wait.
      385            end.
      386         end.
      387         run waitfram-hide.
      388      end.
      389   procedure waitfram-join :
      390     define input  parameter p-line-1  as character no-undo .
      391     define input  parameter p-line-2  as character no-undo .
      392     define input  parameter p-line-3  as character no-undo .
      393     define output parameter p-message as character no-undo .
      394     do
      395     on error undo, return error return-value
      396     :
      397       assign
      398         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      399                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      400                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      401       .
      402     end.
      403   end procedure.
      404   function waitfram-join-function returns character
      405     (input p-line-1 as character
      406     ,input p-line-2 as character
      407     ,input p-line-3 as character
      408     ).
      409     define variable v-message as character no-undo .
      410     run waitfram-join in this-procedure
      411       (input  p-line-1
      412       ,input  p-line-2
      413       ,input  p-line-3
      414       ,output v-message
      415       ) .
      416     return v-message .
      417   end function .
      418   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      419   procedure gen-b-code :
      420     define input  parameter type-code like ub.code-range.range-type no-undo .
      421     define output parameter p-b-code  like ub.bar-code.b-code       no-undo .
      422     do
      423     on error  undo, return error substitute( "&1 (gen-b-code). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      424     on stop   undo, return error substitute( "&1 (gen-b-code). stop", vss-workfile )
      425     on endkey undo, return error substitute( "&1 (gen-b-code). endkey", vss-workfile )
      426     :
      427       define buffer buf_thbj-attr     for ub.thbj-attr .
      428       define buffer buf_sys-ctrl   for ub.sys-ctrl .
      429       define buffer buf_code-range for ub.code-range .
      430       define variable l-code         as   integer              no-undo .
      431       define variable v-db-num       like ub.db.db-num         no-undo .
      432       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      433       if type-code = 'sslc':U
      434       or type-code = 'ssgb':U
      435       then do:
      436         message
      437           "Нельзя генерировать локальный или глобальный взвешиваемый код." skip
      438           "Обратитесь к администратору системы."
      439           view-as alert-box error .
      440         undo, return error (if type-code = 'sslc':U then "loc-ss-code":U else "gbl-ss-code" ) .
      441       end.
      442       run trg/getpcode.p ( input  type-code
      443                      ,output cfg-param-code
      444                     ).
      445       run get-next-seq( input  type-code,
      446                         output l-code
      447                       ).
      448       find first buf_sys-ctrl no-lock.
      449       if type-code = 'sclc':U
      450       or type-code = 'pglc':U
      451       then do:
      452         assign
      453           v-db-num = 0
      454         .
      455       end.
      456       else do:
      457         assign
      458           v-db-num = buf_sys-ctrl.db-num
      459         .
      460       end.
      461       find first buf_code-range no-lock
      462         where buf_code-range.db-num     = v-db-num
      463           and buf_code-range.range-type = type-code
      464           and buf_code-range.stts       = "a"
      465         use-index stts
      466         no-error .
      467       if available buf_code-range
      468          and l-code <= buf_code-range.last-code
      469          and l-code >= buf_code-range.first-code then do:
      470         assign
      471           p-b-code = l-code
      472         .
      473       end.
      474       else do:
      475         if available buf_code-range
      476            and l-code < buf_code-range.last-code then do:
      477           message
      478             substitute( "Последовательность для создания кодов с типом &1 имеет неверное значение.", type-code ) skip
      479             "Обратитесь к администратору системы."
      480             view-as alert-box error .
      481           undo, return error "sequence":U .
      482         end.
      483         do transaction
      484         on error undo, return error
      485         :
      486           find first buf_thbj-attr exclusive-lock
      487             where buf_thbj-attr.upper-prop-code = 'code-range':U
      488               and buf_thbj-attr.prop-code = cfg-param-code
      489               and buf_thbj-attr.obj-type   = 'БД':U
      490               and buf_thbj-attr.obj-code   = v-db-num
      491             no-error .
      492           if not available buf_thbj-attr then do:
      493             find first buf_thbj-attr exclusive-lock
      494               where buf_thbj-attr.upper-prop-code = 'code-range':U
      495                 and buf_thbj-attr.prop-code = cfg-param-code
      496                 and buf_thbj-attr.obj-type   = ''
      497                 and buf_thbj-attr.obj-code   = 0
      498               no-error .
      499             if not available buf_thbj-attr then do:
      500               if not locked buf_thbj-attr then do:
      501                 message
      502                   substitute( "Отсутствует параметр 'длина диапазона кодов' (&1) для БД &2.", cfg-param-code, buf_sys-ctrl.db-num ) skip
      503                   "Обратитесь к администратору системы."
      504                   view-as alert-box error .
      505               end.
      506               undo, return error "config":U .
      507             end.
      508           end.
      509           run get-next-seq( input type-code,
      510                             output l-code
      511                           ).
      512           find first buf_code-range
      513             where buf_code-range.db-num     = v-db-num
      514               and buf_code-range.range-type = type-code
      515               and buf_code-range.stts       = "a"
      516             use-index stts
      517             no-error .
      518           if available buf_code-range
      519           and l-code <= buf_code-range.last-code
      520           and l-code >= buf_code-range.first-code
      521           then do:
      522             assign
      523               p-b-code = l-code
      524             .
      525           end.
      526           else do:
      527             if available buf_code-range then do:
      528               assign
      529                 buf_code-range.stts = "u"
      530               .
      531             end.
      532             find first buf_code-range
      533               where buf_code-range.db-num     = v-db-num
      534                 and buf_code-range.range-type = type-code
      535                 and buf_code-range.stts       = "f"
      536               use-index stts
      537               no-error .
      538             if not available buf_code-range then do:
      539               message
      540                 substitute( "Отсутствует свободный диапазон для кодов с типом &1.", type-code ) skip
      541                 "Обратитесь к администратору системы"
      542                 view-as alert-box error .
      543               undo, return error "code-range":U .
      544             end.
      545             assign
      546               buf_code-range.stts           = "a"
      547             .
      548             if buf_code-range.first-code = 1 then do:
      549               run set-seq-cr( input type-code,
      550                               input buf_code-range.first-code
      551                             ).
      552               assign
      553                 p-b-code = 1
      554               .
      555             end.
      556             else do:
      557               run set-seq-cr( input type-code,
      558                               input ( buf_code-range.first-code - 1 )
      559                             ).
      560               run get-next-seq( input type-code,
      561                                 output p-b-code
      562                               ).
      563             end.
      564           end.
      565         end.
      566       end.
      567     end.
      568   end procedure.
      569   procedure get-next-seq :
      570     define input  parameter type-code like ub.code-range.range-type no-undo .
      571     define output parameter next-seq  as   integer                  no-undo .
      572     do
      573     on error  undo, return error substitute( "&1 (get-next-seq). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      574     on stop   undo, return error substitute( "&1 (get-next-seq). stop", vss-workfile )
      575     on endkey undo, return error substitute( "&1 (get-next-seq). endkey", vss-workfile )
      576     :
      577       case type-code:
      578         when 'bcgb':U then do:
      579           assign
      580             next-seq = next-value(s-bcgb-code, ub)
      581           .
      582         end.
      583         when 'scgb':U then do:
      584           assign
      585             next-seq = next-value(s-scgb-code, ub)
      586           .
      587         end.
      588         when 'sclc':U then do:
      589           assign
      590             next-seq = next-value(s-sclc-code, ub)
      591           .
      592         end.
      593         when 'pglc':U then do:
      594           assign
      595             next-seq = next-value(s-pglc-code, ub)
      596           .
      597         end.
      598         when 'dcgb':U then do:
      599           assign
      600             next-seq = next-value(s-dcgb-code, ub)
      601           .
      602         end.
      603         when 'ctgb':U then do:
      604           assign
      605             next-seq = next-value(s-ctgb-code, ub)
      606           .
      607         end.
      608         when 'drgb':U then do:
      609           assign
      610             next-seq = next-value(s-drgb-code, ub)
      611           .
      612         end.
      613         when 'fmgb':U then do:
      614           assign
      615             next-seq = next-value(s-fmgb-code, ub)
      616           .
      617         end.
      618         when 'pngb':U then do:
      619           assign
      620             next-seq = next-value(s-pngb-code, ub)
      621           .
      622         end.
      623         when 'cagb':U then do:
      624           assign
      625             next-seq = next-value(s-cagb-code, ub)
      626           .
      627         end.
      628         when 'fdgb':U then do:
      629           assign
      630             next-seq = next-value(s-fin-doc, ub)
      631           .
      632         end.
      633       end case.
      634     end.
      635   end procedure.
      636   procedure set-seq-cr :
      637     define input parameter type-code like ub.code-range.range-type no-undo .
      638     define input parameter set-val   like ub.code-range.first-code no-undo .
      639     do
      640     on error  undo, return error substitute( "&1 (set-seq-cr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      641     on stop   undo, return error substitute( "&1 (set-seq-cr). stop", vss-workfile )
      642     on endkey undo, return error substitute( "&1 (set-seq-cr). endkey", vss-workfile )
      643     :
      644       case type-code:
      645         when 'bcgb':U then do:
      646           assign
      647             current-value(s-bcgb-code, ub) = set-val
      648           .
      649         end.
      650         when 'scgb':U then do:
      651           assign
      652             current-value(s-scgb-code, ub) = set-val
      653           .
      654         end.
      655         when 'sclc':U then do:
      656           assign
      657             current-value(s-sclc-code, ub) = set-val
      658           .
      659         end.
      660         when 'pglc':U then do:
      661           assign
      662             current-value(s-pglc-code, ub) = set-val
      663           .
      664         end.
      665         when 'dcgb':U then do:
      666           assign
      667             current-value(s-dcgb-code, ub) = set-val
      668           .
      669         end.
      670         when 'ctgb':U then do:
      671           assign
      672             current-value(s-ctgb-code, ub) = set-val
      673           .
      674         end.
      675         when 'drgb':U then do:
      676           assign
      677             current-value(s-drgb-code, ub) = set-val
      678           .
      679         end.
      680         when 'fmgb':U then do:
      681           assign
      682             current-value(s-fmgb-code, ub) = set-val
      683           .
      684         end.
      685         when 'pngb':U then do:
      686           assign
      687             current-value(s-pngb-code, ub) = set-val
      688           .
      689         end.
      690         when 'cagb':U then do:
      691           assign
      692             current-value(s-cagb-code, ub) = set-val
      693           .
      694         end.
      695         when 'fdgb':U then do:
      696           assign
      697             current-value(s-fin-doc, ub) = set-val
      698           .
      699         end.
      700       end case.
      701     end.
      702   end procedure.
      703   procedure new-bcod-gen-code-range :
      704     do
      705     on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      706     on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      707     on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      708     :
      709       define input parameter p-db-num  like ub.db.db-num             no-undo .
      710       define input parameter type-code like ub.code-range.range-type no-undo .
      711       define buffer buf_code-range      for ub.code-range .
      712       define buffer last_code-range     for ub.code-range .
      713       define buffer last-1_code-range   for ub.code-range .
      714       define buffer last-2_code-range   for ub.code-range .
      715       define buffer last-3_code-range   for ub.code-range .
      716       define buffer buf_sys-ctrl        for ub.sys-ctrl .
      717       define variable conf-par       as character no-undo .
      718       define variable par-type       as character no-undo .
      719       define variable cfg-param-code like ub.thbj-attr.prop-code no-undo .
      720       define variable v-cre-cdrg as logical   no-undo .
      721       define variable v-cre-str  as character no-undo .
      722       define variable v-cr1      as integer no-undo .
      723       define variable v-cr2      as integer no-undo .
      724       define variable v-cr3      as integer no-undo .
      725       define variable v-cmax     as integer no-undo .
      726       find first buf_sys-ctrl no-lock .
      727       if buf_sys-ctrl.db-num <> 0 and type-code <> 'cagb':U then do:
      728         undo, return error substitute("&1 &2 &3&4Диапазоны кодов можно создавать только в ГБД&4База данных &5"
      729                                       ,vss-workfile
      730                                       ,vss-revision
      731                                       ,vss-description
      732                                       ,chr(10)
      733                                       , p-db-num
      734                                      ).
      735       end.
      736       run trg/getpcode.p ( input  type-code
      737                      ,output cfg-param-code
      738                     ).
      739       for each buf_code-range
      740         where buf_code-range.db-num     = -1
      741           and buf_code-range.range-type = type-code
      742           and buf_code-range.stts       = "f"
      743       by buf_code-range.first-code
      744       on error  undo, return error substitute( "&1 (new-bcod-gen-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      745       on stop   undo, return error substitute( "&1 (new-bcod-gen-code-range). stop", vss-workfile )
      746       on endkey undo, return error substitute( "&1 (new-bcod-gen-code-range). endkey", vss-workfile )
      747       :
      748         assign
      749           buf_code-range.db-num = p-db-num
      750         .
      751         return .
      752       end.
      753       assign
      754         v-cre-cdrg = TRUE
      755       .
      756       case type-code:
      757         when 'sclc':U
      758         or when 'scgb':U
      759         or when 'pglc':U
      760         then do:
      761           find last last-1_code-range no-lock
      762             where last-1_code-range.range-type = 'sclc':U
      763             no-error .
      764           if available last-1_code-range then do:
      765             v-cr1 = last-1_code-range.last-code.
      766           end.
      767           find last last-2_code-range no-lock
      768             where last-2_code-range.range-type = 'scgb':U
      769             no-error .
      770           if available last-2_code-range then do:
      771             v-cr2 = last-2_code-range.last-code.
      772             end.
      773           find last last-3_code-range no-lock
      774             where last-3_code-range.range-type = 'pglc':U
      775             no-error .
      776           if available last-3_code-range then do:
      777             v-cr3 = last-3_code-range.last-code.
      778           end.
      779           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      780           .
      781           if v-cmax = v-cr1  then do:
      782               find last last_code-range no-lock
      783                 where recid( last_code-range ) = recid( last-1_code-range )
      784                 .
      785             end.
      786           if v-cmax = v-cr2  then do:
      787               find last last_code-range no-lock
      788                 where recid( last_code-range ) = recid( last-2_code-range )
      789                 .
      790             end.
      791           if v-cmax = v-cr3  then do:
      792             find last last_code-range no-lock
      793               where recid( last_code-range ) = recid( last-3_code-range )
      794               .
      795           end.
      796           if last_code-range.last-code + 1 > 99999 then do:
      797             assign
      798               v-cre-cdrg = FALSE
      799             .
      800           end.
      801         end.
      802         when 'bcgb':U
      803         or when 'sslc':U
      804         or when 'ssgb':U
      805         then do:
      806           find last last-1_code-range no-lock
      807             where last-1_code-range.range-type = 'sslc':U
      808             no-error .
      809           if available last-1_code-range then do:
      810             v-cr1 = last-1_code-range.last-code.
      811           end.
      812           find last last-2_code-range no-lock
      813             where last-2_code-range.range-type = 'bcgb':U
      814             no-error .
      815           if available last-2_code-range then do:
      816             v-cr2 = last-2_code-range.last-code.
      817             end.
      818           find last last-3_code-range no-lock
      819             where last-3_code-range.range-type = 'ssgb':U
      820             no-error .
      821           if available last-3_code-range then do:
      822             v-cr3 = last-3_code-range.last-code.
      823           end.
      824           v-cmax = maximum(v-cr1, v-cr2, v-cr3)
      825           .
      826           if v-cmax = v-cr1  then do:
      827               find last last_code-range no-lock
      828                 where recid( last_code-range ) = recid( last-1_code-range )
      829                 .
      830             end.
      831           if v-cmax = v-cr2  then do:
      832               find last last_code-range no-lock
      833                 where recid( last_code-range ) = recid( last-2_code-range )
      834                 .
      835             end.
      836           if v-cmax = v-cr3  then do:
      837             find last last_code-range no-lock
      838               where recid( last_code-range ) = recid( last-3_code-range )
      839               .
      840           end.
      841         end.
      842         otherwise do:
      843           find last last_code-range no-lock
      844             where last_code-range.range-type = type-code
      845             no-error .
      846         end.
      847       end case.
      848       if not available last_code-range then do:
      849         undo, return error substitute("&1 &2 &3&4В БД нет ни одного диапазона с типом &5&4Не была проведена инициализация диапазонов!"
      850                                       ,vss-workfile
      851                                       ,vss-revision
      852                                       ,vss-description
      853                                       , chr(10)
      854                                       , type-code
      855                                      ) .
      856       end.
      857       define variable v-mes2 as character no-undo .
      858       define variable v-param-type2 as character no-undo .
      859       define variable v-value-character2 as INTEGER no-undo .
      860       define variable v-value-date2 as date no-undo .
      861       define variable v-value-decimal2 as decimal no-undo .
      862       define variable v-value-integer2 AS integer no-undo .
      863       define variable v-value-logical2 AS LOGICAL no-undo .
      864       define variable v-tth2 as handle no-undo .
      865       run adm/shattri.p (
      866           input "get":U
      867           ,input  'БД':U
      868           ,input  p-db-num
      869           ,input  'code-range':U
      870           ,input  cfg-param-code
      871           ,output v-value-character2
      872           ,output v-value-date2
      873           ,output v-value-decimal2
      874           ,output v-value-integer2
      875           ,output v-value-logical2
      876           ,output v-param-type2
      877           ,INPUT-OUTPUT table-handle v-tth2
      878           ) no-error .
      879       if error-status :error then do:
      880         delete object v-tth2.
      881         v-mes2 = substitute("Ошибка при получении размера диапазона собственных глобальных кодов&2&1&2&3"
      882                            , error-status:get-message(1)
      883                            , chr(10)
      884                            , return-value ).
      885         undo, return error v-mes2.
      886       end.
      887       delete object v-tth2.
      888       if v-cre-cdrg = TRUE then do:
      889         create buf_code-range .
      890         assign
      891           buf_code-range.db-num     = p-db-num
      892           buf_code-range.range-type = type-code
      893           buf_code-range.stts       = "f"
      894           buf_code-range.first-code = last_code-range.last-code + 1
      895           buf_code-range.last-code  = last_code-range.last-code + integer(v-value-integer2)
      896           v-cre-str = "Свободный диапазон успешно создан"
      897         .
      898       end.
      899       else do:
      900         assign
      901           v-cre-str = "Нет возможности создать свободный диапазон." + chr(10)
      902                       + substitute( "Превышен предел диапазонов c типом &1", type-code )
      903         .
      904       end.
      905     end.
      906     return v-cre-str .
      907   end procedure.
      908   procedure gen-new-code-range-if-neces :
      909     define input parameter v-db-num           like ub.db.db-num             no-undo .
      910     define input parameter v-range-type       like ub.code-range.range-type no-undo .
      911     define input parameter v-cur-code         as   integer                  no-undo .
      912     define input parameter v-g#news           as   logical                  no-undo .
      913     define input parameter v-g#db-num         like ub.db.db-num             no-undo .
      914     define input parameter v-g#news-source-db like ub.db.db-num             no-undo .
      915     do
      916     on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
      917     on stop   undo, return error substitute( "&1 (gen-new-code-range-if-neces). stop", vss-workfile )
      918     on endkey undo, return error substitute( "&1 (gen-new-code-range-if-neces). endkey", vss-workfile )
      919     :
      920       define variable l-code-range-exist as logical   no-undo init false .
      921       define variable v-db-for-send      as character no-undo .
      922       define buffer buf_code-range  for ub.code-range .
      923       define buffer buf1_code-range for ub.code-range .
      924       define buffer buf_db          for ub.db .
      925       find first buf_code-range
      926         where buf_code-range.range-type = v-range-type
      927           and buf_code-range.last-code >= v-cur-code
      928         use-index last-codei
      929         no-error .
      930       if
      931       (
      932          available buf_code-range
      933          and
      934         (buf_code-range.db-num = v-db-num
      935           and
      936         buf_code-range.first-code <= v-cur-code
      937         )
      938       or
      939         (
      940           v-range-type = 'drgb':U
      941           AND
      942           v-cur-code = 0
      943         )
      944      )
      945      then do:
      946         assign
      947           l-code-range-exist = true
      948         .
      949         if v-g#news
      950         and buf_code-range.stts = "f" then do:
      951           assign
      952             buf_code-range.stts = "u"
      953           .
      954         end.
      955       end.
      956       if not l-code-range-exist
      957          and v-g#news-source-db <> 0
      958       then do:
      959         undo, return error substitute("&1 &2 &3&4Отсутствует диапазон кодов для БД &5 Тип диапазона кодов &6 Код &7"
      960                                       ,vss-workfile
      961                                       ,vss-revision
      962                                       ,vss-description
      963                                       ,chr(10)
      964                                       ,v-db-num
      965                                       ,v-range-type
      966                                       ,v-cur-code
      967                                      ).
      968       end.
      969       if (not l-code-range-exist
      970           or ( v-cur-code >= int( (buf_code-range.first-code + buf_code-range.last-code) / 2 ) )
      971          )
      972       and ( not can-find (first buf1_code-range no-lock
      973                           where buf1_code-range.db-num = v-db-num
      974                             and buf1_code-range.range-type = v-range-type
      975                             and buf1_code-range.stts = "f"
      976                          )
      977           )
      978       then do:
      979         if v-g#db-num = 0 then do:
      980           run new-bcod-gen-code-range in this-procedure
      981             (input v-db-num,
      982              input v-range-type
      983             ) no-error .
      984           if error-status :error then do:
      985             undo, return error substitute("Ошибка при создании нового свободного диапазона &1 Тип диапазона кодов &2 Код &3:&4&5 &6"
      986                                           , substitute("&1 &2 &3", vss-workfile, vss-revision, vss-description)
      987                                           ,v-db-num
      988                                           ,v-range-type
      989                                           ,v-cur-code
      990                                           ,chr(10)
      991                                           ,error-status:get-message(1)
      992                                           ,return-value
      993                                          ).
      994           end.
      995         end.
      996         else do:
      997           if v-range-type = 'sclc':U
      998           or v-range-type = 'pglc':U
      999           then do:
     1000             assign
     1001               v-db-for-send = "":U
     1002             .
     1003             if v-g#db-num = 0 then do:
     1004               for each buf_db no-lock
     1005                 where buf_db.db-num > 0
     1006                   and buf_db.db-num <> v-g#news-source-db
     1007               on error  undo, return error substitute( "&1 (gen-new-code-range-if-neces). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1008               :
     1009                 assign
     1010                   v-db-for-send = v-db-for-send + chr(1) + string( buf_db.db-num )
     1011                 .
     1012               end.
     1013               assign
     1014                 v-db-for-send = right-trim( v-db-for-send, chr(1) )
     1015               .
     1016             end.
     1017             else do:
     1018               if not v-g#news then do:
     1019                 assign
     1020                   v-db-for-send = "0":U
     1021                 .
     1022               end.
     1023             end.
     1024             run nws/cr-route.p ( input 'send-cmd':U
     1025                           ,input ("command":U + chr(1) + "create":U + chr(1) +
     1026                                  "code-range":U + chr(1) +
     1027                                  (if v-range-type = 'sclc':U
     1028                                   then string( current-value(s-sclc-code, ub))
     1029                                   else string( current-value(s-pglc-code, ub))
     1030                                   ) + chr(1) +
     1031                                   v-range-type)
     1032                           ,input ?
     1033                           ,input v-db-for-send
     1034                           ) no-error .
     1035             if error-status :error then do:
     1036               undo, return error return-value.
     1037             end.
     1038           end.
     1039         end.
     1040       end.
     1041     end.
     1042   end procedure.
     1043   procedure cre-loc-sc-code-range :
     1044     define input parameter v-cur-code as integer no-undo .
     1045   define input parameter p-cdrg-type as character no-undo .
     1046     do
     1047     on error  undo, return error substitute( "&1 (cre-loc-sc-code-range). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1048     on stop   undo, return error substitute( "&1 (cre-loc-sc-code-range). stop", vss-workfile )
     1049     on endkey undo, return error substitute( "&1 (cre-loc-sc-code-range). endkey", vss-workfile )
     1050     :
     1051       define buffer buf_code-range for ub.code-range .
     1052       find first buf_code-range
     1053            where buf_code-range.range-type = p-cdrg-type
     1054              and buf_code-range.first-code >= v-cur-code
     1055            no-error .
     1056       if not available buf_code-range then do:
     1057         run new-bcod-gen-code-range in this-procedure
     1058           ( input 0,
     1059             input p-cdrg-type
     1060           ) no-error .
     1061         if error-status :error then do:
     1062           undo, return error substitute( "Ошибка при создании нового свободного диапазона локальных весовых или штучных кодов&1"
     1063                                          + "Код &2&1&3 &4"
     1064                                         , chr(10)
     1065                                         , v-cur-code
     1066                                         , error-status:get-message(1)
     1067                                         , return-value
     1068                                        ) .
     1069         end.
     1070       end.
     1071     end.
     1072   end procedure.
     1073   procedure mark-used-if-need :
     1074   define input parameter p-cur-code as integer no-undo .
     1075   define input parameter p-range-type like ub.code-range.range-type no-undo .
     1076   define input parameter p-db-num like ub.code-range.db-num no-undo .
     1077     do
     1078     on error  undo, return error substitute( "&1 (mark-used-if-need). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( 1 ) )
     1079     on stop   undo, return error substitute( "&1 (mark-used-if-need). stop", vss-workfile )
     1080     on endkey undo, return error substitute( "&1 (mark-used-if-need). endkey", vss-workfile )
     1081     :
     1082       DEFINE VARIABLE v-db-num like ub.code-range.db-num no-undo .
     1083       define buffer buf_code-range for ub.code-range .
     1084       assign
     1085       v-db-num = if p-range-type = 'sclc':U
     1086                  then 0
     1087                  else p-db-num
     1088       .
     1089   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1090   define buffer locK-batchprocess3 for ub.batchprocess.
     1091   run gbl/lock-prc.p
     1092       (input 'lscc':U
     1093       ,input 0
     1094       ,input 0
     1095       ,input 0
     1096       ,input ""
     1097       ,input ""
     1098       ,input ""
     1099       ,input (
     1100               ",,,Вкл/выкл лок. вес. кодов"
     1101              )
     1102       ,input true
     1103       ,buffer lock-batchprocess3
     1104       ) no-error .
     1105     if error-status :error then do:
     1106       message
     1107         vss-workfile vss-revision vss-description skip
     1108         "В данный момент идет процесс вкл/выкл лок. вес. кодов" skip
     1109         view-as alert-box error .
     1110       undo, return error .
     1111     end.
     1112       find first buf_code-range
     1113            where buf_code-range.range-type = p-range-type
     1114              and buf_code-range.first-code >= p-cur-code
     1115              and buf_code-range.last-code <= p-cur-code
     1116              and buf_code-range.db-num = v-db-num
     1117            no-error .
     1118       if not available buf_code-range then do:
     1119         message
     1120           vss-workfile vss-revision vss-description skip
     1121           "Ошибка при создании поиске диапазона" skip
     1122           "База данных" p-db-num skip
     1123           "Код" p-cur-code skip
     1124           "Тип" p-range-type
     1125           error-status :get-message(1) skip
     1126           return-value skip
     1127           view-as alert-box error .
     1128         undo, return error .
     1129       end.
     1130       if buf_code-range.stts = "f":U then do:
     1131         assign
     1132         buf_code-range.stts = "u":U
     1133         .
     1134       end.
     1135     end.
     1136   end procedure.
