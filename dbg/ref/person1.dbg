        9   define input parameter p-stts            as integer no-undo .
       10   define input parameter p-obj-name        as character no-undo .
       11   define input parameter p-lim-kr          as decimal no-undo .
       12   define input parameter p-PS              as character no-undo .
       13   define input parameter p-grp-code        as integer no-undo .
       14   define input parameter p-address         as character no-undo .
       15   define input parameter p-city            as character no-undo .
       16   define input parameter p-date-birth      as date      no-undo .
       17   define input parameter p-e-mail          as character no-undo .
       18   define input parameter p-fax             as character no-undo .
       19   define input parameter p-firm-code       as integer no-undo .
       20   define input parameter p-firm-name       as character no-undo .
       21   define input parameter p-gender          as logical   no-undo .
       22   define input parameter p-given-by        as character no-undo .
