     1439   if p-mode <> 'ДОБАВЛЕНИЕ':U
     1440   AND p-mode <> 'ИЗМЕНЕНИЕ':U
     1441   and p-mode <> 'ДОБАВЛЕНИЕ-ИМПОРТ':U then do:
     1442     message
     1443     vss-workfile vss-revision vss-description skip
     1444     "Неверный параметр p-mode" p-mode
     1445     view-as alert-box error .
     1446     return error '':u.
     1447   end.
     1448   if p-mode = 'ДОБАВЛЕНИЕ-ИМПОРТ':U then do:
     1449     assign
     1450     p-mode = 'ДОБАВЛЕНИЕ':U
     1451     v-import = yes
     1452     .
     1453   end.
     1454   define variable v-callpoint-dcard as character no-undo .
     1455   assign
     1456   v-callpoint-dcard = (if num-entries(p-callpoint, chr(4)) > 1
     1457                       then entry(2, p-callpoint, chr(4) )
     1458                       else '':U)
     1459   p-callpoint = entry(1, p-callpoint, chr(4))
     1460   .
     1461   if p-callpoint  <> 'C':U
     1462   and p-callpoint <> 'S':U
     1463   and p-callpoint <> "discards":U
     1464   and p-callpoint <> "cli-all":U
     1465   then do:
     1466       message
     1467       vss-workfile vss-revision vss-description skip
     1468       "Неверное значение параметров вызова p-callpoint"  p-callpoint
     1469       view-as alert-box ERROR.
     1470       undo, return error.
     1471   end.
     1472   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1473   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1474     (output v-db-num
     1475     )  .
     1476   if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     1477     RUN chk-code in this-procedure ( output v-is-correct) no-error.
     1478     if error-status:error THEN do:
     1479       assign
     1480       v-err-mess = substitute("Ошибка при проверке кода физ.лица &1&2&3"
     1481                               , p-psn-code
     1482                               , chr(10)
     1483                               , return-value ).
     1484       run err-mess ( input-output v-err-mess ).
     1485       undo, return error (if p-silent  then v-err-mess else (if return-value = "":U then "psn-code":U else return-value)).
     1486     end.
     1487     if not v-is-correct then do:
     1488       undo, return error (if p-silent  then v-err-mess else (if return-value = "":U then "psn-code":U else return-value)).
     1489     end.
     1490     p-psn-code = abs(p-psn-code).
     1491   end.
     1492   RUN chk-name in this-procedure ( input p-psn-code, output v-is-correct) no-error.
     1493   if error-status:error THEN do:
     1494     assign
     1495     v-err-mess = substitute("Ошибка при проверке фамилии человека &1&2&3"
     1496                             , p-obj-name
     1497                             , chr(10)
     1498                             , return-value
     1499                             ).
     1500     run err-mess ( input-output v-err-mess ).
     1501     undo, return error (if p-silent  then v-err-mess else "obj-name":U).
     1502   end.
     1503   if not v-is-correct then do:
     1504     undo, return error (if p-silent  then v-err-mess else "obj-name":U).
     1505   end.
     1506   find first buf_cli-grp no-lock where
     1507             buf_cli-grp.node-code = p-grp-code no-error .
     1508   if not avail buf_cli-grp then do:
     1509     assign
     1510     v-err-mess = substitute("Неверный код группы клиента &1", p-grp-code).
     1511     run err-mess ( input-output v-err-mess ).
     1512     undo, return error (if p-silent  then v-err-mess else "":U).
     1513   end.
     1514   define buffer down_cli-grp for ub.cli-grp.
     1515   find first down_cli-grp  no-lock where
     1516             down_cli-grp.upper-code = p-grp-code no-error .
     1517   if available down_cli-grp then do:
     1518     assign
     1519     v-err-mess = "Клиент может быть привязан только к терминальной группе".
     1520     run err-mess ( input-output v-err-mess).
     1521     undo, return error (if p-silent then v-err-mess else "":U).
     1522   end.
     1523   if p-inn <> "":U and not p-no-check-inn then do:
     1524     run gbl/keyinn.p ( input p-inn, input 'чел':U,  input p-psn-code, input p-is-pboul, output v-correct-inn) no-error .
     1525     if error-status:error or not v-correct-inn then do:
     1526       assign
     1527       v-err-mess = substitute("Неверный ИНН &1: &2", p-inn, return-value).
     1528       run err-mess ( input-output v-err-mess ).
     1529       return error ( if p-silent then v-err-mess else "inn":U).
     1530     end.
     1531   end.
     1532   if p-reg-code <> 0  then do:
     1533     find first buf_regions no-lock where
     1534               buf_regions.reg-code = p-reg-code no-error.
     1535     if not available buf_regions then do:
     1536       assign
     1537       v-err-mess = substitute("Неверный код региона &1", p-reg-code).
     1538       run err-mess ( input-output v-err-mess ).
     1539       return error ( if p-silent then v-err-mess else "reg-code":U).
     1540     end.
     1541   end.
     1542   if p-passp-num <> "":U then do:
     1543     assign
     1544     v-int64 = ?
     1545     v-int64 = int64(p-passp-num)
     1546     no-error .
     1547     if error-status:error
     1548     or v-int64 = ?
     1549     or trim(p-passp-num, "0123456789") <> '':U
     1550     then do:
     1551       assign
     1552       v-err-mess = substitute("Неверный № паспорта &1: &2", p-passp-num, return-value).
     1553       run err-mess ( input-output v-err-mess ).
     1554       return error ( if p-silent then v-err-mess else "passp-num":U).
     1555     end.
     1556   end.
     1557   if p-firm-code <> 0 then do:
     1558     IF NOT can-find(first ub.clients NO-LOCK WHERE
     1559                 ub.clients.obj-type = 'чел':U AND
     1560                 ub.clients.obj-code = p-firm-code) then do:
     1561       v-err-mess = substitute("Значение поля <<КОД ФИРМЫ>> должно соответствовать&1имеющемуся в системе клиенту типа <<&2>>"
     1562                             ,chr(10)
     1563                             ,'орг':U).
     1564       run err-mess ( input-output v-err-mess ).
     1565       return error ( if p-silent then v-err-mess else "firm-code":U).
     1566     END.
     1567   end.
     1568   main-block:
     1569   DO for buf_clients
     1570         ,buf_person
     1571   ON ERROR undo main-block, RETURN ERROR
     1572   ON STOP undo main-block, RETURN ERROR :
     1573     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     1574       if available buf_clients then release buf_clients.
     1575       create buf_clients.
     1576       assign
     1577       buf_clients.obj-type = 'чел':U
     1578       buf_clients.obj-code = p-psn-code
     1579       buf_clients.obj-name = p-obj-name
     1580       buf_clients.stts     = p-stts
     1581       buf_clients.grp-code = p-grp-code
     1582       .
     1583       create buf_person.
     1584       assign
     1585       buf_person.psn-code =  p-psn-code
     1586       .
     1587       assign
     1588       p-rid = recid(buf_clients)
     1589       .
     1590     end.
     1591     else do:
     1592       FIND FIRST buf_clients where
     1593                 recid(buf_clients) = p-rid No-ERROR.
     1594       if not available buf_clients then do:
     1595         message
     1596         vss-workfile vss-revision vss-description skip
     1597         "Не найдена запись КЛИЕНТ - p-rid" p-rid
     1598         view-as alert-box error .
     1599         undo main-block, return error '':u.
     1600       end.
     1601       if buf_clients.obj-type <>  'чел':U
     1602       OR buf_clients.obj-code <> p-psn-code then do:
     1603         message
     1604         vss-workfile vss-revision vss-description skip
     1605         "Для уже имеющейся записи нельзя изменить"
     1606         "тип и код клиента" skip
     1607         view-as alert-box ERROR.
     1608         undo main-block, return error '':U.
     1609       end.
     1610       FIND FIRST buf_person where
     1611                 buf_person.psn-code = p-psn-code No-ERROR.
     1612       if not available buf_person then do:
     1613         message
     1614         vss-workfile vss-revision vss-description skip
     1615         "Не найдена запись ЧЕЛОВЕК - p-psn-code" p-psn-code
     1616         view-as alert-box error .
     1617         undo main-block, return error '':u.
     1618       end.
     1619     end.
     1620     assign
     1621     v-new-inn = p-inn.
     1622     run trg/inn-uniq.p (
     1623                      input-output v-new-inn
     1624                     ,input (if p-mode = 'ДОБАВЛЕНИЕ':U then p-inn else buf_person.inn)
     1625                     ,input 'чел':U
     1626                     ,input buf_person.psn-code
     1627                     ,input p-silent
     1628                     ,input recid(buf_person)
     1629                     ,input buffer buf_person:handle
     1630                     ,output v-inn-uniq-error
     1631                     ) no-error.
     1632     if error-status:error then do:
     1633       v-err-mess = substitute("Ошибка при проверке ИНН на уникальность&1&2&1&3"
     1634                               , chr(10)
     1635                               , error-status:get-message(1)
     1636                               , return-value) .
     1637       run err-mess ( input-output v-err-mess ).
     1638       undo main-block, return error (if p-silent then v-err-mess else "inn-uniq":U).
     1639     end.
     1640     if v-inn-uniq-error then do:
     1641       v-err-mess = return-value .
     1642       if v-err-mess = 'inn-uniq-no-message' then do:
     1643         v-err-mess = 'inn-uniq'.
     1644       end.
     1645       else do:
     1646         run err-mess ( input-output v-err-mess ).
     1647       end.
     1648       undo main-block, return error (if p-silent then v-err-mess else "inn-uniq":U).
     1649     end.
     1650     assign
     1651     buf_clients.obj-name    =    p-obj-name
     1652     buf_clients.lim-kr      =    p-lim-kr
     1653     buf_clients.PS          =    p-PS
     1654     buf_clients.grp-code    =    p-grp-code
     1655     buf_clients.reg-code    =    p-reg-code
     1656     buf_clients.turnover-buyer     = p-turnover-buyer
     1657     buf_clients.turnover-buyer-gds = p-turnover-buyer-gds
     1658     buf_person.address      =    p-address
     1659     buf_person.city         =    p-city
     1660     buf_person.date-birth   =    p-date-birth
     1661     buf_person.e-mail       =    p-e-mail
     1662     buf_person.fax          =    p-fax
     1663     buf_person.firm-name    =    p-firm-name
     1664     buf_person.gender       =    p-gender
     1665     buf_person.given-by     =    p-given-by
     1666     buf_person.ind          =    p-ind
     1667     buf_person.inn          =    p-inn
     1668     buf_person.is-pboul     =    p-is-pboul
     1669     buf_person.kpp          =    p-kpp
     1670     buf_person.name1        =    p-name1
     1671     buf_person.name2        =    p-name2
     1672     buf_person.passp-num    =    p-passp-num
     1673     buf_person.passp-ser    =    p-passp-ser
     1674     buf_person.phone1       =    p-phone1
     1675     buf_person.phone1-note  =    p-phone1-note
     1676     buf_person.position     =    p-position
     1677     buf_person.post-box     =    p-post-box
     1678     buf_person.post-address =    p-post-address
     1679     buf_person.post-city    =    p-post-city
     1680     buf_person.post-ind     =    p-post-ind
     1681     buf_clients.trg-param   =    (if v-import
     1682                                  and p-callpoint = "discards"
     1683                                  then 'no-callnews':U
     1684                                  else '':U)
     1685     buf_person.trg-param    =    (if v-import
     1686                                  and p-callpoint = "discards"
     1687                                  then 'no-callnews':U
     1688                                  else '':U)
     1689     .
     1690     release buf_clients no-error.
     1691     if error-status:error then do:
     1692       message
     1693       vss-workfile vss-revision vss-description skip
     1694       "Ошибка при сохранении записи КЛИЕНТА" skip
     1695       ERROR-STATUS:GET-NUMBER(1) skip
     1696       return-value
     1697       view-as alert-box .
     1698       undo main-block, return error "":U.
     1699     end.
     1700     release buf_person no-error.
     1701     if error-status:error then do:
     1702       message
     1703       vss-workfile vss-revision vss-description skip
     1704       "Ошибка при сохранении записи ЧЕЛОВЕКА" skip
     1705       ERROR-STATUS:GET-NUMBER(1) skip
     1706       return-value
     1707       view-as alert-box .
     1708       undo main-block, return error "":U.
     1709     end.
     1710     if p-mode = 'ДОБАВЛЕНИЕ':U
     1711     and lookup(p-callpoint, 'C,S':U) > 0
     1712     then do:
     1713       run request-proc-save-staff in p-parent-handle (
     1714                                                         input this-procedure:handle
     1715                                                        ,input p-mode
     1716                                                        ,input p-callpoint) no-error.
     1717       if error-status:error then do:
     1718         undo main-block, return error return-value .
     1719       end.
     1720     end.
     1721   end.
     1722   procedure chk-code :
     1723   define output parameter p-is-correct as logical no-undo .
     1724   define variable v-rid as recid no-undo .
     1725   define variable glog as logical no-undo .
     1726   define variable v-stts as character no-undo .
     1727   define variable v2-db-num like ub.db.db-num no-undo .
     1728   define variable ii as integer no-undo .
     1729   define variable v-result as logical no-undo .
     1730   define buffer buf_clients for ub.clients.
     1731   define buffer buf_person for ub.person.
     1732   define buffer buf_code-range for ub.code-range.
     1733   do
     1734   on error undo, return error return-value
     1735   :
     1736     if p-mode = 'ДОБАВЛЕНИЕ':U then do:
     1737       if p-psn-code = 0 then do:
     1738         run gen-b-code in this-procedure ( input 'pngb':U, output p-psn-code) no-error .
     1739         if error-status:error then do:
     1740           assign
     1741           v-err-mess = substitute("Ошибка при получении кода физ.лица для нового контрагента&1&2&1&3"
     1742                                 , chr(10)
     1743                                 , error-status:get-message(1)
     1744                                 , return-value ).
     1745           run err-mess ( input-output v-err-mess ).
     1746           undo, return  error (if p-silent then v-err-mess else "psn-code":U).
     1747         end.
     1748       end.
     1749       else do:
     1750         v-result = calc-range(
     1751                           input v-db-num
     1752                           ,input p-psn-code
     1753                           ,input 'pngb':U
     1754                           )
     1755        no-error .
     1756        if v-result = ?  then  do:
     1757           assign
     1758           v-err-mess = substitute("Не найден диапапазон контрагентов для кода контрагента &1 в БД &2", p-psn-code, v-db-num).
     1759           run err-mess ( input-output v-err-mess ).
     1760           undo, return  error (if p-silent then v-err-mess else "psn-code":U).
     1761        end.
     1762        if v-result = no and v-import = no then  do:
     1763           assign
     1764           v-err-mess = substitute("Вы не можете САМОСТОЯТЕЛЬНО определить код НОВОГО физ.лица = &1", p-psn-code).
     1765           run err-mess ( input-output v-err-mess ).
     1766           undo, return  error (if p-silent then v-err-mess else "psn-code":U).
     1767         end.
     1768       end.
     1769       if p-psn-code = 0 then  do:
     1770         assign
     1771         v-err-mess = "Код физ.лица не может быть равен 0".
     1772         run err-mess ( input-output v-err-mess).
     1773         undo, return error (if p-silent then v-err-mess else "":U).
     1774       end.
     1775       define buffer another_person for ub.person.
     1776       find first another_person no-lock where
     1777                another_person.psn-code = p-psn-code  no-error.
     1778       if available another_person then do:
     1779         assign
     1780         v-err-mess = substitute("Человек с кодом &1 уже есть", p-psn-code).
     1781         run err-mess ( input-output v-err-mess ).
     1782         undo, return error (if p-silent then v-err-mess else "psn-code":U).
     1783       end.
     1784       assign
     1785       p-is-correct = yes
     1786       .
     1787     end.
     1788   end.
     1789   end procedure.
     1790   procedure chk-name :
     1791   DEFINE INPUT PARAMETER p-psn-code like ub.person.psn-code no-undo.
     1792   define output parameter p-is-correct as logical no-undo .
     1793   DEFINE buffer buf_person for ub.person.
     1794     do
     1795     on error undo, return error
     1796     :
     1797       if p-obj-name  = ""
     1798       or p-obj-name = ?
     1799       then do:
     1800         assign
     1801         v-err-mess = "Нет фамилии".
     1802         run err-mess ( input-output v-err-mess).
     1803         undo, return (if p-silent then v-err-mess else "obj-name":U).
     1804       end.
     1805       assign
     1806       p-is-correct = yes
     1807       .
     1808     end.
     1809   end procedure.
     1810   PROCEDURE err-mess:
     1811     DEFINE INPUT-OUTPUT PARAMETER p-mess as character No-UNDO.
     1812     CASE p-silent:
     1813       when yes then do:
     1814         p-mess = substitute("Клиент чел&1: &2", p-psn-code,  p-mess).
     1815       end.
     1816       when no then do:
     1817         message
     1818         p-mess
     1819         view-as alert-box error .
     1820       end.
     1821     end.
     1822   END PROCEDURE.
     1823   procedure proc-save-staff :
     1824   define input parameter p-role as character no-undo .
     1825   define input parameter p-staff-code as integer no-undo .
     1826   define input parameter p-level as character no-undo .
     1827   define input parameter p-role-db-num as character no-undo .
     1828   define input parameter p-role-host-code as integer no-undo .
     1829   define input parameter p-role-obj-type as character no-undo .
     1830   define input parameter p-role-obj-code as integer no-undo .
     1831   define input parameter p-staff-password as character no-undo .
     1832   define input parameter p-date-start as date no-undo .
     1833   define input parameter p-date-end as date no-undo .
     1834   define input parameter p-work-place as character no-undo .
     1835   define variable v-rid as recid no-undo .
     1836   define variable v-role-rid as recid no-undo .
     1837   define buffer buf_staff for ub.staff.
     1838     do
     1839     on error undo, return error return-value
     1840     :
     1841       if p-role = p-callpoint then v-role-ii = v-role-ii + 1.
     1842       find first buf_staff where
     1843                   buf_staff.role = p-role
     1844               and buf_staff.role-level = p-level
     1845             and  buf_staff.psn-code = p-psn-code
     1846             and buf_staff.staff-code = p-staff-code
     1847             and buf_staff.work-place = p-work-place no-error .
     1848       if not available buf_staff then do:
     1849         run ref/staff01.p (
     1850                        input-output v-rid
     1851                       ,input p-mode
     1852                       ,input p-silent
     1853                       ,input p-role
     1854                       ,input p-staff-code
     1855                       ,input p-psn-code
     1856                       ,input p-level
     1857                       ,input p-date-start
     1858                       ,input p-date-end
     1859                       ,input p-role-db-num
     1860                       ,input p-role-host-code
     1861                       ,input p-role-obj-type
     1862                       ,input p-role-obj-code
     1863                       ,input p-work-place
     1864                       ,input p-staff-password) no-error .
     1865         if error-status:error then do:
     1866           undo , return error return-value .
     1867         end.
     1868         if v-role-ii = 1
     1869         and p-role = p-callpoint
     1870         then v-role-rid = v-rid.
     1871       end.
     1872       if v-role-rid <> ? then
     1873       p-rid = v-role-rid.
     1874     end.
     1875   end procedure.
