     2626     ,output sort-phrase-25
     2627     ,output where-phrase-rus-25
     2628     ,output sort-phrase-rus-25
     2629     ).
     2630       run set-filter-name in this-procedure
     2631         (INPUT filter-name-25
     2632         ) no-error .
     2633     assign
     2634       l-filter-open-25 = false
     2635     .
     2636     if flt-rec-25 <> ?
     2637       or sort-column-phrase > ""
     2638     then do:
     2639       define variable  parameter-2-25 as character no-undo .
     2640       define variable  parameter-3-25 as character no-undo .
     2641       define variable  parameter-4-25 as character no-undo .
     2642       define variable  parameter-5-25 as character no-undo .
     2643       define variable  parameter-6-25 as character no-undo .
     2644       define variable  parameter-7-25 as character no-undo .
     2645         assign
     2646         parameter-3-25 =
     2647                                 "FOR EACH X_place-io"
     2648         parameter-4-25 =
     2649           (
     2650             if (" X_place-io.obj-type = p-obj-type AND X_place-io.obj-code = p-obj-code and X_place-io.place-io-type = p-type " + " " + where-phrase-25) <> ""
     2651             then  substitute(' X_place-io.obj-type = &4&1&4 AND X_place-io.obj-code  = &2 and X_place-io.place-io-type = &4&3&4 ', p-obj-type, p-obj-code, p-type, chr(34))  + " " + where-phrase-25
     2652             else "true"
     2653           )
     2654         parameter-5-25 = (" " + "" + " " + "")
     2655         parameter-6-25 = if sort-phrase-25 = ''
     2656                              then
     2657           (
     2658           " " + "  " +
     2659             " " + sort-column-phrase +
     2660           " " + "  "
     2661           )
     2662                              else
     2663           (
     2664           " " + "  " +
     2665             " " + sort-column-phrase +
     2666           " " + sort-phrase-25
     2667           )
     2668         parameter-7-25 =
     2669           " indexed-reposition  "
     2670       .
     2671       do
     2672       on stop undo, leave
     2673       on error undo, leave
     2674       :
     2675         assign
     2676           l-disable-where-25 =
     2677             (" X_place-io.obj-type = p-obj-type AND X_place-io.obj-code = p-obj-code and X_place-io.place-io-type = p-type " + " " + where-phrase-25 = "")
     2678         .
     2679         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2680                             ,input QUERY br-pl:handle
     2681                             ,input parameter-3-25
     2682                             ,input parameter-4-25
     2683                             ,input parameter-5-25
     2684                             ,input parameter-6-25
     2685                             ,input parameter-7-25
     2686                             )
     2687         .
     2688         assign
     2689           l-filter-open-25 = true
     2690         .
     2691       end.
     2692       if l-filter-open-25 = false then do:
     2693         message
     2694           "Ошибка при фильтрации / сортировке" skip
     2695           "Будут показаны записи без учета фильтра" skip
     2696           view-as alert-box .
     2697       end.
     2698       else do:
     2699           assign
     2700             l-query-was-opened = true
     2701           .
     2702       end.
     2703     end.
     2704     if l-filter-open-25 = false then do:
     2705       OPEN QUERY br-pl FOR EACH X_place-io
     2706         where  X_place-io.obj-type = p-obj-type AND X_place-io.obj-code = p-obj-code and X_place-io.place-io-type = p-type
     2707         indexed-reposition
     2708     .
     2709         assign
     2710           l-query-was-opened = true
     2711         .
     2712     end.
     2713     run waitfram-hide in this-procedure .
     2714         end.
     2715       end.
     2716       when 'все':U then do:
     2717         if p-type = 'all' then do:
     2718           ASSIGN frame d-pl-list:TITLE = "Места приемки/отгрузки "    filter-point = "Места приемки/отгрузки" + p-mode .
     2719   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2720   define variable  l-disable-where-27  as logical   no-undo .
     2721   define variable  l-filter-open-27    as logical   .
     2722   define variable  flt-rec-27       as recid     no-undo .
     2723   define variable  filter-name-27      as character no-undo .
     2724   define variable  where-phrase-27     as character no-undo .
     2725   define variable  sort-phrase-27      as character no-undo .
     2726   define variable  where-phrase-rus-27 as character no-undo .
     2727   define variable  sort-phrase-rus-27  as character no-undo .
     2728     run waitfram-show in this-procedure
     2729       (input "ЖДИТЕ ..."
     2730       ).
     2731   run gbl/flt-get.p
     2732     (input filter-point
     2733     ,output flt-rec-27
     2734     ,output filter-name-27
     2735     ,output where-phrase-27
     2736     ,output sort-phrase-27
     2737     ,output where-phrase-rus-27
     2738     ,output sort-phrase-rus-27
     2739     ).
     2740       run set-filter-name in this-procedure
     2741         (INPUT filter-name-27
     2742         ) no-error .
     2743     assign
     2744       l-filter-open-27 = false
     2745     .
     2746     if flt-rec-27 <> ?
     2747       or sort-column-phrase > ""
     2748     then do:
     2749       define variable  parameter-2-27 as character no-undo .
     2750       define variable  parameter-3-27 as character no-undo .
     2751       define variable  parameter-4-27 as character no-undo .
     2752       define variable  parameter-5-27 as character no-undo .
     2753       define variable  parameter-6-27 as character no-undo .
     2754       define variable  parameter-7-27 as character no-undo .
     2755         assign
     2756         parameter-3-27 =
     2757                                 "FOR EACH X_place-io"
     2758         parameter-4-27 =
     2759           (
     2760             if (" TRUE " + " " + where-phrase-27) <> ""
     2761             then  substitute(' TRUE ')  + " " + where-phrase-27
     2762             else "true"
     2763           )
     2764         parameter-5-27 = (" " + "" + " " + "")
     2765         parameter-6-27 = if sort-phrase-27 = ''
     2766                              then
     2767           (
     2768           " " + "  " +
     2769             " " + sort-column-phrase +
     2770           " " + "  "
     2771           )
     2772                              else
     2773           (
     2774           " " + "  " +
     2775             " " + sort-column-phrase +
     2776           " " + sort-phrase-27
     2777           )
     2778         parameter-7-27 =
     2779           " indexed-reposition  "
     2780       .
     2781       do
     2782       on stop undo, leave
     2783       on error undo, leave
     2784       :
     2785         assign
     2786           l-disable-where-27 =
     2787             (" TRUE " + " " + where-phrase-27 = "")
     2788         .
     2789         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2790                             ,input QUERY br-pl:handle
     2791                             ,input parameter-3-27
     2792                             ,input parameter-4-27
     2793                             ,input parameter-5-27
     2794                             ,input parameter-6-27
     2795                             ,input parameter-7-27
     2796                             )
     2797         .
     2798         assign
     2799           l-filter-open-27 = true
     2800         .
     2801       end.
     2802       if l-filter-open-27 = false then do:
     2803         message
     2804           "Ошибка при фильтрации / сортировке" skip
     2805           "Будут показаны записи без учета фильтра" skip
     2806           view-as alert-box .
     2807       end.
     2808       else do:
     2809           assign
     2810             l-query-was-opened = true
     2811           .
     2812       end.
     2813     end.
     2814     if l-filter-open-27 = false then do:
     2815       OPEN QUERY br-pl FOR EACH X_place-io
     2816         where  TRUE
     2817         indexed-reposition
     2818     .
     2819         assign
     2820           l-query-was-opened = true
     2821         .
     2822     end.
     2823     run waitfram-hide in this-procedure .
     2824         end.
     2825         else do:
     2826           if p-type = 'приемки':U then ASSIGN frame d-pl-list:TITLE = "Места приемки "   filter-point = "Места приемки " + p-mode .
     2827           else                         ASSIGN frame d-pl-list:TITLE = "Места отгрузки "  filter-point = "Места отгрузки " + p-mode .
     2828   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2829   define variable  l-disable-where-29  as logical   no-undo .
     2830   define variable  l-filter-open-29    as logical   .
     2831   define variable  flt-rec-29       as recid     no-undo .
     2832   define variable  filter-name-29      as character no-undo .
     2833   define variable  where-phrase-29     as character no-undo .
     2834   define variable  sort-phrase-29      as character no-undo .
     2835   define variable  where-phrase-rus-29 as character no-undo .
     2836   define variable  sort-phrase-rus-29  as character no-undo .
     2837     run waitfram-show in this-procedure
     2838       (input "ЖДИТЕ ..."
     2839       ).
     2840   run gbl/flt-get.p
     2841     (input filter-point
     2842     ,output flt-rec-29
     2843     ,output filter-name-29
     2844     ,output where-phrase-29
     2845     ,output sort-phrase-29
     2846     ,output where-phrase-rus-29
     2847     ,output sort-phrase-rus-29
     2848     ).
     2849       run set-filter-name in this-procedure
     2850         (INPUT filter-name-29
     2851         ) no-error .
     2852     assign
     2853       l-filter-open-29 = false
     2854     .
     2855     if flt-rec-29 <> ?
     2856       or sort-column-phrase > ""
     2857     then do:
     2858       define variable  parameter-2-29 as character no-undo .
     2859       define variable  parameter-3-29 as character no-undo .
     2860       define variable  parameter-4-29 as character no-undo .
     2861       define variable  parameter-5-29 as character no-undo .
     2862       define variable  parameter-6-29 as character no-undo .
     2863       define variable  parameter-7-29 as character no-undo .
     2864         assign
     2865         parameter-3-29 =
     2866                                 "FOR EACH X_place-io"
     2867         parameter-4-29 =
     2868           (
     2869             if (" X_place-io.place-io-type = p-type " + " " + where-phrase-29) <> ""
     2870             then  substitute(' X_place-io.place-io-type = &2&1&2 ', p-type, chr(34))  + " " + where-phrase-29
     2871             else "true"
     2872           )
     2873         parameter-5-29 = (" " + "" + " " + "")
     2874         parameter-6-29 = if sort-phrase-29 = ''
     2875                              then
     2876           (
     2877           " " + "  " +
     2878             " " + sort-column-phrase +
     2879           " " + "  "
     2880           )
     2881                              else
     2882           (
     2883           " " + "  " +
     2884             " " + sort-column-phrase +
     2885           " " + sort-phrase-29
     2886           )
     2887         parameter-7-29 =
     2888           " indexed-reposition  "
     2889       .
     2890       do
     2891       on stop undo, leave
     2892       on error undo, leave
     2893       :
     2894         assign
     2895           l-disable-where-29 =
     2896             (" X_place-io.place-io-type = p-type " + " " + where-phrase-29 = "")
     2897         .
     2898         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2899                             ,input QUERY br-pl:handle
     2900                             ,input parameter-3-29
     2901                             ,input parameter-4-29
     2902                             ,input parameter-5-29
     2903                             ,input parameter-6-29
     2904                             ,input parameter-7-29
     2905                             )
     2906         .
     2907         assign
     2908           l-filter-open-29 = true
     2909         .
     2910       end.
     2911       if l-filter-open-29 = false then do:
     2912         message
     2913           "Ошибка при фильтрации / сортировке" skip
     2914           "Будут показаны записи без учета фильтра" skip
     2915           view-as alert-box .
     2916       end.
     2917       else do:
     2918           assign
     2919             l-query-was-opened = true
     2920           .
     2921       end.
     2922     end.
     2923     if l-filter-open-29 = false then do:
     2924       OPEN QUERY br-pl FOR EACH X_place-io
     2925         where  X_place-io.place-io-type = p-type
     2926         indexed-reposition
     2927     .
     2928         assign
     2929           l-query-was-opened = true
     2930         .
     2931     end.
     2932     run waitfram-hide in this-procedure .
     2933         end.
     2934       end.
     2935     END CASE.
     2936     if v-doc-rec <> ? then reposition br-pl to recid v-doc-rec no-error.
     2937     apply "entry" to br-pl in frame d-pl-list.
     2938     if avail X_place-io then APPLY "VALUE-CHANGED":U to br-pl.
     2939     run waitfram-hide in this-procedure .
     2940     apply "value-changed" to br-pl in frame d-pl-list.
     2941   END PROCEDURE.
