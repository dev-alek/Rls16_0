      120   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      121   define variable c-point  as character no-undo .
      122   define variable tbl      as character no-undo .
      123   define variable join-tbl as character no-undo .
      124   define variable fld      as character no-undo .
      125   define variable lab      as character no-undo .
      126   define variable spr      as character no-undo .
      127   define variable dim      as character no-undo .
      128   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      129   procedure fltfield-clear :
      130     define output parameter loc-fld as character no-undo.
      131     define output parameter loc-lab as character no-undo .
      132     define output parameter loc-spr as character no-undo .
      133     define output parameter loc-dim as character no-undo .
      134     assign
      135       loc-fld = ""
      136       loc-lab = ""
      137       loc-spr = ""
      138       loc-dim = "0"
      139     .
      140   end procedure .
      141   procedure fltfield-add :
      142     define input        parameter par-fld as character no-undo.
      143     define input        parameter par-lab as character no-undo .
      144     define input        parameter par-spr as character no-undo .
      145     define input-output parameter loc-fld as character no-undo.
      146     define input-output parameter loc-lab as character no-undo .
      147     define input-output parameter loc-spr as character no-undo .
      148     define input-output parameter loc-dim as character no-undo .
      149     do
      150     on error undo, return error
      151     :
      152       assign
      153       loc-fld = if loc-dim = '0'
      154                 then par-fld
      155                 else (loc-fld + chr(44) + par-fld)
      156       loc-lab = if loc-dim = '0'
      157                 then par-lab
      158                 else (loc-lab + chr(44) + par-lab)
      159       loc-spr = if loc-dim = '0'
      160                 then par-spr
      161                 else (loc-spr + chr(44) + par-spr)
      162       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      163                 string(integer(if num-entries(loc-dim) > 1
      164                               then entry(2, loc-dim)
      165                               else entry(1, loc-dim)
      166                               ) + 1)
      167       no-error
      168       .
      169     end.
      170   end procedure.
      171   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      172   define variable v-waitfram-action01         as character   no-undo .
      173   define variable v-waitfram-action02         as character   no-undo .
      174   define variable v-waitfram-action03         as character   no-undo .
      175   define variable mWaitFramTextBeg            as character   no-undo.
      176   define variable mWaitFramTextEnd            as character   no-undo.
      177   define variable mWaitFramView               as logical     no-undo.
      178   define variable mWaitProcEvent              as logical     no-undo init yes.
      179   define variable mWaitFramInterval           as integer     no-undo init 1 .
      180   define variable mWaitFramStop               as logical     no-undo.
      181   define variable mWaitFramStopUser           as logical     no-undo.
      182   define variable mWaitFramStopTimeOut        as logical     no-undo.
      183   define variable mWaitFramStartProc          as datetime-tz no-undo.
      184   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      185   define button B-WaitFramStop auto-end-key
      186        label "Стоп"
      187        size 10 by 1 tooltip "Остоновить процесс".
      188   define button B-viewProcInfo
      189        label "Информация"
      190        size 15 by 1 tooltip "Информация о процесс".
      191   define frame waitfram
      192     v-waitfram-action01 format "x(72)" no-label skip
      193     v-waitfram-action02 format "x(72)" no-label skip
      194     v-waitfram-action03 format "x(72)" no-label skip
      195     B-viewProcInfo
      196     B-WaitFramStop at row 4 col 30
      197     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      198     .
      199   define new global shared variable mBatchMode as logical no-undo init ?.
      200   define variable mFramBachModHandle as handle no-undo.
      201   mFramBachModHandle = frame waitfram:handle.
      202   define variable mFameOldVis as logical no-undo.
      203   define variable mVisCUrentVin as logical no-undo.
      204   if session:batch-mode
      205   then
      206      mBatchMode = yes.
      207   if mBatchMode = ? then do:
      208     mVisCUrentVin = current-window:visible.
      209     mFameOldVis = mFramBachModHandle:visible.
      210     mFramBachModHandle:visible  = yes.
      211     mBatchMode = mFramBachModHandle:visible ne yes.
      212     mFramBachModHandle:visible = mFameOldVis.
      213     current-window:visible = mVisCUrentVin.
      214   end.
      215    if  log-manager:logfile-name ne ?
      216     then DO:
      217         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      218         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      219         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      220     end.
      221   on choose of B-WaitFramStop in frame waitfram
      222   do:
      223     mWaitFramStop = yes.
      224     mWaitFramStopUser = yes.
      225   end.
      226   function waitfram-check-timeout returns logical():
      227      define variable vtime as int64 no-undo.
      228      if mWaitFramStopTimeOut
      229      then
      230         return yes.
      231      vtime = ( now - mWaitFramStartProc ) / 1000 .
      232      if     mWaitFramTimeOut ne ?
      233         and mWaitFramTimeOut ne 0
      234         and mWaitFramTimeOut lt vtime
      235      then do:
      236         mWaitFramStopTimeOut = yes.
      237      end.
      238      return mWaitFramStopTimeOut.
      239   end.
      240   procedure waitfram-hide :
      241     if not session:batch-mode
      242     then do
      243     on error undo, return error return-value
      244     :
      245       pause 0 before-hide .
      246       if not mBatchMode then
      247         hide frame waitfram .
      248     if     not mWaitFramView
      249        and mWaitProcEvent
      250     then
      251       process events .
      252     end.
      253   end procedure.
      254   procedure waitfram-show :
      255     define input  parameter p-message as character no-undo .
      256     define variable v-left-margin as integer   no-undo .
      257     if not session:batch-mode
      258     then do
      259     on error undo, return error return-value
      260     :
      261       if length(p-message) <= 70 then do:
      262         assign
      263           v-left-margin = integer((70 - length(p-message)) / 2)
      264         .
      265         assign
      266           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      267         .
      268         assign
      269           v-waitfram-action01 = " "
      270           v-waitfram-action02 = " "
      271                                    + fill(" ", v-left-margin)
      272                                    + p-message
      273           v-waitfram-action03 = " "
      274         .
      275       end.
      276       else do:
      277         define variable vRindex1 as integer no-undo.
      278         define variable vRindex2 as integer no-undo.
      279         vRindex1 = r-index(p-message," ",70).
      280         if vRindex1 = 0
      281         then
      282            vRindex1 = 70.
      283         if length(p-message)  <= vRindex1 + 70 then do:
      284           assign
      285             v-waitfram-action01 = " "
      286             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      287             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      288           .
      289         end.
      290         else do:
      291           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      292           if vRindex2 <= vRindex1
      293           then
      294              vRindex2 = vRindex1 + 70.
      295           assign
      296             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      297             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      298             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      299           .
      300         end.
      301       end.
      302       B-viewProcInfo:visible   in frame waitfram = no.
      303       B-viewProcInfo:sensitive in frame waitfram = no.
      304       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      305       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      306       if  (   mWaitFramView
      307          or  mWaitProcEvent)
      308          and not mBatchMode
      309       then
      310          display
      311             v-waitfram-action01 skip
      312             v-waitfram-action02 skip
      313             v-waitfram-action03 skip
      314          with frame waitfram .
      315       if     mWaitFramView
      316          then do:
      317             if     mWaitFramInterval ne ?
      318                and not mBatchMode
      319             then
      320                wait-for go of frame waitfram pause mWaitFramInterval.
      321          end.
      322          else
      323             if     mWaitProcEvent
      324                and not mBatchMode
      325             then
      326                process events .
      327     end.
      328   end procedure.
      329      procedure waitfram-show-this:
      330         define input  parameter iInterval as int64 no-undo.
      331         define variable vtime as int64 no-undo.
      332         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      333         mWaitFramInterval = iInterval.
      334         run waitfram-show (substitute("&1&2 &3&4" ,
      335                                       mWaitFramTextBeg ,
      336                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      337                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      338                                       mWaitFramTextEnd
      339                                      )
      340                           ).
      341      end.
      342      procedure WaitFramRunPause:
      343         define input  parameter iInterval as dec no-undo.
      344         define variable vStart  as datetime-tz no-undo.
      345         define variable vend    as datetime-tz no-undo.
      346         define variable vint as int64 no-undo.
      347         define variable vOk as logical no-undo.
      348         vStart = now.
      349         vend   = vStart.
      350         publish "WaitFramPause" (iInterval,output vOk).
      351         vend   =  now.
      352         vint = vend - vStart.
      353         vint = iInterval - vint / 1000.
      354         if     not mWaitFramStop
      355            and (   vint > 0
      356                 or (    not vOk
      357                     and iInterval eq ?
      358                     )
      359                 )
      360         then
      361            run waitfram-show-this (iInterval).
      362         vend   =  now.
      363         vint = vend - vStart.
      364         vint = iInterval - vint / 1000.
      365         if     not mWaitFramStop
      366            and vint > 0
      367         then do:
      368            run gbl/pause.p (vint * 1000).
      369         end.
      370         if iInterval ne ?
      371         then
      372            publish "WaitFramStop".
      373         waitfram-check-timeout().
      374      end.
      375      procedure WaitFramWaitFor:
      376         define input  parameter iInterval as dec no-undo.
      377         assign
      378            mWaitFramStartProc   = now
      379            mWaitFramStopUser    = no
      380            mWaitFramStopTimeOut = no
      381         .
      382         block-wait:
      383         do while not mWaitFramStop:
      384            run WaitFramRunPause (iInterval).
      385            if  waitfram-check-timeout()
      386            then do:
      387               leave block-wait.
      388            end.
      389         end.
      390         run waitfram-hide.
      391      end.
      392   procedure waitfram-join :
      393     define input  parameter p-line-1  as character no-undo .
      394     define input  parameter p-line-2  as character no-undo .
      395     define input  parameter p-line-3  as character no-undo .
      396     define output parameter p-message as character no-undo .
      397     do
      398     on error undo, return error return-value
      399     :
      400       assign
      401         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      402                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      403                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      404       .
      405     end.
      406   end procedure.
      407   function waitfram-join-function returns character
      408     (input p-line-1 as character
      409     ,input p-line-2 as character
      410     ,input p-line-3 as character
      411     ).
      412     define variable v-message as character no-undo .
      413     run waitfram-join in this-procedure
      414       (input  p-line-1
      415       ,input  p-line-2
      416       ,input  p-line-3
      417       ,output v-message
      418       ) .
      419     return v-message .
      420   end function .
      421   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      422     define variable v-cntxt-db-num        as integer   no-undo .
      423     define variable v-cntxt-userid        as character no-undo .
      424     define variable v-cntxt-level         as character no-undo .
      425     define variable v-cntxt-host-code-obj as integer   no-undo .
      426     define variable v-cntxt-obj-type      as character no-undo .
      427     define variable v-cntxt-obj-code      as integer   no-undo .
      428     define variable v-cntxt-db-num-obj    as integer   no-undo .
      429     define variable v-cntxt-is-admin      as logical   no-undo .
      430   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      431   define variable v-fltopend-rowid as rowid extent 18 no-undo .
      432   procedure fltopend_fltopend :
      433   define input parameter p-parent-handle as handle no-undo .
      434   define input parameter p-qh as handle no-undo .
      435   define input parameter p-flt-open-open-query  as character no-undo .
      436   define input parameter p-where-cond as character no-undo .
      437   define input parameter p-use-indFIRST-query-tail as character no-undo .
      438   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      439   define input parameter p-indexed-reposition as character no-undo .
      440     do
      441     on error undo, return error
      442     :
      443   define variable v-prepare-string as character no-undo .
      444   define variable glog as logical no-undo .
      445   assign
      446   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      447                      p-where-cond + chr(32)  +
      448                      p-use-indFIRST-query-tail + chr(32) +
      449                      p-use-ind-sort-clmn-by + chr(32) +
      450                      p-indexed-reposition
      451   .
      452   assign
      453   glog = p-qh:query-prepare(v-prepare-string) no-error .
      454   if not glog
      455   or error-status:error then do:
      456     message error-status:get-message(1) view-as alert-box .
      457     undo, return error .
      458   end.
      459   assign
      460   glog = p-qh:query-open no-error .
      461   if not glog
      462   or error-status:error then do:
      463     message error-status:get-message(1) view-as alert-box .
      464     undo, return error .
      465   end.
      466     end.
      467   end procedure.
      468   procedure fltopend_fltfindd :
      469   define input parameter p-parent-handle as handle no-undo .
      470   define input parameter p-qh as handle no-undo .
      471   define input parameter p-rowid as rowid no-undo .
      472   define input parameter p-next as logical no-undo .
      473   define input parameter p-lock as integer no-undo .
      474   define input parameter p-bh as handle no-undo .
      475   define input parameter p-where-cond as character no-undo .
      476   define input parameter p-use-index-phrase as character no-undo .
      477   define variable glog as logical no-undo .
      478   define variable v-qh as handle no-undo .
      479   define variable v-bh as handle no-undo .
      480   define variable v-recid as recid no-undo .
      481   define variable v-prepare-string as character no-undo .
      482   do
      483   on error undo, return error
      484   on stop undo, return error
      485   :
      486     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      487     create buffer v-bh for table p-bh buffer-name p-bh:name.
      488     create query v-qh.
      489     v-qh:set-buffers(v-bh).
      490     v-prepare-string = substitute("for each &1 &2 &3"
      491                                     ,v-bh:name
      492                                     ,p-where-cond
      493                                     ,p-use-index-phrase).
      494     glog = v-qh:query-prepare(v-prepare-string) no-error.
      495     if not glog then do:
      496       delete object v-qh.
      497       delete object v-bh.
      498       undo, return error .
      499     end.
      500     glog = v-qh:query-open no-error .
      501     if not glog then do:
      502       delete object v-qh.
      503       delete object v-bh.
      504       undo, return error .
      505     end.
      506     if p-next then do:
      507       v-qh:reposition-to-rowid(p-rowid) no-error .
      508       glog = v-qh:get-next( p-lock) no-error .
      509       glog = v-qh:get-next( p-lock) no-error .
      510       if not glog or v-qh:query-off-end = yes then do:
      511         glog = v-qh:get-first( p-lock) no-error .
      512       end.
      513     end.
      514     else do:
      515       glog = v-qh:get-first( p-lock) no-error .
      516     end.
      517     v-recid = v-bh:recid no-error .
      518     delete object v-qh.
      519     delete object v-bh.
      520     return string(v-recid) .
      521   end.
      522   end procedure.
      523   procedure fltopend_fltfindq :
      524   define input parameter p-parent-handle as handle no-undo .
      525   define input parameter p-qh as handle no-undo .
      526   define input parameter p-next as logical no-undo .
      527   define input parameter p-lock as integer no-undo .
      528   define input parameter p-flt-open-open-query  as character no-undo .
      529   define input parameter p-where-cond as character no-undo .
      530   define input parameter p-use-indFIRST-query-tail as character no-undo .
      531   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      532   define input parameter p-indexed-reposition as character no-undo .
      533   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      534   define variable glog as logical no-undo .
      535   define variable v-qh as handle no-undo .
      536   define variable v-bh as handle no-undo extent 18.
      537   define variable v-rowid as rowid no-undo extent 18.
      538   define variable v-ii as integer no-undo .
      539   define variable v-prepare-string as character no-undo .
      540   do
      541   on error undo, return error
      542   on stop undo, return error
      543   :
      544     create query v-qh.
      545     do v-ii = 1 to p-qh:num-buffers:
      546       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      547       assign
      548       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      549       no-error.
      550       v-qh:add-buffer(v-bh[v-ii]).
      551     end.
      552     assign
      553     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      554                       p-where-cond + chr(32)  +
      555                       p-use-indFIRST-query-tail + chr(32) +
      556                       p-use-ind-sort-clmn-by + chr(32) +
      557                       p-indexed-reposition
      558     .
      559     glog = v-qh:query-prepare( v-prepare-string) no-error .
      560     if not glog then do:
      561       delete object v-qh.
      562       do v-ii = 1 to p-qh:num-buffers:
      563         delete object v-bh[v-ii].
      564       end.
      565       undo, return error .
      566     end.
      567     glog = v-qh:query-open no-error .
      568     if not glog then do:
      569       delete object v-qh.
      570       do v-ii = 1 to p-qh:num-buffers:
      571         delete object v-bh[v-ii].
      572       end.
      573       undo, return error .
      574     end.
      575     if p-next then do:
      576       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
      577       glog = v-qh:get-next( p-lock) no-error .
      578       glog = v-qh:get-next( p-lock) no-error .
      579       if not glog or v-qh:query-off-end = yes then do:
      580         glog = v-qh:get-first( p-lock) no-error .
      581       end.
      582     end.
      583     else do:
      584       glog = v-qh:get-first( p-lock) no-error .
      585     end.
      586     do v-ii = 1 to p-qh:num-buffers:
      587       assign
      588       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
      589       no-error.
      590     end.
      591     delete object v-qh.
      592     do v-ii = 1 to p-qh:num-buffers:
      593       delete object v-bh[v-ii].
      594     end.
      595   end.
      596   end procedure.
      597   define variable filter-point as character no-undo init "Места приемки/отгрузки" .
      598   define variable sort-column-name as character no-undo .
      599   define variable mark as char no-undo.
      600   define variable v-doc-rec as recid no-undo .
      601   define variable  p-sys-time     as character no-undo .
      602     define variable glog as logical no-undo .
      603   DEFINE BUTTON b-add
      604        LABEL "&Добавить"
      605        SIZE 10 BY 1.
      606   DEFINE BUTTON b-chg
      607        LABEL "&Изменить"
      608        SIZE 10 BY 1.
      609   DEFINE BUTTON b-del
      610        LABEL "&Удалить"
      611        SIZE 10 BY 1.
      612   DEFINE BUTTON b-help
      613        LABEL "&Помощь"
      614        SIZE 10 BY 1.
      615   DEFINE BUTTON B-hist
      616        LABEL "Ис&тория"
      617        SIZE 10 BY 1.
      618   DEFINE BUTTON B-mark
      619        LABEL "*"
      620        SIZE 3 BY 1.
      621   DEFINE BUTTON b-print
      622        LABEL "Пе&чать"
      623        SIZE 10 BY 1.
      624   DEFINE BUTTON b-quit AUTO-END-KEY
      625        LABEL "&Выход "
      626        SIZE 10 BY 1.
      627   DEFINE BUTTON B-sch
      628        LABEL "&Фильтр"
      629        SIZE 10 BY 1.
      630   DEFINE BUTTON b-sel AUTO-GO
      631        LABEL "Вы&бор "
      632        SIZE 10 BY 1.
      633   DEFINE VARIABLE e_PS LIKE X_place-io.PS
      634        VIEW-AS EDITOR
      635        SIZE 98.5 BY 1.92 NO-UNDO.
      636   DEFINE VARIABLE mark-num AS INTEGER FORMAT ">>>9":U INITIAL 0
      637         VIEW-AS TEXT
      638        SIZE 4.38 BY .67
      639        FGCOLOR 4  NO-UNDO.
      640   DEFINE VARIABLE RADIO-obj AS INTEGER
      641        VIEW-AS RADIO-SET HORIZONTAL
      642        RADIO-BUTTONS
      643             "Текущий", 1,
      644   "Все", 2
      645        SIZE 19.75 BY .88 NO-UNDO.
      646   DEFINE VARIABLE RADIO-type AS INTEGER
      647        VIEW-AS RADIO-SET HORIZONTAL
      648        RADIO-BUTTONS
      649             "Отгрузки", 1,
      650   "Приемки", 2,
      651   "Все", 3
      652        SIZE 29 BY .88 NO-UNDO.
      653   DEFINE QUERY br-pl FOR
      654         X_place-io SCROLLING.
      655   DEFINE QUERY d-pl-list FOR
      656         X_place-io SCROLLING.
      657   DEFINE BROWSE br-pl
      658     QUERY br-pl NO-LOCK DISPLAY
      659         mark COLUMN-LABEL "*" FORMAT "X(1)":U
      660         X_place-io.place-io-type COLUMN-LABEL "Место" FORMAT "X(8)":U
      661         X_place-io.place-io-code FORMAT "9999999":U
      662         X_place-io.place-io-name COLUMN-LABEL "Наименование" FORMAT "X(40)":U
      663         substitute( "&1 &2", X_place-io.obj-type, X_place-io.obj-code ) COLUMN-LABEL "Объект" FORMAT "X(13)":U
      664         X_place-io.status_ FORMAT "X(8)":U
      665     ENABLE
      666         X_place-io.place-io-name
      667       WITH NO-ASSIGN NO-ROW-MARKERS SEPARATORS SIZE 98 BY 17.5.
      668   DEFINE FRAME d-pl-list
      669        b-quit AT ROW 1 COL 1
      670        B-mark AT ROW 1 COL 11
      671        b-sel AT ROW 1 COL 19
      672        b-add AT ROW 1 COL 29
      673        b-chg AT ROW 1 COL 39
      674        b-del AT ROW 1 COL 49
      675        B-sch AT ROW 1 COL 59
      676        B-hist AT ROW 1 COL 69
      677        b-print AT ROW 1 COL 79
      678        b-help AT ROW 1 COL 89
      679        RADIO-obj AT ROW 2.13 COL 10.75 NO-LABEL
      680        RADIO-type AT ROW 2.13 COL 42.88 NO-LABEL
      681        br-pl AT ROW 3 COL 1
      682        e_PS AT ROW 20.5 COL 1 HELP
      683             "" NO-LABEL WIDGET-ID 8
      684        mark-num AT ROW 1.17 COL 12.13 COLON-ALIGNED NO-LABEL
      685        "Объект:" VIEW-AS TEXT
      686             SIZE 8 BY .67 AT ROW 2.25 COL 1.75
      687             FGCOLOR 4
      688        "Места:" VIEW-AS TEXT
      689             SIZE 7 BY .67 AT ROW 2.25 COL 35.5
      690             FGCOLOR 4
      691        SPACE(57.00) SKIP(19.50)
      692       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      693            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      694            TITLE "Места отгрузки/приемки".
      695   ASSIGN
      696          FRAME d-pl-list:SCROLLABLE       = FALSE.
      697   ON CHOOSE OF b-add IN FRAME d-pl-list
      698   DO:
      699     define variable v-rep-rec as recid no-undo .
      700     define variable v-chk-act-host-code as integer   no-undo .
      701   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      702   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      703     (input  p-obj-type
      704     ,input  p-obj-code
      705     ,output v-chk-act-host-code
      706     )  .
      707   define variable vss-include-info7 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      708   do:
      709     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      710       (input  v-cntxt-db-num
      711       ,input  v-cntxt-userid
      712       ,input  0
      713       ,input  'actn_place-io-reference_add-def':U
      714       ,input  'object':U
      715       ,input  v-chk-act-host-code
      716       ,input  p-obj-type
      717       ,input  p-obj-code
      718       ,input  0
      719       ,input  0
      720       ,input  0
      721       ,input  true
      722       ,output glog
      723       )  .
      724   end.
      725     if NOT glog then return no-apply.
      726     run ref/pl-io-fm.w ( input parparentproc, input p-obj-type, input p-obj-code, input 'ДОБАВЛЕНИЕ':U, input-output v-rep-rec).
      727     if v-rep-rec <> ? then do:
      728       RUn OpenBr.
      729       apply "entry" to br-pl in frame d-pl-list.
      730     end.
      731     else do:
      732       apply "entry" to br-pl in frame d-pl-list.
      733       return no-apply.
      734     end.
      735   END.
      736   ON CHOOSE OF b-chg IN FRAME d-pl-list
      737   DO:
      738     define variable v-rep-rec as recid no-undo .
      739     if not available X_place-io then do:
      740       message "Неправильно выбрана строка.".
      741       return no-apply.
      742     end.
      743     v-rep-rec = recid (X_place-io).
      744     define variable v-chk-act-host-code as integer   no-undo .
      745   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      746   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      747     (input  p-obj-type
      748     ,input  p-obj-code
      749     ,output v-chk-act-host-code
      750     )  .
      751   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      752   do:
      753     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      754       (input  v-cntxt-db-num
      755       ,input  v-cntxt-userid
      756       ,input  0
      757       ,input  'actn_place-io-reference_update':U
      758       ,input  'object':U
      759       ,input  v-chk-act-host-code
      760       ,input  p-obj-type
      761       ,input  p-obj-code
      762       ,input  0
      763       ,input  0
      764       ,input  0
      765       ,input  true
      766       ,output glog
      767       )  .
      768   end.
      769     if NOT glog then return no-apply.
      770     run ref/pl-io-fm.w ( input parparentproc, input p-obj-type, input p-obj-code, input 'ИЗМЕНЕНИЕ':U,input-output v-rep-rec).
      771     if v-rep-rec <> ? then do:
      772       RUn OpenBr.
      773       apply "entry" to br-pl in frame d-pl-list.
      774     end.
      775     else do:
      776       apply "entry" to br-pl in frame d-pl-list.
      777       return no-apply.
      778     end.
      779   END.
      780   ON CHOOSE OF b-del IN FRAME d-pl-list
      781   DO:
      782     define variable del-rec as recid no-undo.
      783     define buffer buf_place-io for ub.place-io .
      784     if not available X_place-io then return no-apply.
      785     define variable v-chk-act-host-code as integer   no-undo .
      786   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      787   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      788     (input  p-obj-type
      789     ,input  p-obj-code
      790     ,output v-chk-act-host-code
      791     )  .
      792   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      793   do:
      794     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      795       (input  v-cntxt-db-num
      796       ,input  v-cntxt-userid
      797       ,input  0
      798       ,input  'actn_place-io-reference_deletion':U
      799       ,input  'object':U
      800       ,input  v-chk-act-host-code
      801       ,input  p-obj-type
      802       ,input  p-obj-code
      803       ,input  0
      804       ,input  0
      805       ,input  0
      806       ,input  true
      807       ,output glog
      808       )  .
      809   end.
      810     if NOT glog then return no-apply.
      811     v-doc-rec = recid (X_place-io).
      812     glog = no.
      813     message "Удалить место ? Вы уверены ?" view-as alert-box question buttons OK-Cancel update glog.
      814     if glog <> yes then return no-apply.
      815     glog = br-pl:select-next-row().
      816     if not glog then glog = br-pl:select-prev-row().
      817     del-rec = recid (X_place-io).
      818     find buf_place-io exclusive-lock
      819       where recid (buf_place-io) = v-doc-rec
      820     .
      821   _deletion:
      822     do on stop undo _deletion, return no-apply:
      823       delete buf_place-io.
      824     end.
      825     v-doc-rec = del-rec.
      826     run OpenBr.
      827   END.
      828   ON CHOOSE OF B-hist IN FRAME d-pl-list
      829   DO:
      830     DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
      831     if not available X_place-io then return no-apply.
      832     run ref/pliohist.w ( INPUT parParentProc
      833                        , input X_place-io.obj-type
      834                        , input X_place-io.obj-code
      835                        , input X_place-io.place-io-code
      836                        , input "":U
      837                        , input-output v-rid-list
      838                        ) no-error .
      839       apply "entry" to br-pl.
      840   END.
      841   ON CHOOSE OF B-mark IN FRAME d-pl-list
      842   DO:
      843     if available X_place-io then do:
      844   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      845   define variable v-str-recid13 as character no-undo .
      846   define variable v-num-entry13 as integer   no-undo .
      847   assign
      848     v-str-recid13 = trim( string( recid( X_place-io ) , "->>>>>>>>>>>9":U ) )
      849     v-num-entry13 = lookup( v-str-recid13 , rid-list )
      850   .
      851   if v-num-entry13 > 0 then do:
      852     assign
      853       entry( v-num-entry13, rid-list ) = "":U
      854       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
      855     .
      856   end.
      857   else do:
      858     assign
      859       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid13
      860     .
      861   end.
      862       br-pl:refresh().
      863       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
      864         glog = br-pl:select-next-row ().
      865         apply "iteration-changed" to br-pl in frame d-pl-list.
      866       end.
      867       if num-entries( rid-list ) = 0 then hide mark-num in frame d-pl-list.
      868       else                                disp num-entries( rid-list ) @ mark-num with frame d-pl-list.
      869     end.
      870     apply "entry" to br-pl in frame d-pl-list.
      871   END.
      872   ON CHOOSE OF b-print IN FRAME d-pl-list
      873   DO:
      874     if available X_place-io then do:
      875       message "Еще не реализовано!" view-as alert-box.
      876       return no-apply.
      877     end.
      878   END.
      879   ON CHOOSE OF B-sch IN FRAME d-pl-list
      880   DO:
      881     assign
      882     tbl = 'place-io'
      883     join-tbl = 'X_place-io'
      884     fld = "":U
      885     lab = '':U
      886     spr = '':U
      887     dim = '0':U
      888     .
      889     run fltfield-add in this-procedure ('obj-type*obj-code', 'Объект', 'cli',
      890                                         input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      891     run fltfield-add in this-procedure('place-io-type', 'Тип места', '',
      892                                         input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      893     run fltfield-add in this-procedure('place-io-code', 'Код места', '',
      894                                         input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      895     run fltfield-add in this-procedure('place-io-name', 'Название места', '',
      896                                         input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      897     run fltfield-add in this-procedure('status_', 'Статус', '',
      898                                         input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      899     run fltfield-add in this-procedure('PS', 'Примечание', '',
      900                                         input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
      901     DO on stop undo, leave:
      902       run gbl/filter.w (parparentproc, filter-point, tbl, join-tbl, fld, lab, spr, dim).
      903       RUN OpenBr.
      904     END .
      905   END.
      906   ON CHOOSE OF b-sel IN FRAME d-pl-list
      907   DO:
      908     if ( available X_place-io AND rid-list = "" ) then rid-list = string( recid( X_place-io ) ) .
      909   END.
      910   ON MOUSE-SELECT-DBLCLICK OF br-pl IN FRAME d-pl-list
      911   DO:
      912     apply "CHOOSE" to b-sel in frame d-pl-list.
      913   END.
      914   ON VALUE-CHANGED OF br-pl IN FRAME d-pl-list
      915   DO:
      916     if available X_place-io then do:
      917       assign
      918         e_PS = X_place-io.PS
      919       .
      920       display
      921         e_PS
      922         with frame d-pl-list.
      923     end.
      924   END.
      925   ON VALUE-CHANGED OF RADIO-obj IN FRAME d-pl-list
      926   DO:
      927     assign RADIO-obj .
      928     if RADIO-obj = 1 then do:
      929       assign p-mode = 'объект':U .
      930       if can-do ("b-add", bttns) then  ENABLE b-add  b-chg  b-del with frame d-pl-list.
      931     end.
      932     else do:
      933       assign p-mode = 'все':U .
      934       DISABLE b-add  b-chg  b-del with frame d-pl-list.
      935     end.
      936     RUN OpenBr.
      937     apply "entry" to br-pl .
      938   END.
      939   ON VALUE-CHANGED OF RADIO-type IN FRAME d-pl-list
      940   DO:
      941     assign RADIO-type .
      942     case RADIO-type :
      943       when 3 then assign p-type = 'all' .
      944       when 2 then assign p-type = 'приемки':U .
      945       when 1 then assign p-type = 'отгрузки':U .
      946     end.
      947     RUN OpenBr.
      948     apply "entry" to br-pl .
      949   END.
      950   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME d-pl-list:PARENT eq ?
      951   THEN FRAME d-pl-list:PARENT = ACTIVE-WINDOW.
      952   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      953   on help of frame d-pl-list
      954   do:
      955     run gbl/app_help.p
      956       (input this-procedure :file-name
      957       ,input ''
      958       ,input ?
      959       ) no-error.
      960     if error-status :error then do:
      961       message
      962         "Ошибка при вызове помощи"
      963         error-status :get-message(1)
      964         view-as alert-box .
      965     end.
      966   end.
      967   run minbtn-set in this-procedure .
      968   on choose of b-help in frame d-pl-list
      969   do:
      970     apply "help":u to frame d-pl-list .
      971   end.
      972   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      973   procedure minbtn-set :
      974       do
      975           on error undo, return error return-value
      976           :
      977           define variable ii              as integer       no-undo .
      978           define variable fh              as widget-handle no-undo .
      979           define variable hh              as widget-handle no-undo .
      980           define variable v-h             as handle        extent 4 no-undo .
      981           define variable v-name-button   as character     no-undo .
      982           define variable v-help-old-x    as decimal       no-undo .
      983           define variable v-help-old-y    as decimal       no-undo .
      984           define variable v-help-old-size as decimal       no-undo .
      985           define variable v-frame-width   as decimal       no-undo .
      986           define variable jj              as integer       no-undo .
      987           do
      988               on error undo, return error
      989               :
      990               assign
      991                   v-frame-width = frame d-pl-list:width - 0.3
      992                   fh            = frame d-pl-list:first-child
      993                   hh            = fh:first-child
      994                   ii            = 1
      995                   .
      996               do while valid-handle(hh):
      997                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      998                   do:
      999                       case lc(hh:name) :
     1000                           when "b-help" then
     1001                               do:
     1002                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1003                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1004                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1005                                   hh:TOOLTIP = "Помощь" .
     1006                                   v-help-old-x = hh:column .
     1007                                   v-help-old-y = hh:row    .
     1008                                   v-help-old-size = hh:width .
     1009                                   hh:width-chars = 2.5 .
     1010                               end.
     1011                           when "b-print" then
     1012                               do:
     1013                                   hh:load-image("cmp/b-print.bmp":u) .
     1014                                   hh:TOOLTIP = "Печать" .
     1015                                   v-h[ii] = hh:handle .
     1016                                   ii = ii + 1 .
     1017                                   hh:width-chars = 3 .
     1018                               end.
     1019                           when "b-history" or
     1020                           when "b-hist" then
     1021                               do:
     1022                                   hh:load-image("cmp/b-hist.bmp":u) .
     1023                                   hh:TOOLTIP = "История" .
     1024                                   v-h[ii] = hh:handle .
     1025                                   ii = ii + 1 .
     1026                                   hh:width-chars = 3 .
     1027                               end.
     1028                           when "b-sch" then
     1029                               do:
     1030                                   hh:load-image("cmp/b-sch.bmp":u) .
     1031                                   hh:TOOLTIP = "Установка Фильтра" .
     1032                                   v-h[ii] = hh:handle .
     1033                                   ii = ii + 1 .
     1034                                   hh:width-chars = 3 .
     1035                               end.
     1036                           when "b-hist-user" then
     1037                               do:
     1038                                   hh:load-image("cmp/b-hist.bmp":u) .
     1039                                   hh:TOOLTIP = "История пользователя" .
     1040                                   ii = ii + 1 .
     1041                               end.
     1042                       end case.
     1043                   end.
     1044                   hh = hh:next-sibling.
     1045               end.
     1046               b-help:column = v-frame-width - b-help:width-chars.
     1047               jj = 0.
     1048               repeat ii = 4 to 1 by -1 :
     1049                   if valid-handle (v-h[ii] ) then
     1050                   do:
     1051                       jj  = jj + 1 .
     1052                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1053                       v-h[ii]:row    = v-help-old-y .
     1054                   end.
     1055               end.
     1056           end.
     1057       end.
     1058   end procedure.
     1059   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1060   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1061   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1062   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1063   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1064   define variable v-diasize-current-frame-height as decimal   no-undo .
     1065   define variable v-diasize-change-size          as logical   no-undo .
     1066   define variable v-diasize-resize-button        as handle    no-undo .
     1067   define variable v-diasize-wndmax               as logical   no-undo .
     1068   define variable v-diasize-wndstore             as logical   no-undo .
     1069   define variable v-diasize-proc-name            as character no-undo .
     1070   define variable v-diasize-browse-handle        as handle    no-undo .
     1071   define variable v-diasize-browse-number        as integer   no-undo .
     1072   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1073   define temp-table temp-diasize-handle no-undo
     1074     field handle-value  as handle
     1075     field save-position as decimal
     1076     index xpk is primary unique handle-value
     1077     .
     1078   define temp-table temp-browse-handle no-undo
     1079     field browse-type   as character
     1080     field browse-number as integer
     1081     field browse-handle as handle
     1082     field original-size as decimal
     1083     index xpk is primary unique browse-type browse-number
     1084     index xie browse-type browse-handle
     1085   .
     1086   procedure diasize_change-height :
     1087     define input  parameter p-change-value  as decimal   no-undo .
     1088     define input  parameter p-move-resize   as logical   no-undo .
     1089     define variable v-field-group-handle    as handle    no-undo .
     1090     define variable v-object-handle         as handle    no-undo .
     1091     define variable v-frame-height          as decimal   no-undo .
     1092     define variable v-frame-virtual-height  as decimal   no-undo .
     1093     define variable v-browse-height         as decimal   no-undo .
     1094     define variable v-window-height         as decimal   no-undo .
     1095     define variable v-window-virtual-height as decimal   no-undo .
     1096     define variable v-change-sign           as integer   no-undo .
     1097     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1098     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1099     if p-change-value > 0
     1100     then do:
     1101       if frame d-pl-list :height + p-change-value
     1102           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1103       then do:
     1104         assign
     1105           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1106                           - (frame d-pl-list :height-chars)
     1107         .
     1108         if p-change-value <= 0
     1109         then do:
     1110           run diasize_position-resize-button in this-procedure .
     1111           return .
     1112         end.
     1113       end.
     1114     end.
     1115     if p-change-value < 0
     1116     then do:
     1117       if frame d-pl-list :height + p-change-value < v-diasize-orig-frame-height
     1118       then do:
     1119         assign
     1120           p-change-value = v-diasize-orig-frame-height
     1121                          - (frame d-pl-list :height-chars)
     1122         .
     1123         if p-change-value >= 0
     1124         then do:
     1125           run diasize_position-resize-button in this-procedure .
     1126           return .
     1127         end.
     1128       end.
     1129     end.
     1130     if p-change-value >= 0
     1131     then do:
     1132       assign
     1133         v-change-sign = 1
     1134       .
     1135     end.
     1136     else do:
     1137       assign
     1138         v-change-sign = -1
     1139       .
     1140     end.
     1141     assign
     1142       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1143     .
     1144     if p-change-value = 0
     1145     then do:
     1146       run diasize_position-resize-button in this-procedure .
     1147       return .
     1148     end.
     1149     move_block:
     1150     do
     1151     on error undo move_block, retry move_block
     1152     :
     1153       if retry
     1154       then do:
     1155         do
     1156         on error undo move_block, leave move_block
     1157         :
     1158           if p-change-value > 0
     1159           then do:
     1160             for each buf_temp-diasize-handle
     1161             on error undo, next
     1162             :
     1163               assign
     1164                 v-object-handle = buf_temp-diasize-handle.handle-value
     1165               .
     1166               if v-object-handle <> v-diasize-resize-button
     1167               then do:
     1168                 assign
     1169                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1170                 .
     1171               end.
     1172             end.
     1173             assign
     1174               v-diasize-browse-handle :height = v-browse-height
     1175             .
     1176             for each buf_temp-browse-handle
     1177               where buf_temp-browse-handle.browse-type = 'height':u
     1178             on error undo, next
     1179             :
     1180               assign
     1181                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1182               .
     1183             end.
     1184             assign
     1185               frame d-pl-list :height = v-frame-height
     1186             .
     1187             if frame d-pl-list :scrollable = true
     1188             then do:
     1189               assign
     1190                 frame d-pl-list :virtual-height = v-frame-virtual-height
     1191               .
     1192             end.
     1193             run diasize_position-resize-button in this-procedure .
     1194           end.
     1195           else do:
     1196             if frame d-pl-list :scrollable = true
     1197             then do:
     1198               assign
     1199                 frame d-pl-list :virtual-height = v-frame-virtual-height
     1200               .
     1201             end.
     1202             assign
     1203               frame d-pl-list :height = v-frame-height
     1204             .
     1205             assign
     1206               v-diasize-browse-handle :height = v-browse-height
     1207             .
     1208             for each buf_temp-browse-handle
     1209               where buf_temp-browse-handle.browse-type = 'height':u
     1210             on error undo, next
     1211             :
     1212               assign
     1213                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1214               .
     1215             end.
     1216             for each buf_temp-diasize-handle
     1217             on error undo, next
     1218             :
     1219               assign
     1220                 v-object-handle = buf_temp-diasize-handle.handle-value
     1221               .
     1222               if v-object-handle <> v-diasize-resize-button
     1223               then do:
     1224                 assign
     1225                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1226                 .
     1227               end.
     1228             end.
     1229             run diasize_position-resize-button in this-procedure .
     1230           end.
     1231           assign
     1232             v-diasize-change-size = false
     1233           .
     1234           leave move_block .
     1235         end.
     1236       end.
     1237       assign
     1238         v-diasize-need-full-display = true
     1239       .
     1240       if v-diasize-change-size = false
     1241       then do:
     1242         assign
     1243           v-diasize-change-size = true
     1244         .
     1245       end.
     1246       else do:
     1247         return .
     1248       end.
     1249       assign
     1250         v-frame-height = frame d-pl-list :height
     1251         v-frame-virtual-height = frame d-pl-list :virtual-height
     1252         v-browse-height = v-diasize-browse-handle :height
     1253       .
     1254       for each buf_temp-browse-handle
     1255         where buf_temp-browse-handle.browse-type = 'height':u
     1256       :
     1257         assign
     1258           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1259         .
     1260       end.
     1261       for each buf_temp-diasize-handle
     1262       :
     1263         delete buf_temp-diasize-handle .
     1264       end.
     1265       assign
     1266         v-field-group-handle = frame d-pl-list :first-child
     1267       .
     1268       do while valid-handle(v-field-group-handle)
     1269       :
     1270         assign
     1271           v-object-handle = v-field-group-handle :first-child
     1272         .
     1273         do while valid-handle(v-object-handle)
     1274         :
     1275           if  v-object-handle <> v-diasize-browse-handle :handle
     1276           and can-query(v-object-handle, "row")
     1277           and can-query(v-object-handle, "height")
     1278           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1279           then do:
     1280             find first buf_temp-browse-handle
     1281               where buf_temp-browse-handle.browse-type   = 'height':u
     1282                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1283               no-error .
     1284             if available buf_temp-browse-handle
     1285             then do:
     1286             end.
     1287             else do:
     1288               create buf_temp-diasize-handle .
     1289               assign
     1290                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1291                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1292               .
     1293             end.
     1294           end.
     1295           assign
     1296             v-object-handle = v-object-handle :next-sibling
     1297           .
     1298         end.
     1299         assign
     1300           v-field-group-handle = v-field-group-handle :next-sibling
     1301         .
     1302       end.
     1303       do with frame d-pl-list
     1304       :
     1305         hide v-diasize-resize-button .
     1306         assign
     1307           v-diasize-resize-button :row    = 1
     1308           v-diasize-resize-button :column = 1
     1309         .
     1310       end.
     1311       if p-change-value > 0
     1312       then do:
     1313         if frame d-pl-list :scrollable = true
     1314         then do:
     1315           assign
     1316             frame d-pl-list :virtual-height = frame d-pl-list :virtual-height + p-change-value
     1317             no-error .
     1318           if error-status :error
     1319           or error-status :get-message(1) <> ""
     1320           then do:
     1321             undo move_block, retry move_block .
     1322           end.
     1323         end.
     1324         assign
     1325           frame d-pl-list :height = frame d-pl-list :height + p-change-value
     1326           no-error .
     1327         if error-status :error
     1328         or error-status :get-message(1) <> ""
     1329         then do:
     1330           undo move_block, retry move_block .
     1331         end.
     1332         assign
     1333           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1334           no-error .
     1335         if error-status :error
     1336         or error-status :get-message(1) <> ""
     1337         then do:
     1338           undo move_block, retry move_block .
     1339         end.
     1340         for each buf_temp-browse-handle
     1341           where buf_temp-browse-handle.browse-type = 'height':u
     1342         on error undo move_block, retry move_block
     1343         :
     1344           assign
     1345             buf_temp-browse-handle.browse-handle :height
     1346               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1347             no-error .
     1348           if error-status :error
     1349           or error-status :get-message(1) <> ""
     1350           then do:
     1351             undo move_block, retry move_block .
     1352           end.
     1353         end.
     1354         for each buf_temp-diasize-handle
     1355         on error undo move_block, retry move_block
     1356         :
     1357           assign
     1358             v-object-handle = buf_temp-diasize-handle.handle-value
     1359           .
     1360           if v-object-handle <> v-diasize-resize-button
     1361           then do:
     1362             assign
     1363               v-object-handle :row = v-object-handle :row + p-change-value
     1364               no-error .
     1365             if error-status :error
     1366             or error-status :get-message(1) <> ""
     1367             then do:
     1368               undo move_block, retry move_block .
     1369             end.
     1370           end.
     1371         end.
     1372       end.
     1373       else do:
     1374         for each buf_temp-diasize-handle
     1375         on error undo move_block, retry move_block
     1376         :
     1377           assign
     1378             v-object-handle = buf_temp-diasize-handle.handle-value
     1379           .
     1380           if v-object-handle <> v-diasize-resize-button
     1381           then do:
     1382             assign
     1383               v-object-handle :row = v-object-handle :row + p-change-value
     1384               no-error .
     1385             if error-status :error
     1386             or error-status :get-message(1) <> ""
     1387             then do:
     1388               undo move_block, retry move_block .
     1389             end.
     1390           end.
     1391         end.
     1392         assign
     1393           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1394           no-error .
     1395         if error-status :error
     1396         or error-status :get-message(1) <> ""
     1397         then do:
     1398           undo move_block, retry move_block .
     1399         end.
     1400         for each buf_temp-browse-handle
     1401           where buf_temp-browse-handle.browse-type = 'height':u
     1402         on error undo move_block, retry move_block
     1403         :
     1404           assign
     1405             buf_temp-browse-handle.browse-handle :height
     1406               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1407             no-error .
     1408           if error-status :error
     1409           or error-status :get-message(1) <> ""
     1410           then do:
     1411             undo move_block, retry move_block .
     1412           end.
     1413         end.
     1414         assign
     1415           frame d-pl-list :height = frame d-pl-list :height + p-change-value
     1416           no-error .
     1417         if error-status :error
     1418         or error-status :get-message(1) <> ""
     1419         then do:
     1420           undo move_block, retry move_block .
     1421         end.
     1422         if frame d-pl-list :scrollable = true
     1423         then do:
     1424           assign
     1425             frame d-pl-list :virtual-height = frame d-pl-list :virtual-height + p-change-value
     1426             no-error .
     1427           if error-status :error
     1428           or error-status :get-message(1) <> ""
     1429           then do:
     1430             undo move_block, retry move_block .
     1431           end.
     1432         end.
     1433       end.
     1434       if p-move-resize = true
     1435       then do:
     1436         run diasize_position-resize-button in this-procedure .
     1437       end.
     1438       if v-diasize-wndstore = true
     1439       then do:
     1440         if connected("ub") = true
     1441         then do:
     1442           define variable v-cntxt-db-num        as integer   no-undo .
     1443           define variable v-cntxt-userid        as character no-undo .
     1444           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1445                                             , OUTPUT v-cntxt-userid
     1446                                             ) .
     1447           run gbl/wndsizew.p
     1448             (input  v-cntxt-db-num
     1449             ,input  v-cntxt-userid
     1450             ,input  v-diasize-proc-name
     1451             ,input  'height':u
     1452             ,input  string(frame d-pl-list :height - v-diasize-orig-frame-height)
     1453             ) .
     1454         end.
     1455       end.
     1456     end.
     1457     assign
     1458       v-diasize-change-size = false
     1459     .
     1460   end procedure.
     1461   procedure diasize_set-height :
     1462     define input  parameter p-new-height  as decimal   no-undo .
     1463     define input  parameter p-move-resize as logical   no-undo .
     1464     do
     1465     on error undo, return error return-value
     1466     :
     1467       run diasize_change-height in this-procedure
     1468         (input  (p-new-height - frame d-pl-list :height)
     1469         ,input  p-move-resize
     1470         ) .
     1471     end.
     1472   end procedure.
     1473   procedure diasize_change-width :
     1474     define input  parameter p-change-value as decimal   no-undo .
     1475     define input  parameter p-move-resize  as logical   no-undo .
     1476     define variable v-field-group-handle   as handle    no-undo .
     1477     define variable v-object-handle        as handle    no-undo .
     1478     define variable v-frame-width          as decimal   no-undo .
     1479     define variable v-frame-virtual-width  as decimal   no-undo .
     1480     define variable v-browse-width         as decimal   no-undo .
     1481     define variable v-window-width         as decimal   no-undo .
     1482     define variable v-window-virtual-width as decimal   no-undo .
     1483     define variable v-change-sign          as integer   no-undo .
     1484     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1485     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1486     if p-change-value > 0
     1487     then do:
     1488       if frame d-pl-list :width + p-change-value >
     1489           session :width-chars
     1490       then do:
     1491         assign
     1492           p-change-value = session :width-chars - frame d-pl-list :width
     1493         .
     1494         if p-change-value <= 0
     1495         then do:
     1496           run diasize_position-resize-button in this-procedure .
     1497           return .
     1498         end.
     1499       end.
     1500     end.
     1501     if p-change-value < 0
     1502     then do:
     1503       if frame d-pl-list :width + p-change-value < v-diasize-orig-frame-width
     1504       then do:
     1505         assign
     1506           p-change-value = v-diasize-orig-frame-width
     1507                          - frame d-pl-list :width
     1508         .
     1509         if p-change-value >= 0
     1510         then do:
     1511           run diasize_position-resize-button in this-procedure .
     1512           return .
     1513         end.
     1514       end.
     1515     end.
     1516     if p-change-value >= 0
     1517     then do:
     1518       assign
     1519         v-change-sign = 1
     1520       .
     1521     end.
     1522     else do:
     1523       assign
     1524         v-change-sign = -1
     1525       .
     1526     end.
     1527     assign
     1528       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1529     .
     1530     if p-change-value = 0
     1531     then do:
     1532       run diasize_position-resize-button in this-procedure .
     1533       return .
     1534     end.
     1535     move_block:
     1536     do
     1537     on error undo move_block, leave move_block
     1538     :
     1539       if retry
     1540       then do:
     1541         do
     1542         on error undo move_block, leave move_block
     1543         :
     1544           if p-change-value > 0
     1545           then do:
     1546             for each buf_temp-diasize-handle
     1547             on error undo, next
     1548             :
     1549               assign
     1550                 v-object-handle = buf_temp-diasize-handle.handle-value
     1551               .
     1552               if v-object-handle <> v-diasize-resize-button
     1553               then do:
     1554                 assign
     1555                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1556                 .
     1557               end.
     1558             end.
     1559             assign
     1560               v-diasize-browse-handle :width = v-browse-width
     1561             .
     1562             for each buf_temp-browse-handle
     1563               where buf_temp-browse-handle.browse-type = 'width':u
     1564             on error undo, next
     1565             :
     1566               assign
     1567                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1568               .
     1569             end.
     1570             assign
     1571               frame d-pl-list :width = v-frame-width
     1572             .
     1573             if frame d-pl-list :scrollable = true
     1574             then do:
     1575               assign
     1576                 frame d-pl-list :virtual-width = v-frame-virtual-width
     1577               .
     1578             end.
     1579             run diasize_position-resize-button in this-procedure .
     1580           end.
     1581           else do:
     1582             if frame d-pl-list :scrollable = true
     1583             then do:
     1584               assign
     1585                 frame d-pl-list :virtual-width = v-frame-virtual-width
     1586               .
     1587             end.
     1588             assign
     1589               frame d-pl-list :width = v-frame-width
     1590             .
     1591             for each buf_temp-browse-handle
     1592               where buf_temp-browse-handle.browse-type = 'width':u
     1593             on error undo, next
     1594             :
     1595               assign
     1596                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1597               .
     1598             end.
     1599             assign
     1600               v-diasize-browse-handle :width = v-browse-width
     1601             .
     1602             for each buf_temp-diasize-handle
     1603             on error undo, next
     1604             :
     1605               assign
     1606                 v-object-handle = buf_temp-diasize-handle.handle-value
     1607               .
     1608               if v-object-handle <> v-diasize-resize-button
     1609               then do:
     1610                 assign
     1611                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1612                 .
     1613               end.
     1614             end.
     1615             run diasize_position-resize-button in this-procedure .
     1616           end.
     1617           assign
     1618             v-diasize-change-size = false
     1619           .
     1620           leave move_block .
     1621         end.
     1622       end.
     1623       assign
     1624         v-diasize-need-full-display = true
     1625       .
     1626       if v-diasize-change-size = false
     1627       then do:
     1628         assign
     1629           v-diasize-change-size = true
     1630         .
     1631       end.
     1632       else do:
     1633         return .
     1634       end.
     1635       assign
     1636         v-frame-width = frame d-pl-list :width
     1637         v-frame-virtual-width = frame d-pl-list :virtual-width
     1638         v-browse-width = v-diasize-browse-handle :width
     1639       .
     1640       for each buf_temp-browse-handle
     1641         where buf_temp-browse-handle.browse-type = 'width':u
     1642       :
     1643         assign
     1644           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1645         .
     1646       end.
     1647       for each buf_temp-diasize-handle
     1648       :
     1649         delete buf_temp-diasize-handle .
     1650       end.
     1651       assign
     1652         v-field-group-handle = frame d-pl-list :first-child
     1653       .
     1654       do while valid-handle(v-field-group-handle)
     1655       :
     1656         assign
     1657           v-object-handle = v-field-group-handle :first-child
     1658         .
     1659         do while valid-handle(v-object-handle)
     1660         :
     1661           if  v-object-handle <> v-diasize-browse-handle :handle
     1662           and v-object-handle <> v-diasize-resize-button
     1663           and can-query(v-object-handle, "row")
     1664           and can-query(v-object-handle, "height")
     1665           and ( v-object-handle :col + v-object-handle :width
     1666                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1667               )
     1668           then do:
     1669             find first buf_temp-browse-handle
     1670               where buf_temp-browse-handle.browse-type   = 'width':u
     1671                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1672               no-error .
     1673             if available buf_temp-browse-handle
     1674             then do:
     1675             end.
     1676             else do:
     1677               create buf_temp-diasize-handle .
     1678               assign
     1679                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1680                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1681               .
     1682             end.
     1683           end.
     1684           assign
     1685             v-object-handle = v-object-handle :next-sibling
     1686           .
     1687         end.
     1688         assign
     1689           v-field-group-handle = v-field-group-handle :next-sibling
     1690         .
     1691       end.
     1692       do with frame d-pl-list
     1693       :
     1694         hide v-diasize-resize-button .
     1695         v-diasize-resize-button :row = 1.
     1696         v-diasize-resize-button :column = 1.
     1697       end.
     1698       if p-change-value > 0
     1699       then do:
     1700         if frame d-pl-list :scrollable = true
     1701         then do:
     1702           assign
     1703             frame d-pl-list :virtual-width = frame d-pl-list :virtual-width + p-change-value
     1704             no-error .
     1705           if error-status :error
     1706           or error-status :get-message(1) <> ""
     1707           then do:
     1708             undo move_block, retry move_block.
     1709           end.
     1710         end.
     1711         assign
     1712           frame d-pl-list :width = v-frame-width + p-change-value
     1713           no-error .
     1714         if error-status :error
     1715         or error-status :get-message(1) <> ""
     1716         then do:
     1717           undo move_block, retry move_block.
     1718         end.
     1719         assign
     1720           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1721         no-error .
     1722         if error-status :error
     1723         or error-status :get-message(1) <> ""
     1724         then do:
     1725           undo move_block, retry move_block.
     1726         end.
     1727         for each buf_temp-browse-handle
     1728           where buf_temp-browse-handle.browse-type = 'width':u
     1729         on error undo move_block, retry move_block
     1730         :
     1731           assign
     1732             buf_temp-browse-handle.browse-handle :width
     1733               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1734             no-error .
     1735           if error-status :error
     1736           or error-status :get-message(1) <> ""
     1737           then do:
     1738             undo move_block, retry move_block .
     1739           end.
     1740         end.
     1741         for each buf_temp-diasize-handle
     1742         on error undo move_block, retry move_block
     1743         :
     1744           assign
     1745             v-object-handle = buf_temp-diasize-handle.handle-value
     1746           .
     1747           if v-object-handle <> v-diasize-resize-button
     1748           then do:
     1749             assign
     1750               v-object-handle :col = v-object-handle :col + p-change-value
     1751               no-error .
     1752             if error-status :error
     1753             or error-status :get-message(1) <> ""
     1754             then do:
     1755               undo move_block, retry move_block .
     1756             end.
     1757           end.
     1758         end.
     1759       end.
     1760       else do:
     1761         for each buf_temp-diasize-handle
     1762         on error undo move_block, retry move_block
     1763         :
     1764           assign
     1765             v-object-handle = buf_temp-diasize-handle.handle-value
     1766           .
     1767           if v-object-handle <> v-diasize-resize-button
     1768           then do:
     1769             assign
     1770               v-object-handle :col = v-object-handle :col + p-change-value
     1771               no-error .
     1772             if error-status :error
     1773             or error-status :get-message(1) <> ""
     1774             then do:
     1775               undo move_block, retry move_block .
     1776             end.
     1777           end.
     1778         end.
     1779         for each buf_temp-browse-handle
     1780           where buf_temp-browse-handle.browse-type = 'width':u
     1781         on error undo move_block, retry move_block
     1782         :
     1783           assign
     1784             buf_temp-browse-handle.browse-handle :width
     1785               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1786             no-error .
     1787           if error-status :error
     1788           or error-status :get-message(1) <> ""
     1789           then do:
     1790             undo move_block, retry move_block .
     1791           end.
     1792         end.
     1793         assign
     1794           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1795           no-error .
     1796         if error-status :error
     1797         or error-status :get-message(1) <> ""
     1798         then do:
     1799           undo move_block, retry move_block.
     1800         end.
     1801         assign
     1802           frame d-pl-list :width = frame d-pl-list :width + p-change-value
     1803         no-error .
     1804         if error-status :error
     1805         or error-status :get-message(1) <> ""
     1806         then do:
     1807           undo move_block, retry move_block.
     1808         end.
     1809         if frame d-pl-list :scrollable = true
     1810         then do:
     1811           assign
     1812             frame d-pl-list :virtual-width = frame d-pl-list :virtual-width + p-change-value
     1813           no-error .
     1814           if error-status :error
     1815           or error-status :get-message(1) <> ""
     1816           then do:
     1817             undo move_block, retry move_block.
     1818           end.
     1819         end.
     1820       end.
     1821       if p-move-resize
     1822       then do:
     1823         run diasize_position-resize-button in this-procedure .
     1824       end.
     1825       if v-diasize-wndstore = true
     1826       then do:
     1827         if connected("ub") = true
     1828         then do:
     1829           define variable v-cntxt-db-num        as integer   no-undo .
     1830           define variable v-cntxt-userid        as character no-undo .
     1831           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1832                                             , OUTPUT v-cntxt-userid
     1833                                             ) .
     1834           run gbl/wndsizew.p
     1835             (input  v-cntxt-db-num
     1836             ,input  v-cntxt-userid
     1837             ,input  v-diasize-proc-name
     1838             ,input  'width':u
     1839             ,input  string(frame d-pl-list :width - v-diasize-orig-frame-width)
     1840             ) .
     1841         end.
     1842       end.
     1843     end.
     1844     assign
     1845       v-diasize-change-size = false
     1846     .
     1847   end procedure.
     1848   procedure diasize_set-width :
     1849     define input  parameter p-new-width  as decimal   no-undo .
     1850     define input  parameter p-move-resize as logical   no-undo .
     1851     do
     1852     on error undo, return error return-value
     1853     :
     1854       run diasize_change-width in this-procedure
     1855         (input  (p-new-width - frame d-pl-list :width)
     1856         ,input  p-move-resize
     1857         ) .
     1858     end.
     1859   end procedure.
     1860   procedure diasize_position-resize-button :
     1861     do with frame d-pl-list
     1862     :
     1863       hide v-diasize-resize-button .
     1864       assign
     1865         v-diasize-resize-button :row = frame d-pl-list :height - v-diasize-resize-button :height
     1866                     - 1
     1867                     - (frame d-pl-list :border-bottom-pixels / session :pixels-per-row)
     1868         v-diasize-resize-button :col = frame d-pl-list :width - v-diasize-resize-button :width
     1869                     - 1
     1870                     - (frame d-pl-list :border-right-pixels / session :pixels-per-column)
     1871       .
     1872       view v-diasize-resize-button .
     1873     end.
     1874   end procedure.
     1875   on alt-right anywhere
     1876   do:
     1877     run diasize_change-width in this-procedure
     1878       (input 1
     1879       ,input true
     1880       ) .
     1881     return no-apply .
     1882   end.
     1883   on alt-left anywhere
     1884   do:
     1885     run diasize_change-width in this-procedure
     1886       (input -1
     1887       ,input true
     1888       ) .
     1889     return no-apply .
     1890   end.
     1891   on alt-down anywhere
     1892   do:
     1893     run diasize_change-height in this-procedure
     1894       (input 1
     1895       ,input true
     1896       ) .
     1897     return no-apply .
     1898   end.
     1899   on alt-up anywhere
     1900   do:
     1901     run diasize_change-height in this-procedure
     1902       (input -1
     1903       ,input true
     1904       ) .
     1905     return no-apply .
     1906   end.
     1907   on alt-enter of frame d-pl-list
     1908   do:
     1909     run diasize_maximize in this-procedure
     1910       (input  ?
     1911       ).
     1912     return no-apply .
     1913   end.
     1914   procedure diasize_end-move :
     1915     do
     1916     on error undo, return error return-value
     1917     :
     1918       define variable v-row-delta as decimal   no-undo .
     1919       define variable v-col-delta as decimal   no-undo .
     1920       define variable v-new-row as decimal   no-undo .
     1921       define variable v-new-col as decimal   no-undo .
     1922       assign
     1923         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1924         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1925       .
     1926       assign
     1927         v-row-delta = v-new-row - frame d-pl-list :height
     1928         v-col-delta = v-new-col - frame d-pl-list :width
     1929       .
     1930       run diasize_change-height in this-procedure
     1931         (input v-row-delta
     1932         ,input true
     1933         ) .
     1934       run diasize_change-width in this-procedure
     1935         (input v-col-delta
     1936         ,input true
     1937         ) .
     1938     end.
     1939   end procedure.
     1940   procedure diasize_maximize :
     1941     define input  parameter p-action as logical   no-undo .
     1942     do
     1943     on error undo, return error return-value
     1944     :
     1945       if p-action = ?
     1946       then do:
     1947         if v-diasize-need-maximize = true
     1948         then do:
     1949           assign
     1950             p-action = true
     1951           .
     1952         end.
     1953         else do:
     1954           assign
     1955             p-action = false
     1956           .
     1957         end.
     1958       end.
     1959       if p-action = true
     1960       then do:
     1961         run diasize_change-height in this-procedure
     1962           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1963               - frame d-pl-list :height-chars
     1964           ,input true
     1965           ) .
     1966         run diasize_change-width in this-procedure
     1967           (input session :width-chars
     1968               - frame d-pl-list :width-chars
     1969           ,input true
     1970           ) .
     1971         assign
     1972           v-diasize-need-maximize = false
     1973         .
     1974       end.
     1975       else do:
     1976         run diasize_change-width in this-procedure
     1977           (input v-diasize-orig-frame-width
     1978               - frame d-pl-list :width-chars
     1979           ,input true
     1980           ) .
     1981         run diasize_change-height in this-procedure
     1982           (input v-diasize-orig-frame-height
     1983               - frame d-pl-list :height-chars
     1984           ,input true
     1985           ) .
     1986         assign
     1987           v-diasize-need-maximize = true
     1988         .
     1989       end.
     1990     end.
     1991   end procedure.
     1992   procedure diasize_restore-orig-size :
     1993     do
     1994     on error undo, return error return-value
     1995     :
     1996       assign
     1997         v-diasize-current-frame-width  = frame d-pl-list :width
     1998         v-diasize-current-frame-height = frame d-pl-list :height
     1999       .
     2000       run diasize_set-height in this-procedure
     2001         (input  v-diasize-orig-frame-height
     2002         ,input  true
     2003         ) .
     2004       run diasize_set-width in this-procedure
     2005         (input  v-diasize-orig-frame-width
     2006         ,input  true
     2007         ) .
     2008     end.
     2009   end procedure.
     2010   procedure diasize_restore-current-size :
     2011     do
     2012     on error undo, return error return-value
     2013     :
     2014       run diasize_set-height in this-procedure
     2015         (input  v-diasize-current-frame-height
     2016         ,input  true
     2017         ) .
     2018       run diasize_set-width in this-procedure
     2019         (input  v-diasize-current-frame-width
     2020         ,input  true
     2021         ) .
     2022     end.
     2023   end procedure.
     2024   procedure diasize_set-browse-handle :
     2025     define input  parameter p-browse-handle as handle   no-undo .
     2026     define buffer buf_temp-browse-handle for temp-browse-handle .
     2027     do
     2028     on error undo, return error return-value
     2029     :
     2030       assign
     2031         v-diasize-browse-handle = p-browse-handle
     2032       .
     2033       for each buf_temp-browse-handle
     2034       on error undo, return error return-value
     2035       :
     2036         delete buf_temp-browse-handle .
     2037       end.
     2038     end.
     2039   end procedure.
     2040   procedure diasize_add_browse :
     2041     define input  parameter p-browse-type   as character no-undo .
     2042     define input  parameter p-browse-handle as handle    no-undo .
     2043     define buffer buf_temp-browse-handle for temp-browse-handle .
     2044     do
     2045     on error undo, return error return-value
     2046     :
     2047       assign
     2048         v-diasize-browse-number = v-diasize-browse-number + 1
     2049       .
     2050       create buf_temp-browse-handle .
     2051       assign
     2052         buf_temp-browse-handle.browse-type   = p-browse-type
     2053         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     2054         buf_temp-browse-handle.browse-handle = p-browse-handle
     2055       .
     2056     end.
     2057   end procedure.
     2058   procedure diasize_init :
     2059     define variable v-default-value    as logical   no-undo .
     2060     define variable v-restore-saved    as logical   no-undo .
     2061     define variable v-resize-value-str as character no-undo .
     2062     do
     2063     on error undo, return error return-value
     2064     :
     2065       do with frame d-pl-list
     2066       :
     2067         assign
     2068           v-diasize-orig-frame-height = frame d-pl-list :height
     2069           v-diasize-orig-frame-width  = frame d-pl-list :width
     2070           v-diasize-browse-handle     = browse br-pl :handle
     2071         .
     2072         create button v-diasize-resize-button
     2073         assign
     2074           parent        = frame d-pl-list :first-child
     2075           label         = "s"
     2076           height-pixels = 16
     2077           width-pixels  = 16
     2078           visible       = true
     2079           sensitive     = true
     2080           movable       = true
     2081           triggers:
     2082             on end-move persistent run diasize_end-move in this-procedure .
     2083           end triggers.
     2084         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2085         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2086         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2087         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2088         assign
     2089           v-diasize-wndmax = false
     2090         .
     2091         if connected("ub") = true
     2092         then do:
     2093           define variable v-cntxt-db-num        as integer   no-undo .
     2094           define variable v-cntxt-userid        as character no-undo .
     2095           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2096                                             , OUTPUT v-cntxt-userid
     2097                                             ) .
     2098           run gbl/wndpar_r.p
     2099             (input  v-cntxt-db-num
     2100             ,input  v-cntxt-userid
     2101             ,input  'wndmax':U
     2102             ,output v-diasize-wndmax
     2103             ,output v-default-value
     2104             ) .
     2105         end.
     2106         assign
     2107           v-diasize-wndstore = false
     2108         .
     2109         if connected("ub") = true
     2110         then do:
     2111           run gbl/wndpar_r.p
     2112             (input  v-cntxt-db-num
     2113             ,input  v-cntxt-userid
     2114             ,input  'wndstore':U
     2115             ,output v-diasize-wndstore
     2116             ,output v-default-value
     2117             ) .
     2118         end.
     2119         assign
     2120           v-diasize-proc-name = entry(1, program-name(2), '.')
     2121         .
     2122         if v-diasize-wndstore = true
     2123         then do:
     2124           assign
     2125             v-restore-saved = false
     2126           .
     2127           if connected("ub") = true
     2128           then do:
     2129             run gbl/wndsizer.p
     2130               (input  v-cntxt-db-num
     2131               ,input  v-cntxt-userid
     2132               ,input  v-diasize-proc-name
     2133               ,input  'height':u
     2134               ,output v-resize-value-str
     2135               ) .
     2136             if v-resize-value-str <> '':U
     2137             then do:
     2138               run diasize_change-height in this-procedure
     2139                 (input  integer(v-resize-value-str)
     2140                 ,input  true
     2141                 ) .
     2142               assign
     2143                 v-restore-saved = true
     2144               .
     2145             end.
     2146           end.
     2147           if connected("ub") = true
     2148           then do:
     2149             run gbl/wndsizer.p
     2150               (input  v-cntxt-db-num
     2151               ,input  v-cntxt-userid
     2152               ,input  v-diasize-proc-name
     2153               ,input  'width':u
     2154               ,output v-resize-value-str
     2155               ) .
     2156             if v-resize-value-str <> '':U
     2157             then do:
     2158               run diasize_change-width in this-procedure
     2159                 (input  integer(v-resize-value-str)
     2160                 ,input  true
     2161                 ) .
     2162               assign
     2163                 v-restore-saved = true
     2164               .
     2165             end.
     2166           end.
     2167           if v-restore-saved <> true
     2168           then do:
     2169             if v-diasize-wndmax = true
     2170             then do:
     2171               run diasize_maximize in this-procedure
     2172                 (input  true
     2173                 ) .
     2174             end.
     2175           end.
     2176         end.
     2177         else do:
     2178           if v-diasize-wndmax = true
     2179           then do:
     2180             run diasize_maximize in this-procedure
     2181               (input  true
     2182               ) .
     2183           end.
     2184         end.
     2185       end.
     2186     end.
     2187   end procedure.
     2188   procedure diasize_need-full-display :
     2189     define output parameter p-need-full-display as logical   no-undo .
     2190     do
     2191     on error undo, return error return-value
     2192     :
     2193       assign
     2194         p-need-full-display = v-diasize-need-full-display
     2195       .
     2196       assign
     2197         v-diasize-need-full-display = false
     2198       .
     2199     end.
     2200   end procedure.
     2201   procedure get-context :
     2202      define output parameter p-db-num as integer          no-undo.
     2203      define output parameter p-user-id as character        no-undo.
     2204      define variable v-login               as character    no-undo.
     2205      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2206      define buffer buf_user-login  for ub.user-login .
     2207      do
     2208      on error undo, return error
     2209      :
     2210            FIND FIRST buf_sys-ctrl no-lock.
     2211            ASSIGN
     2212               v-login = USERID("ub")
     2213               p-db-num = buf_sys-ctrl.db-num
     2214            .
     2215            FIND FIRST buf_user-login
     2216                 WHERE buf_user-login.db-num = p-db-num
     2217                   AND buf_user-login.user-login = v-login
     2218                 no-lock
     2219                 no-error
     2220                 .
     2221            IF AVAILABLE buf_user-login
     2222            THEN DO:
     2223               assign
     2224                  p-user-id = buf_user-login.user-id
     2225               .
     2226            END.
     2227      end.
     2228   end procedure.
     2229       run diasize_init in this-procedure .
     2230   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2231   procedure set-filter-name :
     2232   define input parameter p-filter-name as character no-undo .
     2233     do with frame d-pl-list:
     2234       if p-filter-name > "" then do:
     2235         assign
     2236           frame d-pl-list:title
     2237             = frame d-pl-list:title + "   ФИЛЬТР: " + p-filter-name.
     2238         .
     2239         assign
     2240           b-sch :tooltip = "Установлен фильтр " + p-filter-name
     2241         .
     2242       end.
     2243       else do:
     2244         assign
     2245           b-sch :tooltip = ""
     2246         .
     2247       end.
     2248     end.
     2249   end procedure.
     2250   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2251   on f5 of frame d-pl-list anywhere
     2252   do:
     2253     v-doc-rec = recid(X_place-io). run openbr in this-procedure. reposition br-pl to recid(v-doc-rec). v-doc-rec = ? .
     2254       apply "VALUE-CHANGED" to br-pl.
     2255   end.
     2256   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2257   do:
     2258     br-pl :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     2259   end.
     2260   def var sort-labelbr-pl   as character no-undo .
     2261   def var sort-clmnbr-pl    as handle    no-undo .
     2262   def var cur-clmnbr-pl     as handle    no-undo .
     2263   def var cur-clmn-locbr-pl as integer   no-undo .
     2264   def var re-querybr-pl     as logical   initial no no-undo .
     2265   on start-search, ctrl-o of br-pl in frame d-pl-list do:
     2266      run sort-brbr-pl
     2267        (input (if available X_place-io
     2268                then recid(X_place-io)
     2269                else ?
     2270               )
     2271        ).
     2272   end.
     2273   PROCEDURE sort-brbr-pl :
     2274     define input parameter p-recid as recid no-undo .
     2275     if re-querybr-pl = no then do:
     2276       assign
     2277          cur-clmnbr-pl = br-pl:current-column in frame d-pl-list
     2278       .
     2279       if sort-clmnbr-pl <> ? then sort-clmnbr-pl:column-fgcolor = 0.
     2280       if cur-clmnbr-pl = sort-clmnbr-pl then do:
     2281         assign
     2282            sort-labelbr-pl = ""
     2283            sort-clmnbr-pl = ?
     2284         .
     2285        end.
     2286        else do:
     2287          assign
     2288            sort-labelbr-pl = cur-clmnbr-pl:label
     2289            sort-clmnbr-pl  = cur-clmnbr-pl
     2290            sort-clmnbr-pl:column-fgcolor = 4
     2291          .
     2292        end.
     2293      end.
     2294     assign
     2295       cur-clmn-locbr-pl = 1
     2296     .
     2297     def var column-handle as handle no-undo .
     2298     column-handle = br-pl:first-column.
     2299     do while valid-handle(column-handle) :
     2300       if column-handle = cur-clmnbr-pl then do:
     2301         leave .
     2302       end.
     2303       column-handle = column-handle:NEXT-COLUMN.
     2304       assign
     2305         cur-clmn-locbr-pl = cur-clmn-locbr-pl + 1
     2306       .
     2307     end.
     2308     case sort-labelbr-pl:
     2309           when X_place-io.place-io-type:label in browse br-pl then DO:    assign       sort-column-name = "X_place-io.place-io-type"     .     run OpenBr.   . END.
     2310           when X_place-io.place-io-code:label in browse br-pl then DO:    assign       sort-column-name = "X_place-io.place-io-code"     .     run OpenBr.   . END.
     2311           when X_place-io.place-io-name:label in browse br-pl then DO:    assign       sort-column-name = "X_place-io.place-io-name"     .     run OpenBr.   . END.
     2312           when X_place-io.status_:label in browse br-pl then DO:    assign       sort-column-name = "X_place-io.status_"     .     run OpenBr.   . END.
     2313       otherwise do:
     2314         assign
     2315           sort-column-name = ""
     2316         .
     2317         run OpenBr.
     2318           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-pl') then do:
     2319             run mv-brw-defaultbr-pl.
     2320           end.
     2321         if sort-labelbr-pl <> "" then do:
     2322           assign
     2323             cur-clmnbr-pl:column-fgcolor = 0
     2324           .
     2325         end.
     2326         assign
     2327           cur-clmn-locbr-pl = ?
     2328         .
     2329       end.
     2330     end case.
     2331       if cur-clmn-locbr-pl <> ? then do:
     2332         if can-do( this-procedure:internal-entries, 'ch-clmnbr-pl') then do:
     2333           run ch-clmnbr-pl in this-procedure (cur-clmn-locbr-pl).
     2334         end.
     2335       end.
     2336     if p-recid <> ? then do:
     2337       reposition br-pl to recid p-recid no-error.
     2338       apply "value-changed" to br-pl in frame d-pl-list.
     2339     end.
     2340     apply "entry" to br-pl in frame d-pl-list.
     2341   END PROCEDURE.
     2342   procedure re-open-query-srt-clmnbr-pl:
     2343   if cur-clmnbr-pl = ? then do:
     2344      run OpenBr.
     2345   end.
     2346   else do:
     2347      assign re-querybr-pl = yes.
     2348      run sort-brbr-pl
     2349        (input (if available X_place-io
     2350                then recid(X_place-io)
     2351                else ?
     2352               )
     2353        ).
     2354      assign re-querybr-pl = no.
     2355   end.
     2356   end.
     2357   ON WINDOW-CLOSE OF FRAME d-pl-list APPLY "END-ERROR":U TO SELF.
     2358   MAIN-BLOCK:
     2359   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2360      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2361   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2362     run mainmenu_getcntxt in parparentproc
     2363       (output v-cntxt-db-num
     2364       ,output v-cntxt-userid
     2365       ,output v-cntxt-level
     2366       ,output v-cntxt-host-code-obj
     2367       ,output v-cntxt-obj-type
     2368       ,output v-cntxt-obj-code
     2369       ,output v-cntxt-db-num-obj
     2370       ,output v-cntxt-is-admin
     2371       ) .
     2372     if rid-list <> "":U then assign v-doc-rec = integer(entry(1, rid-list)).
     2373     case p-type :
     2374       when 'all'        then assign RADIO-type = 3 .
     2375       when 'приемки':U  then assign RADIO-type = 2 .
     2376       when 'отгрузки':U then assign RADIO-type = 1 .
     2377     end.
     2378     if p-mode = 'объект':U then assign RADIO-obj = 1 .
     2379     else                           assign RADIO-obj = 2 .
     2380     DISPLAY RADIO-obj RADIO-type  WITH FRAME d-pl-list.
     2381     RUN enable_UI.
     2382     RUN OpenBR.
     2383   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2384   DEF VAR cur-clmn-numbr-pl as INT EXTENT 6 no-undo.
     2385   DEF VAR varmvibr-pl       as INT no-undo.
     2386   DEF VAR varmvjbr-pl       as INT no-undo.
     2387   DEF VAR varmvkbr-pl       as INT no-undo.
     2388   DEF VAR varmvlbr-pl       as INT no-undo.
     2389   DEF VAR move-elementbr-pl as INT no-undo.
     2390   def var jjbr-pl           as int no-undo.
     2391   do varmvibr-pl = 1 to EXTENT(cur-clmn-numbr-pl):
     2392     ASSIGN cur-clmn-numbr-pl[varmvibr-pl] = varmvibr-pl.
     2393   END.
     2394   RUN start-mv-clmnbr-pl.
     2395   PROCEDURE start-mv-clmnbr-pl:
     2396   def var old-session as logical no-undo.
     2397      old-session = SESSION:IMMEDIATE-DISPLAY.
     2398      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2399          IF  p-mode = 'объект':U  THEN DO:
     2400      DO jjbr-pl = NUM-ENTRIES('1,2,3,4,5,6') TO 1 BY -1:
     2401        RUN re-move-clmnbr-pl ( cur-clmn-numbr-pl[INTEGER(ENTRY (jjbr-pl, '1,2,3,4,5,6'))] , 2).
     2402      END.
     2403          END.
     2404          IF  p-mode = 'все':U  THEN DO:
     2405      DO jjbr-pl = NUM-ENTRIES('1,2,5,6,3,4') TO 1 BY -1:
     2406        RUN re-move-clmnbr-pl ( cur-clmn-numbr-pl[INTEGER(ENTRY (jjbr-pl, '1,2,5,6,3,4'))] , 2).
     2407      END.
     2408          END.
     2409      SESSION:IMMEDIATE-DISPLAY = old-session.
     2410   END.
     2411   ON ctrl-cursor-right OF BROWSE br-pl do:
     2412     RUN re-move-clmnbr-pl ( 2, 6).
     2413   END.
     2414   ON ctrl-cursor-left OF BROWSE br-pl do:
     2415     RUN re-move-clmnbr-pl (6, 2).
     2416   END.
     2417   PROCEDURE re-move-clmnbr-pl:
     2418     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     2419     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     2420     DO varmvibr-pl = 1 TO EXTENT(cur-clmn-numbr-pl):
     2421       if cur-clmn-numbr-pl[varmvibr-pl] = source-column THEN cur-clmn-numbr-pl[varmvibr-pl] = -1.
     2422     END.
     2423     if br-pl:MOVE-COLUMN(source-column, target-column) IN FRAME d-pl-list then.
     2424     if source-column > target-column THEN
     2425     DO varmvjbr-pl = source-column - 1 to target-column BY -1:
     2426       DO varmvibr-pl = 1 TO EXTENT(cur-clmn-numbr-pl):
     2427           if cur-clmn-numbr-pl[varmvibr-pl] = varmvjbr-pl THEN DO:
     2428             cur-clmn-numbr-pl[varmvibr-pl] = cur-clmn-numbr-pl[varmvibr-pl] + 1.
     2429           END.
     2430       END.
     2431     END.
     2432     ELSE
     2433     DO varmvjbr-pl = source-column + 1 to target-column:
     2434       DO varmvibr-pl = 1 TO EXTENT(cur-clmn-numbr-pl):
     2435         if cur-clmn-numbr-pl[varmvibr-pl] = varmvjbr-pl THEN DO:
     2436           cur-clmn-numbr-pl[varmvibr-pl] = cur-clmn-numbr-pl[varmvibr-pl] - 1.
     2437         END.
     2438       END.
     2439     END.
     2440     DO varmvibr-pl = 1 TO EXTENT(cur-clmn-numbr-pl):
     2441       if cur-clmn-numbr-pl[varmvibr-pl] = -1 THEN cur-clmn-numbr-pl[varmvibr-pl] = target-column.
     2442     END.
     2443   END PROCEDURE.
     2444   PROCEDURE ch-clmnbr-pl:
     2445     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     2446     if cur-clmn-loc <= 2 then do:
     2447       return .
     2448     end.
     2449     DO varmvibr-pl = 1 TO EXTENT(cur-clmn-numbr-pl):
     2450       if cur-clmn-numbr-pl[varmvibr-pl] = cur-clmn-loc THEN move-elementbr-pl = varmvibr-pl.
     2451     END.
     2452     RUN re-move-clmnbr-pl (cur-clmn-loc, 2).
     2453   END PROCEDURE.
     2454   PROCEDURE mv-brw-defaultbr-pl:
     2455   def var old-session as logical no-undo.
     2456     old-session = SESSION:IMMEDIATE-DISPLAY.
     2457     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     2458     do varmvlbr-pl = 2 to EXTENT(cur-clmn-numbr-pl):
     2459       RUN re-move-clmnbr-pl (cur-clmn-numbr-pl[varmvlbr-pl], varmvlbr-pl).
     2460     END.
     2461     RUN start-mv-clmnbr-pl.
     2462     SESSION:IMMEDIATE-DISPLAY = old-session.
     2463   END PROCEDURE.
     2464   .
     2465     APPLY "ENTRY" to br-pl.
     2466     WAIT-FOR GO OF FRAME d-pl-list focus br-pl.
     2467   END.
     2468   RUN disable_UI.
     2469   PROCEDURE disable_UI :
     2470     HIDE FRAME d-pl-list.
     2471   END PROCEDURE.
     2472   PROCEDURE enable_UI :
     2473   assign
     2474     X_place-io.place-io-name:read-only in browse br-pl = true.
     2475   ENABLE b-quit b-print b-help br-pl RADIO-obj RADIO-type
     2476      b-sel when can-do ("b-sel", bttns)
     2477      b-mark when can-do ("b-mark", bttns)
     2478      b-add when can-do ("b-add", bttns)
     2479      b-chg when can-do ("b-add", bttns)
     2480      b-del when can-do ("b-add", bttns)
     2481      b-sch
     2482      b-hist
     2483      with frame d-pl-list.
     2484      HIDE
     2485      b-print
     2486      in frame d-pl-list.
     2487   END PROCEDURE.
     2488   PROCEDURE OpenBr :
     2489     define variable l-query-was-opened as logical no-undo .
     2490     define variable sort-column-phrase as character no-undo .
     2491     define buffer buf_clients for ub.clients .
     2492     run waitfram-show in this-procedure ("Ждите...").
     2493     if sort-column-name = "" then assign sort-column-phrase = "" .
     2494     else                          assign sort-column-phrase = "by " + sort-column-name .
     2495     CASE p-mode :
     2496       when 'объект':U then do:
     2497         FIND FIRST buf_clients NO-LOCK WHERE buf_clients.obj-type = p-obj-type AND buf_clients.obj-code = p-obj-code NO-ERROR.
     2498         if p-type = 'all' then do:
     2499           ASSIGN frame d-pl-list:TITLE = "Места приемки/отгрузки " + buf_clients.obj-name    filter-point = "Места приемки/отгрузки" + p-mode.
     2500   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2501   define variable  l-disable-where-23  as logical   no-undo .
     2502   define variable  l-filter-open-23    as logical   .
     2503   define variable  flt-rec-23       as recid     no-undo .
     2504   define variable  filter-name-23      as character no-undo .
     2505   define variable  where-phrase-23     as character no-undo .
     2506   define variable  sort-phrase-23      as character no-undo .
     2507   define variable  where-phrase-rus-23 as character no-undo .
     2508   define variable  sort-phrase-rus-23  as character no-undo .
     2509     run waitfram-show in this-procedure
     2510       (input "ЖДИТЕ ..."
     2511       ).
     2512   run gbl/flt-get.p
     2513     (input filter-point
     2514     ,output flt-rec-23
     2515     ,output filter-name-23
     2516     ,output where-phrase-23
     2517     ,output sort-phrase-23
     2518     ,output where-phrase-rus-23
     2519     ,output sort-phrase-rus-23
     2520     ).
     2521       run set-filter-name in this-procedure
     2522         (INPUT filter-name-23
     2523         ) no-error .
     2524     assign
     2525       l-filter-open-23 = false
     2526     .
     2527     if flt-rec-23 <> ?
     2528       or sort-column-phrase > ""
     2529     then do:
     2530       define variable  parameter-2-23 as character no-undo .
     2531       define variable  parameter-3-23 as character no-undo .
     2532       define variable  parameter-4-23 as character no-undo .
     2533       define variable  parameter-5-23 as character no-undo .
     2534       define variable  parameter-6-23 as character no-undo .
     2535       define variable  parameter-7-23 as character no-undo .
     2536         assign
     2537         parameter-3-23 =
     2538                                 "FOR EACH X_place-io"
     2539         parameter-4-23 =
     2540           (
     2541             if (" X_place-io.obj-type = p-obj-type AND X_place-io.obj-code = p-obj-code " + " " + where-phrase-23) <> ""
     2542             then  substitute(' X_place-io.obj-type = &3&1&3 AND X_place-io.obj-code  = &2 ', p-obj-type, p-obj-code, chr(34))  + " " + where-phrase-23
     2543             else "true"
     2544           )
     2545         parameter-5-23 = (" " + "" + " " + "")
     2546         parameter-6-23 = if sort-phrase-23 = ''
     2547                              then
     2548           (
     2549           " " + "  " +
     2550             " " + sort-column-phrase +
     2551           " " + "  "
     2552           )
     2553                              else
     2554           (
     2555           " " + "  " +
     2556             " " + sort-column-phrase +
     2557           " " + sort-phrase-23
     2558           )
     2559         parameter-7-23 =
     2560           " indexed-reposition  "
     2561       .
     2562       do
     2563       on stop undo, leave
     2564       on error undo, leave
     2565       :
     2566         assign
     2567           l-disable-where-23 =
     2568             (" X_place-io.obj-type = p-obj-type AND X_place-io.obj-code = p-obj-code " + " " + where-phrase-23 = "")
     2569         .
     2570         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     2571                             ,input QUERY br-pl:handle
     2572                             ,input parameter-3-23
     2573                             ,input parameter-4-23
     2574                             ,input parameter-5-23
     2575                             ,input parameter-6-23
     2576                             ,input parameter-7-23
     2577                             )
     2578         .
     2579         assign
     2580           l-filter-open-23 = true
     2581         .
     2582       end.
     2583       if l-filter-open-23 = false then do:
     2584         message
     2585           "Ошибка при фильтрации / сортировке" skip
     2586           "Будут показаны записи без учета фильтра" skip
     2587           view-as alert-box .
     2588       end.
     2589       else do:
     2590           assign
     2591             l-query-was-opened = true
     2592           .
     2593       end.
     2594     end.
     2595     if l-filter-open-23 = false then do:
     2596       OPEN QUERY br-pl FOR EACH X_place-io
     2597         where  X_place-io.obj-type = p-obj-type AND X_place-io.obj-code = p-obj-code
     2598         indexed-reposition
     2599     .
     2600         assign
     2601           l-query-was-opened = true
     2602         .
     2603     end.
     2604     run waitfram-hide in this-procedure .
     2605         end.
     2606         else do:
     2607           if p-type = 'приемки':U then ASSIGN frame d-pl-list:TITLE = "Места приемки " + buf_clients.obj-name   filter-point = "Места приемки " + p-mode .
     2608           else                         ASSIGN frame d-pl-list:TITLE = "Места отгрузки " + buf_clients.obj-name  filter-point = "Места отгрузки " + p-mode .
     2609   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
