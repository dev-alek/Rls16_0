        1   block-level on error undo, throw.
        2   DEFINE INPUT     PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        3   define input parameter p-curr-host-code like ub.sysconf.host-code no-undo.
        4   define input parameter p-host-code like ub.fin-doc.host-code no-undo.
        5   define input parameter p-fin-doc-code like ub.fin-doc.fin-doc-code no-undo.
        6   define input parameter p-corr-user-db-num as integer no-undo .
        7   define input parameter p-chip-num as integer no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: shwcfind.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: ref/shwcfind.p $":U .
       13   define variable vss-description as character no-undo init "Показать историю финансового документа".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75     define variable v-cntxt-db-num        as integer   no-undo .
       76     define variable v-cntxt-userid        as character no-undo .
       77     define variable v-cntxt-level         as character no-undo .
       78     define variable v-cntxt-host-code-obj as integer   no-undo .
       79     define variable v-cntxt-obj-type      as character no-undo .
       80     define variable v-cntxt-obj-code      as integer   no-undo .
       81     define variable v-cntxt-db-num-obj    as integer   no-undo .
       82     define variable v-cntxt-is-admin      as logical   no-undo .
       83   define variable loc-doc-rec as recid no-undo .
       84   define buffer buf_c-fin-doc for ub.c-fin-doc.
       85   do
       86   on error undo, return error return-value
       87   :
       88   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       89     run mainmenu_getcntxt in parparentproc
       90       (output v-cntxt-db-num
       91       ,output v-cntxt-userid
       92       ,output v-cntxt-level
       93       ,output v-cntxt-host-code-obj
       94       ,output v-cntxt-obj-type
       95       ,output v-cntxt-obj-code
       96       ,output v-cntxt-db-num-obj
       97       ,output v-cntxt-is-admin
       98       ) .
       99     find first buf_c-fin-doc no-lock
      100       where buf_c-fin-doc.host-code    = p-host-code
      101         and buf_c-fin-doc.fin-doc-code = p-fin-doc-code
      102         and buf_c-fin-doc.corr-user-db-num = p-corr-user-db-num
      103         and buf_c-fin-doc.chip-num = p-chip-num
      104       no-error.
      105     if not available buf_c-fin-doc then do:
      106       return error substitute("Не найдена история платежа: фирма &1 внутр№ &2 БД изменений &3 срез &4"
      107                                , p-host-code
      108                                , p-fin-doc-code
      109                                , p-corr-user-db-num
      110                                , p-chip-num
      111                                ).
      112     end.
      113     define variable v-ok as logical   no-undo .
      114   define variable vss-include-info2 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      115   do:
      116     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      117       (input  v-cntxt-db-num
      118       ,input  v-cntxt-userid
      119       ,input  0
      120       ,input  'actn_fin-doc_lookup':U
      121       ,input  'firm':U
      122       ,input  p-curr-host-code
      123       ,input  '':U
      124       ,input  0
      125       ,input  0
      126       ,input  0
      127       ,input  0
      128       ,input  true
      129       ,output v-ok
      130       )  .
      131   end.
      132     if not v-ok then return error.
      133     assign
      134     loc-doc-rec = recid(buf_c-fin-doc).
      135     CASE buf_c-fin-doc.fin-doc-type:
      136       when 'пко':U then do:
      137               run ref/fncdoci1.w
      138                             (
      139                                input parParentProc
      140                               ,input p-curr-host-code
      141                               ,input 'ПРОСМОТР':U
      142                               ,input buf_c-fin-doc.host-code
      143                               ,input buf_c-fin-doc.fin-doc-code
      144                               ,input buf_c-fin-doc.fin-ext-doc-type
      145                               ,input-output loc-doc-rec
      146                                           )
      147               .
      148       end.
      149       when 'рко':U then do:
      150               run ref/fncdoci2.w
      151                             (
      152                                input parParentProc
      153                               ,input p-curr-host-code
      154                               ,input 'ПРОСМОТР':U
      155                               ,input buf_c-fin-doc.host-code
      156                               ,input buf_c-fin-doc.fin-doc-code
      157                               ,input buf_c-fin-doc.fin-ext-doc-type
      158                               ,input-output loc-doc-rec
      159                                           )
      160               .
      161       end.
      162       when 'ппп':U then do:
      163               run ref/fncdoci3.w
      164                             (
      165                                input parParentProc
      166                               ,input p-curr-host-code
      167                               ,input 'ПРОСМОТР':U
      168                               ,input buf_c-fin-doc.host-code
      169                               ,input buf_c-fin-doc.fin-doc-code
      170                               ,input buf_c-fin-doc.fin-ext-doc-type
      171                               ,input-output loc-doc-rec
      172                                           )
      173               .
      174       end.
      175       when 'рпп':U then do:
      176               run ref/fncdoci4.w
      177                             (
      178                                input parParentProc
      179                               ,input p-curr-host-code
      180                               ,input 'ПРОСМОТР':U
      181                               ,input buf_c-fin-doc.host-code
      182                               ,input buf_c-fin-doc.fin-doc-code
      183                               ,input buf_c-fin-doc.fin-ext-doc-type
      184                               ,input-output loc-doc-rec
      185                                           )
      186               .
      187       end.
      188       when 'апп':U then do:
      189               run ref/fncdoci5.w
      190                             (
      191                                input parParentProc
      192                               ,input p-curr-host-code
      193                               ,input 'ПРОСМОТР':U
      194                               ,input buf_c-fin-doc.host-code
      195                               ,input buf_c-fin-doc.fin-doc-code
      196                               ,input buf_c-fin-doc.fin-ext-doc-type
      197                               ,input-output loc-doc-rec
      198                                           )
      199               .
      200       end.
      201       when 'апр':U then do:
      202               run ref/fncdoci6.w
      203                             (
      204                                input parParentProc
      205                               ,input p-curr-host-code
      206                               ,input 'ПРОСМОТР':U
      207                               ,input buf_c-fin-doc.host-code
      208                               ,input buf_c-fin-doc.fin-doc-code
      209                               ,input buf_c-fin-doc.fin-ext-doc-type
      210                               ,input-output loc-doc-rec
      211                                           )
      212               .
      213       end.
      214   END CASE.
      215   end.
