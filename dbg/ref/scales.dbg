      571   mFramBachModHandle = frame waitfram:handle.
      572   define variable mFameOldVis as logical no-undo.
      573   define variable mVisCUrentVin as logical no-undo.
      574   if session:batch-mode
      575   then
      576      mBatchMode = yes.
      577   if mBatchMode = ? then do:
      578     mVisCUrentVin = current-window:visible.
      579     mFameOldVis = mFramBachModHandle:visible.
      580     mFramBachModHandle:visible  = yes.
      581     mBatchMode = mFramBachModHandle:visible ne yes.
      582     mFramBachModHandle:visible = mFameOldVis.
      583     current-window:visible = mVisCUrentVin.
      584   end.
      585    if  log-manager:logfile-name ne ?
      586     then DO:
      587         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      588         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      589         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      590     end.
      591   on choose of B-WaitFramStop in frame waitfram
      592   do:
      593     mWaitFramStop = yes.
      594     mWaitFramStopUser = yes.
      595   end.
      596   function waitfram-check-timeout returns logical():
      597      define variable vtime as int64 no-undo.
      598      if mWaitFramStopTimeOut
      599      then
      600         return yes.
      601      vtime = ( now - mWaitFramStartProc ) / 1000 .
      602      if     mWaitFramTimeOut ne ?
      603         and mWaitFramTimeOut ne 0
      604         and mWaitFramTimeOut lt vtime
      605      then do:
      606         mWaitFramStopTimeOut = yes.
      607      end.
      608      return mWaitFramStopTimeOut.
      609   end.
      610   procedure waitfram-hide :
      611     if not session:batch-mode
      612     then do
      613     on error undo, return error return-value
      614     :
      615       pause 0 before-hide .
      616       if not mBatchMode then
      617         hide frame waitfram .
      618     if     not mWaitFramView
      619        and mWaitProcEvent
      620     then
      621       process events .
      622     end.
      623   end procedure.
      624   procedure waitfram-show :
      625     define input  parameter p-message as character no-undo .
      626     define variable v-left-margin as integer   no-undo .
      627     if not session:batch-mode
      628     then do
      629     on error undo, return error return-value
      630     :
      631       if length(p-message) <= 70 then do:
      632         assign
      633           v-left-margin = integer((70 - length(p-message)) / 2)
      634         .
      635         assign
      636           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      637         .
      638         assign
      639           v-waitfram-action01 = " "
      640           v-waitfram-action02 = " "
      641                                    + fill(" ", v-left-margin)
      642                                    + p-message
      643           v-waitfram-action03 = " "
      644         .
      645       end.
      646       else do:
      647         define variable vRindex1 as integer no-undo.
      648         define variable vRindex2 as integer no-undo.
      649         vRindex1 = r-index(p-message," ",70).
      650         if vRindex1 = 0
      651         then
      652            vRindex1 = 70.
      653         if length(p-message)  <= vRindex1 + 70 then do:
      654           assign
      655             v-waitfram-action01 = " "
      656             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      657             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      658           .
      659         end.
      660         else do:
      661           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      662           if vRindex2 <= vRindex1
      663           then
      664              vRindex2 = vRindex1 + 70.
      665           assign
      666             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      667             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      668             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      669           .
      670         end.
      671       end.
      672       B-viewProcInfo:visible   in frame waitfram = no.
      673       B-viewProcInfo:sensitive in frame waitfram = no.
      674       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      675       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      676       if  (   mWaitFramView
      677          or  mWaitProcEvent)
      678          and not mBatchMode
      679       then
      680          display
      681             v-waitfram-action01 skip
      682             v-waitfram-action02 skip
      683             v-waitfram-action03 skip
      684          with frame waitfram .
      685       if     mWaitFramView
      686          then do:
      687             if     mWaitFramInterval ne ?
      688                and not mBatchMode
      689             then
      690                wait-for go of frame waitfram pause mWaitFramInterval.
      691          end.
      692          else
      693             if     mWaitProcEvent
      694                and not mBatchMode
      695             then
      696                process events .
      697     end.
      698   end procedure.
      699      procedure waitfram-show-this:
      700         define input  parameter iInterval as int64 no-undo.
      701         define variable vtime as int64 no-undo.
      702         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      703         mWaitFramInterval = iInterval.
      704         run waitfram-show (substitute("&1&2 &3&4" ,
      705                                       mWaitFramTextBeg ,
      706                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      707                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      708                                       mWaitFramTextEnd
      709                                      )
      710                           ).
      711      end.
      712      procedure WaitFramRunPause:
      713         define input  parameter iInterval as dec no-undo.
      714         define variable vStart  as datetime-tz no-undo.
      715         define variable vend    as datetime-tz no-undo.
      716         define variable vint as int64 no-undo.
      717         define variable vOk as logical no-undo.
      718         vStart = now.
      719         vend   = vStart.
      720         publish "WaitFramPause" (iInterval,output vOk).
      721         vend   =  now.
      722         vint = vend - vStart.
      723         vint = iInterval - vint / 1000.
      724         if     not mWaitFramStop
      725            and (   vint > 0
      726                 or (    not vOk
      727                     and iInterval eq ?
      728                     )
      729                 )
      730         then
      731            run waitfram-show-this (iInterval).
      732         vend   =  now.
      733         vint = vend - vStart.
      734         vint = iInterval - vint / 1000.
      735         if     not mWaitFramStop
      736            and vint > 0
      737         then do:
      738            run gbl/pause.p (vint * 1000).
      739         end.
      740         if iInterval ne ?
      741         then
      742            publish "WaitFramStop".
      743         waitfram-check-timeout().
      744      end.
      745      procedure WaitFramWaitFor:
      746         define input  parameter iInterval as dec no-undo.
      747         assign
      748            mWaitFramStartProc   = now
      749            mWaitFramStopUser    = no
      750            mWaitFramStopTimeOut = no
      751         .
      752         block-wait:
      753         do while not mWaitFramStop:
      754            run WaitFramRunPause (iInterval).
      755            if  waitfram-check-timeout()
      756            then do:
      757               leave block-wait.
      758            end.
      759         end.
      760         run waitfram-hide.
      761      end.
      762   procedure waitfram-join :
      763     define input  parameter p-line-1  as character no-undo .
      764     define input  parameter p-line-2  as character no-undo .
      765     define input  parameter p-line-3  as character no-undo .
      766     define output parameter p-message as character no-undo .
      767     do
      768     on error undo, return error return-value
      769     :
      770       assign
      771         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      772                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      773                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      774       .
      775     end.
      776   end procedure.
      777   function waitfram-join-function returns character
      778     (input p-line-1 as character
      779     ,input p-line-2 as character
      780     ,input p-line-3 as character
      781     ).
      782     define variable v-message as character no-undo .
      783     run waitfram-join in this-procedure
      784       (input  p-line-1
      785       ,input  p-line-2
      786       ,input  p-line-3
      787       ,output v-message
      788       ) .
      789     return v-message .
      790   end function .
