     3422   define variable vss-include-info61 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3423   procedure minbtn-set :
     3424       do
     3425           on error undo, return error return-value
     3426           :
     3427           define variable ii              as integer       no-undo .
     3428           define variable fh              as widget-handle no-undo .
     3429           define variable hh              as widget-handle no-undo .
     3430           define variable v-h             as handle        extent 4 no-undo .
     3431           define variable v-name-button   as character     no-undo .
     3432           define variable v-help-old-x    as decimal       no-undo .
     3433           define variable v-help-old-y    as decimal       no-undo .
     3434           define variable v-help-old-size as decimal       no-undo .
     3435           define variable v-frame-width   as decimal       no-undo .
     3436           define variable jj              as integer       no-undo .
     3437           do
     3438               on error undo, return error
     3439               :
     3440               assign
     3441                   v-frame-width = frame Dialog-Frame:width - 0.3
     3442                   fh            = frame Dialog-Frame:first-child
     3443                   hh            = fh:first-child
     3444                   ii            = 1
     3445                   .
     3446               do while valid-handle(hh):
     3447                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     3448                   do:
     3449                       case lc(hh:name) :
     3450                           when "b-help" then
     3451                               do:
     3452                                   hh:load-image-up("cmp/b-help.bmp":u) .
     3453                                   hh:load-image-down("cmp/b-help.bmp":u) .
     3454                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     3455                                   hh:TOOLTIP = "Помощь" .
     3456                                   v-help-old-x = hh:column .
     3457                                   v-help-old-y = hh:row    .
     3458                                   v-help-old-size = hh:width .
     3459                                   hh:width-chars = 2.5 .
     3460                               end.
     3461                           when "b-print" then
     3462                               do:
     3463                                   hh:load-image("cmp/b-print.bmp":u) .
     3464                                   hh:TOOLTIP = "Печать" .
     3465                                   v-h[ii] = hh:handle .
     3466                                   ii = ii + 1 .
     3467                                   hh:width-chars = 3 .
     3468                               end.
     3469                           when "b-history" or
     3470                           when "b-hist" then
     3471                               do:
     3472                                   hh:load-image("cmp/b-hist.bmp":u) .
     3473                                   hh:TOOLTIP = "История" .
     3474                                   v-h[ii] = hh:handle .
     3475                                   ii = ii + 1 .
     3476                                   hh:width-chars = 3 .
     3477                               end.
     3478                           when "b-sch" then
     3479                               do:
     3480                                   hh:load-image("cmp/b-sch.bmp":u) .
     3481                                   hh:TOOLTIP = "Установка Фильтра" .
     3482                                   v-h[ii] = hh:handle .
     3483                                   ii = ii + 1 .
     3484                                   hh:width-chars = 3 .
     3485                               end.
     3486                           when "b-hist-user" then
     3487                               do:
     3488                                   hh:load-image("cmp/b-hist.bmp":u) .
     3489                                   hh:TOOLTIP = "История пользователя" .
     3490                                   ii = ii + 1 .
     3491                               end.
     3492                       end case.
     3493                   end.
     3494                   hh = hh:next-sibling.
     3495               end.
     3496               b-help:column = v-frame-width - b-help:width-chars.
     3497               jj = 0.
     3498               repeat ii = 4 to 1 by -1 :
     3499                   if valid-handle (v-h[ii] ) then
     3500                   do:
     3501                       jj  = jj + 1 .
     3502                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     3503                       v-h[ii]:row    = v-help-old-y .
     3504                   end.
     3505               end.
     3506           end.
     3507       end.
     3508   end procedure.
     3509   define variable vss-include-info62 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     3510   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     3511   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     3512   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     3513   define variable v-diasize-current-frame-width  as decimal   no-undo .
     3514   define variable v-diasize-current-frame-height as decimal   no-undo .
     3515   define variable v-diasize-change-size          as logical   no-undo .
     3516   define variable v-diasize-resize-button        as handle    no-undo .
     3517   define variable v-diasize-wndmax               as logical   no-undo .
     3518   define variable v-diasize-wndstore             as logical   no-undo .
     3519   define variable v-diasize-proc-name            as character no-undo .
     3520   define variable v-diasize-browse-handle        as handle    no-undo .
     3521   define variable v-diasize-browse-number        as integer   no-undo .
     3522   define variable v-diasize-need-full-display    as logical   no-undo init false .
     3523   define temp-table temp-diasize-handle no-undo
     3524     field handle-value  as handle
     3525     field save-position as decimal
     3526     index xpk is primary unique handle-value
     3527     .
     3528   define temp-table temp-browse-handle no-undo
     3529     field browse-type   as character
     3530     field browse-number as integer
     3531     field browse-handle as handle
     3532     field original-size as decimal
     3533     index xpk is primary unique browse-type browse-number
     3534     index xie browse-type browse-handle
     3535   .
     3536   procedure diasize_change-height :
     3537     define input  parameter p-change-value  as decimal   no-undo .
     3538     define input  parameter p-move-resize   as logical   no-undo .
     3539     define variable v-field-group-handle    as handle    no-undo .
     3540     define variable v-object-handle         as handle    no-undo .
     3541     define variable v-frame-height          as decimal   no-undo .
     3542     define variable v-frame-virtual-height  as decimal   no-undo .
     3543     define variable v-browse-height         as decimal   no-undo .
     3544     define variable v-window-height         as decimal   no-undo .
     3545     define variable v-window-virtual-height as decimal   no-undo .
     3546     define variable v-change-sign           as integer   no-undo .
     3547     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3548     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3549     if p-change-value > 0
     3550     then do:
     3551       if frame Dialog-Frame :height + p-change-value
     3552           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     3553       then do:
     3554         assign
     3555           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     3556                           - (frame Dialog-Frame :height-chars)
     3557         .
     3558         if p-change-value <= 0
     3559         then do:
     3560           run diasize_position-resize-button in this-procedure .
     3561           return .
     3562         end.
     3563       end.
     3564     end.
     3565     if p-change-value < 0
     3566     then do:
     3567       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     3568       then do:
     3569         assign
     3570           p-change-value = v-diasize-orig-frame-height
     3571                          - (frame Dialog-Frame :height-chars)
     3572         .
     3573         if p-change-value >= 0
     3574         then do:
     3575           run diasize_position-resize-button in this-procedure .
     3576           return .
     3577         end.
     3578       end.
     3579     end.
     3580     if p-change-value >= 0
     3581     then do:
     3582       assign
     3583         v-change-sign = 1
     3584       .
     3585     end.
     3586     else do:
     3587       assign
     3588         v-change-sign = -1
     3589       .
     3590     end.
     3591     assign
     3592       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3593     .
     3594     if p-change-value = 0
     3595     then do:
     3596       run diasize_position-resize-button in this-procedure .
     3597       return .
     3598     end.
     3599     move_block:
     3600     do
