     1807         else chr(63) ))  @ bar_code
     1808   caps( buf_goods.gds-name ) @ buf_goods.gds-name
     1809   price
     1810   sym5 obj-attr
     1811   sym6 with frame List-NAME .
     1812   DOWN stream PrnLibStream 1 with frame List-NAME .
     1813   ACCUMULATE buf_goods.artic( count ).
     1814   if ( accum count buf_goods.artic ) modulo 20 = 0 then
     1815   run waitfram-show in this-procedure ("Обработано строк списка : " + string ((accum count buf_goods.artic))).
     1816       END.
     1817     end.
     1818   END CASE .
     1819   run waitfram-hide in this-procedure .
     1820   PUT stream PrnLibStream Line format "x(103)" SKIP.
     1821   HIDE stream PrnLibStream FRAME CliBottomFrame .
     1822   output stream PrnLibStream close .
     1823   END PROCEDURE.
     1824   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1825   PROCEDURE ProcPricePrint-db.
     1826   define input parameter par-print-option as character no-undo .
     1827   define parameter buffer locked_scales for ub.scales.
     1828   define variable print-mode as char init "bar"   no-undo .
     1829   define variable sym1 as char init ":"   no-undo.
     1830   define variable sym2 as char init ":"   no-undo.
     1831   define variable sym3 as char init ":"   no-undo.
     1832   define variable sym4 as char init ":"   no-undo.
     1833   define variable sym5 as char init ":"   no-undo.
     1834   define variable sym6 as char init ":"   no-undo.
     1835   define variable Line   as char              no-undo.
     1836   define variable bar_code as char              no-undo.
     1837   define variable obj-attr as char              no-undo.
     1838   define variable price as char no-undo .
     1839   define variable g#report-num as integer no-undo .
     1840   define variable v-type as character no-undo .
     1841   DEFINE BUFFER buf_gds-obj-attr FOR ub.gds-obj-attr.
     1842   DEFINE BUFFER buf_goods FOR ub.goods.
     1843   DEFINE BUFFER buf_prod-bc-db FOR ub.prod-bc-db.
     1844   DEFINE BUFFER buf_prod-bc FOR ub.prod-bc.
     1845   DEFINE BUFFER buf_scales-gds FOR ub.scales-gds.
     1846   define buffer buf_bar-code for ub.bar-code.
     1847   DEFINE FRAME List-PLU
     1848   sym1 column-label ":" format "x(1)"
     1849   buf_scales-gds.PLU-code column-label "PLU" format ">>>9"
     1850   v-type COLUMN-LABEL "Тип" format "x(3)"
     1851   bar_code COLUMN-LABEL "Вес.код" format "x(7)" space(2)
     1852   buf_goods.artic COLUMN-LABEL "Артикул" format "x(16)"
     1853   buf_goods.gds-name COLUMN-LABEL "Название" format "x(40)"
     1854   price COLUMN-LABEL "Цена продажи" format "x(15)"
     1855   sym5 column-label ":" format "x(1)"
     1856   obj-attr COLUMN-LABEL "Объект" format "x(9)"
     1857   sym6 column-label ":" format "x(1)"
     1858   HEADER
     1859   cur-time-print() AT 5 format "X(35)"
     1860   string( "Страница " + string( PAGE-NUMBER( PrnLibStream ) , ">>9") )
     1861   AT 56 format "X(15)" SKIP
     1862   Line format "x(103)" AT 1
     1863   with width 160 down use-text stream-io no-box.
     1864   DEFINE FRAME List-BAR
     1865   sym1 column-label ":" format "x(1)"
     1866   bar_code COLUMN-LABEL "Вес.код" format "x(7)"
     1867   buf_scales-gds.PLU-code column-label "PLU" format ">>>9" space(2)
     1868   v-type COLUMN-LABEL "Тип" format "x(3)"
     1869   buf_goods.artic COLUMN-LABEL "Артикул" format "x(16)"
     1870   buf_goods.gds-name COLUMN-LABEL "Название" format "x(40)"
     1871   price COLUMN-LABEL "Цена продажи" format "x(15)"
     1872   sym5 column-label ":" format "x(1)"
     1873   obj-attr COLUMN-LABEL "Объект" format "x(9)"
     1874   sym6 column-label ":" format "x(1)"
     1875   HEADER
     1876   cur-time-print() AT 5 format "X(35)"
     1877   string( "Страница " + string( PAGE-NUMBER( PrnLibStream ) , ">>9") )
     1878   AT 56 format "X(15)" SKIP
     1879   Line format "x(103)" AT 1
     1880   with width 160 down use-text stream-io no-box.
     1881   DEFINE FRAME List-NAME
     1882   sym1 column-label ":" format "x(1)"
     1883   buf_goods.artic COLUMN-LABEL "Артикул" format "x(16)"
     1884   buf_goods.gds-name COLUMN-LABEL "Название" format "x(40)" space(2)
     1885   buf_scales-gds.PLU-code column-label "PLU" format ">>>9"
     1886   v-type COLUMN-LABEL "Тип" format "x(3)"
     1887   bar_code COLUMN-LABEL "Вес.код" format "x(7)"
     1888   price COLUMN-LABEL "Цена продажи" format "x(15)"
     1889   sym5 column-label ":" format "x(1)"
     1890   obj-attr COLUMN-LABEL "Объект" format "x(9)"
     1891   sym6 column-label ":" format "x(1)"
     1892   HEADER
     1893   cur-time-print() AT 5 format "X(35)"
     1894   string( "Страница " + string( PAGE-NUMBER( PrnLibStream ) , ">>9") )
     1895   AT 56 format "X(15)" SKIP
     1896   Line format "x(103)" AT 1
     1897   with width 160 down use-text stream-io no-box.
     1898   Line = fill( "-" , 103 ) .
     1899   run ref/scprmode.w ( output print-mode ) .
     1900   if print-mode = "отказ" then
     1901       return error .
     1902   run waitfram-show in this-procedure ( input "ЖДИТЕ.  Список подготавливается к печати...").
     1903   run get-report-num  in parParentProc(output g#report-num).
     1904   CASE par-print-option:
     1905     when "scalesman" then do:
     1906       output stream PrnLibStream to value( string( session:temp-directory +
     1907                                           "rpt" + string( g#report-num ) ) )
     1908                                           page-size 24 .
     1909     end.
     1910     when "normal" then dO:
     1911       output stream PrnLibStream to value( string( session:temp-directory +
     1912                                           "rpt" + string( g#report-num ) ) )
     1913                                           page-size 62 .
     1914     end.
     1915   end CASE.
     1916   FORM HEADER
     1917       Line format "x(103)" AT 1 SKIP
     1918       "Продолжение - на следующей странице" AT 10 SKIP
     1919       with FRAME CliBottomFrame width 103 PAGE-BOTTOM use-text stream-io NO-LABELS no-box.
     1920   VIEW stream PrnLibStream FRAME CliBottomFrame .
     1921   PUT stream PrnLibStream
     1922   substitute( "СПИСОК  КОДОВ  на весах N &1 (БД &2) / &3"
     1923              ,locked_scales.scales-num
     1924              ,locked_scales.db-num
     1925              ,locked_scales.scales-name ) format "x(103)" SKIP.
     1926   CASE print-mode :
     1927     when "plu" then do:
     1928       PUT stream PrnLibStream space(4) "( Упорядочен по коду на весах )" SKIP.
     1929       FORM with frame List-PLU .
     1930       FOR EACH buf_scales-gds WHERE
     1931              buf_scales-gds.db-num = locked_scales.db-num AND
     1932              buf_scales-gds.scales-num = locked_scales.scales-num NO-LOCK ,
     1933           FIRST buf_bar-code WHERE
     1934                 buf_bar-code.b-code = buf_scales-gds.b-code NO-LOCK,
     1935           FIRST buf_goods WHERE
     1936                 buf_goods.gds-code = buf_bar-code.gds-code NO-LOCK,
     1937           FIRST buf_gds-obj-attr WHERE
     1938                 buf_gds-obj-attr.gds-code = buf_bar-code.gds-code AND
     1939                 buf_gds-obj-attr.attr-code = 'scales-code':U AND
     1940                 buf_gds-obj-attr.obj-type = buf_scales-gds.obj-type AND
     1941                 buf_gds-obj-attr.obj-code = buf_scales-gds.obj-code
     1942                 NO-LOCK
     1943         BY buf_scales-gds.PLU-code :
     1944           find FIRST buf_prod-bc-db no-lock WHERE
     1945                 buf_prod-bc-db.b-str = buf_gds-obj-attr.attr-value
     1946             and buf_prod-bc-db.db-num = locked_scales.db-num  no-error.
     1947          if not available buf_prod-bc-db then do:
     1948            find first buf_prod-bc no-lock where
     1949                     buf_prod-bc.b-code = buf_bar-code.b-code
     1950                 and buf_prod-bc.b-str = buf_gds-obj-attr.attr-value no-error.
     1951            if not available buf_prod-bc then next.
     1952          end.
     1953   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1954   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1955   gp-fact-order = 0 .
     1956   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1957     (input  buf_bar-code.gds-code
     1958     ,input  buf_bar-code.node-code
     1959     ,output gp-b-code
     1960     ) no-error .
     1961   if error-status:error then do:
     1962     message
     1963       error-status :get-message(1) skip
     1964       return-value skip
     1965       view-as alert-box error .
     1966     Return error.
