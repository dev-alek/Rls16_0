     1187   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1188   PROCEDURE ProcPricePrint.
     1189   define input parameter par-print-option as character no-undo .
     1190   define parameter buffer locked_scales for ub.scales.
     1191   define variable print-mode as char init "bar"   no-undo .
     1192   define variable sym1 as char init ":"   no-undo.
     1193   define variable sym2 as char init ":"   no-undo.
     1194   define variable sym3 as char init ":"   no-undo.
     1195   define variable sym4 as char init ":"   no-undo.
     1196   define variable sym5 as char init ":"   no-undo.
     1197   define variable sym6 as char init ":"   no-undo.
     1198   define variable Line   as char              no-undo.
     1199   define variable bar_code as char              no-undo.
     1200   define variable obj-attr as char              no-undo.
     1201   define variable price as char no-undo .
     1202   define variable g#report-num as integer no-undo .
     1203   define variable v-type as character no-undo .
     1204   DEFINE BUFFER buf_gds-obj-attr FOR ub.gds-obj-attr.
     1205   DEFINE BUFFER buf_goods FOR ub.goods.
     1206   DEFINE BUFFER buf_prod-bc FOR ub.prod-bc.
     1207   DEFINE BUFFER buf_scales-gds FOR ub.scales-gds.
     1208   define buffer buf_bar-code for ub.bar-code.
     1209   DEFINE FRAME List-PLU
     1210   sym1 column-label ":" format "x(1)"
     1211   buf_scales-gds.PLU-code column-label "PLU" format ">>>9"
     1212   v-type COLUMN-LABEL "Тип" format "x(3)"
     1213   bar_code COLUMN-LABEL "Вес.код" format "x(7)" space(2)
     1214   buf_goods.artic COLUMN-LABEL "Артикул" format "x(16)"
     1215   buf_goods.gds-name COLUMN-LABEL "Название" format "x(40)"
     1216   price COLUMN-LABEL "Цена продажи" format "x(15)"
     1217   sym5 column-label ":" format "x(1)"
     1218   obj-attr COLUMN-LABEL "Объект" format "x(9)"
     1219   sym6 column-label ":" format "x(1)"
     1220   HEADER
     1221   cur-time-print() AT 5 format "X(35)"
     1222   string( "Страница " + string( PAGE-NUMBER( PrnLibStream ) , ">>9") )
     1223   AT 56 format "X(15)" SKIP
     1224   Line format "x(103)" AT 1
     1225   with width 160 down use-text stream-io no-box.
     1226   DEFINE FRAME List-BAR
     1227   sym1 column-label ":" format "x(1)"
     1228   bar_code COLUMN-LABEL "Вес.код" format "x(7)"
     1229   buf_scales-gds.PLU-code column-label "PLU" format ">>>9" space(2)
     1230   v-type COLUMN-LABEL "Тип" format "x(3)"
     1231   buf_goods.artic COLUMN-LABEL "Артикул" format "x(16)"
     1232   buf_goods.gds-name COLUMN-LABEL "Название" format "x(40)"
     1233   price COLUMN-LABEL "Цена продажи" format "x(15)"
     1234   sym5 column-label ":" format "x(1)"
     1235   obj-attr COLUMN-LABEL "Объект" format "x(9)"
     1236   sym6 column-label ":" format "x(1)"
     1237   HEADER
     1238   cur-time-print() AT 5 format "X(35)"
     1239   string( "Страница " + string( PAGE-NUMBER( PrnLibStream ) , ">>9") )
     1240   AT 56 format "X(15)" SKIP
     1241   Line format "x(103)" AT 1
     1242   with width 160 down use-text stream-io no-box.
     1243   DEFINE FRAME List-NAME
     1244   sym1 column-label ":" format "x(1)"
     1245   buf_goods.artic COLUMN-LABEL "Артикул" format "x(16)"
     1246   buf_goods.gds-name COLUMN-LABEL "Название" format "x(40)" space(2)
     1247   buf_scales-gds.PLU-code column-label "PLU" format ">>>9"
     1248   v-type COLUMN-LABEL "Тип" format "x(3)"
     1249   bar_code COLUMN-LABEL "Вес.код" format "x(7)"
     1250   price COLUMN-LABEL "Цена продажи" format "x(15)"
     1251   sym5 column-label ":" format "x(1)"
     1252   obj-attr COLUMN-LABEL "Объект" format "x(9)"
     1253   sym6 column-label ":" format "x(1)"
     1254   HEADER
     1255   cur-time-print() AT 5 format "X(35)"
     1256   string( "Страница " + string( PAGE-NUMBER( PrnLibStream ) , ">>9") )
     1257   AT 56 format "X(15)" SKIP
     1258   Line format "x(103)" AT 1
     1259   with width 160 down use-text stream-io no-box.
     1260   Line = fill( "-" , 103 ) .
     1261   run ref/scprmode.w ( output print-mode ) .
     1262   if print-mode = "отказ" then
     1263       return error .
     1264   run waitfram-show in this-procedure ( input "ЖДИТЕ.  Список подготавливается к печати...").
     1265   run get-report-num  in parParentProc(output g#report-num).
     1266   CASE par-print-option:
     1267     when "scalesman" then do:
     1268       output stream PrnLibStream to value( string( session:temp-directory +
     1269                                           "rpt" + string( g#report-num ) ) )
     1270                                           page-size 24 .
     1271     end.
     1272     when "normal" then dO:
     1273       output stream PrnLibStream to value( string( session:temp-directory +
     1274                                           "rpt" + string( g#report-num ) ) )
     1275                                           page-size 62 .
     1276     end.
     1277   end CASE.
     1278   FORM HEADER
     1279       Line format "x(103)" AT 1 SKIP
     1280       "Продолжение - на следующей странице" AT 10 SKIP
     1281       with FRAME CliBottomFrame width 103 PAGE-BOTTOM use-text stream-io NO-LABELS no-box.
     1282   VIEW stream PrnLibStream FRAME CliBottomFrame .
     1283   PUT stream PrnLibStream
     1284   substitute( "СПИСОК  КОДОВ  на весах N &1 (БД &2) / &3"
     1285              ,locked_scales.scales-num
     1286              ,locked_scales.db-num
     1287              ,locked_scales.scales-name ) format "x(103)" SKIP.
     1288   CASE print-mode :
     1289     when "plu" then do:
     1290       PUT stream PrnLibStream space(4) "( Упорядочен по коду на весах )" SKIP.
     1291       FORM with frame List-PLU .
     1292       FOR EACH buf_scales-gds WHERE
     1293              buf_scales-gds.db-num = locked_scales.db-num AND
     1294              buf_scales-gds.scales-num = locked_scales.scales-num NO-LOCK ,
     1295           FIRST buf_bar-code WHERE
     1296                 buf_bar-code.b-code = buf_scales-gds.b-code NO-LOCK,
     1297           FIRST buf_goods WHERE
     1298                 buf_goods.gds-code = buf_bar-code.gds-code NO-LOCK,
     1299           FIRST buf_gds-obj-attr WHERE
     1300                 buf_gds-obj-attr.gds-code = buf_bar-code.gds-code AND
     1301                 buf_gds-obj-attr.attr-code = 'scales-code':U AND
     1302                 buf_gds-obj-attr.obj-type = buf_scales-gds.obj-type AND
     1303                 buf_gds-obj-attr.obj-code = buf_scales-gds.obj-code
     1304                 NO-LOCK
     1305           , FIRST buf_prod-bc no-lock WHERE
     1306                 buf_prod-bc.b-str = buf_gds-obj-attr.attr-value
     1307           BY buf_scales-gds.PLU-code :
     1308   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1309   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1310   gp-fact-order = 0 .
     1311   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1312     (input  buf_bar-code.gds-code
     1313     ,input  buf_bar-code.node-code
     1314     ,output gp-b-code
     1315     ) no-error .
     1316   if error-status:error then do:
     1317     message
     1318       error-status :get-message(1) skip
     1319       return-value skip
     1320       view-as alert-box error .
     1321     Return error.
     1322   end.
     1323   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1324   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1325     (input  buf_scales-gds.obj-type
     1326     ,input  buf_scales-gds.obj-code
     1327     ,input  gp-b-code
     1328     ,input  0
     1329     ,input  gp-fact-order
     1330     ,output gp-doc-num
     1331     ,output gp-price-sale
     1332     ,output gp-road-tax
     1333     ,output gp-excise
     1334     ) no-error .
     1335   if error-status:error then do:
     1336     Return error.
     1337   end.
     1338   gp-price-sale-parts = gp-price-sale.
     1339   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1340   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_avprpart in g#lib-trn3
     1341     (input  buf_scales-gds.obj-type
     1342     ,input  buf_scales-gds.obj-code
     1343     ,input  gp-b-code
     1344     ,input  0
     1345     ,input  gp-fact-order
     1346     ,output gp-doc-num
     1347     ,output gp-price-sale-parts
     1348     ,output gp-road-tax
     1349     ,output gp-excise
     1350     ) no-error .
     1351   if error-status:error then do:
     1352     Return error.
     1353   end.
     1354   if gp-price-sale-parts <> 0 and gp-price-sale-parts <> ? then do:
     1355       gp-price-sale = gp-price-sale-parts.
     1356    end.
     1357   assign
     1358   obj-attr = buf_scales-gds.obj-type + " " + string( buf_scales-gds.obj-code )
     1359   price = ( if  gp-price-sale = ?
     1360             then "НЕТ ЦЕНЫ"
     1361             else string( gp-price-sale, "->>>,>>>,>>9.99" ) )
     1362   .
     1363   DISPLAY stream PrnLibStream
     1364   sym1 buf_scales-gds.PLU-code
     1365   entry (lookup (string(buf_scales-gds.plu-type), '0,1':U) + 1, ',' + 'Весовой,Штучный':U) @ v-type
     1366   buf_goods.artic
     1367   (if available buf_prod-bc
     1368   then buf_prod-bc.b-str
     1369   else (if  available buf_prod-bc
     1370         then buf_prod-bc.b-str
     1371         else chr(63) ))  @ bar_code
     1372   caps( buf_goods.gds-name ) @ buf_goods.gds-name
     1373   price
     1374   sym5 obj-attr
     1375   sym6 with frame List-PLU .
     1376   DOWN stream PrnLibStream 1 with frame List-PLU .
     1377   ACCUMULATE buf_goods.artic( count ).
     1378   if ( accum count buf_goods.artic ) modulo 20 = 0 then
     1379   run waitfram-show in this-procedure ("Обработано строк списка : " + string ((accum count buf_goods.artic))).
     1380       END.
     1381     end.
     1382     when "bar" then do:
     1383       PUT stream PrnLibStream space(4) "( Упорядочен по весовому коду )" SKIP.
     1384       FORM with frame List-BAR .
     1385       FOR EACH buf_scales-gds WHERE
     1386                 buf_scales-gds.db-num = locked_scales.db-num AND
     1387                 buf_scales-gds.scales-num = locked_scales.scales-num NO-LOCK ,
     1388           FIRST buf_bar-code WHERE
     1389                 buf_bar-code.b-code = buf_scales-gds.b-code NO-LOCK,
     1390           FIRST buf_goods WHERE
     1391                 buf_goods.gds-code = buf_bar-code.gds-code NO-LOCK,
     1392           FIRST buf_gds-obj-attr WHERE
     1393                 buf_gds-obj-attr.gds-code = buf_bar-code.gds-code AND
     1394                 buf_gds-obj-attr.attr-code = 'scales-code':U AND
     1395                 buf_gds-obj-attr.obj-type = buf_scales-gds.obj-type AND
     1396                 buf_gds-obj-attr.obj-code = buf_scales-gds.obj-code
     1397                 NO-LOCK
     1398         , FIRST buf_prod-bc no-lock WHERE
     1399                 buf_prod-bc.b-str = buf_gds-obj-attr.attr-value
     1400            BY buf_prod-bc.b-str :
     1401   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1402   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1403   gp-fact-order = 0 .
     1404   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1405     (input  buf_bar-code.gds-code
     1406     ,input  buf_bar-code.node-code
     1407     ,output gp-b-code
     1408     ) no-error .
     1409   if error-status:error then do:
     1410     message
     1411       error-status :get-message(1) skip
     1412       return-value skip
     1413       view-as alert-box error .
     1414     Return error.
     1415   end.
     1416   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1417   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1418     (input  buf_scales-gds.obj-type
     1419     ,input  buf_scales-gds.obj-code
     1420     ,input  gp-b-code
     1421     ,input  0
     1422     ,input  gp-fact-order
