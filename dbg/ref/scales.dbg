     3918         (input  (p-new-height - frame Dialog-Frame :height)
     3919         ,input  p-move-resize
     3920         ) .
     3921     end.
     3922   end procedure.
     3923   procedure diasize_change-width :
     3924     define input  parameter p-change-value as decimal   no-undo .
     3925     define input  parameter p-move-resize  as logical   no-undo .
     3926     define variable v-field-group-handle   as handle    no-undo .
     3927     define variable v-object-handle        as handle    no-undo .
