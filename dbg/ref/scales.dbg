     4782       ,input  '':U
     4783       ,input  0
     4784       ,input  0
     4785       ,input  0
     4786       ,input  0
     4787       ,input  false
     4788       ,output glog
     4789       )  .
     4790   end.
     4791       rs-object:RADIO-BUTTONS IN FRAME Dialog-Frame = (IF p-mode = 'все':U AND v-cntxt-db-num = 0
     4792                                                         THEN ("Все" + chr(44) + 'все':U + chr(44) +
     4793                                                             "БД" + chr(44) + 'db':U + chr(44) +
     4794                                                               p-obj-type + string(p-obj-code) + chr(44) + 'объект':U)
     4795                                                         ELSE ("БД" + chr(44) + 'db':U + chr(44) +
     4796                                                               p-obj-type + string(p-obj-code) + chr(44) + 'объект':U))
     4797       .
     4798     if p-mode = 'все':U then  do :
     4799       v-mode = p-mode .
     4800     end.
     4801     else do :
     4802       v-mode = 'db' .
     4803     end.
     4804     if glog = true and p-mode = 'все':U AND v-cntxt-db-num = 0 then do :
     4805       assign
     4806         v-mode = 'все':U
     4807         rs-object = 'все':U
     4808       .
     4809     end.
     4810       else do:
     4811         if glog = true then do:
     4812           assign rs-object = 'db':U
     4813                  v-mode = 'db':U.
     4814         end.
     4815         else do:
     4816           assign rs-object = 'объект':U
     4817                  v-mode = 'объект':U.
     4818         end.
     4819       end.
     4820     if not glog then do :
     4821       MENU-ITEM m___all:SENSITIVE in MENU menu-b-gds = no .
     4822     end.
     4823   end.
     4824   else do:
     4825     rs-object:RADIO-BUTTONS IN FRAME Dialog-Frame = (IF p-mode = 'все':U AND v-cntxt-db-num = 0
     4826                                                       THEN ("Все" + chr(44) + 'все':U + chr(44) +
     4827                                                           "БД" + chr(44) + 'db':U )
     4828                                                       ELSE ("БД" + chr(44) + 'db':U + chr(44)
     4829                                                             ))
     4830     .
     4831       if p-mode = 'все':U then  do :
     4832         v-mode = p-mode .
     4833   end.
     4834       else do :
     4835         v-mode = 'db' .
     4836       end.
     4837   end.
     4838   DISPLAY
     4839   rs-object
     4840   mark-num
     4841   WITH FRAME Dialog-Frame.
     4842   ENABLE
     4843   b-mark
     4844   b-sel
     4845   b-gds
     4846   b-send when p-mode = 'db':U
     4847   b-quit
     4848   b-price
     4849   b-help
     4850   b-chg  when p-mode = 'db':U
     4851   b-purg  when p-mode = 'db':U
     4852   b-add   when p-mode = 'db':U
     4853   b-del   when p-mode = 'db':U
     4854   b-on    when p-mode = 'db':U
     4855   b-rum
     4856   b-scal-grp
     4857   b-hist
     4858   br-scales
     4859   b-attr
     4860   mark-num
     4861   b-ticket when p-mode = 'db':U
     4862   rs-object
     4863   WITH FRAME Dialog-Frame.
     4864   VIEW FRAME Dialog-Frame.
     4865   RUN Openbr IN THIS-PROCEDURE.
     4866   DISABLE
     4867   b-mark WHEN NOT can-do( bttns, "b-mark" )
     4868   b-sel WHEN NOT can-do( bttns, "b-sel" )
     4869   b-send WHEN NOT can-do( bttns, "b-add" )
     4870   b-purg WHEN NOT can-do( bttns, "b-add" )
     4871   b-chg WHEN NOT can-do( bttns, "b-add" )
     4872   b-add WHEN NOT can-do( bttns, "b-add" )
     4873   b-del WHEN NOT can-do( bttns, "b-add" )
     4874   mark-num WHEN NOT can-do( bttns, "b-mark" )
     4875   WITH FRAME Dialog-Frame .
     4876   HIDE mark-num in FRAME Dialog-Frame .
     4877   END PROCEDURE.
     4878   PROCEDURE OpenBr :
     4879   define variable v-param-type as character no-undo .
     4880   define variable v-value-character as character no-undo .
     4881   define variable v-value-date as date no-undo .
     4882   define variable v-value-decimal as decimal no-undo .
     4883   define variable v-value-integer as INTEGER no-undo .
     4884   define variable v-value-logical AS LOGICAL no-undo .
     4885   define variable v-tth as handle no-undo .
     4886    CASE v-mode:
     4887       WHEN 'все':U THEN DO:
     4888         OPEN QUERY BR-scales FOR EACH ub.scales NO-LOCK.
     4889       END.
     4890       WHEN 'db':U THEN DO:
     4891         OPEN QUERY BR-scales FOR EACH ub.scales NO-LOCK WHERE ub.scales.db-num = v-cntxt-db-num.
     4892       END.
     4893       WHEN 'объект':U THEN DO:
     4894         run adm/shattri.p (
     4895             input "get":U
     4896             ,input  p-obj-type
     4897             ,input  p-obj-code
     4898             ,input  'scale-inf':U
     4899             ,input  'scallist':U
     4900             ,output v-value-character
     4901             ,output v-value-date
     4902             ,output v-value-decimal
     4903             ,output v-value-integer
     4904             ,output v-value-logical
     4905             ,output v-param-type
     4906             ,INPUT-OUTPUT table-handle v-tth
     4907             ) no-error .
     4908         v-scallist = v-value-character.
     4909         delete object v-tth.
     4910             OPEN QUERY BR-scales FOR EACH
     4911             ub.scales NO-LOCK WHERE
     4912             ub.scales.db-num = v-cntxt-db-num
     4913         AND lookup(STRING(ub.scales.scales-num), v-scallist) > 0 .
     4914             .
     4915     END.
     4916   END CASE.
     4917   END PROCEDURE.
     4918   PROCEDURE proc-b-on :
     4919   DEFINE VARIABLE loc#log AS LOGICAL NO-UNDO.
     4920   DEFINE VARIABLE loc-doc-rec AS RECID NO-UNDO.
     4921   DEFINE VARIABLE v-sts LIKE ub.scales.sts NO-UNDO.
     4922   do
     4923   on error undo, return error
     4924   on stop undo, return error
     4925   :
     4926   loc#log = no.
     4927   define variable vss-include-info73 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4928   do:
     4929     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     4930       (input  v-cntxt-db-num
     4931       ,input  v-cntxt-userid
     4932       ,input  0
     4933       ,input  'actn_scales_deletion':U
     4934       ,input  'global':U
     4935       ,input  0
     4936       ,input  '':U
     4937       ,input  0
     4938       ,input  0
     4939       ,input  0
     4940       ,input  0
     4941       ,input  true
     4942       ,output loc#log
     4943       )  .
     4944   end.
     4945   if not loc#log then return error.
     4946     assign
     4947     v-sts = ?
     4948     loc-doc-rec = RECID(ub.scales)
     4949     .
     4950     run ref/scales2.p (
     4951                     input recid(scales)
     4952                     ,input-output v-sts
     4953                    ) no-error .
     4954     if error-status:error then do:
     4955        MESSAGE
     4956        "Ошибка при изменении статуса ВЕСОВ"
     4957        RETURN-VALUE skip
     4958        error-status:get-message(1)
     4959        VIEW-AS ALERT-BOX.
     4960         undo, return error.
     4961     END.
     4962     run openbr in this-procedure.
     4963     REPOSITION br-scales To recid loc-doc-rec No-error.
     4964   if available scales then do:
     4965       loc#log = br-scales:select-focused-row( ) IN FRAME Dialog-Frame.
     4966     end.
     4967     apply "ENTRY" to br-scales.
     4968   end.
     4969   END PROCEDURE.
     4970   PROCEDURE proc-b-rum :
     4971   define input parameter p-rum-option as character no-undo .
     4972   define variable v-radio-button-parameter as character no-undo .
     4973   if p-rum-option = 'xml-file-import':U then do:
     4974     v-radio-button-parameter = 'xml-file-import':U.
     4975   end.
     4976   else do:
     4977     v-radio-button-parameter = 'batchwork-export':U  .
     4978   end.
     4979   run str/diallog.w (
     4980         input parParentProc
     4981       , input this-procedure
     4982       , input "utl/thbjrumr.w":U
     4983       , input 'thref':U + chr(4) + v-radio-button-parameter
     4984       , input no
     4985       , input "&Стоп"
     4986       , input substitute("Операции над весами") ) no-error .
     4987   if p-rum-option = 'xml-file-import':U then do:
     4988   end.
     4989   END PROCEDURE.
     4990   PROCEDURE proc-b-scal-grp :
     4991   run ref/scal-grp.w (
     4992                   input parparentproc
     4993                 , input (if v-cntxt-db-num = ub.scales.db-num
     4994                          then 'b-add'
     4995                          else '':U)
     4996                 , input v-cntxt-obj-type
     4997                 , input v-cntxt-obj-code
     4998                 , input 'scales':U
     4999                 , input ub.scales.db-num
     5000                 , input ub.scales.scales-num
     5001                 , input 0  ) no-error .
     5002   if error-status :error
     5003   then do:
     5004       undo, return error return-value.
     5005   end.
     5006   END PROCEDURE.
     5007   PROCEDURE Purg-proc :
     5008   DEFINE parameter buffer loc-scales for ub.scales.
     5009   DEFINE INPUT PARAMETER loc-PurgOption as char no-undo.
     5010   DEFINE var loc-goods-lst as char no-undo.
     5011   define variable qnty-buf as integer no-undo .
     5012   define variable for-qnty as character no-undo .
     5013   define variable scales-rid as recid no-undo.
     5014   define variable glog as logical no-undo .
     5015   define buffer b-scales for ub.scales.
     5016   glog = FALSE .
     5017   if loc-PurgOption = "ALL":U then do:
     5018     message
     5019     substitute("Вы намерены полностью очистить&1"  +
     5020                 "весы № &2&1" +
     5021                 "Продолжать ?&1"
     5022                 ,chr(10)
     5023                 ,loc-scales.scales-num)
     5024     view-as alert-box warning buttons yes-no update glog .
     5025   end.
     5026   else do:
     5027     if can-find(first ub.scales-gds no-lock where
     5028                      ub.scales-gds.scales-num = loc-scales.scales-num
     5029                  AND ub.scales-gds.db-num = loc-scales.db-num ) then do:
     5030       assign
     5031       loc-goods-lst = '':U
     5032       .
     5033       run ref/scalelst.w (
     5034                         input parparentproc
     5035                       , input p-obj-type
     5036                       , input p-obj-code
     5037                       , input loc-scales.db-num
     5038                       , input loc-scales.scales-num
     5039                       , input "b-sel,b-mark"
     5040                       , input 'все':U
     5041                       , input-output loc-goods-lst ) .
     5042       if loc-goods-lst <> "" then do:
     5043           message
     5044           "Вы уверены, что хотите удалить с весов выбранные товары!"
     5045           view-as alert-box QUESTION buttons YES-NO update glog.
     5046       end.
     5047       else do:
     5048           message
     5049           "Не найдено товаров, выбранных для очистки!"
     5050           view-as alert-box.
     5051           loc-PurgOption = "".
     5052           return error.
     5053       end.
     5054     end.
     5055   end.
     5056   if NOT glog then do:
     5057     loc-PurgOption = "".
     5058     return error.
     5059   end.
     5060   FOR EACH gds-list :
     5061     delete gds-list .
     5062   END .
     5063   if loc-scales.max-plu = 0 then do:
     5064     if can-find(first ub.scales-gds no-lock where
     5065                       ub.scales-gds.scales-num = loc-scales.scales-num
     5066                   AND ub.scales-gds.db-num = loc-scales.db-num) then do:
     5067       message
     5068       substitute("В списке товаров на весах есть товар&1" +
     5069                  "но значение поля КОЛИЧЕСТВО ТОВАРА НА ВЕСАХ = 0&1" +
     5070                  "вы можете очистить весы, задав количество удаляемых товаров", chr(10))
     5071       view-as alert-box WARNING.
     5072     end.
     5073     assign
     5074     qnty-buf = loc-scales.max-gds
     5075     for-qnty = string(qnty-buf)
     5076     .
     5077     run gbl/d-prompt.w (
     5078       'title=':u + "Сколько удалить" + '\':u
     5079     + 'text1=':u + " Удалить товаров ( начиная с 1-го )" + '\':u
     5080     + 'format=' + ">>>9" + '\':u
     5081     + 'type=' + 'I':U + '\':u
     5082     + 'fillin_row=2\':u
     5083     + 'fillin_col=4\':u
     5084     + 'fillin_width=4\':u
     5085     + 'fillin_height=1\':u
     5086     + 'max-chars=70\':u
     5087     + 'readonly=no\':u
     5088     , input-output for-qnty
     5089     ).
     5090     if return-value = 'false':u then do:
     5091       loc-PurgOption = "".
     5092       return error.
     5093     end.
     5094     qnty-buf = integer(for-qnty).
     5095     if qnty-buf > loc-scales.max-gds then do:
     5096       glog = FALSE .
     5097       message
     5098       substitute("Превышена величина&1"  +
     5099                 "максимально допустимой номенклатуры товаров&1"  +
     5100                 "для данной марки весов.&1" +
     5101                 "Вас это устраивает ?&1&1"
     5102                 , chr(10))
     5103               view-as alert-box warning buttons yes-no update glog .
     5104       if NOT glog then do:
     5105           loc-PurgOption = "".
     5106           return error.
     5107       end.
     5108     end.
     5109   end.
     5110    else qnty-buf = loc-scales.max-plu .
     5111    run str/diallog.w (
     5112           input parparentproc
     5113         , input this-procedure
     5114         , input "ref/sendscal.p":U
     5115         , input (p-obj-type + chr(4) + string(p-obj-code) + chr(4) + string(recid(ub.scales)) + chr(4) +
     5116                   "purge-" + loc-purgoption + chr(4) + loc-goods-lst + chr(4) + '':U + chr(4) +
     5117                   string(qnty-buf))
     5118         , input no
     5119         , input "":U
     5120         , input substitute("Очистка весов")
     5121     ) no-error.
     5122   IF can-find(first b-scales where
     5123                     b-scales.master = loc-scales.scales-num
     5124                 AND b-scales.db-num = loc-scales.db-num) then do:
     5125     scales-rid = recid(b-scales).
     5126     run Openbr in this-procedure .
     5127     reposition br-scales to recid scales-rid NO-ERROR.
     5128   end.
     5129   else do:
     5130     DISPLAY
     5131     loc-scales.to-send @ scales.to-send
     5132     loc-scales.tot-gds @ scales.tot-gds
     5133     with BROWSE br-scales .
     5134   end.
     5135   loc-PurgOption = "".
     5136   END PROCEDURE.
