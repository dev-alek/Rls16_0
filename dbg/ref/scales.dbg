     3931     define variable v-window-width         as decimal   no-undo .
     3932     define variable v-window-virtual-width as decimal   no-undo .
     3933     define variable v-change-sign          as integer   no-undo .
     3934     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     3935     define buffer buf_temp-browse-handle  for temp-browse-handle .
     3936     if p-change-value > 0
     3937     then do:
     3938       if frame Dialog-Frame :width + p-change-value >
     3939           session :width-chars
     3940       then do:
     3941         assign
     3942           p-change-value = session :width-chars - frame Dialog-Frame :width
     3943         .
     3944         if p-change-value <= 0
     3945         then do:
     3946           run diasize_position-resize-button in this-procedure .
     3947           return .
     3948         end.
     3949       end.
     3950     end.
     3951     if p-change-value < 0
     3952     then do:
     3953       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     3954       then do:
     3955         assign
     3956           p-change-value = v-diasize-orig-frame-width
     3957                          - frame Dialog-Frame :width
     3958         .
     3959         if p-change-value >= 0
     3960         then do:
     3961           run diasize_position-resize-button in this-procedure .
     3962           return .
     3963         end.
     3964       end.
     3965     end.
     3966     if p-change-value >= 0
     3967     then do:
     3968       assign
     3969         v-change-sign = 1
     3970       .
     3971     end.
     3972     else do:
     3973       assign
     3974         v-change-sign = -1
     3975       .
     3976     end.
     3977     assign
     3978       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     3979     .
     3980     if p-change-value = 0
     3981     then do:
     3982       run diasize_position-resize-button in this-procedure .
     3983       return .
     3984     end.
