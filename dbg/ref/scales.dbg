     1166   define variable ri as recid no-undo .
     1167   define variable CmdStr      as char no-undo .
     1168   define variable Gds-Option as Char no-undo init "".
     1169   define variable PurgOption as Char no-undo init "".
     1170   define variable PrintOption as char no-undo init "".
     1171   define variable v-doc-rec as recid no-undo .
     1172   define variable sendoption as character no-undo .
     1173   define variable attr-option as character no-undo .
     1174   define variable send-rid-list as character no-undo .
