     1176   DEFINE VARIABLE v-mode AS CHARACTER NO-UNDO.
     1177   DEFINE VARIABLE rum-option   AS CHARACTER NO-UNDO.
     1178   DEFINE VARIABLE v-scallist AS CHARACTER NO-UNDO.
     1179   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1180   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
     1181   define variable gp-price-sale like ub.price-list.price-sale no-undo.
     1182   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
     1183   define variable gp-excise     like ub.price-list.excise     no-undo.
     1184   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
     1185   define variable gp-fact-order as decimal   no-undo .
