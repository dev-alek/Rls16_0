     4769   b-rum:MENU-MOUSE in frame Dialog-Frame =  1
     4770   MENU-ITEM m_xml-file-import:SENSITIVE IN MENU menu-b-rum = no
     4771   .
     4772   if p-obj-type = 'маг':U then do:
     4773   define variable vss-include-info72 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4774   do:
     4775     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
