     2023   if ( accum count buf_goods.artic ) modulo 20 = 0 then
     2024   run waitfram-show in this-procedure ("Обработано строк списка : " + string ((accum count buf_goods.artic))).
     2025       END.
     2026     end.
     2027     when "bar" then do:
     2028       PUT stream PrnLibStream space(4) "( Упорядочен по весовому коду )" SKIP.
     2029       FORM with frame List-BAR .
     2030       FOR EACH buf_scales-gds WHERE
     2031                 buf_scales-gds.db-num = locked_scales.db-num AND
     2032                 buf_scales-gds.scales-num = locked_scales.scales-num NO-LOCK ,
     2033           FIRST buf_bar-code WHERE
     2034                 buf_bar-code.b-code = buf_scales-gds.b-code NO-LOCK,
     2035           FIRST buf_goods WHERE
     2036                 buf_goods.gds-code = buf_bar-code.gds-code NO-LOCK,
     2037           FIRST buf_gds-obj-attr WHERE
     2038                 buf_gds-obj-attr.gds-code = buf_bar-code.gds-code AND
     2039                 buf_gds-obj-attr.attr-code = 'scales-code':U AND
     2040                 buf_gds-obj-attr.obj-type = buf_scales-gds.obj-type AND
     2041                 buf_gds-obj-attr.obj-code = buf_scales-gds.obj-code
     2042                 NO-LOCK
     2043           BY buf_gds-obj-attr.attr-value :
     2044          find  FIRST buf_prod-bc-db no-lock WHERE
     2045                 buf_prod-bc-db.b-str = buf_gds-obj-attr.attr-value
     2046             and buf_prod-bc-db.db-num = locked_scales.db-num no-error.
     2047          if not available buf_prod-bc-db then do:
     2048            find first buf_prod-bc no-lock where
     2049                     buf_prod-bc.b-code = buf_bar-code.b-code
     2050                 and buf_prod-bc.b-str = buf_gds-obj-attr.attr-value no-error.
     2051            if not available buf_prod-bc then next.
     2052          end.
