     3021   ON CHOOSE OF B-rum IN FRAME Dialog-Frame
     3022   DO:
     3023     if rum-option = "":U then do:
     3024       run gbl/pop-up.p ( input self :handle, input no ) no-error.
     3025       if error-status :error then do: return no-apply. end.
     3026     end.
     3027     if rum-option = "":U then do:
     3028         return no-apply.
     3029     end.
     3030     RUN proc-b-rum IN THIS-PROCEDURE ( INPUT rum-option) NO-ERROR.
     3031     IF ERROR-STATUS:ERROR THEN DO:
     3032         rum-option = "".
     3033         RETURN NO-APPLY.
     3034     END.
     3035     rum-option = "".
     3036   END.
     3037   ON CHOOSE OF b-scal-grp IN FRAME Dialog-Frame
     3038   DO:
     3039     IF NOT AVAILABLE ub.scales THEN RETURN NO-APPLY.
     3040     RUN proc-b-scal-grp IN THIS-PROCEDURE NO-ERROR.
     3041     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     3042   END.
     3043   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
     3044   DO:
     3045         if rid-list = "" then do:
     3046               if available ub.scales then
     3047                   rid-list = string( recid( ub.scales ) ) .
     3048         end.
     3049   END.
     3050   ON CHOOSE OF B-send IN FRAME Dialog-Frame
     3051   DO:
     3052   define variable scales-rid as recid no-undo.
     3053   define variable glog as logical no-undo .
     3054   define variable object-option as character no-undo .
     3055   define variable choice as integer no-undo .
     3056   define variable goods-lst as character no-undo .
     3057   define buffer b-scales for ub.scales.
     3058   if SendOption = "" then
     3059   run gbl/pop-up.p (self:handle, yes) no-error.
     3060   if SendOption = "" then return no-apply.
     3061   if not available ub.scales then do:
     3062       message "Весы не выбраны.".
     3063       SendOption = "".
     3064       return no-apply.
     3065   end.
     3066   if ub.scales.master > 0 then do:
     3067       message
     3068       "Пересылка товаров на подчиненные весы осуществляется при пересылке товаров на главные весы"
     3069       view-as alert-box.
     3070       SendOption = "".
     3071       return no-apply.
     3072   end.
