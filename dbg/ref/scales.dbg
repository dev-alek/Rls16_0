      352   define  stream PrnLibStream.
      353   procedure prn-lib-prn-file :
      354     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      355     define input parameter p-DIsabledoptions as integer no-undo .
      356     define variable v-report-name as character no-undo .
      357     define variable v-user-action as character no-undo .
      358     define variable v-printed     as logical   no-undo .
      359     define variable v-exist       as logical   no-undo .
      360     do
      361       on error undo, return error
      362       :
      363       run prn-lib-get-report-name  in this-procedure (
      364         input parParentProc
      365         ,output v-report-name
      366         ).
      367   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      368   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      369     (input  v-report-name
      370     ,input  2
      371     ,output v-exist
      372     )  .
      373       if NOT v-exist then
      374       DO:
      375         Message
      376           "Нет заданий на печать ! "
      377           view-as alert-box .
      378         Return  .
      379       End.
      380       run gbl/prnfilen.w
      381         (input  ""
      382         ,input  p-DisabledOptions
      383         ,input  string(v-report-name )
      384         ,input  7
      385         ,output v-user-action
      386         ,output v-printed
      387         ) .
      388       if v-printed then
      389       do:
      390         return "YES" .
      391       end.
      392       else
      393       do:
      394         return "NO" .
      395       end.
      396     end.
      397   end procedure.
      398   procedure prn-lib-open-stream :
      399     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      400     define input parameter p-page-size    as integer no-undo .
      401     define input parameter p-is-stream    as logical no-undo .
      402     define input parameter p-append       as logical no-undo .
      403     define variable v-report-name as character no-undo .
      404     do
      405       on error undo, return error
      406       :
      407       run prn-lib-get-report-name  in this-procedure (
      408         input parParentProc
      409         ,output v-report-name
      410         ).
      411       if p-is-stream then
      412       do:
      413         if p-append then
      414         do:
      415           output stream PrnLibStream to value( v-report-name )
      416             page-size value(p-page-size) append .
      417         end.
      418         if not p-append then
      419         do:
      420           output stream PrnLibStream to value( v-report-name )
      421             page-size value(p-page-size) .
      422         end.
      423       end.
      424       if not p-is-stream then
      425       do:
      426         if p-append then
      427         do:
      428           output to value( v-report-name )
      429             page-size value(p-page-size) append .
      430         end.
      431         if not p-append then
      432         do:
      433           output to value( v-report-name )
      434             page-size value(p-page-size) .
      435         end.
      436       end.
      437     end.
      438   end procedure.
      439   procedure prn-lib-open-exp :
      440     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      441     define input parameter p-is-stream    as logical no-undo .
      442     define input parameter p-is-append    as logical no-undo .
      443     define output parameter p-ReportFileName as char init "report" no-undo.
      444     define output parameter p-process as logical no-undo .
      445     define variable glog as logical no-undo .
      446     do
      447       on error undo, return error
      448       :
      449       SYSTEM-DIALOG GET-FILE p-ReportFileName
      450         TITLE      "Укажите путь"
      451         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      452         ASK-OVERWRITE
      453         CREATE-TEST-FILE
      454         SAVE-AS
      455         USE-FILENAME
      456         DEFAULT-EXTENSION "txt"
      457         UPDATE glog
      458         .
      459       if not glog then  return.
      460       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      461       if p-is-stream then
      462       do:
      463         if p-is-append then
      464         do:
      465           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      466         end.
      467         else
      468         do:
      469           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      470         end.
      471       end.
      472       else
      473       do:
      474         if p-is-append then
      475         do:
      476           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      477         end.
      478         else
      479         do:
      480           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      481         end.
      482       end.
      483       p-process = yes.
      484     end.
      485   end procedure.
      486   procedure prn-lib-get-report-name :
      487     define input parameter parParentProc  as widget-handle no-undo.
      488     define output parameter p-report-name as character no-undo .
      489     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      490   end procedure.
      491   procedure prn-lib-reportviewer-report-name :
      492     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      493     define input parameter p-report-name-html as character no-undo .
      494     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      495   end procedure.
      496   procedure prn-lib-reportviewer :
      497     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      498     define input parameter p-report-name-html as character no-undo .
      499     define input parameter p-param        as character no-undo .
      500     define variable v-excel           as character no-undo init 'TRUE' .
      501     define variable v-value-character as character no-undo .
      502     define variable v-value-integer   as character no-undo .
      503     define variable v-value-date      as date      no-undo .
      504     define variable v-value-decimal   as decimal   no-undo .
      505     define variable rep-excel         as logical   no-undo .
      506     define variable excel-string      as character no-undo .
      507     define variable v-param-type      as character no-undo .
      508     define variable v-tth             as handle    no-undo .
      509     run adm/shattri.p (
      510       input "get":U
      511       ,input  ""
      512       ,input  0
      513       ,input  'report-glob':U
      514       ,input  'rep-excel':U
      515       ,output v-value-character
      516       ,output v-value-date
      517       ,output v-value-decimal
      518       ,output v-value-integer
      519       ,output rep-excel
      520       ,output v-param-type
      521       ,INPUT-OUTPUT table-handle v-tth
      522       )  .
      523     if rep-excel then v-excel = "TRUE" .
      524     else v-excel = "FALSE" .
      525     if p-param eq ""
      526     then
      527        p-param = "EXCEL:" + v-excel.
      528     else
      529        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      530     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      531   end procedure.
