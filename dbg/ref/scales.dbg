     2588             "Все", "All",
     2589             "БД", "db",
     2590   "Объект", "object"
     2591        SIZE 19 BY 1 NO-UNDO.
     2592   DEFINE QUERY BR-scales FOR
     2593         ub.scales SCROLLING.
     2594   DEFINE BROWSE BR-scales
     2595     QUERY BR-scales DISPLAY
     2596         IF ( CAN-DO (rid-list, STRING ( recid( scales ) ) ) ) THEN ("*") ELSE (" ") COLUMN-LABEL " *" FORMAT "X(1)":U
     2597         ub.scales.to-send COLUMN-LABEL "И" FORMAT "+/":U
     2598         ub.scales.scales-num FORMAT ">>9":U
     2599         ub.scales.master FORMAT ">>9":U
     2600         ub.scales.scales-name FORMAT "X(35)":U
     2601         ub.scales.tot-gds FORMAT ">>,>>9":U
     2602         entry (lookup (STRING(scales.sts), '0,1,50,99':U), 'тек,удал,блок,удаление':U) COLUMN-LABEL "Статус" FORMAT "X(8)":U
     2603         ub.scales.max-gds FORMAT ">>,>>9":U
     2604         ub.scales.scales-type FORMAT "X(15)":U
     2605         ub.scales.address FORMAT "X(25)":U
     2606         ub.scales.unit-base COLUMN-LABEL "Ед.изм." FORMAT "X(3)":U
     2607         ub.scales.db-num FORMAT ">>>>9":U
     2608       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 18.93.
     2609   DEFINE FRAME Dialog-Frame
     2610        b-quit AT ROW 1 COL 1
     2611        B-sel AT ROW 1 COL 11
     2612        B-mark AT ROW 1 COL 21
     2613        B-add AT ROW 1 COL 24
     2614        B-chg AT ROW 1 COL 34
     2615        B-del AT ROW 1 COL 44
     2616        B-gds AT ROW 1 COL 54
     2617        b-price AT ROW 1 COL 64
     2618        b-scal-grp AT ROW 1 COL 74 WIDGET-ID 2
     2619        B-hist AT ROW 1 COL 92
     2620        B-help AT ROW 1 COL 95
     2621        B-on AT ROW 2 COL 34
     2622        B-purg AT ROW 2 COL 44
     2623        B-send AT ROW 2 COL 54
     2624        b-ticket AT ROW 2 COL 64
     2625        B-rum AT ROW 2 COL 74 WIDGET-ID 4
     2626        Rs-object AT ROW 3 COL 10.5 NO-LABEL WIDGET-ID 6
     2627        B-attr AT ROW 3 COL 74
     2628        BR-scales AT ROW 4.67 COL 1
     2629        mark-num AT ROW 2.13 COL 18.6 COLON-ALIGNED NO-LABEL
     2630        SPACE(72.40) SKIP(20.47)
     2631       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2632            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2633            TITLE "Справочник весов"
     2634            DEFAULT-BUTTON b-quit.
     2635   ASSIGN
     2636          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     2637          FRAME Dialog-Frame:HIDDEN           = TRUE.
     2638   ASSIGN
     2639          B-attr:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-attr:HANDLE.
     2640   ASSIGN
     2641          B-gds:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-gds:HANDLE.
     2642   ASSIGN
     2643          b-price:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-price:HANDLE.
     2644   ASSIGN
     2645          B-purg:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-purg:HANDLE.
     2646   ASSIGN
     2647          B-rum:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-rum:HANDLE.
     2648   ASSIGN
     2649          B-send:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-B-send:HANDLE.
     2650   ASSIGN
     2651          scales.address:AUTO-RESIZE IN BROWSE BR-scales = TRUE.
     2652   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     2653   DO:
     2654     APPLY "END-ERROR":U TO SELF.
     2655   END.
     2656   ON CHOOSE OF B-add IN FRAME Dialog-Frame
     2657   DO:
     2658    define variable glog as logical no-undo .
     2659    define variable jj as integer no-undo .
     2660    define variable v-rid as recid no-undo .
     2661    def var conf-par as char no-undo.
     2662    def var par-type as char no-undo.
     2663    def buffer bf_scales for ub.scales.
     2664   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2665     (input  'num-scls'
     2666     ,input  ''
     2667     ,input  ''
     2668     ,input  0
     2669     ,input  ''
     2670     ,input  ''
     2671     ,input  '':U
     2672     ,input  yes
     2673     ,output conf-par
     2674     ,output par-type
     2675     ) no-error .
     2676       if error-status:error then do:
     2677           message subst("&1~n&2~n&3~n&4", "Ошибка при получении конф. параметра num-scls", return-value, error-status:GET-MESSAGE (1), ERROR-STATUS:GET-MESSAGE (2))
     2678                   view-as alert-box.
     2679           return.
     2680       end.
     2681       if conf-par = "0" then do:
     2682           message "Конф. параметр num-scls запрещает использовать весы."
     2683               view-as alert-box.
     2684           return.
     2685       end.
     2686       jj = br-scales:FOCUSED-ROW .
     2687       run ref/scalesi.w (
     2688                      input parparentproc
     2689                     ,input p-obj-type
     2690                     ,input p-obj-code
     2691                     ,input 'ДОБАВЛЕНИЕ':U
     2692                     ,input v-cntxt-db-num
     2693                     ,input 0
     2694                     ,output v-rid
     2695                     ) no-error .
     2696       if NOT error-status:error
     2697       and v-rid <> ?
     2698       then do:
     2699         Run Openbr in this-procedure .
     2700         REPOSITION br-scales to recid v-rid no-error .
     2701         APPLY "ENTRY" to br-scales.
     2702       end.
     2703   END.
     2704   ON CHOOSE OF B-attr IN FRAME Dialog-Frame
     2705   DO:
     2706       if not available ub.scales THEN return no-apply.
     2707     DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
     2708     if attr-option = "":U then do:
     2709       run gbl/pop-up.p ( input self :handle, input no ) no-error.
     2710       if error-status :error then do: return no-apply. end.
     2711     end.
     2712     if attr-option = "":U then do:
     2713         return no-apply.
     2714     end.
     2715     IF attr-option = 'ИЗМЕНЕНИЕ':U THEN DO:
     2716   define variable vss-include-info52 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2717   do:
     2718     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2719       (input  v-cntxt-db-num
     2720       ,input  v-cntxt-userid
     2721       ,input  0
     2722       ,input  'actn_scales_update':U
     2723       ,input  'global':U
     2724       ,input  0
     2725       ,input  '':U
     2726       ,input  0
     2727       ,input  0
     2728       ,input  0
     2729       ,input  0
     2730       ,input  true
     2731       ,output glog
     2732       )  .
     2733   end.
     2734       if NOT glog then return no-apply.
     2735     END.
     2736     run ref/scl-atti.w (  input parparentproc
     2737                     ,input attr-option
     2738                     ,input ub.scales.db-num
     2739                     ,input ub.scales.scales-num
     2740                    ) NO-ERROR.
     2741     attr-option = "":U.
     2742   END.
     2743   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     2744   DO:
     2745   define variable v-doc-rec as recid no-undo .
     2746   define variable v-rid as recid no-undo .
     2747     if available ub.scales then do:
     2748       assign
     2749       v-doc-rec = recid(scales)
     2750       v-rid = recid(scales)
     2751       .
     2752       run ref/scalesi.w (
     2753                     input parparentproc
     2754                     ,input p-obj-type
     2755                     ,input p-obj-code
     2756                     ,input 'ИЗМЕНЕНИЕ':U
     2757                     ,input scales.db-num
     2758                     ,input scales.scales-num
     2759                     ,output v-rid
     2760                       ) no-error .
     2761       if NOT error-status:error then do:
     2762         Run Openbr in this-procedure .
     2763         reposition br-scales to recid v-doc-rec no-error .
     2764         apply "entry" to br-scales in frame Dialog-Frame .
     2765       end.
     2766     end.
     2767   END.
     2768   ON CHOOSE OF B-del IN FRAME Dialog-Frame
     2769   DO:
     2770   define variable glog as logical no-undo .
     2771   define variable v-doc-rec as recid no-undo .
     2772   if not available ub.scales then do:
     2773     message "Весы не выбраны.".
     2774     return no-apply.
     2775   end.
     2776   if can-find ( first ub.scales-gds WHERE
     2777                       ub.scales-gds.db-num = scales.db-num
     2778                   AND ub.scales-gds.scales-num = scales.scales-num ) then do:
     2779       message "Есть товары на весах. Удаление невозможно."
     2780       view-as alert-box ERROR .
     2781       return no-apply.
     2782   end.
     2783   glog = no.
     2784   message "Удаление весов. Вы уверены ?"
     2785   view-as alert-box question buttons OK-Cancel update glog.
     2786   if not glog then return no-apply.
     2787   glog = no.
     2788   define variable vss-include-info53 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2789   do:
     2790     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2791       (input  v-cntxt-db-num
     2792       ,input  v-cntxt-userid
     2793       ,input  0
     2794       ,input  'actn_scales_deletion':U
     2795       ,input  'global':U
     2796       ,input  0
     2797       ,input  '':U
     2798       ,input  0
     2799       ,input  0
     2800       ,input  0
     2801       ,input  0
     2802       ,input  true
     2803       ,output glog
     2804       )  .
     2805   end.
     2806   if not glog then return no-apply.
     2807   v-doc-rec = recid (scales).
     2808   find scales WHERE recid (scales) = v-doc-rec exclusive.
     2809   delete scales.
     2810   RUN MyEnable.
     2811   apply "entry" to br-scales in frame Dialog-Frame .
     2812   END.
     2813   ON CHOOSE OF B-gds IN FRAME Dialog-Frame
     2814   DO:
     2815   define variable goods-lst as character no-undo .
     2816      if Gds-Option = "" then
     2817       run gbl/pop-up.p (self:handle, yes) no-error.
     2818       if Gds-Option = "" then return no-apply.
     2819       case Gds-Option:
     2820           when "ONE":U then do:
     2821               if available ub.scales then do:
     2822                   if ub.scales.master > 0 then do:
     2823                       message "Просмотр и изменения товаров на подчиненных весах невозможен"
     2824                       view-as alert-box.
     2825                       Gds-Option = "".
     2826                       return no-apply.
     2827                   end.
     2828                   ri = recid( ub.scales ) .
     2829                   run ref/scalelst.w (
     2830                                   input parparentproc
     2831                                 , input p-obj-type
     2832                                 , input p-obj-code
     2833                                 , input scales.db-num
     2834                                 , input scales.scales-num
     2835                                 , input "b-chg"
     2836                                 , input 'все':U
     2837                                 , input-output goods-lst ) .
     2838                   RUN MyEnable.
     2839                   apply "entry" to br-scales in frame Dialog-Frame .
     2840                   reposition br-scales to recid ri no-error.
     2841              end.
     2842           end.
     2843           when "ALL":U then do:
     2844               if available ub.scales AND can-find( first ub.scales-gds ) then
     2845               run ref/scalegds.w (
     2846                               input parparentproc
     2847                             , input p-obj-type
     2848                             , input p-obj-code
     2849                             , input scales.db-num
     2850                             ).
     2851               else
     2852               message "В системе не прописаны ни одни весы." SKIP
     2853                       "или нет товаров на весах"
     2854               view-as alert-box WARNING .
     2855           end.
     2856       END CASE.
     2857        Gds-Option = "".
     2858   END.
     2859   ON CHOOSE OF B-hist IN FRAME Dialog-Frame
     2860   DO:
     2861     define variable rid-list as character no-undo .
     2862       if available ub.scales THEN
     2863       run ref/cscales.w (
     2864                            input parparentproc
     2865                          , INPUT "":U
     2866                          , INPUT "one":U
     2867                          , OUTPUT  rid-list
     2868                          , INPUT ub.scales.db-num
     2869                          , input ub.scales.scales-num
     2870                          , input "":U
     2871                           ).
     2872       apply "entry" to br-scales.
     2873   END.
     2874   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     2875   DO:
     2876   define variable glog as logical no-undo .
     2877       if available ub.scales then do:
     2878   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2879   define variable v-str-recid55 as character no-undo .
     2880   define variable v-num-entry55 as integer   no-undo .
     2881   assign
     2882     v-str-recid55 = trim( string( recid( scales ) , "->>>>>>>>>>>9":U ) )
     2883     v-num-entry55 = lookup( v-str-recid55 , rid-list )
     2884   .
     2885   if v-num-entry55 > 0 then do:
     2886     assign
     2887       entry( v-num-entry55, rid-list ) = "":U
     2888       rid-list = trim( replace( rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     2889     .
     2890   end.
     2891   else do:
     2892     assign
     2893       rid-list = rid-list + ( if rid-list = "":U then "":U else chr(44) ) + v-str-recid55
     2894     .
     2895   end.
     2896         glog = br-scales:refresh() .
     2897         if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     2898           glog = br-scales:select-next-row ().
     2899           apply "iteration-changed" to br-scales in frame Dialog-Frame.
     2900         end.
     2901         if num-entries( rid-list ) = 0 then
     2902         hide mark-num in frame Dialog-Frame.
     2903         else
     2904         disp num-entries( rid-list ) @ mark-num with frame Dialog-Frame.
     2905      end.
     2906   END.
     2907   ON CHOOSE OF B-on IN FRAME Dialog-Frame
     2908   DO:
     2909     RUN proc-b-on IN THIS-PROCEDURE NO-ERROR.
     2910     IF ERROR-STATUS:ERROR  THEN RETURN NO-APPLY.
     2911   END.
     2912   ON CHOOSE OF b-price IN FRAME Dialog-Frame
     2913   DO:
     2914   define variable g#report-num as integer no-undo .
     2915   define variable glog as logical no-undo .
     2916   if not available ub.scales then do:
     2917       message "Весы не выбраны." view-as alert-box WARNING .
     2918       PrintOption = "".
     2919       return no-apply.
     2920   end.
     2921   if ub.scales.master > 0 then do:
     2922       message "Печать прайс-листа осуществляется только на главныx весах"
     2923       view-as alert-box.
     2924       PrintOption = "".
     2925       return no-apply.
     2926   end.
     2927   if NOT can-find( first ub.scales-gds where
     2928                          ub.scales-gds.db-num = ub.scales.db-num
     2929                      AND ub.scales-gds.scales-num = ub.scales.scales-num ) then do:
     2930       message
     2931       substitute("НЕТ товаров на весах с номером &1 (БД &2)!"
     2932                  ,ub.scales.scales-num
     2933                  ,ub.scales.db-num )
     2934       view-as alert-box information .
     2935       PrintOption = "".
     2936       return no-apply.
     2937   end.
     2938   if PrintOption = "" then do:
     2939      run gbl/pop-up.p (self:handle, yes) no-error.
     2940   end.
     2941   if PrintOption = "" then return no-apply.
     2942   if ub.scales.db-num = v-cntxt-db-num then do:
     2943     RUN ProcPricePrint in this-procedure  ( input PrintOption
     2944                                           ,buffer ub.scales) No-ERROR.
     2945   end.
     2946   else do:
     2947     RUN ProcPricePrint-db in this-procedure  ( input PrintOption
     2948                                           ,buffer ub.scales) No-ERROR.
     2949   end.
     2950   IF error-status:error then do:
     2951     PrintOption = "".
     2952     return no-apply.
     2953   end.
     2954   if PrintOption = "scalesman":U then do:
     2955      run get-report-num  in parParentProc(output g#report-num).
     2956       run adecomm/_osprint.p ( INPUT  ?,
     2957                                INPUT  string( session:temp-directory + "rpt" + string( g#report-num ) ),
     2958                                INPUT  8,
     2959                                INPUT  2,
     2960                                INPUT  0,
     2961                                INPUT  0,
     2962                                OUTPUT glog ).
     2963   end.
     2964   else do:
     2965     run prn-lib-prn-file in this-procedure (
     2966                                               input parParentProc
     2967                                               ,input 0
     2968                                               ).
     2969   end.
     2970   PrintOption = "".
     2971   apply "entry" to br-scales in frame Dialog-Frame .
     2972   END.
     2973   ON CHOOSE OF B-purg IN FRAME Dialog-Frame
     2974   DO:
     2975   define variable glog as logical no-undo .
     2976       if PurgOption = "" then
     2977       run gbl/pop-up.p (self:handle, yes) no-error.
     2978       if PurgOption = "" then return no-apply.
     2979       if NOT available ub.scales then do:
     2980               message "Весы не выбраны." view-as alert-box ERROR .
     2981               PurgOption = "".
     2982               return no-apply.
     2983       end.
     2984       if ub.scales.master > 0 then do:
     2985           message "Очистка подчиненных весов осуществляется при очистке главных весов"
     2986           view-as alert-box.
     2987           PurgOption = "".
     2988           return no-apply.
     2989       end.
     2990   define variable vss-include-info56 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2991   do:
     2992     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2993       (input  v-cntxt-db-num
     2994       ,input  v-cntxt-userid
     2995       ,input  0
     2996       ,input  'actn_scales_sending':U
     2997       ,input  'global':U
     2998       ,input  0
     2999       ,input  '':U
     3000       ,input  0
     3001       ,input  0
     3002       ,input  0
     3003       ,input  0
     3004       ,input  true
     3005       ,output glog
     3006       )  .
     3007   end.
     3008       if NOT glog then dO:
     3009           PurgOption = "".
     3010           return no-apply.
     3011       end.
     3012       run purg-proc in this-procedure ( buffer scales
     3013                                       , input PurgOption) no-error.
     3014       if error-status:error then do:
     3015         PurgOption = "".
