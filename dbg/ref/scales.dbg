     1986     (input  buf_scales-gds.obj-type
     1987     ,input  buf_scales-gds.obj-code
     1988     ,input  gp-b-code
     1989     ,input  0
     1990     ,input  gp-fact-order
     1991     ,output gp-doc-num
     1992     ,output gp-price-sale-parts
     1993     ,output gp-road-tax
     1994     ,output gp-excise
     1995     ) no-error .
     1996   if error-status:error then do:
     1997     Return error.
     1998   end.
     1999   if gp-price-sale-parts <> 0 and gp-price-sale-parts <> ? then do:
     2000       gp-price-sale = gp-price-sale-parts.
     2001    end.
     2002   assign
     2003   obj-attr = buf_scales-gds.obj-type + " " + string( buf_scales-gds.obj-code )
     2004   price = ( if  gp-price-sale = ?
     2005             then "НЕТ ЦЕНЫ"
     2006             else string( gp-price-sale, "->>>,>>>,>>9.99" ) )
