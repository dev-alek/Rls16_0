     4218           then do:
     4219             assign
     4220               v-object-handle :col = v-object-handle :col + p-change-value
     4221               no-error .
     4222             if error-status :error
     4223             or error-status :get-message(1) <> ""
     4224             then do:
     4225               undo move_block, retry move_block .
     4226             end.
     4227           end.
     4228         end.
     4229         for each buf_temp-browse-handle
     4230           where buf_temp-browse-handle.browse-type = 'width':u
     4231         on error undo move_block, retry move_block
     4232         :
     4233           assign
     4234             buf_temp-browse-handle.browse-handle :width
     4235               = buf_temp-browse-handle.browse-handle :width + p-change-value
     4236             no-error .
     4237           if error-status :error
     4238           or error-status :get-message(1) <> ""
     4239           then do:
     4240             undo move_block, retry move_block .
     4241           end.
     4242         end.
     4243         assign
     4244           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     4245           no-error .
     4246         if error-status :error
     4247         or error-status :get-message(1) <> ""
     4248         then do:
     4249           undo move_block, retry move_block.
     4250         end.
     4251         assign
     4252           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     4253         no-error .
     4254         if error-status :error
     4255         or error-status :get-message(1) <> ""
     4256         then do:
     4257           undo move_block, retry move_block.
     4258         end.
     4259         if frame Dialog-Frame :scrollable = true
     4260         then do:
     4261           assign
     4262             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     4263           no-error .
     4264           if error-status :error
     4265           or error-status :get-message(1) <> ""
     4266           then do:
     4267             undo move_block, retry move_block.
     4268           end.
     4269         end.
     4270       end.
     4271       if p-move-resize
     4272       then do:
     4273         run diasize_position-resize-button in this-procedure .
     4274       end.
     4275       if v-diasize-wndstore = true
     4276       then do:
     4277         if connected("ub") = true
     4278         then do:
     4279           define variable v-cntxt-db-num        as integer   no-undo .
     4280           define variable v-cntxt-userid        as character no-undo .
     4281           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4282                                             , OUTPUT v-cntxt-userid
     4283                                             ) .
     4284           run gbl/wndsizew.p
     4285             (input  v-cntxt-db-num
     4286             ,input  v-cntxt-userid
     4287             ,input  v-diasize-proc-name
     4288             ,input  'width':u
     4289             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     4290             ) .
     4291         end.
     4292       end.
     4293     end.
     4294     assign
     4295       v-diasize-change-size = false
     4296     .
     4297   end procedure.
     4298   procedure diasize_set-width :
     4299     define input  parameter p-new-width  as decimal   no-undo .
     4300     define input  parameter p-move-resize as logical   no-undo .
     4301     do
     4302     on error undo, return error return-value
     4303     :
     4304       run diasize_change-width in this-procedure
     4305         (input  (p-new-width - frame Dialog-Frame :width)
     4306         ,input  p-move-resize
     4307         ) .
     4308     end.
     4309   end procedure.
     4310   procedure diasize_position-resize-button :
     4311     do with frame Dialog-Frame
     4312     :
     4313       hide v-diasize-resize-button .
     4314       assign
     4315         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     4316                     - 1
     4317                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     4318         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     4319                     - 1
     4320                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     4321       .
     4322       view v-diasize-resize-button .
     4323     end.
     4324   end procedure.
     4325   on alt-right anywhere
     4326   do:
     4327     run diasize_change-width in this-procedure
     4328       (input 1
     4329       ,input true
     4330       ) .
     4331     return no-apply .
     4332   end.
     4333   on alt-left anywhere
     4334   do:
     4335     run diasize_change-width in this-procedure
     4336       (input -1
     4337       ,input true
     4338       ) .
     4339     return no-apply .
     4340   end.
     4341   on alt-down anywhere
     4342   do:
     4343     run diasize_change-height in this-procedure
     4344       (input 1
     4345       ,input true
     4346       ) .
     4347     return no-apply .
     4348   end.
     4349   on alt-up anywhere
     4350   do:
     4351     run diasize_change-height in this-procedure
     4352       (input -1
     4353       ,input true
     4354       ) .
     4355     return no-apply .
     4356   end.
     4357   on alt-enter of frame Dialog-Frame
     4358   do:
     4359     run diasize_maximize in this-procedure
     4360       (input  ?
     4361       ).
     4362     return no-apply .
     4363   end.
     4364   procedure diasize_end-move :
     4365     do
     4366     on error undo, return error return-value
     4367     :
     4368       define variable v-row-delta as decimal   no-undo .
     4369       define variable v-col-delta as decimal   no-undo .
     4370       define variable v-new-row as decimal   no-undo .
     4371       define variable v-new-col as decimal   no-undo .
     4372       assign
     4373         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     4374         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     4375       .
     4376       assign
     4377         v-row-delta = v-new-row - frame Dialog-Frame :height
     4378         v-col-delta = v-new-col - frame Dialog-Frame :width
     4379       .
     4380       run diasize_change-height in this-procedure
     4381         (input v-row-delta
     4382         ,input true
     4383         ) .
     4384       run diasize_change-width in this-procedure
     4385         (input v-col-delta
     4386         ,input true
     4387         ) .
     4388     end.
     4389   end procedure.
     4390   procedure diasize_maximize :
     4391     define input  parameter p-action as logical   no-undo .
     4392     do
     4393     on error undo, return error return-value
     4394     :
     4395       if p-action = ?
     4396       then do:
     4397         if v-diasize-need-maximize = true
     4398         then do:
     4399           assign
     4400             p-action = true
     4401           .
     4402         end.
     4403         else do:
     4404           assign
     4405             p-action = false
     4406           .
     4407         end.
     4408       end.
     4409       if p-action = true
     4410       then do:
     4411         run diasize_change-height in this-procedure
     4412           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     4413               - frame Dialog-Frame :height-chars
     4414           ,input true
     4415           ) .
     4416         run diasize_change-width in this-procedure
     4417           (input session :width-chars
     4418               - frame Dialog-Frame :width-chars
     4419           ,input true
     4420           ) .
     4421         assign
     4422           v-diasize-need-maximize = false
     4423         .
     4424       end.
     4425       else do:
     4426         run diasize_change-width in this-procedure
     4427           (input v-diasize-orig-frame-width
     4428               - frame Dialog-Frame :width-chars
     4429           ,input true
     4430           ) .
     4431         run diasize_change-height in this-procedure
     4432           (input v-diasize-orig-frame-height
     4433               - frame Dialog-Frame :height-chars
     4434           ,input true
     4435           ) .
     4436         assign
     4437           v-diasize-need-maximize = true
     4438         .
     4439       end.
     4440     end.
     4441   end procedure.
     4442   procedure diasize_restore-orig-size :
     4443     do
     4444     on error undo, return error return-value
     4445     :
     4446       assign
     4447         v-diasize-current-frame-width  = frame Dialog-Frame :width
     4448         v-diasize-current-frame-height = frame Dialog-Frame :height
     4449       .
     4450       run diasize_set-height in this-procedure
     4451         (input  v-diasize-orig-frame-height
     4452         ,input  true
     4453         ) .
     4454       run diasize_set-width in this-procedure
     4455         (input  v-diasize-orig-frame-width
     4456         ,input  true
     4457         ) .
     4458     end.
     4459   end procedure.
     4460   procedure diasize_restore-current-size :
     4461     do
     4462     on error undo, return error return-value
     4463     :
     4464       run diasize_set-height in this-procedure
     4465         (input  v-diasize-current-frame-height
     4466         ,input  true
     4467         ) .
     4468       run diasize_set-width in this-procedure
     4469         (input  v-diasize-current-frame-width
     4470         ,input  true
     4471         ) .
     4472     end.
     4473   end procedure.
     4474   procedure diasize_set-browse-handle :
     4475     define input  parameter p-browse-handle as handle   no-undo .
     4476     define buffer buf_temp-browse-handle for temp-browse-handle .
     4477     do
     4478     on error undo, return error return-value
     4479     :
     4480       assign
     4481         v-diasize-browse-handle = p-browse-handle
     4482       .
     4483       for each buf_temp-browse-handle
     4484       on error undo, return error return-value
     4485       :
     4486         delete buf_temp-browse-handle .
     4487       end.
     4488     end.
     4489   end procedure.
     4490   procedure diasize_add_browse :
     4491     define input  parameter p-browse-type   as character no-undo .
     4492     define input  parameter p-browse-handle as handle    no-undo .
     4493     define buffer buf_temp-browse-handle for temp-browse-handle .
     4494     do
     4495     on error undo, return error return-value
     4496     :
     4497       assign
     4498         v-diasize-browse-number = v-diasize-browse-number + 1
     4499       .
     4500       create buf_temp-browse-handle .
     4501       assign
     4502         buf_temp-browse-handle.browse-type   = p-browse-type
     4503         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     4504         buf_temp-browse-handle.browse-handle = p-browse-handle
     4505       .
     4506     end.
     4507   end procedure.
     4508   procedure diasize_init :
     4509     define variable v-default-value    as logical   no-undo .
     4510     define variable v-restore-saved    as logical   no-undo .
     4511     define variable v-resize-value-str as character no-undo .
     4512     do
     4513     on error undo, return error return-value
     4514     :
     4515       do with frame Dialog-Frame
     4516       :
     4517         assign
     4518           v-diasize-orig-frame-height = frame Dialog-Frame :height
     4519           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     4520           v-diasize-browse-handle     = browse BR-scales :handle
     4521         .
     4522         create button v-diasize-resize-button
     4523         assign
     4524           parent        = frame Dialog-Frame :first-child
     4525           label         = "s"
     4526           height-pixels = 16
     4527           width-pixels  = 16
     4528           visible       = true
     4529           sensitive     = true
     4530           movable       = true
     4531           triggers:
     4532             on end-move persistent run diasize_end-move in this-procedure .
     4533           end triggers.
     4534         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     4535         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     4536         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     4537         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     4538         assign
     4539           v-diasize-wndmax = false
     4540         .
     4541         if connected("ub") = true
     4542         then do:
     4543           define variable v-cntxt-db-num        as integer   no-undo .
     4544           define variable v-cntxt-userid        as character no-undo .
     4545           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     4546                                             , OUTPUT v-cntxt-userid
     4547                                             ) .
     4548           run gbl/wndpar_r.p
     4549             (input  v-cntxt-db-num
     4550             ,input  v-cntxt-userid
     4551             ,input  'wndmax':U
     4552             ,output v-diasize-wndmax
     4553             ,output v-default-value
     4554             ) .
     4555         end.
     4556         assign
     4557           v-diasize-wndstore = false
     4558         .
     4559         if connected("ub") = true
     4560         then do:
     4561           run gbl/wndpar_r.p
     4562             (input  v-cntxt-db-num
     4563             ,input  v-cntxt-userid
     4564             ,input  'wndstore':U
     4565             ,output v-diasize-wndstore
     4566             ,output v-default-value
     4567             ) .
     4568         end.
     4569         assign
     4570           v-diasize-proc-name = entry(1, program-name(2), '.')
     4571         .
     4572         if v-diasize-wndstore = true
     4573         then do:
     4574           assign
     4575             v-restore-saved = false
     4576           .
     4577           if connected("ub") = true
     4578           then do:
     4579             run gbl/wndsizer.p
     4580               (input  v-cntxt-db-num
     4581               ,input  v-cntxt-userid
     4582               ,input  v-diasize-proc-name
     4583               ,input  'height':u
     4584               ,output v-resize-value-str
     4585               ) .
     4586             if v-resize-value-str <> '':U
     4587             then do:
     4588               run diasize_change-height in this-procedure
     4589                 (input  integer(v-resize-value-str)
     4590                 ,input  true
     4591                 ) .
     4592               assign
     4593                 v-restore-saved = true
     4594               .
     4595             end.
     4596           end.
     4597           if connected("ub") = true
     4598           then do:
     4599             run gbl/wndsizer.p
     4600               (input  v-cntxt-db-num
     4601               ,input  v-cntxt-userid
     4602               ,input  v-diasize-proc-name
     4603               ,input  'width':u
     4604               ,output v-resize-value-str
     4605               ) .
     4606             if v-resize-value-str <> '':U
     4607             then do:
     4608               run diasize_change-width in this-procedure
     4609                 (input  integer(v-resize-value-str)
     4610                 ,input  true
     4611                 ) .
     4612               assign
     4613                 v-restore-saved = true
     4614               .
     4615             end.
     4616           end.
     4617           if v-restore-saved <> true
     4618           then do:
     4619             if v-diasize-wndmax = true
     4620             then do:
     4621               run diasize_maximize in this-procedure
     4622                 (input  true
     4623                 ) .
     4624             end.
     4625           end.
     4626         end.
     4627         else do:
     4628           if v-diasize-wndmax = true
     4629           then do:
     4630             run diasize_maximize in this-procedure
     4631               (input  true
     4632               ) .
     4633           end.
     4634         end.
     4635       end.
     4636     end.
     4637   end procedure.
     4638   procedure diasize_need-full-display :
     4639     define output parameter p-need-full-display as logical   no-undo .
     4640     do
     4641     on error undo, return error return-value
     4642     :
     4643       assign
     4644         p-need-full-display = v-diasize-need-full-display
     4645       .
     4646       assign
     4647         v-diasize-need-full-display = false
     4648       .
     4649     end.
     4650   end procedure.
     4651   procedure get-context :
     4652      define output parameter p-db-num as integer          no-undo.
     4653      define output parameter p-user-id as character        no-undo.
     4654      define variable v-login               as character    no-undo.
     4655      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     4656      define buffer buf_user-login  for ub.user-login .
     4657      do
     4658      on error undo, return error
     4659      :
     4660            FIND FIRST buf_sys-ctrl no-lock.
     4661            ASSIGN
     4662               v-login = USERID("ub")
     4663               p-db-num = buf_sys-ctrl.db-num
     4664            .
     4665            FIND FIRST buf_user-login
     4666                 WHERE buf_user-login.db-num = p-db-num
     4667                   AND buf_user-login.user-login = v-login
     4668                 no-lock
     4669                 no-error
     4670                 .
     4671            IF AVAILABLE buf_user-login
     4672            THEN DO:
     4673               assign
     4674                  p-user-id = buf_user-login.user-id
     4675               .
     4676            END.
     4677      end.
     4678   end procedure.
     4679       run diasize_init in this-procedure .
     4680   define variable vss-include-info63 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4681   on INS of frame Dialog-Frame anywhere do:
