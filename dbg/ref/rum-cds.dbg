      371   procedure thbjattr_code_reg :
      372   define input  parameter p-upper-code     as character no-undo .
      373   define input  parameter p-code           as character no-undo .
      374   define output parameter p-label          as character no-undo .
      375   define output parameter p-user-can-edit  as logical   no-undo .
      376   define output parameter p-output-display as logical   no-undo .
      377   define output parameter p-other          as character no-undo .
      378   define output parameter p-prop-list      as character no-undo .
      379   define output parameter p-prop-type-list as character no-undo .
      380   define output parameter p-prop-label-list as character no-undo .
      381   define output parameter p-global          as logical no-undo .
      382   define output parameter p-host           as logical no-undo .
      383   define output parameter p-shop           as logical no-undo .
      384   define output parameter p-store          as logical no-undo .
      385   define output parameter p-db             as logical no-undo .
      386   define output parameter p-region         as logical no-undo .
      387   do
      388   on error undo, return error return-value
      389   :
      390       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
      391       (input  p-upper-code
      392       ,input  p-code
      393       ,output p-label
      394       ,output p-user-can-edit
      395       ,output p-output-display
      396       ,output p-other
      397       ,output p-prop-list
      398       ,output p-prop-type-list
      399       ,output p-prop-label-list
      400       ,output p-global
      401       ,output p-host
      402       ,output p-shop
      403       ,output p-store
      404       ,output p-db
      405       ,output p-region
      406       ) no-error .
      407     if error-status :error
      408     then do:
      409       undo, return error substitute( "&1. &2&3&4", vss-include-info1, return-value, chr(10), error-status :get-message (1)).
