     2874         :
     2875           assign
     2876             buf_temp-browse-handle.browse-handle :width
     2877               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2878             no-error .
     2879           if error-status :error
     2880           or error-status :get-message(1) <> ""
     2881           then do:
     2882             undo move_block, retry move_block .
     2883           end.
     2884         end.
     2885         for each buf_temp-diasize-handle
     2886         on error undo move_block, retry move_block
     2887         :
     2888           assign
     2889             v-object-handle = buf_temp-diasize-handle.handle-value
     2890           .
     2891           if v-object-handle <> v-diasize-resize-button
     2892           then do:
     2893             assign
     2894               v-object-handle :col = v-object-handle :col + p-change-value
     2895               no-error .
     2896             if error-status :error
     2897             or error-status :get-message(1) <> ""
     2898             then do:
     2899               undo move_block, retry move_block .
     2900             end.
     2901           end.
     2902         end.
     2903       end.
     2904       else do:
     2905         for each buf_temp-diasize-handle
     2906         on error undo move_block, retry move_block
     2907         :
     2908           assign
     2909             v-object-handle = buf_temp-diasize-handle.handle-value
     2910           .
     2911           if v-object-handle <> v-diasize-resize-button
     2912           then do:
     2913             assign
     2914               v-object-handle :col = v-object-handle :col + p-change-value
     2915               no-error .
     2916             if error-status :error
     2917             or error-status :get-message(1) <> ""
     2918             then do:
     2919               undo move_block, retry move_block .
     2920             end.
     2921           end.
     2922         end.
     2923         for each buf_temp-browse-handle
     2924           where buf_temp-browse-handle.browse-type = 'width':u
     2925         on error undo move_block, retry move_block
     2926         :
     2927           assign
     2928             buf_temp-browse-handle.browse-handle :width
     2929               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2930             no-error .
     2931           if error-status :error
     2932           or error-status :get-message(1) <> ""
     2933           then do:
     2934             undo move_block, retry move_block .
     2935           end.
     2936         end.
     2937         assign
     2938           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2939           no-error .
     2940         if error-status :error
     2941         or error-status :get-message(1) <> ""
     2942         then do:
     2943           undo move_block, retry move_block.
     2944         end.
     2945         assign
     2946           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2947         no-error .
     2948         if error-status :error
     2949         or error-status :get-message(1) <> ""
     2950         then do:
     2951           undo move_block, retry move_block.
     2952         end.
     2953         if frame Dialog-Frame :scrollable = true
     2954         then do:
     2955           assign
     2956             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2957           no-error .
     2958           if error-status :error
     2959           or error-status :get-message(1) <> ""
     2960           then do:
     2961             undo move_block, retry move_block.
     2962           end.
     2963         end.
     2964       end.
     2965       if p-move-resize
     2966       then do:
     2967         run diasize_position-resize-button in this-procedure .
     2968       end.
     2969       if v-diasize-wndstore = true
     2970       then do:
     2971         if connected("ub") = true
     2972         then do:
     2973           define variable v-cntxt-db-num        as integer   no-undo .
     2974           define variable v-cntxt-userid        as character no-undo .
     2975           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2976                                             , OUTPUT v-cntxt-userid
     2977                                             ) .
     2978           run gbl/wndsizew.p
     2979             (input  v-cntxt-db-num
     2980             ,input  v-cntxt-userid
     2981             ,input  v-diasize-proc-name
     2982             ,input  'width':u
     2983             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2984             ) .
     2985         end.
     2986       end.
     2987     end.
     2988     assign
     2989       v-diasize-change-size = false
     2990     .
     2991   end procedure.
     2992   procedure diasize_set-width :
     2993     define input  parameter p-new-width  as decimal   no-undo .
     2994     define input  parameter p-move-resize as logical   no-undo .
     2995     do
     2996     on error undo, return error return-value
     2997     :
     2998       run diasize_change-width in this-procedure
     2999         (input  (p-new-width - frame Dialog-Frame :width)
     3000         ,input  p-move-resize
     3001         ) .
     3002     end.
     3003   end procedure.
     3004   procedure diasize_position-resize-button :
     3005     do with frame Dialog-Frame
     3006     :
     3007       hide v-diasize-resize-button .
     3008       assign
     3009         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     3010                     - 1
     3011                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     3012         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     3013                     - 1
     3014                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     3015       .
     3016       view v-diasize-resize-button .
     3017     end.
     3018   end procedure.
     3019   on alt-right anywhere
     3020   do:
     3021     run diasize_change-width in this-procedure
     3022       (input 1
     3023       ,input true
     3024       ) .
     3025     return no-apply .
     3026   end.
     3027   on alt-left anywhere
     3028   do:
     3029     run diasize_change-width in this-procedure
     3030       (input -1
     3031       ,input true
     3032       ) .
     3033     return no-apply .
     3034   end.
     3035   on alt-down anywhere
     3036   do:
     3037     run diasize_change-height in this-procedure
     3038       (input 1
     3039       ,input true
     3040       ) .
     3041     return no-apply .
     3042   end.
     3043   on alt-up anywhere
     3044   do:
     3045     run diasize_change-height in this-procedure
     3046       (input -1
     3047       ,input true
     3048       ) .
     3049     return no-apply .
     3050   end.
     3051   on alt-enter of frame Dialog-Frame
     3052   do:
     3053     run diasize_maximize in this-procedure
     3054       (input  ?
     3055       ).
     3056     return no-apply .
     3057   end.
     3058   procedure diasize_end-move :
     3059     do
     3060     on error undo, return error return-value
     3061     :
     3062       define variable v-row-delta as decimal   no-undo .
     3063       define variable v-col-delta as decimal   no-undo .
     3064       define variable v-new-row as decimal   no-undo .
     3065       define variable v-new-col as decimal   no-undo .
     3066       assign
     3067         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3068         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3069       .
     3070       assign
     3071         v-row-delta = v-new-row - frame Dialog-Frame :height
     3072         v-col-delta = v-new-col - frame Dialog-Frame :width
     3073       .
     3074       run diasize_change-height in this-procedure
     3075         (input v-row-delta
     3076         ,input true
     3077         ) .
     3078       run diasize_change-width in this-procedure
     3079         (input v-col-delta
     3080         ,input true
     3081         ) .
     3082     end.
     3083   end procedure.
     3084   procedure diasize_maximize :
     3085     define input  parameter p-action as logical   no-undo .
     3086     do
     3087     on error undo, return error return-value
     3088     :
     3089       if p-action = ?
     3090       then do:
     3091         if v-diasize-need-maximize = true
     3092         then do:
     3093           assign
     3094             p-action = true
     3095           .
     3096         end.
     3097         else do:
     3098           assign
     3099             p-action = false
     3100           .
     3101         end.
     3102       end.
     3103       if p-action = true
     3104       then do:
     3105         run diasize_change-height in this-procedure
     3106           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3107               - frame Dialog-Frame :height-chars
     3108           ,input true
     3109           ) .
     3110         run diasize_change-width in this-procedure
     3111           (input session :width-chars
     3112               - frame Dialog-Frame :width-chars
     3113           ,input true
     3114           ) .
     3115         assign
     3116           v-diasize-need-maximize = false
     3117         .
     3118       end.
     3119       else do:
     3120         run diasize_change-width in this-procedure
     3121           (input v-diasize-orig-frame-width
     3122               - frame Dialog-Frame :width-chars
     3123           ,input true
     3124           ) .
     3125         run diasize_change-height in this-procedure
     3126           (input v-diasize-orig-frame-height
     3127               - frame Dialog-Frame :height-chars
     3128           ,input true
     3129           ) .
     3130         assign
     3131           v-diasize-need-maximize = true
     3132         .
     3133       end.
     3134     end.
     3135   end procedure.
     3136   procedure diasize_restore-orig-size :
     3137     do
     3138     on error undo, return error return-value
     3139     :
     3140       assign
     3141         v-diasize-current-frame-width  = frame Dialog-Frame :width
     3142         v-diasize-current-frame-height = frame Dialog-Frame :height
     3143       .
     3144       run diasize_set-height in this-procedure
     3145         (input  v-diasize-orig-frame-height
     3146         ,input  true
     3147         ) .
     3148       run diasize_set-width in this-procedure
     3149         (input  v-diasize-orig-frame-width
     3150         ,input  true
     3151         ) .
     3152     end.
     3153   end procedure.
     3154   procedure diasize_restore-current-size :
     3155     do
     3156     on error undo, return error return-value
     3157     :
     3158       run diasize_set-height in this-procedure
     3159         (input  v-diasize-current-frame-height
     3160         ,input  true
     3161         ) .
     3162       run diasize_set-width in this-procedure
     3163         (input  v-diasize-current-frame-width
     3164         ,input  true
     3165         ) .
     3166     end.
     3167   end procedure.
     3168   procedure diasize_set-browse-handle :
     3169     define input  parameter p-browse-handle as handle   no-undo .
     3170     define buffer buf_temp-browse-handle for temp-browse-handle .
     3171     do
     3172     on error undo, return error return-value
     3173     :
     3174       assign
     3175         v-diasize-browse-handle = p-browse-handle
     3176       .
     3177       for each buf_temp-browse-handle
     3178       on error undo, return error return-value
     3179       :
     3180         delete buf_temp-browse-handle .
     3181       end.
     3182     end.
     3183   end procedure.
     3184   procedure diasize_add_browse :
     3185     define input  parameter p-browse-type   as character no-undo .
     3186     define input  parameter p-browse-handle as handle    no-undo .
     3187     define buffer buf_temp-browse-handle for temp-browse-handle .
     3188     do
     3189     on error undo, return error return-value
     3190     :
     3191       assign
     3192         v-diasize-browse-number = v-diasize-browse-number + 1
     3193       .
     3194       create buf_temp-browse-handle .
     3195       assign
     3196         buf_temp-browse-handle.browse-type   = p-browse-type
     3197         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3198         buf_temp-browse-handle.browse-handle = p-browse-handle
     3199       .
     3200     end.
     3201   end procedure.
     3202   procedure diasize_init :
     3203     define variable v-default-value    as logical   no-undo .
     3204     define variable v-restore-saved    as logical   no-undo .
     3205     define variable v-resize-value-str as character no-undo .
     3206     do
     3207     on error undo, return error return-value
     3208     :
     3209       do with frame Dialog-Frame
     3210       :
     3211         assign
     3212           v-diasize-orig-frame-height = frame Dialog-Frame :height
     3213           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     3214           v-diasize-browse-handle     = browse br-profile :handle
     3215         .
     3216         create button v-diasize-resize-button
     3217         assign
     3218           parent        = frame Dialog-Frame :first-child
     3219           label         = "s"
     3220           height-pixels = 16
     3221           width-pixels  = 16
     3222           visible       = true
     3223           sensitive     = true
     3224           movable       = true
     3225           triggers:
     3226             on end-move persistent run diasize_end-move in this-procedure .
     3227           end triggers.
     3228         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3229         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3230         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3231         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3232         assign
     3233           v-diasize-wndmax = false
     3234         .
     3235         if connected("ub") = true
     3236         then do:
     3237           define variable v-cntxt-db-num        as integer   no-undo .
     3238           define variable v-cntxt-userid        as character no-undo .
     3239           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3240                                             , OUTPUT v-cntxt-userid
     3241                                             ) .
     3242           run gbl/wndpar_r.p
     3243             (input  v-cntxt-db-num
     3244             ,input  v-cntxt-userid
     3245             ,input  'wndmax':U
     3246             ,output v-diasize-wndmax
     3247             ,output v-default-value
     3248             ) .
     3249         end.
     3250         assign
     3251           v-diasize-wndstore = false
     3252         .
     3253         if connected("ub") = true
     3254         then do:
     3255           run gbl/wndpar_r.p
     3256             (input  v-cntxt-db-num
     3257             ,input  v-cntxt-userid
     3258             ,input  'wndstore':U
     3259             ,output v-diasize-wndstore
     3260             ,output v-default-value
     3261             ) .
     3262         end.
     3263         assign
     3264           v-diasize-proc-name = entry(1, program-name(2), '.')
     3265         .
     3266         if v-diasize-wndstore = true
     3267         then do:
     3268           assign
     3269             v-restore-saved = false
     3270           .
     3271           if connected("ub") = true
     3272           then do:
     3273             run gbl/wndsizer.p
     3274               (input  v-cntxt-db-num
     3275               ,input  v-cntxt-userid
     3276               ,input  v-diasize-proc-name
     3277               ,input  'height':u
     3278               ,output v-resize-value-str
     3279               ) .
     3280             if v-resize-value-str <> '':U
     3281             then do:
     3282               run diasize_change-height in this-procedure
     3283                 (input  integer(v-resize-value-str)
     3284                 ,input  true
     3285                 ) .
     3286               assign
     3287                 v-restore-saved = true
     3288               .
     3289             end.
     3290           end.
     3291           if connected("ub") = true
     3292           then do:
     3293             run gbl/wndsizer.p
     3294               (input  v-cntxt-db-num
     3295               ,input  v-cntxt-userid
     3296               ,input  v-diasize-proc-name
     3297               ,input  'width':u
     3298               ,output v-resize-value-str
     3299               ) .
     3300             if v-resize-value-str <> '':U
     3301             then do:
     3302               run diasize_change-width in this-procedure
     3303                 (input  integer(v-resize-value-str)
     3304                 ,input  true
     3305                 ) .
     3306               assign
     3307                 v-restore-saved = true
     3308               .
     3309             end.
     3310           end.
     3311           if v-restore-saved <> true
     3312           then do:
     3313             if v-diasize-wndmax = true
     3314             then do:
     3315               run diasize_maximize in this-procedure
     3316                 (input  true
     3317                 ) .
     3318             end.
     3319           end.
     3320         end.
     3321         else do:
     3322           if v-diasize-wndmax = true
     3323           then do:
     3324             run diasize_maximize in this-procedure
     3325               (input  true
     3326               ) .
     3327           end.
     3328         end.
     3329       end.
     3330     end.
     3331   end procedure.
     3332   procedure diasize_need-full-display :
     3333     define output parameter p-need-full-display as logical   no-undo .
     3334     do
     3335     on error undo, return error return-value
     3336     :
     3337       assign
     3338         p-need-full-display = v-diasize-need-full-display
     3339       .
     3340       assign
     3341         v-diasize-need-full-display = false
     3342       .
     3343     end.
     3344   end procedure.
     3345   procedure get-context :
     3346      define output parameter p-db-num as integer          no-undo.
     3347      define output parameter p-user-id as character        no-undo.
     3348      define variable v-login               as character    no-undo.
     3349      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3350      define buffer buf_user-login  for ub.user-login .
     3351      do
     3352      on error undo, return error
     3353      :
     3354            FIND FIRST buf_sys-ctrl no-lock.
     3355            ASSIGN
     3356               v-login = USERID("ub")
     3357               p-db-num = buf_sys-ctrl.db-num
     3358            .
     3359            FIND FIRST buf_user-login
     3360                 WHERE buf_user-login.db-num = p-db-num
     3361                   AND buf_user-login.user-login = v-login
     3362                 no-lock
     3363                 no-error
     3364                 .
     3365            IF AVAILABLE buf_user-login
     3366            THEN DO:
     3367               assign
     3368                  p-user-id = buf_user-login.user-id
     3369               .
     3370            END.
     3371      end.
     3372   end procedure.
     3373       run diasize_init in this-procedure .
     3374   MAIN-BLOCK:
     3375   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3376      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3377   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3378     run mainmenu_getcntxt in parparentproc
     3379       (output v-cntxt-db-num
     3380       ,output v-cntxt-userid
     3381       ,output v-cntxt-level
     3382       ,output v-cntxt-host-code-obj
     3383       ,output v-cntxt-obj-type
     3384       ,output v-cntxt-obj-code
     3385       ,output v-cntxt-db-num-obj
     3386       ,output v-cntxt-is-admin
     3387       ) .
     3388   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3389   ON TAB ANYWHERE
     3390   DO:
     3391   define variable ii as integer no-undo .
     3392   define variable fh as widget-handle no-undo .
     3393   define variable hh as widget-handle no-undo .
     3394   define variable v-next-widget-name as character no-undo .
     3395   if v-tab-order <> '' then do:
     3396     if self:type = "TOGGLE-BOX" then
     3397     self:BGCOLOR = ?.
     3398     assign
     3399     ii = lookup(self:name, v-tab-order).
     3400     assign
     3401     ii = ii + 1
     3402     v-next-widget-name = entry(ii, v-tab-order)
     3403     no-error .
     3404     if error-status:error then do:
     3405       assign
     3406       ii = 1
     3407       v-next-widget-name = entry( ii, v-tab-order)
     3408       .
     3409     end.
     3410     assign
     3411     fh = frame Dialog-Frame:first-child
     3412     hh = fh:first-child
     3413     .
     3414     do while valid-handle(hh):
     3415       if hh:name = v-next-widget-name then do:
     3416         if hh:sensitive  = yes
     3417         AND hh:visible = yes then do:
     3418           if hh:type = "TOGGLE-BOX":U then do:
     3419             assign
     3420             hh:BGcolor = 1
     3421             .
     3422           end.
     3423           APPLY "ENTRY" to hh.
     3424           return no-apply.
     3425         end.
     3426         else do:
     3427           APPLY "TAB" to hh.
     3428           return no-apply.
     3429         end.
     3430       end.
     3431       hh = hh:next-sibling.
     3432     end.
     3433   end.
     3434   END.
     3435   ON BACK-TAB ANYWHERE
     3436   DO:
     3437   define variable ii as integer no-undo .
     3438   define variable fh as widget-handle no-undo .
     3439   define variable hh as widget-handle no-undo .
     3440   define variable v-next-widget-name as character no-undo .
     3441   if v-tab-order <> '' then do:
     3442     assign
     3443     ii = lookup(self:name, v-tab-order).
     3444     .
     3445     assign
     3446     ii = (if ii = 1
     3447           then  num-entries(v-tab-order)
     3448           else ii - 1
     3449           )
     3450     v-next-widget-name = entry(ii, v-tab-order)
     3451     .
     3452     assign
     3453     fh = frame Dialog-Frame:first-child
     3454     hh = fh:first-child
     3455     .
     3456     do while valid-handle(hh):
     3457       if hh:name = v-next-widget-name then do:
     3458         if hh:sensitive  = yes
     3459         AND hh:visible = yes then do:
     3460           if hh:type = "TOGGLE-BOX":U then do:
     3461             assign
     3462             hh:BGcolor = 1
     3463             .
     3464           end.
     3465           APPLY "ENTRY" to hh.
     3466           return no-apply.
     3467         end.
     3468         else do:
     3469         APPLY "BACK-TAB" to hh.
     3470         return no-apply.
     3471         end.
     3472       end.
     3473       hh = hh:next-sibling.
     3474     end.
     3475     end.
     3476   END.
     3477     IF p-mode <> 'ПРОСМОТР':U
     3478     and p-mode <> 'ИЗМЕНЕНИЕ':U THEN DO:
     3479         MESSAGE
     3480         vss-workfile vss-revision vss-description skip
     3481         "Неверное значение параметра p-mode" p-mode
     3482         VIEW-AS ALERT-BOX ERROR.
     3483         UNDO, RETURN ERROR.
     3484     END.
     3485     IF p-list-mode <> 'все':U
     3486     and p-list-mode <> 'объект':U
     3487     AND p-list-mode <> 'БД':U THEN DO:
     3488         MESSAGE
     3489         vss-workfile vss-revision vss-description skip
     3490         "Неверное значение параметра p-list-mode" p-list-mode
     3491         VIEW-AS ALERT-BOX ERROR.
     3492         UNDO, RETURN ERROR.
     3493     END.
     3494     if p-mode <> 'ПРОСМОТР':U
     3495     and v-cntxt-db-num > 0
     3496     and (p-obj-type = '' and p-obj-code = 0)
     3497     then do:
     3498       message
     3499       "Нельзя изменять настройки в УБД"
     3500       view-as alert-box error .
     3501       undo, return error .
     3502     end.
     3503     IF p-obj-type <> 'маг':U
     3504     and p-obj-type <> 'орг':U
     3505     and p-obj-type <> '':U
     3506     THEN DO:
     3507         MESSAGE
     3508         vss-workfile vss-revision vss-description skip
     3509         "Неверное значение параметра p-obj-type" p-obj-type
     3510         VIEW-AS ALERT-BOX ERROR.
     3511         UNDO, RETURN ERROR.
     3512     END.
     3513     if p-obj-type = 'маг':U
     3514     or p-obj-type = 'скл':U
     3515     then do:
     3516       FIND FIRST Xobj_clients NO-LOCK WHERE
     3517                Xobj_clients.obj-code = p-obj-code
     3518            and Xobj_clients.obj-type = p-obj-type
     3519                NO-ERROR.
     3520       IF NOT AVAILABLE Xobj_clients THEN DO:
     3521           MESSAGE
     3522           vss-workfile vss-revision vss-description skip
     3523           "Неверное значение параметра p-obj-code/p-obj-type" p-obj-code p-obj-type
     3524           VIEW-AS ALERT-BOX ERROR.
     3525           UNDO, RETURN ERROR.
     3526       END.
     3527   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3528   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     3529     (input  Xobj_clients.obj-type
     3530     ,input  Xobj_clients.obj-code
     3531     ,output v-db-num
     3532     )  .
     3533       IF v-db-num <> v-cntxt-db-num
     3534       AND v-cntxt-db-num <> 0
     3535       and p-mode <> 'ПРОСМОТР':U
     3536       THEN DO:
     3537           MESSAGE
     3538           "Нельзя менять параметры магазина в чужой БД" skip
     3539           "магазин принадлежит БД" v-db-num "текущая БД" v-cntxt-db-num
     3540           VIEW-AS ALERT-BOX ERROR.
     3541           UNDO, RETURN ERROR.
     3542       END.
     3543   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3544   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3545     (input  p-obj-type
     3546     ,input  p-obj-code
     3547     ,output v-host-code
     3548     )  .
     3549       v-current-upper-prop-code = p-obj-upper-code.
     3550     end.
     3551     if p-obj-type = 'орг':U then do:
     3552       FIND FIRST X_sysconf NO-LOCK WHERE X_sysconf.host-code = p-obj-code NO-ERROR.
     3553       IF NOT AVAILABLE X_sysconf THEN DO:
     3554           MESSAGE
     3555           vss-workfile vss-revision vss-description skip
     3556           "Неверное значение параметра p-obj-code" p-obj-code
     3557           VIEW-AS ALERT-BOX ERROR.
     3558           UNDO, RETURN ERROR.
     3559       END.
     3560       if v-cntxt-db-num <> 0
     3561       and p-mode <> 'ПРОСМОТР':U
     3562       then do:
     3563           MESSAGE
     3564           "Нельзя менять параметры ФИРМЫ в УБД" skip
     3565           VIEW-AS ALERT-BOX ERROR.
     3566           UNDO, RETURN ERROR.
     3567       end.
     3568       v-host-code = p-obj-code.
     3569     end.
     3570     if p-obj-type = '':U then do:
     3571       if v-cntxt-db-num <> 0
     3572       and p-mode <> 'ПРОСМОТР':U
     3573       then do:
     3574           MESSAGE
     3575           "Нельзя менять ГЛОБАЛЬНЫЕ параметры в УБД" skip
     3576           VIEW-AS ALERT-BOX ERROR.
     3577           UNDO, RETURN ERROR.
     3578       end.
     3579       v-current-upper-prop-code = p-upper-code.
     3580     end.
     3581     IF p-mode = 'ИЗМЕНЕНИЕ':U THEN DO:
     3582       do transaction:
     3583         FIND FIRST LOCKED_thbj-attr EXCLUSIVE-LOCK WHERE
     3584                   LOCKED_thbj-attr.obj-type = p-obj-type
     3585             AND   LOCKED_thbj-attr.obj-code = p-obj-code
     3586             AND   LOCKED_thbj-attr.upper-prop-code = v-current-upper-prop-code
     3587             AND   locked_thbj-attr.prop-code = '':U NO-ERROR.
     3588         if locked locked_thbj-attr then do:
     3589             message
     3590             vss-workfile vss-revision vss-description skip
     3591             "Запись ПАРАМЕТРЫ(АТРИБУТЫ) МАГАЗИНА занята"
     3592             view-as alert-box error .
     3593             undo, return error.
     3594           end.
     3595        end.
     3596     END.
     3597     ELSE DO:
     3598         FIND FIRST LOCKED_thbj-attr no-LOCK WHERE
     3599             LOCKED_thbj-attr.obj-type = p-obj-type
     3600       AND   LOCKED_thbj-attr.obj-code = p-obj-code
     3601       AND   LOCKED_thbj-attr.upper-prop-code = v-current-upper-prop-code
     3602       AND   locked_thbj-attr.prop-code = '':U NO-ERROR.
     3603     END.
     3604     if not available locked_thbj-attr then do:
     3605       ASSIGN
     3606       v-to-create  = YES.
     3607       message
     3608       substitute ("Внимание!!!&1Параметра НЕТ в БД!&1Будут показаны ЗНАЧЕНИЯ ПО УМОЛЧАНИЮ",
     3609                   chr(10))
     3610       view-as alert-box WARNING.
     3611     end.
     3612   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3613     RUN Myenable in this-procedure .
     3614     WAIT-FOR GO OF FRAME Dialog-Frame.
     3615   END.
     3616   RUN disable_UI.
     3617   run attr-pop-clean-up in this-procedure ( input 'thbj-attr':U ).
     3618   PROCEDURE choose-to-edit :
     3619   define input parameter p-upper-code as character no-undo .
     3620   define input parameter p-attr-code as character no-undo .
     3621   assign
     3622   prop-option = p-attr-code
     3623   .
     3624   APPLY "CHOOSE" to b-add in frame Dialog-Frame .
     3625   END PROCEDURE.
     3626   PROCEDURE disable_UI :
     3627     HIDE FRAME Dialog-Frame.
     3628   END PROCEDURE.
     3629   PROCEDURE enable_UI :
     3630     DISPLAY rs-active Rs-algo-profile rs-algo-types E-rule-name
     3631         WITH FRAME Dialog-Frame.
     3632     ENABLE b-quit b-add rs-active b-ruleproc B-Help BR-thbj-attr Rs-algo-profile
     3633            rs-algo-types b-rule b-params B-ruleset br-rule-by-call br-profile
     3634            E-rule-name
     3635         WITH FRAME Dialog-Frame.
     3636     VIEW FRAME Dialog-Frame.
     3637     OPEN QUERY br-profile FOR EACH X_rp-by-call WHERE          X_rp-by-call.call_id = v-uniq-key-rec NO-LOCK INDEXED-REPOSITION.    OPEN QUERY br-rule-by-call FOR EACH X_rule-by-call       WHERE X_rule-by-call.call_id = v-uniq-key-rec,            FIRST X_rule-profile NO-LOCK WHERE          X_rule-profile.profile_id = X_rule-by-call.profile_id      AND (rs-algo-types = 1 OR          X_rule-profile.is_dynamic = yes) BY X_rule-by-call.codex_id BY X_rule-by-call.ruleset_id BY X_rule-by-call.order_id INDEXED-REPOSITION.    OPEN QUERY BR-thbj-attr FOR EACH buf_thbj-attr WHERE     buf_thbj-attr.obj-type = p-obj-type AND buf_thbj-attr.obj-code = p-obj-code,        FIRST X_clients NO-LOCK                                                     .
     3638   END PROCEDURE.
     3639   PROCEDURE MyEnable :
     3640   DEFINE VARIABLE clh AS WIDGET-HANDLE NO-UNDO.
     3641   DEFINE VARIABLE ii AS integer NO-UNDO.
     3642   define variable v-entry as character no-undo .
     3643   define variable v-label as character no-undo .
     3644   define variable v-tooltip as character no-undo .
     3645   define variable v-tooltip-code as character no-undo .
     3646   ASSIGN
     3647      b-add:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-add:HANDLE.
     3648   do ii = 1 to num-entries(p-prop-list-global):
     3649     v-entry = entry(ii, p-prop-list-global).
     3650     run thbjattr_tooltip in this-procedure ( input  p-upper-code
     3651                                             ,input  v-entry
     3652                                             ,output v-tooltip
     3653                                             ,output v-label
     3654                                             ,output v-tooltip-code  ) .
     3655     assign
     3656     frame Dialog-Frame:title = substitute("&1 &2", frame Dialog-Frame:title, v-tooltip-code).
     3657   end.
     3658   run attr-pop-create-items in this-procedure  (
     3659                                                 input 'thbj-attr':U
     3660                                                 ,input 'thbjattr_manual-edit'
     3661                                                 ,input 'thbjattr_tooltip'
     3662                                                 ,input 'choose-to-edit'
     3663                                                 ,input menu menu-b-add:handle
     3664                                                 ,input p-upper-code
     3665                                                 ,input p-prop-list-global
     3666                                               ).
     3667   DO ii = 1 TO br-profile:NUM-COLUMNS IN FRAME Dialog-Frame:
     3668       clh = BROWSE br-profile:get-browse-column(ii).
     3669       IF clh:LABEL BEGINS "Название" THEN DO:
     3670         ASSIGN
     3671         clh:RESIZABLE = YES
     3672         clh:width = 72
     3673         .
     3674       END.
     3675   END.
     3676   ASSIGN
     3677   rs-algo-profile:RADIO-BUTTONS = "Алгоритмы" + chr(44) +
     3678                                    'rp-by-call':U + chr(44) +
     3679                                   "Правила" + chr(44) + 'rule-by-call':U
     3680   rs-algo-profile = 'rp-by-call':U
     3681   b-add:MENU-MOUSE = 1  .
     3682   ASSIGN
     3683   X_rule-by-call.algo-des:RESIZABLE IN BROWSE br-rule-by-call = YES
     3684   b-rule:menu-mouse in frame Dialog-Frame = 1
     3685   b-ruleproc:menu-mouse in frame Dialog-Frame = 1
     3686   .
     3687   DISPLAY
     3688   rs-algo-profile
     3689   rs-algo-types
     3690   WITH FRAME Dialog-Frame.
     3691   ASSIGN
     3692   v-tab-order = "b-chg".
     3693   ENABLE
     3694   b-quit
     3695   B-Help
     3696   rs-active
     3697   b-chg when p-mode = 'ИЗМЕНЕНИЕ':U
     3698   b-add when p-mode = 'ИЗМЕНЕНИЕ':U
     3699   BR-thbj-attr
     3700   br-rule-by-call
     3701   br-profile
     3702   b-params
     3703   b-rule
     3704   b-ruleset
     3705   b-ruleproc
     3706   rs-algo-types
     3707   rs-algo-profile
     3708   br-thbj-attr
     3709   e-rule-name
     3710   WITH FRAME Dialog-Frame.
     3711   VIEW FRAME Dialog-Frame.
     3712   IF p-mode = 'ПРОСМОТР':U THEN DO:
     3713       ASSIGN
     3714       b-quit:LABEL = "&Выход"
     3715       .
     3716   END.
     3717   run Openbr in this-procedure ( input no).
     3718   APPLY "ENTRY" TO br-thbj-attr.
     3719   APPLY "VALUE-CHANGED" TO br-thbj-attr.
     3720   APPLY "VALUE-CHANGED" TO rs-algo-profile.
     3721   END PROCEDURE.
     3722   PROCEDURE OpenBr :
     3723   define input parameter p-active as logical no-undo .
     3724   case p-active :
     3725     when yes then do:
     3726       CASE p-list-mode:
     3727         WHEN 'все':U THEN DO:
     3728             OPEN QUERY br-thbj-attr
     3729         FOR EACH buf_thbj-attr no-lock WHERE
     3730             ((buf_thbj-attr.upper-prop-code = p-upper-code
     3731         AND lookup(buf_thbj-attr.prop-code, p-prop-list-global) > 0)
     3732             or
     3733             (buf_thbj-attr.upper-prop-code = p-obj-upper-code
     3734             and
     3735             lookup(buf_thbj-attr.prop-code, p-prop-list-obj) > 0))
     3736         AND
     3737             buf_thbj-attr.property-value-logical =  yes
     3738             ,
     3739             FIRST X_clients NO-LOCK            .
     3740         END.
     3741         WHEN 'БД':U THEN DO:
     3742             OPEN QUERY br-thbj-attr
     3743         FOR EACH buf_thbj-attr no-lock WHERE
     3744             ((buf_thbj-attr.upper-prop-code = p-upper-code
     3745         AND lookup(buf_thbj-attr.prop-code, p-prop-list-global) > 0)
     3746             or
     3747             (buf_thbj-attr.upper-prop-code = p-obj-upper-code
     3748             and
     3749             lookup(buf_thbj-attr.prop-code, p-prop-list-obj) > 0))
     3750         AND
     3751             buf_thbj-attr.property-value-logical =  yes
     3752             ,
     3753             FIRST X_clients NO-LOCK WHERE
     3754                 X_clients.obj-code = buf_thbj-attr.obj-code
     3755             AND X_clients.obj-type = buf_thbj-attr.obj-type
     3756             AND X_clients.db-num = v-cntxt-db-num.
     3757         END.
     3758         WHEN 'объект':U THEN DO:
     3759                 OPEN QUERY br-thbj-attr
     3760             FOR EACH buf_thbj-attr no-lock WHERE
     3761                 buf_thbj-attr.obj-type = p-obj-type
     3762             AND buf_thbj-attr.obj-code = p-obj-code
     3763             AND buf_thbj-attr.upper-prop-code = p-obj-upper-code
     3764             AND lookup(buf_thbj-attr.prop-code, p-prop-list-obj) > 0
     3765                 and buf_thbj-attr.property-value-logical = p-active
     3766                 ,
     3767                     FIRST X_clients NO-LOCK WHERE
     3768                     X_clients.obj-type = buf_thbj-attr.obj-type
     3769                 AND X_clients.obj-code = buf_thbj-attr.obj-code
     3770                 AND X_clients.db-num = v-cntxt-db-num.
     3771             END.
     3772       END CASE.
     3773     end.
     3774     when no then do:
     3775       CASE p-list-mode:
     3776         WHEN 'все':U THEN DO:
     3777             OPEN QUERY br-thbj-attr
     3778         FOR EACH buf_thbj-attr no-lock WHERE
     3779             ((buf_thbj-attr.upper-prop-code = p-upper-code
     3780         AND lookup(buf_thbj-attr.prop-code, p-prop-list-global) > 0)
     3781             or
     3782             (buf_thbj-attr.upper-prop-code = p-obj-upper-code
     3783             and
     3784             lookup(buf_thbj-attr.prop-code, p-prop-list-obj) > 0))
     3785             ,
     3786             FIRST X_clients NO-LOCK            .
     3787         END.
     3788         WHEN 'БД':U THEN DO:
     3789             OPEN QUERY br-thbj-attr
     3790         FOR EACH buf_thbj-attr no-lock WHERE
     3791             ((buf_thbj-attr.upper-prop-code = p-upper-code
     3792         AND lookup(buf_thbj-attr.prop-code, p-prop-list-global) > 0)
     3793             or
     3794             (buf_thbj-attr.upper-prop-code = p-obj-upper-code
     3795             and
     3796             lookup(buf_thbj-attr.prop-code, p-prop-list-obj) > 0))
     3797             ,
     3798             FIRST X_clients NO-LOCK  WHERE
     3799                 X_clients.obj-code = buf_thbj-attr.obj-code
     3800             AND X_clients.obj-type = buf_thbj-attr.obj-type
     3801             AND X_clients.db-num = v-cntxt-db-num.
     3802         END.
     3803         WHEN 'объект':U THEN DO:
     3804                 OPEN QUERY br-thbj-attr
     3805             FOR EACH buf_thbj-attr no-lock WHERE
     3806                 buf_thbj-attr.obj-type = p-obj-type
     3807             AND buf_thbj-attr.obj-code = p-obj-code
     3808             AND buf_thbj-attr.upper-prop-code = p-obj-upper-code
     3809             AND lookup(buf_thbj-attr.prop-code, p-prop-list-obj) > 0
     3810                 ,
     3811                     FIRST X_clients NO-LOCK WHERE
     3812                     X_clients.obj-type = buf_thbj-attr.obj-type
     3813                 AND X_clients.obj-code = buf_thbj-attr.obj-code
     3814                 AND X_clients.db-num = v-cntxt-db-num.
     3815             END.
     3816       END CASE.
     3817     end.
     3818   end case.
     3819   END PROCEDURE.
     3820   PROCEDURE proc-b-add :
     3821   DEFINE INPUT PARAMETER prop-option AS CHARACTER NO-UNDO.
     3822   define variable v-rid-list as character no-undo .
     3823   define variable v-loc-uniq-key-rec as character no-undo .
     3824   define variable v-param-type as character no-undo .
     3825   define variable v-value-character AS character no-undo .
     3826   define variable v-value-date as date no-undo .
     3827   define variable v-value-decimal as decimal no-undo .
     3828   define variable v-value-integer as INTEGER no-undo .
     3829   define variable v-value-logical as logical no-undo .
     3830   define variable v-recid as recid no-undo .
     3831   define buffer buf_thbj-attr for ub.thbj-attr.
     3832   define buffer bufobj_clients for ub.clients.
     3833       run ref/thobjs.w
     3834           ( input parparentproc
     3835           , input this-procedure:handle
     3836           , input "b-sel"
     3837           , input 'все':U
     3838           , input ''
     3839           , input ?
     3840           , input ?
     3841           , input-output v-rid-list ) no-error .
     3842     if v-rid-list = '':U
     3843     or v-rid-list = string(recid(bufobj_clients)) then return error.
     3844     find first bufobj_clients no-lock where
     3845               recid(bufobj_clients) = integer(v-rid-list) no-error.
     3846     if not available bufobj_clients then return ERROR.
     3847     run adm/shattri.p (
     3848                   input "init":U
     3849                 , input bufobj_clients.obj-type
     3850                 , input bufobj_clients.obj-code
     3851                 , input p-obj-upper-code
     3852                 , input ''
     3853                 , output v-value-character
     3854                 , output v-value-date
     3855                 , output v-value-decimal
     3856                 , output v-value-integer
     3857                 , output v-value-logical
     3858                 , output v-param-type
     3859                 , INPUT-OUTPUT TABLE-handle v-tth
     3860                 ) no-error .
     3861     if error-status:error then do:
     3862       message
     3863       "Не удалось получить начальные значения настроек" skip
     3864       error-status:get-message(1) return-value
     3865       view-as alert-box error .
     3866       undo, return ERROR.
     3867     end.
     3868     find first thbjattr_thbj-attr where
     3869               thbjattr_thbj-attr.obj-type = bufobj_clients.obj-type
     3870          and thbjattr_thbj-attr.obj-code = bufobj_clients.obj-code
     3871          and thbjattr_thbj-attr.upper-prop-code = p-obj-upper-code
     3872          and thbjattr_thbj-attr.prop-code = prop-option.
     3873     RUN gen-key-rec IN THIS-PROCEDURE (
     3874      input  'thbj-attr':U
     3875     ,INPUT (BUFFER thbjattr_thbj-attr:handle)
     3876     ,OUTPUT v-loc-uniq-key-rec) no-error.
     3877     run thbjattr_write in this-procedure (
     3878                                             input  bufobj_clients.obj-type
     3879                                           ,input  bufobj_clients.obj-code
     3880                                           ,input  p-obj-upper-code
     3881                                           ,input  prop-code
     3882                                           ,input  thbjattr_thbj-attr.property-value-character
     3883                                           ,input  thbjattr_thbj-attr.property-value-date
     3884                                           ,input  thbjattr_thbj-attr.property-value-decimal
     3885                                           ,input  thbjattr_thbj-attr.property-value-integer
     3886                                           ,input  thbjattr_thbj-attr.property-value-logical
     3887                                             ) no-error .
     3888     IF ERROR-STATUS:error THEN do:
     3889       MESSAGE ERROR-STATUS:get-message(1)  SKIP
     3890       RETURN-VALUE
     3891       VIEW-AS ALERT-BOX.
     3892       UNDO, RETURN ERROR.
     3893     END.
     3894     run adm/thbj-rum.w (
     3895                          input parparentproc
     3896                         ,input p-mode
     3897                         ,input v-host-code
     3898                         ,input bufobj_clients.obj-type
     3899                         ,input bufobj_clients.obj-code
     3900                         ,input prop-option
     3901                         ,input v-loc-uniq-key-rec) no-error.
     3902     run openbr in this-procedure ( input rs-active).
     3903     find first buf_thbj-attr no-lock where
     3904               buf_thbj-attr.prop-code = thbjattr_thbj-attr.prop-code
     3905           and buf_thbj-attr.upper-prop-code = thbjattr_thbj-attr.upper-prop-code
     3906           and buf_thbj-attr.obj-type = thbjattr_thbj-attr.obj-type
     3907           and buf_thbj-attr.obj-code = thbjattr_thbj-attr.obj-code no-error .
     3908     assign
     3909     v-recid = recid(buf_thbj-attr).
     3910     reposition br-thbj-attr to recid v-recid no-error.
     3911     APPLy "ENTRY" to br-thbj-attr in frame Dialog-Frame .
     3912     APPLY "VALUE-CHANGED" to browse br-thbj-attr.
     3913   END PROCEDURE.
     3914   PROCEDURE proc-display-rule :
     3915   DEFINE INPUT PARAMETER p-DISPLAY-MODE AS CHARACTER NO-UNDO.
     3916   DEFINE INPUT PARAMETER p-codex-id AS INTEGER NO-UNDO.
     3917   DEFINE INPUT PARAMETER p-ruleset-id AS INTEGER NO-UNDO.
     3918   DEFINE INPUT PARAMETER p-call-id AS CHARACTER NO-UNDO.
     3919   DEFINE INPUT PARAMETER p-order-id AS INTEGER NO-UNDO.
     3920   DEFINE INPUT PARAMETER p-rule-id AS INTEGER NO-UNDO.
     3921   run rul/disprule.p (
     3922                          input p-DISPLAY-MODE
     3923                         ,input p-rule-id
     3924                         ,input p-codex-id
     3925                         ,input p-ruleset-id
     3926                         ,input p-call-id
     3927                         ,input p-order-id
     3928                          ).
     3929   END PROCEDURE.
     3930   PROCEDURE proc-value-changed :
     3931   OPEN QUERY br-rule-by-call FOR EACH X_rule-by-call       WHERE X_rule-by-call.call_id = v-uniq-key-rec,            FIRST X_rule-profile NO-LOCK WHERE          X_rule-profile.profile_id = X_rule-by-call.profile_id      AND (rs-algo-types = 1 OR          X_rule-profile.is_dynamic = yes) BY X_rule-by-call.codex_id BY X_rule-by-call.ruleset_id BY X_rule-by-call.order_id INDEXED-REPOSITION.
     3932   OPEN QUERY br-profile FOR EACH X_rp-by-call WHERE          X_rp-by-call.call_id = v-uniq-key-rec NO-LOCK INDEXED-REPOSITION.
     3933   IF rs-algo-profile = 'rule-by-call':U THEN DO:
     3934     APPLY "VAlue-changed" TO br-rule-by-call IN FRAME Dialog-Frame.
     3935   END.
     3936   IF rs-algo-profile = 'rp-by-call':U THEN DO:
     3937     APPLY "VAlue-changed" TO br-profile IN FRAME Dialog-Frame.
     3938   END.
     3939   END PROCEDURE.
     3940   PROCEDURE rule-proc :
     3941   DEFINE INPUT PARAMETER p-uniq-key-rec AS CHARACTER NO-UNDO.
     3942   DEFINE INPUT PARAMETER p-option AS CHARACTER NO-UNDO.
     3943   run rul/run-rule-proc-view.p ( INPUT buf_thbj-attr.prop-code
     3944                                 ,INPUT p-uniq-key-rec
     3945                                 ,INPUT 0
     3946                                 ,INPUT p-option
     3947                                 ) NO-ERROR.
     3948   IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     3949   END PROCEDURE.
     3950   FUNCTION get-profile-dynamic RETURNS LOGICAL
     3951     ( INPUT p-profile-id AS INTEGER ) :
     3952   DEFINE BUFFER buf_rule-profile FOR ub.rule-profile.
     3953   FIND FIRST buf_rule-profile NO-LOCK WHERE
     3954             buf_rule-profile.profile_id = p-profile-id NO-ERROR.
     3955   IF NOT AVAILABLE buf_rule-profile THEN RETURN ?.
     3956   RETURN buf_rule-profile.is_dynamic.
     3957   END FUNCTION.
     3958   FUNCTION get-profile-name RETURNS CHARACTER
     3959     ( INPUT p-profile-id AS INTEGER ) :
     3960   DEFINE BUFFER buf_rule-profile FOR ub.rule-profile.
     3961   FIND FIRST buf_rule-profile NO-LOCK WHERE
     3962             buf_rule-profile.profile_id = p-profile-id NO-ERROR.
     3963   IF NOT AVAILABLE buf_rule-profile THEN RETURN chr(63).
     3964   RETURN buf_rule-profile.NAME.
     3965   END FUNCTION.
     3966   FUNCTION get-prop-label RETURNS CHARACTER
     3967     ( INPUT p-upper-prop-code AS character
     3968     ,INPUT p-prop-code AS character ) :
     3969   DEFINE VARIABLE v-tooltip AS CHARACTER NO-UNDO.
     3970   DEFINE VARIABLE v-label AS CHARACTER NO-UNDO.
     3971   DEFINE VARIABLE v-tooltip-code AS CHARACTER NO-UNDO.
     3972   run thbjattr_tooltip IN THIS-PROCEDURE (
     3973     input  p-upper-prop-code
     3974    ,INPUT p-prop-code
     3975     ,OUTPUT v-tooltip
     3976     ,OUTPUT v-label
     3977     ,OUTPUT v-tooltip-code ) NO-ERROR.
     3978   RETURN entry(2, v-label, ":").
     3979   END FUNCTION.
     3980   FUNCTION has-object-context RETURNS LOGICAL
     3981     ( INPUT p-profile-id AS INTEGER ) :
     3982   define BUFFER buf_rule-profile FOR ub.rule-profile.
     3983   FIND FIRST buf_rule-profile WHERE buf_rule-profile.profile_id = p-profile-id NO-ERROR.
     3984   IF AVAILABLE buf_rule-profile THEN DO:
     3985       RETURN LOOKUP("obj", buf_rule-profile.short-name) > 0.
     3986   END.
     3987   RETURN ?.
     3988   END FUNCTION.
