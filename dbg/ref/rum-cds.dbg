     1591   DEFINE VARIABLE rule-display-option AS CHARACTER NO-UNDO.
     1592   DEFINE VARIABLE rule-proc-option AS CHARACTER NO-UNDO.
     1593   define variable v-label          as character no-undo .
     1594   define variable v-user-can-edit  as logical   no-undo .
     1595   define variable v-output-display as logical   no-undo .
     1596   define variable v-other          as character no-undo .
     1597   define variable v-prop-list-global      as character no-undo .
     1598   define variable v-prop-list-obj    as character no-undo .
     1599   define variable v-prop-type-list as character no-undo .
     1600   define variable v-prop-label-list as character no-undo .
     1601   define variable v-global          as logical no-undo .
     1602   define variable v-host           as logical no-undo .
     1603   define variable v-shop           as logical no-undo .
     1604   define variable v-store          as logical no-undo .
     1605   define variable v-level as character no-undo .
     1606   define variable v-up-way as character no-undo .
     1607   define variable v-prop-list as character no-undo .
     1608   define variable v-current-upper-prop-code as character no-undo .
     1609   DEFINE BUFFER buf_thbj-attr FOR ub.thbj-attr.
     1610   define variable v-tth as handle no-undo .
     1611   assign
     1612   v-tth = buffer thbjattr_thbj-attr:table-handle .
     1613   define variable prop-option as character no-undo .
     1614   FUNCTION get-profile-dynamic RETURNS LOGICAL
     1615     ( INPUT p-profile-id AS INTEGER )  FORWARD.
     1616   FUNCTION get-profile-name RETURNS CHARACTER
     1617     ( INPUT p-profile-id AS INTEGER )  FORWARD.
     1618   FUNCTION get-prop-label RETURNS CHARACTER
     1619     ( INPUT p-upper-prop-code AS character
     1620     ,INPUT p-prop-code AS character )  FORWARD.
     1621   FUNCTION has-object-context RETURNS LOGICAL
     1622     ( INPUT p-profile-id AS INTEGER )  FORWARD.
     1623   DEFINE MENU MENU-b-rule
     1624          MENU-ITEM m_text         LABEL "Текст"
     1625          MENU-ITEM m_graph        LABEL "Схема"         .
     1626   DEFINE MENU menu-b-ruleproc
     1627          MENU-ITEM m_proc_text    LABEL "Текст"
     1628          MENU-ITEM m_proc_graph   LABEL "Графика"       .
     1629   DEFINE BUTTON b-add
     1630        LABEL "&Добавить"
     1631        SIZE 10 BY 1.
     1632   DEFINE BUTTON B-chg  NO-FOCUS
     1633        LABEL "&Изменить"
     1634        SIZE 10 BY 1.
     1635   DEFINE BUTTON B-Help
     1636        LABEL "Помо&щь"
     1637        SIZE 3 BY 1
     1638        BGCOLOR 8 .
     1639   DEFINE BUTTON b-params
     1640        LABEL "Пар-ры"
     1641        SIZE 10 BY 1.
     1642   DEFINE BUTTON b-quit AUTO-END-KEY
     1643        LABEL "&Выход"
     1644        SIZE 10 BY 1
     1645        BGCOLOR 8 .
     1646   DEFINE BUTTON b-rule
     1647        LABEL "Правило"
     1648        SIZE 10 BY 1.
     1649   DEFINE BUTTON b-ruleproc
     1650        LABEL "Процессы"
     1651        SIZE 12 BY 1.
     1652   DEFINE BUTTON B-ruleset
     1653        LABEL "Т-ка вызова"
     1654        SIZE 14 BY 1.
     1655   DEFINE VARIABLE E-rule-name AS CHARACTER
     1656        VIEW-AS EDITOR SCROLLBAR-VERTICAL
     1657        SIZE 98 BY 2.17
     1658        FGCOLOR 4  NO-UNDO.
     1659   DEFINE VARIABLE rs-active AS LOGICAL
     1660        VIEW-AS RADIO-SET HORIZONTAL
     1661        RADIO-BUTTONS
     1662             "Все", no,
     1663   "Активные", yes
     1664        SIZE 21.5 BY 1 NO-UNDO.
     1665   DEFINE VARIABLE Rs-algo-profile AS CHARACTER
     1666        VIEW-AS RADIO-SET HORIZONTAL
     1667        RADIO-BUTTONS
     1668             "Item 1", "1",
     1669   "Item 2", "2"
     1670        SIZE 28 BY 1 NO-UNDO.
     1671   DEFINE VARIABLE rs-algo-types AS INTEGER INITIAL 2
     1672        VIEW-AS RADIO-SET HORIZONTAL
     1673        RADIO-BUTTONS
     1674             "Все", 1,
     1675   "Определенные пользователем", 2
     1676        SIZE 36 BY .77 NO-UNDO.
     1677   DEFINE QUERY br-profile FOR
     1678         X_rp-by-call SCROLLING.
     1679   DEFINE QUERY br-rule-by-call FOR
     1680         X_rule-by-call,
     1681         X_rule-profile SCROLLING.
     1682   DEFINE QUERY BR-thbj-attr FOR
     1683         buf_thbj-attr,
     1684         X_clients SCROLLING.
     1685   DEFINE BROWSE br-profile
     1686     QUERY br-profile NO-LOCK DISPLAY
     1687         X_rp-by-call.profile_id COLUMN-LABEL "Про!файл" FORMAT ">>9"
     1688   get-profile-name ( INPUT X_rp-by-call.profile_id) COLUMN-LABEL "Название" FORMAT "X(255)"
     1689   get-profile-dynamic ( INPUT X_rp-by-call.profile_id) COLUMN-LABEL "Отклю!чаемый" FORMAT "+/":U
     1690   X_rp-by-call.once-more COLUMN-LABEL "№!привязки" FORMAT ">9"
     1691   has-object-context(X_rp-by-call.profile_id) COLUMN-LABEL "Имеет объектный!контекст" FORMAT "+/"
     1692       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 10
     1693            TITLE "Алгоритмы" ROW-HEIGHT-CHARS .67.
     1694   DEFINE BROWSE br-rule-by-call
     1695     QUERY br-rule-by-call NO-LOCK DISPLAY
     1696         X_rule-by-call.can-calc COLUMN-LABEL "Включен?" FORMAT "+/":U
     1697   X_rule-by-call.algo-des FORMAT "X(255)":U COLUMN-LABEL "Описание алгоритма/правила" WIDTH 56
     1698   X_rule-by-call.is_dynamic COLUMN-LABEL "Отклю!чаемое" FORMAT "+/":U
     1699   X_rule-by-call.codex_id COLUMN-LABEL "Кодекс!правил" FORMAT ">>>>>>9":U WIDTH 7
     1700   X_rule-by-call.ruleset_id COLUMN-LABEL "Набор!правил" FORMAT ">>>>>>9":U width 7
     1701   X_rule-by-call.order_id COLUMN-LABEL "Порядок!вызова" FORMAT ">>9":U WIDTH 9
     1702   X_rule-by-call.rule_id COLUMN-LABEL "Код!правила" FORMAT ">>>>>>>>9":U WIDTH 9
     1703   X_rule-by-call.profile_id COLUMN-LABEL "Алгоритм" FORMAT ">>9":U WIDTH 8
     1704   has-object-context(X_rule-by-call.profile_id) COLUMN-LABEL "Имеет объектный!контекст" FORMAT "+/"
     1705       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 10
     1706            FONT 4
     1707            TITLE "Правила" ROW-HEIGHT-CHARS .67.
     1708   DEFINE BROWSE BR-thbj-attr
     1709     QUERY BR-thbj-attr DISPLAY
     1710         get-region(0, buf_thbj-attr.obj-type, buf_thbj-attr.obj-code) COLUMN-LABEL "Действует" FORMAT "X(15)"
     1711    get-prop-label(buf_thbj-attr.upper-prop-code, buf_thbj-attr.prop-code) COLUMN-LABEL "Вид алгоритмов" FORMAT "X(255)" width 70
     1712   buf_thbj-attr.property-value-logical COLUMN-LABEL "Активен" FORMAT "+/"
     1713       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 8 FIT-LAST-COLUMN.
     1714   DEFINE FRAME Dialog-Frame
     1715        B-chg AT ROW 1 COL 41
     1716        b-quit AT ROW 1 COL 1
     1717        b-add AT ROW 1 COL 31 WIDGET-ID 26
     1718        rs-active AT ROW 1 COL 54.5 NO-LABEL WIDGET-ID 28
     1719        b-ruleproc AT ROW 1 COL 79 WIDGET-ID 24
     1720        B-Help AT ROW 1 COL 95
     1721        BR-thbj-attr AT ROW 2 COL 1 WIDGET-ID 300
     1722        Rs-algo-profile AT ROW 10 COL 1 NO-LABEL WIDGET-ID 16
     1723        rs-algo-types AT ROW 10 COL 28.5 NO-LABEL WIDGET-ID 20
     1724        b-rule AT ROW 10 COL 64.5 WIDGET-ID 14
     1725        b-params AT ROW 10 COL 74.5 WIDGET-ID 6
     1726        B-ruleset AT ROW 10 COL 84.5 WIDGET-ID 12
     1727        br-rule-by-call AT ROW 11 COL 1 WIDGET-ID 100
     1728        br-profile AT ROW 11 COL 1 WIDGET-ID 200
     1729        E-rule-name AT ROW 21.47 COL 1 NO-LABEL WIDGET-ID 2
     1730        SPACE(0.29) SKIP(0.00)
     1731       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1732            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1733            TITLE "Машина правил (встраиваемые проц-ры)"
     1734            CANCEL-BUTTON b-quit.
     1735   ASSIGN
     1736          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1737          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1738   ASSIGN
     1739          b-rule:POPUP-MENU IN FRAME Dialog-Frame       = MENU MENU-b-rule:HANDLE.
     1740   ASSIGN
     1741          b-ruleproc:POPUP-MENU IN FRAME Dialog-Frame       = MENU menu-b-ruleproc:HANDLE.
     1742   ASSIGN
     1743          E-rule-name:READ-ONLY IN FRAME Dialog-Frame        = TRUE.
     1744   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1745   DO:
     1746     APPLY "END-ERROR":U TO SELF.
     1747   END.
     1748   ON CHOOSE OF b-add IN FRAME Dialog-Frame
     1749   DO:
     1750     IF prop-option = '':U THEN DO:
     1751       run gbl/pop-up.p ( INPUT SELF :handle, input no ) no-error.
     1752       if error-status :error then do: return no-apply. end.
     1753     end.
     1754     if prop-option = "":U then do:
     1755         return no-apply.
     1756     end.
     1757     RUN proc-b-add IN THIS-PROCEDURE ( INPUT prop-option) NO-ERROR.
     1758     IF ERROR-STATUS:ERROR THEN DO:
     1759         prop-option = ''.
     1760         RETURN NO-APPLY.
     1761     END.
     1762     prop-option = ''.
     1763   END.
     1764   ON CHOOSE OF B-chg IN FRAME Dialog-Frame
     1765   DO:
     1766     DEFINE VARIABLE v-code AS integer NO-UNDO.
     1767     define variable v-name as character no-undo.
     1768     DEFINE VARIABLE v-log AS logical NO-UNDO.
     1769     DEFINE variable v-rid AS RECID NO-UNDO.
     1770     define variable v-rec as recid no-undo .
     1771     DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1772     define variable v-host-code as integer no-undo .
     1773     define variable v-value-character as character no-undo .
     1774     define variable v-value-date as date no-undo .
     1775     define variable v-value-decimal as decimal no-undo .
     1776     define variable v-value-integer as INTEGER no-undo .
     1777     define variable v-value-logical AS LOGICAL no-undo .
     1778     define variable v-param-type as character no-undo .
     1779     define variable v-tbl-row as rowid no-undo .
     1780     define variable v-tbl-name as character no-undo .
     1781     define buffer buf_thbj-attr for ub.thbj-attr.
     1782     if p-obj-type = 'маг':U
     1783     or p-obj-type = 'скл':U then do:
     1784   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1785   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1786     (input  p-obj-type
     1787     ,input  p-obj-code
     1788     ,output v-host-code
     1789     )  .
     1790     end.
     1791     run gen-row-keyr in this-procedure (
     1792                                           input  v-uniq-key-rec
     1793                                         ,input  ?
     1794                                         ,input  "ub"
     1795                                         ,input  ?
     1796                                         ,input  NO-LOCK
     1797                                         ,output v-tbl-row
     1798                                         ,output v-tbl-name
     1799                                         ).
     1800     find first buf_thbj-attr no-lock where
     1801               rowid(buf_thbj-attr) = v-tbl-row no-error.
     1802     v-rec = recid(buf_thbj-attr).
     1803     run adm/thbj-rum.w (
     1804                          input parparentproc
     1805                         ,input p-mode
     1806                         ,input v-host-code
     1807                         ,input (if buf_thbj-attr.obj-type = 'маг':U
     1808                                 or buf_thbj-attr.obj-type = 'скл':U
     1809                                 then buf_thbj-attr.obj-type
     1810                                 else '')
     1811                         ,input (if buf_thbj-attr.obj-type = 'маг':U
     1812                                or buf_thbj-attr.obj-type = 'скл':U
     1813                                then buf_thbj-attr.obj-code
     1814                                else 0)
     1815                         ,input buf_thbj-attr.prop-code
     1816                         ,input v-uniq-key-rec) no-error.
     1817     run openbr in this-procedure ( input rs-active).
     1818     reposition br-thbj-attr to recid v-rec no-error.
     1819     apply "entry" to br-thbj-attr.
     1820     APPLY "VALUE-CHANGED" to browse br-thbj-attr.
     1821   END.
     1822   ON CHOOSE OF b-params IN FRAME Dialog-Frame
     1823   DO:
     1824   DEFINE BUFFER buf_rule-call-param FOR ub.rule-call-param.
     1825   define buffer buf_rule-by-call for ub.rule-by-call.
     1826     CASE Rs-algo-profile:
     1827       when 'rule-by-call':U then do:
     1828         IF NOT AVAILABLE X_rule-by-call THEN RETURN NO-APPLY.
     1829         FOR EACH tt0-rule-call-param NO-LOCK:
     1830           DELETE tt0-rule-call-param.
     1831         END.
     1832         FOR EACH buf_rule-call-param NO-LOCK WHERE
     1833                 buf_rule-call-param.codex_id = X_rule-by-call.codex_id
     1834             AND buf_rule-call-param.ruleset_id = X_rule-by-call.ruleset_id
     1835             AND buf_rule-call-param.call_id = X_rule-by-call.call_id:
     1836             CREATE tt0-rule-call-param.
     1837             BUFFER-COPY buf_rule-call-param TO tt0-rule-call-param.
     1838         END.
     1839         run ref/rulercps.w (
     1840                                  input parparentproc
     1841                                 ,input this-procedure:handle
     1842                                 ,input '':U
     1843                                 ,input 'ПРОСМОТР':U
     1844                                 ,input 'rule-call-param':U
     1845                                 ,input 0
     1846                                 ,input ?
     1847                                 ,input X_rule-by-call.call_id
     1848                                 ,input X_rule-by-call.codex_id
     1849                                 ,input X_rule-by-call.ruleset_id
     1850                                 ,input X_rule-by-call.order_id
     1851                                 ,input X_rule-by-call.RULE_id
     1852                                 ,INput substitute("Правило &1", X_rule-by-call.RULE_id)
     1853                                 ,input-output table tt0-rule-call-param  ) no-error.
     1854         IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
     1855       end.
     1856       when 'rp-by-call':U then do:
     1857         IF NOT AVAILABLE X_rp-by-call THEN RETURN NO-APPLY.
     1858         FOR EACH tt0-rule-call-param NO-LOCK:
     1859           DELETE tt0-rule-call-param.
     1860         END.
     1861         for each buf_rule-by-call no-lock where
     1862               buf_rule-by-call.call_id = X_rp-by-call.call_id
     1863           and buf_rule-by-call.profile_id = X_rp-by-call.profile_id
     1864           and buf_rule-by-call.once-more = X_rp-by-call.once-more,
     1865            EACH buf_rule-call-param NO-LOCK WHERE
     1866                 buf_rule-call-param.call_id = buf_rule-by-call.call_id
     1867             AND buf_rule-call-param.codex_id = buf_rule-by-call.codex_id
     1868             AND buf_rule-call-param.ruleset_id = buf_rule-by-call.ruleset_id
     1869             AND buf_rule-call-param.order_id = buf_rule-by-call.order_id :
     1870             CREATE tt0-rule-call-param.
     1871             BUFFER-COPY buf_rule-call-param TO tt0-rule-call-param.
     1872         END.
     1873         define variable v-param-form as character no-undo .
     1874         define buffer buf_rule-profile for ub.rule-profile.
     1875         find first buf_rule-profile no-lock where
     1876                   buf_rule-profile.profile_id = X_rp-by-call.profile_id.
     1877         assign
     1878         v-param-form = (if buf_rule-profile.custom-param-form > 0
     1879                         then  substitute("rul/rcps-&1.w", buf_rule-profile.profile_id)
     1880                         else "ref/rulercps.w")
     1881         .
     1882         run value(v-param-form) (
     1883                                 input parparentproc
     1884                                 ,input this-procedure:handle
     1885                                 ,input '':U
     1886                                 ,input 'ПРОСМОТР':U
     1887                                 ,input 'rp-rule-param':U
     1888                                 ,input X_rp-by-call.profile_id
     1889                                 ,input X_rp-by-call.once-more
     1890                                 ,input X_rp-by-call.call_id
     1891                                 ,input 0
     1892                                 ,input 0
     1893                                 ,input ?
     1894                                 ,input 0
     1895                                 ,INput substitute("Профайл &1 Номер привязки &2 &3"
     1896                                       , X_rp-by-call.profile_id
     1897                                       , X_rp-by-call.once-more
     1898                                       , calldscr(X_rp-by-call.call_id)
     1899                                       )
     1900                                 ,input-output table tt0-rule-call-param  ) no-error.
     1901         IF ERROR-STATUS:ERROR THEN do:
     1902           message
     1903           error-status:get-message(1)
     1904           view-as alert-box .
     1905           return no-apply.
     1906         end.
     1907       end.
     1908     end case.
     1909   END.
     1910   ON CHOOSE OF b-rule IN FRAME Dialog-Frame
     1911   DO:
     1912     IF NOT AVAILABLE X_rule-by-call THEN RETURN NO-APPLY.
     1913     IF rule-display-option = "" THEN DO:
     1914      run gbl/pop-up.p ( input self:handle, input no) no-error.
     1915     END.
     1916     IF rule-display-option = "" THEN DO:
     1917       RETURN NO-APPLY.
     1918     END.
     1919     RUN proc-display-rule IN THIS-PROCEDURE (
     1920                                               INPUT rule-display-option
     1921                                              ,INPUT X_rule-by-call.codex_id
     1922                                              ,INPUT X_rule-by-call.ruleset_id
     1923                                              ,INPUT X_rule-by-call.call_Id
     1924                                              ,INPUT X_rule-by-call.order_id
     1925                                              ,INPUT X_rule-by-call.rule_id) NO-ERROR.
     1926     IF ERROR-STATUS:ERROR THEN DO:
     1927       ASSIGN
     1928       rule-display-option = "".
     1929       RETURN NO-APPLY.
     1930     END.
     1931     ASSIGN
     1932     rule-display-option = "".
     1933   END.
     1934   ON CHOOSE OF b-ruleproc IN FRAME Dialog-Frame
     1935   DO:
     1936     IF NOT AVAILABLE buf_thbj-attr THEN RETURN NO-APPLY.
     1937   IF rule-proc-option = '':U THEN DO:
     1938      run gbl/pop-up.p ( INPUT SELF:handle, input no ) no-error.
     1939      if error-status :error then do: return no-apply. end.
     1940   end.
     1941   if rule-proc-option = "":U then do:
     1942         return no-apply.
     1943   end.
     1944   run rule-proc IN THIS-PROCEDURE ( v-uniq-key-rec, INPUT rule-proc-option) no-error .
     1945   IF ERROR-STATUS:ERROR THEN DO:
     1946       rule-proc-option = '':U.
     1947       RETURN NO-APPLY.
     1948   END.
     1949   rule-proc-option = '':U.
     1950   END.
     1951   ON CHOOSE OF B-ruleset IN FRAME Dialog-Frame
     1952   DO:
     1953     DEFINE VARIABLE v-rec AS RECID NO-UNDO.
     1954   define buffer buf_ruleset for ub.ruleset.
     1955     IF NOT AVAILABLe X_rule-by-call THEN DO:
     1956         RETURN NO-APPLY.
     1957     END.
     1958     FIND FIRST buf_ruleset NO-LOCK WHERE
     1959               buf_ruleset.codex_id = X_rule-by-call.codex_id
     1960           AND buf_ruleset.ruleset_id = X_rule-by-call.ruleset_id.
     1961     run rul/ruleset-i.w ( input parparentproc
     1962                          ,input 'ПРОСМОТР':U
     1963                          ,input buf_ruleset.codex_id
     1964                          ,input buf_ruleset.ruleset_id
     1965                          ,input-output v-rec) no-error.
     1966   END.
     1967   ON VALUE-CHANGED OF br-profile IN FRAME Dialog-Frame
     1968   DO:
     1969      IF NOT AVAILABLE X_rp-by-call THEN DO:
     1970        e-rule-name:SCREEN-VALUE = ''.
     1971     END.
     1972     ELSE DO:
     1973       e-rule-name:SCREEN-VALUE = X_rp-by-call.ps.
     1974     END.
     1975   END.
     1976   ON VALUE-CHANGED OF br-rule-by-call IN FRAME Dialog-Frame
     1977   DO:
     1978     DEFINE BUFFER buf_rule FOR ub.RULE.
     1979     IF NOT AVAILABLE X_rule-by-call THEN RETURN NO-APPLY.
     1980     FIND FIRST buf_rule NO-LOCK WHERE
     1981               buf_rule.RULE_id = X_rule-by-call.RULE_id NO-ERROR.
     1982     IF NOT AVAILABLE buf_rule THEN DO:
     1983        e-rule-name:SCREEN-VALUE = SUBSTITUTE("!!!Правило &1 не найдено", X_rule-by-call.RULE_Id).
     1984     END.
     1985     ELSE DO:
     1986       e-rule-name:SCREEN-VALUE = buf_rule.name + chr(10) + buf_rule.documentation.
     1987     END.
     1988   END.
     1989   ON VALUE-CHANGED OF BR-thbj-attr IN FRAME Dialog-Frame
     1990   DO:
     1991     IF NOT AVAILABLE buf_thbj-attr THEN v-uniq-key-rec = ''.
     1992     RUN gen-key-rec IN THIS-PROCEDURE (
     1993      input  'thbj-attr':U
     1994     ,INPUT (BUFFER buf_thbj-attr:handle)
     1995     ,OUTPUT v-uniq-key-rec) no-error.
     1996      RUN proc-value-changed IN THIS-PROCEDURE NO-ERROR.
     1997   END.
     1998   ON CHOOSE OF MENU-ITEM m_graph
     1999   DO:
     2000     IF NOT AVAILABLE X_rule-by-call THEN RETURN NO-APPLY.
     2001     ASSIGN
     2002     rule-display-option = "graph".
     2003     RUN proc-display-rule IN THIS-PROCEDURE (  INPUT rule-display-option
     2004                                                 ,INPUT X_rule-by-call.codex_id
     2005                                                 ,INPUT X_rule-by-call.ruleset_id
     2006                                                 ,INPUT X_rule-by-call.call_Id
     2007                                                 ,INPUT X_rule-by-call.order_id
     2008                                                 ,INPUT X_rule-by-call.rule_id) NO-ERROR.
     2009     ASSIGN
     2010     rule-display-option = "".
     2011   END.
     2012   ON CHOOSE OF MENU-ITEM m_proc_graph
     2013   DO:
     2014     IF NOT AVAILABLE buf_thbj-attr THEN RETURN NO-APPLY.
     2015     ASSIGN
     2016     rule-proc-option = "graph".
     2017     run rule-proc IN THIS-PROCEDURE ( v-uniq-key-rec, INPUT rule-proc-option) NO-ERROR.
     2018     IF ERROR-STATUS:ERROR THEN DO:
     2019         rule-proc-option = '':U.
     2020         RETURN NO-APPLY.
     2021     END.
     2022     rule-proc-option = '':U.
     2023   END.
     2024   ON CHOOSE OF MENU-ITEM m_proc_text
     2025   DO:
     2026      IF NOT AVAILABLE buf_thbj-attr THEN RETURN NO-APPLY.
     2027     ASSIGN
     2028     rule-proc-option = "text".
     2029     run rule-proc IN THIS-PROCEDURE ( INPUT v-uniq-key-rec, INPUT rule-proc-option) NO-ERROR.
     2030     IF ERROR-STATUS:ERROR THEN DO:
     2031         rule-proc-option = '':U.
     2032         RETURN NO-APPLY.
     2033     END.
     2034     rule-proc-option = '':U.
     2035   END.
     2036   ON CHOOSE OF MENU-ITEM m_text
     2037   DO:
     2038   IF NOT AVAILABLE X_rule-by-call THEN RETURN NO-APPLY.
     2039     ASSIGN
     2040     rule-display-option = "text".
     2041     RUN proc-display-rule IN THIS-PROCEDURE (  INPUT rule-display-option
     2042                                               ,INPUT X_rule-by-call.codex_id
     2043                                               ,INPUT X_rule-by-call.ruleset_id
     2044                                               ,INPUT X_rule-by-call.call_Id
     2045                                               ,INPUT X_rule-by-call.order_id
     2046                                               ,INPUT X_rule-by-call.rule_id) NO-ERROR.
     2047     ASSIGN
     2048     rule-display-option = "".
     2049   END.
     2050   ON VALUE-CHANGED OF rs-active IN FRAME Dialog-Frame
     2051   DO:
     2052     ASSIGN
     2053     rs-active .
     2054     RUN openbr IN THIS-PROCEDURE ( INPUT rs-active).
     2055   END.
     2056   ON VALUE-CHANGED OF Rs-algo-profile IN FRAME Dialog-Frame
     2057   DO:
     2058     ASSIGN
     2059     rs-algo-profile.
     2060     CASE rs-algo-profile:
     2061       WHEN 'rule-by-call':U THEN DO:
     2062         HIDE
     2063         br-profile
     2064         IN FRAME Dialog-Frame.
     2065         .
     2066         DISPLAY
     2067         rs-algo-types
     2068         br-rule-by-call
     2069         b-rule
     2070         b-ruleset
     2071         WITH FRAME Dialog-Frame.
     2072       END.
     2073       WHEN 'rp-by-call':U THEN DO:
     2074           HIDE
     2075           br-rule-by-call
     2076           rs-algo-types
     2077           b-rule
     2078           b-ruleset
     2079           IN FRAME Dialog-Frame.
     2080           DISPLAY
     2081           br-profile
     2082           WITH FRAME Dialog-Frame.
     2083       END.
     2084     END CASE.
     2085   END.
     2086   ON VALUE-CHANGED OF rs-algo-types IN FRAME Dialog-Frame
     2087   DO:
     2088     ASSIGN
     2089     rs-algo-types.
     2090     OPEN QUERY br-rule-by-call FOR EACH X_rule-by-call       WHERE X_rule-by-call.call_id = v-uniq-key-rec,            FIRST X_rule-profile NO-LOCK WHERE          X_rule-profile.profile_id = X_rule-by-call.profile_id      AND (rs-algo-types = 1 OR          X_rule-profile.is_dynamic = yes) BY X_rule-by-call.codex_id BY X_rule-by-call.ruleset_id BY X_rule-by-call.order_id INDEXED-REPOSITION.
     2091     APPLY "VALUE-CHANGED" TO br-rule-by-call IN FRAME Dialog-Frame.
     2092   END.
     2093   DEFINE MENU MENU-b-add .
     2094   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2095   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2096   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2097   on help of frame Dialog-Frame
     2098   do:
     2099     run gbl/app_help.p
     2100       (input this-procedure :file-name
     2101       ,input ''
     2102       ,input ?
     2103       ) no-error.
     2104     if error-status :error then do:
     2105       message
     2106         "Ошибка при вызове помощи"
     2107         error-status :get-message(1)
     2108         view-as alert-box .
     2109     end.
     2110   end.
     2111   run minbtn-set in this-procedure .
     2112   on choose of b-help in frame Dialog-Frame
     2113   do:
     2114     apply "help":u to frame Dialog-Frame .
     2115   end.
     2116   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2117   procedure minbtn-set :
     2118       do
     2119           on error undo, return error return-value
     2120           :
     2121           define variable ii              as integer       no-undo .
     2122           define variable fh              as widget-handle no-undo .
     2123           define variable hh              as widget-handle no-undo .
     2124           define variable v-h             as handle        extent 4 no-undo .
     2125           define variable v-name-button   as character     no-undo .
     2126           define variable v-help-old-x    as decimal       no-undo .
     2127           define variable v-help-old-y    as decimal       no-undo .
     2128           define variable v-help-old-size as decimal       no-undo .
     2129           define variable v-frame-width   as decimal       no-undo .
     2130           define variable jj              as integer       no-undo .
     2131           do
     2132               on error undo, return error
     2133               :
     2134               assign
     2135                   v-frame-width = frame Dialog-Frame:width - 0.3
     2136                   fh            = frame Dialog-Frame:first-child
     2137                   hh            = fh:first-child
     2138                   ii            = 1
     2139                   .
     2140               do while valid-handle(hh):
     2141                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2142                   do:
     2143                       case lc(hh:name) :
     2144                           when "b-help" then
     2145                               do:
     2146                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2147                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2148                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2149                                   hh:TOOLTIP = "Помощь" .
     2150                                   v-help-old-x = hh:column .
     2151                                   v-help-old-y = hh:row    .
     2152                                   v-help-old-size = hh:width .
     2153                                   hh:width-chars = 2.5 .
     2154                               end.
     2155                           when "b-print" then
     2156                               do:
     2157                                   hh:load-image("cmp/b-print.bmp":u) .
     2158                                   hh:TOOLTIP = "Печать" .
     2159                                   v-h[ii] = hh:handle .
     2160                                   ii = ii + 1 .
     2161                                   hh:width-chars = 3 .
     2162                               end.
     2163                           when "b-history" or
     2164                           when "b-hist" then
     2165                               do:
     2166                                   hh:load-image("cmp/b-hist.bmp":u) .
     2167                                   hh:TOOLTIP = "История" .
     2168                                   v-h[ii] = hh:handle .
     2169                                   ii = ii + 1 .
     2170                                   hh:width-chars = 3 .
     2171                               end.
     2172                           when "b-sch" then
     2173                               do:
     2174                                   hh:load-image("cmp/b-sch.bmp":u) .
     2175                                   hh:TOOLTIP = "Установка Фильтра" .
     2176                                   v-h[ii] = hh:handle .
     2177                                   ii = ii + 1 .
     2178                                   hh:width-chars = 3 .
     2179                               end.
     2180                           when "b-hist-user" then
     2181                               do:
     2182                                   hh:load-image("cmp/b-hist.bmp":u) .
     2183                                   hh:TOOLTIP = "История пользователя" .
     2184                                   ii = ii + 1 .
     2185                               end.
     2186                       end case.
     2187                   end.
     2188                   hh = hh:next-sibling.
     2189               end.
     2190               b-help:column = v-frame-width - b-help:width-chars.
     2191               jj = 0.
     2192               repeat ii = 4 to 1 by -1 :
     2193                   if valid-handle (v-h[ii] ) then
     2194                   do:
     2195                       jj  = jj + 1 .
     2196                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2197                       v-h[ii]:row    = v-help-old-y .
     2198                   end.
     2199               end.
     2200           end.
     2201       end.
     2202   end procedure.
     2203   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2204   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2205   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2206   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2207   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2208   define variable v-diasize-current-frame-height as decimal   no-undo .
     2209   define variable v-diasize-change-size          as logical   no-undo .
     2210   define variable v-diasize-resize-button        as handle    no-undo .
     2211   define variable v-diasize-wndmax               as logical   no-undo .
     2212   define variable v-diasize-wndstore             as logical   no-undo .
     2213   define variable v-diasize-proc-name            as character no-undo .
     2214   define variable v-diasize-browse-handle        as handle    no-undo .
     2215   define variable v-diasize-browse-number        as integer   no-undo .
     2216   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2217   define temp-table temp-diasize-handle no-undo
     2218     field handle-value  as handle
     2219     field save-position as decimal
     2220     index xpk is primary unique handle-value
     2221     .
     2222   define temp-table temp-browse-handle no-undo
     2223     field browse-type   as character
     2224     field browse-number as integer
     2225     field browse-handle as handle
     2226     field original-size as decimal
     2227     index xpk is primary unique browse-type browse-number
     2228     index xie browse-type browse-handle
     2229   .
     2230   procedure diasize_change-height :
     2231     define input  parameter p-change-value  as decimal   no-undo .
     2232     define input  parameter p-move-resize   as logical   no-undo .
     2233     define variable v-field-group-handle    as handle    no-undo .
     2234     define variable v-object-handle         as handle    no-undo .
     2235     define variable v-frame-height          as decimal   no-undo .
     2236     define variable v-frame-virtual-height  as decimal   no-undo .
     2237     define variable v-browse-height         as decimal   no-undo .
     2238     define variable v-window-height         as decimal   no-undo .
     2239     define variable v-window-virtual-height as decimal   no-undo .
     2240     define variable v-change-sign           as integer   no-undo .
     2241     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2242     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2243     if p-change-value > 0
     2244     then do:
     2245       if frame Dialog-Frame :height + p-change-value
     2246           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2247       then do:
     2248         assign
     2249           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2250                           - (frame Dialog-Frame :height-chars)
     2251         .
     2252         if p-change-value <= 0
     2253         then do:
