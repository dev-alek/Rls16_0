      623   procedure proc-alt-shift-f2:
      624     if not ibs.th.gbl.gbl-var:rcode
      625   then
      626     run gbl\inidebug.p .
      627   end.
      628   procedure proc-alt-shift-f3:
      629     run gbl/prvssinf.p
      630       ( input this-procedure
      631       ) .
      632   end.
      633   define variable v-inform-launched as logical no-undo initial false .
      634   procedure proc-alt-shift-f4:
      635     define variable v-action as character no-undo .
      636     if v-inform-launched = false then do:
      637       assign
      638         v-inform-launched = true
      639       .
      640       run gbl/d-inform.w
      641         (  input self
      642         ,  input this-procedure
      643         , output v-action
      644         ) no-error .
      645       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      646       assign
      647         v-inform-launched = false
      648       .
      649     end.
      650   end.
      651   procedure proc-alt-f1:
      652     run gbl/corrhelp.p
      653       (input this-procedure
      654       ) .
      655   end .
      656   on alt-shift-f2 anywhere do:
      657     run proc-alt-shift-f2.
      658   end.
      659   on alt-shift-f3 anywhere do:
      660     run proc-alt-shift-f3 in this-procedure .
      661   end.
      662   on alt-shift-f4 anywhere do:
      663     run proc-alt-shift-f4 in this-procedure.
      664   end.
      665   on alt-f1 anywhere do:
      666     run proc-alt-f1 in this-procedure .
      667   end.
      668   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      669     define variable v-cntxt-db-num        as integer   no-undo .
      670     define variable v-cntxt-userid        as character no-undo .
      671     define variable v-cntxt-level         as character no-undo .
      672     define variable v-cntxt-host-code-obj as integer   no-undo .
      673     define variable v-cntxt-obj-type      as character no-undo .
      674     define variable v-cntxt-obj-code      as integer   no-undo .
      675     define variable v-cntxt-db-num-obj    as integer   no-undo .
      676     define variable v-cntxt-is-admin      as logical   no-undo .
      677   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      678   procedure gen-key-rec :
      679     define input  parameter p-tbl-name    as character no-undo.
      680     define input  parameter p-bh_tbl-name as handle    no-undo.
      681     define output parameter p-key-rec     as character no-undo.
      682     do
      683     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      684     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      685     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      686     :
      687       define variable fh               as handle    no-undo .
      688       define variable v-ok             as logical   no-undo .
      689       define variable v-inform         as character no-undo .
      690       define variable v-ind            as integer   no-undo .
      691       define variable v-idx-field-qnty as integer   no-undo .
      692       if p-tbl-name = ?
      693         or p-tbl-name = "":U
      694       then do:
      695         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info4 ).
      696       end.
      697       if not p-bh_tbl-name:available then do:
      698         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info4, p-tbl-name ).
      699       end.
      700       assign
      701         p-key-rec = p-tbl-name
      702         v-inform  = p-bh_tbl-name:index-information(1)
      703         v-ind     = 2
      704       .
      705       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      706       on error undo, return error
      707       :
      708         assign
      709           v-inform = p-bh_tbl-name:index-information( v-ind )
      710           v-ind    = v-ind + 1
      711         .
      712       end.
      713       if v-inform = ?
      714         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      715         or entry( 3, v-inform, ",":U ) <> "1":U
      716       then do:
      717         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, p-tbl-name ).
      718       end.
      719       else do:
      720         assign
      721           v-idx-field-qnty = num-entries( v-inform ) - 4
      722         .
      723         if v-idx-field-qnty < 2 then do:
      724           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, p-tbl-name ).
      725         end.
      726         do v-ind = 1 to v-idx-field-qnty by 2
      727         on error undo, return error
      728         :
      729           assign
      730             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      731             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      732           .
      733         end.
      734       end.
      735       if p-key-rec = ? then do:
      736         assign
      737           p-key-rec = "":U
      738         .
      739         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info4, p-tbl-name ).
      740       end.
      741     end.
      742     return.
      743   end procedure.
      744   procedure gen-where-keyr-tab :
      745     define input  parameter i-tableSerach as character no-undo.
      746     define input  parameter i-tablekey   as character  no-undo.
      747     define input  parameter p-key-rec    as character  no-undo.
      748     define input  parameter p-key-handle as handle     no-undo .
      749     define input  parameter p-db-name    as character  no-undo .
      750     define input  parameter p-tt-handle  as handle     no-undo .
      751     define output parameter o-Where      as character  no-undo.
      752     do
      753     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      754     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      755     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      756     :
      757       define variable v-full-tbl-name  as character no-undo .
      758       define variable bh_tbl-name      as handle    no-undo .
      759       define variable fh_key           as handle    no-undo .
      760       define variable fh_search        as handle    no-undo .
      761       define variable v-field-num      as integer   no-undo .
      762       define variable v-count-fld      as integer   no-undo .
      763       define variable v-inform         as character no-undo .
      764       define variable v-ind            as integer   no-undo .
      765       define variable v-idx-field-qnty as integer   no-undo .
      766       define variable v-field-name     as character no-undo .
      767       define variable v-field-val      as character no-undo .
      768       define variable v-word-link      as character no-undo .
      769       define variable vTable           as character no-undo.
      770       define variable bh_tbl-key       as handle    no-undo .
      771       assign
      772         p-key-rec = trim( p-key-rec )
      773       .
      774       if p-key-handle <> ? then do:
      775         if not valid-handle(p-key-handle)
      776            or p-key-handle:type <> "buffer"
      777         then do:
      778           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info4 ).
      779         end.
      780         if num-entries( p-key-rec, chr(3) ) > 1
      781           or p-key-rec = ?
      782           or p-key-rec = "":U
      783         then do:
      784           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info4, p-key-rec ).
      785         end.
      786       end.
      787       else do:
      788         if p-key-rec = ?
      789           or p-key-rec = "":U
      790         then do:
      791           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
      792         end.
      793       end.
      794       assign
      795         vTable = entry( 1 , p-key-rec, chr(3) )
      796       .
      797       if p-tt-handle <> ?
      798         and ( not valid-handle(p-tt-handle)
      799               or p-tt-handle:type <> "buffer"
      800             )
      801       then do:
      802         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info4, vTable, chr(10) ).
      803       end.
      804       if p-tt-handle = ? then do:
      805         assign
      806           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      807         .
      808         create buffer bh_tbl-name for table v-full-tbl-name .
      809       end.
      810       else do:
      811         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      812       end.
      813       assign
      814         v-inform = bh_tbl-name:index-information(1)
      815         v-ind    = 2
      816       .
      817       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      818       on error undo, return error
      819       :
      820         assign
      821           v-inform = bh_tbl-name:index-information( v-ind )
      822           v-ind    = v-ind + 1
      823         .
      824       end.
      825       if v-inform = ?
      826         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      827         or entry( 3, v-inform, ",":U ) <> "1":U
      828       then do:
      829         delete object bh_tbl-name no-error.
      830         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info4, vTable ).
      831       end.
      832       assign
      833         v-idx-field-qnty = num-entries( v-inform ) - 4
      834       .
      835       if v-idx-field-qnty < 2 then do:
      836         delete object bh_tbl-name no-error.
      837         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, vTable ).
      838       end.
      839       assign
      840         o-where     = "where":U
      841         v-word-link = "":U
      842         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      843         v-count-fld = 0
      844       .
      845       if i-tablekey ne "" and i-tablekey ne ?
      846       then do:
      847         assign
      848           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      849         .
      850         create buffer bh_tbl-key for table v-full-tbl-name .
      851       end.
      852       if i-tableSerach ne "" and i-tableSerach ne ?
      853       then do:
      854         delete object bh_tbl-name no-error.
      855         assign
      856           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      857         .
      858         create buffer bh_tbl-name for table v-full-tbl-name .
      859       end.
      860       block_where:
      861       do v-ind = 1 to v-idx-field-qnty by 2
      862       on error undo, return error
      863       :
      864         assign
      865           v-count-fld = v-count-fld + 1
      866         .
      867         if p-key-handle = ?
      868           and v-count-fld > v-field-num
      869         then do:
      870           leave block_where.
      871         end.
      872         define variable VfieldKeyTable as handle no-undo.
      873         assign
      874           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      875           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      876         .
      877         if     bh_tbl-key ne ?
      878         then do:
      879            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      880            if VfieldKeyTable eq ?
      881            then next block_where.
      882         end.
      883         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
      884         then
      885            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
      886         else
      887            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
      888         if p-key-handle = ? then do:
      889           assign
      890             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
      891           .
      892         end.
      893         else do:
      894           assign
      895             fh_key = p-key-handle:buffer-field( v-field-name )
      896           .
      897           if fh_key = ?
      898             or not valid-handle( fh_key )
      899           then do:
      900             delete object bh_tbl-name.
      901             if     bh_tbl-key ne ?
      902             then
      903                delete object bh_tbl-key.
      904             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info4, p-key-handle:name, v-field-name ).
      905           end.
      906           assign
      907             v-field-val = fh_key:buffer-value
      908           .
      909         end.
      910         if fh_search:data-type ="character":U then do:
      911           assign
      912             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
      913             v-field-val = replace( v-field-val, '"':U, '~~"':U )
      914             v-field-val = replace( v-field-val, "'":U, "~~'":U )
      915             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
      916             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
      917             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
      918             v-field-val = replace( v-field-val, chr(10), '~~n':U )
      919             v-field-val = replace( v-field-val, chr(9), '~~t':U )
      920             v-field-val = replace( v-field-val, chr(13), '~~r':U )
      921             v-field-val = replace( v-field-val, chr(27), '~~E':U )
      922             v-field-val = replace( v-field-val, chr(8), '~~b':U )
      923             v-field-val = replace( v-field-val, chr(12), '~~f':U )
      924             v-field-val = substitute( '"&1"', v-field-val )
      925           .
      926         end.
      927         assign
      928           o-where = substitute( "&1 &2", o-where, v-field-val )
      929         .
      930         if v-word-link = "":U then do:
      931           assign
      932             v-word-link = "and":U
      933           .
      934         end.
      935       end.
      936       delete object bh_tbl-name.
      937       if     bh_tbl-key ne ?
      938       then
      939          delete object bh_tbl-key.
      940       if p-key-handle = ?
      941         and v-count-fld <> v-field-num
      942       then do:
      943         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info4, vTable ).
      944       end.
      945     end.
      946   end procedure.
      947   procedure gen-hn-keyr-tab :
      948     define input  parameter i-tableSerach as character no-undo.
      949     define input  parameter i-tablekey   as character no-undo.
      950     define input  parameter p-key-rec    as character no-undo.
      951     define input  parameter p-key-handle as handle    no-undo .
      952     define input  parameter p-db-name    as character no-undo .
      953     define input  parameter p-tt-handle  as handle    no-undo .
      954     define input  parameter p-stts-lock  as integer   no-undo .
      955     define output parameter o-hn         as handle    no-undo.
      956     define variable v-full-tbl-name as character no-undo.
      957     define variable v-where         as character no-undo.
      958     define variable bh_tbl-name     as handle    no-undo.
      959     define variable vTable          as character no-undo.
      960     do
      961     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      962     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      963     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
      964         run gen-where-keyr-tab(i-tableSerach,
      965                                i-tablekey,
      966                                p-key-rec,
      967                                p-key-handle,
      968                                p-db-name,
      969                                p-tt-handle,
      970                                output v-where).
      971         if i-tableSerach ne "" and i-tableSerach ne ?
      972         then do:
      973            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
      974            create buffer bh_tbl-name for table v-full-tbl-name .
      975         end.
      976         else do:
      977            if p-tt-handle = ? then do:
      978               assign
      979                  vTable = entry( 1 , p-key-rec, chr(3) )
      980               .
      981               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
      982               create buffer bh_tbl-name for table v-full-tbl-name .
      983            end.
      984            else do:
      985               create buffer bh_tbl-name for table p-tt-handle:table-handle .
      986            end.
      987         end.
      988         if p-tt-handle = ? then do:
      989            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
      990         end.
      991         else do:
      992            bh_tbl-name:find-first( v-where ) no-error .
      993         end.
      994         o-hn = bh_tbl-name.
      995      end.
      996   end procedure.
      997   procedure gen-hn-keyr :
      998     define input  parameter p-key-rec    as character no-undo.
      999     define input  parameter p-key-handle as handle    no-undo .
     1000     define input  parameter p-db-name    as character no-undo .
     1001     define input  parameter p-tt-handle  as handle    no-undo .
     1002     define input  parameter p-stts-lock  as integer   no-undo .
     1003     define output parameter o-hn         as handle    no-undo.
     1004     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1005   end.
     1006   procedure gen-row-keyr :
     1007     define input  parameter p-key-rec    as character no-undo.
     1008     define input  parameter p-key-handle as handle    no-undo .
     1009     define input  parameter p-db-name    as character no-undo .
     1010     define input  parameter p-tt-handle  as handle    no-undo .
     1011     define input  parameter p-stts-lock  as integer   no-undo .
     1012     define output parameter p-tbl-row    as rowid     no-undo.
     1013     define output parameter p-tbl-name   as character no-undo.
     1014     define variable vHn as handle no-undo.
     1015       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1016       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1017       p-tbl-name =  vHn:table.
     1018       delete object vHn no-error.
     1019     if p-tbl-row = ? then do:
     1020       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info4, p-tbl-name, p-key-rec ).
     1021     end.
     1022     else do:
     1023       return.
     1024     end.
     1025   end procedure.
     1026   procedure gen-key-fv :
     1027     define input  parameter p-key-rec    as character no-undo .
     1028     define output parameter p-field-list as character no-undo .
     1029     define output parameter p-value-list as character no-undo.
     1030     do
     1031     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1032     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1033     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1034     :
     1035       define variable v-full-tbl-name  as character no-undo .
     1036       define variable bh_tbl-name      as handle    no-undo .
     1037       define variable v-tbl-name       as character no-undo .
     1038       define variable v-field-num      as integer   no-undo .
     1039       define variable v-count-fld      as integer   no-undo .
     1040       define variable v-inform         as character no-undo .
     1041       define variable v-ind            as integer   no-undo .
     1042       define variable v-idx-field-qnty as integer   no-undo .
     1043       define variable v-delim-key      as character no-undo .
     1044       if p-key-rec = ?
     1045         or p-key-rec = "":U
     1046       then do:
     1047         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info4 ).
     1048       end.
     1049       assign
     1050         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1051         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1052       .
     1053       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1054       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info4 ).
     1055       assign
     1056         v-inform = bh_tbl-name:index-information(1)
     1057         v-ind    = 2
     1058       .
     1059       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1060       on error undo, return error
     1061       :
     1062         assign
     1063           v-inform = bh_tbl-name:index-information( v-ind )
     1064           v-ind    = v-ind + 1
     1065         .
     1066       end.
     1067       if v-inform = ?
     1068         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1069         or entry( 3, v-inform, ",":U ) <> "1":U
     1070       then do:
     1071         delete object bh_tbl-name no-error.
     1072         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
     1073       end.
     1074       assign
     1075         v-idx-field-qnty = num-entries( v-inform ) - 4
     1076       .
     1077       if v-idx-field-qnty < 2 then do:
     1078         delete object bh_tbl-name no-error.
     1079         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
     1080       end.
     1081       assign
     1082         p-field-list = "":U
     1083         p-value-list = "":U
     1084         v-delim-key  = "":U
     1085         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1086         v-count-fld  = 0
     1087       .
     1088       block_where:
     1089       do v-ind = 1 to v-idx-field-qnty by 2
     1090       on error undo, return error
     1091       :
     1092         assign
     1093           v-count-fld = v-count-fld + 1
     1094         .
     1095         if v-count-fld > v-field-num then do:
     1096           leave block_where.
     1097         end.
     1098         assign
     1099           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1100           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1101         .
     1102         if v-ind = 1 then do:
     1103           assign
     1104             v-delim-key = chr(3)
     1105           .
     1106         end.
     1107       end.
     1108       delete object bh_tbl-name.
     1109       if v-count-fld <> v-field-num then do:
     1110         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info4, v-tbl-name ).
     1111       end.
     1112     end.
     1113   end procedure.
     1114   procedure gen-key-field :
     1115     define input  parameter p-table      as character no-undo .
     1116     define output parameter p-field-list as character no-undo .
     1117     do
     1118     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1119     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1120     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1121     :
     1122       define variable v-full-tbl-name  as character no-undo .
     1123       define variable bh_tbl-name      as handle    no-undo .
     1124       define variable v-tbl-name       as character no-undo .
     1125       define variable v-field-num      as integer   no-undo .
     1126       define variable v-count-fld      as integer   no-undo .
     1127       define variable v-inform         as character no-undo .
     1128       define variable v-ind            as integer   no-undo .
     1129       define variable v-idx-field-qnty as integer   no-undo .
     1130       define variable v-delim-key      as character no-undo .
     1131       if p-table = ?
     1132         or p-table = "":U
     1133       then do:
     1134         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info4 ).
     1135       end.
     1136       assign
     1137         v-tbl-name      = p-table
     1138         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1139       .
     1140       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1141       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info4 ).
     1142       assign
     1143         v-inform = bh_tbl-name:index-information(1)
     1144         v-ind    = 2
     1145       .
     1146       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1147       on error undo, return error
     1148       :
     1149         assign
     1150           v-inform = bh_tbl-name:index-information( v-ind )
     1151           v-ind    = v-ind + 1
     1152         .
     1153       end.
     1154       if v-inform = ?
     1155         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1156         or entry( 3, v-inform, ",":U ) <> "1":U
     1157       then do:
     1158         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info4, v-tbl-name ).
     1159       end.
     1160       assign
     1161         v-idx-field-qnty = num-entries( v-inform ) - 4
     1162       .
     1163       if v-idx-field-qnty < 2 then do:
     1164         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info4, v-inform, v-tbl-name ).
     1165       end.
     1166       assign
     1167         p-field-list = "":U
     1168         v-delim-key  = "":U
     1169         v-count-fld  = 0
     1170       .
     1171       block_where:
     1172       do v-ind = 1 to v-idx-field-qnty by 2
     1173       on error undo, return error
     1174       :
     1175         assign
     1176           v-count-fld = v-count-fld + 1
     1177         .
     1178         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1179         if v-ind = 1 then do:
     1180           assign
     1181             v-delim-key = chr(3)
     1182           .
     1183         end.
     1184       end.
     1185       delete object bh_tbl-name.
     1186     end.
     1187   end procedure.
     1188   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1189   def var vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1190   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1191   FUNCTION get-region RETURNS CHARACTER
     1192     ( input parhost-code as integer, input parobj-type as character, input parobj-code as integer ) :
     1193     define variable par-region as character no-undo.
     1194     if parhost-code = 0 and
     1195          parobj-type = "":U and
     1196          parobj-code = 0 then do:
     1197          par-region = "Глобально".
     1198          return par-region.
     1199       end.
     1200       if parobj-type = 'орг':U then do:
     1201          par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parhost-code).
     1202          return par-region.
     1203       end.
     1204       if parobj-type = 'регион':U
     1205       then do:
     1206          par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1207          return par-region.
     1208       end.
     1209       par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1210       return par-region.
     1211   END FUNCTION.
     1212   FUNCTION get-objregion RETURNS CHARACTER
     1213     (  input parobj-type as character, input parobj-code as integer ) :
     1214     define variable par-region as character no-undo.
     1215     if  parobj-type = "":U and
     1216         parobj-code = 0
     1217     then do:
     1218        par-region = "Глобально".
     1219     end.
     1220     else if parobj-type = 'орг':U
     1221     then do:
     1222        par-region = fill(chr(32), 2) + "Фирма" + chr(32) + string(parobj-code).
     1223     end.
     1224     else if parobj-type = 'регион':U
     1225     then do:
     1226        par-region = fill(chr(32), 2) + "Регион" + chr(32) + string(parobj-code).
     1227     end.
     1228     else
     1229        par-region = fill(chr(32), 4) + parobj-type + chr(32) + string(parobj-code).
     1230     return par-region.
     1231   END FUNCTION.
     1232   FUNCTION calldscr returns character ( input p-call-id as character):
     1233   define variable v-descr as character no-undo .
     1234   define variable v-field-list as character no-undo .
     1235   define variable v-value-list as character no-undo.
     1236   define variable v-prop-label as character no-undo .
     1237   define variable v-node-label as character no-undo .
     1238   define variable v-dt-code as integer no-undo .
     1239   define variable v-host-code as integer no-undo .
     1240   define variable v-obj-type as character no-undo .
     1241   define variable v-obj-code as integer no-undo .
     1242   define variable v-label as character no-undo .
     1243   define variable v-node-code as integer no-undo .
     1244   define buffer buf_prop-head for ub.prop-head.
     1245   define buffer buf_prop-ref for ub.prop-ref.
     1246   define buffer buf_prop-map for ub.prop-map.
     1247   run gen-key-fv in this-procedure ( input p-call-id
     1248                                     ,output v-field-list
     1249                                     ,output v-value-list) no-error .
     1250   if error-status:error then return p-call-id.
     1251   CASE entry(1, p-call-id, chr(3)):
     1252     when 'dis-card-type':U then do:
     1253       v-descr = substitute("Тип ДК: эмитент &1 тип: &2"
     1254                            ,integer(entry(lookup("emitent-host-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1255                            ,entry(lookup("type", v-field-list, chr(3)), v-value-list, chr(3))
     1256                            ).
     1257     end.
     1258     when 'dis-card':U then do:
     1259       v-descr = substitute("ДК: № &1"
     1260                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1261                            ).
     1262     end.
     1263     when 'dis-card-property':U then do:
     1264       v-dt-code = integer(entry(lookup("dt-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1265       v-node-code = integer(entry(lookup("node-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1266       v-host-code = integer(entry(lookup("host-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1267       v-obj-type = entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3)) .
     1268       v-obj-code = integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) ).
     1269       find first buf_prop-ref no-lock where
     1270                 buf_prop-ref.dt-code = v-dt-code no-error .
     1271       if available buf_prop-ref then do:
     1272         find first buf_prop-head no-lock where
     1273                   buf_prop-head.dtm-code = buf_prop-ref.dtm-code no-error .
     1274         v-prop-label = buf_prop-head.prop-label.
     1275         find first buf_prop-map no-lock where
     1276                   buf_prop-map.dtm-code = buf_prop-ref.dtm-code
     1277               and buf_prop-map.node-code = v-node-code no-error .
     1278         if available buf_prop-map then do:
     1279           v-label = buf_prop-map.node-label.
     1280         end.
     1281       end.
     1282       v-descr = substitute("ДК: № &1 &2:&3 &4"
     1283                            ,entry(lookup("d-card", v-field-list, chr(3)), v-value-list, chr(3))
     1284                            ,v-prop-label
     1285                            ,v-label
     1286                            ,get-region(v-host-code, v-obj-type, v-obj-code)
     1287                            ).
     1288     end.
     1289     when 'clients':U then do:
     1290       v-descr = substitute("&1&2"
     1291                            ,entry(lookup("obj-type", v-field-list, chr(3)), v-value-list, chr(3))
     1292                            ,integer(entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3)) )
     1293                            ).
     1294     end.
     1295     when 'ext-system':U then do:
     1296       v-descr = substitute("Внешняя система &1"
     1297                            ,integer(entry(lookup("esys-id", v-field-list, chr(3)), v-value-list, chr(3)))
     1298                            ).
     1299     end.
     1300     WHEN 'thbj-attr':U then do:
     1301       if entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum':U
     1302       or entry(lookup("upper-prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rum_obj':U
     1303       then do:
     1304         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'goods':U then do:
     1305           v-descr = "Операции с товарами".
     1306         end.
     1307         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'clients':U then do:
     1308           v-descr = "Операции с клиентами".
     1309         end.
     1310         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'gds-grp':U then do:
     1311           v-descr = "Операции с группами товаров".
     1312         end.
     1313         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'cli-grp':U then do:
     1314           v-descr = "Операции с группами клиентов".
     1315         end.
     1316         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th':U then do:
     1317           v-descr = "Операции с чеками на POS IBS-TH".
     1318         end.
     1319         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'chk-doc_ibs-th-mob':U then do:
     1320           v-descr = "Операции с чеками на POS IBS-TH-MOB".
     1321         end.
     1322         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'edoc':U then do:
     1323           v-descr = "Операции в системе электронного документооборота".
     1324         end.
     1325         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'thref':U then do:
     1326           v-descr = "Операции со справочниками".
     1327         end.
     1328         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'pdf':U then do:
     1329           v-descr = "Операции с ДНЦ и переоценками".
     1330         end.
     1331         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'rep':U then do:
     1332           v-descr = "Отчеты".
     1333         end.
     1334         if entry(lookup("prop-code", v-field-list, chr(3)), v-value-list, chr(3)) = 'ord':U then do:
     1335           v-descr = "Операции с заказами".
     1336         end.
     1337       end.
     1338     end.
     1339     when 'cash-desk':U then do:
     1340       v-descr = substitute("БД &1 Маг &2 Касса № &4 &3"
     1341                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1342                            ,entry(lookup("obj-code", v-field-list, chr(3)), v-value-list, chr(3))
     1343                            ,entry(lookup("cash-num", v-field-list, chr(3)), v-value-list, chr(3))
     1344                            ,entry(lookup("pos-type", v-field-list, chr(3)), v-value-list, chr(3))
     1345                            ).
     1346     end.
     1347     when 'ext-file':U then do:
     1348       v-descr = substitute("БД &1 Файл № &3 (из БД &2)"
     1349                            ,entry(lookup("db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1350                            ,entry(lookup("from-db-num", v-field-list, chr(3)), v-value-list, chr(3))
     1351                            ,entry(lookup("file-num", v-field-list, chr(3)), v-value-list, chr(3))
     1352                            ).
     1353     end.
     1354   end case.
     1355   return v-descr.
     1356   end function.
     1357   procedure rcpscont_get-rule-on-off :
     1358   define input parameter p-codex-id as integer no-undo .
     1359   define input parameter p-ruleset-id as integer no-undo .
     1360   define input parameter p-rule-id as integer no-undo .
     1361   define input parameter p-profile-id as integer no-undo .
     1362   define input parameter p-once-more as integer no-undo .
     1363   define output parameter p-on-off as logical no-undo .
     1364   define buffer buf_tt0-rule-by-call for ub.rule-by-call.
     1365   find first buf_tt0-rule-by-call where
     1366            buf_tt0-rule-by-call.codex_id = p-codex-id
     1367        and buf_tt0-rule-by-call.ruleset_id = p-ruleset-id
     1368        and buf_tt0-rule-by-call.profile_id = p-profile-id
     1369        and buf_tt0-rule-by-call.once-more = p-once-more
     1370        and buf_tt0-rule-by-call.rule_id = p-rule-id
     1371        no-error .
     1372   if available buf_tt0-rule-by-call then do:
     1373      p-on-off = buf_tt0-rule-by-call.can-calc.
     1374   end.
     1375   end procedure.
     1376   procedure rcpscont_set-rule-on-off :
     1377   define input parameter p-codex-id as integer no-undo .
     1378   define input parameter p-ruleset-id as integer no-undo .
     1379   define input parameter p-rule-id as integer no-undo .
     1380   define input parameter p-profile-id as integer no-undo .
     1381   define input parameter p-once-more as integer no-undo .
     1382   define input parameter p-on-off as logical no-undo .
     1383   define variable v-h as handle no-undo .
     1384   define buffer buf_tt0-rule-by-call for ub.rule-by-call.
     1385   v-h = buffer ub.rule-by-call:handle.
     1386   if v-h:table <> ''
     1387   and v-h:table <> ? then do:
     1388     find first buf_tt0-rule-by-call where
     1389             buf_tt0-rule-by-call.codex_id = p-codex-id
     1390         and buf_tt0-rule-by-call.ruleset_id = p-ruleset-id
     1391         and buf_tt0-rule-by-call.profile_id = p-profile-id
     1392         and buf_tt0-rule-by-call.once-more = p-once-more
     1393         and buf_tt0-rule-by-call.rule_id = p-rule-id   no-error .
     1394     if not available buf_tt0-rule-by-call then do:
     1395       undo, return error .
     1396     end.
     1397     buf_tt0-rule-by-call.can-calc = p-on-off .
     1398     release buf_tt0-rule-by-call.
     1399   end.
     1400   end procedure.
     1401   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1402   define temp-table tt-attr-property  no-undo
     1403   field upper-attr-code as character
     1404   field attr-code as character
     1405   field table-name as character
     1406   field edit-menu-section-num as integer
     1407   field attr-label as character
     1408   field menu-item-handle as widget-handle
     1409   field user-can-edit as logical
     1410   field menu-name as character
     1411   field parent-handle as handle
     1412   index pi is unique primary
     1413   table-name
     1414   menu-name
     1415   upper-attr-code
     1416   attr-code
     1417   index i-section
     1418   edit-menu-section-num
     1419   .
     1420   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1421   procedure attr-pop-create-items :
     1422   define input parameter p-table-name as character no-undo .
     1423   define input parameter p-get-section-num-proc-name as character no-undo .
     1424   define input parameter p-get-attr-label-proc-name as character no-undo .
     1425   define input parameter p-attr-choose-proc-name as character no-undo .
     1426   define input parameter p-menu-handle as widget-handle no-undo .
     1427   define input parameter p-upper-attr-code as character no-undo .
     1428   define input parameter p-attr-list as character no-undo .
     1429   define variable ii as integer no-undo .
     1430   define variable V-CREATED as logical no-undo .
     1431   define variable v-tool-tip as character no-undo .
     1432   define variable v-dop as character no-undo .
     1433   define variable v-attr-item as character no-undo .
     1434   define buffer buf_tt-attr-property for tt-attr-property.
     1435     do
     1436     on error undo, return error return-value
     1437     :
     1438        do ii = 1 to num-entries (p-attr-list):
     1439          v-attr-item = entry(ii, p-attr-list) .
     1440          find first tt-attr-property where
     1441                    tt-attr-property.table-name = p-table-name
     1442                and tt-attr-property.attr-code = v-attr-item
     1443                and tt-attr-property.upper-attr-code = p-upper-attr-code
     1444                and tt-attr-property.menu-name = p-menu-handle:name  no-error .
     1445          if not available tt-attr-property then do:
     1446            create tt-attr-property.
     1447            assign
     1448            tt-attr-property.table-name = p-table-name
     1449            tt-attr-property.attr-code = v-attr-item
     1450            tt-attr-property.upper-attr-code = p-upper-attr-code
     1451            tt-attr-property.menu-name = p-menu-handle:name
     1452            .
     1453            run value ( p-get-section-num-proc-name) (
     1454                                                      input p-upper-attr-code,
     1455                                                      input tt-attr-property.attr-code
     1456                                                     ,output tt-attr-property.edit-menu-section-num ) no-error .
     1457            run value ( p-get-attr-label-proc-name ) (
     1458                                           input p-upper-attr-code,
     1459                                           input tt-attr-property.attr-code
     1460                                          ,output v-tool-tip
     1461                                          ,output tt-attr-property.attr-label
     1462                                          ,output v-dop
     1463                                         ) no-error .
     1464            release tt-attr-property.
     1465          end.
     1466        end.
     1467        for each tt-attr-property where tt-attr-property.menu-name = p-menu-handle:name
     1468        break
     1469        by  tt-attr-property.edit-menu-section-num
     1470        by  tt-attr-property.attr-label
     1471        :
     1472          if tt-attr-property.edit-menu-section-num > 0
     1473          then do:
     1474             if not valid-handle(tt-attr-property.menu-item-handle) then do:
     1475               if num-entries(tt-attr-property.attr-code, chr(4)) > 1
     1476               and entry(2, tt-attr-property.attr-code, chr(4)) <> '':U
     1477               then do:
     1478                 find first buf_tt-attr-property where
     1479                           buf_tt-attr-property.table-name = p-table-name
     1480                       and buf_tt-attr-property.menu-name = p-menu-handle:name
     1481                       and buf_tt-attr-property.upper-attr-code = p-upper-attr-code
     1482                       and buf_tt-attr-property.attr-code = entry(1, tt-attr-property.attr-code, chr(4)) no-error .
     1483                 if not available buf_tt-attr-property then do:
     1484                   create buf_tt-attr-property.
     1485                   assign
     1486                   buf_tt-attr-property.table-name = p-table-name
     1487                   buf_tt-attr-property.attr-code = entry(1, tt-attr-property.attr-code, chr(4))
     1488                   buf_tt-attr-property.upper-attr-code = p-upper-attr-code
     1489                   buf_tt-attr-property.menu-name = p-menu-handle:name
     1490                   .
     1491                   create sub-menu buf_tt-attr-property.menu-item-handle
     1492                   assign
     1493                   name = entry(1, tt-attr-property.attr-code, chr(4))  + chr(4)  + p-menu-handle:name
     1494                   parent = p-menu-handle.
     1495                 end.
     1496                 create menu-item tt-attr-property.menu-item-handle
     1497                 assign
     1498                 label = tt-attr-property.attr-label
     1499                 name = tt-attr-property.attr-code  + chr(4)  + p-menu-handle:name
     1500                 parent = buf_tt-attr-property.menu-item-handle
     1501                 triggers:
     1502                   on choose
     1503                     persistent run value(p-attr-choose-proc-name + "-2") (
     1504                                                                           input tt-attr-property.upper-attr-code,
     1505                                                                            input  entry(1, tt-attr-property.attr-code, chr(4) )
     1506                                                                           ,input entry(2, tt-attr-property.attr-code, chr(4) )
     1507                                                                             ) .
     1508                 end triggers.
     1509                 assign
     1510                 v-created = yes.
     1511               end.
     1512               else do:
     1513                 create menu-item tt-attr-property.menu-item-handle
     1514                 assign
     1515                 label = tt-attr-property.attr-label
     1516                 name = entry(1, tt-attr-property.attr-code, chr(4)) + chr(4)  + p-menu-handle:name
     1517                 parent = p-menu-handle
     1518                 triggers:
     1519                   on choose
     1520                     persistent run value(p-attr-choose-proc-name) (
     1521                                                                     input tt-attr-property.upper-attr-code,
     1522                                                                    input  entry(1, tt-attr-property.attr-code, chr(4) )) .
     1523                 end triggers.
     1524                 assign
     1525                 v-created = yes.
     1526               end.
     1527             end.
     1528             if last-of(tt-attr-property.edit-menu-section-num)
     1529               then do:
     1530               find first buf_tt-attr-property where
     1531                         buf_tt-attr-property.table-name = p-table-name
     1532                    and  buf_tt-attr-property.attr-code = substitute("&1&2&3"
     1533                                                            , p-table-name
     1534                                                            , tt-attr-property.edit-menu-section-num
     1535                                                            , p-menu-handle:name
     1536                                                            )
     1537                     and buf_tt-attr-property.menu-name = p-menu-handle:name  no-error .
     1538               if not available buf_tt-attr-property then do:
     1539                 create buf_tt-attr-property.
     1540                 assign
     1541                 buf_tt-attr-property.table-name = p-table-name
     1542                 buf_tt-attr-property.edit-menu-section-num =  - 1
     1543                 buf_tt-attr-property.menu-name = p-menu-handle:name
     1544                 buf_tt-attr-property.upper-attr-code = ''
     1545                 buf_tt-attr-property.attr-code = substitute("&1&2&3"
     1546                                                             , p-table-name
     1547                                                             , tt-attr-property.edit-menu-section-num
     1548                                                             , p-menu-handle:name
     1549                                                             )
     1550                 .
     1551                 create menu-item buf_tt-attr-property.menu-item-handle
     1552                 assign
     1553                 subtype = "rule"
     1554                 parent = p-menu-handle
     1555                 .
     1556               end.
     1557             end.
     1558          end.
     1559        end.
     1560        if not v-created then do:
     1561           run attr-pop-clean-up in this-procedure ( input p-table-name).
     1562        end.
     1563     end.
     1564   end procedure.
     1565   procedure attr-pop-clean-up :
     1566   define input parameter p-table-name as character no-undo .
     1567     for each tt-attr-property where
     1568             tt-attr-property.table-name = p-table-name
     1569       and tt-attr-property.edit-menu-section-num > 0:
     1570       if valid-handle ( tt-attr-property.menu-item-handle) then do:
     1571         delete widget tt-attr-property.menu-item-handle.
     1572       end.
     1573       delete tt-attr-property.
     1574     end.
     1575     for each tt-attr-property where
     1576              tt-attr-property.table-name = p-table-name
     1577          and tt-attr-property.edit-menu-section-num =  - 1:
     1578       if valid-handle ( tt-attr-property.menu-item-handle) then do:
     1579         delete widget tt-attr-property.menu-item-handle.
     1580       end.
     1581       delete tt-attr-property.
     1582     end.
     1583   end procedure.
     1584   define variable p-upper-code as character no-undo init 'rum':U.
     1585   define variable p-obj-upper-code as character no-undo init 'rum_obj':U.
