      527       (input  p-obj-type
      528       ,input  p-obj-code
      529       ,input  p-upper-code
      530       ,input  p-code
      531       ,input  p-value-character
      532       ,input  p-value-date
      533       ,input  p-value-decimal
      534       ,input  p-value-integer
      535       ,input  p-value-logical
