      487   procedure thbjattr_get-section :
      488   define input  parameter p-obj-type like ub.thbj-attr.obj-type   no-undo .
      489   define input  parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
      490   define input  parameter p-upper-param-code  like ub.thbj-attr.upper-prop-code  no-undo .
      491   define input  parameter p-mode as character no-undo .
      492   define input-output parameter table-handle p-tth.
      493   define output parameter p-all-found as decimal no-undo .
      494   do
      495   on error undo, return error return-value
      496   :
      497       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_get-section in g#attr-lib
      498       (input  p-obj-type
      499       ,input  p-obj-code
      500       ,input  p-upper-param-code
      501       ,input  p-mode
      502       ,input-output table-handle p-tth
      503       ,output p-all-found
      504       ) no-error .
      505     if error-status :error
      506     then do:
      507       delete object p-tth.
      508       undo, return error return-value .
      509     end.
      510     delete object p-tth.
      511   end.
      512   end procedure.
