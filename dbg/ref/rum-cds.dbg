      331   define new global shared variable g#library2 as handle no-undo .
      332   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      333   define new global shared variable g#attr-lib  as handle no-undo .
      334   define variable v-attr-lib-variable as handle no-undo .
