     3803                             )
     3804         .
     3805         assign
     3806           l-filter-open-29 = true
     3807         .
     3808       end.
     3809       if l-filter-open-29 = false then do:
     3810         message
     3811           "Ошибка при фильтрации / сортировке" skip
     3812           "Будут показаны записи без учета фильтра" skip
     3813           view-as alert-box .
     3814       end.
     3815       else do:
     3816           assign
     3817             l-query-was-opened = true
     3818           .
     3819       end.
     3820     end.
     3821     if l-filter-open-29 = false then do:
     3822       OPEN QUERY br-obj-hist FOR EACH X_c-obj-hist
     3823         where  TRUE
     3824         indexed-reposition
     3825     .
     3826         assign
     3827           l-query-was-opened = true
     3828         .
     3829     end.
     3830   end.
     3831   else do:
     3832     assign
     3833       v-doc-rec = recid( X_c-obj-hist )
     3834     .
     3835     do
     3836     on stop undo, leave
     3837     on error undo, leave
     3838     :
     3839       if query br-obj-hist:handle:get-buffer-handle(1) = (buffer X_c-obj-hist:handle) then do:
     3840         assign
     3841         parameter-2-29 = (if p-find-next then "true":u else "false":u )
     3842         parameter-4-29 =
     3843           "where ":u + " TRUE " + " ":u + where-phrase-29 + " ":u + p-find-condition + " " + ""
     3844         parameter-5-29 = ""
     3845       .
     3846         run fltopend_fltfindd in this-procedure  (
     3847                             input this-procedure:handle
     3848                             ,input query br-obj-hist:handle
     3849                             ,input rowid(X_c-obj-hist)
     3850                             ,input logical(parameter-2-29)
     3851                             ,input no-lock
     3852                             ,input (buffer X_c-obj-hist:handle)
     3853                             ,input parameter-4-29
     3854                             ,input parameter-5-29
     3855                             ) no-error.
     3856         .
     3857         assign
     3858           v-doc-rec = integer(return-value)
     3859           v-fltopend-rowid[1] = ?
     3860         .
     3861       end.
     3862       else do:
     3863         assign
     3864         parameter-2-29 = (if p-find-next then "true":u else "false":u )
     3865         parameter-3-29 =  "FOR EACH X_c-obj-hist"
     3866         parameter-4-29 =
     3867           (
     3868             if (" TRUE " + " " + where-phrase-29) <> ""
     3869             then " TRUE " + " " + where-phrase-29
     3870             else "true"
     3871           )
     3872         parameter-5-29 = (" " + "" + " " + "" + " " + p-find-condition)
     3873         parameter-6-29 = if sort-phrase-29 = ''
     3874                              then
     3875           (
     3876           " " + "" +
     3877             " " + sort-column-phrase +
     3878           " " + "  "
     3879           )
     3880                              else
     3881           (
     3882           " " + "" +
     3883             " " + sort-column-phrase +
     3884           " " + sort-phrase-29
     3885           )
     3886         parameter-7-29 =
     3887           " indexed-reposition  "
     3888       .
     3889         run fltopend_fltfindq in this-procedure  (
     3890                             input this-procedure:handle
     3891                             ,input query br-obj-hist:handle
     3892                             ,input logical(parameter-2-29)
     3893                             ,input no-lock
     3894                             ,input parameter-3-29
     3895                             ,input parameter-4-29
     3896                             ,input parameter-5-29
     3897                             ,input parameter-6-29
     3898                             ,input parameter-7-29
     3899                             ,output v-fltopend-rowid
     3900                             ) no-error.
     3901         .
     3902         v-doc-rec = ?.
     3903       end.
     3904       assign
     3905         l-query-was-opened = true
     3906       .
     3907     end.
     3908   end.
     3909     run waitfram-hide in this-procedure .
     3910     end.
     3911   end.
     3912   if not p-open-query and v-doc-rec <> ? then
     3913   REPOSITION br-obj-hist to recid v-doc-rec No-ERROR.
     3914   if not p-open-query and v-fltopend-rowid[1] <> ? then
     3915   query br-obj-hist:handle:reposition-to-rowid(v-fltopend-rowid) No-ERROR.
     3916   run waitfram-hide in this-procedure .
     3917   APPLY "VALUE-CHANGED" TO br-obj-hist in frame Dialog-Frame.
     3918   APPLY "ENTRY" TO br-obj-hist.
     3919   END PROCEDURE.
     3920   PROCEDURE proc-b-print :
     3921   define variable date_string     as      char    no-undo.
     3922   define variable Line                as      char    no-undo.
     3923   define variable for-time as char.
     3924   define variable accum-count as integer.
     3925   define variable v-doc-rec as recid no-undo.
     3926   define variable v-subject-chr as character no-undo .
     3927   define variable v-upd-time as character no-undo .
     3928   define variable v-obj as character no-undo .
     3929   define variable v-action-chr as character no-undo .
     3930   define variable v-source-type as character no-undo .
     3931   DEFINE FRAME HistoryList
     3932   v-action-chr FORMAT "X(10)" COLUMN-LABEL "Действие"
     3933   X_c-obj-hist.corr-date
     3934   v-upd-time COLUMN-LABEL "Время изм." FORMAT "X(8)"
     3935   X_c-obj-hist.corr-user-name
     3936   X_c-obj-hist.corr-user-db-num
     3937   HEADER  date_string AT 5 format "X(35)"
     3938   string( "Страница " ) format "X(9)" AT 115 PAGE-NUMBER(PrnLibStream) AT 125 FORMAT ">>9" SKIP
     3939   Line format "X(195)" AT 1
     3940   with width 232 down stream-io use-text    .
     3941   Line = fill("-", 195).
     3942   date_string = cur-time-print() .
     3943   assign
     3944   v-doc-rec = recid( X_c-obj-hist ).
     3945   DO WHILE available X_c-obj-hist :
     3946         GET prev br-obj-hist.
     3947   END.
     3948   run prn-lib-open-stream  in this-procedure (
     3949                                                input parparentProc
     3950                                               ,input 43
     3951                                               ,input yes
     3952                                               ,input no
     3953                                               ).
     3954   PUT  STREAM PrnLibStream
     3955   SPACE(25) ( frame Dialog-Frame:title )
     3956   format "x(90)" SKIP(1) .
     3957   FORM HEADER
     3958   Line format "X(180)" AT 1 SKIP
     3959   "Продолжение - на следующей странице" AT 30 SKIP
     3960   with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     3961   VIEW  STREAM PrnLibStream FRAME BottomFrame .
     3962   FORM with FRAME HistoryList  .
     3963   run waitfram-show in this-procedure ("Ждите...").
     3964     GET next br-obj-hist.
     3965       DO WHILE available X_c-obj-hist :
     3966         Display STREAM PrnLibStream
     3967          get-action(X_c-obj-hist.action) @ v-action-chr
     3968         X_c-obj-hist.corr-date
     3969         string(X_c-obj-hist.corr-time, "HH:MM:SS":U) @ v-upd-time
     3970         X_c-obj-hist.corr-user-name
     3971         X_c-obj-hist.corr-user-db-num
     3972         with FRAME HistoryList .
     3973     DOWN STREAM PrnLibStream 1 with FRAME HistoryList  .
     3974     assign
     3975     accum-count = accum-count + 1
     3976     .
     3977     GET next br-obj-hist.
     3978   END.
     3979   UNDERLINE  STREAM PrnLibStream
     3980   v-action-chr
     3981   v-subject-chr
     3982   X_c-obj-hist.corr-date
     3983   v-upd-time
     3984   X_c-obj-hist.corr-user-name
     3985   X_c-obj-hist.corr-user-db-num
     3986   with FRAME HistoryList .
     3987   DISPLAY STREAM PrnLibStream
     3988   "ИТОГО"  @ v-obj
     3989   string(accum-count)  @ v-action-chr
     3990   with frame HistoryList.
     3991   HIDE  STREAM PrnLibStream FRAME BottomFrame .
     3992   HIDE  STREAM PrnLibStream FRAME CheckList.
     3993   output  STREAM PrnLibStream CLOSE.
     3994   run waitfram-hide in this-procedure.
     3995   run prn-lib-prn-file in this-procedure (
     3996                                             input parparentproc
     3997                                             ,input 8
     3998                                             ).
     3999   reposition br-obj-hist to recid v-doc-rec no-error.
     4000   apply "entry" to br-obj-hist in frame Dialog-Frame.
     4001   END PROCEDURE.
     4002   PROCEDURE proc-b-sch :
     4003   assign
     4004     tbl = "c-code"
     4005     join-tbl = 'X_c-obj-hist'
     4006     fld = ""
     4007     lab = ""
     4008     spr = ""
     4009     dim = '0'
     4010     .
     4011   run fltfield-add in this-procedure('corr-date', 'Дата корр.', '',
     4012   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4013   run fltfield-add in this-procedure('corr-time', 'Время корр.', 'time',
     4014   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4015   run fltfield-add in this-procedure('corr-user-db-num', 'БД корр.', '',
     4016   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4017   run fltfield-add in this-procedure('corr-user-name', 'Изменил', 'usr',
     4018   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4019   run fltfield-add in this-procedure('action', 'Действие', 'hist-action',
     4020   input-output fld, input-output lab, input-output spr, input-output dim)  no-error.
     4021   Filter-Block:
     4022   DO ON STOP    UNDO Filter-Block, LEAVE Filter-Block
     4023       ON ERROR   UNDO Filter-Block, LEAVE Filter-Block
     4024       ON END-KEY UNDO Filter-Block, LEAVE Filter-Block :
     4025     run gbl/filter.w ( INPUT parparentproc
     4026                      , INPUT filter-point + chr(4) + filter-label
     4027                      , INPUT tbl
     4028                      , INPUT join-tbl
     4029                      , INPUT fld
     4030                      , INPUT lab
     4031                      , INPUT spr
     4032                      , INPUT dim ).
     4033     RUN OpenBr in this-procedure ( input yes, input no, input '':U, input v-corr-user-db-num).
     4034   END.
     4035   END PROCEDURE.
     4036   PROCEDURE proc-find-corr-date :
     4037   define input parameter p-next as logical no-undo.
     4038   define input parameter p-date like ub.fin-doc.doc-date no-undo.
     4039   define variable v-date-chr as character no-undo.
     4040   if p-date = ? then return .
     4041   display
     4042   0 @ sch-obj-code
     4043   0 @ sch-db-num
     4044   "":U @ sch-corr-user-name
     4045   with frame Dialog-Frame.
     4046   assign
     4047   v-date-chr = string(day(p-date)) + chr(47) +
     4048                    string(month(p-date)) + chr(47) +
     4049                    string(year(p-date)).
     4050          run OpenBr in this-procedure
     4051           (input false
     4052           ,input true
     4053           ,input substitute("and X_c-obj-hist.corr-date = &1 "
     4054             , v-date-chr)
     4055           ,input v-corr-user-db-num
     4056           ).
     4057         apply "entry":u to sch-corr-date in frame Dialog-Frame.
     4058   END PROCEDURE.
     4059   PROCEDURE proc-find-db-num :
     4060   define input parameter p-next as logical no-undo.
     4061   define input parameter p-db-num like c-code.corr-user-db-num no-undo.
     4062   define variable v-db-num as character no-undo.
     4063   assign
     4064   sch-corr-date = ?
     4065   .
     4066   display
     4067   "":U @ sch-corr-user-name
     4068   0 @ sch-obj-code
     4069   sch-corr-date
     4070   with frame Dialog-Frame.
     4071   assign
     4072   v-db-num = string(p-db-num).
     4073   run OpenBr in this-procedure
     4074       (input false
     4075       ,input p-next
     4076       ,input substitute("and X_c-obj-hist.corr-user-db-num = &1 "
     4077         , v-db-num)
     4078       ,input v-corr-user-db-num
     4079       ).
     4080   apply "entry":u to sch-db-num in frame Dialog-Frame .
     4081   END PROCEDURE.
     4082   PROCEDURE proc-find-user :
     4083   define input parameter p-next as logical no-undo.
     4084   define input parameter p-user like c-code.corr-user-name no-undo.
     4085   assign
     4086   sch-corr-date = ?.
     4087   display
     4088   0 @ sch-db-num
     4089   sch-corr-date
     4090   0 @ sch-obj-code
     4091   with frame Dialog-Frame.
     4092   p-user = chr(34) + p-user + chr(34).
     4093   run OpenBr in this-procedure
     4094       (input false
     4095       ,input p-next
     4096       ,input substitute("and X_c-obj-hist.corr-user-name = &1 "
     4097         , p-user)
     4098       ,input v-corr-user-db-num
     4099       ).
     4100   apply "entry":u to sch-corr-user-name in frame Dialog-Frame .
     4101   END PROCEDURE.
     4102   PROCEDURE proc-view-changes :
     4103   define variable v-description as character no-undo .
     4104   for each temp-changes:
     4105       delete temp-changes.
     4106   END.
     4107   if not available X_c-obj-hist then do:
     4108     b-nextlevel:visible IN FRAME Dialog-Frame = no.
     4109     Open QUery br-changes for each temp-changes.
     4110     return.
     4111   end.
     4112   b-nextlevel:visible IN FRAME Dialog-Frame =  no .
     4113   run local-view-cange in this-procedure (output v-description) .
     4114   Open QUery br-changes for each temp-changes by temp-changes.fNotChange.
     4115   assign
     4116   br-changes:title in frame Dialog-Frame = v-description
     4117   .
     4118   END PROCEDURE.
     4119   FUNCTION get-action RETURNS CHARACTER
     4120     ( p-action as integer ) :
     4121   define variable dops as character no-undo.
     4122   assign dops = entry (lookup (trim(string(p-action)), '99,1,2,3,4,9,51,79':U), 'Удаление,Создание,Изменение,Коррекция,Восстановление,Смена_кода,Смена_артик,Выключ.':U) no-error.
     4123   RETURN dops.
     4124   END FUNCTION.
     4125   FUNCTION get-source-type RETURNS CHARACTER
     4126     ( p-source-type as character ) :
     4127   define variable v-dop as character no-undo .
     4128   assign
     4129   v-dop = entry (lookup (p-source-type, ',db,esys,trn-doc,payment,fin-doc,import,recalc,wth-doc,ren-gdsc,upgrade,grp-chg,stop-list,dis-card':U), ',БД,ВС,Документ,Платеж,Фин.док.,Импорт,Пересчет,Документ МЦ,Коллизия,Апгрейд,Изм.группы,Стоплист,ДК':U)
     4130   no-error
     4131   .
     4132   RETURN v-dop.
     4133   END FUNCTION.
     4134   unsubscribe "getComboList".
     4135   function getParentLabel returns character (
     4136   input itype as character,
     4137   input iNum  as integer
     4138   ):
     4139      return
     4140      if itype ne "cash-param"
     4141      then "Родитель " + string(inum)
     4142      else if iNum = 1
     4143      then "Справочник"
     4144      else if iNum = 2
     4145      then "Устройство"
     4146      else if iNum = 3
     4147      then "Источник"
     4148      else if iNum = 4
     4149      then "Группа параметров/функция"
     4150      else if iNum = 5
     4151      then "Параметр"
     4152      else "Родитель " + string(inum).
     4153   end.
     4154   function getParentAll returns character (
     4155   ):
     4156      return
     4157      if    iParent eq ""
     4158         or iParent eq ?
     4159      then icode
     4160      else if icode eq ?
     4161      then iParent
     4162      else iParent + chr(4) + icode.
     4163   end.
     4164   function  getStsCashParam returns character (istatus as int ):
     4165      if istatus eq 1
     4166      then
     4167         return "Необязательный".
     4168      else if istatus eq 0
     4169      then
     4170         return "Обязательный".
     4171      else return "".
     4172   end.
     4173   define variable mType      as character no-undo.
     4174   procedure ParentPars:
     4175      define input  parameter iOldBuf as handle no-undo.
     4176      define input  parameter iCurBuf as handle no-undo.
     4177      define variable vparentOld as character no-undo.
     4178      define variable vparentCur as character no-undo.
     4179      vparentOld = if valid-handle(iOldBuf) and iOldBuf:available then iOldBuf::parent else "".
     4180      vparentCur = if valid-handle(iCurBuf) and iCurBuf:available then iCurBuf::parent else "".
     4181      mType = if    vparentOld begins "cash-param"
     4182                 or vparentCur begins "cash-param"
     4183              then "cash-param"
     4184              else ""
     4185              .
     4186      define variable vi as integer no-undo.
     4187      do vi = 1 to max(num-entries (vparentOld,chr(4)),num-entries (vparentCur,chr(4))):
     4188         create temp-changes.
     4189         assign
     4190           temp-changes.t_name = "code"
     4191           temp-changes.f_name = "Parent_" + string(vi)
     4192         .
     4193         temp-changes.l_name   = getParentLabel(mtype,vi).
     4194         temp-changes.v_old    = entry(vi,vparentOld,chr(4)) no-error.
     4195         temp-changes.v_new    = entry(vi,vparentCur,chr(4)) no-error.
     4196         temp-changes.fNotChange = temp-changes.v_old eq temp-changes.v_new.
     4197      end.
     4198   end.
     4199   function fLabel returns character :
     4200      return "Записи справочника с родителем " +  if p-mode eq "one"  then  replace(iParent ,chr(4),"->") + " с кодом " + icode else replace(getParentAll() ,chr(4),"->").
     4201   end.
     4202   function get-subject returns character
     4203     ( p-subject as character ) :
     4204     return p-subject.
     4205   end function.
     4206   procedure local-view-cange:
     4207      define output parameter odescription as character no-undo.
     4208      define buffer current_c-code for ub.c-code  .
     4209   define variable v-mess as character no-undo.
     4210   do
     4211   on error undo, return error return-value
     4212   :
     4213     find first current_c-code no-lock where
     4214                current_c-code.parent = X_c-obj-hist.parent
     4215            and current_c-code.code   = X_c-obj-hist.code
     4216            and current_c-code.chip-num = X_c-obj-hist.chip-num
     4217            and current_c-code.corr-user-db-num = X_c-obj-hist.corr-user-db-num no-error .
     4218     if not avail current_c-code then do:
     4219         v-mess = "Неверная ссылка на c-utd в таблице c-utd-head".
     4220         return error  v-mess .
     4221     end.
     4222       define variable vProcSts as character no-undo.
     4223     if X_c-obj-hist.parent begins "cash-param"
     4224     then
     4225        vProcSts = "getStsCashParam".
     4226     define variable v-label-param as character no-undo .
     4227     define variable vi as integer no-undo.
     4228     v-label-param =
     4229           "code"       + chr(4) + "Код"                                   + chr(4) + "" + chr(8)
     4230         + "Codevalue"  + chr(4) + "Значение"                              + chr(4) + "" + chr(8)
     4231         + "codeName"   + chr(4) + "Наименоваание"                         + chr(4) + "" + chr(8)
     4232         + "export_"    + chr(4) + "Выгружается"                           + chr(4) + "" + chr(8)
     4233         + "nwsgbd"     + chr(4) + "Ходит из ГБД в УБД"                    + chr(4) + "" + chr(8)
     4234         + "nwsubd"     + chr(4) + "Ходит из УБД в ГБД"                    + chr(4) + "" + chr(8)
     4235         + "procdel"    + chr(4) + "Процедура удаеления"                   + chr(4) + "" + chr(8)
     4236         + "procedit"   + chr(4) + "Процедура редактирования"              + chr(4) + "" + chr(8)
     4237         + "procview"   + chr(4) + "Процедура просмотра дочерних записей"  + chr(4) + "" + chr(8).
     4238     do vi = 1 to 10:
     4239         v-label-param = v-label-param + "misc" + string(vi)      + chr(4) + "Доп поле " + string(vi)    + chr(4) + "" + chr(8).
     4240     end.
     4241     v-label-param = v-label-param + "status_"        + chr(4) + "Статус"  + chr(4) + vProcSts .
     4242     run proc-full-temp-changes in this-procedure (
     4243                                                  input current_c-code.action = integer('1':U)
     4244                                                 ,input current_c-code.action = integer('99':U)
     4245                                                 ,input  buffer current_c-code:handle
     4246                                                 ,input  'Code':U
     4247                                                 ,input  "code,Codevalue,codeName,export_,nwsgbd,nwsubd,procdel,procedit,procview,status_"
     4248                                                 ,input  v-label-param).
     4249   end.
     4250   end procedure.
     4251   function local-open-br returns logical
     4252   (  p-open-query     as logical    ,
     4253     p-find-next       as logical    ,
     4254     p-find-condition as character ):
     4255        define variable sort-column-phrase as character no-undo .
     4256        define variable l-query-was-opened as logical no-undo .
     4257      if p-mode eq "one"
     4258      then do:
     4259         if p-chip-num eq ?
     4260         then do:
     4261   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4262   define variable  l-disable-where-31  as logical   no-undo .
     4263   define variable  l-filter-open-31    as logical   .
     4264   define variable  flt-rec-31       as recid     no-undo .
     4265   define variable  filter-name-31      as character no-undo .
     4266   define variable  where-phrase-31     as character no-undo .
     4267   define variable  sort-phrase-31      as character no-undo .
     4268   define variable  where-phrase-rus-31 as character no-undo .
     4269   define variable  sort-phrase-rus-31  as character no-undo .
     4270     run waitfram-show in this-procedure
     4271       (input "ЖДИТЕ ..."
     4272       ).
     4273   run gbl/flt-get.p
     4274     (input filter-point
     4275     ,output flt-rec-31
     4276     ,output filter-name-31
     4277     ,output where-phrase-31
     4278     ,output sort-phrase-31
     4279     ,output where-phrase-rus-31
     4280     ,output sort-phrase-rus-31
     4281     ).
     4282   if p-open-query then do:
     4283       run set-filter-name in this-procedure
     4284         (INPUT filter-name-31
     4285         ) no-error .
     4286     assign
     4287       l-filter-open-31 = false
     4288     .
     4289     if flt-rec-31 <> ?
     4290       or sort-column-phrase > ""
     4291     then do:
     4292       define variable  parameter-2-31 as character no-undo .
