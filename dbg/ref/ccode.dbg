      872   procedure fltopend_fltopend :
      873   define input parameter p-parent-handle as handle no-undo .
      874   define input parameter p-qh as handle no-undo .
      875   define input parameter p-flt-open-open-query  as character no-undo .
      876   define input parameter p-where-cond as character no-undo .
      877   define input parameter p-use-indFIRST-query-tail as character no-undo .
      878   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      879   define input parameter p-indexed-reposition as character no-undo .
      880     do
      881     on error undo, return error
      882     :
      883   define variable v-prepare-string as character no-undo .
      884   define variable glog as logical no-undo .
      885   assign
      886   v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      887                      p-where-cond + chr(32)  +
      888                      p-use-indFIRST-query-tail + chr(32) +
      889                      p-use-ind-sort-clmn-by + chr(32) +
      890                      p-indexed-reposition
      891   .
      892   assign
      893   glog = p-qh:query-prepare(v-prepare-string) no-error .
      894   if not glog
      895   or error-status:error then do:
      896     message error-status:get-message(1) view-as alert-box .
      897     undo, return error .
      898   end.
      899   assign
      900   glog = p-qh:query-open no-error .
      901   if not glog
      902   or error-status:error then do:
      903     message error-status:get-message(1) view-as alert-box .
      904     undo, return error .
      905   end.
      906     end.
      907   end procedure.
      908   procedure fltopend_fltfindd :
      909   define input parameter p-parent-handle as handle no-undo .
      910   define input parameter p-qh as handle no-undo .
      911   define input parameter p-rowid as rowid no-undo .
      912   define input parameter p-next as logical no-undo .
      913   define input parameter p-lock as integer no-undo .
      914   define input parameter p-bh as handle no-undo .
      915   define input parameter p-where-cond as character no-undo .
      916   define input parameter p-use-index-phrase as character no-undo .
      917   define variable glog as logical no-undo .
      918   define variable v-qh as handle no-undo .
      919   define variable v-bh as handle no-undo .
      920   define variable v-recid as recid no-undo .
      921   define variable v-prepare-string as character no-undo .
      922   do
      923   on error undo, return error
      924   on stop undo, return error
      925   :
      926     glog = p-bh:find-by-rowid( p-rowid, p-lock) no-error.
      927     create buffer v-bh for table p-bh buffer-name p-bh:name.
      928     create query v-qh.
      929     v-qh:set-buffers(v-bh).
      930     v-prepare-string = substitute("for each &1 &2 &3"
      931                                     ,v-bh:name
      932                                     ,p-where-cond
      933                                     ,p-use-index-phrase).
      934     glog = v-qh:query-prepare(v-prepare-string) no-error.
      935     if not glog then do:
      936       delete object v-qh.
      937       delete object v-bh.
      938       undo, return error .
      939     end.
      940     glog = v-qh:query-open no-error .
      941     if not glog then do:
      942       delete object v-qh.
      943       delete object v-bh.
      944       undo, return error .
      945     end.
      946     if p-next then do:
      947       v-qh:reposition-to-rowid(p-rowid) no-error .
      948       glog = v-qh:get-next( p-lock) no-error .
      949       glog = v-qh:get-next( p-lock) no-error .
      950       if not glog or v-qh:query-off-end = yes then do:
      951         glog = v-qh:get-first( p-lock) no-error .
      952       end.
      953     end.
      954     else do:
      955       glog = v-qh:get-first( p-lock) no-error .
      956     end.
      957     v-recid = v-bh:recid no-error .
      958     delete object v-qh.
      959     delete object v-bh.
      960     return string(v-recid) .
      961   end.
      962   end procedure.
      963   procedure fltopend_fltfindq :
      964   define input parameter p-parent-handle as handle no-undo .
      965   define input parameter p-qh as handle no-undo .
      966   define input parameter p-next as logical no-undo .
      967   define input parameter p-lock as integer no-undo .
      968   define input parameter p-flt-open-open-query  as character no-undo .
      969   define input parameter p-where-cond as character no-undo .
      970   define input parameter p-use-indFIRST-query-tail as character no-undo .
      971   define input parameter p-use-ind-sort-clmn-by as character no-undo .
      972   define input parameter p-indexed-reposition as character no-undo .
      973   define output parameter p-fltopend-rowid as rowid extent 18 no-undo .
      974   define variable glog as logical no-undo .
      975   define variable v-qh as handle no-undo .
      976   define variable v-bh as handle no-undo extent 18.
      977   define variable v-rowid as rowid no-undo extent 18.
      978   define variable v-ii as integer no-undo .
      979   define variable v-prepare-string as character no-undo .
      980   do
      981   on error undo, return error
      982   on stop undo, return error
      983   :
      984     create query v-qh.
      985     do v-ii = 1 to p-qh:num-buffers:
      986       create buffer v-bh[v-ii] for table p-qh:get-buffer-handle(v-ii) buffer-name p-qh:get-buffer-handle(v-ii):name .
      987       assign
      988       v-rowid[v-ii] = p-qh:get-buffer-handle(v-ii):rowid
      989       no-error.
      990       v-qh:add-buffer(v-bh[v-ii]).
      991     end.
      992     assign
      993     v-prepare-string = p-flt-open-open-query + " where " + chr(32) +
      994                       p-where-cond + chr(32)  +
      995                       p-use-indFIRST-query-tail + chr(32) +
      996                       p-use-ind-sort-clmn-by + chr(32) +
      997                       p-indexed-reposition
      998     .
      999     glog = v-qh:query-prepare( v-prepare-string) no-error .
     1000     if not glog then do:
     1001       delete object v-qh.
     1002       do v-ii = 1 to p-qh:num-buffers:
     1003         delete object v-bh[v-ii].
     1004       end.
     1005       undo, return error .
     1006     end.
     1007     glog = v-qh:query-open no-error .
     1008     if not glog then do:
     1009       delete object v-qh.
     1010       do v-ii = 1 to p-qh:num-buffers:
     1011         delete object v-bh[v-ii].
     1012       end.
     1013       undo, return error .
     1014     end.
     1015     if p-next then do:
     1016       glog = v-qh:reposition-to-rowid(v-rowid) no-error .
     1017       glog = v-qh:get-next( p-lock) no-error .
     1018       glog = v-qh:get-next( p-lock) no-error .
     1019       if not glog or v-qh:query-off-end = yes then do:
     1020         glog = v-qh:get-first( p-lock) no-error .
     1021       end.
     1022     end.
     1023     else do:
     1024       glog = v-qh:get-first( p-lock) no-error .
     1025     end.
     1026     do v-ii = 1 to p-qh:num-buffers:
     1027       assign
     1028       p-fltopend-rowid[v-ii] = v-bh[v-ii]:rowid
     1029       no-error.
     1030     end.
     1031     delete object v-qh.
     1032     do v-ii = 1 to p-qh:num-buffers:
     1033       delete object v-bh[v-ii].
     1034     end.
     1035   end.
     1036   end procedure.
