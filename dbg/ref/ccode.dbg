      607   procedure fltfield-clear :
      608     define output parameter loc-fld as character no-undo.
      609     define output parameter loc-lab as character no-undo .
      610     define output parameter loc-spr as character no-undo .
      611     define output parameter loc-dim as character no-undo .
      612     assign
      613       loc-fld = ""
      614       loc-lab = ""
      615       loc-spr = ""
      616       loc-dim = "0"
      617     .
      618   end procedure .
      619   procedure fltfield-add :
      620     define input        parameter par-fld as character no-undo.
      621     define input        parameter par-lab as character no-undo .
      622     define input        parameter par-spr as character no-undo .
      623     define input-output parameter loc-fld as character no-undo.
      624     define input-output parameter loc-lab as character no-undo .
      625     define input-output parameter loc-spr as character no-undo .
      626     define input-output parameter loc-dim as character no-undo .
      627     do
      628     on error undo, return error
      629     :
      630       assign
      631       loc-fld = if loc-dim = '0'
      632                 then par-fld
      633                 else (loc-fld + chr(44) + par-fld)
      634       loc-lab = if loc-dim = '0'
      635                 then par-lab
      636                 else (loc-lab + chr(44) + par-lab)
      637       loc-spr = if loc-dim = '0'
      638                 then par-spr
      639                 else (loc-spr + chr(44) + par-spr)
      640       loc-dim = (if num-entries(loc-dim) > 1 then (entry(1, loc-dim) + chr(44)) else "") +
      641                 string(integer(if num-entries(loc-dim) > 1
      642                               then entry(2, loc-dim)
      643                               else entry(1, loc-dim)
      644                               ) + 1)
      645       no-error
      646       .
      647     end.
      648   end procedure.
