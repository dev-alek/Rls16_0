     2930   procedure get-context :
     2931      define output parameter p-db-num as integer          no-undo.
     2932      define output parameter p-user-id as character        no-undo.
     2933      define variable v-login               as character    no-undo.
     2934      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2935      define buffer buf_user-login  for ub.user-login .
     2936      do
     2937      on error undo, return error
     2938      :
     2939            FIND FIRST buf_sys-ctrl no-lock.
     2940            ASSIGN
     2941               v-login = USERID("ub")
     2942               p-db-num = buf_sys-ctrl.db-num
     2943            .
     2944            FIND FIRST buf_user-login
     2945                 WHERE buf_user-login.db-num = p-db-num
     2946                   AND buf_user-login.user-login = v-login
     2947                 no-lock
     2948                 no-error
     2949                 .
     2950            IF AVAILABLE buf_user-login
     2951            THEN DO:
     2952               assign
     2953                  p-user-id = buf_user-login.user-id
     2954               .
     2955            END.
     2956      end.
     2957   end procedure.
