     3207   def var sort-labelbr-obj-hist   as character no-undo .
     3208   def var sort-clmnbr-obj-hist    as handle    no-undo .
     3209   def var cur-clmnbr-obj-hist     as handle    no-undo .
     3210   def var cur-clmn-locbr-obj-hist as integer   no-undo .
     3211   def var re-querybr-obj-hist     as logical   initial no no-undo .
     3212   on start-search, ctrl-o of br-obj-hist in frame Dialog-Frame do:
     3213      run sort-brbr-obj-hist
     3214        (input (if available X_c-obj-hist
     3215                then recid(X_c-obj-hist)
     3216                else ?
     3217               )
     3218        ).
     3219   end.
     3220   PROCEDURE sort-brbr-obj-hist :
     3221     define input parameter p-recid as recid no-undo .
     3222     if re-querybr-obj-hist = no then do:
     3223       assign
     3224          cur-clmnbr-obj-hist = br-obj-hist:current-column in frame Dialog-Frame
     3225       .
     3226       if sort-clmnbr-obj-hist <> ? then sort-clmnbr-obj-hist:column-fgcolor = 0.
     3227       if cur-clmnbr-obj-hist = sort-clmnbr-obj-hist then do:
     3228         assign
     3229            sort-labelbr-obj-hist = ""
     3230            sort-clmnbr-obj-hist = ?
     3231         .
     3232        end.
     3233        else do:
     3234          assign
     3235            sort-labelbr-obj-hist = cur-clmnbr-obj-hist:label
     3236            sort-clmnbr-obj-hist  = cur-clmnbr-obj-hist
     3237            sort-clmnbr-obj-hist:column-fgcolor = 4
     3238          .
     3239        end.
     3240      end.
     3241     assign
     3242       cur-clmn-locbr-obj-hist = 1
     3243     .
     3244     def var column-handle as handle no-undo .
     3245     column-handle = br-obj-hist:first-column.
     3246     do while valid-handle(column-handle) :
     3247       if column-handle = cur-clmnbr-obj-hist then do:
     3248         leave .
     3249       end.
     3250       column-handle = column-handle:NEXT-COLUMN.
     3251       assign
     3252         cur-clmn-locbr-obj-hist = cur-clmn-locbr-obj-hist + 1
     3253       .
     3254     end.
     3255     case sort-labelbr-obj-hist:
     3256           when X_c-obj-hist.corr-date:label in browse br-obj-hist then DO:    assign       sort-column-name = "X_c-obj-hist.corr-date"     .     run OpenBr(yes, no, no, v-corr-user-db-num).   . END.
     3257           when X_c-obj-hist.corr-user-db-num:label in browse br-obj-hist then DO:    assign       sort-column-name = "X_c-obj-hist.corr-user-db-num"     .     run OpenBr(yes, no, no, v-corr-user-db-num).   . END.
     3258       otherwise do:
     3259         assign
     3260           sort-column-name = ""
     3261         .
     3262         run OpenBr(yes, no, no, v-corr-user-db-num).
     3263           if can-do( this-procedure:internal-entries, 'mv-brw-defaultbr-obj-hist') then do:
     3264             run mv-brw-defaultbr-obj-hist.
     3265           end.
     3266         if sort-labelbr-obj-hist <> "" then do:
     3267           assign
     3268             cur-clmnbr-obj-hist:column-fgcolor = 0
     3269           .
     3270         end.
     3271         assign
     3272           cur-clmn-locbr-obj-hist = ?
     3273         .
     3274       end.
     3275     end case.
     3276       if cur-clmn-locbr-obj-hist <> ? then do:
     3277         if can-do( this-procedure:internal-entries, 'ch-clmnbr-obj-hist') then do:
     3278           run ch-clmnbr-obj-hist in this-procedure (cur-clmn-locbr-obj-hist).
     3279         end.
     3280       end.
     3281     if p-recid <> ? then do:
     3282       reposition br-obj-hist to recid p-recid no-error.
     3283       apply "value-changed" to br-obj-hist in frame Dialog-Frame.
     3284     end.
     3285     apply "entry" to br-obj-hist in frame Dialog-Frame.
     3286   END PROCEDURE.
     3287   procedure re-open-query-srt-clmnbr-obj-hist:
     3288   if cur-clmnbr-obj-hist = ? then do:
     3289      run OpenBr(yes, no, no, v-corr-user-db-num).
     3290   end.
     3291   else do:
     3292      assign re-querybr-obj-hist = yes.
     3293      run sort-brbr-obj-hist
     3294        (input (if available X_c-obj-hist
     3295                then recid(X_c-obj-hist)
     3296                else ?
     3297               )
     3298        ).
     3299      assign re-querybr-obj-hist = no.
     3300   end.
     3301   end.
     3302   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3303   do:
     3304     BR-changes :SET-REPOSITIONED-ROW(5, "CONDITIONAL") .
     3305   end.
     3306   MAIN-BLOCK:
     3307   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3308      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3309      if p-mode <> 'все':U
     3310    and p-mode <> 'фирма':U
     3311    and p-mode <> "one":U
     3312    and p-mode <> "subject":U
     3313    and p-mode <> "parentbeg":U
     3314    then dO:
     3315       message
     3316       vss-workfile vss-revision vss-description skip
     3317       "Неверное значение параметров вызова p-mode"
     3318       p-mode
     3319       view-as alert-box ERROR.
     3320       return.
     3321    end.
     3322    v-rid-list = p-rid-list.
     3323     if v-rid-list <> "" then do:
     3324         FIND FIRST find_c-obj-hist No-LOCK where
     3325                    recid(find_c-obj-hist) = integer(entry(1, v-rid-list)) No-ERROR.
     3326         if not avail find_c-obj-hist then do:
     3327           message
     3328           vss-workfile vss-revision vss-description skip
     3329           "Неверное значение параметра вызова v-rid-list" v-rid-list
     3330           view-as alert-box error .
     3331           return error.
     3332         end.
     3333         v-doc-rec = integer(entry(1, v-rid-list)).
     3334       end.
     3335   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3336   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     3337     (output v-db-num
     3338     )  .
     3339     if p-mode <> 'все':U then do:
     3340       assign
     3341       v-find = yes.
     3342       end.
     3343       else do:
     3344     end.
     3345     RUN MyEnable.
     3346     RUn OpenBR(yes, no, '':U, v-corr-user-db-num).
     3347     HIDE mark-num in frame Dialog-Frame .
     3348     if v-rid-list <> "":U then
     3349     REPOSITION br-obj-hist to recid integer(entry(1, v-rid-list)) No-ERROR.
     3350   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3351   DEF VAR cur-clmn-numbr-obj-hist as INT EXTENT 6 no-undo.
     3352   DEF VAR varmvibr-obj-hist       as INT no-undo.
     3353   DEF VAR varmvjbr-obj-hist       as INT no-undo.
     3354   DEF VAR varmvkbr-obj-hist       as INT no-undo.
     3355   DEF VAR varmvlbr-obj-hist       as INT no-undo.
     3356   DEF VAR move-elementbr-obj-hist as INT no-undo.
     3357   def var jjbr-obj-hist           as int no-undo.
     3358   do varmvibr-obj-hist = 1 to EXTENT(cur-clmn-numbr-obj-hist):
     3359     ASSIGN cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = varmvibr-obj-hist.
     3360   END.
     3361   RUN start-mv-clmnbr-obj-hist.
     3362   PROCEDURE start-mv-clmnbr-obj-hist:
     3363   def var old-session as logical no-undo.
     3364      old-session = SESSION:IMMEDIATE-DISPLAY.
     3365      IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3366          IF  p-mode = 'все':U  THEN DO:
     3367      DO jjbr-obj-hist = NUM-ENTRIES('1,2,3,4,5,6') TO 1 BY -1:
     3368        RUN re-move-clmnbr-obj-hist ( cur-clmn-numbr-obj-hist[INTEGER(ENTRY (jjbr-obj-hist, '1,2,3,4,5,6'))] , 1).
     3369      END.
     3370          END.
     3371          IF  p-mode <> 'все':U  THEN DO:
     3372      DO jjbr-obj-hist = NUM-ENTRIES('1,2,3,5,6') TO 1 BY -1:
     3373        RUN re-move-clmnbr-obj-hist ( cur-clmn-numbr-obj-hist[INTEGER(ENTRY (jjbr-obj-hist, '1,2,3,5,6'))] , 1).
     3374      END.
     3375          END.
     3376      SESSION:IMMEDIATE-DISPLAY = old-session.
     3377   END.
     3378   ON ctrl-cursor-right OF BROWSE br-obj-hist do:
     3379     RUN re-move-clmnbr-obj-hist ( 1, 6).
     3380   END.
     3381   ON ctrl-cursor-left OF BROWSE br-obj-hist do:
     3382     RUN re-move-clmnbr-obj-hist (6, 1).
     3383   END.
     3384   PROCEDURE re-move-clmnbr-obj-hist:
     3385     DEFINE INPUT PARAMETER source-column as INTEGER NO-UNDO.
     3386     DEFINE INPUT PARAMETER target-column as INTEGER NO-UNDO.
     3387     DO varmvibr-obj-hist = 1 TO EXTENT(cur-clmn-numbr-obj-hist):
     3388       if cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = source-column THEN cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = -1.
     3389     END.
     3390     if br-obj-hist:MOVE-COLUMN(source-column, target-column) IN FRAME Dialog-Frame then.
     3391     if source-column > target-column THEN
     3392     DO varmvjbr-obj-hist = source-column - 1 to target-column BY -1:
     3393       DO varmvibr-obj-hist = 1 TO EXTENT(cur-clmn-numbr-obj-hist):
     3394           if cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = varmvjbr-obj-hist THEN DO:
     3395             cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = cur-clmn-numbr-obj-hist[varmvibr-obj-hist] + 1.
     3396           END.
     3397       END.
     3398     END.
     3399     ELSE
     3400     DO varmvjbr-obj-hist = source-column + 1 to target-column:
     3401       DO varmvibr-obj-hist = 1 TO EXTENT(cur-clmn-numbr-obj-hist):
     3402         if cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = varmvjbr-obj-hist THEN DO:
     3403           cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = cur-clmn-numbr-obj-hist[varmvibr-obj-hist] - 1.
     3404         END.
     3405       END.
     3406     END.
     3407     DO varmvibr-obj-hist = 1 TO EXTENT(cur-clmn-numbr-obj-hist):
     3408       if cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = -1 THEN cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = target-column.
     3409     END.
     3410   END PROCEDURE.
     3411   PROCEDURE ch-clmnbr-obj-hist:
     3412     DEFINE INPUT PARAMETER cur-clmn-loc as INTEGER NO-UNDO.
     3413     if cur-clmn-loc <= 1 then do:
     3414       return .
     3415     end.
     3416     DO varmvibr-obj-hist = 1 TO EXTENT(cur-clmn-numbr-obj-hist):
     3417       if cur-clmn-numbr-obj-hist[varmvibr-obj-hist] = cur-clmn-loc THEN move-elementbr-obj-hist = varmvibr-obj-hist.
     3418     END.
     3419     RUN re-move-clmnbr-obj-hist (cur-clmn-loc, 1).
     3420   END PROCEDURE.
     3421   PROCEDURE mv-brw-defaultbr-obj-hist:
     3422   def var old-session as logical no-undo.
     3423     old-session = SESSION:IMMEDIATE-DISPLAY.
     3424     IF old-session = YES THEN SESSION:IMMEDIATE-DISPLAY = NO.
     3425     do varmvlbr-obj-hist = 1 to EXTENT(cur-clmn-numbr-obj-hist):
     3426       RUN re-move-clmnbr-obj-hist (cur-clmn-numbr-obj-hist[varmvlbr-obj-hist], varmvlbr-obj-hist).
     3427     END.
     3428     RUN start-mv-clmnbr-obj-hist.
     3429     SESSION:IMMEDIATE-DISPLAY = old-session.
     3430   END PROCEDURE.
     3431   .
     3432     run diasize_add_browse in this-procedure
     3433       (input  'width':u
     3434       ,input  browse br-changes :handle
     3435       ) .
     3436     run diasize_init in this-procedure .
     3437     WAIT-FOR GO OF FRAME Dialog-Frame.
     3438   END.
     3439   RUN disable_UI.
     3440   PROCEDURE disable_UI :
     3441     HIDE FRAME Dialog-Frame.
     3442   END PROCEDURE.
     3443   PROCEDURE enable_UI :
     3444     DISPLAY v-corr-user-db-num sch-db-num sch-corr-date sch-obj-code
     3445             sch-corr-user-name mark-num
     3446         WITH FRAME Dialog-Frame.
     3447     ENABLE b-quit B-mark b-sel v-corr-user-db-num B-print B-sch
     3448            B-Help br-obj-hist sch-db-num sch-corr-date sch-obj-code
     3449            sch-corr-user-name BR-changes mark-num b-nextlevel
     3450         WITH FRAME Dialog-Frame.
     3451     VIEW FRAME Dialog-Frame.
     3452   END PROCEDURE.
     3453   PROCEDURE MyEnable :
     3454   DEFINE VARIABLE v-h AS handle NO-UNDO.
     3455   assign
     3456   br-obj-hist:num-locked-columns in frame Dialog-Frame = 1
     3457   X_c-obj-hist.corr-date:read-only in browse br-obj-hist = yes
     3458   br-changes:title = "":U
     3459   v-corr-user-db-num = v-db-num
     3460   temp-changes.l_name:resizable in browse br-changes = true
     3461   temp-changes.v_old:resizable in browse br-changes = true
     3462   temp-changes.v_new:resizable in browse br-changes = true
     3463   temp-changes.l_name:width in browse br-changes = 30
     3464   temp-changes.v_old:width in browse br-changes = 40
     3465   temp-changes.v_new:width in browse br-changes = 40
     3466   v-h = br-obj-hist:FIRST-COLUMN IN FRAME Dialog-Frame
     3467   .
     3468   DO while valid-handle(v-h) :
     3469     if v-h:LABEL = "Предмет изменения"
     3470     or v-h:LABEL = "Изменил"
     3471       then do:
     3472       v-h:RESIZABLE = YES.
     3473     end.
     3474       v-h = v-h:NEXT-COLUMN.
     3475     END.
     3476   DISPLAY
     3477   v-corr-user-db-num
     3478   sch-db-num
     3479   sch-corr-date
     3480   sch-obj-code
     3481   sch-corr-user-name
     3482   mark-num
     3483   WITH FRAME Dialog-Frame.
     3484   ENABLE
     3485   v-corr-user-db-num
     3486   b-quit
     3487   B-mark when lookup("b-mark":U, bttns) > 0
     3488   b-sel when lookup("b-sel":U, bttns) > 0
     3489   B-sch
     3490   B-Print
     3491   B-Help
     3492   br-obj-hist
     3493   sch-corr-date
     3494   sch-corr-user-name
     3495   sch-obj-code when p-mode = 'все':U
     3496   sch-db-num when p-mode = 'все':U
     3497   BR-changes mark-num
     3498   b-nextlevel
     3499   WITH FRAME Dialog-Frame.
     3500   VIEW FRAME Dialog-Frame.
     3501   HIDE sch-corr-user-name IN FRAME Dialog-Frame.
     3502   END PROCEDURE.
     3503   PROCEDURE OpenBr :
     3504   define input  parameter p-open-query     as logical   no-undo .
     3505   define input  parameter p-find-next      as logical   no-undo .
     3506   define input  parameter p-find-condition as character no-undo .
     3507   define input  parameter p-db-num like c-code.corr-user-db-num no-undo .
     3508   define variable l-query-was-opened as logical no-undo .
     3509   define variable title0 as character no-undo.
     3510   title0 = "Список полной истории контрагента" + chr(32).
     3511   run waitfram-show in this-procedure ("Ждите...").
     3512   define variable sort-column-phrase as character no-undo .
     3513   case sort-column-name :
     3514     when "" then do:
     3515       assign
     3516         sort-column-phrase = ""
     3517       .
     3518     end.
     3519     otherwise do:
     3520       assign
     3521         sort-column-phrase = "by " + sort-column-name
     3522       .
     3523     end.
     3524   end case.
     3525   define variable l-open-query as logical   no-undo .
     3526   if p-mode = 'все':U then
     3527   do:
     3528         assign
     3529         filter-point = filter-point0 + p-mode
     3530         filter-label = substitute("&1", filter-label0)
     3531         .
     3532   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3533   define variable  l-disable-where-27  as logical   no-undo .
     3534   define variable  l-filter-open-27    as logical   .
     3535   define variable  flt-rec-27       as recid     no-undo .
     3536   define variable  filter-name-27      as character no-undo .
     3537   define variable  where-phrase-27     as character no-undo .
     3538   define variable  sort-phrase-27      as character no-undo .
     3539   define variable  where-phrase-rus-27 as character no-undo .
     3540   define variable  sort-phrase-rus-27  as character no-undo .
     3541     run waitfram-show in this-procedure
     3542       (input "ЖДИТЕ ..."
     3543       ).
     3544   run gbl/flt-get.p
     3545     (input filter-point
     3546     ,output flt-rec-27
     3547     ,output filter-name-27
     3548     ,output where-phrase-27
     3549     ,output sort-phrase-27
     3550     ,output where-phrase-rus-27
     3551     ,output sort-phrase-rus-27
     3552     ).
     3553   if p-open-query then do:
     3554       run set-filter-name in this-procedure
     3555         (INPUT filter-name-27
     3556         ) no-error .
     3557     assign
     3558       l-filter-open-27 = false
     3559     .
     3560     if flt-rec-27 <> ?
     3561       or sort-column-phrase > ""
     3562     then do:
     3563       define variable  parameter-2-27 as character no-undo .
     3564       define variable  parameter-3-27 as character no-undo .
     3565       define variable  parameter-4-27 as character no-undo .
     3566       define variable  parameter-5-27 as character no-undo .
     3567       define variable  parameter-6-27 as character no-undo .
     3568       define variable  parameter-7-27 as character no-undo .
     3569         assign
     3570         parameter-3-27 =
     3571                                 "FOR EACH X_c-obj-hist"
     3572         parameter-4-27 =
     3573           (
     3574             if (" TRUE " + " " + where-phrase-27) <> ""
     3575             then " TRUE " + " " + where-phrase-27
     3576             else "true"
     3577           )
     3578         parameter-5-27 = (" " + "" + " " + "")
     3579         parameter-6-27 = if sort-phrase-27 = ''
     3580                              then
     3581           (
     3582           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC  " +
     3583             " " + sort-column-phrase +
     3584           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC  "
     3585           )
     3586                              else
     3587           (
     3588           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC  " +
     3589             " " + sort-column-phrase +
     3590           " " + sort-phrase-27
     3591           )
     3592         parameter-7-27 =
     3593           " indexed-reposition  "
     3594       .
     3595       do
     3596       on stop undo, leave
     3597       on error undo, leave
     3598       :
     3599         assign
     3600           l-disable-where-27 =
     3601             (" TRUE " + " " + where-phrase-27 = "")
     3602         .
     3603         run fltopend_fltopend in this-procedure  ( input this-procedure:handle
     3604                             ,input query br-obj-hist:handle
     3605                             ,input parameter-3-27
     3606                             ,input parameter-4-27
     3607                             ,input parameter-5-27
     3608                             ,input parameter-6-27
     3609                             ,input parameter-7-27
     3610                             )
     3611         .
     3612         assign
     3613           l-filter-open-27 = true
     3614         .
     3615       end.
     3616       if l-filter-open-27 = false then do:
     3617         message
     3618           "Ошибка при фильтрации / сортировке" skip
     3619           "Будут показаны записи без учета фильтра" skip
     3620           view-as alert-box .
     3621       end.
     3622       else do:
     3623           assign
     3624             l-query-was-opened = true
     3625           .
     3626       end.
     3627     end.
     3628     if l-filter-open-27 = false then do:
     3629       OPEN QUERY br-obj-hist FOR EACH X_c-obj-hist
     3630         where  TRUE
     3631          BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC
     3632          BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC
     3633         indexed-reposition
     3634     .
     3635         assign
     3636           l-query-was-opened = true
     3637         .
     3638     end.
     3639   end.
     3640   else do:
     3641     assign
     3642       v-doc-rec = recid( X_c-obj-hist )
     3643     .
     3644     do
     3645     on stop undo, leave
     3646     on error undo, leave
     3647     :
     3648       if query br-obj-hist:handle:get-buffer-handle(1) = (buffer X_c-obj-hist:handle) then do:
     3649         assign
     3650         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     3651         parameter-4-27 =
     3652           "where ":u + " TRUE " + " ":u + where-phrase-27 + " ":u + p-find-condition + " " + ""
     3653         parameter-5-27 = " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC  "
     3654       .
     3655         run fltopend_fltfindd in this-procedure  (
     3656                             input this-procedure:handle
     3657                             ,input query br-obj-hist:handle
     3658                             ,input rowid(X_c-obj-hist)
     3659                             ,input logical(parameter-2-27)
     3660                             ,input no-lock
     3661                             ,input (buffer X_c-obj-hist:handle)
     3662                             ,input parameter-4-27
     3663                             ,input parameter-5-27
     3664                             ) no-error.
     3665         .
     3666         assign
     3667           v-doc-rec = integer(return-value)
     3668           v-fltopend-rowid[1] = ?
     3669         .
     3670       end.
     3671       else do:
     3672         assign
     3673         parameter-2-27 = (if p-find-next then "true":u else "false":u )
     3674         parameter-3-27 =  "FOR EACH X_c-obj-hist"
     3675         parameter-4-27 =
     3676           (
     3677             if (" TRUE " + " " + where-phrase-27) <> ""
     3678             then " TRUE " + " " + where-phrase-27
     3679             else "true"
     3680           )
     3681         parameter-5-27 = (" " + "" + " " + "" + " " + p-find-condition)
     3682         parameter-6-27 = if sort-phrase-27 = ''
     3683                              then
     3684           (
     3685           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC  " +
     3686             " " + sort-column-phrase +
     3687           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC  "
     3688           )
     3689                              else
     3690           (
     3691           " " + " BY X_c-obj-hist.corr-date DESC BY X_c-obj-hist.corr-time DESC  " +
     3692             " " + sort-column-phrase +
     3693           " " + sort-phrase-27
     3694           )
     3695         parameter-7-27 =
     3696           " indexed-reposition  "
     3697       .
     3698         run fltopend_fltfindq in this-procedure  (
     3699                             input this-procedure:handle
     3700                             ,input query br-obj-hist:handle
     3701                             ,input logical(parameter-2-27)
     3702                             ,input no-lock
     3703                             ,input parameter-3-27
     3704                             ,input parameter-4-27
     3705                             ,input parameter-5-27
     3706                             ,input parameter-6-27
     3707                             ,input parameter-7-27
     3708                             ,output v-fltopend-rowid
     3709                             ) no-error.
     3710         .
     3711         v-doc-rec = ?.
     3712       end.
     3713       assign
     3714         l-query-was-opened = true
     3715       .
     3716     end.
     3717   end.
     3718     run waitfram-hide in this-procedure .
     3719   end.
     3720   else do:
     3721     if not local-open-br( p-open-query      ,
     3722                           p-find-next         ,
     3723                          p-find-condition )
     3724     then do:
     3725   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3726   define variable  l-disable-where-29  as logical   no-undo .
