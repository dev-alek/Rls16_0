      144   procedure cur-time :
      145      define output parameter p-today as date      no-undo .
      146      define output parameter p-time  as integer   no-undo .
      147     do
      148     on error undo, return error
      149     :
      150       define variable v-date1 as date      no-undo .
      151       define variable v-date2 as date      no-undo .
      152       define variable v-time  as integer   no-undo .
      153       assign
      154         v-date1 = today
      155         v-time  = time
      156         v-date2 = today
      157       .
      158       if v-date1 <> v-date2
      159       then do:
      160         assign
      161           v-date1 = today
      162           v-time  = v-time
      163         .
      164       end.
      165       assign
      166         p-today = v-date1
      167         p-time  = v-time
      168       .
      169     end.
      170   end.
      171   function cur-time-date returns character
      172   :
      173     return string(today, '99/99/9999':U) .
      174   end.
      175   function cur-time-mjd returns decimal
      176   :
      177     define variable v-date as date      no-undo .
      178     define variable v-time as integer   no-undo .
      179     run cur-time in this-procedure
      180       (output v-date
      181       ,output v-time
      182       ) .
      183     return integer(v-date) - 2400002 + (v-time / 86400) .
      184   end.
      185   function cur-time-get-ending-index returns integer
      186   (input p-number as integer
      187   )
      188   :
      189     if p-number < 0
      190     or p-number = ?
      191     then do:
      192       return 1 .
      193     end.
      194     define variable v-rest as integer   no-undo .
      195     assign
      196       p-number = p-number modulo 100
      197     .
      198     if p-number < 20
      199     then do:
      200       assign
      201         v-rest = p-number
      202       .
      203     end.
      204     else do:
      205       assign
      206         v-rest = p-number modulo 10
      207       .
      208     end.
      209     case v-rest :
      210       when 1
      211       then do:
      212         return 2 .
      213       end.
      214       when 2 or
      215       when 3 or
      216       when 4
      217       then do:
      218         return 3 .
      219       end.
      220       otherwise do:
      221         return 1 .
      222       end.
      223     end case .
      224   end.
      225   procedure cur-time-mjd-to-date :
      226      define input  parameter i-mjd-diff as decimal no-undo.
      227      define output parameter o-Date     as date    no-undo.
      228      define output parameter o-Time     as integer no-undo.
      229      define variable v-day-number as integer   no-undo .
      230      if    i-mjd-diff < 0
      231         or i-mjd-diff = ?
      232      then do:
      233         return "?" .
      234      end.
      235      assign
      236         v-day-number = truncate(i-mjd-diff,0).
      237         o-Date = date(v-day-number + 2400002).
      238         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      239     .
      240   end.
      241   function cur-time-mjd-to-string returns character
      242   (input p-mjd-diff as decimal
      243   )
      244   :
      245     define variable v-day-number as integer   no-undo .
      246     define variable v-seconds    as integer   no-undo .
      247     define variable v-hour       as integer   no-undo .
      248     define variable v-min        as integer   no-undo .
      249     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      250     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      251     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      252     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      253     if p-mjd-diff < 0
      254     or p-mjd-diff = ?
      255     then do:
      256       return "?" .
      257     end.
      258     assign
      259       v-day-number = integer(truncate(p-mjd-diff,0))
      260       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      261     .
      262     if v-seconds > 86400
      263     then do:
      264       assign
      265         v-seconds = 86400 - 1
      266       .
      267     end.
      268     if v-seconds < 0
      269     then do:
      270       assign
      271         v-seconds = 0
      272       .
      273     end.
      274     assign
      275       v-hour = truncate(v-seconds / 3600, 0)
      276     .
      277     assign
      278       v-seconds = v-seconds modulo 3600
      279     .
      280     assign
      281       v-min = truncate(v-seconds / 60, 0)
      282     .
      283     assign
      284       v-seconds = v-seconds modulo 60
      285     .
      286     return
      287         (if v-day-number <> 0
      288           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      289           else ""
      290         )
      291       + (if v-day-number <> 0 or v-hour <> 0
      292           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      293           else ""
      294         )
      295       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      296           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      297           else ""
      298         )
      299       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      300       .
      301   end.
      302   function cur-time-string returns character
      303   :
      304     define variable v-date as date      no-undo .
      305     define variable v-time as integer   no-undo .
      306     run cur-time in this-procedure
      307       (output v-date
      308       ,output v-time
      309       ) .
      310     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      311   end.
      312   function cur-time-string-sec returns character
      313   :
      314     define variable v-date as date      no-undo .
      315     define variable v-time as integer   no-undo .
      316     run cur-time in this-procedure
      317       (output v-date
      318       ,output v-time
      319       ) .
      320     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      321   end.
      322   function cur-time-custom  returns character
      323   (input p-prefix as character
      324   ,input p-date-format as character
      325   ,input p-delimiter as character
      326   ,input p-time-format as character
      327   ,input p-suffix as character
      328   )
      329   :
      330     define variable v-date as date      no-undo .
      331     define variable v-time as integer   no-undo .
      332     run cur-time in this-procedure
      333       (output v-date
      334       ,output v-time
      335       ) .
      336     return
      337       p-prefix
      338       + string(v-date, p-date-format)
      339       + p-delimiter
      340       + string(v-time, p-time-format)
      341       + p-suffix
      342       .
      343   end.
      344   function cur-time-print  returns character
      345   :
      346     define variable v-date as date      no-undo .
      347     define variable v-time as integer   no-undo .
      348     run cur-time in this-procedure
      349       (output v-date
      350       ,output v-time
      351       ) .
      352     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      353   end.
      354   function cur-time-datetime returns datetime
      355   :
      356     define variable v-char as character no-undo .
      357     define variable v-datetime as datetime no-undo .
      358     v-char = cur-time-string().
      359     v-datetime = datetime(v-char).
      360     return  v-datetime.
      361   end.
      362   function cur-time-string-msec returns character
      363   :
      364     define variable v-date as datetime  no-undo .
      365     v-date = now.
      366     return string(v-date) .
      367   end.
      368   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      369   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      370   define new shared variable RepPathName        as character no-undo .
      371   define new shared variable PrintRubl          as logical   no-undo .
      372   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      373   define variable v-waitfram-action01         as character   no-undo .
      374   define variable v-waitfram-action02         as character   no-undo .
      375   define variable v-waitfram-action03         as character   no-undo .
      376   define variable mWaitFramTextBeg            as character   no-undo.
      377   define variable mWaitFramTextEnd            as character   no-undo.
      378   define variable mWaitFramView               as logical     no-undo.
      379   define variable mWaitProcEvent              as logical     no-undo init yes.
      380   define variable mWaitFramInterval           as integer     no-undo init 1 .
      381   define variable mWaitFramStop               as logical     no-undo.
      382   define variable mWaitFramStopUser           as logical     no-undo.
      383   define variable mWaitFramStopTimeOut        as logical     no-undo.
      384   define variable mWaitFramStartProc          as datetime-tz no-undo.
      385   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      386   define button B-WaitFramStop auto-end-key
      387        label "Стоп"
      388        size 10 by 1 tooltip "Остоновить процесс".
      389   define button B-viewProcInfo
      390        label "Информация"
      391        size 15 by 1 tooltip "Информация о процесс".
      392   define frame waitfram
      393     v-waitfram-action01 format "x(72)" no-label skip
      394     v-waitfram-action02 format "x(72)" no-label skip
      395     v-waitfram-action03 format "x(72)" no-label skip
      396     B-viewProcInfo
      397     B-WaitFramStop at row 4 col 30
      398     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      399     .
      400   define new global shared variable mBatchMode as logical no-undo init ?.
      401   define variable mFramBachModHandle as handle no-undo.
      402   mFramBachModHandle = frame waitfram:handle.
      403   define variable mFameOldVis as logical no-undo.
      404   define variable mVisCUrentVin as logical no-undo.
      405   if session:batch-mode
      406   then
      407      mBatchMode = yes.
      408   if mBatchMode = ? then do:
      409     mVisCUrentVin = current-window:visible.
      410     mFameOldVis = mFramBachModHandle:visible.
      411     mFramBachModHandle:visible  = yes.
      412     mBatchMode = mFramBachModHandle:visible ne yes.
      413     mFramBachModHandle:visible = mFameOldVis.
      414     current-window:visible = mVisCUrentVin.
      415   end.
      416    if  log-manager:logfile-name ne ?
      417     then DO:
      418         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      419         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      420         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      421     end.
      422   on choose of B-WaitFramStop in frame waitfram
      423   do:
      424     mWaitFramStop = yes.
      425     mWaitFramStopUser = yes.
      426   end.
      427   function waitfram-check-timeout returns logical():
      428      define variable vtime as int64 no-undo.
      429      if mWaitFramStopTimeOut
      430      then
      431         return yes.
      432      vtime = ( now - mWaitFramStartProc ) / 1000 .
      433      if     mWaitFramTimeOut ne ?
      434         and mWaitFramTimeOut ne 0
      435         and mWaitFramTimeOut lt vtime
      436      then do:
      437         mWaitFramStopTimeOut = yes.
      438      end.
      439      return mWaitFramStopTimeOut.
      440   end.
      441   procedure waitfram-hide :
      442     if not session:batch-mode
      443     then do
      444     on error undo, return error return-value
      445     :
      446       pause 0 before-hide .
      447       if not mBatchMode then
      448         hide frame waitfram .
      449     end.
      450   end procedure.
      451   procedure waitfram-show :
      452     define input  parameter p-message as character no-undo .
      453     define variable v-left-margin as integer   no-undo .
      454     if not session:batch-mode
      455     then do
      456     on error undo, return error return-value
      457     :
      458       if length(p-message) <= 70 then do:
      459         assign
      460           v-left-margin = integer((70 - length(p-message)) / 2)
      461         .
      462         assign
      463           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      464         .
      465         assign
      466           v-waitfram-action01 = " "
      467           v-waitfram-action02 = " "
      468                                    + fill(" ", v-left-margin)
      469                                    + p-message
      470           v-waitfram-action03 = " "
      471         .
      472       end.
      473       else do:
      474         define variable vRindex1 as integer no-undo.
      475         define variable vRindex2 as integer no-undo.
      476         vRindex1 = r-index(p-message," ",70).
      477         if vRindex1 = 0
      478         then
      479            vRindex1 = 70.
      480         if length(p-message)  <= vRindex1 + 70 then do:
      481           assign
      482             v-waitfram-action01 = " "
      483             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      484             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      485           .
      486         end.
      487         else do:
      488           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      489           if vRindex2 <= vRindex1
      490           then
      491              vRindex2 = vRindex1 + 70.
      492           assign
      493             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      494             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      495             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      496           .
      497         end.
      498       end.
      499       B-viewProcInfo:visible   in frame waitfram = no.
      500       B-viewProcInfo:sensitive in frame waitfram = no.
      501       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      502       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      503       if  (   mWaitFramView
      504          or  mWaitProcEvent)
      505          and not mBatchMode
      506       then
      507          display
      508             v-waitfram-action01 skip
      509             v-waitfram-action02 skip
      510             v-waitfram-action03 skip
      511          with frame waitfram .
      512     end.
      513   end procedure.
      514      procedure waitfram-show-this:
      515         define input  parameter iInterval as int64 no-undo.
      516         define variable vtime as int64 no-undo.
      517         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      518         mWaitFramInterval = iInterval.
      519         run waitfram-show (substitute("&1&2 &3&4" ,
      520                                       mWaitFramTextBeg ,
      521                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      522                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      523                                       mWaitFramTextEnd
      524                                      )
      525                           ).
      526      end.
      527      procedure WaitFramRunPause:
      528         define input  parameter iInterval as dec no-undo.
      529         define variable vStart  as datetime-tz no-undo.
      530         define variable vend    as datetime-tz no-undo.
      531         define variable vint as int64 no-undo.
      532         define variable vOk as logical no-undo.
      533         vStart = now.
      534         vend   = vStart.
      535         publish "WaitFramPause" (iInterval,output vOk).
      536         vend   =  now.
      537         vint = vend - vStart.
      538         vint = iInterval - vint / 1000.
      539         if     not mWaitFramStop
      540            and (   vint > 0
      541                 or (    not vOk
      542                     and iInterval eq ?
      543                     )
      544                 )
      545         then
      546            run waitfram-show-this (iInterval).
      547         vend   =  now.
      548         vint = vend - vStart.
      549         vint = iInterval - vint / 1000.
      550         if     not mWaitFramStop
      551            and vint > 0
      552         then do:
      553            run gbl/pause.p (vint * 1000).
      554         end.
      555         if iInterval ne ?
      556         then
      557            publish "WaitFramStop".
      558         waitfram-check-timeout().
      559      end.
      560      procedure WaitFramWaitFor:
      561         define input  parameter iInterval as dec no-undo.
      562         assign
      563            mWaitFramStartProc   = now
      564            mWaitFramStopUser    = no
      565            mWaitFramStopTimeOut = no
      566         .
      567         block-wait:
      568         do while not mWaitFramStop:
      569            run WaitFramRunPause (iInterval).
      570            if  waitfram-check-timeout()
      571            then do:
      572               leave block-wait.
      573            end.
      574         end.
      575         run waitfram-hide.
      576      end.
      577   procedure waitfram-join :
      578     define input  parameter p-line-1  as character no-undo .
      579     define input  parameter p-line-2  as character no-undo .
      580     define input  parameter p-line-3  as character no-undo .
      581     define output parameter p-message as character no-undo .
      582     do
      583     on error undo, return error return-value
      584     :
      585       assign
      586         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      587                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      588                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      589       .
      590     end.
      591   end procedure.
      592   function waitfram-join-function returns character
      593     (input p-line-1 as character
      594     ,input p-line-2 as character
      595     ,input p-line-3 as character
      596     ).
      597     define variable v-message as character no-undo .
      598     run waitfram-join in this-procedure
      599       (input  p-line-1
      600       ,input  p-line-2
      601       ,input  p-line-3
      602       ,output v-message
      603       ) .
      604     return v-message .
      605   end function .
