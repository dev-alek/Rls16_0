     2787   procedure diasize_init :
     2788     define variable v-default-value    as logical   no-undo .
     2789     define variable v-restore-saved    as logical   no-undo .
     2790     define variable v-resize-value-str as character no-undo .
     2791     do
     2792     on error undo, return error return-value
     2793     :
     2794       do with frame Dialog-Frame
     2795       :
     2796         assign
     2797           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2798           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2799           v-diasize-browse-handle     = browse br-obj-hist :handle
     2800         .
     2801         create button v-diasize-resize-button
     2802         assign
     2803           parent        = frame Dialog-Frame :first-child
     2804           label         = "s"
     2805           height-pixels = 16
     2806           width-pixels  = 16
     2807           visible       = true
     2808           sensitive     = true
     2809           movable       = true
     2810           triggers:
     2811             on end-move persistent run diasize_end-move in this-procedure .
     2812           end triggers.
     2813         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2814         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2815         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2816         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2817         assign
     2818           v-diasize-wndmax = false
     2819         .
     2820         if connected("ub") = true
     2821         then do:
     2822           define variable v-cntxt-db-num        as integer   no-undo .
     2823           define variable v-cntxt-userid        as character no-undo .
     2824           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2825                                             , OUTPUT v-cntxt-userid
     2826                                             ) .
     2827           run gbl/wndpar_r.p
     2828             (input  v-cntxt-db-num
     2829             ,input  v-cntxt-userid
     2830             ,input  'wndmax':U
     2831             ,output v-diasize-wndmax
     2832             ,output v-default-value
     2833             ) .
     2834         end.
     2835         assign
     2836           v-diasize-wndstore = false
     2837         .
     2838         if connected("ub") = true
     2839         then do:
     2840           run gbl/wndpar_r.p
     2841             (input  v-cntxt-db-num
     2842             ,input  v-cntxt-userid
     2843             ,input  'wndstore':U
     2844             ,output v-diasize-wndstore
     2845             ,output v-default-value
     2846             ) .
     2847         end.
     2848         assign
     2849           v-diasize-proc-name = entry(1, program-name(2), '.')
     2850         .
     2851         if v-diasize-wndstore = true
     2852         then do:
     2853           assign
     2854             v-restore-saved = false
     2855           .
     2856           if connected("ub") = true
     2857           then do:
     2858             run gbl/wndsizer.p
     2859               (input  v-cntxt-db-num
     2860               ,input  v-cntxt-userid
     2861               ,input  v-diasize-proc-name
     2862               ,input  'height':u
     2863               ,output v-resize-value-str
     2864               ) .
     2865             if v-resize-value-str <> '':U
     2866             then do:
     2867               run diasize_change-height in this-procedure
     2868                 (input  integer(v-resize-value-str)
     2869                 ,input  true
     2870                 ) .
     2871               assign
     2872                 v-restore-saved = true
     2873               .
     2874             end.
     2875           end.
     2876           if connected("ub") = true
     2877           then do:
     2878             run gbl/wndsizer.p
     2879               (input  v-cntxt-db-num
     2880               ,input  v-cntxt-userid
     2881               ,input  v-diasize-proc-name
     2882               ,input  'width':u
     2883               ,output v-resize-value-str
     2884               ) .
     2885             if v-resize-value-str <> '':U
     2886             then do:
     2887               run diasize_change-width in this-procedure
     2888                 (input  integer(v-resize-value-str)
     2889                 ,input  true
     2890                 ) .
     2891               assign
     2892                 v-restore-saved = true
     2893               .
     2894             end.
     2895           end.
     2896           if v-restore-saved <> true
     2897           then do:
     2898             if v-diasize-wndmax = true
     2899             then do:
     2900               run diasize_maximize in this-procedure
     2901                 (input  true
     2902                 ) .
     2903             end.
     2904           end.
     2905         end.
     2906         else do:
     2907           if v-diasize-wndmax = true
     2908           then do:
     2909             run diasize_maximize in this-procedure
     2910               (input  true
     2911               ) .
     2912           end.
     2913         end.
     2914       end.
     2915     end.
     2916   end procedure.
     2917   procedure diasize_need-full-display :
     2918     define output parameter p-need-full-display as logical   no-undo .
     2919     do
     2920     on error undo, return error return-value
     2921     :
