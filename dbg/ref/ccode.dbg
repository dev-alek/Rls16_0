      135   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      136   define variable c-point  as character no-undo .
      137   define variable tbl      as character no-undo .
      138   define variable join-tbl as character no-undo .
