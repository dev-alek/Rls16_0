     1080   FUNCTION get-all-fields returns character (p-file-name as character ):
     1081   define variable v-dop as character no-undo .
     1082     find first _file no-lock where _file._file-name = p-file-name no-error .
     1083     if not available _file then return "":U.
     1084     for each _field no-lock where
     1085              _field._file-recid = recid(_file) :
     1086       assign
     1087       v-dop = v-dop + _field._field-name + chr(44)
     1088       .
     1089     end.
     1090     return trim(v-dop).
     1091   END FUNCTION.
     1092   PROCEDURE proc-full-temp-changes :
     1093     define input  parameter p-act-create as logical   no-undo .
     1094     define input  parameter p-act-delete as logical   no-undo .
     1095     define input  parameter p-hst-handle as handle    no-undo .
     1096     define input  parameter p-main-table as character no-undo .
     1097     define input  parameter p-field-list as character no-undo .
     1098     define input  parameter p-label-form as character no-undo .
     1099     define variable h-new-buf         as handle    no-undo .
     1100     define variable h-main-buf        as handle    no-undo .
     1101     define variable h-for-comp        as handle    no-undo .
     1102     define variable v-inform          as character no-undo .
     1103     define variable v-ind             as integer   no-undo .
     1104     define variable v-idx-field-qnty  as integer   no-undo .
     1105     define variable v-num-entries     as integer   no-undo .
     1106     define variable fh                as handle    no-undo .
     1107     define variable fh-main           as handle    no-undo .
     1108     define variable fh-old            as handle    no-undo .
     1109     define variable fh-new            as handle    no-undo .
     1110     define variable v-field-name      as character no-undo .
     1111     define variable v-field-lvl       as character no-undo .
     1112     define variable v-field-form      as character no-undo .
     1113     define variable v-search-exp      as character no-undo .
     1114     define variable v-srch-main       as character no-undo .
     1115     define variable v-word-link       as character no-undo .
     1116     define variable v-av-chip-num     as logical   no-undo .
     1117     define variable v-main-pi-fld-lst as character no-undo .
     1118     define variable v-main-fld-lst    as character no-undo .
     1119     define variable v-delim-list      as character no-undo .
     1120     define variable v-label           as character no-undo .
     1121     define variable v-old-value       as character no-undo case-sensitive.
     1122     define variable v-new-value       as character no-undo case-sensitive.
     1123     define variable v-chg-fields as character no-undo.
     1124     for each temp-changes:
     1125       delete temp-changes.
     1126     end.
     1127     if not p-hst-handle:available then do:
     1128       return .
     1129     end.
     1130     create buffer h-new-buf  for table p-hst-handle .
     1131     create buffer h-main-buf for table p-main-table .
     1132     assign
     1133       v-inform = h-main-buf:index-information(1)
     1134       v-ind    = 2
     1135     .
     1136     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1137     on error undo, return error
     1138     :
     1139       assign
     1140         v-inform = h-main-buf:index-information( v-ind )
     1141         v-ind    = v-ind + 1
     1142       .
     1143     end.
     1144     if v-inform = ?
     1145       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1146       or entry( 3, v-inform, ",":U ) <> "1":U
     1147     then do:
     1148       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, h-main-buf:name ).
     1149     end.
     1150     assign
     1151       v-idx-field-qnty = num-entries( v-inform ) - 4
     1152     .
     1153     if v-idx-field-qnty < 2 then do:
     1154       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, h-main-buf:name ).
     1155     end.
     1156     assign
     1157       v-srch-main   = "where":U
     1158       v-word-link   = "":U
     1159       v-av-chip-num = false
     1160       v-delim-list  = "":U
     1161     .
     1162     do v-ind = 1 to v-idx-field-qnty by 2
     1163     on error undo, return error
     1164     :
     1165       assign
     1166         v-field-name      = entry( 4 + v-ind, v-inform, ",":U )
     1167         fh                = p-hst-handle:buffer-field( v-field-name )
     1168         fh-main           = h-main-buf:buffer-field( v-field-name )
     1169         v-srch-main       = substitute( "&1 &2 &3.&4 =", v-srch-main, v-word-link, fh-main:table, v-field-name )
     1170         v-main-pi-fld-lst = v-main-pi-fld-lst + v-delim-list + v-field-name
     1171       .
     1172       if fh:data-type ="character":U then do:
     1173         assign
     1174           v-srch-main = substitute( '&1 "&2"', v-srch-main, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1175         .
     1176       end.
     1177       else do:
     1178         assign
     1179           v-srch-main = substitute( "&1 &2", v-srch-main, fh:buffer-value() )
     1180         .
     1181       end.
     1182       if v-delim-list = "":U then do:
     1183         assign
     1184           v-delim-list = ",":U
     1185         .
     1186       end.
     1187       if v-word-link = "":U then do:
     1188         assign
     1189           v-word-link = "and":U
     1190         .
     1191       end.
     1192     end.
     1193     assign
     1194       v-delim-list  = "":U
     1195     .
     1196     do v-ind = 1 to h-main-buf:num-fields
     1197     on error undo, return error
     1198     :
     1199       assign
     1200         fh-main      = h-main-buf:buffer-field( v-ind )
     1201         v-field-name = fh-main:name
     1202       .
     1203         assign
     1204           v-main-fld-lst = v-main-fld-lst + v-delim-list + v-field-name
     1205         .
     1206         if v-delim-list = "":U then do:
     1207           assign
     1208             v-delim-list = ",":U
     1209           .
     1210         end.
     1211     end.
     1212     assign
     1213       v-inform = p-hst-handle:index-information(1)
     1214       v-ind    = 2
     1215     .
     1216     do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1217     on error undo, return error
     1218     :
     1219       assign
     1220         v-inform = p-hst-handle:index-information( v-ind )
     1221         v-ind    = v-ind + 1
     1222       .
     1223     end.
     1224     if v-inform = ?
     1225       or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1226       or entry( 3, v-inform, ",":U ) <> "1":U
     1227     then do:
     1228       return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-workfile, p-hst-handle:name ).
     1229     end.
     1230     assign
     1231       v-idx-field-qnty = num-entries( v-inform ) - 4
     1232     .
     1233     if v-idx-field-qnty < 2 then do:
     1234       return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-workfile, v-inform, p-hst-handle:name ).
     1235     end.
     1236     assign
     1237       v-search-exp  = "where":U
     1238       v-word-link   = "":U
     1239       v-av-chip-num = false
     1240     .
     1241     do v-ind = 1 to v-idx-field-qnty by 2
     1242     on error undo, return error
     1243     :
     1244       assign
     1245         v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1246         fh           = p-hst-handle:buffer-field( v-field-name )
     1247         v-search-exp = substitute( "&1 &2 &3.&4", v-search-exp, v-word-link, fh:table, v-field-name )
     1248       .
     1249       if v-field-name = "chip-num":U then do:
     1250         assign
     1251           v-search-exp  = substitute( "&1 >", v-search-exp )
     1252           v-av-chip-num = true
     1253         .
     1254       end.
     1255       else do:
     1256         assign
     1257           v-search-exp = substitute( "&1 =", v-search-exp )
     1258         .
     1259       end.
     1260       if fh:data-type ="character":U then do:
     1261         assign
     1262           v-search-exp = substitute( '&1 "&2"', v-search-exp, replace( replace( fh:buffer-value(), '"':U, '""':U ), '~~':U, '~~~~':U ) )
     1263         .
     1264       end.
     1265       else do:
     1266         assign
     1267           v-search-exp = substitute( '&1 &2', v-search-exp, fh:buffer-value() )
     1268         .
     1269       end.
     1270       if v-word-link = "":U then do:
     1271         assign
     1272           v-word-link = "and":U
     1273         .
     1274       end.
     1275     end.
     1276     if v-av-chip-num = false then do:
     1277       message
     1278         vss-workfile vss-revision vss-description skip
     1279         substitute( "Таблица &2 не содержит поля chip-num.", vss-workfile, p-hst-handle:name ) skip
     1280         "Использование данной процедуры невозможно!" skip
     1281         view-as alert-box error .
     1282       return error .
     1283     end.
     1284     h-new-buf:find-first( v-search-exp, no-lock ) no-error .
     1285     if not h-new-buf:available then do:
     1286       h-main-buf:find-first( v-srch-main, no-lock ) no-error .
     1287       if not h-main-buf:available then do:
     1288         assign
     1289           h-for-comp = ?
     1290         .
     1291       end.
     1292       else do:
     1293         assign
     1294           h-for-comp = h-main-buf
     1295         .
     1296       end.
     1297     end.
     1298     else do:
     1299       assign
     1300         h-for-comp = h-new-buf
     1301       .
     1302     end.
     1303     assign
     1304       v-num-entries = num-entries( v-main-fld-lst, ",":U )
     1305     .
     1306     do v-ind = 1 to v-num-entries
     1307     on error undo, return error return-value
     1308     :
     1309       assign
     1310         v-field-name = entry( v-ind, v-main-fld-lst )
     1311         fh-old       = p-hst-handle:buffer-field( v-field-name )
     1312         v-old-value  = fh-old:buffer-value()
     1313         v-label      = trim( fh-old:label )
     1314       .
     1315       if ( trim( p-field-list ) <> "":U
     1316            and lookup( v-field-name, p-field-list ) > 0
     1317          )
     1318          or trim( p-field-list ) = "":U
     1319       then do:
     1320         if h-for-comp <> ? then do:
     1321           assign
     1322             fh-new      = h-for-comp:buffer-field( v-field-name )
     1323             v-new-value = fh-new:buffer-value()
     1324           .
     1325         end.
     1326         else do:
     1327           assign
     1328             v-new-value = "":U
     1329           .
     1330         end.
     1331           if p-act-create = true then do:
     1332             assign
     1333               v-old-value = "":U
     1334             .
     1335           end.
     1336           if p-act-delete = true then do:
     1337             assign
     1338               v-new-value = "":U
     1339             .
     1340           end.
     1341         if v-old-value <> v-new-value
     1342           or lookup(v-field-name,v-main-pi-fld-lst) ne 0
     1343         then do:
     1344           create temp-changes.
     1345           assign
     1346             temp-changes.t_name = p-main-table
     1347             temp-changes.f_name = v-field-name
     1348             temp-changes.l_name = replace( v-label, "&":U, "":U )
     1349             temp-changes.v_old  = trim( v-old-value )
     1350             temp-changes.v_new  = trim( v-new-value )
     1351             temp-changes.num_   = 0
     1352             temp-changes.fNotChange = v-old-value eq v-new-value
     1353           .
     1354         end.
     1355       end.
     1356     end.
     1357     assign
     1358       v-num-entries = num-entries( p-label-form, chr(8) )
     1359     .
     1360         run ParentPars (if p-act-create = true then ? else p-hst-handle,
     1361                             if p-act-delete = true then ? else h-for-comp).
     1362     do v-ind = 1 to v-num-entries
     1363     on error undo, return error return-value
     1364     :
     1365       if num-entries( entry( v-ind, p-label-form, chr(8) ), chr(4) ) = 3 then do:
     1366         assign
     1367           v-field-name = entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1368           v-field-lvl  = entry( 2, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1369           v-field-form = entry( 3, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1370         .
     1371         find first temp-changes
     1372           where temp-changes.f_name = v-field-name
     1373           no-error .
     1374         if available temp-changes then do:
     1375           if trim( v-field-lvl ) <> "":U then do:
     1376             assign
     1377               temp-changes.l_name = v-field-lvl
     1378             .
     1379           end.
     1380           if trim( v-field-form ) <> "":U then do:
     1381             assign
     1382               temp-changes.v_old = dynamic-function( v-field-form, temp-changes.v_old )
     1383             .
     1384             if h-for-comp <> ? then do:
     1385               assign
     1386                 temp-changes.v_new = dynamic-function( v-field-form, temp-changes.v_new )
     1387               .
     1388             end.
     1389           end.
     1390         end.
     1391       end.
     1392       else do:
     1393         message
     1394           vss-workfile vss-revision vss-description skip
     1395           "Ошибка! Список должен содержать три поля с разделителем delim-par!" skip
     1396           substitute( "список для поля '&1': '&2'"
     1397                       ,entry( 1, entry( v-ind, p-label-form, chr(8) ), chr(4) )
     1398                       ,entry( v-ind, p-label-form, chr(8) )
     1399                     ) skip
     1400           substitute( "полный список: &2", p-label-form ) skip
     1401           view-as alert-box error .
     1402       end.
     1403     end.
     1404     delete object h-new-buf .
     1405     delete object h-main-buf .
     1406   END PROCEDURE.
     1407   FUNCTION get-action RETURNS CHARACTER
     1408     ( p-action as integer )  FORWARD.
     1409   FUNCTION get-source-type RETURNS CHARACTER
     1410     ( p-source-type as character )  FORWARD.
     1411   FUNCTION get-subject RETURNS CHARACTER
     1412     ( p-subject as character )  FORWARD.
     1413   FUNCTION local-open-br RETURNS logical
     1414     (  p-open-query     as logical    ,
     1415     p-find-next       as logical    ,
     1416     p-find-condition as character )  FORWARD.
     1417   DEFINE BUTTON B-Help
     1418        LABEL "Помо&щь"
     1419        SIZE 3 BY 1
     1420        BGCOLOR 8 .
     1421   DEFINE BUTTON B-mark
     1422        LABEL "&*"
     1423        SIZE 3 BY 1.
     1424   DEFINE BUTTON B-print
     1425        LABEL "Пе&чать"
     1426        SIZE 3 BY 1.
     1427   DEFINE BUTTON b-quit AUTO-END-KEY
     1428        LABEL "&Выход"
     1429        SIZE 10 BY 1
     1430        BGCOLOR 8 .
     1431   DEFINE BUTTON b-reason
     1432        LABEL "&Причина"
     1433        SIZE 10 BY 1.
     1434   DEFINE BUTTON B-sch
     1435        LABEL "&Фильтр"
     1436        SIZE 3 BY 1.
     1437   DEFINE BUTTON b-sel AUTO-GO
     1438        LABEL "Вы&бор"
     1439        SIZE 10 BY 1
     1440        BGCOLOR 8 .
     1441   DEFINE BUTTON b-nextlevel
     1442        LABEL "Детали"
     1443        SIZE 10 BY 1
     1444        BGCOLOR 8 .
     1445   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
     1446         VIEW-AS TEXT
     1447        SIZE 6 BY 1
     1448        FGCOLOR 4  NO-UNDO.
     1449   DEFINE VARIABLE sch-obj-code AS CHARACTER FORMAT "X(50)":U
     1450        LABEL "коду"
     1451        VIEW-AS FILL-IN
     1452        SIZE 10 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1453   DEFINE VARIABLE sch-corr-date AS DATE FORMAT "99/99/9999":U
     1454        LABEL "Дате изменения"
     1455        VIEW-AS FILL-IN
     1456        SIZE 11 BY 1 NO-UNDO.
     1457   DEFINE VARIABLE sch-corr-user-name AS CHARACTER FORMAT "X(9)":U
     1458        LABEL "пользователю"
     1459        VIEW-AS FILL-IN
     1460        SIZE 12 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1461   DEFINE VARIABLE sch-db-num AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1462        LABEL "БД"
     1463        VIEW-AS FILL-IN
     1464        SIZE 8 BY 1 TOOLTIP "Поиск первой записи - <ВВОД>; поиск следующей - <CTRL-J>" NO-UNDO.
     1465   DEFINE VARIABLE v-corr-user-db-num AS INTEGER FORMAT ">>>>9":U INITIAL 0
     1466        LABEL "по БД"
     1467        VIEW-AS FILL-IN
     1468        SIZE 6 BY 1 NO-UNDO.
     1469   DEFINE QUERY BR-changes FOR
     1470         temp-changes SCROLLING.
     1471   DEFINE QUERY br-obj-hist FOR
     1472         X_c-obj-hist SCROLLING.
     1473   DEFINE BROWSE BR-changes
     1474     QUERY BR-changes DISPLAY
     1475         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(200)" width 40
     1476   temp-changes.v_old COLUMn-LABEL "Было" format "X(255)"
     1477   temp-changes.v_new COLUMn-LABEL "Стало" format "X(255)"
     1478       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 7.25.
     1479   DEFINE BROWSE br-obj-hist
     1480     QUERY br-obj-hist NO-LOCK DISPLAY
     1481         mark-string(recid(X_c-obj-hist), v-rid-list) COLUMN-LABEL "*" FORMAT "X(1)":U
     1482         X_c-obj-hist.corr-date FORMAT "99/99/9999":U COLUMN-LABEL "Дата изм."
     1483         string(X_c-obj-hist.corr-time, "HH:MM:SS":U) COLUMN-LABEL "Время изм." FORMAT "X(8)":U
     1484         usrfulnf(X_c-obj-hist.corr-user-name) COLUMn-LABEL "Изменил" FORMAT "X(255)":U width 18
     1485         get-action(X_c-obj-hist.action) COLUMN-LABEL "Действие" FORMAT "X(10)":U
     1486         X_c-obj-hist.corr-user-db-num FORMAT ">>>>9":U COLUMN-LABEL "Дб!созд."
     1487     ENABLE
     1488         X_c-obj-hist.corr-date
     1489       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 11.46.
     1490   DEFINE FRAME Dialog-Frame
     1491        b-quit AT ROW 1 COL 1
     1492        B-mark AT ROW 1 COL 11
     1493        b-sel AT ROW 1 COL 21
     1494        v-corr-user-db-num AT ROW 1 COL 37 COLON-ALIGNED
     1495        b-nextlevel AT ROW 1 COL 70
     1496        b-reason AT ROW 1 COL 59
     1497        B-print AT ROW 1 COL 89
     1498        B-sch AT ROW 1 COL 92
     1499        B-Help AT ROW 1 COL 95
     1500        br-obj-hist AT ROW 2 COL 1
     1501        sch-db-num AT ROW 13.63 COL 60.13 COLON-ALIGNED
     1502        sch-corr-date AT ROW 13.63 COL 85.75 COLON-ALIGNED
     1503        sch-obj-code AT ROW 13.67 COL 45.13 COLON-ALIGNED
     1504        sch-corr-user-name AT ROW 13.71 COL 22.5 COLON-ALIGNED
     1505        BR-changes AT ROW 14.79 COL 1
     1506        mark-num AT ROW 1 COL 12.5 COLON-ALIGNED NO-LABEL
     1507        "ПОИСК ПО" VIEW-AS TEXT
     1508             SIZE 8.38 BY 1 AT ROW 13.63 COL 1.38
     1509             FGCOLOR 4
     1510        SPACE(89.48) SKIP(7.44)
     1511       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1512            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1513            TITLE
     1514            fLabel()
     1515            CANCEL-BUTTON b-quit.
     1516   ASSIGN
     1517          FRAME Dialog-Frame:SCROLLABLE       = FALSE
     1518          FRAME Dialog-Frame:HIDDEN           = TRUE.
     1519   ASSIGN
     1520          br-obj-hist:COLUMN-RESIZABLE IN FRAME Dialog-Frame       = TRUE.
     1521   ON GO OF FRAME Dialog-Frame
     1522   DO:
     1523     p-rid-list = v-rid-list.
     1524   END.
     1525   ON WINDOW-CLOSE OF FRAME Dialog-Frame
     1526   DO:
     1527     APPLY "END-ERROR":U TO SELF.
     1528   END.
     1529   ON CHOOSE OF B-mark IN FRAME Dialog-Frame
     1530   DO:
     1531   define variable loc#log as logical no-undo .
     1532     if available X_c-obj-hist then do:
     1533   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1534   define variable v-str-recid15 as character no-undo .
     1535   define variable v-num-entry15 as integer   no-undo .
     1536   assign
     1537     v-str-recid15 = trim( string( recid( X_c-obj-hist ) , "->>>>>>>>>>>9":U ) )
     1538     v-num-entry15 = lookup( v-str-recid15 , v-rid-list )
     1539   .
     1540   if v-num-entry15 > 0 then do:
     1541     assign
     1542       entry( v-num-entry15, v-rid-list ) = "":U
     1543       v-rid-list = trim( replace( v-rid-list , chr(44) + chr(44) , chr(44) ) , chr(44) )
     1544     .
     1545   end.
     1546   else do:
     1547     assign
     1548       v-rid-list = v-rid-list + ( if v-rid-list = "":U then "":U else chr(44) ) + v-str-recid15
     1549     .
     1550   end.
     1551       loc#log = br-obj-hist:refresh() .
     1552       if last-event:function <> "MOUSE-SELECT-DBLCLICK" then do:
     1553           loc#log = br-obj-hist:select-next-row ().
     1554           apply "VALUE-CHANGED" to br-obj-hist in frame Dialog-Frame.
     1555       end.
     1556       if num-entries( v-rid-list ) = 0
     1557       then
     1558           hide mark-num in frame Dialog-Frame.
     1559       else
     1560           disp num-entries( v-rid-list ) @ mark-num with frame Dialog-Frame.
     1561     end.
     1562     apply "entry" to br-obj-hist in frame Dialog-Frame.
     1563   END.
     1564   ON CHOOSE OF b-nextlevel IN FRAME Dialog-Frame
     1565   DO:
     1566      define variable vRun as character no-undo.
     1567      vRun = this-procedure:file-name.
     1568      run value(vRun)
     1569         (
     1570          iParent,
     1571          iCode,
     1572          parParentProc,
     1573          p-curr-host-code,
     1574          p-curr-obj-type,
     1575          p-curr-obj-code,
     1576          bttns,
     1577          "one",
     1578          p-corr-user-db-num,
     1579          p-corr-user-name,
     1580          p-subject,
     1581          p-db-num,
     1582          X_c-obj-hist.chip-num ,
     1583          input-output p-rid-list ).
     1584      apply "entry" to br-obj-hist in frame Dialog-Frame.
     1585   END.
     1586   ON CHOOSE OF B-print IN FRAME Dialog-Frame
     1587   DO:
     1588       run proc-b-print in this-procedure no-error.
     1589     if error-status:error then return no-apply.
     1590   END.
     1591   ON CHOOSE OF B-sch IN FRAME Dialog-Frame
     1592   DO:
     1593       run proc-b-sch in this-procedure no-error.
     1594     if error-status:error then return no-apply.
     1595   END.
     1596   ON CHOOSE OF b-sel IN FRAME Dialog-Frame
     1597   DO:
     1598     if ( available X_c-obj-hist ) then do:
     1599       if ( v-rid-list = "" ) or b-mark:sensitive = no
     1600       then
     1601       v-rid-list = string( recid( X_c-obj-hist ) ) .
     1602     end.
     1603   END.
     1604   ON MOUSE-SELECT-DBLCLICK OF br-obj-hist IN FRAME Dialog-Frame
     1605   DO:
     1606        run proc-br-obj-hist in this-procedure no-error.
     1607     if error-status:error then return no-apply.
     1608   END.
     1609   ON RETURN OF br-obj-hist IN FRAME Dialog-Frame
     1610   DO:
     1611       run proc-br-obj-hist in this-procedure no-error.
     1612     if error-status:error then return no-apply.
     1613   END.
     1614   ON VALUE-CHANGED OF br-obj-hist IN FRAME Dialog-Frame
     1615   DO:
     1616     run proc-view-changes in this-procedure no-error.
     1617   END.
     1618   ON ROW-DISPLAY OF BR-changes IN FRAME Dialog-Frame
     1619   DO:
     1620      if temp-changes.fNotChange
     1621      then do:
     1622         temp-changes.l_name:fGCOLOR in browse BR-changes = GRAY_COLOR.
     1623         temp-changes.v_old:fGCOLOR in browse BR-changes  = GRAY_COLOR.
     1624         temp-changes.v_new:fGCOLOR in browse BR-changes  = GRAY_COLOR.
     1625      end.
     1626      else do:
     1627         temp-changes.l_name:fGCOLOR in browse BR-changes = BLACK_COLOR.
     1628         temp-changes.v_old:fGCOLOR in browse BR-changes = BLACK_COLOR.
     1629         temp-changes.v_new:fGCOLOR in browse BR-changes = BLACK_COLOR.
     1630      end.
     1631   END.
     1632   ON CTRL-J OF sch-obj-code IN FRAME Dialog-Frame
     1633   DO:
     1634     run proc-find-obj-code in this-procedure(yes, input frame Dialog-Frame sch-obj-code) no-error.
     1635     if error-status:error then return no-apply.
     1636   END.
     1637   ON RETURN OF sch-obj-code IN FRAME Dialog-Frame
     1638   DO:
     1639     run proc-find-obj-code in this-procedure(no, input frame Dialog-Frame sch-obj-code) no-error.
     1640     if error-status:error then return no-apply.
     1641   END.
     1642   ON CTRL-J OF sch-corr-date IN FRAME Dialog-Frame
     1643   DO:
     1644      run proc-find-corr-date in this-procedure(yes, input frame Dialog-Frame sch-corr-date) no-error.
     1645     if error-status:error then return no-apply.
     1646   END.
     1647   ON RETURN OF sch-corr-date IN FRAME Dialog-Frame
     1648   DO:
     1649     run proc-find-corr-date in this-procedure(no, input frame Dialog-Frame sch-corr-date) no-error.
     1650     if error-status:error then return no-apply.
     1651   END.
     1652   ON CTRL-J OF sch-corr-user-name IN FRAME Dialog-Frame
     1653   DO:
     1654     run proc-find-user in this-procedure(yes, input frame Dialog-Frame sch-corr-user-name) no-error.
     1655     if error-status:error then return no-apply.
     1656   END.
     1657   ON RETURN OF sch-corr-user-name IN FRAME Dialog-Frame
     1658   DO:
     1659     run proc-find-user in this-procedure(no, input frame Dialog-Frame sch-corr-user-name) no-error.
     1660     if error-status:error then return no-apply.
     1661   END.
     1662   ON CTRL-J OF sch-db-num IN FRAME Dialog-Frame
     1663   DO:
     1664     run proc-find-db-num in this-procedure(yes, input frame Dialog-Frame sch-db-num) no-error.
     1665     if error-status:error then return no-apply.
     1666   END.
     1667   ON RETURN OF sch-db-num IN FRAME Dialog-Frame
     1668   DO:
     1669     run proc-find-db-num in this-procedure(no, input frame Dialog-Frame sch-db-num) no-error.
     1670     if error-status:error then return no-apply.
     1671   END.
     1672   ON RETURN OF v-corr-user-db-num IN FRAME Dialog-Frame
     1673   DO:
     1674     assign
     1675     v-corr-user-db-num
     1676     .
     1677     RUn OpenBR(yes, no, '':U, v-corr-user-db-num).
     1678   END.
     1679   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1680   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1681   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1682   on help of frame Dialog-Frame
     1683   do:
     1684     run gbl/app_help.p
     1685       (input this-procedure :file-name
     1686       ,input ''
     1687       ,input ?
     1688       ) no-error.
     1689     if error-status :error then do:
     1690       message
     1691         "Ошибка при вызове помощи"
     1692         error-status :get-message(1)
     1693         view-as alert-box .
     1694     end.
     1695   end.
     1696   run minbtn-set in this-procedure .
     1697   on choose of b-help in frame Dialog-Frame
     1698   do:
     1699     apply "help":u to frame Dialog-Frame .
     1700   end.
     1701   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1702   procedure minbtn-set :
     1703       do
     1704           on error undo, return error return-value
     1705           :
     1706           define variable ii              as integer       no-undo .
     1707           define variable fh              as widget-handle no-undo .
     1708           define variable hh              as widget-handle no-undo .
     1709           define variable v-h             as handle        extent 4 no-undo .
     1710           define variable v-name-button   as character     no-undo .
     1711           define variable v-help-old-x    as decimal       no-undo .
     1712           define variable v-help-old-y    as decimal       no-undo .
     1713           define variable v-help-old-size as decimal       no-undo .
     1714           define variable v-frame-width   as decimal       no-undo .
     1715           define variable jj              as integer       no-undo .
     1716           do
     1717               on error undo, return error
     1718               :
     1719               assign
     1720                   v-frame-width = frame Dialog-Frame:width - 0.3
     1721                   fh            = frame Dialog-Frame:first-child
     1722                   hh            = fh:first-child
     1723                   ii            = 1
     1724                   .
     1725               do while valid-handle(hh):
     1726                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     1727                   do:
     1728                       case lc(hh:name) :
     1729                           when "b-help" then
     1730                               do:
     1731                                   hh:load-image-up("cmp/b-help.bmp":u) .
     1732                                   hh:load-image-down("cmp/b-help.bmp":u) .
     1733                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     1734                                   hh:TOOLTIP = "Помощь" .
     1735                                   v-help-old-x = hh:column .
     1736                                   v-help-old-y = hh:row    .
     1737                                   v-help-old-size = hh:width .
     1738                                   hh:width-chars = 2.5 .
     1739                               end.
     1740                           when "b-print" then
     1741                               do:
     1742                                   hh:load-image("cmp/b-print.bmp":u) .
     1743                                   hh:TOOLTIP = "Печать" .
     1744                                   v-h[ii] = hh:handle .
     1745                                   ii = ii + 1 .
     1746                                   hh:width-chars = 3 .
     1747                               end.
     1748                           when "b-history" or
     1749                           when "b-hist" then
     1750                               do:
     1751                                   hh:load-image("cmp/b-hist.bmp":u) .
     1752                                   hh:TOOLTIP = "История" .
     1753                                   v-h[ii] = hh:handle .
     1754                                   ii = ii + 1 .
     1755                                   hh:width-chars = 3 .
     1756                               end.
     1757                           when "b-sch" then
     1758                               do:
     1759                                   hh:load-image("cmp/b-sch.bmp":u) .
     1760                                   hh:TOOLTIP = "Установка Фильтра" .
     1761                                   v-h[ii] = hh:handle .
     1762                                   ii = ii + 1 .
     1763                                   hh:width-chars = 3 .
     1764                               end.
     1765                           when "b-hist-user" then
     1766                               do:
     1767                                   hh:load-image("cmp/b-hist.bmp":u) .
     1768                                   hh:TOOLTIP = "История пользователя" .
     1769                                   ii = ii + 1 .
     1770                               end.
     1771                       end case.
     1772                   end.
     1773                   hh = hh:next-sibling.
     1774               end.
     1775               b-help:column = v-frame-width - b-help:width-chars.
     1776               jj = 0.
     1777               repeat ii = 4 to 1 by -1 :
     1778                   if valid-handle (v-h[ii] ) then
     1779                   do:
     1780                       jj  = jj + 1 .
     1781                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1782                       v-h[ii]:row    = v-help-old-y .
     1783                   end.
     1784               end.
     1785           end.
     1786       end.
     1787   end procedure.
     1788   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     1789   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     1790   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     1791   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     1792   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1793   define variable v-diasize-current-frame-height as decimal   no-undo .
     1794   define variable v-diasize-change-size          as logical   no-undo .
     1795   define variable v-diasize-resize-button        as handle    no-undo .
     1796   define variable v-diasize-wndmax               as logical   no-undo .
     1797   define variable v-diasize-wndstore             as logical   no-undo .
     1798   define variable v-diasize-proc-name            as character no-undo .
     1799   define variable v-diasize-browse-handle        as handle    no-undo .
     1800   define variable v-diasize-browse-number        as integer   no-undo .
     1801   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1802   define temp-table temp-diasize-handle no-undo
     1803     field handle-value  as handle
     1804     field save-position as decimal
     1805     index xpk is primary unique handle-value
     1806     .
     1807   define temp-table temp-browse-handle no-undo
     1808     field browse-type   as character
     1809     field browse-number as integer
     1810     field browse-handle as handle
     1811     field original-size as decimal
     1812     index xpk is primary unique browse-type browse-number
     1813     index xie browse-type browse-handle
     1814   .
     1815   procedure diasize_change-height :
     1816     define input  parameter p-change-value  as decimal   no-undo .
     1817     define input  parameter p-move-resize   as logical   no-undo .
     1818     define variable v-field-group-handle    as handle    no-undo .
     1819     define variable v-object-handle         as handle    no-undo .
     1820     define variable v-frame-height          as decimal   no-undo .
     1821     define variable v-frame-virtual-height  as decimal   no-undo .
     1822     define variable v-browse-height         as decimal   no-undo .
     1823     define variable v-window-height         as decimal   no-undo .
     1824     define variable v-window-virtual-height as decimal   no-undo .
     1825     define variable v-change-sign           as integer   no-undo .
     1826     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1827     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1828     if p-change-value > 0
     1829     then do:
     1830       if frame Dialog-Frame :height + p-change-value
     1831           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1832       then do:
     1833         assign
     1834           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1835                           - (frame Dialog-Frame :height-chars)
     1836         .
     1837         if p-change-value <= 0
     1838         then do:
     1839           run diasize_position-resize-button in this-procedure .
     1840           return .
     1841         end.
     1842       end.
     1843     end.
     1844     if p-change-value < 0
     1845     then do:
     1846       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1847       then do:
     1848         assign
     1849           p-change-value = v-diasize-orig-frame-height
     1850                          - (frame Dialog-Frame :height-chars)
     1851         .
     1852         if p-change-value >= 0
     1853         then do:
     1854           run diasize_position-resize-button in this-procedure .
     1855           return .
     1856         end.
     1857       end.
     1858     end.
     1859     if p-change-value >= 0
     1860     then do:
     1861       assign
     1862         v-change-sign = 1
     1863       .
     1864     end.
     1865     else do:
     1866       assign
     1867         v-change-sign = -1
     1868       .
     1869     end.
     1870     assign
     1871       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1872     .
     1873     if p-change-value = 0
     1874     then do:
     1875       run diasize_position-resize-button in this-procedure .
     1876       return .
     1877     end.
     1878     move_block:
     1879     do
     1880     on error undo move_block, retry move_block
     1881     :
     1882       if retry
     1883       then do:
     1884         do
     1885         on error undo move_block, leave move_block
     1886         :
     1887           if p-change-value > 0
     1888           then do:
     1889             for each buf_temp-diasize-handle
     1890             on error undo, next
     1891             :
     1892               assign
     1893                 v-object-handle = buf_temp-diasize-handle.handle-value
     1894               .
     1895               if v-object-handle <> v-diasize-resize-button
     1896               then do:
     1897                 assign
     1898                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1899                 .
     1900               end.
     1901             end.
     1902             assign
     1903               v-diasize-browse-handle :height = v-browse-height
     1904             .
     1905             for each buf_temp-browse-handle
     1906               where buf_temp-browse-handle.browse-type = 'height':u
     1907             on error undo, next
     1908             :
     1909               assign
     1910                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1911               .
     1912             end.
     1913             assign
     1914               frame Dialog-Frame :height = v-frame-height
     1915             .
     1916             if frame Dialog-Frame :scrollable = true
     1917             then do:
     1918               assign
     1919                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1920               .
     1921             end.
     1922             run diasize_position-resize-button in this-procedure .
     1923           end.
     1924           else do:
     1925             if frame Dialog-Frame :scrollable = true
     1926             then do:
     1927               assign
     1928                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1929               .
     1930             end.
     1931             assign
     1932               frame Dialog-Frame :height = v-frame-height
     1933             .
     1934             assign
     1935               v-diasize-browse-handle :height = v-browse-height
     1936             .
     1937             for each buf_temp-browse-handle
     1938               where buf_temp-browse-handle.browse-type = 'height':u
     1939             on error undo, next
     1940             :
     1941               assign
     1942                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1943               .
     1944             end.
     1945             for each buf_temp-diasize-handle
     1946             on error undo, next
     1947             :
     1948               assign
     1949                 v-object-handle = buf_temp-diasize-handle.handle-value
     1950               .
     1951               if v-object-handle <> v-diasize-resize-button
     1952               then do:
     1953                 assign
     1954                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1955                 .
     1956               end.
     1957             end.
     1958             run diasize_position-resize-button in this-procedure .
     1959           end.
     1960           assign
     1961             v-diasize-change-size = false
     1962           .
     1963           leave move_block .
     1964         end.
     1965       end.
     1966       assign
     1967         v-diasize-need-full-display = true
     1968       .
     1969       if v-diasize-change-size = false
     1970       then do:
     1971         assign
     1972           v-diasize-change-size = true
     1973         .
     1974       end.
     1975       else do:
     1976         return .
     1977       end.
     1978       assign
     1979         v-frame-height = frame Dialog-Frame :height
     1980         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1981         v-browse-height = v-diasize-browse-handle :height
     1982       .
     1983       for each buf_temp-browse-handle
     1984         where buf_temp-browse-handle.browse-type = 'height':u
     1985       :
     1986         assign
     1987           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1988         .
     1989       end.
     1990       for each buf_temp-diasize-handle
     1991       :
     1992         delete buf_temp-diasize-handle .
     1993       end.
     1994       assign
     1995         v-field-group-handle = frame Dialog-Frame :first-child
     1996       .
     1997       do while valid-handle(v-field-group-handle)
     1998       :
     1999         assign
     2000           v-object-handle = v-field-group-handle :first-child
     2001         .
     2002         do while valid-handle(v-object-handle)
     2003         :
     2004           if  v-object-handle <> v-diasize-browse-handle :handle
     2005           and can-query(v-object-handle, "row")
     2006           and can-query(v-object-handle, "height")
     2007           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2008           then do:
     2009             find first buf_temp-browse-handle
     2010               where buf_temp-browse-handle.browse-type   = 'height':u
     2011                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2012               no-error .
     2013             if available buf_temp-browse-handle
     2014             then do:
     2015             end.
     2016             else do:
     2017               create buf_temp-diasize-handle .
     2018               assign
     2019                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2020                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2021               .
     2022             end.
     2023           end.
     2024           assign
     2025             v-object-handle = v-object-handle :next-sibling
     2026           .
     2027         end.
     2028         assign
     2029           v-field-group-handle = v-field-group-handle :next-sibling
     2030         .
     2031       end.
     2032       do with frame Dialog-Frame
     2033       :
     2034         hide v-diasize-resize-button .
     2035         assign
     2036           v-diasize-resize-button :row    = 1
     2037           v-diasize-resize-button :column = 1
     2038         .
     2039       end.
     2040       if p-change-value > 0
     2041       then do:
     2042         if frame Dialog-Frame :scrollable = true
     2043         then do:
     2044           assign
     2045             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2046             no-error .
     2047           if error-status :error
     2048           or error-status :get-message(1) <> ""
     2049           then do:
     2050             undo move_block, retry move_block .
     2051           end.
     2052         end.
     2053         assign
     2054           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2055           no-error .
     2056         if error-status :error
     2057         or error-status :get-message(1) <> ""
     2058         then do:
     2059           undo move_block, retry move_block .
     2060         end.
     2061         assign
     2062           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2063           no-error .
     2064         if error-status :error
     2065         or error-status :get-message(1) <> ""
     2066         then do:
     2067           undo move_block, retry move_block .
     2068         end.
     2069         for each buf_temp-browse-handle
     2070           where buf_temp-browse-handle.browse-type = 'height':u
     2071         on error undo move_block, retry move_block
     2072         :
     2073           assign
     2074             buf_temp-browse-handle.browse-handle :height
     2075               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2076             no-error .
     2077           if error-status :error
     2078           or error-status :get-message(1) <> ""
     2079           then do:
     2080             undo move_block, retry move_block .
     2081           end.
     2082         end.
     2083         for each buf_temp-diasize-handle
     2084         on error undo move_block, retry move_block
     2085         :
     2086           assign
     2087             v-object-handle = buf_temp-diasize-handle.handle-value
     2088           .
     2089           if v-object-handle <> v-diasize-resize-button
     2090           then do:
     2091             assign
     2092               v-object-handle :row = v-object-handle :row + p-change-value
     2093               no-error .
     2094             if error-status :error
     2095             or error-status :get-message(1) <> ""
     2096             then do:
     2097               undo move_block, retry move_block .
     2098             end.
     2099           end.
     2100         end.
     2101       end.
     2102       else do:
     2103         for each buf_temp-diasize-handle
     2104         on error undo move_block, retry move_block
     2105         :
     2106           assign
     2107             v-object-handle = buf_temp-diasize-handle.handle-value
     2108           .
     2109           if v-object-handle <> v-diasize-resize-button
     2110           then do:
     2111             assign
     2112               v-object-handle :row = v-object-handle :row + p-change-value
     2113               no-error .
     2114             if error-status :error
     2115             or error-status :get-message(1) <> ""
     2116             then do:
     2117               undo move_block, retry move_block .
     2118             end.
     2119           end.
     2120         end.
     2121         assign
     2122           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2123           no-error .
     2124         if error-status :error
     2125         or error-status :get-message(1) <> ""
     2126         then do:
     2127           undo move_block, retry move_block .
     2128         end.
     2129         for each buf_temp-browse-handle
     2130           where buf_temp-browse-handle.browse-type = 'height':u
     2131         on error undo move_block, retry move_block
     2132         :
     2133           assign
     2134             buf_temp-browse-handle.browse-handle :height
     2135               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2136             no-error .
     2137           if error-status :error
     2138           or error-status :get-message(1) <> ""
     2139           then do:
     2140             undo move_block, retry move_block .
     2141           end.
     2142         end.
     2143         assign
     2144           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     2145           no-error .
     2146         if error-status :error
     2147         or error-status :get-message(1) <> ""
     2148         then do:
     2149           undo move_block, retry move_block .
     2150         end.
     2151         if frame Dialog-Frame :scrollable = true
     2152         then do:
     2153           assign
     2154             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     2155             no-error .
     2156           if error-status :error
     2157           or error-status :get-message(1) <> ""
     2158           then do:
     2159             undo move_block, retry move_block .
     2160           end.
     2161         end.
     2162       end.
     2163       if p-move-resize = true
     2164       then do:
     2165         run diasize_position-resize-button in this-procedure .
     2166       end.
     2167       if v-diasize-wndstore = true
     2168       then do:
     2169         if connected("ub") = true
     2170         then do:
     2171           define variable v-cntxt-db-num        as integer   no-undo .
     2172           define variable v-cntxt-userid        as character no-undo .
     2173           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2174                                             , OUTPUT v-cntxt-userid
     2175                                             ) .
     2176           run gbl/wndsizew.p
     2177             (input  v-cntxt-db-num
     2178             ,input  v-cntxt-userid
     2179             ,input  v-diasize-proc-name
     2180             ,input  'height':u
     2181             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     2182             ) .
     2183         end.
     2184       end.
     2185     end.
     2186     assign
     2187       v-diasize-change-size = false
     2188     .
     2189   end procedure.
     2190   procedure diasize_set-height :
     2191     define input  parameter p-new-height  as decimal   no-undo .
     2192     define input  parameter p-move-resize as logical   no-undo .
     2193     do
     2194     on error undo, return error return-value
     2195     :
     2196       run diasize_change-height in this-procedure
     2197         (input  (p-new-height - frame Dialog-Frame :height)
     2198         ,input  p-move-resize
     2199         ) .
     2200     end.
     2201   end procedure.
     2202   procedure diasize_change-width :
     2203     define input  parameter p-change-value as decimal   no-undo .
     2204     define input  parameter p-move-resize  as logical   no-undo .
     2205     define variable v-field-group-handle   as handle    no-undo .
     2206     define variable v-object-handle        as handle    no-undo .
     2207     define variable v-frame-width          as decimal   no-undo .
     2208     define variable v-frame-virtual-width  as decimal   no-undo .
     2209     define variable v-browse-width         as decimal   no-undo .
     2210     define variable v-window-width         as decimal   no-undo .
     2211     define variable v-window-virtual-width as decimal   no-undo .
     2212     define variable v-change-sign          as integer   no-undo .
     2213     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2214     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2215     if p-change-value > 0
     2216     then do:
     2217       if frame Dialog-Frame :width + p-change-value >
     2218           session :width-chars
     2219       then do:
     2220         assign
     2221           p-change-value = session :width-chars - frame Dialog-Frame :width
     2222         .
     2223         if p-change-value <= 0
     2224         then do:
     2225           run diasize_position-resize-button in this-procedure .
     2226           return .
     2227         end.
     2228       end.
     2229     end.
     2230     if p-change-value < 0
     2231     then do:
     2232       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     2233       then do:
     2234         assign
     2235           p-change-value = v-diasize-orig-frame-width
     2236                          - frame Dialog-Frame :width
     2237         .
     2238         if p-change-value >= 0
     2239         then do:
     2240           run diasize_position-resize-button in this-procedure .
     2241           return .
     2242         end.
     2243       end.
     2244     end.
     2245     if p-change-value >= 0
     2246     then do:
     2247       assign
     2248         v-change-sign = 1
     2249       .
     2250     end.
     2251     else do:
     2252       assign
     2253         v-change-sign = -1
     2254       .
     2255     end.
     2256     assign
     2257       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2258     .
     2259     if p-change-value = 0
     2260     then do:
     2261       run diasize_position-resize-button in this-procedure .
     2262       return .
     2263     end.
     2264     move_block:
     2265     do
     2266     on error undo move_block, leave move_block
     2267     :
     2268       if retry
     2269       then do:
     2270         do
     2271         on error undo move_block, leave move_block
     2272         :
     2273           if p-change-value > 0
     2274           then do:
     2275             for each buf_temp-diasize-handle
     2276             on error undo, next
     2277             :
     2278               assign
     2279                 v-object-handle = buf_temp-diasize-handle.handle-value
     2280               .
     2281               if v-object-handle <> v-diasize-resize-button
     2282               then do:
     2283                 assign
     2284                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2285                 .
     2286               end.
     2287             end.
     2288             assign
     2289               v-diasize-browse-handle :width = v-browse-width
     2290             .
     2291             for each buf_temp-browse-handle
     2292               where buf_temp-browse-handle.browse-type = 'width':u
     2293             on error undo, next
     2294             :
     2295               assign
     2296                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2297               .
     2298             end.
     2299             assign
     2300               frame Dialog-Frame :width = v-frame-width
     2301             .
     2302             if frame Dialog-Frame :scrollable = true
     2303             then do:
     2304               assign
     2305                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2306               .
     2307             end.
     2308             run diasize_position-resize-button in this-procedure .
     2309           end.
     2310           else do:
     2311             if frame Dialog-Frame :scrollable = true
     2312             then do:
     2313               assign
     2314                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     2315               .
     2316             end.
     2317             assign
     2318               frame Dialog-Frame :width = v-frame-width
     2319             .
     2320             for each buf_temp-browse-handle
     2321               where buf_temp-browse-handle.browse-type = 'width':u
     2322             on error undo, next
     2323             :
     2324               assign
     2325                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2326               .
     2327             end.
     2328             assign
     2329               v-diasize-browse-handle :width = v-browse-width
     2330             .
     2331             for each buf_temp-diasize-handle
     2332             on error undo, next
     2333             :
     2334               assign
     2335                 v-object-handle = buf_temp-diasize-handle.handle-value
     2336               .
     2337               if v-object-handle <> v-diasize-resize-button
     2338               then do:
     2339                 assign
     2340                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2341                 .
     2342               end.
     2343             end.
     2344             run diasize_position-resize-button in this-procedure .
     2345           end.
     2346           assign
     2347             v-diasize-change-size = false
     2348           .
     2349           leave move_block .
     2350         end.
     2351       end.
     2352       assign
     2353         v-diasize-need-full-display = true
     2354       .
     2355       if v-diasize-change-size = false
     2356       then do:
     2357         assign
     2358           v-diasize-change-size = true
     2359         .
     2360       end.
     2361       else do:
     2362         return .
     2363       end.
     2364       assign
     2365         v-frame-width = frame Dialog-Frame :width
     2366         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     2367         v-browse-width = v-diasize-browse-handle :width
     2368       .
     2369       for each buf_temp-browse-handle
     2370         where buf_temp-browse-handle.browse-type = 'width':u
     2371       :
     2372         assign
     2373           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2374         .
     2375       end.
     2376       for each buf_temp-diasize-handle
     2377       :
     2378         delete buf_temp-diasize-handle .
     2379       end.
     2380       assign
     2381         v-field-group-handle = frame Dialog-Frame :first-child
     2382       .
     2383       do while valid-handle(v-field-group-handle)
     2384       :
     2385         assign
     2386           v-object-handle = v-field-group-handle :first-child
     2387         .
     2388         do while valid-handle(v-object-handle)
     2389         :
     2390           if  v-object-handle <> v-diasize-browse-handle :handle
     2391           and v-object-handle <> v-diasize-resize-button
     2392           and can-query(v-object-handle, "row")
     2393           and can-query(v-object-handle, "height")
     2394           and ( v-object-handle :col + v-object-handle :width
     2395                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2396               )
     2397           then do:
     2398             find first buf_temp-browse-handle
     2399               where buf_temp-browse-handle.browse-type   = 'width':u
     2400                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2401               no-error .
     2402             if available buf_temp-browse-handle
     2403             then do:
     2404             end.
     2405             else do:
     2406               create buf_temp-diasize-handle .
     2407               assign
     2408                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2409                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2410               .
     2411             end.
     2412           end.
     2413           assign
     2414             v-object-handle = v-object-handle :next-sibling
     2415           .
     2416         end.
     2417         assign
     2418           v-field-group-handle = v-field-group-handle :next-sibling
     2419         .
     2420       end.
     2421       do with frame Dialog-Frame
     2422       :
     2423         hide v-diasize-resize-button .
     2424         v-diasize-resize-button :row = 1.
     2425         v-diasize-resize-button :column = 1.
     2426       end.
     2427       if p-change-value > 0
     2428       then do:
     2429         if frame Dialog-Frame :scrollable = true
     2430         then do:
     2431           assign
     2432             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2433             no-error .
     2434           if error-status :error
     2435           or error-status :get-message(1) <> ""
     2436           then do:
     2437             undo move_block, retry move_block.
     2438           end.
     2439         end.
     2440         assign
     2441           frame Dialog-Frame :width = v-frame-width + p-change-value
     2442           no-error .
     2443         if error-status :error
     2444         or error-status :get-message(1) <> ""
     2445         then do:
     2446           undo move_block, retry move_block.
     2447         end.
     2448         assign
     2449           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2450         no-error .
     2451         if error-status :error
     2452         or error-status :get-message(1) <> ""
     2453         then do:
     2454           undo move_block, retry move_block.
     2455         end.
     2456         for each buf_temp-browse-handle
     2457           where buf_temp-browse-handle.browse-type = 'width':u
     2458         on error undo move_block, retry move_block
     2459         :
     2460           assign
     2461             buf_temp-browse-handle.browse-handle :width
     2462               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2463             no-error .
     2464           if error-status :error
     2465           or error-status :get-message(1) <> ""
     2466           then do:
     2467             undo move_block, retry move_block .
     2468           end.
     2469         end.
     2470         for each buf_temp-diasize-handle
     2471         on error undo move_block, retry move_block
     2472         :
     2473           assign
     2474             v-object-handle = buf_temp-diasize-handle.handle-value
     2475           .
     2476           if v-object-handle <> v-diasize-resize-button
     2477           then do:
     2478             assign
     2479               v-object-handle :col = v-object-handle :col + p-change-value
     2480               no-error .
     2481             if error-status :error
     2482             or error-status :get-message(1) <> ""
     2483             then do:
     2484               undo move_block, retry move_block .
     2485             end.
     2486           end.
     2487         end.
     2488       end.
     2489       else do:
     2490         for each buf_temp-diasize-handle
     2491         on error undo move_block, retry move_block
     2492         :
     2493           assign
     2494             v-object-handle = buf_temp-diasize-handle.handle-value
     2495           .
     2496           if v-object-handle <> v-diasize-resize-button
     2497           then do:
     2498             assign
     2499               v-object-handle :col = v-object-handle :col + p-change-value
     2500               no-error .
     2501             if error-status :error
     2502             or error-status :get-message(1) <> ""
     2503             then do:
     2504               undo move_block, retry move_block .
     2505             end.
     2506           end.
     2507         end.
     2508         for each buf_temp-browse-handle
     2509           where buf_temp-browse-handle.browse-type = 'width':u
     2510         on error undo move_block, retry move_block
     2511         :
     2512           assign
     2513             buf_temp-browse-handle.browse-handle :width
     2514               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2515             no-error .
     2516           if error-status :error
     2517           or error-status :get-message(1) <> ""
     2518           then do:
     2519             undo move_block, retry move_block .
     2520           end.
     2521         end.
     2522         assign
     2523           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2524           no-error .
     2525         if error-status :error
     2526         or error-status :get-message(1) <> ""
     2527         then do:
     2528           undo move_block, retry move_block.
     2529         end.
     2530         assign
     2531           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     2532         no-error .
     2533         if error-status :error
     2534         or error-status :get-message(1) <> ""
     2535         then do:
     2536           undo move_block, retry move_block.
     2537         end.
     2538         if frame Dialog-Frame :scrollable = true
     2539         then do:
     2540           assign
     2541             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     2542           no-error .
     2543           if error-status :error
     2544           or error-status :get-message(1) <> ""
     2545           then do:
     2546             undo move_block, retry move_block.
     2547           end.
     2548         end.
     2549       end.
     2550       if p-move-resize
     2551       then do:
     2552         run diasize_position-resize-button in this-procedure .
     2553       end.
     2554       if v-diasize-wndstore = true
     2555       then do:
     2556         if connected("ub") = true
     2557         then do:
     2558           define variable v-cntxt-db-num        as integer   no-undo .
     2559           define variable v-cntxt-userid        as character no-undo .
     2560           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2561                                             , OUTPUT v-cntxt-userid
     2562                                             ) .
     2563           run gbl/wndsizew.p
     2564             (input  v-cntxt-db-num
     2565             ,input  v-cntxt-userid
     2566             ,input  v-diasize-proc-name
     2567             ,input  'width':u
     2568             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     2569             ) .
     2570         end.
     2571       end.
     2572     end.
     2573     assign
     2574       v-diasize-change-size = false
     2575     .
     2576   end procedure.
     2577   procedure diasize_set-width :
     2578     define input  parameter p-new-width  as decimal   no-undo .
     2579     define input  parameter p-move-resize as logical   no-undo .
     2580     do
     2581     on error undo, return error return-value
     2582     :
     2583       run diasize_change-width in this-procedure
     2584         (input  (p-new-width - frame Dialog-Frame :width)
     2585         ,input  p-move-resize
     2586         ) .
     2587     end.
     2588   end procedure.
     2589   procedure diasize_position-resize-button :
     2590     do with frame Dialog-Frame
     2591     :
     2592       hide v-diasize-resize-button .
     2593       assign
     2594         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     2595                     - 1
     2596                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     2597         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     2598                     - 1
     2599                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     2600       .
     2601       view v-diasize-resize-button .
     2602     end.
     2603   end procedure.
     2604   on alt-right anywhere
     2605   do:
     2606     run diasize_change-width in this-procedure
     2607       (input 1
     2608       ,input true
     2609       ) .
     2610     return no-apply .
     2611   end.
     2612   on alt-left anywhere
     2613   do:
     2614     run diasize_change-width in this-procedure
     2615       (input -1
     2616       ,input true
     2617       ) .
     2618     return no-apply .
     2619   end.
     2620   on alt-down anywhere
     2621   do:
     2622     run diasize_change-height in this-procedure
     2623       (input 1
     2624       ,input true
     2625       ) .
     2626     return no-apply .
     2627   end.
     2628   on alt-up anywhere
     2629   do:
     2630     run diasize_change-height in this-procedure
     2631       (input -1
     2632       ,input true
     2633       ) .
     2634     return no-apply .
     2635   end.
     2636   on alt-enter of frame Dialog-Frame
     2637   do:
     2638     run diasize_maximize in this-procedure
     2639       (input  ?
     2640       ).
     2641     return no-apply .
     2642   end.
     2643   procedure diasize_end-move :
     2644     do
     2645     on error undo, return error return-value
     2646     :
     2647       define variable v-row-delta as decimal   no-undo .
     2648       define variable v-col-delta as decimal   no-undo .
     2649       define variable v-new-row as decimal   no-undo .
     2650       define variable v-new-col as decimal   no-undo .
     2651       assign
     2652         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     2653         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     2654       .
     2655       assign
     2656         v-row-delta = v-new-row - frame Dialog-Frame :height
     2657         v-col-delta = v-new-col - frame Dialog-Frame :width
     2658       .
     2659       run diasize_change-height in this-procedure
     2660         (input v-row-delta
     2661         ,input true
     2662         ) .
     2663       run diasize_change-width in this-procedure
     2664         (input v-col-delta
     2665         ,input true
     2666         ) .
     2667     end.
     2668   end procedure.
     2669   procedure diasize_maximize :
     2670     define input  parameter p-action as logical   no-undo .
     2671     do
     2672     on error undo, return error return-value
     2673     :
     2674       if p-action = ?
     2675       then do:
     2676         if v-diasize-need-maximize = true
     2677         then do:
     2678           assign
     2679             p-action = true
     2680           .
     2681         end.
     2682         else do:
     2683           assign
     2684             p-action = false
     2685           .
     2686         end.
     2687       end.
     2688       if p-action = true
     2689       then do:
     2690         run diasize_change-height in this-procedure
     2691           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     2692               - frame Dialog-Frame :height-chars
     2693           ,input true
     2694           ) .
     2695         run diasize_change-width in this-procedure
     2696           (input session :width-chars
     2697               - frame Dialog-Frame :width-chars
     2698           ,input true
     2699           ) .
     2700         assign
     2701           v-diasize-need-maximize = false
     2702         .
     2703       end.
     2704       else do:
     2705         run diasize_change-width in this-procedure
     2706           (input v-diasize-orig-frame-width
     2707               - frame Dialog-Frame :width-chars
     2708           ,input true
     2709           ) .
     2710         run diasize_change-height in this-procedure
     2711           (input v-diasize-orig-frame-height
     2712               - frame Dialog-Frame :height-chars
     2713           ,input true
     2714           ) .
     2715         assign
     2716           v-diasize-need-maximize = true
     2717         .
     2718       end.
     2719     end.
     2720   end procedure.
     2721   procedure diasize_restore-orig-size :
     2722     do
     2723     on error undo, return error return-value
     2724     :
     2725       assign
     2726         v-diasize-current-frame-width  = frame Dialog-Frame :width
     2727         v-diasize-current-frame-height = frame Dialog-Frame :height
     2728       .
     2729       run diasize_set-height in this-procedure
     2730         (input  v-diasize-orig-frame-height
     2731         ,input  true
     2732         ) .
     2733       run diasize_set-width in this-procedure
     2734         (input  v-diasize-orig-frame-width
     2735         ,input  true
     2736         ) .
     2737     end.
     2738   end procedure.
     2739   procedure diasize_restore-current-size :
     2740     do
     2741     on error undo, return error return-value
     2742     :
     2743       run diasize_set-height in this-procedure
     2744         (input  v-diasize-current-frame-height
     2745         ,input  true
     2746         ) .
     2747       run diasize_set-width in this-procedure
     2748         (input  v-diasize-current-frame-width
     2749         ,input  true
     2750         ) .
     2751     end.
     2752   end procedure.
     2753   procedure diasize_set-browse-handle :
     2754     define input  parameter p-browse-handle as handle   no-undo .
     2755     define buffer buf_temp-browse-handle for temp-browse-handle .
     2756     do
     2757     on error undo, return error return-value
     2758     :
     2759       assign
     2760         v-diasize-browse-handle = p-browse-handle
     2761       .
     2762       for each buf_temp-browse-handle
     2763       on error undo, return error return-value
     2764       :
     2765         delete buf_temp-browse-handle .
     2766       end.
     2767     end.
     2768   end procedure.
     2769   procedure diasize_add_browse :
     2770     define input  parameter p-browse-type   as character no-undo .
     2771     define input  parameter p-browse-handle as handle    no-undo .
