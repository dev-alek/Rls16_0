      650   define  stream PrnLibStream.
      651   procedure prn-lib-prn-file :
      652     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      653     define input parameter p-DIsabledoptions as integer no-undo .
      654     define variable v-report-name as character no-undo .
      655     define variable v-user-action as character no-undo .
      656     define variable v-printed     as logical   no-undo .
