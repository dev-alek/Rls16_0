        1   def var vss-revision    as character no-undo init "$Revision$":U .
        2   def var vss-author      as character no-undo init "$Author$":U .
        3   def var vss-date        as character no-undo init "$Date$":U .
        4   def var vss-workfile    as character no-undo init "$Workfile$":U .
        5   def var vss-archive     as character no-undo init "$Archive$":U .
        6   def var vss-description as character no-undo init "История сезонов и коллекций".
        7   procedure vss-get-info :
        8     define output parameter p-vss-revision    like vss-revision    no-undo .
        9     define output parameter p-vss-author      like vss-author      no-undo .
       10     define output parameter p-vss-date        like vss-date        no-undo .
       11     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       12     define output parameter p-vss-archive     like vss-archive     no-undo .
       13     define output parameter p-vss-description like vss-description no-undo .
       14     assign
       15       p-vss-revision    = vss-revision
       16       p-vss-author      = vss-author
       17       p-vss-date        = vss-date
       18       p-vss-workfile    = vss-workfile
       19       p-vss-archive     = vss-archive
       20       p-vss-description = vss-description
       21     .
       22   end procedure.
       23   procedure vss-get-parameters :
       24     define output parameter p-vss-parameters as character no-undo .
       25   end procedure.
       26   define new global shared variable g#vssrevis-logger as handle    no-undo .
       27   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       28   define variable v-vssrevis-logger                   as handle    no-undo .
       29   procedure vss-logevent :
       30     define input  parameter p-extra-paramters as character no-undo .
       31     define variable v-vssrevis-parameters as character no-undo .
       32     do
       33     on error undo, return error return-value
       34     :
       35       if  valid-handle(v-vssrevis-logger)
       36       and v-vssrevis-logger :get-signature("logevent") <> ""
       37       then do:
       38         run vss-get-parameters in this-procedure
       39           (output v-vssrevis-parameters
       40           ).
       41         run logevent in v-vssrevis-logger
       42           (input vss-workfile
       43           ,input vss-revision
       44           ,input v-vssrevis-parameters
       45           ,input p-extra-paramters
       46           ).
       47       end.
       48     end.
       49   end procedure.
       50   assign
       51     v-vssrevis-logger = g#vssrevis-logger
       52   .
       53   if  valid-handle(v-vssrevis-logger)
       54   and v-vssrevis-logger :get-signature("logevent") <> ""
       55   then do:
       56     assign
       57       v-vssrevis-logevent = true
       58     .
       59     run vss-logevent in this-procedure (input vss-description) .
       60   end.
       61   define input parameter  parparentproc  as widget-handle no-undo.
       62   define input parameter  par-sea-code   like ub.season.sea-code no-undo .
       63   define input parameter  par-db-num     like ub.season.db-num no-undo .
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   procedure proc-alt-shift-f2:
       80     if not ibs.th.gbl.gbl-var:rcode
       81   then
       82     run gbl\inidebug.p .
       83   end.
       84   procedure proc-alt-shift-f3:
       85     run gbl/prvssinf.p
       86       ( input this-procedure
       87       ) .
       88   end.
       89   define variable v-inform-launched as logical no-undo initial false .
       90   procedure proc-alt-shift-f4:
       91     define variable v-action as character no-undo .
       92     if v-inform-launched = false then do:
       93       assign
       94         v-inform-launched = true
       95       .
       96       run gbl/d-inform.w
       97         (  input self
       98         ,  input this-procedure
       99         , output v-action
      100         ) no-error .
      101       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      102       assign
      103         v-inform-launched = false
      104       .
      105     end.
      106   end.
      107   procedure proc-alt-f1:
      108     run gbl/corrhelp.p
      109       (input this-procedure
      110       ) .
      111   end .
      112   on alt-shift-f2 anywhere do:
      113     run proc-alt-shift-f2.
      114   end.
      115   on alt-shift-f3 anywhere do:
      116     run proc-alt-shift-f3 in this-procedure .
      117   end.
      118   on alt-shift-f4 anywhere do:
      119     run proc-alt-shift-f4 in this-procedure.
      120   end.
      121   on alt-f1 anywhere do:
      122     run proc-alt-f1 in this-procedure .
      123   end.
      124   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      125   define variable c-point  as character no-undo .
      126   define variable tbl      as character no-undo .
      127   define variable join-tbl as character no-undo .
      128   define variable fld      as character no-undo .
      129   define variable lab      as character no-undo .
      130   define variable spr      as character no-undo .
      131   define variable dim      as character no-undo .
      132   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      133   procedure cur-time :
      134      define output parameter p-today as date      no-undo .
      135      define output parameter p-time  as integer   no-undo .
      136     do
      137     on error undo, return error
      138     :
      139       define variable v-date1 as date      no-undo .
      140       define variable v-date2 as date      no-undo .
      141       define variable v-time  as integer   no-undo .
      142       assign
      143         v-date1 = today
      144         v-time  = time
      145         v-date2 = today
      146       .
      147       if v-date1 <> v-date2
      148       then do:
      149         assign
      150           v-date1 = today
      151           v-time  = v-time
      152         .
      153       end.
      154       assign
      155         p-today = v-date1
      156         p-time  = v-time
      157       .
      158     end.
      159   end.
      160   function cur-time-date returns character
      161   :
      162     return string(today, '99/99/9999':U) .
      163   end.
      164   function cur-time-mjd returns decimal
      165   :
      166     define variable v-date as date      no-undo .
      167     define variable v-time as integer   no-undo .
      168     run cur-time in this-procedure
      169       (output v-date
      170       ,output v-time
      171       ) .
      172     return integer(v-date) - 2400002 + (v-time / 86400) .
      173   end.
      174   function cur-time-get-ending-index returns integer
      175   (input p-number as integer
      176   )
      177   :
      178     if p-number < 0
      179     or p-number = ?
      180     then do:
      181       return 1 .
      182     end.
      183     define variable v-rest as integer   no-undo .
      184     assign
      185       p-number = p-number modulo 100
      186     .
      187     if p-number < 20
      188     then do:
      189       assign
      190         v-rest = p-number
      191       .
      192     end.
      193     else do:
      194       assign
      195         v-rest = p-number modulo 10
      196       .
      197     end.
      198     case v-rest :
      199       when 1
      200       then do:
      201         return 2 .
      202       end.
      203       when 2 or
      204       when 3 or
      205       when 4
      206       then do:
      207         return 3 .
      208       end.
      209       otherwise do:
      210         return 1 .
      211       end.
      212     end case .
      213   end.
      214   procedure cur-time-mjd-to-date :
      215      define input  parameter i-mjd-diff as decimal no-undo.
      216      define output parameter o-Date     as date    no-undo.
      217      define output parameter o-Time     as integer no-undo.
      218      define variable v-day-number as integer   no-undo .
      219      if    i-mjd-diff < 0
      220         or i-mjd-diff = ?
      221      then do:
      222         return "?" .
      223      end.
      224      assign
      225         v-day-number = truncate(i-mjd-diff,0).
      226         o-Date = date(v-day-number + 2400002).
      227         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      228     .
      229   end.
      230   function cur-time-mjd-to-string returns character
      231   (input p-mjd-diff as decimal
      232   )
      233   :
      234     define variable v-day-number as integer   no-undo .
      235     define variable v-seconds    as integer   no-undo .
      236     define variable v-hour       as integer   no-undo .
      237     define variable v-min        as integer   no-undo .
      238     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      239     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      240     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      241     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      242     if p-mjd-diff < 0
      243     or p-mjd-diff = ?
      244     then do:
      245       return "?" .
      246     end.
      247     assign
      248       v-day-number = integer(truncate(p-mjd-diff,0))
      249       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      250     .
      251     if v-seconds > 86400
      252     then do:
      253       assign
      254         v-seconds = 86400 - 1
      255       .
      256     end.
      257     if v-seconds < 0
      258     then do:
      259       assign
      260         v-seconds = 0
      261       .
      262     end.
      263     assign
      264       v-hour = truncate(v-seconds / 3600, 0)
      265     .
      266     assign
      267       v-seconds = v-seconds modulo 3600
      268     .
      269     assign
      270       v-min = truncate(v-seconds / 60, 0)
      271     .
      272     assign
      273       v-seconds = v-seconds modulo 60
      274     .
      275     return
      276         (if v-day-number <> 0
      277           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      278           else ""
      279         )
      280       + (if v-day-number <> 0 or v-hour <> 0
      281           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      282           else ""
      283         )
      284       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      285           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      286           else ""
      287         )
      288       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      289       .
      290   end.
      291   function cur-time-string returns character
      292   :
      293     define variable v-date as date      no-undo .
      294     define variable v-time as integer   no-undo .
      295     run cur-time in this-procedure
      296       (output v-date
      297       ,output v-time
      298       ) .
      299     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      300   end.
      301   function cur-time-string-sec returns character
      302   :
      303     define variable v-date as date      no-undo .
      304     define variable v-time as integer   no-undo .
      305     run cur-time in this-procedure
      306       (output v-date
      307       ,output v-time
      308       ) .
      309     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      310   end.
      311   function cur-time-custom  returns character
      312   (input p-prefix as character
      313   ,input p-date-format as character
      314   ,input p-delimiter as character
      315   ,input p-time-format as character
      316   ,input p-suffix as character
      317   )
      318   :
      319     define variable v-date as date      no-undo .
      320     define variable v-time as integer   no-undo .
      321     run cur-time in this-procedure
      322       (output v-date
      323       ,output v-time
      324       ) .
      325     return
      326       p-prefix
      327       + string(v-date, p-date-format)
      328       + p-delimiter
      329       + string(v-time, p-time-format)
      330       + p-suffix
      331       .
      332   end.
      333   function cur-time-print  returns character
      334   :
      335     define variable v-date as date      no-undo .
      336     define variable v-time as integer   no-undo .
      337     run cur-time in this-procedure
      338       (output v-date
      339       ,output v-time
      340       ) .
      341     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      342   end.
      343   function cur-time-datetime returns datetime
      344   :
      345     define variable v-char as character no-undo .
      346     define variable v-datetime as datetime no-undo .
      347     v-char = cur-time-string().
      348     v-datetime = datetime(v-char).
      349     return  v-datetime.
      350   end.
      351   function cur-time-string-msec returns character
      352   :
      353     define variable v-date as datetime  no-undo .
      354     v-date = now.
      355     return string(v-date) .
      356   end.
      357   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      358   define variable v-waitfram-action01         as character   no-undo .
      359   define variable v-waitfram-action02         as character   no-undo .
      360   define variable v-waitfram-action03         as character   no-undo .
      361   define variable mWaitFramTextBeg            as character   no-undo.
      362   define variable mWaitFramTextEnd            as character   no-undo.
      363   define variable mWaitFramView               as logical     no-undo.
      364   define variable mWaitProcEvent              as logical     no-undo init yes.
      365   define variable mWaitFramInterval           as integer     no-undo init 1 .
      366   define variable mWaitFramStop               as logical     no-undo.
      367   define variable mWaitFramStopUser           as logical     no-undo.
      368   define variable mWaitFramStopTimeOut        as logical     no-undo.
      369   define variable mWaitFramStartProc          as datetime-tz no-undo.
      370   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      371   define button B-WaitFramStop auto-end-key
      372        label "Стоп"
      373        size 10 by 1 tooltip "Остоновить процесс".
      374   define button B-viewProcInfo
      375        label "Информация"
      376        size 15 by 1 tooltip "Информация о процесс".
      377   define frame waitfram
      378     v-waitfram-action01 format "x(72)" no-label skip
      379     v-waitfram-action02 format "x(72)" no-label skip
      380     v-waitfram-action03 format "x(72)" no-label skip
      381     B-viewProcInfo
      382     B-WaitFramStop at row 4 col 30
      383     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      384     .
      385   define new global shared variable mBatchMode as logical no-undo init ?.
      386   define variable mFramBachModHandle as handle no-undo.
      387   mFramBachModHandle = frame waitfram:handle.
      388   define variable mFameOldVis as logical no-undo.
      389   define variable mVisCUrentVin as logical no-undo.
      390   if session:batch-mode
      391   then
      392      mBatchMode = yes.
      393   if mBatchMode = ? then do:
      394     mVisCUrentVin = current-window:visible.
      395     mFameOldVis = mFramBachModHandle:visible.
      396     mFramBachModHandle:visible  = yes.
      397     mBatchMode = mFramBachModHandle:visible ne yes.
      398     mFramBachModHandle:visible = mFameOldVis.
      399     current-window:visible = mVisCUrentVin.
      400   end.
      401    if  log-manager:logfile-name ne ?
      402     then DO:
      403         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      404         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      405         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      406     end.
      407   on choose of B-WaitFramStop in frame waitfram
      408   do:
      409     mWaitFramStop = yes.
      410     mWaitFramStopUser = yes.
      411   end.
      412   function waitfram-check-timeout returns logical():
      413      define variable vtime as int64 no-undo.
      414      if mWaitFramStopTimeOut
      415      then
      416         return yes.
      417      vtime = ( now - mWaitFramStartProc ) / 1000 .
      418      if     mWaitFramTimeOut ne ?
      419         and mWaitFramTimeOut ne 0
      420         and mWaitFramTimeOut lt vtime
      421      then do:
      422         mWaitFramStopTimeOut = yes.
      423      end.
      424      return mWaitFramStopTimeOut.
      425   end.
      426   procedure waitfram-hide :
      427     if not session:batch-mode
      428     then do
      429     on error undo, return error return-value
      430     :
      431       pause 0 before-hide .
      432       if not mBatchMode then
      433         hide frame waitfram .
      434     if     not mWaitFramView
      435        and mWaitProcEvent
      436     then
      437       process events .
      438     end.
      439   end procedure.
      440   procedure waitfram-show :
      441     define input  parameter p-message as character no-undo .
      442     define variable v-left-margin as integer   no-undo .
      443     if not session:batch-mode
      444     then do
      445     on error undo, return error return-value
      446     :
      447       if length(p-message) <= 70 then do:
      448         assign
      449           v-left-margin = integer((70 - length(p-message)) / 2)
      450         .
      451         assign
      452           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      453         .
      454         assign
      455           v-waitfram-action01 = " "
      456           v-waitfram-action02 = " "
      457                                    + fill(" ", v-left-margin)
      458                                    + p-message
      459           v-waitfram-action03 = " "
      460         .
      461       end.
      462       else do:
      463         define variable vRindex1 as integer no-undo.
      464         define variable vRindex2 as integer no-undo.
      465         vRindex1 = r-index(p-message," ",70).
      466         if vRindex1 = 0
      467         then
      468            vRindex1 = 70.
      469         if length(p-message)  <= vRindex1 + 70 then do:
      470           assign
      471             v-waitfram-action01 = " "
      472             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      473             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      474           .
      475         end.
      476         else do:
      477           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      478           if vRindex2 <= vRindex1
      479           then
      480              vRindex2 = vRindex1 + 70.
      481           assign
      482             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      483             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      484             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      485           .
      486         end.
      487       end.
      488       B-viewProcInfo:visible   in frame waitfram = no.
      489       B-viewProcInfo:sensitive in frame waitfram = no.
      490       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      491       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      492       if  (   mWaitFramView
      493          or  mWaitProcEvent)
      494          and not mBatchMode
      495       then
      496          display
      497             v-waitfram-action01 skip
      498             v-waitfram-action02 skip
      499             v-waitfram-action03 skip
      500          with frame waitfram .
      501       if     mWaitFramView
      502          then do:
      503             if     mWaitFramInterval ne ?
      504                and not mBatchMode
      505             then
      506                wait-for go of frame waitfram pause mWaitFramInterval.
      507          end.
      508          else
      509             if     mWaitProcEvent
      510                and not mBatchMode
      511             then
      512                process events .
      513     end.
      514   end procedure.
      515      procedure waitfram-show-this:
      516         define input  parameter iInterval as int64 no-undo.
      517         define variable vtime as int64 no-undo.
      518         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      519         mWaitFramInterval = iInterval.
      520         run waitfram-show (substitute("&1&2 &3&4" ,
      521                                       mWaitFramTextBeg ,
      522                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      523                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      524                                       mWaitFramTextEnd
      525                                      )
      526                           ).
      527      end.
      528      procedure WaitFramRunPause:
      529         define input  parameter iInterval as dec no-undo.
      530         define variable vStart  as datetime-tz no-undo.
      531         define variable vend    as datetime-tz no-undo.
      532         define variable vint as int64 no-undo.
      533         define variable vOk as logical no-undo.
      534         vStart = now.
      535         vend   = vStart.
      536         publish "WaitFramPause" (iInterval,output vOk).
      537         vend   =  now.
      538         vint = vend - vStart.
      539         vint = iInterval - vint / 1000.
      540         if     not mWaitFramStop
      541            and (   vint > 0
      542                 or (    not vOk
      543                     and iInterval eq ?
      544                     )
      545                 )
      546         then
      547            run waitfram-show-this (iInterval).
      548         vend   =  now.
      549         vint = vend - vStart.
      550         vint = iInterval - vint / 1000.
      551         if     not mWaitFramStop
      552            and vint > 0
      553         then do:
      554            run gbl/pause.p (vint * 1000).
      555         end.
      556         if iInterval ne ?
      557         then
      558            publish "WaitFramStop".
      559         waitfram-check-timeout().
      560      end.
      561      procedure WaitFramWaitFor:
      562         define input  parameter iInterval as dec no-undo.
      563         assign
      564            mWaitFramStartProc   = now
      565            mWaitFramStopUser    = no
      566            mWaitFramStopTimeOut = no
      567         .
      568         block-wait:
      569         do while not mWaitFramStop:
      570            run WaitFramRunPause (iInterval).
      571            if  waitfram-check-timeout()
      572            then do:
      573               leave block-wait.
      574            end.
      575         end.
      576         run waitfram-hide.
      577      end.
      578   procedure waitfram-join :
      579     define input  parameter p-line-1  as character no-undo .
      580     define input  parameter p-line-2  as character no-undo .
      581     define input  parameter p-line-3  as character no-undo .
      582     define output parameter p-message as character no-undo .
      583     do
      584     on error undo, return error return-value
      585     :
      586       assign
      587         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      588                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      589                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      590       .
      591     end.
      592   end procedure.
      593   function waitfram-join-function returns character
      594     (input p-line-1 as character
      595     ,input p-line-2 as character
      596     ,input p-line-3 as character
      597     ).
      598     define variable v-message as character no-undo .
      599     run waitfram-join in this-procedure
      600       (input  p-line-1
      601       ,input  p-line-2
      602       ,input  p-line-3
      603       ,output v-message
      604       ) .
      605     return v-message .
      606   end function .
      607   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      608   function usrfulnf returns character ( input p-user-id as character):
      609   define variable v-user-name as character no-undo .
      610   define variable vss-include-info4 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      611   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      612     (input  p-user-id
      613     ,output v-user-name
      614     ) no-error .
      615   if error-status:error
      616   or v-user-name = ""
      617   then do:
      618     return p-user-id.
      619   end.
      620   else do:
      621     return v-user-name.
      622   end.
      623   end function.
      624   define variable del-type as character no-undo.
      625   define variable deleted as logical no-undo init no.
      626   DEFINE VARIABLE change-type as character init "" no-undo .
      627   DEFINE NEW SHARED BUFFER buf_c-season FOR ub.c-season .
      628   define temp-table temp-changes no-undo
      629   field f_name as character
      630   field l_name as character
      631   field v_old as character
      632   field v_new as character
      633   index pi is unique primary
      634   f_name.
      635   FUNCTION date-func RETURNS DATE
      636   ( input date-int as int)  FORWARD.
      637   DEFINE BUTTON B-Cancel AUTO-END-KEY
      638        LABEL "Выход"
      639        SIZE 10 BY 1
      640        BGCOLOR 8 .
      641   DEFINE BUTTON B-Help
      642        LABEL "Помощь"
      643        SIZE 10 BY 1
      644        BGCOLOR 8 .
      645   DEFINE VARIABLE mark-num AS CHARACTER FORMAT "X(256)":U
      646         VIEW-AS TEXT
      647        SIZE 6 BY 1
      648        FGCOLOR 4  NO-UNDO.
      649   DEFINE QUERY BR-changes FOR
      650         temp-changes SCROLLING.
      651   DEFINE QUERY BR-docs FOR
      652         buf_c-season SCROLLING.
      653   DEFINE QUERY Dialog-Frame FOR
      654         ub.c-season SCROLLING.
      655   DEFINE BROWSE BR-changes
      656     QUERY BR-changes DISPLAY
      657         temp-changes.l_name COLUMn-LABEL "Изменилось" format "X(25)"
      658         temp-changes.v_old COLUMn-LABEL "Было" format "X(35)"
      659         temp-changes.v_new COLUMn-LABEL "Стало" format "X(35)"
      660       WITH NO-ROW-MARKERS SEPARATORS SIZE 90.75 BY 11.5.
      661   DEFINE BROWSE BR-docs
      662     QUERY BR-docs DISPLAY
      663         buf_c-season.chip-num  format ">>>>>>>>>>9"
      664        buf_c-season.sea-name    format "x(40)"
      665        date-func(buf_c-season.sea-month-1) COLUMN-LABEL "с" FORMAT "99/99/99":U
      666        date-func(buf_c-season.sea-month-2) COLUMN-LABEL "по" FORMAT "99/99/99":U
      667        buf_c-season.corr-date   COLUMN-LABEL 'Дата изменения'
      668        string(buf_c-season.corr-time,'hh:mm:ss')   COLUMN-LABEL 'Время изменения '
      669        buf_c-season.corr-user-db-num   COLUMN-LABEL 'Изменение с БД №' format ">>>>9"
      670        buf_c-season.corr-user-name   COLUMN-LABEL 'Изменил'
      671        usrfulnf(buf_c-season.corr-user-name)  COLUMN-LABEL "кто менял! ФИО"
      672        buf_c-season.sea-code COLUMN-LABEL "Код"  format ">>>>>>>>>>>>>9"
      673        buf_c-season.stts        format ">"
      674        buf_c-season.List_
      675        enable buf_c-season.corr-date
      676       WITH NO-ROW-MARKERS NO-COLUMN-SCROLLING SEPARATORS SIZE 90 BY 8.92.
      677   DEFINE FRAME Dialog-Frame
      678        B-Cancel AT ROW 1 COL 1
      679        B-Help AT ROW 1 COL 81.5
      680        BR-docs AT ROW 2.21 COL 1.25
      681        BR-changes AT ROW 12 COL 1
      682        mark-num AT ROW 1 COL 14.88 NO-LABEL
      683        SPACE(70.87) SKIP(21.59)
      684       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      685            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      686            TITLE "История изменений сезонов/коллекций"
      687            CANCEL-BUTTON B-Cancel.
      688   ASSIGN
      689          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      690          FRAME Dialog-Frame:HIDDEN           = TRUE.
      691   ASSIGN
      692          BR-docs:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 2.
      693   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      694   DO:
      695     APPLY "END-ERROR":U TO SELF.
      696   END.
      697   ON VALUE-CHANGED OF BR-docs IN FRAME Dialog-Frame
      698   DO:
      699   if available buf_c-season then do:
      700      run proc-view-changes in this-procedure no-error.
      701   END.
      702   END.
      703   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      704   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      705   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      706   on help of frame Dialog-Frame
      707   do:
      708     run gbl/app_help.p
      709       (input this-procedure :file-name
      710       ,input ''
      711       ,input ?
      712       ) no-error.
      713     if error-status :error then do:
      714       message
      715         "Ошибка при вызове помощи"
      716         error-status :get-message(1)
      717         view-as alert-box .
      718     end.
      719   end.
      720   run minbtn-set in this-procedure .
      721   on choose of b-help in frame Dialog-Frame
      722   do:
      723     apply "help":u to frame Dialog-Frame .
      724   end.
      725   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      726   procedure minbtn-set :
      727       do
      728           on error undo, return error return-value
      729           :
      730           define variable ii              as integer       no-undo .
      731           define variable fh              as widget-handle no-undo .
      732           define variable hh              as widget-handle no-undo .
      733           define variable v-h             as handle        extent 4 no-undo .
      734           define variable v-name-button   as character     no-undo .
      735           define variable v-help-old-x    as decimal       no-undo .
      736           define variable v-help-old-y    as decimal       no-undo .
      737           define variable v-help-old-size as decimal       no-undo .
      738           define variable v-frame-width   as decimal       no-undo .
      739           define variable jj              as integer       no-undo .
      740           do
      741               on error undo, return error
      742               :
      743               assign
      744                   v-frame-width = frame Dialog-Frame:width - 0.3
      745                   fh            = frame Dialog-Frame:first-child
      746                   hh            = fh:first-child
      747                   ii            = 1
      748                   .
      749               do while valid-handle(hh):
      750                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      751                   do:
      752                       case lc(hh:name) :
      753                           when "b-help" then
      754                               do:
      755                                   hh:load-image-up("cmp/b-help.bmp":u) .
      756                                   hh:load-image-down("cmp/b-help.bmp":u) .
      757                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      758                                   hh:TOOLTIP = "Помощь" .
      759                                   v-help-old-x = hh:column .
      760                                   v-help-old-y = hh:row    .
      761                                   v-help-old-size = hh:width .
      762                                   hh:width-chars = 2.5 .
      763                               end.
      764                           when "b-print" then
      765                               do:
      766                                   hh:load-image("cmp/b-print.bmp":u) .
      767                                   hh:TOOLTIP = "Печать" .
      768                                   v-h[ii] = hh:handle .
      769                                   ii = ii + 1 .
      770                                   hh:width-chars = 3 .
      771                               end.
      772                           when "b-history" or
      773                           when "b-hist" then
      774                               do:
      775                                   hh:load-image("cmp/b-hist.bmp":u) .
      776                                   hh:TOOLTIP = "История" .
      777                                   v-h[ii] = hh:handle .
      778                                   ii = ii + 1 .
      779                                   hh:width-chars = 3 .
      780                               end.
      781                           when "b-sch" then
      782                               do:
      783                                   hh:load-image("cmp/b-sch.bmp":u) .
      784                                   hh:TOOLTIP = "Установка Фильтра" .
      785                                   v-h[ii] = hh:handle .
      786                                   ii = ii + 1 .
      787                                   hh:width-chars = 3 .
      788                               end.
      789                           when "b-hist-user" then
      790                               do:
      791                                   hh:load-image("cmp/b-hist.bmp":u) .
      792                                   hh:TOOLTIP = "История пользователя" .
      793                                   ii = ii + 1 .
      794                               end.
      795                       end case.
      796                   end.
      797                   hh = hh:next-sibling.
      798               end.
      799               b-help:column = v-frame-width - b-help:width-chars.
      800               jj = 0.
      801               repeat ii = 4 to 1 by -1 :
      802                   if valid-handle (v-h[ii] ) then
      803                   do:
      804                       jj  = jj + 1 .
      805                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      806                       v-h[ii]:row    = v-help-old-y .
      807                   end.
      808               end.
      809           end.
      810       end.
      811   end procedure.
      812   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      813   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      814   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      815   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      816   define variable v-diasize-current-frame-width  as decimal   no-undo .
      817   define variable v-diasize-current-frame-height as decimal   no-undo .
      818   define variable v-diasize-change-size          as logical   no-undo .
      819   define variable v-diasize-resize-button        as handle    no-undo .
      820   define variable v-diasize-wndmax               as logical   no-undo .
      821   define variable v-diasize-wndstore             as logical   no-undo .
      822   define variable v-diasize-proc-name            as character no-undo .
      823   define variable v-diasize-browse-handle        as handle    no-undo .
      824   define variable v-diasize-browse-number        as integer   no-undo .
      825   define variable v-diasize-need-full-display    as logical   no-undo init false .
      826   define temp-table temp-diasize-handle no-undo
      827     field handle-value  as handle
      828     field save-position as decimal
      829     index xpk is primary unique handle-value
      830     .
      831   define temp-table temp-browse-handle no-undo
      832     field browse-type   as character
      833     field browse-number as integer
      834     field browse-handle as handle
      835     field original-size as decimal
      836     index xpk is primary unique browse-type browse-number
      837     index xie browse-type browse-handle
      838   .
      839   procedure diasize_change-height :
      840     define input  parameter p-change-value  as decimal   no-undo .
      841     define input  parameter p-move-resize   as logical   no-undo .
      842     define variable v-field-group-handle    as handle    no-undo .
      843     define variable v-object-handle         as handle    no-undo .
      844     define variable v-frame-height          as decimal   no-undo .
      845     define variable v-frame-virtual-height  as decimal   no-undo .
      846     define variable v-browse-height         as decimal   no-undo .
      847     define variable v-window-height         as decimal   no-undo .
      848     define variable v-window-virtual-height as decimal   no-undo .
      849     define variable v-change-sign           as integer   no-undo .
      850     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      851     define buffer buf_temp-browse-handle  for temp-browse-handle .
      852     if p-change-value > 0
      853     then do:
      854       if frame Dialog-Frame :height + p-change-value
      855           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      856       then do:
      857         assign
      858           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      859                           - (frame Dialog-Frame :height-chars)
      860         .
      861         if p-change-value <= 0
      862         then do:
      863           run diasize_position-resize-button in this-procedure .
      864           return .
      865         end.
      866       end.
      867     end.
      868     if p-change-value < 0
      869     then do:
      870       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      871       then do:
      872         assign
      873           p-change-value = v-diasize-orig-frame-height
      874                          - (frame Dialog-Frame :height-chars)
      875         .
      876         if p-change-value >= 0
      877         then do:
      878           run diasize_position-resize-button in this-procedure .
      879           return .
      880         end.
      881       end.
      882     end.
      883     if p-change-value >= 0
      884     then do:
      885       assign
      886         v-change-sign = 1
      887       .
      888     end.
      889     else do:
      890       assign
      891         v-change-sign = -1
      892       .
      893     end.
      894     assign
      895       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      896     .
      897     if p-change-value = 0
      898     then do:
      899       run diasize_position-resize-button in this-procedure .
      900       return .
      901     end.
      902     move_block:
      903     do
      904     on error undo move_block, retry move_block
      905     :
      906       if retry
      907       then do:
      908         do
      909         on error undo move_block, leave move_block
      910         :
      911           if p-change-value > 0
      912           then do:
      913             for each buf_temp-diasize-handle
      914             on error undo, next
      915             :
      916               assign
      917                 v-object-handle = buf_temp-diasize-handle.handle-value
      918               .
      919               if v-object-handle <> v-diasize-resize-button
      920               then do:
      921                 assign
      922                   v-object-handle :row = buf_temp-diasize-handle.save-position
      923                 .
      924               end.
      925             end.
      926             assign
      927               v-diasize-browse-handle :height = v-browse-height
      928             .
      929             for each buf_temp-browse-handle
      930               where buf_temp-browse-handle.browse-type = 'height':u
      931             on error undo, next
      932             :
      933               assign
      934                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      935               .
      936             end.
      937             assign
      938               frame Dialog-Frame :height = v-frame-height
      939             .
      940             if frame Dialog-Frame :scrollable = true
      941             then do:
      942               assign
      943                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      944               .
      945             end.
      946             run diasize_position-resize-button in this-procedure .
      947           end.
      948           else do:
      949             if frame Dialog-Frame :scrollable = true
      950             then do:
      951               assign
      952                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      953               .
      954             end.
      955             assign
      956               frame Dialog-Frame :height = v-frame-height
      957             .
      958             assign
      959               v-diasize-browse-handle :height = v-browse-height
      960             .
      961             for each buf_temp-browse-handle
      962               where buf_temp-browse-handle.browse-type = 'height':u
      963             on error undo, next
      964             :
      965               assign
      966                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      967               .
      968             end.
      969             for each buf_temp-diasize-handle
      970             on error undo, next
      971             :
      972               assign
      973                 v-object-handle = buf_temp-diasize-handle.handle-value
      974               .
      975               if v-object-handle <> v-diasize-resize-button
      976               then do:
      977                 assign
      978                   v-object-handle :row = buf_temp-diasize-handle.save-position
      979                 .
      980               end.
      981             end.
      982             run diasize_position-resize-button in this-procedure .
      983           end.
      984           assign
      985             v-diasize-change-size = false
      986           .
      987           leave move_block .
      988         end.
      989       end.
      990       assign
      991         v-diasize-need-full-display = true
      992       .
      993       if v-diasize-change-size = false
      994       then do:
      995         assign
      996           v-diasize-change-size = true
      997         .
      998       end.
      999       else do:
     1000         return .
     1001       end.
     1002       assign
     1003         v-frame-height = frame Dialog-Frame :height
     1004         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1005         v-browse-height = v-diasize-browse-handle :height
     1006       .
     1007       for each buf_temp-browse-handle
     1008         where buf_temp-browse-handle.browse-type = 'height':u
     1009       :
     1010         assign
     1011           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1012         .
     1013       end.
     1014       for each buf_temp-diasize-handle
     1015       :
     1016         delete buf_temp-diasize-handle .
     1017       end.
     1018       assign
     1019         v-field-group-handle = frame Dialog-Frame :first-child
     1020       .
     1021       do while valid-handle(v-field-group-handle)
     1022       :
     1023         assign
     1024           v-object-handle = v-field-group-handle :first-child
     1025         .
     1026         do while valid-handle(v-object-handle)
     1027         :
     1028           if  v-object-handle <> v-diasize-browse-handle :handle
     1029           and can-query(v-object-handle, "row")
     1030           and can-query(v-object-handle, "height")
     1031           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1032           then do:
     1033             find first buf_temp-browse-handle
     1034               where buf_temp-browse-handle.browse-type   = 'height':u
     1035                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1036               no-error .
     1037             if available buf_temp-browse-handle
     1038             then do:
     1039             end.
     1040             else do:
     1041               create buf_temp-diasize-handle .
     1042               assign
     1043                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1044                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1045               .
     1046             end.
     1047           end.
     1048           assign
     1049             v-object-handle = v-object-handle :next-sibling
     1050           .
     1051         end.
     1052         assign
     1053           v-field-group-handle = v-field-group-handle :next-sibling
     1054         .
     1055       end.
     1056       do with frame Dialog-Frame
     1057       :
     1058         hide v-diasize-resize-button .
     1059         assign
     1060           v-diasize-resize-button :row    = 1
     1061           v-diasize-resize-button :column = 1
     1062         .
     1063       end.
     1064       if p-change-value > 0
     1065       then do:
     1066         if frame Dialog-Frame :scrollable = true
     1067         then do:
     1068           assign
     1069             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1070             no-error .
     1071           if error-status :error
     1072           or error-status :get-message(1) <> ""
     1073           then do:
     1074             undo move_block, retry move_block .
     1075           end.
     1076         end.
     1077         assign
     1078           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1079           no-error .
     1080         if error-status :error
     1081         or error-status :get-message(1) <> ""
     1082         then do:
     1083           undo move_block, retry move_block .
     1084         end.
     1085         assign
     1086           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1087           no-error .
     1088         if error-status :error
     1089         or error-status :get-message(1) <> ""
     1090         then do:
     1091           undo move_block, retry move_block .
     1092         end.
     1093         for each buf_temp-browse-handle
     1094           where buf_temp-browse-handle.browse-type = 'height':u
     1095         on error undo move_block, retry move_block
     1096         :
     1097           assign
     1098             buf_temp-browse-handle.browse-handle :height
     1099               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1100             no-error .
     1101           if error-status :error
     1102           or error-status :get-message(1) <> ""
     1103           then do:
     1104             undo move_block, retry move_block .
     1105           end.
     1106         end.
     1107         for each buf_temp-diasize-handle
     1108         on error undo move_block, retry move_block
     1109         :
     1110           assign
     1111             v-object-handle = buf_temp-diasize-handle.handle-value
     1112           .
     1113           if v-object-handle <> v-diasize-resize-button
     1114           then do:
     1115             assign
     1116               v-object-handle :row = v-object-handle :row + p-change-value
     1117               no-error .
     1118             if error-status :error
     1119             or error-status :get-message(1) <> ""
     1120             then do:
     1121               undo move_block, retry move_block .
     1122             end.
     1123           end.
     1124         end.
     1125       end.
     1126       else do:
     1127         for each buf_temp-diasize-handle
     1128         on error undo move_block, retry move_block
     1129         :
     1130           assign
     1131             v-object-handle = buf_temp-diasize-handle.handle-value
     1132           .
     1133           if v-object-handle <> v-diasize-resize-button
     1134           then do:
     1135             assign
     1136               v-object-handle :row = v-object-handle :row + p-change-value
     1137               no-error .
     1138             if error-status :error
     1139             or error-status :get-message(1) <> ""
     1140             then do:
     1141               undo move_block, retry move_block .
     1142             end.
     1143           end.
     1144         end.
     1145         assign
     1146           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1147           no-error .
     1148         if error-status :error
     1149         or error-status :get-message(1) <> ""
     1150         then do:
     1151           undo move_block, retry move_block .
     1152         end.
     1153         for each buf_temp-browse-handle
     1154           where buf_temp-browse-handle.browse-type = 'height':u
     1155         on error undo move_block, retry move_block
     1156         :
     1157           assign
     1158             buf_temp-browse-handle.browse-handle :height
     1159               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1160             no-error .
     1161           if error-status :error
     1162           or error-status :get-message(1) <> ""
     1163           then do:
     1164             undo move_block, retry move_block .
     1165           end.
     1166         end.
     1167         assign
     1168           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1169           no-error .
     1170         if error-status :error
     1171         or error-status :get-message(1) <> ""
     1172         then do:
     1173           undo move_block, retry move_block .
     1174         end.
     1175         if frame Dialog-Frame :scrollable = true
     1176         then do:
     1177           assign
     1178             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1179             no-error .
     1180           if error-status :error
     1181           or error-status :get-message(1) <> ""
     1182           then do:
     1183             undo move_block, retry move_block .
     1184           end.
     1185         end.
     1186       end.
     1187       if p-move-resize = true
     1188       then do:
     1189         run diasize_position-resize-button in this-procedure .
     1190       end.
     1191       if v-diasize-wndstore = true
     1192       then do:
     1193         if connected("ub") = true
     1194         then do:
     1195           define variable v-cntxt-db-num        as integer   no-undo .
     1196           define variable v-cntxt-userid        as character no-undo .
     1197           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1198                                             , OUTPUT v-cntxt-userid
     1199                                             ) .
     1200           run gbl/wndsizew.p
     1201             (input  v-cntxt-db-num
     1202             ,input  v-cntxt-userid
     1203             ,input  v-diasize-proc-name
     1204             ,input  'height':u
     1205             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1206             ) .
     1207         end.
     1208       end.
     1209     end.
     1210     assign
     1211       v-diasize-change-size = false
     1212     .
     1213   end procedure.
     1214   procedure diasize_set-height :
     1215     define input  parameter p-new-height  as decimal   no-undo .
     1216     define input  parameter p-move-resize as logical   no-undo .
     1217     do
     1218     on error undo, return error return-value
     1219     :
     1220       run diasize_change-height in this-procedure
     1221         (input  (p-new-height - frame Dialog-Frame :height)
     1222         ,input  p-move-resize
     1223         ) .
     1224     end.
     1225   end procedure.
     1226   procedure diasize_change-width :
     1227     define input  parameter p-change-value as decimal   no-undo .
     1228     define input  parameter p-move-resize  as logical   no-undo .
     1229     define variable v-field-group-handle   as handle    no-undo .
     1230     define variable v-object-handle        as handle    no-undo .
     1231     define variable v-frame-width          as decimal   no-undo .
     1232     define variable v-frame-virtual-width  as decimal   no-undo .
     1233     define variable v-browse-width         as decimal   no-undo .
     1234     define variable v-window-width         as decimal   no-undo .
     1235     define variable v-window-virtual-width as decimal   no-undo .
     1236     define variable v-change-sign          as integer   no-undo .
     1237     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1238     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1239     if p-change-value > 0
     1240     then do:
     1241       if frame Dialog-Frame :width + p-change-value >
     1242           session :width-chars
     1243       then do:
     1244         assign
     1245           p-change-value = session :width-chars - frame Dialog-Frame :width
     1246         .
     1247         if p-change-value <= 0
     1248         then do:
     1249           run diasize_position-resize-button in this-procedure .
     1250           return .
     1251         end.
     1252       end.
     1253     end.
     1254     if p-change-value < 0
     1255     then do:
     1256       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1257       then do:
     1258         assign
     1259           p-change-value = v-diasize-orig-frame-width
     1260                          - frame Dialog-Frame :width
     1261         .
     1262         if p-change-value >= 0
     1263         then do:
     1264           run diasize_position-resize-button in this-procedure .
     1265           return .
     1266         end.
     1267       end.
     1268     end.
     1269     if p-change-value >= 0
     1270     then do:
     1271       assign
     1272         v-change-sign = 1
     1273       .
     1274     end.
     1275     else do:
     1276       assign
     1277         v-change-sign = -1
     1278       .
     1279     end.
     1280     assign
     1281       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1282     .
     1283     if p-change-value = 0
     1284     then do:
     1285       run diasize_position-resize-button in this-procedure .
     1286       return .
     1287     end.
     1288     move_block:
     1289     do
     1290     on error undo move_block, leave move_block
     1291     :
     1292       if retry
     1293       then do:
     1294         do
     1295         on error undo move_block, leave move_block
     1296         :
     1297           if p-change-value > 0
     1298           then do:
     1299             for each buf_temp-diasize-handle
     1300             on error undo, next
     1301             :
     1302               assign
     1303                 v-object-handle = buf_temp-diasize-handle.handle-value
     1304               .
     1305               if v-object-handle <> v-diasize-resize-button
     1306               then do:
     1307                 assign
     1308                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1309                 .
     1310               end.
     1311             end.
     1312             assign
     1313               v-diasize-browse-handle :width = v-browse-width
     1314             .
     1315             for each buf_temp-browse-handle
     1316               where buf_temp-browse-handle.browse-type = 'width':u
     1317             on error undo, next
     1318             :
     1319               assign
     1320                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1321               .
     1322             end.
     1323             assign
     1324               frame Dialog-Frame :width = v-frame-width
     1325             .
     1326             if frame Dialog-Frame :scrollable = true
     1327             then do:
     1328               assign
     1329                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1330               .
     1331             end.
     1332             run diasize_position-resize-button in this-procedure .
     1333           end.
     1334           else do:
     1335             if frame Dialog-Frame :scrollable = true
     1336             then do:
     1337               assign
     1338                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1339               .
     1340             end.
     1341             assign
     1342               frame Dialog-Frame :width = v-frame-width
     1343             .
     1344             for each buf_temp-browse-handle
     1345               where buf_temp-browse-handle.browse-type = 'width':u
     1346             on error undo, next
     1347             :
     1348               assign
     1349                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1350               .
     1351             end.
     1352             assign
     1353               v-diasize-browse-handle :width = v-browse-width
     1354             .
     1355             for each buf_temp-diasize-handle
     1356             on error undo, next
     1357             :
     1358               assign
     1359                 v-object-handle = buf_temp-diasize-handle.handle-value
     1360               .
     1361               if v-object-handle <> v-diasize-resize-button
     1362               then do:
     1363                 assign
     1364                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1365                 .
     1366               end.
     1367             end.
     1368             run diasize_position-resize-button in this-procedure .
     1369           end.
     1370           assign
     1371             v-diasize-change-size = false
     1372           .
     1373           leave move_block .
     1374         end.
     1375       end.
     1376       assign
     1377         v-diasize-need-full-display = true
     1378       .
     1379       if v-diasize-change-size = false
     1380       then do:
     1381         assign
     1382           v-diasize-change-size = true
     1383         .
     1384       end.
     1385       else do:
     1386         return .
     1387       end.
     1388       assign
     1389         v-frame-width = frame Dialog-Frame :width
     1390         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1391         v-browse-width = v-diasize-browse-handle :width
     1392       .
     1393       for each buf_temp-browse-handle
     1394         where buf_temp-browse-handle.browse-type = 'width':u
     1395       :
     1396         assign
     1397           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1398         .
     1399       end.
     1400       for each buf_temp-diasize-handle
     1401       :
     1402         delete buf_temp-diasize-handle .
     1403       end.
     1404       assign
     1405         v-field-group-handle = frame Dialog-Frame :first-child
     1406       .
     1407       do while valid-handle(v-field-group-handle)
     1408       :
     1409         assign
     1410           v-object-handle = v-field-group-handle :first-child
     1411         .
     1412         do while valid-handle(v-object-handle)
     1413         :
     1414           if  v-object-handle <> v-diasize-browse-handle :handle
     1415           and v-object-handle <> v-diasize-resize-button
     1416           and can-query(v-object-handle, "row")
     1417           and can-query(v-object-handle, "height")
     1418           and ( v-object-handle :col + v-object-handle :width
     1419                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1420               )
     1421           then do:
     1422             find first buf_temp-browse-handle
     1423               where buf_temp-browse-handle.browse-type   = 'width':u
     1424                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1425               no-error .
     1426             if available buf_temp-browse-handle
     1427             then do:
     1428             end.
     1429             else do:
     1430               create buf_temp-diasize-handle .
     1431               assign
     1432                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1433                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1434               .
     1435             end.
     1436           end.
     1437           assign
     1438             v-object-handle = v-object-handle :next-sibling
     1439           .
     1440         end.
     1441         assign
     1442           v-field-group-handle = v-field-group-handle :next-sibling
     1443         .
     1444       end.
     1445       do with frame Dialog-Frame
     1446       :
     1447         hide v-diasize-resize-button .
     1448         v-diasize-resize-button :row = 1.
     1449         v-diasize-resize-button :column = 1.
     1450       end.
     1451       if p-change-value > 0
     1452       then do:
     1453         if frame Dialog-Frame :scrollable = true
     1454         then do:
     1455           assign
     1456             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1457             no-error .
     1458           if error-status :error
     1459           or error-status :get-message(1) <> ""
     1460           then do:
     1461             undo move_block, retry move_block.
     1462           end.
     1463         end.
     1464         assign
     1465           frame Dialog-Frame :width = v-frame-width + p-change-value
     1466           no-error .
     1467         if error-status :error
     1468         or error-status :get-message(1) <> ""
     1469         then do:
     1470           undo move_block, retry move_block.
     1471         end.
     1472         assign
     1473           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1474         no-error .
     1475         if error-status :error
     1476         or error-status :get-message(1) <> ""
     1477         then do:
     1478           undo move_block, retry move_block.
     1479         end.
     1480         for each buf_temp-browse-handle
     1481           where buf_temp-browse-handle.browse-type = 'width':u
     1482         on error undo move_block, retry move_block
     1483         :
     1484           assign
     1485             buf_temp-browse-handle.browse-handle :width
     1486               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1487             no-error .
     1488           if error-status :error
     1489           or error-status :get-message(1) <> ""
     1490           then do:
     1491             undo move_block, retry move_block .
     1492           end.
     1493         end.
     1494         for each buf_temp-diasize-handle
     1495         on error undo move_block, retry move_block
     1496         :
     1497           assign
     1498             v-object-handle = buf_temp-diasize-handle.handle-value
     1499           .
     1500           if v-object-handle <> v-diasize-resize-button
     1501           then do:
     1502             assign
     1503               v-object-handle :col = v-object-handle :col + p-change-value
     1504               no-error .
     1505             if error-status :error
     1506             or error-status :get-message(1) <> ""
     1507             then do:
     1508               undo move_block, retry move_block .
     1509             end.
     1510           end.
     1511         end.
     1512       end.
     1513       else do:
     1514         for each buf_temp-diasize-handle
     1515         on error undo move_block, retry move_block
     1516         :
     1517           assign
     1518             v-object-handle = buf_temp-diasize-handle.handle-value
     1519           .
     1520           if v-object-handle <> v-diasize-resize-button
     1521           then do:
     1522             assign
     1523               v-object-handle :col = v-object-handle :col + p-change-value
     1524               no-error .
     1525             if error-status :error
     1526             or error-status :get-message(1) <> ""
     1527             then do:
     1528               undo move_block, retry move_block .
     1529             end.
     1530           end.
     1531         end.
     1532         for each buf_temp-browse-handle
     1533           where buf_temp-browse-handle.browse-type = 'width':u
     1534         on error undo move_block, retry move_block
     1535         :
     1536           assign
     1537             buf_temp-browse-handle.browse-handle :width
     1538               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1539             no-error .
     1540           if error-status :error
     1541           or error-status :get-message(1) <> ""
     1542           then do:
     1543             undo move_block, retry move_block .
     1544           end.
     1545         end.
     1546         assign
     1547           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1548           no-error .
     1549         if error-status :error
     1550         or error-status :get-message(1) <> ""
     1551         then do:
     1552           undo move_block, retry move_block.
     1553         end.
     1554         assign
     1555           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1556         no-error .
     1557         if error-status :error
     1558         or error-status :get-message(1) <> ""
     1559         then do:
     1560           undo move_block, retry move_block.
     1561         end.
     1562         if frame Dialog-Frame :scrollable = true
     1563         then do:
     1564           assign
     1565             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1566           no-error .
     1567           if error-status :error
     1568           or error-status :get-message(1) <> ""
     1569           then do:
     1570             undo move_block, retry move_block.
     1571           end.
     1572         end.
     1573       end.
     1574       if p-move-resize
     1575       then do:
     1576         run diasize_position-resize-button in this-procedure .
     1577       end.
     1578       if v-diasize-wndstore = true
     1579       then do:
     1580         if connected("ub") = true
     1581         then do:
     1582           define variable v-cntxt-db-num        as integer   no-undo .
     1583           define variable v-cntxt-userid        as character no-undo .
     1584           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1585                                             , OUTPUT v-cntxt-userid
     1586                                             ) .
     1587           run gbl/wndsizew.p
     1588             (input  v-cntxt-db-num
     1589             ,input  v-cntxt-userid
     1590             ,input  v-diasize-proc-name
     1591             ,input  'width':u
     1592             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1593             ) .
     1594         end.
     1595       end.
     1596     end.
     1597     assign
     1598       v-diasize-change-size = false
     1599     .
     1600   end procedure.
     1601   procedure diasize_set-width :
     1602     define input  parameter p-new-width  as decimal   no-undo .
     1603     define input  parameter p-move-resize as logical   no-undo .
     1604     do
     1605     on error undo, return error return-value
     1606     :
     1607       run diasize_change-width in this-procedure
     1608         (input  (p-new-width - frame Dialog-Frame :width)
     1609         ,input  p-move-resize
     1610         ) .
     1611     end.
     1612   end procedure.
     1613   procedure diasize_position-resize-button :
     1614     do with frame Dialog-Frame
     1615     :
     1616       hide v-diasize-resize-button .
     1617       assign
     1618         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1619                     - 1
     1620                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1621         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1622                     - 1
     1623                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1624       .
     1625       view v-diasize-resize-button .
     1626     end.
     1627   end procedure.
     1628   on alt-right anywhere
     1629   do:
     1630     run diasize_change-width in this-procedure
     1631       (input 1
     1632       ,input true
     1633       ) .
     1634     return no-apply .
     1635   end.
     1636   on alt-left anywhere
     1637   do:
     1638     run diasize_change-width in this-procedure
     1639       (input -1
     1640       ,input true
     1641       ) .
     1642     return no-apply .
     1643   end.
     1644   on alt-down anywhere
     1645   do:
     1646     run diasize_change-height in this-procedure
     1647       (input 1
     1648       ,input true
     1649       ) .
     1650     return no-apply .
     1651   end.
     1652   on alt-up anywhere
     1653   do:
     1654     run diasize_change-height in this-procedure
     1655       (input -1
     1656       ,input true
     1657       ) .
     1658     return no-apply .
     1659   end.
     1660   on alt-enter of frame Dialog-Frame
     1661   do:
     1662     run diasize_maximize in this-procedure
     1663       (input  ?
     1664       ).
     1665     return no-apply .
     1666   end.
     1667   procedure diasize_end-move :
     1668     do
     1669     on error undo, return error return-value
     1670     :
     1671       define variable v-row-delta as decimal   no-undo .
     1672       define variable v-col-delta as decimal   no-undo .
     1673       define variable v-new-row as decimal   no-undo .
     1674       define variable v-new-col as decimal   no-undo .
     1675       assign
     1676         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1677         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1678       .
     1679       assign
     1680         v-row-delta = v-new-row - frame Dialog-Frame :height
     1681         v-col-delta = v-new-col - frame Dialog-Frame :width
     1682       .
     1683       run diasize_change-height in this-procedure
     1684         (input v-row-delta
     1685         ,input true
     1686         ) .
     1687       run diasize_change-width in this-procedure
     1688         (input v-col-delta
     1689         ,input true
     1690         ) .
     1691     end.
     1692   end procedure.
     1693   procedure diasize_maximize :
     1694     define input  parameter p-action as logical   no-undo .
     1695     do
     1696     on error undo, return error return-value
     1697     :
     1698       if p-action = ?
     1699       then do:
     1700         if v-diasize-need-maximize = true
     1701         then do:
     1702           assign
     1703             p-action = true
     1704           .
     1705         end.
     1706         else do:
     1707           assign
     1708             p-action = false
     1709           .
     1710         end.
     1711       end.
     1712       if p-action = true
     1713       then do:
     1714         run diasize_change-height in this-procedure
     1715           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1716               - frame Dialog-Frame :height-chars
     1717           ,input true
     1718           ) .
     1719         run diasize_change-width in this-procedure
     1720           (input session :width-chars
     1721               - frame Dialog-Frame :width-chars
     1722           ,input true
     1723           ) .
     1724         assign
     1725           v-diasize-need-maximize = false
     1726         .
     1727       end.
     1728       else do:
     1729         run diasize_change-width in this-procedure
     1730           (input v-diasize-orig-frame-width
     1731               - frame Dialog-Frame :width-chars
     1732           ,input true
     1733           ) .
     1734         run diasize_change-height in this-procedure
     1735           (input v-diasize-orig-frame-height
     1736               - frame Dialog-Frame :height-chars
     1737           ,input true
     1738           ) .
     1739         assign
     1740           v-diasize-need-maximize = true
     1741         .
     1742       end.
     1743     end.
     1744   end procedure.
     1745   procedure diasize_restore-orig-size :
     1746     do
     1747     on error undo, return error return-value
     1748     :
     1749       assign
     1750         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1751         v-diasize-current-frame-height = frame Dialog-Frame :height
     1752       .
     1753       run diasize_set-height in this-procedure
     1754         (input  v-diasize-orig-frame-height
     1755         ,input  true
     1756         ) .
     1757       run diasize_set-width in this-procedure
     1758         (input  v-diasize-orig-frame-width
     1759         ,input  true
     1760         ) .
     1761     end.
     1762   end procedure.
     1763   procedure diasize_restore-current-size :
     1764     do
     1765     on error undo, return error return-value
     1766     :
     1767       run diasize_set-height in this-procedure
     1768         (input  v-diasize-current-frame-height
     1769         ,input  true
     1770         ) .
     1771       run diasize_set-width in this-procedure
     1772         (input  v-diasize-current-frame-width
     1773         ,input  true
     1774         ) .
     1775     end.
     1776   end procedure.
     1777   procedure diasize_set-browse-handle :
     1778     define input  parameter p-browse-handle as handle   no-undo .
     1779     define buffer buf_temp-browse-handle for temp-browse-handle .
     1780     do
     1781     on error undo, return error return-value
     1782     :
     1783       assign
     1784         v-diasize-browse-handle = p-browse-handle
     1785       .
     1786       for each buf_temp-browse-handle
     1787       on error undo, return error return-value
     1788       :
     1789         delete buf_temp-browse-handle .
     1790       end.
     1791     end.
     1792   end procedure.
     1793   procedure diasize_add_browse :
     1794     define input  parameter p-browse-type   as character no-undo .
     1795     define input  parameter p-browse-handle as handle    no-undo .
     1796     define buffer buf_temp-browse-handle for temp-browse-handle .
     1797     do
     1798     on error undo, return error return-value
     1799     :
     1800       assign
     1801         v-diasize-browse-number = v-diasize-browse-number + 1
     1802       .
     1803       create buf_temp-browse-handle .
     1804       assign
     1805         buf_temp-browse-handle.browse-type   = p-browse-type
     1806         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1807         buf_temp-browse-handle.browse-handle = p-browse-handle
     1808       .
     1809     end.
     1810   end procedure.
     1811   procedure diasize_init :
     1812     define variable v-default-value    as logical   no-undo .
     1813     define variable v-restore-saved    as logical   no-undo .
     1814     define variable v-resize-value-str as character no-undo .
     1815     do
     1816     on error undo, return error return-value
     1817     :
     1818       do with frame Dialog-Frame
     1819       :
     1820         assign
     1821           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1822           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1823           v-diasize-browse-handle     = browse BR-changes :handle
     1824         .
     1825         create button v-diasize-resize-button
     1826         assign
     1827           parent        = frame Dialog-Frame :first-child
     1828           label         = "s"
     1829           height-pixels = 16
     1830           width-pixels  = 16
     1831           visible       = true
     1832           sensitive     = true
     1833           movable       = true
     1834           triggers:
     1835             on end-move persistent run diasize_end-move in this-procedure .
     1836           end triggers.
     1837         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1838         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1839         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1840         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1841         assign
     1842           v-diasize-wndmax = false
     1843         .
     1844         if connected("ub") = true
     1845         then do:
     1846           define variable v-cntxt-db-num        as integer   no-undo .
     1847           define variable v-cntxt-userid        as character no-undo .
     1848           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1849                                             , OUTPUT v-cntxt-userid
     1850                                             ) .
     1851           run gbl/wndpar_r.p
     1852             (input  v-cntxt-db-num
     1853             ,input  v-cntxt-userid
     1854             ,input  'wndmax':U
     1855             ,output v-diasize-wndmax
     1856             ,output v-default-value
     1857             ) .
     1858         end.
     1859         assign
     1860           v-diasize-wndstore = false
     1861         .
     1862         if connected("ub") = true
     1863         then do:
     1864           run gbl/wndpar_r.p
     1865             (input  v-cntxt-db-num
     1866             ,input  v-cntxt-userid
     1867             ,input  'wndstore':U
     1868             ,output v-diasize-wndstore
     1869             ,output v-default-value
     1870             ) .
     1871         end.
     1872         assign
     1873           v-diasize-proc-name = entry(1, program-name(2), '.')
     1874         .
     1875         if v-diasize-wndstore = true
     1876         then do:
     1877           assign
     1878             v-restore-saved = false
     1879           .
     1880           if connected("ub") = true
     1881           then do:
     1882             run gbl/wndsizer.p
     1883               (input  v-cntxt-db-num
     1884               ,input  v-cntxt-userid
     1885               ,input  v-diasize-proc-name
     1886               ,input  'height':u
     1887               ,output v-resize-value-str
     1888               ) .
     1889             if v-resize-value-str <> '':U
     1890             then do:
     1891               run diasize_change-height in this-procedure
     1892                 (input  integer(v-resize-value-str)
     1893                 ,input  true
     1894                 ) .
     1895               assign
     1896                 v-restore-saved = true
     1897               .
     1898             end.
     1899           end.
     1900           if connected("ub") = true
     1901           then do:
     1902             run gbl/wndsizer.p
     1903               (input  v-cntxt-db-num
     1904               ,input  v-cntxt-userid
     1905               ,input  v-diasize-proc-name
     1906               ,input  'width':u
     1907               ,output v-resize-value-str
     1908               ) .
     1909             if v-resize-value-str <> '':U
     1910             then do:
     1911               run diasize_change-width in this-procedure
     1912                 (input  integer(v-resize-value-str)
     1913                 ,input  true
     1914                 ) .
     1915               assign
     1916                 v-restore-saved = true
     1917               .
     1918             end.
     1919           end.
     1920           if v-restore-saved <> true
     1921           then do:
     1922             if v-diasize-wndmax = true
     1923             then do:
     1924               run diasize_maximize in this-procedure
     1925                 (input  true
     1926                 ) .
     1927             end.
     1928           end.
     1929         end.
     1930         else do:
     1931           if v-diasize-wndmax = true
     1932           then do:
     1933             run diasize_maximize in this-procedure
     1934               (input  true
     1935               ) .
     1936           end.
     1937         end.
     1938       end.
     1939     end.
     1940   end procedure.
     1941   procedure diasize_need-full-display :
     1942     define output parameter p-need-full-display as logical   no-undo .
     1943     do
     1944     on error undo, return error return-value
     1945     :
     1946       assign
     1947         p-need-full-display = v-diasize-need-full-display
     1948       .
     1949       assign
     1950         v-diasize-need-full-display = false
     1951       .
     1952     end.
     1953   end procedure.
     1954   procedure get-context :
     1955      define output parameter p-db-num as integer          no-undo.
     1956      define output parameter p-user-id as character        no-undo.
     1957      define variable v-login               as character    no-undo.
     1958      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1959      define buffer buf_user-login  for ub.user-login .
     1960      do
     1961      on error undo, return error
     1962      :
     1963            FIND FIRST buf_sys-ctrl no-lock.
     1964            ASSIGN
     1965               v-login = USERID("ub")
     1966               p-db-num = buf_sys-ctrl.db-num
     1967            .
     1968            FIND FIRST buf_user-login
     1969                 WHERE buf_user-login.db-num = p-db-num
     1970                   AND buf_user-login.user-login = v-login
     1971                 no-lock
     1972                 no-error
     1973                 .
     1974            IF AVAILABLE buf_user-login
     1975            THEN DO:
     1976               assign
     1977                  p-user-id = buf_user-login.user-id
     1978               .
     1979            END.
     1980      end.
     1981   end procedure.
     1982       run diasize_init in this-procedure .
     1983   MAIN-BLOCK:
     1984   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1985      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1986   buf_c-season.corr-date:read-only in browse br-docs = true .
     1987   define variable p-file-label as character no-undo .
     1988     run my-enable_ui in this-procedure .
     1989     run openbr in this-procedure .
     1990     hide mark-num in frame Dialog-Frame .
     1991     apply "VALUE-CHANGED" to br-docs in frame Dialog-Frame.
     1992     wait-for go of frame Dialog-Frame.
     1993   END.
     1994   run disable_UI in this-procedure .
     1995   PROCEDURE disable_UI :
     1996     HIDE FRAME Dialog-Frame.
     1997   END PROCEDURE.
     1998   PROCEDURE enable_UI :
     1999     OPEN QUERY Dialog-Frame FOR EACH ub.c-season SHARE-LOCK.
     2000     GET FIRST Dialog-Frame.
     2001     DISPLAY mark-num
     2002         WITH FRAME Dialog-Frame.
     2003     ENABLE B-Cancel B-Help BR-docs BR-changes mark-num
     2004         WITH FRAME Dialog-Frame.
     2005     VIEW FRAME Dialog-Frame.
     2006     OPEN QUERY BR-docs FOR EACH buf_c-season no-lock.
     2007   END PROCEDURE.
     2008   PROCEDURE my-enable_UI :
     2009   DISPLAY   mark-num
     2010         WITH FRAME Dialog-Frame.
     2011     ENABLE B-Cancel
     2012            B-Help
     2013            BR-docs
     2014            BR-changes
     2015         WITH FRAME Dialog-Frame.
     2016     VIEW FRAME Dialog-Frame.
     2017   END PROCEDURE.
     2018   PROCEDURE OpenBr :
     2019   OPEN QUERY BR-docs FOR EACH buf_c-season where
     2020              buf_c-season.sea-code = par-sea-code and
     2021              buf_c-season.db-num   = par-db-num
     2022              no-lock.
     2023   APPLY "VALUE-CHANGED" TO br-docs in frame Dialog-Frame.
     2024   APPLY "ENTRY" TO br-docs.
     2025   END PROCEDURE.
     2026   PROCEDURE proc-view-changes :
     2027   define buffer new_c-season for ub.c-season.
     2028   define buffer current_season for ub.season.
     2029   define variable v-chg-fields as character no-undo.
     2030   define variable v-old-fields as character no-undo.
     2031   define variable v-new-fields as character no-undo.
     2032   define variable ii as integer no-undo.
     2033   for each temp-changes:
     2034       delete temp-changes.
     2035   END.
     2036   if not available buf_c-season then do:
     2037     Open QUery br-changes for each temp-changes.
     2038     return.
     2039   end.
     2040   find first new_c-season no-lock where
     2041              new_c-season.sea-code  = buf_c-season.sea-code
     2042          and new_c-season.db-num    = buf_c-season.db-num
     2043          AND new_c-season.chip-num  > buf_c-season.chip-num no-error.
     2044   if not available new_c-season then do:
     2045       find first current_season no-lock where
     2046                  current_season.sea-code  = buf_c-season.sea-code and
     2047                  current_season.db-num    = buf_c-season.db-num no-error.
     2048            if not available current_season then do:
     2049            return error.
     2050       end.
     2051       buffer-compare current_season to buf_c-season
     2052       save result in v-chg-fields.
     2053   end.
     2054   else do:
     2055       buffer-compare new_c-season except chip-num corr-date corr-user-name corr-user-db-num to buf_c-season
     2056       save result in v-chg-fields.
     2057   end.
     2058   define variable v-nn as integer   no-undo .
     2059   v-nn = num-entries(v-chg-fields).
     2060   do ii = 1 to v-nn :
     2061   CASE entry(ii, v-chg-fields):
     2062   when "List_":U then do:     create temp-changes.     assign     temp-changes.f_name = "List_":U     temp-changes.l_name = "Список"     temp-changes.v_old = string(buf_c-season.List_)     temp-changes.v_new = (if available new_c-season                               then string(new_c-season.List_)                               else string(current_season.List_))     .   end.
     2063   when "sea-code":U then do:     create temp-changes.     assign     temp-changes.f_name = "sea-code":U     temp-changes.l_name = "Код сезона"     temp-changes.v_old = string(buf_c-season.sea-code)     temp-changes.v_new = (if available new_c-season                               then string(new_c-season.sea-code)                               else string(current_season.sea-code))     .   end.
     2064   when "db-num":U then do:     create temp-changes.     assign     temp-changes.f_name = "db-num":U     temp-changes.l_name = "БД"     temp-changes.v_old = string(buf_c-season.db-num)     temp-changes.v_new = (if available new_c-season                               then string(new_c-season.db-num)                               else string(current_season.db-num))     .   end.
     2065   when "sea-month-1":U then do:     create temp-changes.     assign     temp-changes.f_name = "sea-month-1":U     temp-changes.l_name = "Месяц с"     temp-changes.v_old = string(buf_c-season.sea-month-1)     temp-changes.v_new = (if available new_c-season                               then string(new_c-season.sea-month-1)                               else string(current_season.sea-month-1))     .   end.
     2066   when "sea-month-2":U then do:     create temp-changes.     assign     temp-changes.f_name = "sea-month-2":U     temp-changes.l_name = "Месяц по"     temp-changes.v_old = string(buf_c-season.sea-month-2)     temp-changes.v_new = (if available new_c-season                               then string(new_c-season.sea-month-2)                               else string(current_season.sea-month-2))     .   end.
     2067   when "sea-name":U then do:     create temp-changes.     assign     temp-changes.f_name = "sea-name":U     temp-changes.l_name = "Наименование сезона/коллекции"     temp-changes.v_old = string(buf_c-season.sea-name)     temp-changes.v_new = (if available new_c-season                               then string(new_c-season.sea-name)                               else string(current_season.sea-name))     .   end.
     2068   when "stts":U then do:     create temp-changes.     assign     temp-changes.f_name = "stts":U     temp-changes.l_name = "Статус (0-текущий)"     temp-changes.v_old = string(buf_c-season.stts)     temp-changes.v_new = (if available new_c-season                               then string(new_c-season.stts)                               else string(current_season.stts))     .   end.
     2069   END CASE.
     2070   end.
     2071   Open QUery br-changes for each temp-changes.
     2072   END PROCEDURE.
     2073   FUNCTION date-func RETURNS DATE
     2074   ( input date-int as int) :
     2075    define variable date-res as date no-undo.
     2076      if  date-int <= 12 then return error.
     2077      assign date-res = date (date-int) no-error.
     2078    RETURN date-res.
     2079   END FUNCTION.
