        1   define input parameter parparentproc as widget-handle no-undo .
        2   define input parameter p-mode as character no-undo .
        3   define input parameter p-stop-list-code as character no-undo .
        4   define variable vss-revision    as character no-undo init "$Revision$":U .
        5   define variable vss-author      as character no-undo init "$Author$":U .
        6   define variable vss-date        as character no-undo init "$Date$":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        8   define variable vss-archive     as character no-undo init "$Archive$":U .
        9   define variable vss-description as character no-undo init "Запуск импорта стоплистов".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       65   define variable v-waitfram-action01         as character   no-undo .
       66   define variable v-waitfram-action02         as character   no-undo .
       67   define variable v-waitfram-action03         as character   no-undo .
       68   define variable mWaitFramTextBeg            as character   no-undo.
       69   define variable mWaitFramTextEnd            as character   no-undo.
       70   define variable mWaitFramView               as logical     no-undo.
       71   define variable mWaitProcEvent              as logical     no-undo init yes.
       72   define variable mWaitFramInterval           as integer     no-undo init 1 .
       73   define variable mWaitFramStop               as logical     no-undo.
       74   define variable mWaitFramStopUser           as logical     no-undo.
       75   define variable mWaitFramStopTimeOut        as logical     no-undo.
       76   define variable mWaitFramStartProc          as datetime-tz no-undo.
       77   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       78   define button B-WaitFramStop auto-end-key
       79        label "Стоп"
       80        size 10 by 1 tooltip "Остоновить процесс".
       81   define button B-viewProcInfo
       82        label "Информация"
       83        size 15 by 1 tooltip "Информация о процесс".
       84   define frame waitfram
       85     v-waitfram-action01 format "x(72)" no-label skip
       86     v-waitfram-action02 format "x(72)" no-label skip
       87     v-waitfram-action03 format "x(72)" no-label skip
       88     B-viewProcInfo
       89     B-WaitFramStop at row 4 col 30
       90     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       91     .
       92   define new global shared variable mBatchMode as logical no-undo init ?.
       93   define variable mFramBachModHandle as handle no-undo.
       94   mFramBachModHandle = frame waitfram:handle.
       95   define variable mFameOldVis as logical no-undo.
       96   define variable mVisCUrentVin as logical no-undo.
       97   if session:batch-mode
       98   then
       99      mBatchMode = yes.
      100   if mBatchMode = ? then do:
      101     mVisCUrentVin = current-window:visible.
      102     mFameOldVis = mFramBachModHandle:visible.
      103     mFramBachModHandle:visible  = yes.
      104     mBatchMode = mFramBachModHandle:visible ne yes.
      105     mFramBachModHandle:visible = mFameOldVis.
      106     current-window:visible = mVisCUrentVin.
      107   end.
      108    if  log-manager:logfile-name ne ?
      109     then DO:
      110         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      111         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      112         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      113     end.
      114   on choose of B-WaitFramStop in frame waitfram
      115   do:
      116     mWaitFramStop = yes.
      117     mWaitFramStopUser = yes.
      118   end.
      119   function waitfram-check-timeout returns logical():
      120      define variable vtime as int64 no-undo.
      121      if mWaitFramStopTimeOut
      122      then
      123         return yes.
      124      vtime = ( now - mWaitFramStartProc ) / 1000 .
      125      if     mWaitFramTimeOut ne ?
      126         and mWaitFramTimeOut ne 0
      127         and mWaitFramTimeOut lt vtime
      128      then do:
      129         mWaitFramStopTimeOut = yes.
      130      end.
      131      return mWaitFramStopTimeOut.
      132   end.
      133   procedure waitfram-hide :
      134     if not session:batch-mode
      135     then do
      136     on error undo, return error return-value
      137     :
      138       pause 0 before-hide .
      139       if not mBatchMode then
      140         hide frame waitfram .
      141     if     not mWaitFramView
      142        and mWaitProcEvent
      143     then
      144       process events .
      145     end.
      146   end procedure.
      147   procedure waitfram-show :
      148     define input  parameter p-message as character no-undo .
      149     define variable v-left-margin as integer   no-undo .
      150     if not session:batch-mode
      151     then do
      152     on error undo, return error return-value
      153     :
      154       if length(p-message) <= 70 then do:
      155         assign
      156           v-left-margin = integer((70 - length(p-message)) / 2)
      157         .
      158         assign
      159           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      160         .
      161         assign
      162           v-waitfram-action01 = " "
      163           v-waitfram-action02 = " "
      164                                    + fill(" ", v-left-margin)
      165                                    + p-message
      166           v-waitfram-action03 = " "
      167         .
      168       end.
      169       else do:
      170         define variable vRindex1 as integer no-undo.
      171         define variable vRindex2 as integer no-undo.
      172         vRindex1 = r-index(p-message," ",70).
      173         if vRindex1 = 0
      174         then
      175            vRindex1 = 70.
      176         if length(p-message)  <= vRindex1 + 70 then do:
      177           assign
      178             v-waitfram-action01 = " "
      179             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      180             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      181           .
      182         end.
      183         else do:
      184           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      185           if vRindex2 <= vRindex1
      186           then
      187              vRindex2 = vRindex1 + 70.
      188           assign
      189             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      190             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      191             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      192           .
      193         end.
      194       end.
      195       B-viewProcInfo:visible   in frame waitfram = no.
      196       B-viewProcInfo:sensitive in frame waitfram = no.
      197       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      198       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      199       if  (   mWaitFramView
      200          or  mWaitProcEvent)
      201          and not mBatchMode
      202       then
      203          display
      204             v-waitfram-action01 skip
      205             v-waitfram-action02 skip
      206             v-waitfram-action03 skip
      207          with frame waitfram .
      208       if     mWaitFramView
      209          then do:
      210             if     mWaitFramInterval ne ?
      211                and not mBatchMode
      212             then
      213                wait-for go of frame waitfram pause mWaitFramInterval.
      214          end.
      215          else
      216             if     mWaitProcEvent
      217                and not mBatchMode
      218             then
      219                process events .
      220     end.
      221   end procedure.
      222      procedure waitfram-show-this:
      223         define input  parameter iInterval as int64 no-undo.
      224         define variable vtime as int64 no-undo.
      225         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      226         mWaitFramInterval = iInterval.
      227         run waitfram-show (substitute("&1&2 &3&4" ,
      228                                       mWaitFramTextBeg ,
      229                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      230                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      231                                       mWaitFramTextEnd
      232                                      )
      233                           ).
      234      end.
      235      procedure WaitFramRunPause:
      236         define input  parameter iInterval as dec no-undo.
      237         define variable vStart  as datetime-tz no-undo.
      238         define variable vend    as datetime-tz no-undo.
      239         define variable vint as int64 no-undo.
      240         define variable vOk as logical no-undo.
      241         vStart = now.
      242         vend   = vStart.
      243         publish "WaitFramPause" (iInterval,output vOk).
      244         vend   =  now.
      245         vint = vend - vStart.
      246         vint = iInterval - vint / 1000.
      247         if     not mWaitFramStop
      248            and (   vint > 0
      249                 or (    not vOk
      250                     and iInterval eq ?
      251                     )
      252                 )
      253         then
      254            run waitfram-show-this (iInterval).
      255         vend   =  now.
      256         vint = vend - vStart.
      257         vint = iInterval - vint / 1000.
      258         if     not mWaitFramStop
      259            and vint > 0
      260         then do:
      261            run gbl/pause.p (vint * 1000).
      262         end.
      263         if iInterval ne ?
      264         then
      265            publish "WaitFramStop".
      266         waitfram-check-timeout().
      267      end.
      268      procedure WaitFramWaitFor:
      269         define input  parameter iInterval as dec no-undo.
      270         assign
      271            mWaitFramStartProc   = now
      272            mWaitFramStopUser    = no
      273            mWaitFramStopTimeOut = no
      274         .
      275         block-wait:
      276         do while not mWaitFramStop:
      277            run WaitFramRunPause (iInterval).
      278            if  waitfram-check-timeout()
      279            then do:
      280               leave block-wait.
      281            end.
      282         end.
      283         run waitfram-hide.
      284      end.
      285   procedure waitfram-join :
      286     define input  parameter p-line-1  as character no-undo .
      287     define input  parameter p-line-2  as character no-undo .
      288     define input  parameter p-line-3  as character no-undo .
      289     define output parameter p-message as character no-undo .
      290     do
      291     on error undo, return error return-value
      292     :
      293       assign
      294         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      295                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      296                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      297       .
      298     end.
      299   end procedure.
      300   function waitfram-join-function returns character
      301     (input p-line-1 as character
      302     ,input p-line-2 as character
      303     ,input p-line-3 as character
      304     ).
      305     define variable v-message as character no-undo .
      306     run waitfram-join in this-procedure
      307       (input  p-line-1
      308       ,input  p-line-2
      309       ,input  p-line-3
      310       ,output v-message
      311       ) .
      312     return v-message .
      313   end function .
      314   define new global shared variable g#language as character no-undo .
      315   if g#language <> '' and g#language <> 'rus':U then do:
      316     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      317   end.
      318   define new global shared variable g#library  as handle no-undo .
      319   define new global shared variable g#library2 as handle no-undo .
      320   procedure proc-alt-shift-f2:
      321     if not ibs.th.gbl.gbl-var:rcode
      322   then
      323     run gbl\inidebug.p .
      324   end.
      325   procedure proc-alt-shift-f3:
      326     run gbl/prvssinf.p
      327       ( input this-procedure
      328       ) .
      329   end.
      330   define variable v-inform-launched as logical no-undo initial false .
      331   procedure proc-alt-shift-f4:
      332     define variable v-action as character no-undo .
      333     if v-inform-launched = false then do:
      334       assign
      335         v-inform-launched = true
      336       .
      337       run gbl/d-inform.w
      338         (  input self
      339         ,  input this-procedure
      340         , output v-action
      341         ) no-error .
      342       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      343       assign
      344         v-inform-launched = false
      345       .
      346     end.
      347   end.
      348   procedure proc-alt-f1:
      349     run gbl/corrhelp.p
      350       (input this-procedure
      351       ) .
      352   end .
      353   on alt-shift-f2 anywhere do:
      354     run proc-alt-shift-f2.
      355   end.
      356   on alt-shift-f3 anywhere do:
      357     run proc-alt-shift-f3 in this-procedure .
      358   end.
      359   on alt-shift-f4 anywhere do:
      360     run proc-alt-shift-f4 in this-procedure.
      361   end.
      362   on alt-f1 anywhere do:
      363     run proc-alt-f1 in this-procedure .
      364   end.
      365   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      366     define variable v-cntxt-db-num        as integer   no-undo .
      367     define variable v-cntxt-userid        as character no-undo .
      368     define variable v-cntxt-level         as character no-undo .
      369     define variable v-cntxt-host-code-obj as integer   no-undo .
      370     define variable v-cntxt-obj-type      as character no-undo .
      371     define variable v-cntxt-obj-code      as integer   no-undo .
      372     define variable v-cntxt-db-num-obj    as integer   no-undo .
      373     define variable v-cntxt-is-admin      as logical   no-undo .
      374   define buffer buf_stop-list for ub.stop-list.
      375   DEFINE BUTTON B-exit AUTO-GO
      376        LABEL "&Ввод"
      377        SIZE 10 BY 1
      378        BGCOLOR 8 .
      379   DEFINE BUTTON B-file
      380        IMAGE-UP FILE "btn-down-arrow":U
      381        IMAGE-DOWN FILE "btn-down-arrow":U
      382        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      383        LABEL ""
      384        SIZE 3 BY 1.
      385   DEFINE BUTTON B-Help
      386        LABEL "Помо&щь"
      387        SIZE 10 BY 1
      388        BGCOLOR 8 .
      389   DEFINE BUTTON b-quit AUTO-END-KEY
      390        LABEL "&Отмена"
      391        SIZE 10 BY 1
      392        BGCOLOR 8 .
      393   DEFINE VARIABLE f-stop-list-code AS INTEGER FORMAT ">>>>>>>>9":U INITIAL 0
      394        LABEL "№ стоплиста"
      395        VIEW-AS FILL-IN
      396        SIZE 10 BY 1 NO-UNDO.
      397   DEFINE VARIABLE file-name AS CHARACTER FORMAT "X(256)":U
      398        LABEL "Файл импорта (.xls)"
      399        VIEW-AS FILL-IN
      400        SIZE 73.5 BY 1 NO-UNDO.
      401   DEFINE VARIABLE t-fact AS LOGICAL INITIAL no
      402        LABEL "Поставить статус <факт> в случае удачного импорта"
      403        VIEW-AS TOGGLE-BOX
      404        SIZE 53 BY 1 NO-UNDO.
      405   DEFINE VARIABLE T-tocd AS LOGICAL INITIAL no
      406        LABEL "Отправить на кассу по окончании УДАЧНОГО импорта"
      407        VIEW-AS TOGGLE-BOX
      408        SIZE 53 BY 1 NO-UNDO.
      409   DEFINE FRAME Dialog-Frame
      410        B-exit AT ROW 1 COL 1
      411        b-quit AT ROW 1 COL 11
      412        B-Help AT ROW 1 COL 54.9
      413        file-name AT ROW 3.13 COL 1.5
      414        B-file AT ROW 3.13 COL 96.5
      415        f-stop-list-code AT ROW 5.8 COL 13 COLON-ALIGNED
      416        t-fact AT ROW 7.4 COL 14.5
      417        T-tocd AT ROW 8.73 COL 14.5
      418        SPACE(32.39) SKIP(0.63)
      419       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      420            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      421            TITLE ""
      422            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      423   ASSIGN
      424          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      425          FRAME Dialog-Frame:HIDDEN           = TRUE.
      426   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      427   DO:
      428     APPLY "END-ERROR":U TO SELF.
      429   END.
      430   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      431   DO:
      432      RUN proc-save IN THIS-PROCEDURE NO-ERROR.
      433     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      434   END.
      435   ON CHOOSE OF B-file IN FRAME Dialog-Frame
      436   DO:
      437   define variable v_os-file   AS CHAR NO-UNDO INIT "".
      438   define variable ll_commit AS LOG    NO-UNDO INIT NO.
      439   define variable v-full-path        as character no-undo .
      440   define variable v-path             as character no-undo .
      441   define variable v-file-name        as character no-undo .
      442   define variable v-file-name-no-ext as character no-undo .
      443   define variable v-file-name-ext    as character no-undo .
      444       SYSTEM-DIALOG GET-FILE v_os-file
      445           TITLE "Выберите файл для импорта"
      446           FILTERS
      447             " Все текстовые файлы (*.xls) " "*.xls",
      448             " Все файлы (*.*) "                      "*.*"
      449           INITIAL-FILTER 1
      450           DEFAULT-EXTENSION ".xls"
      451           USE-FILENAME
      452           MUST-EXIST
      453           UPDATE ll_commit
      454           .
      455       IF ll_commit <> YES THEN do:
      456          RETURN NO-APPLY.
      457       end.
      458       IF v_os-file = PROGRAM-NAME( 1 ) THEN DO:
      459           BELL.
      460           MESSAGE "Рекурсия!" VIEW-AS ALERT-BOX ERROR.
      461           RETURN NO-APPLY.
      462       END.
      463       ASSIGN file-name = ( IF SEARCH( v_os-file ) = ? THEN v_os-file ELSE SEARCH( v_os-file ) ).
      464       run gbl/filename.p (
      465                       input  v_os-file
      466                       ,output v-full-path
      467                       ,output v-path
      468                       ,output v-file-name
      469                       ,output v-file-name-no-ext
      470                       ,output v-file-name-ext
      471                       ) no-error .
      472       if error-status:error  = ? then do:
      473         return no-apply.
      474       end.
      475       assign
      476       file-name = v-full-path.
      477       DISP file-name WITH FRAME Dialog-Frame.
      478   END.
      479   ON LEAVE OF file-name IN FRAME Dialog-Frame
      480   DO:
      481       ASSIGN file-name.
      482       IF SEARCH( file-name ) <> ? AND SEARCH( file-name ) <> "":U THEN DO:
      483           ASSIGN FILE-INFO:FILE-NAME = file-name.
      484           IF FILE-INFO:FULL-PATHNAME <> ? THEN ASSIGN file-name = FILE-INFO:FULL-PATHNAME.
      485           DISP file-name WITH FRAME Dialog-Frame.
      486       END.
      487       APPLY "TAB":U TO file-name IN FRAME Dialog-Frame.
      488   END.
      489   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      490   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      491   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      492   on help of frame Dialog-Frame
      493   do:
      494     run gbl/app_help.p
      495       (input this-procedure :file-name
      496       ,input ''
      497       ,input ?
      498       ) no-error.
      499     if error-status :error then do:
      500       message
      501         "Ошибка при вызове помощи"
      502         error-status :get-message(1)
      503         view-as alert-box .
      504     end.
      505   end.
      506   run minbtn-set in this-procedure .
      507   on choose of b-help in frame Dialog-Frame
      508   do:
      509     apply "help":u to frame Dialog-Frame .
      510   end.
      511   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      512   procedure minbtn-set :
      513       do
      514           on error undo, return error return-value
      515           :
      516           define variable ii              as integer       no-undo .
      517           define variable fh              as widget-handle no-undo .
      518           define variable hh              as widget-handle no-undo .
      519           define variable v-h             as handle        extent 4 no-undo .
      520           define variable v-name-button   as character     no-undo .
      521           define variable v-help-old-x    as decimal       no-undo .
      522           define variable v-help-old-y    as decimal       no-undo .
      523           define variable v-help-old-size as decimal       no-undo .
      524           define variable v-frame-width   as decimal       no-undo .
      525           define variable jj              as integer       no-undo .
      526           do
      527               on error undo, return error
      528               :
      529               assign
      530                   v-frame-width = frame Dialog-Frame:width - 0.3
      531                   fh            = frame Dialog-Frame:first-child
      532                   hh            = fh:first-child
      533                   ii            = 1
      534                   .
      535               do while valid-handle(hh):
      536                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      537                   do:
      538                       case lc(hh:name) :
      539                           when "b-help" then
      540                               do:
      541                                   hh:load-image-up("cmp/b-help.bmp":u) .
      542                                   hh:load-image-down("cmp/b-help.bmp":u) .
      543                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      544                                   hh:TOOLTIP = "Помощь" .
      545                                   v-help-old-x = hh:column .
      546                                   v-help-old-y = hh:row    .
      547                                   v-help-old-size = hh:width .
      548                                   hh:width-chars = 2.5 .
      549                               end.
      550                           when "b-print" then
      551                               do:
      552                                   hh:load-image("cmp/b-print.bmp":u) .
      553                                   hh:TOOLTIP = "Печать" .
      554                                   v-h[ii] = hh:handle .
      555                                   ii = ii + 1 .
      556                                   hh:width-chars = 3 .
      557                               end.
      558                           when "b-history" or
      559                           when "b-hist" then
      560                               do:
      561                                   hh:load-image("cmp/b-hist.bmp":u) .
      562                                   hh:TOOLTIP = "История" .
      563                                   v-h[ii] = hh:handle .
      564                                   ii = ii + 1 .
      565                                   hh:width-chars = 3 .
      566                               end.
      567                           when "b-sch" then
      568                               do:
      569                                   hh:load-image("cmp/b-sch.bmp":u) .
      570                                   hh:TOOLTIP = "Установка Фильтра" .
      571                                   v-h[ii] = hh:handle .
      572                                   ii = ii + 1 .
      573                                   hh:width-chars = 3 .
      574                               end.
      575                           when "b-hist-user" then
      576                               do:
      577                                   hh:load-image("cmp/b-hist.bmp":u) .
      578                                   hh:TOOLTIP = "История пользователя" .
      579                                   ii = ii + 1 .
      580                               end.
      581                       end case.
      582                   end.
      583                   hh = hh:next-sibling.
      584               end.
      585               b-help:column = v-frame-width - b-help:width-chars.
      586               jj = 0.
      587               repeat ii = 4 to 1 by -1 :
      588                   if valid-handle (v-h[ii] ) then
      589                   do:
      590                       jj  = jj + 1 .
      591                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      592                       v-h[ii]:row    = v-help-old-y .
      593                   end.
      594               end.
      595           end.
      596       end.
      597   end procedure.
      598   MAIN-BLOCK:
      599   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      600      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      601   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      602     run mainmenu_getcntxt in parparentproc
      603       (output v-cntxt-db-num
      604       ,output v-cntxt-userid
      605       ,output v-cntxt-level
      606       ,output v-cntxt-host-code-obj
      607       ,output v-cntxt-obj-type
      608       ,output v-cntxt-obj-code
      609       ,output v-cntxt-db-num-obj
      610       ,output v-cntxt-is-admin
      611       ) .
      612     if v-cntxt-db-num > 0 then do:
      613       message
      614       "Запрещен импорт стоплистов в УБД"
      615       view-as alert-box error .
      616       undo, return error .
      617     end.
      618     if p-mode <> 'ДОБАВЛЕНИЕ':U
      619     and p-mode <> 'ИЗМЕНЕНИЕ':U then do:
      620       message
      621       substitute("Неверное значение параметра p-mode=&1", p-mode)
      622       view-as alert-box error .
      623       undo, return error .
      624     end.
      625     if p-stop-list-code <> '':U then do:
      626       find first buf_stop-list exclusive-lock where
      627                 buf_stop-list.classif-type = 'dis-card':U
      628             and buf_stop-list.stop-list-code = p-stop-list-code
      629              no-error .
      630       if not available buf_stop-list then do:
      631         message
      632         vss-workfile vss-revision vss-description skip
      633         "Неверное значение параметра p-stop-list-code" p-stop-list-code
      634         view-as alert-box error .
      635         undo, return error .
      636       end.
      637       if buf_stop-list.status_ = 'факт':U then do:
      638         message
      639         substitute("Стоплист &1 закрыт до статуса &2"
      640                     , p-stop-list-code
      641                     , buf_stop-list.status_
      642                     )
      643         view-as alert-box error .
      644         undo, return error .
      645       end.
      646     end.
      647     ELSE DO:
      648         find last buf_stop-list no-lock where
      649                   buf_stop-list.classif-type = 'dis-card':U no-error .
      650         if not available buf_stop-list then do:
      651         end.
      652         ELSE DO:
      653            if buf_stop-list.status_ <> 'факт':U then do:
      654              message
      655              substitute("Предыдущий стоплист &1 не закрыт до статуса &2&3Добавление невозможно"
      656                         ,buf_stop-list.stop-list-code
      657                         ,'факт':U
      658                         ,chr(10))
      659              view-as alert-box error .
      660              undo, return error .
      661            end.
      662            p-stop-list-code = STRING(next-value(s-stop-list, ub), "999999999").
      663         END.
      664     END.
      665     RUN Myenable.
      666     WAIT-FOR GO OF FRAME Dialog-Frame.
      667   END.
      668   RUN disable_UI.
      669   PROCEDURE disable_UI :
      670     HIDE FRAME Dialog-Frame.
      671   END PROCEDURE.
      672   PROCEDURE enable_UI :
      673     DISPLAY file-name f-stop-list-code t-fact T-tocd
      674         WITH FRAME Dialog-Frame.
      675     ENABLE B-exit b-quit B-Help file-name B-file f-stop-list-code t-fact T-tocd
      676         WITH FRAME Dialog-Frame.
      677     VIEW FRAME Dialog-Frame.
      678   END PROCEDURE.
      679   PROCEDURE MyEnable :
      680   define buffer buf_clients for ub.clients.
      681   find first buf_clients no-lock where
      682              buf_clients.obj-type = 'маг':U
      683         and  buf_clients.db-num = 0
      684         and buf_clients.stts = integer('0':U) no-error.
      685   assign
      686   f-stop-list-code = integer(p-stop-list-code).
      687   DISPLAY
      688   file-name
      689   f-stop-list-code
      690   T-tocd
      691   WITH FRAME Dialog-Frame .
      692   ENABLE
      693   B-exit
      694   b-quit
      695   B-Help
      696   file-name
      697   t-fact
      698   B-file
      699   f-stop-list-code  when p-stop-list-code = '':U
      700   T-tocd when (available buf_clients)
      701   WITH FRAME Dialog-Frame .
      702   VIEW FRAME Dialog-Frame .
      703   END PROCEDURE.
      704   PROCEDURE proc-save :
      705   ASSIGN FRAME Dialog-Frame
      706   f-stop-list-code
      707   t-tocd
      708   t-fact
      709   file-name
      710   .
      711    run str/diallog.w (
      712                  input parparentproc
      713                 ,input this-procedure
      714                 ,input 'ref/in-stpl1.p':U
      715                 ,input (file-name                        + chr(4) +
      716                         string(f-stop-list-code, "999999999") + chr(4) +
      717                         p-mode + chr(4) +
      718                         string(t-fact)
      719                    )
      720                 ,input no
      721                 ,input "&Стоп"
      722                 ,input 'Импорт стоплистов') .
      723   if t-tocd
      724   then do:
      725     find first buf_stop-list no-lock where
      726               buf_stop-list.classif-type = 'dis-card':U
      727             and buf_stop-list.stop-list-code = string(f-stop-list-code, "999999999").
      728     if available buf_stop-list
      729     and buf_stop-list.status_ = 'факт':U then do:
      730       run str/diallog.w (
      731                     input parparentproc
      732                     ,input this-procedure
      733                     ,input 'str/snd-stpl.p':U
      734                     ,input f-stop-list-code
      735                     ,input yes
      736                     ,input '':U
      737                     ,input 'Отправка информации по стоплистам на кассы') no-error .
      738     end.
      739   end.
      740   END PROCEDURE.
