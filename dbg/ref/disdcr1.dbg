        1   block-level on error undo, throw.
        2   define input parameter p-mode            as character no-undo .
        3   define input parameter p-d-card          like ub.dis-dc-rule.d-card no-undo .
        4   define input parameter p-host-code       like ub.dis-dc-rule.host-code no-undo .
        5   define input parameter p-obj-type        like ub.dis-dc-rule.obj-type no-undo .
        6   define input parameter p-obj-code        like ub.dis-dc-rule.obj-code no-undo .
        7   define temp-table tt0-dis-dc-rule no-undo like ub.dis-dc-rule.
        8   DEFINE INPUT PARAMETER TABLE FOR tt0-dis-dc-rule.
        9   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       11   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: disdcr1.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: ref/disdcr1.p $":U .
       14   define variable vss-description as character no-undo init "Сохранение изменений скидок ДК".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33       assign
       34         p-vss-parameters = substitute('&1|&2|&3|&4':u,p-d-card,p-host-code,p-obj-type,p-obj-code)
       35       .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define new global shared variable g#language as character no-undo .
       73   if g#language <> '' and g#language <> 'rus':U then do:
       74     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       75   end.
       76   define new global shared variable g#library  as handle no-undo .
       77   define new global shared variable g#library2 as handle no-undo .
       78   define   shared variable g#auto as logical no-undo.
       79   define   shared variable g#news as logical no-undo.
       80   define   shared variable g#oxml as logical no-undo.
       81   define   shared variable g#esys as logical no-undo.
       82   define   shared variable g#news-source-db as integer no-undo.
       83   define   shared variable g#esys-source-esys as integer no-undo.
       84   define   shared variable g#db-num as integer   no-undo .
       85   define   shared variable g#userid as character no-undo .
       86   define   shared variable g#passwd as character no-undo .
       87   define variable v-deleted as logical no-undo .
       88   define variable v-err-mess as character no-undo .
       89   define buffer buf_dis-dc-rule for ub.dis-dc-rule.
       90   define buffer buf_dis-card for ub.dis-card.
       91   _main:
       92   do
       93   on error undo, return error return-value
       94   :
       95     find first buf_dis-card no-lock where buf_dis-card.d-card = p-d-card no-error .
       96     if not available buf_dis-card then do:
       97       undo, return error substitute("&1 &2 &3&4Не найдена ДК &5"
       98                                    , vss-workfile
       99                                    , vss-revision
      100                                    , vss-description
      101                                    , chr(10)
      102                                    , p-d-card).
      103     end.
      104     FOR EACH tt0-dis-dc-rule where
      105     on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      106     on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
      107     on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )  :
      108       if tt0-dis-dc-rule.obj-type = 'орг':U and g#db-num <> 0 then next.
      109       if tt0-dis-dc-rule.obj-type = '':U and g#db-num <> 0 then next.
      110       if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
      111         find FIRST buf_dis-dc-rule WHERE
      112                   buf_dis-dc-rule.d-card = p-d-card
      113               AND buf_dis-dc-rule.host-code = tt0-dis-dc-rule.host-code
      114               AND buf_dis-dc-rule.obj-type = tt0-dis-dc-rule.obj-type
      115               AND buf_dis-dc-rule.obj-code = tt0-dis-dc-rule.obj-code
      116               AND buf_dis-dc-rule.pos-type = tt0-dis-dc-rule.pos-type
      117               AND buf_dis-dc-rule.discnt-role = tt0-dis-dc-rule.discnt-role
      118               AND buf_dis-dc-rule.nonunique = tt0-dis-dc-rule.nonunique
      119               no-error.
      120       end.
      121       IF p-mode = 'ДОБАВЛЕНИЕ':U
      122       or not available buf_dis-dc-rule
      123       or buf_dis-dc-rule.rule-num <> tt0-dis-dc-rule.rule-num THEN DO:
      124         if p-mode = 'ДОБАВЛЕНИЕ':U
      125         or not available buf_dis-dc-rule then do:
      126           create buf_dis-dc-rule.
      127           assign
      128           buf_dis-dc-rule.d-card = p-d-card
      129           buf_dis-dc-rule.obj-type = tt0-dis-dc-rule.obj-type
      130           buf_dis-dc-rule.obj-code = tt0-dis-dc-rule.obj-code
      131           buf_dis-dc-rule.host-code = tt0-dis-dc-rule.host-code
      132           buf_dis-dc-rule.pos-type = tt0-dis-dc-rule.pos-type
      133           buf_dis-dc-rule.nonunique = tt0-dis-dc-rule.nonunique
      134           buf_dis-dc-rule.discnt-role = tt0-dis-dc-rule.discnt-role
      135           .
      136         end.
      137         assign
      138         buf_dis-dc-rule.rule-num = tt0-dis-dc-rule.rule-num
      139         buf_dis-dc-rule.rl-root = tt0-dis-dc-rule.rule-num
      140         buf_dis-dc-rule.templ-rl-root = tt0-dis-dc-rule.templ-rl-root
      141         buf_dis-dc-rule.time-templ-rl-root = tt0-dis-dc-rule.time-templ-rl-root
      142         buf_dis-dc-rule.nonunique = tt0-dis-dc-rule.nonunique
      143         .
      144         release buf_dis-dc-rule no-error.
      145         IF ERROR-STATUS:ERROR THEN DO:
      146           assign
      147           v-err-mess = substitute("Ошибка при сохранении типа скидки &1 (POS &2) на ДК &3 на ФИРМЕ &4 Объект &5&6&7&8"
      148                                   ,entry (lookup (tt0-dis-dc-rule.discnt-role, 'debet-pay-pcnt-disc,debet-pay-abs-disc,debet-pay-qnty-disc,debet-pay-sum-disc,debet-pay-free-disc,dc-d-pcnt,dc-cash-d-pcnt,credit-pay-pcnt-disc,credit-pay-abs-disc,credit-pay-qnty-disc,credit-pay-sum-disc,credit-pay-free-disc':u) + 1, ',' + '% Скидка при оплате топлива по дебет.ведомости,ABS Скидка при оплате топлива по дебет.ведомости,Скидка на кол-во при оплате топлива по дебет.ведомости,Скидка на сумму при оплате топлива по дебет.ведомости,Своб скидка при оплате топлива по дебет.ведомости,% скидка на товар по ДК,% скидка на итог чека по ДК,% Скидка при оплате топлива по кредит.ведомости,Abs Скидка при оплате топлива по кредит.ведомости,Скидка на кол-во при оплате топлива по кредит.ведомости,Скидка на сумму при оплате топлива по кредит.ведомости,Своб Скидка на сумму при оплате топлива по кредит.ведомости':u)
      149                                   ,tt0-dis-dc-rule.pos-type
      150                                   ,p-d-card
      151                                   ,tt0-dis-dc-rule.host-code
      152                                   ,tt0-dis-dc-rule.obj-type
      153                                   ,tt0-dis-dc-rule.obj-code
      154                                   ,chr(10)
      155                                   ,error-status:get-message(1)
      156                                   ,return-value
      157                                   ).
      158           undo _main, return error v-err-mess.
      159         END.
      160       END.
      161     END.
      162     if p-mode <> 'ДОБАВЛЕНИЕ':U then do:
      163       FOR EACH buf_dis-dc-rule where
      164              buf_dis-dc-rule.d-card = p-d-card
      165       on error  undo _main, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
      166       on stop   undo _main, return error substitute( "&1. stop", vss-workfile )
      167       on endkey undo _main, return error substitute( "&1. endkey", vss-workfile )  :
      168         if buf_Dis-dc-rule.obj-type = 'орг':U and g#db-num <> 0 then next.
      169         if buf_dis-dc-rule.obj-type = '':U and g#db-num <> 0 then next.
      170         if (buf_dis-dc-rule.obj-type = 'маг':U
      171             or
      172             buf_dis-dc-rule.obj-type = 'скл':U )
      173         and ((buf_dis-dc-rule.obj-type <> p-obj-type
      174              or buf_dis-dc-rule.obj-code <> p-obj-code))  then next.
      175         if buf_dis-dc-rule.templ-rl-root = 0 then next.
      176           FIND FIRST tt0-dis-dc-rule NO-LOCK WHERE
      177               tt0-dis-dc-rule.d-card = p-d-card
      178           AND tt0-dis-dc-rule.host-code = buf_dis-dc-rule.host-code
      179           AND tt0-dis-dc-rule.obj-type = buf_dis-dc-rule.obj-type
      180           AND tt0-dis-dc-rule.obj-code = buf_dis-dc-rule.obj-code
      181           AND tt0-dis-dc-rule.pos-type = buf_dis-dc-rule.pos-type
      182           AND tt0-dis-dc-rule.discnt-role = buf_dis-dc-rule.discnt-role
      183           AND tt0-dis-dc-rule.nonunique = buf_dis-dc-rule.nonunique
      184           NO-ERROR.
      185         IF NOT AVAILABLE tt0-dis-dc-rule THEN DO:
      186           delete buf_dis-dc-rule no-error.
      187           IF error-status:error
      188           THEN DO:
      189             assign
      190             v-err-mess = substitute("Ошибка при удалении типа скидки скидки &1 (POS &2) на ДК &3 на ФИрме &4 Объект &5&6&7&8&9"
      191                                     ,entry (lookup (buf_dis-dc-rule.discnt-role, 'debet-pay-pcnt-disc,debet-pay-abs-disc,debet-pay-qnty-disc,debet-pay-sum-disc,debet-pay-free-disc,dc-d-pcnt,dc-cash-d-pcnt,credit-pay-pcnt-disc,credit-pay-abs-disc,credit-pay-qnty-disc,credit-pay-sum-disc,credit-pay-free-disc':u) + 1, ',' + '% Скидка при оплате топлива по дебет.ведомости,ABS Скидка при оплате топлива по дебет.ведомости,Скидка на кол-во при оплате топлива по дебет.ведомости,Скидка на сумму при оплате топлива по дебет.ведомости,Своб скидка при оплате топлива по дебет.ведомости,% скидка на товар по ДК,% скидка на итог чека по ДК,% Скидка при оплате топлива по кредит.ведомости,Abs Скидка при оплате топлива по кредит.ведомости,Скидка на кол-во при оплате топлива по кредит.ведомости,Скидка на сумму при оплате топлива по кредит.ведомости,Своб Скидка на сумму при оплате топлива по кредит.ведомости':u)
      192                                     ,buf_dis-dc-rule.pos-type
      193                                     ,p-d-card
      194                                     ,buf_dis-dc-rule.host-code
      195                                     ,buf_dis-dc-rule.obj-type
      196                                     ,buf_dis-dc-rule.obj-code
      197                                     ,chr(10)
      198                                     ,error-status:get-message(1)
      199                                     ,return-value
      200                                     ).
      201             undo _main, return error v-err-mess.
      202           END.
      203         END.
      204       END.
      205     end.
      206   end.
