      322     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      323   end.
      324   define new global shared variable g#library  as handle no-undo .
      325   define new global shared variable g#library2 as handle no-undo .
      326   define   shared variable g#auto as logical no-undo.
      327   define   shared variable g#news as logical no-undo.
      328   define   shared variable g#oxml as logical no-undo.
      329   define   shared variable g#esys as logical no-undo.
      330   define   shared variable g#news-source-db as integer no-undo.
      331   define   shared variable g#esys-source-esys as integer no-undo.
      332   define   shared variable g#db-num as integer   no-undo .
      333   define   shared variable g#userid as character no-undo .
      334   define   shared variable g#passwd as character no-undo .
      335   procedure proc-alt-shift-f2:
      336     if not ibs.th.gbl.gbl-var:rcode
      337   then
      338     run gbl\inidebug.p .
      339   end.
      340   procedure proc-alt-shift-f3:
