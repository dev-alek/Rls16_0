      380   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      381   PROCEDURE verify-ini-entry:
      382   DEFINE INPUT  PARAMETER ini-key-name     as character no-undo.
      383   DEFINE INPUT  PARAMETER ini-section-name as character no-undo.
      384   DEFINE INPUT  PARAMETER error-msg-text   as character no-undo.
      385   DEFINE INPUT  PARAMETER silence          as logical no-undo.
      386   DEFINE OUTPUT PARAMETER ini-entry-value  as character no-undo INIt ?.
      387   define variable v-mess as character no-undo .
      388   get-key-value section ini-section-name key ini-key-name value ini-entry-value.
      389   if ini-entry-value = ? and ini-key-name begins "spl"
      390   then
      391   get-key-value section ini-section-name key "splall" value ini-entry-value.
      392   if ini-entry-value = ? and ini-key-name begins "sav"
      393   then
      394   get-key-value section ini-section-name key "savall" value ini-entry-value.
      395   if ini-entry-value = ? then do:
      396     assign
      397     v-mess = substitute("Ошибка ini - файла:&1Секция &2&1Ключ &3&1&4"
      398                       , chr(10)
      399                       , ini-section-name
      400                       , ini-key-name
      401                       , error-msg-text).
      402       if not silence then do:
      403         message
      404         v-mess
      405         view-as alert-box ERROR  .
      406         return error.
      407       end.
      408       else do:
      409         return error v-mess.
      410       end.
      411   end.
      412   END PROCEDURE.
      413   PROCEDURE verify-file:
      414   DEFINE INPUT  PARAMETER filename       as character no-undo.
      415   DEFINE INPUT  PARAMETER error-msg-text as character no-undo.
      416   DEFINE INPUT  PARAMETER silence        as logical no-undo.
      417   DEFINE OUTPUT PARAMETER found          as logical no-undo.
      418   file-info:file-name = filename.
      419   found = NOT (file-info:full-pathname = ?).
      420   if NOT found  then do:
      421     if not silence then do:
      422       message error-msg-text
      423       view-as alert-box ERROR.
      424       return error.
      425     end.
      426     else return error error-msg-text.
      427   end.
      428   END PROCEDURE.
      429   DEFINE VARIABLE v-t-nums AS integer NO-UNDO.
      430   DEFINE BUTTON B-exit AUTO-GO
      431        LABEL "&Выбор"
      432        SIZE 10 BY 1
      433        BGCOLOR 8 .
      434   DEFINE BUTTON B-Help
      435        LABEL "Помо&щь"
      436        SIZE 10 BY 1
      437        BGCOLOR 8 .
      438   DEFINE BUTTON b-quit AUTO-END-KEY
      439        LABEL "&Отмена"
      440        SIZE 10 BY 1
      441        BGCOLOR 8 .
      442   DEFINE VARIABLE F-copy-nums AS INTEGER FORMAT ">>9":U INITIAL 0
      443        LABEL "Кол-во копий"
      444        VIEW-AS FILL-IN
      445        SIZE 5 BY 1 NO-UNDO.
      446   DEFINE VARIABLE f-docs-num AS INTEGER FORMAT ">>,>>9":U INITIAL 0
      447        LABEL "Количество платежей, выбранных для печати"
      448         VIEW-AS TEXT
      449        SIZE 8 BY .67
      450        FGCOLOR 4  NO-UNDO.
      451   DEFINE QUERY BR-fdp FOR
      452         tt-fdp SCROLLING.
      453   DEFINE BROWSE BR-fdp
      454     QUERY BR-fdp NO-LOCK DISPLAY
      455         tt-fdp.obj-name COLUMN-LABEL "Название шаблона" FORMAT "X(20)":U
      456         tt-fdp.num COLUMN-LABEL "Кол-во!копий" FORMAT ">9":U WIDTH 6
      457         tt-fdp.name1 COLUMN-LABEL "Доп. информация" FORMAT "X(50)":U
      458       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 13.5 EXPANDABLE.
      459   DEFINE FRAME Dialog-Frame
      460        B-exit AT ROW 1 COL 1
      461        b-quit AT ROW 1 COL 11
      462        B-Help AT ROW 1 COL 54.88
      463        BR-fdp AT ROW 4 COL 1
      464        F-copy-nums AT ROW 18.25 COL 4
      465        f-docs-num AT ROW 2.5 COL 43.5 COLON-ALIGNED
      466        SPACE(45.74) SKIP(18.86)
      467       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      468            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      469            TITLE "Настройка печати платежей"
      470            DEFAULT-BUTTON B-exit CANCEL-BUTTON b-quit.
      471   ASSIGN
      472          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      473          FRAME Dialog-Frame:HIDDEN           = TRUE.
      474   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      475   DO:
      476     APPLY "END-ERROR":U TO SELF.
      477   END.
      478   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      479   DO:
      480     IF NOT AVAILABLE tt-fdp THEN RETURN.
      481     ASSIGN
      482     f-copy-nums
      483     p-copy-nums = f-copy-nums
      484     p-add-info = tt-fdp.name1
      485     p-template-code = tt-fdp.rep-code
      486     .
      487   END.
      488   ON VALUE-CHANGED OF BR-fdp IN FRAME Dialog-Frame
      489   DO:
      490     IF AVAILABLE tt-fdp THEN DO:
      491        DISPLAY tt-fdp.num @ f-copy-nums WITH FRAME Dialog-Frame.
      492        ENABLE f-copy-nums WITH FRAME Dialog-Frame.
      493     END.
      494     ELSE DO:
      495        DISPLAY 0 @ f-copy-nums WITH FRAME Dialog-Frame.
      496        DISABLE f-copy-nums WITH FRAME Dialog-Frame.
      497     END.
      498   END.
      499   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      500   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      501   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      502   on help of frame Dialog-Frame
      503   do:
      504     run gbl/app_help.p
      505       (input this-procedure :file-name
      506       ,input ''
      507       ,input ?
      508       ) no-error.
      509     if error-status :error then do:
      510       message
      511         "Ошибка при вызове помощи"
      512         error-status :get-message(1)
      513         view-as alert-box .
      514     end.
      515   end.
      516   run minbtn-set in this-procedure .
      517   on choose of b-help in frame Dialog-Frame
      518   do:
      519     apply "help":u to frame Dialog-Frame .
      520   end.
      521   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      522   procedure minbtn-set :
      523       do
      524           on error undo, return error return-value
      525           :
      526           define variable ii              as integer       no-undo .
      527           define variable fh              as widget-handle no-undo .
      528           define variable hh              as widget-handle no-undo .
      529           define variable v-h             as handle        extent 4 no-undo .
      530           define variable v-name-button   as character     no-undo .
      531           define variable v-help-old-x    as decimal       no-undo .
      532           define variable v-help-old-y    as decimal       no-undo .
      533           define variable v-help-old-size as decimal       no-undo .
      534           define variable v-frame-width   as decimal       no-undo .
      535           define variable jj              as integer       no-undo .
      536           do
      537               on error undo, return error
      538               :
      539               assign
      540                   v-frame-width = frame Dialog-Frame:width - 0.3
      541                   fh            = frame Dialog-Frame:first-child
      542                   hh            = fh:first-child
      543                   ii            = 1
      544                   .
      545               do while valid-handle(hh):
      546                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      547                   do:
      548                       case lc(hh:name) :
      549                           when "b-help" then
      550                               do:
      551                                   hh:load-image-up("cmp/b-help.bmp":u) .
      552                                   hh:load-image-down("cmp/b-help.bmp":u) .
      553                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      554                                   hh:TOOLTIP = "Помощь" .
      555                                   v-help-old-x = hh:column .
      556                                   v-help-old-y = hh:row    .
      557                                   v-help-old-size = hh:width .
      558                                   hh:width-chars = 2.5 .
      559                               end.
      560                           when "b-print" then
      561                               do:
      562                                   hh:load-image("cmp/b-print.bmp":u) .
      563                                   hh:TOOLTIP = "Печать" .
      564                                   v-h[ii] = hh:handle .
      565                                   ii = ii + 1 .
      566                                   hh:width-chars = 3 .
      567                               end.
      568                           when "b-history" or
      569                           when "b-hist" then
      570                               do:
      571                                   hh:load-image("cmp/b-hist.bmp":u) .
      572                                   hh:TOOLTIP = "История" .
      573                                   v-h[ii] = hh:handle .
      574                                   ii = ii + 1 .
      575                                   hh:width-chars = 3 .
      576                               end.
      577                           when "b-sch" then
      578                               do:
      579                                   hh:load-image("cmp/b-sch.bmp":u) .
      580                                   hh:TOOLTIP = "Установка Фильтра" .
      581                                   v-h[ii] = hh:handle .
      582                                   ii = ii + 1 .
      583                                   hh:width-chars = 3 .
      584                               end.
      585                           when "b-hist-user" then
      586                               do:
      587                                   hh:load-image("cmp/b-hist.bmp":u) .
      588                                   hh:TOOLTIP = "История пользователя" .
      589                                   ii = ii + 1 .
      590                               end.
      591                       end case.
      592                   end.
      593                   hh = hh:next-sibling.
      594               end.
      595               b-help:column = v-frame-width - b-help:width-chars.
      596               jj = 0.
      597               repeat ii = 4 to 1 by -1 :
      598                   if valid-handle (v-h[ii] ) then
      599                   do:
      600                       jj  = jj + 1 .
      601                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      602                       v-h[ii]:row    = v-help-old-y .
      603                   end.
      604               end.
      605           end.
      606       end.
      607   end procedure.
      608   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      609   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      610   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      611   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      612   define variable v-diasize-current-frame-width  as decimal   no-undo .
      613   define variable v-diasize-current-frame-height as decimal   no-undo .
      614   define variable v-diasize-change-size          as logical   no-undo .
      615   define variable v-diasize-resize-button        as handle    no-undo .
      616   define variable v-diasize-wndmax               as logical   no-undo .
      617   define variable v-diasize-wndstore             as logical   no-undo .
      618   define variable v-diasize-proc-name            as character no-undo .
      619   define variable v-diasize-browse-handle        as handle    no-undo .
      620   define variable v-diasize-browse-number        as integer   no-undo .
      621   define variable v-diasize-need-full-display    as logical   no-undo init false .
      622   define temp-table temp-diasize-handle no-undo
      623     field handle-value  as handle
      624     field save-position as decimal
      625     index xpk is primary unique handle-value
      626     .
      627   define temp-table temp-browse-handle no-undo
      628     field browse-type   as character
      629     field browse-number as integer
      630     field browse-handle as handle
      631     field original-size as decimal
      632     index xpk is primary unique browse-type browse-number
      633     index xie browse-type browse-handle
      634   .
      635   procedure diasize_change-height :
      636     define input  parameter p-change-value  as decimal   no-undo .
      637     define input  parameter p-move-resize   as logical   no-undo .
      638     define variable v-field-group-handle    as handle    no-undo .
      639     define variable v-object-handle         as handle    no-undo .
      640     define variable v-frame-height          as decimal   no-undo .
      641     define variable v-frame-virtual-height  as decimal   no-undo .
      642     define variable v-browse-height         as decimal   no-undo .
      643     define variable v-window-height         as decimal   no-undo .
      644     define variable v-window-virtual-height as decimal   no-undo .
      645     define variable v-change-sign           as integer   no-undo .
      646     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      647     define buffer buf_temp-browse-handle  for temp-browse-handle .
      648     if p-change-value > 0
      649     then do:
      650       if frame Dialog-Frame :height + p-change-value
      651           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      652       then do:
      653         assign
      654           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      655                           - (frame Dialog-Frame :height-chars)
      656         .
      657         if p-change-value <= 0
      658         then do:
      659           run diasize_position-resize-button in this-procedure .
      660           return .
      661         end.
      662       end.
      663     end.
      664     if p-change-value < 0
      665     then do:
      666       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      667       then do:
      668         assign
      669           p-change-value = v-diasize-orig-frame-height
      670                          - (frame Dialog-Frame :height-chars)
      671         .
      672         if p-change-value >= 0
      673         then do:
      674           run diasize_position-resize-button in this-procedure .
      675           return .
      676         end.
      677       end.
      678     end.
      679     if p-change-value >= 0
      680     then do:
      681       assign
      682         v-change-sign = 1
      683       .
      684     end.
      685     else do:
      686       assign
      687         v-change-sign = -1
      688       .
      689     end.
      690     assign
      691       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      692     .
      693     if p-change-value = 0
      694     then do:
      695       run diasize_position-resize-button in this-procedure .
      696       return .
      697     end.
      698     move_block:
      699     do
      700     on error undo move_block, retry move_block
      701     :
      702       if retry
      703       then do:
      704         do
      705         on error undo move_block, leave move_block
      706         :
      707           if p-change-value > 0
      708           then do:
      709             for each buf_temp-diasize-handle
      710             on error undo, next
      711             :
      712               assign
      713                 v-object-handle = buf_temp-diasize-handle.handle-value
      714               .
      715               if v-object-handle <> v-diasize-resize-button
      716               then do:
      717                 assign
      718                   v-object-handle :row = buf_temp-diasize-handle.save-position
      719                 .
      720               end.
      721             end.
      722             assign
      723               v-diasize-browse-handle :height = v-browse-height
      724             .
      725             for each buf_temp-browse-handle
      726               where buf_temp-browse-handle.browse-type = 'height':u
      727             on error undo, next
      728             :
      729               assign
      730                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      731               .
      732             end.
      733             assign
      734               frame Dialog-Frame :height = v-frame-height
      735             .
      736             if frame Dialog-Frame :scrollable = true
      737             then do:
      738               assign
      739                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      740               .
      741             end.
      742             run diasize_position-resize-button in this-procedure .
      743           end.
      744           else do:
      745             if frame Dialog-Frame :scrollable = true
      746             then do:
      747               assign
      748                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      749               .
      750             end.
      751             assign
      752               frame Dialog-Frame :height = v-frame-height
      753             .
      754             assign
      755               v-diasize-browse-handle :height = v-browse-height
      756             .
      757             for each buf_temp-browse-handle
      758               where buf_temp-browse-handle.browse-type = 'height':u
      759             on error undo, next
      760             :
      761               assign
      762                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      763               .
      764             end.
      765             for each buf_temp-diasize-handle
      766             on error undo, next
      767             :
      768               assign
      769                 v-object-handle = buf_temp-diasize-handle.handle-value
      770               .
      771               if v-object-handle <> v-diasize-resize-button
      772               then do:
      773                 assign
      774                   v-object-handle :row = buf_temp-diasize-handle.save-position
      775                 .
      776               end.
      777             end.
      778             run diasize_position-resize-button in this-procedure .
      779           end.
      780           assign
      781             v-diasize-change-size = false
      782           .
      783           leave move_block .
      784         end.
      785       end.
      786       assign
      787         v-diasize-need-full-display = true
      788       .
      789       if v-diasize-change-size = false
      790       then do:
      791         assign
      792           v-diasize-change-size = true
      793         .
      794       end.
      795       else do:
      796         return .
      797       end.
      798       assign
      799         v-frame-height = frame Dialog-Frame :height
      800         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      801         v-browse-height = v-diasize-browse-handle :height
      802       .
      803       for each buf_temp-browse-handle
      804         where buf_temp-browse-handle.browse-type = 'height':u
      805       :
      806         assign
      807           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      808         .
      809       end.
      810       for each buf_temp-diasize-handle
      811       :
      812         delete buf_temp-diasize-handle .
      813       end.
      814       assign
      815         v-field-group-handle = frame Dialog-Frame :first-child
      816       .
      817       do while valid-handle(v-field-group-handle)
      818       :
      819         assign
      820           v-object-handle = v-field-group-handle :first-child
      821         .
      822         do while valid-handle(v-object-handle)
      823         :
      824           if  v-object-handle <> v-diasize-browse-handle :handle
      825           and can-query(v-object-handle, "row")
      826           and can-query(v-object-handle, "height")
      827           and ( v-object-handle :row > v-diasize-browse-handle :row )
      828           then do:
      829             find first buf_temp-browse-handle
      830               where buf_temp-browse-handle.browse-type   = 'height':u
      831                 and buf_temp-browse-handle.browse-handle = v-object-handle
      832               no-error .
      833             if available buf_temp-browse-handle
      834             then do:
      835             end.
      836             else do:
      837               create buf_temp-diasize-handle .
      838               assign
      839                 buf_temp-diasize-handle.handle-value  = v-object-handle
      840                 buf_temp-diasize-handle.save-position = v-object-handle :row
      841               .
      842             end.
      843           end.
      844           assign
      845             v-object-handle = v-object-handle :next-sibling
      846           .
      847         end.
      848         assign
      849           v-field-group-handle = v-field-group-handle :next-sibling
      850         .
      851       end.
      852       do with frame Dialog-Frame
      853       :
      854         hide v-diasize-resize-button .
      855         assign
      856           v-diasize-resize-button :row    = 1
      857           v-diasize-resize-button :column = 1
      858         .
      859       end.
      860       if p-change-value > 0
      861       then do:
      862         if frame Dialog-Frame :scrollable = true
      863         then do:
      864           assign
      865             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      866             no-error .
      867           if error-status :error
      868           or error-status :get-message(1) <> ""
      869           then do:
      870             undo move_block, retry move_block .
      871           end.
      872         end.
      873         assign
      874           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      875           no-error .
      876         if error-status :error
      877         or error-status :get-message(1) <> ""
      878         then do:
      879           undo move_block, retry move_block .
      880         end.
      881         assign
      882           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      883           no-error .
      884         if error-status :error
      885         or error-status :get-message(1) <> ""
      886         then do:
      887           undo move_block, retry move_block .
      888         end.
      889         for each buf_temp-browse-handle
      890           where buf_temp-browse-handle.browse-type = 'height':u
      891         on error undo move_block, retry move_block
      892         :
      893           assign
      894             buf_temp-browse-handle.browse-handle :height
      895               = buf_temp-browse-handle.browse-handle :height + p-change-value
      896             no-error .
      897           if error-status :error
      898           or error-status :get-message(1) <> ""
      899           then do:
      900             undo move_block, retry move_block .
      901           end.
      902         end.
      903         for each buf_temp-diasize-handle
      904         on error undo move_block, retry move_block
      905         :
      906           assign
      907             v-object-handle = buf_temp-diasize-handle.handle-value
      908           .
      909           if v-object-handle <> v-diasize-resize-button
      910           then do:
      911             assign
      912               v-object-handle :row = v-object-handle :row + p-change-value
      913               no-error .
      914             if error-status :error
      915             or error-status :get-message(1) <> ""
      916             then do:
      917               undo move_block, retry move_block .
      918             end.
      919           end.
      920         end.
      921       end.
      922       else do:
      923         for each buf_temp-diasize-handle
      924         on error undo move_block, retry move_block
      925         :
      926           assign
      927             v-object-handle = buf_temp-diasize-handle.handle-value
      928           .
      929           if v-object-handle <> v-diasize-resize-button
      930           then do:
      931             assign
      932               v-object-handle :row = v-object-handle :row + p-change-value
      933               no-error .
      934             if error-status :error
      935             or error-status :get-message(1) <> ""
      936             then do:
      937               undo move_block, retry move_block .
      938             end.
      939           end.
      940         end.
      941         assign
      942           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      943           no-error .
      944         if error-status :error
      945         or error-status :get-message(1) <> ""
      946         then do:
      947           undo move_block, retry move_block .
      948         end.
      949         for each buf_temp-browse-handle
      950           where buf_temp-browse-handle.browse-type = 'height':u
      951         on error undo move_block, retry move_block
      952         :
      953           assign
      954             buf_temp-browse-handle.browse-handle :height
      955               = buf_temp-browse-handle.browse-handle :height + p-change-value
      956             no-error .
      957           if error-status :error
      958           or error-status :get-message(1) <> ""
      959           then do:
      960             undo move_block, retry move_block .
      961           end.
      962         end.
      963         assign
      964           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      965           no-error .
      966         if error-status :error
      967         or error-status :get-message(1) <> ""
      968         then do:
      969           undo move_block, retry move_block .
      970         end.
      971         if frame Dialog-Frame :scrollable = true
      972         then do:
      973           assign
      974             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      975             no-error .
      976           if error-status :error
      977           or error-status :get-message(1) <> ""
      978           then do:
      979             undo move_block, retry move_block .
      980           end.
      981         end.
      982       end.
      983       if p-move-resize = true
      984       then do:
      985         run diasize_position-resize-button in this-procedure .
      986       end.
      987       if v-diasize-wndstore = true
      988       then do:
      989         if connected("ub") = true
      990         then do:
      991           define variable v-cntxt-db-num        as integer   no-undo .
      992           define variable v-cntxt-userid        as character no-undo .
      993           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      994                                             , OUTPUT v-cntxt-userid
      995                                             ) .
      996           run gbl/wndsizew.p
      997             (input  v-cntxt-db-num
      998             ,input  v-cntxt-userid
      999             ,input  v-diasize-proc-name
     1000             ,input  'height':u
     1001             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1002             ) .
     1003         end.
     1004       end.
     1005     end.
     1006     assign
     1007       v-diasize-change-size = false
     1008     .
     1009   end procedure.
     1010   procedure diasize_set-height :
     1011     define input  parameter p-new-height  as decimal   no-undo .
     1012     define input  parameter p-move-resize as logical   no-undo .
     1013     do
     1014     on error undo, return error return-value
     1015     :
     1016       run diasize_change-height in this-procedure
     1017         (input  (p-new-height - frame Dialog-Frame :height)
     1018         ,input  p-move-resize
     1019         ) .
     1020     end.
     1021   end procedure.
     1022   procedure diasize_change-width :
     1023     define input  parameter p-change-value as decimal   no-undo .
     1024     define input  parameter p-move-resize  as logical   no-undo .
     1025     define variable v-field-group-handle   as handle    no-undo .
     1026     define variable v-object-handle        as handle    no-undo .
     1027     define variable v-frame-width          as decimal   no-undo .
     1028     define variable v-frame-virtual-width  as decimal   no-undo .
     1029     define variable v-browse-width         as decimal   no-undo .
     1030     define variable v-window-width         as decimal   no-undo .
     1031     define variable v-window-virtual-width as decimal   no-undo .
     1032     define variable v-change-sign          as integer   no-undo .
     1033     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1034     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1035     if p-change-value > 0
     1036     then do:
     1037       if frame Dialog-Frame :width + p-change-value >
     1038           session :width-chars
     1039       then do:
     1040         assign
     1041           p-change-value = session :width-chars - frame Dialog-Frame :width
     1042         .
     1043         if p-change-value <= 0
     1044         then do:
     1045           run diasize_position-resize-button in this-procedure .
     1046           return .
     1047         end.
     1048       end.
     1049     end.
     1050     if p-change-value < 0
     1051     then do:
     1052       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1053       then do:
     1054         assign
     1055           p-change-value = v-diasize-orig-frame-width
     1056                          - frame Dialog-Frame :width
     1057         .
     1058         if p-change-value >= 0
     1059         then do:
     1060           run diasize_position-resize-button in this-procedure .
     1061           return .
     1062         end.
     1063       end.
     1064     end.
     1065     if p-change-value >= 0
     1066     then do:
     1067       assign
     1068         v-change-sign = 1
     1069       .
     1070     end.
     1071     else do:
     1072       assign
     1073         v-change-sign = -1
     1074       .
     1075     end.
     1076     assign
     1077       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1078     .
     1079     if p-change-value = 0
     1080     then do:
     1081       run diasize_position-resize-button in this-procedure .
     1082       return .
     1083     end.
     1084     move_block:
     1085     do
     1086     on error undo move_block, leave move_block
     1087     :
     1088       if retry
     1089       then do:
     1090         do
     1091         on error undo move_block, leave move_block
     1092         :
     1093           if p-change-value > 0
     1094           then do:
     1095             for each buf_temp-diasize-handle
     1096             on error undo, next
     1097             :
     1098               assign
     1099                 v-object-handle = buf_temp-diasize-handle.handle-value
     1100               .
     1101               if v-object-handle <> v-diasize-resize-button
     1102               then do:
     1103                 assign
     1104                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1105                 .
     1106               end.
     1107             end.
     1108             assign
     1109               v-diasize-browse-handle :width = v-browse-width
     1110             .
     1111             for each buf_temp-browse-handle
     1112               where buf_temp-browse-handle.browse-type = 'width':u
     1113             on error undo, next
     1114             :
     1115               assign
     1116                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1117               .
     1118             end.
     1119             assign
     1120               frame Dialog-Frame :width = v-frame-width
     1121             .
     1122             if frame Dialog-Frame :scrollable = true
     1123             then do:
     1124               assign
     1125                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1126               .
     1127             end.
     1128             run diasize_position-resize-button in this-procedure .
     1129           end.
     1130           else do:
     1131             if frame Dialog-Frame :scrollable = true
     1132             then do:
     1133               assign
     1134                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1135               .
     1136             end.
     1137             assign
     1138               frame Dialog-Frame :width = v-frame-width
     1139             .
     1140             for each buf_temp-browse-handle
     1141               where buf_temp-browse-handle.browse-type = 'width':u
     1142             on error undo, next
     1143             :
     1144               assign
     1145                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1146               .
     1147             end.
     1148             assign
     1149               v-diasize-browse-handle :width = v-browse-width
     1150             .
     1151             for each buf_temp-diasize-handle
     1152             on error undo, next
     1153             :
     1154               assign
     1155                 v-object-handle = buf_temp-diasize-handle.handle-value
     1156               .
     1157               if v-object-handle <> v-diasize-resize-button
     1158               then do:
     1159                 assign
     1160                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1161                 .
     1162               end.
     1163             end.
     1164             run diasize_position-resize-button in this-procedure .
     1165           end.
     1166           assign
     1167             v-diasize-change-size = false
     1168           .
     1169           leave move_block .
     1170         end.
     1171       end.
     1172       assign
     1173         v-diasize-need-full-display = true
     1174       .
     1175       if v-diasize-change-size = false
     1176       then do:
     1177         assign
     1178           v-diasize-change-size = true
     1179         .
     1180       end.
     1181       else do:
     1182         return .
     1183       end.
     1184       assign
     1185         v-frame-width = frame Dialog-Frame :width
     1186         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1187         v-browse-width = v-diasize-browse-handle :width
     1188       .
     1189       for each buf_temp-browse-handle
     1190         where buf_temp-browse-handle.browse-type = 'width':u
     1191       :
     1192         assign
     1193           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1194         .
     1195       end.
     1196       for each buf_temp-diasize-handle
     1197       :
     1198         delete buf_temp-diasize-handle .
     1199       end.
     1200       assign
     1201         v-field-group-handle = frame Dialog-Frame :first-child
     1202       .
     1203       do while valid-handle(v-field-group-handle)
     1204       :
     1205         assign
     1206           v-object-handle = v-field-group-handle :first-child
     1207         .
     1208         do while valid-handle(v-object-handle)
     1209         :
     1210           if  v-object-handle <> v-diasize-browse-handle :handle
     1211           and v-object-handle <> v-diasize-resize-button
     1212           and can-query(v-object-handle, "row")
     1213           and can-query(v-object-handle, "height")
     1214           and ( v-object-handle :col + v-object-handle :width
     1215                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1216               )
     1217           then do:
     1218             find first buf_temp-browse-handle
     1219               where buf_temp-browse-handle.browse-type   = 'width':u
     1220                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1221               no-error .
     1222             if available buf_temp-browse-handle
     1223             then do:
     1224             end.
     1225             else do:
     1226               create buf_temp-diasize-handle .
     1227               assign
     1228                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1229                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1230               .
     1231             end.
     1232           end.
     1233           assign
     1234             v-object-handle = v-object-handle :next-sibling
     1235           .
     1236         end.
     1237         assign
     1238           v-field-group-handle = v-field-group-handle :next-sibling
     1239         .
     1240       end.
     1241       do with frame Dialog-Frame
     1242       :
     1243         hide v-diasize-resize-button .
     1244         v-diasize-resize-button :row = 1.
     1245         v-diasize-resize-button :column = 1.
     1246       end.
     1247       if p-change-value > 0
     1248       then do:
     1249         if frame Dialog-Frame :scrollable = true
     1250         then do:
     1251           assign
     1252             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1253             no-error .
     1254           if error-status :error
     1255           or error-status :get-message(1) <> ""
     1256           then do:
     1257             undo move_block, retry move_block.
     1258           end.
     1259         end.
     1260         assign
     1261           frame Dialog-Frame :width = v-frame-width + p-change-value
     1262           no-error .
     1263         if error-status :error
     1264         or error-status :get-message(1) <> ""
     1265         then do:
     1266           undo move_block, retry move_block.
     1267         end.
     1268         assign
     1269           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1270         no-error .
     1271         if error-status :error
     1272         or error-status :get-message(1) <> ""
     1273         then do:
     1274           undo move_block, retry move_block.
     1275         end.
     1276         for each buf_temp-browse-handle
     1277           where buf_temp-browse-handle.browse-type = 'width':u
     1278         on error undo move_block, retry move_block
     1279         :
     1280           assign
     1281             buf_temp-browse-handle.browse-handle :width
     1282               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1283             no-error .
     1284           if error-status :error
     1285           or error-status :get-message(1) <> ""
     1286           then do:
     1287             undo move_block, retry move_block .
     1288           end.
     1289         end.
     1290         for each buf_temp-diasize-handle
     1291         on error undo move_block, retry move_block
     1292         :
     1293           assign
     1294             v-object-handle = buf_temp-diasize-handle.handle-value
     1295           .
     1296           if v-object-handle <> v-diasize-resize-button
     1297           then do:
     1298             assign
     1299               v-object-handle :col = v-object-handle :col + p-change-value
     1300               no-error .
     1301             if error-status :error
     1302             or error-status :get-message(1) <> ""
     1303             then do:
     1304               undo move_block, retry move_block .
     1305             end.
     1306           end.
     1307         end.
     1308       end.
     1309       else do:
     1310         for each buf_temp-diasize-handle
     1311         on error undo move_block, retry move_block
     1312         :
     1313           assign
     1314             v-object-handle = buf_temp-diasize-handle.handle-value
     1315           .
     1316           if v-object-handle <> v-diasize-resize-button
     1317           then do:
     1318             assign
     1319               v-object-handle :col = v-object-handle :col + p-change-value
     1320               no-error .
     1321             if error-status :error
     1322             or error-status :get-message(1) <> ""
     1323             then do:
     1324               undo move_block, retry move_block .
     1325             end.
     1326           end.
     1327         end.
     1328         for each buf_temp-browse-handle
     1329           where buf_temp-browse-handle.browse-type = 'width':u
     1330         on error undo move_block, retry move_block
     1331         :
     1332           assign
     1333             buf_temp-browse-handle.browse-handle :width
     1334               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1335             no-error .
     1336           if error-status :error
     1337           or error-status :get-message(1) <> ""
     1338           then do:
     1339             undo move_block, retry move_block .
     1340           end.
     1341         end.
     1342         assign
     1343           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1344           no-error .
     1345         if error-status :error
     1346         or error-status :get-message(1) <> ""
     1347         then do:
     1348           undo move_block, retry move_block.
     1349         end.
     1350         assign
     1351           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1352         no-error .
     1353         if error-status :error
     1354         or error-status :get-message(1) <> ""
     1355         then do:
     1356           undo move_block, retry move_block.
     1357         end.
     1358         if frame Dialog-Frame :scrollable = true
     1359         then do:
     1360           assign
     1361             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1362           no-error .
     1363           if error-status :error
     1364           or error-status :get-message(1) <> ""
     1365           then do:
     1366             undo move_block, retry move_block.
     1367           end.
     1368         end.
     1369       end.
     1370       if p-move-resize
     1371       then do:
     1372         run diasize_position-resize-button in this-procedure .
     1373       end.
     1374       if v-diasize-wndstore = true
     1375       then do:
     1376         if connected("ub") = true
     1377         then do:
     1378           define variable v-cntxt-db-num        as integer   no-undo .
     1379           define variable v-cntxt-userid        as character no-undo .
     1380           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1381                                             , OUTPUT v-cntxt-userid
     1382                                             ) .
     1383           run gbl/wndsizew.p
     1384             (input  v-cntxt-db-num
     1385             ,input  v-cntxt-userid
     1386             ,input  v-diasize-proc-name
     1387             ,input  'width':u
     1388             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1389             ) .
     1390         end.
     1391       end.
     1392     end.
     1393     assign
     1394       v-diasize-change-size = false
     1395     .
     1396   end procedure.
     1397   procedure diasize_set-width :
     1398     define input  parameter p-new-width  as decimal   no-undo .
     1399     define input  parameter p-move-resize as logical   no-undo .
     1400     do
     1401     on error undo, return error return-value
     1402     :
     1403       run diasize_change-width in this-procedure
     1404         (input  (p-new-width - frame Dialog-Frame :width)
     1405         ,input  p-move-resize
     1406         ) .
     1407     end.
     1408   end procedure.
     1409   procedure diasize_position-resize-button :
     1410     do with frame Dialog-Frame
     1411     :
     1412       hide v-diasize-resize-button .
     1413       assign
     1414         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1415                     - 1
     1416                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1417         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1418                     - 1
     1419                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1420       .
     1421       view v-diasize-resize-button .
     1422     end.
     1423   end procedure.
     1424   on alt-right anywhere
     1425   do:
     1426     run diasize_change-width in this-procedure
     1427       (input 1
     1428       ,input true
     1429       ) .
     1430     return no-apply .
     1431   end.
     1432   on alt-left anywhere
     1433   do:
     1434     run diasize_change-width in this-procedure
     1435       (input -1
     1436       ,input true
     1437       ) .
     1438     return no-apply .
     1439   end.
     1440   on alt-down anywhere
     1441   do:
     1442     run diasize_change-height in this-procedure
     1443       (input 1
     1444       ,input true
     1445       ) .
     1446     return no-apply .
     1447   end.
     1448   on alt-up anywhere
     1449   do:
     1450     run diasize_change-height in this-procedure
     1451       (input -1
     1452       ,input true
     1453       ) .
     1454     return no-apply .
     1455   end.
     1456   on alt-enter of frame Dialog-Frame
     1457   do:
     1458     run diasize_maximize in this-procedure
     1459       (input  ?
     1460       ).
     1461     return no-apply .
     1462   end.
     1463   procedure diasize_end-move :
     1464     do
     1465     on error undo, return error return-value
     1466     :
     1467       define variable v-row-delta as decimal   no-undo .
     1468       define variable v-col-delta as decimal   no-undo .
     1469       define variable v-new-row as decimal   no-undo .
     1470       define variable v-new-col as decimal   no-undo .
     1471       assign
     1472         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1473         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1474       .
     1475       assign
     1476         v-row-delta = v-new-row - frame Dialog-Frame :height
     1477         v-col-delta = v-new-col - frame Dialog-Frame :width
     1478       .
     1479       run diasize_change-height in this-procedure
     1480         (input v-row-delta
     1481         ,input true
     1482         ) .
     1483       run diasize_change-width in this-procedure
     1484         (input v-col-delta
     1485         ,input true
     1486         ) .
     1487     end.
     1488   end procedure.
     1489   procedure diasize_maximize :
     1490     define input  parameter p-action as logical   no-undo .
     1491     do
     1492     on error undo, return error return-value
     1493     :
     1494       if p-action = ?
     1495       then do:
     1496         if v-diasize-need-maximize = true
     1497         then do:
     1498           assign
     1499             p-action = true
     1500           .
     1501         end.
     1502         else do:
     1503           assign
     1504             p-action = false
     1505           .
     1506         end.
     1507       end.
     1508       if p-action = true
     1509       then do:
     1510         run diasize_change-height in this-procedure
     1511           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1512               - frame Dialog-Frame :height-chars
     1513           ,input true
     1514           ) .
     1515         run diasize_change-width in this-procedure
     1516           (input session :width-chars
     1517               - frame Dialog-Frame :width-chars
     1518           ,input true
     1519           ) .
     1520         assign
     1521           v-diasize-need-maximize = false
     1522         .
     1523       end.
     1524       else do:
     1525         run diasize_change-width in this-procedure
     1526           (input v-diasize-orig-frame-width
     1527               - frame Dialog-Frame :width-chars
     1528           ,input true
     1529           ) .
     1530         run diasize_change-height in this-procedure
     1531           (input v-diasize-orig-frame-height
     1532               - frame Dialog-Frame :height-chars
     1533           ,input true
     1534           ) .
     1535         assign
     1536           v-diasize-need-maximize = true
     1537         .
     1538       end.
     1539     end.
     1540   end procedure.
     1541   procedure diasize_restore-orig-size :
     1542     do
     1543     on error undo, return error return-value
     1544     :
     1545       assign
     1546         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1547         v-diasize-current-frame-height = frame Dialog-Frame :height
     1548       .
     1549       run diasize_set-height in this-procedure
     1550         (input  v-diasize-orig-frame-height
     1551         ,input  true
     1552         ) .
     1553       run diasize_set-width in this-procedure
     1554         (input  v-diasize-orig-frame-width
     1555         ,input  true
     1556         ) .
     1557     end.
     1558   end procedure.
     1559   procedure diasize_restore-current-size :
     1560     do
     1561     on error undo, return error return-value
     1562     :
     1563       run diasize_set-height in this-procedure
     1564         (input  v-diasize-current-frame-height
     1565         ,input  true
     1566         ) .
     1567       run diasize_set-width in this-procedure
     1568         (input  v-diasize-current-frame-width
     1569         ,input  true
     1570         ) .
     1571     end.
     1572   end procedure.
     1573   procedure diasize_set-browse-handle :
     1574     define input  parameter p-browse-handle as handle   no-undo .
     1575     define buffer buf_temp-browse-handle for temp-browse-handle .
     1576     do
     1577     on error undo, return error return-value
     1578     :
     1579       assign
     1580         v-diasize-browse-handle = p-browse-handle
     1581       .
     1582       for each buf_temp-browse-handle
     1583       on error undo, return error return-value
     1584       :
     1585         delete buf_temp-browse-handle .
     1586       end.
     1587     end.
     1588   end procedure.
     1589   procedure diasize_add_browse :
     1590     define input  parameter p-browse-type   as character no-undo .
     1591     define input  parameter p-browse-handle as handle    no-undo .
     1592     define buffer buf_temp-browse-handle for temp-browse-handle .
     1593     do
     1594     on error undo, return error return-value
     1595     :
     1596       assign
     1597         v-diasize-browse-number = v-diasize-browse-number + 1
     1598       .
     1599       create buf_temp-browse-handle .
     1600       assign
     1601         buf_temp-browse-handle.browse-type   = p-browse-type
     1602         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1603         buf_temp-browse-handle.browse-handle = p-browse-handle
     1604       .
     1605     end.
     1606   end procedure.
     1607   procedure diasize_init :
     1608     define variable v-default-value    as logical   no-undo .
     1609     define variable v-restore-saved    as logical   no-undo .
     1610     define variable v-resize-value-str as character no-undo .
     1611     do
     1612     on error undo, return error return-value
     1613     :
     1614       do with frame Dialog-Frame
     1615       :
     1616         assign
     1617           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1618           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1619           v-diasize-browse-handle     = browse BR-fdp :handle
     1620         .
     1621         create button v-diasize-resize-button
     1622         assign
     1623           parent        = frame Dialog-Frame :first-child
     1624           label         = "s"
     1625           height-pixels = 16
     1626           width-pixels  = 16
     1627           visible       = true
     1628           sensitive     = true
     1629           movable       = true
     1630           triggers:
     1631             on end-move persistent run diasize_end-move in this-procedure .
     1632           end triggers.
     1633         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1634         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1635         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1636         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1637         assign
     1638           v-diasize-wndmax = false
     1639         .
     1640         if connected("ub") = true
     1641         then do:
     1642           define variable v-cntxt-db-num        as integer   no-undo .
     1643           define variable v-cntxt-userid        as character no-undo .
     1644           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1645                                             , OUTPUT v-cntxt-userid
     1646                                             ) .
     1647           run gbl/wndpar_r.p
     1648             (input  v-cntxt-db-num
     1649             ,input  v-cntxt-userid
     1650             ,input  'wndmax':U
     1651             ,output v-diasize-wndmax
     1652             ,output v-default-value
     1653             ) .
     1654         end.
     1655         assign
     1656           v-diasize-wndstore = false
     1657         .
     1658         if connected("ub") = true
     1659         then do:
     1660           run gbl/wndpar_r.p
     1661             (input  v-cntxt-db-num
     1662             ,input  v-cntxt-userid
     1663             ,input  'wndstore':U
     1664             ,output v-diasize-wndstore
     1665             ,output v-default-value
     1666             ) .
     1667         end.
     1668         assign
     1669           v-diasize-proc-name = entry(1, program-name(2), '.')
     1670         .
     1671         if v-diasize-wndstore = true
     1672         then do:
     1673           assign
     1674             v-restore-saved = false
     1675           .
     1676           if connected("ub") = true
     1677           then do:
     1678             run gbl/wndsizer.p
     1679               (input  v-cntxt-db-num
     1680               ,input  v-cntxt-userid
     1681               ,input  v-diasize-proc-name
     1682               ,input  'height':u
     1683               ,output v-resize-value-str
     1684               ) .
     1685             if v-resize-value-str <> '':U
     1686             then do:
     1687               run diasize_change-height in this-procedure
     1688                 (input  integer(v-resize-value-str)
     1689                 ,input  true
     1690                 ) .
     1691               assign
     1692                 v-restore-saved = true
     1693               .
     1694             end.
     1695           end.
     1696           if connected("ub") = true
     1697           then do:
     1698             run gbl/wndsizer.p
     1699               (input  v-cntxt-db-num
     1700               ,input  v-cntxt-userid
     1701               ,input  v-diasize-proc-name
     1702               ,input  'width':u
     1703               ,output v-resize-value-str
     1704               ) .
     1705             if v-resize-value-str <> '':U
     1706             then do:
     1707               run diasize_change-width in this-procedure
     1708                 (input  integer(v-resize-value-str)
     1709                 ,input  true
     1710                 ) .
     1711               assign
     1712                 v-restore-saved = true
     1713               .
     1714             end.
     1715           end.
     1716           if v-restore-saved <> true
     1717           then do:
     1718             if v-diasize-wndmax = true
     1719             then do:
     1720               run diasize_maximize in this-procedure
     1721                 (input  true
     1722                 ) .
     1723             end.
     1724           end.
     1725         end.
     1726         else do:
     1727           if v-diasize-wndmax = true
     1728           then do:
     1729             run diasize_maximize in this-procedure
     1730               (input  true
     1731               ) .
     1732           end.
     1733         end.
     1734       end.
     1735     end.
     1736   end procedure.
     1737   procedure diasize_need-full-display :
     1738     define output parameter p-need-full-display as logical   no-undo .
     1739     do
     1740     on error undo, return error return-value
     1741     :
     1742       assign
     1743         p-need-full-display = v-diasize-need-full-display
     1744       .
     1745       assign
     1746         v-diasize-need-full-display = false
     1747       .
     1748     end.
     1749   end procedure.
     1750   procedure get-context :
     1751      define output parameter p-db-num as integer          no-undo.
     1752      define output parameter p-user-id as character        no-undo.
     1753      define variable v-login               as character    no-undo.
     1754      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1755      define buffer buf_user-login  for ub.user-login .
     1756      do
     1757      on error undo, return error
     1758      :
     1759            FIND FIRST buf_sys-ctrl no-lock.
     1760            ASSIGN
     1761               v-login = USERID("ub")
     1762               p-db-num = buf_sys-ctrl.db-num
     1763            .
     1764            FIND FIRST buf_user-login
     1765                 WHERE buf_user-login.db-num = p-db-num
     1766                   AND buf_user-login.user-login = v-login
     1767                 no-lock
     1768                 no-error
     1769                 .
     1770            IF AVAILABLE buf_user-login
     1771            THEN DO:
     1772               assign
     1773                  p-user-id = buf_user-login.user-id
     1774               .
     1775            END.
     1776      end.
     1777   end procedure.
     1778       run diasize_init in this-procedure .
     1779   MAIN-BLOCK:
     1780   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1781      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1782     RUN fill-tables IN THIS-PROCEDURE (OUTPUT v-t-nums) NO-ERROR.
     1783     IF ERROR-STATUS:ERROR THEN DO:
     1784       MESSAGE
     1785       SUBSTITUTE("Ошибка при получении настроек печати платежей типа &1 из ini-файла", p-fin-doc-type) SKIP
     1786       ERROR-STATUS:get-message(1) SKIP
     1787       RETURN-VALUE
     1788       VIEW-AS ALERT-BOX.
     1789       RETURN.
     1790     END.
     1791     IF v-t-nums = 0 THEN DO:
     1792         MESSAGE
     1793         SUBSTITUTE("В ini-файле не найдено настроек печати платежей типа &1", p-fin-doc-type)
     1794         VIEW-AS ALERT-BOX.
     1795         RETURN.
     1796     END.
     1797     RUN Myenable.
     1798     WAIT-FOR GO OF FRAME Dialog-Frame.
     1799   END.
     1800   RUN disable_UI.
     1801   PROCEDURE disable_UI :
     1802     HIDE FRAME Dialog-Frame.
     1803   END PROCEDURE.
     1804   PROCEDURE enable_UI :
     1805     DISPLAY F-copy-nums f-docs-num
     1806         WITH FRAME Dialog-Frame.
     1807     ENABLE B-exit b-quit B-Help BR-fdp F-copy-nums f-docs-num
     1808         WITH FRAME Dialog-Frame.
     1809     VIEW FRAME Dialog-Frame.
     1810     OPEN QUERY BR-fdp FOR EACH tt-fdp NO-LOCK INDEXED-REPOSITION.
     1811   END PROCEDURE.
     1812   PROCEDURE Fill-tables :
     1813   DEFINE OUTPUT parameter p-t-nums AS integer NO-UNDO.
     1814   DEFINE VARIABLE ii AS INTEGER NO-UNDO.
     1815   DEFINE VARIABLE ss AS CHARACTER NO-UNDO.
     1816   DEFINE VARIABLE v-value AS CHARACTER NO-UNDO.
     1817   FOR EACH tt-fdp:
     1818     DELETE tt-fdp.
     1819   END.
     1820   _ii:
     1821   DO ii = 1 TO 1000 ON ERROR UNDO _ii, NEXT _ii:
     1822     assign
     1823     ss = SUBstitute("&1&2", p-fin-doc-type, ii ).
     1824     ASSIGN
     1825     v-value = ?.
     1826     RUN verify-ini-entry IN THIS-PROCEDURE(
     1827                                               INPUT  ss
     1828                                               ,INPUT "fin-print":U
     1829                                               ,INPUT  "":U
     1830                                               ,INPUT  yes
     1831                                               ,OUTPUT v-value) NO-ERROR.
     1832     if v-value = ? THEN DO:
     1833         LEAVE _ii.
     1834     END.
     1835     ELSE DO:
     1836       CREATE tt-fdp.
     1837       ASSIGN
     1838       tt-fdp.obj-name = ENTRY(1, v-value, "#":U)
     1839       tt-fdp.rep-code  = ENTRY(2, v-value, "#":U)
     1840       tt-fdp.num  = integer(ENTRY(3, v-value, "#":U))
     1841       tt-fdp.name1  = ENTRY(4, v-value, "#":U)
     1842       NO-ERROR
     1843       .
     1844       IF ERROR-STATUS:ERROR  THEN DO:
     1845         MESSAGE
     1846         substitute("Не удалось получить из ini-файла данные по шаблону печати &1", ss)
     1847         VIEW-AS ALERT-BOX ERROR.
     1848         UNDO _ii, NEXT _ii.
     1849       END.
     1850       ASSIGN
     1851       p-t-nums = p-t-nums + 1
     1852       .
     1853     END.
     1854   END.
     1855   END PROCEDURE.
     1856   PROCEDURE MyEnable :
     1857   DISPLAY
     1858   p-num-recs @ f-docs-num
     1859   F-copy-nums
     1860   WITH FRAME Dialog-Frame.
     1861   ENABLE
     1862   B-exit
     1863   b-quit
     1864   B-Help
     1865   BR-fdp
     1866   F-copy-nums
     1867   WITH FRAME Dialog-Frame.
     1868   VIEW FRAME Dialog-Frame.
     1869   OPEN QUERY br-fdp FOR EACH tt-fdp NO-LOCK.
     1870   APPLY "value-changed" TO br-fdp.
     1871   apply "entry" TO br-fdp.
     1872   END PROCEDURE.
