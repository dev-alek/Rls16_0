      331   procedure thobjs :
      332      define input        parameter parparentproc     as widget-handle no-undo .
      333      define input        parameter i-bttns           as character     no-undo .
      334      define input        parameter i-list-mode       as character     no-undo.
      335      define input        parameter i-obj-type        as character     no-undo.
      336      define input        parameter i-db-num          as integer       no-undo.
      337      define input        parameter i-host-code       as integer       no-undo.
