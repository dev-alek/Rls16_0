     1384     define variable v-frame-virtual-width  as decimal   no-undo .
     1385     define variable v-browse-width         as decimal   no-undo .
     1386     define variable v-window-width         as decimal   no-undo .
     1387     define variable v-window-virtual-width as decimal   no-undo .
     1388     define variable v-change-sign          as integer   no-undo .
     1389     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1390     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1391     if p-change-value > 0
     1392     then do:
     1393       if frame Dialog-Frame :width + p-change-value >
     1394           session :width-chars
     1395       then do:
     1396         assign
     1397           p-change-value = session :width-chars - frame Dialog-Frame :width
     1398         .
     1399         if p-change-value <= 0
     1400         then do:
     1401           run diasize_position-resize-button in this-procedure .
     1402           return .
     1403         end.
     1404       end.
     1405     end.
     1406     if p-change-value < 0
     1407     then do:
     1408       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1409       then do:
     1410         assign
     1411           p-change-value = v-diasize-orig-frame-width
     1412                          - frame Dialog-Frame :width
     1413         .
     1414         if p-change-value >= 0
     1415         then do:
     1416           run diasize_position-resize-button in this-procedure .
     1417           return .
     1418         end.
     1419       end.
     1420     end.
     1421     if p-change-value >= 0
     1422     then do:
     1423       assign
     1424         v-change-sign = 1
     1425       .
     1426     end.
     1427     else do:
     1428       assign
     1429         v-change-sign = -1
     1430       .
     1431     end.
     1432     assign
     1433       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1434     .
     1435     if p-change-value = 0
     1436     then do:
     1437       run diasize_position-resize-button in this-procedure .
     1438       return .
     1439     end.
     1440     move_block:
