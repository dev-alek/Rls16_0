     1698         assign
     1699           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1700           no-error .
     1701         if error-status :error
     1702         or error-status :get-message(1) <> ""
     1703         then do:
     1704           undo move_block, retry move_block.
     1705         end.
     1706         assign
     1707           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1708         no-error .
     1709         if error-status :error
     1710         or error-status :get-message(1) <> ""
     1711         then do:
     1712           undo move_block, retry move_block.
     1713         end.
     1714         if frame Dialog-Frame :scrollable = true
     1715         then do:
     1716           assign
     1717             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1718           no-error .
     1719           if error-status :error
     1720           or error-status :get-message(1) <> ""
     1721           then do:
     1722             undo move_block, retry move_block.
     1723           end.
     1724         end.
     1725       end.
     1726       if p-move-resize
     1727       then do:
     1728         run diasize_position-resize-button in this-procedure .
     1729       end.
     1730       if v-diasize-wndstore = true
     1731       then do:
     1732         if connected("ub") = true
     1733         then do:
     1734           define variable v-cntxt-db-num        as integer   no-undo .
     1735           define variable v-cntxt-userid        as character no-undo .
     1736           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1737                                             , OUTPUT v-cntxt-userid
     1738                                             ) .
     1739           run gbl/wndsizew.p
     1740             (input  v-cntxt-db-num
     1741             ,input  v-cntxt-userid
     1742             ,input  v-diasize-proc-name
     1743             ,input  'width':u
     1744             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1745             ) .
     1746         end.
     1747       end.
     1748     end.
     1749     assign
     1750       v-diasize-change-size = false
     1751     .
     1752   end procedure.
     1753   procedure diasize_set-width :
     1754     define input  parameter p-new-width  as decimal   no-undo .
     1755     define input  parameter p-move-resize as logical   no-undo .
     1756     do
     1757     on error undo, return error return-value
     1758     :
     1759       run diasize_change-width in this-procedure
     1760         (input  (p-new-width - frame Dialog-Frame :width)
     1761         ,input  p-move-resize
     1762         ) .
     1763     end.
     1764   end procedure.
     1765   procedure diasize_position-resize-button :
     1766     do with frame Dialog-Frame
     1767     :
     1768       hide v-diasize-resize-button .
     1769       assign
     1770         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1771                     - 1
     1772                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1773         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1774                     - 1
     1775                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1776       .
     1777       view v-diasize-resize-button .
     1778     end.
     1779   end procedure.
     1780   on alt-right anywhere
     1781   do:
     1782     run diasize_change-width in this-procedure
     1783       (input 1
     1784       ,input true
     1785       ) .
     1786     return no-apply .
     1787   end.
     1788   on alt-left anywhere
     1789   do:
     1790     run diasize_change-width in this-procedure
     1791       (input -1
     1792       ,input true
     1793       ) .
     1794     return no-apply .
     1795   end.
     1796   on alt-down anywhere
     1797   do:
     1798     run diasize_change-height in this-procedure
     1799       (input 1
     1800       ,input true
     1801       ) .
     1802     return no-apply .
     1803   end.
     1804   on alt-up anywhere
     1805   do:
     1806     run diasize_change-height in this-procedure
     1807       (input -1
     1808       ,input true
     1809       ) .
     1810     return no-apply .
     1811   end.
     1812   on alt-enter of frame Dialog-Frame
     1813   do:
     1814     run diasize_maximize in this-procedure
     1815       (input  ?
     1816       ).
     1817     return no-apply .
     1818   end.
     1819   procedure diasize_end-move :
     1820     do
     1821     on error undo, return error return-value
     1822     :
     1823       define variable v-row-delta as decimal   no-undo .
     1824       define variable v-col-delta as decimal   no-undo .
     1825       define variable v-new-row as decimal   no-undo .
     1826       define variable v-new-col as decimal   no-undo .
     1827       assign
     1828         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1829         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1830       .
     1831       assign
     1832         v-row-delta = v-new-row - frame Dialog-Frame :height
     1833         v-col-delta = v-new-col - frame Dialog-Frame :width
     1834       .
     1835       run diasize_change-height in this-procedure
     1836         (input v-row-delta
     1837         ,input true
     1838         ) .
     1839       run diasize_change-width in this-procedure
     1840         (input v-col-delta
     1841         ,input true
     1842         ) .
     1843     end.
     1844   end procedure.
     1845   procedure diasize_maximize :
     1846     define input  parameter p-action as logical   no-undo .
     1847     do
     1848     on error undo, return error return-value
     1849     :
     1850       if p-action = ?
     1851       then do:
     1852         if v-diasize-need-maximize = true
     1853         then do:
     1854           assign
     1855             p-action = true
     1856           .
     1857         end.
     1858         else do:
     1859           assign
     1860             p-action = false
     1861           .
     1862         end.
     1863       end.
     1864       if p-action = true
     1865       then do:
     1866         run diasize_change-height in this-procedure
     1867           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1868               - frame Dialog-Frame :height-chars
     1869           ,input true
     1870           ) .
     1871         run diasize_change-width in this-procedure
     1872           (input session :width-chars
     1873               - frame Dialog-Frame :width-chars
     1874           ,input true
     1875           ) .
     1876         assign
     1877           v-diasize-need-maximize = false
     1878         .
     1879       end.
     1880       else do:
     1881         run diasize_change-width in this-procedure
     1882           (input v-diasize-orig-frame-width
     1883               - frame Dialog-Frame :width-chars
     1884           ,input true
     1885           ) .
     1886         run diasize_change-height in this-procedure
     1887           (input v-diasize-orig-frame-height
     1888               - frame Dialog-Frame :height-chars
     1889           ,input true
     1890           ) .
     1891         assign
     1892           v-diasize-need-maximize = true
     1893         .
     1894       end.
     1895     end.
     1896   end procedure.
     1897   procedure diasize_restore-orig-size :
     1898     do
     1899     on error undo, return error return-value
     1900     :
     1901       assign
     1902         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1903         v-diasize-current-frame-height = frame Dialog-Frame :height
     1904       .
     1905       run diasize_set-height in this-procedure
     1906         (input  v-diasize-orig-frame-height
     1907         ,input  true
     1908         ) .
     1909       run diasize_set-width in this-procedure
     1910         (input  v-diasize-orig-frame-width
     1911         ,input  true
     1912         ) .
     1913     end.
     1914   end procedure.
     1915   procedure diasize_restore-current-size :
     1916     do
     1917     on error undo, return error return-value
     1918     :
     1919       run diasize_set-height in this-procedure
     1920         (input  v-diasize-current-frame-height
     1921         ,input  true
     1922         ) .
     1923       run diasize_set-width in this-procedure
     1924         (input  v-diasize-current-frame-width
     1925         ,input  true
     1926         ) .
     1927     end.
     1928   end procedure.
     1929   procedure diasize_set-browse-handle :
     1930     define input  parameter p-browse-handle as handle   no-undo .
     1931     define buffer buf_temp-browse-handle for temp-browse-handle .
     1932     do
     1933     on error undo, return error return-value
     1934     :
     1935       assign
     1936         v-diasize-browse-handle = p-browse-handle
     1937       .
     1938       for each buf_temp-browse-handle
     1939       on error undo, return error return-value
     1940       :
     1941         delete buf_temp-browse-handle .
     1942       end.
     1943     end.
     1944   end procedure.
     1945   procedure diasize_add_browse :
     1946     define input  parameter p-browse-type   as character no-undo .
     1947     define input  parameter p-browse-handle as handle    no-undo .
     1948     define buffer buf_temp-browse-handle for temp-browse-handle .
     1949     do
     1950     on error undo, return error return-value
     1951     :
     1952       assign
     1953         v-diasize-browse-number = v-diasize-browse-number + 1
     1954       .
     1955       create buf_temp-browse-handle .
     1956       assign
     1957         buf_temp-browse-handle.browse-type   = p-browse-type
     1958         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1959         buf_temp-browse-handle.browse-handle = p-browse-handle
     1960       .
     1961     end.
     1962   end procedure.
     1963   procedure diasize_init :
     1964     define variable v-default-value    as logical   no-undo .
     1965     define variable v-restore-saved    as logical   no-undo .
     1966     define variable v-resize-value-str as character no-undo .
     1967     do
     1968     on error undo, return error return-value
     1969     :
     1970       do with frame Dialog-Frame
     1971       :
     1972         assign
     1973           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1974           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1975           v-diasize-browse-handle     = browse br-table :handle
     1976         .
     1977         create button v-diasize-resize-button
     1978         assign
     1979           parent        = frame Dialog-Frame :first-child
     1980           label         = "s"
     1981           height-pixels = 16
     1982           width-pixels  = 16
     1983           visible       = true
     1984           sensitive     = true
     1985           movable       = true
     1986           triggers:
     1987             on end-move persistent run diasize_end-move in this-procedure .
     1988           end triggers.
     1989         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1990         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1991         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1992         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1993         assign
     1994           v-diasize-wndmax = false
     1995         .
     1996         if connected("ub") = true
     1997         then do:
     1998           define variable v-cntxt-db-num        as integer   no-undo .
     1999           define variable v-cntxt-userid        as character no-undo .
     2000           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2001                                             , OUTPUT v-cntxt-userid
     2002                                             ) .
     2003           run gbl/wndpar_r.p
     2004             (input  v-cntxt-db-num
     2005             ,input  v-cntxt-userid
     2006             ,input  'wndmax':U
     2007             ,output v-diasize-wndmax
     2008             ,output v-default-value
     2009             ) .
     2010         end.
     2011         assign
     2012           v-diasize-wndstore = false
     2013         .
     2014         if connected("ub") = true
     2015         then do:
     2016           run gbl/wndpar_r.p
     2017             (input  v-cntxt-db-num
     2018             ,input  v-cntxt-userid
     2019             ,input  'wndstore':U
     2020             ,output v-diasize-wndstore
     2021             ,output v-default-value
     2022             ) .
     2023         end.
     2024         assign
     2025           v-diasize-proc-name = entry(1, program-name(2), '.')
     2026         .
     2027         if v-diasize-wndstore = true
     2028         then do:
     2029           assign
     2030             v-restore-saved = false
     2031           .
     2032           if connected("ub") = true
     2033           then do:
     2034             run gbl/wndsizer.p
     2035               (input  v-cntxt-db-num
     2036               ,input  v-cntxt-userid
     2037               ,input  v-diasize-proc-name
     2038               ,input  'height':u
     2039               ,output v-resize-value-str
     2040               ) .
     2041             if v-resize-value-str <> '':U
     2042             then do:
     2043               run diasize_change-height in this-procedure
     2044                 (input  integer(v-resize-value-str)
     2045                 ,input  true
     2046                 ) .
     2047               assign
     2048                 v-restore-saved = true
     2049               .
     2050             end.
     2051           end.
     2052           if connected("ub") = true
     2053           then do:
     2054             run gbl/wndsizer.p
     2055               (input  v-cntxt-db-num
     2056               ,input  v-cntxt-userid
     2057               ,input  v-diasize-proc-name
     2058               ,input  'width':u
     2059               ,output v-resize-value-str
     2060               ) .
     2061             if v-resize-value-str <> '':U
     2062             then do:
     2063               run diasize_change-width in this-procedure
     2064                 (input  integer(v-resize-value-str)
     2065                 ,input  true
     2066                 ) .
     2067               assign
     2068                 v-restore-saved = true
     2069               .
     2070             end.
     2071           end.
     2072           if v-restore-saved <> true
     2073           then do:
     2074             if v-diasize-wndmax = true
     2075             then do:
     2076               run diasize_maximize in this-procedure
     2077                 (input  true
     2078                 ) .
     2079             end.
     2080           end.
     2081         end.
     2082         else do:
     2083           if v-diasize-wndmax = true
     2084           then do:
     2085             run diasize_maximize in this-procedure
     2086               (input  true
     2087               ) .
     2088           end.
     2089         end.
     2090       end.
     2091     end.
     2092   end procedure.
     2093   procedure diasize_need-full-display :
     2094     define output parameter p-need-full-display as logical   no-undo .
     2095     do
     2096     on error undo, return error return-value
     2097     :
     2098       assign
     2099         p-need-full-display = v-diasize-need-full-display
     2100       .
     2101       assign
     2102         v-diasize-need-full-display = false
     2103       .
     2104     end.
     2105   end procedure.
     2106   procedure get-context :
     2107      define output parameter p-db-num as integer          no-undo.
     2108      define output parameter p-user-id as character        no-undo.
     2109      define variable v-login               as character    no-undo.
     2110      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2111      define buffer buf_user-login  for ub.user-login .
     2112      do
     2113      on error undo, return error
     2114      :
     2115            FIND FIRST buf_sys-ctrl no-lock.
     2116            ASSIGN
     2117               v-login = USERID("ub")
     2118               p-db-num = buf_sys-ctrl.db-num
     2119            .
     2120            FIND FIRST buf_user-login
     2121                 WHERE buf_user-login.db-num = p-db-num
     2122                   AND buf_user-login.user-login = v-login
     2123                 no-lock
     2124                 no-error
     2125                 .
     2126            IF AVAILABLE buf_user-login
     2127            THEN DO:
     2128               assign
     2129                  p-user-id = buf_user-login.user-id
     2130               .
     2131            END.
     2132      end.
     2133   end procedure.
     2134       run diasize_init in this-procedure .
     2135   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2136     run mainmenu_getcntxt in parparentproc
     2137       (output v-cntxt-db-num
     2138       ,output v-cntxt-userid
     2139       ,output v-cntxt-level
     2140       ,output v-cntxt-host-code-obj
     2141       ,output v-cntxt-obj-type
     2142       ,output v-cntxt-obj-code
     2143       ,output v-cntxt-db-num-obj
     2144       ,output v-cntxt-is-admin
     2145       ) .
     2146   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     2147   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     2148   MAIN-BLOCK:
     2149   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2150      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2151      run init-fields in this-procedure.
     2152      RUN enable_UI.
     2153      hide
     2154           bt-attr
     2155           bt-set1
     2156           bt-set2
     2157           bt-set3
     2158           bt-set4
     2159           bt-set5
     2160           bt-set6
     2161           bt-set-obj
     2162      in frame Dialog-Frame.
     2163      apply "entry" to b-goods.
     2164     WAIT-FOR GO OF FRAME Dialog-Frame.
     2165   END.
     2166   RUN disable_UI.
     2167   PROCEDURE add-doc :
     2168   do
     2169   on error undo, return error
     2170   :
     2171   end.
     2172   END PROCEDURE.
     2173   PROCEDURE change-doc :
     2174   do
     2175   on error undo, return error
     2176   :
     2177   end.
     2178   END PROCEDURE.
     2179   PROCEDURE close-doc :
     2180   do
     2181   on error undo, return error
     2182   :
     2183   end.
     2184   END PROCEDURE.
     2185   PROCEDURE delete-doc :
     2186   do
     2187   on error undo, return error
     2188   :
     2189   end.
     2190   END PROCEDURE.
     2191   PROCEDURE disable_UI :
     2192     HIDE FRAME Dialog-Frame.
     2193   END PROCEDURE.
     2194   PROCEDURE enable_UI :
     2195     ENABLE b-exit b-goods bt-attr b-help bt-set1 bt-set2 bt-set3 bt-set4 bt-set5
     2196            bt-set6 bt-set-obj br-table
     2197         WITH FRAME Dialog-Frame.
     2198     VIEW FRAME Dialog-Frame.
     2199     OPEN QUERY br-table FOR EACH temp_goods NO-LOCK.
     2200   END PROCEDURE.
     2201   PROCEDURE init-fields :
     2202   do
     2203   on error undo, return error
     2204   :
     2205   end.
     2206   END PROCEDURE.
     2207   PROCEDURE open-doc :
     2208   do
     2209   on error undo, return error
     2210   :
     2211   end.
     2212   END PROCEDURE.
     2213   PROCEDURE set-attr :
     2214   define input parameter p-attr-list as character    no-undo.
     2215       define variable v-fbr-gds-obj-recid    as recid      no-undo.
     2216       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     2217       define buffer buf_temp_goods    for temp_goods.
     2218       define buffer buf_goods         for ub.goods.
     2219   do
     2220   for buf_fbr-gds-obj
     2221     , buf_temp_goods
     2222     , buf_goods
     2223   on error undo, return error
     2224   :
     2225       for each buf_temp_goods
     2226       on error undo, return error
     2227       :
     2228           find first buf_goods no-lock
     2229                where buf_goods.gds-code = buf_temp_goods.gds-code
     2230           .
     2231           find first buf_fbr-gds-obj no-lock
     2232                where buf_fbr-gds-obj.obj-type = p-obj-type
     2233                  and buf_fbr-gds-obj.obj-code = p-obj-code
     2234                  and buf_fbr-gds-obj.gds-code = buf_temp_goods.gds-code
     2235           no-error.
     2236           if available buf_fbr-gds-obj
     2237           then do:
     2238               assign
     2239                   v-fbr-gds-obj-recid = recid( buf_fbr-gds-obj )
     2240               .
     2241           end.
     2242           else do:
     2243               assign
     2244                   v-fbr-gds-obj-recid = ?
     2245               .
     2246           end.
     2247           assign
     2248               buf_temp_goods.is-cd            = ( entry( 1, p-attr-list ) = "yes" )
     2249               buf_temp_goods.is-menu          = ( entry( 2, p-attr-list ) = "yes" )
     2250               buf_temp_goods.is-modificator   = ( entry( 3, p-attr-list ) = "yes" )
     2251               buf_temp_goods.is-null-price    = ( entry( 4, p-attr-list ) = "yes" )
     2252               buf_temp_goods.is-season        = ( entry( 5, p-attr-list ) = "yes" )
     2253               buf_temp_goods.is-semi-finished = ( entry( 6, p-attr-list ) = "yes" )
     2254               buf_temp_goods.fbr-obj-type     = entry( 7, p-attr-list )
     2255               buf_temp_goods.fbr-obj-code     = integer( entry( 8, p-attr-list ) )
     2256           .
     2257           run ref/fgdsobj1.p (
     2258                 input-output v-fbr-gds-obj-recid
     2259               , input ( if available buf_fbr-gds-obj
     2260                         then 'ИЗМЕНЕНИЕ':U
     2261                         else 'ДОБАВЛЕНИЕ':U )
     2262               , input no
     2263               , input buf_temp_goods.gds-code
     2264               , input p-obj-type
     2265               , input p-obj-code
     2266               , input ( if available buf_fbr-gds-obj then buf_fbr-gds-obj.fbr-grp-code else 0 )
     2267               , input buf_temp_goods.fbr-obj-type
     2268               , input buf_temp_goods.fbr-obj-code
     2269               , input buf_temp_goods.is-cd
     2270               , input buf_temp_goods.is-menu
     2271               , input buf_temp_goods.is-modificator
     2272               , input buf_temp_goods.is-null-price
     2273               , input buf_temp_goods.is-season
     2274               , input buf_temp_goods.is-semi-finished
     2275           ) no-error.
     2276           if error-status:error
     2277           then do:
     2278               message
     2279                        vss-workfile vss-revision vss-description
     2280                   skip "Ошибка изменения атрибутов товара на объекте"
     2281                   skip return-value
     2282                   skip trim(error-status :get-message(1))
     2283                           trim(error-status :get-message(2))
     2284                           trim(error-status :get-message(3))
     2285               view-as alert-box error.
     2286               undo, return error .
     2287           end.
     2288       end.
     2289   end.
     2290   END PROCEDURE.
     2291   PROCEDURE set-one-attr :
     2292   define input parameter p-attr-name  as character  no-undo.
     2293   define input parameter p-attr-value as logical      no-undo.
     2294       define variable v-fbr-gds-obj-recid    as recid      no-undo.
     2295       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     2296       define buffer buf_temp_goods    for temp_goods.
     2297       define buffer buf_goods         for ub.goods.
     2298   do
     2299   for buf_fbr-gds-obj
     2300     , buf_temp_goods
     2301     , buf_goods
     2302   on error undo, return error
     2303   :
     2304       if p-attr-name = 'object':U
     2305       then do:
     2306           define variable v-user-select as logical   no-undo .
     2307           define variable v-host-code   as integer   no-undo .
     2308           define variable v-obj-type    as character no-undo.
     2309           define variable v-obj-code    as integer   no-undo.
     2310           define variable v-yesno       as logical   no-undo.
     2311           define buffer buf_clients for ub.clients .
     2312   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2313   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2314     (input  p-obj-type
     2315     ,input  p-obj-code
     2316     ,output v-host-code
     2317     )  .
     2318   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2319   run userobjs_select-one in this-procedure
     2320     (input  parparentproc
     2321     ,input  v-cntxt-db-num
     2322     ,input  v-cntxt-userid
     2323     ,input  v-host-code
     2324     ,input  p-obj-type
     2325     ,input  p-obj-code
     2326     ,output v-user-select
     2327     ,output v-obj-type
     2328     ,output v-obj-code
     2329     )  .
     2330           if v-user-select <> true
     2331           then do:
     2332             undo, return.
     2333           end.
     2334           find first buf_clients no-lock
     2335             where buf_clients.obj-type = v-obj-type
     2336               and buf_clients.obj-code = v-obj-code
     2337             no-error.
     2338           if not available buf_clients
     2339           then do:
     2340               message
     2341                   "Объект не найден в таблице клиентов"
     2342               view-as alert-box error.
     2343               undo, return error.
     2344           end.
     2345           assign
     2346             v-obj-type = buf_clients.obj-type
     2347             v-obj-code = buf_clients.obj-code
     2348           .
     2349           message
     2350               skip "Для всех товаров списка"
     2351               skip "будет изменен атрибут:"
     2352               skip(1)
     2353               skip "'Объект кухня'"
     2354               skip "Новое значение атрибута:" v-obj-type v-obj-code
     2355               skip(1)
     2356               skip "Yes - Установить атрибут"
     2357               skip "No  - Не изменять значение атрибута"
     2358               skip(1)
     2359               skip "Назначить атрибут всем товарам списка?"
     2360           view-as alert-box question
     2361           buttons yes-no
     2362           title "Изменение атрибутов товаров списка"
     2363           update v-yesno.
     2364           if v-yesno = no
     2365           then do:
     2366               undo, return.
     2367           end.
     2368       end.
     2369       for each buf_temp_goods
     2370       on error undo, return error
     2371       :
     2372           find first buf_goods no-lock
     2373                where buf_goods.gds-code = buf_temp_goods.gds-code
     2374           .
     2375           find first buf_fbr-gds-obj no-lock
     2376                where buf_fbr-gds-obj.obj-type = p-obj-type
     2377                  and buf_fbr-gds-obj.obj-code = p-obj-code
     2378                  and buf_fbr-gds-obj.gds-code = buf_temp_goods.gds-code
     2379           no-error.
     2380           if available buf_fbr-gds-obj
     2381           then do:
     2382               assign
     2383                   v-fbr-gds-obj-recid = recid( buf_fbr-gds-obj )
     2384               .
     2385           end.
     2386           else do:
     2387               assign
     2388                   v-fbr-gds-obj-recid = ?
     2389               .
     2390           end.
     2391           case p-attr-name
     2392           :
     2393               when 'is-cd':U
     2394               then do:
     2395                   assign
     2396                       buf_temp_goods.is-cd            = p-attr-value
     2397                   .
     2398               end.
     2399               when 'is-menu':U
     2400               then do:
     2401                   assign
     2402                       buf_temp_goods.is-menu         = p-attr-value
     2403                   .
     2404                   if p-attr-value = yes
     2405                   and buf_temp_goods.is-semi-finished = yes
     2406                   then do:
     2407                       assign
     2408                           buf_temp_goods.is-semi-finished = no
     2409                       .
     2410                   end.
     2411                   if p-attr-value = yes
     2412                   and ( buf_temp_goods.fbr-obj-type = ""
     2413                      or buf_temp_goods.fbr-obj-code = 0 )
     2414                   then do:
     2415                       assign
     2416                           buf_temp_goods.fbr-obj-type = p-obj-type
     2417                           buf_temp_goods.fbr-obj-code = p-obj-code
     2418                       .
     2419                   end.
     2420               end.
     2421               when 'is-modificator':U
     2422               then do:
     2423                   assign
     2424                       buf_temp_goods.is-modificator   = p-attr-value
     2425                   .
     2426               end.
     2427               when 'is-null-price':U
     2428               then do:
     2429                   assign
     2430                       buf_temp_goods.is-null-price    = p-attr-value
     2431                   .
     2432               end.
     2433               when 'is-season':U
     2434               then do:
     2435                   assign
     2436                       buf_temp_goods.is-season        = p-attr-value
     2437                   .
     2438               end.
     2439               when 'is-semi-finished':U
     2440               then do:
     2441                   assign
     2442                       buf_temp_goods.is-semi-finished = p-attr-value
     2443                   .
     2444                   if p-attr-value = yes
     2445                   and buf_temp_goods.is-menu = yes
     2446                   then do:
     2447                       assign
     2448                           buf_temp_goods.is-menu = no
     2449                       .
     2450                   end.
     2451                   if p-attr-value = yes
     2452                   and ( buf_temp_goods.fbr-obj-type = ""
     2453                      or buf_temp_goods.fbr-obj-code = 0 )
     2454                   then do:
     2455                       assign
     2456                           buf_temp_goods.fbr-obj-type = p-obj-type
     2457                           buf_temp_goods.fbr-obj-code = p-obj-code
     2458                       .
     2459                   end.
     2460               end.
     2461               when 'object':U
     2462               then do:
     2463                   assign
     2464                       buf_temp_goods.fbr-obj-type = v-obj-type
     2465                       buf_temp_goods.fbr-obj-code = v-obj-code
     2466                   .
     2467               end.
     2468           end case.
     2469           run ref/fgdsobj1.p (
     2470                 input-output v-fbr-gds-obj-recid
     2471               , input ( if available buf_fbr-gds-obj
     2472                         then 'ИЗМЕНЕНИЕ':U
     2473                         else 'ДОБАВЛЕНИЕ':U )
     2474               , input no
     2475               , input buf_temp_goods.gds-code
     2476               , input p-obj-type
     2477               , input p-obj-code
     2478               , input ( if available buf_fbr-gds-obj then buf_fbr-gds-obj.fbr-grp-code else 0 )
     2479               , input buf_temp_goods.fbr-obj-type
     2480               , input buf_temp_goods.fbr-obj-code
     2481               , input buf_temp_goods.is-cd
     2482               , input buf_temp_goods.is-menu
     2483               , input buf_temp_goods.is-modificator
     2484               , input buf_temp_goods.is-null-price
     2485               , input buf_temp_goods.is-season
     2486               , input buf_temp_goods.is-semi-finished
     2487           ) no-error.
     2488           if error-status:error
     2489           then do:
     2490               message
     2491                        vss-workfile vss-revision vss-description
     2492                   skip "Ошибка изменения атрибутов товара на объекте"
     2493                   skip return-value
     2494                   skip trim(error-status :get-message(1))
     2495                           trim(error-status :get-message(2))
     2496                           trim(error-status :get-message(3))
     2497               view-as alert-box error.
     2498               undo, return error .
     2499           end.
     2500       end.
     2501   end.
     2502   END PROCEDURE.
     2503   PROCEDURE view-doc :
     2504   do
     2505   on error undo, return error
     2506   :
     2507   end.
     2508   END PROCEDURE.
