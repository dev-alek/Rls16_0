     1195                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1196                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1197               .
     1198             end.
     1199           end.
     1200           assign
     1201             v-object-handle = v-object-handle :next-sibling
     1202           .
     1203         end.
