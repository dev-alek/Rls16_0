     1095                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1096               .
     1097             end.
     1098             run diasize_position-resize-button in this-procedure .
     1099           end.
     1100           else do:
     1101             if frame Dialog-Frame :scrollable = true
     1102             then do:
     1103               assign
     1104                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1105               .
     1106             end.
     1107             assign
     1108               frame Dialog-Frame :height = v-frame-height
     1109             .
