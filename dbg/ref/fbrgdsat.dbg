      857   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      858   on help of frame Dialog-Frame
      859   do:
      860     run gbl/app_help.p
      861       (input this-procedure :file-name
      862       ,input ''
      863       ,input ?
      864       ) no-error.
      865     if error-status :error then do:
      866       message
      867         "Ошибка при вызове помощи"
      868         error-status :get-message(1)
      869         view-as alert-box .
      870     end.
      871   end.
      872   run minbtn-set in this-procedure .
      873   on choose of b-help in frame Dialog-Frame
      874   do:
      875     apply "help":u to frame Dialog-Frame .
      876   end.
      877   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      878   procedure minbtn-set :
      879       do
      880           on error undo, return error return-value
      881           :
      882           define variable ii              as integer       no-undo .
      883           define variable fh              as widget-handle no-undo .
      884           define variable hh              as widget-handle no-undo .
      885           define variable v-h             as handle        extent 4 no-undo .
      886           define variable v-name-button   as character     no-undo .
      887           define variable v-help-old-x    as decimal       no-undo .
      888           define variable v-help-old-y    as decimal       no-undo .
      889           define variable v-help-old-size as decimal       no-undo .
      890           define variable v-frame-width   as decimal       no-undo .
      891           define variable jj              as integer       no-undo .
      892           do
      893               on error undo, return error
      894               :
      895               assign
      896                   v-frame-width = frame Dialog-Frame:width - 0.3
      897                   fh            = frame Dialog-Frame:first-child
      898                   hh            = fh:first-child
      899                   ii            = 1
      900                   .
      901               do while valid-handle(hh):
      902                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      903                   do:
      904                       case lc(hh:name) :
      905                           when "b-help" then
      906                               do:
      907                                   hh:load-image-up("cmp/b-help.bmp":u) .
      908                                   hh:load-image-down("cmp/b-help.bmp":u) .
      909                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      910                                   hh:TOOLTIP = "Помощь" .
      911                                   v-help-old-x = hh:column .
      912                                   v-help-old-y = hh:row    .
      913                                   v-help-old-size = hh:width .
      914                                   hh:width-chars = 2.5 .
      915                               end.
      916                           when "b-print" then
      917                               do:
      918                                   hh:load-image("cmp/b-print.bmp":u) .
      919                                   hh:TOOLTIP = "Печать" .
      920                                   v-h[ii] = hh:handle .
      921                                   ii = ii + 1 .
      922                                   hh:width-chars = 3 .
      923                               end.
      924                           when "b-history" or
      925                           when "b-hist" then
      926                               do:
      927                                   hh:load-image("cmp/b-hist.bmp":u) .
      928                                   hh:TOOLTIP = "История" .
      929                                   v-h[ii] = hh:handle .
      930                                   ii = ii + 1 .
      931                                   hh:width-chars = 3 .
      932                               end.
      933                           when "b-sch" then
      934                               do:
      935                                   hh:load-image("cmp/b-sch.bmp":u) .
      936                                   hh:TOOLTIP = "Установка Фильтра" .
      937                                   v-h[ii] = hh:handle .
      938                                   ii = ii + 1 .
      939                                   hh:width-chars = 3 .
      940                               end.
      941                           when "b-hist-user" then
      942                               do:
      943                                   hh:load-image("cmp/b-hist.bmp":u) .
      944                                   hh:TOOLTIP = "История пользователя" .
      945                                   ii = ii + 1 .
      946                               end.
      947                       end case.
      948                   end.
      949                   hh = hh:next-sibling.
      950               end.
      951               b-help:column = v-frame-width - b-help:width-chars.
      952               jj = 0.
      953               repeat ii = 4 to 1 by -1 :
      954                   if valid-handle (v-h[ii] ) then
      955                   do:
      956                       jj  = jj + 1 .
      957                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      958                       v-h[ii]:row    = v-help-old-y .
      959                   end.
      960               end.
      961           end.
      962       end.
      963   end procedure.
      964   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      965   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      966   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      967   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      968   define variable v-diasize-current-frame-width  as decimal   no-undo .
      969   define variable v-diasize-current-frame-height as decimal   no-undo .
      970   define variable v-diasize-change-size          as logical   no-undo .
      971   define variable v-diasize-resize-button        as handle    no-undo .
      972   define variable v-diasize-wndmax               as logical   no-undo .
      973   define variable v-diasize-wndstore             as logical   no-undo .
      974   define variable v-diasize-proc-name            as character no-undo .
      975   define variable v-diasize-browse-handle        as handle    no-undo .
      976   define variable v-diasize-browse-number        as integer   no-undo .
      977   define variable v-diasize-need-full-display    as logical   no-undo init false .
      978   define temp-table temp-diasize-handle no-undo
      979     field handle-value  as handle
      980     field save-position as decimal
      981     index xpk is primary unique handle-value
      982     .
      983   define temp-table temp-browse-handle no-undo
      984     field browse-type   as character
      985     field browse-number as integer
      986     field browse-handle as handle
      987     field original-size as decimal
      988     index xpk is primary unique browse-type browse-number
      989     index xie browse-type browse-handle
      990   .
      991   procedure diasize_change-height :
      992     define input  parameter p-change-value  as decimal   no-undo .
      993     define input  parameter p-move-resize   as logical   no-undo .
      994     define variable v-field-group-handle    as handle    no-undo .
      995     define variable v-object-handle         as handle    no-undo .
      996     define variable v-frame-height          as decimal   no-undo .
      997     define variable v-frame-virtual-height  as decimal   no-undo .
      998     define variable v-browse-height         as decimal   no-undo .
      999     define variable v-window-height         as decimal   no-undo .
     1000     define variable v-window-virtual-height as decimal   no-undo .
     1001     define variable v-change-sign           as integer   no-undo .
     1002     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1003     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1004     if p-change-value > 0
     1005     then do:
     1006       if frame Dialog-Frame :height + p-change-value
     1007           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1008       then do:
     1009         assign
     1010           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1011                           - (frame Dialog-Frame :height-chars)
     1012         .
     1013         if p-change-value <= 0
     1014         then do:
     1015           run diasize_position-resize-button in this-procedure .
     1016           return .
     1017         end.
     1018       end.
     1019     end.
     1020     if p-change-value < 0
     1021     then do:
     1022       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1023       then do:
     1024         assign
     1025           p-change-value = v-diasize-orig-frame-height
     1026                          - (frame Dialog-Frame :height-chars)
     1027         .
     1028         if p-change-value >= 0
     1029         then do:
     1030           run diasize_position-resize-button in this-procedure .
     1031           return .
     1032         end.
     1033       end.
     1034     end.
     1035     if p-change-value >= 0
     1036     then do:
     1037       assign
     1038         v-change-sign = 1
     1039       .
     1040     end.
     1041     else do:
     1042       assign
     1043         v-change-sign = -1
     1044       .
     1045     end.
     1046     assign
     1047       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1048     .
     1049     if p-change-value = 0
     1050     then do:
     1051       run diasize_position-resize-button in this-procedure .
     1052       return .
     1053     end.
     1054     move_block:
     1055     do
     1056     on error undo move_block, retry move_block
     1057     :
     1058       if retry
     1059       then do:
     1060         do
     1061         on error undo move_block, leave move_block
     1062         :
     1063           if p-change-value > 0
     1064           then do:
     1065             for each buf_temp-diasize-handle
     1066             on error undo, next
     1067             :
     1068               assign
     1069                 v-object-handle = buf_temp-diasize-handle.handle-value
     1070               .
     1071               if v-object-handle <> v-diasize-resize-button
     1072               then do:
     1073                 assign
     1074                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1075                 .
     1076               end.
     1077             end.
     1078             assign
     1079               v-diasize-browse-handle :height = v-browse-height
     1080             .
     1081             for each buf_temp-browse-handle
     1082               where buf_temp-browse-handle.browse-type = 'height':u
     1083             on error undo, next
     1084             :
     1085               assign
     1086                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1087               .
     1088             end.
     1089             assign
     1090               frame Dialog-Frame :height = v-frame-height
     1091             .
