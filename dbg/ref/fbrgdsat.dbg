     1216       if p-change-value > 0
     1217       then do:
     1218         if frame Dialog-Frame :scrollable = true
     1219         then do:
     1220           assign
     1221             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1222             no-error .
     1223           if error-status :error
     1224           or error-status :get-message(1) <> ""
     1225           then do:
     1226             undo move_block, retry move_block .
     1227           end.
     1228         end.
     1229         assign
     1230           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
