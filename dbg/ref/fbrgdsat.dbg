     1366   procedure diasize_set-height :
     1367     define input  parameter p-new-height  as decimal   no-undo .
     1368     define input  parameter p-move-resize as logical   no-undo .
     1369     do
     1370     on error undo, return error return-value
     1371     :
     1372       run diasize_change-height in this-procedure
     1373         (input  (p-new-height - frame Dialog-Frame :height)
     1374         ,input  p-move-resize
     1375         ) .
     1376     end.
     1377   end procedure.
     1378   procedure diasize_change-width :
     1379     define input  parameter p-change-value as decimal   no-undo .
     1380     define input  parameter p-move-resize  as logical   no-undo .
     1381     define variable v-field-group-handle   as handle    no-undo .
     1382     define variable v-object-handle        as handle    no-undo .
