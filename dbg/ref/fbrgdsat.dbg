      143   field err_ as logical
      144   field err-mes as character
      145   index pi is primary
      146   id
      147   line
      148   index isdone
      149   done
      150   .
      151   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      152     define variable v-cntxt-db-num        as integer   no-undo .
      153     define variable v-cntxt-userid        as character no-undo .
      154     define variable v-cntxt-level         as character no-undo .
      155     define variable v-cntxt-host-code-obj as integer   no-undo .
      156     define variable v-cntxt-obj-type      as character no-undo .
      157     define variable v-cntxt-obj-code      as integer   no-undo .
      158     define variable v-cntxt-db-num-obj    as integer   no-undo .
      159     define variable v-cntxt-is-admin      as logical   no-undo .
      160   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      161   define temp-table userobjs_temp-user-obj no-undo
      162     field obj-type as character
      163     field obj-code as integer
      164     index xpk is primary unique obj-type obj-code
      165     .
      166   procedure userobjs_clear :
      167     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      168     do
      169     on error undo, return error return-value
      170     :
      171       for each buf_userobjs_temp-user-obj
      172       on error undo, return error return-value
      173       :
      174         delete buf_userobjs_temp-user-obj .
      175       end.
      176     end.
      177   end .
      178   procedure userobjs_object-count :
      179     define output parameter p-total-count as integer   no-undo .
      180     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      181     do
      182     on error undo, return error return-value
      183     :
      184       assign
      185         p-total-count = 0
      186       .
      187       for each buf_userobjs_temp-user-obj
      188       on error undo, return error return-value
      189       :
      190         assign
      191           p-total-count = p-total-count + 1
      192         .
      193       end.
      194     end.
      195   end.
      196   procedure userobjs_append :
      197      define input  parameter p-obj-type as character no-undo .
      198      define input  parameter p-obj-code as integer   no-undo .
      199     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      200     do
      201     on error undo, return error return-value
      202     :
      203       find first buf_userobjs_temp-user-obj
      204         where buf_userobjs_temp-user-obj.obj-type = p-obj-type
      205           and buf_userobjs_temp-user-obj.obj-code = p-obj-code
      206         no-error .
      207       if not available buf_userobjs_temp-user-obj
      208       then do:
      209         create buf_userobjs_temp-user-obj .
      210         assign
      211           buf_userobjs_temp-user-obj.obj-type = p-obj-type
      212           buf_userobjs_temp-user-obj.obj-code = p-obj-code
      213         .
      214       end.
      215     end.
      216   end.
      217   procedure userobjs_object-exist :
      218     define output parameter p-object-exist as logical   no-undo .
      219     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      220     do
      221     on error undo, return error return-value
      222     :
      223       find first buf_userobjs_temp-user-obj
      224         no-error .
      225       if not available buf_userobjs_temp-user-obj
      226       then do:
      227         assign
      228           p-object-exist = false
      229         .
      230       end.
      231       else do:
      232         assign
      233           p-object-exist = true
      234         .
      235       end.
      236     end.
      237   end.
      238   procedure userobjs_transfer :
      239     define input  parameter p-callback-handle as handle no-undo .
      240     define variable vss-description as character no-undo init "userobjs_transfer: Передача списка объектов".
      241     define buffer buf_userobjs_temp-user-obj for userobjs_temp-user-obj .
      242     do
      243     on error undo, return error return-value
      244     :
      245       if valid-handle(p-callback-handle) <> true
      246       then do:
      247         message
      248           vss-workfile vss-revision vss-description skip
      249           "Ошибка задания входных параметров" skip
      250           "Неизвестный указатель на процедуру" skip
      251           view-as alert-box error .
      252         undo, return error return-value .
      253       end.
      254       if p-callback-handle :get-signature("userobjs_append") = ""
      255       then do:
      256         message
      257           vss-workfile vss-revision vss-description skip
      258           "Ошибка задания входных параметров" skip
      259           substitute("В процедуре &1 не найдена внутренняя процедура userobjs_append"
      260                     ,p-callback-handle :file-name
      261                     ) skip
      262           view-as alert-box error .
      263         undo, return error return-value .
      264       end.
      265       for each buf_userobjs_temp-user-obj
      266       on error undo, return error return-value
      267       :
      268         run userobjs_append in p-callback-handle
      269           (input  buf_userobjs_temp-user-obj.obj-type
      270           ,input  buf_userobjs_temp-user-obj.obj-code
      271           ) .
      272       end.
      273     end.
      274   end procedure.
      275   procedure userobjs_select-one :
      276      define input  parameter parparentproc     as widget-handle no-undo .
      277      define input  parameter p-db-num          as integer   no-undo .
      278      define input  parameter p-user-id         as character no-undo .
      279      define input  parameter p-host-code-obj   as integer   no-undo .
      280      define input  parameter p-obj-type        as character no-undo .
      281      define input  parameter p-obj-code        as integer   no-undo .
      282      define output parameter p-user-select     as logical   no-undo .
      283      define output parameter p-select-obj-type as character no-undo .
      284      define output parameter p-select-obj-code as character no-undo .
      285     do
      286     on error undo, return error return-value
      287     :
      288       run gbl/userobjs.w
      289         (input  parparentproc
      290         ,input  this-procedure :handle
      291         ,input  p-db-num
      292         ,input  p-user-id
      293         ,input  p-host-code-obj
      294         ,input  p-obj-type
      295         ,input  p-obj-code
      296         ,INPUT  "b-sel"
      297         ,output p-user-select
      298         ,output p-select-obj-type
      299         ,output p-select-obj-code
      300         ) .
      301     end.
      302   end.
      303   procedure userobjs_select-many :
      304     define input  parameter parparentproc   as widget-handle no-undo .
      305     define input  parameter p-db-num        as integer   no-undo .
      306     define input  parameter p-user-id       as character no-undo .
      307     define input  parameter p-host-code-obj as integer   no-undo .
      308     define input  parameter p-obj-type      as character no-undo .
      309     define input  parameter p-obj-code      as integer   no-undo .
      310     define output parameter p-user-select   as logical   no-undo .
      311     define variable v-select-obj-type as character no-undo .
      312     define variable v-select-obj-code as integer   no-undo .
      313     do
      314     on error undo, return error return-value
      315     :
      316       run gbl/userobjs.w
      317         (input  parparentproc
      318         ,input  this-procedure :handle
      319         ,input  p-db-num
      320         ,input  p-user-id
      321         ,input  p-host-code-obj
      322         ,input  p-obj-type
      323         ,input  p-obj-code
      324         ,INPUT  "b-sel,b-mark"
