      342           , input i-bttns
      343           , input i-list-mode
      344           , input i-obj-type
      345           , input i-db-num
      346           , input i-host-code
      347           , input-output p-rid-list ) no-error .
      348   end.
      349   define temp-table temp_goods no-undo
      350       field gds-code          as integer
      351       field artic             as character
      352       field prod-type         as character
      353       field prod-code         as integer
      354       field gds-name          as character
      355       field unit-base         as character
      356       field is-cd             as logical
      357       field is-menu           as logical
      358       field is-modificator    as logical
      359       field is-null-price     as logical
      360       field is-season         as logical
      361       field is-semi-finished  as logical
      362       field fbr-obj-type      as character
      363       field fbr-obj-code      as integer
      364       index pi is primary unique gds-code
      365       index ar artic prod-type prod-code
      366       index nm gds-name
      367       index unit unit-base
      368   .
      369   DEFINE BUTTON b-exit
      370        LABEL "&Выход"
      371        SIZE 10 BY 1
      372        BGCOLOR 8 .
      373   DEFINE BUTTON b-goods
      374        LABEL "&Товары"
      375        SIZE 10 BY 1.
      376   DEFINE BUTTON b-help
      377        LABEL "Помощ&ь"
      378        SIZE 10 BY 1
      379        BGCOLOR 8 .
      380   DEFINE BUTTON bt-attr
      381        LABEL "&Атрибуты"
      382        SIZE 10 BY 1.
      383   DEFINE BUTTON bt-set-obj
      384        LABEL "..."
      385        SIZE 4.63 BY .79.
      386   DEFINE BUTTON bt-set1
      387        LABEL "+-"
      388        SIZE 3.5 BY .79.
      389   DEFINE BUTTON bt-set2
      390        LABEL "+-"
      391        SIZE 3.5 BY .79.
      392   DEFINE BUTTON bt-set3
      393        LABEL "+-"
      394        SIZE 3.5 BY .79.
      395   DEFINE BUTTON bt-set4
      396        LABEL "+-"
      397        SIZE 3.5 BY .79.
      398   DEFINE BUTTON bt-set5
      399        LABEL "+-"
      400        SIZE 3.5 BY .79.
      401   DEFINE BUTTON bt-set6
      402        LABEL "+-"
      403        SIZE 3.5 BY .79.
      404   DEFINE QUERY br-table FOR
      405         temp_goods SCROLLING.
      406   DEFINE BROWSE br-table
      407     QUERY br-table NO-LOCK DISPLAY
      408         temp_goods.artic format "X(17)" column-label "Артикул"
      409       temp_goods.gds-name format "X(39)" column-label "Наименование товара"
      410       temp_goods.unit-base format "X(3)" column-label "ЕИ"
      411       temp_goods.is-cd format "+/-" column-label "кас"
      412       temp_goods.is-menu format "+/-" column-label "блю"
      413       temp_goods.is-modificator format "+/-" column-label "мод"
      414       temp_goods.is-null-price format "+/-" column-label "цен"
      415       temp_goods.is-season format "+/-" column-label "сез"
      416       temp_goods.is-semi-finished format "+/-" column-label "плф"
      417       temp_goods.fbr-obj-type format "X(3)" column-label "тип"
      418       temp_goods.fbr-obj-code format ">>>>9" column-label "код кух"
      419       WITH NO-ROW-MARKERS SEPARATORS SIZE 96.88 BY 20.92.
      420   DEFINE FRAME Dialog-Frame
      421        b-exit AT ROW 1.21 COL 1.63
      422        b-goods AT ROW 1.21 COL 11.63
      423        bt-attr AT ROW 1.21 COL 25.25
      424        b-help AT ROW 1.21 COL 88.63
      425        bt-set1 AT ROW 1.63 COL 62.38
      426        bt-set2 AT ROW 1.63 COL 65.88
      427        bt-set3 AT ROW 1.63 COL 69.38
      428        bt-set4 AT ROW 1.63 COL 72.88
      429        bt-set5 AT ROW 1.63 COL 76.38
      430        bt-set6 AT ROW 1.63 COL 79.88
      431        bt-set-obj AT ROW 1.63 COL 83.38
      432        br-table AT ROW 2.42 COL 1.63
      433        SPACE(0.46) SKIP(0.19)
      434       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      435            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      436            TITLE "Атрибуты товаров на объекте".
      437   ASSIGN
      438          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      439          FRAME Dialog-Frame:HIDDEN           = TRUE.
      440   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      441   DO:
      442     APPLY "END-ERROR":U TO SELF.
      443   END.
      444   ON CHOOSE OF b-exit IN FRAME Dialog-Frame
      445   DO:
      446       apply "WINDOW-CLOSE" TO FRAME Dialog-Frame .
      447   END.
      448   ON CHOOSE OF b-goods IN FRAME Dialog-Frame
      449   DO:
      450       define variable v-gds-list-not-empty    as logical        no-undo.
      451       define variable v-host-code like ub.sysconf.host-code no-undo .
      452       define buffer buf_goods         for ub.goods.
      453       define buffer buf_temp_goods    for temp_goods.
      454       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
      455       for each gds-list
      456       :
      457           delete gds-list.
      458       end.
      459       for each buf_temp_goods
      460       :
      461           find first buf_goods no-lock
      462                where buf_goods.gds-code = buf_temp_goods.gds-code
      463           .
      464           create gds-list.
      465           buffer-copy buf_goods to gds-list.
      466       end.
      467   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      468   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      469     (input  p-obj-type
      470     ,input  p-obj-code
      471     ,output v-host-code
      472     )  .
      473       run str/gds-list.w (input parparentproc, input v-host-code, input p-obj-type, input p-obj-code).
      474       for each buf_temp_goods
      475       :
      476           delete buf_temp_goods.
      477       end.
      478       for each gds-list
      479       :
      480           create buf_temp_goods.
      481           assign
      482               buf_temp_goods.gds-code  = gds-list.gds-code
      483               buf_temp_goods.artic     = gds-list.artic
      484               buf_temp_goods.prod-type = gds-list.prod-type
      485               buf_temp_goods.prod-code = gds-list.prod-code
      486               buf_temp_goods.gds-name  = gds-list.gds-name
      487               buf_temp_goods.unit-base = gds-list.unit-base
      488           .
      489           find first buf_fbr-gds-obj no-lock
      490                where buf_fbr-gds-obj.obj-type = p-obj-type
      491                  and buf_fbr-gds-obj.obj-code = p-obj-code
      492                  and buf_fbr-gds-obj.gds-code = gds-list.gds-code
      493           no-error.
      494           if available buf_fbr-gds-obj
      495           then do:
      496               assign
      497                   buf_temp_goods.is-cd             = buf_fbr-gds-obj.is-cd
      498                   buf_temp_goods.is-menu           = buf_fbr-gds-obj.is-menu
      499                   buf_temp_goods.is-modificator    = buf_fbr-gds-obj.is-modificator
      500                   buf_temp_goods.is-null-price     = buf_fbr-gds-obj.is-null-price
      501                   buf_temp_goods.is-season         = buf_fbr-gds-obj.is-season
      502                   buf_temp_goods.is-semi-finished  = buf_fbr-gds-obj.is-semi-finished
      503                   buf_temp_goods.fbr-obj-type      = buf_fbr-gds-obj.fbr-obj-type
      504                   buf_temp_goods.fbr-obj-code      = buf_fbr-gds-obj.fbr-obj-code
      505               .
      506           end.
      507           if v-gds-list-not-empty = no
      508           then do:
      509               assign
      510                   v-gds-list-not-empty = yes
      511               .
      512           end.
      513       end.
      514       OPEN QUERY br-table FOR EACH temp_goods NO-LOCK.
      515   END.
      516   ON CHOOSE OF bt-attr IN FRAME Dialog-Frame
      517   DO:
      518       define variable v-attr-list as character  no-undo.
      519       define variable v-recid     as recid      no-undo.
      520       define variable v-updated   as logical    no-undo .
      521       run ref/fgdsobji.w (
      522             input parparentproc
      523           , input 'template':U
      524           , input ( if available temp_goods then temp_goods.gds-code else 0 )
      525           , input p-obj-type
      526           , input p-obj-code
      527           , input no
      528           , input-output v-attr-list
      529           , output v-updated
      530           , input-output v-recid
      531       ).
      532       if v-attr-list = '':U
      533       then do:
      534           undo, return no-apply.
      535       end.
      536       else do:
      537           define variable v-yesno    as logical        no-undo.
      538           message
      539               skip "Для всех товаров списка"
      540               skip "будут установлены атрибуты:"
